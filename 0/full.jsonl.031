checkpoint.ts\n M cli/test/checkpoint_restore.test.ts\n cli/src/checkpoint.ts               | 158 ++++++++++++++++++++++--------------\n cli/test/checkpoint_restore.test.ts |  11 +++\n 2 files changed, 107 insertions(+), 62 deletions(-)\n1482d6b315129cd46fac61242c2eb91793ed8fd2\n{\"agent\":\"codex-root\",\"host\":\"mike-dev\",\"boot_id\":\"8928bf1f-8ae0-441b-8070-f05ef8823a5e\",\"branch\":\"v1/checkpoint-ordinary-child-fix\",\"worktree\":\"/home/mike/nexus-wt/checkpoint-ordinary-child-fix\",\"head\":\"1482d6b3\",\"since\":\"2026-10-28T17:32:02Z\",\"pid\":627382,\"scope\":\"Focused checkpoint restore validation, then full make test on immutable snapshot of exact candidate 1482d6b3; isolated HOME; no inference\"}\n","exit_code":0,"duration":{"secs":0,"nanos":942173348}},"started_at_ms":1793209320056,"completed_at_ms":1793209320998}}
