{"timestamp":"2026-10-28T17:54:54.933Z","ordinal":458450,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","item":{"type":"CommandExecution","id":"exec-971941c1-0da0-440f-8099-e1bf7e2f4ce8","process_id":"89589","command":["/usr/bin/zsh","-lc","nl -ba cli/src/checkpoint.ts | sed -n '975,1010p'; sed -n '620,655p' cli/test/checkpoint_restore.test.ts; git diff --check"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"unknown","cmd":"nl -ba cli/src/checkpoint.ts | sed -n '975,1010p'; sed -n '620,655p' cli/test/checkpoint_restore.test.ts; git diff --check"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"   975\t          // tracked directory: Git tries to inspect the old child through the\n   976\t          // symlink. A tree from the index is an equivalent snapshot only if\n   977\t          // there are no unstaged changes. Refuse the fallback otherwise.\n   978\t          try {\n   979\t            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff-files\", \"--quiet\"], { cwd: gitRoot, stdio: \"ignore\" });\n   980\t          } catch (diffError) {\n   981\t            if ((diffError as NodeJS.ErrnoException & { status?: number }).status === 1) throw error;\n   982\t            throw diffError;\n   983\t          }\n   984\t          const tree = execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"write-tree\"], { cwd: gitRoot, encoding: \"utf8\" }).trim();\n   985\t          const head = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: gitRoot, encoding: \"utf8\" }).trim();\n   986\t          stashCommit = execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"commit.gpgsign=false\", \"commit-tree\", tree, \"-p\", head], {\n   987\t            cwd: gitRoot,\n   988\t            encoding: \"utf8\",\n   989\t            env: hookGuardEnv,\n   990\t          }).trim();\n   991\t        }\n   992\t        if (stashCommit) {\n   993\t          // Catch a Git operation that began during validation or stash creation.\n   994\t          // This is a point-in-time guard; Git exposes no atomic lock spanning\n   995\t          // stash creation and publication of this separate checkpoint ref.\n   996\t          this.assertGitIndexUnlocked();\n   997\t          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", `refs/nexus/checkpoints/${id}`, stashCommit], {\n   998\t            cwd: this.workspace,\n   999\t            stdio: \"ignore\",\n  1000\t            env: hookGuardEnv,\n  1001\t          });\n  1002\t          gitRef = stashCommit;\n  1003\t        } else {\n  1004\t          // Working tree was clean; record HEAD\n  1005\t          const headCommit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: this.workspace, encoding: \"utf-8\" }).trim();\n  1006\t          this.assertGitIndexUnlocked();\n  1007\t          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", `refs/nexus/checkpoints/${id}`, headCommit], {\n  1008\t            cwd: this.workspace,\n  1009\t            stdio: \"ignore\",\n  1010\t            env: hookGuardEnv,\n    }\n  }\n});\n\ntest(\"Git restore preserves a committed post-checkpoint addition protected by later ignore rules\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"committed ignored addition protection\");\n    fs.writeFileSync(path.join(repo, \"later.cfg\"), \"operator data\\n\");\n    git(\"add\", \"later.cfg\");\n    git(\"commit\", \"-qm\", \"add later data\");\n    fs.writeFileSync(path.join(repo, \".gitignore\"), \"/later.cfg\\n\");\n    git(\"add\", \".gitignore\");\n    git(\"commit\", \"-qm\", \"protect later data from cleanup\");\n    const headBefore = git(\"rev-parse\", \"HEAD\");\n    assert.equal(git(\"check-ignore\", \"--no-index\", \"later.cfg\"), \"later.cfg\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /ignored|collision/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"later.cfg\"), \"utf8\"), \"operator data\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \".gitignore\"), \"utf8\"), \"/later.cfg\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"non-Git restore removes post-checkpoint entries and preserves ignored paths\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-files-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"at checkpoint\\n\");\n    const checkpoint = manager.createCheckpoint(\"exact non-Git restore\");\n","exit_code":0,"duration":{"secs":0,"nanos":854832604}},"started_at_ms":1793210094077,"completed_at_ms":1793210094933}}
