LOBAL\") delete gitProbeEnv[key];\n            }\n            try {\n              const discoveredGitDir = stripGitLineEnding(execFileSync(\"git\", [\"-C\", probeRoot, \"rev-parse\", \"--absolute-git-dir\"], {\n                cwd: root,\n                encoding: \"utf8\",\n                env: gitProbeEnv,\n                maxBuffer: 1024 * 1024,\n                timeout: 2000,\n                stdio: [\"ignore\", \"pipe\", \"ignore\"],\n              }));\n              if (fs.realpathSync(discoveredGitDir) === fs.realpathSync(probeRoot)) {\n                throw new Error(nestedRepositoryError);\n              }\n            } catch (error) {\n              if (error instanceof Error && error.message === nestedRepositoryError) throw error;\n              const status = (error as NodeJS.ErrnoException & { status?: number })?.status;\n              if (status !== 128) throw new Error(\"Checkpoint could not verify nested Git repository state\");\n            }\n\n            try {\n              const configuredBare = execFileSync(\"git\", [\"config\", \"--no-includes\", \"--file\", probeConfig, \"--type=bool\", \"--get\", \"core.bare\"], {\n                cwd: root,\n                encoding: \"utf8\",\n                env: gitProbeEnv,\n                maxBuffer: 1024 * 1024,\n                timeout: 2000,\n                stdio: [\"ignore\", \"pipe\", \"ignore\"],\n              }).trim();\n              if (configuredBare === \"true\") throw new Error(nestedRepositoryError);\n            } catch (error) {\n              if (error instanceof Error && error.message === nestedRepositoryError) throw error;\n              const status = (error as NodeJS.ErrnoException & { status?: number })?.status;\n  test(\"Grep test: forbids raw fs.writeFileSync, fs.appendFileSync, fs.mkdirSync in persistence modules\", () => {\n    const modules = [\n      \"checkpoint.ts\",\n      \"flight.ts\",\n      \"core/persistence_protection.ts\",\n      \"session.ts\",\n      \"core/state.ts\",\n      \"repl.ts\",\n      \"knowledge.ts\",\n      \"usage.ts\",\n    ];\n\n    for (const mod of modules) {\n      const filePath = path.join(srcDir, mod);\n      assert.ok(fs.existsSync(filePath), `Module ${filePath} must exist`);\n      const content = fs.readFileSync(filePath, \"utf8\");\n      const lines = content.split(\"\\n\");\n\n      for (let i = 0; i < lines.length; i++) {\n        const line = lines[i];\n        // Skip comments\n        if (line.trim().startsWith(\"//\") || line.trim().startsWith(\"*\")) continue;\n\n        // Check for raw fs writes\n        if (line.includes(\"fs.writeFileSync(\")) {\n          assert.fail(`Module ${mod}:${i + 1} uses raw fs.writeFileSync: ${line.trim()}`);\n        }\n        if (line.includes(\"fs.appendFileSync(\")) {\n          assert.fail(`Module ${mod}:${i + 1} uses raw fs.appendFileSync: ${line.trim()}`);\n        }\n        if (line.includes(\"fs.mkdirSync(\") && !mod.includes(\"safe_fs\")) {\n          assert.fail(`Module ${mod}:${i + 1} uses raw fs.mkdirSync: ${line.trim()}`);\n        }\n      }\n    }\n  });\n\n  test(\"Doctor state.permissions check and repair (chmod 700 dirs, 600 files, backup manifest)\", async () => {\n    const h = tmp(\"doctor-perm-home-\");\n    try {\n      const nexusDir = path.join(h, \".nexus\");\n      const sessionsDir = path.join(nexusDir, \"sessions\");\n      const auditLog = path.join(nexusDir, \"audit.log\");\n      const historyFile = path.join(h, \".nexus_history\");\n\n      fs.mkdirSync(sessionsDir, { recursive: true });\n## v1/checkpoint-ordinary-child-fix\n M cli/src/checkpoint.ts\n M cli/test/checkpoint_restore.test.ts\n{\"agent\":\"codex-root\",\"host\":\"mike-dev\",\"boot_id\":\"8928bf1f-8ae0-441b-8070-f05ef8823a5e\",\"branch\":\"v1/checkpoint-ordinary-child-fix\",\"worktree\":\"/home/mike/nexus-wt/checkpoint-ordinary-child-fix\",\"head\":\"1482d6b3\",\"since\":\"2026-10-28T17:47:25Z\",\"pid\":749679,\"scope\":\"Full make test on immutable snapshot