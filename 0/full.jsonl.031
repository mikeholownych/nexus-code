 \"sbom\": \"bash scripts/generate_sbom.sh\"\n  },\n  \"keywords\": [\n    \"ai-agent\",\n    \"coding-harness\",\n    \"codex\",\n    \"claude-code\",\n    \"rust\",\n    \"typescript\",\n    \"vllm\",\n    \"lm-studio\"\n  ],\n  \"author\": \"\",\n  \"license\": \"MIT\",\n  \"engines\": {\n    \"node\": \">=22\"\n  }\n}\n325:  private assertGitChangesSafe(allowSensitive: boolean): void {\n950:  public createCheckpoint(name?: string, options: { allowSensitive?: boolean } = {}): CheckpointInfo {\n965:        this.assertGitChangesSafe(allowSensitive);\n1008:        throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n26:function gitRepo(): { repo: string; git: (...args: string[]) => string } {\n860:    fs.writeFileSync(path.join(workspace, \"settings.txt\"), \"DATABASE_URL=REDACTED\");\n959:  fs.writeFileSync(path.join(data, \"file\"), \"ignored data must survive\\n\");\n962:  git(\"commit\", \"-qm\", \"tracked alias and ignored data\");\n976:    assert.equal(fs.readFileSync(path.join(data, \"file\"), \"utf8\"), \"ignored data must survive\\n\");\ndiff --git a/cli/src/checkpoint.ts b/cli/src/checkpoint.ts\nindex 0a8ea699..315bbc17 100644\n--- a/cli/src/checkpoint.ts\n+++ b/cli/src/checkpoint.ts\n@@ -154,12 +154,31 @@ export class CheckpointManager {\n \n   private assertNoIgnoredAddedPaths(relativePaths: string[]): void {\n     for (const relativePath of relativePaths) {\n+      const target = lstatOrAbsent(path.join(this.workspace, relativePath));\n+      // removeTrackedDeletions never removes a directory target, preserving\n+      // ignored descendants while the checkpoint's file deletion remains absent.\n+      if (target?.isDirectory() && !target.isSymbolicLink()) continue;\n+      // restore's tracked-deletion cleanup deliberately skips targets beneath\n+      // a missing, non-directory, or symlinked parent. Git check-ignore cannot\n+      // inspect such a path reliably (and may follow external links), so there\n+