{"timestamp":"2026-10-28T18:31:49.225Z","ordinal":459512,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","item":{"type":"CommandExecution","id":"exec-bfc559ea-638d-43a4-aa13-479687c36bf0","process_id":"31704","command":["/usr/bin/zsh","-lc","sed -n '1,75p' cli/src/checkpoint.ts; sed -n '155,205p' cli/src/checkpoint.ts; sed -n '165,205p' cli/test/checkpoint_restore.test.ts; sed -n '1910,1945p' cli/test/checkpoint_restore.test.ts;"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"read","cmd":"sed -n '1,75p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"read","cmd":"sed -n '155,205p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"read","cmd":"sed -n '165,205p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"},{"type":"read","cmd":"sed -n '1910,1945p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { execFileSync } from \"node:child_process\";\nimport { envWithoutConfiguredHooks } from \"./core/git_hook_guard.js\";\nimport crypto from \"node:crypto\";\nimport {\n  assertNoSensitivePersistenceContent,\n  redactForPersistence,\n  SensitivePersistenceError,\n} from \"./core/persistence_protection.js\";\nimport { ensurePrivateDir, writePrivateFile } from \"./core/durable_file.js\";\n\nexport interface CheckpointInfo {\n  id: string;\n  name: string;\n  timestamp: string;\n  workspace?: string;\n  gitRef?: string;\n  snapshotDir?: string;\n  allowSensitive?: boolean;\n  untrackedFiles?: string[];\n  untrackedFileModes?: Record<string, number>;\n  files?: Array<{ path: string; content: string }>;\n}\n\nfunction gitNulEntries(output: Buffer): Buffer[] {\n  const entries: Buffer[] = [];\n  let start = 0;\n  for (let end = output.indexOf(0); end !== -1; end = output.indexOf(0, start)) {\n    if (end > start) entries.push(output.subarray(start, end));\n    start = end + 1;\n  }\n  if (start < output.length) entries.push(output.subarray(start));\n  for (const entry of entries) {\n    const decoded = entry.toString(\"utf8\");\n    if (!Buffer.from(decoded, \"utf8\").equals(entry)) {\n      throw new GitPathEncodingError();\n    }\n  }\n  return entries;\n}\n\nfunction isGitPathIgnored(workspace: string, relativePath: string): boolean {\n  try {\n    execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--stdin\", \"-z\"], {\n      cwd: workspace,\n      input: Buffer.from(`${relativePath}\\0`, \"utf8\"),\n      stdio: [\"pipe\", \"ignore\", \"ignore\"],\n    });\n    return true;\n  } catch (error) {\n    if ((error as NodeJS.ErrnoException & { status?: number })?.status === 1) return false;\n    throw error;\n  }\n}\n\nfunction stripGitLineEnding(value: string): string {\n  return value.endsWith(\"\\n\") ? value.slice(0, -1) : value;\n}\n\nclass GitPathEncodingError extends Error {\n  constructor() {\n    super(\"Checkpoint cannot safely process Git paths that are not valid UTF-8\");\n    this.name = \"GitPathEncodingError\";\n  }\n}\n\nconst NESTED_GIT_REPOSITORY_ERROR = \"Checkpoint destination parent is a nested Git repository\";\n\nfunction lstatOrAbsent(target: string): fs.Stats | undefined {\n  try {\n    return fs.lstatSync(target, { throwIfNoEntry: false });\n  } catch (error) {\n    const code = (error as NodeJS.ErrnoException).code;\n  private assertNoActiveGitOperation(): void {\n    const markers = [\"MERGE_HEAD\", \"CHERRY_PICK_HEAD\", \"REVERT_HEAD\", \"rebase-apply\", \"rebase-merge\", \"sequencer\"];\n    for (const marker of markers) {\n      const gitPath = stripGitLineEnding(execFileSync(\"git\", [\"rev-parse\", \"--git-path\", marker], {\n        cwd: this.workspace,\n        encoding: \"utf8\",\n      }));\n      const absolutePath = path.isAbsolute(gitPath) ? gitPath : path.resolve(this.workspace, gitPath);\n      if (lstatOrAbsent(absolutePath)) {\n        throw new Error(\"Checkpoint cannot restore while Git operation state is present; workspace was not changed\");\n      }\n    }\n  }\n\n  private assertNoIgnoredAddedPaths(relativePaths: string[]): void {\n    for (const relativePath of relativePaths) {\n      const target = lstatOrAbsent(path.join(this.workspace, relativePath));\n      // removeTrackedDeletions never removes a directory target, preserving\n      // ignored descendants while the checkpoint's file deletion remains absent.\n      if (target?.isDirectory() && !target.isSymbolicLink()) continue;\n      // restore's tracked-deletion cleanup deliberately skips targets beneath\n      // a missing, non-directory, or symlinked parent. Git check-ignore cannot\n      // inspect such a path reliably (and may follow external links), so there\n      // is no ignored target that this restore could remove in that case.\n      let parent = this.workspace;\n      let blocked = false;\n      for (const component of relativePath.split(\"/\").slice(0, -1)) {\n        parent = path.join(parent, component);\n        const stat = lstatOrAbsent(parent);\n        if (!stat || !stat.isDirectory() || stat.isSymbolicLink()) {\n          blocked = true;\n          break;\n        }\n      }\n      if (blocked) continue;\n      let ignored: boolean;\n      try {\n        ignored = isGitPathIgnored(this.workspace, relativePath);\n      } catch {\n        throw new Error(\"Checkpoint could not verify whether a staged addition is ignored; workspace was not changed\");\n      }\n      if (ignored) throw new Error(\"Checkpoint restore refuses to remove a staged addition ignored by current Git rules (untracked collision); workspace was not changed\");\n    }\n  }\n\n  private restoreGitIndex(gitRef: string, hookGuardEnv: NodeJS.ProcessEnv): void {\n    const prefix = this.gitWorkspacePrefix();\n    const repositoryRoot = this.gitRoot();\n    if (!prefix) {\n      execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"read-tree\", gitRef], {\n        cwd: repositoryRoot,\n    assert.equal(result.success, false);\n    assert.match(result.message, /ignored by current Git rules/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"ignored.bin\"), \"utf8\"), \"ignored staged payload\\n\");\n    assert.equal(execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\"), indexBefore);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git restore treats pathspec-magic filenames literally when checking ignored additions\", () => {\n  const { repo, git } = gitRepo();\n  const magicName = \":(exclude)ignored.bin\";\n  try {\n    fs.writeFileSync(path.join(repo, \".gitignore\"), `${magicName}\\n`);\n    git(\"add\", \".gitignore\");\n    git(\"commit\", \"-qm\", \"ignore a pathspec-looking filename\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"before forced pathspec-looking addition\");\n    fs.writeFileSync(path.join(repo, magicName), \"ignored staged payload\\n\");\n    git(\"add\", \"-f\", magicName);\n    const indexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /ignored by current Git rules/i);\n    assert.equal(fs.readFileSync(path.join(repo, magicName), \"utf8\"), \"ignored staged payload\\n\");\n    assert.equal(execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\"), indexBefore);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git restore does not treat glob syntax in a filename as an ignore-pattern match\", () => {\n  const { repo, git } = gitRepo();\n  const globName = \"file[ab].txt\";\n  try {\n    fs.writeFileSync(path.join(repo, \".gitignore\"), `${globName}\\n`);\n    git(\"add\", \".gitignore\");\n    git(\"commit\", \"-qm\", \"ignore matching glob paths\");\n    assert.equal(git(\"check-ignore\", \"--no-index\", \"filea.txt\"), \"filea.txt\");\n    assert.equal(indexAfter, indexBefore, \"a rejected preflight must leave the Git index entries unchanged\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git restore checks ignored descendants literally beneath a pathspec-looking directory\", () => {\n  const { repo, git } = gitRepo();\n  const magicDirectory = \":(top)target\";\n  try {\n    fs.writeFileSync(path.join(repo, \".gitignore\"), `${magicDirectory}/ignored\\n`);\n    git(\"add\", \".gitignore\");\n    git(\"commit\", \"-qm\", \"ignore a child beneath a pathspec-looking directory\");\n    fs.writeFileSync(path.join(repo, magicDirectory), \"captured file\\n\");\n    git(\"add\", \"--\", `:(literal)${magicDirectory}`);\n    git(\"commit\", \"-qm\", \"track pathspec-looking file target\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"magic-looking tracked path\");\n\n    fs.rmSync(path.join(repo, magicDirectory));\n    fs.mkdirSync(path.join(repo, magicDirectory));\n    fs.writeFileSync(path.join(repo, magicDirectory, \"ignored\"), \"ignored canary\\n\");\n    fs.writeFileSync(path.join(repo, \"outside-canary.txt\"), \"preserve me\\n\");\n    const headBefore = git(\"rev-parse\", \"HEAD\");\n    const indexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe|snapshot/i);\n    assert.equal(fs.readFileSync(path.join(repo, magicDirectory, \"ignored\"), \"utf8\"), \"ignored canary\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"outside-canary.txt\"), \"utf8\"), \"preserve me\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n    assert.equal(execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\"), indexBefore);\n  } finally {\n    cleanupGitRepo(repo);\n","exit_code":0,"duration":{"secs":0,"nanos":700006252}},"started_at_ms":1793212308524,"completed_at_ms":1793212309225}}
