{"timestamp":"2026-10-28T16:55:42.020Z","ordinal":455805,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","item":{"type":"CommandExecution","id":"exec-ac11ff0e-466d-48dd-a855-b0e5355966a0","process_id":"19965","command":["/usr/bin/zsh","-lc","sed -n '1,120p' cli/test/checkpoint_restore.test.ts; sed -n '32,108p' cli/src/checkpoint.ts; rg 'function gitRepo|const gitRepo' cli/test/checkpoint_restore.test.ts"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"read","cmd":"sed -n '1,120p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"},{"type":"read","cmd":"sed -n '32,108p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"search","cmd":"rg 'function gitRepo|const gitRepo' cli/test/checkpoint_restore.test.ts","query":"function gitRepo|const gitRepo","path":"checkpoint_restore.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { CheckpointManager } from \"../src/checkpoint.js\";\nimport { SensitivePersistenceError } from \"../src/core/persistence_protection.js\";\n\nlet previousHome: string | undefined;\nlet isolatedHome: string;\n\ntest.beforeEach(() => {\n  previousHome = process.env.HOME;\n  isolatedHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-home-\"));\n  process.env.HOME = isolatedHome;\n});\n\ntest.afterEach(() => {\n  if (previousHome === undefined) delete process.env.HOME;\n  else process.env.HOME = previousHome;\n  fs.rmSync(isolatedHome, { recursive: true, force: true });\n});\n\nfunction gitRepo(): { repo: string; git: (...args: string[]) => string } {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-\"));\n  const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: repo, encoding: \"utf8\" }).trim();\n  git(\"init\", \"-q\");\n  git(\"config\", \"user.email\", \"test@example.invalid\");\n  git(\"config\", \"user.name\", \"Test\");\n  fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"base\\n\");\n  git(\"add\", \"tracked.txt\");\n  git(\"commit\", \"-qm\", \"base\");\n  return { repo, git };\n}\n\nfunction cleanupGitRepo(repo: string): void {\n  const checkpointKey = createHash(\"sha256\").update(path.resolve(repo)).digest(\"hex\").slice(0, 12);\n  fs.rmSync(path.join(os.homedir(), \".nexus\", \"checkpoints\", checkpointKey), { recursive: true, force: true });\n  fs.rmSync(repo, { recursive: true, force: true });\n}\n\ntest(\"Git restore preserves untracked work and HEAD while removing post-checkpoint files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"pre-existing user work\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"preserve work\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"after checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"created-later.txt\"), \"remove me\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"at checkpoint\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"pre-existing user work\\n\");\n    assert.equal(fs.existsSync(path.join(repo, \"created-later.txt\")), false);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git restore preserves executable permissions on captured untracked files\", () => {\n  const { repo } = gitRepo();\n  try {\n    const tool = path.join(repo, \"tool.sh\");\n    fs.writeFileSync(tool, \"#!/bin/sh\\nexit 0\\n\", { mode: 0o751 });\n    fs.chmodSync(tool, 0o751);\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"untracked executable\");\n    fs.chmodSync(tool, 0o600);\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.statSync(tool).mode & 0o777, 0o751);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git restore refuses to mutate while merge metadata is present\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"checkpoint state\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"before resolved merge commit\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"current state\\n\");\n    const indexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n    const mergeHead = git(\"rev-parse\", \"HEAD\");\n    fs.writeFileSync(path.join(repo, \".git\", \"MERGE_HEAD\"), `${mergeHead}\\n`);\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /Git operation state/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"current state\\n\");\n    assert.equal(execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\"), indexBefore);\n    assert.equal(fs.readFileSync(path.join(repo, \".git\", \"MERGE_HEAD\"), \"utf8\"), `${mergeHead}\\n`);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"checkpoint creation fails closed for non-UTF-8 Git paths before publishing a ref\", { skip: process.platform === \"win32\" }, () => {\n  const { repo, git } = gitRepo();\n  try {\n    const invalidName = Buffer.concat([Buffer.from(`${repo}/invalid-`), Buffer.from([0xff])]);\n    fs.writeFileSync(invalidName, \"must not be misaddressed\\n\");\n    git(\"add\", \"--all\");\n    const manager = new CheckpointManager(repo);\n\n    assert.throws(() => manager.createCheckpoint(\"non UTF-8 path\"), /not valid UTF-8/i);\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n    start = end + 1;\n  }\n  if (start < output.length) entries.push(output.subarray(start));\n  for (const entry of entries) {\n    const decoded = entry.toString(\"utf8\");\n    if (!Buffer.from(decoded, \"utf8\").equals(entry)) {\n      throw new Error(\"Checkpoint cannot safely process Git paths that are not valid UTF-8\");\n    }\n  }\n  return entries;\n}\n\nfunction stripGitLineEnding(value: string): string {\n  return value.endsWith(\"\\r\\n\") ? value.slice(0, -2) : value.endsWith(\"\\n\") ? value.slice(0, -1) : value;\n}\n\nfunction lstatOrAbsent(target: string): fs.Stats | undefined {\n  try {\n    return fs.lstatSync(target, { throwIfNoEntry: false });\n  } catch (error) {\n    const code = (error as NodeJS.ErrnoException).code;\n    if (code === \"ENOENT\" || code === \"ENOTDIR\") return undefined;\n    throw error;\n  }\n}\n\nclass GitIndexLockError extends Error {\n  constructor() {\n    super(\"Git index lock exists; check for an active Git operation before deciding whether the lock is stale.\");\n    this.name = \"GitIndexLockError\";\n  }\n}\n\nclass GitIndexLockCheckError extends Error {\n  constructor() {\n    super(\"Could not inspect the Git index lock; checkpoint creation stopped without changing Git state.\");\n    this.name = \"GitIndexLockCheckError\";\n  }\n}\n\nexport class CheckpointManager {\n  private workspace: string;\n  private checkpointDir: string;\n  private isGit: boolean = false;\n  private repositoryRootCache: string | undefined;\n  private workspacePrefixCache: string | undefined;\n\n  constructor(workspace: string) {\n    this.workspace = path.resolve(workspace);\n    const hash = crypto.createHash(\"sha256\").update(this.workspace).digest(\"hex\").slice(0, 12);\n    this.checkpointDir = path.join(os.homedir(), \".nexus\", \"checkpoints\", hash);\n    ensurePrivateDir(this.checkpointDir);\n    this.checkGit();\n  }\n\n  private checkGit(): void {\n    try {\n      execFileSync(\"git\", [\"rev-parse\", \"--is-inside-work-tree\"], { cwd: this.workspace, stdio: \"ignore\" });\n      this.isGit = true;\n    } catch {\n      this.isGit = false;\n    }\n  }\n\n  private gitRoot(): string {\n    if (!this.repositoryRootCache) {\n      this.repositoryRootCache = fs.realpathSync(stripGitLineEnding(execFileSync(\"git\", [\"rev-parse\", \"--show-toplevel\"], {\n        cwd: this.workspace,\n        encoding: \"utf8\",\n      })));\n    }\n    return this.repositoryRootCache;\n  }\n\n  private gitWorkspacePrefix(): string {\n    if (this.workspacePrefixCache === undefined) {\n      const prefix = stripGitLineEnding(execFileSync(\"git\", [\"rev-parse\", \"--show-prefix\"], {\nfunction gitRepo(): { repo: string; git: (...args: string[]) => string } {\n","exit_code":0,"duration":{"secs":0,"nanos":984032705}},"started_at_ms":1793206541035,"completed_at_ms":1793206542020}}
