data must survive\\n\");\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"checkpoint refuses the symlink snapshot fallback when Git hides worktree paths\", () => {\n  for (const indexFlag of [\"--assume-unchanged\", \"--skip-worktree\"]) {\n    const { repo, git } = gitRepo();\n    const alias = path.join(repo, \"alias\");\n    fs.mkdirSync(alias);\n    fs.writeFileSync(path.join(alias, \"file\"), \"tracked alias file\\n\");\n    fs.mkdirSync(path.join(repo, \"data\"));\n    fs.writeFileSync(path.join(repo, \"data\", \"file\"), \"external target\\n\");\n    git(\"add\", \"alias/file\");\n    git(\"commit\", \"-qm\", \"tracked directory for hidden worktree flag\");\n    const manager = new CheckpointManager(repo);\n    try {\n      fs.rmSync(path.join(alias, \"file\"));\n      fs.rmdirSync(alias);\n      fs.symlinkSync(\"data\", alias);\n      git(\"add\", \"-A\", \"alias\");\n      git(\"update-index\", indexFlag, \"alias\");\n\n      assert.throws(\n        () => manager.createCheckpoint(`hidden worktree path ${indexFlag}`),\n        /could not verify protected Git state/,\n      );\n      assert.equal(manager.listCheckpoints().length, 0);\n      assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n    } finally {\n      cleanupGitRepo(repo);\n    }\n  }\n});\n\ntest(\"checkpoint refuses the symlink snapshot fallback when Git hides worktree paths\", () => {\n  for (const indexFlag of [\"--assume-unchanged\", \"--skip-worktree\"]) {\n    const { repo, git } = gitRepo();\n    const alias = path.join(repo, \"alias\");\n    fs.mkdirSync(alias);\n    fs.writeFileSync(path.join(alias, \"file\"), \"tracked alias file\\n\");\n    fs.mkdirSync(path.join(repo, \"data\"));\n    fs.writeFileSync(path.join(repo, \"data\", \"file\"), \"external target\\n\");\n    git(\"add\", \"alias/file\");\n    git(\"commit\", \"-qm\", \"tracked directory for hidden worktree flag\");\n    const manager = new CheckpointManager(repo);\n    try {\n      fs.rmSync(path.join(alias, \"file\"));\n      fs.rmdirSync(alias);\n      fs.symlinkSync(\"data\", alias);\n      git(\"add\", \"-A\", \"alias\");\n      git(\"update-index\", indexFlag, \"alias\");\n\n      assert.throws(\n        () => manager.createCheckpoint(`hidden worktree path ${indexFlag}`),\n        /assume-unchanged or skip-worktree/,\n      );\n      assert.equal(manager.listCheckpoints().length, 0);\n      assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n    } finally {\n 768314       09:45 Sl\n  ✔ a follow-up turn on a record whose removal notes were omitted cannot rest on the output they covered (561.61035ms)\n  ✔ an observation's identity is bounded: a large write is named by its start and a hash, still distinct, and the record does not carry its content (89.465476ms)\n  ✔ a finding holds exactly the observations it came from: past the header's cap, and not another tool's whose key contains it (114.39683ms)\n  ✔ only labelled findings are lifted out of an untrusted record; anything else stays opaque (467.868322ms)\n  ✔ re-running a call whose findings were recorded is answered in full, marked with when, whether it changed, and the step (10169.741335ms)\n  ✔ findings from an output that has since changed, or was seen only in part, are recorded again; the comparison ignores the note (7813.261952ms)\n  ✔ the re-run note survives when an oversized re-run is cut to fit the context (5759.313622ms)\n","exit_code":0,"duration":{"secs":0,"nanos":881770303}},"started_at_ms":1793210319530,"completed_at_ms":1793210320413}}
