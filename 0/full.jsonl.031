{"timestamp":"2026-10-28T17:52:59.346Z","ordinal":458369,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","item":{"type":"CommandExecution","id":"exec-73585148-d3e5-4373-905e-3300d01dc757","process_id":"50696","command":["/usr/bin/zsh","-lc","sed -n '680,735p' cli/src/checkpoint.ts; sed -n '1250,1320p' cli/src/checkpoint.ts; sed -n '560,635p' cli/test/checkpoint_restore.test.ts; sed -n '1140,1235p' cli/test/checkpoint_restore.test.ts"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"read","cmd":"sed -n '680,735p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"read","cmd":"sed -n '1250,1320p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"read","cmd":"sed -n '560,635p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"},{"type":"read","cmd":"sed -n '1140,1235p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"        if (!parentStat || !parentStat.isDirectory() || parentStat.isSymbolicLink()) {\n          blocked = true;\n          break;\n        }\n      }\n      if (blocked) continue;\n      try {\n        if (lstatOrAbsent(targetPath)?.isDirectory()) continue;\n        fs.rmSync(targetPath, { force: true });\n      } catch (error) {\n        const code = (error as NodeJS.ErrnoException).code;\n        if (code !== \"ENOENT\" && code !== \"ENOTDIR\") throw error;\n      }\n    }\n  }\n\n  private gitRefDeletedPaths(gitRef: string): string[] {\n    const paths = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--no-renames\", \"--name-only\", \"--diff-filter=D\", \"-z\", \"HEAD\", gitRef], {\n      cwd: this.gitRoot(),\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    }));\n    const decodedPaths = paths.map((entry) => entry.toString(\"utf8\"));\n    return decodedPaths.flatMap((gitPath) => {\n      const relativePath = this.workspaceRelativeGitPath(gitPath);\n      return relativePath ? [relativePath] : [];\n    });\n  }\n\n  private trackedPathsAddedSince(gitRef: string): string[] {\n    const root = this.gitRoot();\n    const committed = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--no-renames\", \"--name-only\", \"--diff-filter=A\", \"-z\", gitRef, \"HEAD\"], {\n      cwd: root,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    })).map((entry) => entry.toString(\"utf8\")).flatMap((gitPath) => {\n      const relativePath = this.workspaceRelativeGitPath(gitPath);\n      return relativePath ? [relativePath] : [];\n    });\n    const staged = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff-index\", \"--cached\", \"--no-renames\", \"--name-only\", \"--diff-filter=A\", \"-z\", gitRef], {\n      cwd: root,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    })).map((entry) => entry.toString(\"utf8\")).flatMap((gitPath) => {\n      const relativePath = this.workspaceRelativeGitPath(gitPath);\n      return relativePath ? [relativePath] : [];\n    });\n    return [...new Set([...committed, ...staged])];\n  }\n\n  private workspaceSnapshotPaths(root: string): string[] {\n    const ignored = new Set([\"node_modules\", \".git\", \"target\", \"dist\", \".nexus\", \".next\", \".cache\"]);\n    const paths: string[] = [];\n    const visit = (directory: string, relative: string): void => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        if (ignored.has(entry.name)) continue;\n              execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", ref, deletedRefTarget, \"0\".repeat(deletedRefTarget.length)], {\n                cwd: this.workspace,\n                stdio: \"ignore\",\n                env: hookEnv,\n              });\n            } catch (restoreError: any) {\n              throw new Error(`${error instanceof Error ? error.message : String(error)}; checkpoint ref restoration failed: ${restoreError?.message || String(restoreError)}`);\n            }\n          }\n          throw error;\n        }\n        if (cp.snapshotDir && fs.existsSync(cp.snapshotDir)) {\n          fs.rmSync(cp.snapshotDir, { recursive: true, force: true });\n        }\n        count++;\n      } catch (error: any) {\n        failures.push(`${cp.id}: ${error?.message || String(error)}`);\n      }\n    }\n\n    const message = `Pruned ${count} old checkpoints (retained ${keepCount} most recent).`;\n    return {\n      prunedCount: count,\n      message: failures.length === 0 ? message : `${message} ${failures.length} checkpoint(s) could not be pruned: ${failures.join(\"; \")}`,\n    };\n  }\n\n  public rollbackLast(): { success: boolean; message: string } {\n    const checkpoints = this.listCheckpoints();\n    if (checkpoints.length === 0) {\n      return { success: false, message: \"No checkpoints available to roll back to.\" };\n    }\n    const target = checkpoints[0];\n    return this.restore(target.id);\n  }\n\n  public restore(id: string): { success: boolean; message: string } {\n    const cp = this.getCheckpoint(id);\n    if (!cp) {\n      return { success: false, message: `Checkpoint '${id}' not found.` };\n    }\n    if (cp.gitRef && !this.isGit) {\n      return { success: false, message: `Rollback failed: checkpoint '${cp.id}' requires its Git repository metadata; workspace was not changed` };\n    }\n\n    try {\n      if (this.isGit && cp.gitRef) {\n        const hookGuardEnv = envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\", \"post-index-change\"]);\n        const postCheckpointAdditions = this.trackedPathsAddedSince(cp.gitRef);\n        this.assertNoIgnoredAddedPaths(this.stagedPathsAddedToHead());\n        const deletedPaths = this.gitRefDeletedPaths(cp.gitRef);\n        const checkoutPaths = this.gitRefBlobPaths(cp.gitRef);\n        const writePaths = [...new Set([...checkoutPaths, ...(cp.untrackedFiles ?? [])])];\n        const removalPaths = [...new Set([...deletedPaths, ...postCheckpointAdditions])];\n        if (cp.untrackedFiles !== undefined && cp.untrackedFiles.length > 0) {\n          if (!cp.snapshotDir) return { success: false, message: `Rollback failed: checkpoint '${cp.id}' is missing its untracked snapshot; workspace was not changed` };\n          try {\n            this.assertUntrackedSnapshotSafe(cp.untrackedFiles, cp.snapshotDir, cp.allowSensitive === true);\n            this.assertUntrackedDestinationSafe(cp.untrackedFiles, this.workspace);\n          } catch (error) {\n            if (error instanceof Error && error.message === NESTED_GIT_REPOSITORY_ERROR) {\n              return { success: false, message: `Rollback failed: checkpoint '${cp.id}' has a destination in a nested Git repository; workspace was not changed` };\n            }\n            return { success: false, message: `Rollback failed: checkpoint '${cp.id}' has an unsafe untracked snapshot or destination; workspace was not changed` };\n          }\n        }\n        // Validate every path that restore may write or remove before read-tree\n        // mutates the outer index. Tracked deletions are destructive too: they\n        // must not cross into nested repositories in the current worktree.\n        this.assertNoNestedGitRepositoryAncestors(writePaths, this.workspace);\n        // Tracked deletion cleanup intentionally leaves targets behind when a\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"a\"), \"utf8\"), \"tracked checkpoint blob\\n\");\n    assert.equal(fs.existsSync(path.join(repo, \"a\", \"child.txt\")), false);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n    assert.deepEqual(git(\"ls-files\", \"--\", \"a\"), \"a\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore replaces a checkpoint-tracked file over an ordinary untracked child\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"a\"), \"captured file\\n\");\n    git(\"add\", \"a\");\n    git(\"commit\", \"-qm\", \"track checkpoint file target\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"untracked child replacement\");\n    fs.rmSync(path.join(repo, \"a\"));\n    fs.mkdirSync(path.join(repo, \"a\"));\n    fs.writeFileSync(path.join(repo, \"a\", \"child.txt\"), \"ordinary untracked child\\n\");\n    assert.equal(git(\"clean\", \"-nd\", \"--\", \"a\").trim(), \"\", \"Git omits untracked children from the preview when the target path remains tracked\");\n    const headBefore = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"a\"), \"utf8\"), \"captured file\\n\");\n    assert.equal(fs.existsSync(path.join(repo, \"a\", \"child.txt\")), false);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy Git restore removes staged and committed tracked additions made after the checkpoint\", () => {\n  for (const committed of [false, true]) {\n    const { repo, git } = gitRepo();\n    try {\n      const manager = new CheckpointManager(repo);\n      const checkpoint = manager.createCheckpoint(`legacy post-checkpoint addition ${committed ? \"committed\" : \"staged\"}`);\n      const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n      const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n      delete record.untrackedFiles;\n      delete record.untrackedFileModes;\n      fs.writeFileSync(recordPath, JSON.stringify(record));\n      fs.writeFileSync(path.join(repo, \"added-after-checkpoint.txt\"), \"remove on restore\\n\");\n      git(\"add\", \"added-after-checkpoint.txt\");\n      if (committed) git(\"commit\", \"-qm\", \"post-checkpoint addition\");\n      const head = git(\"rev-parse\", \"HEAD\");\n\n      const result = manager.restore(checkpoint.id);\n\n      assert.equal(result.success, true, result.message);\n      assert.equal(fs.existsSync(path.join(repo, \"added-after-checkpoint.txt\")), false);\n      assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    } finally {\n      cleanupGitRepo(repo);\n    }\n  }\n});\n\ntest(\"non-Git restore removes post-checkpoint entries and preserves ignored paths\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-files-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"at checkpoint\\n\");\n    const checkpoint = manager.createCheckpoint(\"exact non-Git restore\");\n    fs.writeFileSync(path.join(workspace, \"b.txt\"), \"created later\\n\");\n    fs.mkdirSync(path.join(workspace, \"node_modules\"));\n    fs.writeFileSync(path.join(workspace, \"node_modules\", \"keep.txt\"), \"ignored\\n\");\n    const result = manager.restore(checkpoint.id);\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.existsSync(path.join(workspace, \"b.txt\")), false);\n  try {\n    fs.writeFileSync(path.join(workspace, \"captured.txt\"), \"captured\\n\");\n    const checkpoint = manager.createCheckpoint(\"legacy empty directory destination\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    delete record.untrackedFileModes;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    fs.mkdirSync(path.join(checkpoint.snapshotDir!, \"alias\", \"newdir\"), { recursive: true });\n    fs.symlinkSync(external, path.join(workspace, \"alias\"));\n    fs.writeFileSync(path.join(workspace, \"workspace.txt\"), \"workspace canary\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe/i);\n    assert.equal(fs.existsSync(path.join(external, \"newdir\")), false);\n    assert.equal(fs.readFileSync(path.join(workspace, \"workspace.txt\"), \"utf8\"), \"workspace canary\\n\");\n    assert.equal(fs.readlinkSync(path.join(workspace, \"alias\")), external);\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n    fs.rmSync(external, { recursive: true, force: true });\n  }\n});\n\ntest(\"legacy Git restore refuses an ignored untracked checkout collision\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy ignored checkout collision\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    delete record.untrackedFileModes;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    git(\"rm\", \"--cached\", \"-q\", \"tracked.txt\");\n    fs.writeFileSync(path.join(repo, \".gitignore\"), \"/tracked.txt\\n\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"ignored untracked canary\\n\");\n    assert.equal(git(\"check-ignore\", \"tracked.txt\"), \"tracked.txt\");\n    const head = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked|collision/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"ignored untracked canary\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy Git restore refuses an ignored untracked tracked-deletion collision\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"deleted.txt\"), \"base\\n\");\n    git(\"add\", \"deleted.txt\");\n    git(\"commit\", \"-qm\", \"add deleted file\");\n    fs.rmSync(path.join(repo, \"deleted.txt\"));\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy ignored deletion collision\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    delete record.untrackedFileModes;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    git(\"rm\", \"--cached\", \"-q\", \"deleted.txt\");\n    fs.writeFileSync(path.join(repo, \".gitignore\"), \"/deleted.txt\\n\");\n    fs.writeFileSync(path.join(repo, \"deleted.txt\"), \"ignored untracked canary\\n\");\n    assert.equal(git(\"check-ignore\", \"deleted.txt\"), \"deleted.txt\");\n    const head = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked|collision/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"deleted.txt\"), \"utf8\"), \"ignored untracked canary\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"non-Git restore preserves a pre-checkpoint FIFO\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-fifo-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"captured\\n\");\n    const fifo = path.join(workspace, \"pre-existing.fifo\");\n    execFileSync(\"mkfifo\", [fifo]);\n    const checkpoint = manager.createCheckpoint(\"preserve FIFO\");\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"changed later\\n\");\n\n    const result = manager.restore(checkpoint.id);\n","exit_code":0,"duration":{"secs":0,"nanos":709658498}},"started_at_ms":1793209978636,"completed_at_ms":1793209979346}}
{"timestamp":"2026-10-28T17:53:00.483Z","ordinal":458370,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a183a4-d642-7241-8c57-0514f552157d","call_id":"call_f39b561eb417405fa30d29675940ce25","output":[{"type":"input_text","text":"Script completed\nWall time 3.0 seconds\nOutput:\n"},{"type":"input_text","text":"        if (!parentStat || !parentStat.isDirectory() || parentStat.isSymbolicLink()) {\n          blocked = true;\n          break;\n        }\n      }\n      if (blocked) continue;\n      try {\n        if (lstatOrAbsent(targetPath)?.isDirectory()) continue;\n        fs.rmSync(targetPath, { force: true });\n      } catch (error) {\n        const code = (error as NodeJS.ErrnoException).code;\n        if (code !== \"ENOENT\" && code !== \"ENOTDIR\") throw error;\n      }\n    }\n  }\n\n  private gitRefDeletedPaths(gitRef: string): string[] {\n    const paths = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--no-renames\", \"--name-only\", \"--diff-filter=D\", \"-z\", \"HEAD\", gitRef], {\n      cwd: this.gitRoot(),\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    }));\n    const decodedPaths = paths.map((entry) => entry.toString(\"utf8\"));\n    return decodedPaths.flatMap((gitPath) => {\n      const relativePath = this.workspaceRelativeGitPath(gitPath);\n      return relativePath ? [relativePath] : [];\n    });\n  }\n\n  private trackedPathsAddedSince(gitRef: string): string[] {\n    const root = this.gitRoot();\n    const committed = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--no-renames\", \"--name-only\", \"--diff-filter=A\", \"-z\", gitRef, \"HEAD\"], {\n      cwd: root,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    })).map((entry) => entry.toString(\"utf8\")).flatMap((gitPath) => {\n      const relativePath = this.workspaceRelativeGitPath(gitPath);\n      return relativePath ? [relativePath] : [];\n    });\n    const staged = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff-index\", \"--cached\", \"--no-renames\", \"--name-only\", \"--diff-filter=A\", \"-z\", gitRef], {\n      cwd: root,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    })).map((entry) => entry.toString(\"utf8\")).flatMap((gitPath) => {\n      const relativePath = this.workspaceRelativeGitPath(gitPath);\n      return relativePath ? [relativePath] : [];\n    });\n    return [...new Set([...committed, ...staged])];\n  }\n\n  private workspaceSnapshotPaths(root: string): string[] {\n    const ignored = new Set([\"node_modules\", \".git\", \"target\", \"dist\", \".nexus\", \".next\", \".cache\"]);\n    const paths: string[] = [];\n    const visit = (directory: string, relative: string): void => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        if (ignored.has(entry.name)) continue;\n              execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", ref, deletedRefTarget, \"0\".repeat(deletedRefTarget.length)], {\n                cwd: this.workspace,\n                stdio: \"ignore\",\n                env: hookEnv,\n              });\n            } catch (restoreError: any) {\n              throw new Error(`${error instanceof Error ? error.message : String(error)}; checkpoint ref restoration failed: ${restoreError?.message || String(restoreError)}`);\n            }\n          }\n          throw error;\n        }\n        if (cp.snapshotDir && fs.existsSync(cp.snapshotDir)) {\n          fs.rmSync(cp.snapshotDir, { recursive: true, force: true });\n        }\n        count++;\n      } catch (error: any) {\n        failures.push(`${cp.id}: ${error?.message || String(error)}`);\n      }\n    }\n\n    const message = `Pruned ${count} old checkpoints (retained ${keepCount} most recent).`;\n    return {\n      prunedCount: count,\n      message: failures.length === 0 ? message : `${message} ${failures.length} checkpoint(s) could not be pruned: ${failures.join(\"; \")}`,\n    };\n  }\n\n  public rollbackLast(): { success: boolean; message: string } {\n    const checkpoints = this.listCheckpoints();\n    if (checkpoints.length === 0) {\n      return { success: false, message: \"No checkpoints available to roll back to.\" };\n    }\n    const target = checkpoints[0];\n    return this.restore(target.id);\n  }\n\n  public restore(id: string): { success: boolean; message: string } {\n    const cp = this.getCheckpoint(id);\n    if (!cp) {\n      return { success: false, message: `Checkpoint '${id}' not found.` };\n    }\n    if (cp.gitRef && !this.isGit) {\n      return { success: false, message: `Rollback failed: checkpoint '${cp.id}' requires its Git repository metadata; workspace was not changed` };\n    }\n\n    try {\n      if (this.isGit && cp.gitRef) {\n        const hookGuardEnv = envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\", \"post-index-change\"]);\n        const postCheckpointAdditions = this.trackedPathsAddedSince(cp.gitRef);\n        this.assertNoIgnoredAddedPaths(this.stagedPathsAddedToHead());\n        const deletedPaths = this.gitRefDeletedPaths(cp.gitRef);\n        const checkoutPaths = this.gitRefBlobPaths(cp.gitRef);\n        const writePaths = [...new Set([...checkoutPaths, ...(cp.untrackedFiles ?? [])])];\n        const removalPaths = [...new Set([...deletedPaths, ...postCheckpointAdditions])];\n        if (cp.untrackedFiles !== undefined && cp.untrackedFiles.length > 0) {\n          if (!cp.snapshotDir) return { success: false, message: `Rollback failed: checkpoint '${cp.id}' is missing its untracked snapshot; workspace was not changed` };\n          try {\n            this.assertUntrackedSnapshotSafe(cp.untrackedFiles, cp.snapshotDir, cp.allowSensitive === true);\n            this.assertUntrackedDestinationSafe(cp.untrackedFiles, this.workspace);\n          } catch (error) {\n            if (error instanceof Error && error.message === NESTED_GIT_REPOSITORY_ERROR) {\n              return { success: false, message: `Rollback failed: checkpoint '${cp.id}' has a destination in a nested Git repository; workspace was not changed` };\n            }\n            return { success: false, message: `Rollback failed: checkpoint '${cp.id}' has an unsafe untracked snapshot or destination; workspace was not changed` };\n          }\n        }\n        // Validate every path that restore may write or remove before read-tree\n        // mutates the outer index. Tracked deletions are destructive too: they\n        // must not cross into nested repositories in the current worktree.\n        this.assertNoNestedGitRepositoryAncestors(writePaths, this.workspace);\n        // Tracked deletion cleanup intentionally leaves targets behind when a\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"a\"), \"utf8\"), \"tracked checkpoint blob\\n\");\n    assert.equal(fs.existsSync(path.join(repo, \"a\", \"child.txt\")), false);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n    assert.deepEqual(git(\"ls-files\", \"--\", \"a\"), \"a\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore replaces a checkpoint-tracked file over an ordinary untracked child\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"a\"), \"captured file\\n\");\n    git(\"add\", \"a\");\n    git(\"commit\", \"-qm\", \"track checkpoint file target\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"untracked child replacement\");\n    fs.rmSync(path.join(repo, \"a\"));\n    fs.mkdirSync(path.join(repo, \"a\"));\n    fs.writeFileSync(path.join(repo, \"a\", \"child.txt\"), \"ordinary untracked child\\n\");\n    assert.equal(git(\"clean\", \"-nd\", \"--\", \"a\").trim(), \"\", \"Git omits untracked children from the preview when the target path remains tracked\");\n    const headBefore = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"a\"), \"utf8\"), \"captured file\\n\");\n    assert.equal(fs.existsSync(path.join(repo, \"a\", \"child.txt\")), false);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy Git restore removes staged and committed tracked additions made after the checkpoint\", () => {\n  for (const committed of [false, true]) {\n    const { repo, git } = gitRepo();\n    try {\n      const manager = new CheckpointManager(repo);\n      const checkpoint = manager.createCheckpoint(`legacy post-checkpoint addition ${committed ? \"committed\" : \"staged\"}`);\n      const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n      const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n      delete record.untrackedFiles;\n      delete record.untrackedFileModes;\n      fs.writeFileSync(recordPath, JSON.stringify(record));\n      fs.writeFileSync(path.join(repo, \"added-after-checkpoint.txt\"), \"remove on restore\\n\");\n      git(\"add\", \"added-after-checkpoint.txt\");\n      if (committed) git(\"commit\", \"-qm\", \"post-checkpoint addition\");\n      const head = git(\"rev-parse\", \"HEAD\");\n\n      const result = manager.restore(checkpoint.id);\n\n      assert.equal(result.success, true, result.message);\n      assert.equal(fs.existsSync(path.join(repo, \"added-after-checkpoint.txt\")), false);\n      assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    } finally {\n      cleanupGitRepo(repo);\n    }\n  }\n});\n\ntest(\"non-Git restore removes post-checkpoint entries and preserves ignored paths\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-files-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"at checkpoint\\n\");\n    const checkpoint = manager.createCheckpoint(\"exact non-Git restore\");\n    fs.writeFileSync(path.join(workspace, \"b.txt\"), \"created later\\n\");\n    fs.mkdirSync(path.join(workspace, \"node_modules\"));\n    fs.writeFileSync(path.join(workspace, \"node_modules\", \"keep.txt\"), \"ignored\\n\");\n    const result = manager.restore(checkpoint.id);\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.existsSync(path.join(workspace, \"b.txt\")), false);\n  try {\n    fs.writeFileSync(path.join(workspace, \"captured.txt\"), \"captured\\n\");\n    const checkpoint = manager.createCheckpoint(\"legacy empty directory destination\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    delete record.untrackedFileModes;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    fs.mkdirSync(path.join(checkpoint.snapshotDir!, \"alias\", \"newdir\"), { recursive: true });\n    fs.symlinkSync(external, path.join(workspace, \"alias\"));\n    fs.writeFileSync(path.join(workspace, \"workspace.txt\"), \"workspace canary\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe/i);\n    assert.equal(fs.existsSync(path.join(external, \"newdir\")), false);\n    assert.equal(fs.readFileSync(path.join(workspace, \"workspace.txt\"), \"utf8\"), \"workspace canary\\n\");\n    assert.equal(fs.readlinkSync(path.join(workspace, \"alias\")), external);\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n    fs.rmSync(external, { recursive: true, force: true });\n  }\n});\n\ntest(\"legacy Git restore refuses an ignored untracked checkout collision\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy ignored checkout collision\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    delete record.untrackedFileModes;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    git(\"rm\", \"--cached\", \"-q\", \"tracked.txt\");\n    fs.writeFileSync(path.join(repo, \".gitignore\"), \"/tracked.txt\\n\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"ignored untracked canary\\n\");\n    assert.equal(git(\"check-ignore\", \"tracked.txt\"), \"tracked.txt\");\n    const head = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked|collision/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"ignored untracked canary\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy Git restore refuses an ignored untracked tracked-deletion collision\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"deleted.txt\"), \"base\\n\");\n    git(\"add\", \"deleted.txt\");\n    git(\"commit\", \"-qm\", \"add deleted file\");\n    fs.rmSync(path.join(repo, \"deleted.txt\"));\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy ignored deletion collision\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    delete record.untrackedFileModes;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    git(\"rm\", \"--cached\", \"-q\", \"deleted.txt\");\n    fs.writeFileSync(path.join(repo, \".gitignore\"), \"/deleted.txt\\n\");\n    fs.writeFileSync(path.join(repo, \"deleted.txt\"), \"ignored untracked canary\\n\");\n    assert.equal(git(\"check-ignore\", \"deleted.txt\"), \"deleted.txt\");\n    const head = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked|collision/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"deleted.txt\"), \"utf8\"), \"ignored untracked canary\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"non-Git restore preserves a pre-checkpoint FIFO\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-fifo-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"captured\\n\");\n    const fifo = path.join(workspace, \"pre-existing.fifo\");\n    execFileSync(\"mkfifo\", [fifo]);\n    const checkpoint = manager.createCheckpoint(\"preserve FIFO\");\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"changed later\\n\");\n\n    const result = manager.restore(checkpoint.id);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18336-b174-72a1-9e58-590be19b8235","create_time":1793209980.482891}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
