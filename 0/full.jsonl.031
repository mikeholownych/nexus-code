{"timestamp":"2026-10-28T16:41:16.153Z","ordinal":455138,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18363-2878-7b81-8fa1-30d561a8a27c","call_id":"call_bd347e82803a4ff5aa70534b275c7715","output":[{"type":"input_text","text":"Script completed\nWall time 2.4 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 5176)\nTotal output lines: 280\n\n{\n  \"name\": \"local-code-harness\",\n  \"version\": \"1.0.0-rc.10\",\n  \"type\": \"module\",\n  \"description\": \"Autonomous local AI coding harness (Codex / Claude-Code style) for LM Studio and vLLM\",\n  \"main\": \"dist/index.js\",\n  \"bin\": {\n    \"harness\": \"./dist/index.js\"\n  },\n  \"scripts\": {\n    \"build\": \"tsc && node scripts/write_build_info.mjs\",\n    \"test\": \"node scripts/run_tests.mjs && bash ../scripts/terminal-acceptance/test-scope-procs.sh\",\n    \"start\": \"node dist/index.js\",\n    \"dev\": \"tsx watch src/index.ts\"\n  },\n  \"keywords\": [\n    \"ai\",\n    \"coding-agent\",\n    \"codex\",\n    \"claude-code\",\n    \"vllm\",\n    \"lm-studio\",\n    \"rust\"\n  ],\n  \"author\": \"\",\n  \"license\": \"MIT\",\n  \"engines\": {\n    \"node\": \">=22\"\n  },\n  \"dependencies\": {\n    \"commander\": \"^12.1.0\",\n    \"dotenv\": \"^16.4.5\",\n    \"ora\": \"^8.1.0\",\n    \"picocolors\": \"^1.1.1\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^22.5.0\",\n    \"tsx\": \"^4.19.0\",\n    \"typescript\": \"^5.5.4\"\n  }\n}\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { execFileSync } from \"node:child_process\";\nimport { CheckpointManager } from \"../src/checkpoint.js\";\nimport { SensitivePersistenceError } from \"../src/core/persistence_protection.js\";\n\nlet previousHome: string | undefined;\nlet isolatedHome: string;\n\ntest.beforeEach(() => {\n  previousHome = process.env.HOME;\n  isolatedHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-home-\"));\n  process.env.HOME = isolatedHome;\n});\n\ntest.afterEach(() => {\n  if (previousHome === undefined) delete process.env.HOME;\n  else process.env.HOME = previousHome;\n  fs.rmSync(isolatedHome, { recursive: true, force: true });\n});\n\nfunction gitRepo(): { repo: string; git: (...args: string[]) => string } {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-\"));\n  const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: repo, encoding: \"utf8\" }).trim();\n  git(\"init\", \"-q\");\n  git(\"config\", \"user.email\", \"test@example.invalid\");\n  git(\"config\", \"user.name\", \"Test\");\n  fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"base\\n\");\n  git(\"add\", \"tracked.txt\");\n  git(\"commit\", \"-qm\", \"base\");\n  return { repo, git };\n}\n\nfunction cleanupGitRepo(repo: string): void {\n  const checkpointKey = createHash(\"sha256\").update(path.resolve(repo)).digest(\"hex\").slice(0, 12);\n  fs.rmSync(path.join(os.homedir(), \".nexus\", \"checkpoints\", checkpointKey), { recursive: true, force: true });\n  fs.rmSync(repo, { recursive: true, force: true });\n}\n\ntest(\"Git restore preserves untracked work and HEAD while removing post-checkpoint files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"pre-existing user work\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"preserve work\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"after checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"created-later.txt\"), \"remove me\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"at checkpoint\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"pre-existing user work\\n\");\n    assert.equal(fs.existsSync(path.join(repo, \"created-later.txt\")), false);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git checkpoint refuses sensitive untracked content before writing a ref\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), `ghp_${\"H\".repeat(36)}\\n`);\n    const manager = new CheckpointManager(repo);\n\n    assert.throws(() => manager.createCheckpoint(\"protected\"), SensitivePersistenceError);\n    assert.equal(manager.listCheckpoints().length, 0);\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\n  private assertNoNestedGitRepositoryAncestors(\n    relativePaths: string[],\n    targetRoot: string,\n    allowExternalSymlinkAncestors = false,\n  ): void {\n    const root = fs.realpathSync(targetRoot);\n    const gitProbeEnv = { ...process.env };\n    for (const key of Object.keys(gitProbeEnv)) {\n      if (key.startsWith(\"GIT_\")) delete gitProbeEnv[key];\n    }\n    for (const relativePath of relativePaths) {\n      const destination = path.resolve(root, relativePath);\n      const relativeDestination = path.relative(root, destination);\n      if (!relativeDestination || relativeDestination === \"..\" || relativeDestination.startsWith(`..${path.sep}`) || path.isAbsolute(relativeDestination)) {\n        throw new Error(\"Checkpoint destination path escapes the workspace\");\n      }\n      const relativeParent = path.dirname(relativeDestination);\n      const parentComponents = relativeParent === \".\" ? [] : relativeParent.split(path.sep);\n      const destinationStat = fs.lstatSync(destination, { throwIfNoEntry: false });\n      // A directory at the exact destination can itself be a repository, for\n      // example when an untracked checkpoint file was replaced by a bare repo.\n      // Include that leaf only when it is currently a directory; ordinary file\n      // destinations still need only their parents checked.\n      const components = destinationStat?.isDirectory()\n        ? [...parentComponents, path.basename(relativeDestination)]\n        : parentComponents;\n      let parent = root;\n      for (const component of components) {\n        parent = path.join(parent, component);\n        const stat = fs.lstatSync(parent, { throwIfNoEntry: false });\n        if (!stat) break;\n        if (stat.isSymbolicLink()) {\n          if (allowExternalSymlinkAncestors) {\n            try {\n              const resolvedParent = fs.realpathSync(parent);\n              if (resolvedParent !== root && !resolvedParent.startsWith(root + path.sep)) break;\n            } catch {\n              // Deletion cleanup already skips dangling or inaccessible parents.\n              break;\n            }\n          }\n          throw new Error(\"Checkpoint destination parent is a symbolic link\");\n        }\n        if (!stat.isDirectory()) break;\n        const dotGit = fs.lstatSync(path.join(parent, \".git\"), { throwIfNoEntry: false });\n        const bareHead = fs.lstatSync(path.join(parent, \"HEAD\"), { throwIfNoEntry: false });\n        const bareConfigPath = path.join(parent, \"config\");\n        const bareConfig = fs.lstatSync(bareConfigPath, { throwIfNoEntry: false });\n        if (dotGit) {\n          throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n        }\n\n        // A bare repository root requires HEAD. The Git probe distinguishes a\n        // real repository from ordinary project folders named `objects`/`refs`.\n        const hasGitDirectoryMarkers = !!bareHead;\n        if (hasGitDirectoryMarkers) {\n          try {\n            const discoveredGitDir = execFileSync(\"git\", [\"-C\", parent, \"rev-parse\", \"--absolute-git-dir\"], {\n              cwd: root,\n              encoding: \"utf8\",\n              env: gitProbeEnv,\n              maxBuffer: 1024 * 1024,\n              stdio: [\"ignore\", \"pipe\", \"ignore\"],\n            }).trim();\n            if (fs.realpathSync(discoveredGitDir) === fs.realpathSync(parent)) {\n              throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n            }\n          } catch (error) {\n            if (error instanceof Error && error.message === \"Checkpoint destination parent is a nested Git repository\") throw error;\n            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 128) {\n              throw new Error(\"Checkpoint could not verify ne…1176 tokens truncated…ke/nexus-wt/checkpoint-ordinary-child-fix/cli/test/inference_transport.test.ts:9:import { execFileSync, spawn, spawnSync } from \"node:child_process\";\n/home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/test/inference_transport.test.ts:280:const haveOpenssl = spawnSync(\"openssl\", [\"version\"]).status === 0;\n/home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/test/inference_transport.test.ts:339:    const child = spawn(process.execPath, [\"--import\", \"tsx\", \"--input-type=module\", \"-e\", script], {\n/home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/test/eval_t3.test.ts:10:import { spawn, spawnSync } from \"node:child_process\";\n/home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/test/eval_t3.test.ts:246:test(\"a T3 run drives the real sidecar through the sandbox: steering applied, probe answered and scored\", { timeout: 300_000 }, async () => {\n/home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/test/eval_t3.test.ts:288:    const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(out, \"results.jsonl\"), \"--js