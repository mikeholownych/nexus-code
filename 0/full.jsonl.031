{"timestamp":"2026-10-28T16:43:47.382Z","ordinal":455228,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","item":{"type":"CommandExecution","id":"exec-d8c5d22d-8b7c-4903-bf5f-04bffb8c38e3","process_id":"24738","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff -- cli/src/checkpoint.ts cli/test/checkpoint_restore.test.ts; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff --check; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff --stat; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix status --short"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff -- cli/src/checkpoint.ts cli/test/checkpoint_restore.test.ts; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff --check; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff --stat; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix status --short"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"diff --git a/cli/src/checkpoint.ts b/cli/src/checkpoint.ts\nindex 6253a055..08f6613d 100644\n--- a/cli/src/checkpoint.ts\n+++ b/cli/src/checkpoint.ts\n@@ -310,10 +310,6 @@ export class CheckpointManager {\n     allowExternalSymlinkAncestors = false,\n   ): void {\n     const root = fs.realpathSync(targetRoot);\n-    const gitProbeEnv = { ...process.env };\n-    for (const key of Object.keys(gitProbeEnv)) {\n-      if (key.startsWith(\"GIT_\")) delete gitProbeEnv[key];\n-    }\n     for (const relativePath of relativePaths) {\n       const destination = path.resolve(root, relativePath);\n       const relativeDestination = path.relative(root, destination);\n@@ -350,56 +346,21 @@ export class CheckpointManager {\n         if (!stat.isDirectory()) break;\n         const dotGit = fs.lstatSync(path.join(parent, \".git\"), { throwIfNoEntry: false });\n         const bareHead = fs.lstatSync(path.join(parent, \"HEAD\"), { throwIfNoEntry: false });\n-        const bareConfigPath = path.join(parent, \"config\");\n-        const bareConfig = fs.lstatSync(bareConfigPath, { throwIfNoEntry: false });\n+        const bareConfig = fs.lstatSync(path.join(parent, \"config\"), { throwIfNoEntry: false });\n+        const bareObjects = fs.lstatSync(path.join(parent, \"objects\"), { throwIfNoEntry: false });\n+        const bareRefs = fs.lstatSync(path.join(parent, \"refs\"), { throwIfNoEntry: false });\n         if (dotGit) {\n           throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n         }\n \n-        // A bare repository root requires HEAD. The Git probe distinguishes a\n-        // real repository from ordinary project folders named `objects`/`refs`.\n-        const hasGitDirectoryMarkers = !!bareHead;\n-        if (hasGitDirectoryMarkers) {\n-          try {\n-            const discoveredGitDir = execFileSync(\"git\", [\"-C\", parent, \"rev-parse\", \"--absolute-git-dir\"], {\n-              cwd: root,\n-              encoding: \"utf8\",\n-              env: gitProbeEnv,\n-              maxBuffer: 1024 * 1024,\n-              stdio: [\"ignore\", \"pipe\", \"ignore\"],\n-            }).trim();\n-            if (fs.realpathSync(discoveredGitDir) === fs.realpathSync(parent)) {\n-              throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n-            }\n-          } catch (error) {\n-            if (error instanceof Error && error.message === \"Checkpoint destination parent is a nested Git repository\") throw error;\n-            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 128) {\n-              throw new Error(\"Checkpoint could not verify nested Git repository state\");\n-            }\n-          }\n-        }\n-\n-        const bareConfigStat = bareConfig ? fs.statSync(bareConfigPath, { throwIfNoEntry: false }) : undefined;\n-        if (hasGitDirectoryMarkers && bareConfigStat?.isFile()) {\n-          if (bareConfigStat.size > 1024 * 1024) {\n-            throw new Error(\"Checkpoint destination has an oversized Git configuration\");\n-          }\n-          try {\n-            const configuredBare = execFileSync(\"git\", [\"config\", \"--file\", bareConfigPath, \"--includes\", \"--type=bool\", \"--get\", \"core.bare\"], {\n-              cwd: root,\n-              encoding: \"utf8\",\n-              env: gitProbeEnv,\n-              maxBuffer: 1024 * 1024,\n-              stdio: [\"ignore\", \"pipe\", \"ignore\"],\n-            }).trim();\n-            if (configuredBare === \"true\") {\n-              throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n-            }\n-          } catch (error) {\n-            const status = (error as NodeJS.ErrnoException & { status?: number })?.status;\n-            if (error instanceof Error && error.message === \"Checkpoint destination parent is a nested Git repository\") throw error;\n-            if (status !== 1) throw new Error(\"Checkpoint destination has an invalid Git configuration\");\n-          }\n+        // A bare repository (including an incomplete one) has a HEAD marker\n+        // alongside its config or object/ref storage. Treat that combination\n+        // as protected without asking Git to inspect the untrusted directory:\n+        // Git config can include external files, and opening a FIFO config or\n+        // include could block checkpoint restore indefinitely. Ordinary source\n+        // directories named `objects` and `refs` remain valid without HEAD.\n+        if (bareHead && (bareConfig || bareObjects || bareRefs)) {\n+          throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n         }\n       }\n     }\ndiff --git a/cli/test/checkpoint_restore.test.ts b/cli/test/checkpoint_restore.test.ts\nindex 180c6493..a30c2ed8 100644\n--- a/cli/test/checkpoint_restore.test.ts\n+++ b/cli/test/checkpoint_restore.test.ts\n@@ -4,7 +4,7 @@ import fs from \"node:fs\";\n import os from \"node:os\";\n import path from \"node:path\";\n import { createHash } from \"node:crypto\";\n-import { execFileSync } from \"node:child_process\";\n+import { execFileSync, spawnSync } from \"node:child_process\";\n import { CheckpointManager } from \"../src/checkpoint.js\";\n import { SensitivePersistenceError } from \"../src/core/persistence_protection.js\";\n \n@@ -1237,6 +1237,52 @@ test(\"Git manifest restore refuses to copy an untracked file into a nested bare\n   }\n });\n \n+test(\"Git restore rejects nested bare repository config FIFOs and external FIFO includes without hanging\", () => {\n+  const { repo } = gitRepo();\n+  const bareRepo = path.join(repo, \"nested-bare\");\n+  const externalInclude = path.join(repo, \"external-config.fifo\");\n+  try {\n+    fs.mkdirSync(bareRepo);\n+    fs.writeFileSync(path.join(bareRepo, \"captured.txt\"), \"checkpoint content\\n\");\n+    const manager = new CheckpointManager(repo);\n+    const checkpoint = manager.createCheckpoint(\"nested bare repository with blocking config paths\");\n+\n+    fs.rmSync(path.join(bareRepo, \"captured.txt\"));\n+    execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", bareRepo]);\n+    execFileSync(\"mkfifo\", [externalInclude]);\n+\n+    const runRestoreWithDeadline = () => spawnSync(process.execPath, [\n+      \"--import\", \"tsx\", \"--input-type=module\", \"--eval\",\n+      \"import { CheckpointManager } from './src/checkpoint.ts'; const result = new CheckpointManager(process.argv[1]).restore(process.argv[2]); if (result.success) process.exitCode = 1; else console.log(result.message);\",\n+      \"--\", repo, checkpoint.id,\n+    ], {\n+      cwd: path.resolve(\".\"),\n+      encoding: \"utf8\",\n+      env: { ...process.env, HOME: isolatedHome },\n+      timeout: 3_000,\n+    });\n+\n+    fs.rmSync(path.join(bareRepo, \"config\"));\n+    execFileSync(\"mkfifo\", [path.join(bareRepo, \"config\")]);\n+    const fifoConfigResult = runRestoreWithDeadline();\n+    assert.equal(fifoConfigResult.error, undefined, `restore must not block on a FIFO config: ${fifoConfigResult.error?.message}`);\n+    assert.equal(fifoConfigResult.status, 0, fifoConfigResult.stderr);\n+    assert.match(fifoConfigResult.stdout, /nested Git repository/i);\n+\n+    fs.rmSync(path.join(bareRepo, \"config\"));\n+    fs.writeFileSync(path.join(bareRepo, \"config\"), `[include]\\n\\tpath = ${externalInclude}\\n`);\n+    const externalIncludeResult = runRestoreWithDeadline();\n+    assert.equal(externalIncludeResult.error, undefined, `restore must not follow an external FIFO include: ${externalIncludeResult.error?.message}`);\n+    assert.equal(externalIncludeResult.status, 0, externalIncludeResult.stderr);\n+    assert.match(externalIncludeResult.stdout, /nested Git repository/i);\n+\n+    assert.equal(fs.existsSync(path.join(bareRepo, \"captured.txt\")), false, \"rejected restores must not write checkpoint content into the nested repository\");\n+    assert.equal(fs.lstatSync(externalInclude).isFIFO(), true, \"the external include target remains untouched\");\n+  } finally {\n+    cleanupGitRepo(repo);\n+  }\n+});\n+\n for (const coreBare of [\"false\", \"unset\"] as const) {\n   test(`Git manifest restore refuses an exact nested Git directory with core.bare=${coreBare}`, () => {\n     const { repo, git } = gitRepo();\n cli/src/checkpoint.ts               | 61 +++++++------------------------------\n cli/test/checkpoint_restore.test.ts | 48 ++++++++++++++++++++++++++++-\n 2 files changed, 58 insertions(+), 51 deletions(-)\n M cli/src/checkpoint.ts\n M cli/test/checkpoint_restore.test.ts\n","exit_code":0,"duration":{"secs":0,"nanos":27901}},"started_at_ms":1793205827381,"completed_at_ms":1793205827382}}
