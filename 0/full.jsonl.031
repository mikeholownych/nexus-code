pshot /var/tmp/nexus-pr302-validation-finalfocus-174628; process live in same host/boot namespace. Current log contains one failing build-identity test and fatal git-not-a-repository. Read-only check confirms snapshot has no .git and git rev-parse fails. Classify this result as snapshot-environment invalid for the build-identity assertion, not source regression; preserve run output and rerun full suite on an immutable git worktree snapshot after current run and claim handoff, without changing expectations.\n5515:2026-10-28T18:14:00Z SUITE_RELEASE codex-root head=1482d6b315129cd46fac61242c2eb91793ed8fd2 outcome=INVALID_ENVIRONMENT make_test_exit=2 tests=1985 pass=1923 fail=58 skipped=4 snapshot=/var/tmp/nexus-pr302-validation-finalfocus-174628 lacked .git, cli/dist/index.js, and core/target/release/nexus-tui; build_identity failed with not-a-git-repository; many package/TUI/eval tests failed from missing build artifacts. No source fix or candidate change inferred. Full log retained at /var/tmp/nexus-pr302-validation-finalfocus/make_test.log. Owner process exited; SUITE claim released. Next run must use immutable git worktree plus make build before make test.\n5516:2026-10-28T18:24:30Z RELEASE SUITE by codex-root: full make test completed on /var/tmp/nexus-pr302-validation-finalfocus-174628 (archive-style, no .git; not source-exact qualification); 1985 tests, 1923 pass, 58 fail. Claim released; candidate-specific validation remains queued on a real Git worktree snapshot.\n5517:2026-10-28T18:25:00Z CORRECTION codex-root: The 18:24:30Z SUITE release line duplicated and misstated the terminal result already recorded at 18:14:00Z. Authoritative record is INVALID_ENVIRONMENT, make test exit=2, 1985 tests: 1923 pass, 58 fail, 4 skipped; archive snapshot lacked .git, cli/dist/index.js, and core/target/release/nexus-tui. No source conclusion. SUITE was already released.\n  const alias = path.join(repo, \"alias\");\n  const data = path.join(repo, \"data\");\n  fs.mkdirSync(alias);\n  fs.writeFileSync(path.join(alias, \"file\"), \"tracked alias file\\n\");\n  fs.mkdirSync(data);\n  fs.writeFileSync(path.join(data, \"file\"), \"ignored data must survive\\n\");\n  fs.writeFileSync(path.join(repo, \".gitignore\"), \"data/\\n\");\n  git(\"add\", \"alias/file\", \".gitignore\");\n  git(\"commit\", \"-qm\", \"tracked alias and ignored data\");\n  const manager = new CheckpointManager(repo);\n  try {\n    fs.rmSync(path.join(alias, \"file\"));\n    fs.rmdirSync(alias);\n    fs.symlinkSync(\"data\", alias);\n    git(\"add\", \"-A\", \"alias\");\n    assert.throws(() => manager.createCheckpoint(\"symlink replacement deletion\"), /could not verify protected Git state/);\n\n    assert.equal(manager.listCheckpoints().length, 0);\n    assert.equal(fs.lstatSync(alias).isSymbolicLink(), true);\n    assert.equal(fs.readFileSync(path.join(data, \"file\"), \"utf8\"), \"ignored data must survive\\n\");\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"checkpoint refuses the symlink snapshot fallback when Git hides worktree paths\", () => {\n  for (const indexFlag of [\"--assume-unchanged\", \"--skip-worktree\"]) {\n    const { repo, git } = gitRepo();\n    const alias = path.join(repo, \"alias\");\n    fs.mkdirSync(alias);\n    fs.writeFileSync(path.join(alias, \"file\"), \"tracked alias file\\n\");\n    fs.mkdirSync(path.join(repo, \"data\"));\n    fs.writeFileSync(path.join(repo, \"data\", \"file\"), \"external target\\n\");\n    git(\"add\", \"alias/file\");\n    git(\"commit\", \"-qm\", \"tracked directory for hidden worktree flag\");\n    const manager = new CheckpointManager(repo);\n    try {\n      fs.rmSync(path.join(alias, \"file\"));\n      fs.rmdirSync(alias);\n      fs.symlinkSync(\"data\", alias);\n      git(\"add\", \"-A\", \"alias\");\n      git(\"update-index\", indexFlag, \"alias\");\n\n      assert.throws(\n        () => manager.createCheckpoint(`hidden worktree path ${indexFlag}`),\n        /could not verify protected Git state/,\n      );\n      assert.equal(manager.listCheckpoints().length, 0);\n      assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n    } finally {\n      cleanupGitRepo(repo);\n    }\n  }\n});\n\ntest(\"manifest restore refuses a regular-file parent before changing tracked or untracked files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.mkdirSync(path.join(repo, \"a\"));\n    fs.writeFileSync(path.join(repo, \"a\", \"b\"), \"captured\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"file parent collision\");\n    fs.rmSync(path.join(repo, \"a\"), { recursive: true });\n    fs.writeFileSync(path.join(repo, \"a\"), \"tracked canary\\n\");\n    git(\"add\", \"a\");\n    git(\"commit\", \"-qm\", \"replace directory with tracked file\");\n    fs.writeFileSync(path.join(repo, \"untracked.txt\"), \"untracked canary\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"a\"), \"utf8\"), \"tracked canary\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"untracked.txt\"), \"utf8\"), \"untracked canary\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"base\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy Git restore refuses an untracked checkout collision before overwriting it\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy checkout collision\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    delete record.untrackedFileModes;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    git(\"rm\", \"--cached\", \"-q\", \"tracked.txt\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"untracked canary\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked|collision/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"untracked canary\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n    const checkpoint = manager.createCheckpoint(\"committed ignored addition protection\");\n    fs.writeFileSync(path.join(repo, \"later.cfg\"), \"operator data\\n\");\n    git(\"add\", \"later.cfg\");\n    git(\"commit\", \"-qm\", \"add later data\");\n    fs.writeFileSync(path.join(repo, \".gitignore\"), \"/later.cfg\\n\");\n    git(\"add\", \".gitignore\");\n    git(\"commit\", \"-qm\", \"protect later data from cleanup\");\n    const headBefore = git(\"rev-parse\", \"HEAD\");\n    assert.equal(git(\"check-ignore\", \"--no-index\", \"later.cfg\"), \"later.cfg\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /ignored|collision/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"later.cfg\"), \"utf8\"), \"operator data\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \".gitignore\"), \"utf8\"), \"/later.cfg\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"non-Git restore removes post-checkpoint entries and preserves ignored paths\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-files-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"at checkpoint\\n\");\n    const checkpoint = manager.createCheckpoint(\"exact non-Git restore\");\n    fs.writeFileSync(path.join(workspace, \"b.txt\"), \"created later\\n\");\n    fs.mkdirSync(path.join(workspace, \"node_modules\"));\n    fs.writeFileSync(path.join(workspace, \"node_modules\", \"keep.txt\"), \"ignored\\n\");\n    const result = manager.restore(checkpoint.id);\n    assert.equal(result.success, true, result.message);\n","exit_code":0,"duration":{"secs":1,"nanos":182285480}},"started_at_ms":1793212010534,"completed_at_ms":1793212011717}}
