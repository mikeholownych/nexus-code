t(\\\" \\\")[1];\\n@@ -738,11 +820,11 @@ export class CheckpointManager {\\n   }\\n \\n   private gitTrackedDescendantPaths(relativePath: string): string[] {\\n-    return execFileSync(\\\"git\\\", [\\\"-c\\\", \\\"core.fsmonitor=false\\\", \\\"ls-files\\\", \\\"--cached\\\", \\\"-z\\\", \\\"--\\\", relativePath], {\\n+    return gitNulEntries(execFileSync(\\\"git\\\", [\\\"-c\\\", \\\"core.fsmonitor=false\\\", \\\"ls-files\\\", \\\"--cached\\\", \\\"-z\\\", \\\"--\\\", relativePath], {\\n       cwd: this.workspace,\\n       encoding: \\\"buffer\\\",\\n       maxBuffer: 64 * 1024 * 1024,\\n-    }).toString(\\\"utf8\\\").split(\\\"\\\\0\\\").filter((entry) => entry.startsWith(`${relativePath}/`));\\n+    })).map((entry) => entry.toString(\\\"utf8\\\")).filter((entry) => entry.startsWith(`${relativePath}/`));\\n   }\\n \\n   private directoryContainsOnlyTrackedRemovableEntries(relativePath: string): boolean {\\n@@ -824,6 +906,7 @@ export class CheckpointManager {\\n     let gitRef: string | undefined;\\n     let snapshotDir: string | undefined;\\n     let untrackedPaths: string[] = [];\\n+    let untrackedFileModes: Record<string, number> = {};\\n \\n     if (this.isGit) {\\n       try {\\n@@ -831,6 +914,7 @@ export class CheckpointManager {\\n         this.assertGitChangesSafe(allowSensitive);\\n         untrackedPaths = this.gitUntrackedPaths();\\n         this.assertUntrackedEntriesSafe(untrackedPaths, this.workspace, allowSensitive);\\n+        untrackedFileModes = this.captureUntrackedFileModes(untrackedPaths, this.workspace);\\n         // Create an untracked + tracked git stash commit without modifying working tree\\n         // Clean/smudge filter drivers (filter.* selected through .gitattributes) can still run external\\n         // programs here and during restore; Git offers no single override for them, and refusing to\\n@@ -881,6 +965,7 @@ export class CheckpointManager {\\n         } else {\\n           untrackedPaths = this.workspaceSnapshotPaths(this.workspace);\\n           this.assertUntrackedEntriesSafe(untrackedPaths, this.workspace, allowSensitive);\\n+          untrackedFileModes = this.captureUntrackedFileModes(untrackedPaths, this.workspace);\\n           this.copyUntrackedEntries(untrackedPaths, this.workspace, snapTarget, allowSensitive);\\n         }\\n         snapshotDir = snapTarget;\\n@@ -901,7 +986,7 @@ export class CheckpointManager {\\n       gitRef,\\n       snapshotDir,\\n       ...(allowSensitive ? { allowSensitive: true } : {}),\\n-      ...(this.isGit || snapshotDir ? { untrackedFiles: untrackedPaths } : {}),\\n+      ...(this.isGit || snapshotDir ? { untrackedFiles: untrackedPaths, untrackedFileModes } : {}),\\n     };\\n \\n     const targetFile = path.join(this.checkpointDir, `${id}.json`);\\n@@ -962,6 +1047,15 @@ export class CheckpointManager {\\n       )) return null;\\n       checkpoint.untrackedFiles = [...new Set<string>(raw.untrackedFiles)];\\n     }\\n+    if (raw.untrackedFileModes !== undefined) {\\n+      if (!raw.untrackedFileModes || typeof raw.untrackedFileModes !== \\\"object\\\" || Array.isArray(raw.untrackedFileModes)) return null;\\n+      const modes: Record<string, number> = Object.create(null);\\n+      for (const [filePath, mode] of Object.entries(raw.untrackedFileModes)) {\\n+        if (!checkpoint.untrackedFiles?.includes(filePath) || !Number.isInteger(mode) || (mode as number) < 0 || (mode as number) > 0o777) return null;\\n+        modes[filePath] = mode as number;\\n+      }\\n+      checkpoint.untrackedFileModes = modes;\\n+    }\\n     if (Array.isArray(raw.files)) checkpoint.files = raw.files;\\n     return checkpoint;\\n   }\\n@@ -1123,7 +1217,8 @@ export class CheckpointManager {\\n     try {\\n       if (this.isGit && cp.gitRef) {\\n         const hookGuardEnv = envWithoutConfiguredHooks(this.workspace, [\\\"reference-transaction\\\", \\\"post-index-change\\\"]);\\n-        const postCheckpointAdditions = cp.untrackedFiles === undefined ? this.trackedPathsAddedSince(cp.gitRef) : [];\\n+        const postCheckpointAdditions = this.trackedPathsAddedSince(cp.gitRef);\\n+        this.assertNoIgnoredAddedPaths(postCheckpointAdditions);\\n         const deletedPaths = this.gitRefDeletedPaths(cp.gitRef);\\n         const checkoutPaths = this.gitRefBlobPaths(cp.gitRef);\\n         const writePaths = [...new Set([...checkoutPaths, ...(cp.untrackedFiles ?? [])])];\\n@@ -1150,6 +1245,7 @@ export class CheckpointManager {\\n           this.assertGitSnapshotTargetsReplaceable(replacementTargets, cp.gitRef);\\n         }\\n         if (cp.untrackedFiles === undefined) this.assertLegacyUntrackedRestoreSafe(cp.gitRef);\\n+        this.assertNoActiveGitOperation();\\n         this.restoreGitIndex(cp.gitRef, hookGuardEnv);\\n         // Remove checkpoint-deleted paths while their current ancestors are still\\n         // present. Installing checkpoint symlinks first could redirect deletion\\n@@ -1170,7 +1266,7 @@ export class CheckpointManager {\\n         if (cp.untrackedFiles !== undefined) {\\n           execFileSync(\\\"git\\\", [\\\"-c\\\", \\\"core.hooksPath=/dev/null\\\", \\\"-c\\\", \\\"core.fsmonitor=false\\\", \\\"clean\\\", \\\"-fd\\\"], { cwd: this.workspace, stdio: \\\"ignore\\\", env: hookGuardEnv });\\n           if (cp.untrackedFiles.length > 0) {\\n-            this.copyUntrackedEntries(cp.untrackedFiles, cp.snapshotDir!, this.workspace, cp.allowSensitive === true);\\n+            this.copyUntrackedEntries(cp.untrackedFiles, cp.snapshotDir!, this.workspace, cp.allowSensitive === true, cp.untrackedFileModes);\\n           }\\n           return { success: true, message: `Restored workspace to checkpoint '${cp.name}' (${cp.id})` };\\n         }\\n@@ -1186,7 +1282,7 @@ export class CheckpointManager {\\n           return { success: false, message: `Rollback failed: checkpoint '${cp.id}' has an incomplete or unsafe snapshot or destination; workspace was not changed` };\\n         }\\n         this.removeNonSnapshotEntries(cp.untrackedFiles);\\n-        this.copyUntrackedEntries(cp.untrackedFiles, cp.snapshotDir, this.workspace, cp.allowSensitive === true);\\n+        this.copyUntrackedEntries(cp.untrackedFiles, cp.snapshotDir, this.workspace, cp.allowSensitive === true, cp.untrackedFileModes);\\n         return { success: true, message: `Restored workspace files from snapshot '${cp.name}' (${cp.id})` };\\n       }\\n \\ndiff --git a/cli/test/checkpoint_restore.test.ts b/cli/test/checkpoint_restore.test.ts\\nindex a30c2ed8..ce73835d 100644\\n--- a/cli/test/checkpoint_restore.test.ts\\n+++ b/cli/test/checkpoint_restore.test.ts\\n@@ -64,6 +64,144 @@ test(\\\"Git restore preserves untracked work and HEAD while removing post-checkpoi\\n   }\\n });\\n \\n+test(\\\"Git restore preserves executable permissions on captured untracked files\\\", () => {\\n+  const { repo } = gitRepo();\\n+  try {\\n+    const tool = path.join(repo, \\\"tool.sh\\\");\\n+    fs.writeFileSync(tool, \\\"#!/bin/sh\\\\nexit 0\\\\n\\\", { mode: 0o751 });\\n+    fs.chmodSync(tool, 0o751);\\n+    const manager = new CheckpointManager(repo);\\n+    const checkpoint = manager.createCheckpoint(\\\"untracked executable\\\");\\n+    fs.chmodSync(tool, 0o600);\\n+\\n+    const result = manager.restore(checkpoint.id);\\n+\\n+    assert.equal(result.success, true, result.message);\\n+    assert.equal(fs.statSync(tool).mode & 0o777, 0o751);\\n+  } finally {\\n+    cleanupGitRepo(repo);\\n+  }\\n+});\\n+\\n+test(\\\"Git restore refuses to mutate while merge metadata is present\\\", () => {\\n+  const { repo, git } = gitRepo();\\n+  try {\\n+    fs.writeFileSync(path.join(repo, \\\"tracked.txt\\\"), \\\"checkpoint state\\\\n\\\");\\n+    const manager = new CheckpointManager(repo);\\n+    const checkpoint = manager.createCheckpoint(\\\"before resolved merge commit\\\");\\n+    fs.writeFileSync(path.join(repo, \\\"tracked.txt\\\"), \\\"current state\\\\n\\\");\\n+    const indexBefore = execFileSync(\\\"git\\\", [\\\"ls-files\\\", \\\"--stage\\\", \\\"-z\\\"], { cwd: repo, encoding: \\\"buffer\\\" }).toString(\\\"hex\\\");\\n+    const mergeHead = git(\\\"rev-parse\\\", \\\"HEAD\\\");\\n+    fs.writeFileSync(path.join(repo, \\\".git\\\", \\\"MERGE_HEAD\\\"), `${mergeHead}\\\\n\\\");\\n+\\n+    const result = manager.restore(checkpoint.id);\\n+\\n+    assert.equal(result.success, false);\\n+    assert.match(result.message, /Git operation state/i);\\n+    assert.equal(fs.readFileSync(path.join(repo, \\\"tracked.txt\\\"), \\\"utf8\\\"), \\\"current state\\\\n\\\");\\n+    assert.equal(execFileSync(\\\"git\\\", [\\\"ls-files\\\", \\\"--stage\\\", \\\"-z\\\"], { cwd: repo, encoding: \\\"buffer\\\" }).toString(\\\"hex\\\"), indexBefore);\\n+    assert.equal(fs.readFileSync(path.join(repo, \\\".git\\\", \\\"MERGE_HEAD\\\"), \\\"utf8\\\"), `${mergeHead}\\\\n`);\\n+  } finally {\\n+    cleanupGitRepo(repo);\\n+  }\\n+});\\n+\\n+test(\\\"checkpoint creation fails closed for non-UTF-8 Git paths before publishing a ref\\\", { skip: process.platform === \\\"win32\\\" }, () => {\\n+  const { repo, git } = gitRepo();\\n+  try {\\n+    const invalidName = Buffer.concat([Buffer.from(`${repo}/invalid-`), Buffer.from([0xff])]);\\n+    fs.writeFileSync(invalidName, \\\"must not be misaddressed\\\\n\\\");\\n+    git(\\\"add\\\", \\\"--all\\\");\\n+    const manager = new CheckpointManager(repo);\\n+\\n+    assert.throws(() => manager.createCheckpoint(\\\"non UTF-8 path\\\"), /not valid UTF-8/i);\\n+    assert.equal(git(\\\"for-each-ref\\\", \\\"--format=%(refname)\\\", \\\"refs/nexus/checkpoints\\\"), \\\"\\\");\\n+  } finally {\\n+    cleanupGitRepo(repo);\\n+  }\\n+});\\n+\\n+test(\\\"Git restore refuses an ignored staged addition before changing the index or workspace\\\", () => {\\n+  const { repo, git } = gitRepo();\\n+  try {\\n+    fs.writeFileSync(path.join(repo, \\\".gitignore\\\"), \\\"ignored.bin\\\\n\\\");\\n+    git(\\\"add\\\", \\\".gitignore\\\");\\n+    git(\\\"commit\\\", \\\"-qm\\\", \\\"ignore generated artifact\\\");\\n+    const manager = new CheckpointManager(repo);\\n+    const checkpoint = manager.createCheckpoint(\\\"before forced ignored addition\\\");\\n+    fs.writeFileSync(path.join(repo, \\\"ignored.bin\\\"), \\\"ignored staged payload\\\\n\\\");\\n+    git(\\\"add\\\", \\\"-f\\\", \\\"ignored.bin\\\");\\n+    const indexBefore = execFileSync(\\\"git\\\", [\\\"ls-files\\\", \\\"--stage\\\", \\\"-z\\\"], { cwd: repo, encoding: \\\"buffer\\\" }).toString(\\\"hex\\\");\\n+\\n+    const result = manager.restore(checkpoint.id);\\n+\\n+    assert.equal(result.success, false);\\n+    assert.match(result.message, /ignored by current Git rules/i);\\n+    assert.equal(fs.readFileSync(path.join(repo, \\\"ignored.bin\\\"), \\\"utf8\\\"), \\\"ignored staged payload\\\\n\\\");\\n+    assert.equal(execFileSync(\\\"git\\\", [\\\"ls-files\\\", \\\"--stage\\\", \\\"-z\\\"], { cwd: repo, encoding: \\\"buffer\\\" }).toString(\\\"hex\\\"), indexBefore);\\n+  } finally {\\n+    cleanupGitRepo(repo);\\n+  }\\n+});\\n+\\n+test(\\\"legacy Git restore removes a path renamed after the checkpoint\\\", () => {\\n+  const { repo, git } = gitRepo();\\n+  try {\\n+    fs.writeFileSync(path.join(repo, \\\"old.txt\\\"), \\\"checkpoint version\\\\n\\\");\\n+    git(\\\"add\\\", \\\"old.txt\\\");\\n+    git(\\\"commit\\\", \\\"-qm\\\", \\\"add legacy rename source\\\");\\n+    const manager = new CheckpointManager(repo);\\n+    const checkpoint = manager.createCheckpoint(\\\"before committed rename\\\");\\n+    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\\n+    const record = JSON.parse(fs.readFileSync(recordPath, \\\"utf8\\\"));\\n+    delete record.untrackedFiles;\\n+    delete record.untrackedFileModes;\\n\\nOWNER FILES\\n---/home/mike/nexus-code/.git/nexus-claims/FILE_cli_src_checkpoint.ts/owner.json\\n{\\n  \\\"agent\\\": \\\"codex-root\\\",\\n  \\\"host\\\": \\\"mike-dev\\\",\\n  \\\"branch\\\": \\\"v1/checkpoint-ordinary-child-fix\\\