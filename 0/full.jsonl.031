{"timestamp":"2026-10-28T17:56:07.902Z","ordinal":458505,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a18336-b174-72a1-9e58-590be19b8235","response_id":"resp_060b64278a9dfb15016ae23735cea881a0af107c26b6151ea0","usage":{"input_tokens":86654,"cached_input_tokens":85504,"cache_write_input_tokens":0,"output_tokens":112,"reasoning_output_tokens":19,"total_tokens":86766},"turn_token_usage":{"input_tokens":98410823,"cached_input_tokens":97122688,"cache_write_input_tokens":0,"output_tokens":365481,"reasoning_output_tokens":214057,"total_tokens":98776304},"thread_token_usage":{"input_tokens":8470167680,"cached_input_tokens":8379653504,"cache_write_input_tokens":0,"output_tokens":24137458,"reasoning_output_tokens":13924244,"total_tokens":8494305138}}}
{"timestamp":"2026-10-28T17:56:09.827Z","ordinal":458506,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","item":{"type":"CommandExecution","id":"exec-0e801fc5-a910-4f11-b024-aff1ba7768a0","process_id":"18333","command":["/usr/bin/zsh","-lc","sed -n '950,1010p' cli/test/checkpoint_restore.test.ts; sed -n '1,90p' cli/test/checkpoint_restore.test.ts"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"read","cmd":"sed -n '950,1010p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"},{"type":"read","cmd":"sed -n '1,90p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"  const { repo, git } = gitRepo();\n  const workspace = path.join(repo, \"sub\");\n  fs.mkdirSync(workspace);\n  fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"subdirectory base\\n\");\n  git(\"add\", \"tracked.txt\", \"sub/tracked.txt\");\n  git(\"commit\", \"-qm\", \"subdirectory restore base\");\n  const manager = new CheckpointManager(workspace);\n  try {\n    const checkpoint = manager.createCheckpoint(\"subdirectory scoped restore\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"sibling staged work\\n\");\n    git(\"add\", \"tracked.txt\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"sibling unstaged work\\n\");\n    fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"subdirectory later work\\n\");\n    git(\"add\", \"sub/tracked.txt\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"sibling unstaged work\\n\");\n    assert.equal(git(\"show\", \":tracked.txt\"), \"sibling staged work\");\n    assert.equal(fs.readFileSync(path.join(workspace, \"tracked.txt\"), \"utf8\"), \"subdirectory base\\n\");\n    assert.equal(git(\"show\", \":sub/tracked.txt\"), \"subdirectory base\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"checkpoint fails closed when a tracked deletion sits beneath a worktree symlink\", () => {\n  const { repo, git } = gitRepo();\n  const alias = path.join(repo, \"alias\");\n  const data = path.join(repo, \"data\");\n  fs.mkdirSync(alias);\n  fs.writeFileSync(path.join(alias, \"file\"), \"tracked alias file\\n\");\n  fs.mkdirSync(data);\n  fs.writeFileSync(path.join(data, \"file\"), \"ignored data must survive\\n\");\n  fs.writeFileSync(path.join(repo, \".gitignore\"), \"data/\\n\");\n  git(\"add\", \"alias/file\", \".gitignore\");\n  git(\"commit\", \"-qm\", \"tracked alias and ignored data\");\n  const manager = new CheckpointManager(repo);\n  try {\n    fs.rmSync(path.join(alias, \"file\"));\n    fs.rmdirSync(alias);\n    fs.symlinkSync(\"data\", alias);\n    git(\"add\", \"-A\", \"alias\");\n    assert.throws(() => manager.createCheckpoint(\"symlink replacement deletion\"), /could not verify protected Git state/);\n\n    assert.equal(manager.listCheckpoints().length, 0);\n    assert.equal(fs.lstatSync(alias).isSymbolicLink(), true);\n    assert.equal(fs.readFileSync(path.join(data, \"file\"), \"utf8\"), \"ignored data must survive\\n\");\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"manifest restore refuses a regular-file parent before changing tracked or untracked files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.mkdirSync(path.join(repo, \"a\"));\n    fs.writeFileSync(path.join(repo, \"a\", \"b\"), \"captured\\n\");\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { CheckpointManager } from \"../src/checkpoint.js\";\nimport { SensitivePersistenceError } from \"../src/core/persistence_protection.js\";\n\nlet previousHome: string | undefined;\nlet isolatedHome: string;\n\ntest.beforeEach(() => {\n  previousHome = process.env.HOME;\n  isolatedHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-home-\"));\n  process.env.HOME = isolatedHome;\n});\n\ntest.afterEach(() => {\n  if (previousHome === undefined) delete process.env.HOME;\n  else process.env.HOME = previousHome;\n  fs.rmSync(isolatedHome, { recursive: true, force: true });\n});\n\nfunction gitRepo(): { repo: string; git: (...args: string[]) => string } {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-\"));\n  const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: repo, encoding: \"utf8\" }).trim();\n  git(\"init\", \"-q\");\n  git(\"config\", \"user.email\", \"test@example.invalid\");\n  git(\"config\", \"user.name\", \"Test\");\n  fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"base\\n\");\n  git(\"add\", \"tracked.txt\");\n  git(\"commit\", \"-qm\", \"base\");\n  return { repo, git };\n}\n\nfunction cleanupGitRepo(repo: string): void {\n  const checkpointKey = createHash(\"sha256\").update(path.resolve(repo)).digest(\"hex\").slice(0, 12);\n  fs.rmSync(path.join(os.homedir(), \".nexus\", \"checkpoints\", checkpointKey), { recursive: true, force: true });\n  fs.rmSync(repo, { recursive: true, force: true });\n}\n\ntest(\"Git restore preserves untracked work and HEAD while removing post-checkpoint files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"pre-existing user work\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"preserve work\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"after checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"created-later.txt\"), \"remove me\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"at checkpoint\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"pre-existing user work\\n\");\n    assert.equal(fs.existsSync(path.join(repo, \"created-later.txt\")), false);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"checkpoint safety checks preserve a repository root ending in carriage return\", { skip: process.platform === \"win32\" }, () => {\n  const normalRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-cr-root-\"));\n  const repo = `${normalRoot}\\r`;\n  fs.renameSync(normalRoot, repo);\n  fs.mkdirSync(normalRoot);\n  const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: repo, encoding: \"utf8\" }).trim();\n  try {\n    git(\"init\", \"-q\");\n    git(\"config\", \"user.email\", \"test@example.invalid\");\n    git(\"config\", \"user.name\", \"Test\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"base\\n\");\n    git(\"add\", \"tracked.txt\");\n    git(\"commit\", \"-qm\", \"base\");\n\n    // Git writes the repository path followed by LF. Keep the CR that belongs\n    // to the path so the checkpoint examines this repository, not its sibling.\n    fs.writeFileSync(path.join(normalRoot, \"tracked.txt\"), \"safe sibling\\n\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), `ghp_${\"H\".repeat(36)}\\n`);\n    const manager = new CheckpointManager(repo);\n\n    assert.throws(() => manager.createCheckpoint(\"carriage-return repository root\"), SensitivePersistenceError);\n  } finally {\n    cleanupGitRepo(repo);\n    fs.rmSync(normalRoot, { recursive: true, force: true });\n","exit_code":0,"duration":{"secs":0,"nanos":810162075}},"started_at_ms":1793210169016,"completed_at_ms":1793210169827}}
{"timestamp":"2026-10-28T17:56:11.184Z","ordinal":458507,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a183a7-bf30-75f0-a0dc-6339545f1287","call_id":"call_00363ad7e4f14b47abb29d21f4f7b5a7","output":[{"type":"input_text","text":"Script completed\nWall time 3.4 seconds\nOutput:\n"},{"type":"input_text","text":"  const { repo, git } = gitRepo();\n  const workspace = path.join(repo, \"sub\");\n  fs.mkdirSync(workspace);\n  fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"subdirectory base\\n\");\n  git(\"add\", \"tracked.txt\", \"sub/tracked.txt\");\n  git(\"commit\", \"-qm\", \"subdirectory restore base\");\n  const manager = new CheckpointManager(workspace);\n  try {\n    const checkpoint = manager.createCheckpoint(\"subdirectory scoped restore\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"sibling staged work\\n\");\n    git(\"add\", \"tracked.txt\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"sibling unstaged work\\n\");\n    fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"subdirectory later work\\n\");\n    git(\"add\", \"sub/tracked.txt\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"sibling unstaged work\\n\");\n    assert.equal(git(\"show\", \":tracked.txt\"), \"sibling staged work\");\n    assert.equal(fs.readFileSync(path.join(workspace, \"tracked.txt\"), \"utf8\"), \"subdirectory base\\n\");\n    assert.equal(git(\"show\", \":sub/tracked.txt\"), \"subdirectory base\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"checkpoint fails closed when a tracked deletion sits beneath a worktree symlink\", () => {\n  const { repo, git } = gitRepo();\n  const alias = path.join(repo, \"alias\");\n  const data = path.join(repo, \"data\");\n  fs.mkdirSync(alias);\n  fs.writeFileSync(path.join(alias, \"file\"), \"tracked alias file\\n\");\n  fs.mkdirSync(data);\n  fs.writeFileSync(path.join(data, \"file\"), \"ignored data must survive\\n\");\n  fs.writeFileSync(path.join(repo, \".gitignore\"), \"data/\\n\");\n  git(\"add\", \"alias/file\", \".gitignore\");\n  git(\"commit\", \"-qm\", \"tracked alias and ignored data\");\n  const manager = new CheckpointManager(repo);\n  try {\n    fs.rmSync(path.join(alias, \"file\"));\n    fs.rmdirSync(alias);\n    fs.symlinkSync(\"data\", alias);\n    git(\"add\", \"-A\", \"alias\");\n    assert.throws(() => manager.createCheckpoint(\"symlink replacement deletion\"), /could not verify protected Git state/);\n\n    assert.equal(manager.listCheckpoints().length, 0);\n    assert.equal(fs.lstatSync(alias).isSymbolicLink(), true);\n    assert.equal(fs.readFileSync(path.join(data, \"file\"), \"utf8\"), \"ignored data must survive\\n\");\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"manifest restore refuses a regular-file parent before changing tracked or untracked files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.mkdirSync(path.join(repo, \"a\"));\n    fs.writeFileSync(path.join(repo, \"a\", \"b\"), \"captured\\n\");\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { CheckpointManager } from \"../src/checkpoint.js\";\nimport { SensitivePersistenceError } from \"../src/core/persistence_protection.js\";\n\nlet previousHome: string | undefined;\nlet isolatedHome: string;\n\ntest.beforeEach(() => {\n  previousHome = process.env.HOME;\n  isolatedHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-home-\"));\n  process.env.HOME = isolatedHome;\n});\n\ntest.afterEach(() => {\n  if (previousHome === undefined) delete process.env.HOME;\n  else process.env.HOME = previousHome;\n  fs.rmSync(isolatedHome, { recursive: true, force: true });\n});\n\nfunction gitRepo(): { repo: string; git: (...args: string[]) => string } {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-\"));\n  const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: repo, encoding: \"utf8\" }).trim();\n  git(\"init\", \"-q\");\n  git(\"config\", \"user.email\", \"test@example.invalid\");\n  git(\"config\", \"user.name\", \"Test\");\n  fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"base\\n\");\n  git(\"add\", \"tracked.txt\");\n  git(\"commit\", \"-qm\", \"base\");\n  return { repo, git };\n}\n\nfunction cleanupGitRepo(repo: string): void {\n  const checkpointKey = createHash(\"sha256\").update(path.resolve(repo)).digest(\"hex\").slice(0, 12);\n  fs.rmSync(path.join(os.homedir(), \".nexus\", \"checkpoints\", checkpointKey), { recursive: true, force: true });\n  fs.rmSync(repo, { recursive: true, force: true });\n}\n\ntest(\"Git restore preserves untracked work and HEAD while removing post-checkpoint files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"pre-existing user work\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"preserve work\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"after checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"created-later.txt\"), \"remove me\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"at checkpoint\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"pre-existing user work\\n\");\n    assert.equal(fs.existsSync(path.join(repo, \"created-later.txt\")), false);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"checkpoint safety checks preserve a repository root ending in carriage return\", { skip: process.platform === \"win32\" }, () => {\n  const normalRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-cr-root-\"));\n  const repo = `${normalRoot}\\r`;\n  fs.renameSync(normalRoot, repo);\n  fs.mkdirSync(normalRoot);\n  const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: repo, encoding: \"utf8\" }).trim();\n  try {\n    git(\"init\", \"-q\");\n    git(\"config\", \"user.email\", \"test@example.invalid\");\n    git(\"config\", \"user.name\", \"Test\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"base\\n\");\n    git(\"add\", \"tracked.txt\");\n    git(\"commit\", \"-qm\", \"base\");\n\n    // Git writes the repository path followed by LF. Keep the CR that belongs\n    // to the path so the checkpoint examines this repository, not its sibling.\n    fs.writeFileSync(path.join(normalRoot, \"tracked.txt\"), \"safe sibling\\n\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), `ghp_${\"H\".repeat(36)}\\n`);\n    const manager = new CheckpointManager(repo);\n\n    assert.throws(() => manager.createCheckpoint(\"carriage-return repository root\"), SensitivePersistenceError);\n  } finally {\n    cleanupGitRepo(repo);\n    fs.rmSync(normalRoot, { recursive: true, force: true });\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18336-b174-72a1-9e58-590be19b8235","create_time":1793210171.1847112}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
