":\"mike@holownych.com\",\"id\":\"MDQ6VXNlcjc3NTE3ODA=\",\"login\":\"mikeholownych\",\"name\":\"Mike Holownych\"}],\"committedDate\":\"2026-10-28T16:19:14Z\",\"messageBody\":\"\",\"messageHeadline\":\"docs(release): refresh readiness at current main\",\"oid\":\"a56432d7c6b00ee3a798023b887047052c5cba1a\"},{\"authoredDate\":\"2026-10-28T16:24:58Z\",\"authors\":[{\"email\":\"mike@holownych.com\",\"id\":\"MDQ6VXNlcjc3NTE3ODA=\",\"login\":\"mikeholownych\",\"name\":\"Mike Holownych\"}],\"committedDate\":\"2026-10-28T16:24:58Z\",\"messageBody\":\"\",\"messageHeadline\":\"docs(release): correct RC10 qualification scope\",\"oid\":\"dded46ba54001bd511aefce4719839f4b77c85ef\"},{\"authoredDate\":\"2026-10-28T16:26:18Z\",\"authors\":[{\"email\":\"mike@holownych.com\",\"id\":\"MDQ6VXNlcjc3NTE3ODA=\",\"login\":\"mikeholownych\",\"name\":\"Mike Holownych\"}],\"committedDate\":\"2026-10-28T16:26:18Z\",\"messageBody\":\"\",\"messageHeadline\":\"docs(release): refresh exact PR qualification status\",\"oid\":\"d38341f370615aeef39d702e4612dec8479167a3\"}],\"files\":[{\"path\":\"docs/v1.0.0/READINESS.md\",\"additions\":73,\"deletions\":1,\"changeType\":\"MODIFIED\"}],\"headRefName\":\"v1/rc-readiness-refresh-20261028\",\"headRefOid\":\"d38341f370615aeef39d702e4612dec8479167a3\",\"mergeable\":\"UNKNOWN\",\"reviewDecision\":\"\",\"title\":\"docs(release): include codebase review scope\"}\n{\"baseRefName\":\"main\",\"baseRefOid\":\"145d464dd819a20bf918dfbb4f0176f2c4840a08\",\"body\":\"<!-- entire-trail-link-start -->\\nhttps://entire.com/gh/mikeholownych/-/trails/17/changes/nexus-code/17\\n<!-- entire-trail-link-end -->\\n\\n## Summary\\n\\nHardens checkpoint restore against unsafe workspace obstructions and preserves restore invariants when tracked files are replaced by directories. Coverage includes ordinary untracked children, committed-child replacement, ignored canaries, nested worktree and bare repositories, symlinked ancestors, special filesystem entries, and unchanged staged/index state on rejection.\\n\\n## Exact revision and evidence\\n\\n- Base: `b2ae2fe82640e44d58ef5418f49b46df03392212`\\n- Head: `3c52580ae1da6b7f1282018f4d3702dcb75f8bd7`\\n- Cumulative diff SHA-256: `d90aeb05a9f5c5d0a35bfa0f597d96cc39a5f6480e22b20094f7523cd4cacdff`\\n- The bare-repository guard requires a bare Git config declaration and bounds config reads; regression verifies the captured file is not copied into the bare repository and that bare and outer repository state stays unchanged. A lookalike ordinary directory remains restorable.\\n- Exact-head validation in an immutable snapshot: `checkpoint_restore.test.ts` 51/51; TypeScript `--noEmit` PASS; `git diff --check` PASS. Tests used an isolated HOME.\\n- Independent full-diff review: ACCEPT for this exact head and diff hash.\\n- Exact-head GitHub checks: CodeQL and JavaScript/TypeScript PASS; Node 22 and Node 24 are pending. Entire Gates is pending; its details are unavailable behind authentication here.\\n\\nThis PR is not merge-ready until all required exact-head checks and the Entire gate pass. Exact-RC qualification and manual acceptance remain separate release gates.\\n\",\"commits\":[{\"authoredDate\":\"2026-10-24T10:19:16Z\",\"authors\":[{\"email\":\"mike@holownych.com\",\"id\":\"MDQ6VXNlcjc3NTE3ODA=\",\"login\":\"mikeholownych\",\"name\":\"Mike Holownych\"}],\"committedDate\":\"2026-10-28T16:07:22Z\",\"messageBody\":\"\",\"messageHeadline\":\"fix(checkpoint): preserve untracked files on restore\",\"oid\":\"511738b1d52902ab2aac07d34dece81ab6306bb4\"},{\"authoredDate\":\"2026-10-24T10:31:05Z\",\"authors\":[{\"email\":\"mike@holownych.com\",\"id\":\"MDQ6VXNlcjc3NTE3ODA=\",\"login\":\"mikeholownych\",\"name\":\"Mike Holownych\"}],\"committedDate\":\"2026-10-28T16:07:22Z\",\"messageBody\":\"\",\"messageHeadline\":\"fix(checkpoint): harden untracked restore boundaries\",\"oid\":\"c150dc661fc95480d9d8da9bf80c729f131189e3\"},{\"authoredDate\":\"2026-10-24T10:38:04Z\",\"authors\":[{\"email\":\"mike@holownych.com\",\