}\n  if (start < output.length) entries.push(output.subarray(start));\n  for (const entry of entries) {\n    const decoded = entry.toString(\"utf8\");\n    if (!Buffer.from(decoded, \"utf8\").equals(entry)) {\n      throw new GitPathEncodingError();\n    }\n  }\n  return entries;\n}\n\nfunction stripGitLineEnding(value: string): string {\n  return value.endsWith(\"\\n\") ? value.slice(0, -1) : value;\n}\n\nclass GitPathEncodingError extends Error {\n  constructor() {\n    super(\"Checkpoint cannot safely process Git paths that are not valid UTF-8\");\n    this.name = \"GitPathEncodingError\";\n  }\n}\n\nconst NESTED_GIT_REPOSITORY_ERROR = \"Checkpoint destination parent is a nested Git repository\";\n\nfunction lstatOrAbsent(target: string): fs.Stats | undefined {\n  try {\n    return fs.lstatSync(target, { throwIfNoEntry: false });\n  } catch (error) {\n    const code = (error as NodeJS.ErrnoException).code;\n    if (code === \"ENOENT\" || code === \"ENOTDIR\") return undefined;\n    throw error;\n  }\n}\n\nclass GitIndexLockError extends Error {\n  constructor() {\n    super(\"Git index lock exists; check for an active Git operation before deciding whether the lock is stale.\");\n    this.name = \"GitIndexLockError\";\n  }\n}\n\nclass GitIndexLockCheckError extends Error {\n  constructor() {\n    super(\"Could not inspect the Git index lock; checkpoint creation stopped without changing Git state.\");\n    this.name = \"GitIndexLockCheckError\";\n  }\n}\n\nexport class CheckpointManager {\n  private workspace: string;\n  private checkpointDir: string;\n  private isGit: boolean = false;\n  private repositoryRootCache: string | undefined;\n  private workspacePrefixCache: string | undefined;\n\n  constructor(workspace: string) {\n    this.workspace = path.resolve(workspace);\n    const hash = crypto.createHash(\"sha256\").update(this.workspace).digest(\"hex\").slice(0, 12);\n    this.checkpointDir = path.join(os.homedir(), \".nexus\", \"checkpoints\", hash);\n    ensurePrivateDir(this.checkpointDir);\n    this.checkGit();\n  }\n\n  private checkGit(): void {\n    try {\n      execFileSync(\"git\", [\"rev-parse\", \"--is-inside-work-tree\"], { cwd: this.workspace, stdio: \"ignore\" });\n      this.isGit = true;\n    } catch {\n      this.isGit = false;\n    }\n  }\n\n  private gitRoot(): string {\n    if (!this.repositoryRootCache) {\n      this.repositoryRootCache = fs.realpathSync(stripGitLineEnding(execFileSync(\"git\", [\"rev-parse\", \"--show-toplevel\"], {\n        cwd: this.workspace,\n        encoding: \"utf8\",\n      })));\n    }\n    return this.repositoryRootCache;\n  }\n\n  private gitWorkspacePrefix(): string {\n    if (this.workspacePrefixCache === undefined) {\n      const prefix = stripGitLineEnding(execFileSync(\"git\", [\"rev-parse\", \"--show-prefix\"], {\n        cwd: this.workspace,\n        encoding: \"utf8\",\n      }));\n      this.workspacePrefixCache = prefix.replace(/\\\\/g, \"/\");\n    }\n    return this.workspacePrefixCache;\n  }\n\n      if (entry.isDirectory()) {\n        this.copyDirFiltered(srcPath, destPath, allowSensitive);\n      } else if (entry.isFile()) {\n        const content = fs.readFileSync(srcPath);\n        if (!allowSensitive) assertNoSensitivePersistenceContent(content.toString(\"utf8\"), \"checkpoint\");\n        writePrivateFile(destPath, content);\n      }\n    }\n  }\n\n  private assertGitChangesSafe(allowSensitive: boolean): void {\n    const changedPaths = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--no-renames\", \"--name-only\", \"-z\", \"HEAD\"], {\n      cwd: this.workspace,\n      encoding: \"buffer\",\n    })).map((entry) => entry.toString(\"utf8\"));\n\n    const gitRoot = this.gitRoot();\n    const workspacePrefix = this.gitWorkspacePrefix();\n    const changedPathByRootPath = new Map(changedPaths.map((relativePath) => [\n      Buffer.from(`${workspacePrefix}${relativePath}`, \"utf8\").toString(\"hex\"),\n      relativePath,\n    ]));\n    const indexEntriesByPath = new Map<string, Array<{ mode: string; objectId: string; stage: string }>>();\n    const rawIndex = execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"ls-files\", \"--stage\", \"--full-name\", \"-z\"], {\n      cwd: gitRoot,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    });\n    for (const entry of gitNulEntries(rawIndex)) {\n      const tab = entry.indexOf(\"\\t\");\n      if (tab < 0) throw new Error(\"Checkpoint could not verify protected Git index state\");\n      const relativePath = changedPathByRootPath.get(entry.subarray(tab + 1).toString(\"hex\"));\n      if (relativePath === undefined) continue;\n      const [mode, objectId, stage] = entry.subarray(0, tab).toString(\"ascii\").split(\" \");\n      const existing = indexEntriesByPath.get(relativePath) ?? [];\n      existing.push({ mode, objectId, stage });\n      indexEntriesByPath.set(relativePath, existing);\n    }\n    for (const relativePath of changedPaths) {\n      if (!allowSensitive) this.assertSnapshotTextSafe(relativePath);\n      const indexEntries = indexEntriesByPath.get(relativePath) ?? [];\n      if (indexEntries.length === 0) continue;\n      if (indexEntries.length !== 1 || indexEntries[0].stage !== \"0\") {\n        throw new Error(\"Checkpoint could not verify protected Git index state\");\n      }\n      const { mode, objectId } = indexEntries[0];\n      const indexed = execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"cat-file\", \"blob\", objectId], {\n        cwd: gitRoot,\n        encoding: \"buffer\",\n        maxBuffer: 64 * 1024 * 1024,\n        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n      });\n      if (!allowSensitive) {\n        if (mode === \"120000\") this.assertSnapshotTextSafe(indexed.toString(\"utf8\"));\n        else assertNoSensitivePersistenceContent(indexed.toString(\"utf8\"), \"checkpoint\");\n      }\n\n      const worktreePath = path.join(this.workspace, relativePath);\n      let ancestor = this.workspace;\n      let unsafeParent = false;\n      for (const component of relativePath.split(\"/\").slice(0, -1)) {\n        ancestor = path.join(ancestor, component);\n        const parentStat = lstatOrAbsent(ancestor);\n        if (!parentStat || !parentStat.isDirectory() || parentStat.isSymbolicLink()) {\n          unsafeParent = true;\n          break;\n        }\n      }\n      if (unsafeParent) continue;\n      const stat = lstatOrAbsent(worktreePath);\n      if (stat?.isSymbolicLink()) {\n        if (!allowSensitive) this.assertSnapshotTextSafe(fs.readlinkSync(worktreePath));\n      } else if (stat?.isFile()) {\n        if (!allowSensitive) assertNoSensitivePersistenceContent(fs.readFileSync(worktreePath, \"utf8\"), \"checkpoint\");\n      }\n    }\n\ntest(\"Git checkpoint rejects sensitive worktree symlink-target components without writing a ref\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.symlinkSync(\"ordinary-target\", path.join(repo, \"link.txt\"));\n    git(\"add\", \"link.txt\");\n    fs.unlinkSync(path.join(repo, \"link.txt\"));\n    fs.symlinkSync(\"dir/API_KEY=REDACTED, path.join(repo, \"link.txt\"));\n    const manager = new CheckpointManager(repo);\n\n    assert.throws(() => manager.createCheckpoint(\"sensitive worktree link\"), SensitivePersistenceError);\n    assert.equal(manager.listCheckpoints().length, 0);\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git checkpoint rejects a staged symlink containing a credentialed database URL\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.symlinkSync(\"ordinary-target\", path.join(repo, \"link.txt\"));\n    git(\"add\", \"link.txt\");\n    fs.unlinkSync(path.join(repo, \"link.txt\"));\n    fs.symlinkSync(\"REDACTED\", path.join(repo, \"link.txt\"));\n    const manager = new CheckpointManager(repo);\n\n    assert.throws(() => manager.createCheckpoint(\"credentialed URL symlink\"), SensitivePersistenceError);\n    assert.equal(manager.listCheckpoints().length, 0);\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git checkpoint checks staged content at the repository root for a subdirectory workspace\", () => {\n  const { repo, git } = gitRepo();\n  const workspace = path.join(repo, \"sub\");\n  fs.mkdirSync(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"settings.txt\"), \"DATABASE_URL=REDACTED\");\n    git(\"add\", \"sub/settings.txt\");\n    const manager = new CheckpointManager(workspace);\n\n    assert.throws(() => manager.createCheckpoint(\"sensitive subdirectory workspace\"), SensitivePersistenceError);\n    assert.equal(manager.listCheckpoints().length, 0);\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git-backed checkpoint refuses non-Git fallback after repository metadata disappears\", () => {\n  const { repo } = gitRepo();\n  const manager = new CheckpointManager(repo);\n  const gitDir = path.join(repo, \".git\");\n  const movedGitDir = path.join(repo, \".git-moved-for-test\");\n  try {\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"captured untracked work\\n\");\n    const checkpoint = manager.createCheckpoint(\"Git metadata removal\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"must remain after refusal\\n\");\n    fs.renameSync(gitDir, movedGitDir);\n\n    const noGitManager = new CheckpointManager(repo);\n    const result = noGitManager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /requires its Git repository metadata/);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"must remain after refusal\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"captured untracked work\\n\");\n  } finally {\n    if (fs.existsSync(movedGitDir)) fs.renameSync(movedGitDir, gitDir);\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"subdirectory workspace restore removes checkpoint-deleted paths relative to that workspace\", () => {\n  const { repo, git } = gitRepo();\n  const workspace = path.join(repo, \"sub\");\n  fs.mkdirSync(workspace);\n  fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"base\\n\");\n  git(\"add\", \"sub/tracked.txt\");\n  git(\"commit\", \"-qm\", \"subdirectory base\");\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.rmSync(path.join(workspace, \"tracked.txt\"));\n    fs.writeFileSync(path.join(workspace, \"draft.txt\"), \"subdirectory untracked draft\\n\");\n    git(\"add\", \"-u\", \"sub/tracked.txt\");\n    const checkpoint = manager.createCheckpoint(\"subdirectory deletion\");\n    git(\"reset\", \"--hard\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.existsSync(path.join(workspace, \"tracked.txt\")), false);\n    assert.equal(fs.readFileSync(path.join(workspace, \"draft.txt\"), \"utf8\"), \"subdirectory untracked draft\\n\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"subdirectory workspace restore preserves sibling worktree and index changes\", () => {\n  const { repo, git } = gitRepo();\n  const workspace = path.join(repo, \"sub\");\n  fs.mkdirSync(workspace);\n  fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"subdirectory base\\n\");\n  git(\"add\", \"tracked.txt\", \"sub/tracked.txt\");\n  git(\"commit\", \"-qm\", \"subdirectory restore base\");\n  const manager = new CheckpointManager(workspace);\n  try {\n    const checkpoint = manager.createCheckpoint(\"subdirectory scoped restore\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"sibling staged work\\n\");\n    git(\"add\", \"tracked.txt\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"sibling unstaged work\\n\");\n    fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"subdirectory later work\\n\");\n    git(\"add\", \"sub/tracked.txt\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"sibling unstaged work\\n\");\n    assert.equal(git(\"show\", \":tracked.txt\"), \"sibling staged work\");\n    assert.equal(fs.readFileSync(path.join(workspace, \"tracked.txt\"), \"utf8\"), \"subdirectory base\\n\");\n    assert.equal(git(\"show\", \":sub/tracked.txt\"), \"subdirectory base\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"tracked deletion cleanup runs before a checkpoint symlink can redirect it\", () => {\n  const { repo, git } = gitRepo();\n  const alias = path.join(repo, \"alias\");\n  const data = path.join(repo, \"data\");\n  fs.mkdirSync(alias);\n  fs.writeFileSync(path.join(alias, \"file\"), \"tracked alias file\\n\");\n  fs.mkdirSync(data);\n  fs.writeFileSync(path.join(data, \"file\"), \"ignored data must survive\\n\");\n  fs.writeFileSync(path.join(repo, \".gitignore\"), \"data/\\n\");\n  git(\"add\", \"alias/file\", \".gitignore\");\n  git(\"commit\", \"-qm\", \"tracked alias and ignored data\");\n  const manager = new CheckpointManager(repo);\n  try {\n    fs.rmSync(path.join(alias, \"file\"));\n    fs.rmdirSync(alias);\n    fs.symlinkSync(\"data\", alias);\n    git(\"add\", \"-A\", \"alias\");\n    const checkpoint = manager.createCheckpoint(\"symlink replacement deletion\");\n    git(\"reset\", \"--hard\", \"HEAD\");\n## v1/checkpoint-ordinary-child-fix\n M cli/src/checkpoint.ts\n M cli/test/checkpoint_restore.test.ts\n1482d6b3 fix(checkpoint): avoid unsupported check-ignore pathspec magic\n","exit_code":0,"duration":{"secs":1,"nanos":189014113}},"started_at_ms":1793209290063,"completed_at_ms":1793209291252}}
