nt = this.workspace;\n+      let blocked = false;\n+      for (const component of relativePath.split(\"/\").slice(0, -1)) {\n+        parent = path.join(parent, component);\n+        const stat = lstatOrAbsent(parent);\n+        if (!stat || !stat.isDirectory() || stat.isSymbolicLink()) {\n+          blocked = true;\n+          break;\n+        }\n+      }\n+      if (blocked) continue;\n       try {\n         execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `./${relativePath}`], {\n           cwd: this.workspace,\n           stdio: \"ignore\",\n         });\n-        throw new Error(\"Checkpoint restore refuses to remove a staged addition ignored by current Git rules; workspace was not changed\");\n+        throw new Error(\"Checkpoint restore refuses to remove a staged addition ignored by current Git rules (untracked collision); workspace was not changed\");\n       } catch (error) {\n         if (error instanceof Error && error.message.includes(\"refuses to remove a staged addition\")) throw error;\n         if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) {\n@@ -169,6 +188,18 @@ export class CheckpointManager {\n     }\n   }\n \n+  private stagedPathsAddedToHead(): string[] {\n+    const root = this.gitRoot();\n+    return gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff-index\", \"--cached\", \"--no-renames\", \"--name-only\", \"--diff-filter=A\", \"-z\", \"HEAD\"], {\n+      cwd: root,\n+      encoding: \"buffer\",\n+      maxBuffer: 64 * 1024 * 1024,\n+    })).map((entry) => entry.toString(\"utf8\")).flatMap((gitPath) => {\n+      const relativePath = this.workspaceRelativeGitPath(gitPath);\n+      return relativePath ? [relativePath] : [];\n+    });\n+  }\n+\n   private restoreGitIndex(gitRef: string, hookGuardEnv: NodeJS.ProcessEnv): void {\n     const prefix = this.gitWorkspacePrefix();\n     const repositoryRoot = this.gitRoot();\n@@ -292,66 +32