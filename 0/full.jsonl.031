uit.\\n\\n* main CI · 40729793371\\nTriggered via push about 9 minutes ago\\n\\nJOBS\\n* test-matrix (24) (ID 122962689226)\\n  ✓ Set up job\\n  ✓ Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\\n  ✓ Run sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\\n  ✓ Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\\n  ✓ Run bash scripts/ensure-ci-bubblewrap.sh\\n  ✓ Run bash scripts/ensure-ci-user-cgroups.sh\\n  ✓ Mount a dedicated capped tmpfs for evaluator resource fixtures\\n  ✓ Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\\n  ✓ Install selected Node runtime for isolated evaluation commands\\n  ✓ Run node scripts/sync-version.mjs --check\\n  ✓ Run node scripts/check_requirements.mjs\\n  ✓ Run npm ci --prefix cli\\n  ✓ Run npm --prefix cli run build\\n  ✓ Run git diff --exit-code -- cli/dist\\n  ✓ Run cargo test --locked --manifest-path core/Cargo.toml\\n  ✓ Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\\n  ✓ Install pinned security and SBOM test tools\\n  * Run npm -…2815 tokens truncated…8078e36cf38b85af677262\\n  ✓ Run sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\\n  ✓ Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\\n  ✓ Run bash scripts/ensure-ci-bubblewrap.sh\\n  ✓ Run bash scripts/ensure-ci-user-cgroups.sh\\n  ✓ Mount a dedicated capped tmpfs for evaluator resource fixtures\\n  ✓ Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\\n  ✓ Install selected Node runtime for isolated evaluation commands\\n  ✓ Run node scripts/sync-version.mjs --check\\n  ✓ Run node scripts/check_requirements.mjs\\n  ✓ Run npm ci --prefix cli\\n  ✓ Run npm --prefix cli run build\\n  ✓ Run git diff --exit-code -- cli/dist\\n  ✓ Run cargo test --locked --manifest-path core/Cargo.toml\\n  ✓ Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\\n  ✓ Install pinned security and SBOM test tools\\n  * Run npm --prefix cli test\\n  * Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\\n  * Post Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\\n  * Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18336-b174-72a1-9e58-590be19b8235","create_time":1793206899.7271123}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
