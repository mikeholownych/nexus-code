s **one\ndocs/v1.1.0/MULTI_AGENT_ORCHESTRATION.md:12:- `spawn_subagent` is in-turn delegation inside one agent turn: it does not create a scheduled unit, and its work is not\ndocs/PHASE4_IMPLEMENTATION_WORK_PACKAGES.md:1140:Every work package must execute targeted property-based, adversarial, and negative tests establishing specific guarantees:\ncli/src/agent.ts:5182:      console.warn(pc.yellow(`↪ Provider ${record.condition.toLowerCase().replace(/_/g, \" \")}: step ${record.step} handed back to the operation scheduler (not executed).`));\ncli/test/config.test.ts:167:      fs.writeFileSync(path.join(workspace, \"nexus.config.json\"), JSON.stringify({\ncli/test/config.test.ts:288:        /Invalid operation policy/,\ncli/test/config.test.ts:294:      /Invalid operation policy unknownResumeBudget/,\ncli/test/convergence_scheduler_properties.test.ts:2: * Generated dependency-graph invariants for ConvergenceScheduler.\ncli/test/convergence_scheduler_properties.test.ts:8:import { ConvergenceScheduler, newOperation } from \"../src/core/operation.js\";\ncli/test/convergence_scheduler_properties.test.ts:44:    const scheduler = new ConvergenceScheduler(state, registry, () => now);\ncli/test/convergence_scheduler_properties.test.ts:69:  const scheduler = new ConvergenceScheduler(\ncli/test/team_convergence.test.ts:2: * /team on the convergence foundation: roles are durable work units scheduled by ConvergenceScheduler, executed as\ncli/test/team_convergence.test.ts:17:import { DecisionRejected, newOperation, type DurableOperationState, type OperationEvent, type OperationEventType, type UnitRunResult, type WorkUnit } from \"../src/core/operation.js\";\ncli/test/team_convergence.test.ts:194:  test(\"operator operation policy is persisted when planning a team operation\", async () => {\ncli/test/team_convergence.test.ts:920:      const tryApply = (d: string, o: string, note?: string) => assert.throws(() => applyOperatorDecision(env.store, \"team-dec\", d, o, note), DecisionRejected);\ncli/test/convergence_scheduling.test.ts:11:import { ConvergenceScheduler, newOperation, type DurableOperationState, type UnitRunResult, type WorkUnit, type WorkUnitSpec } from \"../src/core/operation.js\";\ncli/test/convergence_scheduling.test.ts:678:    const s = new ConvergenceScheduler(state, new ResourceRegistry(state.resources, [], clock), clock.now);\ncli/src/operation_cli.ts:18:import { DecisionRejected, newOperation, type DurableOperationState, type OperationEvent, type OperationPolicy, type WorkUnitSpec } from \"./core/operation.js\";\ncli/src/operation_cli.ts:179:        if (!(err instanceof DecisionRejected)) throw err;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18336-b174-72a1-9e58-590be19b8235","create_time":1793205172.860271}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
