{"timestamp":"2026-10-28T16:23:17.065Z","ordinal":454467,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","item":{"type":"CommandExecution","id":"exec-a655cea3-915b-47c4-92e3-bbecd3abac24","process_id":"97815","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix status --short --branch && git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --stat --oneline 49a2af0c1d556912d12b834aa7f2022ef63b528c && git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --format=fuller --no-ext-diff 49a2af0c1d556912d12b834aa7f2022ef63b528c -- && cat /home/mike/nexus-code/.git/nexus-claims/PLAN-10_CHECKPOINT_RESTORE/owner.json 2>/dev/null || true"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix status --short --branch && git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --stat --oneline 49a2af0c1d556912d12b834aa7f2022ef63b528c && git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --format=fuller --no-ext-diff 49a2af0c1d556912d12b834aa7f2022ef63b528c -- && cat /home/mike/nexus-code/.git/nexus-claims/PLAN-10_CHECKPOINT_RESTORE/owner.json 2>/dev/null || true"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"## v1/checkpoint-ordinary-child-fix\n49a2af0c fix(checkpoint): scope nested restore checkout\n cli/src/checkpoint.ts               | 11 ++++++++++-\n cli/test/checkpoint_restore.test.ts |  3 ++-\n 2 files changed, 12 insertions(+), 2 deletions(-)\ncommit 49a2af0c1d556912d12b834aa7f2022ef63b528c\nAuthor:     Mike Holownych <mike@holownych.com>\nAuthorDate: Wed Oct 28 16:19:26 2026 +0000\nCommit:     Mike Holownych <mike@holownych.com>\nCommitDate: Wed Oct 28 16:19:26 2026 +0000\n\n    fix(checkpoint): scope nested restore checkout\n\ndiff --git a/cli/src/checkpoint.ts b/cli/src/checkpoint.ts\nindex 124e0282..7e58e78f 100644\n--- a/cli/src/checkpoint.ts\n+++ b/cli/src/checkpoint.ts\n@@ -1096,7 +1096,16 @@ export class CheckpointManager {\n         // present. Installing checkpoint symlinks first could redirect deletion\n         // through an in-workspace link into unrelated ignored data.\n         this.removeTrackedDeletions(cp.gitRef, postCheckpointAdditions);\n-        execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"checkout-index\", \"-f\", \"-a\"], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n+        const checkoutArgs = [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"checkout-index\", \"-f\"];\n+        const workspacePrefix = this.gitWorkspacePrefix();\n+        if (workspacePrefix) {\n+          // The real index still contains sibling entries. Restrict checkout to\n+          // this workspace so staged sibling content cannot overwrite its worktree.\n+          checkoutArgs.push(\"--\", `:(top,literal)${workspacePrefix.slice(0, -1)}`);\n+        } else {\n+          checkoutArgs.push(\"-a\");\n+        }\n+        execFileSync(\"git\", checkoutArgs, { cwd: this.gitRoot(), stdio: \"ignore\", env: hookGuardEnv });\n         if (cp.untrackedFiles !== undefined) {\n           execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"clean\", \"-fd\"], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n           if (cp.untrackedFiles.length > 0) {\ndiff --git a/cli/test/checkpoint_restore.test.ts b/cli/test/checkpoint_restore.test.ts\nindex 29a3bb22..e7c87efe 100644\n--- a/cli/test/checkpoint_restore.test.ts\n+++ b/cli/test/checkpoint_restore.test.ts\n@@ -738,13 +738,14 @@ test(\"subdirectory workspace restore preserves sibling worktree and index change\n     const checkpoint = manager.createCheckpoint(\"subdirectory scoped restore\");\n     fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"sibling staged work\\n\");\n     git(\"add\", \"tracked.txt\");\n+    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"sibling unstaged work\\n\");\n     fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"subdirectory later work\\n\");\n     git(\"add\", \"sub/tracked.txt\");\n \n     const result = manager.restore(checkpoint.id);\n \n     assert.equal(result.success, true, result.message);\n-    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"sibling staged work\\n\");\n+    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"sibling unstaged work\\n\");\n     assert.equal(git(\"show\", \":tracked.txt\"), \"sibling staged work\");\n     assert.equal(fs.readFileSync(path.join(workspace, \"tracked.txt\"), \"utf8\"), \"subdirectory base\\n\");\n     assert.equal(git(\"show\", \":sub/tracked.txt\"), \"subdirectory base\");\n","exit_code":0,"duration":{"secs":0,"nanos":34166}},"started_at_ms":1793204597064,"completed_at_ms":1793204597065}}
