6-10-28T17:14:49Z\",\"conclusion\":\"success\",\"name\":\"Run npm --prefix cli run build\",\"number\":13,\"startedAt\":\"2026-10-28T17:14:45Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T17:14:49Z\",\"conclusion\":\"success\",\"name\":\"Run git diff --exit-code -- cli/dist\",\"number\":14,\"startedAt\":\"2026-10-28T17:14:49Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T17:15:47Z\",\"conclusion\":\"success\",\"name\":\"Run cargo test --locked --manifest-path core/Cargo.toml\",\"number\":15,\"startedAt\":\"2026-10-28T17:14:49Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T17:16:53Z\",\"conclusion\":\"success\",\"name\":\"Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\",\"number\":16,\"startedAt\":\"2026-10-28T17:15:47Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T17:16:55Z\",\"conclusion\":\"success\",\"name\":\"Install pinned security and SBOM test tools\",\"number\":17,\"startedAt\":\"2026-10-28T17:16:53Z\",\"status\":\"completed\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run npm --prefix cli test\",\"number\":18,\"startedAt\":\"2026-10-28T17:16:55Z\",\"status\":\"in_progress\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":34,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":35,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":36,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40733687806/job/122976433726\"}],\"status\":\"in_progress\",\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40733687806\"}\n{\"headRefOid\":\"2b6490f7cbdda0fad8864b4867aab42d8013cb75\",\"mergeable\":\"MERGEABLE\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40735334892/job/122982230171\",\"name\":\"test-matrix (22)\",\"startedAt\":\"2026-10-28T17:24:01Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-28T17:25:47Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40735334995/job/122982230900\",\"name\":\"javascript-typescript\",\"startedAt\":\"2026-10-28T17:24:01Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CodeQL\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40735334892/job/122982229624\",\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-28T17:24:00Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://entire.com/gh/mikeholownych/-/trails/15/changes/nexus-code/15\",\"name\":\"Entire Gates\",\"startedAt\":\"2026-10-28T17:24:05Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-28T17:25:39Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/runs/122982876350\",\"name\":\"CodeQL\",\"startedAt\":\"2026-10-28T17:25:07Z\",\"status\":\"COMPLETED\",\"workflowName\":\"\"},{\"__typename\":\"StatusContext\",\"context\":\"CodeRabbit\",\"startedAt\":\"2026-10-28T17:24:01Z\",\"state\":\"SUCCESS\",\"targetUrl\":\"\"}]}\n{\"headRefOid\":\"87b560c7e581fa71cce270474ba40766f372fb04\",\"mergeable\":\"MERGEABLE\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40735401162/job/122982457901\",\"name\":\"test-matrix (22)\",\"startedAt\":\"2026-10-28T17:24:24Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40735870389/job/122984123190\",\"name\":\"test-matrix (22)\",\"startedAt\":\"2026-10-28T17:27:21Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-28T17:26:30Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40735401047/job/122982459345\",\"name\":\"javascript-typescript\",\"startedAt\":\"2026-10-28T17:24:24Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CodeQL\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-28T17:28:53Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40735870441/job/122984123933\",\"name\":\"javascript-typescript\",\"startedAt\":\"2026-10-28T17:27:21Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CodeQL\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40735401162/job/122982457085\",\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-28T17:24:24Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40735870389/job/122984123643\",\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-28T17:27:21Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://entire.com/gh/mikeholownych/-/trails/17/changes/nexus-code/17\",\"name\":\"Entire Gates\",\"startedAt\":\"2026-10-28T17:24:27Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-28T17:26:16Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/runs/122983290447\",\"name\":\"CodeQL\",\"startedAt\":\"2026-10-28T17:25:50Z\",\"status\":\"COMPLETED\",\"workflowName\":\"\"},{\"__typename\":\"StatusContext\",\"context\":\"CodeRabbit\",\"startedAt\":\"2026-10-28T17:27:22Z\",\"state\":\"SUCCESS\",\"targetUrl\":\"\"}]}\nname: CI\n\non:\n  push:\n    branches: [main]\n  pull_request:\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\njobs:\n  test-matrix:\n    runs-on: ubuntu-22.04\n    strategy:\n      fail-fast: false\n      matrix:\n        node: [22, 24]\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.x'\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: ${{ matrix.node }}\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - run: node scripts/sync-version.mjs --check\n      - run: node scripts/check_requirements.mjs\n      - run: npm ci --prefix cli\n      - run: npm --prefix cli run build\n      - run: git diff --exit-code -- cli/dist\n      - run: cargo test --locked --manifest-path core/Cargo.toml\n      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n      - name: Install pinned security and SBOM test tools\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - run: npm --prefix cli test\n\n  linux-x86_64:\n    needs: [test-matrix]\n    runs-on: ubuntu-22.04\n    env:\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.x'\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - name: Install cargo tools (audit, deny, about, cyclonedx)\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - run: cargo deny --manifest-path core/Cargo.toml --config deny.toml check licenses advisories\n      - run: node scripts/sync-version.mjs --check\n      - run: npm ci --prefix cli\n      - run: npm --prefix cli run build\n      - run: git diff --exit-code -- cli/dist\n      - run: cargo test --locked --manifest-path core/Cargo.toml\n      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n      - run: npm --prefix cli test\n      - run: bash scripts/security_gates.sh\n      - run: node scripts/check_requirements.mjs\n      - id: release-version\n        run: echo \"version=$(node -p 'require(\"./package.json\").version')\" >> \"$GITHUB_OUTPUT\"\n      - run: bash scripts/package-linux.sh \"v${{ steps.release-version.outputs.version }}\" \"$RUNNER_TEMP/dist\"\n      - run: bash scripts/package-linux.sh \"v${{ steps.release-version.outputs.version }}\" \"$RUNNER_TEMP/repro-check\"\n      - run: cmp \"$RUNNER_TEMP/dist/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\" \"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\"\n      - run: cmp \"$RUNNER_TEMP/dist/SHA256SUMS\" \"$RUNNER_TEMP/repro-check/SHA256SUMS\"\n      - run: cmp \"$RUNNER_TEMP/dist/THIRD_PARTY_NOTICES.txt\" \"$RUNNER_TEMP/repro-check/THIRD_PARTY_NOTICES.txt\"\n      - run: cyclonedx validate --input-file \"$RUNNER_TEMP/dist/sbom.cdx.json\" --fail-on-errors\n      - run: cmp \"$RUNNER_TEMP/dist/sbom.cdx.json\" \"$RUNNER_TEMP/repro-check/sbom.cdx.json\"\n      - run: cmp \"$RUNNER_TEMP/dist/install.sh\" \"$RUNNER_TEMP/repro-check/install.sh\"\n      - run: bash scripts/smoke-package.sh \"$RUNNER_TEMP/dist/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\"\n      - run: bash scripts/installer-smoke.sh \"$GITHUB_WORKSPACE/install.sh\" \"$RUNNER_TEMP/dist/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\"\n      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n        with:\n          name: nexus-linux-x86_64\n          path: ${{ runner.temp }}/dist/*\n          if-no-files-found: error\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18336-b174-72a1-9e58-590be19b8235","create_time":1793208544.1180005}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
