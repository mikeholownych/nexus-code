tatus?: number })?.status !== 1) {\n-          throw new Error(\"Checkpoint could not verify whether a staged addition is ignored; workspace was not changed\");\n+      const target = lstatOrAbsent(path.join(this.workspace, relativePath));\n+      // removeTrackedDeletions never removes a directory target, preserving\n+      // ignored descendants while the checkpoint's file deletion remains absent.\n+      if (target?.isDirectory() && !target.isSymbolicLink()) continue;\n+      // restore's tracked-deletion cleanup deliberately skips targets beneath\n+      // a missing, non-directory, or symlinked parent. Git check-ignore cannot\n+      // inspect such a path reliably (and may follow external links), so there\n+      // is no ignored target that this restore could remove in that case.\n+      let parent = this.workspace;\n+      let blocked = false;\n+      for (const component of relativePath.split(\"/\").slice(0, -1)) {\n+        parent = path.join(parent, component);\n+        const stat = lstatOrAbsent(parent);\n+        if (!stat || !stat.isDirectory() || stat.isSymbolicLink()) {\n+          blocked = true;\n+          break;\n         }\n       }\n+      if (blocked) continue;\n+      let ignored: boolean;\n+      try {\n+        ignored = isGitPathIgnored(this.workspace, relativePath);\n+      } catch {\n+        throw new Error(\"Checkpoint could not verify whether a staged addition is ignored; workspace was not changed\");\n+      }\n+      if (ignored) throw new Error(\"Checkpoint restore refuses to remove a staged addition ignored by current Git rules (untracked collision); workspace was not changed\");\n     }\n   }\n \n@@ -292,66 +320,65 @@ export class CheckpointManager {\n   }\n \n   private assertGitChangesSafe(allowSensitive: boolean): void {\n+    const gitRoot = this.gitRoot();\n     const changedPaths = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--no-renames\", \"--name-only\", \"-z\", \"HEAD\"], {\n-      cwd: this.workspace,\n+      cwd: gitRoot,\n       encoding: \"buffer\",\n-    })).map((entry) => entry.toString(\"utf8\"));\n-\n-    const gitRoot = this.gitRoot();\ndiff --git a/cli/test/checkpoint_restore.test.ts b/cli/test/checkpoint_restore.test.ts\nindex 4d58f202..eda2de9f 100644\n--- a/cli/test/checkpoint_restore.test.ts\n+++ b/cli/test/checkpoint_restore.test.ts\n@@ -195,6 +195,29 @@ test(\"Git restore treats pathspec-magic filenames literally when checking ignore\n   }\n });\n \n+test(\"Git restore does not treat glob syntax in a filename as an ignore-pattern match\", () => {\n+  const { repo, git } = gitRepo();\n+  const globName = \"file[ab].txt\";\n+  try {\n+    fs.writeFileSync(path.join(repo, \".gitignore\"), `${globName}\\n`);\n+    git(\"add\", \".gitignore\");\n+    git(\"commit\", \"-qm\", \"ignore matching glob paths\");\n+    assert.equal(git(\"check-ignore\", \"--no-index\", \"filea.txt\"), \"filea.txt\");\n+    const manager = new CheckpointManager(repo);\n+    const checkpoint = manager.createCheckpoint(\"before glob-bearing staged addition\");\n+    fs.writeFileSync(path.join(repo, globName), \"literal bracket filename\\n\");\n+    git(\"add\", globName);\n+\n+    const result = manager.restore(checkpoint.id);\n+\n+    assert.equal(result.success, true, result.message);\n+    assert.equal(fs.existsSync(path.join(repo, globName)), false);\n+    assert.equal(git(\"status\", \"--porcelain\"), \"\");\n+  } finally {\n+    cleanupGitRepo(repo);\n+  }\n+});\n+\n test(\"legacy Git restore removes a path renamed after the checkpoint\", () => {\n   const { repo, git } = gitRepo();\n   try {\n@@ -296,6 +319,7 @@ test(\"legacy Git restore does not delete uncaptured untracked files or move HEAD\n     const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n     const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n     delete record.untrackedFiles;\n+    delete record.untrackedFileModes;\n     fs.writeFileSync(recordPath, JSON.stringify(record));\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18336-b174-72a1-9e58-590be19b8235","create_time":1793212615.8319619}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
