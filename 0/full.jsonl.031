ror) {\n        if (\n          error instanceof SensitivePersistenceError ||\n          error instanceof GitIndexLockError ||\n          error instanceof GitIndexLockCheckError ||\n          error instanceof GitPathEncodingError\n        ) throw error;\n        if (this.gitIndexLockExists()) throw new GitIndexLockError();\n        throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n      }\n    }\n\n    if (untrackedPaths.length > 0 || !gitRef) {\n      const snapTarget = path.join(this.checkpointDir, \"snapshots\", id);\n      try {\n        if (gitRef) {\n          this.copyUntrackedEntries(untrackedPaths, this.workspace, snapTarget, allowSensitive);\n 768314       09:00 Sl\n  ✔ nothing is recorded when the checkpoint yields nothing; the removal says so (2829.929644ms)\n\n🧭 Dual-Model Routing: [Planner: m | Coder: m]\n  ✔ checkpoints go to the endpoint the step's inference is routed to, never to another configured one (4026.781838ms)\n  ✔ a follow-up turn, in process or in a restored session, still cannot rest on output an earlier turn compacted away (5100.904199ms)\n  ✔ recorded findings survive a restart and later compactions of the restored record (3081.720319ms)\n  ✔ findings beyond the memory bound are condensed, oldest first, never lost: each keeps its sources, says it is condensed, and is returned in full by read_findings (20177.10887ms)\n  ✔ in a small context window recorded findings are bounded to fit, so they never block the investigation (11208.829361ms)\n","exit_code":0,"duration":{"secs":0,"nanos":901794073}},"started_at_ms":1793210274515,"completed_at_ms":1793210275417}}
