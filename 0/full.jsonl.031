g libcap-dev\",\"number\":3,\"startedAt\":\"2026-10-28T18:51:20Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:51:43Z\",\"conclusion\":\"success\",\"name\":\"Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":4,\"startedAt\":\"2026-10-28T18:51:36Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:51:44Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-bubblewrap.sh\",\"number\":5,\"startedAt\":\"2026-10-28T18:51:43Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:51:45Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-user-cgroups.sh\",\"number\":6,\"startedAt\":\"2026-10-28T18:51:44Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:51:45Z\",\"conclusion\":\"success\",\"name\":\"Mount a dedicated capped tmpfs for evaluator resource fixtures\",\"number\":7,\"startedAt\":\"2026-10-28T18:51:45Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:51:47Z\",\"conclusion\":\"success\",\"name\":\"Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":8,\"startedAt\":\"2026-10-28T18:51:45Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:51:50Z\",\"conclusion\":\"success\",\"name\":\"Install selected Node runtime for isolated evaluation commands\",\"number\":9,\"startedAt\":\"2026-10-28T18:51:47Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:51:50Z\",\"conclusion\":\"success\",\"name\":\"Run node scripts/sync-version.mjs --check\",\"number\":10,\"startedAt\":\"2026-10-28T18:51:50Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:51:50Z\",\"conclusion\":\"success\",\"name\":\"Run node scripts/check_requirements.mjs\",\"number\":11,\"startedAt\":\"2026-10-28T18:51:50Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:51:51Z\",\"conclusion\":\"success\",\"name\":\"Run npm ci --prefix cli\",\"number\":12,\"startedAt\":\"2026-10-28T18:51:50Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:51:56Z\",\"conclusion\":\"success\",\"name\":\"Run npm --prefix cli run build\",\"number\":13,\"startedAt\":\"2026-10-28T18:51:51Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:51:56Z\",\"conclusion\":\"success\",\"name\":\"Run git diff --exit-code -- cli/dist\",\"number\":14,\"startedAt\":\"2026-10-28T18:51:56Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:52:50Z\",\"conclusion\":\"success\",\"name\":\"Run cargo test --locked --manifest-path core/Cargo.toml\",\"number\":15,\"startedAt\":\"2026-10-28T18:51:56Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:53:54Z\",\"conclusion\":\"success\",\"name\":\"Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\",\"number\":16,\"startedAt\":\"2026-10-28T18:52:50Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-28T18:53:56Z\",\"conclusion\":\"success\",\"name\":\"Install pinned security and SBOM test tools\",\"number\":17,\"startedAt\":\"2026-10-28T18:53:54Z\",\"status\":\"completed\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run npm --prefix cli test\",\"number\":18,\"startedAt\":\"2026-10-28T18:53:56Z\",\"status\":\"in_progress\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":34,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":35,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":36,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40748933410/job/123030078524\"}],\"sta