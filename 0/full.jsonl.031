{"timestamp":"2026-10-28T17:56:03.520Z","ordinal":458499,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","item":{"type":"CommandExecution","id":"exec-b2b728e2-1952-43b7-a35f-9455b307b15c","process_id":"15974","command":["/usr/bin/zsh","-lc","rg -n \"symbolic link|symlink|tracked directory|redirect\" cli/test/checkpoint_restore.test.ts"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"search","cmd":"rg -n 'symbolic link|symlink|tracked directory|redirect' cli/test/checkpoint_restore.test.ts","query":"symbolic link|symlink|tracked directory|redirect","path":"checkpoint_restore.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"369:test(\"restore preserves untracked symlinks without copying their external targets\", () => {\n375:    fs.symlinkSync(external, path.join(repo, \"draft-link.txt\"));\n376:    const checkpoint = manager.createCheckpoint(\"symbolic link\");\n441:test(\"tracked deletion cleanup never follows a parent symlink outside the workspace\", () => {\n448:    git(\"commit\", \"-qm\", \"add tracked directory\");\n451:    const checkpoint = manager.createCheckpoint(\"parent symlink\");\n453:    fs.symlinkSync(external, path.join(repo, \"dir\"));\n465:test(\"untracked restore refuses an ignored destination parent symlink\", () => {\n472:    const checkpoint = manager.createCheckpoint(\"ignored parent symlink\");\n476:    fs.symlinkSync(external, path.join(repo, \"alias\"));\n489:test(\"untracked restore refuses dangling and in-workspace symlink ancestors before mutation\", () => {\n496:      const checkpoint = manager.createCheckpoint(`${kind} symlink ancestor`);\n499:        fs.symlinkSync(path.join(repo, \"does-not-exist\"), path.join(repo, \"dir\"));\n502:        fs.symlinkSync(path.join(repo, \"real\"), path.join(repo, \"dir\"));\n688:test(\"non-Git restore preserves symlinks without copying external targets\", () => {\n694:    fs.symlinkSync(external, path.join(workspace, \"link.txt\"));\n695:    const checkpoint = manager.createCheckpoint(\"non-Git symlink\");\n740:    fs.symlinkSync(external, path.join(workspace, \"alias\"));\n768:test(\"checkpoint rejects sensitive symlink-target components\", () => {\n772:    fs.symlinkSync(\"dir/API_KEY=REDACTED, path.join(workspace, \"link.txt\"));\n782:test(\"legacy non-Git restore refuses a destination parent symlink before copying\", () => {\n796:    fs.symlinkSync(external, path.join(workspace, \"alias\"));\n830:test(\"Git checkpoint rejects sensitive index symlink-target components without writing a ref\", () => {\n833:    fs.symlinkSync(\"dir/API_KEY=REDACTED, path.join(repo, \"link.txt\"));\n836:    fs.symlinkSync(\"ordinary-target\", path.join(repo, \"link.txt\"));\n847:test(\"Git checkpoint rejects sensitive worktree symlink-target components without writing a ref\", () => {\n850:    fs.symlinkSync(\"ordinary-target\", path.join(repo, \"link.txt\"));\n853:    fs.symlinkSync(\"dir/API_KEY=REDACTED, path.join(repo, \"link.txt\"));\n864:test(\"Git checkpoint rejects a staged symlink containing a credentialed database URL\", () => {\n867:    fs.symlinkSync(\"ordinary-target\", path.join(repo, \"link.txt\"));\n870:    fs.symlinkSync(\"REDACTED\", path.join(repo, \"link.txt\"));\n873:    assert.throws(() => manager.createCheckpoint(\"credentialed URL symlink\"), SensitivePersistenceError);\n978:test(\"checkpoint fails closed when a tracked deletion sits beneath a worktree symlink\", () => {\n993:    fs.symlinkSync(\"data\", alias);\n995:    assert.throws(() => manager.createCheckpoint(\"symlink replacement deletion\"), /could not verify protected Git state/);\n1162:test(\"legacy non-Git restore refuses an empty-directory destination parent symlink\", () => {\n1175:    fs.symlinkSync(external, path.join(workspace, \"alias\"));\n1550:test(\"Git manifest restore refuses a nested bare repository with a symlinked config\", () => {\n1558:    const checkpoint = manager.createCheckpoint(\"nested bare repository with symlinked config\");\n1564:    fs.symlinkSync(externalConfig, path.join(bareRepo, \"config\"));\n1581:test(\"Git manifest restore refuses a nested bare repository with symlinked object storage\", () => {\n1589:    const checkpoint = manager.createCheckpoint(\"nested bare repository with symlinked object storage\");\n1594:    fs.symlinkSync(externalObjects, path.join(bareRepo, \"objects\"), \"dir\");\n1809:test(\"Git manifest restore refuses a tracked destination through a symlinked nested repository before mutation\", () => {\n1819:    const checkpoint = manager.createCheckpoint(\"tracked path through nested repo symlink\");\n1829:    fs.symlinkSync(\"nested-repo\", path.join(repo, \"a\"));\n","exit_code":0,"duration":{"secs":0,"nanos":881861428}},"started_at_ms":1793210162638,"completed_at_ms":1793210163520}}
