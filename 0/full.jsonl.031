re copying (45.102526ms)\n45:✖ tracked deletion cleanup runs before a checkpoint symlink can redirect it (462.247139ms)\n50:✖ Git restore preserves ignored entries inside a directory replacing a checkpoint-deleted file (209.572205ms)\n52:✖ legacy non-Git restore refuses an empty-directory destination parent symlink (31.276094ms)\n54:✖ legacy Git restore refuses an ignored untracked tracked-deletion collision (521.915851ms)\n88:✖ failing tests:\n91:✖ tracked deletion cleanup never follows a parent symlink outside the workspace (464.43685ms)\n109:✖ Git manifest restore replaces a checkpoint file over staged or committed children without ENOTDIR (225.815293ms)\n127:✖ Git manifest restore replaces a tracked checkpoint blob after committing a child path (308.984776ms)\n145:✖ Git manifest restore replaces a checkpoint-tracked file over an ordinary untracked child (580.586247ms)\n163:✖ legacy non-Git restore never deletes entries absent from old metadata (36.544584ms)\n181:✖ legacy non-Git restore refuses a destination parent symlink before copying (45.102526ms)\n199:✖ tracked deletion cleanup runs before a checkpoint symlink can redirect it (462.247139ms)\n208:✖ Git restore preserves ignored entries inside a directory replacing a checkpoint-deleted file (209.572205ms)\n226:✖ legacy non-Git restore refuses an empty-directory destination parent symlink (31.276094ms)\n244:✖ legacy Git restore refuses an ignored untracked tracked-deletion collision (521.915851ms)\n-        return { success: true, message: `Restored workspace to checkpoint '${cp.name}' (${cp.id})` };\n+        const postCheckpointAdditions = this.trackedPathsAddedSince(cp.gitRef);\n+        this.assertNoIgnoredAddedPaths(postCheckpointAdditions);\n+        const deletedPaths = this.gitRefDeletedPaths(cp.gitRef);\n+        const checkoutPaths = this.gitRefBlobPaths(cp.gitRef);\n+        const writePaths = [...new Set([...checkoutPaths, ...(cp.untrackedFiles ?? [])])];\n+        const removalPaths = [...new Set([...deletedPaths, ...postCheckpointAdditions])];\n+        if (cp.untrackedFiles !== undefined && cp.untrackedFiles.length > 0) {\n+          if (!cp.snapshotDir) return { success: false, message: `Rollback failed: checkpoint '${cp.id}' is missing its untracked snapshot; workspace was not changed` };\n+          try {\n+            this.assertUntrackedSnapshotSafe(cp.untrackedFiles, cp.snapshotDir, cp.allowSensitive === true);\n+            this.assertUntrackedDestinationSafe(cp.untrackedFiles, this.workspace);\n+          } catch (error) {\n+            if (error instanceof Error && error.message === NESTED_GIT_REPOSITORY_ERROR) {\n+              return { success: false, message: `Rollback failed: checkpoint '${cp.id}' has a destination in a nested Git repository; workspace was not changed` };\n+            }\n+            return { success: false, message: `Rollback failed: checkpoint '${cp.id}' has an unsafe untracked snapshot or destination; workspace was not changed` };\n+          }\n+        }\n+        // Validate every path that restore may write or remove before read-tree\n+        // mutates the outer index. Tracked deletions are destructive too: they\n+        // must not cross into nested repositories in the current worktree.\n+        this.assertNoNestedGitRepositoryAncestors(writePaths, this.workspace);\n+        // Tracked deletion cleanup intentionally leaves targets behind when a\n+        // parent symlink resolves outside the workspace. Preserve that behavior\n+        // while still rejecting a nested repository reachable within the tree.\n+        this.assertNoNestedGitRepositoryAncestors(removalPaths, this.workspace, true);\n+        if (cp.untrackedFiles !== undefined) {\n+          const replacementTargets = [...new Set([...cp.untrackedFiles, ...checkoutPaths])];\n+          this.assertGitSnapshotTargetsReplaceable(replacementTargets, cp.gitRef);\n+        }\n+        if (cp.untrackedFiles === undefined) this.assertLegacyUntrackedRestoreSafe(cp.gitRef);\n+        this.assertNoActiveGitOperation();\n+        this.restoreGitIndex(cp.gitRef, hookGuardEnv);\n+        // Remove checkpoint-deleted paths while their current ancestors are still\n+        // present. Installing checkpoint symlinks first could redirect deletion\n+        // through an in-workspace link into unrelated ignored data.\n+        this.removeTrackedDeletions(cp.gitRef, postCheckpointAdditions);\n+        // Use literal index paths from the checkpoint tree. checkout-index does\n+        // not accept directory pathspecs, and an all-index checkout would overwrite\n+        // sibling worktree content in repositories with nested workspaces.\n+        if (checkoutPaths.length > 0) {\n+          const checkoutInput = Buffer.from(checkoutPaths.map((filePath) => `${filePath}\\0`).join(\"\"), \"utf8\");\n+          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"checkout-index\", \"-f\", \"-q\", \"-z\", \"--stdin\"], {\n+            cwd: this.workspace,\n+            input: checkoutInput,\n+            stdio: [\"pipe\", \"ignore\", \"ignore\"],\n+            env: hookGuardEnv,\n+          });\n+        }\n+        if (cp.untrackedFiles !== undefined) {\n+          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"clean\", \"-fd\"], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n+          if (cp.untrackedFiles.length > 0) {\n+            this.copyUntrackedEntries(cp.untrackedFiles, cp.snapshotDir!, this.workspace, cp.allowSensitive === true, cp.untrackedFileModes);\n+          }\n+          return { success: true, message: `Restored workspace to checkpoint '${cp.name}' (${cp.id})` };\n+        }\n+        return { success: true, message: `Restored tracked workspace to checkpoint '${cp.name}' (${cp.id}); legacy untracked files were not captured and were left unchanged` };\n       }\n \n-      if (cp.snapshotDir && fs.existsSync(cp.snapshotDir)) {\n-        this.copyDirFiltered(cp.snapshotDir, this.workspace);\n+      if (cp.snapshotDir && cp.untrackedFiles !== undefined) {\n+        try {\n+          this.assertUntrackedSnapshotSafe(cp.untrackedFiles, cp.snapshotDir, cp.allowSensitive === true);\n+          this.assertUntrackedDestinationSafe([...cp.untrackedFiles, ...this.workspaceSnapshotPaths(this.workspace)], this.workspace);\n+          this.assertSnapshotTargetsReplaceable(cp.untrackedFiles);\n+        } catch {\n+          return { success: false, message: `Rollback failed: checkpoint '${cp.id}' has an incomplete or unsafe snapshot or destination; workspace was not changed` };\n+        }\n+        this.removeNonSnapshotEntries(cp.untrackedFiles);\n+        this.copyUntrackedEntries(cp.untrackedFiles, cp.snapshotDir, this.workspace, cp.allowSensitive === true, cp.untrackedFileModes);\n         return { success: true, message: `Restored workspace files from snapshot '${cp.name}' (${cp.id})` };\n       }\n \n+      if (cp.snapshotDir && fs.existsSync(cp.snapshotDir)) {\n+        const snapshotFiles = this.workspaceSnapshotPaths(cp.snapshotDir);\n+        const snapshotDirectories = this.workspaceSnapshotDirectories(cp.snapshotDir);\n+        this.assertUntrackedSnapshotSafe(snapshotFiles, cp.snapshotDir, cp.allowSensitive === true);\n+        if (!cp.allowSensitive) {\n+          for (const relativePath of snapshotDirectories) this.assertSnapshotTextSafe(relativePath);\n+        }\n+        this.assertUntrackedDestinationSafe([...snapshotFiles, ...snapshotDirectories], this.workspace);\n+        this.copyDirFiltered(cp.snapshotDir, this.workspace, cp.allowSensitive === true);\n+        return { success: true, message: `Restored workspace files from legacy snapshot '${cp.name}' (${cp.id}); other entries were left unchanged` };\n+      }\n+\n       return { success: false, message: `Cannot restore checkpoint: no valid snapshot recorded.` };\n     } catch (err: any) {\n       return { success: false, message: `Rollback failed: ${err.message}` };\n    const desc = redactForPersistence(name || `Checkpoint at ${new Date().toLocaleTimeString()}`);\n    const timestamp = new Date().toISOString();\n\n    let gitRef: string | undefined;\n    let snapshotDir: string | undefined;\n    let untrackedPaths: string[] = [];\n    let untrackedFileModes: Record<string, number> = {};\n\n    if (this.isGit) {\n      try {\n        this.assertGitIndexUnlocked();\n        this.assertGitChangesSafe(allowSensitive);\n        untrackedPaths = this.gitUntrackedPaths();\n        this.assertUntrackedEntriesSafe(untrackedPaths, this.workspace, allowSensitive);\n        untrackedFileModes = this.captureUntrackedFileModes(untrackedPaths, this.workspace);\n        // Create an untracked + tracked git stash commit without modifying working tree\n        // Clean/smudge filter drivers (filter.* selected through .gitattributes) can still run external\n        // programs here and during restore; Git offers no single override for them, and refusing to\n        // checkpoint whenever a filter is configured would break Git LFS. Recorded as a known limitation\n        // in docs/reviews/evidence/v1/DEFECT-CHECKPOINT-GIT-HOOKS-20261026/README.md.\n        // Config-declared hooks (Git 2.54+) ignore core.hooksPath; disable the events these\n        // commands can raise while keeping traditional hooks off with the argv override.\n        const hookGuardEnv = envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\", \"post-index-change\"]);\n        const stashCommit = execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"stash\", \"create\"], { cwd: this.workspace, encoding: \"utf-8\", env: hookGuardEnv }).trim();\n        if (stashCommit) {\n          // Catch a Git operation that began during validation or stash creation.\n          // This is a point-in-time guard; Git exposes no atomic lock spanning\n          // stash creation and publication of this separate checkpoint ref.\n          this.assertGitIndexUnlocked();\n          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", `refs/nexus/checkpoints/${id}`, stashCommit], {\n            cwd: this.workspace,\n            stdio: \"ignore\",\n            env: hookGuardEnv,\n          });\n          gitRef = stashCommit;\n        } else {\n          // Working tree was clean; record HEAD\n          const headCommit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: this.workspace, encoding: \"utf-8\" }).trim();\n          this.assertGitIndexUnlocked();\n          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", `refs/nexus/checkpoints/${id}`, headCommit], {\n            cwd: this.workspace,\n            stdio: \"ignore\",\n            env: hookGuardEnv,\n          });\n          gitRef = headCommit;\n        }\n      } catch (error) {\n        if (\n          error instanceof SensitivePersistenceError ||\n          error instanceof GitIndexLockError ||\n          error instanceof GitIndexLockCheckError ||\n          error instanceof GitPathEncodingError\n        ) throw error;\n        if (this.gitIndexLockExists()) throw new GitIndexLockError();\n        throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n      }\n    }\n\n    if (untrackedPaths.length > 0 || !gitRef) {\n      const snapTarget = path.join(this.checkpointDir, \"snapshots\", id);\n      try {\n        if (gitRef) {\n          this.copyUntrackedEntries(untrackedPaths, this.workspace, snapTarget, allowSensitive);\n        } else {\n          untrackedPaths = this.workspaceSnapshotPaths(this.workspace);\n          this.assertUntrackedEntriesSafe(untrackedPaths, this.workspace, allowSensitive);\n          untrackedFileModes = this.captureUntrackedFileModes(untrackedPaths, this.workspace);\n          this.copyUntrackedEntries(untrackedPaths, this.workspace, snapTarget, allowSensitive);\n        }\n        snapshotDir = snapTarget;\n      } catch (error) {\n    git(\"rm\", \"--cached\", \"-q\", \"deleted.txt\");\n    fs.writeFileSync(path.join(repo, \"deleted.txt\"), \"untracked canary\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked|collision/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"deleted.txt\"), \"utf8\"), \"untracked canary\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git restore removes a directory replacing a checkpoint-deleted file\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"deleted.txt\"), \"base\\n\");\n    git(\"add\", \"deleted.txt\");\n    git(\"commit\", \"-qm\", \"add deleted file\");\n    fs.rmSync(path.join(repo, \"deleted.txt\"));\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"directory replaces deleted file\");\n    fs.mkdirSync(path.join(repo, \"deleted.txt\"));\n    fs.writeFileSync(path.join(repo, \"deleted.txt\", \"created-later.txt\"), \"remove me\\n\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"after checkpoint\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.existsSync(path.join(repo, \"deleted.txt\")), false);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"base\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git restore preserves ignored entries inside a directory replacing a checkpoint-deleted file\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \".gitignore\"), \"/deleted.txt/\\n\");\n    fs.writeFileSync(path.join(repo, \"deleted.txt\"), \"base\\n\");\n    git(\"add\", \".gitignore\", \"deleted.txt\");\n    git(\"commit\", \"-qm\", \"add ignored deletion target\");\n    fs.rmSync(path.join(repo, \"deleted.txt\"));\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"ignored directory deletion collision\");\n    fs.mkdirSync(path.join(repo, \"deleted.txt\"));\n    fs.writeFileSync(path.join(repo, \"deleted.txt\", \"ignored.txt\"), \"preserve me\\n\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"after checkpoint\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"deleted.txt\", \"ignored.txt\"), \"utf8\"), \"preserve me\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"base\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy Git restore rejects an uncaptured directory replacing a checkpoint-deleted file before mutation\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"deleted.txt\"), \"base\\n\");\n    git(\"add\", \"deleted.txt\");\n    git(\"commit\", \"-qm\", \"add deleted file\");\n    fs.rmSync(path.join(repo, \"deleted.txt\"));\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy directory deletion collision\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    fs.mkdirSync(path.join(repo, \"deleted.txt\"));\n    fs.writeFileSync(path.join(repo, \"deleted.txt\", \"uncaptured.txt\"), \"preserve me\\n\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"after checkpoint\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked|collision/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"deleted.txt\", \"uncaptured.txt\"), \"utf8\"), \"preserve me\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"after checkpoint\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy non-Git restore refuses an empty-directory destination parent symlink\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-legacy-empty-dir-\"));\n  const external = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-legacy-empty-external-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"captured.txt\"), \"captured\\n\");\n    const checkpoint = manager.createCheckpoint(\"legacy empty directory destination\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    fs.mkdirSync(path.join(checkpoint.snapshotDir!, \"alias\", \"newdir\"), { recursive: true });\n    fs.symlinkSync(external, path.join(workspace, \"alias\"));\n    fs.writeFileSync(path.join(workspace, \"workspace.txt\"), \"workspace canary\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe/i);\n    assert.equal(fs.existsSync(path.join(external, \"newdir\")), false);\n    assert.equal(fs.readFileSync(path.join(workspace, \"workspace.txt\"), \"utf8\"), \"workspace canary\\n\");\n    assert.equal(fs.readlinkSync(path.join(workspace, \"alias\")), external);\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n    fs.rmSync(external, { recursive: true, force: true });\n  }\n});\n\ntest(\"legacy Git restore refuses an ignored untracked checkout collision\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy ignored checkout collision\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    git(\"rm\", \"--cached\", \"-q\", \"tracked.txt\");\n    fs.writeFileSync(path.join(repo, \".gitignore\"), \"/tracked.txt\\n\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"ignored untracked canary\\n\");\n    assert.equal(git(\"check-ignore\", \"tracked.txt\"), \"tracked.txt\");\n    const head = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked|collision/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"ignored untracked canary\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy Git restore refuses an ignored untracked tracked-deletion collision\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"deleted.txt\"), \"base\\n\");\n    git(\"add\", \"deleted.txt\");\n    git(\"commit\", \"-qm\", \"add deleted file\");\n    fs.rmSync(path.join(repo, \"deleted.txt\"));\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy ignored deletion collision\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    del