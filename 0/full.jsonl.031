".nexus\", \"checkpoints\", checkpointKey), { recursive: true, force: true });\n  fs.rmSync(repo, { recursive: true, force: true });\n}\n\ntest(\"Git restore preserves untracked work and HEAD while removing post-checkpoint files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"pre-existing user work\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"preserve work\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"after checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"created-later.txt\"), \"remove me\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"at checkpoint\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"pre-existing user work\\n\");\n    assert.equal(fs.existsSync(path.join(repo, \"created-later.txt\")), false);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"checkpoint safety checks preserve a repository root ending in carriage return\", { skip: process.platform === \"win32\" }, () => {\n  const normalRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-cr-root-\"));\n  const repo = `${normalRoot}\\r`;\n  fs.renameSync(normalRoot, repo);\n  fs.mkdirSync(normalRoot);\n  const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: repo, encoding: \"utf8\" }).trim();\n  try {\n    git(\"init\", \"-q\");\n    git(\"config\", \"user.email\", \"test@example.invalid\");\n    git(\"config\", \"user.name\", \"Test\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"base\\n\");\n    git(\"add\", \"tracked.txt\");\n    git(\"commit\", \"-qm\", \"base\");\n\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    })).map((entry) => entry.toString(\"utf8\"));\n    if (changedPaths.some((relativePath) => path.basename(relativePath) === \".gitignore\")) {\n      throw new Error(\"Checkpoint Git ignore rules differ from the current worktree\");\n    }\n\n    for (const relativePath of directoryTargets) {\n      // A clean preview can be empty when the directory path is also tracked in the index,\n      // even though ordinary untracked children beneath it are removable.\n      if (this.directoryContainsOnlyGitCleanRemovableEntries(relativePath)\n        && this.gitTrackedDescendantPaths(relativePath).length === 0) {\n        continue;\n      }\n      if (!this.directoryContainsOnlyTrackedRemovableEntries(relativePath)) {\n        throw new Error(\"Checkpoint snapshot target directory contains entries preserved by Git clean\");\n      }\n    }\n  }\n\n  /** Tracked file entries that checkout-index may recreate from this checkpoint tree. Gitlinks are not blobs. */\n  private gitRefBlobPaths(gitRef: string): string[] {\n    const entries = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"ls-tree\", \"-r\", \"-z\", \"--full-tree\", gitRef], {\n      cwd: this.workspace,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    }));\n\n    const paths: string[] = [];\n    for (const rawEntry of entries) {\n      const entry = rawEntry.toString(\"utf8\");\n      const separator = entry.indexOf(\"\\t\");\n      if (separator < 0) throw new Error(\"Could not parse checkpoint Git tree entry\");\n      const objectType = entry.slice(0, separator).split(\" \")[1];\n      if (objectType === \"blob\") {\n        const relativePath = this.workspaceRelativeGitPath(entry.slice(separator + 1));\n        if (relativePath) paths.push(relativePath);\n      }\n    }\n    return paths;\n  }\n\n  private directoryContainsOnlyGitCleanRemovableEntries(relativePath: string): boolean {\n    const root = path.join(this.workspace, relativePath);\n    const visit = (directory: string, relative: string): boolean => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        const child = relative ? `${relative}/${entry.name}` : entry.name;\n        if (entry.name === \".git\") return false;\n        const fullPath = path.join(directory, entry.name);\n        if (entry.isDirectory()) {\n          try {\n            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `./${relativePath}/${child}`], {\n              cwd: this.workspace,\n              stdio: \"ignore\",\n            });\n            return false;\n          } catch (error) {\n            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n          }\n          if (!visit(fullPath, child)) return false;\n        } else if (entry.isFile() || entry.isSymbolicLink()) {\n          try {\n            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `./${relativePath}/${child}`], {\n              cwd: this.workspace,\n              stdio: \"ignore\",\n            });\n            return false;\n          } catch (error) {\n            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n          }\n        } else {\n          return false;\n        }\n      }\n      return true;\n    };\n    return visit(root, \"\");\n  }\n\n  private gitTrackedDescendantPaths(relativePath: string): string[] {\n    return gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"ls-files\", \"--cached\", \"-z\", \"--\", `:(literal)${relativePath}`], {\n      cwd: this.workspace,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    })).map((entry) => entry.toString(\"utf8\")).filter((entry) => entry.startsWith(`${relativePath}/`));\n  }\n\n  private directoryContainsOnlyTrackedRemovableEntries(relativePath: string): boolean {\n    const root = path.join(this.workspace, relativePath);\n    const diskEntries: string[] = [];\n    const visit = (directory: string, relative: string): boolean => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        const child = relative ? `${relative}/${entry.name}` : entry.name;\n        const fullPath = path.join(directory, entry.name);\n        if (entry.name === \".git\") return false;\n        if (entry.isDirectory()) {\n          try {\n            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `./${relativePath}/${child}`], {\n              cwd: this.workspace,\n              stdio: \"ignore\",\n            });\n            return false;\n          } catch (error) {\n            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n          }\n          if (!visit(fullPath, child)) return false;\n        } else if (entry.isFile() || entry.isSymbolicLink()) {\n          diskEntries.push(`${relativePath}/${child}`);\n        } else {\n          return false;\n        }\n      }\n      return true;\n    };\n\n    if (!visit(root, \"\")) return false;\n    if (diskEntries.length === 0) return false;\n    const trackedEntries = this.gitTrackedDescendantPaths(relativePath);\n    const tracked = new Set(trackedEntries);\n    if (diskEntries.length !== tracked.size || diskEntries.some((entry) => !tracked.has(entry))) return false;\n\n    for (const entry of diskEntries) {\n      try {\n        execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `./${entry}`], {\n          cwd: this.workspace,\n          stdio: \"ignore\",\n        });\n        return false;\n      } catch (error) {\n        if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n      }\n## HEAD (no branch)\n1482d6b315129cd46fac61242c2eb91793ed8fd2\n87b560c7e581fa71cce270474ba40766f372fb04\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18336-b174-72a1-9e58-590be19b8235","create_time":1793208951.2337947}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
