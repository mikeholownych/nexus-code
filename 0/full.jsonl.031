ef: string): string[] {\n667:    const paths = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--no-renames\", \"--name-only\", \"--diff-filter=D\", \"-z\", \"HEAD\", gitRef], {\n679:  private trackedPathsAddedSince(gitRef: string): string[] {\n680:    const committed = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--no-renames\", \"--name-only\", \"--diff-filter=A\", \"-z\", gitRef, \"HEAD\"], {\n688:    const staged = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff-index\", \"--cached\", \"--no-renames\", \"--name-only\", \"--diff-filter=A\", \"-z\", gitRef], {\n752:  private assertGitSnapshotTargetsReplaceable(relativePaths: string[], gitRef: string): void {\n758:    const changedPaths = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--no-renames\", \"--name-only\", \"-z\", gitRef, \"--\"], {\n781:  private gitRefBlobPaths(gitRef: string): string[] {\n782:    const entries = gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"ls-tree\", \"-r\", \"-z\", \"--full-tree\", gitRef], {\n916:  public createCheckpoint(name?: string, options: { allowSensitive?: boolean } = {}): CheckpointInfo {\n923:    let gitRef: string | undefined;\n954:          gitRef = stashCommit;\n964:          gitRef = headCommit;\n978:    if (untrackedPaths.length > 0 || !gitRef) {\n981:        if (gitRef) {\n993:          if (gitRef) execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", \"-d\", `refs/nexus/checkpoints/${id}`], { cwd: this.workspace, stdio: \"ignore\", env: envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\"]) });\n1004:      gitRef,\n1056:    if (typeof raw.gitRef === \"string\" && /^[0-9a-f]{7,64}$/i.test(raw.gitRef)) checkpoint.gitRef = raw.gitRef;\n1113:    if (this.isGit && cpTarget.gitRef) {\n1117:          if (!cpBase || !cpBase.gitRef) {\n1120:          const out = execFileSy