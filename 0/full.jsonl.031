{"timestamp":"2026-10-28T17:37:32.091Z","ordinal":457695,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","item":{"type":"CommandExecution","id":"exec-431132c3-b96e-4d18-ab8d-7dc9db6982f9","process_id":"68878","command":["/usr/bin/zsh","-lc","sed -n '1048,1095p' cli/src/checkpoint.ts; git diff -- cli/test/checkpoint_restore.test.ts"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"unknown","cmd":"sed -n '1048,1095p' cli/src/checkpoint.ts; git diff -- cli/test/checkpoint_restore.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    if (typeof raw.name !== \"string\" || typeof raw.timestamp !== \"string\") return null;\n    // The name and timestamp are printed by the checkpoint commands; state-file text must not\n    // inject terminal escapes.\n    const control = /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/g;\n    const name = raw.name.replace(control, \"\");\n    const timestamp = raw.timestamp.replace(control, \"\");\n    const checkpoint: CheckpointInfo = { id: raw.id, name, timestamp };\n    if (typeof raw.workspace === \"string\") checkpoint.workspace = raw.workspace;\n    if (typeof raw.gitRef === \"string\" && /^[0-9a-f]{7,64}$/i.test(raw.gitRef)) checkpoint.gitRef = raw.gitRef;\n    const snapshotDir = this.confinedSnapshotDir(raw.id, raw.snapshotDir);\n    if (snapshotDir) checkpoint.snapshotDir = snapshotDir;\n    if (raw.allowSensitive === true) checkpoint.allowSensitive = true;\n    if (raw.untrackedFiles !== undefined) {\n      if (!Array.isArray(raw.untrackedFiles) || !raw.untrackedFiles.every((entry: any) =>\n        typeof entry === \"string\" && entry.length > 0 && !entry.includes(\"\\0\") && !entry.startsWith(\"/\") &&\n        !/^[A-Za-z]:/.test(entry) && path.posix.normalize(entry) === entry && entry !== \"..\" &&\n        !entry.startsWith(\"../\") && !entry.split(\"/\").includes(\".git\"),\n      )) return null;\n      checkpoint.untrackedFiles = [...new Set<string>(raw.untrackedFiles)];\n    }\n    if (raw.untrackedFileModes !== undefined) {\n      if (!raw.untrackedFileModes || typeof raw.untrackedFileModes !== \"object\" || Array.isArray(raw.untrackedFileModes)) return null;\n      const modes: Record<string, number> = Object.create(null);\n      for (const [filePath, mode] of Object.entries(raw.untrackedFileModes)) {\n        if (!checkpoint.untrackedFiles?.includes(filePath) || !Number.isInteger(mode) || (mode as number) < 0 || (mode as number) > 0o777) return null;\n        modes[filePath] = mode as number;\n      }\n      checkpoint.untrackedFileModes = modes;\n    }\n    if (Array.isArray(raw.files)) checkpoint.files = raw.files;\n    return checkpoint;\n  }\n\n  /** A snapshot is usable only when it resolves under this checkpoint's own snapshots/<id>. */\n  private confinedSnapshotDir(id: string, value: unknown): string | undefined {\n    if (typeof value !== \"string\" || !path.isAbsolute(value)) return undefined;\n    try {\n      const snapshots = path.join(this.checkpointDir, \"snapshots\");\n      const stat = fs.lstatSync(snapshots);\n      if (!stat.isDirectory() || stat.isSymbolicLink()) return undefined;\n      const root = fs.realpathSync(snapshots);\n      const expected = path.join(root, id);\n      const real = fs.realpathSync(value);\n      return real === expected || real.startsWith(expected + path.sep) ? real : undefined;\n    } catch {\n      return undefined;\n    }\n  }\ndiff --git a/cli/test/checkpoint_restore.test.ts b/cli/test/checkpoint_restore.test.ts\nindex 4d58f202..c9679deb 100644\n--- a/cli/test/checkpoint_restore.test.ts\n+++ b/cli/test/checkpoint_restore.test.ts\n@@ -687,6 +687,7 @@ test(\"legacy non-Git restore never deletes entries absent from old metadata\", ()\n     const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n     delete record.untrackedFiles;\n     fs.writeFileSync(recordPath, JSON.stringify(record));\n+    console.error(\"LEGACY_DEBUG\", { checkpoint, record, list: manager.listCheckpoints(), home: os.homedir() });\n     fs.writeFileSync(path.join(workspace, \"b.txt\"), \"must survive legacy restore\\n\");\n     const result = manager.restore(checkpoint.id);\n     assert.equal(result.success, true, result.message);\n","exit_code":0,"duration":{"secs":0,"nanos":842592087}},"started_at_ms":1793209051248,"completed_at_ms":1793209052091}}
