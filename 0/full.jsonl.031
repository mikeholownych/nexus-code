{"timestamp":"2026-10-28T16:37:07.078Z","ordinal":454966,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","item":{"type":"CommandExecution","id":"exec-d1804fdb-88a9-4e8a-9a21-702a0ac9ba77","process_id":"52351","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --stat --oneline b9a986edeeb156802b72d246b67c0f2425d92d9b; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --format=fuller --no-ext-diff b9a986edeeb156802b72d246b67c0f2425d92d9b --"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --stat --oneline b9a986edeeb156802b72d246b67c0f2425d92d9b; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --format=fuller --no-ext-diff b9a986edeeb156802b72d246b67c0f2425d92d9b --"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"b9a986ed fix(checkpoint): detect nested git directories with Git\n cli/src/checkpoint.ts               | 91 +++++++++++++++++++------------------\n cli/test/checkpoint_restore.test.ts | 64 ++++++++++++++------------\n 2 files changed, 82 insertions(+), 73 deletions(-)\ncommit b9a986edeeb156802b72d246b67c0f2425d92d9b\nAuthor:     Mike Holownych <mike@holownych.com>\nAuthorDate: Wed Oct 28 16:36:01 2026 +0000\nCommit:     Mike Holownych <mike@holownych.com>\nCommitDate: Wed Oct 28 16:36:01 2026 +0000\n\n    fix(checkpoint): detect nested git directories with Git\n\ndiff --git a/cli/src/checkpoint.ts b/cli/src/checkpoint.ts\nindex ca67927e..6253a055 100644\n--- a/cli/src/checkpoint.ts\n+++ b/cli/src/checkpoint.ts\n@@ -310,6 +310,10 @@ export class CheckpointManager {\n     allowExternalSymlinkAncestors = false,\n   ): void {\n     const root = fs.realpathSync(targetRoot);\n+    const gitProbeEnv = { ...process.env };\n+    for (const key of Object.keys(gitProbeEnv)) {\n+      if (key.startsWith(\"GIT_\")) delete gitProbeEnv[key];\n+    }\n     for (const relativePath of relativePaths) {\n       const destination = path.resolve(root, relativePath);\n       const relativeDestination = path.relative(root, destination);\n@@ -348,58 +352,55 @@ export class CheckpointManager {\n         const bareHead = fs.lstatSync(path.join(parent, \"HEAD\"), { throwIfNoEntry: false });\n         const bareConfigPath = path.join(parent, \"config\");\n         const bareConfig = fs.lstatSync(bareConfigPath, { throwIfNoEntry: false });\n-        const bareObjects = fs.lstatSync(path.join(parent, \"objects\"), { throwIfNoEntry: false });\n-        const bareRefs = fs.lstatSync(path.join(parent, \"refs\"), { throwIfNoEntry: false });\n-        const bareRepositoryMarkerCount = [bareHead, bareObjects, bareRefs].filter(Boolean).length;\n-        const hasBareRepositoryMarkers = bareRepositoryMarkerCount > 0;\n-        // Two names are not enough to identify a bare repository: ordinary\n-        // projects commonly have directories named `objects` and `refs`.\n-        // Require the full HEAD/objects/refs marker set before treating a\n-        // missing config as an ambiguous repository layout.\n-        const hasBareRepositoryShape = bareRepositoryMarkerCount === 3;\n-        if (hasBareRepositoryMarkers && bareConfig && (\n-          (bareHead && (!bareHead.isFile() || bareHead.isSymbolicLink()))\n-          || (bareObjects && (!bareObjects.isDirectory() || bareObjects.isSymbolicLink()))\n-          || (bareRefs && (!bareRefs.isDirectory() || bareRefs.isSymbolicLink()))\n-          || !bareConfig.isFile() || bareConfig.isSymbolicLink()\n-        )) {\n-          throw new Error(\"Checkpoint destination has an ambiguous bare Git repository layout\");\n+        if (dotGit) {\n+          throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n         }\n-        if (hasBareRepositoryShape && !bareConfig) {\n-          throw new Error(\"Checkpoint destination has an ambiguous bare Git repository layout\");\n+\n+        // A bare repository root requires HEAD. The Git probe distinguishes a\n+        // real repository from ordinary project folders named `objects`/`refs`.\n+        const hasGitDirectoryMarkers = !!bareHead;\n+        if (hasGitDirectoryMarkers) {\n+          try {\n+            const discoveredGitDir = execFileSync(\"git\", [\"-C\", parent, \"rev-parse\", \"--absolute-git-dir\"], {\n+              cwd: root,\n+              encoding: \"utf8\",\n+              env: gitProbeEnv,\n+              maxBuffer: 1024 * 1024,\n+              stdio: [\"ignore\", \"pipe\", \"ignore\"],\n+            }).trim();\n+            if (fs.realpathSync(discoveredGitDir) === fs.realpathSync(parent)) {\n+              throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n+            }\n+          } catch (error) {\n+            if (error instanceof Error && error.message === \"Checkpoint destination parent is a nested Git repository\") throw error;\n+            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 128) {\n+              throw new Error(\"Checkpoint could not verify nested Git repository state\");\n+            }\n+          }\n         }\n-        const hasBareRepositoryLayout = hasBareRepositoryMarkers && !!bareConfig && bareConfig.isFile() && !bareConfig.isSymbolicLink();\n-        let declaresBareRepository = false;\n-        if (hasBareRepositoryLayout && bareConfig) {\n-          if (bareConfig.size > 1024 * 1024) {\n+\n+        const bareConfigStat = bareConfig ? fs.statSync(bareConfigPath, { throwIfNoEntry: false }) : undefined;\n+        if (hasGitDirectoryMarkers && bareConfigStat?.isFile()) {\n+          if (bareConfigStat.size > 1024 * 1024) {\n             throw new Error(\"Checkpoint destination has an oversized Git configuration\");\n           }\n-          let inCoreSection = false;\n-          for (const line of fs.readFileSync(bareConfigPath, \"utf8\").split(/\\r?\\n/)) {\n-            const entry = line.replace(/[;#].*$/, \"\").trim();\n-            if (/\\\\\\s*$/.test(entry)) {\n-              // Git joins continued values across lines; this parser intentionally\n-              // does not emulate that syntax, so reject it rather than miss core.bare.\n-              throw new Error(\"Checkpoint destination Git configuration uses line continuations\");\n-            }\n-            if (/^\\[\\s*include(?:if)?(?:\\s|\\])/i.test(entry)) {\n-              // An include may change core.bare after this file is parsed. Do not\n-              // try to partially reproduce Git's includeIf matching here.\n-              throw new Error(\"Checkpoint destination Git configuration uses includes\");\n-            }\n-            if (/^\\[\\s*core\\s*\\]$/i.test(entry)) {\n-              inCoreSection = true;\n-            } else if (/^\\[/.test(entry)) {\n-              inCoreSection = false;\n-            } else if (inCoreSection && /^bare\\s*(?:=\\s*(?:true|yes|on|1|\"true\"|\"yes\"|\"on\"|\"1\"))?$/i.test(entry)) {\n-              declaresBareRepository = true;\n-              break;\n+          try {\n+            const configuredBare = execFileSync(\"git\", [\"config\", \"--file\", bareConfigPath, \"--includes\", \"--type=bool\", \"--get\", \"core.bare\"], {\n+              cwd: root,\n+              encoding: \"utf8\",\n+              env: gitProbeEnv,\n+              maxBuffer: 1024 * 1024,\n+              stdio: [\"ignore\", \"pipe\", \"ignore\"],\n+            }).trim();\n+            if (configuredBare === \"true\") {\n+              throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n             }\n+          } catch (error) {\n+            const status = (error as NodeJS.ErrnoException & { status?: number })?.status;\n+            if (error instanceof Error && error.message === \"Checkpoint destination parent is a nested Git repository\") throw error;\n+            if (status !== 1) throw new Error(\"Checkpoint destination has an invalid Git configuration\");\n           }\n         }\n-        if (dotGit || declaresBareRepository) {\n-          throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n-        }\n       }\n     }\n   }\ndiff --git a/cli/test/checkpoint_restore.test.ts b/cli/test/checkpoint_restore.test.ts\nindex e7c87efe..180c6493 100644\n--- a/cli/test/checkpoint_restore.test.ts\n+++ b/cli/test/checkpoint_restore.test.ts\n@@ -1237,37 +1237,45 @@ test(\"Git manifest restore refuses to copy an untracked file into a nested bare\n   }\n });\n \n-test(\"Git manifest restore refuses an exact bare-repository destination before changing the outer index\", () => {\n-  const { repo, git } = gitRepo();\n-  const destination = path.join(repo, \"replace-me\");\n-  try {\n-    fs.writeFileSync(destination, \"checkpoint file\\n\");\n-    const manager = new CheckpointManager(repo);\n-    const checkpoint = manager.createCheckpoint(\"bare repository exact destination\");\n+for (const coreBare of [\"false\", \"unset\"] as const) {\n+  test(`Git manifest restore refuses an exact nested Git directory with core.bare=${coreBare}`, () => {\n+    const { repo, git } = gitRepo();\n+    const destination = path.join(repo, \"replace-me\");\n+    try {\n+      fs.writeFileSync(destination, \"checkpoint file\\n\");\n+      const manager = new CheckpointManager(repo);\n+      const checkpoint = manager.createCheckpoint(\"bare repository exact destination\");\n \n-    fs.rmSync(destination);\n-    execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", destination]);\n-    fs.writeFileSync(path.join(destination, \"repository-canary.txt\"), \"bare repository canary\\n\");\n-    fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n-    git(\"add\", \"staged-after-checkpoint.txt\");\n-    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n-    const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n+      fs.rmSync(destination);\n+      execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", destination]);\n+      if (coreBare === \"false\") {\n+        execFileSync(\"git\", [\"--git-dir\", destination, \"config\", \"core.bare\", \"false\"]);\n+      } else {\n+        execFileSync(\"git\", [\"--git-dir\", destination, \"config\", \"--unset\", \"core.bare\"]);\n+      }\n+      fs.writeFileSync(path.join(destination, \"repository-canary.txt\"), \"bare repository canary\\n\");\n+      fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n+      git(\"add\", \"staged-after-checkpoint.txt\");\n+      const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n+      const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n \n-    const result = manager.restore(checkpoint.id);\n+      const result = manager.restore(checkpoint.id);\n \n-    assert.equal(result.success, false);\n-    assert.match(result.message, /nested Git repository|destination|unsafe/i);\n-    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n-    const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n-    assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve the outer index\");\n-    assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n-    assert.equal(fs.readFileSync(path.join(destination, \"repository-canary.txt\"), \"utf8\"), \"bare repository canary\\n\");\n-    assert.equal(execFileSync(\"git\", [\"-C\", destination, \"rev-parse\", \"--is-bare-repository\"], { encoding: \"utf8\" }).trim(), \"true\");\n-    assert.equal(fs.existsSync(path.join(destination, \"captured.txt\")), false, \"rejection must not copy checkpoint data into the repository\");\n-  } finally {\n-    cleanupGitRepo(repo);\n-  }\n-});\n+      assert.equal(result.success, false);\n+      assert.match(result.message, /nested Git repository|destination|unsafe/i);\n+      assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n+      const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n+      assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve the outer index\");\n+      assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n+      assert.equal(fs.readFileSync(path.join(destination, \"repository-canary.txt\"), \"utf8\"), \"bare repository canary\\n\");\n+      assert.equal(execFileSync(\"git\", [\"-C\", destination, \"rev-parse\", \"--absolute-git-dir\"], { encoding: \"utf8\" }).trim(), destination);\n+      assert.equal(execFileSync(\"git\", [\"-C\", destination, \"rev-parse\", \"--is-bare-repository\"], { encoding: \"utf8\" }).trim(), coreBare === \"false\" ? \"false\" : \"true\");\n+      assert.equal(fs.existsSync(path.join(destination, \"captured.txt\")), false, \"rejection must not copy checkpoint data into the repository\");\n+    } finally {\n+      cleanupGitRepo(repo);\n+    }\n+  });\n+}\n \n test(\"Git manifest restore refuses a nested bare repository with a symlinked config\", () => {\n   const { repo, git } = gitRepo();\n","exit_code":0,"duration":{"secs":0,"nanos":27079}},"started_at_ms":1793205427077,"completed_at_ms":1793205427077}}
{"timestamp":"2026-10-28T16:37:09.011Z","ordinal":454967,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1835f-6313-79f3-bcac-800d8b07a474","call_id":"call_d29319e2bc7049549861c8f6ab25487a","output":[{"type":"input_text","text":"Script completed\nWall time 3.2 seconds\nOutput:\n"},{"type":"input_text","text":"b9a986ed fix(checkpoint): detect nested git directories with Git\n cli/src/checkpoint.ts               | 91 +++++++++++++++++++------------------\n cli/test/checkpoint_restore.test.ts | 64 ++++++++++++++------------\n 2 files changed, 82 insertions(+), 73 deletions(-)\ncommit b9a986edeeb156802b72d246b67c0f2425d92d9b\nAuthor:     Mike Holownych <mike@holownych.com>\nAuthorDate: Wed Oct 28 16:36:01 2026 +0000\nCommit:     Mike Holownych <mike@holownych.com>\nCommitDate: Wed Oct 28 16:36:01 2026 +0000\n\n    fix(checkpoint): detect nested git directories with Git\n\ndiff --git a/cli/src/checkpoint.ts b/cli/src/checkpoint.ts\nindex ca67927e..6253a055 100644\n--- a/cli/src/checkpoint.ts\n+++ b/cli/src/checkpoint.ts\n@@ -310,6 +310,10 @@ export class CheckpointManager {\n     allowExternalSymlinkAncestors = false,\n   ): void {\n     const root = fs.realpathSync(targetRoot);\n+    const gitProbeEnv = { ...process.env };\n+    for (const key of Object.keys(gitProbeEnv)) {\n+      if (key.startsWith(\"GIT_\")) delete gitProbeEnv[key];\n+    }\n     for (const relativePath of relativePaths) {\n       const destination = path.resolve(root, relativePath);\n       const relativeDestination = path.relative(root, destination);\n@@ -348,58 +352,55 @@ export class CheckpointManager {\n         const bareHead = fs.lstatSync(path.join(parent, \"HEAD\"), { throwIfNoEntry: false });\n         const bareConfigPath = path.join(parent, \"config\");\n         const bareConfig = fs.lstatSync(bareConfigPath, { throwIfNoEntry: false });\n-        const bareObjects = fs.lstatSync(path.join(parent, \"objects\"), { throwIfNoEntry: false });\n-        const bareRefs = fs.lstatSync(path.join(parent, \"refs\"), { throwIfNoEntry: false });\n-        const bareRepositoryMarkerCount = [bareHead, bareObjects, bareRefs].filter(Boolean).length;\n-        const hasBareRepositoryMarkers = bareRepositoryMarkerCount > 0;\n-        // Two names are not enough to identify a bare repository: ordinary\n-        // projects commonly have directories named `objects` and `refs`.\n-        // Require the full HEAD/objects/refs marker set before treating a\n-        // missing config as an ambiguous repository layout.\n-        const hasBareRepositoryShape = bareRepositoryMarkerCount === 3;\n-        if (hasBareRepositoryMarkers && bareConfig && (\n-          (bareHead && (!bareHead.isFile() || bareHead.isSymbolicLink()))\n-          || (bareObjects && (!bareObjects.isDirectory() || bareObjects.isSymbolicLink()))\n-          || (bareRefs && (!bareRefs.isDirectory() || bareRefs.isSymbolicLink()))\n-          || !bareConfig.isFile() || bareConfig.isSymbolicLink()\n-        )) {\n-          throw new Error(\"Checkpoint destination has an ambiguous bare Git repository layout\");\n+        if (dotGit) {\n+          throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n         }\n-        if (hasBareRepositoryShape && !bareConfig) {\n-          throw new Error(\"Checkpoint destination has an ambiguous bare Git repository layout\");\n+\n+        // A bare repository root requires HEAD. The Git probe distinguishes a\n+        // real repository from ordinary project folders named `objects`/`refs`.\n+        const hasGitDirectoryMarkers = !!bareHead;\n+        if (hasGitDirectoryMarkers) {\n+          try {\n+            const discoveredGitDir = execFileSync(\"git\", [\"-C\", parent, \"rev-parse\", \"--absolute-git-dir\"], {\n+              cwd: root,\n+              encoding: \"utf8\",\n+              env: gitProbeEnv,\n+              maxBuffer: 1024 * 1024,\n+              stdio: [\"ignore\", \"pipe\", \"ignore\"],\n+            }).trim();\n+            if (fs.realpathSync(discoveredGitDir) === fs.realpathSync(parent)) {\n+              throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n+            }\n+          } catch (error) {\n+            if (error instanceof Error && error.message === \"Checkpoint destination parent is a nested Git repository\") throw error;\n+            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 128) {\n+              throw new Error(\"Checkpoint could not verify nested Git repository state\");\n+            }\n+          }\n         }\n-        const hasBareRepositoryLayout = hasBareRepositoryMarkers && !!bareConfig && bareConfig.isFile() && !bareConfig.isSymbolicLink();\n-        let declaresBareRepository = false;\n-        if (hasBareRepositoryLayout && bareConfig) {\n-          if (bareConfig.size > 1024 * 1024) {\n+\n+        const bareConfigStat = bareConfig ? fs.statSync(bareConfigPath, { throwIfNoEntry: false }) : undefined;\n+        if (hasGitDirectoryMarkers && bareConfigStat?.isFile()) {\n+          if (bareConfigStat.size > 1024 * 1024) {\n             throw new Error(\"Checkpoint destination has an oversized Git configuration\");\n           }\n-          let inCoreSection = false;\n-          for (const line of fs.readFileSync(bareConfigPath, \"utf8\").split(/\\r?\\n/)) {\n-            const entry = line.replace(/[;#].*$/, \"\").trim();\n-            if (/\\\\\\s*$/.test(entry)) {\n-              // Git joins continued values across lines; this parser intentionally\n-              // does not emulate that syntax, so reject it rather than miss core.bare.\n-              throw new Error(\"Checkpoint destination Git configuration uses line continuations\");\n-            }\n-            if (/^\\[\\s*include(?:if)?(?:\\s|\\])/i.test(entry)) {\n-              // An include may change core.bare after this file is parsed. Do not\n-              // try to partially reproduce Git's includeIf matching here.\n-              throw new Error(\"Checkpoint destination Git configuration uses includes\");\n-            }\n-            if (/^\\[\\s*core\\s*\\]$/i.test(entry)) {\n-              inCoreSection = true;\n-            } else if (/^\\[/.test(entry)) {\n-              inCoreSection = false;\n-            } else if (inCoreSection && /^bare\\s*(?:=\\s*(?:true|yes|on|1|\"true\"|\"yes\"|\"on\"|\"1\"))?$/i.test(entry)) {\n-              declaresBareRepository = true;\n-              break;\n+          try {\n+            const configuredBare = execFileSync(\"git\", [\"config\", \"--file\", bareConfigPath, \"--includes\", \"--type=bool\", \"--get\", \"core.bare\"], {\n+              cwd: root,\n+              encoding: \"utf8\",\n+              env: gitProbeEnv,\n+              maxBuffer: 1024 * 1024,\n+              stdio: [\"ignore\", \"pipe\", \"ignore\"],\n+            }).trim();\n+            if (configuredBare === \"true\") {\n+              throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n             }\n+          } catch (error) {\n+            const status = (error as NodeJS.ErrnoException & { status?: number })?.status;\n+            if (error instanceof Error && error.message === \"Checkpoint destination parent is a nested Git repository\") throw error;\n+            if (status !== 1) throw new Error(\"Checkpoint destination has an invalid Git configuration\");\n           }\n         }\n-        if (dotGit || declaresBareRepository) {\n-          throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n-        }\n       }\n     }\n   }\ndiff --git a/cli/test/checkpoint_restore.test.ts b/cli/test/checkpoint_restore.test.ts\nindex e7c87efe..180c6493 100644\n--- a/cli/test/checkpoint_restore.test.ts\n+++ b/cli/test/checkpoint_restore.test.ts\n@@ -1237,37 +1237,45 @@ test(\"Git manifest restore refuses to copy an untracked file into a nested bare\n   }\n });\n \n-test(\"Git manifest restore refuse