xt\"), \"sibling unstaged work\\n\");\n    fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"subdirectory later work\\n\");\n    git(\"add\", \"sub/tracked.txt\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"sibling unstaged work\\n\");\n    assert.equal(git(\"show\", \":tracked.txt\"), \"sibling staged work\");\n    assert.equal(fs.readFileSync(path.join(workspace, \"tracked.txt\"), \"utf8\"), \"subdirectory base\\n\");\n    assert.equal(git(\"show\", \":sub/tracked.txt\"), \"subdirectory base\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"tracked deletion cleanup runs before a checkpoint symlink can redirect it\", () => {\n  const { repo, git } = gitRepo();\n  const alias = path.join(repo, \"alias\");\n  const data = path.join(repo, \"data\");\n  fs.mkdirSync(alias);\n  fs.writeFileSync(path.join(alias, \"file\"), \"tracked alias file\\n\");\n  fs.mkdirSync(data);\n  fs.writeFileSync(path.join(data, \"file\"), \"ignored data must survive\\n\");\n  fs.writeFileSync(path.join(repo, \".gitignore\"), \"data/\\n\");\n  git(\"add\", \"alias/file\", \".gitignore\");\n  git(\"commit\", \"-qm\", \"tracked alias and ignored data\");\n  const manager = new CheckpointManager(repo);\n  try {\n    fs.rmSync(path.join(alias, \"file\"));\n    fs.rmdirSync(alias);\n    fs.symlinkSync(\"data\", alias);\n    git(\"add\", \"-A\", \"alias\");\n    const checkpoint = manager.createCheckpoint(\"symlink replacement deletion\");\n    git(\"reset\", \"--hard\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.lstatSync(alias).isSymbolicLink(), true);\n    assert.equal(fs.readFileSync(path.join(data, \"file\"), \"utf8\"), \"ignored data must survive\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"manifest restore refuses a regular-file parent before changing tracked or untracked files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.mkdirSync(path.join(repo, \"a\"));\n    const hash = crypto.createHash(\"sha256\").update(this.workspace).digest(\"hex\").slice(0, 12);\n    this.checkpointDir = path.join(os.homedir(), \".nexus\", \"checkpoints\", hash);\n    ensurePrivateDir(this.checkpointDir);\n    this.checkGit();\n  }\n\n  private checkGit(): void {\n    try {\n      execFileSync(\"git\", [\"rev-parse\", \"--is-inside-work-tree\"], { cwd: this.workspace, stdio: \"ignore\" });\n      this.isGit = true;\n    } catch {\n      this.isGit = false;\n    }\n  }\n\n  private gitRoot(): string {\n    if (!this.repositoryRootCache) {\n      this.repositoryRootCache = fs.realpathSync(stripGitLineEnding(execFileSync(\"git\", [\"rev-parse\", \"--show-toplevel\"], {\n        cwd: this.workspace,\n        encoding: \"utf8\",\n      })));\n    }\n    return this.repositoryRootCache;\n  }\n\n  private gitWorkspacePrefix(): string {\n    if (this.workspacePrefixCache === undefined) {\n      const prefix = stripGitLineEnding(execFileSync(\"git\", [\"rev-parse\", \"--show-prefix\"], {\n        cwd: this.workspace,\n        encoding: \"utf8\",\n      }));\n      this.workspacePrefixCache = prefix.replace(/\\\\/g, \"/\");\n    }\n    return this.workspacePrefixCache;\n  }\n\n  private workspaceRelativeGitPath(gitPath: string): string | undefined {\n    const prefix = this.gitWorkspacePrefix();\n    if (!prefix) return gitPath;\n    return gitPath.startsWith(prefix) ? gitPath.slice(prefix.length) : undefined;\n  }\n\n  private captureUntrackedFileModes(relativePaths: string[], sourceRoot: string): Record<string, number> {\n    const modes: Record<string, number> = Object.create(null);\n    for (const relativePath of relativePaths) {\n      const stat = fs.lstatSync(path.join(sourceRoot, relativePath));\n      if (stat.isFile()) modes[relativePath] = stat.mode & 0o777;\n    }\n    return modes;\n  }\n\n  private assertNoActiveGitOperation(): void {\n    const markers = [\"MERGE_HEAD\", \"CHERRY_PICK_HEAD\", \"REVERT_HEAD\", \"rebase-apply\", \"rebase-merge\", \"sequencer\"];\n    for (const marker of markers) {\n      const gitPath = stripGitLineEnding(execFileSync(\"git\", [\"rev-parse\", \"--git-path\", marker], {\n        cwd: this.workspace,\n        encoding: \"utf8\",\n      }));\n      const absolutePath = path.isAbsolute(gitPath) ? gitPath : path.resolve(this.workspace, gitPath);\n      if (lstatOrAbsent(absolutePath)) {\n        throw new Error(\"Checkpoint cannot restore while Git operation state is present; workspace was not changed\");\n      }\n    }\n  }\n\n  private assertNoIgnoredAddedPaths(relativePaths: string[]): void {\n    for (const relativePath of relativePaths) {\n      const target = lstatOrAbsent(path.join(this.workspace, relativePath));\n      // removeTrackedDeletions never removes a directory target, preserving\n      // ignored descendants while the checkpoint's file deletion remains absent.\n      if (target?.isDirectory() && !target.isSymbolicLink()) continue;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18336-b174-72a1-9e58-590be19b8235","create_time":1793209235.5328658}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
