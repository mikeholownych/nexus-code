{"timestamp":"2026-10-28T17:06:36.542Z","ordinal":456276,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18336-b174-72a1-9e58-590be19b8235","item":{"type":"CommandExecution","id":"exec-030db380-844a-47ae-a80e-bf36fbc1cf1c","process_id":"91694","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --stat --oneline --decorate HEAD && git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --format=fuller --no-ext-diff --find-renames HEAD -- cli/src/checkpoint.ts cli/test/checkpoint_restore.test.ts | sed -n '1,220p'; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix status --porcelain=v2 --branch; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix rev-parse origin/v1/defect-checkpoint-untracked-integration"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --stat --oneline --decorate HEAD && git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --format=fuller --no-ext-diff --find-renames HEAD -- cli/src/checkpoint.ts cli/test/checkpoint_restore.test.ts | sed -n '1,220p'; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix status --porcelain=v2 --branch; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix rev-parse origin/v1/defect-checkpoint-untracked-integration"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"c4f4fe86 (HEAD -> v1/checkpoint-ordinary-child-fix) fix(checkpoint): use literal Git pathspecs for restore checks\n cli/src/checkpoint.ts               | 24 ++++++++++------\n cli/test/checkpoint_restore.test.ts | 57 +++++++++++++++++++++++++++++++++++++\n 2 files changed, 73 insertions(+), 8 deletions(-)\ncommit c4f4fe867f71c8cff5cdb4f3860c2d3199e4a1a5\nAuthor:     Mike Holownych <mike@holownych.com>\nAuthorDate: Wed Oct 28 17:05:09 2026 +0000\nCommit:     Mike Holownych <mike@holownych.com>\nCommitDate: Wed Oct 28 17:05:09 2026 +0000\n\n    fix(checkpoint): use literal Git pathspecs for restore checks\n\ndiff --git a/cli/src/checkpoint.ts b/cli/src/checkpoint.ts\nindex efd3c01b..0b7e056a 100644\n--- a/cli/src/checkpoint.ts\n+++ b/cli/src/checkpoint.ts\n@@ -35,7 +35,7 @@ function gitNulEntries(output: Buffer): Buffer[] {\n   for (const entry of entries) {\n     const decoded = entry.toString(\"utf8\");\n     if (!Buffer.from(decoded, \"utf8\").equals(entry)) {\n-      throw new Error(\"Checkpoint cannot safely process Git paths that are not valid UTF-8\");\n+      throw new GitPathEncodingError();\n     }\n   }\n   return entries;\n@@ -45,6 +45,13 @@ function stripGitLineEnding(value: string): string {\n   return value.endsWith(\"\\n\") ? value.slice(0, -1) : value;\n }\n \n+class GitPathEncodingError extends Error {\n+  constructor() {\n+    super(\"Checkpoint cannot safely process Git paths that are not valid UTF-8\");\n+    this.name = \"GitPathEncodingError\";\n+  }\n+}\n+\n function lstatOrAbsent(target: string): fs.Stats | undefined {\n   try {\n     return fs.lstatSync(target, { throwIfNoEntry: false });\n@@ -146,7 +153,7 @@ export class CheckpointManager {\n   private assertNoIgnoredAddedPaths(relativePaths: string[]): void {\n     for (const relativePath of relativePaths) {\n       try {\n-        execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", relativePath], {\n+        execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `:(literal)${relativePath}`], {\n           cwd: this.workspace,\n           stdio: \"ignore\",\n         });\n@@ -792,7 +799,7 @@ export class CheckpointManager {\n         const fullPath = path.join(directory, entry.name);\n         if (entry.isDirectory()) {\n           try {\n-            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `${relativePath}/${child}`], {\n+            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `:(literal)${relativePath}/${child}`], {\n               cwd: this.workspace,\n               stdio: \"ignore\",\n             });\n@@ -803,7 +810,7 @@ export class CheckpointManager {\n           if (!visit(fullPath, child)) return false;\n         } else if (entry.isFile() || entry.isSymbolicLink()) {\n           try {\n-            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `${relativePath}/${child}`], {\n+            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `:(literal)${relativePath}/${child}`], {\n               cwd: this.workspace,\n               stdio: \"ignore\",\n             });\n@@ -821,7 +828,7 @@ export class CheckpointManager {\n   }\n \n   private gitTrackedDescendantPaths(relativePath: string): string[] {\n-    return gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"ls-files\", \"--cached\", \"-z\", \"--\", relativePath], {\n+    return gitNulEntries(execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"ls-files\", \"--cached\", \"-z\", \"--\", `:(literal)${relativePath}`], {\n       cwd: this.workspace,\n       encoding: \"buffer\",\n       maxBuffer: 64 * 1024 * 1024,\n@@ -838,7 +845,7 @@ export class CheckpointManager {\n         if (entry.name === \".git\") return false;\n         if (entry.isDirectory()) {\n           try {\n-            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `${relativePath}/${child}`], {\n+            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `:(literal)${relativePath}/${child}`], {\n               cwd: this.workspace,\n               stdio: \"ignore\",\n             });\n@@ -864,7 +871,7 @@ export class CheckpointManager {\n \n     for (const entry of diskEntries) {\n       try {\n-        execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", entry], {\n+        execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `:(literal)${entry}`], {\n           cwd: this.workspace,\n           stdio: \"ignore\",\n         });\n@@ -951,7 +958,8 @@ export class CheckpointManager {\n         if (\n           error instanceof SensitivePersistenceError ||\n           error instanceof GitIndexLockError ||\n-          error instanceof GitIndexLockCheckError\n+          error instanceof GitIndexLockCheckError ||\n+          error instanceof GitPathEncodingError\n         ) throw error;\n         if (this.gitIndexLockExists()) throw new GitIndexLockError();\n         throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\ndiff --git a/cli/test/checkpoint_restore.test.ts b/cli/test/checkpoint_restore.test.ts\nindex 5b210edd..4d58f202 100644\n--- a/cli/test/checkpoint_restore.test.ts\n+++ b/cli/test/checkpoint_restore.test.ts\n@@ -171,6 +171,30 @@ test(\"Git restore refuses an ignored staged addition before changing the index o\n   }\n });\n \n+test(\"Git restore treats pathspec-magic filenames literally when checking ignored additions\", () => {\n+  const { repo, git } = gitRepo();\n+  const magicName = \":(exclude)ignored.bin\";\n+  try {\n+    fs.writeFileSync(path.join(repo, \".gitignore\"), `${magicName}\\n`);\n+    git(\"add\", \".gitignore\");\n+    git(\"commit\", \"-qm\", \"ignore a pathspec-looking filename\");\n+    const manager = new CheckpointManager(repo);\n+    const checkpoint = manager.createCheckpoint(\"before forced pathspec-looking addition\");\n+    fs.writeFileSync(path.join(repo, magicName), \"ignored staged payload\\n\");\n+    git(\"add\", \"-f\", magicName);\n+    const indexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n+\n+    const result = manager.restore(checkpoint.id);\n+\n+    assert.equal(result.success, false);\n+    assert.match(result.message, /ignored by current Git rules/i);\n+    assert.equal(fs.readFileSync(path.join(repo, magicName), \"utf8\"), \"ignored staged payload\\n\");\n+    assert.equal(execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\"), indexBefore);\n+  } finally {\n+    cleanupGitRepo(repo);\n+  }\n+});\n+\n test(\"legacy Git restore removes a path renamed after the checkpoint\", () => {\n   const { repo, git } = gitRepo();\n   try {\n@@ -1831,6 +1855,39 @@ test(\"Git manifest restore refuses an ignored directory replacing a tracked chec\n   }\n });\n \n+test(\"Git restore checks ignored descendants literally beneath a pathspec-looking directory\", () => {\n+  const { repo, git } = gitRepo();\n+  const magicDirectory = \":(top)target\";\n+  try {\n+    fs.writeFileSync(path.join(repo, \".gitignore\"), `${magicDirectory}/ignored\\n`);\n+    git(\"add\", \".gitignore\");\n+    git(\"commit\", \"-qm\", \"ignore a child beneath a pathspec-looking directory\");\n+    fs.writeFileSync(path.join(repo, magicDirectory), \"captured file\\n\");\n+    git(\"add\", \"--\", `:(literal)${magicDirectory}`);\n+    git(\"commit\", \"-qm\", \"track pathspec-looking file target\");\n+    const manager = new CheckpointManager(repo);\n+    const checkpoint = manager.createCheckpoint(\"magic-looking tracked path\");\n+\n+    fs.rmSync(path.join(repo, magicDirectory));\n+    fs.mkdirSync(path.join(repo, magicDirectory));\n+    fs.writeFileSync(path.join(repo, magicDirectory, \"ignored\"), \"ignored canary\\n\");\n+    fs.writeFileSync(path.join(repo, \"outside-canary.txt\"), \"preserve me\\n\");\n+    const headBefore = git(\"rev-parse\", \"HEAD\");\n+    const indexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n+\n+    const result = manager.restore(checkpoint.id);\n+\n+    assert.equal(result.success, false);\n+    assert.match(result.message, /destination|unsafe|snapshot/i);\n+    assert.equal(fs.readFileSync(path.join(repo, magicDirectory, \"ignored\"), \"utf8\"), \"ignored canary\\n\");\n+    assert.equal(fs.readFileSync(path.join(repo, \"outside-canary.txt\"), \"utf8\"), \"preserve me\\n\");\n+    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n+    assert.equal(execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\"), indexBefore);\n+  } finally {\n+    cleanupGitRepo(repo);\n+  }\n+});\n+\n test(\"Git manifest restore refuses special and nested-repository descendants of a tracked checkpoint file\", () => {\n   for (const obstruction of [\"fifo\", \"nested repository\"] as const) {\n     const { repo, git } = gitRepo();\n# branch.oid c4f4fe867f71c8cff5cdb4f3860c2d3199e4a1a5\n# branch.head v1/checkpoint-ordinary-child-fix\n934ed912b8e187c5c418709e472a6313bb4169a8\n","exit_code":0,"duration":{"secs":0,"nanos":109739459}},"started_at_ms":1793207196431,"completed_at_ms":1793207196542}}
