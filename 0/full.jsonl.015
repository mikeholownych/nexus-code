.replace(/[:.]/g, \"-\")}-${randomUUID().slice(0, 6)}`;\n    58\t    ensureGitExclude(this.workspace);\n    59\t    const flightsDir = path.join(this.workspace, \".nexus\", \"flights\");\n    60\t    ensurePrivateDir(flightsDir);\n    61\t    this.flightLogPath = path.join(flightsDir, `${this.flightId}.flightlog`);\n    62\t  }\n    63\t\n    64\t  public getFlightId(): string {\n    65\t    return this.flightId;\n    66\t  }\n    67\t\n    68\t  public getLogPath(): string {\n    69\t    return this.flightLogPath;\n    70\t  }\n    71\t\n    72\t  public isSessionActive(): boolean {\n    73\t    return this.isRecording;\n    74\t  }\n    75\t\n    76\t  private appendEvent(type: FlightEventType, step: number | undefined, payload: Record<string, any>): FlightEvent {\n    77\t    // Flightlogs are durable telemetry. Sanitize the complete event before its\n    78\t    // only write path; a classifier failure must not fall through to plaintext\n    79\t    // or prevent the authorized local capability from executing.\n    80\t    const eventId = `evt-${randomUUID().slice(0, 8)}`;\n    81\t    const timestamp = new Date().toISOString();\n    82\t    let sanitizedPayload: Record<string, any>;\n    35\t\n    36\t/**\n    37\t * Ephemeral Git Worktree Sandboxing Engine\n    38\t * Isolates speculative task executions in temporary worktrees under .nexus/worktrees/<task-id>\n    39\t * so uncommitted developer changes are never dirtied or corrupted.\n    40\t */\n    41\texport class WorktreeManager {\n    42\t  private workspace: string;\n    43\t  private gitRoot: string;\n    44\t\n    45\t  constructor(workspace: string) {\n    46\t    this.workspace = path.resolve(workspace);\n    47\t    this.gitRoot = this.resolveGitRoot();\n    48\t  }\n    49\t\n    50\t  private resolveGitRoot(): string {\n    51\t    try {\n    52\t      const out = execFileSync(\"git\", [\"rev-parse\", \"--show-toplevel\"], {\n    53\t        cwd: this.workspace,\n    54\t        encoding: \"utf-8\",\n    55\t        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n    56\t      }).trim();\n    57\t      return out;\n    58\t    } catch {\n    59\t      return this.workspace;\n    60\t    }\n    61\t  }\n    62\t\n    63\t  public isGitRepo(): boolean {\n    64\t    try {\n    65\t      const out = execFileSync(\"git\", [\"rev-parse\", \"--is-inside-work-tree\"], {\n    66\t        cwd: this.workspace,\n    67\t        encoding: \"utf-8\",\n    68\t        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n    69\t      }).trim();\n    70\t      return out === \"true\";\n    71\t    } catch {\n    72\t      return false;\n    73\t    }\n    74\t  }\n    75\t\n    76\t  private ensureGitExclude(): void {\n    77\t    if (!this.isGitRepo()) return;\n    78\t    ensureGitExclude(this.workspace);\n    79\t  }\n    80\t\n    81\t  public getWorktreesBaseDir(): string {\n    82\t    return path.join(this.gitRoot, \".nexus\", \"worktrees\");\n    83\t  }\n    84\t\n    85\t  /**\n    86\t   * Spawns an isolated ephemeral worktree with a dedicated speculative branch.\n    87\t   */\n    88\t  public createWorktree(taskId: string = `task-${randomUUID().slice(0, 8)}`, startPoint: string = \"HEAD\"): WorktreeCreateResult {\n    89\t    if (!this.isGitRepo()) {\n    90\t      throw new Error(`Cannot create worktree: ${this.workspace} is not a valid git repository.`);\n    91\t    }\n    92\t\n  1100\t    this.bridge = new RustCoreBridge(\n  1101\t      ws,\n  1102\t      config.shell,\n  1103\t      config.coreBinaryPath,\n  1104\t      config.dryRun,\n  1105\t      config.readOnly,\n  1106\t      inheritedWorktreeScope ? (config.sandbox || \"auto\") : config.sandbox,\n  1107\t      Boolean(inheritedWorktreeScope?.requireSandbox),\n  1108\t    );\n  1109\t    this.bridge.setVerifierTimeoutSecs(config.verifierTimeoutSecs);\n  1110\t    this.securityManager = new SecurityManager(ws);\n  1111\t    this.ui = new TerminalUI();\n  1112\t    this.skillManager = new SkillManager(ws, { readOnly: config.readOnly });\n  1113\t    this.mcpManager = new McpClientManager(ws, { readOnly: config.readOnly });\n  1114\t    this.pluginManager = new PluginManager(ws, { readOnly: config.readOnly });\n  1115\t    this.worktreeManager = new WorktreeManager(ws);\n  1116\t    if (config.recordFlight) {\n  1117\t      this.flightRecorder = new FlightRecorder(ws);\n  1118\t      this.pluginManager.setFlightRecorder(this.flightRecorder);\n  1119\t    }\n  1120\t    this.candidateTracker = new CandidateTracker();\n  1121\t    this.capabilityRegistry = createDefaultRegistry();\n  1122\t    this.authorityEngine = new AuthorityAdmissionEngine({\n  1123\t      readOnly: config.readOnly,\n  1124\t      fullAccess: config.fullAccess ?? false,\n  1125\t      workspace: ws,\n  1126\t      registry: this.capabilityRegistry,\n  1127\t    });\n  1128\t    this.spine = new ExecutionSpine({\n  1129\t      registry: this.capabilityRegistry,\n  1130\t      hooks: {\n  1535\t    return this.securityManager;\n  1536\t  }\n  1537\t\n  1538\t  public getFlightRecorder(): FlightRecorder | undefined {\n  1539\t    return this.flightRecorder;\n  1540\t  }\n  1541\t\n  1542\t  public enableFlightRecorder(flightId?: string): FlightRecorder {\n  1543\t    this.flightRecorder = new FlightRecorder(this.config.workspace, flightId);\n  1544\t    this.pluginManager.setFlightRecorder(this.flightRecorder);\n  1545\t    return this.flightRecorder;\n  1546\t  }\n  1547\t\n  1548\t  public getWorktreeManager(): WorktreeManager {\n  1549\t    return this.worktreeManager;\n  1550\t  }\n  1551\t\n  1552\t  public getActiveWorktree(): { taskId: string; worktreePath: string; branch: string } | undefined {\n  1553\t    return this.activeWorktree;\n  1554\t  }\n  1555\t\n  1556\t  public mergeActiveWorktree(\n  1557\t    commitMessage?: string,\n  1558\t    receipt?: ValidationReceipt\n","exit_code":0,"duration":{"secs":0,"nanos":39258}},"started_at_ms":1792867888812,"completed_at_ms":1792867888813}}
