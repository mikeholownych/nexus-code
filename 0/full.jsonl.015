{"timestamp":"2026-10-24T16:43:57.213Z","ordinal":297038,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16ec6-5068-7a43-a634-88dec514377c","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a16ec6-5068-7a43-a634-88dec514377c","response_id":"resp_060b64278a9dfb15016adce04a7f2081a09d2ad128d29c79f0","usage":{"input_tokens":168826,"cached_input_tokens":168448,"cache_write_input_tokens":0,"output_tokens":255,"reasoning_output_tokens":215,"total_tokens":169081},"turn_token_usage":{"input_tokens":5297477,"cached_input_tokens":5170304,"cache_write_input_tokens":0,"output_tokens":31704,"reasoning_output_tokens":23180,"total_tokens":5329181},"thread_token_usage":{"input_tokens":5397036132,"cached_input_tokens":5339513344,"cache_write_input_tokens":0,"output_tokens":15007715,"reasoning_output_tokens":8553348,"total_tokens":5412043847}}}
