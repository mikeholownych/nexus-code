ive-choice rev-list --left-right --count HEAD...origin/main"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"python3 - <<'PY'\nimport os\nme=os.getpid(); ancestors={me}; p=os.getppid()\nwhile p>1:\n    ancestors.add(p)\n    try:\n        with open(f'/proc/{p}/stat') as f: p=int(f.read().split(') ')[1].split()[1])\n    except Exception: break\nroots=('/home/mike/nexus-wt/','/home/mike/nexus-code')\nhits=[]\nfor item in os.listdir('/proc'):\n    if not item.isdigit() or int(item) in ancestors: continue\n    pid=int(item); base=f'/proc/{pid}'\n    try:\n        comm=open(base+'/comm').read().strip()\n        cwd=os.readlink(base+'/cwd')\n        argv=open(base+'/cmdline','rb').read().decode(errors='replace').replace('\\0',' ').lower()\n    except Exception: continue\n    if not any(cwd.startswith(root) for root in roots): continue\n    if comm in {'node','npm','cargo','make','bash','sh','zsh'} and any(x in argv for x in ['npm test','npm --prefix cli test','run_tests','vitest','cargo test','make test','node --test']):\n        hits.append((pid,comm,cwd))\nprint(hits if hits else 'No matching suite process found under shared checkout or Nexus worktrees (self and ancestors excluded).')\nPY\nif ps -p 2878088 -o pid=,comm=; then true; else echo 'Recorded PID 2878088 is absent on mike-dev'; fi\nprintf '\\nRecorded worktree state: '; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice status --porcelain=v1 | wc -l\nprintf 'Recorded worktree HEAD: '; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice rev-parse HEAD\nprintf 'Worktree HEAD age: '; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice log -1 --format='%cI %s'\nprintf 'Worktree behind origin/main: '; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice rev-list --left-right --count HEAD...origin/main"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"No matching suite process found under shared checkout or Nexus worktrees 