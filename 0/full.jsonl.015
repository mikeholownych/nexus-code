{"timestamp":"2026-10-24T18:50:02.232Z","ordinal":302935,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16f3c-d2bf-7c20-9739-5c085f717ae0","item":{"type":"CommandExecution","id":"exec-71d7350f-ea37-4073-a901-cfa012a31935","process_id":"83025","command":["/usr/bin/zsh","-lc","git show b0240b43aaad16df9c2663218949970c4dac513b:cli/test/eval_integrity.test.ts | nl -ba | sed -n '450,690p'; rg -n \"spawnContained|cpu.max|memory.max|pids.max|workspace storage|workspace_bytes|enforceResource|resourceLimits|cgroup\" cli/src/evaluator.ts cli/src/sandbox.ts cli/src -g '*.ts' | head -100"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git show b0240b43aaad16df9c2663218949970c4dac513b:cli/test/eval_integrity.test.ts | nl -ba | sed -n '450,690p'; rg -n \"spawnContained|cpu.max|memory.max|pids.max|workspace storage|workspace_bytes|enforceResource|resourceLimits|cgroup\" cli/src/evaluator.ts cli/src/sandbox.ts cli/src -g '*.ts' | head -100"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"   450\t      path.join(home, \"corpus-leak\"),\n   451\t      path.join(proxyDirectory, \"corpus-leak\"),\n   452\t      process.execPath,\n   453\t      supervisorPath,\n   454\t      readOnlyRuntime,\n   455\t    ];\n   456\t    for (const protectedPath of [...unconditionalMountPaths, ...runtimeMountPaths]) {\n   457\t      assert.match(\n   458\t        runtimeCorpusOverlapProblem([], [], tasks, [protectedPath], mountContext) ?? \"\",\n   459\t        /overlaps protected corpus material/,\n   460\t        `runtime preflight rejects mounted corpus path ${protectedPath}`,\n   461\t      );\n   462\t      assert.match(\n   463\t        hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: protectedPath }, mountContext }, tasks) ?? \"\",\n   464\t        /overlaps protected corpus material/,\n   465\t        `hidden-test qualification preflight rejects mounted corpus path ${protectedPath}`,\n   466\t      );\n   467\t      assert.throws(() => agentSandboxArgv({\n   468\t        cwd: runtimeRoot,\n   469\t        home,\n   470\t        proxyDirectory,\n   471\t        readOnlyPaths: [readOnlyRuntime],\n   472\t        supervisorPath,\n   473\t        protectedCorpusPaths: [protectedPath],\n   474\t      }), /overlaps protected corpus material/);\n   475\t      if (unconditionalMountPaths.includes(protectedPath)) {\n   476\t        // This check precedes Bubblewrap availability, including on minimal CI hosts.\n   477\t        assert.throws(() => isolatedArgv({ cwd: runtimeRoot, command: \"true\", protectedCorpusPaths: [protectedPath] }), /overlaps protected corpus material/);\n   478\t      }\n   479\t    }\n   480\t    assert.match(\n   481\t      runtimeCorpusOverlapProblem([], [\"/usr/bin\"], tasks, [path.join(\"/usr/bin\", \"synthetic-corpus-subdir\")]) ?? \"\",\n   482\t      /overlaps protected corpus material/,\n   483\t      \"a runtime allowlist root below an unconditional system mount is rejected\",\n   484\t    );\n   485\t    assert.match(\n   486\t      runtimeCorpusOverlapProblem([readOnlyRuntime], [], tasks, [readOnlyRuntime], mountContext) ?? \"\",\n   487\t      /overlaps protected corpus material/,\n   488\t      \"an explicit read-only runtime source is checked against the corpus\",\n   489\t    );\n   490\t    assert.match(\n   491\t      hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [readOnlyRuntime], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: readOnlyRuntime }, mountContext }, tasks) ?? \"\",\n   492\t      /overlaps protected corpus material/,\n   493\t      \"hidden-test preflight checks explicit read-only runtime sources\",\n   494\t    );\n   495\t    const custodyReportPath = readOnlyRuntime;\n   496\t    assert.match(hiddenTestIsolationProblem({\n   497\t      qualification: true,\n   498\t      runAs: \"nexus-eval\",\n   499\t      sandboxRuntimePaths: [readOnlyRuntime],\n   500\t      sandboxRuntimeRoots: [runtimeRoot],\n   501\t      corpusCustody: { reportPath: custodyReportPath },\n   502\t      mountContext,\n   503\t    }, tasks) ?? \"\", /overlaps protected corpus material/);\n   504\t    assert.throws(() => agentSandboxArgv({\n   505\t      cwd: runtimeRoot,\n   506\t      home,\n   507\t      proxyDirectory,\n   508\t      readOnlyPaths: [readOnlyRuntime],\n   509\t      supervisorPath,\n   510\t      protectedCorpusPaths: [custodyReportPath],\n   511\t    }), /overlaps protected corpus material/);\n   512\t  } finally {\n   513\t    fs.rmSync(root, { recursive: true, force: true });\n   514\t  }\n   515\t});\n   516\t\n   517\ttest(\"qualification remains fail-closed without enforced aggregate resource controls\", async () => {\n   518\t  const { qualificationResourceIsolationProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   519\t  const { dedicatedTmpfsMountProblem } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n   520\t  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\n   521\t  const tmpfs = fs.statfsSync(workspaceRoot);\n   522\t  const ok = { cpuPercent: 100, memoryBytes: 256 * 1024 * 1024, tasks: 64, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\n   523\t  const shared = fs.statfsSync(\"/dev/shm\");\n   524\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: \"/dev/shm\", storageBytes: shared.blocks * shared.bsize } }) ?? \"\", /dedicated tmpfs|exact mount point/);\n   525\t  assert.match(qualificationResourceIsolationProblem(), /enforced CPU, memory, process-count, and workspace-storage limits/);\n   526\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: ROOT } }) ?? \"\", /tmpfs/);\n   527\t  const nested = fs.mkdtempSync(path.join(workspaceRoot, \"nested-\"));\n   528\t  try {\n   529\t    assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: nested } }) ?? \"\", /exact mount point/);\n   530\t  } finally {\n   531\t    fs.rmdirSync(nested);\n   532\t  }\n   533\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, memoryBytes: 1024 } }) ?? \"\", /memoryBytes/);\n   534\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, tasks: 0 } }) ?? \"\", /tasks/);\n   535\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, cpuPercent: 1.5 } }) ?? \"\", /cpuPercent/);\n   536\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, memoryBytes: 256 * 1024 * 1024 + 1 } }) ?? \"\", /multiple of 4096/);\n   537\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, storageBytes: ok.storageBytes - 4096 } }) ?? \"\", /tmpfs with size<=storageBytes|owner-accessible/);\n   538\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, storageBytes: undefined } }) ?? \"\", /storageBytes/);\n   539\t  const isolation = qualificationResourceIsolationProblem({ resources: ok });\n   540\t  if (process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) assert.equal(isolation, null, \"the dedicated test tmpfs and kernel resource contract must pass preflight\");\n   541\t  else assert.match(isolation ?? \"\", /dedicated tmpfs|exact mount point/, \"a shared /dev/shm must fail qualification preflight\");\n   542\t  if (process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) {\n   543\t    // CI mounts the capped workspace as 0711 (owner rwx, other --x). Mode probes must restore\n   544\t    // that contract so later runAs / version-probe suites can still traverse as the evaluator.\n   545\t    const restoreMode = 0o711;\n   546\t    fs.chmodSync(workspaceRoot, 0o755);\n   547\t    try {\n   548\t      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \"\", /non-readable\\/non-writable by group or other/);\n   549\t    } finally {\n   550\t      fs.chmodSync(workspaceRoot, restoreMode);\n   551\t    }\n   552\t    assert.equal(qualificationResourceIsolationProblem({ resources: ok }), null, \"restored dedicated mount root must pass preflight\");\n   553\t    fs.chmodSync(workspaceRoot, 0o731);\n   554\t    try {\n   555\t      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \"\", /non-readable\\/non-writable by group or other/);\n   556\t    } finally {\n   557\t      fs.chmodSync(workspaceRoot, restoreMode);\n   558\t    }\n   559\t    fs.chmodSync(workspaceRoot, 0o711);\n   560\t    try {\n   561\t      assert.equal(qualificationResourceIsolationProblem({ resources: ok }), null, \"execute-only traversal for the isolated evaluator account is compatible with the private root\");\n   562\t    } finally {\n   563\t      fs.chmodSync(workspaceRoot, restoreMode);\n   564\t    }\n   565\t  }\n   566\t  const syntheticRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-mount-mode-\"));\n   567\t  try {\n   568\t    fs.chmodSync(syntheticRoot, 0o711);\n   569\t    const syntheticMount = `101 1 0:88 / ${syntheticRoot} rw,relatime - tmpfs tmpfs rw,size=131072k,mode=711,uid=${process.getuid()}`;\n   570\t    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, `${syntheticMount}\\n${syntheticMount.replace(\"101 \", \"102 \")}`) ?? \"\", /stacked or duplicate/);\n   571\t    assert.equal(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount), null, \"execute-only traversal is permitted for the isolated evaluator account\");\n   572\t    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount.replace(\"mode=711\", \"mode=755\")) ?? \"\", /non-readable\\/non-writable by group or other/);\n   573\t    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount.replace(\"mode=711\", \"mode=721\")) ?? \"\", /non-readable\\/non-writable by group or other/);\n   574\t  } finally {\n   575\t    fs.chmodSync(syntheticRoot, 0o700);\n   576\t    fs.rmdirSync(syntheticRoot);\n   577\t  }\n   578\t});\n   579\t\n   580\ttest(\"resource contract: candidate memory, processes, storage and CPU are kernel-bounded and every process is reaped\", async () => {\n   581\t  const { runIsolated, sandboxAvailable } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   582\t  const { spawnContained } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n   583\t  assert.equal(sandboxAvailable(), true, \"this security test requires the real Bubblewrap executable\");\n   584\t  const memoryBytes = 256 * 1024 * 1024;\n   585\t  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\n   586\t  const tmpfs = fs.statfsSync(workspaceRoot);\n   587\t  const resources = { cpuPercent: 20, memoryBytes, tasks: 16, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\n   588\t  const ws = fs.mkdtempSync(path.join(resources.workspaceRoot, \"eval-resources-\"));\n   589\t  const run = (command: string, timeoutSec = 30) => runIsolated(command, { cwd: ws, home: true, timeoutSec, resources });\n   590\t  try {\n   591\t    const memory = await run(\"tail /dev/zero\");\n   592\t    assert.notEqual(memory.status, 0);\n   593\t    assert.ok(memory.resources.oomKills >= 1, JSON.stringify(memory.resources));\n   594\t    assert.equal(memory.resources.limits[\"memory.oom.group\"], \"1\");\n   595\t    assert.equal(memory.resources.limits[\"memory.max\"], String(memoryBytes));\n   596\t    assert.equal(memory.resources.limits[\"memory.swap.max\"], \"0\");\n   597\t    assert.equal(memory.containmentProblem, null);\n   598\t\n   599\t    const forks = await run(\"for i in $(seq 64); do sleep 30 & done; wait\", 10);\n   600\t    assert.ok(forks.resources.pidsMaxEvents >= 1, JSON.stringify(forks.resources));\n   601\t    assert.ok(forks.resources.pidsPeak <= 16);\n   602\t    assert.equal(forks.resources.cleaned, true);\n   603\t\n   604\t    // The dedicated workspace mount caps storage before the larger memory limit; sandbox /tmp is separately charged\n   605\t    // to the task cgroup and must hit memory.max. Neither failure may leave a task process behind.\n   606\t    const workspaceDisk = await run(\"dd if=/dev/zero of=/workspace/fill bs=1M count=512 status=none\");\n   607\t    assert.notEqual(workspaceDisk.status, 0, JSON.stringify(workspaceDisk));\n   608\t    assert.equal(workspaceDisk.resources.oomKills, 0, JSON.stringify(workspaceDisk.resources));\n   609\t    assert.equal(workspaceDisk.resources.cleaned, true);\n   610\t    assert.ok((fs.existsSync(path.join(ws, \"fill\")) ? fs.statSync(path.join(ws, \"fill\")).size : 0) <= resources.storageBytes);\n   611\t\n   612\t    const sandboxDisk = await run(\"dd if=/dev/zero of=/tmp/fill bs=1M count=512 status=none\");\n   613\t    assert.notEqual(sandboxDisk.status, 0, JSON.stringify(sandboxDisk));\n   614\t    assert.ok(sandboxDisk.resources.oomKills >= 1, JSON.stringify(sandboxDisk.resources));\n   615\t    assert.equal(sandboxDisk.resources.cleaned, true);\n   616\t\n   617\t    const cpu = await run(\"timeout 2 sh -c 'while :; do :; done' & timeout 2 sh -c 'while :; do :; done' & wait\");\n   618\t    assert.equal(cpu.resources.limits[\"cpu.max\"], \"20000 100000\");\n   619\t    assert.ok(cpu.resources.cpuUsageUsec < 1_000_000, `two busy loops for 2 s at 20% used ${cpu.resources.cpuUsageUsec} us`);\n   620\t    assert.ok(cpu.resources.cpuThrottledUsec > 0);\n   621\t\n   622\t    // The wall-clock kill goes through the cgroup, so the supervisor still proves cleanup.\n   623\t    const slow = await run(\"sleep 60\", 1);\n   624\t    assert.equal(slow.timedOut, true);\n   625\t    assert.equal(slow.resources.cleaned, true);\n   626\t    assert.equal(slow.containmentProblem, null);\n   627\t\n   628\t    // A stop requested at once (before the payload can have joined its leaf) still ends the payload.\n   629\t    const early = await new Promise<any>((resolve) => {\n   630\t      const started = Date.now();\n   631\t      const { child, containment } = spawnContained({ cmd: \"/bin/sleep\", argv: [\"60\"] }, resources, { cwd: \"/\", stdio: [\"ignore\", \"ignore\", \"ignore\"], detached: true });\n   632\t      containment!.kill();\n   633\t      child.on(\"close\", async () => resolve({ ms: Date.now() - started, final: await containment!.final }));\n   634\t    });\n   635\t    assert.ok(early.ms < 15_000, `early stop took ${early.ms} ms`);\n   636\t    assert.notEqual(early.final?.exitCode, 0);\n   637\t\n   638\t    // A process that leaves the session and process group is still found in, and removed from, the cgroup.\n   639\t    const readyMarker = path.join(ws, \"escaped-process-ready\");\n   640\t    const escapedMarker = path.join(ws, \"escaped-process-survived\");\n   641\t    const escaped = await new Promise<any>((resolve) => {\n   642\t      const { child, containment } = spawnContained({ cmd: \"/bin/sh\", argv: [\"-c\", `setsid sh -c 'touch ${readyMarker}; sleep 2; touch ${escapedMarker}' </dev/null >/dev/null 2>&1 & while [ ! -e '${readyMarker}' ]; do sleep 0.01; done`] }, resources, { cwd: \"/\", stdio: [\"ignore\", \"ignore\", \"ignore\"], detached: true });\n   643\t      child.on(\"close\", async () => resolve(await containment!.final));\n   644\t    });\n   645\t    assert.ok(escaped.survivorsAfterExit >= 1, JSON.stringify(escaped));\n   646\t    assert.equal(escaped.cleaned, true);\n   647\t    await new Promise((resolve) => setTimeout(resolve, 2200));\n   648\t    assert.equal(fs.existsSync(escapedMarker), false, \"a session-escaped task process survived cgroup cleanup\");\n   649\t  } finally {\n   650\t    fs.rmSync(ws, { recursive: true, force: true });\n   651\t  }\n   652\t});\n   653\t\n   654\ttest(\"candidate sandbox and resource supervisor compose around a staged repository\", { timeout: 30_000 }, async () => {\n   655\t  const { stageRepoWorkspace } = await import(path.join(ROOT, \"eval/workspace.mjs\"));\n   656\t  const { agentSandboxArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   657\t  const { resourceConfigProblem, spawnContained } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n   658\t  assert.equal((await import(path.join(ROOT, \"eval/isolate.mjs\"))).sandboxAvailable(), true, \"this security test requires the real Bubblewrap executable\");\n   659\t\n   660\t  let base: string | null = null;\n   661\t  let workspace: string | null = null;\n   662\t  let contained: ReturnType<typeof spawnContained> | null = null;\n   663\t  let childClosed: Promise<void> | null = null;\n   664\t  let candidateProcessClosed = false;\n   665\t  let shutdownComplete = false;\n   666\t  let executionStarted = false;\n   667\t  let candidateSpawnError: Error | undefined;\n   668\t  let timedOut = false;\n   669\t  try {\n   670\t    base = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-contained-candidate-\"));\n   671\t    const profile = JSON.parse(fs.readFileSync(path.join(ROOT, \"eval/host/resource-profile.json\"), \"utf8\"));\n   672\t    const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? profile.workspaceRoot;\n   673\t    const resources = {\n   674\t      cpuPercent: profile.cpuPercent,\n   675\t      memoryBytes: profile.memoryBytes,\n   676\t      tasks: profile.tasks,\n   677\t      storageBytes: profile.storageBytes,\n   678\t      workspaceRoot,\n   679\t    };\n   680\t    assert.equal(resourceConfigProblem(resources), null, \"the test requires the configured dedicated tmpfs resource boundary\");\n   681\t    workspace = fs.mkdtempSync(path.join(workspaceRoot, \"eval-contained-candidate-ws-\"));\n   682\t    const fixtureBase = base;\n   683\t    const fixtureWorkspace = workspace;\n   684\t    const env = { PATH: \"/usr/bin:/bin\", HOME: fixtureBase, GIT_CONFIG_NOSYSTEM: \"1\", GIT_CONFIG_GLOBAL: \"/dev/null\", GIT_TERMINAL_PROMPT: \"0\" };\n   685\t    const git = (cwd: string, ...argv: string[]) => {\n   686\t      const result = spawnSync(\"git\", [\"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"init.defaultBranch=main\", ...argv], { cwd, env, encoding: \"utf8\" });\n   687\t      assert.equal(result.status, 0, result.stderr);\n   688\t      return result.stdout.trim();\n   689\t    };\n   690\t    const upstream = path.join(fixtureBase, \"upstream\");\ncli/src/plugins.ts:296:          resourceLimits: {\n","exit_code":0,"duration":{"secs":0,"nanos":38097}},"started_at_ms":1792867802231,"completed_at_ms":1792867802231}}
