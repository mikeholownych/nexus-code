stdio: [\"pipe\", \"pipe\", \"pipe\"],\n+      });\n+    } else {\n+      // A newly initialized repository has no HEAD tree to reset to. Confirm that\n+      // HEAD is a symbolic ref whose branch does not yet exist before treating it\n+      // as unborn; a broken or detached HEAD must still fail closed.\n+      const headRef = spawnSync(\"git\", [\"symbolic-ref\", \"-q\", \"HEAD\"], {\n+        cwd: workspace,\n+        env: gitEnv,\n+        encoding: \"utf-8\",\n+        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n+      });\n+      if (headRef.error) throw headRef.error;\n+      if (headRef.status !== 0 || !headRef.stdout.trim()) {\n+        throw new Error(\"Cannot resolve repository HEAD before excluding Nexus state\");\n+      }\n+      const branchRef = headRef.stdout.trim();\n+      const branch = spawnSync(\"git\", [\"show-ref\", \"--verify\", \"--quiet\", branchRef], {\n+        cwd: workspace,\n+        env: gitEnv,\n+        stdio: \"ignore\",\n+      });\n+      if (branch.error) throw branch.error;\n+      if (branch.status !== 1) {\n+        throw new Error(\"Repository HEAD is not an unborn branch; refusing to alter the index\");\n+      }\n+      // There is no HEAD tree to restore from, so remove only staged .nexus paths\n+      // from the index. --cached preserves their workspace contents.\n+      execFileSync(\"git\", [\"rm\", \"--cached\", \"-r\", \"-f\", \"--ignore-unmatch\", \"--\", \":(top).nexus\"], {\n+        cwd: workspace,\n+        env: gitEnv,\n+        stdio: [\"pipe\", \"pipe\", \"pipe\"],\n+      });\n+    }\n     // Internal Nexus state must never enter an automated workspace commit, even if a user's\n     // .git/info/exclude contains a malformed rule or a later negation that exposes .nexus/.\n     execFileSync(\"git\", [\"add\", \"-A\", \"--\", \":(top,exclude).nexus\", \":(top,exclude).nexus/**\"], {\ndiff --git a/cli/test/git_commit.test.ts b/cli/test/git_commit.test.ts\nindex 9d524a2..b40a7f2 100644\n--- a/cli/test/git_commit.test.ts\n+++ b/cli/test/git_commit.test.ts\n@@ -36,6 +36,33 @@ test(\"commit messages are committed verbatim and never run by a shell\", () => {\n   }\n });\n \n+test(\"commitChanges permits a first commit while excluding pre-staged .nexus state\", () => {\n+  const repo = fs.mkdtempSync(path.join(process.env.TMPDIR ?? \"/tmp\", \"nexus-unborn-repo-\"));\n+  const internalState = path.join(repo, \".nexus/tasks/private.json\");\n+  try {\n+    execFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: repo });\n+    execFileSync(\"git\", [\"config\", \"user.name\", \"Nexus Test\"], { cwd: repo });\n+    execFileSync(\"git\", [\"config\", \"user.email\", \"nexus-test@example.invalid\"], { cwd: repo });\n+    fs.mkdirSync(path.dirname(internalState), { recursive: true });\n+    fs.writeFileSync(internalState, \"synthetic private state\\n\");\n+    fs.writeFileSync(path.join(repo, \"README.md\"), \"first ordinary file\\n\");\n+    execFileSync(\"git\", [\"add\", \"-f\", \"--\", \".nexus\"], { cwd: repo });\n+\n+    const result = commitChanges(repo, \"chore(workspace): create first commit\");\n+    assert.equal(result.success, true, result.error);\n+\n+    const committedPaths = execFileSync(\"git\", [\"diff-tree\", \"--root\", \"--no-commit-id\", \"--name-only\", \"-r\", \"HEAD\"], {\n+      cwd: repo,\n+      encoding: \"utf-8\",\n+    }).trim().split(\"\\n\").filter(Boolean);\n+    assert.deepEqual(committedPaths, [\"README.md\"]);\n+    assert.equal(fs.readFileSync(internalState, \"utf-8\"), \"synthetic private state\\n\");\n+    assert.equal(execFileSync(\"git\", [\"ls-files\", \"--\", \".nexus\"], { cwd: repo, encoding: \"utf-8\" }).trim(), \"\");\n+  } finally {\n+    fs.rmSync(repo, { recursive: true, force: true });\n+  }\n+});\n+\n for (const [name, exclude] of [\n   [\"leading whitespace\", \"  .nexus/\\n\"],\n   [\"later negation\", \".nexus/\\n!.nexus/\\n\"],\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16ed9-c60e-7103-9ada-b7f9a638664b",