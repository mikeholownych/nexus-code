.json\n.git/nexus-claims/archived/FILE_cli_src_core_client_lease.ts-owner-transfer-to-root-20261020T113030Z.json\n.git/nexus-claims/archived/REDACTED/owner.json\n.git/nexus-claims/archived/FILE_cli_src_core_state_store_guard.ts-owner-transfer-to-root-20261020T113030Z.json\n.git/nexus-claims/archived/FILE_cli_src_core_file_guard.ts-owner-transfer-to-root-20261020T113030Z.json\n.git/nexus-claims/archived/FILE_cli_test_helpers_repl_approval_driver_py-released-20261024T063154Z.json\n.git/nexus-claims/archived/REDACTED.json\n.git/nexus-claims/archived/FILE-client-lease-PR101-merged-20261021.json\n.git/nexus-claims/archived/FILE_cli_src_index.ts-owner-transfer-to-root-20261020T113030Z.json\n\nTrust module\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\n\n/** Workspace files that configure MCP servers, and directories plugins are loaded from: used only when trusted. */\nexport const WORKSPACE_MCP_FILES = [\".mcp.json\", \"mcp.json\"];\nexport const WORKSPACE_PLUGIN_DIRS = [path.join(\".nexus\", \"plugins\"), \"plugins\"];\n\n/**\n * The workspace's own MCP configuration files and plugin modules that exist but are not loaded because the workspace\n * is not trusted (or the session is read-only). Empty when there are none or the workspace is trusted.\n */\nexport function untrustedWorkspaceExtensions(workspace: string, readOnly = false): string[] {\n  if (isWorkspaceTrusted(workspace, readOnly)) return [];\n  const root = path.resolve(workspace);\n  const found = WORKSPACE_MCP_FILES.map((f) => path.join(root, f)).filter((f) => fs.existsSync(f));\n  for (const dir of WORKSPACE_PLUGIN_DIRS) {\n    try {\n      for (const name of fs.readdirSync(path.join(root, dir))) {\n        if (name.endsWith(\".js\") || name.endsWith(\".mjs\")) found.push(path.join(root, dir, name));\n      }\n    } catch {}\n  }\n  return found;\n}\n\nexport function getTrustStorePath(): string {\n  return path.join(os.homedir(), \".config\", \"nexus\", \"trusted_workspaces.json\");\n}\n\n/**\n * Check if the given workspace is explicitly trusted by the operator.\n * In --read-only mode, workspace trust never authorizes executing project plugins/MCP.\n */\nexport function isWorkspaceTrusted(workspace: string, readOnly = false): boolean {\n  if (readOnly) return false;\n  if (process.env.NEXUS_TRUST_WORKSPACE === \"1\") return true;\n\n  try {\n    const resolved = path.resolve(workspace);\n    const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\n    const storePath = getTrustStorePath();\n    if (!fs.existsSync(storePath)) return false;\n    const content = JSON.parse(fs.readFileSync(storePath, \"utf8\"));\n    if (Array.isArray(content)) {\n      return content.includes(realWs);\n    }\n    if (content && typeof content === \"object\" && Array.isArray(content.trustedPaths)) {\n      return content.trustedPaths.includes(realWs);\n    }\n  } catch {}\n  return false;\n}\n\n/** The trusted workspaces (real paths), as recorded in the trust store. */\nexport function listTrustedWorkspaces(): string[] {\n  try {\n    const raw = JSON.parse(fs.readFileSync(getTrustStorePath(), \"utf8\"));\n    const list = Array.isArray(raw) ? raw : Array.isArray(raw?.trustedPaths) ? raw.trustedPaths : [];\n    return list.filter((p: unknown): p is string => typeof p === \"string\");\n  } catch {\n    return [];\n  }\n}\n\n/** Records (or removes) the operator's trust in a workspace. Returns its real path; throws when the store cannot be written. */\nexport function setWorkspaceTrusted(workspace: string, trusted: boolean): string {\n  const resolved = path.resolve(workspace);\n  const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\n  const storePath = getTrustStorePath();\n  fs.mkdirSync(path.dirname(storePath), { recursive: true, mode: 0o700 });\n  const list = listTrustedWorkspaces().filter((p) => p !== realWs);\n  if (trusted) list.push(realWs);\n  const temp = `${storePath}.${process.pid}.tmp`;\n  fs.writeFileSync(temp, JSON.stringify({ trustedPaths: list }, null, 2), { mode: 0o600 });\n  fs.renameSync(temp, storePath);\n  return realWs;\n}\n\nStartup integration references\nrg: /home/mike/nexus-wt/startup-workspace-trust/cli/src/tui: No such file or directory (os error 2)\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:28:import { promptWorkspaceTrust } from \"./startup_trust.js\";\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:208:  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:209:  if (trustDecision === \"exit\") return;\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:249:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:250:    if (trustDecision === \"exit\") return;\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:258:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:259:    if (trustDecision === \"exit\") return;\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:288:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: auto for trusted workspaces, review for untrusted)\")\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:306:  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:344:  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:353:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: auto for trusted workspaces, review for untrusted)\")\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:385:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: auto for trusted workspaces, review for untrusted)\")\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:388:  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:734:    const { untrustedWorkspaceExtensions } = await import(\"./workspace_trust.js\");\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:735:    for (const file of untrustedWorkspaceExtensions(ws).filter((f) => /(^|[\\\\/])\\.?mcp\\.json$/.test(f))) {\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:736:      console.log(pc.yellow(`Not loaded (workspace not trusted; run \\`nexus trust\\`): ${file}`));\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:773:    const { untrustedWorkspaceExtensions } = await import(\"./workspace_trust.js\");\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:774:    for (const file of untrustedWorkspaceExtensions(ws).filter((f) => !/(^|[\\\\/])\\.?mcp\\.json$/.test(f))) {\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:775:      console.log(pc.yellow(`Not loaded (workspace not trusted; run \\`nexus trust\\`): ${file}`));\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:790:  .command(\"trust [path]\")\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:791:  .description(\"Trust a workspace so its own .mcp.json servers and plugins are loaded (they run code from the workspace)\")\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:792:  .option(\"--remove\", \"Stop trusting the workspace\")\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:793:  .option(\"--list\", \"List trusted workspaces\")\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:795:    const { listTrustedWorkspaces, setWorkspaceTrusted } = await import(\"./workspace_trust.js\");\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:797:      const list = listTrustedWorkspaces();\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:798:      console.log(list.length ? list.join(\"\\n\") : \"No trusted workspaces.\");\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:807:    const real = setWorkspaceTrusted(ws, !options.remove);\n/home/mike/nexus-wt/startup-workspace-trust/cli/src/index.ts:808:    console.log(options.remove ? `No longer trusted: ${real}` : `Trusted: ${real}\\nIts .mcp.json servers and plugins will be loaded (they run code from this workspace). Undo with \\`nexus trust --remove\\`.`);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16f1a-0d89-7262-a71e-eb3a6dfcc08e","create_time":1792865593.8219972}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
