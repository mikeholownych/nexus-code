{"timestamp":"2026-10-24T17:41:07.220Z","ordinal":299591,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a16f00-8414-7b71-8cd7-9f18e8b86aac","call_id":"call_73756221004b4075a255d4aa009942c3","output":[{"type":"input_text","text":"Script completed\nWall time 2.8 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 10874)\nTotal output lines: 526\n\n#!/usr/bin/env node\n// Runs evaluation tasks against an agent configuration and appends one JSON line per run (see eval/README.md).\n// Each run gets a fresh workspace (the task's repository at its pinned commit, or its fixture), the agent runs with the\n// task's budgets and a wall-clock timeout, then the task's hidden tests (never present while the agent runs) and its\n// regression command are run in that workspace. Nothing is scored here: eval/score.mjs reads the JSON lines.\nimport { spawnSync } from \"node:child_process\";\nimport { createHash, randomBytes } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { startModelProxy } from \"./model_proxy.mjs\";\nimport { asUserSpec, corpusManifestProblem, corpusTaskRows, fetchModelEntry, hiddenTestIsolationProblem, modelFingerprint, nexusContextLimitArgs, nexusLimitsProblem, qualificationBudgetProblem, runtimeCorpusOverlapProblem, taskTreeDigest, validateTask } from \"./validate.mjs\";\nimport { agentSandboxArgv, assertNoSymlinks, confinedPath, grantRunAsAccess, hiddenOutputHasTests, isolatedProcessArgv, normalizeRunAsPermissions, runIsolated, runIsolatedProcess, sandboxAvailable, stageHiddenFiles } from \"./isolate.mjs\";\nimport { runBlackBoxOracle } from \"./oracle.mjs\";\nimport { stageRepoWorkspace } from \"./workspace.mjs\";\nimport { applyAgentChanges, cloneWorkspace } from \"./hardened_check.mjs\";\nimport { containmentProblem, resourceProbeProblem, spawnContained } from \"./resources.mjs\";\nimport { StringDecoder } from \"node:string_decoder\";\nimport { commandBaseline, countCompactions, createT3Driver, scoreT3Run, steeringBaseline, steeringPrecondition, t3Snapshot } from \"./t3.mjs\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst args = parseArgs(process.argv.slice(2));\nif (args.out) args.out = path.resolve(args.out); // agents run elsewhere: paths handed to them must be absolute\nif (!args.config || !args.out) {\n  console.error(\"usage: eval/run.mjs --config eval/configs/<name>.json --out <dir> [--tasks eval/tasks] [--only id,id] [--runs N]\");\n  process.exit(2);\n}\nconst configBytes = fs.readFileSync(args.config);\nconst configSha256 = createHash(\"sha256\").update(configBytes).digest(\"hex\");\nconst config = JSON.parse(configBytes.toString(\"utf8\"));\nconst tasksDir = path.resolve(args.tasks ?? path.join(ROOT, \"eval/tasks\"));\nfunction custodyCorpusPathsForRun() {\n  return [\n    config.corpusCustody?.reportPath,\n    config.corpusCustody?.storeRoot,\n    config.corpusCustody?.validatorPath,\n    config.corpusCustody?.referencePath,\n    config.corpusCustody?.authorLogPath,\n  ].filter(Boolean);\n}\nfunction protectedCorpusPathsForRun() {\n  const parent = path.dirname(tasksDir);\n  const evalDir = path.join(ROOT, \"eval\");\n  const includeParent = config.qualification === true || fs.realpathSync(parent) !== fs.realpathSync(evalDir);\n  return [tasksDir, ...(includeParent ? [parent] : []), ...custodyCorpusPathsForRun()];\n}\nconst runs = Number(args.runs ?? config.runs ?? 1);\nconst only = args.only ? new Set(String(args.only).split(\",\")) : null;\n// --pairs \"task run,task run\": rerun exactly these (runs that failed on infrastructure; see eval/infra.mjs).\nconst pairs = args.pairs ? String(args.pairs).split(\",\").filter(Boolean).map((p) => p.trim().split(/\\s+/)) : null;\nfs.mkdirSync(path.dirname(args.out), { recursive: true });\ntry {\n  fs.mkdirSync(args.out, { mode: 0o700 });\n  fs.chmodSync(args.out, 0o700);\n} catch (error) {\n  if (error.code === \"EEXIST\") {\n    console.error(\"eval/run.mjs: output directory must be new; refusing to overwrite or append to prior evidence\");\n    process.exit(2);\n  }\n  throw error;\n}\nconst resultsFile = path.join(args.out, \"results.jsonl\");\n\nconst identity = harnessIdentity();\nconst availableTaskIds = fs.readdirSync(tasksDir).filter((d) => {\n  const entry = path.join(tasksDir, d);\n  try { return fs.lstatSync(entry).isDirectory() && fs.existsSync(path.join(entry, \"task.json\")); }\n  catch { return false; }\n}).sort();\nconst tasks = availableTaskIds.filter((d) => !only || only.has(d));\nconst taskSnapshots = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-task-snapshot-\"));\nfs.chmodSync(taskSnapshots, 0o700);\nprocess.on(\"exit\", () => fs.rmSync(taskSnapshots, { recursive: true, force: true }));\nconst taskRecords = [];\nfor (const id of tasks) {\n  const source = confinedPath(tasksDir, id);\n  assertNoSymlinks(source);\n  const before = taskTreeDigest(source);\n  const snapshot = path.join(taskSnapshots, id);\n  fs.cpSync(source, snapshot, { recursive: true, verbatimSymlinks: true });\n  if (taskTreeDigest(snapshot) !== before) throw new Error(`task ${id} changed while the runner froze its input`);\n  const taskFile = confinedPath(snapshot, \"task.json\");\n  taskRecords.push({ id, dir: snapshot, treeSha256: before, task: JSON.parse(fs.readFileSync(taskFile, \"utf8\")) });\n}\nif (config.qualification === true && only) {\n  console.error(\"eval/run.mjs: qualification task subsets are forbidden; use a frozen corpus run or an explicitly recorded infrastructure-pair rerun\");\n  process.exit(2);\n}\nif (config.qualification === true && config.proxy === false) {\n  console.error(\"eval/run.mjs: qualification requires the authenticated per-run model proxy\");\n  process.exit(2);\n}\nif (!sandboxAvailable()) {\n  console.error(\"eval/run.mjs: Bubblewrap unavailable; refusing to execute task-controlled setup and validators\");\n  process.exit(2);\n}\nconst apiKey = readApiKey(config.apiKey);\nconst caFile = config.caFile ? expandHome(config.caFile) : null;\nconst caBundle = caFile ? writeCaBundle(caFile) : null;\n\n// A run is valid only with well-formed tasks, hidden tests the agent cannot read, and (for qualification) a model\n// identified beyond its alias. Any problem stops the run before an agent starts (eval/validate.mjs).\nconst problems = taskRecords.flatMap(({ id, dir, task }) => {\n  return validateTask(task, dir, { qualification: config.qualification === true }).map((p) => `${id}: ${p}`);\n});\nconst isolation = hiddenTestIsolationProblem(config, tasksDir);\nif (isolation) problems.push(isolation);\n// Qualification proves the resource contract inside hiddenTestIsolationProblem; a development config may opt in.\nif (config.resources !== undefined && config.qualification !== true) {\n  const resourceProblem = resourceProbeProblem(config.resources);\n  if (resourceProblem) problems.push(resourceProblem);\n}\nif (config.resources !== undefined && args.keep) problems.push(\"--keep would accumulate run workspaces on the size-capped resources.workspaceRoot\");\nif (config.qualification === true) {\n  const corpusProblem = corpusManifestProblem(config, tasksDir, tasks, corpusTaskRows(taskSnapshots, tasks));\n  if (corpusProblem) problems.push(corpusProblem);\n}\nif (config.qualification === true && config.sampling?.temperature !== 0) {\n  problems.push(\"qualification adapters require sampling.temperature=0 so the matched Nexus, Goose and OpenCode runs use the same deterministic setting\");\n}\nif (config.qualification === true) {\n  const budgetProblem = qualificationBudgetProblem(config);\n  if (budgetProblem) problems.push(budgetProblem);\n}\nconst agentIdentity = problems.length ? { record: null, problem: null } : await resolveAgentIdentity(config);\nif (agentIdentity.problem) problems.push(agentIdentity.problem);\nlet fingerprint = null;\nif (!problems.length) {\n  const probe = config.proxy === false ? null : await startModelProxy({ upstream: config.endpoint, caFile });\n  try {\n    const entry = await fetchModelEntry(probe?.url ?? config.endpoint, config.model, apiKey);\n    const fp = modelFingerprint(config, entry);\n    fingerprint = fp.fingerprint;\n    problems.push(...fp.missing.map((m) => `model fingerprint: ${m}`));\n    if (config.qualification === true && (config.agent ?? \"nexus\") === \"nexus\") {\n      const limitsProblem = nexusLimitsProblem(config, entry);\n      if (limitsProblem) problems.push(limitsProblem);\n    }\n  } finally {\n    await probe?.close();\n  }\n}\nif (problems.length) {\n  console.error(`eval/run.mjs: not starting; ${problems.length} problem(s):\\n${problems.map((p) => `  - ${p}`).join(\"\\n\")}`);\n  process.exit(2);\n}\nconst frozenTaskRows = taskRecords.map(({ id }) => corpusTaskRows(taskSnapshots, [id])[0]);\nfs.writeFileSync(path.join(args.out, \"manifest.json\"), JSON.stringify({\n  createdAt: new Date().toISOString(),\n  harness: identity,\n  config: redactConfig(config),\n  configSha256,\n  qualificationCorpus: config.qualification === true ? { manifestSha256: config.corpusManifestSha256, tasks: frozenTaskRows } : null,\n  fingerprint,\n  agentVersion: agentIdentity.record,\n  budget: effectiveBudget({}, config),\n  runs,\n  tasks: frozenTaskRows,\n  host: os.hostname(),\n  node: process.version,\n}, null, 2) + \"\\n\");\n\n// Run-major order (every task once, then again): a pass cut short still has the same number of runs per task.\nfor (let run = 1; run <= runs; run++) {\n  for (const { id, dir, treeSha256, task: taskData } of taskRecords) {\n    if (pairs && !pairs.some(([t, r]) => t === id && Number(r) === run)) continue;\n    if (taskTreeDigest(dir) !== treeSha256) throw new Error(`frozen task ${id} changed after manifest creation`);\n    const task = { ...taskData, dir };\n    const record = await runOnce(task, run);\n    fs.appendFileSync(resultsFile, JSON.stringify(record) + \"\\n\");\n    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\n  }\n}\n\nasync function runOnce(task, run) {\n  // Under the resource contract these are on a tmpfs, so candidate writes count against the run's memory limit.\n  const scratch = config.resources?.workspaceRoot ?? os.tmpdir();\n  const ws = fs.mkdtempSync(path.join(scratch, `nexus-eval-${task.id}-`));\n  const checkDirs = [];\n  const home = fs.mkdtempSync(path.join(scratch, \"nexus-eval-home-\"));\n  const budget = effectiveBudget(task, config);\n  const base = { task: task.id, tier: task.tier, ...(task.tier === \"T3\" ? { t3SteeringItems: task.steering.length } : {}), config: config.name, agent: config.agent ?? \"nexus\", agentVersion: agentIdentity.record, budget, run, harness: identity.string, model: config.model, startedAt: new Date().toISOString() };\n  try {\n    await prepareWorkspace(task, ws);\n    // Taken now, while .git is the harness's own: after the agent runs, nothing executes git against its workspace.\n    const baselineTree = gitRev(ws, \"HEAD^{tree}\");\n    const t3Baseline = task.tier === \"T3\" ? steeringBaseline(task, ws) : null;\n    // On the per-run task copy, so the steering hook in runAgent can read it. The commands run on a throwaway copy of\n    // the staged workspace, so the agent starts on exactly the staged tree.\n    const t3BaselineResources = [];\n    if (task.tier === \"T3\") {\n      const probe = fs.mkdtempSync(path.join(scratch, `nexus-eval-t3-baseline-${task.id}-`));\n      try {\n        fs.cpSync(ws, probe, { recursive: true, verbatimSymlinks: true });\n        task.t3CommandBaseline = await commandBaseline(task, (command) => runIsolated(command, { cwd: probe, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => {\n          if (r.resources) t3BaselineResources.push(r.resources);\n          const error = r.containmentProblem ?? (r.timedOut ? \"timed out\" : r.overflow ? \"output limit\" : r.status === null ? \"did not exit\" : null);\n          return { pass: r.status === 0 && !error, error };\n        }));\n      } finally {\n        fs.rmSync(probe, { recursive: true, force: true });\n      }\n    }\n    const sourceBefore = treeDigest(task.dir);\n    // Every agent reaches the model through a per-run forwarder, so whether the model was reachable is observed by the\n    // harness, the same way for every agent (eval/infra.mjs). `config.proxy: false` connects agents directly.\n    // T4: a task (or the config) may schedule faults for the proxy to inject; they are recorded with the run.\n    const faults = task.faults ?? config.faults ?? [];\n    if (faults.length && config.proxy === false) throw new Error(\"fault injection needs the model proxy (proxy: false is set)\");\n    // A standalone profile (DEC-16) shows agents a plain server; the proxy then holds the real key, agents get none.\n    if (config.serverProfile && config.proxy === false) throw new Error(\"serverProfile needs the model proxy (proxy: false is set)\");\n    const proxyDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-proxy-\"));\n    fs.chmodSync(proxyDir, 0o700);\n    const socketPath = path.join(proxyDir, \"proxy.sock\");\n    const localToken = REDACTED;\n    const proxy = await startModelProxy({\n      upstream: config.endpoint,\n      caFile,\n      faults,\n      profile: config.serverProfile,\n      authToken: apiKey ?? undefined,\n      clientToken: localToken,\n      socketPath,\n      maxRequests: config.limits?.requests ?? 1_000,\n      maxCompletionTokens: config.limits?.output,\n      maxTotalCompletionTokens: config.limits?.totalOutput,\n    });\n    const started = Date.now();\n    let agent;\n    let agentEndedAt;\n    try {\n      agent = await runAgent(task, ws, home, budget, agentIdentity, proxyDir, localToken);\n      agentEndedAt = Date.now();\n      if (config.runAs) {\n        for (const dir of [ws, home]) await normalizeRunAsPermissions(config.runAs, dir, asUserSpec);\n      }\n    } finally {\n      await proxy?.close();\n      fs.rmSync(proxyDir, { recursive: true, force: true });\n    }\n    const wallMs = agentEndedAt - started;\n    if (agent.containmentProblem) throw new Error(`candidate containment failed: ${agent.containmentProblem}`);\n    const model = proxy ? proxy.stats() : null;\n    const contaminated = treeDigest(task.dir) !== sourceBefore || `${agent.stdout}${agent.stderr}`.includes(tasksDir);\n    // T3 judges the workspace as it was when the objective's work ended (snapshot taken before the probe turn).\n    const t3 = agent.t3Driver ? scoreT3Run({ task, baseline: t3Baseline, driver: agent.t3Driver, preconditions: agent.t3Preconditions, compactions: countCompactions(home) }) : null;\n    // Legacy hidden tests share a process with candidate code. In qualification (or with hardenedChecks) they never\n    // run in the agent's workspace: each check gets a fresh staging of the baseline with only the agent's source\n    // changes (eval/hardened_check.mjs). Black-box oracles already keep expectations outside the candidate.\n    const hardened = (config.qualification === true || config.hardenedChecks === true) && task.hidden?.protocol !== \"blackbox-v1\";\n    let hardening = null;\n    let hiddenWs = ws;\n    let regressionWs = ws;\n    if (hardened) {\n      hiddenWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-check-${task.id}-`));\n      regressionWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-regression-${task.id}-`));\n      checkDirs.push(hiddenWs, regressionWs);\n      await prepareWorkspace(task, hiddenWs);\n      // Fixture tasks commit at staging time, so compare content (the tree), not the commit id.\n      if (gitRev(hiddenWs, \"HEAD^{tree}\") !== baselineTree) throw new Error(\"hardened check workspace staged a different baseline\");\n      hardening = { baseline: baselineTree, ...applyAgentChanges(ws, hiddenWs) };\n      cloneWorkspace(hiddenWs, regressionWs);\n    }\n    const refused = (check) => ({ pass: false, status: null, timedOut: false, overflow: false, output: `hardened check refused: ${hardening.configChanges.join(\"; \")}`, refused: true, resources: null, containmentProblem: null, check });\n    const hidden = hardening?.configChanges.length ? refused(\"hidden\") : await runCheck(task, hiddenWs, task.hidden, true, { readOnlyHidden: hardened });\n    const regression = task.regression ? (hardening?.configChanges.length ? refused(\"regression\") : await runCheck(task, regressionWs, task.regression, false)) : null;\n    for (const [phase, check] of [[\"hidden\", hidden], [\"regression\", regression]]) {\n      if (check?.containmentProblem) throw new Error(`${phase} check containment failed: ${check.containmentProblem}`);\n    }\n    const turn = agent.json?.turn ?? null;\n    // Nexus reports a structured outcome; for the other agents a clean exit within the budget is their completion claim.\n    const claimedComplete = turn\n      ? turn.execution === \"COMPLETED\" && [\"VERIFIED\", \"REGRESSION_FREE\", \"UNVERIFIED\", \"NOT_REQUIRED\"].includes(turn.outcome)\n      : agent.code === 0 && !agent.timedOut && !agent.outputExceeded;\n    return {\n      ...base,\n      wallMs,\n      exitCode: agent.code,\n      timedOut: agent.timedOut,\n      outputExceeded: agent.outputExceeded,\n      turn: turn && { execution: turn.execution, outcome: turn.outcome, reason: turn.reason ?? null, steps: turn.steps ?? null, contextNotRetained: turn.contextNotRetained ?? 0 },\n      claimedComplete,\n      claimedVerified: turn?.outcome === \"VERIFIED\",\n      hiddenPass: hidden.pass,\n      regressionPass: regression ? regression.pass : null,\n      falseVerified: turn?.outcome === \"VERIFIED\" && !hidden.pass,\n      contaminated,\n      tokens: agent.json?.tokenStats ?? null,\n      ...(hardening ? { hardened: { baseline: hardening.baseline, applied: hardening.applied.length, discarded: hardening.discarded, configChanges: hardening.configChanges } } : {}),\n      ...(t3 ? { t3 } : {}),\n      model,\n      resources: config.resources ? { agent: agent.resources, hidden: hidden.resources ?? null, regression: regression?.resources ?? null, ...(t3BaselineResources.length ? { t3Baseline: t3BaselineResources } : {}) } : null,\n      logs: saveLogs(task, run, agent, hidden, regression),\n    };\n  } catch (err) {\n    return { ...base, wallMs: 0, error: String(err?.message ?? err), hiddenPass: false, regressionPass: null, falseVerified: false, claimedComplete: false, claimedVerified: false };\n  } finally {\n    if (!args.keep) {\n      for (const dir of checkDirs) fs.rmSync(dir, { recursive: true, force: true });\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n    }\n  }\n}\n\nasync function prepareWorkspace(task, ws) {\n  if (task.fixture) {\n    const fixture = confinedPath(task.dir, task.fixture);\n    assertNoSymlinks(fixture);\n    fs.cpSync(fixture, ws, { recursive: true, verbatimSymlinks: true });\n    sh(\"git\", [\"init\", \"-q\"], ws);\n    sh(\"git\", [\"add\", \"-A\"], ws);\n    sh(\"git\", [\"-c\", \"user.name=eval\", \"-c\", \"user.email=eval@example.invalid\", \"commit\", \"-qm\", \"fixture\"], ws);\n  } else if (task.repo) {\n    const cache = path.join(ROOT, \"eval/.cache\", createHash(\"sha256\").update(task.repo.url).digest(\"hex\").slice(0, 16));\n    if (!fs.existsSync(cache)) sh(\"git\", [\"clone\", \"-q\", \"--no-checkout\", task.repo.url, cache], ROOT);\n    const object = `${task.repo.commit}^{commit}`;\n    if (sh(\"git\", [\"-C\", cache, \"cat-file\", \"-e\", object], ROOT, true) !== 0) sh(\"git\", [\"-C\", cache, \"fetch\", \"-q\", \"origin\", task.repo.commit], ROOT);\n    stageRepoWorkspace(cache, task.repo.commit, ws);\norigin/main:.github/workflows/ci.yml:26:      - run: bash scripts/ensure-ci-user-cgroups.sh\norigin/main:.github/workflows/ci.yml:91:      - run: bash scripts/ensure-ci-user-cgroups.sh\norigin/main:.github/workflows/release.yml:28:      - run: bash scripts/ensure-ci-user-cgroups.sh\norigin/main:cli/test/app.test.ts:209:    // Checkpoint verified on disk\norigin/main:cli/test/app.test.ts:261:    // Verify file remains on disk\norigin/main:cli/test/authority.test.ts:445:  test(\"F-WP02-MAT-01: Read-only mode denies shell composition and prevents disk side effects through ExecutionSpine\", async () => {\norigin/main:cli/test/authority.test.ts:494:    // Verify disk state has ZERO side-effect files\norigin/main:cli/test/authority.test.ts:495:    assert.strictEqual(fs.existsSync(sideEffectFile1), false, \"Pipe side effect must not exist on disk\");\norigin/main:cli/test/authority.test.ts…874 tokens truncated…om disk while the command is still running.\norigin/main:cli/test/durable_continuity.test.ts:1678:  test(\"a high-entropy invocation id is redacted on disk, yet the operation is recorded as completed; recorded progress clears it\", () => {\norigin/main:cli/test/eval_integrity.test.ts:525:  assert.match(qualificationResourceIsolationProblem(), /enforced CPU, memory, process-count, and workspace-storage limits/);\norigin/main:cli/test/eval_integrity.test.ts:595:    assert.equal(memory.resources.limits[\"memory.max\"], String(memoryBytes));\norigin/main:cli/test/eval_integrity.test.ts:605:    // to the task cgroup and must hit memory.max. Neither failure may leave a task process behind.\norigin/main:cli/test/eval_integrity.test.ts:618:    assert.equal(cpu.resources.limits[\"cpu.max\"], \"20000 100000\");\norigin/main:cli/test/eval_integrity.test.ts:622:    // The wall-clock kill goes through the cgroup, so the supervisor still proves cleanup.\norigin/main:cli/test/eval_integrity.test.ts:638:    // A process that leaves the session and process group is still found in, and removed from, the cgroup.\norigin/main:cli/test/eval_integrity.test.ts:648:    assert.equal(fs.existsSync(escapedMarker), false, \"a session-escaped task process survived cgroup cleanup\");\norigin/main:cli/test/eval_integrity.test.ts:779:    const objectProbe = `const cp=require('node:child_process'),fs=require('node:fs'),path=require('node:path');const run=(args)=>cp.spawnSync('git',args,{cwd:'/workspace',encoding:'utf8',env:{PATH:'/usr/bin:/bin',HOME:'/home/eval',GIT_CONFIG_NOSYSTEM:'1',GIT_CONFIG_GLOBAL:'/dev/null'}});let disk='';const walk=(d)=>{for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory())walk(p);else try{disk+=fs.readFileSync(p).toString('utf8')}catch{}}};walk('/workspace/.git');console.log(JSON.stringify({fsck:run(['fsck','--unreachable']),all:run(['cat-file','--batch-check=%(objectname)','--batch-all-objects']),blob:run(['cat-file','-p',process.argv[1]]),commit:run(['cat-file','-p',process.argv[2]]),disk}))`;\norigin/main:cli/test/eval_integrity.test.ts:788:    assert.doesNotMatch(`${objectObserved.disk}${objectObserved.fsck.stderr}${objectObserved.blob.stderr}${objectObserved.commit.stderr}`, /DANGLING_(?:BLOB|COMMIT)_CANARY_999/);\norigin/main:cli/test/evidence.test.ts:136:  test(\"a receipt read back from disk with missing fields drops those rows instead of sending null\", () => {\norigin/main:cli/test/flight_exclude.test.ts:51:    // Verify flight log exists on disk\norigin/main:cli/test/flight_exclude.test.ts:53:    assert.strictEqual(fs.existsSync(flightLogPath), true, \"Flight log must exist on disk\");\norigin/main:cli/test/flight_sanitization.test.ts:24:test(\"FlightRecorder irreversibly sanitizes nested secrets before appended disk writes\", () => {\norigin/main:cli/test/harness.test.ts:448:        const file = await dryRun.bridge.executeTool(\"write_file\", { path: \"simulated.txt\", content: \"no disk write\" });\norigin/main:cli/test/harness.test.ts:1055:  test(\"RustCoreBridge dry-run mode intercepts mutations without modifying disk\", async () => {\norigin/main:cli/test/persistence_protection.test.ts:389:test(\"REPL history loading scrubs legacy plaintext on disk before returning recovered history\", () => {\norigin/main:cli/test/retention.test.ts:174:      // Verify pinned and current survived on disk\norigin/main:cli/test/retention.test.ts:175:      assert.ok(fs.existsSync(path.join(sessionsDir, \"session-0010.json\")), \"Pinned session must survive on disk\");\norigin/main:cli/test/retention.test.ts:176:      assert.ok(fs.existsSync(path.join(sessionsDir, \"session-0020.json\")), \"Current session must survive on disk\");\norigin/main:cli/test/sidecar_steering_diff.test.ts:250:      // The complete diff is also kept on disk beside the saved session, private to the operator.\norigin/main:cli/test/sidecar_steering_diff.test.ts:269:  test(\"a record dropped from memory still yields its complete diff from disk\", async () => {\norigin/main:eval/README.md:106:The remaining T4 classes come from task fixtures (a hanging test command, a full disk) and from the SIGTERM-then-resume\norigin/main:eval/README.md:240:- Each execution runs under `eval/cgroup_supervisor.mjs` as the only process of its own delegated transient\norigin/main:eval/README.md:241:  `systemd-run --user --scope`. The supervisor writes cgroup v2 `cpu.max` (`cpuPercent`% of one CPU), `memory.max`\norigin/main:eval/README.md:242:  (`memoryBytes`), `memory.swap.max` (0), `memory.oom.group` (1) and `pids.max` (`tasks`) on a `payload` leaf, reads them back, and refuses to\norigin/main:eval/README.md:249:  The preflight checks `/proc/self/mountinfo`, the mount root and options, the effective tmpfs size, and the cgroup\norigin/main:eval/README.md:253:- Within that cap, tmpfs pages, including the sandbox's own `/tmp`, are charged to the writing phase's memory cgroup and\norigin/main:eval/README.md:255:  it reaches that bound the whole phase is OOM-killed (`memory.oom.group`), and this is recorded. When a phase's cgroup\norigin/main:eval/README.md:256:  is removed, the kernel moves its charges to the unlimited parent cgroup. Later phases get their own `memoryBytes`,\norigin/main:eval/README.md:259:- CPU is bounded in rate by `cpu.max` and in total by the phase's wall-clock timeout.\norigin/main:eval/README.md:260:- This contract is supported only on Linux with cgroup v2 CPU, memory and pids controllers, a delegated systemd user\norigin/main:eval/README.md:264:- After the command exits or times out, the supervisor records the remaining processes, empties the cgroup with\norigin/main:eval/README.md:265:  `cgroup.kill` (which reaches daemonized processes and other uids), and waits for `populated 0`. A timeout or output\norigin/main:eval/README.md:274:  provisions delegation with `scripts/ensure-ci-user-cgroups.sh`, and the fixture tests in\norigin/main:eval/cgroup_supervisor.mjs:4:// cgroup (cgroup.kill reaches processes of another uid and ones that left the process group or session).\norigin/main:eval/cgroup_supervisor.mjs:6:// fd 3 receives JSON lines: { cgroup } once the payload leaf exists, then exactly one final report.\norigin/main:eval/cgroup_supervisor.mjs:25:const own = (read(\"/proc/self/cgroup\") ?? \"\").split(\"\\n\").find((line) => line.startsWith(\"0::\"))?.slice(3);\norigin/main:eval/cgroup_supervisor.mjs:27:const scope = path.join(\"/sys/fs/cgroup\", own);\norigin/main:eval/cgroup_supervisor.mjs:32:const wanted = { \"memory.max\": String(memoryBytes), \"memory.swap.max\": \"0\", \"memory.oom.group\": \"1\", \"pids.max\": String(tasks), \"cpu.max\": `${cpuPercent * 1000} 100000` };\norigin/main:eval/cgroup_supervisor.mjs:36:  fs.writeFileSync(path.join(supervisor, \"cgroup.procs\"), String(process.pid));\norigin/main:eval/cgroup_supervisor.mjs:37:  fs.writeFileSync(path.join(scope, \"cgroup.subtree_control\"), \"+cpu +memory +pids\");\norigin/main:eval/cgroup_supervisor.mjs:45:report({ cgroup: payload });\norigin/main:eval/cgroup_supervisor.mjs:49:// The shell joins the payload cgroup before exec, so nothing task-controlled ever runs outside the limits.\norigin/main:eval/cgroup_supervisor.mjs:50:const child = spawn(\"/bin/sh\", [\"-c\", 'echo $$ > \"$1\" && shift && exec \"$@\"', \"sh\", path.join(payload, \"cgroup.procs\"), spec.cmd, ...spec.argv], {\norigin/main:eval/cgroup_supervisor.mjs:54:const killPayload = () => { try { fs.writeFileSync(path.join(payload, \"cgroup.kill\"), \"1\"); } catch {} };\norigin/main:eval/cgroup_supervisor.mjs:64:  const procs = (read(path.join(payload, \"cgroup.procs\")) ?? \"\").split(\"\\n\").filter(Boolean);\norigin/main:eval/cgroup_supervisor.mjs:82:    if (/^populated 0$/m.test(read(path.join(payload, \"cgroup.events\")) ?? \"\")) {\norigin/main:eval/cgroup_supervisor.mjs:87:      report({ ...stats, cleaned: false, exitCode: code, signal, spawnError, error: \"payload cgroup still populated after cgroup.kill\" });\norigin/main:eval/hide_oracle.cjs:1:// Keep the oracle source available for its first Node module load, while hiding it from task code on disk.\norigin/main:eval/host/README.md:5:systemd 255, cgroup v2 with `cpu memory pids` delegated to the operator's user manager. Inference is remote (the\norigin/main:eval/host/README.md:41:run's cgroup. `validate.mjs` checks this.\norigin/main:eval/host/README.md:53:| `cpuPercent` | 800 | `cpu.max = 800000 100000`. The payload's processes may together use at most 8 CPUs' worth of runtime per wall-clock second. This is **rate throttling, not a total budget**. Total CPU time is bounded only by the phase's wall-clock limit times 8, and each phase's `cpuUsageUsec` and `cpuThrottledUsec` are recorded. |\norigin/main:eval/host/README.md:54:| `memoryBytes` | 16 GiB | `memory.max`, with `memory.swap.max = 0` and `memory.oom.group = 1`. The charge counts the phase's anonymous memory, the page cache it faults in (reclaimable before OOM), **and the tmpfs pages it writes**. A phase that writes 6 GiB of build output therefore has about 10 GiB left for its processes. Exceeding the limit OOM-kills the whole phase, and this is recorded. |\norigin/main:eval/host/README.md:55:| `tasks` | 4096 | `pids.max`. This counts threads, not just processes: Go test binaries, `cargo` with parallel `rustc`, and Node/Bun worker threads all consume tasks. |\norigin/main:eval/host/README.md:56:| `storageBytes` | 20 GiB | The size of the dedicated tmpfs. It caps everything a run holds in its workspace and home **across phases**, because when a phase's cgroup is removed, its tmpfs charges move to the unlimited parent. Writes beyond the cap fail with `ENOSPC`. Runs are serial, and each run's directories are removed afterwards. |\norigin/main:eval/host/validate.mjs:80:await check(\"evaluator processes stay in the limited cgroup, and every one is reaped\", async () => {\norigin/main:eval/host/validate.mjs:89:    const sandboxed = await contained(isolatedArgv({ cwd: dir, home: false, command: \"id -u > /workspace/uid; cat /proc/self/cgroup > /workspace/cgroup; mkdir -p /workspace/private; echo secret > /workspace/private/f; chmod 600 /workspace/private/f; chmod 700 /workspace/private\", timeoutSec: 30 }));\norigin/main:eval/host/validate.mjs:92:    must(/\\/payload$/.test(fs.readFileSync(path.join(dir, \"cgroup\"), \"utf8\").trim()), \"evaluator process is not in the payload cgroup\");\norigin/main:eval/host/validate.mjs:95:    // Without a PID namespace nothing but the cgroup can reap a daemon: the operator-side supervisor must find the\norigin/main:eval/host/validate.mjs:98:    must(daemon?.survivorsAfterExit >= 1, `the evaluator daemon was not left for the cgroup to reap: ${JSON.stringify(daemon)}`);\norigin/main:eval/host/validate.mjs:139:      [{ ...base, resources: undefined }, /enforced CPU, memory, process-count, and workspace-storage limits/],\norigin/main:eval/host/validate.mjs:166:  sourceDigests: [\"eval/host/validate.mjs\", \"eval/host/operator_home.mjs\", \"eval/host/bubblewrap.mjs\", \"eval/host/provision.sh\", \"eval/host/rollback.sh\", \"eval/host/resource-profile.json\", \"eval/resources.mjs\", \"eval/cgroup_supervisor.mjs\", \"eval/isolate.mjs\", \"eval/validate.mjs\", \"eval/run.mjs\", \"eval/hardened_check.mjs\", \"eval/hide_oracle.cjs\", \"eval/hide_oracle.py\", \"eval/unlink_then_exec.sh\", \"eval/workspace.mjs\"].map((file) => ({ file, sha256: createHash(\"sha256\").update(fs.readFileSync(path.join(ROOT, file))).digest(\"hex\") })),\norigin/main:eval/isolate.mjs:371:    // Contained runs are stopped through their cgroup, so the supervisor survives to prove cleanup.\norigin/main:eval/model_proxy.mjs:21: * The other T4 classes (a hanging test command, a full disk, SIGTERM then resume) come from task fixtures and the runner.\norigin/main:eval/resources.mjs:2:// Each execution runs in its own delegated transient systemd --user scope under eval/cgroup_supervisor.mjs, which\norigin/main:eval/resources.mjs:3:// applies cgroup v2 cpu.max, memory.max (swap 0) and pids.max to a payload leaf, verifies them, and kills the whole\norigin/main:eval/resources.mjs:4:// cgroup afterwards. Workspaces and homes live on a dedicated size-capped tmpfs (storageBytes): that cap bounds\norigin/main:eval/resources.mjs:5:// everything a run keeps on disk across phases, and each phase's writes are additionally charged to its memory.max.\norigin/main:eval/resources.mjs:12:const SUPERVISOR = fileURLToPath(new URL(\"./cgroup_supervisor.mjs\", import.meta.url));\norigin/main:eval/resources.mjs:38:  catch { return \"resources.workspaceRoot mount table is unavailable; refusing unverified workspace storage limits\"; }\norigin/main:eval/resources.mjs:45:  if (matching.length > 1) return \"resources.workspaceRoot has stacked or duplicate mount records; refusing ambiguous workspace storage boundary\";\norigin/main:eval/resources.mjs:108: * Spawn `spec` (contained when `resources` is set). `containment.kill()` empties the payload cgroup;\norigin/main:eval/resources.mjs:116:  let cgroup = null;\norigin/main:eval/resources.mjs:120:      cgroup ??= parseReports(text).cgroup;\norigin/main:eval/resources.mjs:127:  const killPayload = () => { if (cgroup) { try { fs.writeFileSync(path.join(cgroup, \"cgroup.kill\"), \"1\"); } catch {} } };\norigin/main:eval/resources.mjs:147:  if (!final.cleaned) return \"payload cgroup was not emptied\";\norigin/main:eval/resources.mjs:152:  let cgroup = null;\norigin/main:eval/resources.mjs:158:    if (value.cgroup && Object.keys(value).length === 1) cgroup = value.cgroup;\norigin/main:eval/resources.mjs:161:  return { cgroup, final };\norigin/main:eval/run.mjs:601:    // Under the resource contract the cgroup is emptied instead, so the supervisor survives to report cleanup.\norigin/main:eval/run.mjs:696:  const sourceFiles = [\"eval/run.mjs\", \"eval/validate.mjs\", \"eval/isolate.mjs\", \"eval/hide_oracle.cjs\", \"eval/hide_oracle.py\", \"eval/unlink_then_exec.sh\", \"eval/agent_sandbox.mjs\", \"eval/model_proxy.mjs\", \"eval/score.mjs\", \"eval/infra.mjs\", \"eval/workspace.mjs\", \"eval/resources.mjs\", \"eval/cgroup_supervisor.mjs\", \"eval/t3.mjs\", \"eval/hardened_check.mjs\"];\norigin/main:eval/validate.mjs:279:    return \"qualification is blocked until the candidate and validators inherit enforced CPU, memory, process-count, and workspace-storage limits (set resources)\";\norigin/main:scripts/ensure-ci-user-cgroups.sh:6:# pids cgroup v2 controllers. Hosted runners have no user manager for the runner\norigin/main:scripts/ensure-ci-user-cgroups.sh:17:    /bin/sh -c 'c=$(cat \"/sys/fs/cgroup$(cut -d: -f3 /proc/self/cgroup)/cgroup.controllers\"); for k in cpu memory pids; do case \" $c \" in *\" $k \"*) ;; *) exit 1 ;; esac; done' \\\norigin/main:scripts/terminal-acceptance/README.md:49:A measured survivor or unavailable systemd-scope measurement fails check 5, and an unrestored terminal fails check 6, whatever you recorded. A zero survivor count is recorded only when the scope's `cgroup.procs` file was readable or systemd confirmed the scope stopped or disappeared. Missing or unreadable scope data while the unit is active is recorded as unavailable and fails the matrix gate. Each cell writes\norigin/main:scripts/terminal-acceptance/README.md:57:populated cgroups, stopped and missing units, unavailable or malformed measurements, and the summary gate's response\norigin/main:scripts/terminal-acceptance/run-cell.sh:118:# Each launch runs in its own transient systemd user scope. The cgroup probe\norigin/main:scripts/terminal-acceptance/run-cell.sh:119:# reports zero only for a readable empty cgroup or a scope systemd confirms is\norigin/main:scripts/terminal-acceptance/scope-procs.sh:6:  local cgroup_root=\"${NEXUS_CGROUP_ROOT:-/sys/fs/cgroup}\"\norigin/main:scripts/terminal-acceptance/scope-procs.sh:21:    process_file=\"${cgroup_root%/}${control_group}/cgroup.procs\"\norigin/main:scripts/terminal-acceptance/scope-procs.sh:29:  # A stopped, loaded unit with no remaining cgroup has no processes. An\norigin/main:scripts/terminal-acceptance/scope-procs.sh:30:  # active unit with missing/unreadable cgroup data is an unknown measurement.\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:9:mkdir -p \"$tmp/bin\" \"$tmp/cgroup/user.slice/test.scope\"\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:25:export PATH FIXTURE_STATE_DIR=\"$tmp/state\" NEXUS_CGROUP_ROOT=\"$tmp/cgroup\"\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:46:: > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:48:printf '101\\n202\\n' > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:51:python3 -c 'import os,sys; os.unlink(sys.argv[1])' \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:53:: > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:54:chmod 000 \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:56:chmod 600 \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:57:printf 'not-a-pid\\n' > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:59:python3 -c 'import os,sys; os.unlink(sys.argv[1])' \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:60:mkdir \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\norigin/main:scripts/terminal-acceptance/test-scope-procs.sh:62:python3 -c 'import os,sys; os.rmdir(sys.argv[1])' \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\neval/.gitignore\neval/README.md\neval/T3.md\neval/agent_sandbox.mjs\neval/cgroup_supervisor.mjs\neval/configs/gateway-engineering-deep.json\neval/configs/pilot-aider.json\neval/configs/pilot-goose.json\neval/configs/pilot-nexus.json\neval/configs/pilot-opencode.json\neval/hardened_check.mjs\neval/heldout-manifest.json\neval/heldout-t3-manifest.json\neval/hide_oracle.cjs\neval/hide_oracle.py\neval/host/README.md\neval/host/bubblewrap.mjs\neval/host/container-test/run.sh\neval/host/container-test/systemctl-shim\neval/host/operator_home.mjs\neval/host/provision.sh\neval/host/resource-profile.json\neval/host/rollback.sh\neval/host/validate.mjs\neval/infra.mjs\neval/isolate.mjs\neval/model_proxy.mjs\neval/oracle.mjs\neval/resources.mjs\neval/run.mjs\neval/score.mjs\neval/standalone/plain_proxy.mjs\neval/t3.mjs\neval/tasks/selftest-add/hidden/math.hidden.test.js\neval/tasks/selftest-add/repo/package.json\neval/tasks/selftest-add/repo/test/other.test.js\neval/tasks/selftest-add/task.json\neval/tasks/t2-bugfix-csv/hidden/csv.hidden.test.js\neval/tasks/t2-bugfix-csv/repo/csv.js\neval/tasks/t2