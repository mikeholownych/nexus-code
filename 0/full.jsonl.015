{"timestamp":"2026-10-24T17:27:30.434Z","ordinal":298988,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16eee-fedb-7732-9ae7-8cbb47107b53","item":{"type":"CommandExecution","id":"exec-6147035a-e52b-4e3f-9be9-5942219d45ca","process_id":"33409","command":["/usr/bin/zsh","-lc","git worktree list --porcelain | rg -B1 -A3 'git-exclude-fail-closed'; git show --stat --oneline v1/defect-git-exclude-fail-closed; git show origin/main:cli/src/core/git_exclude.ts | sed -n '1,220p'; git show v1/defect-git-exclude-fail-closed:cli/src/core/git_exclude.ts | sed -n '1,220p'; gh pr list --state all --head v1/defect-git-exclude-fail-closed --json number,title,state,headRefOid,baseRefName,url"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git worktree list --porcelain | rg -B1 -A3 'git-exclude-fail-closed'; git show --stat --oneline v1/defect-git-exclude-fail-closed; git show origin/main:cli/src/core/git_exclude.ts | sed -n '1,220p'; git show v1/defect-git-exclude-fail-closed:cli/src/core/git_exclude.ts | sed -n '1,220p'; gh pr list --state all --head v1/defect-git-exclude-fail-closed --json number,title,state,headRefOid,baseRefName,url"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"\nworktree /home/mike/nexus-wt/git-exclude-fail-closed\nHEAD 44a3793f404a1a3dcb430d27cd6157a429b25407\nbranch refs/heads/v1/defect-git-exclude-fail-closed\n\nworktree /home/mike/nexus-wt/git-exclude-substring\nHEAD d9f6dfc1c0ede0a520694131d12de204fcd33671\n44a3793 fix(git): verify nexus state exclusions\n cli/src/core/git_exclude.ts  | 89 +++++++++++++++++++++++---------------------\n cli/test/git_exclude.test.ts | 44 ++++++++++++++++++++++\n 2 files changed, 91 insertions(+), 42 deletions(-)\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\n\n/**\n * Ensures .nexus/ is ignored by Git in the workspace by adding it to .git/info/exclude (REQ-PER-105).\n * Called on first workspace write by FlightRecorder and WorktreeManager.\n */\nexport function ensureGitExclude(workspace: string): void {\n  try {\n    let excludePath: string | null = null;\n    try {\n      const out = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n        cwd: workspace,\n        encoding: \"utf-8\",\n        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n      }).trim();\n      if (out) {\n        excludePath = path.isAbsolute(out) ? out : path.resolve(workspace, out);\n      }\n    } catch {\n      // Fallback if git binary or rev-parse fails\n      const candidate = path.join(workspace, \".git\", \"info\", \"exclude\");\n      if (fs.existsSync(path.dirname(candidate))) {\n        excludePath = candidate;\n      }\n    }\n\n    if (!excludePath) return;\n\n    if (fs.existsSync(excludePath)) {\n      const content = fs.readFileSync(excludePath, \"utf-8\");\n      const rules = new Set(content.split(/\\r?\\n/).map((line) => line.trim()));\n      // Match whole rules, not substrings: a comment or an unrelated pattern that merely mentions\n      // `.nexus` must not suppress the ignore rule (then `/commit`'s `git add -A` could stage state).\n      const hasRule = (rule: string): boolean => rules.has(rule) || rules.has(`/${rule}`);\n      const linesToAdd: string[] = [];\n      if (!hasRule(\".nexus/\") && !hasRule(\".nexus\")) {\n        linesToAdd.push(\".nexus/\");\n      }\n      if (!hasRule(\".nexus/worktrees/\") && !hasRule(\".nexus/worktrees\")) {\n        linesToAdd.push(\".nexus/worktrees/\");\n      }\n      if (!hasRule(\".nexus/flights/\") && !hasRule(\".nexus/flights\")) {\n        linesToAdd.push(\".nexus/flights/\");\n      }\n      if (linesToAdd.length > 0) {\n        const prefix = content.endsWith(\"\\n\") || content.length === 0 ? \"\" : \"\\n\";\n        fs.appendFileSync(excludePath, prefix + linesToAdd.join(\"\\n\") + \"\\n\");\n      }\n    } else {\n      const infoDir = path.dirname(excludePath);\n      if (fs.existsSync(path.dirname(infoDir))) {\n        fs.mkdirSync(infoDir, { recursive: true });\n        fs.writeFileSync(excludePath, \".nexus/\\n.nexus/worktrees/\\n.nexus/flights/\\n\");\n      }\n    }\n  } catch {\n    // Ignore git exclude configuration errors\n  }\n}\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\n\n/**\n * Ensures .nexus/ is ignored by Git in the workspace by adding it to .git/info/exclude (REQ-PER-105).\n * Called on first workspace write by FlightRecorder and WorktreeManager.\n */\nexport function ensureGitExclude(workspace: string): void {\n  let excludePath: string | null = null;\n  try {\n    const out = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n      cwd: workspace,\n      encoding: \"utf-8\",\n      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n    }).trim();\n    if (out) {\n      excludePath = path.isAbsolute(out) ? out : path.resolve(workspace, out);\n    }\n  } catch {\n    // Fall back only when an info/exclude file is already available without Git.\n    const candidate = path.join(workspace, \".git\", \"info\", \"exclude\");\n    if (fs.existsSync(path.dirname(candidate))) {\n      excludePath = candidate;\n    }\n  }\n\n  if (!excludePath) return;\n\n  const infoDir = path.dirname(excludePath);\n  fs.mkdirSync(infoDir, { recursive: true });\n  if (!fs.existsSync(excludePath)) fs.writeFileSync(excludePath, \"\");\n\n  const protectedPaths = [\n    { path: \".nexus/\", rule: \".nexus/\" },\n    { path: \".nexus/worktrees/__nexus_ignore_probe__\", rule: \".nexus/worktrees/\" },\n    { path: \".nexus/flights/__nexus_ignore_probe__\", rule: \".nexus/flights/\" },\n  ];\n  const isIgnored = (relativePath: string): boolean => {\n    try {\n      execFileSync(\"git\", [\"check-ignore\", \"--quiet\", \"--no-index\", \"--\", relativePath], {\n        cwd: workspace,\n        stdio: \"ignore\",\n      });\n      return true;\n    } catch (error) {\n      if (typeof error === \"object\" && error !== null && \"status\" in error && error.status === 1) {\n        return false;\n      }\n      throw new Error(`Could not verify whether ${relativePath} is ignored by Git`, { cause: error });\n    }\n  };\n\n  for (const { path: relativePath, rule } of protectedPaths) {\n    const content = fs.readFileSync(excludePath, \"utf-8\");\n    const rules = new Set(content.split(/\\r?\\n/));\n    const hasExactRule = rules.has(rule) || rules.has(`/${rule}`);\n    if (hasExactRule && isIgnored(relativePath)) continue;\n\n    const prefix = content.length === 0 || content.endsWith(\"\\n\") ? \"\" : \"\\n\";\n    fs.appendFileSync(excludePath, `${prefix}${rule}\\n`);\n    if (!isIgnored(relativePath)) {\n      throw new Error(`Git still does not ignore ${relativePath} after updating info/exclude`);\n    }\n  }\n}\n[]\n","exit_code":0,"duration":{"secs":0,"nanos":606020173}},"started_at_ms":1792862849827,"completed_at_ms":1792862850434}}
