{"timestamp":"2026-10-24T16:55:46.159Z","ordinal":297661,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16ed1-0bd9-75c0-b3f2-6fda13432e3d","item":{"type":"CommandExecution","id":"exec-80997b86-157c-4af1-873d-2f03324bb1e6","process_id":"25999","command":["/usr/bin/zsh","-lc","git status --short --branch; git diff --cached --stat; git diff --cached --check; git diff --cached -- cli/src/git.ts | sed -n '1,180p'; git diff --cached -- cli/test/git_commit.test.ts | sed -n '1,220p'; git log -5 --oneline"],"cwd":"file:///home/mike/nexus-wt/commit-exclusion-refresh","parsed_cmd":[{"type":"unknown","cmd":"git status --short --branch; git diff --cached --stat; git diff --cached --check; git diff --cached -- cli/src/git.ts | sed -n '1,180p'; git diff --cached -- cli/test/git_commit.test.ts | sed -n '1,220p'; git log -5 --oneline"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"## v1/defect-nexus-commit-exclusion-refresh\nM  cli/src/git.ts\nM  cli/test/git_commit.test.ts\n cli/src/git.ts              |  20 +++++++-\n cli/test/git_commit.test.ts | 114 ++++++++++++++++++++++++++++++++++++++++++++\n 2 files changed, 133 insertions(+), 1 deletion(-)\ndiff --git a/cli/src/git.ts b/cli/src/git.ts\nindex 507e127..d964976 100644\n--- a/cli/src/git.ts\n+++ b/cli/src/git.ts\n@@ -154,7 +154,25 @@ export function generateConventionalCommit(workspace: string): { message: string\n \n export function commitChanges(workspace: string, message: string): { success: boolean; hash?: string; error?: string } {\n   try {\n-    execFileSync(\"git\", [\"add\", \"-A\"], { cwd: workspace, stdio: [\"pipe\", \"pipe\", \"pipe\"] });\n+    const gitEnv = { ...process.env };\n+    for (const key of [\"GIT_LITERAL_PATHSPECS\", \"GIT_GLOB_PATHSPECS\", \"GIT_NOGLOB_PATHSPECS\", \"GIT_ICASE_PATHSPECS\"]) {\n+      delete gitEnv[key];\n+    }\n+    // Exclusions in `git add` do not remove paths that were already staged.\n+    // Restore only the internal state entries in the index, leaving their working\n+    // tree contents untouched, before staging the user's workspace changes.\n+    execFileSync(\"git\", [\"reset\", \"--quiet\", \"HEAD\", \"--\", \":(top).nexus\"], {\n+      cwd: workspace,\n+      env: gitEnv,\n+      stdio: [\"pipe\", \"pipe\", \"pipe\"],\n+    });\n+    // Internal Nexus state must never enter an automated workspace commit, even if a user's\n+    // .git/info/exclude contains a malformed rule or a later negation that exposes .nexus/.\n+    execFileSync(\"git\", [\"add\", \"-A\", \"--\", \":(top,exclude).nexus\", \":(top,exclude).nexus/**\"], {\n+      cwd: workspace,\n+      env: gitEnv,\n+      stdio: [\"pipe\", \"pipe\", \"pipe\"],\n+    });\n     execFileSync(\"git\", [\"commit\", \"-m\", message], {\n       cwd: workspace,\n       encoding: \"utf-8\",\ndiff --git a/cli/test/git_commit.test.ts b/cli/test/git_commit.test.ts\nindex 8eec1ab..9d524a2 100644\n--- a/cli/test/git_commit.test.ts\n+++ b/cli/test/git_commit.test.ts\n@@ -35,3 +35,117 @@ test(\"commit messages are committed verbatim and never run by a shell\", () => {\n     fs.rmSync(repo, { recursive: true, force: true });\n   }\n });\n+\n+for (const [name, exclude] of [\n+  [\"leading whitespace\", \"  .nexus/\\n\"],\n+  [\"later negation\", \".nexus/\\n!.nexus/\\n\"],\n+] as const) {\n+  test(`commitChanges never stages .nexus state with ${name} in .git/info/exclude`, () => {\n+    const repo = makeRepo({\n+      \"base.txt\": \"baseline\\n\",\n+      \".nexus/tasks/private.json\": \"synthetic baseline state\\n\",\n+    });\n+    try {\n+      fs.writeFileSync(path.join(repo, \".git/info/exclude\"), exclude);\n+      fs.writeFileSync(path.join(repo, \"base.txt\"), \"ordinary workspace change\\n\");\n+      fs.writeFileSync(path.join(repo, \".nexus/tasks/private.json\"), \"updated synthetic state\\n\");\n+      fs.mkdirSync(path.join(repo, \".nexus/tasks\"), { recursive: true });\n+      fs.writeFileSync(path.join(repo, \".nexus/tasks/untracked.json\"), \"new synthetic state\\n\");\n+\n+      const result = commitChanges(repo, \"chore(workspace): save ordinary change\");\n+      assert.equal(result.success, true, result.error);\n+\n+      const committedPaths = execFileSync(\"git\", [\"diff-tree\", \"--no-commit-id\", \"--name-only\", \"-r\", \"HEAD\"], {\n+        cwd: repo,\n+        encoding: \"utf-8\",\n+      }).trim().split(\"\\n\").filter(Boolean);\n+      assert.deepEqual(committedPaths, [\"base.txt\"]);\n+    } finally {\n+      fs.rmSync(repo, { recursive: true, force: true });\n+    }\n+  });\n+}\n+\n+test(\"commitChanges applies its exclusion pathspec despite inherited Git pathspec mode\", () => {\n+  const repo = makeRepo({ \"base.txt\": \"baseline\\n\" });\n+  const previous = process.env.GIT_LITERAL_PATHSPECS;\n+  try {\n+    process.env.GIT_LITERAL_PATHSPECS = \"1\";\n+    fs.writeFileSync(path.join(repo, \"base.txt\"), \"ordinary workspace change\\n\");\n+    fs.mkdirSync(path.join(repo, \".nexus/tasks\"), { recursive: true });\n+    fs.writeFileSync(path.join(repo, \".nexus/tasks/private.json\"), \"synthetic private state\\n\");\n+\n+    const result = commitChanges(repo, \"chore(workspace): save ordinary change\");\n+    assert.equal(result.success, true, result.error);\n+    const committedPaths = execFileSync(\"git\", [\"diff-tree\", \"--no-commit-id\", \"--name-only\", \"-r\", \"HEAD\"], {\n+      cwd: repo,\n+      encoding: \"utf-8\",\n+    }).trim().split(\"\\n\").filter(Boolean);\n+    assert.deepEqual(committedPaths, [\"base.txt\"]);\n+  } finally {\n+    if (previous === undefined) delete process.env.GIT_LITERAL_PATHSPECS;\n+    else process.env.GIT_LITERAL_PATHSPECS = previous;\n+    fs.rmSync(repo, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"commitChanges keeps whole-repository staging when workspace is below the Git root\", () => {\n+  const repo = makeRepo({ \"base.txt\": \"baseline\\n\", \"subdir/nested.txt\": \"baseline\\n\" });\n+  const workspace = path.join(repo, \"subdir\");\n+  try {\n+    fs.writeFileSync(path.join(repo, \".git/info/exclude\"), \"  .nexus/\\n\");\n+    fs.writeFileSync(path.join(repo, \"base.txt\"), \"root change\\n\");\n+    fs.writeFileSync(path.join(workspace, \"nested.txt\"), \"nested change\\n\");\n+    fs.mkdirSync(path.join(repo, \".nexus/tasks\"), { recursive: true });\n+    fs.writeFileSync(path.join(repo, \".nexus/tasks/private.json\"), \"synthetic private state\\n\");\n+\n+    const result = commitChanges(workspace, \"chore(workspace): save ordinary changes\");\n+    assert.equal(result.success, true, result.error);\n+    const committedPaths = execFileSync(\"git\", [\"diff-tree\", \"--no-commit-id\", \"--name-only\", \"-r\", \"HEAD\"], {\n+      cwd: repo,\n+      encoding: \"utf-8\",\n+    }).trim().split(\"\\n\").filter(Boolean);\n+    assert.deepEqual(committedPaths, [\"base.txt\", \"subdir/nested.txt\"]);\n+  } finally {\n+    fs.rmSync(repo, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"commitChanges removes pre-staged .nexus entries from the commit without deleting workspace state\", () => {\n+  const repo = makeRepo({\n+    \"base.txt\": \"baseline\\n\",\n+    \"subdir/nested.txt\": \"nested baseline\\n\",\n+    \".nexus/tasks/modified.json\": \"original state\\n\",\n+    \".nexus/tasks/deleted.json\": \"state to delete\\n\",\n+  });\n+  const modified = path.join(repo, \".nexus/tasks/modified.json\");\n+  const deleted = path.join(repo, \".nexus/tasks/deleted.json\");\n+  const added = path.join(repo, \".nexus/tasks/added.json\");\n+  const workspace = path.join(repo, \"subdir\");\n+  try {\n+    fs.writeFileSync(modified, \"updated synthetic state\\n\");\n+    fs.rmSync(deleted);\n+    fs.writeFileSync(added, \"new synthetic state\\n\");\n+    execFileSync(\"git\", [\"add\", \"-f\", \"--\", \".nexus\"], { cwd: repo });\n+    fs.writeFileSync(path.join(repo, \"base.txt\"), \"ordinary workspace change\\n\");\n+    fs.writeFileSync(path.join(workspace, \"nested.txt\"), \"ordinary nested change\\n\");\n+\n+    const result = commitChanges(workspace, \"chore(workspace): save ordinary changes\");\n+    assert.equal(result.success, true, result.error);\n+\n+    const committedPaths = execFileSync(\"git\", [\"diff-tree\", \"--no-commit-id\", \"--name-only\", \"-r\", \"HEAD\"], {\n+      cwd: repo,\n+      encoding: \"utf-8\",\n+    }).trim().split(\"\\n\").filter(Boolean);\n+    assert.deepEqual(committedPaths, [\"base.txt\", \"subdir/nested.txt\"]);\n+    assert.equal(fs.readFileSync(modified, \"utf-8\"), \"updated synthetic state\\n\");\n+    assert.equal(fs.existsSync(deleted), false);\n+    assert.equal(fs.readFileSync(added, \"utf-8\"), \"new synthetic state\\n\");\n+    assert.deepEqual(\n+      execFileSync(\"git\", [\"ls-files\", \"--\", \".nexus\"], { cwd: repo, encoding: \"utf-8\" }).trim(),\n+      \".nexus/tasks/deleted.json\\n.nexus/tasks/modified.json\",\n+    );\n+  } finally {\n+    fs.rmSync(repo, { recursive: true, force: true });\n+  }\n+});\n41b381d Merge pull request #197 from mikeholownych/v1/defect-edit-file-unbounded\nf827d51 Merge pull request #196 from mikeholownych/v1/repro-crossrunner-bundle\nfba2faf test(file_ops): pin the exact edit-size boundary\n5c789ea fix(file_ops): bound edit_file and patch_file whole-file reads\nda5f269 fix(release): normalize package archives across runners\n","exit_code":0,"duration":{"secs":0,"nanos":737855356}},"started_at_ms":1792860945421,"completed_at_ms":1792860946159}}
