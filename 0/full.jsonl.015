t  if (trustDecision === \"exit\") return;\n   210\t  triggerBackgroundGc();\n   211\t  const config = buildConfig(options);\n   212\t  if (config.model === \"local-model\") {\n   213\t    try {\n   214\t      const client = new LocalLlmClient(config);\nrc3_startup_trust_file_exit=128\n## HEAD (no branch)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16e83-5895-7063-abd1-ce44552ab742","create_time":1792859833.2523885}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
