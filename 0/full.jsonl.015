for VERIFIED binding (repeatable)\", collectDeliverableFile, [])\n439:        const targetWorkspace = config.workspace || process.cwd();\n442:          .listTasks({ workspace: targetWorkspace })\n604:    .option(\"-w, --workspace <path>\", \"Workspace directory\")\n642:      console.log(`  Workspace: ${pc.dim(s.workspace)} | Messages: ${s.messageCount}\\n`);\n711:  .option(\"-w, --workspace <path>\", \"Workspace directory\")\n713:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n730:  .option(\"-w, --workspace <path>\", \"Workspace directory\")\n732:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n734:    const { untrustedWorkspaceExtensions } = await import(\"./workspace_trust.js\");\n735:    for (const file of untrustedWorkspaceExtensions(ws).filter((f) => /(^|[\\\\/])\\.?mcp\\.json$/.test(f))) {\n736:      console.log(pc.yellow(`Not loaded (workspace not trusted; run \\`nexus trust\\`): ${file}`));\n769:  .option(\"-w, --workspace <path>\", \"Workspace directory\")\n771:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n773:    const { untrustedWorkspaceExtensions } = await import(\"./workspace_trust.js\");\n774:    for (const file of untrustedWorkspaceExtensions(ws).filter((f) => !/(^|[\\\\/])\\.?mcp\\.json$/.test(f))) {\n775:      console.log(pc.yellow(`Not loaded (workspace not trusted; run \\`nexus trust\\`): ${file}`));\n790:  .command(\"trust [path]\")\n791:  .description(\"Trust a workspace so its own .mcp.json servers and plugins are loaded (they run code from the workspace)\")\n792:  .option(\"--remove\", \"Stop trusting the workspace\")\n793:  .option(\"--list\", \"List trusted workspaces\")\n795:    const { listTrustedWorkspaces, setWorkspaceTrusted } = await import(\"./workspace_trust.js\");\n797:      const list = listTrustedWorkspaces();\n798:      console.log(list.length ? list.join(\"\\n\") : \"No trusted workspaces.\");\n807:    const real = setWorkspaceTrusted(ws, !options.remove);\n808:    console.log(options.remove ? `No longer trusted: ${real}` : `Trusted: ${real}\\nIts .mcp.json servers and plugins will be loaded (they run code from this workspace). Undo with \\`nexus trust --remove\\`.`);\n813:  .description(\"List saved workspace snapshots and rollback checkpoints\")\n814:  .option(\"-w, --workspace <path>\", \"Workspace directory\")\n816:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n821:      console.log(pc.yellow(\"\\nNo saved checkpoints for this workspace.\\n\"));\n880:  .option(\"-w, --workspace <path>\", \"Workspace directory\", process.cwd())\n883:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n892:  .option(\"-w, --workspace <path>\", \"Workspace directory\", process.cwd())\n894:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n916:  .option(\"-w, --workspace <path>\", \"Workspace directory\", process.cwd())\n919:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n924:      console.log(`Model: ${pc.bold(manifest.model)} | Workspace: ${pc.dim(manifest.workspace)}`);\n961:  .option(\"-w, --workspace <path>\", \"Workspace directory\", process.cwd())\n963:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n980:  .option(\"-w, --workspace <path>\", \"Workspace directory\", process.cwd())\n983:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n1016:  .option(\"-w, --workspace <path>\", \"Workspace directory (default: current directory)\")\n1030:    const evaluator = new BenchmarkEvaluator(config.workspace);\n1042:  .option(\"-w, --workspace <path>\", \"Workspace directory\", process.cwd())\n1045:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n1079:  .option(\"-w, --workspace <path>\", \"Workspace directory\", process.cwd())\n1082:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n127c5b8 feat(cli): ask before trusting workspace on startup\n cli/src/agent.ts                      |   5 +-\n cli/src/index.ts                      |  12 +-\n cli/src/startup_trust.ts              | 201 ++++++++++++++++++++++++\n cli/test/startup_trust_prompt.test.ts | 287 ++++++++++++++++++++++++++++++++++\n docs/ARCHITECTURE.md                  |   2 +-\n docs/USER_MANUAL.md                   |   3 +\n 6 files changed, 505 insertions(+), 5 deletions(-)\ncommit 127c5b811a86b2a9461e6795d03c651ea365b382\nAuthor: Mike Holownych <mike@holownych.com>\nDate:   Sat Oct 24 05:52:46 2026 +0000\n\n    feat(cli): ask before trusting workspace on startup\n\ndiff --git a/cli/src/index.ts b/cli/src/index.ts\nindex d499816..27ede63 100644\n--- a/cli/src/index.ts\n+++ b/cli/src/index.ts\n@@ -25,6 +25,7 @@ import { buildConfig as buildConfigOrThrow, loadEnvironment } from \"./config.js\"\n import { describeTarget, registerProviderCommands } from \"./provider_cli.js\";\n import { UsageLedger } from \"./usage.js\";\n import { DOCTOR_EXIT, DOCTOR_SCHEMA_VERSION, doctorExitCode, redactDiagnostic, renderDoctorJson, renderDoctorText, runDoctor, runRepairs } from \"./doctor.js\";\n+import { promptWorkspaceTrust } from \"./startup_trust.js\";\n \n function collectDeliverableFile(value: string, previous: string[] = []): string[] {\n   return [...previous, value];\n@@ -196,7 +197,6 @@ function triggerBackgroundGc(): void {\n }\n \n async function startRepl(options: any): Promise<void> {\n-  triggerBackgroundGc();\n   if (process.env.NEXUS_TEST_RECORD_REPL) {\n     const log = process.env.NEXUS_TEST_RECORD_REPL;\n     const parts = [\"repl\"];\n@@ -205,6 +205,9 @@ async function startRepl(options: any): Promise<void> {\n     fs.appendFileSync(log, parts.join(\" \").trim() + \"\\n\");\n     return;\n   }\n+  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n+  if (trustDecision === \"exit\") return;\n+  triggerBackgroundGc();\n   const config = buildConfig(options);\n   if (config.model === \"local-model\") {\n     try {\n@@ -226,7 +229,6 @@ async function startRepl(options: any): Promise<void> {\n }\n \n async function runDefault(options: any): Promise<void> {\n-  triggerBackgroundGc();\n   if (options.repl) {\n     await startRepl(options);\n     return;\n@@ -244,12 +246,18 @@ async function runDefault(options: any): Promise<void> {\n       console.error(\"nexus sidecar is not built. Run 'npm run build' in cli first.\");\n       process.exit(1);\n     }\n+    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n+    if (trustDecision === \"exit\") return;\n+    triggerBackgroundGc();\n     spawnTui(tuiBin, sidecarScript);\n     return;\n   }\n \n   const isInteractiveTty = Boolean(process.stdin.isTTY && process.stdout.isTTY);\n   if (isInteractiveTty && tuiBin && sidecarScript) {\n+    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n+    if (trustDecision === \"exit\") return;\n+    triggerBackgroundGc();\n     spawnTui(tuiBin, sidecarScript);\n     return;\n   }\n{\"body\":\"## Summary\\n\\n- Add an interactive startup trust chooser before the REPL or TUI starts in an untrusted workspace.\\n- Offer **Trust and continue**, **Continue without trusting**, and **Exit**. Trust persists through the existing trust store; continuing untrusted does not change the configured permission mode.\\n- Load project instruction files only after explicit workspace trust. Non-interactive launches never grant trust implicitly and continue under the existing untrusted-workspace behavior.\\n- Sanitize terminal control and Unicode format characters in displayed paths and fit text by grapheme display-cell width.\\n- Document the startup behavior and add prompt, trust persistence, failure, non-TTY, prompt ordering behavior, and path display regressions.\\n\\n## Validation\\n\\n- Focused startup/workspace trust tests: 16/16 passed on the committed source.\\n- `npm run build`: passed.\\n- Independent read-only source review: ACCEPT on the exact reviewed diff.\\n- A full CLI `npm test` attempt ran in an isolated snapshot under the suite claim but did not complete. It reported failures across engine-backed, continuity, qualification, and packaged-entrypoint tests; this local attempt omitted the CI job's built Rust binaries and qualification host setup. It is not passing evidence. Exact-head CI is running on this PR.\\n\\n## Scope\\n\\nThis implements the startup folder-trust interaction shown by the operator. It does not change release acceptance status; RC and release qualification remain separate gates.\\n\",\"mergeCommit\":{\"oid\":\"a2f2fba0de3288bdd69d377fa664d3aa1a0117dc\"},\"mergedAt\":\"2026-10-24T09:57:42Z\",\"number\":186,\"state\":\"MERGED\",\"title\":\"feat(cli): ask before trusting workspace on startup\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/186\"}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16eee-fedb-7732-9ae7-8cbb47107b53","create_time":1792863058.0322404}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
