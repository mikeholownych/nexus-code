{"timestamp":"2026-10-24T16:37:40.151Z","ordinal":296701,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_060b64278a9dfb15016adcded391f481a0b0a448de93572757","status":"completed","call_id":"call_c514011ab09a4f3690c57fe3998ece4d","name":"exec","input":"const xs = ALL_TOOLS.filter(x => /mcp__codex_apps__github_(list_pull_requests|get_pull_request|list_workflow_runs|get_workflow_run|list_releases|get_release|list_tags)|mcp__mcp_search__work_state_(read|write)/i.test(x.name)); text(xs.map(x=>x.name));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a16ec6-5068-7a43-a634-88dec514377c","create_time":1792859859.5724068}}}
