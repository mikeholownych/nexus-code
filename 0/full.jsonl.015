 \"name\": \"test-matrix (22)\",\n      \"status\": \"completed\",\n      \"conclusion\": \"success\",\n      \"activeStep\": \"Run npm --prefix cli test\"\n    },\n    {\n      \"name\": \"test-matrix (24)\",\n      \"status\": \"completed\",\n      \"conclusion\": \"success\",\n      \"activeStep\": \"Run npm --prefix cli test\"\n    },\n    {\n      \"name\": \"linux-x86_64\",\n      \"status\": \"in_progress\",\n      \"conclusion\": \"\",\n      \"activeStep\": \"Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\"\n    }\n  ]\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16ed9-c60e-7103-9ada-b7f9a638664b","create_time":1792861543.4634993}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
