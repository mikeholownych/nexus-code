{"timestamp":"2026-10-24T15:47:11.972Z","ordinal":295644,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16e83-5895-7063-abd1-ce44552ab742","item":{"type":"CommandExecution","id":"exec-b4d23fab-ddda-493e-a211-70ea0b135c90","process_id":"50728","command":["/usr/bin/zsh","-lc","git show origin/main:.github/workflows/ci.yml | sed -n '1,100p'; git show origin/main:.github/workflows/ci.yml | rg -n 'name:|^  [a-z_-]+:|contest|test-matrix|linux'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git show origin/main:.github/workflows/ci.yml | sed -n '1,100p'; git show origin/main:.github/workflows/ci.yml | rg -n 'name:|^  [a-z_-]+:|contest|test-matrix|linux'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"name: CI\n\non:\n  push:\n    branches: [main]\n  pull_request:\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\njobs:\n  test-matrix:\n    runs-on: ubuntu-22.04\n    strategy:\n      fail-fast: false\n      matrix:\n        node: [22, 24]\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.x'\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: ${{ matrix.node }}\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - run: node scripts/sync-version.mjs --check\n      - run: node scripts/check_requirements.mjs\n      - run: npm ci --prefix cli\n      - run: npm --prefix cli run build\n      - run: git diff --exit-code -- cli/dist\n      - run: cargo test --locked --manifest-path core/Cargo.toml\n      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n      - name: Install pinned security and SBOM test tools\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - run: npm --prefix cli test\n\n  linux-x86_64:\n    needs: [test-matrix]\n    runs-on: ubuntu-22.04\n    env:\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.x'\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n1:name: CI\n4:  push:\n6:  pull_request:\n7:  workflow_dispatch:\n10:  contents: read\n13:  test-matrix:\n27:      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n41:      - name: Install selected Node runtime for isolated evaluation commands\n63:      - name: Install pinned security and SBOM test tools\n71:          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n72:          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n73:          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n74:          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n75:          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n79:  linux-x86_64:\n80:    needs: [test-matrix]\n92:      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n106:      - name: Install selected Node runtime for isolated evaluation commands\n121:      - name: Install cargo tools (audit, deny, about, cyclonedx)\n129:          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n130:          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n131:          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n132:          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n133:          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n134:          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n135:          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n149:      - run: bash scripts/package-linux.sh \"v${{ steps.release-version.outputs.version }}\" \"$RUNNER_TEMP/dist\"\n150:      - run: bash scripts/package-linux.sh \"v${{ steps.release-version.outputs.version }}\" \"$RUNNER_TEMP/repro-check\"\n151:      - run: cmp \"$RUNNER_TEMP/dist/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\" \"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\"\n157:      - run: bash scripts/smoke-package.sh \"$RUNNER_TEMP/dist/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\"\n158:      - run: bash scripts/installer-smoke.sh \"$GITHUB_WORKSPACE/install.sh\" \"$RUNNER_TEMP/dist/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\"\n161:          name: nexus-linux-x86_64\n","exit_code":0,"duration":{"secs":0,"nanos":54628}},"started_at_ms":1792856831972,"completed_at_ms":1792856831972}}
