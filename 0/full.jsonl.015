5\\\",\\\"name\\\":\\\"test-matrix (24)\\\",\\\"startedAt\\\":\\\"2026-10-24T05:20:50Z\\\",\\\"status\\\":\\\"COMPLETED\\\",\\\"workflowName\\\":\\\"CI\\\"},{\\\"__typename\\\":\\\"CheckRun\\\",\\\"completedAt\\\":\\\"2026-10-24T05:58:15Z\\\",\\\"conclusion\\\":\\\"SUCCESS\\\",\\\"detailsUrl\\\":\\\"https://github.com/mikeholownych/nexus-code/actions/runs/40065891874/job/120792274664\\\",\\\"name\\\":\\\"linux-x86_64\\\",\\\"startedAt\\\":\\\"2026-10-24T05:37:59Z\\\",\\\"status\\\":\\\"COMPLETED\\\",\\\"workflowName\\\":\\\"CI\\\"},{\\\"__typename\\\":\\\"CheckRun\\\",\\\"completedAt\\\":\\\"2026-10-24T05:21:59Z\\\",\\\"conclusion\\\":\\\"SUCCESS\\\",\\\"detailsUrl\\\":\\\"https://github.com/mikeholownych/nexus-code/runs/120789166242\\\",\\\"name\\\":\\\"CodeQL\\\",\\\"startedAt\\\":\\\"2026-10-24T05:21:56Z\\\",\\\"status\\\":\\\"COMPLETED\\\",\\\"workflowName\\\":\\\"\\\"},{\\\"__typename\\\":\\\"StatusContext\\\",\\\"context\\\":\\\"CodeRabbit\\\",\\\"startedAt\\\":\\\"2026-10-24T05:20:55Z\\\",\\\"state\\\":\\\"SUCCESS\\\",\\\"targetUrl\\\":\\\"\\\"}],\\\"title\\\":\\\"fix(git): exclude internal state from workspace commits\\\",\\\"url\\\":\\\"https://github.com/mikeholownych/nexus-code/pull/183\\\"}\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16ec6-5068-7a43-a634-88dec514377c","create_time":1792859880.5500085}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
