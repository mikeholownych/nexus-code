fore making global git config changes\n10338-test-matrix (24)\tPost Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\t2026-10-24T17:48:31.0628330Z Adding repository directory to the temporary git global config as a safe directory\n10339-test-matrix (24)\tPost Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\t2026-10-24T17:48:31.0630974Z [command]/usr/bin/git config --global --add safe.directory /home/runner/work/nexus-code/nexus-code\n18abef6 fix(git): avoid duplicate ineffective exclusion rules\n cli/src/core/git_exclude.ts  | 13 +++++++++++--\n cli/test/git_exclude.test.ts |  4 ++++\n 2 files changed, 15 insertions(+), 2 deletions(-)\ndiff --git a/cli/src/core/git_exclude.ts b/cli/src/core/git_exclude.ts\nindex 55975d6..b0e5c16 100644\n--- a/cli/src/core/git_exclude.ts\n+++ b/cli/src/core/git_exclude.ts\n@@ -7,55 +7,69 @@ import { execFileSync } from \"node:child_process\";\n  * Called on first workspace write by FlightRecorder and WorktreeManager.\n  */\n export function ensureGitExclude(workspace: string): void {\n+  let excludePath: string | null = null;\n   try {\n-    let excludePath: string | null = null;\n+    const out = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n+      cwd: workspace,\n+      encoding: \"utf-8\",\n+      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n+    }).trim();\n+    if (out) {\n+      excludePath = path.isAbsolute(out) ? out : path.resolve(workspace, out);\n+    }\n+  } catch {\n+    // Fall back only when an info/exclude file is already available without Git.\n+    const candidate = path.join(workspace, \".git\", \"info\", \"exclude\");\n+    if (fs.existsSync(path.dirname(candidate))) {\n+      excludePath = candidate;\n+    }\n+  }\n+\n+  if (!excludePath) return;\n+\n+  const infoDir = path.dirname(excludePath);\n+  fs.mkdirSync(infoDir, { recursive: true });\n+  if (!fs.existsSync(excludePath)) fs.writeFileSync(excludePath, \"\");\n+\n+  const protectedPaths = [\n+    { path: \".nexus/\", rule: \".nexus/\" },\n+    { path: \".nexus/worktrees/__nexus_ignore_probe__\", rule: \".nexus/worktrees/\" },\n+    { path: \".nexus/flights/__nexus_ignore_probe__\", rule: \".nexus/flights/\" },\n+  ];\n+  const isIgnored = (relativePath: string): boolean => {\n     try {\n-      const out = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n+      execFileSync(\"git\", [\"check-ignore\", \"--quiet\", \"--no-index\", \"--\", relativePath], {\n         cwd: workspace,\n-        encoding: \"utf-8\",\n-        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n-      }).trim();\n-      if (out) {\n-        excludePath = path.isAbsolute(out) ? out : path.resolve(workspace, out);\n-      }\n-    } catch {\n-      // Fallback if git binary or rev-parse fails\n-      const candidate = path.join(workspace, \".git\", \"info\", \"exclude\");\n-      if (fs.existsSync(path.dirname(candidate))) {\n-        excludePath = candidate;\n+        stdio: \"ignore\",\n+      });\n+      return true;\n+    } catch (error) {\n+      if (typeof error === \"object\" && error !== null && \"status\" in error && error.status === 1) {\n+        return false;\n       }\n+      throw new Error(`Could not verify whether ${relativePath} is ignored by Git`, { cause: error });\n     }\n+  };\n \n-    if (!excludePath) return;\n+  for (const { path: relativePath, rule } of protectedPaths) {\n+    const content = fs.readFileSync(excludePath, \"utf-8\");\n+    const lines = content.split(/\\r?\\n/);\n+    const rules = new Set(lines);\n+    const hasExactRule = rules.has(rule) || rules.has(`/${rule}`);\n+    if (isIgnored(relativePath)) continue;\n \n-    if (fs.existsSync(excludePath)) {\n-      const content = fs.readFileSync(excludePath, \"utf-8\");\n-      const rules = new Set(content.split(/\\r?\\n/).map((line) => line.trim()));\n-      // Match whole rules, not substrings: a comment or an unrelated pattern that merely mentions\n-      // `.nexus` must not suppress the ignore rule (then `/commit`'s `git add -A` could stage state).\n-      const hasRule = (rule: string): boolean => rules.has(rule) || rules.has(`/${rule}`);\n-      const linesToAdd: string[] = [];\n-      if (!hasRule(\".nexus/\") && !hasRule(\".nexus\")) {\n-        linesToAdd.push(\".nexus/\");\n-      }\n-      if (!hasRule(\".nexus/worktrees/\") && !hasRule(\".nexus/worktrees\")) {\n-        linesToAdd.push(\".nexus/worktrees/\");\n-      }\n-      if (!hasRule(\".nexus/flights/\") && !hasRule(\".nexus/flights\")) {\n-        linesToAdd.push(\".nexus/flights/\");\n-      }\n-      if (linesToAdd.length > 0) {\n-        const prefix = content.endsWith(\"\\n\") || content.length === 0 ? \"\" : \"\\n\";\n-        fs.appendFileSync(excludePath, prefix + linesToAdd.join(\"\\n\") + \"\\n\");\n-      }\n-    } else {\n-      const infoDir = path.dirname(excludePath);\n-      if (fs.existsSync(path.dirname(infoDir))) {\n-        fs.mkdirSync(infoDir, { recursive: true });\n-        fs.writeFileSync(excludePath, \".nexus/\\n.nexus/worktrees/\\n.nexus/flights/\\n\");\n+    if (hasExactRule) {\n+      const lastExactRule = Math.max(lines.lastIndexOf(rule), lines.lastIndexOf(`/${rule}`));\n+      const laterNegation = lines.slice(lastExactRule + 1).some((line) => line.trimStart().startsWith(\"!\"));\n+      if (!laterNegation) {\n+        throw new Error(`Git still does not ignore ${relativePath} after updating info/exclude`);\n       }\n     }\n-  } catch {\n-    // Ignore git exclude configuration errors\n+\n+    const prefix = content.length === 0 || content.endsWith(\"\\n\") ? \"\" : \"\\n\";\n+    fs.appendFileSync(excludePath, `${prefix}${rule}\\n`);\n+    if (!isIgnored(relativePath)) {\n+      throw new Error(`Git still does not ignore ${relativePath} after updating info/exclude`);\n+    }\n   }\n }\ndiff --git a/cli/test/git_exclude.test.ts b/cli/test/git_exclude.test.ts\nindex 4ce2c47..8845966 100644\n--- a/cli/test/git_exclude.test.ts\n+++ b/cli/test/git_exclude.test.ts\n@@ -80,6 +80,54 @@ test(\"a root-anchored rule is accepted without adding a duplicate\", () => {\n   }\n });\n \n+test(\"leading whitespace is not treated as an existing ignore rule\", () => {\n+  const { root, excludePath } = makeRepo(\" .nexus/\\n\");\n+  try {\n+    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), false);\n+    ensureGitExclude(root);\n+    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n+    assert.match(fs.readFileSync(excludePath, \"utf8\"), /\\n\\.nexus\\/\\n/);\n+  } finally {\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"a later negation is overridden by a verified positive rule\", () => {\n+  const { root, excludePath } = makeRepo(\".nexus/\\n!.nexus/\\n\");\n+  try {\n+    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), false);\n+    ensureGitExclude(root);\n+    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n+    assert.equal(isIgnored(root, \".nexus/worktrees/task/state.json\"), true);\n+    const rules = fs.readFileSync(excludePath, \"utf8\").split(/\\r?\\n/);\n+    assert.ok(rules.lastIndexOf(\".nexus/\") > rules.lastIndexOf(\"!.nexus/\"));\n+  } finally {\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"a higher-priority repository negation fails closed when info/exclude cannot override it\", () => {\n+  const { root } = makeRepo(\"\");\n+  try {\n+    fs.writeFileSync(\n+      path.join(root, \".gitignore\"),\n+      \".nexus/\\n!.nexus/\\n.nexus/tasks/__nexus_ignore_probe__\\n\",\n+    );\n+    assert.equal(isIgnored(root, \".nexus/tasks/__nexus_ignore_probe__\"), true);\n+    assert.equal(isIgnored(root, \".nexus/\"), false);\n+    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), false);\n+    const excludePath = path.join(root, \".git\", \"info\", \"exclude\");\n+    assert.throws(() => ensureGitExclude(root), /Git still does not ignore/);\n+    assert.equal(isIgnored(root, \".nexus/\"), false);\n+    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), false);\n+    const afterFirstAttempt = fs.readFileSync(excludePath, \"utf8\");\n+    assert.throws(() => ensureGitExclude(root), /Git still does not ignore/);\n+    assert.equal(fs.readFileSync(excludePath, \"utf8\"), afterFirstAttempt, \"failed retries do not append duplicate rules\");\n+  } finally {\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n test(\"a missing exclude file is created with the rules\", () => {\n   const { root, excludePath } = makeRepo(null);\n   try {\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\n\n/**\n * Ensures .nexus/ is ignored by Git in the workspace by adding it to .git/info/exclude (REQ-PER-105).\n * Called on first workspace write by FlightRecorder and WorktreeManager.\n */\nexport function ensureGitExclude(workspace: string): void {\n  let excludePath: string | null = null;\n  try {\n    const out = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n      cwd: workspace,\n      encoding: \"utf-8\",\n      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n    }).trim();\n    if (out) {\n      excludePath = path.isAbsolute(out) ? out : path.resolve(workspace, out);\n    }\n  } catch {\n    // Fall back only when an info/exclude file is already available without Git.\n    const candidate = path.join(workspace, \".git\", \"info\", \"exclude\");\n    if (fs.existsSync(path.dirname(candidate))) {\n      excludePath = candidate;\n    }\n  }\n\n  if (!excludePath) return;\n\n  const infoDir = path.dirname(excludePath);\n  fs.mkdirSync(infoDir, { recursive: true });\n  if (!fs.existsSync(excludePath)) fs.writeFileSync(excludePath, \"\");\n\n  const protectedPaths = [\n    { path: \".nexus/\", rule: \".nexus/\" },\n    { path: \".nexus/worktrees/__nexus_ignore_probe__\", rule: \".nexus/worktrees/\" },\n    { path: \".nexus/flights/__nexus_ignore_probe__\", rule: \".nexus/flights/\" },\n  ];\n  const isIgnored = (relativePath: string): boolean => {\n    try {\n      execFileSync(\"git\", [\"check-ignore\", \"--quiet\", \"--no-index\", \"--\", relativePath], {\n        cwd: workspace,\n        stdio: \"ignore\",\n      });\n      return true;\n    } catch (error) {\n      if (typeof error === \"object\" && error !== null && \"status\" in error && error.status === 1) {\n        return false;\n      }\n      throw new Error(`Could not verify whether ${relativePath} is ignored by Git`, { cause: error });\n    }\n  };\n\n  for (const { path: relativePath, rule } of protectedPaths) {\n    const content = fs.readFileSync(excludePath, \"utf-8\");\n    const lines = content.split(/\\r?\\n/);\n    const rules = new Set(lines);\n    const hasExactRule = rules.has(rule) || rules.has(`/${rule}`);\n    if (hasExactRule && isIgnored(relativePath)) continue;\n\n    if (hasExactRule) {\n      const lastExactRule = Math.max(lines.lastIndexOf(rule), lines.lastIndexOf(`/${rule}`));\n      const laterNegation = lines.slice(lastExactRule + 1).some((line) => line.trimStart().startsWith(\"!\"));\n      if (!laterNegation) {\n        throw new Error(`Git still does not ignore ${relativePath} after updating info/exclude`);\n      }\n    }\n\n    const prefix = content.length === 0 || content.endsWith(\"\\n\") ? \"\" : \"\\n\";\n    fs.appendFileSync(excludePath, `${prefix}${rule}\\n`);\n    if (!isIgnored(relativePath)) {\n      throw new Error(`Git still does not ignore ${relativePath} after updating info/exclude`);\n    }\n  }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16f03-b5c2-7ab2-ba06-07db849a401d","create_time":1792864339.7750957}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
