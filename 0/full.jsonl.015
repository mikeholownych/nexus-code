ue),\n    98\t  };\n    99\t  const resolvedWorkspace = path.resolve(workspace);\n   100\t  const displayWorkspace = safeTerminalText(resolvedWorkspace);\n   101\t\n   102\t  if (trustStore.isTrusted(resolvedWorkspace)) return Promise.resolve(\"trusted\");\n   103\t  if (!input.isTTY || !output.isTTY) {\n   104\t    noticeOutput.write(\n   105\t      `Nexus: ${displayWorkspace} is not trusted. Project instructions and workspace integrations stay unloaded. ` +\n   106\t      `Run 'nexus trust .' to trust this folder; untrusted workspaces default to review mode.\\n`,\n   107\t    );\n   108\t    return Promise.resolve(\"untrusted\");\n   109\t  }\n   110\t\n   111\t  const instructionFile = projectInstructionFile(resolvedWorkspace);\n   112\t  const optionsText = [\n   113\t    \"Trust and continue\",\n   114\t    \"Continue without trusting\",\n   115\t    \"Exit\",\n   116\t  ];\n   117\t  const selected = 0;\n   118\t  const oldRawMode = Boolean(input.isRaw);\n   119\t\n   120\t  return new Promise((resolve) => {\n   121\t    let choice = selected;\n   122\t    let complete = false;\n   123\t    let statusMessage: string | undefined;\n   124\t\n   125\t    const render = () => {\n   126\t      const width = Math.max(32, output.columns ?? 80);\n   127\t      const fit = (value: string) => fitTerminalText(value, width);\n   128\t      const projectFile = instructionFile ? `Check: ${instructionFile}` : \"No project instruction file found\";\n   129\t      const rows = optionsText.map((text, index) => `${choice === index ? \"›\" : \" \"} ${text}`);\n   130\t      output.write([\n   131\t        \"\\u001b[2J\\u001b[H\",\n   132\t        \"Trust this folder?\",\n   133\t        \"↑↓ navigate · Enter select · Esc exit\",\n   134\t        fit(displayWorkspace),\n   135\t        \"Load project instructions\",\n   136\t        fit(projectFile),\n   137\t        \"Trust saved for future workspace files.\",\n   138\t        \"Rules/integrations require trust.\",\n   139\t        \"Default mode follows trust.\",\n   140\t        \"Trusted: auto · untrusted: review\",\n   141\t        \"Explicit mode still applies.\",\n   142\t        ...(statusMessage ? [fit(statusMessage)] : []),\n   202\t    const parts = [\"repl\"];\n   203\t    if (options.model) parts.push(\"-m\", options.model);\n   204\t    if (options.resume) parts.push(\"-r\", typeof options.resume === \"string\" ? options.resume : \"\");\n   205\t    fs.appendFileSync(log, parts.join(\" \").trim() + \"\\n\");\n   206\t    return;\n   207\t  }\n   208\t  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n   209\t  if (trustDecision === \"exit\") return;\n   210\t  triggerBackgroundGc();\n   211\t  const config = buildConfig(options);\n   212\t  if (config.model === \"local-model\") {\n   213\t    try {\n   214\t      const client = new LocalLlmClient(config);\nrc3_startup_trust_file_exit=128\n## HEAD (no branch)\n","exit_code":0,"duration":{"secs":0,"nanos":771102136}},"started_at_ms":1792859831496,"completed_at_ms":1792859832267}}
