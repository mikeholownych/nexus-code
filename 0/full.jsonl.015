r.gz\",\"size\":4830483,\"state\":\"uploaded\",\"url\":\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.4/nexus-linux-x86_64-v1.0.0-rc.4.tar.gz\"},{\"digest\":\"sha256:93de382a16a4eb995fde88858f08c516814dc5483f553620f39e5238659a6d6c\",\"name\":\"sbom.cdx.json\",\"size\":163389,\"state\":\"uploaded\",\"url\":\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.4/sbom.cdx.json\"},{\"digest\":\"sha256:ac354a60a4698e329d4dda40dc0d0bd43c755bda5b5560254614d638e11a82b7\",\"name\":\"sbom.cdx.json.sha256\",\"size\":80,\"state\":\"uploaded\",\"url\":\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.4/sbom.cdx.json.sha256\"},{\"digest\":\"sha256:93de382a16a4eb995fde88858f08c516814dc5483f553620f39e5238659a6d6c\",\"name\":\"sbom.json\",\"size\":163389,\"state\":\"uploaded\",\"url\":\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.4/sbom.json\"},{\"digest\":\"sha256:e9c1555de17e84dbfba2523d568309d86f88053a2a16074dda05f031bba794b4\",\"name\":\"sbom.json.sha256\",\"size\":76,\"state\":\"uploaded\",\"url\":\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.4/sbom.json.sha256\"},{\"digest\":\"sha256:30f7a6eab8138423c547147989020d547bdf17ada595e362914b95c45f6067af\",\"name\":\"SHA256SUMS\",\"size\":189,\"state\":\"uploaded\",\"url\":\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.4/SHA256SUMS\"},{\"digest\":\"sha256:b21359eaf4e0a96df261fed6970b25af435dceb24beff8acb48266aced382eba\",\"name\":\"THIRD_PARTY_NOTICES.txt\",\"size\":242795,\"state\":\"uploaded\",\"url\":\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.4/THIRD_PARTY_NOTICES.txt\"}],\"isPrerelease\":true,\"publishedAt\":\"2026-10-24T11:54:37Z\",\"tagName\":\"v1.0.0-rc.4\",\"targetCommitish\":\"main\"}\n\nISSUE1\n{\"lastComment\":{\"author\":\"mikeholownych\",\"body\":\"Metadata-only custody status request: please confirm the current author/custodian owner and progress toward the 40-task corpus, including coverage/validation counts, setup and reference-validation status, private digest re-derivation, store and parent access controls, exposure-history review, immutable seal status, and expected custody acceptance. Please do not post task prompts, answers, validators, or other protected payloads here. Held-out qualification remains blocked until the independent custodian verifies completeness, coverage, integrity, and execution-boundary separation.\",\"createdAt\":\"2026-10-24T02:16:57Z\"},\"state\":\"OPEN\",\"title\":\"PLAN-10 task 8: finish and seal the held-out T2/T3 corpus\",\"updatedAt\":\"2026-10-24T02:16:57Z\"}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16ec6-5068-7a43-a634-88dec514377c","create_time":1792859907.9867985}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
