xus/checkpoints\"], { cwd: workspace, encoding: \"utf8\" }).trim(), \"\");\ncli/test/persistence_protection.test.ts:247:    assert.equal(fs.readFileSync(path.join(workspace, \"app.txt\"), \"utf8\").includes(syntheticGithubToken), true);\ncli/test/persistence_protection.test.ts:260:    const workspace = path.join(tempDir, \"workspace\");\ncli/test/persistence_protection.test.ts:261:    fs.mkdirSync(workspace);\ncli/test/persistence_protection.test.ts:262:    execFileSync(\"git\", [\"init\", \"-q\"], { cwd: workspace });\ncli/test/persistence_protection.test.ts:263:    execFileSync(\"git\", [\"config\", \"user.name\", \"Synthetic Fixture\"], { cwd: workspace });\ncli/test/persistence_protection.test.ts:264:    execFileSync(\"git\", [\"config\", \"user.email\", \"fixture@example.invalid\"], { cwd: workspace });\ncli/test/persistence_protection.test.ts:265:    fs.writeFileSync(path.join(workspace, \"app.txt\"), \"safe baseline\\n\");\ncli/test/persistence_protection.test.ts:266:    execFileSync(\"git\", [\"add\", \"app.txt\"], { cwd: workspace });\ncli/test/persistence_protection.test.ts:267:    execFileSync(\"git\", [\"commit\", \"-qm\", \"baseline\"], { cwd: workspace });\ncli/test/persistence_protection.test.ts:268:    fs.writeFileSync(path.join(workspace, \"app.txt\"), \"safe changed state\\n\");\ncli/test/persistence_protection.test.ts:270:    const checkpoint = new CheckpointManager(workspace).createCheckpoint(\"ordinary update\");\ncli/test/persistence_protection.test.ts:272:    assert.equal(execFileSync(\"git\", [\"show\", `${checkpoint.gitRef}:app.txt`], { cwd: workspace, encoding: \"utf8\" }), \"safe changed state\\n\");\ncli/test/persistence_protection.test.ts:273:    assert.equal(fs.readFileSync(path.join(workspace, \"app.txt\"), \"utf8\"), \"safe changed state\\n\");\ncli/test/persistence_protection.test.ts:286:    const workspace = path.join(tempDir, \"workspace\");\ncli/test/persistence_protection.test.ts:287:    fs.mkdirSync(workspace);\ncli/test/persist