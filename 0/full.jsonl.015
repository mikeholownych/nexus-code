tity.value,\ncli/test/persistence_protection.test.ts:518:      workspace: identity.value,\ncli/test/persistence_protection.test.ts:531:test(\"canonical positive credential findings block typed WorkspacePath persistence\", () => {\ncli/test/persistence_protection.test.ts:550:      const workspace = path.join(root, `credential-${index}-${syntheticCredential}`);\ncli/test/persistence_protection.test.ts:551:      fs.mkdirSync(workspace);\ncli/test/persistence_protection.test.ts:552:      const identity = WorkspacePath.fromSelectedWorkspace(workspace);\ncli/test/persistence_protection.test.ts:554:      const manager = new DurableStateManager({ baseDir: stateDir, workspacePaths: [identity] });\ncli/test/persistence_protection.test.ts:560:        workspacePath: identity.value,\ncli/test/persistence_protection.test.ts:561:        workspace: identity.value,\ncli/test/persistence_protection.test.ts:573:    // PEM delimiters contain path separators/newlines, so this representation\ncli/test/persistence_protection.test.ts:581:test(\"typed WorkspacePath may resolve only an UNCERTAIN path entropy finding\", () => {\ncli/test/persistence_protection.test.ts:583:  const workspace = path.join(root, syntheticHighEntropyPathPart);\ncli/test/persistence_protection.test.ts:584:  fs.mkdirSync(workspace);\ncli/test/persistence_protection.test.ts:586:    assert.ok(InformationFlowBoundary.getGlobalInstance().classifyText(workspace)\ncli/test/persistence_protection.test.ts:588:    const identity = WorkspacePath.fromSelectedWorkspace(workspace);\ncli/test/persistence_protection.test.ts:590:    const manager = new DurableStateManager({ baseDir: stateDir, workspacePaths: [identity] });\ncli/test/persistence_protection.test.ts:596:      workspacePath: identity.value,\ncli/test/persistence_protection.test.ts:597:      workspace: identity.value,\ncli/test/persistence_protection.test.ts:611:test(\"typed WorkspacePath does not exempt arbitrary high-entropy message content\", () => {\ncli/test/persist