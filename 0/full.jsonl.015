describeTarget, registerProviderCommands } from \"./provider_cli.js\";\n import { UsageLedger } from \"./usage.js\";\n import { DOCTOR_EXIT, DOCTOR_SCHEMA_VERSION, doctorExitCode, redactDiagnostic, renderDoctorJson, renderDoctorText, runDoctor, runRepairs } from \"./doctor.js\";\n+import { promptWorkspaceTrust } from \"./startup_trust.js\";\n \n function collectDeliverableFile(value: string, previous: string[] = []): string[] {\n   return [...previous, value];\n@@ -196,7 +197,6 @@ function triggerBackgroundGc(): void {\n }\n \n async function startRepl(options: any): Promise<void> {\n-  triggerBackgroundGc();\n   if (process.env.NEXUS_TEST_RECORD_REPL) {\n     const log = process.env.NEXUS_TEST_RECORD_REPL;\n     const parts = [\"repl\"];\n@@ -205,6 +205,9 @@ async function startRepl(options: any): Promise<void> {\n     fs.appendFileSync(log, parts.join(\" \").trim() + \"\\n\");\n     return;\n   }\n+  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n+  if (trustDecision === \"exit\") return;\n+  triggerBackgroundGc();\n   const config = buildConfig(options);\n   if (config.model === \"local-model\") {\n     try {\n@@ -226,7 +229,6 @@ async function startRepl(options: any): Promise<void> {\n }\n \n async function runDefault(options: any): Promise<void> {\n-  triggerBackgroundGc();\n   if (options.repl) {\n     await startRepl(options);\n     return;\n@@ -244,12 +246,18 @@ async function runDefault(options: any): Promise<void> {\n       console.error(\"nexus sidecar is not built. Run 'npm run build' in cli first.\");\n       process.exit(1);\n     }\n+    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n+    if (trustDecision === \"exit\") return;\n+    triggerBackgroundGc();\n     spawnTui(tuiBin, sidecarScript);\n     return;\n   }\n \n   const isInteractiveTty = Boolean(process.stdin.isTTY && process.stdout.isTTY);\n   if (isInteractiveTty && tuiBin && sidecarScript) {\n+    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n+    if (trustDecision === \"exit\") return;\n+    triggerBackgroundGc();\n     spawnTui(tuiBin, sidecarScript);\n     return;\n   }\n{\"body\":\"## Summary\\n\\n- Add an interactive startup trust chooser before the REPL or TUI starts in an untrusted workspace.\\n- Offer **Trust and continue**, **Continue without trusting**, and **Exit**. Trust persists through the existing trust store; continuing untrusted does not change the configured permission mode.\\n- Load project instruction files only after explicit workspace trust. Non-interactive launches never grant trust implicitly and continue under the existing untrusted-workspace behavior.\\n- Sanitize terminal control and Unicode format characters in displayed paths and fit text by grapheme display-cell width.\\n- Document the startup behavior and add prompt, trust persistence, failure, non-TTY, prompt ordering behavior, and path display regressions.\\n\\n## Validation\\n\\n- Focused startup/workspace trust tests: 16/16 passed on the committed source.\\n- `npm run build`: passed.\\n- Independent read-only source review: ACCEPT on the exact reviewed diff.\\n- A full CLI `npm test` attempt ran in an isolated snapshot under the suite claim but did not complete. It reported failures across engine-backed, continuity, qualification, and packaged-entrypoint tests; this local attempt omitted the CI job's built Rust binaries and qualification host setup. It is not passing evidence. Exact-head CI is running on this PR.\\n\\n## Scope\\n\\nThis implements the startup folder-trust interaction shown by the operator. It does not change release acceptance status; RC and release qualification remain separate gates.\\n\",\"mergeCommit\":{\"oid\":\"a2f2fba0de3288bdd69d377fa664d3aa1a0117dc\"},\"mergedAt\":\"2026-10-24T09:57:42Z\",\"number\":186,\"state\":\"MERGED\",\"title\":\"feat(cli): ask before trusting workspace on startup\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/186\"}\n","exit_code":0,"duration":{"secs":0,"nanos":481658131}},"started_at_ms":1792863056545,"completed_at_ms":1792863057028}}
