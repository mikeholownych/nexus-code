oint <= 0xfe6f) ||\n      (codePoint >= 0xff00 && codePoint <= 0xff60) ||\n      (codePoint >= 0xffe0 && codePoint <= 0xffe6) ||\n      (codePoint >= 0x1f000 && codePoint <= 0x1faff) ||\n      (codePoint >= 0x20000 && codePoint <= 0x3fffd)\n    )\n  ) return 2;\n  return 1;\n}\n\nfunction terminalCellWidth(value: string): number {\n  const segmenter = new Intl.Segmenter(undefined, { granularity: \"grapheme\" });\n  let width = 0;\n  for (const { segment } of segmenter.segment(value)) {\n    width += Math.max(0, ...[...segment].map(codePointCellWidth));\n  }\n  return width;\n}\n\nfunction fitTerminalText(value: string, maxWidth: number): string {\n  if (terminalCellWidth(value) <= maxWidth) return value;\n  const segments = [...new Intl.Segmenter(undefined, { granularity: \"grapheme\" }).segment(value)].map(({ segment }) => segment);\n  const suffix: string[] = [];\n  let width = 1; // reserve one cell for the leading ellipsis\n  for (let index = segments.length - 1; index >= 0; index--) {\n    const segment = segments[index];\n    const segmentWidth = terminalCellWidth(segment);\n    if (width + segmentWidth > maxWidth) break;\n    suffix.unshift(segment);\n    width += segmentWidth;\n  }\n  return `…${suffix.join(\"\")}`;\n}\n\n/** Project instructions are untrusted workspace input and are injected only after the operator explicitly trusts it. */\nexport function trustedProjectRules(\n  workspace: string,\n  isTrusted: (workspace: string) => boolean = isWorkspaceTrusted,\n): string | null {\n  return isTrusted(workspace) ? getProjectRules(workspace) : null;\n}\n\n/**\n * Ask for explicit trust before starting an interactive Nexus client. Non-interactive launches continue under the\n * existing untrusted-workspace policy and never persist trust implicitly.\n */\nexport function promptWorkspaceTrust(\n  workspace: string,\n  options: TrustPromptOptions = {},\n): Promise<WorkspaceTrustDecision> {\n  const input = options.input ?? process.stdin;\n  const output = options.output ?? process.stdout;\n  const noticeOutput = options.output ?? process.stderr;\n  const trustStore = options.trustStore ?? {\n    isTrusted: isWorkspaceTrusted,\n    trust: (target: string) => setWorkspaceTrusted(target, true),\n  };\n  const resolvedWorkspace = path.resolve(workspace);\n  const displayWorkspace = safeTerminalText(resolvedWorkspace);\n\n  if (trustStore.isTrusted(resolvedWorkspace)) return Promise.resolve(\"trusted\");\n  if (!input.isTTY || !output.isTTY) {\n    noticeOutput.write(\n      `Nexus: ${displayWorkspace} is not trusted. Project instructions and workspace integrations stay unloaded. ` +\n      `Run 'nexus trust .' to trust this folder; untrusted workspaces default to review mode.\\n`,\n    );\n    return Promise.resolve(\"untrusted\");\n  }\n\n  const instructionFile = projectInstructionFile(resolvedWorkspace);\n  const optionsText = [\n    \"Trust and continue\",\n    \"Continue without trusting\",\n    \"Exit\",\n  ];\n  const selected = 0;\n  const oldRawMode = Boolean(input.isRaw);\n\n  return new Promise((resolve) => {\n    let choice = selected;\n    let complete = false;\n    let statusMessage: string | undefined;\n\n    const render = () => {\n      const width = Math.max(32, output.columns ?? 80);\n      const fit = (value: string) => fitTerminalText(value, width);\n      const projectFile = instructionFile ? `Check: ${instructionFile}` : \"No project instruction file found\";\n      const rows = optionsText.map((text, index) => `${choice === index ? \"›\" : \" \"} ${text}`);\n      output.write([\n        \"\\u001b[2J\\u001b[H\",\n        \"Trust this folder?\",\n        \"↑↓ navigate · Enter select · Esc exit\",\n        fit(displayWorkspace),\n        \"Load project instructions\",\n        fit(projectFile),\n        \"Trust saved for future workspace files.\",\n        \"Rules/integrations require trust.\",\n        \"Default mode follows trust.\",\n        \"Trusted: auto · untrusted: review\",\n        \"Explicit mode still applies.\",\n        ...(statusMessage ? [fit(statusMessage)] : []),\n        \"\",\n        ...rows,\n      ].join(\"\\n\"));\n    };\n\n    const finish = (decision: WorkspaceTrustDecision) => {\n      if (complete) return;\n      complete = true;\n      input.removeListener(\"keypress\", onKeypress);\n      input.removeListener(\"close\", onClose);\n      try { input.setRawMode(oldRawMode); } catch {}\n      if (decision === \"exit\") {\n        try { input.pause(); } catch {}\n      }\n      output.write(\"\\u001b[?25h\\n\");\n      resolve(decision);\n    };\n\n    const onClose = () => finish(\"exit\");\n    const onKeypress = (_character: string | undefined, key: readline.Key) => {\n      if (key?.ctrl && key.name === \"c\") return finish(\"exit\");\n      if (key?.name === \"escape\") return finish(\"exit\");\n      if (key?.name === \"up\") {\n        choice = (choice + optionsText.length - 1) % optionsText.length;\n        render();\n        return;\n      }\n      if (key?.name === \"down\") {\n        choice = (choice + 1) % optionsText.length;\n        render();\n        return;\n      }\n      if (key?.name !== \"return\" && key?.name !== \"enter\") return;\n      if (choice === 0) {\n        try {\n          trustStore.trust(resolvedWorkspace);\n          finish(\"trusted\");\n        } catch (error) {\n          statusMessage = `Trust was not saved: ${safeTerminalText(String((error as Error)?.message ?? error))}`;\n          render();\n        }\n      } else if (choice === 1) {\n        finish(\"untrusted\");\n      } else {\n        finish(\"exit\");\n      }\n    };\n\n    readline.emitKeypressEvents(input);\n    input.on(\"keypress\", onKeypress);\n    input.once(\"close\", onClose);\n    try {\n      input.setRawMode(true);\n      input.resume();\n      output.write(\"\\u001b[?25l\");\n      render();\n    } catch {\n      finish(\"exit\");\n      output.write(`Nexus: could not open the trust prompt. Run 'nexus trust .' or restart in an interactive terminal.\\n`);\n    }\n  });\n}\n24-import { buildConfig as buildConfigOrThrow, loadEnvironment } from \"./config.js\";\n25-import { describeTarget, registerProviderCommands } from \"./provider_cli.js\";\n26-import { UsageLedger } from \"./usage.js\";\n27-import { DOCTOR_EXIT, DOCTOR_SCHEMA_VERSION, doctorExitCode, redactDiagnostic, renderDoctorJson, renderDoctorText, runDoctor, runRepairs } from \"./doctor.js\";\n28:import { promptWorkspaceTrust } from \"./startup_trust.js\";\n29-\n30-function collectDeliverableFile(value: string, previous: string[] = []): string[] {\n31-  return [...previous, value];\n32-}\n--\n204-    if (options.resume) parts.push(\"-r\", typeof options.resume === \"string\" ? options.resume : \"\");\n205-    fs.appendFileSync(log, parts.join(\" \").trim() + \"\\n\");\n206-    return;\n207-  }\n208:  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n209-  if (trustDecision === \"exit\") return;\n210-  triggerBackgroundGc();\n211-  const config = buildConfig(options);\n212-  if (config.model === \"local-model\") {\n--\n245-    if (!sidecarScript) {\n246-      console.error(\"nexus sidecar is not built. Run 'npm run build' in cli first.\");\n247-      process.exit(1);\n248-    }\n249:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n250-    if (trustDecision === \"exit\") return;\n251-    triggerBackgroundGc();\n252-    spawnTui(tuiBin, sidecarScript);\n253-    return;\n254-  }\n255-\n256-  const isInteractiveTty = Boolean(process.stdin.isTTY && process.stdout.isTTY);\n257-  if (isInteractiveTty && tuiBin && sidecarScript) {\n258:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n259-    if (trustDecision === \"exit\") return;\n260-    triggerBackgroundGc();\n261-    spawnTui(tuiBin, sidecarScript);\n262-    return;\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { PassThrough } from \"node:stream\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { promptWorkspaceTrust, trustedProjectRules, TrustPromptInput } from \"../src/startup_trust.js\";\nimport { AutonomousAgent } from \"../src/agent.js\";\n\nfunction mockTerminal(isTTY = true, columns = 80) {\n  const input = new PassThrough() as unknown as TrustPromptInput & { isRaw: boolean };\n  input.isTTY = isTTY;\n  input.isRaw = false;\n  input.setRawMode = ((value: boolean) => { input.isRaw = value; return input; }) as TrustPromptInput[\"setRawMode\"];\n\n  const output = new PassThrough() as PassThrough & { isTTY: boolean };\n  output.isTTY = isTTY;\n  output.columns = columns;\n  let text = \"\";\n  output.on(\"data\", (chunk) => { text += chunk.toString(); });\n  return { input, output, get text() { return text; } };\n}\n\nfunction workspaceWithInstructions(): string {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-prompt-\"));\n  fs.writeFileSync(path.join(workspace, \"AGENTS.md\"), \"project instruction\\n\");\n  return workspace;\n}\n\nfunction displayWidth(value: string): number {\n  const segmenter = new Intl.Segmenter(undefined, { granularity: \"grapheme\" });\n  let width = 0;\n  for (const { segment } of segmenter.segment(value)) {\n    const widths = [...segment].map((character) => {\n      const point = character.codePointAt(0)!;\n      if (character === \"\\u200d\" || /[\\p{Mark}\\p{Format}]/u.test(character)) return 0;\n      return point >= 0x1100 && (\n        point <= 0x115f || point === 0x2329 || point === 0x232a ||\n        (point >= 0x2e80 && point <= 0xa4cf && point !== 0x303f) ||\n        (point >= 0xac00 && point <= 0xd7a3) || (point >= 0xf900 && point <= 0xfaff) ||\n        (point >= 0xfe10 && point <= 0xfe19) || (point >= 0xfe30 && point <= 0xfe6f) ||\n        (point >= 0xff00 && point <= 0xff60) || (point >= 0xffe0 && point <= 0xffe6) ||\n        (point >= 0x1f000 && point <= 0x1faff) || (point >= 0x20000 && point <= 0x3fffd)\n      ) ? 2 : 1;\n    });\n    width += Math.max(0, ...widths);\n  }\n  return width;\n}\n\ntest(\"trust prompt offers explicit trust, continue-untrusted, and exit choices\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal(true, 40);\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => trusted,\n        trust: () => { trusted = true; },\n      },\n    });\n    await new Promise((resolve) => setImmediate(resolve));\n    const rendered = terminal.text.replace(/\\u001b\\[[0-9;?]*[A-Za-z]/g, \"\");\n    assert.match(rendered, /Trust this folder\\?/);\n    assert.match(rendered, /AGENTS\\.md/);\n    assert.match(rendered, /Trust and continue/);\n    assert.match(rendered, /Continue without trusting/);\n    assert.match(rendered, /Exit/);\n    assert.ok(rendered.split(\"\\n\").every((line) => displayWidth(line) <= 40), rendered);\n\n    terminal.input.emit(\"keypress\", undefined, { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"untrusted\");\n    assert.equal(trusted, false);\n    assert.equal(terminal.input.isRaw, false);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"trust prompt neutralizes bidi controls and fits wide Unicode paths by terminal cells\", async () => {\n  const parent = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-bidi-\"));\n  const workspace = path.join(parent, `項目-${\"界\".repeat(30)}-\\u202eabc-\\u200bdef-\\u2060ghi`);\n  fs.mkdirSync(workspace);\n  const terminal = mockTerminal(true, 40);\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => {} },\n    });\n    await new Promise((resolve) => setImmediate(resolve));\n    const rendered = terminal.text.replace(/\\u001b\\[[0-9;?]*[A-Za-z]/g, \"\");\n    assert.equal(rendered.includes(\"\\u202e\"), false);\n    assert.match(rendered, /�abc/);\n    assert.equal(rendered.includes(\"\\u200b\"), false);\n    assert.equal(rendered.includes(\"\\u2060\"), false);\n    assert.match(rendered, /�def/);\n    assert.match(rendered, /�ghi/);\n    assert.ok(rendered.split(\"\\n\").every((line) => displayWidth(line) <= 40), rendered);\n    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n    assert.equal(await decision, \"exit\");\n  } finally {\n    fs.rmSync(parent, { recursive: true, force: true });\n  }\n});\n\ntest(\"trust choice persists workspace trust and returns trusted\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => trusted,\n        trust: () => { trusted = true; },\n      },\n    });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"trusted\");\n    assert.equal(trusted, true);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"a trust-store write failure leaves the operator free to continue without trust\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => false,\n        trust: () => { throw new Error(\"store unavailable\"); },\n      },\n    });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.match(terminal.text, /Trust was not saved: store unavailable/);\n    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"untrusted\");\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"escape exits without recording trust\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => false,\n        trust: () => { trusted = true; },\n      },\n    });\n    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n    assert.equal(await decision, \"exit\");\n    assert.equal(trusted, false);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"a terminal that cannot enter prompt mode exits instead of silently choosing\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  terminal.input.setRawMode = (() => { throw new Error(\"raw mode unavailable\"); }) as TrustPromptInput[\"setRawMode\"];\n  try {\n    assert.equal(await promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => assert.fail(\"No trust choice was made\") },\n    }), \"exit\");\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.match(terminal.text, /could not open the trust prompt/);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"the Exit menu item exits without persisting trust\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => assert.fail(\"Exit must not record trust\") },\n    });\n    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"exit\");\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"workspace paths cannot inject terminal control sequences into the trust screen\", async () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-\\u001b[31m\"));\n  const terminal = mockTerminal();\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => {} },\n    });\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.equal(terminal.text.includes(\"\\u001b[31m\"), false);\n    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n    assert.equal(await decision, \"exit\");\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"non-interactive startup continues without trust or project instructions\", async () => {\n1.0.0-rc.3 (1b9791f07d30)\n3:  \"version\": \"1.0.0-rc.4\",\n3:  \"version\": \"1.0.0-rc.4\",\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16f03-b5c2-7ab2-ba06-07db849a401d","create_time":1792864464.670508}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
