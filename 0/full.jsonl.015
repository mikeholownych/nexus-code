t: string = \"HEAD\"): WorktreeCreateResult {\n    if (!this.isGitRepo()) {\n      throw new Error(`Cannot create worktree: ${this.workspace} is not a valid git repository.`);\n    }\n\n    const baseDir = this.getWorktreesBaseDir();\n    if (!fs.existsSync(baseDir)) {\n      fs.mkdirSync(baseDir, { recursive: true });\n    }\n\n    const worktreePath = path.join(baseDir, taskId);\n    const branch = `nexus/${taskId}`;\n\n    if (fs.existsSync(worktreePath)) {\n      throw new Error(`Worktree directory already exists at ${worktreePath}`);\n    }\n\n    try {\n      // Add worktree branching from startPoint (default HEAD)\n      execFileSync(\"git\", [\"worktree\", \"add\", \"-b\", branch, worktreePath, startPoint || \"HEAD\"], {\n        cwd: this.gitRoot,\n        encoding: \"utf-8\",\n        stdio: [\"ignore\", \"pipe\", \"pipe\"],\n      });\n\n      return {\n        taskId,\n        worktreePath,\n        branch,\n        created: true,\n      };\n    } catch (err: any) {\n      throw new Error(`Failed to create git worktree: ${err.stderr || err.message}`);\n    }\n  }\n\n  /**\n   * Lists all active Nexus speculative worktrees.\n   */\n  public listWorktrees(): WorktreeInfo[] {\n    if (!this.isGitRepo()) return [];\n\n    try {\n      const raw = execFileSync(\"git\", [\"worktree\", \"list\", \"--porcelain\"], {\n        cwd: this.gitRoot,\n        encoding: \"utf-8\",\n        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n      });\n\n      const entries = raw.split(\"\\n\\n\").filter(Boolean);\n      const worktrees: WorktreeInfo[] = [];\n      const baseDir = this.getWorktreesBaseDir();\n\n      for (const entry of entries) {\n        const lines = entry.split(\"\\n\");\n        let wtPath = \"\";\n        let headSha = \"\";\n        let branch = \"\";\n\n        for (const line of lines) {\n          if (line.startsWith(\"worktree \")) {\n            wtPath = line.substring(9).trim();\n/**\n * `.nexus/` must be ignored by Git even when `.git/info/exclude` already mentions the word in a\n * comment or an unrelated pattern. `/commit` uses `git add -A`, so state left trackable can be\n * staged into a user commit.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport * as fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\nimport { ensureGitExclude } from \"../src/core/git_exclude.js\";\n\nfunction makeRepo(exclude: string | null): { root: string; excludePath: string } {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-git-exclude-\"));\n  execFileSync(\"git\", [\"init\", \"-q\"], { cwd: root });\n  const excludePath = path.join(root, \".git\", \"info\", \"exclude\");\n  fs.mkdirSync(path.dirname(excludePath), { recursive: true });\n  if (exclude === null) {\n    try { fs.unlinkSync(excludePath); } catch {}\n  } else {\n    fs.writeFileSync(excludePath, exclude);\n  }\n  return { root, excludePath };\n}\n\nfunction isIgnored(root: string, relative: string): boolean {\n  try {\n    execFileSync(\"git\", [\"check-ignore\", \"-q\", relative], { cwd: root, stdio: \"pipe\" });\n    return true;\n  } catch {\n    return false;\n  }\n}\n\ntest(\"a comment mentioning .nexus does not suppress the ignore rule\", () => {\n  const { root, excludePath } = makeRepo(\"# keep .nexus out of git status\\n\");\n  try {\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n    assert.match(fs.readFileSync(excludePath, \"utf8\"), /^\\.nexus\\/$/m);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"an unrelated pattern containing .nexus does not suppress the rule\", () => {\n  const { root, excludePath } = makeRepo(\".nexus-backup/\\n\");\n  try {\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true…707 tokens truncated…t, \".nexus/\"), false);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), false);\n    const afterFirstAttempt = fs.readFileSync(excludePath, \"utf8\");\n    assert.throws(() => ensureGitExclude(root), /Git still does not ignore/);\n    assert.equal(fs.readFileSync(excludePath, \"utf8\"), afterFirstAttempt, \"failed retries do not append duplicate rules\");\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a missing exclude file is created with the rules\", () => {\n  const { root, excludePath } = makeRepo(null);\n  try {\n    ensureGitExclude(root);\n    const rules = fs.readFileSync(excludePath, \"utf8\").split(/\\r?\\n/);\n    assert.ok(rules.includes(\".nexus/\"));\n    assert.ok(rules.includes(\".nexus/worktrees/\"));\n    assert.ok(rules.includes(\".nexus/flights/\"));\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\nimport { test, describe, beforeEach, afterEach } from \"node:test\";\nimport assert from \"node:assert\";\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { execFileSync } from \"node:child_process\";\nimport { FlightRecorder } from \"../src/flight.js\";\nimport { WorktreeManager } from \"../src/worktree.js\";\nimport { ensureGitExclude } from \"../src/core/git_exclude.js\";\n\ndescribe(\"ACC-PER-05: Flight Logs & Telemetry Git Exclude (REQ-PER-105)\", () => {\n  let tmpDir: string;\n  let gitRepoDir: string;\n\n  beforeEach(() => {\n    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-flight-exclude-test-\"));\n    gitRepoDir = path.join(tmpDir, \"repo\");\n    fs.mkdirSync(gitRepoDir, { recursive: true });\n\n    execFileSync(\"git\", [\"init\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"config\", \"user.name\", \"Tester\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"config\", \"user.email\", \"tester@nexus.local\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"config\", \"commit.gpgsign\", \"false\"], { cwd: gitRepoDir });\n\n    fs.writeFileSync(path.join(gitRepoDir, \"README.md\"), \"# Test Repo\\n\");\n    execFileSync(\"git\", [\"add\", \".\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"commit\", \"-m\", \"Initial commit\"], { cwd: gitRepoDir });\n  });\n\n  afterEach(() => {\n    try {\n      fs.rmSync(tmpDir, { recursive: true, force: true });\n    } catch {}\n  });\n\n  test(\"ACC-PER-05: Fresh git repo with FlightRecorder writes telemetry but git status --porcelain shows nothing under .nexus/\", () => {\n    // Baseline: clean working tree\n    const initialStatus = execFileSync(\"git\", [\"status\", \"--porcelain\"], {\n      cwd: gitRepoDir,\n      encoding: \"utf-8\",\n    }).trim();\n    assert.strictEqual(initialStatus, \"\");\n\n    // Create FlightRecorder in repo\n    const recorder = new FlightRecorder(gitRepoDir);\n    recorder.startSession({ model: \"test-model\", prompt: \"Investigate bug\" });\n    recorder.recordTurnStart(1, \"Investigate bug\");\n    recorder.recordThought(1, \"Looking at files\");\n    recorder.recordSessionEnd(\"Done\", true);\n\n    // Verify flight log exists on disk\n    const flightLogPath = recorder.getLogPath();\n    assert.strictEqual(fs.existsSync(flightLogPath), true, \"Flight log must exist on disk\");\n\n    // ACC-PER-05 check: git status --porcelain must not show anything under .nexus/\n    const status = execFileSync(\"git\", [\"status\", \"--porcelain\"], {\n      cwd: gitRepoDir,\n      encoding: \"utf-8\",\n    }).trim();\n\n    assert.strictEqual(\n      status,\n      \"\",\n      `git status --porcelain must be completely clean; found:\\n${status}`\n    );\n\n    // Verify .git/info/exclude contains .nexus/\n    const excludePath = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n      cwd: gitRepoDir,\n      encoding: \"utf-8\",\n    }).trim();\n    const resolvedExclude = path.isAbsolute(excludePath) ? excludePath : path.resolve(gitRepoDir, excludePath);\n    assert.strictEqual(fs.existsSync(resolvedExclude), true, \"info/exclude must exist\");\n    const excludeContent = fs.readFileSync(resolvedExclude, \"utf-8\");\n    assert.ok(excludeContent.includes(\".nexus/\"), \"info/exclude must contain .nexus/\");\n  });\n\n  test(\"WorktreeManager ensures .nexus/ is excluded\", () => {\n    const wm = new WorktreeManager(gitRepoDir);\n    assert.ok(wm.isGitRepo());\n\n    const excludePath = path.resolve(gitRepoDir, \".git\", \"info\", \"exclude\");\n    assert.strictEqual(fs.existsSync(excludePath), true);\n    const content = fs.readFileSync(excludePath, \"utf-8\");\n    assert.ok(content.includes(\".nexus/\"));\n    assert.ok(content.includes(\".nexus/worktrees/\"));\n    assert.ok(content.includes(\".nexus/flights/\"));\n  });\n\n  test(\"ensureGitExclude is idempotent and does not duplicate entries\", () => {\n    ensureGitExclude(gitRepoDir);\n    ensureGitExclude(gitRepoDir);\n    ensureGitExclude(gitRepoDir);\n\n    const excludePath = path.resolve(gitRepoDir, \".git\", \"info\", \"exclude\");\n    const content = fs.readFileSync(excludePath, \"utf-8\");\n    const matches = content.match(/\\.nexus\\//g);\n    // .nexus/, .nexus/worktrees/, .nexus/flights/ each contain .nexus/ once\n    assert.ok(matches && matches.length === 3, \"Idempotent exclude calls must not duplicate entries\");\n  });\n});\nSUITE claim directory absent\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16f2a-3ce8-7e02-bf87-a11cb7ed706b","create_time":1792866787.0591931}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
