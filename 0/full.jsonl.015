us trust\\`): ${file}`));\n769:  .option(\"-w, --workspace <path>\", \"Workspace directory\")\n771:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n773:    const { untrustedWorkspaceExtensions } = await import(\"./workspace_trust.js\");\n774:    for (const file of untrustedWorkspaceExtensions(ws).filter((f) => !/(^|[\\\\/])\\.?mcp\\.json$/.test(f))) {\n775:      console.log(pc.yellow(`Not loaded (workspace not trusted; run \\`nexus trust\\`): ${file}`));\n790:  .command(\"trust [path]\")\n791:  .description(\"Trust a workspace so its own .mcp.json servers and plugins are loaded (they run code from the workspace)\")\n792:  .option(\"--remove\", \"Stop trusting the workspace\")\n793:  .option(\"--list\", \"List trusted workspaces\")\n795:    const { listTrustedWorkspaces, setWorkspaceTrusted } = await import(\"./workspace_trust.js\");\n797:      const list = listTrustedWorkspaces();\n798:      console.log(list.length ? list.join(\"\\n\") : \"No trusted workspaces.\");\n807:    const real = setWorkspaceTrusted(ws, !options.remove);\n808:    console.log(options.remove ? `No longer trusted: ${real}` : `Trusted: ${real}\\nIts .mcp.json servers and plugins will be loaded (they run code from this workspace). Undo with \\`nexus trust --remove\\`.`);\n813:  .description(\"List saved workspace snapshots and rollback checkpoints\")\n814:  .option(\"-w, --workspace <path>\", \"Workspace directory\")\n816:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n821:      console.log(pc.yellow(\"\\nNo saved checkpoints for this workspace.\\n\"));\n880:  .option(\"-w, --workspace <path>\", \"Workspace directory\", process.cwd())\n883:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n892:  .option(\"-w, --workspace <path>\", \"Workspace directory\", process.cwd())\n894:    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n916:  .option(\"-w, --workspace <