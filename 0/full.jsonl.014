-        const child = spawn(\"python3\", [\"-c\", pyScript], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n239-        let out = \"\";\n240-        let err = \"\";\n241-        child.stdout.on(\"data\", (c) => (out += c));\n242-        child.stderr.on(\"data\", (c) => (err += c));\n243-        child.on(\"close\", (c) => resolve({ code: c, out, err }));\n244-      });\n245-      assert.equal(code, 0, `PTY script failed: ${err}\\n${out}`);\n246-      const parsed = JSON.parse(out.trim().split(\"\\n\").pop() || \"{}\");\n247:      assert.equal(parsed.startup_ok, true, `Startup screen did not show unreachable endpoint + fix hint:\\n${parsed.output}`);\n248-      assert.equal(parsed.turn_ok, true, `First prompt did not end with bounded recovery guidance:\\n${parsed.output}`);\n249-      assert.match(parsed.output, /127\\.0\\.0\\.1:9/);\n250-      assert.match(parsed.output, /nexus doctor/);\n251-    } finally {\n252-      fs.rmSync(repo, { recursive: true, force: true });\n253-      fs.rmSync(home, { recursive: true, force: true });\n","exit_code":0,"duration":{"secs":0,"nanos":856932391}},"started_at_ms":1792831079306,"completed_at_ms":1792831080163}}
