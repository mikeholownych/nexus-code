{"timestamp":"2026-10-24T08:57:15.926Z","ordinal":283718,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","item":{"type":"CommandExecution","id":"exec-3a5ba6aa-5632-4faa-82f2-c8c907ec85dd","process_id":"17466","command":["/usr/bin/zsh","-lc","rg -n \"letters_disarmed_hint|disarm|Approval needed|10-approval|approval_survived\" cli/test/helpers/tui_surface_driver.py cli/src cli/test -g '*.{py,ts}' | head -160; sed -n '130,215p' cli/test/helpers/tui_surface_driver.py; sed -n '1,280p' cli/test/helpers/fixtures.ts"],"cwd":"file:///home/mike/nexus-wt/startup-workspace-trust","parsed_cmd":[{"type":"search","cmd":"rg -n 'letters_disarmed_hint|disarm|Approval needed|10-approval|approval_survived' cli/test/helpers/tui_surface_driver.py cli/src cli/test -g '*.{py,ts}'","query":"letters_disarmed_hint|disarm|Approval needed|10-approval|approval_survived","path":"tui_surface_driver.py"},{"type":"read","cmd":"sed -n '130,215p' cli/test/helpers/tui_surface_driver.py","name":"tui_surface_driver.py","path":"cli/test/helpers/tui_surface_driver.py"},{"type":"read","cmd":"sed -n '1,280p' cli/test/helpers/fixtures.ts","name":"fixtures.ts","path":"cli/test/helpers/fixtures.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"cli/test/helpers/tui_surface_driver.py:94:    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 20, \"the approval modal\")\ncli/test/helpers/tui_surface_driver.py:96:    shot(s, \"10-approval\")\ncli/test/helpers/tui_surface_driver.py:97:    result[\"approval_survived_buffered_keys\"] = has(s.color.lines(), \"Approval needed\")\ncli/test/helpers/tui_surface_driver.py:99:    result[\"letters_disarmed_hint\"] = any(\"typing ignored\" in l for l in s.color.lines())\ncli/test/tui_surface_e2e.test.ts:194:  const approval = screens[\"10-approval\"];\ncli/test/tui_surface_e2e.test.ts:195:  assert.ok(shows(approval, \"Approval needed\") && shows(approval, \"Proposed: create config.json\") && shows(approval, \"Approve all later actions\") && !shows(approval, \"y Approve\"), approval.join(\"\\n\"));\ncli/test/tui_surface_e2e.test.ts:196:  assert.ok(r.approval_survived_buffered_keys);\ncli/test/tui_surface_e2e.test.ts:197:  assert.ok(r.letters_disarmed_hint, \"keys typed just before the panel disarm its letters, and the panel says so\");\ncli/test/helpers/tui_surface_driver.py:94:    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 20, \"the approval modal\")\ncli/test/helpers/tui_surface_driver.py:96:    shot(s, \"10-approval\")\ncli/test/helpers/tui_surface_driver.py:97:    result[\"approval_survived_buffered_keys\"] = has(s.color.lines(), \"Approval needed\")\ncli/test/helpers/tui_surface_driver.py:99:    result[\"letters_disarmed_hint\"] = any(\"typing ignored\" in l for l in s.color.lines())\ncli/test/helpers/tui_approval_driver.py:55:    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 10, \"the approval panel\")\ncli/test/helpers/tui_approval_driver.py:57:    result[\"after_queued_keys\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\ncli/test/helpers/tui_approval_driver.py:61:    result[\"after_burst\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\ncli/test/helpers/tui_approval_driver.py:65:    result[\"after_paste\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\ncli/test/helpers/tui_approval_driver.py:75:    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 10, \"the second approval panel\")\ncli/test/helpers/tui_approval_driver.py:85:        seen_while_typing = seen_while_typing or has(s.color.lines(), \"Approval needed\")\ncli/test/helpers/tui_approval_driver.py:89:    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 10, \"the third approval panel\")\ncli/test/helpers/tui_approval_driver.py:91:    result[\"after_typing_across\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\ncli/test/helpers/tui_approval_typing_driver.py:40:        shown_during = shown_during or has(s.color.lines(), \"Approval needed\")\ncli/test/helpers/tui_approval_typing_driver.py:46:        \"after_typing\": {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")},\ncli/test/helpers/tui_approval_typing_driver.py:63:    result[\"after_editing_keys\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\n    s.pump(0.4)\n    shot(s, \"14-requirements-incomplete\")\n    # Start a new objective, as an operator would before unrelated work.\n    s.send(\"/requirements clear\\r\", settle=0.3)\n    s.wait_screen(lambda lines: has(lines, \"/requirements clear\"), 10, \"the clear command\")\n    s.pump(0.6)\n    s.wait_idle()\n\n    # A verification failure: an edit, then the repository's failing test command.\n    s.send(\"Fix the parser bug.\\r\", settle=0.2)\n    wait_events(events, \"turn.result\", 7, 120, s)\n    s.wait_idle()\n    s.pump(0.4)\n    shot(s, \"13-verification-failed\")\n\n    # Slash completion and help, with a draft kept.\n    s.send(\"/re\", settle=0.4)\n    shot(s, \"15-completion\")\n    s.send(\"\\x1b\", settle=0.2)\n    s.send(\"\\x0c\", settle=0.2)  # ctrl+l clears the draft\n    s.send(\"a draft I am keeping\", settle=0.2)\n    s.send(\"\\t\", settle=0.2)  # transcript focus\n    s.send(\"[\", settle=0.3)\n    shot(s, \"16-transcript-focus\")\n    s.send(\"\\r\", settle=0.6)\n    shot(s, \"17-entry-review\")\n    # From the edit's review, `i` opens the call record itself (tool, arguments, output).\n    s.send(\"i\", settle=0.2)\n    s.wait_screen(lambda lines: has(lines, \"Tool call\") and not has(lines, \"Loading the recorded call\"), 10, \"the tool detail panel\")\n    shot(s, \"17b-tool-detail\")\n    s.send(\"\\x1b\", settle=0.3)\n    s.send(\"\\t\", settle=0.2)\n    s.send(\"\\x1b\", settle=0.2)\n    s.send(\"\\x15\", settle=0.1)  # ctrl+u: clear the line so ? opens help\n    s.send(\"?\", settle=0.4)\n    shot(s, \"18-help\")\n    s.send(\"\\x1b\", settle=0.3)\n\n    # Narrow and short windows; resize while a turn streams.\n    s.set_size(60, 24)\n    s.pump(0.5)\n    shot(s, \"19-narrow\")\n    s.set_size(80, 12)\n    s.pump(0.5)\n    shot(s, \"20-short\")\n    s.set_size(120, 36)\n    s.pump(0.4)\n    s.send(\"Stream another answer.\\r\", settle=0.1)\n    s.pump(0.6)\n    s.set_size(64, 24)\n    s.pump(0.5)\n    shot(s, \"21-resize-during-stream\")\n    s.set_size(120, 36)\n    wait_events(events, \"turn.result\", 8, 30, s)\n    s.wait_idle()\n    s.pump(0.3)\n\n    # Idle: nothing redrawn.\n    before = len(s.raw)\n    s.pump(2.0)\n    result[\"idle_bytes\"] = len(s.raw) - before\n\n    # The sidecar dies: the crash screen, then restart.\n    s.send(\"a draft before the crash\", settle=0.2)\n    for child in children(s.pid):\n        os.kill(child, signal.SIGKILL)\n    s.wait_screen(lambda lines: has(lines, \"stopped\"), 15, \"the crash screen\")\n    s.pump(0.5)\n    shot(s, \"22-crashed\")\n    s.send(\"r\", settle=0.3)\n    # Wait on the current screen, not the output history (which still holds the hint from before the crash).\n    s.wait_screen(lambda lines: has(lines, \"enter send\"), 30, \"the restarted agent's idle hint\")\n    s.pump(0.5)\n    shot(s, \"23-restarted\")\n    # The recovery the crash screen names: /resume reloads the saved conversation in the new agent.\n    s.send(\"\\x0c\", settle=0.2)\n    s.send(\"/resume\\r\", settle=0.3)\n    s.wait_screen(lambda lines: has(lines, \"Resumed session\"), 20, \"the resumed conversation after restart\")\n    s.pump(0.5)\n    shot(s, \"23b-restart-then-resume\")\n    s.send(\"\\x03\", settle=0.1)\n    s.send(\"\\x03\", settle=0.1)\n    result[\"first_exit\"] = s.wait_exit(20)\n\n    # Resume the saved session.\n    cast.append([round(time.monotonic() - T0, 4), \"m\", \"new TUI process: resume the saved session (-r latest)\"])\nimport { test } from \"node:test\";\nimport http from \"node:http\";\nimport type { Socket } from \"node:net\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execSync } from \"node:child_process\";\n\nexport type Reply =\n  /** `truncated`: the reply hits the output limit (finish_reason=length) partway through its tool calls' arguments. */\n  | { kind: \"tools\"; calls: Array<{ name: string; args: unknown; id?: string }>; content?: string; delayMs?: number; truncated?: boolean }\n  /** `chunks`: stream the text in these pieces, `gapMs` apart (the default sends it in one delta). `truncated`: finish_reason=length. */\n  | { kind: \"text\"; content: string; delayMs?: number; chunks?: string[]; gapMs?: number; truncated?: boolean }\n  | { kind: \"http\"; status: number; body?: string; delayMs?: number };\n\nexport interface Gateway {\n  url: string;\n  requests: unknown[];\n  /** Bodies of /tokenize requests (only with `options.tokenize`). */\n  tokenizeRequests: any[];\n  /** Number of GET /models requests served. */\n  modelRequests: number;\n  /** Authorization headers seen, per path kind. */\n  authSeen: Array<{ path: string; authorization?: string }>;\n  close(): Promise<void>;\n}\n\n/** Optional gateway capabilities (homelab-ai contract shape): catalog entries, request counting, admission headers. */\nexport interface GatewayOptions {\n  /** `data` entries for GET /models (default: [{ id: \"m\" }]). Called per request, so tests can change capacity. */\n  models?: () => any[];\n  /** Answer to POST /tokenize; absent: 404. */\n  tokenize?: (body: any, n: number) => { status: number; body: unknown; delayMs?: number };\n  /** Response headers for the n-th chat request (e.g. X-AIHost-* admission headers). */\n  headers?: (n: number, body: any) => Record<string, string>;\n}\n\nfunction sse(obj: unknown): string {\n  return `data: ${JSON.stringify(obj)}\\n\\n`;\n}\n\n/** A tool call's arguments as sent: whole, or cut off partway like a reply that hit the output limit. */\nfunction wireArguments(args: unknown, truncated?: boolean): string {\n  const json = JSON.stringify(args);\n  return truncated ? json.slice(0, Math.max(1, Math.floor(json.length / 2))) : json;\n}\n\nfunction finishReason(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  return r.truncated ? \"length\" : r.kind === \"tools\" ? \"tool_calls\" : \"stop\";\n}\n\nfunction streamBody(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  let out = \"\";\n  if (r.kind === \"text\") out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n  else {\n    if (r.content) out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n    r.calls.forEach((c, i) => {\n      out += sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: i, id: c.id ?? `call_${i}_${Math.random().toString(36).slice(2, 7)}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } }] } }] });\n    });\n  }\n  out += sse({ choices: [{ index: 0, delta: {}, finish_reason: finishReason(r) }] });\n  return out + \"data: [DONE]\\n\\n\";\n}\n\n/** Deterministic OpenAI-compatible gateway. `script(n, body)` decides the reply to the n-th chat request (1-based). */\nexport async function startGateway(script: (n: number, body?: any) => Reply, options: GatewayOptions = {}): Promise<Gateway> {\n  const requests: unknown[] = [];\n  const tokenizeRequests: any[] = [];\n  const authSeen: Array<{ path: string; authorization?: string }> = [];\n  let modelRequests = 0;\n  const sockets = new Set<Socket>();\n  const server = http.createServer((req, res) => {\n    authSeen.push({ path: req.url ?? \"\", authorization: req.headers.authorization });\n    if (req.url?.endsWith(\"/models\")) {\n      modelRequests++;\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ data: options.models ? options.models() : [{ id: \"m\" }] }));\n      return;\n    }\n    if (req.url?.endsWith(\"/tokenize\")) {\n      let raw = \"\";\n      req.on(\"data\", (c) => (raw += c));\n      req.on(\"end\", () => {\n        let body: any = {};\n        try { body = JSON.parse(raw); } catch {}\n        tokenizeRequests.push(body);\n        if (!options.tokenize) {\n          res.statusCode = 404;\n          res.end(JSON.stringify({ status: \"not_found\", message: \"no tokenize\" }));\n          return;\n        }\n        const answer = options.tokenize(body, tokenizeRequests.length);\n        const send = () => {\n          if (res.writableEnded || res.destroyed) return;\n          res.statusCode = answer.status;\n          res.setHeader(\"content-type\", \"application/json\");\n          res.end(typeof answer.body === \"string\" ? answer.body : JSON.stringify(answer.body));\n        };\n        if (answer.delayMs) setTimeout(send, answer.delayMs); else send();\n      });\n      return;\n    }\n    let raw = \"\";\n    req.on(\"data\", (c) => (raw += c));\n    req.on(\"end\", () => {\n      let body: any = {};\n      try { body = JSON.parse(raw); } catch {}\n      requests.push(body);\n      const extraHeaders = options.headers ? options.headers(requests.length, body) : {};\n      for (const [k, v] of Object.entries(extraHeaders)) res.setHeader(k, v);\n      const r = script(requests.length, body);\n      const respond = () => {\n        if (res.writableEnded || res.destroyed) return;\n        if (r.kind === \"http\") {\n          res.statusCode = r.status;\n          res.end(r.body ?? \"{}\");\n        } else if (body.stream && r.kind === \"text\" && r.chunks?.length) {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          const pieces = [...r.chunks];\n          const next = () => {\n            if (res.writableEnded || res.destroyed) return;\n            const piece = pieces.shift();\n            if (piece === undefined) {\n              res.end(sse({ choices: [{ index: 0, delta: {}, finish_reason: \"stop\" }] }) + \"data: [DONE]\\n\\n\");\n              return;\n            }\n            res.write(sse({ choices: [{ index: 0, delta: { content: piece } }] }));\n            setTimeout(next, r.gapMs ?? 50);\n          };\n          next();\n        } else if (body.stream) {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          res.end(streamBody(r));\n        } else {\n          res.setHeader(\"content-type\", \"application/json\");\n          const message = r.kind === \"text\"\n            ? { role: \"assistant\", content: r.content }\n            : { role: \"assistant\", content: r.content ?? null, tool_calls: r.calls.map((c, i) => ({ id: c.id ?? `call_${i}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } })) };\n          res.end(JSON.stringify({ choices: [{ index: 0, message, finish_reason: r.truncated ? \"length\" : \"stop\" }] }));\n        }\n      };\n      if (r.delayMs) setTimeout(respond, r.delayMs); else respond();\n    });\n  });\n  server.on(\"connection\", (s) => { sockets.add(s); s.on(\"close\", () => sockets.delete(s)); });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", () => resolve()));\n  const port = (server.address() as any).port;\n  return {\n    url: `http://127.0.0.1:${port}/v1`,\n    requests,\n    tokenizeRequests,\n    get modelRequests() {\n      return modelRequests;\n    },\n    authSeen,\n    close: async () => {\n      for (const s of sockets) s.destroy();\n      await new Promise<void>((resolve) => server.close(() => resolve()));\n    },\n  };\n}\n\n/** Temporary git repository with one committed file. */\nexport function makeRepo(files: Record<string, string> = {}): string {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-sidecar-\"));\n  fs.writeFileSync(path.join(repo, \"base.txt\"), \"base\\n\");\n  for (const [name, content] of Object.entries(files)) {\n    const full = path.join(repo, name);\n    fs.mkdirSync(path.dirname(full), { recursive: true });\n    fs.writeFileSync(full, content);\n  }\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm base\", { cwd: repo, stdio: \"ignore\" });\n  return repo;\n}\n\nexport function makeHome(): string {\n  return fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-home-\"));\n}\n\n/** Seed an isolated HOME with explicit trust for a PTY test that needs to reach the REPL. */\nexport function trustWorkspace(home: string, workspace: string): void {\n  const trustDir = path.join(home, \".config\", \"nexus\");\n  fs.mkdirSync(trustDir, { recursive: true, mode: 0o700 });\n  fs.writeFileSync(\n    path.join(trustDir, \"trusted_workspaces.json\"),\n    JSON.stringify({ trustedPaths: [fs.realpathSync(workspace)] }, null, 2),\n    { mode: 0o600 },\n  );\n}\n\nexport async function waitUntil(cond: () => boolean, timeoutMs = 10000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (!cond()) {\n    if (Date.now() > deadline) throw new Error(\"timed out\");\n    await new Promise((r) => setTimeout(r, 10));\n  }\n}\n\nexport async function waitForEvent(events: any[], pred: (e: any) => boolean, timeoutMs = 10000): Promise<any> {\n  try {\n    await waitUntil(() => events.some(pred), timeoutMs);\n  } catch {\n    throw new Error(`timed out waiting for event; saw: ${events.map((e) => e.type).join(\", \")}`);\n  }\n  return events.find(pred);\n}\n\n/**\n * Pseudo-terminal scenarios measure timing (spinner frames, idle redraws, approval grace) and drive real processes;\n * run concurrently by the test runner they starve each other and keys arrive late. `ptyTest` holds a cross-process\n * lock (a directory under the system temp dir, taken over when its owner is gone) so they run one at a time.\n */\nexport async function acquirePtyLock(timeoutMs = 15 * 60_000): Promise<() => void> {\n  const dir = path.join(os.tmpdir(), \"nexus-pty-test.lock\");\n  const owner = path.join(dir, \"pid\");\n  const deadline = Date.now() + timeoutMs;\n  for (;;) {\n    try {\n      fs.mkdirSync(dir);\n      fs.writeFileSync(owner, String(process.pid));\n      return () => fs.rmSync(dir, { recursive: true, force: true });\n    } catch (err: any) {\n      if (err?.code !== \"EEXIST\") throw err;\n      let pid = 0;\n      try {\n        pid = Number(fs.readFileSync(owner, \"utf8\"));\n      } catch {}\n      let alive = false;\n      try {\n        if (pid > 0) {\n          process.kill(pid, 0);\n          alive = true;\n        }\n      } catch {}\n      // A lock without a live owner (crashed run, or an owner not yet written for a while) is taken over.\n      if (!alive && (pid > 0 || Date.now() - fs.statSync(dir).mtimeMs > 5_000)) {\n        fs.rmSync(dir, { recursive: true, force: true });\n        continue;\n      }\n      if (Date.now() > deadline) throw new Error(`timed out waiting for the PTY test lock held by pid ${pid}`);\n      await new Promise((r) => setTimeout(r, 200));\n    }\n  }\n}\n\nexport function ptyTest(name: string, options: { timeout?: number }, fn: () => Promise<void>): void {\n  test(name, { ...options, timeout: (options.timeout ?? 120_000) + 15 * 60_000 }, async () => {\n    const release = await acquirePtyLock();\n    try {\n      await fn();\n    } finally {\n      release();\n    }\n  });\n}\n","exit_code":0,"duration":{"secs":0,"nanos":893948812}},"started_at_ms":1792832235029,"completed_at_ms":1792832235923}}
{"timestamp":"2026-10-24T08:57:17.211Z","ordinal":283719,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a16d20-ee9b-7f53-a010-c4452ef4aed2","call_id":"call_73aca451a5ff4a798e464762f444eab4","output":[{"type":"input_text","text":"Script completed\nWall time 3.3 seconds\nOutput:\n"},{"type":"input_text","text":"cli/test/helpers/tui_surface_driver.py:94:    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 20, \"the approval modal\")\ncli/test/helpers/tui_surface_driver.py:96:    shot(s, \"10-approval\")\ncli/test/helpers/tui_surface_driver.py:97:    result[\"approval_survived_buffered_keys\"] = has(s.color.lines(), \"Approval needed\")\ncli/test/helpers/tui_surface_driver.py:99:    result[\"letters_disarmed_hint\"] = any(\"typing ignored\" in l for l in s.color.lines())\ncli/test/tui_surface_e2e.test.ts:194:  const approval = screens[\"10-approval\"];\ncli/test/tui_surface_e2e.test.ts:195:  assert.ok(shows(approval, \"Approval needed\") && shows(approval, \"Proposed: create config.json\") && shows(approval, \"Approve all later actions\") && !shows(approval, \"y Approve\"), approval.join(\"\\n\"));\ncli/test/tui_surface_e2e.test.ts:196:  assert.ok(r.approval_survived_buffered_keys);\ncli/test/tui_surface_e2e.test.ts:197:  assert.ok(r.letters_disarmed_hint, \"keys typed just before the panel disarm its letters, and the panel says so\");\ncli/test/helpers/tui_surface_driver.py:94:    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 20, \"the approval modal\")\ncli/test/helpers/tui_surface_driver.py:96:    shot(s, \"10-approval\")\ncli/test/helpers/tui_surface_driver.py:97:    result[\"approval_survived_buffered_keys\"] = has(s.color.lines(), \"Approval needed\")\ncli/test/helpers/tui_surface_driver.py:99:    result[\"letters_disarmed_hint\"] = any(\"typing ignored\" in l for l in s.color.lines())\ncli/test/helpers/tui_approval_driver.py:55:    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 10, \"the approval panel\")\ncli/test/helpers/tui_approval_driver.py:57:    result[\"after_queued_keys\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\ncli/test/helpers/tui_approval_driver.py:61:    result[\"after_burst\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\ncli/test/helpers/tui_approval_driver.py:65:    result[\"after_paste\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\ncli/test/helpers/tui_approval_driver.py:75:    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 10, \"the second approval panel\")\ncli/test/helpers/tui_approval_driver.py:85:        seen_while_typing = seen_while_typing or has(s.color.lines(), \"Approval needed\")\ncli/test/helpers/tui_approval_driver.py:89:    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 10, \"the third approval panel\")\ncli/test/helpers/tui_approval_driver.py:91:    result[\"after_typing_across\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\ncli/test/helpers/tui_approval_typing_driver.py:40:        shown_during = shown_during or has(s.color.lines(), \"Approval needed\")\ncli/test/helpers/tui_approval_typing_driver.py:46:        \"after_typing\": {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")},\ncli/test/helpers/tui_approval_typing_driver.py:63:    result[\"after_editing_keys\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\n    s.pump(0.4)\n    shot(s, \"14-requirements-incomplete\")\n    # Start a new objective, as an operator would before unrelated work.\n    s.send(\"/requirements clear\\r\", settle=0.3)\n    s.wait_screen(lambda lines: has(lines, \"/requirements clear\"), 10, \"the clear command\")\n    s.pump(0.6)\n    s.wait_idle()\n\n    # A verification failure: an edit, then the repository's failing test command.\n    s.send(\"Fix the parser bug.\\r\", settle=0.2)\n    wait_events(events, \"turn.result\", 7, 120, s)\n    s.wait_idle()\n    s.pump(0.4)\n    shot(s, \"13-verification-failed\")\n\n    # Slash completion and help, with a draft kept.\n    s.send(\"/re\", settle=0.4)\n    shot(s, \"15-completion\")\n    s.send(\"\\x1b\", settle=0.2)\n    s.send(\"\\x0c\", settle=0.2)  # ctrl+l clears the draft\n    s.send(\"a draft I am keeping\", settle=0.2)\n    s.send(\"\\t\", settle=0.2)  # transcript focus\n    s.send(\"[\", settle=0.3)\n    shot(s, \"16-transcript-focus\")\n    s.send(\"\\r\", settle=0.6)\n    shot(s, \"17-entry-review\")\n    # From the edit's review, `i` opens the call record itself (tool, arguments, output).\n    s.send(\"i\", settle=0.2)\n    s.wait_screen(lambda lines: has(lines, \"Tool call\") and not has(lines, \"Loading the recorded call\"), 10, \"the tool detail panel\")\n    shot(s, \"17b-tool-detail\")\n    s.send(\"\\x1b\", settle=0.3)\n    s.send(\"\\t\", settle=0.2)\n    s.send(\"\\x1b\", settle=0.2)\n    s.send(\"\\x15\", settle=0.1)  # ctrl+u: clear the line so ? opens help\n    s.send(\"?\", settle=0.4)\n    shot(s, \"18-help\")\n    s.send(\"\\x1b\", settle=0.3)\n\n    # Narrow and short windows; resize while a turn streams.\n    s.set_size(60, 24)\n    s.pump(0.5)\n    shot(s, \"19-narrow\")\n    s.set_size(80, 12)\n    s.pump(0.5)\n    shot(s, \"20-short\")\n    s.set_size(120, 36)\n    s.pump(0.4)\n    s.send(\"Stream another answer.\\r\", settle=0.1)\n    s.pump(0.6)\n    s.set_size(64, 24)\n    s.pump(0.5)\n    shot(s, \"21-resize-during-stream\")\n    s.set_size(120, 36)\n    wait_events(events, \"turn.result\", 8, 30, s)\n    s.wait_idle()\n    s.pump(0.3)\n\n    # Idle: nothing redrawn.\n    before = len(s.raw)\n    s.pump(2.0)\n    result[\"idle_bytes\"] = len(s.raw) - before\n\n    # The sidecar dies: the crash screen, then restart.\n    s.send(\"a draft before the crash\", settle=0.2)\n    for child in children(s.pid):\n        os.kill(child, signal.SIGKILL)\n    s.wait_screen(lambda lines: has(lines, \"stopped\"), 15, \"the crash screen\")\n    s.pump(0.5)\n    shot(s, \"22-crashed\")\n    s.send(\"r\", settle=0.3)\n    # Wait on the current screen, not the output history (which still holds the hint from before the crash).\n    s.wait_screen(lambda lines: has(lines, \"enter send\"), 30, \"the restarted agent's idle hint\")\n    s.pump(0.5)\n    shot(s, \"23-restarted\")\n    # The recovery the crash screen names: /resume reloads the saved conversation in the new agent.\n    s.send(\"\\x0c\", settle=0.2)\n    s.send(\"/resume\\r\", settle=0.3)\n    s.wait_screen(lambda lines: has(lines, \"Resumed session\"), 20, \"the resumed conversation after restart\")\n    s.pump(0.5)\n    shot(s, \"23b-restart-then-resume\")\n    s.send(\"\\x03\", settle=0.1)\n    s.send(\"\\x03\", settle=0.1)\n    result[\"first_exit\"] = s.wait_exit(20)\n\n    # Resume the saved session.\n    cast.append([round(time.monotonic() - T0, 4), \"m\", \"new TUI process: resume the saved session (-r latest)\"])\nimport { test } from \"node:test\";\nimport http from \"node:http\";\nimport type { Socket } from \"node:net\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execSync } from \"node:child_process\";\n\nexport type Reply =\n  /** `truncated`: the reply hits the output limit (finish_reason=length) partway through its tool calls' arguments. */\n  | { kind: \"tools\"; calls: Array<{ name: string; args: unknown; id?: string }>; content?: string; delayMs?: number; truncated?: boolean }\n  /** `chunks`: stream the text in these pieces, `gapMs` apart (the default sends it in one delta). `truncated`: finish_reason=length. */\n  | { kind: \"text\"; content: string; delayMs?: number; chunks?: string[]; gapMs?: number; truncated?: boolean }\n  | { kind: \"http\"; status: number; body?: string; delayMs?: number };\n\nexport interface Gateway {\n  url: string;\n  requests: unknown[];\n  /** Bodies of /tokenize requests (only with `options.tokenize`). */\n  tokenizeRequests: any[];\n  /** Number of GET /models requests served. */\n  modelRequests: number;\n  /** Authorization headers seen, per path kind. */\n  authSeen: Array<{ path: string; authorization?: string }>;\n  close(): Promise<void>;\n}\n\n/** Optional gateway capabilities (homelab-ai contract shape): catalog entries, request counting, admission headers. */\nexport interface GatewayOptions {\n  /** `data` entries for GET /models (default: [{ id: \"m\" }]). Called per request, so tests can change capacity. */\n  models?: () => any[];\n  /** Answer to POST /tokenize; absent: 404. */\n  tokenize?: (body: any, n: number) => { status: number; body: unknown; delayMs?: number };\n  /** Response headers for the n-th chat request (e.g. X-AIHost-* admission headers). */\n  headers?: (n: number, body: any) => Record<string, string>;\n}\n\nfunction sse(obj: unknown): string {\n  return `data: ${JSON.stringify(obj)}\\n\\n`;\n}\n\n/** A tool call's arguments as sent: whole, or cut off partway like a reply that hit the output limit. */\nfunction wireArguments(args: unknown, truncated?: boolean): string {\n  const json = JSON.stringify(args);\n  return truncated ? json.slice(0, Math.max(1, Math.floor(json.length / 2))) : json;\n}\n\nfunction finishReason(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  return r.truncated ? \"length\" : r.kind === \"tools\" ? \"tool_calls\" : \"stop\";\n}\n\nfunction streamBody(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  let out = \"\";\n  if (r.kind === \"text\") out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n  else {\n    if (r.content) out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n    r.calls.forEach((c, i) => {\n      out += sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: i, id: c.id ?? `call_${i}_${Math.random().toString(36).slice(2, 7)}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } }] } }] });\n    });\n  }\n  out += sse({ choices: [{ index: 0, delta: {}, finish_reason: finishReason(r) }] });\n  return out + \"data: [DONE]\\n\\n\";\n}\n\n/** Deterministic OpenAI-compatible gateway. `script(n, body)` decides the reply to the n-th chat request (1-based). */\nexport async function startGateway(script: (n: number, body?: any) => Reply, options: GatewayOptions = {}): Promise<Gateway> {\n  const requests: unknown[] = [];\n  const tokenizeRequests: any[] = [];\n  const authSeen: Array<{ path: string; authorization?: string }> = [];\n  let modelRequests = 0;\n  const sockets = new Set<Socket>();\n  const server = http.createServer((req, res) => {\n    authSeen.push({ path: req.url ?? \"\", authorization: req.headers.authorization });\n    if (req.url?.endsWith(\"/models\")) {\n      modelRequests++;\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ data: options.models ? options.models() : [{ id: \"m\" }] }));\n      return;\n    }\n    if (req.url?.endsWith(\"/tokenize\")) {\n      let raw = \"\";\n      req.on(\"data\", (c) => (raw += c));\n      req.on(\"end\", () => {\n        let body: any = {};\n        try { body = JSON.parse(raw); } catch {}\n        tokenizeRequests.push(body);\n        if (!options.tokenize) {\n          res.statusCode = 404;\n          res.end(JSON.stringify({ status: \"not_found\", message: \"no tokenize\" }));\n          return;\n        }\n        const answer = options.tokenize(body, tokenizeRequests.length);\n        const send = () => {\n          if (res.writableEnded || res.destroyed) return;\n          res.statusCode = answer.status;\n          res.setHeader(\"content-type\", \"application/json\");\n          res.end(typeof answer.body === \"string\" ? answer.body : JSON.stringify(answer.body));\n        };\n        if (answer.delayMs) setTimeout(send, answer.delayMs); else send();\n      });\n      return;\n    }\n    let raw = \"\";\n    req.on(\"data\", (c) => (raw += c));\n    req.on(\"end\", () => {\n      let body: any = {};\n      try { body = JSON.parse(raw); } catch {}\n      requests.push(body);\n      const extraHeaders = options.headers ? options.headers(requests.length, body) : {};\n      for (const [k, v] of Object.entries(extraHeaders)) res.setHeader(k, v);\n      const r = script(requests.length, body);\n      const respond = () => {\n        if (res.writableEnded || res.destroyed) return;\n        if (r.kind === \"http\") {\n          res.statusCode = r.status;\n          res.end(r.body ?? \"{}\");\n        } else if (body.stream && r.kind === \"text\" && r.chunks?.length) {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          const pieces = [...r.chunks];\n          const next = () => {\n            if (res.writableEnded || res.destroyed) return;\n            const piece = pieces.shift();\n            if (piece === undefined) {\n              res.end(sse({ choices: [{ index: 0, delta: {}, finish_reason: \"stop\" }] }) + \"data: [DONE]\\n\\n\");\n              return;\n            }\n            res.write(sse({ choices: [{ index: 0, delta: { content: piece } }] }));\n            setTimeout(next, r.gapMs ?? 50);\n          };\n          next();\n        } else if (body.stream) {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          res.end(streamBody(r));\n        } else {\n          res.setHeader(\"content-type\", \"application/json\");\n          const message = r.kind === \"text\"\n            ? { role: \"assistant\", content: r.content }\n            : { role: \"assistant\", content: r.content ?? null, tool_calls: r.calls.map((c, i) => ({ id: c.id ?? `call_${i}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } })) };\n          res.end(JSON.stringify({ choices: [{ index: 0, message, finish_reason: r.truncated ? \"length\" : \"stop\" }] }));\n        }\n      };\n      if (r.delayMs) setTimeout(respond, r.delayMs); else respond();\n    });\n  });\n  server.on(\"connection\", (s) => { sockets.add(s); s.on(\"close\", () => sockets.delete(s)); });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", () => resolve()));\n  const port = (server.address() as any).port;\n  return {\n    url: `http://127.0.0.1:${port}/v1`,\n    requests,\n    tokenizeRequests,\n    get modelRequests() {\n      return modelRequests;\n    },\n    authSeen,\n    close: async () => {\n      for (const s of sockets) s.destroy();\n      await new Promise<void>((resolve) => server.close(() => resolve()));\n    },\n  };\n}\n\n/** Temporary git repository with one committed file. */\nexport function makeRepo(files: Record<string, string> = {}): string {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-sidecar-\"));\n  fs.writeFileSync(path.join(repo, \"base.txt\"), \"base\\n\");\n  for (const [name, content] of Object.entries(files)) {\n    const full = path.join(repo, name);\n    fs.mkdirSync(path.dirname(full), { recursive: true });\n    fs.writeFileSync(full, content);\n  }\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm base\", { cwd: repo, stdio: \"ignore\" });\n  return repo;\n}\n\nexport function makeHome(): string {\n  return fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-home-\"));\n}\n\n/** Seed an isolated HOME with explicit trust for a PTY test that needs to reach the REPL. */\nexport function trustWorkspace(home: string, workspace: string): void {\n  const trustDir = path.join(home, \".config\", \"nexus\");\n  fs.mkdirSync(trustDir, { recursive: true, mode: 0o700 });\n  fs.writeFileSync(\n    path.join(trustDir, \"trusted_workspaces.json\"),\n    JSON.stringify({ trustedPaths: [fs.realpathSync(workspace)] }, null, 2),\n    { mode: 0o600 },\n  );\n}\n\nexport async function waitUntil(cond: () => boolean, timeoutMs = 10000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (!cond()) {\n    if (Date.now() > deadline) throw new Error(\"timed out\");\n    await new Promise((r) => setTimeout(r, 10));\n  }\n}\n\nexport async function waitForEvent(events: any[], pred: (e: any) => boolean, timeoutMs = 10000): Promise<any> {\n  try {\n    await waitUntil(() => events.some(pred), timeoutMs);\n  } catch {\n    throw new Error(`timed out waiting for event; saw: ${events.map((e) => e.type).join(\", \")}`);\n  }\n  return events.find(pred);\n}\n\n/**\n * Pseudo-terminal scenarios measure timing (spinner frames, idle redraws, approval grace) and drive real processes;\n * run concurrently by the test runner they starve each other and keys arrive late. `ptyTest` holds a cross-process\n * lock (a directory under the system temp dir, taken over when its owner is gone) so they run one at a time.\n */\nexport async function acquirePtyLock(timeoutMs = 15 * 60_000): Promise<() => void> {\n  const dir = path.join(os.tmpdir(), \"nexus-pty-test.lock\");\n  const owner = path.join(dir, \"pid\");\n  const deadline = Date.now() + timeoutMs;\n  for (;;) {\n    try {\n      fs.mkdirSync(dir);\n      fs.writeFileSync(owner, String(process.pid));\n      return () => fs.rmSync(dir, { recursive: true, force: true });\n    } catch (err: any) {\n      if (err?.code !== \"EEXIST\") throw err;\n      let pid = 0;\n      try {\n        pid = Number(fs.readFileSync(owner, \"utf8\"));\n      } catch {}\n      let alive = false;\n      try {\n        if (pid > 0) {\n          process.kill(pid, 0);\n          alive = true;\n        }\n      } catch {}\n      // A lock without a live owner (crashed run, or an owner not yet written for a while) is taken over.\n      if (!alive && (pid > 0 || Date.now() - fs.statSync(dir).mtimeMs > 5_000)) {\n        fs.rmSync(dir, { recursive: true, force: true });\n        continue;\n      }\n      if (Date.now() > deadline) throw new Error(`timed out waiting for the PTY test lock held by pid ${pid}`);\n      await new Promise((r) => setTimeout(r, 200));\n    }\n  }\n}\n\nexport function ptyTest(name: string, options: { timeout?: number }, fn: () => Promise<void>): void {\n  test(name, { ...options, timeout: (options.timeout ?? 120_000) + 15 * 60_000 }, async () => {\n    const release = await acquirePtyLock();\n    try {\n      await fn();\n    } finally {\n      release();\n    }\n  });\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","create_time":1792832237.2114837}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
