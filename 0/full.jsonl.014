((c) => c.type === \"steer\").length, 1);\n   190\t  assert.deepEqual(events.filter((e) => e.type === \"steer.ack\").map((e) => e.status), [\"queued\", \"applied\"]);\n   191\t  // Paste: the sent text is visible under its label.\n   192\t  assert.ok(shows(screens[\"07-tools-final\"].concat(all), \"line one of the note\"), \"pasted text shown\");\n   193\t  // Approval: target and decisions with focus; buffered keys did not decide.\n   194\t  const approval = screens[\"10-approval\"];\n   195\t  assert.ok(shows(approval, \"Approval needed\") && shows(approval, \"Proposed: create config.json\") && shows(approval, \"Approve all later actions\") && !shows(approval, \"y Approve\"), approval.join(\"\\n\"));\n   196\t  assert.ok(r.approval_survived_buffered_keys);\n   197\t  assert.ok(r.letters_disarmed_hint, \"keys typed just before the panel disarm its letters, and the panel says so\");\n   198\t  // Requirements: listed once, and the repeated replies are explained.\n   199\t  const req = screens[\"14-requirements-incomplete\"];\n   200\t  assert.ok(shows(req, \"R1 [open] add a README section\") && shows(req, \"asked the agent to continue\"), req.join(\"\\n\"));\n   201\t  assert.ok(!req.some((l) => l.includes(\"handled.Both\")), \"replies are not run together\");\n   202\t  // Verification failure names the command.\n   203\t  assert.ok(shows(screens[\"13-verification-failed\"], \"npm test failed\"), screens[\"13-verification-failed\"].join(\"\\n\"));\n","exit_code":0,"duration":{"secs":0,"nanos":41291118}},"started_at_ms":1792832317036,"completed_at_ms":1792832317080}}
