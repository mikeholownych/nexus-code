/** Configuration errors (unknown provider, missing model or base URL) end the command with a message, not a trace. */\nfunction buildConfig(options: any): HarnessConfig {\n  try {\n    return buildConfigOrThrow(options);\n  } catch (err: any) {\n    console.error(pc.red(`Configuration error: ${err?.message ?? err}`));\n    process.exit(2);\n  }\n}\nimport { registerOperationCommands } from \"./operation_cli.js\";\nimport pc from \"picocolors\";\n\nimport * as os from \"node:os\";\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\n// Keep the lease for the full frontend/sidecar lifetime, including synchronous\n// TUI dispatch. Maintenance recovery acquires its own exclusive lease instead.\nconst startupArgs = process.argv.slice(2);\nconst { acquireClientLease, releaseClientLease, clientInvocationKind } = await import(\"./core/client_lease.js\");\nconst invocationKind = clientInvocationKind(startupArgs);\nconst startupReadOnly = invocationKind === \"metadata\" || (startupArgs[0] === \"upgrade\" && startupArgs.includes(\"--check\"));\n// `upgrade --check` is read-only, so it must not replay a transaction. It also\n// must not load configuration while a restore journal says that config may be\n// only partially applied. Refuse before loadEnvironment() and let a normal\n// managed launch perform recovery.\nif (startupArgs[0] === \"upgrade\" && startupArgs.includes(\"--check\")) {\n  try {\n    const { hasPendingStateRestore } = await import(\"./core/state_restore.js\");\n    if (hasPendingStateRestore(process.env.HOME || os.homedir())) {\n      throw new Error(\"Pending state restore must be recovered before running upgrade --check\");\n    }\n  } catch (error: any) {\n    console.error(`[maintenance] ${error?.message ?? \"Nexus restore state could not be verified\"}`);\n    process.exit(2);\n  }\n}\n// A durable state-restore intent must be replayed before environment/config\n// loading or any normal client is admitted. The recovery command takes the\n// exclusive lifetime lease; ordinary clients take their shared lease below.\nif (invocationKind === \"restore\" || (invocationKind === \"client\" && !startupReadOnly)) {\n  try {\n    const { hasPendingStateRestore, recoverPendingStateRestore } = await import(\"./core/state_restore.js\");\n    const home = process.env.HOME || os.homedir();\n    if (hasPendingStateRestore(home) && !recoverPendingStateRestore(home)) {\n      throw new Error(\"Pending state restore could not be recovered; no state was admitted\");\n    }\n  } catch (error: any) {\n    console.error(`[maintenance] ${error?.message ?? \"Nexus restore recovery failed closed\"}`);\n    process.exit(2);\n  }\n}\nif (invocationKind === \"client\") {\n  try {\n    const lease = acquireClientLease(process.env.HOME || os.homedir());\n    process.once(\"exit\", () => releaseClientLease(lease));\n  } catch (error: any) {\n    console.error(`[maintenance] ${error.message}`);\n    process.exit(2);\n  }\n  loadEnvironment();\n}\n\n// Diagnose an interrupted packaged upgrade before launching a new CLI/TUI\n// session. Read-only version/help/check commands never recover or write state.\nif (!startupReadOnly && startupArgs[0] !== \"upgrade\" && process.env.NEXUS_UPGRADE_HEALTH_CHECK !== \"1\" && process.env.NEXUS_HOME) {\n  const { getJournalPath, readJournal, recoverUpgrade } = await import(\"./upgrade_journal.js\");\n  const packagedPrefix = path.resolve(process.env.NEXUS_HOME, \"../../..\");\n  const journal = readJournal(packagedPrefix);\n  if ((journal && ![\"idle\", \"complete\", \"rolled_back\"].includes(journal.state)) || (!journal && fs.existsSync(getJournalPath(packagedPrefix)))) {\n    const outcome = recoverUpgrade(packagedPrefix);\n    if (outcome.action === \"upgrade_in_progress\") console.error(`[upgrade] ${outcome.details}`);\n    if (outcome.action === \"manual_intervention\") {\n      console.error(`[upgrade] ${outcome.details}. Run nexus upgrade --recover after resolving the recorded failure.`);\n      process.exit(2);\n    }\n    const options = cmd.optsWithGlobals();\n    await startRepl(options);\n  });\n\nprogram\n  .command(\"run\")\n  .description(\"Run an autonomous coding task\")\n  .argument(\"[prompt...]\", \"The coding instructions / task prompt\")\n  .option(\"-e, --endpoint <url>\", \"Local LLM endpoint (default: http://localhost:1234/v1 or $LOCAL_LLM_ENDPOINT)\")\n  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in LM Studio/vLLM)\")\n  .option(\"-w, --workspace <path>\", \"Workspace directory to inspect and modify (default: current directory)\")\n  .option(\"-s, --max-steps <number>\", \"Steps per segment; continuation checkpoints there instead of stopping\", \"30\")\n  .option(\"--max-total-steps <number>\", \"Continuation: an explicit total-step limit for one turn (default: none; progressing work continues)\")\n  .option(\"--strict-token-count\", \"Refuse a request the connection could not count on a worker (default: proceed on the labelled estimate)\")\n  .option(\"--max-turn-minutes <number>\", \"Continuation: an explicit wall-clock limit for one turn in minutes (default: none)\")\n  .option(\"--stagnation-steps <number>\", \"Continuation: stop after this many steps without progress (default 12)\")\n  .option(\"--no-continuation\", \"End a turn at --max-steps instead of continuing while it makes progress\")\n  .option(\"-t, --temperature <number>\", \"Model temperature\", \"0.2\")\n  .option(\"--shell <type>\", \"Linux shell to use: bash, zsh, or sh (default: bash or $LOCAL_HARNESS_SHELL)\", \"bash\")\n  .option(\"--fallback <urls>\", \"Comma-separated fallback LLM endpoints if primary is unavailable\")\n  .option(\"--context-limit <tokens>\", \"Context window limit in tokens; below the provider's advertised capacity it is kept, above it the advertised capacity applies (default: advertised capacity, else 65536)\")\n  .option(\"--dry-run\", \"Simulate file modifications without writing changes to disk\")\n  .option(\"--read-only\", \"Reject all mutating tool executions and commands\")\n  .option(\"-y, --yes\", \"Run non-interactively without approval prompts (forces auto mode)\")\n  .option(\"--approve\", \"Require human approval before destructive actions (forces review mode)\")\n  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: auto for trusted workspaces, review for untrusted)\")\n  .option(\"--sandbox [mode]\", \"Isolate command execution using bubblewrap (bwrap) or Docker (default: auto)\")\n  .option(\"--worktree\", \"Isolate execution inside an ephemeral git worktree under .nexus/worktrees/<task-id>\")\n  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\n  .option(\"--deliverable-file <path>\", \"Operator-declared workspace-relative product file used for VERIFIED binding (repeatable)\", collectDeliverableFile, [])\n  .option(\"--record-flight\", \"Record execution into an append-only deterministic .flightlog\")\n  .option(\"--planner-model <name>\", \"Deep reasoning model for architecture planning (o3, R1, Sonnet)\")\n  .option(\"--planner-endpoint <url>\", \"Dedicated inference endpoint for planner model\")\n  .option(\"--coder-model <name>\", \"High-throughput model for surgical code implementation (Qwen 2.5 Coder)\")\n  .option(\"--coder-endpoint <url>\", \"Dedicated inference endpoint for coder model\")\n  .option(\"--tdd\", \"Enforce strict RED-GREEN-REFACTOR Test-Driven Development protocol\")\n  .option(\"--provider <id>\", \"Cloud inference provider: openrouter, openai, anthropic, compatible (default: appliance endpoint)\")\n  .option(\"--base-url <url>\", \"Override the provider's base URL (operator-only; required for 'compatible')\")\n  .option(\"--planner-provider <id>\", \"Cloud provider for the planner model (requires --planner-model)\")\n  .option(\"--coder-provider <id>\", \"Cloud provider for the coder model (requires --coder-model)\")\n  .option(\"-j, --json\", \"Output machine-readable JSON structured result (UI-002, UI-003)\")\n  .option(\"-r, --resume [id]\", \"Resume previous session or task state\")\n  .action(async (promptParts: string[], _options: any, cmd: Command) => {\n    // Preserve inherited CLI values when the command-level duplicate only has\n    // its default; explicitly supplied command options still take precedence.\n    const options = cmd.optsWithGlobals();\n    for (const option of cmd.options) {\n      const name = option.attributeName();\n      if (cmd.getOptionValueSource(name) !== \"default\") options[name] = _options[name];\n    }\n    let prompt = promptParts.join(\" \").trim();\n    const config = buildConfig(options);\n    config.surface = \"headless\";\n    const isJson = Boolean(options.json);\n\n    // Auto-detect loaded model if model is 'local-model'\n    if (config.model === \"local-model\") {\n      try {\n        const client = new LocalLlmClient(config);\n        const models = await client.listModels();\n        if (models.length > 0) {\n          config.model = models[0];\n          if (!isJson) {\n            console.log(pc.dim(`🔍 Auto-detected active model: ${pc.bold(config.model)}`));\n          }\n        }\n      } catch {\n        // Fallback to default\n      }\n    }\n\n    if (!isJson && (config.provider || config.plannerProvider || config.coderProvider)) console.error(pc.dim(describeTarget(config)));\n    const app = new ApplicationCore(config);\n\n    let resumeTaskId: string | undefined;\n    if (options.resume !== undefined && options.resume !== false) {\n      if (typeof options.resume === \"string\" && options.resume !== \"latest\") {\n        resumeTaskId = options.resume;\n      } else {\n        const targetWorkspace = config.workspace || process.cwd();\n        const tasks = app\n          .getStateManager()\n          .listTasks({ workspace: targetWorkspace })\n          .filter((t) => t.taskId !== app.getTaskId());\n        if (tasks.length === 0) {\n          console.error(`no task to resume in ${targetWorkspace}; see 'nexus status'`);\n          app.shutdown();\n          exitAfterFlush(2);\n          return;\n        }\n        resumeTaskId = tasks[0].taskId;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16e23-3d1b-7571-9aa1-825e60ce3175","create_time":1792849807.6197367}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
