ub(r\"\\x1b\\[[0-9;?]*[a-zA-Z]\", \"\", out.decode(\"utf-8\", \"ignore\"))\nsys.stdout.write(clean)\nsys.stdout.flush()\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\n\n/** Workspace files that configure MCP servers, and directories plugins are loaded from: used only when trusted. */\nexport const WORKSPACE_MCP_FILES = [\".mcp.json\", \"mcp.json\"];\nexport const WORKSPACE_PLUGIN_DIRS = [path.join(\".nexus\", \"plugins\"), \"plugins\"];\n\n/**\n * The workspace's own MCP configuration files and plugin modules that exist but are not loaded because the workspace\n * is not trusted (or the session is read-only). Empty when there are none or the workspace is trusted.\n */\nexport function untrustedWorkspaceExtensions(workspace: string, readOnly = false): string[] {\n  if (isWorkspaceTrusted(workspace, readOnly)) return [];\n  const root = path.resolve(workspace);\n  const found = WORKSPACE_MCP_FILES.map((f) => path.join(root, f)).filter((f) => fs.existsSync(f));\n  for (const dir of WORKSPACE_PLUGIN_DIRS) {\n    try {\n      for (const name of fs.readdirSync(path.join(root, dir))) {\n        if (name.endsWith(\".js\") || name.endsWith(\".mjs\")) found.push(path.join(root, dir, name));\n      }\n    } catch {}\n  }\n  return found;\n}\n\nexport function getTrustStorePath(): string {\n  return path.join(os.homedir(), \".config\", \"nexus\", \"trusted_workspaces.json\");\n}\n\n/**\n * Check if the given workspace is explicitly trusted by the operator.\n * In --read-only mode, workspace trust never authorizes executing project plugins/MCP.\n */\nexport function isWorkspaceTrusted(workspace: string, readOnly = false): boolean {\n  if (readOnly) return false;\n  if (process.env.NEXUS_TRUST_WORKSPACE === \"1\") return true;\n\n  try {\n    const resolved = path.resolve(workspace);\n    const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\n    const storePath = getTrustStorePath();\n    if (!fs.existsSync(storePath)) return false;\n    const content = JSON.parse(fs.readFileSync(storePath, \"utf8\"));\n    if (Array.isArray(content)) {\n      return content.includes(realWs);\n    }\n    if (content && typeof content === \"object\" && Array.isArray(content.trustedPaths)) {\n      return content.trustedPaths.includes(realWs);\n    }\n  } catch {}\n  return false;\n}\n\n/** The trusted workspaces (real paths), as recorded in the trust store. */\nexport function listTrustedWorkspaces(): string[] {\n  try {\n    const raw = JSON.parse(fs.readFileSync(getTrustStorePath(), \"utf8\"));\n    const list = Array.isArray(raw) ? raw : Array.isArray(raw?.trustedPaths) ? raw.trustedPaths : [];\n    return list.filter((p: unknown): p is string => typeof p === \"string\");\n  } catch {\n    return [];\n  }\n}\n\n/** Records (or removes) the operator's trust in a workspace. Returns its real path; throws when the store cannot be written. */\nexport function setWorkspaceTrusted(workspace: string, trusted: boolean): string {\n  const resolved = path.resolve(workspace);\n  const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\n  const storePath = getTrustStorePath();\n  fs.mkdirSync(path.dirname(storePath), { recursive: true, mode: 0o700 });\n  const list = listTrustedWorkspaces().filter((p) => p !== realWs);\n  if (trusted) list.push(realWs);\n  const temp = `${storePath}.${process.pid}.tmp`;\n  fs.writeFileSync(temp, JSON.stringify({ trustedPaths: list }, null, 2), { mode: 0o600 });\n  fs.renameSync(temp, storePath);\n  return realWs;\n}\n      },\n    }), \"untrusted\");\n    assert.equal(trusted, false);\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.match(terminal.text, /Project instructions and workspace integrations stay unloaded/);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"project instructions load only for trusted workspaces\", () => {\n  const workspace = workspaceWithInstructions();\n  try {\n    assert.equal(trustedProjectRules(workspace, () => false), null);\n    assert.match(trustedProjectRules(workspace, () => true) ?? \"\", /project instruction/);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"AutonomousAgent omits project rules until workspace trust is explicit\", () => {\n  const workspace = workspaceWithInstructions();\n  const savedTrust = process.env.NEXUS_TRUST_WORKSPACE;\n  let untrustedAgent: AutonomousAgent | undefined;\n  let trustedAgent: AutonomousAgent | undefined;\n  try {\n    delete process.env.NEXUS_TRUST_WORKSPACE;\n    untrustedAgent = new AutonomousAgent({\n      endpoint: \"http://127.0.0.1:9/v1\",\n      model: \"test-model\",\n      maxSteps: 1,\n      temperature: 0,\n      workspace,\n      shell: \"bash\",\n      approvalMode: \"review\",\n    } as any, 0, { durable: false });\n    const untrustedPrompt = String(untrustedAgent.getMessages()[0].content);\n    assert.equal(untrustedPrompt.includes(\"project instruction\"), false);\n\n    process.env.NEXUS_TRUST_WORKSPACE = \"1\";\n    trustedAgent = new AutonomousAgent({\n      endpoint: \"http://127.0.0.1:9/v1\",\n      model: \"test-model\",\n      maxSteps: 1,\n      temperature: 0,\n      workspace,\n      shell: \"bash\",\n      approvalMode: \"review\",\n    } as any, 0, { durable: false });\n    assert.equal(String(trustedAgent.getMessages()[0].content).includes(\"project instruction\"), true);\n  } finally {\n    untrustedAgent?.shutdown();\n    trustedAgent?.shutdown();\n    if (savedTrust === undefined) delete process.env.NEXUS_TRUST_WORKSPACE;\n    else process.env.NEXUS_TRUST_WORKSPACE = savedTrust;\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n      cwd: cliRoot,\n      env: {\n        ...process.env,\n        HOME: home,\n        TERM: \"xterm\",\n        COLUMNS: \"120\",\n        LINES: \"40\",\n        // These tests cover turn interruption, not the startup workspace-trust prompt.\n        NEXUS_TRUST_WORKSPACE: \"1\",\n      },\n    });\n    let out = \"\";\n    child.stdout.on(\"data\", (d) => (out += d.toString()));\n    child.stderr.on(\"data\", (d) => (out += d.toString()));\n    const strip = () => out.replace(/\\x1b\\[[0-9;?]*[A-Za-z]/g, \"\");\n    const waitFor = async (re: RegExp, from: number, ms = 30000): Promise<number> => {\n      const t0 = Date.now();\n      for (;;) {\n        const s = strip();\n        const m = re.exec(s.slice(from));\n        if (m) return from + m.index + m[0].length;\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\n\nconst harness = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\", \"..\", \"harness.sh\");\nconst distDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\", \"dist\");\nconst nodeModulesDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\", \"node_modules\");\n\ninterface Checkout {\n  root: string;\n  node: string;\n  log: string;\n  calls(): string[];\n}\n\n/** A copy of harness.sh in a fake checkout with real dist/ and mock nexus-tui/REPL recorder. */\nfunction fakeCheckout(withTui: boolean): Checkout {\n  const root = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-entry-\")));\n  fs.copyFileSync(harness, path.join(root, \"harness.sh\"));\n  fs.mkdirSync(path.join(root, \"cli\"), { recursive: true });\n  fs.symlinkSync(distDir, path.join(root, \"cli\", \"dist\"));\n  if (fs.existsSync(nodeModulesDir)) {\n    fs.symlinkSync(nodeModulesDir, path.join(root, \"cli\", \"node_modules\"));\n  }\n  const log = path.join(root, \"calls.log\");\n  const recorder = `#!/bin/sh\\necho \"$(basename \"$0\") $*\" >> \"${log}\"\\n`;\n  if (withTui) {\n    fs.mkdirSync(path.join(root, \"core\", \"target\", \"release\"), { recursive: true });\n    fs.writeFileSync(path.join(root, \"core\", \"target\", \"release\", \"nexus-tui\"), recorder, { mode: 0o755 });\n  }\n  return {\n    root,\n    node: process.execPath,\n    log,\n    calls: () => (fs.existsSync(log) ? fs.readFileSync(log, \"utf-8\").trim().split(\"\\n\") : []),\n  };\n}\n\nfunction env(checkout: Checkout): NodeJS.ProcessEnv {\n  return {\n    ...process.env,\n    HOME: checkout.root,\n    NODE_EXEC: checkout.node,\n    NEXUS_TEST_RECORD_REPL: checkout.log,\n    // These tests assert harness argument routing, not the startup workspace-trust prompt.\n    NEXUS_TRUST_WORKSPACE: \"1\",\n  };\n}\n\n/** Runs harness.sh with a pseudo-terminal on stdin and stdout (util-linux `script`), like an operator's shell. */\nfunction inTerminal(checkout: Checkout, args: string[]) {\n  const command = [\"bash\", path.join(checkout.root, \"harness.sh\"), ...args].map((a) => `'${a}'`).join(\" \");\n  return spawnSync(\"script\", [\"-qec\", command, \"/dev/null\"], { env: env(checkout), encoding: \"utf-8\", input: \"\" });\n}\n\n/** Runs harness.sh with pipes, like a script or CI job. */\nfunction piped(checkout: Checkout, args: string[]) {\n  return spawnSync(\"bash\", [path.join(checkout.root, \"harness.sh\"), ...args], { env: env(checkout), encoding: \"utf-8\", input: \"\" });\n}\n\ndescribe(\"harness.sh entry\", () => {\n  test(\"no arguments in a terminal open the live TUI\", () => {\n    const c = fakeCheckout(true);\n    try {\n      assert.equal(inTerminal(c, []).status, 0);\n      assert.deepEqual(c.calls(), [`nexus-tui --live --sidecar ${c.root}/cli/dist/sidecar.js --node ${c.node} --`]);\n    } finally {\n      fs.rmSync(c.root, { recursive: true, force: true });\n    }\n  });\n\n  test(\"no arguments without a terminal run the REPL\", () => {\n    const c = fakeCheckout(true);\n    try {\n      assert.equal(piped(c, []).status, 0);\n      assert.deepEqual(c.calls(), [\"repl\"]);\n    } finally {\n      fs.rmSync(c.root, { recursive: true, force: true });\n    }\n  });\n\n  test(\"an unbuilt TUI falls back to the REPL and says why\", () => {\n    const c = fakeCheckout(false);\n    try {\n      const run = inTerminal(c, []);\n      assert.equal(run.status, 0);\nfind: ‘.git/nexus-claims’: Not a directory\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","create_time":1792830153.500271}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
