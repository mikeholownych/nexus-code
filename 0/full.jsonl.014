essionManager, SessionData } from \"./session.js\";\n--\n299-      ? pc.cyan(` [git: ${pc.bold(gitInfo.formattedBadge)}]`)\n300-      : \"\";\n301-\n302:    const trusted = isWorkspaceTrusted(this.config.workspace, Boolean(this.config.readOnly));\n303-    const sandboxStatus = this.config.sandbox ? (typeof this.config.sandbox === \"string\" ? this.config.sandbox : \"on\") : \"off\";\n304:    const trustStatus = trusted ? \"trusted\" : \"untrusted (nexus trust .)\";\n305:    console.log(pc.dim(`mode: ${this.approvalMode} · sandbox: ${sandboxStatus} · workspace: ${trustStatus}`));\n306-\n307-    console.log(`${pc.bold(pc.cyan(\"WORKSPACE\"))}  ${pc.white(wsName)}${gitBadge}  ${pc.dim(this.config.workspace)}`);\n308-    console.log(`${pc.bold(pc.cyan(\"MODEL\"))}      ${pc.green(this.config.model)}  ${pc.dim(`· ${this.approvalMode === \"auto\" ? \"autonomous\" : this.approvalMode === \"read-only\" ? \"read-only\" : \"review mode\"}`)}`);\n--\n344-    console.log(`  ${pc.bold(pc.yellow(\"/audit [count]\"))}       View recent tool execution history and metrics`);\n345-    console.log(`  ${pc.bold(pc.yellow(\"/export [md|json]\"))}    Export session transcript to file in workspace`);\n346-    console.log(`  ${pc.bold(pc.yellow(\"/tokens\"))}             Show context message count and token usage`);\n347:    console.log(`  ${pc.bold(pc.yellow(\"/init\"))}               Scaffold AGENTS.md rules file in workspace`);\n348-    console.log(`  ${pc.bold(pc.yellow(\"/model [name]\"))}       View or switch loaded model`);\n349-    console.log(`  ${pc.bold(pc.yellow(\"/shell [bash|zsh]\"))}   Switch Linux execution shell`);\n350-    console.log(`  ${pc.bold(pc.yellow(\"/cd <path>\"))}          Change active workspace directory`);\n--\n1630-            console.log(pc.green(`✔ Onboarding complete for ${pc.bold(report.projectName)}!`));\n1631-            console.log(`  • Detected stack: ${pc.cyan(report.languages.join(\", \") || \"General\")}`);\n1632-            console.log(`  • Detected commands: build: ${report.buildCommands[0] || \"none\"}, test: ${report.testCommands[0] || \"none\"}, lint: ${report.lintCommands[0] || \"none\"}`);\n1633:            console.log(`  • Generated customized ${pc.bold(\"AGENTS.md\")} with architecture diagram.\\n`);\n1634-            continue;\n1635-          } else if (cmd === \"test\") {\n1636-            const filterPattern = arg.trim() || undefined;\n--\n1643-            const desc = describeVerifier(this.config.workspace, commandOverride);\n1644-            const testCmd = desc?.command || commandOverride;\n1645-\n1646:            // Verifier gating under review mode / untrusted workspace\n1647-            const isTrusted = isWorkspaceTrusted(this.config.workspace, Boolean(this.config.readOnly));\n1648-            const mode = this.config.approvalMode ?? (this.config.readOnly ? \"read-only\" : (this.config.fullAccess ? \"auto\" : (isTrusted ? \"auto\" : \"review\")));\n1649-            const policyContext: PolicyContext = {\n1650-              mode,\n1651:              trusted: isTrusted,\n1652-              sandbox: this.config.sandbox,\n1653-              fullAccess: Boolean(this.config.fullAccess),\n1654-            };\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16e48-57ed-79c2-bd99-946dbd9156e1","create_time":1792852572.61052}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
