xt, runDoctor, runRepairs } from \"./doctor.js\";\n28-import { promptWorkspaceTrust } from \"./startup_trust.js\";\n--\n1122-  });\n1123-\n1124-registerOperationCommands(program);\n1125:registerProviderCommands(program);\n1126-\n1127-program.parse(process.argv);\n1128-\n600 mike:mike /home/mike/.codex/auth.json\n600 mike:mike /home/mike/.local/share/opencode/auth.json\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16e58-0fa9-73b3-824f-571bf4a9cd42","create_time":1792852684.6923091}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
