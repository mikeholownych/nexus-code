test/helpers/fixtures.ts:247:3'\n15670-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0006800Z   failureType: 'testCodeFailure'\n15671:linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0007455Z   error: 'keys typed just before the panel disarm its letters, and the panel says so'\n15672-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0008031Z   code: 'ERR_ASSERTION'\n15673-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0008359Z   name: 'AssertionError'\n15674-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0008675Z   expected: true\n15675-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0008970Z   actual: false\n15676-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0009246Z   operator: '=='\n15677-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0009516Z   stack: |-\n15678-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0010248Z     assertSurface (/home/runner/work/nexus-code/nexus-code/cli/test/tui_surface_e2e.test.ts:197:10)\n15679-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0011236Z     <anonymous> (/home/runner/work/nexus-code/nexus-code/cli/test/tui_surface_e2e.test.ts:153:5)\n15680-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0011832Z     process.processTicksAndRejections (node:internal/process/task_queues:103:5)\n15681-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0012490Z     async TestContext.<anonymous> (/home/runner/work/nexus-code/nexus-code/cli/test/helpers/fixtures.ts:250:7)\n15682-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0013013Z     async Test.run (node:internal/test_runner/test:1054:7)\n15683-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0013471Z     async startSubtestAfterBootstrap (node:internal/test_runner/harness:296:3)\n15684-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.0013791Z   ...\n15685-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.7580445Z # [provider_capabilities] reason=step model=m context 65536 (client_default); output allowance 8192 (client_default); discovery unsupported (catalog lists no limits); token counting unsupported\n15686-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.7681279Z # [context_admission] step=1 request_id=3892487e-bfe8-4cce-bd2d-c6a7a62613bd state=admitted estimated_tokens=4479 completion_reserve=8192 tool_response_reserve=4096 limit=65536 compacted=false messages=2\n15687-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.7695252Z # [token_count] step=1 request_id=3892487e-bfe8-4cce-bd2d-c6a7a62613bd source=client_estimate prompt_tokens=4479 client_estimate=4479 context_limit=65536 (client_default) output_allowance=8192 (client_default) tool_headroom_policy=4096 unmeasured=\"the connection advertises no request counting\"\n15688-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.7713009Z # - ^[[36mNexus is considering the next step^[[39m\n15689-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.7848574Z # ✖ ^[[31mInference provider temporarily unavailable^[[39m\n15690-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:12.7849987Z # ^[[33m⏳ Provider recovery (step 1): http_error HTTP 500, execution UNKNOWN; next check in 1s (request 3892487e-bfe8-4cce-bd2d-c6a7a62613bd).^[[39m\n15691-linux-x86_64\tRun npm --prefix cli test\t2026-10-24T08:54:13.4875954Z # ^[[31m✗ Provider recovery exhausted: execution status unknown and the replay budget (1) is spent^[[39m\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","create_time":1792832223.3032062}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
