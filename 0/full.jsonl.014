RUSTUP_HOME=/usr/local/rustup \\\n41-    \"$NEXUS_BUILD_CONTAINER_IMAGE\" \\\n42-    cargo build --locked --release --manifest-path /nexus-source/core/Cargo.toml --bin harness-core --bin nexus-tui\n43:  RUST_CORE_TARGET=\"$WORK/rust-build/target/release\"\n44-else\n45-  cargo build --locked --release --manifest-path \"$ROOT/core/Cargo.toml\" --bin harness-core --bin nexus-tui\n46:  RUST_CORE_TARGET=\"$ROOT/core/target/release\"\n47-fi\n48-\n49-PKG=\"$WORK/nexus\"\n50-mkdir -p \"$PKG/bin\" \"$PKG/lib/core\" \"$PKG/lib/cli\"\n51-cp -R \"$ROOT/cli/dist\" \"$PKG/lib/cli/dist\"\n52-cp \"$ROOT/cli/package.json\" \"$ROOT/cli/package-lock.json\" \"$PKG/lib/cli/\"\n53-npm ci --omit=dev --prefix \"$PKG/lib/cli\"\n54-cp \"$RUST_CORE_TARGET/harness-core\" \"$RUST_CORE_TARGET/nexus-tui\" \"$PKG/lib/core/\"\n--\n61-      echo \"$binary requires GLIBC_$required_glibc, above the GLIBC_2.35 compatibility ceiling\" >&2\n62-      exit 1\n63-    fi\n64-  fi\n65-done\n66-cp \"$ROOT/LICENSE\" \"$PKG/LICENSE\"\n67-printf '%s\\n' \"$VERSION\" > \"$PKG/VERSION\"\n68-\n69:SOURCE_DATE_EPOCH=$(git -C \"$ROOT\" log -1 --format=%ct)\n70:export SOURCE_DATE_EPOCH\n71-GIT_COMMIT=$(git -C \"$ROOT\" rev-parse HEAD)\n72:BUILD_DATE=$(date -u -d \"@$SOURCE_DATE_EPOCH\" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r \"$SOURCE_DATE_EPOCH\" +%Y-%m-%dT%H:%M:%SZ)\n73:ARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\n74-STATE_SCHEMA_VERSION=$(node --input-type=module - \"$PKG/lib/cli/dist/core/state.js\" <<'EOF'\n75-import { pathToFileURL } from 'node:url';\n76-const { CURRENT_STATE_SCHEMA_VERSION: version } = await import(pathToFileURL(process.argv[2]).href);\n77-if (!Number.isSafeInteger(version) || version < 1) throw new Error('packaged client has no valid state schema');\n78-process.stdout.write(String(version));\n79-EOF\n80-)\n81-\n82:# Embed the compatibility contract in the attested archive. The detached asset\n83:# adds the archive digest after the archive is built and is covered by SHA256SUMS.\n84-cat > \"$PKG/compatibility.json\" <<EOF\n85-{\n86-  \"schemaVersion\": 1,\n87-  \"product\": \"nexus-code\",\n88-  \"version\": \"${VERSION#v}\",\n89-  \"revision\": \"$GIT_COMMIT\",\n90-  \"builtAt\": \"$BUILD_DATE\",\n91-  \"minimumUpdaterVersion\": \"0.1.0-alpha.2\",\n--\n98-  \"compatibility\": {\n99-    \"configSchemaVersion\": 1,\n100-    \"stateSchemaVersion\": $STATE_SCHEMA_VERSION,\n101-    \"minSupportedConfigVersion\": 1,\n102-    \"minSupportedStateVersion\": 0\n103-  },\n104-  \"platforms\": {\n105-    \"linux-x86_64\": {\n106:      \"archive\": \"$ARCHIVE\",\n107-      \"os\": \"linux\",\n108-      \"arch\": \"x86_64\",\n109-      \"libc\": \"glibc-2.35\"\n110-    }\n111-  }\n112-}\n113-EOF\n114-node \"$ROOT/scripts/validate_compatibility.mjs\" \"$PKG/compatibility.json\"\n--\n116-cargo about generate -m \"$ROOT/core/Cargo.toml\" -c \"$ROOT/about.toml\" \"$ROOT/about.hbs\" > \"$WORK/notices-rust.txt\"\n117-# Keep the full release-tool dependency graph fixed across the RC builds.\n118-RELEASE_TOOLS=\"$WORK/release-tools\"\n119-mkdir -p \"$RELEASE_TOOLS\"\n120-cp \"$ROOT/scripts/release-tools/package.json\" \"$ROOT/scripts/release-tools/package-lock.json\" \"$RELEASE_TOOLS/\"\n121-node \"$ROOT/scripts/check_deprecated_lock.mjs\" \"$ROOT/scripts/release-tools/package-lock.json\"\n122-npm ci --ignore-scripts --prefix \"$RELEASE_TOOLS\"\n123-RELEASE_TOOLS_BIN=\"$RELEASE_TOOLS/node_modules/.bin\"\n124:\"$RELEASE_TOOLS_BIN/license-checker-rseidelsohn\" --production --plainVertical --start \"$PKG/lib/cli\" > \"$WORK/notices-npm.txt\"\n125-cat > \"$PKG/THIRD_PARTY_NOTICES.txt\" <<'EOF'\n126-================================================================================\n127-Nexus Code Third-Party Software Notices and Licenses\n128-================================================================================\n129-\n130-This package contains third-party software components licensed under open-source\n131-licenses. The following sections provide notices and license texts for all\n132-runtime and statically-linked dependencies included in this distribution.\n--\n157-    esac\n158-    export NODE_EXTRA_CA_CERTS=\"$_ca\"\n159-  fi\n160-  unset _ca\n161-fi\n162-exec node \"$NEXUS_HOME/lib/cli/dist/index.js\" \"$@\"\n163-EOF\n164-chmod 0755 \"$PKG/bin/nexus\" \"$PKG/lib/core/harness-core\" \"$PKG/lib/core/nexus-tui\"\n165:(cd \"$PKG\" && find . -type f ! -name MANIFEST.sha256 | LC_ALL=C sort | xargs sha256sum > MANIFEST.sha256)\n166:tar --sort=name --format=pax --mtime=\"@$SOURCE_DATE_EPOCH\" --owner=0 --group=0 --numeric-owner \\\n167:  --pax-option=delete=atime,delete=ctime -C \"$WORK\" -cf - nexus | gzip -n > \"$OUT/$ARCHIVE\"\n168-\n169:# The detached metadata repeats only the authenticated in-archive contract and\n170:# adds the digest of the exact archive. The release checksum index covers both.\n171-ARCHIVE_SHA=$(sha256sum \"$OUT/$ARCHIVE\" | awk '{print $1}')\n172-node - \"$PKG/compatibility.json\" \"$OUT/compatibility.json\" \"$ARCHIVE\" \"$ARCHIVE_SHA\" <<'NODE'\n173-const fs = require(\"node:fs\");\n174:const [source, destination, archive, sha256] = process.argv.slice(2);\n175-const metadata = JSON.parse(fs.readFileSync(source, \"utf8\"));\n176-metadata.platforms[\"linux-x86_64\"].sha256 = sha256;\n177:if (metadata.platforms[\"linux-x86_64\"].archive !== archive) throw new Error(\"compatibility archive name mismatch\");\n178-fs.writeFileSync(destination, `${JSON.stringify(metadata, null, 2)}\\n`);\n179-NODE\n180-(cd \"$OUT\" && sha256sum \"$ARCHIVE\" compatibility.json > SHA256SUMS)\n181-\n182-# Generate lockfile-derived merged CycloneDX SBOM (REQ-REL-108, ACC-SUP-02)\n183-\"$ROOT/scripts/generate_sbom.sh\" \"$OUT/sbom.cdx.json\"\n184-\n185-# Publish install.sh as release asset (REQ-REL-109)\n","exit_code":0,"duration":{"secs":0,"nanos":36515}},"started_at_ms":1792849496416,"completed_at_ms":1792849496417}}
