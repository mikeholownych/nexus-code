{"timestamp":"2026-10-24T13:38:40.706Z","ordinal":290651,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16e19-0589-7f73-b64e-a1d03ef4175b","item":{"type":"CommandExecution","id":"exec-5d40348d-d3db-4abd-9012-186fe94436e4","process_id":"87113","command":["/usr/bin/zsh","-lc","git fetch origin main --prune && git rev-parse origin/main && git log -1 --format='%H%n%ci%n%s' origin/main && git show origin/main:cli/src/workspace_trust.ts | sed -n '1,220p' && git show origin/main:cli/test/workspace_trust.test.ts | sed -n '1,260p' && git log --oneline --all --decorate --grep='trust' -25"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git fetch origin main --prune && git rev-parse origin/main && git log -1 --format='%H%n%ci%n%s' origin/main && git show origin/main:cli/src/workspace_trust.ts | sed -n '1,220p' && git show origin/main:cli/test/workspace_trust.test.ts | sed -n '1,260p' && git log --oneline --all --decorate --grep='trust' -25"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"From https://github.com/mikeholownych/nexus-code\n * branch            main       -> FETCH_HEAD\nbe2cd2f255414f554572c86baa884d9271ff5ea1\nbe2cd2f255414f554572c86baa884d9271ff5ea1\n2026-10-24 09:29:15 -0400\nMerge pull request #193 from mikeholownych/v1/defect-mcp-config-persist\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\n\n/** Workspace files that configure MCP servers, and directories plugins are loaded from: used only when trusted. */\nexport const WORKSPACE_MCP_FILES = [\".mcp.json\", \"mcp.json\"];\nexport const WORKSPACE_PLUGIN_DIRS = [path.join(\".nexus\", \"plugins\"), \"plugins\"];\n\n/**\n * The workspace's own MCP configuration files and plugin modules that exist but are not loaded because the workspace\n * is not trusted (or the session is read-only). Empty when there are none or the workspace is trusted.\n */\nexport function untrustedWorkspaceExtensions(workspace: string, readOnly = false): string[] {\n  if (isWorkspaceTrusted(workspace, readOnly)) return [];\n  const root = path.resolve(workspace);\n  const found = WORKSPACE_MCP_FILES.map((f) => path.join(root, f)).filter((f) => fs.existsSync(f));\n  for (const dir of WORKSPACE_PLUGIN_DIRS) {\n    try {\n      for (const name of fs.readdirSync(path.join(root, dir))) {\n        if (name.endsWith(\".js\") || name.endsWith(\".mjs\")) found.push(path.join(root, dir, name));\n      }\n    } catch {}\n  }\n  return found;\n}\n\nexport function getTrustStorePath(): string {\n  return path.join(os.homedir(), \".config\", \"nexus\", \"trusted_workspaces.json\");\n}\n\n/**\n * Check if the given workspace is explicitly trusted by the operator.\n * In --read-only mode, workspace trust never authorizes executing project plugins/MCP.\n */\nexport function isWorkspaceTrusted(workspace: string, readOnly = false): boolean {\n  if (readOnly) return false;\n  if (process.env.NEXUS_TRUST_WORKSPACE === \"1\") return true;\n\n  try {\n    const resolved = path.resolve(workspace);\n    const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\n    const storePath = getTrustStorePath();\n    if (!fs.existsSync(storePath)) return false;\n    const content = JSON.parse(fs.readFileSync(storePath, \"utf8\"));\n    if (Array.isArray(content)) {\n      return content.includes(realWs);\n    }\n    if (content && typeof content === \"object\" && Array.isArray(content.trustedPaths)) {\n      return content.trustedPaths.includes(realWs);\n    }\n  } catch {}\n  return false;\n}\n\n/** The trusted workspaces (real paths), as recorded in the trust store. */\nexport function listTrustedWorkspaces(): string[] {\n  try {\n    const raw = JSON.parse(fs.readFileSync(getTrustStorePath(), \"utf8\"));\n    const list = Array.isArray(raw) ? raw : Array.isArray(raw?.trustedPaths) ? raw.trustedPaths : [];\n    return list.filter((p: unknown): p is string => typeof p === \"string\");\n  } catch {\n    return [];\n  }\n}\n\n/** Records (or removes) the operator's trust in a workspace. Returns its real path; throws when the store cannot be written. */\nexport function setWorkspaceTrusted(workspace: string, trusted: boolean): string {\n  const resolved = path.resolve(workspace);\n  const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\n  const storePath = getTrustStorePath();\n  fs.mkdirSync(path.dirname(storePath), { recursive: true, mode: 0o700 });\n  const list = listTrustedWorkspaces().filter((p) => p !== realWs);\n  if (trusted) list.push(realWs);\n  const temp = `${storePath}.${process.pid}.tmp`;\n  fs.writeFileSync(temp, JSON.stringify({ trustedPaths: list }, null, 2), { mode: 0o600 });\n  fs.renameSync(temp, storePath);\n  return realWs;\n}\n/**\n * A workspace's own MCP configuration and plugins run code from the workspace: they are loaded only when the\n * operator trusts it (`nexus trust`), never in read-only mode, and the agent's file tools cannot trust it for itself.\n */\n\nimport { describe, test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { isWorkspaceTrusted, listTrustedWorkspaces, setWorkspaceTrusted, untrustedWorkspaceExtensions } from \"../src/workspace_trust.js\";\nimport { PluginManager } from \"../src/plugins.js\";\nimport { mcpConfigFiles } from \"../src/mcp.js\";\nimport { SecurityManager } from \"../src/security.js\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { KnowledgeGraph } from \"../src/knowledge.js\";\nimport { SkillManager } from \"../src/skills.js\";\nimport { startGateway } from \"./helpers/fixtures.js\";\n\nasync function withHome(run: (home: string, ws: string) => Promise<void>): Promise<void> {\n  const home = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-home-\"));\n  const ws = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-ws-\"));\n  const saved = { HOME: process.env.HOME, TRUST: process.env.NEXUS_TRUST_WORKSPACE, AUTO: process.env.NEXUS_KNOWLEDGE_AUTOEXTRACT };\n  process.env.HOME = home;\n  delete process.env.NEXUS_TRUST_WORKSPACE;\n  delete process.env.NEXUS_KNOWLEDGE_AUTOEXTRACT;\n  try {\n    await run(home, ws);\n  } finally {\n    process.env.HOME = saved.HOME;\n    if (saved.TRUST === undefined) delete process.env.NEXUS_TRUST_WORKSPACE;\n    else process.env.NEXUS_TRUST_WORKSPACE = saved.TRUST;\n    if (saved.AUTO === undefined) delete process.env.NEXUS_KNOWLEDGE_AUTOEXTRACT;\n    else process.env.NEXUS_KNOWLEDGE_AUTOEXTRACT = saved.AUTO;\n    fs.rmSync(home, { recursive: true, force: true });\n    fs.rmSync(ws, { recursive: true, force: true });\n  }\n}\n\ndescribe(\"workspace trust\", () => {\n  test(\"workspace plugins load only when the workspace is trusted, and never in read-only mode\", async () => {\n    await withHome(async (_home, ws) => {\n      fs.mkdirSync(path.join(ws, \".nexus\", \"plugins\"), { recursive: true });\n      fs.writeFileSync(path.join(ws, \".nexus\", \"plugins\", \"p.mjs\"), `export default { name: \"ws-plugin\", description: \"d\" };`);\n      fs.writeFileSync(path.join(ws, \".mcp.json\"), \"{}\");\n\n      assert.equal(isWorkspaceTrusted(ws), false);\n      assert.deepEqual(untrustedWorkspaceExtensions(ws).map((f) => path.basename(f)).sort(), [\".mcp.json\", \"p.mjs\"]);\n      assert.ok(!mcpConfigFiles(ws, isWorkspaceTrusted(ws)).includes(path.join(ws, \".mcp.json\")));\n      const untrusted = new PluginManager(ws);\n      await untrusted.loadPlugins();\n      assert.ok(!untrusted.listPlugins().some((p) => p.name === \"ws-plugin\"), \"not loaded while untrusted\");\n\n      const real = setWorkspaceTrusted(ws, true);\n      assert.deepEqual(listTrustedWorkspaces(), [real]);\n      assert.equal(isWorkspaceTrusted(ws), true);\n      assert.deepEqual(untrustedWorkspaceExtensions(ws), []);\n      const trusted = new PluginManager(ws);\n      await trusted.loadPlugins();\n      assert.ok(trusted.listPlugins().some((p) => p.name === \"ws-plugin\"), \"loaded once trusted\");\n\n      const readOnly = new PluginManager(ws, { readOnly: true });\n      await readOnly.loadPlugins();\n      assert.ok(!readOnly.listPlugins().some((p) => p.name === \"ws-plugin\"), \"never loaded in read-only mode\");\n      assert.equal(untrustedWorkspaceExtensions(ws, true).length, 2, \"read-only reports them as not loaded\");\n\n      setWorkspaceTrusted(ws, false);\n      assert.equal(isWorkspaceTrusted(ws), false);\n      assert.deepEqual(listTrustedWorkspaces(), []);\n    });\n  });\n\n  test(\"the trust store is a protected path for the agent's file tools\", async () => {\n    await withHome(async (home, ws) => {\n      const store = path.join(home, \".config\", \"nexus\", \"trusted_workspaces.json\");\n      assert.equal(new SecurityManager(ws).isPathProtected(store).protected, true);\n    });\n  });\n\n  test(\"ACC-TRUST-04: workspace skills and knowledge load only when workspace is trusted, with source annotations\", async () => {\n    await withHome(async (_home, ws) => {\n      // Create skills/x/SKILL.md\n      fs.mkdirSync(path.join(ws, \"skills\", \"x\"), { recursive: true });\n      fs.writeFileSync(\n        path.join(ws, \"skills\", \"x\", \"SKILL.md\"),\n        `---\nname: skill-x\ndescription: Specialized skill X for testing\n---\nInstructions for skill-x`\n      );\n\n      // Create .nexus/knowledge.json\n      fs.mkdirSync(path.join(ws, \".nexus\"), { recursive: true });\n      fs.writeFileSync(\n        path.join(ws, \".nexus\", \"knowledge.json\"),\n        JSON.stringify({\n          version: 1,\n          updatedAt: \"2026-10-15T00:00:00.000Z\",\n          entries: [\n            {\n              id: \"k1\",\n              key: \"rule-always-lint\",\n              value: \"Always run linting before commit\",\n              category: \"rule\",\n              confidence: 1.0,\n              source: \"manual\",\n              createdAt: \"2026-10-15T00:00:00.000Z\",\n              updatedAt: \"2026-10-15T00:00:00.000Z\",\n            },\n          ],\n        })\n      );\n\n      assert.equal(isWorkspaceTrusted(ws), false, \"workspace starts untrusted\");\n\n      // 1. In untrusted workspace:\n      const skillMgr = new SkillManager(ws);\n      assert.deepEqual(skillMgr.listSkills(), [], \"no trusted skills in untrusted workspace\");\n      assert.equal(skillMgr.listUntrustedSkills().length, 1);\n      assert.equal(skillMgr.listUntrustedSkills()[0].name, \"skill-x\");\n      assert.ok(!skillMgr.getPromptSection().includes(\"skill-x\"));\n\n      const knowledgeGraph = new KnowledgeGraph(ws);\n      assert.equal(knowledgeGraph.exportPromptSection(), \"\", \"knowledge returns empty prompt section when untrusted\");\n\n      // Test with mock gateway: system prompt sent to model has neither\n      let requestsSeen: any[] = [];\n      const gw = await startGateway((_n) => ({ kind: \"text\", content: \"I am ready.\" }));\n      let agentUntrusted: AutonomousAgent | undefined;\n      try {\n        agentUntrusted = new AutonomousAgent({\n          endpoint: gw.url,\n          model: \"m\",\n          maxSteps: 1,\n          temperature: 0,\n          workspace: ws,\n          shell: \"bash\",\n        } as any);\n\n        await agentUntrusted.runTurn(\"inspect\");\n        requestsSeen = gw.requests as any[];\n        assert.ok(requestsSeen.length >= 1, \"gateway received request\");\n        const sysPromptUntrusted = requestsSeen[0].messages[0].content as string;\n        assert.ok(!sysPromptUntrusted.includes(\"skill-x\"), \"untrusted skill-x not in system prompt\");\n        assert.ok(!sysPromptUntrusted.includes(\"rule-always-lint\"), \"untrusted knowledge not in system prompt\");\n\n        // activate_skill is refused with hint\n        const activateRes = await (agentUntrusted as any).dispatchToolCall(\n          { id: \"call_1\", function: { name: \"activate_skill\", arguments: JSON.stringify({ name: \"skill-x\" }) } },\n          1\n        );\n        assert.equal(activateRes.receipt.success, false);\n        assert.ok(activateRes.receipt.error.includes(\"untrusted workspace\"));\n        assert.ok(activateRes.receipt.error.includes(\"nexus trust .\"));\n      } catch (err) {\n        console.error(\"ACC-TRUST-04 untrusted phase failed:\", err);\n        throw err;\n      } finally {\n        agentUntrusted?.shutdown();\n        await gw.close();\n      }\n\n      // 2. Trust the workspace: nexus trust .\n      setWorkspaceTrusted(ws, true);\n      assert.equal(isWorkspaceTrusted(ws), true);\n\n      // Now both appear, with source annotations\n      const gw2 = await startGateway((_n) => ({ kind: \"text\", content: \"Trusted turn complete.\" }));\n      let agentTrusted: AutonomousAgent | undefined;\n      try {\n        agentTrusted = new AutonomousAgent({\n          endpoint: gw2.url,\n          model: \"m\",\n          maxSteps: 1,\n          temperature: 0,\n          workspace: ws,\n          shell: \"bash\",\n        } as any);\n\n        await agentTrusted.runTurn(\"inspect trusted\");\n        const reqs2 = gw2.requests as any[];\n        assert.ok(reqs2.length >= 1);\n        const sysPromptTrusted = reqs2[0].messages[0].content as string;\n        assert.ok(sysPromptTrusted.includes(\"skill-x\"), \"trusted skill-x is in system prompt\");\n        assert.ok(sysPromptTrusted.includes(\"rule-always-lint\"), \"trusted knowledge is in system prompt\");\n\n        // Verify source annotations\n        const skillPath = path.join(ws, \"skills\", \"x\", \"SKILL.md\");\n        const knowledgePath = path.join(ws, \".nexus\", \"knowledge.json\");\n        assert.ok(\n          sysPromptTrusted.includes(`[source: ${skillPath}] [trust: trusted]`),\n          \"skill has source and trust annotation\"\n        );\n        assert.ok(\n          sysPromptTrusted.includes(`[source: ${knowledgePath}] [trust: trusted]`),\n          \"knowledge has source and trust annotation\"\n        );\n\n        // activate_skill succeeds with source annotation\n        const activateRes2 = await (agentTrusted as any).dispatchToolCall(\n          { id: \"call_2\", function: { name: \"activate_skill\", arguments: JSON.stringify({ name: \"skill-x\" }) } },\n          1\n        );\n        assert.equal(activateRes2.receipt.success, true);\n        assert.ok(activateRes2.receipt.output.includes(`[source: ${skillPath}] [trust: trusted]`));\n        assert.ok(activateRes2.receipt.output.includes(\"Instructions for skill-x\"));\n      } catch (err) {\n        console.error(\"ACC-TRUST-04 trusted phase failed:\", err);\n        throw err;\n      } finally {\n        agentTrusted?.shutdown();\n        await gw2.close();\n      }\n    });\n  });\n\n  test(\"ACC-TRUST-05: no implicit standing rules (autoExtract opt-in) and read-only mode creates no .nexus/\", async () => {\n    await withHome(async (_home, ws) => {\n      setWorkspaceTrusted(ws, true);\n      fs.mkdirSync(path.join(ws, \".nexus\"), { recursive: true });\n      const initialKnowledge = {\n        version: 1,\n        updatedAt: \"2026-10-15T00:00:00.000Z\",\n        entries: [\n          {\n            id: \"k0\",\n            key: \"rule-initial\",\n            value: \"Initial rule\",\n            category: \"rule\",\n            confidence: 1.0,\n            source: \"manual\",\n            createdAt: \"2026-10-15T00:00:00.000Z\",\n            updatedAt: \"2026-10-15T00:00:00.000Z\",\n          },\n        ],\n      };\n      const dbPath = path.join(ws, \".nexus\", \"knowledge.json\");\n      fs.writeFileSync(dbPath, JSON.stringify(initialKnowledge, null, 2));\n      const beforeContent = fs.readFileSync(dbPath, \"utf-8\");\n\n      // 1. Default config: NEXUS_KNOWLEDGE_AUTOEXTRACT is unset\n      delete process.env.NEXUS_KNOWLEDGE_AUTOEXTRACT;\n      const gw = await startGateway((_n) => ({ kind: \"text\", content: \"Acknowledged.\" }));\n      let agent: AutonomousAgent | undefined;\n      try {\n        agent = new AutonomousAgent({\n          endpoint: gw.url,\n          model: \"m\",\n          maxSteps: 1,\n          temperature: 0,\n          workspace: ws,\n          shell: \"bash\",\n        } as any);\n\n        await agent.runTurn(\"never run the tests\");\n      } finally {\n        agent?.shutdown();\n        await gw.close();\n      }\n2815c3c fix(security): classify NAT64 embedded IPv4 in SSRF guard\n57b9285 (tag: v1.0.0-rc.4) Merge pull request #190 from mikeholownych/v1/rc4-notes-startup-trust\n8570a6e docs(release): note startup workspace trust chooser\na2f2fba Merge pull request #186 from mikeholownych/v1/startup-workspace-trust\nda64255 (origin/v1/startup-workspace-trust, v1/startup-workspace-trust) test(release): trust workspace in package smoke PTY\n5139429 test(cli): trust workspace in turn semantics PTYs\n89bfd48 test(cli): trust workspace in harness routing fixtures\n5fb55c7 fix(cli): stop stdin after exiting trust prompt\n83014ae test(cli): trust workspace in startup PTY tests\n127c5b8 feat(cli): ask before trusting workspace on startup\n89fff0f test(cli): trust workspace in startup PTY tests\nf75f364 Merge remote-tracking branch 'origin/main' into v1/startup-workspace-trust\nb14b314 (v1/startup-workspace-trust-rebased) test(cli): trust workspace in startup PTY tests\n6b0ee50 feat(cli): ask before trusting workspace on startup\nf7cf9bb feat(cli): ask before trusting workspace on startup\ne7af4e7 fix(retention): confine checkpoint snapshot deletion\nd92f38b Merge pull request #175 from mikeholownych/v1/defect-html-control-injection\nfa7785e fix(security): strip terminal controls from untrusted HTML text\n8a90c35 Merge pull request #62 from mikeholownych/v1/sec-html-tag-filter\n4758eb5 fix(web): extract untrusted HTML text with a single-pass scanner\n0e2e1b0 qual(terminal): exact RC package identity, positive-control measurements, fail-closed gate\n33bbac0 feat(tui): approval panel arrow alignment, narrow terminal hints, and safe execution documentation (PLAN-01 PR-1f)\n3d76846 merge v1/plan-03-pr-3f (docs: egress boundaries, locality, trust model, and migration guide)\n499e563 docs: document egress boundaries, locality, trust model, and migration guide (PLAN-03 PR-3f)\nf6957db (v1/plan-03-pr-3d) feat(security): trust-gate workspace skills & knowledge, source annotations, opt-in autoextract (REQ-SEC-113, REQ-SEC-114)\n","exit_code":0,"duration":{"secs":0,"nanos":491675153}},"started_at_ms":1792849120214,"completed_at_ms":1792849120706}}
{"timestamp":"2026-10-24T13:38:41.673Z","ordinal":290652,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a16e22-9188-7823-b362-8e606622a632","call_id":"call_c962d266b1fb49aab7e331ca768ed90c","output":[{"type":"input_text","text":"Script completed\nWall time 2.6 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 12634)\nTotal output lines: 6\n\nRESULT 1:\n{\"chunk_id\":\"0ff2b9\",\"wall_time_seconds\":0.492283243,\"exit_code\":0,\"original_token_count\":4183,\"output\":\"From https://github.com/mikeholownych/nexus-code\\n * branch            main       -> FETCH_HEAD\\nbe2cd2f255414f554572c86baa884d9271ff5ea1\\nbe2cd2f255414f554572c86baa884d9271ff5ea1\\n2026-10-24 09:29:15 -0400\\nMerge pull request #193 from mikeholownych/v1/defect-mcp-config-persist\\nimport * as fs from \\\"node:fs\\\";\\nimport * as path from \\\"node:path\\\";\\nimport * as os from \\\"node:os\\\";\\n\\n/** Workspace files that configure MCP servers, and directories plugins are loaded from: used only when trusted. */\\nexport const WORKSPACE_MCP_FILES = [\\\".mcp.json\\\", \\\"mcp.json\\\"];\\nexport const WORKSPACE_PLUGIN_DIRS = [path.join(\\\".nexus\\\", \\\"plugins\\\"), \\\"plugins\\\"];\\n\\n/**\\n * The workspace's own MCP configuration files and plugin modules that exist but are not loaded because the workspace\\n * is not trusted (or the session is read-only). Empty when there are none or the workspace is trusted.\\n */\\nexport function untrustedWorkspaceExtensions(workspace: string, readOnly = false): string[] {\\n  if (isWorkspaceTrusted(workspace, readOnly)) return [];\\n  const root = path.resolve(workspace);\\n  const found = WORKSPACE_MCP_FILES.map((f) => path.join(root, f)).filter((f) => fs.existsSync(f));\\n  for (const dir of WORKSPACE_PLUGIN_DIRS) {\\n    try {\\n      for (const name of fs.readdirSync(path.join(root, dir))) {\\n        if (name.endsWith(\\\".js\\\") || name.endsWith(\\\".mjs\\\")) found.push(path.join(root, dir, name));\\n      }\\n    } catch {}\\n  }\\n  return found;\\n}\\n\\nexport function getTrustStorePath(): string {\\n  return path.join(os.homedir(), \\\".config\\\", \\\"nexus\\\", \\\"trusted_workspaces.json\\\");\\n}\\n\\n/**\\n * Check if the given workspace is explicitly trusted by the operator.\\n * In --read-only mode, workspace trust never authorizes executing project plugins/MCP.\\n */\\nexport function isWorkspaceTrusted(workspace: string, readOnly = false): boolean {\\n  if (readOnly) return false;\\n  if (process.env.NEXUS_TRUST_WORKSPACE === \\\"1\\\") return true;\\n\\n  try {\\n    const resolved = path.resolve(workspace);\\n    const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\\n    const storePath = getTrustStorePath();\\n    if (!fs.existsSync(storePath)) return false;\\n    const content = JSON.parse(fs.readFileSync(storePath, \\\"utf8\\\"));\\n    if (Array.isArray(content)) {\\n      return content.includes(realWs);\\n    }\\n    if (content && typeof content === \\\"object\\\" && Array.isArray(content.trustedPaths)) {\\n      return content.trustedPaths.includes(realWs);\\n    }\\n  } catch {}\\n  return false;\\n}\\n\\n/** The trusted workspaces (real paths), as recorded in the trust store. */\\nexport function listTrustedWorkspaces(): string[] {\\n  try {\\n    const raw = JSON.parse(fs.readFileSync(getTrustStorePath(), \\\"utf8\\\"));\\n    const list = Array.isArray(raw) ? raw : Array.isArray(raw?.trustedPaths) ? raw.trustedPaths : [];\\n    return list.filter((p: unknown): p is string => typeof p === \\\"string\\\");\\n  } catch {\\n    return [];\\n  }\\n}\\n\\n/** Records (or removes) the operator's trust in a workspace. Returns its real path; throws when the store cannot be written. */\\nexport function setWorkspaceTrusted(workspace: string, trusted: boolean): string {\\n  const resolved = path.resolve(workspace);\\n  const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\\n  const storePath = getTrustStorePath();\\n  fs.mkdirSync(path.dirname(storePath), { recursive: true, mode: 0o700 });\\n  const list = listTrustedWorkspaces().filter((p) => p !== realWs);\\n  if (trusted) list.push(realWs);\\n  const temp = `${storePath}.${process.pid}.tmp`;\\n  fs.writeFileSync(temp, JSON.stringify({ trustedPaths: list }, null, 2), { mode: 0o600 });\\n  fs.renameSync(temp, storePath);\\n  return realWs;\\n}\\n/**\\n * A workspace's own MCP configuration and plugins run code from the workspace: they are loaded only when the\\n * operator trusts it (`nexus trust`), never in read-only mode, and the agent's file tools cannot trust it for itself.\\n */\\n\\nimport { describe, test } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport fs from \\\"node:fs\\\";\\nimport os from \\\"node:os\\\";\\nimport path from \\\"node:path\\\";\\nimport { isWorkspaceTrusted, listTrustedWorkspaces, setWorkspaceTrusted, untrustedWorkspaceExtensions } from \\\"../src/workspace_trust.js\\\";\\nimport { PluginManager } from \\\"../src/plugins.js\\\";\\nimport { mcpConfigFiles } from \\\"../src/mcp.js\\\";\\nimport { SecurityManager } from \\\"../src/security.js\\\";\\nimport { AutonomousAgent } from \\\"../src/agent.js\\\";\\nimport { KnowledgeGraph } from \\\"../src/knowledge.js\\\";\\nimport { SkillManager } from \\\"../src/skills.js\\\";\\nimport { startGateway } from \\\"./helpers/fixtures.js\\\";\\n\\nasync function withHome(run: (home: string, ws: string) => Promise<void>): Promise<void> {\\n  const home = fs.mkdtempSync(path.join(os.tmpdir(), \\\"nexus-trust-home-\\\"));\\n  const ws = fs.mkdtempSync(path.join(os.tmpdir(), \\\"nexus-trust-ws-\\\"));\\n  const saved = { HOME: process.env.HOME, TRUST: process.env.NEXUS_TRUST_WORKSPACE, AUTO: process.env.NEXUS_KNOWLEDGE_AUTOEXTRACT };\\n  process.env.HOME = home;\\n  delete process.env.NEXUS_TRUST_WORKSPACE;\\n  delete process.env.NEXUS_KNOWLEDGE_AUTOEXTRACT;\\n  try {\\n    await run(home, ws);\\n  } finally {\\n    process.env.HOME = saved.HOME;\\n    if (saved.TRUST === undefined) delete process.env.NEXUS_TRUST_WORKSPACE;\\n    else process.env.NEXUS_TRUST_WORKSPACE = saved.TRUST;\\n    if (saved.AUTO === undefined) delete process.env.NEXUS_KNOWLEDGE_AUTOEXTRACT;\\n    else process.env.NEXUS_KNOWLEDGE_AUTOEXTRACT = saved.AUTO;\\n    fs.rmSync(home, { recursive: true, force: true });\\n    fs.rmSync(ws, { recursive: true, force: true });\\n  }\\n}\\n\\ndescribe(\\\"workspace trust\\\", () => {\\n  test(\\\"workspace plugins load only when the workspace is trusted, and never in read-only mode\\\", async () => {\\n    await withHome(async (_home, ws) => {\\n      fs.mkdirSync(path.join(ws, \\\".nexus\\\", \\\"plugins\\\"), { recursive: true });\\n      fs.writeFileSync(path.join(ws, \\\".nexus\\\", \\\"plugins\\\", \\\"p.mjs\\\"), `export default { name: \\\"ws-plugin\\\", description: \\\"d\\\" };`);\\n      fs.writeFileSync(path.join(ws, \\\".mcp.json\\\"), \\\"{}\\\");\\n\\n      assert.equal(isWorkspaceTrusted(ws), false);\\n      assert.deepEqual(untrustedWorkspaceExtensions(ws).map((f) => path.basename(f)).sort(), [\\\".mcp.json\\\", \\\"p.mjs\\\"]);\\n      assert.ok(!mcpConfigFiles(ws, isWorkspaceTrusted(ws)).includes(path.join(ws, \\\".mcp.json\\\")));\\n      const untrusted = new PluginManager(ws);\\n      await untrusted.loadPlugins();\\n      assert.ok(!untrusted.listPlugins().some((p) => p.name === \\\"ws-plugin\\\"), \\\"not loaded while untrusted\\\");\\n\\n      const real = setWorkspaceTrusted(ws, true);\\n      assert.deepEqual(listTrustedWorkspaces(), [real]);\\n      assert.equal(isWorkspaceTrusted(ws), true);\\n      assert.deepEqual(untrustedWorkspaceExtensions(ws), []);\\n      const trusted = new PluginManager(ws);\\n      await trusted.loadPlugins();\\n      assert.ok(trusted.listPlugins().some((p) => p.name === \\\"ws-plugin\\\"), \\\"loaded once trusted\\\");\\n\\n      const readOnly = new PluginManager(ws, { readOnly: true });\\n      await readOnly.loadPlugins();\\n      assert.ok(!readOnly.listPlugins().some((p) => p.name === \\\"ws-plugin\\\"), \\\"never loaded in read-only mode\\\");\\n      assert.equal(untrustedWorkspaceExtensions(ws, true).length, 2, \\\"read-only reports them as not loaded\\\");\\n\\n      setWorkspaceTrusted(ws, false);\\n      assert.equal(isWorkspaceTrusted(ws), false);\\n      assert.deepEqual(listTrustedWorkspaces(), []);\\n    });\\n  });\\n\\n  test(\\\"the trust store is a protected path for the agent's file tools\\\", async () => {\\n    await withHome(async (home, ws) => {\\n      const store = path.join(home, \\\".config\\\", \\\"nexus\\\", \\\"trusted_workspaces.json\\\");\\n      assert.equal(new SecurityManager(ws).isPathProtected(store).protected, true);\\n    });\\n  });\\n\\n  test(\\\"ACC-TRUST-04: workspace skills and knowledge load only when workspace is trusted, with source annotations\\\", async () => {\\n    await withHome(async (_home, ws) => {\\n      // Create skills/x/SKILL.md\\n      fs.mkdirSync(path.join(ws, \\\"skills\\\", \\\"x\\\"), { recursive: true });\\n      fs.writeFileSync(\\n        path.join(ws, \\\"skills\\\", \\\"x\\\", \\\"SKILL.md\\\"),\\n        `---\\nname: skill-x\\ndescription: Specialized skill X for testing\\n---\\nInstructions for skill-x`\\n      );\\n\\n      // Create .nexus/knowledge.json\\n      fs.mkdirSync(path.join(ws, \\\".nexus\\\"), { recursive: true });\\n      fs.writeFileSync(\\n        path.join(ws, \\\".nexus\\\", \\\"knowledge.json\\\"),\\n        JSON.stringify({\\n          version: 1,\\n          updatedAt: \\\"2026-10-15T00:00:00.000Z\\\",\\n          entries: [\\n            {\\n              id: \\\"k1\\\",\\n              key: \\\"rule-always-lint\\\",\\n              value: \\\"Always run linting before commit\\\",\\n              category: \\\"rule\\\",\\n              confidence: 1.0,\\n              source: \\\"manual\\\",\\n              createdAt: \\\"2026-10-15T00:00:00.000Z\\\",\\n              updatedAt: \\\"2026-10-15T00:00:00.000Z\\\",\\n            },\\n          ],\\n        })\\n      );\\n\\n      assert.equal(isWorkspaceTrusted(ws), false, \\\"workspace starts untrusted\\\");\\n\\n      // 1. In untrusted workspace:\\n      const skillMgr = new SkillManager(ws);\\n      assert.deepEqual(skillMgr.listSkills(), [], \\\"no trusted skills in untrusted workspace\\\");\\n      assert.equal(skillMgr.listUntrustedSkills().length, 1);\\n      assert.equal(skillMgr.listUntrustedSkills()[0].name, \\\"skill-x\\\");\\n      assert.ok(!skillMgr.getPromptSection().includes(\\\"skill-x\\\"));\\n\\n      const knowledgeGraph = new KnowledgeGraph(ws);\\n      assert.equal(knowledgeGraph.exportPromptSection(), \\\"\\\", \\\"knowledge returns empty prompt section when untrusted\\\");\\n\\n      // Test with mock gateway: system prompt sent to model has neither\\n      let requestsSeen: any[] = [];\\n      const gw = await startGateway((_n) => ({ kind: \\\"text\\\", content: \\\"I am ready.\\\" }));\\n      let agentUntrusted: AutonomousAgent | undefined;\\n      try {\\n        agentUntrusted = new AutonomousAgent({\\n          endpoint: gw.url,\\n          model: \\\"m\\\",\\n          maxSteps: 1,\\n          temperature: 0,\\n          workspace: ws,\\n          shell: \\\"bash\\\",\\n        } as any);\\n\\n        await agentUntrusted.runTurn(\\\"inspect\\\");\\n        requestsSeen = gw.requests as any[];\\n        assert.ok(requestsSeen.length >= 1, \\\"gateway received request\\\");\\n        const sysPromptUntrusted = requestsSeen[0].messages[0].content as string;\\n        assert.ok(!sysPromptUntrusted.includes(\\\"skill-x\\\"), \\\"untrusted skill-x not in system prompt\\\");\\n        assert.ok(!sysPromptUntrusted.includes(\\\"rule-always-lint\\\"), \\\"untrusted knowledge not in system prompt\\\");\\n\\n        // activate_skill is refused with hint\\n        const activateRes = await (agentUntrusted as any).dispatchToolCall(\\n          { id: \\\"call_1\\\", function: { name: \\\"activate_skill\\\", arguments: JSON.stringify({ name: \\\"skill-x\\\" }) } },\\n          1\\n        );\\n        assert.equal(activateRes.receipt.success, false);\\n        assert.ok(activateRes.receipt.error.includes(\\\"untrusted workspace\\\"));\\n        assert.ok(activateRes.receipt.error.includes(\\\"nexus trust .\\\"));\\n      } catch (err) {\\n        console.error(\\\"ACC-TRUST-04 untrusted phase failed:\\\", err);\\n        throw err;\\n      } finally {\\n        agentUntrusted?.shutdown();\\n        await gw.close();\\n      }\\n\\n      // 2. Trust the workspace: nexus trust .\\n      setWorkspaceTrusted(ws, true);\\n      assert.equal(isWorkspaceTrusted(ws), true);\\n\\n      // Now both appear, with source annotations\\n      const gw2 = await startGateway((_n) => ({ kind: \\\"text\\\", content: \\\"Trusted turn complete.\\\" }));\\n      let agentTrusted: AutonomousAgent | undefined;\\n      try {\\n        agentTrusted = new AutonomousAgent({\\n          endpoint: gw2.url,\\n          model: \\\"m\\\",\\n          maxSteps: 1,\\n          temperature: 0,\\n          workspace: ws,\\n          shell: \\\"bash\\\",\\n        } as any);\\n\\n        await agentTrusted.runTurn(\\\"inspect trusted\\\");\\n        const reqs2 = gw2.requests as any[];\\n        assert.ok(reqs2.length >= 1);\\n        const sysPromptTrusted = reqs2[0].messages[0].content as string;\\n        assert.ok(sysPromptTrusted.includes(\\\"skill-x\\\"), \\\"trusted skill-x is in system prompt\\\");\\n        assert.ok(sysPromptTrusted.includes(\\\"rule-always-lint\\\"), \\\"trusted knowledge is in system prompt\\\");\\n\\n        // Verify source annotations\\n        const skillPath = path.join(ws, \\\"skills\\\", \\\"x\\\", \\\"SKILL.md\\\");\\n        const knowledgePath = path.join(ws, \\\".nexus\\\", \\\"knowledge.json\\\");\\n        assert.ok(\\n          sysPromptTrusted.includes(`[source: ${skillPath}] [trust: trusted]`),\\n          \\\"skill has source and trust annotation\\\"\\n        );\\n        assert.ok(\\n          sysPromptTrusted.includes(`[source: ${knowledgePath}] [trust: trusted]`),\\n          \\\"knowledge has source and trust annotation\\\"\\n        );\\n\\n        // activate_skill succeeds with source annotation\\n        const activateRes2 = await (agentTrusted as any).dispatchToolCall(\\n          { id: \\\"call_2\\\", function: { name: \\\"activate_skill\\\", arguments: JSON.stringify({ name: \\\"skill-x\\\" }) } },\\n          1\\n        );\\n        assert.equal(activateRes2.receipt.success, true);\\n        assert.ok(activateRes2.receipt.output.includes(`[source: ${skillPath}] [trust: trusted]`));\\n        assert.ok(activateRes2.receipt.output.includes(\\\"Instructions for skill-x\\\"));\\n      } catch (err) {\\n        console.error(\\\"ACC-TRUST-04 trusted phase failed:\\\", err);\\n        throw err;\\n      } finally {\\n        agentTrusted?.shutdown();\\n        await gw2.close();\\n      }\\n    });\\n  });\\n\\n  test(\\\"ACC-TRUST-05: no implicit standing rules (autoExtract opt-in) and read-only mode creates no .nexus/\\\", async () => {\\n    await withHome(async (_home, ws) => {\\n      setWorkspaceTrusted(ws, true);\\n      fs.mkdirSync(path.join(ws, \\\".nexus\\\"), { recursive: true });\\n      const initialKnowledge = {\\n        version: 1,\\n        updatedAt: \\\"2026-10-15T00:00:00.000Z\\\",\\n        entries: [\\n          {\\n            id: \\\"k0\\\",\\n            key: \\\"rule-initial\\\",\\n            value: \\\"Initial rule\\\",\\n            category: \\\"rule\\\",\\n            confidence: 1.0,\\n            source: \\\"manual\\\",\\n            createdAt: \\\"2026-10-15T00:00:00.000Z\\\",\\n            updatedAt: \\\"2026-10-15T00:00:00.000Z\\\",\\n          },\\n        ],\\n      };\\n      const dbPath = path.join(ws, \\\".nexus\\\", \\\"knowledge.json\\\");\\n      fs.writeFileSync(dbPath, JSON.stringify(initialKnowledge, null, 2));\\n      const beforeContent = fs.readFileSync(dbPath, \\\"utf-8\\\");\\n\\n      // 1. Default config: NEXUS_KNOWLEDGE_AUTOEXTRACT is unset\\n      delete process.env.NEXUS_KNOWLEDGE_AUTOEXTRACT;\\n      const gw = await startGateway((_n) => ({ kind: \\\"text\\\", content: \\\"Acknowledged.\\\" }));\\n      let agent: AutonomousAgent | undefined;\\n      try {\\n        agent = new AutonomousAgent({\\n          endpoint: gw.url,\\n          model: \\\"m\\\",\\n          maxSteps: 1,\\n          temperature: 0,\\n          workspace: ws,\\n          shell: \\\"bash\\\",\\n        } as any);\\n\\n        await agent.runTurn(\\\"never run the tests\\\");\\n      } finally {\\n        agent?.shutdown();\\n        await gw.close();\\n      }\\n2815c3c fix(security): classify NAT64 embedded IPv4 in SSRF guard\\n57b9285 (tag: v1.0.0-rc.4) Merge pull request #190 from mikeholownych/v1/rc4-notes-startup-trust\\n8570a6e docs(release): note startup workspace trust chooser\\na2f2fba Merge pull request #186 from mikeholownych/v1/startup-workspace-trust\\nda64255 (origin/v1/startup-workspace-trust, v1/startup-workspace-trust) test(release): trust workspace in package smoke PTY\\n5139429 test(cli): trust workspace in turn semantics PTYs\\n89bfd48 test(cli): trust workspace in harness routing fixtures\\n5fb55c7 fix(cli): stop stdin after exiting trust prompt\\n83014ae test(cli): trust workspace in startup PTY tests\\n127c5b8 feat(cli): ask before trusting workspace on startup\\n89fff0f test(cli): trust workspace in startup PTY tests\\nf75f364 Merge remote-tracking branch 'origin/main' into v1/startup-workspace-trust\\nb14b314 (v1/startup-workspace-trust-rebased) test(cli): trust workspace in startup PTY tests\\n6b0ee50 feat(cli): ask before trusting workspace on startup\\nf7cf9bb feat(cli): ask before trusting workspace on startup\\ne7af4e7 fix(retention): confine checkpoint snapshot deletion\\nd92f38b Merge pull request #175 from mikeholownych/v1/defect-html-control-injection\\nfa7785e fix(security): strip terminal controls from untrusted HTML text\\n8a90c35 Merge pull request #62 from mikeholownych/v1/sec-html-tag-filter\\n4758eb5 fix(web): extract untrusted HTML text with a single-pass scanner\\n0e2e1b0 qual(terminal): exact RC package identity, positive-control measurements, fail-closed gate\\n33bbac0 feat(tui): approval panel arrow alignment, narrow terminal hints, and safe execution documentation (PLAN-01 PR-1f)\\n3d76846 merge v1/plan-03-pr-3f (docs: egress boundaries, locality, trust model, and migration guide)\\n499e563 docs: document egress boundaries, locality, trust model, and migration guide (PLAN-03 PR-3f)\\nf6957db (v1/plan-03-pr-3d) feat(security): trust-gate workspace skills & knowledge, source annotations, opt-in autoextract (REQ-SEC-113, REQ-SEC-114)\\n\"}\nRESULT 2:\n{\"content\":[{\"type\":\"text\",\"text\":\"Tool execution failed: search: server runtime is selected but configuration is incomplete (missing url, api key, or project id)\"}],\"isError\":true}\nRESULT 3:\n{\"content\":[{\"type\":\"text\",\"text\":\"- nexus-v1-release-convergence: current_exact_main=origin/main advanced to b0240273dc6824c068e6f65719fbbdacf2efb889 when PR191 NAT64 SSRF fix merged 2026-10-24T11:58:01Z after RC4 tag. CI40091991934 and CodeQL40091991855 are in progress. RC4 remains immutable on 57b9285; determine next candidate after checks and source review., pre_rc_source_gate=At exact clean detached snapshot a2f2fba0de3288bdd69d377fa664d3aa1a0117dc, with HOME/XDG isolated and Node24.11.1, node scripts/check_requirements.mjs --enforce passed: 123 rows; 108 tested, 6 partial, 2 implemented, 7 open, 12 exact-RC qualification deferrals. node scripts/sync-version.mjs --check --tag v1.0.0-rc.4 passed. Must rerun on merge main 57b9285 after post-merge workflows pass; source-readiness only., acceptance_status=IN_PROGRESS, public_release_status=RC3 remains latest public release; RC4 not yet tagged/published., startup_trus