{"timestamp":"2026-10-24T14:41:09.927Z","ordinal":293482,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16e58-0fa9-73b3-824f-571bf4a9cd42","item":{"type":"CommandExecution","id":"exec-ec0b3748-a9a3-498b-a413-45f2b377f1c3","process_id":"51372","command":["/usr/bin/zsh","-lc","printf '== repro-related claims ==\\n'; rg --files .git/nexus-claims | rg -i 'repro|package-linux|crossrunner|tar-metadata' | head -60; printf '== repro candidate state ==\\n'; git -C /home/mike/nexus-wt/repro-crossrunner-bundle status --short --branch 2>/dev/null; git -C /home/mike/nexus-wt/repro-crossrunner-bundle rev-parse HEAD 2>/dev/null; git -C /home/mike/nexus-wt/repro-crossrunner-bundle show --stat --oneline HEAD 2>/dev/null; printf '== current package script delta ==\\n'; git -C /home/mike/nexus-wt/repro-crossrunner-bundle diff origin/main...HEAD -- scripts/package-linux.sh .github/workflows/repro.yml 2>/dev/null"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"printf '== repro-related claims ==\\n'; rg --files .git/nexus-claims | rg -i 'repro|package-linux|crossrunner|tar-metadata' | head -60; printf '== repro candidate state ==\\n'; git -C /home/mike/nexus-wt/repro-crossrunner-bundle status --short --branch 2>/dev/null; git -C /home/mike/nexus-wt/repro-crossrunner-bundle rev-parse HEAD 2>/dev/null; git -C /home/mike/nexus-wt/repro-crossrunner-bundle show --stat --oneline HEAD 2>/dev/null; printf '== current package script delta ==\\n'; git -C /home/mike/nexus-wt/repro-crossrunner-bundle diff origin/main...HEAD -- scripts/package-linux.sh .github/workflows/repro.yml 2>/dev/null"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"== repro-related claims ==\n.git/nexus-claims/FILE_scripts_package-linux.sh/owner.json\n.git/nexus-claims/REPRO_TAR_METADATA_20261024/owner.json\n.git/nexus-claims/REPRO_CROSS_RUNNER_BUNDLE_20261024/owner.json\n.git/nexus-claims/FILE_scripts_repro-identity.mjs/owner.json\n.git/nexus-claims/archived/SUITE-pr61-focused-repro-1d402bf-20261020T133350Z.json\n.git/nexus-claims/archived/PR180_scoped_registry_repro_merged_20261024T042143Z/FILE_scripts_registry-package-name.mjs.owner.json\n.git/nexus-claims/archived/PR180_scoped_registry_repro_merged_20261024T042143Z/FILE_cli_test_repro_identity.test.ts.owner.json\n.git/nexus-claims/archived/PR180_scoped_registry_repro_merged_20261024T042143Z/FILE_scripts_check_deprecated_lock.mjs.owner.json\n.git/nexus-claims/archived/FILE_scripts_package-linux.sh-owner-transfer-to-root-20261020T113030Z.json\n.git/nexus-claims/FILE_.github_workflows_repro.yml/owner.json\n== repro candidate state ==\n## v1/repro-crossrunner-bundle\n0f6bf66ba943eb3c9c64ae563c2b23f6970a6d5a\n0f6bf66 fix(release): normalize package archives across runners\n scripts/package-linux.sh | 23 +++++++++++++++++++++--\n 1 file changed, 21 insertions(+), 2 deletions(-)\n== current package script delta ==\ndiff --git a/.github/workflows/repro.yml b/.github/workflows/repro.yml\nindex 5ddae82..2de1a49 100644\n--- a/.github/workflows/repro.yml\n+++ b/.github/workflows/repro.yml\n@@ -153,11 +153,11 @@ jobs:\n           persist-credentials: false\n       - name: Verify comparison code is the exact reviewed workflow commit\n         run: test \"$(git rev-parse HEAD)\" = \"$EXPECTED_WORKFLOW_SHA\"\n-      - uses: actions/download-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n+      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n         with:\n           name: nexus-repro-ubuntu-22.04\n           path: ${{ runner.temp }}/ubuntu-22.04\n-      - uses: actions/download-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n+      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n         with:\n           name: nexus-repro-ubuntu-24.04\n           path: ${{ runner.temp }}/ubuntu-24.04\ndiff --git a/scripts/package-linux.sh b/scripts/package-linux.sh\nindex 393d33e..31555c9 100644\n--- a/scripts/package-linux.sh\n+++ b/scripts/package-linux.sh\n@@ -16,6 +16,7 @@ elif [[ \"$NEXUS_BUILD_CONTAINER_IMAGE\" != \"$APPROVED_RUST_BUILD_IMAGE\" ]]; then\n   exit 2\n fi\n mkdir -p \"$OUT\"\n+OUT=$(cd \"$OUT\" && pwd -P)\n WORK=$(mktemp -d)\n trap 'rm -rf \"$WORK\"' EXIT\n \n@@ -163,8 +164,26 @@ exec node \"$NEXUS_HOME/lib/cli/dist/index.js\" \"$@\"\n EOF\n chmod 0755 \"$PKG/bin/nexus\" \"$PKG/lib/core/harness-core\" \"$PKG/lib/core/nexus-tui\"\n (cd \"$PKG\" && find . -type f ! -name MANIFEST.sha256 | LC_ALL=C sort | xargs sha256sum > MANIFEST.sha256)\n-tar --sort=name --format=pax --mtime=\"@$SOURCE_DATE_EPOCH\" --owner=0 --group=0 --numeric-owner \\\n-  --pax-option=delete=atime,delete=ctime -C \"$WORK\" -cf - nexus | gzip -n > \"$OUT/$ARCHIVE\"\n+# The RC build runs on multiple Ubuntu images. Their host tar versions encode\n+# the unused PAX device-number fields differently, which changes the archive\n+# digest even when every packaged file is identical. Use the same digest-pinned\n+# image as the Rust build for tar and gzip so the complete archive format is\n+# independent of the host runner. The explicitly opted-in local development\n+# path remains host-built and must not be used as reproducibility evidence.\n+if [[ -n \"${NEXUS_BUILD_CONTAINER_IMAGE:-}\" ]]; then\n+  docker run --rm --pull=always --platform linux/amd64 \\\n+    --user \"$(id -u):$(id -g)\" \\\n+    --mount \"type=bind,src=$WORK,dst=/nexus-package,readonly\" \\\n+    --mount \"type=bind,src=$OUT,dst=/nexus-output\" \\\n+    --workdir /nexus-package \\\n+    --env \"SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH\" \\\n+    --env \"ARCHIVE=$ARCHIVE\" \\\n+    \"$NEXUS_BUILD_CONTAINER_IMAGE\" \\\n+    sh -ec 'tmp=$(mktemp); tar --sort=name --format=pax --mtime=\"@$SOURCE_DATE_EPOCH\" --owner=0 --group=0 --numeric-owner --pax-option=delete=atime,delete=ctime -cf \"$tmp\" nexus; gzip -n -c \"$tmp\" > \"/nexus-output/$ARCHIVE\"'\n+else\n+  tar --sort=name --format=pax --mtime=\"@$SOURCE_DATE_EPOCH\" --owner=0 --group=0 --numeric-owner \\\n+    --pax-option=delete=atime,delete=ctime -C \"$WORK\" -cf - nexus | gzip -n > \"$OUT/$ARCHIVE\"\n+fi\n \n # The detached metadata repeats only the authenticated in-archive contract and\n # adds the digest of the exact archive. The release checksum index covers both.\n","exit_code":0,"duration":{"secs":0,"nanos":29864}},"started_at_ms":1792852869927,"completed_at_ms":1792852869927}}
