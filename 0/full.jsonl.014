er } from \"../src/core/state.js\";\n24-import { DEFAULT_RECOVERY_POLICY } from \"../src/core/provider_recovery.js\";\n25-import { fakeClock, startGateway } from \"./helpers/provider_fixture.js\";\n26:import { makeRepo, makeHome, trustWorkspace, ptyTest } from \"./helpers/fixtures.js\";\n27-\n28-const here = path.dirname(fileURLToPath(import.meta.url));\n29-const INDEX = path.resolve(here, \"../dist/index.js\");\n30-\n31-describe(\"ACC-INF-07 (REQ-TUI-105): Startup endpoint probe and first-contact deadline\", () => {\n32:  ptyTest(\"startup trust Escape exits the CLI process promptly\", { timeout: 30_000 }, async () => {\n33-    assert.ok(fs.existsSync(INDEX), `missing ${INDEX} (run npm --prefix cli run build)`);\n34-    const repo = makeRepo();\n35-    const home = makeHome();\n36-    const pyScript = `\n37-import os, pty, select, subprocess, sys, time, json\n38-\n--\n86-        child.stdout.on(\"data\", (chunk) => (out += chunk));\n87-        child.stderr.on(\"data\", (chunk) => (err += chunk));\n88-        child.on(\"close\", (exitCode) => resolve({ code: exitCode, out, err }));\n89-      });\n90-      assert.equal(code, 0, `PTY script failed: ${err}\\n${out}`);\n91-      const result = JSON.parse(out.trim().split(\"\\n\").pop() || \"{}\");\n92:      assert.equal(result.prompted, true, `startup trust prompt did not appear:\\n${result.output}`);\n93-      assert.equal(result.exited, true, `CLI stayed alive after trust prompt exit:\\n${result.output}`);\n94-      assert.equal(result.code, 0, `CLI exit should be clean:\\n${result.output}`);\n95-    } finally {\n96-      fs.rmSync(repo, { recursive: true, force: true });\n97-      fs.rmSync(home, { recursive: true, force: true });\n98-    }\n--\n136-      await server.shutdown();\n137-      fs.rmSync(repo, { recursive: true, force: true });\n138-      fs.rmSync(home, { recursive: true, force: true });\n139-    }\n140-  });\n141-\n142:  test(\"Never-succeeded endpoint bounds recovery wait to 120 s (2 min) default and 