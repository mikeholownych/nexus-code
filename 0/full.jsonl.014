{"timestamp":"2026-10-24T14:27:23.206Z","ordinal":292855,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16e48-57ed-79c2-bd99-946dbd9156e1","item":{"type":"McpToolCall","id":"exec-9f2c82c0-21df-42bb-852b-b87290667089","server":"codex_apps","tool":"github.fetch","arguments":{"url":"https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh"},"connectorId":"connector_76869538009648d5b282a4bb21c3d157","linkId":"link_68d2673aabd08191a10c1849bf534da6","appName":"GitHub","actionName":"fetch","readOnlyHint":true,"status":"completed","result":{"content":[{"type":"text","text":"Action completed."}],"structuredContent":{"content":"#!/bin/sh\nset -eu\n\nREPO=mikeholownych/nexus-code\nBASE=${NEXUS_RELEASE_BASE_URL:-\"https://github.com/$REPO/releases\"}\nVERSION=${NEXUS_VERSION:-latest}\nPREFIX=${NEXUS_PREFIX:-\"$HOME/.local\"}\n\nfail() { printf 'nexus installer: %s\\n' \"$*\" >&2; exit 1; }\ncase \"$(uname -s):$(uname -m)\" in\n  Linux:x86_64|Linux:amd64) ;;\n  *) fail \"unsupported system $(uname -s)/$(uname -m); supported: Linux x86-64 (glibc).\" ;;\nesac\ncommand -v node >/dev/null 2>&1 || fail \"Node.js 22 or newer is required; install Node.js and retry.\"\nNODE_MAJOR=$(node -p 'Number(process.versions.node.split(\".\")[0])' 2>/dev/null || printf 0)\n[ \"$NODE_MAJOR\" -ge 22 ] || fail \"Node.js 22 or newer is required (found $(node --version 2>/dev/null || echo unknown)).\"\ncommand -v curl >/dev/null 2>&1 || fail \"curl is required.\"\ncommand -v tar >/dev/null 2>&1 || fail \"tar is required.\"\ncommand -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n\nvalidate_tag() {\n  printf '%s' \"$1\" | grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\"\n}\n\nif [ \"$VERSION\" != \"latest\" ]; then\n  validate_tag \"$VERSION\"\nfi\n\nif [ \"$VERSION\" = \"latest\" ]; then\n  API_BASE=${NEXUS_RELEASES_API:-\"https://api.github.com/repos/$REPO/releases\"}\n  API_TMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-api.XXXXXX\") || fail \"could not create temporary directory.\"\n  api_cleanup() { rm -rf \"$API_TMP\"; }\n  trap api_cleanup EXIT HUP INT TERM\n\n  LATEST_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -D \"$API_TMP/headers\" -o \"$API_TMP/latest.json\" -w \"%{http_code}\" \"$API_BASE/latest\" 2>\"$API_TMP/curl.err\" || echo \"000\")\n\n  if [ \"$LATEST_CODE\" = \"200\" ]; then\n    VERSION=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/latest.json\" | head -n 1)\n    [ -n \"$VERSION\" ] || fail \"GitHub returned no stable release tag.\"\n    validate_tag \"$VERSION\"\n  elif [ \"$LATEST_CODE\" = \"403\" ]; then\n    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \"$API_TMP/headers\" 2>/dev/null; then\n      fail \"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\"\n    fi\n    fail \"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\"\n  elif [ \"$LATEST_CODE\" = \"404\" ]; then\n    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \"$API_TMP/releases.json\" -w \"%{http_code}\" \"$API_BASE?per_page=1\" 2>/dev/null || echo \"000\")\n    if [ \"$PREREL_CODE\" = \"200\" ]; then\n      PREREL_TAG=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/releases.json\" | head -n 1)\n      if [ -n \"$PREREL_TAG\" ]; then\n        fail \"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\"\n      fi\n    fi\n    fail \"could not find latest stable release (HTTP 404 from $API_BASE/latest).\"\n  else\n    fail \"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\"\n  fi\n  rm -rf \"$API_TMP\"\n  trap - EXIT HUP INT TERM\nfi\n\nARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\nNORMALIZED_VERSION=${VERSION#v}\nURL=\"$BASE/download/$VERSION\"\nTMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-install.XXXXXX\") || fail \"could not create temporary directory.\"\ncleanup() { rm -rf \"$TMP\"; }\ntrap cleanup EXIT HUP INT TERM\ncurl -fsSL --show-error --retry 2 \"$URL/$ARCHIVE\" -o \"$TMP/$ARCHIVE\" || fail \"download failed for $ARCHIVE.\"\ncurl -fsSL --show-error --retry 2 \"$URL/SHA256SUMS\" -o \"$TMP/SHA256SUMS\" || fail \"could not download release checksums.\"\ngrep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksum entry for $ARCHIVE is missing.\"\n(cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\nARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n\nif [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" != \"0\" ] && command -v gh >/dev/null 2>&1; then\n  if gh attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n     gh attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n    printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n  elif [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" = \"1\" ]; then\n    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n  fi\nfi\n\nVERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\nBIN_DIR=\"$PREFIX/bin\"\nLINK=\"$BIN_DIR/nexus\"\nmkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\nif [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n  fail \"$LINK exists and is not a symlink; left it unchanged.\"\nfi\nif [ -L \"$LINK\" ]; then\n  OLD=$(readlink \"$LINK\")\n  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\nfi\n\nFORCE=${NEXUS_FORCE:-0}\nNEEDS_EXTRACT=1\nif [ -d \"$VERSION_DIR\" ] && [ \"$FORCE\" != \"1\" ]; then\n  if [ -x \"$VERSION_DIR/bin/nexus\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/harness-core\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/nexus-tui\" ] && \\\n     [ \"$(cat \"$VERSION_DIR/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ]; then\n    if [ -f \"$VERSION_DIR/MANIFEST.sha256\" ]; then\n      if (cd \"$VERSION_DIR\" && sha256sum --check --status MANIFEST.sha256 2>/dev/null); then\n        NEEDS_EXTRACT=0\n      fi\n      if [ \"$NEEDS_EXTRACT\" = \"0\" ]; then\n        if ! node - \"$VERSION_DIR/.provenance.json\" \"$ARCHIVE_SHA256\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [file, archiveSha256] = process.argv.slice(2);\ntry {\n  const record = JSON.parse(fs.readFileSync(file, \"utf8\"));\n  if (record.archiveSha256 !== archiveSha256) process.exit(1);\n} catch { process.exit(1); }\nNODE\n        then\n          NEEDS_EXTRACT=1\n        fi\n      fi\n    fi\n  fi\nfi\n\nif [ \"$NEEDS_EXTRACT\" = \"1\" ]; then\n  mkdir -p \"$TMP/unpack\"\n  tar -xzf \"$TMP/$ARCHIVE\" -C \"$TMP/unpack\" || fail \"archive extraction failed.\"\n  PACKAGE=\"$TMP/unpack/nexus\"\n  [ -x \"$PACKAGE/bin/nexus\" ] && [ -x \"$PACKAGE/lib/core/harness-core\" ] && [ -x \"$PACKAGE/lib/core/nexus-tui\" ] && [ \"$(cat \"$PACKAGE/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ] || fail \"release archive is incomplete or has a mismatched version.\"\n  if [ -f \"$PACKAGE/MANIFEST.sha256\" ]; then\n    (cd \"$PACKAGE\" && sha256sum --check --status MANIFEST.sha256) || fail \"release archive failed manifest checksum verification.\"\n  fi\n  PACKAGE_VERSION_OUTPUT=$(\"$PACKAGE/bin/nexus\" --version 2>&1) || fail \"release binary failed its pre-install self-test.\"\n  PACKAGE_VERSION_REPORTED=$(printf '%s\\n' \"$PACKAGE_VERSION_OUTPUT\" | sed -n '1s/[[:space:]].*$//p')\n  [ \"$PACKAGE_VERSION_REPORTED\" = \"$NORMALIZED_VERSION\" ] || fail \"release binary reported version '$PACKAGE_VERSION_REPORTED' instead of '$NORMALIZED_VERSION' during self-test.\"\n  if [ -f \"$PACKAGE/compatibility.json\" ]; then\n    node - \"$PACKAGE/compatibility.json\" \"$VERSION\" \"$ARCHIVE\" <<'NODE' || fail \"release compatibility metadata is invalid or mismatched.\"\nconst fs = require(\"node:fs\");\nconst [file, version, archive] = process.argv.slice(2);\nconst data = JSON.parse(fs.readFileSync(file, \"utf8\"));\nconst asset = data.platforms?.[\"linux-x86_64\"];\nconst compatible = data.schemaVersion === 1 && data.product === \"nexus-code\" &&\n  data.version === version.replace(/^v/, \"\") &&\n  typeof data.revision === \"string\" && /^[a-f0-9]{7,64}$/i.test(data.revision) &&\n  typeof data.builtAt === \"string\" && !Number.isNaN(Date.parse(data.builtAt)) &&\n  asset?.archive === archive && asset.os === \"linux\" && asset.arch === \"x86_64\" &&\n  data.compatibility && Number.isSafeInteger(data.compatibility.configSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.stateSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedConfigVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedStateVersion) &&\n  data.compatibility.minSupportedConfigVersion <= data.compatibility.configSchemaVersion &&\n  data.compatibility.minSupportedStateVersion <= data.compatibility.stateSchemaVersion;\nif (!compatible) process.exit(1);\nNODE\n  fi\n  rm -rf \"$VERSION_DIR\"\n  mv \"$PACKAGE\" \"$VERSION_DIR\"\nfi\nnode - \"$VERSION_DIR/compatibility.json\" \"$VERSION\" \"$PREFIX\" \"$VERSION_DIR\" \"$LINK\" \"$ARCHIVE\" \"$ARCHIVE_SHA256\" \"$VERSION_DIR/.provenance.json\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [metadataPath, version, prefix, installedPath, binPath, archive, archiveSha256, output] = process.argv.slice(2);\nlet metadata = null;\ntry { metadata = JSON.parse(fs.readFileSync(metadataPath, \"utf8\")); } catch {}\nconst record = {\n  formatVersion: 1,\n  method: \"installer\",\n  product: \"nexus-code\",\n  version,\n  ...(metadata?.revision ? { revision: metadata.revision } : {}),\n  ...(metadata?.builtAt ? { builtAt: metadata.builtAt } : {}),\n  prefix,\n  installedPath,\n  binPath,\n  managed: true,\n  archive,\n  archiveSha256,\n};\nfs.writeFileSync(output, `${JSON.stringify(record, null, 2)}\\n`, { mode: 0o644 });\nfs.chmodSync(output, 0o644);\nNODE\nNEXT=\"$BIN_DIR/.nexus-link.$$\"\nln -s \"$VERSION_DIR/bin/nexus\" \"$NEXT\"\nmv -f \"$NEXT\" \"$LINK\"\nprintf 'Installed Nexus Code %s in %s\\n' \"$VERSION\" \"$VERSION_DIR\"\ncase \":$PATH:\" in *\":$BIN_DIR:\"*) ;; *) printf 'Add this to your shell profile if needed: export PATH=\"%s:$PATH\"\\n' \"$BIN_DIR\" ;; esac\n\"$LINK\" --version\n","title":"install.sh","modified_date":"2026-10-22T22:17:30Z","url":"https://github.com/mikeholownych/nexus-code/blob/main/install.sh","display_url":"https://github.com/mikeholownych/nexus-code/blob/main/install.sh","display_title":"install.sh","structuredContent":{"title":"install.sh","content":"#!/bin/sh\nset -eu\n\nREPO=mikeholownych/nexus-code\nBASE=${NEXUS_RELEASE_BASE_URL:-\"https://github.com/$REPO/releases\"}\nVERSION=${NEXUS_VERSION:-latest}\nPREFIX=${NEXUS_PREFIX:-\"$HOME/.local\"}\n\nfail() { printf 'nexus installer: %s\\n' \"$*\" >&2; exit 1; }\ncase \"$(uname -s):$(uname -m)\" in\n  Linux:x86_64|Linux:amd64) ;;\n  *) fail \"unsupported system $(uname -s)/$(uname -m); supported: Linux x86-64 (glibc).\" ;;\nesac\ncommand -v node >/dev/null 2>&1 || fail \"Node.js 22 or newer is required; install Node.js and retry.\"\nNODE_MAJOR=$(node -p 'Number(process.versions.node.split(\".\")[0])' 2>/dev/null || printf 0)\n[ \"$NODE_MAJOR\" -ge 22 ] || fail \"Node.js 22 or newer is required (found $(node --version 2>/dev/null || echo unknown)).\"\ncommand -v curl >/dev/null 2>&1 || fail \"curl is required.\"\ncommand -v tar >/dev/null 2>&1 || fail \"tar is required.\"\ncommand -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n\nvalidate_tag() {\n  printf '%s' \"$1\" | grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\"\n}\n\nif [ \"$VERSION\" != \"latest\" ]; then\n  validate_tag \"$VERSION\"\nfi\n\nif [ \"$VERSION\" = \"latest\" ]; then\n  API_BASE=${NEXUS_RELEASES_API:-\"https://api.github.com/repos/$REPO/releases\"}\n  API_TMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-api.XXXXXX\") || fail \"could not create temporary directory.\"\n  api_cleanup() { rm -rf \"$API_TMP\"; }\n  trap api_cleanup EXIT HUP INT TERM\n\n  LATEST_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -D \"$API_TMP/headers\" -o \"$API_TMP/latest.json\" -w \"%{http_code}\" \"$API_BASE/latest\" 2>\"$API_TMP/curl.err\" || echo \"000\")\n\n  if [ \"$LATEST_CODE\" = \"200\" ]; then\n    VERSION=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/latest.json\" | head -n 1)\n    [ -n \"$VERSION\" ] || fail \"GitHub returned no stable release tag.\"\n    validate_tag \"$VERSION\"\n  elif [ \"$LATEST_CODE\" = \"403\" ]; then\n    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \"$API_TMP/headers\" 2>/dev/null; then\n      fail \"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\"\n    fi\n    fail \"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\"\n  elif [ \"$LATEST_CODE\" = \"404\" ]; then\n    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \"$API_TMP/releases.json\" -w \"%{http_code}\" \"$API_BASE?per_page=1\" 2>/dev/null || echo \"000\")\n    if [ \"$PREREL_CODE\" = \"200\" ]; then\n      PREREL_TAG=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/releases.json\" | head -n 1)\n      if [ -n \"$PREREL_TAG\" ]; then\n        fail \"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\"\n      fi\n    fi\n    fail \"could not find latest stable release (HTTP 404 from $API_BASE/latest).\"\n  else\n    fail \"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\"\n  fi\n  rm -rf \"$API_TMP\"\n  trap - EXIT HUP INT TERM\nfi\n\nARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\nNORMALIZED_VERSION=${VERSION#v}\nURL=\"$BASE/download/$VERSION\"\nTMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-install.XXXXXX\") || fail \"could not create temporary directory.\"\ncleanup() { rm -rf \"$TMP\"; }\ntrap cleanup EXIT HUP INT TERM\ncurl -fsSL --show-error --retry 2 \"$URL/$ARCHIVE\" -o \"$TMP/$ARCHIVE\" || fail \"download failed for $ARCHIVE.\"\ncurl -fsSL --show-error --retry 2 \"$URL/SHA256SUMS\" -o \"$TMP/SHA256SUMS\" || fail \"could not download release checksums.\"\ngrep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksum entry for $ARCHIVE is missing.\"\n(cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\nARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n\nif [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" != \"0\" ] && command -v gh >/dev/null 2>&1; then\n  if gh attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n     gh attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n    printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n  elif [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" = \"1\" ]; then\n    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n  fi\nfi\n\nVERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\nBIN_DIR=\"$PREFIX/bin\"\nLINK=\"$BIN_DIR/nexus\"\nmkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\nif [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n  fail \"$LINK exists and is not a symlink; left it unchanged.\"\nfi\nif [ -L \"$LINK\" ]; then\n  OLD=$(readlink \"$LINK\")\n  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\nfi\n\nFORCE=${NEXUS_FORCE:-0}\nNEEDS_EXTRACT=1\nif [ -d \"$VERSION_DIR\" ] && [ \"$FORCE\" != \"1\" ]; then\n  if [ -x \"$VERSION_DIR/bin/nexus\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/harness-core\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/nexus-tui\" ] && \\\n     [ \"$(cat \"$VERSION_DIR/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ]; then\n    if [ -f \"$VERSION_DIR/MANIFEST.sha256\" ]; then\n      if (cd \"$VERSION_DIR\" && sha256sum --check --status MANIFEST.sha256 2>/dev/null); then\n        NEEDS_EXTRACT=0\n      fi\n      if [ \"$NEEDS_EXTRACT\" = \"0\" ]; then\n        if ! node - \"$VERSION_DIR/.provenance.json\" \"$ARCHIVE_SHA256\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [file, archiveSha256] = process.argv.slice(2);\ntry {\n  const record = JSON.parse(fs.readFileSync(file, \"utf8\"));\n  if (record.archiveSha256 !== archiveSha256) process.exit(1);\n} catch { process.exit(1); }\nNODE\n        then\n          NEEDS_EXTRACT=1\n        fi\n      fi\n    fi\n  fi\nfi\n\nif [ \"$NEEDS_EXTRACT\" = \"1\" ]; then\n  mkdir -p \"$TMP/unpack\"\n  tar -xzf \"$TMP/$ARCHIVE\" -C \"$TMP/unpack\" || fail \"archive extraction failed.\"\n  PACKAGE=\"$TMP/unpack/nexus\"\n  [ -x \"$PACKAGE/bin/nexus\" ] && [ -x \"$PACKAGE/lib/core/harness-core\" ] && [ -x \"$PACKAGE/lib/core/nexus-tui\" ] && [ \"$(cat \"$PACKAGE/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ] || fail \"release archive is incomplete or has a mismatched version.\"\n  if [ -f \"$PACKAGE/MANIFEST.sha256\" ]; then\n    (cd \"$PACKAGE\" && sha256sum --check --status MANIFEST.sha256) || fail \"release archive failed manifest checksum verification.\"\n  fi\n  PACKAGE_VERSION_OUTPUT=$(\"$PACKAGE/bin/nexus\" --version 2>&1) || fail \"release binary failed its pre-install self-test.\"\n  PACKAGE_VERSION_REPORTED=$(printf '%s\\n' \"$PACKAGE_VERSION_OUTPUT\" | sed -n '1s/[[:space:]].*$//p')\n  [ \"$PACKAGE_VERSION_REPORTED\" = \"$NORMALIZED_VERSION\" ] || fail \"release binary reported version '$PACKAGE_VERSION_REPORTED' instead of '$NORMALIZED_VERSION' during self-test.\"\n  if [ -f \"$PACKAGE/compatibility.json\" ]; then\n    node - \"$PACKAGE/compatibility.json\" \"$VERSION\" \"$ARCHIVE\" <<'NODE' || fail \"release compatibility metadata is invalid or mismatched.\"\nconst fs = require(\"node:fs\");\nconst [file, version, archive] = process.argv.slice(2);\nconst data = JSON.parse(fs.readFileSync(file, \"utf8\"));\nconst asset = data.platforms?.[\"linux-x86_64\"];\nconst compatible = data.schemaVersion === 1 && data.product === \"nexus-code\" &&\n  data.version === version.replace(/^v/, \"\") &&\n  typeof data.revision === \"string\" && /^[a-f0-9]{7,64}$/i.test(data.revision) &&\n  typeof data.builtAt === \"string\" && !Number.isNaN(Date.parse(data.builtAt)) &&\n  asset?.archive === archive && asset.os === \"linux\" && asset.arch === \"x86_64\" &&\n  data.compatibility && Number.isSafeInteger(data.compatibility.configSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.stateSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedConfigVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedStateVersion) &&\n  data.compatibility.minSupportedConfigVersion <= data.compatibility.configSchemaVersion &&\n  data.compatibility.minSupportedStateVersion <= data.compatibility.stateSchemaVersion;\nif (!compatible) process.exit(1);\nNODE\n  fi\n  rm -rf \"$VERSION_DIR\"\n  mv \"$PACKAGE\" \"$VERSION_DIR\"\nfi\nnode - \"$VERSION_DIR/compatibility.json\" \"$VERSION\" \"$PREFIX\" \"$VERSION_DIR\" \"$LINK\" \"$ARCHIVE\" \"$ARCHIVE_SHA256\" \"$VERSION_DIR/.provenance.json\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [metadataPath, version, prefix, installedPath, binPath, archive, archiveSha256, output] = process.argv.slice(2);\nlet metadata = null;\ntry { metadata = JSON.parse(fs.readFileSync(metadataPath, \"utf8\")); } catch {}\nconst record = {\n  formatVersion: 1,\n  method: \"installer\",\n  product: \"nexus-code\",\n  version,\n  ...(metadata?.revision ? { revision: metadata.revision } : {}),\n  ...(metadata?.builtAt ? { builtAt: metadata.builtAt } : {}),\n  prefix,\n  installedPath,\n  binPath,\n  managed: true,\n  archive,\n  archiveSha256,\n};\nfs.writeFileSync(output, `${JSON.stringify(record, null, 2)}\\n`, { mode: 0o644 });\nfs.chmodSync(output, 0o644);\nNODE\nNEXT=\"$BIN_DIR/.nexus-link.$$\"\nln -s \"$VERSION_DIR/bin/nexus\" \"$NEXT\"\nmv -f \"$NEXT\" \"$LINK\"\nprintf 'Installed Nexus Code %s in %s\\n' \"$VERSION\" \"$VERSION_DIR\"\ncase \":$PATH:\" in *\":$BIN_DIR:\"*) ;; *) printf 'Add this to your shell profile if needed: export PATH=\"%s:$PATH\"\\n' \"$BIN_DIR\" ;; esac\n\"$LINK\" --version\n","display_url":"https://github.com/mikeholownych/nexus-code/blob/main/install.sh"}},"isError":false},"duration":{"secs":0,"nanos":630263779}},"started_at_ms":1792852042575,"completed_at_ms":1792852043206}}
{"timestamp":"2026-10-24T14:27:23.254Z","ordinal":292856,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16e48-57ed-79c2-bd99-946dbd9156e1","item":{"type":"McpToolCall","id":"exec-0bb0b387-1ff3-48f7-85b4-547d07175074","server":"codex_apps","tool":"github.fetch","arguments":{"url":"https://raw.githubusercontent.com/mikeholownych/nexus-code/main/quickstart.md"},"connectorId":"connector_76869538009648d5b282a4bb21c3d157","linkId":"link_68d2673aabd08191a10c1849bf534da6","appName":"GitHub","actionName":"fetch","readOnlyHint":true,"status":"completed","result":{"content":[{"type":"text","text":"Action completed."}],"structuredContent":{"content":"# Nexus Code quickstart\n\nNexus Code is a local coding client. It is separate from the Cloudflare Workers and Artifacts collaboration service in the contest entry.\n\n## Install\n\nOn Linux x86-64 with glibc 2.35 or newer and Node.js 22 or newer:\n\n```sh\ncurl -fsSL https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh | sh\n```\n\nThe installer downloads the matching versioned client archive and `SHA256SUMS` from this repository's GitHub Release, verifies the archive, and installs under `~/.local/lib/nexus`. It adds a `nexus` symlink in `~/.local/bin`; it does not edit shell startup files or use root. If `~/.local/bin` is not in `PATH`, add it yourself:\n\n```sh\nexport PATH=\"$HOME/.local/bin:$PATH\"\n```\n\nWithout `NEXUS_VERSION`, the installer follows the latest stable release. If no stable release has been published yet, the installer exits with a hint to select a prerelease tag from [GitHub Releases](https://github.com/mikeholownych/nexus-code/releases). To install a prerelease or pin a version, set `NEXUS_VERSION` to its published tag. The `v1.0.0-rc.1` example below works after that tag appears on [GitHub Releases](https://github.com/mikeholownych/nexus-code/releases); before then, replace it with a prerelease tag already listed there:\n\n```sh\ncurl -fsSL https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh | NEXUS_VERSION=v1.0.0-rc.1 sh\n```\n\nFor inspect-before-running, download [install.sh](https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh), read it, then run `sh install.sh`.\n\nThe release package includes the TypeScript client, production Node dependencies, `harness-core`, and the Ratatui `nexus-tui` binary. Node is an external runtime prerequisite. Current release support is limited to Linux x86-64/glibc; macOS, Windows, ARM, musl, and other architectures are not claimed.\n\n## Configure an inference endpoint\n\nNexus works with an OpenAI-compatible local endpoint such as LM Studio or vLLM. Start that server and load a model first. For example:\n\n```sh\nmkdir -p \"$HOME/.config/nexus\"\nchmod 700 \"$HOME/.config/nexus\"\ncat > \"$HOME/.config/nexus/config.env\" <<'EOF'\nLOCAL_LLM_ENDPOINT=http://localhost:1234/v1\nLOCAL_LLM_MODEL=your-loaded-model\nLOCAL_LLM_API_KEY=REDACTED\nEOF\nchmod 600 \"$HOME/.config/nexus/config.env\"\n```\n\nUse your endpoint's actual model ID. Nexus automatically discovers the loaded context window from LM Studio (`/api/v0/models`), llama.cpp (`/props`), vLLM (`/v1/models`), and Ollama (`/api/show`), or you can override it with `--context-limit` (`NEXUS_CONTEXT_LIMIT`). For HTTPS servers using a private certificate authority, set `NODE_EXTRA_CA_CERTS=/path/to/ca.pem` in `~/.config/nexus/config.env`. Do not put real credentials in a project `.env`, shell history, or this example. See [Local servers](docs/LOCAL_SERVERS.md) for per-server setup and [Cloud providers](docs/CLOUD_PROVIDERS.md) for cloud provider and credential handling.\n\n## First run\n\nFrom a project directory:\n\n```sh\nnexus doctor\nnexus\n```\n\nEnter a small task, review requested actions, and inspect the reported turn outcome. On a terminal, running `nexus` with no arguments opens the live TUI; in non-interactive environments or with `nexus repl`, it opens the interactive REPL. For non-interactive tasks, run `nexus run \"<task>\"`. Use `nexus --help` and `/help` for implemented commands.\n\n### Trust your own repository\n\nBy default, an untrusted workspace opens in `review` posture, asking for your explicit confirmation before executing shell commands, file modifications, network egress, or test suites.\n\nIf this is your own repository and you want autonomous execution, trust it:\n\n```sh\nnexus trust .\n```\n\nOnce trusted, Nexus runs in `auto` posture. To force review mode regardless of trust, pass `--approve`. To run autonomously in CI or scripts without trusting the workspace permanently, pass `--yes` (or `--mode auto`, or set `NEXUS_APPROVAL_MODE=auto`).\n\nNexus reports `VERIFIED` only when its selected verifier passes and the operator has declared the product files for that task before it starts. For example: `nexus run --deliverable-file src/math.ts \"Fix the addition defect\"`; repeat `--deliverable-file` for each expected product file. The scope must use literal workspace-relative paths and cannot name tests. A passing suite without a declared scope is regression evidence (`REGRESSION_FREE`), not proof that the requested product change was verified. `UNVERIFIED`, `BLOCKED`, and `LIMIT_REACHED` remain distinct outcomes; a completed model response alone does not mean the work is correct.\n\nResuming a saved session or durable task keeps verification pending because local session and task files do not authenticate their own history. No generic verifier is currently trusted to clear that obligation after recovery: even an external test runner can execute workspace-controlled tests. A resumed task may continue, but it remains `UNVERIFIED`. Before starting a new task to establish a new baseline, the operator must review the workspace state, including ignored and untracked files and verifier/test definitions, and restore or remove any state that is not trusted. A clean Git status alone does not establish that ignored files or external acceptance inputs are trustworthy. A future verifier could replace this manual boundary only after its implementation and acceptance inputs are independently bound outside candidate control. A current-invocation `--authoritative-verifier` alone does not clear recovered obligations.\n\n## Upgrade and remove\n\nCheck whether a newer release is published:\n\n```sh\nnexus upgrade --check\n```\n\nTo upgrade in-place to the latest stable release:\n\n```sh\nnexus upgrade\n```\n\nTo target or reinstall an exact pinned version:\n\n```sh\nnexus upgrade --version v1.0.0\n```\n\nInside the interactive live TUI, run `/upgrade` or `/upgrade --check`. An upgrade requires deliberate modal confirmation before modifying the installation. In scripts or CI, non-interactive upgrades require `--yes`.\n\nAlternatively, run the installer pipeline to reinstall or upgrade:\n\n```sh\ncurl -fsSL https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh | NEXUS_VERSION=v1.0.0 sh\n```\n\nRemoval is manual and limited to Nexus-owned paths:\n\n```sh\nrm \"$HOME/.local/bin/nexus\"\nrm -rf \"$HOME/.local/lib/nexus\"\n```\n\nUser configuration, credentials, sessions, and project `.nexus` data are retained.\n\n## Build from source\n\nSee [Development and release](docs/DEVELOPMENT.md). Source builds require Rust, Cargo, Node.js 22+, npm, a C toolchain, and platform libraries. The release installer is the recommended path for supported Linux x86-64 systems.\n","title":"quickstart.md","modified_date":"2026-10-22T22:17:30Z","url":"https://github.com/mikeholownych/nexus-code/blob/main/quickstart.md","display_url":"https://github.com/mikeholownych/nexus-code/blob/main/quickstart.md","display_title":"quickstart.md","structuredContent":{"title":"quickstart.md","content":"# Nexus Code quickstart\n\nNexus Code is a local coding client. It is separate from the Cloudflare Workers and Artifacts collaboration service in the contest entry.\n\n## Install\n\nOn Linux x86-64 with glibc 2.35 or newer and Node.js 22 or newer:\n\n```sh\ncurl -fsSL https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh | sh\n```\n\nThe installer downloads the matching versioned client archive and `SHA256SUMS` from this repository's GitHub Release, verifies the archive, and installs under `~/.local/lib/nexus`. It adds a `nexus` symlink in `~/.local/bin`; it does not edit shell startup files or use root. If `~/.local/bin` is not in `PATH`, add it yourself:\n\n```sh\nexport PATH=\"$HOME/.local/bin:$PATH\"\n```\n\nWithout `NEXUS_VERSION`, the installer follows the latest stable release. If no stable release has been published yet, the installer exits with a hint to select a prerelease tag from [GitHub Releases](https://github.com/mikeholownych/nexus-code/releases). To install a prerelease or pin a version, set `NEXUS_VERSION` to its published tag. The `v1.0.0-rc.1` example below works after that tag appears on [GitHub Releases](https://github.com/mikeholownych/nexus-code/releases); before then, replace it with a prerelease tag already listed there:\n\n```sh\ncurl -fsSL https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh | NEXUS_VERSION=v1.0.0-rc.1 sh\n```\n\nFor inspect-before-running, download [install.sh](https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh), read it, then run `sh install.sh`.\n\nThe release package includes the TypeScript client, production Node dependencies, `harness-core`, and the Ratatui `nexus-tui` binary. Node is an external runtime prerequisite. Current release support is limited to Linux x86-64/glibc; macOS, Windows, ARM, musl, and other architectures are not claimed.\n\n## Configure an inference endpoint\n\nNexus works with an OpenAI-compatible local endpoint such as LM Studio or vLLM. Start that server and load a model first. For example:\n\n```sh\nmkdir -p \"$HOME/.config/nexus\"\nchmod 700 \"$HOME/.config/nexus\"\ncat > \"$HOME/.config/nexus/config.env\" <<'EOF'\nLOCAL_LLM_ENDPOINT=http://localhost:1234/v1\nLOCAL_LLM_MODEL=your-loaded-model\nLOCAL_LLM_API_KEY=REDACTED\nEOF\nchmod 600 \"$HOME/.config/nexus/config.env\"\n```\n\nUse your endpoint's actual model ID. Nexus automatically discovers the loaded context window from LM Studio (`/api/v0/models`), llama.cpp (`/props`), vLLM (`/v1/models`), and Ollama (`/api/show`), or you can override it with `--context-limit` (`NEXUS_CONTEXT_LIMIT`). For HTTPS servers using a private certificate authority, set `NODE_EXTRA_CA_CERTS=/path/to/ca.pem` in `~/.config/nexus/config.env`. Do not put real credentials in a project `.env`, shell history, or this example. See [Local servers](docs/LOCAL_SERVERS.md) for per-server setup and [Cloud providers](docs/CLOUD_PROVIDERS.md) for cloud provider and credential handling.\n\n## First run\n\nFrom a project directory:\n\n```sh\nnexus doctor\nnexus\n```\n\nEnter a small task, review requested actions, and inspect the reported turn outcome. On a terminal, running `nexus` with no arguments opens the live TUI; in non-interactive environments or with `nexus repl`, it opens the interactive REPL. For non-interactive tasks, run `nexus run \"<task>\"`. Use `nexus --help` and `/help` for implemented commands.\n\n### Trust your own repository\n\nBy default, an untrusted workspace opens in `review` posture, asking for your explicit confirmation before executing shell commands, file modifications, network egress, or test suites.\n\nIf this is your own repository and you want autonomous execution, trust it:\n\n```sh\nnexus trust .\n```\n\nOnce trusted, Nexus runs in `auto` posture. To force review mode regardless of trust, pass `--approve`. To run autonomously in CI or scripts without trusting the workspace permanently, pass `--yes` (or `--mode auto`, or set `NEXUS_APPROVAL_MODE=auto`).\n\nNexus reports `VERIFIED` only when its selected verifier passes and the operator has declared the product files for that task before it starts. For example: `nexus run --deliverable-file src/math.ts \"Fix the addition defect\"`; repeat `--deliverable-file` for each expected product file. The scope must use literal workspace-relative paths and cannot name tests. A passing suite without a declared scope is regression evidence (`REGRESSION_FREE`), not proof that the requested product change was verified. `UNVERIFIED`, `BLOCKED`, and `LIMIT_REACHED` remain distinct outcomes; a completed model response alone does not mean the work is correct.\n\nResuming a saved session or durable task keeps verification pending because local session and task files do not authenticate their own history. No generic verifier is currently trusted to clear that obligation after recovery: even an external test runner can execute workspace-controlled tests. A resumed task may continue, but it remains `UNVERIFIED`. Before starting a new task to establish a new baseline, the operator must review the workspace state, including ignored and untracked files and verifier/test definitions, and restore or remove any state that is not trusted. A clean Git status alone does not establish that ignored files or external acceptance inputs are trustworthy. A future verifier could replace this manual boundary only after its implementation and acceptance inputs are independently bound outside candidate control. A current-invocation `--authoritative-verifier` alone does not clear recovered obligations.\n\n## Upgrade and remove\n\nCheck whether a newer release is published:\n\n```sh\nnexus upgrade --check\n```\n\nTo upgrade in-place to the latest stable release:\n\n```sh\nnexus upgrade\n```\n\nTo target or reinstall an exact pinned version:\n\n```sh\nnexus upgrade --version v1.0.0\n```\n\nInside the interactive live TUI, run `/upgrade` or `/upgrade --check`. An upgrade requires deliberate modal confirmation before modifying the installation. In scripts or CI, non-interactive upgrades require `--yes`.\n\nAlternatively, run the installer pipeline to reinstall or upgrade:\n\n```sh\ncurl -fsSL https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh | NEXUS_VERSION=v1.0.0 sh\n```\n\nRemoval is manual and limited to Nexus-owned paths:\n\n```sh\nrm \"$HOME/.local/bin/nexus\"\nrm -rf \"$HOME/.local/lib/nexus\"\n```\n\nUser configuration, credentials, sessions, and project `.nexus` data are retained.\n\n## Build from source\n\nSee [Development and release](docs/DEVELOPMENT.md). Source builds require Rust, Cargo, Node.js 22+, npm, a C toolchain, and platform libraries. The release installer is the recommended path for supported Linux x86-64 systems.\n","display_url":"https://github.com/mikeholownych/nexus-code/blob/main/quickstart.md"}},"isError":false},"duration":{"secs":0,"nanos":677939707}},"started_at_ms":1792852042574,"completed_at_ms":1792852043254}}
{"timestamp":"2026-10-24T14:27:24.420Z","ordinal":292857,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a16e4f-2a84-7193-9969-4963ff536f0d","call_id":"call_1f0638fad40745a7811d5207d37514fd","output":[{"type":"input_text","text":"Script completed\nWall time 1.9 seconds\nOutput:\n"},{"type":"input_text","text":"{\"i\":0,\"content\":\"# Nexus Code quickstart\\n\\nNexus Code is a local coding client. It is separate from the Cloudflare Workers and Artifacts collaboration service in the contest entry.\\n\\n## Install\\n\\nOn Linux x86-64 with glibc 2.35 or newer and Node.js 22 or newer:\\n\\n```sh\\ncurl -fsSL https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh | sh\\n```\\n\\nThe installer downloads the matching versioned client archive and `SHA256SUMS` from this repository's GitHub Release, verifies the archive, and installs under `~/.local/lib/nexus`. It adds a `nexus` symlink in `~/.local/bin`; it does not edit shell startup files or use root. If `~/.local/bin` is not in `PATH`, add it yourself:\\n\\n```sh\\nexport PATH=\\\"$HOME/.local/bin:$PATH\\\"\\n```\\n\\nWithout `NEXUS_VERSION`, the installer follows the latest stable release. If no stable release has been published yet, the installer exits with a hint to select a prerelease tag from [GitHub Releases](https://github.com/mikeholownych/nexus-code/releases). To install a prerelease or pin a version, set `NEXUS_VERSION` to its published tag. The `v1.0.0-rc.1` example below works after that tag appears on [GitHub Releases](https://github.com/mikeholownych/nexus-code/releases); before then, replace it with a prerelease tag already listed there:\\n\\n```sh\\ncurl -fsSL https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh | NEXUS_VERSION=v1.0.0-rc.1 sh\\n```\\n\\nFor inspect-before-running, download [install.sh](https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh), read it, then run `sh install.sh`.\\n\\nThe release package includes the TypeScript client, production Node dependencies, `harness-core`, and the Ratatui `nexus-tui` binary. Node is an external runtime prerequisite. Current release support is limited to Linux x86-64/glibc; macOS, Windows, ARM, musl, and other architectures are not claimed.\\n\\n## Configure an inference endpoint\\n\\nNexus works with an OpenAI-compatible local endpoint such as LM Studio or vLLM. Start that server and load a model first. For example:\\n\\n```sh\\nmkdir -p \\\"$HOME/.config/nexus\\\"\\nchmod 700 \\\"$HOME/.config/nexus\\\"\\ncat > \\\"$HOME/.config/nexus/config.env\\\" <<'EOF'\\nLOCAL_LLM_ENDPOINT=http://localhost:1234/v1\\nLOCAL_LLM_MODEL=your-loaded-model\\nLOCAL_LLM_API_KEY=local\\nEOF\\nchmod 600 \\\"$HOME/.config/nexus/config.env\\\"\\n```\\n\\nUse your endpoint's actual model ID. Nexus automatically discovers the loaded context window from LM Studio (`/api/v0/models`), llama.cpp (`/props`), vLLM (`/v1/models`), and Ollama (`/api/show`), or you can override it with `--context-limit` (`NEXUS_CONTEXT_LIMIT`). For HTTPS servers using a private certificate authority, set `NODE_EXTRA_CA_CERTS=/path/to/ca.pem` in `~/.config/nexus/config.env`. Do not put real credentials in a project `.env`, shell history, or this example. See [Local servers](docs/LOCAL_SERVERS.md) for per-server setup and [Cloud providers](docs/CLOUD_PROVIDERS.md) for cloud provider and credential handling.\\n\\n## First run\\n\\nFrom a project directory:\\n\\n```sh\\nnexus doctor\\nnexus\\n```\\n\\nEnter a small task, review requested actions, and inspect the reported turn outcome. On a terminal, running `nexus` with no arguments opens the live TUI; in non-interactive environments or with `nexus repl`, it opens the interactive REPL. For non-interactive tasks, run `nexus run \\\"<task>\\\"`. Use `nexus --help` and `/help` for implemented commands.\\n\\n### Trust your own repository\\n\\nBy default, an untrusted workspace opens in `review` posture, asking for your explicit confirmation before executing shell commands, file modifications, network egress, or test suites.\\n\\nIf this is your own repository and you want autonomous execution, trust it:\\n\\n```sh\\nnexus trust .\\n```\\n\\nOnce trusted, Nexus runs in `auto` posture. To force review mode regardless of trust, pass `--approve`. To run autonomously in CI or scripts without trusting the workspace permanently, pass `--yes` (or `--mode auto`, or set `NEXUS_APPROVAL_MODE=auto`).\\n\\nNexus reports `VERIFIED` only when its selected verifier passes and the operator has declared the product files for that task before it starts. For example: `nexus run --deliverable-file src/math.ts \\\"Fix the addition defect\\\"`; repeat `--deliverable-file` for each expected product file. The scope must use literal workspace-relative paths and cannot name tests. A passing suite without a declared scope is regression evidence (`REGRESSION_FREE`), not proof that the requested product change was verified. `UNVERIFIED`, `BLOCKED`, and `LIMIT_REACHED` remain distinct outcomes; a completed model response alone does not mean the work is correct.\\n\\nResuming a saved session or durable task keeps verification pending because local session and task files do not authenticate their own history. No generic verifier is currently trusted to clear that obligation after recovery: even an external test runner can execute workspace-controlled tests. A resumed task may continue, but it remains `UNVERIFIED`. Before starting a new task to establish a new baseline, the operator must review the workspace state, including ignored and untracked files and verifier/test definitions, and restore or remove any state that is not trusted. A clean Git status alone does not establish that ignored files or external acceptance inputs are trustworthy. A future verifier could replace this manual boundary only after its implementation and acceptance inputs are independently bound outside candidate control. A current-invocation `--authoritative-verifier` alone does not clear recovered obligations.\\n\\n## Upgrade and remove\\n\\nCheck whether a newer release is published:\\n\\n```sh\\nnexus upgrade --check\\n```\\n\\nTo upgrade in-place to the latest stable release:\\n\\n```sh\\nnexus upgrade\\n```\\n\\nTo target or reinstall an exact pinned version:\\n\\n```sh\\nnexus upgrade --version v1.0.0\\n```\\n\\nInside the interactive live TUI, run `/upgrade` or `/upgrade --check`. An upgrade requires deliberate modal confirmation before modifying the installation. In scripts or CI, non-interactive upgrades require `--yes`.\\n\\nAlternatively, run the installer pipeline to reinstall or upgrade:\\n\\n```sh\\ncurl -fsSL https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh | NEXUS_VERSION=v1.0.0 sh\\n```\\n\\nRemoval is manual and limited to Nexus-owned paths:\\n\\n```sh\\nrm \\\"$HOME/.local/bin/nexus\\\"\\nrm -rf \\\"$HOME/.local/lib/nexus\\\"\\n```\\n\\nUser configuration, credentials, sessions, and project `.nexus` data are retained.\\n\\n## Build from source\\n\\nSee [Development and release](docs/DEVELOPMENT.md). Source builds require Rust, Cargo, Node.js 22+, npm, a C toolchain, and platform libraries. The release installer is the recommended path for supported Linux x86-64 systems.\\n\"}"},{"type":"input_text","text":"{\"i\":1,\"content\":\"#!/bin/sh\\nset -eu\\n\\nREPO=mikeholownych/nexus-code\\nBASE=${NEXUS_RELEASE_BASE_URL:-\\\"https://github.com/$REPO/releases\\\"}\\nVERSION=${NEXUS_VERSION:-latest}\\nPREFIX=${NEXUS_PREFIX:-\\\"$HOME/.local\\\"}\\n\\nfail() { printf 'nexus installer: %s\\\\n' \\\"$*\\\" >&2; exit 1; }\\ncase \\\"$(uname -s):$(uname -m)\\\" in\\n  Linux:x86_64|Linux:amd64) ;;\\n  *) fail \\\"unsupported system $(uname -s)/$(uname -m); supported: Linux x86-64 (glibc).\\\" ;;\\nesac\\ncommand -v node >/dev/null 2>&1 || fail \\\"Node.js 22 or newer is required; install Node.js and retry.\\\"\\nNODE_MAJOR=$(node -p 'Number(process.versions.node.split(\\\".\\\")[0])' 2>/dev/null || printf 0)\\n[ \\\"$NODE_MAJOR\\\" -ge 22 ] || fail \\\"Node.js 22 or newer is required (found $(node --version 2>/dev/null || echo unknown)).\\\"\\ncommand -v curl >/dev/null 2>&1 || fail \\\"curl is required.\\\"\\ncommand -v tar >/dev/null 2>&1 || fail \\\"tar is required.\\\"\\ncommand -v sha256sum >/dev/null 2>&1 || fail \\\"sha256sum is required.\\\"\\n\\nvalidate_tag() {\\n  printf '%s' \\\"$1\\\" | grep -Eq '^v[0-9]+\\\\.[0-9]+\\\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \\\"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\\\"\\n}\\n\\nif [ \\\"$VERSION\\\" != \\\"latest\\\" ]; then\\n  validate_tag \\\"$VERSION\\\"\\nfi\\n\\nif [ \\\"$VERSION\\\" = \\\"latest\\\" ]; then\\n  API_BASE=${NEXUS_RELEASES_API:-\\\"https://api.github.com/repos/$REPO/releases\\\"}\\n  API_TMP=$(mktemp -d \\\"${TMPDIR:-/tmp}/nexus-api.XXXXXX\\\") || fail \\\"could not create temporary directory.\\\"\\n  api_cleanup() { rm -rf \\\"$API_TMP\\\"; }\\n  trap api_cleanup EXIT HUP INT TERM\\n\\n  LATEST_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -D \\\"$API_TMP/headers\\\" -o \\\"$API_TMP/latest.json\\\" -w \\\"%{http_code}\\\" \\\"$API_BASE/latest\\\" 2>\\\"$API_TMP/curl.err\\\" || echo \\\"000\\\")\\n\\n  if [ \\\"$LATEST_CODE\\\" = \\\"200\\\" ]; then\\n    VERSION=$(sed -n 's/.*\\\"tag_name\\\"[[:space:]]*:[[:space:]]*\\\"\\\\([^\\\"]*\\\\)\\\".*/\\\\1/p' \\\"$API_TMP/latest.json\\\" | head -n 1)\\n    [ -n \\\"$VERSION\\\" ] || fail \\\"GitHub returned no stable release tag.\\\"\\n    validate_tag \\\"$VERSION\\\"\\n  elif [ \\\"$LATEST_CODE\\\" = \\\"403\\\" ]; then\\n    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \\\"$API_TMP/headers\\\" 2>/dev/null; then\\n      fail \\\"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\\\"\\n    fi\\n    fail \\\"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\\\"\\n  elif [ \\\"$LATEST_CODE\\\" = \\\"404\\\" ]; then\\n    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \\\"$API_TMP/releases.json\\\" -w \\\"%{http_code}\\\" \\\"$API_BASE?per_page=1\\\" 2>/dev/null || echo \\\"000\\\")\\n    if [ \\\"$PREREL_CODE\\\" = \\\"200\\\" ]; then\\n      PREREL_TAG=$(sed -n 's/.*\\\"tag_name\\\"[[:space:]]*:[[:space:]]*\\\"\\\\([^\\\"]*\\\\)\\\".*/\\\\1/p' \\\"$API_TMP/releases.json\\\" | head -n 1)\\n      if [ -n \\\"$PREREL_TAG\\\" ]; then\\n        fail \\\"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\\\"\\n      fi\\n    fi\\n    fail \\\"could not find latest stable release (HTTP 404 from $API_BASE/latest).\\\"\\n  else\\n    fail \\\"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\\\"\\n  fi\\n  rm -rf \\\"$API_TMP\\\"\\n  trap - EXIT HUP INT TERM\\nfi\\n\\nARCHIVE=\\\"nexus-linux-x86_64-$VERSION.tar.gz\\\"\\nNORMALIZED_VERSION=${VERSION#v}\\nURL=\\\"$BASE/download/$VERSION\\\"\\nTMP=$(mktemp -d \\\"${TMPDIR:-/tmp}/nexus-install.XXXXXX\\\") || fail \\\"could not create temporary directory.\\\"\\ncleanup() { rm -rf \\\"$TMP\\\"; }\\ntrap cleanup EXIT HUP INT TERM\\ncurl -fsSL --show-error --retry 2 \\\"$URL/$ARCHIVE\\\" -o \\\"$TMP/$ARCHIVE\\\" || fail \\\"download failed for $ARCHIVE.\\\"\\ncurl -fsSL --show-error --retry 2 \\\"$URL/SHA256SUMS\\\" -o \\\"$TMP/SHA256SUMS\\\" || fail \\\"could not download release checksums.\\\"\\ngrep -F \\\"  $ARCHIVE\\\" \\\"$TMP/SHA256SUMS\\\" > \\\"$TMP/expected.sha256\\\" || fail \\\"checksum entry for $ARCHIVE is missing.\\\"\\n(cd \\\"$TMP\\\" && sha256sum --check --status expected.sha256) || fail \\\"SHA-256 verification failed; no installation was changed.\\\"\\nARCHIVE_SHA256=$(sha256sum \\\"$TMP/$ARCHIVE\\\" | awk '{print $1}')\\n\\nif [ \\\"${NEXUS_VERIFY_ATTESTATION:-auto}\\\" != \\\"0\\\" ] && command -v gh >/dev/null 2>&1; then\\n  if gh attestation verify \\\"$TMP/$ARCHIVE\\\" -R \\\"$REPO\\\" >/dev/null 2>&1 && \\\\\\n     gh attestation verify \\\"$TMP/SHA256SUMS\\\" -R \\\"$REPO\\\" >/dev/null 2>&1; then\\n    printf 'nexus installer: verified build provenance for %s and its checksum index\\\\n' \\\"$ARCHIVE\\\"\\n  elif [ \\\"${NEXUS_VERIFY_ATTESTATION:-auto}\\\" = \\\"1\\\" ]; then\\n    fail \\\"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\\\"\\n  fi\\nfi\\n\\nVERSION_DIR=\\\"$PREFIX/lib/nexus/$VERSION\\\"\\nBIN_DIR=\\\"$PREFIX/bin\\\"\\nLINK=\\\"$BIN_DIR/nexus\\\"\\nmkdir -p \\\"$PREFIX/lib/nexus\\\" \\\"$BIN_DIR\\\"\\nif [ -e \\\"$LINK\\\" ] && [ ! -L \\\"$LINK\\\" ]; then\\n  fail \\\"$LINK exists and is not a symlink; left it unchanged.\\\"\\nfi\\nif [ -L \\\"$LINK\\\" ]; then\\n  OLD=$(readlink \\\"$LINK\\\")\\n  case \\\"$OLD\\\" in \\\"$PREFIX/lib/nexus/\\\"*) ;; *) fail \\\"$LINK points outside the Nexus installation; left it unchanged.\\\" ;; esac\\nfi\\n\\nFORCE=${NEXUS_FORCE:-0}\\nNEEDS_EXTRACT=1\\nif [ -d \\\"$VERSION_DIR\\\" ] && [ \\\"$FORCE\\\" != \\\"1\\\" ]; then\\n  if [ -x \\\"$VERSION_DIR/bin/nexus\\\" ] && \\\\\\n     [ -x \\\"$VERSION_DIR/lib/core/harness-core\\\" ] && \\\\\\n     [ -x \\\"$VERSION_DIR/lib/core/nexus-tui\\\" ] && \\\\\\n     [ \\\"$(cat \\\"$VERSION_DIR/VERSION\\\" 2>/dev/null || true)\\\" = \\\"$VERSION\\\" ]; then\\n    if [ -f \\\"$VERSION_DIR/MANIFEST.sha256\\\" ]; then\\n      if (cd \\\"$VERSION_DIR\\\" && sha256sum --check --status MANIFEST.sha256 2>/dev/null); then\\n        NEEDS_EXTRACT=0\\n      fi\\n      if [ \\\"$NEEDS_EXTRACT\\\" = \\\"0\\\" ]; then\\n        if ! node - \\\"$VERSION_DIR/.provenance.json\\\" \\\"$ARCHIVE_SHA256\\\" <<'NODE'\\nconst fs = require(\\\"node:fs\\\");\\nconst [file, archiveSha256] = process.argv.slice(2);\\ntry {\\n  const record = JSON.parse(fs.readFileSync(file, \\\"utf8\\\"));\\n  if (record.archiveSha256 !== archiveSha256) process.exit(1);\\n} catch { process.exit(1); }\\nNODE\\n        then\\n          NEEDS_EXTRACT=1\\n        fi\\n      fi\\n    fi\\n  fi\\nfi\\n\\nif [ \\\"$NEEDS_EXTRACT\\\" = \\\"1\\\" ]; then\\n  mkdir -p \\\"$TMP/unpack\\\"\\n  tar -xzf \\\"$TMP/$ARCHIVE\\\" -C \\\"$TMP/unpack\\\" || fail \\\"archive extraction failed.\\\"\\n  PACKAGE=\\\"$TMP/unpack/nexus\\\"\\n  [ -x \\\"$PACKAGE/bin/nexus\\\" ] && [ -x \\\"$PACKAGE/lib/core/harness-core\\\" ] && [ -x \\\"$PACKAGE/lib/core/nexus-tui\\\" ] && [ \\\"$(cat \\\"$PACKAGE/VERSION\\\" 2>/dev/null || true)\\\" = \\\"$VERSION\\\" ] || fail \\\"release archive is incomplete or has a mismatched version.\\\"\\n  if [ -f \\\"$PACKAGE/MANIFEST.sha256\\\" ]; then\\n    (cd \\\"$PACKAGE\\\" && sha256sum --check --status MANIFEST.sha256) || fail \\\"release archive failed manifest checksum verification.\\\"\\n  fi\\n  PACKAGE_VERSION_OUTPUT=$(\\\"$PACKAGE/bin/nexus\\\" --version 2>&1) || fail \\\"release binary failed its pre-install self-test.\\\"\\n  PACKAGE_VERSION_REPORTED=$(printf '%s\\\\n' \\\"$PACKAGE_VERSION_OUTPUT\\\" | sed -n '1s/[[:space:]].*$//p')\\n  [ \\\"$PACKAGE_VERSION_REPORTED\\\" = \\\"$NORMALIZED_VERSION\\\" ] || fail \\\"release binary reported version '$PACKAGE_VERSION_REPORTED' instead of '$NORMALIZED_VERSION' during self-test.\\\"\\n  if [ -f \\\"$PACKAGE/compatibility.json\\\" ]; then\\n    node - \\\"$PACKAGE/compatibility.json\\\" \\\"$VERSION\\\" \\\"$ARCHIVE\\\" <<'NODE' || fail \\\"release compatibility metadata is invalid or mismatched.\\\"\\nconst fs = require(\\\"node:fs\\\");\\nconst [file, version, archive] = process.argv.slice(2);\\nconst data = JSON.parse(fs.readFileSync(file, \\\"utf8\\\"));\\nconst asset = data.platforms?.[\\\"linux-x86_64\\\"];\\nconst compatible = data.schemaVersion === 1 && data.product === \\\"nexus-code\\\" &&\\n  data.version === version.replace(/^v/, \\\"\\\") &&\\n  typeof data.revision === \\\"string\\\" && /^[a-f0-9]{7,64}$/i.test(data.revision) &&\\n  typeof data.builtAt === \\\"string\\\" && !Number.isNaN(Date.parse(data.builtAt)) &&\\n  asset?.archive === archive && asset.os === \\\"linux\\\" && asset.arch === \\\"x86_64\\\" &&\\n  data.compatibility && Number.isSafeInteger(data.compatibility.configSchemaVersion) &&\\n  Number.isSafeInteger(data.compatibility.stateSchemaVersion) &&\\n  Number.isSafeInteger(data.compatibility.minSupportedConfigVersion) &&\\n  Number.isSafeInteger(data.compatibility.minSupportedStateVersion) &&\\n  data.compatibility.minSupportedConfigVersion <= data.compatibility.configSchemaVersion &&\\n  data.compatibility.minSupportedStateVersion <= data.compatibility.stateSchemaVersion;\\nif (!compatible) process.exit(1);\\nNODE\\n  fi\\n  rm -rf \\\"$VERSION_DIR\\\"\\n  mv \\\"$PACKAGE\\\" \\\"$VERSION_DIR\\\"\\nfi\\nnode - \\\"$VERSION_DIR/compatibility.json\\\" \\\"$VERSION\\\" \\\"$PREFIX\\\" \\\"$VERSION_DIR\\\" \\\"$LINK\\\" \\\"$ARCHIVE\\\" \\\"$ARCHIVE_SHA256\\\" \\\"$VERSION_DIR/.provenance.json\\\" <<'NODE'\\nconst fs = require(\\\"node:fs\\\");\\nconst [metadataPath, version, prefix, installedPath, binPath, archive, archiveSha256, output] = process.argv.slice(2);\\nlet metadata = null;\\ntry { metadata = JSON.parse(fs.readFileSync(metadataPath, \\\"utf8\\\")); } catch {}\\nconst record = {\\n  formatVersion: 1,\\n  method: \\\"installer\\\",\\n  product: \\\"nexus-code\\\",\\n  version,\\n  ...(metadata?.revision ? { revision: metadata.revision } : {}),\\n  ...(metadata?.builtAt ? { builtAt: metadata.builtAt } : {}),\\n  prefix,\\n  installedPath,\\n  binPath,\\n  managed: true,\\n  archive,\\n  archiveSha256,\\n};\\nfs.writeFileSync(output, `${JSON.stringify(record, null, 2)}\\\\n`, { mode: 0o644 });\\nfs.chmodSync(output, 0o644);\\nNODE\\nNEXT=\\\"$BIN_DIR/.nexus-link.$$\\\"\\nln -s \\\"$VERSION_DIR/bin/nexus\\\" \\\"$NEXT\\\"\\nmv -f \\\"$NEXT\\\" \\\"$LINK\\\"\\nprintf 'Installed Nexus Code %s in %s\\\\n' \\\"$VERSION\\\" \\\"$VERSION_DIR\\\"\\ncase \\\":$PATH:\\\" in *\\\":$BIN_DIR:\\\"*) ;; *) printf 'Add this to your shell profile if needed: export PATH=\\\"%s:$PATH\\\"\\\\n' \\\"$BIN_DIR\\\" ;; esac\\n\\\"$LINK\\\" --version\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16e48-57ed-79c2-bd99-946dbd9156e1","create_time":1792852044.4203987}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
