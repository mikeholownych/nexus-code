Status\":\"CLEAN\",\"number\":113,\"reviewDecision\":\"\",\"title\":\"build(deps): bump serde_json from 1.0.151 to 1.0.154 in /core\",\"updatedAt\":\"2026-10-21T16:08:12Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/113\"}\n{\"baseRefName\":\"main\",\"checks\":[{\"conclusion\":\"SUCCESS\",\"name\":\"test-matrix (22)\",\"status\":\"COMPLETED\"},{\"conclusion\":\"SUCCESS\",\"name\":\"javascript-typescript\",\"status\":\"COMPLETED\"},{\"conclusion\":\"SUCCESS\",\"name\":\"test-matrix (24)\",\"status\":\"COMPLETED\"},{\"conclusion\":\"SUCCESS\",\"name\":\"linux-x86_64\",\"status\":\"COMPLETED\"},{\"conclusion\":\"SUCCESS\",\"name\":\"CodeQL\",\"status\":\"COMPLETED\"},{\"conclusion\":null,\"name\":null,\"status\":null}],\"headRefName\":\"dependabot/github_actions/actions/setup-node-7.1.0\",\"mergeStateStatus\":\"CLEAN\",\"number\":112,\"reviewDecision\":\"\",\"title\":\"build(deps): bump actions/setup-node from 4.4.0 to 7.1.0\",\"updatedAt\":\"2026-10-24T04:23:43Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/112\"}\n{\"baseRefName\":\"main\",\"checks\":[{\"conclusion\":\"FAILURE\",\"name\":\"test-matrix (20)\",\"status\":\"COMPLETED\"},{\"conclusion\":\"SUCCESS\",\"name\":\"javascript-typescript\",\"status\":\"COMPLETED\"},{\"conclusion\":\"FAILURE\",\"name\":\"test-matrix (22)\",\"status\":\"COMPLETED\"},{\"conclusion\":\"FAILURE\",\"name\":\"test-matrix (24)\",\"status\":\"COMPLETED\"},{\"conclusion\":\"SKIPPED\",\"name\":\"linux-x86_64\",\"status\":\"COMPLETED\"},{\"conclusion\":\"SUCCESS\",\"name\":\"CodeQL\",\"status\":\"COMPLETED\"},{\"conclusion\":null,\"name\":null,\"status\":null}],\"headRefName\":\"dependabot/npm_and_yarn/cli/dotenv-18.0.8\",\"mergeStateStatus\":\"BLOCKED\",\"number\":111,\"reviewDecision\":\"\",\"title\":\"build(deps): bump dotenv from 16.6.1 to 18.0.8 in /cli\",\"updatedAt\":\"2026-10-21T16:04:30Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/111\"}\n{\"baseRefName\":\"main\",\"checks\":[{\"conc