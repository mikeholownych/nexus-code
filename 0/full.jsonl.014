heck was cancelled.`), durationMs: Date.now() - started }];\n1130:  if (options.timeoutMs !== undefined && !(Number.isFinite(options.timeoutMs) && options.timeoutMs > 0)) {\n1131:    throw new Error(`--timeout must be a positive number of milliseconds (got ${String(options.timeoutMs)})`);\n1133:  // Checks are deliberately started together. Each `runCheck` owns two one-shot\n1149:    deep: Boolean(options.deep),\n1151:    timeoutMs: options.timeoutMs ?? DEFAULT_TIMEOUT_MS,\n1152:    timeoutOverride: options.timeoutMs !== undefined,\n1156:    results = await Promise.all(CHECKS.map(([name, check]) => runCheck(name, check, ctx, signal)));\n1161:  if (ctx.unlistedModel && ctx.deepModelVerified) {\n1165:      availability.explanation = `The configured model ${ctx.unlistedModel} is not listed by the endpoint, but a successful --deep inference probe verified that it is available.`;\n1166:      availability.evidence.push(\"verified by one successful deep inference request\");\n1189:    deep: ctx.deep,\n1201:  return Boolean(value && typeof value === \"object\" && (\"config\" in (value as any) || \"configError\" in (value as any) || \"context\" in (value as any) || \"deep\" in (value as any) || \"home\" in (value as any) || \"timeoutMs\" in (value as any)));\n1399:  out.push(`Nexus doctor ${report.nexusVersion} — ${report.context === \"session\" ? \"active session configuration\" : \"fresh CLI configuration\"}${report.deep ? \" (deep)\" : \"\"}`);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","create_time":1792828427.9322617}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
