{"timestamp":"2026-10-24T13:41:38.652Z","ordinal":290792,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16e23-3d1b-7571-9aa1-825e60ce3175","item":{"type":"CommandExecution","id":"exec-008e18b9-7780-4cfd-a561-81153492ebad","process_id":"17500","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice status --short --branch; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice rev-parse HEAD; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice diff --stat origin/main...HEAD; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice log --oneline --decorate origin/main..HEAD; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice diff --unified=3 origin/main...HEAD -- cli/src cli/test | head -260"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice status --short --branch; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice rev-parse HEAD; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice diff --stat origin/main...HEAD; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice log --oneline --decorate origin/main..HEAD; git -C /home/mike/nexus-wt/defect-checkpoint-sensitive-choice diff --unified=3 origin/main...HEAD -- cli/src cli/test | head -260"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"## v1/defect-checkpoint-sensitive-choice...origin/main [ahead 2, behind 15]\n518c71f5a91de57c85c572584ee61ffddd30f7d1\n cli/src/repl.ts                                    |  1 +\n cli/src/sidecar.ts                                 |  2 ++\n cli/test/repl_checkpoint_choices.test.ts           | 13 ++++++++-\n cli/test/sidecar.test.ts                           | 27 ++++++++++++++++++\n .../defect-checkpoint-sensitive-choice/README.md   | 32 ++++++++++++++++++++++\n 5 files changed, 74 insertions(+), 1 deletion(-)\n518c71f (HEAD -> v1/defect-checkpoint-sensitive-choice) docs: record checkpoint mode restoration evidence\ncac400e fix(cli): restore mode after checkpoint-free turn\ndiff --git a/cli/src/repl.ts b/cli/src/repl.ts\nindex fbdfb81..5734291 100644\n--- a/cli/src/repl.ts\n+++ b/cli/src/repl.ts\n@@ -199,6 +199,7 @@ export class InteractiveRepl {\n         return true;\n       }\n       if (choice === \"2\") {\n+        this.agent.setCheckpointReadOnlyFallback(false);\n         console.log(pc.yellow(\"Continuing in the current mode without a rollback checkpoint.\\n\"));\n         return true;\n       }\ndiff --git a/cli/src/sidecar.ts b/cli/src/sidecar.ts\nindex cff83d5..5a1437a 100644\n--- a/cli/src/sidecar.ts\n+++ b/cli/src/sidecar.ts\n@@ -553,6 +553,8 @@ export class SidecarServer {\n             this.emit({ type: \"notice\", text: \"Continuing this turn in read-only mode as requested. Workspace changes, unsafe commands, external actions, and delegation are disabled.\" });\n             this.emitSessionState();\n           } else if (choice === \"without_checkpoint\") {\n+            agent.setCheckpointReadOnlyFallback(false);\n+            this.emitSessionState();\n             this.emit({ type: \"notice\", text: \"Continuing in the current mode without a rollback checkpoint, as requested.\" });\n           } else if (choice === \"allow_sensitive\") {\n             allowSensitiveCheckpoint = true;\ndiff --git a/cli/test/repl_checkpoint_choices.test.ts b/cli/test/repl_checkpoint_choices.test.ts\nindex eb2b6c1..817dd10 100644\n--- a/cli/test/repl_checkpoint_choices.test.ts\n+++ b/cli/test/repl_checkpoint_choices.test.ts\n@@ -44,7 +44,7 @@ test(\"REPL asks how to proceed when sensitive content blocks a turn checkpoint\",\n     const proceed = await (repl as any).prepareTurnCheckpoint(\"Turn: protected workspace\");\n     assert.equal(proceed, expectedProceed, `choice ${choice} proceed disposition`);\n     assert.deepEqual(prompts, [\"Choice [1-5]: \"]);\n-    assert.deepEqual(fallback, expectedFallback ? [true] : (choice === \"2\" || choice === \"4\" || choice === \"5\" ? [] : [false]));\n+    assert.deepEqual(fallback, expectedFallback ? [true] : (choice === \"4\" || choice === \"5\" ? [] : [false]));\n     assert.equal(sensitiveRetry, expectedSensitiveRetry, `choice ${choice} sensitive checkpoint retry`);\n   }\n });\n@@ -79,3 +79,14 @@ test(\"REPL uses read-only for the current turn and resumes after a later safe ch\n   assert.equal(checkpointsAfterChoice, 1, \"the later turn starts only after its safe checkpoint succeeds\");\n   assert.deepEqual(fallback, [true, false], \"configured mode resumes only after the successful checkpoint\");\n });\n+\n+test(\"REPL restores the configured mode when a later turn continues without a checkpoint\", async () => {\n+  const { repl, fallback } = makeRepl(\"1\");\n+  const answers = [\"1\", \"2\"];\n+  repl.rl.question = async () => answers.shift()!;\n+  repl.checkpointManager.createCheckpoint = () => { throw new SensitivePersistenceError(\"checkpoint\"); };\n+\n+  assert.equal(await (repl as any).prepareTurnCheckpoint(\"Turn: first sensitive workspace\"), true);\n+  assert.equal(await (repl as any).prepareTurnCheckpoint(\"Turn: still sensitive workspace\"), true);\n+  assert.deepEqual(fallback, [true, false]);\n+});\ndiff --git a/cli/test/sidecar.test.ts b/cli/test/sidecar.test.ts\nindex ff68f5d..73b24aa 100644\n--- a/cli/test/sidecar.test.ts\n+++ b/cli/test/sidecar.test.ts\n@@ -431,6 +431,33 @@ describe(\"SidecarServer: sessions and slash commands\", () => {\n     });\n   });\n \n+  test(\"continuing without a later checkpoint restores the configured mode\", async () => {\n+    const replies = (n: number): Reply => n === 2\n+      ? { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"allowed.txt\", content: \"configured mode restored\" } }] }\n+      : { kind: \"text\", content: \"Turn complete.\" };\n+    await withSidecar(replies, \"review\", async ({ server, events, repo, send }) => {\n+      fs.writeFileSync(path.join(repo, \"base.txt\"), `changed ${`ghp_${\"G\".repeat(36)}`}\\n`);\n+\n+      await send({ type: \"prompt.submit\", id: \"t-read-only\", text: \"first sensitive turn\" });\n+      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\n+      let request = events.findLast((event) => event.type === \"checkpoint.choice.request\");\n+      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"read_only\" });\n+      await server.idle();\n+      assert.equal(events.filter((event) => event.type === \"session.state\").at(-1)?.mode, \"read-only\");\n+\n+      await send({ type: \"prompt.submit\", id: \"t-without-checkpoint\", text: \"second sensitive turn\" });\n+      await waitUntil(() => events.filter((event) => event.type === \"checkpoint.choice.request\").length === 2);\n+      request = events.findLast((event) => event.type === \"checkpoint.choice.request\");\n+      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"without_checkpoint\" });\n+      assert.equal(events.filter((event) => event.type === \"session.state\").at(-1)?.mode, \"review\");\n+      const approval = await waitForEvent(events, (event) => event.type === \"approval.request\" && event.turn_id === \"t-without-checkpoint\");\n+      await send({ type: \"approve\", id: approval.id });\n+      await server.idle();\n+\n+      assert.equal(fs.readFileSync(path.join(repo, \"allowed.txt\"), \"utf8\"), \"configured mode restored\");\n+    });\n+  });\n+\n   test(\"checkpoint choice rejects unknown actions\", async () => {\n     await withSidecar(() => ({ kind: \"text\", content: \"Review started.\" }), \"review\", async ({ server, events, repo, app, send }) => {\n       fs.writeFileSync(path.join(repo, \"base.txt\"), `changed ${`ghp_${\"C\".repeat(36)}`}\\n`);\n","exit_code":0,"duration":{"secs":0,"nanos":32155}},"started_at_ms":1792849298651,"completed_at_ms":1792849298652}}
