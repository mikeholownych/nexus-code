istory accurately.\n--\n1500-  }\n1501-\n1502-  public async initExtensibility(): Promise<void> {\n1503-    if (this.extensibilityInitialized) return;\n1504-    try {\n1505-      await this.pluginManager.loadPlugins();\n1506-      await this.mcpManager.loadAndConnect();\n1507-      this.extensibilityInitialized = true;\n1508:      const skipped = untrustedWorkspaceExtensions(this.config.workspace, this.config.readOnly);\n1509-      if (skipped.length && this.depth === 0) {\n1510-        const names = skipped.map((file) => path.relative(this.config.workspace, file)).join(\", \");\n1511-        const text = this.config.readOnly\n1512-          ? `Workspace MCP servers and plugins are not loaded in read-only mode (${names}).`\n1513:          : `Workspace MCP servers and plugins are not loaded because this workspace is not trusted (${names}). Run \\`nexus trust\\` in it to allow them.`;\n1514-        if (this.observer?.onNotice) this.observer.onNotice(text);\n1515-        else console.warn(pc.yellow(text));\n1516-      }\n1517-    } catch {\nfatal: path 'cli/test/agent_prompt.test.ts' exists on disk, but not in 'origin/main'\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16e19-0589-7f73-b64e-a1d03ef4175b","create_time":1792849128.4055476}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
