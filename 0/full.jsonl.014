] + plan[\"sidecar_args\"]\n    turns = lambda: count_events(events, \"turn.result\")  # noqa: E731\n\n    def shot(session, name):\n        shots.append(session.color.snapshot(name))\n        result.setdefault(\"screens\", {})[name] = session.color.lines()\n\n    s = DiffSession(argv, env, 120, 36, cast)\n    s.wait_text(\"enter send\", 30)\n    s.pump(0.4)\n    shot(s, \"01-startup\")\n\n    # Streamed Markdown; scroll back while it streams, then return.\n    s.send(\"Explain the plan for the cache layer.\\r\", settle=0.1)\n    s.wait_screen(lambda lines: has(lines, \"Cache layer plan\"), 15, \"streamed heading\")\n    s.pump(0.6)\n    shot(s, \"02-streaming\")\n    wait_events(events, \"turn.result\", 1, 30, s)\n    s.wait_idle()\n    s.pump(0.3)\n    shot(s, \"03-markdown-final\")\n\n    # Slow inference, then tools: read, failed read, large command output, an edit; steering while busy.\n    s.send(\"Inspect the repository and add the cache module.\\r\", settle=0.1)\n    s.pump(1.2)\n    shot(s, \"04-slow-inference\")\n    s.send(\"prefer an LRU policy\\r\", settle=0.2)\n    s.pump(0.3)\n    shot(s, \"05-steering-queued\")\n    # Scroll back while output keeps arriving.\n    s.send(\"\\x1b[5~\", settle=0.3)\n    before_scroll = s.color.lines()[1:-3]\n    wait_events(events, \"tool.end\", 3, 30, s)\n    s.pump(0.5)\n    result[\"scroll_kept\"] = s.color.lines()[1:-3] == before_scroll\n    shot(s, \"06-scrolled-back-new-output\")\n    s.send(\"\\x1b[6~\" * 8, settle=0.3)\n    wait_events(events, \"turn.result\", 2, 60, s)\n    s.wait_idle()\n    s.pump(0.3)\n    shot(s, \"07-tools-final\")\n\n    # A multi-line paste, inspected, then sent.\n    s.send(\"\\x1b[200~line one of the note\\r\\n\\tindented line ✓ 字\\r\\nline three\\x1b[201~\", settle=0.4)\n    shot(s, \"08-paste-buffer\")\n    s.send(\"\\x0f\", settle=0.4)  # ctrl+o\n    shot(s, \"09-paste-view\")\n    s.send(\"\\x1b\", settle=0.3)\n    s.send(\"\\r\", settle=0.2)\n    wait_events(events, \"turn.result\", 3, 30, s)\n    s.wait_idle()\n\n    # Review mode: an approval; keys typed just before it opens must not answer it.\n    s.send(\"/mode review\\r\", settle=0.5)\n    s.send(\"Write the config file.\\r\", settle=0.05)\n    s.send(\"yyy\", settle=0.05)\n    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 20, \"the approval modal\")\n    s.pump(0.9)  # a pause in typing before the deliberate decision\n    shot(s, \"10-approval\")\n    result[\"approval_survived_buffered_keys\"] = has(s.color.lines(), \"Approval needed\")\n    # Keys were typed just before it opened, so its letters are not answers: ← selects Approve, Enter confirms.\n    result[\"letters_disarmed_hint\"] = any(\"typing ignored\" in l for l in s.color.lines())\n    s.send(\"\\x1b[D\", settle=2.2)  # on a typed-into panel the choice stays on screen 2 s before Enter takes it\n    s.send(\"\\r\", settle=0.6)  # where letters are off, approving takes Enter twice\n    s.send(\"\\r\", settle=0.4)\n    wait_events(events, \"turn.result\", 4, 30, s)\n    s.wait_idle()\n    result[\"draft_after_approval\"] = s.color.lines()[-1]\n    s.send(\"\\x0c\", settle=0.2)  # the buffered keys stayed in the draft: clear it\n    s.send(\"/mode auto\\r\", settle=0.5)\n\n    # Cancellation during a slow step.\n    s.send(\"Take a long time on this.\\r\", settle=0.1)\n    s.pump(1.5)\n    s.send(\"\\x1b\", settle=0.1)\n    wait_events(events, \"turn.result\", 5, 30, s)\n    s.wait_idle()\n    s.pump(0.3)\n    shot(s, \"11-cancelled\")\n\n    # Compaction.\n    s.send(\"/compact\\r\", settle=0.3)\n    s.wait_screen(lambda lines: has(lines, \"ompact\"), 20, \"compaction output\")\n    s.pump(0.6)\n    s.wait_idle()\n    shot(s, \"12-compacted\")\n\n    # Incomplete requirements (numbered list typed with shift-less newlines via alt+enter).\n#!/usr/bin/env python3\n\"\"\"Approval input safety in the real `nexus-tui --live` (review mode, real sidecar). Prints a JSON summary of which\ninputs reached the sidecar as decisions; the node test (tui_approval_input_e2e.test.ts) asserts on it and on the\nsidecar's command log.\n\n1. Queued input: the TUI is frozen (SIGSTOP) while the approval request arrives and `y⏎` is typed; it is resumed\n   after the grace period has passed. The queued keys must not decide.\n2. A burst `yyy` typed at once, long after the panel appeared, must not decide.\n3. A bracketed paste of `y⏎` must not decide.\n4. After keys were typed into that panel, `n` is text; Esc denies. The next approval appears to an operator who is\n   not typing, and one deliberate `y` approves it.\n5. Typing that continues across the third panel's appearance never decides, nor does `n` after a pause; Esc denies.\n\nUsage: tui_approval_driver.py PLAN.json\n\"\"\"\nimport json\nimport os\nimport signal\nimport sys\nimport time\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom tui_diff_driver import DiffSession, has  # noqa: E402\nfrom tui_pty_driver import count_events, pty_env, wait_events  # noqa: E402\n\n\ndef decisions(path):\n    try:\n        with open(path) as f:\n            return [json.loads(line)[\"type\"] for line in f if '\"type\":\"approve\"' in line or '\"type\":\"deny\"' in line]\n    except FileNotFoundError:\n        return []\n\n\ndef main():\n    plan = json.load(open(sys.argv[1]))\n    env = pty_env(plan[\"env\"])\n    events, commands = plan[\"env\"][\"NEXUS_RECORD_EVENTS\"], plan[\"env\"][\"NEXUS_RECORD_COMMANDS\"]\n    argv = [plan[\"tui\"], \"--live\", \"--sidecar\", plan[\"recorder\"], \"--node\", plan[\"node\"], \"--\"] + plan[\"sidecar_args\"]\n    result = {}\n    s = DiffSession(argv, env, 100, 30, None)\n    s.wait_text(\"enter send\", 30)\n    s.pump(0.3)\n\n    # 1. Freeze the TUI, let the approval arrive and type into the frozen terminal, resume after the grace period.\n    s.send(\"Write the first file.\\r\", settle=0.2)\n    os.kill(s.pid, signal.SIGSTOP)\n    deadline = time.monotonic() + 20\n    while count_events(events, \"approval.request\") < 1 and time.monotonic() < deadline:\n        time.sleep(0.05)\n    result[\"approval_arrived_while_frozen\"] = count_events(events, \"approval.request\") >= 1\n    os.write(s.fd, b\"y\\r\")\n    time.sleep(1.2)\n    os.kill(s.pid, signal.SIGCONT)\n    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 10, \"the approval panel\")\n    s.pump(1.0)\n    result[\"after_queued_keys\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\n\n    # 2. A burst long after the panel appeared.\n    s.send(\"yyy\", settle=0.8)\n    result[\"after_burst\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\n\n    # 3. A bracketed paste.\n    s.send(\"\\x1b[200~y\\r\\x1b[201~\", settle=0.8)\n    result[\"after_paste\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\n\n    # 4. Keys were typed into this panel (the burst), so its letters are not answers: Esc denies. The pause lets the\n    # next approval appear to an operator who is not typing, where one deliberate `y` approves.\n    s.send(\"n\", settle=0.3)\n    result[\"n_after_typing\"] = decisions(commands)\n    s.pump(2.2)\n    s.send(\"\\x1b\", settle=0.5)\n    result[\"after_deny\"] = decisions(commands)\n    wait_events(events, \"approval.request\", 2, 20, s)\n    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 10, \"the second approval panel\")\n    s.pump(1.8)  # the next panel takes keys 1.5 s after the previous decision\n    s.send(\"y\", settle=0.5)\n    result[\"after_approve\"] = decisions(commands)\n\n    # 5. Typing that continues across the third approval panel's appearance never decides.\n    typed = \"please add tests and then run them now\"\n    seen_while_typing = False\n    for ch in typed:\n        s.send(ch, settle=0.1)\n        seen_while_typing = seen_while_typing or has(s.color.lines(), \"Approval needed\")\n    result[\"panel_seen_while_typing\"] = seen_while_typing\n    # The third request can arrive late on a loaded host: wait for its panel before checking (nothing may decide).\n    wait_events(events, \"approval.request\", 3, 20, s)\n    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 10, \"the third approval panel\")\n    s.pump(0.2)\n    result[\"after_typing_across\"] = {\"decisions\": decisions(commands), \"panel_open\": has(s.color.lines(), \"Approval needed\")}\n    s.pump(1.0)\n    s.send(\"n\", settle=0.5)\n    result[\"n_after_typing_across\"] = decisions(commands)\n    s.send(\"\\x1b\", settle=0.5)\n    result[\"after_typing_then_deny\"] = decisions(commands)\n    wait_events(events, \"turn.result\", 1, 30, s)\n    s.wait_idle()\n    result[\"transcript\"] = s.color.lines()\n    s.send(\"\\x03\", settle=0.1)\n    result[\"exit\"] = s.wait_exit(20)\n    print(json.dumps(result))\n\n\nif __name__ == \"__main__\":\n    main()\n## v1/startup-workspace-trust...origin/v1/startup-workspace-trust\nlinux-x86_64\tpending\t0\thttps://github.com/mikeholownych/nexus-code/actions/runs/40077862009/job/120831473641\t\nCodeQL\tpass\t2s\thttps://github.com/mikeholownych/nexus-code/runs/120825283059\t\nCodeRabbit\tpass\t0\t\tReview skipped: manual review required for this OSS repository\njavascript-typescript\tpass\t1m26s\thttps://github.com/mikeholownych/nexus-code/actions/runs/40077862158/job/120825029890\t\ntest-matrix (22)\tpass\t15m9s\thttps://github.com/mikeholownych/nexus-code/actions/runs/40077862009/job/120831474540\t\ntest-matrix (24)\tpass\t15m11s\thttps://github.com/mikeholownych/nexus-code/actions/runs/40077862009/job/120831475008\t\nlinux-x86_64\tpending\t0\thttps://github.com/mikeholownych/nexus-code/actions/runs/40078369394/job/120829697889\t\nCodeQL\tpass\t2s\thttps://github.com/mikeholownych/nexus-code/runs/120826749082\t\nCodeRabbit\tpass\t0\t\tReview skipped: manual review required for this OSS repository\njavascript-typescript\tpass\t1m17s\thttps://gith