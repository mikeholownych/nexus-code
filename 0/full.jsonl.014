\",\n  \"install:cli\": \"npm --prefix cli install\",\n  \"setup\": \"npm run install:cli && npm run build\",\n  \"harness\": \"node cli/dist/index.js\",\n  \"check\": \"node cli/dist/index.js check\",\n  \"models\": \"node cli/dist/index.js models\",\n  \"security-scan\": \"bash scripts/security_gates.sh\",\n  \"audit\": \"npm --prefix cli audit\",\n  \"sbom\": \"bash scripts/generate_sbom.sh\"\n}\n## v1/rc4-notes-startup-trust...origin/main\n M docs/releases/v1.0.0-rc.4.md\n","exit_code":0,"duration":{"secs":1,"nanos":784298345}},"started_at_ms":1792835913286,"completed_at_ms":1792835915071}}
