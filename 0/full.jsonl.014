{"timestamp":"2026-10-24T13:36:30.154Z","ordinal":290499,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16e19-0589-7f73-b64e-a1d03ef4175b","item":{"type":"CommandExecution","id":"exec-bc043c78-f646-404f-b3b0-d595b4b82ba3","process_id":"36825","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/mcp-proto-name status --short --branch && git -C /home/mike/nexus-wt/mcp-proto-name log -1 --oneline && git -C /home/mike/nexus-wt/mcp-proto-name show --stat --oneline --decorate HEAD && git -C /home/mike/nexus-wt/mcp-proto-name show --format=fuller --find-renames HEAD -- cli/src/mcp.ts cli/test/mcp.test.ts && cat /home/mike/nexus-code/.git/nexus-claims/DEFECT_MCP_PROTO_NAME_20261024/owner.json"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/mcp-proto-name status --short --branch && git -C /home/mike/nexus-wt/mcp-proto-name log -1 --oneline && git -C /home/mike/nexus-wt/mcp-proto-name show --stat --oneline --decorate HEAD && git -C /home/mike/nexus-wt/mcp-proto-name show --format=fuller --find-renames HEAD -- cli/src/mcp.ts cli/test/mcp.test.ts && cat /home/mike/nexus-code/.git/nexus-claims/DEFECT_MCP_PROTO_NAME_20261024/owner.json"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"## v1/defect-mcp-proto-name\n6f6caa8 fix(mcp): persist proto-named servers safely\n6f6caa8 (HEAD -> v1/defect-mcp-proto-name) fix(mcp): persist proto-named servers safely\n cli/src/mcp.ts       | 10 +++++++++-\n cli/test/mcp.test.ts | 25 +++++++++++++++++++++++--\n 2 files changed, 32 insertions(+), 3 deletions(-)\ncommit 6f6caa878a193725a62735d6bb10bc862aa485d1\nAuthor:     Mike Holownych <mike@holownych.com>\nAuthorDate: Sat Oct 24 13:36:10 2026 +0000\nCommit:     Mike Holownych <mike@holownych.com>\nCommitDate: Sat Oct 24 13:36:10 2026 +0000\n\n    fix(mcp): persist proto-named servers safely\n\ndiff --git a/cli/src/mcp.ts b/cli/src/mcp.ts\nindex a44bf8f..1bad168 100644\n--- a/cli/src/mcp.ts\n+++ b/cli/src/mcp.ts\n@@ -639,7 +639,15 @@ export class McpClientManager {\n         ) {\n           throw new Error(`${configFile}: mcpServers is not an object; left untouched`);\n         }\n-        existing.mcpServers[name] = config;\n+        // Assignment to the special `__proto__` key mutates an ordinary object's prototype\n+        // instead of creating a JSON property. Define an own data property so every valid\n+        // server name is persisted without changing the map's prototype.\n+        Object.defineProperty(existing.mcpServers, name, {\n+          value: config,\n+          enumerable: true,\n+          configurable: true,\n+          writable: true,\n+        });\n         // Write a private temporary file, then replace the target atomically (following an existing symlink target).\n         fs.writeFileSync(temp, JSON.stringify(existing, null, 2) + \"\\n\", { encoding: \"utf-8\", mode: 0o600 });\n         fs.chmodSync(temp, 0o600);\ndiff --git a/cli/test/mcp.test.ts b/cli/test/mcp.test.ts\nindex a1881c7..d57ddbe 100644\n--- a/cli/test/mcp.test.ts\n+++ b/cli/test/mcp.test.ts\n@@ -48,8 +48,8 @@ function configPaths(home: string): { dir: string; file: string } {\n   return { dir, file: path.join(dir, \"mcp.json\") };\n }\n \n-function connectFake(manager: McpClientManager, server: string) {\n-  return manager.addServer(\"fake\", {\n+function connectFake(manager: McpClientManager, server: string, name = \"fake\") {\n+  return manager.addServer(name, {\n     command: process.execPath,\n     args: [server],\n     env: { FAKE_TOKEN: \"s3cr3t-value\" },\n@@ -83,6 +83,27 @@ describe(\"MCP server configuration persistence\", () => {\n     });\n   });\n \n+  test(\"persists a server named __proto__ as an own JSON property\", async () => {\n+    await withHome(async (home, server) => {\n+      const { dir, file } = configPaths(home);\n+      fs.mkdirSync(dir, { recursive: true });\n+\n+      const manager = new McpClientManager(home);\n+      try {\n+        const result = await connectFake(manager, server, \"__proto__\");\n+        assert.equal(result.success, true);\n+        assert.equal(result.persisted, true, `persist result: ${JSON.stringify(result)}`);\n+\n+        const saved = JSON.parse(fs.readFileSync(file, \"utf8\"));\n+        assert.equal(Object.hasOwn(saved.mcpServers, \"__proto__\"), true);\n+        assert.equal(saved.mcpServers[\"__proto__\"].command, process.execPath);\n+        assert.deepEqual(Object.keys(saved.mcpServers), [\"__proto__\"]);\n+      } finally {\n+        manager.shutdownAll();\n+      }\n+    });\n+  });\n+\n   test(\"refuses to replace an unparseable config instead of dropping its servers\", async () => {\n     await withHome(async (home, server) => {\n       const { dir, file } = configPaths(home);\n{\"agent\":\"codex-root\",\"branch\":\"v1/defect-mcp-proto-name\",\"since\":\"2026-10-24T13:35:33Z\",\"pid\":3424031}\n","exit_code":0,"duration":{"secs":0,"nanos":27560}},"started_at_ms":1792848990153,"completed_at_ms":1792848990154}}
