846:   * cause and fix (`nexus doctor`, `~/.config/nexus/config.env`, `/connect`) when unreachable or rejected; undefined when ok.\ncli/src/agent.ts:5890:            (lastRecovery.everSucceeded === false ? \" — run `nexus doctor`, check LOCAL_LLM_ENDPOINT in ~/.config/nexus/config.env, or use /connect\" : \"\")\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","create_time":1792843110.2521098}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
