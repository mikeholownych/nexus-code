{"timestamp":"2026-10-24T11:58:33.163Z","ordinal":288375,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","response_id":"resp_060b64278a9dfb15016adc9d667bfc81a08e620a95fe33a26f","usage":{"input_tokens":196099,"cached_input_tokens":192768,"cache_write_input_tokens":0,"output_tokens":258,"reasoning_output_tokens":161,"total_tokens":196357},"turn_token_usage":{"input_tokens":155087378,"cached_input_tokens":154050560,"cache_write_input_tokens":0,"output_tokens":317062,"reasoning_output_tokens":173935,"total_tokens":155404440},"thread_token_usage":{"input_tokens":5219993655,"cached_input_tokens":5164346624,"cache_write_input_tokens":0,"output_tokens":14500416,"reasoning_output_tokens":8234631,"total_tokens":5234494071}}}
{"timestamp":"2026-10-24T11:58:34.812Z","ordinal":288376,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","item":{"type":"CommandExecution","id":"exec-0bd3a6c7-d488-45ad-9f75-40bf5103d9fc","process_id":"88068","command":["/usr/bin/zsh","-lc","sed -n '1,110p' cli/src/credentials.ts; sed -n '35,105p' cli/src/client.ts; sed -n '1,80p' cli/src/config.ts"],"cwd":"file:///tmp/nexus-release-gate-82c5","parsed_cmd":[{"type":"read","cmd":"sed -n '1,110p' cli/src/credentials.ts","name":"credentials.ts","path":"cli/src/credentials.ts"},{"type":"read","cmd":"sed -n '35,105p' cli/src/client.ts","name":"client.ts","path":"cli/src/client.ts"},{"type":"read","cmd":"sed -n '1,80p' cli/src/config.ts","name":"config.ts","path":"cli/src/config.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * Provider credentials: where each provider's key or sign-in comes from, in precedence order.\n *\n * 1. The provider's environment variable (operator environment / config.env / process env).\n * 2. Nexus's own store, ~/.config/nexus/credentials.json (mode 0600), written by `nexus connect` and the TUI.\n * 3. Connections already registered in other clients on this machine, read in place and never modified:\n *    Codex CLI (~/.codex/auth.json), opencode (~/.local/share/opencode/auth.json), crush\n *    (~/.local/share/crush/crush.json) and the GitHub Copilot editor plugins (~/.config/github-copilot/apps.json).\n *\n * An OAuth token read from another client is used while valid and re-read when it expires; Nexus never refreshes it,\n * because refresh tokens rotate and refreshing would sign the owning client out. All files are read from the\n * operator's credential home (credentialStorageHome), never from a HOME a project .env set.\n */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { credentialStorageHome } from \"./client.js\";\n\nexport type StoredCredential =\n  | { type: \"api\"; key: string; label?: string; savedAt: string }\n  | {\n      type: \"oauth\";\n      access: string;\n      /** Refresh token (ChatGPT) or GitHub OAuth token (Copilot). */\n      refresh?: string;\n      /** Epoch ms; undefined when unknown. */\n      expiresAt?: number;\n      accountId?: string;\n      label?: string;\n      savedAt: string;\n    };\n\nexport interface ResolvedCredential {\n  /** Where it came from, for the operator: \"$OPENAI_API_KEY\", \"Nexus\", \"Codex CLI\", \"opencode\", ... */\n  source: string;\n  kind: \"env\" | \"nexus\" | \"external\";\n  credential: StoredCredential;\n  /** False for tokens owned by another client: Nexus must not refresh them. */\n  refreshable: boolean;\n  /** File it was read from (external and nexus). */\n  file?: string;\n}\n\ninterface StoreFile {\n  version: 1;\n  providers: Record<string, StoredCredential>;\n}\n\nexport function credentialsPath(): string {\n  return path.join(credentialStorageHome(), \".config/nexus/credentials.json\");\n}\n\nfunction readJson(file: string): any {\n  try {\n    return JSON.parse(fs.readFileSync(file, \"utf-8\"));\n  } catch {\n    return undefined;\n  }\n}\n\nfunction readStore(): StoreFile {\n  const raw = readJson(credentialsPath());\n  return raw && typeof raw === \"object\" && raw.providers && typeof raw.providers === \"object\"\n    ? { version: 1, providers: raw.providers }\n    : { version: 1, providers: {} };\n}\n\n/** Atomic, owner-only write: a credential file is never briefly world-readable or half-written. */\nfunction writeStore(store: StoreFile): void {\n  const file = credentialsPath();\n  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });\n  const tmp = `${file}.${process.pid}.tmp`;\n  fs.writeFileSync(tmp, JSON.stringify(store, null, 2) + \"\\n\", { mode: 0o600 });\n  fs.renameSync(tmp, file);\n  fs.chmodSync(file, 0o600);\n}\n\nexport function saveCredential(providerId: string, credential: StoredCredential): void {\n  const store = readStore();\n  store.providers[providerId] = credential;\n  writeStore(store);\n}\n\n/** Removes Nexus's own credential; connections owned by other clients or the environment are untouched. */\nexport function removeCredential(providerId: string): boolean {\n  const store = readStore();\n  if (!(providerId in store.providers)) return false;\n  delete store.providers[providerId];\n  writeStore(store);\n  return true;\n}\n\n/** Expiry (epoch ms) from a JWT's `exp` claim, without verifying it (advisory only). */\nexport function jwtExpiry(token: string | undefined): number | undefined {\n  const claims = jwtClaims(token);\n  return typeof claims?.exp === \"number\" ? claims.exp * 1000 : undefined;\n}\n\nexport function jwtClaims(token: string | undefined): Record<string, any> | undefined {\n  const part = token?.split(\".\")[1];\n  if (!part) return undefined;\n  try {\n    return JSON.parse(Buffer.from(part.replace(/-/g, \"+\").replace(/_/g, \"/\"), \"base64\").toString(\"utf-8\"));\n  } catch {\n    return undefined;\n  }\n}\n\n/** ChatGPT account id from ID/access token claims. */\nexport function chatgptAccountId(...tokens: Array<string | undefined>): string | undefined {\n  for (const t of tokens) {\nimport { COPILOT_HEADERS, copilotToken, refreshOAuth } from \"./oauth.js\";\nimport { providerDefinition } from \"./providers.js\";\n\ntype OAuthCredential = Extract<StoredCredential, { type: \"oauth\" }>;\n\nfunction originOf(url: string | undefined): string | undefined {\n  if (!url?.trim()) return undefined;\n  try {\n    return new URL(url.trim()).origin;\n  } catch {\n    return undefined;\n  }\n}\n\n/** The origin a credential configured for `endpoint` belongs to. */\nexport function credentialOriginOf(endpoint: string | undefined): string | undefined {\n  return originOf(endpoint);\n}\n\nfunction readConfigEnv(): Record<string, string> {\n  const out: Record<string, string> = {};\n  try {\n    for (const line of fs.readFileSync(path.join(credentialStorageHome(), \".config/nexus/config.env\"), \"utf-8\").split(\"\\n\")) {\n      const m = /^([A-Z0-9_]+)=(.*)$/.exec(line.trim());\n      if (m) out[m[1]] = m[2].trim();\n    }\n  } catch {}\n  return out;\n}\n\n/**\n * The stored gateway token: the file named by the operator's NEXUS_GATEWAY_TOKEN_FILE (environment or config.env, never\n * a project .env), else ~/.config/nexus/gateway-token. It is sent only to the origin config.env names (see credentialOriginOf).\n */\nfunction readGatewayTokenFile(): string | undefined {\n  const configured = operatorSetting(\"NEXUS_GATEWAY_TOKEN_FILE\");\n  const file = configured\n    ? path.resolve(credentialStorageHome(), configured.replace(/^~(?=\\/)/, credentialStorageHome()))\n    : path.join(credentialStorageHome(), \".config/nexus/gateway-token\");\n  try {\n    return fs.readFileSync(file, \"utf-8\").trim() || undefined;\n  } catch {\n    return undefined;\n  }\n}\n\n/**\n * Settings with authority over where credentials may be sent: the operator's process environment as it was before\n * any env file was loaded, overlaid by ~/.config/nexus/config.env. Project and installation .env files are excluded:\n * they may choose endpoints and carry their own keys, but they never decide where a stored credential goes.\n * Undefined until loadEnvironment() records it; until then nothing but the operator has written process.env.\n */\nlet credentialAuthority: Readonly<Record<string, string | undefined>> | undefined;\n/**\n * The operator's home directory as resolved when the authority was recorded: the stored credentials (config.env, the\n * gateway token file) are read from there, never from a HOME that an env file set later.\n */\nlet credentialHome: string | undefined;\n\nexport function setCredentialAuthority(settings: Record<string, string | undefined>, operatorHome: string = os.homedir()): void {\n  credentialAuthority = Object.freeze({ ...settings });\n  credentialHome = operatorHome;\n}\n\n/** Where the operator's stored credentials live (the live home only before any authority is recorded). */\nexport function credentialStorageHome(): string {\n  return credentialHome ?? os.homedir();\n}\n\nfunction authoritySetting(key: string): string | undefined {\n  return (credentialAuthority ? credentialAuthority[key] : process.env[key])?.trim() || undefined;\nimport * as fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { config as loadDotenv, parse as parseDotenv } from \"dotenv\";\nimport { credentialOriginOf, credentialStorageHome, environmentCredential, LocalLlmClient, operatorSetting, setCredentialAuthority } from \"./client.js\";\nimport { baseUrlSetting, originOf, parseOriginList, PROVIDERS, providerDefinition } from \"./providers.js\";\nimport { providerApiKey } from \"./credentials.js\";\nimport { ContinuationBudget, DEFAULT_CONTINUATION, HarnessConfig, ApprovalMode } from \"./types.js\";\nimport { isWorkspaceTrusted } from \"./workspace_trust.js\";\n\nconst installEnv = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../.env\");\nconst DEFAULT_ENDPOINT = \"http://localhost:1234/v1\";\nlet credentialAuthorityRecorded = false;\nlet shellEnvironment: Record<string, string | undefined> = {};\nlet userConfigFile: Record<string, string> = {};\n\n/** Loads env files in precedence order; CLI flags are applied afterwards by buildConfig. */\nexport function loadEnvironment(): void {\n  // The operator's own environment and home, before any file has written to process.env.\n  const operatorEnvironment = credentialAuthorityRecorded ? undefined : { ...process.env };\n  if (!credentialAuthorityRecorded && operatorEnvironment) {\n    shellEnvironment = { ...operatorEnvironment };\n  }\n  const operatorHome = credentialAuthorityRecorded ? credentialStorageHome() : os.homedir();\n  // 1. Installation directory defaults\n  loadDotenv({ path: installEnv });\n  // 2. Global user config (~/.config/nexus/config.env)\n  const globalConfig = path.join(operatorHome, \".config/nexus/config.env\");\n  userConfigFile = {};\n  if (fs.existsSync(globalConfig)) {\n    loadDotenv({ path: globalConfig, override: true });\n    userConfigFile = parseDotenv(fs.readFileSync(globalConfig));\n  }\n  // Credential bindings are decided by the operator environment and config.env only (see setCredentialAuthority).\n  if (operatorEnvironment) {\n    setCredentialAuthority({ ...operatorEnvironment, ...userConfigFile }, operatorHome);\n    credentialAuthorityRecorded = true;\n  }\n  // 3. Current working directory overrides (skipped when cwd is the install directory: that file is the\n  //    shipped default already applied in step 1 and must not outrank the user's global config). A project .env\n  //    belongs to the repository, not the operator: only per-project settings in PROJECT_ENV_KEYS are applied; the\n  //    rest (TLS and proxy settings, credentials, HOME, the shell, timeouts, fallbacks, trust) is ignored and reported.\n  const cwdEnv = path.resolve(process.cwd(), \".env\");\n  projectEnvSettings = {};\n  projectEnvIgnored = [];\n  if (cwdEnv !== installEnv && fs.existsSync(cwdEnv)) {\n    let project: Record<string, string> = {};\n    try {\n      project = parseDotenv(fs.readFileSync(cwdEnv));\n    } catch {}\n    for (const [key, value] of Object.entries(project)) {\n      if (isProjectEnvKey(key)) projectEnvSettings[key] = value;\n      else projectEnvIgnored.push(key);\n    }\n    if (projectEnvIgnored.length) {\n      warnOnce(`ignored in ${cwdEnv}: ${projectEnvIgnored.join(\", \")} (a project .env may set only per-project settings; put operator settings in ~/.config/nexus/config.env)`);\n    }\n  }\n}\n\n/**\n * Settings a repository's .env may choose for itself: which endpoint, model and endpoint key to use (a cloud destination\n * still needs the operator's authorization, and the key is bound to that endpoint's origin), task classes, budgets and\n * reasoning effort. Everything else is operator authority, including cloud provider keys and selection.\n */\nconst PROJECT_ENV_KEYS = new Set([\n  \"LOCAL_LLM_ENDPOINT\",\n  \"LOCAL_LLM_MODEL\",\n  // The project's own key for the project's own endpoint: credential binding sends it only to that origin.\n  \"LOCAL_LLM_API_KEY\",\n  \"LOCAL_LLM_TASK_CLASS\",\n  \"PLANNER_LLM_ENDPOINT\",\n  \"PLANNER_LLM_MODEL\",\n  \"PLANNER_TASK_CLASS\",\n  \"CODER_LLM_ENDPOINT\",\n  \"CODER_LLM_MODEL\",\n  \"NEXUS_TASK_CLASS\",\n  \"NEXUS_CONTINUATION\",\n  \"NEXUS_MAX_TOTAL_STEPS\",\n","exit_code":0,"duration":{"secs":0,"nanos":676460991}},"started_at_ms":1792843114135,"completed_at_ms":1792843114812}}
{"timestamp":"2026-10-24T11:58:36.143Z","ordinal":288377,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a16dc6-ee6f-7503-a402-4c9aa35998d3","call_id":"call_fd77cf09411a4bc38a3373c5164ae8f3","output":[{"type":"input_text","text":"Script completed\nWall time 3.1 seconds\nOutput:\n"},{"type":"input_text","text":"/**\n * Provider credentials: where each provider's key or sign-in comes from, in precedence order.\n *\n * 1. The provider's environment variable (operator environment / config.env / process env).\n * 2. Nexus's own store, ~/.config/nexus/credentials.json (mode 0600), written by `nexus connect` and the TUI.\n * 3. Connections already registered in other clients on this machine, read in place and never modified:\n *    Codex CLI (~/.codex/auth.json), opencode (~/.local/share/opencode/auth.json), crush\n *    (~/.local/share/crush/crush.json) and the GitHub Copilot editor plugins (~/.config/github-copilot/apps.json).\n *\n * An OAuth token read from another client is used while valid and re-read when it expires; Nexus never refreshes it,\n * because refresh tokens rotate and refreshing would sign the owning client out. All files are read from the\n * operator's credential home (credentialStorageHome), never from a HOME a project .env set.\n */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { credentialStorageHome } from \"./client.js\";\n\nexport type StoredCredential =\n  | { type: \"api\"; key: string; label?: string; savedAt: string }\n  | {\n      type: \"oauth\";\n      access: string;\n      /** Refresh token (ChatGPT) or GitHub OAuth token (Copilot). */\n      refresh?: string;\n      /** Epoch ms; undefined when unknown. */\n      expiresAt?: number;\n      accountId?: string;\n      label?: string;\n      savedAt: string;\n    };\n\nexport interface ResolvedCredential {\n  /** Where it came from, for the operator: \"$OPENAI_API_KEY\", \"Nexus\", \"Codex CLI\", \"opencode\", ... */\n  source: string;\n  kind: \"env\" | \"nexus\" | \"external\";\n  credential: StoredCredential;\n  /** False for tokens owned by another client: Nexus must not refresh them. */\n  refreshable: boolean;\n  /** File it was read from (external and nexus). */\n  file?: string;\n}\n\ninterface StoreFile {\n  version: 1;\n  providers: Record<string, StoredCredential>;\n}\n\nexport function credentialsPath(): string {\n  return path.join(credentialStorageHome(), \".config/nexus/credentials.json\");\n}\n\nfunction readJson(file: string): any {\n  try {\n    return JSON.parse(fs.readFileSync(file, \"utf-8\"));\n  } catch {\n    return undefined;\n  }\n}\n\nfunction readStore(): StoreFile {\n  const raw = readJson(credentialsPath());\n  return raw && typeof raw === \"object\" && raw.providers && typeof raw.providers === \"object\"\n    ? { version: 1, providers: raw.providers }\n    : { version: 1, providers: {} };\n}\n\n/** Atomic, owner-only write: a credential file is never briefly world-readable or half-written. */\nfunction writeStore(store: StoreFile): void {\n  const file = credentialsPath();\n  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });\n  const tmp = `${file}.${process.pid}.tmp`;\n  fs.writeFileSync(tmp, JSON.stringify(store, null, 2) + \"\\n\", { mode: 0o600 });\n  fs.renameSync(tmp, file);\n  fs.chmodSync(file, 0o600);\n}\n\nexport function saveCredential(providerId: string, credential: StoredCredential): void {\n  const store = readStore();\n  store.providers[providerId] = credential;\n  writeStore(store);\n}\n\n/** Removes Nexus's own credential; connections owned by other clients or the environment are untouched. */\nexport function removeCredential(providerId: string): boolean {\n  const store = readStore();\n  if (!(providerId in store.providers)) return false;\n  delete store.providers[providerId];\n  writeStore(store);\n  return true;\n}\n\n/** Expiry (epoch ms) from a JWT's `exp` claim, without verifying it (advisory only). */\nexport function jwtExpiry(token: string | undefined): number | undefined {\n  const claims = jwtClaims(token);\n  return typeof claims?.exp === \"number\" ? claims.exp * 1000 : undefined;\n}\n\nexport function jwtClaims(token: string | undefined): Record<string, any> | undefined {\n  const part = token?.split(\".\")[1];\n  if (!part) return undefined;\n  try {\n    return JSON.parse(Buffer.from(part.replace(/-/g, \"+\").replace(/_/g, \"/\"), \"base64\").toString(\"utf-8\"));\n  } catch {\n    return undefined;\n  }\n}\n\n/** ChatGPT account id from ID/access token claims. */\nexport function chatgptAccountId(...tokens: Array<string | undefined>): string | undefined {\n  for (const t of tokens) {\nimport { COPILOT_HEADERS, copilotToken, refreshOAuth } from \"./oauth.js\";\nimport { providerDefinition } from \"./providers.js\";\n\ntype OAuthCredential = Extract<StoredCredential, { type: \"oauth\" }>;\n\nfunction originOf(url: string | undefined): string | undefined {\n  if (!url?.trim()) return undefined;\n  try {\n    return new URL(url.trim()).origin;\n  } catch {\n    return undefined;\n  }\n}\n\n/** The origin a credential configured for `endpoint` belongs to. */\nexport function credentialOriginOf(endpoint: string | undefined): string | undefined {\n  return originOf(endpoint);\n}\n\nfunction readConfigEnv(): Record<string, string> {\n  const out: Record<string, string> = {};\n  try {\n    for (const line of fs.readFileSync(path.join(credentialStorageHome(), \".config/nexus/config.env\"), \"utf-8\").split(\"\\n\")) {\n      const m = /^([A-Z0-9_]+)=(.*)$/.exec(line.trim());\n      if (m) out[m[1]] = m[2].trim();\n    }\n  } catch {}\n  return out;\n}\n\n/**\n * The stored gateway token: the file named by the operator's NEXUS_GATEWAY_TOKEN_FILE (environment or config.env, never\n * a project .env), else ~/.config/nexus/gateway-token. It is sent only to the origin config.env names (see credentialOriginOf).\n */\nfunction readGatewayTokenFile(): string | undefined {\n  const configured = operatorSetting(\"NEXUS_GATEWAY_TOKEN_FILE\");\n  const file = configured\n    ? path.resolve(credentialStorageHome(), configured.replace(/^~(?=\\/)/, credentialStorageHome()))\n    : path.join(credentialStorageHome(), \".config/nexus/gateway-token\");\n  try {\n    return fs.readFileSync(file, \"utf-8\").trim() || undefined;\n  } catch {\n    return undefined;\n  }\n}\n\n/**\n * Settings with authority over where credentials may be sent: the operator's process environment as it was before\n * any env file was loaded, overlaid by ~/.config/nexus/config.env. Project and installation .env files are excluded:\n * they may choose endpoints and carry their own keys, but they never decide where a stored credential goes.\n * Undefined until loadEnvironment() records it; until then nothing but the operator has written process.env.\n */\nlet credentialAuthority: Readonly<Record<string, string | undefined>> | undefined;\n/**\n * The operator's home directory as resolved when the authority was recorded: the stored credentials (config.env, the\n * gateway token file) are read from there, never from a HOME that an env file set later.\n */\nlet credentialHome: string | undefined;\n\nexport function setCredentialAuthority(settings: Record<string, string | undefined>, operatorHome: string = os.homedir()): void {\n  credentialAuthority = Object.freeze({ ...settings });\n  credentialHome = operatorHome;\n}\n\n/** Where the operator's stored credentials live (the live home only before any authority is recorded). */\nexport function credentialStorageHome(): string {\n  return credentialHome ?? os.homedir();\n}\n\nfunction authoritySetting(key: string): string | undefined {\n  return (credentialAuthority ? credentialAuthority[key] : process.env[key])?.trim() || undefined;\nimport * as fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { config as loadDotenv, parse as parseDotenv } from \"dotenv\";\nimport { credentialOriginOf, credentialStorageHome, environmentCredential, LocalLlmClient, operatorSetting, setCredentialAuthority } from \"./client.js\";\nimport { baseUrlSetting, originOf, parseOriginList, PROVIDERS, providerDefinition } from \"./providers.js\";\nimport { providerApiKey } from \"./credentials.js\";\nimport { ContinuationBudget, DEFAULT_CONTINUATION, HarnessConfig, ApprovalMode } from \"./types.js\";\nimport { isWorkspaceTrusted } from \"./workspace_trust.js\";\n\nconst installEnv = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../.env\");\nconst DEFAULT_ENDPOINT = \"http://localhost:1234/v1\";\nlet credentialAuthorityRecorded = false;\nlet shellEnvironment: Record<string, string | undefined> = {};\nlet userConfigFile: Record<string, string> = {};\n\n/** Loads env files in precedence order; CLI flags are applied afterwards by buildConfig. */\nexport function loadEnvironment(): void {\n  // The operator's own environment and home, before any file has written to process.env.\n  const operatorEnvironment = credentialAuthorityRecorded ? undefined : { ...process.env };\n  if (!credentialAuthorityRecorded && operatorEnvironment) {\n    shellEnvironment = { ...operatorEnvironment };\n  }\n  const operatorHome = credentialAuthorityRecorded ? credentialStorageHome() : os.homedir();\n  // 1. Installation directory defaults\n  loadDotenv({ path: installEnv });\n  // 2. Global user config (~/.config/nexus/config.env)\n  const globalConfig = path.join(operatorHome, \".config/nexus/config.env\");\n  userConfigFile = {};\n  if (fs.existsSync(globalConfig)) {\n    loadDotenv({ path: globalConfig, override: true });\n    userConfigFile = parseDotenv(fs.readFileSync(globalConfig));\n  }\n  // Credential bindings are decided by the operator environment and config.env only (see setCredentialAuthority).\n  if (operatorEnvironment) {\n    setCredentialAuthority({ ...operatorEnvironment, ...userConfigFile }, operatorHome);\n    credentialAuthorityRecorded = true;\n  }\n  // 3. Current working directory overrides (skipped when cwd is the install directory: that file is the\n  //    shipped default already applied in step 1 and must not outrank the user's global config). A project .env\n  //    belongs to the repository, not the operator: only per-project settings in PROJECT_ENV_KEYS are applied; the\n  //    rest (TLS and proxy settings, credentials, HOME, the shell, timeouts, fallbacks, trust) is ignored and reported.\n  const cwdEnv = path.resolve(process.cwd(), \".env\");\n  projectEnvSettings = {};\n  projectEnvIgnored = [];\n  if (cwdEnv !== installEnv && fs.existsSync(cwdEnv)) {\n    let project: Record<string, string> = {};\n    try {\n      project = parseDotenv(fs.readFileSync(cwdEnv));\n    } catch {}\n    for (const [key, value] of Object.entries(project)) {\n      if (isProjectEnvKey(key)) projectEnvSettings[key] = value;\n      else projectEnvIgnored.push(key);\n    }\n    if (projectEnvIgnored.length) {\n      warnOnce(`ignored in ${cwdEnv}: ${projectEnvIgnored.join(\", \")} (a project .env may set only per-project settings; put operator settings in ~/.config/nexus/config.env)`);\n    }\n  }\n}\n\n/**\n * Settings a repository's .env may choose for itself: which endpoint, model and endpoint key to use (a cloud destination\n * still needs the operator's authorization, and the key is bound to that endpoint's origin), task classes, budgets and\n * reasoning effort. Everything else is operator authority, including cloud provider keys and selection.\n */\nconst PROJECT_ENV_KEYS = new Set([\n  \"LOCAL_LLM_ENDPOINT\",\n  \"LOCAL_LLM_MODEL\",\n  // The project's own key for the project's own endpoint: credential binding sends it only to that origin.\n  \"LOCAL_LLM_API_KEY\",\n  \"LOCAL_LLM_TASK_CLASS\",\n  \"PLANNER_LLM_ENDPOINT\",\n  \"PLANNER_LLM_MODEL\",\n  \"PLANNER_TASK_CLASS\",\n  \"CODER_LLM_ENDPOINT\",\n  \"CODER_LLM_MODEL\",\n  \"NEXUS_TASK_CLASS\",\n  \"NEXUS_CONTINUATION\",\n  \"NEXUS_MAX_TOTAL_STEPS\",\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","create_time":1792843116.1437514}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
