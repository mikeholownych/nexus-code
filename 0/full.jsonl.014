mpletedAt\":\"2026-10-24T08:47:50Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40078369394/job/120826528327\",\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-24T08:31:26Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40078369394/job/120829697889\",\"name\":\"linux-x86_64\",\"startedAt\":\"2026-10-24T08:47:52Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-24T08:32:36Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/runs/120826749082\",\"name\":\"CodeQL\",\"startedAt\":\"2026-10-24T08:32:34Z\",\"status\":\"COMPLETED\",\"workflowName\":\"\"},{\"__typename\":\"StatusContext\",\"context\":\"CodeRabbit\",\"startedAt\":\"2026-10-24T08:31:30Z\",\"state\":\"SUCCESS\",\"targetUrl\":\"\"}]}\n    wait_events(events, \"tool.end\", 3, 30, s)\n    s.pump(0.5)\n    result[\"scroll_kept\"] = s.color.lines()[1:-3] == before_scroll\n    shot(s, \"06-scrolled-back-new-output\")\n    s.send(\"\\x1b[6~\" * 8, settle=0.3)\n    wait_events(events, \"turn.result\", 2, 60, s)\n    s.wait_idle()\n    s.pump(0.3)\n    shot(s, \"07-tools-final\")\n\n    # A multi-line paste, inspected, then sent.\n    s.send(\"\\x1b[200~line one of the note\\r\\n\\tindented line ✓ 字\\r\\nline three\\x1b[201~\", settle=0.4)\n    shot(s, \"08-paste-buffer\")\n    s.send(\"\\x0f\", settle=0.4)  # ctrl+o\n    shot(s, \"09-paste-view\")\n    s.send(\"\\x1b\", settle=0.3)\n    s.send(\"\\r\", settle=0.2)\n    wait_events(events, \"turn.result\", 3, 30, s)\n    s.wait_idle()\n\n    # Review mode: an approval; keys typed just before it opens must not answer it.\n    s.send(\"/mode review\\r\", settle=0.5)\n    s.send(\"Write the config file.\\r\", settle=0.05)\n    s.send(\"yyy\", settle=0.05)\n    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 20, \"the approval modal\")\n    s.pump(0.9)  # a pause in typing before the deliberate decision\n    shot(s, \"10-approval\")\n    result[\"approval_survived_buffered_keys\"] = has(s.color.lines(), \"Approval needed\")\n    # Keys were typed just before it opened, so its letters are not answers: → selects Approve, Enter confirms.\n    result[\"letters_disarmed_hint\"] = any(\"typing ignored\" in l for l in s.color.lines())\n    s.send(\"\\x1b[C\", settle=2.2)  # on a typed-into panel the choice stays on screen 2 s before Enter takes it\n    s.send(\"\\r\", settle=0.6)  # where letters are off, approving takes Enter twice\n    s.send(\"\\r\", settle=0.4)\n    wait_events(events, \"turn.result\", 4, 30, s)\n    s.wait_idle()\n    result[\"draft_after_approval\"] = s.color.lines()[-1]\n    s.send(\"\\x0c\", settle=0.2)  # the buffered keys stayed in the draft: clear it\n    s.send(\"/mode auto\\r\", settle=0.5)\n\n    # Cancellation during a slow step.\n    s.send(\"Take a long time on this.\\r\", settle=0.1)\n    s.pump(1.5)\n    s.send(\"\\x1b\", settle=0.1)\n    wait_events(events, \"turn.result\", 5, 30, s)\n    s.wait_idle()\n    s.pump(0.3)\ncore/src/bin/nexus_tui/live_view.rs:554:        None => vec![Span::styled(\"typing ignored · \", muted), Span::styled(\"←→\", key), Span::styled(\" approve/deny, pause, \", muted), Span::styled(\"enter\", key), Span::styled(\" · \", muted), Span::styled(\"esc\", key), Span::styled(\" denies\", muted)],\ncore/src/bin/nexus_tui/live_view.rs:3845:        // A draft disarms letters; → then Enter 400 ms later is too soon there; 2 s later it takes Approve once.\ncore/src/bin/nexus_tui/live_view.rs:3913:    fn a_draft_in_the_composer_disarms_letters_and_a_resize_does_not_rearm_them() {\ncore/src/bin/nexus_tui/live_view.rs:3921:        // Typed into, shrunk and regrown later: still disarmed.\ncore/src/bin/nexus_tui/live_state.rs:3126:        // A key typed in