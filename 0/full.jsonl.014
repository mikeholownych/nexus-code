cancel());\n      console.log(`\\n${signIn.prompt.instructions}\\n  ${pc.bold(signIn.prompt.url)}${signIn.prompt.userCode ? `\\n  code: ${pc.bold(signIn.prompt.userCode)}` : \"\"}\\n`);\n      const r = await signIn.done;\n      console.log(r.ok ? pc.green(r.message) : pc.red(r.message));\n      process.exitCode = r.ok ? 0 : 1;\n    });\n\n  program\n    .command(\"disconnect\")\n    .description(\"Remove the credential Nexus saved for a provider (environment and other clients are untouched)\")\n    .argument(\"<provider>\")\n    .action((providerId: string) => {\n      const r = disconnect(providerId);\n      console.log(r.ok ? pc.green(r.message) : pc.yellow(r.message));\n    });\n\n  const providers = program\n    .command(\"providers\")\n    .description(\"List cloud inference providers, credential status and the selected destinations\")\n    .action(() => {\n      console.log(pc.bold(\"\\nCloud inference providers\\n\"));\n      for (const def of Object.values(PROVIDERS)) {\n        const configuredBase = operatorSetting(baseUrlSetting(def.id));\n        const baseUrl = configuredBase || def.baseUrl;\n        const base = baseUrl ? safeOriginOf(baseUrl) ?? \"(invalid endpoint)\" : \"(set --base-url or \" + baseUrlSetting(def.id) + \")\";\n        const found = resolveCredential(def.id, def.credentialEnv);\n        const key = found ? pc.green(`connected via ${found.source}`) : pc.yellow(`not connected (${def.credentialEnv ? `$${def.credentialEnv} or ` : \"\"}nexus connect ${def.id})`);\n        console.log(`  ${pc.bold(def.id.padEnd(11))} ${def.protocol.padEnd(19)} ${base}`);\n        console.log(`  ${\"\".padEnd(11)} ${key}${def.methods.some((m) => m.unofficial) ? pc.dim(\"  · unofficial sign-in\") : \"\"}`);\n      }\n      let config: HarnessConfig;\n      try {\n        config = buildConfig({});\n      } catch (err: any) {\n        console.log(pc.red(`\\n${safeConfigurationError(err)}`));\n        process.exitCode = 2;\n        return;\n      }\n      console.log(`\\n${describeTarget(config)}`);\n      const authorized = config.authorizedDisclosureOrigins ?? [];\n      console.log(pc.dim(`Authorized cloud destinations: ${authorized.length ? authorized.map((origin) => safeOriginOf(origin) ?? \"(invalid endpoint)\").join(\", \") : \"none\"}`));\n      console.log(pc.dim(\"Select with --provider <id> --model <id> (or NEXUS_PROVIDER / NEXUS_MODEL in ~/.config/nexus/config.env).\\n\"));\n    });\n\n  providers\n    .command(\"verify\")\n    .description(\"Live check: streamed completion and a tool round trip against a provider (sends no workspace content)\")\n    .requiredOption(\"--provider <id>\", \"Provider to check\")\n34:  source: string;\n48:export function credentialsPath(): string {\n77:export function saveCredential(providerId: string, credential: StoredCredential): void {\n84:export function removeCredential(providerId: string): boolean {\n93:export function jwtExpiry(token: string | undefined): number | undefined {\n98:export function jwtClaims(token: string | undefined): Record<string, any> | undefined {\n109:export function chatgptAccountId(...tokens: Array<string | undefined>): string | undefined {\n133:export function externalCredentials(providerId: string): ResolvedCredential[] {\n144:        source: \"Codex CLI\",\n166:        source: \"opencode\",\n180:      out.push({ source: \"opencode\", kind: \"external\", file: ocFile, refreshable: false, credential: { type: \"api\", key: literalKey(e.key)!, savedAt: now() } });\n192:        source: \"crush\",\n206:      out.push({ source: \"crush\", kind: \"external\", file: crushFile, refreshable: false, credential: { type: \"api\", key: literalKey(p.api_key)!, savedAt: now() } });\n215:      const entry = Object.entries(data).find(([k, v]: [string, any]) => (k === \"github.com\" || k.startsWith(\"github.com:\")) && typeof v?.oauth_token === \"string\");\n219:          source: \"GitHub Copilot plugin\",\n","exit_code":0,"duration":{"secs":0,"nanos":28229}},"started