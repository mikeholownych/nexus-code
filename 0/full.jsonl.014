\"reportedCostUsd\": 0\n    }\n  ],\n  \"preservedFailedAttempt\": {\n    \"provider\": \"openrouter\",\n    \"model\": \"nvidia/nemotron-3-super-120b-a12b:free\",\n    \"disposition\": \"FAILED\",\n    \"failureKind\": \"http_error\",\n    \"failureCondition\": \"REQUEST_REJECTED\",\n    \"requestId\": \"e5ad5e55-85bd-41a9-b304-459832133c3c\",\n    \"note\": \"Retained in the same raw receipt file; the previous attempt is not counted as a pass.\"\n  },\n  \"qualificationDisposition\": \"Provider verification passed for ChatGPT sign-in and one explicitly pinned OpenRouter model. The separate required live engineering task per ACCEPTANCE.md §4.3 remains incomplete; this record does not establish overall RC acceptance.\",\n  \"providerReceiptFileSha256\": \"179406d98fe04b428b970092d10969734fa6ab59c29b5f8b60c15fed94377394\"\n}\n","exit_code":0,"duration":{"secs":0,"nanos":673404293}},"started_at_ms":1792843078314,"completed_at_ms":1792843078987}}
