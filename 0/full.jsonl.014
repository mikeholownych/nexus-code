h as the TUI sidecar. Observers must not throw. */\n163-/** Outcome of in-turn delegation (spawn_subagent). `summary` is whatever report exists, even when not completed. */\n--\n852-  private securityManager: SecurityManager;\n853-  private extensibilityInitialized: boolean = false;\n854-  private activePlan: Array<{ name: string; status: string; detail?: string }> = [];\n855-  private hasPendingModifications: boolean = false;\n856-  /** Modified files tracked during the session/task for deliverable verification boundaries. */\n857-  private modifiedFiles: Set<string> = new Set<string>();\n858-  /** Pending recovered work has no authenticated pre-change verifier snapshot. */\n859-  private verificationBaselineInvalidated: boolean = false;\n860:  /** A persisted baseline retained only as untrusted continuity evidence after recovery. */\n861:  private untrustedRecoveredBaseline?: DurableTaskState[\"changeBaseline\"];\n862-  /** Evidence from the verifier run that covers the current workspace changes. Cleared by any later mutation. */\n863-  private verificationEvidence?: VerificationEvidence;\n864-  private verificationEvidenceRawOutput: string = \"\";\n865-  private turnMutations: number = 0;\n866-  /** The turn started with unverified changes from earlier work (an earlier turn, attempt, or process). */\n867-  private turnCarriedChanges = false;\n868-  /** The operator-configured verifier's latest result in this turn (FAILED: it refused a completion and has not passed since). */\n869-  private turnConfiguredVerifier: \"NOT_RUN\" | \"PASSED\" | \"FAILED\" = \"NOT_RUN\";\n--\n1266-    this.clearApprovedVerifiers();\n1267-  }\n1268-\n1269-  public getApprovalMode(): ApprovalMode {\n1270-    if (this.checkpointReadOnlyFallback) return \"read-only\";\n1271-    if (this.config.approvalMode) return this.config.approvalMode;\n1272-    if (this.config.readOnly) return \"read-only\";\n1273-    if (this.config.fullAccess) return \"auto\";\n1274:    const trusted = isWorkspaceTr