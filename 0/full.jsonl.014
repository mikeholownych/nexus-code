{"timestamp":"2026-10-24T08:35:37.157Z","ordinal":283074,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","response_id":"resp_060b64278a9dfb15016adc6dd4131081a0a269e3bb69e00fa6","usage":{"input_tokens":150256,"cached_input_tokens":149504,"cache_write_input_tokens":0,"output_tokens":481,"reasoning_output_tokens":389,"total_tokens":150737},"turn_token_usage":{"input_tokens":35884262,"cached_input_tokens":35493248,"cache_write_input_tokens":0,"output_tokens":126438,"reasoning_output_tokens":77628,"total_tokens":36010700},"thread_token_usage":{"input_tokens":5100790539,"cached_input_tokens":5045789312,"cache_write_input_tokens":0,"output_tokens":14309792,"reasoning_output_tokens":8138324,"total_tokens":5115100331}}}
{"timestamp":"2026-10-24T08:35:39.084Z","ordinal":283075,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","item":{"type":"CommandExecution","id":"exec-b7f2eebd-1cc6-4211-92ab-33bb29563a46","process_id":"7264","command":["/usr/bin/zsh","-lc","sed -n '1,380p' cli/src/core/retention.ts && sed -n '75,190p' cli/test/retention.test.ts"],"cwd":"file:///home/mike/nexus-wt/retention-partition-symlink","parsed_cmd":[{"type":"read","cmd":"sed -n '1,380p' cli/src/core/retention.ts","name":"retention.ts","path":"cli/src/core/retention.ts"},{"type":"read","cmd":"sed -n '75,190p' cli/test/retention.test.ts","name":"retention.test.ts","path":"cli/test/retention.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { execSync } from \"node:child_process\";\nimport { tryStateStoreGuard } from \"./state_store_guard.js\";\nimport { ensurePrivateDir, writePrivateFile, fsyncDirectoryDurably } from \"./durable_file.js\";\n\nexport const DEFAULT_RETENTION_MAX_AGE_DAYS = 90; // DEC-11\nexport const DEFAULT_RETENTION_MAX_SIZE_BYTES = 2 * 1024 * 1024 * 1024; // 2 GB (DEC-11)\nexport const DEFAULT_AUTO_GC_TIME_BUDGET_MS = 2000; // 2 seconds (DEC-11)\n\nexport type RetentionItemKind = \"task\" | \"session\" | \"checkpoint\" | \"flight\";\n\nexport interface RetentionItem {\n  kind: RetentionItemKind;\n  id: string;\n  primaryFile: string;\n  associatedFiles: string[];\n  /** Exact file identities captured by planning; changed records must be replanned. */\n  fileIdentities?: Record<string, string | null>;\n  primaryIdentity?: string;\n  /** Checkpoint directory identities bind execution to the tree scanned by planning. */\n  checkpointStateRootIdentity?: string;\n  checkpointRootIdentity?: string;\n  checkpointPartitionIdentity?: string;\n  checkpointSnapshotsIdentity?: string;\n  checkpointSnapshotRelativePath?: string;\n  checkpointSnapshotIdentity?: string;\n  /** Missing envelope tracked when collecting an orphaned companion group. */\n  recordFile?: string;\n  orphan?: boolean;\n  workspace?: string;\n  gitRef?: string;\n  sizeBytes: number;\n  mtimeMs: number;\n  pinned?: boolean;\n  current?: boolean;\n  testPollution?: boolean;\n  reason?: \"expired_age\" | \"size_cap_exceeded\" | \"test_pollution\";\n}\n\nexport interface RetentionPolicyOptions {\n  maxAgeDays?: number;\n  maxSizeBytes?: number;\n  dryRun?: boolean;\n  onlyTestPollution?: boolean;\n  timeBudgetMs?: number;\n  deadline?: number;\n  currentSessionId?: string;\n  home?: string;\n  workspace?: string;\n}\n\nexport interface RetentionPlan {\n  reclaimableItems: RetentionItem[];\n  reclaimableBytes: number;\n  reclaimableCount: number;\n  totalScannedBytes: number;\n  totalScannedCount: number;\n  byKind: Record<RetentionItemKind, { count: number; bytes: number }>;\n  timedOut: boolean;\n  durationMs: number;\n}\n\nexport interface GcExecutionResult {\n  dryRun: boolean;\n  scannedCount: number;\n  scannedBytes: number;\n  deletedCount: number;\n  deletedBytes: number;\n  deletedItems: RetentionItem[];\n  byKind: Record<RetentionItemKind, { count: number; bytes: number }>;\n  errors: Array<{ path: string; error: string }>;\n  timedOut: boolean;\n  durationMs: number;\n}\n\nexport interface GcState {\n  version: 1;\n  acknowledged: boolean;\n  acknowledgedAt?: string;\n  lastRunAt?: string;\n  lastRunSummary?: {\n    scannedCount: number;\n    deletedCount: number;\n    deletedBytes: number;\n    durationMs: number;\n  };\n}\n\nexport function isTestPollutionPath(wsPath?: string): boolean {\n  if (!wsPath) return false;\n  return /^\\/tmp\\/nexus-(app-)?test-/.test(wsPath) || /^\\/tmp\\/perm-/.test(wsPath);\n}\n\nfunction safeStat(p: string): fs.Stats | null {\n  try {\n    return fs.statSync(p);\n  } catch {\n    return null;\n  }\n}\n\nfunction fileObjectIdentity(stat: fs.Stats): string {\n  return `${stat.dev}:${stat.ino}:${stat.mode}`;\n}\n\nfunction directoryIdentity(stat: fs.Stats): string {\n  return `${stat.dev}:${stat.ino}`;\n}\n\nfunction computeDirSize(dir: string, deadline?: number): number {\n  let size = 0;\n  try {\n    const entries = fs.readdirSync(dir, { withFileTypes: true });\n    for (const entry of entries) {\n      if (deadline && Date.now() >= deadline) break;\n      const full = path.join(dir, entry.name);\n      if (entry.isDirectory()) {\n        size += computeDirSize(full, deadline);\n      } else if (entry.isFile()) {\n        const s = safeStat(full);\n        if (s) size += s.size;\n      }\n    }\n  } catch {}\n  return size;\n}\n\n/** Index companion files once; scanning all names for every task would be quadratic. */\nfunction recordCompanions(directory: string, names: string[], deadline?: number): {\n  records: Map<string, { files: string[]; bytes: number; mtimeMs: number }>;\n  timedOut: boolean;\n} {\n  const records = new Map<string, { files: string[]; bytes: number; mtimeMs: number }>();\n  for (const name of names) {\n    if (deadline && Date.now() >= deadline) return { records, timedOut: true };\n    let identity: string | undefined;\n    if (name.endsWith(\".messages.jsonl\")) identity = name.slice(0, -\".messages.jsonl\".length);\n    else if (name.endsWith(\".history.jsonl\")) identity = name.slice(0, -\".history.jsonl\".length);\n    else identity = /^(.+)\\.json\\.pre-migration-v(?:0|[1-9]\\d*)$/.exec(name)?.[1];\n    if (!identity) continue;\n    const file = path.join(directory, name);\n    try {\n      const stat = fs.lstatSync(file);\n      if (!stat.isFile()) continue;\n      const record = records.get(identity) ?? { files: [], bytes: 0, mtimeMs: 0 };\n      record.files.push(file);\n      record.bytes += stat.size;\n      record.mtimeMs = Math.max(record.mtimeMs, stat.mtimeMs);\n      records.set(identity, record);\n    } catch { /* A concurrently removed companion is already absent. */ }\n  }\n  return { records, timedOut: false };\n}\n\n/** Retain/account for failed first publications and interrupted cleanup without inventing an age grace. */\nfunction orphanCompanions(\n  directory: string, names: string[], records: Map<string, { files: string[]; bytes: number; mtimeMs: number }>,\n  kind: \"task\" | \"session\", currentSessionId?: string, deadline?: number,\n): { items: RetentionItem[]; timedOut: boolean } {\n  const present = new Set(names), items: RetentionItem[] = [];\n  for (const [id, record] of records) {\n    if (deadline && Date.now() >= deadline) return { items, timedOut: true };\n    if (present.has(`${id}.json`) || !/^[A-Za-z0-9._-]{1,160}$/.test(id) || id === \".\" || id === \"..\") continue;\n    const primaryFile = record.files[0];\n    items.push({ kind, id, primaryFile, primaryIdentity: fileIdentity(primaryFile) ?? undefined,\n      recordFile: path.join(directory, `${id}.json`), orphan: true,\n      associatedFiles: record.files.slice(1), sizeBytes: record.bytes, mtimeMs: record.mtimeMs,\n      current: currentSessionId === id });\n  }\n  return { items, timedOut: false };\n}\n\ninterface EnvelopeMetadata {\n  workspace?: string;\n  pinned: boolean;\n  sessionId?: string;\n  taskId?: string;\n  id?: string;\n}\n\nconst MAX_DIRECT_ENVELOPE_READ_BYTES = 64 * 1024; // 64 KiB\nconst MAX_SCAN_CHUNK_BYTES = 64 * 1024; // 64 KiB\nconst MAX_METADATA_KEY_BYTES = 128; // All recognized keys fit even when fully JSON-escaped.\nconst MAX_METADATA_VALUE_BYTES = 24 * 1024; // A 4 KiB path with every byte JSON-escaped.\n\nfunction readEnvelopeMetadata(\n  filePath: string,\n  stat: fs.Stats,\n  deadline?: number\n): { metadata: EnvelopeMetadata; timedOut: boolean } {\n  if (deadline && Date.now() >= deadline) {\n    return { metadata: { pinned: false }, timedOut: true };\n  }\n\n  // Bounded streaming scanner for large legacy/unmigrated files.\n  // Avoids buffering multi-megabyte inline messages or allocating memory proportional to file size.\n  let fd: number | undefined;\n  let timedOut = false;\n  const result: EnvelopeMetadata = { pinned: false };\n  const buf = Buffer.alloc(MAX_SCAN_CHUNK_BYTES);\n  let unknownMetadata = false;\n\n  try {\n    fd = fs.openSync(filePath, fs.constants.O_RDONLY | (fs.constants.O_NONBLOCK ?? 0) | (fs.constants.O_NOFOLLOW ?? 0));\n    const opened = fs.fstatSync(fd);\n    if (!opened.isFile()) throw new Error(\"Envelope metadata requires a regular file\");\n    // The planning stat is only a hint: an atomic publication can replace that\n    // file before open. Even growth after fstat cannot make this read unbounded.\n    if (stat.size <= MAX_DIRECT_ENVELOPE_READ_BYTES && opened.size <= MAX_DIRECT_ENVELOPE_READ_BYTES) {\n      const small = Buffer.alloc(MAX_DIRECT_ENVELOPE_READ_BYTES + 1);\n      let size = 0;\n      while (size < small.length) {\n        const count = fs.readSync(fd, small, size, small.length - size, size);\n        if (!count) break;\n        size += count;\n      }\n      if (size <= MAX_DIRECT_ENVELOPE_READ_BYTES) {\n        const parsed = JSON.parse(small.subarray(0, size).toString(\"utf8\"));\n        return { metadata: {\n          workspace: typeof parsed.workspacePath === \"string\" ? parsed.workspacePath : (typeof parsed.workspace === \"string\" ? parsed.workspace : undefined),\n          pinned: Boolean(parsed.pinned),\n          sessionId: typeof parsed.sessionId === \"string\" ? parsed.sessionId : undefined,\n          taskId: typeof parsed.taskId === \"string\" ? parsed.taskId : undefined,\n          id: typeof parsed.id === \"string\" ? parsed.id : undefined,\n        }, timedOut: false };\n      }\n      // Positional reads leave fd at offset zero for the streaming fallback.\n    }\n    let depth = 0;\n    let inString = false;\n    let escaped = false;\n    let key = \"\";\n    let inKey = false;\n    let afterColon = false;\n    let val = \"\";\n    let inValString = false;\n    let stringOverflow = false;\n    let scalar = \"\";\n    const stringFields = new Set([\"workspace\", \"workspacePath\", \"sessionId\", \"taskId\", \"id\", \"pinned\"]);\n    const decodeString = (raw: string): string => JSON.parse('\"' + Buffer.from(raw, \"latin1\").toString(\"utf8\") + '\"');\n    const appendByte = (byte: number) => {\n      if (inKey) {\n        if (key.length < MAX_METADATA_KEY_BYTES) key += String.fromCharCode(byte);\n        else stringOverflow = true;\n      } else if (inValString) {\n        if (val.length < MAX_METADATA_VALUE_BYTES) val += String.fromCharCode(byte);\n        else stringOverflow = true;\n      }\n    };\n    const finishPinnedScalar = () => {\n      if (!scalar) return;\n      try { result.pinned = Boolean(JSON.parse(scalar)); }\n      catch { unknownMetadata = true; }\n      scalar = \"\"; key = \"\"; afterColon = false;\n    };\n\n    while (true) {\n      if (deadline && Date.now() >= deadline) {\n        timedOut = true;\n        break;\n      }\n      const bytesRead = fs.readSync(fd, buf, 0, buf.length, null);\n      if (bytesRead === 0) break;\n\n      for (let i = 0; i < bytesRead; i++) {\n        const byte = buf[i];\n        if (inString) {\n          if (escaped) {\n            escaped = false;\n            appendByte(byte);\n          } else if (byte === 92) { // \\\n            appendByte(byte); // Preserve the escape for JSON.parse, including chunk boundaries.\n            escaped = true;\n          } else if (byte === 34) { // \"\n            inString = false;\n            if (inKey) {\n              inKey = false;\n              key = stringOverflow ? \"\" : decodeString(key);\n              afterColon = false;\n            } else if (inValString) {\n              inValString = false;\n              if (stringOverflow) unknownMetadata = true;\n              else {\n                const value = decodeString(val);\n                if (key === \"workspace\" || key === \"workspacePath\") result.workspace = value;\n                else if (key === \"sessionId\") result.sessionId = value;\n                else if (key === \"taskId\") result.taskId = value;\n                else if (key === \"id\") result.id = value;\n                else if (key === \"pinned\") result.pinned = Boolean(value);\n              }\n              key = \"\";\n              val = \"\";\n            }\n          } else {\n            appendByte(byte);\n          }\n          continue;\n        }\n\n        if (byte === 34) { // \"\n          inString = true;\n          if (depth === 1 && !afterColon) {\n            inKey = true;\n            key = \"\";\n            stringOverflow = false;\n          } else if (depth === 1 && afterColon) {\n            inValString = stringFields.has(key);\n            val = \"\";\n            stringOverflow = false;\n          }\n          continue;\n        }\n\n        if (byte === 123 || byte === 91) { // { or [\n          if (depth === 1 && afterColon && key === \"pinned\") {\n            result.pinned = true; key = \"\"; afterColon = false;\n          }\n          depth++;\n          continue;\n        }\n        if (byte === 125 || byte === 93) { // } or ]\n          if (depth === 1) finishPinnedScalar();\n          depth--;\n          if (depth === 0) break;\n          continue;\n        }\n\n        if (depth === 1) {\n          if (byte === 58) { // :\n            afterColon = true;\n          } else if (byte === 44) { // ,\n            finishPinnedScalar();\n            afterColon = false;\n            key = \"\";\n          } else if (afterColon && key === \"pinned\") {\n            if (byte === 32 || byte === 9 || byte === 10 || byte === 13) finishPinnedScalar();\n            else if (scalar.length < MAX_METADATA_KEY_BYTES) scalar += String.fromCharCode(byte);\n            else unknownMetadata = true;\n          }\n        }\n      }\n      if (depth === 0) break;\n    }\n  } catch {\n    // Read errors retain existing defaults\n  } finally {\n    if (fd !== undefined) {\n      try { fs.closeSync(fd); } catch {}\n    }\n  }\n\n  return { metadata: unknownMetadata ? { ...result, pinned: true } : result, timedOut };\n}\n\nexport function scanTasks(tasksDir: string, checkTestPollution: boolean = false, deadline?: number, currentSessionId?: string): { items: RetentionItem[]; timedOut: boolean } {\n  const items: RetentionItem[] = [];\n  let timedOut = false;\n  if (!fs.existsSync(tasksDir)) return { items, timedOut };\n\n  try {\n    const entries = fs.readdirSync(tasksDir);\n    const companions = recordCompanions(tasksDir, entries, deadline);\n    if (companions.timedOut) return { items: [], timedOut: true };\n    for (const name of entries) {\n      if (deadline && Date.now() >= deadline) {\n        timedOut = true;\n        break;\n      }\n      if (!name.endsWith(\".json\") || name.startsWith(\".corrupt-\")) continue;\n\n      const fullPath = path.join(tasksDir, name);\n      const stat = safeStat(fullPath);\n      if (!stat || !stat.isFile()) continue;\n\n      const cleanId = name.replace(/\\.json$/, \"\");\n      const companion = companions.records.get(cleanId);\n      const totalSize = stat.size + (companion?.bytes ?? 0);\n      const associatedFiles = companion?.files ?? [];\n      assert.equal(list3.length, 1000);\n      assert.ok(fs.existsSync(indexPath), \"index.json must be rebuilt when missing\");\n    } finally {\n      fs.rmSync(testHome, { recursive: true, force: true });\n    }\n  });\n\n  test(\"ACC-PER-02: seed 10k tasks and 2k sessions; gc --dry-run reports and gc brings store under cap\", () => {\n    const testHome = tmp(\"gc-scale-home-\");\n    const nexusDir = path.join(testHome, \".nexus\");\n    const tasksDir = path.join(nexusDir, \"tasks\");\n    const sessionsDir = path.join(nexusDir, \"sessions\");\n    fs.mkdirSync(tasksDir, { recursive: true });\n    fs.mkdirSync(sessionsDir, { recursive: true });\n\n    try {\n      const now = Date.now();\n      const oldTime = new Date(now - 120 * 24 * 60 * 60 * 1000); // 120 days ago (expired by age)\n\n      // 1. Seed 10,000 tasks\n      // 8,000 old (>90 days), 2,000 recent\n      for (let i = 0; i < 10000; i++) {\n        const taskId = `task-${String(i).padStart(5, \"0\")}`;\n        const filePath = path.join(tasksDir, `${taskId}.json`);\n        const isOld = i < 8000;\n        const taskData = {\n          schemaVersion: 1,\n          taskId,\n          sessionId: taskId,\n          id: taskId,\n          workspacePath: isOld && i < 2000 ? `/tmp/nexus-app-test-${i}/repo` : `/home/user/work-${i % 20}`,\n          updatedAt: (isOld ? oldTime : new Date()).toISOString(),\n        };\n        fs.writeFileSync(filePath, JSON.stringify(taskData));\n        if (isOld) {\n          fs.utimesSync(filePath, oldTime, oldTime);\n        }\n      }\n\n      // 2. Seed 2,000 sessions (1,500 old, 500 recent, 1 pinned, 1 current)\n      for (let i = 0; i < 2000; i++) {\n        const sessionId = `session-${String(i).padStart(4, \"0\")}`;\n        const filePath = path.join(sessionsDir, `${sessionId}.json`);\n        const isOld = i < 1500;\n        const sessionData = {\n          schemaVersion: 1,\n          sessionId,\n          taskId: sessionId,\n          id: sessionId,\n          title: `Session ${i}`,\n          workspace: `/home/user/work-${i % 10}`,\n          updatedAt: (isOld ? oldTime : new Date()).toISOString(),\n          pinned: i === 10, // session-0010 is pinned!\n        };\n        fs.writeFileSync(filePath, JSON.stringify(sessionData));\n        if (isOld) {\n          fs.utimesSync(filePath, oldTime, oldTime);\n        }\n      }\n\n      // Build session index\n      const sm = new SessionManager(sessionsDir);\n      sm.rebuildIndex();\n\n      // 3. Dry run: plan retention\n      const currentSessionId = \"session-0020\"; // session-0020 is current\n      const plan = planRetention({\n        home: testHome,\n        currentSessionId,\n        maxAgeDays: 90,\n        maxSizeBytes: 5 * 1024 * 1024, // 5 MB cap\n      });\n\n      assert.equal(plan.totalScannedCount, 12000, \"Must scan all 12,000 records\");\n      assert.ok(plan.reclaimableCount >= 9400, `Expected >= 9400 reclaimable items, got ${plan.reclaimableCount}`);\n\n      // Ensure pinned and current sessions are NOT in reclaimable\n      assert.equal(plan.reclaimableItems.some((item) => item.id === \"session-0010\"), false, \"Pinned session must not be reclaimable\");\n      assert.equal(plan.reclaimableItems.some((item) => item.id === \"session-0020\"), false, \"Current session must not be reclaimable\");\n\n      // 4. Test --only-test-pollution dry-run\n      const pollutionPlan = planRetention({\n        home: testHome,\n        onlyTestPollution: true,\n      });\n      assert.ok(pollutionPlan.reclaimableCount >= 1000, `Expected test pollution items, got ${pollutionPlan.reclaimableCount}`);\n      assert.ok(pollutionPlan.reclaimableItems.every((item) => item.testPollution));\n\n      // 5. Execute GC\n      const gcResult = runRetentionGc({\n        home: testHome,\n        currentSessionId,\n        maxAgeDays: 90,\n        maxSizeBytes: 5 * 1024 * 1024,\n      });\n\n      assert.equal(gcResult.dryRun, false);\n      assert.ok(gcResult.deletedCount >= 9400, `Deleted count should be >= 9400, got ${gcResult.deletedCount}`);\n\n      // Verify pinned and current survived on disk\n      assert.ok(fs.existsSync(path.join(sessionsDir, \"session-0010.json\")), \"Pinned session must survive on disk\");\n      assert.ok(fs.existsSync(path.join(sessionsDir, \"session-0020.json\")), \"Current session must survive on disk\");\n\n      // Verify session listing works cleanly after GC\n      const remainingSessions = sm.listSessions();\n      assert.ok(remainingSessions.length > 0 && remainingSessions.length <= 600);\n      assert.ok(remainingSessions.some((s) => s.id === \"session-0010\"));\n    } finally {\n      fs.rmSync(testHome, { recursive: true, force: true });\n    }\n  });\n\n  test(\"Checkpoints git ref and snapshot pruning, flights pruning\", () => {\n    const testHome = tmp(\"cp-ret-home-\");\n    const testWs = tmp(\"cp-ret-ws-\");\n\n","exit_code":0,"duration":{"secs":0,"nanos":804622501}},"started_at_ms":1792830938279,"completed_at_ms":1792830939084}}
{"timestamp":"2026-10-24T08:35:40.667Z","ordinal":283076,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a16d0d-25fa-77f2-98e5-42f8b74033a2","call_id":"call_e4da5f943f5a4f98a7e2009f6cea9f5d","output":[{"type":"input_text","text":"Script completed\nWall time 3.6 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"0458e4\",\"wall_time_seconds\":0.805288463,\"exit_code\":0,\"original_token_count\":4656,\"output\":\"import * as fs from \\\"node:fs\\\";\\nimport * as path from \\\"node:path\\\";\\nimport * as os from \\\"node:os\\\";\\nimport { execSync } from \\\"node:child_process\\\";\\nimport { tryStateStoreGuard } from \\\"./state_store_guard.js\\\";\\nimport { ensurePrivateDir, writePrivateFile, fsyncDirectoryDurably } from \\\"./durable_file.js\\\";\\n\\nexport const DEFAULT_RETENTION_MAX_AGE_DAYS = 90; // DEC-11\\nexport const DEFAULT_RETENTION_MAX_SIZE_BYTES = 2 * 1024 * 1024 * 1024; // 2 GB (DEC-11)\\nexport const DEFAULT_AUTO_GC_TIME_BUDGET_MS = 2000; // 2 seconds (DEC-11)\\n\\nexport type RetentionItemKind = \\\"task\\\" | \\\"session\\\" | \\\"checkpoint\\\" | \\\"flight\\\";\\n\\nexport interface RetentionItem {\\n  kind: RetentionItemKind;\\n  id: string;\\n  primaryFile: string;\\n  associatedFiles: string[];\\n  /** Exact file identities captured by planning; changed records must be replanned. */\\n  fileIdentities?: Record<string, string | null>;\\n  primaryIdentity?: string;\\n  /** Checkpoint directory identities bind execution to the tree scanned by planning. */\\n  checkpointStateRootIdentity?: string;\\n  checkpointRootIdentity?: string;\\n  checkpointPartitionIdentity?: string;\\n  checkpointSnapshotsIdentity?: string;\\n  checkpointSnapshotRelativePath?: string;\\n  checkpointSnapshotIdentity?: string;\\n  /** Missing envelope tracked when collecting an orphaned companion group. */\\n  recordFile?: string;\\n  orphan?: boolean;\\n  workspace?: string;\\n  gitRef?: string;\\n  sizeBytes: number;\\n  mtimeMs: number;\\n  pinned?: boolean;\\n  current?: boolean;\\n  testPollution?: boolean;\\n  reason?: \\\"expired_age\\\" | \\\"size_cap_exceeded\\\" | \\\"test_pollution\\\";\\n}\\n\\nexport interface RetentionPolicyOptions {\\n  maxAgeDays?: number;\\n  maxSizeBytes?: number;\\n  dryRun?: boolean;\\n  onlyTestPollution?: boolean;\\n  timeBudgetMs?: number;\\n  deadline?: number;\\n  currentSessionId?: string;\\n  home?: string;\\n  workspace?: string;\\n}\\n\\nexport interface RetentionPlan {\\n  reclaimableItems: RetentionItem[];\\n  reclaimableBytes: number;\\n  reclaimableCount: number;\\n  totalScannedBytes: number;\\n  totalScannedCount: number;\\n  byKind: Record<RetentionItemKind, { count: number; bytes: number }>;\\n  timedOut: boolean;\\n  durationMs: number;\\n}\\n\\nexport interface GcExecutionResult {\\n  dryRun: boolean;\\n  scannedCount: number;\\n  scannedBytes: number;\\n  deletedCount: number;\\n  deletedBytes: number;\\n  deletedItems: RetentionItem[];\\n  byKind: Record<RetentionItemKind, { count: number; bytes: number }>;\\n  errors: Array<{ path: string; error: string }>;\\n  timedOut: boolean;\\n  durationMs: number;\\n}\\n\\nexport interface GcState {\\n  version: 1;\\n  acknowledged: boolean;\\n  acknowledgedAt?: string;\\n  lastRunAt?: string;\\n  lastRunSummary?: {\\n    scannedCount: number;\\n    deletedCount: number;\\n    deletedBytes: number;\\n    durationMs: number;\\n  };\\n}\\n\\nexport function isTestPollutionPath(wsPath?: string): boolean {\\n  if (!wsPath) return false;\\n  return /^\\\\/tmp\\\\/nexus-(app-)?test-/.test(wsPath) || /^\\\\/tmp\\\\/perm-/.test(wsPath);\\n}\\n\\nfunction safeStat(p: string): fs.Stats | null {\\n  try {\\n    return fs.statSync(p);\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nfunction fileObjectIdentity(stat: fs.Stats): string {\\n  return `${stat.dev}:${stat.ino}:${stat.mode}`;\\n}\\n\\nfunction directoryIdentity(stat: fs.Stats): string {\\n  return `${stat.dev}:${stat.ino}`;\\n}\\n\\nfunction computeDirSize(dir: string, deadline?: number): number {\\n  let size = 0;\\n  try {\\n    const entries = fs.readdirSync(dir, { withFileTypes: true });\\n    for (const entry of entries) {\\n      if (deadline && Date.now() >= deadline) break;\\n      const full = path.join(dir, entry.name);\\n      if (entry.isDirectory()) {\\n        size += computeDirSize(full, deadline);\\n      } else if (entry.isFile()) {\\n        const s = safeStat(full);\\n        if (s) size += s.size;\\n      }\\n    }\\n  } catch {}\\n  return size;\\n}\\n\\n/** Index companion files once; scanning all names for every task would be quadratic. */\\nfunction recordCompanions(directory: string, names: string[], deadline?: number): {\\n  records: Map<string, { files: string[]; bytes: number; mtimeMs: number }>;\\n  timedOut: boolean;\\n} {\\n  const records = new Map<string, { files: string[]; bytes: number; mtimeMs: number }>();\\n  for (const name of names) {\\n    if (deadline && Date.now() >= deadline) return { records, timedOut: true };\\n    let identity: string | undefined;\\n    if (name.endsWith(\\\".messages.jsonl\\\")) identity = name.slice(0, -\\\".messages.jsonl\\\".length);\\n    else if (name.endsWith(\\\".history.jsonl\\\")) identity = name.slice(0, -\\\".history.jsonl\\\".length);\\n    else identity = /^(.+)\\\\.json\\\\.pre-migration-v(?:0|[1-9]\\\\d*)$/.exec(name)?.[1];\\n    if (!identity) continue;\\n    const file = path.join(directory, name);\\n    try {\\n      const stat = fs.lstatSync(file);\\n      if (!stat.isFile()) continue;\\n      const record = records.get(identity) ?? { files: [], bytes: 0, mtimeMs: 0 };\\n      record.files.push(file);\\n      record.bytes += stat.size;\\n      record.mtimeMs = Math.max(record.mtimeMs, stat.mtimeMs);\\n      records.set(identity, record);\\n    } catch { /* A concurrently removed companion is already absent. */ }\\n  }\\n  return { records, timedOut: false };\\n}\\n\\n/** Retain/account for failed first publications and interrupted cleanup without inventing an age grace. */\\nfunction orphanCompanions(\\n  directory: string, names: string[], records: Map<string, { files: string[]; bytes: number; mtimeMs: number }>,\\n  kind: \\\"task\\\" | \\\"session\\\", currentSessionId?: string, deadline?: number,\\n): { items: RetentionItem[]; timedOut: boolean } {\\n  const present = new Set(names), items: RetentionItem[] = [];\\n  for (const [id, record] of records) {\\n    if (deadline && Date.now() >= deadline) return { items, timedOut: true };\\n    if (present.has(`${id}.json`) || !/^[A-Za-z0-9._-]{1,160}$/.test(id) || id === \\\".\\\" || id === \\\"..\\\") continue;\\n    const primaryFile = record.files[0];\\n    items.push({ kind, id, primaryFile, primaryIdentity: fileIdentity(primaryFile) ?? undefined,\\n      recordFile: path.join(directory, `${id}.json`), orphan: true,\\n      associatedFiles: record.files.slice(1), sizeBytes: record.bytes, mtimeMs: record.mtimeMs,\\n      current: currentSessionId === id });\\n  }\\n  return { items, timedOut: false };\\n}\\n\\ninterface EnvelopeMetadata {\\n  workspace?: string;\\n  pinned: boolean;\\n  sessionId?: string;\\n  taskId?: string;\\n  id?: string;\\n}\\n\\nconst MAX_DIRECT_ENVELOPE_READ_BYTES = 64 * 1024; // 64 KiB\\nconst MAX_SCAN_CHUNK_BYTES = 64 * 1024; // 64 KiB\\nconst MAX_METADATA_KEY_BYTES = 128; // All recognized keys fit even when fully JSON-escaped.\\nconst MAX_METADATA_VALUE_BYTES = 24 * 1024; // A 4 KiB path with every byte JSON-escaped.\\n\\nfunction readEnvelopeMetadata(\\n  filePath: string,\\n  stat: fs.Stats,\\n  deadline?: number\\n): { metadata: EnvelopeMetadata; timedOut: boolean } {\\n  if (deadline && Date.now() >= deadline) {\\n    return { metadata: { pinned: false }, timedOut: true };\\n  }\\n\\n  // Bounded streaming scanner for large legacy/unmigrated files.\\n  // Avoids buffering multi-megabyte inline messages or allocating memory proportional to file size.\\n  let fd: number | undefined;\\n  let timedOut = false;\\n  const result: EnvelopeMetadata = { pinned: false };\\n  const buf = Buffer.alloc(MAX_SCAN_CHUNK_BYTES);\\n  let unknownMetadata = false;\\n\\n  try {\\n    fd = fs.openSync(filePath, fs.constants.O_RDONLY | (fs.constants.O_NONBLOCK ?? 0) | (fs.constants.O_NOFOLLOW ?? 0));\\n    const opened = fs.fstatSync(fd);\\n    if (!opened.isFile()) throw new Error(\\\"Envelope metadata requires a regular file\\\");\\n    // The planning stat is only a hint: an atomic publication can replace that\\n    // file before open. Even growth after fstat cannot make this read unbounded.\\n    if (stat.size <= MAX_DIRECT_ENVELOPE_READ_BYTES && opened.size <= MAX_DIRECT_ENVELOPE_READ_BYTES) {\\n      const small = Buffer.alloc(MAX_DIRECT_ENVELOPE_READ_BYTES + 1);\\n      let size = 0;\\n      while (size < small.length) {\\n        const count = fs.readSync(fd, small, size, small.length - size, size);\\n        if (!count) break;\\n        size += count;\\n      }\\n      if (size <= MAX_DIRECT_ENVELOPE_READ_BYTES) {\\n        const parsed = JSON.parse(small.subarray(0, size).toString(\\\"utf8\\\"));\\n        return { metadata: {\\n          workspace: typeof parsed.workspacePath === \\\"string\\\" ? parsed.workspacePath : (typeof parsed.workspace === \\\"string\\\" ? parsed.workspace : undefined),\\n          pinned: Boolean(parsed.pinned),\\n          sessionId: typeof parsed.sessionId === \\\"string\\\" ? parsed.sessionId : undefined,\\n          taskId: typeof parsed.taskId === \\\"string\\\" ? parsed.taskId : undefined,\\n          id: typeof parsed.id === \\\"string\\\" ? parsed.id : undefined,\\n        }, timedOut: false };\\n      }\\n      // Positional reads leave fd at offset zero for the streaming fallback.\\n    }\\n    let depth = 0;\\n    let inString = false;\\n    let escaped = false;\\n    let key = \\\"\\\";\\n    let inKey = false;\\n    let afterColon = false;\\n    let val = \\\"\\\";\\n    let inValString = false;\\n    let stringOverflow = false;\\n    let scalar = \\\"\\\";\\n    const stringFields = new Set([\\\"workspace\\\", \\\"workspacePath\\\", \\\"sessionId\\\", \\\"taskId\\\", \\\"id\\\", \\\"pinned\\\"]);\\n    const decodeString = (raw: string): string => JSON.parse('\\\"' + Buffer.from(raw, \\\"latin1\\\").toString(\\\"utf8\\\") + '\\\"');\\n    const appendByte = (byte: number) => {\\n      if (inKey) {\\n        if (key.length < MAX_METADATA_KEY_BYTES) key += String.fromCharCode(byte);\\n        else stringOverflow = true;\\n      } else if (inValString) {\\n        if (val.length < MAX_METADATA_VALUE_BYTES) val += String.fromCharCode(byte);\\n        else stringOverflow = true;\\n      }\\n    };\\n    const finishPinnedScalar = () => {\\n      if (!scalar) return;\\n      try { result.pinned = Boolean(JSON.parse(scalar)); }\\n      catch { unknownMetadata = true; }\\n      scalar = \\\"\\\"; key = \\\"\\\"; afterColon = false;\\n    };\\n\\n    while (true) {\\n      if (deadline && Date.now() >= deadline) {\\n        timedOut = true;\\n        break;\\n      }\\n      const bytesRead = fs.readSync(fd, buf, 0, buf.length, null);\\n      if (bytesRead === 0) break;\\n\\n      for (let i = 0; i < bytesRead; i++) {\\n        const byte = buf[i];\\n        if (inString) {\\n          if (escaped) {\\n            escaped = false;\\n            appendByte(byte);\\n          } else if (byte === 92) { // \\\\\\n            appendByte(byte); // Preserve the escape for JSON.parse, including chunk boundaries.\\n            escaped = true;\\n          } else if (byte === 34) { // \\\"\\n            inString = false;\\n            if (inKey) {\\n              inKey = false;\\n              key = stringOverflow ? \\\"\\\" : decodeString(key);\\n              afterColon = false;\\n            } else if (inValString) {\\n              inValString = false;\\n              if (stringOverflow) unknownMetadata = true;\\n              else {\\n                const value = decodeString(val);\\n                if (key === \\\"workspace\\\" || key === \\\"workspacePath\\\") result.workspace = value;\\n                else if (key === \\\"sessionId\\\") result.sessionId = value;\\n                else if (key === \\\"taskId\\\") result.taskId = value;\\n                else if (key === \\\"id\\\") result.id = value;\\n                else if (key === \\\"pinned\\\") result.pinned = Boolean(value);\\n              }\\n              key = \\\"\\\";\\n              val = \\\"\\\";\\n            }\\n          } else {\\n            appendByte(byte);\\n          }\\n          continue;\\n        }\\n\\n        if (byte === 34) { // \\\"\\n          inString = true;\\n          if (depth === 1 && !afterColon) {\\n            inKey = true;\\n            key = \\\"\\\";\\n            stringOverflow = false;\\n          } else if (depth === 1 && afterColon) {\\n            inValString = stringFields.has(key);\\n            val = \\\"\\\";\\n            stringOverflow = false;\\n          }\\n          continue;\\n        }\\n\\n        if (byte === 123 || byte === 91) { // { or [\\n          if (depth === 1 && afterColon && key === \\\"pinned\\\") {\\n            result.pinned = true; key = \\\"\\\"; afterColon = false;\\n          }\\n          depth++;\\n          continue;\\n        }\\n        if (byte === 125 || byte === 93) { // } or ]\\n          if (depth === 1) finishPinnedScalar();\\n          depth--;\\n          if (depth === 0) break;\\n          continue;\\n        }\\n\\n        if (depth === 1) {\\n          if (byte === 58) { // :\\n            afterColon = true;\\n          } else if (byte === 44) { // ,\\n            finishPinnedScalar();\\n            afterColon = false;\\n            key = \\\"\\\";\\n          } else if (afterColon && key === \\\"pinned\\\") {\\n            if (byte === 32 || byte === 9 || byte === 10 || byte === 13) finishPinnedScalar();\\n            else if (scalar.length < MAX_METADATA_KEY_BYTES) scalar += String.fromCharCode(byte);\\n            else unknownMetadata = true;\\n          }\\n        }\\n      }\\n      if (depth === 0) break;\\n    }\\n  } catch {\\n    // Read errors retain existing defaults\\n  } finally {\\n    if (fd !== undefined) {\\n      try { fs.closeSync(fd); } catch {}\\n    }\\n  }\\n\\n  return { metadata: unknownMetadata ? { ...result, pinned: true } : result, timedOut };\\n}\\n\\nexport function scanTasks(tasksDir: string, checkTestPollution: boolean = false, deadline?: number, currentSessionId?: string): { items: RetentionItem[]; timedOut: boolean } {\\n  const items: RetentionItem[] = [];\\n  let timedOut = false;\\n  if (!fs.existsSync(tasksDir)) return { items, timedOut };\\n\\n  try {\\n    const entries = fs.readdirSync(tasksDir);\\n    const companions = recordCompanions(tasksDir, entries, deadline);\\n    if (companions.timedOut) return { items: [], timedOut: true };\\n    for (const name of entries) {\\n      if (deadline && Date.now() >= deadline) {\\n        timedOut = true;\\n        break;\\n      }\\n      if (!name.endsWith(\\\".json\\\") || name.startsWith(\\\".corrupt-\\\")) continue;\\n\\n      const fullPath = path.join(tasksDir, name);\\n      const stat = safeStat(fullPath);\\n      if (!stat || !stat.isFile()) continue;\\n\\n      const cleanId = name.replace(/\\\\.json$/, \\\"\\\");\\n      const companion = companions.records.get(cleanId);\\n      const totalSize = stat.size + (companion?.bytes ?? 0);\\n      const associatedFiles = companion?.files ?? [];\\n      assert.equal(list3.length, 1000);\\n      assert.ok(fs.existsSync(indexPath), \\\"index.json must be rebuilt when missing\\\");\\n    } finally {\\n      fs.rmSync(testHome, { recursive: true, force: true });\\n    }\\n  });\\n\\n  test(\\\"ACC-PER-02: seed 10k tasks and 2k sessions; gc --dry-run reports and gc brings store under cap\\\", () => {\\n    const testHome = tmp(\\\"gc-scale-home-\\\");\\n    const nexusDir = path.join(testHome, \\\".nexus\\\");\\n    const tasksDir = path.join(nexusDir, \\\"tasks\\\");\\n    const sessionsDir = path.join(nexusDir, \\\"sessions\\\");\\n    fs.mkdirSync(tasksDir, { recursive: true });\\n    fs.mkdirSync(sessionsDir, { recursive: true });\\n\\n    try {\\n      const now = Date.now();\\n      const oldTime = new Date(now - 120 * 24 * 60 * 60 * 1000); // 120 days ago (expired by age)\\n\\n      // 1. Seed 10,000 tasks\\n      // 8,000 old (>90 days), 2,000 recent\\n      for (let i = 0; i < 10000; i++) {\\n        const taskId = `task-${String(i).padStart(5, \\\"0\\\")}`;\\n        const filePath = path.join(tasksDir, `${taskId}.json`);\\n        const isOld = i < 8000;\\n        const taskData = {\\n          schemaVersion: 1,\\n          taskId,\\n          sessionId: taskId,\\n          id: taskId,\\n          workspacePath: isOld && i < 2000 ? `/tmp/nexus-app-test-${i}/repo` : `/home/user/work-${i % 20}`,\\n          updatedAt: (isOld ? oldTime : new Date()).toISOString(),\\n        };\\n        fs.writeFileSync(filePath, JSON.stringify(taskData));\\n        if (isOld) {\\n          fs.utimesSync(filePath, oldTime, oldTime);\\n        }\\n      }\\n\\n      // 2. Seed 2,000 sessions (1,500 old, 500 recent, 1 pinned, 1 current)\\n      for (let i = 0; i < 2000; i++) {\\n        const sessionId = `session-${String(i).padStart(4, \\\"0\\\")}`;\\n        const filePath = path.join(sessionsDir, `${sessionId}.json`);\\n        const isOld = i < 1500;\\n        const sessionData = {\\n          schemaVersion: 1,\\n          sessionId,\\n          taskId: sessionId,\\n          id: sessionId,\\n          title: `Session ${i}`,\\n          workspace: `/home/user/work-${i % 10}`,\\n          updatedAt: (isOld ? oldTime : new Date()).toISOString(),\\n          pinned: i === 10, // session-0010 is pinned!\\n        };\\n        fs.writeFileSync(filePath, JSON.stringify(sessionData));\\n        if (isOld) {\\n          fs.utimesSync(filePath, oldTime, oldTime);\\n        }\\n      }\\n\\n      // Build session index\\n      const sm = new SessionManager(sessionsDir);\\n      sm.rebuildIndex();\\n\\n      // 3. Dry run: plan retention\\n      const currentSessionId = \\\"session-0020\\\"; // session-0020 is current\\n      const plan = planRetention({\\n        home: testHome,\\n        currentSessionId,\\n        maxAgeDays: 90,\\n        maxSizeBytes: 5 * 1024 * 1024, // 5 MB cap\\n      });\\n\\n      assert.equal(plan.totalScannedCount, 12000, \\\"Must scan all 12,000 records\\\");\\n      assert.ok(plan.reclaimableCount >= 9400, `Expected >= 9400 reclaimable items, got ${plan.reclaimableCount}`);\\n\\n      // Ensure pinned and current sessions are NOT in reclaimable\\n      assert.equal(plan.reclaimableItems.some((item) => item.id === \\\"session-0010\\\"), false, \\\"Pinned session must not be reclaimable\\\");\\n      assert.equal(plan.reclaimableItems.some((item) => item.id === \\\"session-0020\\\"), false, \\\"Current session must not be reclaimable\\\");\\n\\n      // 4. Test --only-test-pollution dry-run\\n      const pollutionPlan = planRetention({\\n        home: testHome,\\n        onlyTestPollution: true,\\n      });\\n      assert.ok(pollutionPlan.reclaimableCount >= 1000, `Expected test pollution items, got ${pollutionPlan.reclaimableCount}`);\\n      assert.ok(pollutionPlan.reclaimableItems.every((item) => item.testPollution));\\n\\n      // 5. Execute GC\\n      const gcResult = runRetentionGc({\\n        home: testHome,\\n        currentSessionId,\\n        maxAgeDays: 90,\\n        maxSizeBytes: 5 * 1024 * 1024,\\n      });\\n\\n      assert.equal(gcResult.dryRun, false);\\n      assert.ok(gcResult.deletedCount >= 9400, `Deleted count should be >= 9400, got ${gcResult.deletedCount}`);\\n\\n      // Verify pinned and current survived on disk\\n      assert.ok(fs.existsSync(path.join(sessionsDir, \\\"session-0010.json\\\")), \\\"Pinned session must survive on disk\\\");\\n      assert.ok(fs.existsSync(path.join(sessionsDir, \\\"session-0020.json\\\")), \\\"Current session must survive on disk\\\");\\n\\n      // Verify session listing works cleanly after GC\\n      const remainingSessions = sm.listSessions();\\n      assert.ok(remainingSessions.length > 0 && remainingSessions.length <= 600);\\n      assert.ok(remainingSessions.some((s) => s.id === \\\"session-0010\\\"));\\n    } finally {\\n      fs.rmSync(testHome, { recursive: true, force: true });\\n    }\\n  });\\n\\n  test(\\\"Checkpoints git ref and snapshot pruning, flights pruning\\\", () => {\\n    const testHome = tmp(\\\"cp-ret-home-\\\");\\n    const testWs = tmp(\\\"cp-ret-ws-\\\");\\n\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16cd4-55fc-7d42-952d-a5ba875e9e0d","create_time":1792830940.6669858}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
