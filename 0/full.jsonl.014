{"timestamp":"2026-10-24T14:04:10.449Z","ordinal":291767,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16e34-cb69-7fb3-96f2-8eec5d8c48cb","item":{"type":"CommandExecution","id":"exec-1c75fb89-d18d-466d-ac5a-f8ab41297be9","process_id":"42297","command":["/usr/bin/zsh","-lc","git show origin/main:cli/src/index.ts | sed -n '1,180p'; git show origin/main:cli/src/workspace_trust.ts | sed -n '1,220p'; git tag --list 'v1.0.0-rc*' --sort=-version:refname | head -5; git show-ref --tags | rg 'rc\\.4' || true"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git show origin/main:cli/src/index.ts | sed -n '1,180p'; git show origin/main:cli/src/workspace_trust.ts | sed -n '1,220p'; git tag --list 'v1.0.0-rc*' --sort=-version:refname | head -5; git show-ref --tags | rg 'rc\\.4' || true"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"#!/usr/bin/env node\nimport { Command } from \"commander\";\nimport * as path from \"node:path\";\nimport * as fs from \"node:fs\";\nimport { execSync, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { AutonomousAgent } from \"./agent.js\";\nimport { ApplicationCore } from \"./core/app.js\";\nimport { InteractiveRepl } from \"./repl.js\";\nimport { LocalLlmClient } from \"./client.js\";\nimport { SessionManager } from \"./session.js\";\nimport { SkillManager } from \"./skills.js\";\nimport { McpClientManager } from \"./mcp.js\";\nimport { PluginManager } from \"./plugins.js\";\nimport { HarnessConfig } from \"./types.js\";\nimport { FlightPlayer } from \"./flight.js\";\nimport { WorktreeManager } from \"./worktree.js\";\nimport { HunkStager } from \"./stager.js\";\nimport { BenchmarkEvaluator } from \"./evaluator.js\";\nimport { SynthesizerEngine } from \"./synthesizer.js\";\nimport { BrowserDriver } from \"./browser.js\";\nimport { KnowledgeGraph } from \"./knowledge.js\";\nimport { TaskStateNotFoundError } from \"./core/state.js\";\nimport { buildConfig as buildConfigOrThrow, loadEnvironment } from \"./config.js\";\nimport { describeTarget, registerProviderCommands } from \"./provider_cli.js\";\nimport { UsageLedger } from \"./usage.js\";\nimport { DOCTOR_EXIT, DOCTOR_SCHEMA_VERSION, doctorExitCode, redactDiagnostic, renderDoctorJson, renderDoctorText, runDoctor, runRepairs } from \"./doctor.js\";\nimport { promptWorkspaceTrust } from \"./startup_trust.js\";\n\nfunction collectDeliverableFile(value: string, previous: string[] = []): string[] {\n  return [...previous, value];\n}\n\n/** Configuration errors (unknown provider, missing model or base URL) end the command with a message, not a trace. */\nfunction buildConfig(options: any): HarnessConfig {\n  try {\n    return buildConfigOrThrow(options);\n  } catch (err: any) {\n    console.error(pc.red(`Configuration error: ${err?.message ?? err}`));\n    process.exit(2);\n  }\n}\nimport { registerOperationCommands } from \"./operation_cli.js\";\nimport pc from \"picocolors\";\n\nimport * as os from \"node:os\";\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\n// Keep the lease for the full frontend/sidecar lifetime, including synchronous\n// TUI dispatch. Maintenance recovery acquires its own exclusive lease instead.\nconst startupArgs = process.argv.slice(2);\nconst { acquireClientLease, releaseClientLease, clientInvocationKind } = await import(\"./core/client_lease.js\");\nconst invocationKind = clientInvocationKind(startupArgs);\nconst startupReadOnly = invocationKind === \"metadata\" || (startupArgs[0] === \"upgrade\" && startupArgs.includes(\"--check\"));\n// `upgrade --check` is read-only, so it must not replay a transaction. It also\n// must not load configuration while a restore journal says that config may be\n// only partially applied. Refuse before loadEnvironment() and let a normal\n// managed launch perform recovery.\nif (startupArgs[0] === \"upgrade\" && startupArgs.includes(\"--check\")) {\n  try {\n    const { hasPendingStateRestore } = await import(\"./core/state_restore.js\");\n    if (hasPendingStateRestore(process.env.HOME || os.homedir())) {\n      throw new Error(\"Pending state restore must be recovered before running upgrade --check\");\n    }\n  } catch (error: any) {\n    console.error(`[maintenance] ${error?.message ?? \"Nexus restore state could not be verified\"}`);\n    process.exit(2);\n  }\n}\n// A durable state-restore intent must be replayed before environment/config\n// loading or any normal client is admitted. The recovery command takes the\n// exclusive lifetime lease; ordinary clients take their shared lease below.\nif (invocationKind === \"restore\" || (invocationKind === \"client\" && !startupReadOnly)) {\n  try {\n    const { hasPendingStateRestore, recoverPendingStateRestore } = await import(\"./core/state_restore.js\");\n    const home = process.env.HOME || os.homedir();\n    if (hasPendingStateRestore(home) && !recoverPendingStateRestore(home)) {\n      throw new Error(\"Pending state restore could not be recovered; no state was admitted\");\n    }\n  } catch (error: any) {\n    console.error(`[maintenance] ${error?.message ?? \"Nexus restore recovery failed closed\"}`);\n    process.exit(2);\n  }\n}\nif (invocationKind === \"client\") {\n  try {\n    const lease = acquireClientLease(process.env.HOME || os.homedir());\n    process.once(\"exit\", () => releaseClientLease(lease));\n  } catch (error: any) {\n    console.error(`[maintenance] ${error.message}`);\n    process.exit(2);\n  }\n  loadEnvironment();\n}\n\n// Diagnose an interrupted packaged upgrade before launching a new CLI/TUI\n// session. Read-only version/help/check commands never recover or write state.\nif (!startupReadOnly && startupArgs[0] !== \"upgrade\" && process.env.NEXUS_UPGRADE_HEALTH_CHECK !== \"1\" && process.env.NEXUS_HOME) {\n  const { getJournalPath, readJournal, recoverUpgrade } = await import(\"./upgrade_journal.js\");\n  const packagedPrefix = path.resolve(process.env.NEXUS_HOME, \"../../..\");\n  const journal = readJournal(packagedPrefix);\n  if ((journal && ![\"idle\", \"complete\", \"rolled_back\"].includes(journal.state)) || (!journal && fs.existsSync(getJournalPath(packagedPrefix)))) {\n    const outcome = recoverUpgrade(packagedPrefix);\n    if (outcome.action === \"upgrade_in_progress\") console.error(`[upgrade] ${outcome.details}`);\n    if (outcome.action === \"manual_intervention\") {\n      console.error(`[upgrade] ${outcome.details}. Run nexus upgrade --recover after resolving the recorded failure.`);\n      process.exit(2);\n    }\n    if (outcome.recovered) console.warn(`[upgrade] ${outcome.details}`);\n  }\n}\n\n/**\n * Exits once stdout and stderr have accepted everything written so far. A write to a pipe is asynchronous, so an immediate\n * `process.exit()` drops whatever the pipe has not yet taken (65,536 bytes on Linux) while still exiting with the intended code.\n */\nfunction exitAfterFlush(code: number): void {\n  let pending = 2;\n  const done = () => { if (--pending === 0) process.exit(code); };\n  process.stdout.write(\"\", done);\n  process.stderr.write(\"\", done);\n}\n\nimport { getBuildIdentity } from \"./build_identity.js\";\n\nfunction isExecutable(filePath: string): boolean {\n  try {\n    fs.accessSync(filePath, fs.constants.X_OK);\n    return fs.statSync(filePath).isFile();\n  } catch {\n    return false;\n  }\n}\n\nfunction resolveTuiBinary(): string | undefined {\n  if (process.env.NEXUS_TUI_BIN && isExecutable(process.env.NEXUS_TUI_BIN)) {\n    return process.env.NEXUS_TUI_BIN;\n  }\n  if (process.env.NEXUS_HOME) {\n    const packaged = path.join(process.env.NEXUS_HOME, \"lib\", \"core\", \"nexus-tui\");\n    if (isExecutable(packaged)) return packaged;\n  }\n  const root = process.env.NEXUS_ROOT || path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n  const releaseTui = path.join(root, \"core\", \"target\", \"release\", \"nexus-tui\");\n  if (isExecutable(releaseTui)) return releaseTui;\n  const debugTui = path.join(root, \"core\", \"target\", \"debug\", \"nexus-tui\");\n  if (isExecutable(debugTui)) return debugTui;\n  return undefined;\n}\n\nfunction resolveSidecarScript(): string | undefined {\n  if (process.env.NEXUS_SIDECAR && fs.existsSync(process.env.NEXUS_SIDECAR)) {\n    return process.env.NEXUS_SIDECAR;\n  }\n  if (process.env.NEXUS_HOME) {\n    const packaged = path.join(process.env.NEXUS_HOME, \"lib\", \"cli\", \"dist\", \"sidecar.js\");\n    if (fs.existsSync(packaged)) return packaged;\n  }\n  const root = process.env.NEXUS_ROOT;\n  if (root) {\n    const rootSidecar = path.join(root, \"cli\", \"dist\", \"sidecar.js\");\n    if (fs.existsSync(rootSidecar)) return rootSidecar;\n  }\n  const currentDir = path.dirname(fileURLToPath(import.meta.url));\n  const direct = path.join(currentDir, \"sidecar.js\");\n  if (fs.existsSync(direct)) return direct;\n  const repoRoot = path.resolve(currentDir, \"..\", \"..\");\n  const checkout = path.join(repoRoot, \"cli\", \"dist\", \"sidecar.js\");\n  if (fs.existsSync(checkout)) return checkout;\n  return undefined;\n}\n\nfunction spawnTui(tuiBin: string, sidecarScript: string): void {\n  const passthrough = process.argv.slice(2).filter((arg) => arg !== \"--live\" && arg !== \"--repl\");\n  const result = spawnSync(\n    tuiBin,\n    [\"--live\", \"--sidecar\", sidecarScript, \"--node\", process.execPath, \"--\", ...passthrough],\n    { stdio: \"inherit\" }\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\n\n/** Workspace files that configure MCP servers, and directories plugins are loaded from: used only when trusted. */\nexport const WORKSPACE_MCP_FILES = [\".mcp.json\", \"mcp.json\"];\nexport const WORKSPACE_PLUGIN_DIRS = [path.join(\".nexus\", \"plugins\"), \"plugins\"];\n\n/**\n * The workspace's own MCP configuration files and plugin modules that exist but are not loaded because the workspace\n * is not trusted (or the session is read-only). Empty when there are none or the workspace is trusted.\n */\nexport function untrustedWorkspaceExtensions(workspace: string, readOnly = false): string[] {\n  if (isWorkspaceTrusted(workspace, readOnly)) return [];\n  const root = path.resolve(workspace);\n  const found = WORKSPACE_MCP_FILES.map((f) => path.join(root, f)).filter((f) => fs.existsSync(f));\n  for (const dir of WORKSPACE_PLUGIN_DIRS) {\n    try {\n      for (const name of fs.readdirSync(path.join(root, dir))) {\n        if (name.endsWith(\".js\") || name.endsWith(\".mjs\")) found.push(path.join(root, dir, name));\n      }\n    } catch {}\n  }\n  return found;\n}\n\nexport function getTrustStorePath(): string {\n  return path.join(os.homedir(), \".config\", \"nexus\", \"trusted_workspaces.json\");\n}\n\n/**\n * Check if the given workspace is explicitly trusted by the operator.\n * In --read-only mode, workspace trust never authorizes executing project plugins/MCP.\n */\nexport function isWorkspaceTrusted(workspace: string, readOnly = false): boolean {\n  if (readOnly) return false;\n  if (process.env.NEXUS_TRUST_WORKSPACE === \"1\") return true;\n\n  try {\n    const resolved = path.resolve(workspace);\n    const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\n    const storePath = getTrustStorePath();\n    if (!fs.existsSync(storePath)) return false;\n    const content = JSON.parse(fs.readFileSync(storePath, \"utf8\"));\n    if (Array.isArray(content)) {\n      return content.includes(realWs);\n    }\n    if (content && typeof content === \"object\" && Array.isArray(content.trustedPaths)) {\n      return content.trustedPaths.includes(realWs);\n    }\n  } catch {}\n  return false;\n}\n\n/** The trusted workspaces (real paths), as recorded in the trust store. */\nexport function listTrustedWorkspaces(): string[] {\n  try {\n    const raw = JSON.parse(fs.readFileSync(getTrustStorePath(), \"utf8\"));\n    const list = Array.isArray(raw) ? raw : Array.isArray(raw?.trustedPaths) ? raw.trustedPaths : [];\n    return list.filter((p: unknown): p is string => typeof p === \"string\");\n  } catch {\n    return [];\n  }\n}\n\n/** Records (or removes) the operator's trust in a workspace. Returns its real path; throws when the store cannot be written. */\nexport function setWorkspaceTrusted(workspace: string, trusted: boolean): string {\n  const resolved = path.resolve(workspace);\n  const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\n  const storePath = getTrustStorePath();\n  fs.mkdirSync(path.dirname(storePath), { recursive: true, mode: 0o700 });\n  const list = listTrustedWorkspaces().filter((p) => p !== realWs);\n  if (trusted) list.push(realWs);\n  const temp = `${storePath}.${process.pid}.tmp`;\n  fs.writeFileSync(temp, JSON.stringify({ trustedPaths: list }, null, 2), { mode: 0o600 });\n  fs.renameSync(temp, storePath);\n  return realWs;\n}\nv1.0.0-rc.4\nv1.0.0-rc.3\nv1.0.0-rc.2\nv1.0.0-rc.1\n79b2f4fab6b9584c4e4e3245a5359f009889b7e2 refs/tags/v1.0.0-rc.4\n","exit_code":0,"duration":{"secs":0,"nanos":27979}},"started_at_ms":1792850650448,"completed_at_ms":1792850650449}}
{"timestamp":"2026-10-24T14:04:11.399Z","ordinal":291768,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a16e39-e906-73e3-9f01-c03b100772c8","call_id":"call_81e2f81b40a64360be9e5b880d78341a","output":[{"type":"input_text","text":"Script completed\nWall time 2.0 seconds\nOutput:\n"},{"type":"input_text","text":"#!/usr/bin/env node\nimport { Command } from \"commander\";\nimport * as path from \"node:path\";\nimport * as fs from \"node:fs\";\nimport { execSync, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { AutonomousAgent } from \"./agent.js\";\nimport { ApplicationCore } from \"./core/app.js\";\nimport { InteractiveRepl } from \"./repl.js\";\nimport { LocalLlmClient } from \"./client.js\";\nimport { SessionManager } from \"./session.js\";\nimport { SkillManager } from \"./skills.js\";\nimport { McpClientManager } from \"./mcp.js\";\nimport { PluginManager } from \"./plugins.js\";\nimport { HarnessConfig } from \"./types.js\";\nimport { FlightPlayer } from \"./flight.js\";\nimport { WorktreeManager } from \"./worktree.js\";\nimport { HunkStager } from \"./stager.js\";\nimport { BenchmarkEvaluator } from \"./evaluator.js\";\nimport { SynthesizerEngine } from \"./synthesizer.js\";\nimport { BrowserDriver } from \"./browser.js\";\nimport { KnowledgeGraph } from \"./knowledge.js\";\nimport { TaskStateNotFoundError } from \"./core/state.js\";\nimport { buildConfig as buildConfigOrThrow, loadEnvironment } from \"./config.js\";\nimport { describeTarget, registerProviderCommands } from \"./provider_cli.js\";\nimport { UsageLedger } from \"./usage.js\";\nimport { DOCTOR_EXIT, DOCTOR_SCHEMA_VERSION, doctorExitCode, redactDiagnostic, renderDoctorJson, renderDoctorText, runDoctor, runRepairs } from \"./doctor.js\";\nimport { promptWorkspaceTrust } from \"./startup_trust.js\";\n\nfunction collectDeliverableFile(value: string, previous: string[] = []): string[] {\n  return [...previous, value];\n}\n\n/** Configuration errors (unknown provider, missing model or base URL) end the command with a message, not a trace. */\nfunction buildConfig(options: any): HarnessConfig {\n  try {\n    return buildConfigOrThrow(options);\n  } catch (err: any) {\n    console.error(pc.red(`Configuration error: ${err?.message ?? err}`));\n    process.exit(2);\n  }\n}\nimport { registerOperationCommands } from \"./operation_cli.js\";\nimport pc from \"picocolors\";\n\nimport * as os from \"node:os\";\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\n// Keep the lease for the full frontend/sidecar lifetime, including synchronous\n// TUI dispatch. Maintenance recovery acquires its own exclusive lease instead.\nconst startupArgs = process.argv.slice(2);\nconst { acquireClientLease, releaseClientLease, clientInvocationKind } = await import(\"./core/client_lease.js\");\nconst invocationKind = clientInvocationKind(startupArgs);\nconst startupReadOnly = invocationKind === \"metadata\" || (startupArgs[0] === \"upgrade\" && startupArgs.includes(\"--check\"));\n// `upgrade --check` is read-only, so it must not replay a transaction. It also\n// must not load configuration while a restore journal says that config may be\n// only partially applied. Refuse before loadEnvironment() and let a normal\n// managed launch perform recovery.\nif (startupArgs[0] === \"upgrade\" && startupArgs.includes(\"--check\")) {\n  try {\n    const { hasPendingStateRestore } = await import(\"./core/state_restore.js\");\n    if (hasPendingStateRestore(process.env.HOME || os.homedir())) {\n      throw new Error(\"Pending state restore must be recovered before running upgrade --check\");\n    }\n  } catch (error: any) {\n    console.error(`[maintenance] ${error?.message ?? \"Nexus restore state could not be verified\"}`);\n    process.exit(2);\n  }\n}\n// A durable state-restore intent must be replayed before environment/config\n// loading or any normal client is admitted. The recovery command takes the\n// exclusive lifetime lease; ordinary clients take their shared lease below.\nif (invocationKind === \"restore\" || (invocationKind === \"client\" && !startupReadOnly)) {\n  try {\n    const { hasPendingStateRestore, recoverPendingStateRestore } = await import(\"./core/state_restore.js\");\n    const home = process.env.HOME || os.homedir();\n    if (hasPendingStateRestore(home) && !recoverPendingStateRestore(home)) {\n      throw new Error(\"Pending state restore could not be recovered; no state was admitted\");\n    }\n  } catch (error: any) {\n    console.error(`[maintenance] ${error?.message ?? \"Nexus restore recovery failed closed\"}`);\n    process.exit(2);\n  }\n}\nif (invocationKind === \"client\") {\n  try {\n    const lease = acquireClientLease(process.env.HOME || os.homedir());\n    process.once(\"exit\", () => releaseClientLease(lease));\n  } catch (error: any) {\n    console.error(`[maintenance] ${error.message}`);\n    process.exit(2);\n  }\n  loadEnvironment();\n}\n\n// Diagnose an interrupted packaged upgrade before launching a new CLI/TUI\n// session. Read-only version/help/check commands never recover or write state.\nif (!startupReadOnly && startupArgs[0] !== \"upgrade\" && process.env.NEXUS_UPGRADE_HEALTH_CHECK !== \"1\" && process.env.NEXUS_HOME) {\n  const { getJournalPath, readJournal, recoverUpgrade } = await import(\"./upgrade_journal.js\");\n  const packagedPrefix = path.resolve(process.env.NEXUS_HOME, \"../../..\");\n  const journal = readJournal(packagedPrefix);\n  if ((journal && ![\"idle\", \"complete\", \"rolled_back\"].includes(journal.state)) || (!journal && fs.existsSync(getJournalPath(packagedPrefix)))) {\n    const outcome = recoverUpgrade(packagedPrefix);\n    if (outcome.action === \"upgrade_in_progress\") console.error(`[upgrade] ${outcome.details}`);\n    if (outcome.action === \"manual_intervention\") {\n      console.error(`[upgrade] ${outcome.details}. Run nexus upgrade --recover after resolving the recorded failure.`);\n      process.exit(2);\n    }\n    if (outcome.recovered) console.warn(`[upgrade] ${outcome.details}`);\n  }\n}\n\n/**\n * Exits once stdout and stderr have accepted everything written so far. A write to a pipe is asynchronous, so an immediate\n * `process.exit()` drops whatever the pipe has not yet taken (65,536 bytes on Linux) while still exiting with the intended code.\n */\nfunction exitAfterFlush(code: number): void {\n  let pending = 2;\n  const done = () => { if (--pending === 0) process.exit(code); };\n  process.stdout.write(\"\", done);\n  process.stderr.write(\"\", done);\n}\n\nimport { getBuildIdentity } from \"./build_identity.js\";\n\nfunction isExecutable(filePath: string): boolean {\n  try {\n    fs.accessSync(filePath, fs.constants.X_OK);\n    return fs.statSync(filePath).isFile();\n  } catch {\n    return false;\n  }\n}\n\nfunction resolveTuiBinary(): string | undefined {\n  if (process.env.NEXUS_TUI_BIN && isExecutable(process.env.NEXUS_TUI_BIN)) {\n    return process.env.NEXUS_TUI_BIN;\n  }\n  if (process.env.NEXUS_HOME) {\n    const packaged = path.join(process.env.NEXUS_HOME, \"lib\", \"core\", \"nexus-tui\");\n    if (isExecutable(packaged)) return packaged;\n  }\n  const root = process.env.NEXUS_ROOT || path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n  const releaseTui = path.join(root, \"core\", \"target\", \"release\", \"nexus-tui\");\n  if (isExecutable(releaseTui)) return releaseTui;\n  const debugTui = path.join(root, \"core\", \"target\", \"debug\", \"nexus-tui\");\n  if (isExecutable(debugTui)) return debugTui;\n  return undefined;\n}\n\nfunction resolveSidecarScript(): string | undefined {\n  if (process.env.NEXUS_SIDECAR && fs.existsSync(process.env.NEXUS_SIDECAR)) {\n    return process.env.NEXUS_SIDECAR;\n  }\n  if (process.env.NEXUS_HOME) {\n    const packaged = path.join(process.env.NEXUS_HOME, \"lib\", \"cli\", \"dist\", \"sidecar.js\");\n    if (fs.existsSync(packaged)) return packaged;\n  }\n  const root = process.env.NEXUS_ROOT;\n  if (root) {\n    const rootSidecar = path.join(root, \"cli\", \"dist\", \"sidecar.js\");\n    if (fs.existsSync(rootSidecar)) return rootSidecar;\n  }\n  const currentDir = path.dirname(fileURLToPath(import.meta.url));\n  const direct = path.join(currentDir, \"sidecar.js\");\n  if (fs.existsSync(direct)) return direct;\n  const repoRoot = path.resolve(currentDir, \"..\", \"..\");\n  const checkout = path.join(repoRoot, \"cli\", \"dist\", \"sidecar.js\");\n  if (fs.existsSync(checkout)) return checkout;\n  return undefined;\n}\n\nfunction spawnTui(tuiBin: string, sidecarScript: string): void {\n  const passthrough = process.argv.slice(2).filter((arg) => arg !== \"--live\" && arg !== \"--repl\");\n  const result = spawnSync(\n    tuiBin,\n    [\"--live\", \"--sidecar\", sidecarScript, \"--node\", process.execPath, \"--\", ...passthrough],\n    { stdio: \"inherit\" }\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\n\n/** Workspace files that configure MCP servers, and directories plugins are loaded from: used only when trusted. */\nexport const WORKSPACE_MCP_FILES = [\".mcp.json\", \"mcp.json\"];\nexport const WORKSPACE_PLUGIN_DIRS = [path.join(\".nexus\", \"plugins\"), \"plugins\"];\n\n/**\n * The workspace's own MCP configuration files and plugin modules that exist but are not loaded because the workspace\n * is not trusted (or the session is read-only). Empty when there are none or the workspace is trusted.\n */\nexport function untrustedWorkspaceExtensions(workspace: string, readOnly = false): string[] {\n  if (isWorkspaceTrusted(workspace, readOnly)) return [];\n  const root = path.resolve(workspace);\n  const found = WORKSPACE_MCP_FILES.map((f) => path.join(root, f)).filter((f) => fs.existsSync(f));\n  for (const dir of WORKSPACE_PLUGIN_DIRS) {\n    try {\n      for (const name of fs.readdirSync(path.join(root, dir))) {\n        if (name.endsWith(\".js\") || name.endsWith(\".mjs\")) found.push(path.join(root, dir, name));\n      }\n    } catch {}\n  }\n  return found;\n}\n\nexport function getTrustStorePath(): string {\n  return path.join(os.homedir(), \".config\", \"nexus\", \"trusted_workspaces.json\");\n}\n\n/**\n * Check if the given workspace is explicitly trusted by the operator.\n * In --read-only mode, workspace trust never authorizes executing project plugins/MCP.\n */\nexport function isWorkspaceTrusted(workspace: string, readOnly = false): boolean {\n  if (readOnly) return false;\n  if (process.env.NEXUS_TRUST_WORKSPACE === \"1\") return true;\n\n  try {\n    const resolved = path.resolve(workspace);\n    const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\n    const storePath = getTrustStorePath();\n    if (!fs.existsSync(storePath)) return false;\n    const content = JSON.parse(fs.readFileSync(storePath, \"utf8\"));\n    if (Array.isArray(content)) {\n      return content.includes(realWs);\n    }\n    if (content && typeof content === \"object\" && Array.isArray(content.trustedPaths)) {\n      return content.trustedPaths.includes(realWs);\n    }\n  } catch {}\n  return false;\n}\n\n/** The trusted workspaces (real paths), as recorded in the trust store. */\nexport function listTrustedWorkspaces(): string[] {\n  try {\n    const raw = JSON.parse(fs.readFileSync(getTrustStorePath(), \"utf8\"));\n    const list = Array.isArray(raw) ? raw : Array.isArray(raw?.trustedPaths) ? raw.trustedPaths : [];\n    return list.filter((p: unknown): p is string => typeof p === \"string\");\n  } catch {\n    return [];\n  }\n}\n\n/** Records (or removes) the operator's trust in a workspace. Returns its real path; throws when the store cannot be written. */\nexport function setWorkspaceTrusted(workspace: string, trusted: boolean): string {\n  const resolved = path.resolve(workspace);\n  const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\n  const storePath = getTrustStorePath();\n  fs.mkdirSync(path.dirname(storePath), { recursive: true, mode: 0o700 });\n  const list = listTrustedWorkspaces().filter((p) => p !== realWs);\n  if (trusted) list.push(realWs);\n  const temp = `${storePath}.${process.pid}.tmp`;\n  fs.writeFileSync(temp, JSON.stringify({ trustedPaths: list }, null, 2), { mode: 0o600 });\n  fs.renameSync(temp, storePath);\n  return realWs;\n}\nv1.0.0-rc.4\nv1.0.0-rc.3\nv1.0.0-rc.2\nv1.0.0-rc.1\n79b2f4fab6b9584c4e4e3245a5359f009889b7e2 refs/tags/v1.0.0-rc.4\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16e34-cb69-7fb3-96f2-8eec5d8c48cb","create_time":1792850651.3988614}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
