![Span::styled(\"enter\", key), Span::styled(\", then \", muted), Span::styled(\"enter\", key), Span::styled(\" again, approves this and every later action\", muted)]\n        },\n        Some(Verdict::Denied) if !approval.letters => if narrow {\n            vec![Span::styled(\"enter\", key), Span::styled(\" denies · \", muted), Span::styled(\"←\", key), Span::styled(\" approve\", muted)]\n        } else {\n            vec![Span::styled(\"pause, then \", muted), Span::styled(\"enter\", key), Span::styled(\" denies  \", muted), Span::styled(\"←\", key), Span::styled(\" approve  \", muted), Span::styled(\"esc\", key), Span::styled(\" denies\", muted)]\n        },\n        Some(Verdict::Denied) => if narrow {\n            vec![Span::styled(\"enter\", key), Span::styled(\" denies · \", muted), Span::styled(\"←\", key), Span::styled(\" approve\", muted)]\n        } else {\n            vec![Span::styled(\"enter\", key), Span::styled(\" denies  \", muted), Span::styled(\"←\", key), Span::styled(\" approve  \", muted), Span::styled(\"↑↓\", key), Span::styled(\" scroll\", muted)]\n        },\n        None if approval.letters => vec![Span::styled(\"y\", key), Span::styled(\" or \", muted), Span::styled(\"n\", key), Span::styled(\", or \", muted), Span::styled(\"←→\", key), Span::styled(\" then \", muted), Span::styled(\"enter\", key), Span::styled(if narrow { \"\" } else { \" · ↑↓ scroll the change\" }, muted)],\n        // The operator was typing: letters are not answers for this panel.\n        None => if narrow {\n            vec![Span::styled(\"←→\", key), Span::styled(\" choose, \", muted), Span::styled(\"enter\", key), Span::styled(\" · \", muted), Span::styled(\"esc\", key), Span::styled(\" denies\", muted)]\n        } else {\n            vec![Span::styled(\"typing ignored · \", muted), Span::styled(\"←→\", key), Span::styled(\" approve/deny, pause, \", muted), Span::styled(\"enter\", key), Span::styled(\" · \", muted), Span::styled(\"esc\", key), Span::styled(\" denies\", muted)]\n        },\n    };\n    let lines: Vec<Line> = match &approval.patch {\n        Some(patch) => {\n            let geo = Geometry { width, indent: 1, num_width: diff_view::patch_num_width(patch) };\n            diff_view::panel_rows(patch)\n                .into_iter()\n                .filter(|row| !matches!(row, diff_view::Row::File(_) | diff_view::Row::Blank))\n                .flat_map(|row| diff_view::panel_row_lines(patch, row, geo, Fit::Wrap, &pal))\n                .collect()\n        }\n        None => approval.lines.iter().map(review_line).collect(),\n    };\n    // The panel fits its content (heading, the change, decisions) and never needs more than the area; the hint row\n    // is the first thing dropped when space is short, then the gap rows.\n    let available = usize::from(area.height.saturating_sub(2));\n                {\n                    file.status = diff_view::Status::Added;\n                }\n                let approval = Approval {\n                    id,\n                    tool,\n                    subject,\n                    lines,\n                    patch,\n                    focus: None,\n                    scroll: 0,\n                    opened: Instant::now(),\n                    shown: false,\n                    // As it would be if drawn now; set again when it is first drawn.\n                    letters: self.last_typed.is_none_or(|at| at.elapsed() >= APPROVAL_TYPING_RECENT) && self.composer.is_empty(),\n                    focus_at: None,\n                    confirm_at: None,\n                    typed_into: false,\n                };\n                // Another panel is open: the approval waits behind it (a key meant for that panel must never answer\n                // it), and opens as soon as that panel closes.\n                // An approval already open is never replaced by a later one: that one waits too.\n                match &self.overlay {\n                    None => self.overlay = Some(Overlay::Approval(approval)),\n                    Some(_) => self.pending_approvals.push_back(approval),\n                }\n    pub fn approval_id(&self) -> Option<&str> {\n        match &self.overlay {\n            Some(Overlay::Approval(approval)) => Some(approval.id.as_str()),\n            _ => None,\n        }\n    }\n\n    /// The approval panel is on screen now: its grace period starts here, not when the request arrived.\n    pub fn note_approval_shown(&mut self, now: Instant) {\n        let typing_recently = self.last_typed.is_some_and(|at| now.saturating_duration_since(at) < APPROVAL_TYPING_RECENT);\n        // A draft in the composer means the operator is composing: letters are text, not answers.\n        let composing = !self.composer.is_empty();\n        if let Some(Overlay::Approval(approval)) = &mut self.overlay\n            && !approval.shown\n        {\n            approval.shown = true;\n            approval.opened = now;\n            approval.letters = !approval.typed_into && !typing_recently && !composing;\n            approval.focus = None;\n            approval.focus_at = None;\n            approval.confirm_at = None;\n        }\n    }\n\n    /// Records what the frame measured and clamps scrolling to it.\n    pub fn note_layout(&mut self, layout: LiveLayout) {\n        // Shown only when the frame drew the panel with its change visible (not on a too-small screen).\n        if layout.approval_drawn {\n            self.note_approval_shown(Instant::now());\n{\"agent\":\"codex-root\",\"branch\":\"v1/startup-workspace-trust\",\"worktree\":\"/home/mike/nexus-wt/startup-workspace-trust\",\"head\":\"c34d2ba559dd9b1efddb6efd80fcb26e637c741a\",\"since\":\"2026-10-24T09:00:00Z\",\"pid\":2661752}\n","exit_code":0,"duration":{"secs":0,"nanos":802688481}},"started_at_ms":1792832355582,"completed_at_ms":1792832356385}}
