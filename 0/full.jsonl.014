 (loaded from ${filename}):\\n${content}`;\n    62\t        }\n    63\t      } catch {\n    64\t        // ignore read error\n    65\t      }\n    66\t    }\n    67\t  }\n    68\t\n  3293\t      } catch {}\n  3294\t    }\n  3295\t    if (!this.observer?.onCompaction) console.log(pc.dim(`[compact] ${status}: ${result.message}`));\n  3296\t  }\n  3297\t\n  3298\t  private buildSystemPrompt(): string {\n  3299\t    const projectRules = getProjectRules(this.config.workspace);\n  3300\t    const rulesSection = projectRules ? `\\n${projectRules}\\n` : \"\";\n  3301\t    const skillsSection = this.skillManager ? `\\n${this.skillManager.getPromptSection()}` : \"\";\n  3302\t    const knowledgeSection = this.knowledge ? `\\n${this.knowledge.exportPromptSection()}` : \"\";\n  3303\t\n  3304\t    // Invariant prompt prefix optimization for local AI:\n  3305\t    // Fixed canonical few-shots ensure byte-exact prefix caching across turns (vLLM / llama.cpp / Ollama)\n  3306\t    const fewShotSection = `\\n${selectRelevantFewShots(this.config.workspace)}\\n`;\n  3307\t    const tddSection = this.config.tdd\n  3308\t      ? `\\n### Test-Driven Development (RED-GREEN-REFACTOR) Protocol Enforced:\n  3309\t1. PHASE 1 (RED): Before modifying any production code, author a reproduction test that asserts the desired behavior and verify that it FAILS.\n  3310\t2. PHASE 2 (GREEN): Make surgical edits to production files until the reproduction test PASSES.\n     1\timport * as fs from \"node:fs\";\n     2\timport * as path from \"node:path\";\n     3\timport * as os from \"node:os\";\n     4\t\n     5\t/** Workspace files that configure MCP servers, and directories plugins are loaded from: used only when trusted. */\n     6\texport const WORKSPACE_MCP_FILES = [\".mcp.json\", \"mcp.json\"];\n     7\texport const WORKSPACE_PLUGIN_DIRS = [path.join(\".nexus\", \"plugins\"), \"plugins\"];\n     8\t\n     9\t/**\n    10\t * The workspace's own MCP configuration files and plugin modules that exist but are not loaded because the workspace\n    11\t * is not trusted (or the session is read-only). Empty when there are none or the workspace is trusted.\n    12\t */\n    13\texport function untrustedWorkspaceExtensions(workspace: string, readOnly = false): string[] {\n    14\t  if (isWorkspaceTrusted(workspace, readOnly)) return [];\n    15\t  const root = path.resolve(workspace);\n    16\t  const found = WORKSPACE_MCP_FILES.map((f) => path.join(root, f)).filter((f) => fs.existsSync(f));\n    17\t  for (const dir of WORKSPACE_PLUGIN_DIRS) {\n    18\t    try {\n    19\t      for (const name of fs.readdirSync(path.join(root, dir))) {\n    20\t        if (name.endsWith(\".js\") || name.endsWith(\".mjs\")) found.push(path.join(root, dir, name));\n    21\t      }\n    22\t    } catch {}\n    23\t  }\n    24\t  return found;\n    25\t}\n    26\t\n    27\texport function getTrustStorePath(): string {\n    28\t  return path.join(os.homedir(), \".config\", \"nexus\", \"trusted_workspaces.json\");\n    29\t}\n    30\t\n    31\t/**\n    32\t * Check if the given workspace is explicitly trusted by the operator.\n    33\t * In --read-only mode, workspace trust never authorizes executing project plugins/MCP.\n    34\t */\n    35\texport function isWorkspaceTrusted(workspace: string, readOnly = false): boolean {\n    36\t  if (readOnly) return false;\n    37\t  if (process.env.NEXUS_TRUST_WORKSPACE === \"1\") return true;\n    38\t\n    39\t  try {\n    40\t    const resolved = path.resolve(workspace);\n    41\t    const realWs = fs.existsSync(resolved) ? fs.realpathSync(resolved) : resolved;\n    42\t    const storePath = getTrustStorePath();\n    43\t    if (!fs.existsSync(storePath)) return false;\n    44\t    const content = JSON.parse(fs.readFileSync(storePath, \"utf8\"));\n    45\t    if (Array.isArray(content)) {\n    46\t      return content.includes(realWs);\n    47\t    }\n    48\t    if (content && typeof content === \"object\" && Array.isArray(content.trustedPaths)) {\n   385\t      return trimmed === \"\" || trimmed === \"y\" || trimmed === \"yes\";\n   386\t    }\n   387\t  }\n   388\t\n   389\t  async start(): Promise<void> {\n   390\t    this.printWelcome();\n   391\t\n   392\t    this.rl = readline.createInterface({\n   393\t      input,\n   394\t      output,\n   395\t      historySize: 200,\n   396\t      prompt: \"\",\n   397\t      completer: (line: string) => {\n   398\t        const completions = [\n   399\t          \"/help\", \"/status\", \"/doctor\", \"/clear\", \"/reset\", \"/compact\", \"/mode\",\n   400\t          \"/diff\", \"/git\", \"/commit\", \"/sessions\", \"/save\", \"/resume\", \"/skills\",\n   401\t          \"/skill\", \"/mcp\", \"/plugins\", \"/plan\", \"/checkpoint\",\n   402\t          \"/checkpoints\", \"/undo\", \"/audit\", \"/export\", \"/tokens\", \"/init\",\n   403\t          \"/onboard\", \"/test\",\n   404\t          \"/model\", \"/shell\", \"/cd\", \"/history\", \"/copy\", \"/paste\",\n   405\t          \"/image\", \"/theme\", \"/team\",\n   406\t          \"/exit\", \"/quit\"\n   407\t        ];\n   408\t        const trimmed = line.trim();\n   409\t        const parts = line.split(/\\s+/);\n   410\t        const lastToken = REDACTED - 1] || \"\";\n   438\t    }\n   439\t  });\n   440\t\n   441\tprogram\n   442\t  .command(\"trust [path]\")\n   443\t  .description(\"Trust a workspace so its own .mcp.json servers and plugins are loaded (they run code from the workspace)\")\n   444\t  .option(\"--remove\", \"Stop trusting the workspace\")\n   445\t  .option(\"--list\", \"List trusted workspaces\")\n   446\t  .action(async (target: string | undefined, options: any) => {\n   447\t    const { listTrustedWorkspaces, setWorkspaceTrusted } = await import(\"./workspace_trust.js\");\n   448\t    if (options.list) {\n   449\t      const list = listTrustedWorkspaces();\n   450\t      console.log(list.length ? list.join(\"\\n\") : \"No trusted workspaces.\");\n   451\t      return;\n   452\t    }\n   