e.launcher\", \"runtime\", \"fail\", \"The `nexus` launcher does not route `doctor`; `nexus doctor` would start an agent task instead.\", evidence, PACKAGED_HOME ? \"Re-run the installer to restore the nexus launcher.\" : \"Update harness.sh from this checkout.\");\n  return f(\"runtime.launcher\", \"runtime\", \"pass\", \"The `nexus` launcher on PATH is this installation and routes `doctor`.\", evidence);\n};\n\nconst configCheck: Check = async (ctx) => {\n  if (ctx.configError) {\n    const message = ctx.configError instanceof Error ? ctx.configError.message : String(ctx.configError);\n    return f(\"config.valid\", \"config\", \"fail\", \"The configuration could not be built, so Nexus would not start a session.\", [message], \"Correct the setting named above (flag, ~/.config/nexus/config.env, or the working-directory .env) and run doctor again.\");\n  }\n  if (!ctx.config) return f(\"config.valid\", \"config\", \"skip\", \"No configuration was supplied.\");\n  const evidence = [`provider ${ctx.config.provider ?? \"(appliance / OpenAI-compatible endpoint)\"}`, `model ${ctx.config.model || \"(none)\"}`];\n  if (ctx.config.provider && !ctx.config.model) {\n    return f(\"config.valid\", \"config\", \"fail\", `Provider ${ctx.config.provider} is selected but no model is named.`, evidence, \"Pass -m <model> or set NEXUS_MODEL in ~/.config/nexus/config.env (or pick one with /model).\");\n  }\n  return f(\"config.valid\", \"config\", \"pass\", \"The configuration builds with the same rules a session uses.\", evidence);\n};\n\n/** REQ-SEC-110: settings a workspace .env tried to set that Nexus ignores (they belong to the operator). */\nconst projectEnvCheck: Check = async (ctx) => {\n  const workspace = ctx.config?.workspace ?? process.cwd();\n  const file = path.join(workspace, \".env\");\n  if (!fs.existsSync(file)) return f(\"config.project_env_ignored\", \"config\", \"skip\", \"The workspace has no .env.\", [file]);\n  let keys: string[];\n  try {\n    keys = Object.keys(parseDotenv(fs.readFileSync(file)));\n  } catch (err) {\n    return f(\"config.project_env_ignored\", \"config\", \"warn\", \"The workspace .env could not be read.\", [file, String((err as Error)?.message ?? err)]);\n  }\n  const ignored = keys.filter((key) => !isProjectEnvKey(key));\n  if (!ignored.length) return f(\"config.project_env_ignored\", \"config\", \"pass\", \"The workspace .env sets only per-project settings.\", [file]);\n  return f(\n    \"config.project_env_ignored\",\n    \"config\",\n    \"warn\",\n    `The workspace .env sets ${ignored.length} operator-only setting(s) that Nexus ignores: ${ignored.join(\", \")}.`,\n    [file],\n    \"Move settings you meant for Nexus to ~/.config/nexus/config.env (or your shell environment); a repository cannot change TLS, proxies, credentials, timeouts, the shell or trust.\",\n  );\n};\n\ninterface EndpointEvidence {\n  configured: boolean;\n  endpoint?: string;\n  reachable?: boolean;\n  httpStatus?: number;\n  detail?: string;\n  models?: string[];\n  modelError?: string;\n  advertised?: import(\"./core/provider_capabilities.js\").Advertisement;\n}\n\nasync function gatherEndpoint(ctx: CheckContext, signal: AbortSignal): Promise<EndpointEvidence> {\n  const config = ctx.config;\n  if (!config?.endpoint) return { configured: false };\n  const client = new LocalLlmClient({ ...config, maxSteps: 1 }, { role: \"diagnostic\" });\n  const probe = await client.probeAvailability(signal, { timeoutMs: ctx.timeoutMs });\n  const evidence: EndpointEvidence = { configured: true, endpoint: config.endpoint, reachable: probe.httpStatus !== undefined, httpStatus: probe.httpStatus, detail: probe.detail };\n  if (probe.httpStatus !== undefined && probe.httpStatus >= 200 && probe.httpStatus < 300) {\n    let timer: NodeJS.Timeout | undefined;\n    let onAbort: (() => void) | undefined;\n    try {\n      evidence.models = await Promise.race([\n        client.listModels(),\n        new Promise<never>((_, reject) => {\n          timer = setTimeout(() => reject(new Error(`model list did not answer within ${ctx.timeoutMs} ms`)), ctx.timeoutMs);\n          onAbort = () => {\n            clearTimeout(timer);\n            reject(new Error(\"cancelled\"));\n          };\n          signal.addEventListener(\"abort\", onAbort, { once: true });\n        }),\n      ]);\n    } catch (err: any) {\n      evidence.modelError = err?.message ?? String(err);\n    } finally {\n      if (timer) clearTimeout(timer);\n      if (onAbort) signal.removeEventListener(\"abort\", onAbort);\n    }\n    try {\n      const adv = await client.discoverAdvertisement(signal);\n      if (adv?.advertised) evidence.advertised = adv.advertised;\n    } catch {}\n  }\n  return evidence;\n}\n\nconst endpointChecks: Check = async (ctx, signal) => {\n  const config = ctx.config;\n  if (!config) {\n    return [\"endpoint.configured\", \"endpoint.reachable\", \"endpoint.authenticated\", \"model.available\"].map((id) =>\n      f(id, \"endpoint\", \"skip\", \"Skipped: there is no valid configuration to take the endpoint from.\"),\n    } catch {}\n    out.push(ok\n      ? f(\"engine.tool\", \"engine\", \"pass\", \"The engine executed a read-only tool (list_dir) in the workspace.\", [workspace])\n      : f(\"engine.tool\", \"engine\", \"fail\", \"The engine could not execute a read-only tool in the workspace.\", [workspace, call.timedOut ? \"timed out\" : (call.stderr || call.error || call.stdout).trim().slice(0, 300)], PACKAGED_HOME ? \"Check workspace permissions and re-run the installer.\" : \"Check workspace permissions and rebuild the engine.\"));\n  }\n  return out;\n};\n\n/** The live TUI and its sidecar: launchable and built from current source. */\nconst tuiCheck: Check = async (ctx, signal) => {\n  const core = path.dirname(coreCargoManifest());\n  const candidates = [\n    ...(PACKAGED_HOME ? [path.join(CORE_ROOT, \"nexus-tui\")] : []),\n    path.join(core, \"target/release/nexus-tui\"),\n    path.join(core, \"target/debug/nexus-tui\"),\n  ];\n  const tui = candidates.find((c) => fs.existsSync(c));\n  const sidecar = path.join(CLI_ROOT, \"dist/sidecar.js\");\n  if (!tui || !fs.existsSync(sidecar)) {\n    return f(\n      \"tui.launch\",\n      \"install\",\n      \"warn\",\n      \"The live TUI is not built; `nexus` without arguments falls back to the readline REPL.\",\n      [!tui ? \"nexus-tui binary missing\" : \"cli/dist/sidecar.js missing\"],\n      PACKAGED_HOME ? \"Re-run the installer.\" : \"Run `make build`.\"\n    );\n  }\n  const checkResult = await run(tui, [\"--live\", \"--check\"], { timeoutMs: ctx.timeoutMs, signal });\n  if (checkResult.code !== 0) {\n    return f(\n      \"tui.launch\",\n      \"install\",\n      \"warn\",\n      \"The live TUI cannot launch; `nexus` without arguments falls back to the readline REPL.\",\n      [tui, checkResult.stderr.trim() || checkResult.stdout.trim() || \"sidecar resolution failed\"],\n      PACKAGED_HOME ? \"Re-run the installer.\" : \"Run `make build`.\"\n    );\n  }\n  const sourceAt = PACKAGED_HOME ? 0 : newestMtime(path.join(core, \"src/bin\"), \".rs\");\n  const builtAt = fs.statSync(tui).mtimeMs;\n  if (sourceAt > builtAt) {\n    return f(\n      \"tui.launch\",\n      \"install\",\n      \"warn\",\n      \"The live TUI binary is older than its source.\",\n      [tui, `built ${new Date(builtAt).toISOString()}`, `newest source ${new Date(sourceAt).toISOString()}`],\n      \"Run `make build-core`.\"\n    );\n  }\n  return f(\"tui.launch\", \"install\", \"pass\", \"The live TUI is launchable and its sidecar resolves.\", [tui, sidecar]);\n};\n\nconst workspaceCheck: Check = async (ctx) => {\n  const workspace = ctx.config?.workspace ?? (ctx.flags.workspace ? path.resolve(ctx.flags.workspace) : process.cwd());\n  try {\n    if (!fs.statSync(workspace).isDirectory()) return f(\"workspace.access\", \"workspace\", \"fail\", \"The workspace is not a directory.\", [workspace], \"Pass -w <directory>.\");\n    fs.accessSync(workspace, fs.constants.R_OK | fs.constants.W_OK);\n  } catch (err: any) {\n    return f(\"workspace.access\", \"workspace\", \"fail\", \"The workspace is not readable and writable.\", [workspace, err?.code ?? String(err)], \"Fix its permissions or choose another workspace with -w.\");\n  }\n  const git = fs.existsSync(path.join(workspace, \".git\"));\n  return f(\"workspace.access\", \"workspace\", \"pass\", `The workspace is readable and writable${git ? \" and is a git repository (checkpoints and /undo available)\" : \"; it is not a git repository, so checkpoints use file snapshots\"}.`, [workspace]);\n};\n\nfunction modeOf(file: string): number | undefined {\n  try {\n    return fs.statSync(file).mode & 0o777;\n  } catch {\n    return undefined;\n  }\n}\n\nconst stateDirCheck: Check = async (ctx) => {\n  const dirs = [\n    { id: \"state.sessions\", dir: ctx.home === os.homedir() ? defaultSessionsDir() : path.join(ctx.home, \".nexus\", \"sessions\"), what: \"saved sessions\" },\n    { id: \"state.tasks\", dir: ctx.home === os.homedir() ? defaultTaskStateDir() : path.join(ctx.home, \".nexus\", \"tasks\"), what: \"durable task state\" },\n  ];\n  const out: Array<Omit<DoctorFinding, \"durationMs\">> = [];\n  for (const { id, dir, what } of dirs) {\n/**\n * `nexus doctor` / `/doctor`: deterministic diagnostics against isolated homes and local mock endpoints. No live\n * credentials, no production services. Each scenario is one of the failure paths the doctor must name truthfully.\n */\nimport { test, describe, before, after } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport http from \"node:http\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { buildConfig } from \"../src/config.js\";\nimport {\n  DOCTOR_EXIT,\n  DoctorReport,\n  doctorExitCode,\n  proposedRepairs,\n  redactDiagnostic,\n  renderDoctorJson,\n  renderDoctorText,\n  runDoctor,\n  runRepairs,\n} from \"../src/doctor.js\";\nimport type { HarnessConfig } from \"../src/types.js\";\nimport { SafePathError, ancestryProblem, chmodVerified, identityOf, mkdirVerified, writeExclusiveVerified } from \"../src/safe_fs.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"../..\");\nconst LAUNCHER = path.join(ROOT, \"harness.sh\");\nconst SECRET = \"REDACTED\";\n\ninterface Mock {\n  url: string;\n  paths: string[];\n  headers: http.IncomingHttpHeaders[];\n  chats: number;\n  close(): Promise<void>;\n}\n\n/** Local OpenAI-compatible endpoint whose /models and chat behaviour each test chooses. */\nasync function mock(behaviour: { models?: string[]; status?: number; hang?: boolean } = {}): Promise<Mock> {\n  const state = { paths: [] as string[], chats: 0, headers: [] as http.IncomingHttpHeaders[] };\n  const sockets = new Set<import(\"node:net\").Socket>();\n  const server = http.createServer((req, res) => {\n    state.paths.push(req.url ?? \"\");\n    state.headers.push(req.headers);\n    if (behaviour.hang) return;\n    if (behaviour.status) {\n      res.statusCode = behaviour.status;\n      res.end(JSON.stringify({ error: { message: \"nope\" } }));\n      return;\n    }\n    if (req.url?.includes(\"/models\")) {\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ data: (behaviour.models ?? [\"m\"]).map((id) => ({ id })) }));\n      return;\n    }\n    state.chats++;\n    let body = \"\";\n    req.on(\"data\", (c) => (body += c));\n    req.on(\"end\", () => {\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ choices: [{ index: 0, message: { role: \"assistant\", content: \"OK\" }, finish_reason: \"stop\" }] }));\n    });\n  });\n  server.on(\"connection\", (s) => {\n    sockets.add(s);\n    s.on(\"close\", () => sockets.delete(s));\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", () => resolve()));\n  const port = (server.address() as any).port;\n  return {\n    url: `http://127.0.0.1:${port}/v1`,\n    get paths() {\n      return state.paths;\n    },\n    get chats() {\n      return state.chats;\n    },\n    get headers() {\n      return state.headers;\n    },\n    close: async () => {\n      for (const s of sockets) s.destroy();\n      await new Promise<void>((resolve) => server.close(() => resolve()));\n    },\n  } as Mock;\n}\n\nconst tmp = (prefix: string) => fs.mkdtempSync(path.join(os.tmpdir(), prefix));\nlet home: string;\nlet workspace: string;\nlet savedHome: string | undefined;\n\nbefore(() => {\n  savedHome = process.env.HOME;\n  home = tmp(\"nexus-doctor-home-\");\n  workspace = tmp(\"nexus-doctor-ws-\");\n  process.env.HOME = home;\n});\nafter(() => {\n  process.env.HOME = savedHome;\n  fs.rmSync(home, { recursive: true, force: true });\n  fs.rmSync(workspace, { recursive: true, force: true });\n});\n\nconst cfg = (o: Partial<HarnessConfig> = {}): HarnessConfig => ({ endpoint: \"http://127.0.0.1:9/v1\", model: \"m\", maxSteps: 30, temperature: 0, workspace, shell: \"bash\", ...o });\nconst find = (report: DoctorReport, id: string) => report.findings.find((f) => f.id === id);\nconst doctor = (o: Parameters<typeof runDoctor>[0]) => runDoctor({ home, timeoutMs: 1500, ...(o as object) });\n\ndescribe(\"doctor findings name the actual failure\", () => {\n  test(\"config.project_env_ignored reports operator-only settings a workspace .env tries to set (REQ-SEC-110)\", async () => {\n    const ws = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-doctor-projenv-\"));\n    try {\n      fs.writeFileSync(path.join(ws, \".env\"), \"LOCAL_LLM_MODEL=x\\nNODE_TLS_REJECT_UNAUTHORIZED=0\\nHTTPS_PROXY=http://p\\n\");\n      const warned = find(await doctor({ config: cfg({ workspace: ws }) }), \"config.project_env_ignored\")!;\n      assert.equal(warned.status, \"warn\");\n      assert.match(warned.explanation, /NODE_TLS_REJECT_UNAUTHORIZED, HTTPS_PROXY/);\n      fs.writeFileSync(path.join(ws, \".env\"), \"LOCAL_LLM_MODEL=x\\n\");\n      assert.equal(find(await doctor({ config: cfg({ workspace: ws }) }), \"config.project_env_ignored\")!.status, \"pass\");\n    } finally {\n      fs.rmSync(ws, { recursive: true, force: true });\n    }\n  });\n\n  test(\"malformed configuration fails config.valid while independent checks still run\", async () => {\n    let configError: unknown;\n    try {\n      buildConfig({ provider: \"no-such-provider\" });\n    } catch (err) {\n      configError = err;\n    }\n    assert.ok(configError, \"buildConfig rejects the unknown provider (normal startup would fail)\");\n    const report = await doctor({ configError, flags: { provider: \"no-such-provider\" } });\n    assert.equal(find(report, \"config.valid\")?.status, \"fail\");\n    assert.match(find(report, \"config.valid\")!.evidence[0], /Unknown provider 'no-such-provider'/);\n    assert.equal(find(report, \"runtime.node\")?.status, \"pass\");\n    assert.equal(find(report, \"shell.executable\")?.status, \"pass\", \"the shell is checked from flags/env without a config\");\n    assert.equal(find(report, \"endpoint.reachable\")?.status, \"skip\");\n    assert.equal(doctorExitCode(report), DOCTOR_EXIT.failures);\n  });\n\n  test(\"an unreachable endpoint fails reachability and skips what depends on it\", async () => {\n    const report = await doctor({ config: cfg({ endpoint: \"http://127.0.0.1:9/v1\" }) });\n    assert.equal(find(report, \"endpoint.configured\")?.status, \"pass\");\n    assert.equal(find(report, \"endpoint.reachable\")?.status, \"fail\");\n    assert.equal(find(report, \"endpoint.authenticated\")?.status, \"skip\");\n    assert.equal(find(report, \"model.available\")?.status, \"skip\");\n    assert.equal(find(report, \"inference.verified\")?.status, \"skip\");\n  });\n\n  test(\"a hanging endpoint is bounded by the timeout\", async () => {\n    const m = await mock({ hang: true });\n    try {\n      const started = Date.now();\n      const report = await doctor({ config: cfg({ endpoint: m.url }), timeoutMs: 600 });\n      assert.ok(Date.now() - started < 5000, `bounded: ${Date.now() - started} ms`);\n      assert.equal(find(report, \"endpoint.reachable\")?.status, \"fail\");\n    } finally {\n      await m.close();\n    }\n  });\n\n  test(\"the model list keeps the endpoint's /v1 path and the configured model is checked\", async () => {\n    const m = await mock({ models: [\"alpha\", \"beta\"] });\n    try {\n      const missing = await doctor({ config: cfg({ endpoint: m.url, model: \"gamma\" }) });\n      assert.equal(find(missing, \"endpoint.authenticated\")?.status, \"pass\");\n      assert.equal(find(missing, \"model.available\")?.status, \"warn\");\n      assert.match(find(missing, \"model.available\")!.explanation, /not listed.*availability is unverified/);\n      assert.match(find(missing, \"model.available\")!.evidence[0], /alpha, beta/);\n      assert.ok(m.paths.every((p) => p.startsWith(\"/v1/\")), `requests kept /v1: ${m.paths.join(\" \")}`);\n      const present = await doctor({ config: cfg({ endpoint: m.url, model: \"beta\" }) });\n      assert.equal(find(present, \"model.available\")?.status, \"pass\");\n      assert.equal(find(present, \"inference.verified\")?.status, \"skip\", \"a listed model is not proof of inference\");\n      assert.equal(m.chats, 0, \"default checks send no inference request\");\n    } finally {\n      await m.close();\n    }\n  });\n\n  test(\"--deep can verify a configured model omitted from /models\", async () => {\n    const m = await mock({ models: [\"alpha\"] });\n    try {\n      const report = await doctor({ config: cfg({ endpoint: m.url, model: \"gamma\" }), deep: true });\n      assert.equal(find(report, \"inference.verified\")?.status, \"pass\");\n      assert.equal(find(report, \"model.available\")?.status, \"pass\");\n      assert.match(find(report, \"model.available\")!.explanation, /not listed.*successful --deep inference probe verified/);\n      assert.equal(m.chats, 1);\n    } finally {\n      await m.close();\n    }\n  });\n\n  test(\"a rejected credential fails authentication\", async () => {\n    const m = await mock({ status: 401 });\n    try {\n      const report = await doctor({ config: cfg({ endpoint: m.url, apiKey: SECRET }) });\n      assert.equal(find(report, \"endpoint.reachable\")?.status, \"pass\");\n      assert.equal(find(report, \"endpoint.authenticated\")?.status, \"fail\");\n      assert.equal(find(report, \"model.available\")?.status, \"skip\");\n    } finally {\n      await m.close();\n    }\n  });\n\n  test(\"--deep sends exactly one inference request and says it costs model work\", async () => {\n    const m = await mock({ models: [\"m\"] });\n    try {\n      const report = await doctor({ config: cfg({ endpoint: m.url }), deep: true });\n      assert.equal(find(report, \"inference.verified\")?.status, \"pass\", JSON.stringify(find(report, \"inference.verified\")));\n      assert.match(find(report, \"inference.verified\")!.explanation, /costed model work/);\n      assert.equal(m.chats, 1);\n      assert.equal(find(report, \"engine.tool\")?.status, \"pass\", \"deep engine check ran a read-only tool\");\n    } finally {\n      await m.close();\n    }\n  });\n\n  test(\"--deep engine probe passes in a large workspace (a listing bigger than the output cap is not a failure)\", async () => {\n    // A home-directory workspace lists thousands of entries: the probe must not depend on how much the workspace holds.\n    const big = tmp(\"nexus-doctor-bigws-\");\n    for (let d = 0; d < 20; d++) {\n      const sub = path.join(big, `directory-with-a-long-name-${d}`);\n      fs.mkdirSync(sub);\n      for (let i = 0; i < 100; i++) fs.writeFileSync(path.join(sub, `file-with-a-reasonably-long-name-${i}.txt`), \"\");\n    }\n    for (let i = 0; i < 1500; i++) fs.writeFileSync(path.join(big, `top-level-file-with-a-reasonably-long-name-${i}.txt`), \"\");\n    const m = await mock({ models: [\"m\"] });\n    try {\n      const report = await doctor({ config: cfg({ endpoint: m.url, workspace: big }), deep: true });\n      assert.equal(find(report, \"engine.tool\")?.status, \"pass\", JSON.stringify(find(report, \"engine.tool\")));\n    } finally {\n      await m.close();\n    }\n  });\n\n  test(\"a shell that is not on PATH fails shell.executable\", async () => {\n    const report = await doctor({ config: cfg({ shell: \"no-such-shell-xyz\" }) });\n    assert.equal(find(report, \"shell.executable\")?.status, \"fail\");\n  });\n\n  test(\"an engine binary that does not run fails engine.binary\", async () => {\n    const broken = path.join(tmp(\"nexus-doctor-engine-\"), \"harness-core\");\n    fs.writeFileSync(broken, \"#!/bin/sh\\necho broken >&2\\nexit 3\\n\", { mode: 0o755 });\n    const report = await doctor({ config: cfg({ coreBinaryPath: broken }) });\n    assert.equal(find(report, \"engine.binary\")?.status, \"fail\");\n    assert.match(find(report, \"engine.binary\")!.evidence.join(\" \"), /broken/);\n  });\n\n  test(\"state directories: missing warns with a repair; unwritable fails; checks home's real paths\", async () => {\n    const h = tmp(\"nexus-doctor-state-\");\n    try {\n      const missing = await runDoctor({ home: h, config: cfg() });\n      assert.equal(find(missing, \"state.sessions\")?.status, \"warn\");\n      assert.equal(find(missing, \"state.sessions\")?.repair?.id, \"state.create\");\n      assert.equal(find(missing, \"state.sessions\")?.evidence[0], path.join(h, \".nexus\", \"sessions\"));\n      fs.mkdirSync(path.join(h, \".nexus\", \"sessions\"), { recursive: true, mode: 0o700 });\n      fs.chmodSync(path.join(h, \".nexus\", \"sessions\"), 0o500);\n      const locked = await runDoctor({ home: h, config: cfg() });\n      if (process.getuid?.() !== 0) assert.equal(find(locked, \"state.sessions\")?.status, \"fail\");\n    } finally {\n      fs.chmodSync(path.join(h, \".nexus\", \"sessions\"), 0o700);\n      fs.rmSync(h, { recursive: true, force: true });\n    }\n  });\n\n  test(\"unreadable session records are reported, never deleted\", async () => {\n    const h = tmp(\"nexus-doctor-integrity-\");\n    fs.mkdirSync(path.join(h, \".nexus\", \"sessions\"), { recursive: true, mode: 0o700 });\n    fs.writeFileSync(path.join(h, \".nexus\", \"sessions\", \"bad.json\"), \"{not json\");\n    const report = await runDoctor({ home: h, config: cfg() });\n    assert.equal(find(report, \"state.integrity\")?.status, \"warn\");\n    assert.ok(fs.existsSync(path.join(h, \".nexus\", \"sessions\", \"bad.json\")));\n    fs.rmSync(h, { recursive: true, force: true });\n  });\n\n  test(\"state integrity accepts empty and cursor-backed schema-2 histories, but reports malformed records\", async () => {\n    const h = tmp(\"nexus-doctor-schema2-\");\n/**\n * `nexus doctor` and `/doctor`: one diagnostic engine for the CLI and the live session.\n *\n * Every check reuses the resolver Nexus itself uses — `buildConfig` for configuration, `LocalLlmClient` for the\n * endpoint, credentials and model list, `resolveCoreBinary` for the engine, the session and task-state directories,\n * and the MCP and plugin search paths — so a finding describes what Nexus would actually do. Checks are independent,\n * bounded by timeouts and an abort signal, and never start an agent, an MCP server or a plugin. Endpoint evidence is\n * layered: configured → reachable → authenticated → model available → inference verified (the last only with\n * --deep, which sends one minimal inference request and says so).\n *\n * Repairs (`--fix`) are a small deterministic set: create missing state directories and tighten permissions on\n * state and credential files. They are proposed first, applied only after confirmation (or `--yes`), refused under\n * read-only policy, serialised by a lock, backed up (previous modes recorded), checked again just before each change,\n * and verified afterwards by re-running the affected checks.\n */\nimport { X509Certificate } from \"node:crypto\";\nimport { setMaxListeners } from \"node:events\";\nimport * as fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { parse as parseDotenv } from \"dotenv\";\nimport { LocalLlmClient, credentialStorageHome } from \"./client.js\";\nimport { credentialsPath } from \"./credentials.js\";\nimport { mcpConfigFiles } from \"./mcp.js\";\nimport { pluginDirs } from \"./plugins.js\";\nimport { untrustedWorkspaceExtensions, WORKSPACE_MCP_FILES, isWorkspaceTrusted } from \"./workspace_trust.js\";\nimport { BuildIdentity, getBuildIdentity } from \"./build_identity.js\";\nimport { defaultSessionsDir } from \"./session.js\";\nimport { defaultTaskStateDir } from \"./core/state.js\";\nimport { coreCargoManifest, resolveCoreBinary } from \"./tools.js\";\nimport { isProjectEnvKey } from \"./config.js\";\nimport { classifyLocality } from \"./core/egress.js\";\nimport { redactSecrets } from \"./ui.js\";\nimport { SafePathError, ancestryProblem, chmodVerified, identityOf, mkdirVerified, readVerified, unlinkVerified, writeExclusiveVerified, type Identity } from \"./safe_fs.js\";\nimport { isNexusDirPermissive } from \"./core/durable_file.js\";\nexport { isNexusDirPermissive };\nimport type { HarnessConfig } from \"./types.js\";\n\nexport const DOCTOR_SCHEMA_VERSION = 2;\nexport type DoctorStatus = \"pass\" | \"warn\" | \"fail\" | \"skip\";\n\n/** Exit codes: healthy, warnings only, at least one failure, the doctor itself could not run. */\nexport const DOCTOR_EXIT = { healthy: 0, warnings: 1, failures: 2, error: 3 } as const;\n\nexport interface DoctorFinding {\n  id: string;\n  category: \"install\" | \"config\" | \"endpoint\" | \"runtime\" | \"engine\" | \"workspace\" | \"state\" | \"extensions\";\n  status: DoctorStatus;\n  explanation: string;\n  evidence: string[];\n  action?: string;\n  repairAvailable: boolean;\n  /** `expect`: the object the diagnosis saw (device, inode, mode); a repair changes only that object. */\n  repair?: { id: string; description: string; expect?: { dev: number; ino: number; mode: number } };\n  durationMs: number;\n}\n\nexport interface RepairResult {\n  id: string;\n  findingId: string;\n  description: string;\n  status: \"applied\" | \"failed\" | \"skipped\" | \"declined\" | \"unresolved\" | \"refused\";\n  detail: string;\n  /** Status of the affected check when it was run again after the repair. */\n  verified?: DoctorStatus;\n}\n\nexport interface DoctorReport {\n  schemaVersion: typeof DOCTOR_SCHEMA_VERSION;\n  tool: \"nexus doctor\";\n  nexusVersion: string;\n  buildIdentity?: BuildIdentity;\n  posture?: {\n    mode: \"auto\" | \"review\" | \"read-only\";\n    sandbox: string;\n    trusted: boolean;\n  };\n  /** `cli`: a fresh configuration built from flags and environment. `session`: the running session's configuration. */\n  context: \"cli\" | \"session\";\n  deep: boolean;\n  generatedAt: string;\n  durationMs: number;\n  summary: Record<DoctorStatus, number>;\n  effectiveConfig: Array<{ key: string; value: string; source: string }> | null;\n  findings: DoctorFinding[];\n  repairs?: RepairResult[];\n  cancelled?: boolean;\n}\n7: * bounded by timeouts and an abort signal, and never start an agent, an MCP server or a plugin. Endpoint evidence is\n9: * --deep, which sends one minimal inference request and says so).\n82:  deep: boolean;\n99:  deep?: boolean;\n101:  /** Per-check limit in milliseconds (the deep inference probe gets six times this). */\n102:  timeoutMs?: number;\n157:  deep: boolean;\n159:  timeoutMs: number;\n160:  timeoutOverride: boolean;\n163:  /** An absent /models entry is advisory; --deep can independently verify it. */\n165:  deepModelVerified?: boolean;\n187:/** Runs a process with a deadline; never throws. */\n188:function run(command: string, args: string[], opts: { cwd?: string; timeoutMs: number; signal: AbortSignal; maxStdout?: number }): Promise<{ code: number | null; stdout: string; stderr: string; error?: string; timedOut: boolean }> {\n211:    }, opts.timeoutMs);\n365:  if (!routesDoctor) return f(\"runtime.launcher\", \"runtime\", \"fail\", \"The `nexus` launcher does not route `doctor`; `nexus doctor` would start an agent task instead.\", evidence, PACKAGED_HOME ? \"Re-run the installer to restore the nexus launcher.\" : \"Update harness.sh from this checkout.\");\n401:    \"Move settings you meant for Nexus to ~/.config/nexus/config.env (or your shell environment); a repository cannot change TLS, proxies, credentials, timeouts, the shell or trust.\",\n420:  const probe = await client.probeAvailability(signal, { timeoutMs: ctx.timeoutMs });\n429:          timer = setTimeout(() => reject(new Error(`model list did not answer within ${ctx.timeoutMs} ms`)), ctx.timeoutMs);\n507:    out.push(f(\"model.available\", \"endpoint\", \"warn\", `The configured model ${config.model} is not listed by the endpoint; availability is unverified. A --deep inference probe can verify it.`, [`${ev.models.length} model(s) listed: ${ev.models.slice(0, 8).join(\", \")}${ev.models.length > 8 ? \", …\" : \"\"}`, ...contextEvidence]));\n513:  if (!ctx.deep) {\n514:    return f(\"inference.verified\", \"endpoint\", \"skip\", \"Inference was not tested: a listed model is not proof that inference works. --deep sends one minimal request.\", [], \"Run `nexus doctor --deep` to send one short inference request (it costs model work, and tokens on paid providers).\");\n522:    const reply = await client.chatCompletion([{ role: \"user\", content: \"Reply with the single word OK.\" }], [], undefined, AbortSignal.any([signal, AbortSignal.timeout(ctx.timeoutMs * 6)]), \"diagnostic\");\n525:    ctx.deepModelVerified = true;\n536:  const res = await run(resolved, [\"-c\", \"printf nexus-doctor\"], { timeoutMs: ctx.timeoutMs, signal });\n555:  const version = await run(binary, [\"--version\"], { timeoutMs: ctx.timeoutMs, signal });\n572:  if (ctx.deep) {\n576:    const call = await run(binary, [\"-w\", workspace, \"call\", \"--tool\", \"list_dir\", \"--args\", JSON.stringify({ path: \".\", max_depth: 1 })], { timeoutMs: ctx.timeoutMs, signal, maxStdout: 16_000_000 });\n608:  const checkResult = await run(tui, [\"--live\", \"--check\"], { timeoutMs: ctx.timeoutMs, signal });\n688:    if (ctx.deep) {\n698:    out.push(f(id, \"state\", \"pass\", `The ${what} directory is writable${ctx.deep ? \" (a probe file was written and removed)\" : \"\"}.`, [dir, `mode ${mode.toString(8)}`]));\n819:  // Keep the scan asynchronous without making long-lived state directories spend one deadline per file.\n840:      await Promise.all(pending);\n844:  await Promise.all(pending);\n873:  const limit = ctx.deep ? 5000 : 300;\n904:  const evidence = [`${checked} record(s) checked${ctx.deep ? \" (newest 5000 per directory)\" : \" (newest 300 per directory; --deep checks up to 5000)\"}`];\n1084:/** Runs `check` with its own deadline; a throw or timeout becomes a finding, so other checks are unaffected. */\n1085:async function runCheck(name: string, check: Check, ctx: CheckContext, parent: AbortSignal): Promise<DoctorFinding[]> {\n1087:  const defaultLimit = name === \"inference\" ? ctx.timeoutMs * 6 + 1000 : name === \"endpoint\" ? ctx.timeoutMs * 2 + 1000 : ctx.timeoutMs + 1000;\n1089:  // An explicit --timeout remains authoritative for every check.\n1090:  const limit = name === \"integrity\" && !ctx.timeoutOverride ? Math.max(defaultLimit, 30_000) : defaultLimit;\n1099:      new Promise<\"timeout\">((resolve) => (timer = setTimeout(() => resolve(\"timeout\"), limit))),\n1109:    if (result === \"timeout\" || result === \"cancelled\") {\n1111:      return [{ ...f(`${name}.check`, \"runtime\", result === \"timeout\" ? \"warn\" : \"skip\", result === \"timeout\" ? `The ${name} check did not finish within ${limit} ms.` : `The ${name} check was cancelled.`), durationMs: Date.now() - started }];\n1130:  if (options.timeoutMs !== undefined && !(Number.isFinite(options.timeoutMs) && options.timeoutMs > 0)) {\n1131:    throw new Error(`--timeout must be a positive number of milliseconds (got ${String(options.timeoutMs)})`);\n1133:  // Checks are deliberately started together. Each `runCheck` owns two one-shot\n1149:    deep: Boolean(options.deep),\n1151:    timeoutMs: options.timeoutMs ?? DEFAULT_TIMEOUT_MS,\n1152:    timeoutOverride: options.timeoutMs !== undefined,\n1156:    results = await Promise.all(CHECKS.map(([name, check]) => runCheck(name, check, ctx, signal)));\n1161:  if (ctx.unlistedModel && ctx.deepModelVerified) {\n1165:      availability.explanation = `The configured model ${ctx.unlistedModel} is not listed by the endpoint, but a successful --deep inference probe verified that it is available.`;\n1166:      availability.evidence.push(\"verified by one successful deep inference request\");\n1189:    deep: ctx.deep,\n1201:  return Boolean(value && typeof value === \"object\" && (\"config\" in (value as any) || \"configError\" in (value as any) || \"context\" in (value as any) || \"deep\" in (value as any) || \"home\" in (value as any) || \"timeoutMs\" in (value as any)));\n1399:  out.push(`Nexus doctor ${report.nexusVersion} — ${report.context === \"session\" ? \"active session configuration\" : \"fresh CLI configuration\"}${report.deep ? \" (deep)\" : \"\"}`);\n","exit_code":0,"duration":{"secs":0,"nanos":741755679}},"started_at_ms":1792828426062,"completed_at_ms":1792828426804}}
{"timestamp":"2026-10-24T07:53:47.932Z","ordinal":282023,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a16ce6-ce9c-7260-ab4c-618b2cf23e46","call_id":"call_f3f3f22b465c410abb926e30fbe79ff4","output":[{"type":"input_text","text":"Script completed\nWall time 3.0 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 8165)\nTotal output lines: 603\n\n  try {\n    routesDoctor = /\\[\\[ \"\\$1\" == \"doctor\" \\]\\]/.test(fs.readFileSync(real, \"utf8\"));\n  } catch {}\n  if (!ours) return f(\"runtime.launcher\", \"runtime\", \"warn\", \"The `nexus` on PATH is not this installation's launcher.\", evidence, PACKAGED_HOME ? \"Use the nexus launcher installed by the package (add ~/.local/bin to PATH).\" : `Point it at ${path.join(INSTALL_ROOT, \"harness.sh\")}, or run this installation directly.`);\n  if (PACKAGED_HOME) return f(\"runtime.launcher\", \"runtime\", \"pass\", \"The `nexus` launcher on PATH is this packaged installation.\", evidence);\n  if (!routesDoctor) return f(\"runtime.launcher\", \"runtime\", \"fail\", \"The `nexus` launcher does not route `doctor`; `nexus doctor` would start an agent task instead.\", evidence, PACKAGED_HOME ? \"Re-run the installer to restore the nexus launcher.\" : \"Update harness.sh from this checkout.\");\n  return f(\"runtime.launcher\", \"runtime\", \"pass\", \"The `nexus` launcher on PATH is this installation and routes `doctor`.\", evidence);\n};\n\nconst configCheck: Check = async (ctx) => {\n  if (ctx.configError) {\n    const message = ctx.configError instanceof Error ? ctx.configError.message : String(ctx.configError);\n    return f(\"config.valid\", \"config\", \"fail\", \"The configuration could not be built, so Nexus would not start a session.\", [message], \"Correct the setting named above (flag, ~/.config/nexus/config.env, or the working-directory .env) and run doctor again.\");\n  }\n  if (!ctx.config) return f(\"config.valid\", \"config\", \"skip\", \"No configuration was supplied.\");\n  const evidence = [`provider ${ctx.config.provider ?? \"(appliance / OpenAI-compatible endpoint)\"}`, `model ${ctx.config.model || \"(none)\"}`];\n  if (ctx.config.provider && !ctx.config.model) {\n    return f(\"config.valid\", \"config\", \"fail\", `Provider ${ctx.config.provider} is selected but no model is named.`, evidence, \"Pass -m <model> or set NEXUS_MODEL in ~/.config/nexus/config.env (or pick one with /model).\");\n  }\n  return f(\"config.valid\", \"config\", \"pass\", \"The configuration builds with the same rules a session uses.\", evidence);\n};\n\n/** REQ-SEC-110: settings a workspace .env tried to set that Nexus ignores (they belong to the operator). */\nconst projectEnvCheck: Check = async (ctx) => {\n  const workspace = ctx.config?.workspace ?? process.cwd();\n  const file = path.join(workspace, \".env\");\n  if (!fs.existsSync(file)) return f(\"config.project_env_ignored\", \"config\", \"skip\", \"The workspace has no .env.\", [file]);\n  let keys: string[];\n  try {\n    keys = Object.keys(parseDotenv(fs.readFileSync(file)));\n  } catch (err) {\n    return f(\"config.project_env_ignored\", \"config\", \"warn\", \"The workspace .env could not be read.\", [file, String((err as Error)?.message ?? err)]);\n  }\n  const ignored = keys.filter((key) => !isProjectEnvKey(key));\n  if (!ignored.length) return f(\"config.project_env_ignored\", \"config\", \"pass\", \"The workspace .env sets only per-project settings.\", [file]);\n  return f(\n    \"config.project_env_ignored\",\n    \"config\",\n    \"warn\",\n    `The workspace .env sets ${ignored.length} operator-only setting(s) that Nexus ignores: ${ignored.join(\", \")}.`,\n    [file],\n    \"Move settings you meant for Nexus to ~/.config/nexus/config.env (or your shell environment); a repository cannot change TLS, proxies, credentials, timeouts, the shell or trust.\",\n  );\n};\n\ninterface EndpointEvidence {\n  configured: boolean;\n  endpoint?: string;\n  reachable?: boolean;\n  httpStatus?: number;\n  detail?: string;\n  models?: string[];\n  modelError?: string;\n  advertised?: import(\"./core/provider_capabilities.js\").Advertisement;\n}\n\nasync function gatherEndpoint(ctx: CheckContext, signal: AbortSignal): Promise<EndpointEvidence> {\n  const config = ctx.config;\n  if (!config?.endpoint) return { configured: false };\n  const client = new LocalLlmClient({ ...config, maxSteps: 1 }, { role: \"diagnostic\" });\n  const probe = await client.probeAvailability(signal, { timeoutMs: ctx.timeoutMs });\n  const evidence: EndpointEvidence = { configured: true, endpoint: config.endpoint, reachable: probe.httpStatus !== undefined, httpStatus: probe.httpStatus, detail: probe.detail };\n  if (probe.httpStatus !== undefined && probe.httpStatus >= 200 && probe.httpStatus < 300) {\n    let timer: NodeJS.Timeout | undefined;\n    let onAbort: (() => void) | undefined;\n    try {\n      evidence.models = await Promise.race([\n        client.listModels(),\n        new Promise<never>((_, reject) => {\n          timer = setTimeout(() => reject(new Error(`model list did not answer within ${ctx.timeoutMs} ms`)), ctx.timeoutMs);\n          onAbort = () => {\n            clearTimeout(timer);\n            reject(new Error(\"cancelled\"));\n          };\n          signal.addEventListener(\"abort\", onAbort, { once: true });\n        }),\n      ]);\n    } catch (err: any) {\n      evidence.modelError = err?.message ?? String(err);\n    } finally {\n      if (timer) clearTimeout(timer);\n      if (onAbort) signal.removeEventListener(\"abort\", onAbort);\n    }\n    try {\n      const adv = await client.discoverAdvertisement(signal);\n      if (adv?.advertised) evidence.advertised = adv.advertised;\n    } catch {}\n  }\n  return evidence;\n}\n\nconst endpointChecks: Check = async (ctx, signal) => {\n  const config = ctx.config;\n  if (!config) {\n    return [\"endpoint.configured\", \"endpoint.reachable\", \"endpoint.authenticated\", \"model.available\"].map((id) =>\n      f(id, \"endpoint\", \"skip\", \"Skipped: there is no valid configuration to take the endpoint from.\"),\n    } catch {}\n    out.push(ok\n      ? f(\"engine.tool\", \"engine\", \"pass\", \"The engine executed a read-only tool (list_dir) in the workspace.\", [workspace])\n      : f(\"engine.tool\", \"engine\", \"fail\", \"The engine could not execute a read-only tool in the workspace.\", [workspace, call.timedOut ? \"timed out\" : (call.stderr || call.error || call.stdout).trim().slice(0, 300)], PACKAGED_HOME ? \"Check workspace permissions and re-run the installer.\" : \"Check workspace permissions and rebuild the engine.\"));\n  }\n  return out;\n};\n\n/** The live TUI and its sidecar: launchable and built from current source. */\nconst tuiCheck: Check = async (ctx, signal) => {\n  const core = path.dirname(coreCargoManifest());\n  const candidates = [\n    ...(PACKAGED_HOME ? [path.join(CORE_ROOT, \"nexus-tui\")] : []),\n    path.join(core, \"target/release/nexus-tui\"),\n    path.join(core, \"target/debug/nexus-tui\"),\n  ];\n  const tui = candidates.find((c) => fs.existsSync(c));\n  const sidecar = path.join(CLI_ROOT, \"dist/sidecar.js\");\n  if (!tui || !fs.existsSync(sidecar)) {\n    return f(\n      \"tui.launch\",\n      \"install\",\n      \"warn\",\n      \"The live TUI is not built; `nexus` without arguments falls back to the readline REPL.\",\n      [!tui ? \"nexus-tui binary missing\" : \"cli/dist/sidecar.js missing\"],\n      PACKAGED_HOME ? \"Re-run the installer.\" : \"Run `make build`.\"\n    );\n  }\n  const checkResult = await run(tui, [\"--live\", \"--check\"], { timeoutMs: ctx.timeoutMs, signal });\n  if (checkResult.code !== 0) {\n    return f(\n      \"tui.launch\",\n      \"install\",\n      \"warn\",\n      \"The live TUI cannot launch; `nexus` without arguments falls back to the readline REPL.\",\n      [tui, checkResult.stderr.trim() || checkResult.stdout.trim() || \"sidecar resolution failed\"],\n      PACKAGED_HOME ? \"Re-run the installer.\" : \"Run `make build`.\"\n    );\n  }\n  const sourceAt = PACKAGED_HOME ? 0 : newestMtime(path.join(core, \"src/bin\"), \".rs\");\n  const builtAt = fs.statSync(tui).mtimeMs;\n  if (sourceAt > builtAt) {\n    return f(\n      \"tui.launch\",\n      \"install\",\n      \"warn\",\n      \"The live TUI binary is older than its source.\",\n      [tui, `built ${new Date(builtAt).toISOString()}`, `newest source ${new Date(sourceAt).toISOString()}`],\n      \"Run `make build-core`.\"\n    );\n  }\n  return f(\"tui.launch\", \"install\", \"pass\", \"The live TUI is launchable and its sidecar resolves.\", [tui, sidecar]);\n};\n\nconst workspaceCheck: Check = async (ctx) => {\n  const workspace = ctx.config?.workspace ?? (ctx.flags.workspace ? path.resolve(ctx.flags.workspace) : process.cwd());\n  try {\n    if (!fs.statSync(workspace).isDirectory()) return f(\"workspace.access\", \"workspace\", \"fail\", \"The workspace is not a directory.\", [workspace], \"Pass -w <directory>.\");\n    fs.accessSync(workspace, fs.constants.R_OK | fs.constants.W_OK);\n  } catch (err: any) {\n    return f(\"workspace.access\", \"workspace\", \"fail\", \"The workspace is not readable and writable.\", [workspace, err?.code ?? String(err)], \"Fix its permissions or choose another workspace with -w.\");\n  }\n  const git = fs.existsSync(path.join(workspace, \".git\"));\n  return f(\"workspace.access\", \"workspace\", \"pass\", `The workspace is readable and writable${git ? \" and is a git repository (checkpoints and /undo available)\" : \"; it is not a git repository, so checkpoints use file snapshots\"}.`, [workspace]);\n};\n\nfunction modeOf(file: string): number | undefined {\n  try {\n    return fs.statSync(file).mode & 0o777;\n  } catch {\n    return undefined;\n  }\n}\n\nconst stateDirCheck: Check = async (ctx) => {\n  const dirs = [\n    { id: \"state.sessions\", dir: ctx.home === os.homedir() ? defaultSessionsDir() : path.join(ctx.home, \".nexus\", \"sessions\"), what: \"saved sessions\" },\n    { id: \"state.tasks\", dir: ctx.home === os.homedir() ? defaultTaskStateDir() : path.join(ctx.home, \".nexus\", \"tasks\"), what: \"durable task state\" },\n  ];\n  const out: Array<Omit<DoctorFinding, \"durationMs\">> = [];\n  for (const { id, dir, what } of dirs) {\n/**\n * `nexus doctor` / `/doctor`: deterministic diagnostics against isolated homes and local mock endpoints. No live\n * credentials, no production services. Each scenario is one of the failure paths the doctor must name truthfully.\n */\nimport { test, describe, before, after } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport http from \"node:http\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { buildConfig } from \"../src/config.js\";\nimport {\n  DOCTOR_EXIT,\n  DoctorReport,\n  doctorExitCode,\n  proposedRepairs,\n  redactDiagnostic,\n  renderDoctorJson,\n  renderDoctorText,\n  runDoctor,\n  runRepairs,\n} from \"../src/doctor.js\";\nimport type { HarnessConfig } from \"../src/types.js\";\nimport { SafePathError, ancestryProblem, chmodVerified, identityOf, mkdirVerified, writeExclusiveVerified } from \"../src/safe_fs.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"../..\");\nconst LAUNCHER = path.join(ROOT, \"harness.sh\");\nconst SECRET = \"REDACTED\";\n\ninterface Mock {\n  url: string;\n  paths: string[];\n  headers: http.IncomingHttpHeaders[];\n  chats: number;\n  close(): Promise<void>;\n}\n\n/** Local OpenAI-compatible endpoint whose /models and chat behaviour each test chooses. */\nasync function mock(behaviour: { models?: string[]; status?: number; hang?: boolean } = {}): Promise<Mock> {\n  const state = { paths: [] as string[], chats: 0, headers: [] as http.IncomingHttpHeaders[] };\n  const sockets = new Set<import(\"node:net\").Socket>();\n  const server = http.createServer((req, res) => {\n    state.paths.push(req.url ?? \"\");\n    state.headers.push(req.headers);\n    if (behaviour.hang) return;\n    if (behaviour.status) {\n      res.statusCode = behaviour.status;\n      res.end(JSON.stringify({ error: { message: \"nope\" } }));\n      return;\n    }\n    if (req.url?.includes(\"/models\")) {\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ data: (behaviour.models ?? [\"m\"]).map((id) => ({ id })) }));\n      return;\n    }\n    state.chats++;\n    let body = \"\";\n    req.on(\"data\", (c) => (body += c));\n    req.on(\"end\", () => {\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ choices: [{ index: 0, message: { role: \"assistant\", content: \"OK\" }, finish_reason: \"stop\" }] }));\n    });\n  });\n  server.on(\"connection\", (s) => {\n    sockets.add(s);\n    s.on(\"close\", () …2165 tokens truncated…    assert.match(find(report, \"engine.binary\")!.evidence.join(\" \"), /broken/);\n  });\n\n  test(\"state directories: missing warns with a repair; unwritable fails; checks home's real paths\", async () => {\n    const h = tmp(\"nexus-doctor-state-\");\n    try {\n      const missing = await runDoctor({ home: h, config: cfg() });\n      assert.equal(find(missing, \"state.sessions\")?.status, \"warn\");\n      assert.equal(find(missing, \"state.sessions\")?.repair?.id, \"state.create\");\n      assert.equal(find(missing, \"state.sessions\")?.evidence[0], path.join(h, \".nexus\", \"sessions\"));\n      fs.mkdirSync(path.join(h, \".nexus\", \"sessions\"), { recursive: true, mode: 0o700 });\n      fs.chmodSync(path.join(h, \".nexus\", \"sessions\"), 0o500);\n      const locked = await runDoctor({ home: h, config: cfg() });\n      if (process.getuid?.() !== 0) assert.equal(find(locked, \"state.sessions\")?.status, \"fail\");\n    } finally {\n      fs.chmodSync(path.join(h, \".nexus\", \"sessions\"), 0o700);\n      fs.rmSync(h, { recursive: true, force: true });\n    }\n  });\n\n  test(\"unreadable session records are reported, never deleted\", async () => {\n    const h = tmp(\"nexus-doctor-integrity-\");\n    fs.mkdirSync(path.join(h, \".nexus\", \"sessions\"), { recursive: true, mode: 0o700 });\n    fs.writeFileSync(path.join(h, \".nexus\", \"sessions\", \"bad.json\"), \"{not json\");\n    const report = await runDoctor({ home: h, config: cfg() });\n    assert.equal(find(report, \"state.integrity\")?.status, \"warn\");\n    assert.ok(fs.existsSync(path.join(h, \".nexus\", \"sessions\", \"bad.json\")));\n    fs.rmSync(h, { recursive: true, force: true });\n  });\n\n  test(\"state integrity accepts empty and cursor-backed schema-2 histories, but reports malformed records\", async () => {\n    const h = tmp(\"nexus-doctor-schema2-\");\n/**\n * `nexus doctor` and `/doctor`: one diagnostic engine for the CLI and the live session.\n *\n * Every check reuses the resolver Nexus itself uses — `buildConfig` for configuration, `LocalLlmClient` for the\n * endpoint, credentials and model list, `resolveCoreBinary` for the engine, the session and task-state directories,\n * and the MCP and plugin search paths — so a finding describes what Nexus would actually do. Checks are independent,\n * bounded by timeouts and an abort signal, and never start an agent, an MCP server or a plugin. Endpoint evidence is\n * layered: configured → reachable → authenticated → model available → inference verified (the last only with\n * --deep, which sends one minimal inference request and says so).\n *\n * Repairs (`--fix`) are a small deterministic set: create missing state directories and tighten permissions on\n * state and credential files. They are proposed first, applied only after confirmation (or `--yes`), refused under\n * read-only policy, serialised by a lock, backed up (previous modes recorded), checked again just before each change,\n * and verified afterwards by re-running the affected checks.\n */\nimport { X509Certificate } from \"node:crypto\";\nimport { setMaxListeners } from \"node:events\";\nimport * as fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { parse as parseDotenv } from \"dotenv\";\nimport { LocalLlmClient, credentialStorageHome } from \"./client.js\";\nimport { credentialsPath } from \"./credentials.js\";\nimport { mcpConfigFiles } from \"./mcp.js\";\nimport { pluginDirs } from \"./plugins.js\";\nimport { untrustedWorkspaceExtensions, WORKSPACE_MCP_FILES, isWorkspaceTrusted } from \"./workspace_trust.js\";\nimport { BuildIdentity, getBuildIdentity } from \"./build_identity.js\";\nimport { defaultSessionsDir } from \"./session.js\";\nimport { defaultTaskStateDir } from \"./core/state.js\";\nimport { coreCargoManifest, resolveCoreBinary } from \"./tools.js\";\nimport { isProjectEnvKey } from \"./config.js\";\nimport { classifyLocality } from \"./core/egress.js\";\nimport { redactSecrets } from \"./ui.js\";\nimport { SafePathError, ancestryProblem, chmodVerified, identityOf, mkdirVerified, readVerified, unlinkVerified, writeExclusiveVerified, type Identity } from \"./safe_fs.js\";\nimport { isNexusDirPermissive } from \"./core/durable_file.js\";\nexport { isNexusDirPermissive };\nimport type { HarnessConfig } from \"./types.js\";\n\nexport const DOCTOR_SCHEMA_VERSION = 2;\nexport type DoctorStatus = \"pass\" | \"warn\" | \"fail\" | \"skip\";\n\n/** Exit codes: healthy, warnings only, at least one failure, the doctor itself could not run. */\nexport const DOCTOR_EXIT = { healthy: 0, warnings: 1, failures: 2, error: 3 } as const;\n\nexport interface DoctorFinding {\n  id: string;\n  category: \"install\" | \"config\" | \"endpoint\" | \"runtime\" | \"engine\" | \"workspace\" | \"state\" | \"extensions\";\n  status: DoctorStatus;\n  explanation: string;\n  evidence: string[];\n  action?: string;\n  repairAvailable: boolean;\n  /** `expect`: the object the diagnosis saw (device, inode, mode); a repair changes only that object. */\n  repair?: { id: string; description: string; expect?: { dev: number; ino: number; mode: number } };\n  durationMs: number;\n}\n\nexport interface RepairResult {\n  id: string;\n  findingId: string;\n  description: string;\n  status: \"applied\" | \"failed\" | \"skipped\" | \"declined\" | \"unresolved\" | \"refused\";\n  detail: string;\n  /** Status of the affected check when it was run again after the repair. */\n  verified?: DoctorStatus;\n}\n\nexport interface DoctorReport {\n  schemaVersion: typeof DOCTOR_SCHEMA_VERSION;\n  tool: \"nexus doctor\";\n  nexusVersion: string;\n  buildIdentity?: BuildIdentity;\n  posture?: {\n    mode: \"auto\" | \"review\" | \"read-only\";\n    sandbox: string;\n    trusted: boolean;\n  };\n  /** `cli`: a fresh configuration built from flags and environment. `session`: the running session's configuration. */\n  context: \"cli\" | \"session\";\n  deep: boolean;\n  generatedAt: string;\n  durationMs: number;\n  summary: Record<DoctorStatus, number>;\n  effectiveConfig: Array<{ key: string; value: string; source: string }> | null;\n  findings: DoctorFinding[];\n  repairs?: RepairResult[];\n  cancelled?: boolean;\n}\n7: * bounded by timeouts and an abort signal, and never start an agent, an MCP server or a plugin. Endpoint evidence is\n9: * --deep, which sends one minimal inference request and says so).\n82:  deep: boolean;\n99:  deep?: boolean;\n101:  /** Per-check limit in milliseconds (the deep inference probe gets six times this). */\n102:  timeoutMs?: number;\n157:  deep: boolean;\n159:  timeoutMs: number;\n160:  timeoutOverride: boolean;\n163:  /** An absent /models entry is advisory; --deep can independently verify it. */\n165:  deepModelVerified?: boolean;\n187:/** Runs a process with a deadline; never throws. */\n188:function run(command: string, args: stri