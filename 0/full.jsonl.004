its\", { timeout: 30_000 }, async () => {\n891:test(\"candidate sandbox and resource supervisor compose around a staged repository\", { timeout: 30_000 }, async () => {\n1031:test(\"repository workspaces carry no history beyond the pinned baseline commit\", { timeout: 15_000 }, async () => {\n1171:test(\"task paths reject traversal, symlink escapes, and unstable task trees\", async () => {\n1206:test(\"task-tree digests frame paths, entry types, executable mode, and content lengths\", async () => {\n1224:test(\"task setup and validators run with cleared env, no network, confined filesystem, bounded output and timeout\", async () => {\n1259:test(\"candidate namespace reaches only its authenticated run proxy and cannot read host files\", async () => {\n1332:test(\"qualification corpus binding rejects missing, mismatched, and post-seal task content\", async () => {\n1351:test(\"run.mjs refuses to start on an invalid task\", () => {\n1366:test(\"the model proxy injects each scheduled fault into the chat request it names, and records it\", async () => {\n1409:test(\"executable probes refuse bind sources that overlap protected corpus material\", async () => {\nv24.11.1\n11.19.0\nlock-present\n","exit_code":0,"duration":{"secs":1,"nanos":101519428}},"started_at_ms":1793248731857,"completed_at_ms":1793248732959}}
