 \"/media\", \"/srv\"];\n    15\tconst SENSITIVE_HOME_PARTS = [\".ssh\", \".config\", \".aws\", \".azure\", \".gnupg\", \".kube\", \".nexus\", \".cache\"];\n    16\tlet sandboxPreflight;\n    17\tlet hostToolchains;\n    18\t\n    19\tfunction shellQuote(value) {\n    20\t  return `'${value.replaceAll(\"'\", `'\\\\''`)}'`;\n    21\t}\n    22\t\n    23\texport function selectToolchainRoot(configuredRoot, fallbackRoot) {\n    24\t  return configuredRoot ?? fallbackRoot ?? null;\n    25\t}\n    26\t\n    27\tfunction resolveHostToolchains() {\n    28\t  if (hostToolchains) return hostToolchains;\n    29\t  const availableDirectory = (candidate) => {\n    30\t    try { return fs.statSync(candidate).isDirectory() ? candidate : null; }\n    31\t    catch { return null; }\n    32\t  };\n    33\t  const fromCommand = (command, argv) => {\n    34\t    const result = spawnSync(command, argv, { encoding: \"utf8\", timeout: 5000 });\n    35\t    return result.status === 0 ? availableDirectory(result.stdout.trim()) : null;\n    36\t  };\n    37\t  hostToolchains = {\n    38\t    goRoot: selectToolchainRoot(fromCommand(\"go\", [\"env\", \"GOROOT\"]), availableDirectory(\"/usr/local/go\")),\n    39\t    rustRoot: availableDirectory(\"/opt/nexus-qual/rust\") ?? fromCommand(\"rustc\", [\"--print\", \"sysroot\"]),\n    40\t  };\n    41\t  return hostToolchains;\n    42\t}\n    43\t\n    44\t/** Return the host paths that the candidate sandbox mounts, grouped by the bind logic. */\n    45\texport function candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths = [], nodeRuntime, supervisorPath } = {}) {\n    46\t  if (!Array.isArray(readOnlyPaths)) throw new Error(\"candidate sandbox readOnlyPaths must be an array\");\n    47\t  const existing = (paths, kind) => paths.filter((source) => {\n    48\t    try {\n    49\t      const stat = fs.statSync(source);\n    50\t      return kind === \"directory\" ? stat.isDirectory() : stat.isFile();\n    51\t    } catch { return false; }\n    52\t  });\n    53\t  const optional = (source, resolve = true) => source === undefined ? null : resolve ? fs.realpathSync(source) : source;\n    54\t  return {\n    55\t    systemDirectories: existing(SYSTEM_BINARIES, \"directory\"),\n    56\t    systemFiles: existing(SYSTEM_ETC_FILES, \"file\"),\n    57\t    systemEtcDirectories: existing(SYSTEM_ETC_DIRS, \"directory\"),\n    58\t    toolchainDirectories: Object.values(resolveHostToolchains()).filter(Boolean),\n    59\t    runtimeSources: {\n    60\t      cwd: optional(cwd),\n    61\t      home: optional(home),\n    62\t      proxyDirectory: optional(proxyDirectory),\n    63\t      nodeRuntime: optional(nodeRuntime),\n    64\t      supervisorPath: optional(supervisorPath),\n    65\t      readOnlyPaths: readOnlyPaths.map((source) => fs.realpathSync(source)),\n    66\t    },\n    67\t  };\n    68\t}\n    69\t\n    70\tfunction pathOverlaps(left, right) {\n   230\t  try { executableFiles = allowedFiles.map((item) => fs.realpathSync(item)); }\n   231\t  catch { return \"candidate runtime executable is unavailable\"; }\n   232\t  for (const root of roots) {\n   233\t    const rootProblem = protectedRuntimeRootProblem(root);\n   234\t    if (rootProblem) return rootProblem;\n   235\t  }\n   236\t  for (const item of readOnlyPaths) {\n   237\t    if (typeof item !== \"string\" || !path.isAbsolute(item)) return \"candidate runtime paths must be absolute\";\n   238\t    let resolved;\n   239\t    try { resolved = fs.realpathSync(item); }\n   240\t    catch { return `candidate runtime path is unavailable: ${item}`; }\n   241\t    const stat = fs.statSync(resolved);\n   242\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   243\t    const explicitlySelectedTempExecutable = executableFiles.includes(resolved) && stat.isFile() && resolved.startsWith(`/tmp${path.sep}`);\n   244\t    if (FORBIDDEN_RUNTIME_ROOTS.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !explicitlySelectedTempExecutable) {\n   245\t      return `protected candidate runtime path is forbidden: ${resolved}`;\n   246\t    }\n   247\t    if (resolved === os.homedir() || (resolved.startsWith(`${os.homedir()}${path.sep}`) && resolved.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part)))) {\n   248\t      return `sensitive candidate runtime path is forbidden: ${resolved}`;\n   249\t    }\n   250\t    if (!stat.isFile() && !stat.isDirectory()) return `candidate runtime path is not a regular file or directory: ${resolved}`;\n   251\t    if (!roots.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !executableFiles.includes(resolved)) {\n   252\t      return `candidate runtime path is outside its explicit allowlist: ${resolved}`;\n   253\t    }\n   254\t    if (executableFiles.includes(resolved) && !stat.isFile()) return `candidate runtime executable is not a regular file: ${resolved}`;\n   255\t    if (stat.isDirectory()) assertNoSymlinks(resolved);\n   256\t  }\n   257\t  return null;\n   258\t}\n   259\t\n   260\tfunction protectedRuntimeRootProblem(root) {\n   261\t  if (root.startsWith(`${os.homedir()}${path.sep}`) && root.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part))) return `sensitive candidate runtime root is forbidden: ${root}`;\n   262\t  if (root === \"/\" || root === \"/home\" || root === os.homedir() || FORBIDDEN_RUNTIME_ROOTS.some((item) => root === item || root.startsWith(`${item}${path.sep}`))) return `protected candidate runtime root is forbidden: ${root}`;\n   263\t  return null;\n   264\t}\n   265\t\n   266\texport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n   267\t  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n   268\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   269\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   270\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n   271\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n   272\t  if (mountProblem) throw new Error(mountProblem);\n   273\t  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n   274\t    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n   275\t  }\n   276\t  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n   277\t  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n   278\t    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n   279\t  }\n   280\t  const workspace = mountSources.runtimeSources.cwd;\n   281\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   282\t  for (const source of mountSources.systemDirectories) {\n   283\t    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   284\t    args.push(\"--ro-bind\", source, source);\n   285\t  }\n   286\t  for (const source of mountSources.systemFiles) args.push(\"--ro-bind\", source, source);\n   287\t  for (const source of mountSources.systemEtcDirectories) args.push(\"--ro-bind\", source, source);\n   288\t  const isolatedHome = mountSources.runtimeSources.home;\n   289\t  args.push(\"--symlink\", \"usr/bin\", \"/bin\", \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--bind\", isolatedHome, \"/home/eval\", \"--tmpfs\", \"/run\");\n   290\t  args.push(\"--dir\", \"/run/eval-proxy\", \"--ro-bind\", mountSources.runtimeSources.proxyDirectory, \"/run/eval-proxy\");\n   291\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/run\", \"/run/eval-proxy\"]);\n   292\t  const addTargetParents = (target) => {\n   293\t    const parts = target.split(path.sep).filter(Boolean);\n   294\t    let current = \"\";\n   295\t    for (const part of parts.slice(0, -1)) {\n   296\t      current += `/${part}`;\n   297\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   298\t    }\n   299\t  };\n   300\t  for (const resolved of mountSources.runtimeSources.readOnlyPaths) {\n   301\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   302\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   303\t    addTargetParents(resolved);\n   304\t    args.push(\"--ro-bind\", resolved, resolved);\n   305\t  }\n   306\t  addTargetParents(\"/runner/agent_sandbox.mjs\");\n   307\t  args.push(\"--ro-bind\", nodeRuntime, \"/runner/node\");\n   308\t  args.push(\"--ro-bind\", mountSources.runtimeSources.supervisorPath, \"/runner/agent_sandbox.mjs\");\n   309\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"CI\", \"1\", \"--\");\n   310\t  args.push(\"/runner/node\", \"/runner/agent_sandbox.mjs\");\n   311\t  return { cmd: BWRAP, argv: args };\n   312\t}\n   313\t\n   314\t/** Run a fixed executable probe without exposing the host filesystem, environment, or network. */\n   315\texport function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [], allowedRoots = [], allowedFiles = [], timeoutMs = 5000, workspaceReadOnly = false, protectedCorpusPaths = [] }) {\n   316\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing executable probe\");\n   317\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles);\n   318\t  if (mountProblem) throw new Error(mountProblem);\n   319\t  const workspace = fs.realpathSync(cwd);\n   320\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   321\t  for (const source of SYSTEM_BINARIES) {\n   322\t    try {\n   323\t      if (fs.statSync(source).isDirectory()) {\n   324\t        if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   325\t        args.push(\"--ro-bind\", source, source);\n   326\t      }\n   327\t    } catch {}\n   328\t  }\n   329\t  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n   330\t    try { if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source); } catch {}\n   331\t  }\n   332\t  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n   333\t  args.push(workspaceReadOnly ? \"--ro-bind\" : \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--tmpfs\", \"/run\", \"--symlink\", \"usr/bin\", \"/bin\");\n   334\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/home/eval\", \"/run\"]);\n   335\t  const addParents = (target) => {\n   336\t    let current = \"\";\n   337\t    for (const part of target.split(path.sep).filter(Boolean).slice(0, -1)) {\n   338\t      current += `/${part}`;\n   339\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   340\t    }\n   341\t  };\n   342\t  for (const item of readOnlyPaths) {\n   343\t    const resolved = fs.realpathSync(item);\n   344\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   345\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   346\t    addParents(resolved);\n   347\t    args.push(\"--ro-bind\", resolved, resolved);\n   348\t  }\n   349\t  const resolvedCommand = fs.realpathSync(command);\n   350\t  if (!SYSTEM_BINARIES.some((root) => resolvedCommand === root || resolvedCommand.startsWith(`${root}${path.sep}`)) && !readOnlyPaths.some((item) => fs.realpathSync(item) === resolvedCommand)) {\n   351\t    throw new Error(\"isolated executable must be included in the explicit read-only runtime paths\");\n   352\t  }\n   353\t  const bindSources = args.flatMap((arg, i) => (arg === \"--bind\" || arg === \"--ro-bind\") ? [args[i + 1]] : []);\n   354\t  const protectedOverlap = mountSourceOverlapProblem(bindSources, protectedCorpusPaths);\n   355\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   356\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"LANG\", \"C.UTF-8\", \"--\");\n   357\t  args.push(resolvedCommand, ...argv);\n   358\t  return { cmd: BWRAP, argv: args, timeoutMs };\n   359\t}\n   360\t\n   361\texport function runIsolatedProcess(spec, { outputLimit = 16_384, input = \"\", resources = null } = {}) {\n   362\t  if (!Number.isFinite(spec.timeoutMs) || spec.timeoutMs <= 0) throw new Error(\"isolated process spec has no timeoutMs\");\n   363\t  const { child, containment } = spawnContained(spec, resources, { cwd: \"/\", env: {}, detached: true, stdio: [\"pipe\", \"pipe\", \"pipe\"] });\n   364\t  return new Promise((resolve) => {\n   365\t    let stdout = \"\";\n   515\t});\n   516\t\n   517\ttest(\"qualification runtime mounts cannot overlap the task tree, held-out store, or private validator paths\", async () => {\n   518\t  const { hiddenTestIsolationProblem, runtimeCorpusOverlapProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   519\t  const { agentSandboxArgv, candidateSandboxHostMountSources, isolatedArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   520\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-corpus-overlap-\"));\n   521\t  try {\n   522\t    const store = path.join(root, \"heldout-v2\");\n   523\t    const tasks = path.join(store, \"tasks\");\n   524\t    const references = path.join(store, \"reference\");\n   525\t    const runtimeRoot = path.join(root, \"runtime\");\n   526\t    const home = path.join(root, \"home\");\n   527\t    const proxyDirectory = path.join(root, \"proxy\");\n   528\t    const readOnlyRuntime = path.join(runtimeRoot, \"runtime.bin\");\n   529\t    const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n   530\t    const privateValidator = path.join(root, \"private-validator\");\n   531\t    fs.mkdirSync(tasks, { recursive: true });\n   532\t    fs.mkdirSync(references);\n   533\t    fs.mkdirSync(runtimeRoot);\n   534\t    fs.mkdirSync(home);\n   535\t    fs.mkdirSync(proxyDirectory);\n   536\t    fs.mkdirSync(privateValidator);\n   537\t    fs.writeFileSync(readOnlyRuntime, \"runtime\\n\");\n   538\t    fs.writeFileSync(path.join(tasks, \"task.json\"), \"{}\\n\");\n   539\t    fs.writeFileSync(path.join(references, \"solution.patch\"), \"REFERENCE_SOLUTION_CANARY\\n\");\n   540\t    fs.writeFileSync(path.join(privateValidator, \"validate.mjs\"), \"PRIVATE_VALIDATOR_CANARY\\n\");\n   541\t    const alias = path.join(root, \"store-alias\");\n   542\t    fs.symlinkSync(store, alias, \"dir\");\n   543\t\n   544\t    const mountContext = { cwd: runtimeRoot, home, proxyDirectory, nodeRuntime: process.execPath, supervisorPath };\n   545\t    const hostMounts = candidateSandboxHostMountSources({ ...mountContext, readOnlyPaths: [readOnlyRuntime] });\n   546\t    const hostToolchain = (preferred: string, command: string, argv: string[], preferCommand = false) => {\n   547\t      const fallback = () => {\n   548\t        try { return fs.statSync(preferred).isDirectory() ? preferred : null; } catch { return null; }\n   549\t      };\n   550\t      if (!preferCommand) {\n   551\t        const result = fallback();\n   552\t        if (result) return result;\n   553\t      }\n   554\t      const result = spawnSync(command, argv, { encoding: \"utf8\" });\n   555\t      const candidate = result.status === 0 ? result.stdout.trim() : \"\";\n   556\t      try { if (fs.statSync(candidate).isDirectory()) return candidate; } catch {}\n   557\t      return preferCommand ? fallback() : null;\n   558\t    };\n   559\t    const expectedToolchains = [\n   560\t      hostToolchain(\"/usr/local/go\", \"go\", [\"env\", \"GOROOT\"], true),\n   561\t      hostToolchain(\"/opt/nexus-qual/rust\", \"rustc\", [\"--print\", \"sysroot\"]),\n   562\t    ].filter((item): item is string => Boolean(item));\n   563\t    const existingDirectories = [\"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/lib\", \"/lib64\", \"/usr/local/lib\"]\n   564\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   565\t    const existingEtcFiles = [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]\n   566\t      .filter((item) => { try { return fs.statSync(item).isFile(); } catch { return false; } });\n   567\t    const existingEtcDirectories = [\"/etc/alternatives\"]\n   568\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   569\t    assert.deepEqual(hostMounts.systemDirectories, existingDirectories);\n   570\t    assert.deepEqual(hostMounts.systemFiles, existingEtcFiles);\n   571\t    assert.deepEqual(hostMounts.systemEtcDirectories, existingEtcDirectories);\n   572\t    assert.deepEqual(hostMounts.toolchainDirectories, expectedToolchains);\n   573\t    assert.deepEqual(hostMounts.runtimeSources, {\n   574\t      cwd: fs.realpathSync(runtimeRoot),\n   575\t      home: fs.realpathSync(home),\n   576\t      proxyDirectory,\n   577\t      nodeRuntime: fs.realpathSync(process.execPath),\n   578\t      supervisorPath: fs.realpathSync(supervisorPath),\n   579\t      readOnlyPaths: [fs.realpathSync(readOnlyRuntime)],\n   580\t    });\n   581\t\n   582\t    assert.equal(runtimeCorpusOverlapProblem([runtimeRoot], [runtimeRoot], tasks), null, \"an unrelated pinned runtime remains usable\");\n   583\t    assert.match(runtimeCorpusOverlapProblem([path.join(references, \"solution.patch\")], [store], tasks) ?? \"\", /overlaps protected corpus material/);\n   584\t    assert.match(runtimeCorpusOverlapProblem([runtimeRoot], [store], tasks) ?? \"\", /overlaps protected corpus material/, \"a broad allowlist root cannot contain the corpus store\");\n   585\t    assert.match(runtimeCorpusOverlapProblem([path.join(alias, \"reference\", \"solution.patch\")], [alias], tasks) ?? \"\", /overlaps protected corpus material/, \"symlink aliases are resolved before comparing paths\");\n194-     - test data: `testdata/`, `fixtures/`, `__snapshots__/`, `snapshots/`, `golden/`, mocks, `*.golden`, `*.snap`;\n195-     - test-runner configuration and setup files;\n196-     - interpreter and package-manager hooks: `sitecustomize.py`, `.pth`, `.npmrc`, `.yarnrc*`, `.pnpmfile.cjs`,\n197:       `go.work`, `rust-toolchain*`, `build.rs`;\n198-     - `Makefile`, `.env*`, `.gitattributes` and `.gitignore`;\n199-     - symlinks, any path that passes through a symlink in the fresh tree, and files over 2 MiB.\n200-\n","exit_code":0,"duration":{"secs":0,"nanos":27297}},"started_at_ms":179