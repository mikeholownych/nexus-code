.jsonl\",\n          \"line\": 1951\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:8a594d0e92c29b347b3994b9\",\n      \"paths\": [\n        \"architecture.routing.evaluation\"\n      ],\n      \"kind\": \"closed-negative\",\n      \"locus\": [\n        \"deep-planner/lead-coder\"\n      ],\n      \"text\": \"The frozen 11-task comparison did not establish a benefit for first-turn-heavy deep-planner/lead-coder routing: B1 passed 7/11, B2 passed 6/11, exact paired sign-test p=1.0, and B2 took about 21% longer; preserve this bounded finding and revisit only with a larger corpus and a substantive hypothesis about which tasks need deeper planning.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"5e99063d-042c-4962-9221-1650fa0f4489\",\n          \"checkpoint_id\": \"01M41G6TDNTMPXWBKWES1FXNX9\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 640\n        },\n        {\n          \"session_id\": \"5e99063d-042c-4962-9221-1650fa0f4489\",\n          \"checkpoint_id\": \"01M41G6TDNTMPXWBKWES1FXNX9\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:981c2e1cfa3f4798882aa1ad\",\n      \"paths\": [\n        \"architecture.boundaries.rationale\"\n      ],\n      \"kind\": \"decision\",\n      \"text\": \"The user chose hardened legacy tests in the SWE-bench style for the T2 oracle, preserving the existing test format while strengthening isolation and integrity checks.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"f73ff17f-fe7b-4087-bd8d-f26ad4102ad2\",\n          \"checkpoint_id\": \"01M59W4SMWH7G60B0E53VW0D22\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 474\n        },\n        {\n          \"session_id\": \"f73ff17f-fe7b-4087-bd8d-f26ad4102ad2\",\n          \"checkpoint_id\": \"01M59W4SMWH7G60B0E53VW0D22\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:50:18.135593148Z\",\n      \"updated_at\": \"2026-10-28T07:50:18.135593148Z\"\n    },\n    {\n      \"id\": \"fact:834bf896b6a707ea9812fa6e\",\n      \"paths\": [\n        \"workflow.release.reproducibility\"\n      ],\n      \"kind\": \"invariant\",\n      \"locus\": [\n        \"install.sh\"\n      ],\n      \"text\": \"Cross-runner release reproduction must retain comparisons of the SBOM, third-party notices, and install.sh, along with source and toolchain identity evidence; comparing fewer artifacts weakens the release requirement.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 1230\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:ed5042be7c9d829b2c25a64d\",\n      \"paths\": [\n        \"constraints.invariants.general\"\n      ],\n      \"kind\": \"invariant\",\n      \"text\": \"Do not kill, renice or reassign the Docker redis-server process sharing the nexus-eval UID; the UID collision does not make it part of evaluator management.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"f73ff17f-fe7b-4087-bd8d-f26ad4102ad2\",\n          \"checkpoint_id\": \"01M59W4SMWH7G60B0E53VW0D22\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 474\n        },\n        {\n          \"session_id\": \"f73ff17f-fe7b-4087-bd8d-f26ad4102ad2\",\n          \"checkpoint_id\": \"01M59W4SMWH7G60B0E53VW0D22\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:8c0cf63c9843d4955366c396\",\n      \"paths\": [\n        \"workflow.testing.rules\"\n      ],\n      \"kind\": \"gotcha\",\n      \"text\": \"Earlier host-isolation reports run with an isolated HOME did not establish that the evaluator could not access the operator's files: the validator checked the temporary home instead; those reports must not be treated as operator-home isolation evidence.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 361\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:fd69139f78057ecc9352c108\",\n      \"paths\": [\n        \"workflow.testing.rules\"\n      ],\n      \"kind\": \"decision\",\n      \"locus\": [\n        \"development/pilot\"\n      ],\n      \"text\": \"The user reassigned held-out task authorship to a separate author and custodian in ~/nexus-heldout-v2; the original 28-task corpus is development/pilot material only because an implementing agent coordinated its author, compromising qualification independence.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"b79a4439-e6ad-4986-aa16-4a81f838ac71\",\n          \"checkpoint_id\": \"01M568DWD19TM18BY3E38JSGVC\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 144\n        },\n        {\n          \"session_id\": \"b79a4439-e6ad-4986-aa16-4a81f838ac71\",\n          \"checkpoint_id\": \"01M568DWD19TM18BY3E38JSGVC\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:b3ed2a3de41e312e56fcfc59\",\n      \"paths\": [\n        \"constraints.invariants.general\"\n      ],\n      \"kind\": \"invariant\",\n      \"locus\": [\n        \"v1.0.0\"\n      ],\n      \"text\": \"The user mandates no deprecated packages for Nexus Code v1.0.0; documenting an end-of-life dependency or runtime is not an acceptable exception.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 692\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:642f4f63e5f9cca65cd09e6a\",\n      \"paths\": [\n        \"constraints.evaluation.baselines\"\n      ],\n      \"kind\": \"gotcha\",\n      \"locus\": [\n        \"repo.commit\"\n      ],\n      \"text\": \"Injected-defect tasks in the original ~/nexus-heldout corpus squash history into an orphan baseline and remove the origin remote to prevent revealing the defect; their upstream repo.commit is therefore unreachable inside task workspaces, so harnesses cannot use it as the diff baseline.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"b79a4439-e6ad-4986-aa16-4a81f838ac71\",\n          \"checkpoint_id\": \"01M568DWD19TM18BY3E38JSGVC\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 144\n        },\n        {\n          \"session_id\": \"b79a4439-e6ad-4986-aa16-4a81f838ac71\",\n          \"checkpoint_id\": \"01M568DWD19TM18BY3E38JSGVC\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    