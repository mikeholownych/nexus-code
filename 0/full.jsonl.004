{"timestamp":"2026-10-29T03:29:08.867Z","ordinal":487868,"type":"token_usage_record","payload":{"thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a185b3-b029-7902-8b23-e177e3cfc4d8","session_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","root_turn_id":"01a185b3-b029-7902-8b23-e177e3cfc4d8","response_id":"resp_0db389702a7164cc016ae2bd830974819f95804cea6523b3e7","usage":{"input_tokens":75972,"cached_input_tokens":73984,"cache_write_input_tokens":0,"output_tokens":162,"reasoning_output_tokens":34,"total_tokens":76134},"turn_token_usage":{"input_tokens":700142,"cached_input_tokens":681856,"cache_write_input_tokens":0,"output_tokens":2862,"reasoning_output_tokens":134,"total_tokens":703004},"thread_token_usage":{"input_tokens":9106974473,"cached_input_tokens":9009900928,"cache_write_input_tokens":0,"output_tokens":26181353,"reasoning_output_tokens":15275416,"total_tokens":9133155826}}}
