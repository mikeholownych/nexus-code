oSymlinks(resolved);\n   346\t    addParents(resolved);\n   347\t    args.push(\"--ro-bind\", resolved, resolved);\n   348\t  }\n   349\t  const resolvedCommand = fs.realpathSync(command);\n   350\t  if (!SYSTEM_BINARIES.some((root) => resolvedCommand === root || resolvedCommand.startsWith(`${root}${path.sep}`)) && !readOnlyPaths.some((item) => fs.realpathSync(item) === resolvedCommand)) {\n   351\t    throw new Error(\"isolated executable must be included in the explicit read-only runtime paths\");\n   352\t  }\n   353\t  const bindSources = args.flatMap((arg, i) => (arg === \"--bind\" || arg === \"--ro-bind\") ? [args[i + 1]] : []);\n   354\t  const protectedOverlap = mountSourceOverlapProblem(bindSources, protectedCorpusPaths);\n   355\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   356\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"LANG\", \"C.UTF-8\", \"--\");\n   357\t  args.push(resolvedCommand, ...argv);\n   358\t  return { cmd: BWRAP, argv: args, timeoutMs };\n   359\t}\n   360\t\n   361\texport function runIsolatedProcess(spec, { outputLimit = 16_384, input = \"\", resources = null } = {}) {\n   362\t  if (!Number.isFinite(spec.timeoutMs) || spec.timeoutMs <= 0) throw new Error(\"isolated process spec has no timeoutMs\");\n   363\t  const { child, containment } = spawnContained(spec, resources, { cwd: \"/\", env: {}, detached: true, stdio: [\"pipe\", \"pipe\", \"pipe\"] });\n   364\t  return new Promise((resolve) => {\n   365\t    let stdout = \"\";\n   515\t});\n   516\t\n   517\ttest(\"qualification runtime mounts cannot overlap the task tree, held-out store, or private validator paths\", async () => {\n   518\t  const { hiddenTestIsolationProblem, runtimeCorpusOverlapProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   519\t  const { agentSandboxArgv, candidateSandboxHostMountSources, isolatedArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   520\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-corpus-overlap-\"));\n   521\t  try {\n   522\t    const store = path.join(root, \"heldout-v2\");\n   523\t    const tasks = path.join(store, \"tasks\");\n   524\t    const references = path.join(store, \"reference\");\n   525\t    const runtimeRoot = path.join(root, \"runtime\");\n   526\t    const home = path.join(root, \"home\");\n   527\t    const proxyDirectory = path.join(root, \"proxy\");\n   528\t    const readOnlyRuntime = path.join(runtimeRoot, \"runtime.bin\");\n   529\t    const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n   530\t    const privateValidator = path.join(root, \"private-validator\");\n   531\t    fs.mkdirSync(tasks, { recursive: true });\n   532\t    fs.mkdirSync(references);\n   533\t    fs.mkdirSync(runtimeRoot);\n   534\t    fs.mkdirSync(home);\n   535\t    fs.mkdirSync(proxyDirectory);\n   536\t    fs.mkdirSync(privateValidator);\n   537\t    fs.writeFileSync(readOnlyRuntime, \"runtime\\n\");\n   538\t    fs.writeFileSync(path.join(tasks, \"task.json\"), \"{}\\n\");\n   539\t    fs.writeFileSync(path.join(references, \"solution.patch\"), \"REFERENCE_SOLUTION_CANARY\\n\");\n   540\t    fs.writeFileSync(path.join(privateValidator, \"validate.mjs\"), \"PRIVATE_VALIDATOR_CANARY\\n\");\n   541\t    const alias = path.join(root, \"store-alias\");\n   542\t    fs.symlinkSync(store, alias, \"dir\");\n   543\t\n   544\t    const mountContext = { cwd: runtimeRoot, home, proxyDirectory, nodeRuntime: process.execPath, supervisorPath };\n   545\t    const hostMounts = candidateSandboxHostMountSources({ ...mountContext, readOnlyPaths: [readOnlyRuntime] });\n   546\t    const hostToolchain = (preferred: string, command: string, argv: string[], preferCommand = false) => {\n   547\t      const fallback = () => {\n   548\t        try { return fs.statSync(preferred).isDirectory() ? preferred : null; } catch { return null; }\n   549\t      };\n   550\t      if (!preferCommand) {\n   551\t        const result = fallback();\n   552\t        if (result) return result;\n   553\t      }\n   554\t      const result = spawnSync(command, argv, { encoding: \"utf8\" });\n   555\t      const candidate = result.status === 0 ? result.stdout.trim() : \"\";\n   556\t      try { if (fs.statSync(candidate).isDirectory()) return candidate; } catch {}\n   557\t      return preferCommand ? fallback() : null;\n   558\t    };\n   559\t    const expectedToolchains = [\n   560\t      hostToolchain(\"/usr/local/go\", \"go\", [\"env\", \"GOROOT\"], true),\n   561\t      hostToolchain(\"/opt/nexus-qual/rust\", \"rustc\", [\"--print\", \"sysroot\"]),\n   562\t    ].filter((item): item is string => Boolean(item));\n   563\t    const existingDirectories = [\"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/lib\", \"/lib64\", \"/usr/local/lib\"]\n   564\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   565\t    const existingEtcFiles = [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]\n   566\t      .filter((item) => { try { return fs.statSync(item).isFile(); } catch { return false; } });\n   567\t    const existingEtcDirectories = [\"/etc/alternatives\"]\n   568\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   569\t    assert.deepEqual(hostMounts.systemDirectories, existingDirectories);\n   570\t    assert.deepEqual(hostMounts.systemFiles, existingEtcFiles);\n   571\t    assert.deepEqual(hostMounts.systemEtcDirectories, existingEtcDirectories);\n   572\t    assert.deepEqual(hostMounts.toolchainDirectories, expectedToolchains);\n   573\t    assert.deepEqual(hostMounts.runtimeSources, {\n   574\t      cwd: fs.realpathSync(runtimeRoot),\n   575\t      home: fs.realpathSync(home),\n   576\t      proxyDirectory,\n   577\t     