le()) args.push(\"--ro-bind\", source, source); } catch {}\n   449\t  }\n   450\t  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n   451\t  args.push(workspaceReadOnly ? \"--ro-bind\" : \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--tmpfs\", \"/run\", \"--symlink\", \"usr/bin\", \"/bin\");\n   452\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/home/eval\", \"/run\"]);\n   453\t  const addParents = (target) => {\n   454\t    let current = \"\";\n   455\t    for (const part of target.split(path.sep).filter(Boolean).slice(0, -1)) {\n    42\t      if (!row || typeof row !== \"object\" || Array.isArray(row) || Object.keys(row).sort().join(\",\") !== \"expected,input\") {\n    43\t        return \"hidden black-box oracle cases must contain only input and expected fields\";\n    44\t      }\n    45\t      if (Buffer.byteLength(JSON.stringify(row), \"utf8\") > MAX_CASE_BYTES) return \"hidden black-box oracle case exceeds the size limit\";\n    46\t    }\n    47\t  } catch {\n    48\t    return \"hidden black-box oracle cases are unavailable or malformed\";\n    49\t  }\n    50\t  if (!Object.hasOwn(RUNTIMES, check.runtime)) return \"hidden black-box oracle runtime is not allowlisted\";\n    51\t  if (check.runtime === \"python3\") {\n    52\t    const toolchainProblem = oracleToolchainsProblem();\n    53\t    if (toolchainProblem) return toolchainProblem;\n    54\t  }\n    55\t  if (!Array.isArray(check.argv) || check.argv.length !== 1 || typeof check.argv[0] !== \"string\" || check.argv[0].includes(\"\\0\") || Buffer.byteLength(check.argv[0]) > 1024) {\n    56\t    return \"hidden black-box oracle argv must name only one candidate entrypoint\";\n    