\t    deliveredProcesses: signal.deliveredProcesses,\n   545\t    forced: signal.forced,\n   546\t    firstExitCode: signal.firstExitCode,\n   547\t    payloadExitSignal: signal.payloadExitSignal,\n   548\t    supervisorWrapperExitSignal: signal.supervisorWrapperExitSignal,\n   549\t    signalDuringActiveTurn: signal.signalDuringActiveTurn,\n   550\t    resumed: resumed.code === 0 && resumed.json?.turn?.execution === \"COMPLETED\",\n   551\t    resumeExitCode: resumed.code,\n   552\t    resumeTurnExecution: resumed.json?.turn?.execution ?? null,\n   553\t  };\n   554\t  return {\n   555\t    ...resumed,\n   556\t    stdout: `${interrupted.stdout}\\n--- T4 SIGTERM interruption ---\\n${resumed.stdout}`,\n   557\t    stderr: `${interrupted.stderr}\\n--- T4 resume attempt ---\\n${resumed.stderr}`,\n   558\t    t4FaultsInjected: [{ kind: \"sigterm_resume\", source: \"task_fixture_or_runner\", evidence }],\n   559\t  };\n   560\t}\n366:    command = resolvePathExecutable(agent, { ...process.env, ...(config.env ?? {}) }) ?? agent;\n467:function agentCommand(task, ws, home, budget, agentIdentity, localToken) {\n474:    PATH: config.env?.PATH ?? \"/usr/bin:/bin\", LANG: config.env?.LANG ?? \"C.UTF-8\", LC_ALL: config.env?.LC_ALL ?? \"C.UTF-8\",\n524:    Object.assign(env, { GOOSE_PROVIDER: \"openai\", GOOSE_MODEL: config.model, OPENAI_HOST: u.origin, OPENAI_BASE_PATH: `${u.pathname.replace(/^\\/|\\/$/g, \"\")}/chat/completions`, GOOSE_MODE: \"auto\", GOOSE_DISABLE_KEYRING: \"1\", GOOSE_CONTEXT_LIMIT: String(limits.context), GOOSE_MAX_TOKENS: String(limits.output), GOOSE_MAX_TURNS: String(budget.steps), GOOSE_TEMPERATURE: String(sampling.temperature) });\n749:  const r = spawnSync(\"git\", [\"rev-parse\", rev], { cwd: ws, encoding: \"utf8\", env: { PATH: \"/usr/bin:/bin\", HOME: os.tmpdir(), GIT_CONFIG_NOSYSTEM: \"1\", GIT_CONFIG_GLOBAL: \"/dev/null\" } });\n809:    env: { PATH: \"/usr/bin:/bin\", HOME: os.tmpdir(), GIT_CONFIG_NOSYSTEM: \"1\", GIT_CONFIG_GLOBAL: \"/dev/null\", GIT_TERMINAL_PROMPT: \"0\", GIT_ALLOW_PROTOCOL: \"https\" },\n   245\t    const model = proxy ? proxy.stats() : null;\n   246\t    const fixtureFaults = observeT4Fixture(task, agent, agent.resources, config.resources);\n   247\t    const contaminated = treeDigest(task.dir) !== sourceBefore || `${agent.stdout}${agent.stderr}`.includes(tasksDir);\n   248\t    // T3 judges the workspace as it was when the objective's work ended (snapshot taken before the probe turn).\n   249\t    const t3 = agent.t3Driver ? scoreT3Run({ task, baseline: t3Baseline, driver: agent.t3Driver, preconditions: agent.t3Preconditions, compactions: countCompactions(home) }) : null;\n   250\t    // Legacy hidden tests share a process with candidate code. In qualification (or with hardenedChecks) they never\n   251\t    // run in the agent's workspace: each check gets a fresh staging of the baseline with only the agent's source\n   252\t    // changes (eval/hardened_check.mjs). Black-box oracles already keep expectations outside the candidate.\n   253\t    const hardened = (config.qualification === true || config.hardenedChecks === true) && task.hidden?.protocol !== \"blackbox-v1\";\n   254\t    let hardening = null;\n   255\t    let hiddenWs = ws;\n   256\t    let regressionWs = ws;\n   257\t    if (hardened) {\n   258\t      hiddenWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-check-${task.id}-`));\n   259\t      regressionWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-regression-${task.id}-`));\n   260\t      checkDirs.push(hiddenWs, regressionWs);\n   261\t      await prepareWorkspace(task, hiddenWs);\n   262\t      // Fixture tasks commit at staging time, so compare content (the tree), not the commit id.\n   263\t      if (gitRev(hiddenWs, \"HEAD^{tree}\") !== baselineTree) throw new Error(\"hardened check workspace staged a different baseline\");\n   264\t      hardening = { baseline: baselineTree, ...applyAgentChanges(ws, hiddenWs) };\n   265\t      cloneWorkspace(hiddenWs, regressionWs);\n   266\t    }\n   267\t    const refused = (check) => ({ pass: false, status: null, timedOut: false, overflow: false, output: `hardened check refused: ${hardening.configChanges.join(\"; \")}`, refused: true, resources: null, containmentProblem: null, check });\n   268\t    const hidden = hardening?.configChanges.length ? refused(\"hidden\") : await runCheck(task, hiddenWs, task.hidden, true, { readOnlyHidden: hardened });\n   269\t    const regression = task.regression ? (hardening?.configChanges.length ? refused(\"regression\") : await runCheck(task, regressionWs, task.regression, false)) : null;\n   270\t    for (const [phase, check] of [[\"hidden\", hidden], [\"regression\", regression]]) {\n   271\t      if (check?.containmentProblem) throw new Error(`${phase} check containment failed: ${check.containmentProblem}`);\n   272\t    }\n   273\t    const turn = agent.json?.turn ?? null;\n   274\t    // Nexus reports a structured outcome; for the other agents a clean exit within the budget is their completion claim.\n   275\t    const claimedComplete = turn\n   276\t      ? turn.execution === \"COMPLETED\" && [\"VERIFIED\", \"REGRESSION_FREE\", \"UNVERIFIED\", \"NOT_REQUIRED\"].includes(turn.outcome)\n   277\t      : agent.code === 0 && !agent.timedOut && !agent.outputExceeded;\n   278\t    return {\n   279\t      ...base,\n   280\t      wallMs,\n   281\t      exitCode: agent.code,\n   282\t      timedOut: agent.timedOut,\n   283\t      outputExceeded: agent.outputExceeded,\n   284\t      turn: turn && { execution: turn.execution, outcome: turn.outcome, reason: turn.reason ?? null, steps: turn.steps ?? null, contextNotRetained: turn.contextNotRetained ?? 0 },\n   285\t      claimedComplete,\n   286\t      claimedVerified: turn?.outcome === \"VERIFIED\",\n   287\t      hiddenPass: hidden.pass,\n   288\t      regressionPass: regression ? regression.pass : null,\n   289\t      falseVerified: turn?.outcome === \"VERIFIED\" && !hidden.pass,\n   290\t      contaminated,\n   291\t      tokens: agent.json?.tokenStats ?? null,\n   292\t      ...(hardening ? { hardened: { baseline: hardening.baseline, applied: hardening.applied.length, discarded: hardening.discarded, configChanges: hardening.configChanges } } : {}),\n   293\t      ...(t3 ? { t3 } : {}),\n   294\t      model,\n   295\t      ...((agent.t4FaultsInjected?.length || fixtureFaults.length) ? { t4FaultsInjected: [...(agent.t4FaultsInjected ?? []), ...fixtureFaults] } : {}),\n   296\t      resources: config.resources ? { agent: agent.resources, hidden: hidden.resources ?? null, regression: regression?.resources ?? null, ...(t3BaselineResources.length ? { t3Baseline: t3BaselineResources } : {}) } : null,\n   297\t      logs: saveLogs(task, run, agent, hidden, regression),\n   298\t    };\n   299\t  } catch (err) {\n   300\t    return { ...base, wallMs: 0, error: String(err?.message ?? err), hiddenPass: false, regressionPass: null, falseVerified: false, claimedComplete: false, claimedVerified: false };\n   301\t  } finally {\n   302\t    if (!args.keep) {\n   303\t      for (const dir of checkDirs) fs.rmSync(dir, { recursive: true, force: true });\n   304\t      fs.rmSync(ws, { recursive: true, force: true });\n   305\t      fs.rmSync(home, { recursive: true, force: true });\n   306\t    }\n   307\t  }\n   308\t}\n   309\t\n   310\tasync function prepareWorkspace(task, ws) {\n   311\t  if (task.fixture) {\n   312\t    const fixture = confinedPath(task.dir, task.fixture);\n   313\t    assertNoSymlinks(fixture);\n   314\t    fs.cpSync(fixture, ws, { recursive: true, verbatimSymlinks: true });\n   315\t    sh(\"git\", [\"init\", \"-q\"], ws);\n   316\t    sh(\"git\", [\"add\", \"-A\"], ws);\n   317\t    sh(\"git\", [\"-c\", \"user.name=eval\", \"-c\", \"user.email=eval@example.invalid\", \"commit\", \"-qm\", \"fixture\"], ws);\n   318\t  } else if (task.repo) {\n   319\t    const cache = path.join(ROOT, \"eval/.cache\", createHash(\"sha256\").update(task.repo.url).digest(\"hex