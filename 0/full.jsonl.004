",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T02:33:15Z\",\"conclusion\":\"success\",\"name\":\"Run npm --prefix cli test\",\"number\":18,\"startedAt\":\"2026-10-29T02:17:19Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T02:33:16Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/security_gates.sh\",\"number\":19,\"startedAt\":\"2026-10-29T02:33:15Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T02:33:17Z\",\"conclusion\":\"success\",\"name\":\"Run node scripts/check_requirements.mjs\",\"number\":20,\"startedAt\":\"2026-10-29T02:33:16Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T02:33:17Z\",\"conclusion\":\"success\",\"name\":\"Run echo \\\"version=$(node -p 'require(\\\"./package.json\\\").version')\\\" >> \\\"$GITHUB_OUTPUT\\\"\",\"number\":21,\"startedAt\":\"2026-10-29T02:33:17Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T02:35:40Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/package-linux.sh \\\"v1.0.0-rc.10\\\" \\\"$RUNNER_TEMP/dist\\\"\",\"number\":22,\"startedAt\":\"2026-10-29T02:33:17Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T02:37:43Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/package-linux.sh \\\"v1.0.0-rc.10\\\" \\\"$RUNNER_TEMP/repro-check\\\"\",\"number\":23,\"startedAt\":\"2026-10-29T02:35:40Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T02:37:43Z\",\"conclusion\":\"success\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/nexus-linux-x86_64-v1.0.0-rc.10.tar.gz\\\" \\\"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-v1.0.0-rc.10.tar.gz\\\"\",\"number\":24,\"startedAt\":\"2026-10-29T02:37:43Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T02:37:43Z\",\"conclusion\":\"success\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/SHA256SUMS\\\" \\\"$RUNNER_TEMP/repro-check/SHA256SUMS\\\"\",\"number\":25,\"startedAt\":\"2026-10-29T02:37:43Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T02:37:43Z\",\"conclusion\":\"success\",\"name\