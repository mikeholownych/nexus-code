registered before attempting contact.\\\\n\\\\nParameters\\\\n----------\\\\nproject_key : str\\\\n    Project slug or human key (both work).\\\\n\\\\nReturns\\\\n-------\\\\ndict\\\\n    {\\\\n      \\\\\\\"project\\\\\\\": { \\\\\\\"slug\\\\\\\": \\\\\\\"...\\\\\\\", \\\\\\\"human_key\\\\\\\": \\\\\\\"...\\\\\\\" },\\\\n      \\\\\\\"agents\\\\\\\": [\\\\n        {\\\\n          \\\\\\\"name\\\\\\\": \\\\\\\"BackendDev\\\\\\\",\\\\n          \\\\\\\"program\\\\\\\": \\\\\\\"claude-code\\\\\\\",\\\\n          \\\\\\\"model\\\\\\\": \\\\\\\"sonnet-4.5\\\\\\\",\\\\n          \\\\\\\"task_description\\\\\\\": \\\\\\\"API development\\\\\\\",\\\\n          \\\\\\\"inception_ts\\\\\\\": \\\\\\\"2025-10-25T...\\\\\\\",\\\\n          \\\\\\\"last_active_ts\\\\\\\": \\\\\\\"2025-10-25T...\\\\\\\",\\\\n          \\\\\\\"unread_count\\\\\\\": 3\\\\n        },\\\\n        ...\\\\n      ]\\\\n    }\\\\n\\\\nExample\\\\n-------\\\\n```json\\\\n{\\\\\\\"jsonrpc\\\\\\\":\\\\\\\"2.0\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"r5\\\\\\\",\\\\\\\"method\\\\\\\":\\\\\\\"resources/read\\\\\\\",\\\\\\\"params\\\\\\\":{\\\\\\\"uri\\\\\\\":\\\\\\\"resource://agents/backend-abc123\\\\\\\"}}\\\\n```\\\\n\\\\nNotes\\\\n-----\\\\n- Agent names ar"},{"type":"input_text","text":"RES \"{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"resources\\\":[{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://config/environment\\\",\\\"name\\\":\\\"environment_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://tooling/directory\\\",\\\"name\\\":\\\"tooling_directory_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://tooling/schemas\\\",\\\"name\\\":\\\"tooling_schemas_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://tooling/metrics\\\",\\\"name\\\":\\\"tooling_metrics_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://tooling/locks\\\",\\\"name\\\":\\\"tooling_locks_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://tooling/projects\\\",\\\"name\\\":\\\"projects_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}}]}\""}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1858a-59ca-7ee1-85ff-8d21499b2944","create_time":1793241875.6342266}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
