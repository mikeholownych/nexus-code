\n        \"jsf/test/methods/absoluteValue.js\",\n        \"jsf/test/methods/clone.js\",\n        \"jsf/test/methods/comparedTo.js\",\n        \"jsf/test/methods/config.js\",\n        \"jsf/test/methods/decimalPlaces.js\",\n        \"jsf/test/methods/dividedBy.js\",\n        \"jsf/test/methods/dividedToIntegerBy.js\",\n        \"jsf/test/methods/exponentiatedBy.js\",\n        \"jsf/test/methods/integerValue.js\",\n        \"jsf/test/methods/isBigNumber.js\",\n        \"jsf/test/methods/isMethods.js\",\n        \"jsf/test/methods/minmax.js\",\n        \"jsf/test/methods/minus.js\",\n        \"jsf/test/methods/modulo.js\",\n        \"jsf/test/methods/multipliedBy.js\",\n        \"jsf/test/methods/negated.js\",\n        \"jsf/test/methods/plus.js\",\n        \"jsf/test/methods/precision.js\",\n        \"jsf/test/methods/random.js\",\n        \"jsf/test/methods/shiftedBy.js\",\n        \"jsf/test/methods/squareRoot.js\",\n        \"jsf/test/methods/strict.js\",\n        \"jsf/test/methods/sum.js\",\n        \"jsf/test/methods/toExponential.js\",\n        \"jsf/test/methods/toFixed.js\",\n        \"jsf/test/methods/toFormat.js\",\n        \"jsf/test/methods/toFraction.js\",\n        \"jsf/test/methods/toNumber.js\",\n        \"jsf/test/methods/toObject.js\",\n        \"jsf/test/methods/toPrecision.js\",\n        \"jsf/test/methods/toString.js\",\n        \"jsf/test/test.html\",\n        \"jsf/test/test.js\",\n        \"jsf/test/tester.js\",\n        \"jsf/test/typescript/README.md\",\n        \"jsf/test/typescript/test_default_import.ts\",\n        \"jsf/test/typescript/test_global.ts\",\n        \"jsf/test/typescript/test_named_import.ts\",\n        \"jsf/test/typescript/test_require.ts\",\n        \"jsf/test/typescript/tsconfig.base.json\",\n        \"jsf/test/typescript/tsconfig.cjs.json\",\n        \"jsf/test/typescript/tsconfig.esm.json\",\n        \"jsf/test/typescript/tsconfig.global.json\",\n        \"nexus-continuity-validation/.pytest_cache/.gitignore\",\n        \"nexus-continuity-validation/.pytest_cache/CACHEDIR.TAG\",\n        \"nexus-continuity-validation/.pytest_cache/README.md\",\n        \"nexus-continuity-validation/.pytest_cache/v/cache/lastfailed\",\n        \"nexus-continuity-validation/.pytest_cache/v/cache/nodeids\",\n        \"nexus-continuity-validation/ACCEPTANCE.md\",\n        \"nexus-continuity-validation/PROGRESS.md\",\n        \"nexus-continuity-validation/VALIDATION.md\",\n        \"nexus-continuity-validation/__pycache__/importer.cpython-312.pyc\",\n        \"nexus-continuity-validation/__pycache__/test_importer.cpython-312-pytest-9.0.3.pyc\",\n        \"nexus-continuity-validation/critical.json\",\n        \"nexus-continuity-validation/critical.md\",\n        \"nexus-continuity-validation/demo.db\",\n        \"nexus-continuity-validation/demo.json\",\n        \"nexus-continuity-validation/fixtures/incidents.csv\",\n        \"nexus-continuity-validation/full.db\",\n        \"nexus-continuity-validation/full.json\",\n        \"nexus-continuity-validation/full.md\",\n        \"nexus-continuity-validation/full2.json\",\n        \"nexus-continuity-validation/full2.md\",\n        \"nexus-continuity-validation/importer.py\",\n        \"nexus-continuity-validation/test.db\",\n        \"nexus-continuity-validation/test_importer.py\",\n        \"nexus-session-session_20261014_091558_9m78.json\",\n        \"nexus-session-session_20261023_134635_z1dnlfek.json\",\n        \"nexus-session-session_20261026_162439_34f2cnrn.json\",\n        \"package-lock.json\",\n        \"scripts/check_requirements.mjs\"\n      ]\n    }\n  }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18630-61f0-70c3-bfde-82b542f705db","create_time":1793253477.0551183}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
