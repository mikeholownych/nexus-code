M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:5e471a283560d6f70ded56f2\",\n      \"paths\": [\n        \"workflow.release.scope\"\n      ],\n      \"kind\": \"decision\",\n      \"locus\": [\n        \"undici/zod\",\n        \"v1.0.0\",\n        \"v1.1.0\"\n      ],\n      \"text\": \"The user directed that all Dependabot updates target v1.1.0 rather than v1.0.0; this also includes the manually prepared experiments/ undici/zod dependency patch (62bf74e).\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 1516\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:72a26dd22b5b7ee6c1ddee9a\",\n      \"paths\": [\n        \"workflow.release.scope\"\n      ],\n      \"kind\": \"decision\",\n      \"locus\": [\n        \"post-rc.10\",\n        \"rc.11\",\n        \"v1.0.0\"\n      ],\n      \"text\": \"DEC-13 lifted the v1.0.0 scope freeze, allowing post-rc.10 refactors and features to land; rc.11 must re-qualify those changes before release.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n   