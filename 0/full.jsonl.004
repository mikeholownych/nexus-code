al/isolate.mjs:160:    toolchainDirectories: Object.values(resolveHostToolchains()).filter(Boolean),\neval/isolate.mjs:245:  const mountSources = candidateSandboxHostMountSources({ cwd: workspace, readOnlyPaths: [...readOnlySources, ...hiddenSources] });\neval/isolate.mjs:267:  const { goRoot, rustRoot } = resolveHostToolchains();\neval/isolate.mjs:369:  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\neval/isolate.mjs:388:  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\neval/run.mjs:13:import { asUserSpec, corpusManifestProblem, corpusTaskRows, fetchModelEntry, hiddenTestIsolationProblem, modelFingerprint, nexusContextLimitArgs, nexusLimitsProblem, qualificationBudgetProblem, runtimeCorpusOverlapProblem, taskTreeDigest, validateTask } from \"./validate.mjs\";\neval/run.mjs:14:import { agentSandboxArgv, assertNoSymlinks, candidateAgentPath, confinedPath, grantRunAsAccess, hiddenOutputHasTests, isolatedProcessArgv, normalizeRunAsPermissions, runIsolated, runIsolatedProcess, sandboxAvailable, stageHiddenFiles } from \"./isolate.mjs\";\neval/run.mjs:106:  return validateTask(task, dir, { qualification: config.qualification === true }).map((p) => `${id}: ${p}`);\neval/run.mjs:474:    PATH: candidateAgentPath(config.env?.PATH), LANG: config.env?.LANG ?? \"C.UTF-8\", LC_ALL: config.env?.LC_ALL ?? \"C.UTF-8\",\n    90\t}\n    91\tif (config.qualification === true && config.proxy === false) {\n    92\t  console.error(\"eval/run.mjs: qualification requires the authenticated per-run model proxy\");\n    93\t  process.exit(2);\n    94\t}\n    95\tif (!sandboxAvailable()) {\n    96\t  console.error(\"eval/run.mjs: Bubblewrap unavailable; refusing to execute task-controlled setup and validators\");\n    97\t  process.exit(2);\n    98\t}\n    99\tconst apiKey = readApiKey(config.apiKey);\n   100\tconst caFile = config.caFile ? expandHome(config.caFile) : null;\n   101\tconst caBundle = caFile ? writeCaBundle(caFile) : null;\n   102\t\n   103\t// A run is valid only with well-formed tasks, hidden tests the agent cannot read, and (for qualification) a model\n   104\t// identified beyond its alias. Any problem stops the run before an agent starts (eval/validate.mjs).\n   105\tconst problems = taskRecords.flatMap(({ id, dir, task }) => {\n   106\t  return validateTask(task, dir, { qualification: config.qualification === true }).map((p) => `${id}: ${p}`);\n   107\t});\n   108\tconst isolation = hiddenTestIsolationProblem(config, tasksDir);\n   109\tif (isolation) problems.push(isolation);\n   110\t// Qualification proves the resource contract inside hiddenTestIsolationProblem; a development config may opt in.\n   111\tif (config.resources !== undefined && config.qualification !== true) {\n   112\t  const resourceProblem = resourceProbeProblem(config.resources);\n   113\t  if (resourceProblem) problems.push(resourceProblem);\n   114\t}\n   115\tif (config.resources !== undefined && args.keep) problems.push(\"--keep would accumulate run workspaces on the size-capped resources.workspaceRoot\");\n   116\tif (config.qualification === true) {\n   117\t  const corpusProblem = corpusManifestProblem(config, tasksDir, tasks, corpusTaskRows(taskSnapshots, tasks));\n   118\t  if (corpusProblem) problems.push(corpusProblem);\n   119\t}\n   120\tif (config.qualification === true && config.sampling?.temperature !== 0) {\n   121\t  problems.push(\"qualification adapters require sampling.temperature=0 so the matched Nexus, Goose and OpenCode runs use the same deterministic setting\");\n   122\t}\n   123\tif (config.qualification === true) {\n   124\t  const budgetProblem = qualificationBudgetProblem(config);\n   125\t  if (budgetProblem) problems.push(budgetProblem);\n   126\t}\n   127\tconst agentIdentity = problems.length ? { record: null, problem: null } : await resolveAgentIdentity(config);\n   128\tif (agentIdentity.problem) problems.push(agentIdentity.problem);\n   129\tlet fingerprint = null;\n   130\tif (!problems.length) {\n   131\t  const probe = config.proxy === false ? null : await startModelProxy({ upstream: config.endpoint, caFile });\n   132\t  try {\n   133\t    const entry = await fetchModelEntry(probe?.url ?? config.endpoint, config.model, apiKey);\n   134\t    const fp = modelFingerprint(config, entry);\n   135\t    fingerprint = fp.fingerprint;\n   136\t    problems.push(...fp.missing.map((m) => `model fingerprint: ${m}`));\n   137\t    if (config.qualification === true && (config.agent ?? \"nexus\") === \"nexus\") {\n   138\t      const limitsProblem = nexusLimitsProblem(config, entry);\n   139\t      if (limitsProblem) problems.push(limitsProblem);\n   140\t    }\n   141\t  } finally {\n   142\t    await probe?.close();\n   143\t  }\n   144\t}\n   145\tif (problems.length) {\n   146\t  console.error(`eval/run.mjs: not starting; ${problems.length} problem(s):\\n${problems.map((p) => `  - ${p}`).join(\"\\n\")}`);\n   147\t  process.exit(2);\n   148\t}\n   149\tconst frozenTaskRows = taskRecords.map(({ id }) => corpusTaskRows(taskSnapshots, [id])[0]);\n   150\tfs.writeFileSync(path.join(args.out, \"manifest.json\"), JSON.stringify({\n   151\t  createdAt: new Date().toISOString(),\n   152\t  harness: identity,\n   153\t  config: redactConfig(config),\n   154\t  configSha256,\n   155\t  qualificationCorpus: config.qualification === true ? { manifestSha256: config.corpusManifestSha256, tasks: frozenTaskRows } : null,\n   156\t  fingerprint,\n   157\t  agentVersion: agentIdentity.record,\n   158\t  budget: effectiveBudget({}, config),\n   159\t  runs,\n   160\t  tasks: frozenTaskRows,\n   161\t  host: os.hostname(),\n   162\t  node: process.version,\n   163\t}, null, 2) + \"\\n\");\n   164\t\n   165\t// Run-major order (every task once, then again): a pass cut short still has the same number of runs per task.\n   166\tfor (let run = 1; run <= runs; run++) {\n   167\t  for (const { id, dir, treeSha256, task: taskData } of taskRecords) {\n   168\t    if (pairs && !pairs.some(([t, r]) => t === id && Number(r) === run)) continue;\n   169\t    if (taskTreeDigest(dir) !== treeSha256) throw new Error(`frozen task ${id} changed after manifest creation`);\n   170\t    const task = { ...taskData, dir };\n   171\t    const record = await runOnce(task, run);\n   172\t    fs.appendFileSync(resultsFile, JSON.stringify(record) + \"\\n\");\n   173\t    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\n   174\t  }\n   175\t}\n   575\t    runtimePaths.push(path.join(ROOT, \"cli/dist\"));\n   576\t    const modules = path.join(ROOT, \"cli/node_modules\");\n   577\t    for (const entry of fs.readdirSync(modules, { withFileTypes: true })) {\n   578\t      if (entry.isDirectory() && entry.name !== \".bin\") runtimePaths.push(path.join(modules, entry.name));\n   579\t    }\n   580\t    const coreBinary = path.join(ROOT, \"core/target/release/harness-core\");\n   581\t    if (fs.existsSync(coreBinary)) runtimePaths.push(coreBinary);\n   582\t  }\n   583\t  const sandboxRuntimePaths = [...new Set(runtimePaths)];\n   584\t  const allowedRuntimeRoots = [...new Set([...(config.sandboxRuntimeRoots ?? []), ...((config.agent ?? \"nexus\") === \"nexus\" && agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\") ? [path.join(ROOT, \"cli\"), path.join(ROOT, \"core\")] : [])])];\n   585\t  const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n   586\t  const corpusPaths = custodyCorpusPathsForRun();\n   587\t  const protectedCorpusPaths = protectedCorpusPathsForRun();\n   588\t  const corpusOverlap = runtimeCorpusOverlapProblem(sandboxRuntimePaths, allowedRuntimeRoots, tasksDir, corpusPaths, {\n   589\t    cwd: ws,\n   590\t    home,\n   591\t    proxyDirectory,\n   592\t    nodeRuntime: cmd,\n   593\t    supervisorPath,\n   594\t    qualification: config.qualification === true,\n   595\t  });\n   596\t  if (corpusOverlap) throw new Error(corpusOverlap);\n   597\t  const sandbox = agentSandboxArgv({ cwd: ws, home, proxyDirectory, readOnlyPaths: sandboxRuntimePaths, allowedRuntimeRoots, runtimeExecutablePaths: [cmd, ...agentIdentity.argsPrefix], supervisorPath, protectedCorpusPaths });\n   598\t  const wrapped = config.runAs ? asUserSpec(config.runAs, sandbox) : sandbox;\n   599\t  return new Promise((resolve) => {\n   600\t    const { child, containment } = spawnContained(wrapped, config.resources ?? null, { cwd: \"/\", env: {}, stdio: [\"pipe\", \"pipe\", \"pipe\"], detached: true });\n   601\t    // T3: the payload is the first line and the sidecar protocol follows on the same stdin (eval/agent_sandbox.mjs).\n   602\t    const preconditions = {};\n   603\t    const runConstraint = (command) => runIsolated(command, { cwd: ws, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => ({ pass: r.status === 0 && !r.timedOut && !r.overflow }));\n   604\t    const driver = protocol ? createT3Driver(task, (line) => { if (!child.stdin.destroyed) child.stdin.write(line); }, {\n   605\t      onSteer: (item) => { preconditions[item.id] = steeringPrecondition(item, ws, task.t3CommandBaseline); },\n   606\t      beforeProbe: () => t3Snapshot(task, ws, runConstraint),\n   607\t    }) : null;\n   608\t    child.stdin.on(\"error\", () => {});\n   609\t    if (driver) {\n   610\t      child.stdin.write(`${JSON.stringify({ command: cmd, argv, env, protocol: true })}\\n`);\n   611\t      driver.done.then(() => setTimeout(() => child.stdin.end(), 2000).unref());\n   612\t    } else child.stdin.end(JSON.stringify({ command: cmd, argv, env }));\n   613\t    let stdout = \"\";\n   614\t    let stderr = \"\";\n   615\t    let timedOut = false;\n   616\t    let outputExceeded = false;\n   617\t    let outputBytes = 0;\n   618\t    const collect = (target, chunk) => {\n   619\t      outputBytes += chunk.length;\n   620\t      // A T3 protocol session over 60+ steps is verbose; its cap is larger but still bounded.\n   621\t      if (outputBytes > (driver ? 50_000_000 : 2_000_000)) {\n   622\t        outputExceeded = true;\n   623\t        killGroup(\"SIGKILL\");\n   624\t        return;\n   625\t      }\n   245\t    return null;\n   246\t  }\n   247\t}\n   248\t\n   249\t/** Qualification requires an evaluator UID, working Bubblewrap namespaces, and explicit safe runtime mount roots. */\n   250\texport function hiddenTestIsolationProblem(config, tasksDir) {\n   251\t  if (config.qualification && Array.isArray(config.sandboxRuntimePaths) && Array.isArray(config.sandboxRuntimeRoots)) {\n   252\t    const corpusPaths = [\n   253\t      config.corpusCustody?.reportPath,\n   254\t      config.corpusCustody?.storeRoot,\n   255\t      config.corpusCustody?.validatorPath,\n   256\t      config.corpusCustody?.referencePath,\n   257\t      config.corpusCustody?.authorLogPath,\n   258\t    ].filter((item) => item !== undefined);\n   259\t    const corpusOverlap = runtimeCorpusOverlapProblem(config.sandboxRuntimePaths, config.sandboxRuntimeRoots, tasksDir, corpusPaths, { ...(config.mountContext ?? {}), qualification: Boolean(config.qualification) });\n   260\t    if (corpusOverlap) return corpusOverlap;\n   261\t  }\n   262\t  if (!config.runAs) return config.qualification ? \"qualification runs need runAs (the agent's own user) so hidden tests are unreadable to it\" : null;\n   263\t  if (!/^[a-z_][a-z0-9_-]{0,31}$/.test(config.runAs)) return `runAs '${config.runAs}' is not a valid user name`;\n   264\t  if (!sandboxAvailable()) return \"Bubblewrap is unavailable; qualification commands must fail closed\";\n   265\t  const account = fs.readFileSync(\"/etc/passwd\", \"utf8\").split(/\\r?\\n/).map((line) => line.sp