\", \"/var\", \"/dev\", \"/tmp\", \"/mnt\", \"/media\", \"/srv\"];\n    15\tconst SENSITIVE_HOME_PARTS = [\".ssh\", \".config\", \".aws\", \".azure\", \".gnupg\", \".kube\", \".nexus\", \".cache\"];\n    16\tlet sandboxPreflight;\n    17\tlet hostToolchains;\n    18\t\n    19\tfunction shellQuote(value) {\n    20\t  return `'${value.replaceAll(\"'\", `'\\\\''`)}'`;\n    21\t}\n    22\t\n    23\texport function selectToolchainRoot(configuredRoot, fallbackRoot) {\n    24\t  return configuredRoot ?? fallbackRoot ?? null;\n    25\t}\n    26\t\n    27\texport function candidateAgentPath(configuredPath, toolchains = resolveHostToolchains()) {\n    28\t  const configuredEntries = (configuredPath ?? \"/usr/bin:/bin\").split(path.delimiter).filter(Boolean);\n    29\t  const toolchainEntries = [\n    30\t    ...(toolchains.rustRoot ? [\"/opt/nexus-qual/rust/bin\"] : []),\n    31\t    ...(toolchains.goRoot ? [\"/usr/local/go/bin\"] : []),\n    32\t  ];\n    33\t  return [...new Set([...toolchainEntries, ...configuredEntries])].join(path.delimiter);\n    34\t}\n    35\t\n    36\texport function candidateToolchainMountArgs(toolchains, systemDirectories = []) {\n    37\t  const args = [];\n    38\t  if (toolchains.goRoot) {\n    39\t    if (!systemDirectories.includes(\"/usr/local/lib\")) args.push(\"--dir\", \"/usr/local\");\n    40\t    args.push(\"--ro-bind\", toolchains.goRoot, \"/usr/local/go\");\n    41\t  }\n    42\t  if (toolchains.rustRoot) {\n    43\t    args.push(\"--dir\", \"/opt\", \"--dir\", \"/opt/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/opt/nexus-qual/rust\");\n    44\t  }\n    45\t  return args;\n    46\t}\n    47\t\n    48\tfunction resolveHostToolchains() {\n    49\t  if (hostToolchains) return hostToolchains;\n    50\t  const availableDirectory = (candidate) => {\n    51\t    try { return fs.statSync(candidate).isDirectory() ? candidate : null; }\n    52\t    catch { return null; }\n    53\t  };\n    54\t  const fromCommand = (command, argv) => {\n    55\t    const result = spawnSync(command, argv, { encoding: \"utf8\", timeout: 5000 });\n    56\t    return result.status === 0 ? availableDirectory(result.stdout.trim()) : null;\n    57\t  };\n    58\t  hostToolchains = {\n    59\t    goRoot: selectToolchainRoot(fromCommand(\"go\", [\"env\", \"GOROOT\"]), availableDirectory(\"/usr/local/go\")),\n    60\t    rustRoot: availableDirectory(\"/opt/nexus-qual/rust\") ?? fromCommand(\"rustc\", [\"--print\", \"sysroot\"]),\n    61\t  };\n    62\t  return hostToolchains;\n    63\t}\n    64\t\n    65\t/** Return the host paths that the candidate sandbox mounts, grouped by the bind logic. */\n    66\texport function candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths = [], nodeRuntime, supervisorPath } = {}) {\n    67\t  if (!Array.isArray(readOnlyPaths)) throw new Error(\"candidate sandbox readOnlyPaths must be an array\");\n    68\t  const existing = (paths, kind) => paths.filter((source) => {\n    69\t    try {\n    70\t      const stat = fs.statSync(source);\n    71\t      return kind === \"directory\" ? stat.isDirectory() : stat.isFile();\n    72\t    } catch { return false; }\n    73\t  });\n    74\t  const optional = (source, resolve = true) => source === undefined ? null : resolve ? fs.realpathSync(source) : source;\n    75\t  return {\n    76\t    systemDirectories: existing(SYSTEM_BINARIES, \"directory\"),\n    77\t    systemFiles: existing(SYSTEM_ETC_FILES, \"file\"),\n    78\t    systemEtcDirectories: existing(SYSTEM_ETC_DIRS, \"directory\"),\n    79\t    toolchainDirectories: Object.values(resolveHostToolchains()).filter(Boolean),\n    80\t    runtimeSources: {\n    81\t      cwd: optional(cwd),\n    82\t      home: optional(home),\n    83\t      proxyDirectory: optional(proxyDirectory),\n    84\t      nodeRuntime: optional(nodeRuntime),\n    85\t      supervisorPath: optional(supervisorPath),\n    86\t      readOnlyPaths: readOnlyPaths.map((source) => fs.realpathSync(source)),\n    87\t    },\n    88\t  };\n    89\t}\n    90\t\n    91\tfunction pathOverlaps(left, right) {\n    92\t  return left === right || left.startsWith(`${right}${path.sep}`) || right.startsWith(`${left}${path.sep}`);\n    93\t}\n    94\t\n    95\tfunction pathVariants(source) {\n    96\t  if (typeof source !== \"string\" || !path.isAbsolute(source)) return [];\n    97\t  const lexical = path.resolve(source);\n    98\t  let current = lexical;\n    99\t  const suffix = [];\n   100\t  while (true) {\n   101\t    try {\n   102\t      const canonical = path.resolve(fs.realpathSync(current), ...suffix);\n   103\t      return [...new Set([lexical, canonical])];\n   104\t    } catch {\n   105\t      const parent = path.dirname(current);\n   106\t      if (parent === current) return [lexical];\n   107\t      suffix.unshift(path.basename(current));\n   108\t      current = parent;\n   109\t    }\n   110\t  }\n   111\t}\n   112\t\n   113\tfunction candidateMountOverlapProblem(mountSources, protectedCorpusPaths) {\n   114\t  return mountSourceOverlapProblem([\n   115\t    ...mountSources.systemDirectories,\n   116\t    ...mountSources.systemFiles,\n   117\t    ...mountSources.systemEtcDirectories,\n   118\t    ...mountSources.toolchainDirectories,\n   119\t    ...Object.values(mountSources.runtimeSources).flatMap((value) => Array.isArray(value) ? value : value === null ? [] : [value]),\n   120\t  ], protectedCorpusPaths);\n   121\t}\n   122\t\n   123\tfunction mountSourceOverlapProblem(sources, protectedCorpusPaths) {\n   124\t  if (!Array.isArray(protectedCorpusPaths)) return \"candidate sandbox protectedCorpusPaths must be an array\";\n   125\t  for (const protectedPath of protectedCorpusPaths) {\n   126\t    const protectedVariants = pathVariants(protectedPath);\n   127\t    if (!protectedVariants.length) return \"candidate sandbox protected corpus paths must be absolute\";\n   128\t    for (const source of sources) {\n   129\t      const sourceVariants = pathVariants(source);\n   130\t      if (sourceVariants.some((left) => protectedVariants.some((right) => pathOverlaps(left, right)))) {\n   131\t        return `candidate sandbox host mount overlaps protected corpus material: ${source}`;\n   132\t      }\n   133\t    }\n   134\t  }\n   135\t  return null;\n   136\t}\n   137\t\n   138\texport function sandboxAvailable() {\n   139\t  if (sandboxPreflight !== undefined) return sandboxPreflight;\n   140\t  try {\n   141\t    if (!fs.statSync(BWRAP).isFile() || (fs.statSync(BWRAP).mode & 0o111) === 0) return (sandboxPreflight = false);\n   142\t    const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--proc\", \"/proc\", \"--dev\", \"/dev\"];\n   143\t    for (const source of SYSTEM_BINARIES) {\n   144\t      try {\n   145\t        if (fs.statSync(source).isDirectory()) {\n   146\t          if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   147\t          args.push(\"--ro-bind\", source, source);\n   148\t        }\n   149\t      } catch {}\n   150\t    }\n   151\t    args.push(\"--clearenv\", \"--\", \"/usr/bin/unshare\", \"-Ur\", \"true\");\n   152\t    const result = spawnSync(BWRAP, args, { encoding: \"utf8\", timeout: 5000, env: {} });\n   153\t    // The sandbox itself must start, and nested user namespaces must be unavailable to the payload.\n   154\t    return (sandboxPreflight = result.status === 1 && !result.error);\n   155\t  } catch {\n   156\t    return (sandboxPreflight = false);\n   157\t  }\n   158\t}\n   159\t\n   160\texport function isolatedArgv({ cwd, home, command, timeoutSec = 300, readOnlySubpaths = [], hiddenSubpaths = [], protectedCorpusPaths = [] }) {\n   161\t  const workspace = fs.realpathSync(cwd);\n   162\t  const hiddenSources = hiddenSubpaths.map((relative) => confinedPath(workspace, relative));\n   163\t  const readOnlySources = readOnlySubpaths.map((relative) => confinedPath(workspace, relative));\n   164\t  const mountSources = candidateSandboxHostMountSources({ cwd: workspace, readOnlyPaths: [...readOnlySources, ...hiddenSources] });\n   165\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   166\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   167\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing to execute task-controlled commands\");\n   168\t  const hiddenGuestPaths = hiddenSources.map((source) => path.posix.join(\"/workspace\", path.relative(workspace, source).split(path.sep).join(\"/\")));\n   169\t  let executionCommand = command;\n   170\t  const args = [\n   171\t    \"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\",\n   172\t    \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\",\n   173\t  ];\n   174\t  let localPrefixCreated = false;\n   175\t  for (const source of SYSTEM_BINARIES) {\n   176\t    try {\n   177\t      if (fs.statSync(source).isDirectory()) {\n   178\t        if (source === \"/usr/local/lib\") {\n   179\t          args.push(\"--dir\", \"/usr/local\");\n   180\t          localPrefixCreated = true;\n   181\t        }\n   182\t        args.push(\"--ro-bind\", source, source);\n   183\t      }\n   184\t    } catch {}\n   185\t  }\n   186\t  const { goRoot, rustRoot } = resolveHostToolchains();\n   187\t  if (goRoot) {\n   188\t    if (!localPrefixCreated) args.push(\"--dir\", \"/usr/local\");\n   189\t    args.push(\"--ro-bind\", goRoot, \"/usr/local/go\");\n   190\t  }\n   245\t    const lexicalProblem = protectedRuntimeRootProblem(lexical);\n   246\t    if (lexicalProblem) return lexicalProblem;\n   247\t    try { roots.push(fs.realpathSync(lexical)); }\n   248\t    catch { return \"candidate runtime allowlist root is unavailable\"; }\n   249\t  }\n   250\t  let executableFiles;\n   251\t  try { executableFiles = allowedFiles.map((item) => fs.realpathSync(item)); }\n   252\t  catch { return \"candidate runtime executable is unavailable\"; }\n   253\t  for (const root of roots) {\n   254\t    const rootProblem = protectedRuntimeRootProblem(root);\n   255\t    if (rootProblem) return rootProblem;\n   256\t  }\n   257\t  for (const item of readOnlyPaths) {\n   258\t    if (typeof item !== \"string\" || !path.isAbsolute(item)) return \"candidate runtime paths must be absolute\";\n   259\t    let resolved;\n   260\t    try { resolved = fs.realpathSync(item); }\n   261\t    catch { return `candidate runtime path is unavailable: ${item}`; }\n   262\t    const stat = fs.statSync(resolved);\n   263\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   264\t    const explicitlySelectedTempExecutable = executableFiles.includes(resolved) && stat.isFile() && resolved.startsWith(`/tmp${path.sep}`);\n   265\t    if (FORBIDDEN_RUNTIME_ROOTS.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !explicitlySelectedTempExecutable) {\n   266\t      return `protected candidate runtime path is forbidden: ${resolved}`;\n   267\t    }\n   268\t    if (resolved === os.homedir() || (resolved.startsWith(`${os.homedir()}${path.sep}`) && resolved.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part)))) {\n   269\t      return `sensitive candidate runtime path is forbidden: ${resolved}`;\n   270\t    }\n   271\t    if (!stat.isFile() && !stat.isDirectory()) return `candidate runtime path is not a regular file or directory: ${resolved}`;\n   272\t    if (!roots.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !executableFiles.includes(resolved)) {\n   273\t      return `candidate runtime path is outside its explicit allowlist: ${resolved}`;\n   274\t    }\n   275\t    if (executableFiles.includes(resolved) && !stat.isFile()) return `candidate runtime executable is not a regular file: ${resolved}`;\n   276\t    if (stat.isDirectory()) assertNoSymlinks(resolved);\n   277\t  }\n   278\t  return null;\n   279\t}\n   280\t\n   281\tfunction protectedRuntimeRootProblem(root) {\n   282\t  if (root.startsWith(`${os.homedir()}${path.sep}`) && root.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part))) return `sensitive candidate runtime root is forbidden: ${root}`;\n   283\t  if (root === \"/\" || root === \"/home\" || root === os.homedir() || FORBIDDEN_RUNTIME_ROOTS.some((item) => root === item || root.startsWith(`${item}${path.sep}`))) return `protected candidate runtime root is forbidden: ${root}`;\n   284\t  return null;\n   285\t}\n   286\t\n   287\texport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n   288\t  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n   289\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   290\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   291\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n   292\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n   293\t  if (mountProblem) throw new Error(mountProblem);\n   294\t  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n   295\t    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n   296\t  }\n   297\t  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n   298\t  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n   299\t    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n   300\t  }\n   301\t  const workspace = mountSources.runtimeSources.cwd;\n   302\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   303\t  for (const source of mountSources.systemDirectories) {\n   304\t    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   305\t    args.push(\"--ro-bind\", source, source);\n   306\t  }\n   307\t  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\n   308\t  for (const source of mountSources.systemFiles) args.push(\"--ro-bind\", source, source);\n   309\t  for (const source of mountSources.systemEtcDirectories) args.push(\"--ro-bind\", source, source);\n   310\t  const isolatedHome = mountSources.runtimeSources.home;\n   311\t  args.push(\"--symlink\", \"usr/bin\", \"/bin\", \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--bind\", isolatedHome, \"/home/eval\", \"--tmpfs\", \"/run\");\n   312\t  args.push(\"--dir\", \"/run/eval-proxy\", \"--ro-bind\", mountSources.runtimeSources.proxyDirectory, \"/run/eval-proxy\");\n   313\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/run\", \"/run/eval-proxy\"]);\n   314\t  const addTargetParents = (target) => {\n   315\t    const parts = target.split(path.sep).filter(Boolean);\n   316\t    let current = \"\";\n   317\t    for (const part of parts.slice(0, -1)) {\n   318\t      current += `/${part}`;\n   319\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   320\t    }\n   321\t  };\n   322\t  for (const resolved of mountSources.runtimeSources.readOnlyPaths) {\n   323\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   324\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   325\t    addTargetParents(resolved);\n   326\t    args.push(\"--ro-bind\", resolved, resolved);\n   327\t  }\n   328\t  addTargetParents(\"/runner/agent_sandbox.mjs\");\n   329\t  args.push(\"--ro-bind\", nodeRuntime, \"/runner/node\");\n   330\t  args.push(\"--ro-bind\", mountSources.runtimeSources.supervisorPath, \"/runner/agent_sandbox.mjs\");\n   331\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"CI\", \"1\", \"--\");\n   332\t  args.push(\"/runner/node\", \"/runner/agent_sandbox.mjs\");\n   333\t  return { cmd: BWRAP, argv: args };\n   334\t}\n   335\t\n   336\t/** Run a fixed executable probe without exposing the host filesystem, environment, or network. */\n   337\texport function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [], allowedRoots = [], allowedFiles = [], timeoutMs = 5000, workspaceReadOnly = false, protectedCorpusPaths = [] }) {\n   338\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing executable probe\");\n   339\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles);\n   340\t  if (mountProblem) throw new Error(mountProblem);\n   341\t  const workspace = fs.realpathSync(cwd);\n   342\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   343\t  for (const source of SYSTEM_BINARIES) {\n   344\t    try {\n   345\t      if (fs.statSync(source).isDirectory()) {\n    90\t  }\n    91\t  const deadline = Date.now() + check.totalTimeoutMs;\n    92\t  const containment = { executions: 0, oomKills: 0, pidsMaxEvents: 0, survivorsAfterExit: 0 };\n    93\t  for (let index = 0; index < cases.length; index++) {\n    94\t    const remainingMs = deadline - Date.now();\n    95\t    if (remainingMs < 100) {\n    96\t      const unrun = Array.from({ length: cases.length - index }, (_, offset) => index + offset);\n    97\t      failures.push(...unrun);\n    98\t      timeoutCases.push(...unrun);\n    99\t      break;\n   100\t    }\n   101\t    const spec = isolatedProcessArgv({\n   102\t      cwd: workspace,\n   103\t      command,\n   104\t      argv: [`/workspace/${check.argv[0]}`],\n   105\t      readOnlyPaths: [command],\n   106\t      allowedFiles: [command],\n   107\t      workspaceReadOnly: true,\n   108\t      timeoutMs: Math.min(check.timeoutMs, remainingMs),\n   109\t    });\n   110\t    const result = await runIsolatedProcess(spec, {\n   111\t      outputLimit: check.maxOutputBytes,\n   112\t      input: `${JSON.stringify(cases[index].input)}\\n`,\n   113\t      resources,\n   114\t    });\n   115\t    if (result.containmentProblem) throw new Error(`black-box oracle containment failed: ${result.containmentProblem}`);\n   116\t    if (result.resources) {\n   117\t      containment.executions++;\n   118\t      containment.oomKills += result.resources.oomKills ?? 0;\n   119\t      containment.pidsMaxEvents += result.resources.pidsMaxEvents ?? 0;\n   120\t      containment.survivorsAfterExit += result.resources.survivorsAfterExit;\n   121\t    }\n   122\t    if (result.timedOut) timeoutCases.push(index);\n   123\t    if (result.overflow) outputLimitCases.push(index);\n   124\t    if (result.status !== 0 || result.error) executionFailureCases.push(index);\n   125\t    let actual;\n   390\t  assert.match(validateTask({ ...good, class: \"bugfix\", difficulty: \"medium\", hidden: { ...oracle, casesFile: \"../private-cases.json\" } }, dir, { qualification: true }).join(), /casesFile is unsafe/);\n   391\t  assert.match(validateTask({ ...qualifiedTask, hidden: { ...oracle, casesFile: \"private-cases-link.json\" } }, dir, { qualification: true }).join(), /casesFile is unsafe/);\n   392\t  fs.writeFileSync(path.join(dir, \"candidate\", \"private-cases.json\"), fs.readFileSync(cases));\n   393\t  assert.match(validateTask({ ...qualifiedTask, hidden: { ...oracle, casesFile: \"candidate/private-cases.json\" } }, dir, { qualification: true }).join(), /outside the candidate fixture/);\n   394\t  assert.match(validateTask({ ...qualifiedTask, hidden: { ...oracle, argv: [\"--eval\"] } }, dir, { qualification: true }).join(), /normalized relative candidate entrypoint/);\n   395\t});\n   396\t\n   397\ttest(\"T4 fixture evidence requires an exact CLI runner receipt and measured storage boundary\", async () => {\n   398\t  const { observeT4Fixture } = await import(path.join(ROOT, \"eval/t4_fixtures.mjs\"));\n   399\t  const task = { tier: \"T4\", t4Fixture: { kind: \"hanging_test_command\", tool: \"run_command\", command: \"npm test\", timeoutSecs: 30 } };\n   400\t  const commandSha256 = createHash(\"sha256\").update(\"npm test\").digest(\"hex\");\n   401\t  const agent = { json: { evaluationToolReceipts: [{ invocationId: \"call-1\", tool: \"run_command\", commandSha256, timeoutSecs: 30, exitCode: null, timedOut: true }] } };\n   402\t  const containment = { cleaned: true, survivorsAfterExit: 0 };\n   403\t  const hang = observeT4Fixture(task, agent, containment, { storageBytes: 64 * 1024 * 1024 });\n   404\t  assert.equal(hang[0].evidence.observedHung, true);\n   405\t  assert.equal(observeT4Fixture(task, { json: { messages: [{ role: \"tool\", content: \"timed out\" }] } }, containment, {}).length, 0, \"printable transcript text is not trusted evidence\");\n   406\t  assert.equal(observeT4Fixture(task, agent, { cleaned: false, survivorsAfterExit: 1 }, {}).at(0).evidence.containmentCleaned, false);\n   407\t\n   408\t  const diskTask = { tier: \"T4\", t4Fixture: { kind: \"full_disk\", tool: \"run_command\", command: \"./test-disk-cap.sh\", storageLimitBytes: 64 * 1024 * 1024 } };\n   409\t  const diskHash = createHash(\"sha256\").update(\"./test-disk-cap.sh\").digest(\"hex\");\n   410\t  const diskAgent = { json: { evaluationToolReceipts: [{ invocationId: \"call-2\", tool: \"run_command\", commandSha256: diskHash, timeoutSecs: 30, exitCode: 1, timedOut: false, workspaceAvailableBeforeBytes: 64 * 1024 * 1024, workspaceAvailableAfterBytes: 0 }] } };\n   411\t  assert.equal(observeT4Fixture(diskTask, diskAgent, containment, { storageBytes: 64 * 1024 * 1024 })[0].evidence.storageExhausted, true);\n   412\t  assert.equal(observeT4Fixture(diskTask, diskAgent, containment, { storageBytes: 128 * 1024 * 1024 }).length, 0);\n   413\t  assert.equal(observeT4Fixture(diskTask, { json: { evaluationToolReceipts: [{ ...diskAgent.json.evaluationToolReceipts[0], workspaceAvailableAfterBytes: 8 * 1024 * 1024 }] } }, containment, { storageBytes: 64 * 1024 * 1024 }).length, 0, \"a printed ENOSPC message without exhausted storage is insufficient\");\n   414\t});\n   415\t\n   416\ttest(\"black-box oracle keeps canary expectations outside the candidate process and returns sanitized evidence\", { timeout: 15_000 }, async () => {\n   417\t  const { runBlackBoxOracle } = await import(path.join(ROOT, \"eval/oracle.mjs\"));\n   418\t  const taskDir = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-private-task-\"));\n   419\t  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-candidate-\"));\n   420\t  const privateFile = path.join(taskDir, \"private-cases.json\");\n   421\t  const canary = \"ORACLE_EXPECTATION_CANARY_8f3c\";\n   422\t  const diagnosticCanary = \"SYNTHETIC_DIAGNOSTIC_CANARY_a219\";\n   423\t  fs.writeFileSync(privateFile, JSON.stringify([{ input: { value: \"public-input\" }, expected: { value: \"public-input\", oracle: null } }]));\n   424\t  const candidate = path.join(workspace, \"solution.mjs\");\n   425\t  fs.writeFileSync(candidate, `import fs from 'node:fs';\\nlet value;try{value=fs.readFileSync(${JSON.stringify(privateFile)},'utf8')}catch{};\\ntry{fs.writeFileSync('/workspace/solution.mjs','tampered')}catch{};\\nconst input=JSON.parse(fs.readFileSync(0,'utf8'));\\nconsole.error(${JSON.stringify(diagnosticCanary)});\\nconsole.log(JSON.stringify({value:input.value,oracle:value??null}));\\n`);\n   426\t  const candidateBefore = fs.readFileSync(candidate);\n   427\t  const check = { protocol: \"blackbox-v1\", casesFile: \"private-cases.json\", runtime: \"node\", argv: [\"solution.mjs\"], timeoutMs: 3000, totalTimeoutMs: 5000, maxOutputBytes: 4096 };\n   428\t  const result = await runBlackBoxOracle({ dir: taskDir }, workspace, check);\n   429\t  assert.deepEqual(result, {\n   430\t    pass: true,\n   431\t    cases: 1,\n   432\t    failedCases: [],\n   433\t    timeoutCases: [],\n   434\t    outputLimitCases: [],\n   435\t    executionFailureCases: [],\n   436\t    invalidOutputCases: [],\n   437\t    mismatchCases: [],\n   438\t    timedOut: false,\n   439\t    overflow: false,\n   440\t    outcome: \"matched\",\n   441\t    resources: null,\n   442\t  });\n   443\t  assert.deepEqual(fs.readFileSync(candidate), candidateBefore, \"candidate workspace is read-only during oracle execution\");\n   444\t  assert.equal(JSON.stringify(result).includes(canary), false, \"oracle evidence never serializes hidden expectations or candidate output\");\n   445\t  assert.equal(JSON.stringify(result).includes(diagnosticCanary), false, \"candidate diagnostics are not persisted in oracle evidence\");\n   446\t  assert.equal(fs.readFileSync(privateFile, \"utf8\").includes(canary), false);\n   447\t\n   448\t  fs.writeFileSync(privateFile, JSON.stringify([{ input: { value: \"public-input\" }, expected: { value: \"different\", oracle: canary } }]));\n   449\t  const failed = await runBlackBoxOracle({ dir: taskDir }, workspace, check);\n   450\t  assert.equal(failed.pass, false);\n   451\t  assert.deepEqual(failed.failedCases, [0]);\n   452\t  assert.deepEqual(failed.mismatchCases, [0]);\n   453\t  assert.equal(JSON.stringify(failed).includes(canary), false, \"failure summaries do not leak hidden values\");\n   454\t\n   455\t  fs.writeFileSync(candidate, \"console.log('x'.repeat(10000));\\n\");\n   456\t  const overflow = await runBlackBoxOracle({ dir: taskDir }, workspace, { ...check, maxOutputBytes: 64 });\n   457\t  assert.equal(overflow.pass, false);\n   458\t  assert.deepEqual(overflow.outputLimitCases, [0]);\n   459\t  assert.equal(overflow.overflow, true);\n   460\t  assert.equal(JSON.stringify(overflow).includes(\"xxxx\"), false, \"output-overflow evidence discards candidate output\");\n   461\t\n   462\t  fs.writeFileSync(candidate, \"while (true) {}\\n\");\n   463\t  const timed = await runBlackBoxOracle({ dir: taskDir }, workspace, { ...check, timeoutMs: 100, totalTimeoutMs: 500 });\n   464\t  assert.equal(timed.pass, false);\n   465\t  assert.deepEqual(timed.timeoutCases, [0]);\n   466\t  assert.equal(timed.timedOut, true);\n   467\t  assert.equal(JSON.stringify(timed).includes(canary), false);\n   468\t\n   469\t  const fixtureTask = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-fixture-task-\"));\n   470\t  const fixtureWorkspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-fixture-ws-\"));\n   471\t  fs.mkdirSync(path.join(fixtureTask, \"fixture\"));\n   472\t  fs.writeFileSync(path.join(fixtureTask, \"fixture\", \"private.json\"), JSON.stringify([{ input: {}, expected: canary }]));\n   473\t  await assert.rejects(\n   474\t    runBlackBoxOracle({ dir: fixtureTask, fixture: \"fixture\" }, fixtureWorkspace, { ...check, casesFile: \"fixture/private.json\" }),\n   475\t    /outside the candidate fixture/,\n   476\t  );\n   477\t});\n   478\t\n   479\ttest(\"a qualification run is refused without a model fingerprint (weights, server build, sampling)\", async () => {\n   480\t  const { modelFingerprint } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   481\t  const entry = { id: \"m\", owned_by: \"llamacpp\", meta: { n_ctx_train: 32768 } };\n   482\t  assert.equal(modelFingerprint({ model: \"m\" }, entry).missing.length, 0, \"a development run needs no fingerprint\");\n   483\t  const missing = modelFingerprint({ model: \"m\", qualification: true }, entry).missing;\n   484\t  assert.equal(missing.length, 3);\n   485\t  const ok = modelFingerprint({ model: \"m\", qualification: true, fingerprint: { weightsSha256: \"b\".repeat(64), serverBuild: \"llama.cpp b6000\" }, sampling: { temperature: 0, seed: 1 } }, entry);\n   486\t  assert.deepEqual(ok.missing, []);\n   487\t  assert.equal(ok.fingerprint.ownedBy, \"llamacpp\");\n   488\t  assert.equal(ok.fingerprint.contextLength, 32768);\n   489\t  assert.equal(modelFingerprint({ model: \"m\", qualification: true, fingerprint: ok.fingerprint, sampling: { temperature: 0 } }, null).missing[0], \"the endpoint does not list model m\");\n   490\t});\n","exit_code":0,"duration":{"secs":0,"nanos":914859112}},"started_at_ms":1793243533782,"completed_at_ms":1793243534698}}
