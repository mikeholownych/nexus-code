{"timestamp":"2026-10-29T05:09:31.839Z","ordinal":492239,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a1860e-1ee0-7860-ad63-fe5f780b91f5","item":{"type":"CommandExecution","id":"exec-91828731-0db1-456a-946c-2efb2cdd5707","process_id":"25823","command":["/usr/bin/zsh","-lc","nl -ba cli/test/eval_integrity.test.ts | sed -n '560,680p';"],"cwd":"file:///home/mike/nexus-wt/eval-agent-toolchain-binds","parsed_cmd":[{"type":"read","cmd":"nl -ba cli/test/eval_integrity.test.ts | sed -n '560,680p';","name":"eval_integrity.test.ts","path":"cli/test/eval_integrity.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"   560\t  assert.match(hiddenTestIsolationProblem({ qualification: true }, tasks), /need runAs/);\n   561\t  assert.match(hiddenTestIsolationProblem({ runAs: \"nexus-eval\" }, tasks), /evaluator account|setfacl|sandboxRuntimePaths/);\n   562\t  assert.match(hiddenTestIsolationProblem({ runAs: \"bad user;\" }, tasks), /not a valid user name/);\n   563\t  const wrapped = asUser(\"nexus-eval\", \"/usr/bin/bwrap\", [\"--unshare-all\", \"--\", \"/runner/node\"]);\n   564\t  // Exactly the form the provisioned sudoers rule permits: no env wrapper that would need an any-command rule.\n   565\t  assert.equal(wrapped.cmd, \"/usr/bin/sudo\");\n   566\t  assert.deepEqual(wrapped.argv, [\"-n\", \"-u\", \"nexus-eval\", \"--\", \"/usr/bin/bwrap\", \"--unshare-all\", \"--\", \"/runner/node\"]);\n   567\t  assert.throws(() => asUser(\"nexus-eval\", \"bwrap\", []), /absolute/);\n   568\t  const sudoers = fs.readFileSync(path.join(ROOT, \"eval/host/provision.sh\"), \"utf8\");\n   569\t  assert.match(sudoers, /ALL=\\(%s\\) !ALL\\\\n%s ALL=\\(%s\\) NOPASSWD: REDACTED, \"the explicit deny-all precedes the exact bwrap grant\");\n   570\t});\n   571\t\n   572\ttest(\"candidate agents receive only the approved read-only Go and Rust toolchain mounts\", async () => {\n   573\t  const { candidateAgentPath, candidateToolchainMountArgs } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   574\t  const toolchains = { goRoot: \"/host/toolchains/go\", rustRoot: \"/host/toolchains/rust\" };\n   575\t  assert.equal(\n   576\t    candidateAgentPath(\"/custom/bin:/usr/bin:/bin\", toolchains),\n   577\t    \"/opt/nexus-qual/rust/bin:/usr/local/go/bin:/custom/bin:/usr/bin:/bin\",\n   578\t  );\n   579\t  assert.deepEqual(candidateToolchainMountArgs(toolchains), [\n   580\t    \"--dir\", \"/usr/local\", \"--ro-bind\", toolchains.goRoot, \"/usr/local/go\",\n   581\t    \"--dir\", \"/opt\", \"--dir\", \"/opt/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/opt/nexus-qual/rust\",\n   582\t  ]);\n   583\t  assert.deepEqual(candidateToolchainMountArgs({ goRoot: null, rustRoot: null }), []);\n   584\t  assert.deepEqual(candidateToolchainMountArgs({ goRoot: toolchains.goRoot, rustRoot: null }, [\"/usr/local/lib\"]), [\n   585\t    \"--ro-bind\", toolchains.goRoot, \"/usr/local/go\",\n   586\t  ]);\n   587\t});\n   588\t\n   589\ttest(\"qualification runtime mounts cannot overlap the task tree, held-out store, or private validator paths\", async () => {\n   590\t  const { hiddenTestIsolationProblem, runtimeCorpusOverlapProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   591\t  const { agentSandboxArgv, candidateSandboxHostMountSources, isolatedArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   592\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-corpus-overlap-\"));\n   593\t  try {\n   594\t    const store = path.join(root, \"heldout-v2\");\n   595\t    const tasks = path.join(store, \"tasks\");\n   596\t    const references = path.join(store, \"reference\");\n   597\t    const runtimeRoot = path.join(root, \"runtime\");\n   598\t    const home = path.join(root, \"home\");\n   599\t    const proxyDirectory = path.join(root, \"proxy\");\n   600\t    const readOnlyRuntime = path.join(runtimeRoot, \"runtime.bin\");\n   601\t    const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n   602\t    const privateValidator = path.join(root, \"private-validator\");\n   603\t    fs.mkdirSync(tasks, { recursive: true });\n   604\t    fs.mkdirSync(references);\n   605\t    fs.mkdirSync(runtimeRoot);\n   606\t    fs.mkdirSync(home);\n   607\t    fs.mkdirSync(proxyDirectory);\n   608\t    fs.mkdirSync(privateValidator);\n   609\t    fs.writeFileSync(readOnlyRuntime, \"runtime\\n\");\n   610\t    fs.writeFileSync(path.join(tasks, \"task.json\"), \"{}\\n\");\n   611\t    fs.writeFileSync(path.join(references, \"solution.patch\"), \"REFERENCE_SOLUTION_CANARY\\n\");\n   612\t    fs.writeFileSync(path.join(privateValidator, \"validate.mjs\"), \"PRIVATE_VALIDATOR_CANARY\\n\");\n   613\t    const alias = path.join(root, \"store-alias\");\n   614\t    fs.symlinkSync(store, alias, \"dir\");\n   615\t\n   616\t    const mountContext = { cwd: runtimeRoot, home, proxyDirectory, nodeRuntime: process.execPath, supervisorPath };\n   617\t    const hostMounts = candidateSandboxHostMountSources({ ...mountContext, readOnlyPaths: [readOnlyRuntime] });\n   618\t    const expectedToolchains = [\"/usr/local/go\", \"/opt/nexus-qual/rust\"]\n   619\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   620\t    const existingDirectories = [\"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/lib\", \"/lib64\", \"/usr/local/lib\"]\n   621\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   622\t    const existingEtcFiles = [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]\n   623\t      .filter((item) => { try { return fs.statSync(item).isFile(); } catch { return false; } });\n   624\t    const existingEtcDirectories = [\"/etc/alternatives\"]\n   625\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   626\t    assert.deepEqual(hostMounts.systemDirectories, existingDirectories);\n   627\t    assert.deepEqual(hostMounts.systemFiles, existingEtcFiles);\n   628\t    assert.deepEqual(hostMounts.systemEtcDirectories, existingEtcDirectories);\n   629\t    assert.deepEqual(hostMounts.toolchainDirectories, expectedToolchains);\n   630\t    assert.deepEqual(hostMounts.runtimeSources, {\n   631\t      cwd: fs.realpathSync(runtimeRoot),\n   632\t      home: fs.realpathSync(home),\n   633\t      proxyDirectory,\n   634\t      nodeRuntime: fs.realpathSync(process.execPath),\n   635\t      supervisorPath: fs.realpathSync(supervisorPath),\n   636\t      readOnlyPaths: [fs.realpathSync(readOnlyRuntime)],\n   637\t    });\n   638\t\n   639\t    assert.equal(runtimeCorpusOverlapProblem([runtimeRoot], [runtimeRoot], tasks), null, \"an unrelated pinned runtime remains usable\");\n   640\t    assert.match(runtimeCorpusOverlapProblem([path.join(references, \"solution.patch\")], [store], tasks) ?? \"\", /overlaps protected corpus material/);\n   641\t    assert.match(runtimeCorpusOverlapProblem([runtimeRoot], [store], tasks) ?? \"\", /overlaps protected corpus material/, \"a broad allowlist root cannot contain the corpus store\");\n   642\t    assert.match(runtimeCorpusOverlapProblem([path.join(alias, \"reference\", \"solution.patch\")], [alias], tasks) ?? \"\", /overlaps protected corpus material/, \"symlink aliases are resolved before comparing paths\");\n   643\t    assert.match(runtimeCorpusOverlapProblem([privateValidator], [privateValidator], tasks, [privateValidator]) ?? \"\", /overlaps protected corpus material/);\n   644\t    assert.match(runtimeCorpusOverlapProblem([runtimeRoot], [runtimeRoot], tasks, [path.join(root, \"missing-validator\")]) ?? \"\", /private corpus path is unavailable/);\n   645\t    assert.equal(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\")), null, \"default in-repo development eval/tasks does not collide with eval/agent_sandbox.mjs\");\n   646\t    assert.equal(runtimeCorpusOverlapProblem([path.join(ROOT, \"cli/dist\")], [path.join(ROOT, \"cli\"), path.join(ROOT, \"core\")], path.join(ROOT, \"eval/tasks\")), null, \"default development Nexus runtime roots do not overlap eval/tasks\");\n   647\t    assert.match(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\"), [], { qualification: true }) ?? \"\", /overlaps protected corpus material/, \"qualification mode still rejects using in-repo eval/tasks because its parent overlaps eval/agent_sandbox.mjs\");\n   648\t\n   649\t    const unconditionalMountPaths = [\n   650\t      ...hostMounts.systemDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   651\t      ...hostMounts.systemFiles,\n   652\t      ...hostMounts.systemEtcDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   653\t      ...hostMounts.toolchainDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   654\t    ];\n   655\t    const runtimeMountPaths = [\n   656\t      path.join(runtimeRoot, \"corpus-leak\"),\n   657\t      path.join(home, \"corpus-leak\"),\n   658\t      path.join(proxyDirectory, \"corpus-leak\"),\n   659\t      process.execPath,\n   660\t      supervisorPath,\n   661\t      readOnlyRuntime,\n   662\t    ];\n   663\t    for (const protectedPath of [...unconditionalMountPaths, ...runtimeMountPaths]) {\n   664\t      assert.match(\n   665\t        runtimeCorpusOverlapProblem([], [], tasks, [protectedPath], mountContext) ?? \"\",\n   666\t        /overlaps protected corpus material/,\n   667\t        `runtime preflight rejects mounted corpus path ${protectedPath}`,\n   668\t      );\n   669\t      assert.match(\n   670\t        hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: protectedPath }, mountContext }, tasks) ?? \"\",\n   671\t        /overlaps protected corpus material/,\n   672\t        `hidden-test qualification preflight rejects mounted corpus path ${protectedPath}`,\n   673\t      );\n   674\t      assert.throws(() => agentSandboxArgv({\n   675\t        cwd: runtimeRoot,\n   676\t        home,\n   677\t        proxyDirectory,\n   678\t        readOnlyPaths: [readOnlyRuntime],\n   679\t        supervisorPath,\n   680\t        protectedCorpusPaths: [protectedPath],\n","exit_code":0,"duration":{"secs":0,"nanos":762059954}},"started_at_ms":1793250571076,"completed_at_ms":1793250571839}}
