completed\"},{\"completedAt\":\"2026-10-29T05:19:41Z\",\"conclusion\":\"success\",\"name\":\"Run node scripts/check_requirements.mjs\",\"number\":11,\"startedAt\":\"2026-10-29T05:19:41Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T05:19:42Z\",\"conclusion\":\"success\",\"name\":\"Run npm ci --prefix cli\",\"number\":12,\"startedAt\":\"2026-10-29T05:19:41Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T05:19:47Z\",\"conclusion\":\"success\",\"name\":\"Run npm --prefix cli run build\",\"number\":13,\"startedAt\":\"2026-10-29T05:19:42Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T05:19:47Z\",\"conclusion\":\"success\",\"name\":\"Run git diff --exit-code -- cli/dist\",\"number\":14,\"startedAt\":\"2026-10-29T05:19:47Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T05:20:43Z\",\"conclusion\":\"success\",\"name\":\"Run cargo test --locked --manifest-path core/Cargo.toml\",\"number\":15,\"startedAt\":\"2026-10-29T05:19:47Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T05:21:49Z\",\"conclusion\":\"success\",\"name\":\"Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\",\"number\":16,\"startedAt\":\"2026-10-29T05:20:43Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T05:21:51Z\",\"conclusion\":\"success\",\"name\":\"Install pinned security and SBOM test tools\",\"number\":17,\"startedAt\":\"2026-10-29T05:21:49Z\",\"status\":\"completed\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run npm --prefix cli test\",\"number\":18,\"startedAt\":\"2026-10-29T05:21:51Z\",\"status\":\"in_progress\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":34,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-go@40f1582b2485089dde7abd97