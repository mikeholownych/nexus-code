agent\": \"SageBridge\", \"base\": \"6b786d54dd5bf60234c67fec6ef070c62af9b141\", \"branch\": \"v1/ci-pinned-eval-toolchains\", \"diff_sha256\": \"b42067a589cd9bda7802cf1550a2a7741d99cb3e34b44827eee58b1d66d4c85f\", \"head\": \"d53caea7c480c5e88dff43c6e5d4cb8a16868400\", \"pid\": 917899, \"scope\": \".github/workflows/ci.yml only\", \"since\": \"2026-10-29T05:42:53Z\", \"status\": \"Implemented CI-only provisioning; static/shell/version/requirements checks PASS; independent review and owner push pending; exact PR318 Node22 failure reproduced (2026 tests, 2023 pass, 1 fail, 2 skipped; go status 127).\", \"updated_at\": \"2026-10-29T05:47:30Z\", \"worktree\": \"/home/mike/nexus-wt/ci-pinned-eval-toolchains\"}\nd53caea7 ci: provision pinned evaluator toolchains\n .github/workflows/ci.yml | 30 ++++++++++++++++++++++++++++++\n 1 file changed, 30 insertions(+)\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\nindex 86c12f97..51e28210 100644\n--- a/.github/workflows/ci.yml\n+++ b/.github/workflows/ci.yml\n@@ -22,6 +22,21 @@ jobs:\n       - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n         with:\n           go-version: '1.22.x'\n+      - name: Install pinned evaluator toolchains\n+        run: |\n+          go_root=\"$(go env GOROOT)\"\n+          rust_root=\"$(rustc --print sysroot)\"\n+          test -n \"$go_root\" && test -d \"$go_root\"\n+          test -n \"$rust_root\" && test -d \"$rust_root\"\n+          sudo rm -rf -- /usr/local/go /opt/nexus-qual/rust\n+          sudo install -d -o root -g root -m 0755 /usr/local /opt/nexus-qual\n+          sudo cp -a \"$go_root\" /usr/local/go\n+          sudo cp -a \"$rust_root\" /opt/nexus-qual/rust\n+          sudo chown -hR root:root /usr/local/go /opt/nexus-qual/rust\n+          sudo chmod -R go-w /usr/local/go /opt/nexus-qual/rust\n+          test \"$(/usr/local/go/bin/go version)\" = \"$(go version)\"\n+          test \"$(/opt/nexus-qual/rust/bin/rustc --version)\" = \"$(rustc --version)\"\n+          test \"$(/opt/nexus-qual/rust/bin/cargo --version)\" = \"$(cargo --version)\"\n       - run: bash scripts/ensure-ci-bubblewrap.sh\n       - run: bash scripts/ensure-ci-user-cgroups.sh\n       - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n@@ -87,6 +102,21 @@ jobs:\n       - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n         with:\n           go-version: '1.22.x'\n+      - name: Install pinned evaluator toolchains\n+        run: |\n+          go_root=\"$(go env GOROOT)\"\n+          rust_root=\"$(rustc --print sysroot)\"\n+          test -n \"$go_root\" && test -d \"$go_root\"\n+          test -n \"$rust_root\" && test -d \"$rust_root\"\n+          sudo rm -rf -- /usr/local/go /opt/nexus-qual/rust\n+          sudo install -d -o root -g root -m 0755 /usr/local /opt/nexus-qual\n+          sudo cp -a \"$go_root\" /usr/local/go\n+          sudo cp -a \"$rust_root\" /opt/nexus-qual/rust\n+          sudo chown -hR root:root /usr/local/go /opt/nexus-qual/rust\n+          sudo chmod -R go-w /usr/local/go /opt/nexus-qual/rust\n+          test \"$(/usr/local/go/bin/go version)\" = \"$(go version)\"\n+          test \"$(/opt/nexus-qual/rust/bin/rustc --version)\" = \"$(rustc --version)\"\n+          test \"$(/opt/nexus-qual/rust/bin/cargo --version)\" = \"$(cargo --version)\"\n       - run: bash scripts/ensure-ci-bubblewrap.sh\n       - run: bash scripts/ensure-ci-user-cgroups.sh\n       - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n","exit_code":0,"duration":{"secs":0,"nanos":46464}},"started_at_ms":1793253186826,"completed_at_ms":1793253186827}}
