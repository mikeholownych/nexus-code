DIR=\\\"$PWD/core/target\\\" cargo test --manifest-path core/Cargo.toml file_ops::tests::test_batch_read_line_collection_preserves_lossy_utf8 -- --exact --nocapture 2>&1 | tee \\\"$LOG\\\"\",\"workdir\":\"/home/mike/nexus-wt/batch-read-utf8\",\"yield_time_ms\":1000,\"max_output_tokens\":700});\ntext(JSON.stringify(r));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a1860e-1ee0-7860-ad63-fe5f780b91f5","create_time":1793251302.137884}}}
