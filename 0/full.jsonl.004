uest while this Nexus process is still alive so the\n   658\t      // injected interruption is demonstrably during an active turn.\n   659\t      if (proxyState.activeInferenceRequests < 1 || child.exitCode !== null) return;\n   660\t      try {\n   661\t        if (containment.signal(\"SIGTERM\", 5000)) signalEvidence = {\n   662\t          requestedAt: new Date().toISOString(),\n   663\t          answeredBeforeSignal: true,\n   664\t          activeInferenceRequests: proxyState.activeInferenceRequests,\n   665\t          signalDuringActiveTurn: true,\n   666\t        };\n   667\t      } catch {}\n   668\t    }, 25) : null;\n   669\t    const timer = setTimeout(() => {\n   670\t      timedOut = true;\n   671\t      killGroup(\"SIGTERM\");\n   672\t      setTimeout(() => killGroup(\"SIGKILL\"), 10_000).unref();\n   673\t    }, (budget.minutes + 5) * 60_000);\n   674\t    child.on(\"error\", (err) => (stderr += `spawn error: ${err.message}\\n`));\n   675\t    child.on(\"close\", async (code, exitSignal) => {\n   676\t      clearTimeout(timer);\n   677\t      if (signalPoll) clearInterval(signalPoll);\n   678\t      // A contained payload is already reaped by cgroup_supervisor before its final report. Do not race that\n   679\t      // report with a second force-kill; only the uncontained development path needs process-group cleanup here.\n   680\t      if (!containment) killGroup(\"SIGKILL\");\n   681\t      const final = containment ? await containment.final : undefined;\n   682\t      const json = driver ? { turn: driver.state.objectiveTurns.at(-1) ?? null } : lastJson(stdout);\n   683\t      const observedSignal = final?.signals?.find((entry) => entry.name === \"SIGTERM\");\n   684\t      const t4Signal = signalEvidence ? {\n   685\t        ...signalEvidence,\n   686\t        delivered: (observedSignal?.delivered ?? 0) > 0,\n   687\t        deliveredProcesses: observedSignal?.delivered ?? 0,\n   688\t        forced: observedSignal?.forced ?? null,\n   689\t       