ure or repo is required\");\n    28\t  if (task.fixture) {\n    29\t    try { confinedPath(dir, task.fixture); }\n    30\t    catch (error) { need(false, error.message); }\n    31\t  }\n    32\t  if (task.repo) {\n    33\t    need(typeof task.repo.url === \"string\" && task.repo.url.length > 0, \"repo.url is required\");\n    34\t    try {\n    35\t      const repoUrl = new URL(task.repo.url);\n    36\t      need(repoUrl.protocol === \"https:\" && !repoUrl.username && !repoUrl.password, \"repo.url must use HTTPS without embedded credentials\");\n    37\t    } catch { need(false, \"repo.url must be a valid HTTPS URL without embedded credentials\"); }\n    38\t    need(/^[0-9a-f]{40}$/.test(task.repo.commit ?? \"\"), \"repo.commit must be a full 40-character commit id (pinned)\");\n    39\t  }\n    40\t  const hiddenCommand = typeof task.hidden?.command === \"string\" && task.hidden.command.length > 0;\n    41\t  const hiddenOracle = task.hidden?.protocol === \"blackbox-v1\";\n    42\t  need(hiddenCommand || hiddenOracle, \"hidden.command or hidden blackbox-v1 oracle is required\");\n    43\t  if (hiddenOracle) {\n    44\t    const oracleProblem = blackBoxOracleProblem(task.hidden, dir, task.fixture ?? null);\n    45\t    need(!oracleProblem, oracleProblem ?? \"hidden black-box oracle is invalid\");\n    46\t  }\n    47\t  // Legacy validators execute candidate modules in the same runtime. File hiding and a fresh workspace cannot prevent\n    48\t  // candidate code from inspecting or mutating that runtime, so they are never valid independent qualification.\n    49\t  if (qualification) need(hiddenOracle && !hiddenCommand, \"qualification requires the isolated blackbox-v1 hidden oracle; in-process legacy validators are not accepted\");\n    50\t  if (task.hidden?.dir) {\n    51\t    try { confinedPath(dir, task.hidden.dir); }\n    52\t    catch (error) { need(false, error.message); }\n    53\t  }\n    54\t  if (task.regression?.dir) {\n    55\t    try { confinedPath(dir, task.regression.dir); }\n    56\t    catch (error) { need(false, error.message); }\n    57\t  }\n    58\t  for (const key of [\"steps\", \"minutes\"]) {\n    59\t    if (task[key] !== undefined) need(Number.isInteger(task[key]) && task[key] > 0, `${key} must be a positive integer`);\n    60\t  }\n    61\t  if (task.faults !== undefined) {\n    62\t    const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n    63\t    need(Array.isArray(task.faults) && task.faults.every((f) => kinds.includes(f?.kind) && Number.isInteger(f?.atRequest) && f.atRequest >= 1), `faults must be [{ kind: ${kinds.join(\"|\")}, atRequest: n >= 1 }]`);\n    64\t  }\n    65\t  if (task.t4RunnerFault !== undefined) {\n    66\t    need(task.tier === \"T4\" && task.t4RunnerFault === \"sigterm_resume\", \"t4RunnerFault is supported only as sigterm_resume on a T4 task\");\n    67\t  }\n    68\t  problems.push(...t4FixtureProblems(task));\n    69\t  if (task.class !== undefined || qualification) need(CLASSES.includes(task.class), `class must be one of ${CLASSES.join(\", \")}`);\n    70\t  if (task.difficulty !== undefined || qualification) need(DIFFICULTIES.includes(task.difficulty), `difficulty must be one of ${DIFFICULTIES.join(\", \")}`);\n    71\t  return problems;\n    72\t}\n    73\t\n    74\t/**\n    75\t * What a run's model is, beyond its alias: from the endpoint's /models entry (id, owner, advertised context) and the\n    76\t * operator's config (`fingerprint`: weights sha256, server build; `sampling`: temperature, seed). A qualification config\n    77\t * that cannot state weights, server build and sampling is refused (REQ-QUAL-102).\n    78\t */\n    79\texport function modelFingerprint(config, entry) {\n    80\t  const fp = config.fingerprint ?? {};\n    81\t  const sampling = config.sampling ?? null;\n    82\t  const fingerprint = {\n    83\t    alias: config.model,\n    84\t    listed: Boolean(entry),\n    85\t    ownedBy: entry?.owned_by ?? null,\n    86\t    contextLength: entry?.context_length ?? entry?.max_model_len ?? entry?.meta?.n_ctx_train ?? null,\n    87\t    weightsSha256: fp.weightsSha256 ?? null,\n    88\t    serverBuild: fp.serverBuild ?? null,\n    89\t    sampling,\n    90\t  };\n    91\t  const missing = [];\n    92\t  if (config.qualification) {\n    93\t    if (!fingerprint.listed) missing.push(`the endpoint does not list model ${config.model}`);\n    94\t    if (!/^[0-9a-f]{64}$/.test(fingerprint.weightsSha256 ?? \"\")) missing.push(\"fingerprint.weightsSha256 (sha256 of the served weights file)\");\n    95\t    if (!fingerprint.serverBuild) missing.push(\"fingerprint.serverBuild (inference server name and build)\");\n    96\t    if (!sampling || typeof sampling.temperature !== \"number\") missing.push(\"sampling.temperature (and sampling.seed where the server supports one)\");\n    97\t  }\n    98\t  return { fingerprint, missing };\n    99\t}\n   100\t\n   101\t/** Compare the requested Nexus output/context limits with the limits exposed by the serving endpoint. */\n   102\texport function nexusLimitsProblem(config, entry) {\n   103\t  const limits = config.limits;\n   104\t  const nativeDiscovery = Boolean(config.serverProfile) && limits?.context === undefined;\n   105\t  const contextOverride = Number.isInteger(limits?.context) && limits.context > 0;\n   106\t  if (!limits || (!contextOverride && !nativeDiscovery) || !Number.isInteger(limits.output) || limits.output <= 0) {\n   107\t    return \"qualification requires a positive limits.context override (or serverProfile native discovery) and positive limits.output\";\n   108\t  }\n   109\t  const args = Array.isArray(config.args) ? config.args : [];\n   110\t  if (args.some((arg) => typeof arg === \"string\" && (arg === \"--context-limit\" || arg.startsWith(\"--context-limit=\")))) {\n   111\t    return \"qualification must declare a Nexus context override through limits.context; --context-limit in args is ambiguous\";\n   112\t  }\n   113\t  const advertisedContext = positiveInt(entry?.context_length) ?? positiveInt(entry?.max_model_len) ?? positiveInt(entry?.meta?.n_ctx_train);\n   114\t  if (nativeDiscovery && !advertisedContext) {\n   115\t    return \"native context discovery requires a positive provider-advertised context limit\";\n   103\t// A run is valid only with well-formed tasks, hidden tests the agent cannot read, and (for qualification) a model\n   104\t// identified beyond its alias. Any problem stops the run before an agent starts (eval/validate.mjs).\n   105\tconst problems = taskRecords.flatMap(({ id, dir, task }) => {\n   106\t  return validateTask(task, dir, { qualification: config.qualification === true }).map((p) => `${id}: ${p}`);\n   107\t});\n   108\tconst isolation = hiddenTestIsolationProblem(config, tasksDir);\n   109\tif (isolation) problems.push(isolation);\n   110\t// Qualification proves the resource contract inside hiddenTestIsolationProblem; a development config may opt in.\n   111\tif (config.resources !== undefined && config.qualification !== true) {\n   112\t  const resourceProblem = resourceProbeProblem(config.resources);\n   113\t  if (resourceProblem) problems.push(resourceProblem);\n   114\t}\n   115\tif (config.resources !== undefined && args.keep) problems.push(\"--keep would accumulate run workspaces on the size-capped resources.workspaceRoot\");\n   116\tif (config.qualification === true) {\n   117\t  const corpusProblem = corpusManifestProblem(config, tasksDir, tasks, corpusTaskRows(taskSnapshots, tasks));\n   118\t  if (corpusProblem) problems.push(corpusProblem);\n   119\t}\n   120\tif (config.qualification === true && config.sampling?.temperature !== 0) {\n   121\t  problems.push(\"qualification adapters require sampling.temperature=0 so the matched Nexus, Goose and OpenCode runs use the same deterministic setting\");\n   122\t}\n   123\tif (config.qualification === true) {\n   124\t  const budgetProblem = qualificationBudgetProblem(config);\n   125\t  if (budgetProblem) problems.push(budgetProblem);\n   126\t}\n   127\tconst agentIdentity = problems.length ? { record: null, problem: null } : await resolveAgentIdentity(config);\n   128\tif (agentIdentity.problem) problems.push(agentIdentity.problem);\n   129\tlet fingerprint = null;\n   130\tif (!problems.length) {\n   131\t  const probe = config.proxy === false ? null : await startModelProxy({ upstream: config.endpoint, caFile });\n   132\t  try {\n   133\t    const entry = await fetchModelEntry(probe?.url ?? config.endpoint, config.model, apiKey);\n   134\t    const fp = modelFingerprint(config, entry);\n   135\t    fingerprint = fp.fingerprint;\n   136\t    problems.push(...fp.missing.map((m) => `model fingerprint: ${m}`));\n   137\t    if (config.qualification === true && (config.agent ?? \"nexus\") === \"nexus\") {\n   138\t      const limitsProblem = nexusLimitsProblem(config, entry);\n   139\t      if (limitsProblem) problems.push(limitsProblem);\n   140\t    }\n   141\t  } finally {\n   142\t    await probe?.close();\n   143\t  }\n   144\t}\n   145\tif (problems.length) {\n    48\t    args.push(\"--dir\", \"/opt\", \"--dir\", \"/opt/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/opt/nexus-qual/rust\");\n    49\t  }\n    50\t  return args;\n    51\t}\n    52\t\n    53\tfunction resolveHostToolchains() {\n    54\t  if (hostToolchains) return hostToolchains;\n    55\t  const availableDirectory = (candidate) => {\n    56\t    try { return fs.statSync(candidate).isDirectory() ? candidate : null; }\n    57\t    catch { return null; }\n    58\t  };\n    59\t  const fromCommand = (command, argv) => {\n    60\t    const result = spawnSync(command, argv, { encoding: \"utf8\", timeout: 5000 });\n    61\t    return result.status === 0 ? availableDirectory(result.stdout.trim()) : null;\n    62\t  };\n    63\t  hostToolchains = {\n    64\t    goRoot: selectToolchainRoot(fromCommand(\"go\", [\"env\", \"GOROOT\"]), availableDirectory(\"/usr/local/go\")),\n    65\t    rustRoot: availableDirectory(\"/opt/nexus-qual/rust\") ?? fromCommand(\"rustc\", [\"--print\", \"sysroot\"]),\n    66\t  };\n    67\t  return hostToolchains;\n    68\t}\n    69\t\n    70\t/** Python black-box oracles may invoke only these root-owned, pinned compiler runtimes. */\n    71\texport function oracleToolchainsProblem() {\n    72\t  const now = Date.now();\n    73\t  if (oracleToolchainPreflight && oracleToolchainPreflight.expiresAt > now) {\n    74\t    const current = oracleToolchainsFingerprint(oracleToolchainPreflight.paths);\n    75\t    if (current && JSON.stringify(current) === JSON.stringify(oracleToolchainPreflight.fingerprint)) return null;\n   145\t\n   146\t/** Return the host paths that the candidate sandbox mounts, grouped by the bind logic. */\n   147\texport function candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths = [], nodeRuntime, supervisorPath } = {}) {\n   148\t  if (!Array.isArray(readOnlyPaths)) throw new Error(\"candidate sandbox readOnlyPaths must be an array\");\n   149\t  const existing = (paths, kind) => paths.filter((source) => {\n   150\t    try {\n   151\t      const stat = fs.statSync(source);\n   152\t      return kind === \"directory\" ? stat.isDirectory() : stat.isFile();\n   153\t    } catch { return false; }\n   154\t  });\n   155\t  const optional = (source, resolve = true) => source === undefined ? null : resolve ? fs.realpathSync(source) : source;\n   156\t  return {\n   157\t    systemDirectories: existing(SYSTEM_BINARIES, \"directory\"),\n   158\t    systemFiles: existing(SYSTEM_ETC_FILES, \"file\"),\n   159\t    systemEtcDirectories: existing(SYSTEM_ETC_DIRS, \"directory\"),\n   160\t    toolchainDirectories: Object.values(resolveHostToolchains()).filter(Boolean),\n   161\t    runtimeSources: {\n   162\t      cwd: optional(cwd),\n   163\t      home: optional(home),\n   164\t      proxyDirectory: optional(proxyDirectory),\n   165\t      nodeRuntime: optional(nodeRuntime),\n   166\t      supervisorPath: optional(supervisorPath),\n   167\t      readOnlyPaths: readOnlyPaths.map((source) => fs.realpathSync(source)),\n   168\t    },\n   169\t  };\n   170\t}\n","exit_code":0,"duration":{"secs":0,"nanos":793981192}},"started_at_ms":1793244263385,"completed_at_ms":1793244264179}}
