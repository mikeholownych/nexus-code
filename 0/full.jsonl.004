lugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-simple-dark-mode\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-simple-dark-mode\",\"title\":\"Simple Dark Mode\",\"description\":\"Create a presentation using the Simple Dark Mode template and its retained reference file. Use when the user selects or names Simple Dark Mode. Create clean dark-mode presentations with bold typography, simple sections, charts, and imagery.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc188191ac80335d6d2609f2\",\"skill_name\":\"artifact-template-simple-dark-mode\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-simple-light-mode\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-simple-light-mode\",\"title\":\"Simple Light Mode\",\"description\":\"Create a presentation using the Simple Light Mode template and its retained reference file. Use when the user selects or names Simple Light Mode. Create clean light-mode presentations with spacious typography, simple sections, charts, and imagery.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc1c81918b1d571866753f69\",\"skill_name\":\"artifact-template-simple-light-mode\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-strategy-memorandum\",\"name\":\"plugin_connect