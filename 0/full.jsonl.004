), []);\n386:  assert.match(validateTask({ ...good, class: \"bugfix\", difficulty: \"medium\", hidden: { ...oracle, runtime: \"bash\" } }, dir, { qualification: true }).join(), /runtime is not allowlisted/);\n388:    assert.match(validateTask({ ...qualifiedTask, hidden: { ...oracle, runtime } }, dir, { qualification: true }).join(), /runtime is not allowlisted/);\n390:  assert.match(validateTask({ ...good, class: \"bugfix\", difficulty: \"medium\", hidden: { ...oracle, casesFile: \"../private-cases.json\" } }, dir, { qualification: true }).join(), /casesFile is unsafe/);\n391:  assert.match(validateTask({ ...qualifiedTask, hidden: { ...oracle, casesFile: \"private-cases-link.json\" } }, dir, { qualification: true }).join(), /casesFile is unsafe/);\n393:  assert.match(validateTask({ ...qualifiedTask, hidden: { ...oracle, casesFile: \"candidate/private-cases.json\" } }, dir, { qualification: true }).join(), /outside the candidate fixture/);\n394:  assert.match(validateTask({ ...qualifiedTask, hidden: { ...oracle, argv: [\"--eval\"] } }, dir, { qualification: true }).join(), /normalized relative candidate entrypoint/);\n507:    assert.equal(blackBoxOracleProblem(check, taskDir), problem, \"qualification preflight must fail closed when pinned toolchains are unavailable\");\n525:test(\"a qualification run is refused without a model fingerprint (weights, server build, sampling)\", async () => {\n529:  const missing = modelFingerprint({ model: \"m\", qualification: true }, entry).missing;\n531:  const ok = modelFingerprint({ model: \"m\", qualification: true, fingerprint: { weightsSha256: \"b\".repeat(64), serverBuild: \"llama.cpp b6000\" }, sampling: { temperature: 0, seed: 1 } }, entry);\n535:  assert.equal(modelFingerprint({ model: \"m\", qualification: true, fingerprint: ok.fingerprint, sampling: { temperature: 0 } }, null).missing[0], \"the endpoint does not list model m\");\n538:test(\"qualification requires frozen request and aggregate output budgets\", async () => {\n539:  const { qualificationBudgetProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n540:  assert.match(qualificationBudgetProblem({ qualification: true, limits: { context: 65536, output: 8192 } }), /limits.requests/);\n541:  assert.match(qualificationBudgetProblem({ limits: { output: 8192, requests: 5 } }), /limits.totalOutput/);\n542:  assert.match(qualificationBudgetProblem({ limits: { output: 8192, requests: 5, totalOutput: 4096 } }), /cannot be lower/);\n543:  assert.equal(qualificationBudgetProblem({ limits: { output: 8192, requests: 5, totalOutput: 32768 } }), null);\n551:  assert.match(hiddenTestIsolationProblem({ qualification: true }, tasks), /need runAs/);\n580:test(\"qualification runtime mounts cannot overlap the task tree, held-out store, or private validator paths\", async () => {\n635:    assert.deepEqual(hostMounts.toolchainDirectories, expectedToolchains);\n653:    assert.match(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\"), [], { qualification: true }) ?? \"\", /overlaps protected corpus material/, \"qualification mode still rejects using in-repo eval/tasks because its parent overlaps eval/agent_sandbox.mjs\");\n659:      ...hostMounts.toolchainDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n676:        hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: protectedPath }, mountContext }, tasks) ?? \"\",\n678:        `hidden-test qualification preflight rejects mounted corpus path ${protectedPath}`,\n704:      hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [readOnlyRuntime], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: readOnlyRuntime }, mountContext }, tasks) ?? \"\",\n710:      qualification: true,\n730:test(\"qualification remains fail-closed without enforced aggregate resource controls\", async () => {\n731:  const { qualificationResourceIsolationProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n737:  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: \"/dev/shm\", storageBytes: shared.blocks * shared.bsize } }) ?? \"\", /dedicated tmpfs|exact mount point/);\n738:  assert.match(qualificationResourceIsolationProblem(), /enforced CPU, memory, process-count, and workspace-storage limits/);\n739:  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: ROOT } }) ?? \"\", /tmpfs/);\n742:    assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: nested } }) ?? \"\", /exact mount point/);\n746:  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, memoryBytes: 1024 } }) ?? \"\", /memoryBytes/);\n747:  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, tasks: 0 } }) ?? \"\", /tasks/);\n748:  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, cpuPercent: 1.5 } }) ?? \"\", /cpuPercent/);\n749:  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, memoryBytes: 256 * 1024 * 1024 + 1 } }) ?? \"\", /multiple of 4096/);\n750:  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, storageBytes: ok.storageBytes - 4096 } }) ?? \"\", /tmpfs with size<=storageBytes|owner-accessible/);\n751:  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, storageBytes: undefined } }) ?? \"\", /storageBytes/);\n752:  const isolation = qualificationResourceIsolationProblem({ resources: ok });\n754:  else assert.match(isolation ?? \"\", /dedicated tmpfs|exact mount point/, \"a shared /dev/shm must fail qualification preflight\");\n761:      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \"\", /non-readable\\/non-writable by group or other/);\n765:    assert.equal(qualificationResourceIsolationProblem({ resources: ok }), null, \"restored dedicated mount root must pass preflight\");\n768:      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \"\", /non-readable\\/non-writable by group or other/);\n774:      assert.equal(qualificationResourceIsolationProblem({ resources: ok }), null, \"execute-only traversal for the isolated evaluator account is compatible with the private root\");\n   103\t// A run is valid only with well-formed tasks, hidden tests the agent cannot read, and (for qualification) a model\n   104\t// identified beyond its alias. Any problem stops the run before an agent starts (eval/validate.mjs).\n   105\tconst problems = taskRecords.flatMap(({ id, dir, task }) => {\n   106\t  return validateTask(task, dir, { qualification: config.qualification === true }).map((p) => `${id}: ${p}`);\n   107\t});\n   108\tconst isolation = hiddenTestIsolationProblem(config, tasksDir);\n   109\tif (isolation) problems.push(isolation);\n   110\t// Qualification proves the resource contract inside hiddenTestIsolationProblem; a development config may opt in.\n   111\tif (config.resources !== undefined && config.qualification !== true) {\n   112\t  const resourceProblem = resourceProbeProblem(config.resources);\n   113\t  if (resourceProblem) problems.push(resourceProblem);\n   114\t}\n   115\tif (config.resources !== undefined && args.keep) problems.push(\"--keep would accumulate run workspaces on the size-capped resources.workspaceRoot\");\n   116\tif (config.qualification === true) {\n   117\t  const corpusProblem = corpusManifestProblem(config, tasksDir, tasks, corpusTaskRows(taskSnapshots, tasks));\n   118\t  if (corpusProblem) problems.push(corpusProblem);\n   119\t}\n   120\tif (config.qualification === true && config.sampling?.temperature !== 0) {\n   121\t  problems.push(\"qualification adapters require sampling.temperature=0 so the matched Nexus, Goose and OpenCode runs use the same deterministic setting\");\n   122\t}\n   123\tif (config.qualification === true) {\n   124\t  const budgetProblem = qualificationBudgetProblem(config);\n   125\t  if (budgetProblem) problems.push(budgetProblem);\n   126\t}\n   127\tconst agentIdentity = problems.length ? { record: null, problem: null } : await resolveAgentIdentity(config);\n   128\tif (agentIdentity.problem) problems.push(agentIdentity.problem);\n   129\tlet fingerprint = null;\n   130\tif (!problems.length) {\n   131\t  const probe = config.proxy === false ? null : await startModelProxy({ upstream: config.endpoint, caFile });\n   132\t  try {\n   133\t    const entry = await fetchModelEntry(probe?.url ?? config.endpoint, config.model, apiKey);\n   134\t    const fp = modelFingerprint(config, entry);\n   135\t    fingerprint = fp.fingerprint;\n   136\t    problems.push(...fp.missing.map((m) => `model fingerprint: ${m}`));\n   137\t    if (config.qualification === true && (config.agent ?? \"nexus\") === \"nexus\") {\n   138\t      const limitsProblem = nexusLimitsProblem(config, entry);\n   139\t      if (limitsProblem) problems.push(limitsProblem);\n   140\t    }\n   141\t  } finally {\n   142\t    await probe?.close();\n   143\t  }\n   144\t}\n   145\tif (problems.length) {\n    70\t  if (task.difficulty !== undefined || qualification) need(DIFFICULTIES.includes(task.difficulty), `difficulty must be one of ${DIFFICULTIES.join(\", \")}`);\n    71\t  return problems;\n    72\t}\n    73\t\n    74\t/**\n    75\t * What a run's model is, beyond its alias: from the endpoint's /models entry (id, owner, advertised context) and the\n    76\t * operator's config (`fingerprint`: weights sha256, server build; `sampling`: temperature, seed). A qualification config\n    77\t * that cannot state weights, server build and sampling is refused (REQ-QUAL-102).\n    78\t */\n    79\texport function modelFingerprint(config, entry) {\n    80\t  const fp = config.fingerprint ?? {};\n    81\t  const sampling = config.sampling ?? null;\n    82\t  const fingerprint = {\n    83\t    alias: config.model,\n    84\t    listed: Boolean(entry),\n    85\t    ownedBy: entry?.owned_by ?? null,\n    86\t    contextLength: entry?.context_length ?? entry?.max_model_len ?? entry?.meta?.n_ctx_train ?? null,\n    87\t    weightsSha256: fp.weightsSha256 ?? null,\n    88\t    serverBuild: fp.serverBuild ?? null,\n    89\t    sampling,\n    90\t  };\n    91\t  const missing = [];\n    92\t  if (config.qualification) {\n    93\t    if (!fingerprint.listed) missing.push(`the endpoint does not list model ${config.model}`);\n    94\t    if (!/^[0-9a-f]{64}$/.test(fingerprint.weightsSha256 ?? \"\")) missing.push(\"fingerprint.weightsSha256 (sha256 of the served weights file)\");\n    95\t    if (!fingerprint.serverBuild) missing.push(\"fingerprint.serverBuild (inference server name and build)\");\n    96\t    if (!sampling || typeof sampling.temperature !== \"number\") missing.push(\"sampling.temperature (and sampling.seed where the server supports one)\");\n    97\t  }\n    98\t  return { fingerprint, missing };\n    99\t}\n   100\t\n   101\t/** Compare the requested Nexus output/context limits with the limits exposed by the serving endpoint. */\n   102\texport function nexusLimitsProblem(config, entry) {\n   103\t  const limits = config.limits;\n   104\t  const nativeDiscovery = Boolean(config.serverProfile) && limits?.context === undefined;\n   105\t  const contextOverride = Number.isInteger(limits?.context) && limits.context > 0;\n   106\t  if (!limits || (!contextOverride && !nativeDiscovery) || !Number.isInteger(limits.output) || limits.output <= 0) {\n   107\t    return \"qualification requires a positive limits.context override (or serverProfile native discovery) and positive limits.output\";\n   108\t  }\n   109\t  const args = Array.isArray(config.args) ? config.args : [];\n   110\t  if (args.some((arg) => typeof arg === \"string\" && (arg === \"--context-limit\" || arg.startsWith(\"--context-limit=\")))) {\n   111\t    return \"qualification must declare a Nexus context override through limits.context; --context-limit in args is ambiguous\";\n   112\t  }\n   113\t  const advertisedContext = positiveInt(entry?.context_length) ?? positiveInt(entry?.max_model_len) ?? positiveInt(entry?.meta?.n_ctx_train);\n   114\t  if (nativeDiscovery && !advertisedContext) {\n   115\t    return \"native context discovery requires a positive provider-advertised context limit\";\n   116\t  }\n   117\t  if (contextOverride && advertisedContext && limits.context > advertisedContext) {\n   118\t    return `configured context limit ${limits.context} exceeds the installed Nexus provider limit ${advertisedContext}`;\n   119\t  }\n   120\t  const requestedContext = nativeDiscovery ? advertisedContext : limits.context;\n   121\t  const context = advertisedContext ? Math.min(advertisedContext, requestedContext) : requestedContext;\n   122\t  const advertisedOutput = positiveInt(entry?.max_completion_tokens);\n   123\t  const actualOutput = Math.max(1, Math.min(advertisedOutput ?? Math.min(8192, Math.floor(context / 4)), Math.floor(context / 2)));\n   124\t  if (limits.output !== actualOutput) {\n   125\t    return `Nexus output allowance ${actualOutput} differs from matched peer limit ${limits.output}`;\n","exit_code":0,"duration":{"secs":0,"nanos":783925024}},"started_at_ms":1793244271150,"completed_at_ms":1793244271935}}
