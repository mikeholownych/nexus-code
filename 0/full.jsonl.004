 toolchains.goRoot, \"/usr/local/go\");\n    46\t  }\n    47\t  if (toolchains.rustRoot) {\n    48\t    args.push(\"--dir\", \"/opt\", \"--dir\", \"/opt/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/opt/nexus-qual/rust\");\n    49\t  }\n    50\t  return args;\n    51\t}\n    52\t\n    53\tfunction resolveHostToolchains() {\n    54\t  if (hostToolchains) return hostToolchains;\n    55\t  const availableDirectory = (candidate) => {\n    56\t    try { return fs.statSync(candidate).isDirectory() ? candidate : null; }\n    57\t    catch { return null; }\n    58\t  };\n    59\t  const fromCommand = (command, argv) => {\n    60\t    const result = spawnSync(command, argv, { encoding: \"utf8\", timeout: 5000 });\n    61\t    return result.status === 0 ? availableDirectory(result.stdout.trim()) : null;\n    62\t  };\n    63\t  hostToolchains = {\n    64\t    goRoot: selectToolchainRoot(fromCommand(\"go\", [\"env\", \"GOROOT\"]), availableDirectory(\"/usr/local/go\")),\n    65\t    rustRoot: availableDirectory(\"/opt/nexus-qual/rust\") ?? fromCommand(\"rustc\", [\"--print\", \"sysroot\"]),\n    66\t  };\n    67\t  return hostToolchains;\n    68\t}\n    69\t\n    70\t/** Python black-box oracles may invoke only these root-owned, pinned compiler runtimes. */\n    71\texport function oracleToolchainsProblem() {\n    72\t  const now = Date.now();\n    73\t  if (oracleToolchainPreflight && oracleToolchainPreflight.expiresAt > now) {\n    74\t    const current = oracleToolchainsFingerprint(oracleToolchainPreflight.paths);\n    75\t    if (current && JSON.stringify(current) === JSON.stringify(oracleToolchainPreflight.fingerprint)) return null;\n    76\t    oracleToolchainPreflight = null;\n    77\t  }\n    78\t  for (const { root, required } of PINNED_ORACLE_TOOLCHAINS) {\n    79\t    const ancestors = [];\n    80\t    let parent = path.dirname(root);\n    81\t    while (parent !== path.dirname(parent)) {\n    82\t      ancestors.push(parent);\n    83\t      parent = path.dirname(parent);\n    84\t    }\n    85\t    ancestors.push(\"/\");\n    86\t    try {\n    87\t      for (const directory of [...ancestors.reverse(), root]) {\n    88\t        const directoryStat = fs.lstatSync(directory);\n    89\t        if (!directoryStat.isDirectory() || directoryStat.isSymbolicLink() || directoryStat.uid !== 0 || (directoryStat.mode & 0o002) !== 0 || fs.realpathSync(directory) !== directory || isWritableByEvaluator(directory)) {\n    90\t          return \"pinned oracle toolchain path is unavailable or replaceable\";\n    91\t        }\n    92\t      }\n    93\t      const stat = fs.lstatSync(root);\n    94\t      if (!stat.isDirectory() || fs.realpathSync(root) !== root) {\n    95\t        return \"pinned oracle toolchain root is unavailable or not safely installed\";\n    96\t      }\n    97\t      const verifyTree = (directory) => {\n    98\t        for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n    99\t          const item = path.join(directory, entry.name);\n   100\t          const child = fs.lstatSync(item);\n   101\t          if (entry.isSymbolicLink() || child.uid !== 0 || (child.mode & 0o002) !== 0 || isWritableByEvaluator(item)) return false;\n   102\t          if (entry.isDirectory() && !verifyTree(item)) …1901 tokens truncated…v[0] !== \"string\" || check.argv[0].includes(\"\\0\") || Buffer.byteLength(check.argv[0]) > 1024) {\n    56\t    return \"hidden black-box oracle argv must name only one candidate entrypoint\";\n    57\t  }\n    58\t  const entrypoint = check.argv[0];\n    59\t  if (path.posix.isAbsolute(entrypoint) || entrypoint.startsWith(\"-\") || entrypoint.includes(\"\\\\\") || entrypoint.split(\"/\").some((part) => !part || part === \".\" || part === \"..\")) {\n    60\t    return \"hidden black-box oracle argv must be a normalized relative candidate entrypoint\";\n    61\t  }\n    62\t  if (!Number.isSafeInteger(check.timeoutMs) || check.timeoutMs < 100 || check.timeoutMs > MAX_TIMEOUT_MS) return \"hidden black-box oracle timeout is outside the allowed range\";\n    63\t  if (!Number.isSafeInteger(check.totalTimeoutMs) || check.totalTimeoutMs < check.timeoutMs || check.totalTimeoutMs > MAX_TOTAL_TIMEOUT_MS) return \"hidden black-box oracle total timeout is outside the allowed range\";\n    64\t  if (!Number.isSafeInteger(check.maxOutputBytes) || check.maxOutputBytes < 2 || check.maxOutputBytes > MAX_OUTPUT_BYTES) return \"hidden black-box oracle output limit is outside the allowed range\";\n    65\t  return null;\n    66\t}\n    67\t\n    68\t/** Run candidate code as a black box. Only bounded summaries leave this function; raw output is discarded. */\n    69\texport async function runBlackBoxOracle(task, workspace, check, { resources = null, protectedCorpusPaths = [] } = {}) {\n    70\t  const problem = blackBoxOracleProblem(check, task.dir, task.fixture ?? null);\n    71\t  if (problem) throw new Error(problem);\n    72\t  const casesPath = confinedPath(task.dir, check.casesFile);\n    73\t  const entrypoint = confinedPath(workspace, check.argv[0]);\n    74\t  if (!fs.statSync(entrypoint).isFile()) throw new Error(\"black-box candidate entrypoint is not a regular file\");\n    75\t  const cases = JSON.parse(fs.readFileSync(casesPath, \"utf8\"));\n    76\t  const command = RUNTIMES[check.runtime];\n    77\t  const failures = [];\n    78\t  const timeoutCases = [];\n    79\t  const outputLimitCases = [];\n    80\t  const executionFailureCases = [];\n    81\t  const invalidOutputCases = [];\n    82\t  const mismatchCases = [];\n    83\t  const fixturePath = task.fixture ? confinedPath(task.dir, task.fixture) : null;\n    84\t  const candidateWorkspace = fs.realpathSync(workspace);\n    85\t  const relativeCases = path.relative(candidateWorkspace, casesPath);\n    86\t  if (relativeCases === \"\" || (!relativeCases.startsWith(`..${path.sep}`) && relativeCases !== \"..\" && !path.isAbsolute(relativeCases))) {\n    87\t    throw new Error(\"black-box oracle cases unexpectedly overlap the candidate workspace\");\n    88\t  }\n    89\t  if (fixturePath) {\n    90\t    const relativeFixtureCases = path.relative(fixturePath, casesPath);\n    91\t    if (relativeFixtureCases === \"\" || (!relativeFixtureCases.startsWith(`..${path.sep}`) && relativeFixtureCases !== \"..\" && !path.isAbsolute(relativeFixtureCases))) {\n    92\t      throw new Error(\"black-box oracle cases unexpectedly overlap the copied candidate fixture\");\n    93\t    }\n    94\t  }\n    95\t  const deadline = Date.now() + check.totalTimeoutMs;\n    96\t  const containment = { executions: 0, oomKills: 0, pidsMaxEvents: 0, survivorsAfterExit: 0 };\n    97\t  for (let index = 0; index < cases.length; index++) {\n    98\t    const remainingMs = deadline - Date.now();\n    99\t    if (remainingMs < 100) {\n   100\t      const unrun = Array.from({ length: cases.length - index }, (_, offset) => index + offset);\n   101\t      failures.push(...unrun);\n   102\t      timeoutCases.push(...unrun);\n   103\t      break;\n   104\t    }\n   105\t    const spec = isolatedProcessArgv({\n   106\t      cwd: workspace,\n   107\t      command,\n   108\t      argv: [`/workspace/${check.argv[0]}`],\n   109\t      readOnlyPaths: [command],\n   110\t      allowedFiles: [command],\n   111\t      workspaceReadOnly: true,\n   112\t      timeoutMs: Math.min(check.timeoutMs, remainingMs),\n   113\t      protectedCorpusPaths,\n   114\t      oracleToolchains: check.runtime === \"python3\",\n   115\t    });\n   116\t    const result = await runIsolatedProcess(spec, {\n   117\t      outputLimit: check.maxOutputBytes,\n   118\t      input: `${JSON.stringify(cases[index].input)}\\n`,\n   119\t      resources,\n   120\t    });\n   121\t    if (result.containmentProblem) throw new Error(`black-box oracle containment failed: ${result.containmentProblem}`);\n   122\t    if (result.resources) {\n   123\t      containment.executions++;\n   124\t      containment.oomKills += result.resources.oom