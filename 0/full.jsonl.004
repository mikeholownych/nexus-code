{"timestamp":"2026-10-29T04:46:01.576Z","ordinal":491133,"type":"token_usage_record","payload":{"thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a185f8-4a86-7862-85bd-b5372d4b3aa9","session_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","root_turn_id":"01a185f8-4a86-7862-85bd-b5372d4b3aa9","response_id":"resp_0db389702a7164cc016ae2cf8427a4819f82865ad8343571c3","usage":{"input_tokens":125343,"cached_input_tokens":121472,"cache_write_input_tokens":0,"output_tokens":645,"reasoning_output_tokens":539,"total_tokens":125988},"turn_token_usage":{"input_tokens":1659724,"cached_input_tokens":1619200,"cache_write_input_tokens":0,"output_tokens":8829,"reasoning_output_tokens":6403,"total_tokens":1668553},"thread_token_usage":{"input_tokens":9172474537,"cached_input_tokens":9074722304,"cache_write_input_tokens":0,"output_tokens":26434420,"reasoning_output_tokens":15459397,"total_tokens":9198908957}}}
{"timestamp":"2026-10-29T04:46:04.113Z","ordinal":491134,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a185f8-4a86-7862-85bd-b5372d4b3aa9","item":{"type":"CommandExecution","id":"exec-a02d52a9-eb58-4cd5-9ac1-e20d8622fecc","process_id":"56810","command":["/usr/bin/zsh","-lc","sed -n '250,300p' eval/isolate.mjs; sed -n '379,412p' eval/isolate.mjs; sed -n '480,558p' cli/test/eval_integrity.test.ts"],"cwd":"file:///home/mike/nexus-wt/eval-agent-toolchain-binds","parsed_cmd":[{"type":"read","cmd":"sed -n '250,300p' eval/isolate.mjs","name":"isolate.mjs","path":"eval/isolate.mjs"},{"type":"read","cmd":"sed -n '379,412p' eval/isolate.mjs","name":"isolate.mjs","path":"eval/isolate.mjs"},{"type":"read","cmd":"sed -n '480,558p' cli/test/eval_integrity.test.ts","name":"eval_integrity.test.ts","path":"cli/test/eval_integrity.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"}\n\nexport function isolatedArgv({ cwd, home, command, timeoutSec = 300, readOnlySubpaths = [], hiddenSubpaths = [], protectedCorpusPaths = [] }) {\n  const workspace = fs.realpathSync(cwd);\n  const hiddenSources = hiddenSubpaths.map((relative) => confinedPath(workspace, relative));\n  const readOnlySources = readOnlySubpaths.map((relative) => confinedPath(workspace, relative));\n  const mountSources = candidateSandboxHostMountSources({ cwd: workspace, readOnlyPaths: [...readOnlySources, ...hiddenSources] });\n  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n  if (protectedOverlap) throw new Error(protectedOverlap);\n  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing to execute task-controlled commands\");\n  const hiddenGuestPaths = hiddenSources.map((source) => path.posix.join(\"/workspace\", path.relative(workspace, source).split(path.sep).join(\"/\")));\n  let executionCommand = command;\n  const args = [\n    \"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\",\n    \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\",\n  ];\n  let localPrefixCreated = false;\n  for (const source of SYSTEM_BINARIES) {\n    try {\n      if (fs.statSync(source).isDirectory()) {\n        if (source === \"/usr/local/lib\") {\n          args.push(\"--dir\", \"/usr/local\");\n          localPrefixCreated = true;\n        }\n        args.push(\"--ro-bind\", source, source);\n      }\n    } catch {}\n  }\n  const { goRoot, rustRoot } = resolveHostToolchains();\n  if (goRoot) {\n    if (!localPrefixCreated) args.push(\"--dir\", \"/usr/local\");\n    args.push(\"--ro-bind\", goRoot, \"/usr/local/go\");\n  }\n  if (rustRoot) {\n    args.push(\"--dir\", \"/opt\", \"--dir\", \"/opt/nexus-qual\", \"--ro-bind\", rustRoot, \"/opt/nexus-qual/rust\");\n  }\n  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n    try {\n      if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source);\n    } catch {}\n  }\n  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n  args.push(\"--bind\", workspace, \"/workspace\", \"--dir\", \"/home\", \"--dir\", \"/run\");\n  if (hiddenSubpaths.length) {\n    const helperDir = path.dirname(fileURLToPath(import.meta.url));\n    args.push(\"--dir\", \"/runner\", \"--ro-bind\", path.join(helperDir, \"hide_oracle.cjs\"), \"/runner/hide_oracle.cjs\");\n    args.push(\"--ro-bind\", path.join(helperDir, \"hide_oracle.py\"), \"/runner/sitecustomize.py\");\n    args.push(\"--ro-bind\", path.join(helperDir, \"unlink_then_exec.sh\"), \"/runner/unlink_then_exec.sh\");\n  }\n  // Workspace subpaths the command may read but not change (hardened hidden tests: the oracle's own files).\n  for (const relative of hiddenSubpaths.length ? [] : readOnlySubpaths) {\nexport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n  if (protectedOverlap) throw new Error(protectedOverlap);\n  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n  if (mountProblem) throw new Error(mountProblem);\n  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n  }\n  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n  }\n  const workspace = mountSources.runtimeSources.cwd;\n  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n  for (const source of mountSources.systemDirectories) {\n    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n    args.push(\"--ro-bind\", source, source);\n  }\n  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\n  for (const source of mountSources.systemFiles) args.push(\"--ro-bind\", source, source);\n  for (const source of mountSources.systemEtcDirectories) args.push(\"--ro-bind\", source, source);\n  const isolatedHome = mountSources.runtimeSources.home;\n  args.push(\"--symlink\", \"usr/bin\", \"/bin\", \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--bind\", isolatedHome, \"/home/eval\", \"--tmpfs\", \"/run\");\n  args.push(\"--dir\", \"/run/eval-proxy\", \"--ro-bind\", mountSources.runtimeSources.proxyDirectory, \"/run/eval-proxy\");\n  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/run\", \"/run/eval-proxy\"]);\n  const addTargetParents = (target) => {\n    const parts = target.split(path.sep).filter(Boolean);\n    let current = \"\";\n    for (const part of parts.slice(0, -1)) {\n      current += `/${part}`;\n      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n    }\n  const { blackBoxOracleProblem, runBlackBoxOracle } = await import(path.join(ROOT, \"eval/oracle.mjs\"));\n  const { candidateToolchainRootProblem, oracleToolchainPathProblem, oracleToolchainsProblem } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  assert.equal(oracleToolchainPathProblem({ uid: 0, mode: 0o040755 }), null, \"root-owned read-only directories are eligible\");\n  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040775 }), /without group or other write permission/, \"group-writable toolchain paths must fail closed\");\n  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040757 }), /without group or other write permission/, \"other-writable toolchain paths must fail closed\");\n  assert.match(oracleToolchainPathProblem({ uid: 1234, mode: 0o040755 }), /root-owned/, \"non-root-owned paths are not pinned roots\");\n  const candidateRootStat = { uid: 0, mode: 0o040755, isDirectory: () => true, isSymbolicLink: () => false };\n  assert.equal(candidateToolchainRootProblem(candidateRootStat, \"/opt/nexus-qual/rust\", \"/opt/nexus-qual/rust\"), null);\n  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, isSymbolicLink: () => true }, \"/opt/nexus-qual/rust\", \"/opt/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject symlinked toolchain roots\");\n  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, mode: 0o040775 }, \"/opt/nexus-qual/rust\", \"/opt/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject group-writable toolchain roots\");\n  assert.match(candidateToolchainRootProblem(candidateRootStat, \"/tmp/toolchain\", \"/opt/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject roots resolving outside the pinned path\");\n  const taskDir = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-toolchain-task-\"));\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-toolchain-candidate-\"));\n  t.after(() => {\n    fs.rmSync(taskDir, { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n  });\n  fs.mkdirSync(path.join(workspace, \"src\"));\n  fs.writeFileSync(path.join(taskDir, \"private-cases.json\"), JSON.stringify([{ input: { value: \"fixture\" }, expected: { value: \"fixture\", go: \"go-ok\", rust: \"rust-ok\" } }]));\n  fs.writeFileSync(path.join(workspace, \"main.go\"), 'package main\\nimport \"fmt\"\\nfunc main(){fmt.Print(\"go-ok\")}\\n');\n  fs.writeFileSync(path.join(workspace, \"Cargo.toml\"), '[package]\\nname = \"nexus-oracle-canary\"\\nversion = \"0.1.0\"\\nedition = \"2021\"\\n');\n  fs.writeFileSync(path.join(workspace, \"Cargo.lock\"), '# This file is automatically @generated by Cargo.\\nversion = 4\\n\\n[[package]]\\nname = \"nexus-oracle-canary\"\\nversion = \"0.1.0\"\\n');\n  fs.writeFileSync(path.join(workspace, \"src/main.rs\"), 'fn main(){print!(\"rust-ok\")}\\n');\n  fs.writeFileSync(path.join(workspace, \"check.py\"), [\n    \"import json, subprocess, sys\",\n    \"subprocess.run(['go', 'build', '-o', '/tmp/nexus-oracle-go', '/workspace/main.go'], check=True, capture_output=True, text=True)\",\n    \"subprocess.run(['cargo', 'build', '--offline', '--manifest-path', '/workspace/Cargo.toml'], check=True, capture_output=True, text=True)\",\n    \"go = subprocess.run(['/tmp/nexus-oracle-go'], check=True, capture_output=True, text=True).stdout\",\n    \"rust = subprocess.run(['/tmp/cargo-target/debug/nexus-oracle-canary'], check=True, capture_output=True, text=True).stdout\",\n    \"value = json.loads(sys.stdin.readline())['value']\",\n    \"print(json.dumps({'value': value, 'go': go, 'rust': rust}))\",\n    \"\",\n  ].join(\"\\n\"));\n  const check = { protocol: \"blackbox-v1\", casesFile: \"private-cases.json\", runtime: \"python3\", argv: [\"check.py\"], timeoutMs: 30_000, totalTimeoutMs: 45_000, maxOutputBytes: 4096 };\n  const problem = oracleToolchainsProblem();\n  if (problem) {\n    assert.equal(blackBoxOracleProblem(check, taskDir), problem, \"qualification preflight must fail closed when pinned toolchains are unavailable\");\n    return;\n  }\n  assert.equal(blackBoxOracleProblem(check, taskDir), null);\n  const sourceFiles = [\"main.go\", \"Cargo.toml\", \"Cargo.lock\", \"src/main.rs\", \"check.py\"];\n  const sourceBefore = sourceFiles.map((file) => fs.readFileSync(path.join(workspace, file), \"utf8\"));\n  await assert.rejects(\n    runBlackBoxOracle({ dir: taskDir }, workspace, check, { protectedCorpusPaths: [\"/usr/local/go\"] }),\n    /overlaps protected corpus/,\n    \"the oracle refuses even a pinned runtime root if it overlaps protected corpus material\",\n  );\n  const result = await runBlackBoxOracle({ dir: taskDir }, workspace, check, { protectedCorpusPaths: [taskDir] });\n  assert.equal(result.pass, true, `pinned offline compiler fixture failed: ${JSON.stringify(result)}`);\n  assert.equal(JSON.stringify(result).includes(\"go-ok\"), false);\n  assert.equal(JSON.stringify(result).includes(\"rust-ok\"), false);\n  assert.deepEqual(sourceFiles.map((file) => fs.readFileSync(path.join(workspace, file), \"utf8\")), sourceBefore, \"the oracle build leaves the read-only candidate workspace unchanged\");\n});\n\ntest(\"a qualification run is refused without a model fingerprint (weights, server build, sampling)\", async () => {\n  const { modelFingerprint } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const entry = { id: \"m\", owned_by: \"llamacpp\", meta: { n_ctx_train: 32768 } };\n  assert.equal(modelFingerprint({ model: \"m\" }, entry).missing.length, 0, \"a development run needs no fingerprint\");\n  const missing = modelFingerprint({ model: \"m\", qualification: true }, entry).missing;\n  assert.equal(missing.length, 3);\n  const ok = modelFingerprint({ model: \"m\", qualification: true, fingerprint: { weightsSha256: \"b\".repeat(64), serverBuild: \"llama.cpp b6000\" }, sampling: { temperature: 0, seed: 1 } }, entry);\n  assert.deepEqual(ok.missing, []);\n  assert.equal(ok.fingerprint.ownedBy, \"llamacpp\");\n  assert.equal(ok.fingerprint.contextLength, 32768);\n  assert.equal(modelFingerprint({ model: \"m\", qualification: true, fingerprint: ok.fingerprint, sampling: { temperature: 0 } }, null).missing[0], \"the endpoint does not list model m\");\n});\n\ntest(\"qualification requires frozen request and aggregate output budgets\", async () => {\n  const { qualificationBudgetProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  assert.match(qualificationBudgetProblem({ qualification: true, limits: { context: 65536, output: 8192 } }), /limits.requests/);\n  assert.match(qualificationBudgetProblem({ limits: { output: 8192, requests: 5 } }), /limits.totalOutput/);\n  assert.match(qualificationBudgetProblem({ limits: { output: 8192, requests: 5, totalOutput: 4096 } }), /cannot be lower/);\n  assert.equal(qualificationBudgetProblem({ limits: { output: 8192, requests: 5, totalOutput: 32768 } }), null);\n});\n\ntest(\"hidden tests must be unreadable to the agent's own user\", async () => {\n  const { hiddenTestIsolationProblem, asUser } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const tasks = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-tasks-\"));\n  fs.chmodSync(tasks, 0o755);\n","exit_code":0,"duration":{"secs":0,"nanos":870696315}},"started_at_ms":1793249163235,"completed_at_ms":1793249164107}}
{"timestamp":"2026-10-29T04:46:05.481Z","ordinal":491135,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a185fa-c0a9-7af3-b040-70f68d5ce912","call_id":"call_260913f9a4ed46d2a90e95feff9c6f2d","output":[{"type":"input_text","text":"Script completed\nWall time 3.9 seconds\nOutput:\n"},{"type":"input_text","text":"}\n\nexport function isolatedArgv({ cwd, home, command, timeoutSec = 300, readOnlySubpaths = [], hiddenSubpaths = [], protectedCorpusPaths = [] }) {\n  const workspace = fs.realpathSync(cwd);\n  const hiddenSources = hiddenSubpaths.map((relative) => confinedPath(workspace, relative));\n  const readOnlySources = readOnlySubpaths.map((relative) => confinedPath(workspace, relative));\n  const mountSources = candidateSandboxHostMountSources({ cwd: workspace, readOnlyPaths: [...readOnlySources, ...hiddenSources] });\n  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n  if (protectedOverlap) throw new Error(protectedOverlap);\n  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing to execute task-controlled commands\");\n  const hiddenGuestPaths = hiddenSources.map((source) => path.posix.join(\"/workspace\", path.relative(workspace, source).split(path.sep).join(\"/\")));\n  let executionCommand = command;\n  const args = [\n    \"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\",\n    \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\",\n  ];\n  let localPrefixCreated = false;\n  for (const source of SYSTEM_BINARIES) {\n    try {\n      if (fs.statSync(source).isDirectory()) {\n        if (source === \"/usr/local/lib\") {\n          args.push(\"--dir\", \"/usr/local\");\n          localPrefixCreated = true;\n        }\n        args.push(\"--ro-bind\", source, source);\n      }\n    } catch {}\n  }\n  const { goRoot, rustRoot } = resolveHostToolchains();\n  if (goRoot) {\n    if (!localPrefixCreated) args.push(\"--dir\", \"/usr/local\");\n    args.push(\"--ro-bind\", goRoot, \"/usr/local/go\");\n  }\n  if (rustRoot) {\n    args.push(\"--dir\", \"/opt\", \"--dir\", \"/opt/nexus-qual\", \"--ro-bind\", rustRoot, \"/opt/nexus-qual/rust\");\n  }\n  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n    try {\n      if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source);\n    } catch {}\n  }\n  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n  args.push(\"--bind\", workspace, \"/workspace\", \"--dir\", \"/home\", \"--dir\", \"/run\");\n  if (hiddenSubpaths.length) {\n    const helperDir = path.dirname(fileURLToPath(import.meta.url));\n    args.push(\"--dir\", \"/runner\", \"--ro-bind\", path.join(helperDir, \"hide_oracle.cjs\"), \"/runner/hide_oracle.cjs\");\n    args.push(\"--ro-bind\", path.join(helperDir, \"hide_oracle.py\"), \"/runner/sitecustomize.py\");\n    args.push(\"--ro-bind\", path.join(helperDir, \"unlink_then_exec.sh\"), \"/runner/unlink_then_exec.sh\");\n  }\n  // Workspace subpaths the command may read but not change (hardened hidden tests: the oracle's own files).\n  for (const relative of hiddenSubpaths.length ? [] : readOnlySubpaths) {\nexport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n  if (protectedOverlap) throw new Error(protectedOverlap);\n  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n  if (mountProblem) throw new Error(mountProblem);\n  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n  }\n  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n  }\n  const workspace = mountSources.runtimeSources.cwd;\n  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n  for (const source of mountSources.systemDirectories) {\n    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n    args.push(\"--ro-bind\", source, source);\n  }\n  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\n  for (const source of mountSources.systemFiles) args.push(\"--ro-bind\", source, source);\n  for (const source of mountSources.systemEtcDirectories) args.push(\"--ro-bind\", source, source);\n  const isolatedHome = mountSources.runtimeSources.home;\n  args.push(\"--symlink\", \"usr/bin\", \"/bin\", \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--bind\", isolatedHome, \"/home/eval\", \"--tmpfs\", \"/run\");\n  args.push(\"--dir\", \"/run/eval-proxy\", \"--ro-bind\", mountSources.runtimeSources.proxyDirectory, \"/run/eval-proxy\");\n  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/run\", \"/run/eval-proxy\"]);\n  const addTargetParents = (target) => {\n    const parts = target.split(path.sep).filter(Boolean);\n    let current = \"\";\n    for (const part of parts.slice(0, -1)) {\n      current += `/${part}`;\n      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n    }\n  const { blackBoxOracleProblem, runBlackBoxOracle } = await import(path.join(ROOT, \"eval/oracle.mjs\"));\n  const { candidateToolchainRootProblem, oracleToolchainPathProblem, oracleToolchainsProblem } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  assert.equal(oracleToolchainPathProblem({ uid: 0, mode: 0o040755 }), null, \"root-owned read-only directories are eligible\");\n  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040775 }), /without group or other write permission/, \"group-writable toolchain paths must fail closed\");\n  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040757 }), /without group or other write permission/, \"other-writable toolchain paths must fail closed\");\n  assert.match(oracleToolchainPathProblem({ uid: 1234, mode: 0o040755 }), /root-owned/, \"non-root-owned paths are not pinned roots\");\n  const candidateRootStat = { uid: 0, mode: 0o040755, isDirectory: () => true, isSymbolicLink: () => false };\n  assert.equal(candidateToolchainRootProblem(candidateRootStat, \"/opt/nexus-qual/rust\", \"/opt/nexus-qual/rust\"), null);\n  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, isSymbolicLink: () => true }, \"/opt/nexus-qual/rust\", \"/opt/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject symlinked toolchain roots\");\n  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, mode: 0o040775 }, \"/opt/nexus-qual/rust\", \"/opt/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject group-writable toolchain roots\");\n  assert.match(candidateToolchainRootProblem(candidateRootStat, \"/tmp/toolchain\", \"/opt/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject roots resolving outside the pinned path\");\n  const taskDir = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-toolchain-task-\"));\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-toolchain-candidate-\"));\n  t.after(() => {\n    fs.rmSync(taskDir, { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n  });\n  fs.mkdirSync(path.join(workspace, \"src\"));\n  fs.writeFileSync(path.join(taskDir, \"private-cases.json\"), JSON.stringify([{ input: { value: \"fixture\" }, expected: { value: \"fixture\", go: \"go-ok\", rust: \"rust-ok\" } }]));\n  fs.writeFileSync(path.join(workspace, \"main.go\"), 'package main\\nimport \"fmt\"\\nfunc main(){fmt.Print(\"go-ok\")}\\n');\n  fs.writeFileSync(path.join(workspace, \"Cargo.toml\"), '[package]\\nname = \"nexus-oracle-canary\"\\nversion = \"0.1.0\"\\nedition = \"2021\"\\n');\n  fs.writeFileSync(path.join(workspace, \"Cargo.lock\"), '# This file is automatically @generated by Cargo.\\nversion = 4\\n\\n[[package]]\\nname = \"nexus-oracle-canary\"\\nversion = \"0.1.0\"\\n');\n  fs.writeFileSync(path.join(workspace, \"src/main.rs\"), 'fn main(){print!(\"rust-ok\")}\\n');\n  fs.writeFileSync(path.join(workspace, \"check.py\"), [\n    \"import json, subprocess, sys\",\n    \"subprocess.run(['go', 'build', '-o', '/tmp/nexus-oracle-go', '/workspace/main.go'], check=True, capture_output=True, text=True)\",\n    \"subprocess.run(['cargo', 'build', '--offline', '--manifest-path', '/workspace/Cargo.toml'], check=True, capture_output=True, text=True)\",\n    \"go = subprocess.run(['/tmp/nexus-oracle-go'], check=True, capture_output=True, text=True).stdout\",\n    \"rust = subprocess.run(['/tmp/cargo-target/debug/nexus-oracle-canary'], check=True, capture_output=True, text=True).stdout\",\n    \"value = json.loads(sys.stdin.readline())['value']\",\n    \"print(json.dumps({'value': value, 'go': go, 'rust': rust}))\",\n    \"\",\n  ].join(\"\\n\"));\n  const check = { protocol: \"blackbox-v1\", casesFile: \"private-cases.json\", runtime: \"python3\", argv: [\"check.py\"], timeoutMs: 30_000, totalTimeoutMs: 45_000, maxOutputBytes: 4096 };\n  const problem = oracleToolchainsProblem();\n  if (problem) {\n    assert.equal(blackBoxOracleProblem(check, taskDir), problem, \"qualification preflight must fail closed when pinned toolchains are unavailable\");\n    return;\n  }\n  assert.equal(blackBoxOracleProblem(check, taskDir), null);\n  const sourceFiles = [\"main.go\", \"Cargo.toml\", \"Cargo.lock\", \"src/main.rs\", \"check.py\"];\n  const sourceBefore = sourceFiles.map((file) => fs.readFileSync(path.join(workspace, file), \"utf8\"));\n  await assert.rejects(\n    runBlackBoxOracle({ dir: taskDir }, workspace, check, { protectedCorpusPaths: [\"/usr/local/go\"] }),\n    /overlaps protected corpus/,\n    \"the oracle refuses even a pinned runtime root if it overlaps protected corpus material\",\n  );\n  const result = await runBlackBoxOracle({ dir: taskDir }, workspace, check, { protectedCorpusPaths: [taskDir] });\n  assert.equal(result.pass, true, `pinned offline compiler fixture failed: ${JSON.stringify(result)}`);\n  assert.equal(JSON.stringify(result).includes(\"go-ok\"), false);\n  assert.equal(JSON.stringify(result).includes(\"rust-ok\"), false);\n  assert.deepEqual(sourceFiles.map((file) => fs.readFileSync(path.join(workspace, file), \"utf8\")), sourceBefore, \"the oracle build leaves the read-only candidate workspace unchanged\");\n});\n\ntest(\"a qualification run is refused without a model fingerprint (weights, server build, sampling)\", async () => {\n  const { modelFingerprint } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const entry = { id: \"m\", owned_by: \"llamacpp\", meta: { n_ctx_train: 32768 } };\n  assert.equal(modelFingerprint({ model: \"m\" }, entry).missing.length, 0, \"a development run needs no fingerprint\");\n  const missing = modelFingerprint({ model: \"m\", qualification: true }, entry).missing;\n  assert.equal(missing.length, 3);\n  const ok = modelFingerprint({ model: \"m\", qualification: true, fingerprint: { weightsSha256: \"b\".repeat(64), serverBuild: \"llama.cpp b6000\" }, sampling: { temperature: 0, seed: 1 } }, entry);\n  assert.deepEqual(ok.missing, []);\n  assert.equal(ok.fingerprint.ownedBy, \"llamacpp\");\n  assert.equal(ok.fingerprint.contextLength, 32768);\n  assert.equal(modelFingerprint({ model: \"m\", qualification: true, fingerprint: ok.fingerprint, sampling: { temperature: 0 } }, null).missing[0], \"the endpoint does not list model m\");\n});\n\ntest(\"qualification requires frozen request and aggregate output budgets\", async () => {\n  const { qualificationBudgetProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  assert.match(qualificationBudgetProblem({ qualification: true, limits: { context: 65536, output: 8192 } }), /limits.requests/);\n  assert.match(qualificationBudgetProblem({ limits: { output: 8192, requests: 5 } }), /limits.totalOutput/);\n  assert.match(qualificationBudgetProblem({ limits: { output: 8192, requests: 5, totalOutput: 4096 } }), /cannot be lower/);\n  assert.equal(qualificationBudgetProblem({ limits: { output: 8192, requests: 5, totalOutput: 32768 } }), null);\n});\n\ntest(\"hidden tests must be unreadable to the agent's own user\", async () => {\n  const { hiddenTestIsolationProblem, asUser } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const tasks = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-tasks-\"));\n  fs.chmodSync(tasks, 0o755);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a185f8-4a86-7862-85bd-b5372d4b3aa9","create_time":1793249165.4817767}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
