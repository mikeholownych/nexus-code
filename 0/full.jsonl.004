ut embedded credentials\");\n    37\t    } catch { need(false, \"repo.url must be a valid HTTPS URL without embedded credentials\"); }\n    38\t    need(/^[0-9a-f]{40}$/.test(task.repo.commit ?? \"\"), \"repo.commit must be a full 40-character commit id (pinned)\");\n    39\t  }\n    40\t  const hiddenCommand = typeof task.hidden?.command === \"string\" && task.hidden.command.length > 0;\n    41\t  const hiddenOracle = task.hidden?.protocol === \"blackbox-v1\";\n    42\t  need(hiddenCommand || hiddenOracle, \"hidden.command or hidden blackbox-v1 oracle is required\");\n    43\t  if (hiddenOracle) {\n    44\t    const oracleProblem = blackBoxOracleProblem(task.hidden, dir, task.fixture ?? null);\n    45\t    need(!oracleProblem, oracleProblem ?? \"hidden black-box oracle is invalid\");\n    46\t  }\n    47\t  // Legacy validators execute candidate modules in the same runtime. File hiding and a fresh workspace cannot prevent\n    48\t  // candidate code from inspecting or mutating that runtime, so they are never valid independent qualification.\n    49\t  if (qualification) need(hiddenOracle && !hiddenCommand, \"qualification requires the isolated blackbox-v1 hidden oracle; in-process legacy validators are not accepted\");\n    50\t  if (task.hidden?.dir) {\n    51\t    try { confinedPath(dir, task.hidden.dir); }\n    52\t    catch (error) { need(false, error.message); }\n    53\t  }\n    54\t  if (task.regression?.dir) {\n    55\t    try { confinedPath(dir, task.regression.dir); }\n    56\t    catch (error) { need(false, error.message); }\n    57\t  }\n    58\t  for (const key of [\"steps\", \"minutes\"]) {\n    59\t    if (task[key] !== undefined) need(Number.isInteger(task[key]) && task[key] > 0, `${key} must be a positive integer`);\n    6…1579 tokens truncated… ?? \"nexus\") === \"nexus\") {\n   138\t      const limitsProblem = nexusLimitsProblem(config, entry);\n   139\t      if (limitsProblem) problems.push(limitsProblem);\n   140\t    }\n   141\t  } finally {\