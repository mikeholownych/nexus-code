ew Set([...toolchainEntries, ...configuredEntries])].join(path.delimiter);\n    39\t}\n    40\t\n    41\texport function candidateToolchainMountArgs(toolchains, systemDirectories = []) {\n    42\t  const args = [];\n    43\t  if (toolchains.goRoot) {\n    44\t    if (!systemDirectories.includes(\"/usr/local/lib\")) args.push(\"--dir\", \"/usr/local\");\n    45\t    args.push(\"--ro-bind\", toolchains.goRoot, \"/usr/local/go\");\n    46\t  }\n    47\t  if (toolchains.rustRoot) {\n    48\t    args.push(\"--dir\", \"/opt\", \"--dir\", \"/opt/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/opt/nexus-qual/rust\");\n    49\t  }\n    50\t  return args;\n    51\t}\n    52\t\n    53\tfunction resolveHostToolchains() {\n    54\t  if (hostToolchains) return hostToolchains;\n    55\t  const availableDirectory = (candidate) => {\n    56\t    try { return fs.statSync(candidate).isDirectory() ? candidate : null; }\n    57\t    catch { return null; }\n    58\t  };\n    59\t  const fromCommand = (command, argv) => {\n    60\t    const result = spawnSync(command, argv, { encoding: \"utf8\", timeout: 5000 });\n    61\t    return result.status === 0 ? availableDirectory(result.stdout.trim()) : null;\n    62\t  };\n    63\t  hostToolchains = {\n    64\t    goRoot: selectToolchainRoot(fromCommand(\"go\", [\"env\", \"GOROOT\"]), availableDirectory(\"/usr/local/go\")),\n    65\t    rustRoot: availableDirectory(\"/opt/nexus-qual/rust\") ?? fromCommand(\"rustc\", [\"--print\", \"sysroot\"]),\n    66\t  };\n    67\t  return hostToolchains;\n    68\t}\n    69\t\n    70\t/** Python black-box oracles may invoke only these root-owned, pinned compiler runtimes. */\n    71\texport function oracleToolchainsProblem() {\n    72\t  const now = Date.now();\n    73\t  if (oracleToolchainPreflight && oracleToolchainPreflight.expiresAt > now) {\n    74\t    const current = oracleToolchainsFingerprint(oracleToolchainPreflight.paths);\n    75\t    if (current && JSON.stringify(current) === JSON.stringify(oracleToolchainPreflight.fingerprint)) return null;\n    76\t    oracleToolchainPreflight = null;\n    77\t  }\n    78\t  for (const { root, required } of PINNED_ORACLE_TOOLCHAINS) {\n    79\t    const ancestors = [];\n    80\t    let parent = path.dirname(root);\n    81\t    while (parent !== path.dirname(parent)) {\n    82\t      ancestors.push(parent);\n    83\t      parent = path.dirname(parent);\n    84\t    }\n    85\t    ancestors.push(\"/\");\n    86\t    try {\n    87\t      for (const directory of [...ancestors.reverse(), root]) {\n    88\t        const directoryStat = fs.lstatSync(directory);\n    89\t        if (!directoryStat.isDirectory() || directoryStat.isSymbolicLink() || directoryStat.uid !== 0 || (directoryStat.mode & 0o002) !== 0 || fs.realpathSync(directory) !== directory || isWritableByEvaluator(directory)) {\n    90\t          return \"pinned oracle toolchain path is unavailable or replaceable\";\n    91\t        }\n    92\t      }\n    93\t      const stat = fs.lstatSync(root);\n    94\t      if (!stat.isDirectory() || fs.realpathSync(root) !== root) {\n    95\t        return \"pinned oracle toolchain root is unavailable or not safely installed\";\n    96\t      }\n    97\t      const verifyTree = (directory) => {\n    98\t        for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n    99\t          const item = path.join(directory, entry.name);\n   100\t          const child = fs.lstatSync(item);\n   101\t          if (entry.isSymbolicLink() || child.uid !== 0 || (child.mode & 0o002) !== 0 || isWritableByEvaluator(item)) return false;\n   102\t          if (entry.isDirectory() && !verifyTree(item)) return false;\n   103\t        }\n   104\t        return true;\n   105\t      };\n   106\t      if (!verifyTree(root)) return \"pinned oracle toolchain contents are not safely installed\";\n   107\t      for (const relative of required) {\n   108\t        const executable = path.join(root, relative);\n   109\t        const executableStat = fs.lstatSync(executable);\n   110\t        if (!executableStat.isFile() || executableStat.isSymbolicLink() || executableStat.uid !== 0 || (executableStat.mode & 0o111) === 0 || isWritableByEvaluator(executable) || fs.realpathSync(executable) !== executable) {\n   111\t          return \"pinned oracle toolchain executable is unavailable or not safely installed\";\n   112\t        }\n   113\t      }\n   114\t    } catch {\n   115\t      return \"pinned oracle toolchains are unavailable; refusing Python black-box qualification\";\n   116\t    }\n   117\t  }\n   118\t  const paths = [\"/\", ...PINNED_ORACLE_TOOLCHAINS.flatMap(({ root, required }) => {\n   119\t    const ancestors = [];\n   120\t    let parent = path.dirname(root);\n   121\t    while (parent !== path.dirname(parent)) { ancestors.push(parent); parent = path.dirname(parent); }\n   122\t    return [...ancestors, root, ...required.map((relative) => path.join(root, relative))];\n   123\t  })];\n   124\t  const fingerprint = oracleToolchainsFingerprint(paths);\n   125\t  if (!fingerprint) return \"pinned oracle toolchain state could not be recorded\";\n   126\t  oracleToolchainPreflight = { expiresAt: Date.now() + 30_000, fingerprint, paths };\n   127\t  return null;\n   128\t}\n   129\t\n   130\tfunction isWritableByEvaluator(item) {\n   385\t  }\n   386\t  const workspace = mountSources.runtimeSources.cwd;\n   387\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   388\t  for (const source of mountSources.systemDirectories) {\n   389\t    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   390\t    args.push(\"--ro-bind\", source, source);\n   391\t  }\n   392\t  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\n   393\t  for (const source of mountSources.syst