r/package\" && sha256sum VERSION bin/nexus > MANIFEST.sha256)\n   177\tcat > \"$runner/bin/systemd-run\" <<'EOF'\n   178\t#!/usr/bin/env bash\n   179\tset -euo pipefail\n   180\twhile [[ $# -gt 0 && \"$1\" != -- ]]; do shift; done\n   181\t[[ $# -gt 0 ]] || exit 2\n   182\tshift\n   183\texec \"$@\"\n   184\tEOF\n   185\tcat > \"$runner/bin/systemctl\" <<'EOF'\n   186\t#!/usr/bin/env bash\n   187\tset -euo pipefail\n   188\tproperty=\"\"\n   189\tfor arg in \"$@\"; do [[ \"$arg\" == --property=* ]] && property=\"${arg#--property=}\"; done\n   190\tcase \"$property\" in\n   191\t  LoadState) echo not-found ;;\n   192\t  ActiveState|ControlGroup) echo \"\" ;;\n   193\t  *) exit 2 ;;\n   194\tesac\n   195\tEOF\n   196\tchmod +x \"$runner/bin/systemd-run\" \"$runner/bin/systemctl\"\n   197\tRUNNER=\"$HERE/run-cell.sh\" FIXTURE=\"$runner\" python3 - <<'PY'\n   198\timport fcntl, glob, json, os, pty, select, struct, termios, time, sys\n   199\tfixture = os.environ[\"FIXTURE\"]\n   200\tout = os.path.join(fixture, \"out\")\n   201\tenv = os.environ.copy()\n   202\tenv.update({\n   203\t    \"HOME\": os.path.join(fixture, \"home\"),\n   204\t    \"TMPDIR\": fixture,\n   205\t    \"PATH\": os.path.join(fixture, \"package\", \"bin\") + os.pathsep + os.path.join(fixture, \"bin\") + os.pathsep + env[\"PATH\"],\n   206\t    \"TERM\": \"xterm\", \"XTERM_VERSION\": \"XTerm fixture\", \"COLUMNS\": \"80\", \"LINES\": \"24\",\n   207\t})\n   208\tos.makedirs(env[\"HOME\"], exist_ok=True)\n   209\tpid, fd = pty.fork()\n   210\tif pid == 0:\n   211\t    os.execve(os.environ[\"RUNNER\"], [os.environ[\"RUNNER\"], \"--rc\", \"v1.0.0-rc.1\", \"--terminal\", \"xterm\", \"--size\", \"80x24\", \"--out\", out], env)\n   212\tfcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack(\"HHHH\", 24, 80, 0, 0))\n   213\tpayload = (\"\\n\\n\" + \"PASS\\n\\n\" * 7 + \"test-operator\\nn\\n\").encode()\n   214\tos.write(fd, payload)\n   215\tcaptured = bytearray()\n   216\tdeadline = time.monotonic() + 45\n   217\twhile time.monotonic() < deadline:\n   218\t    ready, _, _ = select.select([fd], [], [], 0.2)\n   219\t    if ready:\n   220\t        try: captured.extend(os.read(fd, 65536))\n   221\t        except OSError: break\n   222\t    done, status = os.waitpid(pid, os.WNOHANG)\n   223\t    if done:\n   224\t        while True:\n   225\t            ready, _, _ = select.select([fd], [], [], 0)\n   226\t            if not ready: break\n   227\t            try: captured.extend(os.read(fd, 65536))\n   228\t            except OSError: break\n   229\t        if status != 0:\n   230\t            print(captured.decode(errors=\"replace\")[-6000:], file=sys.stderr)\n   231\t            raise SystemExit(f\"run-cell fixture exited with wait status {status}\")\n   232\t        break\n   233\telse:\n   234\t    os.kill(pid, 9)\n   235\t    os.waitpid(pid, 0)\n   236\t    raise SystemExit(\"run-cell fixture timed out\")\n   237\ttext = captured.decode(errors=\"replace\")\n   238\tif \"Attach optional approval and post-exit screenshots?\" not in text:\n   239\t    raise SystemExit(\"run-cell did not expose the optional screenshot choice; output:\\n\" + text[-10000:])\n   240\tif \"approval-panel screenshot path:\" in text or \"post-exit screenshot path:\" in text:\n   241\t    raise SystemExit(\"run-cell still required screenshot paths\")\n   242\trecords = glob.glob(os.path.join(out, \"cell-xterm-80x24.attempt-*.json\"))\n   243\tif len(records) != 1:\n   244\t    raise SystemExit(f\"expected one completed synthetic record, found {len(records)}\")\n   245\trecord = json.load(open(records[0], encoding=\"utf-8\"))\n   246\tif set(record[\"files\"]) != {\"mockLog\", \"answers\", \"exits\"}:\n   247\t    raise SystemExit(f\"unexpected screenshot evidence entries: {sorted(record['files'])}\")\n   248\tPY\n   249\t\n   250\techo \"scope measurement fixtures passed\"\n","exit_code":0,"duration":{"secs":0,"nanos":808424762}},"started_at_ms":1793252512693,"completed_at_ms":1793252513502}}
