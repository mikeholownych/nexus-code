\"ignore\", \"pipe\", \"pipe\"] });\n   285\t}\n   286\t\n   287\texport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n   288\t  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n   289\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   290\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   291\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n   292\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n   293\t  if (mountProblem) throw new Error(mountProblem);\n   294\t  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n   295\t    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n   296\t  }\n   297\t  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n   298\t  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n   299\t    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n   300\t  }\n   301\t  const workspace = mountSources.runtimeSources.cwd;\n   302\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   303\t  for (const source of mountSources.systemDirectories) {\n   304\t    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   305\t    args.push(\"--ro-bind\", source, source);\n   306\t  }\n   307\t  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\n   308\t  for (const source of mountSources.systemFiles) args.push(\"--ro-bind\", source, source);\n   309\t  for (const source of mountSources.systemEtcDirectories) args.push(\"--ro-bind\", source, source);\n   310\t  const isolatedHome = mountSources.runtimeSources.home;\n   311\t  args.push(\"--symlink\", \"usr/bin\", \"/bin\", \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--bind\", isolatedHome, \"/home/eval\", \"--tmpfs\", \"/run\");\n   312\t  args.push(\"--dir\", \"/run/eval-proxy\", \"--ro-bind\", mountSources.runtimeSources.proxyDirectory, \"/run/eval-proxy\");\n   313\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/run\", \"/run/eval-proxy\"]);\n   314\t  const addTargetParents = (target) => {\n   315\t    const parts = target.split(path.sep).filter(Boolean);\n   316\t    let current = \"\";\n   317\t    for (const part of parts.slice(0, -1)) {\n   318\t      current += `/${part}`;\n   319\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   320\t    }\n   321\t  };\n   322\t  for (const resolved of mountSources.runtimeSources.readOnlyPaths) {\n   323\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   324\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   325\t    addTargetParents(resolved);\n   326\t    args.push(\"--ro-bind\", resolved, resolved);\n   327\t  }\n   328\t  addTargetParents(\"/runner/agent_sandbox.mjs\");\n   329\t  args.push(\"--ro-bind\", nodeRuntime, \"/runner/node\");\n   330\t  args.push(\"--ro-bind\", mountSources.runtimeSources.supervisorPath, \"/runner/agent_sandbox.mjs\");\n   331\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"CI\", \"1\", \"--\");\n   332\t  args.push(\"/runner/node\", \"/runner/agent_sandbox.mjs\");\n   333\t  return { cmd: BWRAP, argv: args };\n   334\t}\n   335\t\n   336\t/** Run a fixed executable probe without exposing the host filesystem, environment, or network. */\n   337\texport function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [], allowedRoots = [], allowedFiles = [], timeoutMs = 5000, workspaceReadOnly = false, protectedCorpusPaths = [] }) {\n   338\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing executable probe\");\n   339\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles);\n   340\t  if (mountProblem) throw new Error(mountProblem);\n   341\t  const workspace = fs.realpathSync(cwd);\n   342\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   343\t  for (const source of SYSTEM_BINARIES) {\n   344\t    try {\n   345\t      if (fs.statSync(source).isDirectory()) {\n   346\t        if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   347\t        args.push(\"--ro-bind\", source, source);\n   348\t      }\n   349\t    } catch {}\n   350\t  }\n   351\t  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n   352\t    try { if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source); } catch {}\n   353\t  }\n   354\t  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n   355\t  args.push(workspaceReadOnly ? \"--ro-bind\" : \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--tmpfs\", \"/run\", \"--symlink\", \"usr/bin\", \"/bin\");\n   356\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/home/eval\", \"/run\"]);\n   357\t  const addParents = (target) => {\n   358\t    let current = \"\";\n   359\t    for (const part of target.split(path.sep).filter(Boolean).slice(0, -1)) {\n   360\t      current += `/${part}`;\n   361\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   362\t    }\n   363\t  };\n   364\t  for (const item of readOnlyPaths) {\n   365\t    const resolved = fs.realpathSync(item);\n   366\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   367\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   368\t    addParents(resolved);\n   369\t    args.push(\"--ro-bind\", resolved, resolved);\n   370\t  }\n   371\t  const resolvedCommand = fs.realpathSync(command);\n   372\t  if (!SYSTEM_BINARIES.some((root) => resolvedCommand === root || resolvedCommand.startsWith(`${root}${path.sep}`)) && !readOnlyPaths.some((item) => fs.realpathSync(item) === resolvedCommand)) {\n   373\t    throw new Error(\"isolated executable must be included in the explicit read-only runtime paths\");\n   374\t  }\n   375\t  const bindSources = args.flatMap((arg, i) => (arg === \"--bind\" || arg === \"--ro-bind\") ? [args[i + 1]] : []);\n   430\t/** Grant the evaluator and harness operator access to disposable paths; never make them world-writable. */\n   431\texport function grantRunAsAccess(user, targets) {\n   432\t  if (!/^[a-z_][a-z0-9_-]{0,31}$/.test(user)) throw new Error(\"invalid evaluator account\");\n   433\t  const setfacl = \"/usr/bin/setfacl\";\n   434\t  const opUid = process.getuid();\n   435\t  if (!fs.existsSync(setfacl)) throw new Error(\"setfacl is unavailable; refusing unsafe workspace permission changes\");\n   436\t  for (const target of targets) {\n   437\t    const resolved = fs.realpathSync(target);\n   438\t    const { access, defaults } = runAsAclArgs(user, opUid, resolved, fs.statSync(resolved).isDirectory());\n   439\t    const result = spawnSync(setfacl, access, { encoding: \"utf8\", timeout: 5000, env: { PATH: \"/usr/bin:/bin\" } });\n   440\t    if (result.status !== 0) throw new Error(`could not grant scoped evaluator access to disposable path (${result.status ?? \"signal\"})`);\n   441\t    if (defaults) {\n   442\t      const defaultResult = spawnSync(setfacl, defaults, { encoding: \"utf8\", timeout: 5000, env: { PATH: \"/usr/bin:/bin\" } });\n   443\t      if (defaultResult.status !== 0) throw new Error(`could not set scoped evaluator default ACL (${defaultResult.status ?? \"signal\"})`);\n   444\t    }\n   445\t  }\n   446\t}\n   447\t\n   448\t/** Make evaluator-owned workspace files readable to the operator through the scoped ACL mask. */\n   449\texport async function normalizeRunAsPermissions(user, dir, wrapSpec) {\n   450\t  const spec = isolatedProcessArgv({ cwd: dir, command: \"/usr/bin/chmod\", argv: [\"-R\", \"u+rwX,g+rwX,o-rwx\", \"/workspace\"], timeoutMs: 60_000 });\n   451\t  const result = await runIsolatedProcess(wrapSpec(user, spec), { outputLimit: 1_000_000 });\n   452\t  if (result.timedOut || result.error) throw new Error(`could not normalise evaluator file permissions (${result.error ?? \"timeout\"})`);\n   453\t  return result;\n   454\t}\n   455\t\n   456\texport function stageHiddenFiles(source, ws, relativeTarget, { readOnlyHidden = false } = {}) {\n   457\t  assertNoSymlinks(source);\n   458\t  const relFiles = [];\n   459\t  const walk = (dir, prefix = \"\") => {\n   460\t    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n   461\t      const rel = prefix ? `${prefix}/${entry.name}` : entry.name;\n   462\t      if (entry.isDirectory()) walk(path.join(dir, entry.name), rel);\n   463\t      else if (entry.isFile()) relFiles.push(rel);\n   464\t    }\n   465\t  };\n   466\t  walk(source);\n   467\t  const readOnlySubpaths = [];\n   468\t  for (const relFile of relFiles) {\n   469\t    const relTargetFile = (!relativeTarget || relativeTarget === \".\") ? relFile : path.posix.join(relativeTarget, relFile);\n   470\t    const segments = relTargetFile.split(\"/\");\n   471\t    if (path.posix.isAbsolute(relTargetFile) || segments.some((segment) => !segment || segment === \"..\")) {\n   472\t      throw new Error(`invalid hidden test target path: ${relTargetFile}`);\n   473\t    }\n   474\t    let cur = fs.realpathSync(ws);\n   475\t    const dirParts = path.posix.dirname(relTargetFile).split(\"/\").filter((part) => part && part !== \".\");\n   476\t    for (const part of dirParts) {\n   477\t      cur = path.join(cur, part);\n   478\t      const st = fs.lstatSync(cur, { throwIfNoEntry: false });\n   479\t      if (st) {\n   480\t        if (st.isSymbolicLink() || !st.isDirectory()) throw new Error(`unsafe hidden test parent directory: ${relTargetFile}`);\n   481\t      } else {\n   482\t        fs.mkdirSync(cur);\n   483\t      }\n   484\t    }\n   485\t    const leafPath = path.join(cur, path.posix.basename(relTargetFile));\n   486\t    const leafStat = fs.lstatSync(leafPath, { throwIfNoEntry: false });\n   487\t    if (leafStat?.isSymbolicLink() && !readOnlyHidden) throw new Error(`unsafe hidden test destination: ${relTargetFile}`);\n   488\t    if (leafStat && readOnlyHidden) fs.rmSync(leafPath, { recursive: true, force: true });\n   489\t    const destFile = confinedPath(ws, relTargetFile, { allowMissingLeaf: true });\n   490\t    fs.mkdirSync(path.dirname(destFile), { recursive: true });\n   491\t    fs.cpSync(path.join(source, relFile), destFile, { verbatimSymlinks: true });\n   492\t    if (readOnlyHidden) readOnlySubpaths.push(relTargetFile);\n   493\t  }\n   494\t  return readOnlySubpaths;\n   495\t}\n   496\t\n   497\texport function hiddenOutputHasTests(output) {\n   498\t  if (typeof output !== \"string\" || !output.trim()) return false;\n   499\t  const hasGoOk = /^ok\\s+\\S+/m.test(output);\n   500\t  const hasPassedCount = /\\b[1-9]\\d*\\s+passed\\b/i.test(output);\n   501\t  const hasPyUnittestOk = /^Ran\\s+[1-9]\\d*\\s+tests?\\b[\\s\\S]*?\\bOK\\b/m.test(output);\n   502\t  const hasNodeTestPass = /(?:ℹ|✔|#)\\s*pass\\s+[1-9]\\d*|^ok\\s+[1-9]\\d*\\s+-/m.test(output);\n   503\t  const hasValidatorSummary = /\\b(?:all|hidden)\\b[^\\n]*\\b(?:passed|ok|identical)\\b/i.test(output);\n   504\t  return hasGoOk || hasPassedCount || hasPyUnittestOk || hasNodeTestPass || hasValidatorSummary;\n   505\t}\n   506\t\n   507\t/** Execute a task-controlled shell command in a no-network, clear-environment namespace. */\n   508\texport async function runIsolated(command, options = {}) {\n   509\t  const { cwd, hiddenSubpaths = [] } = options;\n   510\t  if (hiddenSubpaths.length && /\\b(?:go|cargo)\\s+test\\b/.test(command)) {\ndiff --git a/cli/test/eval_integrity.test.ts b/cli/test/eval_integrity.test.ts\nindex c3f6c15f..7601cb41 100644\n--- a/cli/test/eval_integrity.test.ts\n+++ b/cli/test/eval_integrity.test.ts\n@@ -514,6 +514,23 @@ test(\"hidden tests must be unreadable to the agent's own user\", async () => {\n   assert.match(sudoers, /ALL=\\(%s\\) !ALL\\\\n%s ALL=\\(%s\\) NOPASSWD: REDACTED, \"the explicit deny-all precedes the exact bwrap grant\");\n });\n \n+test(\"candidate agents receive only the approved read-only Go and Rust toolchain mounts\", async () => {\n+  const { candidateAgentPath, candidateToolchainMountArgs } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n+  const toolchains = { goRoot: \"/host/toolchains/go\", rustRoot: \"/host/toolchains/rust\" };\n+  assert.equal(\n+    candidateAgentPath(\"/custom/bin:/usr/bin:/bin\", toolchains),\n+    \"/opt/nexus-qual/rust/bin:/usr/local/go/bin:/custom/bin: