 180\t  if (hiddenSubpaths.length) {\n   181\t    const helperDir = path.dirname(fileURLToPath(import.meta.url));\n   182\t    args.push(\"--dir\", \"/runner\", \"--ro-bind\", path.join(helperDir, \"hide_oracle.cjs\"), \"/runner/hide_oracle.cjs\");\n   183\t    args.push(\"--ro-bind\", path.join(helperDir, \"hide_oracle.py\"), \"/runner/sitecustomize.py\");\n   184\t    args.push(\"--ro-bind\", path.join(helperDir, \"unlink_then_exec.sh\"), \"/runner/unlink_then_exec.sh\");\n   185\t  }\n   186\t  // Workspace subpaths the command may read but not change (hardened hidden tests: the oracle's own files).\n   187\t  for (const relative of hiddenSubpaths.length ? [] : readOnlySubpaths) {\n   188\t    const source = confinedPath(workspace, relative);\n   189\t    args.push(\"--ro-bind\", source, path.posix.join(\"/workspace\", path.relative(workspace, source).split(path.sep).join(\"/\")));\n   190\t  }\n   191\t  args.push(\"--symlink\", \"usr/bin\", \"/bin\");\n   192\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/opt/nexus-qual/rust/bin:/usr/local/go/bin:/usr/bin:/bin\");\n   193\t  args.push(\"--setenv\", \"HOME\", home ? \"/home/eval\" : \"/tmp\");\n   314\t/** Run a fixed executable probe without exposing the host filesystem, environment, or network. */\n   315\texport function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [], allowedRoots = [], allowedFiles = [], timeoutMs = 5000, workspaceReadOnly = false, protectedCorpusPaths = [] }) {\n   316\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing executable probe\");\n   317\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles);\n   318\t  if (mountProblem) throw new Error(mountProblem);\n   319\t  const workspace = fs.realpathSync(cwd);\n   320\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   321\t  for (const source of SYSTEM_BINARIES) {\n   322\t    try {\n   323\t      if (fs.statSync(source).isDirectory()) {\n   324\t        if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   325\t        args.push(\"--ro-bind\", source, source);\n   326\t      }\n   327\t    } catch {}\n   328\t  }\n   329\t  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n   330\t    try { if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source); } catch {}\n   331\t  }\n   332\t  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n   333\t  args.push(workspaceReadOnly ? \"--ro-bind\" : \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--tmpfs\", \"/run\", \"--symlink\", \"usr/bin\", \"/bin\");\n   334\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/home/eval\", \"/run\"]);\n   335\t  const addParents = (target) => {\n   336\t    let current = \"\";\n   337\t    for (const part of target.split(path.sep).filter(Boolean).slice(0, -1)) {\n   338\t      current += `/${part}`;\n   339\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   340\t    }\n   341\t  };\n   342\t  for (const item of readOnlyPaths) {\n   343\t    const resolved = fs.realpathSync(item);\n   344\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   345\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   346\t    addParents(resolved);\n   347\t    args.push(\"--ro-bind\", resolved, resolved);\n   348\t  }\n   349\t  const resolvedCommand = fs.realpathSync(command);\n   350\t  if (!SYSTEM_BINARIES.some((root) => resolvedCommand === root || resolvedCommand.startsWith(`${root}${path.sep}`)) && !readOnlyPaths.some((item) => fs.realpathSync(item) === resolvedCommand)) {\n   351\t    throw new Error(\"isolated executable must be included in the explicit read-only runtime paths\");\n   352\t  }\n   353\t  const bindSources = args.flatMap((arg, i) => (arg === \"--bind\" || arg === \"--ro-bind\") ? [args[i + 1]] : []);\n   354\t  const protectedOverlap = mountSourceOverlapProblem(bindSources, protectedCorpusPaths);\n   355\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   225\t  const unavailablePrivate = protectedPaths.find((item) => !item.exists);\n   226\t  if (unavailablePrivate) return `qualification private corpus path is unavailable: ${unavailablePrivate.source}`;\n   227\t  return null;\n   228\t}\n   229\t\n   230\tfunction positiveInt(value) {\n   231\t  return typeof value === \"number\" && Number.isFinite(value) && value > 0 ? Math.floor(value) : undefined;\n   232\t}\n   233\t\n   234\t/** Reads the endpoint's /models entry for the configured model (through the run's proxy, so CA handling is shared). */\n   235\texport async function fetchModelEntry(baseUrl, model, apiKey) {\n   236\t  try {\n   237\t    const res = await fetch(`${baseUrl.replace(/\\/$/, \"\")}/models`, {\n   238\t      headers: apiKey ? { authorization: `Bearer ${apiKey}` } : {},\n   239\t      signal: AbortSignal.timeout(10_000),\n   240\t    });\n   241\t    if (!res.ok) return null;\n   242\t    const data = await res.json();\n   243\t    return Array.isArray(data?.data) ? data.data.find((e) => e?.id === model) ?? null : null;\n   244\t  } catch {\n   245\t    return null;\n   246\t  }\n   247\t}\n   248\t\n   249\t/** Qualification requires an evaluator UID, working Bubblewrap namespaces, and explicit safe runtime mount roots. */\n   250\texport function hiddenTestIsolationProblem(config, tasksDir) {\n   251\t  if (config.qualification && Array.isArray(config.sandboxRuntimePaths) && Array.isArray(config.sandboxRuntimeRoots)) {\n   252\t    const corpusPaths = [\n   253\t      config.corpusCustody?.reportPath,\n   254\t      config.corpusCustody?.storeRoot,\n   255\t      config.corpusCustody?.validatorPath,\n   256\t      config.corpusCustody?.referencePath,\n   257\t      config.corpusCustody?.authorLogPath,\n   258\t    ].filter((item) => item !== undefined);\n   259\t    const corpusOverlap = runtimeCorpusOverlapProblem(config.sandboxRuntimePaths, config.sandboxRuntimeRoots, tasksDir, corpusPaths, { ...(config.mountContext ?? {}), qualification: Boolean(config.qualification) });\n   260\t    if (corpusOverlap) return corpusOverlap;\n   261\t  }\n   262\t  if (!config.runAs) return config.qualification ? \"qualification runs need runAs (the agent's own user) so hidden tests are unreadable to it\" : null;\n   263\t  if (!/^[a-z_][a-z0-9_-]{0,31}$/.test(config.runAs)) return `runAs '${config.runAs}' is not a valid user name`;\n   264\t  if (!sandboxAvailable()) return \"Bubblewrap is unavailable; qualification commands must fail closed\";\n   265\t  const account = fs.readFileSync(\"/etc/passwd\", \"utf8\").split(/\\r?\\n/).map((line) => line.split(\":\" )).find((parts) => parts[0] === config.runAs);\n   266\t  if (!account) return `qualification evaluator account '${config.runAs}' is unavailable`;\n   267\t  if (Number(account[2]) === process.getuid()) return \"qualification evaluator account must differ from the harness uid\";\n   268\t  if (!fs.existsSync(\"/usr/bin/setfacl\")) return \"setfacl is unavailable; refusing unsafe workspace permission changes\";\n   269\t  if (!Array.isArray(config.sandboxRuntimePaths) || config.sandboxRuntimePaths.some((item) => typeof item !== \"string\" || !path.isAbsolute(item))) {\n   270\t    return \"qualification requires explicit absolute sandboxRuntimePaths for the agent runtime\";\n","exit_code":0,"duration":{"secs":0,"nanos":35761}},"started_at_ms":1793243053494,"completed_at_ms":1793243053494}}
