approval_copy=\"\" exit_copy=\"\"\n+if [[ \"$rc\" =~ ^v1\\.0\\.0-rc\\.[0-9]+$ ]]; then\n+  read -r -p \"Attach optional approval and post-exit screenshots? (y/N): \" screenshot_choice\n+  screenshots_requested=\"${screenshot_choice,,}\"\n+else\n+  echo \"Screenshots are required for $rc; DEC-18 applies only to v1.0.0-rc.N.\"\n+  screenshots_requested=\"yes\"\n+fi\n+if [[ \"$screenshots_requested\" == y || \"$screenshots_requested\" == yes ]]; then\n+  while true; do\n+    read -r -p \"approval-panel screenshot path: \" shot_approval\n+    read -r -p \"post-exit screenshot path: \" shot_exit\n+    if [[ \"$shot_approval\" =~ \\.(png|jpe?g)$ && \"$shot_exit\" =~ \\.(png|jpe?g)$ && -f \"$shot_approval\" && -f \"$shot_exit\" ]] \\\n+       && ! cmp -s \"$shot_approval\" \"$shot_exit\" \\\n+       && (( $(stat -c %Y \"$shot_approval\") >= attempt_start && $(stat -c %Y \"$shot_exit\") >= attempt_start )); then break; fi\n+    echo \"both optional screenshots must be distinct .png/.jpg files taken during this attempt; try again\"\n+  done\n+  approval_copy=\"$stem.approval.${shot_approval##*.}\"\n+  exit_copy=\"$stem.post-exit.${shot_exit##*.}\"\n+  cp \"$shot_approval\" \"$approval_copy\"\n+  cp \"$shot_exit\" \"$exit_copy\"\n+fi\n \n # Values reach Python only through the environment, never through generated source.\n CELL=\"$cell\" ATTEMPT=\"$attempt\" TERMINAL_NAME=\"$terminal\" CELL_SIZE=\"$size\" RC=\"$rc\" NEXUS_VERSION_LINE=\"$version_line\" \\\n@@ -213,6 +223,11 @@ for line in open(f\"{stem}.mock.log\"):\n     if prompt == \"stream\" and entry[\"kind\"] == \"stream\": scenarios[\"stream\"] += 1\n     if prompt == \"sleep\" and entry[\"kind\"] == \"tools\": scenarios[\"sleepTool\"] += 1\n scenarios[\"approveToolRounds\"] = sorted(scenarios[\"approveToolRounds\"])\n+files = {name: {\"path\": os.path.basename(path), \"sha256\": sha(path)} for name, path in\n+         [(\"mockLog\", f\"{stem}.mock.log\"), (\"answers\", f\"{stem}.answers.tsv\"), (\"exits\", f\"{stem}.exits.tsv\")]}\n+for name, env_name in [(\"approvalScreenshot\", \"APPROVAL_SHOT\"), (\"postExitScreenshot\", \"EXIT_SHOT\")]:\n+    if e[env_name]:\n+        files[name] = {\"path\": os.path.basename(e[env_name]), \"sha256\": sha(e[env_name])}\n record = {\n     \"acceptance\": \"ACCEPTANCE §5.3\", \"cell\": e[\"CELL\"], \"attempt\": int(e[\"ATTEMPT\"]), \"terminal\": e[\"TERMINAL_NAME\"], \"size\": e[\"CELL_SIZE\"],\n     \"rc\": e[\"RC\"], \"nexusVersion\": e[\"NEXUS_VERSION_LINE\"], \"nexusPath\": e[\"NEXUS_PATH\"], \"packageDir\": e[\"PACKAGE_DIR\"],\n@@ -220,9 +235,7 @@ record = {\n     \"env\": {k: e.get(k) for k in [\"TERM\", \"TERM_PROGRAM\", \"TERM_PROGRAM_VERSION\", \"COLORTERM\", \"VTE_VERSION\", \"KITTY_WINDOW_ID\", \"TMUX\", \"XTERM_VERSION\"]},\n     \"tmux\": e[\"TMUX_VERSION\"] or None, \"kittyKeyboardProtocol\": e[\"KITTY_PROTOCOL\"] or None,\n     \"measured\": exits, \"scenarios\": scenarios, \"checks\": checks,\n-    \"files\": {name: {\"path\": os.path.basename(path), \"sha256\": sha(path)} for name, path in\n-              [(\"approvalScreenshot\", e[\"APPROVAL_SHOT\"]), (\"postExitScreenshot\", e[\"EXIT_SHOT\"]), (\"mockLog\", f\"{stem}.mock.log\"),\n-               (\"answers\", f\"{stem}.answers.tsv\"), (\"exits\", f\"{stem}.exits.tsv\")]},\n+    \"files\": files,\n     \"operator\": e[\"OPERATOR_NAME\"],\n }\n with open(f\"{stem}.json\", \"x\") as f:\ndiff --git a/scripts/terminal-acceptance/summarize.mjs b/scripts/terminal-acceptance/summarize.mjs\nindex ada63102..24634a1c 100755\n--- a/scripts/terminal-acceptance/summarize.mjs\n+++ b/scripts/terminal-acceptance/summarize.mjs\n@@ -5,8 +5,9 @@\n // --manifest-sha256 is the SHA-256 of MANIFEST.sha256 inside the RC release archive, so every cell must have run the\n // published RC package. The gate fails closed:\n //   - every terminal × size cell needs a complete, verified attempt (otherwise NOT RUN: ACCEPTANCE §1 rule 5);\n-//   - an attempt is complete only when its self-hash, file hashes, both launch measurements and the mock log's\n-//     scenario proof (approve x2 tool rounds, stream, sleep tool call) all verify;\n+//   - an attempt is complete only when its self-hash, required evidence file hashes, both launch measurements and\n+//     the mock log's scenario proof (approve x2 tool rounds, stream, sleep tool call) all verify; screenshots are\n+//     optional only for v1.0.0-rc.N under DEC-18 and, when supplied, both screenshot files must verify;\n //   - checks 2, 5 and 6 have zero FAIL in ANY attempt; a measured survivor or unrestored terminal turns PASS into FAIL;\n //   - every other FAIL, in any attempt, needs a written disposition keyed \"<cell>:<check>\";\n //   - an aborted attempt (a .partial file) needs a written disposition keyed \"<cell>:partial-<n>\".\n@@ -19,10 +20,13 @@ const TERMINALS = [\"xterm\", \"kitty\", \"tmux-gnome\", \"vscode\", \"gnome\"];\n const SIZES = [\"80x24\", \"40x14\", \"200x60\"];\n const CHECKS = [\"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"7\"];\n const SAFETY = new Set([\"2\", \"5\", \"6\"]);\n+const REQUIRED_FILES = [\"mockLog\", \"answers\", \"exits\"];\n+const OPTIONAL_SCREENSHOTS = [\"approvalScreenshot\", \"postExitScreenshot\"];\n const arg = (name) => (process.argv.includes(name) ? process.argv[process.argv.indexOf(name) + 1] : null);\n const dir = process.argv[2];\n const rc = arg(\"--rc\");\n const manifestSha = arg(\"--manifest-sha256\");\n+const screenshotWaiverApplies = /^v1\\.0\\.0-rc\\.\\d+$/.test(rc ?? \"\");\n if (!dir || !/^v\\d+\\.\\d+\\.\\d+-rc\\.\\d+$/.test(rc ?? \"\") || !/^[0-9a-f]{64}$/.test(manifestSha ?? \"\")) {\n   console.error(\"usage: summarize.mjs <evidence dir> --rc vX.Y.Z-rc.N --manifest-sha256 <hex> [--dispositions file]\");\n   process.exit(2);\n@@ -37,12 +41,22 @@ function attemptProblem(file, record, cell) {\n   if (record.cell !== cell) return `record names cell ${record.cell}`;\n   if (record.rc !== rc) return `record is for ${record.rc}, not ${rc}`;\n   if (record.packageManifestSha256 !== manifestSha) return \"installed package manifest differs from the RC archive\";\n-  for (const [name, entry] of Object.entries(record.files ?? {})) {\n+  const files = record.files;\n+  if (!files || typeof files !== \"object\" || Array.isArray(files)) return \"evidence files are missing\";\n+  const allowedFiles = new Set([...REQUIRED_FILES, ...OPTIONAL_SCREENSHOTS]);\n+  if (REQUIRED_FILES.some((name) => !Object.hasOwn(files, name)) || Object.keys(files).some((name) => !allowedFiles.has(name))) {\n+    return \"required evidence files are missing or unknown file entries are present\";\n+  }\n+  const hasApprovalScreenshot = Object.hasOwn(files, OPTIONAL_SCREENSHOTS[0]);\n+  const hasPostExitScreenshot = Object.hasOwn(files, OPTIONAL_SCREENSHOTS[1]);\n+  if (hasApprovalScreenshot !== hasPostExitScreenshot) return \"optional screenshots must be supplied as a pair\";\n+  if (!screenshotWaiverApplies && !hasApprovalScreenshot) return \"required screenshots are missing for this release series\";\n+  for (const [name, entry] of Object.entries(files)) {\n+    if (!entry || typeof entry.path !== \"string\" || typeof entry.sha256 !== \"string\") return `${name} file entry is malformed`;\n     const target = path.join(dir, entry.path);\n     if (!fs.existsSync(target) || sha(target) !== entry.sha256) return `${name} file missing or changed`;\n   }\n-  if (Object.keys(record.files ?? {}).length !== 5) return \"record does not list its five evidence files\";\n-  if (record.files.approvalScreenshot.sha256 === record.files.postExitScreenshot.sha256) return \"the two screenshots are the same file\";\n+  if (hasApprovalScreenshot && files.approvalScreenshot.sha256 === files.postExitScreenshot.sha256) return \"the two screenshots are the same file\";\n   const launches = (record.measured ?? []).map((m) => m.launch).sort().join(\",\");\n   if (launches !== \"main,no_color\") return `measured launches are [${launches}], not main and no_color`;\n   if (record.measured.some((m) => !Number.isInteger(m.survivors) || m.survivors < 0 || ![\"verified\", \"unavailable\"].includes(m.scopeMeasurement) || typeof m.sttyRestored !== \"boolean\")) return \"measurements are malformed\";\ndiff --git a/scripts/terminal-acceptance/test-scope-procs.sh b/scripts/terminal-acceptance/test-scope-procs.sh\nindex 6fde56ce..f47485fd 100644\n--- a/scripts/terminal-acceptance/test-scope-procs.sh\n+++ b/scripts/terminal-acceptance/test-scope-procs.sh\n@@ -75,27 +75,29 @@ SYSTEMCTL_FAIL=1 expect_unavailable\n \n mkdir -p \"$tmp/evidence\"\n write_evidence_fixture() {\n-  MODE=\"$1\" EVIDENCE_DIR=\"$tmp/evidence\" node --input-type=module <<'NODE'\n+  MODE=\"$1\" RC=\"${2:-v1.0.0-rc.1}\" EVIDENCE_DIR=\"$tmp/evidence\" node --input-type=module <<'NODE'\n import { createHash } from \"node:crypto\";\n import fs from \"node:fs\";\n import path from \"node:path\";\n \n const dir = process.env.EVIDENCE_DIR;\n const sha = (data) => createHash(\"sha256\").update(data).digest(\"hex\");\n-for (const [name, body] of Object.entries({\n-  \"approval.png\": \"approval screenshot\",\n-  \"post-exit.png\": \"post exit screenshot\",\n+const contents = {\n   \"mock.log\": \"mock request log\",\n   \"answers.tsv\": \"checks\",\n   \"exits.tsv\": \"measurements\",\n-})) fs.writeFileSync(path.join(dir, name), body);\n-const files = Object.fromEntries(Object.entries({\n-  approvalScreenshot: \"approval.png\",\n-  postExitScreenshot: \"post-exit.png\",\n+};\n+if (process.env.MODE !== \"no_screenshots\") contents[\"approval.png\"] = \"approval screenshot\";\n+if (!new Set([\"no_screenshots\", \"one_screenshot\"]).has(process.env.MODE)) contents[\"post-exit.png\"] = \"post exit screenshot\";\n+for (const [name, body] of Object.entries(contents)) fs.writeFileSync(path.join(dir, name), body);\n+const fileNames = {\n   mockLog: \"mock.log\",\n   answers: \"answers.tsv\",\n   exits: \"exits.tsv\",\n-}).map(([key, name]) => [key, { path: name, sha256: sha(fs.readFileSync(path.join(dir, name))) }]));\n+};\n+if (contents[\"approval.png\"]) fileNames.approvalScreenshot = \"approval.png\";\n+if (contents[\"post-exit.png\"]) fileNames.postExitScreenshot = \"post-exit.png\";\n+const files = Object.fromEntries(Object.entries(fileNames).map(([key, name]) => [key, { path: name, sha256: sha(fs.readFileSync(path.join(dir, name))) }]));\n for (const terminal of [\"xterm\", \"kitty\", \"tmux-gnome\", \"vscode\", \"gnome\"]) {\n   for (const size of [\"80x24\", \"40x14\", \"200x60\"]) {\n     const cell = `${terminal}-${size}`;\n@@ -110,7 +112,7 @@ for (const terminal of [\"xterm\", \"kitty\", \"tmux-gnome\", \"vscode\", \"gnome\"]) {\n     const record = {\n       cell,\n       attempt: 1,\n-      rc: \"v1.0.0-rc.1\",\n+      rc: process.env.RC,\n       packageManifestSha256: \"a\".repeat(64),\n       measured: [measurement(\"main\"), measurement(\"no_color\")],\n       scenarios: { approveToolRounds: [0, 1], stream: 1, sleepTool: 1 },\n@@ -139,4 +141,141 @@ node \"$HERE/summarize.mjs\" \"$tmp/evidence\" --rc v1.0.0-rc.1 --manifest-sha256 \"$\n grep -q 'manual matrix gate for v1.0.0-rc.1 .*: PASS' \"$tmp/verified-summary.log\"\n grep -q '^| xterm-80x24 | 1 | PASS | PASS' \"$tmp/verified-summary.log\"\n \n+# DEC-18 waives screenshot artifacts, but a supplied screenshot pair remains hash-checked.\n+write_evidence_fixture no_screenshots\n+node \"$HERE/summarize.mjs\" \"$tmp/evidence\" --rc v1.0.0-rc.1 --manifest-sha256 \"$(printf 'a%.0s' {1..64})\" > \"$tmp/no-screenshots-summary.log\"\n+grep -q 'manual matrix gate for v1.0.0-rc.1 .*: PASS' \"$tmp/no-screenshots-summary.log\"\n+write_evidence_fixture one_screenshot\n+if node \"$HERE/summarize.mjs\" \"$tmp/evidence\" --rc v1.0.0-rc.1 --manifest-sha256 \"$(printf 'a%.0s' {1..64})\" > \"$tmp/one-screenshot-summary.log\" 2>&1; then\n+  echo \"summary gate accepted an incomplete optional screenshot pair\" >&2\n+  exit 1\n+fi\n+grep -q 'optional screenshots must be supplied as a pair' \"$tmp/one-screenshot-summary.log\"\n+write_evidence_fixture no_screenshots v1.0.1-rc.1\n+if node \"$HERE/summarize.mjs\" \"$tmp/evidence\" --rc v1.0.1-rc.1 --manifest-sha256 \"$(printf 'a%.0s' {1..64})\" > \"$tmp/non-v100-no-screenshots.log\" 2>&1; then\n+  echo \"summary gate applied the v1.0.0 screenshot waiver to another release series\" >&2\n+  exit 1\n+fi\n+grep -q 'required screenshots are missing for this release series' \"$tmp/non-v100-no-screenshots.log\"\n+\n+# Drive the actual manual runner in a PTY with a synthetic installed package to prove that\n+# the interactive run can be recorded without prompting for screenshot paths. This is a\n+# tooling regression fixture only and never counts as a manual qualification cell.\n+runner=\"$tmp/runner\"\n+mkdir -p \"$runner/package/bin\" \"$runner/bin\" \"$runner/out\"\n+cat > \"$runner/package/VERSION\" <<'EOF'\n+v1.0.0-rc.1\n+EOF\n+cat > \"$runner/package/bin/nexus\" <<'EOF'\n+#!/usr/bin/env bash\n+package=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n+version=\"$(cat \"$package/VERSION\")\"\n+if [[ \"${1:-}\" == --version ]]; then echo \"Nexus $version\"; exit 0; fi\n+: > \"$HOME/mock.log\"\n+echo 'synthetic terminal runner fixture'\n+EOF\n+chmod +x \"$runner/package/bin/nexus\"\n+(cd \"$runner/package\" && sha256sum VERSION bin/nexus > MANIFEST.sha256)\n+cat > \"$runner/bin/systemd-run\" <<'EOF'\n+#!/usr/bin/env bash\n+set -euo pipefail\n+while [[ $# -gt 0 && \"$1\" != -- ]]; do shift; done\n+[[ $# -gt 0 ]] || exit 2\n+shift\n+exec \"$@\"\n+EOF\n+cat > \"$runner/bin/systemctl\" <<'EOF'\n+#!/usr/bin/env bash\n+set -euo pipefail\n+property=\"\"\n+for arg in \"$@\"; do [[ \"$arg\" == --property=* ]] && property=\"${arg#--property=}\"; done\n+case \"$property\" in\n+  LoadState) echo not-found ;;\n+  ActiveState|ControlGroup) echo \"\" ;;\n+  *) exit 2 ;;\n+esac\n+EOF\n+chmod +x \"$runner/bin/systemd-run\" \"$runner/bin/systemctl\"\n+RUNNER=\"$HERE/run-cell.sh\" FIXTURE=\"$runner\" python3 - <<'PY'\n+import fcntl, glob, hashlib, json, os, pty, select, struct, termios, time, sys\n+fixture = os.environ[\"FIXTURE\"]\n+out = os.path.join(fixture, \"out\")\n+env = os.environ.copy()\n+env.update({\n+    \"HOME\": os.path.join(fixture, \"home\"),\n+    \"TMPDIR\": fixture,\n+    \"PATH\": os.path.join(fixture, \"package\", \"bin\") + os.pathsep + os.path.join(fixture, \"bin\") + os.pathsep + env[\"PATH\"],\n+    \"TERM\": \"xterm\", \"XTERM_VERSION\": \"XTerm fixture\", \"COLUMNS\": \"80\", \"LINES\": \"24\",\n+})\n+os.makedirs(env[\"HOME\"], exist_ok=True)\n+\n+def update_package_version(version):\n+    package = os.path.join(fixture, \"package\")\n+    with open(os.path.join(package, \"VERSION\"), \"w\", encoding=\"utf-8\") as f: f.write(version + \"\\n\")\n+    paths = [\"VERSION\", \"bin/nexus\"]\n+    with open(os.path.join(package, \"MANIFEST.sha256\"), \"w\", encoding=\"utf-8\") as f:\n+        for relative in paths:\n+            with open(os.path.join(package, relative), \"rb\") as source:\n+                digest = hashlib.sha256(source.read()).hexdigest()\n+            f.write(f\"{digest}  {relative}\\n\")\n+\n+def run_cell(version, screenshot_inputs):\n+    update_package_version(version)\n+    pid, fd = pty.fork()\n+    if pid == 0:\n+        time.sleep(0.1)\n+        os.execve(os.environ[\"RUNNER\"], [os.environ[\"RUNNER\"], \"--rc\", version, \"--terminal\", \"xterm\", \"--size\", \"80x24\", \"--out\", out], env)\n+    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack(\"HHHH\", 24, 80, 0, 0))\n+    payload = \"\\n\\n\" + \"PASS\\n\\n\" * 7 + \"test-operator\\n\" + screenshot_inputs\n+    os.write(fd, payload.encode())\n+    captured = bytearray()\n+    deadline = time.monotonic() + 45\n+    status = None\n+    while time.monotonic() < deadline:\n+        ready, _, _ = select.select([fd], [], [], 0.2)\n+        if ready:\n+            try: captured.extend(os.read(fd, 65536))\n+            except OSError: pass\n+        done, status = os.waitpid(pid, os.WNOHANG)\n+        if done:\n+            while True:\n+                ready, _, _ = select.select([fd], [], [], 0)\n+                if not ready: break\n+                try: captured.extend(os.read(fd, 65536))\n+                except OSError: break\n+            break\n+    if status is None:\n+        os.kill(pid, 9)\n+        os.waitpid(pid, 0)\n+        raise SystemExit(f\"run-cell fixture timed out for {version}\")\n+    text = captured.decode(errors=\"replace\")\n+    if status != 0:\n+        print(text[-6000:], file=sys.stderr)\n+        raise SystemExit(f\"run-cell fixture exited with wait status {status} for {version}\")\n+    return text\n+\n+v100 = run_cell(\"v1.0.0-rc.1\", \"n\\n\")\n+if \"Attach optional approval and post-exit screenshots?\" not in v100:\n+    raise SystemExit(\"v1.0.0 runner did not expose the optional screenshot choice\")\n+if \"approval-panel screenshot path:\" in v100 or \"post-exit screenshot path:\" in v100:\n+    raise SystemExit(\"v1.0.0 runner still required screenshot paths\")\n+for name, body in ((\"approval.png\", b\"approval\"), (\"post-exit.png\", b\"post-exit\")):\n+    path = os.path.join(fixture, name)\n+    with open(path, \"wb\") as f: f.write(body)\n+    future = time.time() + 120\n+    os.utime(path, (future, future))\n+non_v100 = run_cell(\"v1.0.1-rc.1\", os.path.join(fixture, \"approval.png\") + \"\\n\" + os.path.join(fixture, \"post-exit.png\") + \"\\n\")\n+if \"Screenshots are required for v1.0.1-rc.1\" not in non_v100:\n+    raise SystemExit(\"non-v1.0.0 runner did not retain required screenshot behavior\")\n+records = sorted(glob.glob(os.path.join(out, \"cell-xterm-80x24.attempt-*.json\")))\n+if len(records) != 2:\n+    raise SystemExit(f\"expected two synthetic runner records, found {len(records)}\")\n+v100_record = json.load(open(records[0], encoding=\"utf-8\"))\n+if set(v100_record[\"files\"]) != {\"mockLog\", \"answers\", \"exits\"}:\n+    raise SystemExit(f\"v1.0.0 record unexpectedly requires screenshots: {sorted(v100_record['files'])}\")\n+non_v100_record = json.load(open(records[1], encoding=\"utf-8\"))\n+if not {\"approvalScreenshot\", \"postExitScreenshot\"}.issubset(non_v100_record[\"files\"]):\n+    raise SystemExit(\"non-v1.0.0 record did not retain both required screenshot artifacts\")\n+PY\n+\n echo \"scope measurement fixtures passed\"\n","exit_code":0,"duration":{"secs":0,"nanos":39594}},"started_at_ms":1793252750804,"completed_at_ms":1793252750805}}
