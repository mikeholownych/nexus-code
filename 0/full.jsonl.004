lows/repro.yml\nM\tcli/test/repro_identity.test.ts\nM\tscripts/package-linux.sh\nM\tscripts/repro-identity.mjs\n\nCURRENT MAIN REPRO REFERENCES\norigin/main:.github/workflows/ci.yml:149:      - run: bash scripts/package-linux.sh \"v${{ steps.release-version.outputs.version }}\" \"$RUNNER_TEMP/dist\"\norigin/main:.github/workflows/ci.yml:150:      - run: bash scripts/package-linux.sh \"v${{ steps.release-version.outputs.version }}\" \"$RUNNER_TEMP/repro-check\"\norigin/main:.github/workflows/release.yml:101:      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/dist\"\norigin/main:.github/workflows/release.yml:102:      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/repro-check\"\norigin/main:.github/workflows/repro.yml:1:name: Cross-runner RC reproducibility\norigin/main:.github/workflows/repro.yml:56:             ! grep -Fq 'scripts/release-tools/package-lock.json' scripts/package-linux.sh || \\\norigin/main:.github/workflows/repro.yml:57:             ! grep -Fq 'check_deprecated_lock.mjs' scripts/package-linux.sh || \\\norigin/main:.github/workflows/repro.yml:58:             grep -Eq '(^|[[:space:]])npx([[:space:]]|$)' scripts/package-linux.sh scripts/generate_sbom.sh; then\norigin/main:.github/workflows/repro.yml:59:            echo \"The selected RC predates or bypasses the locked notices tool and lock deprecation gate; cross-runner reproduction requires an RC whose tag includes them.\" >&2\norigin/main:.github/workflows/repro.yml:132:          package_tool=\"$RUNNER_TEMP/package-linux.sh\"\norigin/main:.github/workflows/repro.yml:133:          git show \"$NEXUS_PACKAGE_TOOL_COMMIT:scripts/package-linux.sh\" > \"$package_tool\"\norigin/main:.github/workflows/repro.yml:138:          NEXUS_PACKAGE_TOOL_SCRIPT: ${{ runner.temp }}/package-linux.sh\norigin/main:.github/workflows/repro.yml:211:            printf '## Cross-runner RC reproducibility: %s\\n\\n' \"$TARGET_TAG\"\norigin/main:.github/workflows/repro.yml:214:            printf 'Both runner outputs match each other and the six selected reproducibility artifacts.\\n'\norigin/main:.github/workflows/repro.yml:216:            printf '\\nReproducibility evidence artifact: repro-evidence.json\\n'\norigin/main:scripts/generate_sbom.sh:20:# 1. Generate Rust SBOM for the exact platform shipped by package-linux.sh.\norigin/main:scripts/generate_sbom.sh:168:# 4. Normalize metadata for reproducible builds if SOURCE_DATE_EPOCH or git commit is available\norigin/main:scripts/package-linux.sh:16:VERSION=${1:?usage: package-linux.sh VERSION OUTPUT_DIR}\norigin/main:scripts/package-linux.sh:17:OUT=${2:?usage: package-linux.sh VERSION OUTPUT_DIR}\norigin/main:scripts/package-linux.sh:183:# path remains host-built and must not be used as reproducibility evidence.\norigin/main:scripts/repro-identity.mjs:1:// Source identity for the cross-runner reproducibility workflow (ACC-SUP-08, REQ-REL-114).\norigin/main:scripts/repro-identity.mjs:24:  if (process.env.GITHUB_REF !== \"refs/heads/main\") fail(\"reproducibility workflow must run from reviewed main\");\norigin/main:scripts/repro-identity.mjs:38:  const reviewedPackageScript = execFileSync(\"git\", [\"show\", `${packageToolCommit}:scripts/package-linux.sh`], { encoding: \"utf8\" });\norigin/main:scripts/repro-identity.mjs:89:  if (JSON.stringify(Object.keys(first.artifacts).sort()) !== JSON.stringify(expectedAssets)) fail(\"identity evidence does not cover the six selected reproducibility artifacts\");\norigin/main:scripts/security_gates.sh:118:  # credentials in review reproduction tests; the review documents themselves are scanned)\norigin/main:scripts/terminal-acceptance/README.md:56:The deterministic systemd-scope measurement fixtures run as part of `npm test` in `cli/`. They cover empty and\norigin/main:scripts/terminal-acceptance/mockgw.py:2:\"\"\"Deterministic OpenAI-compatible mock for the manual terminal matrix (ACCEPTANCE §5.3).\norigin/main:scripts/terminal-acceptance/run-cell.sh