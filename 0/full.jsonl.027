{"timestamp":"2026-10-27T17:42:12.527Z","ordinal":419850,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17e71-922f-7ef3-a2c1-bcdcbd1f8423","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a17e71-922f-7ef3-a2c1-bcdcbd1f8423","response_id":"resp_060b64278a9dfb15016ae0e273077481a0a8098fb09f58e948","usage":{"input_tokens":191313,"cached_input_tokens":190848,"cache_write_input_tokens":0,"output_tokens":106,"reasoning_output_tokens":0,"total_tokens":191419},"turn_token_usage":{"input_tokens":3970575,"cached_input_tokens":3924096,"cache_write_input_tokens":0,"output_tokens":14481,"reasoning_output_tokens":10593,"total_tokens":3985056},"thread_token_usage":{"input_tokens":7729830467,"cached_input_tokens":7647377152,"cache_write_input_tokens":0,"output_tokens":22087886,"reasoning_output_tokens":12788088,"total_tokens":7751918353}}}
{"timestamp":"2026-10-27T17:42:14.411Z","ordinal":419851,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17e71-922f-7ef3-a2c1-bcdcbd1f8423","item":{"type":"CommandExecution","id":"exec-8253276b-ac4c-4ddd-b7f2-b4db41b7aa9d","process_id":"42139","command":["/usr/bin/zsh","-lc","sed -n '85,115p' cli/src/client.ts; sed -n '85,135p' cli/src/usage.ts; sed -n '1,150p' cli/src/provider_cli.ts | tail -55"],"cwd":"file:///home/mike/nexus-wt/rc10-readiness-20261027","parsed_cmd":[{"type":"read","cmd":"sed -n '85,115p' cli/src/client.ts","name":"client.ts","path":"cli/src/client.ts"},{"type":"read","cmd":"sed -n '85,135p' cli/src/usage.ts","name":"usage.ts","path":"cli/src/usage.ts"},{"type":"read","cmd":"sed -n '1,150p' cli/src/provider_cli.ts","name":"provider_cli.ts","path":"cli/src/provider_cli.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * The operator's home directory as resolved when the authority was recorded: the stored credentials (config.env, the\n * gateway token file) are read from there, never from a HOME that an env file set later.\n */\nlet credentialHome: string | undefined;\n\nexport function setCredentialAuthority(settings: Record<string, string | undefined>, operatorHome: string = os.homedir()): void {\n  credentialAuthority = Object.freeze({ ...settings });\n  credentialHome = operatorHome;\n}\n\n/** Where the operator's stored credentials live (the live home only before any authority is recorded). */\nexport function credentialStorageHome(): string {\n  return credentialHome ?? os.homedir();\n}\n\nfunction authoritySetting(key: string): string | undefined {\n  return (credentialAuthority ? credentialAuthority[key] : process.env[key])?.trim() || undefined;\n}\n\n/** A setting as the operator configured it (operator environment + config.env; never a project or install .env). */\nexport function operatorSetting(key: string): string | undefined {\n  return authoritySetting(key);\n}\n\nsetLocalityAuthorityResolver(operatorSetting);\n\n/** Origins that stored credentials belong to, and the operator-environment key with its own origin. */\nfunction storedCredentialHomes(): { gateway?: string; listed: Set<string>; envKey?: string; envKeyOrigin?: string } {\n  const file = readConfigEnv();\n  // When a legacy config.env key was present before the endpoint changed, the setup writer records its original\n   * Admit one cloud request under the limits, reserving `estimatedTokens` until it is recorded. Concurrent callers\n   * (scheduled work units, subagents) see each other's reservations. Returns a refusal reason, or undefined.\n   */\n  admit(requestId: string, estimatedTokens: number, costReported: boolean): string | undefined {\n    const t = this.cloudTotals();\n    const pendingTokens = [...this.reserved.values()].reduce((a, b) => a + b, 0);\n    const { maxRequests, maxTokens, maxCostUsd } = this.limits;\n    if (maxRequests !== undefined && t.requests + this.reserved.size + 1 > maxRequests) {\n      return `cloud request limit reached (NEXUS_CLOUD_MAX_REQUESTS=${maxRequests}; ${t.requests} recorded, ${this.reserved.size} in flight)`;\n    }\n    if (maxTokens !== undefined && t.inputTokens + t.outputTokens + pendingTokens + estimatedTokens > maxTokens) {\n      return `cloud token limit would be exceeded (NEXUS_CLOUD_MAX_TOKENS=${maxTokens}; ${t.inputTokens + t.outputTokens} used, ${pendingTokens} reserved, ~${estimatedTokens} requested)`;\n    }\n    if (maxCostUsd !== undefined) {\n      if (!costReported) return `NEXUS_CLOUD_MAX_COST_USD is set but this provider does not report cost, so the limit cannot be enforced; use NEXUS_CLOUD_MAX_TOKENS instead`;\n      if (t.costUsd >= maxCostUsd) return `cloud cost limit reached (NEXUS_CLOUD_MAX_COST_USD=${maxCostUsd}; $${t.costUsd.toFixed(4)} reported)`;\n    }\n    this.reserved.set(requestId, estimatedTokens);\n    return undefined;\n  }\n\n  /** Drops a reservation whose request will not be recorded under that id. */\n  release(requestId: string): void {\n    this.reserved.delete(requestId);\n  }\n\n  record(receipt: InferenceReceipt, workspace?: string): void {\n    this.reserved.delete(receipt.requestId);\n    if (process.env.NEXUS_RECEIPTS === \"0\") return;\n    this.receipts.push(receipt);\n    if (!workspace) return;\n    try {\n      const dir = path.join(workspace, \".nexus\");\n      ensurePrivateDir(dir);\n      appendPrivateFile(path.join(dir, \"inference_receipts.jsonl\"), JSON.stringify(receipt) + \"\\n\");\n    } catch {\n      // Receipts are diagnostics; an unwritable workspace must not fail the inference that already happened.\n    }\n  }\n\n  all(): readonly InferenceReceipt[] {\n    return this.receipts;\n  }\n\n  cloudTotals(): UsageTotals {\n    const t: UsageTotals = { requests: 0, inputTokens: 0, outputTokens: 0, costUsd: 0, unpricedRequests: 0, uncertainRequests: 0 };\n    for (const r of this.receipts) {\n      // Requests refused before sending (disclosure, limits, missing credential) cost nothing.\n      if (r.disclosure !== \"cloud\" || r.failureKind === \"policy_denied\" || r.failureKind === \"configuration_error\") continue;\n      t.requests++;\n      t.inputTokens += r.usage?.inputTokens ?? 0;\n    try {\n      const endpoint = new URL(config.endpoint.trim());\n      substitute(endpoint.href, safeOrigin);\n      substitute(`${endpoint.origin}${endpoint.pathname}${endpoint.search}${endpoint.hash}`, safeOrigin);\n      substitute(`${endpoint.origin}${endpoint.pathname}`, safeOrigin);\n      substitute(endpoint.origin, safeOrigin);\n      substitute(endpoint.hostname, new URL(safeOrigin).hostname);\n      substitute(endpoint.pathname, \"(path redacted)\");\n      substitute(endpoint.search, \"\");\n      substitute(endpoint.hash, \"\");\n    } catch {\n      // Invalid endpoints are rejected by config validation before the live check starts.\n    }\n  }\n  return safe;\n}\n\nconst SAFE_FAILURE_KINDS = new Set([\n  \"http_error\", \"network_error\", \"timeout\", \"stream_interrupted\", \"stream_incomplete\", \"provider_error_frame\",\n  \"malformed_event\", \"output_truncated\", \"protocol_error\", \"aborted\", \"policy_denied\", \"configuration_error\", \"verification_error\",\n]);\nconst SAFE_FAILURE_CONDITIONS = new Set([\n  \"TEMPORARILY_UNAVAILABLE\", \"RATE_LIMITED\", \"OVERLOADED\", \"DRAINING\", \"AUTH_FAILURE\", \"QUOTA_EXHAUSTED\",\n  \"CAPACITY_REJECTED\", \"REQUEST_REJECTED\", \"PERMANENT_FAILURE\", \"AVAILABLE\",\n]);\n\nfunction safeStepDetail(ok: boolean, detail: string): string {\n  if (!ok) return detail === \"Provider request failed\" ? detail : \"Verification failed\";\n  if (/^streamed completion received \\(\\d+ chars\\)$/.test(detail)) return detail;\n  if (/^echo_token tool call completed \\(\\d+ call\\(s\\)\\)$/.test(detail)) return detail;\n  return detail === \"tool result round trip completed\" ? detail : \"Verification succeeded\";\n}\n\n/** A credential-safe JSON projection for `providers verify --json`; raw provider diagnostics are deliberately omitted. */\nexport function verificationSummary(\n  steps: readonly VerificationStep[],\n  receipts: readonly import(\"./usage.js\").InferenceReceipt[],\n  target?: Pick<HarnessConfig, \"provider\" | \"model\">,\n) {\n  const provider = safeProviderId(target?.provider ?? receipts[0]?.providerId);\n  const model = target?.model ?? receipts[0]?.selectedModel;\n  return {\n    passed: steps.length === 3 && steps.every((step) => step.ok),\n    ...(provider ? { provider } : {}),\n    ...(model ? { model: safeModelId(model) } : {}),\n    steps: steps.map(({ step, ok, requestId, detail, failureKind, failureCondition }) => {\n      const safeKind = failureKind && SAFE_FAILURE_KINDS.has(failureKind) ? failureKind : undefined;\n      const safeCondition = failureCondition && SAFE_FAILURE_CONDITIONS.has(failureCondition) ? failureCondition : undefined;\n      return {\n        step, ok, requestId, detail: safeStepDetail(ok, detail),\n        ...(safeKind ? { failureKind: safeKind } : {}),\n        ...(safeCondition ? { condition: safeCondition } : {}),\n      };\n    }),\n    receipts: receipts.map(({ at, requestId, role, providerId, selectedModel, effectiveModel, endpointOrigin, protocol, disclosure, executions, outcome, failureKind, usage, usageConfidence, costConfidence }) => {\n","exit_code":0,"duration":{"secs":0,"nanos":763143905}},"started_at_ms":1793122933647,"completed_at_ms":1793122934411}}
