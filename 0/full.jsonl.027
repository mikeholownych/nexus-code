{"timestamp":"2026-10-27T17:53:01.616Z","ordinal":420395,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17e71-922f-7ef3-a2c1-bcdcbd1f8423","item":{"type":"CommandExecution","id":"exec-4be04662-3252-4ff1-a077-28a823319053","process_id":"69117","command":["/usr/bin/zsh","-lc","sed -n '1,220p' /home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/src/core/git_hook_guard.ts; sed -n '980,1225p' /home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/src/core/retention.ts; sed -n '1,260p' /home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/test/retention_git_hook.test.ts; sed -n '1,260p' /home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/test/checkpoint_git_hook.test.ts"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"read","cmd":"sed -n '1,220p' /home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/src/core/git_hook_guard.ts","name":"git_hook_guard.ts","path":"/home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/src/core/git_hook_guard.ts"},{"type":"read","cmd":"sed -n '980,1225p' /home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/src/core/retention.ts","name":"retention.ts","path":"/home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/src/core/retention.ts"},{"type":"read","cmd":"sed -n '1,260p' /home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/test/retention_git_hook.test.ts","name":"retention_git_hook.test.ts","path":"/home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/test/retention_git_hook.test.ts"},{"type":"read","cmd":"sed -n '1,260p' /home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/test/checkpoint_git_hook.test.ts","name":"checkpoint_git_hook.test.ts","path":"/home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/test/checkpoint_git_hook.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import { execFileSync } from \"node:child_process\";\n\nconst CONFIGURED_HOOK_QUERY = \"^hook\\\\..*\\\\.event$\";\n\n/** Quote one value for Git's GIT_CONFIG_PARAMETERS shell-like list. */\nfunction quoteConfigValue(value: string): string {\n  return `'${value.replace(/'/g, `'\\\\''`)}'`;\n}\n\n/**\n * Environment for a Git command that must not run hooks declared in repository config\n * (`hook.<name>.event` / `.command`, Git 2.54+). Such hooks are not disabled by\n * `core.hooksPath` and outrank `GIT_CONFIG_COUNT`, so their `hook.<name>.enabled=false`\n * overrides are appended to `GIT_CONFIG_PARAMETERS`, Git's own command-line channel.\n *\n * The workspace's effective config is read with `git config --includes`; if no configured\n * hook matches `events`, the environment is returned unchanged. A config read failure other\n * than \"no matches\" is rethrown so the caller can fail closed instead of running hooks.\n */\nexport function envWithoutConfiguredHooks(workspace: string, events: readonly string[]): NodeJS.ProcessEnv {\n  let configured: string;\n  try {\n    configured = execFileSync(\n      \"git\",\n      [\"config\", \"--null\", \"--includes\", \"--get-regexp\", CONFIGURED_HOOK_QUERY],\n      { cwd: workspace, encoding: \"utf8\", stdio: [\"ignore\", \"pipe\", \"ignore\"] }\n    );\n  } catch (error: any) {\n    if (error?.status === 1) return { ...process.env };\n    throw error;\n  }\n\n  const wanted = new Set(events);\n  const disabledKeys = new Set<string>();\n  for (const entry of configured.split(\"\\0\")) {\n    if (!entry) continue;\n    const separator = entry.indexOf(\"\\n\");\n    if (separator < 0) throw new Error(\"Unexpected Git hook configuration output\");\n    const key = entry.slice(0, separator);\n    const event = entry.slice(separator + 1);\n    if (!wanted.has(event)) continue;\n    if (!key.startsWith(\"hook.\") || !key.endsWith(\".event\")) continue;\n    const friendlyName = key.slice(\"hook.\".length, -\".event\".length);\n    disabledKeys.add(`hook.${friendlyName}.enabled`);\n  }\n\n  if (disabledKeys.size === 0) return { ...process.env };\n  const assignments = [...disabledKeys].map((key) => `${quoteConfigValue(key)}=${quoteConfigValue(\"false\")}`);\n  const existingParameters = (process.env.GIT_CONFIG_PARAMETERS ?? \"\").trim();\n  return {\n    ...process.env,\n    GIT_CONFIG_PARAMETERS: existingParameters\n      ? `${existingParameters} ${assignments.join(\" \")}`\n      : assignments.join(\" \"),\n  };\n}\nfunction removeConfinedTreeAt(parentFd: number, name: string, expectedIdentity?: string): void {\n  const target = procFdPath(parentFd, name);\n  const stat = fs.lstatSync(target);\n  if (expectedIdentity && fileObjectIdentity(stat) !== expectedIdentity) {\n    throw new Error(\"Checkpoint snapshot changed before deletion; snapshot was preserved\");\n  }\n  if (stat.isSymbolicLink()) {\n    // Removing a link from the already-confined directory never follows its target.\n    fs.unlinkSync(target);\n    return;\n  }\n  if (stat.isFile()) {\n    fs.unlinkSync(target);\n    return;\n  }\n  if (!stat.isDirectory()) throw new Error(\"Unsupported checkpoint snapshot entry; snapshot was preserved\");\n\n  const childFd = openChildDirectory(parentFd, name, directoryIdentity(stat));\n  try {\n    for (const child of fs.readdirSync(procFdPath(childFd))) removeConfinedTreeAt(childFd, child);\n  } finally {\n    fs.closeSync(childFd);\n  }\n  // This is relative to the pinned parent descriptor. A swapped symlink is not followed.\n  fs.rmdirSync(target);\n}\n\nfunction deleteCheckpointConfined(item: RetentionItem): void {\n  const stateRootIdentity = item.checkpointStateRootIdentity;\n  const checkpointsRootIdentity = item.checkpointRootIdentity;\n  const partitionIdentity = item.checkpointPartitionIdentity;\n  if (!stateRootIdentity || !checkpointsRootIdentity || !partitionIdentity || !item.primaryIdentity) {\n    throw new Error(\"Checkpoint plan is missing directory identity evidence; checkpoint was preserved\");\n  }\n\n  const partitionPath = path.dirname(item.primaryFile);\n  const checkpointsPath = path.dirname(partitionPath);\n  const stateRootPath = path.dirname(checkpointsPath);\n  let stateFd: number | undefined;\n  let checkpointsFd: number | undefined;\n  let partitionFd: number | undefined;\n  let snapshotsFd: number | undefined;\n  let snapshotParentFd: number | undefined;\n  try {\n    stateFd = openDirectoryNoFollow(stateRootPath, stateRootIdentity);\n    checkpointsFd = openChildDirectory(stateFd, path.basename(checkpointsPath), checkpointsRootIdentity);\n    partitionFd = openChildDirectory(checkpointsFd, path.basename(partitionPath), partitionIdentity);\n\n    const recordName = path.basename(item.primaryFile);\n    const recordPath = procFdPath(partitionFd, recordName);\n    const recordStat = fs.lstatSync(recordPath);\n    if (!recordStat.isFile() || recordStat.isSymbolicLink() || statIdentity(recordStat) !== item.primaryIdentity) {\n      throw new Error(\"Checkpoint record changed since planning; checkpoint was preserved\");\n    }\n\n    if (item.checkpointSnapshotRelativePath) {\n      if (!item.checkpointSnapshotsIdentity || !item.checkpointSnapshotIdentity) {\n        throw new Error(\"Checkpoint plan is missing snapshot identity evidence; checkpoint was preserved\");\n      }\n      snapshotsFd = openChildDirectory(partitionFd, \"snapshots\", item.checkpointSnapshotsIdentity);\n      const openedSnapshot = openSnapshotParent(snapshotsFd, item.checkpointSnapshotRelativePath, item.checkpointSnapshotIdentity);\n      if (openedSnapshot.ownsParentFd) snapshotParentFd = openedSnapshot.parentFd;\n\n      // Remove the record only after every parent and the target snapshot have been pinned and checked.\n      fs.unlinkSync(recordPath);\n      removeConfinedTreeAt(openedSnapshot.parentFd, openedSnapshot.name, item.checkpointSnapshotIdentity);\n    } else {\n      fs.unlinkSync(recordPath);\n    }\n  } finally {\n    if (snapshotParentFd !== undefined) fs.closeSync(snapshotParentFd);\n    if (snapshotsFd !== undefined) fs.closeSync(snapshotsFd);\n    if (partitionFd !== undefined) fs.closeSync(partitionFd);\n    if (checkpointsFd !== undefined) fs.closeSync(checkpointsFd);\n    if (stateFd !== undefined) fs.closeSync(stateFd);\n  }\n}\n\nfunction executeRetentionLocked(plan: RetentionPlan, options: { dryRun?: boolean; timeBudgetMs?: number; deadline?: number }): GcExecutionResult {\n  const startTime = Date.now();\n  const dryRun = Boolean(options.dryRun);\n  const deadline = options.deadline !== undefined\n    ? options.deadline\n    : (options.timeBudgetMs !== undefined ? startTime + options.timeBudgetMs : undefined);\n\n  let deletedCount = 0;\n  let deletedBytes = 0;\n  const deletedItems: RetentionItem[] = [];\n  const errors: Array<{ path: string; error: string }> = [];\n  let timedOut = Boolean(plan.timedOut);\n\n  const byKind: Record<RetentionItemKind, { count: number; bytes: number }> = {\n    task: { count: 0, bytes: 0 },\n    session: { count: 0, bytes: 0 },\n    checkpoint: { count: 0, bytes: 0 },\n    flight: { count: 0, bytes: 0 },\n  };\n\n  const sessionsRemoved: string[] = [];\n\n  for (const item of plan.reclaimableItems) {\n    if (deadline && Date.now() >= deadline) {\n      timedOut = true;\n      break;\n    }\n\n    if (dryRun) {\n      deletedCount++;\n      deletedBytes += item.sizeBytes;\n      deletedItems.push(item);\n      byKind[item.kind].count++;\n      byKind[item.kind].bytes += item.sizeBytes;\n      continue;\n    }\n\n    if (item.kind === \"task\" || item.kind === \"session\") {\n      const identities = item.fileIdentities;\n      if (!identities || Object.entries(identities).some(([file, identity]) => fileIdentity(file) !== identity)) {\n        errors.push({ path: item.primaryFile, error: \"Record changed since planning; collection skipped\" });\n        continue;\n      }\n    }\n\n    if (item.kind === \"checkpoint\") {\n      try {\n        deleteCheckpointConfined(item);\n      } catch (err: any) {\n        errors.push({ path: item.primaryFile, error: err?.message || String(err) });\n        continue;\n      }\n\n      if (item.gitRef && item.workspace) {\n        try {\n          const configuredHookEnv = envWithoutConfiguredHooks(item.workspace, [\"reference-transaction\"]);\n          execFileSync(\n            \"git\",\n            [\n              \"-c\",\n              \"core.hooksPath=/dev/null\",\n              \"update-ref\",\n              \"-d\",\n              `refs/nexus/checkpoints/${item.id}`,\n            ],\n            {\n              cwd: item.workspace,\n              env: configuredHookEnv,\n              stdio: \"ignore\",\n            },\n          );\n        } catch {}\n      }\n\n      deletedCount++;\n      deletedBytes += item.sizeBytes;\n      deletedItems.push(item);\n      byKind[item.kind].count++;\n      byKind[item.kind].bytes += item.sizeBytes;\n      continue;\n    }\n\n    let success = true;\n    const durableTaskRecord = item.kind === \"task\" || item.kind === \"session\";\n\n    // For schema-2 task/session records, companion logs are part of the\n    // committed record. Ensure the primary directory is syncable before any\n    // mutation, including when the plan is collecting an orphan group.\n    if (durableTaskRecord) {\n      try {\n        fsyncDirectoryDurably(path.dirname(item.primaryFile));\n      } catch (err: any) {\n        errors.push({ path: path.dirname(item.primaryFile), error: err?.message || String(err) });\n        continue;\n      }\n    }\n\n    // Delete primary file\n    try {\n      if (fs.existsSync(item.primaryFile)) {\n        fs.unlinkSync(item.primaryFile);\n      }\n    } catch (err: any) {\n      success = false;\n      errors.push({ path: item.primaryFile, error: err?.message || String(err) });\n    }\n\n    // Make primary removal durable before removing its associated files. If\n    // syncing fails, preserve the companions so a surviving primary stays\n    // readable and retryable after recovery.\n    if (success && durableTaskRecord) {\n      try {\n        fsyncDirectoryDurably(path.dirname(item.primaryFile));\n      } catch (err: any) {\n        success = false;\n        errors.push({ path: path.dirname(item.primaryFile), error: err?.message || String(err) });\n      }\n    }\n\n    // A failed primary removal must never leave a live envelope without its log.\n    if (!success) continue;\n\n    // Delete associated files (history, snapshots)\n    for (const assoc of item.associatedFiles) {\n      try {\n        if (fs.existsSync(assoc)) {\n          const s = safeStat(assoc);\n          if (s && s.isDirectory()) {\n            fs.rmSync(assoc, { recursive: true, force: true });\n          } else {\n            fs.unlinkSync(assoc);\n          }\n        }\n      } catch (err: any) {\n        success = false;\n        errors.push({ path: assoc, error: err?.message || String(err) });\n      }\n    }\n\n    if (success && durableTaskRecord && item.associatedFiles.length > 0) {\n      const directories = new Set(item.associatedFiles.map(file => path.dirname(file)));\n      for (const directory of directories) {\n        try {\n          fsyncDirectoryDurably(directory);\n        } catch (err: any) {\n          success = false;\n          errors.push({ path: directory, error: err?.message || String(err) });\n        }\n      }\n    }\n\n    if (success) {\n      if (item.kind === \"session\") {\n        sessionsRemoved.push(item.id);\n      }\n\n      deletedCount++;\n      deletedBytes += item.sizeBytes;\n      deletedItems.push(item);\n      byKind[item.kind].count++;\n      byKind[item.kind].bytes += item.sizeBytes;\n    }\n  }\n\n  // If sessions were removed and not a dry run, reconcile session index\n  if (!dryRun && sessionsRemoved.length > 0) {\n    try {\n      const sampleItem = plan.reclaimableItems.find((i) => i.kind === \"session\");\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { executeRetention, planRetention } from \"../src/core/retention.js\";\n\ntest(\"checkpoint gc disables repository hooks and deletes the checkpoint ref\", () => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-retention-hook-\"));\n  const home = path.join(root, \"home\");\n  const workspace = path.join(root, \"workspace\");\n  const partition = path.join(home, \".nexus\", \"checkpoints\", \"partition\");\n  fs.mkdirSync(partition, { recursive: true });\n  fs.mkdirSync(workspace, { recursive: true });\n  const previousGitConfigParameters = process.env.GIT_CONFIG_PARAMETERS;\n  try {\n    execFileSync(\"git\", [\"init\", \"-q\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.email\", \"t@t.invalid\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.name\", \"t\"], { cwd: workspace });\n    fs.writeFileSync(path.join(workspace, \"file.txt\"), \"x\\n\");\n    execFileSync(\"git\", [\"add\", \"file.txt\"], { cwd: workspace });\n    execFileSync(\"git\", [\"commit\", \"-qm\", \"base\"], { cwd: workspace });\n    const ref = \"refs/nexus/checkpoints/checkpoint\";\n    execFileSync(\"git\", [\"update-ref\", ref, \"HEAD\"], { cwd: workspace });\n    const marker = path.join(root, \"hook-ran\");\n    const hook = path.join(workspace, \".git\", \"hooks\", \"reference-transaction\");\n    fs.writeFileSync(hook, `#!/bin/sh\\ntouch '${marker}'\\n`, { mode: 0o755 });\n    fs.chmodSync(hook, 0o755);\n    const includedHookConfig = path.join(root, \"configured-hooks.inc\");\n    fs.writeFileSync(\n      includedHookConfig,\n      '[hook \"retention=extra\"]\\n\\tevent = reference-transaction\\n\\tcommand = touch configured-hook-ran\\n',\n    );\n    execFileSync(\"git\", [\"config\", \"--local\", \"include.path\", includedHookConfig], { cwd: workspace });\n    // A parent Git process can pass config through this internal environment variable; it outranks\n    // GIT_CONFIG_COUNT, so an inherited value must not be able to re-enable the configured hook.\n    process.env.GIT_CONFIG_PARAMETERS = \"'hook.retention=extra.enabled'='true'\";\n    const gitVersion = execFileSync(\"git\", [\"--version\"], { cwd: workspace, encoding: \"utf8\" });\n    const version = gitVersion.match(/git version (\\d+)\\.(\\d+)/);\n    assert.ok(version, `could not parse Git version: ${gitVersion}`);\n    const hasConfiguredHooks = Number(version[1]) > 2 || (Number(version[1]) === 2 && Number(version[2]) >= 54);\n    if (hasConfiguredHooks) {\n      const probeRef = \"refs/nexus/checkpoints/config-hook-probe\";\n      execFileSync(\"git\", [\"update-ref\", probeRef, \"HEAD\"], { cwd: workspace });\n      assert.equal(fs.existsSync(path.join(workspace, \"configured-hook-ran\")), true, \"configured hook precondition did not run\");\n      assert.equal(fs.existsSync(marker), true, \"traditional hook precondition did not run\");\n      fs.rmSync(path.join(workspace, \"configured-hook-ran\"));\n      fs.rmSync(marker);\n      execFileSync(\"git\", [\"update-ref\", \"-d\", probeRef], { cwd: workspace });\n      fs.rmSync(path.join(workspace, \"configured-hook-ran\"));\n      fs.rmSync(marker);\n    }\n\n    const record = path.join(partition, \"checkpoint.json\");\n    fs.writeFileSync(record, JSON.stringify({ workspace, gitRef: \"refs/nexus/checkpoints/checkpoint\" }));\n    const old = new Date(Date.now() - 3 * 24 * 60 * 60 * 1000);\n    fs.utimesSync(record, old, old);\n\n    const plan = planRetention({ home, maxAgeDays: 1 });\n    assert.ok(plan.reclaimableItems.some((item) => item.kind === \"checkpoint\"));\n    executeRetention(plan);\n    assert.equal(fs.existsSync(marker), false, \"gc executed a workspace git hook\");\n    assert.equal(fs.existsSync(path.join(workspace, \"configured-hook-ran\")), false, \"gc executed a configured Git hook\");\n    const refLookup = spawnSync(\"git\", [\"show-ref\", \"--verify\", \"--quiet\", ref], { cwd: workspace });\n    assert.equal(\n      refLookup.status,\n      1,\n      `git show-ref did not confirm ref deletion: ${refLookup.error?.message ?? refLookup.stderr?.toString()}`,\n    );\n  } finally {\n    if (previousGitConfigParameters === undefined) delete process.env.GIT_CONFIG_PARAMETERS;\n    else process.env.GIT_CONFIG_PARAMETERS = previousGitConfigParameters;\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\nimport { CheckpointManager } from \"../src/checkpoint.js\";\n\nfunction setup(): { root: string; workspace: string; marker: string; hook: string; restore: () => void } {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-hook-\"));\n  const home = path.join(root, \"home\");\n  const workspace = path.join(root, \"workspace\");\n  fs.mkdirSync(home, { recursive: true });\n  fs.mkdirSync(workspace, { recursive: true });\n  execFileSync(\"git\", [\"init\", \"-q\"], { cwd: workspace });\n  execFileSync(\"git\", [\"config\", \"user.email\", \"t@t.invalid\"], { cwd: workspace });\n  execFileSync(\"git\", [\"config\", \"user.name\", \"t\"], { cwd: workspace });\n  fs.writeFileSync(path.join(workspace, \"file.txt\"), \"x\\n\");\n  execFileSync(\"git\", [\"add\", \"file.txt\"], { cwd: workspace });\n  execFileSync(\"git\", [\"commit\", \"-qm\", \"base\"], { cwd: workspace });\n  const marker = path.join(root, \"hook-ran\");\n  const hook = path.join(workspace, \".git\", \"hooks\", \"reference-transaction\");\n  const postIndexHook = path.join(workspace, \".git\", \"hooks\", \"post-index-change\");\n  fs.writeFileSync(hook, `#!/bin/sh\\ntouch '${marker}'\\n`, { mode: 0o755 });\n  fs.chmodSync(hook, 0o755);\n  fs.writeFileSync(postIndexHook, `#!/bin/sh\\ntouch '${marker}'\\n`, { mode: 0o755 });\n  fs.chmodSync(postIndexHook, 0o755);\n  const previousHome = process.env.HOME;\n  process.env.HOME = home;\n  return {\n    root, workspace, marker, hook,\n    restore: () => {\n      process.env.HOME = previousHome;\n      fs.rmSync(root, { recursive: true, force: true });\n    },\n  };\n}\n\ntest(\"checkpoint creation does not execute a workspace git hook\", () => {\n  const env = setup();\n  try {\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"dirty\\n\");\n    // The changed-path index inspection (git show :path) can run a configured fsmonitor program.\n    const fsmonitorMarker = path.join(env.root, \"fsmonitor-ran\");\n    const fsmonitorScript = path.join(env.root, \"creation-fsmonitor.sh\");\n    fs.writeFileSync(fsmonitorScript, `#!/bin/sh\\ntouch '${fsmonitorMarker}'\\nexit 0\\n`, { mode: 0o755 });\n    fs.chmodSync(fsmonitorScript, 0o755);\n    execFileSync(\"git\", [\"config\", \"core.fsmonitor\", fsmonitorScript], { cwd: env.workspace });\n    const manager = new CheckpointManager(env.workspace);\n    manager.createCheckpoint(\"hook test\");\n    assert.equal(fs.existsSync(env.marker), false, \"checkpoint creation executed a workspace hook\");\n    assert.equal(fs.existsSync(fsmonitorMarker), false, \"checkpoint creation executed a workspace fsmonitor\");\n    const refs = execFileSync(\"git\", [\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"], {\n      cwd: env.workspace,\n      encoding: \"utf8\",\n    });\n    assert.match(refs, /refs\\/nexus\\/checkpoints\\//, \"the checkpoint ref was not created\");\n  } finally {\n    env.restore();\n  }\n});\n\ntest(\"checkpoint restore does not execute a workspace git hook\", () => {\n  const env = setup();\n  try {\n    fs.rmSync(env.hook, { force: true });\n    fs.rmSync(path.join(env.workspace, \".git\", \"hooks\", \"post-index-change\"), { force: true });\n    const manager = new CheckpointManager(env.workspace);\n    const cp = manager.createCheckpoint(\"hook restore\");\n    fs.writeFileSync(env.hook, `#!/bin/sh\\ntouch '${env.marker}'\\n`, { mode: 0o755 });\n    fs.chmodSync(env.hook, 0o755);\n    fs.writeFileSync(path.join(env.workspace, \".git\", \"hooks\", \"post-index-change\"), `#!/bin/sh\\ntouch '${env.marker}'\\n`, { mode: 0o755 });\n    fs.chmodSync(path.join(env.workspace, \".git\", \"hooks\", \"post-index-change\"), 0o755);\n    // Config-driven execution must stay off on restore as well: fsmonitor may run for the clean scan.\n    const fsmonitorScript = path.join(env.root, \"fsmonitor-canary.sh\");\n    fs.writeFileSync(fsmonitorScript, `#!/bin/sh\\ntouch '${env.marker}'\\nexit 0\\n`, { mode: 0o755 });\n    fs.chmodSync(fsmonitorScript, 0o755);\n    execFileSync(\"git\", [\"config\", \"core.fsmonitor\", fsmonitorScript], { cwd: env.workspace });\n    manager.restore(cp.id);\n    assert.equal(fs.existsSync(env.marker), false, \"checkpoint restore executed a workspace hook or fsmonitor\");\n  } finally {\n    env.restore();\n  }\n});\n\ntest(\"checkpoint diff does not execute repo-configured external diff or fsmonitor\", () => {\n  const env = setup();\n  try {\n    // The diff test is about config-driven programs, not hooks.\n    fs.rmSync(env.hook, { force: true });\n    fs.rmSync(path.join(env.workspace, \".git\", \"hooks\", \"post-index-change\"), { force: true });\n    const manager = new CheckpointManager(env.workspace);\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"first change\\n\");\n    const base = manager.createCheckpoint(\"diff base\");\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"second change\\n\");\n    const next = manager.createCheckpoint(\"diff next\");\n\n    const externalMarker = path.join(env.root, \"external-diff-ran\");\n    const fsmonitorMarker = path.join(env.root, \"fsmonitor-ran\");\n    const canary = path.join(env.root, \"diff-canary.sh\");\n    fs.writeFileSync(canary, `#!/bin/sh\\ntouch '${externalMarker}'\\ntouch '${fsmonitorMarker}'\\nexit 0\\n`, { mode: 0o755 });\n    fs.chmodSync(canary, 0o755);\n    execFileSync(\"git\", [\"config\", \"diff.external\", canary], { cwd: env.workspace });\n    execFileSync(\"git\", [\"config\", \"core.fsmonitor\", canary], { cwd: env.workspace });\n\n    const worktreeDiff = manager.getDiff(next.id);\n    const refDiff = manager.getDiff(next.id, base.id);\n    assert.equal(worktreeDiff.success, true, worktreeDiff.error);\n    assert.equal(refDiff.success, true, refDiff.error);\n    assert.equal(fs.existsSync(externalMarker), false, \"checkpoint diff executed diff.external\");\n    assert.equal(fs.existsSync(fsmonitorMarker), false, \"checkpoint diff executed core.fsmonitor\");\n  } finally {\n    env.restore();\n  }\n});\n\ntest(\"checkpoint operations do not execute hooks declared in repository config\", () => {\n  const env = setup();\n  try {\n    // Leave only configuration-declared hooks (Git 2.54+) in play.\n    fs.rmSync(env.hook, { force: true });\n    fs.rmSync(path.join(env.workspace, \".git\", \"hooks\", \"post-index-change\"), { force: true });\n    const gitVersion = execFileSync(\"git\", [\"--version\"], { cwd: env.workspace, encoding: \"utf8\" });\n    const version = gitVersion.match(/git version (\\d+)\\.(\\d+)/);\n    assert.ok(version, `could not parse Git version: ${gitVersion}`);\n    if (Number(version[1]) < 2 || (Number(version[1]) === 2 && Number(version[2]) < 54)) return;\n\n    const configuredMarker = path.join(env.root, \"configured-hook-ran\");\n    const included = path.join(env.root, \"configured-hooks.inc\");\n    fs.writeFileSync(\n      included,\n      `[hook \"checkpoint-reference\"]\\n\\tevent = reference-transaction\\n\\tcommand = touch '${configuredMarker}'\\n` +\n        `[hook \"checkpoint-index\"]\\n\\tevent = post-index-change\\n\\tcommand = touch '${configuredMarker}'\\n`\n    );\n    execFileSync(\"git\", [\"config\", \"--local\", \"include.path\", included], { cwd: env.workspace });\n\n    // Prove each event actually runs before testing that the manager suppresses it.\n    const probeRef = \"refs/nexus/checkpoints/config-hook-probe\";\n    execFileSync(\"git\", [\"update-ref\", probeRef, \"HEAD\"], { cwd: env.workspace });\n    assert.equal(fs.existsSync(configuredMarker), true, \"reference-transaction config hook precondition did not run\");\n    execFileSync(\"git\", [\"update-ref\", \"-d\", probeRef], { cwd: env.workspace });\n    fs.rmSync(configuredMarker, { force: true });\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"dirty for config hook precondition\\n\");\n    execFileSync(\"git\", [\"stash\", \"create\"], { cwd: env.workspace });\n    assert.equal(fs.existsSync(configuredMarker), true, \"post-index-change config hook precondition did not run\");\n    fs.rmSync(configuredMarker, { force: true });\n\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"dirty for checkpoint\\n\");\n    const manager = new CheckpointManager(env.workspace);\n    const cp = manager.createCheckpoint(\"config hook test\");\n    assert.equal(fs.existsSync(configuredMarker), false, \"checkpoint creation executed a configured hook\");\n    manager.restore(cp.id);\n    assert.equal(fs.existsSync(configuredMarker), false, \"checkpoint restore executed a configured hook\");\n    manager.pruneCheckpoints(0);\n    assert.equal(fs.existsSync(configuredMarker), false, \"checkpoint pruning executed a configured hook\");\n  } finally {\n    env.restore();\n  }\n});\n\ntest(\"checkpoint pruning does not execute a workspace git hook\", () => {\n  const env = setup();\n  try {\n    const manager = new CheckpointManager(env.workspace);\n    // Create without the hook present, then install it before pruning the ref.\n    fs.rmSync(env.hook, { force: true });\n    manager.createCheckpoint(\"hook prune\");\n    fs.writeFileSync(env.hook, `#!/bin/sh\\ntouch '${env.marker}'\\n`, { mode: 0o755 });\n    fs.chmodSync(env.hook, 0o755);\n    manager.pruneCheckpoints(0);\n    assert.equal(fs.existsSync(env.marker), false, \"checkpoint pruning executed a workspace hook\");\n  } finally {\n    env.restore();\n  }\n});\n","exit_code":0,"duration":{"secs":0,"nanos":27038}},"started_at_ms":1793123581616,"completed_at_ms":1793123581616}}
{"timestamp":"2026-10-27T17:53:02.593Z","ordinal":420396,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17e7e-8281-76f0-9e31-98a78ff6522b","call_id":"call_9ae6289e65a44416ae69c9aad18ad66e","output":[{"type":"input_text","text":"Script completed\nWall time 2.0 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 6282)\nTotal output lines: 553\n\nimport { execFileSync } from \"node:child_process\";\n\nconst CONFIGURED_HOOK_QUERY = \"^hook\\\\..*\\\\.event$\";\n\n/** Quote one value for Git's GIT_CONFIG_PARAMETERS shell-like list. */\nfunction quoteConfigValue(value: string): string {\n  return `'${value.replace(/'/g, `'\\\\''`)}'`;\n}\n\n/**\n * Environment for a Git command that must not run hooks declared in repository config\n * (`hook.<name>.event` / `.command`, Git 2.54+). Such hooks are not disabled by\n * `core.hooksPath` and outrank `GIT_CONFIG_COUNT`, so their `hook.<name>.enabled=false`\n * overrides are appended to `GIT_CONFIG_PARAMETERS`, Git's own command-line channel.\n *\n * The workspace's effective config is read with `git config --includes`; if no configured\n * hook matches `events`, the environment is returned unchanged. A config read failure other\n * than \"no matches\" is rethrown so the caller can fail closed instead of running hooks.\n */\nexport function envWithoutConfiguredHooks(workspace: string, events: readonly string[]): NodeJS.ProcessEnv {\n  let configured: string;\n  try {\n    configured = execFileSync(\n      \"git\",\n      [\"config\", \"--null\", \"--includes\", \"--get-regexp\", CONFIGURED_HOOK_QUERY],\n      { cwd: workspace, encoding: \"utf8\", stdio: [\"ignore\", \"pipe\", \"ignore\"] }\n    );\n  } catch (error: any) {\n    if (error?.status === 1) return { ...process.env };\n    throw error;\n  }\n\n  const wanted = new Set(events);\n  const disabledKeys = new Set<string>();\n  for (const entry of configured.split(\"\\0\")) {\n    if (!entry) continue;\n    const separator = entry.indexOf(\"\\n\");\n    if (separator < 0) throw new Error(\"Unexpected Git hook configuration output\");\n    const key = entry.slice(0, separator);\n    const event = entry.slice(separator + 1);\n    if (!wanted.has(event)) continue;\n    if (!key.startsWith(\"hook.\") || !key.endsWith(\".event\")) continue;\n    const friendlyName = key.slice(\"hook.\".length, -\".event\".length);\n    disabledKeys.add(`hook.${friendlyName}.enabled`);\n  }\n\n  if (disabledKeys.size === 0) return { ...process.env };\n  const assignments = [...disabledKeys].map((key) => `${quoteConfigValue(key)}=${quoteConfigValue(\"false\")}`);\n  const existingParameters = (process.env.GIT_CONFIG_PARAMETERS ?? \"\").trim();\n  return {\n    ...process.env,\n    GIT_CONFIG_PARAMETERS: existingParameters\n      ? `${existingParameters} ${assignments.join(\" \")}`\n      : assignments.join(\" \"),\n  };\n}\nfunction removeConfinedTreeAt(parentFd: number, name: string, expectedIdentity?: string): void {\n  const target = procFdPath(parentFd, name);\n  const stat = fs.lstatSync(target);\n  if (expectedIdentity && fileObjectIdentity(stat) !== expectedIdentity) {\n    throw new Error(\"Checkpoint snapshot changed before deletion; snapshot was preserved\");\n  }\n  if (stat.isSymbolicLink()) {\n    // Removing a link from the already-confined directory never follows its target.\n    fs.unlinkSync(target);\n    return;\n  }\n  if (stat.isFile()) {\n    fs.unlinkSync(target);\n    return;\n  }\n  if (!stat.isDirectory()) throw new Error(\"Unsupported checkpoint snapshot entry; snapshot was preserved\");\n\n  const childFd = openChildDirectory(parentFd, name, directoryIdentity(stat));\n  try {\n    for (const child of fs.readdirSync(procFdPath(childFd))) removeConfinedTreeAt(childFd, child);\n  } finally {\n    fs.closeSync(childFd);\n  }\n  // This is relative to the pinned parent descriptor. A swapped symlink is not followed.\n  fs.rmdirSync(target);\n}\n\nfunction deleteCheckpointConfined(item: RetentionItem): void {\n  const stateRootIdentity = item.checkpointStateRootIdentity;\n  const checkpointsRootIdentity = item.checkpointRootIdentity;\n  const partitionIdentity = item.checkpointPartitionIdentity;\n  if (!stateRootIdentity || !checkpointsRootIdentity || !partitionIdentity || !item.primaryIdentity) {\n    throw new Error(\"Checkpoint plan is missing directory identity evidence; checkpoint was preserved\");\n  }\n\n  const partitionPath = path.dirname(item.primaryFile);\n  const checkpointsPath = path.dirname(partitionPath);\n  const stateRootPath = path.dirname(checkpointsPath);\n  let stateFd: number | undefined;\n  let checkpointsFd: number | undefined;\n  let partitionFd: number | undefined;\n  let snapshotsFd: number | undefined;\n  let snapshotParentFd: number | undefined;\n  try {\n    stateFd = openDirectoryNoFollow(stateRootPath, stateRootIdentity);\n    checkpointsFd = openChildDirectory(stateFd, path.basename(checkpointsPath), checkpointsRootIdentity);\n    partitionFd = openChildDirectory(checkpointsFd, path.basename(partitionPath), partitionIdentity);\n\n    const recordName = path.basename(item.primaryFile);\n    const recordPath = procFdPath(partitionFd, recordName);\n    const recordStat = fs.lstatSync(recordPath);\n    if (!recordStat.isFile() || recordStat.isSymbolicLink() || statIdentity(recordStat) !== item.primaryIdentity) {\n      throw new Error(\"Checkpoint record changed since planning; checkpoint was preserved\");\n    }\n\n    if (item.checkpointSnapshotRelativePath) {\n      if (!item.checkpointSnapshotsIdentity || !item.checkpointSnapshotIdentity) {\n        throw new Error(\"Checkpoint plan is missing snapshot identity evidence; checkpoint was preserved\");\n      }\n      snapshotsFd = openChildDirectory(partitionFd, \"snapshots\", item.checkpointSnapshotsIdentity);\n      const openedSnapshot = openSnapshotParent(snapshotsFd, item.checkpointSnapshotRelativePath, item.checkpointSnapshotIdentity);\n      if (openedSnapshot.ownsParentFd) snapshotParentFd = openedSnapshot.parentFd;\n\n      // Remove the record only after every parent and the target snapshot have been pinned and checked.\n      fs.unlinkSync(recordPath);\n      removeConfinedTreeAt(openedSnapshot.parentFd, openedSnapshot.name, item.checkpointSnapshotIdentity);\n    } else {\n      fs.unlinkSync(recordPath);\n    }\n  } finally {\n    if (snapshotParentFd !== undefined) fs.closeSync(snapshotParentFd);\n    if (snapshotsFd !== undefined) fs.closeSync(snapshotsFd);\n    if (partitionFd !== undefined) fs.closeSync(partitionFd);\n    if (checkpointsFd !== undefined) fs.closeSync(checkpointsFd);\n    if (stateFd !== undefined) fs.closeSync(stateFd);\n  }\n}\n\nfunction executeRetentionLocked(plan: RetentionPlan, options: { dryRun?: boolean; timeBudgetMs?: number; deadline?: number }): GcExecutionResult {\n  const startTime = Date.now();\n  const dryRun = Boolean(options.dryRun);\n  const deadline = options.deadline !== undefined\n    ? options.deadline\n    : (options.timeBudgetMs !== undefined ? startTime + options.timeBudgetMs : undefined);\n\n  let deletedCount = 0;\n  let deletedBytes = 0;\n  const deletedItems: RetentionItem[] = [];\n  const errors: Array<{ path: string; error: string }> = [];\n  let timedOut = Boolean(plan.timedOut);\n\n  const byKind: Record<RetentionItemKind, { count: number; bytes: number }> = {\n    task: { count: 0, bytes: 0 },\n    session: { count: 0, bytes: 0 },\n    checkpoint: { count: 0, bytes: 0 },\n    flight: { count: 0, bytes: 0 },\n  };\n\n  const sessionsRemoved: string[] = [];\n\n  for (const item of plan.reclaimableItems) {\n    if (deadline && Date.now() >= deadline) {\n      timedOut = true;\n      break;\n    }\n\n    if (dryRun) {\n      deletedCount++;\n      deletedBytes += item.sizeBytes;\n      deletedItems.push(item);\n      byKind[item.kind].count++;\n      byKind[item.kind].bytes += item.sizeBytes;\n      continue;\n    }\n\n    if (item.kind === \"task\" || item.kind === \"session\") {\n      const identities = item.fileIdentities;\n      if (!identities || Object.entries(identities).some(([file, identity]) => fileIdentity(file) !== identity)) {\n        errors.push({ path: item.primaryFile, error: \"Record changed since planning; collection skipped\" });\n        continue;\n      }\n    }\n\n    if (item.kind === \"checkpoint\") {\n      try {\n        deleteCheckpointConfined(item);\n      } catch (err: any) {\n        errors.push({ path: item.primaryFile, error: err?.message || String(err) });\n        continue;\n      }\n\n      if (item.gitRef && item.workspace) {\n        try {\n          const configuredHookEnv = envWithoutConfiguredHooks(item.workspace, [\"reference-transaction\"]);\n          execFileSync(\n            \"git\",\n            [\n              \"-c\",\n              \"core.hooksPath=/dev/null\",\n              \"update-ref\",\n              \"-d\",\n              `refs/nexus/checkpoints/${item.id}`,\n            ],\n            {\n              cwd: item.workspace,\n              env: configuredHookEnv,\n              stdio: \"ignore\",\n            },\n          );\n        } catch {}\n      }\n\n      deletedCount++;\n      deletedBytes += item.sizeBytes;\n      deletedItems.push(item);\n      byKind[item.kind].count++;\n      byKind[item.kind].bytes += item.sizeBytes;\n      continue;\n    }\n\n    let success = true;\n    const durableTaskRecord = item.kind === \"task\" || item.kind === \"session\";\n\n    // For schema-2 task/session records, companion logs are part of the\n    // committed record. Ensure the primary directory is syncable before any\n    // mutation, including when the plan is collecting an orphan group.\n    if (durableTaskRecord) {\n      try {\n        fsyncDirectoryDurably(path.dirname(item.primaryFile));\n      } catch (err: any) {\n        errors.push({ path: path.dirname(item.primaryFile), error: err?.message || String(err) });\n        continue;\n      }\n    }\n\n    // Delete primary file\n    try {\n      if (fs.existsSync(item.primaryFile)) {\n        fs.unlinkSync(item.primaryFile);\n      }\n    } catch (err: any) {\n      success = false;\n      errors.push({ path: item.primaryFile, error: err?.message || String(err) });\n    }\n\n    // Make primary removal durable before removing its associated files. If\n    // syncing fails, preserve the companions so a surviving primary stays\n    // readable and retryable after recovery.\n    if (success && durableTaskRecord) {\n      try {\n        fsyncDirectoryDurably(path.dirname(item.primaryFile));\n      } catch (err: any) {\n        success = false;\n        errors.push({ path: path.dirname(item.primaryFile), error: err?.message || String(err) });\n     …1282 tokens truncated…leItems.some((item) => item.kind === \"checkpoint\"));\n    executeRetention(plan);\n    assert.equal(fs.existsSync(marker), false, \"gc executed a workspace git hook\");\n    assert.equal(fs.existsSync(path.join(workspace, \"configured-hook-ran\")), false, \"gc executed a configured Git hook\");\n    const refLookup = spawnSync(\"git\", [\"show-ref\", \"--verify\", \"--quiet\", ref], { cwd: workspace });\n    assert.equal(\n      refLookup.status,\n      1,\n      `git show-ref did not confirm ref deletion: ${refLookup.error?.message ?? refLookup.stderr?.toString()}`,\n    );\n  } finally {\n    if (previousGitConfigParameters === undefined) delete process.env.GIT_CONFIG_PARAMETERS;\n    else process.env.GIT_CONFIG_PARAMETERS = previousGitConfigParameters;\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\nimport { CheckpointManager } from \"../src/checkpoint.js\";\n\nfunction setup(): { root: string; workspace: string; marker: string; hook: string; restore: () => void } {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-hook-\"));\n  const home = path.join(root, \"home\");\n  const workspace = path.join(root, \"workspace\");\n  fs.mkdirSync(home, { recursive: true });\n  fs.mkdirSync(workspace, { recursive: true });\n  execFileSync(\"git\", [\"init\", \"-q\"], { cwd: workspace });\n  execFileSync(\"git\", [\"config\", \"user.email\", \"t@t.invalid\"], { cwd: workspace });\n  execFileSync(\"git\", [\"config\", \"user.name\", \"t\"], { cwd: workspace });\n  fs.writeFileSync(path.join(workspace, \"file.txt\"), \"x\\n\");\n  execFileSync(\"git\", [\"add\", \"file.txt\"], { cwd: workspace });\n  execFileSync(\"git\", [\"commit\", \"-qm\", \"base\"], { cwd: workspace });\n  const marker = path.join(root, \"hook-ran\");\n  const hook = path.join(workspace, \".git\", \"hooks\", \"reference-transaction\");\n  const postIndexHook = path.join(workspace, \".git\", \"hooks\", \"post-index-change\");\n  fs.writeFileSync(hook, `#!/bin/sh\\ntouch '${marker}'\\n`, { mode: 0o755 });\n  fs.chmodSync(hook, 0o755);\n  fs.writeFileSync(postIndexHook, `#!/bin/sh\\ntouch '${marker}'\\n`, { mode: 0o755 });\n  fs.chmodSync(postIndexHook, 0o755);\n  const previousHome = process.env.HOME;\n  process.env.HOME = home;\n  return {\n    root, workspace, marker, hook,\n    restore: () => {\n      process.env.HOME = previousHome;\n      fs.rmSync(root, { recursive: true, force: true });\n    },\n  };\n}\n\ntest(\"checkpoint creation does not execute a workspace git hook\", () => {\n  const env = setup();\n  try {\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"dirty\\n\");\n    // The changed-path index inspection (git show :path) can run a configured fsmonitor program.\n    const fsmonitorMarker = path.join(env.root, \"fsmonitor-ran\");\n    const fsmonitorScript = path.join(env.root, \"creation-fsmonitor.sh\");\n    fs.writeFileSync(fsmonitorScript, `#!/bin/sh\\ntouch '${fsmonitorMarker}'\\nexit 0\\n`, { mode: 0o755 });\n    fs.chmodSync(fsmonitorScript, 0o755);\n    execFileSync(\"git\", [\"config\", \"core.fsmonitor\", fsmonitorScript], { cwd: env.workspace });\n    const manager = new CheckpointManager(env.workspace);\n    manager.createCheckpoint(\"hook test\");\n    assert.equal(fs.existsSync(env.marker), false, \"checkpoint creation executed a workspace hook\");\n    assert.equal(fs.existsSync(fsmonitorMarker), false, \"checkpoint creation executed a workspace fsmonitor\");\n    const refs = execFileSync(\"git\", [\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"], {\n      cwd: env.workspace,\n      encoding: \"utf8\",\n    });\n    assert.match(refs, /refs\\/nexus\\/checkpoints\\//, \"the checkpoint ref was not created\");\n  } finally {\n    env.restore();\n  }\n});\n\ntest(\"checkpoint restore does not execute a workspace git hook\", () => {\n  const env = setup();\n  try {\n    fs.rmSync(env.hook, { force: true });\n    fs.rmSync(path.join(env.workspace, \".git\", \"hooks\", \"post-index-change\"), { force: true });\n    const manager = new CheckpointManager(env.workspace);\n    const cp = manager.createCheckpoint(\"hook restore\");\n    fs.writeFileSync(env.hook, `#!/bin/sh\\ntouch '${env.marker}'\\n`, { mode: 0o755 });\n    fs.chmodSync(env.hook, 0o755);\n    fs.writeFileSync(path.join(env.workspace, \".git\", \"hooks\", \"post-index-change\"), `#!/bin/sh\\ntouch '${env.marker}'\\n`, { mode: 0o755 });\n    fs.chmodSync(path.join(env.workspace, \".git\", \"hooks\", \"post-index-change\"), 0o755);\n    // Config-driven execution must stay off on restore as well: fsmonitor may run for the clean scan.\n    const fsmonitorScript = path.join(env.root, \"fsmonitor-canary.sh\");\n    fs.writeFileSync(fsmonitorScript, `#!/bin/sh\\ntouch '${env.marker}'\\nexit 0\\n`, { mode: 0o755 });\n    fs.chmodSync(fsmonitorScript, 0o755);\n    execFileSync(\"git\", [\"config\", \"core.fsmonitor\", fsmonitorScript], { cwd: env.workspace });\n    manager.restore(cp.id);\n    assert.equal(fs.existsSync(env.marker), false, \"checkpoint restore executed a workspace hook or fsmonitor\");\n  } finally {\n    env.restore();\n  }\n});\n\ntest(\"checkpoint diff does not execute repo-configured external diff or fsmonitor\", () => {\n  const env = setup();\n  try {\n    // The diff test is about config-driven programs, not hooks.\n    fs.rmSync(env.hook, { force: true });\n    fs.rmSync(path.join(env.workspace, \".git\", \"hooks\", \"post-index-change\"), { force: true });\n    const manager = new CheckpointManager(env.workspace);\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"first change\\n\");\n    const base = manager.createCheckpoint(\"diff base\");\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"second change\\n\");\n    const next = manager.createCheckpoint(\"diff next\");\n\n    const externalMarker = path.join(env.root, \"external-diff-ran\");\n    const fsmonitorMarker = path.join(env.root, \"fsmonitor-ran\");\n    const canary = path.join(env.root, \"diff-canary.sh\");\n    fs.writeFileSync(canary, `#!/bin/sh\\ntouch '${externalMarker}'\\ntouch '${fsmonitorMarker}'\\nexit 0\\n`, { mode: 0o755 });\n    fs.chmodSync(canary, 0o755);\n    execFileSync(\"git\", [\"config\", \"diff.external\", canary], { cwd: env.workspace });\n    execFileSync(\"git\", [\"config\", \"core.fsmonitor\", canary], { cwd: env.workspace });\n\n    const worktreeDiff = manager.getDiff(next.id);\n    const refDiff = manager.getDiff(next.id, base.id);\n    assert.equal(worktreeDiff.success, true, worktreeDiff.error);\n    assert.equal(refDiff.success, true, refDiff.error);\n    assert.equal(fs.existsSync(externalMarker), false, \"checkpoint diff executed diff.external\");\n    assert.equal(fs.existsSync(fsmonitorMarker), false, \"checkpoint diff executed core.fsmonitor\");\n  } finally {\n    env.restore();\n  }\n});\n\ntest(\"checkpoint operations do not execute hooks declared in repository config\", () => {\n  const env = setup();\n  try {\n    // Leave only configuration-declared hooks (Git 2.54+) in play.\n    fs.rmSync(env.hook, { force: true });\n    fs.rmSync(path.join(env.workspace, \".git\", \"hooks\", \"post-index-change\"), { force: true });\n    const gitVersion = execFileSync(\"git\", [\"--version\"], { cwd: env.workspace, encoding: \"utf8\" });\n    const version = gitVersion.match(/git version (\\d+)\\.(\\d+)/);\n    assert.ok(version, `could not parse Git version: ${gitVersion}`);\n    if (Number(version[1]) < 2 || (Number(version[1]) === 2 && Number(version[2]) < 54)) return;\n\n    const configuredMarker = path.join(env.root, \"configured-hook-ran\");\n    const included = path.join(env.root, \"configured-hooks.inc\");\n    fs.writeFileSync(\n      included,\n      `[hook \"checkpoint-reference\"]\\n\\tevent = reference-transaction\\n\\tcommand = touch '${configuredMarker}'\\n` +\n        `[hook \"checkpoint-index\"]\\n\\tevent = post-index-change\\n\\tcommand = touch '${configuredMarker}'\\n`\n    );\n    execFileSync(\"git\", [\"config\", \"--local\", \"include.path\", included], { cwd: env.workspace });\n\n    // Prove each event actually runs before testing that the manager suppresses it.\n    const probeRef = \"refs/nexus/checkpoints/config-hook-probe\";\n    execFileSync(\"git\", [\"update-ref\", probeRef, \"HEAD\"], { cwd: env.workspace });\n    assert.equal(fs.existsSync(configuredMarker), true, \"reference-transaction config hook precondition did not run\");\n    execFileSync(\"git\", [\"update-ref\", \"-d\", probeRef], { cwd: env.workspace });\n    fs.rmSync(configuredMarker, { force: true });\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"dirty for config hook precondition\\n\");\n    execFileSync(\"git\", [\"stash\", \"create\"], { cwd: env.workspace });\n    assert.equal(fs.existsSync(configuredMarker), true, \"post-index-change config hook precondition did not run\");\n    fs.rmSync(configuredMarker, { force: true });\n\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"dirty for checkpoint\\n\");\n    const manager = new CheckpointManager(env.workspace);\n    const cp = manager.createCheckpoint(\"config hook test\");\n    assert.equal(fs.existsSync(configuredMarker), false, \"checkpoint creation executed a configured hook\");\n    manager.restore(cp.id);\n    assert.equal(fs.existsSync(configuredMarker), false, \"checkpoint restore executed a configured hook\");\n    manager.pruneCheckpoints(0);\n    assert.equal(fs.existsSync(configuredMarker), false, \"checkpoint pruning executed a configured hook\");\n  } finally {\n    env.restore();\n  }\n});\n\ntest(\"checkpoint pruning does not execute a workspace git hook\", () => {\n  const env = setup();\n  try {\n    const manager = new CheckpointManager(env.workspace);\n    // Create without the hook present, then install it before pruning the ref.\n    fs.rmSync(env.hook, { force: true });\n    manager.createCheckpoint(\"hook prune\");\n    fs.writeFileSync(env.hook, `#!/bin/sh\\ntouch '${env.marker}'\\n`, { mode: 0o755 });\n    fs.chmodSync(env.hook, 0o755);\n    manager.pruneCheckpoints(0);\n    assert.equal(fs.existsSync(env.marker), false, \"checkpoint pruning executed a workspace hook\");\n  } finally {\n    env.restore();\n  }\n});\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17e71-922f-7ef3-a2c1-bcdcbd1f8423","create_time":1793123582.5932066}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
