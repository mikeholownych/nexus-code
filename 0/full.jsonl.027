ateRestorePendingError\"; }\n    24\t}\n    25\t\n    26\tfunction homePath(homeDir: string): string {\n    27\t  const canonical = fs.realpathSync(path.resolve(homeDir || process.env.HOME || os.homedir()));\n    28\t  if (!fs.statSync(canonical).isDirectory()) throw new Error(\"Nexus home is not a directory\");\n    29\t  return canonical;\n    30\t}\n    31\t\n    32\texport function stateRoot(home: string): string {\n    33\t  const processHome = fs.realpathSync(path.resolve(process.env.HOME || os.homedir()));\n    34\t  const requestedHome = fs.realpathSync(home);\n    35\t  if (process.env.NEXUS_STATE_DIR && requestedHome === processHome) return path.resolve(process.env.NEXUS_STATE_DIR);\n    36\t  return path.join(home, \".nexus\");\n    37\t}\n    38\tfunction controlRoot(home: string): string { return path.join(stateRoot(home), CONTROL_DIR); }\n    39\tfunction activePath(home: string): string { return path.join(controlRoot(home), ACTIVE_FILE); }\n    40\tfunction transactionPath(home: string, id: string): string {\n    41\t  if (!/^[0-9a-f-]{36}$/.test(id)) throw new Error(\"Invalid restore transaction identity\");\n    42\t  return path.join(controlRoot(home), TRANSACTIONS_DIR, id);\n    43\t}\n    44\t\n    45\tfunction cleanupOrphanTransactions(home: string): void {\n    46\t  const transactions = path.join(controlRoot(home), TRANSACTIONS_DIR);\n    47\t  if (!fs.existsSync(transactions)) return;\n    48\t  ensurePrivateDirectory(transactions);\n    49\t  if (readActive(home)) throw new Error(\"Cannot clean restore staging while a restore is active\");\n    50\t  for (const id of fs.readdirSync(transactions)) {\n   180\t    if (!fs.lstatSync(configEnv).isFile() || fs.realpathSync(configEnv) !== path.resolve(configEnv)) throw new Error(\"Configuration backup source is redirected\");\n   181\t    const backupDir = path.join(homeDir, \".config\", \"nexus\", \"backups\");\n   182\t    const backupDirExisted = fs.existsSync(backupDir);\n   183\t    fs.mkdirSync(backupDir, { recursive: true, mode: 0o700 });\n   184\t    if (fs.realpathSync(backupDir) !== path.resolve(backupDir)) throw new Error(\"Configuration backup directory is redirected\");\n   185\t    if (!backupDirExisted) syncDirectory(path.dirname(backupDir));\n   186\t    const backupFile = path.join(backupDir, `config.env.bak.${timestamp}`);\n   187\t    copyPrivateFileDurably(configEnv, backupFile, true, observer.bytesCopied);\n   188\t    observer.fileCopied();\n   189\t    result.configBackupPath = backupFile;\n   190\t  }\n   191\t\n   192\t  // 2. State backup\n   193\t  const stateDir = path.join(stateRoot(homeDir),);\n   194\t  if (fs.existsSync(stateDir)) {\n   195\t    const stateBackupsDir = path.join(stateDir, \"backups\");\n   196\t    const stateBackupsDirExisted = fs.existsSync(stateBackupsDir);\n   197\t    fs.mkdirSync(stateBackupsDir, { recursive: true, mode: 0o700 });\n   198\t    if (fs.realpathSync(stateBackupsDir) !== path.resolve(stateBackupsDir)) throw new Error(\"State backup directory is redirected\");\n   199\t    if (!stateBackupsDirExisted) syncDirectory(stateDir);\n   200\t    const backupDest = path.join(stateBackupsDir, `state-backup-${timestamp}`);\n   201\t    // Each timestamped backup is a single immutable attempt. Never merge into\n   202\t    // an existing directory left by a collision or interrupted prior attempt.\n   203\t    fs.mkdirSync(backupDest, { mode: 0o700 });\n   204\t    syncDirectory(stateBackupsDir);\n   205\t\n   206\t    // Snapshot all durable state, not just its index. Backup directories are\n   207\t    // excluded to avoid recursion; symbolic links are refused rather than read.\n   208\t    withDurableStoreGuards(homeDir, () => copyPrivateTree(stateDir, path.join(backupDest, \"state\"), new Set([\"backups\", \"restore-control\", STATE_RESTORE_PENDING_FILE]), observer));\n   209\t    const configDir = path.join(homeDir, \".config\", \"nexus\");\n   210\t    if (fs.existsSync(configDir)) copyPrivateTree(configDir, path.join(backupDest, \"config\"), new Set([\"backups\", STATE_RESTORE_PENDING_FILE]), observer);\n   211\t    const metadataPath = path.join(backupDest, \"backup.json\");\n   212\t    const metadataFd = fs.openSync(metadataPath, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | (fs.constants.O_NOFOLLOW ?? 0), 0o600);\n   213\t    try {\n   214\t      fs.writeFileSync(metadataFd, JSON.stringify({ formatVersion:1, kind:\"nexus-state-config\", createdAt:new Date().toISOString() }));\n   215\t      fs.fchmodSync(metadataFd, 0o600);\n   216\t      fs.fsyncSync(metadataFd);\n   217\t    } finally { fs.closeSync(metadataFd); }\n   218\t    syncDirectory(backupDest);\n   219\t\n   220\t    result.stateBackupDir = backupDest;\n   221\t  }\n   222\t\n   223\t  if (filesCopied > lastReportedFiles || bytesCopied > lastReportedBytes) onProgress?.({ filesCopied, bytesCopied });\n   224\t\n   225\t  return result;\n   525\t    const absolute = path.resolve(filePath);\n   526\t    const stat = fs.lstatSync(absolute);\n   527\t    return stat.isFile() && !stat.isSymbolicLink() && fs.realpathSync(absolute) === absolute;\n   528\t  } catch {\n   529\t    return false;\n   530\t  }\n   531\t}\n   532\t\n   533\tfunction atomicSymlinkSwap(targetFile: string, linkPath: string): void {\n   534\t  const launcher = fs.lstatSync(linkPath, { throwIfNoEntry:false });\n   535\t  if (launcher && !launcher.isSymbolicLink()) throw new Error(\"Upgrade launcher is not a symbolic link; refusing to replace it\");\n   536\t  const binDir = path.dirname(linkPath);\n   537\t  fs.mkdirSync(binDir, { recursive: true });\n   538\t  const tmpLink = path.join(binDir, `.nexus-link-recovery.${process.pid}.${Date.now()}`);\n   539\t  try {\n   540\t    fs.symlinkSync(targetFile, tmpLink);\n   541\t    fs.renameSync(tmpLink, linkPath);\n   542\t    syncDirectory(binDir);\n   543\t  } catch (err: any) {\n   544\t    try {\n   545\t      fs.unlinkSync(tmpLink);\n   546\t    } catch {}\n   547\t    throw err;\n   548\t  }\n   549\t}\n","exit_code":0,"duration":{"secs":0,"nanos":29225}},"started_at_ms":1793127210913,"completed_at_ms":1793127210914}}
