fs.readdirSync(workspaceRoot).filter(name => !before.has(name) && name.startsWith(\"nexus-eval-version-workspace-\")), [], \"version-probe workspace must be cleaned up\");\ncli/test/spine.test.ts:18:    workspaceRoot: \"/workspace\",\ncli/test/authority.test.ts:122:    const dummyContext: InvocationContext = { workspaceRoot: wsRoot, readOnly: true };\ncli/test/authority.test.ts:166:    const dummyContext: InvocationContext = { workspaceRoot: wsRoot };\ncli/test/authority.test.ts:193:    const dummyContext: InvocationContext = { workspaceRoot: wsRoot };\ncli/test/authority.test.ts:256:    const dummyContext: InvocationContext = { workspaceRoot: wsRoot };\ncli/test/authority.test.ts:284:    const dummyContext: InvocationContext = { workspaceRoot: wsRoot };\ncli/test/authority.test.ts:305:    const dummyContext: InvocationContext = { workspaceRoot: wsRoot };\ncli/test/authority.test.ts:375:      workspaceRoot: wsRoot,\ncli/test/authority.test.ts:436:      { workspaceRoot: wsRoot }\ncli/test/authority.test.ts:485:        { workspaceRoot: wsRoot, readOnly: true }\ncli/test/authority.test.ts:503:    const dummyContext: InvocationContext = { workspaceRoot: wsRoot, readOnly: true };\ncli/test/authority.test.ts:570:      { workspaceRoot: wsRoot, readOnly: true }\ncli/test/authority.test.ts:588:      { workspaceRoot: wsRoot, readOnly: true }\ncli/test/authority.test.ts:616:      { workspaceRoot: wsRoot, readOnly: true }\ncli/test/authority.test.ts:634:      { workspaceRoot: wsRoot, readOnly: true }\ncli/test/authority.test.ts:649:      { workspaceRoot: wsRoot, readOnly: true }\ncli/test/state.test.ts:491:      { workspaceRoot: gitRepoDir }\ncli/test/eval_integrity.test.ts:670:  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\ncli/test/eval_integrity.test.ts:671:  const tmpfs = fs.statfsSync(workspaceRoot);\ncli/test/eval_integrity.test.ts:672:  const ok = { cpuPercent: 100, memoryBytes: 256 * 1024 * 1024, tasks: 64, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\ncli/test/eval_integrity.test.ts:674:  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: \"/dev/shm\", storageBytes: shared.blocks * shared.bsize } }) ?? \"\", /dedicated tmpfs|exact mount point/);\ncli/test/eval_integrity.test.ts:676:  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: ROOT } }) ?? \"\", /tmpfs/);\ncli/test/eval_integrity.test.ts:677:  const nested = fs.mkdtempSync(path.join(workspaceRoot, \"nested-\"));\ncli/test/eval_integrity.test.ts:679:    assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: nested } }) ?? \"\", /exact mount point/);\ncli/test/eval_integrity.test.ts:690:  if (process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) assert.equal(isolation, null, \"the dedicated test tmpfs and kernel resource contract must pass preflight\");\ncli/test/eval_integrity.test.ts:692:  if (process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) {\ncli/test/eval_integrity.test.ts:696:    fs.chmodSync(workspaceRoot, 0o755);\ncli/test/eval_integrity.test.ts:700:      fs.chmodSync(workspaceRoot, restoreMode);\ncli/test/eval_integrity.test.ts:703:    fs.chmodSync(workspaceRoot, 0o731);\ncli/test/eval_integrity.test.ts:707:      fs.chmodSync(workspaceRoot, restoreMode);\ncli/test/eval_integrity.test.ts:709:    fs.chmodSync(workspaceRoot, 0o711);\ncli/test/eval_integrity.test.ts:713:      fs.chmodSync(workspaceRoot, restoreMode);\ncli/test/eval_integrity.test.ts:735:  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\ncli/test/eval_integrity.test.ts:736:  const tmpfs = fs.statfsSync(workspaceRoot);\ncli/test/eval_integrity.test.ts:737:  const resources = { cpuPercent: 20, memoryBytes, tasks: 16, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\ncli/test/eval_integrity.test.ts:738:  const ws = fs.mkdtempSync(path.join(resources.workspaceRoot, \"eval-resources-\"));\ncli/test/eval_integrity.test.ts:807:  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\ncli/test/eval_integrity.test.ts:808:  const tmpfs = fs.statfsSync(workspaceRoot);\ncli/test/eval_integrity.test.ts:809:  const resources = { cpuPercent: 20, memoryBytes: 256 * 1024 * 1024, tasks: 16, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\ncli/test/eval_integrity.test.ts:857:    const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? profile.workspaceRoot;\ncli/test/eval_integrity.test.ts:863:      workspaceRoot,\ncli/test/eval_integrity.test.ts:866:    workspace = fs.mkdtempSync(path.join(workspaceRoot, \"eval-contained-candidate-ws-\"));\n#!/usr/bin/env bash\n# Provision the qualification host (eval/host/README.md). Run as root on the qualification host only:\n#   sudo OPERATOR=<harness user> bash eval/host/provision.sh\n# Idempotent. Touches only: the acl package, the nexus-eval system account and its home, one sudoers drop-in, one\n# systemd mount unit for the tmpfs workspace root (and the root's parent directory if absent), and /opt/nexus-qual.\n# Fail-closed on collisions: a pre-existing account, sudoers file, unit, runtime directory or mount that this procedure\n# did not create stops the run unchanged. Every creation is first recorded as `pending <kind> <value>` in a root-only\n# ledger and then confirmed, so an interrupted run can be resumed or rolled back; rollback.sh removes only resources the\n# ledger names and that still verifiably belong to this procedure.\nset -euo pipefail\n\nHERE=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nreadonly HERE\nreadonly PROFILE=\"$HERE/resource-profile.json\"\nreadonly ACCOUNT=nexus-eval\nreadonly ACCOUNT_HOME=/var/lib/nexus-eval\nreadonly SUDOERS=/etc/sudoers.d/99-nexus-eval\nreadonly LEGACY_SUDOERS=/etc/sudoers.d/90-nexus-eval\nreadonly RUNTIME=/opt/nexus-qual\nreadonly LEDGER_DIR=/var/lib/nexus-qual-host\nreadonly LEDGER=\"$LEDGER_DIR/ledger\"\nreadonly MARKER=\"# Managed by nexus-code eval/host/provision.sh\"\nreadonly RUNTIME_MARKER=\"$RUNTIME/.nexus-qual-managed\"\n\n[[ $EUID -eq 0 ]] || { echo \"run as root\" >&2; exit 2; }\n: \"${OPERATOR:?set OPERATOR to the account that runs eval/run.mjs}\"\n[[ \"$OPERATOR\" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { echo \"operator name is not a plain user name\" >&2; exit 2; }\nid -u \"$OPERATOR\" >/dev/null 2>&1 || { echo \"operator $OPERATOR does not exist\" >&2; exit 2; }\n[[ \"$OPERATOR\" != \"$ACCOUNT\" && \"$OPERATOR\" != root ]] || { echo \"operator must be a separate, non-root account\" >&2; exit 2; }\ncommand -v jq >/dev/null || { echo \"jq is required to read $PROFILE\" >&2; exit 2; }\nworkspace_root=$(jq -er .workspaceRoot \"$PROFILE\")\nstorage_bytes=$(jq -er .storageBytes \"$PROFILE\")\n[[ \"$workspace_root\" =~ ^/srv/[a-z0-9-]+/[a-z0-9-]+$ && \"$storage_bytes\" =~ ^[0-9]+$ ]] || { echo \"unexpected profile values\" >&2; exit 2; }\nworkspace_parent=\"$(dirname \"$workspace_root\")\"\nunit=\"$(systemd-escape -p --suffix=mount \"$workspace_root\")\"\nunit_file=\"/etc/systemd/system/$unit\"\nop_uid=$(id -u \"$OPERATOR\"); op_gid=$(id -g \"$OPERATOR\")\n\nif [[ -e \"$LEDGER_DIR\" || -L \"$LEDGER_DIR\" ]]; then\n  [[ ! -L \"$LEDGER_DIR\" && -d \"$LEDGER_DIR\" && \"$(stat -c %u:%g:%a \"$LEDGER_DIR\")\" == \"0:0:700\" ]] || { echo \"unsafe ledger directory $LEDGER_DIR\" >&2; exit 1; }\nfi\nfor f in \"$LEDGER_DIR/lock\" \"$LEDGER\"; do\n  if [[ -e \"$f\" || -L \"$f\" ]]; then\n    [[ ! -L \"$f\" && -f \"$f\" && \"$(stat -c %u:%g \"$f\")\" == \"0:0\" ]] || { echo \"unsafe ledger file $f\" >&2; exit 1; }\n  fi\ndone\ninstall -d -o root -g root -m 0700 \"$LEDGER_DIR\"\nexec 9>\"$LEDGER_DIR/lock\"\nflock -n 9 || { echo \"another provision or rollback is running\" >&2; exit 1; }\ntouch \"$LEDGER\"; chmod 0600 \"$LEDGER\"\nhas() { grep -qxF \"$1\" \"$LEDGER\"; }\nsha() { sha256sum < \"$1\" | awk '{print $1}'; }\npending() { has \"pending $1\" || printf 'pending %s\\n' \"$1\" >> \"$LEDGER\"; }\n# Rewrite the ledger without line $1 (atomic, root-only).\ndrop() { local tmp; tmp=\"$(mktemp \"$LEDGER_DIR/.ledger.XXXXXX\")\"; grep -vxF \"$1\" \"$LEDGER\" > \"$tmp\" || true; chmod 0600 \"$tmp\"; mv \"$tmp\" \"$LEDGER\"; }\nconfirm() { drop \"pending $1\"; has \"$1\" || printf '%s\\n' \"$1\" >> \"$LEDGER\"; }\n# A written file is recorded with its digest; earlier digests for the same path are replaced.\nrecord_file() {\n  local tmp; tmp=\"$(mktemp \"$LEDGER_DIR/.ledger.XXXXXX\")\"\n  # Exact field comparison via ENVIRON (paths contain backslashes, e.g. systemd's \\x2d escapes).\n  P=\"$1\" awk '!(($1 == \"file\" && $2 == ENVIRON[\"P\"]) || ($1 == \"pending\" && $2 == \"file\" && $3 == ENVIRON[\"P\"]))' \"$LEDGER\" > \"$tmp\"\n  printf 'file %s sha256=%s\\n' \"$1\" \"$(sha \"$1\")\" >> \"$tmp\"; chmod 0600 \"$tmp\"; mv \"$tmp\" \"$LEDGER\"\n}\naccount_line() { printf 'account %s uid=%s home=%s' \"$ACCOUNT\" \"$(id -u \"$ACCOUNT\")\" \"$ACCOUNT_HOME\"; }\nours_account() {   # recorded (or pending from an interrupted run) and still the same account\n  id -u \"$ACCOUNT\" >/dev/null 2>&1 || return 1\n  has \"$(account_line)\" && return 0\n  has \"pending account $ACCOUNT\" && [[ \"$(getent passwd \"$ACCOUNT\" | cut -d: -f6,7)\" == \"$ACCOUNT_HOME:/usr/sbin/nologin\" ]]\n}\n# A file is ours only if it is a regular file with the marker whose content is what we last wrote (or was in flight).\nours_file() {\n  [[ -f \"$1\" && ! -L \"$1\" ]] && head -n 1 \"$1\" | grep -qxF \"$MARKER\" || return 1\n  has \"file $1 sha256=$(sha \"$1\")\" || has \"pending file $1\"\n}\n# A directory is ours only once confirmed; a pending entry never adopts a directory that exists.\nours_dir() { has \"dir $1\"; }\n# Collision checks first: nothing is changed unless every resource is absent or verifiably ours.\nproblems=()\nif id -u \"$ACCOUNT\" >/dev/null 2>&1 && ! ours_account; then problems+=(\"account $ACCOUNT exists but was not created by this procedure\"); fi\nif [[ -e \"$ACCOUNT_HOME\" ]] && ! id -u \"$ACCOUNT\" >/dev/null 2>&1 && has \"pending account $ACCOUNT\"; then\n  problems+=(\"an interrupted run left $ACCOUNT_HOME without the $ACCOUNT account; inspect it, remove it by hand, then re-run\")\nelif [[ -e \"$ACCOUNT_HOME\" ]] && ! ours_account; then problems+=(\"$ACCOUNT_HOME exists but was not created by this procedure\"); fi\nfor file in \"$SUDOERS\" \"$unit_file\"; do\n  if [[ -e \"$file\" || -L \"$file\" ]] && ! ours_file \"$file\"; then problems+=(\"$file exists (or is a symlink) and is not this procedure's\"); fi\ndone\nfor dir in \"$workspace_parent\" \"$workspace_root\"; do\n  if [[ -L \"$dir\" ]] || { [[ -e \"$dir\" ]] && [[ \"$(realpath \"$dir\")\" != \"$dir\" ]]; }; then problems+=(\"$dir is or passes through a symlink\"); fi\ndone\nif findmnt --mountpoint \"$workspace_root\" >/dev/null && ! ours_file \"$unit_file\"; then problems+=(\"$workspace_root is already a mount point not made by this procedure\"); fi\nif [[ -e \"$LEGACY_SUDOERS\" || -L \"$LEGACY_SUDOERS\" ]] && ! ours_file \"$LEGACY_SUDOERS\"; then problems+=(\"$LEGACY_SUDOERS exists (or is a symlink) and is not this procedure's\"); fi\nif [[ -e \"$workspace_root\" ]] && ! ours_dir \"$workspace_root\" && [[ -n \"$(ls -A \"$workspace_root\" 2>/dev/null)\" ]]; then problems+=(\"$workspace_root exists and is not empty\"); fi\nif [[ -e \"$RUNTIME\" ]] && ! ours_dir \"$RUNTIME\"; then problems+=(\"$RUNTIME exists but was not created by this procedure\"); fi\nif ((${#problems[@]})); then printf 'refusing to provision (no changes made):\\n' >&2; printf '  - %s\\n' \"${problems[@]}\" >&2; exit 1; fi\n\n# Drop stale pending directory entries only after every collision check succeeds.\nwhile IFS= read -r line; do\n  path=\"${line#pending dir }\"\n  [[ -e \"$path\" || -L \"$path\" ]] && drop \"$line\"\ndone < <(grep '^pending dir ' \"$LEDGER\" || true)\nif ours_file \"$LEGACY_SUDOERS\"; then legacy_sha=$(sha \"$LEGACY_SUDOERS\"); rm -f \"$LEGACY_SUDOERS\"; drop \"file $LEGACY_SUDOERS sha256=$legacy_sha\"; drop \"pending file $LEGACY_SUDOERS\"; fi\n\n# 1. setfacl, which the harness uses to grant the evaluator uid access to each disposable run directory.\nif ! command -v setfacl >/dev/null; then\n  apt-get update -qq\n  NEEDRESTART_SUSPEND=1 DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends acl\n  confirm \"package acl\"\nfi\n\n# 2. The evaluator account: a system user with no login shell and a private home it never needs for runs.\nif ! id -u \"$ACCOUNT\" >/dev/null 2>&1; then\n  free_uid=\"\"\n  for u in $(seq 985 -1 900); do\n    if ! id -u \"$u\" >/dev/null 2>&1 && ! pgrep -u \"$u\" >/dev/null 2>&1; then free_uid=\"$u\"; break; fi\n  done\n  [[ -n \"$free_uid\" ]] || { echo \"no free system uid in 900..985\" >&2; exit 1; }\n  pending \"account $ACCOUNT\"\n  useradd --system --uid \"$free_uid\" --home-dir \"$ACCOUNT_HOME\" --create-home --shell /usr/sbin/nologin \"$ACCOUNT\"\nfi\nif has \"pending account $ACCOUNT\"; then confirm \"$(account_line)\"; drop \"pending account $ACCOUNT\"; fi\nchmod 0700 \"$ACCOUNT_HOME\"\n\n# 3. The only privilege: the operator may run Bubblewrap as the evaluator account, without a password. The harness\n#    invokes exactly `sudo -n -u nexus-eval -- /usr/bin/bwrap …` (eval/validate.mjs asUser).\ntmp=\"$(mktemp)\"\nprintf '%s\\n%s ALL=(%s) !ALL\\n%s ALL=(%s) NOPASSWD: REDACTED' \"$MARKER\" \"$OPERATOR\" \"$ACCOUNT\" \"$OPERATOR\" \"$ACCOUNT\" > \"$tmp\"\nvisudo -cqf \"$tmp\"\npending \"file $SUDOERS\"\ninstall -o root -g root -m 0440 \"$tmp\" \"$SUDOERS\"\nrm -f \"$tmp\"\n# The whole configuration must still parse; never leave a drop-in that breaks sudo.\nvisudo -cq || { rm -f \"$SUDOERS\"; echo \"sudoers no longer parses with $SUDOERS; removed it\" >&2; exit 1; }\nrecord_file \"$SUDOERS\"\n\n# 4. The size-capped tmpfs workspace root, owned by the operator. Mode 0711 lets the evaluator traverse to the per-run\n#    directories the harness creates (0700, random names, evaluator ACL) without listing the root; it persists across\n#    remounts, unlike an ACL on the tmpfs root.\nfor dir in \"$workspace_parent\" \"$workspace_root\"; do\n  if [[ ! -e \"$dir\" ]]; then pending \"dir $dir\"; mkdir \"$dir\"; confirm \"dir $dir\"; fi\ndone\npending \"file $unit_file\"\nrm -f \"$unit_file\"   # never write through a link\ncat > \"$unit_file\" <<EOF\n$MARKER\n[Unit]\nDescription=Nexus qualification workspace root (size-capped tmpfs)\n\n[Mount]\nWhat=tmpfs\nWhere=$workspace_root\nType=tmpfs\nOptions=size=$storage_bytes,mode=0711,uid=$op_uid,gid=$op_gid,nosuid,nodev\n\n[Install]\nWantedBy=local-fs.target\nEOF\nrecord_file \"$unit_file\"\nsystemctl daemon-reload\nsystemctl enable \"$unit\" >/dev/null\n# start, never restart: remounting a tmpfs would discard any run in progress.\nsystemctl start \"$unit\"\nlive=\"$(findmnt -n -b -o FSTYPE,SIZE --mountpoint \"$workspace_root\" | tr -s \" \") $(stat -c '%u %a' \"$workspace_root\")\"\n[[ \"$live\" == \"tmpfs $storage_bytes $op_uid 711\" ]] || { echo \"mounted $workspace_root is '$live', not 'tmpfs $storage_bytes $op_uid 711'; run rollback.sh, then provision again\" >&2; exit 1; }\n\n# 5. Root-owned, world-readable home for the installed RC and peer agents (sandboxRuntimeRoots); filled per RC.\nif [[ ! -e \"$RUNTIME\" ]]; then pending \"dir $RUNTIME\"; install -d -o root -g root -m 0755 \"$RUNTIME\"; : > \"$RUNTIME_MARKER\"; confirm \"dir $RUNTIME\"; fi\n\nprintf 'operator=%s\\naccount=%s\\nunit=%s\\nprofile_sha256=%s\\nat=%s\\n' \"$OPERATOR\" \"$ACCOUNT\" \"$unit\" \\\n  \"$(sha256sum \"$PROFILE\" | cut -d' ' -f1)\" \"$(date -u +%FT%TZ)\" > \"$LEDGER_DIR/state\"\necho \"provisioned: $ACCOUNT, $SUDOERS, $unit ($storage_bytes bytes), $RUNTIME; ledger $LEDGER\"\n# Qualification host\n\nThis directory is the reviewable procedure for preparing the host that runs `eval/run.mjs` for v1 qualification\n(ACCEPTANCE §6). The host is `mike-dev`: 12 cores (Xeon X5650, no SMT), 46 GiB RAM, 16 GiB swap, kernel 6.8,\nsystemd 255, cgroup v2 with `cpu memory pids` delegated to the operator's user manager. Inference is remote (the\nhomelab-ai gateway, DEC-16), so this host's CPU and memory serve only the agents, their builds and the tests.\n\nNothing here touches the inference appliance, the gateway, the firewall, model workers, credentials or other\nservices. The changes are limited to the following:\n\n| Change | File or object | Why |\n|---|---|---|\n| Install `acl` | apt package | `setfacl` grants the evaluator uid access to each disposable run directory (`grantRunAsAccess`). |\n| System account `nexus-eval` | `/etc/passwd`, `/var/lib/nexus-eval` (0700), shell `nologin` | The candidate and validators run as a uid that cannot read the operator's files or the held-out store. |\n| One sudoers rule | `/etc/sudoers.d/90-nexus-eval`: `<operator> ALL=(nexus-eval) NOPASSWD: /usr/bin/bwrap` | The harness's only privilege. No `env`, no shell, no other command. |\n| Size-capped tmpfs | `srv-nexus\\x2dqual-ws.mount` at `/srv/nexus-qual/ws`, `size=storageBytes,mode=0711,uid=<operator>,nosuid,nodev` | The resource contract's `workspaceRoot`: the hard cap on what a run keeps, across all phases. |\n| Runtime directory | `/opt/nexus-qual` (root, 0755) | `sandboxRuntimeRoots` for the installed RC and the peer agents. It is filled per RC. |\n\n- `/usr/bin/bwrap` must report upstream version 0.12.0 or later (CVE-2026-87766). `validate.mjs` cannot detect distro backports, so it also rejects older vendor-patched builds. Ubuntu 24.04 `0.9.0-1ubuntu0.3` removed the fix. Install a release with the fix before qualification; `scripts/ensure-ci-bubblewrap.sh` shows the pinned source build that CI uses. `provision.sh` does not replace the binary.\n- `provision.sh` applies these changes and is idempotent. It never remounts an active tmpfs.\n- `rollback.sh` removes them. It keeps `/opt/nexus-qual` unless you pass `--purge-runtime`, and it leaves `acl` installed.\n- `validate.mjs`, run as the operator, proves the result using infrastructure fixtures only.\n\n```sh\nsudo OPERATOR=mike bash eval/host/provision.sh\nnode eval/host/validate.mjs --heldout <sealed task store> --json docs/reviews/evidence/v1-qualification/host/validate-$(date -u +%Y%m%dT%H%MZ).json\n# undo: sudo bash eval/host/rollback.sh\n```\n\n`eval/host/container-test/run.sh` exercises provision and rollback as root in a disposable privileged container:\nfresh and repeated runs, rollback, refusal of a foreign account, sudoers file or symlinked root (with no changes),\nrecovery from an interrupted run, and rollback leaving a re-created account alone. Every line must read PASS.\n\n`validate.mjs` uses the operator's own root sudo for two probes of the custodian's root-owned store: that it\nexists, and which file to try reading as the evaluator. The file's name is used but never printed or stored. These\nprobes need the operator's general sudo, not the narrow evaluator rule.\n\nThe harness's `asUser` invokes `/usr/bin/sudo -n -u nexus-eval -- /usr/bin/bwrap …` directly. sudo's `env_reset`\nand Bubblewrap's `--clearenv` clear the environment, so the rule names only `/usr/bin/bwrap`. This host's sudo PAM\nstack (`common-session-noninteractive`) does not load `pam_systemd`, so a process switched to `nexus-eval` stays in the\nrun's cgroup. `validate.mjs` checks this.\n\n## Resource profile\n\n`resource-profile.json` holds the values. The three frozen T2 configs and every T3/T4 config embed them as their\n`resources` object, byte-identical. `score.mjs --pairs` refuses comparisons whose manifests differ.\n\nCustodian calibration across all 40 sealed T2 reference solutions passed 40/40 under this profile:\n`maxMemoryPeakMiB` 1206.5, `maxPidsPeak` 163, `maxWorkspaceMiB` 225.0, `oomKills` 0, and `pidsMaxEvents` 0.\n\n| Key | Frozen | Exact kernel meaning |\n|---|---|---|\n| `cpuPercent` | 800 | `cpu.max = 800000 100000`. The payload's processes may together use at most 8 CPUs' worth of runtime per wall-clock second. This is **rate throttling, not a total budget**. Total CPU time is bounded only by the phase's wall-clock limit times 8, and each phase's `cpuUsageUsec` and `cpuThrottledUsec` are recorded. |\n| `memoryBytes` | 16 GiB | `memory.max`, with `memory.swap.max = 0` and `memory.oom.group = 1`. The charge counts the phase's anonymous memory, the page cache it faults in (reclaimable before OOM), **and the tmpfs pages it writes**. A phase that writes 6 GiB of build output therefore has about 10 GiB left for its processes. Exceeding the limit OOM-kills the whole phase, and this is recorded. |\n| `tasks` | 4096 | `pids.max`. This counts threads, not just processes: Go test binaries, `cargo` with parallel `rustc`, and Node/Bun worker threads all consume tasks. |\n| `storageBytes` | 20 GiB | The size of the dedicated tmpfs. It caps everything a run holds in its workspace and home **across phases**, because when a phase's cgroup is removed, its tmpfs charges move to the unlimited parent. Writes beyond the cap fail with `ENOSPC`. Runs are serial, and each run's directories are removed afterwards. |\n\n### Why these values\n\n- **Fairness.** Nexus, Goose and OpenCode get identical limits. Each agent's own process is small next to them: OpenCode\n  about 1.1 GiB RSS, the others less, as observed on this host. No agent is systematically starved.\n- **CPU.** Eight of the twelve cores leave four for the harness, the model proxy, the OS and the box's other tenants.\n  Then load from those tenants cannot change a run's available CPU. The X5650 is slow, so the throttle is set\n  high enough not to bind on a normal build.\n- **Memory and threads.** Sized for the heaviest language class in the corpus, Rust test builds, where parallel `rustc`\n  plus a multi-GiB target directory on tmpfs both count. The measurement below records this repository's own\n  `core` crate under the contract as a lower-bound reference.\n- **Storage.** The worst-case RAM is a full tmpfs plus a phase at its memory limit: 20 + 16 = 36 GiB. Together with\n  about 7 GiB of other host use (`free` on 2026-10-18 09:40Z: 7 GiB used, 39 GiB available), that stays below the\n  46 GiB of physical memory. The margin is only about 3 GiB, so the other host load is re-measured and recorded in\n  the run record before each qualification window. If that load grows, the box can reach swap.\n\n### Freezing\n\n1. **Calibration (custodian, before freeze).** The custodian validates every sealed task's reference solution under\n   this profile and reports only aggregates: pass count; maximum `memoryPeakBytes`, `pidsPeak` and workspace bytes\n   across phases; any OOM, pids or ENOSPC event; and the longest phase wall time under the 8-CPU throttle, compared\n   with the task's budget. Agents rebuild repeatedly, unlike a single reference build, so the storage headroom is\n   checked against a reference build repeated three times in one workspace. If a reference fails because of a limit, the limit is raised, the\n   change is recorded, and calibration is repeated. No candidate result is involved.\n2. **Freeze.** Set `\"status\": \"frozen\"`, commit, and record the profile's SHA-256 in the frozen run record\n   (ACCEPTANCE §6.1) before the first qualification run.\n3. **After freeze.** Values never change in response to qualification outcomes. A change for any reason after the\n   first scored run invalidates the affected runs. They are kept as evidence and rerun.\n","exit_code":0,"duration":{"secs":0,"nanos":813702527}},"started_at_ms":1793137933248,"completed_at_ms":1793137934062}}
{"timestamp":"2026-10-27T21:52:15.154Z","ordinal":428400,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17f59-8332-7891-9833-e60d44957f72","call_id":"call_313765e9601e474cb92dcb071afbf2c0","output":[{"type":"input_text","text":"Script completed\nWall time 3.1 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 7339)\nTotal output lines: 346\n\n.github/workflows/release.yml:34:          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\neval/README.md:242:A config's `resources` object — `{ \"cpuPercent\", \"memoryBytes\", \"tasks\", \"storageBytes\", \"workspaceRoot\" }` — applies to every\neval/README.md:251:- `workspaceRoot` must itself be a dedicated tmpfs mount, not a directory on a shared mount or a bind mount. It must be\neval/resources.mjs:17:  if (!resources || typeof resources !== \"object\") return \"resources must set cpuPercent, memoryBytes, tasks, storageBytes and workspaceRoot\";\neval/resources.mjs:18:  const { cpuPercent, memoryBytes, tasks, storageBytes, workspaceRoot } = resources;\neval/resources.mjs:23:  if (typeof workspaceRoot !== \"string\" || !path.isAbsolute(workspaceRoot)) return \"resources.workspaceRoot must be an absolute path\";\neval/resources.mjs:25:  try { stat = fs.statfsSync(workspaceRoot); }\neval/resources.mjs:26:  catch { return \"resources.workspaceRoot is unavailable\"; }\neval/resources.mjs:27:  if (stat.type !== TMPFS_MAGIC) return \"resources.workspaceRoot must be on a tmpfs so candidate writes are charged to the run's memory limit\";\neval/resources.mjs:28:  const mountProblem = dedicatedTmpfsMountProblem(workspaceRoot);\neval/resources.mjs:30:  if (stat.blocks * stat.bsize > storageBytes) return `resources.workspaceRoot tmpfs is ${stat.blocks * stat.bsize} bytes; mount a dedicated tmpfs with size<=storageBytes (${storageBytes})`;\neval/resources.mjs:35:export function dedicatedTmpfsMountProblem(workspaceRoot, mountInfoText = null) {\neval/resources.mjs:38:  catch { return \"resources.workspaceRoot mount table is unavailable; refusing unverified workspace storage limits\"; }\neval/resources.mjs:40:  const expected = path.resolve(workspaceRoot);\neval/resources.mjs:45:  if (matching.length > 1) return \"resources.workspaceRoot has stacked or duplicate mount records; refusing ambiguous workspace storage boundary\";\neval/resources.mjs:47:  if (!line) return \"resources.workspaceRoot must be the exact mount point of a dedicated tmpfs, not a subdirectory\";\neval/resources.mjs:51:    return \"resources.workspaceRoot must be its own tmpfs mount, not a shared or bind-mounted filesystem\";\neval/resources.mjs:60:  if (aliases.length > 0) return \"resources.workspaceRoot tmpfs is also mounted elsewhere; bind/shared mounts are not allowed\";\neval/resources.mjs:70:  catch { return \"resources.workspaceRoot mount root cannot be inspected; refusing unverified workspace permissions\"; }\n.github/workflows/ci.yml:32:          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n.github/workflows/ci.yml:97:          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\ncli/test/eval_harness.test.ts:289:    config: { name: `${agent}@engineering/deep`, agent, model: \"engineering/deep\", qualification: true, limits: { context: 65536, output: 8192, requests: 200, totalOutput: 100_000 }, resources: { cpuPercent: 800, memoryBytes: 17179869184, tasks: 4096, storageBytes: 21474836480, workspaceRoot: \"/srv/nexus-qual/ws\" }, sampling: { temperature: 0, seed: 17 }, ...(agent === \"nexus\" ? { nexusPackageSha256: \"d\".repeat(64) } : {}), ...(overrides.config as object ?? {}) },\ncli/test/eval…5739 tokens truncated… | `memory.max`, with `memory.swap.max = 0` and `memory.oom.group = 1`. The charge counts the phase's anonymous memory, the page cache it faults in (reclaimable before OOM), **and the tmpfs pages it writes**. A phase that writes 6 GiB of build output therefore has about 10 GiB left for its processes. Exceeding the limit OOM-kills the whole phase, and this is recorded. |\n| `tasks` | 4096 | `pids.max`. This counts threads, not just processes: Go test binaries, `cargo` with parallel `rustc`, and Node/Bun worker threads all consume tasks. |\n| `storageBytes` | 20 GiB | The size of the dedicated tmpfs. It caps everything a run holds in its workspace and home **across phases**, because when a phase's cgroup is removed, its tmpfs charges move to the unlimited parent. Writes beyond the cap fail with `ENOSPC`. Runs are serial, and each run's directories are removed afterwards. |\n\n### Why these values\n\n- **Fairness.** Nexus, Goose and OpenCode get identical limits. Each agent's own process is small next to them: OpenCode\n  about 1.1 GiB RSS, the others less, as observed on this host. No agent is systematically starved.\n- **CPU.** Eight of the twelve cores leave four for the harness, the model proxy, the OS and the box's other tenants.\n  Then load from those tenants cannot change a run's available CPU. The X5650 is slow, so the throttle is set\n  high enough not to bind on a normal build.\n- **Memory and threads.** Sized for the heaviest language class in the corpus, Rust test builds, where parallel `rustc`\n  plus a multi-GiB target directory on tmpfs both count. The measurement below records this repository's own\n  `core` crate under the contract as a lower-bound reference.\n- **Storage.** The worst-case RAM is a full tmpfs plus a phase at its memory limit: 20 + 16 = 36 GiB. Together with\n  about 7 GiB of other host use (`free` on 2026-10-18 09:40Z: 7 GiB used, 39 GiB available), that stays below the\n  46 GiB of physical memory. The margin is only about 3 GiB, so the other host load is re-measured and recorded in\n  the run record before each qualification window. If that load grows, the box can reach swap.\n\n### Freezing\n\n1. **Calibration (custodian, before freeze).** The custodian validates every sealed task's reference solution under\n   this profile and reports only aggregates: pass count; maximum `memoryPeakBytes`, `pidsPeak` and workspace bytes\n   across phases; any OOM, pids or ENOSPC event; and the longest phase wall time under the 8-CPU throttle, compared\n   with the task's budget. Agents rebuild repeatedly, unlike a single reference build, so the storage headroom is\n   checked against a reference build repeated three times in one workspace. If a reference fails because of a limit, the limit is raised, the\n   change is recorded, and calibration is repeated. No candidate result is involved.\n2. **Freeze.** Set `\"status\": \"frozen\"`, commit, and record the profile's SHA-256 in the frozen run record\n   (ACCEPTANCE §6.1) before the first qualification run.\n3. **After freeze.** Values never change in response to qualification outcomes. A change for any reason after the\n   first scored run invalidates the affected runs. They are kept as evidence and rerun.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17ef2-de25-7482-bff6-192772052d26","create_time":1793137935.1542423}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
