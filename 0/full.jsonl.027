", \"--verify\", \"--quiet\", `refs/nexus/checkpoints/${checkpoint.id}`], {\n+        cwd: env.workspace,\n+        stdio: \"ignore\",\n+      }) === undefined,\n+      true,\n+      \"failed pruning deleted the checkpoint ref\",\n+    );\n+  } finally {\n+    process.env.PATH = previousPath;\n+    if (previousRealGit === undefined) delete process.env.REAL_GIT;\n+    else process.env.REAL_GIT = previousRealGit;\n+    env.restore();\n+  }\n+});\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /home/mike/nexus-wt/configured-hook-race-retention-errors-20261027/cli/test/checkpoint_git_hook.test.ts\n","stderr":""},"started_at_ms":1793124961994,"completed_at_ms":1793124962091}}
