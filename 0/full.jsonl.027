{"timestamp":"2026-10-27T18:04:23.347Z","ordinal":421024,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17e71-922f-7ef3-a2c1-bcdcbd1f8423","item":{"type":"CommandExecution","id":"exec-f25fb109-a66b-45b9-9189-91b4904d8a24","process_id":"60359","command":["/usr/bin/zsh","-lc","sed -n '1,100p' cli/src/core/git_hook_guard.ts && sed -n '1,210p' cli/test/retention_git_hook.test.ts && sed -n '100,175p' cli/test/checkpoint_git_hook.test.ts && rg -n 'GIT_CONFIG_PARAMETERS|enabled=false|reference-transaction' cli/src cli/test"],"cwd":"file:///home/mike/nexus-wt/configured-hook-race-retention-errors-20261027","parsed_cmd":[{"type":"read","cmd":"sed -n '1,100p' cli/src/core/git_hook_guard.ts","name":"git_hook_guard.ts","path":"cli/src/core/git_hook_guard.ts"},{"type":"read","cmd":"sed -n '1,210p' cli/test/retention_git_hook.test.ts","name":"retention_git_hook.test.ts","path":"cli/test/retention_git_hook.test.ts"},{"type":"read","cmd":"sed -n '100,175p' cli/test/checkpoint_git_hook.test.ts","name":"checkpoint_git_hook.test.ts","path":"cli/test/checkpoint_git_hook.test.ts"},{"type":"search","cmd":"rg -n 'GIT_CONFIG_PARAMETERS|enabled=false|reference-transaction' cli/src cli/test","query":"GIT_CONFIG_PARAMETERS|enabled=false|reference-transaction","path":"cli"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/** Quote one value for Git's GIT_CONFIG_PARAMETERS shell-like list. */\nfunction quoteConfigValue(value: string): string {\n  return `'${value.replace(/'/g, `'\\\\''`)}'`;\n}\n\n/**\n * Environment for a Git command that must not run hooks declared in repository config\n * (`hook.<name>.event` / `.command`, Git 2.54+). Such hooks are not disabled by\n * `core.hooksPath` and outrank `GIT_CONFIG_COUNT`, so their `hook.<name>.enabled=false`\n * overrides are appended to `GIT_CONFIG_PARAMETERS`, Git's own command-line channel.\n *\n * Disable every configured hook for each requested event. Looking up the current friendly\n * hook names first would leave a race where workspace-controlled config could add a new hook\n * between discovery and the protected Git operation. Git's event-level switch closes that gap.\n */\nexport function envWithoutConfiguredHooks(_workspace: string, events: readonly string[]): NodeJS.ProcessEnv {\n  const disabledEvents = [...new Set(events)];\n  if (disabledEvents.length === 0) return { ...process.env };\n  if (disabledEvents.some((event) => !/^[a-z][a-z0-9-]*$/.test(event))) {\n    throw new Error(\"Invalid Git hook event name\");\n  }\n  const assignments = disabledEvents.map((event) =>\n    `${quoteConfigValue(`hook.${event}.enabled`)}=${quoteConfigValue(\"false\")}`\n  );\n  const existingParameters = (process.env.GIT_CONFIG_PARAMETERS ?? \"\").trim();\n  return {\n    ...process.env,\n    GIT_CONFIG_PARAMETERS: existingParameters\n      ? `${existingParameters} ${assignments.join(\" \")}`\n      : assignments.join(\" \"),\n  };\n}\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { executeRetention, planRetention } from \"../src/core/retention.js\";\nimport { envWithoutConfiguredHooks } from \"../src/core/git_hook_guard.js\";\n\ntest(\"configured hook guard forces event-wide disable after inherited enable\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-hook-config-override-\"));\n  const previous = process.env.GIT_CONFIG_PARAMETERS;\n  try {\n    execFileSync(\"git\", [\"init\", \"-q\"], { cwd: workspace });\n    process.env.GIT_CONFIG_PARAMETERS = \"'hook.reference-transaction.enabled'='true'\";\n    const env = envWithoutConfiguredHooks(workspace, [\"reference-transaction\"]);\n    const effective = execFileSync(\"git\", [\"config\", \"--type=bool\", \"--get\", \"hook.reference-transaction.enabled\"], {\n      cwd: workspace,\n      env,\n      encoding: \"utf8\",\n    }).trim();\n    assert.equal(effective, \"false\");\n  } finally {\n    if (previous === undefined) delete process.env.GIT_CONFIG_PARAMETERS;\n    else process.env.GIT_CONFIG_PARAMETERS = previous;\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"checkpoint gc disables repository hooks and deletes the checkpoint ref\", () => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-retention-hook-\"));\n  const home = path.join(root, \"home\");\n  const workspace = path.join(root, \"workspace\");\n  const partition = path.join(home, \".nexus\", \"checkpoints\", \"partition\");\n  fs.mkdirSync(partition, { recursive: true });\n  fs.mkdirSync(workspace, { recursive: true });\n  const previousGitConfigParameters = process.env.GIT_CONFIG_PARAMETERS;\n  try {\n    execFileSync(\"git\", [\"init\", \"-q\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.email\", \"t@t.invalid\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.name\", \"t\"], { cwd: workspace });\n    fs.writeFileSync(path.join(workspace, \"file.txt\"), \"x\\n\");\n    execFileSync(\"git\", [\"add\", \"file.txt\"], { cwd: workspace });\n    execFileSync(\"git\", [\"commit\", \"-qm\", \"base\"], { cwd: workspace });\n    const ref = \"refs/nexus/checkpoints/checkpoint\";\n    execFileSync(\"git\", [\"update-ref\", ref, \"HEAD\"], { cwd: workspace });\n    const marker = path.join(root, \"hook-ran\");\n    const hook = path.join(workspace, \".git\", \"hooks\", \"reference-transaction\");\n    fs.writeFileSync(hook, `#!/bin/sh\\ntouch '${marker}'\\n`, { mode: 0o755 });\n    fs.chmodSync(hook, 0o755);\n    const includedHookConfig = path.join(root, \"configured-hooks.inc\");\n    fs.writeFileSync(\n      includedHookConfig,\n      '[hook \"retention=extra\"]\\n\\tevent = reference-transaction\\n\\tcommand = touch configured-hook-ran\\n',\n    );\n    execFileSync(\"git\", [\"config\", \"--local\", \"include.path\", includedHookConfig], { cwd: workspace });\n    // A parent Git process can pass config through this internal environment variable; it outranks\n    // GIT_CONFIG_COUNT, so an inherited value must not be able to re-enable the configured hook.\n    process.env.GIT_CONFIG_PARAMETERS = \"'hook.retention=extra.enabled'='true'\";\n    const gitVersion = execFileSync(\"git\", [\"--version\"], { cwd: workspace, encoding: \"utf8\" });\n    const version = gitVersion.match(/git version (\\d+)\\.(\\d+)/);\n    assert.ok(version, `could not parse Git version: ${gitVersion}`);\n    const hasConfiguredHooks = Number(version[1]) > 2 || (Number(version[1]) === 2 && Number(version[2]) >= 54);\n    if (hasConfiguredHooks) {\n      const probeRef = \"refs/nexus/checkpoints/config-hook-probe\";\n      execFileSync(\"git\", [\"update-ref\", probeRef, \"HEAD\"], { cwd: workspace });\n      assert.equal(fs.existsSync(path.join(workspace, \"configured-hook-ran\")), true, \"configured hook precondition did not run\");\n      assert.equal(fs.existsSync(marker), true, \"traditional hook precondition did not run\");\n      fs.rmSync(path.join(workspace, \"configured-hook-ran\"));\n      fs.rmSync(marker);\n      execFileSync(\"git\", [\"update-ref\", \"-d\", probeRef], { cwd: workspace });\n      fs.rmSync(path.join(workspace, \"configured-hook-ran\"));\n      fs.rmSync(marker);\n    }\n\n    const record = path.join(partition, \"checkpoint.json\");\n    fs.writeFileSync(record, JSON.stringify({ workspace, gitRef: \"refs/nexus/checkpoints/checkpoint\" }));\n    const old = new Date(Date.now() - 3 * 24 * 60 * 60 * 1000);\n    fs.utimesSync(record, old, old);\n\n    const plan = planRetention({ home, maxAgeDays: 1 });\n    assert.ok(plan.reclaimableItems.some((item) => item.kind === \"checkpoint\"));\n    executeRetention(plan);\n    assert.equal(fs.existsSync(marker), false, \"gc executed a workspace git hook\");\n    assert.equal(fs.existsSync(path.join(workspace, \"configured-hook-ran\")), false, \"gc executed a configured Git hook\");\n    const refLookup = spawnSync(\"git\", [\"show-ref\", \"--verify\", \"--quiet\", ref], { cwd: workspace });\n    assert.equal(\n      refLookup.status,\n      1,\n      `git show-ref did not confirm ref deletion: ${refLookup.error?.message ?? refLookup.stderr?.toString()}`,\n    );\n  } finally {\n    if (previousGitConfigParameters === undefined) delete process.env.GIT_CONFIG_PARAMETERS;\n    else process.env.GIT_CONFIG_PARAMETERS = previousGitConfigParameters;\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"checkpoint gc disables configured hooks added immediately before ref deletion\", (t) => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-retention-hook-race-\"));\n  const home = path.join(root, \"home\");\n  const workspace = path.join(root, \"workspace\");\n  const partition = path.join(home, \".nexus\", \"checkpoints\", \"partition\");\n  const includePath = path.join(root, \"hooks.inc\");\n  const wrapperDir = path.join(root, \"bin\");\n  const marker = path.join(root, \"late-hook-ran\");\n  const configAdded = path.join(root, \"hook-config-added\");\n  const previousPath = process.env.PATH;\n  const previousRealGit = process.env.REAL_GIT;\n  fs.mkdirSync(partition, { recursive: true });\n  fs.mkdirSync(workspace, { recursive: true });\n  fs.mkdirSync(wrapperDir, { recursive: true });\n  try {\n    execFileSync(\"git\", [\"init\", \"-q\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.email\", \"t@t.invalid\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.name\", \"t\"], { cwd: workspace });\n    fs.writeFileSync(path.join(workspace, \"file.txt\"), \"x\\n\");\n    execFileSync(\"git\", [\"add\", \"file.txt\"], { cwd: workspace });\n    execFileSync(\"git\", [\"commit\", \"-qm\", \"base\"], { cwd: workspace });\n    const ref = \"refs/nexus/checkpoints/checkpoint-race\";\n    execFileSync(\"git\", [\"update-ref\", ref, \"HEAD\"], { cwd: workspace });\n    fs.writeFileSync(includePath, \"\");\n    execFileSync(\"git\", [\"config\", \"--local\", \"include.path\", includePath], { cwd: workspace });\n\n    const version = execFileSync(\"git\", [\"--version\"], { cwd: workspace, encoding: \"utf8\" }).match(/git version (\\d+)\\.(\\d+)/);\n    assert.ok(version, \"could not parse Git version\");\n    if (Number(version[1]) < 2 || (Number(version[1]) === 2 && Number(version[2]) < 54)) {\n      t.skip(\"repository-configured hooks require Git 2.54 or later\");\n      return;\n    }\n\n    const gitPath = execFileSync(\"which\", [\"git\"], { encoding: \"utf8\" }).trim();\n    fs.writeFileSync(\n      path.join(wrapperDir, \"git\"),\n      `#!/bin/sh\\n` +\n        `add_hook() {\\n` +\n        `  if [ ! -e '${configAdded}' ]; then\\n` +\n        `    printf '[hook \"late-added\"]\\\\n\\\\tevent = reference-transaction\\\\n\\\\tcommand = touch \\\\\\\"${marker}\\\\\\\"\\\\n' >> '${includePath}'\\n` +\n        `    : > '${configAdded}'\\n` +\n        `  fi\\n` +\n        `}\\n` +\n        `if [ \"$1\" = config ]; then\\n` +\n        `  \"$REAL_GIT\" \"$@\"; status=$?; add_hook; exit $status\\n` +\n        `fi\\n` +\n        `if [ \"$3\" = update-ref ] && [ \"$4\" = -d ]; then add_hook; fi\\n` +\n        `exec \"$REAL_GIT\" \"$@\"\\n`,\n      { mode: 0o755 },\n    );\n    fs.chmodSync(path.join(wrapperDir, \"git\"), 0o755);\n\n    const record = path.join(partition, \"checkpoint-race.json\");\n    fs.writeFileSync(record, JSON.stringify({ workspace, gitRef: ref }));\n    const old = new Date(Date.now() - 3 * 24 * 60 * 60 * 1000);\n    fs.utimesSync(record, old, old);\n    const plan = planRetention({ home, maxAgeDays: 1 });\n    assert.ok(plan.reclaimableItems.some((item) => item.kind === \"checkpoint\"));\n\n    process.env.PATH = `${wrapperDir}${path.delimiter}${previousPath ?? \"\"}`;\n    process.env.REAL_GIT = gitPath;\n    const result = executeRetention(plan);\n    assert.equal(fs.existsSync(configAdded), true, \"fixture did not add the hook immediately before ref deletion\");\n    assert.equal(fs.existsSync(marker), false, \"gc executed a configured hook added immediately before ref deletion\");\n    assert.equal(result.deletedCount, 1);\n    assert.equal(result.errors.length, 0);\n    assert.equal(fs.existsSync(record), false);\n  } finally {\n    process.env.PATH = previousPath;\n    if (previousRealGit === undefined) delete process.env.REAL_GIT;\n    else process.env.REAL_GIT = previousRealGit;\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"checkpoint gc preserves a ref when its record changes after planning\", () => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-retention-record-race-\"));\n  const home = path.join(root, \"home\");\n  const workspace = path.join(root, \"workspace\");\n  const partition = path.join(home, \".nexus\", \"checkpoints\", \"partition\");\n  fs.mkdirSync(partition, { recursive: true });\n  fs.mkdirSync(workspace, { recursive: true });\n  try {\n    execFileSync(\"git\", [\"init\", \"-q\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.email\", \"t@t.invalid\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.name\", \"t\"], { cwd: workspace });\n    fs.writeFileSync(path.join(workspace, \"file.txt\"), \"x\\n\");\n    execFileSync(\"git\", [\"add\", \"file.txt\"], { cwd: workspace });\n    execFileSync(\"git\", [\"commit\", \"-qm\", \"base\"], { cwd: workspace });\n    const ref = \"refs/nexus/checkpoints/checkpoint-record-race\";\n    execFileSync(\"git\", [\"update-ref\", ref, \"HEAD\"], { cwd: workspace });\n    const record = path.join(partition, \"checkpoint-record-race.json\");\n    fs.writeFileSync(record, JSON.stringify({ workspace, gitRef: ref }));\n    const old = new Date(Date.now() - 3 * 24 * 60 * 60 * 1000);\n    fs.utimesSync(record, old, old);\n    const plan = planRetention({ home, maxAgeDays: 1 });\n    assert.ok(plan.reclaimableItems.some((item) => item.kind === \"checkpoint\"));\n\n    const replacement = `${record}.replacement`;\n    fs.writeFileSync(replacement, JSON.stringify({ workspace, gitRef: ref, changedAfterPlanning: true }));\n    fs.renameSync(replacement, record);\n\n    const result = executeRetention(plan);\n    assert.equal(result.deletedCount, 0);\n    assert.equal(result.errors.length, 1);\n    assert.match(result.errors[0].error, /changed since planning/);\n    assert.equal(fs.existsSync(record), true, \"gc removed the replaced checkpoint record\");\n    assert.equal(\n      spawnSync(\"git\", [\"show-ref\", \"--verify\", \"--quiet\", ref], { cwd: workspace }).status,\n      0,\n      \"gc deleted the ref for a record that changed after planning\",\n    );\n    const canary = path.join(env.root, \"diff-canary.sh\");\n    fs.writeFileSync(canary, `#!/bin/sh\\ntouch '${externalMarker}'\\ntouch '${fsmonitorMarker}'\\nexit 0\\n`, { mode: 0o755 });\n    fs.chmodSync(canary, 0o755);\n    execFileSync(\"git\", [\"config\", \"diff.external\", canary], { cwd: env.workspace });\n    execFileSync(\"git\", [\"config\", \"core.fsmonitor\", canary], { cwd: env.workspace });\n\n    const worktreeDiff = manager.getDiff(next.id);\n    const refDiff = manager.getDiff(next.id, base.id);\n    assert.equal(worktreeDiff.success, true, worktreeDiff.error);\n    assert.equal(refDiff.success, true, refDiff.error);\n    assert.equal(fs.existsSync(externalMarker), false, \"checkpoint diff executed diff.external\");\n    assert.equal(fs.existsSync(fsmonitorMarker), false, \"checkpoint diff executed core.fsmonitor\");\n  } finally {\n    env.restore();\n  }\n});\n\ntest(\"checkpoint operations do not execute hooks declared in repository config\", () => {\n  const env = setup();\n  try {\n    // Leave only configuration-declared hooks (Git 2.54+) in play.\n    fs.rmSync(env.hook, { force: true });\n    fs.rmSync(path.join(env.workspace, \".git\", \"hooks\", \"post-index-change\"), { force: true });\n    const gitVersion = execFileSync(\"git\", [\"--version\"], { cwd: env.workspace, encoding: \"utf8\" });\n    const version = gitVersion.match(/git version (\\d+)\\.(\\d+)/);\n    assert.ok(version, `could not parse Git version: ${gitVersion}`);\n    if (Number(version[1]) < 2 || (Number(version[1]) === 2 && Number(version[2]) < 54)) return;\n\n    const configuredMarker = path.join(env.root, \"configured-hook-ran\");\n    const included = path.join(env.root, \"configured-hooks.inc\");\n    fs.writeFileSync(\n      included,\n      `[hook \"checkpoint-reference\"]\\n\\tevent = reference-transaction\\n\\tcommand = touch '${configuredMarker}'\\n` +\n        `[hook \"checkpoint-index\"]\\n\\tevent = post-index-change\\n\\tcommand = touch '${configuredMarker}'\\n`\n    );\n    execFileSync(\"git\", [\"config\", \"--local\", \"include.path\", included], { cwd: env.workspace });\n\n    // Prove each event actually runs before testing that the manager suppresses it.\n    const probeRef = \"refs/nexus/checkpoints/config-hook-probe\";\n    execFileSync(\"git\", [\"update-ref\", probeRef, \"HEAD\"], { cwd: env.workspace });\n    assert.equal(fs.existsSync(configuredMarker), true, \"reference-transaction config hook precondition did not run\");\n    execFileSync(\"git\", [\"update-ref\", \"-d\", probeRef], { cwd: env.workspace });\n    fs.rmSync(configuredMarker, { force: true });\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"dirty for config hook precondition\\n\");\n    execFileSync(\"git\", [\"stash\", \"create\"], { cwd: env.workspace });\n    assert.equal(fs.existsSync(configuredMarker), true, \"post-index-change config hook precondition did not run\");\n    fs.rmSync(configuredMarker, { force: true });\n\n    fs.writeFileSync(path.join(env.workspace, \"file.txt\"), \"dirty for checkpoint\\n\");\n    const manager = new CheckpointManager(env.workspace);\n    const cp = manager.createCheckpoint(\"config hook test\");\n    assert.equal(fs.existsSync(configuredMarker), false, \"checkpoint creation executed a configured hook\");\n    manager.restore(cp.id);\n    assert.equal(fs.existsSync(configuredMarker), false, \"checkpoint restore executed a configured hook\");\n    manager.pruneCheckpoints(0);\n    assert.equal(fs.existsSync(configuredMarker), false, \"checkpoint pruning executed a configured hook\");\n  } finally {\n    env.restore();\n  }\n});\n\ntest(\"checkpoint pruning does not execute a workspace git hook\", () => {\n  const env = setup();\n  try {\n    const manager = new CheckpointManager(env.workspace);\n    // Create without the hook present, then install it before pruning the ref.\n    fs.rmSync(env.hook, { force: true });\n    manager.createCheckpoint(\"hook prune\");\n    fs.writeFileSync(env.hook, `#!/bin/sh\\ntouch '${env.marker}'\\n`, { mode: 0o755 });\n    fs.chmodSync(env.hook, 0o755);\n    manager.pruneCheckpoints(0);\n    assert.equal(fs.existsSync(env.marker), false, \"checkpoint pruning executed a workspace hook\");\n  } finally {\n    env.restore();\n  }\n});\ncli/test/checkpoint_git_hook.test.ts:22:  const hook = path.join(workspace, \".git\", \"hooks\", \"reference-transaction\");\ncli/test/checkpoint_git_hook.test.ts:132:      `[hook \"checkpoint-reference\"]\\n\\tevent = reference-transaction\\n\\tcommand = touch '${configuredMarker}'\\n` +\ncli/test/checkpoint_git_hook.test.ts:140:    assert.equal(fs.existsSync(configuredMarker), true, \"reference-transaction config hook precondition did not run\");\ncli/test/retention_git_hook.test.ts:12:  const previous = process.env.GIT_CONFIG_PARAMETERS;\ncli/test/retention_git_hook.test.ts:15:    process.env.GIT_CONFIG_PARAMETERS = \"'hook.reference-transaction.enabled'='true'\";\ncli/test/retention_git_hook.test.ts:16:    const env = envWithoutConfiguredHooks(workspace, [\"reference-transaction\"]);\ncli/test/retention_git_hook.test.ts:17:    const effective = execFileSy