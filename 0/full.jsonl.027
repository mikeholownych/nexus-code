{"timestamp":"2026-10-27T21:05:58.927Z","ordinal":427520,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17ef2-de25-7482-bff6-192772052d26","item":{"type":"CommandExecution","id":"exec-81f95fac-7904-4bb8-a69e-c080ad0f4854","process_id":"21965","command":["/usr/bin/zsh","-lc","rg -n 'constructor\\(' cli/src/core/resources.ts; sed -n '250,345p' cli/src/core/resources.ts; sed -n '350,455p' cli/src/core/operation.ts;"],"cwd":"file:///home/mike/nexus-wt/operation-scheduler-extraction","parsed_cmd":[{"type":"search","cmd":"rg -n \"constructor\\\\(\" cli/src/core/resources.ts","query":"constructor\\(","path":"resources.ts"},{"type":"read","cmd":"sed -n '250,345p' cli/src/core/resources.ts","name":"resources.ts","path":"cli/src/core/resources.ts"},{"type":"read","cmd":"sed -n '350,455p' cli/src/core/operation.ts","name":"operation.ts","path":"cli/src/core/operation.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"192:  constructor(\n        record.recheckAt = new Date(now + backoffDelayMs(failures, this.recheckPolicy, this.clock.random)).toISOString();\n      }\n    }\n    this.put(record);\n    return record;\n  }\n\n  /** Records a provider-catalog statement (e.g. a model listed with no serving capacity). */\n  observeCatalog(resource: ResourceDescriptor, condition: ResourceCondition, reason: string): ResourceConditionRecord {\n    const key = scopeKey(resource, \"model\")!;\n    const now = this.clock.now();\n    const prior = this.conditions.find((c) => c.key === key);\n    const failures = (prior?.failures ?? 0) + 1;\n    const record: ResourceConditionRecord = {\n      scope: \"model\",\n      key,\n      condition,\n      temporary: true,\n      recheckAt: new Date(now + backoffDelayMs(failures, this.recheckPolicy, this.clock.random)).toISOString(),\n      source: \"provider-catalog\",\n      confidence: \"derived\",\n      reason,\n      observedAt: new Date(now).toISOString(),\n      failures,\n      resourceId: resource.id,\n    };\n    this.put(record);\n    return record;\n  }\n\n  /** The catalog lists serving capacity again: withdraw only what the catalog itself asserted. */\n  clearCatalog(resource: ResourceDescriptor): void {\n    const key = scopeKey(resource, \"model\");\n    this.clear((c) => c.key === key && c.source === \"provider-catalog\");\n  }\n\n  /** The operator attested (through a recorded decision) that the resource's operator-action conditions are fixed. */\n  clearOperatorConditions(resource: ResourceDescriptor): void {\n    const keys = new Set(SCOPES.map((s) => scopeKey(resource, s)).filter(Boolean));\n    this.clear((c) => keys.has(c.key) && !c.temporary);\n  }\n\n  /** A completed request proves every scope it touched usable again. */\n  observeSuccess(resource: ResourceDescriptor): void {\n    const keys = new Set(SCOPES.map((s) => scopeKey(resource, s)).filter(Boolean));\n    this.clear((c) => keys.has(c.key));\n  }\n\n  /** A side-effect-free probe proves the endpoint reachable; it says nothing about model limits or quota. */\n  observeProbe(resource: ResourceDescriptor, available: boolean, failure?: InferenceFailure): void {\n    const endpointKeys = new Set([scopeKey(resource, \"endpoint\"), scopeKey(resource, \"provider\")]);\n    if (available) {\n      this.clear((c) => endpointKeys.has(c.key) && c.condition !== \"AUTH_FAILED\");\n      return;\n    }\n    // A failed probe is evidence about the endpoint, whatever status it returned.\n    const record = this.observeFailure(resource, {\n      kind: \"network_error\",\n      origin: \"transport\",\n      message: failure?.message ?? \"probe failed\",\n      condition: \"TEMPORARILY_UNAVAILABLE\",\n      execution: \"NOT_EXECUTED\",\n      ...(failure?.hints ? { hints: failure.hints } : {}),\n    });\n    if (record && record.source === \"backoff\") record.source = \"probe\";\n  }\n\n  eligibility(resource: ResourceDescriptor, now = this.clock.now()): Eligibility {\n    const keys = new Set(SCOPES.map((s) => scopeKey(resource, s)).filter(Boolean));\n    const blocking = this.conditions.filter((c) => keys.has(c.key) && this.isActive(c, now));\n    if (!blocking.length) return { eligible: true, permanent: false, blocking };\n    const permanent = blocking.some((c) => !c.temporary);\n    const eligibleAt = permanent ? undefined : Math.max(...blocking.map((c) => windowEnd(c)));\n    return { eligible: false, permanent, blocking, ...(eligibleAt !== undefined ? { eligibleAt } : {}) };\n  }\n\n  qualifies(resource: ResourceDescriptor, req: WorkRequirements, excludedModels: Set<string>): string[] {\n    const reasons: string[] = [];\n    for (const cap of req.capabilities ?? []) {\n      if (!resource.capabilities.includes(cap)) reasons.push(`lacks capability '${cap}'`);\n    }\n    if (req.qualification && resource.qualifications && !resource.qualifications.includes(req.qualification)) {\n      reasons.push(`not qualified for '${req.qualification}'`);\n    }\n    if (req.minContext && (resource.contextLength ?? 0) < req.minContext) {\n      reasons.push(`context ${resource.contextLength ?? \"unknown\"} < required ${req.minContext}`);\n    }\n    if (excludedModels.has(resource.model)) reasons.push(`model ${resource.model} is not independent of the work it reviews`);\n    if (req.minTrust && TRUST_RANK[classifyDestination(resource.endpoint)] < TRUST_RANK[req.minTrust]) {\n      reasons.push(`destination ${classifyDestination(resource.endpoint)} is below required ${req.minTrust}`);\n    }\n    return reasons;\n  }\n\n  /**\n   * Best qualified, eligible resource (preferred for the qualification, then lowest rank, then configuration order);\n  /**\n   * Re-derives every non-terminal unit's status from dependencies and resource eligibility, then chooses the next\n   * transition. Called after every change (completion, resource condition, wake), never acting on stale state.\n   */\n  decide(): Decision {\n    const now = this.now();\n    if (this.state.status === \"CANCELLED\") return { kind: \"blocked\", decisions: [] };\n    const previous = new Map(this.state.units.map((u) => [u.id, u.status]));\n    const choices = new Map<string, { resource: ResourceDescriptor; reroutedFrom?: { resourceId: string; reason: string } }>();\n\n    for (const u of this.state.units) {\n      if (TERMINAL.includes(u.status) || u.status === \"RUNNING\") continue;\n      const deps = u.dependsOn.map((d) => this.unit(d));\n      if (deps.some((d) => d.status !== \"COMPLETE\")) {\n        u.status = \"WAITING_ON_DEPENDENCY\";\n        delete u.parked;\n        continue;\n      }\n      const sel = u.override ? this.overrideSelection(u, now) : this.registry.select(u.requires, this.excludedModels(u), now);\n      if (sel.chosen) {\n        u.status = \"RUNNABLE\";\n        const from = u.assignment?.resourceId;\n        let reroutedFrom: { resourceId: string; reason: string } | undefined;\n        if (from && from !== sel.chosen.id) {\n          const prior = this.registry.get(from);\n          const elig = prior ? this.registry.eligibility(prior, now) : undefined;\n          const reason = !prior\n            ? \"previous resource is no longer configured\"\n            : u.override?.resourceId === sel.chosen.id\n              ? `operator assigned ${sel.chosen.id}`\n              : elig && !elig.eligible\n                ? elig.blocking.map((b) => b.reason).join(\"; \")\n                : `${sel.chosen.id} is the preferred qualified resource`;\n          reroutedFrom = { resourceId: from, reason };\n        }\n        choices.set(u.id, { resource: sel.chosen, ...(reroutedFrom ? { reroutedFrom } : {}) });\n        continue;\n      }\n      const temporary = sel.qualified.filter((c) => !c.eligibility.permanent && c.eligibility.eligibleAt !== undefined);\n      if (temporary.length) {\n        const wakeAt = Math.min(...temporary.map((c) => c.eligibility.eligibleAt!));\n        const reason = temporary\n          .map((c) => `${c.resource.id} ${c.eligibility.blocking.map((b) => b.reason).join(\", \")}`)\n          .join(\"; \");\n        const wasParked = u.status === \"PARKED\";\n        u.status = \"PARKED\";\n        u.parked = {\n          since: wasParked && u.parked ? u.parked.since : new Date(now).toISOString(),\n          reason,\n          resourceIds: temporary.map((c) => c.resource.id),\n          wakeAt: new Date(wakeAt).toISOString(),\n        };\n        continue;\n      }\n      this.block(u, this.noQualifiedResource(u, sel));\n    }\n\n    for (const u of this.state.units) {\n      const before = previous.get(u.id);\n      if (u.status === \"PARKED\" && before !== \"PARKED\") {\n        const others = this.productiveOthers(u.id, choices);\n        this.emit(\n          \"WORK_PARKED\",\n          `${u.title} parked: ${u.parked!.reason}; eligible again ${clockTime(Date.parse(u.parked!.wakeAt!))}.` +\n            (others ? ` Continuing ${others} independent ${others === 1 ? \"task\" : \"tasks\"}.` : \"\"),\n          { unitId: u.id, detail: { parked: u.parked } },\n        );\n      }\n    }\n\n    // Required work first; advisory work runs when it can but never ahead of the objective.\n    const runnable = this.state.units\n      .filter((u) => u.status === \"RUNNABLE\" && choices.has(u.id))\n      .sort((a, b) => Number(!isRequired(a)) - Number(!isRequired(b)));\n    if (runnable.length) {\n      const unit = runnable[0];\n      const choice = choices.get(unit.id)!;\n      return { kind: \"run\", unit, resource: choice.resource, ...(choice.reroutedFrom ? { reroutedFrom: choice.reroutedFrom } : {}) };\n    }\n\n    if (this.state.units.filter(isRequired).every((u) => u.status === \"COMPLETE\")) return { kind: \"complete\" };\n\n    const parked = this.state.units.filter((u) => u.status === \"PARKED\");\n    if (parked.length) {\n      const waitSince = this.state.wait ? Date.parse(this.state.wait.since) : now;\n      if (now - waitSince >= this.state.policy.maxWaitMs) {\n        for (const u of parked) this.block(u, this.waitBound(u, now - waitSince));\n        return this.decide();\n      }\n      const wakeAt = Math.max(now + this.state.policy.minWaitMs, Math.min(...parked.map((u) => Date.parse(u.parked!.wakeAt!))));\n      return {\n        kind: \"wait\",\n        wakeAt,\n        reason: parked.map((u) => `${u.title}: ${u.parked!.reason}`).join(\"; \"),\n        parked: parked.map((u) => u.id),\n      };\n    }\n\n    const decisions = this.state.units.filter((u) => u.status === \"BLOCKED\" && u.blocked).map((u) => u.blocked!.decision);\n    return { kind: \"blocked\", decisions };\n  }\n\n  /** The operator-assigned resource, if eligible; parks on it when temporarily unavailable. */\n  private overrideSelection(u: WorkUnit, now: number): ReturnType<ResourceRegistry[\"select\"]> {\n    const r = this.registry.get(u.override!.resourceId);\n    if (!r) return { qualified: [], rejected: [{ resourceId: u.override!.resourceId, reasons: [\"no longer configured\"] }] };\n","exit_code":0,"duration":{"secs":0,"nanos":789356590}},"started_at_ms":1793135158137,"completed_at_ms":1793135158927}}
