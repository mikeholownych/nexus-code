nt, type UnitRunResult, type WorkUnit } from \"./operation.js\";\norigin/main:cli/src/core/operation_runner.ts:74:  readonly scheduler: ConvergenceScheduler;\norigin/main:cli/src/core/operation_runner.ts:83:    this.scheduler = new ConvergenceScheduler(state, this.registry, () => this.clock.now(), opts.onEvent);\norigin/main:cli/src/core/operation_runner.ts:481: * Applies an operator decision under the driver lock: validated against the persisted decision (DecisionRejected\norigin/main:cli/src/core/operation_runner.ts:497:    new ConvergenceScheduler(state, registry, now, opts.onEvent).resolve(decisionId, optionId, note);\norigin/main:cli/src/operation_cli.ts:18:import { DecisionRejected, newOperation, type DurableOperationState, type OperationEvent, type OperationPolicy, type WorkUnitSpec } from \"./core/operation.js\";\norigin/main:cli/src/operation_cli.ts:154:        if (!(err instanceof DecisionRejected)) throw err;\norigin/main:cli/test/convergence_scheduling.test.ts:11:import { ConvergenceScheduler, newOperation, type DurableOperationState, type UnitRunResult, type WorkUnit, type WorkUnitSpec } from \"../src/core/operation.js\";\norigin/main:cli/test/convergence_scheduling.test.ts:678:    const s = new ConvergenceScheduler(state, new ResourceRegistry(state.resources, [], clock), clock.now);\norigin/main:cli/test/team_convergence.test.ts:2: * /team on the convergence foundation: roles are durable work units scheduled by ConvergenceScheduler, executed as\norigin/main:cli/test/team_convergence.test.ts:17:import { DecisionRejected, newOperation, type DurableOperationState, type OperationEvent, type OperationEventType, type UnitRunResult, type WorkUnit } from \"../src/core/operation.js\";\norigin/main:cli/test/team_convergence.test.ts:905:      const tryApply = (d: string, o: string, note?: string) => assert.throws(() => applyOperatorDecision(env.store, \"team-dec\", d, o, note), DecisionRejected);\norigin/main:docs/EXECUTION_CONVERGENCE.md:9:  -> convergence scheduler (ConvergenceScheduler decides; OperationRunner owns time, execution, persistence)\norigin/main:docs/EXECUTION_CONVERGENCE.md:97:task), `drop` (advisory units only) and `cancel_operation`. `ConvergenceScheduler.resolve` validates the decision id,\norigin/main:docs/EXECUTION_CONVERGENCE.md:98:the option id and the action against current state and throws `DecisionRejected` otherwise; applying one records\n# Running multiple agents on this plan without collisions\n\nThese rules apply to every agent (Claude Code, Codex, Cursor, Nexus itself, or a human) that implements any par…2066 tokens truncated… slice. Do not reformat or clean up files outside the boundary.\n3. Merge order follows the precedence rules in §4 and the ROADMAP milestone order. Within a milestone, the slice with fewer hot-file claims merges first.\n4. Rebase onto `origin/main` immediately before merging. Re-run the slice's targeted tests, plus `make test`, on a snapshot of the rebased commit. Merge only if both pass.\n5. Pushing, tagging, publishing and changing GitHub state (issues, milestones, releases) are **owner-approved actions** (DECISIONS X-list). Agents prepare them and do not perform them.\n6. Preserve unrelated user work: the untracked `nexus-continuity-validation/`, the stashes, and any dirty files you did not create. Never stash, reset, clean or check out over them.\n\n## 6. Coordination records\n\n| Record | Where | Purpose |\n|---|---|---|\n| Claims | `$(git rev-parse --git-common-dir)/nexus-claims/` | Who owns which slice or file right now |\n| Claim log | `$(git rev-parse --git-common-dir)/nexus-claims.log` (append-only, one line per event) | Claim, release, broken claim, boundary request |\n| Boundary requests and discovered requirements | The PR description, under the heading `Needs from other slices`. Mirrored as one line in the claim log. | So the owning slice's agent can pick it up. Never fixed silently out of scope. |\n| Slice evidence | `docs/reviews/evidence/v1/<plan>-<slice>/` (new directory per slice) | No shared evidence files, so agents cannot overwrite each other's evidence |\n\n## 7. Safe parallel lanes\n\nThe following groupings can run at the same time with no hot-file contention beyond §4 claims. They are listed by milestone.\n\n| Phase | Parallel lanes |\n|---|---|\n| M0 | (a) PLAN-08 PR-8a, which must merge first. Then in parallel: (b) PLAN-06 PR-6a, (c) PLAN-09 PR-9a. |\n| M1 | (a) PLAN-01 PR-1a → PR-1b → PR-1c (sequential, owns `capabilities.ts`, `agent.ts` dispatch). (b) PLAN-02 PR-2a (Rust only). (c) PLAN-03 PR-3a → PR-3b (config/egress). (d) PLAN-11 PR-11a (`parser.ts`) and PR-11b (`tester.ts`, after PR-1c). Lanes (b), (c) and (d) do not touch `capabilities.ts`. |\n| M2 (alongside M1) | (a) PLAN-07 PR-7a/7b/7c (workflows, scripts). (b) PLAN-06 PR-6b after PLAN-01 PR-1b (shares `index.ts` flags). |\n| M3 | (a) PLAN-04 (`agent.ts` turn, operation runner). (b) PLAN-05 (`client.ts`, provider modules). (c) PLAN-10 harness (`eval/`, no product files). (d) Held-out task authoring by the agent author, **outside the repository**: no access to Nexus source or the development set (DEC-05). |\n| M4 (alongside M3) | PLAN-08 PR-8b..8e. Coordinate with PLAN-04 on `state.ts` through `FILE_` claims. |\n| M5 | **Serial on `GATEWAY`.** The eval runner, the stripped-proxy runs and the independent reviewer's live task each take the `GATEWAY` claim. The terminal matrix (E3) and the install matrix (E2) can run in parallel with gateway runs. |\n\n## 8. Independence constraints\n\n- The held-out task author must not see Nexus source, the development tasks or tuning history. It runs in a separate session with only the task schema and external repositories. Its output is sealed by a sha256 manifest committed before RC1.\n- The independent reviewer in ACCEPTANCE §8 must not be the agent or session that implemented the slices under review.\n- An implementing agent never edits `eval/heldout-manifest.json`, scorer thresholds or ACCEPTANCE §6.4 after the freeze.\n{\"agent\":\"codex-root\",\"branch\":\"v1/plan-01-sec101-119-pty-followup\",\"since\":\"2026-10-25T01:07:59Z\",\"scope\":\"PLAN-01_SEC101_119_PTY_FOLLOWUP_20261025\"}\n{\n  \"agent\": \"/root\",\n  \"base\": \"fc582c66bf70e00938eedc0ce3cafc635f582540\",\n  \"branch\": \"v1/rc10-readiness-20261027\",\n  \"head\": \"9ee2eb5682b97644b35546479c7d94079ac30a60\",\n  \"host\": \"mike-dev\",\n  \"independent_review\": \"ACCEPT by plan05_readonly_review at exact head eac6cdb452726368d37a8ca373b56c688e0274da; full base-relative diff SHA-256 96da76dc439c2cc7b7d26f08d9bff19f873931a8c3f759dc9e54efa4eb825692; both prior findings corrected\",\n  \"scope\": \"correct stale PR #268 status and attribution on READINESS.md only after its exact-head CI finishes; preserve all qualification blockers; no source or acceptance changes\",\n  \"since\": \"2026-10-27T16:52:00Z\",\n  \"status\": \"Local refresh commit 9ee2eb5 is stale against main 7bf9086 and readiness facts lag PR280/PR282. Preserve branch; refresh once PR282 and exact-main post-merge CI are terminal. No push or merge yet.\",\n  \"worktree\": \"/home/mike/nexus-wt/rc10-readiness-20261027\",\n  \"updated_at\": \"2026-10-27T20:29:18Z\"\n}\n\n─── core/operation.ts:323  [class]\n    export class ConvergenceScheduler\n\n─── core/operation.ts\n    type WorkUnitStatus\n    type OperationStatus\n    function unitBaseTask\n    type DecisionAction\n    interface DecisionOption\n    type BlockCause\n    interface EscalationDecision\n    interface AppliedDecision\n    interface WorkUnit\n    type OperationEventType\n    interface OperationEvent\n    interface OperationPolicy\n    const DEFAULT_OPERATION_POLICY\n    interface DurableOperationState\n    interface OptionSpec\n    interface BlockSpec\n    type UnitRunResult\n    type Decision\n    class DecisionRejected\n    const isRequired\n    function isRequired\n    interface WorkUnitSpec\n    function newOperation\n    function assertAcyclic\n    function visit\n    function clockTime\n    class ConvergenceScheduler\n\n2 definition(s) from 'nexus-cli-*'. Cite path:line for anything you rely on.\nxerj search: these hits are lexical; this command does not consult the embedding.\n\n─── core/operation.ts:2  (score 40.46)\n    /**\n     * Convergence scheduling: an operation is a set of work units with dependencies, driven toward its objective.\n     *\n     * A resource becoming unavailable is not the work becoming unavailable. When a resource condition changes the\n     * scheduler reroutes to a qualified alternate if one is eligible, otherwise parks the affected unit and continues\n     * other eligible work; the operation waits only when no productive work remains, and blocks only when no safe\n     * autonomous transition exists, in which case it asks for one concrete decision.\n     *\n     * The scheduler is pure decision logic over durable state; \n    … (--full 1200 to see more)\n\n─── operation_cli.ts:2  (score 22.63)\n    /**\n     * `nexus operation run|resume|status`: convergence-scheduled operations from a work-unit spec.\n     *\n     * Spec (JSON): { \"objective\": string, \"id\"?: string, \"units\": WorkUnitSpec[], \"resources\"?: ResourceDescriptor[],\n     * \"discoverCatalog\"?: boolean, \"policy\"?: Partial<OperationPolicy> }. Without \"resources\" the configured endpoint,\n     * fallbacks and planner/coder models are the resources.\n     *\n     * `nexus operation decide <id> <decision> <option>` applies an operator decision to a BLOCKED unit: it is validated\n     * against the persisted decision, recorded on the unit, and the operation is re-evaluate\n    … (--full 1200 to see more)\n\n─── core/operation_runner.ts:481  (score 18.08)\n        if (explicitAccountConditionKeys.has(condition.key)) continue;\n        const marker = \"|account|\";\n        const markerAt = condition.key.lastIndexOf(marker);\n        if (markerAt < 0) continue;\n        const oldAccount = condition.key.slice(markerAt + marker.length);\n    