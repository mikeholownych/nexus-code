{"timestamp":"2026-10-27T22:22:05.651Z","ordinal":428903,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17ef2-de25-7482-bff6-192772052d26","item":{"type":"CommandExecution","id":"exec-cd42d0b4-63dd-4ec9-ab6f-cde4748a17bd","process_id":"63720","command":["/usr/bin/zsh","-lc","rg -n \"test\\(|describe\\(|for \\(|while \\(|50000|100000|retention|cleanup\" cli/test/retention.test.ts | head -80"],"cwd":"file:///home/mike/nexus-wt/operation-scheduler-suite","parsed_cmd":[{"type":"search","cmd":"rg -n \"test\\\\(|describe\\\\(|for \\\\(|while \\\\(|50000|100000|retention|cleanup\" cli/test/retention.test.ts","query":"test\\(|describe\\(|for \\(|while \\(|50000|100000|retention|cleanup","path":"retention.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"13:  planRetention,\n14:  runRetentionGc,\n20:} from \"../src/core/retention.js\";\n26:describe(\"PLAN-08 PR-8c: Persistence retention, GC, and indexed sessions (REQ-PER-102, DEC-11, ACC-PER-02)\", () => {\n27:  test(\"Session indexing with rebuild-on-miss and performance (1k sessions lists in < 500 ms)\", () => {\n38:      for (let i = 0; i < 1000; i++) {\n82:  test(\"ACC-PER-02: seed 10k tasks and 2k sessions; gc --dry-run reports and gc brings store under cap\", () => {\n96:      for (let i = 0; i < 10000; i++) {\n115:      for (let i = 0; i < 2000; i++) {\n139:      // 3. Dry run: plan retention\n141:      const plan = planRetention({\n156:      const pollutionPlan = planRetention({\n164:      const gcResult = runRetentionGc({\n187:  test(\"Checkpoints git ref and snapshot pruning, flights pruning\", () => {\n225:        const result = runRetentionGc({\n252:  test(\"Background daily GC: first-run acknowledgement, NEXUS_GC=auto, and 2s timeout bounding\", async () => {\n294:  test(\"Background daily GC: enforces single end-to-end deadline across planning, identity capture, and execution\", async () => {\n300:      for (let i = 0; i < 50; i++) {\n311:      const res = runRetentionGc({\n326:  test(\"Planning candidate selection and size cap sorting respects expired deadline\", () => {\n331:      for (let i = 0; i < 30; i++) {\n338:      const plan = planRetention({\n350:  test(\"Background daily GC: persists summary and lastRunAt even when work budget expires\", async () => {\n356:      for (let i = 0; i < 40; i++) {\n383:  test(\"Planning: bounded metadata streaming respects deadline and preserves pin protection on large legacy state envelopes\", () => {\n410:      // Normal plan: verify planRetention accounts for the item and protects it from reclamation\n411:      const plan = planRetention({\n421:      const timedOutPlan = planRetention({\n433:test(\"large escaped JSON metadata keeps pinned records and decodes Unicode workspaces\", () => {\n434:  const home = tmp(\"retention-json-metadata-\");\n440:    for (const escapedValue of [false, true]) {\n451:    for (const item of scanned.items) {\n455:    const result = runRetentionGc({ home, maxAgeDays: 30, maxSizeBytes: 1, dryRun: false });\n461:test(\"large metadata preserves the ordinary JSON pin value semantics\", () => {\n462:  const home = tmp(\"retention-json-pin-values-\");\n464:    for (const [index, pinned] of [false, true, null, 0, 1, -1, 0.25, \"\", \"yes\", [], {}].entries()) {\n473:test(\"large escaped session identity keeps the current session out of retention\", () => {\n474:  const home = tmp(\"retention-json-current-\");\n484:    assert.equal(runRetentionGc({ home, currentSessionId: \"active-session\", maxAgeDays: 30, maxSizeBytes: 1, dryRun: false }).deletedCount, 0);\n489:test(\"metadata reads remain bounded when a small envelope is replaced after stat\", () => {\n490:  const home = tmp(\"retention-json-stat-race-\");\n","exit_code":0,"duration":{"secs":0,"nanos":847426685}},"started_at_ms":1793139724803,"completed_at_ms":1793139725650}}
