    errors.push({ path: path.dirname(item.primaryFile), error: err?.message || String(err) });\n1174-      }\n1175-    }\n1176-\n--\n1186-            fs.rmSync(assoc, { recursive: true, force: true });\n1187-          } else {\n1188-            fs.unlinkSync(assoc);\n1189-          }\n1190-        }\n1191:      } catch (err: any) {\n1192-        success = false;\n1193-        errors.push({ path: assoc, error: err?.message || String(err) });\n1194-      }\n1195-    }\n1196-\n1197-    if (success && durableTaskRecord && item.associatedFiles.length > 0) {\n1198-      const directories = new Set(item.associatedFiles.map(file => path.dirname(file)));\n1199-      for (const directory of directories) {\n1200-        try {\n1201-          fsyncDirectoryDurably(directory);\n1202:        } catch (err: any) {\n1203-          success = false;\n1204-          errors.push({ path: directory, error: err?.message || String(err) });\n1205-        }\n1206-      }\n1207-    }\n--\n1209-    if (success) {\n1210-      if (item.kind === \"session\") {\n1211-        sessionsRemoved.push(item.id);\n1212-      }\n1213-\n1214:      deletedCount++;\n1215-      deletedBytes += item.sizeBytes;\n1216-      deletedItems.push(item);\n1217-      byKind[item.kind].count++;\n1218-      byKind[item.kind].bytes += item.sizeBytes;\n1219-    }\n--\n1237-            raw.updatedAt = new Date().toISOString();\n1238-            writePrivateFile(indexPath, JSON.stringify(raw, null, 2));\n1239-          }\n1240-        }\n1241-      }\n1242:    } catch {}\n1243-  }\n1244-\n1245-  return {\n1246-    dryRun,\n1247-    scannedCount: plan.totalScannedCount,\n1248-    scannedBytes: plan.totalScannedBytes,\n1249:    deletedCount,\n1250-    deletedBytes,\n1251-    deletedItems,\n1252-    byKind,\n1253-    errors,\n1254-    timedOut,\n--\n1275-  const stateFile = path.join(home, \".nexus\", \"gc_state.json\");\n1276-  if (fs.existsSync(stateFile)) {\n1277-    try {\n1278-      const raw = JSON.parse(fs.readFileSync(sta