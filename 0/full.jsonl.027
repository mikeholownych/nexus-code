{"timestamp":"2026-10-27T17:42:38.026Z","ordinal":419869,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17e71-922f-7ef3-a2c1-bcdcbd1f8423","item":{"type":"CommandExecution","id":"exec-07d1b569-c32b-42b4-94c0-81994404f0dc","process_id":"85373","command":["/usr/bin/zsh","-lc","sed -n '365,425p' cli/src/provider_cli.ts; sed -n '295,325p' cli/src/core/state.ts; sed -n '1,95p' cli/src/usage.ts"],"cwd":"file:///home/mike/nexus-wt/rc10-readiness-20261027","parsed_cmd":[{"type":"read","cmd":"sed -n '365,425p' cli/src/provider_cli.ts","name":"provider_cli.ts","path":"cli/src/provider_cli.ts"},{"type":"read","cmd":"sed -n '295,325p' cli/src/core/state.ts","name":"state.ts","path":"cli/src/core/state.ts"},{"type":"read","cmd":"sed -n '1,95p' cli/src/usage.ts","name":"usage.ts","path":"cli/src/usage.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"      for (const def of Object.values(PROVIDERS)) {\n        const configuredBase = operatorSetting(baseUrlSetting(def.id));\n        const baseUrl = configuredBase || def.baseUrl;\n        const base = baseUrl ? safeOriginOf(baseUrl) ?? \"(invalid endpoint)\" : \"(set --base-url or \" + baseUrlSetting(def.id) + \")\";\n        const found = resolveCredential(def.id, def.credentialEnv);\n        const key = found ? pc.green(`connected via ${found.source}`) : pc.yellow(`not connected (${def.credentialEnv ? `$${def.credentialEnv} or ` : \"\"}nexus connect ${def.id})`);\n        console.log(`  ${pc.bold(def.id.padEnd(11))} ${def.protocol.padEnd(19)} ${base}`);\n        console.log(`  ${\"\".padEnd(11)} ${key}${def.methods.some((m) => m.unofficial) ? pc.dim(\"  · unofficial sign-in\") : \"\"}`);\n      }\n      let config: HarnessConfig;\n      try {\n        config = buildConfig({});\n      } catch (err: any) {\n        console.log(pc.red(`\\n${safeConfigurationError(err)}`));\n        process.exitCode = 2;\n        return;\n      }\n      console.log(`\\n${describeTarget(config)}`);\n      const authorized = config.authorizedDisclosureOrigins ?? [];\n      console.log(pc.dim(`Authorized cloud destinations: ${authorized.length ? authorized.map((origin) => safeOriginOf(origin) ?? \"(invalid endpoint)\").join(\", \") : \"none\"}`));\n      console.log(pc.dim(\"Select with --provider <id> --model <id> (or NEXUS_PROVIDER / NEXUS_MODEL in ~/.config/nexus/config.env).\\n\"));\n    });\n\n  providers\n    .command(\"verify\")\n    .description(\"Live check: streamed completion and a tool round trip against a provider (sends no workspace content)\")\n    .requiredOption(\"--provider <id>\", \"Provider to check\")\n    .option(\"-m, --model <name>\", \"Model id (default: $NEXUS_MODEL)\")\n    .option(\"--base-url <url>\", \"Override the provider's base URL\")\n    .option(\"-j, --json\", \"Print steps and receipts as JSON\")\n    .action(async (options: any) => {\n      let config: HarnessConfig;\n      try {\n        config = buildConfig(options);\n      } catch (err: any) {\n        console.error(pc.red(safeConfigurationError(err)));\n        process.exit(2);\n      }\n      const abort = new AbortController();\n      process.once(\"SIGINT\", () => abort.abort(new Error(\"SIGINT\")));\n      const diagnosticHandler = (level: \"error\" | \"warn\", message: string) => {\n        (level === \"warn\" ? console.warn : console.error)(pc.dim(safeClientDiagnostic(message, config)));\n      };\n      const steps = await verifyProvider(config, abort.signal, { diagnosticHandler });\n      const receipts = UsageLedger.global().all();\n      const summary = verificationSummary(steps, receipts, { provider: config.provider, model: config.model });\n      if (options.json) {\n        console.log(JSON.stringify({ date: new Date().toISOString(), ...summary }, null, 2));\n      } else {\n        console.log(pc.bold(`\\nLive provider check\\n${describeTarget(config)}`));\n        for (const s of steps) {\n          const disposition = s.ok ? \"passed\" : `failed${s.failureKind ? ` (${s.failureKind}${s.failureCondition ? `/${s.failureCondition}` : \"\"})` : \"\"}`;\n          console.log(`  ${s.ok ? pc.green(\"✓\") : pc.red(\"✗\")} ${s.step}: ${disposition} — ${s.detail}`);\n        }\n        const usageSummary = UsageLedger.global().summary();\n        if (usageSummary) console.log(pc.dim(usageSummary));\n        console.log(summary.passed ? pc.green(\"\\nInference verified (completion + tool round trip).\\n\") : pc.red(\"\\nNot verified.\\n\"));\n      }\n      process.exitCode = summary.passed ? 0 : 1;\n    });\n}\n  };\n  diagnostics: string[];\n}\n\n// -------------------------------------------------------------\n// DurableStateManager\n// -------------------------------------------------------------\n\nexport interface DurableStateManagerOptions {\n  baseDir?: string;\n  workspacePaths?: WorkspacePath[];\n}\n\n/** Where durable task state is written unless a directory is given. */\nexport function defaultTaskStateDir(): string {\n  if (process.env.NEXUS_STATE_DIR) {\n    return path.join(process.env.NEXUS_STATE_DIR, \"tasks\");\n  }\n  return path.join(os.homedir(), \".nexus\", \"tasks\");\n}\n\nexport class DurableStateManager {\n  private readonly baseDir: string;\n  private workspacePaths: WorkspacePath[];\n\n  constructor(options: DurableStateManagerOptions = {}) {\n    const baseDir = options.baseDir || defaultTaskStateDir();\n    this.workspacePaths = options.workspacePaths || [];\n    ensurePrivateDir(baseDir);\n    this.baseDir = fs.realpathSync(baseDir);\n  }\n/**\n * Inference usage ledger: one receipt per provider-connection request (main agent, planner/coder, subagents and\n * auxiliary calls all share the process-wide ledger), and the spending limits checked before each cloud request.\n *\n * Receipts never hold credentials, headers or request bodies. Usage is what the provider reported; cost is recorded\n * only when the provider reported it (OpenRouter) and is otherwise \"unknown\" — never estimated from a price table.\n * Limits are enforced on reported/reserved figures and are not a guarantee of the provider's final invoice.\n */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { ensurePrivateDir, appendPrivateFile } from \"./core/durable_file.js\";\n\nexport interface UsageReport {\n  inputTokens?: number;\n  outputTokens?: number;\n  cachedInputTokens?: number;\n  cacheWriteTokens?: number;\n  reasoningTokens?: number;\n  /** Provider-reported cost in USD. */\n  costUsd?: number;\n}\n\nexport interface InferenceReceipt {\n  at: string;\n  requestId: string;\n  role: string;\n  providerId: string;\n  /** The model the operator selected and the model the provider reports having used (may differ, e.g. OpenRouter routing). */\n  selectedModel: string;\n  effectiveModel?: string;\n  endpointOrigin: string;\n  protocol: string;\n  disclosure: \"local\" | \"cloud\";\n  origin_class?: \"local\" | \"cloud\" | string;\n  executions?: number;\n  outcome: \"completed\" | \"failed\" | \"aborted\";\n  failureKind?: string;\n  providerRequestId?: string;\n  usage?: UsageReport;\n  /** \"provider\": usage came from the provider; \"uncertain\": the request may have been billed but no usage arrived. */\n  usageConfidence: \"provider\" | \"uncertain\" | \"none\";\n  costConfidence: \"provider-reported\" | \"unknown\";\n}\n\nexport interface SpendingLimits {\n  maxRequests?: number;\n  maxTokens?: number;\n  maxCostUsd?: number;\n}\n\nexport function spendingLimitsFromEnv(env: NodeJS.ProcessEnv = process.env): SpendingLimits {\n  const num = (k: string) => {\n    const v = Number(env[k]);\n    return Number.isFinite(v) && v > 0 ? v : undefined;\n  };\n  return { maxRequests: num(\"NEXUS_CLOUD_MAX_REQUESTS\"), maxTokens: num(\"NEXUS_CLOUD_MAX_TOKENS\"), maxCostUsd: num(\"NEXUS_CLOUD_MAX_COST_USD\") };\n}\n\nexport interface UsageTotals {\n  requests: number;\n  inputTokens: number;\n  outputTokens: number;\n  costUsd: number;\n  /** Requests whose cost the provider did not report. */\n  unpricedRequests: number;\n  /** Requests that may have been billed without reported usage (failed mid-stream, timed out). */\n  uncertainRequests: number;\n}\n\nexport class UsageLedger {\n  private static instance?: UsageLedger;\n  static global(): UsageLedger {\n    return (UsageLedger.instance ??= new UsageLedger());\n  }\n  /** Tests isolate ledgers. */\n  static resetGlobal(): void {\n    UsageLedger.instance = undefined;\n  }\n\n  private receipts: InferenceReceipt[] = [];\n  private reserved = new Map<string, number>();\n  limits: SpendingLimits = spendingLimitsFromEnv();\n\n  /**\n   * Admit one cloud request under the limits, reserving `estimatedTokens` until it is recorded. Concurrent callers\n   * (scheduled work units, subagents) see each other's reservations. Returns a refusal reason, or undefined.\n   */\n  admit(requestId: string, estimatedTokens: number, costReported: boolean): string | undefined {\n    const t = this.cloudTotals();\n    const pendingTokens = [...this.reserved.values()].reduce((a, b) => a + b, 0);\n    const { maxRequests, maxTokens, maxCostUsd } = this.limits;\n    if (maxRequests !== undefined && t.requests + this.reserved.size + 1 > maxRequests) {\n      return `cloud request limit reached (NEXUS_CLOUD_MAX_REQUESTS=${maxRequests}; ${t.requests} recorded, ${this.reserved.size} in flight)`;\n    }\n    if (maxTokens !== undefined && t.inputTokens + t.outputTokens + pendingTokens + estimatedTokens > maxTokens) {\n","exit_code":0,"duration":{"secs":0,"nanos":670566982}},"started_at_ms":1793122957355,"completed_at_ms":1793122958026}}
