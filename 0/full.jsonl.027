);\n    }\n    assert.equal(qualificationResourceIsolationProblem({ resources: ok }), null, \"restored dedicated mount root must pass preflight\");\n    fs.chmodSync(workspaceRoot, 0o731);\n    try {\n      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \"\", /non-readable\\/non-writable by group or other/);\n    } finally {\n      fs.chmodSync(workspaceRoot, restoreMode);\n    }\n    fs.chmodSync(workspaceRoot, 0o711);\n    try {\n      assert.equal(qualificationResourceIsolationProblem({ resources: ok }), null, \"execute-only traversal for the isolated evaluator account is compatible with the private root\");\n    } finally {\n      fs.chmodSync(workspaceRoot, restoreMode);\n    }\n  }\n  const syntheticRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-mount-mode-\"));\n  try {\n    fs.chmodSync(syntheticRoot, 0o711);\n    const syntheticMount = `101 1 0:88 / ${syntheticRoot} rw,relatime - tmpfs tmpfs rw,size=131072k,mode=711,uid=${process.getuid()}`;\n    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, `${syntheticMount}\\n${syntheticMount.replace(\"101 \", \"102 \")}`) ?? \"\", /stacked or duplicate/);\n    assert.equal(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount), null, \"execute-only traversal is permitted for the isolated evaluator account\");\n    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount.replace(\"mode=711\", \"mode=755\")) ?? \"\", /non-readable\\/non-writable by group or other/);\n    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount.replace(\"mode=711\", \"mode=721\")) ?? \"\", /non-readable\\/non-writable by group or other/);\n  } finally {\n    fs.chmodSync(syntheticRoot, 0o700);\n    fs.rmdirSync(syntheticRoot);\n  }\n});\n\ntest(\"resource contract: candidate memory, processes, storage and CPU are kernel-bounded and every process is reaped\", async () => {\n  const { runIsolated, sandboxAvailable } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const { spawnContained } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n  assert.equal(sandboxAvailable(), true, \"this security test requires the real Bubblewrap executable\");\n  const memoryBytes = 256 * 1024 * 1024;\n  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\n  const tmpfs = fs.statfsSync(workspaceRoot);\n  const resources = { cpuPercent: 20, memoryBytes, tasks: 16, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\n  const ws = fs.mkdtempSync(path.join(resources.workspaceRoot, \"eval-resources-\"));\n  const run = (command: string, timeoutSec = 30) => runIsolated(command, { cwd: ws, home: true, timeoutSec, resources });\n  try {\n    // Actually allocate task-charged tmpfs pages. Streaming zeros to the captured pipe only tests output limits.\n    const memory = await run(\"dd if=/dev/zero of=/tmp/memory-fill bs=1M count=512 status=none\");\n    assert.notEqual(memory.status, 0);\n    assert.ok(memory.resources.oomKills >= 1, JSON.stringify(memory.resources));\n    assert.equal(memory.resources.limits[\"memory.oom.group\"], \"1\");\n    assert.equal(memory.resources.limits[\"memory.max\"], String(memoryBytes));\n    assert.equal(memory.resources.limits[\"memory.swap.max\"], \"0\");\n    assert.equal(memory.containmentProblem, null);\n\n    const forks = await run(\"for i in $(seq 64); do sleep 30 & done; wait\", 10);\n    assert.ok(forks.resources.pidsMaxEvents >= 1, JSON.stringify(forks.resources));\n    assert.ok(forks.resources.pidsPeak <= 16);\n    assert.equal(forks.resources.cleaned, true);\n\n    // The dedicated workspace mount caps storage before the larger memory limit; sandbox /tmp is separately charged\n    // to the task cgroup and must hit memory.max. Neither failure may leave a task process behind.\n    const workspaceDisk = await run(\"dd if=/dev/zero of=/workspace/fill bs=1M count=512 status=none\");\n    assert.notEqual(workspaceDisk.status, 0, JSON.stringify(workspaceDisk));\n    assert.equal(workspaceDisk.resources.oomKills, 0, JSON.stringify(workspaceDisk.resources));\n    assert.equal(workspaceDisk.resources.cleaned, true);\n    assert.ok((fs.existsSync(path.join(ws, \"fill\")) ? fs.statSync(path.join(ws, \"fill\")).size : 0) <= resources.storageBytes);\n\n    const sandboxDisk = await run(\"dd if=/dev/zero of=/tmp/fill bs=1M count=512 status=none\");\n    assert.notEqual(sandboxDisk.status, 0, JSON.stringify(sandboxDisk));\n    assert.ok(sandboxDisk.resources.oomKills >= 1, JSON.stringify(sandboxDisk.resources));\n    assert.equal(sandboxDisk.resources.cleaned, true);\n\n    const cpu = await run(\"timeout 2 sh -c 'while :; do :; done' & timeout 2 sh -c 'while :; do :; done' & wait\");\n    assert.equal(cpu.resources.limits[\"cpu.max\"], \"20000 100000\");\n    assert.ok(cpu.resources.cpuUsageUsec < 1_000_000, `two busy loops for 2 s at 20% used ${cpu.resources.cpuUsageUsec} us`);\n    assert.ok(cpu.resources.cpuThrottledUsec > 0);\n\n    // The wall-clock kill goes through the cgroup, so the supervisor still proves cleanup.\n    const slow = await run(\"sleep 60\", 1);\n    assert.equal(slow.timedOut, true);\n    assert.equal(slow.resources.cleaned, true);\n    assert.equal(slow.containmentProblem, null);\n\n    // A stop requested at once (before the payload can have joined its leaf) still ends the payload.\n    const early = await new Promise<any>((resolve) => {\n      const started = Date.now();\n      const { child, containment } = spawnContained({ cmd: \"/bin/sleep\", argv: [\"60\"] }, resources, { cwd: \"/\", stdio: [\"ignore\", \"ignore\", \"ignore\"], detached: true });\n      containment!.kill();\n      child.on(\"close\", async () => resolve({ ms: Date.now() - started, final: await containment!.final }));\n    });\ncli/test/eval_integrity.test.ts:402:  const containment = { cleaned: true, survivorsAfterExit: 0 };\ncli/test/eval_integrity.test.ts:406:  assert.equal(observeT4Fixture(task, agent, { cleaned: false, survivorsAfterExit: 1 }, {}).at(0).evidence.containmentCleaned, false);\ncli/test/eval_integrity.test.ts:690:  if (process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) assert.equal(isolation, null, \"the dedicated test tmpfs and kernel resource contract must pass preflight\");\ncli/test/eval_integrity.test.ts:730:test(\"resource contract: candidate memory, processes, storage and CPU are kernel-bounded and every process is reaped\", async () => {\ncli/test/eval_integrity.test.ts:744:    assert.ok(memory.resources.oomKills >= 1, JSON.stringify(memory.resources));\ncli/test/eval_integrity.test.ts:756:    // to the task cgroup and must hit memory.max. Neither failure may leave a task process behind.\ncli/test/eval_integrity.test.ts:759:    assert.equal(workspaceDisk.resources.oomKills, 0, JSON.stringify(workspaceDisk.resources));\ncli/test/eval_integrity.test.ts:765:    assert.ok(sandboxDisk.resources.oomKills >= 1, JSON.stringify(sandboxDisk.resources));\ncli/test/eval_integrity.test.ts:773:    // The wall-clock kill goes through the cgroup, so the supervisor still proves cleanup.\ncli/test/eval_integrity.test.ts:789:    // A process that leaves the session and process group is still found in, and removed from, the cgroup.\ncli/test/eval_integrity.test.ts:796:    assert.ok(escaped.survivorsAfterExit >= 1, JSON.stringify(escaped));\ncli/test/eval_integrity.test.ts:799:    assert.equal(fs.existsSync(escapedMarker), false, \"a session-escaped task process survived cgroup cleanup\");\ncli/test/eval_integrity.test.ts:969:    // Never remove mounted candidate paths until the resource supervisor confirms that its cgroup was emptied.\neval/README.md:112:capacity to exhausted. Both require successful cgroup cleanup with no survivors. Task metadata cannot provide\neval/README.md:166:writable-storage limits come from the resource contract below, not from request/token ceilings. Appliance-specific\neval/README.md:246:- Each execution runs under `eval/cgroup_supervisor.mjs` as the only process of its own delegated transient\neval/README.md:247:  `systemd-run --user --scope`. The supervisor writes cgroup v2 `cpu.max` (`cpuPercent`% of one CPU), `memory.max`\neval/README.md:255:  The preflight checks `/proc/self/mountinfo`, the mount root and options, the effective tmpfs size, and the cgroup\neval/README.md:259:- Within that cap, tmpfs pages, including the sandbox's own `/tmp`, are charged to the writing phase's memory cgroup and\neval/README.md:261:  it reaches that bound the whole phase is OOM-killed (`memory.oom.group`), and this is recorded. When a phase's cgroup\neval/README.md:262:  is removed, the kernel moves its charges to the unlimited parent cgroup. Later phases get their own `memoryBytes`,\neval/README.md:266:- This contract is supported only on Linux with cgroup v2 CPU, memory and pids controllers, a delegated systemd user\neval/README.md:270:- After the command exits or times out, the supervisor records the remaining processes, empties the cgroup with\neval/README.md:271:  `cgroup.kill` (which reaches daemonized processes and other uids), and waits for `populated 0`. A timeout or output\neval/README.md:275:- Each run record carries `resources.{agent,hidden,regression}`: the applied limits, `memoryPeakBytes`, `oomKills`,\neval/README.md:276:  `memoryMaxEvents`, `pidsPeak`, `pidsMaxEvents`, `cpuUsageUsec`, `cpuThrottledUsec`, `survivorsAfterExit` and\neval/README.md:280:  provisions delegation with `scripts/ensure-ci-user-cgroups.sh`, and the fixture tests in\neval/score.mjs:283:    // The kernel resource contract (eval/resources.mjs) is part of the matched conditions: same CPU, memory, process\neval/score.mjs:285:    if (!manifest.config.resources) failPairs(`${agent} manifest has no resource contract`);\neval/T3.md:13:`eval/run.mjs` runs a `\"tier\": \"T3\"` task with the same sandbox, model proxy, resource contract, workspace staging and\neval/t3.mjs:2:// that carries steering, by eval/run.mjs inside the same sandbox, proxy and resource contract as every other run.\neval/isolate.mjs:371:    // Contained runs are stopped through their cgroup, so the supervisor survives to prove cleanup.\neval/run.mjs:110:// Qualification proves the resource contract inside hiddenTestIsolationProblem; a development config may opt in.\neval/run.mjs:178:  // Under the resource contract these are on a tmpfs, so candidate writes count against the run's memory limit.\neval/run.mjs:535:    throw new Error(\"sigterm_resume requires an installed Nexus qualification run with the kernel resource contract\");\neval/run.mjs:644:    // Under the resource contract the cgroup is emptied instead, so the supervisor survives to report cleanup.\neval/run.mjs:678:      // A contained payload is already reaped by cgroup_supervisor before its final report. Do not race that\neval/run.mjs:772:  const sourceFiles = [\"eval/run.mjs\", \"eval/validate.mjs\", \"eval/t4_fixtures.mjs\", \"eval/isolate.mjs\", \"eval/hide_oracle.cjs\", \"eval/hide_oracle.py\", \"eval/unlink_then_exec.sh\", \"eval/agent_sandbox.mjs\", \"eval/model_proxy.mjs\", \"eval/score.mjs\", \"eval/infra.mjs\", \"eval/workspace.mjs\", \"eval/resources.mjs\", \"eval/cgroup_supervisor.mjs\", \"eval/t3.mjs\", \"eval/hardened_check.mjs\"];\neval/oracle.mjs:92:  const containment = { executions: 0, oomKills: 0, pidsMaxEvents: 0, survivorsAfterExit: 0 };\neval/oracle.mjs:118:      containment.oomKills += result.resources.oomKills ?? 0;\neval/oracle.mjs:120:      containment.survivorsAfterExit += result.resources.survivorsAfterExit;\neval/validate.mjs:281:/** Qualification needs the kernel-enforced resource contract (eval/resources.mjs), proved on this host before any run. */\neval/t4_fixtures.mjs:27:    problems.push(\"full_disk requires a positive storageLimitBytes matching the qualification resource contract\");\neval/t4_fixtures.mjs:40:  const clean = containment?.cleaned === true && containment?.survivorsAfterExit === 0;\neval/cgroup_supervisor.mjs:4:// cgroup (cgroup.kill reaches processes of another uid and ones that left the process group or session).\neval/cgroup_supervisor.mjs:6:// fd 3 receives JSON lines: { cgroup } once the payload leaf exists, then exactly one final report.\neval/cgroup_supervisor.mjs:25:const own = (read(\"/proc/self/cgroup\") ?? \"\").split(\"\\n\").find((line) => line.startsWith(\"0::\"))?.slice(3);\neval/cgroup_supervisor.mjs:27:const scope = path.join(\"/sys/fs/cgroup\", own);\neval/cgroup_supervisor.mjs:36:  fs.writeFileSync(path.join(supervisor, \"cgroup.procs\"), String(process.pid));\neval/cgroup_supervisor.mjs:37:  fs.writeFileSync(path.join(scope, \"cgroup.subtree_control\"), \"+cpu +memory +pids\");\neval/cgroup_supervisor.mjs:45:report({ cgroup: payload });\neval/cgroup_supervisor.mjs:52:// The shell joins the payload cgroup before exec, so nothing task-controlled ever runs outside the limits.\neval/cgroup_supervisor.mjs:53:const child = spawn(\"/bin/sh\", [\"-c\", 'echo $$ > \"$1\" && shift && exec \"$@\"', \"sh\", path.join(payload, \"cgroup.procs\"), spec.cmd, ...spec.argv], {\neval/cgroup_supervisor.mjs:57:const killPayload = () => { try { fs.writeFileSync(path.join(payload, \"cgroup.kill\"), \"1\"); } catch {} };\neval/cgroup_supervisor.mjs:60:  const pids = (read(path.join(payload, \"cgroup.procs\")) ?? \"\").split(\"\\n\").filter(Boolean).map(Number).filter(Number.isSafeInteger);\neval/cgroup_supervisor.mjs:69:    if (/^populated 1$/m.test(read(path.join(payload, \"cgroup.events\")) ?? \"\")) {\neval/cgroup_supervisor.mjs:102:  // requested grace interval elapse before cgroup cleanup escalates to SIGKILL.\neval/cgroup_supervisor.mjs:105:  const procs = (read(path.join(payload, \"cgroup.procs\")) ?? \"\").split(\"\\n\").filter(Boolean);\neval/cgroup_supervisor.mjs:112:    oomKills: memoryEvents.oom_kill ?? null,\neval/cgroup_supervisor.mjs:118:    survivorsAfterExit: procs.length,\neval/cgroup_supervisor.mjs:123:    if (/^populated 0$/m.test(read(path.join(payload, \"cgroup.events\")) ?? \"\")) {\neval/cgroup_supervisor.mjs:128:      report({ ...stats, cleaned: false, signals: signalRequests, exitCode: code, signal, spawnError, error: \"payload cgroup still populated after cgroup.kill\" });\neval/host/README.md:5:systemd 255, cgroup v2 with `cpu memory pids` delegated to the operator's user manager. Inference is remote (the\neval/host/README.md:16:| Size-capped tmpfs | `srv-nexus\\x2dqual-ws.mount` at `/srv/nexus-qual/ws`, `size=storageBytes,mode=0711,uid=<operator>,nosuid,nodev` | The resource contract's `workspaceRoot`: the hard cap on what a run keeps, across all phases. |\neval/host/README.md:41:run's cgroup. `validate.mjs` checks this.\neval/host/README.md:49:`maxMemoryPeakMiB` 1206.5, `maxPidsPeak` 163, `maxWorkspaceMiB` 225.0, `oomKills` 0, and `pidsMaxEvents` 0.\neval/host/README.md:56:| `storageBytes` | 20 GiB | The size of the dedicated tmpfs. It caps everything a run holds in its workspace and home **across phases**, because when a phase's cgroup is removed, its tmpfs charges move to the unlimited parent. Writes beyond the cap fail with `ENOSPC`. Runs are serial, and each run's directories are removed afterwards. |\neval/host/validate.mjs:75:await check(\"the host applies and cleans up the resource contract\", () => {\neval/host/validate.mjs:80:await check(\"evaluator processes stay in the limited cgroup, and every one is reaped\", async () => {\neval/host/validate.mjs:89:    const sandboxed = await contained(isolatedArgv({ cwd: dir, home: false, command: \"id -u > /workspace/uid; cat /proc/self/cgroup > /workspace/cgroup; mkdir -p /workspace/private; echo secret > /workspace/private/f; chmod 600 /workspace/private/f; chmod 700 /workspace/private\", timeoutSec: 30 }));\neval/host/validate.mjs:92:    must(/\\/payload$/.test(fs.readFileSync(path.join(dir, \"cgroup\"), \"utf8\").trim()), \"evaluator process is not in the payload cgroup\");\neval/host/validate.mjs:95:    // Without a PID namespace nothing but the cgroup can reap a daemon: the operator-side supervisor must find the\neval/host/validate.mjs:98:    must(daemon?.survivorsAfterExit >= 1, `the evaluator daemon was not left for the cgroup to reap: ${JSON.stringify(daemon)}`);\neval/host/validate.mjs:101:    return `limits ${JSON.stringify(sandboxed.limits)}; reaped ${daemon.survivorsAfterExit} evaluator survivor(s)`;\neval/host/validate.mjs:166:  sourceDigests: [\"eval/host/validate.mjs\", \"eval/host/operator_home.mjs\", \"eval/host/bubblewrap.mjs\", \"eval/host/provision.sh\", \"eval/host/rollback.sh\", \"eval/host/resource-profile.json\", \"eval/resources.mjs\", \"eval/cgroup_supervisor.mjs\", \"eval/isolate.mjs\", \"eval/validate.mjs\", \"eval/run.mjs\", \"eval/hardened_check.mjs\", \"eval/hide_oracle.cjs\", \"eval/hide_oracle.py\", \"eval/unlink_then_exec.sh\", \"eval/workspace.mjs\"].map((file) => ({ file, sha256: createHash(\"sha256\").update(fs.readFileSync(path.join(ROOT, file))).digest(\"hex\") })),\neval/resources.mjs:1:// Kernel-enforced resource contract for task-controlled executions (eval/README.md, \"Resource contract\").\neval/resources.mjs:2:// Each execution runs in its own delegated transient systemd --user scope under eval/cgroup_supervisor.mjs, which\neval/resources.mjs:3:// applies cgroup v2 cpu.max, memory.max (swap 0) and pids.max to a payload leaf, verifies them, and kills the whole\neval/resources.mjs:4:// cgroup afterwards. Workspaces and homes live on a dedicated size-capped tmpfs (storageBytes): that cap bounds\neval/resources.mjs:12:const SUPERVISOR = fileURLToPath(new URL(\"./cgroup_supervisor.mjs\", import.meta.url));\neval/resources.mjs:111: * Spawn `spec` (contained when `resources` is set). `containment.kill()` empties the payload cgroup;\neval/resources.mjs:120:  let cgroup = null;\neval/resources.mjs:125:      cgroup ??= reports.cgroup;\neval/resources.mjs:143:  const killPayload = () => { if (cgroup) { try { fs.writeFileSync(path.join(cgroup, \"cgroup.kill\"), \"1\"); } catch {} } };\neval/resources.mjs:164:  if (!final.cleaned) return \"payload cgroup was not emptied\";\neval/resources.mjs:169:  let cgroup = null;\neval/resources.mjs:175:    if (value.cgroup && Object.keys(value).length === 1) cgroup = value.cgroup;\neval/resources.mjs:178:  return { cgroup, final };\n0::/user.slice/user-1000.slice/session-4.scope\ncpuset cpu io memory hugetlb pids rdma misc\n","exit_code":1,"duration":{"secs":0,"nanos":770692734}},"started_at_ms":1793137905559,"completed_at_ms":1793137906330}}
