{"timestamp":"2026-10-27T17:42:04.144Z","ordinal":419839,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17e71-922f-7ef3-a2c1-bcdcbd1f8423","item":{"type":"CommandExecution","id":"exec-6887ebd4-93bb-46d5-ae03-18cfac8640c6","process_id":"22152","command":["/usr/bin/zsh","-lc","sed -n '1,190p' cli/src/credentials.ts && sed -n '1,220p' cli/src/provider_cli.ts"],"cwd":"file:///home/mike/nexus-wt/rc10-readiness-20261027","parsed_cmd":[{"type":"read","cmd":"sed -n '1,190p' cli/src/credentials.ts","name":"credentials.ts","path":"cli/src/credentials.ts"},{"type":"read","cmd":"sed -n '1,220p' cli/src/provider_cli.ts","name":"provider_cli.ts","path":"cli/src/provider_cli.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * Provider credentials: where each provider's key or sign-in comes from, in precedence order.\n *\n * 1. The provider's environment variable (operator environment / config.env / process env).\n * 2. Nexus's own store, ~/.config/nexus/credentials.json (mode 0600), written by `nexus connect` and the TUI.\n * 3. Connections already registered in other clients on this machine, read in place and never modified:\n *    Codex CLI (~/.codex/auth.json), opencode (~/.local/share/opencode/auth.json), crush\n *    (~/.local/share/crush/crush.json) and the GitHub Copilot editor plugins (~/.config/github-copilot/apps.json).\n *\n * An OAuth token read from another client is used while valid and re-read when it expires; Nexus never refreshes it,\n * because refresh tokens rotate and refreshing would sign the owning client out. All files are read from the\n * operator's credential home (credentialStorageHome), never from a HOME a project .env set.\n */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { credentialStorageHome } from \"./client.js\";\n\nexport type StoredCredential =\n  | { type: \"api\"; key: string; label?: string; savedAt: string }\n  | {\n      type: \"oauth\";\n      access: string;\n      /** Refresh token (ChatGPT) or GitHub OAuth token (Copilot). */\n      refresh?: string;\n      /** Epoch ms; undefined when unknown. */\n      expiresAt?: number;\n      accountId?: string;\n      label?: string;\n      savedAt: string;\n    };\n\nexport interface ResolvedCredential {\n  /** Where it came from, for the operator: \"$OPENAI_API_KEY\", \"Nexus\", \"Codex CLI\", \"opencode\", ... */\n  source: string;\n  kind: \"env\" | \"nexus\" | \"external\";\n  credential: StoredCredential;\n  /** False for tokens owned by another client: Nexus must not refresh them. */\n  refreshable: boolean;\n  /** File it was read from (external and nexus). */\n  file?: string;\n}\n\ninterface StoreFile {\n  version: 1;\n  providers: Record<string, StoredCredential>;\n}\n\nconst LOCAL_ENDPOINT_CREDENTIAL_PREFIX = \"nexus-local-endpoint:\";\n\n/** Stable credential-store key for one exact HTTP(S) origin; the credential never follows another endpoint. */\nfunction localEndpointCredentialId(endpoint: string): string | undefined {\n  try {\n    const url = new URL(endpoint);\n    if ((url.protocol !== \"http:\" && url.protocol !== \"https:\") || url.username || url.password || url.origin === \"null\") return undefined;\n    return `${LOCAL_ENDPOINT_CREDENTIAL_PREFIX}${url.origin}`;\n  } catch {\n    return undefined;\n  }\n}\n\nexport function saveLocalEndpointCredential(endpoint: string, key: string): boolean {\n  const id = localEndpointCredentialId(endpoint);\n  const value = key.trim();\n  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n  saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n  return true;\n}\n\n/** Save a verified endpoint key and its selected model as one failure-atomic setup operation. */\nexport function commitLocalEndpointSetup(endpoint: string, key: string, commitSettings: () => void): boolean {\n  const id = localEndpointCredentialId(endpoint);\n  const value = key.trim();\n  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n\n  const file = credentialsPath();\n  let previous: StoredCredential | undefined;\n  try {\n    const stat = fs.lstatSync(file);\n    if (stat.isSymbolicLink() || !stat.isFile()) throw new Error(\"The Nexus credential store is not a regular file.\");\n    const parsed = JSON.parse(fs.readFileSync(file, \"utf8\"));\n    if (!parsed || typeof parsed !== \"object\" || parsed.version !== 1 || !parsed.providers || typeof parsed.providers !== \"object\" || Array.isArray(parsed.providers)) {\n      throw new Error(\"The Nexus credential store has an unsupported format.\");\n    }\n    if (Object.hasOwn(parsed.providers, id)) {\n      const entry = parsed.providers[id];\n      if (!entry || typeof entry !== \"object\" || entry.type !== \"api\" || typeof entry.key !== \"string\" || !entry.key || typeof entry.savedAt !== \"string\") {\n        throw new Error(\"The local endpoint credential has an unsupported format.\");\n      }\n      previous = entry;\n    }\n  } catch (error: any) {\n    if (error?.code !== \"ENOENT\") throw new Error(\"Nexus could not safely update its credential store.\");\n  }\n  const hadStore = fs.existsSync(file);\n  try {\n    saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n    commitSettings();\n    return true;\n  } catch (error) {\n    try {\n      if (previous) {\n        saveCredential(id, previous);\n      } else {\n        removeCredential(id);\n        if (!hadStore && Object.keys(readStore().providers).length === 0) {\n          try { fs.unlinkSync(file); } catch (unlinkError: any) { if (unlinkError?.code !== \"ENOENT\") throw unlinkError; }\n        }\n      }\n    } catch (rollbackError) {\n      throw new AggregateError([error, rollbackError], \"Local endpoint setup failed and its saved credential could not be restored.\");\n    }\n    throw error;\n  }\n}\n\nexport function localEndpointCredential(endpoint: string): { origin: string; key: string } | undefined {\n  const id = localEndpointCredentialId(endpoint);\n  if (!id) return undefined;\n  const credential = readStore().providers[id];\n  if (credential?.type !== \"api\") return undefined;\n  return { origin: id.slice(LOCAL_ENDPOINT_CREDENTIAL_PREFIX.length), key: credential.key };\n}\n\n/** Used only to prevent a project or caller-supplied key from escaping its saved endpoint origin. */\nexport function localEndpointCredentials(): Array<{ origin: string; key: string }> {\n  const store = readStore();\n  const result: Array<{ origin: string; key: string }> = [];\n  for (const [id, credential] of Object.entries(store.providers)) {\n    if (!id.startsWith(LOCAL_ENDPOINT_CREDENTIAL_PREFIX) || credential.type !== \"api\") continue;\n    const origin = id.slice(LOCAL_ENDPOINT_CREDENTIAL_PREFIX.length);\n    if (localEndpointCredentialId(origin) === id) result.push({ origin, key: credential.key });\n  }\n  return result;\n}\n\nexport function credentialsPath(): string {\n  return path.join(credentialStorageHome(), \".config/nexus/credentials.json\");\n}\n\nfunction readJson(file: string): any {\n  try {\n    return JSON.parse(fs.readFileSync(file, \"utf-8\"));\n  } catch {\n    return undefined;\n  }\n}\n\nfunction readStore(): StoreFile {\n  const raw = readJson(credentialsPath());\n  return raw && typeof raw === \"object\" && raw.providers && typeof raw.providers === \"object\"\n    ? { version: 1, providers: raw.providers }\n    : { version: 1, providers: {} };\n}\n\n/** Atomic, owner-only write: a credential file is never briefly world-readable or half-written. */\nfunction writeStore(store: StoreFile): void {\n  const file = credentialsPath();\n  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });\n  const tmp = `${file}.${process.pid}.tmp`;\n  fs.writeFileSync(tmp, JSON.stringify(store, null, 2) + \"\\n\", { mode: 0o600 });\n  fs.renameSync(tmp, file);\n  fs.chmodSync(file, 0o600);\n}\n\nexport function saveCredential(providerId: string, credential: StoredCredential): void {\n  const store = readStore();\n  store.providers[providerId] = credential;\n  writeStore(store);\n}\n\n/** Removes Nexus's own credential; connections owned by other clients or the environment are untouched. */\nexport function removeCredential(providerId: string): boolean {\n  const store = readStore();\n  if (!(providerId in store.providers)) return false;\n  delete store.providers[providerId];\n  writeStore(store);\n  return true;\n}\n\n/** Expiry (epoch ms) from a JWT's `exp` claim, without verifying it (advisory only). */\nexport function jwtExpiry(token: string | undefined): number | undefined {\n  const claims = jwtClaims(token);\n  return typeof claims?.exp === \"number\" ? claims.exp * 1000 : undefined;\n}\n\nexport function jwtClaims(token: string | undefined): Record<string, any> | undefined {\n  const part = token?.split(\".\")[1];\n  if (!part) return undefined;\n  try {\n    return JSON.parse(Buffer.from(part.replace(/-/g, \"+\").replace(/_/g, \"/\"), \"base64\").toString(\"utf-8\"));\n/**\n * Operator surface for cloud providers: what is configured, which credentials are present (never their values),\n * where each role's requests go, and an opt-in live check that a provider/model completes a tool round trip.\n */\nimport type { Command } from \"commander\";\nimport { randomUUID } from \"node:crypto\";\nimport pc from \"picocolors\";\nimport { InferenceError, LocalLlmClient, operatorSetting } from \"./client.js\";\nimport { buildConfig } from \"./config.js\";\nimport { baseUrlSetting, disclosureClass, PROVIDERS } from \"./providers.js\";\nimport type { ChatMessage, HarnessConfig, ToolDefinition } from \"./types.js\";\nimport { UsageLedger } from \"./usage.js\";\nimport { resolveCredential } from \"./credentials.js\";\nimport { connectLocalEndpoint, connectWithKey, disconnect, startSignIn } from \"./provider_connect.js\";\nimport { redactSecrets } from \"./ui.js\";\n\n/** One line naming each role's selected destination and its disclosure class. */\nexport function describeTarget(config: HarnessConfig): string {\n  const target = (provider: string | undefined, endpoint: string, model: string) => {\n    // Endpoint paths, userinfo, query strings and model ids are operator-controlled environment/config values.\n    // Show only the parsed origin and a model id that passes the display allowlist.\n    const origin = safeOriginOf(endpoint);\n    const label = provider ? PROVIDERS[provider]?.label ?? \"Cloud provider\" : \"Local endpoint\";\n    const where = origin ? `${label} (${origin})` : `${label} (endpoint unavailable)`;\n    return `${where} · ${model ? safeModelId(model) : \"no model\"} · ${disclosureClass(endpoint, provider, config.cloudRoutedOrigins)}`;\n  };\n  const parts = [`main: ${target(config.provider, config.endpoint, config.model)}`];\n  if (config.plannerModel) {\n    const p = config.plannerProvider ?? (config.plannerEndpoint ? undefined : config.provider);\n    parts.push(`planner: ${target(p, config.plannerEndpoint ?? config.endpoint, config.plannerModel)}`);\n  }\n  if (config.coderModel) {\n    const p = config.coderProvider ?? (config.coderEndpoint ? undefined : config.provider);\n    parts.push(`coder: ${target(p, config.coderEndpoint ?? config.endpoint, config.coderModel)}`);\n  }\n  return `[nexus] Inference — ${parts.join(\" | \")}`;\n}\n\nfunction credentialShaped(value: string): boolean {\n  return [\n    /sk-[A-Za-z0-9_-]{8,}/i,\n    /(?:gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,})/i,\n    /xox[baprs]-[A-Za-z0-9-]{10,}/i,\n    /AKIA[0-9A-Z]{16}/i,\n    /AIza[0-9A-Za-z_-]{35}/i,\n    /ya29\\.[0-9A-Za-z_-]{20,}/,\n    /eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}/i,\n  ].some((pattern) => pattern.test(value));\n}\n\n/** Keep endpoint attribution while removing credential-shaped labels from displayed hostnames. */\nfunction safeOriginOf(value: string | undefined): string | undefined {\n  if (!value?.trim()) return undefined;\n  try {\n    const url = new URL(value.trim());\n    const spansHostnameLabels = [\n      /ya29\\.[A-Za-z0-9_-]{20,}/i,\n      /eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}/i,\n    ].some((pattern) => pattern.test(url.hostname));\n    const hostname = spansHostnameLabels\n      ? \"(redacted)\"\n      : url.hostname.split(\".\").map((label) => credentialShaped(label) ? \"(redacted)\" : label).join(\".\");\n    return `${url.protocol}//${hostname}${url.port ? `:${url.port}` : \"\"}`;\n  } catch {\n    return undefined;\n  }\n}\n\nfunction safeProviderId(value: string | undefined): string | undefined {\n  return value && Object.prototype.hasOwnProperty.call(PROVIDERS, value) ? value : value ? \"(unrecognized provider)\" : undefined;\n}\n\nfunction safeConfigurationError(error: unknown): string {\n  const message = error instanceof Error ? error.message : \"\";\n  const match = /^Unknown provider '([^'\\r\\n]{1,128})' \\([A-Z0-9_]{1,64}\\)\\. Known providers: [A-Za-z0-9, ]+\\.$/.exec(message);\n  if (!match) return \"Configuration error: provider configuration is invalid\";\n  // An unknown provider name comes from user configuration; even identifier-shaped values may be secrets.\n  return `Configuration error: Unknown provider '(unrecognized provider)'. Known providers: ${Object.keys(PROVIDERS).join(\", \")}.`;\n}\n\nfunction safeModelId(value: string): string {\n  // Provider/model identifiers may contain routing punctuation, but not whitespace, controls or arbitrary diagnostics.\n  if (!/^[A-Za-z0-9._:\\/@+-]{1,160}$/.test(value)) return \"(unprintable model id)\";\n  return credentialShaped(value) ? \"(unprintable model id)\" : value;\n}\n\nfunction safeClientDiagnostic(message: string, config: HarnessConfig): string {\n  let safe = redactSecrets(message);\n  const substitute = (raw: string | undefined, replacement: string | undefined) => {\n    if (raw && replacement && raw !== replacement) safe = safe.replaceAll(raw, () => replacement);\n  };\n  if (config.model) substitute(config.model, safeModelId(config.model));\n  const safeOrigin = safeOriginOf(config.endpoint);\n  if (safeOrigin) {\n    substitute(config.endpoint.trim(), safeOrigin);\n    try {\n      const endpoint = new URL(config.endpoint.trim());\n      substitute(endpoint.href, safeOrigin);\n      substitute(`${endpoint.origin}${endpoint.pathname}${endpoint.search}${endpoint.hash}`, safeOrigin);\n      substitute(`${endpoint.origin}${endpoint.pathname}`, safeOrigin);\n      substitute(endpoint.origin, safeOrigin);\n      substitute(endpoint.hostname, new URL(safeOrigin).hostname);\n      substitute(endpoint.pathname, \"(path redacted)\");\n      substitute(endpoint.search, \"\");\n      substitute(endpoint.hash, \"\");\n    } catch {\n      // Invalid endpoints are rejected by config validation before the live check starts.\n    }\n  }\n  return safe;\n}\n\nconst SAFE_FAILURE_KINDS = new Set([\n  \"http_error\", \"network_error\", \"timeout\", \"stream_interrupted\", \"stream_incomplete\", \"provider_error_frame\",\n  \"malformed_event\", \"output_truncated\", \"protocol_error\", \"aborted\", \"policy_denied\", \"configuration_error\", \"verification_error\",\n]);\nconst SAFE_FAILURE_CONDITIONS = new Set([\n  \"TEMPORARILY_UNAVAILABLE\", \"RATE_LIMITED\", \"OVERLOADED\", \"DRAINING\", \"AUTH_FAILURE\", \"QUOTA_EXHAUSTED\",\n  \"CAPACITY_REJECTED\", \"REQUEST_REJECTED\", \"PERMANENT_FAILURE\", \"AVAILABLE\",\n]);\n\nfunction safeStepDetail(ok: boolean, detail: string): string {\n  if (!ok) return detail === \"Provider request failed\" ? detail : \"Verification failed\";\n  if (/^streamed completion received \\(\\d+ chars\\)$/.test(detail)) return detail;\n  if (/^echo_token tool call completed \\(\\d+ call\\(s\\)\\)$/.test(detail)) return detail;\n  return detail === \"tool result round trip completed\" ? detail : \"Verification succeeded\";\n}\n\n/** A credential-safe JSON projection for `providers verify --json`; raw provider diagnostics are deliberately omitted. */\nexport function verificationSummary(\n  steps: readonly VerificationStep[],\n  receipts: readonly import(\"./usage.js\").InferenceReceipt[],\n  target?: Pick<HarnessConfig, \"provider\" | \"model\">,\n) {\n  const provider = safeProviderId(target?.provider ?? receipts[0]?.providerId);\n  const model = target?.model ?? receipts[0]?.selectedModel;\n  return {\n    passed: steps.length === 3 && steps.every((step) => step.ok),\n    ...(provider ? { provider } : {}),\n    ...(model ? { model: safeModelId(model) } : {}),\n    steps: steps.map(({ step, ok, requestId, detail, failureKind, failureCondition }) => {\n      const safeKind = failureKind && SAFE_FAILURE_KINDS.has(failureKind) ? failureKind : undefined;\n      const safeCondition = failureCondition && SAFE_FAILURE_CONDITIONS.has(failureCondition) ? failureCondition : undefined;\n      return {\n        step, ok, requestId, detail: safeStepDetail(ok, detail),\n        ...(safeKind ? { failureKind: safeKind } : {}),\n        ...(safeCondition ? { condition: safeCondition } : {}),\n      };\n    }),\n    receipts: receipts.map(({ at, requestId, role, providerId, selectedModel, effectiveModel, endpointOrigin, protocol, disclosure, executions, outcome, failureKind, usage, usageConfidence, costConfidence }) => {\n      const origin = safeOriginOf(endpointOrigin);\n      return {\n        at, requestId, role, providerId: safeProviderId(providerId) ?? \"(unrecognized provider)\",\n        selectedModel: safeModelId(selectedModel),\n        ...(effectiveModel ? { effectiveModel: safeModelId(effectiveModel) } : {}),\n        ...(origin ? { endpointOrigin: origin } : {}),\n        protocol, disclosure, ...(executions !== undefined ? { executions } : {}), outcome,\n        ...(failureKind && SAFE_FAILURE_KINDS.has(failureKind) ? { failureKind } : {}), ...(usage ? { usage } : {}), usageConfidence, costConfidence,\n      };\n    }),\n  };\n}\n\nconst ECHO_TOOL: ToolDefinition = {\n  type: \"function\",\n  function: {\n    name: \"echo_token\",\n    description: \"Echo the given token back. Call this exactly once with the token the user gives you.\",\n    parameters: { type: \"object\", properties: { token: { type: \"string\", description: \"The token to echo\" } }, required: [\"token\"] },\n  },\n};\n\nexport interface VerificationStep {\n  step: string;\n  ok: boolean;\n  detail: string;\n  requestId: string;\n  failureKind?: string;\n  failureCondition?: string;\n}\n\n/**\n * Live qualification without workspace content: a streamed completion, then a tool round trip (the model must call\n * echo_token with a nonce, receive its result and answer). Each step is one receipt in the usage ledger.\n */\nexport async function verifyProvider(\n  config: HarnessConfig,\n  signal?: AbortSignal,\n  options?: { diagnosticHandler?: (level: \"error\" | \"warn\", message: string) => void },\n): Promise<VerificationStep[]> {\n  const client = new LocalLlmClient({ ...config, maxSteps: 1 }, { role: \"qualification\", diagnosticHandler: options?.diagnosticHandler });\n  const steps: VerificationStep[] = [];\n  const run = async (step: string, fn: (requestId: string) => Promise<string>) => {\n    const requestId = randomUUID();\n    try {\n      steps.push({ step, ok: true, detail: await fn(requestId), requestId });\n    } catch (err: any) {\n      steps.push({\n        step,\n        ok: false,\n        detail: err instanceof InferenceError ? \"Provider request failed\" : \"Verification failed\",\n        requestId,\n        failureKind: err instanceof InferenceError ? err.kind : \"verification_error\",\n        ...(err instanceof InferenceError ? { failureCondition: err.condition } : {}),\n      });\n    }\n  };\n  await run(\"streamed completion\", async (id) => {\n    let streamed = \"\";\n    const m = await client.chatCompletionStream([{ role: \"user\", content: \"Reply with exactly the word READY.\" }], [], (t) => (streamed += t), id, signal);\n    const text = typeof m.content === \"string\" ? m.content : \"\";\n    if (!/READY/i.test(text)) throw new Error(`unexpected reply: ${text.slice(0, 80)}`);\n    return `streamed completion received (${streamed.length} chars)`;\n  });\n  if (!steps[0].ok) return steps;\n  const nonce = `n${randomUUID().slice(0, 8)}`;\n  const history: ChatMessage[] = [\n    { role: \"system\", content: \"You are a connectivity check. Use the tool when asked.\" },\n    { role: \"user\", content: `Call echo_token with token \"${nonce}\", then tell me what it returned.` },\n  ];\n","exit_code":0,"duration":{"secs":0,"nanos":699508310}},"started_at_ms":1793122923444,"completed_at_ms":1793122924144}}
{"timestamp":"2026-10-27T17:42:05.216Z","ordinal":419840,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17e74-7aa0-7300-bb80-e4cc97595949","call_id":"call_86119520195a4b8cbe41a6471c0ce423","output":[{"type":"input_text","text":"Script completed\nWall time 3.0 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 4761)\nTotal output lines: 410\n\n/**\n * Provider credentials: where each provider's key or sign-in comes from, in precedence order.\n *\n * 1. The provider's environment variable (operator environment / config.env / process env).\n * 2. Nexus's own store, ~/.config/nexus/credentials.json (mode 0600), written by `nexus connect` and the TUI.\n * 3. Connections already registered in other clients on this machine, read in place and never modified:\n *    Codex CLI (~/.codex/auth.json), opencode (~/.local/share/opencode/auth.json), crush\n *    (~/.local/share/crush/crush.json) and the GitHub Copilot editor plugins (~/.config/github-copilot/apps.json).\n *\n * An OAuth token read from another client is used while valid and re-read when it expires; Nexus never refreshes it,\n * because refresh tokens rotate and refreshing would sign the owning client out. All files are read from the\n * operator's credential home (credentialStorageHome), never from a HOME a project .env set.\n */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { credentialStorageHome } from \"./client.js\";\n\nexport type StoredCredential =\n  | { type: \"api\"; key: string; label?: string; savedAt: string }\n  | {\n      type: \"oauth\";\n      access: string;\n      /** Refresh token (ChatGPT) or GitHub OAuth token (Copilot). */\n      refresh?: string;\n      /** Epoch ms; undefined when unknown. */\n      expiresAt?: number;\n      accountId?: string;\n      label?: string;\n      savedAt: string;\n    };\n\nexport interface ResolvedCredential {\n  /** Where it came from, for the operator: \"$OPENAI_API_KEY\", \"Nexus\", \"Codex CLI\", \"opencode\", ... */\n  source: string;\n  kind: \"env\" | \"nexus\" | \"external\";\n  credential: StoredCredential;\n  /** False for tokens owned by another client: Nexus must not refresh them. */\n  refreshable: boolean;\n  /** File it was read from (external and nexus). */\n  file?: string;\n}\n\ninterface StoreFile {\n  version: 1;\n  providers: Record<string, StoredCredential>;\n}\n\nconst LOCAL_ENDPOINT_CREDENTIAL_PREFIX = \"nexus-local-endpoint:\";\n\n/** Stable credential-store key for one exact HTTP(S) origin; the credential never follows another endpoint. */\nfunction localEndpointCredentialId(endpoint: string): string | undefined {\n  try {\n    const url = new URL(endpoint);\n    if ((url.protocol !== \"http:\" && url.protocol !== \"https:\") || url.username || url.password || url.origin === \"null\") return undefined;\n    return `${LOCAL_ENDPOINT_CREDENTIAL_PREFIX}${url.origin}`;\n  } catch {\n    return undefined;\n  }\n}\n\nexport function saveLocalEndpointCredential(endpoint: string, key: string): boolean {\n  const id = localEndpointCredentialId(endpoint);\n  const value = key.trim();\n  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n  saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n  return true;\n}\n\n/** Save a verified endpoint key and its selected model as one failure-atomic setup operation. */\nexport function commitLocalEndpointSetup(endpoint: string, key: string, commitSettings: () => void): boolean {\n  const id = localEndpointCredentialId(endpoint);\n  const value = key.trim();\n  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n\n  const file = credentialsPath();\n  let previous: StoredCredential | undefined;\n  try {\n    const stat = fs.lstatSync(file);\n    if (stat.isSymbolicLink() || !stat.isFile()) throw new Error(\"The Nexus credential store is not a regular file.\");\n    const parsed = JSON.parse(fs.readFileSync(file, \"utf8\"));\n    if (!parsed || typeof parsed !== \"object\" || parsed.version !== 1 || !parsed.providers || typeof parsed.providers !== \"object\" || Array.isArray(parsed.providers)) {\n      throw new Error(\"The Nexus credential store has an unsupported format.\");\n    }\n    if (Object.hasOwn(parsed.providers, id)) {\n      const entry = parsed.providers[id];\n      if (!entry || typeof entry !== \"object\" || entry.type !== \"api\" || typeof entry.key !== \"string\" || !entry.key || typeof entry.savedAt !== \"string\") {\n        throw new Error(\"The local endpoint credential has an unsupported format.\");\n      }\n      previous = entry;\n    }\n  } catch (error: any) {\n    if (error?.code !== \"ENOENT\") throw new Error(\"Nexus could not safely update its credential store.\");\n  }\n  const hadStore = fs.existsSync(file);\n  try {\n    saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n    commitSettings();\n    return true;\n  } catch (error) {\n    try {\n      if (previous) {\n        saveCredential(id, previous);\n      } else {\n        removeCredential(id);\n        if (!hadStore && Object.keys(readStore().providers).length === 0) {\n          try { fs.unlinkSync(file); } catch (unlinkError: any) { if (unlinkError?.code !== \"ENOENT\") throw unlinkError; }\n        }\n      }\n    } catch (rollbackError) {\n      throw new AggregateError([error, rollbackError], \"Local endpoint setup failed and its saved credential could not be restored.\");\n    }\n    throw error;\n  }\n}\n\nexport function localEndpointCredential(endpoint: string): { origin: string; key: string } | undefined {\n  const id = localEndpointCredentialId(endpoint);\n  if (!id) return undefined;\n  const credential = readStore().providers[id];\n  if (credential?.type !== \"api\") return undefined;\n  return { origin: id.slice(LOCAL_ENDPOINT_CREDENTIAL_PREFIX.length), key: credential.key };\n}\n\n/** Used only to prevent a project or caller-supplied key from escaping its saved endpoint origin. */\nexport function localEndpointCredentials(): Array<{ origin: string; key: string }> {\n  const store = readStore();\n  const result: Array<{ origin: string; key: string }> = [];\n  for (const [id, credential] of Object.entries(store.providers)) {\n    if (!id.startsWith(LOCAL_ENDPOINT_CREDENTIAL_PREFIX) || credential.type !== \"api\") continue;\n    const origin = id.slice(LOCAL_ENDPOINT_CREDENTIAL_PREFIX.length);\n    if (localEndpointCredentialId(origin) === id) result.push({ origin, key: credential.key });\n  }\n  return result;\n}\n\nexport function credentialsPath(): string {\n  return path.join(credentialStorageHome(), \".config/nexus/credentials.json\");\n}\n\nfunction readJson(file: string): any {\n  try {\n    return JSON.parse(fs.readFileSync(file, \"utf-8\"));\n  } catch {\n    return undefined;\n  }\n}\n\nfunction readStore(): StoreFile {\n  const raw = readJson(credentialsPath());\n  return raw && typeof raw === \"object\" && raw.providers && typeof raw.providers === \"object\"\n    ? { version: 1, providers: raw.providers }\n    : { version: 1, providers: {} };\n}\n\n/** Atomic, owner-only write: a credential file is never briefly world-readable or half-written. */\nfunction writeStore(store: StoreFile): void {\n  const file = credentialsPath();\n  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });\n  const tmp = `${file}.${process.pid}.tmp`;\n  fs.writeFileSync(tmp, JSON.stringify(store, null, 2) + \"\\n\", { mode: 0o600 });\n  fs.renameSync(tmp, file);\n  fs.chmodSync(file, 0o600);\n}\n\nexport function saveCredential(providerId: string, credential: StoredCredential): void {\n  const store = readStore();\n  store.providers[providerId] = credential;\n  writeStore(store);\n}\n\n/** Removes Nexus's own credential; connections owned by other clients or the environment are untouched. */\nexport function removeCredential(providerId: string): boolean {\n  const store = readStore();\n  if (!(providerId in store.providers)) return false;\n  delete store.providers[providerId];\n  writeStore(store);\n  return true;\n}\n\n/** Expiry (epoch ms) from a JWT's `exp` claim, without verifying it (advisory only). */\nexport function jwtExpiry(token: string | undefined): number | undefined {\n  const claims = jwtClaims(token);\n  return typeof claims?.exp === \"number\" ? claims.exp * 1000 : undefined;\n}\n\nexport function jwtClaims(token: string | undefined): Record<string, any> | undefined {\n  const part = token?.split(\".\")[1];\n  if (!part) return undefined;\n  try {\n    return JSON.parse(Buffer.from(part.replace(/-/g, \"+\").replace(/_/g, \"/\"), \"base64\").toString(\"utf-8\"));\n/**\n * Operator surface for cloud providers: w…761 tokens truncated…n.test(url.hostname));\n    const hostname = spansHostnameLabels\n      ? \"(redacted)\"\n      : url.hostname.split(\".\").map((label) => credentialShaped(label) ? \"(redacted)\" : label).join(\".\");\n    return `${url.protocol}//${hostname}${url.port ? `:${url.port}` : \"\"}`;\n  } catch {\n    return undefined;\n  }\n}\n\nfunction safeProviderId(value: string | undefined): string | undefined {\n  return value && Object.prototype.hasOwnProperty.call(PROVIDERS, value) ? value : value ? \"(unrecognized provider)\" : undefined;\n}\n\nfunction safeConfigurationError(error: unknown): string {\n  const message = error instanceof Error ? error.message : \"\";\n  const match = /^Unknown provider '([^'\\r\\n]{1,128})' \\([A-Z0-9_]{1,64}\\)\\. Known providers: [A-Za-z0-9, ]+\\.$/.exec(message);\n  if (!match) return \"Configuration error: provider configuration is invalid\";\n  // An unknown provider name comes from user configuration; even identifier-shaped values may be secrets.\n  return `Configuration error: Unknown provider '(unrecognized provider)'. Known providers: ${Object.keys(PROVIDERS).join(\", \")}.`;\n}\n\nfunction safeModelId(value: string): string {\n  // Provider/model identifiers may contain routing punctuation, but not whitespace, controls or arbitrary diagnostics.\n  if (!/^[A-Za-z0-9._:\\/@+-]{1,160}$/.test(value)) return \"(unprintable model id)\";\n  return credentialShaped(value) ? \"(unprintable model id)\" : value;\n}\n\nfunction safeClientDiagnostic(message: string, config: HarnessConfig): string {\n  let safe = redactSecrets(message);\n  const substitute = (raw: string | undefined, replacement: string | undefined) => {\n    if (raw && replacement && raw !== replacement) safe = safe.replaceAll(raw, () => replacement);\n  };\n  if (config.model) substitute(config.model, safeModelId(config.model));\n  const safeOrigin = safeOriginOf(config.endpoint);\n  if (safeOrigin) {\n    substitute(config.endpoint.trim(), safeOrigin);\n    try {\n      const endpoint = new URL(config.endpoint.trim());\n      substitute(endpoint.href, safeOrigin);\n      substitute(`${endpoint.origin}${endpoint.pathname}${endpoint.search}${endpoint.hash}`, safeOrigin);\n      substitute(`${endpoint.origin}${endpoint.pathname}`, safeOrigin);\n      substitute(endpoint.origin, safeOrigin);\n      substitute(endpoint.hostname, new URL(safeOrigin).hostname);\n      substitute(endpoint.pathname, \"(path redacted)\");\n      substitute(endpoint.search, \"\");\n      substitute(endpoint.hash, \"\");\n    } catch {\n      // Invalid endpoints are rejected by config validation before the live check starts.\n    }\n  }\n  return safe;\n}\n\nconst SAFE_FAILURE_KINDS = new Set([\n  \"http_error\", \"network_error\", \"timeout\", \"stream_interrupted\", \"stream_incomplete\", \"provider_error_frame\",\n  \"malformed_event\", \"output_truncated\", \"protocol_error\", \"aborted\", \"policy_denied\", \"configuration_error\", \"verification_error\",\n]);\nconst SAFE_FAILURE_CONDITIONS = new Set([\n  \"TEMPORARILY_UNAVAILABLE\", \"RATE_LIMITED\", \"OVERLOADED\", \"DRAINING\", \"AUTH_FAILURE\", \"QUOTA_EXHAUSTED\",\n  \"CAPACITY_REJECTED\", \"REQUEST_REJECTED\", \"PERMANENT_FAILURE\", \"AVAILABLE\",\n]);\n\nfunction safeStepDetail(ok: boolean, detail: string): string {\n  if (!ok) return detail === \"Provider request failed\" ? detail : \"Verification failed\";\n  if (/^streamed completion received \\(\\d+ chars\\)$/.test(detail)) return detail;\n  if (/^echo_token tool call completed \\(\\d+ call\\(s\\)\\)$/.test(detail)) return detail;\n  return detail === \"tool result round trip completed\" ? detail : \"Verification succeeded\";\n}\n\n/** A credential-safe JSON projection for `providers verify --json`; raw provider diagnostics are deliberately omitted. */\nexport function verificationSummary(\n  steps: readonly VerificationStep[],\n  receipts: readonly import(\"./usage.js\").InferenceReceipt[],\n  target?: Pick<HarnessConfig, \"provider\" | \"model\">,\n) {\n  const provider = safeProviderId(target?.provider ?? receipts[0]?.providerId);\n  const model = target?.model ?? receipts[0]?.selectedModel;\n  return {\n    passed: steps.length === 3 && steps.every((step) => step.ok),\n    ...(provider ? { provider } : {}),\n    ...(model ? { model: safeModelId(model) } : {}),\n    steps: steps.map(({ step, ok, requestId, detail, failureKind, failureCondition }) => {\n      const safeKind = failureKind && SAFE_FAILURE_KINDS.has(failureKind) ? failureKind : undefined;\n      const safeCondition = failureCondition && SAFE_FAILURE_CONDITIONS.has(failureCondition) ? failureCondition : undefined;\n      return {\n        step, ok, requestId, detail: safeStepDetail(ok, detail),\n        ...(safeKind ? { failureKind: safeKind } : {}),\n        ...(safeCondition ? { condition: safeCondition } : {}),\n      };\n    }),\n    receipts: receipts.map(({ at, requestId, role, providerId, selectedModel, effectiveModel, endpointOrigin, protocol, disclosure, executions, outcome, failureKind, usage, usageConfidence, costConfidence }) => {\n      const origin = safeOriginOf(endpointOrigin);\n      return {\n        at, requestId, role, providerId: safeProviderId(providerId) ?? \"(unrecognized provider)\",\n        selectedModel: safeModelId(selectedModel),\n        ...(effectiveModel ? { effectiveModel: safeModelId(effectiveModel) } : {}),\n        ...(origin ? { endpointOrigin: origin } : {}),\n        protocol, disclosure, ...(executions !== undefined ? { executions } : {}), outcome,\n        ...(failureKind && SAFE_FAILURE_KINDS.has(failureKind) ? { failureKind } : {}), ...(usage ? { usage } : {}), usageConfidence, costConfidence,\n      };\n    }),\n  };\n}\n\nconst ECHO_TOOL: ToolDefinition = {\n  type: \"function\",\n  function: {\n    name: \"echo_token\",\n    description: \"Echo the given token back. Call this exactly once with the token the user gives you.\",\n    parameters: { type: \"object\", properties: { token: { type: \"string\", description: \"The token to echo\" } }, required: [\"token\"] },\n  },\n};\n\nexport interface VerificationStep {\n  step: string;\n  ok: boolean;\n  detail: string;\n  requestId: string;\n  failureKind?: string;\n  failureCondition?: string;\n}\n\n/**\n * Live qualification without workspace content: a streamed completion, then a tool round trip (the model must call\n * echo_token with a nonce, receive its result and answer). Each step is one receipt in the usage ledger.\n */\nexport async function verifyProvider(\n  config: HarnessConfig,\n  signal?: AbortSignal,\n  options?: { diagnosticHandler?: (level: \"error\" | \"warn\", message: string) => void },\n): Promise<VerificationStep[]> {\n  const client = new LocalLlmClient({ ...config, maxSteps: 1 }, { role: \"qualification\", diagnosticHandler: options?.diagnosticHandler });\n  const steps: VerificationStep[] = [];\n  const run = async (step: string, fn: (requestId: string) => Promise<string>) => {\n    const requestId = randomUUID();\n    try {\n      steps.push({ step, ok: true, detail: await fn(requestId), requestId });\n    } catch (err: any) {\n      steps.push({\n        step,\n        ok: false,\n        detail: err instanceof InferenceError ? \"Provider request failed\" : \"Verification failed\",\n        requestId,\n        failureKind: err instanceof InferenceError ? err.kind : \"verification_error\",\n        ...(err instanceof InferenceError ? { failureCondition: err.condition } : {}),\n      });\n    }\n  };\n  await run(\"streamed completion\", async (id) => {\n    let streamed = \"\";\n    const m = await client.chatCompletionStream([{ role: \"user\", content: \"Reply with exactly the word READY.\" }], [], (t) => (streamed += t), id, signal);\n    const text = typeof m.content === \"string\" ? m.content : \"\";\n    if (!/READY/i.test(text)) throw new Error(`unexpected reply: ${text.slice(0, 80)}`);\n    return `streamed completion received (${streamed.length} chars)`;\n  });\n  if (!steps[0].ok) return steps;\n  const nonce = `n${randomUUID().slice(0, 8)}`;\n  const history: ChatMessage[] = [\n    { role: \"system\", content: \"You are a connectivity check. Use the tool when asked.\" },\n    { role: \"user\", content: `Call echo_token with token \"${nonce}\", then tell me what it returned.` },\n  ];\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17e71-922f-7ef3-a2c1-bcdcbd1f8423","create_time":1793122925.2161834}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
