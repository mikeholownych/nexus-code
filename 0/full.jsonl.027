RMINAL: WorkUnitStatus[] = [\"COMPLETE\", \"BLOCKED\"];\n\n/** An operator decision Nexus will not apply (stale, not offered, or outside the unit's authority). */\nexport class DecisionRejected extends Error {}\n\nexport const isRequired = (u: Pick<WorkUnit, \"required\">): boolean => u.required !== false;\n\n'''\nPath(\"cli/src/core/scheduler.ts\").write_text(header + \"\\\\n\".join(scheduler) + \"\\\\n\")\nPY\ngit diff --stat\ncd cli && npm run build`,workdir:\"/home/mike/nexus-wt/operation-scheduler-extraction\",yield_time_ms:1000,max_output_tokens:2000}); text(JSON.stringify(r))\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a17ef2-de25-7482-bff6-192772052d26","create_time":1793135167.351334}}}
