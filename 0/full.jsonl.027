{"timestamp":"2026-10-27T18:26:24.042Z","ordinal":422320,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17e71-922f-7ef3-a2c1-bcdcbd1f8423","item":{"type":"CommandExecution","id":"exec-c8009025-8842-43eb-a9e8-8052922e6de6","process_id":"99837","command":["/usr/bin/zsh","-lc","cat ~/xerj-sources/nexus-code/.origin-main-sha; git -C /home/mike/nexus-code ls-tree -r --name-only origin/main | rg '(^|/)(upgrade|upgrade_journal)\\.ts$'; git -C /home/mike/nexus-code show origin/main:cli/src/upgrade.ts | sed -n '610,720p';"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"cat ~/xerj-sources/nexus-code/.origin-main-sha; git -C /home/mike/nexus-code ls-tree -r --name-only origin/main | rg '(^|/)(upgrade|upgrade_journal)\\.ts$'; git -C /home/mike/nexus-code show origin/main:cli/src/upgrade.ts | sed -n '610,720p';"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"7a860c091297abc13371d92ae9633a9f06d67f7a\ncli/src/upgrade.ts\ncli/src/upgrade_journal.ts\n    target,\n    targetVersion: targetTag,\n    targetSemver: targetSem,\n    action,\n    canUpgrade,\n    reasons,\n  };\n}\n\n// -----------------------------------------------------------------------------\n// Download, Verification, and Atomic Installation\n// -----------------------------------------------------------------------------\n\nexport function validateDownloadUrl(urlString: string): boolean {\n  let parsed: URL;\n  try {\n    parsed = new URL(urlString);\n  } catch {\n    return false;\n  }\n\n  // Reject URLs with embedded credentials (user:pass@...)\n  if (parsed.username || parsed.password) {\n    return false;\n  }\n\n  const hostname = parsed.hostname.toLowerCase();\n\n  // Test / override environments: allow custom release base URL or releases API host\n  const customBase = process.env.NEXUS_RELEASE_BASE_URL || process.env.NEXUS_RELEASES_URL || process.env.NEXUS_RELEASES_API;\n  if (customBase) {\n    try {\n      const customParsed = new URL(customBase);\n      if (hostname === customParsed.hostname.toLowerCase()) {\n        if (parsed.protocol === \"https:\" || parsed.protocol === \"http:\") {\n          return true;\n        }\n      }\n    } catch {}\n  }\n\n  // Localhost allowed for local mock testing\n  if (hostname === \"127.0.0.1\" || hostname === \"localhost\") {\n    return parsed.protocol === \"http:\" || parsed.protocol === \"https:\";\n  }\n\n  // GitHub allowed domains - must be HTTPS\n  if (parsed.protocol !== \"https:\") {\n    return false;\n  }\n\n  if (hostname === \"github.com\") {\n    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n  }\n\n  if (hostname === \"objects.githubusercontent.com\") {\n    return true;\n  }\n\n  // GitHub now redirects release downloads to its signed release-assets host.\n  // Restrict the path to release objects; never allow this host as a generic CDN.\n  if (hostname === \"release-assets.githubusercontent.com\") {\n    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n  }\n\n  return false;\n}\n\n/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\nfunction safeDownloadOrigin(urlString: string): string {\n  try {\n    return new URL(urlString).origin;\n  } catch {\n    return \"invalid URL\";\n  }\n}\n\nfunction isDownloadConnectionReset(error: any): boolean {\n  for (let current = error; current; current = current.cause) {\n    if (current.code === \"ECONNRESET\" || current.code === \"UND_ERR_SOCKET\") return true;\n  }\n  return false;\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n  let connectionResets = 0;\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\n  if (signal) {\n    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n  }\n\n  try {\n    while (hops <= maxHops) {\n      if (!validateDownloadUrl(currentUrl)) {\n        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n      }\n\n      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n        headers.Authorization = `Bearer ${token}`;\n","exit_code":0,"duration":{"secs":0,"nanos":39456}},"started_at_ms":1793125584042,"completed_at_ms":1793125584042}}
