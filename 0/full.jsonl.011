{"timestamp":"2026-11-28T08:50:50.541Z","ordinal":318322,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a22143-fcf9-7462-927e-e66d27ee2285","item":{"type":"CommandExecution","id":"exec-8f0f2645-b91a-4174-8e3b-ff63b8102b8b","process_id":"22020","command":["/usr/bin/zsh","-lc","sed -n '1,190p' cli/src/core/inference_admission.ts; sed -n '850,965p' cli/src/core/operation_runner.ts; sed -n '1300,1410p' cli/src/client.ts; rg -n \"withOperationInferenceAdmission|runWithOperation.*Admission|InferenceSubmissionAdmission\" cli/src"],"cwd":"file:///home/mike/nexus-wt/p10-02-file-crash-evidence","parsed_cmd":[{"type":"read","cmd":"sed -n '1,190p' cli/src/core/inference_admission.ts","name":"inference_admission.ts","path":"cli/src/core/inference_admission.ts"},{"type":"read","cmd":"sed -n '850,965p' cli/src/core/operation_runner.ts","name":"operation_runner.ts","path":"cli/src/core/operation_runner.ts"},{"type":"read","cmd":"sed -n '1300,1410p' cli/src/client.ts","name":"client.ts","path":"cli/src/client.ts"},{"type":"search","cmd":"rg -n 'withOperationInferenceAdmission|runWithOperation.*Admission|InferenceSubmissionAdmission' cli/src","query":"withOperationInferenceAdmission|runWithOperation.*Admission|InferenceSubmissionAdmission","path":"cli"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import { AsyncLocalStorage } from \"node:async_hooks\";\n\nexport interface InferenceSubmissionAdmissionScope {\n  active: boolean;\n  closed: boolean;\n  requiresOutputTokenLimit: boolean;\n  admit?: (estimatedInputTokens?: number, requestedOutputTokens?: number) => number | void;\n  reserve?: () => unknown;\n  markDispatched?: (reservation: unknown) => void;\n  settle?: (reservation: unknown, outcome: \"response_received\" | \"unknown\" | \"not_dispatched\") => void;\n}\n\nexport interface InferenceSubmissionLease {\n  readonly entries: Array<{ scope: InferenceSubmissionAdmissionScope; reservation: unknown }>;\n  dispatched: boolean;\n  settled: boolean;\n}\n\nexport interface InferenceSubmissionAdmission {\n  outputTokenLimit?: number;\n  lease: InferenceSubmissionLease;\n}\n\nexport type OperationInferenceAdmissionFailure = \"budget_exhausted\" | \"token_budget_exhausted\" | \"output_limit_unsupported\" | \"history_unknown\" | \"persistence_failed\";\n\n/** A durable operation's outer admission boundary refused a provider request before dispatch. */\nexport class OperationInferenceAdmissionError extends Error {\n  constructor(readonly failure: OperationInferenceAdmissionFailure, message: string) {\n    super(message);\n    this.name = \"OperationInferenceAdmissionError\";\n  }\n}\n\nconst scopes = new AsyncLocalStorage<readonly InferenceSubmissionAdmissionScope[]>();\n\n/**\n * Run a turn inside an inference-admission context. Nested turns inherit every active parent admission, so an\n * in-turn delegate must satisfy both its own durable limit and each enclosing task's remaining allowance.\n */\nexport async function withInferenceSubmissionAdmissionScope<T>(\n  run: (scope: InferenceSubmissionAdmissionScope) => Promise<T>,\n): Promise<T> {\n  const scope: InferenceSubmissionAdmissionScope = { active: false, closed: false, requiresOutputTokenLimit: false };\n  const inherited = scopes.getStore() ?? [];\n  return scopes.run([...inherited, scope], async () => {\n    try {\n      return await run(scope);\n    } finally {\n      scope.active = false;\n      scope.closed = true;\n      scope.admit = undefined;\n      scope.reserve = undefined;\n      scope.markDispatched = undefined;\n      scope.settle = undefined;\n    }\n  });\n}\n\nexport function activateInferenceSubmissionAdmissionScope(\n  scope: InferenceSubmissionAdmissionScope,\n  admit: (estimatedInputTokens?: number, requestedOutputTokens?: number) => number | void,\n  options: {\n    requireOutputTokenLimit?: boolean;\n    reserve?: () => unknown;\n    markDispatched?: (reservation: unknown) => void;\n    settle?: (reservation: unknown, outcome: \"response_received\" | \"unknown\" | \"not_dispatched\") => void;\n  } = {},\n): void {\n  if (scope.closed || scope.active) throw new Error(\"Inference admission scope cannot be activated in its current state.\");\n  scope.admit = admit;\n  scope.reserve = options.reserve;\n  scope.markDispatched = options.markDispatched;\n  scope.settle = options.settle;\n  scope.requiresOutputTokenLimit = options.requireOutputTokenLimit === true;\n  scope.active = true;\n}\n\n/** Durably mark this specific admitted request immediately before crossing the provider boundary. */\nexport function markCurrentInferenceSubmissionDispatched(lease: InferenceSubmissionLease): void {\n  if (lease.settled || lease.dispatched) throw new Error(\"Inference submission lease cannot be dispatched in its current state.\");\n  for (const { scope, reservation } of lease.entries) {\n    if (scope.closed || !scope.active) throw new Error(\"Inference request outlived its active turn scope; refusing dispatch.\");\n    scope.markDispatched?.(reservation);\n  }\n  lease.dispatched = true;\n}\n\n/** Resolve or record uncertainty for the exact request in every enclosing durable admission scope. */\nexport function settleCurrentInferenceSubmission(lease: InferenceSubmissionLease, outcome: \"response_received\" | \"unknown\" | \"not_dispatched\"): void {\n  if (lease.settled) throw new Error(\"Inference submission lease has already been settled.\");\n  let failure: unknown;\n  for (const { scope, reservation } of lease.entries) {\n    if (scope.closed || !scope.active) {\n      failure ??= new Error(\"Inference response outlived its active turn scope; refusing settlement.\");\n      continue;\n    }\n    try {\n      scope.settle?.(reservation, outcome);\n    } catch (error) {\n      failure ??= error;\n    }\n  }\n  lease.settled = true;\n  if (failure !== undefined) throw failure;\n}\n\n/** Whether any active durable scope requires the serialized request to carry its output-token limit. */\nexport function currentInferenceOutputTokenLimitRequired(): boolean {\n  return (scopes.getStore() ?? []).some((scope) => scope.active && !scope.closed && scope.requiresOutputTokenLimit);\n}\n\n/** Reserve synchronously before a client sends a chat-completion request; return the tightest admitted output cap. */\nexport function beginCurrentInferenceSubmission(estimatedInputTokens?: number, requestedOutputTokens?: number): InferenceSubmissionAdmission {\n  let outputLimit: number | undefined;\n  const active: InferenceSubmissionAdmissionScope[] = [];\n  for (const scope of scopes.getStore() ?? []) {\n    if (scope.closed) throw new Error(\"Inference request outlived its active turn scope; refusing dispatch.\");\n    if (!scope.active) continue;\n    const scopedLimit = scope.admit!(estimatedInputTokens, requestedOutputTokens);\n    if (scope.requiresOutputTokenLimit && (!Number.isSafeInteger(scopedLimit) || scopedLimit! < 1)) {\n      throw new OperationInferenceAdmissionError(\"output_limit_unsupported\", \"A configured durable token budget did not produce a positive provider output-token limit; no provider request was sent.\");\n    }\n    if (scopedLimit !== undefined) outputLimit = outputLimit === undefined ? scopedLimit : Math.min(outputLimit, scopedLimit);\n    active.push(scope);\n  }\n  return {\n    outputTokenLimit: outputLimit,\n    lease: {\n      entries: active.map((scope) => ({ scope, reservation: scope.reserve?.() })),\n      dispatched: false,\n      settled: false,\n    },\n  };\n}\n\nexport function admitCurrentInferenceSubmission(estimatedInputTokens?: number, requestedOutputTokens?: number): number | undefined {\n  return beginCurrentInferenceSubmission(estimatedInputTokens, requestedOutputTokens).outputTokenLimit;\n}\n    return true;\n  }\n\n  private pauseForInferenceSubmissionBudget(): boolean {\n    if (this.state.status === \"COMPLETE\" || this.state.status === \"CANCELLED\" || this.state.status === \"PAUSED\") return false;\n    const cap = this.state.policy.maxInferenceCalls;\n    const count = this.state.inferenceCalls;\n    const reason = `Paused: operation inference submission budget exhausted (${count} of ${cap} provider requests). Raise the cap with 'nexus operation budget ${this.state.id} --max-total-inference-submissions <n>', then resume; blocked units need an explicit retry decision.`;\n    this.state.status = \"PAUSED\";\n    this.operationBudgetAdmissionPaused = true;\n    this.state.pauseReason = reason;\n    delete this.state.wait;\n    delete this.state.blocked;\n    this.scheduler.emit(\"OPERATION_PAUSED\", reason, { detail: { reason: \"inference_submission_budget\", inferenceCalls: count, maxInferenceCalls: cap } });\n    this.save();\n    return true;\n  }\n\n  private pauseForUnknownInferenceHistory(): void {\n    const cap = this.state.policy.maxInferenceCalls;\n    const reason = `Paused: this operation predates durable inference request accounting, so its prior request count is unknown. No new provider request was sent. Start an explicit accounting epoch with 'nexus operation budget ${this.state.id} --max-total-inference-submissions <n> --reset-inference-submission-history', then resume, or cancel.`;\n    this.state.status = \"PAUSED\";\n    this.state.pauseReason = reason;\n    delete this.state.wait;\n    delete this.state.blocked;\n    this.scheduler.emit(\"OPERATION_PAUSED\", reason, { detail: { reason: \"inference_submission_history_unknown\", knownInferenceSubmissions: this.state.inferenceCalls, maxInferenceCalls: cap } });\n    this.save();\n  }\n\n  private reserveInferenceSubmission(estimatedInputTokens?: number, requestedOutputTokens?: number): number | undefined {\n    if (!this.state.historyKnown) {\n      try {\n        this.pauseForUnknownInferenceHistory();\n      } catch (error: any) {\n        throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation inference budget state could not be saved before provider dispatch: ${error?.message ?? error}`);\n      }\n      throw new OperationInferenceAdmissionError(\"history_unknown\", this.state.pauseReason ?? \"Operation inference request history is unknown; no provider request was sent.\");\n    }\n    const cap = this.state.policy.maxInferenceCalls;\n    if (this.state.status === \"PAUSED\" || this.state.inferenceCalls >= cap) {\n      try {\n        this.pauseForInferenceSubmissionBudget();\n      } catch (error: any) {\n        throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation inference budget state could not be saved before provider dispatch: ${error?.message ?? error}`);\n      }\n      throw new OperationInferenceAdmissionError(\n        \"budget_exhausted\",\n        `operation inference submission budget exhausted (${this.state.inferenceCalls}/${cap}); the operation is paused and no additional provider request was sent`,\n      );\n    }\n\n    const tokenCap = this.state.policy.maxTotalTokens;\n    let nextTokenReservations = this.state.tokenReservations;\n    let admittedOutputTokens: number | undefined;\n    if (tokenCap !== undefined) {\n      if (!Number.isSafeInteger(estimatedInputTokens) || estimatedInputTokens! < 1 || !Number.isSafeInteger(requestedOutputTokens) || requestedOutputTokens! < 1) {\n        try {\n          this.pauseForUnmeasuredTokenBudget(tokenCap);\n        } catch (error: any) {\n          throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation token budget state could not be saved before provider dispatch: ${error?.message ?? error}`);\n        }\n        throw new OperationInferenceAdmissionError(\n          \"token_budget_exhausted\",\n          \"operation token budget requires positive, safe per-request input and output-token estimates; no provider request was sent\",\n        );\n      }\n      const reserved = nextTokenReservations;\n      if (!Number.isSafeInteger(reserved) || reserved! < 0) {\n        try {\n          this.pauseForUnmeasuredTokenBudget(tokenCap);\n        } catch (error: any) {\n          throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation token budget state could not be saved before provider dispatch: ${error?.message ?? error}`);\n        }\n        throw new OperationInferenceAdmissionError(\n          \"token_budget_exhausted\",\n          \"operation token budget reservation history is unavailable; no provider request was sent\",\n        );\n      }\n      const availableOutputTokens = tokenCap - reserved! - estimatedInputTokens!;\n      if (availableOutputTokens < 1) {\n        const minimumRequestEstimate = estimatedInputTokens! + 1;\n        const reason = `operation token budget reservation exhausted (${reserved} reserved + ${minimumRequestEstimate} minimum requested estimate exceeds ${tokenCap}); no provider request was sent`;\n        try {\n          this.pauseForTokenReservationBudget(reserved!, minimumRequestEstimate, tokenCap);\n        } catch (error: any) {\n          throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation token budget pause could not be saved before provider dispatch: ${error?.message ?? error}`);\n        }\n        throw new OperationInferenceAdmissionError(\"token_budget_exhausted\", reason);\n      }\n      admittedOutputTokens = Math.min(requestedOutputTokens!, availableOutputTokens);\n      nextTokenReservations = reserved! + estimatedInputTokens! + admittedOutputTokens;\n    }\n\n    this.state.inferenceCalls += 1;\n    if (tokenCap !== undefined) this.state.tokenReservations = nextTokenReservations;\n    try {\n      // Synchronous state persistence completes before the provider call can be dispatched. Request estimates are\n      // never refunded: cancellation, retries, or an unknown provider outcome must not reopen admitted capacity.\n      this.save();\n    } catch (error: any) {\n      this.state.status = \"PAUSED\";\n      this.state.pauseReason = `Paused: provider request allowance could not be durably saved; no request was sent (${error?.message ?? error}).`;\n      this.operationBudgetAdmissionPaused = true;\n      throw new OperationInferenceAdmissionError(\n        \"persistence_failed\",\n        `operation inference submission and token allowance could not be durably saved before provider dispatch: ${error?.message ?? error}`,\n      );\n    }\n    return admittedOutputTokens;\n  }\n\n  private pauseForTokenReservationBudget(reserved: number, requested: number, cap: number): void {\n    if (this.state.status === \"COMPLETE\" || this.state.status === \"CANCELLED\" || this.state.status === \"PAUSED\") return;\n    const reason = `Paused: operation token estimate exhausted (${reserved} reserved + ${requested} requested estimate exceeds ${cap} tokens). Raise the cap with 'nexus operation budget ${this.state.id} --max-total-tokens <n|none>', then resume.`;\n    this.state.status = \"PAUSED\";\n    this.operationBudgetAdmissionPaused = true;\n          this.emitDiagnostic(\"warn\",\n            pc.dim(\n              `⚠️ [Failover] ${operationName} failed on ${persistableEndpoint(currentEp)} (${err.message}). Trying backup endpoint ${persistableEndpoint(this.endpoints[nextIdx])}...`\n            )\n          );\n        }\n      }\n    }\n\n    throw (\n      lastError ||\n      new Error(\n        `All inference endpoints failed for ${operationName} (attempted: ${this.endpoints.map((e) => persistableEndpoint(e)).join(\", \")})`\n      )\n    );\n  }\n\n  /** An operation URL on an endpoint, carrying the provider's fixed query parameters (such as Azure's `api-version`). */\n  private endpointUrl(endpoint: string, pathAndQuery: string): string {\n    const entries = Object.entries(this.conn.query);\n    if (!entries.length) return `${endpoint}${pathAndQuery}`;\n    const url = new URL(`${endpoint}${pathAndQuery}`);\n    for (const [k, v] of entries) if (!url.searchParams.has(k)) url.searchParams.set(k, v);\n    return url.toString();\n  }\n\n  async listModels(signal?: AbortSignal): Promise<string[]> {\n    return this.executeWithFailover(\"listModels\", async (currentEp) => {\n      await this.prepareCredential(currentEp);\n      const query = this.conn.protocol === \"anthropic-messages\" ? \"?limit=1000\" : this.conn.protocol === \"gemini-generate-content\" ? \"?pageSize=1000\" : this.conn.providerId === \"chatgpt\" ? \"?client_version=1.0.0\" : \"\";\n      const url = this.endpointUrl(currentEp, `/models${query}`);\n      const res = await fetch(url, {\n        headers: this.authorization(url),\n        signal: metadataSignal(signal),\n        ...this.fetchPolicy(),\n      });\n\n      if (res.status === 401 && this.reloadAuthToken(url)) {\n        const retryRes = await fetch(url, {\n          headers: this.authorization(url),\n          signal: metadataSignal(signal),\n          ...this.fetchPolicy(),\n        });\n        if (retryRes.ok) return modelIds(await retryRes.json());\n      }\n\n      if (!res.ok) {\n        const text = await res.text().catch(() => \"\");\n        throw new Error(`Server returned HTTP ${res.status}: ${boundedProviderText(text || res.statusText)}`);\n      }\n\n      return modelIds(await res.json());\n    });\n  }\n\n  /** Raw `/models` entries. Providers that publish capability metadata let the scheduler qualify resources. */\n  async listModelCatalog(signal?: AbortSignal): Promise<Array<Record<string, any>>> {\n    return this.executeWithFailover(\"listModelCatalog\", async (currentEp) => {\n      const res = await fetch(this.endpointUrl(currentEp, \"/models\"), { headers: this.authorization(currentEp), signal: metadataSignal(signal), ...this.fetchPolicy() });\n      if (!res.ok) {\n        const text = await res.text().catch(() => \"\");\n        throw new Error(`Server returned HTTP ${res.status}: ${boundedProviderText(text || res.statusText)}`);\n      }\n      const data = (await res.json()) as { data?: Array<Record<string, any>> };\n      return Array.isArray(data.data) ? data.data : [];\n    });\n  }\n\n  /** Sets the output allowance (max_tokens on local endpoints) from the connection's capabilities. */\n  public setOutputAllowance(tokens: number): void {\n    if (Number.isFinite(tokens) && tokens > 0) this.maxOutputTokens = Math.floor(tokens);\n  }\n\n  /** Input-character estimate used with the requested output allowance for durable operation token admission. */\n  private estimatedInferenceInputTokens(payloadChars: number): number {\n    return Math.ceil(payloadChars / 4);\n  }\n\n  /** Persist prompt estimate and return the maximum output allowance that fits the durable operation's remaining cap. */\n  private admitInferenceOutputTokens(payloadChars: number): { required: boolean; maxOutputTokens: number; lease: ReturnType<typeof beginCurrentInferenceSubmission>[\"lease\"] } {\n    const required = currentInferenceOutputTokenLimitRequired();\n    const admitted = beginCurrentInferenceSubmission(this.estimatedInferenceInputTokens(payloadChars), this.maxOutputTokens);\n    if (required && (!Number.isSafeInteger(admitted.outputTokenLimit) || admitted.outputTokenLimit! < 1)) {\n      throw new OperationInferenceAdmissionError(\"output_limit_unsupported\", \"A configured durable token budget did not produce a provider output-token limit; no provider request was sent.\");\n    }\n    return { required, maxOutputTokens: admitted.outputTokenLimit ?? this.maxOutputTokens, lease: admitted.lease };\n  }\n\n  private requireSerializedOutputTokenLimit(body: Record<string, unknown>, requestId: string, required: boolean, maxOutputTokens: number): void {\n    if (!required) return;\n    const serialized = serializedOutputTokenLimit(this.conn.protocol, body);\n    if (serialized === undefined || serialized > maxOutputTokens) {\n      throw new OperationInferenceAdmissionError(\n        \"output_limit_unsupported\",\n        `Provider '${this.conn.label}' cannot serialize the admitted output-token limit for ${this.conn.protocol}; no request was sent (request ${requestId}).`,\n      );\n    }\n  }\n\n  public getOutputAllowance(): number {\n    return this.maxOutputTokens;\n  }\n\n  /** The gateway's report on the most recent admitted inference request (headers), when it sent one. */\n  public getLastAdmission(): AdmissionReport | undefined {\n    return this.lastAdmission;\n  }\n\n  /**\n   * This connection's `/models` entry for the selected model, read from the active endpoint only (never a fallback or\n   * another provider: capability discovery is scoped to the connection in use). Not content-bearing.\ncli/src/core/inference_admission.ts:3:export interface InferenceSubmissionAdmissionScope {\ncli/src/core/inference_admission.ts:14:  readonly entries: Array<{ scope: InferenceSubmissionAdmissionScope; reservation: unknown }>;\ncli/src/core/inference_admission.ts:19:export interface InferenceSubmissionAdmission {\ncli/src/core/inference_admission.ts:34:const scopes = new AsyncLocalStorage<readonly InferenceSubmissionAdmissionScope[]>();\ncli/src/core/inference_admission.ts:40:export async function withInferenceSubmissionAdmissionScope<T>(\ncli/src/core/inference_admission.ts:41:  run: (scope: InferenceSubmissionAdmissionScope) => Promise<T>,\ncli/src/core/inference_admission.ts:43:  const scope: InferenceSubmissionAdmissionScope = { active: false, closed: false, requiresOutputTokenLimit: false };\ncli/src/core/inference_admission.ts:59:export function activateInferenceSubmissionAdmissionScope(\ncli/src/core/inference_admission.ts:60:  scope: InferenceSubmissionAdmissionScope,\ncli/src/core/inference_admission.ts:113:export function beginCurrentInferenceSubmission(estimatedInputTokens?: number, requestedOutputTokens?: number): InferenceSubmissionAdmission {\ncli/src/core/inference_admission.ts:115:  const active: InferenceSubmissionAdmissionScope[] = [];\ncli/src/core/operation_runner.ts:35:  activateInferenceSubmissionAdmissionScope,\ncli/src/core/operation_runner.ts:37:  withInferenceSubmissionAdmissionScope,\ncli/src/core/operation_runner.ts:724:      const result: UnitRunResult = await withInferenceSubmissionAdmissionScope(async (scope) => {\ncli/src/core/operation_runner.ts:725:        activateInferenceSubmissionAdmissionScope(\ncli/src/core/run_turn.ts:18:import { activateInferenceSubmissionAdmissionScope, OperationInferenceAdmissionError, withInferenceSubmissionAdmissionScope, type InferenceSubmissionAdmissionScope } from \"./inference_admission.js\";\ncli/src/core/run_turn.ts:81:  return withInferenceSubmissionAdmissionScope((scope) => runTurnBody.call(this, taskPrompt, onConfirm, options, scope));\ncli/src/core/run_turn.ts:84:async function runTurnBody(this: any, taskPrompt: string | any[], onConfirm: ConfirmHandler | undefined, options: { signal?: AbortSignal; resume?: boolean; tddRed?: boolean; step?: boolean } | undefined, inferenceAdmissionScope: InferenceSubmissionAdmissionScope): Promise<TurnResult> {\ncli/src/core/run_turn.ts:333:    activateInferenceSubmissionAdmissionScope(inferenceAdmissionScope, () => {\n","exit_code":0,"duration":{"secs":1,"nanos":176732286}},"started_at_ms":1795855849363,"completed_at_ms":1795855850541}}
{"timestamp":"2026-11-28T08:50:51.725Z","ordinal":318323,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a22159-a0cd-7862-aa43-722bff1f2a34","call_id":"call_3722f0c459ff414da55c359645dde538","output":[{"type":"input_text","text":"Script completed\nWall time 2.6 seconds\nOutput:\n"},{"type":"input_text","text":"import { AsyncLocalStorage } from \"node:async_hooks\";\n\nexport interface InferenceSubmissionAdmissionScope {\n  active: boolean;\n  closed: boolean;\n  requiresOutputTokenLimit: boolean;\n  admit?: (estimatedInputTokens?: number, requestedOutputTokens?: number) => number | void;\n  reserve?: () => unknown;\n  markDispatched?: (reservation: unknown) => void;\n  settle?: (reservation: unknown, outcome: \"response_received\" | \"unknown\" | \"not_dispatched\") => void;\n}\n\nexport interface InferenceSubmissionLease {\n  readonly entries: Array<{ scope: InferenceSubmissionAdmissionScope; reservation: unknown }>;\n  dispatched: boolean;\n  settled: boolean;\n}\n\nexport interface InferenceSubmissionAdmission {\n  outputTokenLimit?: number;\n  lease: InferenceSubmissionLease;\n}\n\nexport type OperationInferenceAdmissionFailure = \"budget_exhausted\" | \"token_budget_exhausted\" | \"output_limit_unsupported\" | \"history_unknown\" | \"persistence_failed\";\n\n/** A durable operation's outer admission boundary refused a provider request before dispatch. */\nexport class OperationInferenceAdmissionError extends Error {\n  constructor(readonly failure: OperationInferenceAdmissionFailure, message: string) {\n    super(message);\n    this.name = \"OperationInferenceAdmissionError\";\n  }\n}\n\nconst scopes = new AsyncLocalStorage<readonly InferenceSubmissionAdmissionScope[]>();\n\n/**\n * Run a turn inside an inference-admission context. Nested turns inherit every active parent admission, so an\n * in-turn delegate must satisfy both its own durable limit and each enclosing task's remaining allowance.\n */\nexport async function withInferenceSubmissionAdmissionScope<T>(\n  run: (scope: InferenceSubmissionAdmissionScope) => Promise<T>,\n): Promise<T> {\n  const scope: InferenceSubmissionAdmissionScope = { active: false, closed: false, requiresOutputTokenLimit: false };\n  const inherited = scopes.getStore() ?? [];\n  return scopes.run([...inherited, scope], async () => {\n    try {\n      return await run(scope);\n    } finally {\n      scope.active = false;\n      scope.closed = true;\n      scope.admit = undefined;\n      scope.reserve = undefined;\n      scope.markDispatched = undefined;\n      scope.settle = undefined;\n    }\n  });\n}\n\nexport function activateInferenceSubmissionAdmissionScope(\n  scope: InferenceSubmissionAdmissionScope,\n  admit: (estimatedInputTokens?: number, requestedOutputTokens?: number) => number | void,\n  options: {\n    requireOutputTokenLimit?: boolean;\n    reserve?: () => unknown;\n    markDispatched?: (reservation: unknown) => void;\n    settle?: (reservation: unknown, outcome: \"response_received\" | \"unknown\" | \"not_dispatched\") => void;\n  } = {},\n): void {\n  if (scope.closed || scope.active) throw new Error(\"Inference admission scope cannot be activated in its current state.\");\n  scope.admit = admit;\n  scope.reserve = options.reserve;\n  scope.markDispatched = options.markDispatched;\n  scope.settle = options.settle;\n  scope.requiresOutputTokenLimit = options.requireOutputTokenLimit === true;\n  scope.active = true;\n}\n\n/** Durably mark this specific admitted request immediately before crossing the provider boundary. */\nexport function markCurrentInferenceSubmissionDispatched(lease: InferenceSubmissionLease): void {\n  if (lease.settled || lease.dispatched) throw new Error(\"Inference submission lease cannot be dispatched in its current state.\");\n  for (const { scope, reservation } of lease.entries) {\n    if (scope.closed || !scope.active) throw new Error(\"Inference request outlived its active turn scope; refusing dispatch.\");\n    scope.markDispatched?.(reservation);\n  }\n  lease.dispatched = true;\n}\n\n/** Resolve or record uncertainty for the exact request in every enclosing durable admission scope. */\nexport function settleCurrentInferenceSubmission(lease: InferenceSubmissionLease, outcome: \"response_received\" | \"unknown\" | \"not_dispatched\"): void {\n  if (lease.settled) throw new Error(\"Inference submission lease has already been settled.\");\n  let failure: unknown;\n  for (const { scope, reservation } of lease.entries) {\n    if (scope.closed || !scope.active) {\n      failure ??= new Error(\"Inference response outlived its active turn scope; refusing settlement.\");\n      continue;\n    }\n    try {\n      scope.settle?.(reservation, outcome);\n    } catch (error) {\n      failure ??= error;\n    }\n  }\n  lease.settled = true;\n  if (failure !== undefined) throw failure;\n}\n\n/** Whether any active durable scope requires the serialized request to carry its output-token limit. */\nexport function currentInferenceOutputTokenLimitRequired(): boolean {\n  return (scopes.getStore() ?? []).some((scope) => scope.active && !scope.closed && scope.requiresOutputTokenLimit);\n}\n\n/** Reserve synchronously before a client sends a chat-completion request; return the tightest admitted output cap. */\nexport function beginCurrentInferenceSubmission(estimatedInputTokens?: number, requestedOutputTokens?: number): InferenceSubmissionAdmission {\n  let outputLimit: number | undefined;\n  const active: InferenceSubmissionAdmissionScope[] = [];\n  for (const scope of scopes.getStore() ?? []) {\n    if (scope.closed) throw new Error(\"Inference request outlived its active turn scope; refusing dispatch.\");\n    if (!scope.active) continue;\n    const scopedLimit = scope.admit!(estimatedInputTokens, requestedOutputTokens);\n    if (scope.requiresOutputTokenLimit && (!Number.isSafeInteger(scopedLimit) || scopedLimit! < 1)) {\n      throw new OperationInferenceAdmissionError(\"output_limit_unsupported\", \"A configured durable token budget did not produce a positive provider output-token limit; no provider request was sent.\");\n    }\n    if (scopedLimit !== undefined) outputLimit = outputLimit === undefined ? scopedLimit : Math.min(outputLimit, scopedLimit);\n    active.push(scope);\n  }\n  return {\n    outputTokenLimit: outputLimit,\n    lease: {\n      entries: active.map((scope) => ({ scope, reservation: scope.reserve?.() })),\n      dispatched: false,\n      settled: false,\n    },\n  };\n}\n\nexport function admitCurrentInferenceSubmission(estimatedInputTokens?: number, requestedOutputTokens?: number): number | undefined {\n  return beginCurrentInferenceSubmission(estimatedInputTokens, requestedOutputTokens).outputTokenLimit;\n}\n    return true;\n  }\n\n  private pauseForInferenceSubmissionBudget(): boolean {\n    if (this.state.status === \"COMPLETE\" || this.state.status === \"CANCELLED\" || this.state.status === \"PAUSED\") return false;\n    const cap = this.state.policy.maxInferenceCalls;\n    const count = this.state.inferenceCalls;\n    const reason = `Paused: operation inference submission budget exhausted (${count} of ${cap} provider requests). Raise the cap with 'nexus operation budget ${this.state.id} --max-total-inference-submissions <n>', then resume; blocked units need an explicit retry decision.`;\n    this.state.status = \"PAUSED\";\n    this.operationBudgetAdmissionPaused = true;\n    this.state.pauseReason = reason;\n    delete this.state.wait;\n    delete this.state.blocked;\n    this.scheduler.emit(\"OPERATION_PAUSED\", reason, { detail: { reason: \"inference_submission_budget\", inferenceCalls: count, maxInferenceCalls: cap } });\n    this.save();\n    return true;\n  }\n\n  private pauseForUnknownInferenceHistory(): void {\n    const cap = this.state.policy.maxInferenceCalls;\n    const reason = `Paused: this operation predates durable inference request accounting, so its prior request count is unknown. No new provider request was sent. Start an explicit accounting epoch with 'nexus operation budget ${this.state.id} --max-total-inference-submissions <n> --reset-inference-submission-history', then resume, or cancel.`;\n    this.state.status = \"PAUSED\";\n    this.state.pauseReason = reason;\n    delete this.state.wait;\n    delete this.state.blocked;\n    this.scheduler.emit(\"OPERATION_PAUSED\", reason, { detail: { reason: \"inference_submission_history_unknown\", knownInferenceSubmissions: this.state.inferenceCalls, maxInferenceCalls: cap } });\n    this.save();\n  }\n\n  private reserveInferenceSubmission(estimatedInputTokens?: number, requestedOutputTokens?: number): number | undefined {\n    if (!this.state.historyKnown) {\n      try {\n        this.pauseForUnknownInferenceHistory();\n      } catch (error: any) {\n        throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation inference budget state could not be saved before provider dispatch: ${error?.message ?? error}`);\n      }\n      throw new OperationInferenceAdmissionError(\"history_unknown\", this.state.pauseReason ?? \"Operation inference request history is unknown; no provider request was sent.\");\n    }\n    const cap = this.state.policy.maxInferenceCalls;\n    if (this.state.status === \"PAUSED\" || this.state.inferenceCalls >= cap) {\n      try {\n        this.pauseForInferenceSubmissionBudget();\n      } catch (error: any) {\n        throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation inference budget state could not be saved before provider dispatch: ${error?.message ?? error}`);\n      }\n      throw new OperationInferenceAdmissionError(\n        \"budget_exhausted\",\n        `operation inference submission budget exhausted (${this.state.inferenceCalls}/${cap}); the operation is paused and no additional provider request was sent`,\n      );\n    }\n\n    const tokenCap = this.state.policy.maxTotalTokens;\n    let nextTokenReservations = this.state.tokenReservations;\n    let admittedOutputTokens: number | undefined;\n    if (tokenCap !== undefined) {\n      if (!Number.isSafeInteger(estimatedInputTokens) || estimatedInputTokens! < 1 || !Number.isSafeInteger(requestedOutputTokens) || requestedOutputTokens! < 1) {\n        try {\n          this.pauseForUnmeasuredTokenBudget(tokenCap);\n        } catch (error: any) {\n          throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation token budget state could not be saved before provider dispatch: ${error?.message ?? error}`);\n        }\n        throw new OperationInferenceAdmissionError(\n          \"token_budget_exhausted\",\n          \"operation token budget requires positive, safe per-request input and output-token estimates; no provider request was sent\",\n        );\n      }\n      const reserved = nextTokenReservations;\n      if (!Number.isSafeInteger(reserved) || reserved! < 0) {\n        try {\n          this.pauseForUnmeasuredTokenBudget(tokenCap);\n        } catch (error: any) {\n          throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation token budget state could not be saved before provider dispatch: ${error?.message ?? error}`);\n        }\n        throw new OperationInferenceAdmissionError(\n          \"token_budget_exhausted\",\n          \"operation token budget reservation history is unavailable; no provider request was sent\",\n        );\n      }\n      const availableOutputTokens = tokenCap - reserved! - estimatedInputTokens!;\n      if (availableOutputTokens < 1) {\n        const minimumRequestEstimate = estimatedInputTokens! + 1;\n        const reason = `operation token budget reservation exhausted (${reserved} reserved + ${minimumRequestEstimate} minimum requested estimate exceeds ${tokenCap}); no provider request was sent`;\n        try {\n          this.pauseForTokenReservationBudget(reserved!, minimumRequestEstimate, tokenCap);\n        } catch (error: any) {\n          throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation token budget pause could not be saved before provider dispatch: ${error?.message ?? error}`);\n        }\n        throw new OperationInferenceAdmissionError(\"token_budget_exhausted\", reason);\n      }\n      admittedOutputTokens = Math.min(requestedOutputTokens!, availableOutputTokens);\n      nextTokenReservations = reserved! + estimatedInputTokens! + admittedOutputTokens;\n    }\n\n    this.state.inferenceCalls += 1;\n    if (tokenCap !== undefined) this.state.tokenReservations = nextTokenReservations;\n    try {\n      // Synchronous state persistence completes before the provider call can be dispatched. Request estimates are\n      // never refunded: cancellation, retries, or an unknown provider outcome must not reopen admitted capacity.\n      this.save();\n    } catch (error: any) {\n      this.state.status = \"PAUSED\";\n      this.state.pauseReason = `Paused: provider request allowance could not be durably saved; no request was sent (${error?.message ?? error}).`;\n      this.operationBudgetAdmissionPaused = true;\n      throw new OperationInferenceAdmissionError(\n        \"persistence_failed\",\n        `operation inference submission and token allowance could not be durably saved before provider dispatch: ${error?.message ?? error}`,\n      );\n    }\n    return admittedOutputTokens;\n  }\n\n  private pauseForTokenReservationBudget(reserved: number, requested: number, cap: number): void {\n    if (this.state.status === \"COMPLETE\" || this.state.status === \"CANCELLED\" || this.state.status === \"PAUSED\") return;\n    const reason = `Paused: operation token estimate exhausted (${reserved} reserved + ${requested} requested estimate exceeds ${cap} tokens). Raise the cap with 'nexus operation budget ${this.state.id} --max-total-tokens <n|none>', then resume.`;\n    this.state.status = \"PAUSED\";\n    this.operationBudgetAdmissionPaused = true;\n          this.emitDiagnostic(\"warn\",\n            pc.dim(\n              `⚠️ [Failover] ${operationName} failed on ${persistableEndpoint(currentEp)} (${err.message}). Trying backup endpoint ${persistableEndpoint(this.endpoints[nextIdx])}...`\n            )\n          );\n        }\n      }\n    }\n\n    throw (\n      lastError ||\n      new Error(\n        `All inference endpoints failed for ${operationName} (attempted: ${this.endpoints.map((e) => persistableEndpoint(e)).join(\", \")})`\n      )\n    );\n  }\n\n  /** An operation URL on an endpoint, carrying the provider's fixed query parameters (such as Azure's `api-version`). */\n  private endpointUrl(endpoint: string, pathAndQuery: string): string {\n    const entries = Object.entries(this.conn.query);\n    if (!entries.length) return `${endpoint}${pathAndQuery}`;\n    const url = new URL(`${endpoint}${pathAndQuery}`);\n    for (const [k, v] of entries) if (!url.searchParams.has(k)) url.searchParams.set(k, v);\n    return url.toString();\n  }\n\n  async listModels(signal?: AbortSignal): Promise<string[]> {\n    return this.executeWithFailover(\"listModels\", async (currentEp) => {\n      await this.prepareCredential(currentEp);\n      const query = this.conn.protocol === \"anthropic-messages\" ? \"?limit=1000\" : this.conn.protocol === \"gemini-generate-content\" ? \"?pageSize=1000\" : this.conn.providerId === \"chatgpt\" ? \"?client_version=1.0.0\" : \"\";\n      const url = this.endpointUrl(currentEp, `/models${query}`);\n      const res = await fetch(url, {\n        headers: this.authorization(url),\n        signal: metadataSignal(signal),\n        ...this.fetchPolicy(),\n      });\n\n      if (res.status === 401 && this.reloadAuthToken(url)) {\n        const retryRes = await fetch(url, {\n          headers: this.authorization(url),\n          signal: metadataSignal(signal),\n          ...this.fetchPolicy(),\n        });\n        if (retryRes.ok) return modelIds(await retryRes.json());\n      }\n\n      if (!res.ok) {\n        const text = await res.text().catch(() => \"\");\n        throw new Error(`Server returned HTTP ${res.status}: ${boundedProviderText(text || res.statusText)}`);\n      }\n\n      return modelIds(await res.json());\n    });\n  }\n\n  /** Raw `/models` entries. Providers that publish capability metadata let the scheduler qualify resources. */\n  async listModelCatalog(signal?: AbortSignal): Promise<Array<Record<string, any>>> {\n    return this.executeWithFailover(\"listModelCatalog\", async (currentEp) => {\n      const res = await fetch(this.endpointUrl(currentEp, \"/models\"), { headers: this.authorization(currentEp), signal: metadataSignal(signal), ...this.fetchPolicy() });\n      if (!res.ok) {\n        const text = await res.text().catch(() => \"\");\n        throw new Error(`Server returned HTTP ${res.status}: ${boundedProviderText(text || res.statusText)}`);\n      }\n      const data = (await res.json()) as { data?: Array<Record<string, any>> };\n      return Array.isArray(data.data) ? data.data : [];\n    });\n  }\n\n  /** Sets the output allowance (max_tokens on local endpoints) from the connection's capabilities. */\n  public setOutputAllowance(tokens: number): void {\n    if (Number.isFinite(tokens) && tokens > 0) this.maxOutputTokens = Math.floor(tokens);\n  }\n\n  /** Input-character estimate used with the requested output allowance for durable operation token admission. */\n  private estimatedInferenceInputTokens(payloadChars: number): number {\n    return Math.ceil(payloadChars / 4);\n  }\n\n  /** Persist prompt estimate and return the maximum output allowance that fits the durable operation's remaining cap. */\n  private admitInferenceOutputTokens(payloadChars: number): { required: boolean; maxOutputTokens: number; lease: ReturnType<typeof beginCurrentInferenceSubmission>[\"lease\"] } {\n    const required = currentInferenceOutputTokenLimitRequired();\n    const admitted = beginCurrentInferenceSubmission(this.estimatedInferenceInputTokens(payloadChars), this.maxOutputTokens);\n    if (required && (!Number.isSafeInteger(admitted.outputTokenLimit) || admitted.outputTokenLimit! < 1)) {\n      throw new OperationInferenceAdmissionError(\"output_limit_unsupported\", \"A configured durable token budget did not produce a provider output-token limit; no provider request was sent.\");\n    }\n    return { required, maxOutputTokens: admitted.outputTokenLimit ?? this.maxOutputTokens, lease: admitted.lease };\n  }\n\n  private requireSerializedOutputTokenLimit(body: Record<string, unknown>, requestId: string, required: boolean, maxOutputTokens: number): void {\n    if (!required) return;\n    const serialized = serializedOutputTokenLimit(this.conn.protocol, body);\n    if (serialized === undefined || serialized > maxOutputTokens) {\n      throw new OperationInferenceAdmissionError(\n        \"output_limit_unsupported\",\n        `Provider '${this.conn.label}' cannot serialize the admitted output-token limit for ${this.conn.protocol}; no request was sent (request ${requestId}).`,\n      );\n    }\n  }\n\n  public getOutputAllowance(): number {\n    return this.maxOutputTokens;\n  }\n\n  /** The gateway's report on the most recent admitted inference request (headers), when it sent one. */\n  public getLastAdmission(): AdmissionReport | undefined {\n    return this.lastAdmission;\n  }\n\n  /**\n   * This connection's `/models` entry for the selected model, read from the active endpoint only (never a fallback or\n   * another provider: capability discovery is scoped to the connection in use). Not content-bearing.\ncli/src/core/inference_admission.ts:3:export interface InferenceSubmissionAdmissionScope {\ncli/src/core/inference_admission.ts:14:  readonly entries: Array<{ scope: InferenceSubmissionAdmissionScope; reservation: unknown }>;\ncli/src/core/inference_admission.ts:19:export interface InferenceSubmissionAdmission {\ncli/src/core/inference_admission.ts:34:const scopes = new AsyncLocalStorage<readonly InferenceSubmissionAdmissionScope[]>();\ncli/src/core/inference_admission.ts:40:export async function withInferenceSubmissionAdmissionScope<T>(\ncli/src/core/inference_admission.ts:41:  run: (scope: InferenceSubmissionAdmissionScope) => Promise<T>,\ncli/src/core/inference_admission.ts:43:  const scope: InferenceSubmissionAdmissionScope = { active: false, closed: false, requiresOutputTokenLimit: false };\ncli/src/core/inference_admission.ts:59:export function activateInferenceSubmissionAdmissionScope(\ncli/src/core/inference_admission.ts:60:  scope: InferenceSubmissionAdmissionScope,\ncli/src/core/inference_admission.ts:113:export function beginCurrentInferenceSubmission(estimatedInputTokens?: number, requestedOutputTokens?: number): InferenceSubmissionAdmission {\ncli/src/core/inference_admission.ts:115:  const active: InferenceSubmissionAdmissionScope[] = [];\ncli/src/core/operation_runner.ts:35:  activateInferenceSubmissionAdmissionScope,\ncli/src/core/operation_runner.ts:37:  withInferenceSubmissionAdmissionScope,\ncli/src/core/operation_runner.ts:724:      const result: UnitRunResult = await withInferenceSubmissionAdmissionScope(async (scope) => {\ncli/src/core/operation_runner.ts:725:        activateInferenceSubmissionAdmissionScope(\ncli/src/core/run_turn.ts:18:import { activateInferenceSubmissionAdmissionScope, OperationInferenceAdmissionError, withInferenceSubmissionAdmissionScope, type InferenceSubmissionAdmissionScope } from \"./inference_admission.js\";\ncli/src/core/run_turn.ts:81:  return withInferenceSubmissionAdmissionScope((scope) => runTurnBody.call(this, taskPrompt, onConfirm, options, scope));\ncli/src/core/run_turn.ts:84:async function runTurnBody(this: any, taskPrompt: string | any[], onConfirm: ConfirmHandler | undefined, options: { signal?: AbortSignal; resume?: boolean; tddRed?: boolean; step?: boolean } | undefined, inferenceAdmissionScope: InferenceSubmissionAdmissionScope): Promise<TurnResult> {\ncli/src/core/run_turn.ts:333:    activateInferenceSubmissionAdmissionScope(inferenceAdmissionScope, () => {\n"}],"