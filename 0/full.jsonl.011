{"timestamp":"2026-11-28T06:08:48.042Z","ordinal":314068,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a2208e-347b-7f62-bb1f-c24475a2832b","item":{"type":"CommandExecution","id":"exec-a0361efb-8478-4892-a637-1209bc4738c9","process_id":"70558","command":["/usr/bin/zsh","-lc","sed -n '170,225p' .github/workflows/ci.yml; rg -n \"test shard|shard\" scripts/"],"cwd":"file:///home/mike/nexus-wt/p10-04-active-client-admission-continued","parsed_cmd":[{"type":"read","cmd":"sed -n '170,225p' .github/workflows/ci.yml","name":"ci.yml","path":".github/workflows/ci.yml"},{"type":"search","cmd":"rg -n 'test shard|shard' scripts/","query":"test shard|shard","path":"scripts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: |\n            ~/.cargo/registry/index\n            ~/.cargo/registry/cache\n            core/target\n          key: ${{ steps.core-build-cache.outputs.cache-primary-key }}\n      # Keep the cache-key version list in sync with the pinned tool versions below.\n      - name: Restore pinned security and SBOM tools\n        id: test-cargo-tools\n        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: ~/.cargo/bin\n          key: cargo-tools-ci-${{ runner.os }}-${{ hashFiles('rust-toolchain.toml') }}-audit-0.22.2-deny-0.20.2-cyclonedx-rust-0.5.9-cyclonedx-cli-0.33.1\n      - name: Add Cargo tools to PATH\n        run: echo \"$HOME/.cargo/bin\" >> \"$GITHUB_PATH\"\n      - name: Install pinned security and SBOM test tools\n        if: steps.test-cargo-tools.outputs.cache-hit != 'true'\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - name: Run one shard of the CLI suite with a hang bound\n        # The whole suite took 32-34 minutes in one job, so a quarter of it must not need 30; a hung test process\n        # must fail the leg, not hold it until the job timeout. The four shards are disjoint and together are every\n        # test file (cli/scripts/test_shards.mjs); inside the leg the files run in two processes, as they always did.\n        timeout-minutes: 30\n        shell: bash\n        run: |\n          set -o pipefail\n          mkdir -p \"$RUNNER_TEMP/test-shard\"\n          export NEXUS_TEST_DURATIONS_OUT=\"$RUNNER_TEMP/test-shard/test-durations.json\"\n          npm --prefix cli run test:cli -- --shard=${{ matrix.shard }}/4 2>&1 | tee \"$RUNNER_TEMP/test-shard/suite.log\"\n      # Measured seconds per test file (input of `make test-durations-merge`) and the full suite output of this leg.\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        if: always()\n        with:\n          name: test-shard-node${{ matrix.node }}-${{ matrix.shard }}of4\n          path: ${{ runner.temp }}/test-shard/\n          if-no-files-found: ignore\n          retention-days: 14\n          overwrite: true\n\n  # The required checks. `always()` makes this job run, and fail, even when a leg failed, was skipped or was cancelled:\n  # a skipped required check would count as passing. The result of a matrix job is `success` only when every one of its\n  # legs succeeded, so each of the two checks also fails when a leg of the other Node version fails.\n  test-matrix:\n    needs: [test-gates, test-shard]\nscripts/flake_report.mjs:117:      // `test-matrix (N)` only aggregates the gate and shard jobs: it fails because one of them did, and that job is\n","exit_code":0,"duration":{"secs":0,"nanos":752966731}},"started_at_ms":1795846127288,"completed_at_ms":1795846128042}}
