overed state.\n   */\n  public recoverTaskState(\n    taskId: string,\n    options: TaskRecoveryOptions = {}\n  ): TaskRecoveryResult {\n    return withStateStoreGuard(this.baseDir, () => this.recoverTaskStateLocked(taskId, options));\n  }\n\n  private recoverTaskStateLocked(taskId: string, options: TaskRecoveryOptions): TaskRecoveryResult {\n    let recoveryWorkspacePaths = options.workspacePaths || this.workspacePaths;\n    if (recoveryWorkspacePaths.length === 0 && options.expectedWorkspace) {\n      recoveryWorkspacePaths = [WorkspacePath.fromSelectedWorkspace(path.resolve(options.expectedWorkspace))];\n    }\n    const state = this.loadTaskState(\n      taskId,\n      options.expectedWorkspace,\n      recoveryWorkspacePaths,\n    );\n    // Keep the original schema fact separate from the mutable state object. Recovery callers may\n    // conservatively persist an obligation before deciding whether the old conversation was usable.\n    const obligationRecordPresent = state.unverifiedChangesPending !== undefined;\n    const diagnostics: string[] = [];\n\n    let interrupted = false;\n    let interruptedOp: InFlightOperationRecord | undefined;\n\n    // 1. In-flight operation detection (PERS-002, F-07). A finished operation whose record was never cleared did not\n    //    get its result into the durable conversation either: the history is partial, so it is treated the same way.\n    const op = state.currentOperation;\n    if (op && (op.status === \"in_flight\" || op.status === \"completed\" || op.status === \"failed\" || op.status === \"outcome_unknown\")) {\n      interrupted = true;\n      const priorStatus = op.status;\n      op.outcomeUnknown ||= priorStatus === \"outcome_unknown\";\n      op.error = priorStatus === \"in_flight\"\n        ? \"Operation was interrupted by process termination or crash; its outcome is unknown.\"\n        : priorStatus === \"outcome_unknown\"\n          ? \"Operation outcome was unknown and its result was not recorded before the process stopped.\"\n          : `Operation ${priorStatus === \"failed\" ? \"failed\" : \"finished\"}, but its result was not recorded before the process stopped.`;\n      op.status = \"interrupted\";\n      interruptedOp = { ...op };\n      state.status = \"interrupted\";\n      diagnostics.push(\n        `Interrupted in-flight operation detected: tool '${op.toolName}' (invocation: ${op.invocationId}). Marked as interrupted.`\n      );\n    }\n\n    // 2. Ephemeral handle cleanup (PERS-002)\n    // Subprocess PIDs, pipes, and handles are never resurrected as live.\n    // Cognitive routing structures and client instances remain runtime-reconstructible.\n\n    // 3. Worktree binding verification (PERS-004)\n    let worktreeStatus: \"consistent\" | \"missing\" | \"detached\" | \"none\" = \"none\";\n    if (state.worktreeBinding) {\n      const wtPath = state.worktreeBinding.worktreePath;\n      if (!fs.existsSync(wtPath)) {\n    tracker.finishTaskElapsedBudget(Date.now());\n    const limitReached = !interruption && !inferenceFailure && !capacityBlock && !persistenceFailure && modelStop === \"NONE\" && stopReason !== undefined;\n    const resultInput = {\n      persistenceFailure,\n      modelStop,\n      finalOutputComplete,\n      inferenceFailure,\n      interruption,\n      limitReached,\n      capacityBlock,\n      stepsUsed: stopReason === \"STEP_BUDGET_EXHAUSTED\" ? tracker.data.cumulativeSteps : (stepsUsed || Math.min(currentStep, maxTotalSteps)),\n      providerRecoveries,\n      maxSteps: maxTotalSteps,\n      stopReason,\n      stopDetail,\n      ...(budg…188 tokens truncated…ferenceSubmissions] } : {}),\n              maxInferenceSubmissions,\n              inferenceSubmissionHistoryComplete: tracker.data.inferenceSubmissionHistoryComplete,\n              taskElapsedMs: tracker.data.taskElapsedMs,\n              maxTaskElapsedMs: tracker.data.maxTaskElapsedMs,\n              taskElapsedHistoryComplete: tracker.data.taskElapsedHistoryComplete,\n             