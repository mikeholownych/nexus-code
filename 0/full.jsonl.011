nce(\\\"error\\\", reject);\\n+    child.once(\\\"close\\\", (status) => resolve({ status, stdout, stderr }));\\n+  });\\n+}\\n@@\\n   it(\\\"releases an active-client slot when its owning process exits\\\", () => {\\n@@\\n   });\\n+\\n+  it(\\\"does not report capacity exhaustion when same-home clients contend for the admission guard\\\", async () => {\\n+    const targetHome = home(\\\"concurrent-same-home\\\");\\n+    const results = await Promise.all(Array.from({ length: 16 }, () => concurrentProbe(targetHome, 16)));\\n+    assert.deepEqual(results.map((result) => [result.status, result.stdout.trim()]), Array.from({ length: 16 }, () => [0, \\\"admitted\\\"]));\\n+  });\\n*** End Patch\";\ntext(await tools.apply_patch(patch))\nconst r = await tools.exec_command({cmd:\"git diff --check; git diff --stat; git status --short --branch\",\"workdir\":\"/home/mike/nexus-wt/p10-04-active-client-admission-continued\",\"yield_time_ms\":10000,\"max_output_tokens\":300}); text(r.output)\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a220e5-c285-7e72-9bb5-c6a32a48db70","create_time":1795849139.4886026}},"metadata":{"history_sequence":138855,"sampled_through_sequence":138851,"client_authored":false}}
