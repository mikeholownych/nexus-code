{"timestamp":"2026-11-28T12:05:54.375Z","ordinal":323109,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a22202-664d-7671-a9c4-ed550c36ebc8","item":{"type":"CommandExecution","id":"exec-09473a1d-1bd8-4456-8618-840e01a14815","process_id":"39237","command":["/usr/bin/zsh","-lc","git diff --check; git status --short; git diff -- cli/src/core/tool_pipeline.ts cli/test/p10_operation_journal_fail_closed.test.ts"],"cwd":"file:///home/mike/nexus-wt/p10-02-operation-end-failure","parsed_cmd":[{"type":"unknown","cmd":"git diff --check; git status --short; git diff -- cli/src/core/tool_pipeline.ts cli/test/p10_operation_journal_fail_closed.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":" M cli/src/core/tool_pipeline.ts\n M cli/test/p10_operation_journal_fail_closed.test.ts\ndiff --git a/cli/src/core/tool_pipeline.ts b/cli/src/core/tool_pipeline.ts\nindex 377bbc02e..fb090e324 100644\n--- a/cli/src/core/tool_pipeline.ts\n+++ b/cli/src/core/tool_pipeline.ts\n@@ -864,16 +864,20 @@ function recordOperationEndIfStarted(\n   receipt: ExecutionReceipt,\n   operationSeq: number,\n   operationStartPersisted: boolean,\n-): void {\n-  if (!operationStartPersisted) return;\n+): string | undefined {\n+  if (!operationStartPersisted) return undefined;\n   try {\n     agent.stateManager.recordOperationEnd(durableTaskId, invocationId, {\n       success: receipt.success,\n       error: receipt.error,\n       outcomeUnknown: receipt.outcomeUnknown,\n     }, operationSeq);\n+    return undefined;\n   } catch (err: any) {\n     agent.reportPersistenceFailure(\"operation_end\", err);\n+    agent.acceptancePersistenceFailure =\n+      \"A tool outcome could not be durably recorded; verified task completion is blocked.\";\n+    return redactSecrets(err instanceof Error ? err.message : String(err)).slice(0, 200) || \"unknown persistence error\";\n   }\n }\n \n@@ -947,7 +951,6 @@ export async function executeToolCall(agent: any, input: ToolExecutionInput): Pr\n     receipt = await executeWithDurableStartGate(\n       agent, call, effectiveTaskId, actor, toolName, args, currentStep, operationStart.failure, skillAttr, context,\n     );\n-    recordReceipt(receipt);\n   } finally {\n     agent.syncVerificationAttempts();\n   }\n@@ -973,9 +976,19 @@ export async function executeToolCall(agent: any, input: ToolExecutionInput): Pr\n   }\n \n   if (agent.durable && agent.stateManager && durableTaskId) {\n-    recordOperationEndIfStarted(agent, durableTaskId, call.id, receipt, operationSeq, operationStart.persisted);\n+    const endFailure = recordOperationEndIfStarted(agent, durableTaskId, call.id, receipt, operationSeq, operationStart.persisted);\n+    if (endFailure) {\n+      receipt = {\n+        ...receipt,\n+        success: false,\n+        outcomeUnknown: true,\n+        status: \"UNKNOWN\",\n+        error: `The tool may have completed, but its outcome could not be durably recorded (${endFailure}). Check its effect before retrying.`,\n+      };\n+    }\n   }\n \n+  recordReceipt(receipt);\n   return { call, currentStep, toolName, args, dispatch, receipt, diffTarget, before };\n }\n \ndiff --git a/cli/test/p10_operation_journal_fail_closed.test.ts b/cli/test/p10_operation_journal_fail_closed.test.ts\nindex 6c4fdc4df..33151aba9 100644\n--- a/cli/test/p10_operation_journal_fail_closed.test.ts\n+++ b/cli/test/p10_operation_journal_fail_closed.test.ts\n@@ -41,3 +41,51 @@ test(\"a mutating tool is not dispatched when its durable start journal cannot be\n   assert.equal(result.persistence?.durable, false);\n   assert.ok(result.persistence?.failures.some((failure) => failure.includes(\"operation_start\")));\n });\n+\n+test(\"a mutating tool result is not accepted when its durable end journal cannot be written\", async (t) => {\n+  const world = makeWorld();\n+  t.after(() => world.close());\n+  const gateway = await startGateway((n) => ({\n+    kind: \"tools\",\n+    calls: n === 1\n+      ? [{ name: \"write_file\", args: { path: \"journal-end-failure.txt\", content: \"effect happened\\n\" } }]\n+      : [{ name: \"task_completed\", args: { summary: \"The write succeeded.\" } }],\n+  }));\n+  t.after(() => gateway.close());\n+\n+  const agent = makeAgent(world, {\n+    mode: \"auto\",\n+    fullAccess: true,\n+    config: { endpoint: gateway.url, maxSteps: 3 },\n+  });\n+  const stateManager = agent.getStateManager();\n+  const recordOperationEnd = stateManager.recordOperationEnd.bind(stateManager);\n+  let ends = 0;\n+  stateManager.recordOperationEnd = ((...args: Parameters<typeof stateManager.recordOperationEnd>) => {\n+    ends++;\n+    if (ends === 1) throw new Error(\"injected durable end-journal failure\");\n+    return recordOperationEnd(...args);\n+  }) as typeof stateManager.recordOperationEnd;\n+\n+  const result = await agent.runTurn(\"Write journal-end-failure.txt and finish the task.\");\n+\n+  assert.equal(result.execution, \"FAILED\");\n+  assert.equal(result.reason, \"PERSISTENCE_FAILED\");\n+  assert.notEqual(result.outcome, \"VERIFIED\");\n+  assert.equal(ends, 1, \"the durable end boundary was reached exactly once\");\n+  assert.equal(gateway.requests.length, 1, \"no completion request follows an unrecorded side effect\");\n+  const activeWorktree = agent.getActiveWorktree();\n+  const effectRoots = [world.repo, ...(activeWorktree ? [activeWorktree.worktreePath] : [])];\n+  assert.ok(\n+    effectRoots.some((root) => {\n+      const target = path.join(root, \"journal-end-failure.txt\");\n+      return fs.existsSync(target) && fs.readFileSync(target, \"utf8\") === \"effect happened\\n\";\n+    }),\n+    \"the write happened even though its durable result record failed\",\n+  );\n+  const lastReceipt = (agent as any).lastToolReceipts.at(-1);\n+  assert.equal(lastReceipt.success, false);\n+  assert.equal(lastReceipt.outcomeUnknown, true);\n+  assert.match(lastReceipt.error, /outcome could not be durably recorded/i);\n+  assert.ok(result.persistence?.failures.some((failure) => failure.includes(\"operation_end\")));\n+});\n","exit_code":0,"duration":{"secs":1,"nanos":894384630}},"started_at_ms":1795867552480,"completed_at_ms":1795867554375}}
{"timestamp":"2026-11-28T12:05:54.436Z","ordinal":323110,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a2220c-3284-75c1-ad80-800590df3b46","call_id":"call_d774559c2a1d4a9ca2dcdb4d42b39600","output":[{"type":"input_text","text":"Script completed\nWall time 2.2 seconds\nOutput:\n"},{"type":"input_text","text":" M cli/src/core/tool_pipeline.ts\n M cli/test/p10_operation_journal_fail_closed.test.ts\ndiff --git a/cli/src/core/tool_pipeline.ts b/cli/src/core/tool_pipeline.ts\nindex 377bbc02e..fb090e324 100644\n--- a/cli/src/core/tool_pipeline.ts\n+++ b/cli/src/core/tool_pipeline.ts\n@@ -864,16 +864,20 @@ function recordOperationEndIfStarted(\n   receipt: ExecutionReceipt,\n   operationSeq: number,\n   operationStartPersisted: boolean,\n-): void {\n-  if (!operationStartPersisted) return;\n+): string | undefined {\n+  if (!operationStartPersisted) return undefined;\n   try {\n     agent.stateManager.recordOperationEnd(durableTaskId, invocationId, {\n       success: receipt.success,\n       error: receipt.error,\n       outcomeUnknown: receipt.outcomeUnknown,\n     }, operationSeq);\n+    return undefined;\n   } catch (err: any) {\n     agent.reportPersistenceFailure(\"operation_end\", err);\n+    agent.acceptancePersistenceFailure =\n+      \"A tool outcome could not be durably recorded; verified task completion is blocked.\";\n+    return redactSecrets(err instanceof Error ? err.message : String(err)).slice(0, 200) || \"unknown persistence error\";\n   }\n }\n \n@@ -947,7 +951,6 @@ export async function executeToolCall(agent: any, input: ToolExecutionInput): Pr\n     receipt = await executeWithDurableStartGate(\n       agent, call, effectiveTaskId, actor, toolName, args, currentStep, operationStart.failure, skillAttr, context,\n     );\n-    recordReceipt(receipt);\n   } finally {\n     agent.syncVerificationAttempts();\n   }\n@@ -973,9 +976,19 @@ export async function executeToolCall(agent: any, input: ToolExecutionInput): Pr\n   }\n \n   if (agent.durable && agent.stateManager && durableTaskId) {\n-    recordOperationEndIfStarted(agent, durableTaskId, call.id, receipt, operationSeq, operationStart.persisted);\n+    const endFailure = recordOperationEndIfStarted(agent, durableTaskId, call.id, receipt, operationSeq, operationStart.persisted);\n+    if (endFailure) {\n+      receipt = {\n+        ...receipt,\n+        success: false,\n+        outcomeUnknown: true,\n+        status: \"UNKNOWN\",\n+        error: `The tool may have completed, but its outcome could not be durably recorded (${endFailure}). Check its effect before retrying.`,\n+      };\n+    }\n   }\n \n+  recordReceipt(receipt);\n   return { call, currentStep, toolName, args, dispatch, receipt, diffTarget, before };\n }\n \ndiff --git a/cli/test/p10_operation_journal_fail_closed.test.ts b/cli/test/p10_operation_journal_fail_closed.test.ts\nindex 6c4fdc4df..33151aba9 100644\n--- a/cli/test/p10_operation_journal_fail_closed.test.ts\n+++ b/cli/test/p10_operation_journal_fail_closed.test.ts\n@@ -41,3 +41,51 @@ test(\"a mutating tool is not dispatched when its durable start journal cannot be\n   assert.equal(result.persistence?.durable, false);\n   assert.ok(result.persistence?.failures.some((failure) => failure.includes(\"operation_start\")));\n });\n+\n+test(\"a mutating tool result is not accepted when its durable end journal cannot be written\", async (t) => {\n+  const world = makeWorld();\n+  t.after(() => world.close());\n+  const gateway = await startGateway((n) => ({\n+    kind: \"tools\",\n+    calls: n === 1\n+      ? [{ name: \"write_file\", args: { path: \"journal-end-failure.txt\", content: \"effect happened\\n\" } }]\n+      : [{ name: \"task_completed\", args: { summary: \"The write succeeded.\" } }],\n+  }));\n+  t.after(() => gateway.close());\n+\n+  const agent = makeAgent(world, {\n+    mode: \"auto\",\n+    fullAccess: true,\n+    config: { endpoint: gateway.url, maxSteps: 3 },\n+  });\n+  const stateManager = agent.getStateManager();\n+  const recordOperationEnd = stateManager.recordOperationEnd.bind(stateManager);\n+  let ends = 0;\n+  stateManager.recordOperationEnd = ((...args: Parameters<typeof stateManager.recordOperationEnd>) => {\n+    ends++;\n+    if (ends === 1) throw new Error(\"injected durable end-journal failure\");\n+    return recordOperationEnd(...args);\n+  }) as typeof stateManager.recordOperationEnd;\n+\n+  const result = await agent.runTurn(\"Write journal-end-failure.txt and finish the task.\");\n+\n+  assert.equal(result.execution, \"FAILED\");\n+  assert.equal(result.reason, \"PERSISTENCE_FAILED\");\n+  assert.notEqual(result.outcome, \"VERIFIED\");\n+  assert.equal(ends, 1, \"the durable end boundary was reached exactly once\");\n+  assert.equal(gateway.requests.length, 1, \"no completion request follows an unrecorded side effect\");\n+  const activeWorktree = agent.getActiveWorktree();\n+  const effectRoots = [world.repo, ...(activeWorktree ? [activeWorktree.worktreePath] : [])];\n+  assert.ok(\n+    effectRoots.some((root) => {\n+      const target = path.join(root, \"journal-end-failure.txt\");\n+      return fs.existsSync(target) && fs.readFileSync(target, \"utf8\") === \"effect happened\\n\";\n+    }),\n+    \"the write happened even though its durable result record failed\",\n+  );\n+  const lastReceipt = (agent as any).lastToolReceipts.at(-1);\n+  assert.equal(lastReceipt.success, false);\n+  assert.equal(lastReceipt.outcomeUnknown, true);\n+  assert.match(lastReceipt.error, /outcome could not be durably recorded/i);\n+  assert.ok(result.persistence?.failures.some((failure) => failure.includes(\"operation_end\")));\n+});\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a22202-664d-7671-a9c4-ed550c36ebc8","create_time":1795867554.4367003}},"metadata":{"history_sequence":142271,"sampled_through_sequence":142267,"client_authored":false,"fallback_token_limit_override":12000}}
