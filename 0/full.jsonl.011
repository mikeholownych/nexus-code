url.protocol !== \"https:\") {\n    throw new ResourceAdmissionConflictError(\"resource endpoint must use HTTP or HTTPS; shared admission refused\");\n  }\n  // Credentials and query strings can contain secrets. They are not part of the stored key material.\n  url.username = \"\";\n  url.password = \"\";\n  url.search = \"\";\n  url.hash = \"\";\n  return url.toString();\n}\n\nfunction resourceKey(resource: ResourceDescriptor): string {\n  const identity = JSON.stringify({\n    provider: resource.provider.trim().toLowerCase(),\n    providerId: resource.providerId?.trim().toLowerCase() ?? \"\",\n    endpoint: canonicalEndpoint(resource.endpoint),\n    // A declared serving pool spans models, so it replaces the model component of the slot identity.\n    model: resource.pool ? \"\" : resource.model,\n    pool: resource.pool ?? \"\",\n    // Account is a non-secret identity label/fingerprint in ResourceDescriptor; hash it before persistence.\n    account: resource.account ?? \"default\",\n  });\n  return createHash(\"sha256\").update(identity).digest(\"hex\");\n}\n\nfunction capacityOf(resource: ResourceDescriptor, operatorMaximum: number): number {\n  const declared = resource.maxConcurrentUnits ?? operatorMaximum;\n  if (!Number.isSafeInteger(declared) || declared < 1 || declared > MAX_CONCURRENT_UNITS) {\n    throw new ResourceAdmissionConflictError(\"resource maxConcurrentUnits is invalid; shared admission refused\");\n  }\n  // A workspace operation spec may supply this descriptor. It can lower the operator-owned ceiling, never raise it.\n  return Math.min(declared, operatorMaximum);\n}\n\nfunction ensureAdmissionDirectory(dir: string): void {\n  ensurePrivateDir(dir);\n  const stat = fs.lstatSync(dir);\n  if (!stat.isDirectory() || stat.isSymbolicLink()) throw new Error(\"resource admission directory is redirected\");\n  if (typeof process.getuid === \"function\" && stat.uid !== process.getuid()) throw new Error(\"resource admission directory is not owned by the running user\");\n  if ((stat.mode & 0o077) !== 0) throw new Error(\"resource admission directory has unsafe permissions\");\n}\n\nfunction readCapacity(file: string): CapacityRecord | undefined {\n  const stat = fs.lstatSync(file, { throwIfNoEntry: false });\n  if (!stat) return undefined;\n  if (!stat.isFile() || stat.isSymbolicLink()) throw new ResourceAdmissionConflictError(\"shared resource admission record is redirected; admission refused\");\n  if (typeof process.getuid === \"function\" && stat.uid !== process.getuid()) throw new ResourceAdmissionConflictError(\"shared resource admission record has a foreign owner; admission refused\");\n  if ((stat.mode & 0o077) !== 0 || stat.nlink !== 1) throw new ResourceAdmissionConflictError(\"shared resource admission record has unsafe permissions; admission refused\");\n  let raw: string;\n  try {\n    raw = fs.readFileSync(file, \"utf8\");\n  } catch (error: any) {\n    if (error?.code === \"ENOENT\") throw new ResourceAdmissionConflictError(\"shared resource admission record disappeared while being read; admission refused\");\n    throw error;\n  }\n  let parsed: unknown;\n  try {\n    parsed = JSON.parse(raw);\n  } catch {\n    throw new ResourceAdmissionConflictError(\"shared resource admission record is unreadable; admission refused\");\n  }\n  if (!parsed || typeof parsed !== \"object\" || Array.isArray(parsed)) {\n    throw new ResourceAdmissionConflictError(\"shared resource admission record is invalid; admission refused\");\n  }\n  const record = parsed as Partial<CapacityRecord>;\n  if (\n    record.format !== \"NEXUS_RESOURCE_ADMISSION\" ||\n    record.version !== 1 ||\n    !Number.isSafeInteger(record.capacity) ||\n    (record.capacity ?? 0) < 1 ||\n    (record.capacity ?? 0) > MAX_CONCURRENT_UNITS ||\n    Object.keys(parsed).some((key) => ![\"format\", \"version\", \"capacity\"].includes(key))\n  ) {\n    throw new ResourceAdmissionConflictError(\"shared resource admission record is invalid; admission refused\");\n  }\n  return record as CapacityRecord;\n}\n\n/**\n * Atomically reserves slots across operation IDs and Nexus processes on the same host/filesystem.\n * `operatorMaxUnits` is the operator-owned ceiling; a resource descriptor…4367 tokens truncated…fs.mkdirSync(path.join(home, \".nexus\"));\n  fs.writeFileSync(path.join(home, \".nexus\", \"audit.log\"), `${records.join(\"\\n\")}\\n`);\n  const bundle = path.join(home, \"some-bundle\");\n  const env = { HOME: home };\n  const [plain, limited, errors, bogus, typo, typoWithOption] = await runAuditBatch([\n    () => runAudit([], env),\n    () => runAudit([\"--limit\", \"5\"], env),\n    () => runAudit([\"--errors\", \"-n\", \"3\"], env),\n    () => runAudit([\"bogus\", \"x\"], env),\n    () => runAudit([\"verfy\", bundle], env),\n    () => runAudit([\"--limit\", \"5\", \"exprot\", \"task-1\"], env),\n  ]);\n  assert.deepEqual([plain.code, plain.stdout, plain.stderr], [0, all, \"\"]);\n  assert.deepEqual([limited.code, limited.stdout, limited.stderr], [0, lastFive, \"\"]);\n  assert.deepEqual([errors.code, errors.stdout], [0, `\\n=== Nexus Code Tool Execution Audit Log (1 entries) ===\\n\\n${row(4)}\\n`]);\n  // Before: each of these printed the log and exited 0, which reads as a verification that passed.\n  for (const [run, name] of [[bogus, \"bogus\"], [typo, \"verfy\"], [typoWithOption, \"exprot\"]] as const) {\n    assert.equal(run.code, 2, run.stderr);\n    assert.equal(run.stdout, \"\", \"the audit log is not printed\");\n    assert.match(run.stderr, new RegExp(`^error: unknown audit subcommand '${name}'\\\\. The subcommands are \\`export\\` and \\`verify\\``));\n  }\n});\n\ntest(\"the CLI signs with an operator key, verifies against the public key, and never copies the private key\", async () => {\n  const subject = savedSubject({ flight: false, diff: false });\n  const { privateKey, publicKey } = generateKeyPairSync(\"ed25519\");\n  const privatePath = path.join(subject.root, \"operator-private.pem\");\n  const publicPath = path.join(subject.root, \"operator-public.pem\");\n  const wrongPublicPath = path.join(subject.root, \"wrong-public.pem\");\n  fs.writeFileSync(privatePath, privateKey.export({ type: \"pkcs8\", format: \"pem\" }));\n  fs.writeFileSync(publicPath, publicKey.export({ type: \"spki\", format: \"pem\" }));\n  fs.writeFileSync(wrongPublicPath, generateKeyPairSync(\"ed25519\").publicKey.export({ type: \"spki\", format: \"pem\" }));\n  const out = subject.out(\"signed-bundle\");\n  const env = stateEnv(subject);\n  const exported = await runAudit([\"export\", subject.id, \"--out\", out, \"--sign-key\", privatePath, \"--json\"], env);\n  const exportedDoc = consume(exported);\n  assert.deepEqual([exported.code, exportedDoc.result, exportedDoc.signed], [0, \"exported\", true]);\n  assert.equal(fs.existsSync(path.join(out, \"manifest.sig.json\")), true);\n  assert.equal(fs.readdirSync(out).some((name) => name.includes(\"private\")), false);\n  const checked = await runAudit([\"verify\", out, \"--public-key\", publicPath, \"--json\"]);\n  assert.deepEqual([checked.code, consume(checked).result, consume(checked).signature], [0, \"intact_signed\", \"valid\"]);\n  const mismatched = await runAudit([\"verify\", out, \"--public-key\", wrongPublicPath, \"--json\"]);\n  assert.deepEqual([mismatched.code, consume(mismatched).result, consume(mismatched).findings[0].kind], [1, \"tampered\", \"signature_key_mismatch\"]);\n  const unchecked = await runAudit([\"verify\", out, \"--json\"]);\n  assert.deepEqual([unchecked.code, consume(unchecked).result], [2, \"signature_unchecked\"]);\n});\n\ntest(\"an unknown option, a missing argument or an extra one is a parse error, not ignored\", async () => {\n    }\n  });\n});\n\ntest(\"run-now needs a runner and a trusted workspace, and refuses while the schedule's previous job runs\", { timeout: 120_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    assert.equal((await add(world, repo, \"--name\", \"n\", \"--every\", \"15m\")).code, 0);\n    const none = await world.run([\"schedule\", \"run-now\", \"n\"]);\n    assert.equal(none.code, 2);\n    assert.match(none.stderr, /no runner is running/);\n    assert.equal((await world.run([\"trust\", \"--remove\", repo])).code, 0);\n    const untrusted = await world.run([\"schedule\", \"run-now\", \"n\"]);\n    assert.equal(untrusted.code, 2);\n    assert.match(untrusted.stderr, /not a trusted workspace/);\n  });\n});\n\ntest(\"two run-now at once start one job: the running-job check and the runner's acceptance happen under the schedule lock\", { timeout: 240_000 }, async () => {\n  const world = runnerWorld();\n  const repo = fs.realpathSync(makeRepo({ \"README.md\": \"hello\\n\" }));\n  const gw = await stalledGateway();\n  try {\n    assert.equal((await world.run([\"trust\", repo])).code, 0);\n    assert.equal((await add(world, repo, \"--name\", \"n\", \"--every\", \"15m\", \"-e\", gw.url, \"-m\", \"m\")).code, 0);\n    await world.startRunner();\n    const runs = await Promise.all([world.run([\"schedule\", \"run-now\", \"n\"]), world.run([\"schedule\", \"run-now\", \"n\"])]);\n    const ok = runs.filter((run) => run.code === 0);\n    const refused = runs.filter((run) => run.code === 2);\n    assert.equal(ok.length, 1, JSON.stringify(runs));\n    assert.equal(refused.length, 1, JSON.stringify(runs));\n    assert.match(refused[0].stderr, /still has a running job/);\n    assert.equal(listJobs(world.paths).jobs.filter((job) => job.origin.kind === \"schedule\" && job.origin.scheduleId === \"n\").length, 1);\n  } finally {\n    await world.cleanup();\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n  }\n});\n\ntest(\"add warns that a read-only run does not run its verifier\", { timeout: 120_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    const result = await add(world, repo, \"--name\", \"w\", \"--every\", \"15m\", \"--verifier\", \"node --test\");\n    assert.equal(result.code, 0, result.stderr);\n    assert.match(result.stderr, /a read-only run does not run its verifier/);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a220e5-c285-7e72-9bb5-c6a32a48db70","create_time":1795848363.9721107}},"metadata":{"history_sequence":138684,"sampled_through_sequence":138681,"client_authored":false,"fallback_token_limit_override":12000}}
