{"timestamp":"2026-11-28T05:30:40.946Z","ordinal":313183,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a2208e-347b-7f62-bb1f-c24475a2832b","item":{"type":"CommandExecution","id":"exec-ef0f6ec1-315f-4de1-a2ec-15579d245714","process_id":"36146","command":["/usr/bin/zsh","-lc","sed -n '1,120p' cli/src/core/client_lease.ts; sed -n '180,310p' cli/src/core/shared_resource_admission.ts; rg -n \"clientLeasePath|resource-admission\" cli/src"],"cwd":"file:///home/mike/nexus-wt/p10-04-active-client-admission-continued","parsed_cmd":[{"type":"read","cmd":"sed -n '1,120p' cli/src/core/client_lease.ts","name":"client_lease.ts","path":"cli/src/core/client_lease.ts"},{"type":"read","cmd":"sed -n '180,310p' cli/src/core/shared_resource_admission.ts","name":"shared_resource_admission.ts","path":"cli/src/core/shared_resource_admission.ts"},{"type":"search","cmd":"rg -n 'clientLeasePath|resource-admission' cli/src","query":"clientLeasePath|resource-admission","path":"cli"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/** Lifetime client/maintenance coordination; this is not a boundary against arbitrary same-UID programs. */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { acquireFileGuard, releaseFileGuard, type FileGuard } from \"./file_guard.js\";\nimport { MAX_SHARED_RESOURCE_CAPACITY, SharedResourceAdmission, type ResourceSlotLease } from \"./shared_resource_admission.js\";\n\nconst heartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\nconst activeClientSlots = new WeakMap<FileGuard, ResourceSlotLease>();\nconst activeClientHeartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\nexport const DEFAULT_MAX_ACTIVE_CLIENTS = 16;\n\nexport class ClientActiveLimitError extends Error {\n  constructor(readonly limit: number) {\n    super(`Nexus active client limit (${limit}) reached; close another client or set NEXUS_MAX_ACTIVE_CLIENTS to a value from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n    this.name = \"ClientActiveLimitError\";\n  }\n}\n\nfunction maxActiveClients(options: { maxActiveClients?: number }): number {\n  const raw = process.env.NEXUS_MAX_ACTIVE_CLIENTS;\n  const value = options.maxActiveClients ?? (raw === undefined ? DEFAULT_MAX_ACTIVE_CLIENTS : Number(raw));\n  if ((raw !== undefined && options.maxActiveClients === undefined && !/^\\d+$/.test(raw)) ||\n      !Number.isSafeInteger(value) || value < 1 || value > MAX_SHARED_RESOURCE_CAPACITY) {\n    throw new Error(`Invalid NEXUS_MAX_ACTIVE_CLIENTS='${raw ?? value}': expected an integer from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n  }\n  return value;\n}\n\n/** Only unambiguous metadata/recovery invocations may avoid a normal client lifetime lease. */\nexport function clientInvocationKind(args: readonly string[]): \"metadata\" | \"restore\" | \"client\" {\n  const metadata = [\"--version\", \"-V\", \"--help\", \"-h\"];\n  if (args.some(arg => metadata.includes(arg)) && args.every(arg => metadata.includes(arg) || arg === \"--json\" || arg === \"-j\")) return \"metadata\";\n  // A preceding option could consume --help as its value. Bare positional\n  // command names followed by help cannot execute a configured client action.\n  if (args.length > 1 && [\"--help\", \"-h\"].includes(args[args.length - 1]) &&\n      args.slice(0, -1).every(arg => !arg.startsWith(\"-\"))) return \"metadata\";\n  if (args[0] !== \"upgrade\") return \"client\";\n  let restore = false;\n  for (let index = 1; index < args.length; index++) {\n    const arg = args[index];\n    if (arg === \"--json\" || arg === \"-j\") continue;\n    if (arg.startsWith(\"--prefix=\")) continue;\n    if (arg.startsWith(\"--restore-backup=\")) {\n      if (restore || arg === \"--restore-backup=\") return \"client\";\n      restore = true;\n      continue;\n    }\n    if (arg === \"--prefix\" || arg === \"--restore-backup\") {\n      if (index + 1 >= args.length || (arg === \"--restore-backup\" && args[index + 1].startsWith(\"-\"))) return \"client\";\n      if (arg === \"--restore-backup\") {\n        if (restore) return \"client\";\n        restore = true;\n      }\n      index++; // Do not mistake an option's value for a recovery flag.\n      continue;\n    }\n    return \"client\";\n  }\n  return restore ? \"restore\" : \"client\";\n}\n\nexport class ClientLeaseBusyError extends Error {\n  constructor(exclusive: boolean) {\n    super(exclusive\n      ? \"Close all other Nexus clients before restoring configuration or state.\"\n      : \"Nexus state maintenance is active; retry after recovery finishes.\");\n    this.name = \"ClientLeaseBusyError\";\n  }\n}\n\n/** Independent of TMPDIR so cooperating clients for the same canonical home always meet at one inode. */\nexport function clientLeasePath(homeDir: string): string {\n  if (process.platform !== \"linux\" || typeof process.getuid !== \"function\") {\n    throw new Error(\"Managed Nexus maintenance requires Linux kernel client leases\");\n  }\n  const uid = process.getuid();\n  const directory = path.join(\"/tmp\", `nexus-client-leases-${uid}`);\n  try { fs.mkdirSync(directory, { mode: 0o700 }); }\n  catch (error: any) { if (error.code !== \"EEXIST\") throw error; }\n  const stat = fs.lstatSync(directory);\n  if (!stat.isDirectory() || stat.isSymbolicLink() || stat.uid !== uid || (stat.mode & 0o077) !== 0 ||\n      fs.realpathSync(directory) !== directory) {\n    throw new Error(\"Nexus client lease directory is redirected or not private to this user\");\n  }\n  const home = fs.realpathSync(homeDir);\n  if (!fs.statSync(home).isDirectory()) throw new Error(\"Nexus client home must be a directory\");\n  const identity = createHash(\"sha256\").update(home).digest(\"hex\");\n  return path.join(directory, `${identity}.guard`);\n}\n\n/** Retain the returned descriptor until the client has finished every use of loaded configuration/state. */\nexport function acquireClientLease(\n  homeDir: string,\n  options: { exclusive?: boolean; waitMs?: number; maxActiveClients?: number } = {},\n): FileGuard {\n  const exclusive = options.exclusive === true;\n  const activeLimit = exclusive ? undefined : maxActiveClients(options);\n  const leasePath = clientLeasePath(homeDir);\n  const lease = acquireFileGuard(leasePath, {\n    mode: exclusive ? \"exclusive\" : \"shared\",\n    waitMs: options.waitMs ?? 0,\n    label: \"Nexus client lease\",\n  });\n  if (!lease) throw new ClientLeaseBusyError(exclusive);\n  if (activeLimit !== undefined) {\n    try {\n      const admission = new SharedResourceAdmission(path.join(path.dirname(leasePath), \"resource-admission\"), { guardWaitMs: 0 });\n      const slot = admission.acquireNamed(\"active-client-processes\", activeLimit, \"client process\");\n      if (!slot) {\n        releaseFileGuard(lease);\n        throw new ClientActiveLimitError(activeLimit);\n      }\n      if (slot.inheritedFd === undefined) {\n        slot.release();\n        throw new Error(\"Nexus active client slot does not expose its kernel lease descriptor\");\n      }\n      const slotFd = slot.inheritedFd;\n      const slotHeartbeat = setInterval(() => {\n        try { const now = new Date(); fs.futimesSync(slotFd, now, now); }\n  acquire(resource: ResourceDescriptor): ResourceSlotLease | null {\n    const key = resourceKey(resource);\n    const capacity = capacityOf(resource, this.operatorMaxUnits);\n    return this.acquireKey(key, capacity, \"shared inference resource\", \"Shared inference resource slot\", false);\n  }\n\n  /** Reserves a bounded named local resource using the same cross-process kernel slot mechanism. */\n  acquireNamed(name: string, capacity: number, label: string): ResourceSlotLease | null {\n    if (!/^[a-z0-9][a-z0-9._:-]{0,127}$/i.test(name)) {\n      throw new ResourceAdmissionConflictError(\"named shared resource identity is invalid; admission refused\");\n    }\n    if (!Number.isSafeInteger(capacity) || capacity < 1 || capacity > MAX_CONCURRENT_UNITS) {\n      throw new ResourceAdmissionConflictError(`named shared resource capacity is invalid; expected 1..${MAX_CONCURRENT_UNITS}`);\n    }\n    if (typeof label !== \"string\" || !/^[a-z][a-z0-9 -]{0,63}$/i.test(label)) {\n      throw new ResourceAdmissionConflictError(\"named shared resource label is invalid; admission refused\");\n    }\n    const key = createHash(\"sha256\").update(JSON.stringify({ kind: \"named\", name })).digest(\"hex\");\n    return this.acquireKey(key, capacity, `shared ${label}`, `Shared ${label} slot`, true);\n  }\n\n  private acquireKey(key: string, capacity: number, scope: string, slotLabel: string, inheritSlot: boolean): ResourceSlotLease | null {\n    ensureAdmissionDirectory(this.directory);\n    const prefix = path.join(this.directory, key);\n    const mutex = this.acquireIdentityGuard(prefix);\n    if (!mutex) return null;\n\n    let slot: FileGuard | null = null;\n    try {\n      const capacityFile = `${prefix}.json`;\n      const existing = readCapacity(capacityFile);\n      if (!existing && this.probeActiveSlots(prefix, MAX_CONCURRENT_UNITS, scope, slotLabel) > 0) {\n        throw new ResourceAdmissionConflictError(`${scope} admission metadata is missing while a slot is active; admission refused`);\n      }\n      if (existing && existing.capacity !== capacity) {\n        const active = this.probeActiveSlots(prefix, existing.capacity, scope, slotLabel);\n        if (active > 0) {\n          throw new ResourceAdmissionConflictError(\n            `active operations declare different capacities (${existing.capacity} and ${capacity}) for the same ${scope}`,\n          );\n        }\n      }\n      const effectiveCapacity = existing?.capacity === capacity ? existing.capacity : capacity;\n      for (let index = 0; index < effectiveCapacity; index++) {\n        try {\n          slot = acquireFileGuard(`${prefix}.slot-${index}`, { label: slotLabel });\n        } catch (error) {\n          throw new ResourceAdmissionConflictError(`cannot reserve ${scope} slot: ${(error as Error).message}`);\n        }\n        if (slot) break;\n      }\n      if (!slot) return null;\n      if (!existing || existing.capacity !== effectiveCapacity) {\n        try {\n          writeFileDurably(capacityFile, JSON.stringify({ format: \"NEXUS_RESOURCE_ADMISSION\", version: 1, capacity: effectiveCapacity } satisfies CapacityRecord));\n        } catch (error) {\n          releaseFileGuard(slot);\n          slot = null;\n          throw error;\n        }\n      }\n      const held = slot;\n      slot = null;\n      return {\n        ...(inheritSlot ? { inheritedFd: held.fd } : {}),\n        release: () => releaseFileGuard(held),\n      };\n    } finally {\n      if (slot) releaseFileGuard(slot);\n      releaseFileGuard(mutex);\n    }\n  }\n\n  private probeActiveSlots(prefix: string, capacity: number, scope: string, slotLabel: string): number {\n    let active = 0;\n    for (let index = 0; index < capacity; index++) {\n      if (!fs.existsSync(`${prefix}.slot-${index}`)) continue;\n      let probe: FileGuard | null;\n      try {\n        probe = acquireFileGuard(`${prefix}.slot-${index}`, { label: slotLabel });\n      } catch (error) {\n        throw new ResourceAdmissionConflictError(`cannot inspect ${scope} slots: ${(error as Error).message}`);\n      }\n      if (probe) releaseFileGuard(probe);\n      else active++;\n    }\n    return active;\n  }\n}\ncli/src/core/socket_files.ts:74: * directory, otherwise `/tmp/nexus-sockets-<uid>` (the pattern of `clientLeasePath`). Fails closed: a directory that\ncli/src/core/client_lease.ts:73:export function clientLeasePath(homeDir: string): string {\ncli/src/core/client_lease.ts:99:  const leasePath = clientLeasePath(homeDir);\ncli/src/core/client_lease.ts:108:      const admission = new SharedResourceAdmission(path.join(path.dirname(leasePath), \"resource-admission\"), { guardWaitMs: 0 });\ncli/src/core/operation_runner.ts:178:      path.join(credentialStorageHome(), \".local/state/nexus/resource-admission\"),\ncli/src/tools.ts:1147:        path.join(credentialStorageHome(), \".local/state/nexus/resource-admission\"),\n","exit_code":0,"duration":{"secs":0,"nanos":863891481}},"started_at_ms":1795843840082,"completed_at_ms":1795843840946}}
{"timestamp":"2026-11-28T05:30:40.998Z","ordinal":313184,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a220a2-5be6-79d1-9c8f-28067c1f5837","call_id":"call_e69cb433670b4e13aafc8171f36bc43a","output":[{"type":"input_text","text":"Script completed\nWall time 1.1 seconds\nOutput:\n"},{"type":"input_text","text":"/** Lifetime client/maintenance coordination; this is not a boundary against arbitrary same-UID programs. */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { acquireFileGuard, releaseFileGuard, type FileGuard } from \"./file_guard.js\";\nimport { MAX_SHARED_RESOURCE_CAPACITY, SharedResourceAdmission, type ResourceSlotLease } from \"./shared_resource_admission.js\";\n\nconst heartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\nconst activeClientSlots = new WeakMap<FileGuard, ResourceSlotLease>();\nconst activeClientHeartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\nexport const DEFAULT_MAX_ACTIVE_CLIENTS = 16;\n\nexport class ClientActiveLimitError extends Error {\n  constructor(readonly limit: number) {\n    super(`Nexus active client limit (${limit}) reached; close another client or set NEXUS_MAX_ACTIVE_CLIENTS to a value from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n    this.name = \"ClientActiveLimitError\";\n  }\n}\n\nfunction maxActiveClients(options: { maxActiveClients?: number }): number {\n  const raw = process.env.NEXUS_MAX_ACTIVE_CLIENTS;\n  const value = options.maxActiveClients ?? (raw === undefined ? DEFAULT_MAX_ACTIVE_CLIENTS : Number(raw));\n  if ((raw !== undefined && options.maxActiveClients === undefined && !/^\\d+$/.test(raw)) ||\n      !Number.isSafeInteger(value) || value < 1 || value > MAX_SHARED_RESOURCE_CAPACITY) {\n    throw new Error(`Invalid NEXUS_MAX_ACTIVE_CLIENTS='${raw ?? value}': expected an integer from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n  }\n  return value;\n}\n\n/** Only unambiguous metadata/recovery invocations may avoid a normal client lifetime lease. */\nexport function clientInvocationKind(args: readonly string[]): \"metadata\" | \"restore\" | \"client\" {\n  const metadata = [\"--version\", \"-V\", \"--help\", \"-h\"];\n  if (args.some(arg => metadata.includes(arg)) && args.every(arg => metadata.includes(arg) || arg === \"--json\" || arg === \"-j\")) return \"metadata\";\n  // A preceding option could consume --help as its value. Bare positional\n  // command names followed by help cannot execute a configured client action.\n  if (args.length > 1 && [\"--help\", \"-h\"].includes(args[args.length - 1]) &&\n      args.slice(0, -1).every(arg => !arg.startsWith(\"-\"))) return \"metadata\";\n  if (args[0] !== \"upgrade\") return \"client\";\n  let restore = false;\n  for (let index = 1; index < args.length; index++) {\n    const arg = args[index];\n    if (arg === \"--json\" || arg === \"-j\") continue;\n    if (arg.startsWith(\"--prefix=\")) continue;\n    if (arg.startsWith(\"--restore-backup=\")) {\n      if (restore || arg === \"--restore-backup=\") return \"client\";\n      restore = true;\n      continue;\n    }\n    if (arg === \"--prefix\" || arg === \"--restore-backup\") {\n      if (index + 1 >= args.length || (arg === \"--restore-backup\" && args[index + 1].startsWith(\"-\"))) return \"client\";\n      if (arg === \"--restore-backup\") {\n        if (restore) return \"client\";\n        restore = true;\n      }\n      index++; // Do not mistake an option's value for a recovery flag.\n      continue;\n    }\n    return \"client\";\n  }\n  return restore ? \"restore\" : \"client\";\n}\n\nexport class ClientLeaseBusyError extends Error {\n  constructor(exclusive: boolean) {\n    super(exclusive\n      ? \"Close all other Nexus clients before restoring configuration or state.\"\n      : \"Nexus state maintenance is active; retry after recovery finishes.\");\n    this.name = \"ClientLeaseBusyError\";\n  }\n}\n\n/** Independent of TMPDIR so cooperating clients for the same canonical home always meet at one inode. */\nexport function clientLeasePath(homeDir: string): string {\n  if (process.platform !== \"linux\" || typeof process.getuid !== \"function\") {\n    throw new Error(\"Managed Nexus maintenance requires Linux kernel client leases\");\n  }\n  const uid = process.getuid();\n  const directory = path.join(\"/tmp\", `nexus-client-leases-${uid}`);\n  try { fs.mkdirSync(directory, { mode: 0o700 }); }\n  catch (error: any) { if (error.code !== \"EEXIST\") throw error; }\n  const stat = fs.lstatSync(directory);\n  if (!stat.isDirectory() || stat.isSymbolicLink() || stat.uid !== uid || (stat.mode & 0o077) !== 0 ||\n      fs.realpathSync(directory) !== directory) {\n    throw new Error(\"Nexus client lease directory is redirected or not private to this user\");\n  }\n  const home = fs.realpathSync(homeDir);\n  if (!fs.statSync(home).isDirectory()) throw new Error(\"Nexus client home must be a directory\");\n  const identity = createHash(\"sha256\").update(home).digest(\"hex\");\n  return path.join(directory, `${identity}.guard`);\n}\n\n/** Retain the returned descriptor until the client has finished every use of loaded configuration/state. */\nexport function acquireClientLease(\n  homeDir: string,\n  options: { exclusive?: boolean; waitMs?: number; maxActiveClients?: number } = {},\n): FileGuard {\n  const exclusive = options.exclusive === true;\n  const activeLimit = exclusive ? undefined : maxActiveClients(options);\n  const leasePath = clientLeasePath(homeDir);\n  const lease = acquireFileGuard(leasePath, {\n    mode: exclusive ? \"exclusive\" : \"shared\",\n    waitMs: options.waitMs ?? 0,\n    label: \"Nexus client lease\",\n  });\n  if (!lease) throw new ClientLeaseBusyError(exclusive);\n  if (activeLimit !== undefined) {\n    try {\n      const admission = new SharedResourceAdmission(path.join(path.dirname(leasePath), \"resource-admission\"), { guardWaitMs: 0 });\n      const slot = admission.acquireNamed(\"active-client-processes\", activeLimit, \"client process\");\n      if (!slot) {\n        releaseFileGuard(lease);\n        throw new ClientActiveLimitError(activeLimit);\n      }\n      if (slot.inheritedFd === undefined) {\n        slot.release();\n        throw new Error(\"Nexus active client slot does not expose its kernel lease descriptor\");\n      }\n      const slotFd = slot.inheritedFd;\n      const slotHeartbeat = setInterval(() => {\n        try { const now = new Date(); fs.futimesSync(slotFd, now, now); }\n  acquire(resource: ResourceDescriptor): ResourceSlotLease | null {\n    const key = resourceKey(resource);\n    const capacity = capacityOf(resource, this.operatorMaxUnits);\n    return this.acquireKey(key, capacity, \"shared inference resource\", \"Shared inference resource slot\", false);\n  }\n\n  /** Reserves a bounded named local resource using the same cross-process kernel slot mechanism. */\n  acquireNamed(name: string, capacity: number, label: string): ResourceSlotLease | null {\n    if (!/^[a-z0-9][a-z0-9._:-]{0,127}$/i.test(name)) {\n      throw new ResourceAdmissionConflictError(\"named shared resource identity is invalid; admission refused\");\n    }\n    if (!Number.isSafeInteger(capacity) || capacity < 1 || capacity > MAX_CONCURRENT_UNITS) {\n      throw new ResourceAdmissionConflictError(`named shared resource capacity is invalid; expected 1..${MAX_CONCURRENT_UNITS}`);\n    }\n    if (typeof label !== \"string\" || !/^[a-z][a-z0-9 -]{0,63}$/i.test(label)) {\n      throw new ResourceAdmissionConflictError(\"named shared resource label is invalid; admission refused\");\n    }\n    const key = createHash(\"sha256\").update(JSON.stringify({ kind: \"named\", name })).digest(\"hex\");\n    return this.acquireKey(key, capacity, `shared ${label}`, `Shared ${label} slot`, true);\n  }\n\n  private acquireKey(key: string, capacity: number, scope: string, slotLabel: string, inheritSlot: boolean): ResourceSlotLease | null {\n    ensureAdmissionDirectory(this.directory);\n    const prefix = path.join(this.directory, key);\n    const mutex = this.acquireIdentityGuard(prefix);\n    if (!mutex) return null;\n\n    let slot: FileGuard | null = null;\n    try {\n      const capacityFile = `${prefix}.json`;\n      const existing = readCapacity(capacityFile);\n      if (!existing && this.probeActiveSlots(prefix, MAX_CONCURRENT_UNITS, scope, slotLabel) > 0) {\n        throw new ResourceAdmissionConflictError(`${scope} admission metadata is missing while a slot is active; admission refused`);\n      }\n      if (existing && existing.capacity !== capacity) {\n        const active = this.probeActiveSlots(prefix, existing.capacity, scope, slotLabel);\n        if (active > 0) {\n          throw new ResourceAdmissionConflictError(\n            `active operations declare different capacities (${existing.capacity} and ${capacity}) for the same ${scope}`,\n          );\n        }\n      }\n      const effectiveCapacity = existing?.capacity === capacity ? existing.capacity : capacity;\n      for (let index = 0; index < effectiveCapacity; index++) {\n        try {\n          slot = acquireFileGuard(`${prefix}.slot-${index}`, { label: slotLabel });\n        } catch (error) {\n          throw new ResourceAdmissionConflictError(`cannot reserve ${scope} slot: ${(error as Error).message}`);\n        }\n        if (slot) break;\n      }\n      if (!slot) return null;\n      if (!existing || existing.capacity !== effectiveCapacity) {\n        try {\n          writeFileDurably(capacityFile, JSON.stringify({ format: \"NEXUS_RESOURCE_ADMISSION\", version: 1, capacity: effectiveCapacity } satisfies CapacityRecord));\n        } catch (error) {\n          releaseFileGuard(slot);\n          slot = null;\n          throw error;\n        }\n      }\n      const held = slot;\n      slot = null;\n      return {\n        ...(inheritSlot ? { inheritedFd: held.fd } : {}),\n        release: () => releaseFileGuard(held),\n      };\n    } finally {\n      if (slot) releaseFileGuard(slot);\n      releaseFileGuard(mutex);\n    }\n  }\n\n  private probeActiveSlots(prefix: string, capacity: number, scope: string, slotLabel: string): number {\n    let active = 0;\n    for (let index = 0; index < capacity; index++) {\n      if (!fs.existsSync(`${prefix}.slot-${index}`)) continue;\n      let probe: FileGuard | null;\n      try {\n        probe = acquireFileGuard(`${prefix}.slot-${index}`, { label: slotLabel });\n      } catch (error) {\n        throw new ResourceAdmissionConflictError(`cannot inspect ${scope} slots: ${(error as Error).message}`);\n      }\n      if (probe) releaseFileGuard(probe);\n      else active++;\n    }\n    return active;\n  }\n}\ncli/src/core/socket_files.ts:74: * directory, otherwise `/tmp/nexus-sockets-<uid>` (the pattern of `clientLeasePath`). Fails closed: a directory that\ncli/src/core/client_lease.ts:73:export function clientLeasePath(homeDir: string): string {\ncli/src/core/client_lease.ts:99:  const leasePath = clientLeasePath(homeDir);\ncli/src/core/client_lease.ts:108:      const admission = new SharedResourceAdmission(path.join(path.dirname(leasePath), \"resource-admission\"), { guardWaitMs: 0 });\ncli/src/core/operation_runner.ts:178:      path.join(credentialStorageHome(), \".local/state/nexus/resource-admission\"),\ncli/src/tools.ts:1147:        path.join(credentialStorageHome(), \".local/state/nexus/resource-admission\"),\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a2208e-347b-7f62-bb1f-c24475a2832b","create_time":1795843840.997999}},"metadata":{"history_sequence":137839,"sampled_through_sequence":137836,"client_authored":false,"fallback_token_limit_override":12000}}
