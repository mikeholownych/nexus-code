{"timestamp":"2026-11-28T06:09:44.285Z","ordinal":314107,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a2208e-347b-7f62-bb1f-c24475a2832b","item":{"type":"CommandExecution","id":"exec-976673c7-d22d-47ac-b9e5-c6c23bbfac43","process_id":"65810","command":["/usr/bin/zsh","-lc","rg -n \"^(test|describe|suite)\\(\" cli/test/audit_command.test.ts cli/test/schedule_cli.test.ts; sed -n '380,435p' cli/test/helpers/audit_fixture.ts; sed -n '45,95p' cli/test/helpers/runner_fixture.ts"],"cwd":"file:///home/mike/nexus-wt/p10-04-active-client-admission-continued","parsed_cmd":[{"type":"search","cmd":"rg -n '^(test|describe|suite)'\"\\\\(\" cli/test/audit_command.test.ts cli/test/schedule_cli.test.ts","query":"^(test|describe|suite)\\(","path":"audit_command.test.ts"},{"type":"read","cmd":"sed -n '380,435p' cli/test/helpers/audit_fixture.ts","name":"audit_fixture.ts","path":"cli/test/helpers/audit_fixture.ts"},{"type":"read","cmd":"sed -n '45,95p' cli/test/helpers/runner_fixture.ts","name":"runner_fixture.ts","path":"cli/test/helpers/runner_fixture.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"cli/test/schedule_cli.test.ts:32:test(\"add refuses a workspace the operator has not trusted, and nothing is written\", { timeout: 120_000 }, async () => {\ncli/test/schedule_cli.test.ts:45:test(\"add, list, status, pause, resume and remove: the operator's whole loop\", { timeout: 180_000 }, async () => {\ncli/test/schedule_cli.test.ts:102:test(\"what is not a schedule's to ask: modes, sandbox flags, a second trigger, a bad name, a duplicate, a past time\", { timeout: 240_000 }, async () => {\ncli/test/schedule_cli.test.ts:147:test(\"the 65th schedule is refused\", { timeout: 120_000 }, async () => {\ncli/test/schedule_cli.test.ts:166:test(\"a schedule file that was edited by hand is shown as invalid and is not used by the commands that would change it\", { timeout: 120_000 }, async () => {\ncli/test/schedule_cli.test.ts:184:test(\"run-now needs a runner and a trusted workspace, and refuses while the schedule's previous job runs\", { timeout: 120_000 }, async () => {\ncli/test/schedule_cli.test.ts:198:test(\"two run-now at once start one job: the running-job check and the runner's acceptance happen under the schedule lock\", { timeout: 240_000 }, async () => {\ncli/test/schedule_cli.test.ts:220:test(\"add warns that a read-only run does not run its verifier\", { timeout: 120_000 }, async () => {\ncli/test/audit_command.test.ts:49:test(\"the manual's audit exit-code table is the exported table, and points at docs/AUDIT.md\", () => {\ncli/test/audit_command.test.ts:76:test(\"the round trip through the commands: export a saved task, verify it, alter one byte of each kind of payload\", async () => {\ncli/test/audit_command.test.ts:140:test(\"`nexus audit verify` fails when a bundled source log was already broken at export\", async () => {\ncli/test/audit_command.test.ts:155:test(\"`nexus audit verify` fails when the first flight record is a durable recording-gap marker\", async () => {\ncli/test/audit_command.test.ts:170:test(\"`nexus audit` still prints the tool audit log, byte for byte, and refuses anything that is not a subcommand\", async () => {\ncli/test/audit_command.test.ts:206:test(\"the CLI signs with an operator key, verifies against the public key, and never copies the private key\", async () => {\ncli/test/audit_command.test.ts:230:test(\"an unknown option, a missing argument or an extra one is a parse error, not ignored\", async () => {\ncli/test/audit_command.test.ts:255:test(\"`--json` prints one document of the published schema for every outcome, with the exit code of the table\", async () => {\n}\n\n/** Newest modification time under a directory (0 when it does not exist). */\nfunction newestMtime(dir: string): number {\n  let newest = 0;\n  for (const entry of fs.existsSync(dir) ? fs.readdirSync(dir, { withFileTypes: true, recursive: true }) : []) {\n    if (entry.isFile()) newest = Math.max(newest, fs.statSync(path.join(entry.parentPath, entry.name)).mtimeMs);\n  }\n  return newest;\n}\n\nlet entry: string[] | undefined;\n/**\n * How to start the CLI: the built entry (`dist/index.js`) when it is at least as new as every file under `src`,\n * otherwise the source entry through tsx. The source entry loads the whole CLI through the TypeScript loader on every\n * start (about 3 s here against 0.65 s for the build), which over this suite's process starts exceeded the 300 s\n * per-file limit on a CI runner. CI builds before it tests; a checkout whose build is missing or older than its\n * source runs the source, so a stale build is never what is tested.\n */\nexport function cliEntry(): string[] {\n  if (entry) return entry;\n  const built = path.join(CLI_DIR, \"dist\", \"index.js\");\n  const current = fs.existsSync(built) && fs.statSync(built).mtimeMs >= newestMtime(path.join(CLI_DIR, \"src\"));\n  return (entry = current ? [built] : [\"--import\", \"tsx\", \"src/index.ts\"]);\n}\n\nexport interface AuditCliRun { code: number | null; stdout: string; stderr: string; leftovers: string[] }\n\n/**\n * Runs `nexus audit <args>` (see `cliEntry`) with a throwaway HOME, its own temp directory and no operator\n * environment but `env`. `leftovers`: what the command left in that temp directory (the export's private copy would be one).\n */\nexport function runAudit(args: string[], env: Record<string, string> = {}): Promise<AuditCliRun> {\n  const base = { ...process.env };\n  for (const key of Object.keys(base)) if (/^(LOCAL_LLM_|LOCAL_HARNESS_|NEXUS_|GIT_)/.test(key) || key === \"NODE_TEST_CONTEXT\" || key === \"FORCE_COLOR\" || key === \"NO_COLOR\") delete base[key];\n  const home = env.HOME ?? makeHome();\n  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-audit-test-tmp-\"));\n  return new Promise((resolve, reject) => {\n    const child = spawn(process.execPath, [...cliEntry(), \"audit\", ...args], {\n      cwd: CLI_DIR,\n      env: { ...base, HOME: home, TMPDIR: tmp, NO_COLOR: \"1\", XDG_CONFIG_HOME: path.join(home, \".config\"), XDG_DATA_HOME: path.join(home, \".local\", \"share\"), XDG_STATE_HOME: path.join(home, \".local\", \"state\"), XDG_CACHE_HOME: path.join(home, \".cache\"), ...env },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout!.on(\"data\", (chunk) => (stdout += chunk));\n    child.stderr!.on(\"data\", (chunk) => (stderr += chunk));\n    child.on(\"error\", reject);\n    child.on(\"close\", (code) => {\n      const leftovers = fs.readdirSync(tmp).filter((name) => name.startsWith(\"nexus-\"));\n      fs.rmSync(tmp, { recursive: true, force: true });\n      if (env.HOME === undefined) fs.rmSync(home, { recursive: true, force: true });\n      resolve({ code, stdout, stderr, leftovers });\n    });\n  });\n}\n  /** The remembered processes that are still running. */\n  survivors(): ProcessIdentity[];\n  /** Stops everything this world started and removes its directories. Call from `finally`. */\n  cleanup(): Promise<void>;\n}\n\nexport async function until<T>(read: () => T | undefined | false, timeoutMs: number, what: () => string): Promise<T> {\n  for (const deadline = Date.now() + timeoutMs; ;) {\n    let value: T | undefined | false;\n    try { value = read(); } catch { value = undefined; }\n    if (value !== undefined && value !== false) return value;\n    if (Date.now() > deadline) throw new Error(`timed out waiting for ${what()}`);\n    await new Promise((resolve) => setTimeout(resolve, 50));\n  }\n}\n\nexport function runnerWorld(): RunnerWorld {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-runner-\"));\n  const home = path.join(root, \"home\");\n  const stateDir = path.join(root, \"state\");\n  fs.mkdirSync(home, { recursive: true, mode: 0o700 });\n  const paths = runnerPaths(path.join(stateDir, \"runner\"));\n  const env: NodeJS.ProcessEnv = { ...process.env };\n  // No operator setting reaches these processes: only what a test passes.\n  for (const key of Object.keys(env)) if (/^(LOCAL_LLM_|LOCAL_HARNESS_|NEXUS_|GIT_)/.test(key) || key === \"NODE_TEST_CONTEXT\" || key === \"FORCE_COLOR\") delete env[key];\n  Object.assign(env, { HOME: home, NEXUS_STATE_DIR: stateDir, NO_COLOR: \"1\", XDG_CONFIG_HOME: path.join(home, \".config\"), XDG_DATA_HOME: path.join(home, \".local\", \"share\"), XDG_STATE_HOME: path.join(home, \".local\", \"state\"), XDG_CACHE_HOME: path.join(home, \".cache\") });\n  const started: CliProcess[] = [];\n  const remembered: ProcessIdentity[] = [];\n\n  const spawnCli = (args: string[], extra: Record<string, string> = {}): CliProcess => {\n    const proc = spawn(process.execPath, [...cliEntry(), ...args], { cwd: CLI_DIR, env: { ...env, ...extra }, stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n    let stdout = \"\";\n    let stderr = \"\";\n    proc.stdout!.on(\"data\", (chunk) => (stdout += chunk));\n    proc.stderr!.on(\"data\", (chunk) => (stderr += chunk));\n    const exited = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve, reject) => {\n      proc.once(\"error\", reject);\n      proc.once(\"close\", (code, signal) => resolve({ code, signal }));\n    });\n    const cli: CliProcess = { proc, identity: proc.pid === undefined ? undefined : identityOf(proc.pid), exited, stdout: () => stdout, stderr: () => stderr };\n    started.push(cli);\n    return cli;\n  };\n\n  const remember = (pid: number) => {\n    for (const child of [pid, ...descendants([pid])]) {\n      const identity = identityOf(child);\n      if (identity && !remembered.some((r) => r.pid === identity.pid && r.startTicks === identity.startTicks)) remembered.push(identity);\n    }\n  };\n\n","exit_code":0,"duration":{"secs":1,"nanos":93214508}},"started_at_ms":1795846183191,"completed_at_ms":1795846184285}}
