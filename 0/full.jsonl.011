{"timestamp":"2026-11-28T06:48:22.919Z","ordinal":315119,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a220e5-c285-7e72-9bb5-c6a32a48db70","item":{"type":"CommandExecution","id":"exec-794e96de-140a-4cb6-93d0-5a413cd5b940","process_id":"54150","command":["/usr/bin/zsh","-lc","sed -n '1,80p' cli/src/core/client_lease.ts; rg -n \"function clientInvocationKind|clientInvocationKind\" cli/src/core/client_lease.ts; sed -n '1,80p' cli/src/index.ts"],"cwd":"file:///home/mike/nexus-wt/p10-04-active-client-admission-continued","parsed_cmd":[{"type":"read","cmd":"sed -n '1,80p' cli/src/core/client_lease.ts","name":"client_lease.ts","path":"cli/src/core/client_lease.ts"},{"type":"search","cmd":"rg -n 'function clientInvocationKind|clientInvocationKind' cli/src/core/client_lease.ts","query":"function clientInvocationKind|clientInvocationKind","path":"client_lease.ts"},{"type":"read","cmd":"sed -n '1,80p' cli/src/index.ts","name":"index.ts","path":"cli/src/index.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/** Lifetime client/maintenance coordination; this is not a boundary against arbitrary same-UID programs. */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { acquireFileGuard, releaseFileGuard, type FileGuard } from \"./file_guard.js\";\nimport { MAX_SHARED_RESOURCE_CAPACITY, SharedResourceAdmission, type ResourceSlotLease } from \"./shared_resource_admission.js\";\n\nconst heartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\nconst activeClientSlots = new WeakMap<FileGuard, ResourceSlotLease>();\nconst activeClientHeartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\nexport const DEFAULT_MAX_ACTIVE_CLIENTS = MAX_SHARED_RESOURCE_CAPACITY;\n\nexport class ClientActiveLimitError extends Error {\n  constructor(readonly limit: number) {\n    super(`Nexus active client limit (${limit}) reached; close another client or set NEXUS_MAX_ACTIVE_CLIENTS to a value from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n    this.name = \"ClientActiveLimitError\";\n  }\n}\n\nfunction maxActiveClients(options: { maxActiveClients?: number }): number {\n  const raw = process.env.NEXUS_MAX_ACTIVE_CLIENTS;\n  const value = options.maxActiveClients ?? (raw === undefined ? DEFAULT_MAX_ACTIVE_CLIENTS : Number(raw));\n  if ((raw !== undefined && options.maxActiveClients === undefined && !/^\\d+$/.test(raw)) ||\n      !Number.isSafeInteger(value) || value < 1 || value > MAX_SHARED_RESOURCE_CAPACITY) {\n    throw new Error(`Invalid NEXUS_MAX_ACTIVE_CLIENTS='${raw ?? value}': expected an integer from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n  }\n  return value;\n}\n\n/** Only unambiguous metadata/recovery invocations may avoid a normal client lifetime lease. */\nexport function clientInvocationKind(args: readonly string[]): \"metadata\" | \"restore\" | \"client\" {\n  const metadata = [\"--version\", \"-V\", \"--help\", \"-h\"];\n  if (args.some(arg => metadata.includes(arg)) && args.every(arg => metadata.includes(arg) || arg === \"--json\" || arg === \"-j\")) return \"metadata\";\n  // A preceding option could consume --help as its value. Bare positional\n  // command names followed by help cannot execute a configured client action.\n  if (args.length > 1 && [\"--help\", \"-h\"].includes(args[args.length - 1]) &&\n      args.slice(0, -1).every(arg => !arg.startsWith(\"-\"))) return \"metadata\";\n  if (args[0] !== \"upgrade\") return \"client\";\n  let restore = false;\n  for (let index = 1; index < args.length; index++) {\n    const arg = args[index];\n    if (arg === \"--json\" || arg === \"-j\") continue;\n    if (arg.startsWith(\"--prefix=\")) continue;\n    if (arg.startsWith(\"--restore-backup=\")) {\n      if (restore || arg === \"--restore-backup=\") return \"client\";\n      restore = true;\n      continue;\n    }\n    if (arg === \"--prefix\" || arg === \"--restore-backup\") {\n      if (index + 1 >= args.length || (arg === \"--restore-backup\" && args[index + 1].startsWith(\"-\"))) return \"client\";\n      if (arg === \"--restore-backup\") {\n        if (restore) return \"client\";\n        restore = true;\n      }\n      index++; // Do not mistake an option's value for a recovery flag.\n      continue;\n    }\n    return \"client\";\n  }\n  return restore ? \"restore\" : \"client\";\n}\n\nexport class ClientLeaseBusyError extends Error {\n  constructor(exclusive: boolean) {\n    super(exclusive\n      ? \"Close all other Nexus clients before restoring configuration or state.\"\n      : \"Nexus state maintenance is active; retry after recovery finishes.\");\n    this.name = \"ClientLeaseBusyError\";\n  }\n}\n\n/** Independent of TMPDIR so cooperating clients for the same canonical home always meet at one inode. */\nexport function clientLeasePath(homeDir: string): string {\n  if (process.platform !== \"linux\" || typeof process.getuid !== \"function\") {\n    throw new Error(\"Managed Nexus maintenance requires Linux kernel client leases\");\n  }\n  const uid = process.getuid();\n  const directory = path.join(\"/tmp\", `nexus-client-leases-${uid}`);\n  try { fs.mkdirSync(directory, { mode: 0o700 }); }\n  catch (error: any) { if (error.code !== \"EEXIST\") throw error; }\n31:export function clientInvocationKind(args: readonly string[]): \"metadata\" | \"restore\" | \"client\" {\n#!/usr/bin/env node\nimport { parseOperatorAnswers } from \"./core/needs_input.js\";\nimport { forkStartError, forkStartNotice, startFork } from \"./core/fork_start.js\";\nimport { Command } from \"commander\";\nimport * as path from \"node:path\";\nimport * as fs from \"node:fs\";\nimport { execSync, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { AutonomousAgent } from \"./agent.js\";\nimport { ApplicationCore } from \"./core/app.js\";\nimport { InteractiveRepl } from \"./repl.js\";\nimport { LocalLlmClient } from \"./client.js\";\nimport { SessionManager } from \"./session.js\";\nimport { SkillManager } from \"./skills.js\";\nimport {\n  evaluateSkillQualification,\n  loadQualificationFixtures,\n  recordSkillQualification,\n} from \"./core/skills_qualification.js\";\nimport { McpClientManager } from \"./mcp.js\";\nimport { PluginManager } from \"./plugins.js\";\nimport { HarnessConfig } from \"./types.js\";\nimport { FlightPlayer } from \"./flight.js\";\nimport { WorktreeManager } from \"./worktree.js\";\nimport { lazyProviderCompleter } from \"./worktrunk/provider.js\";\nimport { HunkStager } from \"./stager.js\";\nimport { BenchmarkEvaluator } from \"./evaluator.js\";\nimport { SynthesizerEngine } from \"./synthesizer.js\";\nimport { BrowserDriver } from \"./browser.js\";\nimport { KnowledgeGraph } from \"./knowledge.js\";\nimport { TaskStateNotFoundError } from \"./core/state.js\";\nimport { buildConfig as buildConfigOrThrow, loadEnvironment, operatorConfigLoadError, withoutProjectEnvironment } from \"./config.js\";\nimport { describeTarget, registerProviderCommands } from \"./provider_cli.js\";\nimport { registerHookCommands } from \"./hooks_cli.js\";\nimport { registerTriggerCommands } from \"./triggers_cli.js\";\nimport { registerPluginPackageCommands } from \"./plugins_cli.js\";\nimport { printable } from \"./core/printable.js\";\nimport { UsageLedger } from \"./usage.js\";\nimport { DOCTOR_EXIT, DOCTOR_SCHEMA_VERSION, doctorExitCode, renderDoctorJson, renderDoctorText, runDoctor, runRepairs } from \"./doctor.js\";\nimport { promptWorkspaceTrust } from \"./startup_trust.js\";\nimport { isolateEvalCommandHome, runVersionedEvalCommand } from \"./eval_cli.js\";\nimport { redactDiagnosticForOutput } from \"./core/persistence_protection.js\";\nimport { formatDiagnosticForOutput } from \"./ui.js\";\nimport { streamEventSink, streamObserver } from \"./stream_json.js\";\nimport { RUN_RESULT_SCHEMA_VERSION, resolveRunTask, runExitCode, runJsonResult } from \"./run_contract.js\";\nimport { VERIFY_RESULT_SCHEMA_VERSION, verifyExitCode, type VerifyJsonError } from \"./verify_contract.js\";\nimport { VerifyInterrupted, VerifyUsageError, renderVerifyText, verifyChange, type VerifySandboxRequest } from \"./core/verify.js\";\nimport { acpStartupRefusal, runAcpStdio } from \"./acp_stdio.js\";\n\nfunction collectAnswer(value: string, previous: string[] = []): string[] {\n  return [...previous, value];\n}\n\nfunction collectDeliverableFile(value: string, previous: string[] = []): string[] {\n  return [...previous, value];\n}\n\n/** Configuration errors (unknown provider, missing model or base URL) end the command with a message, not a trace. */\nfunction buildConfig(options: any): HarnessConfig {\n  try {\n    return buildConfigOrThrow(options);\n  } catch (err: any) {\n    console.error(pc.red(`Configuration error: ${formatDiagnosticForOutput(err)}`));\n    process.exit(2);\n  }\n}\nimport { registerOperationCommands } from \"./operation_cli.js\";\nimport { registerHarnessCommands } from \"./harness_cli.js\";\nimport { registerBackgroundCommands } from \"./background_cli.js\";\nimport { registerScheduleCommands } from \"./schedule_cli.js\";\nimport { requireManagedPolicyAtStartup } from \"./core/policy_runtime.js\";\nimport { registerPolicyCommands } from \"./policy_cli.js\";\nimport { managedPolicy, verifyFlagRefusal } from \"./core/policy_runtime.js\";\nimport { registerAuditCommands } from \"./audit_cli.js\";\nimport pc from \"picocolors\";\n\nimport * as os from \"node:os\";\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n","exit_code":0,"duration":{"secs":0,"nanos":748068000}},"started_at_ms":1795848502170,"completed_at_ms":1795848502919}}
