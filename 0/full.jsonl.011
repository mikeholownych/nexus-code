{"timestamp":"2026-11-28T06:46:39.188Z","ordinal":315063,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a220e5-c285-7e72-9bb5-c6a32a48db70","item":{"type":"CommandExecution","id":"exec-4a2f4f35-bc7b-4f1e-9fec-7f97bd55c2a0","process_id":"98645","command":["/usr/bin/zsh","-lc","sed -n '1,90p' cli/scripts/run_tests.mjs; sed -n '1,80p' cli/scripts/run_tests_driver.mjs; sed -n '1,80p' cli/test/helpers/setup.ts; sed -n '1,80p' cli/test/helpers/leak_guard.ts; sed -n '1,80p' cli/test/audit_command.test.ts; sed -n '1,100p' cli/test/helpers/audit_fixture.ts; sed -n '395,435p' cli/test/helpers/audit_fixture.ts; sed -n '1,150p' cli/test/schedule_cli.test.ts"],"cwd":"file:///home/mike/nexus-wt/p10-04-active-client-admission-continued","parsed_cmd":[{"type":"read","cmd":"sed -n '1,90p' cli/scripts/run_tests.mjs","name":"run_tests.mjs","path":"cli/scripts/run_tests.mjs"},{"type":"read","cmd":"sed -n '1,80p' cli/scripts/run_tests_driver.mjs","name":"run_tests_driver.mjs","path":"cli/scripts/run_tests_driver.mjs"},{"type":"read","cmd":"sed -n '1,80p' cli/test/helpers/setup.ts","name":"setup.ts","path":"cli/test/helpers/setup.ts"},{"type":"read","cmd":"sed -n '1,80p' cli/test/helpers/leak_guard.ts","name":"leak_guard.ts","path":"cli/test/helpers/leak_guard.ts"},{"type":"read","cmd":"sed -n '1,80p' cli/test/audit_command.test.ts","name":"audit_command.test.ts","path":"cli/test/audit_command.test.ts"},{"type":"read","cmd":"sed -n '1,100p' cli/test/helpers/audit_fixture.ts","name":"audit_fixture.ts","path":"cli/test/helpers/audit_fixture.ts"},{"type":"read","cmd":"sed -n '395,435p' cli/test/helpers/audit_fixture.ts","name":"audit_fixture.ts","path":"cli/test/helpers/audit_fixture.ts"},{"type":"read","cmd":"sed -n '1,150p' cli/test/schedule_cli.test.ts","name":"schedule_cli.test.ts","path":"cli/test/schedule_cli.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"// Runs the CLI test suite with a throwaway HOME so no test (or anything it spawns: the sidecar, the TUI, PTY drivers)\n// can read or write the operator's ~/.nexus or ~/.config/nexus. The real home is passed as NEXUS_TEST_REAL_HOME so the\n// guard test can prove the isolation held. Arguments are test files; none means every test/*.test.ts.\n// NEXUS_KEEP_TEST_HOME=1 keeps the temporary home for inspection.\n// One node:test run (run_tests_driver.mjs, in its own process group, files one at a time as before) with a per-file\n// watchdog: a file still running after NEXUS_TEST_FILE_TIMEOUT_SECS (default 300) is named with its last output, the\n// whole group is killed, and the run restarts with the remaining files so every other failure is still reported.\nimport { spawn } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst cli = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst realHome = os.homedir();\nconst home = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-test-home-\"));\n\nconst files = process.argv.length > 2\n  ? process.argv.slice(2)\n  : [\n      ...fs.readdirSync(path.join(cli, \"test\")).filter((f) => f.endsWith(\".test.ts\")).sort().map((f) => path.join(\"test\", f)),\n      path.resolve(cli, \"../eval/dataset.test.mjs\"),\n      path.resolve(cli, \"../eval/package_runtime.test.mjs\"),\n    ];\n\nconst env = {\n  ...process.env,\n  HOME: home,\n  XDG_CONFIG_HOME: path.join(home, \".config\"),\n  XDG_DATA_HOME: path.join(home, \".local\", \"share\"),\n  XDG_STATE_HOME: path.join(home, \".local\", \"state\"),\n  XDG_CACHE_HOME: path.join(home, \".cache\"),\n  NEXUS_TEST_REAL_HOME: realHome,\n};\n// This process writes the durations file. A test that starts a nested runner must not inherit the path and write over it.\ndelete env.NEXUS_TEST_DURATIONS_OUT;\n// Rust and Node toolchains installed per user keep working under the throwaway home.\nfor (const [key, dir] of [[\"CARGO_HOME\", \".cargo\"], [\"RUSTUP_HOME\", \".rustup\"]]) {\n  if (!env[key] && fs.existsSync(path.join(realHome, dir))) env[key] = path.join(realHome, dir);\n}\n\nconst timeoutSecs = Number(process.env.NEXUS_TEST_FILE_TIMEOUT_SECS) > 0 ? Number(process.env.NEXUS_TEST_FILE_TIMEOUT_SECS) : 300;\nconst driver = path.join(cli, \"scripts\", \"run_tests_driver.mjs\");\nlet current = null;\n\nfunction killGroup(child) {\n  try { process.kill(-child.pid, \"SIGKILL\"); } catch { try { child.kill(\"SIGKILL\"); } catch {} }\n}\n\nfunction cleanupHome() {\n  if (process.env.NEXUS_KEEP_TEST_HOME === \"1\") console.error(`test home kept at ${home}`);\n  else fs.rmSync(home, { recursive: true, force: true });\n}\n\nfor (const signal of [\"SIGINT\", \"SIGTERM\"]) {\n  process.on(signal, () => {\n    if (current) killGroup(current);\n    cleanupHome();\n    process.exit(1);\n  });\n}\n\nfunction runSegment(segment) {\n  return new Promise((resolve) => {\n    const child = spawn(process.execPath, [driver, ...segment], { cwd: cli, env, detached: true, stdio: [\"inherit\", \"inherit\", \"inherit\", \"pipe\"] });\n    current = child;\n    const result = { timedOut: undefined, done: undefined };\n    let buffered = \"\";\n    child.stdio[3].on(\"data\", (chunk) => {\n      buffered += chunk.toString();\n      const lines = buffered.split(\"\\n\");\n      buffered = lines.pop() ?? \"\";\n      for (const line of lines.filter(Boolean)) {\n        const message = JSON.parse(line);\n        if (message.done) result.done = message;\n        if (message.duration) {\n          const { file, secs } = message.duration;\n          durations.set(file, Math.max(durations.get(file) ?? 0, secs));\n        }\n        if (message.timeout && !result.timedOut) {\n          result.timedOut = message.timeout;\n          console.error(`\\nTEST FILE TIMEOUT after ${timeoutSecs}s: ${message.timeout}\\nlast output:\\n${message.tail.map((l) => `  | ${l}`).join(\"\\n\")}`);\n          killGroup(child);\n        }\n      }\n    });\n    child.on(\"error\", () => resolve(result));\n    child.on(\"close\", () => { killGroup(child); resolve(result); });\n  });\n}\n// One node:test run over the given files (one file at a time) with a per-file watchdog. Started by run_tests.mjs in its\n// own process group; reports to the parent on fd 3 as JSON lines: {\"timeout\":file,\"tail\":[...]} when the file under test\n// exceeds NEXUS_TEST_FILE_TIMEOUT_SECS (the parent then kills the group and restarts with the remaining files), and\n// {\"done\":true,\"tests\":n,\"fail\":n} when the run ends. Output keeps the spec reporter format, with colour on a TTY.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { run } from \"node:test\";\nimport { spec } from \"node:test/reporters\";\n\nconst files = process.argv.slice(2);\nconst cwd = process.cwd();\nconst timeoutMs = (Number(process.env.NEXUS_TEST_FILE_TIMEOUT_SECS) > 0 ? Number(process.env.NEXUS_TEST_FILE_TIMEOUT_SECS) : 300) * 1000;\nconst report = (message) => fs.writeSync(3, `${JSON.stringify(message)}\\n`);\n\nconst stream = run({ files, concurrency: 1, isolation: \"process\", execArgv: [\"--import\", \"tsx\"] });\nlet timer;\nlet tail = [];\nconst lastLines = (text) => { tail = [...tail, ...String(text).split(\"\\n\").filter(Boolean)].slice(-20); };\nconst watch = (file) => {\n  clearTimeout(timer);\n  tail = [];\n  timer = setTimeout(() => report({ timeout: file, tail }), timeoutMs);\n};\n// The watchdog is armed by the first top-level event of each file. Node 24 emits one named after the file itself; Node 22\n// (process isolation) emits only the file's own top-level tests, so keying on a file-named event never armed it there.\nlet current;\nlet startedAt = 0;\nconst secondsSinceStart = () => (Date.now() - startedAt) / 1000;\nconst reportDuration = (file) => {\n  if (!file || !startedAt) return;\n  report({ duration: { file: path.relative(cwd, file).split(path.sep).join(\"/\"), secs: Math.round(secondsSinceStart() * 100) / 100 } });\n};\nstream.on(\"test:dequeue\", (e) => {\n  if (e.nesting === 0 && e.file && e.file !== current) {\n    reportDuration(current);\n    current = e.file;\n    startedAt = Date.now();\n    watch(e.file);\n  }\n});\nstream.on(\"test:stdout\", (e) => lastLines(e.message));\nstream.on(\"test:stderr\", (e) => lastLines(e.message));\nstream.on(\"test:pass\", (e) => lastLines(`ok ${e.name}`));\nstream.on(\"test:fail\", (e) => lastLines(`not ok ${e.name}`));\nlet counts = { tests: 0, failed: 0 };\nstream.on(\"test:summary\", (e) => { if (!e.file) counts = e.counts; });\nconst output = stream.compose(new spec());\noutput.pipe(process.stdout, { end: false });\noutput.on(\"end\", () => {\n  clearTimeout(timer);\n  reportDuration(current);\n  report({ done: true, tests: counts.tests, fail: counts.failed });\n  process.stdout.write(\"\", () => process.exit(counts.failed ? 1 : 0));\n});\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\n\n// Global test setup for HOME and state directory isolation (REQ-PER-103, ACC-PER-03, PLAN-08 Task 1).\nconst realHome = process.env.NEXUS_TEST_REAL_HOME || os.homedir();\nif (!process.env.NEXUS_TEST_REAL_HOME) {\n  process.env.NEXUS_TEST_REAL_HOME = realHome;\n}\n\nif (!process.env.HOME || path.resolve(process.env.HOME) === path.resolve(realHome)) {\n  const isolatedHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-test-home-\"));\n  process.env.HOME = isolatedHome;\n  process.env.XDG_CONFIG_HOME = path.join(isolatedHome, \".config\");\n  process.env.XDG_DATA_HOME = path.join(isolatedHome, \".local\", \"share\");\n  process.env.XDG_STATE_HOME = path.join(isolatedHome, \".local\", \"state\");\n  process.env.XDG_CACHE_HOME = path.join(isolatedHome, \".cache\");\n  process.env.NEXUS_STATE_DIR = path.join(isolatedHome, \".nexus\");\n}\n/**\n * Leak and hang guard: `import \"./helpers/leak_guard.js\";` at the top of a test file fails the file in teardown, naming\n * every RustCoreBridge or AutonomousAgent not shut down, scripted gateway not closed, child process still running and\n * timer still pending, then releases them so the process can exit instead of hanging the job.\n * Resources it cannot see by itself (a custom server) can be registered with `trackResource`.\n * Timers: ref'd timeouts above the count when the file finished loading (a timer created while the file loads is not\n * counted; node:test's own timers are gone by teardown). The check hook is registered once the file has finished\n * loading, so it runs after the file's own `after` hooks; a file that registers hooks after a top-level `await` can run\n * its hooks after the guard's check, and should then release in the test itself.\n */\nimport { after } from \"node:test\";\nimport childProcess from \"node:child_process\";\nimport { RustCoreBridge } from \"../../src/tools.js\";\nimport { survivors, trackResource, clearTracked } from \"./leak_registry.js\";\n\nexport { trackResource };\n\nconst proto = childProcess.ChildProcess.prototype as any;\nconst originalSpawn = proto.spawn;\nproto.spawn = function (this: childProcess.ChildProcess, ...args: unknown[]) {\n  const result = originalSpawn.apply(this, args);\n  const command = [String((this as any).spawnfile ?? \"\"), ...((this as any).spawnargs ?? []).slice(1)].join(\" \").slice(0, 120);\n  trackResource(\"child process\", `pid ${this.pid} ${command}`, () => this.exitCode === null && this.signalCode === null, () => {\n    try { process.kill(-(this.pid as number), \"SIGKILL\"); } catch { this.kill(\"SIGKILL\"); }\n  });\n  return result;\n};\n\nlet baselineTimers = 0;\nfunction activeTimers(): number {\n  return process.getActiveResourcesInfo().filter((r) => r === \"Timeout\").length;\n}\n\nexport function describeSurvivors(): string[] {\n  const lines = survivors().map((s) => `${s.kind}: ${s.name}`);\n  for (const bridge of (RustCoreBridge as any).activeBridges as Set<RustCoreBridge>) lines.push(`RustCoreBridge not shut down (workspace ${(bridge as any).workspace}); an AutonomousAgent owns one: call agent.shutdown()`);\n  const timers = activeTimers() - baselineTimers;\n  if (timers > 0) lines.push(`${timers} timer(s) still pending`);\n  return lines;\n}\n\n// Registered once the file has finished loading so it runs after the file's own `after` hooks.\nqueueMicrotask(() => {\n  baselineTimers = activeTimers();\n  after(async () => {\n    let lines = describeSurvivors();\n    for (let i = 0; i < 20 && lines.length; i++) {\n      await new Promise((r) => setTimeout(r, 100));\n      lines = describeSurvivors();\n    }\n    if (!lines.length) return;\n    for (const s of survivors()) await Promise.resolve(s.release()).catch(() => {});\n    (RustCoreBridge as any).shutdownAllGlobal();\n    clearTracked();\n    setTimeout(() => process.stdout.write(\"\", () => process.exit(1)), 5_000).unref();\n    throw new Error(`${process.argv[1] ?? \"test file\"} leaked ${lines.length} resource(s) past the end of the file:\\n  ${lines.join(\"\\n  \")}`);\n  });\n});\n/**\n * GV-2: `nexus audit export` and `nexus audit verify` as commands (src/audit_cli.ts), run through the real CLI entry\n * with a throwaway HOME and NEXUS_STATE_DIR: the round trip an auditor makes, the exit codes, the JSON documents, and\n * that `nexus audit` itself still prints the tool audit log and no longer accepts a mistyped subcommand. What an export\n * collects is tested in this process in test/audit_export.test.ts; each case here costs a process start, so they are few\n * and run side by side.\n */\nimport { after, test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { generateKeyPairSync } from \"node:crypto\";\nimport { AUDIT_EXIT_CODES } from \"../src/audit_contract.js\";\nimport { AUDIT_STANDARD_REDACTION_NOTE } from \"../src/audit_export.js\";\nimport { AUDIT_UNSIGNED_CAVEAT } from \"../src/core/audit_bundle.js\";\nimport { ATTEMPTS_PATH, AUDIT_VERIFY_SCHEMA, CLI_DIR, FLIGHT_PATH, assertManifestValid, cleanTemp, fixtureInput, flipByte, readManifest, runAudit, savedSubject, snapshot, tempDir, writeFixture, type AuditCliRun, type SubjectFixture } from \"./helpers/audit_fixture.js\";\nimport { validate } from \"./helpers/json_schema.js\";\n\nafter(cleanTemp);\n\nconst MANUAL = path.resolve(CLI_DIR, \"..\", \"docs\", \"USER_MANUAL.md\");\nconst stateEnv = (subject: SubjectFixture): Record<string, string> => ({ NEXUS_STATE_DIR: path.join(subject.root, \"state\") });\n\n/** Keep the real-CLI subprocess fan-out bounded on slower CI workers. */\nasync function runAuditBatch(calls: Array<() => Promise<AuditCliRun>>, concurrency = 2): Promise<AuditCliRun[]> {\n  const results: AuditCliRun[] = [];\n  for (let start = 0; start < calls.length; start += concurrency) {\n    results.push(...await Promise.all(calls.slice(start, start + concurrency).map((call) => call())));\n  }\n  return results;\n}\n\n/** What a consumer does with `--json`: stdout is exactly one document of the published schema, and `exitCode` is the process's. */\nfunction consume(run: AuditCliRun): any {\n  let document: any;\n  try {\n    document = JSON.parse(run.stdout);\n  } catch {\n    assert.fail(`stdout is not one JSON document: ${run.stdout.slice(0, 200)}\\nstderr: ${run.stderr.slice(0, 400)}`);\n  }\n  assert.equal(run.stdout, `${JSON.stringify(document, null, 2)}\\n`, \"nothing but the document on stdout\");\n  assert.deepEqual(validate(document, AUDIT_VERIFY_SCHEMA, AUDIT_VERIFY_SCHEMA), [], \"the document validates against docs/protocol/audit-verify-result schema\");\n  assert.equal(Object.keys(document)[0], \"schema_version\");\n  assert.equal(document.exitCode, run.code, \"exitCode repeats the process exit code\");\n  assert.deepEqual(run.leftovers, [], \"nothing is left in the temp directory\");\n  return document;\n}\n\ntest(\"the manual's audit exit-code table is the exported table, and points at docs/AUDIT.md\", () => {\n  const manual = fs.readFileSync(MANUAL, \"utf8\");\n  const start = manual.indexOf(\"#### Exit codes of `nexus audit export` and `nexus audit verify`\");\n  assert.ok(start >= 0, \"the manual has the section\");\n  const rows = manual.slice(start).split(\"\\n\").slice(1);\n  const first = rows.findIndex((line) => line.startsWith(\"|\"));\n  const table: string[] = [];\n  for (let i = first; i < rows.length && rows[i].startsWith(\"|\"); i++) table.push(rows[i]);\n  const cells = table.map((line) => line.split(\"|\").slice(1, -1).map((cell) => cell.trim()));\n  assert.deepEqual(cells[0], [\"Code\", \"Name\", \"When\"]);\n  assert.match(cells[1].join(\"\"), /^[-: ]+$/);\n  assert.deepEqual(\n    cells.slice(2).map(([code, name, when]) => ({ code: Number(code), name: name.replace(/`/g, \"\"), when })),\n    AUDIT_EXIT_CODES.map((row) => ({ ...row })),\n  );\n  const section = manual.slice(manual.indexOf(\"### `nexus audit export` / `nexus audit verify`\"), start);\n  assert.match(section, /\\[`docs\\/AUDIT\\.md`\\]\\(AUDIT\\.md\\)/);\n  assert.ok(fs.existsSync(path.resolve(CLI_DIR, \"..\", \"docs\", \"AUDIT.md\")));\n  // The two documents state the unsigned limit in the library's own words, and the redaction limit.\n  const guide = fs.readFileSync(path.resolve(CLI_DIR, \"..\", \"docs\", \"AUDIT.md\"), \"utf8\");\n  for (const text of [guide, section]) {\n    assert.ok(text.includes(AUDIT_UNSIGNED_CAVEAT), \"the unsigned caveat, word for word\");\n    assert.match(text, /secret-redacted, not confidential/);\n  }\n  for (const row of AUDIT_EXIT_CODES) assert.ok(guide.includes(`\\`${row.name}\\``), `docs/AUDIT.md names the exit ${row.name}`);\n});\n\ntest(\"the round trip through the commands: export a saved task, verify it, alter one byte of each kind of payload\", async () => {\n  const subject = savedSubject();\n  const receipt = path.join(subject.root, \"verify-receipt.json\");\n  fs.writeFileSync(receipt, `${JSON.stringify({ schema_version: 1, verdict: \"VERIFIED\", exitCode: 0 }, null, 2)}\\n`);\n  const before = snapshot(path.join(subject.root, \"state\"));\n/**\n * What the audit-bundle tests share (GV-2): a fixture with one artefact of every kind, the schema checks every manifest\n * and result document goes through, a helper that re-seals a manifest the way someone rewriting a bundle would, and a\n * spy that records every path handed to `node:fs`. For the collectors and the commands: a saved task or session with\n * every artefact an export takes (no model involved), the export in this process, and the real CLI.\n */\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { syncBuiltinESMExports } from \"node:module\";\nimport { auditBundleSchemaFile, auditVerifyResultSchemaFile } from \"../../scripts/gen_audit_schema.mjs\";\nimport { AUDIT_BUNDLE_SCHEMA_VERSION, AUDIT_VERIFY_RESULT_SCHEMA_VERSION, auditExitCode, type AuditExitName, type AuditManifest, type AuditVerifyOutput, type AuditVerifyResult } from \"../../src/audit_contract.js\";\nimport { renderAuditVerifyText, verifyAuditBundle, writeAuditBundle, type AuditBundleInput, type VerifyAuditBundleOptions, type WrittenAuditBundle } from \"../../src/core/audit_bundle.js\";\nimport { canonicalJson, linkRecord, type ChainLink } from \"../../src/core/hash_chain.js\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { DurableStateManager } from \"../../src/core/state.js\";\nimport { WorkspacePath } from \"../../src/core/workspace_path.js\";\nimport { FlightRecorder } from \"../../src/flight.js\";\nimport { exportAuditBundle, type AuditExport, type AuditExportRequest } from \"../../src/audit_export.js\";\nimport { makeHome } from \"./fixtures.js\";\nimport { validate, type Schema } from \"./json_schema.js\";\n\nexport const AUDIT_BUNDLE_SCHEMA_TEXT = fs.readFileSync(auditBundleSchemaFile(AUDIT_BUNDLE_SCHEMA_VERSION), \"utf8\");\nexport const AUDIT_BUNDLE_SCHEMA: Schema = JSON.parse(AUDIT_BUNDLE_SCHEMA_TEXT);\nexport const AUDIT_VERIFY_SCHEMA_TEXT = fs.readFileSync(auditVerifyResultSchemaFile(AUDIT_VERIFY_RESULT_SCHEMA_VERSION), \"utf8\");\nexport const AUDIT_VERIFY_SCHEMA: Schema = JSON.parse(AUDIT_VERIFY_SCHEMA_TEXT);\n\nexport const sha256 = (data: Uint8Array | string): string => createHash(\"sha256\").update(data).digest(\"hex\");\n\nconst tempDirs: string[] = [];\n/** A fresh directory; `cleanTemp` (call it from `after`) removes every one made. */\nexport function tempDir(): string {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-gv2-\"));\n  tempDirs.push(dir);\n  return dir;\n}\nexport function cleanTemp(): void {\n  for (const dir of tempDirs.splice(0)) fs.rmSync(dir, { recursive: true, force: true });\n}\n\n/** Chained records as one JSON line each, the form of a flight log and of the config-attempt log. */\nexport function chainedLines(contents: object[]): string[] {\n  const lines: string[] = [];\n  let previous: ChainLink | undefined;\n  for (const content of contents) {\n    const record = linkRecord(content, previous);\n    previous = record.chain;\n    lines.push(JSON.stringify(record));\n  }\n  return lines;\n}\n\nexport const FLIGHT_PATH = \"flights/flight-1.flightlog\";\nexport const ATTEMPTS_PATH = \"verification/config-attempts.jsonl\";\nexport const FLIGHT_EVENTS = [\n  { type: \"session_start\", timestamp: 0, payload: { flightId: \"flight-1\", model: \"m\", taskPrompt: \"do the thing\" } },\n  { type: \"turn_start\", step: 1, timestamp: 1, payload: { prompt: \"do the thing\" } },\n  { type: \"tool_call\", step: 1, timestamp: 2, payload: { name: \"read_file\", args: { path: \"a.ts\" } } },\n  { type: \"tool_result\", step: 1, timestamp: 3, payload: { ok: true, output: \"contents héllo ✓\" } },\n  { type: \"session_end\", timestamp: 4, payload: { summary: \"done\", success: true } },\n];\nconst text = (value: string): Uint8Array => Buffer.from(value, \"utf8\");\nconst json = (value: unknown): Uint8Array => text(`${JSON.stringify(value, null, 2)}\\n`);\n\n/** One artefact of every role the first slices write, two of them chained logs. The same bytes on every call. */\nexport function fixtureInput(): AuditBundleInput {\n  return {\n    subject: { kind: \"task\", task_id: \"task-1\", session_id: null, store: \"tasks\", workspace_path: \"/work/repo\", workspace_sha256: sha256(\"/work/repo\"), status: \"completed\", updated_at: \"2026-11-22T09:00:00.000Z\", at_rest: true },\n    nexus: { version: \"1.3.0\", commit: \"0123abc\", dirty: false },\n    redaction: \"standard\",\n    artefacts: [\n      { path: \"session/export.json\", role: \"session_export\", bytes: json({ format: \"nexus-session-export/2\", messages: [{ role: \"user\", content: \"do the thing\" }] }) },\n      { path: \"session/export.md\", role: \"session_export_markdown\", bytes: text(\"# Session\\n\\ndo the thing\\n\") },\n      { path: \"receipts/validation-receipts.json\", role: \"validation_receipts\", bytes: json([{ id: \"r1\", command: \"npm test\", passed: true }]) },\n      { path: \"receipts/last-turn.json\", role: \"last_turn\", bytes: json({ execution: \"COMPLETED\", outcome: \"VERIFIED\" }) },\n      { path: \"verification/attempts.json\", role: \"verification_attempts\", bytes: json([{ attempt: 1, verdict: \"pass\" }]) },\n      { path: ATTEMPTS_PATH, role: \"verification_config_attempts\", bytes: text(`${chainedLines([{ path: \"package.json\", decision: \"blocked\" }, { path: \"vitest.config.ts\", decision: \"approved\" }]).join(\"\\n\")}\\n`) },\n      { path: \"evidence/provenance.json\", role: \"evidence_provenance\", bytes: json({ \"REQ-1\": [\"test:a\"] }) },\n      { path: \"evidence/findings.json\", role: \"evidence_findings\", bytes: json([]) },\n      { path: \"evidence/diffs/op-1.diff\", role: \"diff\", bytes: text(\"@@ -1 +1 @@\\n-a\\n+b\\n\") },\n      { path: FLIGHT_PATH, role: \"flight_log\", bytes: text(`${chainedLines(FLIGHT_EVENTS).join(\"\\n\")}\\n`) },\n    ],\n    chainedLogs: [\n      { path: FLIGHT_PATH, kind: \"flight\", closed: true, selection: \"explicit\" },\n      { path: ATTEMPTS_PATH, kind: \"verification_config_attempts\" },\n    ],\n    omitted: [{ artefact: \"traces\", reason: \"not requested\" }],\n  };\n}\n\nexport const FIXED_NOW = (): Date => new Date(\"2026-11-22T10:00:00.000Z\");\nexport const FIXED_ID = \"ab\".repeat(16);\n\nexport function assertManifestValid(manifest: unknown): void {\n  assert.deepEqual(validate(manifest, AUDIT_BUNDLE_SCHEMA, AUDIT_BUNDLE_SCHEMA), [], \"the manifest does not validate against docs/protocol/audit-bundle schema\");\n}\n\n * start (about 3 s here against 0.65 s for the build), which over this suite's process starts exceeded the 300 s\n * per-file limit on a CI runner. CI builds before it tests; a checkout whose build is missing or older than its\n * source runs the source, so a stale build is never what is tested.\n */\nexport function cliEntry(): string[] {\n  if (entry) return entry;\n  const built = path.join(CLI_DIR, \"dist\", \"index.js\");\n  const current = fs.existsSync(built) && fs.statSync(built).mtimeMs >= newestMtime(path.join(CLI_DIR, \"src\"));\n  return (entry = current ? [built] : [\"--import\", \"tsx\", \"src/index.ts\"]);\n}\n\nexport interface AuditCliRun { code: number | null; stdout: string; stderr: string; leftovers: string[] }\n\n/**\n * Runs `nexus audit <args>` (see `cliEntry`) with a throwaway HOME, its own temp directory and no operator\n * environment but `env`. `leftovers`: what the command left in that temp directory (the export's private copy would be one).\n */\nexport function runAudit(args: string[], env: Record<string, string> = {}): Promise<AuditCliRun> {\n  const base = { ...process.env };\n  for (const key of Object.keys(base)) if (/^(LOCAL_LLM_|LOCAL_HARNESS_|NEXUS_|GIT_)/.test(key) || key === \"NODE_TEST_CONTEXT\" || key === \"FORCE_COLOR\" || key === \"NO_COLOR\") delete base[key];\n  const home = env.HOME ?? makeHome();\n  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-audit-test-tmp-\"));\n  return new Promise((resolve, reject) => {\n    const child = spawn(process.execPath, [...cliEntry(), \"audit\", ...args], {\n      cwd: CLI_DIR,\n      env: { ...base, HOME: home, TMPDIR: tmp, NO_COLOR: \"1\", XDG_CONFIG_HOME: path.join(home, \".config\"), XDG_DATA_HOME: path.join(home, \".local\", \"share\"), XDG_STATE_HOME: path.join(home, \".local\", \"state\"), XDG_CACHE_HOME: path.join(home, \".cache\"), ...env },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout!.on(\"data\", (chunk) => (stdout += chunk));\n    child.stderr!.on(\"data\", (chunk) => (stderr += chunk));\n    child.on(\"error\", reject);\n    child.on(\"close\", (code) => {\n      const leftovers = fs.readdirSync(tmp).filter((name) => name.startsWith(\"nexus-\"));\n      fs.rmSync(tmp, { recursive: true, force: true });\n      if (env.HOME === undefined) fs.rmSync(home, { recursive: true, force: true });\n      resolve({ code, stdout, stderr, leftovers });\n    });\n  });\n}\n/**\n * BG-2: `nexus schedule add|list|status|remove|pause|resume|run-now` as the real CLI. What a schedule can ask for is\n * what a job can ask for and no more; the permission level is fixed at creation; an untrusted workspace, a bad\n * expression, a schedule file that does not look like one this program wrote, and a 65th schedule are refused.\n */\nimport \"./helpers/leak_guard.js\";\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport { listJobs } from \"../src/core/runner_store.js\";\nimport { listSchedules, MAX_SCHEDULES, newScheduleState, readSchedule, schedulePaths, writeSchedule, type ScheduleRecord } from \"../src/core/schedule_store.js\";\nimport { DEFAULT_JOB_BUDGETS } from \"../src/core/runner_store.js\";\nimport { makeRepo } from \"./helpers/fixtures.js\";\nimport { runnerWorld, stalledGateway, type RunnerWorld } from \"./helpers/runner_fixture.js\";\n\nasync function withWorld(body: (world: RunnerWorld, repo: string, trusted: () => Promise<void>) => Promise<void>): Promise<void> {\n  const world = runnerWorld();\n  const repo = fs.realpathSync(makeRepo({ \"README.md\": \"hello\\n\" }));\n  try {\n    await body(world, repo, async () => {\n      const trust = await world.run([\"trust\", repo]);\n      assert.equal(trust.code, 0, trust.stderr);\n    });\n  } finally {\n    await world.cleanup();\n    fs.rmSync(repo, { recursive: true, force: true });\n  }\n}\n\nconst add = (world: RunnerWorld, repo: string, ...args: string[]) => world.run([\"schedule\", \"add\", \"--prompt\", \"look at the tests\", \"-w\", repo, ...args]);\n\ntest(\"add refuses a workspace the operator has not trusted, and nothing is written\", { timeout: 120_000 }, async () => {\n  await withWorld(async (world, repo) => {\n    const result = await add(world, repo, \"--name\", \"nightly\", \"--every\", \"15m\");\n    assert.equal(result.code, 2, result.stderr);\n    assert.match(result.stderr, /not a trusted workspace/);\n    assert.match(result.stderr, /nexus trust/);\n    assert.deepEqual(listSchedules(schedulePaths(world.paths)).schedules, []);\n    const writable = await add(world, repo, \"--name\", \"nightly\", \"--every\", \"15m\", \"--allow-worktree-write\");\n    assert.equal(writable.code, 2, \"asking for write access does not change that\");\n    assert.match(writable.stderr, /not a trusted workspace/);\n  });\n});\n\ntest(\"add, list, status, pause, resume and remove: the operator's whole loop\", { timeout: 180_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    const added = await add(world, repo, \"--name\", \"nightly\", \"--cron\", \"0 3 * * 1-5\", \"--verifier\", \"node --test\", \"--max-runs\", \"5\", \"--json\");\n    assert.equal(added.code, 0, added.stderr);\n    const shown = JSON.parse(added.stdout);\n    assert.equal(shown.schedule.id, \"nightly\");\n    assert.equal(shown.schedule.policy, \"read-only\", \"read-only unless the operator says otherwise\");\n    assert.equal(shown.schedule.verifier, \"node --test\");\n    assert.equal(shown.schedule.remainingRuns, 5);\n    assert.equal(shown.schedule.onMissed, \"report\", \"a missed schedule must be reported unless catch-up is explicitly requested\");\n    assert.equal(shown.upcoming.length, 3);\n    assert.equal(shown.schedule.state.nextDueAt, shown.upcoming[0]);\n    const paths = schedulePaths(world.paths);\n    assert.equal(fs.statSync(paths.record(\"nightly\")).mode & 0o777, 0o600);\n    assert.equal(fs.statSync(paths.dir).mode & 0o777, 0o700);\n    assert.equal(readSchedule(paths, \"nightly\")?.workspace, repo);\n\n    const text = await add(world, repo, \"--name\", \"weekly\", \"--every\", \"1d\", \"--allow-worktree-write\", \"--on-missed\", \"report\");\n    assert.equal(text.code, 0, text.stderr);\n    assert.match(text.stdout, /Added schedule weekly/);\n    assert.match(text.stdout, /next runs: /);\n    assert.match(text.stdout, /writes? inside that worktree only|may write inside that worktree only/);\n    assert.equal(readSchedule(paths, \"weekly\")?.policy, \"worktree-write\");\n    assert.equal(readSchedule(paths, \"weekly\")?.onMissed, \"report\");\n    assert.match(text.stderr, /no runner is running/);\n\n    const listed = JSON.parse((await world.run([\"schedule\", \"list\", \"--json\"])).stdout);\n    assert.deepEqual(listed.schedules.map((s: ScheduleRecord) => s.id), [\"nightly\", \"weekly\"]);\n    assert.deepEqual(listed.invalid, []);\n    const plain = await world.run([\"schedule\", \"list\"]);\n    assert.match(plain.stdout, /nightly\\s+enabled\\s+cron 0 3 \\* \\* 1-5 \\(UTC\\)\\s+read-only/);\n\n    const status = JSON.parse((await world.run([\"schedule\", \"status\", \"nightly\", \"--json\"])).stdout);\n    assert.equal(status.schedule.id, \"nightly\");\n    assert.equal(status.latest_job, null);\n    const statusText = await world.run([\"schedule\", \"status\", \"nightly\"]);\n    assert.match(statusText.stdout, /missed runs: 0 \\(none\\)/);\n\n    assert.equal((await world.run([\"schedule\", \"pause\", \"nightly\"])).code, 0);\n    assert.equal(readSchedule(paths, \"nightly\")?.enabled, false);\n    assert.equal((await world.run([\"schedule\", \"resume\", \"nightly\"])).code, 0);\n    assert.equal(readSchedule(paths, \"nightly\")?.enabled, true);\n\n    // A leftover pointer and missed-run receipt go with the schedule.\n    fs.writeFileSync(paths.latest(\"nightly\"), \"{}\", { mode: 0o600 });\n    fs.writeFileSync(paths.missed(\"nightly\", \"2026-11-24T00:00:00.000Z\"), \"{}\", { mode: 0o600 });\n    assert.equal((await world.run([\"schedule\", \"rm\", \"nightly\"])).code, 0);\n    assert.deepEqual(fs.readdirSync(paths.dir).filter((n) => n.startsWith(\"nightly\")), []);\n    assert.deepEqual(listSchedules(paths).schedules.map((s) => s.id), [\"weekly\"]);\n\n    const missing = await world.run([\"schedule\", \"status\", \"nightly\"]);\n    assert.equal(missing.code, 2);\n    assert.match(missing.stderr, /There is no schedule nightly/);\n  });\n});\n\ntest(\"what is not a schedule's to ask: modes, sandbox flags, a second trigger, a bad name, a duplicate, a past time\", { timeout: 240_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    for (const flags of [[\"--yes\"], [\"--mode\", \"auto\"], [\"--approve\"], [\"--sandbox\", \"none\"], [\"--sandbox-network\"], [\"--read-only\"], [\"--dry-run\"]]) {\n      const result = await world.run([...flags, \"schedule\", \"add\", \"--prompt\", \"p\", \"-w\", repo, \"--every\", \"15m\"]);\n      assert.equal(result.code, 2, `${flags.join(\" \")}: ${result.stderr}`);\n      assert.match(result.stderr, /does not apply to a background job and is refused/);\n    }\n    const auto = await add(world, repo, \"--every\", \"15m\");\n    assert.equal(auto.code, 0, auto.stderr);\n    const env = await world.run([\"schedule\", \"add\", \"--prompt\", \"p\", \"-w\", repo, \"--every\", \"15m\"], { NEXUS_APPROVAL_MODE: \"auto\" });\n    assert.equal(env.code, 2);\n    assert.match(env.stderr, /never runs in auto mode/);\n\n    const cases: Array<[string[], RegExp]> = [\n      [[], /exactly one of --cron/],\n      [[\"--cron\", \"* * * * *\", \"--every\", \"5m\"], /exactly one of --cron/],\n      [[\"--every\", \"1m\"], /an interval is from 300 seconds/],\n      [[\"--cron\", \"*/0 * * * *\"], /step of 0/],\n      [[\"--cron\", \"0 0 30 2 *\"], /never matches a date/],\n      [[\"--cron\", \"0 0 31 2 *\"], /never matches a date/],\n      [[\"--cron\", \"@daily\"], /shortcuts/],\n      [[\"--at\", \"2020-01-01T00:00:00Z\"], /not in the future/],\n      [[\"--at\", \"tomorrow\"], /not a UTC time/],\n      [[\"--every\", \"15m\", \"--name\", \"Bad Name\"], /not a schedule id/],\n      [[\"--every\", \"15m\", \"--name\", \"../escape\"], /not a schedule id/],\n      [[\"--every\", \"15m\", \"--max-runs\", \"0\"], /--max-runs must be/],\n      [[\"--every\", \"15m\", \"--on-missed\", \"run-all\"], /--on-missed must be/],\n      [[\"--every\", \"15m\", \"--verifier\", \"  \"], /--verifier needs a command/],\n      [[\"--every\", \"15m\", \"--deliverable-file\", \"../../etc/passwd\"], /.+/],\n    ];\n    for (const [flags, pattern] of cases) {\n      const result = await add(world, repo, ...flags);\n      assert.equal(result.code, 2, `${flags.join(\" \")}: ${result.stdout}${result.stderr}`);\n      assert.match(result.stderr, pattern, flags.join(\" \"));\n    }\n    assert.equal(listSchedules(schedulePaths(world.paths)).schedules.length, 1, \"only the one valid add left a schedule\");\n\n    assert.equal((await add(world, repo, \"--name\", \"same\", \"--every\", \"15m\")).code, 0);\n    const dup = await add(world, repo, \"--name\", \"same\", \"--every\", \"15m\");\n    assert.equal(dup.code, 2);\n    assert.match(dup.stderr, /already a schedule same/);\n  });\n});\n\ntest(\"the 65th schedule is refused\", { timeout: 120_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    const paths = schedulePaths(world.paths);\n","exit_code":0,"duration":{"secs":0,"nanos":756180002}},"started_at_ms":1795848398431,"completed_at_ms":1795848399188}}
{"timestamp":"2026-11-28T06:46:39.234Z","ordinal":315064,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a220e7-e982-7532-a8f1-01d0b0dbe8a9","call_id":"call_aaadba3240ab4e23a2ef925672f6b592","output":[{"type":"input_text","text":"Script completed\nWall time 1.0 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 8211)\nTotal output lines: 592\n\n// Runs the CLI test suite with a throwaway HOME so no test (or anything it spawns: the sidecar, the TUI, PTY drivers)\n// can read or write the operator's ~/.nexus or ~/.config/nexus. The real home is passed as NEXUS_TEST_REAL_HOME so the\n// guard test can prove the isolation held. Arguments are test files; none means every test/*.test.ts.\n// NEXUS_KEEP_TEST_HOME=1 keeps the temporary home for inspection.\n// One node:test run (run_tests_driver.mjs, in its own process group, files one at a time as before) with a per-file\n// watchdog: a file still running after NEXUS_TEST_FILE_TIMEOUT_SECS (default 300) is named with its last output, the\n// whole group is killed, and the run restarts with the remaining files so every other failure is still reported.\nimport { spawn } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst cli = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst realHome = os.homedir();\nconst home = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-test-home-\"));\n\nconst files = process.argv.length > 2\n  ? process.argv.slice(2)\n  : [\n      ...fs.readdirSync(path.join(cli, \"test\")).filter((f) => f.endsWith(\".test.ts\")).sort().map((f) => path.join(\"test\", f)),\n      path.resolve(cli, \"../eval/dataset.test.mjs\"),\n      path.resolve(cli, \"../eval/package_runtime.test.mjs\"),\n    ];\n\nconst env = {\n  ...process.env,\n  HOME: home,\n  XDG_CONFIG_HOME: path.join(home, \".config\"),\n  XDG_DATA_HOME: path.join(home, \".local\", \"share\"),\n  XDG_STATE_HOME: path.join(home, \".local\", \"state\"),\n  XDG_CACHE_HOME: path.join(home, \".cache\"),\n  NEXUS_TEST_REAL_HOME: realHome,\n};\n// This process writes the durations file. A test that starts a nested runner must not inherit the path and write over it.\ndelete env.NEXUS_TEST_DURATIONS_OUT;\n// Rust and Node toolchains installed per user keep working under the throwaway home.\nfor (const [key, dir] of [[\"CARGO_HOME\", \".cargo\"], [\"RUSTUP_HOME\", \".rustup\"]]) {\n  if (!env[key] && fs.existsSync(path.join(realHome, dir))) env[key] = path.join(realHome, dir);\n}\n\nconst timeoutSecs = Number(process.env.NEXUS_TEST_FILE_TIMEOUT_SECS) > 0 ? Number(process.env.NEXUS_TEST_FILE_TIMEOUT_SECS) : 300;\nconst driver = path.join(cli, \"scripts\", \"run_tests_driver.mjs\");\nlet current = null;\n\nfunction killGroup(child) {\n  try { process.kill(-child.pid, \"SIGKILL\"); } catch { try { child.kill(\"SIGKILL\"); } catch {} }\n}\n\nfunction cleanupHome() {\n  if (process.env.NEXUS_KEEP_TEST_HOME === \"1\") console.error(`test home kept at ${home}`);\n  else fs.rmSync(home, { recursive: true, force: true });\n}\n\nfor (const signal of [\"SIGINT\", \"SIGTERM\"]) {\n  process.on(signal, () => {\n    if (current) killGroup(current);\n    cleanupHome();\n    process.exit(1);\n  });\n}\n\nfunction runSegment(segment) {\n  return new Promise((resolve) => {\n    const child = spawn(process.execPath, [driver, ...segment], { cwd: cli, env, detached: true, stdio: [\"inherit\", \"inherit\", \"inherit\", \"pipe\"] });\n    current = child;\n    const result = { timedOut: undefined, done: undefined };\n    let buffered = \"\";\n    child.stdio[3].on(\"data\", (chunk) => {\n      buffered += chunk.toString();\n      const lines = buffered.split(\"\\n\");\n      buffered = lines.pop() ?? \"\";\n      for (const line of lines.filter(Boolean)) {\n        const message = JSON.parse(line);\n        if (message.done) result.done = message;\n        if (message.duration) {\n          const { file, secs } = message.duration;\n          durations.set(file, Math.max(durations.get(file) ?? 0, secs));\n        }\n        if (message.timeout && !result.timedOut) {\n          result.timedOut = message.timeout;\n          console.error(`\\nTEST FILE TIMEOUT after ${timeoutSecs}s: ${message.timeout}\\nlast output:\\n${message.tail.map((l) => `  | ${l}`).join(\"\\n\")}`);\n          killGroup(child);\n        }\n      }\n    });\n    child.on(\"error\", () => resolve(result));\n    child.on(\"close\", () => { killGroup(child); resolve(result); });\n  });\n}\n// One node:test run over the given files (one file at a time) with a per-file watchdog. Started by run_tests.mjs in its\n// own process group; reports to the parent on fd 3 as JSON lines: {\"timeout\":file,\"tail\":[...]} when the file under test\n// exceeds NEXUS_TEST_FILE_TIMEOUT_SECS (the parent then kills the group and restarts with the remaining files), and\n// {\"done\":true,\"tests\":n,\"fail\":n} when the run ends. Output keeps the spec reporter format, with colour on a TTY.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { run } from \"node:test\";\nimport { spec } from \"node:test/reporters\";\n\nconst files = process.argv.slice(2);\nconst cwd = process.cwd();\nconst timeoutMs = (Number(process.env.NEXUS_TEST_FILE_TIMEOUT_SECS) > 0 ? Number(process.env.NEXUS_TEST_FILE_TIMEOUT_SECS) : 300) * 1000;\nconst report = (message) => fs.writeSync(3, `${JSON.stringify(message)}\\n`);\n\nconst stream = run({ files, concurrency: 1, isolation: \"process\", execA…5711 tokens truncated…\"--allow-worktree-write\", \"--on-missed\", \"report\");\n    assert.equal(text.code, 0, text.stderr);\n    assert.match(text.stdout, /Added schedule weekly/);\n    assert.match(text.stdout, /next runs: /);\n    assert.match(text.stdout, /writes? inside that worktree only|may write inside that worktree only/);\n    assert.equal(readSchedule(paths, \"weekly\")?.policy, \"worktree-write\");\n    assert.equal(readSchedule(paths, \"weekly\")?.onMissed, \"report\");\n    assert.match(text.stderr, /no runner is running/);\n\n    const listed = JSON.parse((await world.run([\"schedule\", \"list\", \"--json\"])).stdout);\n    assert.deepEqual(listed.schedules.map((s: ScheduleRecord) => s.id), [\"nightly\", \"weekly\"]);\n    assert.deepEqual(listed.invalid, []);\n    const plain = await world.run([\"schedule\", \"list\"]);\n    assert.match(plain.stdout, /nightly\\s+enabled\\s+cron 0 3 \\* \\* 1-5 \\(UTC\\)\\s+read-only/);\n\n    const status = JSON.parse((await world.run([\"schedule\", \"status\", \"nightly\", \"--json\"])).stdout);\n    assert.equal(status.schedule.id, \"nightly\");\n    assert.equal(status.latest_job, null);\n    const statusText = await world.run([\"schedule\", \"status\", \"nightly\"]);\n    assert.match(statusText.stdout, /missed runs: 0 \\(none\\)/);\n\n    assert.equal((await world.run([\"schedule\", \"pause\", \"nightly\"])).code, 0);\n    assert.equal(readSchedule(paths, \"nightly\")?.enabled, false);\n    assert.equal((await world.run([\"schedule\", \"resume\", \"nightly\"])).code, 0);\n    assert.equal(readSchedule(paths, \"nightly\")?.enabled, true);\n\n    // A leftover pointer and missed-run receipt go with the schedule.\n    fs.writeFileSync(paths.latest(\"nightly\"), \"{}\", { mode: 0o600 });\n    fs.writeFileSync(paths.missed(\"nightly\", \"2026-11-24T00:00:00.000Z\"), \"{}\", { mode: 0o600 });\n    assert.equal((await world.run([\"schedule\", \"rm\", \"nightly\"])).code, 0);\n    assert.deepEqual(fs.readdirSync(paths.dir).filter((n) => n.startsWith(\"nightly\")), []);\n    assert.deepEqual(listSchedules(paths).schedules.map((s) => s.id), [\"weekly\"]);\n\n    const missing = await world.run([\"schedule\", \"status\", \"nightly\"]);\n    assert.equal(missing.code, 2);\n    assert.match(missing.stderr, /There is no schedule nightly/);\n  });\n});\n\ntest(\"what is not a schedule's to ask: modes, sandbox flags, a second trigger, a bad name, a duplicate, a past time\", { timeout: 240_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    for (const flags of [[\"--yes\"], [\"--mode\", \"auto\"], [\"--approve\"], [\"--sandbox\", \"none\"], [\"--sandbox-network\"], [\"--read-only\"], [\"--dry-run\"]]) {\n      const result = await world.run([...flags, \"schedule\", \"add\", \"--prompt\", \"p\", \"-w\", repo, \"--every\", \"15m\"]);\n      assert.equal(result.code, 2, `${flags.join(\" \")}: ${result.stderr}`);\n      assert.match(result.stderr, /does not apply to a background job and is refused/);\n    }\n    const auto = await add(world, repo, \"--every\", \"15m\");\n    assert.equal(auto.code, 0, auto.stderr);\n    const env = await world.run([\"schedule\", \"add\", \"--prompt\", \"p\", \"-w\", repo, \"--every\", \"15m\"], { NEXUS_APPROVAL_MODE: \"auto\" });\n    assert.equal(env.code, 2);\n    assert.match(env.stderr, /never runs in auto mode/);\n\n    const cases: Array<[string[], RegExp]> = [\n      [[], /exactly one of --cron/],\n      [[\"--cron\", \"* * * * *\", \"--every\", \"5m\"], /exactly one of --cron/],\n      [[\"--every\", \"1m\"], /an interval is from 300 seconds/],\n      [[\"--cron\", \"*/0 * * * *\"], /step of 0/],\n      [[\"--cron\", \"0 0 30 2 *\"], /never matches a date/],\n      [[\"--cron\", \"0 0 31 2 *\"], /never matches a date/],\n      [[\"--cron\", \"@daily\"], /shortcuts/],\n      [[\"--at\", \"2020-01-01T00:00:00Z\"], /not in the future/],\n      [[\"--at\", \"tomorrow\"], /not a UTC time/],\n      [[\"--every\", \"15m\", \"--name\", \"Bad Name\"], /not a schedule id/],\n      [[\"--every\", \"15m\", \"--name\", \"../escape\"], /not a schedule id/],\n      [[\"--every\", \"15m\", \"--max-runs\", \"0\"], /--max-runs must be/],\n      [[\"--every\", \"15m\", \"--on-missed\", \"run-all\"], /--on-missed must be/],\n      [[\"--every\", \"15m\", \"--verifier\", \"  \"], /--verifier needs a command/],\n      [[\"--every\", \"15m\", \"--deliverable-file\", \"../../etc/passwd\"], /.+/],\n    ];\n    for (const [flags, pattern] of cases) {\n      const result = await add(world, repo, ...flags);\n      assert.equal(result.code, 2, `${flags.join(\" \")}: ${result.stdout}${result.stderr}`);\n      assert.match(result.stderr, pattern, flags.join(\" \"));\n    }\n    assert.equal(listSchedules(schedulePaths(world.paths)).schedules.length, 1, \"only the one valid add left a schedule\");\n\n    assert.equal((await add(world, repo, \"--name\", \"same\", \"--every\", \"15m\")).code, 0);\n    const dup = await add(world, repo, \"--name\", \"same\", \"--every\", \"15m\");\n    assert.equal(dup.code, 2);\n    assert.match(dup.stderr, /already a schedule same/);\n  });\n});\n\ntest(\"the 65th schedule is refused\", { timeout: 120_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    const paths = schedulePaths(world.paths);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a220e5-c285-7e72-9bb5-c6a32a48db70","create_time":1795848399.2344651}},"metadata":{"history_sequence":138694,"sampled_through_sequence":138691,"client_authored":false,"fallback_token_limit_override":12000}}
