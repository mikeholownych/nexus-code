oad: { ok: true, output: \"contents héllo ✓\" } },\n  { type: \"session_end\", timestamp: 4, payload: { summary: \"done\", success: true } },\n];\nconst text = (value: string): Uint8Array => Buffer.from(value, \"utf8\");\nconst json = (value: unknown): Uint8Array => text(`${JSON.stringify(value, null, 2)}\\n`);\n\n/** One artefact of every role the first slices write, two of them chained logs. The same bytes on every call. */\nexport function fixtureInput(): AuditBundleInput {\n  return {\n    subject: { kind: \"task\", task_id: \"task-1\", session_id: null, store: \"tasks\", workspace_path: \"/work/repo\", workspace_sha256: sha256(\"/work/repo\"), status: \"completed\", updated_at: \"2026-11-22T09:00:00.000Z\", at_rest: true },\n    nexus: { version: \"1.3.0\", commit: \"0123abc\", dirty: false },\n    redaction: \"standard\",\n    artefacts: [\n      { path: \"session/export.json\", role: \"session_export\", bytes: json({ format: \"nexus-session-export/2\", messages: [{ role: \"user\", content: \"do the thing\" }] }) },\n      { path: \"session/export.md\", role: \"session_export_markdown\", bytes: text(\"# Session\\n\\ndo the thing\\n\") },\n      { path: \"receipts/validation-receipts.json\", role: \"validation_receipts\", bytes: json([{ id: \"r1\", command: \"npm test\", passed: true }]) },\n      { path: \"receipts/last-turn.json\", role: \"last_turn\", bytes: json({ execution: \"COMPLETED\", outcome: \"VERIFIED\" }) },\n      { path: \"verification/attempts.json\", role: \"verification_attempts\", bytes: json([{ attempt: 1, verdict: \"pass\" }]) },\n      { path: ATTEMPTS_PATH, role: \"verification_config_attempts\", bytes: text(`${chainedLines([{ path: \"package.json\", decision: \"blocked\" }, { path: \"vitest.config.ts\", decision: \"approved\" }]).join(\"\\n\")}\\n`) },\n      { path: \"evidence/provenance.json\", role: \"evidence_provenance\", bytes: json({ \"REQ-1\": [\"test:a\"] }) },\n      { path: \"evidence/findings.json\", role: \"evidence_findings\", bytes: json([]) },\n      { path: \"evidence/diffs/op-1.diff\", role: \"diff\", bytes: text(\"@@ -1 +1 @@\\n-a\\n+b\\n\") },\n      { path: FLIGHT_PATH, role: \"flight_log\", bytes: text(`${chainedLines(FLIGHT_EVENTS).join(\"\\n\")}\\n`) },\n    ],\n    chainedLogs: [\n      { path: FLIGHT_PATH, kind: \"flight\", closed: true, selection: \"explicit\" },\n      { path: ATTEMPTS_PATH, kind: \"verification_config_attempts\" },\n    ],\n    omitted: [{ artefact: \"traces\", reason: \"not requested\" }],\n  };\n}\n\nexport const FIXED_NOW = (): Date => new Date(\"2026-11-22T10:00:00.000Z\");\nexport const FIXED_ID = \"ab\".repeat(16);\n\nexport function assertManifestValid(manifest: unknown): void {\n  assert.deepEqual(validate(manifest, AUDIT_BUNDLE_SCHEMA, AUDIT_BUNDLE_SCHEMA), [], \"the manifest does not validate against docs/protocol/audit-bundle schema\");\n}\n\n/** Writes `input` as a bundle named `bundle` in a fresh directory, and checks the manifest written against the schema. */\nexport function writeFixture(input: AuditBundleInput = fixtureInput()): WrittenAuditBundle & { parent: string } {\n  const parent = tempDir();\n  const written = writeAuditBundle(input, { out: path.join(parent, \"bundle\"), now: FIXED_NOW, bundleId: FIXED_ID, durable: false });\n  assertManifestValid(written.manifest);\n  assertManifestValid(JSON.parse(fs.readFileSync(path.join(written.dir, \"manifest.json\"), \"utf8\")));\n  return { ...written, parent };\n}\n\nexport interface Checked {\n  document: AuditVerifyOutput;\n  /** The document as a result; an assertion fails when it is an error document. */\n  result: AuditVerifyResult;\n  exit: AuditExitName;\n  code: number;\n  text: string;\n  kinds: string[];\n}\n\n/** Verifies a bundle; every document produced goes through the published schema and agrees with its exit-code row. */\nexport function check(dir: string, options?: VerifyAuditBundleOptions): Checked {\n  const { document, exit } = verifyAuditBundle(dir, options);\n  assert.deepEqual(validate(document, AUDIT_VERIFY_SCHEMA, AUDIT_VERIFY_SCHEMA), [], \"the result does not validate against docs/protocol/audit-verify-result schema\");\n  assert.equal(document.exitCode, auditExitCode(exit));\n  assert.equal(Object.keys(document)[0], \"schema_version\");\n  if (\"result\" in document) assert.equal(document.result, exit);\n  return {\n    document,\n    get result(): AuditVerifyResult {\n      assert.ok(\"result\" in document, `expected a result, got the error document: ${JSON.stringify(document)}`);\n      return document;\n    },\n    exit,\n    code: document.exitCode,\n    text: renderAuditVerifyText(document),\n    kinds: \"result\" in document ? document.findings.map((finding) => finding.kind) : [],\n  };\n}\n\nexport const manifestFile = (dir: string): string => path.join(dir, \"manifest.json\");\nexport const readManifestText = (dir: string): string => fs.readFileSync(manifestFile(dir), \"utf8\");\nexport const readManifest = (dir: string): AuditManifest => JSON.parse(readManifestText(dir));\n\n/**\n * What someone rewriting a bundle does: recompute every file-entry link, the head and the root for the manifest as it\n * now is, and write it in canonical form. Written apart from the library's own writer on purpose.\n */\nexport function reseal(dir: string, manifest: Record<string, any>): string {\n  let previous: ChainLink | undefined;\n  manifest.files = manifest.files.map((entry: Record<string, unknown>) => {\n    const { chain: _chain, ...content } = entry;\n    const linked = linkRecord(content, previous);\n    previous = linked.chain;\n    return linked;\n  });\n  manifest.files_head = previous ? { seq: previous.seq, hash: previous.hash } : null;\n  delete manifest.root_sha256;\n  manifest.root_sha256 = sha256(canonicalJson(manifest));\n  const bytes = `${canonicalJson(manifest)}\\n`;\n  fs.writeFileSync(manifestFile(dir), bytes);\n  return sha256(bytes);\n}\n\n/** Replaces a payload file and re-seals the manifest to match: the rewrite an unsigned bundle cannot reveal. */\nexport function rewritePayload(dir: string, file: string, bytes: Uint8Array | string): string {\n  const data = typeof bytes === \"string\" ? Buffer.from(bytes) : bytes;\n  fs.writeFileSync(path.join(dir, file), data);\n  const manifest = readManifest(dir) as Record<string, any>;\n  const entry = manifest.files.find((candidate: { path: string }) => candidate.path === file);\n  entry.bytes = data.length;\n  entry.sha256 = sha256(data);\n  return reseal(dir, manifest);\n}\n\n/** Flips one bit of the byte in the middle of a file. */\nexport function flipByte(file: string): void {\n  const bytes = fs.readFileSync(file);\n  bytes[Math.floor(bytes.length / 2)] ^= 0x01;\n  fs.writeFileSync(file, bytes);\n}\n    assert.equal((await add(world, repo, \"--name\", \"same\", \"--every\", \"15m\")).code, 0);\n    const dup = await add(world, repo, \"--name\", \"same\", \"--every\", \"15m\");\n    assert.equal(dup.code, 2);\n    assert.match(dup.stderr, /already a schedule same/);\n  });\n});\n\ntest(\"the 65th schedule is refused\", { timeout: 120_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    const paths = schedulePaths(world.paths);\n    fs.mkdirSync(world.paths.root, { recursive: true, mode: 0o700 });\n    fs.mkdirSync(paths.dir, { recursive: true, mode: 0o700 });\n    for (let i = 0; i < MAX_SCHEDULES; i++) {\n      writeSchedule(paths, {\n        format: \"nexus-schedule\", version: 1, id: `s${String(i).padStart(2, \"0\")}`, createdAt: \"2026-11-24T00:00:00.000Z\", enabled: false, workspace: repo, trigger: { kind: \"every\", seconds: 3600 },\n        task: { prompt: \"p\" }, policy: \"read-only\", verifier: null, deliverables: [], provider: {}, budgets: { ...DEFAULT_JOB_BUDGETS }, remainingRuns: null, onMissed: \"report\", state: newScheduleState(null),\n      });\n    }\n    const result = await add(world, repo, \"--name\", \"one-too-many\", \"--every\", \"15m\");\n    assert.equal(result.code, 2, result.stderr);\n    assert.match(result.stderr, /already 64 schedules/);\n    assert.equal(readSchedule(paths, \"one-too-many\"), undefined);\n  });\n});\n\ntest(\"a schedule file that was edited by hand is shown as invalid and is not used by the commands that would change it\", { timeout: 120_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    assert.equal((await add(world, repo, \"--name\", \"tampered\", \"--every\", \"15m\")).code, 0);\n    const file = schedulePaths(world.paths).record(\"tampered\");\n    fs.writeFileSync(file, fs.readFileSync(file, \"utf8\").replace('\"read-only\"', '\"full-access\"'), { mode: 0o600 });\n    const listed = JSON.parse((await world.run([\"schedule\", \"list\", \"--json\"])).stdout);\n    assert.equal(listed.schedules.length, 0);\n    assert.match(listed.invalid[0].error, /policy must be one of read-only, worktree-write/);\n    assert.match((await world.run([\"schedule\", \"list\"])).stderr, /Invalid schedule tampered \\(it will not run\\)/);\n    for (const verb of [\"pause\", \"resume\", \"status\", \"run-now\"]) {\n      const result = await world.run([\"schedule\", verb, \"tampered\"]);\n      assert.equal(result.code, 2, `${verb}: ${result.stdout}${result.stderr}`);\n      assert.match(result.stderr, /policy must be one of/, verb);\n    }\n  });\n});\n\ntest(\"run-now needs a runner and a trusted workspace, and refuses while the schedule's previous job runs\", { timeout: 120_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    assert.equal((await add(world, repo, \"--name\", \"n\", \"--every\", \"15m\")).code, 0);\n    const none = await world.run([\"schedule\", \"run-now\", \"n\"]);\n    assert.equal(none.code, 2);\n    assert.match(none.stderr, /no runner is running/);\n    assert.equal((await world.run([\"trust\", \"--remove\", repo])).code, 0);\n    const untrusted = await world.run([\"schedule\", \"run-now\", \"n\"]);\n    assert.equal(untrusted.code, 2);\n    assert.match(untrusted.stderr, /not a trusted workspace/);\n  });\n});\n\ntest(\"two run-now at once start one job: the running-job check and the runner's acceptance happen under the schedule lock\", { timeout: 240_000 }, async () => {\n  const world = runnerWorld();\n  const repo = fs.realpathSync(makeRepo({ \"README.md\": \"hello\\n\" }));\n  const gw = await stalledGateway();\n  try {\n    assert.equal((await world.run([\"trust\", repo])).code, 0);\n    assert.equal((await add(world, repo, \"--name\", \"n\", \"--every\", \"15m\", \"-e\", gw.url, \"-m\", \"m\")).code, 0);\n    await world.startRunner();\n    const runs = await Promise.all([world.run([\"schedule\", \"run-now\", \"n\"]), world.run([\"schedule\", \"run-now\", \"n\"])]);\n    const ok = runs.filter((run) => run.code === 0);\n    const refused = runs.filter((run) => run.code === 2);\n    assert.equal(ok.length, 1, JSON.stringify(runs));\n    assert.equal(refused.length, 1, JSON.stringify(runs));\n    assert.match(refused[0].stderr, /still has a running job/);\n    assert.equal(listJobs(world.paths).jobs.filter((job) => job.origin.kind === \"schedule\" && job.origin.scheduleId === \"n\").length, 1);\n  } finally {\n    await world.cleanup();\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n  }\n});\n\ntest(\"add warns that a read-only run does not run its verifier\", { timeout: 120_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    const result = await add(world, repo, \"--name\", \"w\", \"--every\", \"15m\", \"--verifier\", \"node --test\");\n    assert.equal(result.code, 0, result.stderr);\n    assert.match(result.stderr, /a read-only run does not run its verifier/);\n    const writable = await add(world, repo, \"--name\", \"x\", \"--every\", \"15m\", \"--verifier\", \"node --test\", \"--allow-worktree-write\");\n    assert.doesNotMatch(writable.stderr, /does not run its verifier/);\n    const bad = await add(world, repo, \"--name\", \"y\", \"--every\", \"15m\", \"--verifier\", \"rm -rf /\", \"--allow-worktree-write\");\n    assert.equal(bad.code, 2);\n    assert.match(bad.stderr, /refused by the security policy/);\n}\n// A durable state-restore intent must be replayed before environment/config\n// loading or any normal client is admitted. The recovery command takes the\n// exclusive lifetime lease; ordinary clients take their shared lease below.\nif (invocationKind === \"restore\" || (invocationKind === \"client\" && !startupReadOnly)) {\n  try {\n    const { hasPendingStateRestore, recoverPendingStateRestore } = await import(\"./core/state_restore.js\");\n    const home = process.env.HOME || os.homedir();\n    if (hasPendingStateRestore(home) && !recoverPendingStateRestore(home)) {\n      throw new Error(\"Pending state restore could not be recovered; no state was admitted\");\n    }\n  } catch (error: any) {\n    console.error(`[maintenance] ${formatDiagnosticForOutput(error?.message ?? \"Nexus restore recovery failed closed\")}`);\n    process.exit(2);\n  }\n}\nif (invocationKind === \"client\") {\n  try {\n    const lease = acquireClientLease(process.env.HOME || os.homedir());\n    process.once(\"exit\", () => releaseClientLease(lease));\n  } catch (error: any) {\n    console.error(`[maintenance] ${formatDiagnosticForOutput(error)}`);\n    process.exit(2);\n  }\n  try {\n    loadEnvironment();\n  } catch (error: any) {\n    console.error(`[config] ${formatDiagnosticForOutput(error)}`);\n    process.exit(2);\n  }\n  operatorConfigStartupError = operatorConfigLoadError();\n}\n// Release the HOME-scoped client lease before deleting the temporary HOME.\nif (restoreEvalStartupHome) process.once(\"exit\", restoreEvalStartupHome);\n\nasync function recoverInterruptedUpgrade(topLevelCommand: string): Promise<void> {\n","exit_code":0,"duration":{"secs":1,"nanos":7699475}},"started_at_ms":1795846108693,"completed_at_ms":1795846109702}}
