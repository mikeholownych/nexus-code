{"timestamp":"2026-11-28T05:30:24.269Z","ordinal":313169,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a2208e-347b-7f62-bb1f-c24475a2832b","item":{"type":"CommandExecution","id":"exec-f98c478f-be7b-45d1-a92d-812b00808a93","process_id":"45490","command":["/usr/bin/zsh","-lc","git diff -- cli/src/core/client_lease.ts cli/test/sidecar.test.ts docs/CLIENT_GUIDE.md docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md && git diff --no-index /dev/null cli/test/client_lease.test.ts || true"],"cwd":"file:///home/mike/nexus-wt/p10-04-active-client-admission-continued","parsed_cmd":[{"type":"unknown","cmd":"git diff -- cli/src/core/client_lease.ts cli/test/sidecar.test.ts docs/CLIENT_GUIDE.md docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md && git diff --no-index /dev/null cli/test/client_lease.test.ts || true"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"diff --git a/cli/src/core/client_lease.ts b/cli/src/core/client_lease.ts\nindex 25d4ccade..b4c88cc70 100644\n--- a/cli/src/core/client_lease.ts\n+++ b/cli/src/core/client_lease.ts\n@@ -3,8 +3,29 @@ import * as fs from \"node:fs\";\n import * as path from \"node:path\";\n import { createHash } from \"node:crypto\";\n import { acquireFileGuard, releaseFileGuard, type FileGuard } from \"./file_guard.js\";\n+import { MAX_SHARED_RESOURCE_CAPACITY, SharedResourceAdmission, type ResourceSlotLease } from \"./shared_resource_admission.js\";\n \n const heartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\n+const activeClientSlots = new WeakMap<FileGuard, ResourceSlotLease>();\n+const activeClientHeartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\n+export const DEFAULT_MAX_ACTIVE_CLIENTS = 16;\n+\n+export class ClientActiveLimitError extends Error {\n+  constructor(readonly limit: number) {\n+    super(`Nexus active client limit (${limit}) reached; close another client or set NEXUS_MAX_ACTIVE_CLIENTS to a value from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n+    this.name = \"ClientActiveLimitError\";\n+  }\n+}\n+\n+function maxActiveClients(options: { maxActiveClients?: number }): number {\n+  const raw = process.env.NEXUS_MAX_ACTIVE_CLIENTS;\n+  const value = options.maxActiveClients ?? (raw === undefined ? DEFAULT_MAX_ACTIVE_CLIENTS : Number(raw));\n+  if ((raw !== undefined && options.maxActiveClients === undefined && !/^\\d+$/.test(raw)) ||\n+      !Number.isSafeInteger(value) || value < 1 || value > MAX_SHARED_RESOURCE_CAPACITY) {\n+    throw new Error(`Invalid NEXUS_MAX_ACTIVE_CLIENTS='${raw ?? value}': expected an integer from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n+  }\n+  return value;\n+}\n \n /** Only unambiguous metadata/recovery invocations may avoid a normal client lifetime lease. */\n export function clientInvocationKind(args: readonly string[]): \"metadata\" | \"restore\" | \"client\" {\n@@ -69,14 +90,44 @@ export function clientLeasePath(homeDir: string): string {\n }\n \n /** Retain the returned descriptor until the client has finished every use of loaded configuration/state. */\n-export function acquireClientLease(homeDir: string, options: { exclusive?: boolean; waitMs?: number } = {}): FileGuard {\n+export function acquireClientLease(\n+  homeDir: string,\n+  options: { exclusive?: boolean; waitMs?: number; maxActiveClients?: number } = {},\n+): FileGuard {\n   const exclusive = options.exclusive === true;\n-  const lease = acquireFileGuard(clientLeasePath(homeDir), {\n+  const activeLimit = exclusive ? undefined : maxActiveClients(options);\n+  const leasePath = clientLeasePath(homeDir);\n+  const lease = acquireFileGuard(leasePath, {\n     mode: exclusive ? \"exclusive\" : \"shared\",\n     waitMs: options.waitMs ?? 0,\n     label: \"Nexus client lease\",\n   });\n   if (!lease) throw new ClientLeaseBusyError(exclusive);\n+  if (activeLimit !== undefined) {\n+    try {\n+      const admission = new SharedResourceAdmission(path.join(path.dirname(leasePath), \"resource-admission\"), { guardWaitMs: 0 });\n+      const slot = admission.acquireNamed(\"active-client-processes\", activeLimit, \"client process\");\n+      if (!slot) {\n+        releaseFileGuard(lease);\n+        throw new ClientActiveLimitError(activeLimit);\n+      }\n+      if (slot.inheritedFd === undefined) {\n+        slot.release();\n+        throw new Error(\"Nexus active client slot does not expose its kernel lease descriptor\");\n+      }\n+      const slotFd = slot.inheritedFd;\n+      const slotHeartbeat = setInterval(() => {\n+        try { const now = new Date(); fs.futimesSync(slotFd, now, now); }\n+        catch { /* Kernel ownership remains until the descriptor is closed. */ }\n+      }, 60_000);\n+      slotHeartbeat.unref();\n+      activeClientSlots.set(lease, slot);\n+      activeClientHeartbeatTimers.set(lease, slotHeartbeat);\n+    } catch (error) {\n+      releaseFileGuard(lease);\n+      throw error;\n+    }\n+  }\n   // An active long-lived client must not age out of the operating system's\n   // temporary-file policy. This timer never keeps a finished CLI process alive.\n   const heartbeat = setInterval(() => {\n@@ -93,5 +144,16 @@ export function releaseClientLease(lease: FileGuard | null): void {\n   if (!lease) return;\n   const heartbeat = heartbeatTimers.get(lease);\n   if (heartbeat) { clearInterval(heartbeat); heartbeatTimers.delete(lease); }\n+  const activeSlot = activeClientSlots.get(lease);\n+  if (activeSlot) {\n+    const slotHeartbeat = activeClientHeartbeatTimers.get(lease);\n+    if (slotHeartbeat) { clearInterval(slotHeartbeat); activeClientHeartbeatTimers.delete(lease); }\n+    // Close the lifetime guard first so an exclusive maintenance invocation\n+    // cannot overlap a normal client while the capacity slot is being freed.\n+    releaseFileGuard(lease);\n+    activeSlot.release();\n+    activeClientSlots.delete(lease);\n+    return;\n+  }\n   releaseFileGuard(lease);\n }\ndiff --git a/cli/test/sidecar.test.ts b/cli/test/sidecar.test.ts\nindex e70cdfff6..39a20d121 100644\n--- a/cli/test/sidecar.test.ts\n+++ b/cli/test/sidecar.test.ts\n@@ -1126,10 +1126,17 @@ describe(\"SidecarServer: evidence and receipts\", () => {\n const cliRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n const sidecarSrc = path.join(cliRoot, \"src\", \"sidecar.ts\");\n \n-function spawnSidecar(gwUrl: string, repo: string, home: string, entry: string = sidecarSrc, args: string[] = [\"-w\", repo, \"-e\", gwUrl, \"-m\", \"m\"]) {\n+function spawnSidecar(\n+  gwUrl: string,\n+  repo: string,\n+  home: string,\n+  entry: string = sidecarSrc,\n+  args: string[] = [\"-w\", repo, \"-e\", gwUrl, \"-m\", \"m\"],\n+  extraEnv: NodeJS.ProcessEnv = {},\n+) {\n   const child = spawn(process.execPath, [\"--import\", \"tsx\", entry, ...args], {\n     cwd: cliRoot,\n-    env: { ...process.env, HOME: home, NEXUS_DEBUG: \"0\" },\n+    env: { ...process.env, HOME: home, NEXUS_DEBUG: \"0\", ...extraEnv },\n   });\n   let stdout = \"\";\n   let stderr = \"\";\n@@ -1163,6 +1170,28 @@ describe(\"sidecar process\", () => {\n     }\n   });\n \n+  test(\"rejects an extra same-home sidecar before it starts when the active client cap is reached\", { skip: process.platform !== \"linux\" }, async () => {\n+    const gw = await startGateway(readOnlyTurn);\n+    const repo = makeRepo();\n+    const home = makeHome();\n+    const env = { NEXUS_MAX_ACTIVE_CLIENTS: \"1\" };\n+    const first = spawnSidecar(gw.url, repo, home, sidecarSrc, [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\"], env);\n+    try {\n+      await waitUntil(() => first.lines().some((line) => line.includes('\"type\":\"hello\"')), 20000);\n+      const second = spawnSidecar(gw.url, repo, home, sidecarSrc, [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\"], env);\n+      assert.equal(await second.exited, 1, second.stderr());\n+      assert.match(second.stderr(), /active client limit \\(1\\) reached/i);\n+      assert.equal(second.lines().some((line) => line.includes('\"type\":\"hello\"')), false);\n+      first.child.stdin.write(JSON.stringify({ v: 1, type: \"shutdown\" }) + \"\\n\");\n+      assert.equal(await first.exited, 0, first.stderr());\n+    } finally {\n+      first.child.kill(\"SIGKILL\");\n+      await gw.close();\n+      fs.rmSync(repo, { recursive: true, force: true });\n+      fs.rmSync(home, { recursive: true, force: true });\n+    }\n+  });\n+\n   test(\"explicit help stays read-only when a restore is pending\", async () => {\n     const gw = await startGateway(readOnlyTurn);\n     const repo = makeRepo();\ndiff --git a/docs/CLIENT_GUIDE.md b/docs/CLIENT_GUIDE.md\nindex 39f09f3d6..2c8d22f42 100644\n--- a/docs/CLIENT_GUIDE.md\n+++ b/docs/CLIENT_GUIDE.md\n@@ -31,6 +31,15 @@ Provider disclosure is explicit for cloud destinations. Local inference keeps ta\n \n Saved sessions and task state live under `~/.nexus/`. Use `/sessions`, `/resume [id]`, and `/export [md|json]` to inspect, resume, or export a session. Exports are written into the current workspace; inspect and protect them as source data. `/compact` summarizes older context to make room, while durable findings and the active plan are retained where supported. `/doctor` checks the current runtime; `nexus doctor --deep` performs a minimal inference probe and can incur model cost.\n \n+On Linux, Nexus admits up to 16 concurrent CLI client processes for the same OS user, across its home directories. To set a different limit, export `NEXUS_MAX_ACTIVE_CLIENTS` in the launching shell or service environment before starting Nexus; accepted values are 1 through 64. For example:\n+\n+```sh\n+export NEXUS_MAX_ACTIVE_CLIENTS=8\n+nexus\n+```\n+\n+The setting is read before project `.env` files load, so it must be present in the parent environment. This limit counts cooperating Nexus client processes on one Linux host; it does not count sessions hosted inside a process or limit CPU and memory use.\n+\n An interrupted or limited run is not a successful result. Read the final execution/outcome fields, run the project's verifier, and resume explicitly when needed. Recovery is bounded by saved session state and the provider's availability; it cannot reconstruct output the provider never returned.\n \n ## Troubleshooting and limits\ndiff --git a/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md b/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md\nindex 7d3dfa777..0305b7706 100644\n--- a/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md\n+++ b/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md\n@@ -138,7 +138,7 @@ Reuse `ContinuationBudget`, `ExecutionTracker`, `ProviderRecoveryController`, `R\n \n **Priority:** P1 · **Complexity:** M/L · **Dependencies:** WP-P10-02 for shared task budgets; existing operation-local scheduling is already implemented.\n \n-**Gap/evidence:** The earlier claim that `Promise.all` makes operation scheduling unbounded was inaccurate. `ConvergenceScheduler.assign` bounds in-flight units by `effectiveConcurrency`, resource slots, and operation-local CPU/memory reservations (`cli/src/core/scheduler.ts:267-307`); parallel execution defaults to one and requires explicit per-unit requests and a per-operation budget (`cli/src/core/operation_schema.ts:101-119`). `OperationRunner.executeBatch` uses `Promise.all` only for the already-admitted due set (`cli/src/core/operation_runner.ts:276-299`). PR #830 added same-host cross-operation slots for declared inference resources; PR #831 added same-home LSP process slots. Remaining gaps are aggregate CPU/memory consumption, product-wide session/operation count, write-time disk limits, provider request/token/cost totals across separate processes, and cleanup/recovery accounting outside those lease boundaries. Those current gaps are not evidence that per-operation scheduling is unbounded, and no OS-level host CPU/memory ceiling is claimed.\n+**Gap/evidence:** The earlier claim that `Promise.all` makes operation scheduling unbounded was inaccurate. `ConvergenceScheduler.assign` bounds in-flight units by `effectiveConcurrency`, resource slots, and operation-local CPU/memory reservations (`cli/src/core/scheduler.ts:267-307`); parallel execution defaults to one and requires explicit per-unit requests and a per-operation budget (`cli/src/core/operation_schema.ts:101-119`). `OperationRunner.executeBatch` uses `Promise.all` only for the already-admitted due set (`cli/src/core/operation_runner.ts:276-299`). PR #830 added same-host cross-operation slots for declared inference resources; PR #831 added same-home LSP process slots; the active-client slice below bounds ordinary Nexus client processes per OS user. Remaining gaps are aggregate CPU/memory consumption, session counts hosted inside one client process, write-time disk limits outside session-history archives, provider request/token/cost totals across separate processes, and cleanup/recovery accounting outside the existing lease boundaries. Those current gaps are not evidence that per-operation scheduling is unbounded, and no OS-level host CPU/memory ceiling is claimed.\n \n **Follow-up evidence (2026-11-26, current release):** Cross-operation inference-resource slots and same-home LSP slots have since been implemented in `SharedResourceAdmission` (PRs #830 and #831; see `docs/assurance/WP-P10-04_RESOURCE_ADMISSION_BASELINE.md`). A separate process-boundary probe on release commit `5061a3e83ce6daf34f34785bd3753f11604ba77d` confirms that `UsageLedger` provider request/token/cost caps remain process-local: two fresh Node 24.11.1 processes sharing one temporary `HOME` and workspace each admitted under `NEXUS_CLOUD_MAX_REQUESTS=1`, then wrote two receipts to the shared workspace file. No live inference was run. This is a confirmed gap only if these limits are expected to aggregate across processes; their reset/window semantics are not defined, so do not turn them into persistent global quotas without an explicit accounting epoch. Durable operation inference counters are the existing operation-scoped control and must not be duplicated here.\n \n@@ -154,6 +154,8 @@ Reuse `ContinuationBudget`, `ExecutionTracker`, `ProviderRecoveryController`, `R\n \n **Progress (2026-11-27, merged PR #919):** Session history archive writes enforce an aggregate cap equal to the existing 2 GiB retained-state ceiling. `SessionManager.assertSessionArchiveCapacity` scans archive files under the existing state-store guard, rejects unreadable/non-regular entries and scans above 100,000 entries, and refuses a write before archive append or fork creation if it would cross the cap. It preserves existing archives and does not add another cleanup or admission framework. The new `session_archive_bounds.test.ts` covers aggregate accounting across sessions, byte preservation on refusal, fork refusal before state creation, inability to raise the ceiling through options, and empty append behavior at a full quota. With the worktree-local Rust core built, `session_archive_bounds.test.ts`, `session_fork.test.ts`, and `compaction_continuity.test.ts` passed **43/43** on Node 24.11.1 (exit 0); process-death recovery cases and the existing archive-write failure case were included. After the final empty-append guard, the current archive and fork suites passed **10/10**, `npm --prefix cli run build` passed, and `git diff --check` passed. PR #919 merged at `2026-11-27T20:00:55Z` as `a944a4eac448fdd1b08f1adfdca5be5696376ad2`. Required PR-head CI run `46059219684` and CodeQL run `46059219707` passed at exact PR head `d1778581428312574f24057e5b2741e6d3aae802`. Post-merge CI run `46060674463` passed both Node test gates, all eight shards, Linux packaging, and diff coverage; CodeQL run `46060674335` also passed on the exact merge commit. Entire Gates failed on the PR head but is advisory and excluded from required merge gates by project policy. Scope is limited to `*.history.jsonl` archives written by participating current-version Nexus processes; this is not a general disk quota and does not cap other state, external writers, or older running versions. **WP-P10-04 remains partially open** for the broader CPU/memory, session-count, provider-accounting, and cleanup/recovery gaps above.\n \n+**Progress (2026-11-28, active client admission):** The normal CLI and sidecar client lifecycle now reserves one named slot through the existing `SharedResourceAdmission` before using state. The limit is 16 concurrent client processes per OS user on one host by default; the parent process may set `NEXUS_MAX_ACTIVE_CLIENTS` from 1 to 64. Since admission happens before project `.env` loading, this setting must be exported by the launching environment. The kernel releases the slot on process exit; an unref'd descriptor heartbeat keeps a live slot from aging out of `/tmp`. Exclusive state restore uses the existing exclusive client lease and does not consume an active-client slot. Five focused cross-process lease tests passed, including aggregate counting across separate homes, and a sidecar integration test verified that a second client exits before announcing a session at a limit of one. `npm run build` and `git diff --check` pass. This limits cooperating Nexus client processes on one Linux host, not ACP sessions within one process or unrelated programs. It does not enforce CPU/memory quotas. **WP-P10-04 remains partially open** for aggregate CPU/memory, in-process session counts, other disk state, cross-process provider accounting, and cleanup/recovery outside established lease boundaries.\n+\n ## WP-P10-05 — Compiler/static-analysis gate and hotspot metrics\n \n **Priority:** P2 · **Complexity:** S/M · **Dependencies:** none; independent protection of CI remains unavailable under WP-P10-01.\ndiff --git a/cli/test/client_lease.test.ts b/cli/test/client_lease.test.ts\nnew file mode 100644\nindex 000000000..ba300db0b\n--- /dev/null\n+++ b/cli/test/client_lease.test.ts\n@@ -0,0 +1,102 @@\n+import { after, describe, it } from \"node:test\";\n+import assert from \"node:assert/strict\";\n+import * as fs from \"node:fs\";\n+import * as path from \"node:path\";\n+import { spawnSync } from \"node:child_process\";\n+import { fileURLToPath } from \"node:url\";\n+import { acquireClientLease, releaseClientLease } from \"../src/core/client_lease.js\";\n+\n+const cliRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n+const testRoot = fs.mkdtempSync(path.join(\"/var/tmp\", \"nexus-client-admission-\"));\n+\n+function home(name: string): string {\n+  const result = path.join(testRoot, name);\n+  fs.mkdirSync(result, { recursive: true, mode: 0o700 });\n+  return result;\n+}\n+\n+function probe(targetHome: string, maxActiveClients: number): ReturnType<typeof spawnSync> {\n+  const source = `\n+    import { acquireClientLease } from \"./src/core/client_lease.ts\";\n+    try {\n+      acquireClientLease(process.env.HOME, { maxActiveClients: ${maxActiveClients} });\n+      console.log(\"admitted\");\n+    } catch (error) {\n+      console.log(error?.name ?? \"unknown-error\");\n+      if (error?.name !== \"ClientActiveLimitError\" && error?.name !== \"ResourceAdmissionConflictError\") process.exitCode = 2;\n+    }\n+  `;\n+  return spawnSync(process.execPath, [\"--import\", \"tsx\", \"--input-type=module\", \"-e\", source], {\n+    cwd: cliRoot,\n+    env: { ...process.env, HOME: targetHome, XDG_CONFIG_HOME: path.join(targetHome, \".config\") },\n+    encoding: \"utf8\",\n+    timeout: 15_000,\n+  });\n+}\n+\n+after(() => fs.rmSync(testRoot, { recursive: true, force: true }));\n+\n+describe(\"cross-process client admission\", { skip: process.platform !== \"linux\" || typeof process.getuid !== \"function\" }, () => {\n+  it(\"denies another same-home client at the configured limit and reopens admission on release\", () => {\n+    const targetHome = home(\"same-home\");\n+    const lease = acquireClientLease(targetHome, { maxActiveClients: 1 });\n+    try {\n+      const denied = probe(targetHome, 1);\n+      assert.equal(denied.status, 0, denied.stderr);\n+      assert.equal(denied.stdout.trim(), \"ClientActiveLimitError\");\n+    } finally {\n+      releaseClientLease(lease);\n+    }\n+\n+    const admitted = probe(targetHome, 1);\n+    assert.equal(admitted.status, 0, admitted.stderr);\n+    assert.equal(admitted.stdout.trim(), \"admitted\");\n+  });\n+\n+  it(\"releases an active-client slot when its owning process exits\", () => {\n+    const targetHome = home(\"process-exit\");\n+    const first = probe(targetHome, 1);\n+    assert.equal(first.status, 0, first.stderr);\n+    assert.equal(first.stdout.trim(), \"admitted\");\n+\n+    const afterExit = probe(targetHome, 1);\n+    assert.equal(afterExit.status, 0, afterExit.stderr);\n+    assert.equal(afterExit.stdout.trim(), \"admitted\");\n+  });\n+\n+  it(\"counts active client processes across separate homes for the same OS user\", () => {\n+    const firstHome = home(\"home-one\");\n+    const secondHome = home(\"home-two\");\n+    const first = acquireClientLease(firstHome, { maxActiveClients: 1 });\n+    try {\n+      assert.throws(\n+        () => acquireClientLease(secondHome, { maxActiveClients: 1 }),\n+        /active client limit \\(1\\) reached/,\n+      );\n+    } finally {\n+      releaseClientLease(first);\n+    }\n+  });\n+\n+  it(\"fails closed when active processes disagree on the shared capacity\", () => {\n+    const targetHome = home(\"capacity-mismatch\");\n+    const lease = acquireClientLease(targetHome, { maxActiveClients: 2 });\n+    try {\n+      const mismatched = probe(targetHome, 1);\n+      assert.equal(mismatched.status, 0, mismatched.stderr);\n+      assert.equal(mismatched.stdout.trim(), \"ResourceAdmissionConflictError\");\n+    } finally {\n+      releaseClientLease(lease);\n+    }\n+  });\n+\n+  it(\"rejects a zero client limit before acquiring a home lease\", () => {\n+    const targetHome = home(\"invalid-limit\");\n+    assert.throws(\n+      () => acquireClientLease(targetHome, { maxActiveClients: 0 }),\n+      /expected an integer from 1 to 64/,\n+    );\n+    const valid = acquireClientLease(targetHome, { maxActiveClients: 1 });\n+    releaseClientLease(valid);\n+  });\n+});\n","exit_code":0,"duration":{"secs":0,"nanos":752091213}},"started_at_ms":1795843823516,"completed_at_ms":1795843824268}}
{"timestamp":"2026-11-28T05:30:24.328Z","ordinal":313170,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a220a2-1ac8-7573-a405-ae0b097ae6ab","call_id":"call_c897f4d0cbe442349f63a160bdf6f741","output":[{"type":"input_text","text":"Script completed\nWall time 1.0 seconds\nOutput:\n"},{"type":"input_text","text":"diff --git a/cli/src/core/client_lease.ts b/cli/src/core/client_lease.ts\nindex 25d4ccade..b4c88cc70 100644\n--- a/cli/src/core/client_lease.ts\n+++ b/cli/src/core/client_lease.ts\n@@ -3,8 +3,29 @@ import * as fs from \"node:fs\";\n import * as path from \"node:path\";\n import { createHash } from \"node:crypto\";\n import { acquireFileGuard, releaseFileGuard, type FileGuard } from \"./file_guard.js\";\n+import { MAX_SHARED_RESOURCE_CAPACITY, SharedResourceAdmission, type ResourceSlotLease } from \"./shared_resource_admission.js\";\n \n const heartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\n+const activeClientSlots = new WeakMap<FileGuard, ResourceSlotLease>();\n+const activeClientHeartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\n+export const DEFAULT_MAX_ACTIVE_CLIENTS = 16;\n+\n+export class ClientActiveLimitError extends Error {\n+  constructor(readonly limit: number) {\n+    super(`Nexus active client limit (${limit}) reached; close another client or set NEXUS_MAX_ACTIVE_CLIENTS to a value from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n+    this.name = \"ClientActiveLimitError\";\n+  }\n+}\n+\n+function maxActiveClients(options: { maxActiveClients?: number }): number {\n+  const raw = process.env.NEXUS_MAX_ACTIVE_CLIENTS;\n+  const value = options.maxActiveClients ?? (raw === undefined ? DEFAULT_MAX_ACTIVE_CLIENTS : Number(raw));\n+  if ((raw !== undefined && options.maxActiveClients === undefined && !/^\\d+$/.test(raw)) ||\n+      !Number.isSafeInteger(value) || value < 1 || value > MAX_SHARED_RESOURCE_CAPACITY) {\n+    throw new Error(`Invalid NEXUS_MAX_ACTIVE_CLIENTS='${raw ?? value}': expected an integer from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n+  }\n+  return value;\n+}\n \n /** Only unambiguous metadata/recovery invocations may avoid a normal client lifetime lease. */\n export function clientInvocationKind(args: readonly string[]): \"metadata\" | \"restore\" | \"client\" {\n@@ -69,14 +90,44 @@ export function clientLeasePath(homeDir: string): string {\n }\n \n /** Retain the returned descriptor until the client has finished every use of loaded configuration/state. */\n-export function acquireClientLease(homeDir: string, options: { exclusive?: boolean; waitMs?: number } = {}): FileGuard {\n+export function acquireClientLease(\n+  homeDir: string,\n+  options: { exclusive?: boolean; waitMs?: number; maxActiveClients?: number } = {},\n+): FileGuard {\n   const exclusive = options.exclusive === true;\n-  const lease = acquireFileGuard(clientLeasePath(homeDir), {\n+  const activeLimit = exclusive ? undefined : maxActiveClients(options);\n+  const leasePath = clientLeasePath(homeDir);\n+  const lease = acquireFileGuard(leasePath, {\n     mode: exclusive ? \"exclusive\" : \"shared\",\n     waitMs: options.waitMs ?? 0,\n     label: \"Nexus client lease\",\n   });\n   if (!lease) throw new ClientLeaseBusyError(exclusive);\n+  if (activeLimit !== undefined) {\n+    try {\n+      const admission = new SharedResourceAdmission(path.join(path.dirname(leasePath), \"resource-admission\"), { guardWaitMs: 0 });\n+      const slot = admission.acquireNamed(\"active-client-processes\", activeLimit, \"client process\");\n+      if (!slot) {\n+        releaseFileGuard(lease);\n+        throw new ClientActiveLimitError(activeLimit);\n+      }\n+      if (slot.inheritedFd === undefined) {\n+        slot.release();\n+        throw new Error(\"Nexus active client slot does not expose its kernel lease descriptor\");\n+      }\n+      const slotFd = slot.inheritedFd;\n+      const slotHeartbeat = setInterval(() => {\n+        try { const now = new Date(); fs.futimesSync(slotFd, now, now); }\n+        catch { /* Kernel ownership remains until the descriptor is closed. */ }\n+      }, 60_000);\n+      slotHeartbeat.unref();\n+      activeClientSlots.set(lease, slot);\n+      activeClientHeartbeatTimers.set(lease, slotHeartbeat);\n+    } catch (error) {\n+      releaseFileGuard(lease);\n+      throw error;\n+    }\n+  }\n   // An active long-lived client must not age out of the operating system's\n   // temporary-file policy. This timer never keeps a finished CLI process alive.\n   const heartbeat = setInterval(() => {\n@@ -93,5 +144,16 @@ export function releaseClientLease(lease: FileGuard | null): void {\n   if (!lease) return;\n   const heartbeat = heartbeatTimers.get(lease);\n   if (heartbeat) { clearInterval(heartbeat); heartbeatTimers.delete(lease); }\n+  const activeSlot = activeClientSlots.get(lease);\n+  if (activeSlot) {\n+    const slotHeartbeat = activeClientHeartbeatTimers.get(lease);\n+    if (slotHeartbeat) { clearInterval(slotHeartbeat); activeClientHeartbeatTimers.delete(lease); }\n+    // Close the lifetime guard first so an exclusive maintenance invocation\n+    // cannot overlap a normal client while the capacity slot is being freed.\n+    releaseFileGuard(lease);\n+    activeSlot.release();\n+    activeClientSlots.delete(lease);\n+    return;\n+  }\n   releaseFileGuard(lease);\n }\ndiff --git a/cli/test/sidecar.test.ts b/cli/test/sidecar.test.ts\nindex e70cdfff6..39a20d121 100644\n--- a/cli/test/sidecar.test.ts\n+++ b/cli/test/sidecar.test.ts\n@@ -1126,10 +1126,17 @@ describe(\"SidecarServer: evidence and receipts\", () => {\n const cliRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n const sidecarSrc = path.join(cliRoot, \"src\", \"sidecar.ts\");\n \n-function spawnSidecar(gwUrl: string, repo: string, home: string, entry: string = sidecarSrc, args: string[] = [\"-w\", repo, \"-e\", gwUrl, \"-m\", \"m\"]) {\n+function spawnSidecar(\n+  gwUrl: string,\n+  repo: string,\n+  home: string,\n+  entry: string = sidecarSrc,\n+  args: string[] = [\"-w\", repo, \"-e\", gwUrl, \"-m\", \"m\"],\n+  extraEnv: NodeJS.ProcessEnv = {},\n+) {\n   const child = spawn(process.execPath, [\"--import\", \"tsx\", entry, ...args], {\n     cwd: cliRoot,\n-    env: { ...process.env, HOME: home, NEXUS_DEBUG: \"0\" },\n+    env: { ...process.env, HOME: home, NEXUS_DEBUG: \"0\", ...extraEnv },\n   });\n   let stdout = \"\";\n   let stderr = \"\";\n@@ -1163,6 +1170,28 @@ describe(\"sidecar process\", () => {\n     }\n   });\n \n+  test(\"rejects an extra same-home sidecar before it starts when the active client cap is reached\", { skip: process.platform !== \"linux\" }, async () => {\n+    const gw = await startGateway(readOnlyTurn);\n+    const repo = makeRepo();\n+    const home = makeHome();\n+    const env = { NEXUS_MAX_ACTIVE_CLIENTS: \"1\" };\n+    const first = spawnSidecar(gw.url, repo, home, sidecarSrc, [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\"], env);\n+    try {\n+      await waitUntil(() => first.lines().some((line) => line.includes('\"type\":\"hello\"')), 20000);\n+      const second = spawnSidecar(gw.url, repo, home, sidecarSrc, [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\"], env);\n+      assert.equal(await second.exited, 1, second.stderr());\n+      assert.match(second.stderr(), /active client limit \\(1\\) reached/i);\n+      assert.equal(second.lines().some((line) => line.includes('\"type\":\"hello\"')), false);\n+      first.child.stdin.write(JSON.stringify({ v: 1, type: \"shutdown\" }) + \"\\n\");\n+      assert.equal(await first.exited, 0, first.stderr());\n+    } finally {\n+      first.child.kill(\"SIGKILL\");\n+      await gw.close();\n+      fs.rmSync(repo, { recursive: true, force: true });\n+      fs.rmSync(home, { recursive: true, force: true });\n+    }\n+  });\n+\n   test(\"explicit help stays read-only when a restore is pending\", async () => {\n     const gw = await startGateway(readOnlyTurn);\n     const repo = makeRepo();\ndiff --git a/docs/CLIENT_GUIDE.md b/docs/CLIENT_GUIDE.md\nindex 39f09f3d6..2c8d22f42 100644\n--- a/docs/CLIENT_GUIDE.md\n+++ b/docs/CLIENT_GUIDE.md\n@@ -31,6 +31,15 @@ Provider disclosure is explicit for cloud destinations. Local inference keeps ta\n \n Saved sessions and task state live under `~/.nexus/`. Use `/sessions`, `/resume [id]`, and `/export [md|json]` to inspect, resume, or export a session. Exports are written into the current workspace; inspect and protect them as source data. `/compact` summarizes older context to make room, while durable findings and the active plan are retained where supported. `/doctor` checks the current runtime; `nexus doctor --deep` performs a minimal inference probe and can incur model cost.\n \n+On Linux, Nexus admits up to 16 concurrent CLI client processes for the same OS user, across its home directories. To set a different limit, export `NEXUS_MAX_ACTIVE_CLIENTS` in the launching shell or service environment before starting Nexus; accepted values are 1 through 64. For example:\n+\n+```sh\n+export NEXUS_MAX_ACTIVE_CLIENTS=8\n+nexus\n+```\n+\n+The setting is read before project `.env` files load, so it must be present in the parent environment. This limit counts cooperating Nexus client processes on one Linux host; it does not count sessions hosted inside a process or limit CPU and memory use.\n+\n An interrupted or limited run is not a successful result. Read the final execution/outcome fields, run the project's verifier, and resume explicitly when needed. Recovery is bounded by saved session state and the provider's availability; it cannot reconstruct output the provider never returned.\n \n ## Troubleshooting and limits\ndiff --git a/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md b/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md\nindex 7d3dfa777..0305b7706 100644\n--- a/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md\n+++ b/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md\n@@ -138,7 +138,7 @@ Reuse `Continu