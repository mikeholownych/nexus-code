urationsOut } : {}) },\n      detached: true,\n      stdio: \"inherit\",\n    });\n    children.add(child);\n    child.once(\"error\", (error) => { children.delete(child); resolve({ code: null, error }); });\n    child.once(\"close\", (code, signal) => { children.delete(child); resolve({ code: code ?? 1, signal }); });\n  });\n}\n\nfunction killShards(children) {\n  for (const child of children) {\n    if (!child.pid) continue;\n    try { process.kill(-child.pid, \"SIGKILL\"); } catch { try { child.kill(\"SIGKILL\"); } catch {} }\n  }\n}\n\nfunction signalShards(children, signal) {\n  for (const child of children) {\n    if (!child.pid) continue;\n    try { process.kill(-child.pid, signal); } catch { try { child.kill(signal); } catch {} }\n  }\n}\n\n/**\n * Runs `files` in up to `count` concurrent processes on this machine. With `shard: { index, total }` only that shard\n * of the files runs (CI fans the suite out over runners this way); the selected files are then split over the\n * concurrent processes exactly as a whole run is. `NEXUS_TEST_DURATIONS_OUT` receives one merged file: each process\n * writes its own part, because processes sharing the path used to overwrite each other.\n */\nexport async function runShards(files, { count = 2, durations = loadTestDurations(),…3502 tokens truncated…+ \"\\n\";\ncli/test/nonprogress_recovery.test.ts:162:      for (let i = 0; i < 16; i++) {\ncli/test/nonprogress_recovery.test.ts:321:    const script: Call[][] = [[read(\"f.txt\")], ...Array.from({ length: 6 }, (_, i) => [read(\"f.txt\", 1 + i * 40, 20 + i * 40)])];\ncli/test/operation_lock.test.ts:121:  const children = Array.from({ length: 4 }, () => spawn(process.execPath, [\"--import\", \"tsx\", childFile, root, \"op-multi\", go, results], { env, stdio: [\"ignore\", \"pipe\", \"inherit\"] }));\ncli/test/operation_lock.test.ts:126:  await Promise.all(children.map((c) => new Promise((resolve) => c.on(\"close\", resolve))));\ncli/test/run_json_contract.test.ts:253:  await P