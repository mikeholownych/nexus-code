\ncli/test/acp_stdio.test.ts:28:  const home = makeHome();\ncli/test/acp_stdio.test.ts:68:  const home = makeHome();\ncli/test/acp_stdio.test.ts:196:  const home = makeHome();\ncli/test/hash_chain.test.ts:17:import { makeHome } from \"./helpers/fixtures.js\";\ncli/test/hash_chain.test.ts:247:    const home = makeHome();\ncli/test/hash_chain.test.ts:274:    const home = makeHome();\ncli/test/slash_router.test.ts:13:import { makeHome, makeRepo } from \"./helpers/fixtures.js\";\ncli/test/slash_router.test.ts:31:  const home = makeHome();\n/** Lifetime client/maintenance coordination; this is not a boundary against arbitrary same-UID programs. */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { acquireFileGuard, releaseFileGuard, type FileGuard } from \"./file_guard.js\";\nimport { MAX_SHARED_RESOURCE_CAPACITY, SharedResourceAdmission, type ResourceSlotLease } from \"./shared_resource_admission.js\";\n\nconst heartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\nconst activeClientSlots = new WeakMap<FileGuard, ResourceSlotLease>();\nconst activeClientHeartbeatTimers = new WeakMap<FileGuard, ReturnType<typeof setInterval>>();\nexport const DEFAULT_MAX_ACTIVE_CLIENTS = MAX_SHARED_RESOURCE_CAPACITY;\n\nexport class ClientActiveLimitError extends Error {\n  constructor(readonly limit: number) {\n    super(`Nexus active client limit (${limit}) reached; close another client or set NEXUS_MAX_ACTIVE_CLIENTS to a value from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n    this.name = \"ClientActiveLimitError\";\n  }\n}\n\nfunction maxActiveClients(options: { maxActiveClients?: number }): number {\n  const raw = process.env.NEXUS_MAX_ACTIVE_CLIENTS;\n  const value = options.maxActiveClients ?? (raw === undefined ? DEFAULT_MAX_ACTIVE_CLIENTS : Number(raw));\n  if ((raw !== undefined && options.maxActiveClients === undefined && !/^\\d+$/.test(raw)) ||\n      !Number.isSafeInteger(value) || value < 1 || value > MAX_SHARED_RESOURCE_CAPACITY) {\n    throw new Error(`Invalid NEXUS_MAX_ACTIVE_CLIENTS='${raw ?? value}': expected an integer from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\n  }\n  return value;\n}\n\n/** Only unambiguous metadata/recovery invocations may avoid a normal client lifetime lease. */\nexport function clientInvocationKind(args: readonly string[]): \"metadata\" | \"restore\" | \"client\" {\n  const metadata = [\"--version\", \"-V\", \"--help\", \"-h\"];\n  if (args.some(arg => metadata.includes(arg)) && args.every(arg => metadata.includes(arg) || arg === \"--json\" || arg === \"-j\")) return \"metadata\";\n  // A preceding option could consume --help as its value. Bare positional\n  // command names followed by help cannot execute a configured client action.\n  if (args.length > 1 && [\"--help\", \"-h\"].includes(args[args.length - 1]) &&\n      args.slice(0, -1).every(arg => !arg.startsWith(\"-\"))) return \"metadata\";\n  if (args[0] !== \"upgrade\") return \"client\";\n  let restore = false;\n  for (let index = 1; index < args.length; index++) {\n    const arg = args[index];\n    if (arg === \"--json\" || arg === \"-j\") continue;\n    if (arg.startsWith(\"--prefix=\")) continue;\n    if (arg.startsWith(\"--restore-backup=\")) {\n      if (restore || arg === \"--restore-backup=\") return \"client\";\n      restore = true;\n      continue;\n    }\n    if (arg === \"--prefix\" || arg === \"--restore-backup\") {\n      if (index + 1 >= args.length || (arg === \"--restore-backup\" && args[index + 1].startsWith(\"-\"))) return \"client\";\n      if (arg === \"--restore-backup\") {\n        if (restore) return \"client\";\n        restore = true;\n      }\n      index++; // Do not mistake an option's value for a recovery flag.\n      continue;\n    }\n    return \"client\";\n  }\n  return restore ? \"restore\" : \"client\";\n}\n\nexport class ClientLeaseBusyError extends Error {\n  constructor(exclusive: boolean) {\n    super(exclusive\n      ? \"Close all other Nexus clients before restoring configuration or state.\"\n      : \"Nexus state maintenance is active; retry after recovery finishes.\");\n    this.name = \"ClientLeaseBusyError\";\n  }\n}\n\n/** Independent of TMPDIR so cooperating clients for the same canonical home always meet at one inode. */\nexport function clientLeasePath(homeDir: string): string {\n  if (process.platform !== \"linux\" || typeof process.getuid !== \"function\") {\n    throw new Error(\"Managed Nexus maintenance requires Linux kernel client leases\");\n  }\n  const uid = process.getuid();\n  const directory = path.join(\"/tmp\", `nexus-client-leases-${uid}`);\n  try { fs.mkdirSync(directory, { mode: 0o700 }); }\n  catch (error: any) { if (error.code !== \"EEXIST\") throw error; }\n  const stat = fs.lstatSync(directory);\n  if (!stat.isDirectory() || stat.isSymbolicLink() || stat.uid !== uid || (stat.mode & 0o077) !== 0 ||\n      fs.realpathSync(directory) !== directory) {\n    throw new Error(\"Nexus client lease directory is redirected or not private to this user\");\n  }\n  const home = fs.realpathSync(homeDir);\n  if (!fs.statSync(home).isDirectory()) throw new Error(\"Nexus client home must be a directory\");\n  const identity = createHash(\"sha256\").update(home).digest(\"hex\");\n  return path.join(directory, `${identity}.guard`);\n}\n\n/** Retain the returned descriptor until the client has finished every use of loaded configuration/state. */\nexport function acquireClientLease(\n  homeDir: string,\n  options: { exclusive?: boolean; waitMs?: number; maxActiveClients?: number } = {},\n): FileGuard {\n  const exclusive = options.exclusive === true;\n  const activeLimit = exclusive ? undefined : maxActiveClients(options);\n  const leasePath = clientLeasePath(homeDir);\n  const lease = acquireFileGuard(leasePath, {\n    mode: exclusive ? \"exclusive\" : \"shared\",\n    waitMs: options.waitMs ?? 0,\n    label: \"Nexus client lease\",\n  });\n  if (!lease) throw new ClientLeaseBusyError(exclusive);\n  if (activeLimit !== undefined) {\n    try {\n      const homeAdmissionDir = path.join(path.dirname(leasePath), path.basename(leasePath, \".guard\"), \"resource-admission\");\n      const admission = new SharedResourceAdmission(homeAdmissionDir, { guardWaitMs: 0 });\n      const slot = admission.acquireNamed(\"active-client-processes\", activeLimit, \"client process\");\n      if (!slot) {\n        releaseFileGuard(lease);\n        throw new ClientActiveLimitError(activeLimit);\n      }\n      if (slot.inheritedFd === undefined) {\n        slot.release();\n        throw new Error(\"Nexus active client slot does not expose its kernel lease descriptor\");\n      }\n      const slotFd = slot.inheritedFd;\n      const slotHeartbeat = setInterval(() => {\n        try { const now = new Date(); fs.futimesSync(slotFd, now, now); }\n        catch { /* Kernel ownership remains until the descriptor is closed. */ }\n      }, 60_000);\n      slotHeartbeat.unref();\n      activeClientSlots.set(lease, slot);\n      activeClientHeartbeatTimers.set(lease, slotHeartbeat);\n    } catch (error) {\n      releaseFileGuard(lease);\n      throw error;\n    }\n  }\n  // An active long-lived client must not age out of the operating system's\n  // temporary-file policy. This timer never keeps a finished CLI process alive.\n  const heartbeat = setInterval(() => {\n    try { const now = new Date(); fs.futimesSync(lease.fd, now, now); }\n    catch { /* Kernel ownership still lasts until descriptor close/process exit. */ }\n  }, 60_000);\n  heartbeat.unref();\n  heartbeatTimers.set(lease, heartbeat);\n  return lease;\n}\n\n/** Closing releases the kernel lease; never unlink or replace the shared inode. */\nexport function releaseClientLease(lease: FileGuard | null): void {\n  if (!lease) return;\n  const heartbeat = heartbeatTimers.get(lease);\n  if (heartbeat) { clearInterval(heartbeat); heartbeatTimers.delete(lease); }\n  const activeSlot = activeClientSlots.get(lease);\n  if (activeSlot) {\n    const slotHeartbeat = activeClientHeartbeatTimers.get(lease);\n    if (slotHeartbeat) { clearInterval(slotHeartbeat); activeClientHeartbeatTimers.delete(lease); }\n    // Close the lifetime guard first so an exclusive maintenance invocation\n    // cannot overlap a normal client while the capacity slot is being freed.\n    releaseFileGuard(lease);\n    activeSlot.release();\n    activeClientSlots.delete(lease);\n    return;\n  }\n  releaseFileGuard(lease);\n}\n cli/src/core/client_lease.ts                       |  67 +++++++++++++-\n cli/test/client_lease.test.ts                      | 101 +++++++++++++++++++++\n cli/test/sidecar.test.ts                           |  33 ++++++-\n docs/CLIENT_GUIDE.md                               |   9 ++\n docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md |   4 +-\n 5 files changed, 209 insertions(+), 5 deletions(-)\n","exit_code":0,"duration":{"secs":1,"nanos":607814561}},"started_at_ms":1795848316452,"completed_at_ms":1795848318061}}
{"timestamp":"2026-11-28T06:45:18.136Z","ordinal":315006,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a220e6-acb8-7d83-9de3-99b26f81f0a2","call_id":"call_49967d0cfd464679b4e37b4c6276af53","output":[{"type":"input_text","text":"Script completed\nWall time 1.9 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 8166)\nTotal output lines: 476\n\n     1\t/**\n     2\t * BG-1 / G-4 (no allow-always) and G-3 (client and environment): an unattended job cannot be put in auto mode and\n     3\t * cannot be granted anything.\n     4\t *   - `nexus job start` has no --yes, -y, --mode or --approve; the same flags before `job` and NEXUS_APPROVAL_MODE=auto\n     5\t *     in the client's environment are refused, not ignored.\n     6\t *   - A runner whose own environment says auto mode, trusts every workspace and opens the sandbox's network still runs\n     7\t *     the job in review mode, loads no workspace plugin, and denies a command twice in a row: nothing is remembered.\n     8\t *   - Through the real dispatch path, in process: the job's policy denies commands and egress with\n     9\t *     DECISION_REQUIRED_NO_OPERATOR and lets a worktree write through; a copy of the policy that lets commands through\n    10\t *     runs the command, so these assertions do depend on the policy (mutation guard).\n    11\t */\n    12\timport \"./helpers/leak_guard.js\";\n    13\timport { after, test } from \"node:test\";\n    14\timport assert from \"node:assert/strict\";\n    15\timport fs from \"node:fs\";\n    16\timport os from \"node:os\";\n    17\timport path from \"node:path\";\n    18\timport { AutonomousAgent } from \"../src/agent.js\";\n    19\timport type { PolicyContext } from \"../src/core/approval_policy.js\";\n    20\timport type { EffectClass } from \"../src/core/capabilities.js\";\n    21\timport { readReceipt } from \"../src/core/job_runner.js\";\n    22\timport { mergePolicies } from \"../src/core/managed_policy.js\";\n    23\timport { sameProcess } from \"../src/core/process_identity.js\";\n    24\timport type { JobPolicy } from \"../src/core/runner_store.js\";\n    25\timport { DurableStateManager } from \"../src/core/state.js\";\n    26\timport { scrubUnattendedEnv, UnattendedApprovalPolicy } from \"../src/core/unattended.js\";\n    27\timport { isSandboxAvailable } from \"../src/sandbox.js\";\n    28\timport { isWorkspaceTrusted } from \"../src/workspace_trust.js\";\n    29\timport { makeRepo, startGateway } from \"./helpers/fixtures.js\";\n    30\timport { runnerWorld, startedJobId } from \"./helpers/runner_fixture.js\";\n    31\t\n    32\tconst temp: string[] = [];\n    33\tconst agents: AutonomousAgent[] = [];\n    34\tafter(() => {\n    35\t  for (const agent of agents) agent.shutdown();\n    36\t  for (const dir of temp) fs.rmSync(dir, { recursive: true, force: true });\n    37\t});\n    38\t\n    39\ttest(\"job start has no way to ask for auto mode: the flags do not exist, and the ones that parse elsewhere are refused\", { timeout: 200_000 }, async () => {\n    40\t  const world = runnerWorld();\n    41\t  const repo = makeRepo();\n    42\t  const start = [\"job\", \"start\", \"--prompt\", \"x\", \"-w\", repo];\n    43\t  try {\n    44\t    const runs = await Promise.all([\n    45\t      world.run([...start, \"--yes\"]),\n    46\t      world.run([...start, \"-y\"]),\n    47\t      world.run([...start, \"--mode\", \"auto\"]),\n    48\t      world.run([...start, \"--approve\"]),\n    49\t      world.run([...start, \"--sandbox\", \"none\"]),\n    50\t      world.run([\"--yes\", ...start]),\n    51\t      world.run([\"--mode\", \"auto\", ...start]),\n    52\t      world.run([\"--sandbox-network\", ...start]),\n    53\t      world.run(start, { NEXUS_APPROVAL_MODE: \"auto\" }),\n    54\t    ]);\n    55\t    for (const [index, flag] of [\"--yes\", \"-y\", \"--mode\", \"--approve\", \"--sandbox\"].entries()) {\n    56\t      assert.equal(runs[index].code, 1, runs[index].stderr);\n    57\t      assert.match(runs[index].stderr, new RegExp(`unknown option '${flag}'`));\n    58\t    }\n    59\t    for (const [index, flag] of [[5, \"--yes\"], [6, \"--mode\"], [7, \"--sandbox-network\"]] as const) {\n    60\t      assert.equal(runs[index].code, 2, runs[index].stderr);\n    61\t      assert.match(runs[index].stderr, new RegExp(`^${flag} does not apply to a background job and is refused`));\n    62\t    }\n    63\t    assert.equal(runs[8].code, 2, runs[8].stderr);\n    64\t    assert.match(runs[8].stderr, /^NEXUS_APPROVAL_MODE=auto is set, and a background job never runs in auto mode/);\n    65\t    for (const run of runs) assert.equal(run.stdout, \"\", \"no job id was printed\");\n    66\t    assert.equal(fs.existsSync(world.paths.root), false, \"nothing was submitted\");\n    67\t  } finally {\n    68\t    await world.cleanup();\n    69\t    fs.rmSync(repo, { recursive: true, force: true });\n    70\t  }\n    71\t});\n    72\t\n    73\ttest(\"a runner started with auto mode, workspace trust and sandbox network in its environment still runs the job in review mode and denies every command\", { timeout: 290_000, skip: isSandboxAvailable(\"auto\") ? false : \"worktree-write needs a sandbox engine\" }, async () => {\n    74\t  const world = runnerWorld();\n    75\t  const sentinel = path.join(world.root, \"plugin-loaded\");\n    76\t  const repo = makeRepo({ \"plugins/sentinel.mjs\": `import fs from \"node:fs\";\\nfs.writeFileSync(${JSON.stringify(sentinel)}, \"loaded\");\\nexport default { name: \"sentinel\", description: \"must not load\" };\\n` });\n    77\t  const command = { name: \"run_command\", args: { command: \"touch ran.txt\" } };\n    78\t  const gw = await startGateway((n) => (n === 1 ? { kind: \"tools\", calls: [command, command] } : { kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary: \"could not ru…5566 tokens truncated…ckup\" && args[index + 1].startsWith(\"-\"))) return \"client\";\n 