{"timestamp":"2026-11-28T06:45:18.061Z","ordinal":315005,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a220e5-c285-7e72-9bb5-c6a32a48db70","item":{"type":"CommandExecution","id":"exec-e1dee700-1d72-4016-b17e-72ad0fb34f9b","process_id":"15184","command":["/usr/bin/zsh","-lc","nl -ba cli/test/unattended_gate.test.ts | sed -n '1,130p'; rg -n \"NEXUS_MAX_ACTIVE_CLIENTS|active client limit|makeHome|runnerWorld|auditFixture\" cli/test cli/src/core/client_lease.ts cli/src/index.ts cli/src/sidecar.ts; sed -n '1,240p' cli/src/core/client_lease.ts; git diff origin/release/v1.3.1...HEAD --stat"],"cwd":"file:///home/mike/nexus-wt/p10-04-active-client-admission-continued","parsed_cmd":[{"type":"unknown","cmd":"nl -ba cli/test/unattended_gate.test.ts | sed -n '1,130p'; rg -n \"NEXUS_MAX_ACTIVE_CLIENTS|active client limit|makeHome|runnerWorld|auditFixture\" cli/test cli/src/core/client_lease.ts cli/src/index.ts cli/src/sidecar.ts; sed -n '1,240p' cli/src/core/client_lease.ts; git diff origin/release/v1.3.1...HEAD --stat"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"     1\t/**\n     2\t * BG-1 / G-4 (no allow-always) and G-3 (client and environment): an unattended job cannot be put in auto mode and\n     3\t * cannot be granted anything.\n     4\t *   - `nexus job start` has no --yes, -y, --mode or --approve; the same flags before `job` and NEXUS_APPROVAL_MODE=auto\n     5\t *     in the client's environment are refused, not ignored.\n     6\t *   - A runner whose own environment says auto mode, trusts every workspace and opens the sandbox's network still runs\n     7\t *     the job in review mode, loads no workspace plugin, and denies a command twice in a row: nothing is remembered.\n     8\t *   - Through the real dispatch path, in process: the job's policy denies commands and egress with\n     9\t *     DECISION_REQUIRED_NO_OPERATOR and lets a worktree write through; a copy of the policy that lets commands through\n    10\t *     runs the command, so these assertions do depend on the policy (mutation guard).\n    11\t */\n    12\timport \"./helpers/leak_guard.js\";\n    13\timport { after, test } from \"node:test\";\n    14\timport assert from \"node:assert/strict\";\n    15\timport fs from \"node:fs\";\n    16\timport os from \"node:os\";\n    17\timport path from \"node:path\";\n    18\timport { AutonomousAgent } from \"../src/agent.js\";\n    19\timport type { PolicyContext } from \"../src/core/approval_policy.js\";\n    20\timport type { EffectClass } from \"../src/core/capabilities.js\";\n    21\timport { readReceipt } from \"../src/core/job_runner.js\";\n    22\timport { mergePolicies } from \"../src/core/managed_policy.js\";\n    23\timport { sameProcess } from \"../src/core/process_identity.js\";\n    24\timport type { JobPolicy } from \"../src/core/runner_store.js\";\n    25\timport { DurableStateManager } from \"../src/core/state.js\";\n    26\timport { scrubUnattendedEnv, UnattendedApprovalPolicy } from \"../src/core/unattended.js\";\n    27\timport { isSandboxAvailable } from \"../src/sandbox.js\";\n    28\timport { isWorkspaceTrusted } from \"../src/workspace_trust.js\";\n    29\timport { makeRepo, startGateway } from \"./helpers/fixtures.js\";\n    30\timport { runnerWorld, startedJobId } from \"./helpers/runner_fixture.js\";\n    31\t\n    32\tconst temp: string[] = [];\n    33\tconst agents: AutonomousAgent[] = [];\n    34\tafter(() => {\n    35\t  for (const agent of agents) agent.shutdown();\n    36\t  for (const dir of temp) fs.rmSync(dir, { recursive: true, force: true });\n    37\t});\n    38\t\n    39\ttest(\"job start has no way to ask for auto mode: the flags do not exist, and the ones that parse elsewhere are refused\", { timeout: 200_000 }, async () => {\n    40\t  const world = runnerWorld();\n    41\t  const repo = makeRepo();\n    42\t  const start = [\"job\", \"start\", \"--prompt\", \"x\", \"-w\", repo];\n    43\t  try {\n    44\t    const runs = await Promise.all([\n    45\t      world.run([...start, \"--yes\"]),\n    46\t      world.run([...start, \"-y\"]),\n    47\t      world.run([...start, \"--mode\", \"auto\"]),\n    48\t      world.run([...start, \"--approve\"]),\n    49\t      world.run([...start, \"--sandbox\", \"none\"]),\n    50\t      world.run([\"--yes\", ...start]),\n    51\t      world.run([\"--mode\", \"auto\", ...start]),\n    52\t      world.run([\"--sandbox-network\", ...start]),\n    53\t      world.run(start, { NEXUS_APPROVAL_MODE: \"auto\" }),\n    54\t    ]);\n    55\t    for (const [index, flag] of [\"--yes\", \"-y\", \"--mode\", \"--approve\", \"--sandbox\"].entries()) {\n    56\t      assert.equal(runs[index].code, 1, runs[index].stderr);\n    57\t      assert.match(runs[index].stderr, new RegExp(`unknown option '${flag}'`));\n    58\t    }\n    59\t    for (const [index, flag] of [[5, \"--yes\"], [6, \"--mode\"], [7, \"--sandbox-network\"]] as const) {\n    60\t      assert.equal(runs[index].code, 2, runs[index].stderr);\n    61\t      assert.match(runs[index].stderr, new RegExp(`^${flag} does not apply to a background job and is refused`));\n    62\t    }\n    63\t    assert.equal(runs[8].code, 2, runs[8].stderr);\n    64\t    assert.match(runs[8].stderr, /^NEXUS_APPROVAL_MODE=auto is set, and a background job never runs in auto mode/);\n    65\t    for (const run of runs) assert.equal(run.stdout, \"\", \"no job id was printed\");\n    66\t    assert.equal(fs.existsSync(world.paths.root), false, \"nothing was submitted\");\n    67\t  } finally {\n    68\t    await world.cleanup();\n    69\t    fs.rmSync(repo, { recursive: true, force: true });\n    70\t  }\n    71\t});\n    72\t\n    73\ttest(\"a runner started with auto mode, workspace trust and sandbox network in its environment still runs the job in review mode and denies every command\", { timeout: 290_000, skip: isSandboxAvailable(\"auto\") ? false : \"worktree-write needs a sandbox engine\" }, async () => {\n    74\t  const world = runnerWorld();\n    75\t  const sentinel = path.join(world.root, \"plugin-loaded\");\n    76\t  const repo = makeRepo({ \"plugins/sentinel.mjs\": `import fs from \"node:fs\";\\nfs.writeFileSync(${JSON.stringify(sentinel)}, \"loaded\");\\nexport default { name: \"sentinel\", description: \"must not load\" };\\n` });\n    77\t  const command = { name: \"run_command\", args: { command: \"touch ran.txt\" } };\n    78\t  const gw = await startGateway((n) => (n === 1 ? { kind: \"tools\", calls: [command, command] } : { kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary: \"could not run it\" } }] }));\n    79\t  try {\n    80\t    await world.startRunner([], { NEXUS_APPROVAL_MODE: \"auto\", NEXUS_TRUST_WORKSPACE: \"1\", NEXUS_SANDBOX_NETWORK: \"1\" });\n    81\t    const started = await world.run([\"job\", \"start\", \"--prompt\", \"Run touch ran.txt.\", \"--allow-worktree-write\", \"-w\", repo, \"-e\", gw.url, \"-m\", \"m\"]);\n    82\t    assert.equal(started.code, 0, started.stderr);\n    83\t    const id = startedJobId(started.stdout);\n    84\t    const ended = await world.waitJob(id, [\"BLOCKED\", \"COMPLETE\", \"FAILED\", \"CANCELLED\", \"TIMED_OUT\"], 200_000);\n    85\t    const receipt = readReceipt(world.paths, id)!;\n    86\t    assert.equal(ended.state, \"BLOCKED\", JSON.stringify(receipt));\n    87\t    assert.equal(receipt.approval_mode, \"review\", \"not auto, whatever the runner's environment says\");\n    88\t    assert.equal(receipt.unattended, true);\n    89\t    // The operation reports the unit as having changed nothing (its command was refused), and asks what to do next.\n    90\t    assert.equal(receipt.reason, \"EXECUTION_FAILED\", receipt.summary);\n    91\t    assert.match(receipt.summary, /^BLOCKED: unit 'task' no_change: .*no changes made/);\n    92\t    assert.equal(receipt.pending_decisions.length, 1);\n    93\t    assert.equal(receipt.units[0].status, \"BLOCKED\");\n    94\t    assert.notEqual(receipt.units[0].outcome, \"VERIFIED\");\n    95\t\n    96\t    // Both identical calls were denied: the first denial granted nothing for the second.\n    97\t    const results = ((gw.requests[1] as any).messages as any[]).filter((message) => message.role === \"tool\").map((message) => String(message.content));\n    98\t    assert.equal(results.length, 2);\n    99\t    for (const result of results) assert.match(result, /requires operator approval \\(exec\\), but no operator is present/);\n   100\t    const denied = fs.readFileSync(world.paths.events(id), \"utf8\").split(\"\\n\").filter(Boolean).map((line) => JSON.parse(line)).filter((event) => event.type === \"TOOL_END\" && event.tool === \"run_command\");\n   101\t    assert.equal(denied.length, 2);\n   102\t    assert.ok(denied.every((event) => event.success === false));\n   103\t    assert.deepEqual(fs.readdirSync(path.join(repo, \".nexus\", \"worktrees\"), { recursive: true }).filter((name) => String(name).endsWith(\"ran.txt\")), [], \"the command never ran\");\n   104\t\n   105\t    // NEXUS_TRUST_WORKSPACE=1 did not reach the worker: the repository's plugin was seen and not loaded.\n   106\t    assert.equal(fs.existsSync(sentinel), false, \"the workspace plugin was not imported\");\n   107\t    assert.equal(sameProcess(ended.attempts[0]), false, \"the worker did not stay waiting for an answer\");\n   108\t  } finally {\n   109\t    await world.cleanup();\n   110\t    await gw.close();\n   111\t    fs.rmSync(repo, { recursive: true, force: true });\n   112\t  }\n   113\t});\n   114\t\n   115\tfunction agent(jobPolicy: JobPolicy, make: (jobPolicy: JobPolicy) => UnattendedApprovalPolicy): { agent: AutonomousAgent; repo: string } {\n   116\t  const repo = makeRepo({ \"a.txt\": \"hello\\n\" });\n   117\t  const stateDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-unattended-gate-\"));\n   118\t  temp.push(repo, stateDir);\n   119\t  const made = new AutonomousAgent({ endpoint: \"http://127.0.0.1:9/v1\", model: \"m\", maxSteps: 4, temperature: 0, workspace: repo, shell: \"bash\", approvalMode: jobPolicy === \"worktree-write\" ? \"review\" : \"read-only\", readOnly: jobPolicy === \"read-only\", fullAccess: false, surface: \"unattended\" } as any);\n   120\t  (made as any).stateManager = new DurableStateManager({ baseDir: stateDir, workspacePaths: [(made as any).primaryWorkspacePathIdentity] });\n   121\t  made.setApprovalPolicy(make(jobPolicy));\n   122\t  agents.push(made);\n   123\t  return { agent: made, repo };\n   124\t}\n   125\tlet seq = 0;\n   126\t/** One tool call through the real dispatch path with no operator to ask, as in a worker. */\n   127\tasync function call(target: AutonomousAgent, name: string, args: Record<string, unknown>) {\n   128\t  const toolCall = { id: `c${++seq}`, type: \"function\", function: { name, arguments: JSON.stringify(args) } };\n   129\t  return (await (target as any).dispatchToolCall(toolCall, 1, \"agent\", undefined)).receipt;\n   130\t}\ncli/src/core/client_lease.ts:15:    super(`Nexus active client limit (${limit}) reached; close another client or set NEXUS_MAX_ACTIVE_CLIENTS to a value from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\ncli/src/core/client_lease.ts:21:  const raw = process.env.NEXUS_MAX_ACTIVE_CLIENTS;\ncli/src/core/client_lease.ts:25:    throw new Error(`Invalid NEXUS_MAX_ACTIVE_CLIENTS='${raw ?? value}': expected an integer from 1 to ${MAX_SHARED_RESOURCE_CAPACITY}.`);\ncli/test/sandbox_profiles.test.ts:17:import { makeHome, makeRepo } from \"./helpers/fixtures.js\";\ncli/test/sandbox_profiles.test.ts:379:    const home = makeHome();\ncli/test/repl_readonly_e2e.test.ts:6:import { startGateway, makeRepo, makeHome, trustWorkspace, ptyTest } from \"./helpers/fixtures.js\";\ncli/test/repl_readonly_e2e.test.ts:15:  const home = makeHome();\ncli/test/schedule_unattended.test.ts:17:import { runnerWorld, stalledGateway, until } from \"./helpers/runner_fixture.js\";\ncli/test/schedule_unattended.test.ts:23