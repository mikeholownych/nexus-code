repair the accounting before resuming (cap ${cap}).`;\ncli/src/core/operation_runner.ts:836:    const reason = `Paused: goal token budget exhausted (${total} of ${cap} tokens consumed across agent runs). Raise the cap with 'nexus operation budget ${this.state.id} --max-total-tokens <n|none>', then resume, or cancel the goal.`;\ncli/src/core/operation_runner.ts:902:    let nextTokenReservations = this.state.tokenReservations;\ncli/src/core/operation_runner.ts:909:          throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation token budget state could not be saved before provider dispatch: ${error?.message ?? error}`);\ncli/src/core/operation_runner.ts:913:          \"operation token budget requires positive, safe per-request input and output-token estimates; no provider request was sent\",\ncli/src/core/operation_runner.ts:921:          throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation token budget state could not be saved before provider dispatch: ${error?.message ?? error}`);\ncli/src/core/operation_runner.ts:925:          \"operation token budget reservation history is unavailable; no provider request was sent\",\ncli/src/core/operation_runner.ts:931:        const reason = `operation token budget reservation exhausted (${reserved} reserved + ${minimumRequestEstimate} minimum requested estimate exceeds ${tokenCap}); no provider request was sent`;\ncli/src/core/operation_runner.ts:935:          throw new OperationInferenceAdmissionError(\"persistence_failed\", `Operation token budget pause could not be saved before provider dispatch: ${error?.message ?? error}`);\ncli/src/core/operation_runner.ts:944:    if (tokenCap !== undefined) this.state.tokenReservations = nextTokenReservations;\n","exit_code":0,"duration":{"secs":0,"nanos":927256419}},"started_at_ms":1795855737315,"completed_at_ms":1795855738243}}
