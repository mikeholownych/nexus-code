xistsSync(this.baseDir)) return [];\n    return withStateStoreGuard(this.baseDir, () => this.listTasksLocked(options));\n  }\n\n  private listTasksLocked(options?: { workspace?: string }): Array<{\n    taskId: string;\n    sessionId: string;\n    title: string;\n    updatedAt: string;\n    workspacePath: string;\n    status: TaskLifecycleStatus;\n    milestoneCount: number;\n    mtime: number;\n  }> {\n    const files = fs.readdirSync(this.baseDir).filter((f) => f.endsWith(\".json\"));\n    const results: Array<{\n      taskId: string;\n      sessionId: string;\n      title: string;\n      updatedAt: string;\n      workspacePath: string;\n      status: TaskLifecycleStatus;\n      milestoneCount: number;\n      mtime: number;\n    }> = [];\n\n    for (const file of files) {\n      const fullPath = path.join(this.baseDir, file);\n      const cleanId = file.replace(/\\.json$/, \"\");\n      try {\n        const stat = fs.statSync(fullPath);\n        const content = fs.readFileSync(fullPath, \"utf-8\");\n        const data = JSON.parse(content);\n        if (!data || typeof data !== \"object\" || Array.isArray(data)) {\n          throw new CorruptStateError(cleanId, \"State file does not contain a JSON object\", this.quarantineFile(fullPath));\n        }\n        results.push({\n          taskId: data.taskId || data.id || cleanId,\n          sessionId: data.sessionId || data.id || cleanId,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a22202-664d-7671-a9c4-ed550c36ebc8","create_time":1795867973.4974074}},"metadata":{"history_sequence":142421,"sampled_through_sequence":142418,"client_authored":false,"fallback_token_limit_override":12000}}
