,\n  );\n  assert.equal(result.persistence?.durable, false);\n  assert.ok(result.persistence?.failures.some((failure) => failure.includes(\"operation_start\")));\n});\ncli/src/core/state.ts:455:      throw new TaskStateReadError(taskId, `Failed to read message journal: ${(error as any)?.message ?? String(error)}`);\ncli/src/core/state.ts:797:  public recordOperationEnd(\ncli/src/core/operation.ts:362:  /** The copied task state and journals with their own hashes. */\ncli/src/core/tool_pipeline.ts:778:      // state before the mutation journal so a missing record is not mistaken for\ncli/src/core/tool_pipeline.ts:860:function recordOperationEndIfStarted(\ncli/src/core/tool_pipeline.ts:870:    agent.stateManager.recordOperationEnd(durableTaskId, invocationId, {\ncli/src/core/tool_pipeline.ts:880:/** Plugin notice, journal start, baseline capture, and the spine call, in their original order. */\ncli/src/core/tool_pipeline.ts:912:  // operation journal on that durable identity so recordOperationStart/End can find the\ncli/src/core/tool_pipeline.ts:976:    recordOperationEndIfStarted(agent, durableTaskId, call.id, receipt, operationSeq, operationStart.persisted);\ncli/src/core/task_message_log.ts:150:// reuse first reads and hashes the entire small journal again: stat metadata or\ncli/src/core/task_message_log.ts:165:    // Small journals fit in a bounded snapshot. This avoids one fstat/read pair\ncli/src/core/task_message_log.ts:176:        if (!count) corrupt(\"Message journal changed during recovery\");\ncli/src/core/operation_budget.ts:7: * who, when, old and new value go into the operation's event journal. It takes the driver lock, so it never rewrites\ncli/src/core/operation_budget.ts:106:        // Preserve the original token-cap journal fields for existing consumers.\ncli/src/core/operation_checkpoints.ts:3: * and its conversation journals (the schema-2 state keeps the conversation in `.messages.jsonl`/`.history.jsonl`, so\ncli/src/core/operation_checkpoints.ts:1