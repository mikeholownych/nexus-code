action === \"set\") {\n        return {\n          success: false,\n          output: \"\",\n          error: \"Model tool calls cannot promote durable knowledge. Use the explicit operator command /knowledge set or nexus knowledge set after reviewing the source.\",\n        };\n      }\n      if (action === \"get\") {\n        const entry = knowledge.get(args.key || \"\");\n        return { success: true, output: JSON.stringify({ found: Boolean(entry), entry }, null, 2) };\n      }\n      if (action === \"delete\") {\n        const deleted = knowledge.delete(args.key || \"\");\n        return { success: true, output: JSON.stringify({ status: deleted ? \"deleted\" : \"not_found\", key: args.key }, null, 2) };\n      }\n      if (action === \"query\") {\n        const entries = knowledge.query(args.key || args.value, args.category);\n        return { success: true, output: JSON.stringify({ total: entries.length, entries }, null, 2) };\n      }\n      const entries = knowledge.list();\n      return { success: true, output: JSON.stringify({ total: entries.length, entries }, null, 2) };\n    } catch (err: any) {\n      return { success: false, output: \"\", error: `Error executing manage_knowledge: ${err.message}` };\n    }\n  };\n}\n\nexport function setupSpineHandlersImpl(this: any): void {\n  registerBridgeCapabilities(this.capabilityRegistry, this.bridge);\n\n  this.spine.registerHandler(\"task_completed\", async (args: any) => {\n    const validCompletion =\n      Boolean(args) &&\n      typeof args === \"object\" &&\n      !Array.isArray(args) &&\n      typeof args.summary === \"string\" &&\n      args.summary.trim().length > 0 &&\n      (args.notes === undefined || typeof args.notes === \"string\");\n    if (!validCompletion) {\n      return {\n        success: false,\n        output: \"\",\n        error:\n          \"Invalid task_completed payload: summary must be a non-empty string and notes, when present, must be a string.\",\n      };\n    }\n\n    // The operator's acceptance requirements gate completion; a coarse completed plan does not.\n    if (this.objective && (this.depth === 0 || this.role === \"implementer\" || this.role === \"tester\")) {\n      const open = openRequirements(this.objective);\n      const blocked = blockedRequirements(this.objective);\n      if (open.length || blocked.length) {\n        const list = (items: typeof open) => items.map((r) => `${r.id} [${r.status}] ${r.text}${r.note ? ` (${r.note})` : \"\"}${isHardRequirement(r) && r.status === \"implemented\" ? ` (${r.kind}: done only when ${r.verifier && r.verifierSource === \"operator\" ? `its verifier '${r.verifier}' passes after your last change: mark it verified` : \"the operator accepts it\"})` : \"\"}`).join(\"\\n  \");\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a22202-664d-7671-a9c4-ed550c36ebc8","create_time":1795867020.23016}},"metadata":{"history_sequence":142065,"sampled_through_sequence":142062,"client_authored":false,"fallback_token_limit_override":12000}}
