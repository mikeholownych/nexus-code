       try {\n          writeFileDurably(capacityFile, JSON.stringify({ format: \"NEXUS_RESOURCE_ADMISSION\", version: 1, capacity: effectiveCapacity } satisfies CapacityRecord));\n        } catch (error) {\n          releaseFileGuard(slot);\n          slot = null;\n          throw error;\n        }\n      }\n      const held = slot;\n      slot = null;\n      return {\n        ...(inheritSlot ? { inheritedFd: held.fd } : {}),\n        release: () => releaseFileGuard(held),\n      };\n    } finally {\n      if (slot) releaseFileGuard(slot);\n      releaseFileGuard(mutex);\n    }\n  }\n\n  private probeActiveSlots(prefix: string, capacity: number, scope: string, slotLabel: string): number {\n    let active = 0;\n    for (let index = 0; index < capacity; index++) {\n      if (!fs.existsSync(`${prefix}.slot-${index}`)) continue;\n      let probe: FileGuard | null;\n      try {\n        probe = acquireFileGuard(`${prefix}.slot-${index}`, { label: slotLabel });\n      } catch (error) {\n        throw new ResourceAdmissionConflictError(`cannot inspect ${scope} slots: ${(error as Error).message}`);\n      }\n      if (probe) releaseFileGuard(probe);\n      else active++;\n    }\n    return active;\n  }\n}\n/** Kernel-owned file guard shared by upgrade recovery and multi-file state transactions. */\nimport * as fs from \"node:fs\";\nimport { spawnSync } from \"node:child_process\";\n\nexport interface FileGuard { path: string; fd: number }\nconst released = new WeakSet<FileGuard>();\n\nexport interface FileGuardOptions {\n  utility?: string;\n  label?: string;\n  waitMs?: number;\n  mode?: \"exclusive\" | \"shared\";\n}\n\n/** Rejects a guard we do not solely own: wrong type, foreign owner, or permissive mode. */\nfunction validateGuardIdentity(guardPath: string, fd: number, label: string): void {\n  const self = fs.fstatSync(fd);\n  if (!self.isFile()) throw new Error(`${label} is not a regular file`);\n  if (typeof process.getuid === \"function\" && self.uid !== process.getuid()) throw new Error(`${label} is not owned by the running user`);\n  if ((self.mode & 0o077) !== 0) throw new Error(`${label} has unsafe permissions (${(self.mode & 0o777).toString(8)})`);\n  if (self.nlink !== 1) throw new Error(`${label} has unexpected hard links`);\n  const current = fs.lstatSync(guardPath, { throwIfNoEntry: false });\n  if (!current?.isFile() || current.ino !== self.ino || current.dev !== self.dev) throw new Error(`${label} path is redirected`);\n}\n\nfunction openGuardFile(guardPath: string, label: string): number {\n  // Fail closed on platforms without no-follow/non-blocking open support.\n  if (fs.constants.O_NOFOLLOW === undefined || fs.constants.O_NONBLOCK === undefined) {\n    throw new Error(`${label} requires O_NOFOLLOW/O_NONBLOCK open support`);\n  }\n  let fd: number;\n  let created = false;\n  try {\n    // O_CREAT|O_EXCL never follows a symlink, so creation is race-free.\n    fd = fs.openSync(guardPath, fs.constants.O_RDWR | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NONBLOCK, 0o600);\n    created = true;\n  } catch (error: any) {\n    if (error.code !== \"EEXIST\") throw error;\n    try {\n      // The kernel refuses to follow a symlinked path under O_NOFOLLOW (ELOOP)\n      // and O_NONBLOCK prevents any special file from blocking the open, so no\n      // check-to-open race exists; identity is then verified on the descriptor.\n      fd = fs.openSync(guardPath, fs.constants.O_RDWR | fs.constants.O_NONBLOCK | fs.constants.O_NOFOLLOW);\n    } catch (openError: any) {\n      if (openError.code === \"ELOOP\") throw new Error(`${label} path is redirected`);\n      throw openError;\n    }\n  }\n  try { if (created) fs.fchmodSync(fd, 0o600); validateGuardIdentity(guardPath, fd, label); }\n  catch (error) { fs.closeSync(fd); throw error; }\n  return fd;\n}\n\n/**\n * Returns null on contention; every unsuccessful path closes its descriptor.\n * The utility exits immediately after acquiring a lock on the shared open file\n * description. The caller retains that descriptor through its critical section.\n * Never unlink or replace a guard: SIGKILL releases ownership in the kernel.\n */\nexport function acquireFileGuard(guardPath: string, options: FileGuardOptions = {}): FileGuard | null {\n  const label = options.label ?? \"File guard\";\n  const utility = options.utility ?? \"/usr/bin/flock\";\n  const waitMs = options.waitMs ?? 0;\n  if (!Number.isSafeInteger(waitMs) || waitMs < 0) throw new Error(\"Invalid file-guard wait bound\");\n  const fd = openGuardFile(guardPath, label);\n  try {\n    const args = [...(options.mode === \"shared\" ? [\"--shared\"] : []), ...(waitMs ? [\"-w\", String(waitMs / 1000)] : [\"-n\"]), \"-E\", \"75\", \"3\"];\n    const probe = spawnSync(utility, args, { stdio: [\"ignore\", \"ignore\", \"ignore\", fd], timeout: Math.max(2000, waitMs + 1000) });\n    if (probe.error) throw new Error(`${label} utility ${utility} is unavailable: ${probe.error.message}`);\n    if (probe.status === 0) { validateGuardIdentity(guardPath, fd, label); return { path: guardPath, fd }; }\n    if (probe.status === 75) { fs.closeSync(fd); return null; }\n    throw new Error(`${label} acquisition failed (exit ${probe.status})`);\n  } catch (error) {\n    try { fs.closeSync(fd); } catch {}\n    throw error;\n  }\n}\n\nexport function releaseFileGuard(guard: FileGuard | null): void {\n  if (!guard || released.has(guard)) return;\n  released.add(guard);\n  try { fs.closeSync(guard.fd); } catch {}\n}\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\n\n// Global test setup for HOME and state directory isolation (REQ-PER-103, ACC-PER-03, PLAN-08 Task 1).\nconst realHome = process.env.NEXUS_TEST_REAL_HOME || os.homedir();\nif (!process.env.NEXUS_TEST_REAL_HOME) {\n  process.env.NEXUS_TEST_REAL_HOME = realHome;\n}\n\nif (!process.env.HOME || path.resolve(process.env.HOME) === path.resolve(realHome)) {\n  const isolatedHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-test-home-\"));\n  process.env.HOME = isolatedHome;\n  process.env.XDG_CONFIG_HOME = path.join(isolatedHome, \".config\");\n  process.env.XDG_DATA_HOME = path.join(isolatedHome, \".local\", \"share\");\n  process.env.XDG_STATE_HOME = path.join(isolatedHome, \".local\", \"state\");\n  process.env.XDG_CACHE_HOME = path.join(isolatedHome, \".cache\");\n  process.env.NEXUS_STATE_DIR = path.join(isolatedHome, \".nexus\");\n}\n/**\n * Leak and hang guard: `import \"./helpers/leak_guard.js\";` at the top of a test file fails the file in teardown, naming\n * every RustCoreBridge or AutonomousAgent not shut down, scripted gateway not closed, child process still running and\n * timer still pending, then releases them so the process can exit instead of hanging the job.\n * Resources it cannot see by itself (a custom server) can be registered with `trackResource`.\n * Timers: ref'd timeouts above the count when the file finished loading (a timer created while the file loads is not\n * counted; node:test's own timers are gone by teardown). The check hook is registered once the file has finished\n * loading, so it runs after the file's own `after` hooks; a file that registers hooks after a top-level `await` can run\n * its hooks after the guard's check, and should then release in the test itself.\n */\nimport { after } from \"node:test\";\nimport childProcess from \"node:child_process\";\nimport { RustCoreBridge } from \"../../src/tools.js\";\nimport { survivors, trackResource, clearTracked } from \"./leak_registry.js\";\n\nexport { trackResource };\n\nconst proto = childProcess.ChildProcess.prototype as any;\nconst originalSpawn = proto.spawn;\nproto.spawn = function (this: childProcess.ChildProcess, ...args: unknown[]) {\n  const result = originalSpawn.apply(this, args);\n  const command = [String((this as any).spawnfile ?? \"\"), ...((this as any).spawnargs ?? []).slice(1)].join(\" \").slice(0, 120);\n  trackResource(\"child process\",