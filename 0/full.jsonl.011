{"timestamp":"2026-11-28T11:21:29.765Z","ordinal":321927,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a22143-fcf9-7462-927e-e66d27ee2285","item":{"type":"CommandExecution","id":"exec-db280524-cf93-46df-9eaa-85014b2b7114","process_id":"60629","command":["/usr/bin/zsh","-lc","rg -n -C 2 'Run one shard of the CLI suite with a hang bound|timeout-minutes' .github/workflows/ci.yml"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"search","cmd":"rg -n -C 2 'Run one shard of the CLI suite with a hang bound|timeout-minutes' .github/workflows/ci.yml","query":"Run one shard of the CLI suite with a hang bound|timeout-minutes","path":"ci.yml"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"22-  test-gates:\n23-    runs-on: ubuntu-22.04\n24:    timeout-minutes: 40\n25-    strategy:\n26-      fail-fast: false\n--\n103-  test-shard:\n104-    runs-on: ubuntu-22.04\n105:    timeout-minutes: 50\n106-    strategy:\n107-      fail-fast: false # a failing leg must not hide the failures of the others\n--\n198-          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n199-          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n200:      - name: Run one shard of the CLI suite with a hang bound\n201-        # The whole suite took 32-34 minutes in one job, so a quarter of it must not need 30; a hung test process\n202-        # must fail the leg, not hold it until the job timeout. The four shards are disjoint and together are every\n203-        # test file (cli/scripts/test_shards.mjs); inside the leg the files run in two processes, as they always did.\n204:        timeout-minutes: 30\n205-        shell: bash\n206-        run: |\n--\n226-    if: ${{ always() }}\n227-    runs-on: ubuntu-22.04\n228:    timeout-minutes: 5\n229-    strategy:\n230-      fail-fast: false\n--\n244-  linux-x86_64:\n245-    runs-on: ubuntu-22.04\n246:    timeout-minutes: 120\n247-    env:\n248-      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n--\n346-    name: diff coverage (advisory)\n347-    runs-on: ubuntu-22.04\n348:    timeout-minutes: 30\n349-    steps:\n350-      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n--\n361-      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core\n362-      - name: T0 coverage (unit tier)\n363:        timeout-minutes: 15\n364-        run: node cli/scripts/run_coverage.mjs --tier=unit --out cli/coverage/unit-lcov.info\n365-      - name: Resolve the base of the changed-file gates\n","exit_code":0,"duration":{"secs":0,"nanos":34235}},"started_at_ms":1795864889764,"completed_at_ms":1795864889765}}
