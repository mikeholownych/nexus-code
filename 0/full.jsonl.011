 \"rustc\"), 0o755);\n   586\t  fs.symlinkSync(fakeSymlinkTarget, path.join(fakeSystem, \"compiler-reach\"));\n   587\t  fs.symlinkSync(path.join(fakeSymlinkTarget, \"rustc\"), path.join(fakeSystem, \"bin\", \"rustc-alias\"));\n   588\t  fs.symlinkSync(fakeSystem, fakeSystemAlias, \"dir\");\n   589\t  t.after(() => {\n   590\t    fs.rmSync(fakeSystem, { recursive: true, force: true });\n   591\t    fs.rmSync(batchedSystem, { recursive: true, force: true });\n   592\t    fs.rmSync(manyRootsSystem, { recursive: true, force: true });\n   593\t    fs.rmSync(changingSystem, { recursive: true, force: true });\n   594\t    fs.rmSync(disappearingSystem, { recursive: true, force: true });\n   595\t    fs.rmSync(fakeSystemAlias, { recursive: true, force: true });\n   596\t    fs.rmSync(fakeAlternatives, { recursive: true, force: true });\n   597\t    fs.rmSync(fakeSymlinkTarget, { recursive: true, force: true });\n   598\t    fs.rmSync(fakeMountedRuntime, { recursive: true, force: true });\n   599\t    fs.rmSync(fakeApprovedToolchain, { recursive: true, force: true });\n   600\t  });\n   601\t  // Keep the compiler under the 65th depth-3 subtree so this catches dropped later batches.\n   602\t  const batchedChildren = Array.from({ length: 65 }, (_, index) => {\n   603\t    const child = path.join(batchedSystem, `child-${String(index).padStart(2, \"0\")}`);\n   604\t    const scanDirectory = path.join(child, \"scan-subtree\", \"deep\");\n   605\t    fs.mkdirSync(scanDirectory, { recursive: true });\n   606\t    return scanDirectory;\n   607\t  });\n   608\t  const batchedRootEntries = spawnSync(\"/usr/bin/find\", [\"-P\", batchedSystem, \"-mindepth\", \"3\", \"-maxdepth\", \"3\", \"-type\", \"d\", \"-print0\"], { encoding: \"buffer\" });\n   609\t  assert.equal(batchedRootEntries.status, 0, \"the fixture can enumerate the bounded directory batches\");\n   610\t  const orderedBatchedChildren = batchedRootEntries.stdout.toString(\"utf8\").split(\"\\0\").filter(Boolean);\n   611\t  assert.equal(orderedBatchedChildren.length, batchedChildren.length);\n   612\t  const lateBatchedCompiler = path.join(orderedBatchedChildren.at(-1), \"rustc\");\n   613\t  fs.writeFileSync(lateBatchedCompiler, compilerCanary);\n   614\t  fs.chmodSync(lateBatchedCompiler, 0o755);\n   615\t  const batchedExposure = scanOracleCompilerExposure([batchedSystem], [], []);\n   616\t  assert.equal(batchedExposure.problem, null);\n   617\t  assert.ok(batchedExposure.paths.includes(lateBatchedCompiler), \"compiler binaries in later sibling batches remain discoverable and maskable\");\n   618\t  const manyRoots = Array.from({ length: 129 }, (_, index) => {\n   619\t    const root = path.join(manyRootsSystem, `root-${String(index).padStart(3, \"0\")}`);\n   620\t    fs.mkdirSync(root);\n   621\t    return root;\n   622\t  });\n   623\t  const lateRootCompiler = path.join(manyRoots.at(-1), \"rustc\");\n   624\t  fs.writeFileSync(lateRootCompiler, compilerCanary);\n   625\t  fs.chmodSync(lateRootCompiler, 0o755);\n   626\t  const manyRootsExposure = scanOracleCompilerExposure(manyRoots, [], []);\n   627\t  assert.equal(manyRootsExposure.problem, null, \"more than 128 disjoint system roots stay within the bounded scanner input contract\");\n   628\t  assert.ok(manyRootsExposure.paths.includes(lateRootCompiler), \"a compiler in the final root remains discoverable when the root list exceeds 128\");\n   629\t  assert.deepEqual(scanOracleCompilerExposure([changingSystem], [], []), { paths: [], problem: null }, \"an initially clean mounted system has no compiler masks\");\n   630\t  const introducedCompiler = path.join(changingSystem, \"go\");\n   631\t  fs.writeFileSync(introducedCompiler, compilerCanary);\n   632\t  fs.chmodSync(introducedCompiler, 0o755);\n   633\t  const changedScan = scanOracleCompilerExposure([changingSystem], [], []);\n   634\t  assert.equal(changedScan.problem, null);\n   635\t  assert.ok(changedScan.paths.includes(introducedCompiler), \"compiler exposure is rescanned after filesystem changes\");\n   636\t  assert.deepEqual(compilerExposureMaskArgs(changedScan), [\"--ro-bind\", \"/dev/null\", introducedCompiler], \"the discovered compiler is converted to an actual sandbox mask\");\n   637\t  const mutableFs = fs as unknown as { lstatSync: (...args: unknown[]) => unknown };\n   638\t  const originalLstatSync = mutableFs.lstatSync;\n   639\t  const callOriginalLstatSync = originalLstatSync.bind(fs);\n   640\t  let disappearedDuringInspection = false;\n   641\t  mutableFs.lstatSync = (...args) => {\n   642\t    if (args[0] === disappearingCompiler && !disappearedDuringInspection) {\n   643\t      disappearedDuringInspection = true;\n   644\t      fs.unlinkSync(disappearingCompiler);\n   645\t    }\ncli/test/acp_review_fixes.test.ts\ncli/test/agent_terminal_controls.test.ts\ncli/test/cli_option_precedence.test.ts\ncli/test/code_evaluators.test.ts\ncli/test/context_convergence.test.ts\ncli/test/convergence_invariants.test.ts\ncli/test/doctor.test.ts\ncli/test/durable_continuity.test.ts\ncli/test/embed_example.test.ts\ncli/test/eval_cli.test.ts\ncli/test/eval_dataset.test.ts\ncli/test/eval_hardened.test.ts\ncli/test/eval_harness.test.ts\ncli/test/eval_integrity.test.ts\ncli/test/eval_t3.test.ts\ncli/test/eval_version_probe_storage.test.ts\ncli/test/examples.test.ts\ncli/test/fault_kill_mid_tool_call.test.ts\ncli/test/fetch_web_ssrf.test.ts\ncli/test/file_guard.test.ts\ncli/test/goal_driver_identity.test.ts\ncli/test/hooks_self_approval.test.ts\ncli/test/inference_transport.test.ts\ncli/test/leak_guard.test.ts\ncli/test/lib_entry.test.ts\ncli/test/lsp_lifecycle.test.ts\ncli/test/mcp_verify.test.ts\ncli/test/oauth_shared_refresh.test.ts\ncli/test/operation_account_identity.test.ts\ncli/test/operation_lock.test.ts\ncli/test/operation_lock_start_ticks.test.ts\ncli/test/operation_release_acceptance.test.ts\ncli/test/operation_release_review.test.ts\ncli/test/operation_resource_admission.test.ts\ncli/test/p10_process_crash_recovery