{"timestamp":"2026-11-28T07:59:44.693Z","ordinal":317008,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a22128-3667-7142-a098-5707fbe8c197","item":{"type":"CommandExecution","id":"exec-0b7ec16a-8634-4df2-a08f-71cf51f3f050","process_id":"65472","command":["/usr/bin/zsh","-lc","sed -n '1,260p' cli/test/p10_process_crash_recovery.test.ts && sed -n '1,260p' cli/test/p10_provider_crash_recovery.test.ts && sed -n '1,240p' cli/test/p10_operation_journal_fail_closed.test.ts && sed -n '1,220p' docs/XERJ_REFERENCE_CODING.md && find \"$(git rev-parse --git-common-dir)/nexus-claims\" -maxdepth 1 -type d -printf '%f\\n' | rg 'P10_02|FILE_cli_test_p10_process_crash|FILE_cli_test_p10_operation' | sort"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"sed -n '1,260p' cli/test/p10_process_crash_recovery.test.ts && sed -n '1,260p' cli/test/p10_provider_crash_recovery.test.ts && sed -n '1,240p' cli/test/p10_operation_journal_fail_closed.test.ts && sed -n '1,220p' docs/XERJ_REFERENCE_CODING.md && find \"$(git rev-parse --git-common-dir)/nexus-claims\" -maxdepth 1 -type d -printf '%f\\n' | rg 'P10_02|FILE_cli_test_p10_process_crash|FILE_cli_test_p10_operation' | sort"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import \"./helpers/leak_guard.js\";\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { makeRepo, startGateway } from \"./helpers/fixtures.js\";\nimport { trackResource } from \"./helpers/leak_guard.js\";\n\nfunction delay(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nasync function waitFor(description: string, check: () => boolean, timeoutMs = 10_000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (Date.now() < deadline) {\n    if (check()) return;\n    await delay(20);\n  }\n  assert.fail(`timed out waiting for ${description}`);\n}\n\nasync function recoverAfterProcessCrash(includeCompletedSibling: boolean): Promise<{ effects: string; toolResults: string[] }> {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-p10-crash-\"));\n  const home = path.join(root, \"home\");\n  fs.mkdirSync(home, { recursive: true });\n  const previous = { home: process.env.HOME, xdg: process.env.XDG_CONFIG_HOME };\n  process.env.HOME = home;\n  process.env.XDG_CONFIG_HOME = path.join(home, \".config\");\n  const repo = makeRepo({ \"README.md\": \"base\\n\" });\n  const counter = path.join(root, \"effects.txt\");\n  const commandPidFile = path.join(root, \"command.pid\");\n  const taskIdFile = path.join(root, \"task-id.txt\");\n  const completedCall = { name: \"run_command\", args: { command: `printf 'completed\\\\n' >> '${counter}'; printf 'completed\\\\n'` } };\n  const pendingLabel = includeCompletedSibling ? \"pending\" : \"ran\";\n  const pendingCommand = `printf '%s\\\\n' \"$$\" > '${commandPidFile}'; printf '${pendingLabel}\\\\n' >> '${counter}'; if [ \"$(wc -l < '${counter}')\" -gt ${includeCompletedSibling ? 2 : 1} ]; then exit 0; fi; exec sleep 60`;\n  const pendingCall = { name: \"run_command\", args: { command: pendingCommand, timeout_secs: 120 } };\n  const initialCalls = includeCompletedSibling ? [completedCall, pendingCall] : [pendingCall];\n  const gateway = await startGateway((n) => n === 1\n    ? { kind: \"tools\", calls: initialCalls }\n    : { kind: \"text\", content: \"done\" });\n  const previousCwd = process.cwd();\n  const cliRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n  let child: ReturnType<typeof spawn> | undefined;\n  let resumed: AutonomousAgent | undefined;\n  let commandPid: number | undefined;\n\n  try {\n    const childScript = `\n      import fs from \"node:fs\";\n      import { AutonomousAgent } from \"./src/agent.ts\";\n      const agent = new AutonomousAgent({ endpoint: process.env.TEST_GATEWAY, model: \"m\", maxSteps: 6, temperature: 0, workspace: process.env.TEST_WORKSPACE, shell: \"bash\", approvalMode: \"auto\", fullAccess: true }, 1, undefined, { durable: true });\n      agent.ui = new Proxy({}, { get: () => () => {} });\n      fs.writeFileSync(process.env.TEST_TASK_ID_FILE, agent.getTaskId());\n      await agent.runTurn(\"Run the command and report its result.\");\n      process.exit(0);\n    `;\n    child = spawn(process.execPath, [\"--import\", \"tsx\", \"--input-type=module\", \"-e\", childScript], {\n      cwd: cliRoot,\n      env: {\n        PATH: process.env.PATH,\n        HOME: home,\n        XDG_CONFIG_HOME: path.join(home, \".config\"),\n        TEST_GATEWAY: gateway.url,\n        TEST_WORKSPACE: repo,\n        TEST_TASK_ID_FILE: taskIdFile,\n      },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    trackResource(\"child process\", `crash fixture agent pid ${child.pid}`, () => child?.exitCode === null && child?.signalCode === null, () => child?.kill(\"SIGKILL\"));\n    let childOutput = \"\";\n    child.stdout?.on(\"data\", (chunk) => { childOutput += String(chunk); });\n    child.stderr?.on(\"data\", (chunk) => { childOutput += String(chunk); });\n    const childExit = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => {\n      child!.once(\"exit\", (code, signal) => resolve({ code, signal }));\n    });\n\n    await waitFor(\"the child task id\", () => fs.existsSync(taskIdFile));\n    await waitFor(\"the first provider request\", () => gateway.requests.length >= 1);\n    await waitFor(\"the side effect and running command pid\", () => fs.existsSync(counter) && fs.existsSync(commandPidFile));\n    commandPid = Number(fs.readFileSync(commandPidFile, \"utf8\").trim());\n    assert.ok(Number.isSafeInteger(commandPid) && commandPid > 1, \"fixture recorded its own command pid\");\n    assert.equal(fs.readFileSync(counter, \"utf8\"), includeCompletedSibling ? \"completed\\npending\\n\" : \"ran\\n\");\n\n    child.kill(\"SIGKILL\");\n    const killed = await childExit;\n    assert.equal(killed.signal, \"SIGKILL\", `child ended unexpectedly: ${JSON.stringify(killed)} ${childOutput}`);\n    try { process.kill(commandPid, \"SIGKILL\"); } catch (error) {\n      if ((error as NodeJS.ErrnoException).code !== \"ESRCH\") throw error;\n    }\n\n    const taskId = fs.readFileSync(taskIdFile, \"utf8\").trim();\n    resumed = new AutonomousAgent({ endpoint: gateway.url, model: \"m\", maxSteps: 6, temperature: 0, workspace: repo, shell: \"bash\", approvalMode: \"auto\", fullAccess: true } as any, 1, undefined, { durable: true });\n    resumed.ui = new Proxy({}, { get: () => () => {} });\n    const recovery = await resumed.recoverFromTaskState(taskId);\n    assert.equal(recovery.interrupted, true, \"restart identifies the durable operation left in flight\");\n    await resumed.runTurn(\"Continue.\", undefined, { resume: true });\n\n    const effects = fs.readFileSync(counter, \"utf8\");\n    const toolResults = gateway.requests.flatMap((request: any) => request.messages ?? [])\n      .filter((message: any) => message.role === \"tool\")\n      .map((message: any) => String(message.content));\n    return { effects, toolResults };\n  } finally {\n    if (child && child.exitCode === null && child.signalCode === null) child.kill(\"SIGKILL\");\n    const recordedPid = commandPid ?? (fs.existsSync(commandPidFile) ? Number(fs.readFileSync(commandPidFile, \"utf8\").trim()) : undefined);\n    if (Number.isSafeInteger(recordedPid) && recordedPid! > 1) {\n      try { process.kill(recordedPid!, \"SIGKILL\"); } catch (error) {\n        if ((error as NodeJS.ErrnoException).code !== \"ESRCH\") throw error;\n      }\n    }\n    resumed?.shutdown();\n    await gateway.close();\n    process.chdir(previousCwd);\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(root, { recursive: true, force: true });\n    if (previous.home === undefined) delete process.env.HOME; else process.env.HOME = previous.home;\n    if (previous.xdg === undefined) delete process.env.XDG_CONFIG_HOME; else process.env.XDG_CONFIG_HOME = previous.xdg;\n  }\n}\n\ntest(\"a real process crash after a tool side effect does not silently replay the call\", async () => {\n  const { effects, toolResults } = await recoverAfterProcessCrash(false);\n  assert.equal(effects, \"ran\\n\", \"the side effect was not repeated after recovery\");\n  assert.ok(toolResults.some((content) => /effects, if any, are unknown/.test(content)), JSON.stringify(toolResults));\n});\n\ntest(\"a crash during a multi-tool response preserves a completed sibling and does not replay the unknown sibling\", async () => {\n  const { effects, toolResults } = await recoverAfterProcessCrash(true);\n  assert.equal(effects, \"completed\\npending\\n\", \"the completed sibling remains once and the unknown sibling is not repeated\");\n  assert.ok(toolResults.some((content) => content.includes(\"completed\")), JSON.stringify(toolResults));\n  assert.ok(toolResults.some((content) => /effects, if any, are unknown/.test(content)), JSON.stringify(toolResults));\n});\nimport \"./helpers/leak_guard.js\";\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport http from \"node:http\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { makeRepo } from \"./helpers/fixtures.js\";\nimport { trackResource } from \"./helpers/leak_guard.js\";\n\nfunction delay(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nasync function waitFor(description: string, check: () => boolean, timeoutMs = 10_000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (Date.now() < deadline) {\n    if (check()) return;\n    await delay(20);\n  }\n  assert.fail(`timed out waiting for ${description}`);\n}\n\ntest(\"a provider request with a lost response is recorded as unknown after process-crash resume\", { timeout: 60_000 }, async (t) => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-p10-provider-crash-\"));\n  const home = path.join(root, \"home\");\n  const repo = makeRepo({ \"README.md\": \"base\\n\" });\n  const taskIdFile = path.join(root, \"task-id.txt\");\n  const resultFile = path.join(root, \"resume-result.json\");\n  fs.mkdirSync(home, { recursive: true });\n\n  const requests: unknown[] = [];\n  const sockets = new Set<import(\"node:net\").Socket>();\n  const server = http.createServer((req, res) => {\n    if (req.url?.endsWith(\"/models\")) {\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ data: [{ id: \"m\" }] }));\n      return;\n    }\n    let raw = \"\";\n    req.on(\"data\", (chunk) => { raw += String(chunk); });\n    req.on(\"end\", () => {\n      if (req.url?.endsWith(\"/chat/completions\")) {\n        try { requests.push(JSON.parse(raw)); } catch { requests.push(raw); }\n        // The first response is lost when Nexus is killed; a later request gets a deterministic answer.\n        if (requests.length > 1) {\n          res.setHeader(\"content-type\", \"application/json\");\n          res.end(JSON.stringify({ id: \"response-2\", choices: [{ index: 0, message: { role: \"assistant\", content: \"done\" }, finish_reason: \"stop\" }], usage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 } }));\n        }\n        return;\n      }\n      res.statusCode = 404;\n      res.end(\"not found\");\n    });\n  });\n  server.on(\"connection\", (socket) => {\n    sockets.add(socket);\n    socket.on(\"close\", () => sockets.delete(socket));\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const endpoint = `http://127.0.0.1:${(server.address() as import(\"node:net\").AddressInfo).port}/v1`;\n  const closeServer = async () => {\n    for (const socket of sockets) socket.destroy();\n    await new Promise<void>((resolve) => server.close(() => resolve()));\n  };\n  trackResource(\"gateway\", \"provider crash fixture server not closed\", () => server.listening, () => closeServer());\n\n  const previousCwd = process.cwd();\n  const cliRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n  const childEnv = {\n    PATH: process.env.PATH,\n    HOME: home,\n    XDG_CONFIG_HOME: path.join(home, \".config\"),\n    TEST_GATEWAY: endpoint,\n    TEST_WORKSPACE: repo,\n    TEST_TASK_ID_FILE: taskIdFile,\n    TEST_RESULT_FILE: resultFile,\n  };\n  let first: ReturnType<typeof spawn> | undefined;\n  let resumed: ReturnType<typeof spawn> | undefined;\n  const stop = async (child: ReturnType<typeof spawn> | undefined): Promise<void> => {\n    if (!child || child.exitCode !== null || child.signalCode !== null) return;\n    child.kill(\"SIGKILL\");\n    await new Promise<void>((resolve) => child.once(\"exit\", () => resolve()));\n  };\n\n  try {\n    const firstScript = `\n      import fs from \"node:fs\";\n      import { AutonomousAgent } from \"./src/agent.ts\";\n      import { DEFAULT_CONTINUATION } from \"./src/types.ts\";\n      const agent = new AutonomousAgent({ endpoint: process.env.TEST_GATEWAY, model: \"m\", maxSteps: 2, maxInferenceSubmissions: 5, continuation: { ...DEFAULT_CONTINUATION, maxInferenceSubmissions: 5 }, temperature: 0, workspace: process.env.TEST_WORKSPACE, shell: \"bash\", approvalMode: \"auto\", fullAccess: true }, 1, undefined, { durable: true });\n      agent.ui = new Proxy({}, { get: () => () => {} });\n      fs.writeFileSync(process.env.TEST_TASK_ID_FILE, agent.getTaskId());\n      await agent.runTurn(\"Continue the task.\");\n      process.exit(0);\n    `;\n    first = spawn(process.execPath, [\"--import\", \"tsx\", \"--input-type=module\", \"-e\", firstScript], {\n      cwd: cliRoot,\n      env: childEnv,\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    trackResource(\"child process\", `provider crash fixture agent pid ${first.pid}`, () => first?.exitCode === null && first?.signalCode === null, () => first?.kill(\"SIGKILL\"));\n    let firstOutput = \"\";\n    first.stdout?.on(\"data\", (chunk) => { firstOutput += String(chunk); });\n    first.stderr?.on(\"data\", (chunk) => { firstOutput += String(chunk); });\n    const firstExit = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => first!.once(\"exit\", (code, signal) => resolve({ code, signal })));\n\n    try {\n      await waitFor(\"the durable task id\", () => fs.existsSync(taskIdFile), 30_000);\n    } catch (error) {\n      assert.fail(`${error instanceof Error ? error.message : String(error)}\\nfirst process output:\\n${firstOutput}`);\n    }\n    try {\n      await waitFor(\"the pending provider request or first-process exit\", () => requests.length === 1 || first!.exitCode !== null || first!.signalCode !== null, 30_000);\n      assert.equal(requests.length, 1, `first process ended before reaching the provider: exit=${first?.exitCode} signal=${first?.signalCode}\\n${firstOutput}`);\n    } catch (error) {\n      assert.fail(`${error instanceof Error ? error.message : String(error)}\\nfirst process output:\\n${firstOutput}`);\n    }\n    assert.equal(fs.readFileSync(taskIdFile, \"utf8\").length > 0, true);\n    first.kill(\"SIGKILL\");\n    const killed = await firstExit;\n    assert.equal(killed.signal, \"SIGKILL\", `first process ended unexpectedly: ${JSON.stringify(killed)} ${firstOutput}`);\n\n    const resumeScript = `\n      import fs from \"node:fs\";\n      import { AutonomousAgent } from \"./src/agent.ts\";\n      import { DEFAULT_CONTINUATION } from \"./src/types.ts\";\n      const agent = new AutonomousAgent({ endpoint: process.env.TEST_GATEWAY, model: \"m\", maxSteps: 2, maxInferenceSubmissions: 5, continuation: { ...DEFAULT_CONTINUATION, maxInferenceSubmissions: 5 }, temperature: 0, workspace: process.env.TEST_WORKSPACE, shell: \"bash\", approvalMode: \"auto\", fullAccess: true }, 1, undefined, { durable: true });\n      agent.ui = new Proxy({}, { get: () => () => {} });\n      const taskId = fs.readFileSync(process.env.TEST_TASK_ID_FILE, \"utf8\").trim();\n      const recovery = await agent.recoverFromTaskState(taskId);\n      const result = await agent.runTurn(\"\", undefined, { resume: true });\n      fs.writeFileSync(process.env.TEST_RESULT_FILE, JSON.stringify({ recovery, result, execution: agent.getObjective()?.execution }));\n      agent.shutdown();\n    `;\n    resumed = spawn(process.execPath, [\"--import\", \"tsx\", \"--input-type=module\", \"-e\", resumeScript], {\n      cwd: cliRoot,\n      env: childEnv,\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    trackResource(\"child process\", `provider resume fixture agent pid ${resumed.pid}`, () => resumed?.exitCode === null && resumed?.signalCode === null, () => resumed?.kill(\"SIGKILL\"));\n    let resumeOutput = \"\";\n    resumed.stdout?.on(\"data\", (chunk) => { resumeOutput += String(chunk); });\n    resumed.stderr?.on(\"data\", (chunk) => { resumeOutput += String(chunk); });\n    const resumedExit = await new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => resumed!.once(\"exit\", (code, signal) => resolve({ code, signal })));\n    assert.deepEqual(resumedExit, { code: 0, signal: null }, resumeOutput);\n    assert.ok(fs.existsSync(resultFile), `resume result was not written: ${resumeOutput}`);\n    const resumedState = JSON.parse(fs.readFileSync(resultFile, \"utf8\"));\n    assert.equal(resumedState.execution.inferenceSubmissions, requests.length, \"every provider submission remains charged after restart\");\n    assert.equal(resumedState.execution.maxInferenceSubmissions, 5, \"resume preserves the saved request ceiling\");\n    assert.equal(resumedState.execution.inferenceOutcomeUnknowns, 1, \"the lost provider response is durably reported as unknown\");\n    assert.ok(requests.length > 1, \"resume can submit again when the persisted allowance still has capacity\");\n  } finally {\n    await stop(first);\n    await stop(resumed);\n    await closeServer();\n    process.chdir(previousCwd);\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { test } from \"node:test\";\nimport \"./helpers/leak_guard.js\";\nimport { makeAgent, makeWorld } from \"./helpers/tool_characterization.js\";\nimport { startGateway } from \"./helpers/fixtures.js\";\n\ntest(\"a mutating tool is not dispatched when its durable start journal cannot be written\", async (t) => {\n  const world = makeWorld();\n  t.after(() => world.close());\n  const gateway = await startGateway(() => ({\n    kind: \"tools\",\n    calls: [{ name: \"write_file\", args: { path: \"journal-failure.txt\", content: \"must not be written\\n\" } }],\n  }));\n  t.after(() => gateway.close());\n\n  const agent = makeAgent(world, {\n    mode: \"auto\",\n    fullAccess: true,\n    config: { endpoint: gateway.url, maxSteps: 1 },\n  });\n  const stateManager = agent.getStateManager();\n  let starts = 0;\n  stateManager.recordOperationStart = (() => {\n    starts++;\n    throw new Error(\"injected durable start-journal failure\");\n  }) as typeof stateManager.recordOperationStart;\n\n  const result = await agent.runTurn(\"Write journal-failure.txt\");\n\n  assert.equal(starts, 1, \"the durable start boundary was reached exactly once\");\n  assert.equal(gateway.requests.length, 1, \"the model requested one tool call\");\n  const activeWorktree = agent.getActiveWorktree();\n  assert.equal(\n    [world.repo, ...(activeWorktree ? [activeWorktree.worktreePath] : [])]\n      .some((root) => fs.existsSync(path.join(root, \"journal-failure.txt\"))),\n    false,\n    \"no mutating handler runs without its durable start record\",\n  );\n  assert.equal(result.persistence?.durable, false);\n  assert.ok(result.persistence?.failures.some((failure) => failure.includes(\"operation_start\")));\n});\n# Reference coding with XERJ\n\nThe detail behind the \"Reference coding\" rule in `AGENTS.md`: how to reach the local XERJ node, what to query, and what to leave alone.\n\n- Before non-trivial code with a peer-project analogue (feature, protocol, parser, worktree or provider handling, tool, test harness), query the local XERJ node and record what you took, borrowed or rejected in the PR's \"Reference coding\" section. Exempt: trivial edits, doc-only changes, fixes fully specified by a failing test.\n- XERJ is an owner-host tool, not a project dependency (`docs/v1.1.0/DECISIONS.md` §1). Where it is unavailable (contributor machine, CI), write \"XERJ unavailable: <reason>\" in that section and use `git grep` plus the peer's public source.\n- The node is the user service `xerj` on `http://localhost:9200`; confirm with `systemctl --user is-active xerj` and use that node. Stop a hub with `xerj hub stop`.\n- Corpora: `xerj corpus list`. Retrieval is lexical (BM25), so query with identifiers and words from the code: `xerj code <corpus> \"<words>\" -k 4 --full 600`, `xerj search --prefix <index-prefix> \"<words>\" -k 4`, `xerj def --prefix <prefix> \"<symbol>\"`. The first query can take over a minute; set a timeout.\n- `nexus-cli`, `nexus-core`, `nexus-test`, `nexus-docs` index `origin/main` only (hourly), so open PRs are absent: use `git grep` on your branch.\n- Reference code is read-only inspiration. Follow each result's licence tag; copy verbatim only permissively licensed code, with a citation. Keep XERJ and reference corpora away from held-out evaluation tasks (`docs/v1.0.0/CONCURRENCY.md`). Keep document text local (`rerank` sends it to a third party). Leave indices you did not create alone.\n- After real use: `xerj feedback --dry-run`, then `xerj feedback --submit --agent \"<model>\" --used-for \"<task>\" --verdict \"<what worked and what did not>\"`, with secrets and private data left out.\nFILE_cli_test_p10_operation_active_budget.test.ts.released-20261125T161655Z-pr823-merged\nFILE_cli_test_p10_operation_inference_budget.test.ts.released-20261126T11-pr869-pr870-postmerge\nFILE_cli_test_p10_operation_inference_budget.test.ts.released-20261126T195129Z-pr880-merged\nFILE_cli_test_p10_operation_inference_budget.test.ts.released-20261127T1300Z-pr901-merged-ci\nFILE_cli_test_p10_operation_journal_fail_closed.test.ts.released-20261128T011343Z-pr924-postmerge-ci\nFILE_cli_test_p10_operation_token_admission.test.ts.released-20261126T231636Z-pr883-postmerge-ci\nFILE_cli_test_p10_operation_token_admission.test.ts.released-20261127T004111Z-pr885-postmerge-ci\nFILE_cli_test_p10_operation_token_admission.test.ts.released-20261127T1300Z-pr901-merged-ci\nFILE_cli_test_p10_operation_token_budget.test.ts.reconciled-20261126T235214Z-scope-adjustment\nFILE_cli_test_p10_operation_token_reporting.test.ts.released-20261126T195129Z-pr880-merged\nFILE_cli_test_p10_operation_token_reporting.test.ts.released-20261128T015510Z-reconciled-merged\nFILE_cli_test_p10_process_crash_recovery.test.ts.released-20261127T-p10-03-takeover\nFILE_cli_test_p10_process_crash_recovery.test.ts.released-20261127T055606Z-pr894-postmerge-ci\nP10_02_CRASH_MATRIX.released-20261127T-p10-03-takeover\nP10_02_CRASH_MATRIX_NEXT.released-20261127T055606Z-pr894-postmerge-ci\nP10_02_INFERENCE_SCOPE_DOCS.released-20261124T024335Z-pr765\nP10_02_MAIN_CRASH_EVIDENCE_FORWARDPORT.released-20261127T065746Z-pr896-postmerge-ci\nP10_02_MERGED_EVIDENCE.released-20261127T2151Z-pr921-postmerge-ci\nP10_02_PER_TOOL_MERGED_EVIDENCE.released-20261127T232834Z-pr923-postmerge-ci-codeql\nP10_02_PER_TOOL_RPC_DEADLINES.released-20261127T230143Z-pr922-postmerge-ci-codeql\nP10_02_PROVIDER_CRASH_ACCOUNTING.released-20261127T063115Z-pr895-postmerge-ci\nWP_P10_02_CRASH_EVIDENCE_DOCS.released-20261127T075558Z-pr899-postmerge-ci\nWP_P10_02_DURABLE_BUDGET.released-20261119-rd7\nWP_P10_02_DURABLE_EFFECT_JOURNAL_FAIL_CLOSED.released-20261128T011343Z-pr924-postmerge-ci\nWP_P10_02_HARD_TOKEN_RESERVATION.released-20261126T231636Z-pr883-postmerge-ci\nWP_P10_02_OBJECTIVE_ELAPSED_BUDGET.released-20261124T1030Z-pr774-merged\nWP_P10_02_OPERATION_INFERENCE_ADMISSION.released-20261126T11-pr869-pr870-postmerge\nWP_P10_02_PLUGIN_EXECUTION_BOUNDARY.released-20261128T024240Z-pr928-docs\nWP_P10_02_POSTMERGE_DOC_EVIDENCE.released-20261128T014209Z-pr926-postmerge-ci\nWP_P10_02_PROGRESS_RECONCILIATION.released-20261125-pr821-merged\nWP_P10_02_PROVIDER_ENFORCED_OUTPUT_CEILING.released-20261127T004111Z-pr885-postmerge-ci\nWP_P10_02_PROVIDER_OUTCOME_FOLLOWUP.released-20261127T1300Z-pr901-merged-ci\nWP_P10_02_RPC_TIMEOUT_WORKER_TERMINATION.released-20261126T060322Z-pr862-postmerge-ci\nWP_P10_02_SHARED_REQUEST_ADMISSION.released-20261126T021315Z-pr857-postmerge-ci\nWP_P10_02_TOOL_TIMEOUT_BOUND.released-20261126T0642Z-pr864-postmerge-ci\n","exit_code":0,"duration":{"secs":0,"nanos":31645}},"started_at_ms":1795852784692,"completed_at_ms":1795852784693}}
{"timestamp":"2026-11-28T07:59:44.746Z","ordinal":317009,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a2212a-d46a-71f2-8e17-adb3b1ef982c","call_id":"call_0df0541cdfef451a8697f2d03ea00cd6","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"import \"./helpers/leak_guard.js\";\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { makeRepo, startGateway } from \"./helpers/fixtures.js\";\nimport { trackResource } from \"./helpers/leak_guard.js\";\n\nfunction delay(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nasync function waitFor(description: string, check: () => boolean, timeoutMs = 10_000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (Date.now() < deadline) {\n    if (check()) return;\n    await delay(20);\n  }\n  assert.fail(`timed out waiting for ${description}`);\n}\n\nasync function recoverAfterProcessCrash(includeCompletedSibling: boolean): Promise<{ effects: string; toolResults: string[] }> {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-p10-crash-\"));\n  const home = path.join(root, \"home\");\n  fs.mkdirSync(home, { recursive: true });\n  const previous = { home: process.env.HOME, xdg: process.env.XDG_CONFIG_HOME };\n  process.env.HOME = home;\n  process.env.XDG_CONFIG_HOME = path.join(home, \".config\");\n  const repo = makeRepo({ \"README.md\": \"base\\n\" });\n  const counter = path.join(root, \"effects.txt\");\n  const commandPidFile = path.join(root, \"command.pid\");\n  const taskIdFile = path.join(root, \"task-id.txt\");\n  const completedCall = { name: \"run_command\", args: { command: `printf 'completed\\\\n' >> '${counter}'; printf 'completed\\\\n'` } };\n  const pendingLabel = includeCompletedSibling ? \"pending\" : \"ran\";\n  const pendingCommand = `printf '%s\\\\n' \"$$\" > '${commandPidFile}'; printf '${pendingLabel}\\\\n' >> '${counter}'; if [ \"$(wc -l < '${counter}')\" -gt ${includeCompletedSibling ? 2 : 1} ]; then exit 0; fi; exec sleep 60`;\n  const pendingCall = { name: \"run_command\", args: { command: pendingCommand, timeout_secs: 120 } };\n  const initialCalls = includeCompletedSibling ? [completedCall, pendingCall] : [pendingCall];\n  const gateway = await startGateway((n) => n === 1\n    ? { kind: \"tools\", calls: initialCalls }\n    : { kind: \"text\", content: \"done\" });\n  const previousCwd = process.cwd();\n  const cliRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n  let child: ReturnType<typeof spawn> | undefined;\n  let resumed: AutonomousAgent | undefined;\n  let commandPid: number | undefined;\n\n  try {\n    const childScript = `\n      import fs from \"node:fs\";\n      import { AutonomousAgent } from \"./src/agent.ts\";\n      const agent = new AutonomousAgent({ endpoint: process.env.TEST_GATEWAY, model: \"m\", maxSteps: 6, temperature: 0, workspace: process.env.TEST_WORKSPACE, shell: \"bash\", approvalMode: \"auto\", fullAccess: true }, 1, undefined, { durable: true });\n      agent.ui = new Proxy({}, { get: () => () => {} });\n      fs.writeFileSync(process.env.TEST_TASK_ID_FILE, agent.getTaskId());\n      await agent.runTurn(\"Run the command and report its result.\");\n      process.exit(0);\n    `;\n    child = spawn(process.execPath, [\"--import\", \"tsx\", \"--input-type=module\", \"-e\", childScript], {\n      cwd: cliRoot,\n      env: {\n        PATH: process.env.PATH,\n        HOME: home,\n        XDG_CONFIG_HOME: path.join(home, \".config\"),\n        TEST_GATEWAY: gateway.url,\n        TEST_WORKSPACE: repo,\n        TEST_TASK_ID_FILE: taskIdFile,\n      },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    trackResource(\"child process\", `crash fixture agent pid ${child.pid}`, () => child?.exitCode === null && child?.signalCode === null, () => child?.kill(\"SIGKILL\"));\n    let childOutput = \"\";\n    child.stdout?.on(\"data\", (chunk) => { childOutput += String(chunk); });\n    child.stderr?.on(\"data\", (chunk) => { childOutput += String(chunk); });\n    const childExit = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => {\n      child!.once(\"exit\", (code, signal) => resolve({ code, signal }));\n    });\n\n    await waitFor(\"the child task id\", () => fs.existsSync(taskIdFile));\n    await waitFor(\"the first provider request\", () => gateway.requests.length >= 1);\n    await waitFor(\"the side effect and running command pid\", () => fs.existsSync(counter) && fs.existsSync(commandPidFile));\n    commandPid = Number(fs.readFileSync(commandPidFile, \"utf8\").trim());\n    assert.ok(Number.isSafeInteger(commandPid) && commandPid > 1, \"fixture recorded its own command pid\");\n    assert.equal(fs.readFileSync(counter, \"utf8\"), includeCompletedSibling ? \"completed\\npending\\n\" : \"ran\\n\");\n\n    child.kill(\"SIGKILL\");\n    const killed = await childExit;\n    assert.equal(killed.signal, \"SIGKILL\", `child ended unexpectedly: ${JSON.stringify(killed)} ${childOutput}`);\n    try { process.kill(commandPid, \"SIGKILL\"); } catch (error) {\n      if ((error as NodeJS.ErrnoException).code !== \"ESRCH\") throw error;\n    }\n\n    const taskId = fs.readFileSync(taskIdFile, \"utf8\").trim();\n    resumed = new AutonomousAgent({ endpoint: gateway.url, model: \"m\", maxSteps: 6, temperature: 0, workspace: repo, shell: \"bash\", approvalMode: \"auto\", fullAccess: true } as any, 1, undefined, { durable: true });\n    resumed.ui = new Proxy({}, { get: () => () => {} });\n    const recovery = await resumed.recoverFromTaskState(taskId);\n    assert.equal(recovery.interrupted, true, \"restart identifies the durable operation left in flight\");\n    await resumed.runTurn(\"Continue.\", undefined, { resume: true });\n\n    const effects = fs.readFileSync(counter, \"utf8\");\n    const toolResults = gateway.requests.flatMap((request: any) => request.messages ?? [])\n      .filter((message: any) => message.role === \"tool\")\n      .map((message: any) => String(message.content));\n    return { effects, toolResults };\n  } finally {\n    if (child && child.exitCode === null && child.signalCode === null) child.kill(\"SIGKILL\");\n    const recordedPid = commandPid ?? (fs.existsSync(commandPidFile) ? Number(fs.readFileSync(commandPidFile, \"utf8\").trim()) : undefined);\n    if (Number.isSafeInteger(recordedPid) && recordedPid! > 1) {\n      try { process.kill(recordedPid!, \"SIGKILL\"); } catch (error) {\n        if ((error as NodeJS.ErrnoException).code !== \"ESRCH\") throw error;\n      }\n    }\n    resumed?.shutdown();\n    await gateway.close();\n    process.chdir(previousCwd);\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(root, { recursive: true, force: true });\n    if (previous.home === undefined) delete process.env.HOME; else process.env.HOME = previous.home;\n    if (previous.xdg === undefined) delete process.env.XDG_CONFIG_HOME; else process.env.XDG_CONFIG_HOME = previous.xdg;\n  }\n}\n\ntest(\"a real process crash after a tool side effect does not silently replay the call\", async () => {\n  const { effects, toolResults } = await recoverAfterProcessCrash(false);\n  assert.equal(effects, \"ran\\n\", \"the side effect was not repeated after recovery\");\n  assert.ok(toolResults.some((content) => /effects, if any, are unknown/.test(content)), JSON.stringify(toolResults));\n});\n\ntest(\"a crash during a multi-tool response preserves a completed sibling and does not replay the unknown sibling\", async () => {\n  const { effects, toolResults } = await recoverAfterProcessCrash(true);\n  assert.equal(effects, \"completed\\npending\\n\", \"the completed sibling remains once and the unknown sibling is not repeated\");\n  assert.ok(toolResults.some((content) => content.includes(\"completed\")), JSON.stringify(toolResults));\n  assert.ok(toolResults.some((content) => /effects, if any, are unknown/.test(content)), JSON.stringify(toolResults));\n});\nimport \"./helpers/leak_guard.js\";\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport http from \"node:http\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { makeRepo } from \"./helpers/fixtures.js\";\nimport { trackResource } from \"./helpers/leak_guard.js\";\n\nfunction delay(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nasync function waitFor(description: string, check: () => boolean, timeoutMs = 10_000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (Date.now() < deadline) {\n    if (check()) return;\n    await delay(20);\n  }\n  assert.fail(`timed out waiting for ${description}`);\n}\n\ntest(\"a provider request with a lost response is recorded as unknown after process-crash resume\", { timeout: 60_000 }, async (t) => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-p10-provider-crash-\"));\n  const home = path.join(root, \"home\");\n  const repo = makeRepo({ \"README.md\": \"base\\n\" });\n  const taskIdFile = path.join(root, \"task-id.txt\");\n  const resultFile = path.join(root, \"resume-result.json\");\n  fs.mkdirSync(home, { recursive: true });\n\n  const requests: unknown[] = [];\n  const sockets = new Set<import(\"node:net\").Socket>();\n  const server = http.createServer((req, res) => {\n    if (req.url?.endsWith(\"/models\")) {\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ data: [{ id: \"m\" }] }));\n      return;\n    }\n    let raw = \"\";\n    req.on(\"data\", (chunk) => { raw += String(chunk); });\n    req.on(\"end\", () => {\n      if (req.url?.endsWith(\"/chat/completions\")) {\n        try { requests.push(JSON.parse(raw)); } catch { requests.push(raw); }\n        // The first response is lost when Nexus is killed; a later request gets a deterministic answer.\n        if (requests.length > 1) {\n          res.setHeader(\"content-type\", \"application/json\");\n          res.end(JSON.stringify({ id: \"response-2\", choices: [{ index: 0, message: { role: \"assistant\", content: \"done\" }, finish_reason: \"stop\" }], usage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 } }));\n        }\n        return;\n      }\n      res.statusCode = 404;\n      res.end(\"not found\");\n    });\n  });\n  server.on(\"connection\", (socket) => {\n    sockets.add(socket);\n    socket.on(\"close\", () => sockets.delete(socket));\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const endpoint = `http://127.0.0.1:${(server.address() as import(\"node:net\").AddressInfo).port}/v1`;\n  const closeServer = async () => {\n    for (const socket of sockets) socket.destroy();\n    await new Promise<void>((resolve) => server.close(() => resolve()));\n  };\n  trackResource(\"gateway\", \"provider crash fixture server not closed\", () => server.listening, () => closeServer());\n\n  const previousCwd = process.cwd();\n  const cliRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n  const childEnv = {\n    PATH: process.env.PATH,\n    HOME: home,\n    XDG_CONFIG_HOME: path.join(home, \".config\"),\n    TEST_GATEWAY: endpoint,\n    TEST_WORKSPACE: repo,\n    TEST_TASK_ID_FILE: taskIdFile,\n    TEST_RESULT_FILE: resultFile,\n  };\n  let first: ReturnType<typeof spawn> | undefined;\n  let resumed: ReturnType<typeof spawn> | undefined;\n  const stop = async (child: ReturnType<typeof spawn> | undefined): Promise<void> => {\n    if (!child || child.exitCode !== null || child.signalCode !== null) return;\n    child.kill(\"SIGKILL\");\n    await new Promise<void>((resolve) => child.once(\"exit\", () => resolve()));\n  };\n\n  try {\n    const firstScript = `\n      import fs from \"node:fs\";\n      import { AutonomousAgent } from \"./src/agent.ts\";\n      import { DEFAULT_CONTINUATION } from \"./src/types.ts\";\n      const agent = new AutonomousAgent({ endpoint: process.env.TEST_GATEWAY, model: \"m\", maxSteps: 2, maxInferenceSubmissions: 5, continuation: { ...DEFAULT_CONTINUATION, maxInferenceSubmissions: 5 }, temperature: 0, workspace: process.env.TEST_WORKSPACE, shell: \"bash\", approvalMode: \"auto\", fullAccess: true }, 1, undefined, { durable: true });\n      agent.ui = new Proxy({}, { get: () => () => {} });\n      fs.writeFileSync(process.env.TEST_TASK_ID_FILE, agent.getTaskId());\n      await agent.runTurn(\"Continue the task.\");\n      process.exit(0);\n    `;\n    first = spawn(process.execPath, [\"--import\", \"tsx\", \"--input-type=module\", \"-e\", firstScript], {\n      cwd: cliRoot,\n      env: childEnv,\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    trackResource(\"child process\", `provider crash fixture agent pid ${first.pid}`, () => first?.exitCode === null && first?.signalCode === null, () => first?.kill(\"SIGKILL\"));\n    let firstOutput = \"\";\n    first.stdout?.on(\"data\", (chunk) => { firstOutput += String(chunk); });\n    first.stderr?.on(\"data\", (chunk) => { firstOutput += String(chunk); });\n    const firstExit = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => first!.once(\"exit\", (code, signal) => resolve({ code, signal })));\n\n    try {\n      await waitFor(\"the durable task id\", () => fs.existsSync(taskIdFile), 30_000);\n    } catch (error) {\n      assert.fail(`${error instanceof Error ? error.message : String(error)}\\nfirst process output:\\n${firstOutput}`);\n    }\n    try {\n      await waitFor(\"the pending provider request or first-process exit\", () => requests.length === 1 || first!.exitCode !== null || first!.signalCode !== null, 30_000);\n      assert.equal(requests.length, 1, `first process ended before reaching the provider: exit=${first?.exitCode} signal=${first?.signalCode}\\n${firstOutput}`);\n    } catch (error) {\n      assert.fail(`${error instanceof Error ? error.message : String(error)}\\nfirst process output:\\n${firstOutput}`);\n    }\n    assert.equal(fs.readFileSync(taskIdFile, \"utf8\").length > 0, true);\n    first.kill(\"SIGKILL\");\n    const killed = await firstExit;\n    assert.equal(killed.signal, \"SIGKILL\", `first process ended unexpectedly: ${JSON.stringify(killed)} ${firstOutput}`);\n\n    const resumeScript = `\n      import fs from \"node:fs\";\n      import { AutonomousAgent } from \"./src/agent.ts\";\n      import { DEFAULT_CONTINUATION } from \"./src/types.ts\";\n      const agent = new AutonomousAgent({ endpoint: process.env.TEST_GATEWAY, model: \"m\", maxSteps: 2, maxInferenceSubmissions: 5, continuation: { ...DEFAULT_CONTINUATION, maxInferenceSubmissions: 5 }, temperature: 0, workspace: process.env.TEST_WORKSPACE, shell: \"bash\", approvalMode: \"auto\", fullAccess: true }, 1, undefined, { durable: true });\n      agent.ui = new Proxy({}, { get: () => () => {} });\n      const taskId = fs.readFileSync(process.env.TEST_TASK_ID_FILE, \"utf8\").trim();\n      const recovery = await agent.recoverFromTaskState(taskId);\n      const result = await agent.runTurn(\"\", undefined, { resume: true });\n      fs.writeFileSync(process.env.TEST_RESULT_FILE, JSON.stringify({ recovery, result, execution: agent.getObjective()?.execution }));\n      agent.shutdown();\n    `;\n    resumed = spawn(process.execPath, [\"--import\", \"tsx\", \"--input-type=module\", \"-e\", resumeScript], {\n      cwd: cliRoot,\n      env: childEnv,\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    trackResource(\"child process\", `provider resume fixture agent pid ${resumed.pid}`, () => resumed?.exitCode === null && resumed?.signalCode === null, () => resumed?.kill(\"SIGKILL\"));\n    let resumeOutput = \"\";\n    resumed.stdout?.on(\"data\", (chunk) => { resumeOutput += String(chunk); });\n    resumed.stderr?.on(\"data\", (chunk) => { resumeOutput += String(chunk); });\n    const resumedExit = await new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => resumed!.once(\"exit\", (code, signal) => resolve({ code, signal })));\n    assert.deepEqual(resumedExit, { code: 0, signal: null }, resumeOutput);\n    assert.ok(fs.existsSync(resultFile), `resume result was not written: ${resumeOutput}`);\n    const resumedState = JSON.parse(fs.readFileSync(resultFile, \"utf8\"));\n    assert.equal(resumedState.execution.inferenceSubmissions, requests.length, \"every provider submission remains charged after restart\");\n    assert.equal(resumedState.execution.maxInferenceSubmissions, 5, \"resume preserves the saved request ceiling\");\n    assert.equal(resumedState.execution.inferenceOutcomeUnknowns, 1, \"the lost provider response is durably reported as unknown\");\n    assert.ok(requests.length > 1, \"resume can submit again when the persisted allowance still has capacity\");\n  } finally {\n    await stop(first);\n    await stop(resumed);\n    await closeServer();\n    process.chdir(previousCwd);\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { test } from \"node:test\";\nimport \"./helpers/leak_guard.js\";\nimport { makeAgent, makeWorld } from \"./helpers/tool_characterization.js\";\nimport { startGateway } from \"./helpers/fixtures.js\";\n\ntest(\"a mutating tool is not dispatched when its durable start journal cannot be written\", async (t) => {\n  const world = makeWorld();\n  t.after(() => world.close());\n  const gateway = await startGateway(() => ({\n    kind: \"tools\",\n    calls: [{ name: \"write_file\", args: { path: \"journal-failure.txt\", content: \"must not be written\\n\" } }],\n  }));\n  t.after(() => gateway.close());\n\n  const agent = makeAgent(world, {\n    mode: \"auto\",\n    fullAccess: true,\n    config: { endpoint: gateway.url, maxSteps: 1 },\n  });\n  const stateManager = agent.getStateManager();\n  let starts = 0;\n  stateManager.recordOperationStart = (() => {\n    starts++;\n    throw new Error(\"injected durable start-journal failure\");\n  }) as typeof stateManager.recordOperationStart;\n\n  const result = await agent.runTurn(\"Write journal-failure.txt\");\n\n  assert.equal(starts, 1, \"the durable start boundary was reached exactly once\");\n  assert.equal(gateway.requests.length, 1, \"the model requested one tool call\");\n  const activeWorktree = agent.getActiveWorktree();\n  assert.equal(\n    [world.repo, ...(activeWorktree ? [activeWorktree.worktreePath] : [])]\n      .some((root) => fs.existsSync(path.join(root, \"journal-failure.txt\"))),\n    false,\n    \"no mutating handler runs without its durable start record\",\n  );\n  assert.equal(result.persistence?.durable, false);\n  assert.ok(result.persistence?.failures.some((failure) => failure.includes(\"operation_start\")));\n});\n# Reference coding with XERJ\n\nThe detail behind the \"Reference coding\" rule in `AGENTS.md`: how to reach the local XERJ node, what to query, and what to leave alone.\n\n- Before non-trivial code with a peer-project analogue (feature, protocol, parser, worktree or provider handling, tool, test harness), query the local XERJ node and record what you took, borrowed or rejected in the PR's \"Reference coding\" section. Exempt: trivial edits, doc-only changes, fixes fully specified by a failing test.\n- XERJ is an owner-host tool, not a project dependency (`docs/v1.1.0/DECISIONS.md` §1). Where it is unavailable (contributor machine, CI), write \"XERJ unavailable: <reason>\" in that section and use `git grep` plus the peer's public source.\n- The node is the user service `xerj` on `http://localhost:9200`; confirm with `systemctl --user is-active xerj` and use that node. Stop a hub with `xerj hub stop`.\n- Corpora: `xerj corpus list`. Retrieval is lexical (BM25), so query with identifiers and words from the code: `xerj code <corpus> \"<words>\" -k 4 --full 600`, `xerj search --prefix <index-prefix> \"<words>\" -k 4`, `xerj def --prefix <prefix> \"<symbol>\"`. The first query can take over a minute; set a timeout.\n- `nexus-cli`, `nexus-core`, `nexus-test`, `nexus-docs` index `origin/main` only (hourly), so open PRs are absent: use `git grep` on your branch.\n- Reference code is read-only inspiration. Follow each result's licence tag; copy verbatim only permissively licensed code, with a citation. Keep XERJ and reference corpora away from held-out evaluation tasks (`docs/v1.0.0/CONCURRENCY.md`). Keep document text local (`rerank` sends it to a third party). Leave indices you did not create alone.\n- After real use: `xerj feedback --dry-run`, then `xerj feedback --submit --agent \"<model>\" --used-for \"<task>\" --verdict \"<what worked and what did not>\"`, with secrets and private data left out.\nFILE_cli_test_p10_operation_active_budget.test.ts.released-20261125T161655Z-pr823-merged\nFILE_cli_test_p10_operation_inference_budget.test.ts.released-20261126T11-pr869-pr870-postmerge\nFILE_cli_test_p10_operation_inference_budget.test.ts.released-20261126T195129Z-pr880-merged\nFILE_cli_test_p10_operation_inference_budget.test.ts.released-20261127T1300Z-pr901-merged-ci\nFILE_cli_test_p10_operation_journal_fail_closed.test.ts.released-20261128T011343Z-pr924-postmerge-ci\nFILE_cli_test_p10_operation_token_admission.test.ts.released-20261126T231636Z-pr883-postmerge-ci\nFILE_cli_test_p10_operation_token_admission.test.ts.released-20261127T004111Z-pr885-postmerge-ci\nFILE_cli_test_p10_operation_token_admission.test.ts.released-20261127T1300Z-pr901-merged-ci\nFILE_cli_test_p10_operation_token_budget.test.ts.reconciled-20261126T235214Z-scope-adjustment\nFILE_cli_test_p10_operation_token_reporting.test.ts.released-20261126T195129Z-pr880-merged\nFILE_cli_test_p10_operation_token_reporting.test.ts.released-20261128T015510Z-reconciled-merged\nFILE_cli_test_p10_process_crash_recovery.test.ts.released-20261127T-p10-03-takeover\nFILE_cli_test_p10_process_crash_recovery.test.ts.released-20261127T055606Z-pr894-postmerge-ci\nP10_02_CRASH_MATRIX.released-20261127T-p10-03-takeover\nP10_02_CRASH_MATRIX_NEXT.released-20261127T055606Z-pr894-postmerge-ci\nP10_02_INFERENCE_SCOPE_DOCS.released-20261124T024335Z-pr765\nP10_02_MAIN_CRASH_EVIDENCE_FORWARDPORT.released-20261127T065746Z-pr896-postmerge-ci\nP10_02_MERGED_EVIDENCE.released-20261127T2151Z-pr921-postmerge-ci\nP10_02_PER_TOOL_MERGED_EVIDENCE.released-20261127T232834Z-pr923-postmerge-ci-codeql\nP10_02_PER_TOOL_RPC_DEADLINES.released-20261127T230143Z-pr922-postmerge-ci-codeql\nP10_02_PROVIDER_CRASH_ACCOUNTING.released-20261127T063115Z-pr895-postmerge-ci\nWP_P10_02_CRASH_EVIDENCE_DOCS.released-20261127T075558Z-pr899-postmerge-ci\nWP_P10_02_DURABLE_BUDGET.released-20261119-rd7\nWP_P10_02_DURABLE_EFFECT_JOURNAL_FAIL_CLOSED.released-20261128T011343Z-pr924-postmerge-ci\nWP_P10_02_HARD_TOKEN_RESERVATION.released-20261126T231636Z-pr883-postmerge-ci\nWP_P10_02_OBJECTIVE_ELAPSED_BUDGET.released-20261124T1030Z-pr774-merged\nWP_P10_02_OPERATION_INFERENCE_ADMISSION.released-20261126T11-pr869-pr870-postmerge\nWP_P10_02_PLUGIN_EXECUTION_BOUNDARY.released-20261128T024240Z-pr928-docs\nWP_P10_02_POSTMERGE_DOC_EVIDENCE.released-20261128T014209Z-pr926-postmerge-ci\nWP_P10_02_PROGRESS_RECONCILIATION.released-20261125-pr821-merged\nWP_P10_02_PROVIDER_ENFORCED_OUTPUT_CEILING.released-20261127T004111Z-pr885-postmerge-ci\nWP_P10_02_PROVIDER_OUTCOME_FOLLOWUP.released-20261127T1300Z-pr901-merged-ci\nWP_P10_02_RPC_TIMEOUT_WORKER_TERMINATION.released-20261126T060322Z-pr862-postmerge-ci\nWP_P10_02_SHARED_REQUEST_ADMISSION.released-20261126T021315Z-pr857-postmerge-ci\nWP_P10_02_TOOL_TIMEOUT_BOUND.released-20261126T0642Z-pr864-postmerge-ci\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a22128-3667-7142-a098-5707fbe8c197","create_time":1795852784.7465894}},"metadata":{"history_sequence":139599,"sampled_through_sequence":139594,"client_authored":false,"fallback_token_limit_override":12000}}
