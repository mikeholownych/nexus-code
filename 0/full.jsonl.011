{"timestamp":"2026-11-28T06:46:03.925Z","ordinal":315040,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a220e5-c285-7e72-9bb5-c6a32a48db70","item":{"type":"CommandExecution","id":"exec-435f6176-95a6-4e3c-8af1-f02a764356c8","process_id":"48526","command":["/usr/bin/zsh","-lc","sed -n '1,260p' cli/src/core/shared_resource_admission.ts; sed -n '1,150p' cli/test/helpers/setup.ts; sed -n '1,130p' cli/test/helpers/runner_fixture.ts; sed -n '1,160p' cli/scripts/run_tests_driver.mjs; sed -n '180,230p' cli/test/audit_command.test.ts; sed -n '180,225p' cli/test/schedule_cli.test.ts"],"cwd":"file:///home/mike/nexus-wt/p10-04-active-client-admission-continued","parsed_cmd":[{"type":"read","cmd":"sed -n '1,260p' cli/src/core/shared_resource_admission.ts","name":"shared_resource_admission.ts","path":"cli/src/core/shared_resource_admission.ts"},{"type":"read","cmd":"sed -n '1,150p' cli/test/helpers/setup.ts","name":"setup.ts","path":"cli/test/helpers/setup.ts"},{"type":"read","cmd":"sed -n '1,130p' cli/test/helpers/runner_fixture.ts","name":"runner_fixture.ts","path":"cli/test/helpers/runner_fixture.ts"},{"type":"read","cmd":"sed -n '1,160p' cli/scripts/run_tests_driver.mjs","name":"run_tests_driver.mjs","path":"cli/scripts/run_tests_driver.mjs"},{"type":"read","cmd":"sed -n '180,230p' cli/test/audit_command.test.ts","name":"audit_command.test.ts","path":"cli/test/audit_command.test.ts"},{"type":"read","cmd":"sed -n '180,225p' cli/test/schedule_cli.test.ts","name":"schedule_cli.test.ts","path":"cli/test/schedule_cli.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/** Cross-operation, same-host admission for configured inference-resource slots. */\nimport { createHash } from \"node:crypto\";\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { ensurePrivateDir, writeFileDurably } from \"./durable_file.js\";\nimport { acquireFileGuard, releaseFileGuard, type FileGuard } from \"./file_guard.js\";\nimport type { ResourceDescriptor } from \"./resources.js\";\nimport { MAX_CONCURRENT_UNITS } from \"./operation_schema.js\";\n\n/** Persistent lock files are never unlinked while other processes may hold their inodes. Bound unique identities. */\nexport const MAX_SHARED_RESOURCE_IDENTITIES = 1_024;\nexport const MAX_SHARED_RESOURCE_CAPACITY = MAX_CONCURRENT_UNITS;\n\ninterface CapacityRecord {\n  format: \"NEXUS_RESOURCE_ADMISSION\";\n  version: 1;\n  capacity: number;\n}\n\nexport interface ResourceSlotLease {\n  /** Idempotently releases this unit's kernel-owned slot. */\n  release(): void;\n  /** Descriptor for a trusted child supervisor to inherit so the slot survives parent-process death. */\n  readonly inheritedFd?: number;\n}\n\nexport class ResourceAdmissionConflictError extends Error {\n  constructor(message: string) {\n    super(message);\n    this.name = \"ResourceAdmissionConflictError\";\n  }\n}\n\nfunction canonicalEndpoint(endpoint: string): string {\n  let url: URL;\n  try {\n    url = new URL(endpoint);\n  } catch {\n    throw new ResourceAdmissionConflictError(\"resource endpoint is not a valid URL; shared admission refused\");\n  }\n  if (url.protocol !== \"http:\" && url.protocol !== \"https:\") {\n    throw new ResourceAdmissionConflictError(\"resource endpoint must use HTTP or HTTPS; shared admission refused\");\n  }\n  // Credentials and query strings can contain secrets. They are not part of the stored key material.\n  url.username = \"\";\n  url.password = \"\";\n  url.search = \"\";\n  url.hash = \"\";\n  return url.toString();\n}\n\nfunction resourceKey(resource: ResourceDescriptor): string {\n  const identity = JSON.stringify({\n    provider: resource.provider.trim().toLowerCase(),\n    providerId: resource.providerId?.trim().toLowerCase() ?? \"\",\n    endpoint: canonicalEndpoint(resource.endpoint),\n    // A declared serving pool spans models, so it replaces the model component of the slot identity.\n    model: resource.pool ? \"\" : resource.model,\n    pool: resource.pool ?? \"\",\n    // Account is a non-secret identity label/fingerprint in ResourceDescriptor; hash it before persistence.\n    account: resource.account ?? \"default\",\n  });\n  return createHash(\"sha256\").update(identity).digest(\"hex\");\n}\n\nfunction capacityOf(resource: ResourceDescriptor, operatorMaximum: number): number {\n  const declared = resource.maxConcurrentUnits ?? operatorMaximum;\n  if (!Number.isSafeInteger(declared) || declared < 1 || declared > MAX_CONCURRENT_UNITS) {\n    throw new ResourceAdmissionConflictError(\"resource maxConcurrentUnits is invalid; shared admission refused\");\n  }\n  // A workspace operation spec may supply this descriptor. It can lower the operator-owned ceiling, never raise it.\n  return Math.min(declared, operatorMaximum);\n}\n\nfunction ensureAdmissionDirectory(dir: string): void {\n  ensurePrivateDir(dir);\n  const stat = fs.lstatSync(dir);\n  if (!stat.isDirectory() || stat.isSymbolicLink()) throw new Error(\"resource admission directory is redirected\");\n  if (typeof process.getuid === \"function\" && stat.uid !== process.getuid()) throw new Error(\"resource admission directory is not owned by the running user\");\n  if ((stat.mode & 0o077) !== 0) throw new Error(\"resource admission directory has unsafe permissions\");\n}\n\nfunction readCapacity(file: string): CapacityRecord | undefined {\n  const stat = fs.lstatSync(file, { throwIfNoEntry: false });\n  if (!stat) return undefined;\n  if (!stat.isFile() || stat.isSymbolicLink()) throw new ResourceAdmissionConflictError(\"shared resource admission record is redirected; admission refused\");\n  if (typeof process.getuid === \"function\" && stat.uid !== process.getuid()) throw new ResourceAdmissionConflictError(\"shared resource admission record has a foreign owner; admission refused\");\n  if ((stat.mode & 0o077) !== 0 || stat.nlink !== 1) throw new ResourceAdmissionConflictError(\"shared resource admission record has unsafe permissions; admission refused\");\n  let raw: string;\n  try {\n    raw = fs.readFileSync(file, \"utf8\");\n  } catch (error: any) {\n    if (error?.code === \"ENOENT\") throw new ResourceAdmissionConflictError(\"shared resource admission record disappeared while being read; admission refused\");\n    throw error;\n  }\n  let parsed: unknown;\n  try {\n    parsed = JSON.parse(raw);\n  } catch {\n    throw new ResourceAdmissionConflictError(\"shared resource admission record is unreadable; admission refused\");\n  }\n  if (!parsed || typeof parsed !== \"object\" || Array.isArray(parsed)) {\n    throw new ResourceAdmissionConflictError(\"shared resource admission record is invalid; admission refused\");\n  }\n  const record = parsed as Partial<CapacityRecord>;\n  if (\n    record.format !== \"NEXUS_RESOURCE_ADMISSION\" ||\n    record.version !== 1 ||\n    !Number.isSafeInteger(record.capacity) ||\n    (record.capacity ?? 0) < 1 ||\n    (record.capacity ?? 0) > MAX_CONCURRENT_UNITS ||\n    Object.keys(parsed).some((key) => ![\"format\", \"version\", \"capacity\"].includes(key))\n  ) {\n    throw new ResourceAdmissionConflictError(\"shared resource admission record is invalid; admission refused\");\n  }\n  return record as CapacityRecord;\n}\n\n/**\n * Atomically reserves slots across operation IDs and Nexus processes on the same host/filesystem.\n * `operatorMaxUnits` is the operator-owned ceiling; a resource descriptor can lower it, never raise it. Concurrent\n * effective declarations for one identity must agree; an active mismatch fails closed.\n */\nexport class SharedResourceAdmission {\n  constructor(\n    private readonly directory: string,\n    private readonly options: { operatorMaxUnits?: number; guardWaitMs?: number; maxResourceIdentities?: number } = {},\n  ) {\n    const operatorMaxUnits = options.operatorMaxUnits ?? 1;\n    const guardWaitMs = options.guardWaitMs ?? 1_000;\n    const maxResourceIdentities = options.maxResourceIdentities ?? MAX_SHARED_RESOURCE_IDENTITIES;\n    if (!Number.isSafeInteger(operatorMaxUnits) || operatorMaxUnits < 1 || operatorMaxUnits > MAX_CONCURRENT_UNITS) {\n      throw new Error(`invalid operator shared-resource capacity; expected 1..${MAX_CONCURRENT_UNITS}`);\n    }\n    if (!Number.isSafeInteger(guardWaitMs) || guardWaitMs < 0) throw new Error(\"invalid resource admission guard wait bound\");\n    if (!Number.isSafeInteger(maxResourceIdentities) || maxResourceIdentities < 1 || maxResourceIdentities > MAX_SHARED_RESOURCE_IDENTITIES) {\n      throw new Error(`invalid shared-resource identity bound; expected 1..${MAX_SHARED_RESOURCE_IDENTITIES}`);\n    }\n  }\n\n  private get operatorMaxUnits(): number {\n    return this.options.operatorMaxUnits ?? 1;\n  }\n\n  private get guardWaitMs(): number {\n    return this.options.guardWaitMs ?? 1_000;\n  }\n\n  private get maxResourceIdentities(): number {\n    return this.options.maxResourceIdentities ?? MAX_SHARED_RESOURCE_IDENTITIES;\n  }\n\n  private acquireIdentityGuard(prefix: string): FileGuard | null {\n    const catalog = acquireFileGuard(path.join(this.directory, \"catalog.guard\"), {\n      label: \"Shared resource catalog guard\",\n      waitMs: this.guardWaitMs,\n    });\n    if (!catalog) return null;\n    try {\n      const guardPath = `${prefix}.guard`;\n      const exists = fs.lstatSync(guardPath, { throwIfNoEntry: false }) !== undefined;\n      if (!exists) {\n        const registered = fs.readdirSync(this.directory).filter((name) => /^[0-9a-f]{64}\\.guard$/.test(name)).length;\n        if (registered >= this.maxResourceIdentities) {\n          throw new ResourceAdmissionConflictError(\n            `shared resource identity limit (${this.maxResourceIdentities}) reached; refusing to create another admission record`,\n          );\n        }\n      }\n      try {\n        return acquireFileGuard(guardPath, { label: \"Shared resource admission guard\", waitMs: this.guardWaitMs });\n      } catch (error) {\n        throw new ResourceAdmissionConflictError(`cannot establish shared resource admission: ${(error as Error).message}`);\n      }\n    } finally {\n      releaseFileGuard(catalog);\n    }\n  }\n\n  acquire(resource: ResourceDescriptor): ResourceSlotLease | null {\n    const key = resourceKey(resource);\n    const capacity = capacityOf(resource, this.operatorMaxUnits);\n    return this.acquireKey(key, capacity, \"shared inference resource\", \"Shared inference resource slot\", false);\n  }\n\n  /** Reserves a bounded named local resource using the same cross-process kernel slot mechanism. */\n  acquireNamed(name: string, capacity: number, label: string): ResourceSlotLease | null {\n    if (!/^[a-z0-9][a-z0-9._:-]{0,127}$/i.test(name)) {\n      throw new ResourceAdmissionConflictError(\"named shared resource identity is invalid; admission refused\");\n    }\n    if (!Number.isSafeInteger(capacity) || capacity < 1 || capacity > MAX_CONCURRENT_UNITS) {\n      throw new ResourceAdmissionConflictError(`named shared resource capacity is invalid; expected 1..${MAX_CONCURRENT_UNITS}`);\n    }\n    if (typeof label !== \"string\" || !/^[a-z][a-z0-9 -]{0,63}$/i.test(label)) {\n      throw new ResourceAdmissionConflictError(\"named shared resource label is invalid; admission refused\");\n    }\n    const key = createHash(\"sha256\").update(JSON.stringify({ kind: \"named\", name })).digest(\"hex\");\n    return this.acquireKey(key, capacity, `shared ${label}`, `Shared ${label} slot`, true);\n  }\n\n  private acquireKey(key: string, capacity: number, scope: string, slotLabel: string, inheritSlot: boolean): ResourceSlotLease | null {\n    ensureAdmissionDirectory(this.directory);\n    const prefix = path.join(this.directory, key);\n    const mutex = this.acquireIdentityGuard(prefix);\n    if (!mutex) return null;\n\n    let slot: FileGuard | null = null;\n    try {\n      const capacityFile = `${prefix}.json`;\n      const existing = readCapacity(capacityFile);\n      if (!existing && this.probeActiveSlots(prefix, MAX_CONCURRENT_UNITS, scope, slotLabel) > 0) {\n        throw new ResourceAdmissionConflictError(`${scope} admission metadata is missing while a slot is active; admission refused`);\n      }\n      if (existing && existing.capacity !== capacity) {\n        const active = this.probeActiveSlots(prefix, existing.capacity, scope, slotLabel);\n        if (active > 0) {\n          throw new ResourceAdmissionConflictError(\n            `active operations declare different capacities (${existing.capacity} and ${capacity}) for the same ${scope}`,\n          );\n        }\n      }\n      const effectiveCapacity = existing?.capacity === capacity ? existing.capacity : capacity;\n      for (let index = 0; index < effectiveCapacity; index++) {\n        try {\n          slot = acquireFileGuard(`${prefix}.slot-${index}`, { label: slotLabel });\n        } catch (error) {\n          throw new ResourceAdmissionConflictError(`cannot reserve ${scope} slot: ${(error as Error).message}`);\n        }\n        if (slot) break;\n      }\n      if (!slot) return null;\n      if (!existing || existing.capacity !== effectiveCapacity) {\n        try {\n          writeFileDurably(capacityFile, JSON.stringify({ format: \"NEXUS_RESOURCE_ADMISSION\", version: 1, capacity: effectiveCapacity } satisfies CapacityRecord));\n        } catch (error) {\n          releaseFileGuard(slot);\n          slot = null;\n          throw error;\n        }\n      }\n      const held = slot;\n      slot = null;\n      return {\n        ...(inheritSlot ? { inheritedFd: held.fd } : {}),\n        release: () => releaseFileGuard(held),\n      };\n    } finally {\n      if (slot) releaseFileGuard(slot);\n      releaseFileGuard(mutex);\n    }\n  }\n\n  private probeActiveSlots(prefix: string, capacity: number, scope: string, slotLabel: string): number {\n    let active = 0;\n    for (let index = 0; index < capacity; index++) {\n      if (!fs.existsSync(`${prefix}.slot-${index}`)) continue;\n      let probe: FileGuard | null;\n      try {\n        probe = acquireFileGuard(`${prefix}.slot-${index}`, { label: slotLabel });\n      } catch (error) {\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\n\n// Global test setup for HOME and state directory isolation (REQ-PER-103, ACC-PER-03, PLAN-08 Task 1).\nconst realHome = process.env.NEXUS_TEST_REAL_HOME || os.homedir();\nif (!process.env.NEXUS_TEST_REAL_HOME) {\n  process.env.NEXUS_TEST_REAL_HOME = realHome;\n}\n\nif (!process.env.HOME || path.resolve(process.env.HOME) === path.resolve(realHome)) {\n  const isolatedHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-test-home-\"));\n  process.env.HOME = isolatedHome;\n  process.env.XDG_CONFIG_HOME = path.join(isolatedHome, \".config\");\n  process.env.XDG_DATA_HOME = path.join(isolatedHome, \".local\", \"share\");\n  process.env.XDG_STATE_HOME = path.join(isolatedHome, \".local\", \"state\");\n  process.env.XDG_CACHE_HOME = path.join(isolatedHome, \".cache\");\n  process.env.NEXUS_STATE_DIR = path.join(isolatedHome, \".nexus\");\n}\n/**\n * What the detached-runner tests share (BG-1): a throwaway HOME and state directory, the real CLI as runner and\n * client processes, and cleanup that stops every runner, worker and tool process by pid after checking it is still the\n * process that was started (pid + kernel start time), never by name.\n */\nimport fs from \"node:fs\";\nimport http from \"node:http\";\nimport type { Socket } from \"node:net\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execFileSync, spawn, type ChildProcess } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { JobRunner, runnerAlive, specDigest, submitRequest, unattendedSpec, type JobRunnerOptions, type SpawnedWorker } from \"../../src/core/job_runner.js\";\nimport { descendants, identityOf, sameProcess, signalProcess, type ProcessIdentity } from \"../../src/core/process_identity.js\";\nimport { DEFAULT_JOB_BUDGETS, listJobs, newJobIds, readJob, RUNNER_FILE_VERSION, runnerPaths, writePrivateJson, type JobRecord, type JobState, type JobSubmission, type RunnerPaths, type WorkerResult } from \"../../src/core/runner_store.js\";\nimport { cliEntry } from \"./audit_fixture.js\";\n\nconst CLI_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n\nexport interface CliProcess {\n  proc: ChildProcess;\n  identity: ProcessIdentity | undefined;\n  exited: Promise<{ code: number | null; signal: NodeJS.Signals | null }>;\n  stdout(): string;\n  stderr(): string;\n}\n\nexport interface RunnerWorld {\n  root: string;\n  home: string;\n  stateDir: string;\n  paths: RunnerPaths;\n  env: NodeJS.ProcessEnv;\n  /** Starts the CLI and returns at once. */\n  spawn(args: string[], env?: Record<string, string>): CliProcess;\n  /** Runs the CLI to its end. */\n  run(args: string[], env?: Record<string, string>): Promise<{ code: number | null; stdout: string; stderr: string }>;\n  /** `nexus runner serve`, returned once it holds the runner lock. */\n  startRunner(args?: string[], env?: Record<string, string>): Promise<CliProcess>;\n  job(id: string): JobRecord | undefined;\n  /** Waits until the job is in one of `states`; the error names where it was instead. */\n  waitJob(id: string, states: JobState[], timeoutMs?: number): Promise<JobRecord>;\n  /** Notes every process below `pid` now, so cleanup can stop the ones that outlive it. */\n  remember(pid: number): void;\n  /** The remembered processes that are still running. */\n  survivors(): ProcessIdentity[];\n  /** Stops everything this world started and removes its directories. Call from `finally`. */\n  cleanup(): Promise<void>;\n}\n\nexport async function until<T>(read: () => T | undefined | false, timeoutMs: number, what: () => string): Promise<T> {\n  for (const deadline = Date.now() + timeoutMs; ;) {\n    let value: T | undefined | false;\n    try { value = read(); } catch { value = undefined; }\n    if (value !== undefined && value !== false) return value;\n    if (Date.now() > deadline) throw new Error(`timed out waiting for ${what()}`);\n    await new Promise((resolve) => setTimeout(resolve, 50));\n  }\n}\n\nexport function runnerWorld(): RunnerWorld {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-runner-\"));\n  const home = path.join(root, \"home\");\n  const stateDir = path.join(root, \"state\");\n  fs.mkdirSync(home, { recursive: true, mode: 0o700 });\n  const paths = runnerPaths(path.join(stateDir, \"runner\"));\n  const env: NodeJS.ProcessEnv = { ...process.env };\n  // No operator setting reaches these processes: only what a test passes.\n  for (const key of Object.keys(env)) if (/^(LOCAL_LLM_|LOCAL_HARNESS_|NEXUS_|GIT_)/.test(key) || key === \"NODE_TEST_CONTEXT\" || key === \"FORCE_COLOR\") delete env[key];\n  Object.assign(env, { HOME: home, NEXUS_STATE_DIR: stateDir, NO_COLOR: \"1\", XDG_CONFIG_HOME: path.join(home, \".config\"), XDG_DATA_HOME: path.join(home, \".local\", \"share\"), XDG_STATE_HOME: path.join(home, \".local\", \"state\"), XDG_CACHE_HOME: path.join(home, \".cache\") });\n  const started: CliProcess[] = [];\n  const remembered: ProcessIdentity[] = [];\n\n  const spawnCli = (args: string[], extra: Record<string, string> = {}): CliProcess => {\n    const proc = spawn(process.execPath, [...cliEntry(), ...args], { cwd: CLI_DIR, env: { ...env, ...extra }, stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n    let stdout = \"\";\n    let stderr = \"\";\n    proc.stdout!.on(\"data\", (chunk) => (stdout += chunk));\n    proc.stderr!.on(\"data\", (chunk) => (stderr += chunk));\n    const exited = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve, reject) => {\n      proc.once(\"error\", reject);\n      proc.once(\"close\", (code, signal) => resolve({ code, signal }));\n    });\n    const cli: CliProcess = { proc, identity: proc.pid === undefined ? undefined : identityOf(proc.pid), exited, stdout: () => stdout, stderr: () => stderr };\n    started.push(cli);\n    return cli;\n  };\n\n  const remember = (pid: number) => {\n    for (const child of [pid, ...descendants([pid])]) {\n      const identity = identityOf(child);\n      if (identity && !remembered.some((r) => r.pid === identity.pid && r.startTicks === identity.startTicks)) remembered.push(identity);\n    }\n  };\n\n  const job = (id: string) => readJob(paths, id);\n\n  return {\n    root, home, stateDir, paths, env,\n    spawn: spawnCli,\n    run: async (args, extra) => {\n      const cli = spawnCli(args, extra);\n      const { code } = await cli.exited;\n      return { code, stdout: cli.stdout(), stderr: cli.stderr() };\n    },\n    startRunner: async (args = [], extra) => {\n      const cli = spawnCli([\"runner\", \"serve\", ...args], extra);\n      await until(() => {\n        if (cli.proc.exitCode !== null || cli.proc.signalCode !== null) throw new Error(\"exited\");\n        return fs.existsSync(paths.runnerJson) && runnerAlive(paths);\n      }, 90_000, () => `the runner to hold its lock\\n${cli.stderr()}`).catch((error) => {\n        throw new Error(`${error.message}\\nrunner exit ${cli.proc.exitCode}\\n${cli.stderr()}`);\n      });\n      return cli;\n    },\n    job,\n    waitJob: (id, states, timeoutMs = 120_000) => until(() => {\n      const record = job(id);\n      return record && states.includes(record.state) ? record : undefined;\n    }, timeoutMs, () => {\n      let stderr = \"\";\n      try { stderr = fs.readFileSync(paths.stderr(id), \"utf8\").slice(-2000); } catch { /* none */ }\n      return `job ${id} to be ${states.join(\" or \")}; it is ${JSON.stringify(job(id), null, 1)}\\nworker stderr: ${stderr}\\nrunner: ${started.map((c) => c.stderr().slice(-1500)).join(\"\\n---\\n\")}`;\n    }),\n    remember,\n    survivors: () => remembered.filter((identity) => sameProcess(identity)),\n    cleanup: async () => {\n      // Workers are detached from the runner, so each is found through the record of its attempts.\n      try {\n        for (const record of listJobs(paths).jobs) for (const attempt of record.attempts) remember(attempt.pid);\n// One node:test run over the given files (one file at a time) with a per-file watchdog. Started by run_tests.mjs in its\n// own process group; reports to the parent on fd 3 as JSON lines: {\"timeout\":file,\"tail\":[...]} when the file under test\n// exceeds NEXUS_TEST_FILE_TIMEOUT_SECS (the parent then kills the group and restarts with the remaining files), and\n// {\"done\":true,\"tests\":n,\"fail\":n} when the run ends. Output keeps the spec reporter format, with colour on a TTY.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { run } from \"node:test\";\nimport { spec } from \"node:test/reporters\";\n\nconst files = process.argv.slice(2);\nconst cwd = process.cwd();\nconst timeoutMs = (Number(process.env.NEXUS_TEST_FILE_TIMEOUT_SECS) > 0 ? Number(process.env.NEXUS_TEST_FILE_TIMEOUT_SECS) : 300) * 1000;\nconst report = (message) => fs.writeSync(3, `${JSON.stringify(message)}\\n`);\n\nconst stream = run({ files, concurrency: 1, isolation: \"process\", execArgv: [\"--import\", \"tsx\"] });\nlet timer;\nlet tail = [];\nconst lastLines = (text) => { tail = [...tail, ...String(text).split(\"\\n\").filter(Boolean)].slice(-20); };\nconst watch = (file) => {\n  clearTimeout(timer);\n  tail = [];\n  timer = setTimeout(() => report({ timeout: file, tail }), timeoutMs);\n};\n// The watchdog is armed by the first top-level event of each file. Node 24 emits one named after the file itself; Node 22\n// (process isolation) emits only the file's own top-level tests, so keying on a file-named event never armed it there.\nlet current;\nlet startedAt = 0;\nconst secondsSinceStart = () => (Date.now() - startedAt) / 1000;\nconst reportDuration = (file) => {\n  if (!file || !startedAt) return;\n  report({ duration: { file: path.relative(cwd, file).split(path.sep).join(\"/\"), secs: Math.round(secondsSinceStart() * 100) / 100 } });\n};\nstream.on(\"test:dequeue\", (e) => {\n  if (e.nesting === 0 && e.file && e.file !== current) {\n    reportDuration(current);\n    current = e.file;\n    startedAt = Date.now();\n    watch(e.file);\n  }\n});\nstream.on(\"test:stdout\", (e) => lastLines(e.message));\nstream.on(\"test:stderr\", (e) => lastLines(e.message));\nstream.on(\"test:pass\", (e) => lastLines(`ok ${e.name}`));\nstream.on(\"test:fail\", (e) => lastLines(`not ok ${e.name}`));\nlet counts = { tests: 0, failed: 0 };\nstream.on(\"test:summary\", (e) => { if (!e.file) counts = e.counts; });\nconst output = stream.compose(new spec());\noutput.pipe(process.stdout, { end: false });\noutput.on(\"end\", () => {\n  clearTimeout(timer);\n  reportDuration(current);\n  report({ done: true, tests: counts.tests, fail: counts.failed });\n  process.stdout.write(\"\", () => process.exit(counts.failed ? 1 : 0));\n});\n  assert.equal(all, \"\\n=== Nexus Code Tool Execution Audit Log (7 entries) ===\\n\\n2026-11-22 10:00:01 | PASS | read_file        |   11ms\\n2026-11-22 10:00:02 | PASS | read_file        |   22ms\\n2026-11-22 10:00:03 | PASS | run_command      |   33ms\\n2026-11-22 10:00:04 | FAIL | read_file        |   44ms\\n  └─ Error: boom 4\\n2026-11-22 10:00:05 | PASS | read_file        |   55ms\\n2026-11-22 10:00:06 | PASS | run_command      |   66ms\\n2026-11-22 10:00:07 | PASS | read_file        |   77ms\\n\\n\");\n\n  const home = tempDir();\n  fs.mkdirSync(path.join(home, \".nexus\"));\n  fs.writeFileSync(path.join(home, \".nexus\", \"audit.log\"), `${records.join(\"\\n\")}\\n`);\n  const bundle = path.join(home, \"some-bundle\");\n  const env = { HOME: home };\n  const [plain, limited, errors, bogus, typo, typoWithOption] = await runAuditBatch([\n    () => runAudit([], env),\n    () => runAudit([\"--limit\", \"5\"], env),\n    () => runAudit([\"--errors\", \"-n\", \"3\"], env),\n    () => runAudit([\"bogus\", \"x\"], env),\n    () => runAudit([\"verfy\", bundle], env),\n    () => runAudit([\"--limit\", \"5\", \"exprot\", \"task-1\"], env),\n  ]);\n  assert.deepEqual([plain.code, plain.stdout, plain.stderr], [0, all, \"\"]);\n  assert.deepEqual([limited.code, limited.stdout, limited.stderr], [0, lastFive, \"\"]);\n  assert.deepEqual([errors.code, errors.stdout], [0, `\\n=== Nexus Code Tool Execution Audit Log (1 entries) ===\\n\\n${row(4)}\\n`]);\n  // Before: each of these printed the log and exited 0, which reads as a verification that passed.\n  for (const [run, name] of [[bogus, \"bogus\"], [typo, \"verfy\"], [typoWithOption, \"exprot\"]] as const) {\n    assert.equal(run.code, 2, run.stderr);\n    assert.equal(run.stdout, \"\", \"the audit log is not printed\");\n    assert.match(run.stderr, new RegExp(`^error: unknown audit subcommand '${name}'\\\\. The subcommands are \\`export\\` and \\`verify\\``));\n  }\n});\n\ntest(\"the CLI signs with an operator key, verifies against the public key, and never copies the private key\", async () => {\n  const subject = savedSubject({ flight: false, diff: false });\n  const { privateKey, publicKey } = generateKeyPairSync(\"ed25519\");\n  const privatePath = path.join(subject.root, \"operator-private.pem\");\n  const publicPath = path.join(subject.root, \"operator-public.pem\");\n  const wrongPublicPath = path.join(subject.root, \"wrong-public.pem\");\n  fs.writeFileSync(privatePath, privateKey.export({ type: \"pkcs8\", format: \"pem\" }));\n  fs.writeFileSync(publicPath, publicKey.export({ type: \"spki\", format: \"pem\" }));\n  fs.writeFileSync(wrongPublicPath, generateKeyPairSync(\"ed25519\").publicKey.export({ type: \"spki\", format: \"pem\" }));\n  const out = subject.out(\"signed-bundle\");\n  const env = stateEnv(subject);\n  const exported = await runAudit([\"export\", subject.id, \"--out\", out, \"--sign-key\", privatePath, \"--json\"], env);\n  const exportedDoc = consume(exported);\n  assert.deepEqual([exported.code, exportedDoc.result, exportedDoc.signed], [0, \"exported\", true]);\n  assert.equal(fs.existsSync(path.join(out, \"manifest.sig.json\")), true);\n  assert.equal(fs.readdirSync(out).some((name) => name.includes(\"private\")), false);\n  const checked = await runAudit([\"verify\", out, \"--public-key\", publicPath, \"--json\"]);\n  assert.deepEqual([checked.code, consume(checked).result, consume(checked).signature], [0, \"intact_signed\", \"valid\"]);\n  const mismatched = await runAudit([\"verify\", out, \"--public-key\", wrongPublicPath, \"--json\"]);\n  assert.deepEqual([mismatched.code, consume(mismatched).result, consume(mismatched).findings[0].kind], [1, \"tampered\", \"signature_key_mismatch\"]);\n  const unchecked = await runAudit([\"verify\", out, \"--json\"]);\n  assert.deepEqual([unchecked.code, consume(unchecked).result], [2, \"signature_unchecked\"]);\n});\n\ntest(\"an unknown option, a missing argument or an extra one is a parse error, not ignored\", async () => {\n    }\n  });\n});\n\ntest(\"run-now needs a runner and a trusted workspace, and refuses while the schedule's previous job runs\", { timeout: 120_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    assert.equal((await add(world, repo, \"--name\", \"n\", \"--every\", \"15m\")).code, 0);\n    const none = await world.run([\"schedule\", \"run-now\", \"n\"]);\n    assert.equal(none.code, 2);\n    assert.match(none.stderr, /no runner is running/);\n    assert.equal((await world.run([\"trust\", \"--remove\", repo])).code, 0);\n    const untrusted = await world.run([\"schedule\", \"run-now\", \"n\"]);\n    assert.equal(untrusted.code, 2);\n    assert.match(untrusted.stderr, /not a trusted workspace/);\n  });\n});\n\ntest(\"two run-now at once start one job: the running-job check and the runner's acceptance happen under the schedule lock\", { timeout: 240_000 }, async () => {\n  const world = runnerWorld();\n  const repo = fs.realpathSync(makeRepo({ \"README.md\": \"hello\\n\" }));\n  const gw = await stalledGateway();\n  try {\n    assert.equal((await world.run([\"trust\", repo])).code, 0);\n    assert.equal((await add(world, repo, \"--name\", \"n\", \"--every\", \"15m\", \"-e\", gw.url, \"-m\", \"m\")).code, 0);\n    await world.startRunner();\n    const runs = await Promise.all([world.run([\"schedule\", \"run-now\", \"n\"]), world.run([\"schedule\", \"run-now\", \"n\"])]);\n    const ok = runs.filter((run) => run.code === 0);\n    const refused = runs.filter((run) => run.code === 2);\n    assert.equal(ok.length, 1, JSON.stringify(runs));\n    assert.equal(refused.length, 1, JSON.stringify(runs));\n    assert.match(refused[0].stderr, /still has a running job/);\n    assert.equal(listJobs(world.paths).jobs.filter((job) => job.origin.kind === \"schedule\" && job.origin.scheduleId === \"n\").length, 1);\n  } finally {\n    await world.cleanup();\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n  }\n});\n\ntest(\"add warns that a read-only run does not run its verifier\", { timeout: 120_000 }, async () => {\n  await withWorld(async (world, repo, trusted) => {\n    await trusted();\n    const result = await add(world, repo, \"--name\", \"w\", \"--every\", \"15m\", \"--verifier\", \"node --test\");\n    assert.equal(result.code, 0, result.stderr);\n    assert.match(result.stderr, /a read-only run does not run its verifier/);\n","exit_code":0,"duration":{"secs":0,"nanos":762936299}},"started_at_ms":1795848363161,"completed_at_ms":1795848363925}}
