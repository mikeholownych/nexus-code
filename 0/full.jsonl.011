{"timestamp":"2026-11-28T06:46:47.225Z","ordinal":315070,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a220e5-c285-7e72-9bb5-c6a32a48db70","item":{"type":"CommandExecution","id":"exec-db7c1b81-75f8-4a75-b4fc-11cef2e8babc","process_id":"61246","command":["/usr/bin/zsh","-lc","sed -n '170,280p' cli/src/core/shared_resource_admission.ts; sed -n '1,180p' cli/src/core/file_guard.ts; sed -n '1,80p' cli/test/helpers/leak_guard.ts; sed -n '25,95p' cli/test/helpers/runner_fixture.ts; sed -n '1,65p' cli/test/helpers/audit_fixture.ts; sed -n '400,430p' cli/test/helpers/audit_fixture.ts; sed -n '20,45p' cli/test/audit_command.test.ts"],"cwd":"file:///home/mike/nexus-wt/p10-04-active-client-admission-continued","parsed_cmd":[{"type":"read","cmd":"sed -n '170,280p' cli/src/core/shared_resource_admission.ts","name":"shared_resource_admission.ts","path":"cli/src/core/shared_resource_admission.ts"},{"type":"read","cmd":"sed -n '1,180p' cli/src/core/file_guard.ts","name":"file_guard.ts","path":"cli/src/core/file_guard.ts"},{"type":"read","cmd":"sed -n '1,80p' cli/test/helpers/leak_guard.ts","name":"leak_guard.ts","path":"cli/test/helpers/leak_guard.ts"},{"type":"read","cmd":"sed -n '25,95p' cli/test/helpers/runner_fixture.ts","name":"runner_fixture.ts","path":"cli/test/helpers/runner_fixture.ts"},{"type":"read","cmd":"sed -n '1,65p' cli/test/helpers/audit_fixture.ts","name":"audit_fixture.ts","path":"cli/test/helpers/audit_fixture.ts"},{"type":"read","cmd":"sed -n '400,430p' cli/test/helpers/audit_fixture.ts","name":"audit_fixture.ts","path":"cli/test/helpers/audit_fixture.ts"},{"type":"read","cmd":"sed -n '20,45p' cli/test/audit_command.test.ts","name":"audit_command.test.ts","path":"cli/test/audit_command.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"      try {\n        return acquireFileGuard(guardPath, { label: \"Shared resource admission guard\", waitMs: this.guardWaitMs });\n      } catch (error) {\n        throw new ResourceAdmissionConflictError(`cannot establish shared resource admission: ${(error as Error).message}`);\n      }\n    } finally {\n      releaseFileGuard(catalog);\n    }\n  }\n\n  acquire(resource: ResourceDescriptor): ResourceSlotLease | null {\n    const key = resourceKey(resource);\n    const capacity = capacityOf(resource, this.operatorMaxUnits);\n    return this.acquireKey(key, capacity, \"shared inference resource\", \"Shared inference resource slot\", false);\n  }\n\n  /** Reserves a bounded named local resource using the same cross-process kernel slot mechanism. */\n  acquireNamed(name: string, capacity: number, label: string): ResourceSlotLease | null {\n    if (!/^[a-z0-9][a-z0-9._:-]{0,127}$/i.test(name)) {\n      throw new ResourceAdmissionConflictError(\"named shared resource identity is invalid; admission refused\");\n    }\n    if (!Number.isSafeInteger(capacity) || capacity < 1 || capacity > MAX_CONCURRENT_UNITS) {\n      throw new ResourceAdmissionConflictError(`named shared resource capacity is invalid; expected 1..${MAX_CONCURRENT_UNITS}`);\n    }\n    if (typeof label !== \"string\" || !/^[a-z][a-z0-9 -]{0,63}$/i.test(label)) {\n      throw new ResourceAdmissionConflictError(\"named shared resource label is invalid; admission refused\");\n    }\n    const key = createHash(\"sha256\").update(JSON.stringify({ kind: \"named\", name })).digest(\"hex\");\n    return this.acquireKey(key, capacity, `shared ${label}`, `Shared ${label} slot`, true);\n  }\n\n  private acquireKey(key: string, capacity: number, scope: string, slotLabel: string, inheritSlot: boolean): ResourceSlotLease | null {\n    ensureAdmissionDirectory(this.directory);\n    const prefix = path.join(this.directory, key);\n    const mutex = this.acquireIdentityGuard(prefix);\n    if (!mutex) return null;\n\n    let slot: FileGuard | null = null;\n    try {\n      const capacityFile = `${prefix}.json`;\n      const existing = readCapacity(capacityFile);\n      if (!existing && this.probeActiveSlots(prefix, MAX_CONCURRENT_UNITS, scope, slotLabel) > 0) {\n        throw new ResourceAdmissionConflictError(`${scope} admission metadata is missing while a slot is active; admission refused`);\n      }\n      if (existing && existing.capacity !== capacity) {\n        const active = this.probeActiveSlots(prefix, existing.capacity, scope, slotLabel);\n        if (active > 0) {\n          throw new ResourceAdmissionConflictError(\n            `active operations declare different capacities (${existing.capacity} and ${capacity}) for the same ${scope}`,\n          );\n        }\n      }\n      const effectiveCapacity = existing?.capacity === capacity ? existing.capacity : capacity;\n      for (let index = 0; index < effectiveCapacity; index++) {\n        try {\n          slot = acquireFileGuard(`${prefix}.slot-${index}`, { label: slotLabel });\n        } catch (error) {\n          throw new ResourceAdmissionConflictError(`cannot reserve ${scope} slot: ${(error as Error).message}`);\n        }\n        if (slot) break;\n      }\n      if (!slot) return null;\n      if (!existing || existing.capacity !== effectiveCapacity) {\n        try {\n          writeFileDurably(capacityFile, JSON.stringify({ format: \"NEXUS_RESOURCE_ADMISSION\", version: 1, capacity: effectiveCapacity } satisfies CapacityRecord));\n        } catch (error) {\n          releaseFileGuard(slot);\n          slot = null;\n          throw error;\n        }\n      }\n      const held = slot;\n      slot = null;\n      return {\n        ...(inheritSlot ? { inheritedFd: held.fd } : {}),\n        release: () => releaseFileGuard(held),\n      };\n    } finally {\n      if (slot) releaseFileGuard(slot);\n      releaseFileGuard(mutex);\n    }\n  }\n\n  private probeActiveSlots(prefix: string, capacity: number, scope: string, slotLabel: string): number {\n    let active = 0;\n    for (let index = 0; index < capacity; index++) {\n      if (!fs.existsSync(`${prefix}.slot-${index}`)) continue;\n      let probe: FileGuard | null;\n      try {\n        probe = acquireFileGuard(`${prefix}.slot-${index}`, { label: slotLabel });\n      } catch (error) {\n        throw new ResourceAdmissionConflictError(`cannot inspect ${scope} slots: ${(error as Error).message}`);\n      }\n      if (probe) releaseFileGuard(probe);\n      else active++;\n    }\n    return active;\n  }\n}\n/** Kernel-owned file guard shared by upgrade recovery and multi-file state transactions. */\nimport * as fs from \"node:fs\";\nimport { spawnSync } from \"node:child_process\";\n\nexport interface FileGuard { path: string; fd: number }\nconst released = new WeakSet<FileGuard>();\n\nexport interface FileGuardOptions {\n  utility?: string;\n  label?: string;\n  waitMs?: number;\n  mode?: \"exclusive\" | \"shared\";\n}\n\n/** Rejects a guard we do not solely own: wrong type, foreign owner, or permissive mode. */\nfunction validateGuardIdentity(guardPath: string, fd: number, label: string): void {\n  const self = fs.fstatSync(fd);\n  if (!self.isFile()) throw new Error(`${label} is not a regular file`);\n  if (typeof process.getuid === \"function\" && self.uid !== process.getuid()) throw new Error(`${label} is not owned by the running user`);\n  if ((self.mode & 0o077) !== 0) throw new Error(`${label} has unsafe permissions (${(self.mode & 0o777).toString(8)})`);\n  if (self.nlink !== 1) throw new Error(`${label} has unexpected hard links`);\n  const current = fs.lstatSync(guardPath, { throwIfNoEntry: false });\n  if (!current?.isFile() || current.ino !== self.ino || current.dev !== self.dev) throw new Error(`${label} path is redirected`);\n}\n\nfunction openGuardFile(guardPath: string, label: string): number {\n  // Fail closed on platforms without no-follow/non-blocking open support.\n  if (fs.constants.O_NOFOLLOW === undefined || fs.constants.O_NONBLOCK === undefined) {\n    throw new Error(`${label} requires O_NOFOLLOW/O_NONBLOCK open support`);\n  }\n  let fd: number;\n  let created = false;\n  try {\n    // O_CREAT|O_EXCL never follows a symlink, so creation is race-free.\n    fd = fs.openSync(guardPath, fs.constants.O_RDWR | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NONBLOCK, 0o600);\n    created = true;\n  } catch (error: any) {\n    if (error.code !== \"EEXIST\") throw error;\n    try {\n      // The kernel refuses to follow a symlinked path under O_NOFOLLOW (ELOOP)\n      // and O_NONBLOCK prevents any special file from blocking the open, so no\n      // check-to-open race exists; identity is then verified on the descriptor.\n      fd = fs.openSync(guardPath, fs.constants.O_RDWR | fs.constants.O_NONBLOCK | fs.constants.O_NOFOLLOW);\n    } catch (openError: any) {\n      if (openError.code === \"ELOOP\") throw new Error(`${label} path is redirected`);\n      throw openError;\n    }\n  }\n  try { if (created) fs.fchmodSync(fd, 0o600); validateGuardIdentity(guardPath, fd, label); }\n  catch (error) { fs.closeSync(fd); throw error; }\n  return fd;\n}\n\n/**\n * Returns null on contention; every unsuccessful path closes its descriptor.\n * The utility exits immediately after acquiring a lock on the shared open file\n * description. The caller retains that descriptor through its critical section.\n * Never unlink or replace a guard: SIGKILL releases ownership in the kernel.\n */\nexport function acquireFileGuard(guardPath: string, options: FileGuardOptions = {}): FileGuard | null {\n  const label = options.label ?? \"File guard\";\n  const utility = options.utility ?? \"/usr/bin/flock\";\n  const waitMs = options.waitMs ?? 0;\n  if (!Number.isSafeInteger(waitMs) || waitMs < 0) throw new Error(\"Invalid file-guard wait bound\");\n  const fd = openGuardFile(guardPath, label);\n  try {\n    const args = [...(options.mode === \"shared\" ? [\"--shared\"] : []), ...(waitMs ? [\"-w\", String(waitMs / 1000)] : [\"-n\"]), \"-E\", \"75\", \"3\"];\n    const probe = spawnSync(utility, args, { stdio: [\"ignore\", \"ignore\", \"ignore\", fd], timeout: Math.max(2000, waitMs + 1000) });\n    if (probe.error) throw new Error(`${label} utility ${utility} is unavailable: ${probe.error.message}`);\n    if (probe.status === 0) { validateGuardIdentity(guardPath, fd, label); return { path: guardPath, fd }; }\n    if (probe.status === 75) { fs.closeSync(fd); return null; }\n    throw new Error(`${label} acquisition failed (exit ${probe.status})`);\n  } catch (error) {\n    try { fs.closeSync(fd); } catch {}\n    throw error;\n  }\n}\n\nexport function releaseFileGuard(guard: FileGuard | null): void {\n  if (!guard || released.has(guard)) return;\n  released.add(guard);\n  try { fs.closeSync(guard.fd); } catch {}\n}\n/**\n * Leak and hang guard: `import \"./helpers/leak_guard.js\";` at the top of a test file fails the file in teardown, naming\n * every RustCoreBridge or AutonomousAgent not shut down, scripted gateway not closed, child process still running and\n * timer still pending, then releases them so the process can exit instead of hanging the job.\n * Resources it cannot see by itself (a custom server) can be registered with `trackResource`.\n * Timers: ref'd timeouts above the count when the file finished loading (a timer created while the file loads is not\n * counted; node:test's own timers are gone by teardown). The check hook is registered once the file has finished\n * loading, so it runs after the file's own `after` hooks; a file that registers hooks after a top-level `await` can run\n * its hooks after the guard's check, and should then release in the test itself.\n */\nimport { after } from \"node:test\";\nimport childProcess from \"node:child_process\";\nimport { RustCoreBridge } from \"../../src/tools.js\";\nimport { survivors, trackResource, clearTracked } from \"./leak_registry.js\";\n\nexport { trackResource };\n\nconst proto = childProcess.ChildProcess.prototype as any;\nconst originalSpawn = proto.spawn;\nproto.spawn = function (this: childProcess.ChildProcess, ...args: unknown[]) {\n  const result = originalSpawn.apply(this, args);\n  const command = [String((this as any).spawnfile ?? \"\"), ...((this as any).spawnargs ?? []).slice(1)].join(\" \").slice(0, 120);\n  trackResource(\"child process\", `pid ${this.pid} ${command}`, () => this.exitCode === null && this.signalCode === null, () => {\n    try { process.kill(-(this.pid as number), \"SIGKILL\"); } catch { this.kill(\"SIGKILL\"); }\n  });\n  return result;\n};\n\nlet baselineTimers = 0;\nfunction activeTimers(): number {\n  return process.getActiveResourcesInfo().filter((r) => r === \"Timeout\").length;\n}\n\nexport function describeSurvivors(): string[] {\n  const lines = survivors().map((s) => `${s.kind}: ${s.name}`);\n  for (const bridge of (RustCoreBridge as any).activeBridges as Set<RustCoreBridge>) lines.push(`RustCoreBridge not shut down (workspace ${(bridge as any).workspace}); an AutonomousAgent owns one: call agent.shutdown()`);\n  const timers = activeTimers() - baselineTimers;\n  if (timers > 0) lines.push(`${timers} timer(s) still pending`);\n  return lines;\n}\n\n// Registered once the file has finished loading so it runs after the file's own `after` hooks.\nqueueMicrotask(() => {\n  baselineTimers = activeTimers();\n  after(async () => {\n    let lines = describeSurvivors();\n    for (let i = 0; i < 20 && lines.length; i++) {\n      await new Promise((r) => setTimeout(r, 100));\n      lines = describeSurvivors();\n    }\n    if (!lines.length) return;\n    for (const s of survivors()) await Promise.resolve(s.release()).catch(() => {});\n    (RustCoreBridge as any).shutdownAllGlobal();\n    clearTracked();\n    setTimeout(() => process.stdout.write(\"\", () => process.exit(1)), 5_000).unref();\n    throw new Error(`${process.argv[1] ?? \"test file\"} leaked ${lines.length} resource(s) past the end of the file:\\n  ${lines.join(\"\\n  \")}`);\n  });\n});\n  stderr(): string;\n}\n\nexport interface RunnerWorld {\n  root: string;\n  home: string;\n  stateDir: string;\n  paths: RunnerPaths;\n  env: NodeJS.ProcessEnv;\n  /** Starts the CLI and returns at once. */\n  spawn(args: string[], env?: Record<string, string>): CliProcess;\n  /** Runs the CLI to its end. */\n  run(args: string[], env?: Record<string, string>): Promise<{ code: number | null; stdout: string; stderr: string }>;\n  /** `nexus runner serve`, returned once it holds the runner lock. */\n  startRunner(args?: string[], env?: Record<string, string>): Promise<CliProcess>;\n  job(id: string): JobRecord | undefined;\n  /** Waits until the job is in one of `states`; the error names where it was instead. */\n  waitJob(id: string, states: JobState[], timeoutMs?: number): Promise<JobRecord>;\n  /** Notes every process below `pid` now, so cleanup can stop the ones that outlive it. */\n  remember(pid: number): void;\n  /** The remembered processes that are still running. */\n  survivors(): ProcessIdentity[];\n  /** Stops everything this world started and removes its directories. Call from `finally`. */\n  cleanup(): Promise<void>;\n}\n\nexport async function until<T>(read: () => T | undefined | false, timeoutMs: number, what: () => string): Promise<T> {\n  for (const deadline = Date.now() + timeoutMs; ;) {\n    let value: T | undefined | false;\n    try { value = read(); } catch { value = undefined; }\n    if (value !== undefined && value !== false) return value;\n    if (Date.now() > deadline) throw new Error(`timed out waiting for ${what()}`);\n    await new Promise((resolve) => setTimeout(resolve, 50));\n  }\n}\n\nexport function runnerWorld(): RunnerWorld {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-runner-\"));\n  const home = path.join(root, \"home\");\n  const stateDir = path.join(root, \"state\");\n  fs.mkdirSync(home, { recursive: true, mode: 0o700 });\n  const paths = runnerPaths(path.join(stateDir, \"runner\"));\n  const env: NodeJS.ProcessEnv = { ...process.env };\n  // No operator setting reaches these processes: only what a test passes.\n  for (const key of Object.keys(env)) if (/^(LOCAL_LLM_|LOCAL_HARNESS_|NEXUS_|GIT_)/.test(key) || key === \"NODE_TEST_CONTEXT\" || key === \"FORCE_COLOR\") delete env[key];\n  Object.assign(env, { HOME: home, NEXUS_STATE_DIR: stateDir, NO_COLOR: \"1\", XDG_CONFIG_HOME: path.join(home, \".config\"), XDG_DATA_HOME: path.join(home, \".local\", \"share\"), XDG_STATE_HOME: path.join(home, \".local\", \"state\"), XDG_CACHE_HOME: path.join(home, \".cache\") });\n  const started: CliProcess[] = [];\n  const remembered: ProcessIdentity[] = [];\n\n  const spawnCli = (args: string[], extra: Record<string, string> = {}): CliProcess => {\n    const proc = spawn(process.execPath, [...cliEntry(), ...args], { cwd: CLI_DIR, env: { ...env, ...extra }, stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n    let stdout = \"\";\n    let stderr = \"\";\n    proc.stdout!.on(\"data\", (chunk) => (stdout += chunk));\n    proc.stderr!.on(\"data\", (chunk) => (stderr += chunk));\n    const exited = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve, reject) => {\n      proc.once(\"error\", reject);\n      proc.once(\"close\", (code, signal) => resolve({ code, signal }));\n    });\n    const cli: CliProcess = { proc, identity: proc.pid === undefined ? undefined : identityOf(proc.pid), exited, stdout: () => stdout, stderr: () => stderr };\n    started.push(cli);\n    return cli;\n  };\n\n  const remember = (pid: number) => {\n    for (const child of [pid, ...descendants([pid])]) {\n      const identity = identityOf(child);\n      if (identity && !remembered.some((r) => r.pid === identity.pid && r.startTicks === identity.startTicks)) remembered.push(identity);\n    }\n  };\n\n/**\n * What the audit-bundle tests share (GV-2): a fixture with one artefact of every kind, the schema checks every manifest\n * and result document goes through, a helper that re-seals a manifest the way someone rewriting a bundle would, and a\n * spy that records every path handed to `node:fs`