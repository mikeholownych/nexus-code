   return this.acquireKey(key, capacity, `shared ${label}`, `Shared ${label} slot`, true);\n  }\n\n  private acquireKey(key: string, capacity: number, scope: string, slotLabel: string, inheritSlot: boolean): ResourceSlotLease | null {\n    ensureAdmissionDirectory(this.directory);\n    const prefix = path.join(this.directory, key);\n    const mutex = this.acquireIdentityGuard(prefix);\n    if (!mutex) return null;\n\n    let slot: FileGuard | null = null;\n    try {\n      const capacityFile = `${prefix}.json`;\n      const existing = readCapacity(capacityFile);\n      if (!existing && this.probeActiveSlots(prefix, MAX_CONCURRENT_UNITS, scope, slotLabel) > 0) {\n        throw new ResourceAdmissionConflictError(`${scope} admission metadata is missing while a slot is active; admission refused`);\n      }\n      if (existing && existing.capacity !== capacity) {\n        const active = this.probeActiveSlots(prefix, existing.capacity, scope, slotLabel);\n        if (active > 0) {\n          throw new ResourceAdmissionConflictError(\n            `active operations declare different capacities (${existing.capacity} and ${capacity}) for the same ${scope}`,\n          );\n        }\n      }\n      const effectiveCapacity = existing?.capacity === capacity ? existing.capacity : capacity;\n      for (let index = 0; index < effectiveCapacity; index++) {\n        try {\n          slot = acquireFileGuard(`${prefix}.slot-${index}`, { label: slotLabel });\n        } catch (error) {\n          throw new ResourceAdmissionConflictError(`cannot reserve ${scope} slot: ${(error as Error).message}`);\n        }\n        if (slot) break;\n      }\n      if (!slot) return null;\n      if (!existing || existing.capacity !== effectiveCapacity) {\n        try {\n          writeFileDurably(capacityFile, JSON.stringify({ format: \"NEXUS_RESOURCE_ADMISSION\", version: 1, capacity: effectiveCapacity } satisfies CapacityRecord));\n        } catch (error) {\n          releaseFileGuard(slot);\n          slot = null;\n          throw error;\n        }\n      }\n      const held = slot;\n      slot = null;\n      return …3844 tokens truncated…oad: { ok: true, output: \"contents héllo ✓\" } },\n  { type: \"session_end\", timestamp: 4, payload: { summary: \"done\", success: true } },\n];\nconst text = (value: string): Uint8Array => Buffer.from(value, \"utf8\");\n  if (entry) return entry;\n  const built = path.join(CLI_DIR, \"dist\", \"index.js\");\n  const current = fs.existsSync(built) && fs.statSync(built).mtimeMs >= newestMtime(path.join(CLI_DIR, \"src\"));\n  return (entry = current ? [built] : [\"--import\", \"tsx\", \"src/index.ts\"]);\n}\n\nexport interface AuditCliRun { code: number | null; stdout: string; stderr: string; leftovers: string[] }\n\n/**\n * Runs `nexus audit <args>` (see `cliEntry`) with a throwaway HOME, its own temp directory and no operator\n * environment but `env`. `leftovers`: what the command left in that temp directory (the export's private copy would be one).\n */\nexport function runAudit(args: string[], env: Record<string, string> = {}): Promise<AuditCliRun> {\n  const base = { ...process.env };\n  for (const key of Object.keys(base)) if (/^(LOCAL_LLM_|LOCAL_HARNESS_|NEXUS_|GIT_)/.test(key) || key === \"NODE_TEST_CONTEXT\" || key === \"FORCE_COLOR\" || key === \"NO_COLOR\") delete base[key];\n  const home = env.HOME ?? makeHome();\n  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-audit-test-tmp-\"));\n  return new Promise((resolve, reject) => {\n    const child = spawn(process.execPath, [...cliEntry(), \"audit\", ...args], {\n      cwd: CLI_DIR,\n      env: { ...base, HOME: home, TMPDIR: tmp, NO_COLOR: \"1\", XDG_CONFIG_HOME: path.join(home, \".config\"), XDG_DATA_HOME: path.join(home, \".local\", \"share\"), XDG_STATE_HOME: path.join(home, \".local\", \"state\"), XDG_CACHE_HOME: path.join(home, \".cache\"), ...env },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout!.on(\"data\", (chunk) => (stdout += chunk));\n    child.stderr!.on(\"data\", (chunk) => (stderr += chunk));\n    child.on(\"error\", reject);\n    child.on(\"close\", (code) => {\n      const leftovers = fs.readdirSync(tmp).filter((name) => name.startsWith(\"nexus-\"));\n      fs.rmSync(tmp, { recursive: true, force: true });\n\nconst MANUAL = path.resolve(CLI_DIR, \"..\", \"docs\", \"USER_MANUAL.md\");\nconst stateEnv = (subject: SubjectFixture): Record<string, string> => ({ NEXUS_STATE_DIR: path.join(subject.root, \"state\") });\n\n/** Keep the real-CLI subprocess fan-out bounded on slower CI workers. */\nasync function runAuditBatch(calls: Array<() => Promise<AuditCliRun>>, concurrency = 2): Promise<AuditCliRun[]> {\n  const results: AuditCliRun[] = [];\n  for (let start = 0; start < calls.length; start += concurrency) {\n    results.push(...await Promise.all(calls.slice(start, start + concurrency).map((call) => call())));\n  }\n  return results;\n}\n\n/** What a consumer does with `--json`: stdout is exactly one document of the published schema, and `exitCode` is the process's. */\nfunction consume(run: AuditCliRun): any {\n  let document: any;\n  try {\n    document = JSON.parse(run.stdout);\n  } catch {\n    assert.fail(`stdout is not one JSON document: ${run.stdout.slice(0, 200)}\\nstderr: ${run.stderr.slice(0, 400)}`);\n  }\n  assert.equal(run.stdout, `${JSON.stringify(document, null, 2)}\\n`, \"nothing but the document on stdout\");\n  assert.deepEqual(validate(document, AUDIT_VERIFY_SCHEMA, AUDIT_VERIFY_SCHEMA), [], \"the document validates against docs/protocol/audit-verify-result schema\");\n  assert.equal(Object.keys(document)[0], \"schema_version\");\n  assert.equal(document.exitCode, run.code, \"exitCode repeats the process exit code\");\n  assert.deepEqual(run.leftovers, [], \"nothing is left in the temp directory\");\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a220e5-c285-7e72-9bb5-c6a32a48db70","create_time":17