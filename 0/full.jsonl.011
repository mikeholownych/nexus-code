tyMismatchError extends TaskStateError {\n302:export class WorkspaceIdentityMismatchError extends TaskStateError {\n328:  state: DurableTaskState;\n356:export function defaultTaskStateDir(): string {\n368:    const baseDir = options.baseDir || defaultTaskStateDir();\n374:  public getBaseDir(): string {\n378:  public setWorkspacePaths(workspacePaths: WorkspacePath[]): void {\n382:  public getStateFilePath(taskId: string): string {\n385:      throw new TaskStateReadError(\"unknown\", \"Task identity is not a safe persistence name\");\n390:  public getMessageLogFilePath(taskId: string): string {\n395:  public readRawOperationSchemaVersion(taskId: string): unknown {\n414:        throw new TaskStateNotFoundError(taskId, filePath);\n416:      throw new TaskStateReadError(taskId, error.message);\n455:      throw new TaskStateReadError(taskId, `Failed to read message journal: ${(error as any)?.message ?? String(error)}`);\n483:        throw new TaskStateWriteError(\"unknown\", \"A different or redirected pre-migration backup already exists\");\n489:          throw new TaskStateWriteError(\"unknown\", \"A different or redirected pre-migration backup already exists\");\n507:  public archivePath(taskId: string): string {\n513:  public appendArchive(taskId: string, compactionId: string, messages: ChatMessage[], record?: unknown): void {\n520:  public readArchive(taskId: string, committed?: ReadonlySet<string>): ArchiveRead<ChatMessage> {\n524:  public hasTaskState(taskId: string): boolean {\n528:  public deleteTaskState(taskId: string): boolean {\n529:    return withStateStoreGuard(this.baseDir, () => this.deleteTaskStateLocked(taskId));\n532:  private deleteTaskStateLocked(taskId: string): boolean {\n571:  public saveTaskState(state: DurableTaskState, workspacePaths: WorkspacePath[] = this.workspacePaths, options: { historical?: boolean } = {}): void {\n572:    withStateStoreGuard(this.baseDir, () => this.saveTaskStateLocked(state, workspacePaths, options));\n575:  private saveTaskStateLocked(state: DurableTaskState, workspacePaths: WorkspacePath[], options: { historical?: boolean } = {}): DurableTaskState {\n577:      throw new TaskStateWriteError(\"unknown\", \"Missing required taskId\");\n580:      throw new TaskStateWriteError(\"unknown\", \"Invalid state schema version\");\n584:      // The same rules as loadTaskState applies (state_schema.ts), so a record this build writes is one it can read.\n587:      if (problem) throw new TaskStateWriteError(state.taskId, problem.reason);\n592:    if (lifecycleProblem) throw new TaskStateWriteError(state.taskId, lifecycleProblem);\n598:    let protectedState: DurableTaskState;\n604:      protectedState = redactTaskStateForPersistence(state, authorizedPaths, options);\n624:      throw new TaskStateWriteError(\"unknown\", `Sensitive-data protection or ${protectionPhase} failed${conflict}`);\n659:      if (err instanceof TaskStateError) throw err;\n660:      throw new TaskStateWriteError(safeTaskId, `filesystem persistence failed (${String(err?.code ?? err?.message ?? err).slice(0, 80)})`);\n668:  public loadTaskState(\n672:  ): DurableTaskState {\n673:    return withStateStoreGuard(this.baseDir, () => this.loadTaskStateLocked(taskId, expectedWorkspace, workspacePaths));\n676:  private loadTaskStateLocked(taskId: string, expectedWorkspace: string | undefined, workspacePaths: WorkspacePath[], protectOnLoad = true): DurableTaskState {\n680:    const state: DurableTaskState = this.migrateIfLegacy(record.parsed, taskId);\n726:      const protectedState = redactTaskStateForPersistence(state, selectedPaths, { historical: true });\n734:        throw new TaskStateReadError(taskId, \"Sensitive data intersects durable state identity\");\n738:        this.saveTaskState(protectedState, selectedPaths, { historical: true });\n742:      if (error instanceof TaskStateError) throw error;\n743:      throw new TaskStateReadError(taskId, \"Sensitive-data protection failed during state recovery\");\n766:  public recordOperationStart(\n776:  ): DurableTaskState {\n778:      const state = this.loadTaskStateLocked(taskId, undefined, this.workspacePaths, false);\n779:      state.currentOperation = {\n790:      return this.saveTaskStateLocked(state, this.workspacePaths);\n797:  public recordOperationEnd(\n802:  ): DurableTaskState {\n804:      const state = this.loadTaskStateLocked(taskId, undefined, this.workspacePaths, false);\n805:      const op = state.currentOperation;\n812:      return this.saveTaskStateLocked(state, this.workspacePaths);\n821:  public recordProgress(\n832:  ): DurableTaskState {\n834:      const state = this.loadTaskStateLocked(taskId, undefined, this.workspacePaths, false);\n837:        if (state.currentOperation && state.currentOperation.status !== \"in_flight\") state.currentOperation = null;\n845:      return this.saveTaskStateLocked(state, this.workspacePaths);\n852:  public recordMilestone(\n860:  ): DurableTaskState {\n867:  ): DurableTaskState {\n868:    const state = this.loadTaskState(taskId);\n893:    this.saveTaskState(state);\n900:  public recordCandidateAndReceipt(\n907:  ): DurableTaskState {\n914:  ): DurableTaskState {\n915:    const state = this.loadTaskState(taskId);\n933:    this.saveTaskState(state);\n947:  public recoverTaskState(\n951:    return withStateStoreGuard(this.baseDir, () => this.recoverTaskStateLocked(taskId, options));\n954:  private recoverTaskStateLocked(taskId: string, options: TaskRecoveryOptions): TaskRecoveryResult {\n959:    const state = this.loadTaskState(\n974:    const op = state.currentOperation;\n1067:    this.saveTaskState(state, recoveryWorkspacePaths, { historical: true });\n1092:  public listTasks(options?: { workspace?: string }): Array<{\n1183:  public quarantineFile(filePath: string): string {\n1200:  private normalizeWorktreeBinding(state: DurableTaskState, taskId: string, record: StoredTaskRecord): void {\n1209:   * Safely migrates legacy session files (schemaVersion 0 or undefined) into the complete Dur