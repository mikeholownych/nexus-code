did.\n        timeout-minutes: 30\n        shell: bash\n        run: |\n          set -o pipefail\n          mkdir -p \"$RUNNER_TEMP/test-shard\"\n          export NEXUS_TEST_DURATIONS_OUT=\"$RUNNER_TEMP/test-shard/test-durations.json\"\n          npm --prefix cli run test:cli -- --shard=${{ matrix.shard }}/4 2>&1 | tee \"$RUNNER_TEMP/test-shard/suite.log\"\n      # Measured seconds per test file (input of `make test-durations-merge`) and the full suite output of this leg.\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        if: always()\n        with:\n          name: test-shard-node${{ matrix.node }}-${{ matrix.shard }}of4\n          path: ${{ runner.temp }}/test-shard/\n          if-no-files-found: ignore\n          retention-days: 14\n          overwrite: true\n\n  # The required checks. `always()` makes this job run, and fail, even when a leg failed, was skipped or was cancelled:\n  # a skipped required check would count as passing. The result of a matrix job is `success` only when every one of its\n","exit_code":0,"duration":{"secs":0,"nanos":103682413}},"started_at_ms":1795865720375,"completed_at_ms":1795865720479}}
