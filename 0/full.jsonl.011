{"timestamp":"2026-11-28T07:02:54.872Z","ordinal":315568,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a220e5-c285-7e72-9bb5-c6a32a48db70","item":{"type":"CommandExecution","id":"exec-30f927bd-4971-483c-a558-6adab3160bb1","process_id":"13993","command":["/usr/bin/zsh","-lc","git diff --check && git status --short && git diff -- cli/src/core/client_lease.ts cli/test/client_lease.test.ts && git rev-parse --show-toplevel && git rev-parse HEAD"],"cwd":"file:///home/mike/nexus-wt/p10-04-active-client-admission-continued","parsed_cmd":[{"type":"unknown","cmd":"git diff --check && git status --short && git diff -- cli/src/core/client_lease.ts cli/test/client_lease.test.ts && git rev-parse --show-toplevel && git rev-parse HEAD"}],"source":"unified_exec_startup","status":"completed","aggregated_output":" M cli/src/core/client_lease.ts\n M cli/test/client_lease.test.ts\ndiff --git a/cli/src/core/client_lease.ts b/cli/src/core/client_lease.ts\nindex 55eeac024..43227c167 100644\n--- a/cli/src/core/client_lease.ts\n+++ b/cli/src/core/client_lease.ts\n@@ -106,7 +106,7 @@ export function acquireClientLease(\n   if (activeLimit !== undefined) {\n     try {\n       const homeAdmissionDir = path.join(path.dirname(leasePath), path.basename(leasePath, \".guard\"), \"resource-admission\");\n-      const admission = new SharedResourceAdmission(homeAdmissionDir, { guardWaitMs: 0 });\n+      const admission = new SharedResourceAdmission(homeAdmissionDir, { guardWaitMs: 10_000 });\n       const slot = admission.acquireNamed(\"active-client-processes\", activeLimit, \"client process\");\n       if (!slot) {\n         releaseFileGuard(lease);\ndiff --git a/cli/test/client_lease.test.ts b/cli/test/client_lease.test.ts\nindex 9d40213c3..6f3c6be35 100644\n--- a/cli/test/client_lease.test.ts\n+++ b/cli/test/client_lease.test.ts\n@@ -2,7 +2,7 @@ import { after, describe, it } from \"node:test\";\n import assert from \"node:assert/strict\";\n import * as fs from \"node:fs\";\n import * as path from \"node:path\";\n-import { spawnSync } from \"node:child_process\";\n+import { spawn, spawnSync } from \"node:child_process\";\n import { fileURLToPath } from \"node:url\";\n import { acquireClientLease, releaseClientLease } from \"../src/core/client_lease.js\";\n \n@@ -34,6 +34,40 @@ function probe(targetHome: string, maxActiveClients: number): ReturnType<typeof\n   });\n }\n \n+function concurrentProbe(targetHome: string, maxActiveClients: number): Promise<{ status: number | null; stdout: string; stderr: string }> {\n+  const source = `\n+    import { acquireClientLease } from \"./src/core/client_lease.ts\";\n+    try {\n+      acquireClientLease(process.env.HOME, { maxActiveClients: ${maxActiveClients} });\n+      await new Promise(resolve => setTimeout(resolve, 100));\n+      console.log(\"admitted\");\n+    } catch (error) {\n+      console.log(error?.name ?? \"unknown-error\");\n+      if (error?.name !== \"ClientActiveLimitError\" && error?.name !== \"ResourceAdmissionConflictError\") process.exitCode = 2;\n+    }\n+  `;\n+  return new Promise((resolve, reject) => {\n+    const child = spawn(process.execPath, [\"--import\", \"tsx\", \"--input-type=module\", \"-e\", source], {\n+      cwd: cliRoot,\n+      env: { ...process.env, HOME: targetHome, XDG_CONFIG_HOME: path.join(targetHome, \".config\") },\n+      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n+    });\n+    let stdout = \"\";\n+    let stderr = \"\";\n+    child.stdout.setEncoding(\"utf8\").on(\"data\", (chunk) => { stdout += chunk; });\n+    child.stderr.setEncoding(\"utf8\").on(\"data\", (chunk) => { stderr += chunk; });\n+    const timeout = setTimeout(() => {\n+      stderr += \"\\nprobe timed out\";\n+      child.kill(\"SIGKILL\");\n+    }, 15_000);\n+    child.once(\"error\", reject);\n+    child.once(\"close\", (status) => {\n+      clearTimeout(timeout);\n+      resolve({ status, stdout, stderr });\n+    });\n+  });\n+}\n+\n after(() => fs.rmSync(testRoot, { recursive: true, force: true }));\n \n describe(\"cross-process client admission\", { skip: process.platform !== \"linux\" || typeof process.getuid !== \"function\" }, () => {\n@@ -64,6 +98,12 @@ describe(\"cross-process client admission\", { skip: process.platform !== \"linux\"\n     assert.equal(afterExit.stdout.trim(), \"admitted\");\n   });\n \n+  it(\"does not report capacity exhaustion when same-home clients contend for the admission guard\", async () => {\n+    const targetHome = home(\"concurrent-same-home\");\n+    const results = await Promise.all(Array.from({ length: 16 }, () => concurrentProbe(targetHome, 16)));\n+    assert.deepEqual(results.map((result) => [result.status, result.stdout.trim()]), Array.from({ length: 16 }, () => [0, \"admitted\"]));\n+  });\n+\n   it(\"admits separate homes independently for the same OS user\", () => {\n     const firstHome = home(\"home-one\");\n     const secondHome = home(\"home-two\");\n/home/mike/nexus-wt/p10-04-active-client-admission-continued\n7c644811a4acb62d71090d330bbbb32ee7957a0d\n","exit_code":0,"duration":{"secs":1,"nanos":166555298}},"started_at_ms":1795849373704,"completed_at_ms":1795849374871}}
