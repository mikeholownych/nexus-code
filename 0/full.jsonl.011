kens ?? compEst;\\n      this.totalTokens.total = this.totalTokens.prompt + this.totalTokens.completion;\\n      this.totalTokens.requests++;\\n      if (reported?.inputTokens !== undefined) this.totalTokens.reportedRequests++;\\n      else this.totalTokens.estimatedRequests++;\\n\\n      // Print any thought or explanation text only if not already streamed\\n      if (parsed.thoughtText && !streamedTokens) {\\n        this.ui.printThought(parsed.thoughtText);\\n      }\\n      // Reasoning (<think> blocks) is kept apart from the reply: recorded, never shown as output or parsed for tools.\\n      if ((parsed.thoughtText || parsed.reasoningText) && this.flightRecorder) {\"}]},\"match_line\":920,\"match_lines\":[920,934]}]},\"_token_budget\":{\"tokenizer\":\"standard-uax29-words\",\"max_tokens\":2000,\"hits_full\":3,\"hits_locator_only\":[{\"_index\":\"nexus-cli-docs\",\"_id\":\"9f8db5a84e72681b04ac9da6d8867e43\",\"ax_path\":\"slash/session_commands.ts\",\"ax_file\":\"axf2-74d7c66cd67198af4a249358e6b1a989-6f73\",\"ax_locator\":\"code\",\"match_line\":116,\"match_lines\":[85,108,113,116]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"e773276114f0e861438ce5646d3c60b3\",\"ax_path\":\"core/run_turn.ts\",\"ax_file\":\"axf2-72671dd31188b0f58ca422c980cb61c1-1787d\",\"ax_locator\":\"code\",\"match_line\":930,\"match_lines\":[930,944]}],\"deduped_overlapping\":0,\"hits_dropped\":0,\"tokens_used\":1880}}"}],"isError":false},"duration":{"secs":12,"nanos":439400246}},"started_at_ms":1795855758061,"completed_at_ms":1795855770501}}
