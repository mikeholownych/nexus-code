"INTERNAL\", message });\n        }\n        return;\n      case \"models.list\":\n        if (this.app.getAgent().getApprovalMode() === \"read-only\") {\n          this.emit({ type: \"error\", id: command.id, code: \"BUSY\", message: \"Provider discovery is disabled while the session is in read-only mode.\" });\n          return;\n        }\n        void this.modelsList(command.id);\n        return;\n      case \"model.select\":\n        if (this.app.getAgent().getApprovalMode() === \"read-only\") {\n          this.emit({ type: \"error\", id: command.id, code: \"BUSY\", message: \"Model changes are disabled while the session is in read-only mode.\" });\n          return;\n        }\n        this.modelSelect(command.id, command.provider, command.model);\n        return;\n      case \"provider.connect\":\n        if (this.app.getAgent().getApprovalMode() === \"read-only\") {\n          this.emit({ type: \"provider.result\", id: command.id, provider: command.provider, success: false, message: \"Provider connections are disabled while the session is in read-only mode.\" });\n          return;\n        }\n        void this.providerConnect(command.id, command.provider, command.method, command.key, command.endpoint);\n        return;\n      case \"provider.cancel\":\n        this.signIns.get(command.id)?.cancel();\n        this.signIns.delete(command.id);\n        cancelLocalEndpointSetup();\n        return;\n      case \"provider.disconnect\": {\n        if (this.app.getAgent().getApprovalMode() === \"read-only\") {\n          this.emit({ type: \"provider.result\", id: command.id, provider: command.provider, success: false, message: \"Provider changes are disabled while the session is in read-only mode.\" });\n          return;\n        }\n        const r = disconnect(command.provider);\n        this.emit({ type: \"provider.result\", id: command.id, provider: command.provider, success: r.ok, message: r.message });\n        return;\n      }\n      case \"shutdown\":\n        await this.shutdown();\n        return;\n    }\n  }\n\n  /** Sign-ins in progress, by request id (provider.cancel stops one). */\n  private signIns = new Map<string, { cancel(): void }>();\n\n  private async modelsList(id: string): Promise<void> {\n    try {\n      const catalog = await buildCatalog(this.app.getConfig());\n      this.emit({ type: \"models.catalog\", id, ...catalog });\n    } catch (err) {\n      this.emit({ type: \"error\", id, code: \"INTERNAL\", message: capText(redactSecrets(String((err as Error).message ?? err))) });\n    }\n  }\n\n  /** Switching models between turns is the operator's choice; during a turn it is refused like any command. */\n  private modelSelect(id: string, provider: string, model: string): void {\n    if (this.rejectBusy(id)) return;\n    const r = selectModel(this.app.getAgent(), this.app.getConfig(), { provider, model });\n    if (!r.ok && provider === \"appliance\") cancelLocalEndpointSetup();\n    this.emit({ type: \"model.result\", id, success: r.ok, message: r.message });\n    if (r.ok) this.emitSessionState();\n  }\n\n  private async providerConnect(id: string, provider: string, method: string, key?: string, endpoint?: string): Promise<void> {\n    const result = (success: boolean, message: string) =>\n      this.emit({ type: \"provider.result\", id, provider, success, message: capText(redactSecrets(message)) });\n    try {\n      if (provider === \"appliance\" && method === \"local-endpoint\") {\n        if (!endpoint) {\n          result(false, \"An endpoint URL is required.\");\n          return;\n        }\n        const prepared = await prepareLocalEndpoint(this.app.getConfig(), endpoint, key ?? \"\");\n        result(prepared.ok, prepared.message);\n        return;\n      }\n      if (method === \"api-key\") {\n        const r = await connectWithKey(this.app.getConfig(), provider, key ?? \"\");\n        result(r.ok, r.message);\n        return;\n      }\n      if (endpoint !== undefined) {\n        result(false, \"Endpoint URLs are only accepted for local endpoint setup.\");\n    authorizedDisclosureOrigins: [...new Set([...(base.authorizedDisclosureOrigins ?? []), origin])],\n  };\n}\n\nfunction validatedKey(input: string): string | undefined {\n  const key = input.trim();\n  return /[\\r\\n\\0]/.test(key) || (key && /\\s/.test(key)) ? undefined : key;\n}\n\n/** Verify a local endpoint and keep its endpoint and optional key provisional for the live model picker. */\nexport async function prepareLocalEndpoint(base: HarnessConfig, endpointInput: string, keyInput = \"\"): Promise<LocalEndpointPreparation> {\n  const parsed = validatedEndpoint(endpointInput);\n  if (!parsed) return { ok: false, message: \"Use an http:// or https:// endpoint without embedded credentials, query, or fragment.\" };\n  const key = validatedKey(keyInput);\n  if (key === undefined) return { ok: false, message: \"The API key must be a single value without whitespace.\" };\n  try {\n    const models = await new LocalLlmClient(localEndpointConfig(base, parsed.endpoint, parsed.origin, key)).listModels();\n    const available = models.filter((model) => /^[A-Za-z0-9._:/@+-]{1,160}$/.test(model));\n    if (available.length === 0) return { ok: false, message: \"That endpoint returned no usable chat models.\" };\n    activateApplianceEndpoint(parsed.endpoint, undefined, true, key || undefined);\n    return { ok: true, message: `Local endpoint verified (${parsed.origin}; ${available.length} models found). Choose a model to save setup.` };\n  } catch {\n    return { ok: false, message: \"Could not list models from that endpoint. Check the URL and API key, then try again.\" };\n  }\n}\n\n/** Discover a local OpenAI-compatible endpoint, then persist only its selected URL/model and origin-scoped key. */\nexport async function connectLocalEndpoint(\n  base: HarnessConfig,\n  endpointInput: string,\n  modelInput?: string,\n  const def = providerDefinition(providerId);\n  if (!def) return { ok: false, message: `Unknown provider '${providerId}'.` };\n  const removed = removeCredential(providerId);\n  const still = resolveCredential(providerId, def.credentialEnv);\n  if (still) {\n    return {\n      ok: removed,\n      message: `${removed ? \"Removed Nexus's saved credential. \" : \"\"}${def.label} is still connected via ${still.source}; Nexus does not change ${still.kind === \"env\" ? \"your environment\" : \"other clients' sign-ins\"}.`,\n    };\n  }\n  return { ok: removed, message: removed ? `${def.label} disconnected.` : `${def.label} had no credential saved by Nexus.` };\n}\n\n/**\n * Switches the agent to `ref` — the operator's explicit choice, which authorizes that destination for this session.\n * Returns the operator-facing outcome.\n */\nexport function selectModel(agent: AutonomousAgent, config: HarnessConfig, ref: ModelRef): { ok: boolean; message: string } {\n  const model = ref.model.trim();\n  if (!model) return { ok: false, message: \"Choose a model.\" };\n  if (ref.provider === APPLIANCE) {\n    const a = applianceConfig(config);\n    const pendingSelection = applianceEndpointSelection();\n    if (pendingSelection?.persistModelOnSelection && originOf(a.endpoint) === originOf(pendingSelection.endpoint)) {\n      try {\n        const pendingKey = pendingApplianceEndpointKey(a.endpoint);\n        if (pendingKey) {\n          const committed = commitLocalEndpointSetup(a.endpoint, pendingKey, () => saveLocalEndpointSettings(a.endpoint, model));\n          if (!committed) return { ok: false, message: \"The endpoint was verified, but Nexus could not securely save the API key.\" };\n        } else {\n          saveLocalEndpointSettings(a.endpoint, model);\n        }\n        activateApplianceEndpoint(a.endpoint, model, false);\n      } catch {\n        return { ok: false, message: \"The model is available for this session, but Nexus could not securely save the selection.\" };\n      }\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17885-133d-7581-bd2d-36a0306191af","create_time":1793024264.2428496}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
