d/`);\n663-  }\n664-\n665:  if (hostname === \"objects.githubusercontent.com\") {\n666-    return true;\n667-  }\n668-\n669-  return false;\n--\n687-\n688-  try {\n689-    while (hops <= maxHops) {\n690-      if (!validateDownloadUrl(currentUrl)) {\n691:        throw new Error(`Disallowed download origin or invalid URL: ${currentUrl}`);\n692-      }\n693-\n694-      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n695-      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n696:      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n697-        headers.Authorization = `Bearer ${token}`;\n698-      }\n699-\n700-      const res = await fetch(currentUrl, {\n701-        headers,\n702-        signal: controller.signal,\n703:        redirect: \"manual\",\n704-      });\n705-\n706:      // Handle redirect\n707-      if (res.status === 301 || res.status === 302 || res.status === 307 || res.status === 308) {\n708-        const location = res.headers.get(\"location\");\n709-        if (!location) {\n710:          throw new Error(`HTTP ${res.status} redirect without Location header from ${currentUrl}`);\n711-        }\n712-        currentUrl = new URL(location, currentUrl).toString();\n713-        hops++;\n714-        continue;\n--\n764-\n765-      return;\n766-    }\n767-\n768:    throw new Error(`Too many redirects (exceeded ${maxHops} hops) while downloading`);\n769-  } finally {\n770-    clearTimeout(timer);\n771-  }\n772-}\n--\n942-  const versionDir = path.join(libNexus, targetVersion);\n943-\n944-  fs.mkdirSync(libNexus, { recursive: true });\n945-  fs.mkdirSync(binDir, { recursive: true });\n946:  if (fs.realpathSync(libNexus) !== path.resolve(libNexus) || fs.realpathSync(binDir) !== path.resolve(binDir)) throw new Error(\"Managed installation roots must not be redirected by symlinks.\");\n947-\n948-  // 1. Concurrency lock\n949-  const lockFile = path.join(libNexus, \".upgrade.lock\");\n950-  let lockFd: number | null = null;\n--\n960-    writeOwnedLock();\n961-  } catch (err: any) {\n962-    if (err.code === \"EEXIST\") {\n963-      try {\n964:        if (!fs.lstatSync(lockFile).isFile() || fs.realpathSync(lockFile) !== path.resolve(lockFile)) throw new Error(\"Upgrade lock path is redirected\");\n965-        const existing = JSON.parse(fs.readFileSync(lockFile, \"utf8\"));\n966-        if (!Number.isSafeInteger(existing.pid) || existing.pid < 1) throw new Error(\"Upgrade lock owner is invalid\");\n967-        const staleStat = fs.lstatSync(lockFile), staleIno = staleStat.ino;\n968-        try { process.kill(existing.pid, 0); throw new Error(`Another upgrade process (PID ${existing.pid}) is currently running.`); }\n"},{"type":"input_text","text":"35-  acquireReclaimGuard,\n36-  releaseReclaimGuard,\n37-} from \"./upgrade_journal.js\";\n38-\n39-export const CANONICAL_REPO = \"mikeholownych/nexus-code\";\n40:export const DEFAULT_RELEASES_API = `https://api.github.com/repos/${CANONICAL_REPO}/releases`;\n41:export const DEFAULT_RELEASE_BASE_URL = `https://github.com/${CANONICAL_REPO}/releases`;\n42-\n43-export type InstallProvenance = \"packaged\" | \"development\" | \"package-manager\" | \"unsupported\";\n44-export type UpgradeAction = \"upgrade\" | \"downgrade\" | \"reinstall\" | \"none\";\n45-\n46-export interface ProvenanceRecord {\n--\n408-  const timer = setTimeout(() => controller.abort(new Error(`Request timed out after ${timeoutMs}ms`)), timeoutMs);\n409-  if (signal) {\n410-    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n411-  }\n412-  const headers: Record<string, string> = {\n413:    Accept: \"application/vnd.github+json\",\n414-    \"User-Agent\": \"nexus-upgrade\",\n415-  };\n416-  const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n417-  if (token) {\n418-    headers.Authorization = `Bearer ${token}`;\n--\n656-  // GitHub allowed domains - must be HTTPS\n657-  if (parsed.protocol !== \"https:\") {\n658-    return false;\n659-  }\n660-\n661:  if (hostname === \"github.com\") {\n662-    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n663-  }\n664-\n665:  if (hostname === \"objects.githubusercontent.com\") {\n666-    return true;\n667-  }\n668-\n669:  // GitHub now redirects release downloads to its signed release-assets host.\n670-  // Restrict the path to release objects; never allow this host as a generic CDN.\n671:  if (hostname === \"release-assets.githubusercontent.com\") {\n672:    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n673-  }\n674-\n675-  return false;\n676-}\n677-\n678:/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\n679-function safeDownloadOrigin(urlString: string): string {\n680-  try {\n681:    return new URL(urlString).origin;\n682-  } catch {\n683-    return \"invalid URL\";\n684-  }\n685-}\n686-\n--\n701-  }\n702-\n703-  try {\n704-    while (hops <= maxHops) {\n705-      if (!validateDownloadUrl(currentUrl)) {\n706:        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n707-      }\n708-\n709-      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n710-      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n711:      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n712-        headers.Authorization = `Bearer ${token}`;\n713-      }\n714-\n715-      const res = await fetch(currentUrl, {\n716-        headers,\n717-        signal: controller.signal,\n718:        redirect: \"manual\",\n719-      });\n720-\n721:      // Handle redirect\n722-      if (res.status === 301 || res.status === 302 || res.status === 307 || res.status === 308) {\n723-        const location = res.headers.get(\"location\");\n724-        if (!location) {\n725:          throw new Error(`HTTP ${res.status} redirect without Location header from ${safeDownloadOrigin(currentUrl)}`);\n726-        }\n727-        currentUrl = new URL(location, currentUrl).toString();\n728-        hops++;\n729-        continue;\n730-      }\n--\n778-      }\n779-\n780-      return;\n781-    }\n782-\n783:    throw new Error(`Too many redirects (exceeded ${maxHops} hops) while downloading`);\n784-  } finally {\n785-    clearTimeout(timer);\n786-  }\n787-}\n788-\n--\n956-  const linkPath = path.join(binDir, \"nexus\");\n957-  const versionDir = path.join(libNexus, targetVersion);\n958-\n959-  fs.mkdirSync(libNexus, { recursive: true });\n960-  fs.mkdirSync(binDir, { recursive: true });\n961:  if (fs.realpathSync(libNexus) !== path.resolve(libNexus) || fs.realpathSync(binDir) !== path.resolve(binDir)) throw new Error(\"Managed installation roots must not be redirected by symlinks.\");\n962-\n963-  // 1. Concurrency lock\n964-  const lockFile = path.join(libNexus, \".upgrade.lock\");\n965-  let lockFd: number | null = null;\n966-  let lockIno: number | undefined;\n--\n974-  try {\n975-    writeOwnedLock();\n976-  } catch (err: any) {\n977-    if (err.code === \"EEXIST\") {\n978-      try {\n979:        if (!fs.lstatSync(lockFile).isFile() || fs.realpathSync(lockFile) !== path.resolve(lockFile)) throw new Error(\"Upgrade lock path is redirected\");\n980-        const existing = JSON.parse(fs.readFileSync(lockFile, \"utf8\"));\n981-        if (!Number.isSafeInteger(existing.pid) || existing.pid < 1) throw new Error(\"Upgrade lock owner is invalid\");\n982-        const staleStat = fs.lstatSync(lockFile), staleIno = staleStat.ino;\n983-        try { process.kill(existing.pid, 0); throw new Error(`Another upgrade process (PID ${existing.pid}) is currently running.`); }\n984-        catch (probeErr: any) {\n"},{"type":"input_text","text":"d1f79e58a27c0f79f1663f662a153ae4ec5a7824 refs/tags/v1.0.0-rc.7\nf847ca34e5d99508baaf5e1105b5ebd9db005026 refs/tags/v1.0.0-rc.8\ntag\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17734-064a-7c40-9dfa-d9e4ca640901","create_time":1793001789.8144562}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
