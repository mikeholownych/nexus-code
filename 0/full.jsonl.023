n <v>] [--yes] [--force]`: compare the installed version with a published\ncli/src/slash/session_commands.ts:366:      `Installed version:  ${installed.version} (${installed.provenance})`,\ncli/src/slash/session_commands.ts:374:      lines.push(`\\nUpdate available: ${installed.version} -> ${comparison.targetVersion}. Run /upgrade to install.`);\ncli/src/slash/session_commands.ts:376:      lines.push(`\\nTarget ${comparison.targetVersion} is older than current ${installed.version}. Run /upgrade --version ${comparison.targetVersion} --allow-downgrade to downgrade.`);\ncli/src/slash/session_commands.ts:378:      lines.push(`\\nNexus is already up to date (${installed.version}).`);\ncli/src/slash/session_commands.ts:388:    return reply(\"upgrade\", `Nexus is already up to date (${installed.version}). Use /upgrade --force to reinstall.`, true);\ncli/src/slash/session_commands.ts:392:    return reply(\"upgrade\", `Target version ${comparison.targetVersion} is a downgrade from ${installed.version}. Specify --allow-downgrade to proceed.`, false);\ncli/src/slash/session_commands.ts:404:        `Proposed ${comparison.action}: ${installed.version} -> ${comparison.targetVersion}.\\nConfirmation required: run /upgrade --yes to apply, or review in interactive mode.`,\ncli/src/slash/session_commands.ts:409:    const targetDest = path.join(installed.prefix || \"\", \"lib/nexus\", comparison.targetVersion);\ncli/src/slash/session_commands.ts:412:      installedVersion: installed.version,\ncli/src/slash/session_commands.ts:415:      notice: \"Installs the release package and atomically swaps the launcher symlink. The running session continues safely on the current version until restart.\"\nscripts/terminal-acceptance/README.md:16:1. Install the RC with the documented one-line command. `nexus --version` must print the RC version, and `nexus` must\ncli/src/upgrade.ts:355:          installRoot: versionDir,\ncli/src/upgrade.ts:370:        installRoot: versionDir,\ncli/src/upgrade.ts:375:        detail: provRecord ? `Packaged installation at ${versionDir} (verified provenance)` : `Legacy packaged installation at ${versionDir}`,\ncli/src/upgrade.ts:590:    reasons.push(`Cannot determine installation layout for ${installed.version}.`);\ncli/src/upgrade.ts:596:    reasons.push(`Installed version identity '${installed.version}' is unknown; target is ${targetTag}.`);\ncli/src/upgrade.ts:662:    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\ncli/src/upgrade.ts:898:    return { success: false, error: \"No alternate installed version found to roll back to.\" };\ncli/src/upgrade.ts:946:  const { installed, targetVersion, action } = comparison;\ncli/src/upgrade.ts:1045:      sourceVersion:installed.version, sourceInstallDir:installed.installRoot || path.join(libNexus, installed.version),\ncli/src/upgrade.ts:1046:      sourceSymlinkTarget:path.join(installed.installRoot || path.join(libNexus, installed.version), \"bin\", \"nexus\"),\ncli/src/upgrade.ts:1047:      targetVersion, targetInstallDir:versionDir, stagingDir:tmpDir,\ncli/src/upgrade.ts:1182:      installed.version,\ncli/src/upgrade.ts:1203:    const stageVerify = verifyInstalledRuntime(packageRoot, targetVersion, options?.timeoutMs);\ncli/src/upgrade.ts:1214:        throw new Error(`${linkPath} points outside the Nexus installation (${oldTarget}); left it unchanged.`);\ncli/src/upgrade.ts:1219:    options?.onProgress?.(\"installing\", `Installing into ${versionDir}...`);\ncli/src/upgrade.ts:1245:      installedPath: versionDir,\ncli/src/upgrade.ts:1270:    const verifyRun = verifyInstalledRuntime(versionDir, targetVersion, options?.timeoutMs);\ncli/src/upgrade.ts:1293:      previousVersion: installed.version,\ncli/src/upgrade.ts:1295:      installedPath: versionDir,\ncli/src/upgrade.ts:1298:      restartNotice: `Nexus has been upgraded to ${targetVersion} in ${versionDir}. The current session continues running on ${installed.version}. Restart Nexus to activate the new version.${provenanceWarning ? `\\n\\n${provenanceWarning}` : \"\"}${pathWarning ? `\\n\\n${pathWarning}` : \"\"}`,\ncli/src/upgrade.ts:1452:              installedVersion: installed.version,\ncli/src/upgrade.ts:1480:              installedVersion: installed.version,\ncli/src/upgrade.ts:1500:        console.log(`Current version: ${installed.version} (${installed.provenance})`);\ncli/src/upgrade.ts:1511:          console.log(`\\nAn update is available: ${installed.version} -> ${comparison.targetVersion}.`);\ncli/src/upgrade.ts:1515:            `\\nTarget release ${comparison.targetVersion} is older than currently installed version ${installed.version}.`\ncli/src/upgrade.ts:1519:          console.log(`\\nNexus is already up to date (${installed.version}).`);\ncli/src/upgrade.ts:1535:              installedVersion: installed.version,\ncli/src/upgrade.ts:1557:              installedVersion: installed.version,\ncli/src/upgrade.ts:1559:              message: `Nexus is already at version ${installed.version}. Use --force to reinstall.`,\ncli/src/upgrade.ts:1566:        console.log(`Nexus is already up to date (${installed.version}). Use --force to reinstall.`);\ncli/src/upgrade.ts:1573:        const msg = `Target version ${comparison.targetVersion} is a downgrade from ${installed.version}. Non-interactive downgrade requires --allow-downgrade and --yes.`;\ncli/src/upgrade.ts:1587:        const msg = `nexus upgrade: ${comparison.action} from ${installed.version} to ${comparison.targetVersion} requires confirmation. Re-run with --yes in non-interactive scripts.`;\ncli/src/upgrade.ts:1597:      console.log(`  Installed:    ${installed.version} (${installed.provenance})`);\ncli/src/upgrade.ts:1599:      console.log(`  Destination:  ${path.join(installed.prefix || \"\", \"lib/nexus\", comparison.targetVersion)}`);\nscripts/terminal-acceptance/run-cell.sh:32:# Identity: the installed RC package (VERSION and its own MANIFEST.sha256), never a checkout build.\ncli/src/upgrade_journal.ts:465:    if (!options.forceRollback && journal.state === \"verified\" && verifyInstalledRuntime(journal.targetInstallDir, journal.targetVersion, options.timeoutMs).healthy) {\ncli/src/upgrade_journal.ts:478:      if (!verifyInstalledRuntime(saved, sameVersion ? journal.sourceVersion : journal.targetVersion, options.timeoutMs).healthy && sameVersion) throw new Error(\"Preserved source package failed runtime validation; retained for manual intervention\");\ncli/src/upgrade_journal.ts:487:    const health = verifyInstalledRuntime(journal.sourceInstallDir, journal.sourceVersion, options.timeoutMs);\ncli/src/repl.ts:899:              console.log(`Installed version:  ${installed.version} (${installed.provenance})`);\ncli/src/repl.ts:906:                console.log(pc.green(`\\nUpdate available: ${installed.version} -> ${comparison.targetVersion}. Run /upgrade to install.\\n`));\ncli/src/repl.ts:908:                console.log(pc.yellow(`\\nTarget ${comparison.targetVersion} is older than current ${installed.version}. Run /upgrade --version ${comparison.targetVersion} --allow-downgrade to downgrade.\\n`));\ncli/src/repl.ts:910:                console.log(pc.green(`\\nNexus is already up to date (${installed.version}).\\n`));\ncli/src/repl.ts:921:              console.log(pc.green(`Nexus is already up to date (${installed.version}). Use /upgrade --force to reinstall.\\n`));\ncli/src/repl.ts:926:              console.log(pc.yellow(`Target version ${comparison.targetVersion} is a downgrade from ${installed.version}. Specify --allow-downgrade to proceed.\\n`));\ncli/src/repl.ts:932:                pc.bold(pc.white(`Proceed with ${comparison.action} from ${installed.version} to ${comparison.targetVersion}? [y/N]: `))\ncli/src/index.ts:1098:  .description(\"Compare installed version with a published release and safely upgrade\")\ncli/src/index.ts:1103:  .option(\"-f, --force\", \"Force reinstallation even if already at target version\")\nscripts/ensure-ci-bubblewrap.sh:8:readonly SOURCE_URL=https://github.com/containers/bubblewrap/releases/download/v0.13.1/bubblewrap-0.13.1.tar.xz\nscripts/smoke-package.sh:18:# One version everywhere (REQ-REL-103): a fresh install's engine check passes, never a version warning.\ndocs/DEVELOPMENT.md:41:The no-version installer path follows the latest stable release. While only prereleases are published, use `NEXUS_VERSION` to pin a prerelease as shown in the [quickstart](../quickstart.md).\nscripts/installer-smoke.sh:137:  echo \"installer reused a version directory with a different archive digest\" >&2\ndocs/PHASE2S_SECURITY_AND_DATA_REVIEW.md:273:  4. A command executed by the model (e.g. `curl`, `wget`, `npm install`, `cargo build` with a `build.rs` script) can read sensitive host credentials (`~/.ssh/id_rsa`, `~/.aws/credentials`, `~/.config/nexus/config.env`) and transmit them directly to an external server.\ndocs/USER_MANUAL.md:93:- Revert the launcher symlink to the previous installed version:\ndocs/USER_MANUAL.md:102:Inside the interactive live TUI, run `/upgrade` or `/upgrade --check`. The TUI displays the installed vs target version, destination, and requires deliberate modal confirmation before modifying any files. Running TUI sessions continue uninterrupted on their loaded code and notify when a restart is required.\ndocs/UPGRADE_SECURITY.md:9:The self-upgrade mechanism enables operators to update their active Nexus installation to newer (or pinned) published releases directly from the CLI or TUI. Because executable updates run with the user's execution privileges and can replace core harness and TUI binaries, rigorous boundary enforcement is mandatory:\ndocs/UPGRADE_SECURITY.md:32:  - `https://github.com/mikeholownych/nexus-code/releases/download/`\ndocs/UPGRADE_SECURITY.md:60:- The installer and updater write `.provenance.json` (mode 0644) inside `$PREFIX/lib/nexus/$VERSION`.\ndocs/UPGRADE_SECURITY.md:68:- `--rollback-binary` safely rolls back the launcher symlink to the previous installed version in `$PREFIX/lib/nexus`.\ndocs/reviews/NEXUS_DOCTOR_RECOVERED_REQUEST.md:40:   - Installation version, runtime compatibility, and executable resolution.\ndocs/releases/v0.1.0-alpha.2.md:7:This is the second 0.x alpha. Like `v0.1.0-alpha.1`, it is not a stable release; install it by pinning `NEXUS_VERSION=v0.1.0-alpha.2`.\ndocs/releases/v0.1.0-alpha.2.md:27:- `scripts/installer-smoke.sh` now derives its upgrade-test version from the version under test, instead of a fixed `v0.1.0-alpha.2` that would have collided with this release.\ndocs/reviews/NEXUS_TOP_TIER_QUALIFICATION_ASSESSMENT_2026-10-12.md:231:REPRODUCED · D2 no CI and no remote, P1 · D3 installation is the dev checkout (no versioned install/upgrade/rollback),\ndocs/v1.0.0/READINESS.md:31:**Authoritative source and source gates:** `origin/main` is `1f3c655971ade086f55347926db16cf2ecd52d1f`, merging PR #161's pinned Linux builder/reproducibility changes. Exact-main CI [39957281380](https://github.com/mikeholownych/nexus-code/actions/runs/39957281380) completed successfully: Node 22, Node 24, and Linux x86-64 jobs all passed, including the full CLI suite, security gates, requirements check, reproducible package builds, SBOM validation, package smoke, and installer smoke. Exact-main CodeQL [39957281390](https://github.com/mikeholownych/nexus-code/actions/runs/39957281390) also passed. On a clean detached checkout of this exact SHA with isolated HOME/XDG, `node scripts/check_requirements.mjs --enforce` passed: 123 rows (108 tested, 6 partial, 2 implemented, 7 open), with 12 explicit exact-RC qualification deferrals. `node scripts/sync-version.mjs --check` reports all components at `1.0.0-rc.3`. These are source-gate results; the CI package is validation output, not a new published RC.\ndocs/v1.0.0/READINESS.md:41:**Release disposition and next actions:** Campaign status is `NEXUS_V1_CONVERGENCE_ACTIVE`; acceptance is `IN_PROGRESS`. RC3 is published but unaccepted; no stable v1.0.0 release is claimed. Exact-main CI and CodeQL now pass on `1f3c655`; the pinned-builder documentation claim still needs a safe owner handoff and reconciliation. Continue the installed-candidate qualification lanes, resolve held-out corpus compatibility with the independent custodian, and prepare a new versioned RC only through the accepted process after its prerequisites pass. Exact-RC qualification, independent acceptance, and final publication remain gated by their evidence. Publication authorization remains granted and gated.\ndocs/v1.0.0/READINESS.md:45:**Exact source gates:** `origin/main` and the signed `v1.0.0-rc.3` tag resolve to source commit `1b9791f07d301c885fe48f04a796203583ab5a5c`. Exact-main CI [39923089278](https://github.com/mikeholownych/nexus-code/actions/runs/39923089278) and CodeQL [39923089363](https://github.com/mikeholownych/nexus-code/actions/runs/39923089363) completed successfully on that commit. CI passed Node 22, Node 24, Linux CLI tests, security gates, requirements checks, two-build package reproducibility, SBOM validation, package smoke, and installer smoke. `node scripts/sync-version.mjs --check --tag v1.0.0-rc.3` and `node scripts/check_requirements.mjs --enforce` passed at the same source; the latter reports 123 rows (108 tested, 6 partial, 2 implemented, 7 open), with 12 explicit exact-RC qualification deferrals. This is source-gate evidence, not product acceptance.\ndocs/v1.0.0/READINESS.md:49:**Installed-candidate and checkpoint-choice observation:** The published installer completed with `NEXUS_VERIFY_ATTESTATION=1` and installed RC3 under `/home/mike/.local/lib/nexus/v1.0.0-rc.3`; installer provenance records the exact archive digest and source revision. `/home/mike/.local/bin/nexus --version` reports `1.0.0-rc.3 (1b9791f07d30)`. The previous RC1 directory remains installed at `/home/mike/.local/lib/nexus/v1.0.0-rc.1` for rollback. The coordinator reported an automated PTY probe of the installed default TUI using a synthetic Git workspace, fake credential-shaped canary, and unreachable loopback endpoint. The reported probe displayed the five choices and selected cancel before inference. Its transcript/capture was not retained in the release evidence tree, so this observation is unarchived and was not independently verified in the readiness review. It is diagnostic context only: it does not establish the checkpoint-choice gate, the five-environment by three-size human terminal matrix, or provider/task qualification.\ndocs/v1.0.0/READINESS.md:53:**Release disposition:** Campaign status is `NEXUS_V1_RC_QUALIFICATION_ACTIVE`; acceptance remains `IN_PROGRESS`. RC3 is a published candidate, not an accepted RC. No stable v1.0.0 release is claimed. The installed command now uses RC3; RC1 remains available by its versioned path. The next critical dependency is accepted held-out custody and runner compatibility; other exact-RC gates can proceed independently where their required providers and environments are available.\ndocs/v1.0.0/READINESS.md:59:**Source gates:** PR #159 (`a81f79df35a76207751ffd8a86640baafca98eeb`) merged as `1b9791f`. Its exact-head Node 22, Node 24, Linux package/reproducibility/install-smoke, and CodeQL checks passed; independent source review accepted the change. The focused Doctor schema-2 empty-history regression passed 1/1 with isolated HOME. At exact post-merge source `1b9791f`, `node scripts/sync-version.mjs --check` passes with all components at `1.0.0-rc.3`; `node scripts/check_requirements.mjs --enforce` passes with 123 rows (108 tested, 6 partial, 2 implemented, 7 open) and 12 explicit exact-RC qualification deferrals. Post-merge CI run [39923089278](https://github.com/mikeholownych/nexus-code/actions/runs/39923089278) and CodeQL run [39923089363](https://github.com/mikeholownych/nexus-code/actions/runs/39923089363) are running on the exact merge commit; do not claim post-merge CI complete until both terminate successfully.\ndocs/v1.0.0/READINESS.md:61:**Checkpoint failure:** `/home/mike/.local/bin/nexus` resolves to the installed `v1.0.0-rc.1` package and reports `1.0.0-rc.1 (cb364c386c42)`. That immutable package lacks checkpoint choices, so the reported failure before turn start is reproducible by version identity and will persist on RC1. The fix is integrated in PR #147 (TUI/sidecar) and PR #153 (legacy REPL): before starting a turn, Nexus asks the operator whether to use read-only mode, continue in the configured mode without a rollback checkpoint, create the checkpoint with the sensitive-content risk acknowledged, cancel, or enter a different instruction. Both PRs passed exact-head checks, and the subsequent exact-main CI on `dac465d` passed. No replacement package has been installed. The public release page still has RC1 only; RC2 has a tag but no published release, and RC3 has neither tag nor release.\ndocs/v1.0.0/READINESS.md:69:**Authoritative release source:** `origin/main` is `1a484c38518688005e9434b18c889c77b408e145`, the PR #155 merge commit. PRs #153, #154, and #155 are merged. PR #153 integrated the checkpoint-choice flow; PR #154 refreshed readiness and the terminal worksheet; PR #155 fixed the remaining doctor integrity-scan timeout by batching metadata checks. PR #155 exact-head CI `39893335185`, CodeQL `39893335167`, and independent review passed on head `76b34f1d18d766b06011176a85679e7c3434ba30`. Current-main CI run [39896372677](https://github.com/mikeholownych/nexus-code/actions/runs/39896372677) completed successfully on exact `1a484c38518688005e9434b18c889c77b408e145`: Node 24 at 03:56:55Z, Node 22 at 03:57:48Z, and Linux x86-64 packaging/reproducibility/package-smoke/installer-smoke at 04:11:34Z. Its Linux job validated identical package archives, checksums, notices, SBOM and installer across two builds. Current-main CodeQL run [39896372726](https://github.com/mikeholownych/nexus-code/actions/runs/39896372726) completed successfully at 03:43:55Z on that same SHA. CI’s Linux package used existing `1.0.0-rc.2` version metadata; it is source CI evidence, not an immutable RC3 artifact or qualification.\ndocs/v1.0.0/READINESS.md:222:  - `ACCEPTANCE.md` §1.1 (`77102c5`, PR #13) defines the five-stage RC lifecycle binding source gates, workflow-built RC artifact construction, RC artifact gates (`ACC-SUP-01/02/03/06/08`), installed-RC qualification, and version-only stable promotion.\ndocs/v1.0.0/READINESS.md:336:- Published asset hashes and provenance attestations verified against the release workflow and exact tag. The official installer installed the archive on the authenticated engineering host; its version, package manifest and provenance sidecar matched the candidate.\ndocs/v1.0.0/READINESS.md:338:- Ubuntu/GNOME is reachable and has all five required terminal applications, but `gh auth status` there reports no GitHub login. The RC5 installer stopped before creating files; the version-scoped desktop install prefix is absent. The manual terminal matrix is **0/15**.\ndocs/v1.0.0/ACCEPTANCE.md:28:5. **Stable promotion and publication.** After exact-RC acceptance and G6 pass, create a stable-version commit directly on the accepted RC commit, changing only the synchronized version metadata required for v1.0.0. Record both commits and the version-only diff. Run required source CI and all applicable source G0–G4 checks on this exact stable-version commit before tagging. If any other source changes, restart RC construction and qualification. Then create the `v1.0.0` tag on that checked commit and build a draft release. Keep its assets unpublished while verifying the stable artifact identity, provenance, package contents, installation, and publication metadata. Compare the stable package contents with the accepted RC; if packaged behavior or content differs beyond version-specific metadata, rerun affected installed-RC qualification gates and obtain independent acceptance for the stable artifact. Publish the draft only after these checks pass and the signed acceptance disposition is recorded. Record the published digests and provenance.\ndocs/v1.0.0/ACCEPTANCE.md:41:| REQ-REL-003 | ACC-PLAT | Installed-RC platform and Node-version matrix |\ndocs/v1.0.0/ACCEPTANCE.md:273:| Fresh install, each image with Node ≥ 22 | Documented one-line command with `NEXUS_VERSION=<rc>`, then the no-version command after v1.0.0 is published | Installed. `nexus --version` equals the RC. `nexus doctor` shows no version warning and an empty stderr. |\ndocs/v1.0.0/ACCEPTANCE.md:277:| Repair | Delete a file in the version dir, then reinstall | Repaired (REQ-REL-105). Same-version reinstall preserves working files if package fails verification. |\ndocs/v1.0.0/REQUIREMENTS.md:204:| REQ-REL-115 | Scope addition | CLI (`nexus upgrade`) and TUI (`/upgrade`) compare installed version with releases and safely upgrade to latest stable or pinned version. | user maintenance / lifecycle | `cli/src/upgrade.ts`, `cli/src/slash/session_commands.ts` | TEST (ACC-UPG-01 to ACC-UPG-06; test:cli/test/upgrade.test.ts::\"successfully performs an end-to-end upgrade with atomic symlink swap and verification\", test:cli/test/upgrade_cli.test.ts::\"returns exit code 1 when update is available in --check mode\", test:cli/test/upgrade_tui.test.ts::\"exercises deliberate approval interaction when executing /upgrade in TUI\") | tested | ACC-UPG-01 to ACC-UPG-06 | **B** | REL-14 | SPEC-12 / PLAN-12 |\ndocs/v1.0.0/REQUIREMENTS.md:205:| REQ-REL-116 | Scope addition | Machine-readable compatibility metadata, download origin & archive extraction safety, pre-migration backups, downgrade state protection, durable provenance, crash recovery, and runtime verification. | installation integrity & lifecycle | `cli/src/upgrade.ts`, `cli/src/compatibility.ts`, `cli/src/tar_safety.ts`, `cli/src/upgrade_journal.ts`, `docs/UPGRADE_SECURITY.md` | TEST (ACC-UPG-07 to ACC-UPG-14; test:cli/test/upgrade_safety.test.ts::\"rejects malicious tar archive with path traversal\", test:cli/test/upgrade_safety.test.ts::\"creates protected config and state backups with 0600 file and 0700 dir permissions\", test:cli/test/upgrade_acceptance.test.ts::\"upgrades from previous release v0.1.0-alpha.2 to v1.0.0 preserving state, configuration and permissions\", test:cli/test/upgrade_acceptance.test.ts::\"refuses downgrade when target release has incompatible state schema version\") | tested | ACC-UPG-07 to ACC-UPG-14 | **B** | REL-15 | SPEC-12 / PLAN-12 |\ndocs/v1.0.0/REQUIREMENTS.md:236:| REQ-QUAL-103 | DEC-05 | 5 runs per task and configuration; Goose and OpenCode as peers. | statistics | `eval/run.mjs`, `eval/score.mjs` | TEST (`eval_harness.test.ts`: peer version/budget forwarding, installed RC/version/package pin, Nexus/provider-limit parity, paired fingerprint/limit/sampling/budget/version and 5-run checks; commits `ef2d040`, `b27ae04`; [validation record](../reviews/evidence/v1/PLAN-10_PR-10d/validation.md)); UNV (live M5 runs) | tested | ACC-QUAL-T2 (ACCEPTANCE §6.1) | **B** | EVL-001 | SPEC-10 / PLAN-10 |\ndocs/releases/v1.0.0.md:152:- When no stable release exists, the installer queries releases and offers an actionable prerelease hint (`no stable release yet; latest prerelease is vX — rerun with NEXUS_VERSION=vX`).\ndocs/cloudflare/BROKERAGE_TRUST_ROOT_INSTALL_PLAN_2026-10-02.md:93:- post-install manifest recording absolute paths, versions, owner/mode, and\ndocs/v1.0.0/specs/SPEC-06-packaged-product-parity.md:38:- A reinstall cannot repair a damaged version directory (REL-10).\ndocs/v1.0.0/specs/SPEC-06-packaged-product-parity.md:46:3. **REQ-REL-103.** One version: tag == package.json == cli/package.json == core/Cargo.toml == harness-core `--version` == the sidecar protocol's reported core version. Release CI asserts this. A fresh install's doctor shows no version warning.\n","exit_code":0,"duration":{"secs":0,"nanos":819460172}},"started_at_ms":1793001179401,"completed_at_ms":1793001180221}}
