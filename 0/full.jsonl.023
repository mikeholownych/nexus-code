{"timestamp":"2026-10-26T14:22:29.910Z","ordinal":389773,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":7086431476,"cached_input_tokens":7011541376,"cache_write_input_tokens":0,"output_tokens":19436505,"reasoning_output_tokens":11881765,"total_tokens":7105867981},"last_token_usage":{"input_tokens":180024,"cached_input_tokens":179584,"cache_write_input_tokens":0,"output_tokens":152,"reasoning_output_tokens":51,"total_tokens":180176},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":64.0,"window_minutes":300,"resets_at":1793030949},"secondary":{"used_percent":23.0,"window_minutes":10080,"resets_at":1793599746},"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"plus","rate_limit_reached_type":null}}}
