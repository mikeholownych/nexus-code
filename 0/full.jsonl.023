{"timestamp":"2026-10-26T11:41:13.337Z","ordinal":385198,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17802-f864-7383-97fc-4fdd2f0a5d6e","item":{"type":"CommandExecution","id":"exec-5e9f0983-d3aa-4166-99f6-b723acf6b627","process_id":"41222","command":["/usr/bin/zsh","-lc","git show-ref --tags | rg 'v1\\.0\\.0-rc\\.8|rc\\.8' | head; git show v1.0.0-rc.8:.github/workflows/repro.yml 2>/dev/null | sed -n '1,180p'; GH_PROMPT_DISABLED=1 gh workflow list --repo mikeholownych/nexus-code"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git show-ref --tags | rg 'v1\\.0\\.0-rc\\.8|rc\\.8' | head; git show v1.0.0-rc.8:.github/workflows/repro.yml 2>/dev/null | sed -n '1,180p'; GH_PROMPT_DISABLED=1 gh workflow list --repo mikeholownych/nexus-code"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"f847ca34e5d99508baaf5e1105b5ebd9db005026 refs/tags/v1.0.0-rc.8\nname: Cross-runner RC reproducibility\n\non:\n  workflow_dispatch:\n    inputs:\n      tag:\n        description: Published v1.0.0 RC tag with lock-pinned release tools (for example v1.0.0-rc.4)\n        required: true\n        type: string\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: rc-repro-${{ inputs.tag }}\n  cancel-in-progress: false\n\njobs:\n  resolve-tag:\n    runs-on: ubuntu-22.04\n    outputs:\n      tag_sha: ${{ steps.resolve.outputs.tag_sha }}\n      workflow_sha: ${{ steps.resolve.outputs.workflow_sha }}\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n    steps:\n      - name: Require dispatch from main\n        run: |\n          if [[ \"$GITHUB_REF\" != \"refs/heads/main\" ]]; then\n            echo \"Dispatch this workflow from main so the checked workflow is the reviewed release version.\" >&2\n            exit 1\n          fi\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22.22.1\n      - id: resolve\n        name: Resolve published RC tag to an immutable commit\n        run: |\n          if [[ ! \"$TARGET_TAG\" =~ ^v1\\.0\\.0-rc\\.[1-9][0-9]*$ ]]; then\n            echo \"Expected a v1.0.0-rc.N tag; received an invalid tag.\" >&2\n            exit 1\n          fi\n          git fetch origin main --no-tags\n          git fetch origin \"refs/tags/$TARGET_TAG:refs/tags/$TARGET_TAG\"\n          tag_sha=\"$(git rev-parse \"$TARGET_TAG^{commit}\")\"\n          git merge-base --is-ancestor \"$tag_sha\" origin/main\n          git checkout --detach \"$tag_sha\"\n          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n          test -f \"docs/releases/$TARGET_TAG.md\"\n          if [[ ! -s scripts/release-tools/package.json || ! -s scripts/release-tools/package-lock.json ]] || \\\n             ! grep -Fq 'scripts/release-tools/package-lock.json' scripts/package-linux.sh || \\\n             ! grep -Fq 'check_deprecated_lock.mjs' scripts/package-linux.sh || \\\n             grep -Eq '(^|[[:space:]])npx([[:space:]]|$)' scripts/package-linux.sh scripts/generate_sbom.sh; then\n            echo \"The selected RC predates or bypasses the locked notices tool and lock deprecation gate; cross-runner reproduction requires an RC whose tag includes them.\" >&2\n            exit 1\n          fi\n          printf 'tag_sha=%s\\n' \"$tag_sha\" >> \"$GITHUB_OUTPUT\"\n          printf 'workflow_sha=%s\\n' \"$GITHUB_WORKFLOW_SHA\" >> \"$GITHUB_OUTPUT\"\n      - name: Verify the public RC release is published\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          gh release view \"$TARGET_TAG\" --json isPrerelease,isDraft \\\n            | jq -e '.isPrerelease == true and .isDraft == false' >/dev/null\n\n  build:\n    needs: resolve-tag\n    runs-on: ${{ matrix.runner }}\n    timeout-minutes: 120\n    strategy:\n      fail-fast: false\n      matrix:\n        runner: [ubuntu-22.04, ubuntu-24.04]\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n      EXPECTED_TAG_SHA: ${{ needs.resolve-tag.outputs.tag_sha }}\n      EXPECTED_WORKFLOW_SHA: ${{ needs.resolve-tag.outputs.workflow_sha }}\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: ${{ needs.resolve-tag.outputs.tag_sha }}\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22.22.1\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Require the pinned release Node and npm versions\n        run: |\n          test \"$(node --version)\" = \"v22.22.1\"\n          test \"$(npm --version)\" = \"10.9.4\"\n      - name: Verify exact RC source\n        run: |\n          test \"$(git rev-parse HEAD)\" = \"$EXPECTED_TAG_SHA\"\n          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n          test \"$GITHUB_REF\" = refs/heads/main\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # pinned Rust toolchain action\n        with:\n          toolchain: 1.95.0\n      - name: Install pinned SBOM and notices tools\n        run: |\n          cargo_home=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME=\"$cargo_home\"\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - name: Verify the pinned package builder is available\n        run: |\n          docker info >/dev/null\n          test \"$NEXUS_BUILD_CONTAINER_IMAGE\" = 'rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb'\n      - name: Build the exact RC package\n        env:\n          NEXUS_PACKAGE_TOOL_COMMIT: ${{ needs.resolve-tag.outputs.workflow_sha }}\n        run: |\n          git fetch origin main --no-tags\n          git merge-base --is-ancestor \"$NEXUS_PACKAGE_TOOL_COMMIT\" origin/main\n          package_tool=\"$RUNNER_TEMP/package-linux.sh\"\n          git show \"$NEXUS_PACKAGE_TOOL_COMMIT:scripts/package-linux.sh\" > \"$package_tool\"\n          NEXUS_PACKAGE_SOURCE=\"$GITHUB_WORKSPACE\" bash \"$package_tool\" \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\"\n      - name: Record source, toolchain, and published-asset identity\n        env:\n          NEXUS_PACKAGE_TOOL_COMMIT: ${{ needs.resolve-tag.outputs.workflow_sha }}\n          NEXUS_PACKAGE_TOOL_SCRIPT: ${{ runner.temp }}/package-linux.sh\n        run: |\n          git show \"$EXPECTED_WORKFLOW_SHA:scripts/repro-identity.mjs\" > \"$RUNNER_TEMP/repro-identity.mjs\"\n          node \"$RUNNER_TEMP/repro-identity.mjs\" record \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\" \\\n            \"$RUNNER_TEMP/dist/repro-identity.json\" \"${{ matrix.runner }}\"\n      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n        with:\n          name: nexus-repro-${{ matrix.runner }}\n          path: |\n            ${{ runner.temp }}/dist/nexus-linux-x86_64-${{ inputs.tag }}.tar.gz\n            ${{ runner.temp }}/dist/compatibility.json\n            ${{ runner.temp }}/dist/SHA256SUMS\n            ${{ runner.temp }}/dist/THIRD_PARTY_NOTICES.txt\n            ${{ runner.temp }}/dist/sbom.cdx.json\n            ${{ runner.temp }}/dist/install.sh\n            ${{ runner.temp }}/dist/repro-identity.json\n          if-no-files-found: error\n          retention-days: 14\n\n  compare:\n    needs: [resolve-tag, build]\n    runs-on: ubuntu-22.04\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n      EXPECTED_TAG_SHA: ${{ needs.resolve-tag.outputs.tag_sha }}\n      EXPECTED_WORKFLOW_SHA: ${{ needs.resolve-tag.outputs.workflow_sha }}\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: ${{ needs.resolve-tag.outputs.workflow_sha }}\n          fetch-depth: 1\n          persist-credentials: false\n      - name: Verify comparison code is the exact reviewed workflow commit\n        run: test \"$(git rev-parse HEAD)\" = \"$EXPECTED_WORKFLOW_SHA\"\n      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n        with:\n          name: nexus-repro-ubuntu-22.04\n          path: ${{ runner.temp }}/ubuntu-22.04\n      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n        with:\n          name: nexus-repro-ubuntu-24.04\n          path: ${{ runner.temp }}/ubuntu-24.04\n      - name: Download published RC assets\nCI\tactive\t383488696\nCodeQL\tactive\t388421857\nRelease\tactive\t383488697\nCross-runner RC reproducibility\tactive\t391902404\nGitHub Advanced Security\tactive\t391037042\nDependabot Updates\tactive\t388431120\nDependency Graph\tactive\t393543601\n","exit_code":0,"duration":{"secs":0,"nanos":355597155}},"started_at_ms":1793014872981,"completed_at_ms":1793014873337}}
