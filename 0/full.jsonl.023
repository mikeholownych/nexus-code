:\"\",\"name\":\"Run cargo deny --manifest-path core/Cargo.toml --config deny.toml check licenses advisories\",\"number\":11,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run node scripts/sync-version.mjs --check\",\"number\":12,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run npm ci --prefix cli\",\"number\":13,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run npm --prefix cli run build\",\"number\":14,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run git diff --exit-code -- cli/dist\",\"number\":15,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cargo test --locked --manifest-path core/Cargo.toml\",\"number\":16,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\",\"number\":17,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run npm --prefix cli test\",\"number\":18,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run bash scripts/security_gates.sh\",\"number\":19,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run node scripts/check_requirements.mjs\",\"number\":20,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run echo \\\"version=$(node -p 'require(\\\"./package.json\\\").version')\\\" >> \\\"$GITHUB_OUTPUT\\\"\",\"number\":21,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run bash scripts/package-linux.sh \\\"v${{ steps.release-version.outputs.version }}\\\" \\\"$RUNNER_TEMP/dist\\\"\",\"number\":22,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run bash scripts/package-linux.sh \\\"v${{ steps.release-version.outputs.version }}\\\" \\\"$RUNNER_TEMP/repro-check\\\"\",\"number\":23,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\\\" \\\"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\\\"\",\"number\":24,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/SHA256SUMS\\\" \\\"$RUNNER_TEMP/repro-check/SHA256SUMS\\\"\",\"number\":25,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/THIRD_PARTY_NOTICES.txt\\\" \\\"$RUNNER_TEMP/repro-check/THIRD_PARTY_NOTICES.txt\\\"\",\"number\":26,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cyclonedx validate --input-file \\\"$RUNNER_TEMP/dist/sbom.cdx.json\\\" --fail-on-errors\",\"number\":27,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/sbom.cdx.json\\\" \\\"$RUNNER_TEMP/re