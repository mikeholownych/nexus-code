tTimeout(resolve, 2200));\n   799\t    assert.equal(fs.existsSync(escapedMarker), false, \"a session-escaped task process survived cgroup cleanup\");\n   800\t  } finally {\n   801\t    fs.rmSync(ws, { recursive: true, force: true });\n   802\t  }\n   803\t});\n   804\t\n   805\ttest(\"resource supervisor preserves SIGTERM grace for descendants after the main payload exits\", { timeout: 30_000 }, async () => {\n   806\t  const { spawnContained } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n   807\t  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\n   808\t  const tmpfs = fs.statfsSync(workspaceRoot);\n   809\t  const resources = { cpuPercent: 20, memoryBytes: 256 * 1024 * 1024, tasks: 16, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\n   810\t  const markerDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-sigterm-resource-test-\"));\n   811\t  const readyMarker = path.join(markerDir, \"payload-ready\");\n   812\t  const signalMarker = path.join(markerDir, \"flushed-state\");\n   813\t  try {\n   814\t    const result = await new Promise<any>((resolve, reject) => {\n   815\t      const childScript = `process.on('SIGTERM',()=>setTimeout(()=>{require('node:fs').writeFileSync(${JSON.stringify(signalMarker)},'flushed');process.exit(143)},400));require('node:fs').writeFileSync(${JSON.stringify(readyMarker)},'ready');setInterval(()=>{},1000)`;\n   816\t      const parentScript = `require('node:child_process').spawn(process.execPath,['-e',${JSON.stringify(childScript)}],{stdio:'ignore'});setInterval(()=>{},1000)`;\n   817\t      const { child, containment } = spawnContained({ cmd: process.execPath, argv: [\"-e\", parentScript] }, resources, { cwd: \"/\", stdio: [\"ignore\", \"ignore\", \"ignore\"], detached: true });\n   818\t      const timeout = setTimeout(() => { containment!.kill(); reject(new Error(\"graceful SIGTERM fixture did not exit\")); }, 15_000);\n   819\t      child.on(\"error\", (error) => { clearTimeout(timeout); reject(error); });\n   820\t      child.on(\"close\", async () => { clearTimeout(timeout); resolve(await containment!.final); });\n   821\t      const sendAfterReady = async () => {\n   822\t        const deadline = Date.now() + 10_000;\n   823\t        while (!fs.existsSync(readyMarker) && Date.now() < deadline) await new Promise((wait) => setTimeout(wait, 20));\n   824\t        if (!fs.existsSync(readyMarker)) return reject(new Error(\"contained payload did not report ready\"));\n   825\t        if (!containment!.signal(\"SIGTERM\", 2000)) reject(new Error(\"s…55 tokens truncated…not receive SIGTERM before forced cleanup\");\n   830\t    assert.equal(result.cleaned, true, JSON.stringify(result));\n   831\t    assert.deepEqual(result.signals.map((entry: any) => [entry.name, entry.forced]), [[\"SIGTERM\", false]]);\n   832\t  } finally {\n   833\t    fs.rmSync(markerDir, { recursive: true, force: true });\n   834\t  }\n   835\t});\n   836\t\n   837\ttest(\"candidate sandbox and resource supervisor compose around a staged repository\", { timeout: 30_000 }, async () => {\n   838\t  const { stageRepoWorkspace } = await import(path.join(ROOT, \"eval/workspace.mjs\"));\n   839\t  const { agentSandboxArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   840\t  const { resourceConfigProblem, spawnContained } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n   841\t  assert.equal((await import(path.join(ROOT, \"eval/isolate.mjs\"))).sandboxAvailable(), true, \"this security test requires the real Bubblewrap executable\");\n   842\t\n   843\t  let base: string | null = null;\n   844\t  let workspace: string | null = null;\n   845\t  let contained: ReturnType<typeof spawnContained> | null = null;\n   846\t  let childClosed: Promise<void> | null = null;\n   847\t  let candidateProcessClosed = false;\n   848\t  let shutdownComplete = false;\n   849\t  let executionStarted = false;\n   850\t  let candidateSpawnError: Error | undefined;\n   8