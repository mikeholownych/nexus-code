{"timestamp":"2026-10-26T10:03:33.288Z","ordinal":382249,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a177a5-7619-7f61-94e2-64d374be9e23","item":{"type":"CommandExecution","id":"exec-db51f0c9-7385-439d-ab00-db45886449e0","process_id":"28834","command":["/usr/bin/zsh","-lc","ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=5 mike@10.0.8.3 'set -u\nprefix=\"$HOME/.local/rc8-qual-bbafae\"\npkg=\"$prefix/lib/nexus/v1.0.0-rc.8\"\ndir=\"$HOME/.local/share/nexus-qualification/v1.0.0-rc.8/provider\"\nmkdir -p \"$dir\" && chmod 700 \"$dir\"\ntmp=$(mktemp -d \"$HOME/.cache/nexus-provider-verify.XXXXXX\") && chmod 700 \"$tmp\"\nstarted=$(date -u +%FT%TZ)\nset +e\n\"$prefix/bin/nexus\" providers verify --provider openrouter --model nvidia/nemotron-3-super-120b-a12b:free --json >\"$tmp/result.json\" 2>\"$tmp/diagnostics.txt\"\nrc=$?\nset -e\nnode - \"$pkg/compatibility.json\" \"$pkg/.provenance.json\" \"$tmp/result.json\" \"$tmp/diagnostics.txt\" \"$dir/openrouter-verify-rc8.json\" \"$started\" \"$rc\" <<\"NODE\"\nconst fs=require(\"node:fs\"), crypto=require(\"node:crypto\");\nconst [compatPath,provPath,resultPath,diagPath,outPath,startedAt,exitCode]=process.argv.slice(2);\nconst compat=JSON.parse(fs.readFileSync(compatPath,\"utf8\"));\nconst prov=JSON.parse(fs.readFileSync(provPath,\"utf8\"));\nconst result=JSON.parse(fs.readFileSync(resultPath,\"utf8\"));\nconst diagnostics=fs.readFileSync(diagPath,\"utf8\").trim();\nconst record={schemaVersion:1,sourceCommit:compat.revision,rcTag:\"v1.0.0-rc.8\",artifactSha256:prov.archiveSha256,host:\"ubuntu-desktop\",startedAt,command:\"nexus providers verify --provider openrouter --model nvidia/nemotron-3-super-120b-a12b:free --json\",exitCode:Number(exitCode),result,...(diagnostics?{safeDiagnostics:diagnostics}:{})};\nfs.writeFileSync(outPath,JSON.stringify(record,null,2)+\"\\n\",{mode:0o600});\nconsole.log(JSON.stringify({passed:result.passed,provider:result.provider,model:result.model,sourceCommit:record.sourceCommit,rcTag:record.rcTag,artifactSha256:record.artifactSha256,steps:result.steps?.map(s=>({step:s.step,ok:s.ok,detail:s.detail,requestId:s.requestId,condition:s.condition})),evidencePath:outPath,evidenceSha256:crypto.createHash(\"sha256\").update(fs.readFileSync(outPath)).digest(\"hex\")}));\nNODE\nexit \"$rc\"'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=5 mike@10.0.8.3 'set -u\nprefix=\"$HOME/.local/rc8-qual-bbafae\"\npkg=\"$prefix/lib/nexus/v1.0.0-rc.8\"\ndir=\"$HOME/.local/share/nexus-qualification/v1.0.0-rc.8/provider\"\nmkdir -p \"$dir\" && chmod 700 \"$dir\"\ntmp=$(mktemp -d \"$HOME/.cache/nexus-provider-verify.XXXXXX\") && chmod 700 \"$tmp\"\nstarted=$(date -u +%FT%TZ)\nset +e\n\"$prefix/bin/nexus\" providers verify --provider openrouter --model nvidia/nemotron-3-super-120b-a12b:free --json >\"$tmp/result.json\" 2>\"$tmp/diagnostics.txt\"\nrc=$?\nset -e\nnode - \"$pkg/compatibility.json\" \"$pkg/.provenance.json\" \"$tmp/result.json\" \"$tmp/diagnostics.txt\" \"$dir/openrouter-verify-rc8.json\" \"$started\" \"$rc\" <<\"NODE\"\nconst fs=require(\"node:fs\"), crypto=require(\"node:crypto\");\nconst [compatPath,provPath,resultPath,diagPath,outPath,startedAt,exitCode]=process.argv.slice(2);\nconst compat=JSON.parse(fs.readFileSync(compatPath,\"utf8\"));\nconst prov=JSON.parse(fs.readFileSync(provPath,\"utf8\"));\nconst result=JSON.parse(fs.readFileSync(resultPath,\"utf8\"));\nconst diagnostics=fs.readFileSync(diagPath,\"utf8\").trim();\nconst record={schemaVersion:1,sourceCommit:compat.revision,rcTag:\"v1.0.0-rc.8\",artifactSha256:prov.archiveSha256,host:\"ubuntu-desktop\",startedAt,command:\"nexus providers verify --provider openrouter --model nvidia/nemotron-3-super-120b-a12b:free --json\",exitCode:Number(exitCode),result,...(diagnostics?{safeDiagnostics:diagnostics}:{})};\nfs.writeFileSync(outPath,JSON.stringify(record,null,2)+\"\\n\",{mode:0o600});\nconsole.log(JSON.stringify({passed:result.passed,provider:result.provider,model:result.model,sourceCommit:record.sourceCommit,rcTag:record.rcTag,artifactSha256:record.artifactSha256,steps:result.steps?.map(s=>({step:s.step,ok:s.ok,detail:s.detail,requestId:s.requestId,condition:s.condition})),evidencePath:outPath,evidenceSha256:crypto.createHash(\"sha256\").update(fs.readFileSync(outPath)).digest(\"hex\")}));\nNODE\nexit \"$rc\"'"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"{\"passed\":false,\"provider\":\"openrouter\",\"model\":\"nvidia/nemotron-3-super-120b-a12b:free\",\"sourceCommit\":\"bbafae868939084ccd49f21621695dff6b05f752\",\"rcTag\":\"v1.0.0-rc.8\",\"artifactSha256\":\"bbded963a9bcaa9c0764b86d900f752c46ed364bfe30cc67e5bbf23b5fb5f48e\",\"steps\":[{\"step\":\"streamed completion\",\"ok\":false,\"detail\":\"Provider request failed\",\"requestId\":\"1cb2c8ba-3e3e-47d6-ae1a-4ab35023b3e7\",\"condition\":\"REQUEST_REJECTED\"}],\"evidencePath\":\"/home/mike/.local/share/nexus-qualification/v1.0.0-rc.8/provider/openrouter-verify-rc8.json\",\"evidenceSha256\":\"570702ab96a88a083c4efd4fcbe58ededc8569c81332a87d24d61c6b10024fc4\"}\n","exit_code":1,"duration":{"secs":1,"nanos":605324900}},"started_at_ms":1793009011682,"completed_at_ms":1793009013288}}
