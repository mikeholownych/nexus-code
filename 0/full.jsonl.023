{"timestamp":"2026-10-26T10:20:14.898Z","ordinal":382857,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a177a5-7619-7f61-94e2-64d374be9e23","item":{"type":"CommandExecution","id":"exec-2f54e404-7d7e-42f7-9812-e7602ecd3562","process_id":"98529","command":["/usr/bin/zsh","-lc","gh pr view 248 --repo mikeholownych/nexus-code --json title,body,headRefOid,mergeCommit,files,url --jq '\"title=\"+.title+\" head=\"+.headRefOid+\" merge=\"+.mergeCommit.oid+\" url=\"+.url+\"\\n\"+(.body|.[0:800])+\"\\nfiles=\"+([.files[].path]|join(\",\"))'; git -C /home/mike/nexus-wt/upgrade-tui-contamination show --stat --oneline a7880b64c98d5f3f6522a18a97b2a10489f9461e; git -C /home/mike/nexus-wt/upgrade-tui-contamination show --format= --first-parent a7880b64c98d5f3f6522a18a97b2a10489f9461e --"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"gh pr view 248 --repo mikeholownych/nexus-code --json title,body,headRefOid,mergeCommit,files,url --jq '\"title=\"+.title+\" head=\"+.headRefOid+\" merge=\"+.mergeCommit.oid+\" url=\"+.url+\"\\n\"+(.body|.[0:800])+\"\\nfiles=\"+([.files[].path]|join(\",\"))'; git -C /home/mike/nexus-wt/upgrade-tui-contamination show --stat --oneline a7880b64c98d5f3f6522a18a97b2a10489f9461e; git -C /home/mike/nexus-wt/upgrade-tui-contamination show --format= --first-parent a7880b64c98d5f3f6522a18a97b2a10489f9461e --"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"title=fix: accept signed GitHub release asset redirects head=1cce2f48af32633cf9b3df36aa9c37ec4c2fce6f merge=a7880b64c98d5f3f6522a18a97b2a10489f9461e url=https://github.com/mikeholownych/nexus-code/pull/248\n## Summary\n\nFix the RC6-to-RC7 upgrade failure caused by GitHub redirecting the canonical release URL to a short-lived signed asset URL. The installer now accepts only HTTPS redirects to the exact `release-assets.githubusercontent.com/github-production-release-asset/` path, keeps manual redirect validation, and does not forward GitHub credentials to the asset host. Error diagnostics report only the origin, never signed query parameters.\n\nPre-migration backups now report bounded aggregate progress and sync directory entries once per copied directory while retaining per-file fsync and fail-closed backup handling. This makes large backups observable and reduces repeated directory sync overhead.\n\n## Validation\n\n- `upgrade_safety.test.ts`: 35/35 passed, including the canonical GitHub-to-signed-\nfiles=cli/src/upgrade.ts,cli/src/upgrade_journal.ts,cli/test/upgrade_safety.test.ts,cli/test/upgrade_transaction_recovery.test.ts\na7880b6 Merge pull request #248 from mikeholownych/v1/defect-upgrade-backup-progress\n\n cli/src/upgrade.ts                            | 30 +++++++++--\n cli/src/upgrade_journal.ts                    | 75 +++++++++++++++++++++++----\n cli/test/upgrade_safety.test.ts               | 72 +++++++++++++++++++++++++\n cli/test/upgrade_transaction_recovery.test.ts | 72 +++++++++++++++++++++++++\n 4 files changed, 234 insertions(+), 15 deletions(-)\ndiff --git a/cli/src/upgrade.ts b/cli/src/upgrade.ts\nindex 1b6f865..7e5aebe 100644\n--- a/cli/src/upgrade.ts\n+++ b/cli/src/upgrade.ts\n@@ -666,9 +666,24 @@ export function validateDownloadUrl(urlString: string): boolean {\n     return true;\n   }\n \n+  // GitHub now redirects release downloads to its signed release-assets host.\n+  // Restrict the path to release objects; never allow this host as a generic CDN.\n+  if (hostname === \"release-assets.githubusercontent.com\") {\n+    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n+  }\n+\n   return false;\n }\n \n+/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\n+function safeDownloadOrigin(urlString: string): string {\n+  try {\n+    return new URL(urlString).origin;\n+  } catch {\n+    return \"invalid URL\";\n+  }\n+}\n+\n export async function downloadFile(\n   url: string,\n   destPath: string,\n@@ -688,7 +703,7 @@ export async function downloadFile(\n   try {\n     while (hops <= maxHops) {\n       if (!validateDownloadUrl(currentUrl)) {\n-        throw new Error(`Disallowed download origin or invalid URL: ${currentUrl}`);\n+        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n       }\n \n       const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n@@ -707,7 +722,7 @@ export async function downloadFile(\n       if (res.status === 301 || res.status === 302 || res.status === 307 || res.status === 308) {\n         const location = res.headers.get(\"location\");\n         if (!location) {\n-          throw new Error(`HTTP ${res.status} redirect without Location header from ${currentUrl}`);\n+          throw new Error(`HTTP ${res.status} redirect without Location header from ${safeDownloadOrigin(currentUrl)}`);\n         }\n         currentUrl = new URL(location, currentUrl).toString();\n         hops++;\n@@ -715,7 +730,7 @@ export async function downloadFile(\n       }\n \n       if (!res.ok) {\n-        throw new Error(`HTTP ${res.status} downloading ${currentUrl}`);\n+        throw new Error(`HTTP ${res.status} downloading from ${safeDownloadOrigin(currentUrl)}`);\n       }\n \n       const contentLengthHeader = res.headers.get(\"content-length\");\n@@ -728,7 +743,7 @@ export async function downloadFile(\n \n       const fileStream = fs.createWriteStream(destPath);\n       if (!res.body) {\n-        throw new Error(`Empty body downloading ${currentUrl}`);\n+        throw new Error(`Empty body downloading from ${safeDownloadOrigin(currentUrl)}`);\n       }\n \n       let bytesDownloaded = 0;\n@@ -1018,7 +1033,12 @@ export async function performUpgrade(\n     const pending = readJournal(prefix);\n     if (fs.existsSync(getJournalPath(prefix)) && (!pending || ![\"idle\", \"complete\", \"rolled_back\"].includes(pending.state))) throw new Error(\"Pending or invalid upgrade journal; run nexus upgrade --recover before starting another transaction.\");\n     options?.onProgress?.(\"pre_migration_backup\", \"Creating pre-migration configuration and state backup...\");\n-    const backupResult = createPreMigrationBackup();\n+    const backupResult = createPreMigrationBackup(process.env.HOME || \"\", ({ filesCopied, bytesCopied }) => {\n+      options?.onProgress?.(\n+        \"pre_migration_backup\",\n+        `Backup progress: ${filesCopied} files, ${bytesCopied} bytes copied.`,\n+      );\n+    });\n     fs.mkdirSync(tmpDir, { mode:0o700 });\n     journalEntry = {\n       formatVersion:1, id:transactionId, state:\"preparing\",\ndiff --git a/cli/src/upgrade_journal.ts b/cli/src/upgrade_journal.ts\nindex 3deb829..db307a6 100644\n--- a/cli/src/upgrade_journal.ts\n+++ b/cli/src/upgrade_journal.ts\n@@ -53,6 +53,11 @@ export interface BackupResult {\n   stateBackupDir?: string;\n }\n \n+export interface BackupProgress {\n+  filesCopied: number;\n+  bytesCopied: number;\n+}\n+\n export function getJournalPath(prefix: string): string {\n   return path.join(prefix, \"lib\", \"nexus\", \".upgrade-journal.json\");\n }\n@@ -138,9 +143,36 @@ export function clearJournal(prefix: string): void {\n  * Creates pre-migration backups of configuration and durable state.\n  * Files are created with strict 0600 permissions in 0700 directories.\n  */\n-export function createPreMigrationBackup(homeDir: string = process.env.HOME || \"\"): BackupResult {\n+export function createPreMigrationBackup(\n+  homeDir: string = process.env.HOME || \"\",\n+  onProgress?: (progress: BackupProgress) => void,\n+): BackupResult {\n   const result: BackupResult = {};\n   const timestamp = new Date().toISOString().replace(/[:.]/g, \"-\");\n+  let filesCopied = 0;\n+  let bytesCopied = 0;\n+  let lastProgressAt = Date.now();\n+  let lastReportedFiles = 0;\n+  let lastReportedBytes = 0;\n+  const reportProgress = () => {\n+    const now = Date.now();\n+    if (now - lastProgressAt >= 5_000 || (filesCopied - lastReportedFiles >= 1_024 && now - lastProgressAt >= 2_000)) {\n+      onProgress?.({ filesCopied, bytesCopied });\n+      lastProgressAt = now;\n+      lastReportedFiles = filesCopied;\n+      lastReportedBytes = bytesCopied;\n+    }\n+  };\n+  const observer = {\n+    bytesCopied: (bytes: number) => {\n+      bytesCopied += bytes;\n+      reportProgress();\n+    },\n+    fileCopied: () => {\n+      filesCopied += 1;\n+      reportProgress();\n+    },\n+  };\n \n   // 1. Config backup\n   const configEnv = path.join(homeDir, \".config\", \"nexus\", \"config.env\");\n@@ -152,7 +184,8 @@ export function createPreMigrationBackup(homeDir: string = process.env.HOME || \"\n     if (fs.realpathSync(backupDir) !== path.resolve(backupDir)) throw new Error(\"Configuration backup directory is redirected\");\n     if (!backupDirExisted) syncDirectory(path.dirname(backupDir));\n     const backupFile = path.join(backupDir, `config.env.bak.${timestamp}`);\n-    copyPrivateFileDurably(configEnv, backupFile);\n+    copyPrivateFileDurably(configEnv, backupFile, true, observer.bytesCopied);\n+    observer.fileCopied();\n     result.configBackupPath = backupFile;\n   }\n \n@@ -172,9 +205,9 @@ export function createPreMigrationBackup(homeDir: string = process.env.HOME || \"\n \n     // Snapshot all durable state, not just its index. Backup directories are\n     // excluded to avoid recursion; symbolic links are refused rather than read.\n-    withDurableStoreGuards(homeDir, () => copyPrivateTree(stateDir, path.join(backupDest, \"state\"), new Set([\"backups\", \"restore-control\", STATE_RESTORE_PENDING_FILE])));\n+    withDurableStoreGuards(homeDir, () => copyPrivateTree(stateDir, path.join(backupDest, \"state\"), new Set([\"backups\", \"restore-control\", STATE_RESTORE_PENDING_FILE]), observer));\n     const configDir = path.join(homeDir, \".config\", \"nexus\");\n-    if (fs.existsSync(configDir)) copyPrivateTree(configDir, path.join(backupDest, \"config\"), new Set([\"backups\", STATE_RESTORE_PENDING_FILE]));\n+    if (fs.existsSync(configDir)) copyPrivateTree(configDir, path.join(backupDest, \"config\"), new Set([\"backups\", STATE_RESTORE_PENDING_FILE]), observer);\n     const metadataPath = path.join(backupDest, \"backup.json\");\n     const metadataFd = fs.openSync(metadataPath, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | (fs.constants.O_NOFOLLOW ?? 0), 0o600);\n     try {\n@@ -187,6 +220,8 @@ export function createPreMigrationBackup(homeDir: string = process.env.HOME || \"\n     result.stateBackupDir = backupDest;\n   }\n \n+  if (filesCopied > lastReportedFiles || bytesCopied > lastReportedBytes) onProgress?.({ filesCopied, bytesCopied });\n+\n   return result;\n }\n \n@@ -238,7 +273,12 @@ function validatePrivateTree(source: string): void {\n   if (stat.isSymbolicLink() || (!stat.isDirectory() && !stat.isFile())) throw new Error(\"Backup contains unsupported files\");\n   if (stat.isDirectory()) for (const name of fs.readdirSync(source)) validatePrivateTree(path.join(source, name));\n }\n-function copyPrivateTree(source: string, destination: string, excluded = new Set<string>()): void {\n+function copyPrivateTree(\n+  source: string,\n+  destination: string,\n+  excluded = new Set<string>(),\n+  observer?: { bytesCopied: (bytes: number) => void; fileCopied: () => void },\n+): void {\n   validatePrivateTreeExcept(source, excluded);\n   const existed = fs.existsSync(destination);\n   fs.mkdirSync(destination, { recursive:true, mode:0o700 });\n@@ -248,14 +288,24 @@ function copyPrivateTree(source: string, destination: string, excluded = new Set\n   for (const entry of fs.readdirSync(source, { withFileTypes:true })) {\n     if (excluded.has(entry.name) || entry.name === STATE_STORE_GUARD_FILE || entry.name === STATE_RESTORE_PENDING_FILE) continue;\n     const from = path.join(source, entry.name), to = path.join(destination, entry.name);\n-    if (entry.isDirectory()) copyPrivateTree(from, to);\n-    else copyPrivateFileDurably(from, to);\n+    if (entry.isDirectory()) copyPrivateTree(from, to, new Set(), observer);\n+    else {\n+      copyPrivateFileDurably(from, to, false, observer?.bytesCopied);\n+      observer?.fileCopied();\n+    }\n   }\n+  // File contents are fsynced individually. Batch directory-entry durability\n+  // once per directory instead of forcing a journal commit for every file.\n   syncDirectory(destination);\n }\n \n /** A backup is not returned to the journal until its bytes and directory entry are durable. */\n-function copyPrivateFileDurably(source: string, destination: string): void {\n+function copyPrivateFileDurably(\n+  source: string,\n+  destination: string,\n+  syncParentOnSuccess = true,\n+  onBytesCopied?: (bytes: number) => void,\n+): number {\n   const sourcePath = path.resolve(source);\n   if (fs.realpathSync(sourcePath) !== sourcePath) throw new Error(\"Backup source is redirected\");\n   const sourceFd = fs.openSync(sourcePath, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0) | (fs.constants.O_NONBLOCK ?? 0));\n@@ -275,14 +325,19 @@ function copyPrivateFileDurably(source: string, destination: string): void {\n       const count = fs.readSync(sourceFd, buffer, 0, buffer.length, position);\n       if (count === 0) break;\n       let written = 0;\n-      while (written < count) written += fs.writeSync(destinationFd, buffer, written, count - written);\n+      while (written < count) {\n+        const chunkWritten = fs.writeSync(destinationFd, buffer, written, count - written);\n+        written += chunkWritten;\n+        onBytesCopied?.(chunkWritten);\n+      }\n       position += count;\n     }\n     fs.fchmodSync(destinationFd, 0o600);\n     fs.fsyncSync(destinationFd);\n     fs.closeSync(destinationFd);\n     destinationFd = undefined;\n-    syncDirectory(path.dirname(destination));\n+    if (syncParentOnSuccess) syncDirectory(path.dirname(destination));\n+    return position;\n   } catch (error) {\n     if (destinationFd !== undefined) try { fs.closeSync(destinationFd); } catch {}\n     if (destinationCreated) {\ndiff --git a/cli/test/upgrade_safety.test.ts b/cli/test/upgrade_safety.test.ts\nindex 21ca117..11d23d3 100644\n--- a/cli/test/upgrade_safety.test.ts\n+++ b/cli/test/upgrade_safety.test.ts\n@@ -67,6 +67,19 @@ describe(\"Download Origin, Redirect & Bounds Safety (REQ-REL-116, ACC-UPG-08)\",\n       validateDownloadUrl(\"https://objects.githubusercontent.com/github-production-release-asset-2e65be/12345/nexus.tar.gz\"),\n       true\n     );\n+    // Newer GitHub releases redirect to a signed, release-specific asset host.\n+    assert.equal(\n+      validateDownloadUrl(\"https://release-assets.githubusercontent.com/github-production-release-asset/12345/a1111111-1111-4111-8111-111111111111\"),\n+      true\n+    );\n+    assert.equal(\n+      validateDownloadUrl(\"https://release-assets.githubusercontent.com/other-content/payload.tar.gz\"),\n+      false\n+    );\n+    assert.equal(\n+      validateDownloadUrl(\"http://release-assets.githubusercontent.com/github-production-release-asset/12345/asset\"),\n+      false\n+    );\n     // Localhost allowed for mock test servers\n     assert.equal(validateDownloadUrl(\"http://127.0.0.1:4567/download/v1.0.0/nexus.tar.gz\"), true);\n     assert.equal(validateDownloadUrl(\"http://localhost:4567/download/v1.0.0/nexus.tar.gz\"), true);\n@@ -91,6 +104,9 @@ describe(\"Download Origin, Redirect & Bounds Safety (REQ-REL-116, ACC-UPG-08)\",\n           if (req.url === \"/redirect-evil\") {\n             res.writeHead(302, { Location: \"https://evil-untrusted-site.com/payload.tar.gz\" });\n             res.end();\n+          } else if (req.url === \"/redirect-evil-signed\") {\n+            res.writeHead(302, { Location: \"https://evil-untrusted-site.com/payload.tar.gz?token=must-not-appear\" });\n+            res.end();\n           } else if (req.url?.startsWith(\"/loop-\")) {\n             const count = parseInt(req.url.replace(\"/loop-\", \"\"), 10);\n             res.writeHead(302, { Location: `http://127.0.0.1:${evilPort}/loop-${count + 1}` });\n@@ -112,6 +128,13 @@ describe(\"Download Origin, Redirect & Bounds Safety (REQ-REL-116, ACC-UPG-08)\",\n         /Disallowed download origin or invalid URL/\n       );\n \n+      const secretUrl = `http://127.0.0.1:${evilPort}/redirect-evil-signed`;\n+      await assert.rejects(downloadFile(secretUrl, path.join(testDir, \"signed.tar.gz\"), undefined, 5000), (error: Error) => {\n+        assert.match(error.message, /Disallowed download origin or invalid URL \\(https:\\/\\/evil-untrusted-site\\.com\\)/);\n+        assert.doesNotMatch(error.message, /must-not-appear/);\n+        return true;\n+      });\n+\n       // 2. Too many redirects\n       const dest2 = path.join(testDir, \"test2.tar.gz\");\n       await assert.rejects(\n@@ -125,6 +148,55 @@ describe(\"Download Origin, Redirect & Bounds Safety (REQ-REL-116, ACC-UPG-08)\",\n       fs.rmSync(testDir, { recursive: true, force: true });\n     }\n   });\n+\n+  it(\"follows the allowlisted signed GitHub release-asset redirect without forwarding credentials\", async () => {\n+    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-release-asset-\"));\n+    const originalFetch = globalThis.fetch;\n+    const originalToken = process.env.GITHUB_TOKEN;\n+    const requests: Array<{ url: string; authorization: string | null; redirect: string | undefined }> = [];\n+    const downloadUrl = \"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.8/nexus.tar.gz\";\n+    const signedAssetUrl = \"https://release-assets.githubusercontent.com/github-production-release-asset/1416386345/11111111-2222-4333-8444-555555555555?token=synthetic-signature\";\n+\n+    try {\n+      process.env.GITHUB_TOKEN = \"REDACTED\";\n+      globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit) => {\n+        const url = String(input);\n+        requests.push({\n+          url,\n+          authorization: new Headers(init?.headers).get(\"authorization\"),\n+          redirect: init?.redirect,\n+        });\n+        if (url === downloadUrl) {\n+          return new Response(null, { status: 302, headers: { location: signedAssetUrl } });\n+        }\n+        if (url === signedAssetUrl) {\n+          return new Response(new Uint8Array([0x4e, 0x58, 0x53]), { status: 200 });\n+        }\n+        throw new Error(`Unexpected mocked download URL: ${new URL(url).origin}`);\n+      }) as typeof globalThis.fetch;\n+\n+      const destination = path.join(testDir, \"release.tar.gz\");\n+      await downloadFile(\n+        downloadUrl,\n+        destination,\n+      );\n+\n+      assert.deepEqual(requests, [\n+        {\n+          url: downloadUrl,\n+          authorization: \"Bearer synthetic-github-token\",\n+          redirect: \"manual\",\n+        },\n+        { url: signedAssetUrl, authorization: null, redirect: \"manual\" },\n+      ]);\n+      assert.deepEqual(fs.readFileSync(destination), Buffer.from([0x4e, 0x58, 0x53]));\n+    } finally {\n+      globalThis.fetch = originalFetch;\n+      if (originalToken === undefined) delete process.env.GITHUB_TOKEN;\n+      else process.env.GITHUB_TOKEN = REDACTED;\n+      fs.rmSync(testDir, { recursive: true, force: true });\n+    }\n+  });\n });\n \n describe(\"Tar Archive Structural Safety Engine (REQ-REL-116, ACC-UPG-08)\", () => {\ndiff --git a/cli/test/upgrade_transaction_recovery.test.ts b/cli/test/upgrade_transaction_recovery.test.ts\nindex 306f79d..50fa45d 100644\n--- a/cli/test/upgrade_transaction_recovery.test.ts\n+++ b/cli/test/upgrade_transaction_recovery.test.ts\n@@ -274,6 +274,78 @@ describe(\"durable same-version transaction recovery\",()=>{\n   });\n });\n describe(\"complete private state/config backup restore\",()=>{\n+ it(\"reports byte progress while a single large file is still being copied\",()=>{\n+  const home=fs.mkdtempSync(path.join(os.tmpdir(),\"nexus-backup-large-progress-\"));\n+  const originalNow=Date.now;\n+  const originalWriteSync=fsDefault.writeSync;\n+  let fakeNow=0;\n+  let advancedClock=false;\n+  const progress:Array<{filesCopied:number;bytesCopied:number}>=[];\n+  try{\n+   const source=path.join(home,\".nexus/tasks\");\n+   fs.mkdirSync(source,{recursive:true,mode:0o700});\n+   fs.chmodSync(path.join(home,\".nexus\"),0o700);fs.chmodSync(source,0o700);\n+   fs.writeFileSync(path.join(source,\"large-task.json\"),Buffer.alloc(128*1024,0x61),{mode:0o600});\n+   Date.now=()=>fakeNow;\n+   fsDefault.writeSync=((...args:Parameters<typeof originalWriteSync>)=>{\n+    const written=originalWriteSync(...args);\n+    if(!advancedClock){fakeNow=5_000;advancedClock=true;}\n+    return written;\n+   }) as typeof fsDefault.writeSync;\n+   syncBuiltinESMExports();\n+\n+   const backup=createPreMigrationBackup(home,item=>progress.push(item));\n+   assert.ok(backup.stateBackupDir);\n+   assert.ok(progress.some(item=>item.filesCopied===0&&item.bytesCopied>=64*1024),\"progress must report bytes before the large file finishes\");\n+   assert.deepEqual(progress.at(-1),{filesCopied:1,bytesCopied:128*1024});\n+  }finally{\n+   Date.now=originalNow;\n+   fsDefault.writeSync=originalWriteSync;\n+   syncBuiltinESMExports();\n+   fs.rmSync(home,{recursive:true,force:true});\n+  }\n+ });\n+\n+ it(\"reports only aggregate backup progress and syncs each copied directory once\",()=>{\n+  const home=fs.mkdtempSync(path.join(os.tmpdir(),\"nexus-backup-progress-\"));\n+  const originalFsync=fsDefault.fsyncSync;\n+  const directoryFlushes=new Map<string,number>();\n+  const progress:Array<{filesCopied:number;bytesCopied:number}>=[];\n+  try{\n+   const source=path.join(home,\".nexus/tasks\");\n+   fs.mkdirSync(source,{recursive:true,mode:0o700});\n+   fs.chmodSync(path.join(home,\".nexus\"),0o700);fs.chmodSync(source,0o700);\n+   const payload=\"PRIVATE-PAYLOAD-CANARY\";\n+   for(let index=0;index<32;index++) fs.writeFileSync(path.join(source,`task-${index}.json`),`${payload}-${index}`,{mode:0o600});\n+\n+   fsDefault.fsyncSync=((fd:number)=>{\n+    const stat=fsDefault.fstatSync(fd);\n+    if(stat.isDirectory()){\n+     const key=`${stat.dev}:${stat.ino}`;\n+     directoryFlushes.set(key,(directoryFlushes.get(key)??0)+1);\n+    }\n+    return originalFsync(fd);\n+   }) as typeof fsDefault.fsyncSync;\n+   syncBuiltinESMExports();\n+\n+   const backup=createPreMigrationBackup(home,item=>progress.push(item));\n+   assert.ok(backup.stateBackupDir);\n+   const copiedDirectory=path.join(backup.stateBackupDir!,\"state\",\"tasks\");\n+   const stat=fs.statSync(copiedDirectory);\n+   assert.equal(directoryFlushes.get(`${stat.dev}:${stat.ino}`),1,\"all task file entries must be synced together after their payloads\");\n+   assert.equal(fs.readdirSync(copiedDirectory).length,32);\n+   assert.ok(progress.length>0,\"large backups must report progress\");\n+   assert.deepEqual(progress.at(-1),{filesCopied:32,bytesCopied:Array.from({length:32},(_,index)=>Buffer.byteLength(`${payload}-${index}`)).reduce((sum,size)=>sum+size,0)});\n+   assert.ok(progress.every(item=>Object.keys(item).sort().join(\",\")===\"bytesCopied,filesCopied\"),\"progress must not expose names or payloads\");\n+   assert.equal(JSON.stringify(progress).includes(payload),false);\n+   assert.equal(fs.statSync(path.join(copiedDirectory,\"task-0.json\")).mode&0o777,0o600);\n+  }finally{\n+   fsDefault.fsyncSync=originalFsync;\n+   syncBuiltinESMExports();\n+   fs.rmSync(home,{recursive:true,force:true});\n+  }\n+ });\n+\n  it(\"restores session payloads and config rather than copying an archive into config.env\",()=>{\n   const home=fs.mkdtempSync(path.join(os.tmpdir(),\"nexus-backup-roundtrip-\"));\n   try{\n","exit_code":0,"duration":{"secs":0,"nanos":581084564}},"started_at_ms":1793010014316,"completed_at_ms":1793010014898}}
{"timestamp":"2026-10-26T10:20:19.364Z","ordinal":382858,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a177b9-ac24-7a83-b347-bd577888d089","call_id":"call_5f3781ec322741819dbfdc8f1f46cbf6","output":[{"type":"input_text","text":"Script completed\nWall time 6.4 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 5415)\nTotal output lines: 433\n\ntitle=fix: accept signed GitHub release asset redirects head=1cce2f48af32633cf9b3df36aa9c37ec4c2fce6f merge=a7880b64c98d5f3f6522a18a97b2a10489f9461e url=https://github.com/mikeholownych/nexus-code/pull/248\n## Summary\n\nFix the RC6-to-RC7 upgrade failure caused by GitHub redirecting the canonical release URL to a short-lived signed asset URL. The installer now accepts only HTTPS redirects to the exact `release-assets.githubusercontent.com/github-production-release-asset/` path, keeps manual redirect validation, and does not forward GitHub credentials to the asset host. Error diagnostics report only the origin, never signed query parameters.\n\nPre-migration backups now report bounded aggregate progress and sync directory entries once per copied directory while retaining per-file fsync and fail-closed backup handling. This makes large backups observable and reduces repeated directory sync overhead.\n\n## Validation\n\n- `upgrade_safety.test.ts`: 35/35 passed, including the canonical GitHub-to-signed-\nfiles=cli/src/upgrade.ts,cli/src/upgrade_journal.ts,cli/test/upgrade_safety.test.ts,cli/test/upgrade_transaction_recovery.test.ts\na7880b6 Merge pull request #248 from mikeholownych/v1/defect-upgrade-backup-progress\n\n cli/src/upgrade.ts                            | 30 +++++++++--\n cli/src/upgrade_journal.ts                    | 75 +++++++++++++++++++++++----\n cli/test/upgrade_safety.test.ts               | 72 +++++++++++++++++++++++++\n cli/test/upgrade_transaction_recovery.test.ts | 72 +++++++++++++++++++++++++\n 4 files changed, 234 insertions(+), 15 deletions(-)\ndiff --git a/cli/src/upgrade.ts b/cli/src/upgrade.ts\nindex 1b6f865..7e5aebe 100644\n--- a/cli/src/upgrade.ts\n+++ b/cli/src/upgrade.ts\n@@ -666,9 +666,24 @@ export function validateDownloadUrl(urlString: string): boolean {\n     return true;\n   }\n \n+  // GitHub now redirects release downloads to its signed release-assets host.\n+  // Restrict the path to release objects; never allow this host as a generic CDN.\n+  if (hostname === \"release-assets.githubusercontent.com\") {\n+    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n+  }\n+\n   return false;\n }\n \n+/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\n+function safeDownloadOrigin(urlString: string): string {\n+  try {\n+    return new URL(urlString).origin;\n+  } catch {\n+    return \"invalid URL\";\n+  }\n+}\n+\n export async function downloadFile(\n   url: string,\n   destPath: string,\n@@ -688,7 +703,7 @@ export async function downloadFile(\n   try {\n     while (hops <= maxHops) {\n       if (!validateDownloadUrl(currentUrl)) {\n-        throw new Error(`Disallowed download origin or invalid URL: ${currentUrl}`);\n+        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n       }\n \n       const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n@@ -707,7 +722,7 @@ export async function downloadFile(\n       if (res.status === 301 || res.status === 302 || res.status === 307 || res.status === 308) {\n         const location = res.headers.get(\"location\");\n         if (!location) {\n-          throw new Error(`HTTP ${res.st…3815 tokens truncated…arge-task.json\"),Buffer.alloc(128*1024,0x61),{mode:0o600});\n+   Date.now=()=>fakeNow;\n+   fsDefault.writeSync=((...args:Parameters<typeof originalWriteSync>)=>{\n+    const written=originalWriteSync(...args);\n+    if(!advancedClock){fakeNow=5_000;advancedClock=true;}\n+    return written;\n+   }) as typeof fsDefault.writeSync;\n+   syncBuiltinESMExports();\n+\n+   const backup=createPreMigrationBackup(home,item=>progress.push(item));\n+   assert.ok(backup.stateBackupDir);\n+   assert.ok(progress.some(item=>item.filesCopied===0&&item.bytesCopied>=64*1024),\"progress must report bytes before the large file finishes\");\n+   assert.deepEqual(progress.at(-1),{filesCopied:1,bytesCopied:128*1024});\n+  }finally{\n+   Date.now=originalNow;\n+   fsDefault.writeSync=originalWriteSync;\n+   syncBuiltinESMExports();\n+   fs.rmSync(home,{recursive:true,force:true});\n+  }\n+ });\n+\n+ it(\"reports only aggregate backup progress and syncs each copied directory once\",()=>{\n+  const home=fs.mkdtempSync(path.join(os.tmpdir(),\"nexus-backup-progress-\"));\n+  const originalFsync=fsDefault.fsyncSync;\n+  const directoryFlushes=new Map<string,number>();\n+  const progress:Array<{filesCopied:number;bytesCopied:number}>=[];\n+  try{\n+   const source=path.join(home,\".nexus/tasks\");\n+   fs.mkdirSync(source,{recursive:true,mode:0o700});\n+   fs.chmodSync(path.join(home,\".nexus\"),0o700);fs.chmodSync(source,0o700);\n+   const payload=\"PRIVATE-PAYLOAD-CANARY\";\n+   for(let index=0;index<32;index++) fs.writeFileSync(path.join(source,`task-${index}.json`),`${payload}-${index}`,{mode:0o600});\n+\n+   fsDefault.fsyncSync=((fd:number)=>{\n+    const stat=fsDefault.fstatSync(fd);\n+    if(stat.isDirectory()){\n+     const key=`${stat.dev}:${stat.ino}`;\n+     directoryFlushes.set(key,(directoryFlushes.get(key)??0)+1);\n+    }\n+    return originalFsync(fd);\n+   }) as typeof fsDefault.fsyncSync;\n+   syncBuiltinESMExports();\n+\n+   const backup=createPreMigrationBackup(home,item=>progress.push(item));\n+   assert.ok(backup.stateBackupDir);\n+   const copiedDirectory=path.join(backup.stateBackupDir!,\"state\",\"tasks\");\n+   const stat=fs.statSync(copiedDirectory);\n+   assert.equal(directoryFlushes.get(`${stat.dev}:${stat.ino}`),1,\"all task file entries must be synced together after their payloads\");\n+   assert.equal(fs.readdirSync(copiedDirectory).length,32);\n+   assert.ok(progress.length>0,\"large backups must report progress\");\n+   assert.deepEqual(progress.at(-1),{filesCopied:32,bytesCopied:Array.from({length:32},(_,index)=>Buffer.byteLength(`${payload}-${index}`)).reduce((sum,size)=>sum+size,0)});\n+   assert.ok(progress.every(item=>Object.keys(item).sort().join(\",\")===\"bytesCopied,filesCopied\"),\"progress must not expose names or payloads\");\n+   assert.equal(JSON.stringify(progress).includes(payload),false);\n+   assert.equal(fs.statSync(path.join(copiedDirectory,\"task-0.json\")).mode&0o777,0o600);\n+  }finally{\n+   fsDefault.fsyncSync=originalFsync;\n+   syncBuiltinESMExports();\n+   fs.rmSync(home,{recursive:true,force:true});\n+  }\n+ });\n+\n  it(\"restores session payloads and config rather than copying an archive into config.env\",()=>{\n   const home=fs.mkdtempSync(path.join(os.tmpdir(),\"nexus-backup-roundtrip-\"));\n   try{\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a177a5-7619-7f61-94e2-64d374be9e23","create_time":1793010019.3647122}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
