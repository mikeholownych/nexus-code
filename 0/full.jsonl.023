ow new Error(`${providerId} has no sign-in method '${methodId}'.`);\n  const abort = new AbortController();\n  const flow = await startAuthFlow(methodId, abort.signal);\n  void openBrowser(flow.prompt.url);\n  const done = flow.result.then(\n    async (credential: StoredCredential) => {\n      saveCredential(providerId, credential);\n48-const LOCAL_ENDPOINT_CREDENTIAL_PREFIX = \"nexus-local-endpoint:\";\n49-\n50-/** Stable credential-store key for one exact HTTP(S) origin; the credential never follows another endpoint. */\n51:function localEndpointCredentialId(endpoint: string): string | undefined {\n52-  try {\n53-    const url = new URL(endpoint);\n54-    if ((url.protocol !== \"http:\" && url.protocol !== \"https:\") || url.username || url.password || url.origin === \"null\") return undefined;\n--\n58-  }\n59-}\n60-\n61:export function saveLocalEndpointCredential(endpoint: string, key: string): boolean {\n62:  const id = localEndpointCredentialId(endpoint);\n63-  const value = key.trim();\n64-  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n65-  saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n66-  return true;\n67-}\n68-\n69:export function localEndpointCredential(endpoint: string): { origin: string; key: string } | undefined {\n70:  const id = localEndpointCredentialId(endpoint);\n71-  if (!id) return undefined;\n72-  const credential = readStore().providers[id];\n73-  if (credential?.type !== \"api\") return undefined;\n--\n75-}\n76-\n77-/** Used only to prevent a project or caller-supplied key from escaping its saved endpoint origin. */\n78:export function localEndpointCredentials(): Array<{ origin: string; key: string }> {\n79-  const store = readStore();\n80-  const result: Array<{ origin: string; key: string }> = [];\n81-  for (const [id, credential] of Object.entries(store.providers)) {\n82-    if (!id.startsWith(LOCAL_ENDPOINT_CREDENTIAL_PREFIX) || credential.type !== \"api\") continue;\n83-    const origin = id.slice(LOCA