n into whole seconds (int).\\n\\n    Grammar: one or more `<integer><unit>` groups, units d, h, m, s (case-insensitive), groups optionally\\n    separated by exactly one space. Examples: \\\"1h30m\\\" -> 5400, \\\"2d\\\" -> 172800, \\\"45s\\\" -> 45, \\\"1H 30M\\\" -> 5400.\\n    Leading and trailing whitespace is ignored. Leading zeros are fine (\\\"01h\\\" -> 3600) and \\\"0s\\\" -> 0.\\n    Units must appear at most once and in descending order (d, h, m, s).\\n    A bare integer with no unit, an empty or whitespace-only string, an unknown unit, a negative or decimal\\n    number, two or more spaces between groups, or a space between a number and its unit all raise ValueError.\\n    \\\"\\\"\\\"\\n    import re\\n    \\n    # Strip leading and trailing whitespace\\n    text = text.strip()\\n    \\n    # Check for empty or whitespace-only string\\n    if not text:\\n        raise ValueError(\\\"Empty or whitespace-only string\\\")\\n    \\n    # Check for invalid spacing (two or more spaces)\\n    if '  ' in text:\\n        raise ValueError(\\\"Two or more spaces between groups\\\")\\n    \\n    # Define unit multipliers (d, h, m, s)\\n    unit_multipliers = {'d': 86400, 'h': 3600, 'm': 60, 's': 1}\\n    \\n    # Find all matches of <number><unit> patterns\\n    pattern = r'(\\\\d+)([dhms])'\\n    matches = re.findall(pattern, text, re.IGNORECASE)\\n    \\n    # Check if we have any matches\\n    if not matches:\\n        raise ValueError(\\\"No valid integer-unit pairs found\\\")\\n    \\n    # Validate that the entire text matches the pattern exactly\\n    # This ensures no spaces between number and unit, and proper format\\n    # Reconstruct the expected text from matches to validate\\n    reconstructed = ''.join(match[0] + match[1] for match in matches)\\n    if reconstructed != text:\\n        # Check if the only difference is spacing (which is allowed)\\n        # But we need to make sure the spacing is exactly one space between groups\\n        # Let's check if the original text has valid spacing\\n        # Split by spaces and reconstruct to see if it matches\\n        parts = text.split()\\n        if len(parts) > 1:\\n            # Check if parts are properly spaced (no spaces between number and unit)\\n            for part in parts:\\n                if ' ' in part:\\n                    raise ValueError(\\\"Space between number and unit\\\")\\n        \\n        # If we have a valid spacing, then the text should be a concatenation of the matches\\n        # Let's reconstruct the expected text with spaces between groups\\n        expected_text = ' '.join(match[0] + match[1] for match in matches)\\n        if expected_text != text:\\n            # If the original text doesn't match the expected format with spaces,\\n            # it means there's a space between number and unit or invalid format\\n            # But we already checked for that above, so this is a more complex case\\n            # Let's just validate the matches are correct and the format is valid\\n            pass\\n    \\n    # Process each match\\n    units_seen = set()\\n    total_seconds = 0\\n    last_unit = None\\n    \\n    for number_str, unit in matches:\\n        unit = unit.lower()\\n        \\n        # Check for negative or decimal numbers\\n        if number_str.startswith('-') or '.' in number_str:\\n            raise ValueError(\\\"Negative or decimal numbers not allowed\\\")\\n        \\n        # Check for leading zeros (except for \\\"0\\\")\\n        if len(number_str) > 1 and number_str[0] == '0':\\n            # Allow \\\"0\\\" but not \\\"01\\\", \\\"001\\\", etc.\\n            if number_str != '0':\\n                raise ValueError(\\\"Leading zeros not allowed\\\")\\n        \\n        number = int(number_str)\\n        \\n        # Check if unit already seen\\n        if unit in units_seen:\\n            raise ValueError(\\\"Unit appears more than once\\\")\\n        \\n        # Check descending order (d, h, m, s)\\n        unit_order = {'d': 0, 'h': 1, 'm': 2, 's': 3}\\n        if last_unit is not None and unit_order[unit] > unit_order[last_unit]:\\n            raise ValueError(\\\"Units must be in descending order\\\")\\n        \\n        units_seen.add(unit)\\n        total_seconds += number * unit_multipliers[unit]\\n        last_unit = unit\\n    \\n    return total_seconds\",\"new_content\":\"def parse_duration(text):\\n    \\\"\\\"\\\"Parse a human-readable duration into whole seconds (int).\\n\\n    Grammar: one or more `<integer><unit>` groups, units d, h, m, s (case-insensitive), groups optionally\\n    separated by exactly one space. Examples: \\\"1h30m\\\" -> 5400, \\\"2d\\\" -> 172800, \\\"45s\\\" -> 45, \\\"1H 30M\\\" -> 5400.\\n    Leading and trailing whitespace is ignored. Leading zeros are fine (\\\"01h\\\" -> 3600) and \\\"0s\\\" -> 0.\\n    Units must appear at most once and in descending order (d, h, m, s).\\n    A bare integer with no unit, an empty or whitespace-only string, an unknown unit, a negative or decimal\\n    number, two or more spaces between groups, or a space between a number and its unit all raise ValueError.\\n    \\\"\\\"\\\"\\n    import re\\n    \\n    # Strip leading and trailing whitespace\\n    text = text.strip()\\n    \\n    # Check for empty or whitespace-only string\\n    if not text:\\n        raise ValueError(\\\"Empty or whitespace-only string\\\")\\n    \\n    # Check for invalid spacing (two or more spaces)\\n    if '  ' in text:\\n        raise ValueError(\\\"Two or more spaces between groups\\\")\\n    \\n    # Define unit multipliers (d, h, m, s)\\n    unit_multipliers = {'d': 86400, 'h': 3600, 'm': 60, 's': 1}\\n    \\n    # Find all matches of <number><unit> patterns\\n    pattern = r'(\\\\d+)([dhms])'\\n    matches = re.findall(pattern, text, re.IGNORECASE)\\n    \\n    # Check if we have any matches\\n    if not matches:\\n        raise ValueError(\\\"No valid integer-unit pairs found\\\")\\n    \\n    # Process each match\\n    units_seen = set()\\n    total_seconds = 0\\n    last_unit = None\\n    \\n    for number_str, unit in matches:\\n        unit = unit.lower()\\n        \\n        # Check for negative or decimal numbers\\n        if number_str.startswith('-') or '.' in number_str:\\n            raise ValueError(\\\"Negative or decimal numbers not allowed\\\")\\n        \\n        # Check for leading zeros (except for \\\"0\\\")\\n        if len(number_str) > 1 and number_str[0] == '0':\\n            # Allow \\\"0\\\" but not \\\"01\\\", \\\"001\\\", etc.\\n            if number_str != '0':\\n                raise ValueError(\\\"Leading zeros not allowed\\\")\\n        \\n        number = int(number_str)\\n        \\n        # Check if unit already seen\\n        if unit in units_seen:\\n            raise ValueError(\\\"Unit appears more than once\\\")\\n        \\n        # Check descending order (d, h, m, s)\\n        unit_order = {'d': 0, 'h': 1, 'm': 2, 's': 3}\\n        if last_unit is not None and unit_order[unit] > unit_order[last_unit]:\\n            raise ValueError(\\\"Units must be in descending order\\\")\\n        \\n        units_seen.add(unit)\\n        total_seconds += number * unit_multipliers[unit]\\n        last_unit = unit\\n    \\n    return total_seconds\"}\n/home/mike/nexus-wt/provider-stream-integration/experiments/routing-b1-b2-2026-10-03/evidence/B2-run-2/T07-parse-duration.transcript.txt:386:  \"diff\": \" def parse_duration(text):\\n     \\\"\\\"\\\"Parse a human-readable duration into whole seconds (int).\\n \\n     Grammar: one or more `<integer><unit>` groups, units d, h, m, s (case-insensitive), groups optionally\\n     separated by exactly one space. Examples: \\\"1h30m\\\" -> 5400, \\\"2d\\\" -> 172800, \\\"45s\\\" -> 45, \\\"1H 30M\\\" -> 5400.\\n     Leading and trailing whitespace is ignored. Leading zeros are fine (\\\"01h\\\" -> 3600) and \\\"0s\\\" -> 0.\\n     Units must appear at most once and in descending order (d, h, m, s).\\n     A bare integer with no unit, an empty or whitespace-only string, an unknown unit, a negative or decimal\\n     number, two or more spaces between groups, or a space between a number and its unit all raise ValueError.\\n     \\\"\\\"\\\"\\n     import re\\n     \\n     # Strip leading and trailing whitespace\\n     text = text.strip()\\n     \\n     # Check for empty or whitespace-only string\\n     if not text:\\n         raise ValueError(\\\"Empty or whitespace-only string\\\")\\n     \\n     # Check for invalid spacing (two or more spaces)\\n     if '  ' in text:\\n         raise ValueError(\\\"Two or more spaces between groups\\\")\\n     \\n     # Define unit multipliers (d, h, m, s)\\n     unit_multipliers = {'d': 86400, 'h': 3600, 'm': 60, 's': 1}\\n     \\n     # Find all matches of <number><unit> patterns\\n     pattern = r'(\\\\d+)([dhms])'\\n     matches = re.findall(pattern, text, re.IGNORECASE)\\n     \\n     # Check if we have any matches\\n     if not matches:\\n         raise ValueError(\\\"No valid integer-unit pairs found\\\")\\n     \\n-    # Validate that the entire text matches the pattern exactly\\n-    # This ensures no spaces between number and unit, and proper format\\n-    # Reconstruct the expected text from matches to validate\\n-    reconstructed = ''.join(match[0] + match[1] for match in matches)\\n-    if reconstructed != text:\\n-        # Check if the only difference is spacing (which is allowed)\\n-        # But we need to make sure the spacing is exactly one space between groups\\n-        # Let's check if the original text has valid spacing\\n-        # Split by spaces and reconstruct to see if it matches\\n-        parts = text.split()\\n-        if len(parts) > 1:\\n-            # Check if parts are properly spaced (no spaces between number and unit)\\n-            for part in parts:\\n-                if ' ' in part:\\n-                    raise ValueError(\\\"Space between number and unit\\\")\\n-        \\n-        # If we have a valid spacing, then the text should be a concatenation of the matches\\n-        # Let's reconstruct the expected text with spaces between groups\\n-        expected_text = ' '.join(match[0] + match[1] for match in matches)\\n-        if expected_text != text:\\n-            # If the original text doesn't match the expected format with spaces,\\n-            # it means there's a space between number and unit or invalid format\\n-            # But we already checked for that above, so this is a more complex case\\n-            # Let's just validate the matches are correct and the format is valid\\n-            pass\\n-    \\n     # Process each match\\n     units_seen = set()\\n     total_seconds = 0\\n     last_unit = None\\n     \\n     for number_str, unit in matches:\\n         unit = unit.lower()\\n         \\n         # Check for negative or decimal numbers\\n         if number_str.startswith('-') or '.' in number_str:\\n             raise ValueError(\\\"Negative or decimal numbers not allowed\\\")\\n         \\n         # Check for leading zeros (except for \\\"0\\\")\\n         if len(number_str) > 1 and number_str[0] == '0':\\n             # Allow \\\"0\\\" but not \\\"01\\\", \\\"001\\\", etc.\\n             if number_str != '0':\\n                 raise ValueError(\\\"Leading zeros not allowed\\\")\\n         \\n         number = int(number_str)\\n         \\n         # Check if unit already seen\\n         if unit in units_seen:\\n             raise ValueError(\\\"Unit appears more than once\\\")\\n         \\n         # Check descending order (d, h, m, s)\\n         unit_order = {'d': 0, 'h': 1, 'm': 2, 's': 3}\\n         if last_unit is not None and unit_order[unit] > unit_order[last_unit]:\\n             raise ValueError(\\\"Units must be in descending order\\\")\\n         \\n         units_seen.add(unit)\\n         total_seconds += number * unit_multipliers[unit]\\n         last_unit = unit\\n     \\n     return total_seconds\\n\",\n/home/mike/nexus-wt/provider-stream-integration/experiments/routing-b1-b2-2026-10-03/evidence/B1-run-2/T09-token-bucket.transcript.txt:231:⚡ Tool Call: edit_file {\"path\":\"tests/test_comprehensive.py\",\"old_content\":\"from ratelimit import TokenBucket\\n\\nclass Clock:\\n    def __init__(self):\\n        self.t = 0.0\\n\\n    def __call__(self):\\n        return self.t\\n\\ndef test_basic_functionality():\\n    \\\"\\\"\\\"Test basic token bucket functionality\\\"\\\"\\\"\\n    clk = Clock()\\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\\n    \\n    # Should allow initial tokens\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == False  # No more tokens\\n    \\n    # Advance time and refill\\n    clk.t = 1.0\\n    assert b.allow() == True  # Should refill 1 token\\n    \\n    # Advance more time\\n    clk.t = 2.0\\n    assert b.allow() == True  # Should refill 1 more token\\n    assert b.allow() == True  # Should have 2 tokens now\\n    assert b.allow() == False  # No more tokens\\n\\ndef test_capacity_limit():\\n    \\\"\\\"\\\"Test that tokens never exceed capacity\\\"\\\"\\\"\\n    clk = Clock()\\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\\n    \\n    # Use all tokens\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == False\\n    \\n    # Advance time significantly\\n    clk.t = 100.0\\n    # Should only refill up to capacity (3 tokens)\\n    assert b.allow() == True  # 1 token\\n    assert b.allow() == True  # 2 tokens\\n    assert b.allow() == True  # 3 tokens (at capacity)\\n    assert b.allow() == False  # No more tokens\\n\\ndef test_large_cost_refusal():\\n    \\\"\\\"\\\"Test that costs larger than capacity are always refused\\\"\\\"\\\"\\n    clk = Clock()\\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\\n    \\n    # Should allow normal costs\\n    assert b.allow(1) == True\\n    assert b.allow(2) == True\\n    \\n    # Should refuse costs larger than capacity\\n    assert b.allow(4) == False  # Should refuse even though we have 0 tokens\\n    assert b.allow(5) == False  # Should refuse even though we have 0 tokens\\n    \\n    # Should still have 0 tokens\\n    assert b.allow() == False\\n\\ndef test_no_consumption_on_refusal():\\n    \\\"\\\"\\\"Test that tokens are not consumed when refusal occurs\\\"\\\"\\\"\\n    clk = Clock()\\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\\n    \\n    # Use all tokens\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == False\\n    \\n    # Try to consume more than capacity (should not consume anything)\\n    assert b.allow(5) == False\\n    assert b.allow() == False  # Should still be empty\\n    \\n    # Refill and check\\n    clk.t = 1.0\\n    assert b.allow() == True  # Should have 1 token now\\n\\nif __name__ == \\\"__main__\\\":\\n    test_basic_functionality()\\n    test_capacity_limit()\\n    test_large_cost_refusal()\\n    test_no_consumption_on_refusal()\\n    print(\\\"All tests passed!\\\")\",\"new_content\":\"from ratelimit import TokenBucket\\n\\nclass Clock:\\n    def __init__(self):\\n        self.t = 0.0\\n\\n    def __call__(self):\\n        return self.t\\n\\ndef test_basic_functionality():\\n    \\\"\\\"\\\"Test basic token bucket functionality\\\"\\\"\\\"\\n    clk = Clock()\\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\\n    \\n    # Should allow initial tokens\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == False  # No more tokens\\n    \\n    # Advance time and refill\\n    clk.t = 1.0\\n    assert b.allow() == True  # Should refill 1 token\\n    \\n    # Advance more time\\n    clk.t = 2.0\\n    assert b.allow() == True  # Should refill 1 more token\\n    assert b.allow() == True  # Should have 2 tokens now\\n    assert b.allow() == False  # No more tokens\\n\\ndef test_capacity_limit():\\n    \\\"\\\"\\\"Test that tokens never exceed capacity\\\"\\\"\\\"\\n    clk = Clock()\\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\\n    \\n    # Use all tokens\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == False\\n    \\n    # Advance time significantly\\n    clk.t = 100.0\\n    # Should only refill up to capacity (3 tokens)\\n    assert b.allow() == True  # 1 token\\n    assert b.allow() == True  # 2 tokens\\n    assert b.allow() == True  # 3 tokens (at capacity)\\n    assert b.allow() == False  # No more tokens\\n\\ndef test_large_cost_refusal():\\n    \\\"\\\"\\\"Test that costs larger than capacity are always refused\\\"\\\"\\\"\\n    clk = Clock()\\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\\n    \\n    # Should allow normal costs\\n    assert b.allow(1) == True\\n    assert b.allow(2) == True\\n    \\n    # Should refuse costs larger than capacity\\n    assert b.allow(4) == False  # Should refuse even though we have 0 tokens\\n    assert b.allow(5) == False  # Should refuse even though we have 0 tokens\\n    \\n    # Should still have 0 tokens\\n    assert b.allow() == False\\n\\ndef test_no_consumption_on_refusal():\\n    \\\"\\\"\\\"Test that tokens are not consumed when refusal occurs\\\"\\\"\\\"\\n    clk = Clock()\\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\\n    \\n    # Use all tokens\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == True\\n    assert b.allow() == False\\n    \\n    # Try to consume more than capacity (should not consume anything)\\n    assert b.allow(5) == False\\n    assert b.allow() == False  # Should still be empty\\n    \\n    # Refill and check\\n    clk.t = 1.0\\n    assert b.allow() == True  # Should have 1 token now\\n\\ndef test_original_behavior():\\n    \\\"\\\"\\\"Test the original test case to make sure it still works\\\"\\\"\\\"\\n    clk = Clock()\\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\\n    for _ in range(3):\\n        assert b.allow()\\n    clk.t += 100\\n    allowed = sum(1 for _ in range(10) if b.allow())\\n    assert allowed == 3, allowed\\n\\nif __name__ == \\\"__main__\\\":\\n    test_basic_functionality()\\n    test_capacity_limit()\\n    test_large_cost_refusal()\\n    test_no_consumption_on_refusal()\\n    test_original_behavior()\\n    print(\\\"All tests passed!\\\")\"}\n/home/mike/nexus-wt/provider-stream-integration/experiments/routing-b1-b2-2026-10-03/evidence/B1-run-2/T09-token-bucket.transcript.txt:234:  \"diff\": \" from ratelimit import TokenBucket\\n \\n class Clock:\\n     def __init__(self):\\n         self.t = 0.0\\n \\n     def __call__(self):\\n         return self.t\\n \\n def test_basic_functionality():\\n     \\\"\\\"\\\"Test basic token bucket functionality\\\"\\\"\\\"\\n     clk = Clock()\\n     b = TokenBucket(rate=1, capacity=3, clock=clk)\\n     \\n     # Should allow initial tokens\\n     assert b.allow() == True\\n     assert b.allow() == True\\n     assert b.allow() == True\\n     assert b.allow() == False  # No more tokens\\n     \\n     # Advance time and refill\\n     clk.t = 1.0\\n     assert b.allow() == True  # Should refill 1 token\\n     \\n     # Advance more time\\n     clk.t = 2.0\\n     assert b.allow() == True  # Should refill 1 more token\\n     assert b.allow() == True  # Should have 2 tokens now\\n     assert b.allow() == False  # No more tokens\\n \\n def test_capacity_limit():\\n     \\\"\\\"\\\"Test that tokens never exceed capacity\\\"\\\"\\\"\\n     clk = Clock()\\n     b = TokenBucket(rate=1, capacity=3, clock=clk)\\n     \\n     # Use all tokens\\n     assert b.allow() == True\\n     assert b.allow() == True\\n     assert b.allow() == True\\n     assert b.allow() == False\\n     \\n     # Advance time significantly\\n     clk.t = 100.0\\n     # Should only refill up to capacity (3 tokens)\\n     assert b.allow() == True  # 1 token\\n     assert b.allow() == True  # 2 tokens\\n     assert b.allow() == True  # 3 tokens (at capacity)\\n     assert b.allow() == False  # No more tokens\\n \\n def test_large_cost_refusal():\\n     \\\"\\\"\\\"Test that costs larger than capacity are always refused\\\"\\\"\\\"\\n     clk = Clock()\\n     b = TokenBucket(rate=1, capacity=3, clock=clk)\\n     \\n     # Should allow normal costs\\n     assert b.allow(1) == True\\n     assert b.allow(2) == True\\n     \\n     # Should refuse costs larger than capacity\\n     assert b.allow(4) == False  # Should refuse even though we have 0 tokens\\n     assert b.allow(5) == False  # Should refuse even though we have 0 tokens\\n     \\n     # Should still have 0 tokens\\n     assert b.allow() == False\\n \\n def test_no_consumption_on_refusal():\\n     \\\"\\\"\\\"Test that tokens are not consumed when refusal occurs\\\"\\\"\\\"\\n     clk = Clock()\\n     b = TokenBucket(rate=1, capacity=3, clock=clk)\\n     \\n     # Use all tokens\\n     assert b.allow() == True\\n     assert b.allow() == True\\n     assert b.allow() == True\\n     assert b.allow() == False\\n     \\n     # Try to consume more than capacity (should not consume anything)\\n     assert b.allow(5) == False\\n     assert b.allow() == False  # Should still be empty\\n     \\n     # Refill and check\\n     clk.t = 1.0\\n     assert b.allow() == True  # Should have 1 token now\\n \\n+def test_original_behavior():\\n+    \\\"\\\"\\\"Test the original test case to make sure it still works\\\"\\\"\\\"\\n+    clk = Clock()\\n+    b = TokenBucket(rate=1, capacity=3, clock=clk)\\n+    for _ in range(3):\\n+        assert b.allow()\\n+    clk.t += 100\\n+    allowed = sum(1 for _ in range(10) if b.allow())\\n+    assert allowed == 3, allowed\\n+\\n if __name__ == \\\"__main__\\\":\\n     test_basic_functionality()\\n     test_capacity_limit()\\n     test_large_cost_refusal()\\n     test_no_consumption_on_refusal()\\n+    test_original_behavior()\\n     print(\\\"All tests passed!\\\")\\n\",\n/home/mike/nexus-wt/provider-stream-integration/scripts/installer-smoke.sh:226:tar -C \"$TMP/upgrade-unpack\" -czf \"$TMP/release/download/$UPGRADE_VERSION/$UPGRADE_ARCHIVE\" nexus\n/home/mike/nexus-wt/readiness-rc7-current-state/docs/reviews/evidence/v1/PLAN-12_PR-12a/validation.md:28:   - End-to-end upgrade simulation (download, SHA-256 verification, manifest check, atomic symlink swap, rollback on checksum mismatch).\n/home/mike/nexus-wt/readiness-rc7-current-state/docs/reviews/evidence/v1/PLAN-12_PR-12b/validation.md:29:   - **ACC-UPG-11 (Upgrade Journal & Idempotent Crash Recovery):** Logs states (`preparing` -> `downloading` -> `staged` -> `switching` -> `switched` -> `verified` -> `complete`) to `.upgrade-journal.json`. Idempotently recovers crashes during downloading (cleans staging dir, preserves source) and switching (tests target binary, rolls back link if incomplete).\n/home/mike/nexus-wt/fix-dc/cli/src/core/approval_policy.ts:76:        // Egress asks on the first call per origin per session, then allowed for that origin\n/home/mike/nexus-wt/docs-dev-pinned-builder-current-main/docs/v1.0.0/specs/SPEC-01-safe-execution-defaults.md:97:| `egress` | fetch_web, search_web, browser_*, MCP remote tools | refused | ask | ask on the first call per origin per session, then allowed for that origin (DEC-01 option C) |\n/home/mike/nexus-wt/p05c/cli/src/core/approval_policy.ts:76:        // Egress asks on the first call per origin per session, then allowed for that origin\n/home/mike/nexus-wt/docs-dev-pinned-builder-current-main/docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md:42:   - Restrict downloads to allowed origins and redirects; enforce 250MB download and 1GB extraction limits; inspect tar archives against path traversal, absolute paths, escaping symlinks, FIFOs/devices, and duplicate entries.\n/home/mike/nexus-wt/docs-dev-pinned-builder-current-main/docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md:122:| ACC-UPG-08 | Download & Extraction Safety | Enforces allowed release origins/redirects, 250MB download and 1GB extract limits, rejects path traversal `..`, absolute paths, escaping symlinks, FIFOs/devices, and duplicate entries. |\n/home/mike/nexus-wt/readiness-rc7-current-state/docs/reviews/evidence/v1/PLAN-12_POST_REVIEW_TRANSACTION_FIXES/focused-tests.tap:286:    # Subtest: validates allowed release download origins\n/home/mike/nexus-wt/readiness-rc7-current-state/docs/reviews/evidence/v1/PLAN-12_POST_REVIEW_TRANSACTION_FIXES/focused-tests.tap:287:    ok 1 - validates allowed release download origins\n/home/mike/nexus-wt/readiness-rc7-current-state/docs/reviews/evidence/v1/PLAN-12_POST_REVIEW_TRANSACTION_FIXES/focused-tests.tap:441:    # Subtest: recovers an interrupted upgrade that crashed during downloading or staging\n","exit_code":0,"duration":{"secs":3,"nanos":56747995}},"started_at_ms":1793002586142,"completed_at_ms":1793002589200}}
