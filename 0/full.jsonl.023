(hostname === \"github.com\") {\n    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n  }\n\n  if (hostname === \"objects.githubusercontent.com\") {\n    return true;\n  }\n\n  // GitHub now redirects release downloads to its signed release-assets host.\n  // Restrict the path to release objects; never allow this host as a generic CDN.\n  if (hostname === \"release-assets.githubusercontent.com\") {\n    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n  }\n\n  return false;\n}\n\n/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\nfunction safeDownloadOrigin(urlString: string): string {\n  try {\n    return new URL(urlString).origin;\n  } catch {\n    return \"invalid URL\";\n  }\n}\n\nfunction isDownloadConnectionReset(error: any): boolean {\n  for (let current = error; current; current = current.cause) {\n    if (current.code === \"ECONNRESET\" || current.code === \"UND_ERR_SOCKET\") return true;\n  }\n  return false;\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n  let connectionResets = 0;\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\n  if (signal) {\n    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n  }\n\n  try {\n    while (hops <= maxHops) {\n      if (!validateDownloadUrl(currentUrl)) {\n        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n      }\n\n      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n        headers.Authorization = `Bearer ${token}`;\n      }\n\n      let res: Response;\n      try {\n        res = await fetch(currentUrl, {\n          headers,\n          signal: controller.signal,\n          redirect: \"manual\",\n        });\n      } catch (error) {\n  recoverUpgrade,\n  UpgradeJournalEntry,\n} from \"../src/upgrade_journal.js\";\n\nfunction completeRuntimeFixture(directory: string, version: string): void {\n  for (const sub of [\"bin\", \"lib/core\", \"lib/cli/dist\"]) fs.mkdirSync(path.join(directory, sub), { recursive:true });\n  fs.writeFileSync(path.join(directory, \"VERSION\"), version);\n  fs.writeFileSync(path.join(directory, \"lib/cli/dist/index.js\"), \"// fixture CLI payload\\n\");\n  fs.writeFileSync(path.join(directory, \"bin/nexus\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/harness-core\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/nexus-tui\"), `#!/bin/sh\\nif [ \"$1\" = --version ]; then echo ${version}; else echo NEXUS; fi\\n`, { mode:0o755 });\n}\n\ndescribe(\"Download Origin, Redirect & Bounds Safety (REQ-REL-116, ACC-UPG-08)\", () => {\n  it(\"validates allowed release download origins\", () => {\n    // Official GitHub releases\n    assert.equal(\n      validateDownloadUrl(\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0/nexus-linux-x86_64-v1.0.0.tar.gz\"),\n      true\n    );\n    // GitHub release CDN redirect host\n    assert.equal(\n      validateDownloadUrl(\"https://objects.githubusercontent.com/github-production-release-asset-2e65be/12345/nexus.tar.gz\"),\n      true\n    );\n    // Newer GitHub releases redirect to a signed, release-specific asset host.\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/github-production-release-asset/12345/a1111111-1111-4111-8111-111111111111\"),\n      true\n    );\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/other-content/payload.tar.gz\"),\n      false\n    );\n    assert.equal(\n      validateDownloadUrl(\"http://release-assets.githubusercontent.com/github-production-release-asset/12345/asset\"),\n      false\n    );\n    // Localhost allowed for mock test servers\n    assert.equal(validateDownloadUrl(\"http://127.0.0.1:4567/download/v1.0.0/nexus.tar.gz\"), true);\n    assert.equal(validateDownloadUrl(\"http://localhost:4567/download/v1.0.0/nexus.tar.gz\"), true);\n\n    // Disallowed origins\n    assert.equal(validateDownloadUrl(\"https://evil.com/releases/download/nexus.tar.gz\"), false);\n    assert.equal(validateDownloadUrl(\"https://github.com/attacker/nexus-code/releases/download/nexus.tar.gz\"), false);\n    // Reject plain HTTP for remote github.com\n      if (server) {\n        await new Promise<void>((resolve) => server!.close(() => resolve()));\n      }\n      fs.rmSync(testDir, { recursive: true, force: true });\n    }\n  });\n\n  it(\"follows the allowlisted signed GitHub release-asset redirect without forwarding credentials\", async () => {\n    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-release-asset-\"));\n    const originalFetch = globalThis.fetch;\n    const originalToken = process.env.GITHUB_TOKEN;\n    const requests: Array<{ url: string; authorization: string | null; redirect: string | undefined }> = [];\n    const downloadUrl = \"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.8/nexus.tar.gz\";\n    const signedAssetUrl = \"https://release-assets.githubusercontent.com/github-production-release-asset/1416386345/11111111-2222-4333-8444-555555555555?token=synthetic-signature\";\n\n    try {\n      process.env.GITHUB_TOKEN = \"REDACTED\";\n      globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit) => {\n        const url = String(input);\n        requests.push({\n          url,\n          authorization: new Headers(init?.headers).get(\"authorization\"),\n          redirect: init?.redirect,\n        });\n        if (url === downloadUrl) {\n          return new Response(null, { status: 302, headers: { location: signedAssetUrl } });\n        }\n        if (url === signedAssetUrl) {\n          return new Response(new Uint8Array([0x4e, 0x58, 0x53]), { status: 200 });\n        }\n        throw new Error(`Unexpected mocked download URL: ${new URL(url).origin}`);\n","exit_code":0,"duration":{"secs":0,"nanos":40573}},"started_at_ms":1793021566089,"completed_at_ms":1793021566090}}
{"timestamp":"2026-10-26T13:32:47.048Z","ordinal":388228,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17869-e048-76e2-a526-5e6f81a2525a","call_id":"call_cec96928eb8d4b8fa0266cb367791f00","output":[{"type":"input_text","text":"Script completed\nWall time 2.0 seconds\nOutput:\n"},{"type":"input_text","text":"  if (customBase) {\n    try {\n      const customParsed = new URL(customBase);\n      if (hostname === customParsed.hostname.toLowerCase()) {\n        if (parsed.protocol === \"https:\" || parsed.protocol === \"http:\") {\n          return true;\n        }\n      }\n    } catch {}\n  }\n\n  // Localhost allowed for local mock testing\n  if (hostname === \"127.0.0.1\" || hostname === \"localhost\") {\n    return parsed.protocol === \"http:\" || parsed.protocol === \"https:\";\n  }\n\n  // GitHub allowed domains - must be HTTPS\n  if (parsed.protocol !== \"https:\") {\n    return false;\n  }\n\n  if (hostname === \"github.com\") {\n    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n  }\n\n  if (hostname === \"objects.githubusercontent.com\") {\n    return true;\n  }\n\n  // GitHub now redirects release downloads to its signed release-assets host.\n  // Restrict the path to release objects; never allow this host as a generic CDN.\n  if (hostname === \"release-assets.githubusercontent.com\") {\n    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n  }\n\n  return false;\n}\n\n/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\nfunction safeDownloadOrigin(urlString: string): string {\n  try {\n    return new URL(urlString).origin;\n  } catch {\n    return \"invalid URL\";\n  }\n}\n\nfunction isDownloadConnectionReset(error: any): boolean {\n  for (let current = error; current; current = current.cause) {\n    if (current.code === \"ECONNRESET\" || current.code === \"UND_ERR_SOCKET\") return true;\n  }\n  return false;\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n  let connectionResets = 0;\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\n  if (signal) {\n    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n  }\n\n  try {\n    while (hops <= maxHops) {\n      if (!validateDownloadUrl(currentUrl)) {\n        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n      }\n\n      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n        headers.Authorization = `Bearer ${token}`;\n      }\n\n      let res: Response;\n      try {\n        res = await fetch(currentUrl, {\n          headers,\n          signal: controller.signal,\n          redirect: \"manual\",\n        });\n      } catch (error) {\n  recoverUpgrade,\n  UpgradeJournalEntry,\n} from \"../src/upgrade_journal.js\";\n\nfunction completeRuntimeFixture(directory: string, version: string): void {\n  for (const sub of [\"bin\", \"lib/core\", \"lib/cli/dist\"]) fs.mkdirSync(path.join(directory, sub), { recursive:true });\n  fs.writeFileSync(path.join(directory, \"VERSION\"), version);\n  fs.writeFileSync(path.join(directory, \"lib/cli/dist/index.js\"), \"// fixture CLI payload\\n\");\n  fs.writeFileSync(path.join(directory, \"bin/nexus\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/harness-core\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/nexus-tui\"), `#!/bin/sh\\nif [ \"$1\" = --version ]; then echo ${version}; else echo NEXUS; fi\\n`, { mode:0o755 });\n}\n\ndescribe(\"Download Origin, Redirect & Bounds Safety (REQ-REL-116, ACC-UPG-08)\", () => {\n  it(\"validates allowed release download origins\", () => {\n    // Official GitHub releases\n    assert.equal(\n      validateDownloadUrl(\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0/nexus-linux-x86_64-v1.0.0.tar.gz\"),\n      true\n    );\n    // GitHub release CDN redirect host\n    assert.equal(\n      validateDownloadUrl(\"https://objects.githubusercontent.com/github-production-release-asset-2e65be/12345/nexus.tar.gz\"),\n      true\n    );\n    // Newer GitHub releases redirect to a signed, release-specific asset host.\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/github-production-release-asset/12345/a1111111-1111-4111-8111-111111111111\"),\n      true\n    );\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/other-content/payload.tar.gz\"),\n      false\n    );\n    assert.equal(\n      validateDownloadUrl(\"http://release-assets.githubusercontent.com/github-production-release-asset/12345/asset\"),\n      false\n    );\n    // Localhost allowed for mock test servers\n    assert.equal(validateDownloadUrl(\"http://127.0.0.1:4567/download/v1.0.0/nexus.tar.gz\"), true);\n    assert.equal(validateDownloadUrl(\"http://localhost:4567/download/v1.0.0/nexus.tar.gz\"), true);\n\n    // Disallowed origins\n    assert.equal(validateDownloadUrl(\"https://evil.com/releases/download/nexus.tar.gz\"), false);\n    assert.equal(validateDownloadUrl(\"https://github.com/attacker/nexus-code/releases/download/nexus.tar.gz\"), false);\n    // Reject plain HTTP for remote github.com\n      if (server) {\n        await new Promise<void>((resolve) => server!.close(() => resolve()));\n      }\n      fs.rmSync(testDir, { recursive: true, force: true });\n    }\n  });\n\n  it(\"follows the allowlisted signed GitHub release-asset redirect without forwarding credentials\", async () => {\n    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-release-asset-\"));\n    const originalFetch = globalThis.fetch;\n    const originalToken = process.env.GITHUB_TOKEN;\n    const requests: Array<{ url: string; authorization: string | null; redirect: string | undefined }> = [];\n    const downloadUrl = \"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.8/nexus.tar.gz\";\n    const signedAssetUrl = \"https://release-assets.githubusercontent.com/github-production-release-asset/1416386345/11111111-2222-4333-8444-555555555555?token=synthetic-signature\";\n\n    try {\n      process.env.GITHUB_TOKEN = \"REDACTED\";\n      globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit) => {\n        const url = String(input);\n        requests.push({\n          url,\n          authorization: new Headers(init?.headers).get(\"authorization\"),\n          redirect: init?.redirect,\n        });\n        if (url === downloadUrl) {\n          return new Response(null, { status: 302, headers: { location: signedAssetUrl } });\n        }\n        if (url === signedAssetUrl) {\n          return new Response(new Uint8Array([0x4e, 0x58, 0x53]), { status: 200 });\n        }\n        throw new Error(`Unexpected mocked download URL: ${new URL(url).origin}`);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17847-ad27-7861-82f3-55336b77bcc9","create_time":1793021567.0484416}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
