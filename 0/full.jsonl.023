on ${comparison.targetVersion} --allow-downgrade to downgrade.`);\ncli/src/slash/session_commands.ts:378:      lines.push(`\\nNexus is already up to date (${installed.version}).`);\ncli/src/slash/session_commands.ts:388:    return reply(\"upgrade\", `Nexus is already up to date (${installed.version}). Use /upgrade --force to reinstall.`, true);\ncli/src/slash/session_commands.ts:392:    return reply(\"upgrade\", `Target version ${comparison.targetVersion} is a downgrade from ${installed.version}. Specify --allow-downgrade to proceed.`, false);\ncli/src/slash/session_commands.ts:404:        `Proposed ${comparison.action}: ${installed.version} -> ${comparison.targetVersion}.\\nConfirmation required: run /upgrade --yes to apply, or review in interactive mode.`,\ncli/src/slash/session_commands.ts:409:    const targetDest = path.join(installed.prefix || \"\", \"lib/nexus\", comparison.targetVersion);\ncli/src/slash/session_commands.ts:412:      installedVersion: installed.version,\ncli/src/slash/session_commands.ts:415:      notice: \"Installs the release package and atomically swaps the launcher symlink. The running session continues safely on the current version until restart.\"\nscripts/terminal-acceptance/README.md:16:1. Install the RC with the documented one-line command. `nexus --version` must print the RC version, and `nexus` must\ncli/src/upgrade.ts:355:          installRoot: versionDir,\ncli/src/upgrade.ts:370:        installRoot: versionDir,\ncli/src/upgrade.ts:375:        detail: provRecord ? `Packaged installation at ${versionDir} (verified provenance)` : `Legacy packaged installation at ${versionDir}`,\ncli/src/upgrade.ts:590:    reasons.push(`Cannot determine installation layout for ${installed.version}.`);\ncli/src/upgrade.ts:596:    reasons.push(`Installed version identity '${installed.version}' is unknown; target is ${targetTag}.`);\ncli/src/upgrade.ts:662:    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\ncli/src/upgrade.ts