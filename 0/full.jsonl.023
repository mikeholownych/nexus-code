{"timestamp":"2026-10-26T11:54:22.816Z","ordinal":385710,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17802-f864-7383-97fc-4fdd2f0a5d6e","item":{"type":"CommandExecution","id":"exec-dd1547c6-133c-4761-9aba-9b9abcdfb73a","process_id":"95439","command":["/usr/bin/zsh","-lc","git show v1.0.0-rc.8:install.sh | rg -n -i -C 2 'prefix|NEXUS_.*DIR|usage|attestation' | head -90"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git show v1.0.0-rc.8:install.sh | rg -n -i -C 2 'prefix|NEXUS_.*DIR|usage|attestation' | head -90"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"5-BASE=${NEXUS_RELEASE_BASE_URL:-\"https://github.com/$REPO/releases\"}\n6-VERSION=${NEXUS_VERSION:-latest}\n7:PREFIX=${NEXUS_PREFIX:-\"$HOME/.local\"}\n8-\n9-fail() { printf 'nexus installer: %s\\n' \"$*\" >&2; exit 1; }\n--\n19-command -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n20-\n21:VERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION-auto}\n22:case \"$VERIFY_ATTESTATION\" in\n23-  auto|0|1) ;;\n24:  *) fail \"NEXUS_VERIFY_ATTESTATION must be auto (verify when a trusted GitHub CLI is present), 1 (require verification) or 0 (skip verification).\" ;;\n25-esac\n26-TRUSTED_GH=\n--\n30-  TRUSTED_GH=/usr/local/bin/gh\n31-fi\n32:if [ \"$VERIFY_ATTESTATION\" = \"1\" ] && [ -z \"$TRUSTED_GH\" ]; then\n33:  fail \"provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\"\n34-fi\n35-\n--\n87-ARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n88-\n89:if [ \"$VERIFY_ATTESTATION\" != \"0\" ] && [ -n \"$TRUSTED_GH\" ]; then\n90:  if \"$TRUSTED_GH\" attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n91:     \"$TRUSTED_GH\" attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n92-    printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n93:  elif [ \"$VERIFY_ATTESTATION\" = \"1\" ]; then\n94:    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n95-  else\n96:    printf 'nexus installer: build provenance was not verified: %s could not verify the attestation (it may need gh auth login); the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' \"$TRUSTED_GH\" >&2\n97-  fi\n98:elif [ \"$VERIFY_ATTESTATION\" = \"auto\" ]; then\n99:  printf 'nexus installer: build provenance was not verified: no trusted GitHub CLI at /usr/bin/gh or /usr/local/bin/gh; the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' >&2\n100-fi\n101-\n102:VERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\n103:BIN_DIR=\"$PREFIX/bin\"\n104-LINK=\"$BIN_DIR/nexus\"\n105:mkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\n106-if [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n107-  fail \"$LINK exists and is not a symlink; left it unchanged.\"\n--\n109-if [ -L \"$LINK\" ]; then\n110-  OLD=$(readlink \"$LINK\")\n111:  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\n112-fi\n113-\n--\n174-  mv \"$PACKAGE\" \"$VERSION_DIR\"\n175-fi\n176:node - \"$VERSION_DIR/compatibility.json\" \"$VERSION\" \"$PREFIX\" \"$VERSION_DIR\" \"$LINK\" \"$ARCHIVE\" \"$ARCHIVE_SHA256\" \"$VERSION_DIR/.provenance.json\" <<'NODE'\n177-const fs = require(\"node:fs\");\n178:const [metadataPath, version, prefix, installedPath, binPath, archive, archiveSha256, output] = process.argv.slice(2);\n179-let metadata = null;\n180-try { metadata = JSON.parse(fs.readFileSync(metadataPath, \"utf8\")); } catch {}\n--\n186-  ...(metadata?.revision ? { revision: metadata.revision } : {}),\n187-  ...(metadata?.builtAt ? { builtAt: metadata.builtAt } : {}),\n188:  prefix,\n189-  installedPath,\n190-  binPath,\n","exit_code":0,"durat