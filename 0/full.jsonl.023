er executes a target binary redirected outside its version directory\", () => {\ncli/test/file_guard.test.ts:39:  assert.throws(() => acquireFileGuard(link), /redirected/);\ncli/src/core/independent_check.ts:45:/** Commands whose acceptance behavior can be redirected by workspace files and therefore needs a pre-turn snapshot. */\ncli/test/cloud_providers.test.ts:179:  test(\"a project .env cannot select a cloud provider or redirect a provider's base URL\", () => {\ncli/test/cloud_providers.test.ts:262:  test(\"redirects are refused on provider connections: the key never follows to another origin\", async () => {\ncli/test/doctor.test.ts:707:describe(\"repairs cannot be redirected by links anywhere in the path\", () => {\ncli/test/doctor.test.ts:825:      const redirectedTarget = path.join(elsewhere, \"new\");\ncli/test/doctor.test.ts:843:          if (typeof file === \"string\" && path.resolve(file) === redirectedTarget) {\ncli/test/doctor.test.ts:845:            fs.renameSync(redirectedTarget, `${redirectedTarget}.created`);\ncli/test/doctor.test.ts:846:            fs.writeFileSync(redirectedTarget, \"replacement owned by another process\");\ncli/test/doctor.test.ts:855:        assert.equal(fs.statSync(redirectedTarget).size, 0, \"content is not written before descriptor verification\");\ncli/test/doctor.test.ts:871:      const redirectedTarget = path.join(elsewhere, \"new\");\ncli/test/doctor.test.ts:889:          if (typeof directory === \"string\" && path.resolve(directory) === redirectedTarget) {\ncli/test/doctor.test.ts:891:            fs.renameSync(redirectedTarget, `${redirectedTarget}.created`);\ncli/test/doctor.test.ts:892:            fs.mkdirSync(redirectedTarget);\ncli/test/doctor.test.ts:901:        assert.equal(fs.statSync(redirectedTarget).isDirectory(), true, \"the raced directory is left untouched\");\ncli/test/fetch_web_ssrf.test.ts:19:describe(\"ACC-TRUST-03: SSRF protection, DNS pinning, redirect hop checks, and streaming 5 MB cap\", () => {\ncli