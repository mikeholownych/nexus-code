{"timestamp":"2026-10-26T14:06:16.917Z","ordinal":389274,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17885-133d-7581-bd2d-36a0306191af","item":{"type":"CommandExecution","id":"exec-d811b29f-74b6-4061-80e6-a84a1362164a","process_id":"88461","command":["/usr/bin/zsh","-lc","sed -n '48,78p' cli/src/credentials.ts; sed -n '100,136p' cli/src/credentials.ts; sed -n '136,170p' cli/src/config.ts; sed -n '195,222p' cli/src/provider_connect.ts; sed -n '285,320p' cli/test/provider_connect.test.ts"],"cwd":"file:///home/mike/nexus-wt/local-endpoint-connect","parsed_cmd":[{"type":"read","cmd":"sed -n '48,78p' cli/src/credentials.ts","name":"credentials.ts","path":"cli/src/credentials.ts"},{"type":"read","cmd":"sed -n '100,136p' cli/src/credentials.ts","name":"credentials.ts","path":"cli/src/credentials.ts"},{"type":"read","cmd":"sed -n '136,170p' cli/src/config.ts","name":"config.ts","path":"cli/src/config.ts"},{"type":"read","cmd":"sed -n '195,222p' cli/src/provider_connect.ts","name":"provider_connect.ts","path":"cli/src/provider_connect.ts"},{"type":"read","cmd":"sed -n '285,320p' cli/test/provider_connect.test.ts","name":"provider_connect.test.ts","path":"cli/test/provider_connect.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"const LOCAL_ENDPOINT_CREDENTIAL_PREFIX = \"nexus-local-endpoint:\";\n\n/** Stable credential-store key for one exact HTTP(S) origin; the credential never follows another endpoint. */\nfunction localEndpointCredentialId(endpoint: string): string | undefined {\n  try {\n    const url = new URL(endpoint);\n    if ((url.protocol !== \"http:\" && url.protocol !== \"https:\") || url.username || url.password || url.origin === \"null\") return undefined;\n    return `${LOCAL_ENDPOINT_CREDENTIAL_PREFIX}${url.origin}`;\n  } catch {\n    return undefined;\n  }\n}\n\nexport function saveLocalEndpointCredential(endpoint: string, key: string): boolean {\n  const id = localEndpointCredentialId(endpoint);\n  const value = key.trim();\n  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n  saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n  return true;\n}\n\nexport function localEndpointCredential(endpoint: string): { origin: string; key: string } | undefined {\n  const id = localEndpointCredentialId(endpoint);\n  if (!id) return undefined;\n  const credential = readStore().providers[id];\n  if (credential?.type !== \"api\") return undefined;\n  return { origin: id.slice(LOCAL_ENDPOINT_CREDENTIAL_PREFIX.length), key: credential.key };\n}\n\n/** Used only to prevent a project or caller-supplied key from escaping its saved endpoint origin. */\nexport function localEndpointCredentials(): Array<{ origin: string; key: string }> {\n\nfunction readStore(): StoreFile {\n  const raw = readJson(credentialsPath());\n  return raw && typeof raw === \"object\" && raw.providers && typeof raw.providers === \"object\"\n    ? { version: 1, providers: raw.providers }\n    : { version: 1, providers: {} };\n}\n\n/** Atomic, owner-only write: a credential file is never briefly world-readable or half-written. */\nfunction writeStore(store: StoreFile): void {\n  const file = credentialsPath();\n  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });\n  const tmp = `${file}.${process.pid}.tmp`;\n  fs.writeFileSync(tmp, JSON.stringify(store, null, 2) + \"\\n\", { mode: 0o600 });\n  fs.renameSync(tmp, file);\n  fs.chmodSync(file, 0o600);\n}\n\nexport function saveCredential(providerId: string, credential: StoredCredential): void {\n  const store = readStore();\n  store.providers[providerId] = credential;\n  writeStore(store);\n}\n\n/** Removes Nexus's own credential; connections owned by other clients or the environment are untouched. */\nexport function removeCredential(providerId: string): boolean {\n  const store = readStore();\n  if (!(providerId in store.providers)) return false;\n  delete store.providers[providerId];\n  writeStore(store);\n  return true;\n}\n\n/** Expiry (epoch ms) from a JWT's `exp` claim, without verifying it (advisory only). */\nexport function jwtExpiry(token: string | undefined): number | undefined {\n  const claims = jwtClaims(token);\n  return typeof claims?.exp === \"number\" ? claims.exp * 1000 : undefined;\n  const shellVal = shellEnvironment[key]?.trim();\n  if (shellVal) return shellVal;\n  if (isProjectEnvKey(key) && projectEnvSettings[key] !== undefined) {\n    return projectEnvSettings[key];\n  }\n  const configVal = userConfigFile[key]?.trim();\n  if (configVal) return configVal;\n  return (process.env[key]?.trim() || undefined);\n}\n\nexport function projectSetting(key: string): string | undefined {\n  return projectEnvSettings[key];\n}\n\n/** Persist non-secret appliance selection in the operator config without following symlinks or storing API keys. */\nexport function saveLocalEndpointSettings(endpoint: string, model?: string): void {\n  if (!endpoint || /[\\r\\n\\0]/.test(endpoint) || (model !== undefined && (!model || /[\\r\\n\\0]/.test(model)))) {\n    throw new Error(\"The local endpoint and any selected model must be non-empty single-line values.\");\n  }\n  const configDir = path.join(credentialStorageHome(), \".config\", \"nexus\");\n  const configFile = path.join(configDir, \"config.env\");\n  const ensureDirectory = (dir: string) => {\n    try {\n      const stat = fs.lstatSync(dir);\n      if (stat.isSymbolicLink() || !stat.isDirectory()) throw new Error(\"The Nexus configuration path is not a safe directory.\");\n    } catch (error: any) {\n      if (error?.code !== \"ENOENT\") throw error;\n      fs.mkdirSync(dir, { mode: 0o700 });\n    }\n  };\n  ensureDirectory(path.dirname(configDir));\n  ensureDirectory(configDir);\n  let existing = \"\";\n  try {\n    const stat = fs.lstatSync(configFile);\n  return { ok: removed, message: removed ? `${def.label} disconnected.` : `${def.label} had no credential saved by Nexus.` };\n}\n\n/**\n * Switches the agent to `ref` — the operator's explicit choice, which authorizes that destination for this session.\n * Returns the operator-facing outcome.\n */\nexport function selectModel(agent: AutonomousAgent, config: HarnessConfig, ref: ModelRef): { ok: boolean; message: string } {\n  const model = ref.model.trim();\n  if (!model) return { ok: false, message: \"Choose a model.\" };\n  if (ref.provider === APPLIANCE) {\n    const a = applianceConfig(config);\n    const pendingSelection = applianceEndpointSelection();\n    if (pendingSelection?.persistModelOnSelection && originOf(a.endpoint) === originOf(pendingSelection.endpoint)) {\n      try {\n        const pendingKey = pendingApplianceEndpointKey(a.endpoint);\n        if (pendingKey && !saveLocalEndpointCredential(a.endpoint, pendingKey)) {\n          return { ok: false, message: \"The endpoint was verified, but Nexus could not securely save the API key.\" };\n        }\n        saveLocalEndpointSettings(a.endpoint, model);\n        activateApplianceEndpoint(a.endpoint, model, false);\n      } catch {\n        return { ok: false, message: \"The model is available for this session, but Nexus could not securely save the selection.\" };\n      }\n    }\n    agent.setInferenceTarget({\n      provider: undefined,\n      endpoint: a.endpoint,\n\ndescribe(\"connecting from the picker\", () => {\n  test(\"local endpoint setup discovers a selected model and saves an optional key scoped to its origin\", async () => {\n    const local = await mock((s, res) => {\n      if (s.path.endsWith(\"/models\")) return json(res, s.headers.authorization === \"Bearer local-secret\" ? 200 : 401, { data: [{ id: \"engineering/lead\" }, { id: \"small-model\" }] });\n      return json(res, 200, {});\n    });\n    const other = await mock((_s, res) => json(res, 200, { data: [{ id: \"other-model\" }] }));\n    try {\n      const endpoint = `${local.url}/v1`;\n      const configured = await connectLocalEndpoint(cfg(), endpoint, \"engineering/lead\", \" local-secret \");\n      assert.equal(configured.ok, true, configured.message);\n      assert.deepEqual(configured.models, [\"engineering/lead\", \"small-model\"]);\n      assert.doesNotMatch(configured.message, /local-secret/);\n      assert.equal(fs.statSync(credentialsPath()).mode & 0o777, 0o600);\n      assert.equal(fs.statSync(path.join(home, \".config/nexus/config.env\")).mode & 0o777, 0o600);\n      const persisted = fs.readFileSync(path.join(home, \".config/nexus/config.env\"), \"utf8\");\n      assert.match(persisted, /LOCAL_LLM_ENDPOINT=/);\n      assert.match(persisted, /LOCAL_LLM_MODEL=\"engineering\\/lead\"/);\n      assert.doesNotMatch(persisted, /local-secret/);\n      assert.deepEqual(localEndpointCredential(endpoint)?.origin, new URL(endpoint).origin);\n      assert.equal(storedCredentialFor(endpoint), \"local-secret\");\n      assert.equal(mayBindCredential(\"local-secret\", endpoint), true);\n      assert.equal(mayBindCredential(\"local-secret\", other.url), false);\n\n      setCredentialAuthority({ LOCAL_LLM_ENDPOINT: endpoint }, home);\n      const client = new LocalLlmClient(cfg({ endpoint, apiKey: undefined }));\n      assert.deepEqual(await client.listModels(), [\"engineering/lead\", \"small-model\"]);\n      assert.ok(local.seen.every((request) => request.headers.authorization === \"Bearer local-secret\"));\n      assert.ok(!other.seen.some((request) => request.headers.authorization === \"Bearer local-secret\"));\n    } finally {\n      await local.close();\n      await other.close();\n    }\n  });\n\n","exit_code":0,"duration":{"secs":0,"nanos":843999370}},"started_at_ms":1793023576072,"completed_at_ms":1793023576917}}
{"timestamp":"2026-10-26T14:06:18.177Z","ordinal":389275,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17888-9041-78e2-b545-4a8f0541690c","call_id":"call_159338e50b6b4911be1602a2c6b309c8","output":[{"type":"input_text","text":"Script completed\nWall time 3.3 seconds\nOutput:\n"},{"type":"input_text","text":"const LOCAL_ENDPOINT_CREDENTIAL_PREFIX = \"nexus-local-endpoint:\";\n\n/** Stable credential-store key for one exact HTTP(S) origin; the credential never follows another endpoint. */\nfunction localEndpointCredentialId(endpoint: string): string | undefined {\n  try {\n    const url = new URL(endpoint);\n    if ((url.protocol !== \"http:\" && url.protocol !== \"https:\") || url.username || url.password || url.origin === \"null\") return undefined;\n    return `${LOCAL_ENDPOINT_CREDENTIAL_PREFIX}${url.origin}`;\n  } catch {\n    return undefined;\n  }\n}\n\nexport function saveLocalEndpointCredential(endpoint: string, key: string): boolean {\n  const id = localEndpointCredentialId(endpoint);\n  const value = key.trim();\n  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n  saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n  return true;\n}\n\nexport function localEndpointCredential(endpoint: string): { origin: string; key: string } | undefined {\n  const id = localEndpointCredentialId(endpoint);\n  if (!id) return undefined;\n  const credential = readStore().providers[id];\n  if (credential?.type !== \"api\") return undefined;\n  return { origin: id.slice(LOCAL_ENDPOINT_CREDENTIAL_PREFIX.length), key: credential.key };\n}\n\n/** Used only to prevent a project or caller-supplied key from escaping its saved endpoint origin. */\nexport function localEndpointCredentials(): Array<{ origin: string; key: string }> {\n\nfunction readStore(): StoreFile {\n  const raw = readJson(credentialsPath());\n  return raw && typeof raw === \"object\" && raw.providers && typeof raw.providers === \"object\"\n    ? { version: 1, providers: raw.providers }\n    : { version: 1, providers: {} };\n}\n\n/** Atomic, owner-only write: a credential file is never briefly world-readable or half-written. */\nfunction writeStore(store: StoreFile): void {\n  const file = credentialsPath();\n  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });\n  const tmp = `${file}.${process.pid}.tmp`;\n  fs.writeFileSync(tmp, JSON.stringify(store, null, 2) + \"\\n\", { mode: 0o600 });\n  fs.renameSync(tmp, file);\n  fs.chmodSync(file, 0o600);\n}\n\nexport function saveCredential(providerId: string, credential: StoredCredential): void {\n  const store = readStore();\n  store.providers[providerId] = credential;\n  writeStore(store);\n}\n\n/** Removes Nexus's own credential; connections owned by other clients or the environment are untouched. */\nexport function removeCredential(providerId: string): boolean {\n  const store = readStore();\n  if (!(providerId in store.providers)) return false;\n  delete store.providers[providerId];\n  writeStore(store);\n  return true;\n}\n\n/** Expiry (epoch ms) from a JWT's `exp` claim, without verifying it (advisory only). */\nexport function jwtExpiry(token: string | undefined): number | undefined {\n  const claims = jwtClaims(token);\n  return typeof claims?.exp === \"number\" ? claims.exp * 1000 : undefined;\n  const shellVal = shellEnvironment[key]?.trim();\n  if (shellVal) return shellVal;\n  if (isProjectEnvKey(key) && projectEnvSettings[key] !== undefined) {\n    return projectEnvSettings[key];\n  }\n  const configVal = userConfigFile[key]?.trim();\n  if (configVal) return configVal;\n  return (process.env[key]?.trim() || undefined);\n}\n\nexport function projectSetting(key: string): string | undefined {\n  return projectEnvSettings[key];\n}\n\n/** Persist non-secret appliance selection in the operator config without following symlinks or storing API keys. */\nexport function saveLocalEndpointSettings(endpoint: string, model?: string): void {\n  if (!endpoint || /[\\r\\n\\0]/.test(endpoint) || (model !== undefined && (!model || /[\\r\\n\\0]/.test(model)))) {\n    throw new Error(\"The local endpoint and any selected model must be non-empty single-line values.\");\n  }\n  const configDir = path.join(credentialStorageHome(), \".config\", \"nexus\");\n  const configFile = path.join(configDir, \"config.env\");\n  const ensureDirectory = (dir: string) => {\n    try {\n      const stat = fs.lstatSync(dir);\n      if (stat.isSymbolicLink() || !stat.isDirectory()) throw new Error(\"The Nexus configuration path is not a safe directory.\");\n    } catch (error: any) {\n      if (error?.code !== \"ENOENT\") throw error;\n      fs.mkdirSync(dir, { mode: 0o700 });\n    }\n  };\n  ensureDirectory(path.dirname(configDir));\n  ensureDirectory(configDir);\n  let existing = \"\";\n  try {\n    const stat = fs.lstatSync(configFile);\n  return { ok: removed, message: removed ? `${def.label} disconnected.` : `${def.label} had no credential saved by Nexus.` };\n}\n\n/**\n * Switches the agent to `ref` — the operator's explicit choice, which authorizes that destination for this session.\n * Returns the operator-facing outcome.\n */\nexport function selectModel(agent: AutonomousAgent, config: HarnessConfig, ref: ModelRef): { ok: boolean; message: string } {\n  const model = ref.model.trim();\n  if (!model) return { ok: false, message: \"Choose a model.\" };\n  if (ref.provider === APPLIANCE) {\n    const a = applianceConfig(config);\n    const pendingSelection = applianceEndpointSelection();\n    if (pendingSelection?.persistModelOnSelection && originOf(a.endpoint) === originOf(pendingSelection.endpoint)) {\n      try {\n        const pendingKey = pendingApplianceEndpointKey(a.endpoint);\n        if (pendingKey && !saveLocalEndpointCredential(a.endpoint, pendingKey)) {\n          return { ok: false, message: \"The endpoint was verified, but Nexus could not securely save the API key.\" };\n        }\n        saveLocalEndpointSettings(a.endpoint, model);\n        activateApplianceEndpoint(a.endpoint, model, false);\n      } catch {\n        return { ok: false, message: \"The model is available for this session, but Nexus could not securely save the selection.\" };\n      }\n    }\n    agent.setInferenceTarget({\n      provider: undefined,\n      endpoint: a.endpoint,\n\ndescribe(\"connecting from the picker\", () => {\n  test(\"local endpoint setup discovers a selected model and saves an optional key scoped to its origin\", async () => {\n    const local = await mock((s, res) => {\n      if (s.path.endsWith(\"/models\")) return json(res, s.headers.authorization === \"Bearer local-secret\" ? 200 : 401, { data: [{ id: \"engineering/lead\" }, { id: \"small-model\" }] });\n      return json(res, 200, {});\n    });\n    const other = await mock((_s, res) => json(res, 200, { data: [{ id: \"other-model\" }] }));\n    try {\n      const endpoint = `${local.url}/v1`;\n      const configured = await connectLocalEndpoint(cfg(), endpoint, \"engineering/lead\", \" local-secret \");\n      assert.equal(configured.ok, true, configured.message);\n      assert.deepEqual(configured.models, [\"engineering/lead\", \"small-model\"]);\n      assert.doesNotMatch(configured.message, /local-secret/);\n      assert.equal(fs.statSync(credentialsPath()).mode & 0o777, 0o600);\n      assert.equal(fs.statSync(path.join(home, \".config/nexus/config.env\")).mode & 0o777, 0o600);\n      const persisted = fs.readFileSync(path.join(home, \".config/nexus/config.env\"), \"utf8\");\n      assert.match(persisted, /LOCAL_LLM_ENDPOINT=/);\n      assert.match(persisted, /LOCAL_LLM_MODEL=\"engineering\\/lead\"/);\n      assert.doesNotMatch(persisted, /local-secret/);\n      assert.deepEqual(localEndpointCredential(endpoint)?.origin, new URL(endpoint).origin);\n      assert.equal(storedCredentialFor(endpoint), \"local-secret\");\n      assert.equal(mayBindCredential(\"local-secret\", endpoint), true);\n      assert.equal(mayBindCredential(\"local-secret\", other.url), false);\n\n      setCredentialAuthority({ LOCAL_LLM_ENDPOINT: endpoint }, home);\n      const client = new LocalLlmClient(cfg({ endpoint, apiKey: undefined }));\n      assert.deepEqual(await client.listModels(), [\"engineering/lead\", \"small-model\"]);\n      assert.ok(local.seen.every((request) => request.headers.authorization === \"Bearer local-secret\"));\n      assert.ok(!other.seen.some((request) => request.headers.authorization === \"Bearer local-secret\"));\n    } finally {\n      await local.close();\n      await other.close();\n    }\n  });\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17885-133d-7581-bd2d-36a0306191af","create_time":1793023578.1770575}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
