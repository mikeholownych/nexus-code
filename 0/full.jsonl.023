{"timestamp":"2026-10-26T14:21:17.318Z","ordinal":389713,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17885-133d-7581-bd2d-36a0306191af","item":{"type":"CommandExecution","id":"exec-6cdaca09-0b8a-4df4-be22-2a4db4bd42e2","process_id":"55453","command":["/usr/bin/zsh","-lc","git status --short --branch; git rev-parse HEAD; git rev-parse HEAD^; git ls-remote origin refs/heads/v1/local-endpoint-connect; git diff --check HEAD^ HEAD; git diff --stat HEAD^ HEAD; git show --format= --no-ext-diff HEAD -- cli/src/credentials.ts cli/src/provider_connect.ts cli/src/sidecar.ts cli/test/provider_connect.test.ts"],"cwd":"file:///home/mike/nexus-wt/local-endpoint-connect","parsed_cmd":[{"type":"unknown","cmd":"git status --short --branch; git rev-parse HEAD; git rev-parse HEAD^; git ls-remote origin refs/heads/v1/local-endpoint-connect; git diff --check HEAD^ HEAD; git diff --stat HEAD^ HEAD; git show --format= --no-ext-diff HEAD -- cli/src/credentials.ts cli/src/provider_connect.ts cli/src/sidecar.ts cli/test/provider_connect.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"## v1/local-endpoint-connect...origin/v1/local-endpoint-connect [ahead 1]\nc3bb2235286a154280f8578458a4dc8570ae542a\n1198d773ddb8c27fd27e8b6cdc0a3084edb53016\n1198d773ddb8c27fd27e8b6cdc0a3084edb53016\trefs/heads/v1/local-endpoint-connect\n cli/src/credentials.ts            | 10 ++++--\n cli/src/provider_connect.ts       | 22 +++++++++++--\n cli/src/sidecar.ts                |  6 ++--\n cli/test/provider_connect.test.ts | 68 ++++++++++++++++++++++++++++++++++++++-\n 4 files changed, 97 insertions(+), 9 deletions(-)\ndiff --git a/cli/src/credentials.ts b/cli/src/credentials.ts\nindex 9d29564..0513d46 100644\n--- a/cli/src/credentials.ts\n+++ b/cli/src/credentials.ts\n@@ -78,10 +78,16 @@ export function commitLocalEndpointSetup(endpoint: string, key: string, commitSe\n     const stat = fs.lstatSync(file);\n     if (stat.isSymbolicLink() || !stat.isFile()) throw new Error(\"The Nexus credential store is not a regular file.\");\n     const parsed = JSON.parse(fs.readFileSync(file, \"utf8\"));\n-    if (!parsed || typeof parsed !== \"object\" || !parsed.providers || typeof parsed.providers !== \"object\" || Array.isArray(parsed.providers)) {\n+    if (!parsed || typeof parsed !== \"object\" || parsed.version !== 1 || !parsed.providers || typeof parsed.providers !== \"object\" || Array.isArray(parsed.providers)) {\n       throw new Error(\"The Nexus credential store has an unsupported format.\");\n     }\n-    previous = parsed.providers[id];\n+    if (Object.hasOwn(parsed.providers, id)) {\n+      const entry = parsed.providers[id];\n+      if (!entry || typeof entry !== \"object\" || entry.type !== \"api\" || typeof entry.key !== \"string\" || !entry.key || typeof entry.savedAt !== \"string\") {\n+        throw new Error(\"The local endpoint credential has an unsupported format.\");\n+      }\n+      previous = entry;\n+    }\n   } catch (error: any) {\n     if (error?.code !== \"ENOENT\") throw new Error(\"Nexus could not safely update its credential store.\");\n   }\ndiff --git a/cli/src/provider_connect.ts b/cli/src/provider_connect.ts\nindex 50af7fc..3d7e4b1 100644\n--- a/cli/src/provider_connect.ts\n+++ b/cli/src/provider_connect.ts\n@@ -52,10 +52,20 @@ export interface LocalEndpointConnection {\n export interface LocalEndpointPreparation {\n   ok: boolean;\n   message: string;\n+  cancelled?: boolean;\n }\n \n-/** Cancel an uncommitted local setup after the operator closes its model picker. */\n-export function cancelLocalEndpointSetup(): void {\n+const localEndpointSetupRequests = new Map<string, { cancelled: boolean }>();\n+\n+/** Cancel an in-flight request, or clear provisional setup after the operator closes its model picker. */\n+export function cancelLocalEndpointSetup(requestId?: string): void {\n+  if (requestId) {\n+    const request = localEndpointSetupRequests.get(requestId);\n+    if (request) {\n+      request.cancelled = true;\n+      localEndpointSetupRequests.delete(requestId);\n+    }\n+  }\n   resetApplianceEndpointOverride();\n }\n \n@@ -89,19 +99,25 @@ function validatedKey(input: string): string | undefined {\n }\n \n /** Verify a local endpoint and keep its endpoint and optional key provisional for the live model picker. */\n-export async function prepareLocalEndpoint(base: HarnessConfig, endpointInput: string, keyInput = \"\"): Promise<LocalEndpointPreparation> {\n+export async function prepareLocalEndpoint(base: HarnessConfig, endpointInput: string, keyInput = \"\", requestId?: string): Promise<LocalEndpointPreparation> {\n   const parsed = validatedEndpoint(endpointInput);\n   if (!parsed) return { ok: false, message: \"Use an http:// or https:// endpoint without embedded credentials, query, or fragment.\" };\n   const key = validatedKey(keyInput);\n   if (key === undefined) return { ok: false, message: \"The API key must be a single value without whitespace.\" };\n+  const request = { cancelled: false };\n+  if (requestId) localEndpointSetupRequests.set(requestId, request);\n   try {\n     const models = await new LocalLlmClient(localEndpointConfig(base, parsed.endpoint, parsed.origin, key)).listModels();\n+    if (request.cancelled) return { ok: false, cancelled: true, message: \"Local endpoint setup was cancelled.\" };\n     const available = models.filter((model) => /^[A-Za-z0-9._:/@+-]{1,160}$/.test(model));\n     if (available.length === 0) return { ok: false, message: \"That endpoint returned no usable chat models.\" };\n     activateApplianceEndpoint(parsed.endpoint, undefined, true, key || undefined);\n     return { ok: true, message: `Local endpoint verified (${parsed.origin}; ${available.length} models found). Choose a model to save setup.` };\n   } catch {\n+    if (request.cancelled) return { ok: false, cancelled: true, message: \"Local endpoint setup was cancelled.\" };\n     return { ok: false, message: \"Could not list models from that endpoint. Check the URL and API key, then try again.\" };\n+  } finally {\n+    if (requestId && localEndpointSetupRequests.get(requestId) === request) localEndpointSetupRequests.delete(requestId);\n   }\n }\n \ndiff --git a/cli/src/sidecar.ts b/cli/src/sidecar.ts\nindex 8a1b55c..5257b4f 100644\n--- a/cli/src/sidecar.ts\n+++ b/cli/src/sidecar.ts\n@@ -215,7 +215,7 @@ export class SidecarServer {\n       case \"provider.cancel\":\n         this.signIns.get(command.id)?.cancel();\n         this.signIns.delete(command.id);\n-        cancelLocalEndpointSetup();\n+        cancelLocalEndpointSetup(command.id);\n         return;\n       case \"provider.disconnect\": {\n         if (this.app.getAgent().getApprovalMode() === \"read-only\") {\n@@ -262,8 +262,8 @@ export class SidecarServer {\n           result(false, \"An endpoint URL is required.\");\n           return;\n         }\n-        const prepared = await prepareLocalEndpoint(this.app.getConfig(), endpoint, key ?? \"\");\n-        result(prepared.ok, prepared.message);\n+        const prepared = await prepareLocalEndpoint(this.app.getConfig(), endpoint, key ?? \"\", id);\n+        if (!prepared.cancelled) result(prepared.ok, prepared.message);\n         return;\n       }\n       if (method === \"api-key\") {\ndiff --git a/cli/test/provider_connect.test.ts b/cli/test/provider_connect.test.ts\nindex 21c75fa..d56712f 100644\n--- a/cli/test/provider_connect.test.ts\n+++ b/cli/test/provider_connect.test.ts\n@@ -12,7 +12,7 @@ import path from \"node:path\";\n import { createHash } from \"node:crypto\";\n import type { AddressInfo } from \"node:net\";\n import { InferenceError, LocalLlmClient, mayBindCredential, setCredentialAuthority, storedCredentialFor } from \"../src/client.js\";\n-import { credentialsPath, localEndpointCredential, removeCredential, resolveCredential, saveCredential, saveLocalEndpointCredential } from \"../src/credentials.js\";\n+import { commitLocalEndpointSetup, credentialsPath, localEndpointCredential, removeCredential, resolveCredential, saveCredential, saveLocalEndpointCredential } from \"../src/credentials.js\";\n import { setOAuthEndpoints, startAuthFlow } from \"../src/oauth.js\";\n import { connectLocalEndpoint, connectWithKey, disconnect, prepareLocalEndpoint } from \"../src/provider_connect.js\";\n import { buildCatalog } from \"../src/model_catalog.js\";\n@@ -102,6 +102,32 @@ describe(\"credentials: precedence and other clients' sign-ins\", () => {\n     assert.equal(resolveCredential(\"openrouter\", \"OPENROUTER_API_KEY\")?.source, \"opencode\");\n   });\n \n+  test(\"local setup rejects unsupported store versions and malformed endpoint entries before mutation\", () => {\n+    const endpoint = \"http://127.0.0.1:4321/v1\";\n+    const id = `nexus-local-endpoint:${new URL(endpoint).origin}`;\n+    const cases = [\n+      [\"unsupported version\", { version: 2, providers: {} }],\n+      [\"null endpoint credential\", { version: 1, providers: { [id]: null } }],\n+      [\"invalid endpoint credential\", { version: 1, providers: { [id]: { type: \"api\", key: 7, savedAt: \"fixed\" } } }],\n+    ] as const;\n+    for (const [label, store] of cases) {\n+      fs.mkdirSync(path.dirname(credentialsPath()), { recursive: true });\n+      const original = `${JSON.stringify(store)}\\n`;\n+      fs.writeFileSync(credentialsPath(), original, { mode: 0o640 });\n+      fs.chmodSync(credentialsPath(), 0o640);\n+      const mode = fs.statSync(credentialsPath()).mode & 0o777;\n+      let settingsCommitted = false;\n+      assert.throws(\n+        () => commitLocalEndpointSetup(endpoint, \"new-secret\", () => { settingsCommitted = true; throw new Error(\"settings write failed\"); }),\n+        /safely update its credential store/,\n+        label,\n+      );\n+      assert.equal(settingsCommitted, false, `${label}: settings callback must not run`);\n+      assert.equal(fs.readFileSync(credentialsPath(), \"utf8\"), original, `${label}: original bytes must remain exact`);\n+      assert.equal(fs.statSync(credentialsPath()).mode & 0o777, mode, `${label}: original mode must remain exact`);\n+    }\n+  });\n+\n   test(\"reads Codex CLI, opencode, crush and Copilot plugin sign-ins in place and never changes those files\", () => {\n     const exp = Math.floor(Date.now() / 1000) + 3600;\n     const files = [\n@@ -571,6 +597,46 @@ describe(\"connecting from the picker\", () => {\n     }\n   });\n \n+  test(\"sidecar: cancelling local endpoint discovery prevents a late response from activating setup\", async () => {\n+    const previous = await mock((_s, res) => json(res, 200, { data: [{ id: \"previous-model\" }] }));\n+    const delayed = await mock((_s, res) => { setTimeout(() => json(res, 200, { data: [{ id: \"late-model\" }] }), 120); });\n+    const repo = makeRepo();\n+    operator({ LOCAL_LLM_ENDPOINT: `${previous.url}/v1` });\n+    const app = new ApplicationCore({ endpoint: `${previous.url}/v1`, model: \"previous-model\", maxSteps: 3, temperature: 0, workspace: repo, shell: \"bash\" } as any);\n+    const lines: string[] = [];\n+    const server = new SidecarServer({ app, mode: \"auto\", write: (line) => lines.push(line) });\n+    server.start();\n+    const events = () => lines.map((line) => JSON.parse(line));\n+    const send = (message: Record<string, unknown>) => server.handleLine(JSON.stringify({ v: 1, ...message }));\n+    const waitFor = async (predicate: (event: any) => boolean) => {\n+      for (let i = 0; i < 200; i++) {\n+        const found = events().find(predicate);\n+        if (found) return found;\n+        await new Promise((resolve) => setTimeout(resolve, 25));\n+      }\n+      assert.fail(\"event not seen\");\n+    };\n+    try {\n+      await send({ type: \"provider.connect\", id: \"delayed-connect\", provider: \"appliance\", method: \"local-endpoint\", endpoint: `${delayed.url}/v1`, key: \"late-secret\" });\n+      for (let i = 0; i < 200 && delayed.seen.length === 0; i++) await new Promise((resolve) => setTimeout(resolve, 10));\n+      assert.ok(delayed.seen.length > 0, \"the delayed endpoint request must be in flight before cancellation\");\n+      await send({ type: \"provider.cancel\", id: \"delayed-connect\" });\n+      await new Promise((resolve) => setTimeout(resolve, 180));\n+      assert.equal(events().some((event) => event.type === \"provider.result\" && event.id === \"delayed-connect\"), false, \"a cancelled request must not publish a late result\");\n+      assert.equal(fs.existsSync(credentialsPath()), false, \"a cancelled request must not persist its key\");\n+      assert.equal(localEndpointCredential(`${delayed.url}/v1`), undefined);\n+\n+      await send({ type: \"models.list\", id: \"after-delayed-cancel\" });\n+      const catalog = await waitFor((event) => event.type === \"models.catalog\" && event.id === \"after-delayed-cancel\");\n+      assert.deepEqual(catalog.models.filter((entry: any) => entry.provider === \"appliance\").map((entry: any) => entry.id), [\"previous-model\"]);\n+      assert.ok(previous.seen.length > 0, \"subsequent model discovery remains routed to the prior endpoint\");\n+    } finally {\n+      await server.shutdown();\n+      await previous.close();\n+      await delayed.close();\n+    }\n+  });\n+\n   test(\"sidecar: malformed credential store is preserved when local selection cannot persist\", async () => {\n     const local = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-secret\" ? 200 : 401, { data: [{ id: \"pending-model\" }] }));\n     const repo = makeRepo();\n","exit_code":0,"duration":{"secs":1,"nanos":251559078}},"started_at_ms":1793024476063,"completed_at_ms":1793024477315}}
