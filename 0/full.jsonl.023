alsPath())).mode & 0o777, 0o700);\ncli/test/provider_connect.test.ts:101:    assert.equal(removeCredential(\"openrouter\"), true);\ncli/test/provider_connect.test.ts:117:    assert.equal(chatgpt?.credential.type === \"oauth\" && chatgpt.credential.accountId, \"acct-codex\");\ncli/test/provider_connect.test.ts:118:    assert.equal(chatgpt?.credential.type === \"oauth\" && chatgpt.credential.expiresAt, exp * 1000);\ncli/test/provider_connect.test.ts:124:    assert.equal(copilot?.credential.type === \"oauth\" && copilot.credential.refresh, \"gho_PLUGIN\");\ncli/test/provider_connect.test.ts:126:    assert.equal(fs.existsSync(credentialsPath()), false, \"discovery writes nothing\");\ncli/test/provider_connect.test.ts:209:      const stored = JSON.parse(fs.readFileSync(credentialsPath(), \"utf-8\")).providers.chatgpt;\ncli/test/provider_connect.test.ts:250:      assert.equal(fs.existsSync(credentialsPath()), false, \"nothing copied into Nexus's store\");\ncli/test/provider_connect.test.ts:254:  test(\"Copilot credential discovery matches the exact GitHub host key\", () => {\ncli/test/provider_connect.test.ts:264:    const credential = resolveCredential(\"copilot\");\ncli/test/provider_connect.test.ts:265:    assert.equal(credential?.credential.type, \"oauth\");\ncli/test/provider_connect.test.ts:266:    assert.equal(credential?.credential.type === \"oauth\" ? credential.credential.refresh : undefined, \"gho_TRUSTED\");\ncli/test/provider_connect.test.ts:299:      assert.equal(fs.statSync(credentialsPath()).mode & 0o777, 0o600);\ncli/test/provider_connect.test.ts:305:      assert.deepEqual(localEndpointCredential(endpoint)?.origin, new URL(endpoint).origin);\ncli/test/provider_connect.test.ts:329:      assert.equal(fs.existsSync(credentialsPath()), false);\ncli/test/provider_connect.test.ts:336:  test(\"local endpoint credentials are never forwarded through redirects\", async () => {\ncli/test/provider_connect.test.ts:345:      assert.equal(saveLocalEndpointCredential(endpoint, \"redirect-secret\"), true);\ncli/test/provider_connect.test.ts:370:      assert.equal(fs.existsSync(credentialsPath()), false, \"the pending key is not written before model selection\");\ncli/test/provider_connect.test.ts:384:      assert.equal(fs.existsSync(credentialsPath()), false);\ncli/test/provider_connect.test.ts:388:      assert.equal(fs.statSync(credentialsPath()).mode & 0o777, 0o600);\ncli/test/provider_connect.test.ts:407:      assert.doesNotMatch(JSON.stringify(first), /sk-or-CRUSH/, \"the catalog never carries a credential\");\ncli/test/provider_connect.test.ts:546:      assert.equal(fs.existsSync(credentialsPath()), false);\ncli/test/provider_connect.test.ts:555:      assert.equal(fs.existsSync(credentialsPath()), false);\ncli/src/credentials.ts:2: * Provider credentials: where each provider's key or sign-in comes from, in precedence order.\ncli/src/credentials.ts:5: * 2. Nexus's own store, ~/.config/nexus/credentials.json (mode 0600), written by `nexus connect` and the TUI.\ncli/src/credentials.ts:12: * operator's credential home (credentialStorageHome), never from a HOME a project .env set.\ncli/src/credentials.ts:16:import { credentialStorageHome } from \"./client.js\";\ncli/src/credentials.ts:36:  credential: StoredCredential;\ncli/src/credentials.ts:50:/** Stable credential-store key for one exact HTTP(S) origin; the credential never follows another endpoint. */\ncli/src/credentials.ts:51:function localEndpointCredentialId(endpoint: string): string | undefined {\ncli/src/credentials.ts:61:export function saveLocalEndpointCredential(endpoint: string, key: string): boolean {\ncli/src/credentials.ts:62:  const id = localEndpointCredentialId(endpoint);\ncli/src/credentials.ts:69:export function localEndpointCredential(endpoint: string): { origin: string; key: string } | undefined {\ncli/src/credentials.ts:70:  const id = localEndpointCredentialId(endpoint);\ncli/src/credentials.ts:72:  const credential = readStore().providers[id];\ncli/src/cre