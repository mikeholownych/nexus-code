gh auth login); the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' \"$TRUSTED_GH\" >&2\n97-  fi\n98:elif [ \"$VERIFY_ATTESTATION\" = \"auto\" ]; then\n99:  printf 'nexus installer: build provenance was not verified: no trusted GitHub CLI at /usr/bin/gh or /usr/local/bin/gh; the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' >&2\n100-fi\n101-\n102:VERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\n103:BIN_DIR=\"$PREFIX/bin\"\n104-LINK=\"$BIN_DIR/nexus\"\n105:mkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\n106-if [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n107-  fail \"$LINK exists and is not a symlink; left it unchanged.\"\n--\n109-if [ -L \"$LINK\" ]; then\n110-  OLD=$(readlink \"$LINK\")\n111:  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\n112-fi\n113-\n--\n174-  mv \"$PACKAGE\" \"$VERSION_DIR\"\n175-fi\n176:node - \"$VERSION_DIR/compatibility.json\" \"$VERSION\" \"$PREFIX\" \"$VERSION_DIR\" \"$LINK\" \"$ARCHIVE\" \"$ARCHIVE_SHA256\" \"$VERSION_DIR/.provenance.json\" <<'NODE'\n177-const fs = require(\"node:fs\");\n178:const [metadataPath, version, prefix, installedPath, binPath, archive, archiveSha256, output] = process.argv.slice(2);\n179-let metadata = null;\n180-try { metadata = JSON.parse(fs.readFileSync(metadataPath, \"utf8\")); } catch {}\n--\n186-  ...(metadata?.revision ? { revision: metadata.revision } : {}),\n187-  ...(metadata?.builtAt ? { builtAt: metadata.builtAt } : {}),\n188:  prefix,\n189-  installedPath,\n190-  binPath,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17802-f864-7383-97fc-4fdd2f0a5d6e","create_time":1793015664.2877736}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
