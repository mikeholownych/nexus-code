;\n+        state.on_key(key(KeyCode::Down)); // local endpoint -> ChatGPT\n         let Some(Action::Send(Command::ProviderConnect { id: request, key: None, .. })) = state.on_key(key(KeyCode::Enter)) else {\n             panic!(\"chatgpt's only method is a sign-in\");\n         };\n@@ -4015,4 +4036,26 @@ mod tests {\n         assert_eq!(state.on_key(key(KeyCode::Esc)), Some(Action::Send(Command::ProviderCancel { id: request })));\n     }\n \n+    #[test]\n+    fn connect_panel_configures_local_endpoint_then_opens_its_model_picker() {\n+        let mut state = ready();\n+        type_text(&mut state, \"/connect\");\n+        let Some(Action::Send(Command::ModelsList { id })) = state.on_key(key(KeyCode::Enter)) else { panic!() };\n+        state.apply(catalog(&id));\n+        assert!(matches!(state.overlay, Some(Overlay::Connect(_))));\n+        assert_eq!(state.on_key(key(KeyCode::Enter)), None, \"appliance opens local endpoint setup\");\n+        state.on_paste(\"http://127.0.0.1:1234/v1\");\n+        state.on_key(key(KeyCode::Enter));\n+        state.on_paste(\"local-secret\");\n+        assert!(!format!(\"{:?}\", state.overlay).contains(\"local-secret\"));\n+        let Some(Action::Send(Command::ProviderConnect { id: request, provider, method, key: Some(secret), endpoint: Some(endpoint) })) = state.on_key(key(KeyCode::Enter)) else {\n+            panic!(\"expected local provider.connect with endpoint and protected key\");\n+        };\n+        assert_eq!((provider.as_str(), method.as_str(), endpoint.as_str(), secret.0.as_str()), (\"appliance\", \"local-endpoint\", \"http://127.0.0.1:1234/v1\", \"local-secret\"));\n+        assert!(!format!(\"{:?}\", Command::ProviderConnect { id: request.clone(), provider, method, key: Some(secret), endpoint: Some(endpoint) }).contains(\"local-secret\"));\n+        state.apply(ev(&format!(r#\"{{\"v\":1,\"type\":\"provider.result\",\"id\":\"{request}\",\"provider\":\"appliance\",\"success\":true,\"message\":\"Local endpoint ready (127.0.0.1; 2 models found). Choose a model to finish setup.\"}}\"#)));\n+        assert!(matches!(&state.overlay, Some(Overlay::Models(p)) if p.only.as_deref() == Some(\"appliance\")));\n+        assert!(matches!(state.take_outbox().as_slice(), [Action::Send(Command::ModelsList { .. })]));\n+    }\n+\n }\ndiff --git a/core/src/bin/nexus_tui/live_view.rs b/core/src/bin/nexus_tui/live_view.rs\nindex 1d1b203..d150dc3 100644\n--- a/core/src/bin/nexus_tui/live_view.rs\n+++ b/core/src/bin/nexus_tui/live_view.rs\n@@ -3119,9 +3119,16 @@ mod tests {\n         state.on_key(KeyEvent::new(KeyCode::Char('p'), KeyModifiers::CONTROL));\n         let screen = draw(&state, 100, 24);\n         assert!(screen.contains(\"Connect a provider\"), \"{screen}\");\n+        assert!(screen.contains(\"Appliance\"), \"the connect menu exposes local setup: {screen}\");\n         assert!(screen.contains(\"connected via Codex CLI\"), \"{screen}\");\n         assert!(screen.contains(\"unofficial sign-in\"), \"{screen}\");\n-        state.on_key(KeyEvent::new(KeyCode::Down, KeyModifiers::NONE));\n+        state.on_key(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));\n+        let screen = draw(&state, 100, 24);\n+        assert!(screen.contains(\"Local OpenAI-compatible endpoint\"), \"{screen}\");\n+        assert!(screen.contains(\"http://localhost:1234/v1\"), \"{screen}\");\n+        state.on_key(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));\n+        state.on_key(KeyEvent::new(KeyCode::Down, KeyModifiers::NONE)); // appliance -> ChatGPT\n+        state.on_key(KeyEvent::new(KeyCode::Down, KeyModifiers::NONE)); // ChatGPT -> Anthropic\n         state.on_key(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));\n         state.on_paste(\"sk-ant-VISIBLE-NEVER\");\n         let screen = draw(&state, 100, 24);\n@@ -3325,8 +3332,39 @@ fn render_connect(frame: &mut Frame, area: Rect, flow: &Connect) {\n             )));\n             &[(\"enter\", \"verify and save\"), (\"ctrl+u\", \"clear\"), (\"esc\", \"back\")]\n         }\n+        Step::LocalEndpoint { input, error } => {\n+            lines.push(Line::from(Span::styled(\"Local OpenAI-compatible endpoint\", white.add_modifier(Modifier::BOLD))));\n+            lines.push(Line::default());\n+            lines.push(Line::from(Span::styled(\"Enter the base URL, including its API path when required.\", muted)));\n+            lines.push(Line::default());\n+            lines.push(Line::from(vec![\n+                Span::styled(\"› \", Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)),\n+                Span::styled(format!(\"{}▏\", input), white),\n+            ]));\n+            focus = lines.len() - 1;\n+            if let Some(error) = error { lines.push(Line::from(Span::styled(error.clone(), Style::default().fg(Color::Red)))); }\n+            lines.push(Line::default());\n+            lines.push(Line::from(Span::styled(\"Example: http://localhost:1234/v1\", muted)));\n+            &[(\"enter\", \"continue\"), (\"paste\", \"endpoint URL\"), (\"esc\", \"back\")]\n+        }\n+        Step::LocalKey { input, error, .. } => {\n+            lines.push(Line::from(Span::styled(\"Optional endpoint API key\", white.add_modifier(Modifier::BOLD))));\n+            lines.push(Line::default());\n+            let dots = \"•\".repeat(input.0.chars().count().min(48));\n+            lines.push(Line::from(vec![\n+                Span::styled(\"› \", Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)),\n+                Span::styled(format!(\"{dots}▏\"), white),\n+                Span::styled(if input.0.is_empty() { String::new() } else { format!(\"  {} characters\", input.0.chars().count()) }, muted),\n+            ]));\n+            focus = lines.len() - 1;\n+            if let Some(error) = error { lines.push(Line::from(Span::styled(error.clone(), Style::default().fg(Color::Red)))); }\n+            lines.push(Line::default());\n+            lines.push(Line::from(Span::styled(\"Nexus checks the endpoint, stores the key in its owner-only credential store, and sends it only to this origin.\", muted)));\n+            &[(\"enter\", \"discover models\"), (\"ctrl+u\", \"clear\"), (\"esc\", \"edit endpoint\")]\n+        }\n         Step::Waiting { provider, method, auth, .. } => {\n             match auth {\n+                None if method == \"local-endpoint\" => lines.push(Line::from(Span::styled(\"Checking the local endpoint and discovering models…\", white))),\n                 None if method == \"api-key\" => lines.push(Line::from(Span::styled(format!(\"Checking the key with {}…\", label(provider)), white))),\n                 None => lines.push(Line::from(Span::styled(format!(\"Starting {} sign-in…\", label(provider)), white))),\n                 Some(info) => {\ndiff --git a/core/src/bin/nexus_tui/models.rs b/core/src/bin/nexus_tui/models.rs\nindex 7ca4b71..c2ca5b9 100644\n--- a/core/src/bin/nexus_tui/models.rs\n+++ b/core/src/bin/nexus_tui/models.rs\n@@ -2,7 +2,7 @@\n //! state turns intents into protocol commands and the sidecar decides every outcome.\n use crossterm::event::{KeyCode, KeyEvent, KeyModifiers};\n \n-use crate::protocol::{Catalog, CatalogProvider, ConnectMethod};\n+use crate::protocol::{Catalog, CatalogProvider, ConnectMethod, Secret};\n \n /// A panel's content: requested from the sidecar, then filled by its answer.\n #[derive(Clone, Debug, PartialEq)]\n@@ -267,6 +267,8 @@ pub enum Step {\n     Providers { pick: usize },\n     Methods { provider: String, pick: usize },\n     Key { provider: String, input: String, error: Option<String> },\n+    LocalEndpoint { input: String, error: Option<String> },\n+    LocalKey { endpoint: String, input: Secret, error: Option<String> },\n     /// The sidecar is verifying a key or waiting for a sign-in; `auth` arrives for sign-ins.\n     Waiting { request: String, provider: String, method: String, auth: Option<AuthInfo> },\n }\n@@ -287,13 +289,14 @@ pub enum ConnectIntent {\n     Back,\n     /// Send provider.connect (`key` only for API keys).\n     Connect { provider: String, method: String, key: Option<String> },\n+    LocalEndpoint { endpoint: String, key: Option<Secret> },\n     Cancel { request: String },\n     Disconnect { provider: String },\n }\n \n-/// Connectable providers (the appliance has no methods).\n+/// Connectable cloud providers and the local appliance endpoint setup entry.\n fn connectable(providers: &[CatalogProvider]) -> Vec<&CatalogProvider> {\n-    providers.iter().filter(|p| !p.methods.is_empty()).collect()\n+    providers.iter().filter(|p| p.id == \"appliance\" || !p.methods.is_empty()).collect()\n }\n \n impl Connect {\n@@ -329,6 +332,10 @@ impl Connect {\n \n     /// One method goes straight to it; several ask which.\n     fn choose_provider(&mut self, id: String) -> Option<ConnectIntent> {\n+        if id == \"appliance\" {\n+            self.step = Step::LocalEndpoint { input: String::new(), error: None };\n+            return None;\n+        }\n         let methods = self.methods(&id);\n         if methods.len() == 1 {\n             return self.choose_method(id, methods[0].clone());\n@@ -358,6 +365,12 @@ impl Connect {\n         if let Step::Key { input, error, .. } = &mut self.step {\n             input.extend(text.chars().filter(|c| !c.is_whitespace()));\n             *error = None;\n+        } else if let Step::LocalEndpoint { input, error } = &mut self.step {\n+            input.extend(text.chars().filter(|c| !c.is_control()).take(2048usize.saturating_sub(input.chars().count())));\n+            *error = None;\n+        } else if let Step::LocalKey { input, error, .. } = &mut self.step {\n+            input.0.extend(text.chars().filter(|c| !c.is_whitespace() && !c.is_control()));\n+            *error = None;\n         }\n     }\n \n@@ -371,7 +384,7 @@ impl Connect {\n                     KeyCode::Up => self.step = Step::Providers { pick: pick.saturating_sub(1) },\n                     KeyCode::Down => self.step = Step::Providers { pick: (pick + 