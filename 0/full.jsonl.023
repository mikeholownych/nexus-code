{"timestamp":"2026-10-26T13:26:29.628Z","ordinal":388058,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17847-ad27-7861-82f3-55336b77bcc9","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a17847-ad27-7861-82f3-55336b77bcc9","response_id":"resp_060b64278a9dfb15016adf5503e03881a0a423a171620ecf6c","usage":{"input_tokens":182217,"cached_input_tokens":181632,"cache_write_input_tokens":0,"output_tokens":131,"reasoning_output_tokens":15,"total_tokens":182348},"turn_token_usage":{"input_tokens":13087568,"cached_input_tokens":13020800,"cache_write_input_tokens":0,"output_tokens":24870,"reasoning_output_tokens":15307,"total_tokens":13112438},"thread_token_usage":{"input_tokens":7138592139,"cached_input_tokens":7062800256,"cache_write_input_tokens":0,"output_tokens":20403033,"reasoning_output_tokens":11831376,"total_tokens":7158995172}}}
{"timestamp":"2026-10-26T13:26:31.460Z","ordinal":388059,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17847-ad27-7861-82f3-55336b77bcc9","item":{"type":"CommandExecution","id":"exec-d2961e62-8eb3-401d-87ce-5b9bfdc4a899","process_id":"11443","command":["/usr/bin/zsh","-lc","sed -n '1,360p' cli/src/provider_cli.ts; sed -n '1,280p' cli/src/provider_connect.ts; rg -n 'CONNECT|provider.list|listProviders|provider.connect|Appliance' cli/src/model_catalog.ts cli/src"],"cwd":"file:///home/mike/nexus-wt/postmerge-254-b73b6ec","parsed_cmd":[{"type":"read","cmd":"sed -n '1,360p' cli/src/provider_cli.ts","name":"provider_cli.ts","path":"cli/src/provider_cli.ts"},{"type":"read","cmd":"sed -n '1,280p' cli/src/provider_connect.ts","name":"provider_connect.ts","path":"cli/src/provider_connect.ts"},{"type":"search","cmd":"rg -n 'CONNECT|provider.list|listProviders|provider.connect|Appliance' cli/src/model_catalog.ts cli/src","query":"CONNECT|provider.list|listProviders|provider.connect|Appliance","path":"model_catalog.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * Operator surface for cloud providers: what is configured, which credentials are present (never their values),\n * where each role's requests go, and an opt-in live check that a provider/model completes a tool round trip.\n */\nimport type { Command } from \"commander\";\nimport { randomUUID } from \"node:crypto\";\nimport pc from \"picocolors\";\nimport { InferenceError, LocalLlmClient, operatorSetting } from \"./client.js\";\nimport { buildConfig } from \"./config.js\";\nimport { baseUrlSetting, disclosureClass, PROVIDERS } from \"./providers.js\";\nimport type { ChatMessage, HarnessConfig, ToolDefinition } from \"./types.js\";\nimport { UsageLedger } from \"./usage.js\";\nimport { resolveCredential } from \"./credentials.js\";\nimport { connectWithKey, disconnect, startSignIn } from \"./provider_connect.js\";\nimport { redactSecrets } from \"./ui.js\";\n\n/** One line naming each role's selected destination and its disclosure class. */\nexport function describeTarget(config: HarnessConfig): string {\n  const target = (provider: string | undefined, endpoint: string, model: string) => {\n    // Endpoint paths, userinfo, query strings and model ids are operator-controlled environment/config values.\n    // Show only the parsed origin and a model id that passes the display allowlist.\n    const origin = safeOriginOf(endpoint);\n    const label = provider ? PROVIDERS[provider]?.label ?? \"Cloud provider\" : \"Local endpoint\";\n    const where = origin ? `${label} (${origin})` : `${label} (endpoint unavailable)`;\n    return `${where} · ${model ? safeModelId(model) : \"no model\"} · ${disclosureClass(endpoint, provider, config.cloudRoutedOrigins)}`;\n  };\n  const parts = [`main: ${target(config.provider, config.endpoint, config.model)}`];\n  if (config.plannerModel) {\n    const p = config.plannerProvider ?? (config.plannerEndpoint ? undefined : config.provider);\n    parts.push(`planner: ${target(p, config.plannerEndpoint ?? config.endpoint, config.plannerModel)}`);\n  }\n  if (config.coderModel) {\n    const p = config.coderProvider ?? (config.coderEndpoint ? undefined : config.provider);\n    parts.push(`coder: ${target(p, config.coderEndpoint ?? config.endpoint, config.coderModel)}`);\n  }\n  return `[nexus] Inference — ${parts.join(\" | \")}`;\n}\n\nfunction credentialShaped(value: string): boolean {\n  return [\n    /sk-[A-Za-z0-9_-]{8,}/i,\n    /(?:gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,})/i,\n    /xox[baprs]-[A-Za-z0-9-]{10,}/i,\n    /AKIA[0-9A-Z]{16}/i,\n    /AIza[0-9A-Za-z_-]{35}/i,\n    /ya29\\.[0-9A-Za-z_-]{20,}/,\n    /eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}/i,\n  ].some((pattern) => pattern.test(value));\n}\n\n/** Keep endpoint attribution while removing credential-shaped labels from displayed hostnames. */\nfunction safeOriginOf(value: string | undefined): string | undefined {\n  if (!value?.trim()) return undefined;\n  try {\n    const url = new URL(value.trim());\n    const spansHostnameLabels = [\n      /ya29\\.[A-Za-z0-9_-]{20,}/i,\n      /eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}/i,\n    ].some((pattern) => pattern.test(url.hostname));\n    const hostname = spansHostnameLabels\n      ? \"(redacted)\"\n      : url.hostname.split(\".\").map((label) => credentialShaped(label) ? \"(redacted)\" : label).join(\".\");\n    return `${url.protocol}//${hostname}${url.port ? `:${url.port}` : \"\"}`;\n  } catch {\n    return undefined;\n  }\n}\n\nfunction safeProviderId(value: string | undefined): string | undefined {\n  return value && Object.prototype.hasOwnProperty.call(PROVIDERS, value) ? value : value ? \"(unrecognized provider)\" : undefined;\n}\n\nfunction safeConfigurationError(error: unknown): string {\n  const message = error instanceof Error ? error.message : \"\";\n  const match = /^Unknown provider '([^'\\r\\n]{1,128})' \\([A-Z0-9_]{1,64}\\)\\. Known providers: [A-Za-z0-9, ]+\\.$/.exec(message);\n  if (!match) return \"Configuration error: provider configuration is invalid\";\n  // An unknown provider name comes from user configuration; even identifier-shaped values may be secrets.\n  return `Configuration error: Unknown provider '(unrecognized provider)'. Known providers: ${Object.keys(PROVIDERS).join(\", \")}.`;\n}\n\nfunction safeModelId(value: string): string {\n  // Provider/model identifiers may contain routing punctuation, but not whitespace, controls or arbitrary diagnostics.\n  if (!/^[A-Za-z0-9._:\\/@+-]{1,160}$/.test(value)) return \"(unprintable model id)\";\n  return credentialShaped(value) ? \"(unprintable model id)\" : value;\n}\n\nfunction safeClientDiagnostic(message: string, config: HarnessConfig): string {\n  let safe = redactSecrets(message);\n  const substitute = (raw: string | undefined, replacement: string | undefined) => {\n    if (raw && replacement && raw !== replacement) safe = safe.replaceAll(raw, () => replacement);\n  };\n  if (config.model) substitute(config.model, safeModelId(config.model));\n  const safeOrigin = safeOriginOf(config.endpoint);\n  if (safeOrigin) {\n    substitute(config.endpoint.trim(), safeOrigin);\n    try {\n      const endpoint = new URL(config.endpoint.trim());\n      substitute(endpoint.href, safeOrigin);\n      substitute(`${endpoint.origin}${endpoint.pathname}${endpoint.search}${endpoint.hash}`, safeOrigin);\n      substitute(`${endpoint.origin}${endpoint.pathname}`, safeOrigin);\n      substitute(endpoint.origin, safeOrigin);\n      substitute(endpoint.hostname, new URL(safeOrigin).hostname);\n      substitute(endpoint.pathname, \"(path redacted)\");\n      substitute(endpoint.search, \"\");\n      substitute(endpoint.hash, \"\");\n    } catch {\n      // Invalid endpoints are rejected by config validation before the live check starts.\n    }\n  }\n  return safe;\n}\n\nconst SAFE_FAILURE_KINDS = new Set([\n  \"http_error\", \"network_error\", \"timeout\", \"stream_interrupted\", \"stream_incomplete\", \"provider_error_frame\",\n  \"malformed_event\", \"output_truncated\", \"protocol_error\", \"aborted\", \"policy_denied\", \"configuration_error\", \"verification_error\",\n]);\nconst SAFE_FAILURE_CONDITIONS = new Set([\n  \"TEMPORARILY_UNAVAILABLE\", \"RATE_LIMITED\", \"OVERLOADED\", \"DRAINING\", \"AUTH_FAILURE\", \"QUOTA_EXHAUSTED\",\n  \"CAPACITY_REJECTED\", \"REQUEST_REJECTED\", \"PERMANENT_FAILURE\", \"AVAILABLE\",\n]);\n\nfunction safeStepDetail(ok: boolean, detail: string): string {\n  if (!ok) return detail === \"Provider request failed\" ? detail : \"Verification failed\";\n  if (/^streamed completion received \\(\\d+ chars\\)$/.test(detail)) return detail;\n  if (/^echo_token tool call completed \\(\\d+ call\\(s\\)\\)$/.test(detail)) return detail;\n  return detail === \"tool result round trip completed\" ? detail : \"Verification succeeded\";\n}\n\n/** A credential-safe JSON projection for `providers verify --json`; raw provider diagnostics are deliberately omitted. */\nexport function verificationSummary(\n  steps: readonly VerificationStep[],\n  receipts: readonly import(\"./usage.js\").InferenceReceipt[],\n  target?: Pick<HarnessConfig, \"provider\" | \"model\">,\n) {\n  const provider = safeProviderId(target?.provider ?? receipts[0]?.providerId);\n  const model = target?.model ?? receipts[0]?.selectedModel;\n  return {\n    passed: steps.length === 3 && steps.every((step) => step.ok),\n    ...(provider ? { provider } : {}),\n    ...(model ? { model: safeModelId(model) } : {}),\n    steps: steps.map(({ step, ok, requestId, detail, failureKind, failureCondition }) => {\n      const safeKind = failureKind && SAFE_FAILURE_KINDS.has(failureKind) ? failureKind : undefined;\n      const safeCondition = failureCondition && SAFE_FAILURE_CONDITIONS.has(failureCondition) ? failureCondition : undefined;\n      return {\n        step, ok, requestId, detail: safeStepDetail(ok, detail),\n        ...(safeKind ? { failureKind: safeKind } : {}),\n        ...(safeCondition ? { condition: safeCondition } : {}),\n      };\n    }),\n    receipts: receipts.map(({ at, requestId, role, providerId, selectedModel, effectiveModel, endpointOrigin, protocol, disclosure, executions, outcome, failureKind, usage, usageConfidence, costConfidence }) => {\n      const origin = safeOriginOf(endpointOrigin);\n      return {\n        at, requestId, role, providerId: safeProviderId(providerId) ?? \"(unrecognized provider)\",\n        selectedModel: safeModelId(selectedModel),\n        ...(effectiveModel ? { effectiveModel: safeModelId(effectiveModel) } : {}),\n        ...(origin ? { endpointOrigin: origin } : {}),\n        protocol, disclosure, ...(executions !== undefined ? { executions } : {}), outcome,\n        ...(failureKind && SAFE_FAILURE_KINDS.has(failureKind) ? { failureKind } : {}), ...(usage ? { usage } : {}), usageConfidence, costConfidence,\n      };\n    }),\n  };\n}\n\nconst ECHO_TOOL: ToolDefinition = {\n  type: \"function\",\n  function: {\n    name: \"echo_token\",\n    description: \"Echo the given token back. Call this exactly once with the token the user gives you.\",\n    parameters: { type: \"object\", properties: { token: { type: \"string\", description: \"The token to echo\" } }, required: [\"token\"] },\n  },\n};\n\nexport interface VerificationStep {\n  step: string;\n  ok: boolean;\n  detail: string;\n  requestId: string;\n  failureKind?: string;\n  failureCondition?: string;\n}\n\n/**\n * Live qualification without workspace content: a streamed completion, then a tool round trip (the model must call\n * echo_token with a nonce, receive its result and answer). Each step is one receipt in the usage ledger.\n */\nexport async function verifyProvider(\n  config: HarnessConfig,\n  signal?: AbortSignal,\n  options?: { diagnosticHandler?: (level: \"error\" | \"warn\", message: string) => void },\n): Promise<VerificationStep[]> {\n  const client = new LocalLlmClient({ ...config, maxSteps: 1 }, { role: \"qualification\", diagnosticHandler: options?.diagnosticHandler });\n  const steps: VerificationStep[] = [];\n  const run = async (step: string, fn: (requestId: string) => Promise<string>) => {\n    const requestId = randomUUID();\n    try {\n      steps.push({ step, ok: true, detail: await fn(requestId), requestId });\n    } catch (err: any) {\n      steps.push({\n        step,\n        ok: false,\n        detail: err instanceof InferenceError ? \"Provider request failed\" : \"Verification failed\",\n        requestId,\n        failureKind: err instanceof InferenceError ? err.kind : \"verification_error\",\n        ...(err instanceof InferenceError ? { failureCondition: err.condition } : {}),\n      });\n    }\n  };\n  await run(\"streamed completion\", async (id) => {\n    let streamed = \"\";\n    const m = await client.chatCompletionStream([{ role: \"user\", content: \"Reply with exactly the word READY.\" }], [], (t) => (streamed += t), id, signal);\n    const text = typeof m.content === \"string\" ? m.content : \"\";\n    if (!/READY/i.test(text)) throw new Error(`unexpected reply: ${text.slice(0, 80)}`);\n    return `streamed completion received (${streamed.length} chars)`;\n  });\n  if (!steps[0].ok) return steps;\n  const nonce = `n${randomUUID().slice(0, 8)}`;\n  const history: ChatMessage[] = [\n    { role: \"system\", content: \"You are a connectivity check. Use the tool when asked.\" },\n    { role: \"user\", content: `Call echo_token with token \"${nonce}\", then tell me what it returned.` },\n  ];\n  let call: ChatMessage | undefined;\n  await run(\"tool call\", async (id) => {\n    call = await client.chatCompletionStream(history, [ECHO_TOOL], undefined, id, signal);\n    const tc = call.tool_calls?.[0];\n    if (!tc || tc.function.name !== \"echo_token\") throw new Error(\"model did not call echo_token\");\n    const args = JSON.parse(tc.function.arguments || \"{}\");\n    if (args.token !== nonce) throw new Error(`tool arguments did not carry the nonce: ${tc.function.arguments.slice(0, 80)}`);\n    return `echo_token tool call completed (${call.tool_calls!.length} call(s))`;\n  });\n  if (!steps[1].ok || !call) return steps;\n  await run(\"tool result round trip\", async (id) => {\n    const tc = call!.tool_calls![0];\n    const followUp: ChatMessage[] = [\n      ...history,\n      { role: \"assistant\", content: call!.content ?? null, tool_calls: call!.tool_calls, ...(call!.provider_state ? { provider_state: call!.provider_state } : {}) },\n      ...call!.tool_calls!.map((c) => ({ role: \"tool\" as const, tool_call_id: c.id, name: c.function.name, content: c.id === tc.id ? `echoed:${nonce}` : \"skipped\" })),\n    ];\n    const final = await client.chatCompletionStream(followUp, [ECHO_TOOL], undefined, id, signal);\n    const text = typeof final.content === \"string\" ? final.content : \"\";\n    if (!text.includes(nonce)) throw new Error(`final answer did not use the tool result: ${text.slice(0, 80)}`);\n    return \"tool result round trip completed\";\n  });\n  return steps;\n}\n\n/** Reads a secret: piped stdin as-is, or typed at the terminal without echo. */\nasync function readSecret(prompt: string): Promise<string> {\n  if (!process.stdin.isTTY) {\n    let data = \"\";\n    for await (const chunk of process.stdin) data += chunk;\n    return data.trim();\n  }\n  const readline = await import(\"node:readline\");\n  const rl = readline.createInterface({ input: process.stdin, output: process.stdout, terminal: true });\n  let muted = false;\n  (rl as any)._writeToOutput = (text: string) => { if (!muted || text.includes(\"\\n\")) process.stdout.write(muted ? \"\\n\" : text); };\n  return new Promise((resolve) => {\n    rl.question(prompt, (answer) => { rl.close(); resolve(answer.trim()); });\n    muted = true;\n  });\n}\n\nexport function registerProviderCommands(program: Command): void {\n  program\n    .command(\"connect\")\n    .description(\"Connect a cloud provider: save an API key (verified first) or sign in\")\n    .argument(\"<provider>\", \"openrouter, openai, anthropic, chatgpt, copilot, compatible\")\n    .option(\"--method <id>\", \"api-key (default where offered), openrouter-oauth, chatgpt-oauth, copilot-device\")\n    .action(async (providerId: string, options: any) => {\n      const def = PROVIDERS[providerId];\n      if (!def) {\n        console.error(pc.red(`Unknown provider '${providerId}'. Known: ${Object.keys(PROVIDERS).join(\", \")}`));\n        process.exit(2);\n      }\n      const method = def.methods.find((m) => m.id === (options.method ?? def.methods[0].id));\n      if (!method) {\n        console.error(pc.red(`${def.label} methods: ${def.methods.map((m) => m.id).join(\", \")}`));\n        process.exit(2);\n      }\n      const base = buildConfig({});\n      const existing = resolveCredential(def.id, def.credentialEnv);\n      if (existing) console.log(pc.dim(`${def.label} is already connected via ${existing.source}; a new connection is saved in Nexus.`));\n      if (method.unofficial) console.log(pc.yellow(`${method.label}: unofficial — it signs in as another vendor's client, which the provider's terms may not permit.`));\n      if (method.kind === \"key\") {\n        const r = await connectWithKey(base, def.id, await readSecret(`${def.label} API key: `));\n        console.log(r.ok ? pc.green(r.message) : pc.red(r.message));\n        process.exitCode = r.ok ? 0 : 1;\n        return;\n      }\n      const signIn = await startSignIn(base, def.id, method.id);\n      process.once(\"SIGINT\", () => signIn.cancel());\n      console.log(`\\n${signIn.prompt.instructions}\\n  ${pc.bold(signIn.prompt.url)}${signIn.prompt.userCode ? `\\n  code: ${pc.bold(signIn.prompt.userCode)}` : \"\"}\\n`);\n      const r = await signIn.done;\n      console.log(r.ok ? pc.green(r.message) : pc.red(r.message));\n      process.exitCode = r.ok ? 0 : 1;\n    });\n\n  program\n    .command(\"disconnect\")\n    .description(\"Remove the credential Nexus saved for a provider (environment and other clients are untouched)\")\n    .argument(\"<provider>\")\n    .action((providerId: string) => {\n      const r = disconnect(providerId);\n      console.log(r.ok ? pc.green(r.message) : pc.yellow(r.message));\n    });\n\n  const providers = program\n    .command(\"providers\")\n    .description(\"List cloud inference providers, credential status and the selected destinations\")\n    .action(() => {\n      console.log(pc.bold(\"\\nCloud inference providers\\n\"));\n      for (const def of Object.values(PROVIDERS)) {\n        const configuredBase = operatorSetting(baseUrlSetting(def.id));\n        const baseUrl = configuredBase || def.baseUrl;\n        const base = baseUrl ? safeOriginOf(baseUrl) ?? \"(invalid endpoint)\" : \"(set --base-url or \" + baseUrlSetting(def.id) + \")\";\n        const found = resolveCredential(def.id, def.credentialEnv);\n        const key = found ? pc.green(`connected via ${found.source}`) : pc.yellow(`not connected (${def.credentialEnv ? `$${def.credentialEnv} or ` : \"\"}nexus connect ${def.id})`);\n        console.log(`  ${pc.bold(def.id.padEnd(11))} ${def.protocol.padEnd(19)} ${base}`);\n        console.log(`  ${\"\".padEnd(11)} ${key}${def.methods.some((m) => m.unofficial) ? pc.dim(\"  · unofficial sign-in\") : \"\"}`);\n      }\n      let config: HarnessConfig;\n      try {\n        config = buildConfig({});\n      } catch (err: any) {\n        console.log(pc.red(`\\n${safeConfigurationError(err)}`));\n        process.exitCode = 2;\n        return;\n      }\n      console.log(`\\n${describeTarget(config)}`);\n      const authorized = config.authorizedDisclosureOrigins ?? [];\n      console.log(pc.dim(`Authorized cloud destinations: ${authorized.length ? authorized.map((origin) => safeOriginOf(origin) ?? \"(invalid endpoint)\").join(\", \") : \"none\"}`));\n      console.log(pc.dim(\"Select with --provider <id> --model <id> (or NEXUS_PROVIDER / NEXUS_MODEL in ~/.config/nexus/config.env).\\n\"));\n    });\n\n  providers\n    .command(\"verify\")\n    .description(\"Live check: streamed completion and a tool round trip against a provider (sends no workspace content)\")\n    .requiredOption(\"--provider <id>\", \"Provider to check\")\n    .option(\"-m, --model <name>\", \"Model id (default: $NEXUS_MODEL)\")\n    .option(\"--base-url <url>\", \"Override the provider's base URL\")\n    .option(\"-j, --json\", \"Print steps and receipts as JSON\")\n    .action(async (options: any) => {\n      let config: HarnessConfig;\n      try {\n        config = buildConfig(options);\n      } catch (err: any) {\n        console.error(pc.red(safeConfigurationError(err)));\n        process.exit(2);\n      }\n      const abort = new AbortController();\n      process.once(\"SIGINT\", () => abort.abort(new Error(\"SIGINT\")));\n      const diagnosticHandler = (level: \"error\" | \"warn\", message: string) => {\n        (level === \"warn\" ? console.warn : console.error)(pc.dim(safeClientDiagnostic(message, config)));\n      };\n      const steps = await verifyProvider(config, abort.signal, { diagnosticHandler });\n      const receipts = UsageLedger.global().all();\n      const summary = verificationSummary(steps, receipts, { provider: config.provider, model: config.model });\n      if (options.json) {\n        console.log(JSON.stringify({ date: new Date().toISOString(), ...summary }, null, 2));\n      } else {\n/**\n * Connecting providers and switching the session's model; shared by the live TUI (through the sidecar) and the CLI.\n * A key is verified against the provider before it is saved; a sign-in is saved when the provider issues the\n * credential and then verified. Nothing here prints or returns a credential.\n */\nimport { InferenceError, LocalLlmClient } from \"./client.js\";\nimport { removeCredential, resolveCredential, saveCredential, type StoredCredential } from \"./credentials.js\";\nimport { APPLIANCE, applianceConfig, connectionOf, providerConfig, recordRecent, type ModelRef } from \"./model_catalog.js\";\nimport { openBrowser, startAuthFlow, type AuthPrompt } from \"./oauth.js\";\nimport { originOf, providerDefinition } from \"./providers.js\";\nimport type { HarnessConfig } from \"./types.js\";\nimport type { AutonomousAgent } from \"./agent.js\";\nimport { redactSecrets } from \"./ui.js\";\n\nconst describe = (err: unknown): string => {\n  if (err instanceof InferenceError) {\n    if (err.condition === \"AUTH_FAILURE\") return \"the provider rejected the credential\";\n    return redactSecrets(err.message).slice(0, 300);\n  }\n  return redactSecrets(String((err as any)?.message ?? err)).slice(0, 300);\n};\n\n/** Lists the provider's models with `apiKey` (or its sign-in); proves the credential works without sending content. */\nasync function verify(base: HarnessConfig, providerId: string, apiKey?: string): Promise<number> {\n  const cfg = providerConfig(base, providerId);\n  const models = await new LocalLlmClient(apiKey ? { ...cfg, apiKey } : cfg).listModels();\n  return models.length;\n}\n\nexport async function connectWithKey(base: HarnessConfig, providerId: string, key: string): Promise<{ ok: boolean; message: string }> {\n  const def = providerDefinition(providerId);\n  const value = key.trim();\n  if (!def || !def.methods.some((m) => m.kind === \"key\")) return { ok: false, message: `${providerId} does not take an API key.` };\n  if (!value || /\\s/.test(value)) return { ok: false, message: \"That does not look like an API key.\" };\n  try {\n    const count = await verify(base, providerId, value);\n    saveCredential(providerId, { type: \"api\", key: value, savedAt: new Date().toISOString() });\n    const shadow = def.credentialEnv && process.env[def.credentialEnv]?.trim() ? ` Note: $${def.credentialEnv} is set and takes precedence over the saved key.` : \"\";\n    return { ok: true, message: `${def.label} connected (${count} models available).${shadow}` };\n  } catch (err) {\n    return { ok: false, message: `${def.label} key not saved: ${describe(err)}.` };\n  }\n}\n\nexport interface SignIn {\n  prompt: AuthPrompt;\n  done: Promise<{ ok: boolean; message: string }>;\n  cancel(): void;\n}\n\nexport async function startSignIn(base: HarnessConfig, providerId: string, methodId: string): Promise<SignIn> {\n  const def = providerDefinition(providerId);\n  const method = def?.methods.find((m) => m.id === methodId);\n  if (!def || !method || method.kind === \"key\") throw new Error(`${providerId} has no sign-in method '${methodId}'.`);\n  const abort = new AbortController();\n  const flow = await startAuthFlow(methodId, abort.signal);\n  void openBrowser(flow.prompt.url);\n  const done = flow.result.then(\n    async (credential: StoredCredential) => {\n      saveCredential(providerId, credential);\n      try {\n        const count = await verify(base, providerId);\n        return { ok: true, message: `${def.label} connected (${count} models available).` };\n      } catch (err) {\n        return { ok: true, message: `${def.label} signed in, but listing its models failed: ${describe(err)}.` };\n      }\n    },\n    (err) => ({ ok: false, message: `${def.label} sign-in failed: ${describe(err)}` }),\n  );\n  return { prompt: flow.prompt, done, cancel: () => { abort.abort(); flow.cancel(); } };\n}\n\nexport function disconnect(providerId: string): { ok: boolean; message: string } {\n  const def = providerDefinition(providerId);\n  if (!def) return { ok: false, message: `Unknown provider '${providerId}'.` };\n  const removed = removeCredential(providerId);\n  const still = resolveCredential(providerId, def.credentialEnv);\n  if (still) {\n    return {\n      ok: removed,\n      message: `${removed ? \"Removed Nexus's saved credential. \" : \"\"}${def.label} is still connected via ${still.source}; Nexus does not change ${still.kind === \"env\" ? \"your environment\" : \"other clients' sign-ins\"}.`,\n    };\n  }\n  return { ok: removed, message: removed ? `${def.label} disconnected.` : `${def.label} had no credential saved by Nexus.` };\n}\n\n/**\n * Switches the agent to `ref` — the operator's explicit choice, which authorizes that destination for this session.\n * Returns the operator-facing outcome.\n */\nexport function selectModel(agent: AutonomousAgent, config: HarnessConfig, ref: ModelRef): { ok: boolean; message: string } {\n  const model = ref.model.trim();\n  if (!model) return { ok: false, message: \"Choose a model.\" };\n  if (ref.provider === APPLIANCE) {\n    const a = applianceConfig(config);\n    agent.setInferenceTarget({\n      provider: undefined,\n      endpoint: a.endpoint,\n      model,\n      apiKey: a.apiKey,\n      credentialOrigin: a.credentialOrigin,\n      authorizedDisclosureOrigins: [...new Set([...(config.authorizedDisclosureOrigins ?? []), ...(a.authorizedDisclosureOrigins ?? [])])],\n    });\n    recordRecent({ provider: APPLIANCE, model });\n    return { ok: true, message: `Model: ${model} on the appliance.` };\n  }\n  const def = providerDefinition(ref.provider);\n  if (!def) return { ok: false, message: `Unknown provider '${ref.provider}'.` };\n  if (!connectionOf(def.id).connected) return { ok: false, message: `${def.label} is not connected. Open /model and press ctrl+p to connect it.` };\n  let cfg: HarnessConfig;\n  try {\n    cfg = providerConfig(config, def.id, model);\n  } catch (err) {\n    return { ok: false, message: describe(err) };\n  }\n  agent.setInferenceTarget({\n    provider: def.id,\n    endpoint: cfg.endpoint,\n    model,\n    apiKey: cfg.apiKey,\n    credentialOrigin: cfg.credentialOrigin,\n    authorizedDisclosureOrigins: cfg.authorizedDisclosureOrigins,\n  });\n  recordRecent({ provider: def.id, model });\n  return { ok: true, message: `Model: ${model} via ${def.label} (${originOf(cfg.endpoint)}). Task content is sent to this provider.` };\n}\ncli/src/model_catalog.ts:162:    label: `Appliance (${originOf(appliance.endpoint)?.replace(/^https?:\\/\\//, \"\") ?? appliance.endpoint})`,\ncli/src/sidecar.ts:63:import { connectWithKey, disconnect, selectModel, startSignIn } from \"./provider_connect.js\";\ncli/src/sidecar.ts:208:      case \"provider.connect\":\ncli/src/usage.ts:2: * Inference usage ledger: one receipt per provider-connection request (main agent, planner/coder, subagents and\ncli/src/repl.ts:1398:                  const status = s.connected ? pc.green(\"CONNECTED\") : pc.red(\"DISCONNECTED\");\ncli/src/config.ts:152:/** Base URL of a provider connection: the operator's override (flag or NEXUS_<ID>_BASE_URL), else the provider default. */\ncli/src/config.ts:266:  if (provider && options.fallback) warnOnce(`--fallback is ignored for provider '${provider}': a provider connection is pinned to its own endpoint.`);\ncli/src/credentials.ts:233: * The credential a provider connection uses: its environment variable, else Nexus's store, else a connection\ncli/src/credentials.ts:236:/** The API key a provider connection uses (env, Nexus store, or another client); undefined for sign-in providers. */\ncli/src/client.ts:535:  /** Usage the provider reported for the most recent completed request on this client (provider connections only). */\ncli/src/client.ts:657:   * Checks made before a content-bearing request leaves: model and credential present (provider connections), and the\ncli/src/client.ts:675:    // Spending limits cover provider connections, whose requests are recorded; the legacy endpoint path has no receipts.\ncli/src/client.ts:694:  /** Records a receipt for an inference request (local endpoint or provider connection). */\ncli/src/client.ts:946:    // A provider connection is pinned to its own endpoint: task content never fails over elsewhere (PRV-13).\ncli/src/client.ts:969:    // A provider connection uses only its own key: never the appliance's stored token or any other credential.\ncli/src/client.ts:1130:        // Only for a plain endpoint: cloud provider connections have no such endpoints.\ncli/src/client.ts:1197:    if (this.conn.providerId || this.conn.protocol !== \"openai-chat\") throw new TokenCountError(\"unsupported\", \"provider connections have no request-counting endpoint\");\ncli/src/provider_cli.ts:14:import { connectWithKey, disconnect, startSignIn } from \"./provider_connect.js\";\ncli/src/index.ts:750:      const status = s.connected ? pc.green(\"CONNECTED\") : pc.red(\"DISCONNECTED\");\ncli/src/model_catalog.ts:162:    label: `Appliance (${originOf(appliance.endpoint)?.replace(/^https?:\\/\\//, \"\") ?? appliance.endpoint})`,\ncli/src/providers.ts:193:/** The environment variable a provider connection reads its key from (for operator-facing messages). */\ncli/src/doctor.ts:922:    return f(\"credentials.store\", \"state\", \"fail\", \"Nexus's credential store is not valid JSON; stored provider connections are unavailable.\", [file], \"Move the file aside and reconnect with `nexus connect <provider>`.\");\ncli/src/core/provider_recovery.ts:125:const CONNECT_NEVER_COMPLETED = new Set([\"ECONNREFUSED\", \"EHOSTUNREACH\", \"ENETUNREACH\", \"EAI_AGAIN\", \"UND_ERR_CONNECT_TIMEOUT\"]);\ncli/src/core/provider_recovery.ts:141:  if (chain.some((c) => c.code && CONNECT_NEVER_COMPLETED.has(c.code))) return { condition: \"TEMPORARILY_UNAVAILABLE\", execution: \"NOT_EXECUTED\" };\ncli/src/slash/session_commands.ts:4:import { selectModel } from \"../provider_connect.js\";\ncli/src/protocol.ts:157:  /** Outcome of provider.connect / provider.disconnect. */\ncli/src/protocol.ts:176:  | { type: \"provider.connect\"; id: string; provider: string; method: string; key?: string }\ncli/src/protocol.ts:259:    case \"provider.connect\": {\ncli/src/protocol.ts:260:      const requestId = requireId(\"provider.connect\");\ncli/src/protocol.ts:262:        throw new ProtocolError(\"provider.connect requires provider and method\", requestId);\ncli/src/protocol.ts:264:      if (msg.key !== undefined && typeof msg.key !== \"string\") throw new ProtocolError(\"provider.connect key must be a string\", requestId);\ncli/src/protocol.ts:265:      return { type: \"provider.connect\", id: requestId, provider: msg.provider, method: msg.method, ...(typeof msg.key === \"string\" ? { key: msg.key } : {}) };\n","exit_code":0,"duration":{"secs":0,"nanos":822660290}},"started_at_ms":1793021190637,"completed_at_ms":1793021191460}}
{"timestamp":"2026-10-26T13:26:32.458Z","ordinal":388060,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17864-290a-76e3-bf25-dcad723268d3","call_id":"call_bdd9d8219d60411bbcf4dcd91d9625f8","output":[{"type":"input_text","text":"Script completed\nWall time 2.9 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 7293)\nTotal output lines: 518\n\n/**\n * Operator surface for cloud providers: what is configured, which credentials are present (never their values),\n * where each role's requests go, and an opt-in live check that a provider/model completes a tool round trip.\n */\nimport type { Command } from \"commander\";\nimport { randomUUID } from \"node:crypto\";\nimport pc from \"picocolors\";\nimport { InferenceError, LocalLlmClient, operatorSetting } from \"./client.js\";\nimport { buildConfig } from \"./config.js\";\nimport { baseUrlSetting, disclosureClass, PROVIDERS } from \"./providers.js\";\nimport type { ChatMessage, HarnessConfig, ToolDefinition } from \"./types.js\";\nimport { UsageLedger } from \"./usage.js\";\nimport { resolveCredential } from \"./credentials.js\";\nimport { connectWithKey, disconnect, startSignIn } from \"./provider_connect.js\";\nimport { redactSecrets } from \"./ui.js\";\n\n/** One line naming each role's selected destination and its disclosure class. */\nexport function describeTarget(config: HarnessConfig): string {\n  const target = (provider: string | undefined, endpoint: string, model: string) => {\n    // Endpoint paths, userinfo, query strings and model ids are operator-controlled environment/config values.\n    // Show only the parsed origin and a model id that passes the display allowlist.\n    const origin = safeOriginOf(endpoint);\n    const label = provider ? PROVIDERS[provider]?.label ?? \"Cloud provider\" : \"Local endpoint\";\n    const where = origin ? `${label} (${origin})` : `${label} (endpoint unavailable)`;\n    return `${where} · ${model ? safeModelId(model) : \"no model\"} · ${disclosureClass(endpoint, provider, config.cloudRoutedOrigins)}`;\n  };\n  const parts = [`main: ${target(config.provider, config.endpoint, config.model)}`];\n  if (config.plannerModel) {\n    const p = config.plannerProvider ?? (config.plannerEndpoint ? undefined : config.provider);\n    parts.push(`planner: ${target(p, config.plannerEndpoint ?? config.endpoint, config.plannerModel)}`);\n  }\n  if (config.coderModel) {\n    const p = config.coderProvider ?? (config.coderEndpoint ? undefined : config.provider);\n    parts.push(`coder: ${target(p, config.coderEndpoint ?? config.endpoint, config.coderModel)}`);\n  }\n  return `[nexus] Inference — ${parts.join(\" | \")}`;\n}\n\nfunction credentialShaped(value: string): boolean {\n  return [\n    /sk-[A-Za-z0-9_-]{8,}/i,\n    /(?:gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,})/i,\n    /xox[baprs]-[A-Za-z0-9-]{10,}/i,\n    /AKIA[0-9A-Z]{16}/i,\n    /AIza[0-9A-Za-z_-]{35}/i,\n    /ya29\\.[0-9A-Za-z_-]{20,}/,\n    /eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}/i,\n  ].some((pattern) => pattern.test(value));\n}\n\n/** Keep endpoint attribution while removing credential-shaped labels from displayed hostnames. */\nfunction safeOriginOf(value: string | undefined): string | undefined {\n  if (!value?.trim()) return undefined;\n  try {\n    const url = new URL(value.trim());\n    const spansHostnameLabels = [\n      /ya29\\.[A-Za-z0-9_-]{20,}/i,\n      /eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}/i,\n    ].some((pattern) => pattern.test(url.hostname));\n    const hostname = spansHostnameLabels\n      ? \"(redacted)\"\n      : url.hostname.split(\".\").map((label) => credentialShaped(label) ? \"(redacted)\" : label).join(\".\");\n    return `${url.protocol}//${hostname}${url.port ? `:${url.port}` : \"\"}`;\n  } catch {\n    return undefined;\n  }\n}\n\nfunction safeProviderId(value: string | undefined): string | undefined {\n  return value && Object.prototype.hasOwnProperty.call(PROVIDERS, value) ? value : value ? \"(unrecognized provider)\" : undefined;\n}\n\nfunction safeConfigurationError(error: unknown): string {\n  const message = error instanceof Error ? error.message : \"\";\n  const match = /^Unknown provider '([^'\\r\\n]{1,128})' \\([A-Z0-9_]{1,64}\\)\\. Known providers: [A-Za-z0-9, ]+\\.$/.exec(message);\n  if (!match) return \"Configuration error: provider configuration is invalid\";\n  // An unknown provider name comes from user configuration; even identifier-shaped values may be secrets.\n  return `Configuration error: Unknown provider '(unrecognized provider)'. Known providers: ${Object.keys(PROVIDERS).join(\", \")}.`;\n}\n\nfunction safeModelId(value: string): string {\n  // Provider/model identifiers may contain routing punctuation, but not whitespace, controls or arbitrary diagnostics.\n  if (!/^[A-Za-z0-9._:\\/@+-]{1,160}$/.test(value)) return \"(unprintable model id)\";\n  return credentialShaped(value) ? \"(unprintable model id)\" : value;\n}\n\nfunction safeClientDiagnostic(message: string, config: HarnessConfig): string {\n  let safe = redactSecrets(message);\n  const substitute = (raw: string | undefined, replacement: string | undefined) => {\n    if (raw && replacement && raw !== replacement) safe = safe.replaceAll(raw, () => replacement);\n  };\n  if (config.model) substitute(config.model, safeModelId(config.model));\n  const safeOrigin = safeOriginOf(config.endpoint);\n  if (safeOrigin) {\n    substitute(config.endpoint.trim(), safeOrigin);\n    try {\n      const endpoint = new URL(config.endpoint.trim());\n      substitute(endpoint.href, safeOrigin);\n      substitute(`${endpoint.origin}${endpoint.pathname}${endpoint.search}${endpoint.hash}`, safeOrigin);\n      substitute(`${endpoint.origin}${endpoint.pathname}`, safeOrigin);\n      substitute(endpoint.origin, safeOrigin);\n      substitute(endpoint.hostname, new URL(safeOrigin).hostname);\n      substitute(endpoint.pathname, \"(path redacted)\");\n      substitute(endpoint.search, \"\");\n      substitute(endpoint.hash, \"\");\n    } catch {\n      // Invalid endpoints are rejected by config validation before the live check starts.\n    }\n  }\n  return safe;\n}\n\nconst SAFE_FAILURE_KINDS = new Set([\n  \"http_error\", \"network_error\", \"timeout\", \"stream_interrupted\", \"stream_incomplete\", \"provider_error_frame\",\n  \"malformed_event\", \"output_truncated\", \"protocol_error\", \"aborted\", \"policy_denied\", \"configuration_error\", \"verification_error\",\n]);\nconst SAFE_FAILURE_CONDITIONS = new Set([\n  \"TEMPORARILY_UNAVAILABLE\", \"RATE_LIMITED\", \"OVERLOADED\", \"DRAINING\", \"AUTH_FAILURE\", \"QUOTA_EXHAUSTED\",\n  \"CAPACITY_REJECTED\", \"REQUEST_REJECTED\", \"PERMANENT_FAILURE\", \"AVAILABLE\",\n]);\n\nfunction safeStepDetail(ok: boolean, detail: string): string {\n  if (!ok) return detail === \"Provider request failed\" ? detail : \"Verification failed\";\n  if (/^streamed completion received \\(\\d+ chars\\)$/.test(detail)) return detail;\n  if (/^echo_token tool call completed \\(\\d+ call\\(s\\)\\)$/.test(detail)) return detail;\n  return detail === \"tool result round trip completed\" ? detail : \"Verification succeeded\";\n}\n\n/** A credential-safe JSON projection for `providers verify --json`; raw provider diagnostics are deliberately omitted. */\nexport function verificationSummary(\n  steps: readonly VerificationStep[],\n  receipts: readonly import(\"./usage.js\").InferenceReceipt[],\n  target?: Pick<HarnessConfig, \"provider\" | \"model\">,\n) {\n  const provider = safeProviderId(target?.provider ?? receipts[0]?.providerId);\n  const model = target?.model ?? receipts[0]?.selectedModel;\n  return {\n    passed: steps.length === 3 && steps.every((step) => step.ok),\n    ...(provider ? { provider } : {}),\n    ...(model ? { model: safeModelId(model) } : {}),\n    steps: steps.map(({ step, ok, requestId, detail, failureKind, failureCondition }) => {\n      const safeKind = failureKind && SAFE_FAILURE_KINDS.has(failureKind) ? failureKind : undefined;\n      const safeCondition = failureCondition && SAFE_FAILURE_CONDITIONS.has(failureCondition) ? failureCondition : undefined;\n      return {\n        step, ok, requestId, detail: safeStepDetail(ok, detail),\n        ...(safeKind ? { failureKind: safeKind } : {}),\n        ...(safeCondition ? { condition: safeCondition } : {}),\n      };\n    }),\n    receipts: receipts.map(({ at, requestId, role, providerId, selectedModel, effectiveModel, endpointOrigin, protocol, disclosure, executions, outcome, failureKind, usage, usageConfidence, costConfidence }) => {\n      const origin = safeOriginOf(endpointOrigin)…3293 tokens truncated…age: `${def.label} key not saved: ${describe(err)}.` };\n  }\n}\n\nexport interface SignIn {\n  prompt: AuthPrompt;\n  done: Promise<{ ok: boolean; message: string }>;\n  cancel(): void;\n}\n\nexport async function startSignIn(base: HarnessConfig, providerId: string, methodId: string): Promise<SignIn> {\n  const def = providerDefinition(providerId);\n  const method = def?.methods.find((m) => m.id === methodId);\n  if (!def || !method || method.kind === \"key\") throw new Error(`${providerId} has no sign-in method '${methodId}'.`);\n  const abort = new AbortController();\n  const flow = await startAuthFlow(methodId, abort.signal);\n  void openBrowser(flow.prompt.url);\n  const done = flow.result.then(\n    async (credential: StoredCredential) => {\n      saveCredential(providerId, credential);\n      try {\n        const count = await verify(base, providerId);\n        return { ok: true, message: `${def.label} connected (${count} models available).` };\n      } catch (err) {\n        return { ok: true, message: `${def.label} signed in, but listing its models failed: ${describe(err)}.` };\n      }\n    },\n    (err) => ({ ok: false, message: `${def.label} sign-in failed: ${describe(err)}` }),\n  );\n  return { prompt: flow.prompt, done, cancel: () => { abort.abort(); flow.cancel(); } };\n}\n\nexport function disconnect(providerId: string): { ok: boolean; message: string } {\n  const def = providerDefinition(providerId);\n  if (!def) return { ok: false, message: `Unknown provider '${providerId}'.` };\n  const removed = removeCredential(providerId);\n  const still = resolveCredential(providerId, def.credentialEnv);\n  if (still) {\n    return {\n      ok: removed,\n      message: `${removed ? \"Removed Nexus's saved credential. \" : \"\"}${def.label} is still connected via ${still.source}; Nexus does not change ${still.kind === \"env\" ? \"your environment\" : \"other clients' sign-ins\"}.`,\n    };\n  }\n  return { ok: removed, message: removed ? `${def.label} disconnected.` : `${def.label} had no credential saved by Nexus.` };\n}\n\n/**\n * Switches the agent to `ref` — the operator's explicit choice, which authorizes that destination for this session.\n * Returns the operator-facing outcome.\n */\nexport function selectModel(agent: AutonomousAgent, config: HarnessConfig, ref: ModelRef): { ok: boolean; message: string } {\n  const model = ref.model.trim();\n  if (!model) return { ok: false, message: \"Choose a model.\" };\n  if (ref.provider === APPLIANCE) {\n    const a = applianceConfig(config);\n    agent.setInferenceTarget({\n      provider: undefined,\n      endpoint: a.endpoint,\n      model,\n      apiKey: a.apiKey,\n      credentialOrigin: a.credentialOrigin,\n      authorizedDisclosureOrigins: [...new Set([...(config.authorizedDisclosureOrigins ?? []), ...(a.authorizedDisclosureOrigins ?? [])])],\n    });\n    recordRecent({ provider: APPLIANCE, model });\n    return { ok: true, message: `Model: ${model} on the appliance.` };\n  }\n  const def = providerDefinition(ref.provider);\n  if (!def) return { ok: false, message: `Unknown provider '${ref.provider}'.` };\n  if (!connectionOf(def.id).connected) return { ok: false, message: `${def.label} is not connected. Open /model and press ctrl+p to connect it.` };\n  let cfg: HarnessConfig;\n  try {\n    cfg = providerConfig(config, def.id, model);\n  } catch (err) {\n    return { ok: false, message: describe(err) };\n  }\n  agent.setInferenceTarget({\n    provider: def.id,\n    endpoint: cfg.endpoint,\n    model,\n    apiKey: cfg.apiKey,\n    credentialOrigin: cfg.credentialOrigin,\n    authorizedDisclosureOrigins: cfg.authorizedDisclosureOrigins,\n  });\n  recordRecent({ provider: def.id, model });\n  return { ok: true, message: `Model: ${model} via ${def.label} (${originOf(cfg.endpoint)}). Task content is sent to this provider.` };\n}\ncli/src/model_catalog.ts:162:    label: `Appliance (${originOf(appliance.endpoint)?.replace(/^https?:\\/\\//, \"\") ?? appliance.endpoint})`,\ncli/src/sidecar.ts:63:import { connectWithKey, disconnect, selectModel, startSignIn } from \"./provider_connect.js\";\ncli/src/sidecar.ts:208:      case \"provider.connect\":\ncli/src/usage.ts:2: * Inference usage ledger: one receipt per provider-connection request (main agent, planner/coder, subagents and\ncli/src/repl.ts:1398:                  const status = s.connected ? pc.green(\"CONNECTED\") : pc.red(\"DISCONNECTED\");\ncli/src/config.ts:152:/** Base URL of a provider connection: the operator's override (flag or NEXUS_<ID>_BASE_URL), else the provider default. */\ncli/src/config.ts:266:  if (provider && options.fallback) warnOnce(`--fallback is ignored for provider '${provider}': a provider connection is pinned to its own endpoint.`);\ncli/src/credentials.ts:233: * The credential a provider connection uses: its environment variable, else Nexus's store, else a connection\ncli/src/credentials.ts:236:/** The API key a provider connection uses (env, Nexus store, or another client); undefined for sign-in providers. */\ncli/src/client.ts:535:  /** Usage the provider reported for the most recent completed request on this client (provider connections only). */\ncli/src/client.ts:657:   * Checks made before a content-bearing request leaves: model