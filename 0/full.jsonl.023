:    this.changeBaseline = this.hasPendingModifications ? null : undefined;\n2146:    this.verificationBaselineInvalidated = this.hasPendingModifications;\n2147:    if (this.hasPendingModifications) this.verificationEvidence = undefined;\n3857:        (this.hasPendingModifications || worktreeHasChanges || this.configuredVerifierGatesCompletion()) &&\n4841:          const changePending = this.modifiedFiles.size > 0 || this.hasPendingModifications;\n5061:        tests: this.hasPendingModifications ? null : snapshotTests(this.config.workspace),\n5062:        verifier: this.hasPendingModifications ? null : snapshotVerifierDefinition(this.config.workspace, authoritativeVerifier, this.config.trustedDeliverableFiles ?? []),\n5091:    this.turnCarriedChanges = this.hasPendingModifications;\n6001:      unverifiedChangesPending: this.hasPendingModifications,\n6060:    if (this.hasPendingModifications) {\n          success: true,\n          output: subResult.summary,\n        };\n      } catch (subErr: any) {\n        this.ui.stopSpinner(false);\n        return {\n          success: false,\n          output: \"\",\n          error: `Subagent failed with error: ${subErr.message}`,\n        };\n      } finally {\n        if (subagent) {\n          const subStats = subagent.getTokenStats();\n          this.totalTokens.prompt += subStats.prompt;\n          this.totalTokens.completion += subStats.completion;\n          this.totalTokens.total += subStats.total;\n          this.totalTokens.requests += subStats.requests;\n          this.totalTokens.reportedRequests += subStats.reportedRequests;\n          this.totalTokens.estimatedRequests += subStats.estimatedRequests;\n\n          // The child's workspace changes are this turn's changes: the parent's own completion must verify them.\n          const childMutations = subagent.turnMutations;\n          if (childMutations > 0 || subagent.turnCarriedChanges) {\n            this.mutationSeq += subagent.mutationSeq;\n            this.turn