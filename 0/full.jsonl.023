{"timestamp":"2026-10-26T14:14:15.530Z","ordinal":389535,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17885-133d-7581-bd2d-36a0306191af","item":{"type":"CommandExecution","id":"exec-8a69c8aa-95cd-4468-a98e-4fcd793e0c0f","process_id":"30893","command":["/usr/bin/zsh","-lc","git status --short --branch; git rev-parse HEAD; git rev-parse HEAD^; git ls-remote origin refs/heads/v1/local-endpoint-connect; git diff --check HEAD^ HEAD; git diff --stat HEAD^ HEAD; git show --format= --no-ext-diff HEAD -- cli/src/credentials.ts cli/test/provider_connect.test.ts"],"cwd":"file:///home/mike/nexus-wt/local-endpoint-connect","parsed_cmd":[{"type":"unknown","cmd":"git status --short --branch; git rev-parse HEAD; git rev-parse HEAD^; git ls-remote origin refs/heads/v1/local-endpoint-connect; git diff --check HEAD^ HEAD; git diff --stat HEAD^ HEAD; git show --format= --no-ext-diff HEAD -- cli/src/credentials.ts cli/test/provider_connect.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"## v1/local-endpoint-connect...origin/v1/local-endpoint-connect [ahead 1]\n1198d773ddb8c27fd27e8b6cdc0a3084edb53016\n85f9c5afbdbfc32b4198bd31f9bee9454deca42a\n85f9c5afbdbfc32b4198bd31f9bee9454deca42a\trefs/heads/v1/local-endpoint-connect\n cli/src/credentials.ts            | 13 ++++++++++-\n cli/test/provider_connect.test.ts | 48 +++++++++++++++++++++++++++++++++++++++\n 2 files changed, 60 insertions(+), 1 deletion(-)\ndiff --git a/cli/src/credentials.ts b/cli/src/credentials.ts\nindex c6c9cb8..9d29564 100644\n--- a/cli/src/credentials.ts\n+++ b/cli/src/credentials.ts\n@@ -73,8 +73,19 @@ export function commitLocalEndpointSetup(endpoint: string, key: string, commitSe\n   if (!id || !value || /[\\r\\n]/.test(value)) return false;\n \n   const file = credentialsPath();\n+  let previous: StoredCredential | undefined;\n+  try {\n+    const stat = fs.lstatSync(file);\n+    if (stat.isSymbolicLink() || !stat.isFile()) throw new Error(\"The Nexus credential store is not a regular file.\");\n+    const parsed = JSON.parse(fs.readFileSync(file, \"utf8\"));\n+    if (!parsed || typeof parsed !== \"object\" || !parsed.providers || typeof parsed.providers !== \"object\" || Array.isArray(parsed.providers)) {\n+      throw new Error(\"The Nexus credential store has an unsupported format.\");\n+    }\n+    previous = parsed.providers[id];\n+  } catch (error: any) {\n+    if (error?.code !== \"ENOENT\") throw new Error(\"Nexus could not safely update its credential store.\");\n+  }\n   const hadStore = fs.existsSync(file);\n-  const previous = readStore().providers[id];\n   try {\n     saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n     commitSettings();\ndiff --git a/cli/test/provider_connect.test.ts b/cli/test/provider_connect.test.ts\nindex bf4da6a..21c75fa 100644\n--- a/cli/test/provider_connect.test.ts\n+++ b/cli/test/provider_connect.test.ts\n@@ -571,6 +571,54 @@ describe(\"connecting from the picker\", () => {\n     }\n   });\n \n+  test(\"sidecar: malformed credential store is preserved when local selection cannot persist\", async () => {\n+    const local = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-secret\" ? 200 : 401, { data: [{ id: \"pending-model\" }] }));\n+    const repo = makeRepo();\n+    const configDir = path.join(home, \".config/nexus\");\n+    fs.mkdirSync(configDir, { recursive: true });\n+    const configTarget = path.join(home, \"previous-config.env\");\n+    const previousConfig = 'LOCAL_LLM_ENDPOINT=\"http://127.0.0.1:9/v1\"\\nLOCAL_LLM_MODEL=\"previous-model\"\\n';\n+    fs.writeFileSync(configTarget, previousConfig, { mode: 0o600 });\n+    const configFile = path.join(configDir, \"config.env\");\n+    fs.symlinkSync(configTarget, configFile);\n+    const malformedStore = '{\"version\":1,\"providers\": [malformed';\n+    fs.writeFileSync(credentialsPath(), malformedStore, { mode: 0o640 });\n+    fs.chmodSync(credentialsPath(), 0o640);\n+    const credentialMode = fs.statSync(credentialsPath()).mode & 0o777;\n+    const app = new ApplicationCore({ endpoint: \"http://127.0.0.1:9/v1\", model: \"previous-model\", maxSteps: 3, temperature: 0, workspace: repo, shell: \"bash\" } as any);\n+    const lines: string[] = [];\n+    const server = new SidecarServer({ app, mode: \"auto\", write: (line) => lines.push(line) });\n+    server.start();\n+    const events = () => lines.map((line) => JSON.parse(line));\n+    const send = (message: Record<string, unknown>) => server.handleLine(JSON.stringify({ v: 1, ...message }));\n+    const waitFor = async (predicate: (event: any) => boolean) => {\n+      for (let i = 0; i < 200; i++) {\n+        const found = events().find(predicate);\n+        if (found) return found;\n+        await new Promise((resolve) => setTimeout(resolve, 25));\n+      }\n+      assert.fail(\"event not seen\");\n+    };\n+    try {\n+      await send({ type: \"provider.connect\", id: \"malformed-connect\", provider: \"appliance\", method: \"local-endpoint\", endpoint: `${local.url}/v1`, key: \"pending-secret\" });\n+      assert.equal((await waitFor((event) => event.type === \"provider.result\" && event.id === \"malformed-connect\")).success, true);\n+      await send({ type: \"models.list\", id: \"malformed-models\" });\n+      const catalog = await waitFor((event) => event.type === \"models.catalog\" && event.id === \"malformed-models\");\n+      assert.ok(catalog.models.some((entry: any) => entry.provider === \"appliance\" && entry.id === \"pending-model\"));\n+      await send({ type: \"model.select\", id: \"malformed-select\", provider: \"appliance\", model: \"pending-model\" });\n+      const selected = await waitFor((event) => event.type === \"model.result\" && event.id === \"malformed-select\");\n+      assert.equal(selected.success, false, \"the credential store must fail closed before either file is changed\");\n+      assert.equal(fs.readFileSync(credentialsPath(), \"utf8\"), malformedStore);\n+      assert.equal(fs.statSync(credentialsPath()).mode & 0o777, credentialMode);\n+      assert.equal(fs.readlinkSync(configFile), configTarget);\n+      assert.equal(fs.readFileSync(configTarget, \"utf8\"), previousConfig);\n+      assert.equal(localEndpointCredential(`${local.url}/v1`), undefined);\n+    } finally {\n+      await server.shutdown();\n+      await local.close();\n+    }\n+  });\n+\n   test(\"sidecar: cancelling provisional local setup preserves prior selection and does not store its key\", async () => {\n     const oldEndpoint = await mock((_s, res) => json(res, 200, { data: [{ id: \"old-model\" }] }));\n     const local = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-secret\" ? 200 : 401, { data: [{ id: \"pending-model\" }] }));\n","exit_code":0,"duration":{"secs":1,"nanos":274439940}},"started_at_ms":1793024054255,"completed_at_ms":1793024055530}}
{"timestamp":"2026-10-26T14:14:16.566Z","ordinal":389536,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1788f-dcf6-7bc3-8663-f08b3455fcad","call_id":"call_bf3f3ecc50074ab8b1be5c8c7e701475","output":[{"type":"input_text","text":"Script completed\nWall time 3.4 seconds\nOutput:\n"},{"type":"input_text","text":"## v1/local-endpoint-connect...origin/v1/local-endpoint-connect [ahead 1]\n1198d773ddb8c27fd27e8b6cdc0a3084edb53016\n85f9c5afbdbfc32b4198bd31f9bee9454deca42a\n85f9c5afbdbfc32b4198bd31f9bee9454deca42a\trefs/heads/v1/local-endpoint-connect\n cli/src/credentials.ts            | 13 ++++++++++-\n cli/test/provider_connect.test.ts | 48 +++++++++++++++++++++++++++++++++++++++\n 2 files changed, 60 insertions(+), 1 deletion(-)\ndiff --git a/cli/src/credentials.ts b/cli/src/credentials.ts\nindex c6c9cb8..9d29564 100644\n--- a/cli/src/credentials.ts\n+++ b/cli/src/credentials.ts\n@@ -73,8 +73,19 @@ export function commitLocalEndpointSetup(endpoint: string, key: string, commitSe\n   if (!id || !value || /[\\r\\n]/.test(value)) return false;\n \n   const file = credentialsPath();\n+  let previous: StoredCredential | undefined;\n+  try {\n+    const stat = fs.lstatSync(file);\n+    if (stat.isSymbolicLink() || !stat.isFile()) throw new Error(\"The Nexus credential store is not a regular file.\");\n+    const parsed = JSON.parse(fs.readFileSync(file, \"utf8\"));\n+    if (!parsed || typeof parsed !== \"object\" || !parsed.providers || typeof parsed.providers !== \"object\" || Array.isArray(parsed.providers)) {\n+      throw new Error(\"The Nexus credential store has an unsupported format.\");\n+    }\n+    previous = parsed.providers[id];\n+  } catch (error: any) {\n+    if (error?.code !== \"ENOENT\") throw new Error(\"Nexus could not safely update its credential store.\");\n+  }\n   const hadStore = fs.existsSync(file);\n-  const previous = readStore().providers[id];\n   try {\n     saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n     commitSettings();\ndiff --git a/cli/test/provider_connect.test.ts b/cli/test/provider_connect.test.ts\nindex bf4da6a..21c75fa 100644\n--- a/cli/test/provider_connect.test.ts\n+++ b/cli/test/provider_connect.test.ts\n@@ -571,6 +571,54 @@ describe(\"connecting from the picker\", () => {\n     }\n   });\n \n+  test(\"sidecar: malformed credential store is preserved when local selection cannot persist\", async () => {\n+    const local = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-secret\" ? 200 : 401, { data: [{ id: \"pending-model\" }] }));\n+    const repo = makeRepo();\n+    const configDir = path.join(home, \".config/nexus\");\n+    fs.mkdirSync(configDir, { recursive: true });\n+    const configTarget = path.join(home, \"previous-config.env\");\n+    const previousConfig = 'LOCAL_LLM_ENDPOINT=\"http://127.0.0.1:9/v1\"\\nLOCAL_LLM_MODEL=\"previous-model\"\\n';\n+    fs.writeFileSync(configTarget, previousConfig, { mode: 0o600 });\n+    const configFile = path.join(configDir, \"config.env\");\n+    fs.symlinkSync(configTarget, configFile);\n+    const malformedStore = '{\"version\":1,\"providers\": [malformed';\n+    fs.writeFileSync(credentialsPath(), malformedStore, { mode: 0o640 });\n+    fs.chmodSync(credentialsPath(), 0o640);\n+    const credentialMode = fs.statSync(credentialsPath()).mode & 0o777;\n+    const app = new ApplicationCore({ endpoint: \"http://127.0.0.1:9/v1\", model: \"previous-model\", maxSteps: 3, temperature: 0, workspace: repo, shell: \"bash\" } as any);\n+    const lines: string[] = [];\n+    const server = new SidecarServer({ app, mode: \"auto\", write: (line) => lines.push(line) });\n+    server.start();\n+    const events = () => lines.map((line) => JSON.parse(line));\n+    const send = (message: Record<string, unknown>) => server.handleLine(JSON.stringify({ v: 1, ...message }));\n+    const waitFor = async (predicate: (event: any) => boolean) => {\n+      for (let i = 0; i < 200; i++) {\n+        const found = events().find(predicate);\n+        if (found) return found;\n+        await new Promise((resolve) => setTimeout(resolve, 25));\n+      }\n+      assert.fail(\"event not seen\");\n+    };\n+    try {\n+      await send({ type: \"provider.connect\", id: \"malformed-connect\", provider: \"appliance\", method: \"local-endpoint\", endpoint: `${local.url}/v1`, key: \"pending-secret\" });\n+      assert.equal((await waitFor((event) => event.type === \"provider.result\" && event.id === \"malformed-connect\")).success, true);\n+      await send({ type: \"models.list\", id: \"malformed-models\" });\n+      const catalog = await waitFor((event) => event.type === \"models.catalog\" && event.id === \"malformed-models\");\n+      assert.ok(catalog.models.some((entry: any) => entry.provider === \"appliance\" && entry.id === \"pending-model\"));\n+      await send({ type: \"model.select\", id: \"malformed-select\", provider: \"appliance\", model: \"pending-model\" });\n+      const selected = await waitFor((event) => event.type === \"model.result\" && event.id === \"malformed-select\");\n+      assert.equal(selected.success, false, \"the credential store must fail closed before either file is changed\");\n+      assert.equal(fs.readFileSync(credentialsPath(), \"utf8\"), malformedStore);\n+      assert.equal(fs.statSync(credentialsPath()).mode & 0o777, credentialMode);\n+      assert.equal(fs.readlinkSync(configFile), configTarget);\n+      assert.equal(fs.readFileSync(configTarget, \"utf8\"), previousConfig);\n+      assert.equal(localEndpointCredential(`${local.url}/v1`), undefined);\n+    } finally {\n+      await server.shutdown();\n+      await local.close();\n+    }\n+  });\n+\n   test(\"sidecar: cancelling provisional local setup preserves prior selection and does not store its key\", async () => {\n     const oldEndpoint = await mock((_s, res) => json(res, 200, { data: [{ id: \"old-model\" }] }));\n     const local = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-secret\" ? 200 : 401, { data: [{ id: \"pending-model\" }] }));\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17885-133d-7581-bd2d-36a0306191af","create_time":1793024056.5660002}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
