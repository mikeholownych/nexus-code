 string | undefined {\n+  if (!applianceEndpointOverride?.apiKey) return undefined;\n+  return originOf(applianceEndpointOverride.endpoint) === originOf(endpoint) ? applianceEndpointOverride.apiKey : undefined;\n }\n \n /** Test isolation for session-scoped endpoint changes. */\n@@ -289,11 +300,12 @@ export function buildConfig(options: any): HarnessConfig {\n   // A cloud model is named explicitly; the appliance's LOCAL_LLM_MODEL never selects a billable cloud model.\n   const model = provider ? options.model || operatorSetting(\"NEXUS_MODEL\") || \"\" : options.model || (options.appliance ? applianceEndpointOverride?.model : undefined) || effectiveSetting(\"LOCAL_LLM_MODEL\") || \"local-model\";\n   // Stored gateway credentials are not baked in here: the client attaches them only to the gateway they belong to.\n+  const provisionalKey = options.appliance ? pendingApplianceEndpointKey(endpoint) : undefined;\n   const operatorKey = operatorSetting(\"LOCAL_LLM_API_KEY\");\n   const projectApiKey = REDACTED;\n   const envCredential = options.apiKey || provider ? undefined : environmentCredential(options.endpoint || DEFAULT_ENDPOINT);\n-  const apiKey = options.apiKey || (provider ? providerKey(provider) : operatorKey || projectApiKey || envCredential?.apiKey) || \"local\";\n-  const credentialOrigin = apiKey === \"local\" ? undefined : options.apiKey || provider ? credentialOriginOf(endpoint) : (operatorKey ? envCredential?.origin : (projectApiKey ? credentialOriginOf(endpoint) : envCredential?.origin));\n+  const apiKey = options.apiKey || (provider ? providerKey(provider) : provisionalKey || operatorKey || projectApiKey || envCredential?.apiKey) || \"local\";\n+  const credentialOrigin = apiKey === \"local\" ? undefined : options.apiKey || provider || provisionalKey ? credentialOriginOf(endpoint) : (operatorKey ? envCredential?.origin : (projectApiKey ? credentialOriginOf(endpoint) : envCredential?.origin));\n   const workspace = options.workspace ? path.resolve(options.workspace) : process.cwd();\n   const maxSteps = options.maxSteps ? parseInt(options.maxSteps, 10) : 30;\n   const continuation = continuationBudget(options);\ndiff --git a/cli/src/provider_connect.ts b/cli/src/provider_connect.ts\nindex 032f3d0..57a9723 100644\n--- a/cli/src/provider_connect.ts\n+++ b/cli/src/provider_connect.ts\n@@ -8,7 +8,7 @@ import { removeCredential, resolveCredential, saveCredential, saveLocalEndpointC\n import { APPLIANCE, applianceConfig, connectionOf, providerConfig, recordRecent, type ModelRef } from \"./model_catalog.js\";\n import { openBrowser, startAuthFlow, type AuthPrompt } from \"./oauth.js\";\n import { originOf, providerDefinition } from \"./providers.js\";\n-import { activateApplianceEndpoint, applianceEndpointSelection, saveLocalEndpointSettings } from \"./config.js\";\n+import { activateApplianceEndpoint, applianceEndpointSelection, pendingApplianceEndpointKey, resetApplianceEndpointOverride, saveLocalEndpointSettings } from \"./config.js\";\n import type { HarnessConfig } from \"./types.js\";\n import type { AutonomousAgent } from \"./agent.js\";\n import { redactSecrets } from \"./ui.js\";\n@@ -54,6 +54,11 @@ export interface LocalEndpointPreparation {\n   message: string;\n }\n \n+/** Cancel an uncommitted local setup after the operator closes its model picker. */\n+export function cancelLocalEndpointSetup(): void {\n+  resetApplianceEndpointOverride();\n+}\n+\n function validatedEndpoint(input: string): { endpoint: string; origin: string } | undefined {\n   const endpoint = input.trim().replace(/\\/+$/, \"\");\n   try {\n@@ -83,7 +88,7 @@ function validatedKey(input: string): string | undefined {\n   return /[\\r\\n\\0]/.test(key) || (key && /\\s/.test(key)) ? undefined : key;\n }\n \n-/** Verify a local endpoint, persist its endpoint and optional key, and make it available to the live model picker. */\n+/** Verify a local endpoint and keep its endpoint and optional key provisional for the live model picker. */\n export async function prepareLocalEndpoint(base: HarnessConfig, endpointInput: string, keyInput = \"\"): Promise<LocalEndpointPreparation> {\n   const parsed = validatedEndpoint(endpointInput);\n   if (!parsed) return { ok: false, message: \"Use an http:// or https:// endpoint without embedded credentials, query, or fragment.\" };\n@@ -93,12 +98,8 @@ export async function prepareLocalEndpoint(base: HarnessConfig, endpointInput: s\n     const models = await new LocalLlmClient(localEndpointConfig(base, parsed.endpoint, parsed.origin, key)).listModels();\n     const available = models.filter((model) => /^[A-Za-z0-9._:/@+-]{1,160}$/.test(model));\n     if (available.length === 0) return { ok: false, message: \"That endpoint returned no usable chat models.\" };\n-    saveLocalEndpointSettings(parsed.endpoint);\n-    if (key && !saveLocalEndpointCredential(parsed.origin, key)) {\n-      return { ok: false, message: \"The endpoint was verified, but Nexus could not securely save the API key.\" };\n-    }\n-    activateApplianceEndpoint(parsed.endpoint, undefined, true);\n-    return { ok: true, message: `Local endpoint ready (${parsed.origin}; ${available.length} models found). Choose a model to finish setup.` };\n+    activateApplianceEndpoint(parsed.endpoint, undefined, true, key || undefined);\n+    return { ok: true, message: `Local endpoint verified (${parsed.origin}; ${available.length} models found). Choose a model to save setup.` };\n   } catch {\n     return { ok: false, message: \"Could not list models from that endpoint. Check the URL and API key, then try again.\" };\n   }\n@@ -206,6 +207,10 @@ export function selectModel(agent: AutonomousAgent, config: HarnessConfig, ref:\n     const pendingSelection = applianceEndpointSelection();\n     if (pendingSelection?.persistModelOnSelection && originOf(a.endpoint) === originOf(pendingSelection.endpoint)) {\n       try {\n+        const pendingKey = pendingApplianceEndpointKey(a.endpoint);\n+        if (pendingKey && !saveLocalEndpointCredential(a.endpoint, pendingKey)) {\n+          return { ok: false, message: \"The endpoint was verified, but Nexus could not securely save the API key.\" };\n+        }\n         saveLocalEndpointSettings(a.endpoint, model);\n         activateApplianceEndpoint(a.endpoint, model, false);\n       } catch {\ndiff --git a/cli/src/sidecar.ts b/cli/src/sidecar.ts\nindex fb00a95..8a1b55c 100644\n--- a/cli/src/sidecar.ts\n+++ b/cli/src/sidecar.ts\n@@ -60,7 +60,7 @@ import {\n import { SlashHost, SlashOutcome, SlashSpec, errorText, findSlash, slashCatalog } from \"./slash/catalog.js\";\n import { routeSlash } from \"./slash/router.js\";\n import { buildCatalog } from \"./model_catalog.js\";\n-import { connectWithKey, disconnect, prepareLocalEndpoint, selectModel, startSignIn } from \"./provider_connect.js\";\n+import { cancelLocalEndpointSetup, connectWithKey, disconnect, prepareLocalEndpoint, selectModel, startSignIn } from \"./provider_connect.js\";\n \n export interface SidecarOptions {\n   app: ApplicationCore;\n@@ -214,6 +214,8 @@ export class SidecarServer {\n         return;\n       case \"provider.cancel\":\n         this.signIns.get(command.id)?.cancel();\n+        this.signIns.delete(command.id);\n+        cancelLocalEndpointSetup();\n         return;\n       case \"provider.disconnect\": {\n         if (this.app.getAgent().getApprovalMode() === \"read-only\") {\n@@ -246,6 +248,7 @@ export class SidecarServer {\n   private modelSelect(id: string, provider: string, model: string): void {\n     if (this.rejectBusy(id)) return;\n     const r = selectModel(this.app.getAgent(), this.app.getConfig(), { provider, model });\n+    if (!r.ok && provider === \"appliance\") cancelLocalEndpointSetup();\n     this.emit({ type: \"model.result\", id, success: r.ok, message: r.message });\n     if (r.ok) this.emitSessionState();\n   }\ndiff --git a/cli/test/provider_connect.test.ts b/cli/test/provider_connect.test.ts\nindex be74fc6..ee545df 100644\n--- a/cli/test/provider_connect.test.ts\n+++ b/cli/test/provider_connect.test.ts\n@@ -12,11 +12,11 @@ import path from \"node:path\";\n import { createHash } from \"node:crypto\";\n import type { AddressInfo } from \"node:net\";\n import { InferenceError, LocalLlmClient, mayBindCredential, setCredentialAuthority, storedCredentialFor } from \"../src/client.js\";\n-import { credentialsPath, localEndpointCredential, removeCredential, resolveCredential, saveCredential } from \"../src/credentials.js\";\n+import { credentialsPath, localEndpointCredential, removeCredential, resolveCredential, saveCredential, saveLocalEndpointCredential } from \"../src/credentials.js\";\n import { setOAuthEndpoints, startAuthFlow } from \"../src/oauth.js\";\n-import { connectLocalEndpoint, connectWithKey, disconnect } from \"../src/provider_connect.js\";\n+import { connectLocalEndpoint, connectWithKey, disconnect, prepareLocalEndpoint } from \"../src/provider_connect.js\";\n import { buildCatalog } from \"../src/model_catalog.js\";\n-import { resetApplianceEndpointOverride } from \"../src/config.js\";\n+import { buildConfig, resetApplianceEndpointOverride } from \"../src/config.js\";\n import { ApplicationCore } from \"../src/core/app.js\";\n import { SidecarServer } from \"../src/sidecar.js\";\n import { UsageLedger } from \"../src/usage.js\";\n@@ -333,6 +333,47 @@ describe(\"connecting from the picker\", () => {\n     }\n   });\n \n+  test(\"local endpoint credentials are never forwarded through redirects\", async () => {\n+    const target = await mock((_s, res) => json(res, 200, { data: [{ id: \"redirect-target-model\" }] }));\n+    const source = await mock((_s, res) => {\n+      res.writeHead(302, { location: `${target.url}/v1/models` });\n+      res.end();\n+    });\n+    try {\n+      const endpoint = `${source.url}/v1`;\n+      operator({ LOCAL_LLM_ENDPOINT: endpoint });\n+      assert.equal(saveLocalEndpointCredential(endpoint, \"redirect-secret\"), true);\n+      const client = new LocalLlmClient(cfg({ endpoint, apiKey: undefined }));\n+      await assert.rejects(client.listModels());\n+      assert.equal(source.seen.length, 1);\n+      assert.equal(source.seen[0].headers.authorization, \"Bearer redirect-secret\");\n+      assert.equal(target.seen.length, 0, \"the redirect destination must never receive the saved key\");\n+    } finally {\n+      await source.close();\n+      await target.close();\n+    }\n+  });\n+\n+  test(\"provisional local endpoint discovery authenticates in memory without persisting selection or key\", async () => {\n+    const local = await mock((s, res) => json(res, s.headers.authorization === \"Bearer provisional-secret\" ? 200 : 401, { data: [{ id: \"candidate-model\" }] }));\n+    const previous = 'LOCAL_LLM_ENDPOINT=\"http://127.0.0.1:9/v1\"\\nLOCAL_LLM_MODEL=\"previous-model\"\\n';\n+    try {\n+      fs.mkdirSync(path.join(home, \".config/nexus\"), { recursive: true });\n+      fs.writeFileSync(path.join(home, \".config/nexus/config.env\"), previous, { mode: 0o600 });\n+      const result = await prepareLocalEndpoint(cfg(), `${local.url}/v1`, \"provisional-secret\");\n+      assert.equal(result.ok, true, result.message);\n+      const pendingClient = new LocalLlmClient(buildConfig({ appliance: true }));\n+      assert.deepEqual(await pendingClient.listModels(), [\"candidate-model\"]);\n+      assert.equal(local.seen.length, 2, \"verification and picker discovery both authenticate to the selected endpoint\");\n+      assert.ok(local.seen.every((request) => request.headers.authorization === \"Bearer provisional-secret\"));\n+      assert.equal(fs.readFileSync(path.join(home, \".config/nexus/config.env\"), \"utf8\"), previous);\n+      assert.equal(fs.existsSync(credentialsPath()), false, \"the pending key is not written before model selection\");\n+    } finally {\n+      resetApplianceEndpointOverride();\n+      await local.close();\n+    }\n+  });\n+\n   test(\"a key is verified before it is saved; a rejected key is not saved and never echoed\", async () => {\n     const m = await mock((s, res) => json(res, s.headers[\"x-api-key\"] === \"sk-ant-GOOD\" ? 200 : 401, { data: [{ id: \"claude-a\" }, { id: \"claude-b\" }] }));\n     try {\n@@ -470,4 +511,52 @@ describe(\"connecting from the picker\", () => {\n       await local.close();\n     }\n   });\n+\n+  test(\"sidecar: cancelling provisional local setup preserves prior selection and does not store its key\", async () => {\n+    const oldEndpoint = await mock((_s, res) => json(res, 200, { data: [{ id: \"old-model\" }] }));\n+    const local = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-secret\" ? 200 : 401, { data: [{ id: \"pending-model\" }] }));\n+    const repo = makeRepo();\n+    operator({ LOCAL_LLM_ENDPOINT: `${oldEndpoint.url}/v1` });\n+    const configFile = path.join(home, \".config/nexus/config.env\");\n+    fs.mkdirSync(path.dirname(configFile), { recursive: true });\n+    const previous = `LOCAL_LLM_ENDPOINT=${JSON.stringify(`${oldEndpoint.url}/v1`)}\\nLOCAL_LLM_MODEL=\"old-model\"\\n`;\n+    fs.writeFileSync(configFile, previous, { mode: 0o600 });\n+    const app = new ApplicationCore({ endpoint: `${oldEndpoint.url}/v1`, model: \"old-model\", maxSteps: 3, temperature: 0, workspace: repo, shell: \"bash\" } as any);\n+    const lines: string[] = [];\n+    const server = new SidecarServer({ app, mode: \"auto\", write: (line) => lines.push(line) });\n+    server.start();\n+    const events = () => lines.map((line) => JSON.parse(line));\n+    const send = (message: Record<string, unknown>) => server.handleLine(JSON.stringify({ v: 1, ...message }));\n+    const waitFor = async (predicate: (event: any) => boolean) => {\n+      for (let i = 0; i < 200; i++) {\n+        const found = events().find(predicate);\n+        if (found) return found;\n+        await new Promise((resolve) => setTimeout(resolve, 25));\n+      }\n+      assert.fail(\"event not seen\");\n+    };\n+    try {\n+      await send({ type: \"provider.connect\", id: \"pending-connect\", provider: \"appliance\", method: \"local-endpoint\", endpoint: `${local.url}/v1`, key: \"pending-secret\" });\n+      assert.equal((await waitFor((event) => event.type === \"provider.result\" && event.id === \"pending-connect\")).success, true);\n+      await send({ type: \"models.list\", id: \"pending-models\" });\n+      const catalog = await waitFor((event) => event.type === \"models.catalog\" && event.id === \"pending-models\");\n+      assert.deepEqual(catalog.models.filter((model: any) => model.provider === \"appliance\").map((model: any) => model.id), [\"pending-model\"]);\n+      assert.ok(local.seen.every((request) => request.headers.authorization === \"Bearer pending-secret\"));\n+      assert.equal(fs.readFileSync(configFile, \"utf8\"), previous);\n+      assert.equal(fs.existsSync(credentialsPath()), false);\n+\n+      await send({ type: \"provider.cancel\", id: \"pending-models\" });\n+      await send({ type: \"models.list\", id: \"after-cancel\" });\n+      const restored = await waitFor((event) => event.type === \"models.catalog\" && event.id === \"after-cancel\");\n+      assert.deepEqual(restored.models.filter((model: any) => model.provider === \"appliance\").map((model: any) => model.id), [\"old-model\"]);\n+      assert.ok(oldEndpoint.seen.length >= 1);\n+      assert.equal(oldEndpoint.seen.at(-1)?.headers.authorization, \"Bearer not-needed\");\n+      assert.equal(fs.readFileSync(configFile, \"utf8\"), previous);\n+      assert.equal(fs.existsSync(credentialsPath()), false);\n+    } finally {\n+      await server.shutdown();\n+      await oldEndpoint.close();\n+      await local.close();\n+    }\n+  });\n });\ndiff --git a/core/src/bin/nexus_tui/live_state.rs b/core/src/bin/nexus_tui/live_state.rs\nindex 9ae9a35..f594835 100644\n--- a/core/src/bin/nexus_tui/live_state.rs\n+++ b/core/src/bin/nexus_tui/live_state.rs\n@@ -567,6 +567,11 @@ impl LiveState {\n     }\n \n     fn on_models_key(&mut self, key: KeyEvent) -> Option<Action> {\n+        let cancel_local_setup = matches!(&self.overlay, Some(Overlay::Models(picker)) if picker.cancel_local_endpoint_on_close);\n+        let cancel_id = match &self.overlay {\n+            Some(Overlay::Models(picker)) => picker.request.clone(),\n+            _ => String::new(),\n+        };\n         let Some(Overlay::Models(picker)) = &mut self.overlay else {\n             return None;\n         };\n@@ -577,7 +582,7 @@ impl LiveState {\n         match picker.on_key(key)? {\n             PickerIntent::Close => {\n                 self.overlay = None;\n-                None\n+                cancel_local_setup.then_some(Action::Send(Command::ProviderCancel { id: cancel_id }))\n             }\n             PickerIntent::Select { provider, model } => {\n                 self.overlay = None;\n@@ -673,12 +678,18 @@ impl LiveState {\n     fn on_provider_result(&mut self, id: String, provider: String, success: bool, message: String) {\n         if let Some(Overlay::Connect(flow)) = &mut self.overlay {\n             let waiting = matches!(&flow.step, Step::Waiting { request, .. } if *request == id);\n+            let local_setup = matches!(&flow.step, Step::Waiting { request, method, .. } if *request == id && method == \"local-endpoint\");\n             if waiting {\n                 if flow.on_result(&id, success, message.clone()) {\n                     self.transcript.push(Entry::Info(message));\n                     // Connected: show that provider's models.\n                     if let Some(action) = self.open_models(false, Some(provider)) {\n                         self.outbox.push(action);\n+                        if local_setup && success {\n+                            if let Some(Overlay::Models(picker)) = &mut self.overlay {\n+                                picker.cancel_local_endpoint_on_close = true;\n+                            }\n+                        }\n                     }\n                 }\n                 return;\n@@ -1672,6 +1683,11 @@ impl LiveState {\n                 self.overlay = None;\n                 return Some(Action::Send(Command::ProviderCancel { id }));\n             }\n+            Some(Overlay::Models(Picker { cancel_local_endpoint_on_close: true, request, .. })) => {\n+                let id = request.clone();\n+                self.overlay = None;\n+                return Some(Action::Send(Command::ProviderCancel { id }));\n+            }\n             Some(\n                 Overlay::Help { .. }\n                 | Overlay::Detail(_)\n@@ -4058,4 +4074,24 @@ mod tests {\n         assert!(matches!(state.take_outbox().as_slice(), [Action::Send(Command::ModelsList { .. })]));\n     }\n \n+    #[test]\n+    fn closing_local_endpoint_model_picker_cancels_uncommitted_setup() {\n+        let mut state = ready();\n+        type_text(&mut state, \"/connect\");\n+        let Some(Action::Send(Command::ModelsList { id })) = state.on_key(key(KeyCode::Enter)) else { panic!() };\n+        state.apply(catalog(&id));\n+        state.on_key(key(KeyCode::Enter)); // local appliance option\n+        state.on_paste(\"http://127.0.0.1:1234/v1\");\n+        state.on_key(key(KeyCode::Enter));\n+        state.on_paste(\"pending-secret\");\n+        let Some(Action::Send(Command::ProviderConnect { id: request, .. })) = state.on_key(key(KeyCode::Enter)) else { panic!() };\n+        state.apply(ev(&format!(r#\"{{\"v\":1,\"type\":\"provider.result\",\"id\":\"{request}\",\"provider\":\"appliance\",\"success\":true,\"message\":\"verified\"}}\"#)));\n+        let outbox = state.take_outbox();\n+        let [Action::Send(Command::ModelsList { id: catalog_request })] = outbox.as_slice() else { panic!(\"expected model discovery after verification\") };\n+        let catalog_request = catalog_request.clone();\n+        state.apply(catalog(&catalog_request));\n+        assert!(matches!(&state.overlay, Some(Overlay::Models(picker)) if picker.cancel_local_endpoint_on_close));\n+        assert_eq!(state.on_key(key(KeyCode::Esc)), Some(Action::Send(Command::ProviderCancel { id: catalog_request })));\n+    }\n+\n }\ndiff --git a/core/src/bin/nexus_tui/models.rs b/core/src/bin/nexus_tui/models.rs\nindex c2ca5b9..58ed2bd 100644\n--- a/core/src/bin/nexus_tui/models.rs\n+++ b/core/src/bin/nexus_tui/models.rs\n@@ -44,6 +44,8 @@ pub struct Picker {\n     pub pick: usize,\n     /// Show only this provider's models (after connecting it).\n     pub only: Option<String>,\n+    /// Cancel a verified but uncommitted local endpoint setup if the operator closes this picker.\n+    pub cancel_local_endpoint_on_close: bool,\n     /// Open the connect panel as soon as the catalog arrives (`/connect`).\n     pub connect_on_load: bool,\n }\n@@ -90,6 +92,7 @@ impl Picker {\n             query: String::new(),\n             pick: 0,\n             only: None,\n+            cancel_local_endpoint_on_close: false,\n             connect_on_load: false,\n         }\n     }\n@@ -657,7 +660,7 @@ mod tests {\n         assert_eq!(intent, Some(ConnectIntent::Connect { provider: \"openrouter\".into(), method: \"openrouter-oauth\".into(), key: None }));\n         c.step = Step::Waiting { request: \"p3\".into(), provider: \"openrouter\".into(), method: \"openrouter-oauth\".into(), auth: Some(AuthInfo { url: \"u\".into(), user_code: None, instructions: \"i\".into() }) };\n         assert_eq!(c.on_key(key(KeyCode::Esc)), Some(ConnectIntent::Cancel { request: \"p3\".into() }));\n-        assert!(matches!(c.step, Step::Providers { pick: 0 }));\n+        assert_eq!(c.step, Step::Providers { pick: 1 }, \"cancel returns to the selected cloud provider after the new appliance option\");\n     }\n \n     #[test]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17885-133d-7581-bd2d-36a0306191af","create_time":1793023476.4832804}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
