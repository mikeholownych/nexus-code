{"timestamp":"2026-10-26T14:10:23.140Z","ordinal":389398,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17885-133d-7581-bd2d-36a0306191af","item":{"type":"CommandExecution","id":"exec-f472f27e-4123-4501-8b51-9d6b9aab922a","process_id":"20911","command":["/usr/bin/zsh","-lc","git status --short --branch; git rev-parse HEAD; git rev-parse HEAD^; git ls-remote origin refs/heads/v1/local-endpoint-connect; git diff --check HEAD^ HEAD; git diff --stat HEAD^ HEAD; git show --format= --no-ext-diff HEAD -- cli/src/credentials.ts cli/src/provider_connect.ts cli/test/provider_connect.test.ts"],"cwd":"file:///home/mike/nexus-wt/local-endpoint-connect","parsed_cmd":[{"type":"unknown","cmd":"git status --short --branch; git rev-parse HEAD; git rev-parse HEAD^; git ls-remote origin refs/heads/v1/local-endpoint-connect; git diff --check HEAD^ HEAD; git diff --stat HEAD^ HEAD; git show --format= --no-ext-diff HEAD -- cli/src/credentials.ts cli/src/provider_connect.ts cli/test/provider_connect.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"## v1/local-endpoint-connect...origin/v1/local-endpoint-connect [ahead 1]\n85f9c5afbdbfc32b4198bd31f9bee9454deca42a\n04392899caccd728da027e44cc3c35e991a48ee6\n04392899caccd728da027e44cc3c35e991a48ee6\trefs/heads/v1/local-endpoint-connect\n cli/src/credentials.ts            | 30 ++++++++++++++++++++\n cli/src/provider_connect.ts       | 10 ++++---\n cli/test/provider_connect.test.ts | 59 +++++++++++++++++++++++++++++++++++++++\n 3 files changed, 95 insertions(+), 4 deletions(-)\ndiff --git a/cli/src/credentials.ts b/cli/src/credentials.ts\nindex 655bad4..c6c9cb8 100644\n--- a/cli/src/credentials.ts\n+++ b/cli/src/credentials.ts\n@@ -66,6 +66,36 @@ export function saveLocalEndpointCredential(endpoint: string, key: string): bool\n   return true;\n }\n \n+/** Save a verified endpoint key and its selected model as one failure-atomic setup operation. */\n+export function commitLocalEndpointSetup(endpoint: string, key: string, commitSettings: () => void): boolean {\n+  const id = localEndpointCredentialId(endpoint);\n+  const value = key.trim();\n+  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n+\n+  const file = credentialsPath();\n+  const hadStore = fs.existsSync(file);\n+  const previous = readStore().providers[id];\n+  try {\n+    saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n+    commitSettings();\n+    return true;\n+  } catch (error) {\n+    try {\n+      if (previous) {\n+        saveCredential(id, previous);\n+      } else {\n+        removeCredential(id);\n+        if (!hadStore && Object.keys(readStore().providers).length === 0) {\n+          try { fs.unlinkSync(file); } catch (unlinkError: any) { if (unlinkError?.code !== \"ENOENT\") throw unlinkError; }\n+        }\n+      }\n+    } catch (rollbackError) {\n+      throw new AggregateError([error, rollbackError], \"Local endpoint setup failed and its saved credential could not be restored.\");\n+    }\n+    throw error;\n+  }\n+}\n+\n export function localEndpointCredential(endpoint: string): { origin: string; key: string } | undefined {\n   const id = localEndpointCredentialId(endpoint);\n   if (!id) return undefined;\ndiff --git a/cli/src/provider_connect.ts b/cli/src/provider_connect.ts\nindex 57a9723..50af7fc 100644\n--- a/cli/src/provider_connect.ts\n+++ b/cli/src/provider_connect.ts\n@@ -4,7 +4,7 @@\n  * credential and then verified. Nothing here prints or returns a credential.\n  */\n import { InferenceError, LocalLlmClient } from \"./client.js\";\n-import { removeCredential, resolveCredential, saveCredential, saveLocalEndpointCredential, type StoredCredential } from \"./credentials.js\";\n+import { commitLocalEndpointSetup, removeCredential, resolveCredential, saveCredential, saveLocalEndpointCredential, type StoredCredential } from \"./credentials.js\";\n import { APPLIANCE, applianceConfig, connectionOf, providerConfig, recordRecent, type ModelRef } from \"./model_catalog.js\";\n import { openBrowser, startAuthFlow, type AuthPrompt } from \"./oauth.js\";\n import { originOf, providerDefinition } from \"./providers.js\";\n@@ -208,10 +208,12 @@ export function selectModel(agent: AutonomousAgent, config: HarnessConfig, ref:\n     if (pendingSelection?.persistModelOnSelection && originOf(a.endpoint) === originOf(pendingSelection.endpoint)) {\n       try {\n         const pendingKey = pendingApplianceEndpointKey(a.endpoint);\n-        if (pendingKey && !saveLocalEndpointCredential(a.endpoint, pendingKey)) {\n-          return { ok: false, message: \"The endpoint was verified, but Nexus could not securely save the API key.\" };\n+        if (pendingKey) {\n+          const committed = commitLocalEndpointSetup(a.endpoint, pendingKey, () => saveLocalEndpointSettings(a.endpoint, model));\n+          if (!committed) return { ok: false, message: \"The endpoint was verified, but Nexus could not securely save the API key.\" };\n+        } else {\n+          saveLocalEndpointSettings(a.endpoint, model);\n         }\n-        saveLocalEndpointSettings(a.endpoint, model);\n         activateApplianceEndpoint(a.endpoint, model, false);\n       } catch {\n         return { ok: false, message: \"The model is available for this session, but Nexus could not securely save the selection.\" };\ndiff --git a/cli/test/provider_connect.test.ts b/cli/test/provider_connect.test.ts\nindex ee545df..bf4da6a 100644\n--- a/cli/test/provider_connect.test.ts\n+++ b/cli/test/provider_connect.test.ts\n@@ -512,6 +512,65 @@ describe(\"connecting from the picker\", () => {\n     }\n   });\n \n+  test(\"sidecar: failed local settings persistence restores the exact credential state\", async () => {\n+    const noPrior = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-no-prior\" ? 200 : 401, { data: [{ id: \"model-a\" }] }));\n+    const prior = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-with-prior\" ? 200 : 401, { data: [{ id: \"model-b\" }] }));\n+    const repo = makeRepo();\n+    const configDir = path.join(home, \".config/nexus\");\n+    fs.mkdirSync(configDir, { recursive: true });\n+    const configTarget = path.join(home, \"previous-config.env\");\n+    const previousConfig = 'LOCAL_LLM_ENDPOINT=\"http://127.0.0.1:9/v1\"\\nLOCAL_LLM_MODEL=\"previous-model\"\\n';\n+    fs.writeFileSync(configTarget, previousConfig, { mode: 0o600 });\n+    const configFile = path.join(configDir, \"config.env\");\n+    fs.symlinkSync(configTarget, configFile);\n+    const app = new ApplicationCore({ endpoint: \"http://127.0.0.1:9/v1\", model: \"previous-model\", maxSteps: 3, temperature: 0, workspace: repo, shell: \"bash\" } as any);\n+    const lines: string[] = [];\n+    const server = new SidecarServer({ app, mode: \"auto\", write: (line) => lines.push(line) });\n+    server.start();\n+    const events = () => lines.map((line) => JSON.parse(line));\n+    const send = (message: Record<string, unknown>) => server.handleLine(JSON.stringify({ v: 1, ...message }));\n+    let sequence = 0;\n+    const waitFor = async (predicate: (event: any) => boolean) => {\n+      for (let i = 0; i < 200; i++) {\n+        const found = events().find(predicate);\n+        if (found) return found;\n+        await new Promise((resolve) => setTimeout(resolve, 25));\n+      }\n+      assert.fail(\"event not seen\");\n+    };\n+    const choosePendingModel = async (endpoint: string, key: string, model: string) => {\n+      const n = ++sequence;\n+      await send({ type: \"provider.connect\", id: `connect-${n}`, provider: \"appliance\", method: \"local-endpoint\", endpoint, key });\n+      assert.equal((await waitFor((event) => event.type === \"provider.result\" && event.id === `connect-${n}`)).success, true);\n+      await send({ type: \"models.list\", id: `models-${n}` });\n+      const catalog = await waitFor((event) => event.type === \"models.catalog\" && event.id === `models-${n}`);\n+      assert.ok(catalog.models.some((entry: any) => entry.provider === \"appliance\" && entry.id === model));\n+      await send({ type: \"model.select\", id: `select-${n}`, provider: \"appliance\", model });\n+      const result = await waitFor((event) => event.type === \"model.result\" && event.id === `select-${n}`);\n+      assert.equal(result.success, false, \"the config.env symlink must reject persistence\");\n+    };\n+    try {\n+      assert.equal(fs.existsSync(credentialsPath()), false);\n+      await choosePendingModel(`${noPrior.url}/v1`, \"pending-no-prior\", \"model-a\");\n+      assert.equal(fs.existsSync(credentialsPath()), false, \"a new credential store is removed after failed settings persistence\");\n+      assert.equal(localEndpointCredential(`${noPrior.url}/v1`), undefined);\n+\n+      const priorEndpoint = `${prior.url}/v1`;\n+      assert.equal(saveLocalEndpointCredential(priorEndpoint, \"pre-existing-secret\"), true);\n+      const priorStore = fs.readFileSync(credentialsPath(), \"utf8\");\n+      const priorEntry = JSON.parse(priorStore).providers[`nexus-local-endpoint:${prior.url}`];\n+      await choosePendingModel(priorEndpoint, \"pending-with-prior\", \"model-b\");\n+      assert.equal(fs.readlinkSync(configFile), configTarget);\n+      assert.equal(fs.readFileSync(configTarget, \"utf8\"), previousConfig);\n+      assert.equal(fs.readFileSync(credentialsPath(), \"utf8\"), priorStore, \"rollback preserves the pre-existing credential store byte-for-byte\");\n+      assert.deepEqual(JSON.parse(fs.readFileSync(credentialsPath(), \"utf8\")).providers[`nexus-local-endpoint:${prior.url}`], priorEntry);\n+    } finally {\n+      await server.shutdown();\n+      await noPrior.close();\n+      await prior.close();\n+    }\n+  });\n+\n   test(\"sidecar: cancelling provisional local setup preserves prior selection and does not store its key\", async () => {\n     const oldEndpoint = await mock((_s, res) => json(res, 200, { data: [{ id: \"old-model\" }] }));\n     const local = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-secret\" ? 200 : 401, { data: [{ id: \"pending-model\" }] }));\n","exit_code":0,"duration":{"secs":1,"nanos":356308263}},"started_at_ms":1793023821780,"completed_at_ms":1793023823137}}
{"timestamp":"2026-10-26T14:10:26.018Z","ordinal":389399,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1788c-5862-7a90-bd01-15dc80e9785d","call_id":"call_9abc32182ddf4b24909dda6a2ac96e70","output":[{"type":"input_text","text":"Script completed\nWall time 5.4 seconds\nOutput:\n"},{"type":"input_text","text":"## v1/local-endpoint-connect...origin/v1/local-endpoint-connect [ahead 1]\n85f9c5afbdbfc32b4198bd31f9bee9454deca42a\n04392899caccd728da027e44cc3c35e991a48ee6\n04392899caccd728da027e44cc3c35e991a48ee6\trefs/heads/v1/local-endpoint-connect\n cli/src/credentials.ts            | 30 ++++++++++++++++++++\n cli/src/provider_connect.ts       | 10 ++++---\n cli/test/provider_connect.test.ts | 59 +++++++++++++++++++++++++++++++++++++++\n 3 files changed, 95 insertions(+), 4 deletions(-)\ndiff --git a/cli/src/credentials.ts b/cli/src/credentials.ts\nindex 655bad4..c6c9cb8 100644\n--- a/cli/src/credentials.ts\n+++ b/cli/src/credentials.ts\n@@ -66,6 +66,36 @@ export function saveLocalEndpointCredential(endpoint: string, key: string): bool\n   return true;\n }\n \n+/** Save a verified endpoint key and its selected model as one failure-atomic setup operation. */\n+export function commitLocalEndpointSetup(endpoint: string, key: string, commitSettings: () => void): boolean {\n+  const id = localEndpointCredentialId(endpoint);\n+  const value = key.trim();\n+  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n+\n+  const file = credentialsPath();\n+  const hadStore = fs.existsSync(file);\n+  const previous = readStore().providers[id];\n+  try {\n+    saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n+    commitSettings();\n+    return true;\n+  } catch (error) {\n+    try {\n+      if (previous) {\n+        saveCredential(id, previous);\n+      } else {\n+        removeCredential(id);\n+        if (!hadStore && Object.keys(readStore().providers).length === 0) {\n+          try { fs.unlinkSync(file); } catch (unlinkError: any) { if (unlinkError?.code !== \"ENOENT\") throw unlinkError; }\n+        }\n+      }\n+    } catch (rollbackError) {\n+      throw new AggregateError([error, rollbackError], \"Local endpoint setup failed and its saved credential could not be restored.\");\n+    }\n+    throw error;\n+  }\n+}\n+\n export function localEndpointCredential(endpoint: string): { origin: string; key: string } | undefined {\n   const id = localEndpointCredentialId(endpoint);\n   if (!id) return undefined;\ndiff --git a/cli/src/provider_connect.ts b/cli/src/provider_connect.ts\nindex 57a9723..50af7fc 100644\n--- a/cli/src/provider_connect.ts\n+++ b/cli/src/provider_connect.ts\n@@ -4,7 +4,7 @@\n  * credential and then verified. Nothing here prints or returns a credential.\n  */\n import { InferenceError, LocalLlmClient } from \"./client.js\";\n-import { removeCredential, resolveCredential, saveCredential, saveLocalEndpointCredential, type StoredCredential } from \"./credentials.js\";\n+import { commitLocalEndpointSetup, removeCredential, resolveCredential, saveCredential, saveLocalEndpointCredential, type StoredCredential } from \"./credentials.js\";\n import { APPLIANCE, applianceConfig, connectionOf, providerConfig, recordRecent, type ModelRef } from \"./model_catalog.js\";\n import { openBrowser, startAuthFlow, type AuthPrompt } from \"./oauth.js\";\n import { originOf, providerDefinition } from \"./providers.js\";\n@@ -208,10 +208,12 @@ export function selectModel(agent: AutonomousAgent, config: HarnessConfig, ref:\n     if (pendingSelection?.persistModelOnSelection && originOf(a.endpoint) === originOf(pendingSelection.endpoint)) {\n       try {\n         const pendingKey = pendingApplianceEndpointKey(a.endpoint);\n-        if (pendingKey && !saveLocalEndpointCredential(a.endpoint, pendingKey)) {\n-          return { ok: false, message: \"The endpoint was verified, but Nexus could not securely save the API key.\" };\n+        if (pendingKey) {\n+          const committed = commitLocalEndpointSetup(a.endpoint, pendingKey, () => saveLocalEndpointSettings(a.endpoint, model));\n+          if (!committed) return { ok: false, message: \"The endpoint was verified, but Nexus could not securely save the API key.\" };\n+        } else {\n+          saveLocalEndpointSettings(a.endpoint, model);\n         }\n-        saveLocalEndpointSettings(a.endpoint, model);\n         activateApplianceEndpoint(a.endpoint, model, false);\n       } catch {\n         return { ok: false, message: \"The model is available for this session, but Nexus could not securely save the selection.\" };\ndiff --git a/cli/test/provider_connect.test.ts b/cli/test/provider_connect.test.ts\nindex ee545df..bf4da6a 100644\n--- a/cli/test/provider_connect.test.ts\n+++ b/cli/test/provider_connect.test.ts\n@@ -512,6 +512,65 @@ describe(\"connecting from the picker\", () => {\n     }\n   });\n \n+  test(\"sidecar: failed local settings persistence restores the exact credential state\", async () => {\n+    const noPrior = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-no-prior\" ? 200 : 401, { data: [{ id: \"model-a\" }] }));\n+    const prior = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-with-prior\" ? 200 : 401, { data: [{ id: \"model-b\" }] }));\n+    const repo = makeRepo();\n+    const configDir = path.join(home, \".config/nexus\");\n+    fs.mkdirSync(configDir, { recursive: true });\n+    const configTarget = path.join(home, \"previous-config.env\");\n+    const previousConfig = 'LOCAL_LLM_ENDPOINT=\"http://127.0.0.1:9/v1\"\\nLOCAL_LLM_MODEL=\"previous-model\"\\n';\n+    fs.writeFileSync(configTarget, previousConfig, { mode: 0o600 });\n+    const configFile = path.join(configDir, \"config.env\");\n+    fs.symlinkSync(configTarget, configFile);\n+    const app = new ApplicationCore({ endpoint: \"http://127.0.0.1:9/v1\", model: \"previous-model\", maxSteps: 3, temperature: 0, workspace: repo, shell: \"bash\" } as any);\n+    const lines: string[] = [];\n+    const server = new SidecarServer({ app, mode: \"auto\", write: (line) => lines.push(line) });\n+    server.start();\n+    const events = () => lines.map((line) => JSON.parse(line));\n+    const send = (message: Record<string, unknown>) => server.handleLine(JSON.stringify({ v: 1, ...message }));\n+    let sequence = 0;\n+    const waitFor = async (predicate: (event: any) => boolean) => {\n+      for (let i = 0; i < 200; i++) {\n+        const found = events().find(predicate);\n+        if (found) return found;\n+        await new Promise((resolve) => setTimeout(resolve, 25));\n+      }\n+      assert.fail(\"event not seen\");\n+    };\n+    const choosePendingModel = async (endpoint: string, key: string, model: string) => {\n+      const n = ++sequence;\n+      await send({ type: \"provider.connect\", id: `connect-${n}`, provider: \"appliance\", method: \"local-endpoint\", endpoint, key });\n+      assert.equal((await waitFor((event) => event.type === \"provider.result\" && event.id === `connect-${n}`)).success, true);\n+      await send({ type: \"models.list\", id: `models-${n}` });\n+      const catalog = await waitFor((event) => event.type === \"models.catalog\" && event.id === `models-${n}`);\n+      assert.ok(catalog.models.some((entry: any) => entry.provider === \"appliance\" && entry.id === model));\n+      await send({ type: \"model.select\", id: `select-${n}`, provider: \"appliance\", model });\n+      const result = await waitFor((event) => event.type === \"model.result\" && event.id === `select-${n}`);\n+      assert.equal(result.success, false, \"the config.env symlink must reject persistence\");\n+    };\n+    try {\n+      assert.equal(fs.existsSync(credentialsPath()), false);\n+      await choosePendingModel(`${noPrior.url}/v1`, \"pending-no-prior\", \"model-a\");\n+      assert.equal(fs.existsSync(credentialsPath()), false, \"a new credential store is removed after failed settings persistence\");\n+      assert.equal(localEndpointCredential(`${noPrior.url}/v1`), undefined);\n+\n+      const priorEndpoint = `${prior.url}/v1`;\n+      assert.equal(saveLocalEndpointCredential(priorEndpoint, \"pre-existing-secret\"), true);\n+      const priorStore = fs.readFileSync(credentialsPath(), \"utf8\");\n+      const priorEntry = JSON.parse(priorStore).providers[`nexus-local-endpoint:${prior.url}`];\n+      await choosePendingModel(priorEndpoint, \"pending-with-prior\", \"model-b\");\n+      assert.equal(fs.readlinkSync(configFile), configTarget);\n+      assert.equal(fs.readFileSync(configTarget, \"utf8\"), previousConfig);\n+      assert.equal(fs.readFileSync(credentialsPath(), \"utf8\"), priorStore, \"rollback preserves the pre-existing credential store byte-for-byte\");\n+      assert.deepEqual(JSON.parse(fs.readFileSync(credentialsPath(), \"utf8\")).providers[`nexus-local-endpoint:${prior.url}`], priorEntry);\n+    } finally {\n+      await server.shutdown();\n+      await noPrior.close();\n+      await prior.close();\n+    }\n+  });\n+\n   test(\"sidecar: cancelling provisional local setup preserves prior selection and does not store its key\", async () => {\n     const oldEndpoint = await mock((_s, res) => json(res, 200, { data: [{ id: \"old-model\" }] }));\n     const local = await mock((s, res) => json(res, s.headers.authorization === \"Bearer pending-secret\" ? 200 : 401, { data: [{ id: \"pending-model\" }] }));\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17885-133d-7581-bd2d-36a0306191af","create_time":1793023826.0188322}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
