]);\n  assert.equal((workflow.match(/go-version: '([^']+)'/g) ?? []).length, 2);\n  assert.equal((workflow.match(/go-version: '1\\.22\\.12'/g) ?? []).length, 2, \"both CI jobs install the exact approved Go version\");\n  assert.equal((workflow.match(/run: bash scripts\\/install-evaluator-toolchains\\.sh/g) ?? []).length, 2, \"both CI jobs use the same exact-version installer\");\n  assert.equal(oracleToolchainVersionProblem({\n    goVersion: \"go version go1.22.12 linux/amd64\",\n    rustcVersion: \"rustc 1.95.0 (fixture)\",\n    cargoVersion: \"cargo 1.95.0 (fixture)\",\n  }), null);\n  assert.match(oracleToolchainVersionProblem({\n    goVersion: \"go version go1.22.11 linux/amd64\",\n    rustcVersion: \"rustc 1.95.0 (fixture)\",\n    cargoVersion: \"cargo 1.95.0 (fixture)\",\n  }), /do not match policy/);\n  assert.match(oracleToolchainVersionProblem({\n    goVersion: \"go version go1.22.12 linux/amd64\",\n    rustcVersion: \"rustc 1.94.0 (fixture)\",\n    cargoVersion: \"cargo 1.95.0 (fixture)\",\n  }), /do not match policy/);\n\n  const fakeSystem = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-system-\"));\n  const fakeAlternatives = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-alternatives-\"));\n  const fakeSymlinkTarget = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-target-\"));\n  const fakeLib = path.join(fakeSystem, \"rustlib\", \"bin\");\n  fs.mkdirSync(path.join(fakeSystem, \"bin\"), { recursive: true });\n  fs.mkdirSync(fakeLib, { recursive: true });\n  const compilerCanary = \"#!/bin/sh\\nprintf '%s\\\\n' UNPINNED_COMPILER_CANARY\\n\";\n  const fakeGo = path.join(fakeSystem, \"bin\", \"go\");\n  const fakeRustc = path.join(fakeLib, \"rustc\");\n  const fakeCargo = path.join(fakeSystem, \"bin\", \"cargo-1.94.0\");\n  if (Object.keys(check).some((key) => ![\"protocol\", \"casesFile\", \"runtime\", \"argv\", \"timeoutMs\", \"totalTimeoutMs\", \"maxOutputBytes\"].includes(key))) {\n    return \"hidden black-box oracle has unsupported fields\";\n  }\n  if (typeof check.casesFile !== \"string\") return \"hidden black-box oracle casesFile is required\";\n  let casesPath;\n  try { casesPath = confinedPath(taskDir, check.casesFile); }\n  catch { return \"hidden black-box oracle casesFile is unsafe\"; }\n  if (candidateFixture) {\n    let fixturePath;\n    try { fixturePath = confinedPath(taskDir, candidateFixture); }\n    catch { return \"candidate fixture path is unsafe\"; }\n    const relative = path.relative(fixturePath, casesPath);\n    if (relative === \"\" || (!relative.startsWith(`..${path.sep}`) && relative !== \"..\" && !path.isAbsolute(relative))) {\n      return \"hidden black-box oracle casesFile must be outside the candidate fixture\";\n    }\n  }\n  try {\n    const stat = fs.statSync(casesPath);\n    if (!stat.isFile() || stat.size > MAX_ORACLE_BYTES) return \"hidden black-box oracle case file is not a bounded regular file\";\n    const rows = JSON.parse(fs.readFileSync(casesPath, \"utf8\"));\n    if (!Array.isArray(rows) || rows.length < 1 || rows.length > MAX_CASES) return \"hidden black-box oracle case count is outside the allowed range\";\n    for (const row of rows) {\n      if (!row || typeof row !== \"object\" || Array.isArray(row) || Object.keys(row).sort().join(\",\") !== \"expected,input\") {\n        return \"hidden black-box oracle cases must contain only input and expected fields\";\n      }\n      if (Buffer.byteLength(JSON.stringify(row), \"utf8\") > MAX_CASE_BYTES) return \"hidden black-box oracle case exceeds the size limit\";\n    }\n  } catch {\n    return \"hidden black-box oracle cases are unavailable or malformed\";\n  }\n  if (!Object.hasOwn(RUNTIMES, check.runtime)) return \"hidden black-box oracle runtime is not allowlisted\";\n  if (check.runtime === \"python3\") {\n    const toolchainProblem = oracleToolchainsProblem();\n    if (toolchainProblem) return toolchainProblem;\n  }\n  if (!Array.isArray(check.argv) || check.argv.length !== 1 || typeof check.argv[0] !== \"string\" || check.argv[0].includes(\"\\0\") || Buffer.byteLength(check.argv[0]) > 1024) {\n    return \"hidden black-box oracle argv must name only one candidate entrypoint\";\n  }\n  const entrypoint = check.argv[0];\n  if (path.posix.isAbsolute(entrypoint) || entrypoint.startsWith(\"-\") || entrypoint.includes(\"\\\\\") || entrypoint.split(\"/\").some((part) => !part || part === \".\" || part === \"..\")) {\n    return \"hidden black-box oracle argv must be a normalized relative candidate entrypoint\";\n  }\n  if (!Number.isSafeInteger(check.timeoutMs) || check.timeoutMs < 100 || check.timeoutMs > MAX_TIMEOUT_MS) return \"hidden black-box oracle timeout is outside the allowed range\";\n  if (!Number.isSafeInteger(check.totalTimeoutMs) || check.totalTimeoutMs < check.timeoutMs || check.totalTimeoutMs > MAX_TOTAL_TIMEOUT_MS) return \"hidden black-box oracle total timeout is outside the allowed range\";\n  if (!Number.isSafeInteger(check.maxOutputBytes) || check.maxOutputBytes < 2 || check.maxOutputBytes > MAX_OUTPUT_BYTES) return \"hidden black-box oracle output limit is outside the allowed range\";\n  return null;\n}\n\n/** Run candidate code as a black box. Only bounded summaries leave this function; raw output is discarded. */\nexport async function runBlackBoxOracle(task, workspace, check, { resources = null, protectedCorpusPaths = [] } = {}) {\n  const problem = blackBoxOracleProblem(check, task.dir, task.fixture ?? null);\n  if (problem) throw new Error(problem);\n  const casesPath = confinedPath(task.dir, check.casesFile);\n  const entrypoint = confinedPath(workspace, check.argv[0]);\n  if (!fs.statSync(entrypoint).isFile()) throw new Error(\"black-box candidate entrypoint is not a regular file\");\n  const cases = JSON.parse(fs.readFileSync(casesPath, \"utf8\"));\n  const command = RUNTIMES[check.runtime];\n  const failures = [];\n  const timeoutCases = [];\n  const outputLimitCases = [];\n  const executionFailureCases = [];\n}\n\n/** Run a fixed executable probe without exposing the host filesystem, environment, or network. */\nexport function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [], allowedRoots = [], allowedFiles = [], timeoutMs = 5000, workspaceReadOnly = false, protectedCorpusPaths = [], oracleToolchains = false, systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS }) {\n  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing executable probe\");\n  if (oracleToolchains) {\n    const problem = oracleToolchainsProblem({ systemDirectories, systemEtcDirectories });\n    if (problem) throw new Error(problem);\n  }\n  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles);\n  if (mountProblem) throw new Error(mountProblem);\n  const workspace = fs.realpathSync(cwd);\n  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n  for (const source of systemDirectories) {\n    try {\n      if (fs.statSync(source).isDirectory()) {\n        if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n        args.push(\"--ro-bind\", source, source);\n      }\n    } catch {}\n  }\n  if (oracleToolchains) {\n    for (const { root } of PINNED_ORACLE_TOOLCHAINS) {\n      const parent = path.dirname(root);\n      addOracleMountParent(args, parent);\n      args.push(\"--ro-bind\", root, root);\n    }\n  }\n  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n    try { if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source); } catch {}\n  }\n  for (const source of systemEtcDirectories) {\n    try { if (fs.statSync(source).isDirectory()) args.push(\"--ro-bind\", source, source); } catch {}\n  }\n  args.push(workspaceReadOnly ? \"--ro-bind\" : \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--tmpfs\", \"/run\", \"--symlink\", \"usr/bin\", \"/bin\");\n  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/home/eval\", \"/run\"]);\n  const addParents = (target) => {\n    let current = \"\";\n    for (const part of target.split(path.sep).filter(Boolean).slice(0, -1)) {\n      current += `/${part}`;\n      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n    }\n  };\n  for (const item of readOnlyPaths) {\n    const resolved = fs.realpathSync(item);\n    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n    addParents(resolved);\n    args.push(\"--ro-bind\", resolved, resolved);\n  }\n  const resolvedCommand = fs.realpathSync(command);\n  if (!SYSTEM_BINARIES.some((root) => resolvedCommand === root || resolvedCommand.startsWith(`${root}${path.sep}`)) && !readOnlyPaths.some((item) => fs.realpathSync(item) === resolvedCommand)) {\n    throw new Error(\"isolated executable must be included in the explicit read-only runtime paths\");\n  }\n  const bindSources = args.flatMap((arg, i) => (arg === \"--bind\" || arg === \"--ro-bind\") ? [args[i + 1]] : []);\n  const protectedOverlap = mountSourceOverlapProblem(bindSources, protectedCorpusPaths);\n  if (protectedOverlap) throw new Error(protectedOverlap);\n  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", oracleToolchains ? \"/usr/local/go/bin:/usr/local/nexus-qual/rust/bin:/usr/bin:/bin\" : \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"LANG\", \"C.UTF-8\");\n  if (oracleToolchains) {\n    args.push(\"--s