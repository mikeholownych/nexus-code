SYSTEM_ETC_FILES, \"file\"),\n   336\t    systemEtcDirectories: existing(SYSTEM_ETC_DIRS, \"directory\"),\n   337\t    toolchainDirectories: Object.values(resolveHostToolchains()).filter(Boolean),\n   338\t    runtimeSources: {\n   339\t      cwd: optional(cwd),\n   340\t      home: optional(home),\n   341\t      proxyDirectory: optional(proxyDirectory),\n   342\t      nodeRuntime: optional(nodeRuntime),\n   343\t      supervisorPath: optional(supervisorPath),\n   344\t      readOnlyPaths: readOnlyPaths.map((source) => fs.realpathSync(source)),\n   345\t    },\n   346\t  };\n   347\t}\n   348\t\n   349\tfunction pathOverlaps(left, right) {\n   350\t  return left === right || left.startsWith(`${right}${path.sep}`) || right.startsWith(`${left}${path.sep}`);\n   351\t}\n   352\t\n   353\tfunction pathVariants(source) {\n   354\t  if (typeof source !== \"string\" || !path.isAbsolute(source)) return [];\n   355\t  const lexical = path.resolve(source);\n   356\t  let current = lexical;\n   357\t  const suffix = [];\n   358\t  while (true) {\n   359\t    try {\n   360\t      const canonical = path.resolve(fs.realpathSync(current), ...suffix);\n   361\t      return [...new Set([lexical, canonical])];\n   362\t    } catch {\n   363\t      const parent = path.dirname(current);\n   364\t      if (parent === current) return [lexical];\n   365\t      suffix.unshift(path.basename(current));\n   366\t      current = parent;\n   367\t    }\n   368\t  }\n   369\t}\n   370\t\n   371\tfunction candidateMountOverlapProblem(mountSources, protectedCorpusPaths) {\n   372\t  return mountSourceOverlapProblem([\n   373\t    ...mountSources.systemDirectories,\n   374\t    ...mountSources.systemFiles,\n   375\t    ...mountSources.systemEtcDirectories,\n   376\t    ...mountSources.toolchainDirectories,\n   377\t    ...Object.values(mountSources.runtimeSources).flatMap((value) => Array.isArray(value) ? value : value === null ? [] : [value]),\n   378\t  ], protectedCorpusPaths);\n   379\t}\n   380\t\n   381\tfunction mountSourceOverlapProblem(sources, protectedCorpusPaths) {\n   382\t  if (!Array.isArray(protectedCorpusPaths)) return \"candidate sandbox protectedCorpusPaths must be an array\";\n   383\t  for (const protectedPath of protectedCorpusPaths) {\n   384\t    const protectedVariants = pathVariants(protectedPath);\n   385\t    if (!protectedVariants.length) return \"candidate sandbox protected corpus paths must be absolute\";\n   386\t    for (const source of sources) {\n   387\t      const sourceVariants = pathVariants(source);\n   388\t      if (sourceVariants.some((left) => protectedVariants.some((right) => pathOverlaps(left, right)))) {\n   389\t        return `candidate sandbox host mount overlaps protected corpus material: ${source}`;\n   390\t      }\n   391\t    }\n   392\t  }\n   393\t  return null;\n   394\t}\n   395\t\n   396\texport function sandboxAvailable() {\n   397\t  if (sandboxPreflight !== undefined) return sandboxPreflight;\n   398\t  try {\n   399\t    if (!fs.statSync(BWRAP).isFile() || (fs.statSync(BWRAP).mode & 0o111) === 0) return (sandboxPreflight = false);\n   400\t    const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--proc\", \"/proc\", \"--dev\", \"/dev\"];\n   401\t    for (const source of SYSTEM_BINARIES) {\n   402\t      try {\n   403\t        if (fs.statSync(source).isDirectory()) {\n   404\t          if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   405\t          args.push(\"--ro-bind\", source, source);\n   406\t        }\n   407\t      } catch {}\n   408\t    }\n   409\t    args.push(\"--clearenv\", \"--\", \"/usr/bin/unshare\", \"-Ur\", \"true\");\n   410\t    const result = spawnSync(BWRAP, args, { encoding: \"utf8\", timeout: 5000, env: {} });\n   411\t    // The sandbox itself must start, and nested user namespaces must be unavailable to the payload.\n   412\t    return (sandboxPreflight = result.status === 1 && !result.error);\n   413\t  } catch {\n   414\t    return (sandboxPreflight = false);\n   415\t  }\n   416\t}\n   417\t\n   418\texport function isolatedArgv({ cwd, home, command, timeoutSec = 300, readOnlySubpaths = [], hiddenSubpaths = [], protectedCorpusPaths = [] }) {\n   419\t  const workspace = fs.realpathSync(cwd);\n   420\t  const hiddenSources = hiddenSubpaths.map((relative) => confinedPath(workspace, relative));\n   421\t  const readOnlySources = readOnlySubpaths.map((relative) => confinedPath(workspace, relative));\n   422\t  const mountSources = candidateSandboxHostMountSources({ cwd: workspace, readOnlyPaths: [...readOnlySources, ...hiddenSources] });\n   423\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   424\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   425\t  const compilerExposure = scanOracleCompilerExposure(mountSources.systemDirectories, mountSources.systemEtcDirectories);\n   426\t  if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n   427\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing to execute task-controlled commands\");\n   428\t  const hiddenGuestPaths = hiddenSources.map((source) => path.posix.join(\"/workspace\", path.relative(workspace, source).split(path.sep).join(\"/\")));\n   429\t  let executionCommand = command;\n   430\t  const args = [\n   431\t    \"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\",\n   432\t    \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\",\n   433\t  ];\n   434\t  let localPrefixCreated = false;\n   435\t  for (const source of SYSTEM_BINARIES) {\n   436\t    try {\n   437\t      if (fs.statSync(source).isDirectory()) {\n   438\t        if (source === \"/usr/local/lib\") {\n   439\t          args.push(\"--dir\", \"/usr/local\");\n   440\t          localPrefixCreated = true;\n   441\t        }\n   442\t        args.push(\"--ro-bind\", source, source);\n   443\t      }\n   444\t    } catch {}\n   445\t  }\n   446\t  const { goRoot, rustRoot } = resolveHostToolchains();\n   447\t  args.push(...toolchainMountArgs({ goRoot, rustRoot }, localPrefixCreated));\n   448\t  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n   449\t    try {\n   450\t      if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source);\n   451\t    } catch {}\n   452\t  }\n   453\t  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n   454\t  args.push(...compilerExposureMaskArgs(compilerExposure));\n   455\t  args.push(\"--bind\", workspace, \"/workspace\", \"--dir\", \"/home\", \"--dir\", \"/run\");\n   456\t  if (hiddenSubpaths.length) {\n   457\t    const helperDir = path.dirname(fileURLToPath(import.meta.url));\n   458\t    args.push(\"--dir\", \"/runner\", \"--ro-bind\", path.join(helperDir, \"hide_oracle.cjs\"), \"/runner/hide_oracle.cjs\");\n   459\t    args.push(\"--ro-bind\", path.join(helperDir, \"hide_oracle.py\"), \"/runner/sitecustomize.py\");\n   460\t    args.push(\"--ro-bind\", path.join(helperDir, \"unlink_then_exec.sh\"), \"/runner/unlink_then_exec.sh\");\n   461\t  }\n   462\t  // Workspace subpaths the command may read but not change (hardened hidden tests: the oracle's own files).\n   463\t  for (const relative of hiddenSubpaths.length ? [] : readOnlySubpaths) {\n   464\t    const source = confinedPath(workspace, relative);\n   465\t    args.push(\"--ro-bind\", source, path.posix.join(\"/workspace\", path.relative(workspace, source).split(path.sep).join(\"/\")));\n   466\t  }\n   467\t  args.push(\"--symlink\", \"usr/bin\", \"/bin\");\n   468\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/local/nexus-qual/rust/bin:/usr/local/go/bin:/usr/bin:/bin\");\n   469\t  args.push(\"--setenv\", \"HOME\", home ? \"/home/eval\" : \"/tmp\");\n   470\t  args.push(\"--setenv\", \"CI\", \"1\", \"--setenv\", \"LANG\", \"C.UTF-8\");\n   530\t    if (executableFiles.includes(resolved) && !stat.isFile()) return `candidate runtime executable is not a regular file: ${resolved}`;\n   531\t    if (stat.isDirectory()) assertNoSymlinks(resolved);\n   532\t  }\n   533\t  return null;\n   534\t}\n   535\t\n   536\tfunction protectedRuntimeRootProblem(root) {\n   537\t  if (root.startsWith(`${os.homedir()}${path.sep}`) && root.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part))) return `sensitive candidate runtime root is forbidden: ${root}`;\n   538\t  if (root === \"/\" || root === \"/home\" || root === os.homedir() || FORBIDDEN_RUNTIME_ROOTS.some((item) => root === item || root.startsWith(`${item}${path.sep}`))) return `protected candidate runtime root is forbidden: ${root}`;\n   539\t  return null;\n   540\t}\n   541\t\n   542\texport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n   543\t  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n   544\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   545\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   546\t  const compilerExposure = scanOracleCompilerExposure(\n   547\t    mountSources.systemDirectories,\n   548\t    mountSources.systemEtcDirectories,\n   549\t    mountSources.runtimeSources.readOnlyPaths,\n   550\t  );\n   551\t  if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n   552\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n   553\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n   554\t  if (mountProblem) throw new Error(mountProblem);\n   555\t  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n   556\t    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n   557\t  }\n   558\t  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n   559\t  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n   560\t    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n   561\t  }\n   562\t  const workspace = mountSources.runtimeSources.cwd;\n   563\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   564\t  for (const source of mountSources.systemDirectories) {\n   565\t    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   566\t    args.push(\"--ro-bind\", source, source);\n   567\t  }\n   568\t  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\n   569\t  for (const source of mountSources.systemFiles) args.push(\"--ro-bind\", source, source);\n   570\t  for (const source of mountSources.systemEtcDirectories) args.push(\"--ro-bind\", source, source);\n   571\t  const isolatedHome = mountSources.runtimeSources.home;\n   572\t  args.push(\"--symlink\", \"usr/bin\", \"/bin\", \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--bind\", isolatedHome, \"/home/eval\", \"--tmpfs\", \"/run\");\n   573\t  args.push(\"--dir\", \"/run/eval-proxy\", \"--ro-bind\", mountSources.runtimeSources.proxyDirectory, \"/run/eval-proxy\");\n   574\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/run\", \"/run/eval-proxy\"]);\n   575\t  const addTargetParents = (target) => {\n   576\t    const parts = target.split(path.sep).filter(Boolean);\n   577\t    let current = \"\";\n   578\t    for (const part of parts.slice(0, -1)) {\n   579\t      current += `/${part}`;\n   580\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   581\t    }\n   582\t  };\n   583\t  for (const resolved of mountSources.runtimeSources.readOnlyPaths) {\n   584\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   585\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   586\t    addTargetParents(resolved);\n   587\t    args.push(\"--ro-bind\", resolved, resolved);\n   588\t  }\n   589\t  args.push(...compilerExposureMaskArgs(compilerExposure));\n   590\t  addTargetParents(\"/runner/agent_sandbox.mjs\");\n   591\t  args.push(\"--ro-bind\", nodeRuntime, \"/runner/node\");\n   592\t  args.push(\"--ro-bind\", mountSources.runtimeSources.supervisorPath, \"/runner/agent_sandbox.mjs\");\n   593\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"CI\", \"1\", \"--\");\n   594\t  args.push(\"/runner/node\", \"/runner/agent_sandbox.mjs\");\n   595\t  return { cmd: BWRAP, argv: args };\n   596\t}\n   597\t\n   598\t/** Run a fixed executable probe without exposing the host filesystem, environment, or network. */\n   599\texport function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [], allowedRoots = [], allowedFiles = [], timeoutMs = 5000, workspaceReadOnly = false, protectedCorpusPaths = [], oracleToolchains = false, systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS }) {\n   600\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing executable probe\");\n   601\t  let compilerExposure = null;\n   602\t  if (oracleToolchains) {\n   603\t    const additionalMountedPaths = readOnlyPaths.map((item) => fs.realpathSync(item));\n   604\t    compilerExposure = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths);\n   605\t    if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n   606\t    const problem = pinnedOracleToolchainsProblem();\n   607\t    if (problem) throw new Error(problem);\n   608\t  }\n   609\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles);\n   610\t  if (mountProblem) throw new Error(mountProblem);\n   611\t  const workspace = fs.realpathSync(cwd);\n   612\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   613\t  for (const source of systemDirectories) {\n   614\t    try {\n   615\t      if (fs.statSync(source).isDirectory()) {\n   616\t        if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   617\t        args.push(\"--ro-bind\", source, source);\n   618\t      }\n   619\t    } catch {}\n   620\t  }\n   621\t  if (oracleToolchains) {\n   622\t    for (const { root } of PINNED_ORACLE_TOOLCHAINS) {\n   623\t      const parent = path.dirname(root);\n   624\t      addOracleMountParent(args, parent);\n   625\t      args.push(\"--ro-bind\", root, root);\n   626\t    }\n   627\t  }\n   628\t  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n   629\t    try { if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source); } catch {}\n   630\t  }\n   631\t  for (const source of systemEtcDirectories) {\n   632\t    try { if (fs.statSync(source).isDirectory()) args.push(\"--ro-bind\", source, source); } catch {}\n   633\t  }\n   634\t  args.push(workspaceReadOnly ? \"--ro-bind\" : \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--tmpfs\", \"/run\", \"--symlink\", \"usr/bin\", \"/bin\");\n   635\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/home/eval\", \"/run\"]);\n   636\t  const addParents = (target) => {\n   637\t    let current = \"\";\n   638\t    for (const part of target.split(path.sep).filter(Boolean).slice(0, -1)) {\n   639\t      current += `/${part}`;\n   640\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   641\t    }\n   642\t  };\n   643\t  for (const item of readOnlyPaths) {\n   644\t    const resolved = fs.realpathSync(item);\n   645\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   646\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   647\t    addParents(resolved);\n   648\t    args.push(\"--ro-bind\", resolved, resolved);\n   649\t  }\n   650\t  if (compilerExposure) args.push(...compilerExposureMaskArgs(compilerExposure));\n   651\t  const resolvedCommand = fs.realpathSync(command);\n   652\t  if (!SYSTEM_BINARIES.some((root) => resolvedCommand === root || resolvedCommand.startsWith(`${root}${path.sep}`)) && !readOnlyPaths.some((item) => fs.realpathSync(item) === resolvedCommand)) {\n   653\t    throw new Error(\"isolated executable must be included in the explicit read-only runtime paths\");\n   654\t  }\n   655\t  const bindSources = args.flatMap((arg, i) => (arg === \"--bind\" || arg === \"--ro-bind\") ? [args[i + 1]] : []);\n   656\t  const protectedOverlap = mountSourceOverlapProblem(bindSources, protectedCorpusPaths);\n   657\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   658\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", oracleToolchains ? \"/usr/local/go/bin:/usr/local/nexus-qual/rust/bin:/usr/bin:/bin\" : \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"LANG\", \"C.UTF-8\");\n   659\t  if (oracleToolchains) {\n   660\t    args.push(\"--setenv\", \"GOROOT\", \"/usr/local/go\", \"--setenv\", \"GOTOOLCHAIN\", \"local\", \"--setenv\", \"GOPROXY\", \"off\", \"--setenv\", \"GOCACHE\", \"/tmp/go-cache\", \"--setenv\", \"GOMODCACHE\", \"/tmp/go-mod-cache\", \"--setenv\", \"GOPATH\", \"/tmp/go-path\", \"--setenv\", \"CARGO_HOME\", \"/tmp/cargo-home\", \"--setenv\", \"CARGO_TARGET_DIR\", \"/tmp/cargo-target\", \"--setenv\", \"CARGO_NET_OFFLINE\", \"true\", \"--setenv\", \"TMPDIR\", \"/tmp\");\n   661\t  }\n   662\t  args.push(\"--\");\n   663\t  args.push(resolvedCommand, ...argv);\n   664\t  return { cmd: BWRAP, argv: args, timeoutMs };\n   665\t}\n   666\t\n   667\tfunction addOracleMountParent(args, parent) {\n   668\t  const parts = parent.split(path.sep).filter(Boolean);\n   669\t  let current = \"\";\n   670\t  for (const part of parts) {\n   671\t    current += `/${part}`;\n   672\t    if (!args.some((value, index) => value === \"--dir\" && args[index + 1] === current)) args.push(\"--dir\", current);\n   673\t  }\n   674\t}\n   675\t\n   676\texport function runIsolatedProcess(spec, { outputLimit = 16_384, input = \"\", resources = null } = {}) {\n   677\t  if (!Number.isFinite(spec.timeoutMs) || spec.timeoutMs <= 0) throw new Error(\"isolated process spec has no timeoutMs\");\n   678\t  const { child, containment } = spawnContained(spec, resources, { cwd: \"/\", env: {}, detached: true, stdio: [\"pipe\", \"pipe\", \"pipe\"] });\n   679\t  return new Promise((resolve) => {\n   680\t    let stdout = \"\";\n   681\t    let stderr = \"\";\n   682\t    let bytes = 0;\n   683\t    let timedOut = false;\n   684\t    let overflow = false;\n   685\t    let settled = false;\n   686\t    // Contained runs are stopped through their cgroup, so the supervisor survives to prove cleanup.\n   687\t    const killGroup = (signal) => { if (containment) containment.kill(); else { try { process.kill(-child.pid, signal); } catch {} } };\n   688\t    const collect = (target, chunk) => {\n   689\t      bytes += chunk.length;\n   690\t      if (bytes > outputLimit) { overflow = true; killGroup(\"SIGKILL\"); return; }\n    35\t  }\n    36\t  try {\n    37\t    const stat = fs.statSync(casesPath);\n    38\t    if (!stat.isFile() || stat.size > MAX_ORACLE_BYTES) return \"hidden black-box oracle case file is not a bounded regular file\";\n    39\t    const rows = JSON.parse(fs.readFileSync(casesPath, \"utf8\"));\n    40\t    if (!Array.isArray(rows) || rows.length < 1 || rows.length > MAX_CASES) return \"hidden black-box oracle case count is outside the allowed range\";\n    41\t    for (const row of rows) {\n    42\t      if (!row || typeof row !== \"object\" || Array.isArray(row) || Object.keys(row).sort().join(\",\") !== \"expected,input\") {\n    43\t        return \"hidden black-box oracle cases must contain only input and expected fields\";\n    44\t      }\n    45\t      if (Buffer.byteLength(JSON.stringify(row), \"utf8\") > MAX_CASE_BYTES) return \"hidden black-box oracle case exceeds the size limit\";\n    46\t    }\n    47\t  } catch {\n    48\t    return \"hidden black-box oracle cases are unavailable or malformed\";\n    49\t  }\n    50\t  if (!Object.hasOwn(RUNTIMES, check.runtime)) return \"hidden black-box oracle runtime is not allowlisted\";\n    51\t  if (check.runtime === \"python3\") {\n    52\t    const toolchainProblem = oracleToolchainsProblem();\n    53\t    if (toolchainProblem) return toolchainProblem;\n    54\t  }\n    55\t  if (!Array.isArray(check.argv) || check.argv.length !== 1 || typeof check.argv[0] !== \"string\" || check.argv[0].includes