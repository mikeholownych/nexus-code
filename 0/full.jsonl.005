{"timestamp":"2026-10-29T06:52:34.705Z","ordinal":496717,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18669-d27e-75d2-996e-5705cd6cc03e","item":{"type":"CommandExecution","id":"exec-5daa816f-5c34-4509-ad36-ecf1050150b7","process_id":"76998","command":["/usr/bin/zsh","-lc","sed -n '390,510p' eval/isolate.mjs; sed -n '80,145p' eval/oracle.mjs; sed -n '1,145p' .github/workflows/ci.yml; sed -n '500,620p' cli/test/eval_integrity.test.ts; sed -n '45,95p' cli/test/eval_hardened.test.ts; git status --short --branch; git log -4 --oneline --decorate"],"cwd":"file:///home/mike/nexus-wt/eval-agent-toolchain-binds","parsed_cmd":[{"type":"unknown","cmd":"sed -n '390,510p' eval/isolate.mjs; sed -n '80,145p' eval/oracle.mjs; sed -n '1,145p' .github/workflows/ci.yml; sed -n '500,620p' cli/test/eval_integrity.test.ts; sed -n '45,95p' cli/test/eval_hardened.test.ts; git status --short --branch; git log -4 --oneline --decorate"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n  }\n  const workspace = mountSources.runtimeSources.cwd;\n  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n  for (const source of mountSources.systemDirectories) {\n    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n    args.push(\"--ro-bind\", source, source);\n  }\n  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\n  for (const source of mountSources.systemFiles) args.push(\"--ro-bind\", source, source);\n  for (const source of mountSources.systemEtcDirectories) args.push(\"--ro-bind\", source, source);\n  const isolatedHome = mountSources.runtimeSources.home;\n  args.push(\"--symlink\", \"usr/bin\", \"/bin\", \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--bind\", isolatedHome, \"/home/eval\", \"--tmpfs\", \"/run\");\n  args.push(\"--dir\", \"/run/eval-proxy\", \"--ro-bind\", mountSources.runtimeSources.proxyDirectory, \"/run/eval-proxy\");\n  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/run\", \"/run/eval-proxy\"]);\n  const addTargetParents = (target) => {\n    const parts = target.split(path.sep).filter(Boolean);\n    let current = \"\";\n    for (const part of parts.slice(0, -1)) {\n      current += `/${part}`;\n      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n    }\n  };\n  for (const resolved of mountSources.runtimeSources.readOnlyPaths) {\n    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n    addTargetParents(resolved);\n    args.push(\"--ro-bind\", resolved, resolved);\n  }\n  addTargetParents(\"/runner/agent_sandbox.mjs\");\n  args.push(\"--ro-bind\", nodeRuntime, \"/runner/node\");\n  args.push(\"--ro-bind\", mountSources.runtimeSources.supervisorPath, \"/runner/agent_sandbox.mjs\");\n  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"CI\", \"1\", \"--\");\n  args.push(\"/runner/node\", \"/runner/agent_sandbox.mjs\");\n  return { cmd: BWRAP, argv: args };\n}\n\n/** Run a fixed executable probe without exposing the host filesystem, environment, or network. */\nexport function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [], allowedRoots = [], allowedFiles = [], timeoutMs = 5000, workspaceReadOnly = false, protectedCorpusPaths = [], oracleToolchains = false }) {\n  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing executable probe\");\n  if (oracleToolchains) {\n    const problem = oracleToolchainsProblem();\n    if (problem) throw new Error(problem);\n  }\n  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles);\n  if (mountProblem) throw new Error(mountProblem);\n  const workspace = fs.realpathSync(cwd);\n  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n  for (const source of SYSTEM_BINARIES) {\n    try {\n      if (fs.statSync(source).isDirectory()) {\n        if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n        args.push(\"--ro-bind\", source, source);\n      }\n    } catch {}\n  }\n  if (oracleToolchains) {\n    for (const { root } of PINNED_ORACLE_TOOLCHAINS) {\n      const parent = path.dirname(root);\n      addOracleMountParent(args, parent);\n      args.push(\"--ro-bind\", root, root);\n    }\n  }\n  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n    try { if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source); } catch {}\n  }\n  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n  args.push(workspaceReadOnly ? \"--ro-bind\" : \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--tmpfs\", \"/run\", \"--symlink\", \"usr/bin\", \"/bin\");\n  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/home/eval\", \"/run\"]);\n  const addParents = (target) => {\n    let current = \"\";\n    for (const part of target.split(path.sep).filter(Boolean).slice(0, -1)) {\n      current += `/${part}`;\n      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n    }\n  };\n  for (const item of readOnlyPaths) {\n    const resolved = fs.realpathSync(item);\n    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n    addParents(resolved);\n    args.push(\"--ro-bind\", resolved, resolved);\n  }\n  const resolvedCommand = fs.realpathSync(command);\n  if (!SYSTEM_BINARIES.some((root) => resolvedCommand === root || resolvedCommand.startsWith(`${root}${path.sep}`)) && !readOnlyPaths.some((item) => fs.realpathSync(item) === resolvedCommand)) {\n    throw new Error(\"isolated executable must be included in the explicit read-only runtime paths\");\n  }\n  const bindSources = args.flatMap((arg, i) => (arg === \"--bind\" || arg === \"--ro-bind\") ? [args[i + 1]] : []);\n  const protectedOverlap = mountSourceOverlapProblem(bindSources, protectedCorpusPaths);\n  if (protectedOverlap) throw new Error(protectedOverlap);\n  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", oracleToolchains ? \"/usr/local/go/bin:/opt/nexus-qual/rust/bin:/usr/bin:/bin\" : \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"LANG\", \"C.UTF-8\");\n  if (oracleToolchains) {\n    args.push(\"--setenv\", \"GOROOT\", \"/usr/local/go\", \"--setenv\", \"GOTOOLCHAIN\", \"local\", \"--setenv\", \"GOPROXY\", \"off\", \"--setenv\", \"GOCACHE\", \"/tmp/go-cache\", \"--setenv\", \"GOMODCACHE\", \"/tmp/go-mod-cache\", \"--setenv\", \"GOPATH\", \"/tmp/go-path\", \"--setenv\", \"CARGO_HOME\", \"/tmp/cargo-home\", \"--setenv\", \"CARGO_TARGET_DIR\", \"/tmp/cargo-target\", \"--setenv\", \"CARGO_NET_OFFLINE\", \"true\", \"--setenv\", \"TMPDIR\", \"/tmp\");\n  }\n  args.push(\"--\");\n  args.push(resolvedCommand, ...argv);\n  return { cmd: BWRAP, argv: args, timeoutMs };\n}\n\nfunction addOracleMountParent(args, parent) {\n  const parts = parent.split(path.sep).filter(Boolean);\n  let current = \"\";\n  for (const part of parts) {\n    current += `/${part}`;\n    if (!args.some((value, index) => value === \"--dir\" && args[index + 1] === current)) args.push(\"--dir\", current);\n  }\n}\n\nexport function runIsolatedProcess(spec, { outputLimit = 16_384, input = \"\", resources = null } = {}) {\n  if (!Number.isFinite(spec.timeoutMs) || spec.timeoutMs <= 0) throw new Error(\"isolated process spec has no timeoutMs\");\n  const { child, containment } = spawnContained(spec, resources, { cwd: \"/\", env: {}, detached: true, stdio: [\"pipe\", \"pipe\", \"pipe\"] });\n  return new Promise((resolve) => {\n    let stdout = \"\";\n    let stderr = \"\";\n    let bytes = 0;\n    let timedOut = false;\n    let overflow = false;\n    let settled = false;\n    // Contained runs are stopped through their cgroup, so the supervisor survives to prove cleanup.\n    const killGroup = (signal) => { if (containment) containment.kill(); else { try { process.kill(-child.pid, signal); } catch {} } };\n  const executionFailureCases = [];\n  const invalidOutputCases = [];\n  const mismatchCases = [];\n  const fixturePath = task.fixture ? confinedPath(task.dir, task.fixture) : null;\n  const candidateWorkspace = fs.realpathSync(workspace);\n  const relativeCases = path.relative(candidateWorkspace, casesPath);\n  if (relativeCases === \"\" || (!relativeCases.startsWith(`..${path.sep}`) && relativeCases !== \"..\" && !path.isAbsolute(relativeCases))) {\n    throw new Error(\"black-box oracle cases unexpectedly overlap the candidate workspace\");\n  }\n  if (fixturePath) {\n    const relativeFixtureCases = path.relative(fixturePath, casesPath);\n    if (relativeFixtureCases === \"\" || (!relativeFixtureCases.startsWith(`..${path.sep}`) && relativeFixtureCases !== \"..\" && !path.isAbsolute(relativeFixtureCases))) {\n      throw new Error(\"black-box oracle cases unexpectedly overlap the copied candidate fixture\");\n    }\n  }\n  const deadline = Date.now() + check.totalTimeoutMs;\n  const containment = { executions: 0, oomKills: 0, pidsMaxEvents: 0, survivorsAfterExit: 0 };\n  for (let index = 0; index < cases.length; index++) {\n    const remainingMs = deadline - Date.now();\n    if (remainingMs < 100) {\n      const unrun = Array.from({ length: cases.length - index }, (_, offset) => index + offset);\n      failures.push(...unrun);\n      timeoutCases.push(...unrun);\n      break;\n    }\n    const spec = isolatedProcessArgv({\n      cwd: workspace,\n      command,\n      argv: [`/workspace/${check.argv[0]}`],\n      readOnlyPaths: [command],\n      allowedFiles: [command],\n      workspaceReadOnly: true,\n      timeoutMs: Math.min(check.timeoutMs, remainingMs),\n      protectedCorpusPaths,\n      oracleToolchains: check.runtime === \"python3\",\n    });\n    const result = await runIsolatedProcess(spec, {\n      outputLimit: check.maxOutputBytes,\n      input: `${JSON.stringify(cases[index].input)}\\n`,\n      resources,\n    });\n    if (result.containmentProblem) throw new Error(`black-box oracle containment failed: ${result.containmentProblem}`);\n    if (result.resources) {\n      containment.executions++;\n      containment.oomKills += result.resources.oomKills ?? 0;\n      containment.pidsMaxEvents += result.resources.pidsMaxEvents ?? 0;\n      containment.survivorsAfterExit += result.resources.survivorsAfterExit;\n    }\n    if (result.timedOut) timeoutCases.push(index);\n    if (result.overflow) outputLimitCases.push(index);\n    if (result.status !== 0 || result.error) executionFailureCases.push(index);\n    let actual;\n    let validOutput = false;\n    if (result.status === 0 && !result.timedOut && !result.overflow && !result.error) {\n      try {\n        actual = JSON.parse(result.stdout);\n        validOutput = true;\n      } catch { /* Candidate output is intentionally never copied to diagnostics. */ }\n    }\n    if (!validOutput) invalidOutputCases.push(index);\n    if (validOutput && !isDeepStrictEqual(actual, cases[index].expected)) mismatchCases.push(index);\n    if (result.timedOut || result.overflow || result.status !== 0 || result.error || !validOutput || !isDeepStrictEqual(actual, cases[index].expected)) failures.push(index);\n  }\n  return {\n    pass: failures.length === 0,\n    cases: cases.length,\nname: CI\n\non:\n  push:\n    branches: [main]\n  pull_request:\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\njobs:\n  test-matrix:\n    runs-on: ubuntu-22.04\n    strategy:\n      fail-fast: false\n      matrix:\n        node: [22, 24]\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.x'\n      - name: Install pinned evaluator toolchains\n        run: |\n          go_root=\"$(go env GOROOT)\"\n          rust_root=\"$(rustc --print sysroot)\"\n          test -n \"$go_root\" && test -d \"$go_root\"\n          test -n \"$rust_root\" && test -d \"$rust_root\"\n          sudo rm -rf -- /usr/local/go /opt/nexus-qual/rust\n          sudo install -d -o root -g root -m 0755 /usr/local /opt/nexus-qual\n          sudo cp -a \"$go_root\" /usr/local/go\n          sudo cp -a \"$rust_root\" /opt/nexus-qual/rust\n          sudo chown -hR root:root /usr/local/go /opt/nexus-qual/rust\n          sudo chmod -R go-w /usr/local/go /opt/nexus-qual/rust\n          test \"$(/usr/local/go/bin/go version)\" = \"$(go version)\"\n          test \"$(/opt/nexus-qual/rust/bin/rustc --version)\" = \"$(rustc --version)\"\n          test \"$(/opt/nexus-qual/rust/bin/cargo --version)\" = \"$(cargo --version)\"\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: ${{ matrix.node }}\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - run: node scripts/sync-version.mjs --check\n      - run: node scripts/check_requirements.mjs\n      - run: npm ci --prefix cli\n      - run: npm --prefix cli run build\n      - run: git diff --exit-code -- cli/dist\n      - run: cargo test --locked --manifest-path core/Cargo.toml\n      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n      - name: Install pinned security and SBOM test tools\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - run: npm --prefix cli test\n\n  linux-x86_64:\n    needs: [test-matrix]\n    runs-on: ubuntu-22.04\n    env:\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.x'\n      - name: Install pinned evaluator toolchains\n        run: |\n          go_root=\"$(go env GOROOT)\"\n          rust_root=\"$(rustc --print sysroot)\"\n          test -n \"$go_root\" && test -d \"$go_root\"\n          test -n \"$rust_root\" && test -d \"$rust_root\"\n          sudo rm -rf -- /usr/local/go /opt/nexus-qual/rust\n          sudo install -d -o root -g root -m 0755 /usr/local /opt/nexus-qual\n          sudo cp -a \"$go_root\" /usr/local/go\n          sudo cp -a \"$rust_root\" /opt/nexus-qual/rust\n          sudo chown -hR root:root /usr/local/go /opt/nexus-qual/rust\n          sudo chmod -R go-w /usr/local/go /opt/nexus-qual/rust\n          test \"$(/usr/local/go/bin/go version)\" = \"$(go version)\"\n          test \"$(/opt/nexus-qual/rust/bin/rustc --version)\" = \"$(rustc --version)\"\n          test \"$(/opt/nexus-qual/rust/bin/cargo --version)\" = \"$(cargo --version)\"\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n  fs.writeFileSync(path.join(workspace, \"Cargo.toml\"), '[package]\\nname = \"nexus-oracle-canary\"\\nversion = \"0.1.0\"\\nedition = \"2021\"\\n');\n  fs.writeFileSync(path.join(workspace, \"Cargo.lock\"), '# This file is automatically @generated by Cargo.\\nversion = 4\\n\\n[[package]]\\nname = \"nexus-oracle-canary\"\\nversion = \"0.1.0\"\\n');\n  fs.writeFileSync(path.join(workspace, \"src/main.rs\"), 'fn main(){print!(\"rust-ok\")}\\n');\n  fs.writeFileSync(path.join(workspace, \"check.py\"), [\n    \"import json, subprocess, sys\",\n    \"subprocess.run(['go', 'build', '-o', '/tmp/nexus-oracle-go', '/workspace/main.go'], check=True, capture_output=True, text=True)\",\n    \"subprocess.run(['cargo', 'build', '--locked', '--offline', '--manifest-path', '/workspace/Cargo.toml'], check=True, capture_output=True, text=True)\",\n    \"go = subprocess.run(['/tmp/nexus-oracle-go'], check=True, capture_output=True, text=True).stdout\",\n    \"rust = subprocess.run(['/tmp/cargo-target/debug/nexus-oracle-canary'], check=True, capture_output=True, text=True).stdout\",\n    \"value = json.loads(sys.stdin.readline())['value']\",\n    \"print(json.dumps({'value': value, 'go': go, 'rust': rust}))\",\n    \"\",\n  ].join(\"\\n\"));\n  const check = { protocol: \"blackbox-v1\", casesFile: \"private-cases.json\", runtime: \"python3\", argv: [\"check.py\"], timeoutMs: 30_000, totalTimeoutMs: 45_000, maxOutputBytes: 4096 };\n  const problem = oracleToolchainsProblem();\n  if (problem) {\n    assert.equal(blackBoxOracleProblem(check, taskDir), problem, \"qualification preflight must fail closed when pinned toolchains are unavailable\");\n    return;\n  }\n  assert.equal(blackBoxOracleProblem(check, taskDir), null);\n  const sourceFiles = [\"main.go\", \"Cargo.toml\", \"Cargo.lock\", \"src/main.rs\", \"check.py\"];\n  const sourceBefore = sourceFiles.map((file) => fs.readFileSync(path.join(workspace, file), \"utf8\"));\n  await assert.rejects(\n    runBlackBoxOracle({ dir: taskDir }, workspace, check, { protectedCorpusPaths: [\"/usr/local/go\"] }),\n    /overlaps protected corpus/,\n    \"the oracle refuses even a pinned runtime root if it overlaps protected corpus material\",\n  );\n  const result = await runBlackBoxOracle({ dir: taskDir }, workspace, check, { protectedCorpusPaths: [taskDir] });\n  assert.equal(result.pass, true, `pinned offline compiler fixture failed: ${JSON.stringify(result)}`);\n  assert.equal(JSON.stringify(result).includes(\"go-ok\"), false);\n  assert.equal(JSON.stringify(result).includes(\"rust-ok\"), false);\n  assert.deepEqual(sourceFiles.map((file) => fs.readFileSync(path.join(workspace, file), \"utf8\")), sourceBefore, \"the oracle build leaves the read-only candidate workspace unchanged\");\n});\n\ntest(\"a qualification run is refused without a model fingerprint (weights, server build, sampling)\", async () => {\n  const { modelFingerprint } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const entry = { id: \"m\", owned_by: \"llamacpp\", meta: { n_ctx_train: 32768 } };\n  assert.equal(modelFingerprint({ model: \"m\" }, entry).missing.length, 0, \"a development run needs no fingerprint\");\n  const missing = modelFingerprint({ model: \"m\", qualification: true }, entry).missing;\n  assert.equal(missing.length, 3);\n  const ok = modelFingerprint({ model: \"m\", qualification: true, fingerprint: { weightsSha256: \"b\".repeat(64), serverBuild: \"llama.cpp b6000\" }, sampling: { temperature: 0, seed: 1 } }, entry);\n  assert.deepEqual(ok.missing, []);\n  assert.equal(ok.fingerprint.ownedBy, \"llamacpp\");\n  assert.equal(ok.fingerprint.contextLength, 32768);\n  assert.equal(modelFingerprint({ model: \"m\", qualification: true, fingerprint: ok.fingerprint, sampling: { temperature: 0 } }, null).missing[0], \"the endpoint does not list model m\");\n});\n\ntest(\"qualification requires frozen request and aggregate output budgets\", async () => {\n  const { qualificationBudgetProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  assert.match(qualificationBudgetProblem({ qualification: true, limits: { context: 65536, output: 8192 } }), /limits.requests/);\n  assert.match(qualificationBudgetProblem({ limits: { output: 8192, requests: 5 } }), /limits.totalOutput/);\n  assert.match(qualificationBudgetProblem({ limits: { output: 8192, requests: 5, totalOutput: 4096 } }), /cannot be lower/);\n  assert.equal(qualificationBudgetProblem({ limits: { output: 8192, requests: 5, totalOutput: 32768 } }), null);\n});\n\ntest(\"hidden tests must be unreadable to the agent's own user\", async () => {\n  const { hiddenTestIsolationProblem, asUser } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const tasks = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-tasks-\"));\n  fs.chmodSync(tasks, 0o755);\n  assert.equal(hiddenTestIsolationProblem({}, tasks), null, \"development runs may run as the operator\");\n  assert.match(hiddenTestIsolationProblem({ qualification: true }, tasks), /need runAs/);\n  assert.match(hiddenTestIsolationProblem({ runAs: \"nexus-eval\" }, tasks), /evaluator account|setfacl|sandboxRuntimePaths/);\n  assert.match(hiddenTestIsolationProblem({ runAs: \"bad user;\" }, tasks), /not a valid user name/);\n  const wrapped = asUser(\"nexus-eval\", \"/usr/bin/bwrap\", [\"--unshare-all\", \"--\", \"/runner/node\"]);\n  // Exactly the form the provisioned sudoers rule permits: no env wrapper that would need an any-command rule.\n  assert.equal(wrapped.cmd, \"/usr/bin/sudo\");\n  assert.deepEqual(wrapped.argv, [\"-n\", \"-u\", \"nexus-eval\", \"--\", \"/usr/bin/bwrap\", \"--unshare-all\", \"--\", \"/runner/node\"]);\n  assert.throws(() => asUser(\"nexus-eval\", \"bwrap\", []), /absolute/);\n  const sudoers = fs.readFileSync(path.join(ROOT, \"eval/host/provision.sh\"), \"utf8\");\n  assert.match(sudoers, /ALL=\\(%s\\) !ALL\\\\n%s ALL=\\(%s\\) NOPASSWD: REDACTED, \"the explicit deny-all precedes the exact bwrap grant\");\n});\n\ntest(\"candidate agents receive only the approved read-only Go and Rust toolchain mounts\", async () => {\n  const { candidateAgentPath, candidateToolchainMountArgs } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const toolchains = { goRoot: \"/host/toolchains/go\", rustRoot: \"/host/toolchains/rust\" };\n  assert.equal(\n    candidateAgentPath(\"/custom/bin:/usr/bin:/bin\", toolchains),\n    \"/opt/nexus-qual/rust/bin:/usr/local/go/bin:/custom/bin:/usr/bin:/bin\",\n  );\n  assert.deepEqual(candidateToolchainMountArgs(toolchains), [\n    \"--dir\", \"/usr/local\", \"--ro-bind\", toolchains.goRoot, \"/usr/local/go\",\n    \"--dir\", \"/opt\", \"--dir\", \"/opt/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/opt/nexus-qual/rust\",\n  ]);\n  assert.deepEqual(candidateToolchainMountArgs({ goRoot: null, rustRoot: null }), []);\n  assert.deepEqual(candidateToolchainMountArgs({ goRoot: toolchains.goRoot, rustRoot: null }, [\"/usr/local/lib\"]), [\n    \"--ro-bind\", toolchains.goRoot, \"/usr/local/go\",\n  ]);\n});\n\ntest(\"qualification runtime mounts cannot overlap the task tree, held-out store, or private validator paths\", async () => {\n  const { hiddenTestIsolationProblem, runtimeCorpusOverlapProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const { agentSandboxArgv, candidateSandboxHostMountSources, isolatedArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-corpus-overlap-\"));\n  try {\n    const store = path.join(root, \"heldout-v2\");\n    const tasks = path.join(store, \"tasks\");\n    const references = path.join(store, \"reference\");\n    const runtimeRoot = path.join(root, \"runtime\");\n    const home = path.join(root, \"home\");\n    const proxyDirectory = path.join(root, \"proxy\");\n    const readOnlyRuntime = path.join(runtimeRoot, \"runtime.bin\");\n    const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n    const privateValidator = path.join(root, \"private-validator\");\n    fs.mkdirSync(tasks, { recursive: true });\n    fs.mkdirSync(references);\n    fs.mkdirSync(runtimeRoot);\n    fs.mkdirSync(home);\n    fs.mkdirSync(proxyDirectory);\n    fs.mkdirSync(privateValidator);\n    fs.writeFileSync(readOnlyRuntime, \"runtime\\n\");\n    fs.writeFileSync(path.join(tasks, \"task.json\"), \"{}\\n\");\n    fs.writeFileSync(path.join(references, \"solution.patch\"), \"REFERENCE_SOLUTION_CANARY\\n\");\n    fs.writeFileSync(path.join(privateValidator, \"validate.mjs\"), \"PRIVATE_VALIDATOR_CANARY\\n\");\n    const alias = path.join(root, \"store-alias\");\n    fs.symlinkSync(store, alias, \"dir\");\n\n    const mountContext = { cwd: runtimeRoot, home, proxyDirectory, nodeRuntime: process.execPath, supervisorPath };\n    const hostMounts = candidateSandboxHostMountSources({ ...mountContext, readOnlyPaths: [readOnlyRuntime] });\n    const expectedToolchains = [\"/usr/local/go\", \"/opt/nexus-qual/rust\"]\n      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n    const existingDirectories = [\"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/lib\", \"/lib64\", \"/usr/local/lib\"]\n    assert.equal(selectToolchainRoot(configured, fallback), configured);\n    assert.equal(selectToolchainRoot(null, fallback), fallback);\n    assert.equal(selectToolchainRoot(null, null), null);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"asUserSpec preserves timeout metadata and isolated processes reject missing timeouts\", async () => {\n  const { asUserSpec } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const { runIsolatedProcess } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const spec = { cmd: \"/usr/bin/bwrap\", argv: [\"--version\"], timeoutMs: 1200, marker: \"preserved\" };\n  assert.deepEqual(asUserSpec(\"nexus-eval\", spec), {\n    ...spec,\n    cmd: \"/usr/bin/sudo\",\n    argv: [\"-n\", \"-u\", \"nexus-eval\", \"--\", \"/usr/bin/bwrap\", \"--version\"],\n  });\n  assert.throws(() => runIsolatedProcess({ cmd: \"/usr/bin/true\", argv: [] }), /isolated process spec has no timeoutMs/);\n  assert.throws(() => runIsolatedProcess({ cmd: \"/usr/bin/true\", argv: [], timeoutMs: 0 }), /isolated process spec has no timeoutMs/);\n});\n\ntest(\"test infrastructure is recognised across Python, Go, JS/TS and Rust layouts\", async () => {\n  const { isTestInfraPath } = await hardened();\n  for (const p of [\"conftest.py\", \"pkg/conftest.py\", \"pytest.ini\", \"tox.ini\", \"setup.cfg\", \"sitecustomize.py\", \"x.pth\", \"tests/test_a.py\", \"src/test_a.py\", \"a_test.py\",\n    \"pkg/x_test.go\", \"src/x.test.ts\", \"web/a.spec.jsx\", \"__tests__/a.js\", \"jest.config.js\", \"vitest.config.mts\", \".mocharc.json\", \"build.rs\", \".cargo/config.toml\", \".github/workflows/ci.yml\", \"Makefile\", \".env.local\",\n    \"karma.conf.js\", \"jest-preset.js\", \"vitest.workspace.ts\", \"globalSetup.ts\", \"setup-tests.js\", \"test-helpers.ts\", \"internal/testhelper/x.go\", \"pkg/_testing.py\",\n    \".npmrc\", \".yarnrc.yml\", \".pnpmfile.cjs\", \"go.work\", \"rust-toolchain.toml\", \"tsconfig.json\", \".coveragerc\", \".gitattributes\", \"node_modules/x/i.js\", \".venv/lib/x.py\", \"a/__pycache__/m.pyc\"]) {\n    assert.equal(isTestInfraPath(p), true, p);\n  }\n  for (const p of [\"src/app.py\", \"pkg/server.go\", \"src/index.ts\", \"src/lib.rs\", \"README.md\", \"package.json\", \"pyproject.toml\", \"Cargo.toml\", \"contest.py\"]) {\n    assert.equal(isTestInfraPath(p), false, p);\n  }\n});\n\ntest(\"hidden test staging preserves workspace files and mounts only copied hidden files\", async () => {\n  const { stageHiddenFiles, hiddenOutputHasTests } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"hidden-stage-\"));\n  try {\n    const source = path.join(root, \"task/hidden\");\n    const ws = path.join(root, \"workspace\");\n    fs.mkdirSync(source, { recursive: true });\n    fs.mkdirSync(path.join(ws, \"test\"), { recursive: true });\n    fs.writeFileSync(path.join(source, \"private.test.js\"), \"hidden\\n\");\n    fs.writeFileSync(path.join(ws, \"existing.js\"), \"keep root\\n\");\n    fs.writeFileSync(path.join(ws, \"test/existing.js\"), \"keep test\\n\");\n    assert.deepEqual(stageHiddenFiles(source, ws, \".\", { readOnlyHidden: true }), [\"private.test.js\"]);\n    assert.deepEqual(stageHiddenFiles(source, ws, \"test\", { readOnlyHidden: true }), [\"test/private.test.js\"]);\n    assert.equal(fs.readFileSync(path.join(ws, \"existing.js\"), \"utf8\"), \"keep root\\n\");\n    assert.equal(fs.readFileSync(path.join(ws, \"test/existing.js\"), \"utf8\"), \"keep test\\n\");\n    assert.equal(fs.readFileSync(path.join(ws, \"private.test.js\"), \"utf8\"), \"hidden\\n\");\n    assert.equal(fs.readFileSync(path.join(ws, \"test/private.test.js\"), \"utf8\"), \"hidden\\n\");\n## v1/eval-agent-toolchain-binds...origin/v1/eval-agent-toolchain-binds\n07e2d2c6 (HEAD -> v1/eval-agent-toolchain-binds, origin/v1/eval-agent-toolchain-binds) Merge remote-tracking branch 'origin/main' into v1/eval-agent-toolchain-binds\n183158f0 (origin/main) Merge pull request #322 from mikeh