ame === \"release-assets.githubusercontent.com\") {\n    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n  }\n\n  return false;\n}\n\n/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\nfunction safeDownloadOrigin(urlString: string): string {\n  try {\n    return new URL(urlString).origin;\n  } catch {\n    return \"invalid URL\";\n  }\n}\n\nfunction isDownloadConnectionReset(error: any): boolean {\n  for (let current = error; current; current = current.cause) {\n    if (current.code === \"ECONNRESET\" || current.code === \"UND_ERR_SOCKET\") return true;\n  }\n  return false;\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n  let connectionResets = 0;\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\n  if (signal) {\n    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n  }\n\n  try {\n    while (hops <= maxHops) {\n      if (!validateDownloadUrl(currentUrl)) {\n        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n      }\n\n      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n        headers.Authorization = `Bearer ${token}`;\n      }\n\n      let res: Response;\n      try {\n        res = await fetch(currentUrl, {\n          headers,\n          signal: controller.signal,\n          redirect: \"manual\",\n        });\n      } catch (error) {\n142-      published_at: \"2026-10-14T08:00:00Z\",\n143-      html_url: \"https://github.com/mock/nexus/releases/v0.1.0-alpha.2\",\n144:      assets: [\n145-        {\n146-          name: \"nexus-linux-x86_64-v0.1.0-alpha.2.tar.gz\",\n--\n156-      published_at: \"2026-10-17T12:00:00Z\",\n157-      html_url: \"https://github.com/mock/nexus/releases/v1.0.0-rc.1\",\n158:      assets: [],\n159-    },\n160-    {\n--\n165-      published_at: \"2026-10-18T10:00:00Z\",\n166-      html_url: \"https://github.com/mock/nexus/releases/v1.0.0\",\n167:      assets: [],\n168-    },\n169-    {\n--\n173-      prerelease: false,\n174-      published_at: \"2026-10-18T11:00:00Z\",\n175:      assets: [],\n176-    },\n177-  ];\n--\n253-      draft: false,\n254-      prerelease: false,\n255:      assets: [],\n256-    };\n257-\n--\n416-      draft: false,\n417-      prerelease: false,\n418:      assets: [],\n419-    };\n420-\n--\n498-      draft: false,\n499-      prerelease: false,\n500:      assets: [],\n501-    };\n502-\n04392899caccd728da027e44cc3c35e991a48ee6 fix: keep local endpoint setup provisional\nc3d50a1b12de75f619ea4eae403461e5d7db2c64 feat: configure local endpoint from connect flow\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18678-40eb-70b2-b167-11dc8ca1d04f","create_time":1793258234.8672872}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
