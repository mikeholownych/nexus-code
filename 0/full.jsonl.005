]+)\"$/m.exec(rustToolchain)?.[1]);\n+  assert.equal((workflow.match(/go-version: '([^']+)'/g) ?? []).length, 2);\n+  assert.equal((workflow.match(/go-version: '1\\.22\\.12'/g) ?? []).length, 2, \"both CI jobs install the exact approved Go version\");\n+  assert.equal((workflow.match(/run: bash scripts\\/install-evaluator-toolchains\\.sh/g) ?? []).length, 2, \"both CI jobs use the same exact-version installer\");\n+  assert.equal(oracleToolchainVersionProblem({\n+    goVersion: \"go version go1.22.12 linux/amd64\",\n+    rustcVersion: \"rustc 1.95.0 (fixture)\",\n+    cargoVersion: \"cargo 1.95.0 (fixture)\",\n+  }), null);\n+  assert.match(oracleToolchainVersionProblem({\n+    goVersion: \"go version go1.22.11 linux/amd64\",\n+    rustcVersion: \"rustc 1.95.0 (fixture)\",\n+    cargoVersion: \"cargo 1.95.0 (fixture)\",\n+  }), /do not match policy/);\n+  assert.match(oracleToolchainVersionProblem({\n+    goVersion: \"go version go1.22.12 linux/amd64\",\n+    rustcVersion: \"rustc 1.94.0 (fixture)\",\n+    cargoVersion: \"cargo 1.95.0 (fixture)\",\n+  }), /do not match policy/);\n+\n+  const fakeSystem = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-system-\"));\n+  const fakeAlternatives = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-alternatives-\"));\n+  const fakeLib = path.join(fakeSystem, \"rustlib\", \"bin\");\n+  fs.mkdirSync(path.join(fakeSystem, \"bin\"), { recursive: true });\n+  fs.mkdirSync(fakeLib, { recursive: true });\n+  const compilerCanary = \"#!/bin/sh\\nprintf '%s\\\\n' UNPINNED_COMPILER_CANARY\\n\";\n+  const fakeGo = path.join(fakeSystem, \"bin\", \"go\");\n+  const fakeRustc = path.join(fakeLib, \"rustc\");\n+  const fakeCargo = path.join(fakeSystem, \"bin\", \"cargo-1.94.0\");\n+  for (const file of [fakeGo, fakeRustc, fakeCargo]) {\n+    fs.writeFileSync(file, compilerCanary);\n+    fs.chmodSync(file, 0o755);\n+  }\n+  fs.symlinkSync(fakeCargo, path.join(fakeAlternatives, \"cargo\"));\n+  t.after(() => {\n+    fs.rmSync(fakeSystem, { recursive: true, force: true });\n+    fs.rmSync(fakeAlternatives, { recursive: true, force: true });\n+  });\n+  const exposure = oracleCompilerExposureProblem([fakeSystem], [fakeAlternatives]);\n+  assert.match(exposure ?? \"\", /unapproved Go\\/Rust compiler executable/);\n+  assert.match(exposure ?? \"\", /rustlib\\/bin\\/rustc/);\n+  assert.match(exposure ?? \"\", /alternatives\\/cargo/);\n+  if (sandboxAvailable()) {\n+    assert.throws(() => isolatedProcessArgv({\n+      cwd: fakeSystem,\n+      command: \"/usr/bin/true\",\n+      readOnlyPaths: [\"/usr/bin/true\"],\n+      allowedFiles: [\"/usr/bin/true\"],\n+      oracleToolchains: true,\n+      systemDirectories: [fakeSystem],\n+      systemEtcDirectories: [fakeAlternatives],\n+    }), /unapproved Go\\/Rust compiler executable/, \"the execution-path preflight rejects deliberate compiler escape fixtures\");\n+  }\n+\n   assert.equal(oracleToolchainPathProblem({ uid: 0, mode: 0o040755 }), null, \"root-owned read-only directories are eligible\");\n   assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040775 }), /without group or other write permission/, \"group-writable toolchain paths must fail closed\");\n   assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040757 }), /without group or other write permission/, \"other-writable toolchain paths must fail closed\");\n@@ -502,6 +560,14 @@ test(\"Python black-box oracle uses only pinned offline Go and Rust toolchains, o\n   fs.writeFileSync(path.join(workspace, \"src/main.rs\"), 'fn main(){print!(\"rust-ok\")}\\n');\n   fs.writeFileSync(path.join(workspace, \"check.py\"), [\n     \"import json, subprocess, sys\",\n+    \"for executable, expected in (('/usr/bin/go', 'go1.22.12'), ('/usr/bin/rustc', '1.95.0'), ('/usr/bin/cargo', '1.95.0')):\",\n+    \"    try:\",\n+    \"        result = subprocess.run([executable, '--version'], capture_output=True, text=True)\",\n+    \"    except FileNotFoundError:\",\n+    \"        continue\",\n+    \"    reported = (result.stdout + result.stderr).strip()\",\n+    \"    if result.returncode == 0 and expected not in reported:\",\n+    \"        raise SystemExit('unapproved compiler reached by absolute path: ' + executable)\",\n     \"subprocess.run(['go', 'build', '-o', '/tmp/nexus-oracle-go', '/workspace/main.go'], check=True, capture_output=True, text=True)\",\n     \"subprocess.run(['cargo', 'build', '--locked', '--offline', '--manifest-path', '/workspace/Cargo.toml'], check=True, capture_output=True, text=True)\",\n     \"go = subprocess.run(['/tmp/nexus-oracle-go'], check=True, capture_output=True, text=True).stdout\",\ndiff --git a/eval/isolate.mjs b/eval/isolate.mjs\nindex cd4ebb19..9d686f51 100644\n--- a/eval/isolate.mjs\n+++ b/eval/isolate.mjs\n@@ -13,12 +13,18 @@ const SYSTEM_ETC_FILES = [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc\n const SYSTEM_ETC_DIRS = [\"/etc/alternatives\"];\n const FORBIDDEN_RUNTIME_ROOTS = [\"/etc\", \"/root\", \"/proc\", \"/sys\", \"/run\", \"/var\", \"/dev\", \"/tmp\", \"/mnt\", \"/media\", \"/srv\"];\n const SENSITIVE_HOME_PARTS = [\".ssh\", \".config\", \".aws\", \".azure\", \".gnupg\", \".kube\", \".nexus\", \".cache\"];\n+const TOOLCHAIN_POLICY = JSON.parse(fs.readFileSync(path.join(path.dirname(fileURLToPath(import.meta.url)), \"toolchain-versions.json\"), \"utf8\"));\n+if (TOOLCHAIN_POLICY.schemaVersion !== 1 || !/^\\d+\\.\\d+\\.\\d+$/.test(TOOLCHAIN_POLICY.go) || !/^\\d+\\.\\d+\\.\\d+$/.test(TOOLCHAIN_POLICY.rust)) {\n+  throw new Error(\"evaluator toolchain policy must pin exact Go and Rust versions\");\n+}\n const PINNED_ORACLE_TOOLCHAINS = Object.freeze([\n   { root: \"/usr/local/go\", required: [\"bin/go\"] },\n   { root: \"/opt/nexus-qual/rust\", required: [\"bin/rustc\", \"bin/cargo\"] },\n ]);\n+const UNPINNED_ORACLE_COMPILER_NAME = /^(?:go(?:-?\\d[A-Za-z0-9.+-]*)?|rustc(?:-\\d[A-Za-z0-9.+-]*)?|cargo(?:-\\d[A-Za-z0-9.+-]*)?|rustup)$/;\n let sandboxPreflight;\n const pinnedToolchainPreflights = new Map();\n+const oracleCompilerExposurePreflights = new Map();\n \n function shellQuote(value) {\n   return `'${value.replaceAll(\"'\", `'\\\\''`)}'`;\n@@ -85,12 +91,96 @@ function resolveHostToolchains() {\n }\n \n /** Python black-box oracles may invoke only these root-owned, pinned compiler runtimes. */\n-export function oracleToolchainsProblem() {\n+export function oracleToolchainVersionProblem({ goVersion, rustcVersion, cargoVersion }) {\n+  const actualGo = /^go version (go\\S+)/.exec(goVersion ?? \"\")?.[1];\n+  const actualRustc = /^rustc (\\S+)/.exec(rustcVersion ?? \"\")?.[1];\n+  const actualCargo = /^cargo (\\S+)/.exec(cargoVersion ?? \"\")?.[1];\n+  if (actualGo !== `go${TOOLCHAIN_POLICY.go}` || actualRustc !== TOOLCHAIN_POLICY.rust || actualCargo !== TOOLCHAIN_POLICY.rust) {\n+    return `pinned oracle toolchain versions do not match policy (expected Go ${TOOLCHAIN_POLICY.go} and Rust ${TOOLCHAIN_POLICY.rust})`;\n+  }\n+  return null;\n+}\n+\n+function isInsideAnyRoot(candidate, roots) {\n+  return roots.some((root) => candidate === root || candidate.startsWith(`${root}${path.sep}`));\n+}\n+\n+/** Reject every unpinned Go/Rust compiler reachable through the system mounts used by an oracle. */\n+export function oracleCompilerExposureProblem(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS) {\n+  const roots = [...new Set([...systemDirectories, ...systemEtcDirectories])].sort();\n+  const cacheKey = JSON.stringify(roots);\n+  if (oracleCompilerExposurePreflights.has(cacheKey)) return oracleCompilerExposurePreflights.get(cacheKey);\n+\n+  const exposed = new Set();\n+  const visited = new Set();\n+  const approvedRoots = PINNED_ORACLE_TOOLCHAINS.map(({ root }) => root);\n+  const visit = (directory) => {\n+    const canonicalDirectory = fs.realpathSync(directory);\n+    if (visited.has(canonicalDirectory)) return;\n+    visited.add(canonicalDirectory);\n+    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n+      const item = path.join(directory, entry.name);\n+      if (entry.isDirectory()) {\n+        visit(item);\n+        continue;\n+      }\n+      if (!UNPINNED_ORACLE_COMPILER_NAME.test(entry.name)) continue;\n+      let stat;\n+      let target;\n+      try {\n+        stat = fs.statSync(item);\n+        target = fs.realpathSync(item);\n+      } catch (error) {\n+        if (error?.code === \"ENOENT\") continue;\n+        throw error;\n+      }\n+      if (!stat.isFile() || (stat.mode & 0o111) === 0 || isInsideAnyRoot(target, approvedRoots)) continue;\n+      exposed.add(item);\n+    }\n+  };\n+\n+  try {\n+    for (const root of roots) {\n+      let stat;\n+      try { stat = fs.statSync(root); }\n+      catch (error) {\n+        if (error?.code === \"ENOENT\") continue;\n+        throw error;\n+      }\n+      if (stat.isDirectory()) visit(root);\n+    }\n+  } catch {\n+    return \"oracle compiler exposure could not be checked; refusing qualification\";\n+  }\n+\n+  const result = exposed.size\n+    ? `unapproved Go/Rust compiler executable is exposed through oracle system mounts: ${[...exposed].sort().join(\", \")}`\n+    : null;\n+  oracleCompilerExposurePreflights.set(cacheKey, result);\n+  return result;\n+}\n+\n+function executableVersion(command, argv) {\n+  const result = spawnSync(command, argv, {\n+    encoding: \"utf8\",\n+    timeout: 5000,\n+    env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n+  });\n+  return !result.error && result.status === 0 ? result.stdout.trim() : null;\n+}\n+\n+export function oracleToolchainsProblem({ systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS } = {}) {\n+  const exposureProblem = oracleCompilerExposureProblem(systemDirectories, systemEtcDirectories);\n+  if (exposureProblem) return exposureProblem;\n   for (const { root, required } of PINNED_ORACLE_TOOLCHAINS) {\n     const problem = pinnedToolchainProblem(root, required);\n     if (problem) return problem;\n   }\n-  return null;\n+  return oracleToolchainVersionProblem({\n+    goVersion: executableVersion(\"/usr/local/go/bin/go\", [\"version\"]),\n+    rustcVersion: executableVersion(\"/opt/nexus-qual/rust/bin/rustc\", [\"--version\"]),\n+    cargoVersion: executableVersion(\"/opt/nexus-qual/rust/bin/cargo\", [\"--version\"]),\n+  });\n }\n \n function pinnedToolchainProblem(root, required) {\n@@ -426,17 +516,17 @@ export function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = []\n }\n \n /** Run a fixed executable probe without exposing the host filesystem, environment, or network. */\n-export function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [], allowedRoots = [], allowedFiles = [], timeoutMs = 5000, workspaceReadOnly = false, protectedCorpusPaths = [], oracleToolchains = false }) {\n+export function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [], allowedRoots = [], allowedFiles = [], timeoutMs = 5000, workspaceReadOnly = false, protectedCorpusPaths = [], oracleToolchains = false, systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS }) {\n   if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing executable probe\");\n   if (oracleToolchains) {\n-    const problem = oracleToolchainsProblem();\n+    const problem = oracleToolchainsProblem({ systemDirectories, systemEtcDirectories });\n     if (problem) throw new Error(problem);\n   }\n   const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles);\n   if (mountProblem) throw new Error(mountProblem);\n   const workspace = fs.realpathSync(cwd);\n   const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n-  for (const source of SYSTEM_BINARIES) {\n+  for (const source of systemDirectories) {\n     try {\n       if (fs.statSync(source).isDirectory()) {\n         if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n@@ -454,7 +544,9 @@ export function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [\n   for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n     try { if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source); } catch {}\n   }\n-  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n+  for (const source of systemEtcDirectories) {\n+    try { if (fs.statSync(source).isDirectory()) args.push(\"--ro-bind\", source, source); } catch {}\n+  }\n   args.push(workspaceReadOnly ? \"--ro-bind\" : \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--tmpfs\", \"/run\", \"--symlink\", \"usr/bin\", \"/bin\");\n   const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/home/eval\", \"/run\"]);\n   const addParents = (target) => {\n#!/usr/bin/env bash\nset -euo pipefail\n\nrepo_root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd -P)\"\npolicy_file=\"$repo_root/eval/toolchain-versions.json\"\nrust_toolchain_file=\"$repo_root/rust-toolchain.toml\"\n\ngo_version=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"go\"])' \"$policy_file\")\"\nrust_version=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"rust\"])' \"$policy_file\")\"\ntoolchain_rust_version=\"$(sed -n 's/^channel = \"\\([0-9][0-9.]*\\)\"$/\\1/p' \"$rust_toolchain_file\")\"\n\nif [[ ! \"$go_version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ || ! \"$rust_version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]]; then\n  echo \"evaluator toolchain policy must contain exact semantic versions\" >&2\n  exit 1\nfi\nif [[ \"$rust_version\" != \"$toolchain_rust_version\" ]]; then\n  echo \"evaluator Rust version does not match rust-toolchain.toml\" >&2\n  exit 1\nfi\n\nexpected_go=\"go${go_version}\"\nactual_go=\"$(go version | awk '{print $3}')\"\nif [[ \"$actual_go\" != \"$expected_go\" ]]; then\n  echo \"Go version mismatch: expected $expected_go, got $actual_go\" >&2\n  exit 1\nfi\n\nrustup toolchain install \"$rust_version\" --profile minimal --component clippy --component rustfmt\nrust_root=\"$(rustup run \"$rust_version\" rustc --print sysroot)\"\nactual_rustc=\"$(rustup run \"$rust_version\" rustc --version | awk '{print $2}')\"\nactual_cargo=\"$(rustup run \"$rust_version\" cargo --version | awk '{print $2}')\"\nif [[ \"$actual_rustc\" != \"$rust_version\" || \"$actual_cargo\" != \"$rust_version\" ]]; then\n  echo \"Rust toolchain version mismatch: expected $rust_version, got rustc=$actual_rustc cargo=$actual_cargo\" >&2\n  exit 1\nfi\n\ngo_root=\"$(go env GOROOT)\"\ntest -n \"$go_root\" && test -d \"$go_root\"\ntest -n \"$rust_root\" && test -d \"$rust_root\"\nsudo rm -rf -- /usr/local/go /opt/nexus-qual/rust\nsudo install -d -o root -g root -m 0755 /usr/local /opt/nexus-qual\n# Materialize the trees so a symlinked hosted-toolcache root or any linked\n# entry cannot survive into the evaluator's pinned, non-replaceable roots.\nsudo cp -aL -- \"$go_root\" /usr/local/go\nsudo cp -aL -- \"$rust_root\" /opt/nexus-qual/rust\nsudo chown -hR root:root /usr/local/go /opt/nexus-qual/rust\nsudo chmod -R go-w /usr/local/go /opt/nexus-qual/rust\n\ncopied_go=\"$(/usr/local/go/bin/go version | awk '{print $3}')\"\ncopied_rustc=\"$(/opt/nexus-qual/rust/bin/rustc --version | awk '{print $2}')\"\ncopied_cargo=\"$(/opt/nexus-qual/rust/bin/cargo --version | awk '{print $2}')\"\nif [[ \"$copied_go\" != \"$expected_go\" || \"$copied_rustc\" != \"$rust_version\" || \"$copied_cargo\" != \"$rust_version\" ]]; then\n  echo \"copied evaluator toolchain version mismatch: go=$copied_go rustc=$copied_rustc cargo=$copied_cargo\" >&2\n  exit 1\nfi\n{\n  \"schemaVersion\": 1,\n  \"go\": \"1.22.12\",\n  \"rust\": \"1.95.0\"\n}\n","exit_code":0,"duration":{"secs":0,"nanos":848168284}},"started_at_ms":1793257439789,"completed_at_ms":1793257440637}}
