r/local/lib\"];\n    12\tconst SYSTEM_ETC_FILES = [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"];\n    13\tconst SYSTEM_ETC_DIRS = [\"/etc/alternatives\"];\n    14\tconst FORBIDDEN_RUNTIME_ROOTS = [\"/etc\", \"/root\", \"/proc\", \"/sys\", \"/run\", \"/var\", \"/dev\", \"/tmp\", \"/mnt\", \"/media\", \"/srv\"];\n    15\tconst SENSITIVE_HOME_PARTS = [\".ssh\", \".config\", \".aws\", \".azure\", \".gnupg\", \".kube\", \".nexus\", \".cache\"];\n    16\tconst TOOLCHAIN_POLICY = JSON.parse(fs.readFileSync(path.join(path.dirname(fileURLToPath(import.meta.url)), \"toolchain-versions.json\"), \"utf8\"));\n    17\tif (TOOLCHAIN_POLICY.schemaVersion !== 1 || !/^\\d+\\.\\d+\\.\\d+$/.test(TOOLCHAIN_POLICY.go) || !/^\\d+\\.\\d+\\.\\d+$/.test(TOOLCHAIN_POLICY.rust)) {\n    18\t  throw new Error(\"evaluator toolchain policy must pin exact Go and Rust versions\");\n    19\t}\n    20\tconst PINNED_ORACLE_TOOLCHAINS = Object.freeze([\n    21\t  { root: \"/usr/local/go\", required: [\"bin/go\"] },\n    22\t  { root: \"/usr/local/nexus-qual/rust\", required: [\"bin/rustc\", \"bin/cargo\"] },\n    23\t]);\n    24\tconst UNPINNED_ORACLE_COMPILER_NAME = /^(?:go(?:-?\\d[A-Za-z0-9.+-]*)?|rustc(?:-\\d[A-Za-z0-9.+-]*)?|cargo(?:-\\d[A-Za-z0-9.+-]*)?|rustup)$/;\n    25\tlet sandboxPreflight;\n    26\tconst pinnedToolchainPreflights = new Map();\n    27\tconst oracleCompilerExposurePreflights = new Map();\n    28\t\n    29\tfunction shellQuote(value) {\n    30\t  return `'${value.replaceAll(\"'\", `'\\\\''`)}'`;\n    31\t}\n    32\t\n    33\texport function candidateAgentPath(configuredPath, toolchains = resolveHostToolchains()) {\n    34\t  const configuredEntries = (configuredPath ?? \"/usr/bin:/bin\").split(path.delimiter).filter(Boolean);\n    35\t  const toolchainEntries = [\n    36\t    ...(toolchains.rustRoot ? [\"/usr/local/nexus-qual/rust/bin\"] : []),\n    37\t    ...(toolchains.goRoot ? [\"/usr/local/go/bin\"] : []),\n    38\t  ];\n    39\t  return [...new Set([...toolchainEntries, ...configuredEntries])].join(path.delimiter);\n    40\t}\n    41\t\n    42\texport function selectToolchainRoot(configuredRoot, fallbackRoot) {\n    43\t  return configuredRoot ?? fallbackRoot ?? null;\n    44\t}\n    45\t\n    46\texport function oracleToolchainPathProblem(stat) {\n    47\t  if (!stat || stat.isSymbolicLink?.() || stat.uid !== 0 || (stat.mode & 0o022) !== 0) {\n    48\t    return \"pinned oracle toolchain entry is not a real root-owned path without group or other write permission\";\n    49\t  }\n    50\t  return null;\n    51\t}\n    52\t\n    53\texport function candidateToolchainRootProblem(stat, resolvedPath, expectedPath) {\n    54\t  if (!stat || !stat.isDirectory() || stat.isSymbolicLink() || oracleToolchainPathProblem(stat) || resolvedPath !== expectedPath) {\n    55\t    return \"pinned candidate toolchain root is not a safe real directory\";\n    56\t  }\n    57\t  return null;\n    58\t}\n    59\t\n    60\tfunction toolchainMountArgs(toolchains, parentDirectoryAvailable = false) {\n    61\t  const args = [];\n    62\t  const createdDirectories = new Set(parentDirectoryAvailable ? [\"/usr/local\"] : []);\n    63\t  const ensureDirectory = (directory) => {\n    64\t    if (createdDirectories.has(directory)) return;\n    65\t    args.push(\"--dir\", directory);\n    66\t    createdDirectories.add(directory);\n    67\t  };\n    68\t  if (toolchains.goRoot) {\n    69\t    ensureDirectory(\"/usr/local\");\n    70\t    args.push(\"--ro-bind\", toolchains.goRoot, \"/usr/local/go\");\n    71\t  }\n    72\t  if (toolchains.rustRoot) {\n    73\t    ensureDirectory(\"/usr/local\");\n    74\t    ensureDirectory(\"/usr/local/nexus-qual\");\n    75\t    args.push(\"--ro-bind\", toolchains.rustRoot, \"/usr/local/nexus-qual/rust\");\n    76\t  }\n    77\t  return args;\n    78\t}\n    79\t\n    80\texport function candidateToolchainMountArgs(toolchains, systemDirectories = []) {\n    81\t  return toolchainMountArgs(toolchains, systemDirectories.includes(\"/usr/local/lib\"));\n    82\t}\n    83\t\n    84\tfunction resolveHostToolchains() {\n    85\t  const availableDirectory = ({ root, required }) => {\n    86\t    let stat;\n    87\t    try { stat = fs.lstatSync(root); }\n    88\t    catch (error) {\n    89\t      if (error?.code === \"ENOENT\") return null;\n    90\t      throw error;\n    91\t    }\n    92\t    const rootProblem = candidateToolchainRootProblem(stat, fs.realpathSync(root), root);\n    93\t    if (rootProblem) throw new Error(rootProblem);\n    94\t    const problem = pinnedToolchainProblem(root, required);\n    95\t    if (problem) throw new Error(problem);\n    96\t    return root;\n    97\t  };\n    98\t  const roots = Object.fromEntries(PINNED_ORACLE_TOOLCHAINS.map((toolchain) => [toolchain.root, availableDirectory(toolchain)]));\n    99\t  return {\n   100\t    goRoot: roots[\"/usr/local/go\"],\n   101\t    rustRoot: roots[\"/usr/local/nexus-qual/rust\"],\n   102\t  };\n   103\t}\n   104\t\n   105\t/** Python black-box oracles may invoke only these root-owned, pinned compiler runtimes. */\n   106\texport function oracleToolchainVersionProblem({ goVersion, rustcVersion, cargoVersion }) {\n   107\t  const actualGo = /^go version (go\\S+)/.exec(goVersion ?? \"\")?.[1];\n   108\t  const actualRustc = /^rustc (\\S+)/.exec(rustcVersion ?? \"\")?.[1];\n   109\t  const actualCargo = /^cargo (\\S+)/.exec(cargoVersion ?? \"\")?.[1];\n   110\t  if (actualGo !== `go${TOOLCHAIN_POLICY.go}` || actualRustc !== TOOLCHAIN_POLICY.rust || actualCargo !== TOOLCHAIN_POLICY.rust) {\n   111\t    return `pinned oracle toolchain versions do not match policy (expected Go ${TOOLCHAIN_POLICY.go} and Rust ${TOOLCHAIN_POLICY.rust})`;\n   112\t  }\n   113\t  return null;\n   114\t}\n   115\t\n   116\tfunction isInsideAnyRoot(candidate, roots) {\n   117\t  return roots.some((root) => candidate === root || candidate.startsWith(`${root}${path.sep}`));\n   118\t}\n   119\t\n   120\t/** Reject every unpinned Go/Rust compiler reachable through the system mounts used by an oracle. */\n   121\texport function oracleCompilerExposureProblem(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS) {\n   122\t  const roots = [...new Set([...systemDirectories, ...systemEtcDirectories])].sort();\n   123\t  const cacheKey = JSON.stringify(roots);\n   124\t  if (oracleCompilerExposurePreflights.has(cacheKey)) return oracleCompilerExposurePreflights.get(cacheKey);\n   125\t\n   126\t  const exposed = new Set();\n   127\t  const visited = new Set();\n   128\t  const approvedRoots = PINNED_ORACLE_TOOLCHAINS.map(({ root }) => root);\n   129\t  const visit = (directory) => {\n   130\t    const canonicalDirectory = fs.realpathSync(directory);\n   131\t    if (visited.has(canonicalDirectory)) return;\n   132\t    visited.add(canonicalDirectory);\n   133\t    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n   134\t      const item = path.join(directory, entry.name);\n   135\t      if (entry.isDirectory()) {\n   136\t        visit(item);\n   137\t        continue;\n   138\t      }\n   139\t      if (!entry.isSymbolicLink() && !UNPINNED_ORACLE_COMPILER_NAME.test(entry.name)) continue;\n   140\t      let stat;\n   330\t      const sourceVariants = pathVariants(source);\n   331\t      if (sourceVariants.some((left) => protectedVariants.some((right) => pathOverlaps(left, right)))) {\n   332\t        return `candidate sandbox host mount overlaps protected corpus material: ${source}`;\n   333\t      }\n   334\t    }\n   335\t  }\n   336\t  return null;\n   337\t}\n   338\t\n   339\texport function sandboxAvailable() {\n   340\t  if (sandboxPreflight !== undefined) return sandboxPreflight;\n   341\t  try {\n   342\t    if (!fs.statSync(BWRAP).isFile() || (fs.statSync(BWRAP).mode & 0o111) === 0) return (sandboxPreflight = false);\n   343\t    const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--proc\", \"/proc\", \"--dev\", \"/dev\"];\n   344\t    for (const source of SYSTEM_BINARIES) {\n   345\t      try {\n   346\t        if (fs.statSync(source).isDirectory()) {\n   347\t          if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   348\t          args.push(\"--ro-bind\", source, source);\n   349\t        }\n   350\t      } catch {}\n   351\t    }\n   352\t    args.push(\"--clearenv\", \"--\", \"/usr/bin/unshare\", \"-Ur\", \"true\");\n   353\t    const result = spawnSync(BWRAP, args, { encoding: \"utf8\", timeout: 5000, env: {} });\n   354\t    // The sandbox itself must start, and nested user namespaces must be unavailable to the payload.\n   355\t    return (sandboxPreflight = result.status === 1 && !result.error);\n   356\t  } catch {\n   357\t    return (sandboxPreflight = false);\n   358\t  }\n   359\t}\n   360\t\n   361\texport function isolatedArgv({ cwd, home, command, timeoutSec = 300, readOnlySubpaths = [], hiddenSubpaths = [], protectedCorpusPaths = [] }) {\n   362\t  const workspace = fs.realpathSync(cwd);\n   363\t  const hiddenSources = hiddenSubpaths.map((relative) => confinedPath(workspace, relative));\n   364\t  const readOnlySources = readOnlySubpaths.map((relative) => confinedPath(workspace, relative));\n   365\t  const mountSources = candidateSandboxHostMountSources({ cwd: workspace, readOnlyPaths: [...readOnlySources, ...hiddenSources] });\n   366\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   367\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   368\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing to execute task-controlled commands\");\n   369\t  const hiddenGuestPaths = hiddenSources.map((source) => path.posix.join(\"/workspace\", path.relative(workspace, source).split(path.sep).join(\"/\")));\n   370\t  let executionCommand = command;\n   371\t  const args = [\n   372\t    \"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\",\n   373\t    \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\",\n   374\t  ];\n   375\t  let localPrefixCreated = false;\n   376\t  for (const source of SYSTEM_BINARIES) {\n   377\t    try {\n   378\t      if (fs.statSync(source).isDirectory()) {\n   379\t        if (source === \"/usr/local/lib\") {\n   380\t          args.push(\"--dir\", \"/usr/local\");\n   381\t          localPrefixCreated = true;\n   382\t        }\n   383\t        args.push(\"--ro-bind\", source, source);\n   384\t      }\n   385\t    } catch {}\n   386\t  }\n   387\t  const { goRoot, rustRoot } = resolveHostToolchains();\n   388\t  args.push(...toolchainMountArgs({ goRoot, rustRoot }, localPrefixCreated));\n   389\t  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n   390\t    try {\n   391\t      if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source);\n   392\t    } catch {}\n   393\t  }\n   394\t  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n   395\t  args.push(\"--bind\", workspace, \"/workspace\", \"--dir\", \"/home\", \"--dir\", \"/run\");\n   396\t  if (hiddenSubpaths.length) {\n   397\t    const helperDir = path.dirname(fileURLToPath(import.meta.url));\n   398\t    args.push(\"--dir\", \"/runner\", \"--ro-bind\", path.join(helperDir, \"hide_oracle.cjs\"), \"/runner/hide_oracle.cjs\");\n   399\t    args.push(\"--ro-bind\", path.join(helperDir, \"hide_oracle.py\"), \"/runner/sitecustomize.py\");\n   400\t    args.push(\"--ro-bind\", path.join(helperDir, \"unlink_then_exec.sh\"), \"/runner/unlink_then_exec.sh\");\n   401\t  }\n   402\t  // Workspace subpaths the command may read but not change (hardened hidden tests: the oracle's own files).\n   403\t  for (const relative of hiddenSubpaths.length ? [] : readOnlySubpaths) {\n   404\t    const source = confinedPath(workspace, relative);\n   405\t    args.push(\"--ro-bind\", source, path.posix.join(\"/workspace\", path.relative(workspace, source).split(path.sep).join(\"/\")));\n   406\t  }\n   407\t  args.push(\"--symlink\", \"usr/bin\", \"/bin\");\n   408\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/local/nexus-qual/rust/bin:/usr/local/go/bin:/usr/bin:/bin\");\n   409\t  args.push(\"--setenv\", \"HOME\", home ? \"/home/eval\" : \"/tmp\");\n   410\t  args.push(\"--setenv\", \"CI\", \"1\", \"--setenv\", \"LANG\", \"C.UTF-8\");\n   411\t  if (hiddenSubpaths.length) {\n   412\t    args.push(\"--setenv\", \"NEXUS_HIDDEN_FILES\", JSON.stringify(hiddenGuestPaths));\n   413\t    args.push(\"--setenv\", \"NODE_OPTIONS\", \"--require /runner/hide_oracle.cjs\");\n   414\t    args.push(\"--setenv\", \"PYTHONPATH\", \"/runner\");\n   415\t    if (/\\bgo\\s+test\\b/.test(command)) {\n   416\t      executionCommand = command.replace(/\\bgo\\s+test\\b/g, \"go test -exec /runner/unlink_then_exec.sh\");\n   417\t    } else if (/\\bcargo\\s+test\\b/.test(command)) {\n   418\t      args.push(\"--setenv\", \"CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER\", \"/runner/unlink_then_exec.sh\");\n   419\t      executionCommand = command;\n   420\t    } else if (/^(python(?:\\d+(?:\\.\\d+)?)?)\\s+(\\S+\\.py)\\s*$/.test(command.trim())) {\n   421\t      const [, python, script] = command.trim().match(/^(python(?:\\d+(?:\\.\\d+)?)?)\\s+(\\S+\\.py)\\s*$/);\n   422\t      executionCommand = `${python} -c 'import runpy,sys; runpy.run_path(sys.argv[1], run_name=\"__main__\")' ${shellQuote(script)}`;\n   423\t    }\n   424\t    executionCommand = executionCommand.replace(/\\bPYTHONPATH=/g, \"PYTHONPATH=/runner:\");\n   425\t    executionCommand = executionCommand.replace(/\\bpytest\\b/g, \"pytest --assert=plain --noconftest\");\n   426\t    args.push(\"--setenv\", \"PYTHONDONTWRITEBYTECODE\", \"1\");\n   427\t  }\n   428\t  if (home) args.push(\"--tmpfs\", \"/home/eval\");\n   429\t  args.push(\"--\", \"/usr/bin/bash\", \"-c\", executionCommand);\n   430\t  return { cmd: BWRAP, argv: args, timeoutMs: timeoutSec * 1000 };\n   431\t}\n   432\t\n   433\texport function runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles = []) {\n   434\t  if (!Array.isArray(readOnlyPaths) || !Array.isArray(allowedRoots) || !Array.isArray(allowedFiles) || allowedRoots.some((item) => typeof item !== \"string\" || !path.isAbsolute(item)) || allowedFiles.some((item) => typeof item !== \"string\" || !path.isAbsolute(item))) {\n   435\t    return \"candidate runtime mounts require explicit absolute paths and allowed roots\";\n   436\t  }\n   437\t  const roots = [];\n   438\t  for (const item of allowedRoots) {\n   439\t    const lexical = path.resolve(item);\n   440\t    const lexicalProblem = protectedRuntimeRootProblem(lexical);\n   441\t    if (lexicalProblem) return lexicalProblem;\n   442\t    try { roots.push(fs.realpathSync(lexical)); }\n   443\t    catch { return \"candidate runtime allowlist root is unavailable\"; }\n   444\t  }\n   445\t  let executableFiles;\n   446\t  try { executableFiles = allowedFiles.map((item) => fs.realpathSync(item)); }\n   447\t  catch { return \"candidate runtime executable is unavailable\"; }\n   448\t  for (const root of roots) {\n   449\t    const rootProblem = protectedRuntimeRootProblem(root);\n   450\t    if (rootProblem) return rootProblem;\n   451\t  }\n   452\t  for (const item of readOnlyPaths) {\n   453\t    if (typeof item !== \"string\" || !path.isAbsolute(item)) return \"candidate runtime paths must be absolute\";\n   454\t    let resolved;\n   455\t    try { resolved = fs.realpathSync(item); }\n   456\t    catch { return `candidate runtime path is unavailable: ${item}`; }\n   457\t    const stat = fs.statSync(resolved);\n   458\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   459\t    const explicitlySelectedTempExecutable = executableFiles.includes(resolved) && stat.isFile() && resolved.startsWith(`/tmp${path.sep}`);\n   460\t    if (FORBIDDEN_RUNTIME_ROOTS.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !explicitlySelectedTempExecutable) {\n   461\t      return `protected candidate runtime path is forbidden: ${resolved}`;\n   462\t    }\n   463\t    if (resolved === os.homedir() || (resolved.startsWith(`${os.homedir()}${path.sep}`) && resolved.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part)))) {\n   464\t      return `sensitive candidate runtime path is forbidden: ${resolved}`;\n   465\t    }\n   466\t    if (!stat.isFile() && !stat.isDirectory()) return `candidate runtime path is not a regular file or directory: ${resolved}`;\n   467\t    if (!roots.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !executableFiles.includes(resolved)) {\n   468\t      return `candidate runtime path is outside its explicit allowlist: ${resolved}`;\n   469\t    }\n   470\t    if (executableFiles.includes(resolved) && !stat.isFile()) return `candidate runtime executable is not a regular file: ${resolved}`;\n   471\t    if (stat.isDirectory()) assertNoSymlinks(resolved);\n   472\t  }\n   473\t  return null;\n   474\t}\n   475\t\n   476\tfunction protectedRuntimeRootProblem(root) {\n   477\t  if (root.startsWith(`${os.homedir()}${path.sep}`) && root.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part))) return `sensitive candidate runtime root is forbidden: ${root}`;\n   478\t  if (root === \"/\" || root === \"/home\" || root === os.homedir() || FORBIDDEN_RUNTIME_ROOTS.some((item) => root === item || root.startsWith(`${item}${path.sep}`))) return `protected candidate runtime root is forbidden: ${root}`;\n   479\t  return null;\n   480\t}\n   481\t\n   482\texport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n   483\t  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n   484\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   485\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   486\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n   487\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n   488\t  if (mountProblem) throw new Error(mountProblem);\n   489\t  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n   490\t    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n   491\t  }\n   492\t  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n   493\t  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n   494\t    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n   495\t  }\n   496\t  const workspace = mountSources.runtimeSources.cwd;\n   497\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   498\t  for (const source of mountSources.systemDirectories) {\n   499\t    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   500\t    args.push(\"--ro-bind\", source, source);\n   501\t  }\n   502\t  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\n   503\t  for (const source of mountSource