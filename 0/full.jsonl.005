 const exposureScan = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths);\n   if (exposureScan.problem) return exposureScan.problem;\n+  return pinnedOracleToolchainsProblem();\n+}\n+\n+function pinnedOracleToolchainsProblem() {\n   for (const { root, required } of PINNED_ORACLE_TOOLCHAINS) {\n     const problem = pinnedToolchainProblem(root, required);\n     if (problem) return problem;\n@@ -599,7 +603,7 @@ export function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [\n     const additionalMountedPaths = readOnlyPaths.map((item) => fs.realpathSync(item));\n     compilerExposure = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths);\n     if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n-    const problem = oracleToolchainsProblem({ systemDirectories, systemEtcDirectories, additionalMountedPaths });\n+    const problem = pinnedOracleToolchainsProblem();\n     if (problem) throw new Error(problem);\n   }\n   const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles);\n{\n  \"agent\": \"codex-root\",\n  \"program\": \"codex-app\",\n  \"model\": \"gpt-6.1\",\n  \"host\": \"mike-dev\",\n  \"branch\": \"v1/eval-agent-toolchain-binds\",\n  \"worktree\": \"/home/mike/nexus-wt/eval-agent-toolchain-binds\",\n  \"base\": \"078f12b11f32ebde7a28477cddba1b68e5206ca4\",\n  \"since\": \"2026-10-29T04:35:57Z\",\n  \"scope\": \"PR #318 remediation of independent-review P1: prevent candidate task processes from reaching unpinned Go/Rust compilers through absolute system paths; preserve existing toolchain work; synthetic fixtures only; no held-out qualification task use; no changes outside this worktree\",\n  \"validation_status\": \"Committed and pushed stale-preflight-cache fix on exact PR #318 head 1eb99993. Focused Python black-box oracle test passed 1/1 with isolated HOME. Independent review and exact-head CI pending; no held-out qualification used.\",\n  \"last_updated\": \"2026-10-29T13:05:50Z\",\n  \"head\": \"1eb999938577645abd13b3c13ebb16ff7ba0feb2\",\n  \"review\": \"Independent ACCEPT for commit 0bb0d379 relative to 42b85729; diff SHA256 5bd02b29f99350e92f1e4c54c5358c6fb3b0b73a1d392af333eb4bcfda4f610f. Earlier resolved-target patch independently accepted.\",\n  \"status\": \"PR318 updated to 1eb99993; focused stale-cache regression passed 1/1; independent review and exact-head CI pending; no held-out use.\"\n}\n","exit_code":0,"duration":{"secs":1,"nanos":309149600}},"started_at_ms":1793279261617,"completed_at_ms":1793279262927}}
