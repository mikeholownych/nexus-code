th of mountedSpellingsForTarget(target, roots)) exposed.add(mountedPath);\n     }\n   };\n \n@@ -200,9 +218,16 @@ function scanOracleCompilerExposure(systemDirectories = SYSTEM_BINARIES, systemE\n   return result;\n }\n \n-function compilerExposureMaskArgs(scan) {\n+export function compilerExposureMaskArgs(scan) {\n   if (scan.problem) throw new Error(scan.problem);\n-  return scan.paths.flatMap((item) => [\"--ro-bind\", \"/dev/null\", item]);\n+  const targets = [...new Set(scan.paths)];\n+  for (const target of targets) {\n+    let stat;\n+    try { stat = fs.lstatSync(target); }\n+    catch { throw new Error(\"oracle compiler exposure target is unavailable; refusing qualification\"); }\n+    if (!stat.isFile()) throw new Error(\"oracle compiler exposure target is not a regular file; refusing qualification\");\n+  }\n+  return targets.flatMap((target) => [\"--ro-bind\", \"/dev/null\", target]);\n }\n \n /** Candidate processes receive the same system mounts as oracle processes and must share their compiler boundary. */\n078f12b1 (origin/main) Merge pull request #323 from mikeholownych/v1/rc11-candidate-20261029\nea7b728c (pr/323, origin/v1/rc11-candidate-20261029) docs(release): include credential and recovery fixes in the rc.11 notes\ne13da84f release: cut the 1.0.0-rc.11 candidate\ndf288ef0 Merge pull request #321 from mikeholownych/codex/release-readiness-20261029\n183158f0 Merge pull request #322 from mikeholownych/v1/ci-pinned-eval-toolchains\n{\"baseRefOid\":\"df288ef010a93c418e4972d3d40dc293ec9c0081\",\"headRefOid\":\"37855d08d342412b6177baa9f30dd6a31d37d10e\",\"mergeStateStatus\":\"BLOCKED\",\"reviewDecision\":\"\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-29T12:32:10Z\",\"conclusion\":\"FAILURE\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40871541877/job/123439566100\",\"name\":\"test-matrix (22)\",\"startedAt\":\"2026-10-29T12:13:49Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"