artifacts-vertical-slice\",\"updatedAt\":\"2026-10-26T00:07:33Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/227\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/npm_and_yarn/experiments/cloudflare-artifacts-vertical-slice/fork-worker/vite-8.3.5\",\"headRefOid\":\"2f9d1eec287779e185330e1d81c8fd9e92138cfe\",\"number\":226,\"reviewDecision\":\"\",\"title\":\"build(deps-dev): bump vite from 8.3.4 to 8.3.5 in /experiments/cloudflare-artifacts-vertical-slice/fork-worker\",\"updatedAt\":\"2026-10-25T13:04:32Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/226\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/npm_and_yarn/experiments/cloudflare-artifacts-vertical-slice/agent-collab-worker/cf-1.0.0-beta.20\",\"headRefOid\":\"72094b3217811c2e6f75775e77a85986fc86adae\",\"number\":225,\"reviewDecision\":\"\",\"title\":\"build(deps-dev): bump cf from 1.0.0-beta.10 to 1.0.0-beta.20 in /experiments/cloudflare-artifacts-vertical-slice/agent-collab-worker\",\"updatedAt\":\"2026-10-25T13:04:32Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/225\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/npm_and_yarn/experiments/cloudflare-artifacts-vertical-slice/shared-ref-worker/cloudflare/vite-plugin-2.0.0-beta.v.3\",\"headRefOid\":\"4d52306e1080fcb52fbbd2fbcfbdd9235bd526bb\",\"number\":224,\"reviewDecision\":\"\",\"title\":\"build(deps-dev): bump @cloudflare/vite-plugin from 2.0.0-beta.sha-52b0dc0e9 to 2.0.0-beta.v.3 in /experiments/cloudflare-artifacts-vertical-slice/shared-ref-worker\",\"updatedAt\":\"2026-10-25T13:04:28Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/224\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/npm_and_yarn/experiments/cloudflare-artifacts-vertical-slice/cf-1.0.0-beta.20\",\"headRefOid\":\"47d92ae4c9c111c9a8317ca2185f2f76871b75f5\",\"number\":223,\"reviewDecision\":\"\",\"title\":\"chore(deps-dev): bump cf from 1.0.0-beta.10 to 1.0.0-beta.20 in /experiments/cloudflare-ar