pect = (entry: fs.Dirent) => {\n    const full = path.join(dir, entry.name);\n    const isTemp = isAtomicJsonTemp(entry.name);\n    const isRecord = entry.isFile() && entry.name.endsWith(\".json\") && entry.name !== \"index.json\" && !entry.name.startsWith(\".corrupt-\");\n    if (!isTemp && !isRecord) return;\n    pending.push((async () => {\n      try {\n        const stat = await fs.promises.lstat(full);\n        if (signal.aborted || !stat.isFile() || stat.nlink !== 1) return;\n        if (isTemp) temps.push(full);\n        if (isRecord) keepNewest(newest, { name: entry.name, mtimeMs: stat.mtimeMs }, limit);\n      } catch {}\n    })());\n  };\n  for await (const entry of directory) {\n    if (signal.aborted) break;\n    inspect(entry);\n    if (pending.length >= statBatchSize) {\n      await Promise.all(pending);\n      pending.length = 0;\n    }\n  }\n  await Promise.all(pending);\n  return newest.sort((a, b) => b.mtimeMs - a.mtimeMs);\n}\n\nfunction validMessageCursor(value: any): boolean {\n  return Boolean(value && typeof value === \"object\" && value.schemaVersion === 2 &&\n    typeof value.sha256 === \"string\" && /^[a-f0-9]{64}$/.test(value.sha256) &&\n    Number.isSafeInteger(value.offset) && value.offset >= 0 &&\n    Number.isSafeInteger(value.bytes) && value.bytes >= 1 &&\n    Number.isSafeInteger(value.count) && value.count >= 0);\n}\n\nfunction validStateConversation(data: any, taskRecord: boolean): boolean {\n  if (!data || typeof data !== \"object\" || Array.isArray(data)) return false;\n  if (data.schemaVersion === 2) {\n    return typeof data.taskId === \"string\" && data.taskId.length > 0 &&\n      !Object.hasOwn(data, \"messages\") &&\n      (data.messageLog === null || validMessageCursor(data.messageLog));\n  }\n  const identity = taskRecord ? data.taskId || data.id : data.sessionId || data.taskId || data.id;\n  return Boolean(identity) && Array.isArray(data.messages);\n}\n\nconst stateIntegrityCheck: Check = async (ctx, signal) => {\n  const dirs = [path.join(ctx.home, \".nexus\", \"sessions\"), path.join(ctx.home, \".nexus\", \"tasks\")];\n  let checked = 0;\n  const corrupt: string[] = [];\n  const temps: string[] = [];\n  const unreadable: string[] = [];\n  const limit = ctx.deep ? 5000 : 300;\n  for (const dir of dirs) {\n    if (signal.aborted) break;\n    let files: RecentStateFile[];\n    try {\n      files = await newestStateFiles(dir, limit, signal, temps);\n    } catch (error: any) {\n      if (signal.aborted) break;\n      // A missing store is simply empty; a store that exists but cannot be opened is not evidence of\n      // health and must not be reported as \"no saved state\".\n      if (error?.code !== \"ENOENT\") unreadable.push(dir);\n      continue;\n    }\n    for (const { name } of files) {\n      if (signal.aborted) break;\n      const full = path.join(dir, name);\n      checked++;\n      try {\n        const text = await fs.promises.readFile(full, { encoding: \"utf8\", signal });\n        if (signal.aborted) break;\n        const data = JSON.parse(text);\n        if (!validStateConversation(data, path.basename(dir) === \"tasks\")) corrupt.push(full);\n      } catch (error: any) {\n        if (signal.aborted || error?.name === \"AbortError\") break;\n        corrupt.push(full);\n      }\n    }\n  }\n  if (checked === 0 && temps.length === 0 && unreadable.length === 0) {\n    return f(\"state.integrity\", \"state\", \"pass\", \"No saved sessions or task state yet.\");\n  }\n  const evidence = [`${checked} record(s) checked${ctx.deep ? \" (newest 5000 per directory)\" : \" (newest 300 per directory; --deep checks up to 5000)\"}`];\n  const issues: string[] = [];\n  if (corrupt.length) issues.push(`${corrupt.length} saved record(s) are malformed and may not load`);\n  if (temps.length) issues.push(`${temps.length} recognized atomic-write temporary file(s) are present; a write may still be active, so doctor cannot determine whether they are stale`);\n  if (unreadable.length) issues.push(`${unreadable.length} state director${unreadable.length === 1 ? \"y\" : \"ies\"} could not be read, so doctor cannot determine whether the saved state is healthy`);\n  if (issues.length) {\n    return f(\"state.integrity\", \"state\", \"warn\", `${issues.join(\"; \")}.`, [...evidence, ...corrupt.slice(0, 5), ...unreadable, ...temps.slice(0, 3)], \"Inspect the listed paths and their permissions; doctor never deletes or repairs session or task files.\");\n  }\n  return f(\"state.integrity\", \"state\", \"pass\", \"Every checked session and task-state record parses and has an id plus valid conversation metadata.\", evidence);\n};\n\nconst credentialStoreCheck: Check = async (ctx) => {\n  const file = ctx.home === credentialStorageHome() ? credentialsPath() : path.join(ctx.home, \".config/nexus/credentials.json\");\n  if (!fs.existsSync(file)) return f(\"credentials.store\", \"state\", \"pass\", \"Nexus's own credential store is not in use (credentials come from the environment or other clients).\", [file]);\n  const mode = modeOf(file) ?? 0;\n  try {\n    JSON.parse(fs.readFileSync(file, \"utf8\"));\n  } catch {\n  }\n  const note = \"Plugin modules were listed, not loaded (loading runs their code).\";\n  if (risky.length) return f(\"plugins.config\", \"extensions\", \"warn\", `${risky.length} plugin problem(s): untrusted workspace plugins are not loaded; world-writable plugin files could be changed by anyone. ${note}`, [...risky, ...found.slice(0, 10)], \"Trust the workspace (`nexus trust`) or remove its plugins; restrict writable files with `chmod o-w <file>`.\");\n  return f(\"plugins.config\", \"extensions\", found.length ? \"pass\" : \"skip\", found.length ? `${found.length} plugin module(s) found. ${note}` : \"No plugins are installed (optional).\", found.slice(0, 10));\n};\n\nconst CHECKS: Array<[string, Check]> = [\n  [\"install\", installCheck],\n  [\"tui\", tuiCheck],\n  [\"runtime\", runtimeCheck],\n  [\"launcher\", launcherCheck],\n  [\"config\", configCheck],\n  [\"project_env_ignored\", projectEnvCheck],\n  [\"endpoint\", endpointChecks],\n  [\"inference\", inferenceCheck],\n  [\"shell\", shellCheck],\n  [\"engine\", engineCheck],\n  [\"workspace\", workspaceCheck],\n  [\"state\", stateDirCheck],\n  [\"permissions\", statePermissionsCheck],\n  [\"integrity\", stateIntegrityCheck],\n  [\"credentials\", credentialStoreCheck],\n  [\"config_env\", configEnvCheck],\n  [\"custom_ca\", customCaCheck],\n  [\"mcp\", mcpCheck],\n  [\"plugins\", pluginCheck],\n];\n\n/** Runs `check` with its own deadline; a throw or timeout becomes a finding, so other checks are unaffected. */\nasync function runCheck(name: string, check: Check, ctx: CheckContext, parent: AbortSignal): Promise<DoctorFinding[]> {\n  const started = Date.now();\n  const defaultLimit = name === \"inference\" ? ctx.timeoutMs * 6 + 1000 : name === \"endpoint\" ? ctx.timeoutMs * 2 + 1000 : ctx.timeoutMs + 1000;\n  // The default integrity scan gets more time for large, long-lived stores.\n  // An explicit --timeout remains authoritative for every check.\n  const limit = name === \"integrity\" && !ctx.timeoutOverride ? Math.max(defaultLimit, 30_000) : defaultLimit;\n  const controller = new AbortController();\n  const onAbort = () => controller.abort();\n  parent.addEventListener(\"abort\", onAbort, { once: true });\n  let onParentCancel: (() => void) | undefined;\n  let timer: NodeJS.Timeout | undefined;\n  try {\n    const result = await Promise.race([\n      check(ctx, controller.signal),\n      new Promise<\"timeout\">((resolve) => (timer = setTimeout(() => resolve(\"timeout\"), limit))),\n      new Promise<\"cancelled\">((resolve) => {\n        if (parent.aborted) {\n          resolve(\"cancelled\");\n        } else {\n          onParentCancel = () => resolve(\"cancelled\");\n          parent.addEventListener(\"abort\", onParentCancel, { once: true });\n        }\n9-\n10-They also follow from audit finding PER-03: the test suite writes into the real `~/.nexus`.\n11-\n12:## 1. Unit of work: one claimed PR slice per agent\n13-\n14-- The unit of concurrent work is **one PR slice** from a plan, for example `PLAN-01/PR-1a`. Every slice lists its tasks and its safe change boundary in its plan.\n15:- An agent works on exactly one claimed slice at a time.\n16-- An agent must not edit files outside its slice's boundary. The exceptions are the ledger rows and the shared files covered by §4. If the work needs a file outside the boundary, the agent stops and records a **boundary request** (§6). It does not edit the file.\n17-\n18:## 2. Claiming a slice (atomic and machine-local)\n19-\n20:Claims live in the repository's shared git directory. They are visible to every worktree, and they are never committed.\n21-\n22-```sh\n23:CLAIMS=\"$(git rev-parse --git-common-dir)/nexus-claims\"\n24:mkdir -p \"$CLAIMS\"\n25-SLICE=\"PLAN-01_PR-1a\"\n26:if mkdir \"$CLAIMS/$SLICE\" 2>/dev/null; then          # mkdir is atomic: exactly one agent wins\n27-  printf '{\"agent\":\"%s\",\"branch\":\"%s\",\"since\":\"%s\",\"pid\":%s}\\n' \\\n28:    \"$AGENT_NAME\" \"v1/plan-01-pr-1a\" \"$(date -u +%FT%TZ)\" \"$$\" > \"$CLAIMS/$SLICE/owner.json\"\n29-else\n30:  echo \"claimed by: $(cat \"$CLAIMS/$SLICE/owner.json\")\"; exit 1\n31-fi\n32-```\n33-\n34:- **Release** the claim by deleting its directory (`rm -r \"$CLAIMS/$SLICE\"`) after the slice merges or is abandoned. Write one line about the outcome to `$CLAIMS/../nexus-claims.log`.\n35:- **Hot-file claims** use the same mechanism with the name `FILE_<path with / replaced by _>`, for example `FILE_cli_src_agent.ts`. See §4.\n36:- **Stale claims.** A claim older than 24 h whose PID is gone may be broken, but only by the owner, or by an agent that first records the broken claim in the log.\n37:- If the MCP Agent Mail server is available, its file reservations (`file_reservation_paths`) may be used as well. The git-common-dir claim stays authoritative, because every agent can see it without extra tooling.\n38-\n39-## 3. Isolation: worktree, branch, HOME, ports, processes\n40-\n41-| Resource | Rule |\n42-|---|---|\n43:| Source | One `git worktree` per claimed slice: `git worktree add ../nexus-wt/<slice> -b v1/<plan>-<slice> origin/main`. Never edit `~/nexus-code` itself. It is the owner's checkout, and `/usr/local/bin/nexus` runs from it. |\n44-| Branch | `v1/plan-NN-pr-Nx`. One branch per slice. Never commit to `main` directly. |\n45-| HOME and state | Until PLAN-08 PR-8a lands, every test, build and probe run sets `HOME=$(mktemp -d)` and `XDG_CONFIG_HOME=\"$HOME/.config\"`. After PR-8a, the test setup enforces this, but scripts and probes outside `npm test` must still set it. **Never** run anything that writes to the real `~/.nexus` or `~/.config/nexus`. |\n46-| Test runs | Full suites run on a **snapshot copy** of the worktree (`git worktree add` at the commit under test, or `git archive`), never on the tree being edited. `tsx` reads `src/` live. |\n47-| Builds | Each worktree builds into its own `core/target`, and `cli/dist` is per worktree. To share the Rust build cache, set `CARGO_TARGET_DIR` per worktree, never to one shared directory. |\n48-| Ports | Mock servers bind `127.0.0.1:0` (an ephemeral port) and publish the chosen port to a file. Fixed ports are forbidden. |\n49-| Processes | Kill only PIDs you started, taken from `$!` or `ps -eo pid,args \\| grep -v grep`. **Never `pkill -f` or `killall`.** Long background jobs are stopped through the agent's own task controls. |\n50:| Inference | There is one inference host (DEC-16). Any run that uses the gateway takes the claim `GATEWAY` first. That includes eval runs, live checks and stripped-proxy runs. One gateway run at a time, which keeps eval timings valid and prevents overload. Small cloud checks (E5) take `CLOUD` to avoid duplicate spend. |\n51-| Credentials | Agents never read or copy `~/.config/nexus/credentials.json`, `config.env` values, or gateway tokens. The stripped proxy reads the token file itself. |\n52-\n53-## 4. Hot files: serialise, do not merge blindly\n54-\n55:These files are touched by several plans. An agent editing one must hold its `FILE_` claim for the **shortest** period: edit, test, push, merge, then release.\n56-\n57-| File | Plans that touch it | Rule |\n58-|---|---|---|\n59:| `cli/src/agent.ts` | 01, 02, 03, 04, 05, 11 | Claim required. Keep each change local to the line ranges the plan names. Rebase immediately before merge and re-run that slice's tests on the rebased snapshot. |\n60:| `cli/src/index.ts` | 01, 03, 04, 06, 08, 10, 11 | Claim required. **PLAN-06 PR-6b (unified launcher) lands first.** Other plans add commands and flags afterwards. |\n61:| `cli/src/tools.ts` | 01, 02, 03, 06, 11 | Claim required. **PLAN-02 PR-2b (signal plumbing) lands before PLAN-03 PR-3c (`safeFetch`)**. |\n62:| `cli/src/sidecar.ts` | 01, 02, 03, 05, 08 | Claim required |\n63:| `cli/src/doctor.ts` | 01, 03, 05, 06, 08 | Claim required. Each plan adds **new check functions** in separate blocks. Only PLAN-06 PR-6d changes existing checks. |\n64:| `cli/src/client.ts` | 03, 05, 08, 11 | Claim required. **PLAN-03 PR-3a (env layering) lands before any PLAN-05 slice.** |\n65:| `cli/src/repl.ts` | 01, 05, 08 | Claim required |\n66:| `cli/src/config.ts`, `security.ts`, `sandbox.ts`, `mcp.ts`, `plugins.ts` | 01, 03 | Claim required. PLAN-01 PR-1e and PLAN-03 must not run at the same time on `sandbox.ts` or `security.ts`. |\n67-| `cli/src/core/capabilities.ts` | 01, 02 | **PLAN-01 PR-1a (effect classes) lands first.** PLAN-02 PR-2c adds schema fields afterwards. |\n68-| `cli/src/tester.ts` | 01, 11 | **PLAN-01 PR-1c lands before PLAN-11 PR-11b/11c.** |\n69-| `cli/src/core/state.ts` | 04, 08 | **PLAN-08 PR-8a (HOME isolation) lands before everything.** |\n70:| `core/src/runner.rs`, `core/src/main.rs` | 01, 02, 06 | Claim required. The protocol version number is owned by PLAN-02 PR-2a. PLAN-06 PR-6c only reads it. |\n71:| `core/src/bin/nexus_tui/{live_state,live_view}.rs` | 01, 02 | Claim required |\n72-| `package.json`, `cli/package.json`, `core/Cargo.toml`, lockfiles | 01, 06, 07, 08 | **Only one agent at a time.** Version fields are written only by `scripts/sync-version.mjs`. Dependency changes are separate commits that touch only the lockfile and manifest. |\n73:| `harness.sh`, `install.sh`, `scripts/package-linux.sh`, `.github/workflows/*` | 05, 06, 07, 09, C1 | Claim required. Workflow edits are separate commits. |\n74-| `cli/dist/**` | all, while tracked | Do not commit `cli/dist` from slices. PLAN-07 PR-7d untracks it (DEC-10). Until that merges, only the merging agent rebuilds and commits dist, in a final separate commit, after rebasing. |\n75:| `docs/USER_MANUAL.md`, `ARCHITECTURE.md`, `CLOUD_PROVIDERS.md`, `quickstart.md` | 05, 09 and doc tasks in every plan | Edit only the sections your slice changes. Hold a short `FILE_` claim. |\n76-\n77-### Ledger updates (`docs/v1.0.0/REQUIREMENTS.md`)\n78-\n--\n82-\n83-1. Before **every** commit, compare `git rev-parse HEAD` with the commit you last made. Then run `git log <yours>..HEAD` on the branch. If anything foreign appears, stop and reconcile. Never commit generated artifacts (evidence, dist, lockfiles) over a branch that moved (lessons 2026-10-13).\n84-2. Commits are scoped to the slice. Do not reformat or clean up files outside the boundary.\n85:3. Merge order follows the precedence rules in §4 and the ROADMAP milestone order. Within a milestone, the slice with fewer hot-file claims merges first.\n86-4. Rebase onto `origin/main` immediately before merging. Re-run the slice's targeted tests, plus `make test`, on a snapshot of the rebased commit. Merge only if both pass.\n87-5. Pushing, tagging, publishing and changing GitHub state (issues, milestones, releases) are **owner-approved actions** (DECISIONS X-list). Agents prepare them and do not perform them.\n88-6. Preserve unrelated user work: the untracked `nexus-continuity-validation/`, the stashes, and any dirty files you did not create. Never stash, reset, clean or check out over them.\n--\n91-\n92-| Record | Where | Purpose |\n93-|---|---|---|\n94:| Claims | `$(git rev-parse --git-common-dir)/nexus-claims/` | Who owns which slice or file right now |\n95:| Claim log | `$(git rev-parse --git-common-dir)/nexus-claims.log` (append-only, one line per event) | Claim, release, broken claim, boundary request |\n96:| Boundary requests and discovered requirements | The PR description, under the heading `Needs from other slices`. Mirrored as one line in the claim log. | So the owning slice's agent can pick it up. Never fixed silently out of scope. |\n97-| Slice evidence | `docs/reviews/evidence/v1/<plan>-<slice>/` (new directory per slice) | No shared evidence files, so agents cannot overwrite each other's evidence |\n98-\n99-## 7. Safe parallel lanes\n100-\n101:The following groupings can run at the same time with no hot-file contention beyond §4 claims. They are listed by milestone.\n102-\n103-| Phase | Parallel lanes |\n104-|---|---|\n--\n106-| M1 | (a) PLAN-01 PR-1a → PR-1b → PR-1c (sequential, owns `capabilities.ts`, `agent.ts` dispatch). (b) PLAN-02 PR-2a (Rust only). (c) PLAN-03 PR-3a → PR-3b (config/egress). (d) PLAN-11 PR-11a (`parser.ts`) and PR-11b (`tester.ts`, after PR-1c). Lanes (b), (c) and (d) do not touch `capabilities.ts`. |\n107-| M2 (alongside M1) | (a) PLAN-07 PR-7a/7b/7c (workflows, scripts). (b) PLAN-06 PR-6b after PLAN-01 PR-1b (shares `index.ts` flags). |\n108-| M3 | (a) PLAN-04 (`agent.ts` turn, operation runner). (b) PLAN-05 (`client.ts`, provider modules). (c) PLAN-10 harness (`eval/`, no product files). (d) Held-out task authoring by the agent author, **outside the repository**: no access to Nexus source or the development set (DEC-05). |\n109:| M4 (alongside M3) | PLAN-08 PR-8b..8e. Coordinate with PLAN-04 on `state.ts` through `FILE_` claims. |\n110:| M5 | **Serial on `GATEWAY`.** The eval runner, the stripped-proxy runs and the independent reviewer's live task each take the `GATEWAY` claim. The terminal matrix (E3) and the install matrix (E2) can run in parallel with gateway runs. |\n111-\n112-## 8. Independence constraints\n113-\n","exit_code":0,"duration":{"secs":0,"nanos":40949}},"started_at_ms":1793256581588,"completed_at_ms":1793256581588}}
{"timestamp":"2026-10-29T06:49:42.878Z","ordinal":496583,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1866b-eede-7f71-9e0e-deec8eb4b31d","call_id":"call_cbe45ced000045ab80c6a011f5c00ccb","output":[{"type":"input_text","text":"Script completed\nWall time 2.6 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 4642)\nTotal output lines: 269\n\n}\n\nconst ATOMIC_JSON_TEMP = /^([A-Za-z0-9._-]{1,200}\\.json)\\.[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.tmp$/i;\n\n/** Only recognize the target.UUID.tmp names used by atomic JSON state writers, never arbitrary *.tmp files. */\nfunction isAtomicJsonTemp(name: string): boolean {\n  return ATOMIC_JSON_TEMP.test(name);\n}\n\nasync function newestStateFiles(dir: string, limit: number, signal: AbortSignal, temps: string[]): Promise<RecentStateFile[]> {\n  const newest: RecentStateFile[] = [];\n  const directory = await fs.promises.opendir(dir);\n  const pending: Promise<void>[] = [];\n  // Keep the scan asynchronous without making long-lived state directories spend one deadline per file.\n  // A fixed batch also bounds metadata requests if an operator has an unexpectedly large state tree.\n  const statBatchSize = 128;\n  const inspect = (entry: fs.Dirent) => {\n    const full = path.join(dir, entry.name);\n    const isTemp = isAtomicJsonTemp(entry.name);\n    const isRecord = entry.isFile() && entry.name.endsWith(\".json\") && entry.name !== \"index.json\" && !entry.name.startsWith(\".corrupt-\");\n    if (!isTemp && !isRecord) return;\n    pending.push((async () => {\n      try {\n        const stat = await fs.promises.lstat(full);\n        if (signal.aborted || !stat.isFile() || stat.nlink !== 1) return;\n        if (isTemp) temps.push(full);\n        if (isRecord) keepNewest(newest, { name: entry.name, mtimeMs: stat.mtimeMs }, limit);\n      } catch {}\n    })());\n  };\n  for await (const entry of directory) {\n    if (signal.aborted) break;\n    inspect(entry);\n    if (pending.length >= statBatchSize) {\n      await Promise.all(pending);\n      pending.length = 0;\n    }\n  }\n  await Promise.all(pending);\n  return newest.sort((a, b) => b.mtimeMs - a.mtimeMs);\n}\n\nfunction validMessageCursor(value: any): boolean {\n  return Boolean(value && typeof value === \"object\" && value.schemaVersion === 2 &&\n    typeof value.sha256 === \"string\" && /^[a-f0-9]{64}$/.test(value.sha256) &&\n    Number.isSafeInteger(value.offset) && value.offset >= 0 &&\n    Number.isSafeInteger(value.bytes) && value.bytes >= 1 &&\n    Number.isSafeInteger(value.count) && value.count >= 0);\n}\n\nfunction validStateConversation(data: any, taskRecord: boolean): boolean {\n  if (!data || typeof data !== \"object\" || Array.isArray(data)) return false;\n  if (data.schemaVersion === 2) {\n    return typeof data.taskId === \"string\" && data.taskId.length > 0 &&\n      !Object.hasOwn(data, \"messages\") &&\n      (data.messageLog === null || validMessageCursor(data.messageLog));\n  }\n  const identity = taskRecord ? data.taskId || data.id : data.sessionId || data.taskId || data.id;\n  return Boolean(identity) && Array.isArray(data.messages);\n}\n\nconst stateIntegrityCheck: Check = async (ctx, signal) => {\n  const dirs = [path.join(ctx.home, \".nexus\", \"sessions\"), path.join(ctx.home, \".nexus\", \"tasks\")];\n  let checked = 0;\n  const corrupt: string[] = [];\n  const temps: string[] = [];\n  const unreadable: string[] = [];\n  const limit = ctx.deep ? 5000 : 300;\n  for (const dir of dirs) {\n    if (signal.aborted) break;\n    let files: RecentStateFile[];\n    try {\n      files = await newestStateFiles(dir, limit, signal, temps);\n    } catch (error: any) {\n      if (signal.aborted) break;\n      // A missing store is simply empty; a store that exists but cannot be opened is not evidence of\n      // health and must not be reported as \"no saved state\".\n      if (error?.code !== \"ENOENT\") unreadable.push(dir);\n      continue;\n    }\n    for (const { name } of files) {\n      if (signal.aborted) break;\n      const full = path.join(dir, name);\n      checked++;\n      try {\n        const text = await fs.promises.readFile(full, { encoding: \"utf8\", signal });\n        if (signal.aborted) break;\n        const data = JSON.parse(text);\n        if (!validStateConversation(data, path.basename(dir) === \"tasks\")) corrupt.push(full);\n      } catch (error: any) {\n        if (signal.aborted || error?.name === \"AbortError\") break;\n        corrupt.push(full);\n      }\n    }\n  }\n  if (checked === 0 && temps.length === 0 && unreadable.length === 0) {\n    return f(\"state.integrity\", \"state\", \"pass\", \"No saved sessions or task state yet.\");\n  }\n  const evidence = [`${checked} record(s) checked${ctx.deep ? \" (newest 5000 per directory)\" : \" (newest 300 per directory; --deep checks up to 5000)\"}`];\n  const issues: string[] = [];\n  if (corrupt.length) issues.push(`${corrupt.length} saved record(s) are malformed and may not load`);\n  if (temps.length) issues.push(`${temps.length} recognized atomic-write temporary file(s) are present; a write may still be active, so doctor cannot determine whether they are stale`);\n  if (unreadable.length) issues.push(`${unreadable.length} state director${unreadable.length === 1 ? \"y\" : \"ies\"} could not be read, so doctor cannot determine whether the saved state is healthy`);\n  if (issues.length) {\n    return f(\"state.integrity\", \"state\", \"warn\", `${issues.join(\"; \")}.`, [...evidence, ...corrupt.slice(0, 5), ...unreadable, ...temps.slice(0, 3)], \"Inspect the listed paths and their permissions; doctor never deletes or repairs session or task files.\");\n  }\n  return f(\"state.integrity\", \"state\", \"pass\", \"Every checked session and task-state record parses and has an id plus valid conversation metadata.\", evidence);\n};\n\nconst credentialStoreCheck: Check = async (ctx) => {\n  const file = ctx.home === credentialStorageHome() ? credentialsPath() : path.join(ctx.home, \".config/nexus/credentials.json\");\n  if (!fs.existsSync(file)) return f(\"credentials.store\", \"state\", \"pass\", \"Nexus's own credential store is not in use (credentials come from the environment or other clients).\", [file]);\n  const mode = modeOf(file) ?? 0;\n  try {\n    JSON.parse(fs.readFileSync(file, \"utf8\"));\n  } catch {\n  }\n  const note = \"Plugin modules were listed, not loaded (loading runs their code).\";\n  if (risky.length) return f(\"plugins.config\", \"extensions\", \"warn\", `${risky.length} plugin problem(s): untrusted workspace plugins are not loaded; world-writable plugin files could be changed by anyone. ${note}`, [...risky, ...found.slice(0, 10)], \"Trust the workspace (`nexus trust`) or remove its plugins; restrict writable files with `chmod o-w <file>`.\");\n  return f(\"plugins.config\", \"extensions\", found.length ? \"pass\" : \"skip\", found.length ? `${found.length} plugin module(s) found. ${note}` : \"No plugins are installed (optional).\", found.slice(0, 10));\n};\n\nconst CHECKS: Array<[string, Check]> = [\n  [\"install\", installCheck],\n  [\"tui\", tuiCheck],\n  [\"runtime\", runtimeCheck],\n  [\"launcher\", launcherCheck],\n  [\"config\", configCheck],\n  [\"project_env_ignored\", projectEnvCheck],\n  [\"endpoint\", endpointChecks],\n  [\"inference\", inferenceCheck],\n  [\"shell\", shellCheck],\n  [\"engine\", engineCheck],\n  [\"workspace\", workspaceCheck],\n  [\"state\", stateDirCheck],\n  [\"permissions\", statePermissionsCheck],\n  [\"integrity\", stateIntegrityCheck],\n  [\"credentials\", credentialStoreCheck],\n  [\"config_env\", configEnvCheck],\n  [\"custom_ca\", customCaCheck],\n  [\"mcp\", mcpCheck],\n  [\"plugins\", pluginCheck],\n];\n\n/** Runs `check` with its own deadline; a throw or timeout becomes a finding, so other checks are unaffected. */\nasync function runCheck(name: string, check: Check, ctx: CheckContext, parent: AbortSignal): Promise<DoctorFinding[]> {\n  const started = Date.now();\n  const defaultLimit = name === \"inference\" ? ctx.timeoutMs * 6 + 1000 : name === \"endpoint\" ? ctx.timeoutMs * 2 + 1000 : ctx.timeoutMs + 1000;\n  // The default integrity scan gets more time for large, long-lived stores.\n  // An explicit --timeout remains authoritative for every check.\n  const limit = name === \"integrity\" && !ctx.timeoutOverride ? Math.max(defaultLimit, 30_000) : defaultLimit;\n  const controller = new AbortController();\n  const onAbort = () => controller.abort();\n  parent.addEventListener(\"abort\", onAbort, { once: true });\n  let onParentCancel: (() => void) | undefined;\n  let timer: NodeJS.Timeout | undefined;\n  try {\n    const result = await Promise.race([\n      check(ctx, controller.signal),\n      new Promise<\"timeout\">((resolve) => (timer = setTimeout(() => resolve(\"timeout\"), limit))),\n      new Promise<\"cancelled\">((resolve) => {\n        if (parent.aborted) {\n          resolve(\"cancelled\");\n        } else {\n          onParentCancel = () => resolve(\"cancelled\");\n          parent.addEventListener(\"abort\", onParentCancel, { once: true });\n        }\n9-\n10-They also follow from audit finding PER-03: the test suite writes into the real `~/.nexus`.\n11-\n12:## 1. Unit of work: one claimed PR slice per agent\n13-\n14-- The unit of concurrent work is **one PR slice** from a plan, for example `PLAN-01/PR-1a`. Every slice lists its tasks and its safe change boundary in its plan.\n15:- An agent works on exactly one claimed slice at a time.\n16-- An agent must not edit files outside its slice's boundary. The exceptions are the ledger rows and the shared files covered by §4. If the work needs a file outside the bound…142 tokens truncated…\"$AGENT_NAME\" \"v1/plan-01-pr-1a\" \"$(date -u +%FT%TZ)\" \"$$\" > \"$CLAIMS/$SLICE/owner.json\"\n29-else\n30:  echo \"claimed by: $(cat \"$CLAIMS/$SLICE/owner.json\")\"; exit 1\n31-fi\n32-```\n33-\n34:- **Release** the claim by deleting its directory (`rm -r \"$CLAIMS/$SLICE\"`) after the slice merges or is abandoned. Write one line about the outcome to `$CLAIMS/../nexus-claims.log`.\n35:- **Hot-file claims** use the same mechanism with the name `FILE_<path with / replaced by _>`, for example `FILE_cli_src_agent.ts`. See §4.\n36:- **Stale claims.** A claim older than 24 h whose PID is gone may be broken, but only by the owner, or by an agent that first records the broken claim in the log.\n37:- If the MCP Agent Mail server is available, its file reservations (`file_reservation_paths`) may be used as well. The git-common-dir claim stays authoritative, because every agent can see it without extra tooling.\n38-\n39-## 3. Isolation: worktree, branch, HOME, ports, processes\n40-\n41-| Resource | Rule |\n42-|---|---|\n43:| Source | One `git worktree` per claimed slice: `git worktree add ../nexus-wt/<slice> -b v1/<plan>-<slice> origin/main`. Never edit `~/nexus-code` itself. It is the owner's checkout, and `/usr/local/bin/nexus` runs from it. |\n44-| Branch | `v1/plan-NN-pr-Nx`. One branch per slice. Never commit to `main` directly. |\n45-| HOME and state | Until PLAN-08 PR-8a lands, every test, build and probe run sets `HOME=$(mktemp -d)` and `XDG_CONFIG_HOME=\"$HOME/.config\"`. After PR-8a, the test setup enforces this, but scripts and probes outside `npm test` must still set it. **Never** run anything that writes to the real `~/.nexus` or `~/.config/nexus`. |\n46-| Test runs | Full suites run on a **snapshot copy** of the worktree (`git worktree add` at the commit under test, or `git archive`), never on the tree being edited. `tsx` reads `src/` live. |\n47-| Builds | Each worktree builds into its own `core/target`, and `cli/dist` is per worktree. To share the Rust build cache, set `CARGO_TARGET_DIR` per worktree, never to one shared directory. |\n48-| Ports | Mock servers bind `127.0.0.1:0` (an ephemeral port) and publish the chosen port to a file. Fixed ports are forbidden. |\n49-| Processes | Kill only PIDs you started, taken from `$!` or `ps -eo pid,args \\| grep -v grep`. **Never `pkill -f` or `killall`.** Long background jobs are stopped through the agent's own task controls. |\n50:| Inference | There is one inference host (DEC-16). Any run that uses the gateway takes the claim `GATEWAY` first. That includes eval runs, live checks and stripped-proxy runs. One gateway run at a time, which keeps eval timings valid and prevents overload. Small cloud checks (E5) take `CLOUD` to avoid duplicate spend. |\n51-| Credentials | Agents never read or copy `~/.config/nexus/credentials.json`, `config.env` values, or gateway tokens. The stripped proxy reads the token file itself. |\n52-\n53-## 4. Hot files: serialise, do not merge blindly\n54-\n55:These files are touched by several plans. An agent editing one must hold its `FILE_` claim for the **shortest** period: edit, test, push, merge, then release.\n56-\n57-| File | Plans that touch it | Rule |\n58-|---|---|---|\n59:| `cli/src/agent.ts` | 01, 02, 03, 04, 05, 11 | Claim required. Keep each change local to the line ranges the plan names. Rebase immediately before merge and re-run that slice's tests on the rebased snapshot. |\n60:| `cli/src/index.ts` | 01, 03, 04, 06, 08, 10, 11 | Claim required. **PLAN-06 PR-6b (unified launcher) lands first.** Other plans add commands and flags afterwards. |\n61:| `cli/src/tools.ts` | 01, 02, 03, 06, 11 | Claim required. **PLAN-02 PR-2b (signal plumbing) lands before PLAN-03 PR-3c (`safeFetch`)**. |\n62:| `cli/src/sidecar.ts` | 01, 02, 03, 05, 08 | Claim required |\n63:| `cli/src/doctor.ts` | 01, 03, 05, 06, 08 | Claim required. Each plan adds **new check functions** in separate blocks. Only PLAN-06 PR-6d changes existing checks. |\n64:| `cli/src/client.ts` | 03, 05, 08, 11 | Claim required. **PLAN-03 PR-3a (env layering) lands before any PLAN-05 slice.** |\n65:| `cli/src/repl.ts` | 01, 05, 08 | Claim required |\n66:| `cli/src/config.ts`, `security.ts`, `sandbox.ts`, `mcp.ts`, `plugins.ts` | 01, 03 | Claim required. PLAN-01 PR-1e and PLAN-03 must not run at the same time on `sandbox.ts` or `security.ts`. |\n67-| `cli/src/core/capabilities.ts` | 01, 02 | **PLAN-01 PR-1a (effect classes) lands first.** PLAN-02 PR-2c adds schema fields afterwards. |\n68-| `cli/src/tester.ts` | 01, 11 | **PLAN-01 PR-1c lands before PLAN-11 PR-11b/11c.** |\n69-| `cli/src/core/state.ts` | 04, 08 | **PLAN-08 PR-8a (HOME isolation) lands before everything.** |\n70:| `core/src/runner.rs`, `core/src/main.rs` | 01, 02, 06 | Claim required. The protocol version number is owned by PLAN-02 PR-2a. PLAN-06 PR-6c only reads it. |\n71:| `core/src/bin/nexus_tui/{live_state,live_view}.rs` | 01, 02 | Claim required |\n72-| `package.json`, `cli/package.json`, `core/Cargo.toml`, lockfiles | 01, 06, 07, 08 | **Only one agent at a time.** Version fields are written only by `scripts/sync-version.mjs`. Dependency changes are separate commits that touch only the lockfile and manifest. |\n73:| `harness.sh`, `install.sh`, `scripts/package-linux.sh`, `.github/workflows/*` | 05, 06, 07, 09, C1 | Claim required. Workflow edits are separate commits. |\n74-| `cli/dist/**` | all, while tracked | Do not commit `cli/dist` from slices. PLAN-07 PR-7d untracks it (DEC-10). Until that merges, only the merging agent rebuilds and commits dist, in a final separate commit, after rebasing. |\n75:| `docs/USER_MANUAL.md`, `ARCHITECTURE.md`, `CLOUD_PROVIDERS.md`, `quickstart.md` | 05, 09 and doc tasks in every plan | Edit only the sections your slice changes. Hold a short `FILE_` claim. |\n76-\n77-### Ledger updates (`docs/v1.0.0/REQUIREMENTS.md`)\n78-\n--\n82-\n83-1. Before **every** commit, compare `git rev-parse HEAD` with the commit you last made. Then run `git log <yours>..HEAD` on the branch. If anything foreign appears, stop and reconcile. Never commit generated artifacts (evidence, dist, lockfiles) over a branch that moved (lessons 2026-10-13).\n84-2. Commits are scoped to the slice. Do not reformat or clean up files outside the boundary.\n85:3. Merge order follows the precedence rules in §4 and the ROADMAP milestone order. Within a milestone, the slice with fewer hot-file claims merges first.\n86-4. Rebase onto `origin/main` immediately before merging. Re-run the slice's targeted tests, plus `make test`, on a snapshot of the rebased commit. Merge only if both pass.\n87-5. Pushing, tagging, publishing and changing GitHub state (issues, milestones, releases) are **owner-approved actions** (DECISIONS X-list). Agents prepare them and do not perform them.\n88-6. Preserve unrelated user work: the untracked `nexus-continuity-validation/`, the stashes, and any dirty files you did not create. Never stash, reset, clean or check out over them.\n--\n91-\n92-| Record | Where | Purpose |\n93-|---|---|---|\n94:| Claims | `$(git rev-parse --git-common-dir)/nexus-claims/` | Who owns which slice or file right now |\n95:| Claim log | `$(git rev-parse --git-common-dir)/nexus-claims.log` (append-only, one line per event) | Claim, release, broken claim, boundary request |\n96:| Boundary requests and discovered requirements | The PR description, under the heading `Needs from other slices`. Mirrored as one line in the claim log. | So the owning slice's agent can pick it up. Never fixed silently out of scope. |\n97-| Slice evidence | `docs/reviews/evidence/v1/<plan>-<slice>/` (new directory per slice) | No shared evidence files, so agents cannot overwrite each other's evidence |\n98-\n99-## 7. Safe parallel lanes\n100-\n101:The following groupings can run at the same time with no hot-file contention beyond §4 claims. They are listed by milestone.\n102-\n103-| Phase | Parallel lanes |\n104-|---|---|\n--\n106-| M1 | (a) PLAN-01 PR-1a → PR-1b → PR-1c (sequential, owns `capabilities.ts`, `agent.ts` dispatch). (b) PLAN-02 PR-2a (Rust only). (c) PLAN-03 PR-3a → PR-3b (config/egress). (d) PLAN-11 PR-11a (`parser.ts`) and PR-11b (`tester.ts`, after PR-1c). Lanes (b), (c) and (d) do not touch `capabilities.ts`. |\n107-| M2 (alongside M1) | (a) PLAN-07 PR-7a/7b/7c (workflows, scripts). (b) PLAN-06 PR-6b after PLAN-01 PR-1b (shares `index.ts` flags). |\n108-| M3 | (a) PLAN-04 (`agent.ts` turn, operation runner). (b) PLAN-05 (`client.ts`, provider modules). (c) PLAN-10 harness (`eval/`, no product files). (d) Held-out task authoring by the agent author, **outside the repository**: no access to Nexus source or the development set (DEC-05). |\n109:| M4 (alongside M3) | PLAN-08 PR-8b..8e. Coordinate with PLAN-04 on `state.ts` through `FILE_` claims. |\n110:| M5 | **Serial on `GATEWAY`.** The eval runner, the stripped-proxy runs and the independent reviewer's live task each take the `GATEWAY` claim. The terminal matrix (E3) and the install matrix (E2) can run in parallel with gateway runs. |\n111-\n112-## 8. Independence constraints\n113-\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18669-d27e-75d2-996e-5705cd6cc03e","create_time":1793256582.878715}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
