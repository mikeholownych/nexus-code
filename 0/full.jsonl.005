{"timestamp":"2026-10-29T06:39:23.736Z","ordinal":496072,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18651-eaeb-77d3-9068-c0816219322f","item":{"type":"CommandExecution","id":"exec-49c27f6a-202b-4150-89b5-03fb28b34a77","process_id":"76110","command":["/usr/bin/zsh","-lc","git grep -n 'runProviderCli\\|provider_cli\\|providerConnect\\|setup.*provider' origin/main -- cli/src | head -100; git show origin/main:cli/src/provider_cli.ts | sed -n '250,340p'; git show origin/main:cli/src/provider_connect.ts | sed -n '80,190p'; git show origin/main:cli/src/slash/commands.ts 2>/dev/null | rg -n 'connect|provider|model' | head -40"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git grep -n 'runProviderCli\\|provider_cli\\|providerConnect\\|setup.*provider' origin/main -- cli/src | head -100; git show origin/main:cli/src/provider_cli.ts | sed -n '250,340p'; git show origin/main:cli/src/provider_connect.ts | sed -n '80,190p'; git show origin/main:cli/src/slash/commands.ts 2>/dev/null | rg -n 'connect|provider|model' | head -40"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"origin/main:cli/src/index.ts:25:import { describeTarget, registerProviderCommands } from \"./provider_cli.js\";\norigin/main:cli/src/protocol.ts:178:  /** Clear a completed local endpoint setup associated with this exact provider.connect request. */\norigin/main:cli/src/sidecar.ts:213:        void this.providerConnect(command.id, command.provider, command.method, command.key, command.endpoint);\norigin/main:cli/src/sidecar.ts:259:  private async providerConnect(id: string, provider: string, method: string, key?: string, endpoint?: string): Promise<void> {\n    for await (const chunk of process.stdin) data += chunk;\n    return data.trim();\n  }\n  const readline = await import(\"node:readline\");\n  const rl = readline.createInterface({ input: process.stdin, output: process.stdout, terminal: true });\n  let muted = false;\n  (rl as any)._writeToOutput = (text: string) => { if (!muted || text.includes(\"\\n\")) process.stdout.write(muted ? \"\\n\" : text); };\n  return new Promise((resolve) => {\n    rl.question(prompt, (answer) => { rl.close(); resolve(answer.trim()); });\n    muted = true;\n  });\n}\n\nasync function readText(prompt: string): Promise<string> {\n  const readline = await import(\"node:readline/promises\");\n  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });\n  try {\n    return (await rl.question(prompt)).trim();\n  } finally {\n    rl.close();\n  }\n}\n\nexport interface ProviderCliPrompts {\n  text(prompt: string): Promise<string>;\n  secret(prompt: string): Promise<string>;\n}\n\nexport function registerProviderCommands(program: Command, prompts?: ProviderCliPrompts): void {\n  const askText = prompts?.text ?? readText;\n  const askSecret = REDACTED ?? readSecret;\n  program\n    .command(\"connect\")\n    .description(\"Connect a cloud provider or configure a local OpenAI-compatible endpoint\")\n    .argument(\"<provider>\", \"local, openrouter, openai, anthropic, chatgpt, copilot, compatible\")\n    .option(\"--method <id>\", \"api-key (default where offered), openrouter-oauth, chatgpt-oauth, copilot-device\")\n    .action(async (providerId: string, options: any) => {\n      if (providerId === \"local\" || providerId === \"appliance\") {\n        if (!prompts && !process.stdin.isTTY) {\n          console.error(pc.red(\"Local endpoint setup requires an interactive terminal.\"));\n          process.exitCode = 2;\n          return;\n        }\n        let base: HarnessConfig;\n        try {\n          base = buildConfig({ appliance: true });\n        } catch {\n          console.error(pc.red(\"Could not read the current local endpoint configuration.\"));\n          process.exitCode = 2;\n          return;\n        }\n        const endpointDisplay = safeOriginOf(base.endpoint) ?? \"endpoint unavailable\";\n        const endpoint = await askText(`OpenAI-compatible endpoint URL [${endpointDisplay}]: `) || base.endpoint;\n        const key = await askSecret(\"Optional endpoint API key (press Enter for none): \");\n        const discovered = await connectLocalEndpoint(base, endpoint, undefined, key);\n        if (discovered.models.length === 0) {\n          console.error(pc.red(discovered.message));\n          process.exitCode = 1;\n          return;\n        }\n        console.log(pc.bold(\"\\nAvailable models\"));\n        discovered.models.forEach((model, index) => console.log(`  ${index + 1}. ${model}`));\n        const selection = await askText(\"Choose a model by number or id: \");\n        const model = /^\\d+$/.test(selection) ? discovered.models[Number(selection) - 1] : selection;\n        if (!model || !discovered.models.includes(model)) {\n          console.error(pc.red(\"Choose one of the listed models; no settings were saved.\"));\n          process.exitCode = 2;\n          return;\n        }\n        const result = await connectLocalEndpoint(base, endpoint, model, key);\n        console.log(result.ok ? pc.green(result.message) : pc.red(result.message));\n        process.exitCode = result.ok ? 0 : 1;\n        return;\n      }\n      const def = PROVIDERS[providerId];\n      if (!def) {\n        console.error(pc.red(`Unknown provider '${providerId}'. Known: ${Object.keys(PROVIDERS).join(\", \")}`));\n        process.exit(2);\n      }\n      const method = def.methods.find((m) => m.id === (options.method ?? def.methods[0].id));\n      if (!method) {\n        console.error(pc.red(`${def.label} methods: ${def.methods.map((m) => m.id).join(\", \")}`));\n        process.exit(2);\n      }\n      const base = buildConfig({});\n      const existing = resolveCredential(def.id, def.credentialEnv);\n      if (existing) console.log(pc.dim(`${def.label} is already connected via ${existing.source}; a new connection is saved in Nexus.`));\n      if (method.unofficial) console.log(pc.yellow(`${method.label}: unofficial — it signs in as another vendor's client, which the provider's terms may not permit.`));\n      if (method.kind === \"key\") {\n        const r = await connectWithKey(base, def.id, await askSecret(`${def.label} API key: `));\n        console.log(r.ok ? pc.green(r.message) : pc.red(r.message));\n  if (provisionalLocalEndpointRequestId) clearLocalEndpointSetup(provisionalLocalEndpointRequestId);\n}\n\nfunction validatedEndpoint(input: string): { endpoint: string; origin: string } | undefined {\n  const endpoint = input.trim().replace(/\\/+$/, \"\");\n  try {\n    const url = new URL(endpoint);\n    if ((url.protocol !== \"http:\" && url.protocol !== \"https:\") || url.username || url.password || url.search || url.hash || /[\\r\\n\\0]/.test(endpoint)) return undefined;\n    return { endpoint, origin: url.origin };\n  } catch {\n    return undefined;\n  }\n}\n\nfunction localEndpointConfig(base: HarnessConfig, endpoint: string, origin: string, key: string): HarnessConfig {\n  return {\n    ...base,\n    provider: undefined,\n    endpoint,\n    model: \"local-model\",\n    ...(key ? { apiKey: key, credentialOrigin: origin } : { apiKey: undefined, credentialOrigin: undefined }),\n    pinEndpoint: true,\n    fallbackEndpoints: undefined,\n    authorizedDisclosureOrigins: [...new Set([...(base.authorizedDisclosureOrigins ?? []), origin])],\n  };\n}\n\nfunction validatedKey(input: string): string | undefined {\n  const key = input.trim();\n  return /[\\r\\n\\0]/.test(key) || (key && /\\s/.test(key)) ? undefined : key;\n}\n\n/** Verify a local endpoint and keep its endpoint and optional key provisional for the live model picker. */\nexport async function prepareLocalEndpoint(base: HarnessConfig, endpointInput: string, keyInput = \"\", requestId?: string): Promise<LocalEndpointPreparation> {\n  const parsed = validatedEndpoint(endpointInput);\n  if (!parsed) return { ok: false, message: \"Use an http:// or https:// endpoint without embedded credentials, query, or fragment.\" };\n  const key = validatedKey(keyInput);\n  if (key === undefined) return { ok: false, message: \"The API key must be a single value without whitespace.\" };\n  const request = { cancelled: false };\n  if (requestId) localEndpointSetupRequests.set(requestId, request);\n  try {\n    const models = await new LocalLlmClient(localEndpointConfig(base, parsed.endpoint, parsed.origin, key), { allowCredentialReload: false }).listModels();\n    if (request.cancelled) return { ok: false, cancelled: true, message: \"Local endpoint setup was cancelled.\" };\n    const available = models.filter((model) => chatModel(APPLIANCE, model) && /^[A-Za-z0-9._:/@+-]{1,160}$/.test(model));\n    if (available.length === 0) return { ok: false, message: \"That endpoint returned no usable chat models.\" };\n    activateApplianceEndpoint(parsed.endpoint, undefined, true, key || undefined);\n    provisionalLocalEndpointRequestId = requestId;\n    const disclosure = disclosureClass(parsed.endpoint, undefined, base.cloudRoutedOrigins);\n    return {\n      ok: true,\n      message: disclosure === \"cloud\"\n        ? `Cloud endpoint verified (${available.length} models found). Choosing a model will send task content to this endpoint.`\n        : `Local endpoint verified (${available.length} models found). Choose a model to save setup.`,\n    };\n  } catch {\n    if (request.cancelled) return { ok: false, cancelled: true, message: \"Local endpoint setup was cancelled.\" };\n    return { ok: false, message: \"Could not list models from that endpoint. Check the URL and API key, then try again.\" };\n  } finally {\n    if (requestId && localEndpointSetupRequests.get(requestId) === request) localEndpointSetupRequests.delete(requestId);\n  }\n}\n\n/** Discover a local OpenAI-compatible endpoint, then persist only its selected URL/model and origin-scoped key. */\nexport async function connectLocalEndpoint(\n  base: HarnessConfig,\n  endpointInput: string,\n  modelInput?: string,\n  keyInput = \"\",\n): Promise<LocalEndpointConnection> {\n  const parsed = validatedEndpoint(endpointInput);\n  if (!parsed) {\n    return { ok: false, message: \"Use an http:// or https:// endpoint without embedded credentials, query, or fragment.\", models: [] };\n  }\n  const { endpoint, origin } = parsed;\n  const key = validatedKey(keyInput);\n  if (key === undefined) {\n    return { ok: false, message: \"The API key must be a single value without whitespace.\", models: [] };\n  }\n  const config = localEndpointConfig(base, endpoint, origin, key);\n  let models: string[];\n  try {\n    models = await new LocalLlmClient(config, { allowCredentialReload: false }).listModels();\n  } catch {\n    return { ok: false, message: \"Could not list models from that endpoint. Check the URL and API key, then try again.\", models: [] };\n  }\n  const available = models.filter((model) => chatModel(APPLIANCE, model) && /^[A-Za-z0-9._:/@+-]{1,160}$/.test(model));\n  if (!modelInput?.trim()) {\n    return { ok: available.length > 0, message: available.length > 0 ? \"Model discovery succeeded.\" : \"That endpoint returned no usable chat models.\", models: available };\n  }\n  const model = modelInput.trim();\n  if (!available.includes(model)) {\n    return { ok: false, message: \"Choose a model returned by the endpoint's model list.\", models: available };\n  }\n  try {\n    if (key) {\n      if (!commitLocalEndpointSetup(endpoint, key, () => saveLocalEndpointSettings(endpoint, model))) {\n        return { ok: false, message: \"Nexus could not securely save the endpoint setup.\", models: available };\n      }\n    } else {\n      saveLocalEndpointSettings(endpoint, model);\n    }\n  } catch {\n    return { ok: false, message: \"Models were discovered, but Nexus could not securely save the endpoint setup.\", models: available };\n  }\n  activateApplianceEndpoint(endpoint, model, false);\n  provisionalLocalEndpointRequestId = undefined;\n  const disclosure = disclosureClass(endpoint, undefined, base.cloudRoutedOrigins);\n  return {\n    ok: true,\n    message: `${disclosure === \"cloud\" ? \"Cloud\" : \"Local\"} endpoint configured (${available.length} models available).${key ? \" API key saved for this origin only.\" : \" No API key was saved.\"}`,\n    models: available,\n","exit_code":0,"duration":{"secs":0,"nanos":32920}},"started_at_ms":1793255963735,"completed_at_ms":1793255963736}}
