uest.clone(), provider, method, key: Some(secret), endpoint: Some(endpoint) }).contains(\"local-secret\"));\n  4072\t        state.apply(ev(&format!(r#\"{{\"v\":1,\"type\":\"provider.result\",\"id\":\"{request}\",\"provider\":\"appliance\",\"success\":true,\"message\":\"Local endpoint ready (127.0.0.1; 2 models found). Choose a model to finish setup.\"}}\"#)));\n  4073\t        assert!(matches!(&state.overlay, Some(Overlay::Models(p)) if p.only.as_deref() == Some(\"appliance\")));\n  4074\t        assert!(matches!(state.take_outbox().as_slice(), [Action::Send(Command::ModelsList { .. })]));\n  4075\t    }\n  4076\t\n  4077\t    #[test]\n  4078\t    fn escaping_pending_local_endpoint_discovery_sends_matching_cancel_and_ignores_late_success() {\n  4079\t        let mut state = ready();\n  4080\t        type_text(&mut state, \"/connect\");\n","exit_code":0,"duration":{"secs":0,"nanos":34603}},"started_at_ms":1793258732285,"completed_at_ms":1793258732286}}
