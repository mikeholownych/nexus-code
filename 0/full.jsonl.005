-release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\",\"number\":17,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Install pinned security and SBOM test tools\",\"number\":18,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run npm --prefix cli test\",\"number\":19,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":36,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":37,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":38,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40876834519/job/123457701879\"}],\"status\":\"in_progress\",\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40876834519\"}\n{\"conclusion\":\"\",\"headSha\":\"2703a7631778cec71dfbf1c8d3a492fed315a5ab\",\"status\":\"in_progress\",\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40876834602\"}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18771-cd08-7c60-9b2e-7bad123756d6","create_time":1793278363.7128112}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
