{"timestamp":"2026-10-29T07:23:12.996Z","ordinal":498006,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18686-7f9d-7a01-aaee-252d4871c34f","item":{"type":"McpToolCall","id":"exec-9acb68f4-7c7c-4334-86e3-79b8ca59f327","server":"xerj","tool":"xerj_search","arguments":{"prefix":"nexus-cli","query":"TUI ctrl+p provider connect provider methods chooser dialog","size":8},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /nexus-cli-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"TUI ctrl+p provider connect methods chooser dialog\",\"k\":10}}}}}]},\"took\":1002,\"timed_out\":false,\"_shards\":{\"total\":1,\"successful\":1,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":118,\"relation\":\"eq\"},\"max_score\":61.987915,\"hits\":[{\"_index\":\"nexus-cli-docs\",\"_id\":\"9a4b800e6defcf417cc7e9cb12c94935\",\"_score\":61.987915,\"_source\":{\"title\":\"providers.ts\",\"ax_path\":\"providers.ts\",\"ax_file\":\"axf2-22ffaa0486a3f878e50dc82fdd7b622c-1fc0\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":15,\"start_offset\":1012,\"end_offset\":3038,\"text\":\"\\n/** How an operator can connect a provider from the TUI or `nexus connect`. */\\nexport interface ConnectMethod {\\n  id: string;\\n  label: string;\\n  kind: \\\"key\\\" | \\\"browser\\\" | \\\"device\\\";\\n  /** Uses another vendor's client identity; the providers' terms may not permit it. */\\n  unofficial?: boolean;\\n}\\n\\nexport interface ProviderDefinition {\\n  id: string;\\n  label: string;\\n  protocol: WireProtocol;\\n  /** Includes the provider's API path and version; nothing is appended except the operation path. */\\n  baseUrl?: string;\\n  /** Environment variable holding this provider's key (none for sign-in-only providers). Sent only to the connection's own origin. */\\n  credentialEnv?: string;\\n  methods: ConnectMethod[];\\n  /** The backend accepts streamed requests only; non-streaming calls are streamed internally. */\\n  streamOnly?: boolean;\\n  /** Request parameters this backend rejects for every model; never sent. */\\n  omitParams?: string[];\\n  auth: AuthStyle;\\n  /** Headers this provider requires on every request. */\\n  staticHeaders?: Record<string, string>;\\n  /** Ask the provider to report usage (and, where offered, cost) on streamed responses. */\\n  usage: \\\"openrouter\\\" | \\\"stream-options\\\" | \\\"native\\\";\\n}\\n\\nexport const PROVIDERS: Readonly<Record<string, ProviderDefinition>> = Object.freeze({\\n  openrouter: {\\n    id: \\\"openrouter\\\",\\n    label: \\\"OpenRouter\\\",\\n    protocol: \\\"openai-chat\\\",\\n    baseUrl: \\\"https://openrouter.ai/api/v1\\\",\\n    credentialEnv: \\\"OPENROUTER_API_KEY\\\",\\n    auth: \\\"bearer\\\",\\n    staticHeaders: { \\\"X-Title\\\": \\\"Nexus\\\" },\\n    usage: \\\"openrouter\\\",\\n    methods: [\\n      { id: \\\"api-key\\\", label: \\\"API key\\\", kind: \\\"key\\\" },\\n      { id: \\\"openrouter-oauth\\\", label: \\\"Sign in with OpenRouter\\\", kind: \\\"browser\\\" },\\n    ],\\n  },\\n  openai: {\\n    id: \\\"openai\\\",\\n    label: \\\"OpenAI\\\",\\n    protocol: \\\"openai-responses\\\",\\n    baseUrl: \\\"https://api.openai.com/v1\\\",\\n    credentialEnv: \\\"OPENAI_API_KEY\\\",\\n    auth: \\\"bearer\\\",\\n    usage: \\\"native\\\",\\n    methods: [{ id: \\\"api-key\\\", label: \\\"API key\\\", kind: \\\"key\\\" }],\\n  },\\n  anthropic: {\\n    id: \\\"anthropic\\\",\"}]},\"match_line\":17,\"match_lines\":[17,30,32,34,40,42,56,69]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"c7c37832e930a9205bd08656efda58ef\",\"_score\":48.546703,\"_source\":{\"title\":\"mcp.ts\",\"ax_path\":\"mcp.ts\",\"ax_file\":\"axf2-f8967771815840f644c8e73b80efde5b-86d8\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":541,\"start_offset\":16363,\"end_offset\":17301,\"text\":\"public async loadAndConnect(): Promise<void> {\\n    this.shutdownAll();\\n\\n    for (const file of mcpConfigFiles(this.workspace, this.trusted, this.readOnly)) {\\n      if (fs.existsSync(file)) {\\n        try {\\n          const content = fs.readFileSync(file, \\\"utf-8\\\");\\n          const config = JSON.parse(content) as McpConfigFile;\\n          if (config.mcpServers && typeof config.mcpServers === \\\"object\\\") {\\n            for (const [name, serverCfg] of Object.entries(config.mcpServers)) {\\n              if ((serverCfg.command || serverCfg.url) && !this.connections.has(name)) {\\n                const conn = new McpConnection(name, serverCfg);\\n                const ok = await conn.connect();\\n                if (ok) {\\n                  this.connections.set(name, conn);\\n                }\\n              }\\n            }\\n          }\\n        } catch {\\n          // Ignore invalid JSON configs\\n        }\\n      }\\n    }\\n\\n    this.rebuildToolMap();\\n  }\"}]},\"match_line\":554,\"match_lines\":[554]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"7dca3b6530ab467e3c984d24dbe9fa7b\",\"_score\":41.435333,\"_source\":{\"title\":\"client.ts\",\"ax_path\":\"client.ts\",\"ax_file\":\"axf2-33f9bd7d6b5dee989d474b71676aaa45-17404\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":861,\"start_offset\":41089,\"end_offset\":42901,\"text\":\"private async prepareCredential(url: string, requestId?: string, force = false): Promise<void> {\\n    if (this.conn.auth !== \\\"oauth\\\" || !this.conn.providerId) return;\\n    const id = this.conn.providerId;\\n    const label = providerDefinition(id)?.label ?? id;\\n    const found = resolveCredential(id);\\n    const fail = (message: string) =>\\n      new InferenceError(\\\"configuration_error\\\", \\\"client\\\", message, { requestId, failoverEligible: false, condition: \\\"AUTH_FAILURE\\\" });\\n    if (!found || found.credential.type !== \\\"oauth\\\") {\\n      this.explicitKey = undefined;\\n      return; // preflight reports the missing sign-in\\n    }\\n    let cred: OAuthCredential = found.credential;\\n    const fresh = (c?: OAuthCredential) => Boolean(c?.access) && (c!.expiresAt === undefined || c!.expiresAt - Date.now() > 60_000);\\n    if (!fresh(cred) || force) {\\n      try {\\n        if (found.refreshable) {\\n          cred = (await refreshOAuth(id, cred)) as OAuthCredential;\\n          saveCredential(id, cred);\\n        } else if (id === \\\"copilot\\\" && cred.refresh) {\\n          if (force || !fresh(this.exchangedToken) || this.exchangedToken?.refresh !== cred.refresh) {\\n            this.exchangedToken = REDACTED copilotToken(cred.refresh)) as OAuthCredential;\\n          }\\n          cred = this.exchangedToken!;\\n        } else if (!fresh(cred)) {\\n          throw new Error(`the ${label} sign-in read from ${found.source} has expired. Use ${found.source} once to refresh it, or sign in from Nexus (/model, then ctrl+p).`);\\n        }\\n      } catch (err: any) {\\n        throw fail(`Cannot use ${label}: ${redactSecrets(err?.message ?? String(err))}`);\\n      }\\n    }\\n    this.explicitKey = cred.access;\\n    this.explicitOrigin = originOf(url);\\n    this.rotated.delete(this.explicitOrigin ?? \\\"\\\");\\n    this.oauthAccountId = cred.accountId;\\n  }\"}]},\"match_line\":886,\"match_lines\":[886]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"ae033d65725b1664ef636dd609cc7d41\",\"_score\":35.728653,\"_source\":{\"title\":\"repl.ts\",\"ax_path\":\"repl.ts\",\"ax_file\":\"axf2-9781cd8156a2afcaea2488902ce27ee5-16f4b\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":24,\"start_offset\":1111,\"end_offset\":3150,\"text\":\"import { PolicyContext } from \\\"./core/approval_policy.js\\\";\\nimport { runTestSuiteWithExecutor, discoverVerifier, describeVerifier, verifierTimeoutSecs } from \\\"./tester.js\\\";\\nimport { copyToClipboard, readFromClipboard } from \\\"./clipboard.js\\\";\\nimport { encodeImageFile, formatVisionContent } from \\\"./image.js\\\";\\nimport { ThemeManager } from \\\"./theme.js\\\";\\nimport { TeamOrchestrator, AgentRole, TEAM_ROLES } from \\\"./team.js\\\";\\nimport { TerminalDashboard } from \\\"./tui.js\\\";\\nimport { HunkStager } from \\\"./stager.js\\\";\\nimport { TurnResult, lifecycleStatusForTurn } from \\\"./core/turn.js\\\";\\nimport { buildSessionExport } from \\\"./session_export.js\\\";\\nimport { SensitivePersistenceError } from \\\"./core/persistence_protection.js\\\";\\nimport { safeTerminal } from \\\"./ui.js\\\";\\n\\ninterface PatchHunk {\\n  header: string;\\n  lines: string[];\\n}\\n\\nfunction parsePatchHunks(patch: string): { fileHeader: string; hunks: PatchHunk[] } {\\n  const lines = patch.split(\\\"\\\\n\\\");\\n  const fileHeaderLines: string[] = [];\\n  const hunks: PatchHunk[] = [];\\n  let currentHunk: PatchHunk | null = null;\\n\\n  for (const line of lines) {\\n    if (line.startsWith(\\\"@@\\\")) {\\n      if (currentHunk) {\\n        hunks.push(currentHunk);\\n      }\\n      currentHunk = { header: line, lines: [] };\\n    } else if (currentHunk) {\\n      currentHunk.lines.push(line);\\n    } else {\\n      fileHeaderLines.push(line);\\n    }\\n  }\\n  if (currentHunk) {\\n    hunks.push(currentHunk);\\n  }\\n\\n  return { fileHeader: fileHeaderLines.join(\\\"\\\\n\\\"), hunks };\\n}\\n\\nexport const REPL_APPROVAL_GRACE_MS = 400;\\n\\n/**\\n * Slash commands a read-only REPL may run: an explicit --read-only launch, or a session whose effective mode is\\n * read-only (mode-selected). Kept deliberately conservative: writes, provider/model changes, scaffolding, test\\n * execution, upgrades and state mutations are refused; inspection and the mode command remain available. In an\\n * explicit --read-only launch the mode command cannot lower the agent's authority; a mode-selected session can\\n * leave read-only deliberately with /mode auto or /mode review.\\n */\"}]},\"match_line\":31,\"match_lines\":[31,72]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"62e37b6f560b30e21650caa28cb3a7da\",\"_score\":33.187767,\"_source\":{\"title\":\"sidecar.ts\",\"ax_path\":\"sidecar.ts\",\"ax_file\":\"axf2-c0aedef0039a7e38a28691f239e15d3b-d8f2\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":1067,\"start_offset\":49349,\"end_offset\":54951,\"text\":\"async function main(argv: string[]): Promise<void> {\\n  const protocolWrite = process.stdout.write.bind(process.stdout);\\n  const debug = process.env.NEXUS_DEBUG === \\\"1\\\";\\n  const toStderr = (...args: unknown[]): void => {\\n    if (debug) process.stderr.write(args.map((a) => (typeof a === \\\"string\\\" ? a : JSON.stringify(a))).join(\\\" \\\") + \\\"\\\\n\\\");\\n  };\\n\\n  const program = new Command()\\n    .name(\\\"nexus-sidecar\\\")\\n    .option(\\\"-e, --endpoint <url>\\\", \\\"Local LLM endpoint\\\")\\n    .option(\\\"-m, --model <name>\\\", \\\"Model name\\\")\\n    .option(\\\"-w, --workspace <path>\\\", \\\"Workspace directory\\\")\\n    .option(\\\"-s, --max-steps <number>\\\", \\\"Steps per segment (continuation checkpoints there instead of stopping)\\\")\\n    .option(\\\"--max-total-steps <number>\\\", \\\"Continuation: an explicit total-step limit for one turn (default: none; progressing work continues)\\\")\\n    .option(\\\"--strict-token-count\\\", \\\"Refuse a request the connection could not count on a worker (default: proceed on the labelled estimate)\\\")\\n    .option(\\\"--max-turn-minutes <number>\\\", \\\"Continuation: an explicit wall-clock limit for one turn in minutes (default: none)\\\")\\n    .option(\\\"--stagnation-steps <number>\\\", \\\"Continuation: stop after this many steps without progress (default 12)\\\")\\n    .option(\\\"--no-continuation\\\", \\\"End a turn at --max-steps instead of continuing while it makes progress\\\")\\n    .option(\\\"-t, --temperature <number>\\\", \\\"Model temperature\\\")\\n    .option(\\\"--shell <type>\\\", \\\"Shell for commands\\\", \\\"bash\\\")\\n    .option(\\\"--fallback <urls>\\\", \\\"Comma-separated fallback LLM endpoints\\\")\\n    .option(\\\"--context-limit <tokens>\\\", \\\"Model context window limit in tokens\\\")\\n    .option(\\\"--dry-run\\\", \\\"Simulate file modifications without writing changes to disk\\\")\\n    .option(\\\"--read-only\\\", \\\"Reject all mutating tool executions and commands\\\")\\n    .option(\\\"--sandbox [mode]\\\", \\\"Isolate command execution using bubblewrap or Docker\\\")\\n    .option(\\\"--worktree\\\", \\\"Isolate execution inside an ephemeral git worktree\\\")\\n    .option(\\\"--authoritative-verifier <command>\\\", \\\"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\\\")\\n    .option(\\\"--deliverable-file <path>\\\", \\\"Operator-declared workspace-relative product file used for VERIFIED binding (repeatable)\\\", (value: string, previous: string[] = []) => [...previous, value], [])\\n    .option(\\\"--record-flight\\\", \\\"Record execution into an append-only .flightlog\\\")\\n    .option(\\\"--planner-model <name>\\\", \\\"Deep reasoning model for planning\\\")\\n    .option(\\\"--planner-endpoint <url>\\\", \\\"Inference endpoint for the planner model\\\")\\n    .option(\\\"--coder-model <name>\\\", \\\"Model for code implementation\\\")\\n    .option(\\\"--coder-endpoint <url>\\\", \\\"Inference endpoint for the coder model\\\")\\n    .option(\\\"--approve\\\", \\\"Require operator approval before edits and shell commands\\\")\\n    .option(\\\"-y, --yes\\\", \\\"Run non-interactively without approval prompts (forces auto mode)\\\")\\n    .option(\\\"--mode <mode>\\\", \\\"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\\\")\\n    .option(\\\"-r, --resume [id]\\\", \\\"Resume a saved session (the latest when no id is given)\\\")\\n    .parse(argv);\\n\\n  // Commander help is ordinary CLI output, before protocol-only stdout\\n  // handling begins. Parsing help and metadata invocations is read-only: do\\n  // it before restore recovery, then hold a lifetime lease before any normal\\n  // startup state is read or used. The packaged TUI may launch this entry\\n  // point directly, without passing through index.ts.\\n  (process.stdout as any).write = (chunk: unknown, encoding?: unknown, cb?: unknown): boolean => {\\n    if (debug) process.stderr.write(typeof chunk === \\\"string\\\" ? chunk : Buffer.from(chunk as Uint8Array));\\n    const done = typeof encoding === \\\"function\\\" ? encoding : cb;\\n    if (typeof done === \\\"function\\\") (done as () => void)();\\n    return true;\\n  };\\n  console.log = toStderr;\\n  console.info = toStderr;\\n  console.warn = toStderr;\\n  console.debug = toStderr;\\n  const home = process.env.HOME || os.homedir();\\n  const { acquireClientLease, releaseClientLease } = await import(\\\"./core/client_lease.js\\\");\\n  const { hasPendingStateRestore, recoverPendingStateRestore } = await import(\\\"./core/state_restore.js\\\");\\n  if (hasPendingStateRestore(home) && !recoverPendingStateRestore(home)) {\\n    throw new Error(\\\"Pending state restore could not be recovered; no state was admitted\\\");\\n  }\\n  const lease = acquireClientLease(home);\\n  process.once(\\\"exit\\\", () => releaseClientLease(lease));\\n  loadEnvironment();\\n  const configLoadError = operatorConfigLoadError();\\n  if (configLoadError) throw new Error(`Configuration error: ${configLoadError.message}`);\\n  const options = program.opts();\\n  const config = await autoDetectModel(buildConfig(options));\\n  config.surface = \\\"tui\\\";\\n  const app = new ApplicationCore(config);\\n  const server = new SidecarServer({\\n    app,\\n    mode: config.approvalMode,\\n    resume: typeof options.resume === \\\"string\\\" ? options.resume : options.resume ? \\\"latest\\\" : undefined,\\n    write: (line) => {\\n      protocolWrite(line);\\n    },\\n    onShutdown: () => process.exit(0),\\n  });\\n\\n  const report = (err: unknown) => process.stderr.write(`nexus sidecar: ${err instanceof Error ? err.message : String(err)}\\\\n`);\\n  const input = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });\\n  input.on(\\\"line\\\", (line) => {\\n    server.handleLine(line).catch(report);\\n  });\\n  const requestShutdown = () => {\\n    server.handleLine(JSON.stringify({ v: PROTOCOL_VERSION, type: \\\"shutdown\\\" })).catch(report);\\n  };\\n  input.on(\\\"close\\\", requestShutdown);\\n  process.stdout.on(\\\"error\\\", requestShutdown);\\n  server.start();\\n}\"}]},\"match_line\":1110,\"match_lines\":[1110,1135]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"1431592c139321f077c6a66b9e6b52a1\",\"_score\":28.611847,\"_source\":{\"title\":\"agent.ts\",\"ax_path\":\"agent.ts\",\"ax_file\":\"axf2-6b3daf438676b559cd943bf2cac57e68-55672\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":800,\"start_offset\":40020,\"end_offset\":40494,\"text\":\"function triggerNotification(title: string, message: string, surface?: string) {\\n  // Desktop notification and BEL happen only when stdout is an interactive TTY and the surface is the REPL or TUI (REQ-AGT-109a).\\n  if (!process.stdout.isTTY) {\\n    return;\\n  }\\n  if (surface !== \\\"repl\\\" && surface !== \\\"tui\\\") {\\n    return;\\n  }\\n  try {\\n    process.stdout.write(\\\"\\\\x07\\\");\\n    execFile(\\\"notify-send\\\", [title, message], () => {});\\n  } catch {\\n    // Ignore notification errors\\n  }\\n}\"}]},\"match_line\":802,\"match_lines\":[802,806]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"6a8002bf2e2f84338f0792fdcc3fcbcb\",\"_score\":27.519344,\"_source\":{\"title\":\"provider_connect.ts\",\"ax_path\":\"provider_connect.ts\",\"ax_file\":\"axf2-28c85d94f04c5df9d59377738a40c90b-396b\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":239,\"start_offset\":11913,\"end_offset\":14698,\"text\":\"export function selectModel(agent: AutonomousAgent, config: HarnessConfig, ref: ModelRef): { ok: boolean; message: string } {\\n  const model = ref.model.trim();\\n  if (!model) return { ok: false, message: \\\"Choose a model.\\\" };\\n  if (ref.provider === APPLIANCE) {\\n    const a = applianceConfig(config);\\n    const pendingSelection = applianceEndpointSelection();\\n    if (pendingSelection?.persistModelOnSelection && originOf(a.endpoint) === originOf(pendingSelection.endpoint)) {\\n      try {\\n        const pendingKey = pendingApplianceEndpointKey(a.endpoint);\\n        if (pendingKey) {\\n          const committed = commitLocalEndpointSetup(a.endpoint, pendingKey, () => saveLocalEndpointSettings(a.endpoint, model));\\n          if (!committed) return { ok: false, message: \\\"The endpoint was verified, but Nexus could not securely save the API key.\\\" };\\n        } else {\\n          saveLocalEndpointSettings(a.endpoint, model);\\n        }\\n        activateApplianceEndpoint(a.endpoint, model, false);\\n        provisionalLocalEndpointRequestId = undefined;\\n      } catch {\\n        return { ok: false, message: \\\"The model is available for this session, but Nexus could not securely save the selection.\\\" };\\n      }\\n    }\\n    agent.setInferenceTarget({\\n      provider: undefined,\\n      endpoint: a.endpoint,\\n      model,\\n      apiKey: a.apiKey,\\n      credentialOrigin: a.credentialOrigin,\\n      authorizedDisclosureOrigins: [...new Set([...(config.authorizedDisclosureOrigins ?? []), ...(a.authorizedDisclosureOrigins ?? []), ...(originOf(a.endpoint) ? [originOf(a.endpoint)!] : [])])],\\n    });\\n    recordRecent({ provider: APPLIANCE, model });\\n    const disclosure = disclosureClass(a.endpoint, undefined, config.cloudRoutedOrigins);\\n    return {\\n      ok: true,\\n      message: disclosure === \\\"cloud\\\"\\n        ? `Model: ${model} via the configured endpoint. Task content will be sent there.`\\n        : `Model: ${model} on the local appliance.`,\\n    };\\n  }\\n  const def = providerDefinition(ref.provider);\\n  if (!def) return { ok: false, message: `Unknown provider '${ref.provider}'.` };\\n  if (!connectionOf(def.id).connected) return { ok: false, message: `${def.label} is not connected. Open /model and press ctrl+p to connect it.` };\\n  let cfg: HarnessConfig;\\n  try {\\n    cfg = providerConfig(config, def.id, model);\\n  } catch (err) {\\n    return { ok: false, message: describe(err) };\\n  }\\n  agent.setInferenceTarget({\\n    provider: def.id,\\n    endpoint: cfg.endpoint,\\n    model,\\n    apiKey: cfg.apiKey,\\n    credentialOrigin: cfg.credentialOrigin,\\n    authorizedDisclosureOrigins: cfg.authorizedDisclosureOrigins,\\n  });\\n  recordRecent({ provider: def.id, model });\\n  return { ok: true, message: `Model: ${model} via ${def.label} (${originOf(cfg.endpoint)}). Task content is sent to this provider.` };\\n}\"}]},\"match_line\":280,\"match_lines\":[243,262,269,278,279,280,288,295]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"fcaa9914baa4f09606d8657adae61987\",\"_score\":24.484322,\"_source\":{\"title\":\"provider_recovery.ts\",\"ax_path\":\"core/provider_recovery.ts\",\"ax_file\":\"axf2-fbca0da8180dbd5a003f9f24ac5911c9-58dd\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":284,\"start_offset\":13959,\"end_offset\":14181,\"text\":\"export interface RecoveryControllerOptions {\\n  /** False when the endpoint has never succeeded in this session; bounds waiting to `firstContactDeadlineMs` (REQ-TUI-105). */\\n  everSucceeded?: boolean;\\n  endpoint?: string;\\n}\"}]},\"match_line\":286,\"match_lines\":[286]}]}}"}],"isError":false},"duration":{"secs":1,"nanos":261278070}},"started_at_ms":1793258591734,"completed_at_ms":1793258592995}}
{"timestamp":"2026-10-29T07:23:15.666Z","ordinal":498007,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1868a-a552-7f70-8175-ebf0af51f0ec","call_id":"call_123779b38f474f53abd0938c9ae97e4b","output":[{"type":"input_text","text":"Script completed\nWall time 4.0 seconds\nOutput:\n"},{"type":"input_text","text":"{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"_xerj\\\":{\\\"hints\\\":[{\\\"code\\\":\\\"lexical_on_semantic_text\\\",\\\"reason\\\":\\\"`body` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\\\",\\\"try\\\":{\\\"request\\\":\\\"POST /nexus-cli-*/_search\\\",\\\"body\\\":{\\\"query\\\":{\\\"semantic\\\":{\\\"field\\\":\\\"body\\\",\\\"query\\\":\\\"TUI ctrl+p provider connect methods chooser dialog\\\",\\\"k\\\":10}}}}}]},\\\"took\\\":1002,\\\"timed_out\\\":false,\\\"_shards\\\":{\\\"total\\\":1,\\\"successful\\\":1,\\\"skipped\\\":0,\\\"failed\\\":0},\\\"hits\\\":{\\\"total\\\":{\\\"value\\\":118,\\\"relation\\\":\\\"eq\\\"},\\\"max_score\\\":61.987915,\\\"hits\\\":[{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"9a4b800e6defcf417cc7e9cb12c94935\\\",\\\"_score\\\":61.987915,\\\"_source\\\":{\\\"title\\\":\\\"providers.ts\\\",\\\"ax_path\\\":\\\"providers.ts\\\",\\\"ax_file\\\":\\\"axf2-22ffaa0486a3f878e50dc82fdd7b622c-1fc0\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":15,\\\"start_offset\\\":1012,\\\"end_offset\\\":3038,\\\"text\\\":\\\"\\\\n/** How an operator can connect a provider from the TUI or `nexus connect`. */\\\\nexport interface ConnectMethod {\\\\n  id: string;\\\\n  label: string;\\\\n  kind: \\\\\\\"key\\\\\\\" | \\\\\\\"browser\\\\\\\" | \\\\\\\"device\\\\\\\";\\\\n  /** Uses another vendor's client identity; the providers' terms may not permit it. */\\\\n  unofficial?: boolean;\\\\n}\\\\n\\\\nexport interface ProviderDefinition {\\\\n  id: string;\\\\n  label: string;\\\\n  protocol: WireProtocol;\\\\n  /** Includes the provider's API path and version; nothing is appended except the operation path. */\\\\n  baseUrl?: string;\\\\n  /** Environment variable holding this provider's key (none for sign-in-only providers). Sent only to the connection's own origin. */\\\\n  credentialEnv?: string;\\\\n  methods: ConnectMethod[];\\\\n  /** The backend accepts streamed requests only; non-streaming calls are streamed internally. */\\\\n  streamOnly?: boolean;\\\\n  /** Request parameters this backend rejects for every model; never sent. */\\\\n  omitParams?: string[];\\\\n  auth: AuthStyle;\\\\n  /** Headers this provider requires on every request. */\\\\n  staticHeaders?: Record<string, string>;\\\\n  /** Ask the provider to report usage (and, where offered, cost) on streamed responses. */\\\\n  usage: \\\\\\\"openrouter\\\\\\\" | \\\\\\\"stream-options\\\\\\\" | \\\\\\\"native\\\\\\\";\\\\n}\\\\n\\\\nexport const PROVIDERS: Readonly<Record<string, ProviderDefinition>> = Object.freeze({\\\\n  openrouter: {\\\\n    id: \\\\\\\"openrouter\\\\\\\",\\\\n    label: \\\\\\\"OpenRouter\\\\\\\",\\\\n    protocol: \\\\\\\"openai-chat\\\\\\\",\\\\n    baseUrl: \\\\\\\"https://openrouter.ai/api/v1\\\\\\\",\\\\n    credentialEnv: \\\\\\\"OPENROUTER_API_KEY\\\\\\\",\\\\n    auth: \\\\\\\"bearer\\\\\\\",\\\\n    staticHeaders: { \\\\\\\"X-Title\\\\\\\": \\\\\\\"Nexus\\\\\\\" },\\\\n    usage: \\\\\\\"openrouter\\\\\\\",\\\\n    methods: [\\\\n      { id: \\\\\\\"api-key\\\\\\\", label: \\\\\\\"API key\\\\\\\", kind: \\\\\\\"key\\\\\\\" },\\\\n      { id: \\\\\\\"openrouter-oauth\\\\\\\", label: \\\\\\\"Sign in with OpenRouter\\\\\\\", kind: \\\\\\\"browser\\\\\\\" },\\\\n    ],\\\\n  },\\\\n  openai: {\\\\n    id: \\\\\\\"openai\\\\\\\",\\\\n    label: \\\\\\\"OpenAI\\\\\\\",\\\\n    protocol: \\\\\\\"openai-responses\\\\\\\",\\\\n    baseUrl: \\\\\\\"https://api.openai.com/v1\\\\\\\",\\\\n    credentialEnv: \\\\\\\"OPENAI_API_KEY\\\\\\\",\\\\n    auth: \\\\\\\"bearer\\\\\\\",\\\\n    usage: \\\\\\\"native\\\\\\\",\\\\n    methods: [{ id: \\\\\\\"api-key\\\\\\\", label: \\\\\\\"API key\\\\\\\", kind: \\\\\\\"key\\\\\\\" }],\\\\n  },\\\\n  anthropic: {\\\\n    id: \\\\\\\"anthropic\\\\\\\",\\\"}]},\\\"match_line\\\":17,\\\"match_lines\\\":[17,30,32,34,40,42,56,69]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"c7c37832e930a9205bd08656efda58ef\\\",\\\"_score\\\":48.546703,\\\"_source\\\":{\\\"title\\\":\\\"mcp.ts\\\",\\\"ax_path\\\":\\\"mcp.ts\\\",\\\"ax_file\\\":\\\"axf2-f8967771815840f644c8e73b80efde5b-86d8\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":541,\\\"start_offset\\\":16363,\\\"end_offset\\\":17301,\\\"text\\\":\\\"public async loadAndConnect(): Promise<void> {\\\\n    this.shutdownAll();\\\\n\\\\n    for (const file of mcpConfigFiles(this.workspace, this.trusted, this.readOnly)) {\\\\n      if (fs.existsSync(file)) {\\\\n        try {\\\\n          const content = fs.readFileSync(file, \\\\\\\"utf-8\\\\\\\");\\\\n          const config = JSON.parse(content) as McpConfigFile;\\\\n          if (config.mcpServers && typeof config.mcpServers === \\\\\\\"object\\\\\\\") {\\\\n            for (const [name, serverCfg] of Object.entries(config.mcpServers)) {\\\\n              if ((serverCfg.command || serverCfg.url) && !this.connections.has(name)) {\\\\n                const conn = new McpConnection(name, serverCfg);\\\\n                const ok = await conn.connect();\\\\n                if (ok) {\\\\n                  this.connections.set(name, conn);\\\\n                }\\\\n              }\\\\n            }\\\\n          }\\\\n        } catch {\\\\n          // Ignore invalid JSON configs\\\\n        }\\\\n      }\\\\n    }\\\\n\\\\n    this.rebuildToolMap();\\\\n  }\\\"}]},\\\"match_line\\\":554,\\\"match_lines\\\":[554]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"7dca3b6530ab467e3c984d24dbe9fa7b\\\",\\\"_score\\\":41.435333,\\\"_source\\\":{\\\"title\\\":\\\"client.ts\\\",\\\"ax_path\\\":\\\"client.ts\\\",\\\"ax_file\\\":\\\"axf2-33f9bd7d6b5dee989d474b71676aaa45-17404\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":861,\\\"start_offset\\\":41089,\\\"end_offset\\\":42901,\\\"text\\\":\\\"private async prepareCredential(url: string, requestId?: string, force = false): Promise<void> {\\\\n    if (this.conn.auth !== \\\\\\\"oauth\\\\\\\" || !this.conn.providerId) return;\\\\n    const id = this.conn.providerId;\\\\n    const label = providerDefinition(id)?.label ?? id;\\\\n    const found = resolveCredential(id);\\\\n    const fail = (message: string) =>\\\\n      new InferenceError(\\\\\\\"configuration_error\\\\\\\", \\\\\\\"client\\\\\\\", message, { requestId, failoverEligible: false, condition: \\\\\\\"AUTH_FAILURE\\\\\\\" });\\\\n    if (!found || found.credential.type !== \\\\\\\"oauth\\\\\\\") {\\\\n      this.explicitKey = undefined;\\\\n      return; // preflight reports the missing sign-in\\\\n    }\\\\n    let cred: OAuthCredential = found.credential;\\\\n    const fresh = (c?: OAuthCredential) => Boolean(c?.access) && (c!.expiresAt === undefined || c!.expiresAt - Date.now() > 60_000);\\\\n    if (!fresh(cred) || force) {\\\\n      try {\\\\n        if (found.refreshable) {\\\\n          cred = (await refreshOAuth(id, cred)) as OAuthCredential;\\\\n          saveCredential(id, cred);\\"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18686-7f9d-7a01-aaee-252d4871c34f","create_time":1793258595.6667178}},"metadata":{"client_authored":false,"fallback_token_limit_overri