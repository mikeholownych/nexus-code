{"timestamp":"2026-10-29T13:30:20.529Z","ordinal":503507,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":9315518072,"cached_input_tokens":9216769280,"cache_write_input_tokens":0,"output_tokens":25932871,"reasoning_output_tokens":16035410,"total_tokens":9341450943},"last_token_usage":{"input_tokens":82723,"cached_input_tokens":82560,"cache_write_input_tokens":0,"output_tokens":63,"reasoning_output_tokens":14,"total_tokens":82786},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":8.0,"window_minutes":10080,"resets_at":1793878545},"secondary":null,"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"team","rate_limit_reached_type":null}}}
