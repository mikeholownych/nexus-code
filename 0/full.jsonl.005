oth CI jobs install the exact approved Go version\");\n  assert.equal((workflow.match(/run: bash scripts\\/install-evaluator-toolchains\\.sh/g) ?? []).length, 2, \"both CI jobs use the same exact-version installer\");\n  assert.equal(oracleToolchainVersionProblem({\n    goVersion: \"go version go1.22.12 linux/amd64\",\n    rustcVersion: \"rustc 1.95.0 (fixture)\",\n    cargoVersion: \"cargo 1.95.0 (fixture)\",\n  }), null);\n  assert.match(oracleToolchainVersionProblem({\n    goVersion: \"go version go1.22.11 linux/amd64\",\n    rustcVersion: \"rustc 1.95.0 (fixture)\",\n    cargoVersion: \"cargo 1.95.0 (fixture)\",\n  }), /do not match policy/);\n  assert.match(oracleToolchainVersionProblem({\n    goVersion: \"go version go1.22.12 linux/amd64\",\n    rustcVersion: \"rustc 1.94.0 (fixture)\",\n    cargoVersion: \"cargo 1.95.0 (fixture)\",\n  }), /do not match policy/);\n\n  const fakeSystem = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-system-\"));\n  const fakeAlternatives = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-alternatives-\"));\n  const fakeLib = path.join(fakeSystem, \"rustlib\", \"bin\");\n  fs.mkdirSync(path.join(fakeSystem, \"bin\"), { recursive: true });\n  fs.mkdirSync(fakeLib, { recursive: true });\n  const compilerCanary = \"#!/bin/sh\\nprintf '%s\\\\n' UNPINNED_COMPILER_CANARY\\\\n\";\n  const fakeGo = path.join(fakeSystem, \"bin\", \"go\");\n  const fakeRustc = path.join(fakeLib, \"rustc\");\n  const fakeCargo = path.join(fakeSystem, \"bin\", \"cargo-1.94.0\");\n  for (const file of [fakeGo, fakeRustc, fakeCargo]) {\n    fs.writeFileSync(file, compilerCanary);\n    fs.chmodSync(file, 0o755);\n  }\n  fs.symlinkSync(fakeCargo, path.join(fakeAlternatives, \"cargo\"));\n  const exposure = oracleCompilerExposureProblem([fakeSystem], [fakeAlternatives]);\n  assert.match(exposure ?? \"\", /unapproved Go\\/Rust compiler executable/);\n  assert.match(exposure ?? \"\", /rustlib\\/bin\\/rustc/);\n  assert.match(exposure ?? \"\", /alternatives\\/cargo/);\n  if (sandboxAvailable()) {\n    assert.throws(() => isolatedProcessArgv({\n      cwd: fakeSystem,\n      command: \"/usr/bin/true\",\n      readOnlyPaths: [\"/usr/bin/true\"],\n      allowedFiles: [\"/usr/bin/true\"],\n      oracleToolchains: true,\n      systemDirectories: [fakeSystem],\n      systemEtcDirectories: [fakeAlternatives],\n    }), /unapproved Go\\/Rust compiler executable/, \"the execution-path preflight rejects deliberate compiler escape fixtures\");\n  }\n\n  assert.equal(oracleToolchainPathProblem({ uid: 0, mode: 0o040755 }), null, \"root-owned read-only directories are eligible\");\n  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040775 }), /without group or other write permission/, \"group-writable toolchain paths must fail closed\");\n  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040757 }), /without group or other write permission/, \"other-writable toolchain paths must fail closed\");\n  assert.match(oracleToolchainPathProblem({ uid: 1234, mode: 0o040755 }), /root-owned/, \"non-root-owned paths are not pinned roots\");\n  const candidateRootStat = { uid: 0, mode: 0o040755, isDirectory: () => true, isSymbolicLink: () => false };\n  assert.equal(candidateToolchainRootProblem(candidateRootStat, \"/opt/nexus-qual/rust\", \"/opt/nexus-qual/rust\"), null);\n  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, isSymbolicLink: () => true }, \"/opt/nexus-qual/rust\", \"/opt/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject symlinked toolchain roots\");\n  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, mode: 0o040775 }, \"/opt/nexus-qual/rust\", \"/opt/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject group-writable toolchain roots\");\n  assert.match(candidateToolchainRootProblem(candidateRootStat, \"/tmp/toolchain\", \"/opt/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject roots resolving outside the pinned path\");\n  const taskDir = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-toolchain-task-\"));\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-toolchain-candidate-\"));\n  t.after(() => {\n    fs.rmSync(taskDir, { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n  });\n  fs.mkdirSync(path.join(workspace, \"src\"));\n  fs.writeFileSync(path.join(taskDir, \"private-cases.json\"), JSON.stringify([{ input: { value: \"fixture\" }, expected: { value: \"fixture\", go: \"go-ok\", rust: \"rust-ok\" } }]));\n  fs.writeFileSync(path.join(workspace, \"main.go\"), 'package main\\nimport \"fmt\"\\nfunc main(){fmt.Print(\"go-ok\")}\\n');\n  fs.writeFileSync(path.join(workspace, \"Cargo.toml\"), '[package]\\nname = \"nexus-oracle-canary\"\\nversion = \"0.1.0\"\\nedition = \"2021\"\\n');\n  fs.writeFileSync(path.join(workspace, \"Cargo.lock\"), '# This file is automatically @generated by Cargo.\\nversion = 4\\n\\n[[package]]\\nname = \"nexus-oracle-canary\"\\nversion = \"0.1.0\"\\n');\n  fs.writeFileSync(path.join(workspace, \"Cargo.lock\"), '# This file is automatically @generated by Cargo.\\nversion = 4\\n\\n[[package]]\\nname = \"nexus-oracle-canary\"\\nversion = \"0.1.0\"\\n');\n  fs.writeFileSync(path.join(workspace, \"src/main.rs\"), 'fn main(){print!(\"rust-ok\")}\\n');\n  fs.writeFileSync(path.join(workspace, \"check.py\"), [\n    \"import json, subprocess, sys\",\n    \"for executable, expected in (('/usr/bin/go', 'go1.22.12'), ('/usr/bin/rustc', '1.95.0'), ('/usr/bin/cargo', '1.95.0')):\",\n    \"    try:\",\n    \"        result = subprocess.run([executable, '--version'], capture_output=True, text=True)\",\n    \"    except FileNotFoundError:\",\n    \"        continue\",\n    \"    reported = (result.stdout + result.stderr).strip()\",\n    \"    if result.returncode == 0 and expected not in reported:\",\n    \"        raise SystemExit('unapproved compiler reached by absolute path: ' + executable)\",\n    \"subprocess.run(['go', 'build', '-o', '/tmp/nexus-oracle-go', '/workspace/main.go'], check=True, capture_output=True, text=True)\",\n    \"subprocess.run(['cargo', 'build', '--locked', '--offline', '--manifest-path', '/workspace/Cargo.toml'], check=True, capture_output=True, text=True)\",\n    \"go = subprocess.run(['/tmp/nexus-oracle-go'], check=True, capture_output=True, text=True).stdout\",\n    \"rust = subprocess.run(['/tmp/cargo-target/debug/nexus-oracle-canary'], check=True, capture_output=True, text=True).stdout\",\n    \"value = json.loads(sys.stdin.readline())['value']\",\n    \"print(json.dumps({'value': value, 'go': go, 'rust': rust}))\",\n    \"\",\n  ].join(\"\\n\"));\n  const check = { protocol: \"blackbox-v1\", casesFile: \"private-cases.json\", runtime: \"python3\", argv: [\"check.py\"], timeoutMs: 30_000, totalTimeoutMs: 45_000, maxOutputBytes: 4096 };\n  const problem = oracleToolchainsProblem();\n  if (problem) {\n    assert.equal(blackBoxOracleProblem(check, taskDir), problem, \"qualification preflight must fail closed when pinned toolchains are unavailable\");\n    return;\n  }\n  assert.equal(blackBoxOracleProblem(check, taskDir), null);\n  const sourceFiles = [\"main.go\", \"Cargo.toml\", \"Cargo.lock\", \"src/main.rs\", \"check.py\"];\n  const sourceBefore = sourceFiles.map((file) => fs.readFileSync(path.join(workspace, file), \"utf8\"));\n  await assert.rejects(\n    runBlackBoxOracle({ dir: taskDir }, workspace, check, { protectedCorpusPaths: [\"/usr/local/go\"] }),\n// Minimal Bubblewrap boundary for task setup and validators. These commands receive no host HOME,\n// network namespace, task directory, or inherited environment.\nimport { spawn, spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport os from \"node:os\";\nimport { fileURLToPath } from \"node:url\";\nimport { containmentProblem, spawnContained } from \"./resources.mjs\";\n\nconst BWRAP = \"/usr/bin/bwrap\";\nconst SYSTEM_BINARIES = [\"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/lib\", \"/lib64\", \"/usr/local/lib\"];\nconst SYSTEM_ETC_FILES = [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"];\nconst SYSTEM_ETC_DIRS = [\"/etc/alternatives\"];\nconst FORBIDDEN_RUNTIME_ROOTS = [\"/etc\", \"/root\", \"/proc\", \"/sys\", \"/run\", \"/var\", \"/dev\", \"/tmp\", \"/mnt\", \"/media\", \"/srv\"];\nconst SENSITIVE_HOME_PARTS = [\".ssh\", \".config\", \".aws\", \".azure\", \".gnupg\", \".kube\", \".nexus\", \".cache\"];\nconst TOOLCHAIN_POLICY = JSON.parse(fs.readFileSync(path.join(path.dirname(fileURLToPath(import.meta.url)), \"toolchain-versions.json\"), \"utf8\"));\nif (TOOLCHAIN_POLICY.schemaVersion !== 1 || !/^\\d+\\.\\d+\\.\\d+$/.test(TOOLCHAIN_POLICY.go) || !/^\\d+\\.\\d+\\.\\d+$/.test(TOOLCHAIN_POLICY.rust)) {\n  throw new Error(\"evaluator toolchain policy must pin exact Go and Rust versions\");\n}\nconst PINNED_ORACLE_TOOLCHAINS = Object.freeze([\n  { root: \"/usr/local/go\", required: [\"bin/go\"] },\n  { root: \"/opt/nexus-qual/rust\", required: [\"bin/rustc\", \"bin/cargo\"] },\n]);\nconst UNPINNED_ORACLE_COMPILER_NAME = /^(?:go(?:-?\\d[A-Za-z0-9.+-]*)?|rustc(?:-\\d[A-Za-z0-9.+-]*)?|cargo(?:-\\d[A-Za-z0-9.+-]*)?|rustup)$/;\nlet sandboxPreflight;\nconst pinnedToolchainPreflights = new Map();\nconst oracleCompilerExposurePreflights = new Map();\n\nfunction shellQuote(value) {\n  return `'${value.replaceAll(\"'\", `'\\\\''`)}'`;\n}\n\nexport function candidateAgentPath(configuredPath, toolchains = resolveHostToolchains()) {\n  const configuredEntries = (configuredPath ?? \"/usr/bin:/bin\").split(path.delimiter).filter(Boolean);\n  const toolchainEntries = [\n    ...(toolchains.rustRoot ? [\"/opt/nexus-qual/rust/bin\"] : []),\n    ...(toolchains.goRoot ? [\"/usr/local/go/bin\"] : []),\n  ];\n  return [...new Set([...toolchainEntries, ...configuredEntries])].join(path.delimiter);\n}\n\nexport function selectToolchainRoot(configuredRoot, fallbackRoot) {\n  return configuredRoot ?? fallbackRoot ?? null;\n}\n\nexport function oracleToolchainPathProblem(stat) {\n  if (!stat || stat.isSymbolicLink?.() || stat.uid !== 0 || (stat.mode & 0o022) !== 0) {\n    return \"pinned oracle toolchain entry is not a real root-owned path without group or other write permission\";\n  }\n  return null;\n}\n\nexport function candidateToolchainRootProblem(stat, resolvedPath, expectedPath) {\n  if (!stat || !stat.isDirectory() || stat.isSymbolicLink() || oracleToolchainPathProblem(stat) || resolvedPath !== expectedPath) {\n    return \"pinned candidate toolchain root is not a safe real directory\";\n  }\n  return null;\n}\n\nexport function candidateToolchainMountArgs(toolchains, systemDirectories = []) {\n  const args = [];\n  if (toolchains.goRoot) {\n    if (!systemDirectories.includes(\"/usr/local/lib\")) args.push(\"--dir\", \"/usr/local\");\n    args.push(\"--ro-bind\", toolchains.goRoot, \"/usr/local/go\");\n  }\n  if (toolchains.rustRoot) {\n    args.push(\"--dir\", \"/opt\", \"--dir\", \"/opt/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/opt/nexus-qual/rust\");\n  }\n  return args;\n}\n\nfunction resolveHostToolchains() {\n  const availableDirectory = ({ root, required }) => {\n    let stat;\n    try { stat = fs.lstatSync(root); }\n    catch (error) {\n      if (error?.code === \"ENOENT\") return null;\n      throw error;\n    }\n    const rootProblem = candidateToolchainRootProblem(stat, fs.realpathSync(root), root);\n    if (rootProblem) throw new Error(rootProblem);\n    const problem = pinnedToolchainProblem(root, required);\n    if (problem) throw new Error(problem);\n    return root;\n  };\n  const roots = Object.fromEntries(PINNED_ORACLE_TOOLCHAINS.map((toolchain) => [toolchain.root, availableDirectory(toolchain)]));\n  return {\n    goRoot: roots[\"/usr/local/go\"],\n    rustRoot: roots[\"/opt/nexus-qual/rust\"],\n  };\n}\n\n/** Python black-box oracles may invoke only these root-owned, pinned compiler runtimes. */\nexport function oracleToolchainVersionProblem({ goVersion, rustcVersion, cargoVersion }) {\n  const actualGo = /^go version (go\\S+)/.exec(goVersion ?? \"\")?.[1];\n  const actualRustc = /^rustc (\\S+)/.exec(rustcVersion ?? \"\")?.[1];\n  const actualCargo = /^cargo (\\S+)/.exec(cargoVersion ?? \"\")?.[1];\n  if (actualGo !== `go${TOOLCHAIN_POLICY.go}` || actualRustc !== TOOLCHAIN_POLICY.rust || actualCargo !== TOOLCHAIN_POLICY.rust) {\n    return `pinned oracle toolchain versions do not match policy (expected Go ${TOOLCHAIN_POLICY.go} and Rust ${TOOLCHAIN_POLICY.rust})`;\n  }\n  return null;\n}\n\nfunction isInsideAnyRoot(candidate, roots) {\n  return roots.some((root) => candidate === root || candidate.startsWith(`${root}${path.sep}`));\n}\n\n/** Reject every unpinned Go/Rust compiler reachable through the system mounts used by an oracle. */\nexport function oracleCompilerExposureProblem(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS) {\n  const roots = [...new Set([...systemDirectories, ...systemEtcDirectories])].sort();\n  const cacheKey = JSON.stringify(roots);\n  if (oracleCompilerExposurePreflights.has(cacheKey)) return oracleCompilerExposurePreflights.get(cacheKey);\n\n  const exposed = new Set();\n  const visited = new Set();\n  const approvedRoots = PINNED_ORACLE_TOOLCHAINS.map(({ root }) => root);\n  const visit = (directory) => {\n    const canonicalDirectory = fs.realpathSync(directory);\n    if (visited.has(canonicalDirectory)) return;\n    visited.add(canonicalDirectory);\n    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n      const item = path.join(directory, entry.name);\n      if (entry.isDirectory()) {\n        visit(item);\n        continue;\n      }\n      if (!UNPINNED_ORACLE_COMPILER_NAME.test(entry.name)) continue;\n      let stat;\n      let target;\n      try {\n        stat = fs.statSync(item);\