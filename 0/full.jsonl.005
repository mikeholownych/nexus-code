y(a.endpoint);\norigin/main:cli/src/provider_connect.ts:255:        activateApplianceEndpoint(a.endpoint, model, false);\norigin/main:cli/src/provider_connect.ts:269:    recordRecent({ provider: APPLIANCE, model });\norigin/main:cli/src/provider_connect.ts:275:        : `Model: ${model} on the local appliance.`,\norigin/main:cli/src/providers.ts:3: * and request construction. The local appliance is not a provider here: a configuration without a provider id keeps\norigin/main:cli/src/providers.ts:137:  /** Undefined for the legacy appliance/endpoint path. */\norigin/main:cli/src/providers.ts:144:  /** Whether requests carry the appliance's X-Task-Class routing hint. */\norigin/main:cli/src/providers.ts:159:    // Usage is requested (OpenAI-compatible servers such as llama.cpp, vLLM and the appliance gateway report it, with\norigin/main:cli/src/providers.ts:181:export function disclosureClass(url: string, providerId: string | undefined, cloudRoutedOrigins: readonly string[] = []): \"local\" | \"cloud\" {\norigin/main:cli/src/slash/session_commands.ts:3:import { APPLIANCE, buildCatalog } from \"../model_catalog.js\";\norigin/main:cli/src/slash/session_commands.ts:155:  // `/model <provider> <model>`: switch provider and model (\"appliance\" for the local appliance).\norigin/main:cli/src/slash/session_commands.ts:157:  if (rest.length && (first === APPLIANCE || providerDefinition(first))) {\n"},{"type":"input_text","text":"source tree\ncli/src/core/provider_capabilities.ts\ncli/src/core/provider_recovery.ts\ncli/src/provider_cli.ts\ncli/src/provider_connect.ts\ncli/src/providers.ts\ncli/src/tui.ts\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18686-7f9d-7a01-aaee-252d4871c34f","create_time":1793258572.747908}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
