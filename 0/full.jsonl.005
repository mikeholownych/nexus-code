ountArgs({ goRoot: toolchains.goRoot, rustRoot: null }, [\"/usr/local/lib\"]), [\n   704\t    \"--ro-bind\", toolchains.goRoot, \"/usr/local/go\",\n   705\t  ]);\n   706\t});\n   707\t\n   708\ttest(\"qualification runtime mounts cannot overlap the task tree, held-out store, or private validator paths\", async () => {\n   709\t  const { hiddenTestIsolationProblem, runtimeCorpusOverlapProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   710\t  const { agentSandboxArgv, candidateSandboxHostMountSources, isolatedArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   711\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-corpus-overlap-\"));\n   712\t  try {\n   713\t    const store = path.join(root, \"heldout-v2\");\n   714\t    const tasks = path.join(store, \"tasks\");\n   715\t    const references = path.join(store, \"reference\");\n   716\t    const runtimeRoot = path.join(root, \"runtime\");\n   717\t    const home = path.join(root, \"home\");\n   718\t    const proxyDirectory = path.join(root, \"proxy\");\n   719\t    const readOnlyRuntime = path.join(runtimeRoot, \"runtime.bin\");\n   720\t    const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n   721\t    const privateValidator = path.join(root, \"private-validator\");\n   722\t    fs.mkdirSync(tasks, { recursive: true });\n   723\t    fs.mkdirSync(references);\n   724\t    fs.mkdirSync(runtimeRoot);\n   725\t    fs.mkdirSync(home);\n   726\t    fs.mkdirSync(proxyDirectory);\n   727\t    fs.mkdirSync(privateValidator);\n   728\t    fs.writeFileSync(readOnlyRuntime, \"runtime\\n\");\n   729\t    fs.writeFileSync(path.join(tasks, \"task.json\"), \"{}\\n\");\n   730\t    fs.writeFileSync(path.join(references, \"solution.patch\"), \"REFERENCE_SOLUTION_CANARY\\n\");\n   731\t    fs.writeFileSync(path.join(privateValidator, \"validate.mjs\"), \"PRIVATE_VALIDATOR_CANARY\\n\");\n   732\t    const alias = path.join(root, \"store-alias\");\n   733\t    fs.symlinkSync(store, alias, \"dir\");\n   734\t\n   735\t    const mountContext = { cwd: runtimeRoot, home, proxyDirectory, nodeRuntime: process.execPath, supervisorPath };\n   736\t    const hostMounts = candidateSandboxHostMountSources({ ...mountContext, readOnlyPaths: [readOnlyRuntime] });\n   737\t    const expectedToolchains = [\"/usr/local/go\", \"/usr/local/nexus-qual/rust\"]\n   738\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   739\t    const existingDirectories = [\"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/lib\", \"/lib64\", \"/usr/local/lib\"]\n   740\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   741\t    const existingEtcFiles = [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]\n   742\t      .filter((item) => { try { return fs.statSync(item).isFile(); } catch { return false; } });\n   743\t    const existingEtcDirectories = [\"/etc/alternatives\"]\n   744\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   745\t    assert.deepEqual(hostMounts.systemDirectories, existingDirectories);\n   746\t    assert.deepEqual(hostMounts.systemFiles, existingEtcFiles);\n   747\t    assert.deepEqual(hostMounts.systemEtcDirectories, existingEtcDirectories);\n   748\t    assert.deepEqual(hostMounts.toolchainDirectories, expectedToolchains);\n   749\t    assert.deepEqual(hostMounts.runtimeSources, {\n   750\t      cwd: fs.realpathSync(runtimeRoot),\n   751\t      home: fs.realpathSync(home),\n   752\t      proxyDirectory,\n   753\t      nodeRuntime: fs.realpathSync(process.execPath),\n   754\t      supervisorPath: fs.realpathSync(supervisorPath),\n   755\t      readOnlyPaths: [fs.realpathSync(readOnlyRuntime)],\n   756\t    });\n   757\t\n   758\t    assert.equal(runtimeCorpusOverlapProblem([runtimeRoot], [runtimeRoot], tasks), null, \"an unrelated pinned runtime remains usable\");\n   759\t    assert.match(runtimeCorpusOverlapProblem([path.join(references, \"solution.patch\")], [store], tasks) ?? \"\", /overlaps protected corpus material/);\n   760\t    assert.match(runtimeCorpusOverlapProblem([runtimeRoot], [store], tasks) ?? \"\", /overlaps protected corpus material/, \"a broad allowlist root cannot contain the corpus store\");\n   761\t    assert.match(runtimeCorpusOverlapProblem([path.join(alias, \"reference\", \"solution.patch\")], [alias], tasks) ?? \"\", /overlaps protected corpus material/, \"symlink aliases are resolved before comparing paths\");\n   762\t    assert.match(runtimeCorpusOverlapProblem([privateValidator], [privateValidator], tasks, [privateValidator]) ?? \"\", /overlaps protected corpus material/);\n   763\t    assert.match(runtimeCorpusOverlapProblem([runtimeRoot], [runtimeRoot], tasks, [path.join(root, \"missing-validator\")]) ?? \"\", /private corpus path is unavailable/);\n   764\t    assert.equal(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\")), null, \"default in-repo development eval/tasks does not collide with eval/agent_sandbox.mjs\");\n   765\t    assert.equal(runtimeCorpusOverlapProblem([path.join(ROOT, \"cli/dist\")], [path.join(ROOT, \"cli\"), path.join(ROOT, \"core\")], path.join(ROOT, \"eval/tasks\")), null, \"default development Nexus runtime roots do not overlap eval/tasks\");\n   766\t    assert.match(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\"), [], { qualification: true }) ?? \"\", /overlaps protected corpus material/, \"qualification mode still rejects using in-repo eval/tasks because its parent overlaps eval/agent_sandbox.mjs\");\n   767\t\n   768\t    const unconditionalMountPaths = [\n   769\t      ...hostMounts.systemDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   770\t      ...hostMounts.systemFiles,\n   771\t      ...hostMounts.systemEtcDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   772\t      ...hostMounts.toolchainDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   773\t    ];\n   774\t    const runtimeMountPaths = [\n   775\t      path.join(runtimeRoot, \"corpus-leak\"),\n   776\t      path.join(home, \"corpus-leak\"),\n   777\t      path.join(proxyDirectory, \"corpus-leak\"),\n   778\t      process.execPath,\n   779\t      supervisorPath,\n   780\t      readOnlyRuntime,\n   781\t    ];\n   782\t    for (const protectedPath of [...unconditionalMountPaths, ...runtimeMountPaths]) {\n   783\t      assert.match(\n   784\t        runtimeCorpusOverlapProblem([], [], tasks, [protectedPath], mountContext) ?? \"\",\n   785\t        /overlaps protected corpus material/,\n   786\t        `runtime preflight rejects mounted corpus path ${protectedPath}`,\n   787\t      );\n   788\t      assert.match(\n   789\t        hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: protectedPath }, mountContext }, tasks) ?? \"\",\n   790\t        /overlaps protected corpus material/,\n   791\t        `hidden-test qualification preflight rejects mounted corpus path ${protectedPath}`,\n   792\t      );\n   793\t      assert.throws(() => agentSandboxArgv({\n   794\t        cwd: runtimeRoot,\n   795\t        home,\n   796\t        proxyDirectory,\n   797\t        readOnlyPaths: [readOnlyRuntime],\n   798\t        supervisorPath,\n   799\t        protectedCorpusPaths: [protectedPath],\n   800\t      }), /overlaps protected corpus material/);\n   801\t      if (unconditionalMountPaths.includes(protectedPath)) {\n   802\t        // This check precedes Bubblewrap availability, including on minimal CI hosts.\n   803\t        assert.throws(() => isolatedArgv({ cwd: runtimeRoot, command: \"true\", protectedCorpusPaths: [protectedPath] }), /overlaps protected corpus material/);\n   804\t      }\n   805\t    }\n   806\t    assert.match(\n   807\t      runtimeCorpusOverlapProblem([], [\"/usr/bin\"], tasks, [path.join(\"/usr/bin\", \"synthetic-corpus-subdir\")]) ?? \"\",\n   808\t      /overlaps protected corpus material/,\n   809\t      \"a runtime allowlist root below an unconditional system mount is rejected\",\n   810\t    );\n   811\t    assert.match(\n   812\t      runtimeCorpusOverlapProblem([readOnlyRuntime], [], tasks, [readOnlyRuntime], mountContext) ?? \"\",\n   813\t      /overlaps protected corpus material/,\n   814\t      \"an explicit read-only runtime source is checked against the corpus\",\n   815\t    );\n   816\t    assert.match(\n   817\t      hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [readOnlyRuntime], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: readOnlyRuntime }, mountContext }, tasks) ?? \"\",\n   818\t      /overlaps protected corpus material/,\n   819\t      \"hidden-test preflight checks explicit read-only runtime sources\",\n   820\t    );\n   821\t    const custodyReportPath = readOnlyRuntime;\n   822\t    assert.match(hiddenTestIsolationProblem({\n   823\t      qualification: true,\n   824\t      runAs: \"nexus-eval\",\n   825\t      sandboxRuntimePaths: [readOnlyRuntime],\n   826\t      sandboxRuntimeRoots: [runtimeRoot],\n   827\t      corpusCustody: { reportPath: custodyReportPath },\n   828\t      mountContext,\n   829\t    }, tasks) ?? \"\", /overlaps protected corpus material/);\n   830\t    assert.throws(() => agentSandboxArgv({\n   831\t      cwd: runtimeRoot,\n   832\t      home,\n   833\t      proxyDirectory,\n   834\t      readOnlyPaths: [readOnlyRuntime],\n   835\t      supervisorPath,\n   836\t      protectedCorpusPaths: [custodyReportPath],\n   837\t    }), /overlaps protected corpus material/);\n   838\t  } finally {\n   839\t    fs.rmSync(root, { recursive: true, force: true });\n   840\t  }\n   841\t});\n   842\t\n   843\ttest(\"qualification remains fail-closed without enforced aggregate resource controls\", async () => {\n   844\t  const { qualificationResourceIsolationProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   845\t  const { dedicatedTmpfsMountProblem } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n   846\t  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\n   847\t  const tmpfs = fs.statfsSync(workspaceRoot);\n   848\t  const ok = { cpuPercent: 100, memoryBytes: 256 * 1024 * 1024, tasks: 64, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\n   849\t  const shared = fs.statfsSync(\"/dev/shm\");\n   850\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: \"/dev/shm\", storageBytes: shared.blocks * shared.bsize } }) ?? \"\", /dedicated tmpfs|exact mount point/);\n  verify the account and these existing operating-system permissions through the approved local setup procedure:\n  1. `sudo useradd --system --create-home nexus-eval`\n  2. A narrowly constrained sudoers rule permitting only the required Bubblewrap invocation as `nexus-eval`; do not\n     grant arbitrary `env` command execution.\n  3. Keep task stores unreadable to the evaluator account; the runner does not mount them into the candidate namespace.\n  4. A Nexus install, Node and the peer agents that `nexus-eval` can read and execute.\n\n  Development runs may omit `runAs`; Bubblewrap isolation still applies. Qualification is refused without a separate\n  evaluator account, `setfacl`, explicit `sandboxRuntimeRoots`, and read-only `sandboxRuntimePaths` contained by those\n  roots. Protected roots such as `/etc`, `/dev`, `/proc`, `/sys`, `/run`, `/var`, `/tmp`, and sensitive user-cache paths\n  are rejected. No setup procedure is applied by the runner.\n\n- **Repository workspaces carry no history beyond the pinned commit.** `eval/workspace.mjs` stages a repo task as a\n  fresh `git init` that fetches only the pinned commit and its ancestors from the local cache (`--no-tags`, no\n  FETCH_HEAD), then checks out that commit detached. There is no `--shared` clone, alternates link, remote, tag or\n  descendant object, so the upstream fix that follows a held-out baseline is not reachable from the workspace. Staging\n  verifies this and refuses the run otherwise.\n\n- **Corpus binding is integrity evidence, not approval authentication.** The qualification config pins the exact\n  corpus-manifest SHA-256, and the run manifest repeats the selected task hashes. The v1 manifest binds every task's\n  full task tree in row `sha256`. The heldout-v2 manifest binds each task's raw `task.json` and hidden-directory digest for\n  pinned-repository tasks; a local fixture additionally requires a full-tree `sha256` because those two v2 digests do\n  not cover fixture files. The frozen config carries `corpusCustody: { custodian, approvedAt, reportPath, reportSha256 }`\n  and may also name `storeRoot`, `validatorPath`, `referencePath`, and `authorLogPath`; the report path and optional\n  private paths are protected from runtime mounts. These values and the manifest's custody labels are claims, not\n  signatures. Independent custody acceptance, pre-RC commit timing, and configuration freeze must be verified and\n  archived by the acceptance reviewer before any qualification run. The current candidate task package has not been\n  independently accepted.\n\n### Isolation limits\n\nBubblewrap plus the current runner enforces separate mount/user/PID/network namespaces, a cleared task-command\nenvironment, a bounded wall clock, bounded captured output, per-run process-group teardown, and read-only runtime\nbinds. Black-box qualification keeps oracle expectations outside candidate namespaces. Legacy hidden commands share a\nprocess with candidate code and are rejected during qualification preflight. The hardened legacy path below is only for\ndevelopment and pilot scoring; it is not qualification evidence. Aggregate CPU, memory, process-count and\nwritable-storage limits come from the resource contract below, not from request/token ceilings. Appliance-specific\nBubblewrap enforcement is a separate, unverified condition.\n\n### Hardened legacy hidden tests (development and pilot only)\n\nLegacy tasks use `hidden: { dir, command }` (for example `pytest` or `go test` over copied test files) and run candidate\ncode in the same process as the oracle. They do not meet the qualification boundary, even when hardened. Qualification\npreflight accepts only the isolated `blackbox-v1` protocol. Any legacy task in a qualification corpus must be replaced\nor converted by the authorized custodian, with custody checks repeated and a new immutable manifest identity recorded.\nDevelopment configs may opt into the hardened diagnostic path with `\"hardenedChecks\": true`.\n\n1. The agent's workspace is never tested, and nothing runs git or any other program against it after the agent ran.\n   An agent-written `.git/config` or `.gitattributes` would otherwise run commands as the harness user. The baseline\n   tree hash is taken before the agent starts. The harness then stages the task again (the same pinned commit or\n   fixture, the same setup commands) into a fresh workspace, and checks that its tree equals that baseline.\n   327\texport function candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths = [], nodeRuntime, supervisorPath } = {}) {\n   328\t  if (!Array.isArray(readOnlyPaths)) throw new Error(\"candidate sandbox readOnlyPaths must be an array\");\n   329\t  const existing = (paths, kind) => paths.filter((source) => {\n   330\t    try {\n   331\t      const stat = fs.statSync(source);\n   332\t      return kind === \"directory\" ? stat.isDirectory() : stat.isFile();\n   333\t    } catch { return false; }\n   334\t  });\n   335\t  const optional = (source, resolve = true) => source === undefined ? null : resolve ? fs.realpathSync(source) : source;\n   336\t  return {\n   337\t    systemDirectories: existing(SYSTEM_BINARIES, \"directory\"),\n   338\t    systemFiles: existing(SYSTEM_ETC_FILES, \"file\"),\n   339\t    systemEtcDirectories: existing(SYSTEM_ETC_DIRS, \"directory\"),\n   340\t    toolchainDirectories: Object.values(resolveHostToolchains()).filter(Boolean),\n   341\t    runtimeSources: {\n   342\t      cwd: optional(cwd),\n   343\t      home: optional(home),\n   344\t      proxyDirectory: optional(proxyDirectory),\n   345\t      nodeRuntime: optional(nodeRuntime),\n   346\t      supervisorPath: optional(supervisorPath),\n   347\t      readOnlyPaths: readOnlyPaths.map((source) => fs.realpathSync(source)),\n   348\t    },\n   349\t  };\n   350\t}\n   351\t\n   352\tfunction pathOverlaps(left, right) {\n   353\t  return left === right || left.startsWith(`${right}${path.sep}`) || right.startsWith(`${left}${path.sep}`);\n   354\t}\n   355\t\n   545\texport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n   546\t  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n   547\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   548\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   549\t  const compilerExposure = scanOracleCompilerExposure(mountSources.systemDirectories, mountSources.systemEtcDirectories);\n   550\t  if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n   551\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n   552\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n   553\t  if (mountProblem) throw new Error(mountProblem);\n   554\t  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n   555\t    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n   556\t  }\n   557\t  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n   558\t  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n   559\t    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n   560\t  }\n   561\t  const workspace = mountSources.runtimeSources.cwd;\n   562\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   563\t  for (const source of mountSources.systemDirectories) {\n   564\t    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   565\t    args.push(\"--ro-bind\", source, source);\n   566\t  }\n   567\t  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\n   568\t  for (const source of mountSources.systemFiles) args.push(\"--ro-bind\", source, source);\n   569\t  for (const source of mountSources.systemEtcDirectories) args.push(\"--ro-bind\", source, source);\n   570\t  args.push(...compilerExposureMaskArgs(compilerExposure));\n   571\t  const isolatedHome = mountSources.runtimeSources.home;\n   572\t  args.push(\"--symlink\", \"usr/bin\", \"/bin\", \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--bind\", isolatedHome, \"/home/eval\", \"--tmpfs\", \"/run\");\n   573\t  args.push(\"--dir\", \"/run/eval-proxy\", \"--ro-bind\", mountSources.runtimeSources.proxyDirectory, \"/run/eval-proxy\");\n   574\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/run\", \"/run/eval-proxy\"]);\n   575\t  const addTargetParents = (target) => {\n   576\t    const parts = target.split(path.sep).filter(Boolean);\n   577\t    let current = \"\";\n   578\t    for (const part of parts.slice(0, -1)) {\n   579\t      current += `/${part}`;\n   580\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   581\t    }\n   582\t  };\n   583\t  for (const resolved of mountSources.runtimeSources.readOnlyPaths) {\n   584\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   585\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   586\t    addTargetParents(resolved);\n   587\t    args.push(\"--ro-bind\", resolved, resolved);\n   588\t  }\n   589\t  addTargetParents(\"/runner/agent_sandbox.mjs\");\n   590\t  args.push(\"--ro-bind\", nodeRuntime, \"/runner/node\");\n   591\t  args.push(\"--ro-bind\", mountSources.runtimeSources.supervisorPath, \"/runner/agent_sandbox.mjs\");\n   592\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"CI\", \"1\", \"--\");\n","exit_code":0,"duration":{"secs":0,"nanos":806257430}},"started_at_ms":1793277866845,"completed_at_ms":1793277867652}}
{"timestamp":"2026-10-29T12:44:27.885Z","ordinal":501446,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a187b0-b76c-7180-8dbd-5c033cc45088","call_id":"call_061dc53b56c44dfebadfd15d5b2f9c32","output":[{"type":"input_text","text":"Script completed\nWall time 1.2 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 5334)\nTotal output lines: 289\n\n   690\t  const toolchains = { goRoot: \"/host/toolchains/go\", rustRoot: \"/host/toolchains/rust\" };\n   691\t  assert.equal(\n   692\t    candidateAgentPath(\"/custom/bin:/usr/bin:/bin\", toolchains),\n   693\t    \"/usr/local/nexus-qual/rust/bin:/usr/local/go/bin:/custom/bin:/usr/bin:/bin\",\n   694\t  );\n   695\t  assert.deepEqual(candidateToolchainMountArgs(toolchains), [\n   696\t    \"--dir\", \"/usr/local\", \"--ro-bind\", toolchains.goRoot, \"/usr/local/go\",\n   697\t    \"--dir\", \"/usr/local/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/usr/local/nexus-qual/rust\",\n   698\t  ]);\n   699\t  assert.deepEqual(candidateToolchainMountArgs({ goRoot: null, rustRoot: toolchains.rustRoot }), [\n   700\t    \"--dir\", \"/usr/local\", \"--dir\", \"/usr/local/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/usr/local/nexus-qual/rust\",\n   701\t  ]);\n   702\t  assert.deepEqual(candidateToolchainMountArgs({ goRoot: null, rustRoot: null }), []);\n   703\t  assert.deepEqual(candidateToolchainMountArgs({ goRoot: toolchains.goRoot, rustRoot: null }, [\"/usr/local/lib\"]), [\n   704\t    \"--ro-bind\", toolchains.goRoot, \"/usr/local/go\",\n   705\t  ]);\n   706\t});\n   707\t\n   708\ttest(\"qualification runtime mounts cannot overlap the task tree, held-out store, or private validator paths\", async () => {\n   709\t  const { hiddenTestIsolationProblem, runtimeCorpusOverlapProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   710\t  const { agentSandboxArgv, candidateSandboxHostMountSources, isolatedArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   711\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-corpus-overlap-\"));\n   712\t  try {\n   713\t    const store = path.join(root, \"heldout-v2\");\n   714\t    const tasks = path.join(store, \"tasks\");\n   715\t    const references = path.join(store, \"reference\");\n   716\t    const runtimeRoot = path.join(root, \"runtime\");\n   717\t    const home = path.join(root, \"home\");\n   718\t    const proxyDirectory = path.join(root, \"proxy\");\n   719\t    const readOnlyRuntime = path.join(runtimeRoot, \"runtime.bin\");\n   720\t    const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n   721\t    const privateValidator = path.join(root, \"private-validator\");\n   722\t    fs.mkdirSync(tasks, { recursive: true });\n   723\t    fs.mkdirSync(references);\n   724\t    fs.mkdirSync(runtimeRoot);\n   725\t    fs.mkdirSync(home);\n   726\t    fs.mkdirSync(proxyDirectory);\n   727\t    fs.mkdirSync(privateValidator);\n   728\t    fs.writeFileSync(readOnlyRuntime, \"runtime\\n\");\n   729\t    fs.writeFileSync(path.join(tasks, \"task.json\"), \"{}\\n\");\n   730\t    fs.writeFileSync(path.join(references, \"solution.patch\"), \"REFERENCE_SOLUTION_CANARY\\n\");\n   731\t    fs.writeFileSync(path.join(privateValidator, \"validate.mjs\"), \"PRIVATE_VALIDATOR_CANARY\\n\");\n   732\t    const alias = path.join(root, \"store-alias\");\n   733\t    fs.symlinkSync(store, alias, \"dir\");\n   734\t\n   735\t    const mountContext = { cwd: runtimeRoot, home, proxyDirectory, nodeRuntime: process.execPath, supervisorPath };\n   736\t    const hostMounts = candidateSandboxHostMountSources({ ...mountContext, readOnlyPaths: [readOnlyRuntime] });\n   737\t    const expectedToolchains = [\"/usr/local/go\", \"/usr/local/nexus-qual/rust\"]\n   738\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   739\t    const existingDirectories = [\"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/lib\", \"/lib64\", \"/usr/local/lib\"]\n   740\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   741\t    const existingEtcFiles = [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]\n   742\t      .filter((item) => { try { return fs.statSync(item).isFile(); } catch { return false; } });\n   743\t    const existingEtcDirectories = [\"/etc/alternatives\"]\n   744\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   745\t    assert.deepEqual(hostMounts.systemDirectories, existingDirectories);\n   746\t    assert.deepEqual(hostMounts.systemFiles, existingEtcFiles);\n   747\t    assert.deepEqual(hostMounts.systemEtcDirectories, existingEtcDirectories);\n   748\t    assert.deepEqual(hostMounts.toolchainDirectories, expectedToolchains);\n   749\t    assert.deepEqual(hostMounts.runtimeSources, {\n   750\t      cwd: fs.realpathSync(runtimeRoot),\n   751\t      home: fs.realpathSync(home),\n   752\t      proxyDirectory,\n   753\t      nodeRuntime: fs.realpathSync(process.execPath),\n   754\t      supervisorPath: fs.realpathSync(supervisorPath),\n   755\t      readOnlyPaths: [fs.realpathSync(readOnlyRuntime)],\n   756\t    });\n   757\t\n   758\t    assert.equal(runtimeCorpusOverlapProblem([runtimeRoot], [runtimeRoot], tasks), null, \"an unrelated pinned runtime remains usable\");\n   759\t    assert.match(runtimeCorpusOverlapProblem([path.join(references, \"solution.patch\")], [store], tasks) ?? \"\", /overlaps protected corpus material/);\n   760\t    assert.match(runtimeCorpusOverlapProblem([runtimeRoot], [store], tasks) ?? \"\", /overlaps protected corpus material/, \"a broad allowlist root cannot contain the corpus store\");\n   761\t    assert.match(runtimeCorpusOverlapProblem([path.join(alias, \"reference\", \"solution.patch\")], [alias], tasks) ?? \"\", /overlaps protected corpus material/, \"symlink aliases are resolved before comparing paths\");\n   762\t    assert.match(runtimeCorpusOverlapProblem([privateValidator], [privateValidator], tasks, [privateValidator]) ?? \"\", /overlaps protected corpus material/);\n   763\t    assert.match(runtimeCorpusOverlapProblem([runtimeRoot], [runtimeRoot], tasks, [path.join(root, \"missing-validator\")]) ?? \"\", /private corpus path is unavailable/);\n   764\t    assert.equal(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\")), null, \"default in-repo development eval/tasks does not collide with eval/agent_sandbox.mjs\");\n   765\t    assert.equal(runtimeCorpusOverlapProblem([path.join(ROOT, \"cli/dist\")], [path.join(ROOT, \"cli\"), path.join(ROOT, \"core\")], path.join(ROOT, \"eval/tasks\")), null, \"default development Nexus runtime roots do not overlap eval/tasks\");\n   766\t    assert.match(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\"), [], { qualification: true }) ?? \"\", /overlaps protected corpus material/, \"qualification mode still rejects using in-repo eval/tasks because its parent overlaps eval/agent_sandbox.mjs\");\n   767\t\n   768\t    const unconditionalMountPaths = [\n   769\t      ...hostMounts.systemDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   770\t      ...hostMounts.systemFiles,\n   771\t      ...hostMounts.systemEtcDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   772\t      ...hostMounts.toolchainDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   773\t    ];\n   774\t    const runtimeMountPaths = [\n   775\t      path.join(runtimeRoot, \"corpus-leak\"),\n   776\t      path.join(home, \"corpus-leak\"),\n   777\t      path.join(proxyDirectory, \"corpus-leak\"),\n   778\t      process.execPath,\n   779\t      supervisorPath,\n   780\t      readOnlyRuntime,\n   781\t    ];\n   782\t    for (const protectedPath of [...unconditionalMountPaths, ...runtimeMountPaths]) {\n   783\t      assert.match(\n   784\t        runtimeCorpusOverlapProblem([], [], tasks, [protectedPath], mountContext) ?? \"\",\n   785\t        /overlaps protected corpus material/,\n   786\t        `runtime preflight rejects mounted corpus path ${protectedPath}`,\n   787\t      );\n   788\t      assert.match(\n   789\t        hiddenTestIsolationProblem…1534 tokens truncated…alification run. The current candidate task package has not been\n  independently accepted.\n\n### Isolation limits\n\nBubblewrap plus the current runner enforces separate mount/user/PID/network namespaces, a cleared task-command\nenvironment, a bounded wall clock, bounded captured output, per-run process-group teardown, and read-only runtime\nbinds. Black-box qualification keeps oracle expectations outside candidate namespaces. Legacy hidden commands share a\nprocess with candidate code and are rejected during qualification preflight. The hardened legacy path below is only for\ndevelopment and pilot scoring; it is not qualification evidence. Aggregate CPU, memory, process-count and\nwritable-storage limits come from the resource contract below, not from request/token ceilings. Appliance-specific\nBubblewrap enforcement is a separate, unverified condition.\n\n### Hardened legacy hidden tests (development and pilot only)\n\nLegacy tasks use `hidden: { dir, command }` (for example `pytest` or `go test` over copied test files) and run candidate\ncode in the same process as the oracle. They do not meet the qualification boundary, even when hardened. Qualification\npreflight accepts only the isolated `blackbox-v1` protocol. Any legacy task in a qualification corpus must be replaced\nor converted by the authorized custodian, with custody checks repeated and a new immutable manifest identity recorded.\nDevelopment configs may opt into the hardened diagnostic path with `\"hardenedChecks\": true`.\n\n1. The agent's workspace is never tested, and nothing runs git or any other program against it after the agent ran.\n   An agent-written `.git/config` or `.gitattributes` would otherwise run commands as the harness user. The baseline\n   tree hash is taken before the agent starts. The harness then stages the task again (the same pinned commit or\n   fixture, the same setup commands) into a fresh workspace, and checks that its tree equals that baseline.\n   327\texport function candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths = [], nodeRuntime, supervisorPath } = {}) {\n   328\t  if (!Array.isArray(readOnlyPaths)) throw new Error(\"candidate sandbox readOnlyPaths must be an array\");\n   329\t  const existing = (paths, kind) => paths.filter((source) => {\n   330\t    try {\n   331\t      const stat = fs.statSync(source);\n   332\t      return kind === \"directory\" ? stat.isDirectory() : stat.isFile();\n   333\t    } catch { return false; }\n   334\t  });\n   335\t  const optional = (source, resolve = true) => source === undefined ? null : resolve ? fs.realpathSync(source) : source;\n   336\t  return {\n   337\t    systemDirectories: existing(SYSTEM_BINARIES, \"directory\"),\n   338\t    systemFiles: existing(SYSTEM_ETC_FILES, \"file\"),\n   339\t    systemEtcDirectories: existing(SYSTEM_ETC_DIRS, \"directory\"),\n   340\t    toolchainDirectories: Object.values(resolveHostToolchains()).filter(Boolean),\n   341\t    runtimeSources: {\n   342\t      cwd: optional(cwd),\n   343\t      home: optional(home),\n   344\t      proxyDirectory: optional(proxyDirectory),\n   345\t      nodeRuntime: optional(nodeRuntime),\n   346\t      supervisorPath: optional(supervisorPath),\n   347\t      readOnlyPaths: readOnlyPaths.map((source) => fs.realpathSync(source)),\n   348\t    },\n   349\t  };\n   350\t}\n   351\t\n   352\tfunction pathOverlaps(left, right) {\n   353\t  return left === right || left.startsWith(`${right}${path.sep}`) || right.startsWith(`${left}${path.sep}`);\n   354\t}\n   355\t\n   545\texport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n   546\t  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n   547\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   548\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   549\t  const compilerExposure = scanOracleCompilerExposure(mountSources.systemDirectories, mountSources.systemEtcDirectories);\n   550\t  if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n   551\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n   552\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n   553\t  if (mountProblem) throw new Error(mountProblem);\n   554\t  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n   555\t    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n   556\t  }\n   557\t  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n   558\t  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n   559\t    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n   560\t  }\n   561\t  const workspace = mountSources.runtimeSources.cwd;\n   562\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   563\t  for (const source of mountSources.systemDirectories) {\n   564\t    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   565\t    args.push(\"--ro-bind\", source, source);\n   566\t  }\n   567\t  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\n   568\t  for (const source of mountSources.systemFiles) args.push(\"--ro-bind\", source, source);\n   569\t  for (const source of mountSources.systemEtcDirectories) args.push(\"--ro-bind\", source, source);\n   570\t  args.push(...compilerExposureMaskArgs(compilerExposure));\n   571\t  const isolatedHome = mountSources.runtimeSources.home;\n   572\t  args.push(\"--symlink\", \"usr/bin\", \"/bin\", \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--bind\", isolatedHome, \"/home/eval\", \"--tmpfs\", \"/run\");\n   573\t  args.push(\"--dir\", \"/run/eval-proxy\", \"--ro-bind\", mountSources.runtimeSources.proxyDirectory, \"/run/eval-proxy\");\n   574\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/run\", \"/run/eval-proxy\"]);\n   575\t  const addTargetParents = (target) => {\n   576\t    const parts = target.split(path.sep).filter(Boolean);\n   577\t    let current = \"\";\n   578\t    for (const part of parts.slice(0, -1)) {\n   579\t      current += `/${part}`;\n   580\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   581\t    }\n   582\t  };\n   583\t  for (const resolved of mountSources.runtimeSources.readOnlyPaths) {\n   584\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   585\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   586\t    addTargetParents(resolved);\n   587\t    args.push(\"--ro-bind\", resolved, resolved);\n   588\t  }\n   589\t  addTargetParents(\"/runner/agent_sandbox.mjs\");\n   590\t  args.push(\"--ro-bind\", nodeRuntime, \"/runner/node\");\n   591\t  args.push(\"--ro-bind\", mountSources.runtimeSources.supervisorPath, \"/runner/agent_sandbox.mjs\");\n   592\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"CI\", \"1\", \"--\");\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18771-cd08-7c60-9b2e-7bad123756d6","create_time":1793277867.8848593}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
