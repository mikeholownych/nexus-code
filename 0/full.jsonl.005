 mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: ${{ matrix.node }}\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - run: npm --prefix cli test\n\n  linux-x86_64:\n    needs: [test-matrix]\n    runs-on: ubuntu-22.04\n    env:\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.x'\n      - name: Install pinned evaluator toolchains\n        run: |\n          go_root=\"$(go env GOROOT)\"\n          rust_root=\"$(rustc --print sysroot)\"\n          test -n \"$go_root\" && test -d \"$go_root\"\n          test -n \"$rust_root\" && test -d \"$rust_root\"\n          sudo rm -rf -- /usr/local/go /opt/nexus-qual/rust\n          sudo install -d -o root -g root -m 0755 /usr/local /opt/nexus-qual\n          sudo cp -a \"$go_root\" /usr/local/go\n          sudo cp -a \"$rust_root\" /opt/nexus-qual/rust\n          sudo chown -hR root:root /usr/local/go /opt/nexus-qual/rust\n          sudo chmod -R go-w /usr/local/go /opt/nexus-qual/rust\n          test \"$(/usr/local/go/bin/go version)\" = \"$(go version)\"\n          test \"$(/opt/nexus-qual/rust/bin/rustc --version)\" = \"$(rustc --version)\"\n          test \"$(/opt/nexus-qual/rust/bin/cargo --version)\" = \"$(cargo --version)\"\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      proxyDirectory: optional(proxyDirectory),\n      nodeRuntime: optional(nodeRuntime),\n      supervisorPath: optional(supervisorPath),\n      readOnlyPaths: readOnlyPaths.map((source) => fs.realpathSync(source)),\n    },\n  };\n}\n\nfunction pathOverlaps(left, right) {\n  return left === right || left.startsWith(`${right}${path.sep}`) || right.startsWith(`${left}${path.sep}`);\n}\n\nfunction pathVariants(source) {\n  if (typeof source !== \"string\" || !path.isAbsolute(source)) return [];\n  const lexical = path.resolve(source);\n  let current = lexical;\n  const suffix = [];\n  while (true) {\n    try {\n      const canonical = path.resolve(fs.realpathSync(current), ...suffix);\n      return [...new Set([lexical, canonical])];\n    } catch {\n      const parent = path.dirname(current);\n      if (parent === current) return [lexical];\n      suffix.unshift(path.basename(current));\n      current = parent;\n    }\n  }\n}\n\nfunction candidateMountOverlapProblem(mountSources, protectedCorpusPaths) {\n  return mountSourceOverlapProblem([\n    ...mountSources.systemDirectories,\n    ...mountSources.systemFiles,\n    ...mountSources.systemEtcDirectories,\n    ...mountSources.toolchainDirectories,\n    ...Object.values(mountSources.runtimeSources).flatMap((value) => Array.isArray(value) ? value : value === null ? [] : [value]),\n  ], protectedCorpusPaths);\n}\n\nfunction mountSourceOverlapProblem(sources, protectedCorpusPaths) {\n  if (!Array.isArray(protectedCorpusPaths)) return \"candidate sandbox protectedCorpusPaths must be an array\";\n  for (const protectedPath of protectedCorpusPaths) {\n    const protectedVariants = pathVariants(protectedPath);\n    if (!protectedVariants.length) return \"candidate sandbox protected corpus paths must be absolute\";\n    for (const source of sources) {\n      const sourceVariants = pathVariants(source);\n      if (sourceVariants.some((left) => protectedVariants.some((right) => pathOverlaps(left, right)))) {\n        return `candidate sandbox host mount overlaps protected corpus material: ${source}`;\n      }\n    }\n  }\n  return null;\n}\n\nexport function sandboxAvailable() {\n  if (sandboxPreflight !== undefined) return sandboxPreflight;\n  try {\n    if (!fs.statSync(BWRAP).isFile() || (fs.statSync(BWRAP).mode & 0o111) === 0) return (sandboxPreflight = false);\n    const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--proc\", \"/proc\", \"--dev\", \"/dev\"];\n    for (const source of SYSTEM_BINARIES) {\n      try {\n        if (fs.statSync(source).isDirectory()) {\n          if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n          args.push(\"--ro-bind\", source, source);\n        }\n      } catch {}\n    }\n    args.push(\"--clearenv\", \"--\", \"/usr/bin/unshare\", \"-Ur\", \"true\");\n    const result = spawnSync(BWRAP, args, { encoding: \"utf8\", timeout: 5000, env: {} });\n    // The sandbox itself must start, and nested user namespaces must be unavailable to the payload.\n .github/workflows/ci.yml        |  34 ++---------\n cli/test/eval_hardened.test.ts  |   2 +-\n cli/test/eval_integrity.test.ts |  94 ++++++++++++++++++++++++++----\n eval/isolate.mjs                | 126 +++++++++++++++++++++++++++++++++++-----\n 4 files changed, 202 insertions(+), 54 deletions(-)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18678-40eb-70b2-b167-11dc8ca1d04f","create_time":1793257739.4146943}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
