{"timestamp":"2026-10-29T07:22:59.454Z","ordinal":497992,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18686-7f9d-7a01-aaee-252d4871c34f","item":{"type":"McpToolCall","id":"exec-c2784131-779e-4c39-af7e-7e56405dbd01","server":"xerj","tool":"xerj_search","arguments":{"prefix":"nexus-cli","query":"provider connection picker list available connect methods local endpoint appliance","size":6},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /nexus-cli-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"provider connection picker list available connect methods local endpoint appliance\",\"k\":10}}}}}]},\"took\":786,\"timed_out\":false,\"_shards\":{\"total\":1,\"successful\":1,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":164,\"relation\":\"eq\"},\"max_score\":88.02747,\"hits\":[{\"_index\":\"nexus-cli-docs\",\"_id\":\"6a8002bf2e2f84338f0792fdcc3fcbcb\",\"_score\":88.02747,\"_source\":{\"title\":\"provider_connect.ts\",\"ax_path\":\"provider_connect.ts\",\"ax_file\":\"axf2-28c85d94f04c5df9d59377738a40c90b-396b\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":30,\"start_offset\":1811,\"end_offset\":2789,\"text\":\"export async function connectWithKey(base: HarnessConfig, providerId: string, key: string): Promise<{ ok: boolean; message: string }> {\\n  const def = providerDefinition(providerId);\\n  const value = key.trim();\\n  if (!def || !def.methods.some((m) => m.kind === \\\"key\\\")) return { ok: false, message: `${providerId} does not take an API key.` };\\n  if (!value || /\\\\s/.test(value)) return { ok: false, message: \\\"That does not look like an API key.\\\" };\\n  try {\\n    const count = await verify(base, providerId, value);\\n    saveCredential(providerId, { type: \\\"api\\\", key: value, savedAt: new Date().toISOString() });\\n    const shadow = def.credentialEnv && process.env[def.credentialEnv]?.trim() ? ` Note: $${def.credentialEnv} is set and takes precedence over the saved key.` : \\\"\\\";\\n    return { ok: true, message: `${def.label} connected (${count} models available).${shadow}` };\\n  } catch (err) {\\n    return { ok: false, message: `${def.label} key not saved: ${describe(err)}.` };\\n  }\\n}\"}]},\"match_line\":34,\"match_lines\":[34,40]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"173749e41ee3b41b440eb2892b0cbd48\",\"_score\":84.74274,\"_source\":{\"title\":\"model_catalog.ts\",\"ax_path\":\"model_catalog.ts\",\"ax_file\":\"axf2-9036bdecc4549abdcd13797b41adf210-229a\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":0,\"start_offset\":0,\"end_offset\":2004,\"text\":\"/**\\n * What the model picker shows: the appliance and every cloud provider, whether and how each is connected, the models\\n * each lists, and the operator's recent selections. Listing never blocks on a slow or offline provider: each list\\n * is fetched with a timeout and falls back to the last good list cached in ~/.cache/nexus/models.\\n */\\nimport * as fs from \\\"node:fs\\\";\\nimport * as path from \\\"node:path\\\";\\nimport { createHash } from \\\"node:crypto\\\";\\nimport { credentialStorageHome, LocalLlmClient, operatorSetting } from \\\"./client.js\\\";\\nimport { applianceEndpointSelection, buildConfig, providerBaseUrl, providerKey } from \\\"./config.js\\\";\\nimport { resolveCredential } from \\\"./credentials.js\\\";\\nimport { originOf, PROVIDERS, providerDefinition, type ConnectMethod } from \\\"./providers.js\\\";\\nimport type { HarnessConfig } from \\\"./types.js\\\";\\n\\n/** The appliance's id in the picker (it is not a cloud provider). */\\nexport const APPLIANCE = \\\"appliance\\\";\\n\\nexport interface CatalogProvider {\\n  id: string;\\n  label: string;\\n  /** \\\"local\\\" for the appliance, \\\"cloud\\\" otherwise. */\\n  disclosure: \\\"local\\\" | \\\"cloud\\\";\\n  connected: boolean;\\n  /** Where the connection's credential comes from (\\\"$OPENROUTER_API_KEY\\\", \\\"Nexus\\\", \\\"Codex CLI\\\", ...). */\\n  source?: string;\\n  /** True when the credential is read from another client (Codex CLI, opencode, crush, Copilot plugin). */\\n  external?: boolean;\\n  methods: ConnectMethod[];\\n  status: \\\"ok\\\" | \\\"cached\\\" | \\\"error\\\" | \\\"disconnected\\\";\\n  error?: string;\\n}\\n\\nexport interface CatalogModel {\\n  provider: string;\\n  id: string;\\n}\\n\\nexport interface ModelRef {\\n  provider: string;\\n  model: string;\\n}\\n\\nexport interface Catalog {\\n  providers: CatalogProvider[];\\n  models: CatalogModel[];\\n  current: ModelRef;\\n  recent: ModelRef[];\\n}\\n\\nconst MAX_RECENT = 8;\\nconst stateFile = () => path.join(credentialStorageHome(), \\\".local/state/nexus/recent-models.json\\\");\\nconst cacheFile = (id: string) => path.join(credentialStorageHome(), \\\".cache/nexus/models\\\", `${id.replace(/[^a-z0-9_-]/gi, \\\"_\\\")}.json`);\\n\"}]},\"match_line\":24,\"match_lines\":[2,3,4,15,21,22,24,28]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"c7c37832e930a9205bd08656efda58ef\",\"_score\":75.47867,\"_source\":{\"title\":\"mcp.ts\",\"ax_path\":\"mcp.ts\",\"ax_file\":\"axf2-f8967771815840f644c8e73b80efde5b-86d8\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":44,\"start_offset\":1114,\"end_offset\":3160,\"text\":\"    name: string;\\n    description?: string;\\n    required?: boolean;\\n  }>;\\n}\\n\\n/**\\n * The environment an MCP server starts with: basic process, locale, proxy and CA-trust variables only (no credentials\\n * or other secrets of the Nexus process), plus the server's own `env` from its configuration — which is where a server\\n * that needs a token gets it.\\n */\\nexport function buildMcpEnvironment(customEnv?: Record<string, string>): Record<string, string> {\\n  const SAFE_VARS = new Set([\\n    \\\"PATH\\\", \\\"HOME\\\", \\\"LANG\\\", \\\"LC_ALL\\\", \\\"LC_CTYPE\\\", \\\"TERM\\\", \\\"USER\\\", \\\"LOGNAME\\\",\\n    \\\"SHELL\\\", \\\"TMPDIR\\\", \\\"NODE_PATH\\\", \\\"XDG_RUNTIME_DIR\\\", \\\"XDG_CONFIG_HOME\\\", \\\"XDG_DATA_HOME\\\",\\n    // Network access through a proxy and custom certificate authorities (no credentials are implied by these).\\n    \\\"HTTP_PROXY\\\", \\\"HTTPS_PROXY\\\", \\\"NO_PROXY\\\", \\\"ALL_PROXY\\\", \\\"http_proxy\\\", \\\"https_proxy\\\", \\\"no_proxy\\\", \\\"all_proxy\\\",\\n    \\\"SSL_CERT_FILE\\\", \\\"SSL_CERT_DIR\\\", \\\"NODE_EXTRA_CA_CERTS\\\", \\\"REQUESTS_CA_BUNDLE\\\", \\\"CURL_CA_BUNDLE\\\",\\n  ]);\\n  const env: Record<string, string> = {};\\n  for (const [k, v] of Object.entries(process.env)) {\\n    if (v !== undefined && SAFE_VARS.has(k)) {\\n      env[k] = v;\\n    }\\n  }\\n  if (customEnv) {\\n    for (const [k, v] of Object.entries(customEnv)) {\\n      if (v !== undefined) {\\n        env[k] = v;\\n      }\\n    }\\n  }\\n  return env;\\n}\\n\\nexport class McpConnection {\\n  public serverName: string;\\n  public config: McpServerConfig;\\n  public transport: \\\"stdio\\\" | \\\"sse\\\" | \\\"websocket\\\" | \\\"http\\\" = \\\"stdio\\\";\\n  private child: ChildProcess | null = null;\\n  private ws: any = null;\\n  private nextRequestId: number = 1;\\n  private pendingRequests: Map<number, { resolve: (val: any) => void; reject: (err: any) => void }> = new Map();\\n  private tools: McpToolSchema[] = [];\\n  private resources: McpResourceSchema[] = [];\\n  private prompts: McpPromptSchema[] = [];\\n  public connected: boolean = false;\\n  private stdoutBuffer: string = \\\"\\\";\\n\\n  constructor(serverName: string, config: McpServerConfig) {\\n    this.serverName = serverName;\\n    this.config = config;\\n    if (config.transport) {\"}]}},{\"_index\":\"nexus-cli-docs\",\"_id\":\"9a4b800e6defcf417cc7e9cb12c94935\",\"_score\":74.56424,\"_source\":{\"title\":\"providers.ts\",\"ax_path\":\"providers.ts\",\"ax_file\":\"axf2-22ffaa0486a3f878e50dc82fdd7b622c-1fc0\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":136,\"start_offset\":5275,\"end_offset\":7314,\"text\":\"  /** Undefined for the legacy appliance/endpoint path. */\\n  providerId?: string;\\n  label: string;\\n  protocol: WireProtocol;\\n  auth: AuthStyle;\\n  staticHeaders: Record<string, string>;\\n  usage: ProviderDefinition[\\\"usage\\\"] | \\\"none\\\";\\n  /** Whether requests carry the appliance's X-Task-Class routing hint. */\\n  sendTaskClass: boolean;\\n  streamOnly: boolean;\\n  omitParams: string[];\\n}\\n\\n/** Copilot serves some models through the Responses API only. */\\nexport function protocolFor(providerId: string | undefined, model: string): WireProtocol | undefined {\\n  if (providerId === \\\"copilot\\\" && /^gpt-5/i.test(model)) return \\\"openai-responses\\\";\\n  return undefined;\\n}\\n\\nexport function connectionFor(providerId: string | undefined, model = \\\"\\\"): ResolvedConnection {\\n  const def = providerDefinition(providerId);\\n  if (!def) {\\n    // Usage is requested (OpenAI-compatible servers such as llama.cpp, vLLM and the appliance gateway report it, with\\n    // cached-token counts); a server that rejects stream_options has it dropped and the request retried.\\n    return { label: \\\"endpoint\\\", protocol: \\\"openai-chat\\\", auth: \\\"bearer\\\", staticHeaders: {}, usage: \\\"stream-options\\\", sendTaskClass: true, streamOnly: false, omitParams: [] };\\n  }\\n  return {\\n    providerId: def.id,\\n    label: def.label,\\n    protocol: protocolFor(def.id, model) ?? def.protocol,\\n    auth: def.auth,\\n    staticHeaders: { ...(def.staticHeaders ?? {}) },\\n    usage: def.usage,\\n    sendTaskClass: false,\\n    streamOnly: Boolean(def.streamOnly),\\n    omitParams: [...(def.omitParams ?? [])],\\n  };\\n}\\n\\n/**\\n * Disclosure class of a destination: \\\"cloud\\\" when content sent there leaves the operator's machines and network.\\n * URL locality is not sufficient: an origin the operator lists in NEXUS_CLOUD_ROUTED_ORIGINS (a local gateway that\\n * forwards to a cloud service) is cloud, and every named provider except `compatible` is cloud by definition.\\n */\\nexport function disclosureClass(url: string, providerId: string | undefined, cloudRoutedOrigins: readonly string[] = []): \\\"local\\\" | \\\"cloud\\\" {\"}]},\"match_line\":179,\"match_lines\":[137,144,159,161,178,179,181]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"7dca3b6530ab467e3c984d24dbe9fa7b\",\"_score\":69.84008,\"_source\":{\"title\":\"client.ts\",\"ax_path\":\"client.ts\",\"ax_file\":\"axf2-33f9bd7d6b5dee989d474b71676aaa45-17404\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":683,\"start_offset\":32589,\"end_offset\":34425,\"text\":\"private preflight(url: string, requestId: string, payloadChars: number): void {\\n    if (this.conn.providerId) {\\n      if (!this.model) {\\n        throw new InferenceError(\\\"configuration_error\\\", \\\"client\\\", `Provider '${this.conn.providerId}' needs an explicit model: pass --model or set NEXUS_MODEL.`, { requestId, failoverEligible: false });\\n      }\\n      if (this.conn.auth !== \\\"none\\\" && !this.credentialFor(url) && !this.declaredAuthless()) {\\n        const variable = operatorSettingKeyForAuth(this.conn.providerId);\\n        throw new InferenceError(\\\"configuration_error\\\", \\\"client\\\", `No credential for provider '${this.conn.providerId}': set ${variable}. Nexus never substitutes another provider's or the appliance's credential.`, {\\n          requestId,\\n          failoverEligible: false,\\n          condition: \\\"AUTH_FAILURE\\\",\\n        });\\n      }\\n    }\\n    if (this.disclosureOf(url) !== \\\"cloud\\\") return;\\n    // Spending limits cover provider connections, whose requests are recorded; the legacy endpoint path has no receipts.\\n    if (this.conn.providerId) {\\n      this.reservations.push(requestId);\\n      const reason = UsageLedger.global().admit(requestId, Math.ceil(payloadChars / 4) + this.maxOutputTokens, this.conn.usage === \\\"openrouter\\\");\\n      if (reason) throw new InferenceError(\\\"policy_denied\\\", \\\"client\\\", `Cloud spending limit: ${reason}.`, { requestId, failoverEligible: false });\\n    }\\n    const origin = originOf(url) ?? url;\\n    if (!announcedDestinations.has(origin)) {\\n      announcedDestinations.add(origin);\\n      const locality = classifyLocality(url);\\n      this.emitDiagnostic(\\\"error\\\", pc.dim(`[nexus] Cloud inference: ${this.conn.label} (${origin}, locality: ${locality.reason}), model ${this.model || \\\"(unset)\\\"}. Task content — prompts, tool results and file excerpts — is sent to this provider.`));\\n    }\\n  }\"}]},\"match_line\":691,\"match_lines\":[687,691,699,709]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"4ecf92c92d21d56a8a88f813ebf490a8\",\"_score\":49.16868,\"_source\":{\"title\":\"resources.ts\",\"ax_path\":\"core/resources.ts\",\"ax_file\":\"axf2-a15f5020befdf667b5cc1f10ad029d7a-4b86\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":118,\"start_offset\":4583,\"end_offset\":6631,\"text\":\"  maxIterations: 0,\\n};\\n\\nconst TRUST_RANK: Record<DestinationTrustBoundary, number> = { HOST_LOCAL: 4, LOCAL_APPLIANCE: 3, EXTERNAL_BOUNDED: 2, EXTERNAL_PUBLIC: 1 };\\nconst ACCOUNT_CODES = new Set([\\\"insufficient_quota\\\", \\\"quota_exceeded\\\", \\\"billing_hard_limit_reached\\\"]);\\nconst POOL_CODES = new Set([\\\"capacity_exhausted\\\", \\\"pool_unavailable\\\"]);\\n\\nexport function credentialFingerprint(secret: string | undefined, identity: OperationAccountIdentity): string | undefined {\\n  return identity.fingerprint(secret);\\n}\\n\\nexport function scopeKey(resource: ResourceDescriptor, scope: ConditionScope): string | undefined {\\n  switch (scope) {\\n    case \\\"model\\\":\\n      return `${resource.provider}|model|${resource.model}`;\\n    case \\\"endpoint\\\":\\n      return `endpoint|${resource.endpoint}`;\\n    case \\\"provider\\\":\\n      return `provider|${resource.provider}`;\\n    case \\\"account\\\":\\n      return `${resource.provider}|account|${resource.account ?? \\\"default\\\"}`;\\n    case \\\"pool\\\":\\n      return resource.pool ? `${resource.provider}|pool|${resource.pool}` : undefined;\\n  }\\n}\\n\\nconst SCOPES: ConditionScope[] = [\\\"model\\\", \\\"endpoint\\\", \\\"provider\\\", \\\"account\\\", \\\"pool\\\"];\\n\\n/** Condition and scope evidenced by one failure; null when the failure is about the request, not the resource. */\\nexport function conditionFromFailure(\\n  resource: ResourceDescriptor,\\n  failure: InferenceFailure,\\n): { condition: ResourceCondition; scope: ConditionScope; temporary: boolean } | null {\\n  const code = failure.hints?.errorCode ?? failure.hints?.errorType;\\n  const limitScope = (): ConditionScope => (code && ACCOUNT_CODES.has(code) ? \\\"account\\\" : resource.rateLimitScope ?? \\\"model\\\");\\n  switch (failure.condition) {\\n    case \\\"RATE_LIMITED\\\":\\n      return { condition: \\\"RATE_LIMITED\\\", scope: limitScope(), temporary: true };\\n    case \\\"OVERLOADED\\\":\\n      return { condition: \\\"OVERLOADED\\\", scope: code && POOL_CODES.has(code) && resource.pool ? \\\"pool\\\" : \\\"model\\\", temporary: true };\\n    case \\\"DRAINING\\\":\\n      return { condition: \\\"DRAINING\\\", scope: \\\"endpoint\\\", temporary: true };\\n    case \\\"AUTH_FAILURE\\\":\"}]},\"match_line\":135,\"match_lines\":[133,134,135,136,137,139,145,160]}]}}"}],"isError":false},"duration":{"secs":1,"nanos":107588586}},"started_at_ms":1793258578336,"completed_at_ms":1793258579453}}
