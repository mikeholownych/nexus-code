ef.id})`);\norigin/main:cli/src/provider_connect.ts:230:      message: `${removed ? \"Removed Nexus's saved credential. \" : \"\"}${def.label} is still connected via ${still.source}; Nexus does not change ${still.kind === \"env\" ? \"your environment\" : \"other clients' sign-ins\"}.`,\norigin/main:cli/src/provider_connect.ts:280:  if (!connectionOf(def.id).connected) return { ok: false, message: `${def.label} is not connected. Open /model and press ctrl+p to connect it.` };\norigin/main:cli/src/providers.ts:17:/** How an operator can connect a provider from the TUI or `nexus connect`. */\norigin/main:cli/src/providers.ts:32:  /** Environment variable holding this provider's key (none for sign-in-only providers). Sent only to the connection's own origin. */\norigin/main:cli/src/providers.ts:156:export function connectionFor(providerId: string | undefined, model = \"\"): ResolvedConnection {\norigin/main:cli/src/providers.ts:193:/** The environment variable a provider connection reads its key from (for operator-facing messages). */\norigin/main:cli/src/sidecar.ts:63:import { cancelLocalEndpointSetup, clearLocalEndpointSetup, clearLocalEndpointSetupAfterSelectionFailure, connectWithKey, disconnect, prepareLocalEndpoint, selectModel, startSignIn } from \"./provider_connect.js\";\norigin/main:cli/src/sidecar.ts:208:      case \"provider.connect\":\norigin/main:cli/src/sidecar.ts:210:          this.emit({ type: \"provider.result\", id: command.id, provider: command.provider, success: false, message: \"Provider connections are disabled while the session is in read-only mode.\" });\norigin/main:cli/src/sidecar.ts:213:        void this.providerConnect(command.id, command.provider, command.method, command.key, command.endpoint);\norigin/main:cli/src/sidecar.ts:223:      case \"provider.disconnect\": {\norigin/main:cli/src/sidecar.ts:259:  private async providerConnect(id: string, provider: string, method: string, key?: string, endpoint?: string): Promise<void> {\norigin/main:cli/src/slash/catalog.ts:94:  { name: \"model\", usage: \"/model [provider] [model]\", summary: \"Choose a model from any connected provider (ctrl+p connects one)\" },\norigin/main:cli/src/slash/session_commands.ts:4:import { selectModel } from \"../provider_connect.js\";\norigin/main:cli/src/slash/session_commands.ts:165:      const status = p.connected ? `connected${p.source ? ` via ${p.source}` : \"\"}${p.status === \"cached\" ? \" · offline, cached list\" : p.status === \"error\" ? ` · ${p.error}` : \"\"}` : `not connected — nexus connect ${p.id}`;\norigin/main:cli/src/slash/session_commands.ts:172:    lines.push(\"\", \"Switch with /model <provider> <model>. In the live view, /model opens the picker and ctrl+p connects a provider.\");\norigin/main:cli/src/usage.ts:2: * Inference usage ledger: one receipt per provider-connection request (main agent, planner/coder, subagents and\n"},{"type":"input_text","text":"local setup strings\norigin/main:cli/src/provider_cli.ts:23:    const label = provider ? PROVIDERS[provider]?.label ?? \"Cloud provider\" : \"Local endpoint\";\norigin/main:cli/src/provider_cli.ts:283:    .description(\"Connect a cloud provider or configure a local OpenAI-compatible endpoint\")\norigin/main:cli/src/provider_cli.ts:284:    .argument(\"<provider>\", \"local, openrouter, openai, anthropic, chatgpt, copilot, compatible\")\norigin/main:cli/src/provider_cli.ts:287:      if (providerId === \"local\" || providerId === \"appliance\") {\norigin/main:cli/src/provider_cli.ts:289:          console.error(pc.red(\"Local endpoint setup requires an interactive terminal.\"));\norigin/main:cli/src/provider_cli.ts:295:          base = buildConfig({ appliance: true });\norigin/main:cli/src/provider_cli.ts:297:          console.error(pc.red(\"Could not read the current local endpoint configuration.\"));\norigin/main:cli/src/provider_connect.ts:8:import { APPLIANCE, applianceConfig, chatModel, connectionOf, providerConfig, recordRecent, type ModelRef } from \".