urn \"hidden black-box oracle argv must be a normalized relative candidate entrypoint\";\n    61\t  }\n    62\t  if (!Number.isSafeInteger(check.timeoutMs) || check.timeoutMs < 100 || check.timeoutMs > MAX_TIMEOUT_MS) return \"hidden black-box oracle timeout is outside the allowed range\";\n    63\t  if (!Number.isSafeInteger(check.totalTimeoutMs) || check.totalTimeoutMs < check.timeoutMs || check.totalTimeoutMs > MAX_TOTAL_TIMEOUT_MS) return \"hidden black-box oracle total timeout is outside the allowed range\";\n    64\t  if (!Number.isSafeInteger(check.maxOutputBytes) || check.maxOutputBytes < 2 || check.maxOutputBytes > MAX_OUTPUT_BYTES) return \"hidden black-box oracle output limit is outside the allowed range\";\n    65\t  return null;\n    66\t}\n    67\t\n    68\t/** Run candidate code as a black box. Only bounded summaries leave this function; raw output is discarded. */\n    69\texport async function runBlackBoxOracle(task, workspace, check, { resources = null, protectedCorpusPaths = [] } = {}) {\n    70\t  const problem = blackBoxOracleProblem(check, task.dir, task.fixture ?? null);\n    71\t  if (problem) throw new Error(problem);\n    72\t  const casesPath = confinedPath(task.dir, check.casesFile);\n    73\t  const entrypoint = confinedPath(workspace, check.argv[0]);\n    74\t  if (!fs.statSync(entrypoint).isFile()) throw new Error(\"black-box candidate entrypoint is not a regular file\");\n    75\t  const cases = JSON.parse(fs.readFileSync(casesPath, \"utf8\"));\n    76\t  const command = RUNTIMES[check.runtime];\n    77\t  const failures = [];\n    78\t  const timeoutCases = [];\n    79\t  const outputLimitCases = [];\n    80\t  const executionFailureCases = [];\n    81\t  const invalidOutputCases = [];\n    82\t  const mismatchCases = [];\n    83\t  const fixturePath = task.fixture ? confinedPath(task.dir, task.fixture) : null;\n    84\t  const candidateWorkspace = fs.realpathSync(workspace);\n    85\t  const relativeCases = path.relative(candidateWo