ry{value=fs.readFileSync(${JSON.stringify(canary)},'utf8')}catch{};try{fs.writeFileSync('/tmp/host-write-canary','changed')}catch{};const nested=cp.spawnSync('/usr/bin/unshare',['-Ur','true']);const toolchains={};for(const [name,args] of [['go',['version']],['rustc',['--version']],['cargo',['--version']]]){if(process.env.PATH.includes(name==='go'?'/usr/local/go/bin':'/usr/local/nexus-qual/rust/bin')){const check=cp.spawnSync(name,args,{encoding:'utf8'});toolchains[name]={status:check.status,stdout:check.stdout,stderr:check.stderr}}};const absoluteToolchains={};for(const [name,command,args] of [['go','/usr/bin/go',['version']],['rustc','/usr/bin/rustc',['--version']],['cargo','/usr/bin/cargo',['--version']]]){const check=cp.spawnSync(command,args,{encoding:'utf8'});absoluteToolchains[name]={status:check.status,error:check.error?.code??null,version:check.status===0?check.stdout.trim():null}};console.log(JSON.stringify({status:r.status,token:process.env.OPENAI_API_KEY,upstreamVisible:process.env.UPSTREAM_AUTH_CANARY??null,canary:value,nestedUserns:nested.status,toolchains,absoluteToolchains}))}).catch(e=>{console.error(e.message);process.exit(1)})`;\n  1442\t    process.env.UPSTREAM_AUTH_CANARY = \"UPSTREAM_AUTH_CANARY\";\n  1443\t    const candidatePath = candidateAgentPath(\"/usr/bin:/bin\");\n  1444\t    const child = await runSandbox(sandbox.cmd, sandbox.argv, JSON.stringify({ command: nodeRuntime, argv: [\"-e\", script], env: { PATH: candidatePath, OPENAI_API_KEY: \"RUN_LOCAL_TOKEN\" } }));\n  1445\t    assert.equal(child.status, 0, `${child.error ?? \"\"}\\n${child.stderr}\\n${child.stdout}\\nproxy=${JSON.stringify(proxy.stats())}\\nupstream=${JSON.stringify(seen)}`);\n  1446\t    const output = JSON.parse(child.stdout.trim());\n  1447\t    assert.equal(output.status, 200);\n  1448\t    assert.equal(output.token, \"RUN_LOCAL_TOKEN\");\n  1449\t    assert.equal(output.upstreamVisible, null);\n  1450\t    assert.equal(output.canary, \"\");\n  1451\t    assert.notEqual(output.nestedUserns, 0, \"candidate code could create a nested user namespace\");\n  1452\t    if (candidatePath.includes(\"/usr/local/go/bin\")) assert.equal(output.toolchains.go?.status, 0, `Go toolchain is not executable in candidate namespace: ${JSON.stringify(output.toolchains.go)}`);\n  1453\t    if (candidatePath.includes(\"/usr/local/nexus-qual/rust/bin\")) {\n  1454\t      assert.equal(output.toolchains.rustc?.status, 0, `Rust compiler is not executable in candidate namespace: ${JSON.stringify(output.toolchains.rustc)}`);\n  1455\t      assert.equal(output.toolchains.cargo?.status, 0, `Cargo is not executable in candidate namespace: ${JSON.stringify(output.toolchains.cargo)}`);\n  1456\t    }\n  1457\t    for (const [name, pinnedVersion] of [[\"go\", \"go version go1.22.12\"], [\"rustc\", \"rustc 1.95.0\"], [\"cargo\", \"cargo 1.95.0\"]] as const) {\n  1458\t      const absolute = output.absoluteToolchains[name];\n  1459\t      assert.ok(absolute.error === \"ENOENT\" || absolute.status !== 0 || absolute.version.startsWith(pinnedVersion), `${name} via absolute /usr/bin path was not pinned: ${JSON.stringify(absolute)}`);\n  1460\t    }\n  1461\t    assert.deepEqual(seen, [\"Bearer UPSTREAM_AUTH_CANARY\"]);\n  1462\t    assert.equal(fs.existsSync(\"/tmp/host-write-canary\"), false);\n  1463\t    assert.doesNotMatch(`${child.stdout}${child.stderr}`, /HOST_PRIVATE_CANARY|UPSTREAM_AUTH_CANARY/);\n  1464\t  } finally {\n  1465\t    delete process.env.UPSTREAM_AUTH_CANARY;\n …2021 tokens truncated…s unavailable\"; }\n   508\t  for (const root of roots) {\n   509\t    const rootProblem = protectedRuntimeRootProblem(root);\n   510\t    if (rootProblem) return rootProblem;\n   511\t  }\n   512\t  for (const item of readOnlyPaths) {\n   513\t    if (typeof item !== \"string\" || !path.isAbsolute(item)) return \"candidate runtime paths must be absolute\";\n   514\t    let resolved;\n   515\t    try { resolved = fs.realpathSync(item); }\n   516\t    catch { return `candidate runtime path is unavailable: ${item}`; }\n   517\t    const stat = fs.statSync(resolved);\n   518\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   519\t    const explicitlySelectedTempExecutable = executableFiles.includes(resolved) && stat.isFile() && resolved.startsWith(`/tmp${path.sep}`);\n   520\t    if (FORBIDDEN_RUNTIME_ROOTS.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !explicitlySelectedTempExecutable) {\n   521\t      return `protected candidate runtime path is forbidden: ${resolved}`;\n   522\t    }\n   523\t    if (resolved === os.homedir() || (resolved.startsWith(`${os.homedir()}${path.sep}`) && resolved.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part)))) {\n   524\t      return `sensitive candidate runtime path is forbidden: ${resolved}`;\n   525\t    }\n   526\t    if (!stat.isFile() && !stat.isDirectory()) return `candidate runtime path is not a regular file or directory: ${resolved}`;\n   527\t    if (!roots.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !executableFiles.includes(resolved)) {\n   528\t      return `candidate runtime path is outside its explicit allowlist: ${resolved}`;\n   529\t    }\n   530\t    if (executableFiles.includes(resolved) && !stat.isFile()) return `candidate runtime executable is not a regular file: ${resolved}`;\n   531\t    if (stat.isDirectory()) assertNoSymlinks(resolved);\n   532\t  }\n   533\t  return null;\n   534\t}\n   535\t\n   536\tfunction protectedRuntimeRootProblem(root) {\n   537\t  if (root.startsWith(`${os.homedir()}${path.sep}`) && root.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part))) return `sensitive candidate runtime root is forbidden: ${root}`;\n   538\t  if (root === \"/\" || root === \"/home\" || root === os.homedir() || FORBIDDEN_RUNTIME_ROOTS.some((item) => root === item || root.startsWith(`${item}${path.sep}`))) return `protected candidate runtime root is forbidden: ${root}`;\n   539\t  return null;\n   540\t}\n   541\t\n   542\texport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n   543\t  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n   544\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   545\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   546\t  const compilerExposure = scanOracleCompilerExposure(\n   547\t    mountSources.systemDirectories,\n   548\t    mountSources.systemEtcDirectories,\n   549\t    mountSources.runtimeSources.readOnlyPaths,\n   550\t  );\n   551\t  if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n   552\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n   553\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n   554\t  if (mountProblem) throw new Error(mountProblem);\n   555\t  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n   556\t    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n   557\t  }\n   558\t  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n   559\t  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n   560\t    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n   575\t  const addTargetParents = (target) => {\n   576\t    const parts = target.split(path.sep).filter(Boolean);\n   577\t    let current = \"\";\n   578\t    for (const part of parts.slice(0, -1)) {\n   579\t      current += `/${part}`;\n   580\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   581\t    }\n   582\t  };\n   583\t  for (const resolved of mountSources.runtimeSources.readOnlyPaths) {\n   584\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   585\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   586\t    addTargetParents(resolved);\n   587\t    args.push(\"--ro-bind\", resolved, resolved);\n   588\t  }\n   589\t  args.push(...compilerExposureMaskArgs(compilerExposure));\n   590\t  addTargetParents(\"/runner/agent_sandbox.mjs\");\n   591\t  args.push(\"--ro-bind\", nodeRuntime, \"/runner/node\");\n   592\t  args.push(\"--ro-bind\", mountSources.runtimeSources.supervisorPath, \"/runner/agent_sandbox.mjs\");\n   593\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"CI\", \"1\", \"--\");\n   594\t  args.push(\"/runner/node\", \"/runner/agent_sandbox.mjs\");\n   595\t  return { cmd: BWRAP, argv: args };\n   596\t}\n   597\t\n   598\t/** Run a fixed executable probe without exposing the host filesystem, environment, or network. */\n   599\texport function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [], allowedRoots = [], allowedFiles = [], timeoutMs = 5000, workspaceReadOnly = false, protectedCorpusPaths = [], oracleToolchains = false, systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS }) {\n   600\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing executable probe\");\n   601\t  let compilerExposure = null;\n   602\t  if (oracleToolchains) {\n   603\t    const additionalMountedPaths = readOnlyPaths.map((item) => fs.realpathSync(item));\n   604\t    compilerExposure = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths);\n   605\t    if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n   606\t    const problem = pinnedOracleToolchainsProblem();\n   607\t    if (problem) throw new Error(problem);\n   608\t  }\n   609\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles);\n   610\t  if (mountProblem) throw new Error(mountProblem);\n   611\t  const workspace = fs.realpathSync(cwd);\n   612\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   613\t  for (const source of systemDirectories) {\n   614\t    try {\n   615\t      if (fs.statSync(source).isDirectory()) {\n   616\t        if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   617\t        args.push(\"--ro-bind\", source, source);\n   618\t      }\n   619\t    } catch {}\n   620\t  }\n   621\t  if (oracleToolchains) {\n   622\t    for (const { root } of PINNED_ORACLE_TOOLCHAINS) {\n   623\t      const parent = path.dirname(root);\n   624\t      addOracleMountParent(args, parent);\n   625\t      args.push(\"--ro-bind\", root, root);\n   626\t    }\n   627\t  }\n   628\t  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n   629\t    try { if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source); } catch {}\n   630\t  }\n   631\t  for (const source of systemEtcDirectories) {\n   632\t    try { if (fs.statSync(source).isDirectory()) args.push(\"--ro-bind\", source, source); } catch {}\n   633\t  }\n   634\t  args.push(workspaceReadOnly ? \"--ro-bind\" : \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--tmpfs\", \"/run\", \"--symlink\", \"usr/bin\", \"/bin\");\n   635\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/