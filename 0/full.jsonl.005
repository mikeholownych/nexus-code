: steering applied, probe answered and scored\", { timeout: 300_000 }, async () => {\n302:test(\"the real T3 runner fails closed when a candidate-created fact path symlinks to an external canary\", { timeout: 300_000 }, async () => {\n354:test(\"the T3 gate passes only a full, clean 8 × 5 workload with no false absence or false presence\", () => {\n383:test(\"a steer counts as violable only if its constraint could fail: path present, or command failing at baseline\", async () => {\n397:test(\"a command baseline that does not exit cleanly is a harness error, never a granted precondition\", async () => {\n10:import { spawn, spawnSync } from \"node:child_process\";\n49:const tick = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));\n246:test(\"a T3 run drives the real sidecar through the sandbox: steering applied, probe answered and scored\", { timeout: 300_000 }, async () => {\n285:    assert.equal(record.t3.eligible, false, \"a short smoke run is reported as not a qualifying T3 run\");\n288:    const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(out, \"results.jsonl\"), \"--json\"], { encoding: \"utf8\" });\n302:test(\"the real T3 runner fails closed when a candidate-created fact path symlinks to an external canary\", { timeout: 300_000 }, async () => {\n366:    const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), file, \"--json\"], { encoding: \"utf8\" });\n","exit_code":0,"duration":{"secs":0,"nanos":703737053}},"started_at_ms":1793282036817,"completed_at_ms":1793282037522}}
