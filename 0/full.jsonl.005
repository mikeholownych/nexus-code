{"timestamp":"2026-10-29T07:33:30.956Z","ordinal":498458,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18686-7f9d-7a01-aaee-252d4871c34f","item":{"type":"CommandExecution","id":"exec-d368c082-4f1f-468d-bf89-39c7415af8a0","process_id":"1509","command":["/usr/bin/zsh","-lc","nl -ba /home/mike/nexus-wt/eval-agent-toolchain-binds/cli/test/eval_integrity.test.ts | sed -n '470,570p'; nl -ba /home/mike/nexus-wt/eval-agent-toolchain-binds/eval/isolate.mjs | sed -n '190,270p'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"read","cmd":"nl -ba /home/mike/nexus-wt/eval-agent-toolchain-binds/cli/test/eval_integrity.test.ts","name":"eval_integrity.test.ts","path":"/home/mike/nexus-wt/eval-agent-toolchain-binds/cli/test/eval_integrity.test.ts"},{"type":"read","cmd":"nl -ba /home/mike/nexus-wt/eval-agent-toolchain-binds/eval/isolate.mjs","name":"isolate.mjs","path":"/home/mike/nexus-wt/eval-agent-toolchain-binds/eval/isolate.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"   470\t  const fixtureWorkspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-fixture-ws-\"));\n   471\t  fs.mkdirSync(path.join(fixtureTask, \"fixture\"));\n   472\t  fs.writeFileSync(path.join(fixtureTask, \"fixture\", \"private.json\"), JSON.stringify([{ input: {}, expected: canary }]));\n   473\t  await assert.rejects(\n   474\t    runBlackBoxOracle({ dir: fixtureTask, fixture: \"fixture\" }, fixtureWorkspace, { ...check, casesFile: \"fixture/private.json\" }),\n   475\t    /outside the candidate fixture/,\n   476\t  );\n   477\t});\n   478\t\n   479\ttest(\"Python black-box oracle uses only pinned offline Go and Rust toolchains, or fails preflight\", { timeout: 60_000 }, async (t) => {\n   480\t  const { blackBoxOracleProblem, runBlackBoxOracle } = await import(path.join(ROOT, \"eval/oracle.mjs\"));\n   481\t  const { candidateToolchainRootProblem, oracleCompilerExposureProblem, oracleToolchainPathProblem, oracleToolchainVersionProblem, oracleToolchainsProblem, isolatedProcessArgv, sandboxAvailable } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   482\t  const toolchainPolicy = JSON.parse(fs.readFileSync(path.join(ROOT, \"eval/toolchain-versions.json\"), \"utf8\"));\n   483\t  const rustToolchain = fs.readFileSync(path.join(ROOT, \"rust-toolchain.toml\"), \"utf8\");\n   484\t  const workflow = fs.readFileSync(path.join(ROOT, \".github/workflows/ci.yml\"), \"utf8\");\n   485\t  assert.equal(toolchainPolicy.go, \"1.22.12\");\n   486\t  assert.equal(toolchainPolicy.rust, /^channel = \"([^\"]+)\"$/m.exec(rustToolchain)?.[1]);\n   487\t  assert.equal((workflow.match(/go-version: '([^']+)'/g) ?? []).length, 2);\n   488\t  assert.equal((workflow.match(/go-version: '1\\.22\\.12'/g) ?? []).length, 2, \"both CI jobs install the exact approved Go version\");\n   489\t  assert.equal((workflow.match(/run: bash scripts\\/install-evaluator-toolchains\\.sh/g) ?? []).length, 2, \"both CI jobs use the same exact-version installer\");\n   490\t  assert.equal(oracleToolchainVersionProblem({\n   491\t    goVersion: \"go version go1.22.12 linux/amd64\",\n   492\t    rustcVersion: \"rustc 1.95.0 (fixture)\",\n   493\t    cargoVersion: \"cargo 1.95.0 (fixture)\",\n   494\t  }), null);\n   495\t  assert.match(oracleToolchainVersionProblem({\n   496\t    goVersion: \"go version go1.22.11 linux/amd64\",\n   497\t    rustcVersion: \"rustc 1.95.0 (fixture)\",\n   498\t    cargoVersion: \"cargo 1.95.0 (fixture)\",\n   499\t  }), /do not match policy/);\n   500\t  assert.match(oracleToolchainVersionProblem({\n   501\t    goVersion: \"go version go1.22.12 linux/amd64\",\n   502\t    rustcVersion: \"rustc 1.94.0 (fixture)\",\n   503\t    cargoVersion: \"cargo 1.95.0 (fixture)\",\n   504\t  }), /do not match policy/);\n   505\t\n   506\t  const fakeSystem = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-system-\"));\n   507\t  const fakeAlternatives = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-alternatives-\"));\n   508\t  const fakeSymlinkTarget = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-target-\"));\n   509\t  const fakeLib = path.join(fakeSystem, \"rustlib\", \"bin\");\n   510\t  fs.mkdirSync(path.join(fakeSystem, \"bin\"), { recursive: true });\n   511\t  fs.mkdirSync(fakeLib, { recursive: true });\n   512\t  const compilerCanary = \"#!/bin/sh\\nprintf '%s\\\\n' UNPINNED_COMPILER_CANARY\\n\";\n   513\t  const fakeGo = path.join(fakeSystem, \"bin\", \"go\");\n   514\t  const fakeRustc = path.join(fakeLib, \"rustc\");\n   515\t  const fakeCargo = path.join(fakeSystem, \"bin\", \"cargo-1.94.0\");\n   516\t  for (const file of [fakeGo, fakeRustc, fakeCargo]) {\n   517\t    fs.writeFileSync(file, compilerCanary);\n   518\t    fs.chmodSync(file, 0o755);\n   519\t  }\n   520\t  fs.symlinkSync(fakeCargo, path.join(fakeAlternatives, \"cargo\"));\n   521\t  fs.symlinkSync(fakeCargo, path.join(fakeAlternatives, \"compiler-alias\"));\n   522\t  fs.writeFileSync(path.join(fakeSymlinkTarget, \"rustc\"), compilerCanary);\n   523\t  fs.chmodSync(path.join(fakeSymlinkTarget, \"rustc\"), 0o755);\n   524\t  fs.symlinkSync(fakeSymlinkTarget, path.join(fakeSystem, \"compiler-reach\"));\n   525\t  t.after(() => {\n   526\t    fs.rmSync(fakeSystem, { recursive: true, force: true });\n   527\t    fs.rmSync(fakeAlternatives, { recursive: true, force: true });\n   528\t    fs.rmSync(fakeSymlinkTarget, { recursive: true, force: true });\n   529\t  });\n   530\t  const exposure = oracleCompilerExposureProblem([fakeSystem], [fakeAlternatives]);\n   531\t  assert.match(exposure ?? \"\", /unapproved Go\\/Rust compiler executable/);\n   532\t  assert.match(exposure ?? \"\", /rustlib\\/bin\\/rustc/);\n   533\t  assert.match(exposure ?? \"\", /compiler-reach\\/rustc/);\n   534\t  assert.match(exposure ?? \"\", /eval-oracle-unpinned-compiler-alternatives-[^,]+\\/cargo/);\n   535\t  assert.match(exposure ?? \"\", /eval-oracle-unpinned-compiler-alternatives-[^,]+\\/compiler-alias/);\n   536\t  if (sandboxAvailable()) {\n   537\t    assert.throws(() => isolatedProcessArgv({\n   538\t      cwd: fakeSystem,\n   539\t      command: \"/usr/bin/true\",\n   540\t      readOnlyPaths: [\"/usr/bin/true\"],\n   541\t      allowedFiles: [\"/usr/bin/true\"],\n   542\t      oracleToolchains: true,\n   543\t      systemDirectories: [fakeSystem],\n   544\t      systemEtcDirectories: [fakeAlternatives],\n   545\t    }), /unapproved Go\\/Rust compiler executable/, \"the execution-path preflight rejects deliberate compiler escape fixtures\");\n   546\t  }\n   547\t\n   548\t  assert.equal(oracleToolchainPathProblem({ uid: 0, mode: 0o040755 }), null, \"root-owned read-only directories are eligible\");\n   549\t  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040775 }), /without group or other write permission/, \"group-writable toolchain paths must fail closed\");\n   550\t  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040757 }), /without group or other write permission/, \"other-writable toolchain paths must fail closed\");\n   551\t  assert.match(oracleToolchainPathProblem({ uid: 1234, mode: 0o040755 }), /root-owned/, \"non-root-owned paths are not pinned roots\");\n   552\t  const candidateRootStat = { uid: 0, mode: 0o040755, isDirectory: () => true, isSymbolicLink: () => false };\n   553\t  assert.equal(candidateToolchainRootProblem(candidateRootStat, \"/usr/local/nexus-qual/rust\", \"/usr/local/nexus-qual/rust\"), null);\n   554\t  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, isSymbolicLink: () => true }, \"/usr/local/nexus-qual/rust\", \"/usr/local/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject symlinked toolchain roots\");\n   555\t  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, mode: 0o040775 }, \"/usr/local/nexus-qual/rust\", \"/usr/local/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject group-writable toolchain roots\");\n   556\t  assert.match(candidateToolchainRootProblem(candidateRootStat, \"/tmp/toolchain\", \"/usr/local/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject roots resolving outside the pinned path\");\n   557\t  const taskDir = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-toolchain-task-\"));\n   558\t  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-toolchain-candidate-\"));\n   559\t  t.after(() => {\n   560\t    fs.rmSync(taskDir, { recursive: true, force: true });\n   561\t    fs.rmSync(workspace, { recursive: true, force: true });\n   562\t  });\n   563\t  fs.mkdirSync(path.join(workspace, \"src\"));\n   564\t  fs.writeFileSync(path.join(taskDir, \"private-cases.json\"), JSON.stringify([{ input: { value: \"fixture\" }, expected: { value: \"fixture\", go: \"go-ok\", rust: \"rust-ok\" } }]));\n   565\t  fs.writeFileSync(path.join(workspace, \"main.go\"), 'package main\\nimport \"fmt\"\\nfunc main(){fmt.Print(\"go-ok\")}\\n');\n   566\t  fs.writeFileSync(path.join(workspace, \"Cargo.toml\"), '[package]\\nname = \"nexus-oracle-canary\"\\nversion = \"0.1.0\"\\nedition = \"2021\"\\n');\n   567\t  fs.writeFileSync(path.join(workspace, \"Cargo.lock\"), '# This file is automatically @generated by Cargo.\\nversion = 4\\n\\n[[package]]\\nname = \"nexus-oracle-canary\"\\nversion = \"0.1.0\"\\n');\n   568\t  fs.writeFileSync(path.join(workspace, \"src/main.rs\"), 'fn main(){print!(\"rust-ok\")}\\n');\n   569\t  fs.writeFileSync(path.join(workspace, \"check.py\"), [\n   570\t    \"import json, subprocess, sys\",\n   190\t\n   191\texport function oracleToolchainsProblem({ systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS } = {}) {\n   192\t  const exposureProblem = oracleCompilerExposureProblem(systemDirectories, systemEtcDirectories);\n   193\t  if (exposureProblem) return exposureProblem;\n   194\t  for (const { root, required } of PINNED_ORACLE_TOOLCHAINS) {\n   195\t    const problem = pinnedToolchainProblem(root, required);\n   196\t    if (problem) return problem;\n   197\t  }\n   198\t  return oracleToolchainVersionProblem({\n   199\t    goVersion: executableVersion(\"/usr/local/go/bin/go\", [\"version\"]),\n   200\t    rustcVersion: executableVersion(\"/usr/local/nexus-qual/rust/bin/rustc\", [\"--version\"]),\n   201\t    cargoVersion: executableVersion(\"/usr/local/nexus-qual/rust/bin/cargo\", [\"--version\"]),\n   202\t  });\n   203\t}\n   204\t\n   205\tfunction pinnedToolchainProblem(root, required) {\n   206\t  const ancestors = [];\n   207\t  let parent = path.dirname(root);\n   208\t  while (parent !== path.dirname(parent)) {\n   209\t    ancestors.push(parent);\n   210\t    parent = path.dirname(parent);\n   211\t  }\n   212\t  ancestors.push(\"/\");\n   213\t  const directories = [...ancestors.reverse(), root];\n   214\t  const fingerprintPaths = [\"/\", ...directories, ...required.map((relative) => path.join(root, relative))];\n   215\t  const now = Date.now();\n   216\t  const cached = pinnedToolchainPreflights.get(root);\n   217\t  if (cached && cached.expiresAt > now) {\n   218\t    const current = oracleToolchainsFingerprint(cached.paths);\n   219\t    if (current && JSON.stringify(current) === JSON.stringify(cached.fingerprint)) return null;\n   220\t    pinnedToolchainPreflights.delete(root);\n   221\t  }\n   222\t  try {\n   223\t    for (const directory of directories) {\n   224\t      const stat = fs.lstatSync(directory);\n   225\t      if (!stat.isDirectory() || oracleToolchainPathProblem(stat) || fs.realpathSync(directory) !== directory) {\n   226\t        return \"pinned oracle toolchain path is unavailable or replaceable\";\n   227\t      }\n   228\t    }\n   229\t    const verifyTree = (directory) => {\n   230\t      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n   231\t        const item = path.join(directory, entry.name);\n   232\t        const stat = fs.lstatSync(item);\n   233\t        if ((!stat.isDirectory() && !stat.isFile()) || oracleToolchainPathProblem(stat)) return false;\n   234\t        if (entry.isDirectory() && !verifyTree(item)) return false;\n   235\t      }\n   236\t      return true;\n   237\t    };\n   238\t    if (!verifyTree(root)) return \"pinned oracle toolchain contents are not safely installed\";\n   239\t    for (const relative of required) {\n   240\t      const executable = path.join(root, relative);\n   241\t      const stat = fs.lstatSync(executable);\n   242\t      if (!stat.isFile() || oracleToolchainPathProblem(stat) || (stat.mode & 0o111) === 0 || fs.realpathSync(executable) !== executable) {\n   243\t        return \"pinned oracle toolchain executable is unavailable or not safely installed\";\n   244\t      }\n   245\t    }\n   246\t  } catch {\n   247\t    return \"pinned oracle toolchains are unavailable; refusing execution\";\n   248\t  }\n   249\t  const fingerprint = oracleToolchainsFingerprint(fingerprintPaths);\n   250\t  if (!fingerprint) return \"pinned oracle toolchain state could not be recorded\";\n   251\t  pinnedToolchainPreflights.set(root, { expiresAt: Date.now() + 30_000, fingerprint, paths: fingerprintPaths });\n   252\t  return null;\n   253\t}\n   254\t\n   255\tfunction oracleToolchainsFingerprint(paths) {\n   256\t  try {\n   257\t    return paths.map((item) => {\n   258\t      const stat = fs.lstatSync(item);\n   259\t      return [stat.dev, stat.ino, stat.uid, stat.gid, stat.mode, stat.size, stat.mtimeMs, stat.ctimeMs];\n   260\t    });\n   261\t  } catch {\n   262\t    return null;\n   263\t  }\n   264\t}\n   265\t\n   266\t/** Return the host paths that the candidate sandbox mounts, grouped by the bind logic. */\n   267\texport function candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths = [], nodeRuntime, supervisorPath } = {}) {\n   268\t  if (!Array.isArray(readOnlyPaths)) throw new Error(\"candidate sandbox readOnlyPaths must be an array\");\n   269\t  const existing = (paths, kind) => paths.filter((source) => {\n   270\t    try {\n","exit_code":0,"duration":{"secs":0,"nanos":29041}},"started_at_ms":1793259210956,"completed_at_ms":1793259210956}}
{"timestamp":"2026-10-29T07:33:32.406Z","ordinal":498459,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18694-0e75-7832-b258-9b2c88e6a878","call_id":"call_e702f85af01a4c9ab70d53dd7ee86354","output":[{"type":"input_text","text":"Script completed\nWall time 4.1 seconds\nOutput:\n"},{"type":"input_text","text":"   470\t  const fixtureWorkspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-fixture-ws-\"));\n   471\t  fs.mkdirSync(path.join(fixtureTask, \"fixture\"));\n   472\t  fs.writeFileSync(path.join(fixtureTask, \"fixture\", \"private.json\"), JSON.stringify([{ input: {}, expected: canary }]));\n   473\t  await assert.rejects(\n   474\t    runBlackBoxOracle({ dir: fixtureTask, fixture: \"fixture\" }, fixtureWorkspace, { ...check, casesFile: \"fixture/private.json\" }),\n   475\t    /outside the candidate fixture/,\n   476\t  );\n   477\t});\n   478\t\n   479\ttest(\"Python black-box oracle uses only pinned offline Go and Rust toolchains, or fails preflight\", { timeout: 60_000 }, async (t) => {\n   480\t  const { blackBoxOracleProblem, runBlackBoxOracle } = await import(path.join(ROOT, \"eval/oracle.mjs\"));\n   481\t  const { candidateToolchainRootProblem, oracleCompilerExposureProblem, oracleToolchainPathProblem, oracleToolchainVersionProblem, oracleToolchainsProblem, isolatedProcessArgv, sandboxAvailable } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   482\t  const toolchainPolicy = JSON.parse(fs.readFileSync(path.join(ROOT, \"eval/toolchain-versions.json\"), \"utf8\"));\n   483\t  const rustToolchain = fs.readFileSync(path.join(ROOT, \"rust-toolchain.toml\"), \"utf8\");\n   484\t  const workflow = fs.readFileSync(path.join(ROOT, \".github/workflows/ci.yml\"), \"utf8\");\n   485\t  assert.equal(toolchainPolicy.go, \"1.22.12\");\n   486\t  assert.equal(toolchainPolicy.rust, /^channel = \"([^\"]+)\"$/m.exec(rustToolchain)?.[1]);\n   487\t  assert.equal((workflow.match(/go-version: '([^']+)'/g) ?? []).length, 2);\n   488\t  assert.equal((workflow.match(/go-version: '1\\.22\\.12'/g) ?? []).length, 2, \"both CI jobs install the exact approved Go version\");\n   489\t  assert.equal((workflow.match(/run: bash scripts\\/install-evaluator-toolchains\\.sh/g) ?? []).length, 2, \"both CI jobs use the same exact-version installer\");\n   490\t  assert.equal(oracleToolchainVersionProblem({\n   491\t    goVersion: \"go version go1.22.12 linux/amd64\",\n   492\t    rustcVersion: \"rustc 1.95.0 (fixture)\",\n   493\t    cargoVersion: \"cargo 1.95.0 (fixture)\",\n   494\t  }), null);\n   495\t  assert.match(oracleToolchainVersionProblem({\n   496\t    goVersion: \"go version go1.22.11 linux/amd64\",\n   497\t    rustcVersion: \"rustc 1.95.0 (fixture)\",\n   498\t    cargoVersion: \"cargo 1.95.0 (fixture)\",\n   499\t  }), /do not match policy/);\n   500\t  assert.match(oracleToolchainVersionProblem({\n   501\t    goVersion: \"go version go1.22.12 linux/amd64\",\n   502\t    rustcVersion: \"rustc 1.94.0 (fixture)\",\n   503\t    cargoVersion: \"cargo 1.95.0 (fixture)\",\n   504\t  }), /do not match policy/);\n   505\t\n   506\t  const fakeSystem = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-system-\"));\n   507\t  const fakeAlternatives = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-alternatives-\"));\n   508\t  const fakeSymlinkTarget = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-unpinned-compiler-target-\"));\n   509\t  const fakeLib = path.join(fakeSystem, \"rustlib\", \"bin\");\n   510\t  fs.mkdirSync(path.join(fakeSystem, \"bin\"), { recursive: true });\n   511\t  fs.mkdirSync(fakeLib, { recursive: true });\n   512\t  const compilerCanary = \"#!/bin/sh\\nprintf '%s\\\\n' UNPINNED_COMPILER_CANARY\\n\";\n   513\t  const fakeGo = path.join(fakeSystem, \"bin\", \"go\");\n   514\t  const fakeRustc = path.join(fakeLib, \"rustc\");\n   515\t  const fakeCargo = path.join(fakeSystem, \"bin\", \"cargo-1.94.0\");\n   516\t  for (const file of [fakeGo, fakeRustc, fakeCargo]) {\n   517\t    fs.writeFileSync(file, compilerCanary);\n   518\t    fs.chmodSync(file, 0o755);\n   519\t  }\n   520\t  fs.symlinkSync(fakeCargo, path.join(fakeAlternatives, \"cargo\"));\n   521\t  fs.symlinkSync(fakeCargo, path.join(fakeAlternatives, \"compiler-alias\"));\n   522\t  fs.writeFileSync(path.join(fakeSymlinkTarget, \"rustc\"), compilerCanary);\n   523\t  fs.chmodSync(path.join(fakeSymlinkTarget, \"rustc\"), 0o755);\n   524\t  fs.symlinkSync(fakeSymlinkTarget, path.join(fakeSystem, \"compiler-reach\"));\n   525\t  t.after(() => {\n   526\t    fs.rmSync(fakeSystem, { recursive: true, force: true });\n   527\t    fs.rmSync(fakeAlternatives, { recursive: true, force: true });\n   528\t    fs.rmSync(fakeSymlinkTarget, { recursive: true, force: true });\n   529\t  });\n   530\t  const exposure = oracleCompilerExposureProblem([fakeSystem], [fakeAlternatives]);\n   531\t  assert.match(exposure ?? \"\", /unapproved Go\\/Rust compiler executable/);\n   532\t  assert.match(exposure ?? \"\", /rustlib\\/bin\\/rustc/);\n   533\t  assert.match(exposure ?? \"\", /compiler-reach\\/rustc/);\n   534\t  assert.match(exposure ?? \"\", /eval-oracle-unpinned-compiler-alternatives-[^,]+\\/cargo/);\n   535\t  assert.match(exposure ?? \"\", /eval-oracle-unpinned-compiler-alternatives-[^,]+\\/compiler-alias/);\n   536\t  if (sandboxAvailable()) {\n   537\t    assert.throws(() => isolatedProcessArgv({\n   538\t      cwd: fakeSystem,\n   539\t      command: \"/usr/bin/true\",\n   540\t      readOnlyPaths: [\"/usr/bin/true\"],\n   541\t      allowedFiles: [\"/usr/bin/true\"],\n   542\t      oracleToolchains: true,\n   543\t      systemDirectories: [fakeSystem],\n   544\t      systemEtcDirectories: [fakeAlternatives],\n   545\t    }), /unapproved Go\\/Rust compiler executable/, \"the execution-path preflight rejects deliberate compiler escape fixtures\");\n   546\t  }\n   547\t\n   548\t  assert.equal(oracleToolchainPathProblem({ uid: 0, mode: 0o040755 }), null, \"root-owned read-only directories are eligible\");\n   549\t  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040775 }), /without group or other write permission/, \"group-writable toolchain paths must fail closed\");\n   550\t  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040757 }), /without group or other write permission/, \"other-writable toolchain paths must fail closed\");\n   551\t  assert.match(oracleToolchainPathProblem({ uid: 1234, mode: 0o040755 }), /root-owned/, \"non-root-owned paths are not pinned roots\");\n   552\t  const candidateRootStat = { uid: 0, mode: 0o040755, isDirectory: () => true, isSymbolicLink: () => false };\n   553\t  assert.equal(candidateToolchainRootProblem(candidateRootStat, \"/usr/local/nexus-qual/rust\", \"/usr/local/nexus-qual/rust\"), null);\n   554\t  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, isSymbolicLink: () => true }, \"/usr/local/nexus-qual/rust\", \"/usr/local/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject symlinked toolchain roots\");\n   555\t  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, mode: 0o040775 }, \"/usr/local/nexus-qual/rust\", \"/usr/local/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject group-writable toolchain roots\");\n   556\t  assert.match(candidateToolchainRootProblem(candidateRootStat, \"/tmp/toolchain\", \"/usr/local/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject roots resolving outside the pinned path\");\n   557\t  const taskDir = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-toolchain-task-\"));\n   558\t  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-toolchain-candidate-\"));\n   559\t  t.after(() => {\n   560\t    fs.rmSync(taskDir, { recursive: true, force: true });\n   561\t    fs.rmSync(workspace, { recursive: true, force: true });\n   562\t  });\n   563\t  fs.mkdirSync(path.join(workspace, \"src\"));\n   564\t 