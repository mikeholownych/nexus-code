{"timestamp":"2026-10-29T13:14:06.477Z","ordinal":502803,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18771-cd08-7c60-9b2e-7bad123756d6","item":{"type":"CommandExecution","id":"exec-06614d10-40e8-4a2e-8216-f4cec7e997b6","process_id":"60749","command":["/usr/bin/zsh","-lc","cd /home/mike/nexus-wt/eval-agent-toolchain-binds && xerj search \"pinned evaluator toolchain requirements compiler roots\" --prefix nexus-cli --limit 5 2>&1; xerj search \"evaluation candidate sandbox task toolchain setup\" --prefix nexus-docs --limit 5 2>&1; nl -ba eval/isolate.mjs | sed -n '30,210p'; nl -ba eval/isolate.mjs | sed -n '450,640p'; nl -ba eval/oracle.mjs | sed -n '1,95p'; nl -ba cli/test/eval_integrity.test.ts | sed -n '1360,1400p'; nl -ba cli/test/eval_hardened.test.ts | sed -n '1,120p'"],"cwd":"file:///home/mike/nexus-wt/eval-agent-toolchain-binds","parsed_cmd":[{"type":"unknown","cmd":"cd /home/mike/nexus-wt/eval-agent-toolchain-binds && xerj search \"pinned evaluator toolchain requirements compiler roots\" --prefix nexus-cli --limit 5 2>&1; xerj search \"evaluation candidate sandbox task toolchain setup\" --prefix nexus-docs --limit 5 2>&1; nl -ba eval/isolate.mjs | sed -n '30,210p'; nl -ba eval/isolate.mjs | sed -n '450,640p'; nl -ba eval/oracle.mjs | sed -n '1,95p'; nl -ba cli/test/eval_integrity.test.ts | sed -n '1360,1400p'; nl -ba cli/test/eval_hardened.test.ts | sed -n '1,120p'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"xerj search: unexpected argument '--limit'\n\nxerj search — retrieve code from a running XERJ node (reference coding, no scripts)\nDefault ranking is lexical: it matches the words you typed, and it is not a neural reading of the code.\n\nUSAGE:\n    xerj search [OPTIONS] \"<what you need, in plain words>\"\n\nOPTIONS:\n    --url <U>       node endpoint (default $XERJ_URL or http://localhost:9200)\n    --prefix <P>    index prefix to search (default \"ax\" — what `xerj autoindex` writes)\n    --api-key <K>   Authorization (or $XERJ_API_KEY; --insecure nodes need none)\n    -k <N>          number of passages to return (default 5). A non-number is a\n                    usage error, not a silent default\n    --full <CHARS>  max characters of each passage to print (default 600)\n    --json          print the raw response instead of formatted passages\n\nEXAMPLE:\n    xerj --insecure -d ./.xerj-data &                 # a node, running\n    xerj autoindex ref/sled                           # index once\n    xerj search \"fsync the WAL segment on rotation\"    # one line in, a passage out\n\nSEE ALSO:\n    xerj def <symbol>    exact go-to-definition when you already know the name\n\nxerj search: unexpected argument '--limit'\n\nxerj search — retrieve code from a running XERJ node (reference coding, no scripts)\nDefault ranking is lexical: it matches the words you typed, and it is not a neural reading of the code.\n\nUSAGE:\n    xerj search [OPTIONS] \"<what you need, in plain words>\"\n\nOPTIONS:\n    --url <U>       node endpoint (default $XERJ_URL or http://localhost:9200)\n    --prefix <P>    index prefix to search (default \"ax\" — what `xerj autoindex` writes)\n    --api-key <K>   Authorization (or $XERJ_API_KEY; --insecure nodes need none)\n    -k <N>          number of passages to return (default 5). A non-number is a\n                    usage error, not a silent default\n    --full <CHARS>  max characters of each passage to print (default 600)\n    --json          print the raw response instead of formatted passages\n\nEXAMPLE:\n    xerj --insecure -d ./.xerj-data &                 # a node, running\n    xerj autoindex ref/sled                           # index once\n    xerj search \"fsync the WAL segment on rotation\"    # one line in, a passage out\n\nSEE ALSO:\n    xerj def <symbol>    exact go-to-definition when you already know the name\n\n    30\t}\n    31\t\n    32\texport function candidateAgentPath(configuredPath, toolchains = resolveHostToolchains()) {\n    33\t  const configuredEntries = (configuredPath ?? \"/usr/bin:/bin\").split(path.delimiter).filter(Boolean);\n    34\t  const toolchainEntries = [\n    35\t    ...(toolchains.rustRoot ? [\"/usr/local/nexus-qual/rust/bin\"] : []),\n    36\t    ...(toolchains.goRoot ? [\"/usr/local/go/bin\"] : []),\n    37\t  ];\n    38\t  return [...new Set([...toolchainEntries, ...configuredEntries])].join(path.delimiter);\n    39\t}\n    40\t\n    41\texport function selectToolchainRoot(configuredRoot, fallbackRoot) {\n    42\t  return configuredRoot ?? fallbackRoot ?? null;\n    43\t}\n    44\t\n    45\texport function oracleToolchainPathProblem(stat) {\n    46\t  if (!stat || stat.isSymbolicLink?.() || stat.uid !== 0 || (stat.mode & 0o022) !== 0) {\n    47\t    return \"pinned oracle toolchain entry is not a real root-owned path without group or other write permission\";\n    48\t  }\n    49\t  return null;\n    50\t}\n    51\t\n    52\texport function candidateToolchainRootProblem(stat, resolvedPath, expectedPath) {\n    53\t  if (!stat || !stat.isDirectory() || stat.isSymbolicLink() || oracleToolchainPathProblem(stat) || resolvedPath !== expectedPath) {\n    54\t    return \"pinned candidate toolchain root is not a safe real directory\";\n    55\t  }\n    56\t  return null;\n    57\t}\n    58\t\n    59\tfunction toolchainMountArgs(toolchains, parentDirectoryAvailable = false) {\n    60\t  const args = [];\n    61\t  const createdDirectories = new Set(parentDirectoryAvailable ? [\"/usr/local\"] : []);\n    62\t  const ensureDirectory = (directory) => {\n    63\t    if (createdDirectories.has(directory)) return;\n    64\t    args.push(\"--dir\", directory);\n    65\t    createdDirectories.add(directory);\n    66\t  };\n    67\t  if (toolchains.goRoot) {\n    68\t    ensureDirectory(\"/usr/local\");\n    69\t    args.push(\"--ro-bind\", toolchains.goRoot, \"/usr/local/go\");\n    70\t  }\n    71\t  if (toolchains.rustRoot) {\n    72\t    ensureDirectory(\"/usr/local\");\n    73\t    ensureDirectory(\"/usr/local/nexus-qual\");\n    74\t    args.push(\"--ro-bind\", toolchains.rustRoot, \"/usr/local/nexus-qual/rust\");\n    75\t  }\n    76\t  return args;\n    77\t}\n    78\t\n    79\texport function candidateToolchainMountArgs(toolchains, systemDirectories = []) {\n    80\t  return toolchainMountArgs(toolchains, systemDirectories.includes(\"/usr/local/lib\"));\n    81\t}\n    82\t\n    83\tfunction resolveHostToolchains() {\n    84\t  const availableDirectory = ({ root, required }) => {\n    85\t    let stat;\n    86\t    try { stat = fs.lstatSync(root); }\n    87\t    catch (error) {\n    88\t      if (error?.code === \"ENOENT\") return null;\n    89\t      throw error;\n    90\t    }\n    91\t    const rootProblem = candidateToolchainRootProblem(stat, fs.realpathSync(root), root);\n    92\t    if (rootProblem) throw new Error(rootProblem);\n    93\t    const problem = pinnedToolchainProblem(root, required);\n    94\t    if (problem) throw new Error(problem);\n    95\t    return root;\n    96\t  };\n    97\t  const roots = Object.fromEntries(PINNED_ORACLE_TOOLCHAINS.map((toolchain) => [toolchain.root, availableDirectory(toolchain)]));\n    98\t  return {\n    99\t    goRoot: roots[\"/usr/local/go\"],\n   100\t    rustRoot: roots[\"/usr/local/nexus-qual/rust\"],\n   101\t  };\n   102\t}\n   103\t\n   104\t/** Python black-box oracles may invoke only these root-owned, pinned compiler runtimes. */\n   105\texport function oracleToolchainVersionProblem({ goVersion, rustcVersion, cargoVersion }) {\n   106\t  const actualGo = /^go version (go\\S+)/.exec(goVersion ?? \"\")?.[1];\n   107\t  const actualRustc = /^rustc (\\S+)/.exec(rustcVersion ?? \"\")?.[1];\n   108\t  const actualCargo = /^cargo (\\S+)/.exec(cargoVersion ?? \"\")?.[1];\n   109\t  if (actualGo !== `go${TOOLCHAIN_POLICY.go}` || actualRustc !== TOOLCHAIN_POLICY.rust || actualCargo !== TOOLCHAIN_POLICY.rust) {\n   110\t    return `pinned oracle toolchain versions do not match policy (expected Go ${TOOLCHAIN_POLICY.go} and Rust ${TOOLCHAIN_POLICY.rust})`;\n   111\t  }\n   112\t  return null;\n   113\t}\n   114\t\n   115\tfunction isInsideAnyRoot(candidate, roots) {\n   116\t  return roots.some((root) => candidate === root || candidate.startsWith(`${root}${path.sep}`));\n   117\t}\n   118\t\n   119\tfunction mountedSpellingsForTarget(target, roots) {\n   120\t  const spellings = new Set();\n   121\t  for (const root of roots) {\n   122\t    let canonicalRoot;\n   123\t    try { canonicalRoot = fs.realpathSync(root); }\n   124\t    catch (error) {\n   125\t      if (error?.code === \"ENOENT\") continue;\n   126\t      throw error;\n   127\t    }\n   128\t    if (!isInsideAnyRoot(target, [canonicalRoot])) continue;\n   129\t    spellings.add(path.resolve(root, path.relative(canonicalRoot, target)));\n   130\t  }\n   131\t  return [...spellings];\n   132\t}\n   133\t\n   134\t/** Reject every unpinned Go/Rust compiler reachable through the task's mounted runtime paths. */\n   135\texport function oracleCompilerExposureProblem(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS, additionalMountedPaths = []) {\n   136\t  const scan = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths);\n   137\t  if (scan.problem) return scan.problem;\n   138\t  return scan.paths.length\n   139\t    ? `unapproved Go/Rust compiler executable is exposed through oracle system mounts: ${scan.paths.join(\", \")}`\n   140\t    : null;\n   141\t}\n   142\t\n   143\tfunction scanOracleCompilerExposure(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS, additionalMountedPaths = []) {\n   144\t  const roots = [...new Set([...systemDirectories, ...systemEtcDirectories, ...additionalMountedPaths])].sort();\n   145\t\n   146\t  const exposed = new Set();\n   147\t  const visited = new Set();\n   148\t  const approvedRoots = PINNED_ORACLE_TOOLCHAINS.map(({ root }) => root);\n   149\t  const inspectExecutable = (item, isSymbolicLink) => {\n   150\t    if (visited.has(item)) return;\n   151\t    visited.add(item);\n   152\t    const entryName = path.basename(item);\n   153\t    if (!UNPINNED_ORACLE_COMPILER_NAME.test(entryName) && !isSymbolicLink) return;\n   154\t    let stat;\n   155\t    let target;\n   156\t    try {\n   157\t      stat = fs.statSync(item);\n   158\t      target = fs.realpathSync(item);\n   159\t    } catch (error) {\n   160\t      if (error?.code === \"ENOENT\") return;\n   161\t      throw error;\n   162\t    }\n   163\t    if (!stat.isFile()\n   164\t      || (stat.mode & 0o111) === 0\n   165\t      || (!UNPINNED_ORACLE_COMPILER_NAME.test(entryName) && !UNPINNED_ORACLE_COMPILER_NAME.test(path.basename(target)))\n   166\t      || isInsideAnyRoot(target, approvedRoots)) return;\n   167\t    const descriptor = fs.openSync(target, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0));\n   168\t    let header;\n   169\t    try {\n   170\t      header = Buffer.alloc(2);\n   171\t      fs.readSync(descriptor, header, 0, header.length, 0);\n   172\t    } finally {\n   173\t      fs.closeSync(descriptor);\n   174\t    }\n   175\t    // Names such as `go-225` also occur in executable-mode terminfo records. Exclude only\n   176\t    // positively identified compiled terminfo data; keep no-shebang and binfmt executables.\n   177\t    const terminfoMagic = header.equals(Buffer.from([0x1a, 0x01])) || header.equals(Buffer.from([0x1e, 0x02]));\n   178\t    if (terminfoMagic && /(?:^|\\/)terminfo\\//.test(item)) return;\n   179\t    // The candidate's explicit runtime mounts may expose compiler targets outside the\n   180\t    // standard system roots. Mask each visible spelling after all runtime mounts are added.\n   181\t    for (const mountedPath of mountedSpellingsForTarget(target, roots)) exposed.add(mountedPath);\n   182\t  };\n   183\t  const visit = (directory) => {\n   184\t    // Preserve each mounted spelling. `/lib` and `/usr/lib` may resolve to the same host\n   185\t    // directory but remain distinct paths in the sandbox namespace, so both need masks.\n   186\t    const mountedDirectory = path.resolve(directory);\n   187\t    if (visited.has(mountedDirectory)) return;\n   188\t    visited.add(mountedDirectory);\n   189\t    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n   190\t      const item = path.join(directory, entry.name);\n   191\t      if (entry.isDirectory()) visit(item);\n   192\t      else inspectExecutable(item, entry.isSymbolicLink());\n   193\t    }\n   194\t  };\n   195\t\n   196\t  try {\n   197\t    for (const root of roots) {\n   198\t      let stat;\n   199\t      try { stat = fs.statSync(root); }\n   200\t      catch (error) {\n   201\t        if (error?.code === \"ENOENT\") continue;\n   202\t        throw error;\n   203\t      }\n   204\t      if (stat.isDirectory()) visit(root);\n   205\t      else if (stat.isFile()) inspectExecutable(root, fs.lstatSync(root).isSymbolicLink());\n   206\t    }\n   207\t  } catch {\n   208\t    return { paths: [], problem: \"oracle compiler exposure could not be checked; refusing qualification\" };\n   209\t  }\n   210\t\n   450\t      if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source);\n   451\t    } catch {}\n   452\t  }\n   453\t  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n   454\t  args.push(...compilerExposureMaskArgs(compilerExposure));\n   455\t  args.push(\"--bind\", workspace, \"/workspace\", \"--dir\", \"/home\", \"--dir\", \"/run\");\n   456\t  if (hiddenSubpaths.length) {\n   457\t    const helperDir = path.dirname(fileURLToPath(import.meta.url));\n   458\t    args.push(\"--dir\", \"/runner\", \"--ro-bind\", path.join(helperDir, \"hide_oracle.cjs\"), \"/runner/hide_oracle.cjs\");\n   459\t    args.push(\"--ro-bind\", path.join(helperDir, \"hide_oracle.py\"), \"/runner/sitecustomize.py\");\n   460\t    args.push(\"--ro-bind\", path.join(helperDir, \"unlink_then_exec.sh\"), \"/runner/unlink_then_exec.sh\");\n   461\t  }\n   462\t  // Workspace subpaths the command may read but not change (hardened hidden tests: the oracle's own files).\n   463\t  for (const relative of hiddenSubpaths.length ? [] : readOnlySubpaths) {\n   464\t    const source = confinedPath(workspace, relative);\n   465\t    args.push(\"--ro-bind\", source, path.posix.join(\"/workspace\", path.relative(workspace, source).split(path.sep).join(\"/\")));\n   466\t  }\n   467\t  args.push(\"--symlink\", \"usr/bin\", \"/bin\");\n   468\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/local/nexus-qual/rust/bin:/usr/local/go/bin:/usr/bin:/bin\");\n   469\t  args.push(\"--setenv\", \"HOME\", home ? \"/home/eval\" : \"/tmp\");\n   470\t  args.push(\"--setenv\", \"CI\", \"1\", \"--setenv\", \"LANG\", \"C.UTF-8\");\n   471\t  if (hiddenSubpaths.length) {\n   472\t    args.push(\"--setenv\", \"NEXUS_HIDDEN_FILES\", JSON.stringify(hiddenGuestPaths));\n   473\t    args.push(\"--setenv\", \"NODE_OPTIONS\", \"--require /runner/hide_oracle.cjs\");\n   474\t    args.push(\"--setenv\", \"PYTHONPATH\", \"/runner\");\n   475\t    if (/\\bgo\\s+test\\b/.test(command)) {\n   476\t      executionCommand = command.replace(/\\bgo\\s+test\\b/g, \"go test -exec /runner/unlink_then_exec.sh\");\n   477\t    } else if (/\\bcargo\\s+test\\b/.test(command)) {\n   478\t      args.push(\"--setenv\", \"CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER\", \"/runner/unlink_then_exec.sh\");\n   479\t      executionCommand = command;\n   480\t    } else if (/^(python(?:\\d+(?:\\.\\d+)?)?)\\s+(\\S+\\.py)\\s*$/.test(command.trim())) {\n   481\t      const [, python, script] = command.trim().match(/^(python(?:\\d+(?:\\.\\d+)?)?)\\s+(\\S+\\.py)\\s*$/);\n   482\t      executionCommand = `${python} -c 'import runpy,sys; runpy.run_path(sys.argv[1], run_name=\"__main__\")' ${shellQuote(script)}`;\n   483\t    }\n   484\t    executionCommand = executionCommand.replace(/\\bPYTHONPATH=/g, \"PYTHONPATH=/runner:\");\n   485\t    executionCommand = executionCommand.replace(/\\bpytest\\b/g, \"pytest --assert=plain --noconftest\");\n   486\t    args.push(\"--setenv\", \"PYTHONDONTWRITEBYTECODE\", \"1\");\n   487\t  }\n   488\t  if (home) args.push(\"--tmpfs\", \"/home/eval\");\n   489\t  args.push(\"--\", \"/usr/bin/bash\", \"-c\", executionCommand);\n   490\t  return { cmd: BWRAP, argv: args, timeoutMs: timeoutSec * 1000 };\n   491\t}\n   492\t\n   493\texport function runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles = []) {\n   494\t  if (!Array.isArray(readOnlyPaths) || !Array.isArray(allowedRoots) || !Array.isArray(allowedFiles) || allowedRoots.some((item) => typeof item !== \"string\" || !path.isAbsolute(item)) || allowedFiles.some((item) => typeof item !== \"string\" || !path.isAbsolute(item))) {\n   495\t    return \"candidate runtime mounts require explicit absolute paths and allowed roots\";\n   496\t  }\n   497\t  const roots = [];\n   498\t  for (const item of allowedRoots) {\n   499\t    const lexical = path.resolve(item);\n   500\t    const lexicalProblem = protectedRuntimeRootProblem(lexical);\n   501\t    if (lexicalProblem) return lexicalProblem;\n   502\t    try { roots.push(fs.realpathSync(lexical)); }\n   503\t    catch { return \"candidate runtime allowlist root is unavailable\"; }\n   504\t  }\n   505\t  let executableFiles;\n   506\t  try { executableFiles = allowedFiles.map((item) => fs.realpathSync(item)); }\n   507\t  catch { return \"candidate runtime executable is unavailable\"; }\n   508\t  for (const root of roots) {\n   509\t    const rootProblem = protectedRuntimeRootProblem(root);\n   510\t    if (rootProblem) return rootProblem;\n   511\t  }\n   512\t  for (const item of readOnlyPaths) {\n   513\t    if (typeof item !== \"string\" || !path.isAbsolute(item)) return \"candidate runtime paths must be absolute\";\n   514\t    let resolved;\n   515\t    try { resolved = fs.realpathSync(item); }\n   516\t    catch { return `candidate runtime path is unavailable: ${item}`; }\n   517\t    const stat = fs.statSync(resolved);\n   518\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   519\t    const explicitlySelectedTempExecutable = executableFiles.includes(resolved) && stat.isFile() && resolved.startsWith(`/tmp${path.sep}`);\n   520\t    if (FORBIDDEN_RUNTIME_ROOTS.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !explicitlySelectedTempExecutable) {\n   521\t      return `protected candidate runtime path is forbidden: ${resolved}`;\n   522\t    }\n   523\t    if (resolved === os.homedir() || (resolved.startsWith(`${os.homedir()}${path.sep}`) && resolved.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part)))) {\n   524\t      return `sensitive candidate runtime path is forbidden: ${resolved}`;\n   525\t    }\n   526\t    if (!stat.isFile() && !stat.isDirectory()) return `candidate runtime path is not a regular file or directory: ${resolved}`;\n   527\t    if (!roots.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !executableFiles.includes(resolved)) {\n   528\t      return `candidate runtime path is outside its explicit allowlist: ${resolved}`;\n   529\t    }\n   530\t    if (executableFiles.includes(resolved) && !stat.isFile()) return `candidate runtime executable is not a regular file: ${resolved}`;\n   531\t    if (stat.isDirectory()) assertNoSymlinks(resolved);\n   532\t  }\n   533\t  return null;\n   534\t}\n   535\t\n   536\tfunction protectedRuntimeRootProblem(root) {\n   537\t  if (root.startsWith(`${os.homedir()}${path.sep}`) && root.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part))) return `sensitive candidate runtime root is forbidden: ${root}`;\n   538\t  if (root === \"/\" || root === \"/home\" || root === os.homedir() || FORBIDDEN_RUNTIME_ROOTS.some((item) => root === item || root.startsWith(`${item}${path.sep}`))) return `protected candidate runtime root is forbidden: ${root}`;\n   539\t  return null;\n   540\t}\n   541\t\n   542\texport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n   543\t  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n   544\t  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n   545\t  if (protectedOverlap) throw new Error(protectedOverlap);\n   546\t  const compilerExposure = scanOracleCompilerExposure(\n   547\t    mountSources.systemDirectories,\n   548\t    mountSources.systemEtcDirectories,\n   549\t    mountSources.runtimeSources.readOnlyPaths,\n   550\t  );\n   551\t  if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n   552\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n   553\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n   554\t  if (mountProblem) throw new Error(mountProblem);\n   555\t  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n   556\t    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n   557\t  }\n   558\t  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n   559\t  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n   560\t    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n   561\t  }\n   562\t  const workspace = mountSources.runtimeSources.cwd;\n   563\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   564\t  for (const source of mountSources.systemDirectories) {\n   565\t    if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   566\t    args.push(\"--ro-bind\", source, source);\n   567\t  }\n   568\t  args.push(...candidateToolchainMountArgs(resolveHostToolchains(), mountSources.systemDirectories));\n   569\t  for (const source of mountSources.systemFiles) args.push(\"--ro-bind\", source, source);\n   570\t  for (const source of mountSources.systemEtcDirectories) args.push(\"--ro-bind\", source, source);\n   571\t  const isolatedHome = mountSources.runtimeSources.home;\n   572\t  args.push(\"--symlink\", \"usr/bin\", \"/bin\", \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--bind\", isolatedHome, \"/home/eval\", \"--tmpfs\", \"/run\");\n   573\t  args.push(\"--dir\", \"/run/eval-proxy\", \"--ro-bind\", mountSources.runtimeSources.proxyDirectory, \"/run/eval-proxy\");\n   574\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/run\", \"/run/eval-proxy\"]);\n   575\t  const addTargetParents = (target) => {\n   576\t    const parts = target.split(path.sep).filter(Boolean);\n   577\t    let current = \"\";\n   578\t    for (const part of parts.slice(0, -1)) {\n   579\t      current += `/${part}`;\n   580\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n   581\t    }\n   582\t  };\n   583\t  for (const resolved of mountSources.runtimeSources.readOnlyPaths) {\n   584\t    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n   585\t    if (fs.statSync(resolved).isDirectory()) assertNoSymlinks(resolved);\n   586\t    addTargetParents(resolved);\n   587\t    args.push(\"--ro-bind\", resolved, resolved);\n   588\t  }\n   589\t  args.push(...compilerExposureMaskArgs(compilerExposure));\n   590\t  addTargetParents(\"/runner/agent_sandbox.mjs\");\n   591\t  args.push(\"--ro-bind\", nodeRuntime, \"/runner/node\");\n   592\t  args.push(\"--ro-bind\", mountSources.runtimeSources.supervisorPath, \"/runner/agent_sandbox.mjs\");\n   593\t  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/usr/bin:/bin\", \"--setenv\", \"HOME\", \"/home/eval\", \"--setenv\", \"CI\", \"1\", \"--\");\n   594\t  args.push(\"/runner/node\", \"/runner/agent_sandbox.mjs\");\n   595\t  return { cmd: BWRAP, argv: args };\n   596\t}\n   597\t\n   598\t/** Run a fixed executable probe without exposing the host filesystem, environment, or network. */\n   599\texport function isolatedProcessArgv({ cwd, command, argv = [], readOnlyPaths = [], allowedRoots = [], allowedFiles = [], timeoutMs = 5000, workspaceReadOnly = false, protectedCorpusPaths = [], oracleToolchains = false, systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS }) {\n   600\t  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing executable probe\");\n   601\t  let compilerExposure = null;\n   602\t  if (oracleToolchains) {\n   603\t    const additionalMountedPaths = readOnlyPaths.map((item) => fs.realpathSync(item));\n   604\t    compilerExposure = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths);\n   605\t    if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n   606\t    const problem = pinnedOracleToolchainsProblem();\n   607\t    if (problem) throw new Error(problem);\n   608\t  }\n   609\t  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles);\n   610\t  if (mountProblem) throw new Error(mountProblem);\n   611\t  const workspace = fs.realpathSync(cwd);\n   612\t  const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\"];\n   613\t  for (const source of systemDirectories) {\n   614\t    try {\n   615\t      if (fs.statSync(source).isDirectory()) {\n   616\t        if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n   617\t        args.push(\"--ro-bind\", source, source);\n   618\t      }\n   619\t    } catch {}\n   620\t  }\n   621\t  if (oracleToolchains) {\n   622\t    for (const { root } of PINNED_ORACLE_TOOLCHAINS) {\n   623\t      const parent = path.dirname(root);\n   624\t      addOracleMountParent(args, parent);\n   625\t      args.push(\"--ro-bind\", root, root);\n   626\t    }\n   627\t  }\n   628\t  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n   629\t    try { if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source); } catch {}\n   630\t  }\n   631\t  for (const source of systemEtcDirectories) {\n   632\t    try { if (fs.statSync(source).isDirectory()) args.push(\"--ro-bind\", source, source); } catch {}\n   633\t  }\n   634\t  args.push(workspaceReadOnly ? \"--ro-bind\" : \"--bind\", workspace, \"/workspace\", \"--tmpfs\", \"/home\", \"--dir\", \"/home/eval\", \"--tmpfs\", \"/run\", \"--symlink\", \"usr/bin\", \"/bin\");\n   635\t  const madeDirs = new Set([\"/\", \"/usr\", \"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/usr/local\", \"/usr/local/lib\", \"/lib\", \"/lib64\", \"/bin\", \"/etc\", \"/workspace\", \"/home\", \"/home/eval\", \"/run\"]);\n   636\t  const addParents = (target) => {\n   637\t    let current = \"\";\n   638\t    for (const part of target.split(path.sep).filter(Boolean).slice(0, -1)) {\n   639\t      current += `/${part}`;\n   640\t      if (!madeDirs.has(current)) { args.push(\"--dir\", current); madeDirs.add(current); }\n     1\t// Black-box qualification oracle: expected values stay in the evaluator process and are never mounted into candidate\n     2\t// execution. The candidate receives one public input at a time and returns JSON for comparison by this parent.\n     3\timport fs from \"node:fs\";\n     4\timport path from \"node:path\";\n     5\timport { isDeepStrictEqual } from \"node:util\";\n     6\timport { confinedPath } from \"./isolate.mjs\";\n     7\timport { isolatedProcessArgv, oracleToolchainsProblem, runIsolatedProcess } from \"./isolate.mjs\";\n     8\t\n     9\tconst RUNTIMES = Object.freeze({ node: process.execPath, python3: \"/usr/bin/python3\" });\n    10\tconst MAX_ORACLE_BYTES = 1_048_576;\n    11\tconst MAX_CASES = 256;\n    12\tconst MAX_CASE_BYTES = 16_384;\n    13\tconst MAX_OUTPUT_BYTES = 32_768;\n    14\tconst MAX_TIMEOUT_MS = 30_000;\n    15\tconst MAX_TOTAL_TIMEOUT_MS = 300_000;\n    16\t\n    17\t/** Validate a frozen black-box oracle definition without exposing its case contents in diagnostics. */\n    18\texport function blackBoxOracleProblem(check, taskDir, candidateFixture = null) {\n    19\t  if (!check || check.protocol !== \"blackbox-v1\") return \"hidden oracle protocol must be blackbox-v1\";\n    20\t  if (Object.keys(check).some((key) => ![\"protocol\", \"casesFile\", \"runtime\", \"argv\", \"timeoutMs\", \"totalTimeoutMs\", \"maxOutputBytes\"].includes(key))) {\n    21\t    return \"hidden black-box oracle has unsupported fields\";\n    22\t  }\n    23\t  if (typeof check.casesFile !== \"string\") return \"hidden black-box oracle casesFile is required\";\n    24\t  let casesPath;\n    25\t  try { casesPath = confinedPath(taskDir, check.casesFile); }\n    26\t  catch { return \"hidden black-box oracle casesFile is unsafe\"; }\n    27\t  if (candidateFixture) {\n    28\t    let fixturePath;\n    29\t    try { fixturePath = confinedPath(taskDir, candidateFixture); }\n    30\t    catch { return \"candidate fixture path is unsafe\"; }\n    31\t    const relative = path.relative(fixturePath, casesPath);\n    32\t    if (relative === \"\" || (!relative.startsWith(`..${path.sep}`) && relative !== \"..\" && !path.isAbsolute(relative))) {\n    33\t      return \"hidden black-box oracle casesFile must be outside the candidate fixture\";\n    34\t    }\n    35\t  }\n    36\t  try {\n    37\t    const stat = fs.statSync(casesPath);\n    38\t    if (!stat.isFile() || stat.size > MAX_ORACLE_BYTES) return \"hidden black-box oracle case file is not a bounded regular file\";\n    39\t    const rows = JSON.parse(fs.readFileSync(casesPath, \"utf8\"));\n    40\t    if (!Array.isArray(rows) || rows.length < 1 || rows.length > MAX_CASES) return \"hidden black-box oracle case count is outside the allowed range\";\n    41\t    for (const row of rows) {\n    42\t      if (!row || typeof row !== \"object\" || Array.isArray(row) || Object.keys(row).sort().join(\",\") !== \"expected,input\") {\n    43\t        return \"hidden black-box oracle cases must contain only input and expected fields\";\n    44\t      }\n    45\t      if (Buffer.byteLength(JSON.stringify(row), \"utf8\") > MAX_CASE_BYTES) return \"hidden black-box oracle case exceeds the size limit\";\n    46\t    }\n    47\t  } catch {\n    48\t    return \"hidden black-box oracle cases are unavailable or malformed\";\n    49\t  }\n    50\t  if (!Object.hasOwn(RUNTIMES, check.runtime)) return \"hidden black-box oracle runtime is not allowlisted\";\n    51\t  if (check.runtime === \"python3\") {\n    52\t    const toolchainProblem = oracleToolchainsProblem();\n    53\t    if (toolchainProblem) return toolchainProblem;\n    54\t  }\n    55\t  if (!Array.isArray(check.argv) || check.argv.length !== 1 || typeof check.argv[0] !== \"string\" || check.argv[0].includes(\"\\0\") || Buffer.byteLength(check.argv[0]) > 1024) {\n    56\t    return \"hidden black-box oracle argv must name only one candidate entrypoint\";\n    57\t  }\n    58\t  const entrypoint = check.argv[0];\n    59\t  if (path.posix.isAbsolute(entrypoint) || entrypoint.startsWith(\"-\") || entrypoint.includes(\"\\\\\") || entrypoint.split(\"/\").some((part) => !part || part === \".\" || part === \"..\")) {\n    60\t    return \"hidden black-box oracle argv must be a normalized relative candidate entrypoint\";\n    61\t  }\n    62\t  if (!Number.isSafeInteger(check.timeoutMs) || check.timeoutMs < 100 || check.timeoutMs > MAX_TIMEOUT_MS) return \"hidden black-box oracle timeout is outside the allowed range\";\n    63\t  if (!Number.isSafeInteger(check.totalTimeoutMs) || check.totalTimeoutMs < check.timeoutMs || check.totalTimeoutMs > MAX_TOTAL_TIMEOUT_MS) return \"hidden black-box oracle total timeout is outside the allowed range\";\n    64\t  if (!Number.isSafeInteger(check.maxOutputBytes) || check.maxOutputBytes < 2 || check.maxOutputBytes > MAX_OUTPUT_BYTES) return \"hidden black-box oracle output limit is outside the allowed range\";\n    65\t  return null;\n    66\t}\n    67\t\n    68\t/** Run candidate code as a black box. Only bounded summaries leave this function; raw output is discarded. */\n    69\texport async function runBlackBoxOracle(task, workspace, check, { resources = null, protectedCorpusPaths = [] } = {}) {\n    70\t  const problem = blackBoxOracleProblem(check, task.dir, task.fixture ?? null);\n    71\t  if (problem) throw new Error(problem);\n    72\t  const casesPath = confinedPath(task.dir, check.casesFile);\n    73\t  const entrypoint = confinedPath(workspace, check.argv[0]);\n    74\t  if (!fs.statSync(entrypoint).isFile()) throw new Error(\"black-box candidate entrypoint is not a regular file\");\n    75\t  const cases = JSON.parse(fs.readFileSync(casesPath, \"utf8\"));\n    76\t  const command = RUNTIMES[check.runtime];\n    77\t  const failures = [];\n    78\t  const timeoutCases = [];\n    79\t  const outputLimitCases = [];\n    80\t  const executionFailureCases = [];\n    81\t  const invalidOutputCases = [];\n    82\t  const mismatchCases = [];\n    83\t  const fixturePath = task.fixture ? confinedPath(task.dir, task.fixture) : null;\n    84\t  const candidateWorkspace = fs.realpathSync(workspace);\n    85\t  const relativeCases = path.relative(candidateWorkspace, casesPath);\n    86\t  if (relativeCases === \"\" || (!relativeCases.startsWith(`..${path.sep}`) && relativeCases !== \"..\" && !path.isAbsolute(relativeCases))) {\n    87\t    throw new Error(\"black-box oracle cases unexpectedly overlap the candidate workspace\");\n    88\t  }\n    89\t  if (fixturePath) {\n    90\t    const relativeFixtureCases = path.relative(fixturePath, casesPath);\n    91\t    if (relativeFixtureCases === \"\" || (!relativeFixtureCases.startsWith(`..${path.sep}`) && relativeFixtureCases !== \"..\" && !path.isAbsolute(relativeFixtureCases))) {\n    92\t      throw new Error(\"black-box oracle cases unexpectedly overlap the copied candidate fixture\");\n    93\t    }\n    94\t  }\n    95\t  const deadline = Date.now() + check.totalTimeoutMs;\n  1360\t});\n  1361\t\n  1362\ttest(\"task-tree digests frame paths, entry types, executable mode, and content lengths\", async () => {\n  1363\t  const { taskTreeDigest } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  1364\t  const left = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-digest-left-\"));\n  1365\t  const right = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-digest-right-\"));\n  1366\t  fs.writeFileSync(path.join(left, \"one\"), \"xtwo\\0y\");\n  1367\t  fs.writeFileSync(path.join(right, \"one\"), \"x\");\n  1368\t  fs.writeFileSync(path.join(right, \"two\"), \"y\");\n  1369\t  assert.notEqual(taskTreeDigest(left), taskTreeDigest(right), \"ambiguous path/content concatenation must not collide\");\n  1370\t\n  1371\t  const file = path.join(left, \"one\");\n  1372\t  const original = taskTreeDigest(left);\n  1373\t  fs.chmodSync(file, 0o755);\n  1374\t  assert.notEqual(taskTreeDigest(left), original, \"executable mode affects task identity\");\n  1375\t  const beforeEmptyDirectory = taskTreeDigest(left);\n  1376\t  fs.mkdirSync(path.join(left, \"empty-dir\"));\n  1377\t  assert.notEqual(taskTreeDigest(left), beforeEmptyDirectory, \"empty directories are represented in the digest\");\n  1378\t});\n  1379\t\n  1380\ttest(\"task setup and validators run with cleared env, no network, confined filesystem, bounded output and timeout\", async () => {\n  1381\t  const { runIsolated, sandboxAvailable } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  1382\t  assert.equal(sandboxAvailable(), true, \"this security test requires the real Bubblewrap executable\");\n  1383\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-isolated-workspace-\"));\n  1384\t  const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-isolated-outside-\"));\n  1385\t  const canary = path.join(outside, \"protected.txt\");\n  1386\t  fs.writeFileSync(canary, \"HOST_CANARY_7f4a\");\n  1387\t  process.env.EVAL_SYNTHETIC_SECRET = \"REDACTED\";\n  1388\t  const probeScript = `const fs=require('fs'),cp=require('child_process');let read='';try{read=fs.readFileSync(${JSON.stringify(canary)},'utf8')}catch{};try{fs.writeFileSync('/tmp/host-write-canary','changed')}catch{};const nested=cp.spawnSync('/usr/bin/unshare',['-Ur','true']);console.log(JSON.stringify({secret:process.env.EVAL_SYNTHETIC_SECRET??null,read,home:process.env.HOME,host:fs.existsSync('/home/mike/.ssh'),nestedUserns:nested.status}))`;\n  1389\t  const hiddenProbe = await runIsolated(`node -e ${JSON.stringify(probeScript)}`, { cwd: root, home: true, timeoutSec: 5 });\n  1390\t  assert.equal(hiddenProbe.status, 0, hiddenProbe.stderr);\n  1391\t  const observed = JSON.parse(hiddenProbe.stdout.trim());\n  1392\t  assert.equal(observed.secret, null);\n  1393\t  assert.equal(observed.read, \"\");\n  1394\t  assert.equal(observed.host, false);\n  1395\t  assert.notEqual(observed.nestedUserns, 0, \"task code could create a nested user namespace\");\n  1396\t  assert.equal(fs.existsSync(\"/tmp/host-write-canary\"), false);\n  1397\t  const networkServer = http.createServer((_req, res) => res.end(\"reachable\"));\n  1398\t  await new Promise<void>((resolve) => networkServer.listen(0, \"127.0.0.1\", resolve));\n  1399\t  const port = (networkServer.address() as any).port;\n  1400\t  const netResult = await runIsolated(`node -e \\\"fetch('http://127.0.0.1:${port}').then(()=>process.exit(5)).catch(()=>process.exit(0))\\\"`, { cwd: root, timeoutSec: 5 });\n     1\t/**\n     2\t * Hardened legacy hidden tests (owner decision 2026-10-18) and the sealed heldout-v2 corpus binding: test\n     3\t * infrastructure is never carried from the agent's workspace into the checks, test-runner configuration changes refuse\n     4\t * the checks, and the custodian's task/hidden digests bind the selected corpus exactly.\n     5\t */\n     6\timport { test } from \"node:test\";\n     7\timport assert from \"node:assert/strict\";\n     8\timport { createHash } from \"node:crypto\";\n     9\timport fs from \"node:fs\";\n    10\timport os from \"node:os\";\n    11\timport path from \"node:path\";\n    12\timport { spawn, spawnSync } from \"node:child_process\";\n    13\timport { fileURLToPath } from \"node:url\";\n    14\timport { startGateway } from \"./helpers/fixtures.js\";\n    15\t\n    16\tconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n    17\tconst hardened = () => import(path.join(ROOT, \"eval/hardened_check.mjs\"));\n    18\tconst gitEnv = { PATH: \"/usr/bin:/bin\", HOME: os.tmpdir(), GIT_CONFIG_NOSYSTEM: \"1\", GIT_CONFIG_GLOBAL: \"/dev/null\" };\n    19\tconst git = (cwd: string, ...argv: string[]) => {\n    20\t  const r = spawnSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@example.invalid\", \"-c\", \"init.defaultBranch=main\", ...argv], { cwd, env: gitEnv, encoding: \"utf8\" });\n    21\t  assert.equal(r.status, 0, r.stderr);\n    22\t  return r.stdout.trim();\n    23\t};\n    24\t\n    25\ttest(\"runAsAclArgs scopes evaluator and operator permissions with directory defaults\", async () => {\n    26\t  const { runAsAclArgs } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n    27\t  assert.deepEqual(runAsAclArgs(\"nexus-eval\", 1000, \"/workspace\", true), {\n    28\t    access: [\"-R\", \"-m\", \"u:nexus-eval:rwX,u:1000:rwX\", \"/workspace\"],\n    29\t    defaults: [\"-m\", \"d:u:nexus-eval:rwx,d:u:1000:rwx,d:m::rwx\", \"/workspace\"],\n    30\t  });\n    31\t  assert.deepEqual(runAsAclArgs(\"nexus-eval\", 1000, \"/workspace/file\", false), {\n    32\t    access: [\"-R\", \"-m\", \"u:nexus-eval:rwX,u:1000:rwX\", \"/workspace/file\"],\n    33\t    defaults: null,\n    34\t  });\n    35\t});\n    36\t\n    37\ttest(\"configured Go toolchain takes precedence over the host fallback\", async () => {\n    38\t  const { selectToolchainRoot } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n    39\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"go-root-precedence-\"));\n    40\t  try {\n    41\t    const configured = path.join(root, \"configured-go-root\");\n    42\t    const fallback = path.join(root, \"host-go-root\");\n    43\t    fs.mkdirSync(configured);\n    44\t    fs.mkdirSync(fallback);\n    45\t    assert.equal(selectToolchainRoot(configured, fallback), configured);\n    46\t    assert.equal(selectToolchainRoot(null, fallback), fallback);\n    47\t    assert.equal(selectToolchainRoot(null, null), null);\n    48\t  } finally {\n    49\t    fs.rmSync(root, { recursive: true, force: true });\n    50\t  }\n    51\t});\n    52\t\n    53\ttest(\"asUserSpec preserves timeout metadata and isolated processes reject missing timeouts\", async () => {\n    54\t  const { asUserSpec } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n    55\t  const { runIsolatedProcess } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n    56\t  const spec = { cmd: \"/usr/bin/bwrap\", argv: [\"--version\"], timeoutMs: 1200, marker: \"preserved\" };\n    57\t  assert.deepEqual(asUserSpec(\"nexus-eval\", spec), {\n    58\t    ...spec,\n    59\t    cmd: \"/usr/bin/sudo\",\n    60\t    argv: [\"-n\", \"-u\", \"nexus-eval\", \"--\", \"/usr/bin/bwrap\", \"--version\"],\n    61\t  });\n    62\t  assert.throws(() => runIsolatedProcess({ cmd: \"/usr/bin/true\", argv: [] }), /isolated process spec has no timeoutMs/);\n    63\t  assert.throws(() => runIsolatedProcess({ cmd: \"/usr/bin/true\", argv: [], timeoutMs: 0 }), /isolated process spec has no timeoutMs/);\n    64\t});\n    65\t\n    66\ttest(\"test infrastructure is recognised across Python, Go, JS/TS and Rust layouts\", async () => {\n    67\t  const { isTestInfraPath } = await hardened();\n    68\t  for (const p of [\"conftest.py\", \"pkg/conftest.py\", \"pytest.ini\", \"tox.ini\", \"setup.cfg\", \"sitecustomize.py\", \"x.pth\", \"tests/test_a.py\", \"src/test_a.py\", \"a_test.py\",\n    69\t    \"pkg/x_test.go\", \"src/x.test.ts\", \"web/a.spec.jsx\", \"__tests__/a.js\", \"jest.config.js\", \"vitest.config.mts\", \".mocharc.json\", \"build.rs\", \".cargo/config.toml\", \".github/workflows/ci.yml\", \"Makefile\", \".env.local\",\n    70\t    \"karma.conf.js\", \"jest-preset.js\", \"vitest.workspace.ts\", \"globalSetup.ts\", \"setup-tests.js\", \"test-helpers.ts\", \"internal/testhelper/x.go\", \"pkg/_testing.py\",\n    71\t    \".npmrc\", \".yarnrc.yml\", \".pnpmfile.cjs\", \"go.work\", \"rust-toolchain.toml\", \"tsconfig.json\", \".coveragerc\", \".gitattributes\", \"node_modules/x/i.js\", \".venv/lib/x.py\", \"a/__pycache__/m.pyc\"]) {\n    72\t    assert.equal(isTestInfraPath(p), true, p);\n    73\t  }\n    74\t  for (const p of [\"src/app.py\", \"pkg/server.go\", \"src/index.ts\", \"src/lib.rs\", \"README.md\", \"package.json\", \"pyproject.toml\", \"Cargo.toml\", \"contest.py\"]) {\n    75\t    assert.equal(isTestInfraPath(p), false, p);\n    76\t  }\n    77\t});\n    78\t\n    79\ttest(\"hidden test staging preserves workspace files and mounts only copied hidden files\", async () => {\n    80\t  const { stageHiddenFiles, hiddenOutputHasTests } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n    81\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"hidden-stage-\"));\n    82\t  try {\n    83\t    const source = path.join(root, \"task/hidden\");\n    84\t    const ws = path.join(root, \"workspace\");\n    85\t    fs.mkdirSync(source, { recursive: true });\n    86\t    fs.mkdirSync(path.join(ws, \"test\"), { recursive: true });\n    87\t    fs.writeFileSync(path.join(source, \"private.test.js\"), \"hidden\\n\");\n    88\t    fs.writeFileSync(path.join(ws, \"existing.js\"), \"keep root\\n\");\n    89\t    fs.writeFileSync(path.join(ws, \"test/existing.js\"), \"keep test\\n\");\n    90\t    assert.deepEqual(stageHiddenFiles(source, ws, \".\", { readOnlyHidden: true }), [\"private.test.js\"]);\n    91\t    assert.deepEqual(stageHiddenFiles(source, ws, \"test\", { readOnlyHidden: true }), [\"test/private.test.js\"]);\n    92\t    assert.equal(fs.readFileSync(path.join(ws, \"existing.js\"), \"utf8\"), \"keep root\\n\");\n    93\t    assert.equal(fs.readFileSync(path.join(ws, \"test/existing.js\"), \"utf8\"), \"keep test\\n\");\n    94\t    assert.equal(fs.readFileSync(path.join(ws, \"private.test.js\"), \"utf8\"), \"hidden\\n\");\n    95\t    assert.equal(fs.readFileSync(path.join(ws, \"test/private.test.js\"), \"utf8\"), \"hidden\\n\");\n    96\t    const outsideDir = path.join(root, \"outside\");\n    97\t    fs.mkdirSync(outsideDir);\n    98\t    fs.symlinkSync(outsideDir, path.join(ws, \"sym\"));\n    99\t    assert.throws(() => stageHiddenFiles(source, ws, \"sym/newparent\", { readOnlyHidden: true }), /unsafe hidden test parent directory/);\n   100\t    assert.equal(fs.existsSync(path.join(outsideDir, \"newparent\")), false);\n   101\t    assert.equal(hiddenOutputHasTests(\"Ran 0 tests\"), false);\n   102\t    assert.equal(hiddenOutputHasTests(\"[no test files]\"), false);\n   103\t    assert.equal(hiddenOutputHasTests(\"Ran 1 test\\n\\nOK\"), true);\n   104\t    assert.equal(hiddenOutputHasTests(\"?   example/cmd [no test files]\\nok  example/pkg 0.01s\"), true);\n   105\t    assert.equal(hiddenOutputHasTests(\"test result: ok. 5 passed; 0 failed\\ntest result: ok. 0 passed; 0 failed\"), true);\n   106\t    assert.equal(hiddenOutputHasTests(\"?   example/cmd [no test files]\"), false);\n   107\t    assert.equal(hiddenOutputHasTests(\"test result: ok. 0 passed; 0 failed\"), false);\n   108\t    assert.equal(hiddenOutputHasTests(\"Ran 0 tests\"), false);\n   109\t    assert.equal(hiddenOutputHasTests(\"\"), false);\n   110\t    assert.equal(hiddenOutputHasTests(\"hello\"), false);\n   111\t    assert.equal(hiddenOutputHasTests(\"hidden: all assertions passed\"), true, \"a validator-produced summary is used only for development scoring\");\n   112\t  } finally {\n   113\t    fs.rmSync(root, { recursive: true, force: true });\n   114\t  }\n   115\t});\n   116\t\n   117\ttest(\"Python oracle preload keeps saved source out of module globals and sys.path\", () => {\n   118\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"python-oracle-preload-\"));\n   119\t  try {\n   120\t    const runner = path.join(root, \"runner\");\n","exit_code":0,"duration":{"secs":1,"nanos":35011638}},"started_at_ms":1793279645438,"completed_at_ms":1793279646474}}
