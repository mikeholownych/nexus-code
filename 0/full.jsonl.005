http://localhost:9200)\n    --prefix <P>    index prefix to search (default \"ax\" — what `xerj autoindex` writes)\n    --api-key <K>   Authorization (or $XERJ_API_KEY; --insecure nodes need none)\n    -k <N>          number of passages to return (default 5). A non-number is a\n                    usage error, not a silent default\n    --full <CHARS>  max characters of each passage to print (default 600)\n    --json          print the raw response instead of formatted passages\n\nEXAMPLE:\n    xerj --insecure -d ./.xerj-data &                 # a node, running\n    xerj autoindex ref/sled                           # index once\n    xerj search \"fsync the WAL segment on rotation\"    # one line in, a passage out\n\nSEE ALSO:\n    xerj def <symbol>    exact go-to-definition when you already know the name\n\n    30\t}\n    31\t\n    32\texport function candidateAgentPath(configuredPath, toolchains = resolveHostToolchains()) {\n    33\t  const configuredEntries = (configuredPath ?? \"/usr/bin:/bin\").split(path.delimiter).filter(Boolean);\n    34\t  const toolchainEntries = [\n    35\t    ...(toolchains.rustRoot ? [\"/usr/local/nexus-qual/rust/bin\"] : []),\n    36\t    ...(toolchains.goRoot ? [\"/usr/local/go/bin\"] : []),\n    37\t  ];\n    38\t  return [...new Set([...toolchainEntries, ...configuredEntries])].join(path.delimiter);\n    39\t}\n    40\t\n    41\texport function selectToolchainRoot(configuredRoot, fallbackRoot) {\n    42\t  return configuredRoot ?? fallbackRoot ?? null;\n    43\t}\n    44\t\n    45\texport function oracleToolchainPathProblem(stat) {\n    46\t  if (!stat || stat.isSymbolicLink?.() || stat.uid !== 0 || (stat.mode & 0o022) !== 0) {\n    47\t    return \"pinned oracle toolchain entry is not a real root-owned path without group or other write permission\";\n    48\t  }\n    49\t  return null;\n    50\t}\n    51\t\n    52\texport function candidateToolchainRootProblem(stat, resolvedPath, expectedPath) {\n    53\t  if (!stat || !stat.isDirectory() || stat.isSymbolicLink() || oracleToolchainPathProblem(stat) || resolvedPath !== expectedPath) {\n    54\t    return \"pinned candidate toolchain root is not a safe real directory\";\n    55\t  }\n    56\t  return null;\n    57\t}\n    58\t\n    59\tfunction toolchainMountArgs(toolchains, parentDirectoryAvailable = false) {\n    60\t  const args = [];\n    61\t  const createdDirectories = new Set(parentDirectoryAvailable ? [\"/usr/local\"] : []);\n    62\t  const ensureDirectory = (directory) => {\n    63\t    if (createdDirectories.has(directory)) return;\n    64\t    args.push(\"--dir\", directory);\n    65\t    createdDirectories.add(directory);\n    66\t  };\n    67\t  if (toolchains.goRoot) {\n    68\t    ensureDirectory(\"/usr/local\");\n    69\t    args.push(\"--ro-bind\", toolchains.goRoot, \"/usr/local/go\");\n    70\t  }\n    71\t  if (toolchains.rustRoot) {\n    72\t    ensureDirectory(\"/usr/local\");\n    73\t    ensureDirectory(\"/usr/local/nexus-qual\");\n    74\t    args.push(\"--ro-bind\", toolchains.rustRoot, \"/usr/local/nexus-qual/rust\");\n    75\t  }\n    76\t  return args;\n    77\t}\n    78\t\n    79\texport function candidateToolchainMountArgs(toolchains, systemDirectories = []) {\n    80\t  return toolchainMountArgs(toolchains, systemDirectories.includes(\"/usr/local/lib\"));\n    81\t}\n    82\t\n    83\tfunction resolveHostToolchains() {\n    84\t  const availableDirectory = ({ root, required }) => {\n    85\t    let stat;\n    86\t    try { stat = fs.lstatSync(root); }\n    87\t    catch (error) {\n    88\t      if (error?.code === \"ENOENT\") return null;\n    89\t      throw error;\n    90\t    }\n    91\t    const rootProblem = candidateToolchainRootProblem(stat, fs.realpathSync(root), root);\n    92\t    if (rootProblem) throw new Error(rootProblem);\n    93\t    const problem = pinnedToolchainProblem(root, required);\n    94\t    if (problem) throw new Error(problem);\n    95\t    return root;\n    96\t  };\n    97\t  const roots = Object.fromEntries(PINNED_ORACLE_TOOLCHAINS.map((toolchain) => [toolchain.root, availableDirectory(toolchain)]));\n    98\t  return {\n    99\t    goRoot: roots[\"/usr/local/go\"],\n   100\t    rustRoot: roots[\"/usr/local/nexus-qual/rust\"],\n   101\t  };\n   102\t}\n   103\t\n   104\t/** Python black-box oracles may invoke only these root-owned, pinned compiler runtimes. */\n   105\texport function oracleToolchainVersionProblem({ goVersion, rustcVersion, cargoVersion }) {\n   106\t  const actualGo = /^go version (go\\S+)/.exec(goVersion ?? \"\")?.[1];\n   107\t  const actualRustc = /^rustc (\\S+)/.exec(rustcVersion ?? \"\")?.[1];\n   108\t  const actualCargo = /^cargo (\\S+)/.exec(cargoVersion ?? \"\")?.[1];\n   109\t  if (actualGo !== `go${TOOLCHAIN_POLICY.go}` || actualRustc !== TOOLCHAIN_POLICY.rust || actualCargo !== TOOLCHAIN_POLICY.rust) {\n   110\t    return `pinned oracle toolchain versions do not match policy (expected Go ${TOOLCHAIN_POLICY.go} and Rust ${TOOLCHAIN_POLICY.rust})`;\n   111\t  }\n   112\t  return null;\n   113\t}\n   114\t\n   115\tfunction isInsideAnyRoot(candidate, roots) {\n   116\t  return roots.some((root) => candidate === root || candidate.startsWith(`${root}${path.sep}`));\n   117\t}\n   118\t\n   119\tfunction mountedSpellingsForTarget(target, roots) {\n   120\t  const spellings = new Set();\n   121\t  for (const root of roots) {\n   122\t    let canonicalRoot;\n   123\t    try { canonicalRoot = fs.realpathSync(root); }\n   124\t    catch (error) {\n   125\t      if (error?.code === \"ENOENT\") continue;\n   126\t      throw error;\n   127\t    }\n   128\t    if (!isInsideAnyRoot(target, [canonicalRoot])) continue;\n   129\t    spellings.add(path.resolve(root, path.relative(canonicalRoot, target)));\n   130\t  }\n   131\t  return [...spellings];\n   132\t}\n   133\t\n   134\t/** Reject every unpinned Go/Rust compiler reachable through the task's mounted runtime paths. */\n   135\texport function oracleCompilerExposureProblem(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS, additionalMountedPaths = []) {\n   136\t  const scan = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths);\n   137\t  if (scan.problem) return scan.problem;\n   138\t  return scan.paths.length\n   139\t    ? `unapproved Go/Rust compiler executable is exposed through oracle system mounts: ${scan.paths.join(\", \")}`\n   140\t    : null;\n   141\t}\n   142\t\n   143\tfunction scanOracleCompilerExposure(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS, additionalMountedPaths = []) {\n   144\t  const roots = [...new Set([...systemDirectories, ...systemEtcDirectories, ...additionalMountedPaths])].sort();\n   145\t\n   146\t  const exposed = new Set();\n   147\t  const visited = new Set();\n   148\t  const approvedRoots = PINNED_ORACLE_TOOLCHAINS.map(({ root }) => root);\n   149\t  const inspectExecutable = (item, isSymbolicLink) => {\n   150\t    if (visited.has(item)) return;\n   151\t    visited.add(item);\n   152\t    const entryName = path.basename(item);\n   153\t    if (!UNPINNED_ORACLE_COMPILER_NAME.test(entryName) && !isSymbolicLink) return;\n   154\t    let stat;\n   155\t    let target;\n   156\t    try {\n   157\t      stat = fs.statSync(item);\n   158\t      target = fs.realpathSync(item);\n   159\t    } catch (error) {\n   160\t      if (error?.code === \"ENOENT\") return;\n   161\t      throw error;\n   162\t    }\n   163\t    if (!stat.isFile()\n   164\t      || (stat.mode & 0o111) === 0\n   165\t      || (!UNPINNED_ORACLE_COMPILER_NAME.test(entryName) && !UNPINNED_ORACLE_COMPILER_NAME.test(path.basename(target)))\n   166\t      || isInsideAnyRoot(target, approvedRoots)) return;\n   167\t    const descriptor = fs.openSync(target, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0));\n   168\t    let header;\n   169\t    try {\n   170\t      header = Buffer.alloc(2);\n   171\t      fs.readSync(descriptor, header, 0, header.length, 0);\n   172\t    } finally {\n   173\t      fs.closeSync(descriptor);\n   174\t    }\n   175\t    // Names such as `go-225` also occur in executable-mode terminfo records. Exclude only\n   176\t    // positively identified compiled terminfo data; keep no-shebang and binfmt executables.\n   177\t    const terminfoMagic = header.equals(Buffer.from([0x1a, 0x01])) || header.equals(Buffer.from([0x1e, 0x02]));\n   178\t    if (terminfoMagic && /(?:^|\\/)terminfo\\//.test(item)) return;\n   179\t    // The candidate's explicit runtime mounts may expose compiler targets outside the\n   180\t    // standard system roots. Mask each visible spelling after all runtime mounts are added.\n   181\t    for (const mountedPath of mountedSpellingsForTarget(target, roots)) exposed.add(mountedPath);\n   182\t  };\n   183\t  const vi…5890 tokens truncated…\n  1383\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-isolated-workspace-\"));\n  1384\t  const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-isolated-outside-\"));\n  1385\t  const canary = path.join(outside, \"protected.txt\");\n  1386\t  fs.writeFileSync(canary, \"HOST_CANARY_7f4a\");\n  1387\t  process.env.EVAL_SYNTHETIC_SECRET = \"REDACTED\";\n  1388\t  const probeScript = `const fs=require('fs'),cp=require('child_process');let read='';try{read=fs.readFileSync(${JSON.stringify(canary)},'utf8')}catch{};try{fs.writeFileSync('/tmp/host-write-canary','changed')}catch{};const nested=cp.spawnSync('/usr/bin/unshare',['-Ur','true']);console.log(JSON.stringify({secret:process.env.EVAL_SYNTHETIC_SECRET??null,read,home:process.env.HOME,host:fs.existsSync('/home/mike/.ssh'),nestedUserns:nested.status}))`;\n  1389\t  const hiddenProbe = await runIsolated(`node -e ${JSON.stringify(probeScript)}`, { cwd: root, home: true, timeoutSec: 5 });\n  1390\t  assert.equal(hiddenProbe.status, 0, hiddenProbe.stderr);\n  1391\t  const observed = JSON.parse(hiddenProbe.stdout.trim());\n  1392\t  assert.equal(observed.secret, null);\n  1393\t  assert.equal(observed.read, \"\");\n  1394\t  assert.equal(observed.host, false);\n  1395\t  assert.notEqual(observed.nestedUserns, 0, \"task code could create a nested user namespace\");\n  1396\t  assert.equal(fs.existsSync(\"/tmp/host-write-canary\"), false);\n  1397\t  const networkServer = http.createServer((_req, res) => res.end(\"reachable\"));\n  1398\t  await new Promise<void>((resolve) => networkServer.listen(0, \"127.0.0.1\", resolve));\n  1399\t  const port = (networkServer.address() as any).port;\n  1400\t  const netResult = await runIsolated(`node -e \\\"fetch('http://127.0.0.1:${port}').then(()=>process.exit(5)).catch(()=>process.exit(0))\\\"`, { cwd: root, timeoutSec: 5 });\n     1\t/**\n     2\t * Hardened legacy hidden tests (owner decision 2026-10-18) and the sealed heldout-v2 corpus binding: test\n     3\t * infrastructure is never carried from the agent's workspace into the checks, test-runner configuration changes refuse\n     4\t * the checks, and the custodian's task/hidden digests bind the selected corpus exactly.\n     5\t */\n     6\timport { test } from \"node:test\";\n     7\timport assert from \"node:assert/strict\";\n     8\timport { createHash } from \"node:crypto\";\n     9\timport fs from \"node:fs\";\n    10\timport os from \"node:os\";\n    11\timport path from \"node:path\";\n    12\timport { spawn, spawnSync } from \"node:child_process\";\n    13\timport { fileURLToPath } from \"node:url\";\n    14\timport { startGateway } from \"./helpers/fixtures.js\";\n    15\t\n    16\tconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n    17\tconst hardened = () => import(path.join(ROOT, \"eval/hardened_check.mjs\"));\n    18\tconst gitEnv = { PATH: \"/usr/bin:/bin\", HOME: os.tmpdir(), GIT_CONFIG_NOSYSTEM: \"1\", GIT_CONFIG_GLOBAL: \"/dev/null\" };\n    19\tconst git = (cwd: string, ...argv: string[]) => {\n    20\t  const r = spawnSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@example.invalid\", \"-c\", \"init.defaultBranch=main\", ...argv], { cwd, env: gitEnv, encoding: \"utf8\" });\n    21\t  assert.equal(r.status, 0, r.stderr);\n    22\t  return r.stdout.trim();\n    23\t};\n    24\t\n    25\ttest(\"runAsAclArgs scopes evaluator and operator permissions with directory defaults\", async () => {\n    26\t  const { runAsAclArgs } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n    27\t  assert.deepEqual(runAsAclArgs(\"nexus-eval\", 1000, \"/workspace\", true), {\n    28\t    access: [\"-R\", \"-m\", \"u:nexus-eval:rwX,u:1000:rwX\", \"/workspace\"],\n    29\t    defaults: [\"-m\", \"d:u:nexus-eval:rwx,d:u:1000:rwx,d:m::rwx\", \"/workspace\"],\n    30\t  });\n    31\t  assert.deepEqual(runAsAclArgs(\"nexus-eval\", 1000, \"/workspace/file\", false), {\n    32\t    access: [\"-R\", \"-m\", \"u:nexus-eval:rwX,u:1000:rwX\", \"/workspace/file\"],\n    33\t    defaults: null,\n    34\t  });\n    35\t});\n    36\t\n    37\ttest(\"configured Go toolchain takes precedence over the host fallback\", async () => {\n    38\t  const { selectToolchainRoot } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n    39\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"go-root-precedence-\"));\n    40\t  try {\n    41\t    const configured = path.join(root, \"configured-go-root\");\n    42\t    const fallback = path.join(root, \"host-go-root\");\n    43\t    fs.mkdirSync(configured);\n    44\t    fs.mkdirSync(fallback);\n    45\t    assert.equal(selectToolchainRoot(configured, fallback), configured);\n    46\t    assert.equal(selectToolchainRoot(null, fallback), fallback);\n    47\t    assert.equal(selectToolchainRoot(null, null), null);\n    48\t  } finally {\n    49\t    fs.rmSync(root, { recursive: true, force: true });\n    50\t  }\n    51\t});\n    52\t\n    53\ttest(\"asUserSpec preserves timeout metadata and isolated processes reject missing timeouts\", async () => {\n    54\t  const { asUserSpec } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n    55\t  const { runIsolatedProcess } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n    56\t  const spec = { cmd: \"/usr/bin/bwrap\", argv: [\"--version\"], timeoutMs: 1200, marker: \"preserved\" };\n    57\t  assert.deepEqual(asUserSpec(\"nexus-eval\", spec), {\n    58\t    ...spec,\n    59\t    cmd: \"/usr/bin/sudo\",\n    60\t    argv: [\"-n\", \"-u\", \"nexus-eval\", \"--\", \"/usr/bin/bwrap\", \"--version\"],\n    61\t  });\n    62\t  assert.throws(() => runIsolatedProcess({ cmd: \"/usr/bin/true\", argv: [] }), /isolated process spec has no timeoutMs/);\n    63\t  assert.throws(() => runIsolatedProcess({ cmd: \"/usr/bin/true\", argv: [], timeoutMs: 0 }), /isolated process spec has no timeoutMs/);\n    64\t});\n    65\t\n    66\ttest(\"test infrastructure is recognised across Python, Go, JS/TS and Rust layouts\", async () => {\n    67\t  const { isTestInfraPath } = await hardened();\n    68\t  for (const p of [\"conftest.py\", \"pkg/conftest.py\", \"pytest.ini\", \"tox.ini\", \"setup.cfg\", \"sitecustomize.py\", \"x.pth\", \"tests/test_a.py\", \"src/test_a.py\", \"a_test.py\",\n    69\t    \"pkg/x_test.go\", \"src/x.test.ts\", \"web/a.spec.jsx\", \"__tests__/a.js\", \"jest.config.js\", \"vitest.config.mts\", \".mocharc.json\", \"build.rs\", \".cargo/config.toml\", \".github/workflows/ci.yml\", \"Makefile\", \".env.local\",\n    70\t    \"karma.conf.js\", \"jest-preset.js\", \"vitest.workspace.ts\", \"globalSetup.ts\", \"setup-tests.js\", \"test-helpers.ts\", \"internal/testhelper/x.go\", \"pkg/_testing.py\",\n    71\t    \".npmrc\", \".yarnrc.yml\", \".pnpmfile.cjs\", \"go.work\", \"rust-toolchain.toml\", \"tsconfig.json\", \".coveragerc\", \".gitattributes\", \"node_modules/x/i.js\", \".venv/lib/x.py\", \"a/__pycache__/m.pyc\"]) {\n    72\t    assert.equal(isTestInfraPath(p), true, p);\n    73\t  }\n    74\t  for (const p of [\"src/app.py\", \"pkg/server.go\", \"src/index.ts\", \"src/lib.rs\", \"README.md\", \"package.json\", \"pyproject.toml\", \"Cargo.toml\", \"contest.py\"]) {\n    75\t    assert.equal(isTestInfraPath(p), false, p);\n    76\t  }\n    77\t});\n    78\t\n    79\ttest(\"hidden test staging preserves workspace files and mounts only copied hidden files\", async () => {\n    80\t  const { stageHiddenFiles, hiddenOutputHasTests } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n    81\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"hidden-stage-\"));\n    82\t  try {\n    83\t    const source = path.join(root, \"task/hidden\");\n    84\t    const ws = path.join(root, \"workspace\");\n    85\t    fs.mkdirSync(source, { recursive: true });\n    86\t    fs.mkdirSync(path.join(ws, \"test\"), { recursive: true });\n    87\t    fs.writeFileSync(path.join(source, \"private.test.js\"), \"hidden\\n\");\n    88\t    fs.writeFileSync(path.join(ws, \"existing.js\"), \"keep root\\n\");\n    89\t    fs.writeFileSync(path.join(ws, \"test/existing.js\"), \"keep test\\n\");\n    90\t    assert.deepEqual(stageHiddenFiles(source, ws, \".\", { readOnlyHidden: true }), [\"private.test.js\"]);\n    91\t    assert.deepEqual(stageHiddenFiles(source, ws, \"test\", { readOnlyHidden: true }), [\"test/private.test.js\"]);\n    92\t    assert.equal(fs.readFileSync(path.join(ws, \"existing.js\"), \"utf8\"), \"keep root\\n\");\n    93\t    assert.equal(fs.readFileSync(path.join(ws, \"test/existing.js\"), \"utf8\"), \"keep test\\n\");\n    94\t    assert.equal(fs.readFileSync(path.join(ws, \"private.test.js\"), \"utf8\"), \"hidden\\n\");\n    95\t    assert.equal(fs.readFileSync(path.join(ws, \"test/private.test.js\"), \"utf8\"), \"hidden\\n\");\n    96\t    const outsideDir = path.join(root, \"outside\");\n    97\t    fs.mkdirSync(outsideDir);\n    98\t    fs.symlinkSync(outsideDir, path.join(ws, \"sym\"));\n    99\t    assert.throws(() => stageHiddenFiles(source, ws, \"sym/newparent\", { readOnlyHidden: true }), /unsafe hidden test parent directory/);\n   100\t    assert.equal(fs.existsSync(path.join(outsideDir, \"newparent\")), false);\n   101\t    assert.equal(hiddenOutputHasTests(\"Ran 0 tests\"), false);\n   102\t    assert.equal(hiddenOutputHasTests(\"[no test files]\"), false);\n   103\t    assert.equal(hiddenOutputHasTests(\"Ran 1 test\\n\\nOK\"), true);\n   104\t    assert.equal(hiddenOutputHasTests(\"?   example/cmd [no test files]\\nok  example/pkg 0.01s\"), true);\n   105\t    assert.equal(hiddenOutputHasTests(\"test result: ok. 5 passed; 0 failed\\ntest result: ok. 0 passed; 0 failed\"), true);\n   106\t    assert.equal(hiddenOutputHasTests(\"?   example/cmd [no test files]\"), false);\n   107\t    assert.equal(hiddenOutputHasTests(\"test result: ok. 0 passed; 0 failed\"), false);\n   108\t    assert.equal(hiddenOutputHasTests(\"Ran 0 tests\"), false);\n   109\t    assert.equal(hiddenOutputHasTests(\"\"), false);\n   110\t    assert.equal(hiddenOutputHasTests(\"hello\"), false);\n   111\t    assert.equal(hiddenOutputHasTests(\"hidden: all assertions passed\"), true, \"a validator-produced summary is used only for development scoring\");\n   112\t  } finally {\n   113\t    fs.rmSync(root, { recursive: true, force: true });\n   114\t  }\n   115\t});\n   116\t\n   117\ttest(\"Python oracle preload keeps saved source out of module globals and sys.path\", () => {\n   118\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"python-oracle-preload-\"));\n   119\t  try {\n   120\t    const runner = path.join(root, \"runner\");\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18771-cd08-7c60-9b2e-7bad123756d6","create_time":1793279646.9461558}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
