flow.match(/go-version: '([^']+)'/g) ?? []).length, 2);\n   488\t  assert.equal((workflow.match(/go-version: '1\\.22\\.12'/g) ?? []).length, 2, \"both CI jobs install the exact approved Go version\");\n   489\t  assert.equal((workflow.match(/run: bash scripts\\/install-evaluator-toolchains\\.sh/g) ?? []).length, 2, \"both CI jobs use the same exact-version installer\");\n   490\t  assert.equal(oracleToolchainVersionProblem({\n   491\t    goVersion: \"go version go1.22.12 linux/amd64\",\n   492\t    rustcVersion: \"rustc 1.95.0 (fixture)\",\n   545\t    fs.rmSync(fakeSystemAlias, { recursive: true, force: true });\n   546\t    fs.rmSync(fakeAlternatives, { recursive: true, force: true });\n   547\t    fs.rmSync(fakeSymlinkTarget, { recursive: true, force: true });\n   548\t    fs.rmSync(fakeMountedRuntime, { recursive: true, force: true });\n   549\t  });\n   550\t  assert.equal(oracleCompilerExposureProblem([changingSystem], [], []), null, \"an initially clean mounted system passes compiler preflight\");\n   551\t  assert.equal(candidateCompilerExposureProblem([changingSystem], [], []), null, \"candidate preflight initially observes the same clean mount\");\n   552\t  const introducedCompiler = path.join(changingSystem, \"go\");\n   553\t  fs.writeFileSync(introducedCompiler, compilerCanary);\n   554\t  fs.chmodSync(introducedCompiler, 0o755);\n   555\t  assert.match(oracleCompilerExposureProblem([changingSystem], [], []) ?? \"\", /unapproved Go\\/Rust compiler executable/, \"oracle preflight rescans mounted roots after filesystem changes\");\n   556\t  assert.match(candidateCompilerExposureProblem([changingSystem], [], []) ?? \"\", /candidate task has unapproved Go\\/Rust compiler executable/, \"candidate preflight cannot reuse a stale clean scan\");\n   557\t  const exposure = oracleCompilerExposureProblem([fakeSystem], [fakeAlternatives]);\n   558\t  assert.match(exposure ?? \"\", /unapproved Go\\/Rust compiler executable/);\n   559\t  assert.match(exposure ?? \"\", /rustlib\\/bin\\/rustc/);\n   560\t  assert.match(exposure ?? \"\", /bin\\/cargo-1\\.94\\.0/);\n   561\t  assert.doesNotMatch(exposure ?? \"\", /rustc-alias/, \"a symlink to a compiler outside mounted system roots is not reachable in the sandbox\");\n   562\t  assert.doesNotMatch(exposure ?? \"\", /eval-oracle-unpinned-compiler-alternatives-[^,]+\\/cargo/);\n   563\t  assert.doesNotMatch(exposure ?? \"\", /eval-oracle-unpinned-compiler-alternatives-[^,]+\\/compiler-alias/);\n   564\t  assert.match(exposure ?? \"\", /rustc-1\\.94\\.0/, \"no-shebang executable compilers must be detected and masked\");\n   565\t  assert.doesNotMatch(exposure ?? \"\", /go-225/, \"executable-mode terminfo data is not a compiler binary\");\n   566\t  const externalMountedExposure = oracleCompilerExposureProblem([fakeSystem], [], [fakeExternalGoTarget]);\n   567\t  assert.ok(externalMountedExposure?.includes(fakeExternalGoTarget), \"a compiler target outside system roots must be masked when separately mounted\");\n   568\t  const aliasedExposure = oracleCompilerExposureProblem([fakeSystem, fakeSystemAlias], []);\n   569\t  assert.ok(aliasedExposure?.includes(fakeGoTarget), \"the canonical mounted spelling is scanned and masked\");\n   570\t  assert.ok(aliasedExposure?.includes(path.join(fakeSystemAlias, path.relative(fakeSystem, fakeGoTarget))), \"every mounted spelling of a shared system directory must be scanned and masked\");\n   571\t  const fakeGoAliasTarget = path.join(fakeSystemAlias, \"lib\", \"go-1.22.12\", \"go\");\n   572\t  const maskArgs = compilerExposureMaskArgs({ paths: [fakeGoTarget, fakeGoAliasTarget, fakeCargo, fakeCargo], problem: null });\n   573\t  const maskedDestinations = maskArgs.filter((value, index) => index > 0 && maskArgs[index - 1] === \"/dev/null\");\n   574\t  assert.ok(maskedDestinations.includes(fakeGoTarget), \"the canonical compiler mount spelling must be masked\");\n   575\t  assert.ok(maskedDestinations.includes(fakeGoAliasTarget), \"the compiler's alternate mounted spelling must remain masked\");\n   576\t  assert.equal(maskedDestinations.filter((destination) => destination === fakeCargo).length, 1, \"duplicate regular-file mount destinations must be deduplicated\");\n   577\t  assert.ok(!maskedDestinations.includes(fakeGo), \"Bubblewrap must not bind over a symlink destination\");\n   578\t  assert.ok(!maskedDestinations.includes(path.join(fakeSystemAlias, \"bin\", \"go\")), \"Bubblewrap must not bind over an aliased symlink destination\");\n   579\t  const candidateExposure = candidateCompilerExposureProblem([fakeSystem], [fakeAlternatives], [fakeExternalGoTarget]);\n   580\t  assert.match(candidateExposure ?? \"\", /candidate task has unapproved Go\\/Rust compiler executable/);\n   581\t  assert.match(candidateExposure ?? \"\", /rustlib\\/bin\\/rustc/);\n   582\t  assert.match(candidateExposure ?? \"\", /bin\\/cargo-1\\.94\\.0/);\n   583\t  assert.ok(candidateExposure?.includes(fakeExternalGoTarget), \"candidate preflight includes compiler targets in separately mounted runtime files\");\n   584\t  assert.match(candidateExposure ?? \"\", /rustc-1\\.94\\.0/);\n   585\t  assert.doesNotMatch(candidateExposure ?? \"\", /go-225/);\n   586\t  if (sandboxAvailable() && !oracleToolchainsProblem({ systemDirectories: [fakeSystem, fakeSystemAlias], systemEtcDirectories: [fakeAlternatives], additionalMountedPaths: [fakeExternalGoTarget] })) {\n   587\t    const isolated = isolatedProcessArgv({\n   588\t      cwd: fakeSystem,\n   589\t      command: \"/usr/bin/true\",\n   590\t      readOnlyPaths: [\"/usr/bin/true\"],\n  1428\t  });\n  1429\t  let proxy: Awaited<ReturnType<typeof startModelProxy>> | undefined;\n  1430\t  try {\n  1431\t    await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  1432\t    proxy = await startModelProxy({ upstream: `http://127.0.0.1:${(upstream.address() as any).port}/v1`, authToken: \"UPSTREAM_AUTH_CANARY\", clientToken: \"RUN_LOCAL_TOKEN\", socketPath: path.join(proxyDirectory, \"proxy.sock\") });\n  1433\t    const nodeRuntime = process.execPath;\n  1434\t    let sandbox;\n  1435\t    try {\n  1436\t      sandbox = agentSandboxArgv({ cwd: workspace, home, proxyDirectory, readOnlyPaths: [nodeRuntime], runtimeExecutablePaths: [nodeRuntime], supervisorPath: path.join(ROOT, \"eval/agent_sandbox.mjs\") });\n  1437\t    } catch (error) {\n  1438\t      assert.match(String(error), /candidate task has unapproved Go\\/Rust compiler executable|candidate task compiler exposure could not be checked/);\n  1439\t      return; // An unsafe host system mount is rejected before candidate code can run.\n  1440\t    }\n  1441\t    const script = `const fs=require('fs'),cp=require('child_process');fetch('http://127.0.0.1:40127/v1/models',{headers:{authorization:'Bearer '+process.env.OPENAI_API_KEY},signal:AbortSignal.timeout(2000)}).then(async r=>{let value='';try{value=fs.readFileSync(${JSON.stringify(canary)},'utf8')}catch{};try{fs.writeFileSync('/tmp/host-write-canary','changed')}catch{};const nested=cp.spawnSync('/usr/bin/unshare',['-Ur','true']);const toolchains={};for(const [name,args] of [['go',['version']],['rustc',['--version']],['cargo',['--version']]]){if(process.env.PATH.includes(name==='go'?'/usr/local/go/bin':'/usr/local/nexus-qual/rust/bin')){const check=cp.spawnSync(name,args,{encoding:'utf8'});toolchains[name]={status:check.status,stdout:check.stdout,stderr:check.stderr}}};const absoluteToolchains={};for(const [name,command,args] of [['go','/usr/bin/go',['version']],['rustc','/usr/bin/rustc',['--version']],['cargo','/usr/bin/cargo',['--version']]]){const check=cp.spawnSync(command,args,{encoding:'utf8'});absoluteToolchains[name]={status:check.status,error:check.error?.code??null,version:check.status===0?check.stdout.trim():null}};console.log(JSON.stringify({status:r.status,token:process.env.OPENAI_API_KEY,upstreamVisible:process.env.UPSTREAM_AUTH_CANARY??null,canary:value,nestedUserns:nested.status,toolchains,absoluteToolchains}))}).catch(e=>{console.error(e.message);process.exit(1)})`;\n  1442\t    process.env.UPSTREAM_AUTH_CANARY = \"UPSTREAM_AUTH_CANARY\";\n  1443\t    const candidatePath = candidateAgentPath(\"/usr/bin:/bin\");\n  1444\t    const child = await runSandbox(sandbox.cmd, sandbox.argv, JSON.stringify({ command: nodeRuntime, argv: [\"-e\", script], env: { PATH: candidatePath, OPENAI_API_KEY: \"RUN_LOCAL_TOKEN\" } }));\n  1445\t    assert.equal(child.status, 0, `${child.error ?? \"\"}\\n${child.stderr}\\n${child.stdout}\\nproxy=${JSON.stringify(proxy.stats())}\\nupstream=${JSON.stringify(seen)}`);\n  1446\t    const output = JSON.parse(child.stdout.trim());\n  1447\t    assert.equal(output.status, 200);\n  1448\t    assert.equal(output.token, \"RUN_LOCAL_TOKEN\");\n  1449\t    assert.equal(output.upstreamVisible, null);\n  1450\t    assert.equal(output.canary, \"\");\n  1451\t    assert.notEqual(output.nestedUserns, 0, \"candidate code could create a nested user namespace\");\n  1452\t    if (candidatePath.includes(\"/usr/local/go/bin\")) assert.equal(output.toolchains.go?.status, 0, `Go toolchain is not executable in candidate namespace: ${JSON.stringify(output.toolchains.go)}`);\n","exit_code":0,"duration":{"secs":0,"nanos":787854997}},"started_at_ms":1793280004342,"completed_at_ms":1793280005130}}
