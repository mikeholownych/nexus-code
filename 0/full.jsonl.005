aths must be an array\");\n  const existing = (paths, kind) => paths.filter((source) => {\n    try {\n      const stat = fs.statSync(source);\n      return kind === \"directory\" ? stat.isDirectory() : stat.isFile();\n    } catch { return false; }\n  });\n  const optional = (source, resolve = true) => source === undefined ? null : resolve ? fs.realpathSync(source) : source;\n  return {\n    systemDirectories: existing(SYSTEM_BINARIES, \"directory\"),\n    systemFiles: existing(SYSTEM_ETC_FILES, \"file\"),\n    systemEtcDirectories: existing(SYSTEM_ETC_DIRS, \"directory\"),\n    toolchainDirectories: Object.values(resolveHostToolchains()).filter(Boolean),\n    runtimeSources: {\n      cwd: optional(cwd),\n      home: optional(home),\n      proxyDirectory: optional(proxyDirectory),\n      nodeRuntime: optional(nodeRuntime),\n      supervisorPath: optional(supervisorPath),\n      readOnlyPaths: readOnlyPaths.map((source) => fs.realpathSync(source)),\n    },\n  };\n}\n\nfunction pathOverlaps(left, right) {\n  return left === right || left.startsWith(`${right}${path.sep}`) || right.startsWith(`${left}${path.sep}`);\n}\n\nfunction pathVariants(source) {\n  if (typeof source !== \"string\" || !path.isAbsolute(source)) return [];\n  const lexical = path.resolve(source);\n  let current = lexical;\n  const suffix = [];\n  while (true) {\n    try {\n      const canonical = path.resolve(fs.realpathSync(current), ...suffix);\n      return [...new Set([lexical, canonical])];\n    } catch {\n      const parent = path.dirname(current);\n      if (parent === current) return [lexical];\n      suffix.unshift(path.basename(current));\n      current = parent;\n    }\n  }\n}\n\nfunction candidateMountOverlapProblem(mountSources, protectedCorpusPaths) {\n  return mountSourceOverlapProblem([\n    ...mountSources.systemDirectories,\n    ...mountSources.systemFiles,\n    ...mountSources.systemEtcDirectories,\n    ...mountSources.toolchainDirectories,\n    ...Object.values(mountSources.runtimeSources).flatMap((value) => Array.isArray(value) ? value : value === null ? [] : [value]),\n  ], protectedCorpusPaths);\n}\n\nfunction mountSourceOverlapProblem(sources, protectedCorpusPaths) {\n  if (!Array.isArray(protectedCorpusPaths)) return \"candidate sandbox protectedCorpusPaths must be an array\";\n  for (const protectedPath of protectedCorpusPaths) {\n    const protectedVariants = pathVariants(protectedPath);\n    if (!protectedVariants.length) return \"candidate sandbox protected corpus paths must be absolute\";\n    for (const source of sources) {\n  const roots = [...new Set([...systemDirectories, ...systemEtcDirectories])].sort();\n  const cacheKey = JSON.stringify(roots);\n  if (oracleCompilerExposurePreflights.has(cacheKey)) return oracleCompilerExposurePreflights.get(cacheKey);\n\n  const exposed = new Set();\n  const visited = new Set();\n  const approvedRoots = PINNED_ORACLE_TOOLCHAINS.map(({ root }) => root);\n  const visit = (directory) => {\n    // Preserve each mounted spelling. `/lib` and `/usr/lib` may resolve to the same host\n    // directory but remain distinct paths in the sandbox namespace, so both need masks.\n    const mountedDirectory = path.resolve(directory);\n    if (visited.has(mountedDirectory)) return;\n    visited.add(mountedDirectory);\n    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n      const item = path.join(directory, entry.name);\n      if (entry.isDirectory()) {\n        visit(item);\n        continue;\n      }\n      if (!entry.isSymbolicLink() && !UNPINNED_ORACLE_COMPILER_NAME.test(entry.name)) continue;\n      let stat;\n      let target;\n      try {\n        stat = fs.statSync(item);\n        target = fs.realpathSync(item);\n      } catch (error) {\n        if (error?.code === \"ENOENT\") continue;\n        throw error;\n      }\n      // A symlinked directory's target is visible only when that target is itself in a sandbox mount.\n      // Every mount root is scanned independently; following an unmounted host target can fail (for example,\n      // /usr/lib/ssl/private -> /etc/ssl/private, where /etc is intentionally not mounted) and block safe runs.\n      if (stat.isDirectory()) continue;\n      if (!stat.isFile()\n        || (stat.mode & 0o111) === 0\n        || (!UNPINNED_ORACLE_COMPILER_NAME.test(entry.name) && !UNPINNED_ORACLE_COMPILER_NAME.test(path.basename(target)))\n        || isInsideAnyRoot(target, approvedRoots)) continue;\n      // Names such as `go-225` also occur in executable-mode terminfo records. Exclude only\n      // positively identified compiled terminfo data; mask every other executable candidate,\n      // including no-shebang scripts and formats supported by registered Linux binfmt handlers.\n      const descriptor = fs.openSync(target, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0));\n      let header;\n      try {\n        header = Buffer.alloc(2);\n        fs.readSync(descriptor, header, 0, header.length, 0);\n      } finally {\n        fs.closeSync(descriptor);\n      }\n      const terminfoMagic = header.equals(Buffer.from([0x1a, 0x01])) || header.equals(Buffer.from([0x1e, 0x02]));\n      if (terminfoMagic && /(?:^|\\/)terminfo\\//.test(item)) continue;\n      exposed.add(item);\n    }\n  };\n\n  try {\n    for (const root of roots) {\n      let stat;\n      try { stat = fs.statSync(root); }\n      catch (error) {\n        if (error?.code === \"ENOENT\") continue;\n        throw error;\n      }\n      if (stat.isDirectory()) visit(root);\n    }\n  } catch {\n    return { paths: [], problem: \"oracle compiler exposure could not be checked; refusing qualification\" };\n  }\n\n  const result = { paths: [...exposed].sort(), problem: null };\n  oracleCompilerExposurePreflights.set(cacheKey, result);\n  return result;\n}\n\nfunction compilerExposureMaskArgs(scan) {\n  if (scan.problem) throw new Error(scan.problem);\n  const targets = [...new Set(scan.paths.map((item) => fs.realpathSync(item)))];\ntest-matrix (