"name\\\":\\\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/maintain-space\\\",\\\"title\\\":\\\"Maintain page content\\\",\\\"description\\\":\\\"Reconcile new evidence into existing ChatGPT Pages or a Space when the user requests upkeep. For a direct text correction, use write-page. Do not use for ordinary chat drafts, writing, or advice, or treat a selected Page as a request to save. Schedule future upkeep only when requested.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c\\\",\\\"plugin_name\\\":\\\"pages\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6ab68a367fcc8191ad5a130fa1d93a6c\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_104170f7511c8191b7df56f8802ea4d5\\\",\\\"skill_name\\\":\\\"maintain-space\\\",\\\"contents\\\":[],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/manage-schedules\\\",\\\"name\\\":\\\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/manage-schedules\\\",\\\"title\\\":\\\"Manage schedules for this page\\\",\\\"description\\\":\\\"Review a ChatGPT Space page and its schedules, recommend useful recurring work, and create, update, or remove scheduled automations.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c\\\",\\\"plugin_name\\\":\\\"pages\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6ab68a367fcc8191ad5a130fa1d93a6c\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_4dba0cd90350819192783a844d8c1a87\\\",\\\"skill_name\\\":\\\"manage-schedules\\\",\\\"contents\\\":[],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/organize-space\\\",\\\"name\\\":\\\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/organize-space\\\",\\\"title\\\":\\\"Organize pages\\\",\\\"description\\\":\\\"Organize existing ChatGPT Pages and Space structure when the user requests changes to that structure. Do not use for ordinary chat drafts or advice; a selected Page alone does not authorize reorganization. A narrow text edit does not need this workflow.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c\\\",\\\"plugin_name\\\":\\\"pages\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6ab68a367fcc8191ad5a130fa1d93a6c\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_a360f8e994508191b71da65db46f23ad\\\",\\\"skill_name\\\":\\\"organize-space\\\",\\\"contents\\\":[],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/write-page\\\",\\\"name\\\":\\\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/write-page\\\",\\\"title\\\":\\\"Write and edit a page\\\",\\\"description\\\":\\\"Create or edit requested Page/Space content, or use for prose you have already decided to save as a standalone Markdown file, only if the user did not explicitly request a Markdown file. Honor established formats, destinations, and repository documentation. A selected Page alone does not authorize a write.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c\\\",\\\"plugin_name\\\":\\\"pages\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6ab68a367fcc8191ad5a130fa1d93a6c\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_2247832b32088191a6f73b5984466667\\\",\\\"skill_name\\\":\\\"write-page\\\",\\\"contents\\\":[\\\"references\\\"],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/create-pet\\\",\\\"name\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/create-pet\\\",\\\"title\\\":\\\"Create pet\\\",\\\"description\\\":\\\"Create, repair, validate, preview, upload, or activate an animated v2 pet in ChatGPT Work mode from a character idea, brand cue, or reference image. Use for new ChatGPT Pets, custom mascots, non-pixel styles, and unattached sprite sheets requiring nine animation states plus sixteen look directions. Preserve Library artifacts and Pets MCP lifecycle behavior. Exclude real pets, standalone images, and other-app pets; clarify before invoking.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\\\",\\\"plugin_name\\\":\\\"work-pets\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a605738d6308191b431b6477919eafb\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a60573a53888191b6f2c38c1a8ad4ca\\\",\\\"skill_name\\\":\\\"create-pet\\\",\\\"contents\\\":[\\\"references\\\",\\\"scripts\\\"],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/pets\\\",\\\"name\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/pets\\\",\\\"title\\\":\\\"Pets\\\",\\\"description\\\":\\\"List, inspect, select, download, or delete animated pets in ChatGPT Work mode. Use for an explicit pet in ChatGPT or established ChatGPT Pets context. Exclude real-world and other-app pets; clarify before invoking.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\\\",\\\"plugin_name\\\":\\\"work-pets\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a605738d6308191b431b6477919eafb\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a60573ba8bc819186e79bd4858c707b\\\",\\\"skill_name\\\":\\\"pets\\\",\\\"contents\\\":[],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/update-pet\\\",\\\"name\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/update-pet\\\",\\\"title\\\":\\\"Update pet\\\",\\\"description\\\":\\\"Inspect, validate, preview, repair, or update a custom pet in ChatGPT Work mode, including its name, description, or sprite sheet. Use for a pet in ChatGPT or established ChatGPT Pets context. Exclude real-world and other-app pets; clarify before invoking.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\\\",\\\"plugin_name\\\":\\\"work-pets\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a605738d6308191b431b6477919eafb\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a60573d52608191b967e6759086094c\\\",\\\"skill_name\\\":\\\"update-pet\\\",\\\"contents\\\":[],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\\\",\\\"name\\\":\\\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\\\",\\\"title\\\":\\\"plugin-management\\\",\\\"description\\\":\\\"Discover and suggest relevant plugins, inspect app permissions and dependencies, and manage plugin connections or removal. Use when the user asks about plugins or when a task would materially benefit from an external app, account, service, or data source that available tools cannot access.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\\\",\\\"plugin_name\\\":\\\"plugin-management\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a7e9f7d0ef08191b97b213bb9e118ef\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a7e9f7d68608191bca9945146cbe6f1\\\",\\\"skill_name\\\":\\\"plugin-management\\\",\\\"contents\\\":[],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites\\\",\\\"name\\\":\\\"plugin_connector_1p_689987207de08191979cf68eca2941c6/sites\\\",\\\"title\\\":\\