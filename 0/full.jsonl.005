d\n?? docs/v1.0.0/LANGSMITH_REVIEW.md\n?? docs/v1.0.0/README.md\n?? docs/v1.0.0/ROADMAP.md\n?? docs/v1.0.0/SHA256SUMS\n?? docs/v1.0.0/evidence/\n?? docs/v1.0.0/plans/\n?? docs/v1.0.0/specs/\n?? jsf/\n?? nexus-continuity-validation/\n?? nexus-session-session_20261014_091558_9m78.json\n?? nexus-session-session_20261023_134635_z1dnlfek.json\n?? nexus-session-session_20261026_162439_34f2cnrn.json\n?? package-lock.json\n/home/mike/nexus-code\n31303130761ea23027800c993c7e17291e2a2d3f\norigin\thttps://github.com/mikeholownych/nexus-code.git (fetch)\norigin\tgit@github.com:mikeholownych/nexus-code.git (push)\ndiff --git a/AGENTS.md b/AGENTS.md\nindex dde005e3..510eb4aa 100644\n--- a/AGENTS.md\n+++ b/AGENTS.md\n@@ -9,3 +9,20 @@\n - Maintain documentation integrity and keep existing comments.\n - Always run tests after making changes to verify correctness.\n - Keep functions modular and clearly typed.\n+\n+## v1.0.0 work and concurrent agents\n+- The v1.0.0 plan is in `docs/v1.0.0/` (start at `docs/v1.0.0/README.md`). Implement one claimed PR slice at a time, within the safe change boundary in its plan.\n+- When more than one agent may be working, follow `docs/v1.0.0/CONCURRENCY.md`. In short:\n+  - Claim the slice atomically under `$(git rev-parse --git-common-dir)/nexus-claims/`.\n+  - Use one worktree and branch per slice; never edit `~/nexus-code` directly.\n+  - Isolate `HOME` for every test or probe run.\n+  - Claim hot files before editing them.\n+  - Take the `GATEWAY` claim for any inference run.\n+  - Never use `pkill -f`.\n+  - Check `git log` for foreign commits before every commit.\n+  - Leave push, tag and publish to the owner.\n+\n+<!-- entire-agent:begin -->\n+Read .entire/agent-guide.md for this repository's workflow, source inspection, and verification guidance.\n+@.entire/agent-guide.md\n+<!-- entire-agent:end -->\nAGENTS.md:25:<!-- entire-agent:begin -->\nAGENTS.md:26:Read .entire/agent-guide.md for this repository's workflow, source inspection, and verification guidance.\nAGENTS.md:27:@.entire/agent-guide.md\nAGENTS.md:28:<!-- entire-agent:end -->\n.entire/agent-guide.md:6:    entire brain brief \"<task>\" --json\n.entire/agent-guide.md:15:    entire brain recall \"<question>\" --json\n.entire/agent-guide.md:26:    entire brain remember \"<memory>\" --path <category.subcategory.type> --json\n.entire/agent-guide.md:59:  entire brain query \"<query>\" --json       # hybrid (lexical+vector, RRF) — the default\n.entire/agent-guide.md:60:  entire brain query --keyword \"<query>\" --json      # lexical keyword over memories + history + docs (BM25 for history/docs)\n.entire/agent-guide.md:61:  entire brain query --semantic \"<query>\" --json     # vector/semantic over memories + docs (+ history/conversation with a Gemma-class embedder)\n.entire/agent-guide.md:62:  entire brain get <id> --json              # fetch one item by id (fact:… | history:… | doc:…)\n.entire/agent-guide.md:63:  entire brain multi-get <id>... --json     # fetch several by id\n.entire/agent-guide.md:66:  entire brain status [repo] --json         # sources, memories+verification, semantic coverage/freshness/blind spots, live state\n.entire/agent-guide.md:67:  entire brain status --fail-on release     # CI gate: nonzero when freshness is not ok or blind spots exist (also: unsafe, degraded, blind-spots)\n.entire/agent-guide.md:68:  entire brain overview [repo] --json\n.entire/agent-guide.md:69:  entire brain brief \"<task>\" --json\n.entire/agent-guide.md:70:  entire brain show <id> --json\n.entire/agent-guide.md:71:  entire brain agent-guide\n.entire/agent-guide.md:72:  entire brain path [repo]\n.entire/agent-guide.md:75:  entire brain distill --dry-run --json\n.entire/agent-guide.md:76:  entire brain recall \"<query>\" [--scope local|cross-cutting] [--expand] --json\n.entire/agent-guide.md:77:  entire brain remember \"<memory>\" [--path category.sub.type] --json\n.entire/agent-guide.md:78:  entire brain verify [<memory-id | query>] --json\n.entire/agent-guide.md:79:  entire brain memories tree [--path <prefix>] [--depth N]\n.entire/agent-guide.md:80:  entire brain memories retract <memory-id> --json\n.entire/agent-guide.md:81:  entire brain inspect blame <memory-id> --json # source anchors a memory was derived from\n.entire/agent-guide.md:84:  entire brain inspect code \"<query>\" --json        # find a symbol in the graph\n.entire/agent-guide.md:85:  entire brain inspect search-graph \"<query>\" --json\n.entire/agent-guide.md:86:  entire brain inspect query-graph \"type:CALLS <query>\" --json\n.entire/agent-guide.md:87:  entire brain inspect graph-ui semantic-graph.html\n.entire/agent-guide.md:88:  entire brain inspect snippet <symbol-or-id> --json\n.entire/agent-guide.md:89:  entire brain inspect trace-path <from-symbol> <to-symbol> --json\n.entire/agent-guide.md:90:  entire brain inspect dead-code --json\n.entire/agent-guide.md:91:  entire brain inspect ingest-traces <json-or-ndjson-file> --json\n.entire/agent-guide.md:92:  entire brain inspect context <symbol-or-id> --json\n.entire/agent-guide.md:93:  entire brain inspect impact <symbol-or-file> --json\n.entire/agent-guide.md:94:  entire brain inspect changes --json\n.entire/agent-guide.md:95:  entire brain inspect tests \"<query>\" --json\n.entire/agent-guide.md:96:  entire brain inspect boundaries --kind route|tool|workflow --json\n.entire/agent-guide.md:97:  entire brain inspect regressions \"<query>\" --location-only [--include-deletions] --json\n.entire/agent-guide.md:99:<!-- entire-agent-activation: {\"schema_version\":1,\"enabled\":[\"brain\"]} -->\n","exit_code":0,"duration":{"secs":0,"nanos":30581}},"started_at_ms":1793254819753,"completed_at_ms":1793254819753}}
