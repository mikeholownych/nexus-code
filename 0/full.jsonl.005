xposureProblem([fakeSystem], [fakeAlternatives]);\n  assert.match(exposure ?? \"\", /unapproved Go\\/Rust compiler executable/);\n  assert.match(exposure ?? \"\", /rustlib\\/bin\\/rustc/);\n  assert.match(exposure ?? \"\", /alternatives\\/cargo/);\n  if (sandboxAvailable()) {\n    assert.throws(() => isolatedProcessArgv({\n      cwd: fakeSystem,\n      command: \"/usr/bin/true\",\n      readOnlyPaths: [\"/usr/bin/true\"],\n      allowedFiles: [\"/usr/bin/true\"],\n      oracleToolchains: true,\n      systemDirectories: [fakeSystem],\n      systemEtcDirectories: [fakeAlternatives],\n    }), /unapproved Go\\/Rust compiler executable/, \"the execution-path preflight rejects deliberate compiler escape fixtures\");\n24:          go-version: '1.22.12'\n26:        run: bash scripts/install-evaluator-toolchains.sh\n91:          go-version: '1.22.12'\n93:        run: bash scripts/install-evaluator-toolchains.sh\n .github/workflows/ci.yml        |  34 ++-----------\n cli/test/eval_integrity.test.ts |  68 +++++++++++++++++++++++++-\n eval/isolate.mjs                | 104 +++++++++++++++++++++++++++++++++++++---\n 3 files changed, 169 insertions(+), 37 deletions(-)\n M .github/workflows/ci.yml\n M cli/test/eval_integrity.test.ts\n M eval/isolate.mjs\n?? eval/toolchain-versions.json\n?? scripts/install-evaluator-toolchains.sh\n","exit_code":0,"duration":{"secs":1,"nanos":65156415}},"started_at_ms":1793257223268,"completed_at_ms":1793257224333}}
