e task has unapproved Go\\/Rust\");\n   233\t}\n   234\t\n   235\tfunction executableVersion(command, argv) {\n   236\t  const result = spawnSync(command, argv, {\n   237\t    encoding: \"utf8\",\n   238\t    timeout: 5000,\n   239\t    env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n   240\t  });\n   241\t  return !result.error && result.status === 0 ? result.stdout.trim() : null;\n   242\t}\n   243\t\n   244\texport function oracleToolchainsProblem({ systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS, additionalMountedPaths = [] } = {}) {\n   245\t  const exposureScan = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths);\n   246\t  if (exposureScan.problem) return exposureScan.problem;\n   247\t  return pinnedOracleToolchainsProblem();\n   248\t}\n   249\t\n   250\tfunction pinnedOracleToolchainsProblem() {\n   251\t  for (const { root, required } of PINNED_ORACLE_TOOLCHAINS) {\n   252\t    const problem = pinnedToolchainProblem(root, required);\n   253\t    if (problem) return problem;\n   254\t  }\n   255\t  return oracleToolchainVersionProblem({\n   256\t    goVersion: executableVersion(\"/usr/local/go/bin/go\", [\"version\"]),\n   257\t    rustcVersion: executableVersion(\"/usr/local/nexus-qual/rust/bin/rustc\", [\"--version\"]),\n   258\t    cargoVersion: executableVersion(\"/usr/local/nexus-qual/rust/bin/cargo\", [\"--version\"]),\n   259\t  });\n   260\t}\n   261\t\n   262\tfunction pinnedToolchainProblem(root, required) {\n   263\t  const ancestors = [];\n   264\t  let parent = path.dirname(root);\n   265\t  while (parent !== path.dirname(parent)) {\n    35\t  }\n    36\t  try {\n    37\t    const stat = fs.statSync(casesPath);\n    38\t    if (!stat.isFile() || stat.size > MAX_ORACLE_BYTES) return \"hidden black-box oracle case file is not a bounded regular file\";\n    39\t    const rows = JSON.parse(fs.readFileSync(casesPath, \"utf8\"));\n    40\t    if (!Array.isA