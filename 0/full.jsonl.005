636\t  assert.match(hiddenTestIsolationProblem({ runAs: \"bad user;\" }, tasks), /not a valid user name/);\n   637\t  const wrapped = asUser(\"nexus-eval\", \"/usr/bin/bwrap\", [\"--unshare-all\", \"--\", \"/runner/node\"]);\n   638\t  // Exactly the form the provisioned sudoers rule permits: no env wrapper that would need an any-command rule.\n   639\t  assert.equal(wrapped.cmd, \"/usr/bin/sudo\");\n   640\t  assert.deepEqual(wrapped.argv, [\"-n\", \"-u\", \"nexus-eval\", \"--\", \"/usr/bin/bwrap\", \"--unshare-all\", \"--\", \"/runner/node\"]);\n   641\t  assert.throws(() => asUser(\"nexus-eval\", \"bwrap\", []), /absolute/);\n   642\t  const sudoers = fs.readFileSync(path.join(ROOT, \"eval/host/provision.sh\"), \"utf8\");\n   643\t  assert.match(sudoers, /ALL=\\(%s\\) !ALL\\\\n%s ALL=\\(%s\\) NOPASSWD: REDACTED, \"the explicit deny-all precedes the exact bwrap grant\");\n   644\t});\n   645\t\n   646\ttest(\"candidate agents receive only the approved read-only Go and Rust toolchain mounts\", async () => {\n   647\t  const { candidateAgentPath, candidateToolchainMountArgs } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   648\t  const toolchains = { goRoot: \"/host/toolchains/go\", rustRoot: \"/host/toolchains/rust\" };\n   649\t  assert.equal(\n   650\t    candidateAgentPath(\"/custom/bin:/usr/bin:/bin\", toolchains),\n   651\t    \"/usr/local/nexus-qual/rust/bin:/usr/local/go/bin:/custom/bin:/usr/bin:/bin\",\n   652\t  );\n   653\t  assert.deepEqual(candidateToolchainMountArgs(toolchains), [\n   654\t    \"--dir\", \"/usr/local\", \"--ro-bind\", toolchains.goRoot, \"/usr/local/go\",\n   655\t    \"--dir\", \"/usr/local/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/usr/local/nexus-qual/rust\",\n   656\t  ]);\n   657\t  assert.deepEqual(candidateToolchainMountArgs({ goRoot: null, rustRoot: toolchains.rustRoot }), [\n   658\t    \"--dir\", \"/usr/local\", \"--dir\", \"/usr/local/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/usr/local/nexus-qual/rust\",\n   659\t  ]);\n   660\t  assert.deepEqual(candidateToolchainMountArgs({ goRoot: null, rustRoot: null }), []);\n   661\t  assert.deepEqual(candidateToolchainMountArgs({ goRoot: toolchains.goRoot, rustRoot: null }, [\"/usr/local/lib\"]), [\n   662\t    \"--ro-bind\", toolchains.goRoot, \"/usr/local/go\",\n   663\t  ]);\n   664\t});\n   665\t\n   666\ttest(\"qualification runtime mounts cannot overlap the task tree, held-out store, or private validator paths\", async () => {\n   667\t  const { hiddenTestIsolationProblem, runtimeCorpusOverlapProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   668\t  const { agentSandboxArgv, candidateSandboxHostMountSources, isolatedArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   669\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-corpus-overlap-\"));\n   670\t  try {\n   671\t    const store = path.join(root, \"heldout-v2\");\n   672\t    const tasks = path.join(store, \"tasks\");\n   673\t    const references = path.join(store, \"reference\");\n   674\t    const runtimeRoot = path.join(root, \"runtime\");\n   675\t    const home = path.join(root, \"home\");\n   676\t    const proxyDirectory = path.join(root, \"proxy\");\n   677\t    const readOnlyRuntime = path.join(runtimeRoot, \"runtime.bin\");\n   678\t    const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n   679\t    const privateValidator = path.join(root, \"private-validator\");\n   680\t    fs.mkdirSync(tasks, { recursive: true });\n   681\t    fs.mkdirSync(references);\n   682\t    fs.mkdirSync(runtimeRoot);\n   683\t    fs.mkdirSync(home);\n   684\t    fs.mkdirSync(proxyDirectory);\n   685\t    fs.mkdirSync(privateValidator);\n   686\t    fs.writeFileSync(readOnlyRuntime, \"runtime\\n\");\n   687\t    fs.writeFileSync(path.join(tasks, \"task.json\"), \"{}\\n\");\n   688\t    fs.writeFileSync(path.join(references, \"solution.patch\"), \"REFERENCE_SOLUTION_CANARY\\n\");\n   689\t    fs.writeFileSync(path.join(privateValidator, \"validate.mjs\"), \"PRIVATE_VALIDATOR_CANARY\\n\");\n   690\t    const alias = path.join(root, \"store-alias\");\n   691\t    fs.symlinkSync(store, alias, \"dir\");\n   692\t\n   693\t    const mountContext = { cwd: runtimeRoot, home, proxyDirectory, nodeRuntime: process.execPath, supervisorPath };\n   694\t    const hostMounts = candidateSandboxHostMountSources({ ...mountContext, readOnlyPaths: [readOnlyRuntime] });\n   695\t    const expectedToolchains = [\"/usr/local/go\", \"/usr/local/nexus-qual/rust\"]\n   696\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   697\t    const existingDirectories = [\"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/lib\", \"/lib64\", \"/usr/local/lib\"]\n   698\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   699\t    const existingEtcFiles = [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]\n   700\t      .filter((item) => { try { return fs.statSync(item).isFile(); } catch { return false; } });\n   701\t    const existingEtcDirectories = [\"/etc/alternatives\"]\n   702\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   703\t    assert.deepEqual(hostMounts.systemDirectories, existingDirectories);\n   704\t    assert.deepEqual(hostMounts.systemFiles, existingEtcFiles);\n   705\t    assert.deepEqual(hostMounts.systemEtcDirectories, existingEtcDirectories);\n   706\t    assert.deepEqual(hostMounts.toolchainDirectories, expectedToolchains);\n   707\t    assert.deepEqual(hostMounts.runtimeSources, {\n   708\t      cwd: fs.realpathSync(runtimeRoot),\n   709\t      home: fs.realpathSync(home),\n   710\t      proxyDirectory,\n   711\t      nodeRuntime: fs.realpathSync(process.execPath),\n   712\t      supervisorPath: fs.realpathSync(supervisorPath),\n   713\t      readOnlyPaths: [fs.realpathSync(readOnlyRuntime)],\n   714\t    });\n   715\t\n   716\t    assert.equal(runtimeCorpusOverlapProblem([runtimeRoot], [runtimeRoot], tasks), null, \"an unrelated pinned runtime remains usable\");\n   717\t    assert.match(runtimeCorpusOverlapProblem([path.join(references, \"solution.patch\")], [store], tasks) ?? \"\", /overlaps protected corpus material/);\n   718\t    assert.match(runtimeCorpusOverlapProblem([runtimeRoot], [store], tasks) ?? \"\", /overlaps protected corpus material/, \"a broad allowlist root cannot contain the corpus store\");\n   719\t    assert.match(runtimeCorpusOverlapProblem([path.join(alias, \"reference\", \"solution.patch\")], [alias], tasks) ?? \"\", /overlaps protected corpus material/, \"symlink aliases are resolved before comparing paths\");\n   720\t    assert.match(runtimeCorpusOverlapProblem([privateValidator], [privateValidator], tasks, [privateValidator]) ?? \"\", /overlaps protected corpus material/);\n   721\t    assert.match(runtimeCorpusOverlapProblem([runtimeRoot], [runtimeRoot], tasks, [path.join(root, \"missing-validator\")]) ?? \"\", /private corpus path is unavailable/);\n   722\t    assert.equal(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\")), null, \"default in-repo development eval/tasks does not collide with eval/agent_sandbox.mjs\");\n   723\t    assert.equal(runtimeCorpusOverlapProblem([path.join(ROOT, \"cli/dist\")], [path.join(ROOT, \"cli\"), path.join(ROOT, \"core\")], path.join(ROOT, \"eval/tasks\")), null, \"default development Nexus runtime roots do not overlap eval/tasks\");\n   724\t    assert.match(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\"), [], { qualification: true }) ?? \"\", /overlaps protected corpus material/, \"qualification mode still rejects using in-repo eval/tasks because its parent overlaps eval/agent_sandbox.mjs\");\n   725\t\n   726\t    const unconditionalMountPaths = [\n   727\t      ...hostMounts.systemDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   728\t      ...hostMounts.systemFiles,\n   729\t      ...hostMounts.systemEtcDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   730\t      ...hostMounts.toolchainDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   731\t    ];\n   732\t    const runtimeMountPaths = [\n   733\t      path.join(runtimeRoot, \"corpus-leak\"),\n   734\t      path.join(home, \"corpus-leak\"),\n   735\t      path.join(proxyDirectory, \"corpus-leak\"),\n   736\t      process.execPath,\n   737\t      supervisorPath,\n   738\t      readOnlyRuntime,\n   739\t    ];\n   740\t    for (const protectedPath of [...unconditionalMountPaths, ...runtimeMountPaths]) {\n   741\t      assert.match(\n   742\t        runtimeCorpusOverlapProblem([], [], tasks, [protectedPath], mountContext) ?? \"\",\n   743\t        /overlaps protected corpus material/,\n   744\t        `runtime preflight rejects mounted corpus path ${protectedPath}`,\n   745\t      );\n   746\t      assert.match(\n   747\t        hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: protectedPath }, mountContext }, tasks) ?? \"\",\n   748\t        /overlaps protected corpus material/,\n   749\t        `hidden-test qualification preflight rejects mounted corpus path ${protectedPath}`,\n   750\t      );\n   751\t      assert.throws(() => agentSandboxArgv({\n   752\t        cwd: runtimeRoot,\n   753\t        home,\n   754\t        proxyDirectory,\n   755\t        readOnlyPaths: [readOnlyRuntime],\n   756\t        supervisorPath,\n   757\t        protectedCorpusPaths: [protectedPath],\n   758\t      }), /overlaps protected corpus material/);\n   759\t      if (unconditionalMountPaths.includes(protectedPath)) {\n   760\t        // This check precedes Bubblewrap availability, including on minimal CI hosts.\n   761\t        assert.throws(() => isolatedArgv({ cwd: runtimeRoot, command: \"true\", protectedCorpusPaths: [protectedPath] }), /overlaps protected corpus material/);\n   762\t      }\n   763\t    }\n   764\t    assert.match(\n   765\t      runtimeCorpusOverlapProblem([], [\"/usr/bin\"], tasks, [path.join(\"/usr/bin\", \"synthetic-corpus-subdir\")]) ?? \"\",\n   766\t      /overlaps protected corpus material/,\n   767\t      \"a runtime allowlist root below an unconditional system mount is rejected\",\n   768\t    );\n   769\t    assert.match(\n   770\t      runtimeCorpusOverlapProblem([readOnlyRuntime], [], tasks, [readOnlyRuntime], mountContext) ?? \"\",\n   771\t      /overlaps protected corpus material/,\n   772\t      \"an explicit read-only runtime source is checked against the corpus\",\n   773\t    );\n   774\t    assert.match(\n   775\t      hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [readOnlyRuntime], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: readOnlyRuntime }, mountContext }, tasks) ?? \"\",\n   776\t      /overlaps protected corpus material/,\n   777\t      \"hidden-test preflight checks explicit read-only runtime sources\",\n   778\t    );\n   779\t    const custodyReportPath = readOnlyRuntime;\n   780\t    assert.match(hiddenTestIsolationProblem({\n   781\t      qualification: true,\n   782\t      runAs: \"nexus-eval\",\n   783\t      sandboxRuntimePaths: [readOnlyRuntime],\n   784\t      sandboxRuntimeRoots: [runtimeRoot],\n   785\t      corpusCustody: { reportPath: custodyReportPath },\n   786\t      mountContext,\n   787\t    }, tasks) ?? \"\", /overlaps protected corpus material/);\n   788\t    assert.throws(() => agentSandboxArgv({\n   789\t      cwd: runtimeRoot,\n   790\t      home,\n   791\t      proxyDirectory,\n   792\t      readOnlyPaths: [readOnlyRuntime],\n   793\t      supervisorPath,\n   794\t      protectedCorpusPaths: [custodyReportPath],\n   795\t    }), /overlaps protected corpus material/);\n   796\t  } finally {\n   797\t    fs.rmSync(root, { recursive: true, force: true });\n   798\t  }\n   799\t});\n   800\t\n   801\ttest(\"qualification remains fail-closed without enforced aggregate resource controls\", async () => {\n   802\t  const { qualificationResourceIsolationProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   803\t  const { dedicatedTmpfsMountProblem } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n   804\t  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\n   805\t  const tmpfs = fs.statfsSync(workspaceRoot);\n   806\t  const ok = { cpuPercent: 100, memoryBytes: 256 * 1024 * 1024, tasks: 64, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\n   807\t  const shared = fs.statfsSync(\"/dev/shm\");\n   808\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: \"/dev/shm\", storageBytes: shared.blocks * shared.bsize } }) ?? \"\", /dedicated tmpfs|exact mount point/);\n   809\t  assert.match(qualificationResourceIsolationProblem(), /enforced CPU, memory, process-count, and workspace-storage limits/);\n   810\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: ROOT } }) ?? \"\", /tmpfs/);\n  1338\t  assert.equal(descendant.timedOut, true);\n  1339\t  await new Promise((resolve) => setTimeout(resolve, 2200));\n  1340\t  assert.equal(fs.existsSync(descendantMarker), false, \"a descendant survived evaluator timeout and wrote to the workspace\");\n  1341\t  networkServer.close();\n  1342\t  delete process.env.EVAL_SYNTHETIC_SECRET;\n  1343\t});\n  1344\t\n  1345\ttest(\"candidate namespace reaches only its authenticated run proxy and cannot read host files\", async () => {\n  1346\t  const { agentSandboxArgv, candidateAgentPath } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  1347\t  const { startModelProxy } = await import(proxyModule);\n  1348\t  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-agent-ws-\"));\n  1349\t  const home = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-agent-home-\"));\n  1350\t  const proxyDirectory = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-agent-proxy-\"));\n  1351\t  const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-agent-outside-\"));\n  1352\t  const canary = path.join(outside, \"canary.txt\");\n  1353\t  fs.writeFileSync(canary, \"HOST_PRIVATE_CANARY\");\n  1354\t  const seen: string[] = [];\n  1355\t  const upstream = http.createServer((req, res) => {\n  1356\t    seen.push(String(req.headers.authorization ?? \"\"));\n  1357\t    res.end(JSON.stringify({ data: [{ id: \"synthetic-model\" }] }));\n  1358\t  });\n  1359\t  let proxy: Awaited<ReturnType<typeof startModelProxy>> | undefined;\n  1360\t  try {\n  1361\t    await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  1362\t    proxy = await startModelProxy({ upstream: `http://127.0.0.1:${(upstream.address() as any).port}/v1`, authToken: \"UPSTREAM_AUTH_CANARY\", clientToken: \"RUN_LOCAL_TOKEN\", socketPath: path.join(proxyDirectory, \"proxy.sock\") });\n  1363\t    const nodeRuntime = process.execPath;\n  1364\t    const sandbox = agentSandboxArgv({ cwd: workspace, home, proxyDirectory, readOnlyPaths: [nodeRuntime], runtimeExecutablePaths: [nodeRuntime], supervisorPath: path.join(ROOT, \"eval/agent_sandbox.mjs\") });\n  1365\t    const script = `const fs=require('fs'),cp=require('child_process');fetch('http://127.0.0.1:40127/v1/models',{headers:{authorization:'Bearer '+process.env.OPENAI_API_KEY},signal:AbortSignal.timeout(2000)}).then(async r=>{let value='';try{value=fs.readFileSync(${JSON.stringify(canary)},'utf8')}catch{};try{fs.writeFileSync('/tmp/host-write-canary','changed')}catch{};const nested=cp.spawnSync('/usr/bin/unshare',['-Ur','true']);const toolchains={};for(const [name,args] of [['go',['version']],['rustc',['--version']],['cargo',['--version']]]){if(process.env.PATH.includes(name==='go'?'/usr/local/go/bin':'/usr/local/nexus-qual/rust/bin')){const check=cp.spawnSync(name,args,{encoding:'utf8'});toolchains[name]={status:check.status,stdout:check.stdout,stderr:check.stderr}}};console.log(JSON.stringify({status:r.status,token:process.env.OPENAI_API_KEY,upstreamVisible:process.env.UPSTREAM_AUTH_CANARY??null,canary:value,nestedUserns:nested.status,toolchains}))}).catch(e=>{console.error(e.message);process.exit(1)})`;\n  1366\t    process.env.UPSTREAM_AUTH_CANARY = \"UPSTREAM_AUTH_CANARY\";\n  1367\t    const candidatePath = candidateAgentPath(\"/usr/bin:/bin\");\n  1368\t    const child = await runSandbox(sandbox.cmd, sandbox.argv, JSON.stringify({ command: nodeRuntime, argv: [\"-e\", script], env: { PATH: candidatePath, OPENAI_API_KEY: \"RUN_LOCAL_TOKEN\" } }));\n  1369\t    assert.equal(child.status, 0, `${child.error ?? \"\"}\\n${child.stderr}\\n${child.stdout}\\nproxy=${JSON.stringify(proxy.stats())}\\nupstream=${JSON.stringify(seen)}`);\n  1370\t    const output = JSON.parse(child.stdout.trim());\n  1371\t    assert.equal(output.status, 200);\n  1372\t    assert.equal(output.token, \"RUN_LOCAL_TOKEN\");\n  1373\t    assert.equal(output.upstreamVisible, null);\n  1374\t    assert.equal(output.canary, \"\");\n  1375\t    assert.notEqual(output.nestedUserns, 0, \"candidate code could create a nested user namespace\");\n  1376\t    if (candidatePath.includes(\"/usr/local/go/bin\")) assert.equal(output.toolchains.go?.status, 0, `Go toolchain is not executable in candidate namespace: ${JSON.stringify(output.toolchains.go)}`);\n  1377\t    if (candidatePath.includes(\"/usr/local/nexus-qual/rust/bin\")) {\n  1378\t      assert.equal(output.toolchains.rustc?.status, 0, `Rust compiler is not executable in candidate namespace: ${JSON.stringify(output.toolchains.rustc)}`);\n  1379\t      assert.equal(output.toolchains.cargo?.status, 0, `Cargo is not executable in candidate namespace: ${JSON.stringify(output.toolchains.cargo)}`);\n  1380\t    }\n  1381\t    assert.deepEqual(seen, [\"Bearer UPSTREAM_AUTH_CANARY\"]);\n  1382\t    assert.equal(fs.existsSync(\"/tmp/host-write-canary\"), false);\n  1383\t    assert.doesNotMatch(`${child.stdout}${child.stderr}`, /HOST_PRIVATE_CANARY|UPSTREAM_AUTH_CANARY/);\n  1384\t  } finally {\n  1385\t    delete process.env.UPSTREAM_AUTH_CANARY;\n  1386\t    if (proxy) await proxy.close();\n  1387\t    if (upstream.listening) await new Promise<void>((resolve) => upstream.close(() => resolve()));\n  1388\t  }\n  1389\t});\n  1390\t\n     1\t// Runs one evaluation candidate behind a namespace-local TCP endpoint and a host-side Unix-socket proxy.\n     2\t// The candidate sees only the run-scoped local token; the upstream gateway credential stays in run.mjs.\n     3\timport http from \"node:http\";\n     4\timport { spawn } from \"node:child_process\";\n     5\timport { StringDecoder } from \"node:string_decoder\";\n     6\t\n     7\t// The launch payload is the first stdin line. With payload.protocol the rest of stdin is the agent's stdin (the T3\n     8\t// sidecar protocol); otherwise the agent gets no stdin.\n     9\tconst payload = JSON.parse(await readPayloadLine());\n    10\tconst port = 40127; // private to this network namespace; no host listener uses this port\n    11\tconst server = http.createServer((req, res) => {\n    12\t  const upstream = http.request({ socketPath: \"/run/eval-proxy/proxy.sock\", agent: new http.Agent({ keepAlive: false }), method: req.method, path: req.url, headers: { ...req.headers, host: \"eval-proxy\", connection: \"close\" } }, (response) => {\n    13\t    res.writeHead(response.statusCode ?? 502, response.headers);\n    14\t    response.pipe(res);\n    15\t    response.once(\"end\", () => upstream.destroy());\n    16\t  });\n    17\t  upstream.on(\"error\", (error) => {\n    18\t    if (!res.headersSent) res.writeHead(502, { \"content-type\": \"application/json\" });\n    19\t    res.end(JSON.stringify({ error: { type: \"proxy_unavailable\", message: \"evaluation proxy unavailable\" } }));\n    20\t  });\n    21\t  req.pipe(upstream);\n    22\t});\n    23\tawait new Promise((resolve, reject) => {\n    24\t  server.once(\"error\", reject);\n    25\t  server.listen(port, \"127.0.0.1\", resolve);\n    26\t});\n    27\t\n    28\tconst endpoint = `http://127.0.0.1:${port}/v1`;\n    29\tconst env = { ...payload.env };\n    30\tfor (const [key, value] of Object.entries(env)) {\n    31\t  if (typeof value === \"string\") env[key] = value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint);\n    32\t}\n    33\tconst argv = payload.argv.map((value) => value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint));\n    34\tconst agent = spawn(payload.command, argv, { cwd: \"/workspace\", env, stdio: [payload.protocol ? \"pipe\" : \"ignore\", \"inherit\", \"inherit\"] });\n    35\tif (payload.protocol) {\n    36\t  agent.stdin.on(\"error\", () => {});\n    37\t  process.stdin.pipe(agent.stdin);\n    38\t  process.stdin.resume();\n    39\t}\n    40\tlet stopping = false;\n    41\tconst stop = (signal) => {\n    42\t  if (stopping) return;\n    43\t  stopping = true;\n    44\t  try { process.kill(-agent.pid, signal); } catch { agent.kill(signal); }\n    45\t};\n    46\tprocess.on(\"SIGTERM\", () => stop(\"SIGTERM\"));\n    47\tprocess.on(\"SIGINT\", () => stop(\"SIGINT\"));\n    48\tagent.on(\"error\", (error) => {\n    49\t  process.stderr.write(`candidate spawn failed: ${error.message}\\n`);\n    50\t  closeBridge(127);\n    51\t});\n    52\tagent.on(\"close\", (code, signal) => {\n    53\t  closeBridge(code ?? (signal ? 128 : 1));\n    54\t});\n    55\t\n    56\t/** Reads stdin up to the first newline (or its end); anything after the newline is put back for the agent. */\n    57\tfunction readPayloadLine() {\n    58\t  return new Promise((resolve, reject) => {\n    59\t    let body = \"\";\n    60\t    const decoder = new StringDecoder(\"utf8\");\n    61\t    const onData = (chunk) => {\n    62\t      body += decoder.write(chunk);\n    63\t      if (body.length > 1_000_000) { cleanup(); reject(new Error(\"sandbox launch payload too large\")); return; }\n    64\t      const newline = body.indexOf(\"\\n\");\n    65\t      if (newline < 0) return;\n    66\t      cleanup();\n    67\t      process.stdin.pause();\n    68\t      const rest = body.slice(newline + 1);\n    69\t      if (rest) process.stdin.unshift(Buffer.from(rest, \"utf8\"));\n    70\t      resolve(body.slice(0, newline));\n    71\t    };\n    72\t    const onEnd = () => { cleanup(); resolve(body); };\n    73\t    const cleanup = () => { process.stdin.off(\"data\", onData); process.stdin.off(\"end\", onEnd); process.stdin.off(\"error\", reject); };\n    74\t    process.stdin.on(\"data\", onData);\n    75\t    process.stdin.on(\"end\", onEnd);\n    76\t    process.stdin.on(\"error\", reject);\n    77\t  });\n    78\t}\n    79\t\n    80\tfunction closeBridge(exitCode) {\n    81\t  process.exitCode = exitCode;\n    82\t  server.closeAllConnections?.();\n    83\t  server.close();\n    84\t}\n   115\t\n   116\tfunction isInsideAnyRoot(candidate, roots) {\n   117\t  return roots.some((root) => candidate === root || candidate.startsWith(`${root}${path.sep}`));\n   118\t}\n   119\t\n   120\t/** Reject every unpinned Go/Rust compiler reachable through the system mounts used by an oracle. */\n   121\texport function oracleCompilerExposureProblem(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS) {\n   122\t  const roots = [...new Set([...systemDirectories, ...systemEtcDirectories])].sort();\n   123\t  const cacheKey = JSON.stringify(roots);\n   124\t  if (oracleCompilerExposurePreflights.has(cacheKey)) return oracleCompilerExposurePreflights.get(cacheKey);\n   125\t\n   126\t  const exposed = new Set();\n   127\t  const visited = new Set();\n   128\t  const approvedRoots = PINNED_ORACLE_TOOLCHAINS.map(({ root }) => root);\n   129\t  const visit = (directory) => {\n   130\t    const canonicalDirectory = fs.realpathSync(directory);\n   131\t    if (visited.has(canonicalDirectory)) return;\n   132\t    visited.add(canonicalDirectory);\n   133\t    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n   134\t      const item = path.join(directory, entry.name);\n   135\t      if (entry.isDirectory()) {\n   136\t        visit(item);\n   137\t        continue;\n   138\t      }\n   139\t      if (!entry.isSymbolicLink() && !UNPINNED_ORACLE_COMPILER_NAME.test(entry.name)) continue;\n   140\t      let stat;\n   141\t      let target;\n   142\t      try {\n   143\t        stat = fs.statSync(item);\n   144\t        target = fs.realpathSync(item);\n   145\t      } catch (error) {\n   146\t        if (error?.code === \"ENOENT\") continue;\n   147\t        throw error;\n   148\t      }\n   149\t      if (stat.isDirectory()) {\n   150\t        visit(item);\n   151\t        continue;\n   152\t      }\n   153\t      if (!stat.isFile()\n   154\t        || (stat.mode & 0o111) === 0\n   155\t        || (!UNPINNED_ORACLE_COMPILER_NAME.test(entry.name) && !UNPINNED_ORACLE_COMPILER_NAME.test(path.basename(target)))\n   156\t        || isInsideAnyRoot(target, approvedRoots)) continue;\n   157\t      exposed.add(item);\n   158\t    }\n   159\t  };\n   160\t\n   161\t  try {\n   162\t    for (const root of roots) {\n   163\t      let stat;\n   164\t      try { stat = fs.statSync(root); }\n   165\t      catch (error) {\n   166\t        if (error?.code === \"ENOENT\") continue;\n   167\t        throw error;\n   168\t      }\n   169\t      if (stat.isDirectory()) visit(root);\n   170\t    }\n   171\t  } catch {\n   172\t    return \"oracle compiler exposure could not be checked; refusing qualification\";\n","exit_code":0,"duration":{"secs":0,"nanos":75139}},"started_at_ms":1793259142822,"completed_at_ms":1793259142822}}
{"timestamp":"2026-10-29T07:32:24.206Z","ordinal":498411,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18693-040e-7951-a89e-9b300857bfbf","call_id":"call_9a5682446a914a5fa67d868d4ae573d7","output":[{"type":"input_text","text":"Script completed\nWall time 3.3 seconds\nOutput:\n"},{"type":"input_text","text":"   630\t  const { hiddenTestIsolationProblem, asUser } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   631\t  const tasks = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-tasks-\"));\n   632\t  fs.chmodSync(tasks, 0o755);\n   633\t  assert.equal(hiddenTestIsolationProblem({}, tasks), null, \"development runs may run as the operator\");\n   634\t  assert.match(hiddenTestIsolationProblem({ qualification: true }, tasks), /need runAs/);\n   635\t  assert.match(hiddenTestIsolationProblem({ runAs: \"nexus-eval\" }, tasks), /evaluator account|setfacl|sandboxRuntimePaths/);\n   636\t  assert.match(hiddenTestIsolationProblem({ runAs: \"bad user;\" }, tasks), /not a valid user name/);\n   637\t  const wrapped = asUser(\"nexus-eval\", \"/usr/bin/bwrap\", [\"--unshare-all\", \"--\", \"/runner/node\"]);\n   638\t  // Exactly the form the provisioned sudoers rule permits: no env wrapper that would need an any-command rule.\n   639\t  assert.equal(wrapped.cmd, \"/usr/bin/sudo\");\n   640\t  assert.deepEqual(wrapped.argv, [\"-n\", \"-u\", \"nexus-eval\", \"--\", \"/usr/bin/bwrap\", \"--unshare-all\", \"--\", \"/runner/node\"]);\n   641\t  assert.throws(() => asUser(\"nexus-eval\", \"bwrap\", []), /absolute/);\n   642\t  const sudoers = fs.readFileSync(path.join(ROOT, \"eval/host/provision.sh\"), \"utf8\");\n   643\t  assert.match(sudoers, /ALL=\\(%s\\) !ALL\\\\n%s ALL=\\(%s\\) NOPASSWD: REDACTED, \"the explicit deny-all precedes the exact bwrap grant\");\n   644\t});\n   645\t\n   646\ttest(\"candidate agents receive only the approved read-only Go and Rust toolchain mounts\", async () => {\n   647\t  const { candidateAgentPath, candidateToolchainMountArgs } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   648\t  const toolchains = { goRoot: \"/host/toolchains/go\", rustRoot: \"/host/toolchains/rust\" };\n   649\t  assert.equal(\n   650\t    candidateAgentPath(\"/custom/bin:/usr/bin:/bin\", toolchains),\n   651\t    \"/usr/local/nexus-qual/rust/bin:/usr/local/go/bin:/custom/bin:/usr/bin:/bin\",\n   652\t  );\n   653\t  assert.deepEqual(candidateToolchainMountArgs(toolchains), [\n   654\t    \"--dir\", \"/usr/local\", \"--ro-bind\", toolchains.goRoot, \"/usr/local/go\",\n   655\t    \"--dir\", \"/usr/local/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/usr/local/nexus-qual/rust\",\n   656\t  ]);\n   657\t  assert.deepEqual(candidateToolchainMountArgs({ goRoot: null, rustRoot: toolchains.rustRoot }), [\n   658\t    \"--dir\", \"/usr/local\", \"--dir\", \"/usr/local/nexus-qual\", \"--ro-bind\", toolchains.rustRoot, \"/usr/local/nexus-qual/rust\",\n   659\t  ]);\n   660\t  assert.deepEqual(candidateToolchainMountArgs({ goRoot: null, rustRoot: null }), []);\n   661\t  assert.deepEqual(candidateToolchainMountArgs({ goRoot: toolchains.goRoot, rustRoot: null }, [\"/usr/local/lib\"]), [\n   662\t    \"--ro-bind\", toolchains.goRoot, \"/usr/local/go\",\n   663\t  ]);\n   664\t});\n   665\t\n   666\ttest(\"qualification runtime mounts cannot overlap the task tree, held-out store, or private validator paths\", async () => {\n   667\t  const { hiddenTestIsolationProblem, runtimeCorpusOverlapProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   668\t  const { agentSandboxArgv, candidateSandboxHostMountSources, isolatedArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n   669\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-corpus-overlap-\"));\n   670\t  try {\n   671\t    const store = path.join(root, \"heldout-v2\");\n   672\t    const tasks = path.join(store, \"tasks\");\n   673\t    const references = path.join(store, \"reference\");\n   674\t    const runtimeRoot = path.join(root, \"runtime\");\n   675\t    const home = path.join(root, \"home\");\n   676\t    const proxyDirectory = path.join(root, \"proxy\");\n   677\t    const readOnlyRuntime = path.join(runtimeRoot, \"runtime.bin\");\n   678\t    const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n   679\t    const privateValidator = path.join(root, \"private-validator\");\n   680\t    fs.mkdirSync(tasks, { recursive: true });\n   681\t    fs.mkdirSync(references);\n   682\t    fs.mkdirSync(runtimeRoot);\n   683\t    fs.mkdirSync(home);\n   684\t    fs.mkdirSync(proxyDirectory);\n   685\t    fs.mkdirSync(privateValidator);\n   686\t    fs.writeFileSync(readOnlyRuntime, \"runtime\\n\");\n   687\t    fs.writeFileSync(path.join(tasks, \"task.json\"), \"{}\\n\");\n   688\t    fs.writeFileSync(path.join(references, \"solution.patch\"), \"REFERENCE_SOLUTION_CANARY\\n\");\n   689\t    fs.writeFileSync(path.join(privateValidator, \"validate.mjs\"), \"PRIVATE_VALIDATOR_CANARY\\n\");\n   690\t    const alias = path.join(root, \"store-alias\");\n   691\t    fs.symlinkSync(store, alias, \"dir\");\n   692\t\n   693\t    const mountContext = { cwd: runtimeRoot, home, proxyDirectory, nodeRuntime: process.execPath, supervisorPath };\n   694\t    const hostMounts = candidateSandboxHostMountSources({ ...mountContext, readOnlyPaths: [readOnlyRuntime] });\n   695\t    const expectedToolchains = [\"/usr/local/go\", \"/usr/local/nexus-qual/rust\"]\n   696\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   697\t    const existingDirectories = [\"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/lib\", \"/lib64\", \"/usr/local/lib\"]\n   698\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   699\t    const existingEtcFiles = [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]\n   700\t      .filter((item) => { try { return fs.statSync(item).isFile(); } catch { return false; } });\n   701\t    const existingEtcDirectories = [\"/etc/alternatives\"]\n   702\t      .filter((item) => { try { return fs.statSync(item).isDirectory(); } catch { return false; } });\n   703\t    assert.deepEqual(hostMounts.systemDirectories, existingDirectories);\n   704\t    assert.deepEqual(hostMounts.systemFiles, existingEtcFiles);\n   705\t    assert.deepEqual(hostMounts.systemEtcDirectories, existingEtcDirectories);\n   706\t    assert.deepEqual(hostMounts.toolchainDirectories, expectedToolchains);\n   707\t    assert.deepEqual(hostMounts.runtimeSources, {\n   708\t      cwd: fs.realpathSync(runtimeRoot),\n   709\t      home: fs.realpathSync(home),\n   710\t      proxyDirectory,\n   711\t      nodeRuntime: fs.realpathSync(process.execPath),\n   712\t      supervisorPath: fs.realpathSync(supervisorPath),\n   713\t      readOnlyPaths: [fs.realpathSync(readOnlyRuntime)],\n   714\t    });\n   715\t\n   716\t    assert.equal(runtimeCorpusOverlapProblem([runtimeRoot], [runtimeRoot], tasks), null, \"an unrelated pinned runtime remains usable\");\n   717\t    assert.match(runtimeCorpusOverlapProblem([path.join(references, \"solution.patch\")], [store], tasks) ?? \"\", /overlaps protected corpus material/);\n   718\t    assert.match(runtimeCorpusOverlapProblem([runtimeRoot], [store], tasks) ?? \"\", /overlaps protected corpus material/, \"a broad allowlist root cannot contain the corpus store\");\n   719\t    assert.match(runtimeCorpusOverlapProblem([path.join(alias, \"reference\", \"solution.patch\")], [alias], tasks) ?? \"\", /overlaps protected corpus material/, \"symlink aliases are resolved before comparing paths\");\n   720\t    assert.match(runtimeCorpusOverlapProblem([privateValidator], [privateValidator], tasks, [privateValidator]) ?? \"\", /overlaps protected corpus material/);\n   721\t    assert.match(runtimeCorpusOverlapProblem([runtimeRoot], [runtimeRoot], tasks, [path.join(root, \"missing-validator\")]) ?? \"\", /private corpus path is unavailable/);\n   722\t    assert.equal(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\")), null, \"default in-repo development eval/tasks does not collide with eval/agent_sandbox.mjs\");\n   723\t    assert.equal(runtimeCorpusOverlapProblem([path.join(ROOT, \"cli/dist\")], [path.join(ROOT, \"cli\"), path.join(ROOT, \"core\")], path.join(ROOT, \"eval/tasks\")), null, \"default development Nexus runtime roots do not overlap eval/tasks\");\n   724\t    assert.match(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\"), [], { qualification: true }) ?? \"\", /overlaps protected corpus material/, \"qualification mode still rejects using in-repo eval/tasks because its parent overlaps eval/agent_sandbox.mjs\");\n   725\t\n   726\t    const unconditionalMountPaths = [\n   727\t      ...hostMounts.systemDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   728\t      ...hostMounts.systemFiles,\n   729\t      ...hostMounts.systemEtcDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   730\t      ...hostMounts.toolchainDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n   731\t    ];\n   732\t    const runtimeMountPaths = [\n   733\t      path.join(runtimeRoot, \"corpus-leak\"),\n   734\t      path.join(home, \"corpus-leak\"),\n   735\t      path.join(proxyDirectory, \"corpus-leak\"),\n   736\t      process.execPath,\n   737\t      supervisorPath,\n   738\t      readOnlyRuntime,\n   739\t    ];\n   740\t    for (const protectedPath of [...unconditionalMountPaths, ...runtimeMountPaths]) {\n   741\t      assert.match(\n   742\t        runtimeCorpusOverlapProblem([], [], tasks, [protectedPath], mountContext) ?? \"\",\n   743\t        /overlaps protected corpus material/,\n   744\t        `runtime preflight rejects mounted corpus path ${protectedPath}`,\n   745\t      );\n   746\t      assert.match(\n   747\t        hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: protectedPath }, mountContext }, tasks) ?? \"\",\n   748\t        /overlaps protected corpus material/,\n   749\t        `hidden-test qualification preflight rejects mounted corpus path ${protectedPath}`,\n   750\t      );\n   751\t      assert.throws(() => agentSandboxArgv({\n   752\t        cwd: runtimeRoot,\n   753\t        home,\n   754\t        proxyDirectory,\n   755\t        readOnlyPaths: [readOnlyRuntime],\n   756\t        supervisorPath,\n   757\t        protectedCorpusPaths: [protectedPath],\n   758\t      }), /overlaps protected corpus material/);\n   759\t      if (unconditionalMountPaths.includes(protectedPath)) {\n   760\t        // This check precedes Bubblewrap availability, including on minimal CI hosts.\n   761\t        assert.throws(() => isolatedArgv({ cwd: runtimeRoot, command: \"true\", protectedCorpusPaths: [protectedPath] }), /overlaps protected corpus material/);\n   762\t      }\n   763\t    }\n   764\t    assert.match(\n   765\t      runtimeCorpusOverlapProblem([], [\"/usr/bin\"], tasks, [path.join(\"/usr/bin\", \"synthetic-corpus-subdir\")]) ?? \"\",\n   766\t      /overlaps protected corpus material/,\n   767\t      \"a runtime allowlist root below an unconditional system mount is rejected\",\n   768\t    );\n   769\t    assert.match(\n   770\t      runtimeCorpusOverlapProblem([readOnlyRuntime], [], tasks, [readOnlyRuntime], mountContext) ?? \"\",\n   771\t      /overlaps protected corpus material/,\n   772\t      \"an explicit read-only runtime source is checked against the corpus\",\n   773\t    );\n   774\t    assert.match(\n   775\t      hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [readOnlyRuntime], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: readOnlyRuntime }, mountContext }, tasks) ?? \"\",\n   776\t      /overlaps protected corpus material/,\n   777\t      \"hidden-test preflight checks explicit read-only runtime sources\",\n   778\t    );\n   779\t    const custodyReportPath = readOnlyRuntime;\n   780\t    assert.match(hiddenTestIsolationProblem({\n   781\t      qualification: true,\n   782\t      runAs: \"nexus-eval\",\n   783\t      sandboxRuntimePaths: [readOnlyRuntime],\n   784\t      sandboxRuntimeRoots: [runtimeRoot],\n   785\t      corpusCustody: { reportPath: custodyReportPath },\n   786\t      mountContext,\n   787\t    }, tasks) ?? \"\", /overlaps protected corpus material/);\n   788\t    assert.throws(() => agentSandboxArgv({\n   789\t      cwd: runtimeRoot,\n   790\t      home,\n   791\t      proxyDirectory,\n   792\t      readOnlyPaths: [readOnlyRuntime],\n   793\t      supervisorPath,\n   794\t      protectedCorpusPaths: [custodyReportPath],\n   795\t    }), /overlaps protected corpus material/);\n   796\t  } finally {\n   797\t    fs.rmSync(root, { recursive: true, force: true });\n   798\t  }\n   799\t});\n   800\t\n   801\ttest(\"qualification remains fail-closed without enforced aggregate resource controls\", async () => {\n   802\t  const { qualificationResourceIsolationProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n   803\t  const { dedicatedTmpfsMountProblem } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n   804\t  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\n   805\t  const tmpfs = fs.statfsSync(workspaceRoot);\n   806\t  const ok = { cpuPercent: 100, memoryBytes: 256 * 1024 * 1024, tasks: 64, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\n   807\t  const shared = fs.statfsSync(\"/dev/shm\");\n   808\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: \"/dev/shm\", storageBytes: shared.blocks * shared.bsize } }) ?? \"\", /dedicated tmpfs|exact mount point/);\n   809\t  assert.match(qualificationResourceIsolationProblem(), /enforced CPU, memory, process-count, and workspace-storage limits/);\n   810\t  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: ROOT } }) ?? \"\", /tmpfs/);\n  1338\t  assert.equal(descendant.timedOut, true);\n  1339\t  await new Promise((resolve) => setTimeout(resolve, 2200));\n  1340\t  assert.equal(fs.existsSync(descendantMarker), false, \"a descendant survived evaluator timeout and wrote to the workspace\");\n  1341\t  networkServer.close();\n  1342\t  delete process.env.EVAL_SYNTHETIC_SECRET;\n  1343\t});\n  1344\t\n  1345\ttest(\"candidate namespace reaches only its authenticated run proxy and cannot read host files\", async () => {\n  1346\t  const { agentSandboxArgv, candidateAgentPath } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  1347\t  const { startModelProxy } = await import(proxyModule);\n  1348\t  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-agent-ws-\"));\n  1349\t  const home = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-agent-home-\"));\n  1350\t  const proxyDirectory = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-agent-proxy-\"));\n  1351\t  const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-agent-outside-\"));\n  1352\t  const canary = path.join(outside, \"canary.txt\");\n  1353\t  fs.writeFileSync(canary, \"HOST_PRIVATE_CANARY\");\n  1354\t  const seen: string[] = [];\n  1355\t  const upstream = http.createServer((req, res) => {\n  1356\t    seen.push(String(req.headers.authorization ?? \"\"));\n  1357\t    res.end(JSON.stringify({ data: [{ id: \"synthetic-model\" }] }));\n  1358\t  });\n  1359\t  let proxy: Awaited<ReturnType<typeof startModelProxy>> | undefined;\n  1360\t  try {\n  1361\t    await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  1362\t    proxy = await startModelProxy({ upstream: `http://127.0.0.1:${(upstream.address() as any).port}/v1`, authToken: \"UPSTREAM_AUTH_CANARY\", clientToken: \"RUN_LOCAL_TOKEN\", socketPath: path.join(proxyDirectory, \"proxy.sock\") });\n  1363\t    const nodeRuntime = process.execPath;\n  1364\t    const sandbox = agentSandboxArgv({ cwd: workspace, home, proxyDirectory, readOnlyPaths: [nodeRuntime], runtimeExecutablePaths: [nodeRuntime], supervisorPath: path.join(ROOT, \"eval/agent_sandbox.mjs\") });\n  1365\t    const script = `const fs=require('fs'),cp=require('child_process');fetch('http://127.0.0.1:40127/v1/models',{headers:{authorization:'Bearer '+process.env.OPENAI_API_KEY},signal:AbortSignal.timeout(2000)}).then(async r=>{let value='';try{value=fs.readFileSync(${JSON.stringify(canary)},'utf8')}catch{};try{fs.writeFileSync('/tmp/host-write-canary','changed')}catch{};const nested=cp.spawnSync('/usr/bin/unshare',['-Ur','true']);const toolchains={};for(const [name,args] of [['go',['version']],['rustc',['--version']],['cargo',['--version']]]){if(process.env.PATH.includes(name==='go'?'/usr/local/go/bin':'/usr/local/nexus-qual/rust/bin')){const check=cp.spawnSync(name,args,{encoding:'utf8'});toolchains[name]={status:check.status,stdout:check.stdout,stderr:check.stderr}}};console.log(JSON.stringify({status:r.status,token:process.env.OPENAI_API_KEY,upstreamVisible:process.env.UPSTREAM_AUTH_CANARY??null,canary:value,nestedUserns:nested.status,toolchains}))}).catch(e=>{console.error(e.message);process.exit(1)})`;\n  1366\t    process.env.UPSTREAM_AUTH_CANARY = \"UPSTREAM_AUTH_CANARY\";\n  1367\t    const candidatePath = candidateAgentPath(\"/usr/bin:/bin\");\n  1368\t    const child = await runSandbox(sandbox.cmd, sandbox.argv, JSON.stringify({ command: nodeRuntime, argv: [\"-e\", script], env: { PATH: candidatePath, OPENAI_API_KEY: \"RUN_LOCAL_TOKEN\" } }));\n  1369\t    assert.equal(child.status, 0, `${child.error ?? \"\"}\\n${child.stderr}\\n${child.stdout}\\nproxy=${JSON.stringify(proxy.stats())}\\nupstream=${JSON.stringify(seen)}`);\n  1370\t    const output = JSON.parse(child.stdout.trim());\n  1371\t    assert.equal(output.status, 200);\n  1372\t    assert.equal(output.token, \"RUN_LOCAL_TOKEN\");\n  1373\t    assert.equal(output.upstreamVisible, null);\n  1374\t    assert.equal(output.canary, \"\");\n  1375\t    assert.notEqual(output.nestedUserns, 0, \"candidate code could create a nested user namespace\");\n  1376\t    if (candidatePath.includes(\"/usr/local/go/bin\")) assert.equal(output.toolchains.go?.status, 0, `Go toolchain is not executable in candidate namespace: ${JSON.stringify(output.toolchains.go)}`);\n  1377\t    if (candidatePath.includes(\"/usr/local/nexus-qual/rust/bin\")) {\n  1378\t      assert.equal(output.toolchains.rustc?.status, 0, `Rust compiler is not executable in candidate namespace: ${JSON.stringify(output.toolchains.rustc)}`);\n  1379\t      assert.equal(output.toolchains.cargo?.status, 0, `Cargo is not executable in candidate namespace: ${JSON.stringify(output.toolchains.cargo)}`);\n  1380\t    }\n  1381\t    assert.deepEqual(seen, [\"Bearer UPSTREAM_AUTH_CANARY\"]);\n  1382\t    assert.equal(fs.existsSync(\"/tmp/host-write-canary\"), false);\n  1383\t    assert.doesNotMatch(`${child.stdout}${child.stderr}`, /HOST_PRIVATE_CANARY|UPSTREAM_AUTH_CANARY/);\n  1384\t  } finally {\n  1385\t    delete process.env.UPSTREAM_AUTH_CANARY;\n  1386\t    if (proxy) await proxy.close();\n  1387\t    if (upstream.listening) await new Promise<void>((resolve) => upstream.close(() => resolve()));\n  1388\t  }\n  1389\t});\n  1390\t\n     1\t// Runs one evaluation candidate behind a namespace-local TCP endpoint and a host-side Unix-socket proxy.\n     2\t// The candidate sees only the run-scoped local token; the upstream gateway credential stays in run.mjs.\n     3\timport http from \"node:http\";\n     4\timport { spawn } from \"node:child_process\";\n     5\timport { StringDecoder } from \"node:string_decoder\";\n     6\t\n     7\t// The launch payload is the first stdin line. With payload.protocol the rest of stdin is the agent's stdin (the T3\n     8\t// sidecar protocol); otherwise the agent gets no stdin.\n     9\tconst payload = JSON.parse(await readPayloadLine());\n    10\tconst port = 40127; // private to this network namespace; no host listener uses this port\n    11\tconst server = http.createServer((req, res) => {\n    12\t  const upstream = http.request({ socketPath: \"/run/eval-proxy/proxy.sock\", agent: new http.Agent({ keepAlive: false }), method: req.method, path: req.url, headers: { ...req.headers, host: \"eval-proxy\", connection: \"close\" } }, (response) => {\n    13\t    res.writeHead(response.statusCode ?? 502, response.headers);\n    14\t    response.pipe(res);\n    15\t    response.once(\"end\", () => upstream.destroy());\n    16\t  });\n    17\t  upstream.on(\"error\", (error) => {\n    18\t    if (!res.headersSent) res.writeHead(502, { \"content-type\": \"application/json\" });\n    19\t    res.end(JSON.stringify({ error: { type: \"proxy_unavailable\", message: \"evaluation proxy unavailable\" } }));\n    20\t  });\n    21\t  req.pipe(upstream);\n    22\t});\n    23\tawait new Promise((resolve, reject) => {\n    24\t  server.once(\"error\", reject);\n    25\t  server.listen(port, \"127.0.0.1\", resolve);\n    26\t});\n    27\t\n    28\tconst endpoint = `http://127.0.0.1:${port}/v1`;\n    29\tconst env = { ...payload.env };\n    30\tfor (const [key, value] of Object.entries(env)) {\n    31\t  if (typeof value === \"string\") env[key] = value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint);\n    32\t}\n    33\tconst argv = payload.argv.map((value) => value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint));\n    34\tconst agent = spawn(payload.command, argv, { cwd: \"/workspace\", env, stdio: [payload.protocol ? \"pipe\" : \"ignore\", \"inherit\", \"inherit\"] });\n    35\tif (payload.protocol) {\n    36\t  agent.stdin.on(\"error\", () => {});\n    37\t  process.stdin.pipe(agent.stdin);\n    38\t  process.stdin.resume();\n    39\t}\n    40\tlet stopping = false;\n    41\tconst stop = (signal) => {\n    42\t  if (stopping) return;\n    43\t  stopping = true;\n    44\t  try { process.kill(-agent.pid, signal); } catch { agent.kill(signal); }\n    45\t};\n    46\tprocess.on(\"SIGTERM\", () => stop(\"SIGTERM\"));\n    47\tprocess.on(\"SIGINT\", () => stop(\"SIGINT\"));\n    48\tagent.on(\"error\", (error) => {\n    49\t  process.stderr.write(`candidate spawn failed: ${error.message}\\n`);\n    50\t  closeBridge(127);\n    51\t});\n    52\tagent.on(\"close\", (code, signal) => {\n    53\t  closeBridge(code ?? (signal ? 128 : 1));\n    54\t});\n    55\t\n    56\t/** Reads stdin up to the first newline (or its end); anything after the newline is put back for the agent. */\n    57\tfunction readPayloadLine() {\n    58\t  return new Promise((resolve, reject) => {\n    59\t    let body = \"\";\n    60\t    const decoder = new StringDecoder(\"utf8\");\n    61\t    const onData = (chunk) => {\n    62\t      body += decoder.write(chunk);\n    63\t      if (body.length > 1_000_000) { cleanup(); reject(new Error(\"sandbox launch payload too large\")); return; }\n    64\t      const newline = body.indexOf(\"\\n\");\n    65\t      if (newline < 0) return;\n    66\t      cleanup();\n    67\t      process.stdin.pause();\n    68\t      const rest = body.slice(newline + 1);\n    69\t      if (rest) process.stdin.unshift(Buffer.from(rest, \"utf8\"));\n    70\t      resolve(body.slice(0, newline));\n    71\t    };\n    72\t    const onEnd = () => { cleanup(); resolve(body); };\n    73\t    const cleanup = () => { process.stdin.off(\"data\", onData); process.stdin.off(\"end\", onEnd); process.stdin.off(\"error\", reject); };\n    74\t    process.stdin.on(\"data\", onData);\n    75\t    process.stdin.on(\"end\", onEnd);\n    76\t    process.stdin.on(\"error\", reject);\n    77\t  });\n    78\t}\n    79\t\n    80\tfunction closeBridge(exitCode) {\n    81\t  process.exitCode = exitCode;\n    82\t  server.closeAllConnections?.();\n    83\t  server.close();\n    84\t}\n   115\t\n   116\tfunction isInsideAnyRoot(candidate, roots) {\n   117\t  return roots.some((root) => candidate === root || candidate.startsWith(`${root}${path.sep}`));\n   118\t}\n   119\t\n   120\t/** Reject every unpinned Go/Rust compiler reachable through the system mounts used by an oracle. */\n   121\texport function oracleCompilerExposureProblem(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS) {\n   122\t  const roots = [...new Set([...systemDirectories, ...systemEtcDirectories])].sort();\n   123\t  const cacheKey = JSON.stringify(roots);\n   124\t  if (oracleCompilerExposurePreflights.has(cacheKey)) return oracleCompilerExposurePreflights.get(cacheKey);\n   125\t\n   126\t  const exposed = new Set();\n   127\t  const visited = new Set();\n   128\t  const approvedRoots = PINNED_ORACLE_TOOLCHAINS.map(({ root }) => root);\n   129\t  const visit = (directory) => {\n   130\t    const canonicalDirectory = fs.realpathSync(directory);\n   131\t    if (visited.has(canonicalDirectory)) return;\n   132\t    visited.add(canonicalDirectory);\n   133\t    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n   134\t      const item = path.join(directory, entry.name);\n   135\t      if (entry.isDirectory()) {\n   136\t        visit(item);\n   137\t        continue;\n   138\t      }\n   139\t      if (!entry.isSymbolicLink() && !UNPINNED_ORACLE_COMPILER_NAME.test(entry.name)) continue;\n   140\t      let stat;\n   141\t      let target;\n   142\t      try {\n   143\t        stat = fs.statSync(item);\n   144\t        target = fs.realpathSync(item);\n   145\t      } catch (error) {\n   146\t        if (error?.code === \"ENOENT\") continue;\n   147\t        throw error;\n   148\t      }\n   149\t      if (stat.isDirectory()) {\n   150\t        visit(item);\n   151\t        continue;\n   152\t      }\n   153\t      if (!stat.isFile()\n   154\t        || (stat.mode & 0o111) === 0\n   155\t        || (!UNPINNED_ORACLE_COMPILER_NAME.test(entry.name) && !UNPINNED_ORACLE_COMPILER_NAME.test(path.basename(target)))\n   156\t        || isInsideAnyRoot(target, approvedRoots)) continue;\n   157\t      exposed.add(item);\n   158\t    }\n   159\t  };\n   160\t\n   161\t  try {\n   162\t    for (const root of roots) {\n   163\t      let stat;\n   164\t      try { stat = fs.statSync(root); }\n   165\t      catch (error) {\n   166\t        if (error?.code === \"ENOENT\") continue;\n   167\t        throw error;\n   168\t      }\n   169\t      if (stat.isDirectory()) visit(root);\n   170\t    }\n   171\t  } catch {\n   172\t    return \"oracle compiler exposure could not be checked; refusing qualification\";\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18686-7f9d-7a01-aaee-252d4871c34f","create_time":1793259144.2064989}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
