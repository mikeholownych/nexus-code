   131\t  return [...spellings];\n   132\t}\n   133\t\n   134\t/** Reject every unpinned Go/Rust compiler reachable through the task's mounted runtime paths. */\n   135\texport function oracleCompilerExposureProblem(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS, additionalMountedPaths = []) {\n   136\t  const scan = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths);\n   137\t  if (scan.problem) return scan.problem;\n   138\t  return scan.paths.length\n   139\t    ? `unapproved Go/Rust compiler executable is exposed through oracle system mounts: ${scan.paths.join(\", \")}`\n   140\t    : null;\n   141\t}\n   142\t\n   143\tfunction scanOracleCompilerExposure(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS, additionalMountedPaths = []) {\n   144\t  const roots = [...new Set([...systemDirectories, ...systemEtcDirectories, ...additionalMountedPaths])].sort();\n   145\t\n   146\t  const exposed = new Set();\n   147\t  const visited = new Set();\n   148\t  const approvedRoots = PINNED_ORACLE_TOOLCHAINS.map(({ root }) => root);\n   149\t  const inspectExecutable = (item, isSymbolicLink) => {\n   150\t    if (visited.has(item)) return;\n   151\t    visited.add(item);\n   152\t    const entryName = path.basename(item);\n   153\t    if (!UNPINNED_ORACLE_COMPILER_NAME.test(entryName) && !isSymbolicLink) return;\n   154\t    let stat;\n   155\t    let target;\n   156\t    try {\n   157\t      stat = fs.statSync(item);\n   158\t      target = fs.realpathSync(item);\n   159\t    } catch (error) {\n   160\t      if (error?.code === \"ENOENT\") return;\n   161\t      throw error;\n   162\t    }\n   163\t    if (!stat.isFile()\n   164\t      || (stat.mode & 0o111) === 0\n   165\t      || (!UNPINNED_ORACLE_COMPILER_NAME.test(entryName) && !UNPINNED_ORACLE_COMPILER_NAME.test(path.basename(target)))\n   166\t      || isInsideAnyRoot(target, approvedRoots)) return;\n   167\t    const descriptor = fs.openSync(target, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0));\n   168\t    let header;\n   169\t    try {\n   170\t      header = Buffer.alloc(2);\n   171\t      fs.readSync(descriptor, header, 0, header.length, 0);\n   172\t    } finally {\n   173\t      fs.closeSync(descriptor);\n   174\t    }\n   175\t    // Names such as `go-225` also occur in executable-mode terminfo records. Exclude only\n   176\t    // positively identified compiled terminfo data; keep no-shebang and binfmt executables.\n   177\t    const terminfoMagic = header.equals(Buffer.from([0x1a, 0x01])) || header.equals(Buffer.from([0x1e, 0x02]));\n   178\t    if (terminfoMagic && /(?:^|\\/)terminfo\\//.test(item)) return;\n   179\t    // The candidate's explicit runtime mounts may expose compiler targets outside the\n   180\t    // standard system roots. Mask each visible spelling after all runtime mounts are added.\n   181\t    for (const mountedPath of mountedSpellingsForTarget(target, roots)) exposed.add(mountedPath);\n   182\t  };\n   183\t  const visit = (directory) => {\n   184\t    // Preserve each mounted spelling. `/lib` and `/usr/lib` may resolve to the same host\n   185\t    // directory but remain distinct paths in the sandbox namespace, so both need masks.\n   186\t    const mountedDirectory = path.resolve(directory);\n   187\t    if (visited.has(mountedDirectory)) return;\n   188\t    visited.add(mountedDirectory);\n   189\t    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n   190\t      const item = path.join(directory, entry.name);\n   191\t      if (entry.isDirectory()) visit(item);\n   192\t      else inspectExecutable(item, entry.isSymbolicLink());\n   193\t    }\n   194\t  };\n   195\t\n   196\t  try {\n   197\t    for (const root of roots) {\n   198\t      let stat;\n   199\t      try { stat = fs.statSync(root); }\n   200\t      catch (error) {\n   201\t        if (error?.code === \"ENOENT\") continue;\n   202\t        throw err