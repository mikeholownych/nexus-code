untime.argv[index + 1] === fakeExternalGoTarget && externalRuntime.argv[index + 2] === fakeExternalGoTarget);\n    assert.ok(externalMaskIndex > externalRuntimeMountIndex, \"external compiler mask must follow and override its explicit runtime mount\");\n  }\n\n  assert.equal(oracleToolchainPathProblem({ uid: 0, mode: 0o040755 }), null, \"root-owned read-only directories are eligible\");\n  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040775 }), /without group or other write permission/, \"group-writable toolchain paths must fail closed\");\n  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040757 }), /without group or other write permission/, \"other-writable toolchain paths must fail closed\");\n  assert.match(oracleToolchainPathProblem({ uid: 1234, mode: 0o040755 }), /root-owned/, \"non-root-owned paths are not pinned roots\");\n  const candidateRootStat = { uid: 0, mode: 0o040755, isDirectory: () => true, isSymbolicLink: () => false };\n  assert.equal(candidateToolchainRootProblem(candidateRootStat, \"/usr/local/nexus-qual/rust\", \"/usr/local/nexus-qual/rust\"), null);\neval/isolate.mjs:79:export function candidateToolchainRootSources(toolchains = PINNED_ORACLE_TOOLCHAINS) {\neval/isolate.mjs:98:  const roots = candidateToolchainRootSources();\neval/isolate.mjs:135:export function scanOracleCompilerExposure(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS, additionalMountedPaths = []) {\neval/isolate.mjs:228:  const exposureScan = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths);\neval/isolate.mjs:233:function pinnedOracleToolchainsProblem(sources = candidateToolchainRootSources()) {\neval/isolate.mjs:412:  const compilerExposure = scanOracleCompilerExposure(mountSources.systemDirectories, mountSources.systemEtcDirectories);\neval/isolate.mjs:533:  const compilerExposure = scanOracleCompilerExposure(\neval/isolate.mjs:592:    compilerExposure = scanOracleCompilerExposure