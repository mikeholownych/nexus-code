{"timestamp":"2026-10-29T07:09:27.878Z","ordinal":497400,"type":"token_usage_record","payload":{"thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18678-40eb-70b2-b167-11dc8ca1d04f","session_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","root_turn_id":"01a18678-40eb-70b2-b167-11dc8ca1d04f","response_id":"resp_0db389702a7164cc016ae2f125e2a0819f813528024f7fba89","usage":{"input_tokens":167099,"cached_input_tokens":156160,"cache_write_input_tokens":0,"output_tokens":114,"reasoning_output_tokens":40,"total_tokens":167213},"turn_token_usage":{"input_tokens":4699084,"cached_input_tokens":4595712,"cache_write_input_tokens":0,"output_tokens":21470,"reasoning_output_tokens":15511,"total_tokens":4720554},"thread_token_usage":{"input_tokens":9297532488,"cached_input_tokens":9198380672,"cache_write_input_tokens":0,"output_tokens":26935908,"reasoning_output_tokens":15795137,"total_tokens":9324468396}}}
{"timestamp":"2026-10-29T07:09:27.881Z","ordinal":497401,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1867e-03c9-7c22-947e-0df79d022311","call_id":"call_4a677c418aa64dd9a7cfc8abe1837fee","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"[{\"name\":\"mcp__mcp_agent_mail__fetch_inbox\",\"description\":\"You are the MCP Agent Mail coordination server. Provide message routing, coordination tooling, and project context to cooperating agents. Outputs are JSON by default; pass format='toon' (or set MCP_AGENT_MAIL_OUTPUT_FORMAT=toon) to receive {format:'toon', data:'<TOON>'}.\\n\\nRetrieve recent messages for an agent without mutating read/ack state.\\n\\nFilters\\n-------\\n- `urgent_only`: only messages with importance in {high, urgent}\\n- `since_ts`: ISO-8601 timestamp string; messages strictly newer than this are returned\\n- `limit`: max number of messages (default 20)\\n- `include_bodies`: include full Markdo\"},{\"name\":\"mcp__mcp_agent_mail__send_message\",\"description\":\"You are the MCP Agent Mail coordination server. Provide message routing, coordination tooling, and project context to cooperating agents. Outputs are JSON by default; pass format='toon' (or set MCP_AGENT_MAIL_OUTPUT_FORMAT=toon) to receive {format:'toon', data:'<TOON>'}.\\n\\nSend a Markdown message to one or more recipients and persist canonical and mailbox copies to Git.\\n\\nDiscovery\\n---------\\nTo discover available agent names for recipients, use: resource://agents/{project_key}\\nAgent names are NOT the same as program names or user names.\\n\\nWhat this does\\n--------------\\n- Stores message (and recipi\"}]"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18678-40eb-70b2-b167-11dc8ca1d04f","create_time":1793257767.8817995}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
