leanupRpc();\n        throw err;\n      }\n    })();\n\n    return this.handshakePromise;\n  }\n\n  public static shutdownAllGlobal(): void {\n    for (const b of RustCoreBridge.activeBridges) {\n      b.shutdown();\n    }\n    RustCoreBridge.activeBridges.clear();\n  }\n\n  /**\n   * The abort signal of the turn now running. Every RPC sent while it is set is tied to it: when the turn is cancelled,\n   * the runner is told to end that request's command (its whole process group) instead of leaving it running.\n   */\n  private turnSignal?: AbortSignal;\n\n  public setTurnSignal(signal: AbortSignal | undefined): void {\n    this.turnSignal = signal;\n  }\n\n  /** Asks the runner to end the request's command; best effort (the daemon may already be gone). */\n  private sendCancel(requestId: number): void {\n    const daemon = this.rpcProcess;\n    if (!daemon?.stdin || daemon.stdin.destroyed) return;\n    try {\n      daemon.stdin.write(JSON.stringify({ id: this.nextRequestId++, method: \"cancel\", params: { request_id: requestId } }) + \"\\n\");\n    } catch {}\n  }\n\n  /**\n   * Ends background processes that finished commands left running (`server &`), for a cancelled turn. Returns how many\n   * process groups were ended, or 0 when the runner is not running.\n   */\n  resumeSession(id?: string): { ok: boolean; message: string };\n  /** Earlier prompts, oldest first: the REPL history file, then this session's prompts. */\n  history(): string[];\n  /** Approval callback for agent runs a command starts; undefined in auto mode. */\n  confirm(signal: AbortSignal): ConfirmHandler | undefined;\n  /** Direct deliberate approval request for gated actions (such as in-place upgrades). */\n  requestApproval?(tool: string, args: Record<string, any>, signal: AbortSignal): Promise<boolean>;\n  /** Receipt sections for the last turn and the active validation receipt. */\n  receipt(): ReceiptSection[];\n}\n\nexport interface SlashContext {\n  host: SlashHost;\n  args: string;\n  signal: AbortSignal;\n}\n\nexport interface SlashReply {\n  kind: \"reply\";\n  command: string;\n  success: boolean;\n  output: string;\n  /** \"diff\" asks the client to colour unified-diff lines. */\n  format?: \"diff\";\n  /** Text for the client to put into the composer. */\n  composer?: string;\n}\n\n/** The command resolved to a prompt: the sidecar checkpoints, then runs it as a turn under the command's id. */\nexport interface SlashTurn {\n  kind: \"turn\";\n  command: string;\n  prompt: string | any[];\n  label: string;\n  checkpoint: string;\n}\n\nexport type SlashOutcome = SlashReply | SlashTurn;\nexport type SlashHandler = (ctx: SlashContext) => SlashOutcome | Promise<SlashOutcome>;\n\nexport const NOT_A_REPO = \"This workspace is not inside a git repository.\";\n","exit_code":0,"duration":{"secs":0,"nanos":761661539}},"started_at_ms":1792891064994,"completed_at_ms":1792891065757}}
