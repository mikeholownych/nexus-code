default to review.\n    approvalMode = fullAccess ? \"auto\" : \"review\";\n  }\n\n  const sandbox = options.sandbox ? (typeof options.sandbox === \"string\" ? options.sandbox : true) : undefined;\n  if (provider && options.fallback) warnOnce(`--fallback is ignored for provider '${provider}': a provider connection is pinned to its own endpoint.`);\n  const fallbackEndpoints = options.fallback && !provider ? options.fallback.split(\",\").map((s: string) => s.trim()) : undefined;\n  const contextLimit = options.contextLimit ? parseInt(options.contextLimit, 10) : (effectiveSetting(\"NEXUS_CONTEXT_LIMIT\") ? parseInt(effectiveSetting(\"NEXUS_CONTEXT_LIMIT\")!, 10) : undefined);\n  const strictTokenCount = Boolean(options.strictTokenCount) || effectiveSetting(\"NEXUS_STRICT_TOKEN_COUNT\") === \"1\";\n  const worktree = Boolean(options.worktree);\n  const authoritativeVerifierCommand = options.authoritativeVerifier;\n  const trustedDeliverableFiles = normalizeTrustedDeliverableFiles(workspace, options.deliverableFile);\n  const recordFlight = Boolean(options.recordFlight || options.flight);\n  const plannerProvider = selectProvider(options.plannerProvider, \"PLANNER_LLM_PROVIDER\");\n  const coderProvider = selectProvider(options.coderProvider, \"CODER_LLM_PROVIDER\");\n  const plannerModel = options.plannerModel || effectiveSetting(\"PLANNER_LLM_MODEL\");\n  const plannerEndpoint = plannerProvider ? providerBaseUrl(plannerProvider) : options.plannerEndpoint || effectiveSetting(\"PLANNER_LLM_ENDPOINT\");\n  const coderModel = options.coderModel || effectiveSetting(\"CODER_LLM_MODEL\");\n  const coderEndpoint = coderProvider ? providerBaseUrl(coderProvider) : options.coderEndpoint || effectiveSetting(\"CODER_LLM_ENDPOINT\");\n  if (plannerProvider && !plannerModel) throw new Error(`Planner provider '${plannerProvider}' needs an explicit model: pass --planner-model or set PLANNER_LLM_MODEL.`);\n  if (coderProvider && !coderModel) throw new Error(`Coder provider '${coderProvider}' needs an explicit model: pass --coder-model or set CODER_LLM_MODEL.`);\n  const plannerApiKey = REDACTED ? providerKey(plannerProvider) : undefined;\n\n/** Project instructions are untrusted workspace input and are injected only after the operator explicitly trusts it. */\nexport function trustedProjectRules(\n  workspace: string,\n  isTrusted: (workspace: string) => boolean = isWorkspaceTrusted,\n): string | null {\n  return isTrusted(workspace) ? getProjectRules(workspace) : null;\n}\n\n/**\n * Ask for explicit trust before starting an interactive Nexus client. Non-interactive launches continue under the\n * existing untrusted-workspace policy and never persist trust implicitly.\n */\nexport function promptWorkspaceTrust(\n  workspace: string,\n  options: TrustPromptOptions = {},\n): Promise<WorkspaceTrustDecision> {\n  const input = options.input ?? process.stdin;\n  const output = options.output ?? process.stdout;\n  const noticeOutput = options.output ?? process.stderr;\n  const trustStore = options.trustStore ?? {\n    isTrusted: isWorkspaceTrusted,\n    trust: (target: string) => setWorkspaceTrusted(target, true),\n  };\n  const resolvedWorkspace = path.resolve(workspace);\n  const displayWorkspace = safeTerminalText(resolvedWorkspace);\n\n  if (trustStore.isTrusted(resolvedWorkspace)) return Promise.resolve(\"trusted\");\n  if (!input.isTTY || !output.isTTY) {\n    noticeOutput.write(\n      `Nexus: ${displayWorkspace} is not trusted. Project instructions and workspace integrations stay unloaded. ` +\n      `Run 'nexus trust .' to load them. Tool approvals follow your permission settings.\\n`,\n    );\n    return Promise.resolve(\"untrusted\");\n  }\n\n  const instructionFile = projectInstructionFile(resolvedWorkspace);\n  const optionsText = [\n    \"Trust and continue\",\n    \"Continue without trusting\",\n    \"Exit\",\n  ];\n  const selected = 0;\n  const oldRawMode = Boolean(input.isRaw);\n\n  return new Promise((resolve) => {\n    let choice = selected;\n    let complete = false;\n    let statusMessage: string | undefined;\n\n    const render = () => {\n      const width = Math.max(32, output.columns ?? 80);\n      const fit = (value: string) => fitTerminalText(value, width);\n      const projectFile = instructionFile ? `Check: ${instructionFile}` : \"No project instruction file found\";\n      const rows = optionsText.map((text, index) => `${choice === index ? \"›\" : \" \"} ${text}`);\n      output.write([\n        \"\\u001b[2J\\u001b[H\",\n        \"Trust this folder?\",\n        \"↑↓ navigate · Enter select · Esc exit\",\n        fit(displayWorkspace),\n        \"Load project instructions\",\n        fit(projectFile),\n        \"Trust remembered for this folder.\",\n        \"Includes future project config changes.\",\n        \"Trust loads project instructions and\",\n        \"workspace integrations.\",\n        \"Tool approvals use permission settings.\",\n        \"Folder trust doesn't change approvals.\",\n        ...(statusMessage ? [fit(statusMessage)] : []),\n        \"\",\n        ...rows,\n      ].join(\"\\n\"));\n    };\n\n    const finish = (decision: WorkspaceTrustDecision) => {\n      if (complete) return;\n      complete = true;\n      input.removeListener(\"keypress\", onKeypress);\n      input.removeListener(\"close\", onClose);\n      try { input.setRawMode(oldRawMode); } catch {}\n      if (decision === \"exit\") {\ncli/test/repl_approval_e2e.test.ts:190:    assert.equal(result.approvalPrompt, mode !== \"auto\", \"approval mode is independent of folder trust\");\ncli/test/repl_approval_e2e.test.ts:215:async function runVerifierSlashCase(trusted: boolean, mode: \"review\" | \"auto\", cancel = false) {\ncli/test/repl_approval_e2e.test.ts:254:    assert.equal(result.approvalPrompt, mode === \"review\");\ncli/test/repl_approval_e2e.test.ts:295:      await runVerifierSlashCase(trusted, mode);\ncli/test/repl_approval_e2e.test.ts:298:  await runVerifierSlashCase(true, \"review\", true);\ncli/src/index.ts:28:import { promptWorkspaceTrust } from \"./startup_trust.js\";\ncli/src/index.ts:208:  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\ncli/src/index.ts:249:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\ncli/src/index.ts:258:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\ncli/src/startup_trust.ts:88:export function promptWorkspaceTrust(\n cli/src/slash/catalog.ts            |   2 +-\n cli/src/slash/workspace_commands.ts |  43 ++++++++--\n cli/test/repl_approval_e2e.test.ts  | 167 ++++++++++++++++++++++++++++++++++++\n 3 files changed, 204 insertions(+), 8 deletions(-)\ndiff --git a/cli/src/slash/catalog.ts b/cli/src/slash/catalog.ts\nindex eacbd3e..68867ad 100644\n--- a/cli/src/slash/catalog.ts\n+++ b/cli/src/slash/catalog.ts\n@@ -105,7 +105,7 @@ export const SLASH_COMMANDS: SlashSpec[] = [\n   { name: \"worktree\", usage: \"/worktree [status|merge|discard]\", summary: \"Manage the speculative git worktree\" },\n   { name: \"audit\", usage: \"/audit [count]\", summary: \"Recent tool executions\" },\n   { name: \"receipt\", usage: \"/receipt\", summary: \"Turn outcome, verifier evidence and validation receipt\" },\n-  { name: \"test\", usage: \"/test [pattern]\", summary: \"Run the project's test suite\" },\n+  { name: \"test\", usage: \"/test [pattern]\", summary: \"Run the project's test suite\", cancellable: true },\n   { name: \"copy\", usage: \"/copy [diff|code|last]\", summary: \"Copy the diff, code blocks or the last reply\" },\n   { name: \"paste\", usage: \"/paste\", summary: \"Put the clipboard into the composer\" },\n   { name: \"sessions\", usage: \"/sessions\", summary: \"Saved sessions\" },\ndiff --git a/cli/src/slash/workspace_commands.ts b/cli/src/slash/workspace_commands.ts\nindex f262100..0b8c08f 100644\n--- a/cli/src/slash/workspace_commands.ts\n+++ b/cli/src/slash/workspace_commands.ts\n@@ -5,7 +5,9 @@ import * as path from \"node:path\";\n import { copyToClipboard, readFromClipboard } from \"../clipboard.js\";\n import { commitChanges, generateConventionalCommit, getGitInfo } from \"../git.js\";\n import { HunkStager } from \"../stager.js\";\n-import { runTestSuiteWithExecutor, discoverVerifier, verifierTimeoutSecs } from \"../tester.js\";\n+import { runTestSuiteWithExecutor, discoverVerifier, describeVerifier, verifierTimeoutSecs } from \"../tester.js\";\n+import { isWorkspaceTrusted } from \"../workspace_trust.js\";\n+import { PolicyContext } from \"../core/approval_policy.js\";\n import { NOT_A_REPO, SlashContext, SlashHandler, SlashOutcome, errorText, reply } from \"./catalog.js\";\n \n function git(cwd: string, args: string[]): string {\n@@ -163,13 +165,40 @@ async function test(ctx: SlashContext): Promise<SlashOutcome> {\n   if (!discovered) {\n     return reply(\"test\", \"no verifier: no verification command is configured or discovered in this workspace.\", false);\n   }\n-  const bridge = ctx.host.app.getAgent().getBridge();\n+  const description = describeVerifier(ws, discovered.command);\n+  const testCommand = description?.command || discovered.command;\n+  const agent = ctx.host.app.getAgent();\n+  const bridge = agent.getBridge();\n+  const config = ctx.host.app.getConfig();\n+  const policyContext: PolicyContext = {\n+    mode: ctx.host.mode(),\n+    trusted: isWorkspaceTrusted(ws, Boolean(config.readOnly)),\n+    sandbox: config.sandbox,\n+    fullAccess: Boolean(config.fullAccess),\n+  };\n+  if (agent.getApprovalPolicy().requiresDecision(\"exec\", policyContext)) {\n+    const approved = ctx.host.requestApproval\n+      ? await ctx.host.requestApproval(\"verifier\", {\n+          command: testCommand,\n+          script: description?.script,\n+          detail: description?.evidence ?? discovered.evidence,\n+          digest: description?.digest,\n+        }, ctx.signal)\n+      : false;\n+    if (!approved) return reply(\"test\", \"Test run aborted by user.\", false);\n+  }\n   const timeoutSecs = verifierTimeoutSecs(ctx.host.app.getConfig().verifierTimeoutSecs);\n-  const result = await runTestSuiteWithExecutor(\n-    ws,\n-    (command) => bridge.executeTool(\"run_command\", { command, timeout_secs: timeoutSecs }),\n-    discovered.command,\n-  );\n+  bridge.setTurnSignal(ctx.signal);\n+  let result;\n+  try {\n+    result = await runTestSuiteWithExecutor(\n+      ws,\n+      (command) => bridge.executeTool(\"run_command\", { command, timeout_secs: timeoutSecs }),\n+      testCommand,\n+    );\n+  } finally {\n+    bridge.setTurnSignal(undefined);\n+  }\n   const lines = [`$ ${result.command}`, result.success ? \"Test suite passed.\" : \"Test suite failed.\"];\n   if (!result.success && result.failures.length) lines.push(\"\", \"Failing tests:\", ...result.failures.slice(0, 10).map((f) => `  • ${f}`));\n   if (!result.success && result.diagnostics.length) {\n","exit_code":0,"duration":{"secs":0,"nanos":983888016}},"started_at_ms":1792891874008,"completed_at_ms":1792891874993}}
{"timestamp":"2026-10-25T01:31:16.549Z","ordinal":318094,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a170ae-f4c5-78b3-bcfa-df4ff95f8caa","call_id":"call_1a01560b6498457d820ed3fa4d5beb93","output":[{"type":"input_text","text":"Script completed\nWall time 4.3 seconds\nOutput:\n"},{"type":"input_text","text":"[{\"chunk_id\":\"cdc641\",\"wall_time_seconds\":0.983995104,\"exit_code\":0,\"original_token_count\":2872,\"output\":\"\\n  let approvalMode: ApprovalMode;\\n  let fullAccess = Boolean(options.fullAccess);\\n\\n  if (readOnly) {\\n    approvalMode = \\\"read-only\\\";\\n  } else if (yes) {\\n    approvalMode = \\\"auto\\\";\\n    fullAccess = true;\\n  } else if (approve) {\\n    approvalMode = \\\"review\\\";\\n  } else if (modeOption === \\\"auto\\\" || modeOption === \\\"review\\\" || modeOption === \\\"read-only\\\") {\\n    approvalMode = modeOption as ApprovalMode;\\n    if (approvalMode === \\\"auto\\\" && options.yes) fullAccess = true;\\n  } else if (envMode === \\\"auto\\\" || envMode === \\\"review\\\" || envMode === \\\"read-only\\\") {\\n    approvalMode = envMode as ApprovalMode;\\n    if (approvalMode === \\\"auto\\\") fullAccess = true;\\n  } else {\\n    // Folder trust controls project instructions and integrations, not tool authority.\\n    // Use an explicit full-access setting when present; otherwise default to review.\\n    approvalMode = fullAccess ? \\\"auto\\\" : \\\"review\\\";\\n  }\\n\\n  const sandbox = options.sandbox ? (typeof options.sandbox === \\\"string\\\" ? options.sandbox : true) : undefined;\\n  if (provider && options.fallback) warnOnce(`--fallback is ignored for provider '${provider}': a provider connection is pinned to its own endpoint.`);\\n  const fallbackEndpoints = options.fallback && !provider ? options.fallback.split(\\\",\\\").map((s: string) => s.trim()) : undefined;\\n  const contextLimit = options.contextLimit ? parseInt(options.contextLimit, 10) : (effectiveSetting(\\\"NEXUS_CONTEXT_LIMIT\\\") ? parseInt(effectiveSetting(\\\"NEXUS_CONTEXT_LIMIT\\\")!, 10) : undefined);\\n  const strictTokenCount = Boolean(options.strictTokenCount) || effectiveSetting(\\\"NEXUS_STRICT_TOKEN_COUNT\\\") === \\\"1\\\";\\n  const worktree = Boolean(options.worktree);\\n  const authoritativeVerifierCommand = options.authoritativeVerifier;\\n  const trustedDeliverableFiles = normalizeTrustedDeliverableFiles(workspace, options.deliverableFile);\\n  const recordFlight = Boolean(options.recordFlight || options.flight);\\n  const plannerProvider = selectProvider(options.plannerProvider, \\\"PLANNER_LLM_PROVIDER\\\");\\n  const coderProvider = selectProvider(options.coderProvider, \\\"CODER_LLM_PROVIDER\\\");\\n  const plannerModel = options.plannerModel || effectiveSetting(\\\"PLANNER_LLM_MODEL\\\");\\n  const plannerEndpoint = plannerProvider ? providerBaseUrl(plannerProvider) : options.plannerEndpoint || effectiveSetting(\\\"PLANNER_LLM_ENDPOINT\\\");\\n  const coderModel = options.coderModel || effectiveSetting(\\\"CODER_LLM_MODEL\\\");\\n  const coderEndpoint = coderProvider ? providerBaseUrl(coderProvider) : options.coderEndpoint || effectiveSetting(\\\"CODER_LLM_ENDPOINT\\\");\\n  if (plannerProvider && !plannerModel) throw new Error(`Planner provider '${plannerProvider}' needs an explicit model: pass --planner-model or set PLANNER_LLM_MODEL.`);\\n  if (coderProvider && !coderModel) throw new Error(`Coder provider '${coderProvider}' needs an explicit model: pass --coder-model or set CODER_LLM_MODEL.`);\\n  const plannerApiKey = REDACTED ? providerKey(plannerProvider) : undefined;\\n\\n/** Project instructions are untrusted workspace input and are injected only after the operator explicitly trusts it. */\\nexport function trustedProjectRules(\\n  workspace: string,\\n  isTrusted: (workspace: string) => boolean = isWorkspaceTrusted,\\n): string | null {\\n  return isTrusted(workspace) ? getProjectRules(workspace) : null;\\n}\\n\\n/**\\n * Ask for explicit trust before starting an interactive Nexus client. Non-interactive launches continue under the\\n * existing untrusted-workspace policy and never persist trust implicitly.\\n */\\nexport function promptWorkspaceTrust(\\n  workspace: string,\\n  options: TrustPromptOptions = {},\\n): Promise<WorkspaceTrustDecision> {\\n  const input = options.input ?? process.stdin;\\n  const output = options.output ?? process.stdout;\\n  const noticeOutput = options.output ?? process.stderr;\\n  const trustStore = options.trustStore ?? {\\n    isTrusted: isWorkspaceTrusted,\\n    trust: (target: string) => setWorkspaceTrusted(target, true),\\n  };\\n  const resolvedWorkspace = path.resolve(workspace);\\n  const displayWorkspace = safeTerminalText(resolvedWorkspace);\\n\\n  if (trustStore.isTrusted(resolvedWorkspace)) return Promise.resolve(\\\"trusted\\\");\\n  if (!input.isTTY || !output.isTTY) {\\n    noticeOutput.write(\\n      `Nexus: ${displayWorkspace} is not trusted. Project instructions and workspace integrations stay unloaded. ` +\\n      `Run 'nexus trust .' to load them. Tool approvals follow your permission settings.\\\\n`,\\n    );\\n    return Promise.resolve(\\\"untrusted\\\");\\n  }\\n\\n  const instructionFile = projectInstructionFile(resolvedWorkspace);\\n  const optionsText = [\\n    \\\"Trust and continue\\\",\\n    \\\"Continue without trusting\\\",\\n    \\\"Exit\\\",\\n  ];\\n  const selected = 0;\\n  const oldRawMode = Boolean(input.isRaw);\\n\\n  return new Promise((resolve) => {\\n    let choice = selected;\\n    let complete = false;\\n    let statusMessage: string | undefined;\\n\\n    const render = () => {\\n      const width = Math.max(32, output.columns ?? 80);\\n      const fit = (value: string) => fitTerminalText(value, width);\\n      const projectFile = instructionFile ? `Check: ${instructionFile}` : \\\"No project instruction file found\\\";\\n      const rows = optionsText.map((text, index) => `${choice === index ? \\\"›\\\" : \\\" \\\"} ${text}`);\\n      output.write([\\n        \\\"\\\\u001b[2J\\\\u001b[H\\\",\\n        \\\"Trust this folder?\\\",\\n        \\\"↑↓ navigate · Enter select · Esc exit\\\",\\n        fit(displayWorkspace),\\n        \\\"Load project instructions\\\",\\n        fit(projectFile),\\n        \\\"Trust remembered for this folder.\\\",\\n        \\\"Includes future project config changes.\\\",\\n        \\\"Trust loads project instructions and\\\",\\n        \\\"workspace integrations.\\\",\\n        \\\"Tool approvals use permission settings.\\\",\\n        \\\"Folder trust doesn't change approvals.\\\",\\n        ...(statusMessage ? [fit(statusMessage)] : []),\\n        \\\"\\\",\\n        ...rows,\\n      ].join(\\\"\\\\n\\\"));\\n    };\\n\\n    const finish = (decision: WorkspaceTrustDecision) => {\\n      if (complete) return;\\n      complete = true;\\n      input.removeListener(\\\"keypress\\\", onKeypress);\\n      input.removeListener(\\\"close\\\", onClose);\\n      try { input.setRawMode(oldRawMode); } catch {}\\n      if (decision === \\\"exit\\\") {\\ncli/test/repl_approval_e2e.test.ts:190:    assert.equal(result.approvalPrompt, mode !== \\\"auto\\\", \\\"approval mode is independent of folder trust\\\");\\ncli/test/repl_approval_e2e.test.ts:215:async function runVerifierSlashCase(trusted: boolean, mode: \\\"review\\\" | \\\"auto\\\", cancel = false) {\\ncli/test/repl_approval_e2e.test.ts:254:    assert.equal(result.approvalPrompt, mode === \\\"review\\\");\\ncli/test/repl_approval_e2e.test.ts:295:      await runVerifierSlashCase(trusted, mode);\\ncli/test/repl_approval_e2e.test.ts:298:  await runVerifierSlashCase(true, \\\"review\\\", true);\\ncli/src/index.ts:28:import { promptWorkspaceTrust } from \\\"./startup_trust.js\\\";\\ncli/src/index.ts:208:  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\\ncli/src/index.ts:249:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\\ncli/src/index.ts:258:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\\ncli/src/startup_trust.ts:88:export function promptWorkspaceTrust(\\n cli/src/slash/catalog.ts            |   2 +-\\n cli/src/slash/workspace_commands.ts |  43 ++++++++--\\n cli/test/repl_approval_e2e.test.ts  | 167 ++++++++++++++++++++++++++++++++++++\\n 3 files changed, 204 insertions(+), 8 deletions(-)\\ndiff --git a/cli/src/slash/catalog.ts b/cli/src/slash/catalog.ts\\nindex eacbd3e..68867ad 100644\\n--- a/cli/src/slash/catalog.ts\\n+++ b/cli/src/slash/catalog.ts\\n@@ -105,7 +105,7 @@ export const SLASH_COMMANDS: SlashSpec[] = [\\n   { name: \\\"worktree\\\", usage: \\\"/worktree [status|merge|discard]\\\", summary: \\\"Manage the speculative git worktree\\\" },\\n   { name: \\\"audit\\\", usage: \\\"/audit [count]\\\", summary: \\\"Recent tool executions\\\" },\\n   { name: \\\"receipt\\\", usage: \\\"/receipt\\\", summary: \\\"Turn outcome, verifier evidence and validation receipt\\\" },\\n-  { name: \\\"test\\\", usage: \\\"/test [pattern]\\\", summary: \\\"Run the project's test suite\\\" },\\n+  { name: \\\"test\\\", usage: \\\"/test [pattern]\\\", summary: \\\"Run the project's test suite\\\", cancellable: true },\\n   { name: \\\"copy\\\", usage: \\\"/copy [diff|code|last]\\\", summary: \\\"Copy the diff, code blocks or the last reply\\\" },\\n   { name: \\\"paste\\\", usage: \\\"/paste\\\", summary: \\\"Put the clipboard into the composer\\\" },\\n   { name: \\\"sessions\\\", usage: \\\"/sessions\\\", summary: \\\"Saved sessions\\\" },\\ndiff --git a/cli/src/slash/workspace_commands.ts b/cli/src/slash/workspace_commands.ts\\nindex f262100..0b8c08f 100644\\n--- a/cli/src/slash/workspace_commands.ts\\n+++ b/cli/src/slash/workspace_commands.ts\\n@@ -5,7 +5,9 @@ import * as path from \\\"node:path\\\";\\n import { copyToClipboard, readFromClipboard } from \\\"../clipboard.js\\\";\\n import { commitChanges, generateConventionalCommit, getGitInfo } from \\\"../git.js\\\";\\n import { HunkStager } from \\\"../stager.js\\\";\\n-import { runTestSuiteWithExecutor, discoverVerifier, verifierTimeoutSecs } from \\\"../tester.js\\\";\\n+import { runTestSuiteWithExecutor, discoverVerifier, describeVerifier, verifierTimeoutSecs } from \\\"../tester.js\\\";\\n+import { isWorkspaceTrusted } from \\\"../workspace_trust.js\\\";\\n+import { PolicyContext } from \\\"../core/approval_policy.js\\\";\\n import { NOT_A_REPO, SlashContext, SlashHandler, SlashOutcome, errorText, reply } from \\\"./catalog.js\\\";\\n \\n function git(cwd: string, args: string[]): string {\\n@@ -163,13 +165,40 @@ async function test(ctx: SlashContext): Promise<SlashOutcome> {\\n   if (!discovered) {\\n     return reply(\\\"test\\\", \\\"no verifier: no verification command is configured or discovered in this workspace.\\\", false);\\n   }\\n-  const bridge = ctx.host.app.getAgent().getBridge();\\n+  const description = describeVerifier(ws, discovered.command);\\n+  const testCommand = description?.command || discovered.command;\\n+  const agent = ctx.host.app.getAgent();\\n+  const bridge = agent.getBridge();\\n+  const config = ctx.host.app.getConfig();\\n+  const policyContext: PolicyContext = {\\n+    mode: ctx.host.mode(),\\n+    trusted: isWorkspaceTrusted(ws, Boolean(config.readOnly)),\\n+    sandbox: config.sandbox,\\n+    fullAccess: Boolean(config.fullAccess),\\n+  };\\n+  if (agent.getApprovalPolicy().requiresDecision(\\\"exec\\\", policyContext)) {\\n+    const approved = ctx.host.requestApproval\\n+      ? await ctx.host.requestApproval(\\\"verifier\\\", {\\n+          command: testCommand,\\n+          script: description?.script,\\n+          detail: description?.evidence ?? discovered.evidence,\\n+          digest: description?.digest,\\n+        }, ctx.signal)\\n+      : false;\\n+    if (!approved) return reply(\\\"test\\\", \\\"Test run aborted by user.\\\", false);\\n+  }\\n   const timeoutSecs = verifierTimeoutSecs(ctx.host.app.getConfig().verifierTimeoutSecs);\\n-  const result = await runTestSuiteWithExecutor(\\n-    ws,\\n-    (command) => bridge.executeTool(\\\"run_command\\\", { command, timeout_secs: timeoutSecs }),\\n-    discovered.command,\\n-  );\\n+  bridge.setTurnSignal(ctx.signal);\\n+  let result;\\n+  try {\\n+    result = await runTestSuiteWithExecutor(\\n+      ws,\\n+      (command) => bridge.executeTool(\\\"run_command\\\", { command, timeout_secs: timeoutSecs }),\\n+      testCommand,\\n+    );\\n+  } finally {\\n+    bridge.setTurnSignal(undefined);\\n+  }\\n   const lines = [`$ ${result.command}`, result.success ? \\\"Test suite passed.\\\" : \\\"Test suite failed.\\\"];\\n   if (!result.success && result.failures.length) lines.push(\\\"\\\", \\\"Failing tests:\\\", ...result.failures.slice(0, 10).map((f) => `  • ${f}`));\\n   if (!result.success && result.diagnostics.length) {\\n\"},{\"chunk_id\":\"ead6f8\",\"wall_time_seconds\":0.000059398,\"exit_code\":0,\"original_token_count\":1371,\"output\":\".git/nexus-claims/FILE_cli_test_helpers_startup_permission_driver.py\\n{\\\"agent\\\":\\\"codex-root\\\",\\\"branch\\\":\\\"v1/plan-01-sec101-119-pty-followup\\\",\\\"since\\\":\\\"2026-10-25T01:17:00Z\\\",\\\"scope\\\":\\\"new PTY driver for ACC-SAFE-01 launch/trust/permission matrix\\\"}\\n.git/nexus-claims/FILE_experiments_cloudflare-artifacts-vertical-slice_trusted-broker-bundle_package-lock.json\\n{\\n  \\\"agent\\\": \\\"codex-root\\\",\\n  \\\"host\\\": \\\"mike-dev\\\",\\n  \\\"branch\\\": \\\"codex/post-contest-dependency-remediation\\\",\\n  \\\"worktree\\\": \\\"/home/mike/nexus-wt/post-contest-dependency-remediation\\\",\\n  \\\"base\\\": \\\"29eab4cd58051a8210b5ef66e0c9e248b2046a13\\\",\\n  \\\"since\\\": \\\"2026-10-24T19:30:21.595193Z\\\",\\n  \\\"scope\\\": \\\"Trusted broker bundle package-lock.json only for security patch updates.\\\",\\n  \\\"head\\\": \\\"62bf74e4b37c5a8f1a4be33c208d72dc9e15ec4e\\\",\\n  \\\"updated_at\\\": \\\"2026-10-24T19:36:11.978863Z\\\"\\n}\\n.git/nexus-claims/FILE_experiments_cloudflare-artifacts-vertical-slice_trusted-broker-bundle_package.json\\n{\\n  \\\"agent\\\": \\\"codex-root\\\",\\n  \\\"host\\\": \\\"mike-dev\\\",\\n  \\\"branch\\\": \\\"codex/post-contest-dependency-remediation\\\",\\n  \\\"worktree\\\": \\\"/home/mike/nexus-wt/post-contest-dependency-remediation\\\",\\n  \\\"base\\\": \\\"29eab4cd58051a8210b5ef66e0c9e248b2046a13\\\",\\n  \\\"since\\\": \\\"2026-10-24T19:31:26.132608Z\\\",\\n  \\\"scope\\\": \\\"Trusted broker bundle package.json only for patched dependency overrides.\\\",\\n  \\\"head\\\": \\\"62bf74e4b37c5a8f1a4be33c208d72dc9e15ec4e\\\",\\n  \\\"updated_at\\\": \\\"2026-10-24T19:36:11.978863Z\\\"\\n}\\n cli/src/startup_trust.ts                 |  3 ++\\n cli/test/startup_unreachable_e2e.test.ts | 69 ++++++++++++++++++++++++++++++++\\n 2 files changed, 72 insertions(+)\\ndiff --git a/cli/src/startup_trust.ts b/cli/src/startup_trust.ts\\nindex dc7d2bf..c0d659f 100644\\n--- a/cli/src/startup_trust.ts\\n+++ b/cli/src/startup_trust.ts\\n@@ -151,6 +151,9 @@ export function promptWorkspaceTrust(\\n       input.removeListener(\\\"keypress\\\", onKeypress);\\n       input.removeListener(\\\"close\\\", onClose);\\n       try { input.setRawMode(oldRawMode); } catch {}\\n+      if (decision === \\\"exit\\\") {\\n+        try { input.pause(); } catch {}\\n+      }\\n       output.write(\\\"\\\\u001b[?25h\\\\n\\\");\\n       resolve(decision);\\n     };\\ndiff --git a/cli/test/startup_unreachable_e2e.test.ts b/cli/test/startup_unreachable_e2e.test.ts\\nindex 3623d3f..aa2f838 100644\\n--- a/cli/test/startup_unreachable_e2e.test.ts\\n+++ b/cli/test/startup_unreachable_e2e.test.ts\\n@@ -29,6 +29,75 @@ const here = path.dirname(fileURLToPath(import.meta.url));\\n const INDEX = path.resolve(here, \\\"../dist/index.js\\\");\\n \\n describe(\\\"ACC-INF-07 (REQ-TUI-105): Startup endpoint probe and first-contact deadline\\\", () => {\\n+  ptyTest(\\\"startup trust Escape exits the CLI process promptly\\\", { timeout: 30_000 }, async () => {\\n+    assert.ok(fs.existsSync(INDEX), `missing ${INDEX} (run npm --prefix cli run build)`);\\n+    const repo = makeRepo();\\n+    const home = makeHome();\\n+    const pyScript = `\\n+import os, pty, select, subprocess, sys, time, json\\n+\\n+master, slave = pty.openpty()\\n+env = os.environ.copy()\\n+env[\\\"HOME\\\"] = ${JSON.stringify(home)}\\n+env[\\\"XDG_CONFIG_HOME\\\"] = ${JSON.stringify(path.join(home, \\\".config\\\"))}\\n+proc = subprocess.Popen(\\n+    [${JSON.stringify(process.execPath)}, ${JSON.stringify(INDEX)}, \\\"repl\\\", \\\"--yes\\\", \\\"-w\\\", ${JSON.stringify(repo)}],\\n+    stdin=slave, stdout=slave, stderr=slave, env=env, close_fds=True\\n+)\\n+os.close(slave)\\n+\\n+buf = \\\"\\\"\\n+def read_until(substr, timeout):\\n+    global buf\\n+    deadline = time.time() + timeout\\n+    while time.time() < deadline and substr not in buf:\\n+        ready, _, _ = select.select([master], [], [], 0.1)\\n+        if ready:\\n+            try:\\n+                data = os.read(master, 4096).decode(\\\"utf-8\\\", errors=\\\"replace\\\")\\n+                if not data:\\n+                    break\\n+                buf += data\\n+            except OSError:\\n+                break\\n+    return substr in buf\\n+\\n+prompted = read_until(\\\"Trust this folder?\\\", 10.0)\\n+if prompted:\\n+    os.write(master, b\\\"\\\\\\\\x1b\\\")\\n+try:\\n+    code = proc.wait(timeout=4.0)\\n+except subprocess.TimeoutExpired:\\n+    code = None\\n+    proc.terminate()\\n+    try:\\n+        proc.wait(timeout=2.0)\\n+    except subprocess.TimeoutExpired:\\n+        proc.kill()\\n+        proc.wait()\\n+os.close(master)\\n+print(json.dumps({\\\"prompted\\\": prompted, \\\"exited\\\": code is not None, \\\"code\\\": code, \\\"output\\\": buf[-1000:]}))\\n+`;\\n+    try {\\n+      const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\\n+        const child = spawn(\\\"python3\\\", [\\\"-c\\\", pyScript], { stdio: [\\\"ignore\\\", \\\"pipe\\\", \\\"pipe\\\"] });\\n+        let out = \\\"\\\";\\n+        let err = \\\"\\\";\\n+        child.stdout.on(\\\"data\\\", (chunk) => (out += chunk));\\n+        child.stderr.on(\\\"data\\\", (chunk) => (err += chunk));\\n+        child.on(\\\"close\\\", (exitCode) => resolve({ code: exitCode, out, err }));\\n+      });\\n+      assert.equal(code, 0, `PTY script failed: ${err}\\\\n${out}`);\\n+      const result = JSON.parse(out.trim().split(\\\"\\\\n\\\").pop() || \\\"{}\\\");\\n+      assert.equal(result.prompted, true, `startup trust prompt did not appear:\\\\n${result.output}`);\\n+      assert.equal(result.exited, true, `CLI stayed alive after trust prompt exit:\\\\n${result.output}`);\\n+      assert.equal(result.code, 0, `CLI exit should be clean:\\\\n${result.output}`);\\n+    } finally {\\n+      fs.rmSync(repo, { recursive: true, force: true });\\n+      fs.rmSync(home, { recursive: true, force: true });\\n+    }\\n+  });\\n+\\n   test(\\\"SidecarServer.start() probes unreachable endpoint (127.0.0.1:9) and emits notice with URL and fix hint\\\", async () => {\\n     const repo = makeRepo();\\n     const home = makeHome();\\n\"}]"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17095-f2fe-7de0-b5cc-460661bc1fe3","create_time":1792891876.5497253}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
