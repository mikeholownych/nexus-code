ws: ACCEPT.\\n\\nNo full local suite was run; exact-head CI is required before merge.\\n\",\"headRefOid\":\"9a27e194050aa8089de4fe28537e5f8e564b7452\",\"mergeStateStatus\":\"BLOCKED\",\"reviewDecision\":\"\",\"title\":\"fix: gate and cancel TUI verifier runs\"}\n","exit_code":0,"duration":{"secs":1,"nanos":391194367}},"started_at_ms":1792893303419,"completed_at_ms":1792893304811}}
