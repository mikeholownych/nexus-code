{"timestamp":"2026-10-25T01:00:19.878Z","ordinal":316470,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a1703b-4280-7320-9374-5c397c112b4d","item":{"type":"CommandExecution","id":"exec-10f94bac-57ce-4acc-9d00-554845cd826d","process_id":"55117","command":["/usr/bin/zsh","-lc","sed -n '95,170p' cli/test/repro_identity.test.ts"],"cwd":"file:///home/mike/nexus-wt/plan-09-packaging-tar-repro","parsed_cmd":[{"type":"read","cmd":"sed -n '95,170p' cli/test/repro_identity.test.ts","name":"repro_identity.test.ts","path":"cli/test/repro_identity.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    assert.match(invalidWorkflowCommit.stderr, /usage: compare/);\n  } finally {\n    fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"repro record binds the checked-out commit to the fetched tag's peeled commit\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"repro-record-tag-\"));\n  const git = (...args: string[]) => {\n    const result = spawnSync(\"git\", args, { cwd: dir, encoding: \"utf8\" });\n    assert.equal(result.status, 0, result.stderr);\n    return result.stdout.trim();\n  };\n  try {\n    fs.mkdirSync(path.join(dir, \"bin\"));\n    for (const [name, output] of [[\"npm\", \"10.0.0\"], [\"rustc\", \"rustc 1.95.0\"], [\"cargo\", \"cargo 1.95.0\"]]) {\n      const tool = path.join(dir, \"bin\", name);\n      fs.writeFileSync(tool, `#!/bin/sh\\nprintf '%s\\\\n' '${output}'\\n`);\n      fs.chmodSync(tool, 0o755);\n    }\n    git(\"init\", \"--quiet\");\n    git(\"config\", \"user.name\", \"Repro fixture\");\n    git(\"config\", \"user.email\", \"repro-fixture@example.invalid\");\n    for (const file of [\"cli/package-lock.json\", \"core/Cargo.lock\", \"rust-toolchain.toml\", \"scripts/release-tools/package-lock.json\"]) {\n      fs.mkdirSync(path.dirname(path.join(dir, file)), { recursive: true });\n      fs.writeFileSync(path.join(dir, file), \"fixture\\n\");\n    }\n    fs.writeFileSync(path.join(dir, \"source.txt\"), \"source\\n\");\n    const packageScript = path.join(dir, \"scripts\", \"package-linux.sh\");\n    fs.mkdirSync(path.dirname(packageScript));\n    fs.writeFileSync(packageScript, \"#!/bin/sh\\nprintf package\\n\");\n    git(\"add\", \".\");\n    git(\"commit\", \"--quiet\", \"-m\", \"source fixture\");\n    const sourceCommit = git(\"rev-parse\", \"HEAD\");\n    git(\"tag\", \"v1.0.0-rc.1\");\n    const dist = path.join(dir, \"dist\");\n    fs.mkdirSync(dist);\n    for (const name of [\"nexus-linux-x86_64-v1.0.0-rc.1.tar.gz\", \"compatibility.json\", \"SHA256SUMS\", \"THIRD_PARTY_NOTICES.txt\", \"sbom.cdx.json\", \"install.sh\"]) {\n      fs.writeFileSync(path.join(dist, name), `${name}\\n`);\n    }\n    const env = {\n      ...process.env,\n      PATH: `${path.join(dir, \"bin\")}:${process.env.PATH ?? \"\"}`,\n      GITHUB_REF: \"refs/heads/main\",\n      GITHUB_WORKFLOW_SHA: sourceCommit,\n      NEXUS_PACKAGE_TOOL_COMMIT: sourceCommit,\n      NEXUS_PACKAGE_TOOL_SCRIPT: packageScript,\n      GITHUB_RUN_ID: \"42\",\n      GITHUB_RUN_ATTEMPT: \"1\",\n      NEXUS_BUILD_CONTAINER_IMAGE: APPROVED_RUST_IMAGE,\n    };\n    const out = path.join(dir, \"identity.json\");\n    const record = () => spawnSync(process.execPath, [SCRIPT, \"record\", \"v1.0.0-rc.1\", dist, out, \"ubuntu-22.04\"], { cwd: dir, env, encoding: \"utf8\" });\n    const valid = record();\n    assert.equal(valid.status, 0, valid.stderr);\n    const identityRecord = JSON.parse(fs.readFileSync(out, \"utf8\"));\n    assert.equal(identityRecord.source.commit, sourceCommit);\n    assert.equal(identityRecord.source.tagCommit, sourceCommit);\n    assert.equal(identityRecord.workflow.sha, sourceCommit);\n    assert.equal(identityRecord.packagingTool.commit, sourceCommit);\n    assert.equal(identityRecord.packagingTool.packageScriptSha256, createHash(\"sha256\").update(fs.readFileSync(packageScript)).digest(\"hex\"));\n\n    git(\"commit\", \"--quiet\", \"--allow-empty\", \"-m\", \"different tag target\");\n    const movedTagCommit = git(\"rev-parse\", \"HEAD\");\n    git(\"checkout\", \"--quiet\", sourceCommit);\n    git(\"update-ref\", \"refs/tags/v1.0.0-rc.1\", movedTagCommit);\n    const moved = record();\n    assert.notEqual(moved.status, 0);\n    assert.match(moved.stderr, /resolves to .* not checked-out source commit/);\n  } finally {\n    fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"Linux packaging rejects an omitted pinned builder unless host builds are explicitly opted into\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"package-builder-guard-\"));\n","exit_code":0,"duration":{"secs":1,"nanos":90595653}},"started_at_ms":1792890018786,"completed_at_ms":1792890019877}}
{"timestamp":"2026-10-25T01:00:21.050Z","ordinal":316471,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17092-a4ba-76f2-9e0b-47959376a2be","call_id":"call_5398dcf962f64437b8c2f73632278ccd","output":[{"type":"input_text","text":"Script completed\nWall time 3.6 seconds\nOutput:\n"},{"type":"input_text","text":"    assert.match(invalidWorkflowCommit.stderr, /usage: compare/);\n  } finally {\n    fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"repro record binds the checked-out commit to the fetched tag's peeled commit\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"repro-record-tag-\"));\n  const git = (...args: string[]) => {\n    const result = spawnSync(\"git\", args, { cwd: dir, encoding: \"utf8\" });\n    assert.equal(result.status, 0, result.stderr);\n    return result.stdout.trim();\n  };\n  try {\n    fs.mkdirSync(path.join(dir, \"bin\"));\n    for (const [name, output] of [[\"npm\", \"10.0.0\"], [\"rustc\", \"rustc 1.95.0\"], [\"cargo\", \"cargo 1.95.0\"]]) {\n      const tool = path.join(dir, \"bin\", name);\n      fs.writeFileSync(tool, `#!/bin/sh\\nprintf '%s\\\\n' '${output}'\\n`);\n      fs.chmodSync(tool, 0o755);\n    }\n    git(\"init\", \"--quiet\");\n    git(\"config\", \"user.name\", \"Repro fixture\");\n    git(\"config\", \"user.email\", \"repro-fixture@example.invalid\");\n    for (const file of [\"cli/package-lock.json\", \"core/Cargo.lock\", \"rust-toolchain.toml\", \"scripts/release-tools/package-lock.json\"]) {\n      fs.mkdirSync(path.dirname(path.join(dir, file)), { recursive: true });\n      fs.writeFileSync(path.join(dir, file), \"fixture\\n\");\n    }\n    fs.writeFileSync(path.join(dir, \"source.txt\"), \"source\\n\");\n    const packageScript = path.join(dir, \"scripts\", \"package-linux.sh\");\n    fs.mkdirSync(path.dirname(packageScript));\n    fs.writeFileSync(packageScript, \"#!/bin/sh\\nprintf package\\n\");\n    git(\"add\", \".\");\n    git(\"commit\", \"--quiet\", \"-m\", \"source fixture\");\n    const sourceCommit = git(\"rev-parse\", \"HEAD\");\n    git(\"tag\", \"v1.0.0-rc.1\");\n    const dist = path.join(dir, \"dist\");\n    fs.mkdirSync(dist);\n    for (const name of [\"nexus-linux-x86_64-v1.0.0-rc.1.tar.gz\", \"compatibility.json\", \"SHA256SUMS\", \"THIRD_PARTY_NOTICES.txt\", \"sbom.cdx.json\", \"install.sh\"]) {\n      fs.writeFileSync(path.join(dist, name), `${name}\\n`);\n    }\n    const env = {\n      ...process.env,\n      PATH: `${path.join(dir, \"bin\")}:${process.env.PATH ?? \"\"}`,\n      GITHUB_REF: \"refs/heads/main\",\n      GITHUB_WORKFLOW_SHA: sourceCommit,\n      NEXUS_PACKAGE_TOOL_COMMIT: sourceCommit,\n      NEXUS_PACKAGE_TOOL_SCRIPT: packageScript,\n      GITHUB_RUN_ID: \"42\",\n      GITHUB_RUN_ATTEMPT: \"1\",\n      NEXUS_BUILD_CONTAINER_IMAGE: APPROVED_RUST_IMAGE,\n    };\n    const out = path.join(dir, \"identity.json\");\n    const record = () => spawnSync(process.execPath, [SCRIPT, \"record\", \"v1.0.0-rc.1\", dist, out, \"ubuntu-22.04\"], { cwd: dir, env, encoding: \"utf8\" });\n    const valid = record();\n    assert.equal(valid.status, 0, valid.stderr);\n    const identityRecord = JSON.parse(fs.readFileSync(out, \"utf8\"));\n    assert.equal(identityRecord.source.commit, sourceCommit);\n    assert.equal(identityRecord.source.tagCommit, sourceCommit);\n    assert.equal(identityRecord.workflow.sha, sourceCommit);\n    assert.equal(identityRecord.packagingTool.commit, sourceCommit);\n    assert.equal(identityRecord.packagingTool.packageScriptSha256, createHash(\"sha256\").update(fs.readFileSync(packageScript)).digest(\"hex\"));\n\n    git(\"commit\", \"--quiet\", \"--allow-empty\", \"-m\", \"different tag target\");\n    const movedTagCommit = git(\"rev-parse\", \"HEAD\");\n    git(\"checkout\", \"--quiet\", sourceCommit);\n    git(\"update-ref\", \"refs/tags/v1.0.0-rc.1\", movedTagCommit);\n    const moved = record();\n    assert.notEqual(moved.status, 0);\n    assert.match(moved.stderr, /resolves to .* not checked-out source commit/);\n  } finally {\n    fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"Linux packaging rejects an omitted pinned builder unless host builds are explicitly opted into\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"package-builder-guard-\"));\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1703b-4280-7320-9374-5c397c112b4d","create_time":1792890021.0501006}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
