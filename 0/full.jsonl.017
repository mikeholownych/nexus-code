n\\\":\\\"\\\",\\\"title\\\":\\\"build(deps-dev): bump @cloudflare/vite-plugin from 2.0.0-beta.sha-52b0dc0e9 to 2.0.0-beta.v.1 in /experiments/cloudflare-artifacts-vertical-slice/fork-worker\\\",\\\"url\\\":\\\"https://github.com/mikeholownych/nexus-code/pull/117\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"dependabot/npm_and_yarn/experiments/cloudflare-artifacts-vertical-slice/cf-1.0.0-beta.18\\\",\\\"headRefOid\\\":\\\"8dfdba0a63f363364a2c9f19deacf5c8b814d2b7\\\",\\\"mergeStateStatus\\\":\\\"UNKNOWN\\\",\\\"number\\\":116,\\\"reviewDecision\\\":\\\"\\\",\\\"title\\\":\\\"build(deps-dev): bump cf from 1.0.0-beta.10 to 1.0.0-beta.18 in /experiments/cloudflare-artifacts-vertical-slice\\\",\\\"url\\\":\\\"https://github.com/mikeholownych/nexus-code/pull/116\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"dependabot/npm_and_yarn/experiments/cloudflare-artifacts-vertical-slice/agent-collab-worker/cloudflare/vite-plugin-2.0.0-beta.v.1\\\",\\\"headRefOid\\\":\\\"4e0aeb140f4e9c20aea4443768bc106e88593130\\\",\\\"mergeStateStatus\\\":\\\"UNKNOWN\\\",\\\"number\\\":115,\\\"reviewDecision\\\":\\\"\\\",\\\"title\\\":\\\"build(deps-dev): bump @cloudflare/vite-plugin from 2.0.0-beta.sha-52b0dc0e9 to 2.0.0-beta.v.1 in /experiments/cloudflare-artifacts-vertical-slice/agent-collab-worker\\\",\\\"url\\\":\\\"https://github.com/mikeholownych/nexus-code/pull/115\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"dependabot/npm_and_yarn/cli/commander-15.0.0\\\",\\\"headRefOid\\\":\\\"e0b5db3201eff965b7e9d31d13b9bc72e8317dbb\\\",\\\"mergeStateStatus\\\":\\\"UNKNOWN\\\",\\\"number\\\":114,\\\"reviewDecision\\\":\\\"\\\",\\\"title\\\":\\\"chore(deps): bump commander from 12.1.0 to 15.0.0 in /cli\\\",\\\"url\\\":\\\"https://github.com/mikeholownych/nexus-code/pull/114\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"dependabot/cargo/core/serde_json-1.0.154\\\",\\\"headRefOid\\\":\\\"b11ec547a7ae9f44f51f9699d0619426a603f89e\\\",\\\"mergeStateStatus\\\":\\\"UNKNOWN\\\",\\\"number\\\":113,\\\"reviewDecision\\\":\\\"\\\",\\\"title\\\":\\\"build(deps): bump serde_json from 1.0.151 to 1.0.154 in /core\\\",\\\"url\\\":\\\"https://github.com/mikeholownych/nexus-code/pull/113\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"dependabot/github_actions/actions/setup-node-7.1.0\\\",\\\"headRefOid\\\":\\\"dae77e4ecc23468facad0bb1bb3f1442b75055d6\\\",\\\"mergeStateStatus\\\":\\\"UNKNOWN\\\",\\\"number\\\":112,\\\"reviewDecision\\\":\\\"\\\",\\\"title\\\":\\\"build(deps): bump actions/setup-node from 4.4.0 to 7.1.0\\\",\\\"url\\\":\\\"https://github.com/mikeholownych/nexus-code/pull/112\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"dependabot/npm_and_yarn/cli/dotenv-18.0.8\\\",\\\"headRefOid\\\":\\\"bb8f56e4f6343ebee54ab79ba73975e4062ba46f\\\",\\\"mergeStateStatus\\\":\\\"UNKNOWN\\\",\\\"number\\\":111,\\\"reviewDecision\\\":\\\"\\\",\\\"title\\\":\\\"build(deps): bump dotenv from 16.6.1 to 18.0.8 in /cli\\\",\\\"url\\\":\\\"https://github.com/mikeholownych/nexus-code/pull/111\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"dependabot/cargo/core/libc-0.2.191\\\",\\\"headRefOid\\\":\\\"d70302124870dae35a4e33bfa536f782bc174cde\\\",\\\"mergeStateStatus\\\":\\\"UNKNOWN\\\",\\\"number\\\":110,\\\"reviewDecision\\\":\\\"\\\",\\\"title\\\":\\\"chore(deps): bump libc from 0.2.189 to 0.2.191 in /core\\\",\\\"url\\\":\\\"https://github.com/mikeholownych/nexus-code/pull/110\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"dependabot/npm_and_yarn/experiments/cloudflare-artifacts-vertical-slice/trusted-broker-bundle/cf-1.0.0-beta.18\\\",\\\"headRefOid\\\":\\\"57fc446983675d78d89fa391153ead02071e4ba7\\\",\\\"mergeStateStatus\\\":\\\"UNKNOWN\\\",\\\"number\\\":109,\\\"reviewDecision\\\":\\\"\\\",\\\"title\\\":\\\"build(deps): bump cf from 1.0.0-beta.10 to 1.0.0-beta.18 in /experiments/cloudflare-artifacts-vertical-slice/trusted-broker-bundle\\\",\\\"url\\\":\\\"htt