{"timestamp":"2026-10-24T23:32:37.169Z","ordinal":313879,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a1703b-4280-7320-9374-5c397c112b4d","item":{"type":"CommandExecution","id":"exec-3a25d804-6908-4139-afe0-b88a630387fe","process_id":"58118","command":["/usr/bin/zsh","-lc","sed -n '1,240p' cli/test/tui_approval_input_e2e.test.ts; sed -n '1,220p' cli/test/repl_approval_e2e.test.ts; sed -n '1,240p' cli/test/verifier_gating.test.ts; sed -n '1,220p' cli/test/startup_trust_prompt.test.ts"],"cwd":"file:///home/mike/nexus-wt/startup-trust-main-check","parsed_cmd":[{"type":"read","cmd":"sed -n '1,240p' cli/test/tui_approval_input_e2e.test.ts","name":"tui_approval_input_e2e.test.ts","path":"cli/test/tui_approval_input_e2e.test.ts"},{"type":"read","cmd":"sed -n '1,220p' cli/test/repl_approval_e2e.test.ts","name":"repl_approval_e2e.test.ts","path":"cli/test/repl_approval_e2e.test.ts"},{"type":"read","cmd":"sed -n '1,240p' cli/test/verifier_gating.test.ts","name":"verifier_gating.test.ts","path":"cli/test/verifier_gating.test.ts"},{"type":"read","cmd":"sed -n '1,220p' cli/test/startup_trust_prompt.test.ts","name":"startup_trust_prompt.test.ts","path":"cli/test/startup_trust_prompt.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * Approval input safety through the real TUI and sidecar in a pseudo-terminal (review mode): keys queued while the\n * panel was not yet on screen, a delayed burst, and a bracketed paste never decide an approval; one deliberate key\n * does. See helpers/tui_approval_driver.py for the sequence.\n */\n\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, makeRepo, makeHome, Reply, ptyTest } from \"./helpers/fixtures.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"../..\");\nconst TUI = path.join(ROOT, \"core/target/release/nexus-tui\");\nconst SIDECAR = path.join(ROOT, \"cli/dist/sidecar.js\");\n\nfunction script(_n: number, body: any): Reply {\n  const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n  if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"first.txt\", content: \"one\\n\" } }], delayMs: 800 };\n  if (tools === 1) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"second.txt\", content: \"two\\n\" } }] };\n  // The third approval appears while the operator is still typing.\n  if (tools === 2) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"third.txt\", content: \"three\\n\" } }], delayMs: 1200 };\n  return { kind: \"text\", content: \"Done.\" };\n}\n\nptyTest(\"queued keys, bursts and pastes never answer an approval; one deliberate key does\", { timeout: 120_000 }, async () => {\n  for (const p of [TUI, SIDECAR]) assert.ok(fs.existsSync(p), `missing ${p} (run make build)`);\n  const gw = await startGateway(script);\n  const repo = makeRepo();\n  const home = makeHome();\n  const logs = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-tui-approval-\"));\n  const plan = {\n    tui: TUI,\n    recorder: path.join(here, \"helpers/sidecar_recorder.mjs\"),\n    node: process.execPath,\n    sidecar_args: [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\", \"--approve\"],\n    env: {\n      HOME: home,\n      TERM: \"xterm-256color\",\n      COLORTERM: \"truecolor\",\n      NEXUS_DEBUG: \"0\",\n      NEXUS_RECORD_SIDECAR: SIDECAR,\n      NEXUS_RECORD_COMMANDS: path.join(logs, \"commands.ndjson\"),\n      NEXUS_RECORD_EVENTS: path.join(logs, \"events.ndjson\"),\n    },\n  };\n  const planFile = path.join(logs, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [path.join(here, \"helpers/tui_approval_driver.py\"), planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    assert.equal(code, 0, `driver failed:\\n${err}\\n${out.slice(-2000)}`);\n    const r = JSON.parse(out.trim().split(\"\\n\").pop()!);\n    assert.ok(r.approval_arrived_while_frozen, \"the approval arrived while the TUI was frozen\");\n    assert.deepEqual(r.after_queued_keys, { decisions: [], panel_open: true }, \"keys queued before the panel was on screen did not decide\");\n    assert.deepEqual(r.after_burst, { decisions: [], panel_open: true }, \"a burst did not decide\");\n    assert.deepEqual(r.after_paste, { decisions: [], panel_open: true }, \"a paste did not decide\");\n    assert.deepEqual(r.n_after_typing, [], \"after typing into the panel, a letter is text\");\n    assert.deepEqual(r.after_deny, [\"deny\"], \"Esc denied\");\n    assert.deepEqual(r.after_approve, [\"deny\", \"approve\"], \"one deliberate key approved\");\n    assert.deepEqual(r.after_typing_across, { decisions: [\"deny\", \"approve\"], panel_open: true }, \"typing across the panel's appearance decided nothing\");\n    assert.deepEqual(r.n_after_typing_across, [\"deny\", \"approve\"], \"after typing across the panel, a letter is text even after a pause\");\n    assert.deepEqual(r.after_typing_then_deny, [\"deny\", \"approve\", \"deny\"], \"Esc then denies\");\n    assert.ok(!fs.existsSync(path.join(repo, \"third.txt\")), \"the write proposed during typing did not happen\");\n    // Input typed into the frozen terminal is either discarded (the approval event reached the TUI first) or, when it\n    // is read before the event (the sidecar reader thread was frozen too), goes where typing goes while the agent\n    // works: steering, shown in the transcript. Either way it never decides.\n    const commands = fs.readFileSync(plan.env.NEXUS_RECORD_COMMANDS, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    assert.ok(commands.filter((c) => c.type === \"steer\").every((c) => c.text === \"y\"), JSON.stringify(commands));\n    assert.deepEqual(commands.filter((c) => c.type === \"approve\" || c.type === \"deny\").map((c) => c.id), [\"approval-1\", \"approval-2\", \"approval-3\"]);\n    assert.ok(!fs.existsSync(path.join(repo, \"first.txt\")), \"the denied write did not happen\");\n    assert.equal(fs.readFileSync(path.join(repo, \"second.txt\"), \"utf8\"), \"two\\n\", \"the approved write happened\");\n  } finally {\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(home, { recursive: true, force: true });\n  }\n});\n\nfunction typingScript(_n: number, body: any): Reply {\n  const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n  if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"first.txt\", content: \"one\\n\" } }], delayMs: 1200 };\n  return { kind: \"text\", content: \"Done.\" };\n}\n\nptyTest(\"typing with thinking pauses and a final Enter across the approval panel never decides; Esc then denies\", { timeout: 120_000 }, async () => {\n  const gw = await startGateway(typingScript);\n  const repo = makeRepo();\n  const home = makeHome();\n  const logs = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-tui-approval-typing-\"));\n  const plan = {\n    tui: TUI,\n    recorder: path.join(here, \"helpers/sidecar_recorder.mjs\"),\n    node: process.execPath,\n    sidecar_args: [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\", \"--approve\"],\n    env: {\n      HOME: home,\n      TERM: \"xterm-256color\",\n      COLORTERM: \"truecolor\",\n      NEXUS_DEBUG: \"0\",\n      NEXUS_RECORD_SIDECAR: SIDECAR,\n      NEXUS_RECORD_COMMANDS: path.join(logs, \"commands.ndjson\"),\n      NEXUS_RECORD_EVENTS: path.join(logs, \"events.ndjson\"),\n    },\n  };\n  const planFile = path.join(logs, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [path.join(here, \"helpers/tui_approval_typing_driver.py\"), planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    assert.equal(code, 0, `driver failed:\\n${err}\\n${out.slice(-2000)}`);\n    const r = JSON.parse(out.trim().split(\"\\n\").pop()!);\n    assert.ok(r.approval_arrived && r.panel_seen_while_typing, JSON.stringify(r));\n    assert.deepEqual(r.after_typing, { decisions: [], panel_open: true }, \"typing with pauses decided nothing\");\n    assert.match(r.hint, /typing ignored/, \"the panel says letters are not answers now\");\n    assert.deepEqual(r.after_editing_keys, { decisions: [], panel_open: true }, \"→ → Enter, Ctrl+A Enter, and → → (pause) Enter (pause) Enter decided nothing\");\n    assert.deepEqual(r.after_esc, [\"deny\"], \"a deliberate Esc denies\");\n    const events = fs.readFileSync(plan.env.NEXUS_RECORD_EVENTS, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    assert.ok(events.filter((e) => e.type === \"session.state\").every((e) => e.mode === \"review\"), \"review mode was never switched off\");\n    assert.ok(!fs.existsSync(path.join(repo, \"first.txt\")), \"nothing was written\");\n  } finally {\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(home, { recursive: true, force: true });\n  }\n});\n/**\n * ACC-SAFE-03 & ACC-SAFE-08: REPL approval hardening e2e in a real pseudo-terminal (PTY).\n *\n * Verifies:\n * 1. Lone Enter at approval prompt -> DENIED (returns false, file not written)\n * 2. Keystrokes typed ahead before approval prompt -> cleared with Ctrl-U and line buffer reset, DENIED\n * 3. Paste within the 400ms grace window -> discarded, not approved\n * 4. Deliberate 'y' after 500ms -> APPROVED (action executed)\n * 5. 'a' (always allow session) requires explicit confirmation typing 'all';\n *    unconfirmed cancels and reprompts, confirmed switches session to auto-approve.\n */\n\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, makeRepo, makeHome, trustWorkspace, Reply, ptyTest } from \"./helpers/fixtures.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"..\");\nconst INDEX = path.join(ROOT, \"dist/index.js\");\nconst DRIVER = path.join(here, \"helpers/repl_approval_driver.py\");\n\nfunction script(_n: number, body: any): Reply {\n  const messages: any[] = body?.messages ?? [];\n  let lastUserIdx = -1;\n  let filename = \"target.txt\";\n\n  for (let i = messages.length - 1; i >= 0; i--) {\n    if (messages[i].role === \"user\") {\n      lastUserIdx = i;\n      const text = typeof messages[i].content === \"string\" ? messages[i].content : \"\";\n      const m = text.match(/create\\s+([a-zA-Z0-9_\\-\\.]+)/i);\n      if (m) filename = m[1];\n      break;\n    }\n  }\n\n  const toolsSinceUser = lastUserIdx >= 0\n    ? messages.slice(lastUserIdx).filter((m) => m.role === \"tool\").length\n    : 0;\n\n  if (toolsSinceUser === 0) {\n    return {\n      kind: \"tools\",\n      calls: [{ name: \"write_file\", args: { path: filename, content: `content for ${filename}\\n` } }],\n      delayMs: 500, // delay allows typed-ahead input to land mid-turn\n    };\n  }\n  return { kind: \"text\", content: `Finished handling ${filename}.` };\n}\n\nasync function runScenario(scenario: string): Promise<any> {\n  const repo = makeRepo();\n  const home = makeHome();\n  trustWorkspace(home, repo);\n  const gw = await startGateway(script);\n  const plan = {\n    node: process.execPath,\n    index: INDEX,\n    args: [\"repl\", \"--approve\", \"-w\", repo, \"-e\", gw.url, \"-m\", \"m\"],\n    ws: repo,\n    home,\n    scenario,\n    env: {\n      HOME: home,\n      NEXUS_DEBUG: \"0\",\n    },\n  };\n  const planFile = path.join(home, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n\n  let driverShutdownConfirmed = false;\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [DRIVER, planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    // The driver exits successfully only after its finally block confirms that\n    // the PTY process group has stopped. Preserve the fixture on every other\n    // exit so a surviving child cannot write into a HOME being removed here.\n    driverShutdownConfirmed = code === 0;\n    assert.equal(code, 0, `driver failed for scenario '${scenario}':\\n${err}\\n${out}`);\n    const lastLine = out.trim().split(\"\\n\").pop() || \"{}\";\n    return JSON.parse(lastLine);\n  } finally {\n    await gw.close();\n    if (driverShutdownConfirmed) {\n      fs.rmSync(repo, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n    }\n  }\n}\n\nptyTest(\"REPL approval hardening (ACC-SAFE-03): lone Enter, typed-ahead, paste, deliberate approval, and session confirmation\", { timeout: 180_000 }, async () => {\n  assert.ok(fs.existsSync(INDEX), `missing ${INDEX} (run npm run build)`);\n  assert.ok(fs.existsSync(DRIVER), `missing ${DRIVER}`);\n\n  // 1. Lone Enter -> DENIED\n  const r1 = await runScenario(\"lone_enter\");\n  assert.equal(r1.file_created, false, \"lone Enter must NOT approve the action\");\n  assert.equal(r1.passed, true);\n\n  // 2. Typed ahead mid-turn -> DISCARDED & DENIED\n  const r2 = await runScenario(\"typed_ahead\");\n  assert.equal(r2.file_created, false, \"typed-ahead input must be discarded and NOT approve\");\n  assert.equal(r2.passed, true);\n\n  // 3. Paste during grace window -> DISCARDED & NOT APPROVED\n  const r3 = await runScenario(\"paste\");\n  assert.equal(r3.created_during_grace, false, \"burst/paste during grace window must NOT approve\");\n  assert.equal(r3.created_after_deny, false);\n  assert.equal(r3.passed, true);\n\n  // 4. Deliberate 'y' after grace window -> APPROVED\n  const r4 = await runScenario(\"deliberate\");\n  assert.equal(r4.file_created, true, \"deliberate 'y' after grace window MUST approve\");\n  assert.equal(r4.passed, true);\n\n  // 5. 'a' confirmation: unconfirmed cancels, 'all' enables auto-mode\n  const r5 = await runScenario(\"confirm_a\");\n  assert.equal(r5.auto1_cancelled, true, \"unconfirmed 'a' must cancel auto-approval\");\n  assert.equal(r5.auto1_created, true, \"confirmed 'a' with 'all' must approve initial action\");\n  assert.equal(r5.auto2_created, true, \"subsequent actions must run in auto mode without prompt\");\n  assert.equal(r5.passed, true);\n});\n/**\n * SPEC-01 §3 rule 8 & ACC-SAFE-09: Verifier executions that Nexus initiates itself\n * (change baseline, completion oracle, independence copy, /test) are exec-class actions.\n * - In review mode, the first verifier run requires a one-time approval with command and script body.\n * - Explicit auto mode runs without asking regardless of workspace trust.\n * - Approvals are cached per (workspace, command, digest) for the session.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execSync } from \"node:child_process\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { isWorkspaceTrusted, setWorkspaceTrusted } from \"../src/workspace_trust.js\";\nimport { describeVerifier } from \"../src/tester.js\";\nimport { startGateway } from \"./helpers/provider_fixture.js\";\n\nfunction setupRepo(name: string): { ws: string; sentinelPath: string } {\n  const ws = fs.mkdtempSync(path.join(os.tmpdir(), `nexus-vg-${name}-`));\n  const sentinelPath = path.join(ws, \"sentinel.txt\");\n  const testScript = `const fs = require('fs'); fs.writeFileSync(${JSON.stringify(sentinelPath)}, 'ok');`;\n  fs.writeFileSync(path.join(ws, \"test.js\"), testScript);\n  fs.writeFileSync(\n    path.join(ws, \"package.json\"),\n    JSON.stringify(\n      {\n        name: \"vg-fixture\",\n        scripts: {\n          test: \"node test.js\",\n        },\n      },\n      null,\n      2,\n    ),\n  );\n  fs.writeFileSync(path.join(ws, \"file.txt\"), \"hello\\n\");\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm init\", {\n    cwd: ws,\n    stdio: \"ignore\",\n  });\n  return { ws, sentinelPath };\n}\n\ndescribe(\"ACC-SAFE-09: Verifier Gating\", () => {\n  test(\"folder trust alone keeps an unset permission mode in review\", () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n    process.env.HOME = tempHome;\n\n    const { ws } = setupRepo(\"default-review-trusted\");\n    setWorkspaceTrusted(ws, true);\n    const agent = new AutonomousAgent({\n      endpoint: \"http://127.0.0.1:1/v1\",\n      model: \"m\",\n      workspace: ws,\n      shell: \"bash\",\n    } as any);\n\n    try {\n      assert.equal(isWorkspaceTrusted(ws), true, \"repo should be trusted\");\n      assert.equal(agent.getApprovalMode(), \"review\");\n    } finally {\n      agent.shutdown();\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(tempHome, { recursive: true, force: true });\n      process.env.HOME = savedHome;\n    }\n  });\n\n  test(\"describeVerifier extracts command, script body from package.json, and sha256 digest\", () => {\n    const { ws } = setupRepo(\"describe\");\n    try {\n      const desc = describeVerifier(ws);\n      assert.ok(desc, \"verifier should be discovered\");\n      assert.equal(desc.command, \"npm test\");\n      assert.equal(desc.script, \"node test.js\");\n      assert.equal(desc.evidence, \"package.json:scripts.test\");\n      assert.ok(/^[0-9a-f]{64}$/.test(desc.digest), `digest should be sha256 hex: ${desc.digest}`);\n    } finally {\n      fs.rmSync(ws, { recursive: true, force: true });\n    }\n  });\n\n  test(\"trusted and untrusted repos in review mode prompt for verifier and script body, write sentinel only after approval, and cache session decision\", async () => {\n    for (const trusted of [false, true]) {\n      const savedHome = process.env.HOME;\n      const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n      process.env.HOME = tempHome;\n\n      const { ws, sentinelPath } = setupRepo(`review-${trusted ? \"trusted\" : \"untrusted\"}`);\n      if (trusted) setWorkspaceTrusted(ws, true);\n      const replies = [\n        {\n          kind: \"tools\" as const,\n          calls: [{ name: \"edit_file\", args: { path: \"file.txt\", old_content: \"hello\\n\", new_content: \"world\\n\" } }],\n        },\n        {\n          kind: \"tools\" as const,\n          calls: [{ name: \"task_completed\", args: { summary: \"Finished editing file\" } }],\n        },\n        { kind: \"text\" as const, content: \"Done.\" },\n      ];\n      const gw = await startGateway((n) => replies[Math.min(n, replies.length) - 1]);\n      const agent = new AutonomousAgent({\n        endpoint: gw.url,\n        model: \"m\",\n        workspace: ws,\n        shell: \"bash\",\n        approvalMode: \"review\",\n      } as any);\n\n      const promptLog: Array<{ tool: string; args: any }> = [];\n      try {\n        assert.equal(isWorkspaceTrusted(ws), trusted, `repo trust should be ${trusted}`);\n\n        await agent.runTurn(\"make changes and finish\", async (tool, args) => {\n          promptLog.push({ tool, args });\n          if (tool === \"edit_file\") {\n            // Sentinel must NOT be written before verifier is approved!\n            assert.equal(fs.existsSync(sentinelPath), false, \"sentinel must not exist when edit_file is prompted\");\n            return true;\n          }\n          if (tool === \"verifier\") {\n            // Sentinel must NOT be written before operator confirms verifier!\n            assert.equal(fs.existsSync(sentinelPath), false, \"sentinel must not exist before verifier is confirmed\");\n            assert.equal(args.command, \"npm test\");\n            assert.equal(args.script, \"node test.js\");\n            assert.equal(args.detail, \"package.json:scripts.test\");\n            assert.ok(args.digest, \"digest must be provided\");\n            return true;\n          }\n          return true;\n        });\n\n        // Sentinel was written by the approved verifier execution!\n        assert.equal(fs.existsSync(sentinelPath), true, \"sentinel must be written after verifier was approved and executed\");\n\n        // Verifier should be prompted exactly once because session caching applies\n        const verifierPrompts = promptLog.filter((p) => p.tool === \"verifier\");\n        assert.equal(verifierPrompts.length, 1, \"verifier should only be prompted once during the session\");\n      } finally {\n        agent.shutdown();\n        await gw.close();\n        fs.rmSync(ws, { recursive: true, force: true });\n        fs.rmSync(tempHome, { recursive: true, force: true });\n        process.env.HOME = savedHome;\n      }\n    }\n  });\n\n  test(\"denied verifier does not execute verifier and sentinel is not written\", async () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n    process.env.HOME = tempHome;\n\n    const { ws, sentinelPath } = setupRepo(\"denied\");\n    const replies = [\n      {\n        kind: \"tools\" as const,\n        calls: [{ name: \"edit_file\", args: { path: \"file.txt\", old_content: \"hello\\n\", new_content: \"world\\n\" } }],\n      },\n      { kind: \"text\" as const, content: \"Done.\" },\n    ];\n    const gw = await startGateway((n) => replies[Math.min(n, replies.length) - 1]);\n    const agent = new AutonomousAgent({\n      endpoint: gw.url,\n      model: \"m\",\n      workspace: ws,\n      shell: \"bash\",\n      approvalMode: \"review\",\n    } as any);\n\n    try {\n      await agent.runTurn(\"make change\", async (tool) => {\n        if (tool === \"edit_file\") return true;\n        if (tool === \"verifier\") return false; // Reject verifier execution\n        return false;\n      });\n\n      assert.equal(fs.existsSync(sentinelPath), false, \"sentinel must NOT be written when verifier was denied\");\n      assert.equal(fs.readFileSync(path.join(ws, \"file.txt\"), \"utf-8\"), \"world\\n\", \"file edit still succeeded\");\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(tempHome, { recursive: true, force: true });\n      process.env.HOME = savedHome;\n    }\n  });\n\n  for (const trusted of [false, true]) {\n    test(`${trusted ? \"trusted\" : \"untrusted\"} repo in explicitly configured auto mode runs verifier without prompts`, async () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n    process.env.HOME = tempHome;\n\n    const { ws, sentinelPath } = setupRepo(`auto-${trusted ? \"trusted\" : \"untrusted\"}`);\n    if (trusted) setWorkspaceTrusted(ws, true);\n\n    const replies = [\n      {\n        kind: \"tools\" as const,\n        calls: [{ name: \"edit_file\", args: { path: \"file.txt\", old_content: \"hello\\n\", new_content: \"world\\n\" } }],\n      },\n      { kind: \"text\" as const, content: \"Done.\" },\n    ];\n    const gw = await startGateway((n) => replies[Math.min(n, replies.length) - 1]);\n    const agent = new AutonomousAgent({\n      endpoint: gw.url,\n      model: \"m\",\n      workspace: ws,\n      shell: \"bash\",\n      approvalMode: \"auto\",\n    } as any);\n\n    const promptLog: string[] = [];\n    try {\n      assert.equal(isWorkspaceTrusted(ws), trusted, `repo trust should be ${trusted}`);\n\n      await agent.runTurn(\"make change\", async (tool) => {\n        promptLog.push(tool);\n        return true;\n      });\n\n      assert.equal(promptLog.length, 0, \"explicit auto mode should not depend on workspace trust\");\n      assert.equal(fs.existsSync(sentinelPath), true, \"sentinel should be created automatically\");\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(tempHome, { recursive: true, force: true });\n      process.env.HOME = savedHome;\n    }\n    });\n  }\n\n  test(\"headless execution refuses verifier output without a matching pre-change baseline\", async () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { PassThrough } from \"node:stream\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { promptWorkspaceTrust, trustedProjectRules, TrustPromptInput } from \"../src/startup_trust.js\";\nimport { AutonomousAgent } from \"../src/agent.js\";\n\nfunction mockTerminal(isTTY = true, columns = 80) {\n  const input = new PassThrough() as unknown as TrustPromptInput & { isRaw: boolean };\n  input.isTTY = isTTY;\n  input.isRaw = false;\n  input.setRawMode = ((value: boolean) => { input.isRaw = value; return input; }) as TrustPromptInput[\"setRawMode\"];\n\n  const output = new PassThrough() as PassThrough & { isTTY: boolean };\n  output.isTTY = isTTY;\n  output.columns = columns;\n  let text = \"\";\n  output.on(\"data\", (chunk) => { text += chunk.toString(); });\n  return { input, output, get text() { return text; } };\n}\n\nfunction workspaceWithInstructions(): string {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-prompt-\"));\n  fs.writeFileSync(path.join(workspace, \"AGENTS.md\"), \"project instruction\\n\");\n  return workspace;\n}\n\nfunction displayWidth(value: string): number {\n  const segmenter = new Intl.Segmenter(undefined, { granularity: \"grapheme\" });\n  let width = 0;\n  for (const { segment } of segmenter.segment(value)) {\n    const widths = [...segment].map((character) => {\n      const point = character.codePointAt(0)!;\n      if (character === \"\\u200d\" || /[\\p{Mark}\\p{Format}]/u.test(character)) return 0;\n      return point >= 0x1100 && (\n        point <= 0x115f || point === 0x2329 || point === 0x232a ||\n        (point >= 0x2e80 && point <= 0xa4cf && point !== 0x303f) ||\n        (point >= 0xac00 && point <= 0xd7a3) || (point >= 0xf900 && point <= 0xfaff) ||\n        (point >= 0xfe10 && point <= 0xfe19) || (point >= 0xfe30 && point <= 0xfe6f) ||\n        (point >= 0xff00 && point <= 0xff60) || (point >= 0xffe0 && point <= 0xffe6) ||\n        (point >= 0x1f000 && point <= 0x1faff) || (point >= 0x20000 && point <= 0x3fffd)\n      ) ? 2 : 1;\n    });\n    width += Math.max(0, ...widths);\n  }\n  return width;\n}\n\ntest(\"trust prompt offers explicit trust, continue-untrusted, and exit choices\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal(true, 40);\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => trusted,\n        trust: () => { trusted = true; },\n      },\n    });\n    await new Promise((resolve) => setImmediate(resolve));\n    const rendered = terminal.text.replace(/\\u001b\\[[0-9;?]*[A-Za-z]/g, \"\");\n    assert.match(rendered, /Trust this folder\\?/);\n    assert.match(rendered, /AGENTS\\.md/);\n    assert.match(rendered, /Trust and continue/);\n    assert.match(rendered, /Continue without trusting/);\n    assert.match(rendered, /Exit/);\n    assert.match(rendered, /Trust remembered for this folder/);\n    assert.match(rendered, /Includes future project config changes/);\n    assert.match(rendered, /Tool approvals use permission settings/);\n    assert.match(rendered, /Folder trust doesn't change approvals/);\n    assert.ok(rendered.split(\"\\n\").every((line) => displayWidth(line) <= 40), rendered);\n\n    terminal.input.emit(\"keypress\", undefined, { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"untrusted\");\n    assert.equal(trusted, false);\n    assert.equal(terminal.input.isRaw, false);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"trust prompt neutralizes bidi controls and fits wide Unicode paths by terminal cells\", async () => {\n  const parent = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-bidi-\"));\n  const workspace = path.join(parent, `項目-${\"界\".repeat(30)}-\\u202eabc-\\u200bdef-\\u2060ghi`);\n  fs.mkdirSync(workspace);\n  const terminal = mockTerminal(true, 40);\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => {} },\n    });\n    await new Promise((resolve) => setImmediate(resolve));\n    const rendered = terminal.text.replace(/\\u001b\\[[0-9;?]*[A-Za-z]/g, \"\");\n    assert.equal(rendered.includes(\"\\u202e\"), false);\n    assert.match(rendered, /�abc/);\n    assert.equal(rendered.includes(\"\\u200b\"), false);\n    assert.equal(rendered.includes(\"\\u2060\"), false);\n    assert.match(rendered, /�def/);\n    assert.match(rendered, /�ghi/);\n    assert.ok(rendered.split(\"\\n\").every((line) => displayWidth(line) <= 40), rendered);\n    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n    assert.equal(await decision, \"exit\");\n  } finally {\n    fs.rmSync(parent, { recursive: true, force: true });\n  }\n});\n\ntest(\"trust choice persists workspace trust and returns trusted\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => trusted,\n        trust: () => { trusted = true; },\n      },\n    });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"trusted\");\n    assert.equal(trusted, true);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"a trust-store write failure leaves the operator free to continue without trust\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => false,\n        trust: () => { throw new Error(\"store unavailable\"); },\n      },\n    });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.match(terminal.text, /Trust was not saved: store unavailable/);\n    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"untrusted\");\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"escape exits without recording trust\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => false,\n        trust: () => { trusted = true; },\n      },\n    });\n    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n    assert.equal(await decision, \"exit\");\n    assert.equal(trusted, false);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"a terminal that cannot enter prompt mode exits instead of silently choosing\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  terminal.input.setRawMode = (() => { throw new Error(\"raw mode unavailable\"); }) as TrustPromptInput[\"setRawMode\"];\n  try {\n    assert.equal(await promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => assert.fail(\"No trust choice was made\") },\n    }), \"exit\");\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.match(terminal.text, /could not open the trust prompt/);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"the Exit menu item exits without persisting trust\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => assert.fail(\"Exit must not record trust\") },\n    });\n    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"exit\");\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"workspace paths cannot inject terminal control sequences into the trust screen\", async () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-\\u001b[31m\"));\n  const terminal = mockTerminal();\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => {} },\n    });\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.equal(terminal.text.includes(\"\\u001b[31m\"), false);\n    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n    assert.equal(await decision, \"exit\");\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n","exit_code":0,"duration":{"secs":0,"nanos":750030283}},"started_at_ms":1792884756418,"completed_at_ms":1792884757169}}
{"timestamp":"2026-10-24T23:32:38.225Z","ordinal":313880,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17042-56d1-7d11-8cff-fc4d2ecfc94d","call_id":"call_53e97fbac57248b589543c98526c2f35","output":[{"type":"input_text","text":"Script completed\nWall time 3.1 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 8015)\nTotal output lines: 733\n\n/**\n * Approval input safety through the real TUI and sidecar in a pseudo-terminal (review mode): keys queued while the\n * panel was not yet on screen, a delayed burst, and a bracketed paste never decide an approval; one deliberate key\n * does. See helpers/tui_approval_driver.py for the sequence.\n */\n\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, makeRepo, makeHome, Reply, ptyTest } from \"./helpers/fixtures.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"../..\");\nconst TUI = path.join(ROOT, \"core/target/release/nexus-tui\");\nconst SIDECAR = path.join(ROOT, \"cli/dist/sidecar.js\");\n\nfunction script(_n: number, body: any): Reply {\n  const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n  if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"first.txt\", content: \"one\\n\" } }], delayMs: 800 };\n  if (tools === 1) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"second.txt\", content: \"two\\n\" } }] };\n  // The third approval appears while the operator is still typing.\n  if (tools === 2) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"third.txt\", content: \"three\\n\" } }], delayMs: 1200 };\n  return { kind: \"text\", content: \"Done.\" };\n}\n\nptyTest(\"queued keys, bursts and pastes never answer an approval; one deliberate key does\", { timeout: 120_000 }, async () => {\n  for (const p of [TUI, SIDECAR]) assert.ok(fs.existsSync(p), `missing ${p} (run make build)`);\n  const gw = await startGateway(script);\n  const repo = makeRepo();\n  const home = makeHome();\n  const logs = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-tui-approval-\"));\n  const plan = {\n    tui: TUI,\n    recorder: path.join(here, \"helpers/sidecar_recorder.mjs\"),\n    node: process.execPath,\n    sidecar_args: [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\", \"--approve\"],\n    env: {\n      HOME: home,\n      TERM: \"xterm-256color\",\n      COLORTERM: \"truecolor\",\n      NEXUS_DEBUG: \"0\",\n      NEXUS_RECORD_SIDECAR: SIDECAR,\n      NEXUS_RECORD_COMMANDS: path.join(logs, \"commands.ndjson\"),\n      NEXUS_RECORD_EVENTS: path.join(logs, \"events.ndjson\"),\n    },\n  };\n  const planFile = path.join(logs, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [path.join(here, \"helpers/tui_approval_driver.py\"), planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    assert.equal(code, 0, `driver failed:\\n${err}\\n${out.slice(-2000)}`);\n    const r = JSON.parse(out.trim().split(\"\\n\").pop()!);\n    assert.ok(r.approval_arrived_while_frozen, \"the approval arrived while the TUI was frozen\");\n    assert.deepEqual(r.after_queued_keys, { decisions: [], panel_open: true }, \"keys queued before the panel was on screen did not decide\");\n    assert.deepEqual(r.after_burst, { decisions: [], panel_open: true }, \"a burst did not decide\");\n    assert.deepEqual(r.after_paste, { decisions: [], panel_open: true }, \"a paste did not decide\");\n    assert.deepEqual(r.n_after_typing, [], \"after typing into the panel, a letter is text\");\n    assert.deepEqual(r.after_deny, [\"deny\"], \"Esc denied\");\n    assert.deepEqual(r.after_approve, [\"deny\", \"approve\"], \"one deliberate key approved\");\n    assert.deepEqual(r.after_typing_across, { decisions: [\"deny\", \"approve\"], panel_open: true }, \"typing across the panel's appearance decided nothing\");\n    assert.deepEqual(r.n_after_typing_across, [\"deny\", \"approve\"], \"after typing across the panel, a letter is text even after a pause\");\n    assert.deepEqual(r.after_typing_then_deny, [\"deny\", \"approve\", \"deny\"], \"Esc then denies\");\n    assert.ok(!fs.existsSync(path.join(repo, \"third.txt\")), \"the write proposed during typing did not happen\");\n    // Input typed into the frozen terminal is either discarded (the approval event reached the TUI first) or, when it\n    // is read before the event (the sidecar reader thread was frozen too), goes where typing goes while the agent\n    // works: steering, shown in the transcript. Either way it never decides.\n    const commands = fs.readFileSync(plan.env.NEXUS_RECORD_COMMANDS, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    assert.ok(commands.filter((c) => c.type === \"steer\").every((c) => c.text === \"y\"), JSON.stringify(commands));\n    assert.deepEqual(commands.filter((c) => c.type === \"approve\" || c.type === \"deny\").map((c) => c.id), [\"approval-1\", \"approval-2\", \"approval-3\"]);\n    assert.ok(!fs.existsSync(path.join(repo, \"first.txt\")), \"the denied write did not happen\");\n    assert.equal(fs.readFileSync(path.join(repo, \"second.txt\"), \"utf8\"), \"two\\n\", \"the approved write happened\");\n  } finally {\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(home, { recursive: true, force: true });\n  }\n});\n\nfunction typingScript(_n: number, body: any): Reply {\n  const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n  if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"first.txt\", content: \"one\\n\" } }], delayMs: 1200 };\n  return { kind: \"text\", content: \"Done.\" };\n}\n\nptyTest(\"typing with thinking pauses and a final Enter across the approval panel never decides; Esc then denies\", { timeout: 120_000 }, async () => {\n  const gw = await startGateway(typingScript);\n  const repo = makeRepo();\n  const home = makeHome();\n  const logs = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-tui-approval-typing-\"));\n  const plan = {\n    tui: TUI,\n    recorder: path.join(here, \"helpers/sidecar_recorder.mjs\"),\n    node: process.execPath,\n    sidecar_args: [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\", \"--approve\"],\n    env: {\n      HOME: home,\n      TERM: \"xterm-256color\",\n      COLORTERM: \"truecolor\",\n      NEXUS_DEBUG: \"0\",\n      NEXUS_RECORD_SIDECAR: SIDECAR,\n      NEXUS_RECORD_COMMANDS: path.join(logs, \"commands.ndjson\"),\n      NEXUS_RECORD_EVENTS: path.join(logs, \"events.ndjson\"),\n    },\n  };\n  const planFile = path.join(logs, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [path.join(here, \"helpers/tui_approval_typing_driver.py\"), planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    assert.equal(code, 0, `driver failed:\\n${err}\\n${out.slice(-2000)}`);\n    const r = JSON.parse(out.trim().split(\"\\n\").pop()!);\n    assert.ok(r.approval_arrived && r.panel_seen_while_typing, JSON.stringify(r));\n    assert.deepEqual(r.after_typing, { decisions: [], panel_open: true }, \"typing with pauses decided nothing\");\n    assert.match(r.hint, /typing ignored/, \"the panel says letters are not answers now\");\n    assert.deepEqual(r.after_editing_keys, { decisions: [], panel_open: true }, \"→ → Enter, Ctrl+A Enter, and → → (pause) Enter (pause) Enter decided nothing\");\n    assert.deepEqual(r.after_esc, [\"deny\"], \"a deliberate Esc denies\");\n    const events = fs.readFileSync(plan.env.NEXUS_RECORD_EVENTS, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    assert.ok(events.filter((e) => e.type === \"session.state\").every((e) => e.mode === \"review\"), \"review mode was never switched off\");\n    assert.ok(!fs.existsSync(path.join(repo, \"first.txt\")), \"nothing was written\");\n  } finally {\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(home, { recursive: true, force: true });\n  }\n});\n/**\n * ACC-SAFE-03 & ACC-SAFE-08: REPL approval hardening e2e in a real pseudo-terminal (PTY).\n *\n * Verifies:\n * 1. Lone Enter at approval prompt -> DENIED (returns false, file not written)\n * 2. Keystrokes typed ahead before approval prompt -> cleared with Ctrl-U and line buffer reset, DENIED\n * 3. Paste within the 400ms grace window -> discarded, not approved\n * 4. Deliberate 'y' after 500ms -> APPROVED (action executed)\n * 5. 'a' (always allow session) requires explicit confirmation typing 'all';\n *    unconfirmed cancels and reprompts, confirmed switches session to auto-approve.\n */\n\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"…3515 tokens truncated…Home = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { PassThrough } from \"node:stream\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { promptWorkspaceTrust, trustedProjectRules, TrustPromptInput } from \"../src/startup_trust.js\";\nimport { AutonomousAgent } from \"../src/agent.js\";\n\nfunction mockTerminal(isTTY = true, columns = 80) {\n  const input = new PassThrough() as unknown as TrustPromptInput & { isRaw: boolean };\n  input.isTTY = isTTY;\n  input.isRaw = false;\n  input.setRawMode = ((value: boolean) => { input.isRaw = value; return input; }) as TrustPromptInput[\"setRawMode\"];\n\n  const output = new PassThrough() as PassThrough & { isTTY: boolean };\n  output.isTTY = isTTY;\n  output.columns = columns;\n  let text = \"\";\n  output.on(\"data\", (chunk) => { text += chunk.toString(); });\n  return { input, output, get text() { return text; } };\n}\n\nfunction workspaceWithInstructions(): string {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-prompt-\"));\n  fs.writeFileSync(path.join(workspace, \"AGENTS.md\"), \"project instruction\\n\");\n  return workspace;\n}\n\nfunction displayWidth(value: string): number {\n  const segmenter = new Intl.Segmenter(undefined, { granularity: \"grapheme\" });\n  let width = 0;\n  for (const { segment } of segmenter.segment(value)) {\n    const widths = [...segment].map((character) => {\n      const point = character.codePointAt(0)!;\n      if (character === \"\\u200d\" || /[\\p{Mark}\\p{Format}]/u.test(character)) return 0;\n      return point >= 0x1100 && (\n        point <= 0x115f || point === 0x2329 || point === 0x232a ||\n        (point >= 0x2e80 && point <= 0xa4cf && point !== 0x303f) ||\n        (point >= 0xac00 && point <= 0xd7a3) || (point >= 0xf900 && point <= 0xfaff) ||\n        (point >= 0xfe10 && point <= 0xfe19) || (point >= 0xfe30 && point <= 0xfe6f) ||\n        (point >= 0xff00 && point <= 0xff60) || (point >= 0xffe0 && point <= 0xffe6) ||\n        (point >= 0x1f000 && point <= 0x1faff) || (point >= 0x20000 && point <= 0x3fffd)\n      ) ? 2 : 1;\n    });\n    width += Math.max(0, ...widths);\n  }\n  return width;\n}\n\ntest(\"trust prompt offers explicit trust, continue-untrusted, and exit choices\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal(true, 40);\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => trusted,\n        trust: () => { trusted = true; },\n      },\n    });\n    await new Promise((resolve) => setImmediate(resolve));\n    const rendered = terminal.text.replace(/\\u001b\\[[0-9;?]*[A-Za-z]/g, \"\");\n    assert.match(rendered, /Trust this folder\\?/);\n    assert.match(rendered, /AGENTS\\.md/);\n    assert.match(rendered, /Trust and continue/);\n    assert.match(rendered, /Continue without trusting/);\n    assert.match(rendered, /Exit/);\n    assert.match(rendered, /Trust remembered for this folder/);\n    assert.match(rendered, /Includes future project config changes/);\n    assert.match(rendered, /Tool approvals use permission settings/);\n    assert.match(rendered, /Folder trust doesn't change approvals/);\n    assert.ok(rendered.split(\"\\n\").every((line) => displayWidth(line) <= 40), rendered);\n\n    terminal.input.emit(\"keypress\", undefined, { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"untrusted\");\n    assert.equal(trusted, false);\n    assert.equal(terminal.input.isRaw, false);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"trust prompt neutralizes bidi controls and fits wide Unicode paths by terminal cells\", async () => {\n  const parent = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-bidi-\"));\n  const workspace = path.join(parent, `項目-${\"界\".repeat(30)}-\\u202eabc-\\u200bdef-\\u2060ghi`);\n  fs.mkdirSync(workspace);\n  const terminal = mockTerminal(true, 40);\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => {} },\n    });\n    await new Promise((resolve) => setImmediate(resolve));\n    const rendered = terminal.text.replace(/\\u001b\\[[0-9;?]*[A-Za-z]/g, \"\");\n    assert.equal(rendered.includes(\"\\u202e\"), false);\n    assert.match(rendered, /�abc/);\n    assert.equal(rendered.includes(\"\\u200b\"), false);\n    assert.equal(rendered.includes(\"\\u2060\"), false);\n    assert.match(rendered, /�def/);\n    assert.match(rendered, /�ghi/);\n    assert.ok(rendered.split(\"\\n\").every((line) => displayWidth(line) <= 40), rendered);\n    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n    assert.equal(await decision, \"exit\");\n  } finally {\n    fs.rmSync(parent, { recursive: true, force: true });\n  }\n});\n\ntest(\"trust choice persists workspace trust and returns trusted\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => trusted,\n        trust: () => { trusted = true; },\n      },\n    });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"trusted\");\n    assert.equal(trusted, true);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"a trust-store write failure leaves the operator free to continue without trust\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => false,\n        trust: () => { throw new Error(\"store unavailable\"); },\n      },\n    });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.match(terminal.text, /Trust was not saved: store unavailable/);\n    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"untrusted\");\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"escape exits without recording trust\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => false,\n        trust: () => { trusted = true; },\n      },\n    });\n    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n    assert.equal(await decision, \"exit\");\n    assert.equal(trusted, false);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"a terminal that cannot enter prompt mode exits instead of silently choosing\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  terminal.input.setRawMode = (() => { throw new Error(\"raw mode unavailable\"); }) as TrustPromptInput[\"setRawMode\"];\n  try {\n    assert.equal(await promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => assert.fail(\"No trust choice was made\") },\n    }), \"exit\");\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.match(terminal.text, /could not open the trust prompt/);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"the Exit menu item exits without persisting trust\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => assert.fail(\"Exit must not record trust\") },\n    });\n    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"exit\");\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"workspace paths cannot inject terminal control sequences into the trust screen\", async () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-\\u001b[31m\"));\n  const terminal = mockTerminal();\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => {} },\n    });\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.equal(terminal.text.includes(\"\\u001b[31m\"), false);\n    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n    assert.equal(await decision, \"exit\");\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1703b-4280-7320-9374-5c397c112b4d","create_time":1792884758.2255595}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
