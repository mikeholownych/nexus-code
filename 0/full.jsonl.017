cription(\"List installed agent skills and their descriptions\")\n  .option(\"-w, --workspace <path>\", \"Workspace directory\")\n  .action((options: any) => {\n    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n    const sm = new SkillManager(ws);\n    const skills = sm.listSkills();\n    if (skills.length === 0) {\n      console.log(pc.yellow(\"\\nNo skills found. Place skills in ~/.nexus/skills/<name>/SKILL.md or .nexus/skills/\\n\"));\n      return;\n    }\n    console.log(pc.bold(pc.cyan(\"\\n=== Installed Agent Skills ===\\n\")));\n    for (const s of skills) {\n      console.log(`• ${pc.bold(pc.green(s.name))} (${pc.dim(s.path)})`);\n      console.log(`  ${s.description}\\n`);\n    }\n  });\n\nprogram\n  .command(\"mcp\")\n  .description(\"Check connected MCP servers and inspect exposed tools\")\n  .option(\"-w, --workspace <path>\", \"Workspace directory\")\n  .action(async (options: any) => {\n    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n    const mcp = new McpClientManager(ws);\n    const { untrustedWorkspaceExtensions } = await import(\"./workspace_trust.js\");\n    for (const file of untrustedWorkspaceExtensions(ws).filter((f) => /(^|[\\\\/])\\.?mcp\\.json$/.test(f))) {\n      console.log(pc.yellow(`Not loaded (workspace not trusted; run \\`nexus trust\\`): ${file}`));\n    }\n    console.log(pc.dim(\"\\nConnecting to configured MCP servers...\"));\n    await mcp.loadAndConnect();\n    const servers = mcp.listServers();\n    const tools = mcp.getToolDefinitions();\n\n    if (servers.length === 0) {\n      console.log(pc.yellow(\"No MCP servers configured in ~/.config/nexus/mcp.json or .mcp.json\\n\"));\n      return;\n    }\n\n    console.log(pc.bold(pc.cyan(\"\\n=== Configured MCP Servers ===\\n\")));\n    for (const s of servers) {\n      const status = s.connected ? pc.green(\"CONNECTED\") : pc.red(\"DISCONNECTED\");\n      console.log(`• ${pc.bold(s.name)} [${status}]`);\n      console.log(`  Command: ${pc.dim(s.command)}`);\n      console.log(`  Tools: ${s.toolCount}\\n`);\n    }\n\n    if (tools.length > 0) {\n      console.log(pc.bold(pc.cyan(\"=== Discovered MCP Tools ===\\n\")));\n      for (const t of tools) {\n        console.log(`⚡ ${pc.yellow(t.function.name)}: ${t.function.description}`);\n      }\n      console.log();\n    }\n    mcp.shutdownAll();\n  });\n\nprogram\n  .command(\"plugins\")\n  .description(\"List loaded custom plugins and lifecycle hooks\")\n  .option(\"-w, --workspace <path>\", \"Workspace directory\")\n  .action(async (options: any) => {\n    const ws = options.workspace ? path.resolve(options.workspace) : process.cwd();\n    const pm = new PluginManager(ws);\n    const { untrustedWorkspaceExtensions } = await import(\"./workspace_trust.js\");\n    for (const file of untrustedWorkspaceExtensions(ws).filter((f) => !/(^|[\\\\/])\\.?mcp\\.json$/.test(f))) {\n      console.log(pc.yellow(`Not loaded (workspace not trusted; run \\`nexus trust\\`): ${file}`));\n    }\n    await pm.loadPlugins();\n    const plugins = pm.listPlugins();\n    if (plugins.length === 0) {\n      console.log(pc.yellow(\"\\nNo active plugins found in ~/.nexus/plugins/ or ~/.config/nexus/plugins/\\n\"));\n      return;\n    }\n    console.log(pc.bold(pc.cyan(\"\\n=== Loaded Custom Plugins ===\\n\")));\n    for (const p of plugins) {\n      console.log(`• ${pc.bold(pc.green(p.name))}: ${p.description} (custom tools: ${p.customToolCount})\\n`);\n    }\n  });\n\nprogram\n  .command(\"trust [path]\")\n  .description(\"Trust a workspace so its own .mcp.json servers and plugins are loaded (they run code from the workspace)\")\n  .option(\"--remove\", \"Stop trusting the workspace\")\n  .option(\"--list\", \"List trusted workspaces\")\n  .action(async (target: string | undefined, options: any) => {\n    const { listTrustedWorkspaces, setWorkspaceTrusted } = await import(\"./workspace_trust.js\");\n    if (options.list) {\n      const list = listTrustedWorkspaces();\n      console.log(list.length ? list.join(\"\\n\") : \"No trusted workspaces.\");\n      return;\n    }\n    const ws = path.resolve(target ?? process.cwd());\n    if (!fs.existsSync(ws) || !fs.statSync(ws).isDirectory()) {\n      console.error(pc.red(`Not a directory: ${ws}`));\n      process.exitCode = 1;\n      return;\n    }\n    const real = setWorkspaceTrusted(ws, !options.remove);\n    console.log(options.remove ? `No longer trusted: ${real}` : `Trusted: ${real}\\nIts .mcp.json servers and plugins will be loaded (they run code from this workspace). Undo with \\`nexus trust --remove\\`.`);\n  });\n\nprogram\n  .command(\"checkpoints\")\n  .description(\"List saved workspace snapshots and rollback ch…1397 tokens truncated…text/event-stream\" });\n          const pieces = [...r.chunks];\n          const next = () => {\n            if (res.writableEnded || res.destroyed) return;\n            const piece = pieces.shift();\n            if (piece === undefined) {\n              res.end(sse({ choices: [{ index: 0, delta: {}, finish_reason: \"stop\" }] }) + \"data: [DONE]\\n\\n\");\n              return;\n            }\n            res.write(sse({ choices: [{ index: 0, delta: { content: piece } }] }));\n            setTimeout(next, r.gapMs ?? 50);\n          };\n          next();\n        } else if (body.stream) {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          res.end(streamBody(r));\n        } else {\n          res.setHeader(\"content-type\", \"application/json\");\n          const message = r.kind === \"text\"\n            ? { role: \"assistant\", content: r.content }\n            : { role: \"assistant\", content: r.content ?? null, tool_calls: r.calls.map((c, i) => ({ id: c.id ?? `call_${i}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } })) };\n          res.end(JSON.stringify({ choices: [{ index: 0, message, finish_reason: r.truncated ? \"length\" : \"stop\" }] }));\n        }\n      };\n      if (r.delayMs) setTimeout(respond, r.delayMs); else respond();\n    });\n  });\n  server.on(\"connection\", (s) => { sockets.add(s); s.on(\"close\", () => sockets.delete(s)); });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", () => resolve()));\n  const port = (server.address() as any).port;\n  return {\n    url: `http://127.0.0.1:${port}/v1`,\n    requests,\n    tokenizeRequests,\n    get modelRequests() {\n      return modelRequests;\n    },\n    authSeen,\n    close: async () => {\n      for (const s of sockets) s.destroy();\n      await new Promise<void>((resolve) => server.close(() => resolve()));\n    },\n  };\n}\n\n/** Temporary git repository with one committed file. */\nexport function makeRepo(files: Record<string, string> = {}): string {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-sidecar-\"));\n  fs.writeFileSync(path.join(repo, \"base.txt\"), \"base\\n\");\n  for (const [name, content] of Object.entries(files)) {\n    const full = path.join(repo, name);\n    fs.mkdirSync(path.dirname(full), { recursive: true });\n    fs.writeFileSync(full, content);\n  }\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm base\", { cwd: repo, stdio: \"ignore\" });\n  return repo;\n}\n\nexport function makeHome(): string {\n  return fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-home-\"));\n}\n\n/** Seed an isolated HOME with explicit trust for a PTY test that needs to reach the REPL. */\n/**\n * ACC-SAFE-03 & ACC-SAFE-08: REPL approval hardening e2e in a real pseudo-terminal (PTY).\n *\n * Verifies:\n * 1. Lone Enter at approval prompt -> DENIED (returns false, file not written)\n * 2. Keystrokes typed ahead before approval prompt -> cleared with Ctrl-U and line buffer reset, DENIED\n * 3. Paste within the 400ms grace window -> discarded, not approved\n * 4. Deliberate 'y' after 500ms -> APPROVED (action executed)\n * 5. 'a' (always allow session) requires explicit confirmation typing 'all';\n *    unconfirmed cancels and reprompts, confirmed switches session to auto-approve.\n */\n\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, makeRepo, makeHome, trustWorkspace, Reply, ptyTest } from \"./helpers/fixtures.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"..\");\nconst INDEX = path.join(ROOT, \"dist/index.js\");\nconst DRIVER = path.join(here, \"helpers/repl_approval_driver.py\");\n\nfunction script(_n: number, body: any): Reply {\n  const messages: any[] = body?.messages ?? [];\n  let lastUserIdx = -1;\n  let filename = \"target.txt\";\n\n  for (let i = messages.length - 1; i >= 0; i--) {\n    if (messages[i].role === \"user\") {\n      lastUserIdx = i;\n      const text = typeof messages[i].content === \"string\" ? messages[i].content : \"\";\n      const m = text.match(/create\\s+([a-zA-Z0-9_\\-\\.]+)/i);\n      if (m) filename = m[1];\n      break;\n    }\n  }\n\n  const toolsSinceUser = lastUserIdx >= 0\n    ? messages.slice(lastUserIdx).filter((m) => m.role === \"tool\").length\n    : 0;\n\n  if (toolsSinceUser === 0) {\n    return {\n      kind: \"tools\",\n      calls: [{ name: \"write_file\", args: { path: filename, content: `content for ${filename}\\n` } }],\n      delayMs: 500, // delay allows typed-ahead input to land mid-turn\n    };\n  }\n  return { kind: \"text\", content: `Finished handling ${filename}.` };\n}\n\nasync function runScenario(scenario: string): Promise<any> {\n  const repo = makeRepo();\n  const home = makeHome();\n  trustWorkspace(home, repo);\n  const gw = await startGateway(script);\n  const plan = {\n    node: process.execPath,\n    index: INDEX,\n    args: [\"repl\", \"--approve\", \"-w\", repo, \"-e\", gw.url, \"-m\", \"m\"],\n    ws: repo,\n    home,\n    scenario,\n    env: {\n      HOME: home,\n      NEXUS_DEBUG: \"0\",\n    },\n  };\n  const planFile = path.join(home, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n\n  let driverShutdownConfirmed = false;\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [DRIVER, planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    // The driver exits successfully only after its finally block confirms that\n    // the PTY process group has stopped. Preserve the fixture on every other\n    // exit so a surviving child cannot write into a HOME being removed here.\n    driverShutdownConfirmed = code === 0;\n    assert.equal(code, 0, `driver failed for scenario '${scenario}':\\n${err}\\n${out}`);\n    const lastLine = out.trim().split(\"\\n\").pop() || \"{}\";\n    return JSON.parse(lastLine);\n  } finally {\n    await gw.close();\n    if (driverShutdownConfirmed) {\n      fs.rmSync(repo, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n    }\n  }\n}\n\nptyTest(\"REPL approval hardening (ACC-SAFE-03): lone Enter, typed-ahead, paste, deliberate approval, and session confirmation\", { timeout: 180_000 }, async () => {\n  assert.ok(fs.existsSync(INDEX), `missing ${INDEX} (run npm run build)`);\n  assert.ok(fs.existsSync(DRIVER), `missing ${DRIVER}`);\n\n  // 1. Lone Enter -> DENIED\n  const r1 = await runScenario(\"lone_enter\");\n  assert.equal(r1.file_created, false, \"lone Enter must NOT approve the action\");\n  assert.equal(r1.passed, true);\n\n  // 2. Typed ahead mid-turn -> DISCARDED & DENIED\n  const r2 = await runScenario(\"typed_ahead\");\n  assert.equal(r2.file_created, false, \"typed-ahead input must be discarded and NOT approve\");\n  assert.equal(r2.passed, true);\n\n  // 3. Paste during grace window -> DISCARDED & NOT APPROVED\n  const r3 = await runScenario(\"paste\");\n  assert.equal(r3.created_during_grace, false, \"burst/paste during grace window must NOT approve\");\n  assert.equal(r3.created_after_deny, false);\n  assert.equal(r3.passed, true);\n\n  // 4. Deliberate 'y' after grace window -> APPROVED\n  const r4 = await runScenario(\"deliberate\");\n  assert.equal(r4.file_created, true, \"deliberate 'y' after grace window MUST approve\");\n  assert.equal(r4.passed, true);\n\n  // 5. 'a' confirmation: unconfirmed cancels, 'all' enables auto-mode\n  const r5 = await runScenario(\"confirm_a\");\n  assert.equal(r5.auto1_cancelled, true, \"unconfirmed 'a' must cancel auto-approval\");\n  assert.equal(r5.auto1_created, true, \"confirmed 'a' with 'all' must approve initial action\");\n  assert.equal(r5.auto2_created, true, \"subsequent actions must run in auto mode without prompt\");\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1703b-4280-7320-9374-5c397c112b4d","create_time":1792884776.1651626}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
