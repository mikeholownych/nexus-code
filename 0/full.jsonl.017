\"$logfile\"; printf '\\nRESULT=FAIL exit=%s log=%s home=%s snapshot=%s\\n' \"$status\" \"$logfile\" \"$test_home\" \"$suite\"; exit \"$status\"; fi\n1670623 1670601       15:29 make test\n1678817 1670623       14:19 npm test\n1678829 1678817       14:19 sh -c node scripts/run_tests.mjs && bash ../scripts/terminal-acceptance/test-scope-procs.sh\n{\"conclusion\":\"\",\"status\":\"in_progress\"}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1703b-4280-7320-9374-5c397c112b4d","create_time":1792886137.819263}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
