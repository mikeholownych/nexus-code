 },\ncli/test/sidecar.test.ts:739:      ? { kind: \"tools\", calls: [{ name: \"run_command\", args: { command: \"sleep 1; echo slept\" } }] }\ncli/test/harness.test.ts:813:          ? { name: \"run_command\", args: { command: \"printf child > child-worktree.txt\" } }\ncli/test/harness.test.ts:814:          : { name: \"run_command\", args: { command: `printf escaped > ${JSON.stringify(originalWorkspaceWrite)}` } };\ncli/test/harness.test.ts:989:              if (name === \"run_command\" && args.command === scenario.command) throw new Error(\"injected verifier exception\");\ncli/test/output_truncation_recovery.test.ts:109:        { name: \"run_command\", args: { command: \"touch ran.txt\" } },\ncli/test/durable_continuity.test.ts:1102:          ? { tools: [{ name: \"run_command\", args: { command: \"printf x > out.txt; sleep 6\" } }] }\ncli/test/durable_continuity.test.ts:1282:        if (name === \"run_command\" && args.command === \"/usr/bin/true\") {\ncli/test/durable_continuity.test.ts:1610:      return toolResults(b) === 0 ? { tools: [{ name: \"run_command\", args: { command: \"sleep 30\" } }] } : done(\"ran it\");\ncli/test/context_convergence.test.ts:1598:      const gw = await gateway((r) => (r.n === 1 ? { tools: [{ name: \"run_command\", args: { command: \"seq 1 50 | head -20\" } }, { name: \"file_tree\", args: { path: \".\", max_depth: 1 } }] } : { tools: [done(\"stop\")] }));\n    { stdio: \"inherit\" }\n  );\n  if (result.error) {\n    console.error(`Failed to launch nexus-tui: ${result.error.message}`);\n    process.exit(1);\n  }\n  process.exit(result.status ?? (result.signal ? 1 : 0));\n}\n\nfunction triggerBackgroundGc(): void {\n  void import(\"./core/retention.js\").then(({ maybeRunDailyGc }) => {\n    maybeRunDailyGc().then((res) => {\n      if (res.status === \"needs_acknowledgement\" && res.notice) {\n        console.error(pc.yellow(`\\n[Notice] ${res.notice}\\n`));\n      }\n    }).catch(() => {});\n  }).catch(() => {});\n}\n\nasync function startRepl(options: any): Promise<void> {\n  if (process.env.NEXUS_TEST_RECORD_REPL) {\n    const log = process.env.NEXUS_TEST_RECORD_REPL;\n    const parts = [\"repl\"];\n    if (options.model) parts.push(\"-m\", options.model);\n    if (options.resume) parts.push(\"-r\", typeof options.resume === \"string\" ? options.resume : \"\");\n    fs.appendFileSync(log, parts.join(\" \").trim() + \"\\n\");\n    return;\n  }\n  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n  if (trustDecision === \"exit\") return;\n  triggerBackgroundGc();\n  const config = buildConfig(options);\n  if (config.model === \"local-model\") {\n    try {\n      const client = new LocalLlmClient(config);\n      const models = await client.listModels();\n      if (models.length > 0) {\n        config.model = models[0];\n      }\n    } catch {\n      // Fallback\n    }\n  }\n  const resumeId = typeof options.resume === \"string\" ? options.resume : options.resume ? \"latest\" : undefined;\n  if (config.provider || config.plannerProvider || config.coderProvider) console.error(pc.dim(describeTarget(config)));\n  config.surface = \"repl\";\n  const app = new ApplicationCore(config);\n  const repl = new InteractiveRepl(app, config.approvalMode, resumeId);\n  await repl.start();\n}\n\nasync function runDefault(options: any): Promise<void> {\n  if (options.repl) {\n    await startRepl(options);\n    return;\n  }\n\n  const tuiBin = resolveTuiBinary();\n  const sidecarScript = resolveSidecarScript();\n\n  if (options.live) {\n    if (!tuiBin) {\n      console.error(\"nexus-tui is not built. Run 'make build' first.\");\n      process.exit(1);\n    }\n    if (!sidecarScript) {\n      console.error(\"nexus sidecar is not built. Run 'npm run build' in cli first.\");\n      process.exit(1);\n    }\n    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n    if (trustDecision === \"exit\") return;\n    triggerBackgroundGc();\n    spawnTui(tuiBin, sidecarScript);\n    return;\n  }\n\n  const isInteractiveTty = Boolean(process.stdin.isTTY && process.stdout.isTTY);\n  if (isInteractiveTty && tuiBin && sidecarScript) {\n    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n    if (trustDecision === \"exit\") return;\n    triggerBackgroundGc();\n    spawnTui(tuiBin, sidecarScript);\n    return;\n  }\n\n  if (isInteractiveTty && !tuiBin) {\n    console.error(\"nexus: the live TUI is not built (run 'make build'); starting the REPL.\");\n  }\n\n  await startRepl(options);\n}\n\nconst program = new Command();\n\n// Options given before a subcommand belong to the top-level launch (`nexus --provider X` opens the TUI with it);\n// options after a subcommand belong to that subcommand. Without this, the top-level --provider/-m swallowed the\n// subcommand's own (`nexus providers verify --provider openrouter` reported --provider missing).\nprogram.enablePositionalOptions();\n\nprogram\n  .name(\"nexus\")\n  .description(\"Nexus Code - Custom Autonomous Coding Harness for Local AI (LM Studio / vLLM)\")\n  .version(getBuildIdentity().string)\n  .option(\"--repl\", \"Start interactive coding session (REPL)\")\n  .option(\"--live\", \"Start live TUI\")\n  .option(\"-r, --resume [id]\", \"Resume previous session (defaults to latest if id omitted)\")\n  .option(\"--approve\", \"Require human approval before destructive actions (edits, shell commands)\")\n  .option(\"-y, --yes\", \"Run non-interactively without approval prompts (forces auto mode)\")\n  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\n  .option(\"--read-only\", \"Reject all mutating tool executions and commands\")\n  .option(\"-e, --endpoint <url>\", \"Local LLM endpoint (default: $LOCAL_LLM_ENDPOINT)\")\n  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in vLLM)\")\n  .option(\"-w, --workspace <path>\", \"Workspace directory (default: current directory)\")\n  .option(\"-s, --max-steps <number>\", \"Steps per segment; continuation checkpoints there instead of stopping (default: 30)\")\n  .option(\"--max-total-steps <number>\", \"Continuation: an explicit total-step limit for one turn (default: none; progressing work continues)\")\n  .option(\"--strict-token-count\", \"Refuse a request the connection could not count on a worker (default: proceed on the labelled estimate)\")\n  .option(\"--max-turn-minutes <number>\", \"Continuation: an explicit wall-clock limit for one turn in minutes (default: none)\")\n  .option(\"--stagnation-steps <number>\", \"Continuation: stop after this many steps without progress (default 12)\")\n  .option(\"--no-continuation\", \"End a turn at --max-steps instead of continuing while it makes progress\")\n  .option(\"-t, --temperature <number>\", \"Model temperature (default: 0.2)\")\n  .option(\"--shell <type>\", \"Linux shell to use: bash, zsh, or sh (default: bash)\", \"bash\")\n  .option(\"--fallback <urls>\", \"Comma-separated fallback LLM endpoints if primary is unavailable\")\n  .option(\"--context-limit <tokens>\", \"Context window limit in tokens; below the provider's advertised capacity it is kept, above it the advertised capacity applies (default: advertised capacity, else 65536)\")\n  .option(\"--dry-run\", \"Simulate file modifications without writing changes to disk\")\n  .option(\"--sandbox [mode]\", \"Isolate command execution using bubblewrap (bwrap) or Docker (default: auto)\")\n  .option(\"--worktree\", \"Isolate execution inside an ephemeral git worktree under .nexus/worktrees/<task-id>\")\n  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\n  .option(\"--deliverable-file <path>\", \"Operator-declared workspace-relative product file used for VERIFIED binding (repeatable)\", collectDeliverableFile, [])\n  .option(\"--record-flight\", \"Record execution into an append-only deterministic .flightlog\")\n  .option(\"--planner-model <name>\", \"Deep reasoning model for architecture planning (o3, R1, Sonnet)\")\n  .option(\"--planner-endpoint <url>\", \"Dedicated inference endpoint for planner model\")\n  .option(\"--coder-model <name>\", \"High-throughput model for surgical code implementation (Qwen 2.5 Coder)\")\n  .option(\"--coder-endpoint <url>\", \"Dedicated inference endpoint for coder model\")\n  .option(\"--provider <id>\", \"Cloud inference provider: openrouter, openai, anthropic, compatible (default: appliance endpoint)\")\n  .option(\"--base-url <url>\", \"Override the provider's base URL (operator-only; required for 'compatible')\")\n  .option(\"--planner-provider <id>\", \"Cloud provider for the planner model (requires --planner-model)\")\n  .option(\"--coder-provider <id>\", \"Cloud provider for the coder model (requires --coder-model)\")\n  .action(async (options: any, cmd: Command) => {\n    if (cmd.args && cmd.args.length > 0) {\n      program.error(`error: unknown command '${cmd.args[0]}'`);\n    }\n    await runDefault(options);\n  });\n\nprogram\n  .command(\"repl\")\n  .description(\"Start interactive coding session (REPL / TUI)\")\n  .option(\"-e, --endpoint <url>\", \"Local LLM endpoint (default: $LOCAL_LLM_ENDPOINT)\")\n  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in vLLM)\")\n  .option(\"-w, --workspace <path>\", \"Workspace directory (default: current directory)\")\n  .option(\"-s, --max-steps <number>\", \"Steps per segment; continuation checkpoints there instead of stopping (default: 30)\")\n#!/usr/bin/env python3\n\"\"\"Drives the real `nexus-tui --live` binary through a pseudo-terminal it controls (so it can resize the terminal and\nread the process's CPU time), records the session as an asciicast v2 file, and prints a JSON summary of what it\nmeasured. The node test (tui_maturity_e2e.test.ts) owns the mock gateway and asserts on this summary together with\nthe sidecar's command/event logs.\n\nUsage: tui_pty_driver.py PLAN.json   (see the node test for the plan fields)\n\"\"\"\nimport fcntl\nimport json\nimport os\nimport pty\nimport re\nimport select\nimport signal\nimport struct\nimport sys\nimport termios\nimport time\n\nCSI = re.compile(r\"\\x1b\\[[0-9;?<>=]*[ -/]*[@-~]|\\x1b\\][^\\x07\\x1b]*(?:\\x07|\\x1b\\\\)|\\x1b[()][0-9A-Za-z]|\\x1b[=>78]\")\nSPINNER = \"⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏\"\n\n\nclass Screen:\n    \"\"\"Just enough of a terminal to know what is visible: cursor positioning, erase, and text (SGR ignored).\"\"\"\n\n    TOKEN = re.compile(r\"\\x1b\\[([0-9;?<>=]*)([ -/]*)([@-~])|\\x1b\\][^\\x07\\x1b]*(?:\\x07|\\x1b\\\\)|\\x1b[()][0-9A-Za-z]|\\x1b[=>78DEHM]|([\\r\\n\\b])|([^\\x1b\\r\\n\\b]+)\")\n\n    def __init__(self, cols, rows):\n        self.resize(cols, rows)\n\n    def resize(self, cols, rows):\n        self.cols, self.rows = cols, rows\n        self.grid = [[\" \"] * cols for _ in range(rows)]\n        self.row = self.col = 0\n\n    def feed(self, text):\n        for m in self.TOKEN.finditer(text):\n            params, _, final, ctl, chars = m.group(1), m.group(2), m.group(3), m.group(4), m.group(5)\n            if final:\n                nums = [int(n) if n.isdigit() else 0 for n in params.lstrip(\"?\").split(\";\")] if params else []\n                if final in \"Hf\":\n                    self.row = max(0, min(self.rows - 1, (nums[0] if nums and nums[0] else 1) - 1))\n                    self.col = max(0, min(self.cols - 1, (nums[1] if len(nums) > 1 and nums[1] else 1) - 1))\n                elif final == \"J\" and (not nums or nums[0] in (2, 3)):\n                    self.grid = [[\" \"] * self.cols for _ in range(self.rows)]\n                elif final == \"K\":\n                    mode = nums[0] if nums else 0\n                    span = range(self.col, self.cols) if mode == 0 else range(0, self.col + 1) if mode == 1 else range(self.cols)\n                    for c in span:\n                        self.grid[self.row][c] = \" \"\n                elif final == \"C\":\n                    self.col = min(self.cols - 1, self.col + (nums[0] if nums and nums[0] else 1))\n                elif final == \"D\":\n                    self.col = max(0, self.col - (nums[0] if nums and nums[0] else 1))\n                elif final == \"G\":\n                    self.col = max(0, min(self.cols - 1, (nums[0] if nums and nums[0] else 1) - 1))\n            elif ctl == \"\\r\":\n                self.col = 0\n            elif ctl == \"\\n\":\n                self.row = min(self.rows - 1, self.row + 1)\n            elif ctl == \"\\b\":\n                self.col = max(0, self.col - 1)\n            elif chars:\n                for ch in chars:\n                    if ord(ch) < 32:\n                        continue\n                    if self.col < self.cols:\n                        self.grid[self.row][self.col] = ch\n                    self.col += 1\n\n    def lines(self):\n        return [\"\".join(row).rstrip() for row in self.grid]\n\n    def text(self):\n        return \"\\n\".join(self.lines())\n\n\ndef clk_tck():\n    return os.sysconf(os.sysconf_names[\"SC_CLK_TCK\"])\n\n\ndef cpu_seconds(pid):\n    with open(f\"/proc/{pid}/stat\") as f:\n        fields = f.read().rsplit(\")\", 1)[1].split()\n    return (int(fields[11]) + int(fields[12])) / clk_tck()\n\n\n# One clock for the whole recording: every terminal session's timestamps are offsets from the same start, so a\n# resumed session continues the timeline instead of restarting at zero.\nT0 = time.monotonic()\n\n\nclass Session:\n    def __init__(self, argv, env, cols, rows, cast):\n        self.cols, self.rows = cols, rows\n        self.pid, self.fd = pty.fork()\n        if self.pid == 0:\n            os.execvpe(argv[0], argv, env)\n        self.out = \"\"\n        self.raw = b\"\"\n        self.start = T0\n        self.cast = cast\n        self.answered = 0\n        self.screen = Screen(cols, rows)\n        self.set_size(cols, rows, signal_child=False)\n\n    def set_size(self, cols, rows, signal_child=True):\n        self.cols, self.rows = cols, rows\n        fcntl.ioctl(self.fd, termios.TIOCSWINSZ, struct.pack(\"HHHH\", rows, cols, 0, 0))\n        if hasattr(self, \"screen\"):\n            self.screen.resize(cols, rows)\n        if signal_child:\n            os.kill(self.pid, signal.SIGWINCH)\n        if self.cast is not None:\n            self.cast.append([round(time.monotonic() - T0, 4), \"r\", f\"{cols}x{rows}\"])\n\n    def pump(self, seconds):\n        \"\"\"Reads output for `seconds`; returns the bytes read. Answers terminal capability queries like a VT220.\"\"\"\n        deadline = time.monotonic() + seconds\n        got = b\"\"\n        while True:\n            left = deadline - time.monotonic()\n            if left <= 0:\n                break\n            ready, _, _ = select.select([self.fd], [], [], left)\n            if not ready:\n                continue\n            try:\n                chunk = os.read(self.fd, 65536)\n            except OSError:\n                break\n            if not chunk:\n                break\n            got += chunk\n        if got:\n            self.raw += got\n            text = got.decode(\"utf-8\", \"replace\")\n            self.out += text\n            self.screen.feed(text)\n            if self.cast is not None:\n                self.cast.append([round(time.monotonic() - self.start, 4), \"o\", text])\n            queries = self.out.count(\"\\x1b[c\")\n            while self.answered < queries:\n                os.write(self.fd, b\"\\x1b[?62c\")\n                self.answered += 1\n        return got\n\n    def send(self, data, settle=0.15):\n        if self.cast is not None:\n            self.cast.append([round(time.monotonic() - self.start, 4), \"i\", data])\n        os.write(self.fd, data.encode())\n        self.pump(settle)\n\n    def screen_text(self, since=0):\n        return CSI.sub(\"\", self.out[since:])\n\n    def squeezed(self, since=0):\n        \"\"\"Screen text without whitespace: cells that did not change are skipped with cursor moves, not spaces.\"\"\"\n        return re.sub(r\"\\s\", \"\", self.screen_text(since))\n\n    def wait_text(self, text, timeout):\n        deadline = time.monotonic() + timeout\n        text = re.sub(r\"\\s\", \"\", text)\n        while text not in self.squeezed():\n            if time.monotonic() > deadline:\n                raise TimeoutError(f\"never saw {text!r}; tail: {self.screen_text()[-1500:]!r}\")\n            self.pump(0.1)\n\n    def wait_idle(self, timeout=20):\n        \"\"\"Until the idle hint is on screen: the sidecar reported the turn over (typing earlier would steer).\"\"\"\n        deadline = time.monotonic() + timeout\n        while not any(\"enter send\" in line for line in self.screen.lines()):\n            if time.monotonic() > deadline:\n                raise TimeoutError(f\"never idle; screen: {self.screen.text()!r}\")\n            self.pump(0.05)\n\n    def alive(self):\n        try:\n\n  // 4. Deliberate 'y' after grace window -> APPROVED\n  const r4 = await runScenario(\"deliberate\");\n  assert.equal(r4.file_created, true, \"deliberate 'y' after grace window MUST approve\");\n  assert.equal(r4.passed, true);\n\n  // 5. 'a' confirmation: unconfirmed cancels, 'all' enables auto-mode\n  const r5 = await runScenario(\"confirm_a\");\n  assert.equal(r5.auto1_cancelled, true, \"unconfirmed 'a' must cancel auto-approval\");\n  assert.equal(r5.auto1_created, true, \"confirmed 'a' with 'all' must approve initial action\");\n  assert.equal(r5.auto2_created, true, \"subsequent actions must run in auto mode without prompt\");\n  assert.equal(r5.passed, true);\n});\n","exit_code":0,"duration":{"secs":0,"nanos":791840339}},"started_at_ms":1792890524773,"completed_at_ms":1792890525566}}
