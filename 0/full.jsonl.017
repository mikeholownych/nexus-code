location while it was being opened\");\n+      }\n+    } else {\n+      const named = fs.lstatSync(file);\n+      if (named.isSymbolicLink() || named.dev !== stat.dev || named.ino !== stat.ino || fs.realpathSync(file) !== expected) {\n+        throw new Error(\"Git info/exclude changed while it was being opened\");\n+      }\n+    }\n+    return fd;\n+  } catch (error) {\n+    fs.closeSync(fd);\n+    throw error;\n+  }\n+}\n+\n+function readExclude(file: string, expected: string): string {\n+  const fd = openExclude(file, expected);\n+  try {\n+    return fs.readFileSync(fd, \"utf-8\");\n+  } finally {\n+    fs.closeSync(fd);\n+  }\n+}\n+\n+function appendExclude(file: string, expected: string, content: string): void {\n+  const fd = openExclude(file, expected);\n+  try {\n+    fs.writeSync(fd, content);\n+  } finally {\n+    fs.closeSync(fd);\n+  }\n+}\n+\n /**\n  * Ensures .nexus/ is ignored by Git in the workspace (REQ-PER-105).\n  * The self-contained rule protects state even when Git metadata is read-only;\n@@ -82,6 +134,21 @@ export function ensureGitExclude(workspace: string): void {\n \n   if (!excludePath) return;\n \n+  let commonDirPath: string | null = null;\n+  let expectedExcludePath: string | null = null;\n+  try {\n+    const commonDir = execFileSync(\"git\", [\"rev-parse\", \"--git-common-dir\"], {\n+      cwd: workspace,\n+      encoding: \"utf-8\",\n+      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n+    }).trim();\n+    commonDirPath = fs.realpathSync(path.resolve(workspace, commonDir));\n+    expectedExcludePath = path.join(commonDirPath, \"info\", \"exclude\");\n+    if (path.resolve(excludePath) !== expectedExcludePath) expectedExcludePath = null;\n+  } catch {\n+    // Updating the convenience file is optional; self-ignore verification below is authoritative.\n+  }\n+\n   const nexusDir = path.join(workspace, \".nexus\");\n   mkdirVerified(workspace, nexusDir);\n   const nexusGitIgnore = path.join(nexusDir, \".gitignore\");\n@@ -146,9 +213,23 @@ export function ensureGitExclude(workspace: string): void {\n   // effective rule without mutating Git metadata. Keep the legacy rules when\n   // available, but tolerate read-only or unusual Git directories.\n   try {\n-    const infoDir = path.dirname(excludePath);\n-    fs.mkdirSync(infoDir, { recursive: true });\n-    if (!fs.existsSync(excludePath)) fs.writeFileSync(excludePath, \"\");\n+    if (!expectedExcludePath || !commonDirPath) return;\n+\n+    try {\n+      readExclude(excludePath, expectedExcludePath);\n+    } catch (error) {\n+      if (typeof error !== \"object\" || error === null || !(\"code\" in error) || error.code !== \"ENOENT\") {\n+        throw error;\n+      }\n+      try {\n+        writeExclusiveVerified(commonDirPath, expectedExcludePath, \"\");\n+      } catch (createError) {\n+        // Another safe creator may have won the exclusive-create race.\n+        if (typeof createError !== \"object\" || createError === null || !(\"code\" in createError) || createError.code !== \"EEXIST\") {\n+          throw createError;\n+        }\n+      }\n+    }\n \n     const protectedPaths = [\n       { path: \".nexus/\", rule: \".nexus/\" },\n@@ -157,7 +238,7 @@ export function ensureGitExclude(workspace: string): void {\n     ];\n \n     for (const { path: relativePath, rule } of protectedPaths) {\n-      const content = fs.readFileSync(excludePath, \"utf-8\");\n+      const content = readExclude(excludePath, expectedExcludePath);\n       const lines = content.split(/\\r?\\n/);\n       const rules = new Set(lines);\n       const hasExactRule = rules.has(rule) || rules.has(`/${rule}`);\n@@ -172,7 +253,7 @@ export function ensureGitExclude(workspace: string): void {\n       }\n \n       const prefix = content.length === 0 || content.endsWith(\"\\n\") ? \"\" : \"\\n\";\n-      fs.appendFileSync(excludePath, `${prefix}${rule}\\n`);\n+      appendExclude(excludePath, expectedExcludePath, `${prefix}${rule}\\n`);\n       if (!isIgnored(relativePath)) {\n         throw new Error(`Git still does not ignore ${relativePath} after updating info/exclude`);\n       }\ndiff --git a/cli/test/git_exclude.test.ts b/cli/test/git_exclude.test.ts\nindex b163569..726a684 100644\n--- a/cli/test/git_exclude.test.ts\n+++ b/cli/test/git_exclude.test.ts\n@@ -254,3 +254,56 @@ test(\"a missing exclude file is created with the rules\", () => {\n     fs.rmSync(root, { recursive: true, force: true });\n   }\n });\n+\n+test(\"a symlinked info/exclude is not followed or modified\", () => {\n+  const { root, excludePath } = makeRepo(\"\");\n+  const outside = path.join(root, \"operator-owned-rules\");\n+  try {\n+    fs.writeFileSync(outside, \"operator rules\\n\");\n+    fs.unlinkSync(excludePath);\n+    fs.symlinkSync(outside, excludePath);\n+\n+    ensureGitExclude(root);\n+\n+    assert.equal(fs.readFileSync(outside, \"utf8\"), \"operator rules\\n\");\n+    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n+  } finally {\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"a hard-linked info/exclude is not modified\", () => {\n+  const { root, excludePath } = makeRepo(\"\");\n+  const outside = path.join(root, \"operator-owned-rules\");\n+  try {\n+    fs.writeFileSync(outside, \"operator rules\\n\");\n+    fs.unlinkSync(excludePath);\n+    fs.linkSync(outside, excludePath);\n+\n+    ensureGitExclude(root);\n+\n+    assert.equal(fs.readFileSync(outside, \"utf8\"), \"operator rules\\n\");\n+    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n+  } finally {\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"a symlinked info directory does not redirect missing exclud…28 tokens truncated…th);\n+  const movedInfoDir = path.join(root, \".git\", \"info-before-link\");\n+  const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-git-exclude-info-outside-\"));\n+  try {\n+    fs.renameSync(infoDir, movedInfoDir);\n+    fs.symlinkSync(outside, infoDir, \"dir\");\n+\n+    ensureGitExclude(root);\n+\n+    assert.equal(fs.existsSync(path.join(outside, \"exclude\")), false);\n+    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n+  } finally {\n+    fs.rmSync(root, { recursive: true, force: true });\n+    fs.rmSync(outside, { recursive: true, force: true });\n+  }\n+});\n{\n  \"latestReviews\": [],\n  \"files\": [\n    \"cli/src/core/git_exclude.ts\",\n    \"cli/src/safe_fs.ts\",\n    \"cli/src/worktree.ts\",\n    \"cli/test/doctor.test.ts\",\n    \"cli/test/flight_exclude.test.ts\",\n    \"cli/test/git_exclude.test.ts\"\n  ],\n  \"comments\": [\n    {\n      \"author\": \"mikeholownych\",\n      \"createdAt\": \"2026-10-24T20:08:26Z\",\n      \"body\": \"Fresh independent source review of exact head `a568a0da3c032576e7dbb96f02cbfddbcd61bcc3` (base `29eab4cd58051a8210b5ef66e0c9e248b2046a13`; diff SHA-256 `476affe385b663f1d0142cc5cac49f47fbe432cb01d9827bc789fadaff12357d`) found one blocking race.\\n\\n`ensureGitExclude` validates `.nexus` and `.nexus/.gitignore` with `lstat`, then uses ordinary path-based writes. A concurrent rename/replacement after validation can redirect the `.gitignore` write through a symlink to an outside path before later ignore probes run. Existing static symlink/hardlink tests do not exercise this check/use race.\\n\\nPlease pin directory/file identity across validation and writes with a no-follow directory-descriptor/openat-style approach or equivalent platform-safe primitive, and add a deterministic replacement test proving an outside sentinel remains unchanged. The rest of the reviewed exclusion invariant is sound. This is an independent source-review finding; no tests were run. The formal REQUEST_CHANGES review endpoint cannot accept a review from the authenticated PR owner, so I’m recording the finding here for the active implementation owner.\"\n    },\n    {\n      \"author\": \"mikeholownych\",\n      \"createdAt\": \"2026-10-24T20:14:46Z\",\n      \"body\": \"Safe-boundary handoff request: the PR #200 head remains `a568a0d`, the PR worktree is clean at that SHA, and the previously observed local CLI suite process is no longer present. The active local `make build && make test` I can currently see is in a different checkpoint-restore worktree. The exact-head independent review has a TOCTOU finding on `.nexus/.gitignore` (comment 6388958514), and the PR branch has no correction yet. Please either (a) acknowledge and release/transfer the PR #200 source/test claims so I can implement the race fix, or (b) report your current safe checkpoint and expected correction timing. I will preserve your separate worktree and will not start an overlapping suite; hosted PR CI 40123934735 remains active.\"\n    },\n    {\n      \"author\": \"mikeholownych\",\n      \"createdAt\": \"2026-10-24T20:19:56Z\",\n      \"body\": \"Independent read-only review of the current uncommitted correction snapshot (`/tmp/nexus-pr200-toctou-review.patch`, SHA-256 `74091fb4f30d98babb40ee280f5a8d0c178d99c9bab69d632608f6fbd5864146`, base head `a568a0d`) returned CHANGES_REQUIRED. The production change appears to close the pre-open parent-symlink redirect using verified descriptors. Blocking fixture issue: the new race test assigns `mutableFs.openSync = ...` where `fs` comes from `import * as fs from \\\"node:fs\\\"`; ESM namespace objects are immutable, so the assignment throws before testing either creation or append. Existing tests use a mutable default `fs` import plus `syncBuiltinESMExports`; please use that pattern, then run the focused regression. Portability note: on platforms without `/proc`, the existing exclusive-create helper may detect a redirected create but fail to remove the temporary empty outside file; current release packaging is Linux-only, but either document that limitation or add safe cleanup if other platforms are supported. This review covers only the saved patch snapshot; final independent review is still required on the committed head.\"\n    },\n    {\n      \"author\": \"mikeholownych\",\n      \"createdAt\": \"2026-10-24T20:43:31Z\",\n      \"body\": \"### Independent Review: CHANGES_REQUIRED (Head 81928bd)\\n\\n• Target Head: `81928bd81d10ec957a3063a0e414aef981c83b20`\\n• Finding: Test failure in `cli/test/git_exclude.test.ts:175` (`test('a symlink swap cannot write self-ignore content or alter external ignore rules')`):\\n  ```\\n  TypeError: Cannot assign to read only property 'openSync' of object '[object Module]'\\n      at TestContext.<anonymous> (cli/test/git_exclude.test.ts:217:17)\\n  ```\\n• Root Cause: `cli/test/git_exclude.test.ts` uses the ESM namespace import `import * as fs from \\\"node:fs\\\"`. Under ECMAScript specification, module namespace exotic objects have immutable non-writable properties. Attempting to monkey-patch `mutableFs.openSync = ...` throws at runtime.\\n• Fix: Change line 9 from `import * as fs from \\\"node:fs\\\";` to `import fs from \\\"node:fs\\\";` (matching the pattern in `cli/test/doctor.test.ts:6`), where default export properties are mutable for test interception.\\n\\nDisposition: CHANGES_REQUIRED.\"\n    },\n    {\n      \"author\": \"mikeholownych\",\n      \"createdAt\": \"2026-10-24T20:56:13Z\",\n      \"body\": \"**Independent re-review (claude-code) at exact head `81928bd81d10ec957a3063a0e414aef981c83b20` (base `29eab4cd`): ACCEPT.**\\n\\n`git range-diff` shows commits 1–7 unchanged from `a568a0d`, which I accepted. The only new commit is 8 (`81928bd`, *fix(fs): avoid unsafe cleanup after path swap*). It addresses my `wx` nit and goes further:\\n- `.nexus/` is created with `mkdirVerified` (mode 0700, each component checked as a real directory).\\n- `.nexus/.gitignore` is created with `writeExclusiveVerified` (O_EXCL|O_NOFOLLOW, checked before the content is written). Losing an EEXIST race is tolerated, and the result is then re-read through `openSelfIgnore` (O_NOFOLLOW, regular file, nlink==1, `/proc/self/fd` path bound to the expected location).\\n- The duplicate `existsSync` write is gone.\\n- The `safe_fs` change no longer removes entries by pathname after a failed verification. That's the right trade-off, since unlinking by name after a swap is itself a redirection risk. It also changes behaviour for doctor's callers, and the doctor tests added here cover that.\\n\\nI re-ran my tsx repro at this head on fresh repos:\\n- read-only `info/exclude` → ctor OK, `!! .nexus/`\\n- root `!.nexus/` negation → OK, `!! .nexus/`\\n- tracked `.gitignore` ignoring `.nexus/` plus read-only `info/exclude` → OK\\n- **new:** a planted `.nexus/.gitignore` symlink to an outside path → `ELOOP` refusal, and **nothing was created at the symlink's target**.\\n\\nRelease note: this is user-visible. If it merges before the rc.5 tag, the rc.5 notes need a bullet for it (startup no longer writes Git metadata, and `.nexus/` ignores itself).\"\n    }\n  ]\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16fd6-d88e-7ad0-8956-d61230292d9e","create_time":1792884215.557518}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
