{"timestamp":"2026-10-25T02:22:14.314Z","ordinal":320312,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a170d0-7672-79e2-b11d-117e84b3ea44","item":{"type":"CommandExecution","id":"exec-ee4221d6-18a2-49ec-9590-06516b3dfabd","process_id":"40590","command":["/usr/bin/zsh","-lc","sed -n '90,300p' src/core/git_exclude.ts && sed -n '1,300p' test/git_exclude.test.ts && sed -n '1,150p' test/flight_exclude.test.ts && sed -n '1,130p' src/flight.ts"],"cwd":"file:///home/mike/nexus-wt/git-exclude-fail-closed/cli","parsed_cmd":[{"type":"read","cmd":"sed -n '90,300p' src/core/git_exclude.ts","name":"git_exclude.ts","path":"src/core/git_exclude.ts"},{"type":"read","cmd":"sed -n '1,300p' test/git_exclude.test.ts","name":"git_exclude.test.ts","path":"test/git_exclude.test.ts"},{"type":"read","cmd":"sed -n '1,150p' test/flight_exclude.test.ts","name":"flight_exclude.test.ts","path":"test/flight_exclude.test.ts"},{"type":"read","cmd":"sed -n '1,130p' src/flight.ts","name":"flight.ts","path":"src/flight.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"  }\n}\n\nfunction readExclude(file: string, expected: string): string {\n  const fd = openExclude(file, expected);\n  try {\n    return fs.readFileSync(fd, \"utf-8\");\n  } finally {\n    fs.closeSync(fd);\n  }\n}\n\nfunction appendExclude(file: string, expected: string, content: string): void {\n  const fd = openExclude(file, expected);\n  try {\n    fs.writeSync(fd, content);\n  } finally {\n    fs.closeSync(fd);\n  }\n}\n\n/**\n * Ensures .nexus/ is ignored by Git in the workspace (REQ-PER-105).\n * The self-contained rule protects state even when Git metadata is read-only;\n * info/exclude remains a best-effort convenience for older clients and status output.\n */\nexport function ensureGitExclude(workspace: string): void {\n  let excludePath: string | null = null;\n  try {\n    const out = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n      cwd: workspace,\n      encoding: \"utf-8\",\n      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n    }).trim();\n    if (out) {\n      excludePath = path.isAbsolute(out) ? out : path.resolve(workspace, out);\n    }\n  } catch {\n    // Fall back only when an info/exclude file is already available without Git.\n    const candidate = path.join(workspace, \".git\", \"info\", \"exclude\");\n    if (fs.existsSync(path.dirname(candidate))) {\n      excludePath = candidate;\n    }\n  }\n\n  if (!excludePath) return;\n\n  let commonDirPath: string | null = null;\n  let expectedExcludePath: string | null = null;\n  try {\n    const commonDir = execFileSync(\"git\", [\"rev-parse\", \"--git-common-dir\"], {\n      cwd: workspace,\n      encoding: \"utf-8\",\n      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n    }).trim();\n    commonDirPath = fs.realpathSync(path.resolve(workspace, commonDir));\n    expectedExcludePath = path.join(commonDirPath, \"info\", \"exclude\");\n    if (path.resolve(excludePath) !== expectedExcludePath) expectedExcludePath = null;\n  } catch {\n    // Updating the convenience file is optional; self-ignore verification below is authoritative.\n  }\n\n  const nexusDir = path.join(workspace, \".nexus\");\n  mkdirVerified(workspace, nexusDir);\n  const nexusGitIgnore = path.join(nexusDir, \".gitignore\");\n  try {\n    // Open the existing file without following links and bind the descriptor to\n    // the expected repository path before reading it.\n    readSelfIgnore(workspace, nexusGitIgnore);\n  } catch (error) {\n    if (typeof error === \"object\" && error !== null && \"code\" in error && error.code === \"ENOENT\") {\n      try {\n        writeExclusiveVerified(workspace, nexusGitIgnore, \"*\\n\");\n      } catch (createError) {\n        // Another safe creator may have won the exclusive-create race. Any\n        // link or redirected parent still fails in readSelfIgnore below.\n        if (typeof createError !== \"object\" || createError === null || !(\"code\" in createError) || createError.code !== \"EEXIST\") {\n          throw createError;\n        }\n      }\n    } else {\n      throw error;\n    }\n  }\n  const ignoreContent = readSelfIgnore(workspace, nexusGitIgnore);\n  const lastRule = ignoreContent\n    .split(/\\r?\\n/)\n    .map((line) => line.trimEnd())\n    .filter((line) => line.length > 0 && !line.startsWith(\"#\"))\n    .at(-1);\n  if (lastRule !== \"*\") {\n    const prefix = ignoreContent.length === 0 || ignoreContent.endsWith(\"\\n\") ? \"\" : \"\\n\";\n    appendSelfIgnore(workspace, nexusGitIgnore, `${prefix}*\\n`);\n  }\n\n  const isIgnored = (relativePath: string): boolean => {\n    try {\n      execFileSync(\"git\", [\"check-ignore\", \"--quiet\", \"--no-index\", \"--\", relativePath], {\n        cwd: workspace,\n        stdio: \"ignore\",\n      });\n      return true;\n    } catch (error) {\n      if (typeof error === \"object\" && error !== null && \"status\" in error && error.status === 1) {\n        return false;\n      }\n      throw new Error(`Could not verify whether ${relativePath} is ignored by Git`, { cause: error });\n    }\n  };\n\n  const protectedProbes = [\n    \".nexus/__nexus_ignore_probe__\",\n    \".nexus/.gitignore\",\n    \".nexus/flights/__nexus_ignore_probe__.flightlog\",\n    \".nexus/worktrees/__nexus_ignore_probe__/state.json\",\n    \".nexus/tasks/__nexus_ignore_probe__.json\",\n  ];\n  const allProbesIgnored = (): boolean => protectedProbes.every(isIgnored);\n  if (!allProbesIgnored()) {\n    throw new Error(\"Git still does not ignore all Nexus state paths after updating .nexus/.gitignore\");\n  }\n\n  // This file is not required for safety: .nexus/.gitignore provides the\n  // effective rule without mutating Git metadata. Keep the legacy rules when\n  // available, but tolerate read-only or unusual Git directories.\n  try {\n    if (!expectedExcludePath || !commonDirPath) return;\n\n    try {\n      readExclude(excludePath, expectedExcludePath);\n    } catch (error) {\n      if (typeof error !== \"object\" || error === null || !(\"code\" in error) || error.code !== \"ENOENT\") {\n        throw error;\n      }\n      try {\n        writeExclusiveVerified(commonDirPath, expectedExcludePath, \"\");\n      } catch (createError) {\n        // Another safe creator may have won the exclusive-create race.\n        if (typeof createError !== \"object\" || createError === null || !(\"code\" in createError) || createError.code !== \"EEXIST\") {\n          throw createError;\n        }\n      }\n    }\n\n    const protectedPaths = [\n      { path: \".nexus/\", rule: \".nexus/\" },\n      { path: \".nexus/worktrees/__nexus_ignore_probe__\", rule: \".nexus/worktrees/\" },\n      { path: \".nexus/flights/__nexus_ignore_probe__\", rule: \".nexus/flights/\" },\n    ];\n\n    for (const { path: relativePath, rule } of protectedPaths) {\n      const content = readExclude(excludePath, expectedExcludePath);\n      const lines = content.split(/\\r?\\n/);\n      const rules = new Set(lines);\n      const hasExactRule = rules.has(rule) || rules.has(`/${rule}`);\n      if (hasExactRule && isIgnored(relativePath)) continue;\n\n      if (hasExactRule) {\n        const lastExactRule = Math.max(lines.lastIndexOf(rule), lines.lastIndexOf(`/${rule}`));\n        const laterNegation = lines.slice(lastExactRule + 1).some((line) => line.trimStart().startsWith(\"!\"));\n        if (!laterNegation) {\n          throw new Error(`Git still does not ignore ${relativePath} after updating info/exclude`);\n        }\n      }\n\n      const prefix = content.length === 0 || content.endsWith(\"\\n\") ? \"\" : \"\\n\";\n      appendExclude(excludePath, expectedExcludePath, `${prefix}${rule}\\n`);\n      if (!isIgnored(relativePath)) {\n        throw new Error(`Git still does not ignore ${relativePath} after updating info/exclude`);\n      }\n    }\n  } catch {\n    // The verified self-ignore file already protects all Nexus-managed state.\n  }\n}\n/**\n * `.nexus/` must be ignored by Git even when `.git/info/exclude` already mentions the word in a\n * comment or an unrelated pattern. `/commit` uses `git add -A`, so state left trackable can be\n * staged into a user commit.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport { syncBuiltinESMExports } from \"node:module\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\nimport { ensureGitExclude } from \"../src/core/git_exclude.js\";\n\nfunction makeRepo(exclude: string | null): { root: string; excludePath: string } {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-git-exclude-\"));\n  execFileSync(\"git\", [\"init\", \"-q\"], { cwd: root });\n  const excludePath = path.join(root, \".git\", \"info\", \"exclude\");\n  fs.mkdirSync(path.dirname(excludePath), { recursive: true });\n  if (exclude === null) {\n    try { fs.unlinkSync(excludePath); } catch {}\n  } else {\n    fs.writeFileSync(excludePath, exclude);\n  }\n  return { root, excludePath };\n}\n\nfunction isIgnored(root: string, relative: string): boolean {\n  try {\n    execFileSync(\"git\", [\"check-ignore\", \"-q\", relative], { cwd: root, stdio: \"pipe\" });\n    return true;\n  } catch {\n    return false;\n  }\n}\n\ntest(\"a comment mentioning .nexus does not suppress the ignore rule\", () => {\n  const { root, excludePath } = makeRepo(\"# keep .nexus out of git status\\n\");\n  try {\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n    assert.match(fs.readFileSync(excludePath, \"utf8\"), /^\\.nexus\\/$/m);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"an unrelated pattern containing .nexus does not suppress the rule\", () => {\n  const { root, excludePath } = makeRepo(\".nexus-backup/\\n\");\n  try {\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n    assert.match(fs.readFileSync(excludePath, \"utf8\"), /^\\.nexus\\/$/m);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"existing exact rules are not duplicated\", () => {\n  const { root, excludePath } = makeRepo(\".nexus/\\n.nexus/worktrees/\\n.nexus/flights/\\n\");\n  try {\n    ensureGitExclude(root);\n    const lines = fs.readFileSync(excludePath, \"utf8\").split(/\\r?\\n/);\n    for (const rule of [\".nexus/\", \".nexus/worktrees/\", \".nexus/flights/\"]) {\n      assert.equal(lines.filter((line) => line === rule).length, 1, rule);\n    }\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a root-anchored rule is accepted without adding a duplicate\", () => {\n  const { root, excludePath } = makeRepo(\"/.nexus/\\n/.nexus/worktrees/\\n/.nexus/flights/\\n\");\n  try {\n    ensureGitExclude(root);\n    const text = fs.readFileSync(excludePath, \"utf8\");\n    assert.equal(text.includes(\"\\n.nexus/\\n\"), false);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"leading whitespace is not treated as an existing ignore rule\", () => {\n  const { root, excludePath } = makeRepo(\" .nexus/\\n\");\n  try {\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), false);\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n    assert.match(fs.readFileSync(excludePath, \"utf8\"), /\\n\\.nexus\\/\\n/);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a later negation is overridden by a verified positive rule\", () => {\n  const { root, excludePath } = makeRepo(\".nexus/\\n!.nexus/\\n\");\n  try {\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), false);\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n    assert.equal(isIgnored(root, \".nexus/worktrees/task/state.json\"), true);\n    const rules = fs.readFileSync(excludePath, \"utf8\").split(/\\r?\\n/);\n    assert.equal(isIgnored(root, \".nexus/.gitignore\"), true);\n    assert.ok(rules.lastIndexOf(\".nexus/\") >= 0);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a nested self-ignore protects Nexus state from higher-priority repository negations\", () => {\n  const { root } = makeRepo(\"\");\n  try {\n    fs.writeFileSync(\n      path.join(root, \".gitignore\"),\n      \".nexus/\\n!.nexus/\\n.nexus/tasks/__nexus_ignore_probe__\\n\",\n    );\n    assert.equal(isIgnored(root, \".nexus/tasks/__nexus_ignore_probe__\"), true);\n    assert.equal(isIgnored(root, \".nexus/\"), false);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), false);\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n    assert.equal(isIgnored(root, \".nexus/__nexus_ignore_probe__\"), true);\n    assert.equal(isIgnored(root, \".nexus/.gitignore\"), true);\n\n    fs.mkdirSync(path.join(root, \".nexus\", \"tasks\"), { recursive: true });\n    fs.writeFileSync(path.join(root, \".nexus\", \"tasks\", \"task.json\"), \"private state\");\n    execFileSync(\"git\", [\"check-ignore\", \"--quiet\", \"--no-index\", \".nexus/tasks/task.json\"], { cwd: root });\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a nested ignore negation cannot expose flight logs or worktree state\", () => {\n  const { root } = makeRepo(\"\");\n  try {\n    fs.mkdirSync(path.join(root, \".nexus\", \"flights\"), { recursive: true });\n    fs.mkdirSync(path.join(root, \".nexus\", \"worktrees\"), { recursive: true });\n    fs.writeFileSync(path.join(root, \".nexus\", \".gitignore\"), \"*\\n!flights/\\n!worktrees/\\n!tasks/\\n!tasks/**\\n\");\n    fs.writeFileSync(path.join(root, \".nexus\", \"flights\", \".gitignore\"), \"!*.flightlog\\n\");\n    fs.writeFileSync(path.join(root, \".nexus\", \"worktrees\", \".gitignore\"), \"!*.json\\n\");\n\n    ensureGitExclude(root);\n\n    for (const probe of [\n      \".nexus/.gitignore\",\n      \".nexus/flights/__nexus_ignore_probe__.flightlog\",\n      \".nexus/worktrees/__nexus_ignore_probe__/state.json\",\n      \".nexus/tasks/__nexus_ignore_probe__.json\",\n    ]) {\n      assert.equal(isIgnored(root, probe), true, `${probe} must remain ignored`);\n    }\n    const selfIgnoreRules = fs.readFileSync(path.join(root, \".nexus\", \".gitignore\"), \"utf8\").trimEnd().split(/\\r?\\n/);\n    assert.equal(selfIgnoreRules.at(-1), \"*\", \"a final catch-all must override existing negations\");\n    fs.mkdirSync(path.join(root, \".nexus\", \"tasks\"), { recursive: true });\n    fs.writeFileSync(path.join(root, \".nexus\", \"tasks\", \"task.json\"), \"private state\");\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a symlinked Nexus state directory is rejected before any outside write\", () => {\n  const { root } = makeRepo(\"\");\n  const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-git-exclude-outside-\"));\n  try {\n    fs.symlinkSync(outside, path.join(root, \".nexus\"), \"dir\");\n    assert.throws(() => ensureGitExclude(root), /\\.nexus is a symbolic link/);\n    assert.equal(fs.existsSync(path.join(outside, \".gitignore\")), false);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n    fs.rmSync(outside, { recursive: true, force: true });\n  }\n});\n\ntest(\"a symlink swap cannot write self-ignore content or alter external ignore rules\", () => {\n  for (const existingIgnore of [false, true]) {\n    const { root } = makeRepo(\"\");\n    const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-git-exclude-race-outside-\"));\n    const nexusDir = path.join(root, \".nexus\");\n    const movedNexusDir = path.join(root, \".nexus-before-race\");\n    const selfIgnorePath = path.join(nexusDir, \".gitignore\");\n    const outsideIgnorePath = path.join(outside, \".gitignore\");\n    let swapped = false;\n    const originalOpenSync = fs.openSync;\n\n    try {\n      if (existingIgnore) {\n        fs.mkdirSync(nexusDir);\n        fs.writeFileSync(selfIgnorePath, \"# operator rules\\n\");\n        fs.writeFileSync(outsideIgnorePath, \"external operator rules\\n\");\n      }\n\n      fs.openSync = ((file: fs.PathLike, flags: string | number, mode?: number) => {\n        if (\n          !swapped &&\n          typeof file === \"string\" &&\n          path.resolve(file) === selfIgnorePath &&\n          typeof flags === \"number\" &&\n          (flags & fs.constants.O_WRONLY) !== 0\n        ) {\n          swapped = true;\n          fs.renameSync(nexusDir, movedNexusDir);\n          fs.symlinkSync(outside, nexusDir, \"dir\");\n        }\n        return originalOpenSync(file, flags as number, mode);\n      }) as typeof fs.openSync;\n      syncBuiltinESMExports();\n\n      assert.throws(() => ensureGitExclude(root), /resolves to|changed location/);\n      assert.equal(swapped, true);\n      if (existingIgnore) {\n        assert.equal(fs.readFileSync(outsideIgnorePath, \"utf8\"), \"external operator rules\\n\");\n      } else {\n        assert.equal(fs.statSync(outsideIgnorePath).size, 0, \"failed verification leaves no content in the redirected file\");\n      }\n    } finally {\n      fs.openSync = originalOpenSync;\n      syncBuiltinESMExports();\n      if (fs.lstatSync(nexusDir, { throwIfNoEntry: false })?.isSymbolicLink()) {\n        fs.unlinkSync(nexusDir);\n      }\n      if (fs.existsSync(movedNexusDir)) fs.renameSync(movedNexusDir, nexusDir);\n      fs.rmSync(root, { recursive: true, force: true });\n      fs.rmSync(outside, { recursive: true, force: true });\n    }\n  }\n});\n\ntest(\"a hard-linked self-ignore file is rejected before changing its external link\", () => {\n  const { root } = makeRepo(\"\");\n  try {\n    const outsideFile = path.join(root, \"operator-owned-ignore-rules\");\n    const nexusDir = path.join(root, \".nexus\");\n    fs.mkdirSync(nexusDir);\n    fs.writeFileSync(outsideFile, \"operator rules\\n\");\n    fs.linkSync(outsideFile, path.join(nexusDir, \".gitignore\"));\n\n    assert.throws(() => ensureGitExclude(root), /hard-linked \\.nexus\\/\\.gitignore/);\n    assert.equal(fs.readFileSync(outsideFile, \"utf8\"), \"operator rules\\n\");\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a missing exclude file is created with the rules\", () => {\n  const { root, excludePath } = makeRepo(null);\n  try {\n    ensureGitExclude(root);\n    const rules = fs.readFileSync(excludePath, \"utf8\").split(/\\r?\\n/);\n    assert.ok(rules.includes(\".nexus/\"));\n    assert.ok(rules.includes(\".nexus/worktrees/\"));\n    assert.ok(rules.includes(\".nexus/flights/\"));\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a symlinked info/exclude is not followed or modified\", () => {\n  const { root, excludePath } = makeRepo(\"\");\n  const outside = path.join(root, \"operator-owned-rules\");\n  try {\n    fs.writeFileSync(outside, \"operator rules\\n\");\n    fs.unlinkSync(excludePath);\n    fs.symlinkSync(outside, excludePath);\n\n    ensureGitExclude(root);\n\n    assert.equal(fs.readFileSync(outside, \"utf8\"), \"operator rules\\n\");\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a hard-linked info/exclude is not modified\", () => {\n  const { root, excludePath } = makeRepo(\"\");\n  const outside = path.join(root, \"operator-owned-rules\");\n  try {\n    fs.writeFileSync(outside, \"operator rules\\n\");\n    fs.unlinkSync(excludePath);\n    fs.linkSync(outside, excludePath);\n\n    ensureGitExclude(root);\n\n    assert.equal(fs.readFileSync(outside, \"utf8\"), \"operator rules\\n\");\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a symlinked info directory does not redirect missing exclude creation\", () => {\n  const { root, excludePath } = makeRepo(null);\n  const infoDir = path.dirname(excludePath);\n  const movedInfoDir = path.join(root, \".git\", \"info-before-link\");\n  const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-git-exclude-info-outside-\"));\n  try {\n    fs.renameSync(infoDir, movedInfoDir);\nimport { test, describe, beforeEach, afterEach } from \"node:test\";\nimport assert from \"node:assert\";\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { execFileSync } from \"node:child_process\";\nimport { FlightRecorder } from \"../src/flight.js\";\nimport { WorktreeManager } from \"../src/worktree.js\";\nimport { ensureGitExclude } from \"../src/core/git_exclude.js\";\n\ndescribe(\"ACC-PER-05: Flight Logs & Telemetry Git Exclude (REQ-PER-105)\", () => {\n  let tmpDir: string;\n  let gitRepoDir: string;\n\n  beforeEach(() => {\n    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-flight-exclude-test-\"));\n    gitRepoDir = path.join(tmpDir, \"repo\");\n    fs.mkdirSync(gitRepoDir, { recursive: true });\n\n    execFileSync(\"git\", [\"init\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"config\", \"user.name\", \"Tester\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"config\", \"user.email\", \"tester@nexus.local\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"config\", \"commit.gpgsign\", \"false\"], { cwd: gitRepoDir });\n\n    fs.writeFileSync(path.join(gitRepoDir, \"README.md\"), \"# Test Repo\\n\");\n    execFileSync(\"git\", [\"add\", \".\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"commit\", \"-m\", \"Initial commit\"], { cwd: gitRepoDir });\n  });\n\n  afterEach(() => {\n    try {\n      fs.rmSync(tmpDir, { recursive: true, force: true });\n    } catch {}\n  });\n\n  test(\"ACC-PER-05: Fresh git repo with FlightRecorder writes telemetry but git status --porcelain shows nothing under .nexus/\", () => {\n    // Baseline: clean working tree\n    const initialStatus = execFileSync(\"git\", [\"status\", \"--porcelain\"], {\n      cwd: gitRepoDir,\n      encoding: \"utf-8\",\n    }).trim();\n    assert.strictEqual(initialStatus, \"\");\n\n    // Create FlightRecorder in repo\n    const recorder = new FlightRecorder(gitRepoDir);\n    recorder.startSession({ model: \"test-model\", prompt: \"Investigate bug\" });\n    recorder.recordTurnStart(1, \"Investigate bug\");\n    recorder.recordThought(1, \"Looking at files\");\n    recorder.recordSessionEnd(\"Done\", true);\n\n    // Verify flight log exists on disk\n    const flightLogPath = recorder.getLogPath();\n    assert.strictEqual(fs.existsSync(flightLogPath), true, \"Flight log must exist on disk\");\n\n    // ACC-PER-05 check: git status --porcelain must not show anything under .nexus/\n    const status = execFileSync(\"git\", [\"status\", \"--porcelain\"], {\n      cwd: gitRepoDir,\n      encoding: \"utf-8\",\n    }).trim();\n\n    assert.strictEqual(\n      status,\n      \"\",\n      `git status --porcelain must be completely clean; found:\\n${status}`\n    );\n\n    // Verify .git/info/exclude contains .nexus/\n    const excludePath = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n      cwd: gitRepoDir,\n      encoding: \"utf-8\",\n    }).trim();\n    const resolvedExclude = path.isAbsolute(excludePath) ? excludePath : path.resolve(gitRepoDir, excludePath);\n    assert.strictEqual(fs.existsSync(resolvedExclude), true, \"info/exclude must exist\");\n    const excludeContent = fs.readFileSync(resolvedExclude, \"utf-8\");\n    assert.ok(excludeContent.includes(\".nexus/\"), \"info/exclude must contain .nexus/\");\n  });\n\n  test(\"WorktreeManager defers .nexus exclusion until it creates workspace state\", () => {\n    const wm = new WorktreeManager(gitRepoDir);\n    assert.ok(wm.isGitRepo());\n\n    const excludePath = path.resolve(gitRepoDir, \".git\", \"info\", \"exclude\");\n    assert.strictEqual(fs.existsSync(excludePath), true);\n    const initialContent = fs.readFileSync(excludePath, \"utf-8\");\n    assert.equal(initialContent.includes(\".nexus/\"), false, \"constructing the manager must not mutate Git metadata\");\n\n    const created = wm.createWorktree(\"exclude-test\");\n    assert.equal(created.created, true);\n    const content = fs.readFileSync(excludePath, \"utf-8\");\n    assert.ok(content.includes(\".nexus/\"));\n    assert.ok(content.includes(\".nexus/worktrees/\"));\n    assert.ok(content.includes(\".nexus/flights/\"));\n\n    assert.equal(wm.discardWorktree(\"exclude-test\").success, true);\n  });\n\n  test(\"unavailable exclude metadata does not prevent startup or expose flight state\", () => {\n    const excludePath = path.resolve(gitRepoDir, \".git\", \"info\", \"exclude\");\n    fs.writeFileSync(excludePath, \"\");\n    fs.chmodSync(excludePath, 0o444);\n\n    assert.doesNotThrow(() => new WorktreeManager(gitRepoDir));\n    assert.equal(fs.existsSync(path.join(gitRepoDir, \".nexus\")), false);\n\n    const recorder = new FlightRecorder(gitRepoDir);\n    assert.equal(fs.existsSync(recorder.getLogPath()), false);\n    assert.equal(fs.existsSync(path.join(gitRepoDir, \".nexus\", \".gitignore\")), true);\n    assert.match(fs.readFileSync(path.join(gitRepoDir, \".nexus\", \".gitignore\"), \"utf8\"), /^\\*\\n$/);\n    assert.equal(fs.readFileSync(excludePath, \"utf8\"), \"\", \"read-only Git metadata must remain untouched\");\n    execFileSync(\"git\", [\"check-ignore\", \"--quiet\", \"--no-index\", \".nexus/flights/__test__\"], { cwd: gitRepoDir });\n\n    const status = execFileSync(\"git\", [\"status\", \"--porcelain\"], { cwd: gitRepoDir, encoding: \"utf8\" }).trim();\n    assert.equal(status, \"\", `Nexus state must remain ignored when info/exclude is unavailable; found:\\n${status}`);\n  });\n\n  test(\"a subdirectory workspace protects root worktree state when Git metadata is unavailable\", () => {\n    const workspace = path.join(gitRepoDir, \"packages\", \"app\");\n    fs.mkdirSync(workspace, { recursive: true });\n    const excludePath = path.resolve(gitRepoDir, \".git\", \"info\", \"exclude\");\n    fs.writeFileSync(excludePath, \"\");\n    fs.chmodSync(excludePath, 0o444);\n\n    const manager = new WorktreeManager(workspace);\n    let created = false;\n    try {\n      const result = manager.createWorktree(\"nested-workspace-exclude-test\");\n      created = result.created;\n      assert.equal(result.created, true);\n      assert.equal(fs.existsSync(path.join(gitRepoDir, \".nexus\", \".gitignore\")), true);\n      assert.equal(fs.existsSync(path.join(workspace, \".nexus\", \".gitignore\")), false);\n      execFileSync(\"git\", [\"check-ignore\", \"--quiet\", \"--no-index\", \".nexus/worktrees/nested-workspace-exclude-test\"], { cwd: gitRepoDir });\n\n      const status = execFileSync(\"git\", [\"status\", \"--porcelain\"], { cwd: gitRepoDir, encoding: \"utf8\" }).trim();\n      assert.equal(status, \"\", `root worktree state must remain ignored; found:\\n${status}`);\n    } finally {\n      fs.chmodSync(excludePath, 0o600);\n      if (created) assert.equal(manager.discardWorktree(\"nested-workspace-exclude-test\").success, true);\n    }\n  });\n\n  test(\"an ineffective read-only self-ignore rule blocks flight state writes\", () => {\n    const nexusDir = path.join(gitRepoDir, \".nexus\");\n    fs.mkdirSync(nexusDir);\n    const selfIgnorePath = path.join(nexusDir, \".gitignore\");\n    fs.writeFileSync(selfIgnorePath, \"!*\\n\");\n    fs.chmodSync(selfIgnorePath, 0o444);\n\n    assert.throws(() => new FlightRecorder(gitRepoDir));\n    assert.equal(fs.existsSync(path.join(nexusDir, \"flights\")), false, \"flight state must not be written when ignore verification fails\");\n  });\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport { execFileSync } from \"node:child_process\";\nimport { InformationFlowBoundary } from \"./core/egress.js\";\nimport { ensurePrivateDir, appendPrivateFile } from \"./core/durable_file.js\";\nimport { ensureGitExclude } from \"./core/git_exclude.js\";\n\nexport type FlightEventType =\n  | \"session_start\"\n  | \"turn_start\"\n  | \"thought\"\n  | \"tool_call\"\n  | \"tool_result\"\n  | \"durable_state\"\n  | \"file_diff\"\n  | \"middleware_rewrite\"\n  | \"turn_end\"\n  | \"session_end\";\n\nexport interface FlightEvent {\n  eventId: string;\n  timestamp: string;\n  type: FlightEventType;\n  step?: number;\n  payload: Record<string, any>;\n}\n\nexport interface FlightManifest {\n  flightId: string;\n  recordedAt: string;\n  workspace: string;\n  model: string;\n  endpoint: string;\n  initialCommit?: string;\n  initialBranch?: string;\n  totalSteps?: number;\n  taskPrompt?: string;\n  status: \"in_progress\" | \"completed\" | \"failed\";\n  summary?: string;\n}\n\n/**\n * Deterministic Flight Recorder for Agentic Code Execution\n * Records prompts, thoughts, tool calls, diffs, and durable state transitions into\n * append-only .flightlog archives for exact post-mortem replay and audit.\n */\nexport class FlightRecorder {\n  private workspace: string;\n  private flightId: string;\n  private flightLogPath: string;\n  private isRecording: boolean = false;\n  private startTime: number = Date.now();\n\n  constructor(workspace: string, flightId?: string) {\n    this.workspace = path.resolve(workspace);\n    this.flightId = flightId || `flight-${new Date().toISOString().replace(/[:.]/g, \"-\")}-${randomUUID().slice(0, 6)}`;\n    ensureGitExclude(this.workspace);\n    const flightsDir = path.join(this.workspace, \".nexus\", \"flights\");\n    ensurePrivateDir(flightsDir);\n    this.flightLogPath = path.join(flightsDir, `${this.flightId}.flightlog`);\n  }\n\n  public getFlightId(): string {\n    return this.flightId;\n  }\n\n  public getLogPath(): string {\n    return this.flightLogPath;\n  }\n\n  public isSessionActive(): boolean {\n    return this.isRecording;\n  }\n\n  private appendEvent(type: FlightEventType, step: number | undefined, payload: Record<string, any>): FlightEvent {\n    // Flightlogs are durable telemetry. Sanitize the complete event before its\n    // only write path; a classifier failure must not fall through to plaintext\n    // or prevent the authorized local capability from executing.\n    const eventId = `evt-${randomUUID().slice(0, 8)}`;\n    const timestamp = new Date().toISOString();\n    let sanitizedPayload: Record<string, any>;\n    try {\n      sanitizedPayload = InformationFlowBoundary.getGlobalInstance().redactForTelemetry(payload);\n    } catch {\n      // Do not propagate classifier diagnostics that could echo inspected input.\n      return {\n        eventId,\n        timestamp,\n        type,\n        step,\n        payload: { recordingSkipped: true, reason: \"sanitization_failed\" },\n      };\n    }\n    const event: FlightEvent = {\n      eventId,\n      timestamp,\n      type,\n      step,\n      payload: sanitizedPayload,\n    };\n    try {\n      appendPrivateFile(this.flightLogPath, JSON.stringify(event) + \"\\n\");\n    } catch {\n      // Ignore flightlog append errors in restricted environments\n    }\n    return event;\n  }\n\n  public startSession(config: {\n    model: string;\n    endpoint: string;\n    taskPrompt?: string;\n  }): FlightManifest {\n    this.isRecording = true;\n    this.startTime = Date.now();\n\n    let initialCommit: string | undefined;\n    let initialBranch: string | undefined;\n\n    try {\n      initialCommit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], {\n        cwd: this.workspace,\n        encoding: \"utf-8\",\n        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n      }).trim();\n      initialBranch = execFileSync(\"git\", [\"rev-parse\", \"--abbrev-ref\", \"HEAD\"], {\n        cwd: this.workspace,\n        encoding: \"utf-8\",\n        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n","exit_code":0,"duration":{"secs":1,"nanos":32435331}},"started_at_ms":1792894933279,"completed_at_ms":1792894934312}}
{"timestamp":"2026-10-25T02:22:15.289Z","ordinal":320313,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a170dd-a0f9-78e0-8055-c5ca76c5e593","call_id":"call_629ba8556bf94e3b83b7f3fdcebda467","output":[{"type":"input_text","text":"Script completed\nWall time 3.3 seconds\nOutput:\n"},{"type":"input_text","text":"  }\n}\n\nfunction readExclude(file: string, expected: string): string {\n  const fd = openExclude(file, expected);\n  try {\n    return fs.readFileSync(fd, \"utf-8\");\n  } finally {\n    fs.closeSync(fd);\n  }\n}\n\nfunction appendExclude(file: string, expected: string, content: string): void {\n  const fd = openExclude(file, expected);\n  try {\n    fs.writeSync(fd, content);\n  } finally {\n    fs.closeSync(fd);\n  }\n}\n\n/**\n * Ensures .nexus/ is ignored by Git in the workspace (REQ-PER-105).\n * The self-contained rule protects state even when Git metadata is read-only;\n * info/exclude remains a best-effort convenience for older clients and status output.\n */\nexport function ensureGitExclude(workspace: string): void {\n  let excludePath: string | null = null;\n  try {\n    const out = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n      cwd: workspace,\n      encoding: \"utf-8\",\n      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n    }).trim();\n    if (out) {\n      excludePath = path.isAbsolute(out) ? out : path.resolve(workspace, out);\n    }\n  } catch {\n    // Fall back only when an info/exclude file is already available without Git.\n    const candidate = path.join(workspace, \".git\", \"info\", \"exclude\");\n    if (fs.existsSync(path.dirname(candidate))) {\n      excludePath = candidate;\n    }\n  }\n\n  if (!excludePath) return;\n\n  let commonDirPath: string | null = null;\n  let expectedExcludePath: string | null = null;\n  try {\n    const commonDir = execFileSync(\"git\", [\"rev-parse\", \"--git-common-dir\"], {\n      cwd: workspace,\n      encoding: \"utf-8\",\n      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n    }).trim();\n    commonDirPath = fs.realpathSync(path.resolve(workspace, commonDir));\n    expectedExcludePath = path.join(commonDirPath, \"info\", \"exclude\");\n    if (path.resolve(excludePath) !== expectedExcludePath) expectedExcludePath = null;\n  } catch {\n    // Updating the convenience file is optional; self-ignore verification below is authoritative.\n  }\n\n  const nexusDir = path.join(workspace, \".nexus\");\n  mkdirVerified(workspace, nexusDir);\n  const nexusGitIgnore = path.join(nexusDir, \".gitignore\");\n  try {\n    // Open the existing file without following links and bind the descriptor to\n    // the expected repository path before reading it.\n    readSelfIgnore(workspace, nexusGitIgnore);\n  } catch (error) {\n    if (typeof error === \"object\" && error !== null && \"code\" in error && error.code === \"ENOENT\") {\n      try {\n        writeExclusiveVerified(workspace, nexusGitIgnore, \"*\\n\");\n      } catch (createError) {\n        // Another safe creator may have won the exclusive-create race. Any\n        // link or redirected parent still fails in readSelfIgnore below.\n        if (typeof createError !== \"object\" || createError === null || !(\"code\" in createError) || createError.code !== \"EEXIST\") {\n          throw createError;\n        }\n      }\n    } else {\n      throw error;\n    }\n  }\n  const ignoreContent = readSelfIgnore(workspace, nexusGitIgnore);\n  const lastRule = ignoreContent\n    .split(/\\r?\\n/)\n    .map((line) => line.trimEnd())\n    .filter((line) => line.length > 0 && !line.startsWith(\"#\"))\n    .at(-1);\n  if (lastRule !== \"*\") {\n    const prefix = ignoreContent.length === 0 || ignoreContent.endsWith(\"\\n\") ? \"\" : \"\\n\";\n    appendSelfIgnore(workspace, nexusGitIgnore, `${prefix}*\\n`);\n  }\n\n  const isIgnored = (relativePath: string): boolean => {\n    try {\n      execFileSync(\"git\", [\"check-ignore\", \"--quiet\", \"--no-index\", \"--\", relativePath], {\n        cwd: workspace,\n        stdio: \"ignore\",\n      });\n      return true;\n    } catch (error) {\n      if (typeof error === \"object\" && error !== null && \"status\" in error && error.status === 1) {\n        return false;\n      }\n      throw new Error(`Could not verify whether ${relativePath} is ignored by Git`, { cause: error });\n    }\n  };\n\n  const protectedProbes = [\n    \".nexus/__nexus_ignore_probe__\",\n    \".nexus/.gitignore\",\n    \".nexus/flights/__nexus_ignore_probe__.flightlog\",\n    \".nexus/worktrees/__nexus_ignore_probe__/state.json\",\n    \".nexus/tasks/__nexus_ignore_probe__.json\",\n  ];\n  const allProbesIgnored = (): boolean => protectedProbes.every(isIgnored);\n  if (!allProbesIgnored()) {\n    throw new Error(\"Git still does not ignore all Nexus state paths after updating .nexus/.gitignore\");\n  }\n\n  // This file is not required for safety: .nexus/.gitignore provides the\n  // effective rule without mutating Git metadata. Keep the legacy rules when\n  // available, but tolerate read-only or unusual Git directories.\n  try {\n    if (!expectedExcludePath || !commonDirPath) return;\n\n    try {\n      readExclude(excludePath, expectedExcludePath);\n    } catch (error) {\n      if (typeof error !== \"object\" || error === null || !(\"code\" in error) || error.code !== \"ENOENT\") {\n        throw error;\n      }\n      try {\n        writeExclusiveVerified(commonDirPath, expectedExcludePath, \"\");\n      } catch (createError) {\n        // Another safe creator may have won the exclusive-create race.\n        if (typeof createError !== \"object\" || createError === null || !(\"code\" in createError) || createError.code !== \"EEXIST\") {\n          throw createError;\n        }\n      }\n    }\n\n    const protectedPaths = [\n      { path: \".nexus/\", rule: \".nexus/\" },\n      { path: \".nexus/worktrees/__nexus_ignore_probe__\", rule: \".nexus/worktrees/\" },\n      { path: \".nexus/flights/__nexus_ignore_probe__\", rule: \".nexus/flights/\" },\n    ];\n\n    for (const { path: relativePath, rule } of protectedPaths) {\n      const content = readExclude(excludePath, expectedExcludePath);\n      const lines = content.split(/\\r?\\n/);\n      const rules = new Set(lines);\n      const hasExactRule = rules.has(rule) || rules.has(`/${rule}`);\n      if (hasExactRule && isIgnored(relativePath)) continue;\n\n      if (hasExactRule) {\n        const lastExactRule = Math.max(lines.lastIndexOf(rule), lines.lastIndexOf(`/${rule}`));\n        const laterNegation = lines.slice(lastExactRule + 1).some((line) => line.trimStart().startsWith(\"!\"));\n        if (!laterNegation) {\n          throw new Error(`Git still does not ignore ${relativePath} after updating info/exclude`);\n        }\n      }\n\n      const prefix = content.length === 0 || content.endsWith(\"\\n\") ? \"\" : \"\\n\";\n      appendExclude(excludePath, expectedExcludePath, `${prefix}${rule}\\n`);\n      if (!isIgnored(relativePath)) {\n        throw new Error(`Git still does not ignore ${relativePath} after updating info/exclude`);\n      }\n    }\n  } catch {\n    // The verified self-ignore file already protects all Nexus-managed state.\n  }\n}\n/**\n * `.nexus/` must be ignored by Git even when `.git/info/exclude` already mentions the word in a\n * comment or an unrelated pattern. `/commit` uses `git add -A`, so state left trackable can be\n * staged into a user commit.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport { syncBuiltinESMExports } from \"node:module\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\nimport { ensureGitExclude } from \"../src/core/git_exclude.js\";\n\nfunction makeRepo(exclude: string | null): { root: string; excludePath: string } {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-git-exclude-\"));\n  execFileSync(\"git\", [\"init\", \"-q\"], { cwd: root });\n  const excludePath = path.join(root, \".git\", \"info\", \"exclude\");\n  fs.mkdirSync(path.dirname(excludePath), { recursive: true });\n  if (exclude === null) {\n    try { fs.unlinkSync(excludePath); } catch {}\n  } else {\n    fs.writeFileSync(excludePath, exclude);\n  }\n  return { root, excludePath };\n}\n\nfunction isIgnored(root: string, relative: string): boolean {\n  try {\n    execFileSync(\"git\", [\"check-ignore\", \"-q\", relative], { cwd: root, stdio: \"pipe\" });\n    return true;\n  } catch {\n    return false;\n  }\n}\n\ntest(\"a comment mentioning .nexus does not suppress the ignore rule\", () => {\n  const { root, excludePath } = makeRepo(\"# keep .nexus out of git status\\n\");\n  try {\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n    assert.match(fs.readFileSync(excludePath, \"utf8\"), /^\\.nexus\\/$/m);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"an unrelated pattern containing .nexus does not suppress the rule\", () => {\n  const { root, excludePath } = makeRepo(\".nexus-backup/\\n\");\n  try {\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n    assert.match(fs.readFileSync(excludePath, \"utf8\"), /^\\.nexus\\/$/m);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"existing exact rules are not duplicated\", () => {\n  const { root, excludePath } = makeRepo(\".nexus/\\n.nexus/worktrees/\\n.nexus/flights/\\n\");\n  try {\n    ensureGitExclude(root);\n    const lines = fs.readFileSync(excludePath, \"utf8\").split(/\\r?\\n/);\n    for (const rule of [\".nexus/\", \".nexus/worktrees/\", \".nexus/flights/\"]) {\n      assert.equal(lines.filter((line) => line === rule).length, 1, rule);\n    }\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a root-anchored rule is accepted without adding a duplicate\", () => {\n  const { root, excludePath } = makeRepo(\"/.nexus/\\n/.nexus/worktrees/\\n/.nexus/flights/\\n\");\n  try {\n    ensureGitExclude(root);\n    const text = fs.readFileSync(excludePath, \"utf8\");\n    assert.equal(text.includes(\"\\n.nexus/\\n\"), false);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"leading whitespace is not treated as an existing ignore rule\", () => {\n  const { root, excludePath } = makeRepo(\" .nexus/\\n\");\n  try {\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), false);\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n    assert.match(fs.readFileSync(excludePath, \"utf8\"), /\\n\\.nexus\\/\\n/);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a later negation is overridden by a verified positive rule\", () => {\n  const { root, excludePath } = makeRepo(\".nexus/\\n!.nexus/\\n\");\n  try {\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), false);\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n    assert.equal(isIgnored(root, \".nexus/worktrees/task/state.json\"), true);\n    const rules = fs.readFileSync(excludePath, \"utf8\").split(/\\r?\\n/);\n    assert.equal(isIgnored(root, \".nexus/.gitignore\"), true);\n    assert.ok(rules.lastIndexOf(\".nexus/\") >= 0);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a nested self-ignore protects Nexus state from higher-priority repository negations\", () => {\n  const { root } = makeRepo(\"\");\n  try {\n    fs.writeFileSync(\n      path.join(root, \".gitignore\"),\n      \".nexus/\\n!.nexus/\\n.nexus/tasks/__nexus_ignore_probe__\\n\",\n    );\n    assert.equal(isIgnored(root, \".nexus/tasks/__nexus_ignore_probe__\"), true);\n    assert.equal(isIgnored(root, \".nexus/\"), false);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), false);\n    ensureGitExclude(root);\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n    assert.equal(isIgnored(root, \".nexus/__nexus_ignore_probe__\"), true);\n    assert.equal(isIgnored(root, \".nexus/.gitignore\"), true);\n\n    fs.mkdirSync(path.join(root, \".nexus\", \"tasks\"), { recursive: true });\n    fs.writeFileSync(path.join(root, \".nexus\", \"tasks\", \"task.json\"), \"private state\");\n    execFileSync(\"git\", [\"check-ignore\", \"--quiet\", \"--no-index\", \".nexus/tasks/task.json\"], { cwd: root });\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a nested ignore negation cannot expose flight logs or worktree state\", () => {\n  const { root } = makeRepo(\"\");\n  try {\n    fs.mkdirSync(path.join(root, \".nexus\", \"flights\"), { recursive: true });\n    fs.mkdirSync(path.join(root, \".nexus\", \"worktrees\"), { recursive: true });\n    fs.writeFileSync(path.join(root, \".nexus\", \".gitignore\"), \"*\\n!flights/\\n!worktrees/\\n!tasks/\\n!tasks/**\\n\");\n    fs.writeFileSync(path.join(root, \".nexus\", \"flights\", \".gitignore\"), \"!*.flightlog\\n\");\n    fs.writeFileSync(path.join(root, \".nexus\", \"worktrees\", \".gitignore\"), \"!*.json\\n\");\n\n    ensureGitExclude(root);\n\n    for (const probe of [\n      \".nexus/.gitignore\",\n      \".nexus/flights/__nexus_ignore_probe__.flightlog\",\n      \".nexus/worktrees/__nexus_ignore_probe__/state.json\",\n      \".nexus/tasks/__nexus_ignore_probe__.json\",\n    ]) {\n      assert.equal(isIgnored(root, probe), true, `${probe} must remain ignored`);\n    }\n    const selfIgnoreRules = fs.readFileSync(path.join(root, \".nexus\", \".gitignore\"), \"utf8\").trimEnd().split(/\\r?\\n/);\n    assert.equal(selfIgnoreRules.at(-1), \"*\", \"a final catch-all must override existing negations\");\n    fs.mkdirSync(path.join(root, \".nexus\", \"tasks\"), { recursive: true });\n    fs.writeFileSync(path.join(root, \".nexus\", \"tasks\", \"task.json\"), \"private state\");\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a symlinked Nexus state directory is rejected before any outside write\", () => {\n  const { root } = makeRepo(\"\");\n  const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-git-exclude-outside-\"));\n  try {\n    fs.symlinkSync(outside, path.join(root, \".nexus\"), \"dir\");\n    assert.throws(() => ensureGitExclude(root), /\\.nexus is a symbolic link/);\n    assert.equal(fs.existsSync(path.join(outside, \".gitignore\")), false);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n    fs.rmSync(outside, { recursive: true, force: true });\n  }\n});\n\ntest(\"a symlink swap cannot write self-ignore content or alter external ignore rules\", () => {\n  for (const existingIgnore of [false, true]) {\n    const { root } = makeRepo(\"\");\n    const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-git-exclude-race-outside-\"));\n    const nexusDir = path.join(root, \".nexus\");\n    const movedNexusDir = path.join(root, \".nexus-before-race\");\n    const selfIgnorePath = path.join(nexusDir, \".gitignore\");\n    const outsideIgnorePath = path.join(outside, \".gitignore\");\n    let swapped = false;\n    const originalOpenSync = fs.openSync;\n\n    try {\n      if (existingIgnore) {\n        fs.mkdirSync(nexusDir);\n        fs.writeFileSync(selfIgnorePath, \"# operator rules\\n\");\n        fs.writeFileSync(outsideIgnorePath, \"external operator rules\\n\");\n      }\n\n      fs.openSync = ((file: fs.PathLike, flags: string | number, mode?: number) => {\n        if (\n          !swapped &&\n          typeof file === \"string\" &&\n          path.resolve(file) === selfIgnorePath &&\n          typeof flags === \"number\" &&\n          (flags & fs.constants.O_WRONLY) !== 0\n        ) {\n          swapped = true;\n          fs.renameSync(nexusDir, movedNexusDir);\n          fs.symlinkSync(outside, nexusDir, \"dir\");\n        }\n        return originalOpenSync(file, flags as number, mode);\n      }) as typeof fs.openSync;\n      syncBuiltinESMExports();\n\n      assert.throws(() => ensureGitExclude(root), /resolves to|changed location/);\n      assert.equal(swapped, true);\n      if (existingIgnore) {\n        assert.equal(fs.readFileSync(outsideIgnorePath, \"utf8\"), \"external operator rules\\n\");\n      } else {\n        assert.equal(fs.statSync(outsideIgnorePath).size, 0, \"failed verification leaves no content in the redirected file\");\n      }\n    } finally {\n      fs.openSync = originalOpenSync;\n      syncBuiltinESMExports();\n      if (fs.lstatSync(nexusDir, { throwIfNoEntry: false })?.isSymbolicLink()) {\n        fs.unlinkSync(nexusDir);\n      }\n      if (fs.existsSync(movedNexusDir)) fs.renameSync(movedNexusDir, nexusDir);\n      fs.rmSync(root, { recursive: true, force: true });\n      fs.rmSync(outside, { recursive: true, force: true });\n    }\n  }\n});\n\ntest(\"a hard-linked self-ignore file is rejected before changing its external link\", () => {\n  const { root } = makeRepo(\"\");\n  try {\n    const outsideFile = path.join(root, \"operator-owned-ignore-rules\");\n    const nexusDir = path.join(root, \".nexus\");\n    fs.mkdirSync(nexusDir);\n    fs.writeFileSync(outsideFile, \"operator rules\\n\");\n    fs.linkSync(outsideFile, path.join(nexusDir, \".gitignore\"));\n\n    assert.throws(() => ensureGitExclude(root), /hard-linked \\.nexus\\/\\.gitignore/);\n    assert.equal(fs.readFileSync(outsideFile, \"utf8\"), \"operator rules\\n\");\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a missing exclude file is created with the rules\", () => {\n  const { root, excludePath } = makeRepo(null);\n  try {\n    ensureGitExclude(root);\n    const rules = fs.readFileSync(excludePath, \"utf8\").split(/\\r?\\n/);\n    assert.ok(rules.includes(\".nexus/\"));\n    assert.ok(rules.includes(\".nexus/worktrees/\"));\n    assert.ok(rules.includes(\".nexus/flights/\"));\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a symlinked info/exclude is not followed or modified\", () => {\n  const { root, excludePath } = makeRepo(\"\");\n  const outside = path.join(root, \"operator-owned-rules\");\n  try {\n    fs.writeFileSync(outside, \"operator rules\\n\");\n    fs.unlinkSync(excludePath);\n    fs.symlinkSync(outside, excludePath);\n\n    ensureGitExclude(root);\n\n    assert.equal(fs.readFileSync(outside, \"utf8\"), \"operator rules\\n\");\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a hard-linked info/exclude is not modified\", () => {\n  const { root, excludePath } = makeRepo(\"\");\n  const outside = path.join(root, \"operator-owned-rules\");\n  try {\n    fs.writeFileSync(outside, \"operator rules\\n\");\n    fs.unlinkSync(excludePath);\n    fs.linkSync(outside, excludePath);\n\n    ensureGitExclude(root);\n\n    assert.equal(fs.readFileSync(outside, \"utf8\"), \"operator rules\\n\");\n    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"a symlinked info directory does not redirect missing exclude creation\", () => {\n  const { root, excludePath } = makeRepo(null);\n  const infoDir = path.dirname(excludePath);\n  const movedInfoDir = path.join(root, \".git\", \"info-before-link\");\n  const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-git-exclude-info-outside-\"));\n  try {\n    fs.renameSync(infoDir, movedInfoDir);\nimport { test, describe, beforeEach, afterEach } from \"node:test\";\nimport assert from \"node:assert\";\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { execFileSync } from \"node:child_process\";\nimport { FlightRecorder } from \"../src/flight.js\";\nimport { WorktreeManager } from \"../src/worktree.js\";\nimport { ensureGitExclude } from \"../src/core/git_exclude.js\";\n\ndescribe(\"ACC-PER-05: Flight Logs & Telemetry Git Exclude (REQ-PER-105)\", () => {\n  let tmpDir: string;\n  let gitRepoDir: string;\n\n  beforeEach(() => {\n    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-flight-exclude-test-\"));\n    gitRepoDir = path.join(tmpDir, \"repo\");\n    fs.mkdirSync(gitRepoDir, { recursive: true });\n\n    execFileSync(\"git\", [\"init\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"config\", \"user.name\", \"Tester\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"config\", \"user.email\", \"tester@nexus.local\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"config\", \"commit.gpgsign\", \"false\"], { cwd: gitRepoDir });\n\n    fs.writeFileSync(path.join(gitRepoDir, \"README.md\"), \"# Test Repo\\n\");\n    execFileSync(\"git\", [\"add\", \".\"], { cwd: gitRepoDir });\n    execFileSync(\"git\", [\"commit\", \"-m\", \"Initial commit\"], { cwd: gitRepoDir });\n  });\n\n  afterEach(() => {\n    try {\n      fs.rmSync(tmpDir, { recursive: true, force: true });\n    } catch {}\n  });\n\n  test(\"ACC-PER-05: Fresh git repo with FlightRecorder writes telemetry but git status --porcelain shows nothing under .nexus/\", () => {\n    // Baseline: clean working tree\n    const initialStatus = execFileSync(\"git\", [\"status\", \"--porcelain\"], {\n      cwd: gitRepoDir,\n      encoding: \"utf-8\",\n    }).trim();\n    assert.strictEqual(initialStatus, \"\");\n\n    // Create FlightRecorder in repo\n    const recorder = new FlightRecorder(gitRepoDir);\n    recorder.startSession({ model: \"test-model\", prompt: \"Investigate bug\" });\n    recorder.recordTurnStart(1, \"Investigate bug\");\n    recorder.recordThought(1, \"Looking at files\");\n    recorder.recordSessionEnd(\"Done\", true);\n\n    // Verify flight log exists on disk\n    const flightLogPath = recorder.getLogPath();\n    assert.strictEqual(fs.existsSync(flightLogPath), true, \"Flight log must exist on disk\");\n\n    // ACC-PER-05 check: git status --porcelain must not show anything under .nexus/\n    const status = execFileSync(\"git\", [\"status\", \"--porcelain\"], {\n      cwd: gitRepoDir,\n      encoding: \"utf-8\",\n    }).trim();\n\n    assert.strictEqual(\n      status,\n      \"\",\n      `git status --porcelain must be completely clean; found:\\n${status}`\n    );\n\n    // Verify .git/info/exclude contains .nexus/\n    const excludePath = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n      cwd: gitRepoDir,\n      encoding: \"utf-8\",\n    }).trim();\n    const resolvedExclude = path.isAbsolute(excludePath) ? excludePath : path.resolve(gitRepoDir, excludePath);\n    assert.strictEqual(fs.existsSync(resolvedExclude), true, \"info/exclude must exist\");\n    const excludeContent = fs.readFileSync(resolvedExclude, \"utf-8\");\n    assert.ok(excludeContent.includes(\".nexus/\"), \"info/exclude must contain .nexus/\");\n  });\n\n  test(\"WorktreeManager defers .nexus exclusion until it creates workspace state\", () => {\n    const wm = new WorktreeManager(gitRepoDir);\n    assert.ok(wm.isGitRepo());\n\n    const excludePath = path.resolve(gitRepoDir, \".git\", \"info\", \"exclude\");\n    assert.strictEqual(fs.existsSync(excludePath), true);\n    const initialContent = fs.readFileSync(excludePath, \"utf-8\");\n    assert.equal(initialContent.includes(\".nexus/\"), false, \"constructing the manager must not mutate Git metadata\");\n\n    const created = wm.createWorktree(\"exclude-test\");\n    assert.equal(created.created, true);\n    const content = fs.readFileSync(excludePath, \"utf-8\");\n    assert.ok(content.includes(\".nexus/\"));\n    assert.ok(content.includes(\".nexus/worktrees/\"));\n    assert.ok(content.includes(\".nexus/flights/\"));\n\n    assert.equal(wm.discardWorktree(\"exclude-test\").success, true);\n  });\n\n  test(\"unavailable exclude metadata does not prevent startup or expose flight state\", () => {\n    const excludePath = path.resolve(gitRepoDir, \".git\", \"info\", \"exclude\");\n    fs.writeFileSync(excludePath, \"\");\n    fs.chmodSync(excludePath, 0o444);\n\n    assert.doesNotThrow(() => new WorktreeManager(gitRepoDir));\n    assert.equal(fs.existsSync(path.join(gitRepoDir, \".nexus\")), false);\n\n    const recorder = new FlightRecorder(gitRepoDir);\n    assert.equal(fs.existsSync(recorder.getLogPath()), false);\n    assert.equal(fs.existsSync(path.join(gitRepoDir, \".nexus\", \".gitignore\")), true);\n    assert.match(fs.readFileSync(path.join(gitRepoDir, \".nexus\", \".gitignore\"), \"utf8\"), /^\\*\\n$/);\n    assert.equal(fs.readFileSync(excludePath, \"utf8\"), \"\", \"read-only Git metadata must remain untouched\");\n    execFileSync(\"git\", [\"check-ignore\", \"--quiet\", \"--no-index\", \".nexus/flights/__test__\"], { cwd: gitRepoDir });\n\n    const status = execFileSync(\"git\", [\"status\", \"--porcelain\"], { cwd: gitRepoDir, encoding: \"utf8\" }).trim();\n    assert.equal(status, \"\", `Nexus state must remain ignored when info/exclude is unavailable; found:\\n${status}`);\n  });\n\n  test(\"a subdirectory workspace protects root worktree state when Git metadata is unavailable\", () => {\n    const workspace = path.join(gitRepoDir, \"packages\", \"app\");\n    fs.mkdirSync(workspace, { recursive: true });\n    const excludePath = path.resolve(gitRepoDir, \".git\", \"info\", \"exclude\");\n    fs.writeFileSync(excludePath, \"\");\n    fs.chmodSync(excludePath, 0o444);\n\n    const manager = new WorktreeManager(workspace);\n    let created = false;\n    try {\n      const result = manager.createWorktree(\"nested-workspace-exclude-test\");\n      created = result.created;\n      assert.equal(result.created, true);\n      assert.equal(fs.existsSync(path.join(gitRepoDir, \".nexus\", \".gitignore\")), true);\n      assert.equal(fs.existsSync(path.join(workspace, \".nexus\", \".gitignore\")), false);\n      execFileSync(\"git\", [\"check-ignore\", \"--quiet\", \"--no-index\", \".nexus/worktrees/nested-workspace-exclude-test\"], { cwd: gitRepoDir });\n\n      const status = execFileSync(\"git\", [\"status\", \"--porcelain\"], { cwd: gitRepoDir, encoding: \"utf8\" }).trim();\n      assert.equal(status, \"\", `root worktree state must remain ignored; found:\\n${status}`);\n    } finally {\n      fs.chmodSync(excludePath, 0o600);\n      if (created) assert.equal(manager.discardWorktree(\"nested-workspace-exclude-test\").success, true);\n    }\n  });\n\n  test(\"an ineffective read-only self-ignore rule blocks flight state writes\", () => {\n    const nexusDir = path.join(gitRepoDir, \".nexus\");\n    fs.mkdirSync(nexusDir);\n    const selfIgnorePath = path.join(nexusDir, \".gitignore\");\n    fs.writeFileSync(selfIgnorePath, \"!*\\n\");\n    fs.chmodSync(selfIgnorePath, 0o444);\n\n    assert.throws(() => new FlightRecorder(gitRepoDir));\n    assert.equal(fs.existsSync(path.join(nexusDir, \"flights\")), false, \"flight state must not be written when ignore verification fails\");\n  });\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport { execFileSync } from \"node:child_process\";\nimport { InformationFlowBoundary } from \"./core/egress.js\";\nimport { ensurePrivateDir, appendPrivateFile } from \"./core/durable_file.js\";\nimport { ensureGitExclude } from \"./core/git_exclude.js\";\n\nexport type FlightEventType =\n  | \"session_start\"\n  | \"turn_start\"\n  | \"thought\"\n  | \"tool_call\"\n  | \"tool_result\"\n  | \"durable_state\"\n  | \"file_diff\"\n  | \"middleware_rewrite\"\n  | \"turn_end\"\n  | \"session_end\";\n\nexport interface FlightEvent {\n  eventId: string;\n  timestamp: string;\n  type: FlightEventType;\n  step?: number;\n  payload: Record<string, any>;\n}\n\nexport interface FlightManifest {\n  flightId: string;\n  recordedAt: string;\n  workspace: string;\n  model: string;\n  endpoint: string;\n  initialCommit?: string;\n  initialBranch?: string;\n  totalSteps?: number;\n  taskPrompt?: string;\n  status: \"in_progress\" | \"completed\" | \"failed\";\n  summary?: string;\n}\n\n/**\n * Deterministic Flight Recorder for Agentic Code Execution\n * Records prompts, thoughts, tool calls, diffs, and durable state transitions into\n * append-only .flightlog archives for exact post-mortem replay and audit.\n */\nexport class FlightRecorder {\n  private workspace: string;\n  private flightId: string;\n  private flightLogPath: string;\n  private isRecording: boolean = false;\n  private startTime: number = Date.now();\n\n  constructor(workspace: string, flightId?: string) {\n    this.workspace = path.resolve(workspace);\n    this.flightId = flightId || `flight-${new Date().toISOString().replace(/[:.]/g, \"-\")}-${randomUUID().slice(0, 6)}`;\n    ensureGitExclude(this.workspace);\n    const flightsDir = path.join(this.workspace, \".nexus\", \"flights\");\n    ensurePrivateDir(flightsDir);\n    this.flightLogPath = path.join(flightsDir, `${this.flightId}.flightlog`);\n  }\n\n  public getFlightId(): string {\n    return this.flightId;\n  }\n\n  public getLogPath(): string {\n    return this.flightLogPath;\n  }\n\n  public isSessionActive(): boolean {\n    return this.isRecording;\n  }\n\n  private appendEvent(type: FlightEventType, step: number | undefined, payload: Record<string, any>): FlightEvent {\n    // Flightlogs are durable telemetry. Sanitize the complete event before its\n    // only write path; a classifier failure must not fall through to plaintext\n    // or prevent the authorized local capability from executing.\n    const eventId = `evt-${randomUUID().slice(0, 8)}`;\n    const timestamp = new Date().toISOString();\n    let sanitizedPayload: Record<string, any>;\n    try {\n      sanitizedPayload = InformationFlowBoundary.getGlobalInstance().redactForTelemetry(payload);\n    } catch {\n      // Do not propagate classifier diagnostics that could echo inspected input.\n      return {\n        eventId,\n        timestamp,\n        type,\n        step,\n        payload: { recordingSkipped: true, reason: \"sanitization_failed\" },\n      };\n    }\n    const event: FlightEvent = {\n      eventId,\n      timestamp,\n      type,\n      step,\n      payload: sanitizedPayload,\n    };\n    try {\n      appendPrivateFile(this.flightLogPath, JSON.stringify(event) + \"\\n\");\n    } catch {\n      // Ignore flightlog append errors in restricted environments\n    }\n    return event;\n  }\n\n  public startSession(config: {\n    model: string;\n    endpoint: string;\n    taskPrompt?: string;\n  }): FlightManifest {\n    this.isRecording = true;\n    this.startTime = Date.now();\n\n    let initialCommit: string | undefined;\n    let initialBranch: string | undefined;\n\n    try {\n      initialCommit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], {\n        cwd: this.workspace,\n        encoding: \"utf-8\",\n        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n      }).trim();\n      initialBranch = execFileSync(\"git\", [\"rev-parse\", \"--abbrev-ref\", \"HEAD\"], {\n        cwd: this.workspace,\n        encoding: \"utf-8\",\n        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a170d0-7672-79e2-b11d-117e84b3ea44","create_time":1792894935.2896051}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
