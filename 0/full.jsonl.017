{"timestamp":"2026-10-25T01:19:45.089Z","ordinal":317577,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17095-f2fe-7de0-b5cc-460661bc1fe3","item":{"type":"CommandExecution","id":"exec-72bdb575-1406-40aa-bd18-0b4159593ade","process_id":"92410","command":["/usr/bin/zsh","-lc","cat core/src/bin/nexus_tui/review.rs; sed -n '90,130p' core/src/bin/nexus_tui/protocol.rs; rg -n \"Review::Shell|Review::Args|Review::Patch\" core/src/bin/nexus_tui"],"cwd":"file:///home/mike/nexus-wt/sec101-119-pty-followup","parsed_cmd":[{"type":"read","cmd":"cat core/src/bin/nexus_tui/review.rs","name":"review.rs","path":"core/src/bin/nexus_tui/review.rs"},{"type":"read","cmd":"sed -n '90,130p' core/src/bin/nexus_tui/protocol.rs","name":"protocol.rs","path":"core/src/bin/nexus_tui/protocol.rs"},{"type":"search","cmd":"rg -n 'Review::Shell|Review::Args|Review::Patch' core/src/bin/nexus_tui","query":"Review::Shell|Review::Args|Review::Patch","path":"nexus_tui"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"//! Turns an approval request's review payload into display lines: a unified diff for file changes, the patch as\n//! sent, or the command line. Pure; the sidecar already redacted and capped the text.\nuse std::ops::Range;\nuse std::time::Duration;\n\nuse similar::{ChangeTag, TextDiff};\n\nuse crate::protocol::Review;\n\nconst CONTEXT_LINES: usize = 3;\n/// Bounds the diff on huge inputs; `similar` falls back to a coarser diff when it runs out of time.\nconst DIFF_TIMEOUT: Duration = Duration::from_millis(200);\n\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum LineKind {\n    Meta,\n    Hunk,\n    Added,\n    Removed,\n    Context,\n    Command,\n}\n\n#[derive(Clone, Debug, PartialEq)]\npub struct ReviewLine {\n    pub kind: LineKind,\n    pub text: String,\n}\n\nfn line(kind: LineKind, text: impl Into<String>) -> ReviewLine {\n    ReviewLine {\n        kind,\n        text: text.into(),\n    }\n}\n\nfn truncation_note() -> ReviewLine {\n    line(\n        LineKind::Meta,\n        \"… preview truncated; the action uses the full content\",\n    )\n}\n\npub fn review_lines(review: &Review) -> Vec<ReviewLine> {\n    let mut lines = Vec::new();\n    let truncated = match review {\n        Review::Change {\n            path,\n            before,\n            after,\n            created,\n            truncated,\n        } => {\n            if *created {\n                lines.push(line(LineKind::Meta, format!(\"new file {path}\")));\n            } else if before.is_none() {\n                lines.push(line(\n                    LineKind::Meta,\n                    format!(\n                        \"{path}: current content not shown (outside the workspace, unreadable, or too large)\"\n                    ),\n                ));\n            }\n            lines.extend(unified(path, before.as_deref().unwrap_or(\"\"), after));\n            *truncated\n        }\n        Review::Patch {\n            path,\n            patch,\n            truncated,\n        } => {\n            lines.push(line(LineKind::Meta, format!(\"patch {path}\")));\n            lines.extend(patch.lines().map(classify));\n            *truncated\n        }\n        Review::Shell { command } => {\n            lines.extend(command.lines().enumerate().map(|(index, row)| {\n                line(\n                    LineKind::Command,\n                    format!(\"{} {row}\", if index == 0 { \"$\" } else { \" \" }),\n                )\n            }));\n            false\n        }\n        Review::Verifier {\n            command,\n            script,\n            detail,\n        } => {\n            if let Some(detail) = detail {\n                lines.push(line(LineKind::Meta, format!(\"verifier: {detail}\")));\n            }\n            lines.extend(command.lines().enumerate().map(|(index, row)| {\n                line(\n                    LineKind::Command,\n                    format!(\"{} {row}\", if index == 0 { \"$\" } else { \" \" }),\n                )\n            }));\n            if let Some(script) = script {\n                if script != command {\n                    lines.push(line(LineKind::Meta, \"script:\"));\n                    lines.extend(script.lines().map(|row| line(LineKind::Context, format!(\"  {row}\"))));\n                }\n            }\n            false\n        }\n        Review::Args { text, truncated } => {\n            lines.extend(text.lines().map(|row| line(LineKind::Context, row)));\n            *truncated\n        }\n        Review::Unknown => {\n            lines.push(line(\n                LineKind::Meta,\n                \"This request has no preview this view can show.\",\n            ));\n            false\n        }\n    };\n    if truncated {\n        lines.push(truncation_note());\n    }\n    lines\n}\n\n/// `start,len` of a hunk range in unified-diff form; an empty range is written `start,0` like git does.\nfn hunk_range(range: Range<usize>) -> String {\n    if range.is_empty() {\n        format!(\"{},0\", range.start)\n    } else if range.len() == 1 {\n        format!(\"{}\", range.start + 1)\n    } else {\n        format!(\"{},{}\", range.start + 1, range.len())\n    }\n}\n\nfn unified(path: &str, before: &str, after: &str) -> Vec<ReviewLine> {\n    let diff = TextDiff::configure()\n        .timeout(DIFF_TIMEOUT)\n        .diff_lines(before, after);\n    let mut lines = vec![\n        line(LineKind::Meta, format!(\"--- {path}\")),\n        line(LineKind::Meta, format!(\"+++ {path}\")),\n    ];\n    let groups = diff.grouped_ops(CONTEXT_LINES);\n    if groups.is_empty() {\n        lines.push(line(LineKind::Meta, \"no changes\"));\n    }\n    for group in groups {\n        let (Some(first), Some(last)) = (group.first(), group.last()) else {\n            continue;\n        };\n        let old = first.old_range().start..last.old_range().end;\n        let new = first.new_range().start..last.new_range().end;\n        lines.push(line(\n            LineKind::Hunk,\n            format!(\"@@ -{} +{} @@\", hunk_range(old), hunk_range(new)),\n        ));\n        for op in &group {\n            for change in diff.iter_changes(op) {\n                let (kind, sign) = match change.tag() {\n                    ChangeTag::Delete => (LineKind::Removed, '-'),\n                    ChangeTag::Insert => (LineKind::Added, '+'),\n                    ChangeTag::Equal => (LineKind::Context, ' '),\n                };\n                let text = change.value().trim_end_matches(['\\n', '\\r']);\n                lines.push(line(kind, format!(\"{sign}{text}\")));\n            }\n        }\n    }\n    lines\n}\n\nfn classify(row: &str) -> ReviewLine {\n    let kind = if row.starts_with(\"+++\")\n        || row.starts_with(\"---\")\n        || row.starts_with(\"diff \")\n        || row.starts_with(\"index \")\n    {\n        LineKind::Meta\n    } else if row.starts_with(\"@@\") {\n        LineKind::Hunk\n    } else if row.starts_with('+') {\n        LineKind::Added\n    } else if row.starts_with('-') {\n        LineKind::Removed\n    } else {\n        LineKind::Context\n    };\n    line(kind, row)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn texts(lines: &[ReviewLine], kind: LineKind) -> Vec<&str> {\n        lines\n            .iter()\n            .filter(|line| line.kind == kind)\n            .map(|line| line.text.as_str())\n            .collect()\n    }\n\n    #[test]\n    fn a_change_renders_as_a_unified_diff_with_context() {\n        let lines = review_lines(&Review::Change {\n            path: \"src/a.txt\".into(),\n            before: Some(\"one\\ntwo\\nthree\\n\".into()),\n            after: \"one\\nTWO\\nthree\\n\".into(),\n            created: false,\n            truncated: false,\n        });\n        assert_eq!(\n            texts(&lines, LineKind::Meta),\n            vec![\"--- src/a.txt\", \"+++ src/a.txt\"]\n        );\n        assert_eq!(texts(&lines, LineKind::Hunk), vec![\"@@ -1,3 +1,3 @@\"]);\n        assert_eq!(texts(&lines, LineKind::Removed), vec![\"-two\"]);\n        assert_eq!(texts(&lines, LineKind::Added), vec![\"+TWO\"]);\n        assert_eq!(texts(&lines, LineKind::Context), vec![\" one\", \" three\"]);\n    }\n\n    #[test]\n    fn distant_changes_get_separate_hunks() {\n        let before: String = (1..=20).map(|n| format!(\"line {n}\\n\")).collect();\n        let after = before\n            .replace(\"line 2\\n\", \"line two\\n\")\n            .replace(\"line 18\\n\", \"line eighteen\\n\");\n        let lines = review_lines(&Review::Change {\n            path: \"f\".into(),\n            before: Some(before),\n            after,\n            created: false,\n            truncated: false,\n        });\n        assert_eq!(\n            texts(&lines, LineKind::Hunk),\n            vec![\"@@ -1,5 +1,5 @@\", \"@@ -15,6 +15,6 @@\"]\n        );\n    }\n\n    #[test]\n    fn single_line_ranges_omit_the_count_like_git() {\n        let lines = review_lines(&Review::Change {\n            path: \"f\".into(),\n            before: Some(\"a\\n\".into()),\n            after: \"b\\nc\\n\".into(),\n            created: false,\n            truncated: false,\n        });\n        assert_eq!(texts(&lines, LineKind::Hunk), vec![\"@@ -1 +1,2 @@\"]);\n    }\n\n    #[test]\n    fn new_files_unknown_content_and_truncation_are_labelled() {\n        let created = review_lines(&Review::Change {\n            path: \"x.txt\".into(),\n            before: None,\n            after: \"a\\nb\\n\".into(),\n            created: true,\n            truncated: true,\n        });\n        assert_eq!(\n            created[0],\n            ReviewLine {\n                kind: LineKind::Meta,\n                text: \"new file x.txt\".into()\n            }\n        );\n        assert_eq!(texts(&created, LineKind::Hunk), vec![\"@@ -0,0 +1,2 @@\"]);\n        assert_eq!(texts(&created, LineKind::Added), vec![\"+a\", \"+b\"]);\n        assert!(created.last().unwrap().text.contains(\"truncated\"));\n        let hidden = review_lines(&Review::Change {\n            path: \"big.bin\".into(),\n            before: None,\n            after: \"x\".into(),\n            created: false,\n            truncated: false,\n        });\n        assert!(\n            hidden[0].text.contains(\"current content not shown\"),\n            \"{hidden:?}\"\n        );\n        let same = review_lines(&Review::Change {\n            path: \"s\".into(),\n            before: Some(\"a\\n\".into()),\n            after: \"a\\n\".into(),\n            created: false,\n            truncated: false,\n        });\n        assert_eq!(same.last().unwrap().text, \"no changes\");\n    }\n\n    #[test]\n    fn patches_commands_and_args_are_shown_as_sent() {\n        let patch = review_lines(&Review::Patch {\n            path: \"a.ts\".into(),\n            patch: \"--- a/a.ts\\n+++ b/a.ts\\n@@ -1 +1 @@\\n-old\\n+new\\n same\".into(),\n            truncated: false,\n        });\n        assert_eq!(\n            patch.iter().map(|line| line.kind).collect::<Vec<_>>(),\n            vec![\n                LineKind::Meta,\n                LineKind::Meta,\n                LineKind::Meta,\n                LineKind::Hunk,\n                LineKind::Removed,\n                LineKind::Added,\n                LineKind::Context\n            ]\n        );\n        assert_eq!(patch[0].text, \"patch a.ts\");\n        assert_eq!(\n            review_lines(&Review::Shell {\n                command: \"npm test\\n--watch\".into()\n            }),\n            vec![\n                ReviewLine {\n                    kind: LineKind::Command,\n                    text: \"$ npm test\".into()\n                },\n                ReviewLine {\n                    kind: LineKind::Command,\n                    text: \"  --watch\".into()\n                },\n            ]\n        );\n        assert_eq!(\n            review_lines(&Review::Verifier {\n                command: \"npm test\".into(),\n                script: Some(\"jest --runInBand\".into()),\n                detail: Some(\"package.json:scripts.test\".into()),\n            }),\n            vec![\n                ReviewLine {\n                    kind: LineKind::Meta,\n                    text: \"verifier: package.json:scripts.test\".into()\n                },\n                ReviewLine {\n                    kind: LineKind::Command,\n                    text: \"$ npm test\".into()\n                },\n                ReviewLine {\n                    kind: LineKind::Meta,\n                    text: \"script:\".into()\n                },\n                ReviewLine {\n                    kind: LineKind::Context,\n                    text: \"  jest --runInBand\".into()\n                },\n            ]\n        );\n        assert_eq!(\n            texts(\n                &review_lines(&Review::Args {\n                    text: \"{\\n  \\\"url\\\": \\\"u\\\"\\n}\".into(),\n                    truncated: false\n                }),\n                LineKind::Context\n            ),\n            vec![\"{\", \"  \\\"url\\\": \\\"u\\\"\", \"}\"]\n        );\n        assert_eq!(review_lines(&Review::Unknown)[0].kind, LineKind::Meta);\n    }\n}\n\nimpl fmt::Debug for Secret {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        f.write_str(\"Secret(***)\")\n    }\n}\n\n/// One block of the turn receipt: labelled rows, or a note saying why there are none.\n#[derive(Clone, Debug, Deserialize, PartialEq)]\npub struct ReceiptSection {\n    pub title: String,\n    #[serde(default)]\n    pub rows: Vec<(String, String)>,\n    #[serde(default)]\n    pub note: Option<String>,\n}\n\n/// What the operator is asked to approve (`approvalReview` in `cli/src/approval_review.ts`). Text is already\n/// redacted and capped by the sidecar.\n#[derive(Clone, Debug, Deserialize, PartialEq)]\n#[serde(tag = \"kind\")]\npub enum Review {\n    #[serde(rename = \"change\")]\n    Change {\n        path: String,\n        before: Option<String>,\n        after: String,\n        created: bool,\n        truncated: bool,\n    },\n    #[serde(rename = \"patch\")]\n    Patch {\n        path: String,\n        patch: String,\n        truncated: bool,\n    },\n    #[serde(rename = \"command\")]\n    Shell { command: String },\n    #[serde(rename = \"verifier\")]\n    Verifier {\n        command: String,\ncore/src/bin/nexus_tui/protocol.rs:879:            Some(Review::Patch {\ncore/src/bin/nexus_tui/protocol.rs:887:            Some(Review::Shell {\ncore/src/bin/nexus_tui/protocol.rs:901:            Some(Review::Args {\ncore/src/bin/nexus_tui/review.rs:67:        Review::Patch {\ncore/src/bin/nexus_tui/review.rs:76:        Review::Shell { command } => {\ncore/src/bin/nexus_tui/review.rs:107:        Review::Args { text, truncated } => {\ncore/src/bin/nexus_tui/review.rs:296:        let patch = review_lines(&Review::Patch {\ncore/src/bin/nexus_tui/review.rs:315:            review_lines(&Review::Shell {\ncore/src/bin/nexus_tui/review.rs:356:                &review_lines(&Review::Args {\n","exit_code":0,"duration":{"secs":0,"nanos":877578823}},"started_at_ms":1792891184211,"completed_at_ms":1792891185089}}
{"timestamp":"2026-10-25T01:19:45.979Z","ordinal":317578,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a170a4-6b3b-7c23-a905-f876fdb40c99","call_id":"call_5a5f656055124a4d94d8989e61194285","output":[{"type":"input_text","text":"Script completed\nWall time 3.0 seconds\nOutput:\n"},{"type":"input_text","text":"//! Turns an approval request's review payload into display lines: a unified diff for file changes, the patch as\n//! sent, or the command line. Pure; the sidecar already redacted and capped the text.\nuse std::ops::Range;\nuse std::time::Duration;\n\nuse similar::{ChangeTag, TextDiff};\n\nuse crate::protocol::Review;\n\nconst CONTEXT_LINES: usize = 3;\n/// Bounds the diff on huge inputs; `similar` falls back to a coarser diff when it runs out of time.\nconst DIFF_TIMEOUT: Duration = Duration::from_millis(200);\n\n#[derive(Clone, Copy, Debug, PartialEq)]\npub enum LineKind {\n    Meta,\n    Hunk,\n    Added,\n    Removed,\n    Context,\n    Command,\n}\n\n#[derive(Clone, Debug, PartialEq)]\npub struct ReviewLine {\n    pub kind: LineKind,\n    pub text: String,\n}\n\nfn line(kind: LineKind, text: impl Into<String>) -> ReviewLine {\n    ReviewLine {\n        kind,\n        text: text.into(),\n    }\n}\n\nfn truncation_note() -> ReviewLine {\n    line(\n        LineKind::Meta,\n        \"… preview truncated; the action uses the full content\",\n    )\n}\n\npub fn review_lines(review: &Review) -> Vec<ReviewLine> {\n    let mut lines = Vec::new();\n    let truncated = match review {\n        Review::Change {\n            path,\n            before,\n            after,\n            created,\n            truncated,\n        } => {\n            if *created {\n                lines.push(line(LineKind::Meta, format!(\"new file {path}\")));\n            } else if before.is_none() {\n                lines.push(line(\n                    LineKind::Meta,\n                    format!(\n                        \"{path}: current content not shown (outside the workspace, unreadable, or too large)\"\n                    ),\n                ));\n            }\n            lines.extend(unified(path, before.as_deref().unwrap_or(\"\"), after));\n            *truncated\n        }\n        Review::Patch {\n            path,\n            patch,\n            truncated,\n        } => {\n            lines.push(line(LineKind::Meta, format!(\"patch {path}\")));\n            lines.extend(patch.lines().map(classify));\n            *truncated\n        }\n        Review::Shell { command } => {\n            lines.extend(command.lines().enumerate().map(|(index, row)| {\n                line(\n                    LineKind::Command,\n                    format!(\"{} {row}\", if index == 0 { \"$\" } else { \" \" }),\n                )\n            }));\n            false\n        }\n        Review::Verifier {\n            command,\n            script,\n            detail,\n        } => {\n            if let Some(detail) = detail {\n                lines.push(line(LineKind::Meta, format!(\"verifier: {detail}\")));\n            }\n            lines.extend(command.lines().enumerate().map(|(index, row)| {\n                line(\n                    LineKind::Command,\n                    format!(\"{} {row}\", if index == 0 { \"$\" } else { \" \" }),\n                )\n            }));\n            if let Some(script) = script {\n                if script != command {\n                    lines.push(line(LineKind::Meta, \"script:\"));\n                    lines.extend(script.lines().map(|row| line(LineKind::Context, format!(\"  {row}\"))));\n                }\n            }\n            false\n        }\n        Review::Args { text, truncated } => {\n            lines.extend(text.lines().map(|row| line(LineKind::Context, row)));\n            *truncated\n        }\n        Review::Unknown => {\n            lines.push(line(\n                LineKind::Meta,\n                \"This request has no preview this view can show.\",\n            ));\n            false\n        }\n    };\n    if truncated {\n        lines.push(truncation_note());\n    }\n    lines\n}\n\n/// `start,len` of a hunk range in unified-diff form; an empty range is written `start,0` like git does.\nfn hunk_range(range: Range<usize>) -> String {\n    if range.is_empty() {\n        format!(\"{},0\", range.start)\n    } else if range.len() == 1 {\n        format!(\"{}\", range.start + 1)\n    } else {\n        format!(\"{},{}\", range.start + 1, range.len())\n    }\n}\n\nfn unified(path: &str, before: &str, after: &str) -> Vec<ReviewLine> {\n    let diff = TextDiff::configure()\n        .timeout(DIFF_TIMEOUT)\n        .diff_lines(before, after);\n    let mut lines = vec![\n        line(LineKind::Meta, format!(\"--- {path}\")),\n        line(LineKind::Meta, format!(\"+++ {path}\")),\n    ];\n    let groups = diff.grouped_ops(CONTEXT_LINES);\n    if groups.is_empty() {\n        lines.push(line(LineKind::Meta, \"no changes\"));\n    }\n    for group in groups {\n        let (Some(first), Some(last)) = (group.first(), group.last()) else {\n            continue;\n        };\n        let old = first.old_range().start..last.old_range().end;\n        let new = first.new_range().start..last.new_range().end;\n        lines.push(line(\n            LineKind::Hunk,\n            format!(\"@@ -{} +{} @@\", hunk_range(old), hunk_range(new)),\n        ));\n        for op in &group {\n            for change in diff.iter_changes(op) {\n                let (kind, sign) = match change.tag() {\n                    ChangeTag::Delete => (LineKind::Removed, '-'),\n                    ChangeTag::Insert => (LineKind::Added, '+'),\n                    ChangeTag::Equal => (LineKind::Context, ' '),\n                };\n                let text = change.value().trim_end_matches(['\\n', '\\r']);\n                lines.push(line(kind, format!(\"{sign}{text}\")));\n            }\n        }\n    }\n    lines\n}\n\nfn classify(row: &str) -> ReviewLine {\n    let kind = if row.starts_with(\"+++\")\n        || row.starts_with(\"---\")\n        || row.starts_with(\"diff \")\n        || row.starts_with(\"index \")\n    {\n        LineKind::Meta\n    } else if row.starts_with(\"@@\") {\n        LineKind::Hunk\n    } else if row.starts_with('+') {\n        LineKind::Added\n    } else if row.starts_with('-') {\n        LineKind::Removed\n    } else {\n        LineKind::Context\n    };\n    line(kind, row)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn texts(lines: &[ReviewLine], kind: LineKind) -> Vec<&str> {\n        lines\n            .iter()\n            .filter(|line| line.kind == kind)\n            .map(|line| line.text.as_str())\n            .collect()\n    }\n\n    #[test]\n    fn a_change_renders_as_a_unified_diff_with_context() {\n        let lines = review_lines(&Review::Change {\n            path: \"src/a.txt\".into(),\n            before: Some(\"one\\ntwo\\nthree\\n\".into()),\n            after: \"one\\nTWO\\nthree\\n\".into(),\n            created: false,\n            truncated: false,\n        });\n        assert_eq!(\n            texts(&lines, LineKind::Meta),\n            vec![\"--- src/a.txt\", \"+++ src/a.txt\"]\n        );\n        assert_eq!(texts(&lines, LineKind::Hunk), vec![\"@@ -1,3 +1,3 @@\"]);\n        assert_eq!(texts(&lines, LineKind::Removed), vec![\"-two\"]);\n        assert_eq!(texts(&lines, LineKind::Added), vec![\"+TWO\"]);\n        assert_eq!(texts(&lines, LineKind::Context), vec![\" one\", \" three\"]);\n    }\n\n    #[test]\n    fn distant_changes_get_separate_hunks() {\n        let before: String = (1..=20).map(|n| format!(\"line {n}\\n\")).collect();\n        let after = before\n            .replace(\"line 2\\n\", \"line two\\n\")\n            .replace(\"line 18\\n\", \"line eighteen\\n\");\n        let lines = review_lines(&Review::Change {\n            path: \"f\".into(),\n            before: Some(before),\n            after,\n            created: false,\n            truncated: false,\n        });\n        assert_eq!(\n            texts(&lines, LineKind::Hunk),\n            vec![\"@@ -1,5 +1,5 @@\", \"@@ -15,6 +15,6 @@\"]\n        );\n    }\n\n    #[test]\n    fn single_line_ranges_omit_the_count_like_git() {\n        let lines = review_lines(&Review::Change {\n            path: \"f\".into(),\n            before: Some(\"a\\n\".into()),\n            after: \"b\\nc\\n\".into(),\n            created: false,\n            truncated: false,\n        });\n        assert_eq!(texts(&lines, LineKind::Hunk), vec![\"@@ -1 +1,2 @@\"]);\n    }\n\n    #[test]\n    fn new_files_unknown_content_and_truncation_are_labelled() {\n        let created = review_lines(&Review::Change {\n            path: \"x.txt\".into(),\n            before: None,\n            after: \"a\\nb\\n\".into(),\n            created: true,\n            truncated: true,\n        });\n        assert_eq!(\n            created[0],\n            ReviewLine {\n                kind: LineKind::Meta,\n                text: \"new file x.txt\".into()\n            }\n        );\n        assert_eq!(texts(&created, LineKind::Hunk), vec![\"@@ -0,0 +1,2 @@\"]);\n        assert_eq!(texts(&created, LineKind::Added), vec![\"+a\", \"+b\"]);\n        assert!(created.last().unwrap().text.contains(\"truncated\"));\n        let hidden = review_lines(&Review::Change {\n            path: \"big.bin\".into(),\n            before: None,\n            after: \"x\".into(),\n            created: false,\n            truncated: false,\n        });\n        assert!(\n            hidden[0].text.contains(\"current content not shown\"),\n            \"{hidden:?}\"\n        );\n        let same = review_lines(&Review::Change {\n            path: \"s\".into(),\n            before: Some(\"a\\n\".into()),\n            after: \"a\\n\".into(),\n            created: false,\n            truncated: false,\n        });\n        assert_eq!(same.last().unwrap().text, \"no changes\");\n    }\n\n    #[test]\n    fn patches_commands_and_args_are_shown_as_sent() {\n        let patch = review_lines(&Review::Patch {\n            path: \"a.ts\".into(),\n            patch: \"--- a/a.ts\\n+++ b/a.ts\\n@@ -1 +1 @@\\n-old\\n+new\\n same\".into(),\n            truncated: false,\n        });\n        assert_eq!(\n            patch.iter().map(|line| line.kind).collect::<Vec<_>>(),\n            vec![\n                LineKind::Meta,\n                LineKind::Meta,\n                LineKind::Meta,\n                LineKind::Hunk,\n                LineKind::Removed,\n                LineKind::Added,\n                LineKind::Context\n            ]\n        );\n        assert_eq!(patch[0].text, \"patch a.ts\");\n        assert_eq!(\n            review_lines(&Review::Shell {\n                command: \"npm test\\n--watch\".into()\n            }),\n            vec![\n                ReviewLine {\n                    kind: LineKind::Command,\n                    text: \"$ npm test\".into()\n                },\n                ReviewLine {\n                    kind: LineKind::Command,\n                    text: \"  --watch\".into()\n                },\n            ]\n        );\n        assert_eq!(\n            review_lines(&Review::Verifier {\n                command: \"npm test\".into(),\n                script: Some(\"jest --runInBand\".into()),\n                detail: Some(\"package.json:scripts.test\".into()),\n            }),\n            vec![\n                ReviewLine {\n                    kind: LineKind::Meta,\n                    text: \"verifier: package.json:scripts.test\".into()\n                },\n                ReviewLine {\n                    kind: LineKind::Command,\n                    text: \"$ npm test\".into()\n                },\n                ReviewLine {\n                    kind: LineKind::Meta,\n                    text: \"script:\".into()\n                },\n                ReviewLine {\n                    kind: LineKind::Context,\n                    text: \"  jest --runInBand\".into()\n                },\n            ]\n        );\n        assert_eq!(\n            texts(\n                &review_lines(&Review::Args {\n                    text: \"{\\n  \\\"url\\\": \\\"u\\\"\\n}\".into(),\n                    truncated: false\n                }),\n                LineKind::Context\n            ),\n            vec![\"{\", \"  \\\"url\\\": \\\"u\\\"\", \"}\"]\n        );\n        assert_eq!(review_lines(&Review::Unknown)[0].kind, LineKind::Meta);\n    }\n}\n\nimpl fmt::Debug for Secret {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        f.write_str(\"Secret(***)\")\n    }\n}\n\n/// One block of the turn receipt: labelled rows, or a note saying why there are none.\n#[derive(Clone, Debug, Deserialize, PartialEq)]\npub struct ReceiptSection {\n    pub title: String,\n    #[serde(default)]\n    pub rows: Vec<(String, String)>,\n    #[serde(default)]\n    pub note: Option<String>,\n}\n\n/// What the operator is asked to approve (`approvalReview` in `cli/src/approval_review.ts`). Text is already\n/// redacted and capped by the sidecar.\n#[derive(Clone, Debug, Deserialize, PartialEq)]\n#[serde(tag = \"kind\")]\npub enum Review {\n    #[serde(rename = \"change\")]\n    Change {\n        path: String,\n        before: Option<String>,\n        after: String,\n        created: bool,\n        truncated: bool,\n    },\n    #[serde(rename = \"patch\")]\n    Patch {\n        path: String,\n        patch: String,\n        truncated: bool,\n    },\n    #[serde(rename = \"command\")]\n    Shell { command: String },\n    #[serde(rename = \"verifier\")]\n    Verifier {\n        command: String,\ncore/src/bin/nexus_tui/protocol.rs:879:            Some(Review::Patch {\ncore/src/bin/nexus_tui/protocol.rs:887:            Some(Review::Shell {\ncore/src/bin/nexus_tui/protocol.rs:901:            Some(Review::Args {\ncore/src/bin/nexus_tui/review.rs:67:        Review::Patch {\ncore/src/bin/nexus_tui/review.rs:76:        Review::Shell { command } => {\ncore/src/bin/nexus_tui/review.rs:107:        Review::Args { text, truncated } => {\ncore/src/bin/nexus_tui/review.rs:296:        let patch = review_lines(&Review::Patch {\ncore/src/bin/nexus_tui/review.rs:315:            review_lines(&Review::Shell {\ncore/src/bin/nexus_tui/review.rs:356:                &review_lines(&Review::Args {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17095-f2fe-7de0-b5cc-460661bc1fe3","create_time":1792891185.9797518}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
