{"timestamp":"2026-10-25T04:01:12.356Z","ordinal":323244,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17136-12b9-7661-904c-f2b43120b5c8","item":{"type":"CommandExecution","id":"exec-e86ce88d-66bb-4785-9ef3-582eaeee9123","process_id":"17799","command":["/usr/bin/zsh","-lc","echo '--- merge diff ---'; git diff --stat 4e7297f545538e6422ca3890334a7036f58287ca origin/main; git diff 4e7297f545538e6422ca3890334a7036f58287ca origin/main -- install.sh cli/src/upgrade.ts cli/test/upgrade_acceptance.test.ts docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md; echo '--- attestation references ---'; git grep -n -E 'NEXUS_VERIFY_ATTESTATION|attest|verify.*release|install\\.sh' origin/main -- install.sh cli/src/upgrade.ts docs/v1.0.0/ACCEPTANCE.md docs/v1.0.0/REQUIREMENTS.md docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md docs/releases/PROTECTIONS.md"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"echo '--- merge diff ---'; git diff --stat 4e7297f545538e6422ca3890334a7036f58287ca origin/main; git diff 4e7297f545538e6422ca3890334a7036f58287ca origin/main -- install.sh cli/src/upgrade.ts cli/test/upgrade_acceptance.test.ts docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md; echo '--- attestation references ---'; git grep -n -E 'NEXUS_VERIFY_ATTESTATION|attest|verify.*release|install\\.sh' origin/main -- install.sh cli/src/upgrade.ts docs/v1.0.0/ACCEPTANCE.md docs/v1.0.0/REQUIREMENTS.md docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md docs/releases/PROTECTIONS.md"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"--- merge diff ---\n cli/src/upgrade.ts                                 | 26 ++++++--\n cli/test/upgrade_acceptance.test.ts                | 73 ++++++++++++++++++++++\n .../DEFECT-UPGRADE-ATTESTATION-20261025/README.md  | 59 +++++++++++++++++\n docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md   |  4 +-\n 4 files changed, 155 insertions(+), 7 deletions(-)\ndiff --git a/cli/src/upgrade.ts b/cli/src/upgrade.ts\nindex aa38a07..201fd66 100644\n--- a/cli/src/upgrade.ts\n+++ b/cli/src/upgrade.ts\n@@ -132,6 +132,8 @@ export interface UpgradeOptions {\n   signal?: AbortSignal;\n   onProgress?: (stage: string, detail?: string) => void;\n   confirm?: (proposal: UpgradeComparison) => Promise<boolean>;\n+  /** Test/embedding hook: trusted gh candidates, in order. Production defaults to the system paths. */\n+  trustedGhPaths?: string[];\n }\n \n // -----------------------------------------------------------------------------\n@@ -912,6 +914,15 @@ export async function performUpgrade(\n     throw new Error(`Cannot upgrade: ${comparison.reasons.join(\" \")}`);\n   }\n \n+  const verifyAttestation = process.env.NEXUS_VERIFY_ATTESTATION ?? \"auto\";\n+  const trustedGhPaths = options?.trustedGhPaths ?? [\"/usr/bin/gh\", \"/usr/local/bin/gh\"];\n+  const trustedGh = trustedGhPaths.find((candidate) => fs.existsSync(candidate));\n+  if (verifyAttestation === \"1\" && !trustedGh) {\n+    throw new Error(\n+      \"Provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\",\n+    );\n+  }\n+\n   const { installed, targetVersion, action } = comparison;\n   const prefix = path.resolve(options?.prefix ?? installed.prefix ?? path.join(process.env.HOME || \"\", \".local\"));\n   const baseDownloadUrl = getReleaseBaseUrl();\n@@ -1055,20 +1066,23 @@ export async function performUpgrade(\n       if (!String(err?.message ?? err).includes(\"HTTP 404\")) throw err;\n     }\n \n-    // Optional attestation check via gh if present\n+    // Optional attestation check via a trusted gh if present. Do not resolve it from PATH: a shim that exits 0\n+    // must not be able to claim a verified attestation, and a missing gh must fail closed when verification is required.\n     let attestationVerified: boolean | undefined;\n-    const verifyAttestation = process.env.NEXUS_VERIFY_ATTESTATION ?? \"auto\";\n     if (verifyAttestation !== \"0\") {\n-      const ghProbe = spawnSync(\"gh\", [\"--version\"]);\n-      if (ghProbe.status === 0) {\n+      if (trustedGh) {\n         options?.onProgress?.(\"verifying_attestation\", \"Checking build provenance attestation...\");\n-        const attestCheck = spawnSync(\"gh\", [\"attestation\", \"verify\", localArchive, \"-R\", CANONICAL_REPO]);\n-        const indexAttestCheck = spawnSync(\"gh\", [\"attestation\", \"verify\", localSums, \"-R\", CANONICAL_REPO]);\n+        const attestCheck = spawnSync(trustedGh, [\"attestation\", \"verify\", localArchive, \"-R\", CANONICAL_REPO]);\n+        const indexAttestCheck = spawnSync(trustedGh, [\"attestation\", \"verify\", localSums, \"-R\", CANONICAL_REPO]);\n         if (attestCheck.status === 0 && indexAttestCheck.status === 0) {\n           attestationVerified = true;\n         } else if (verifyAttestation === \"1\") {\n           throw new Error(`Provenance attestation verification failed for ${archiveName} or SHA256SUMS.`);\n         }\n+      } else if (verifyAttestation === \"1\") {\n+        throw new Error(\n+          \"Provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\",\n+        );\n       }\n     }\n \ndiff --git a/cli/test/upgrade_acceptance.test.ts b/cli/test/upgrade_acceptance.test.ts\nindex c067703..b1c554b 100644\n--- a/cli/test/upgrade_acceptance.test.ts\n+++ b/cli/test/upgrade_acceptance.test.ts\n@@ -314,6 +314,79 @@ describe(\"Public Release Upgrade Acceptance (REQ-REL-116, ACC-UPG-07..14)\", () =\n     assert.equal(journal.state, \"complete\");\n   });\n \n+  it(\"refuses an upgrade that requires attestation when gh is unavailable\", async () => {\n+    const oldVersion = \"v0.1.0-alpha.2\";\n+    const vOldDir = setupInstalledVersion(tmpPrefix, oldVersion);\n+    fs.mkdirSync(path.join(tmpPrefix, \"bin\"), { recursive: true });\n+    fs.symlinkSync(path.join(vOldDir, \"bin\", \"nexus\"), path.join(tmpPrefix, \"bin\", \"nexus\"));\n+\n+    const installed = detectInstallation({ nexusHome: vOldDir, envPrefix: tmpPrefix });\n+    const target = await resolveTargetRelease(undefined, { timeoutMs: 5000 });\n+    const comparison = compareInstallationWithRelease(installed, target);\n+    assert.equal(comparison.action, \"upgrade\");\n+\n+    const savedPath = process.env.PATH;\n+    const savedAttestation = process.env.NEXUS_VERIFY_ATTESTATION;\n+    // A PATH shim that claims success must not satisfy *required* attestation, and an empty trusted-path list must\n+    // fail closed without spawning it.\n+    const shim = path.join(tmpPrefix, \"gh-shim\");\n+    fs.mkdirSync(shim);\n+    const marker = path.join(tmpPrefix, \"gh-shim-executed\");\n+    fs.writeFileSync(path.join(shim, \"gh\"), `#!/bin/sh\\n: > '${marker}'\\nexit 0\\n`, { mode: 0o755 });\n+    fs.chmodSync(path.join(shim, \"gh\"), 0o755);\n+    process.env.PATH = shim;\n+    process.env.NEXUS_VERIFY_ATTESTATION = \"1\";\n+    try {\n+      await assert.rejects(\n+        performUpgrade(comparison, { prefix: tmpPrefix, timeoutMs: 5000, trustedGhPaths: [] }),\n+        /no trusted GitHub CLI was found at \\/usr\\/bin\\/gh/,\n+        \"a required attestation must fail closed when no trusted gh exists\",\n+      );\n+      assert.equal(fs.existsSync(marker), false, \"the PATH gh shim was executed\");\n+      assert.equal(readJournal(tmpPrefix), null, \"required attestation must fail before starting the journal\");\n+      const libEntries = fs.existsSync(path.join(tmpPrefix, \"lib\", \"nexus\"))\n+        ? fs.readdirSync(path.join(tmpPrefix, \"lib\", \"nexus\"))\n+        : [];\n+      assert.equal(\n+        libEntries.some((name) => name.startsWith(\".tmp-upgrade-\") || name === \".upgrade-journal.json\"),\n+        false,\n+        \"required attestation must not leave upgrade staging or a journal\",\n+      );\n+    } finally {\n+      if (savedPath === undefined) delete process.env.PATH;\n+      else process.env.PATH = savedPath;\n+      if (savedAttestation === undefined) delete process.env.NEXUS_VERIFY_ATTESTATION;\n+      else process.env.NEXUS_VERIFY_ATTESTATION = savedAttestation;\n+    }\n+  });\n+\n+  it(\"rejects required attestation when the trusted gh reports failure\", async () => {\n+    const oldVersion = \"v0.1.0-alpha.2\";\n+    const vOldDir = setupInstalledVersion(tmpPrefix, oldVersion);\n+    fs.mkdirSync(path.join(tmpPrefix, \"bin\"), { recursive: true });\n+    fs.symlinkSync(path.join(vOldDir, \"bin\", \"nexus\"), path.join(tmpPrefix, \"bin\", \"nexus\"));\n+\n+    const installed = detectInstallation({ nexusHome: vOldDir, envPrefix: tmpPrefix });\n+    const target = await resolveTargetRelease(undefined, { timeoutMs: 5000 });\n+    const comparison = compareInstallationWithRelease(installed, target);\n+\n+    const failingGh = path.join(tmpPrefix, \"trusted-gh\");\n+    fs.writeFileSync(failingGh, \"#!/bin/sh\\nexit 1\\n\", { mode: 0o755 });\n+    fs.chmodSync(failingGh, 0o755);\n+    const savedAttestation = process.env.NEXUS_VERIFY_ATTESTATION;\n+    process.env.NEXUS_VERIFY_ATTESTATION = \"1\";\n+    try {\n+      await assert.rejects(\n+        performUpgrade(comparison, { prefix: tmpPrefix, timeoutMs: 5000, trustedGhPaths: [failingGh] }),\n+        /Provenance attestation verification failed for .* or SHA256SUMS/,\n+        \"a trusted gh reporting failure must reject required attestation\",\n+      );\n+    } finally {\n+      if (savedAttestation === undefined) delete process.env.NEXUS_VERIFY_ATTESTATION;\n+      else process.env.NEXUS_VERIFY_ATTESTATION = savedAttestation;\n+    }\n+  });\n+\n   it(\"refuses downgrade when target release has incompatible state schema version\", async () => {\n     // Current installation at v1.0.0\n     const v1Dir = setupInstalledVersion(tmpPrefix, \"v1.0.0\");\ndiff --git a/docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md b/docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md\nindex 145e3e3..9dc10b7 100644\n--- a/docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md\n+++ b/docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md\n@@ -92,7 +92,9 @@ The upgrade capability is implemented in `cli/src/upgrade.ts` as a pure, testabl\n - **Integrity**:\n   - Downloads release tarball and `SHA256SUMS`.\n   - Computes SHA-256 of downloaded archive; compares with published checksum.\n-  - If `gh` is installed and `NEXUS_VERIFY_ATTESTATION != 0`, verifies GitHub build provenance attestation.\n+  - If a trusted `gh` exists at `/usr/bin/gh` or `/usr/local/bin/gh` and `NEXUS_VERIFY_ATTESTATION != 0`, verifies\n+    GitHub build provenance attestation. `PATH`-resolved `gh` is not used; with `NEXUS_VERIFY_ATTESTATION=1`, a\n+    missing trusted `gh` fails closed.\n   - Extracts to staging directory; validates `bin/nexus`, `lib/core/harness-core`, `lib/core/nexus-tui`, and `VERSION`.\n   - Verifies package `MANIFEST.sha256` if present.\n \n--- attestation references ---\norigin/main:cli/src/upgrade.ts:120:  attestationVerified?: boolean;\norigin/main:cli/src/upgrade.ts:517:    // Check if prereleases exist (matching install.sh behavior)\norigin/main:cli/src/upgrade.ts:581:      \"Nexus is running from a source development checkout. Use `git pull && make build` to update, or install the packaged release via `install.sh`.\"\norigin/main:cli/src/upgrade.ts:917:  const verifyAttestation = process.env.NEXUS_VERIFY_ATTESTATION ?? \"auto\";\norigin/main:cli/src/upgrade.ts:922:      \"Provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\",\norigin/main:cli/src/upgrade.ts:1041:    options?.onProgress?.(\"verifying_checksum\", \"Verifying release checksums...\");\norigin/main:cli/src/upgrade.ts:1069:    // Optional attestation check via a trusted gh if present. Do not resolve it from PATH: a shim that exits 0\norigin/main:cli/src/upgrade.ts:1070:    // must not be able to claim a verified attestation, and a missing gh must fail closed when verification is required.\norigin/main:cli/src/upgrade.ts:1071:    let attestationVerified: boolean | undefined;\norigin/main:cli/src/upgrade.ts:1074:        options?.onProgress?.(\"verifying_attestation\", \"Checking build provenance attestation...\");\norigin/main:cli/src/upgrade.ts:1075:        const attestCheck = spawnSync(trustedGh, [\"attestation\", \"verify\", localArchive, \"-R\", CANONICAL_REPO]);\norigin/main:cli/src/upgrade.ts:1076:        const indexAttestCheck = spawnSync(trustedGh, [\"attestation\", \"verify\", localSums, \"-R\", CANONICAL_REPO]);\norigin/main:cli/src/upgrade.ts:1077:        if (attestCheck.status === 0 && indexAttestCheck.status === 0) {\norigin/main:cli/src/upgrade.ts:1078:          attestationVerified = true;\norigin/main:cli/src/upgrade.ts:1080:          throw new Error(`Provenance attestation verification failed for ${archiveName} or SHA256SUMS.`);\norigin/main:cli/src/upgrade.ts:1084:          \"Provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\",\norigin/main:cli/src/upgrade.ts:1123:    // The in-archive copy is authenticated by the archive checksum/attestation.\norigin/main:cli/src/upgrade.ts:1268:      attestationVerified,\norigin/main:docs/releases/PROTECTIONS.md:14:| Default workflow token | `read`; workflows request extra permissions themselves (`release.yml`: `contents`, `id-token`, `attestations` write) |\norigin/main:docs/v1.0.0/ACCEPTANCE.md:26:3. **RC artifact gates.** Before installed-RC product qualification, run every G0–G4 check whose acceptance method requires the RC archive, RC attestation/release, or workflow-produced artifact. This includes ACC-SUP-01/02/03/06/08. ACC-PKG checks that explicitly require an installed package run against this RC as specified by their test method. Record the RC tag commit, workflow run, artifact digests, and each check result. A source-level analogue does not replace an artifact-bound check.\norigin/main:docs/v1.0.0/ACCEPTANCE.md:87:Every ACC ID below is defined in the linked spec. The plan for each spec names the test that implements it. Run each check at the lifecycle stage dictated by its acceptance method in §1.1: source-applicable checks before the RC tag; checks requiring the RC archive, attestation, release, or installed package after RC construction; environment-specific checks in their declared environment. Bind every result to the exact source commit and, when artifact-dependent, the RC package digest. A source test or local build does not replace an artifact-bound check, and no G0–G4 ID is complete until all of its applicable checks pass.\norigin/main:docs/v1.0.0/ACCEPTANCE.md:280:| Attestation | `gh attestation verify <tarball> -R mikeholownych/nexus-code` | PASS |\norigin/main:docs/v1.0.0/ACCEPTANCE.md:322:| CON-A3 | On a clean VM, `install.sh --fresh` followed by `post-install-qualify.py` passes. |\norigin/main:docs/v1.0.0/ACCEPTANCE.md:341:  The version 1 record contains `sourceCommit` (full commit ID), `rcTag` (for example `v1.0.0-rc.1`), `artifactSha256`, `artifactProvenance` (`sourceCommit`, `artifactSha256`, and a hashed provenance report), `independentAcceptance` (`disposition`, `reviewer`, `implementers`, zero `blockingDefects`, and a hashed report reference), and one `requirements` entry for every B/RR row. For `ACCEPT WITH DEFECTS`, include each non-blocking defect with its owner disposition; unresolved or blocking defects fail. Each requirement entry records its status and one or more hashed evidence files covering the exact criteria required by the ledger and the §1.1 qualification-only map. Every criterion evidence file must be a JSON object with top-level `sourceCommit`, `rcTag`, and `artifactSha256` values exactly matching the validated qualification record, current RC source commit, and installed RC artifact. A digest-valid report copied from another source revision, RC tag, or artifact is rejected. A B row recorded as `tested` also needs a non-empty `qualificationNotApplicable.reason` and a `qualificationNotApplicable.decision` matching the approved per-requirement exception table and a matching applicability declaration in DECISIONS.md; an unrelated or record-supplied decision is rejected. Evidence paths must be relative regular files under the evidence root, with no symlinks. Missing, unknown, stale, mismatched, or incomplete evidence fails the gate. The checker requires a clean worktree, rejects `--ledger` overrides, enforces source-ledger thresholds outside the explicit §1.1 lifecycle rows, and requires the exact-RC record itself to meet the normal status threshold for every row. It never mutates the source ledger or relaxes a requirement's B/RR record threshold. The checker validates source/tag/artifact identity bindings and evidence hashes; it does not authenticate the reviewer or prove that the artifact was built from the source commit. The approved release workflow must independently verify build provenance/attestation, and the designated custodian and independent reviewer must verify their respective approvals and custody evidence.\norigin/main:docs/v1.0.0/REQUIREMENTS.md:76:| REQ-REL-001 | quickstart | Installer: non-root; SHA-256 verified; no shell-rc edits; refuses a foreign `nexus`; atomic symlink swap; failure leaves HOME untouched. | `install.sh` | RT (E §4); TEST installer-smoke | tested | N | — | ACC-PKG-05 | K | SPEC-06 |\norigin/main:docs/v1.0.0/REQUIREMENTS.md:78:| REQ-REL-003 | DEVELOPMENT.md; DEC-12 | Supported platform: Linux x86-64, glibc ≥ 2.35, Node ≥ 22. Clear failure messages elsewhere. | `install.sh`, doctor, upgrade preflight | Runtime/workflow source candidate `7c46a6d52095588f48579d9a96c5b2d526bdb3d9` passed PR #150 exact CI run `39866110578` (Node 22, Node 24, and `linux-x86_64`) and CodeQL `39866110533`; focused `node_floor.test.ts` passed 6/6 on Node 24. Installed-RC platform qualification E2 remains pending. | partial | N | Installed-RC platform qualification E2 remains pending. | ACC-PLAT | RR | SPEC-07 |\norigin/main:docs/v1.0.0/REQUIREMENTS.md:79:| REQ-REL-004 | quickstart | Upgrade and rollback by re-running the installer with a tag. Manual uninstall keeps user data. | `install.sh` | RT (alpha.1→2→1) | tested | N | Reinstall does not repair (REL-10) | ACC-PKG-05 | K | SPEC-06 |\norigin/main:docs/v1.0.0/REQUIREMENTS.md:190:| REQ-REL-105 | Audit | Installer: strict tag check, clear no-stable message, repair on reinstall, quiet output. | onboarding | `install.sh` | TEST (ACC-PKG-05; test:scripts/installer-smoke.sh) | tested | ACC-PKG-05 | RR | REL-08, REL-10, REL-11, REL-12 | SPEC-06 / PLAN-06 |\norigin/main:docs/v1.0.0/REQUIREMENTS.md:198:| REQ-REL-109 | TOP_TIER D4 | Provenance attestation; tag-pinned installer asset. | supply chain | `release.yml` | TEST (ACC-SUP-03; test:release.yml, install.sh) | tested | ACC-SUP-03 | RR | REL-09 | SPEC-07 / PLAN-07 |\norigin/main:docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md:14:Nexus currently requires operators to re-run the external `install.sh` script via `curl -fsSL ... | sh` to upgrade or downgrade installed binaries. There is no CLI command (`nexus upgrade`) and no TUI slash command (`/upgrade`) to:\norigin/main:docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md:41:   - Publish and validate machine-readable release compatibility metadata (`compatibility.json`), verifying schema compatibility and applying an explicit fallback policy for legacy public releases.\norigin/main:docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md:47:   - Establish publisher trust boundary and attestation recommendations in `docs/UPGRADE_SECURITY.md`.\norigin/main:docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md:95:  - If a trusted `gh` exists at `/usr/bin/gh` or `/usr/local/bin/gh` and `NEXUS_VERIFY_ATTESTATION != 0`, verifies\norigin/main:docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md:96:    GitHub build provenance attestation. `PATH`-resolved `gh` is not used; with `NEXUS_VERIFY_ATTESTATION=1`, a\norigin/main:docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md:130:| ACC-UPG-14 | Publisher Authenticity Assessment | Evaluates trust boundary, SHA-256 baseline, and documents signing/attestation recommendations in `docs/UPGRADE_SECURITY.md`. |\norigin/main:install.sh:74:if [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" != \"0\" ] && command -v gh >/dev/null 2>&1; then\norigin/main:install.sh:75:  if gh attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\norigin/main:install.sh:76:     gh attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\norigin/main:install.sh:78:  elif [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" = \"1\" ]; then\norigin/main:install.sh:79:    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n","exit_code":0,"duration":{"secs":0,"nanos":35031}},"started_at_ms":1792900872355,"completed_at_ms":1792900872356}}
