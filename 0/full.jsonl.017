uts, then confirm twice.\n+                    session.send(b\"\\x1b[D\", settle=2.2)\n+                    session.send(b\"\\r\", settle=0.6)\n+                    session.send(b\"\\r\", settle=0.6)\n+                    session.wait_text(\"Test suite passed.\", timeout=30)\n+            else:\n+                result[\"approvalPrompt\"] = False\n+                session.wait_text(\"Test suite passed.\", timeout=30)\n+            print(json.dumps(result))\n+            return\n+\n         session.send(b\"Run the requested command now\\r\", settle=0.2)\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /home/mike/nexus-wt/sec101-119-pty-followup/cli/test/helpers/startup_permission_driver.py\n","stderr":""},"started_at_ms":1792891219895,"completed_at_ms":1792891219896}}
