{"timestamp":"2026-10-25T02:19:59.096Z","ordinal":320157,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a170d0-7672-79e2-b11d-117e84b3ea44","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a170d0-7672-79e2-b11d-117e84b3ea44","response_id":"resp_060b64278a9dfb15016add674c53c881a0862624e41e5cee08","usage":{"input_tokens":96885,"cached_input_tokens":93312,"cache_write_input_tokens":0,"output_tokens":302,"reasoning_output_tokens":185,"total_tokens":97187},"turn_token_usage":{"input_tokens":9825074,"cached_input_tokens":9743104,"cache_write_input_tokens":0,"output_tokens":27534,"reasoning_output_tokens":13250,"total_tokens":9852608},"thread_token_usage":{"input_tokens":5818486580,"cached_input_tokens":5755924352,"cache_write_input_tokens":0,"output_tokens":16476190,"reasoning_output_tokens":9467055,"total_tokens":5834962770}}}
{"timestamp":"2026-10-25T02:20:01.200Z","ordinal":320158,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a170d0-7672-79e2-b11d-117e84b3ea44","item":{"type":"CommandExecution","id":"exec-6827c071-aee6-42e2-83be-ef855e1b4137","process_id":"25788","command":["/usr/bin/zsh","-lc","sed -n '1,180p' scripts/run_tests.mjs && rg -n 'test:cli/test/(git_exclude|flight_exclude|safe_fs)|test:.*(git_exclude|flight_exclude|safe_fs)' test cli/package.json cli"],"cwd":"file:///home/mike/nexus-wt/git-exclude-fail-closed/cli","parsed_cmd":[{"type":"read","cmd":"sed -n '1,180p' scripts/run_tests.mjs","name":"run_tests.mjs","path":"scripts/run_tests.mjs"},{"type":"search","cmd":"rg -n 'test:cli/test/(git_exclude|flight_exclude|safe_fs)|test:.*(git_exclude|flight_exclude|safe_fs)' test cli/package.json cli","query":"test:cli/test/(git_exclude|flight_exclude|safe_fs)|test:.*(git_exclude|flight_exclude|safe_fs)","path":"test"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"// Runs the CLI test suite with a throwaway HOME so no test (or anything it spawns: the sidecar, the TUI, PTY drivers)\n// can read or write the operator's ~/.nexus or ~/.config/nexus. The real home is passed as NEXUS_TEST_REAL_HOME so the\n// guard test can prove the isolation held. Arguments are test files; none means every test/*.test.ts.\n// NEXUS_KEEP_TEST_HOME=1 keeps the temporary home for inspection.\nimport { spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst cli = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst realHome = os.homedir();\nconst home = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-test-home-\"));\n\nconst files = process.argv.length > 2\n  ? process.argv.slice(2)\n  : fs.readdirSync(path.join(cli, \"test\")).filter((f) => f.endsWith(\".test.ts\")).sort().map((f) => path.join(\"test\", f));\n\nconst env = {\n  ...process.env,\n  HOME: home,\n  XDG_CONFIG_HOME: path.join(home, \".config\"),\n  XDG_DATA_HOME: path.join(home, \".local\", \"share\"),\n  XDG_STATE_HOME: path.join(home, \".local\", \"state\"),\n  XDG_CACHE_HOME: path.join(home, \".cache\"),\n  NEXUS_TEST_REAL_HOME: realHome,\n};\n// Rust and Node toolchains installed per user keep working under the throwaway home.\nfor (const [key, dir] of [[\"CARGO_HOME\", \".cargo\"], [\"RUSTUP_HOME\", \".rustup\"]]) {\n  if (!env[key] && fs.existsSync(path.join(realHome, dir))) env[key] = path.join(realHome, dir);\n}\n\nconst tsx = path.join(cli, \"node_modules\", \".bin\", \"tsx\");\nconst result = spawnSync(tsx, [\"--test\", \"--test-concurrency=1\", ...files], { cwd: cli, env, stdio: \"inherit\" });\n\nif (process.env.NEXUS_KEEP_TEST_HOME === \"1\") console.error(`test home kept at ${home}`);\nelse fs.rmSync(home, { recursive: true, force: true });\n\nif (result.error) throw result.error;\nprocess.exit(result.status ?? 1);\nrg: cli/package.json: No such file or directory (os error 2)\nrg: cli: No such file or directory (os error 2)\n","exit_code":2,"duration":{"secs":1,"nanos":51580211}},"started_at_ms":1792894800148,"completed_at_ms":1792894801200}}
{"timestamp":"2026-10-25T02:20:02.178Z","ordinal":320159,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a170db-9902-7240-8287-25f63a86bb04","call_id":"call_1496d4b08432486e8e8911f5ba78039f","output":[{"type":"input_text","text":"Script completed\nWall time 3.1 seconds\nOutput:\n"},{"type":"input_text","text":"// Runs the CLI test suite with a throwaway HOME so no test (or anything it spawns: the sidecar, the TUI, PTY drivers)\n// can read or write the operator's ~/.nexus or ~/.config/nexus. The real home is passed as NEXUS_TEST_REAL_HOME so the\n// guard test can prove the isolation held. Arguments are test files; none means every test/*.test.ts.\n// NEXUS_KEEP_TEST_HOME=1 keeps the temporary home for inspection.\nimport { spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst cli = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst realHome = os.homedir();\nconst home = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-test-home-\"));\n\nconst files = process.argv.length > 2\n  ? process.argv.slice(2)\n  : fs.readdirSync(path.join(cli, \"test\")).filter((f) => f.endsWith(\".test.ts\")).sort().map((f) => path.join(\"test\", f));\n\nconst env = {\n  ...process.env,\n  HOME: home,\n  XDG_CONFIG_HOME: path.join(home, \".config\"),\n  XDG_DATA_HOME: path.join(home, \".local\", \"share\"),\n  XDG_STATE_HOME: path.join(home, \".local\", \"state\"),\n  XDG_CACHE_HOME: path.join(home, \".cache\"),\n  NEXUS_TEST_REAL_HOME: realHome,\n};\n// Rust and Node toolchains installed per user keep working under the throwaway home.\nfor (const [key, dir] of [[\"CARGO_HOME\", \".cargo\"], [\"RUSTUP_HOME\", \".rustup\"]]) {\n  if (!env[key] && fs.existsSync(path.join(realHome, dir))) env[key] = path.join(realHome, dir);\n}\n\nconst tsx = path.join(cli, \"node_modules\", \".bin\", \"tsx\");\nconst result = spawnSync(tsx, [\"--test\", \"--test-concurrency=1\", ...files], { cwd: cli, env, stdio: \"inherit\" });\n\nif (process.env.NEXUS_KEEP_TEST_HOME === \"1\") console.error(`test home kept at ${home}`);\nelse fs.rmSync(home, { recursive: true, force: true });\n\nif (result.error) throw result.error;\nprocess.exit(result.status ?? 1);\nrg: cli/package.json: No such file or directory (os error 2)\nrg: cli: No such file or directory (os error 2)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a170d0-7672-79e2-b11d-117e84b3ea44","create_time":1792894802.1781182}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
