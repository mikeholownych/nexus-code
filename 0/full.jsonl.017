ws/repro.yml-142-          path: |\n.github/workflows/repro.yml:143:            ${{ runner.temp }}/dist/nexus-linux-x86_64-${{ inputs.tag }}.tar.gz\n.github/workflows/repro.yml-144-            ${{ runner.temp }}/dist/compatibility.json\n.github/workflows/repro.yml-145-            ${{ runner.temp }}/dist/SHA256SUMS\n.github/workflows/repro.yml-146-            ${{ runner.temp }}/dist/THIRD_PARTY_NOTICES.txt\n.github/workflows/repro.yml-147-            ${{ runner.temp }}/dist/sbom.cdx.json\n.github/workflows/repro.yml-148-            ${{ runner.temp }}/dist/install.sh\n--\n.github/workflows/repro.yml-175-          path: ${{ runner.temp }}/ubuntu-24.04\n.github/workflows/repro.yml-176-      - name: Download published RC assets\n.github/workflows/repro.yml-177-        env:\n.github/workflows/repro.yml-178-          GH_TOKEN: ${{ github.token }}\n.github/workflows/repro.yml-179-        run: |\n.github/workflows/repro.yml:180:          archive=\"nexus-linux-x86_64-$TARGET_TAG.tar.gz\"\n.github/workflows/repro.yml-181-          mkdir -p \"$RUNNER_TEMP/published\"\n.github/workflows/repro.yml-182-          gh release download \"$TARGET_TAG\" \\\n.github/workflows/repro.yml-183-            --pattern \"$archive\" \\\n.github/workflows/repro.yml-184-            --pattern compatibility.json \\\n.github/workflows/repro.yml-185-            --pattern SHA256SUMS \\\n--\n.github/workflows/repro.yml-187-            --pattern sbom.cdx.json \\\n.github/workflows/repro.yml-188-            --pattern install.sh \\\n.github/workflows/repro.yml-189-            --dir \"$RUNNER_TEMP/published\"\n.github/workflows/repro.yml-190-      - name: Compare both runner builds with each other and the published RC\n.github/workflows/repro.yml-191-        run: |\n.github/workflows/repro.yml:192:          archive=\"nexus-linux-x86_64-$TARGET_TAG.tar.gz\"\n.github/workflows/repro.yml-193-          for runner in ubuntu-22.04 ubuntu-24.04; do\n.github/workflows/repro.yml-194-            (cd \"$RUNNER_TEMP/$runner\" && sha256sum --check SHA256SUMS)\n.github/workflows/repro.yml-195-          done\n.github/workflows/repro.yml-196-          (cd \"$RUNNER_TEMP/published\" && sha256sum --check SHA256SUMS)\n.github/workflows/repro.yml-197-          for file in \"$archive\" compatibility.json SHA256SUMS THIRD_PARTY_NOTICES.txt sbom.cdx.json install.sh; do\n--\n.github/workflows/ci.yml-1-name: CI\n.github/workflows/ci.yml-2-\n.github/workflows/ci.yml-3-on:\n.github/workflows/ci.yml-4-  push:\n.github/workflows/ci.yml-5-    branches: [main]\n.github/workflows/ci.yml:6:  pull_request:\n.github/workflows/ci.yml:7:  workflow_dispatch:\n.github/workflows/ci.yml-8-\n.github/workflows/ci.yml-9-permissions:\n.github/workflows/ci.yml-10-  contents: read\n.github/workflows/ci.yml-11-\n.github/workflows/ci.yml-12-jobs:\n--\n.github/workflows/ci.yml-74-          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n.github/workflows/ci.yml-75-          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n.github/workflows/ci.yml-76-          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n.github/workflows/ci.yml-77-      - run: npm --prefix cli test\n.github/workflows/ci.yml-78-\n.github/workflows/ci.yml:79:  linux-x86_64:\n.github/workflows/ci.yml-80-    needs: [test-matrix]\n.github/workflows/ci.yml-81-    runs-on: ubuntu-22.04\n.github/workflows/ci.yml-82-    env:\n.github/workflows/ci.yml-83-      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n.github/workflows/ci.yml-84-    steps:\n--\n.github/workflows/ci.yml-146-      - run: node scripts/check_requirements.mjs\n.github/workflows/ci.yml-147-      - id: release-version\n.github/workflows/ci.yml-148-        run: echo \"version=$(node -p 'require(\"./package.json\").version')\" >> \"$GITHUB_OUTPUT\"\n.github/workflows/ci.yml-149-      - run: bash scripts/package-linux.sh \"v${{ steps.release-version.outputs.version }}\" \"$RUNNER_TEMP/dist\"\n.github/workflows/ci.yml-150-      - run: bash scripts/package-linux.sh \"v${{ steps.release-version.outputs.version }}\" \"$RUNNER_TEMP/repro-check\"\n.github/workflows/ci.yml:151:      - run: cmp \"$RUNNER_TEMP/dist/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\" \"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\"\n.github/workflows/ci.yml-152-      - run: cmp \"$RUNNER_TEMP/dist/SHA256SUMS\" \"$RUNNER_TEMP/repro-check/SHA256SUMS\"\n.github/workflows/ci.yml-153-      - run: cmp \"$RUNNER_TEMP/dist/THIRD_PARTY_NOTICES.txt\" \"$RUNNER_TEMP/repro-check/THIRD_PARTY_NOTICES.txt\"\n.github/workflows/ci.yml-154-      - run: cyclonedx validate --input-file \"$RUNNER_TEMP/dist/sbom.cdx.json\" --fail-on-errors\n.github/workflows/ci.yml-155-      - run: cmp \"$RUNNER_TEMP/dist/sbom.cdx.json\" \"$RUNNER_TEMP/repro-check/sbom.cdx.json\"\n.github/workflows/ci.yml-156-      - run: cmp \"$RUNNER_TEMP/dist/install.sh\" \"$RUNNER_TEMP/repro-check/install.sh\"\n.github/workflows/ci.yml:157:      - run: bash scripts/smoke-package.sh \"$RUNNER_TEMP/dist/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\"\n.github/workflows/ci.yml:158:      - run: bash scripts/installer-smoke.sh \"$GITHUB_WORKSPACE/install.sh\" \"$RUNNER_TEMP/dist/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\"\n.github/workflows/ci.yml-159-      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n.github/workflows/ci.yml-160-        with:\n.github/workflows/ci.yml:161:          name: nexus-linux-x86_64\n.github/workflows/ci.yml-162-          path: ${{ runner.temp }}/dist/*\n.github/workflows/ci.yml-163-          if-no-files-found: error\n--\n.github/workflows/release.yml-78-          git merge-base --is-ancestor \"$GITHUB_SHA\" origin/main\n.github/workflows/release.yml-79-          test \"${GITHUB_REF_NAME#v}\" = \"$(node -p 'require(\"./package.json\").version')\"\n.github/workflows/release.yml-80-          node scripts/sync-version.mjs --check --tag \"$GITHUB_REF_NAME\"\n.github/workflows/release.yml-81-          test -f \"docs/releases/${GITHUB_REF_NAME}.md\" || { echo \"Missing docs/releases/${GITHUB_REF_NAME}.md\" >&2; exit 1; }\n.github/workflows/release.yml-82-      - name: Require a stable tag to be a version-only commit on its RC\n.github/workflows/release.yml:83:        if: ${{ !contains(github.ref_name, '-') }}\n.github/workflows/release.yml-84-        # The checkout has full history and tags (fetch-depth: 0). The checker runs from the RC's own copy so a stable\n.github/workflows/release.yml-85-        # commit cannot replace it; branch and tag protection remain the control over the workflow file itself.\n.github/workflows/release.yml-86-        run: |\n.github/workflows/release.yml-87-          rc=\"$(git tag --points-at \"$GITHUB_SHA^\" | grep -E \"^${GITHUB_REF_NAME//./\\\\.}-rc\\.[0-9]+$\" | sort -V | tail -n 1 || true)\"\n.github/workflows/release.yml-88-          test -n \"$rc\" || { echo \"the parent of $GITHUB_REF_NAME is not a ${GITHUB_REF_NAME}-rc.N tag\" >&2; exit 1; }\n--\n.github/workflows/release.yml-94-      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n.github/workflows/release.yml-95-      - run: npm --prefix cli test\n.github/workflows/release.yml-96-      - run: bash scripts/security_gates.sh\n.github/workflows/release.yml-97-      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/dist\"\n.github/workflows/release.yml-98-      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/repro-check\"\n.github/workflows/release.yml:99:      - run: cmp \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\" \"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n.github/workflows/releas