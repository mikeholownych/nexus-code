{"timestamp":"2026-10-24T23:38:07.154Z","ordinal":314141,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a1703b-4280-7320-9374-5c397c112b4d","item":{"type":"CommandExecution","id":"exec-87c5ee3c-86e3-4693-8ad3-68b710c6e71f","process_id":"85081","command":["/usr/bin/zsh","-lc","sed -n '95,220p' scripts/package-linux.sh; sed -n '1,200p' .github/workflows/cross-runner-reproducibility.yml 2>/dev/null; rg -n 'package-linux.sh|archive|reproducibility' cli/test scripts/test docs/v1.0.0 | head -120"],"cwd":"file:///home/mike/nexus-wt/plan-09-packaging-tar-repro","parsed_cmd":[{"type":"unknown","cmd":"sed -n '95,220p' scripts/package-linux.sh; sed -n '1,200p' .github/workflows/cross-runner-reproducibility.yml 2>/dev/null; rg -n 'package-linux.sh|archive|reproducibility' cli/test scripts/test docs/v1.0.0 | head -120"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    \"core\": \"${VERSION#v}\",\n    \"tui\": \"${VERSION#v}\",\n    \"harness\": \"${VERSION#v}\"\n  },\n  \"compatibility\": {\n    \"configSchemaVersion\": 1,\n    \"stateSchemaVersion\": $STATE_SCHEMA_VERSION,\n    \"minSupportedConfigVersion\": 1,\n    \"minSupportedStateVersion\": 0\n  },\n  \"platforms\": {\n    \"linux-x86_64\": {\n      \"archive\": \"$ARCHIVE\",\n      \"os\": \"linux\",\n      \"arch\": \"x86_64\",\n      \"libc\": \"glibc-2.35\"\n    }\n  }\n}\nEOF\nnode \"$ROOT/scripts/validate_compatibility.mjs\" \"$PKG/compatibility.json\"\n\ncargo about generate -m \"$ROOT/core/Cargo.toml\" -c \"$ROOT/about.toml\" \"$ROOT/about.hbs\" > \"$WORK/notices-rust.txt\"\n# Keep the full release-tool dependency graph fixed across the RC builds.\nRELEASE_TOOLS=\"$WORK/release-tools\"\nmkdir -p \"$RELEASE_TOOLS\"\ncp \"$ROOT/scripts/release-tools/package.json\" \"$ROOT/scripts/release-tools/package-lock.json\" \"$RELEASE_TOOLS/\"\nnode \"$ROOT/scripts/check_deprecated_lock.mjs\" \"$ROOT/scripts/release-tools/package-lock.json\"\nnpm ci --ignore-scripts --prefix \"$RELEASE_TOOLS\"\nRELEASE_TOOLS_BIN=\"$RELEASE_TOOLS/node_modules/.bin\"\n\"$RELEASE_TOOLS_BIN/license-checker-rseidelsohn\" --production --plainVertical --start \"$PKG/lib/cli\" > \"$WORK/notices-npm.txt\"\ncat > \"$PKG/THIRD_PARTY_NOTICES.txt\" <<'EOF'\n================================================================================\nNexus Code Third-Party Software Notices and Licenses\n================================================================================\n\nThis package contains third-party software components licensed under open-source\nlicenses. The following sections provide notices and license texts for all\nruntime and statically-linked dependencies included in this distribution.\n\n================================================================================\nSection 1: Rust Components (harness-core & nexus-tui)\n================================================================================\nEOF\ncat \"$WORK/notices-rust.txt\" >> \"$PKG/THIRD_PARTY_NOTICES.txt\"\ncat >> \"$PKG/THIRD_PARTY_NOTICES.txt\" <<'EOF'\n\n================================================================================\nSection 2: Node.js / npm Components (CLI Runtime)\n================================================================================\nEOF\ncat \"$WORK/notices-npm.txt\" >> \"$PKG/THIRD_PARTY_NOTICES.txt\"\ncp \"$PKG/THIRD_PARTY_NOTICES.txt\" \"$OUT/THIRD_PARTY_NOTICES.txt\"\ncat > \"$PKG/bin/nexus\" <<'EOF'\n#!/bin/sh\nset -eu\nNEXUS_HOME=$(CDPATH= cd -- \"$(dirname -- \"$(readlink -f -- \"$0\")\")/..\" && pwd)\nexport NEXUS_HOME\nif [ -z \"${NODE_EXTRA_CA_CERTS:-}\" ] && [ -n \"${HOME:-}\" ] && [ -f \"$HOME/.config/nexus/config.env\" ]; then\n  _ca=$(sed -n 's/^[[:space:]]*NODE_EXTRA_CA_CERTS[[:space:]]*=[[:space:]]*//p' \"$HOME/.config/nexus/config.env\" | tail -n 1 | sed \"s/^['\\\"]//;s/['\\\"]$//\")\n  if [ -n \"$_ca\" ]; then\n    case \"$_ca\" in\n      \"~/\"*) _ca=\"$HOME/${_ca#\\~/}\" ;;\n    esac\n    export NODE_EXTRA_CA_CERTS=\"$_ca\"\n  fi\n  unset _ca\nfi\nexec node \"$NEXUS_HOME/lib/cli/dist/index.js\" \"$@\"\nEOF\nchmod 0755 \"$PKG/bin/nexus\" \"$PKG/lib/core/harness-core\" \"$PKG/lib/core/nexus-tui\"\n(cd \"$PKG\" && find . -type f ! -name MANIFEST.sha256 | LC_ALL=C sort | xargs sha256sum > MANIFEST.sha256)\n# The RC build runs on multiple Ubuntu images. Their host tar versions encode\n# the unused PAX device-number fields differently, which changes the archive\n# digest even when every packaged file is identical. Use the same digest-pinned\n# image as the Rust build for tar and gzip so the complete archive format is\n# independent of the host runner. The explicitly opted-in local development\n# path remains host-built and must not be used as reproducibility evidence.\nif [[ -n \"${NEXUS_BUILD_CONTAINER_IMAGE:-}\" ]]; then\n  docker run --rm --pull=always --platform linux/amd64 \\\n    --user \"$(id -u):$(id -g)\" \\\n    --mount \"type=bind,src=$WORK,dst=/nexus-package,readonly\" \\\n    --mount \"type=bind,src=$OUT,dst=/nexus-output\" \\\n    --workdir /nexus-package \\\n    --env \"SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH\" \\\n    --env \"ARCHIVE=$ARCHIVE\" \\\n    \"$NEXUS_BUILD_CONTAINER_IMAGE\" \\\n    sh -ec 'tmp=$(mktemp); tar --sort=name --format=pax --mtime=\"@$SOURCE_DATE_EPOCH\" --owner=0 --group=0 --numeric-owner --pax-option=delete=atime,delete=ctime -cf \"$tmp\" nexus; gzip -n -c \"$tmp\" > \"/nexus-output/$ARCHIVE\"'\nelse\n  tar --sort=name --format=pax --mtime=\"@$SOURCE_DATE_EPOCH\" --owner=0 --group=0 --numeric-owner \\\n    --pax-option=delete=atime,delete=ctime -C \"$WORK\" -cf - nexus | gzip -n > \"$OUT/$ARCHIVE\"\nfi\n\n# The detached metadata repeats only the authenticated in-archive contract and\n# adds the digest of the exact archive. The release checksum index covers both.\nARCHIVE_SHA=$(sha256sum \"$OUT/$ARCHIVE\" | awk '{print $1}')\nnode - \"$PKG/compatibility.json\" \"$OUT/compatibility.json\" \"$ARCHIVE\" \"$ARCHIVE_SHA\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [source, destination, archive, sha256] = process.argv.slice(2);\nconst metadata = JSON.parse(fs.readFileSync(source, \"utf8\"));\nmetadata.platforms[\"linux-x86_64\"].sha256 = sha256;\nif (metadata.platforms[\"linux-x86_64\"].archive !== archive) throw new Error(\"compatibility archive name mismatch\");\nfs.writeFileSync(destination, `${JSON.stringify(metadata, null, 2)}\\n`);\nNODE\n(cd \"$OUT\" && sha256sum \"$ARCHIVE\" compatibility.json > SHA256SUMS)\n\n# Generate lockfile-derived merged CycloneDX SBOM (REQ-REL-108, ACC-SUP-02)\n\"$ROOT/scripts/generate_sbom.sh\" \"$OUT/sbom.cdx.json\"\n\n# Publish install.sh as release asset (REQ-REL-109)\ncp \"$ROOT/install.sh\" \"$OUT/install.sh\"\n\nnode \"$ROOT/scripts/validate_compatibility.mjs\" \"$OUT/compatibility.json\" --require-digest\n\nprintf 'Built %s\\n' \"$OUT/$ARCHIVE\"\nrg: scripts/test: No such file or directory (os error 2)\ndocs/v1.0.0/EVIDENCE.md:22:| Source | `db1ca55`. Exported with `git archive` to `<scratch>/snap` (non-git), and separately cloned to `<scratch>/clone`, checked out at `db1ca55`. |\ndocs/v1.0.0/EVIDENCE.md:32:| Run | Environment | Commands | Outcome | Archive |\ndocs/v1.0.0/EVIDENCE.md:44:| Run | Command | Result | Request ids | Archive |\ndocs/v1.0.0/EVIDENCE.md:63:| `evidence/G_contest_eval.md` | Contest and eval | `npm test --prefix demo`; slice and Worker builds; broker tests; `sha256sum -c` (bundle FAILED, experiment archives OK); `gpgv` |\ndocs/v1.0.0/DECISIONS.md:159:**Chosen:** Linux x86-64, glibc ≥ 2.35, Node ≥ 22 for v1.0.0. The owner selected Node 22 as the minimum on 2026-10-22 because Node 20 reached end of life on 2026-04-30; v1.0.0 must not require or build on an end-of-life Node runtime. Validate Node 22 and 24 in the source CI matrix, with release and reproducibility builds on Node 22. The docs keep the conservative glibc \"≥ 2.35\" claim; the binaries reference glibc symbols ≤ 2.34. macOS, arm64 and musl are post-v1 roadmap items.\ndocs/v1.0.0/REQUIREMENTS.md:58:| REQ-AGT-004 | COMPACTION §C | Durable compaction commit order archive → task → session (fsync). Failure stops the turn with PERSISTENCE_FAILED. Queued `/compact`. | `agent.ts:3070-3153` | TEST (`test:cli/test/durable_continuity.test.ts::\"ACC-CONT-03: pressure compaction of a work unit survives SIGKILL and restores archived markers\"`, `compaction_continuity.test.ts:533`); HIST 1 live run | tested | Y (source/CI incl. M1/M3/L5 in PR #25; see `docs/reviews/evidence/v1/INDEP-REVIEW-CONTINUITY/dispositions.md`) | Live long-task ACC-CONT-10 pending M5 installed-RC qualification | ACC-CONT-03, ACC-CONT-10 | B (work units) / K (depth 0) | SPEC-04 |\ndocs/v1.0.0/REQUIREMENTS.md:77:| REQ-REL-002 | release.yml | Release is gated on main ancestry, a version match, the full suite, a same-runner byte-reproducible package, and package and installer smoke tests. | `.github/workflows/release.yml` | RT (CI log 905/905) | tested | N | Cross-runner reproducibility unproven | ACC-SUP-08 | K | SPEC-07 |\ndocs/v1.0.0/REQUIREMENTS.md:156:| REQ-AGT-102 | COMPACTION §C (carried) | Durability is decided by an explicit property. Work units commit compactions durably. | data loss | `agent.ts` depth gates | SRC (AGT-02; test:cli/test/durable_continuity.test.ts::\"all source AutonomousAgent construction sites declare durability explicitly\"; test:cli/test/durable_continuity.test.ts::\"ACC-CONT-03: pressure compaction of a work unit survives SIGKILL and restores archived markers\") | tested | ACC-CONT-03 | **B** | AGT-02a | SPEC-04 / PLAN-04 |\ndocs/v1.0.0/REQUIREMENTS.md:186:| REQ-REL-101 | UI-004 (carried) | The packaged `nexus` opens the live TUI on a TTY. One launcher grammar. | primary workflow | `index.ts:747`; `package-linux.sh:24-30`; `live.rs:126-131` | TEST (ACC-PKG-01; test:cli/test/harness_entry.test.ts) | tested | ACC-PKG-01 | **B** | REL-01, TUI-04, DX-05 | SPEC-06 / PLAN-06 |\ndocs/v1.0.0/REQUIREMENTS.md:196:| REQ-REL-107 | License obligations | Third-party notices for all redistributed dependencies. | legal / compliance | `package-linux.sh` | TEST (ACC-SUP-01; test:scripts/check_notices.mjs, scripts/smoke-package.sh) | tested | ACC-SUP-01 | **B** | REL-05 | SPEC-07 / PLAN-07 |\ndocs/v1.0.0/REQUIREMENTS.md:200:| REQ-REL-111 | Audit; DEC-12 | CI matrix for Node 22/24; release, reproducibility and evaluator builds use Node 22; pinned toolchain and MSRV, engines field, dist freshness (untracked). | compatibility | `ci.yml`, `release.yml`, `repro.yml` | At exact candidate `7c46a6d52095588f48579d9a96c5b2d526bdb3d9`, PR #150 CI run `39866110578` passed both required matrix jobs (Node 22 job `120128589470`; Node 24 job `120128589221`). The same revision declares Node `>=22` in both package manifests, uses pinned Rust/MSRV, sets release and reproducibility packaging to Node 22, and runs the `cli/dist` freshness check in the matrix and package workflows. Exact-candidate Linux packaging remains a separate active source gate; this row covers ACC-SUP-05 only. | tested | ACC-SUP-05 | RR | REL-13, MNT-01 | SPEC-07 / PLAN-07 |\ndocs/v1.0.0/REQUIREMENTS.md:203:| REQ-REL-114 | REL-001 (carried) | Cross-runner reproducibility, demonstrated once for the RC. | supply chain | `repro.yml` | UNV | open | ACC-SUP-08 | RR | E §6 | SPEC-07 / PLAN-07 |\ndocs/v1.0.0/REQUIREMENTS.md:205:| REQ-REL-116 | Scope addition | Machine-readable compatibility metadata, download origin & archive extraction safety, pre-migration backups, downgrade state protection, durable provenance, crash recovery, and runtime verification. | installation integrity & lifecycle | `cli/src/upgrade.ts`, `cli/src/compatibility.ts`, `cli/src/tar_safety.ts`, `cli/src/upgrade_journal.ts`, `docs/UPGRADE_SECURITY.md` | TEST (ACC-UPG-07 to ACC-UPG-14; test:cli/test/upgrade_safety.test.ts::\"rejects malicious tar archive with path traversal\", test:cli/test/upgrade_safety.test.ts::\"creates protected config and state backups with 0600 file and 0700 dir permissions\", test:cli/test/upgrade_acceptance.test.ts::\"upgrades from previous release v0.1.0-alpha.2 to v1.0.0 preserving state, configuration and permissions\", test:cli/test/upgrade_acceptance.test.ts::\"refuses downgrade when target release has incompatible state schema version\") | tested | ACC-UPG-07 to ACC-UPG-14 | **B** | REL-15 | SPEC-12 / PLAN-12 |\ndocs/v1.0.0/CONCURRENCY.md:46:| Test runs | Full suites run on a **snapshot copy** of the worktree (`git worktree add` at the commit under test, or `git archive`), never on the tree being edited. `tsx` reads `src/` live. |\ndocs/v1.0.0/CONCURRENCY.md:74:| `harness.sh`, `install.sh`, `scripts/package-linux.sh`, `.github/workflows/*` | 05, 06, 07, 09, C1 | Claim required. Workflow edits are separate commits. |\ndocs/v1.0.0/ACCEPTANCE.md:18:A gate passes only on archived evidence bound to the source commit or installed RC artifact that the gate evaluates. Source-level evidence names the exact source commit; installed-RC evidence names both that commit and the installed package digest. A green test suite alone never qualifies the product.\ndocs/v1.0.0/ACCEPTANCE.md:26:3. **RC artifact gates.** Before installed-RC product qualification, run every G0–G4 check whose acceptance method requires the RC archive, RC attestation/release, or workflow-produced artifact. This includes ACC-SUP-01/02/03/06/08. ACC-PKG checks that explicitly require an installed package run against this RC as specified by their test method. Record the RC tag commit, workflow run, artifact digests, and each check result. A source-level analogue does not replace an artifact-bound check.\ndocs/v1.0.0/ACCEPTANCE.md:48:| REQ-REL-114 | ACC-SUP-08 | Exact-RC cross-runner reproducibility |\ndocs/v1.0.0/ACCEPTANCE.md:79:| E1 | GitHub Actions: ubuntu-22.04 and ubuntu-24.04; Node 22 and 24; pinned Rust | Unit, integration and PTY suites; packaging; reproducibility |\ndocs/v1.0.0/ACCEPTANCE.md:87:Every ACC ID below is defined in the linked spec. The plan for each spec names the test that implements it. Run each check at the lifecycle stage dictated by its acceptance method in §1.1: source-applicable checks before the RC tag; checks requiring the RC archive, attestation, release, or installed package after RC construction; environment-specific checks in their declared environment. Bind every result to the exact source commit and, when artifact-dependent, the RC package digest. A source test or local build does not replace an artifact-bound check, and no G0–G4 ID is complete until all of its applicable checks pass.\ndocs/v1.0.0/ACCEPTANCE.md:114:| ACC-PRV-LIVE | `nexus providers verify --provider <p> -m <pinned model> -j` for each provider listed as supported (DEC-06) | `passed: true`. Receipts archived. |\ndocs/v1.0.0/ACCEPTANCE.md:115:| ACC-PRV-STANDALONE | §4.2 on the installed RC through the approved stripped proxy, with gateway credentials absent from the child environment | Every required profile completes through the proxy and the absent-gateway boundary holds; receipts archived. |\ndocs/v1.0.0/ACCEPTANCE.md:121:| ACC-TUI-MANUAL | §5.3 on the installed RC across five required terminal environments and three required sizes | Every cell passes; screenshots and per-cell verdicts are archived. |\ndocs/v1.0.0/ACCEPTANCE.md:136:5. Run `nexus doctor --json` and archive it. It must report the server kind and context source with no `gateway` capability.\ndocs/v1.0.0/ACCEPTANCE.md:283:| Backup restore | `nexus upgrade --restore-backup <state-backup-directory>` | Snapshot of configuration and complete durable state restored from a recognized private backup directory (`backup.json`, `state/`, optional `config/`), with strict 0600 file / 0700 directory modes. A canonical `config.env.bak.*` path restores configuration only. Arbitrary files and tar archives are rejected. Run it through the stable `nexus` launcher; close existing legacy clients, then keep version-pinned legacy binaries and direct old entry points offline until the durable restore journal is cleared. |\ndocs/v1.0.0/AUDIT.md:22:| Build entry points | `make build` (cargo release + `tsc`), `make test` (cargo test + `npm --prefix cli test` + `scripts/security_gates.sh`), `scripts/package-linux.sh`, `scripts/smoke-package.sh`, `scripts/installer-smoke.sh`. CI: `.github/workflows/ci.yml` (contest contract job + `linux-x86_64`), `release.yml` (tag-triggered). A dead `.gitlab-ci.yml` also exists. | SRC |\ndocs/v1.0.0/AUDIT.md:117:- **Task state.** `~/.nexus/tasks/<id>.json`, written as a full atomic rewrite on each progress event. The compaction archive is `<id>.history.jsonl` (append + fsync).\ndocs/v1.0.0/AUDIT.md:120:- **Recovery.** `recoverFromTaskState` restores messages and objective, and filters uncommitted archive entries. **Except:** `run --resume` discards the restored conversation (AGT-01), and work units skip the commit protocol (AGT-02).\ndocs/v1.0.0/AUDIT.md:148:| Experiments archives (routing, thermal, context-validation; 147) | 147 | READMEs + `sha256sum -c` | G | Raw data not re-analysed |\ndocs/v1.0.0/AUDIT.md:265:| REL-01 | S2 | B | Install → first run | `package-linux.sh:24-30`; `index.ts:747` | RT | The installed product lacks the TUI | REQ-REL-101 (SPEC-06) |\ndocs/v1.0.0/AUDIT.md:270:| REL-05 | S2 | B | Compliance | release archive | RT + SRC | No third-party notices | REQ-REL-107 (SPEC-07) |\ndocs/v1.0.0/AUDIT.md:342:| **Contest submission readiness** | **Closed as submitted** (owner, 2026-10-14; revision `ce7e58b9`). Reproducibility is limited to the operator host (CON-002, CON-005). The documented deploy targets the legacy Worker (CON-001). Hardening runs after judging (DEC-13). | G, SPEC-C1 |\ndocs/v1.0.0/AUDIT.md:374:- No cross-runner reproducibility check.\ndocs/v1.0.0/TERMINAL-MATRIX-WORKSHEET.md:11:- Installed package/archive name and location: ____________\ndocs/v1.0.0/TERMINAL-MATRIX-WORKSHEET.md:41:For each cell, archive a screenshot of the approval panel and a screenshot of the post-exit terminal state. Record a separate evidence/result reference where useful. Automated PTY runs and screenshots do not count as completion of these manual real-terminal cells.\ndocs/v1.0.0/TERMINAL-MATRIX-WORKSHEET.md:84:required screenshots and per-cell evidence are archived. Mark it FAIL if any\ndocs/v1.0.0/READINESS.md:5:**Authoritative source and source gates:** `origin/main` is `1f3c655971ade086f55347926db16cf2ecd52d1f`, merging PR #161's pinned Linux builder/reproducibility changes. Exact-main CI [39957281380](https://github.com/mikeholownych/nexus-code/actions/runs/39957281380) completed successfully: Node 22, Node 24, and Linux x86-64 jobs all passed, including the full CLI suite, security gates, requirements check, reproducible package builds, SBOM validation, package smoke, and installer smoke. Exact-main CodeQL [39957281390](https://github.com/mikeholownych/nexus-code/actions/runs/39957281390) also passed. On a clean detached checkout of this exact SHA with isolated HOME/XDG, `node scripts/check_requirements.mjs --enforce` passed: 123 rows (108 tested, 6 partial, 2 implemented, 7 open), with 12 explicit exact-RC qualification deferrals. `node scripts/sync-version.mjs --check` reports all components at `1.0.0-rc.3`. These are source-gate results; the CI package is validation output, not a new published RC.\ndocs/v1.0.0/READINESS.md:7:**Distribution scope:** The release owner confirmed the supported distribution target is the GitHub installer/archive only; npm publication is inapplicable. The current release workflow is the authority for published assets.\ndocs/v1.0.0/READINESS.md:9:**RC3, checkpoint choice, and Doctor:** RC3 remains the latest published prerelease, tagged at `1b9791f07d301c885fe48f04a796203583ab5a5c`; its archive digest and provenance are recorded in the snapshot below. The operator's `Sensitive content prevents durable persistence to checkpoint` failure occurred on immutable RC1, which predates the interactive choice flow. RC3 source contains the five choices: read-only, continue in the configured mode without a rollback checkpoint, create a checkpoint with the sensitivity risk acknowledged, cancel, or re-enter the instruction. Current RC3 source also scans saved-state metadata asynchronously in bounded batches, accepts schema-2 task `messageLog` records, and treats a configured model absent from `/models` as unverified rather than unavailable; a `--deep` inference probe can verify it. The interrupted-write temporary file reported by Doctor is a separate real warning and is not automatically repaired. These source checks and existing tests do not substitute for exercising the exact installed candidate on the operator's own state.\ndocs/v1.0.0/READINESS.md:11:**Qualification evidence and blockers:** The RC3 provider record `docs/reviews/evidence/v1-qualification/rc.3/providers/e5-provider-verification-20261023.json` was independently accepted: ChatGPT sign-in streaming/tool round trip passed; OpenRouter failed authentication and its live task remains outstanding. Public Issue #1 remains open; its latest visible update is coordinator-authored at 10:23 UTC, with no custodian response. The sealed legacy `hidden.command` corpus is not accepted by the current `blackbox-v1` runner; no held-out qualification has started and no private payload was accessed. T2/T3/T4, long-task and fault-injection qualification, exact-candidate cross-runner reproducibility, all 15 human terminal cells, and independent exact-RC acceptance remain incomplete.\ndocs/v1.0.0/READINESS.md:19:**Exact source gates:** `origin/main` and the signed `v1.0.0-rc.3` tag resolve to source commit `1b9791f07d301c885fe48f04a796203583ab5a5c`. Exact-main CI [39923089278](https://github.com/mikeholownych/nexus-code/actions/runs/39923089278) and CodeQL [39923089363](https://github.com/mikeholownych/nexus-code/actions/runs/39923089363) completed successfully on that commit. CI passed Node 22, Node 24, Linux CLI tests, security gates, requirements checks, two-build package reproducibility, SBOM validation, package smoke, and installer smoke. `node scripts/sync-version.mjs --check --tag v1.0.0-rc.3` and `node scripts/check_requirements.mjs --enforce` passed at the same source; the latter reports 123 rows (108 tested, 6 partial, 2 implemented, 7 open), with 12 explicit exact-RC qualification deferrals. This is source-gate evidence, not product acceptance.\ndocs/v1.0.0/READINESS.md:21:**RC3 artifact publication and provenance:** The annotated tag object is `dd68c222c57d0be0a4245a5b88092ff9df69201f`; its PGP signature verified good and it points to the source commit above. Release workflow [39927176480](https://github.com/mikeholownych/nexus-code/actions/runs/39927176480) completed successfully and published the [v1.0.0-rc.3 prerelease](https://github.com/mikeholownych/nexus-code/releases/tag/v1.0.0-rc.3). The workflow-produced Linux x86-64 archive is `nexus-linux-x86_64-v1.0.0-rc.3.tar.gz`, SHA-256 `efb446d2760f2e1aa7890e9d786b8a2ba8e4ebb784fbcac1e66afe827428864d`; `SHA256SUMS` is `9288edb4655a19caa40e1598c0a642ab7f7e93aafbb187c2bfc8cfa9e19f116f`; the CycloneDX SBOM is `3a3176b4b3890c1bc07fb7b3acd80f7372f043819e6a8b296346d014b07f9d3a`. Downloaded checksums and SBOM sidecars passed. GitHub attestations for the archive and `SHA256SUMS` verified against the Release workflow, run `39927176480`, tag `v1.0.0-rc.3`, and source `1b9791f`.\ndocs/v1.0.0/READINESS.md:23:**Installed-candidate and checkpoint-choice observation:** The published installer completed with `NEXUS_VERIFY_ATTESTATION=1` and installed RC3 under `/home/mike/.local/lib/nexus/v1.0.0-rc.3`; installer provenance records the exact archive digest and source revision. `/home/mike/.local/bin/nexus --version` reports `1.0.0-rc.3 (1b9791f07d30)`. The previous RC1 directory remains installed at `/home/mike/.local/lib/nexus/v1.0.0-rc.1` for rollback. The coordinator reported an automated PTY probe of the installed default TUI using a synthetic Git workspace, fake credential-shaped canary, and unreachable loopback endpoint. The reported probe displayed the five choices and selected cancel before inference. Its transcript/capture was not retained in the release evidence tree, so this observation is unarchived and was not independently verified in the readiness review. It is diagnostic context only: it does not establish the checkpoint-choice gate, the five-environment by three-size human terminal matrix, or provider/task qualification.\ndocs/v1.0.0/READINESS.md:25:**Held-out and remaining qualification:** Public Issue #1 has no custodian response after the metadata-only request at 2026-10-23 03:46:59Z. The sealed T2 manifest remains incompatible with the current evaluator's `blackbox-v1` contract because it uses legacy `hidden.command`; the independent custodian must convert or replace it, revalidate it, and accept a new immutable manifest. No hidden task or payload was accessed and no held-out run started. Provider/standalone qualification, T2/T3/T4 including long tasks and nine fault classes, exact-RC cross-runner reproducibility, the real-terminal matrix, and independent RC acceptance remain outstanding.\ndocs/v1.0.0/READINESS.md:33:**Source gates:** PR #159 (`a81f79df35a76207751ffd8a86640baafca98eeb`) merged as `1b9791f`. Its exact-head Node 22, Node 24, Linux package/reproducibility/install-smoke, and CodeQL checks passed; independent source review accepted the change. The focused Doctor schema-2 empty-history regression passed 1/1 with isolated HOME. At exact post-merge source `1b9791f`, `node scripts/sync-version.mjs --check` passes with all components at `1.0.0-rc.3`; `node scripts/check_requirements.mjs --enforce` passes with 123 rows (108 tested, 6 partial, 2 implemented, 7 open) and 12 explicit exact-RC qualification deferrals. Post-merge CI run [39923089278](https://github.com/mikeholownych/nexus-code/actions/runs/39923089278) and CodeQL run [39923089363](https://github.com/mikeholownych/nexus-code/actions/runs/39923089363) are running on the exact merge commit; do not claim post-merge CI complete until both terminate successfully.\ndocs/v1.0.0/READINESS.md:37:**Held-out and qualification gates:** Public Issue #1 has no custodian response after the metadata-only request at 2026-10-23 03:46:59Z. The sealed T2 manifest uses legacy `hidden.command` tasks, which the current evaluator rejects; the approved path requires custodian-led conversion or replacement, independent revalidation, and a new immutable manifest identity. No held-out task has been run. Private custody acceptance, current author/custodian ownership and exposure history, independent digest/setup/reference validation, effective access restrictions, and evaluator separation remain unverified. Installed-RC provider/standalone, T2/T3/T4, long-task and fault-injection qualification, cross-runner reproducibility, and exact-artifact acceptance have not run. The five-terminal by three-size manual matrix still requires genuine operator evidence; automated PTY tests do not satisfy it.\ndocs/v1.0.0/READINESS.md:43:**Authoritative release source:** `origin/main` is `1a484c38518688005e9434b18c889c77b408e145`, the PR #155 merge commit. PRs #153, #154, and #155 are merged. PR #153 integrated the checkpoint-choice flow; PR #154 refreshed readiness and the terminal worksheet; PR #155 fixed the remaining doctor integrity-scan timeout by batching metadata checks. PR #155 exact-head CI `39893335185`, CodeQL `39893335167`, and independent review passed on head `76b34f1d18d766b06011176a85679e7c3434ba30`. Current-main CI run [39896372677](https://github.com/mikeholownych/nexus-code/actions/runs/39896372677) completed successfully on exact `1a484c38518688005e9434b18c889c77b408e145`: Node 24 at 03:56:55Z, Node 22 at 03:57:48Z, and Linux x86-64 packaging/reproducibility/package-smoke/installer-smoke at 04:11:34Z. Its Linux job validated identical package archives, checksums, notices, SBOM and installer across two builds. Current-main CodeQL run [39896372726](https://github.com/mikeholownych/nexus-code/actions/runs/39896372726) completed successfully at 03:43:55Z on that same SHA. CI’s Linux package used existing `1.0.0-rc.2` version metadata; it is source CI evidence, not an immutable RC3 artifact or qualification.\ndocs/v1.0.0/READINESS.md:47:**Node runtime floor:** The accepted user decision is Node `>=22`. PR #150 integrates that floor in package engines, installer checks, CLI diagnostics and upgrade behavior, CI/release/reproducibility configuration, tests, and current release documentation. Superseded PRs #137 and #146 were closed after their intended policy changes were verified in current main; their older branch evidence is not current qualification evidence.\ndocs/v1.0.0/READINESS.md:55:**Qualification and release disposition:** Public Issue #1 remains open; the latest custodian metadata request has no response in the available checkpoint, so T2 qualification has not started and no held-out payload was accessed. Installed-RC E2, standalone/provider, T2/T3/T4, exact-RC reproducibility, human five-terminal by three-size acceptance ([terminal matrix worksheet](TERMINAL-MATRIX-WORKSHEET.md)), and independent exact-RC acceptance remain outstanding. Campaign status is `NEXUS_V1_CONVERGENCE_ACTIVE`; acceptance is `IN_PROGRESS`; publication authorization remains granted and gated. No RC is accepted and no stable v1.0.0 release is claimed.\ndocs/v1.0.0/READINESS.md:59:**Authoritative release source:** `origin/main` was `fa16045a6351ce61763bc3fcc93b562c50849285`, the merge of PR #152. PR #152 carried the readiness checkpoint refresh and terminal worksheet wording separating the §5.3 disposition gate from `ACC-TUI-MANUAL`; its exact head `deaf56fdb074df3f5cd3b62d50f811a2f14ca101` passed Node 22, Node 24, and Linux x86-64 package/repro/install-smoke CI in run `39881805268`; CodeQL `39881805274` passed. The independent reviewer accepted that exact head. Post-merge CI run `39885102002` passed Node 22, Node 24, and Linux x86-64 packaging/reproducibility/smoke/install; post-merge CodeQL `39885101945` passed. These checks are bound to exact main `fa16045`. Retained post-merge check summary: [CI and CodeQL result](../reviews/evidence/v1/plan10-readiness-post152/post-merge-ci-main-fa16045.txt).\ndocs/v1.0.0/READINESS.md:61:**Node runtime floor:** The accepted user decision is Node `>=22`. PR #150 integrates that floor in package engines, installer checks, CLI diagnostics and upgrade behavior, CI/release/reproducibility configuration, tests, and current release documentation. Superseded PRs #137 and #146 were closed after their intended policy changes were verified in current main; their older branch evidence is not current qualification evidence.\ndocs/v1.0.0/READINESS.md:69:**Qualification and release disposition:** Public Issue #1 remains open, with no custodian response to the latest metadata-only compatibility request posted at 22:08 UTC; T2 qualification has not started and no held-out payload was accessed. Installed-RC E2, standalone/provider, T3/T4, exact-RC reproducibility, human five-terminal by three-size acceptance ([terminal matrix worksheet](TERMINAL-MATRIX-WORKSHEET.md)), and independent exact-RC acceptance remain outstanding. Campaign status is `NEXUS_V1_CONVERGENCE_ACTIVE`; acceptance is `IN_PROGRESS`; publication authorization remains granted and gated. No RC is accepted and no stable v1.0.0 release is claimed.\ndocs/v1.0.0/READINESS.md:79:The public `v1.0.0-rc.1` release remains the only published v1 candidate. `v1.0.0-rc.2` points to older source and is nonqualifying under the Node 22 decision. There is no accepted RC or stable release. Held-out custody, provider/standalone qualification, T2/T3/T4, cross-runner reproducibility, installed-RC packaging and qualification, five-terminal by three-size human evidence, and independent acceptance remain incomplete. Campaign status is `NEXUS_V1_CONVERGENCE_ACTIVE`; acceptance remains `IN_PROGRESS`; publication authorization remains granted and gated.\ndocs/v1.0.0/READINESS.md:93:**RC and publication:** The published `v1.0.0-rc.1` tag resolves to `cb364c386c42faa53b67e04cacc81d7e01520779`, an ancestor of current `main`, and is not an artifact built from current source. Its published asset digest is `8d7dd32f3d00adb98d4f0ea2c6a484ea8e04fc547b4d78b21b060000eda22b9d`. The next candidate needs a new immutable identity, currently expected to be `v1.0.0-rc.2`, with synchronized version metadata and release notes. Exact-RC artifact/install checks, held-out T2, provider and standalone qualification, T3/T4, cross-runner reproducibility, the five-environment by three-size human terminal matrix, independent RC acceptance, and stable-promotion disposition remain outstanding. Publication authorization is granted but gated on those results. No stable `v1.0.0` tag or release exists.\ndocs/v1.0.0/READINESS.md:119:- **Qualification and release:** PR #102 contributes synthetic host-preflight evidence only. Private held-out custody/schema compatibility, T2/T3/T4 qualification, live provider and standalone checks, exact-RC reproducibility, the five-environment by three-size human terminal matrix, and independent RC acceptance remain outstanding. No RC has been constructed, installed, or accepted.\ndocs/v1.0.0/READINESS.md:140:- **Other qualification gates:** No installed-RC provider or standalone matrix, T2/T3/T4 scored qualification, exact-RC cross-runner reproducibility, or independent RC acceptance exists. `ACCEPTANCE.md` §5.3 and `scripts/terminal-acceptance/README.md` define the human five-environment × three-size matrix and evidence capture; all 15 real-terminal cells remain unrun because no RC is installed. Automated PTY results do not replace those operator results.\ndocs/v1.0.0/READINESS.md:155:- **Other qualification and release gates:** Provider/standalone, T3/T4, cross-runner reproducibility, qualification-host validation, and human five-environment × three-size terminal acceptance remain incomplete. Package version remains `0.1.0-alpha.2`; no RC artifact/tag, stable tag, npm publication, or GitHub release exists. Publication authorization remains granted but gated on accepted exact-RC evidence.\ndocs/v1.0.0/READINESS.md:166:- **Version, RC, and publication:** Package version remains `0.1.0-alpha.2`. PR #44's deterministic package checks are source CI evidence for that alpha package; they do not establish cross-runner RC reproducibility or installed-RC acceptance. No RC artifact, installed-RC provider/standalone, held-out, T3/T4, cross-runner, human-terminal, or independent acceptance evidence exists. The staged lifecycle in `ACCEPTANCE.md` remains authoritative. Publication authorization remains granted and gated; no RC tag, stable tag, npm publication, or GitHub release exists.\ndocs/v1.0.0/READINESS.md:173:- **Requirements enforcement:** `node scripts/check_requirements.mjs --enforce` was run from a clean archive of exact `519398495b7c3a2e5915ed76eee0bb731feb0bcf`; it exited 1 as required. The ledger has 121 rows (107 tested, 5 partial, 2 implemented, 7 open) and 11 below-threshold rows: `REQ-AGT-002`, `REQ-AGT-010`, `REQ-PRV-003`, `REQ-REL-005`, `REQ-AGT-110`, `REQ-PRV-111`, `REQ-REL-114`, `REQ-QUAL-101`, `REQ-QUAL-107`, `REQ-QUAL-108`, and `REQ-QUAL-109`. `REQ-AGT-118` is now `tested` with the DEC-17 accuracy exceptions preserved. `REQ-AGT-010` remains partial; its `CTX-001` blocking marker/mapping is under owner reconciliation against DEC-04. No requirement was promoted by this checkpoint.\ndocs/v1.0.0/READINESS.md:197:- **Supply-chain reproducibility and draft-then-publish release workflow (PRs [#20](https://github.com/mikeholownych/nexus-code/pull/20), [#21](https://github.com/mikeholownych/nexus-code/pull/21)):**\ndocs/v1.0.0/READINESS.md:256:| `REQ-AGT-004` | tested (depth 0; work-unit mechanism landed in PR-4b) | `AGT-02a` archive→task→session commit ordering is applied to durable work units by PR-4b (`agent.ts:3339-3402`, `operation_runner.ts:566`, `durable_continuity.test.ts:359`, `dispositions.md` M2); work-unit pressure-forced compaction + SIGKILL crash-boundary test is in flight under `PLAN-04 PR-4g`, and live long-task `ACC-CONT-10` remains pending RC qualification. | `PLAN-04 PR-4g` (`ACC-CONT-03` SIGKILL), `ACC-CONT-10` on installed RC | Continuity implementer, independent reviewer, and qualification operator | Land and independently review `PLAN-04 PR-4g` (M1/M3/L5), then execute `ACC-CONT-10` on the installed RC during M5. |\ndocs/v1.0.0/READINESS.md:259:| `REQ-PRV-003` | implemented | Standalone behavior has scripted tests but no qualifying live standalone evidence (HIST-08). | Installed RC; standalone matrix | Provider qualification operator | Run `ACCEPTANCE.md` §4 for supported server profiles and archive sanitized receipts. |\ndocs/v1.0.0/READINESS.md:260:| `REQ-REL-005` | partial (RR) | Candidate source security gates passed on `a7126aa` (run `39108774170`); exact-RC artifact/security evidence is pending RC tag construction. `security_gates.sh` requires `cargo-deny` or `cargo-audit` and fails closed when neither is installed (`ACC-SUP-04`). | Exact RC and `ACC-SUP-05` release CI matrix | Release engineering | On the frozen RC tag, run and archive the release workflow security evidence. |\ndocs/v1.0.0/READINESS.md:263:| `REQ-AGT-110` | open | Independent continuity/compaction/truncation acceptance under `ACCEPTANCE.md` §8, including an independent long task with two compactions and kill/resume. | Installed RC and reviewer who did not implement the work | Owner-supplied independent reviewer | After RC freeze, execute the reviewer procedure and archive a per-area verdict; this cannot be self-signed. |\ndocs/v1.0.0/READINESS.md:266:| `REQ-REL-114` | open (workflow enforced at `86bdbe6`; RC run pending) | `.github/workflows/repro.yml` and `scripts/repro-identity.mjs` (PR #20 `86bdbe6`) enforce fail-closed tag/commit/clean-tree/toolchain/artifact identity across Ubuntu 22.04 and 24.04 builders, covered by `repro_identity.test.ts`. Live execution on an actual RC tag remains pending RC construction. | Final RC tag and `.github/workflows/repro.yml` run | Release engineering | Dispatch `repro.yml` against the exact `v1.0.0-rc.1` tag/commit and archive both runner manifests and comparison evidence. |\ndocs/v1.0.0/READINESS.md:273:| `REQ-QUAL-106` | tested as harness/isolation controls (live M5 audit pending) | `blackbox-v1` oracle separation (`2c70d39`, PR #10), ancestor-only repository workspace staging (`96aeef2`, PR #18), and delegated cgroup v2 CPU/memory/pids/tmpfs-storage enforcement with `cgroup.kill` cleanup (`91406bd`, PR #19) are integrated, independently reviewed, and CI-tested (`1,152/1,152`). Live qualification-host provisioning and full-run inclusion/exclusion audit remain pending M5 execution. | Qualification-host provisioning (`nexus-eval` user, dedicated tmpfs mount, frozen `config.resources`), installed RC, completed M5 | Evaluator/host operator and independent reviewer | Provision the qualification host and freeze `config.resources`; run M5 with unreadable hidden tests and enforced cgroup/tmpfs bounds; archive every inclusion, exclusion, and replacement reason for independent review. |\ndocs/v1.0.0/READINESS.md:274:| `REQ-QUAL-108` | partial | Automated PTY suite passes on `a7126aa`; the human matrix is absent for xterm, kitty (keyboard protocol enabled), tmux 3.x inside GNOME Terminal, VS Code terminal and GNOME Terminal at 80×24, 40×14 and 200×60. | Human terminal access and RC install | Human acceptance operator | Execute the `ACCEPTANCE.md` §5.3 manual matrix on the installed RC across all required terminal×size cells and archive screenshots and verdicts. |\ndocs/v1.0.0/READINESS.md:285:| G2 package | `linux-x86_64` job in run `39108774170` passed double-build byte comparison, CycloneDX SBOM validation, `smoke-package.sh`, and `installer-smoke.sh`; `repro.yml` (`86bdbe6`) and draft-then-publish `release.yml` (`a7126aa`) are integrated. | Source/CI packaging green; Stage 2/3 workflow-built RC archive and cross-runner `repro.yml` dispatch pending RC tag. |\ndocs/v1.0.0/READINESS.md:295:5. **Stage 4 — Installed-RC qualification:** Install the workflow-produced `v1.0.0-rc.1` package via the documented installer and execute `ACCEPTANCE.md` §§4–8 (standalone/provider matrix, CI/scripted/manual terminal matrix, T2 40×5 held-out comparison, T4 9×5 fault matrix, T3 8×5 long-task matrix, install matrix, SPEC-09 §3.2 docs checklist, and §8 independent acceptance). Archive all evidence under `docs/reviews/evidence/v1-qualification/v1.0.0-rc.1/`.\ncli/test/node_floor.test.ts:83:test(\"CI, release and reproducibility workflows never run below the Node.js floor\", () => {\ndocs/v1.0.0/ROADMAP.md:31:| **M5 Qualification** | PLAN-10 task 11 (T2 held-out 5×, T3, T4, standalone stripped-proxy profiles, provider verify); task 12 (terminal matrix); ACC-SUP-08 cross-runner reproducibility; independent acceptance (X5) of continuity and of the RC | Qualification evidence archive, scorer verdict table, independent reports | **G5**: ACCEPTANCE §4–§8 all PASS | 10–20 calendar days. About 84 h of serial inference for T2, plus T3/T4/standalone. Excludes fix loops. |\ndocs/v1.0.0/evidence/F_requirements_history.md:50:| REQ-REL-06..09 | REL-001..004 | Lockfile provenance; SHA-256 + commit-bound release identity; SBOM hooks; patch obligations for supported public lines, EOL marking | P2 §23 | DEMONSTRATED (generate_sbom.sh; make verify-reproducibility) | P | Maturity review 10-12 P1: SBOM from direct deps only, not CycloneDX-validated; top-tier D4 no signing/provenance. Since 10-13: deterministic archive + CI reproducibility (87360e6, fa0959f), SHA256SUMS in releases. REL-004 now live obligation (repo PUBLIC, releases published) with no SECURITY.md process (D4) |\ndocs/v1.0.0/evidence/F_requirements_history.md:74:| REQ-AGT-53 | Compaction A–D | No default step/time ceiling; state-aware repetition; durable compaction commit (archive→task→session, fsync); queued `/compact`; provider-advertised capacity; labelled token counts | COMPACTION_AND_CONTINUITY.md; reviews/2026-10-13-compaction-continuity-acceptance.md | \"Met\"/\"Met (scripted)\"; 1 completed live run (run 3, REGRESSION_FREE); **\"Independent acceptance is pending\"** (ledger line 3) | **N** |\ndocs/v1.0.0/evidence/F_requirements_history.md:219:| REL-001 byte-identical builds | IR-05 | Deferred to future maturity | Partially addressed (87360e6 deterministic archive) |\ndocs/v1.0.0/evidence/C_tools_security_persistence.md:41:  - Compaction archive: `.history.jsonl` lines appended with fsync.\ndocs/v1.0.0/evidence/C_tools_security_persistence.md:116:- Session state: schema version with fail-closed on future versions, legacy migration, identity and workspace binding on load, redaction before persist, and a fsync'd append-only compaction archive with a commit protocol (state.ts:338-460; durable_file.ts). The trust store is written atomically with 0600/0700 (workspace_trust.ts:71-76).\ndocs/v1.0.0/specs/SPEC-05-standalone-local-inference.md:106:| ACC-INF-10 | ACCEPTANCE §4.2 passes: the live stripped-proxy profiles (plain, plus emulated llama.cpp/vLLM/Ollama shapes) on the standalone T2 and T4 subsets, and server-kind conformance fixtures in CI. Receipts are archived. |\ndocs/v1.0.0/evidence/B_providers.md:93:| G2 Live cloud qualification limited to openrouter + chatgpt (docs/reviews/NEXUS_CLOUD_PROVIDERS_LIVE_QUALIFICATION_2026-10-11.md, HISTORICAL). openai, anthropic, copilot, compatible: mock-only. | `nexus providers verify --provider {openai,anthropic,copilot,compatible} --model <m> -j` with operator keys; archive JSON. |\ndocs/v1.0.0/evidence/B_providers.md:106:| PRV-R5 | Standalone LM Studio, llama.cpp and vLLM complete a scripted tool-using task with no homelab config; context limit discovered or a context overflow yields compaction-and-retry or an actionable `--context-limit` message. | workflow/compat | BLOCKER (evidence) | G1 procedure, archived transcripts per server. |\ndocs/v1.0.0/evidence/B_providers.md:110:| PRV-R9 | Live `providers verify` PASS for each provider listed as supported in docs, or the doc lists it as mock-only/experimental. | compat/docs | RELEASE-REQUIRED | Archived verify JSON per provider. |\ndocs/v1.0.0/specs/SPEC-06-packaged-product-parity.md:16:**Two launchers.** The developer launcher is `harness.sh` (on this host, `/usr/local/bin/nexus`). With no arguments on a TTY it starts the Ratatui live TUI. The packaged launcher `bin/nexus` (`scripts/package-linux.sh:24-30`) is `node lib/cli/dist/index.js \"$@\"`. With no arguments it starts the readline REPL (`cli/src/index.ts:747-749`).\ndocs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md:34:   - Reuse canonical installation layout and verification: download release archive `nexus-linux-x86_64-$VERSION.tar.gz` and `SHA256SUMS`, verify SHA-256 integrity, verify package manifest and runtime binaries (`bin/nexus`, `lib/core/harness-core`, `lib/core/nexus-tui`, `VERSION`), and execute an atomic symlink swap (`ln -s ... .nexus-link.$$; mv -f .nexus-link.$$ $PREFIX/bin/nexus`).\ndocs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md:42:   - Restrict downloads to allowed origins and redirects; enforce 250MB download and 1GB extraction limits; inspect tar archives against path traversal, absolute paths, escaping symlinks, FIFOs/devices, and duplicate entries.\ndocs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md:94:  - Computes SHA-256 of downloaded archive; compares with published checksum.\ndocs/v1.0.0/evidence/A2_verification.md:20:| cli/src/core/findings.ts (414) | targeted: readArchive/readFindings/incompleteOutputNotice (239-414) |\ndocs/v1.0.0/plans/PLAN-05-standalone-local-inference.md:19:- `harness.sh`, `scripts/package-linux.sh` (CA export)\ndocs/v1.0.0/plans/PLAN-05-standalone-local-inference.md:37:| 12 | Custom CA: document `NODE_EXTRA_CA_CERTS` in config.env; the launcher (node entry re-exec, or `bin/nexus` sh) exports it before node starts; doctor validates that the file exists and parses. | `scripts/package-linux.sh:24-30` launcher; `harness.sh`; `doctor.ts` | PLAN-06 task 1 |\ndocs/v1.0.0/plans/PLAN-05-standalone-local-inference.md:71:The matrix in ACCEPTANCE §4.2, run through `eval/standalone/plain_proxy.mjs` (PLAN-10 task 13) in both profiles: plain, and emulated server shapes. Archive receipts, transcripts and `/status` output per profile under `docs/reviews/evidence/v1-qualification/<rc>/standalone/`.\ndocs/v1.0.0/plans/PLAN-05-standalone-local-inference.md:81:- ACC-INF-10 (stripped-proxy profiles plus conformance) is archived in M5.\ndocs/v1.0.0/specs/SPEC-10-v1-qualification-and-evaluation.md:82:7. **REQ-QUAL-107. Standalone and provider matrix.** The live standalone set (a T2 subset of ≥ 10 tasks plus a T4 subset) is run through the gateway-stripping proxy in its plain profile and its emulated-server profiles (DEC-16). `providers verify` is run live for each provider listed as supported (DEC-06). Receipts are archived.\ndocs/v1.0.0/specs/SPEC-10-v1-qualification-and-evaluation.md:83:8. **REQ-QUAL-108. Terminal matrix.** PTY scripted runs in CI (existing `tui_*_e2e`, plus the new ACC-SAFE and ACC-PROC scripts). A manual matrix covers {xterm, kitty, tmux, VS Code terminal, GNOME Terminal} × {80x24, 40x14, 200x60}, checking: approval safety, paste, resize, cancel, narrow hints and NO_COLOR. Screenshots are archived.\ndocs/v1.0.0/specs/SPEC-10-v1-qualification-and-evaluation.md:102:- All runs are archived under `docs/reviews/evidence/v1-qualification/<rc>/`, with the manifest, raw JSONL, the scorer output and SHA256SUMS.\ndocs/v1.0.0/plans/PLAN-12-cli-and-tui-upgrade.md:15:- `scripts/package-linux.sh` (deterministic packaging of compatibility metadata with reproducible timestamps)\ncli/test/eval_t3.test.ts:127:test(\"compactions count only ids a session or task record commits that have originals in its own archive\", async () => {\ncli/test/eval_t3.test.ts:141:    assert.equal(countCompactions(home), 2, \"c3 has no archived originals, c9 was never committed, c1 counts once, .cache is ignored\");\ncli/test/eval_t3.test.ts:181:test(\"T3 compaction counting rejects symlinks in HOME, .nexus categories, records and archives\", async () => {\ncli/test/tar_safety.test.ts:2: * Symlink targets in release archives must not escape the expected package root, whichever separator\ncli/test/tar_safety.test.ts:3: * the archive uses. `isSymlinkSafe` normalizes before checking, so a Windows-style `..\\..` cannot slip\ncli/test/tar_safety.test.ts:62:    const archive = path.join(root, \"release.tar.gz\");\ncli/test/tar_safety.test.ts:63:    const built = spawnSync(SYSTEM_TAR!, [\"-czf\", archive, \"-C\", root, \"nexus\"], { encoding: \"utf8\" });\ncli/test/tar_safety.test.ts:76:      await safeExtractTar(archive, destination, \"nexus\");\ncli/test/tar_safety.test.ts:78:      assert.ok(fs.existsSync(path.join(destination, \"nexus\", \"VERSION\")), \"the archive was still extracted\");\ncli/test/tar_safety.test.ts:95:    const archive = path.join(root, \"release.tar.gz\");\ncli/test/tar_safety.test.ts:96:    const built = spawnSync(SYSTEM_TAR!, [\"-czf\", archive, \"-C\", root, \"nexus\"], { encoding: \"utf8\" });\ncli/test/tar_safety.test.ts:109:      await safeExtractTar(archive, destination, \"nexus\");\ncli/test/tar_safety.test.ts:119:      assert.ok(fs.existsSync(path.join(destination, \"nexus\", \"VERSION\")), \"the archive was extracted without ambient options\");\ncli/test/tar_safety.test.ts:134:    const archive = path.join(root, \"release.tar.gz\");\ncli/test/tar_safety.test.ts:135:    const built = spawnSync(SYSTEM_TAR, [\"-czf\", archive, \"-C\", root, \"nexus\"], { encoding: \"utf8\" });\ncli/test/tar_safety.test.ts:148:      await safeExtractTar(archive, destination, \"nexus\");\ncli/test/tar_safety.test.ts:150:      assert.ok(fs.existsSync(path.join(destination, \"nexus\", \"VERSION\")), \"the archive was still extracted\");\ndocs/v1.0.0/plans/PLAN-10-v1-