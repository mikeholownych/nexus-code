est/authority.test.ts:397:        toolName: \"run_command\",\ncli/test/authority.test.ts:480:          toolName: \"run_command\",\ncli/test/authority.test.ts:514:          toolName: \"run_command\",\ncli/test/authority.test.ts:565:        toolName: \"run_command\",\ncli/test/authority.test.ts:583:        toolName: \"run_command\",\ncli/test/authority.test.ts:611:        toolName: \"run_command\",\ncli/test/authority.test.ts:629:        toolName: \"run_command\",\ncli/test/authority.test.ts:644:        toolName: \"run_command\",\ncli/test/objective_continuation.test.ts:718:      n === 1 ? write(\"change.txt\") : n === 2 ? done() : n === 3 ? { kind: \"tools\", calls: [{ name: \"run_command\", args: { command: `touch ${marker}` } }] } : n === 4 ? done() : text(\"ok\"),\ncli/test/approval_policy.test.ts:206:            { id: `exec-${trusted}`, type: \"function\", function: { name: \"run_command\", arguments: JSON.stringify({ command: `printf escaped > '${sentinel}'` }) } },\ncli/test/harness.test.ts:503:            { index: 0, id: \"ignored-shell\", type: \"function\", function: { name: \"run_command\", arguments: JSON.stringify({ command: \"mkdir -p generated && printf artifact > generated/result.bin\" }) } },\ncli/test/eval_t3.test.ts:308:    if (toolCalls === 0) return { kind: \"tools\", calls: [{ name: \"run_command\", args: { command: `ln -s '${canary}' leak.txt` } }] };\ncli/test/process_lifecycle.test.ts:49:      ? { kind: \"tools\", calls: [{ name: \"run_command\", args: { command: `(${marker} &); ${marker}`, timeout_secs: 120 } }] }\ncli/test/process_lifecycle.test.ts:77:      ? { kind: \"tools\", calls: [{ name: \"run_command\", args: { command: `${bg} & echo started`, timeout_secs: 60 } }] }\ncli/test/process_lifecycle.test.ts:79:        ? { kind: \"tools\", calls: [{ name: \"run_command\", args: { command: fg, timeout_secs: 60 } }] }\ncli/test/process_lifecycle.test.ts:106:      ? { kind: \"tools\", calls: [{ name: \"run_command\", args: { command: marker, t