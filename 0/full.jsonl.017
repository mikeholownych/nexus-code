{"timestamp":"2026-10-25T01:18:16.310Z","ordinal":317463,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17095-f2fe-7de0-b5cc-460661bc1fe3","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a17095-f2fe-7de0-b5cc-460661bc1fe3","response_id":"resp_060b64278a9dfb15016add58d7274481a0b132479b8a464585","usage":{"input_tokens":172448,"cached_input_tokens":171776,"cache_write_input_tokens":0,"output_tokens":82,"reasoning_output_tokens":12,"total_tokens":172530},"turn_token_usage":{"input_tokens":13365917,"cached_input_tokens":13101696,"cache_write_input_tokens":0,"output_tokens":57577,"reasoning_output_tokens":38255,"total_tokens":13423494},"thread_token_usage":{"input_tokens":5764421852,"cached_input_tokens":5702250880,"cache_write_input_tokens":0,"output_tokens":16344357,"reasoning_output_tokens":9394209,"total_tokens":5780766209}}}
{"timestamp":"2026-10-25T01:18:17.987Z","ordinal":317464,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17095-f2fe-7de0-b5cc-460661bc1fe3","item":{"type":"CommandExecution","id":"exec-a1c866b8-a565-4a68-9a80-127ee0040990","process_id":"7187","command":["/usr/bin/zsh","-lc","cat cli/src/core/approval_policy.ts;"],"cwd":"file:///home/mike/nexus-wt/sec101-119-pty-followup","parsed_cmd":[{"type":"read","cmd":"cat 'cli/src/core/approval_policy.ts;'","name":"approval_policy.ts","path":"cli/src/core/approval_policy.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * Approval Policy Framework\n * Nexus SPEC-01 §5.1, §5.2 — Safe Execution Defaults (DEC-01, as amended)\n */\nimport { EffectClass } from \"./capabilities.js\";\n\nexport type ApprovalMode = \"auto\" | \"review\" | \"read-only\";\n\nexport interface PolicyContext {\n  mode: ApprovalMode;\n  /** Workspace trust is reported separately; it never selects or widens tool authority. */\n  trusted: boolean;\n  sandbox?: boolean | string;\n  approvedEgressOrigins?: Set<string>;\n  egressOrigin?: string;\n  isUntrustedSource?: boolean;\n  fullAccess?: boolean;\n}\n\nexport class ApprovalPolicy {\n  /**\n   * Decides whether an operator decision is required before executing a capability with effect class `effect`.\n   * Permission mode controls tool approvals independently of workspace trust:\n   * - Review mode asks before writes, commands and egress.\n   * - Auto mode allows writes and commands; egress asks once per origin per session.\n   * - Untrusted context sources remain distinguishable from workspace trust.\n   * - --yes / fullAccess forces auto for write and exec.\n   */\n  public requiresDecision(effect: EffectClass, context: PolicyContext): boolean {\n    const { mode, approvedEgressOrigins, egressOrigin, isUntrustedSource, fullAccess } = context;\n\n    // Full access (--yes / operator force auto) bypasses confirmation prompts for write and exec\n    if (fullAccess) {\n      if (effect === \"egress\") {\n        if (egressOrigin && approvedEgressOrigins?.has(egressOrigin)) return false;\n        // In fullAccess / --yes mode, egress does not prompt if no interactive operator is present\n        return false;\n      }\n      return false;\n    }\n\n    // read_workspace, delegate, internal never require an operator decision\n    if (effect === \"read_workspace\" || effect === \"delegate\" || effect === \"internal\") {\n      return false;\n    }\n\n    if (mode === \"read-only\") {\n      // In read-only mode, mutating tools are denied directly by read-only policy rather than prompting the operator\n      return false;\n    }\n\n    if (mode === \"review\") {\n      if (effect === \"write_workspace\" || effect === \"exec\") {\n        return true;\n      }\n      if (effect === \"egress\") {\n        if (egressOrigin && approvedEgressOrigins?.has(egressOrigin)) {\n          return false;\n        }\n        return true;\n      }\n      if (effect === \"context_inject\") return Boolean(isUntrustedSource);\n      return false;\n    }\n\n    // mode === \"auto\"\n    if (mode === \"auto\") {\n      if (effect === \"write_workspace\") {\n        return false;\n      }\n      if (effect === \"exec\") {\n        return false;\n      }\n      if (effect === \"egress\") {\n        // Egress asks on the first call per origin per session, then allowed for that origin\n        if (egressOrigin && approvedEgressOrigins?.has(egressOrigin)) {\n          return false;\n        }\n        return true;\n      }\n      if (effect === \"context_inject\") {\n        return Boolean(isUntrustedSource);\n      }\n      return false;\n    }\n\n    return false;\n  }\n}\n\nexport const defaultApprovalPolicy = new ApprovalPolicy();\n","exit_code":0,"duration":{"secs":0,"nanos":704804479}},"started_at_ms":1792891097282,"completed_at_ms":1792891097987}}
{"timestamp":"2026-10-25T01:18:18.923Z","ordinal":317465,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a170a3-172a-7eb0-baed-788b584552cf","call_id":"call_3b7d1e703c8148ffb44b1ec3a6ea10e5","output":[{"type":"input_text","text":"Script completed\nWall time 2.7 seconds\nOutput:\n"},{"type":"input_text","text":"/**\n * Approval Policy Framework\n * Nexus SPEC-01 §5.1, §5.2 — Safe Execution Defaults (DEC-01, as amended)\n */\nimport { EffectClass } from \"./capabilities.js\";\n\nexport type ApprovalMode = \"auto\" | \"review\" | \"read-only\";\n\nexport interface PolicyContext {\n  mode: ApprovalMode;\n  /** Workspace trust is reported separately; it never selects or widens tool authority. */\n  trusted: boolean;\n  sandbox?: boolean | string;\n  approvedEgressOrigins?: Set<string>;\n  egressOrigin?: string;\n  isUntrustedSource?: boolean;\n  fullAccess?: boolean;\n}\n\nexport class ApprovalPolicy {\n  /**\n   * Decides whether an operator decision is required before executing a capability with effect class `effect`.\n   * Permission mode controls tool approvals independently of workspace trust:\n   * - Review mode asks before writes, commands and egress.\n   * - Auto mode allows writes and commands; egress asks once per origin per session.\n   * - Untrusted context sources remain distinguishable from workspace trust.\n   * - --yes / fullAccess forces auto for write and exec.\n   */\n  public requiresDecision(effect: EffectClass, context: PolicyContext): boolean {\n    const { mode, approvedEgressOrigins, egressOrigin, isUntrustedSource, fullAccess } = context;\n\n    // Full access (--yes / operator force auto) bypasses confirmation prompts for write and exec\n    if (fullAccess) {\n      if (effect === \"egress\") {\n        if (egressOrigin && approvedEgressOrigins?.has(egressOrigin)) return false;\n        // In fullAccess / --yes mode, egress does not prompt if no interactive operator is present\n        return false;\n      }\n      return false;\n    }\n\n    // read_workspace, delegate, internal never require an operator decision\n    if (effect === \"read_workspace\" || effect === \"delegate\" || effect === \"internal\") {\n      return false;\n    }\n\n    if (mode === \"read-only\") {\n      // In read-only mode, mutating tools are denied directly by read-only policy rather than prompting the operator\n      return false;\n    }\n\n    if (mode === \"review\") {\n      if (effect === \"write_workspace\" || effect === \"exec\") {\n        return true;\n      }\n      if (effect === \"egress\") {\n        if (egressOrigin && approvedEgressOrigins?.has(egressOrigin)) {\n          return false;\n        }\n        return true;\n      }\n      if (effect === \"context_inject\") return Boolean(isUntrustedSource);\n      return false;\n    }\n\n    // mode === \"auto\"\n    if (mode === \"auto\") {\n      if (effect === \"write_workspace\") {\n        return false;\n      }\n      if (effect === \"exec\") {\n        return false;\n      }\n      if (effect === \"egress\") {\n        // Egress asks on the first call per origin per session, then allowed for that origin\n        if (egressOrigin && approvedEgressOrigins?.has(egressOrigin)) {\n          return false;\n        }\n        return true;\n      }\n      if (effect === \"context_inject\") {\n        return Boolean(isUntrustedSource);\n      }\n      return false;\n    }\n\n    return false;\n  }\n}\n\nexport const defaultApprovalPolicy = new ApprovalPolicy();\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17095-f2fe-7de0-b5cc-460661bc1fe3","create_time":1792891098.922913}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
