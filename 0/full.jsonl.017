ity evidence artifact: repro-evidence.json\\n'\n83:-    assert.match(missingAssetResult.stderr, /does not cover the exact six published release assets/);\n84:+    assert.match(missingAssetResult.stderr, /does not cover the six selected reproducibility artifacts/);\n103:+    fs.writeFileSync(packageScript, \"#!/bin/sh\\nprintf package\\n\");\n145:+    assert.match(result.stderr, /NEXUS_PACKAGE_SOURCE must be the current Git worktree root/);\n167:   if (tagCommit !== commit) fail(`fetched tag ${version} resolves to ${tagCommit}, not checked-out source commit ${commit}`);\n169:   if (!/^[0-9a-f]{40}$/.test(workflowSha)) fail(\"reviewed main workflow commit is missing or invalid\");\n172:+  if (!/^[0-9a-f]{40}$/.test(packageToolCommit) || packageToolCommit !== workflowSha) fail(\"packaging tool commit must be the exact reviewed workflow commit\");\n173:+  if (!packageToolScript || !fs.existsSync(packageToolScript)) fail(\"packaging tool script identity is missing\");\n174:+  if (!fs.statSync(packageToolScript).isFile()) fail(\"packaging tool script identity must name a file\");\n176:+  if (reviewedPackageScript !== fs.readFileSync(packageToolScript, \"utf8\")) fail(\"packaging script does not match the reviewed tool commit\");\n179:   if (missingArtifacts.length) fail(`release output is missing required assets: ${missingArtifacts.join(\", \")}`);\n190:   if (buildImages.some((image) => image !== APPROVED_RUST_BUILD_IMAGE)) fail(\"every builder must use the approved digest-pinned Bookworm Rust build image\");\n191:   if (new Set(buildImages).size !== 1) fail(\"builders used different Rust build images\");\n194:+  if (packageToolCommits.some((value) => value !== workflowCommit) || packageToolHashes.some((value) => !/^[0-9a-f]{64}$/.test(value ?? \"\"))) fail(\"builders did not record the exact reviewed packaging tool commit and script hash\");\n195:+  if (new Set(packageToolHashes).size !== 1) fail(\"builders used different packaging tool scripts\");\n198:     if (id.workflow?.ref !== \"refs/heads/main\" || id.workflow?.sha !== workflowCommit) fail(`${id.runner.label} did not record the expected reviewed main workflow commit ${workflowCommit}`);\n200:   if (builders.some((id) => JSON.stringify(id.source) !== JSON.stringify(first.source))) fail(\"builders packaged different source or lockfiles\");\n201:   if (builders.some((id) => JSON.stringify(id.artifacts) !== JSON.stringify(first.artifacts))) fail(\"artifact digests differ between builders\");\n203:-  if (JSON.stringify(Object.keys(first.artifacts).sort()) !== JSON.stringify(expectedAssets)) fail(\"identity evidence does not cover the exact six published release assets\");\n204:+  if (JSON.stringify(Object.keys(first.artifacts).sort()) !== JSON.stringify(expectedAssets)) fail(\"identity evidence does not cover the six selected reproducibility artifacts\");\n210:   fail(\"mode must be record or compare\");\n-rw------- 1 mike mike 208168 Oct 24 23:46 /var/tmp/nexus-pr200-exact-make-test.IGD3UZ.log\n","exit_code":0,"duration":{"secs":0,"nanos":791104727}},"started_at_ms":1792885578299,"completed_at_ms":1792885579090}}
