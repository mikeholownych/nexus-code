(24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6522957Z ✖ ACC-SAFE-09/10: /test approval, trust independence, sandbox and cancellation (38808.727211ms)\n26793:test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6524193Z   AssertionError [ERR_ASSERTION]: verifier /test untrusted/review failed:\n26794-test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6525008Z   Traceback (most recent call last):\n26795-test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6526404Z     File \"/home/runner/work/nexus-code/nexus-code/cli/test/helpers/startup_permission_driver.py\", line 121, in <module>\n26796-test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6528349Z       main()\n26797-test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6529644Z     File \"/home/runner/work/nexus-code/nexus-code/cli/test/helpers/startup_permission_driver.py\", line 95, in main\n26798:test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6530975Z       session.wait_text(\"Testsuitepassed.\", timeout=30)\n26799-test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6532394Z     File \"/home/runner/work/nexus-code/nexus-code/cli/test/helpers/repl_approval_driver.py\", line 68, in wait_text\n26800:test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6534048Z       raise TimeoutError(f\"never saw {text!r}; clean text:\\n{self.clean_text()[-1000:]}\")\n26801:test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6535158Z   TimeoutError: never saw 'Testsuitepassed.'; clean text:\n26802-test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6545531Z   ─────────────────────────────────────────────────────────────────╯approval needed ·←→ thenenter (typing is ignored) · esc denies                                                ▸Approve pause,enter, then enter again approves → deny enter again approves this action · esc denies ·other keys cancel›/test                                                                                               ✓ approved verifier npm test                                                                                                                                                                                                                                                                                                  ⠼ waiting for theagent ·0:05 · esc cancels ────────────────────type to steer the running turn · esc cancels it⠴⠦ ●3 changed  model m  mode: review                         $ npm test  Test suite passed.enter send · shift+enter newline· ?help ───ask Nexu · /forcommads · ?for keys        \n26803-test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6550296Z   \n26804-test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6550598Z   \n26805-test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6550884Z   \n26806-test-matrix (24)\tRun npm --prefix cli test\t2026-10-25T02:11:46.6551202Z   1 !== 0\n                break\n            ready, _, _ = select.select([self.fd], [], [], left)\n            if not ready:\n                continue\n            try:\n                chunk = os.read(self.fd, 65536)\n            except OSError:\n                break\n            if not chunk:\n                break\n            got += chunk\n        if got:\n            self.raw += got\n            self.out += got.decode(\"utf-8\", \"replace\")\n        return got\n\n    def clean_text(self):\n        return CSI.sub(\"\", self.out)\n\n    def wait_text(self, text, timeout=25):\n        deadline = time.monotonic() + timeout\n        while text not in self.clean_text():\n            if time.monotonic() > deadline:\n                raise TimeoutError(f\"never saw {text!r}; clean text:\\n{self.clean_text()[-1000:]}\")\n            self.pump(0.05)\n\n    def send(self, data: bytes, settle=0.1):\n        os.write(self.fd, data)\n        if settle > 0:\n            self.pump(settle)\n\n    def close(self):\n        try:\n            # pty.fork makes the child a session/process-group leader. Stop the\n            # whole REPL tree so a sidecar cannot keep writing session state\n            # while the parent test removes its temporary HOME.\n            try:\n                os.killpg(self.pid, signal.SIGTERM)\n            except ProcessLookupError:\n                pass\n\n            if not self._wait_for_group_exit(10.0):\n                try:\n                    os.killpg(self.pid, signal.SIGKILL)\n                except ProcessLookupError:\n                    pass\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [STARTUP_DRIVER, planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (chunk) => (out += chunk));\n      child.stderr.on(\"data\", (chunk) => (err += chunk));\n      child.on(\"close\", (exitCode) => resolve({ code: exitCode, out, err }));\n    });\n    driverShutdownConfirmed = code === 0;\n    assert.equal(code, 0, `verifier /test ${trusted ? \"trusted\" : \"untrusted\"}/${mode}${cancel ? \"/cancel\" : \"\"} failed:\\n${err}\\n${out}`);\n    const result = JSON.parse(out.trim().split(\"\\n\").at(-1)!);\n    assert.equal(result.approvalPrompt, mode === \"review\");\n    if (cancel) {\n      assert.ok(result.cancelSeconds < 5, `Escape cancellation exceeded five seconds: ${result.cancelSeconds}`);\n      assert.ok(fs.existsSync(path.join(repo, \"started\")), \"the verifier started before cancellation\");\n      assert.ok(!fs.existsSync(path.join(repo, \"finished\")), \"the cancelled verifier did not complete normally\");\n      const startedCanary = fs.readFileSync(path.join(repo, \"started\"), \"utf8\");\n      assert.equal(startedCanary, canary, \"the fixture recorded its unique descendant-process canary\");\n      assert.equal(result.canaryVisibleBeforeCancel, true, \"the verifier descendant was visible from host /proc before cancellation\");\n      const remaining = await waitForCanaryProcesses(canary, false, 3_000);\n      assert.deepEqual(remaining, [], `cancelled verifier left descendant process(es) alive: ${remaining.join(\", \")}`);\n    } else {\n      assert.equal(fs.readFileSync(path.join(repo, \"sentinel.txt\"), \"utf8\"), \"ran\");\n      const mounts = fs.readFileSync(path.join(repo, \"mounts.txt\"), \"utf8\");\n      const hasWorkspaceMount = mounts.split(\"\\n\").some((line) => line.split(\" \")[4] === repo);\n      assert.ok(hasWorkspaceMount, \"the verifier observed its workspace bind mount in /proc/self/mountinfo\");\n    }\n    return result;\n  } finally {\n    await gw.close();\n    await terminateCanaryProcesses(canary);\n    if (driverShutdownConfirmed) {\n      fs.rmSync(repo, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n    }\n  }\n}\n\nfunction canaryProcesses(canary: string): number[] {\n  return fs.readdirSync(\"/proc\").filter((entry) => /^\\d+$/.test(entry)).flatMap((pid) => {\n    try {\n      const argv = fs.readFileSync(path.join(\"/proc\", pid, \"cmdline\"), \"utf8\").split(\"\\0\").filter(Boolean);\n      const processName = fs.readFileSync(path.join(\"/proc\", pid, \"comm\"), \"utf8\").trim();\n      return argv[0] === canary && argv[1] === \"30\" && processName === \"sleep\" ? [Number(pid)] : [];\n    } catch (error) {\n      const code = (error as NodeJS.ErrnoException).code;\n      if (code === \"ENOENT\" || code === \"ESRCH\") return [];\n      throw error;\n    }\n  });\n}\n\nasync function waitForCanaryProcesses(canary: string, expected: boolean, timeoutMs: number): Promise<number[]> {\n  const deadline = Date.now() + timeoutMs;\n  let pids: number[] = [];\n  do {\n    pids = canaryProcesses(canary);\n    if ((pids.length > 0) === expected) return pids;\n    await new Promise((resolve) => setTimeout(resolve, 50));\n  } while (Date.now() < deadline);\n  return pids;\n}\n\nasync function terminateCanaryProcesses(canary: string): Promise<void> {\n  let pids = canaryProcesses(canary);\n  for (const pid of pids) {\n    try { process.kill(pid, \"SIGTERM\"); } catch (error) {\n      if ((error as NodeJS.ErrnoException).code !== \"ESRCH\") throw error;\n    }\n  }\n  pids = await waitForCanaryProcesses(canary, false, 1_000);\n  for (const pid of pids) {\n    try { process.kill(pid, \"SIGKILL\"); } catch (error) {\n      if ((error as NodeJS.ErrnoException).code !== \"ESRCH\") throw error;\n    }\n  }\n  await waitForCanaryProcesses(canary, false, 1_000);\n}\n\nptyTest(\"ACC-SAFE-09/10: /test approval, trust independence, sandbox and cancellation\", { timeout: 360_000 }, async () => {\n  for (const trusted of [false, true]) {\n    for (const mode of [\"review\", \"auto\"] as const) {\n      await runVerifierSlashCase(trusted, mode);\n    }\n  }\n  await runVerifierSlashCase(true, \"review\", true);\n});\n","exit_code":0,"duration":{"secs":2,"nanos":63218624}},"started_at_ms":1792894354029,"completed_at_ms":1792894356093}}
