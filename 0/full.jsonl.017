777;\n    if (current !== expect.mode) throw new SafePathError(`${target} changed mode since the diagnosis (${expect.mode.toString(8)} -> ${current.toString(8)})`);\n    fs.fchmodSync(fd, mode);\n  } finally {\n    fs.closeSync(fd);\n  }\n}\n\n/**\n * Creates `target` and any missing parents below `root` with mode 0700, one component at a time, verifying each.\n * Returns the components it created.\n */\nexport function mkdirVerified(root: string, target: string): string[] {\n  const problem = ancestryProblem(root, target);\n  if (problem) throw new SafePathError(problem);\n  const created: string[] = [];\n  let current = path.resolve(root);\n  for (const part of relativeParts(root, target)) {\n    current = path.join(current, part);\n    try {\n      fs.mkdirSync(current, { mode: 0o700 });\n      created.push(current);\n    } catch (err: any) {\n      if (err?.code !== \"EEXIST\") throw err;\n    }\n    const fd = (() => {\n      try {\n        return openVerified(root, current, \"dir\");\n      } catch (err) {\n        // A directory we just made somewhere unexpected (a parent was swapped): remove it again where it really is.\n        for (const made of created.reverse()) {\n          try {\n            fs.rmdirSync(fs.realpathSync(made));\n          } catch {}\n        }\n        throw err;\n      }\n    })();\n    fs.closeSync(fd);\n  }\n  return created;\n}\n\n/**\n * Creates `file` exclusively (never through a link, never over an existing entry) with mode 0600, writes `content`,\n * and verifies where it was created. Returns its identity, for a verified removal later.\n */\nexport function writeExclusiveVerified(root: string, file: string, content: string): Identity {\n  const problem = ancestryProblem(root, file);\n  if (problem) throw new SafePathError(problem);\n  const fd = fs.openSync(file, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW, 0o600);\n  let stat: fs.Stats;\n  try {\n    try {\n      stat = verifyDescriptor(fd, root, file);\n    } catch (err) {\n      const actual = descriptorPath(fd);\n      if (actual) {\n        try {\n          fs.unlinkSync(actual);\n        } catch {}\n      }\n      throw err;\n    }\n    fs.writeSync(fd, content);\n  } finally {\n    fs.closeSync(fd);\n  }\n  return { dev: stat.dev, ino: stat.ino, mode: stat.mode & 0o777 };\n}\n\n/** Reads `file` only if it is a real, user-owned file at the expected place. */\nexport function readVerified(root: string, file: string): string {\n  const fd = openVerified(root, file, \"file\");\n  try {\n    return fs.readFileSync(fd, \"utf8\");\n  } finally {\n    fs.closeSync(fd);\n  }\n}\n\n/** Removes `file` only while it is still the object `expect` names (a lock or manifest this process created). */\nexport function unlinkVerified(root: string, file: string, expect: Pick<Identity, \"dev\" | \"ino\">): void {\n  const fd = openVerified(root, file, \"file\", expect);\n  fs.closeSync(fd);\n  fs.unlinkSync(file);\n}\nsed: can't read cli/test/git_exclude.test.ts: No such file or directory\ndocs/v1.0.0/REQUIREMENTS.md:68:| REQ-SEC-001 | RES-001..004; DEC-01 ADR | File tools are confined to the workspace (lexical, symlink, parent-symlink, `/proc/self/fd` recheck). | `file_ops.rs:59-87,731-791` | RT (C §4 R1) | tested | P | TOCTOU swap race is untested; macOS branch is a no-op | ACC-SEC-JAIL (+ race test, P) | K | — |\ndocs/v1.0.0/specs/SPEC-06-packaged-product-parity.md:85:| (new) | Add the `config.env` permission check and repair, reusing `safe_fs.chmodVerified`. |\ndocs/v1.0.0/AUDIT.md:138:| Tools, security, persistence: `tools, safe_fs, sandbox, security, session, session_export, checkpoint, flight, evidence, git, worktree, mcp, plugins, skills, browser, lsp, file_diff, syntax, diagnostics, workspace_trust`, `core/{authority, resources, durable_file, persistence_protection, capabilities, workspace_path, independent_check, tool_groups}` | 28 | Full read for security-critical files. Grep or skim for session_export, file_diff, syntax, diagnostics, resources, browser, lsp, mcp transports. | C_tools_security_persistence; this file (workspace_trust, workspace_path, tool_groups, independent_check, approval_review, read by lead) | MCP remote transports, browser.ts and lsp.ts got only a skim review: **qualification gap** |\ndocs/v1.0.0/evidence/E_distribution.md:132:- **Doctor is well built.** It runs with no config, no model and no session. It has a versioned JSON schema and distinct exit codes. Redaction held for env, flag, URL userinfo and query secrets. Repairs are narrow (3 kinds), confirmation-gated (non-TTY refuses without `--yes`), idempotent and backed up. They use verified chmod/mkdir helpers (safe_fs `chmodVerified` with identity expectation).\ndocs/v1.0.0/evidence/E_distribution.md:142:- **The `doctor --fix` symlink-swap race (TOCTOU) was not attacked.** Source shows an identity expectation (`expect: identityOf`), but it was not tested here. To qualify: replace the dir with a symlink between diagnose and confirm, and expect a refusal.\ndocs/v1.0.0/evidence/C_tools_security_persistence.md:9:| cli/src/safe_fs.ts, core/durable_file.ts, core/persistence_protection.ts, session.ts | full read |\ndocs/v1.0.0/evidence/C_tools_security_persistence.md:117:- `safe_fs.ts` (doctor --fix) is a careful O_NOFOLLOW + fd-verified mutation design.\ndocs/v1.0.0/evidence/C_tools_security_persistence.md:122:- **TOCTOU in `resolve_safe_path` -> rename** (file_ops.rs:156-182) under a concurrent symlink swap by a background process. Not raced. Procedure: run a loop swapping `ws/d` between a dir and a symlink to outside while calling write_file `d/f` 10k times. Assert that no file appears outside.\ndocs/v1.0.0/plans/PLAN-08-persistence-hygiene.md:27:| 3 | Doctor: a `state.permissions` check plus a repair (chmod 700 for dirs, 600 for files, with a backup manifest) that reuses `safe_fs`. One startup banner line when `~/.nexus` is more permissive than 0700. | `doctor.ts`; `sidecar.ts`/`repl.ts` banner | 2 |\ncli/test/doctor.test.ts:26:import { SafePathError, ancestryProblem, chmodVerified, identityOf, mkdirVerified, writeExclusiveVerified } from \"../src/safe_fs.js\";\ncli/test/doctor.test.ts:593:      assert.throws(() => writeExclusiveVerified(h, path.join(h, \"planted\"), \"x\"));\ncli/src/safe_fs.ts:181:export function writeExclusiveVerified(root: string, file: string, content: string): Identity {\ncli/src/doctor.ts:32:import { SafePathError, ancestryProblem, chmodVerified, identityOf, mkdirVerified, readVerified, unlinkVerified, writeExclusiveVerified, type Identity } from \"./safe_fs.js\";\ncli/src/doctor.ts:831:   * Makes the change under `home`, bound to the diagnosed object (see safe_fs.ts). Throws SafePathError when the\ncli/src/doctor.ts:923:        writeExclusiveVerified(home, manifest, JSON.stringify({ createdAt: new Date().toISOString(), restore: \"chmod <previousMode> <path>\", entries: backups }, null, 2));\ncli/src/doctor.ts:968:      return writeExclusiveVerified(home, lock, String(process.pid));\n cli/src/core/git_exclude.ts     | 281 ++++++++++++++++++++++++++++++++++------\n cli/src/safe_fs.ts              |  41 ++----\n cli/src/worktree.ts             |   9 +-\n cli/test/doctor.test.ts         |  93 +++++++++++++\n cli/test/flight_exclude.test.ts |  64 ++++++++-\n cli/test/git_exclude.test.ts    | 223 ++++++++++++++++++++++++++++++-\n 6 files changed, 638 insertions(+), 73 deletions(-)\ndiff --git a/cli/src/core/git_exclude.ts b/cli/src/core/git_exclude.ts\nindex 55975d6..ab514b3 100644\n--- a/cli/src/core/git_exclude.ts\n+++ b/cli/src/core/git_exclude.ts\n@@ -1,61 +1,264 @@\n import * as fs from \"node:fs\";\n import * as path from \"node:path\";\n import { execFileSync } from \"node:child_process\";\n+import { mkdirVerified, writeExclusiveVerified } from \"../safe_fs.js\";\n+\n+function openSelfIgnore(workspace: string, file: string, flags: number): number {\n+  const noFollow = fs.constants.O_NOFOLLOW;\n+  if (typeof noFollow !== \"number\") {\n+    throw new Error(\"Cannot safely access .nexus/.gitignore without O_NOFOLLOW support\");\n+  }\n+  const fd = fs.openSync(file, flags | noFollow | (fs.constants.O_NONBLOCK ?? 0));\n+  try {\n+    const stat = fs.fstatSync(fd);\n+    if (!stat.isFile() || stat.nlink > 1) {\n+      throw new Error(\"Refusing to access a non-file or hard-linked .nexus/.gitignore\");\n+    }\n+    const expected = path.join(fs.realpathSync(workspace), path.relative(path.resolve(workspace), path.resolve(file)));\n+    let descriptorPath: string | undefined;\n+    try {\n+      descriptorPath = fs.readlinkSync(`/proc/self/fd/${fd}`);\n+    } catch {\n+      // On platforms without /proc, verify the opened identity against the path.\n+    }\n+    if (descriptorPath !== undefined) {\n+      if (descriptorPath !== expected) {\n+        throw new Error(\".nexus/.gitignore changed location while it was being opened\");\n+      }\n+    } else {\n+      const named = fs.lstatSync(file);\n+      if (named.isSymbolicLink() || named.dev !== stat.dev || named.ino !== stat.ino || fs.realpathSync(file) !== expected) {\n+        throw new Error(\".nexus/.gitignore changed while it was being opened\");\n+      }\n+    }\n+    return fd;\n+  } catch (error) {\n+    fs.closeSync(fd);\n+    throw error;\n+  }\n+}\n+\n+function readSelfIgnore(workspace: string, file: string): string {\n+  const fd = openSelfIgnore(workspace, file, fs.constants.O_RDONLY);\n+  try {\n+    return fs.readFileSync(fd, \"utf-8\");\n+  } finally {\n+    fs.closeSync(fd);\n+  }\n+}\n+\n+function appendSelfIgnore(workspace: string, file: string, content: string): void {\n+  const fd = openSelfIgnore(workspace, file, fs.constants.O_WRONLY | fs.constants.O_APPEND);\n+  try {\n+    fs.writeSync(fd, content);\n+  } finally {\n+    fs.closeSync(fd);\n+  }\n+}\n+\n+function openExclude(file: string, expected: string): number {\n+  const noFollow = fs.constants.O_NOFOLLOW;\n+  if (typeof noFollow !== \"number\") {\n+    throw new Error(\"Cannot safely access Git info/exclude without O_NOFOLLOW support\");\n+  }\n+  const fd = fs.openSync(file, fs.constants.O_RDWR | fs.constants.O_APPEND | noFollow | (fs.constants.O_NONBLOCK ?? 0));\n+  try {\n+    const stat = fs.fstatSync(fd);\n+    if (!stat.isFile() || stat.nlink > 1) {\n+      throw new Error(\"Refusing to access a non-file or hard-linked Git info/exclude\");\n+    }\n+    let descriptorPath: string | undefined;\n+    try {\n+      descriptorPath = fs.readlinkSync(`/proc/self/fd/${fd}`);\n+    } catch {\n+      // On platforms without /proc, verify the opened identity against the path.\n+    }\n+    if (descriptorPath !== undefined) {\n+      if (descriptorPath !== expected) {\n+        throw new Error(\"Git info/exclude changed location while it was being opened\");\n+      }\n+    } else {\n+      const named = fs.lstatSync(file);\n+      if (named.isSymbolicLink() || named.dev !== stat.dev || named.ino !== stat.ino || fs.realpathSync(file) !== expected) {\n+        throw new Error(\"Git info/exclude changed while it was being opened\");\n+      }\n+    }\n+    return fd;\n+  } catch (error) {\n+    fs.closeSync(fd);\n+    throw error;\n+  }\n+}\n+\n+function readExclude(file: string, expected: string): string {\n+  const fd = openExclude(file, expected);\n+  try {\n+    return fs.readFileSync(fd, \"utf-8\");\n+  } finally {\n+    fs.closeSync(fd);\n+  }\n+}\n+\n+function appendExclude(file: string, expected: string, content: string): void {\n+  const fd = openExclude(file, expected);\n+  try {\n+    fs.writeSync(fd, content);\n+  } finally {\n+    fs.closeSync(fd);\n+  }\n+}\n \n /**\n- * Ensures .nexus/ is ignored by Git in the workspace by adding it to .git/info/exclude (REQ-PER-105).\n- * Called on first workspace write by FlightRecorder and WorktreeManager.\n+ * Ensures .nexus/ is ignored by Git in the workspace (REQ-PER-105).\n+ * The self-contained rule protects state even when Git metadata is read-only;\n+ * info/exclude remains a best-effort convenience for older clients and status output.\n  */\n export function ensureGitExclude(workspace: string): void {\n+  let excludePath: string | null = null;\n+  try {\n+    const out = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n+      cwd: workspace,\n+      encoding: \"utf-8\",\n+      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n+    }).trim();\n+    if (out) {\n+      excludePath = path.isAbsolute(out) ? out : path.resolve(workspace, out);\n+    }\n+  } catch {\n+    // Fall back only when an info/exclude file is already available without Git.\n+    const candidate = path.join(workspace, \".git\", \"info\", \"exclude\");\n+    if (fs.existsSync(path.dirname(candidate))) {\n+      excludePath = candidate;\n+    }\n+  }\n+\n+  if (!excludePath) return;\n+\n+  let commonDirPath: string | null = null;\n+  let expectedExcludePath: string | null = null;\n   try {\n-    let excludePath: string | null = null;\n+    const commonDir = execFileSync(\"git\", [\"rev-parse\", \"--git-common-dir\"], {\n+      cwd: workspace,\n+      encoding: \"utf-8\",\n+      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n+    }).trim();\n+    commonDirPath = fs.realpathSync(path.resolve(workspace, commonDir));\n+    expectedExcludePath = path.join(commonDirPath, \"info\", \"exclude\");\n+    if (path.resolve(excludePath) !== expectedExcludePath) expectedExcludePath = null;\n+  } catch {\n+    // Updating the convenience file is optional; self-ignore verification below is authoritative.\n+  }\n+\n+  const nexusDir = path.join(workspace, \".nexus\");\n+  mkdirVerified(workspace, nexusDir);\n+  const nexusGitIgnore = path.join(nexusDir, \".gitignore\");\n+  try {\n+    // Open the existing file without following links and bind the descriptor to\n+    // the expected repository path before reading it.\n+    readSelfIgnore(workspace, nexusGitIgnore);\n+  } catch (error) {\n+    if (typeof error === \"object\" && error !== null && \"cod