, predicate, timeout, what):\n35:function buildConfig(options: any): HarnessConfig {\n203:    if (options.model) parts.push(\"-m\", options.model);\n286:  .option(\"--approve\", \"Require human approval before destructive actions (edits, shell commands)\")\n288:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\n291:  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in vLLM)\")\n328:  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in vLLM)\")\n351:  .option(\"--approve\", \"Require human approval before destructive actions (edits, shell commands)\")\n353:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\n369:  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in LM Studio/vLLM)\")\n384:  .option(\"--approve\", \"Require human approval before destructive actions (forces review mode)\")\n385:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\n600:    .option(\"-m, --model <name>\", \"Model to check for\")\n1015:  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in LM Studio/vLLM)\")\n#!/usr/bin/env python3\n\"\"\"Drives the real `nexus-tui --live` binary (with the real sidecar) through edits whose diffs must render well:\nmixed additions and deletions, several hunks, a repeated edit, a failed edit, an addition, a deletion, a long path\nwith a long line and wide characters, a file without a final newline, a large change and terminal escapes in file\ncontent. It resizes while the edits arrive, steers while busy, opens the full-diff review with a draft in the\ncomposer, runs `/diff`, and repeats one edit at 256-colour, 16-colour and monochrome depth.\n\nIt keeps a colour-aware model of the screen (SGR colours and attributes, wide characters) so the node test can check\nalignment and colour, and it writes the screens it was asked to capture as JSON (rendered to PNG separately by\nrender_screens.py). The node test (tui_diff_e2e.test.ts) owns the mock gateway and checks the sidecar logs.\n\nUsage: tui_diff_driver.py PLAN.json\n\"\"\"\nimport json\nimport os\nimport re\nimport sys\nimport time\nimport unicodedata\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom tui_pty_driver import T0, Session, count_events, pty_env, wait_events  # noqa: E402\n\nDEFAULT = None\n\n\ndef char_width(ch):\n    if unicodedata.combining(ch) or unicodedata.category(ch) in (\"Mn\", \"Me\", \"Cf\"):\n        return 0\n    return 2 if unicodedata.east_asian_width(ch) in (\"W\", \"F\") else 1\n\n\nclass ColorScreen:\n    \"\"\"A terminal model that keeps each cell's character, colours and attributes: cursor positioning, erase, SGR.\"\"\"\n\n    TOKEN = re.compile(r\"\\x1b\\[([0-9;?<>=:]*)([ -/]*)([@-~])|\\x1b\\][^\\x07\\x1b]*(?:\\x07|\\x1b\\\\)|\\x1b[()][0-9A-Za-z]|\\x1b[=>78DEHM]|([\\r\\n\\b])|([^\\x1b\\r\\n\\b]+)\")\n\n    def __init__(self, cols, rows):\n        self.resize(cols, rows)\n\n    def blank(self):\n        return [\" \", DEFAULT, DEFAULT, 0]\n\n    def resize(self, cols, rows):\n        self.cols, self.rows = cols, rows\n        self.grid = [[self.blank() for _ in range(cols)] for _ in range(rows)]\n        self.row = self.col = 0\n        self.fg = self.bg = DEFAULT\n        self.attrs = 0  # bit 1 bold, 2 dim, 4 italic, 8 reverse\n\n    def sgr(self, params):\n        nums = [int(n) if n.isdigit() else 0 for n in params.replace(\":\", \";\").split(\";\")] if params else [0]\n        i = 0\n        while i < len(nums):\n            n = nums[i]\n            if n == 0:\n                self.fg = self.bg = DEFAULT\n                self.attrs = 0\n            elif n == 1:\n                self.attrs |= 1\n            elif n == 2:\n                self.attrs |= 2\n            elif n == 3:\n                self.attrs |= 4\n            elif n == 7:\n                self.attrs |= 8\n            elif n == 22:\n                self.attrs &= ~3\n            elif n == 23:\n                self.attrs &= ~4\n            elif n == 27:\n                self.attrs &= ~8\n            elif 30 <= n <= 37 or 90 <= n <= 97:\n                self.fg = [\"ansi\", n - 30 if n < 90 else n - 90 + 8]\n            elif 40 <= n <= 47 or 100 <= n <= 107:\n                self.bg = [\"ansi\", n - 40 if n < 100 else n - 100 + 8]\n            elif n == 39:\n                self.fg = DEFAULT\n            elif n == 49:\n                self.bg = DEFAULT\n            elif n in (38, 48) and i + 1 < len(nums):\n                if nums[i + 1] == 5 and i + 2 < len(nums):\n                    value = [\"idx\", nums[i + 2]]\n                    i += 2\n                elif nums[i + 1] == 2 and i + 4 < len(nums):\n                    value = [\"rgb\", nums[i + 2], nums[i + 3], nums[i + 4]]\n                    i += 4\n                else:\n                    value = DEFAULT\n                if n == 38:\n                    self.fg = value\n                else:\n                    self.bg = value\n            i += 1\n\n    def put(self, ch):\n        width = char_width(ch)\n        if width == 0:\n            if self.col > 0:\n                self.grid[self.row][self.col - 1][0] += ch\n            return\n        if self.col + width > self.cols:\n            return\n        self.grid[self.row][self.col] = [ch, self.fg, self.bg, self.attrs]\n        if width == 2 and self.col + 1 < self.cols:\n            self.grid[self.row][self.col + 1] = [\"\", self.fg, self.bg, self.attrs]\n        self.col += width\n\n    def feed(self, text):\n        for m in self.TOKEN.finditer(text):\n            params, _, final, ctl, chars = m.group(1), m.group(2), m.group(3), m.group(4), m.group(5)\n            if final:\n                if final == \"m\":\n                    self.sgr(params)\n                    continue\n                nums = [int(n) if n.isdigit() else 0 for n in params.lstrip(\"?\").split(\";\")] if params else []\n                if final in \"Hf\":\n                    self.row = max(0, min(self.rows - 1, (nums[0] if nums and nums[0] else 1) - 1))\n                    self.col = max(0, min(self.cols - 1, (nums[1] if len(nums) > 1 and nums[1] else 1) - 1))\n                elif final == \"J\" and (not nums or nums[0] in (2, 3)):\n                    self.grid = [[self.blank() for _ in range(self.cols)] for _ in range(self.rows)]\n                elif final == \"K\":\n                    mode = nums[0] if nums else 0\n                    span = range(self.col, self.cols) if mode == 0 else range(0, self.col + 1) if mode == 1 else range(self.cols)\n                    for c in span:\n                        self.grid[self.row][c] = [\" \", DEFAULT, self.bg, 0]\n                elif final == \"C\":\n                    self.col = min(self.cols - 1, self.col + (nums[0] if nums and nums[0] else 1))\n                elif final == \"D\":\n                    self.col = max(0, self.col - (nums[0] if nums and nums[0] else 1))\n                elif final == \"G\":\n                    self.col = max(0, min(self.cols - 1, (nums[0] if nums and nums[0] else 1) - 1))\n            elif ctl == \"\\r\":\n                self.col = 0\n            elif ctl == \"\\n\":\n                self.row = min(self.rows - 1, self.row + 1)\n            elif ctl == \"\\b\":\n                self.col = max(0, self.col - 1)\n            elif chars:\n                for ch in chars:\n  tokenizeRequests: any[];\n  /** Number of GET /models requests served. */\n  modelRequests: number;\n  /** Authorization headers seen, per path kind. */\n  authSeen: Array<{ path: string; authorization?: string }>;\n  close(): Promise<void>;\n}\n\n/** Optional gateway capabilities (homelab-ai contract shape): catalog entries, request counting, admission headers. */\nexport interface GatewayOptions {\n  /** `data` entries for GET /models (default: [{ id: \"m\" }]). Called per request, so tests can change capacity. */\n  models?: () => any[];\n  /** Answer to POST /tokenize; absent: 404. */\n  tokenize?: (body: any, n: number) => { status: number; body: unknown; delayMs?: number };\n  /** Response headers for the n-th chat request (e.g. X-AIHost-* admission headers). */\n  headers?: (n: number, body: any) => Record<string, string>;\n}\n\nfunction sse(obj: unknown): string {\n  return `data: ${JSON.stringify(obj)}\\n\\n`;\n}\n\n/** A tool call's arguments as sent: whole, or cut off partway like a reply that hit the output limit. */\nfunction wireArguments(args: unknown, truncated?: boolean): string {\n  const json = JSON.stringify(args);\n  return truncated ? json.slice(0, Math.max(1, Math.floor(json.length / 2))) : json;\n}\n\nfunction finishReason(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  return r.truncated ? \"length\" : r.kind === \"tools\" ? \"tool_calls\" : \"stop\";\n}\n\nfunction streamBody(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  let out = \"\";\n  if (r.kind === \"text\") out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n  else {\n    if (r.content) out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n    r.calls.forEach((c, i) => {\n      out += sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: i, id: c.id ?? `call_${i}_${Math.random().toString(36).slice(2, 7)}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } }] } }] });\n    });\n  }\n  out += sse({ choices: [{ index: 0, delta: {}, finish_reason: finishReason(r) }] });\n  return out + \"data: [DONE]\\n\\n\";\n}\n\n/** Deterministic OpenAI-compatible gateway. `script(n, body)` decides the reply to the n-th chat request (1-based). */\nexport async function startGateway(script: (n: number, body?: any) => Reply, options: GatewayOptions = {}): Promise<Gateway> {\n  const requests: unknown[] = [];\n  const tokenizeRequests: any[] = [];\n  const authSeen: Array<{ path: string; authorization?: string }> = [];\n  let modelRequests = 0;\n  const sockets = new Set<Socket>();\n  const server = http.createServer((req, res) => {\n    authSeen.push({ path: req.url ?? \"\", authorization: req.headers.authorization });\n    if (req.url?.endsWith(\"/models\")) {\n      modelRequests++;\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ data: options.models ? options.models() : [{ id: \"m\" }] }));\n      return;\n    }\n    if (req.url?.endsWith(\"/tokenize\")) {\n      let raw = \"\";\n      req.on(\"data\", (c) => (raw += c));\n      req.on(\"end\", () => {\n        let body: any = {};\n        try { body = JSON.parse(raw); } catch {}\n        tokenizeRequests.push(body);\n        if (!options.tokenize) {\n          res.statusCode = 404;\n          res.end(JSON.stringify({ status: \"not_found\", message: \"no tokenize\" }));\n          return;\n        }\n        const answer = options.tokenize(body, tokenizeRequests.length);\n        const send = () => {\n          if (res.writableEnded || res.destroyed) return;\n          res.statusCode = answer.status;\n          res.setHeader(\"content-type\", \"application/json\");\n          res.end(typeof answer.body === \"string\" ? answer.body : JSON.stringify(answer.body));\n        };\n        if (answer.delayMs) setTimeout(send, answer.delayMs); else send();\n      });\ncli/test/approval_policy.test.ts:191:  test(\"REQ-SEC-101: the unset mode stays review in trusted and untrusted workspaces\", async () => {\ncli/test/verifier_gating.test.ts:2: * SPEC-01 §3 rule 8 & ACC-SAFE-09: Verifier executions that Nexus initiates itself\ncli/test/verifier_gating.test.ts:45:describe(\"ACC-SAFE-09: Verifier Gating\", () => {\ncli/test/check_requirements.test.ts:36:  const requirementId = options.requirementId ?? \"REQ-SEC-101\";\ncli/test/check_requirement