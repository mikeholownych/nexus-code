        run: |\n+          git fetch origin main --no-tags\n+          git merge-base --is-ancestor \"$NEXUS_PACKAGE_TOOL_COMMIT\" origin/main\n+          package_tool=\"$RUNNER_TEMP/package-linux.sh\"\n+          git show \"$NEXUS_PACKAGE_TOOL_COMMIT:scripts/package-linux.sh\" > \"$package_tool\"\n+          NEXUS_PACKAGE_SOURCE=\"$GITHUB_WORKSPACE\" bash \"$package_tool\" \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\"\n       - name: Record source, toolchain, and published-asset identity\n+        env:\n+          NEXUS_PACKAGE_TOOL_COMMIT: ${{ needs.resolve-tag.outputs.workflow_sha }}\n+          NEXUS_PACKAGE_TOOL_SCRIPT: ${{ runner.temp }}/package-linux.sh\n         run: |\n-          node scripts/repro-identity.mjs record \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\" \\\n+          git show \"$EXPECTED_WORKFLOW_SHA:scripts/repro-identity.mjs\" > \"$RUNNER_TEMP/repro-identity.mjs\"\n+          node \"$RUNNER_TEMP/repro-identity.mjs\" record \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\" \\\n             \"$RUNNER_TEMP/dist/repro-identity.json\" \"${{ matrix.runner }}\"\n       - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n         with:\ndiff --git a/cli/test/repro_identity.test.ts b/cli/test/repro_identity.test.ts\nindex ceb720e..618b404 100644\n--- a/cli/test/repro_identity.test.ts\n+++ b/cli/test/repro_identity.test.ts\n@@ -5,6 +5,7 @@\n  */\n import { test } from \"node:test\";\n import assert from \"node:assert/strict\";\n+import { createHash } from \"node:crypto\";\n import fs from \"node:fs\";\n import os from \"node:os\";\n import path from \"node:path\";\n@@ -26,11 +27,12 @@ test(\"npm registry scoped package names escape every path separator\", async () =\n   assert.equal(registryPackageName(\"@scope/nested/package\"), \"@scope%2fnested%2fpackage\");\n });\n \n-function identity(label: string, overrides: { commit?: string; lock?: string; archive?: string; workflowRef?: string; workflowSha?: string; image?: string | null; rustImage?: string | null; missingAsset?: boolean } = {}) {\n+function identity(label: string, overrides: { commit?: string; lock?: string; archive?: string; workflowRef?: string; workflowSha?: string; packageToolCommit?: string; packageToolSha?: string; image?: string | null; rustImage?: string | null; missingAsset?: boolean } = {}) {\n   return {\n     source: { version: \"v1.0.0-rc.1\", commit: overrides.commit ?? COMMIT, tree: \"b\".repeat(40), tagObject: \"c\".repeat(40), lockfiles: { \"cli/package-lock.json\": \"1\", \"core/Cargo.lock\": overrides.lock ?? \"2\", \"rust-toolchain.toml\": \"3\", \"scripts/release-tools/package-lock.json\": \"4\" } },\n     toolchain: { node: \"v22\", npm: \"10\", rustc: \"rustc 1.95.0\", cargo: \"cargo 1.95.0\" },\n     buildEnvironment: { rustContainerImage: overrides.rustImage === undefined ? APPROVED_RUST_IMAGE : overrides.rustImage },\n+    packagingTool: { commit: overrides.packageToolCommit ?? WORKFLOW_COMMIT, packageScriptSha256: overrides.packageToolSha ?? \"a\".repeat(64) },\n     runner: { label, image: overrides.image === undefined ? label.replace(\"-\", \"\").replace(\".04\", \"\") : overrides.image, imageVersion: \"20261012.1\" },\n     workflow: { ref: overrides.workflowRef ?? \"refs/heads/main\", sha: overrides.workflowSha ?? \"f\".repeat(40), runId: \"42\", runAttempt: \"1\" },\n     artifacts: {\n@@ -57,6 +59,7 @@ test(\"repro compare accepts only identical source, lockfiles and artifacts from\n     assert.equal(evidence.result, \"PASS\");\n     assert.equal(evidence.source.commit, COMMIT);\n     assert.equal(evidence.buildEnvironment.rustContainerImage, APPROVED_RUST_IMAGE);\n+    assert.equal(evidence.packagingTool.commit, WORKFLOW_COMMIT);\n     assert.deepEqual(evidence.builders.map((builder: any) => builder.runner.label), [\"ubuntu-22.04\", \"ubuntu-24.04\"]);\n \n     const missingA = write(\"missing-a.json\", identity(\"ubuntu-22.04\", { missingAsset: true }));\n@@ -76,6 +79,8 @@ test(\"repro compare accepts only identical source, lockfiles and artifacts from\n       [\"unpinned Rust build image\", write(\"ru.json\", identity(\"ubuntu-24.04\", { rustImage: \"rust:1.95.0-bookworm\" })), /approved digest-pinned Bookworm Rust build image/],\n       [\"EOL Bullseye build image\", write(\"bullseye.json\", identity(\"ubuntu-24.04\", { rustImage: \"rust:1.95.0-bullseye@sha256:\" + \"3\".repeat(64) })), /approved digest-pinned Bookworm Rust build image/],\n       [\"different Bookworm build digest\", write(\"rd.json\", identity(\"ubuntu-24.04\", { rustImage: \"rust:1.95.0-bookworm@sha256:\" + \"2\".repeat(64) })), /approved digest-pinned Bookworm Rust build image/],\n+      [\"different package tool commit\", write(\"ptc.json\", identity(\"ubuntu-24.04\", { packageToolCommit: \"e\".repeat(40) })), /exact reviewed packaging tool commit and script hash/],\n+      [\"different package tool script\", write(\"pts.json\", identity(\"ubuntu-24.04\", { packageToolSha: \"b\".repeat(64) })), /different packaging tool scripts/],\n       [\"workflow from a branch\", write(\"w.json\", identity(\"ubuntu-24.04\", { workflowRef: \"refs/heads/patched\" })), /expected reviewed main workflow commit/],\n       [\"workflow identity drift\", write(\"ws.json\", identity(\"ubuntu-24.04\", { workflowSha: \"e\".repeat(40) })), /expected reviewed main workflow commit/],\n     ];\n@@ -115,6 +120,9 @@ test(\"repro record binds the checked-out commit to the fetched tag's peeled comm\n       fs.writeFileSync(path.join(dir, file), \"fixture\\n\");\n     }\n     fs.writeFileSync(path.join(dir, \"source.txt\"), \"source\\n\");\n+    const packageScript = path.join(dir, \"scripts\", \"package-linux.sh\");\n+    fs.mkdirSync(path.dirname(packageScript));\n+    fs.writeFileSync(packageScript, \"#!/bin/sh\\nprintf package\\n\");\n     git(\"add\", \".\");\n     git(\"commit\", \"--quiet\", \"-m\", \"source fixture\");\n     const sourceCommit = git(\"rev-parse\", \"HEAD\");\n@@ -128,7 +136,9 @@ test(\"repro record binds the checked-out commit to the fetched tag's peeled comm\n       ...process.env,\n       PATH: `${path.join(dir, \"bin\")}:${process.env.PATH ?? \"\"}`,\n       GITHUB_REF: \"refs/heads/main\",\n-      GITHUB_WORKFLOW_SHA: WORKFLOW_COMMIT,\n+      GITHUB_WORKFLOW_SHA: sourceCommit,\n+      NEXUS_PACKAGE_TOOL_COMMIT: sourceCommit,\n+      NEXUS_PACKAGE_TOOL_SCRIPT: packageScript,\n       GITHUB_RUN_ID: \"42\",\n       GITHUB_RUN_ATTEMPT: \"1\",\n       NEXUS_BUILD_CONTAINER_IMAGE: APPROVED_RUST_IMAGE,\n@@ -140,7 +150,9 @@ test(\"repro record binds the checked-out commit to the fetched tag's peeled comm\n     const identityRecord = JSON.parse(fs.readFileSync(out, \"utf8\"));\n     assert.equal(identityRecord.source.commit, sourceCommit);\n     assert.equal(identityRecord.source.tagCommit, sourceCommit);\n-    assert.equal(identityRecord.workflow.sha, WORKFLOW_COMMIT);\n+    assert.equal(identityRecord.workflow.sha, sourceCommit);\n+    assert.equal(identityRecord.packagingTool.commit, sourceCommit);\n+    assert.equal(identityRecord.packagingTool.packageScriptSha256, createHash(\"sha256\").update(fs.readFileSync(packageScript)).digest(\"hex\"));\n \n     git(\"commit\", \"--quiet\", \"--allow-empty\", \"-m\", \"different tag target\");\n     const movedTagCommit = git(\"rev-parse\", \"HEAD\");\n@@ -171,6 +183,25 @@ test(\"Linux packaging rejects an omitted pinned builder unless host builds are e\n   }\n });\n \n+test(\"external package source override is restricted to the current Git worktree\", () => {\n+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"package-source-root-\"));\n+  const out = path.join(dir, \"dist\");\n+  try {\n+    const initialized = spawnSync(\"git\", [\"init\", \"--quiet\", dir], { encoding: \"utf8\" });\n+    assert.equal(initialized.status, 0, initialized.stderr);\n+    const result = spawnSync(\"bash\", [PACKAGE_SCRIPT, \"v1.0.0\", out], {\n+      cwd: ROOT,\n+      encoding: \"utf8\",\n+      env: { ...process.env, NEXUS_PACKAGE_SOURCE: dir, NEXUS_BUILD_CONTAINER_IMAGE: \"\" },\n+    });\n+    assert.equal(result.status, 2, result.stderr);\n+    assert.match(result.stderr, /NEXUS_PACKAGE_SOURCE must be the current Git worktree root/);\n+    assert.equal(fs.existsSync(out), false, \"reject before writing package output\");\n+  } finally {\n+    fs.rmSync(dir, { recursive: true, force: true });\n+  }\n+});\n+\n test(\"Makefile reproducibility gate uses the approved builder for both package builds\", () => {\n   const makefile = fs.readFileSync(MAKEFILE, \"utf8\");\n   assert.ok(makefile.includes(`APPROVED_RUST_BUILD_IMAGE := ${APPROVED_RUST_IMAGE}`));\ndiff --git a/scripts/package-linux.sh b/scripts/package-linux.sh\nindex 31555c9..5f41037 100644\n--- a/scripts/package-linux.sh\n+++ b/scripts/package-linux.sh\n@@ -1,7 +1,18 @@\n #!/usr/bin/env bash\n set -euo pipefail\n \n-ROOT=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\n+# An externally selected package tool may target a separate immutable RC checkout, but it must\n+# still run from that checkout so version, source and lockfile identity stay bound together.\n+ROOT=${NEXUS_PACKAGE_SOURCE:-$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)}\n+ROOT=$(cd \"$ROOT\" && pwd -P)\n+if [[ -n \"${NEXUS_PACKAGE_SOURCE:-}\" ]]; then\n+  CALLER_ROOT=$(git rev-parse --show-toplevel)\n+  SOURCE_ROOT=$(git -C \"$ROOT\" rev-parse --show-toplevel)\n+  if [[ \"$ROOT\" != \"$CALLER_ROOT\" || \"$ROOT\" != \"$SOURCE_ROOT\" ]]; then\n+    echo \"NEXUS_PACKAGE_SOURCE must be the current Git worktree root\" >&2\n+    exit 2\n+  fi\n+fi\n VERSION=${1:?usage: package-linux.sh VERSION OUTPUT_DIR}\n OUT=${2:?usage: package-linux.sh VERSION OUTPUT_DIR}\n APPROVED_RUST_BUILD_IMAGE='rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb'\ndiff --git a/scripts/repro-identity.mjs b/scripts/repro-identity.mjs\nindex 3d9ce51..6e1a976 100644\n--- a/scripts/repro-identity.mjs\n+++ b/scripts/repro-identity.mjs\n@@ -1,5 +1,5 @@\n // Source identity for the cross-runner reproducibility workflow (ACC-SUP-08, REQ-REL-114).\n-//   record  <version> <dist-dir> <out.json> <runner-label>   identity of the checked-out RC source, workflow, toolchain and artifacts\n+//   record  <version> <dist-dir> <out.json> <runner-label>   identity of the checked-out RC source, package tool, workflow, toolchain and artifacts\n //   compare <expected-version> <expected-commit> <expected-workflow-commit> <out.json> <identity.json>...\n // `compare` fails unless every builder packaged the expected version and commit from identical source and lockfiles\n // and produced identical artifact digests; on success it writes the combined evidence record.\n@@ -30,6 +30,13 @@ if (mode === \"record\") {\n   if (tagCommit !== commit) fail(`fetched tag ${version} resolves to ${tagCommit}, not checked-out source commit ${commit}`);\n   const workflowSha = process.env.GITHUB_WORKFLOW_SHA ?? \"\";\n   if (!/^[0-9a-f]{40}$/.test(workflowSha)) fail(\"reviewed main workflow commit is missing or invalid\");\n+  const packageToolCommit = process.env.NEXUS_PACKAGE_TOOL_COMMIT ?? \"\";\n+  const packageToolScript = process.env.NEXUS_PACKAGE_TOOL_SCRIPT ?? \"\";\n+  if (!/^[0-9a-f]{40}$/.test(packageToolCommit) || packageToolCommit !== workflowSha) fail(\"packaging tool commit must be the exact reviewed workflow commit\");\n+  if (!packageToolScript || !fs.existsSync(packageToolScript)) fail(\"packaging tool script identity is missing\");\n+  if (!fs.statSync(packageToolScript).isFile()) fail(\"packaging tool script identity must name a file\");\n+  const reviewedPackageScript = execFileSync(\"git\", [\"show\", `${packageToolCommit}:scripts/package-linux.sh`], { encoding: \"utf8\" });\n+  if (reviewedPackageScript !== fs.readFileSync(packageToolScript, \"utf8\")) fail(\"packaging script does not match the reviewed tool commit\");\n   const artifactNames = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n   const missingArtifacts = artifactNames.filter((file) => !fs.existsSync(path.join(dist, file)));\n   if (missingArtifacts.length) fail(`release output is missing required assets: ${missingArtifacts.join(\", \")}`);\n@@ -46,6 +53,7 @@ if (mode === \"record\") {\n     },\n     toolchain: { node: process.version, npm: run(\"npm\", \"--version\"), rustc: run(\"rustc\", \"-V\"), cargo: run(\"cargo\", \"-V\") },\n     buildEnvironment: { rustContainerImage: process.env.NEXUS_BUILD_CONTAINER_IMAGE ?? null },\n+    packagingTool: { commit: packageToolCommit, packageScriptSha256: sha256(packageToolScript) },\n     runner: { label, image: process.env.ImageOS ?? null, imageVersion: process.env.ImageVersion ?? null },\n     workflow: { ref: process.env.GITHUB_REF ?? null, sha: workflowSha, runId: process.env.GITHUB_RUN_ID ?? null, runAttempt: process.env.GITHUB_RUN_ATTEMPT ?? null },\n     artifacts: Object.fromEntries(artifactNames.map((file) => [file, sha256(path.join(dist, file))])),\n@@ -65,6 +73,10 @@ if (mode === \"record\") {\n   const buildImages = builders.map((id) => id.buildEnvironment?.rustContainerImage);\n   if (buildImages.some((image) => image !== APPROVED_RUST_BUILD_IMAGE)) fail(\"every builder must use the approved digest-pinned Bookworm Rust build image\");\n   if (new Set(buildImages).size !== 1) fail(\"builders used different Rust build images\");\n+  const packageToolCommits = builders.map((id) => id.packagingTool?.commit);\n+  const packageToolHashes = builders.map((id) => id.packagingTool?.packageScriptSha256);\n+  if (packageToolCommits.some((value) => value !== workflowCommit) || packageToolHashes.some((value) => !/^[0-9a-f]{64}$/.test(value ?? \"\"))) fail(\"builders did not record the exact reviewed packaging tool commit and script hash\");\n+  if (new Set(packageToolHashes).size !== 1) fail(\"builders used different packaging tool scripts\");\n   // The released workflow is reviewed on main; the built product source remains bound to the exact RC tag commit above.\n   for (const id of builders) {\n     if (id.workflow?.ref !== \"refs/heads/main\" || id.workflow?.sha !== workflowCommit) fail(`${id.runner.label} did not record the expected reviewed main workflow commit ${workflowCommit}`);\n@@ -76,7 +88,7 @@ if (mode === \"record\") {\n   const expectedAssets = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n   if (JSON.stringify(Object.keys(first.artifacts).sort()) !== JSON.stringify(expectedAssets)) fail(\"identity evidence does not cover the exact six published release assets\");\n   const workflowRun = process.env.GITHUB_RUN_ID ? `${process.env.GITHUB_SERVER_URL}/${process.env.GITHUB_REPOSITORY}/actions/runs/${process.env.GITHUB_RUN_ID}` : null;\n-  const evidence = { requirement: \"REQ-REL-114\", acceptance: \"ACC-SUP-08\", result: \"PASS\", workflowRun, workflow: first.workflow, source: first.source, buildEnvironment: first.buildEnvironment, artifacts: first.artifacts, builders: builders.map(({ runner, toolchain }) => ({ runner, toolchain })) };\n+  const evidence = { requirement: \"REQ-REL-114\", acceptance: \"ACC-SUP-08\", result: \"PASS\", workflowRun, workflow: first.workflow, source: first.source, buildEnvironment: first.buildEnvironment, packagingTool: first.packagingTool, artifacts: first.artifacts, builders: builders.map(({ runner, toolchain }) => ({ runner, toolchain })) };\n   fs.writeFileSync(out, `${JSON.stringify(evidence, null, 2)}\\n`);\n } else {\n   fail(\"mode must be record or compare\");\n","exit_code":0,"duration":{"secs":0,"nanos":770691933}},"started_at_ms":1792885542470,"completed_at_ms":1792885543241}}
