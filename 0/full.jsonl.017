{"timestamp":"2026-10-25T01:08:16.655Z","ordinal":316892,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17095-f2fe-7de0-b5cc-460661bc1fe3","item":{"type":"CommandExecution","id":"exec-6e573239-54eb-4cb4-a5cc-eea27c68c807","process_id":"11494","command":["/usr/bin/zsh","-lc","sed -n '1,260p' cli/test/repl_approval_e2e.test.ts; sed -n '1,260p' cli/test/tui_approval_input_e2e.test.ts; sed -n '1,240p' cli/test/tui_surface_e2e.test.ts; sed -n '1,220p' cli/test/helpers/fixtures.ts; sed -n '1,180p' cli/test/helpers/repl_approval_driver.py; sed -n '1,180p' cli/test/helpers/tui_surface_driver.py"],"cwd":"file:///home/mike/nexus-wt/sec101-119-pty-followup","parsed_cmd":[{"type":"read","cmd":"sed -n '1,260p' cli/test/repl_approval_e2e.test.ts","name":"repl_approval_e2e.test.ts","path":"cli/test/repl_approval_e2e.test.ts"},{"type":"read","cmd":"sed -n '1,260p' cli/test/tui_approval_input_e2e.test.ts","name":"tui_approval_input_e2e.test.ts","path":"cli/test/tui_approval_input_e2e.test.ts"},{"type":"read","cmd":"sed -n '1,240p' cli/test/tui_surface_e2e.test.ts","name":"tui_surface_e2e.test.ts","path":"cli/test/tui_surface_e2e.test.ts"},{"type":"read","cmd":"sed -n '1,220p' cli/test/helpers/fixtures.ts","name":"fixtures.ts","path":"cli/test/helpers/fixtures.ts"},{"type":"read","cmd":"sed -n '1,180p' cli/test/helpers/repl_approval_driver.py","name":"repl_approval_driver.py","path":"cli/test/helpers/repl_approval_driver.py"},{"type":"read","cmd":"sed -n '1,180p' cli/test/helpers/tui_surface_driver.py","name":"tui_surface_driver.py","path":"cli/test/helpers/tui_surface_driver.py"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * ACC-SAFE-03 & ACC-SAFE-08: REPL approval hardening e2e in a real pseudo-terminal (PTY).\n *\n * Verifies:\n * 1. Lone Enter at approval prompt -> DENIED (returns false, file not written)\n * 2. Keystrokes typed ahead before approval prompt -> cleared with Ctrl-U and line buffer reset, DENIED\n * 3. Paste within the 400ms grace window -> discarded, not approved\n * 4. Deliberate 'y' after 500ms -> APPROVED (action executed)\n * 5. 'a' (always allow session) requires explicit confirmation typing 'all';\n *    unconfirmed cancels and reprompts, confirmed switches session to auto-approve.\n */\n\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, makeRepo, makeHome, trustWorkspace, Reply, ptyTest } from \"./helpers/fixtures.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"..\");\nconst INDEX = path.join(ROOT, \"dist/index.js\");\nconst DRIVER = path.join(here, \"helpers/repl_approval_driver.py\");\n\nfunction script(_n: number, body: any): Reply {\n  const messages: any[] = body?.messages ?? [];\n  let lastUserIdx = -1;\n  let filename = \"target.txt\";\n\n  for (let i = messages.length - 1; i >= 0; i--) {\n    if (messages[i].role === \"user\") {\n      lastUserIdx = i;\n      const text = typeof messages[i].content === \"string\" ? messages[i].content : \"\";\n      const m = text.match(/create\\s+([a-zA-Z0-9_\\-\\.]+)/i);\n      if (m) filename = m[1];\n      break;\n    }\n  }\n\n  const toolsSinceUser = lastUserIdx >= 0\n    ? messages.slice(lastUserIdx).filter((m) => m.role === \"tool\").length\n    : 0;\n\n  if (toolsSinceUser === 0) {\n    return {\n      kind: \"tools\",\n      calls: [{ name: \"write_file\", args: { path: filename, content: `content for ${filename}\\n` } }],\n      delayMs: 500, // delay allows typed-ahead input to land mid-turn\n    };\n  }\n  return { kind: \"text\", content: `Finished handling ${filename}.` };\n}\n\nasync function runScenario(scenario: string): Promise<any> {\n  const repo = makeRepo();\n  const home = makeHome();\n  trustWorkspace(home, repo);\n  const gw = await startGateway(script);\n  const plan = {\n    node: process.execPath,\n    index: INDEX,\n    args: [\"repl\", \"--approve\", \"-w\", repo, \"-e\", gw.url, \"-m\", \"m\"],\n    ws: repo,\n    home,\n    scenario,\n    env: {\n      HOME: home,\n      NEXUS_DEBUG: \"0\",\n    },\n  };\n  const planFile = path.join(home, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n\n  let driverShutdownConfirmed = false;\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [DRIVER, planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    // The driver exits successfully only after its finally block confirms that\n    // the PTY process group has stopped. Preserve the fixture on every other\n    // exit so a surviving child cannot write into a HOME being removed here.\n    driverShutdownConfirmed = code === 0;\n    assert.equal(code, 0, `driver failed for scenario '${scenario}':\\n${err}\\n${out}`);\n    const lastLine = out.trim().split(\"\\n\").pop() || \"{}\";\n    return JSON.parse(lastLine);\n  } finally {\n    await gw.close();\n    if (driverShutdownConfirmed) {\n      fs.rmSync(repo, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n    }\n  }\n}\n\nptyTest(\"REPL approval hardening (ACC-SAFE-03): lone Enter, typed-ahead, paste, deliberate approval, and session confirmation\", { timeout: 180_000 }, async () => {\n  assert.ok(fs.existsSync(INDEX), `missing ${INDEX} (run npm run build)`);\n  assert.ok(fs.existsSync(DRIVER), `missing ${DRIVER}`);\n\n  // 1. Lone Enter -> DENIED\n  const r1 = await runScenario(\"lone_enter\");\n  assert.equal(r1.file_created, false, \"lone Enter must NOT approve the action\");\n  assert.equal(r1.passed, true);\n\n  // 2. Typed ahead mid-turn -> DISCARDED & DENIED\n  const r2 = await runScenario(\"typed_ahead\");\n  assert.equal(r2.file_created, false, \"typed-ahead input must be discarded and NOT approve\");\n  assert.equal(r2.passed, true);\n\n  // 3. Paste during grace window -> DISCARDED & NOT APPROVED\n  const r3 = await runScenario(\"paste\");\n  assert.equal(r3.created_during_grace, false, \"burst/paste during grace window must NOT approve\");\n  assert.equal(r3.created_after_deny, false);\n  assert.equal(r3.passed, true);\n\n  // 4. Deliberate 'y' after grace window -> APPROVED\n  const r4 = await runScenario(\"deliberate\");\n  assert.equal(r4.file_created, true, \"deliberate 'y' after grace window MUST approve\");\n  assert.equal(r4.passed, true);\n\n  // 5. 'a' confirmation: unconfirmed cancels, 'all' enables auto-mode\n  const r5 = await runScenario(\"confirm_a\");\n  assert.equal(r5.auto1_cancelled, true, \"unconfirmed 'a' must cancel auto-approval\");\n  assert.equal(r5.auto1_created, true, \"confirmed 'a' with 'all' must approve initial action\");\n  assert.equal(r5.auto2_created, true, \"subsequent actions must run in auto mode without prompt\");\n  assert.equal(r5.passed, true);\n});\n/**\n * Approval input safety through the real TUI and sidecar in a pseudo-terminal (review mode): keys queued while the\n * panel was not yet on screen, a delayed burst, and a bracketed paste never decide an approval; one deliberate key\n * does. See helpers/tui_approval_driver.py for the sequence.\n */\n\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, makeRepo, makeHome, Reply, ptyTest } from \"./helpers/fixtures.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"../..\");\nconst TUI = path.join(ROOT, \"core/target/release/nexus-tui\");\nconst SIDECAR = path.join(ROOT, \"cli/dist/sidecar.js\");\n\nfunction script(_n: number, body: any): Reply {\n  const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n  if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"first.txt\", content: \"one\\n\" } }], delayMs: 800 };\n  if (tools === 1) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"second.txt\", content: \"two\\n\" } }] };\n  // The third approval appears while the operator is still typing.\n  if (tools === 2) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"third.txt\", content: \"three\\n\" } }], delayMs: 1200 };\n  return { kind: \"text\", content: \"Done.\" };\n}\n\nptyTest(\"queued keys, bursts and pastes never answer an approval; one deliberate key does\", { timeout: 120_000 }, async () => {\n  for (const p of [TUI, SIDECAR]) assert.ok(fs.existsSync(p), `missing ${p} (run make build)`);\n  const gw = await startGateway(script);\n  const repo = makeRepo();\n  const home = makeHome();\n  const logs = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-tui-approval-\"));\n  const plan = {\n    tui: TUI,\n    recorder: path.join(here, \"helpers/sidecar_recorder.mjs\"),\n    node: process.execPath,\n    sidecar_args: [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\", \"--approve\"],\n    env: {\n      HOME: home,\n      TERM: \"xterm-256color\",\n      COLORTERM: \"truecolor\",\n      NEXUS_DEBUG: \"0\",\n      NEXUS_RECORD_SIDECAR: SIDECAR,\n      NEXUS_RECORD_COMMANDS: path.join(logs, \"commands.ndjson\"),\n      NEXUS_RECORD_EVENTS: path.join(logs, \"events.ndjson\"),\n    },\n  };\n  const planFile = path.join(logs, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [path.join(here, \"helpers/tui_approval_driver.py\"), planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    assert.equal(code, 0, `driver failed:\\n${err}\\n${out.slice(-2000)}`);\n    const r = JSON.parse(out.trim().split(\"\\n\").pop()!);\n    assert.ok(r.approval_arrived_while_frozen, \"the approval arrived while the TUI was frozen\");\n    assert.deepEqual(r.after_queued_keys, { decisions: [], panel_open: true }, \"keys queued before the panel was on screen did not decide\");\n    assert.deepEqual(r.after_burst, { decisions: [], panel_open: true }, \"a burst did not decide\");\n    assert.deepEqual(r.after_paste, { decisions: [], panel_open: true }, \"a paste did not decide\");\n    assert.deepEqual(r.n_after_typing, [], \"after typing into the panel, a letter is text\");\n    assert.deepEqual(r.after_deny, [\"deny\"], \"Esc denied\");\n    assert.deepEqual(r.after_approve, [\"deny\", \"approve\"], \"one deliberate key approved\");\n    assert.deepEqual(r.after_typing_across, { decisions: [\"deny\", \"approve\"], panel_open: true }, \"typing across the panel's appearance decided nothing\");\n    assert.deepEqual(r.n_after_typing_across, [\"deny\", \"approve\"], \"after typing across the panel, a letter is text even after a pause\");\n    assert.deepEqual(r.after_typing_then_deny, [\"deny\", \"approve\", \"deny\"], \"Esc then denies\");\n    assert.ok(!fs.existsSync(path.join(repo, \"third.txt\")), \"the write proposed during typing did not happen\");\n    // Input typed into the frozen terminal is either discarded (the approval event reached the TUI first) or, when it\n    // is read before the event (the sidecar reader thread was frozen too), goes where typing goes while the agent\n    // works: steering, shown in the transcript. Either way it never decides.\n    const commands = fs.readFileSync(plan.env.NEXUS_RECORD_COMMANDS, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    assert.ok(commands.filter((c) => c.type === \"steer\").every((c) => c.text === \"y\"), JSON.stringify(commands));\n    assert.deepEqual(commands.filter((c) => c.type === \"approve\" || c.type === \"deny\").map((c) => c.id), [\"approval-1\", \"approval-2\", \"approval-3\"]);\n    assert.ok(!fs.existsSync(path.join(repo, \"first.txt\")), \"the denied write did not happen\");\n    assert.equal(fs.readFileSync(path.join(repo, \"second.txt\"), \"utf8\"), \"two\\n\", \"the approved write happened\");\n  } finally {\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(home, { recursive: true, force: true });\n  }\n});\n\nfunction typingScript(_n: number, body: any): Reply {\n  const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n  if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"first.txt\", content: \"one\\n\" } }], delayMs: 1200 };\n  return { kind: \"text\", content: \"Done.\" };\n}\n\nptyTest(\"typing with thinking pauses and a final Enter across the approval panel never decides; Esc then denies\", { timeout: 120_000 }, async () => {\n  const gw = await startGateway(typingScript);\n  const repo = makeRepo();\n  const home = makeHome();\n  const logs = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-tui-approval-typing-\"));\n  const plan = {\n    tui: TUI,\n    recorder: path.join(here, \"helpers/sidecar_recorder.mjs\"),\n    node: process.execPath,\n    sidecar_args: [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\", \"--approve\"],\n    env: {\n      HOME: home,\n      TERM: \"xterm-256color\",\n      COLORTERM: \"truecolor\",\n      NEXUS_DEBUG: \"0\",\n      NEXUS_RECORD_SIDECAR: SIDECAR,\n      NEXUS_RECORD_COMMANDS: path.join(logs, \"commands.ndjson\"),\n      NEXUS_RECORD_EVENTS: path.join(logs, \"events.ndjson\"),\n    },\n  };\n  const planFile = path.join(logs, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [path.join(here, \"helpers/tui_approval_typing_driver.py\"), planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    assert.equal(code, 0, `driver failed:\\n${err}\\n${out.slice(-2000)}`);\n    const r = JSON.parse(out.trim().split(\"\\n\").pop()!);\n    assert.ok(r.approval_arrived && r.panel_seen_while_typing, JSON.stringify(r));\n    assert.deepEqual(r.after_typing, { decisions: [], panel_open: true }, \"typing with pauses decided nothing\");\n    assert.match(r.hint, /typing ignored/, \"the panel says letters are not answers now\");\n    assert.deepEqual(r.after_editing_keys, { decisions: [], panel_open: true }, \"→ → Enter, Ctrl+A Enter, and → → (pause) Enter (pause) Enter decided nothing\");\n    assert.deepEqual(r.after_esc, [\"deny\"], \"a deliberate Esc denies\");\n    const events = fs.readFileSync(plan.env.NEXUS_RECORD_EVENTS, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    assert.ok(events.filter((e) => e.type === \"session.state\").every((e) => e.mode === \"review\"), \"review mode was never switched off\");\n    assert.ok(!fs.existsSync(path.join(repo, \"first.txt\")), \"nothing was written\");\n  } finally {\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(home, { recursive: true, force: true });\n  }\n});\n/**\n * The whole live TUI (`nexus-tui --live` + the real sidecar) through a pseudo-terminal, beyond diffs: startup,\n * streamed Markdown, slow inference, tool success/failure, large command output, an edit, steering, a multi-line\n * paste, an approval with buffered keys, cancellation, compaction, a verification failure, incomplete requirements,\n * scroll preservation, completion, help, detail panels, narrow/short windows and resizing during work, a sidecar\n * crash and restart, and resume. Evidence is kept on an evidence run (NEXUS_E2E_EVIDENCE=1).\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execFileSync, spawn } from \"node:child_process\";\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, makeRepo, makeHome, Reply, ptyTest } from \"./helpers/fixtures.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"../..\");\nconst TUI = path.join(ROOT, \"core/target/release/nexus-tui\");\nconst SIDECAR = path.join(ROOT, \"cli/dist/sidecar.js\");\nconst RECORDER = path.join(here, \"helpers/sidecar_recorder.mjs\");\nconst DRIVER = path.join(here, \"helpers/tui_surface_driver.py\");\nconst EVIDENCE = process.env.NEXUS_E2E_EVIDENCE === \"1\" ? path.join(ROOT, \"docs/reviews/evidence/tui_surface\") : fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-surface-evidence-\"));\nconst sha256 = (file: string) => createHash(\"sha256\").update(fs.readFileSync(file)).digest(\"hex\");\n\nexport const MARKDOWN = [\n  \"## Cache layer plan\\n\\n\",\n  \"The cache sits **between** the loader and the store, so reads stay fast while writes remain \",\n  \"authoritative. It keeps the existing `Loader` interface.\\n\\n\",\n  \"### Steps\\n\\n\",\n  \"1. Add `src/cache.ts` with an LRU map.\\n\",\n  \"2. Route `load()` through it.\\n\",\n  \"3. Invalidate on write.\\n\\n\",\n  \"- Reads: O(1)\\n- Writes: unchanged\\n  - nested detail\\n\\n\",\n  \"```ts\\nexport class Cache<K, V> {\\n\\tprivate map = new Map<K, V>();\\n\\tget(key: K): V | undefined {\\n\\t\\treturn this.map.get(key); // a long trailing comment that runs well past the width of a narrow terminal window\\n\\t}\\n}\\n```\\n\\n\",\n  \"| Option | Default | Note |\\n|---|---|---|\\n| size | 512 | entries |\\n| ttl | 60 s | per entry |\\n\\n\",\n  \"Emoji and marks: ✅ café naïve 字符 — done.\",\n];\n\n/** The prompt of the current turn: the newest user message that is one of the scenario's prompts. */\nfunction currentPrompt(body: any): { key: string; toolsSince: number } {\n  const messages: any[] = body?.messages ?? [];\n  const keys = [\"Explain the plan\", \"Inspect the repository\", \"line one of the note\", \"Write the config file\", \"Take a long time\", \"Fix the parser bug\", \"Do these\", \"Stream another answer\"];\n  for (let i = messages.length - 1; i >= 0; i--) {\n    const m = messages[i];\n    const text = typeof m.content === \"string\" ? m.content : JSON.stringify(m.content ?? \"\");\n    if (m.role !== \"user\") continue;\n    const key = keys.find((k) => text.includes(k));\n    if (key) return { key, toolsSince: messages.slice(i).filter((x) => x.role === \"tool\").length };\n  }\n  return { key: \"\", toolsSince: 0 };\n}\n\nfunction script(_n: number, body: any): Reply {\n  const { key, toolsSince } = currentPrompt(body);\n  const tools = (name: string, args: unknown, delayMs = 300): Reply => ({ kind: \"tools\", calls: [{ name, args }], delayMs });\n  switch (key) {\n    case \"Explain the plan\":\n    case \"Stream another answer\":\n      return { kind: \"text\", content: MARKDOWN.join(\"\"), chunks: MARKDOWN, gapMs: 180 };\n    case \"Inspect the repository\":\n      return [\n        tools(\"read_file\", { path: \"README.md\" }, 2500),\n        tools(\"read_file\", { path: \"missing.txt\" }),\n        tools(\"run_command\", { command: \"seq 1 120; printf 'esc:\\\\033]52;c;SGk=\\\\007 end\\\\n'\" }),\n        tools(\"write_file\", { path: \"src/cache.ts\", content: \"export class Cache<K, V> {\\n\\tprivate map = new Map<K, V>();\\n}\\n\" }),\n        { kind: \"text\", content: \"Added `src/cache.ts`. The read of `missing.txt` failed because the file does not exist.\" } as Reply,\n      ][Math.min(toolsSince, 4)];\n    case \"line one of the note\":\n      return { kind: \"text\", content: \"Noted the three lines.\" };\n    case \"Write the config file\":\n      return toolsSince === 0 ? tools(\"write_file\", { path: \"config.json\", content: '{ \"cache\": true }\\n' }) : { kind: \"text\", content: \"Config written.\" };\n    case \"Take a long time\":\n      return { kind: \"text\", content: \"too late\", delayMs: 8000 };\n    case \"Fix the parser bug\":\n      // Finishing through task_completed runs the workspace verifier, which fails once parser.js exists.\n      if (toolsSince === 0) return tools(\"write_file\", { path: \"parser.js\", content: \"module.exports = (s) => s.trim();\\n\" });\n      if (toolsSince === 1) return tools(\"task_completed\", { summary: \"Fixed the parser.\" });\n      return { kind: \"text\", content: \"The parser test still fails; it needs a tokenizer change I have not made.\" };\n    case \"Do these\":\n      return { kind: \"text\", content: \"Both items are handled.\" };\n    default:\n      return { kind: \"text\", content: \"Yes.\" };\n  }\n}\n\nconst lines = (file: string) => (fs.existsSync(file) ? fs.readFileSync(file, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l)) : []);\nconst squeeze = (text: string) => text.replace(/\\s/g, \"\");\nconst shows = (screen: string[], text: string) => screen.some((line) => squeeze(line).includes(squeeze(text)));\n\nptyTest(\"the whole live TUI through a pseudo-terminal\", { timeout: 420_000 }, async () => {\n  for (const p of [TUI, SIDECAR]) assert.ok(fs.existsSync(p), `missing ${p} (run make build)`);\n  const repo = makeRepo({\n    \"README.md\": \"# Demo\\n\\nA small repository.\\n\",\n    // The verifier the agent discovers: fails only once parser.js exists, so earlier edits verify.\n    \"package.json\": JSON.stringify({ name: \"demo\", version: \"1.0.0\", scripts: { test: \"node -e \\\"if (require('fs').existsSync('parser.js')) { console.error('parser test failed: expected 3 tokens, got 2'); process.exit(1) }\\\"\" } }, null, 2) + \"\\n\",\n  });\n  const gw = await startGateway(script);\n  const home = makeHome();\n  const trustDir = path.join(home, \".config\", \"nexus\");\n  fs.mkdirSync(trustDir, { recursive: true });\n  fs.writeFileSync(path.join(trustDir, \"trusted_workspaces.json\"), JSON.stringify({ trustedPaths: [fs.realpathSync(repo)] }, null, 2));\n  const logs = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-tui-surface-\"));\n  fs.mkdirSync(EVIDENCE, { recursive: true });\n  const plan = {\n    tui: TUI,\n    recorder: RECORDER,\n    node: process.execPath,\n    sidecar_args: [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\", \"--mode\", \"auto\"],\n    cast: path.join(EVIDENCE, \"tui_surface.cast\"),\n    screens: path.join(EVIDENCE, \"tui_surface_screens.json\"),\n    env: {\n      HOME: home,\n      TERM: \"xterm-256color\",\n      COLORTERM: \"truecolor\",\n      NEXUS_DEBUG: \"0\",\n      NEXUS_RECORD_SIDECAR: SIDECAR,\n      NEXUS_RECORD_COMMANDS: path.join(logs, \"commands.ndjson\"),\n      NEXUS_RECORD_EVENTS: path.join(logs, \"events.ndjson\"),\n    },\n  };\n  const planFile = path.join(logs, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [DRIVER, planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    assert.equal(code, 0, `driver failed:\\n${err}\\n${out.slice(-3000)}`);\n    const r = JSON.parse(out.trim().split(\"\\n\").pop()!);\n    const events = lines(plan.env.NEXUS_RECORD_EVENTS);\n    const commands = lines(plan.env.NEXUS_RECORD_COMMANDS);\n    let head = \"unknown\";\n    try {\n      head = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: ROOT, encoding: \"utf8\" }).trim();\n    } catch {}\n    const metrics = path.join(EVIDENCE, \"tui_surface.metrics.json\");\n    fs.writeFileSync(metrics, JSON.stringify({ run: { id: randomUUID(), generatedAt: new Date().toISOString(), gitHead: head, tuiSha256: sha256(TUI), sidecarSha256: sha256(SIDECAR) }, ...r }, null, 2) + \"\\n\");\n    fs.writeFileSync(path.join(EVIDENCE, \"tui_surface.manifest.json\"), JSON.stringify({ files: Object.fromEntries([plan.cast, plan.screens, metrics].map((f) => [path.basename(f), sha256(f)])) }, null, 2) + \"\\n\");\n    fs.writeFileSync(path.join(EVIDENCE, \"events.ndjson\"), events.map((e) => JSON.stringify(e)).join(\"\\n\") + \"\\n\");\n    fs.writeFileSync(path.join(EVIDENCE, \"commands.ndjson\"), commands.map((e) => JSON.stringify(e)).join(\"\\n\") + \"\\n\");\n    assert.ok(r.recording.monotonic, \"recording timestamps never go backwards\");\n    const outcomes = events.filter((e) => e.type === \"turn.result\").map((e) => [e.turn.execution, e.turn.outcome, e.turn.reason ?? null]);\n    assert.ok(outcomes.length >= 8, JSON.stringify(outcomes));\n    assert.deepEqual(outcomes.map((o) => o[2]).slice(0, 7), [null, \"VERIFICATION_NOT_RUN\", \"VERIFICATION_NOT_RUN\", \"VERIFICATION_NOT_RUN\", \"OPERATOR_INTERRUPT\", \"REQUIREMENTS_INCOMPLETE\", \"VERIFIER_FAILED\"]);\n    if (process.env.NEXUS_SURFACE_AUDIT === \"1\") return; // audit runs only capture\n    // Assertions are added with the acceptance matrix (see docs/reviews/NEXUS_TUI_SURFACE_2026-10-12.md).\n    assertSurface(r, events, commands, shows);\n  } finally {\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(home, { recursive: true, force: true });\n  }\n});\n\nfunction assertSurface(r: any, events: any[], commands: any[], shows: (screen: string[], text: string) => boolean): void {\n  const screens: Record<string, string[]> = r.screens;\n  const all = Object.values(screens).flat();\n  // Outcomes in words, never raw fields; each outcome kind appears.\n  assert.ok(!all.some((l) => l.includes(\"execution=\") || l.includes(\"TURN ENDED\") || l.includes(\"0 tool call\")), \"raw outcome fields stay in the receipt\");\n  for (const title of [\"✓ Done\", \"! Done · not verified\", \"◌ Cancelled\", \"× Verification failed\", \"! Requirements still open\"]) {\n    assert.ok(all.some((l) => l.includes(title)), `outcome ${title} shown`);\n  }\n  // Markdown rendered, no markers left.\n  const md = screens[\"03-markdown-final\"];\n  for (const marker of [\"**\", \"```\", \"## \", \"|---\"]) assert.ok(!md.some((l) => l.includes(marker)), `markdown marker ${marker} left`);\n  assert.ok(shows(md, \"Cache layer plan\") && md.some((l) => l.includes(\"Option │ Default\")) && md.some((l) => l.includes(\"↪\")), md.join(\"\\n\"));\n  // Streaming showed no raw markers either.\n  assert.ok(!screens[\"02-streaming\"].some((l) => l.includes(\"**\") || l.includes(\"## \")), screens[\"02-streaming\"].join(\"\\n\"));\n  // Tools: bounded command output with an exact count; a failed read stays failed.\n  const tools = screens[\"07-tools-final\"];\n  assert.ok(tools.some((l) => l.includes(\"exit 0 · 121 lines\")) && tools.some((l) => l.includes(\"… 115 earlier lines\")), tools.join(\"\\n\"));\n  assert.ok(tools.some((l) => l.includes(\"esc:\") && l.includes(\"end\")), `the output's last line is shown: ${tools.join(\"\\n\")}`);\n  assert.ok(tools.some((l) => l.includes(\"× Read missing.txt\")), tools.join(\"\\n\"));\n  assert.equal(r.raw_has_file_escape, false, \"the OSC 52 sequence printed by the command never reached the terminal\");\n  // One activity indicator: the status bar never animates.\n  const spinner = /[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]/;\n  for (const [name, rows] of Object.entries(screens)) assert.ok(!spinner.test(rows[0]), `${name}: status bar shows no spinner`);\n  assert.ok(spinner.test(screens[\"04-slow-inference\"].at(-2)!) && shows(screens[\"04-slow-inference\"], \"thinking\"), screens[\"04-slow-inference\"].join(\"\\n\"));\n  // Scrolling: position kept, new output announced.\n  assert.ok(r.scroll_kept, \"the reading position is kept while output arrives\");\n  assert.ok(shows(screens[\"06-scrolled-back-new-output\"], \"↓ new output\"), screens[\"06-scrolled-back-new-output\"].join(\"\\n\"));\n  // Steering: one steer command, queued then applied.\n  assert.equal(commands.filter((c) => c.type === \"steer\").length, 1);\n  assert.deepEqual(events.filter((e) => e.type === \"steer.ack\").map((e) => e.status), [\"queued\", \"applied\"]);\n  // Paste: the sent text is visible under its label.\n  assert.ok(shows(screens[\"07-tools-final\"].concat(all), \"line one of the note\"), \"pasted text shown\");\n  // Approval: target and decisions with focus; buffered keys did not decide.\n  const approval = screens[\"10-approval\"];\n  assert.ok(shows(approval, \"Approval needed\") && shows(approval, \"Proposed: create config.json\") && shows(approval, \"Approve all later actions\") && !shows(approval, \"y Approve\"), approval.join(\"\\n\"));\n  assert.ok(r.approval_survived_buffered_keys);\n  assert.ok(r.letters_disarmed_hint, \"keys typed just before the panel disarm its letters, and the panel says so\");\n  // Requirements: listed once, and the repeated replies are explained.\n  const req = screens[\"14-requirements-incomplete\"];\n  assert.ok(shows(req, \"R1 [open] add a README section\") && shows(req, \"asked the agent to continue\"), req.join(\"\\n\"));\n  assert.ok(!req.some((l) => l.includes(\"handled.Both\")), \"replies are not run together\");\n  // Verification failure names the command.\n  assert.ok(shows(screens[\"13-verification-failed\"], \"npm test failed\"), screens[\"13-verification-failed\"].join(\"\\n\"));\n  // Narrow and short windows: nothing wider than the terminal; the composer line is kept.\n  for (const [name, width] of [[\"19-narrow\", 60], [\"21-resize-during-stream\", 64], [\"20-short\", 80]] as const) {\n    assert.ok(screens[name].every((l) => [...l].length <= width), `${name} fits ${width} columns`);\n    assert.ok(screens[name].at(-1)!.startsWith(\"›\"), `${name} keeps the composer`);\n  }\n  assert.equal(r.idle_bytes, 0, \"nothing is redrawn while idle\");\n  // Crash: signal named, chatter dropped, draft kept; restart then /resume restores the conversation.\n  const crash = screens[\"22-crashed\"];\n  assert.ok(shows(crash, \"signal 9 (SIGKILL)\") && !shows(crash, \"considering the next step\") && shows(crash, \"a draft before the crash\"), crash.join(\"\\n\"));\n  const restarted = screens[\"23b-restart-then-resume\"];\n  assert.ok(shows(restarted, \"Resumed session\") && shows(restarted, \"Emoji and marks\"), restarted.join(\"\\n\"));\n  // Resume in a new TUI: the earlier conversation, without Nexus's own prompts.\n  const resumed = screens[\"24-resumed\"];\n  assert.ok(shows(resumed, \"Resumed session\") && shows(resumed, \"Emoji and marks\") && !shows(resumed, \"[Nexus continuation\") && !shows(resumed, \"[Git Status\"), resumed.join(\"\\n\"));\n  // No duplicated outcome for a turn.\n  const results = events.filter((e) => e.type === \"turn.result\").map((e) => e.turn_id);\n  assert.equal(new Set(results).size, results.length, \"one result per turn\");\n}\nimport { test } from \"node:test\";\nimport http from \"node:http\";\nimport type { Socket } from \"node:net\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execSync } from \"node:child_process\";\n\nexport type Reply =\n  /** `truncated`: the reply hits the output limit (finish_reason=length) partway through its tool calls' arguments. */\n  | { kind: \"tools\"; calls: Array<{ name: string; args: unknown; id?: string }>; content?: string; delayMs?: number; truncated?: boolean }\n  /** `chunks`: stream the text in these pieces, `gapMs` apart (the default sends it in one delta). `truncated`: finish_reason=length. */\n  | { kind: \"text\"; content: string; delayMs?: number; chunks?: string[]; gapMs?: number; truncated?: boolean }\n  | { kind: \"http\"; status: number; body?: string; delayMs?: number };\n\nexport interface Gateway {\n  url: string;\n  requests: unknown[];\n  /** Bodies of /tokenize requests (only with `options.tokenize`). */\n  tokenizeRequests: any[];\n  /** Number of GET /models requests served. */\n  modelRequests: number;\n  /** Authorization headers seen, per path kind. */\n  authSeen: Array<{ path: string; authorization?: string }>;\n  close(): Promise<void>;\n}\n\n/** Optional gateway capabilities (homelab-ai contract shape): catalog entries, request counting, admission headers. */\nexport interface GatewayOptions {\n  /** `data` entries for GET /models (default: [{ id: \"m\" }]). Called per request, so tests can change capacity. */\n  models?: () => any[];\n  /** Answer to POST /tokenize; absent: 404. */\n  tokenize?: (body: any, n: number) => { status: number; body: unknown; delayMs?: number };\n  /** Response headers for the n-th chat request (e.g. X-AIHost-* admission headers). */\n  headers?: (n: number, body: any) => Record<string, string>;\n}\n\nfunction sse(obj: unknown): string {\n  return `data: ${JSON.stringify(obj)}\\n\\n`;\n}\n\n/** A tool call's arguments as sent: whole, or cut off partway like a reply that hit the output limit. */\nfunction wireArguments(args: unknown, truncated?: boolean): string {\n  const json = JSON.stringify(args);\n  return truncated ? json.slice(0, Math.max(1, Math.floor(json.length / 2))) : json;\n}\n\nfunction finishReason(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  return r.truncated ? \"length\" : r.kind === \"tools\" ? \"tool_calls\" : \"stop\";\n}\n\nfunction streamBody(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  let out = \"\";\n  if (r.kind === \"text\") out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n  else {\n    if (r.content) out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n    r.calls.forEach((c, i) => {\n      out += sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: i, id: c.id ?? `call_${i}_${Math.random().toString(36).slice(2, 7)}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } }] } }] });\n    });\n  }\n  out += sse({ choices: [{ index: 0, delta: {}, finish_reason: finishReason(r) }] });\n  return out + \"data: [DONE]\\n\\n\";\n}\n\n/** Deterministic OpenAI-compatible gateway. `script(n, body)` decides the reply to the n-th chat request (1-based). */\nexport async function startGateway(script: (n: number, body?: any) => Reply, options: GatewayOptions = {}): Promise<Gateway> {\n  const requests: unknown[] = [];\n  const tokenizeRequests: any[] = [];\n  const authSeen: Array<{ path: string; authorization?: string }> = [];\n  let modelRequests = 0;\n  const sockets = new Set<Socket>();\n  const server = http.createServer((req, res) => {\n    authSeen.push({ path: req.url ?? \"\", authorization: req.headers.authorization });\n    if (req.url?.endsWith(\"/models\")) {\n      modelRequests++;\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ data: options.models ? options.models() : [{ id: \"m\" }] }));\n      return;\n    }\n    if (req.url?.endsWith(\"/tokenize\")) {\n      let raw = \"\";\n      req.on(\"data\", (c) => (raw += c));\n      req.on(\"end\", () => {\n        let body: any = {};\n        try { body = JSON.parse(raw); } catch {}\n        tokenizeRequests.push(body);\n        if (!options.tokenize) {\n          res.statusCode = 404;\n          res.end(JSON.stringify({ status: \"not_found\", message: \"no tokenize\" }));\n          return;\n        }\n        const answer = options.tokenize(body, tokenizeRequests.length);\n        const send = () => {\n          if (res.writableEnded || res.destroyed) return;\n          res.statusCode = answer.status;\n          res.setHeader(\"content-type\", \"application/json\");\n          res.end(typeof answer.body === \"string\" ? answer.body : JSON.stringify(answer.body));\n        };\n        if (answer.delayMs) setTimeout(send, answer.delayMs); else send();\n      });\n      return;\n    }\n    let raw = \"\";\n    req.on(\"data\", (c) => (raw += c));\n    req.on(\"end\", () => {\n      let body: any = {};\n      try { body = JSON.parse(raw); } catch {}\n      requests.push(body);\n      const extraHeaders = options.headers ? options.headers(requests.length, body) : {};\n      for (const [k, v] of Object.entries(extraHeaders)) res.setHeader(k, v);\n      const r = script(requests.length, body);\n      const respond = () => {\n        if (res.writableEnded || res.destroyed) return;\n        if (r.kind === \"http\") {\n          res.statusCode = r.status;\n          res.end(r.body ?? \"{}\");\n        } else if (body.stream && r.kind === \"text\" && r.chunks?.length) {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          const pieces = [...r.chunks];\n          const next = () => {\n            if (res.writableEnded || res.destroyed) return;\n            const piece = pieces.shift();\n            if (piece === undefined) {\n              res.end(sse({ choices: [{ index: 0, delta: {}, finish_reason: \"stop\" }] }) + \"data: [DONE]\\n\\n\");\n              return;\n            }\n            res.write(sse({ choices: [{ index: 0, delta: { content: piece } }] }));\n            setTimeout(next, r.gapMs ?? 50);\n          };\n          next();\n        } else if (body.stream) {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          res.end(streamBody(r));\n        } else {\n          res.setHeader(\"content-type\", \"application/json\");\n          const message = r.kind === \"text\"\n            ? { role: \"assistant\", content: r.content }\n            : { role: \"assistant\", content: r.content ?? null, tool_calls: r.calls.map((c, i) => ({ id: c.id ?? `call_${i}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } })) };\n          res.end(JSON.stringify({ choices: [{ index: 0, message, finish_reason: r.truncated ? \"length\" : \"stop\" }] }));\n        }\n      };\n      if (r.delayMs) setTimeout(respond, r.delayMs); else respond();\n    });\n  });\n  server.on(\"connection\", (s) => { sockets.add(s); s.on(\"close\", () => sockets.delete(s)); });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", () => resolve()));\n  const port = (server.address() as any).port;\n  return {\n    url: `http://127.0.0.1:${port}/v1`,\n    requests,\n    tokenizeRequests,\n    get modelRequests() {\n      return modelRequests;\n    },\n    authSeen,\n    close: async () => {\n      for (const s of sockets) s.destroy();\n      await new Promise<void>((resolve) => server.close(() => resolve()));\n    },\n  };\n}\n\n/** Temporary git repository with one committed file. */\nexport function makeRepo(files: Record<string, string> = {}): string {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-sidecar-\"));\n  fs.writeFileSync(path.join(repo, \"base.txt\"), \"base\\n\");\n  for (const [name, content] of Object.entries(files)) {\n    const full = path.join(repo, name);\n    fs.mkdirSync(path.dirname(full), { recursive: true });\n    fs.writeFileSync(full, content);\n  }\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm base\", { cwd: repo, stdio: \"ignore\" });\n  return repo;\n}\n\nexport function makeHome(): string {\n  return fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-home-\"));\n}\n\n/** Seed an isolated HOME with explicit trust for a PTY test that needs to reach the REPL. */\nexport function trustWorkspace(home: string, workspace: string): void {\n  const trustDir = path.join(home, \".config\", \"nexus\");\n  fs.mkdirSync(trustDir, { recursive: true, mode: 0o700 });\n  fs.writeFileSync(\n    path.join(trustDir, \"trusted_workspaces.json\"),\n    JSON.stringify({ trustedPaths: [fs.realpathSync(workspace)] }, null, 2),\n    { mode: 0o600 },\n  );\n}\n\nexport async function waitUntil(cond: () => boolean, timeoutMs = 10000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (!cond()) {\n    if (Date.now() > deadline) throw new Error(\"timed out\");\n    await new Promise((r) => setTimeout(r, 10));\n  }\n}\n\nexport async function waitForEvent(events: any[], pred: (e: any) => boolean, timeoutMs = 10000): Promise<any> {\n  try {\n    await waitUntil(() => events.some(pred), timeoutMs);\n  } catch {\n    throw new Error(`timed out waiting for event; saw: ${events.map((e) => e.type).join(\", \")}`);\n  }\n  return events.find(pred);\n}\n\n/**\n * Pseudo-terminal scenarios measure timing (spinner frames, idle redraws, approval grace) and drive real processes;\n * run concurrently by the test runner they starve each other and keys arrive late. `ptyTest` holds a cross-process\n * lock (a directory under the system temp dir, taken over when its owner is gone) so they run one at a time.\n */\nexport async function acquirePtyLock(timeoutMs = 15 * 60_000): Promise<() => void> {\n  const dir = path.join(os.tmpdir(), \"nexus-pty-test.lock\");\n  const owner = path.join(dir, \"pid\");\n  const deadline = Date.now() + timeoutMs;\n  for (;;) {\n    try {\n      fs.mkdirSync(dir);\n      fs.writeFileSync(owner, String(process.pid));\n#!/usr/bin/env python3\n\"\"\"Approval input safety driver for the REPL (ACC-SAFE-03).\nRuns node repl in a pseudo-terminal (PTY) and tests:\n1. Lone Enter at approval prompt -> DENIED\n2. Keystrokes typed ahead before approval prompt -> DISCARDED / DENIED\n3. Paste within the 400ms grace window -> DISCARDED / DENIED\n4. Deliberate 'y' after 500ms grace window -> APPROVED\n5. Always allow ('a') requires explicit 'all' confirmation; unconfirmed cancels, confirmed enables auto-mode.\n\nUsage: repl_approval_driver.py PLAN.json\n\"\"\"\nimport fcntl\nimport json\nimport os\nimport pty\nimport re\nimport select\nimport signal\nimport struct\nimport sys\nimport termios\nimport time\n\nCSI = re.compile(r\"\\x1b\\[[0-9;?<>=]*[ -/]*[@-~]|\\x1b\\][^\\x07\\x1b]*(?:\\x07|\\x1b\\\\)|\\x1b[()][0-9A-Za-z]|\\x1b[=>78]\")\n\n\nclass ReplSession:\n    def __init__(self, argv, env, cwd, cols=100, rows=30):\n        self.cols, self.rows = cols, rows\n        self.pid, self.fd = pty.fork()\n        self.reaped = False\n        if self.pid == 0:\n            os.chdir(cwd)\n            os.execvpe(argv[0], argv, env)\n        self.out = \"\"\n        self.raw = b\"\"\n        fcntl.ioctl(self.fd, termios.TIOCSWINSZ, struct.pack(\"HHHH\", rows, cols, 0, 0))\n\n    def pump(self, seconds=0.2):\n        deadline = time.monotonic() + seconds\n        got = b\"\"\n        while True:\n            left = deadline - time.monotonic()\n            if left <= 0:\n                break\n            ready, _, _ = select.select([self.fd], [], [], left)\n            if not ready:\n                continue\n            try:\n                chunk = os.read(self.fd, 65536)\n            except OSError:\n                break\n            if not chunk:\n                break\n            got += chunk\n        if got:\n            self.raw += got\n            self.out += got.decode(\"utf-8\", \"replace\")\n        return got\n\n    def clean_text(self):\n        return CSI.sub(\"\", self.out)\n\n    def wait_text(self, text, timeout=25):\n        deadline = time.monotonic() + timeout\n        while text not in self.clean_text():\n            if time.monotonic() > deadline:\n                raise TimeoutError(f\"never saw {text!r}; clean text:\\n{self.clean_text()[-1000:]}\")\n            self.pump(0.05)\n\n    def send(self, data: bytes, settle=0.1):\n        os.write(self.fd, data)\n        if settle > 0:\n            self.pump(settle)\n\n    def close(self):\n        try:\n            # pty.fork makes the child a session/process-group leader. Stop the\n            # whole REPL tree so a sidecar cannot keep writing session state\n            # while the parent test removes its temporary HOME.\n            try:\n                os.killpg(self.pid, signal.SIGTERM)\n            except ProcessLookupError:\n                pass\n\n            if not self._wait_for_group_exit(10.0):\n                try:\n                    os.killpg(self.pid, signal.SIGKILL)\n                except ProcessLookupError:\n                    pass\n                if not self._wait_for_group_exit(5.0):\n                    raise RuntimeError(f\"REPL process group {self.pid} did not exit after SIGKILL\")\n        finally:\n            try:\n                os.close(self.fd)\n            except OSError:\n                pass\n\n    def _wait_for_group_exit(self, timeout):\n        deadline = time.monotonic() + timeout\n        while True:\n            if not self.reaped:\n                try:\n                    pid, _ = os.waitpid(self.pid, os.WNOHANG)\n                    self.reaped = pid == self.pid\n                except ChildProcessError:\n                    self.reaped = True\n\n            group_alive = False\n            try:\n                os.killpg(self.pid, 0)\n                group_alive = True\n            except ProcessLookupError:\n                pass\n            except PermissionError:\n                group_alive = True\n\n            if self.reaped and not group_alive:\n                return True\n            if time.monotonic() >= deadline:\n                return False\n            time.sleep(0.05)\n\n\ndef main():\n    if len(sys.argv) < 2:\n        print(\"Usage: repl_approval_driver.py PLAN.json\", file=sys.stderr)\n        sys.exit(1)\n\n    plan = json.load(open(sys.argv[1]))\n    argv = [plan[\"node\"], plan[\"index\"]] + plan[\"args\"]\n    env = {\n        **os.environ,\n        **plan.get(\"env\", {}),\n        \"TERM\": \"xterm-256color\",\n        \"COLORTERM\": \"truecolor\",\n        \"LANG\": \"C.UTF-8\",\n    }\n    ws = plan[\"ws\"]\n    scenario = plan.get(\"scenario\", \"lone_enter\")\n\n    s = ReplSession(argv, env, ws)\n    result = {}\n\n    try:\n        s.wait_text(\"❯\", timeout=25)\n\n        if scenario == \"lone_enter\":\n            s.send(b\"create lone_enter.txt\\r\", settle=0.3)\n            s.wait_text(\"[y/N/d/a]\", timeout=20)\n            # Lone Enter at prompt\n            s.send(b\"\\r\", settle=2.5)\n            created = os.path.exists(os.path.join(ws, \"lone_enter.txt\"))\n            result = {\n                \"scenario\": scenario,\n                \"file_created\": created,\n                \"passed\": not created,\n            }\n\n        elif scenario == \"typed_ahead\":\n            s.send(b\"create typed_ahead.txt\\r\", settle=0.2)\n            # Send 'y\\r' mid-turn while model is processing, before approval prompt appears\n            s.send(b\"y\\r\", settle=0.4)\n            s.wait_text(\"[y/N/d/a]\", timeout=20)\n            # The typed ahead 'y\\r' must have been cleared / discarded; send Enter\n            s.send(b\"\\r\", settle=2.5)\n            created = os.path.exists(os.path.join(ws, \"typed_ahead.txt\"))\n            result = {\n                \"scenario\": scenario,\n                \"file_created\": created,\n                \"passed\": not created,\n            }\n\n        elif scenario == \"paste\":\n            s.send(b\"create paste.txt\\r\", settle=0.3)\n            s.wait_text(\"[y/N/d/a]\", timeout=20)\n            # Immediately send burst / paste during grace window (<400ms)\n            s.send(b\"y\\r\", settle=1.2)\n            created_during_grace = os.path.exists(os.path.join(ws, \"paste.txt\"))\n            # Settle and deny with 'n'\n#!/usr/bin/env python3\n\"\"\"Drives the real `nexus-tui --live` (with the real sidecar) through the whole interface, not only diffs: startup,\nstreamed Markdown, slow inference, tool success and failure, large command output, an edit, steering, a multi-line\npaste, an approval in review mode (with buffered keys), cancellation, compaction, a verification failure, incomplete\nrequirements, scroll preservation while output arrives, slash completion and help, narrow and short windows with\nresizing during work, a sidecar crash and restart, and resuming the saved session.\n\nIt captures named screens (cells with colours, rendered to PNG by render_screens.py) and prints a JSON summary; the\nnode test (tui_surface_e2e.test.ts) owns the mock gateway and asserts on the summary and the sidecar logs.\n\nUsage: tui_surface_driver.py PLAN.json\n\"\"\"\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport time\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom tui_diff_driver import DiffSession, has  # noqa: E402\nfrom tui_pty_driver import T0, count_events, pty_env, wait_events  # noqa: E402\n\n\ndef children(pid):\n    try:\n        out = subprocess.run([\"pgrep\", \"-P\", str(pid)], capture_output=True, text=True).stdout\n        return [int(p) for p in out.split()]\n    except Exception:\n        return []\n\n\ndef main():\n    plan = json.load(open(sys.argv[1]))\n    env = pty_env(plan[\"env\"])\n    events = plan[\"env\"][\"NEXUS_RECORD_EVENTS\"]\n    cast, shots, result = [], [], {}\n    argv = [plan[\"tui\"], \"--live\", \"--sidecar\", plan[\"recorder\"], \"--node\", plan[\"node\"], \"--\"] + plan[\"sidecar_args\"]\n    turns = lambda: count_events(events, \"turn.result\")  # noqa: E731\n\n    def shot(session, name):\n        shots.append(session.color.snapshot(name))\n        result.setdefault(\"screens\", {})[name] = session.color.lines()\n\n    s = DiffSession(argv, env, 120, 36, cast)\n    s.wait_text(\"enter send\", 30)\n    s.pump(0.4)\n    shot(s, \"01-startup\")\n\n    # Streamed Markdown; scroll back while it streams, then return.\n    s.send(\"Explain the plan for the cache layer.\\r\", settle=0.1)\n    s.wait_screen(lambda lines: has(lines, \"Cache layer plan\"), 15, \"streamed heading\")\n    s.pump(0.6)\n    shot(s, \"02-streaming\")\n    wait_events(events, \"turn.result\", 1, 30, s)\n    s.wait_idle()\n    s.pump(0.3)\n    shot(s, \"03-markdown-final\")\n\n    # Slow inference, then tools: read, failed read, large command output, an edit; steering while busy.\n    s.send(\"Inspect the repository and add the cache module.\\r\", settle=0.1)\n    s.pump(1.2)\n    shot(s, \"04-slow-inference\")\n    s.send(\"prefer an LRU policy\\r\", settle=0.2)\n    s.pump(0.3)\n    shot(s, \"05-steering-queued\")\n    # Scroll back while output keeps arriving.\n    s.send(\"\\x1b[5~\", settle=0.3)\n    before_scroll = s.color.lines()[1:-3]\n    wait_events(events, \"tool.end\", 3, 30, s)\n    s.pump(0.5)\n    result[\"scroll_kept\"] = s.color.lines()[1:-3] == before_scroll\n    shot(s, \"06-scrolled-back-new-output\")\n    s.send(\"\\x1b[6~\" * 8, settle=0.3)\n    wait_events(events, \"turn.result\", 2, 60, s)\n    s.wait_idle()\n    s.pump(0.3)\n    shot(s, \"07-tools-final\")\n\n    # A multi-line paste, inspected, then sent.\n    s.send(\"\\x1b[200~line one of the note\\r\\n\\tindented line ✓ 字\\r\\nline three\\x1b[201~\", settle=0.4)\n    shot(s, \"08-paste-buffer\")\n    s.send(\"\\x0f\", settle=0.4)  # ctrl+o\n    shot(s, \"09-paste-view\")\n    s.send(\"\\x1b\", settle=0.3)\n    s.send(\"\\r\", settle=0.2)\n    wait_events(events, \"turn.result\", 3, 30, s)\n    s.wait_idle()\n\n    # Review mode: an approval; keys typed just before it opens must not answer it.\n    s.send(\"/mode review\\r\", settle=0.5)\n    s.send(\"Write the config file.\\r\", settle=0.05)\n    s.send(\"yyy\", settle=0.05)\n    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 20, \"the approval modal\")\n    s.pump(0.9)  # a pause in typing before the deliberate decision\n    shot(s, \"10-approval\")\n    result[\"approval_survived_buffered_keys\"] = has(s.color.lines(), \"Approval needed\")\n    # Keys were typed just before it opened, so its letters are not answers: ← selects Approve, Enter confirms.\n    result[\"letters_disarmed_hint\"] = any(\"typing ignored\" in l for l in s.color.lines())\n    s.send(\"\\x1b[D\", settle=2.2)  # on a typed-into panel the choice stays on screen 2 s before Enter takes it\n    s.send(\"\\r\", settle=0.6)  # where letters are off, approving takes Enter twice\n    s.send(\"\\r\", settle=0.4)\n    wait_events(events, \"turn.result\", 4, 30, s)\n    s.wait_idle()\n    result[\"draft_after_approval\"] = s.color.lines()[-1]\n    s.send(\"\\x0c\", settle=0.2)  # the buffered keys stayed in the draft: clear it\n    s.send(\"/mode auto\\r\", settle=0.5)\n\n    # Cancellation during a slow step.\n    s.send(\"Take a long time on this.\\r\", settle=0.1)\n    s.pump(1.5)\n    s.send(\"\\x1b\", settle=0.1)\n    wait_events(events, \"turn.result\", 5, 30, s)\n    s.wait_idle()\n    s.pump(0.3)\n    shot(s, \"11-cancelled\")\n\n    # Compaction.\n    s.send(\"/compact\\r\", settle=0.3)\n    s.wait_screen(lambda lines: has(lines, \"ompact\"), 20, \"compaction output\")\n    s.pump(0.6)\n    s.wait_idle()\n    shot(s, \"12-compacted\")\n\n    # Incomplete requirements (numbered list typed with shift-less newlines via alt+enter).\n    s.send(\"Do these:\\x1b\\r1. add a README section\\x1b\\r2. add a changelog entry\", settle=0.3)\n    s.send(\"\\r\", settle=0.2)\n    wait_events(events, \"turn.result\", 6, 60, s)\n    s.wait_idle()\n    s.pump(0.4)\n    shot(s, \"14-requirements-incomplete\")\n    # Start a new objective, as an operator would before unrelated work.\n    s.send(\"/requirements clear\\r\", settle=0.3)\n    s.wait_screen(lambda lines: has(lines, \"/requirements clear\"), 10, \"the clear command\")\n    s.pump(0.6)\n    s.wait_idle()\n\n    # A verification failure: an edit, then the repository's failing test command.\n    s.send(\"Fix the parser bug.\\r\", settle=0.2)\n    wait_events(events, \"turn.result\", 7, 120, s)\n    s.wait_idle()\n    s.pump(0.4)\n    shot(s, \"13-verification-failed\")\n\n    # Slash completion and help, with a draft kept.\n    s.send(\"/re\", settle=0.4)\n    shot(s, \"15-completion\")\n    s.send(\"\\x1b\", settle=0.2)\n    s.send(\"\\x0c\", settle=0.2)  # ctrl+l clears the draft\n    s.send(\"a draft I am keeping\", settle=0.2)\n    s.send(\"\\t\", settle=0.2)  # transcript focus\n    s.send(\"[\", settle=0.3)\n    shot(s, \"16-transcript-focus\")\n    s.send(\"\\r\", settle=0.6)\n    shot(s, \"17-entry-review\")\n    # From the edit's review, `i` opens the call record itself (tool, arguments, output).\n    s.send(\"i\", settle=0.2)\n    s.wait_screen(lambda lines: has(lines, \"Tool call\") and not has(lines, \"Loading the recorded call\"), 10, \"the tool detail panel\")\n    shot(s, \"17b-tool-detail\")\n    s.send(\"\\x1b\", settle=0.3)\n    s.send(\"\\t\", settle=0.2)\n    s.send(\"\\x1b\", settle=0.2)\n    s.send(\"\\x15\", settle=0.1)  # ctrl+u: clear the line so ? opens help\n    s.send(\"?\", settle=0.4)\n    shot(s, \"18-help\")\n    s.send(\"\\x1b\", settle=0.3)\n\n    # Narrow and short windows; resize while a turn streams.\n    s.set_size(60, 24)\n    s.pump(0.5)\n    shot(s, \"19-narrow\")\n    s.set_size(80, 12)\n    s.pump(0.5)\n    shot(s, \"20-short\")\n    s.set_size(120, 36)\n    s.pump(0.4)\n    s.send(\"Stream another answer.\\r\", settle=0.1)\n    s.pump(0.6)\n    s.set_size(64, 24)\n    s.pump(0.5)\n","exit_code":0,"duration":{"secs":0,"nanos":933003115}},"started_at_ms":1792890495721,"completed_at_ms":1792890496655}}
{"timestamp":"2026-10-25T01:08:17.858Z","ordinal":316893,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17099-eb41-7490-8ebf-2ae345ae3126","call_id":"call_38f31d418f7d45e095a83b93a8033d12","output":[{"type":"input_text","text":"Script completed\nWall time 3.3 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 12885)\nTotal output lines: 1074\n\n/**\n * ACC-SAFE-03 & ACC-SAFE-08: REPL approval hardening e2e in a real pseudo-terminal (PTY).\n *\n * Verifies:\n * 1. Lone Enter at approval prompt -> DENIED (returns false, file not written)\n * 2. Keystrokes typed ahead before approval prompt -> cleared with Ctrl-U and line buffer reset, DENIED\n * 3. Paste within the 400ms grace window -> discarded, not approved\n * 4. Deliberate 'y' after 500ms -> APPROVED (action executed)\n * 5. 'a' (always allow session) requires explicit confirmation typing 'all';\n *    unconfirmed cancels and reprompts, confirmed switches session to auto-approve.\n */\n\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, makeRepo, makeHome, trustWorkspace, Reply, ptyTest } from \"./helpers/fixtures.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"..\");\nconst INDEX = path.join(ROOT, \"dist/index.js\");\nconst DRIVER = path.join(here, \"helpers/repl_approval_driver.py\");\n\nfunction script(_n: number, body: any): Reply {\n  const messages: any[] = body?.messages ?? [];\n  let lastUserIdx = -1;\n  let filename = \"target.txt\";\n\n  for (let i = messages.length - 1; i >= 0; i--) {\n    if (messages[i].role === \"user\") {\n      lastUserIdx = i;\n      const text = typeof messages[i].content === \"string\" ? messages[i].content : \"\";\n      const m = text.match(/create\\s+([a-zA-Z0-9_\\-\\.]+)/i);\n      if (m) filename = m[1];\n      break;\n    }\n  }\n\n  const toolsSinceUser = lastUserIdx >= 0\n    ? messages.slice(lastUserIdx).filter((m) => m.role === \"tool\").length\n    : 0;\n\n  if (toolsSinceUser === 0) {\n    return {\n      kind: \"tools\",\n      calls: [{ name: \"write_file\", args: { path: filename, content: `content for ${filename}\\n` } }],\n      delayMs: 500, // delay allows typed-ahead input to land mid-turn\n    };\n  }\n  return { kind: \"text\", content: `Finished handling ${filename}.` };\n}\n\nasync function runScenario(scenario: string): Promise<any> {\n  const repo = makeRepo();\n  const home = makeHome();\n  trustWorkspace(home, repo);\n  const gw = await startGateway(script);\n  const plan = {\n    node: process.execPath,\n    index: INDEX,\n    args: [\"repl\", \"--approve\", \"-w\", repo, \"-e\", gw.url, \"-m\", \"m\"],\n    ws: repo,\n    home,\n    scenario,\n    env: {\n      HOME: home,\n      NEXUS_DEBUG: \"0\",\n    },\n  };\n  const planFile = path.join(home, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n\n  let driverShutdownConfirmed = false;\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [DRIVER, planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    // The driver exits successfully only after its finally block confirms that\n    // the PTY process group has stopped. Preserve the fixture on every other\n    // exit so a surviving child cannot write into a HOME being removed here.\n    driverShutdownConfirmed = code === 0;\n    assert.equal(code, 0, `driver failed for scenario '${scenario}':\\n${err}\\n${out}`);\n    const lastLine = out.trim().split(\"\\n\").pop() || \"{}\";\n    return JSON.parse(lastLine);\n  } finally {\n    await gw.close();\n    if (driverShutdownConfirmed) {\n      fs.rmSync(repo, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n    }\n  }\n}\n\nptyTest(\"REPL approval hardening (ACC-SAFE-03): lone Enter, typed-ahead, paste, deliberate approval, and session confirmation\", { timeout: 180_000 }, async () => {\n  assert.ok(fs.existsSync(INDEX), `missing ${INDEX} (run npm run build)`);\n  assert.ok(fs.existsSync(DRIVER), `missing ${DRIVER}`);\n\n  // 1. Lone Enter -> DENIED\n  const r1 = await runScenario(\"lone_enter\");\n  assert.equal(r1.file_created, false, \"lone Enter must NOT approve the action\");\n  assert.equal(r1.passed, true);\n\n  // 2. Typed ahead mid-turn -> DISCARDED & DENIED\n  const r2 = await runScenario(\"typed_ahead\");\n  assert.equal(r2.file_created, false, \"typed-ahead input must be discarded and NOT approve\");\n  assert.equal(r2.passed, true);\n\n  // 3. Paste during grace window -> DISCARDED & NOT APPROVED\n  const r3 = await runScenario(\"paste\");\n  assert.equal(r3.created_during_grace, false, \"burst/paste during grace window must NOT approve\");\n  assert.equal(r3.created_after_deny, false);\n  assert.equal(r3.passed, true);\n\n  // 4. Deliberate 'y' after grace window -> APPROVED\n  const r4 = await runScenario(\"deliberate\");\n  assert.equal(r4.file_created, true, \"deliberate 'y' after grace window MUST approve\");\n  assert.equal(r4.passed, true);\n\n  // 5. 'a' confirmation: unconfirmed cancels, 'all' enables auto-mode\n  const r5 = await runScenario(\"confirm_a\");\n  assert.equal(r5.auto1_cancelled, true, \"unconfirmed 'a' must cancel auto-approval\");\n  assert.equal(r5.auto1_created, true, \"confirmed 'a' with 'all' must approve initial action\");\n  assert.equal(r5.auto2_created, true, \"subsequent actions must run in auto mode without prompt\");\n  assert.equal(r5.passed, true);\n});\n/**\n * Approval input safety through the real TUI and sidecar in a pseudo-terminal (review mode): keys queued while the\n * panel was not yet on screen, a delayed burst, and a bracketed paste never decide an approval; one deliberate key\n * does. See helpers/tui_approval_driver.py for the sequence.\n */\n\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, makeRepo, makeHome, Reply, ptyTest } from \"./helpers/fixtures.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"../..\");\nconst TUI = path.join(ROOT, \"core/target/release/nexus-tui\");\nconst SIDECAR = path.join(ROOT, \"cli/dist/sidecar.js\");\n\nfunction script(_n: number, body: any): Reply {\n  const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n  if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"first.txt\", content: \"one\\n\" } }], delayMs: 800 };\n  if (tools === 1) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"second.txt\", content: \"two\\n\" } }] };\n  // The third approval appears while the operator is still typing.\n  if (tools === 2) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"third.txt\", content: \"three\\n\" } }], delayMs: 1200 };\n  return { kind: \"text\", content: \"Done.\" };\n}\n\nptyTest(\"queued keys, bursts and pastes never answer an approval; one deliberate key does\", { timeout: 120_000 }, async () => {\n  for (const p of [TUI, SIDECAR]) assert.ok(fs.existsSync(p), `missing ${p} (run make build)`);\n  const gw = await startGateway(script);\n  const repo = makeRepo();\n  const home = makeHome();\n  const logs = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-tui-approval-\"));\n  const plan = {\n    tui: TUI,\n    recorder: path.join(here, \"helpers/sidecar_recorder.mjs\"),\n    node: process.execPath,\n    sidecar_args: [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\", \"--approve\"],\n    env: {\n      HOME: home,\n      TERM: \"xterm-256color\",\n      COLORTERM: \"truecolor\",\n      NEXUS_DEBUG: \"0\",\n      NEXUS_RECORD_SIDECAR: SIDECAR,\n      NEXUS_RECORD_COMMANDS: path.join(logs, \"commands.ndjson\"),\n      NEXUS_RECORD_EVENTS: path.join(logs, \"events.ndjson\"),\n    },\n  };\n  const planFile = path.join(logs, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [path.join(here, \"helpers/tui_approval_driver.py\"), planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    assert.equal(code, 0, `driver failed:\\n${err}\\n${out.slice(-2000)}`);\n    const r = JSON.parse(out.trim().split(\"\\n\").pop()!);\n    assert.ok(r.approval_arrived_while_frozen, \"the approval arrived while the TUI was frozen\");\n    assert.deepEqual(r.after_queued_keys, { decisions: [], panel_open: true }, \"keys queued before the panel was on screen did not decide\");\n    assert.deepEqual(r.after_burst, { decisions: [], panel_open: true }, \"a burst did not decide\");\n    assert.deepEqual(r.after_paste, { decisions: [], panel_open: true }, \"a paste did not decide\");\n    assert.deepEqual(r.n_after_typing, [], \"after typing into the panel, a letter is text\");\n    assert.deepEqual(r.after_deny, [\"deny\"], \"Esc denied\");\n    assert.deepEqual(r.after_approve, [\"deny\", \"approve\"], \"one deliberate key approved\");\n    assert.deepEqual(r.after_typing_across, { decisions: [\"deny\", \"approve\"], panel_open: true }, \"typing across the panel's appearance decided nothing\");\n    assert.deepEqual(r.n_after_typing_across, [\"deny\", \"approve\"], \"after typing across the panel, a letter is text even after a pause\");\n    assert.deepEqual(r.after_typing_then_deny, [\"deny\", \"approve\", \"deny\"], \"Esc then denies\");\n    assert.ok(!fs.existsSync(path.join(repo, \"third.txt\")), \"the write proposed during typing did not happen\");\n    // Input typed into the frozen terminal is either discarded (the approval event reached the TUI first) or, when it\n    // is read before the event (the sidecar reader thread was frozen too), goes where typing goes while the agent\n    // works: steering, shown in the transcript. Either way it never decides.\n    const commands = fs.readFileSync(plan.env.NEXUS_RECORD_COMMANDS, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    assert.ok(commands.filter((c) => c.type === \"steer\").every((c) => c.text === \"y\"), JSON.stringify(commands));\n    assert.deepEqual(commands.filter((c) => c.type === \"approve\" || c.type === \"deny\").map((c) => c.id), [\"approval-1\", \"approval-2\", \"approval-3\"]);\n    assert.ok(!fs.existsSync(path.join(repo, \"first.txt\")), \"the denied write did not happen\");\n    assert.equal(fs.readFileSync(path.join(repo, \"second.txt\"), \"utf8\"), \"two\\n\", \"the approved write happened\");\n  } finally {\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(home, { recursive: true, force: true });\n  }\n});\n\nfunction typingScript(_n: number, body: any): Reply {\n  const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n  if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"first.txt\", content: \"one\\n\" } }], delayMs: 1200 };\n  return { kind: \"text\", content: \"Done.\" };\n}\n\nptyTest(\"typing with thinking pauses and a final Enter across the approval panel never decides; Esc then denies\", { timeout: 120_000 }, async () => {\n  const gw = await startGateway(typingScript);\n  const repo = makeRepo();\n  const home = makeHome();\n  const logs = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-tui-approval-typing-\"));\n  const plan = {\n    tui: TUI,\n    recorder: path.join(here, \"helpers/sidecar_recorder.mjs\"),\n    node: process.execPath,\n    sidecar_args: [\"-w\", repo, \"-e\", gw.url, \"-m\", \"m\", \"--approve\"],\n    env: {\n      HOME: home,\n      TERM: \"xterm-256color\",\n      COLORTERM: \"truecolor\",\n      NEXUS_DEBUG: \"0\",\n      NEXUS_RECORD_SIDECAR: SIDECAR,\n      NEXUS_RECORD_COMMANDS: path.join(logs, \"commands.ndjson\"),\n      NEXUS_RECORD_EVENTS: path.join(logs, \"events.ndjson\"),\n    },\n  };\n  const planFile = path.join(logs, \"plan.json\");\n  fs.writeFileSync(planFile, JSON.stringify(plan));\n  try {\n    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n      const child = spawn(\"python3\", [path.join(here, \"helpers/tui_approval_typing_driver.py\"), planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n      let out = \"\";\n      let err = \"\";\n      child.stdout.on(\"data\", (c) => (out += c));\n      child.stderr.on(\"data\", (c) => (err += c));\n      child.on(\"close\", (c) => resolve({ code: c, out, err }));\n    });\n    assert.equal(code, 0, `driver failed:\\n${err}\\n${out.slice(-2000)}`);\n    const r = JSON.parse(out.trim().split(\"\\n\").pop()!);\n    assert.ok(r.approval_arrived && r.panel_seen_while_typing, JSON.stringify(r));\n    assert.deepEqual(r.after_typing, { decisions: [], panel_open: true }, \"typing with pauses decided nothing\");\n    assert.match(r.hint, /typing ignored/, \"the panel says letters are not answers now\");\n    assert.deepEqual(r.after_editing_keys, { decisions: [], panel_open: true }, \"→ → Enter, Ctrl+A Enter, and → → (pause) Enter (pause) Enter decided nothing\");\n    assert.deepEqual(r.after_esc, [\"deny\"], \"a deliberate Esc denies\");\n    const events = fs.readFileSync(plan.env.NEXUS_RECORD_EVENTS, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    assert.ok(events.filter((e) => e.type === \"session.state\").every((e) => e.mode === \"review\"), \"review mode was never switched off\");\n    assert.ok(!fs.existsSync(path.join(repo, \"first.txt\")), \"nothing was written\");\n  } finally {\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(home, { recursive: true, force: true });\n  }\n});\n/**\n * The whole live TUI (`nexus-tui --live` + the real sidecar) through a pseudo-terminal, beyond diffs: startup,\n * streamed Markdown, slow inference, tool success/failure, large command output, an edit, steering, a multi-line\n * paste, an approval with buffered keys, cancellation, compaction, a verification failure, incomplete requirements,\n * scroll preservation, completion, help, detail panels, narrow/short windows and resizing during work, a sidecar\n * crash and restart, and resume. Evidence is kept on an evidence run (NEXUS_E2E_EVIDENCE=1).\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execFileSync, spawn } from \"node:child_process\";\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, makeRepo, makeHome, Reply, ptyTest } from \"./helpers/fixtures.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst ROOT = path.resolve(here, \"../..\");\nconst TUI = path.join(ROOT, \"core/target/release/nexus-tui\");\nconst SIDECAR = path.join(ROOT, \"cli/dist/sidecar.js\");\nconst RECORDER = path.join(here, \"helpers/sidecar_recorder.mjs\");\nconst DRIVER = path.join(here, \"helpers/tui_surface_driver.py\");\nconst EVIDENCE = process.env.NEXUS_E2E_EVIDENCE === \"1\" ? path.join(ROOT, \"docs/reviews/evidence/tui_surface\") : fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-surface-evidence-\"));\nconst sha256 = (file: string) => createHash(\"sha256\").update(fs.readFileSync(file)).digest(\"hex\");\n\nexport const MARKDOWN = [\n  \"## Cache layer plan\\n\\n\",\n  \"The cache sits **between** the loader and the store, so reads stay fast while writes remain \",\n  \"authoritative. It keeps the existing `Loader` interface.\\n\\n\",\n  \"### Steps\\n\\n\",\n  \"1. Add `src/cache.ts` with an LRU map.\\n\",\n  \"2. Route `load()` through it.\\n\",\n  \"3. Invalidate on write.\\n\\n\",\n  \"- Reads: O(1)\\n- Writes: unchanged\\n  - nested detail\\n\\n\",\n  \"```ts\\nexport class Cache<K, V> {\\n\\tprivate map = new Map<K, V>();\\n\\tget(key: K): V | undefined {\\n\\t\\treturn this.map.get(key); // a long trailing comment that runs well past the width of a narrow terminal window\\n\\t}\\n}\\n```\\n\\n\",\n  \"| Option | Default | Note |\\n|---|---|---|\\n| size | 512 | entries |\\n| ttl | 60 s | per entry |\\n\\n\",\n  \"Emoji and marks: ✅ café naïve 字符 — done.\",\n];\n\n/** The prompt of the current turn…4885 tokens truncated…  url: `http://127.0.0.1:${port}/v1`,\n    requests,\n    tokenizeRequests,\n    get modelRequests() {\n      return modelRequests;\n    },\n    authSeen,\n    close: async () => {\n      for (const s of sockets) s.destroy();\n      await new Promise<void>((resolve) => server.close(() => resolve()));\n    },\n  };\n}\n\n/** Temporary git repository with one committed file. */\nexport function makeRepo(files: Record<string, string> = {}): string {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-sidecar-\"));\n  fs.writeFileSync(path.join(repo, \"base.txt\"), \"base\\n\");\n  for (const [name, content] of Object.entries(files)) {\n    const full = path.join(repo, name);\n    fs.mkdirSync(path.dirname(full), { recursive: true });\n    fs.writeFileSync(full, content);\n  }\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm base\", { cwd: repo, stdio: \"ignore\" });\n  return repo;\n}\n\nexport function makeHome(): string {\n  return fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-home-\"));\n}\n\n/** Seed an isolated HOME with explicit trust for a PTY test that needs to reach the REPL. */\nexport function trustWorkspace(home: string, workspace: string): void {\n  const trustDir = path.join(home, \".config\", \"nexus\");\n  fs.mkdirSync(trustDir, { recursive: true, mode: 0o700 });\n  fs.writeFileSync(\n    path.join(trustDir, \"trusted_workspaces.json\"),\n    JSON.stringify({ trustedPaths: [fs.realpathSync(workspace)] }, null, 2),\n    { mode: 0o600 },\n  );\n}\n\nexport async function waitUntil(cond: () => boolean, timeoutMs = 10000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (!cond()) {\n    if (Date.now() > deadline) throw new Error(\"timed out\");\n    await new Promise((r) => setTimeout(r, 10));\n  }\n}\n\nexport async function waitForEvent(events: any[], pred: (e: any) => boolean, timeoutMs = 10000): Promise<any> {\n  try {\n    await waitUntil(() => events.some(pred), timeoutMs);\n  } catch {\n    throw new Error(`timed out waiting for event; saw: ${events.map((e) => e.type).join(\", \")}`);\n  }\n  return events.find(pred);\n}\n\n/**\n * Pseudo-terminal scenarios measure timing (spinner frames, idle redraws, approval grace) and drive real processes;\n * run concurrently by the test runner they starve each other and keys arrive late. `ptyTest` holds a cross-process\n * lock (a directory under the system temp dir, taken over when its owner is gone) so they run one at a time.\n */\nexport async function acquirePtyLock(timeoutMs = 15 * 60_000): Promise<() => void> {\n  const dir = path.join(os.tmpdir(), \"nexus-pty-test.lock\");\n  const owner = path.join(dir, \"pid\");\n  const deadline = Date.now() + timeoutMs;\n  for (;;) {\n    try {\n      fs.mkdirSync(dir);\n      fs.writeFileSync(owner, String(process.pid));\n#!/usr/bin/env python3\n\"\"\"Approval input safety driver for the REPL (ACC-SAFE-03).\nRuns node repl in a pseudo-terminal (PTY) and tests:\n1. Lone Enter at approval prompt -> DENIED\n2. Keystrokes typed ahead before approval prompt -> DISCARDED / DENIED\n3. Paste within the 400ms grace window -> DISCARDED / DENIED\n4. Deliberate 'y' after 500ms grace window -> APPROVED\n5. Always allow ('a') requires explicit 'all' confirmation; unconfirmed cancels, confirmed enables auto-mode.\n\nUsage: repl_approval_driver.py PLAN.json\n\"\"\"\nimport fcntl\nimport json\nimport os\nimport pty\nimport re\nimport select\nimport signal\nimport struct\nimport sys\nimport termios\nimport time\n\nCSI = re.compile(r\"\\x1b\\[[0-9;?<>=]*[ -/]*[@-~]|\\x1b\\][^\\x07\\x1b]*(?:\\x07|\\x1b\\\\)|\\x1b[()][0-9A-Za-z]|\\x1b[=>78]\")\n\n\nclass ReplSession:\n    def __init__(self, argv, env, cwd, cols=100, rows=30):\n        self.cols, self.rows = cols, rows\n        self.pid, self.fd = pty.fork()\n        self.reaped = False\n        if self.pid == 0:\n            os.chdir(cwd)\n            os.execvpe(argv[0], argv, env)\n        self.out = \"\"\n        self.raw = b\"\"\n        fcntl.ioctl(self.fd, termios.TIOCSWINSZ, struct.pack(\"HHHH\", rows, cols, 0, 0))\n\n    def pump(self, seconds=0.2):\n        deadline = time.monotonic() + seconds\n        got = b\"\"\n        while True:\n            left = deadline - time.monotonic()\n            if left <= 0:\n                break\n            ready, _, _ = select.select([self.fd], [], [], left)\n            if not ready:\n                continue\n            try:\n                chunk = os.read(self.fd, 65536)\n            except OSError:\n                break\n            if not chunk:\n                break\n            got += chunk\n        if got:\n            self.raw += got\n            self.out += got.decode(\"utf-8\", \"replace\")\n        return got\n\n    def clean_text(self):\n        return CSI.sub(\"\", self.out)\n\n    def wait_text(self, text, timeout=25):\n        deadline = time.monotonic() + timeout\n        while text not in self.clean_text():\n            if time.monotonic() > deadline:\n                raise TimeoutError(f\"never saw {text!r}; clean text:\\n{self.clean_text()[-1000:]}\")\n            self.pump(0.05)\n\n    def send(self, data: bytes, settle=0.1):\n        os.write(self.fd, data)\n        if settle > 0:\n            self.pump(settle)\n\n    def close(self):\n        try:\n            # pty.fork makes the child a session/process-group leader. Stop the\n            # whole REPL tree so a sidecar cannot keep writing session state\n            # while the parent test removes its temporary HOME.\n            try:\n                os.killpg(self.pid, signal.SIGTERM)\n            except ProcessLookupError:\n                pass\n\n            if not self._wait_for_group_exit(10.0):\n                try:\n                    os.killpg(self.pid, signal.SIGKILL)\n                except ProcessLookupError:\n                    pass\n                if not self._wait_for_group_exit(5.0):\n                    raise RuntimeError(f\"REPL process group {self.pid} did not exit after SIGKILL\")\n        finally:\n            try:\n                os.close(self.fd)\n            except OSError:\n                pass\n\n    def _wait_for_group_exit(self, timeout):\n        deadline = time.monotonic() + timeout\n        while True:\n            if not self.reaped:\n                try:\n                    pid, _ = os.waitpid(self.pid, os.WNOHANG)\n                    self.reaped = pid == self.pid\n                except ChildProcessError:\n                    self.reaped = True\n\n            group_alive = False\n            try:\n                os.killpg(self.pid, 0)\n                group_alive = True\n            except ProcessLookupError:\n                pass\n            except PermissionError:\n                group_alive = True\n\n            if self.reaped and not group_alive:\n                return True\n            if time.monotonic() >= deadline:\n                return False\n            time.sleep(0.05)\n\n\ndef main():\n    if len(sys.argv) < 2:\n        print(\"Usage: repl_approval_driver.py PLAN.json\", file=sys.stderr)\n        sys.exit(1)\n\n    plan = json.load(open(sys.argv[1]))\n    argv = [plan[\"node\"], plan[\"index\"]] + plan[\"args\"]\n    env = {\n        **os.environ,\n        **plan.get(\"env\", {}),\n        \"TERM\": \"xterm-256color\",\n        \"COLORTERM\": \"truecolor\",\n        \"LANG\": \"C.UTF-8\",\n    }\n    ws = plan[\"ws\"]\n    scenario = plan.get(\"scenario\", \"lone_enter\")\n\n    s = ReplSession(argv, env, ws)\n    result = {}\n\n    try:\n        s.wait_text(\"❯\", timeout=25)\n\n        if scenario == \"lone_enter\":\n            s.send(b\"create lone_enter.txt\\r\", settle=0.3)\n            s.wait_text(\"[y/N/d/a]\", timeout=20)\n            # Lone Enter at prompt\n            s.send(b\"\\r\", settle=2.5)\n            created = os.path.exists(os.path.join(ws, \"lone_enter.txt\"))\n            result = {\n                \"scenario\": scenario,\n                \"file_created\": created,\n                \"passed\": not created,\n            }\n\n        elif scenario == \"typed_ahead\":\n            s.send(b\"create typed_ahead.txt\\r\", settle=0.2)\n            # Send 'y\\r' mid-turn while model is processing, before approval prompt appears\n            s.send(b\"y\\r\", settle=0.4)\n            s.wait_text(\"[y/N/d/a]\", timeout=20)\n            # The typed ahead 'y\\r' must have been cleared / discarded; send Enter\n            s.send(b\"\\r\", settle=2.5)\n            created = os.path.exists(os.path.join(ws, \"typed_ahead.txt\"))\n            result = {\n                \"scenario\": scenario,\n                \"file_created\": created,\n                \"passed\": not created,\n            }\n\n        elif scenario == \"paste\":\n            s.send(b\"create paste.txt\\r\", settle=0.3)\n            s.wait_text(\"[y/N/d/a]\", timeout=20)\n            # Immediately send burst / paste during grace window (<400ms)\n            s.send(b\"y\\r\", settle=1.2)\n            created_during_grace = os.path.exists(os.path.join(ws, \"paste.txt\"))\n            # Settle and deny with 'n'\n#!/usr/bin/env python3\n\"\"\"Drives the real `nexus-tui --live` (with the real sidecar) through the whole interface, not only diffs: startup,\nstreamed Markdown, slow inference, tool success and failure, large command output, an edit, steering, a multi-line\npaste, an approval in review mode (with buffered keys), cancellation, compaction, a verification failure, incomplete\nrequirements, scroll preservation while output arrives, slash completion and help, narrow and short windows with\nresizing during work, a sidecar crash and restart, and resuming the saved session.\n\nIt captures named screens (cells with colours, rendered to PNG by render_screens.py) and prints a JSON summary; the\nnode test (tui_surface_e2e.test.ts) owns the mock gateway and asserts on the summary and the sidecar logs.\n\nUsage: tui_surface_driver.py PLAN.json\n\"\"\"\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport time\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom tui_diff_driver import DiffSession, has  # noqa: E402\nfrom tui_pty_driver import T0, count_events, pty_env, wait_events  # noqa: E402\n\n\ndef children(pid):\n    try:\n        out = subprocess.run([\"pgrep\", \"-P\", str(pid)], capture_output=True, text=True).stdout\n        return [int(p) for p in out.split()]\n    except Exception:\n        return []\n\n\ndef main():\n    plan = json.load(open(sys.argv[1]))\n    env = pty_env(plan[\"env\"])\n    events = plan[\"env\"][\"NEXUS_RECORD_EVENTS\"]\n    cast, shots, result = [], [], {}\n    argv = [plan[\"tui\"], \"--live\", \"--sidecar\", plan[\"recorder\"], \"--node\", plan[\"node\"], \"--\"] + plan[\"sidecar_args\"]\n    turns = lambda: count_events(events, \"turn.result\")  # noqa: E731\n\n    def shot(session, name):\n        shots.append(session.color.snapshot(name))\n        result.setdefault(\"screens\", {})[name] = session.color.lines()\n\n    s = DiffSession(argv, env, 120, 36, cast)\n    s.wait_text(\"enter send\", 30)\n    s.pump(0.4)\n    shot(s, \"01-startup\")\n\n    # Streamed Markdown; scroll back while it streams, then return.\n    s.send(\"Explain the plan for the cache layer.\\r\", settle=0.1)\n    s.wait_screen(lambda lines: has(lines, \"Cache layer plan\"), 15, \"streamed heading\")\n    s.pump(0.6)\n    shot(s, \"02-streaming\")\n    wait_events(events, \"turn.result\", 1, 30, s)\n    s.wait_idle()\n    s.pump(0.3)\n    shot(s, \"03-markdown-final\")\n\n    # Slow inference, then tools: read, failed read, large command output, an edit; steering while busy.\n    s.send(\"Inspect the repository and add the cache module.\\r\", settle=0.1)\n    s.pump(1.2)\n    shot(s, \"04-slow-inference\")\n    s.send(\"prefer an LRU policy\\r\", settle=0.2)\n    s.pump(0.3)\n    shot(s, \"05-steering-queued\")\n    # Scroll back while output keeps arriving.\n    s.send(\"\\x1b[5~\", settle=0.3)\n    before_scroll = s.color.lines()[1:-3]\n    wait_events(events, \"tool.end\", 3, 30, s)\n    s.pump(0.5)\n    result[\"scroll_kept\"] = s.color.lines()[1:-3] == before_scroll\n    shot(s, \"06-scrolled-back-new-output\")\n    s.send(\"\\x1b[6~\" * 8, settle=0.3)\n    wait_events(events, \"turn.result\", 2, 60, s)\n    s.wait_idle()\n    s.pump(0.3)\n    shot(s, \"07-tools-final\")\n\n    # A multi-line paste, inspected, then sent.\n    s.send(\"\\x1b[200~line one of the note\\r\\n\\tindented line ✓ 字\\r\\nline three\\x1b[201~\", settle=0.4)\n    shot(s, \"08-paste-buffer\")\n    s.send(\"\\x0f\", settle=0.4)  # ctrl+o\n    shot(s, \"09-paste-view\")\n    s.send(\"\\x1b\", settle=0.3)\n    s.send(\"\\r\", settle=0.2)\n    wait_events(events, \"turn.result\", 3, 30, s)\n    s.wait_idle()\n\n    # Review mode: an approval; keys typed just before it opens must not answer it.\n    s.send(\"/mode review\\r\", settle=0.5)\n    s.send(\"Write the config file.\\r\", settle=0.05)\n    s.send(\"yyy\", settle=0.05)\n    s.wait_screen(lambda lines: has(lines, \"Approval needed\"), 20, \"the approval modal\")\n    s.pump(0.9)  # a pause in typing before the deliberate decision\n    shot(s, \"10-approval\")\n    result[\"approval_survived_buffered_keys\"] = has(s.color.lines(), \"Approval needed\")\n    # Keys were typed just before it opened, so its letters are not answers: ← selects Approve, Enter confirms.\n    result[\"letters_disarmed_hint\"] = any(\"typing ignored\" in l for l in s.color.lines())\n    s.send(\"\\x1b[D\", settle=2.2)  # on a typed-into panel the choice stays on screen 2 s before Enter takes it\n    s.send(\"\\r\", settle=0.6)  # where letters are off, approving takes Enter twice\n    s.send(\"\\r\", settle=0.4)\n    wait_events(events, \"turn.result\", 4, 30, s)\n    s.wait_idle()\n    result[\"draft_after_approval\"] = s.color.lines()[-1]\n    s.send(\"\\x0c\", settle=0.2)  # the buffered keys stayed in the draft: clear it\n    s.send(\"/mode auto\\r\", settle=0.5)\n\n    # Cancellation during a slow step.\n    s.send(\"Take a long time on this.\\r\", settle=0.1)\n    s.pump(1.5)\n    s.send(\"\\x1b\", settle=0.1)\n    wait_events(events, \"turn.result\", 5, 30, s)\n    s.wait_idle()\n    s.pump(0.3)\n    shot(s, \"11-cancelled\")\n\n    # Compaction.\n    s.send(\"/compact\\r\", settle=0.3)\n    s.wait_screen(lambda lines: has(lines, \"ompact\"), 20, \"compaction output\")\n    s.pump(0.6)\n    s.wait_idle()\n    shot(s, \"12-compacted\")\n\n    # Incomplete requirements (numbered list typed with shift-less newlines via alt+enter).\n    s.send(\"Do these:\\x1b\\r1. add a README section\\x1b\\r2. add a changelog entry\", settle=0.3)\n    s.send(\"\\r\", settle=0.2)\n    wait_events(events, \"turn.result\", 6, 60, s)\n    s.wait_idle()\n    s.pump(0.4)\n    shot(s, \"14-requirements-incomplete\")\n    # Start a new objective, as an operator would before unrelated work.\n    s.send(\"/requirements clear\\r\", settle=0.3)\n    s.wait_screen(lambda lines: has(lines, \"/requirements clear\"), 10, \"the clear command\")\n    s.pump(0.6)\n    s.wait_idle()\n\n    # A verification failure: an edit, then the repository's failing test command.\n    s.send(\"Fix the parser bug.\\r\", settle=0.2)\n    wait_events(events, \"turn.result\", 7, 120, s)\n    s.wait_idle()\n    s.pump(0.4)\n    shot(s, \"13-verification-failed\")\n\n    # Slash completion and help, with a draft kept.\n    s.send(\"/re\", settle=0.4)\n    shot(s, \"15-completion\")\n    s.send(\"\\x1b\", settle=0.2)\n    s.send(\"\\x0c\", settle=0.2)  # ctrl+l clears the draft\n    s.send(\"a draft I am keeping\", settle=0.2)\n    s.send(\"\\t\", settle=0.2)  # transcript focus\n    s.send(\"[\", settle=0.3)\n    shot(s, \"16-transcript-focus\")\n    s.send(\"\\r\", settle=0.6)\n    shot(s, \"17-entry-review\")\n    # From the edit's review, `i` opens the call record itself (tool, arguments, output).\n    s.send(\"i\", settle=0.2)\n    s.wait_screen(lambda lines: has(lines, \"Tool call\") and not has(lines, \"Loading the recorded call\"), 10, \"the tool detail panel\")\n    shot(s, \"17b-tool-detail\")\n    s.send(\"\\x1b\", settle=0.3)\n    s.send(\"\\t\", settle=0.2)\n    s.send(\"\\x1b\", settle=0.2)\n    s.send(\"\\x15\", settle=0.1)  # ctrl+u: clear the line so ? opens help\n    s.send(\"?\", settle=0.4)\n    shot(s, \"18-help\")\n    s.send(\"\\x1b\", settle=0.3)\n\n    # Narrow and short windows; resize while a turn streams.\n    s.set_size(60, 24)\n    s.pump(0.5)\n    shot(s, \"19-narrow\")\n    s.set_size(80, 12)\n    s.pump(0.5)\n    shot(s, \"20-short\")\n    s.set_size(120, 36)\n    s.pump(0.4)\n    s.send(\"Stream another answer.\\r\", settle=0.1)\n    s.pump(0.6)\n    s.set_size(64, 24)\n    s.pump(0.5)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17095-f2fe-7de0-b5cc-460661bc1fe3","create_time":1792890497.8579352}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
