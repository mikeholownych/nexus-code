{"timestamp":"2026-10-25T03:54:49.492Z","ordinal":323032,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a1712a-1b5f-7ee1-86db-15241cee962c","item":{"type":"CommandExecution","id":"exec-4e718835-aae9-4f15-ae64-74362b5e5824","process_id":"87363","command":["/usr/bin/zsh","-lc","wt=/home/mike/nexus-wt/git-exclude-fail-closed; echo '--- version fields at current main ---'; git -C \"$wt\" show 4e7297f:package.json | jq -r '.version'; git -C \"$wt\" show 4e7297f:cli/package.json | jq -r '.version'; git -C \"$wt\" show 4e7297f:core/Cargo.toml | rg '^version\\s*=' | head -1; echo '--- release workflow files ---'; git -C \"$wt\" ls-tree -r --name-only 4e7297f .github/workflows scripts docs/releases | rg '(release|version|package-linux|installer|rc)' | head -60; echo '--- workflow and version helper refs ---'; git -C \"$wt\" grep -n -E 'tag_name|release|npm|sync-version|v1\\.0\\.0-rc' 4e7297f -- .github/workflows/release* scripts/sync-version.mjs docs/releases 2>/dev/null | head -110; echo '--- tags ---'; git -C \"$wt\" tag --list 'v1.0.0*' --sort=-version:refname | head -10; echo '--- current package release metadata ---'; gh release view v1.0.0-rc.4 --json tagName,isPrerelease,isDraft,publishedAt,url,assets --jq '{tagName,isPrerelease,isDraft,publishedAt,url,assets:[.assets[].name]}'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"wt=/home/mike/nexus-wt/git-exclude-fail-closed; echo '--- version fields at current main ---'; git -C \"$wt\" show 4e7297f:package.json | jq -r '.version'; git -C \"$wt\" show 4e7297f:cli/package.json | jq -r '.version'; git -C \"$wt\" show 4e7297f:core/Cargo.toml | rg '^version\\s*=' | head -1; echo '--- release workflow files ---'; git -C \"$wt\" ls-tree -r --name-only 4e7297f .github/workflows scripts docs/releases | rg '(release|version|package-linux|installer|rc)' | head -60; echo '--- workflow and version helper refs ---'; git -C \"$wt\" grep -n -E 'tag_name|release|npm|sync-version|v1\\.0\\.0-rc' 4e7297f -- .github/workflows/release* scripts/sync-version.mjs docs/releases 2>/dev/null | head -110; echo '--- tags ---'; git -C \"$wt\" tag --list 'v1.0.0*' --sort=-version:refname | head -10; echo '--- current package release metadata ---'; gh release view v1.0.0-rc.4 --json tagName,isPrerelease,isDraft,publishedAt,url,assets --jq '{tagName,isPrerelease,isDraft,publishedAt,url,assets:[.assets[].name]}'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"--- version fields at current main ---\n1.0.0-rc.4\n1.0.0-rc.4\nversion = \"1.0.0-rc.4\"\n--- release workflow files ---\n.github/workflows/release.yml\ndocs/releases/PROTECTIONS.md\ndocs/releases/rulesets/protected-branches.json\ndocs/releases/rulesets/release-tags.json\ndocs/releases/v0.1.0-alpha.1.md\ndocs/releases/v0.1.0-alpha.2.md\ndocs/releases/v1.0.0-rc.1.md\ndocs/releases/v1.0.0-rc.2.md\ndocs/releases/v1.0.0-rc.3.md\ndocs/releases/v1.0.0-rc.4.md\ndocs/releases/v1.0.0.md\nscripts/check-version-only-diff.mjs\nscripts/installer-smoke.sh\nscripts/package-linux.sh\nscripts/release-tools/package-lock.json\nscripts/release-tools/package.json\nscripts/sync-version.mjs\n--- workflow and version helper refs ---\n4e7297f:.github/workflows/release.yml:31:          root=/mnt/nexus-eval-release\n4e7297f:.github/workflows/release.yml:33:          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-release \"$root\"\n4e7297f:.github/workflows/release.yml:47:          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n4e7297f:.github/workflows/release.yml:49:          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n4e7297f:.github/workflows/release.yml:51:          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n4e7297f:.github/workflows/release.yml:53:          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n4e7297f:.github/workflows/release.yml:58:          cache: npm\n4e7297f:.github/workflows/release.yml:63:          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n4e7297f:.github/workflows/release.yml:64:          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n4e7297f:.github/workflows/release.yml:65:          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n4e7297f:.github/workflows/release.yml:66:          test -f \"$npm_root/package.json\"\n4e7297f:.github/workflows/release.yml:68:          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n4e7297f:.github/workflows/release.yml:69:          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n4e7297f:.github/workflows/release.yml:70:          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n4e7297f:.github/workflows/release.yml:71:          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n4e7297f:.github/workflows/release.yml:72:          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n4e7297f:.github/workflows/release.yml:74:          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n4e7297f:.github/workflows/release.yml:80:          node scripts/sync-version.mjs --check --tag \"$GITHUB_REF_NAME\"\n4e7297f:.github/workflows/release.yml:81:          test -f \"docs/releases/${GITHUB_REF_NAME}.md\" || { echo \"Missing docs/releases/${GITHUB_REF_NAME}.md\" >&2; exit 1; }\n4e7297f:.github/workflows/release.yml:91:      - run: npm ci --prefix cli\n4e7297f:.github/workflows/release.yml:92:      - run: npm --prefix cli run build\n4e7297f:.github/workflows/release.yml:94:      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n4e7297f:.github/workflows/release.yml:95:      - run: npm --prefix cli test\n4e7297f:.github/workflows/release.yml:113:      # RC tags (vX.Y.Z-rc.N) publish a prerelease: the workflow-produced RC is the qualification candidate\n4e7297f:.github/workflows/release.yml:115:      # `gh release edit <tag> --draft=false` after the stable artifact checks and the signed acceptance disposition.\n4e7297f:.github/workflows/release.yml:116:      - uses: softprops/action-gh-release@3bb12739c298aeb8a4eeaf626c5b8d85266b0e65 # v2\n4e7297f:.github/workflows/release.yml:119:          body_path: docs/releases/${{ github.ref_name }}.md\n4e7297f:.github/workflows/release.yml:120:          prerelease: ${{ contains(github.ref_name, '-') }}\n4e7297f:docs/releases/PROTECTIONS.md:1:# Repository protections for the v1 release\n4e7297f:docs/releases/PROTECTIONS.md:3:The branch and release-tag rulesets below were observed active through the GitHub API on 2026-10-18.\n4e7297f:docs/releases/PROTECTIONS.md:12:| Rulesets | Active `v1-protected-branches` (25340146) and `v1-immutable-release-tags` (25340148) |\n4e7297f:docs/releases/PROTECTIONS.md:14:| Default workflow token | `read`; workflows request extra permissions themselves (`release.yml`: `contents`, `id-token`, `attestations` write) |\n4e7297f:docs/releases/PROTECTIONS.md:21:enforce what GitHub *can* check: required CI, no history rewriting, and immutable release tags.\n4e7297f:docs/releases/PROTECTIONS.md:35:`rulesets/release-tags.json` covers `refs/tags/v*`:\n4e7297f:docs/releases/PROTECTIONS.md:43:   commit `M`. The RC tag `v1.0.0-rc.N` goes on `M`, which is on `main`, so `release.yml`'s ancestry check passes.\n4e7297f:docs/releases/PROTECTIONS.md:48:   keeps `S` in `main`'s history. Tag `v1.0.0` goes on `S`. `release.yml` verifies it is version-only on `rc.N`.\n4e7297f:docs/releases/PROTECTIONS.md:53:4. **Publication.** `release.yml` creates the stable release as a draft. `gh release edit v1.0.0 --draft=false` is not\n4e7297f:docs/releases/PROTECTIONS.md:61:  release's assets cannot be replaced.\n4e7297f:docs/releases/PROTECTIONS.md:70:         docs/releases/rulesets/protected-branches.json)\n4e7297f:docs/releases/PROTECTIONS.md:71:gh api -X POST \"$R/rulesets\" --input docs/releases/rulesets/protected-branches.json\n4e7297f:docs/releases/PROTECTIONS.md:72:gh api -X POST \"$R/rulesets\" --input docs/releases/rulesets/release-tags.json\n4e7297f:docs/releases/rulesets/release-tags.json:2:  \"name\": \"v1-immutable-release-tags\",\n4e7297f:docs/releases/v0.1.0-alpha.1.md:1:# Nexus Code v0.1.0-alpha.1 alpha release\n4e7297f:docs/releases/v0.1.0-alpha.1.md:3:**Maturity:** alpha, pre-1.0 SemVer prerelease.\n4e7297f:docs/releases/v0.1.0-alpha.1.md:5:**Status:** published as a GitHub prerelease on 2026-10-13 (release workflow run 38459471967); assets verified against `SHA256SUMS`. Superseded by [v0.1.0-alpha.2](v0.1.0-alpha.2.md).\n4e7297f:docs/releases/v0.1.0-alpha.1.md:7:This initial 0.x release uses an alpha prerelease identifier to show that the client is still in early development. It is not the latest stable version; install it by pinning `NEXUS_VERSION=v0.1.0-alpha.1`.\n4e7297f:docs/releases/v0.1.0-alpha.1.md:24:The release workflow builds the versioned archive and checksum from a matching `v0.1.0-alpha.1` tag. The published assets match these names, and the archive verifies against the published `SHA256SUMS`.\n4e7297f:docs/releases/v0.1.0-alpha.2.md:1:# Nexus Code v0.1.0-alpha.2 alpha release\n4e7297f:docs/releases/v0.1.0-alpha.2.md:3:**Maturity:** alpha, pre-1.0 SemVer prerelease.\n4e7297f:docs/releases/v0.1.0-alpha.2.md:5:**Status:** published as a GitHub prerelease on 2026-10-14 (release workflow run 38539108878); assets verified against `SHA256SUMS`.\n4e7297f:docs/releases/v0.1.0-alpha.2.md:7:This is the second 0.x alpha. Like `v0.1.0-alpha.1`, it is not a stable release; install it by pinning `NEXUS_VERSION=v0.1.0-alpha.2`.\n4e7297f:docs/releases/v0.1.0-alpha.2.md:27:- `scripts/installer-smoke.sh` now derives its upgrade-test version from the version under test, instead of a fixed `v0.1.0-alpha.2` that would have collided with this release.\n4e7297f:docs/releases/v0.1.0-alpha.2.md:50:The release workflow builds the versioned archive and checksum from a matching `v0.1.0-alpha.2` tag. The published assets match these names, and the archive verifies against the published `SHA256SUMS`.\n4e7297f:docs/releases/v1.0.0-rc.1.md:1:# Nexus Code v1.0.0-rc.1 release candidate\n4e7297f:docs/releases/v1.0.0-rc.1.md:3:**Maturity:** release candidate; prerelease, not stable.\n4e7297f:docs/releases/v1.0.0-rc.1.md:11:The v1.0.0 candidate includes the product, security, continuity, provider, terminal, and packaging work accumulated since the 0.1.0 alpha releases. See the repository changelog for the implemented feature summary. Release-critical behavior remains subject to the exact-RC acceptance process in [`ACCEPTANCE.md`](../v1.0.0/ACCEPTANCE.md).\n4e7297f:docs/releases/v1.0.0-rc.1.md:16:- Node.js 20 or newer. Node.js 20 remains the v1.0.0 compatibility floor, but reached upstream end of life on 2026-04-30 per the [Node.js Release Working Group schedule](https://github.com/nodejs/Release/blob/main/README.md#release-schedule); use a maintained release such as Node.js 22 or 24 for security updates.\n4e7297f:docs/releases/v1.0.0-rc.1.md:23:The release workflow builds the version-matched archive, `SHA256SUMS`, SBOM, notices, installer, and provenance for tag `v1.0.0-rc.1`. The workflow outputs and their digests are the qualification candidate; a local build is not interchangeable.\n4e7297f:docs/releases/v1.0.0-rc.2.md:1:# Nexus Code v1.0.0-rc.2 release candidate\n4e7297f:docs/releases/v1.0.0-rc.2.md:3:**Maturity:** release candidate; prerelease, not stable.\n4e7297f:docs/releases/v1.0.0-rc.2.md:7:This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and sidecar, production Node dependencies, Rust `harness-core`, and Ratatui `nexus-tui`.\n4e7297f:docs/releases/v1.0.0-rc.2.md:20:- As tagged, this candidate declares Node.js 20 or newer. Node.js 20 reached upstream end of life on 2026-04-30, and DEC-12 now requires Node.js 22 or newer for v1.0.0, so `v1.0.0-rc.2` is not promotable to v1.0.0; a later candidate carries the Node.js 22 floor.\n4e7297f:docs/releases/v1.0.0-rc.2.md:27:The release workflow for `v1.0.0-rc.2` produces the version-matched Linux archive, `SHA256SUMS`, SBOM, notices, installer, and provenance. The workflow run, tag commit, artifact digests, and qualification evidence must be recorded before this candidate can be accepted. Local builds are not interchangeable with the workflow-produced artifacts.\n4e7297f:docs/releases/v1.0.0-rc.3.md:1:# Nexus Code v1.0.0-rc.3 release candidate\n4e7297f:docs/releases/v1.0.0-rc.3.md:3:**Maturity:** release candidate; prerelease, not stable.\n4e7297f:docs/releases/v1.0.0-rc.3.md:7:This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and sidecar, production Node dependencies, Rust `harness-core`, and Ratatui `nexus-tui`.\n4e7297f:docs/releases/v1.0.0-rc.3.md:27:The release workflow for `v1.0.0-rc.3` is expected to produce the version-matched Linux archive, `SHA256SUMS`, SBOM, notices, installer, and provenance. The workflow run, tag commit, artifact digests, and qualification evidence must be recorded before this candidate can be accepted. Local builds are not interchangeable with the workflow-produced artifacts.\n4e7297f:docs/releases/v1.0.0-rc.4.md:1:# Nexus Code v1.0.0-rc.4 release candidate\n4e7297f:docs/releases/v1.0.0-rc.4.md:3:**Maturity:** release candidate; prerelease, not stable.\n4e7297f:docs/releases/v1.0.0-rc.4.md:7:This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and sidecar, production Node dependencies, Rust `harness-core`, and Ratatui `nexus-tui`.\n4e7297f:docs/releases/v1.0.0-rc.4.md:23:- Locks the npm release tools used for notices and the SBOM, rejects deprecated packages in that lock, and adds a cross-runner workflow that rebuilds a published RC on Ubuntu 22.04 and 24.04 and compares the archive, compatibility metadata, checksums, notices, SBOM and installer with the published assets.\n4e7297f:docs/releases/v1.0.0-rc.4.md:24:- Requires the approved digest-pinned Rust builder for release packaging and reproducibility checks. Local packaging examples and cross-runner checks use the same approved builder identity; the host-build opt-out is for local development only.\n4e7297f:docs/releases/v1.0.0-rc.4.md:38:The release workflow for `v1.0.0-rc.4` is expected to produce the version-matched Linux archive, `SHA256SUMS`, SBOM, notices, installer, and provenance. The workflow run, tag commit, artifact digests, and qualification evidence must be recorded before this candidate can be accepted. Local builds are not interchangeable with the workflow-produced artifacts.\n4e7297f:docs/releases/v1.0.0.md:3:**Maturity:** Stable release (v1.0.0).\n4e7297f:docs/releases/v1.0.0.md:5:This release delivers the complete Nexus Code client architecture with comprehensive boundary hardening, process ownership, workspace trust enforcement, and egress protection.\n4e7297f:docs/releases/v1.0.0.md:21:- **Escape hatch:** For transition during pre-1.0 release evaluation, `NEXUS_LEGACY_PROJECT_ENV=1` is supported as a temporary operator override.\n4e7297f:docs/releases/v1.0.0.md:129:- **Checkout parity:** `harness.sh` is simplified to execute the Node CLI directly with `NEXUS_HOME` unset, ensuring identical grammar between development checkouts and binary release packages.\n4e7297f:docs/releases/v1.0.0.md:139:- Version numbers are synchronized from root `package.json` across CLI manifests, `core/Cargo.toml`, and the binary build identities via `scripts/sync-version.mjs`.\n4e7297f:docs/releases/v1.0.0.md:141:- CI release workflows assert version consistency across all artifacts.\n4e7297f:docs/releases/v1.0.0.md:152:- When no stable release exists, the installer queries releases and offers an actionable prerelease hint (`no stable release yet; latest prerelease is vX — rerun with NEXUS_VERSION=vX`).\n4e7297f:scripts/sync-version.mjs:3:// disagrees (run in CI and the release workflow). `--tag vX.Y.Z` additionally requires the tag to match.\n--- tags ---\nv1.0.0-rc.4\nv1.0.0-rc.3\nv1.0.0-rc.2\nv1.0.0-rc.1\n--- current package release metadata ---\n{\"assets\":[\"compatibility.json\",\"install.sh\",\"nexus-linux-x86_64-v1.0.0-rc.4.tar.gz\",\"sbom.cdx.json\",\"sbom.cdx.json.sha256\",\"sbom.json\",\"sbom.json.sha256\",\"SHA256SUMS\",\"THIRD_PARTY_NOTICES.txt\"],\"isDraft\":false,\"isPrerelease\":true,\"publishedAt\":\"2026-10-24T11:54:37Z\",\"tagName\":\"v1.0.0-rc.4\",\"url\":\"https://github.com/mikeholownych/nexus-code/releases/tag/v1.0.0-rc.4\"}\n","exit_code":0,"duration":{"secs":0,"nanos":414899500}},"started_at_ms":1792900489076,"completed_at_ms":1792900489492}}
{"timestamp":"2026-10-25T03:54:50.541Z","ordinal":323033,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17132-652d-7a70-ac73-2e70e4cc5113","call_id":"call_8002aa39022c423ca0304f4df9d1558b","output":[{"type":"input_text","text":"Script completed\nWall time 2.7 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 3543)\nTotal output lines: 111\n\n--- version fields at current main ---\n1.0.0-rc.4\n1.0.0-rc.4\nversion = \"1.0.0-rc.4\"\n--- release workflow files ---\n.github/workflows/release.yml\ndocs/releases/PROTECTIONS.md\ndocs/releases/rulesets/protected-branches.json\ndocs/releases/rulesets/release-tags.json\ndocs/releases/v0.1.0-alpha.1.md\ndocs/releases/v0.1.0-alpha.2.md\ndocs/releases/v1.0.0-rc.1.md\ndocs/releases/v1.0.0-rc.2.md\ndocs/releases/v1.0.0-rc.3.md\ndocs/releases/v1.0.0-rc.4.md\ndocs/releases/v1.0.0.md\nscripts/check-version-only-diff.mjs\nscripts/installer-smoke.sh\nscripts/package-linux.sh\nscripts/release-tools/package-lock.json\nscripts/release-tools/package.json\nscripts/sync-version.mjs\n--- workflow and version helper refs ---\n4e7297f:.github/workflows/release.yml:31:          root=/mnt/nexus-eval-release\n4e7297f:.github/workflows/release.yml:33:          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-release \"$root\"\n4e7297f:.github/workflows/release.yml:47:          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n4e7297f:.github/workflows/release.yml:49:          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n4e7297f:.github/workflows/release.yml:51:          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n4e7297f:.github/workflows/release.yml:53:          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n4e7297f:.github/workflows/release.yml:58:          cache: npm\n4e7297f:.github/workflows/release.yml:63:          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n4e7297f:.github/workflows/release.yml:64:          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n4e7297f:.github/workflows/release.yml:65:          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n4e7297f:.github/workflows/release.yml:66:          test -f \"$npm_root/package.json\"\n4e7297f:.github/workflows/release.yml:68:          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n4e7297f:.github/workflows/release.yml:69:          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n4e7297f:.github/workflows/release.yml:70:          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n4e7297f:.github/workflows/release.yml:71:          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n4e7297f:.github/workflows/release.yml:72:          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n4e7297f:.github/workflows/release.yml:74:          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n4e7297f:.github/workflows/release.yml:80:          node scripts/sync-version.mjs --check --tag \"$GITHUB_REF_NAME\"\n4e7297f:.github/workflows/release.yml:81:          test -f \"docs/releases/${GITHUB_REF_NAME}.md\" || { echo \"Missing docs/releases/${GITHUB_REF_NAME}.md\" >&2; exit 1; }\n4e7297f:.github/workflows/release.yml:91:      - run: npm ci --prefix cli\n4e7297f:.github/workflows/release.yml:92:      - run: npm --prefix cli run build\n4e7297f:.github/workflows/release.yml:94:      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n4e7297f:.github/workflows/release.yml:95:      - run: npm --prefix cli test\n4e7297f:.github/workflows/release.yml:113:      # RC tags (vX.Y.Z-rc.N) publish a prerelease: the workflow-produced RC is the qualification candidate\n4e7297f:.github/workflows/release.yml:115:      # `gh release edit <tag> --draft=false` after the stable artifact checks and the signed acceptance disposition.\n4e7297f:.github/workflows/release.yml:116:      - uses: softprops/action-gh-release@3bb12739c298aeb8a4eeaf626c5b8d85266b0e65 # v2\n4e7297f:.github/workflows/release.yml:119:          body_path: docs/releases/${{ github.ref_name }}.md\n4e7297f:.github/workflows/release.yml:120:          prerelease: ${{ contains(github.ref_name, '-') }}\n4e7297f:docs/releases/PROTECTIONS.md:1:# Repository protections for the v1 release\n4e7297f:docs/releases/PROTECTIONS.md:3:The branch and release-tag rulesets below were ob…1343 tokens truncated…/v1.0.0-rc.2.md:27:The release workflow for `v1.0.0-rc.2` produces the version-matched Linux archive, `SHA256SUMS`, SBOM, notices, installer, and provenance. The workflow run, tag commit, artifact digests, and qualification evidence must be recorded before this candidate can be accepted. Local builds are not interchangeable with the workflow-produced artifacts.\n4e7297f:docs/releases/v1.0.0-rc.3.md:1:# Nexus Code v1.0.0-rc.3 release candidate\n4e7297f:docs/releases/v1.0.0-rc.3.md:3:**Maturity:** release candidate; prerelease, not stable.\n4e7297f:docs/releases/v1.0.0-rc.3.md:7:This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and sidecar, production Node dependencies, Rust `harness-core`, and Ratatui `nexus-tui`.\n4e7297f:docs/releases/v1.0.0-rc.3.md:27:The release workflow for `v1.0.0-rc.3` is expected to produce the version-matched Linux archive, `SHA256SUMS`, SBOM, notices, installer, and provenance. The workflow run, tag commit, artifact digests, and qualification evidence must be recorded before this candidate can be accepted. Local builds are not interchangeable with the workflow-produced artifacts.\n4e7297f:docs/releases/v1.0.0-rc.4.md:1:# Nexus Code v1.0.0-rc.4 release candidate\n4e7297f:docs/releases/v1.0.0-rc.4.md:3:**Maturity:** release candidate; prerelease, not stable.\n4e7297f:docs/releases/v1.0.0-rc.4.md:7:This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and sidecar, production Node dependencies, Rust `harness-core`, and Ratatui `nexus-tui`.\n4e7297f:docs/releases/v1.0.0-rc.4.md:23:- Locks the npm release tools used for notices and the SBOM, rejects deprecated packages in that lock, and adds a cross-runner workflow that rebuilds a published RC on Ubuntu 22.04 and 24.04 and compares the archive, compatibility metadata, checksums, notices, SBOM and installer with the published assets.\n4e7297f:docs/releases/v1.0.0-rc.4.md:24:- Requires the approved digest-pinned Rust builder for release packaging and reproducibility checks. Local packaging examples and cross-runner checks use the same approved builder identity; the host-build opt-out is for local development only.\n4e7297f:docs/releases/v1.0.0-rc.4.md:38:The release workflow for `v1.0.0-rc.4` is expected to produce the version-matched Linux archive, `SHA256SUMS`, SBOM, notices, installer, and provenance. The workflow run, tag commit, artifact digests, and qualification evidence must be recorded before this candidate can be accepted. Local builds are not interchangeable with the workflow-produced artifacts.\n4e7297f:docs/releases/v1.0.0.md:3:**Maturity:** Stable release (v1.0.0).\n4e7297f:docs/releases/v1.0.0.md:5:This release delivers the complete Nexus Code client architecture with comprehensive boundary hardening, process ownership, workspace trust enforcement, and egress protection.\n4e7297f:docs/releases/v1.0.0.md:21:- **Escape hatch:** For transition during pre-1.0 release evaluation, `NEXUS_LEGACY_PROJECT_ENV=1` is supported as a temporary operator override.\n4e7297f:docs/releases/v1.0.0.md:129:- **Checkout parity:** `harness.sh` is simplified to execute the Node CLI directly with `NEXUS_HOME` unset, ensuring identical grammar between development checkouts and binary release packages.\n4e7297f:docs/releases/v1.0.0.md:139:- Version numbers are synchronized from root `package.json` across CLI manifests, `core/Cargo.toml`, and the binary build identities via `scripts/sync-version.mjs`.\n4e7297f:docs/releases/v1.0.0.md:141:- CI release workflows assert version consistency across all artifacts.\n4e7297f:docs/releases/v1.0.0.md:152:- When no stable release exists, the installer queries releases and offers an actionable prerelease hint (`no stable release yet; latest prerelease is vX — rerun with NEXUS_VERSION=vX`).\n4e7297f:scripts/sync-version.mjs:3:// disagrees (run in CI and the release workflow). `--tag vX.Y.Z` additionally requires the tag to match.\n--- tags ---\nv1.0.0-rc.4\nv1.0.0-rc.3\nv1.0.0-rc.2\nv1.0.0-rc.1\n--- current package release metadata ---\n{\"assets\":[\"compatibility.json\",\"install.sh\",\"nexus-linux-x86_64-v1.0.0-rc.4.tar.gz\",\"sbom.cdx.json\",\"sbom.cdx.json.sha256\",\"sbom.json\",\"sbom.json.sha256\",\"SHA256SUMS\",\"THIRD_PARTY_NOTICES.txt\"],\"isDraft\":false,\"isPrerelease\":true,\"publishedAt\":\"2026-10-24T11:54:37Z\",\"tagName\":\"v1.0.0-rc.4\",\"url\":\"https://github.com/mikeholownych/nexus-code/releases/tag/v1.0.0-rc.4\"}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1712a-1b5f-7ee1-86db-15241cee962c","create_time":1792900490.5414217}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
