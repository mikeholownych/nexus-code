{"timestamp":"2026-10-25T04:01:26.460Z","ordinal":323259,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17136-12b9-7661-904c-f2b43120b5c8","item":{"type":"CommandExecution","id":"exec-29459f9c-3e5d-4999-a654-fdf9b605731d","process_id":"89553","command":["/usr/bin/zsh","-lc","echo '--- claim availability ---'; find \"$(git rev-parse --git-common-dir)/nexus-claims\" -maxdepth 2 -name owner.json -print0 | xargs -0 -r rg -l 'install\\.sh|installer-smoke|ACC-SUP-03|REQ-REL-109' | while read f; do echo ===$f; cat \"$f\"; done; echo '--- installer logic ---'; git show origin/main:install.sh | nl -ba | sed -n '1,120p'; echo '--- installer tests ---'; git grep -n -E 'install\\.sh|attestation' origin/main -- scripts/test scripts/terminal-acceptance cli/test 2>/dev/null | head -160; echo '--- current main checks ---'; gh run list --commit \"$(git rev-parse origin/main)\" --limit 3 --json databaseId,workflowName,status,conclusion,updatedAt --jq '.[]|{databaseId,workflowName,status,conclusion,updatedAt}'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"echo '--- claim availability ---'; find \"$(git rev-parse --git-common-dir)/nexus-claims\" -maxdepth 2 -name owner.json -print0 | xargs -0 -r rg -l 'install\\.sh|installer-smoke|ACC-SUP-03|REQ-REL-109' | while read f; do echo ===$f; cat \"$f\"; done; echo '--- installer logic ---'; git show origin/main:install.sh | nl -ba | sed -n '1,120p'; echo '--- installer tests ---'; git grep -n -E 'install\\.sh|attestation' origin/main -- scripts/test scripts/terminal-acceptance cli/test 2>/dev/null | head -160; echo '--- current main checks ---'; gh run list --commit \"$(git rev-parse origin/main)\" --limit 3 --json databaseId,workflowName,status,conclusion,updatedAt --jq '.[]|{databaseId,workflowName,status,conclusion,updatedAt}'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"--- claim availability ---\n--- installer logic ---\n     1\t#!/bin/sh\n     2\tset -eu\n     3\t\n     4\tREPO=mikeholownych/nexus-code\n     5\tBASE=${NEXUS_RELEASE_BASE_URL:-\"https://github.com/$REPO/releases\"}\n     6\tVERSION=${NEXUS_VERSION:-latest}\n     7\tPREFIX=${NEXUS_PREFIX:-\"$HOME/.local\"}\n     8\t\n     9\tfail() { printf 'nexus installer: %s\\n' \"$*\" >&2; exit 1; }\n    10\tcase \"$(uname -s):$(uname -m)\" in\n    11\t  Linux:x86_64|Linux:amd64) ;;\n    12\t  *) fail \"unsupported system $(uname -s)/$(uname -m); supported: Linux x86-64 (glibc).\" ;;\n    13\tesac\n    14\tcommand -v node >/dev/null 2>&1 || fail \"Node.js 22 or newer is required; install Node.js and retry.\"\n    15\tNODE_MAJOR=$(node -p 'Number(process.versions.node.split(\".\")[0])' 2>/dev/null || printf 0)\n    16\t[ \"$NODE_MAJOR\" -ge 22 ] || fail \"Node.js 22 or newer is required (found $(node --version 2>/dev/null || echo unknown)).\"\n    17\tcommand -v curl >/dev/null 2>&1 || fail \"curl is required.\"\n    18\tcommand -v tar >/dev/null 2>&1 || fail \"tar is required.\"\n    19\tcommand -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n    20\t\n    21\tvalidate_tag() {\n    22\t  printf '%s' \"$1\" | grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\"\n    23\t}\n    24\t\n    25\tif [ \"$VERSION\" != \"latest\" ]; then\n    26\t  validate_tag \"$VERSION\"\n    27\tfi\n    28\t\n    29\tif [ \"$VERSION\" = \"latest\" ]; then\n    30\t  API_BASE=${NEXUS_RELEASES_API:-\"https://api.github.com/repos/$REPO/releases\"}\n    31\t  API_TMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-api.XXXXXX\") || fail \"could not create temporary directory.\"\n    32\t  api_cleanup() { rm -rf \"$API_TMP\"; }\n    33\t  trap api_cleanup EXIT HUP INT TERM\n    34\t\n    35\t  LATEST_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -D \"$API_TMP/headers\" -o \"$API_TMP/latest.json\" -w \"%{http_code}\" \"$API_BASE/latest\" 2>\"$API_TMP/curl.err\" || echo \"000\")\n    36\t\n    37\t  if [ \"$LATEST_CODE\" = \"200\" ]; then\n    38\t    VERSION=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/latest.json\" | head -n 1)\n    39\t    [ -n \"$VERSION\" ] || fail \"GitHub returned no stable release tag.\"\n    40\t    validate_tag \"$VERSION\"\n    41\t  elif [ \"$LATEST_CODE\" = \"403\" ]; then\n    42\t    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \"$API_TMP/headers\" 2>/dev/null; then\n    43\t      fail \"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\"\n    44\t    fi\n    45\t    fail \"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\"\n    46\t  elif [ \"$LATEST_CODE\" = \"404\" ]; then\n    47\t    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \"$API_TMP/releases.json\" -w \"%{http_code}\" \"$API_BASE?per_page=1\" 2>/dev/null || echo \"000\")\n    48\t    if [ \"$PREREL_CODE\" = \"200\" ]; then\n    49\t      PREREL_TAG=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/releases.json\" | head -n 1)\n    50\t      if [ -n \"$PREREL_TAG\" ]; then\n    51\t        fail \"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\"\n    52\t      fi\n    53\t    fi\n    54\t    fail \"could not find latest stable release (HTTP 404 from $API_BASE/latest).\"\n    55\t  else\n    56\t    fail \"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\"\n    57\t  fi\n    58\t  rm -rf \"$API_TMP\"\n    59\t  trap - EXIT HUP INT TERM\n    60\tfi\n    61\t\n    62\tARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\n    63\tNORMALIZED_VERSION=${VERSION#v}\n    64\tURL=\"$BASE/download/$VERSION\"\n    65\tTMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-install.XXXXXX\") || fail \"could not create temporary directory.\"\n    66\tcleanup() { rm -rf \"$TMP\"; }\n    67\ttrap cleanup EXIT HUP INT TERM\n    68\tcurl -fsSL --show-error --retry 2 \"$URL/$ARCHIVE\" -o \"$TMP/$ARCHIVE\" || fail \"download failed for $ARCHIVE.\"\n    69\tcurl -fsSL --show-error --retry 2 \"$URL/SHA256SUMS\" -o \"$TMP/SHA256SUMS\" || fail \"could not download release checksums.\"\n    70\tgrep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksum entry for $ARCHIVE is missing.\"\n    71\t(cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\n    72\tARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n    73\t\n    74\tif [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" != \"0\" ] && command -v gh >/dev/null 2>&1; then\n    75\t  if gh attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n    76\t     gh attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n    77\t    printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n    78\t  elif [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" = \"1\" ]; then\n    79\t    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n    80\t  fi\n    81\tfi\n    82\t\n    83\tVERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\n    84\tBIN_DIR=\"$PREFIX/bin\"\n    85\tLINK=\"$BIN_DIR/nexus\"\n    86\tmkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\n    87\tif [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n    88\t  fail \"$LINK exists and is not a symlink; left it unchanged.\"\n    89\tfi\n    90\tif [ -L \"$LINK\" ]; then\n    91\t  OLD=$(readlink \"$LINK\")\n    92\t  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\n    93\tfi\n    94\t\n    95\tFORCE=${NEXUS_FORCE:-0}\n    96\tNEEDS_EXTRACT=1\n    97\tif [ -d \"$VERSION_DIR\" ] && [ \"$FORCE\" != \"1\" ]; then\n    98\t  if [ -x \"$VERSION_DIR/bin/nexus\" ] && \\\n    99\t     [ -x \"$VERSION_DIR/lib/core/harness-core\" ] && \\\n   100\t     [ -x \"$VERSION_DIR/lib/core/nexus-tui\" ] && \\\n   101\t     [ \"$(cat \"$VERSION_DIR/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ]; then\n   102\t    if [ -f \"$VERSION_DIR/MANIFEST.sha256\" ]; then\n   103\t      if (cd \"$VERSION_DIR\" && sha256sum --check --status MANIFEST.sha256 2>/dev/null); then\n   104\t        NEEDS_EXTRACT=0\n   105\t      fi\n   106\t      if [ \"$NEEDS_EXTRACT\" = \"0\" ]; then\n   107\t        if ! node - \"$VERSION_DIR/.provenance.json\" \"$ARCHIVE_SHA256\" <<'NODE'\n   108\tconst fs = require(\"node:fs\");\n   109\tconst [file, archiveSha256] = process.argv.slice(2);\n   110\ttry {\n   111\t  const record = JSON.parse(fs.readFileSync(file, \"utf8\"));\n   112\t  if (record.archiveSha256 !== archiveSha256) process.exit(1);\n   113\t} catch { process.exit(1); }\n   114\tNODE\n   115\t        then\n   116\t          NEEDS_EXTRACT=1\n   117\t        fi\n   118\t      fi\n   119\t    fi\n   120\t  fi\n--- installer tests ---\norigin/main:cli/test/node_floor.test.ts:27:    return spawnSync(\"/bin/sh\", [path.join(root, \"install.sh\")], {\norigin/main:cli/test/node_floor.test.ts:78:  assert.match(read(\"install.sh\"), new RegExp(`\"\\\\$NODE_MAJOR\" -ge ${FLOOR} \\\\]`));\norigin/main:cli/test/repro_identity.test.ts:44:      ...(overrides.missingAsset ? {} : { \"install.sh\": \"i\" }),\norigin/main:cli/test/repro_identity.test.ts:132:    for (const name of [\"nexus-linux-x86_64-v1.0.0-rc.1.tar.gz\", \"compatibility.json\", \"SHA256SUMS\", \"THIRD_PARTY_NOTICES.txt\", \"sbom.cdx.json\", \"install.sh\"]) {\norigin/main:cli/test/upgrade_acceptance.test.ts:317:  it(\"refuses an upgrade that requires attestation when gh is unavailable\", async () => {\norigin/main:cli/test/upgrade_acceptance.test.ts:330:    // A PATH shim that claims success must not satisfy *required* attestation, and an empty trusted-path list must\norigin/main:cli/test/upgrade_acceptance.test.ts:343:        \"a required attestation must fail closed when no trusted gh exists\",\norigin/main:cli/test/upgrade_acceptance.test.ts:346:      assert.equal(readJournal(tmpPrefix), null, \"required attestation must fail before starting the journal\");\norigin/main:cli/test/upgrade_acceptance.test.ts:353:        \"required attestation must not leave upgrade staging or a journal\",\norigin/main:cli/test/upgrade_acceptance.test.ts:363:  it(\"rejects required attestation when the trusted gh reports failure\", async () => {\norigin/main:cli/test/upgrade_acceptance.test.ts:381:        /Provenance attestation verification failed for .* or SHA256SUMS/,\norigin/main:cli/test/upgrade_acceptance.test.ts:382:        \"a trusted gh reporting failure must reject required attestation\",\n--- current main checks ---\n{\"conclusion\":\"\",\"databaseId\":40160250252,\"status\":\"in_progress\",\"updatedAt\":\"2026-10-25T03:59:58Z\",\"workflowName\":\"CI\"}\n{\"conclusion\":\"\",\"databaseId\":40160250231,\"status\":\"in_progress\",\"updatedAt\":\"2026-10-25T03:59:58Z\",\"workflowName\":\"CodeQL\"}\n","exit_code":0,"duration":{"secs":0,"nanos":681078874}},"started_at_ms":1792900885776,"completed_at_ms":1792900886458}}
