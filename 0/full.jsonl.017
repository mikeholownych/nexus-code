                 |  12 +-\n cli/src/startup_trust.ts              | 201 ++++++++++++++++++++++++\n cli/test/startup_trust_prompt.test.ts | 287 ++++++++++++++++++++++++++++++++++\n docs/ARCHITECTURE.md                  |   2 +-\n docs/USER_MANUAL.md                   |   3 +\n 6 files changed, 505 insertions(+), 5 deletions(-)\ncommit 127c5b811a86b2a9461e6795d03c651ea365b382\nAuthor: Mike Holownych <mike@holownych.com>\nDate:   Sat Oct 24 05:52:46 2026 +0000\n\n    feat(cli): ask before trusting workspace on startup\n\ndiff --git a/cli/src/index.ts b/cli/src/index.ts\nindex d499816..27ede63 100644\n--- a/cli/src/index.ts\n+++ b/cli/src/index.ts\n@@ -25,6 +25,7 @@ import { buildConfig as buildConfigOrThrow, loadEnvironment } from \"./config.js\"\n import { describeTarget, registerProviderCommands } from \"./provider_cli.js\";\n import { UsageLedger } from \"./usage.js\";\n import { DOCTOR_EXIT, DOCTOR_SCHEMA_VERSION, doctorExitCode, redactDiagnostic, renderDoctorJson, renderDoctorText, runDoctor, runRepairs } from \"./doctor.js\";\n+import { promptWorkspaceTrust } from \"./startup_trust.js\";\n \n function collectDeliverableFile(value: string, previous: string[] = []): string[] {\n   return [...previous, value];\n@@ -196,7 +197,6 @@ function triggerBackgroundGc(): void {\n }\n \n async function startRepl(options: any): Promise<void> {\n-  triggerBackgroundGc();\n   if (process.env.NEXUS_TEST_RECORD_REPL) {\n     const log = process.env.NEXUS_TEST_RECORD_REPL;\n     const parts = [\"repl\"];\n@@ -205,6 +205,9 @@ async function startRepl(options: any): Promise<void> {\n     fs.appendFileSync(log, parts.join(\" \").trim() + \"\\n\");\n     return;\n   }\n+  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n+  if (trustDecision === \"exit\") return;\n+  triggerBackgroundGc();\n   const config = buildConfig(options);\n   if (config.model === \"local-model\") {\n     try {\n@@ -226,7 +229,6 @@ async function startRepl(options: any): Promise<void> {\n }\n \n async function runDefault(options: any): Promise<void> {\n-  triggerBackgroundGc();\n   if (options.repl) {\n     await startRepl(options);\n     return;\n@@ -244,12 +246,18 @@ async function runDefault(options: any): Promise<void> {\n       console.error(\"nexus sidecar is not built. Run 'npm run build' in cli first.\");\n       process.exit(1);\n     }\n+    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n+    if (trustDecision === \"exit\") return;\n+    triggerBackgroundGc();\n     spawnTui(tuiBin, sidecarScript);\n     return;\n   }\n \n   const isInteractiveTty = Boolean(process.stdin.isTTY && process.stdout.isTTY);\n   if (isInteractiveTty && tuiBin && sidecarScript) {\n+    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n+    if (trustDecision === \"exit\") return;\n+    triggerBackgroundGc();\n     spawnTui(tuiBin, sidecarScript);\n     return;\n   }\ndiff --git a/cli/test/startup_trust_prompt.test.ts b/cli/test/startup_trust_prompt.test.ts\nnew file mode 100644\nindex 0000000..1a8ae2f\n--- /dev/null\n+++ b/cli/test/startup_trust_prompt.test.ts\n@@ -0,0 +1,287 @@\n+import { test } from \"node:test\";\n+import assert from \"node:assert/strict\";\n+import { PassThrough } from \"node:stream\";\n+import fs from \"node:fs\";\n+import os from \"node:os\";\n+import path from \"node:path\";\n+import { promptWorkspaceTrust, trustedProjectRules, TrustPromptInput } from \"../src/startup_trust.js\";\n+import { AutonomousAgent } from \"../src/agent.js\";\n+\n+function mockTerminal(isTTY = true, columns = 80) {\n+  const input = new PassThrough() as unknown as TrustPromptInput & { isRaw: boolean };\n+  input.isTTY = isTTY;\n+  input.isRaw = false;\n+  input.setRawMode = ((value: boolean) => { input.isRaw = value; return input; }) as TrustPromptInput[\"setRawMode\"];\n+\n+  const output = new PassThrough() as PassThrough & { isTTY: boolean };\n+  output.isTTY = isTTY;\n+  output.columns = columns;\n+  let text = \"\";\n+  output.on(\"data\", (chunk) => { text += chunk.toString(); });\n+  return { input, output, get text() { return text; } };\n+}\n+\n+function workspaceWithInstructions(): string {\n+  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-prompt-\"));\n+  fs.writeFileSync(path.join(workspace, \"AGENTS.md\"), \"project instruction\\n\");\n+  return workspace;\n+}\n+\n+function displayWidth(value: string): number {\n+  const segmenter = new Intl.Segmenter(undefined, { granularity: \"grapheme\" });\n+  let width = 0;\n+  for (const { segment } of segmenter.segment(value)) {\n+    const widths = [...segment].map((character) => {\n+      const point = character.codePointAt(0)!;\n+      if (character === \"\\u200d\" || /[\\p{Mark}\\p{Format}]/u.test(character)) return 0;\n+      return point >= 0x1100 && (\n+        point <= 0x115f || point === 0x2329 || point === 0x232a ||\n+        (point >= 0x2e80 && point <= 0xa4cf && point !== 0x303f) ||\n+        (point >= 0xac00 && point <= 0xd7a3) || (point >= 0xf900 && point <= 0xfaff) ||\n+        (point >= 0xfe10 && point <= 0xfe19) || (point >= 0xfe30 && point <= 0xfe6f) ||\n+        (point >= 0xff00 && point <= 0xff60) || (point >= 0xffe0 && point <= 0xffe6) ||\n+        (point >= 0x1f000 && point <= 0x1faff) || (point >= 0x20000 && point <= 0x3fffd)\n+      ) ? 2 : 1;\n+    });\n+    width += Math.max(0, ...widths);\n+  }\n+  return width;\n+}\n+\n+test(\"trust prompt offers explicit trust, continue-untrusted, and exit choices\", async () => {\n+  const workspace = workspaceWithInstructions();\n+  const terminal = mockTerminal(true, 40);\n+  let trusted = false;\n+  try {\n+    const decision = promptWorkspaceTrust(workspace, {\n+      ...terminal,\n+      trustStore: {\n+        isTrusted: () => trusted,\n+        trust: () => { trusted = true; },\n+      },\n+    });\n+    await new Promise((resolve) => setImmediate(resolve));\n+    const rendered = terminal.text.replace(/\\u001b\\[[0-9;?]*[A-Za-z]/g, \"\");\n+    assert.match(rendered, /Trust this folder\\?/);\n+    assert.match(rendered, /AGENTS\\.md/);\n+    assert.match(rendered, /Trust and continue/);\n+    assert.match(rendered, /Continue without trusting/);\n+    assert.match(rendered, /Exit/);\n+    assert.ok(rendered.split(\"\\n\").every((line) => displayWidth(line) <= 40), rendered);\n+\n+    terminal.input.emit(\"keypress\", undefined, { name: \"down\" });\n+    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n+    assert.equal(await decision, \"untrusted\");\n+    assert.equal(trusted, false);\n+    assert.equal(terminal.input.isRaw, false);\n+  } finally {\n+    fs.rmSync(workspace, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"trust prompt neutralizes bidi controls and fits wide Unicode paths by terminal cells\", async () => {\n+  const parent = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-bidi-\"));\n+  const workspace = path.join(parent, `項目-${\"界\".repeat(30)}-\\u202eabc-\\u200bdef-\\u2060ghi`);\n+  fs.mkdirSync(workspace);\n+  const terminal = mockTerminal(true, 40);\n+  try {\n+    const decision = promptWorkspaceTrust(workspace, {\n+      ...terminal,\n+      trustStore: { isTrusted: () => false, trust: () => {} },\n+    });\n+    await new Promise((resolve) => setImmediate(resolve));\n+    const rendered = terminal.text.replace(/\\u001b\\[[0-9;?]*[A-Za-z]/g, \"\");\n+    assert.equal(rendered.includes(\"\\u202e\"), false);\n+    assert.match(rendered, /�abc/);\n+    assert.equal(rendered.includes(\"\\u200b\"), false);\n+    assert.equal(rendered.includes(\"\\u2060\"), false);\n+    assert.match(rendered, /�def/);\n+    assert.match(rendered, /�ghi/);\n+    assert.ok(rendered.split(\"\\n\").every((line) => displayWidth(line) <= 40), rendered);\n+    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n+    assert.equal(await decision, \"exit\");\n+  } finally {\n+    fs.rmSync(parent, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"trust choice persists workspace trust and returns trusted\", async () => {\n+  const workspace = workspaceWithInstructions();\n+  const terminal = mockTerminal();\n+  let trusted = false;\n+  try {\n+    const decision = promptWorkspaceTrust(workspace, {\n+      ...terminal,\n+      trustStore: {\n+        isTrusted: () => trusted,\n+        trust: () => { trusted = true; },\n+      },\n+    });\n+    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n+    assert.equal(await decision, \"trusted\");\n+    assert.equal(trusted, true);\n+  } finally {\n+    fs.rmSync(workspace, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"a trust-store write failure leaves the operator free to continue without trust\", async () => {\n+  const workspace = workspaceWithInstructions();\n+  const terminal = mockTerminal();\n+  try {\n+    const decision = promptWorkspaceTrust(workspace, {\n+      ...terminal,\n+      trustStore: {\n+        isTrusted: () => false,\n+        trust: () => { throw new Error(\"store unavailable\"); },\n+      },\n+    });\n+    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n+    await new Promise((resolve) => setImmediate(resolve));\n+    assert.match(terminal.text, /Trust was not saved: store unavailable/);\n+    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n+    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n+    assert.equal(await decision, \"untrusted\");\n+  } finally {\n+    fs.rmSync(workspace, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"escape exits without recording trust\", async () => {\n+  const workspace = workspaceWithInstructions();\n+  const terminal = mockTerminal();\n+  let trusted = false;\n+  try {\n+    const decision = promptWorkspaceTrust(workspace, {\n+      ...terminal,\n+      trustStore: {\n+        isTrusted: () => false,\n+        trust: () => { trusted = true; },\n+      },\n+    });\n+    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n+    assert.equal(await decision, \"exit\");\n+    assert.equal(trusted, false);\n+  } finally {\n+    fs.rmSync(workspace, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"a terminal that cannot enter prompt mode exits instead of silently choosing\", async () => {\n+  const workspace = workspaceWithInstructions();\n+  const terminal = mockTerminal();\n+  terminal.input.setRawMode = (() => { throw new Error(\"raw mode unavailable\"); }) as TrustPromptInput[\"setRawMode\"];\n+  try {\n+    assert.equal(await promptWorkspaceTrust(workspace, {\n+      ...terminal,\n+      trustStore: { isTrusted: () => false, trust: () => assert.fail(\"No trust choice was made\") },\n+    }), \"exit\");\n+    await new Promise((resolve) => setImmediate(resolve));\n+    assert.match(terminal.text, /could not open the trust prompt/);\n+  } finally {\n+    fs.rmSync(workspace, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"the Exit menu item exits without persisting trust\", async () => {\n+  const workspace = workspaceWithInstructions();\n+  const terminal = mockTerminal();\n+  try {\n+    const decision = promptWorkspaceTrust(workspace, {\n+      ...terminal,\n+      trustStore: { isTrusted: () => false, trust: () => assert.fail(\"Exit must not record trust\") },\n+    });\n+    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n+    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n+    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n+    assert.equal(await decision, \"exit\");\n+  } finally {\n+    fs.rmSync(workspace, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"workspace paths cannot inject terminal control sequences into the trust screen\", async () => {\n+  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-\\u001b[31m\"));\n+  const terminal = mockTerminal();\n+  try {\n+    const decision = promptWorkspaceTrust(workspace, {\n+      ...terminal,\n+      trustStore: { isTrusted: () => false, trust: () => {} },\n+    });\n+    await new Promise((resolve) => setImmediate(resolve));\n+    assert.equal(terminal.text.includes(\"\\u001b[31m\"), false);\n+    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n+    assert.equal(await decision, \"exit\");\n+  } finally {\n+    fs.rmSync(workspace, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"non-interactive startup continues without trust or project instructions\", async () => {\n+  const workspace = workspaceWithInstructions();\n+  const terminal = mockTerminal(false);\n+  let trusted = false;\n+  try {\n+    assert.equal(await promptWorkspaceTrust(workspace, {\n+      ...terminal,\n+      trustStore: {\n+        isTrusted: () => false,\n+        trust: () => { trusted = true; },\n+      },\n+    }), \"untrusted\");\n\n--- branch vs main ---\n< 4e7297f Merge pull request #209 from mikeholownych/v1/plan-01-sec101-119-pty-followup\n< 00f50ed docs: record PTY matcher CI correction evidence\n< 93d0fa4 test: scope verifier PTY result matching to action output\n< 9a27e19 docs: record SEC source revalidation on current main\n< 4c51ae1 docs: record SEC-101 and SEC-119 source evidence\n< e950505 test: verify verifier cancellation stops descendants\n< 19b30a4 Merge pull request #208 from mikeholownych/v1/plan-09-packaging-tar-repro\n< f7747fa fix(release): bind repro builds to reviewed package tool\n< c1f40e5 Merge pull request #206 from mikeholownych/v1/defect-repl-readonly\n< e11115c docs(repl): scope read-only mode wording and residual list\n< 2f35144 fix(repl): gate mode-selected read-only and cover command variants\n< 0733676 fix(repl): refuse mutating slash commands in read-only mode\n< c1b1332 Merge pull request #205 from mikeholownych/v1/defect-tar-ambient-env\n< 2ab20cd Merge pull request #204 from mikeholownych/codex/startup-folder-trust-copy-20261024\n< 010caad fix(upgrade): sanitize PATH for tar and fail closed without it\n< 2247540 fix(upgrade): extract archives with a trusted tar and environment\n< 2989118 test(requirements): use literal verifier evidence title\n< 5b8f4eb docs(requirements): cite exact verifier test cases\n< 7ab14b3 docs(requirements): cite verifier approval evidence\n< 7a43b26 test(trust): record trust-independent review evidence\n< ca2865f fix(cli): tailor headless approval guidance by effect\n< abbd176 fix(trust): keep folder trust separate from approvals\n< 96b063a fix(cli): decouple folder trust from approval mode\n< 0fcad3f docs(cli): clarify startup folder trust and approval settings\n< 4b474f1 Merge pull request #203 from mikeholownych/v1/defect-readonly-mode-escalation\n< ef40498 test(readonly): cover review mode and provider gates\n< cfc0cda fix(authority): keep an explicit --read-only launch read-only\n< 29eab4c Merge pull request #202 from mikeholownych/v1/defect-cst-memory-followup\n< 7525659 Merge pull request #201 from mikeholownych/v1/plan-10-eval-composed-sandbox-fixture\n< b0240b4 test(eval): await containment cleanup on fixture failure\n< 281014f test(eval): compose candidate sandbox with resource limits\n< 8d2288e fix(cst): avoid line allocation amplification\n< 4adc61a Merge pull request #199 from mikeholownych/v1/defect-cst-unbounded\n< 676abb3 Merge pull request #198 from mikeholownych/v1/defect-nexus-commit-exclusion-refresh\n< 0667947 refactor(cst): parse bounded content once and pin both call sites\n< f3783cf fix(cst): bound symbol parsing and outline reads\n< 8177a3b fix(git): support internal-state exclusion before first commit\n< 41b381d Merge pull request #197 from mikeholownych/v1/defect-edit-file-unbounded\n< f827d51 Merge pull request #196 from mikeholownych/v1/repro-crossrunner-bundle\n< fba2faf test(file_ops): pin the exact edit-size boundary\n< 5c789ea fix(file_ops): bound edit_