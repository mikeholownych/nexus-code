pace, \".git\", \"info\")), false);\n+\n+    const originalPath = process.env.PATH;\n+    try {\n+      process.env.PATH = \"\";\n+      assert.throws(() => new FlightRecorder(linkedWorkspace), /Git metadata is unavailable/);\n+    } finally {\n+      if (originalPath === undefined) delete process.env.PATH;\n+      else process.env.PATH = originalPath;\n+    }\n+\n+    assert.equal(fs.existsSync(path.join(linkedWorkspace, \".nexus\", \"flights\")), false);\n+  });\n+\n   test(\"a subdirectory workspace protects root worktree state when Git metadata is unavailable\", () => {\n     const workspace = path.join(gitRepoDir, \"packages\", \"app\");\n     fs.mkdirSync(workspace, { recursive: true });\n M src/core/git_exclude.ts\n M test/flight_exclude.test.ts\nf2d7b7d test(fs): synchronize builtin ESM race hooks\n64f6576 fix(git): guard info exclude updates\nc1eab3a fix(fs): avoid unsafe cleanup after path swap\n270ff0a test(worktree): clean up nested workspace fixture\nfb77314 fix(worktree): ignore state from repository root\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a170d0-7672-79e2-b11d-117e84b3ea44","create_time":1792894982.6712923}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
