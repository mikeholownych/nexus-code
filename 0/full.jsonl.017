elf.fg = self.bg = DEFAULT\n        self.attrs = 0  # bit 1 bold, 2 dim, 4 italic, 8 reverse\n\n    def sgr(self, params):\n        nums = [int(n) if n.isdigit() else 0 for n in params.replace(\":\", \";\").split(\";\")] if params else [0]\n        i = 0\n        while i < len(nums):\n            n = nums[i]\n            if n == 0:\n                self.fg = self.bg = DEFAULT\n                self.attrs = 0\n            elif n == 1:\n                self.attrs |= 1\n            elif n == 2:\n                self.attrs |= 2\n            elif n == 3:\n                self.attrs |= 4\n            elif n == 7:\n                self.attrs |= 8\n            elif n == 22:\n                self.attrs &= ~3\n            elif n == 23:\n                self.attrs &= ~4\n            elif n == 27:\n                self.attrs &= ~8\n            elif 30 <= n <= 37 or 90 <= n <= 97:\n                self.fg = [\"ansi\", n - 30 if n < 90 else n - 90 + 8]\n            elif 40 <= n <= 47 or 100 <= n <= 107:\n                self.bg = [\"ansi\", n - 40 if n < 100 else n - 100 + 8]\n            elif n == 39:\n                self.fg = DEFAULT\n            elif n == 49:\n                self.bg = DEFAULT\n            elif n in (38, 48) and i + 1 < len(nums):\n                if nums[i + 1] == 5 and i + 2 < len(nums):\n                    value = [\"idx\", nums[i + 2]]\n                    i += 2\n                elif nums[i + 1] == 2 and i + 4 < len(nums):\n                    value = [\"rgb\", nums[i + 2], nums[i + 3], nums[i + 4]]\n                    i += 4\n                else:\n                    value = DEFAULT\n                if n == 38:\n                    self.fg = value\n                else:\n                    self.bg = value\n            i += 1\n\n    def put(self, ch):\n        width = char_width(ch)\n        if width == 0:\n            if self.col > 0:\n                self.grid[self.row][self.col - 1][0] += ch\n            return\n        if self.col + width > self.c