ff` output is coloured: rows that are not part of a hunk read as headers.\nfn diff_row_kind(row: &str) -> LineKind {\n    if row.starts_with('+') && !row.starts_with(\"+++\") {\n        LineKind::Added\n    } else if row.starts_with('-') && !row.starts_with(\"---\") {\n        LineKind::Removed\n    } else if row.starts_with(\"@@\") {\n        LineKind::Hunk\n    } else if row.starts_with(' ') {\n        LineKind::Context\n    } else {\n        LineKind::Meta\n    }\n}\n\nconst MAX_COMPLETION_ROWS: usize = 6;\n\n","exit_code":0,"duration":{"secs":0,"nanos":774779086}},"started_at_ms":1792891145176,"completed_at_ms":1792891145952}}
