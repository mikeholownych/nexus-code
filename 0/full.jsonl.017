patch. Maintenance recovery acquires its own exclusive lease instead.\nconst startupArgs = process.argv.slice(2);\nconst { acquireClientLease, releaseClientLease, clientInvocationKind } = await import(\"./core/client_lease.js\");\nconst invocationKind = clientInvocationKind(startupArgs);\nconst startupReadOnly = invocationKind === \"metadata\" || (startupArgs[0] === \"upgrade\" && startupArgs.includes(\"--check\"));\n// `upgrade --check` is read-only, so it must not replay a transaction. It also\n// must not load configuration while a restore journal says that config may be\n// only partially applied. Refuse before loadEnvironment() and let a normal\n// managed launch perform recovery.\nif (startupArgs[0] === \"upgrade\" && startupArgs.includes(\"--check\")) {\n  try {\n    const { hasPendingStateRestore } = await import(\"./core/state_restore.js\");\n    if (hasPendingStateRestore(process.env.HOME || os.homedir())) {\n      throw new Error(\"Pending state restore must be recovered before running upgrade --check\");\n    }\n  } catch (error: any) {\n    console.error(`[maintenance] ${error?.message ?? \"Nexus restore state could not be verified\"}`);\n    process.exit(2);\n  }\n}\n// A durable state-restore intent must be replayed before environment/config\n// loading or any normal client is admitted. The recovery command takes the\n// exclusive lifetime lease; ordinary clients take their shared lease below.\nif (invocationKind === \"restore\" || (invocationKind === \"client\" && !startupReadOnly)) {\n  try {\n    const { hasPendingStateRestore, recoverPendingStateRestore } = await import(\"./core/state_restore.js\");\n    const home = process.env.HOME || os.homedir();\n    if (hasPendingStateRestore(home) && !recoverPendingStateRestore(home)) {\n      throw new Error(\"Pending state restore could not be recovered; no state was admitted\");\n    }\n  } catch (error: any) {\n    console.error(`[maintenance] ${error?.message ?? \"Nexus restore recovery failed closed\"}`);\n    process.exit(2);\n  }\n}\nif (invocationKind === \"client\") {\n  try {\n    const lease = acquireClientLease(process.env.HOME || os.homedir());\n    process.once(\"exit\", () => releaseClientLease(lease));\n  } catch (error: any) {\n    console.error(`[maintenance] ${error.message}`);\n    process.exit(2);\n  }\n  loadEnvironment();\n}\n\n// Diagnose an interrupted packaged upgrade before launching a new CLI/TUI\n// session. Read-only version/help/check commands never recover or write state.\nif (!startupReadOnly && startupArgs[0] !== \"upgrade\" && process.env.NEXUS_UPGRADE_HEALTH_CHECK !== \"1\" && process.env.NEXUS_HOME) {\n  const { getJournalPath, readJournal, recoverUpgrade } = await import(\"./upgrade_journal.js\");\n  const packagedPrefix = path.resolve(process.env.NEXUS_HOME, \"../../..\");\n  const journal = readJournal(packagedPrefix);\n  if ((journal && ![\"idle\", \"complete\", \"rolled_back\"].includes(journal.state)) || (!journal && fs.existsSync(getJournalPath(packagedPrefix)))) {\n    const outcome = recoverUpgrade(packagedPrefix);\n    if (outcome.action === \"upgrade_in_progress\") console.error(`[upgrade] ${outcome.details}`);\n    if (outcome.action === \"manual_intervention\") {\n      console.error(`[upgrade] ${outcome.details}. Run nexus upgrade --recover after resolving the recorded failure.`);\n      process.exit(2);\n    }\n    if (outcome.recovered) console.warn(`[upgrade] ${outcome.details}`);\n  }\n}\n\n/**\n * Exits once stdout and stderr have accepted everything written so far. A write to a pipe is asynchronous, so an immediate\n * `process.exit()` drops whatever the pipe has not yet taken (65,536 bytes on Linux) while still exiting with the intended code.\n */\nfunction exitAfterFlush(code: number): void {\n  let pending = 2;\n  const done = () => { if (--pending === 0) process.exit(code); };\n  process.stdout.write(\"\", done);\n  process.stderr.write(\"\", done);\n}\n\nimport { getBuildIdentity } from \"./build_identity.js\";\n\nfunction isExecutable(filePath: string): boolean {\n  try {\n    fs.accessSync(filePath, fs.constants.X_OK);\n    return fs.statSync(filePath).isFile();\n  } catch {\n    return false;\n  }\n}\n\nfunction resolveTuiBinary(): string | undefined {\n  if (process.env.NEXUS_TUI_BIN && isExecutable(process.env.NEXUS_TUI_BIN)) {\n    return process.env.NEXUS_TUI_BIN;\n  }\n  if (process.env.NEXUS_HOME) {\n    const packaged = path.join(process.env.NEXUS_HOME, \"lib\", \"core\", \"nexus-tui\");\n    if (isExecutable(packaged)) return packaged;\n  }\n  const root = process.env.NEXUS_ROOT || path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n  const releaseTui = path.join(root, \"core\", \"target\", \"release\", \"nexus-tui\");\n  if (isExecutable(releaseTui)) return releaseTui;\n  const debugTui = path.join(root, \"core\", \"target\", \"debug\", \"nexus-tui\");\n  if (isExecutable(debugTui)) return debugTui;\n  return undefined;\ncore/src/bin/nexus_tui/live.rs:624:case \"$answer\" in *'\"type\":\"approve\"'*) ;; *) exit 7;; esac\ncore/src/bin/nexus_tui/live.rs:657:        let approve = app\ncore/src/bin/nexus_tui/live.rs:664:        assert!(app.handle(approve));\ncore/src/bin/nexus_tui/live_view.rs:524:    (\"y / n\", \"approve / deny — only when the panel says so (not while you were typing or hold a draft)\"),\ncore/src/bin/nexus_tui/live_view.rs:528:        \"approve this and every later action (switches to auto): enter, then enter again to confirm\",\ncore/src/bin/nexus_tui/live_view.rs:610:            vec![Span::styled(\"enter\", key), Span::styled(\" again approves · \", muted), Span::styled(\"esc\", key), Span::styled(\" denies\", muted)]\ncore/src/bin/nexus_tui/live_view.rs:612:            vec![Span::styled(\"enter\", key), Span::styled(\" again approves this action · \", muted), Span::styled(\"esc\", key), Span::styled(\" denies · other keys cancel\", muted)]\ncore/src/bin/nexus_tui/live_view.rs:615:            vec![Span::styled(\"