{"timestamp":"2026-10-24T23:39:32.019Z","ordinal":314201,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a1703b-4280-7320-9374-5c397c112b4d","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a1703b-4280-7320-9374-5c397c112b4d","response_id":"resp_060b64278a9dfb15016add419d3dd881a0b83524edd60208e3","usage":{"input_tokens":156088,"cached_input_tokens":153216,"cache_write_input_tokens":0,"output_tokens":2975,"reasoning_output_tokens":2736,"total_tokens":159063},"turn_token_usage":{"input_tokens":11566117,"cached_input_tokens":11308032,"cache_write_input_tokens":0,"output_tokens":64571,"reasoning_output_tokens":42851,"total_tokens":11630688},"thread_token_usage":{"input_tokens":5696783295,"cached_input_tokens":5635357312,"cache_write_input_tokens":0,"output_tokens":16158019,"reasoning_output_tokens":9280050,"total_tokens":5712941314}}}
{"timestamp":"2026-10-24T23:39:33.771Z","ordinal":314202,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a1703b-4280-7320-9374-5c397c112b4d","item":{"type":"CommandExecution","id":"exec-7146ad07-153b-4eb3-a783-16e40b9ae882","process_id":"1137","command":["/usr/bin/zsh","-lc","sed -n '1,260p' scripts/repro-identity.mjs; sed -n '1,280p' cli/test/repro_identity.test.ts; sed -n '85,170p' .github/workflows/repro.yml"],"cwd":"file:///home/mike/nexus-wt/plan-09-packaging-tar-repro","parsed_cmd":[{"type":"read","cmd":"sed -n '1,260p' scripts/repro-identity.mjs","name":"repro-identity.mjs","path":"scripts/repro-identity.mjs"},{"type":"read","cmd":"sed -n '1,280p' cli/test/repro_identity.test.ts","name":"repro_identity.test.ts","path":"cli/test/repro_identity.test.ts"},{"type":"read","cmd":"sed -n '85,170p' .github/workflows/repro.yml","name":"repro.yml","path":".github/workflows/repro.yml"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"// Source identity for the cross-runner reproducibility workflow (ACC-SUP-08, REQ-REL-114).\n//   record  <version> <dist-dir> <out.json> <runner-label>   identity of the checked-out RC source, workflow, toolchain and artifacts\n//   compare <expected-version> <expected-commit> <expected-workflow-commit> <out.json> <identity.json>...\n// `compare` fails unless every builder packaged the expected version and commit from identical source and lockfiles\n// and produced identical artifact digests; on success it writes the combined evidence record.\nimport { createHash } from \"node:crypto\";\nimport { execFileSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst LOCKFILES = [\"cli/package-lock.json\", \"core/Cargo.lock\", \"rust-toolchain.toml\", \"scripts/release-tools/package-lock.json\"];\nconst BUILDERS = [\"ubuntu-22.04\", \"ubuntu-24.04\"];\nconst RELEASE_ASSETS = [\"compatibility.json\", \"SHA256SUMS\", \"THIRD_PARTY_NOTICES.txt\", \"sbom.cdx.json\", \"install.sh\"];\nconst APPROVED_RUST_BUILD_IMAGE = \"rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\";\nconst sha256 = (file) => createHash(\"sha256\").update(fs.readFileSync(file)).digest(\"hex\");\nconst run = (cmd, ...argv) => execFileSync(cmd, argv, { encoding: \"utf8\" }).trim();\nconst fail = (message) => { console.error(`repro-identity: ${message}`); process.exit(1); };\n\nconst [mode, ...rest] = process.argv.slice(2);\nif (mode === \"record\") {\n  const [version, dist, out, label] = rest;\n  if (!version || !dist || !out || !label) fail(\"usage: record <version> <dist-dir> <out.json> <runner-label>\");\n  if (process.env.NEXUS_BUILD_CONTAINER_IMAGE !== APPROVED_RUST_BUILD_IMAGE) fail(\"Rust build image is not the approved digest-pinned Bookworm builder\");\n  if (process.env.GITHUB_REF !== \"refs/heads/main\") fail(\"reproducibility workflow must run from reviewed main\");\n  // Packaging must not have changed tracked source: the artifacts must still correspond to the recorded commit.\n  const dirty = run(\"git\", \"status\", \"--porcelain\", \"--untracked-files=no\");\n  if (dirty) fail(`packaging modified tracked files:\\n${dirty}`);\n  const commit = run(\"git\", \"rev-parse\", \"HEAD\");\n  const tagCommit = run(\"git\", \"rev-parse\", `refs/tags/${version}^{commit}`);\n  if (tagCommit !== commit) fail(`fetched tag ${version} resolves to ${tagCommit}, not checked-out source commit ${commit}`);\n  const workflowSha = process.env.GITHUB_WORKFLOW_SHA ?? \"\";\n  if (!/^[0-9a-f]{40}$/.test(workflowSha)) fail(\"reviewed main workflow commit is missing or invalid\");\n  const artifactNames = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n  const missingArtifacts = artifactNames.filter((file) => !fs.existsSync(path.join(dist, file)));\n  if (missingArtifacts.length) fail(`release output is missing required assets: ${missingArtifacts.join(\", \")}`);\n  const identity = {\n    source: {\n      version,\n      commit,\n      tree: run(\"git\", \"rev-parse\", \"HEAD^{tree}\"),\n      tagObject: run(\"git\", \"rev-parse\", `refs/tags/${version}`),\n      tagCommit,\n      lockfiles: Object.fromEntries(LOCKFILES.map((file) => [file, sha256(file)])),\n      // Non-ignored untracked files could be packaged without being part of the commit; both builders must agree.\n      untracked: run(\"git\", \"ls-files\", \"--others\", \"--exclude-standard\").split(\"\\n\").filter(Boolean),\n    },\n    toolchain: { node: process.version, npm: run(\"npm\", \"--version\"), rustc: run(\"rustc\", \"-V\"), cargo: run(\"cargo\", \"-V\") },\n    buildEnvironment: { rustContainerImage: process.env.NEXUS_BUILD_CONTAINER_IMAGE ?? null },\n    runner: { label, image: process.env.ImageOS ?? null, imageVersion: process.env.ImageVersion ?? null },\n    workflow: { ref: process.env.GITHUB_REF ?? null, sha: workflowSha, runId: process.env.GITHUB_RUN_ID ?? null, runAttempt: process.env.GITHUB_RUN_ATTEMPT ?? null },\n    artifacts: Object.fromEntries(artifactNames.map((file) => [file, sha256(path.join(dist, file))])),\n  };\n  fs.writeFileSync(out, `${JSON.stringify(identity, null, 2)}\\n`);\n} else if (mode === \"compare\") {\n  const [version, commit, workflowCommit, out, ...files] = rest;\n  if (!version || !/^[0-9a-f]{40}$/.test(commit ?? \"\") || !/^[0-9a-f]{40}$/.test(workflowCommit ?? \"\") || !out || files.length < 2) fail(\"usage: compare <version> <commit> <workflow-commit> <out.json> <identity.json> <identity.json>...\");\n  const builders = files.map((file) => JSON.parse(fs.readFileSync(file, \"utf8\")));\n  for (const id of builders) {\n    if (id.source.version !== version || id.source.commit !== commit) fail(`${id.runner.label} packaged ${id.source.version}@${id.source.commit}, not ${version}@${commit}`);\n  }\n  const [first] = builders;\n  const labels = builders.map((id) => id.runner.label).sort();\n  if (JSON.stringify(labels) !== JSON.stringify(BUILDERS)) fail(`builders must be exactly ${BUILDERS.join(\", \")}; got ${labels.join(\", \")}`);\n  if (builders.some((id) => !id.runner.image || !id.runner.imageVersion)) fail(\"every builder must record its runner image and image version\");\n  const buildImages = builders.map((id) => id.buildEnvironment?.rustContainerImage);\n  if (buildImages.some((image) => image !== APPROVED_RUST_BUILD_IMAGE)) fail(\"every builder must use the approved digest-pinned Bookworm Rust build image\");\n  if (new Set(buildImages).size !== 1) fail(\"builders used different Rust build images\");\n  // The released workflow is reviewed on main; the built product source remains bound to the exact RC tag commit above.\n  for (const id of builders) {\n    if (id.workflow?.ref !== \"refs/heads/main\" || id.workflow?.sha !== workflowCommit) fail(`${id.runner.label} did not record the expected reviewed main workflow commit ${workflowCommit}`);\n  }\n  if (new Set(builders.map((id) => id.workflow.sha)).size !== 1) fail(\"builders used different workflow definitions\");\n  if (new Set(builders.map((id) => `${id.workflow.runId}/${id.workflow.runAttempt}`)).size !== 1) fail(\"builders belong to different workflow runs\");\n  if (builders.some((id) => JSON.stringify(id.source) !== JSON.stringify(first.source))) fail(\"builders packaged different source or lockfiles\");\n  if (builders.some((id) => JSON.stringify(id.artifacts) !== JSON.stringify(first.artifacts))) fail(\"artifact digests differ between builders\");\n  const expectedAssets = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n  if (JSON.stringify(Object.keys(first.artifacts).sort()) !== JSON.stringify(expectedAssets)) fail(\"identity evidence does not cover the exact six published release assets\");\n  const workflowRun = process.env.GITHUB_RUN_ID ? `${process.env.GITHUB_SERVER_URL}/${process.env.GITHUB_REPOSITORY}/actions/runs/${process.env.GITHUB_RUN_ID}` : null;\n  const evidence = { requirement: \"REQ-REL-114\", acceptance: \"ACC-SUP-08\", result: \"PASS\", workflowRun, workflow: first.workflow, source: first.source, buildEnvironment: first.buildEnvironment, artifacts: first.artifacts, builders: builders.map(({ runner, toolchain }) => ({ runner, toolchain })) };\n  fs.writeFileSync(out, `${JSON.stringify(evidence, null, 2)}\\n`);\n} else {\n  fail(\"mode must be record or compare\");\n}\n/**\n * Cross-runner reproducibility source identity (ACC-SUP-08, REQ-REL-114): the compare gate in\n * scripts/repro-identity.mjs passes only when distinct builders packaged the requested version and commit from\n * identical source and lockfiles and produced identical artifact digests.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\nconst SCRIPT = path.join(ROOT, \"scripts/repro-identity.mjs\");\nconst PACKAGE_SCRIPT = path.join(ROOT, \"scripts/package-linux.sh\");\nconst MAKEFILE = path.join(ROOT, \"Makefile\");\nconst REGISTRY_PACKAGE_NAME = path.join(ROOT, \"scripts/registry-package-name.mjs\");\nconst COMMIT = \"a\".repeat(40);\nconst WORKFLOW_COMMIT = \"f\".repeat(40);\nconst APPROVED_RUST_IMAGE = \"rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\";\n\ntest(\"npm registry scoped package names escape every path separator\", async () => {\n  const { registryPackageName } = await import(REGISTRY_PACKAGE_NAME);\n  assert.equal(registryPackageName(\"@scope/package\"), \"@scope%2fpackage\");\n  assert.equal(registryPackageName(\"@scope/nested/package\"), \"@scope%2fnested%2fpackage\");\n});\n\nfunction identity(label: string, overrides: { commit?: string; lock?: string; archive?: string; workflowRef?: string; workflowSha?: string; image?: string | null; rustImage?: string | null; missingAsset?: boolean } = {}) {\n  return {\n    source: { version: \"v1.0.0-rc.1\", commit: overrides.commit ?? COMMIT, tree: \"b\".repeat(40), tagObject: \"c\".repeat(40), lockfiles: { \"cli/package-lock.json\": \"1\", \"core/Cargo.lock\": overrides.lock ?? \"2\", \"rust-toolchain.toml\": \"3\", \"scripts/release-tools/package-lock.json\": \"4\" } },\n    toolchain: { node: \"v22\", npm: \"10\", rustc: \"rustc 1.95.0\", cargo: \"cargo 1.95.0\" },\n    buildEnvironment: { rustContainerImage: overrides.rustImage === undefined ? APPROVED_RUST_IMAGE : overrides.rustImage },\n    runner: { label, image: overrides.image === undefined ? label.replace(\"-\", \"\").replace(\".04\", \"\") : overrides.image, imageVersion: \"20261012.1\" },\n    workflow: { ref: overrides.workflowRef ?? \"refs/heads/main\", sha: overrides.workflowSha ?? \"f\".repeat(40), runId: \"42\", runAttempt: \"1\" },\n    artifacts: {\n      \"nexus-linux-x86_64-v1.0.0-rc.1.tar.gz\": overrides.archive ?? \"d\",\n      \"compatibility.json\": \"e\",\n      \"SHA256SUMS\": \"f\",\n      \"THIRD_PARTY_NOTICES.txt\": \"g\",\n      \"sbom.cdx.json\": \"h\",\n      ...(overrides.missingAsset ? {} : { \"install.sh\": \"i\" }),\n    },\n  };\n}\n\ntest(\"repro compare accepts only identical source, lockfiles and artifacts from distinct builders\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"repro-identity-\"));\n  const write = (name: string, value: unknown) => { const file = path.join(dir, name); fs.writeFileSync(file, JSON.stringify(value)); return file; };\n  const compare = (...files: string[]) => spawnSync(process.execPath, [SCRIPT, \"compare\", \"v1.0.0-rc.1\", COMMIT, WORKFLOW_COMMIT, path.join(dir, \"out.json\"), ...files], { encoding: \"utf8\" });\n  try {\n    const a = write(\"a.json\", identity(\"ubuntu-22.04\"));\n    const b = write(\"b.json\", identity(\"ubuntu-24.04\"));\n    const pass = compare(a, b);\n    assert.equal(pass.status, 0, pass.stderr);\n    const evidence = JSON.parse(fs.readFileSync(path.join(dir, \"out.json\"), \"utf8\"));\n    assert.equal(evidence.result, \"PASS\");\n    assert.equal(evidence.source.commit, COMMIT);\n    assert.equal(evidence.buildEnvironment.rustContainerImage, APPROVED_RUST_IMAGE);\n    assert.deepEqual(evidence.builders.map((builder: any) => builder.runner.label), [\"ubuntu-22.04\", \"ubuntu-24.04\"]);\n\n    const missingA = write(\"missing-a.json\", identity(\"ubuntu-22.04\", { missingAsset: true }));\n    const missingB = write(\"missing-b.json\", identity(\"ubuntu-24.04\", { missingAsset: true }));\n    const missingAssetResult = compare(missingA, missingB);\n    assert.notEqual(missingAssetResult.status, 0);\n    assert.match(missingAssetResult.stderr, /does not cover the exact six published release assets/);\n\n    const cases: [string, string, RegExp][] = [\n      [\"other commit\", write(\"c.json\", identity(\"ubuntu-24.04\", { commit: \"e\".repeat(40) })), /not v1\\.0\\.0-rc\\.1@/],\n      [\"lockfile drift\", write(\"l.json\", identity(\"ubuntu-24.04\", { lock: \"9\" })), /different source or lockfiles/],\n      [\"artifact drift\", write(\"x.json\", identity(\"ubuntu-24.04\", { archive: \"f\" })), /artifact digests differ/],\n      [\"same builder twice\", a, /must be exactly/],\n      [\"unexpected builder\", write(\"u.json\", identity(\"ubuntu-20.04\")), /must be exactly/],\n      [\"missing runner image\", write(\"i.json\", identity(\"ubuntu-24.04\", { image: null })), /runner image/],\n      [\"missing Rust build image\", write(\"ri.json\", identity(\"ubuntu-24.04\", { rustImage: null })), /approved digest-pinned Bookworm Rust build image/],\n      [\"unpinned Rust build image\", write(\"ru.json\", identity(\"ubuntu-24.04\", { rustImage: \"rust:1.95.0-bookworm\" })), /approved digest-pinned Bookworm Rust build image/],\n      [\"EOL Bullseye build image\", write(\"bullseye.json\", identity(\"ubuntu-24.04\", { rustImage: \"rust:1.95.0-bullseye@sha256:\" + \"3\".repeat(64) })), /approved digest-pinned Bookworm Rust build image/],\n      [\"different Bookworm build digest\", write(\"rd.json\", identity(\"ubuntu-24.04\", { rustImage: \"rust:1.95.0-bookworm@sha256:\" + \"2\".repeat(64) })), /approved digest-pinned Bookworm Rust build image/],\n      [\"workflow from a branch\", write(\"w.json\", identity(\"ubuntu-24.04\", { workflowRef: \"refs/heads/patched\" })), /expected reviewed main workflow commit/],\n      [\"workflow identity drift\", write(\"ws.json\", identity(\"ubuntu-24.04\", { workflowSha: \"e\".repeat(40) })), /expected reviewed main workflow commit/],\n    ];\n    for (const [name, other, message] of cases) {\n      const result = compare(a, other);\n      assert.notEqual(result.status, 0, name);\n      assert.match(result.stderr, message, name);\n    }\n    assert.notEqual(compare(a).status, 0, \"a single builder is not cross-runner evidence\");\n    const invalidWorkflowCommit = spawnSync(process.execPath, [SCRIPT, \"compare\", \"v1.0.0-rc.1\", COMMIT, \"invalid\", path.join(dir, \"invalid.json\"), a, b], { encoding: \"utf8\" });\n    assert.notEqual(invalidWorkflowCommit.status, 0, \"comparison must require the exact workflow commit\");\n    assert.match(invalidWorkflowCommit.stderr, /usage: compare/);\n  } finally {\n    fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"repro record binds the checked-out commit to the fetched tag's peeled commit\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"repro-record-tag-\"));\n  const git = (...args: string[]) => {\n    const result = spawnSync(\"git\", args, { cwd: dir, encoding: \"utf8\" });\n    assert.equal(result.status, 0, result.stderr);\n    return result.stdout.trim();\n  };\n  try {\n    fs.mkdirSync(path.join(dir, \"bin\"));\n    for (const [name, output] of [[\"npm\", \"10.0.0\"], [\"rustc\", \"rustc 1.95.0\"], [\"cargo\", \"cargo 1.95.0\"]]) {\n      const tool = path.join(dir, \"bin\", name);\n      fs.writeFileSync(tool, `#!/bin/sh\\nprintf '%s\\\\n' '${output}'\\n`);\n      fs.chmodSync(tool, 0o755);\n    }\n    git(\"init\", \"--quiet\");\n    git(\"config\", \"user.name\", \"Repro fixture\");\n    git(\"config\", \"user.email\", \"repro-fixture@example.invalid\");\n    for (const file of [\"cli/package-lock.json\", \"core/Cargo.lock\", \"rust-toolchain.toml\", \"scripts/release-tools/package-lock.json\"]) {\n      fs.mkdirSync(path.dirname(path.join(dir, file)), { recursive: true });\n      fs.writeFileSync(path.join(dir, file), \"fixture\\n\");\n    }\n    fs.writeFileSync(path.join(dir, \"source.txt\"), \"source\\n\");\n    git(\"add\", \".\");\n    git(\"commit\", \"--quiet\", \"-m\", \"source fixture\");\n    const sourceCommit = git(\"rev-parse\", \"HEAD\");\n    git(\"tag\", \"v1.0.0-rc.1\");\n    const dist = path.join(dir, \"dist\");\n    fs.mkdirSync(dist);\n    for (const name of [\"nexus-linux-x86_64-v1.0.0-rc.1.tar.gz\", \"compatibility.json\", \"SHA256SUMS\", \"THIRD_PARTY_NOTICES.txt\", \"sbom.cdx.json\", \"install.sh\"]) {\n      fs.writeFileSync(path.join(dist, name), `${name}\\n`);\n    }\n    const env = {\n      ...process.env,\n      PATH: `${path.join(dir, \"bin\")}:${process.env.PATH ?? \"\"}`,\n      GITHUB_REF: \"refs/heads/main\",\n      GITHUB_WORKFLOW_SHA: WORKFLOW_COMMIT,\n      GITHUB_RUN_ID: \"42\",\n      GITHUB_RUN_ATTEMPT: \"1\",\n      NEXUS_BUILD_CONTAINER_IMAGE: APPROVED_RUST_IMAGE,\n    };\n    const out = path.join(dir, \"identity.json\");\n    const record = () => spawnSync(process.execPath, [SCRIPT, \"record\", \"v1.0.0-rc.1\", dist, out, \"ubuntu-22.04\"], { cwd: dir, env, encoding: \"utf8\" });\n    const valid = record();\n    assert.equal(valid.status, 0, valid.stderr);\n    const identityRecord = JSON.parse(fs.readFileSync(out, \"utf8\"));\n    assert.equal(identityRecord.source.commit, sourceCommit);\n    assert.equal(identityRecord.source.tagCommit, sourceCommit);\n    assert.equal(identityRecord.workflow.sha, WORKFLOW_COMMIT);\n\n    git(\"commit\", \"--quiet\", \"--allow-empty\", \"-m\", \"different tag target\");\n    const movedTagCommit = git(\"rev-parse\", \"HEAD\");\n    git(\"checkout\", \"--quiet\", sourceCommit);\n    git(\"update-ref\", \"refs/tags/v1.0.0-rc.1\", movedTagCommit);\n    const moved = record();\n    assert.notEqual(moved.status, 0);\n    assert.match(moved.stderr, /resolves to .* not checked-out source commit/);\n  } finally {\n    fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"Linux packaging rejects an omitted pinned builder unless host builds are explicitly opted into\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"package-builder-guard-\"));\n  const out = path.join(dir, \"dist\");\n  try {\n    const result = spawnSync(\"bash\", [PACKAGE_SCRIPT, \"v1.0.0\", out], {\n      cwd: ROOT,\n      encoding: \"utf8\",\n      env: { ...process.env, NEXUS_BUILD_CONTAINER_IMAGE: \"\", NEXUS_ALLOW_HOST_RUST_BUILD: \"\" },\n    });\n    assert.equal(result.status, 2, result.stderr);\n    assert.match(result.stderr, /NEXUS_BUILD_CONTAINER_IMAGE must use the approved digest-pinned Rust 1\\.95 Bookworm builder/);\n    assert.equal(fs.existsSync(out), false, \"reject before creating package output or invoking build tools\");\n  } finally {\n    fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"Makefile reproducibility gate uses the approved builder for both package builds\", () => {\n  const makefile = fs.readFileSync(MAKEFILE, \"utf8\");\n  assert.ok(makefile.includes(`APPROVED_RUST_BUILD_IMAGE := ${APPROVED_RUST_IMAGE}`));\n  const reproducibilityTarget = makefile.slice(makefile.indexOf(\"verify-reproducibility:\"));\n  const packageCalls = reproducibilityTarget.match(/NEXUS_BUILD_CONTAINER_IMAGE=\\$\\(APPROVED_RUST_BUILD_IMAGE\\) bash scripts\\/package-linux\\.sh/g) ?? [];\n  assert.equal(packageCalls.length, 2, \"both reproducibility builds must use the approved digest-pinned Rust builder\");\n});\n        with:\n          ref: ${{ needs.resolve-tag.outputs.tag_sha }}\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22.22.1\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Verify exact RC source\n        run: |\n          test \"$(git rev-parse HEAD)\" = \"$EXPECTED_TAG_SHA\"\n          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n          test \"$GITHUB_REF\" = refs/heads/main\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # pinned Rust toolchain action\n        with:\n          toolchain: 1.95.0\n      - name: Install pinned SBOM and notices tools\n        run: |\n          cargo_home=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME=\"$cargo_home\"\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - name: Verify the pinned package builder is available\n        run: |\n          docker info >/dev/null\n          test \"$NEXUS_BUILD_CONTAINER_IMAGE\" = 'rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb'\n      - name: Build the exact RC package\n        run: bash scripts/package-linux.sh \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\"\n      - name: Record source, toolchain, and published-asset identity\n        run: |\n          node scripts/repro-identity.mjs record \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\" \\\n            \"$RUNNER_TEMP/dist/repro-identity.json\" \"${{ matrix.runner }}\"\n      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n        with:\n          name: nexus-repro-${{ matrix.runner }}\n          path: |\n            ${{ runner.temp }}/dist/nexus-linux-x86_64-${{ inputs.tag }}.tar.gz\n            ${{ runner.temp }}/dist/compatibility.json\n            ${{ runner.temp }}/dist/SHA256SUMS\n            ${{ runner.temp }}/dist/THIRD_PARTY_NOTICES.txt\n            ${{ runner.temp }}/dist/sbom.cdx.json\n            ${{ runner.temp }}/dist/install.sh\n            ${{ runner.temp }}/dist/repro-identity.json\n          if-no-files-found: error\n          retention-days: 14\n\n  compare:\n    needs: [resolve-tag, build]\n    runs-on: ubuntu-22.04\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n      EXPECTED_TAG_SHA: ${{ needs.resolve-tag.outputs.tag_sha }}\n      EXPECTED_WORKFLOW_SHA: ${{ needs.resolve-tag.outputs.workflow_sha }}\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: ${{ needs.resolve-tag.outputs.workflow_sha }}\n          fetch-depth: 1\n          persist-credentials: false\n      - name: Verify comparison code is the exact reviewed workflow commit\n        run: test \"$(git rev-parse HEAD)\" = \"$EXPECTED_WORKFLOW_SHA\"\n      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n        with:\n          name: nexus-repro-ubuntu-22.04\n          path: ${{ runner.temp }}/ubuntu-22.04\n      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n        with:\n          name: nexus-repro-ubuntu-24.04\n          path: ${{ runner.temp }}/ubuntu-24.04\n      - name: Download published RC assets\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          archive=\"nexus-linux-x86_64-$TARGET_TAG.tar.gz\"\n          mkdir -p \"$RUNNER_TEMP/published\"\n          gh release download \"$TARGET_TAG\" \\\n","exit_code":0,"duration":{"secs":0,"nanos":698784164}},"started_at_ms":1792885173071,"completed_at_ms":1792885173771}}
{"timestamp":"2026-10-24T23:39:34.798Z","ordinal":314203,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17048-b20e-73b3-a1b2-17f406357213","call_id":"call_4409822bd4c949928fd8ca6aeb36a38e","output":[{"type":"input_text","text":"Script completed\nWall time 2.8 seconds\nOutput:\n"},{"type":"input_text","text":"// Source identity for the cross-runner reproducibility workflow (ACC-SUP-08, REQ-REL-114).\n//   record  <version> <dist-dir> <out.json> <runner-label>   identity of the checked-out RC source, workflow, toolchain and artifacts\n//   compare <expected-version> <expected-commit> <expected-workflow-commit> <out.json> <identity.json>...\n// `compare` fails unless every builder packaged the expected version and commit from identical source and lockfiles\n// and produced identical artifact digests; on success it writes the combined evidence record.\nimport { createHash } from \"node:crypto\";\nimport { execFileSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst LOCKFILES = [\"cli/package-lock.json\", \"core/Cargo.lock\", \"rust-toolchain.toml\", \"scripts/release-tools/package-lock.json\"];\nconst BUILDERS = [\"ubuntu-22.04\", \"ubuntu-24.04\"];\nconst RELEASE_ASSETS = [\"compatibility.json\", \"SHA256SUMS\", \"THIRD_PARTY_NOTICES.txt\", \"sbom.cdx.json\", \"install.sh\"];\nconst APPROVED_RUST_BUILD_IMAGE = \"rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\";\nconst sha256 = (file) => createHash(\"sha256\").update(fs.readFileSync(file)).digest(\"hex\");\nconst run = (cmd, ...argv) => execFileSync(cmd, argv, { encoding: \"utf8\" }).trim();\nconst fail = (message) => { console.error(`repro-identity: ${message}`); process.exit(1); };\n\nconst [mode, ...rest] = process.argv.slice(2);\nif (mode === \"record\") {\n  const [version, dist, out, label] = rest;\n  if (!version || !dist || !out || !label) fail(\"usage: record <version> <dist-dir> <out.json> <runner-label>\");\n  if (process.env.NEXUS_BUILD_CONTAINER_IMAGE !== APPROVED_RUST_BUILD_IMAGE) fail(\"Rust build image is not the approved digest-pinned Bookworm builder\");\n  if (process.env.GITHUB_REF !== \"refs/heads/main\") fail(\"reproducibility workflow must run from reviewed main\");\n  // Packaging must not have changed tracked source: the artifacts must still correspond to the recorded commit.\n  const dirty = run(\"git\", \"status\", \"--porcelain\", \"--untracked-files=no\");\n  if (dirty) fail(`packaging modified tracked files:\\n${dirty}`);\n  const commit = run(\"git\", \"rev-parse\", \"HEAD\");\n  const tagCommit = run(\"git\", \"rev-parse\", `refs/tags/${version}^{commit}`);\n  if (tagCommit !== commit) fail(`fetched tag ${version} resolves to ${tagCommit}, not checked-out source commit ${commit}`);\n  const workflowSha = process.env.GITHUB_WORKFLOW_SHA ?? \"\";\n  if (!/^[0-9a-f]{40}$/.test(workflowSha)) fail(\"reviewed main workflow commit is missing or invalid\");\n  const artifactNames = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n  const missingArtifacts = artifactNames.filter((file) => !fs.existsSync(path.join(dist, file)));\n  if (missingArtifacts.length) fail(`release output is missing required assets: ${missingArtifacts.join(\", \")}`);\n  const identity = {\n    source: {\n      version,\n      commit,\n      tree: run(\"git\", \"rev-parse\", \"HEAD^{tree}\"),\n      tagObject: run(\"git\", \"rev-parse\", `refs/tags/${version}`),\n      tagCommit,\n      lockfiles: Object.fromEntries(LOCKFILES.map((file) => [file, sha256(file)])),\n      // Non-ignored untracked files could be packaged without being part of the commit; both builders must agree.\n      untracked: run(\"git\", \"ls-files\", \"--others\", \"--exclude-standard\").split(\"\\n\").filter(Boolean),\n    },\n    toolchain: { node: process.version, npm: run(\"npm\", \"--version\"), rustc: run(\"rustc\", \"-V\"), cargo: run(\"cargo\", \"-V\") },\n    buildEnvironment: { rustContainerImage: process.env.NEXUS_BUILD_CONTAINER_IMAGE ?? null },\n    runner: { label, image: process.env.ImageOS ?? null, imageVersion: process.env.ImageVersion ?? null },\n    workflow: { ref: process.env.GITHUB_REF ?? null, sha: workflowSha, runId: process.env.GITHUB_RUN_ID ?? null, runAttempt: process.env.GITHUB_RUN_ATTEMPT ?? null },\n    artifacts: Object.fromEntries(artifactNames.map((file) => [file, sha256(path.join(dist, file))])),\n  };\n  fs.writeFileSync(out, `${JSON.stringify(identity, null, 2)}\\n`);\n} else if (mode === \"compare\") {\n  const [version, commit, workflowCommit, out, ...files] = rest;\n  if (!version || !/^[0-9a-f]{40}$/.test(commit ?? \"\") || !/^[0-9a-f]{40}$/.test(workflowCommit ?? \"\") || !out || files.length < 2) fail(\"usage: compare <version> <commit> <workflow-commit> <out.json> <identity.json> <identity.json>...\");\n  const builders = files.map((file) => JSON.parse(fs.readFileSync(file, \"utf8\")));\n  for (const id of builders) {\n    if (id.source.version !== version || id.source.commit !== commit) fail(`${id.runner.label} packaged ${id.source.version}@${id.source.commit}, not ${version}@${commit}`);\n  }\n  const [first] = builders;\n  const labels = builders.map((id) => id.runner.label).sort();\n  if (JSON.stringify(labels) !== JSON.stringify(BUILDERS)) fail(`builders must be exactly ${BUILDERS.join(\", \")}; got ${labels.join(\", \")}`);\n  if (builders.some((id) => !id.runner.image || !id.runner.imageVersion)) fail(\"every builder must record its runner image and image version\");\n  const buildImages = builders.map((id) => id.buildEnvironment?.rustContainerImage);\n  if (buildImages.some((image) => image !== APPROVED_RUST_BUILD_IMAGE)) fail(\"every builder must use the approved digest-pinned Bookworm Rust build image\");\n  if (new Set(buildImages).size !== 1) fail(\"builders used different Rust build images\");\n  // The released workflow is reviewed on main; the built product source remains bound to the exact RC tag commit above.\n  for (const id of builders) {\n    if (id.workflow?.ref !== \"refs/heads/main\" || id.workflow?.sha !== workflowCommit) fail(`${id.runner.label} did not record the expected reviewed main workflow commit ${workflowCommit}`);\n  }\n  if (new Set(builders.map((id) => id.workflow.sha)).size !== 1) fail(\"builders used different workflow definitions\");\n  if (new Set(builders.map((id) => `${id.workflow.runId}/${id.workflow.runAttempt}`)).size !== 1) fail(\"builders belong to different workflow runs\");\n  if (builders.some((id) => JSON.stringify(id.source) !== JSON.stringify(first.source))) fail(\"builders packaged different source or lockfiles\");\n  if (builders.some((id) => JSON.stringify(id.artifacts) !== JSON.stringify(first.artifacts))) fail(\"artifact digests differ between builders\");\n  const expectedAssets = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n  if (JSON.stringify(Object.keys(first.artifacts).sort()) !== JSON.stringify(expectedAssets)) fail(\"identity evidence does not cover the exact six published release assets\");\n  const workflowRun = process.env.GITHUB_RUN_ID ? `${process.env.GITHUB_SERVER_URL}/${process.env.GITHUB_REPOSITORY}/actions/runs/${process.env.GITHUB_RUN_ID}` : null;\n  const evidence = { requirement: \"REQ-REL-114\", acceptance: \"ACC-SUP-08\", result: \"PASS\", workflowRun, workflow: first.workflow, source: first.source, buildEnvironment: first.buildEnvironment, artifacts: first.artifacts, builders: builders.map(({ runner, toolchain }) => ({ runner, toolchain })) };\n  fs.writeFileSync(out, `${JSON.stringify(evidence, null, 2)}\\n`);\n} else {\n  fail(\"mode must be record or compare\");\n}\n/**\n * Cross-runner reproducibility source identity (ACC-SUP-08, REQ-REL-114): the compare gate in\n * scripts/repro-identity.mjs passes only when distinct builders packaged the requested version and commit from\n * identical source and lockfiles and produced identical artifact digests.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\nconst SCRIPT = path.join(ROOT, \"scripts/repro-identity.mjs\");\nconst PACKAGE_SCRIPT = path.join(ROOT, \"scripts/package-linux.sh\");\nconst MAKEFILE = path.join(ROOT, \"Makefile\");\nconst REGISTRY_PACKAGE_NAME = path.join(ROOT, \"scripts/registry-package-name.mjs\");\nconst COMMIT = \"a\".repeat(40);\nconst WORKFLOW_COMMIT = \"f\".repeat(40);\nconst APPROVED_RUST_IMAGE = \"rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\";\n\ntest(\"npm registry scoped package names escape every path separator\", async () => {\n  const { registryPackageName } = await import(REGISTRY_PACKAGE_NAME);\n  assert.equal(registryPackageName(\"@scope/package\"), \"@scope%2fpackage\");\n  assert.equal(registryPackageName(\"@scope/nested/package\"), \"@scope%2fnested%2fpackage\");\n});\n\nfunction identity(label: string, overrides: { commit?: string; lock?: string; archive?: string; workflowRef?: string; workflowSha?: string; image?: string | null; rustImage?: string | null; missingAsset?: boolean } = {}) {\n  return {\n    source: { version: \"v1.0.0-rc.1\", commit: overrides.commit ?? COMMIT, tree: \"b\".repeat(40), tagObject: \"c\".repeat(40), lockfiles: { \"cli/package-lock.json\": \"1\", \"core/Cargo.lock\": overrides.lock ?? \"2\", \"rust-toolchain.toml\": \"3\", \"scripts/release-tools/package-lock.json\": \"4\" } },\n    toolchain: { node: \"v22\", npm: \"10\", rustc: \"rustc 1.95.0\", cargo: \"cargo 1.95.0\" },\n    buildEnvironment: { rustContainerImage: overrides.rustImage === undefined ? APPROVED_RUST_IMAGE : overrides.rustImage },\n    runner: { label, image: overrides.image === undefined ? label.replace(\"-\", \"\").replace(\".04\", \"\") : overrides.image, imageVersion: \"20261012.1\" },\n    workflow: { ref: overrides.workflowRef ?? \"refs/heads/main\", sha: overrides.workflowSha ?? \"f\".repeat(40), runId: \"42\", runAttempt: \"1\" },\n    artifacts: {\n      \"nexus-linux-x86_64-v1.0.0-rc.1.tar.gz\": overrides.archive ?? \"d\",\n      \"compatibility.json\": \"e\",\n      \"SHA256SUMS\": \"f\",\n      \"THIRD_PARTY_NOTICES.txt\": \"g\",\n      \"sbom.cdx.json\": \"h\",\n      ...(overrides.missingAsset ? {} : { \"install.sh\": \"i\" }),\n    },\n  };\n}\n\ntest(\"repro compare accepts only identical source, lockfiles and artifacts from distinct builders\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"repro-identity-\"));\n  const write = (name: string, value: unknown) => { const file = path.join(dir, name); fs.writeFileSync(file, JSON.stringify(value)); return file; };\n  const compare = (...files: string[]) => spawnSync(process.execPath, [SCRIPT, \"compare\", \"v1.0.0-rc.1\", COMMIT, WORKFLOW_COMMIT, path.join(dir, \"out.json\"), ...files], { encoding: \"utf8\" });\n  try {\n    const a = write(\"a.json\", identity(\"ubuntu-22.04\"));\n    const b = write(\"b.json\", identity(\"ubuntu-24.04\"));\n    const pass = compare(a, b);\n    assert.equal(pass.status, 0, pass.stderr);\n    const evidence = JSON.parse(fs.readFileSync(path.join(dir, \"out.json\"), \"utf8\"));\n    assert.equal(evidence.result, \"PASS\");\n    assert.equal(evidence.source.commit, COMMIT);\n    assert.equal(evidence.buildEnvironment.rustContainerImage, APPROVED_RUST_IMAGE);\n    assert.deepEqual(evidence.builders.map((builder: any) => builder.runner.label), [\"ubuntu-22.04\", \"ubuntu-24.04\"]);\n\n    const missingA = write(\"missing-a.json\", identity(\"ubuntu-22.04\", { missingAsset: true }));\n    const missingB = write(\"missing-b.json\", identity(\"ubuntu-24.04\", { missingAsset: true }));\n    const missingAssetResult = compare(missingA, missingB);\n    assert.notEqual(missingAssetResult.status, 0);\n    assert.match(missingAssetResult.stderr, /does not cover the exact six published release assets/);\n\n    const cases: [string, string, RegExp][] = [\n      [\"other commit\", write(\"c.json\", identity(\"ubuntu-24.04\", { commit: \"e\".repeat(40) })), /not v1\\.0\\.0-rc\\.1@/],\n      [\"lockfile drift\", write(\"l.json\", identity(\"ubuntu-24.04\", { lock: \"9\" })), /different source or lockfiles/],\n      [\"artifact drift\", write(\"x.json\", identity(\"ubuntu-24.04\", { archive: \"f\" })), /artifact digests differ/],\n      [\"same builder twice\", a, /must be exactly/],\n      [\"unexpected builder\", write(\"u.json\", identity(\"ubuntu-20.04\")), /must be exactly/],\n      [\"missing runner image\", write(\"i.json\", identity(\"ubuntu-24.04\", { image: null })), /runner image/],\n      [\"missing Rust build image\", write(\"ri.json\", identity(\"ubuntu-24.04\", { rustImage: null })), /approved digest-pinned Bookworm Rust build image/],\n      [\"unpinned Rust build image\", write(\"ru.json\", identity(\"ubuntu-24.04\", { rustImage: \"rust:1.95.0-bookworm\" })), /approved digest-pinned Bookworm Rust build image/],\n      [\"EOL Bullseye build image\", write(\"bullseye.json\", identity(\"ubuntu-24.04\", { rustImage: \"rust:1.95.0-bullseye@sha256:\" + \"3\".repeat(64) })), /approved digest-pinned Bookworm Rust build image/],\n      [\"different Bookworm build digest\", write(\"rd.json\", identity(\"ubuntu-24.04\", { rustImage: \"rust:1.95.0-bookworm@sha256:\" + \"2\".repeat(64) })), /approved digest-pinned Bookworm Rust build image/],\n      [\"workflow from a branch\", write(\"w.json\", identity(\"ubuntu-24.04\", { workflowRef: \"refs/heads/patched\" })), /expected reviewed main workflow commit/],\n      [\"workflow identity drift\", write(\"ws.json\", identity(\"ubuntu-24.04\", { workflowSha: \"e\".repeat(40) })), /expected reviewed main workflow commit/],\n    ];\n    for (const [name, other, message] of cases) {\n      const result = compare(a, other);\n      assert.notEqual(result.status, 0, name);\n      assert.match(result.stderr, message, name);\n    }\n    assert.notEqual(compare(a).status, 0, \"a single builder is not cross-runner evidence\");\n    const invalidWorkflowCommit = spawnSync(process.execPath, [SCRIPT, \"compare\", \"v1.0.0-rc.1\", COMMIT, \"invalid\", path.join(dir, \"invalid.json\"), a, b], { encoding: \"utf8\" });\n    assert.notEqual(invalidWorkflowCommit.status, 0, \"comparison must require the exact workflow commit\");\n    assert.match(invalidWorkflowCommit.stderr, /usage: compare/);\n  } finally {\n    fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"repro record binds the checked-out commit to the fetched tag's peeled commit\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"repro-record-tag-\"));\n  const git = (...args: string[]) => {\n    const result = spawnSync(\"git\", args, { cwd: dir, encoding: \"utf8\" });\n    assert.equal(result.status, 0, result.stderr);\n    return result.stdout.trim();\n  };\n  try {\n    fs.mkdirSync(path.join(dir, \"bin\"));\n    for (const [name, output] of [[\"npm\", \"10.0.0\"], [\"rustc\", \"rustc 1.95.0\"], [\"cargo\", \"cargo 1.95.0\"]]) {\n      const tool = path.join(dir, \"bin\", name);\n      fs.writeFileSync(tool, `#!/bin/sh\\nprintf '%s\\\\n' '${output}'\\n`);\n      fs.chmodSync(tool, 0o755);\n    }\n    git(\"init\", \"--quiet\");\n    git(\"config\", \"user.name\", \"Repro fixture\");\n    git(\"config\", \"user.email\", \"repro-fixture@example.invalid\");\n    for (const file of [\"cli/package-lock.json\", \"core/Cargo.lock\", \"rust-toolchain.toml\", \"scripts/release-tools/package-lock.json\"]) {\n      fs.mkdirSync(path.dirname(path.join(dir, file)), { recursive: true });\n      fs.writeFileSync(path.join(dir, file), \"fixture\\n\");\n    }\n    fs.writeFileSync(path.join(dir, \"source.txt\"), \"source\\n\");\n    git(\"add\", \".\");\n    git(\"commit\", \"--quiet\", \"-m\", \"source fixture\");\n    const sourceCommit = git(\"rev-parse\", \"HEAD\");\n    git(\"tag\", \"v1.0.0-rc.1\");\n    const dist = path.join(dir, \"dist\");\n    fs.mkdirSync(dist);\n    for (const name of [\"nexus-linux-x86_64-v1.0.0-rc.1.tar.gz\", \"compatibility.json\", \"SHA256SUMS\", \"THIRD_PARTY_NOTICES.txt\", \"sbom.cdx.json\", \"install.sh\"]) {\n      fs.writeFileSync(path.join(dist, name), `${name}\\n`);\n    }\n    const env = {\n      ...process.env,\n      PATH: `${path.join(dir, \"bin\")}:${process.env.PATH ?? \"\"}`,\n      GITHUB_REF: \"refs/heads/main\",\n      GITHUB_WORKFLOW_SHA: WORKFLOW_COMMIT,\n      GITHUB_RUN_ID: \"42\",\n      GITHUB_RUN_ATTEMPT: \"1\",\n      NEXUS_BUILD_CONTAINER_IMAGE: APPROVED_RUST_IMAGE,\n    };\n    const out = path.join(dir, \"identity.json\");\n    const record = () => spawnSync(process.execPath, [SCRIPT, \"record\", \"v1.0.0-rc.1\", dist, out, \"ubuntu-22.04\"], { cwd: dir, env, encoding: \"utf8\" });\n    const valid = record();\n    assert.equal(valid.status, 0, valid.stderr);\n    const identityRecord = JSON.parse(fs.readFileSync(out, \"utf8\"));\n    assert.equal(identityRecord.source.commit, sourceCommit);\n    assert.equal(identityRecord.source.tagCommit, sourceCommit);\n    assert.equal(identityRecord.workflow.sha, WORKFLOW_COMMIT);\n\n    git(\"commit\", \"--quiet\", \"--allow-empty\", \"-m\", \"different tag target\");\n    const movedTagCommit = git(\"rev-parse\", \"HEAD\");\n    git(\"checkout\", \"--quiet\", sourceCommit);\n    git(\"update-ref\", \"refs/tags/v1.0.0-rc.1\", movedTagCommit);\n    const moved = record();\n    assert.notEqual(moved.status, 0);\n    assert.match(moved.stderr, /resolves to .* not checked-out source commit/);\n  } finally {\n    fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"Linux packaging rejects an omitted pinned builder unless host builds are explicitly opted into\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"package-builder-guard-\"));\n  const out = path.join(dir, \"dist\");\n  try {\n    const result = spawnSync(\"bash\", [PACKAGE_SCRIPT, \"v1.0.0\", out], {\n      cwd: ROOT,\n      encoding: \"utf8\",\n      env: { ...process.env, NEXUS_BUILD_CONTAINER_IMAGE: \"\", NEXUS_ALLOW_HOST_RUST_BUILD: \"\" },\n    });\n    assert.equal(result.status, 2, result.stderr);\n    assert.match(result.stderr, /NEXUS_BUILD_CONTAINER_IMAGE must use the approved digest-pinned Rust 1\\.95 Bookworm builder/);\n    assert.equal(fs.existsSync(out), false, \"reject before creating package output or invoking build tools\");\n  } finally {\n    fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"Makefile reproducibility gate uses the approved builder for both package builds\", () => {\n  const makefile = fs.readFileSync(MAKEFILE, \"utf8\");\n  assert.ok(makefile.includes(`APPROVED_RUST_BUILD_IMAGE := ${APPROVED_RUST_IMAGE}`));\n  const reproducibilityTarget = makefile.slice(makefile.indexOf(\"verify-reproducibility:\"));\n  const packageCalls = reproducibilityTarget.match(/NEXUS_BUILD_CONTAINER_IMAGE=\\$\\(APPROVED_RUST_BUILD_IMAGE\\) bash scripts\\/package-linux\\.sh/g) ?? [];\n  assert.equal(packageCalls.length, 2, \"both reproducibility builds must use the approved digest-pinned Rust builder\");\n});\n        with:\n          ref: ${{ needs.resolve-tag.outputs.tag_sha }}\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22.22.1\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Verify exact RC source\n        run: |\n          test \"$(git rev-parse HEAD)\" = \"$EXPECTED_TAG_SHA\"\n          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n          test \"$GITHUB_REF\" = refs/heads/main\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # pinned Rust toolchain action\n        with:\n          toolchain: 1.95.0\n      - name: Install pinned SBOM and notices tools\n        run: |\n          cargo_home=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME=\"$cargo_home\"\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - name: Verify the pinned package builder is available\n        run: |\n          docker info >/dev/null\n          test \"$NEXUS_BUILD_CONTAINER_IMAGE\" = 'rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb'\n      - name: Build the exact RC package\n        run: bash scripts/package-linux.sh \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\"\n      - name: Record source, toolchain, and published-asset identity\n        run: |\n          node scripts/repro-identity.mjs record \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\" \\\n            \"$RUNNER_TEMP/dist/repro-identity.json\" \"${{ matrix.runner }}\"\n      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n        with:\n          name: nexus-repro-${{ matrix.runner }}\n          path: |\n            ${{ runner.temp }}/dist/nexus-linux-x86_64-${{ inputs.tag }}.tar.gz\n            ${{ runner.temp }}/dist/compatibility.json\n            ${{ runner.temp }}/dist/SHA256SUMS\n            ${{ runner.temp }}/dist/THIRD_PARTY_NOTICES.txt\n            ${{ runner.temp }}/dist/sbom.cdx.json\n            ${{ runner.temp }}/dist/install.sh\n            ${{ runner.temp }}/dist/repro-identity.json\n          if-no-files-found: error\n          retention-days: 14\n\n  compare:\n    needs: [resolve-tag, build]\n    runs-on: ubuntu-22.04\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n      EXPECTED_TAG_SHA: ${{ needs.resolve-tag.outputs.tag_sha }}\n      EXPECTED_WORKFLOW_SHA: ${{ needs.resolve-tag.outputs.workflow_sha }}\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: ${{ needs.resolve-tag.outputs.workflow_sha }}\n          fetch-depth: 1\n          persist-credentials: false\n      - name: Verify comparison code is the exact reviewed workflow commit\n        run: test \"$(git rev-parse HEAD)\" = \"$EXPECTED_WORKFLOW_SHA\"\n      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n        with:\n          name: nexus-repro-ubuntu-22.04\n          path: ${{ runner.temp }}/ubuntu-22.04\n      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n        with:\n          name: nexus-repro-ubuntu-24.04\n          path: ${{ runner.temp }}/ubuntu-24.04\n      - name: Download published RC assets\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          archive=\"nexus-linux-x86_64-$TARGET_TAG.tar.gz\"\n          mkdir -p \"$RUNNER_TEMP/published\"\n          gh release download \"$TARGET_TAG\" \\\n"}],"internal_chat