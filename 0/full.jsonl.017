urface(\"repl\");\n    this.agent.setApprovalMode(this.approvalMode);\n    // Compaction archives the originals beside the current session before the session names it as committed.\n    this.agent.setArchiveSink((compactionId, messages) => this.sessionManager.appendArchivedHistory(this.currentSessionId, messages, compactionId));\n    this.historyFile = path.join(os.homedir(), \".nexus_history\");\n    this.loadHistory();\n\n    if (resumeSessionId) {\n      try {\n        const sess = resumeSessionId === \"latest\"\n          ? this.sessionManager.getLatestSession()\n          : this.sessionManager.loadSession(resumeSessionId);\n        if (sess) {\n          this.currentSessionId = sess.id;\n          if (sess.workspace && fs.existsSync(sess.workspace)) {\n            this.config.workspace = sess.workspace;\n            this.agent.setWorkspace(sess.workspace);\n            this.checkpointManager = new CheckpointManager(sess.workspace);\n          }\n          const archiveNotice = this.agent.restoreConversation(sess, (committed) => this.sessionManager.readArchivedHistory(sess.id, committed));\n          if (archiveNotice) console.log(pc.yellow(archiveNotice));\n          console.log(pc.green(`✔ Restored previous session ${pc.bold(sess.id)} (${sess.messages.length} messages)`));\n        } else {\n22-import { KnowledgeGraph } from \"./knowledge.js\";\n23-import { TaskStateNotFoundError } from \"./core/state.js\";\n24-import { buildConfig as buildConfigOrThrow, loadEnvironment } from \"./config.js\";\n25-import { describeTarget, registerProviderCommands } from \"./provider_cli.js\";\n26-import { UsageLedger } from \"./usage.js\";\n27-import { DOCTOR_EXIT, DOCTOR_SCHEMA_VERSION, doctorExitCode, redactDiagnostic, renderDoctorJson, renderDoctorText, runDoctor, runRepairs } from \"./doctor.js\";\n28:import { promptWorkspaceTrust } from \"./startup_trust.js\";\n29-\n30-function collectDeliverableFile(value: string, previous: string[] = []): string[] {\n31-  return [...previous, value];\n32-}\n33-\n34-/** Configuration errors (unknown provider, missing model or base URL) end the command with a message, not a trace. */\n--\n202-    const parts = [\"repl\"];\n203-    if (options.model) parts.push(\"-m\", options.model);\n204-    if (options.resume) parts.push(\"-r\", typeof options.resume === \"string\" ? options.resume : \"\");\n205-    fs.appendFileSync(log, parts.join(\" \").trim() + \"\\n\");\n206-    return;\n207-  }\n208:  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n209:  if (trustDecision === \"exit\") return;\n210-  triggerBackgroundGc();\n211-  const config = buildConfig(options);\n212-  if (config.model === \"local-model\") {\n213-    try {\n214-      const client = new LocalLlmClient(config);\n215-      const models = await client.listModels();\n--\n243-      process.exit(1);\n244-    }\n245-    if (!sidecarScript) {\n246-      console.error(\"nexus sidecar is not built. Run 'npm run build' in cli first.\");\n247-      process.exit(1);\n248-    }\n249:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n250:    if (trustDecision === \"exit\") return;\n251-    triggerBackgroundGc();\n252-    spawnTui(tuiBin, sidecarScript);\n253-    return;\n254-  }\n255-\n256-  const isInteractiveTty = Boolean(process.stdin.isTTY && process.stdout.isTTY);\n257-  if (isInteractiveTty && tuiBin && sidecarScript) {\n258:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\n259:    if (trustDecision === \"exit\") return;\n260-    triggerBackgroundGc();\n261-    spawnTui(tuiBin, sidecarScript);\n262-    return;\n263-  }\n264-\n265-  if (isInteractiveTty && !tuiBin) {\n6-\n7-| ID | Decision | Resolution | Blocks execution? |\n8-|---|---|---|---|\n9:| [DEC-01](#dec-01-default-execution-posture) | Default execution posture | Review by default; permission mode is independent of folder trust | No (resolved) |\n10-| [DEC-02](#dec-02-role-of-the-repl) | Role of the REPL | Supported secondary surface; TUI primary; top-level flags implemented | No |\n11-| [DEC-03](#dec-03-team-and-operation-scope-in-v1) | `/team` and `nexus operation` in v1 | Shipped as **experimental**; data-loss fix still a blocker | No |\n12-| [DEC-04](#dec-04-issue-12-open-normative-blockers) | Issue #12 open blockers | EXT-004 implemented; CTX-001 partially implemented; CTX-002 descoped post-v1 | No |\n--\n26-\n27----\n28-\n29:## DEC-01: Default execution posture\n30-\n31-**Question.** What protects the user by default from model-initiated command execution and network egress? See SEC-01, VER-01, HIST-05 and TUI-07.\n32-\n--\n34-|---|---|---|\n35-| A | Review by default: write, exec and egress ask | Safest. More prompts. Changes existing users' habits. |\n36-| B | Auto with an enforced sandbox by default | Few prompts. bwrap is unavailable on some hosts (WSL, rootless containers), and the Docker fallback is unpinned and networked. Egress is unsolved. |\n37:| **C (original choice; amended 2026-10-24)** | Permission mode controls approvals independently of workspace trust. The default is `review`. `--mode auto` permits writes and commands regardless of folder trust and keeps first-use egress approval per origin. `--yes` and `NEXUS_APPROVAL_MODE=auto` select full access and bypass confirmation prompts, including egress. | Folder trust is a separate choice for loading project instructions and workspace integrations. |\n38-| D | Keep auto | Contradicts REQ-SEC-101; rejected. |\n39-\n40-**Rationale.** Folder trust protects project instructions and workspace integrations from being loaded before the operator approves those sources. Tool authority is governed by the operator's permission settings and must not change when a folder is trusted. A configured `auto` mode remains the operator's choice; when no permission mode is configured, Nexus defaults to `review`.\n41-\n42:**Amendment (2026-10-24, operator direction).** This supersedes the original trust-derived mode and approval behavior. Trust affects project instruction and integration loading only; it does not select or change tool approval mode. Approval behavior follows the configured permission mode, with `review` as the unconfigured default.\n43-\n44-**Further rules:**\n45-- Headless `nexus run` with no TTY: decision-required calls are DENIED with a typed reason unless `--yes` is given.\n--\n49-\n50-## DEC-02: Role of the REPL\n51-\n52:**Options.** (A) Remove the REPL. **(B, chosen)** The REPL is a supported secondary surface: used for non-TTY input, scripting and fallback, with its approvals fixed to the TUI's standard. (C) The REPL stays the default.\n53-\n54-**Rationale.** The REPL is the only interactive surface when stdin or stdout is not a terminal, and when the Rust TUI is missing. Removing it loses a fallback. Keeping it as the default contradicts UI-004.\n55-\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { PassThrough } from \"node:stream\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { promptWorkspaceTrust, trustedProjectRules, TrustPromptInput } from \"../src/startup_trust.js\";\nimport { AutonomousAgent } from \"../src/agent.js\";\n\nfunction mockTerminal(isTTY = true, columns = 80) {\n  const input = new PassThrough() as unknown as TrustPromptInput & { isRaw: boolean };\n  input.isTTY = isTTY;\n  input.isRaw = false;\n  input.setRawMode = ((value: boolean) => { input.isRaw = value; return input; }) as TrustPromptInput[\"setRawMode\"];\n\n  const output = new PassThrough() as PassThrough & { isTTY: boolean };\n  output.isTTY = isTTY;\n  output.columns = columns;\n  let text = \"\";\n  output.on(\"data\", (chunk) => { text += chunk.toString(); });\n  return { input, output, get text() { return text; } };\n}\n\nfunction workspaceWithInstructions(): string {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-prompt-\"));\n  fs.writeFileSync(path.join(workspace, \"AGENTS.md\"), \"project instruction\\n\");\n  return workspace;\n}\n\nfunction displayWidth(value: string): number {\n  const segmenter = new Intl.Segmenter(undefined, { granularity: \"grapheme\" });\n  let width = 0;\n  for (const { segment } of segmenter.segment(value)) {\n    const widths = [...segment].map((character) => {\n      const point = character.codePointAt(0)!;\n      if (character === \"\\u200d\" || /[\\p{Mark}\\p{Format}]/u.test(character)) return 0;\n      return point >= 0x1100 && (\n        point <= 0x115f || point === 0x2329 || point === 0x232a ||\n        (point >= 0x2e80 && point <= 0xa4cf && point !== 0x303f) ||\n        (point >= 0xac00 && point <= 0xd7a3) || (point >= 0xf900 && point <= 0xfaff) ||\n        (point >= 0xfe10 && point <= 0xfe19) || (point >= 0xfe30 && point <= 0xfe6f) ||\n        (point >= 0xff00 && point <= 0xff60) || (point >= 0xffe0 && point <= 0xffe6) ||\n        (point >= 0x1f000 && point <= 0x1faff) || (point >= 0x20000 && point <= 0x3fffd)\n      ) ? 2 : 1;\n    });\n    width += Math.max(0, ...widths);\n  }\n  return width;\n}\n\ntest(\"trust prompt offers explicit trust, continue-untrusted, and exit choices\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal(true, 40);\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => trusted,\n        trust: () => { trusted = true; },\n      },\n    });\n    await new Promise((resolve) => setImmediate(resolve));\n    const rendered = terminal.text.replace(/\\u001b\\[[0-9;?]*[A-Za-z]/g, \"\");\n    assert.match(rendered, /Trust this folder\\?/);\n    assert.match(rendered, /AGENTS\\.md/);\n    assert.match(rendered, /Trust and continue/);\n    assert.match(rendered, /Continue without trusting/);\n    assert.match(rendered, /Exit/);\n    assert.match(rendered, /Trust remembered for this folder/);\n    assert.match(rendered, /Includes future project config changes/);\n    assert.match(rendered, /Tool approvals use permission settings/);\n    assert.match(rendered, /Folder trust doesn't change approvals/);\n    assert.ok(rendered.split(\"\\n\").every((line) => displayWidth(line) <= 40), rendered);\n\n    terminal.input.emit(\"keypress\", undefined, { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"untrusted\");\n    assert.equal(trusted, false);\n    assert.equal(terminal.input.isRaw, false);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"trust prompt neutralizes bidi controls and fits wide Unicode paths by terminal cells\", async () => {\n  const parent = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-trust-bidi-\"));\n  const workspace = path.join(parent, `項目-${\"界\".repeat(30)}-\\u202eabc-\\u200bdef-\\u2060ghi`);\n  fs.mkdirSync(workspace);\n  const terminal = mockTerminal(true, 40);\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: { isTrusted: () => false, trust: () => {} },\n    });\n    await new Promise((resolve) => setImmediate(resolve));\n    const rendered = terminal.text.replace(/\\u001b\\[[0-9;?]*[A-Za-z]/g, \"\");\n    assert.equal(rendered.includes(\"\\u202e\"), false);\n    assert.match(rendered, /�abc/);\n    assert.equal(rendered.includes(\"\\u200b\"), false);\n    assert.equal(rendered.includes(\"\\u2060\"), false);\n    assert.match(rendered, /�def/);\n    assert.match(rendered, /�ghi/);\n    assert.ok(rendered.split(\"\\n\").every((line) => displayWidth(line) <= 40), rendered);\n    terminal.input.emit(\"keypress\", \"\\u001b\", { name: \"escape\" });\n    assert.equal(await decision, \"exit\");\n  } finally {\n    fs.rmSync(parent, { recursive: true, force: true });\n  }\n});\n\ntest(\"trust choice persists workspace trust and returns trusted\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => trusted,\n        trust: () => { trusted = true; },\n      },\n    });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"trusted\");\n    assert.equal(trusted, true);\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"a trust-store write failure leaves the operator free to continue without trust\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n      trustStore: {\n        isTrusted: () => false,\n        trust: () => { throw new Error(\"store unavailable\"); },\n      },\n    });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.match(terminal.text, /Trust was not saved: store unavailable/);\n    terminal.input.emit(\"keypress\", \"\\u001b[B\", { name: \"down\" });\n    terminal.input.emit(\"keypress\", \"\\r\", { name: \"return\" });\n    assert.equal(await decision, \"untrusted\");\n  } finally {\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"escape exits without recording trust\", async () => {\n  const workspace = workspaceWithInstructions();\n  const terminal = mockTerminal();\n  let trusted = false;\n  try {\n    const decision = promptWorkspaceTrust(workspace, {\n      ...terminal,\n119:| REQ-SEC-101 | Audit; DEC-01 (amended 2026-10-24) | Without operator opt-in, model-initiated exec and egress require the configured permission decision. Folder trust does not select or change approval mode; unset mode defaults to review. | safety | `config.ts`, `sidecar.ts`, `repl.ts`, `index.ts`, `core/approval_policy.ts` | TEST `test:cli/test/approval_policy.test.ts::\"REQ-SEC-101: the unset mode stays review in trusted and untrusted workspaces\"`; `test:cli/test/config.test.ts::\"workspace trust does not select the tool approval mode\"`; PTY ACC-SAFE-01 still pending | partial | ACC-SAFE-01 | **B** | SEC-01, TUI-07 | SPEC-01 / PLAN-01 |\n122:| REQ-SEC-119 | Audit; DEC-01 (amended 2026-10-24) | Nexus-initiated verifier runs are `exec` class and follow configured permission mode; review requires a one-time approval showing the script body. Folder trust alone does not authorize execution; all runs are routed through the runner. | safety | `agent.ts:1654,3544,4255`; `tester.ts:145`; `verifier_gating.test.ts` | TEST `test:cli/test/verifier_gating.test.ts::\"trusted and untrusted repos in review mode prompt for verifier and script body, write sentinel only after approval, and cache session decision\"`; `test:cli/test/verifier_gating.test.ts::\"denied verifier does not execute verifier and sentinel is not written\"`; `test:cli/test/harness.test.ts::\"run_tests keeps repository test side effects inside worktree authority and honors read-only, dry-run, and required sandbox\"`; PTY ACC-SAFE-09/10 still pending | partial | ACC-SAFE-09, ACC-SAFE-10 | **B** | VER-01, VER-14 | SPEC-01 / PLAN-01 |\n276:| New v1 rows (§3) | 92 | **31 B**, 58 RR, 3 P. 79 open, 9 partial (REQ-SEC-118, REQ-PRV-101, REQ-PRV-103, REQ-PRV-105, REQ-PRV-111, REQ-PER-106, REQ-OPS-101, REQ-QUAL-108, REQ-QUAL-110), 1 implemented (REQ-OPS-103), 4 tested (REQ-SEC-103, REQ-SEC-119, REQ-PER-101, REQ-PER-102). |\n","exit_code":0,"duration":{"secs":0,"nanos":38601}},"started_at_ms":1792890207390,"completed_at_ms":1792890207390}}
