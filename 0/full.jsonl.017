"No active plan currently defined. Use '/plan add <milestone>' to create phases.\\n\"));\n              } else {\n                this.agent.getUi().renderPlan(plan);\n              }\n            }\n            continue;\n          } else if (cmd === \"onboard\") {\n            console.log(pc.dim(`🔍 Scanning workspace at ${this.config.workspace}...`));\n            const report = scanAndOnboardWorkspace(this.config.workspace, true);\n            console.log(pc.green(`✔ Onboarding complete for ${pc.bold(report.projectName)}!`));\n            console.log(`  • Detected stack: ${pc.cyan(report.languages.join(\", \") || \"General\")}`);\n            console.log(`  • Detected commands: build: ${report.buildCommands[0] || \"none\"}, test: ${report.testCommands[0] || \"none\"}, lint: ${report.lintCommands[0] || \"none\"}`);\n            console.log(`  • Generated customized ${pc.bold(\"AGENTS.md\")} with architecture diagram.\\n`);\n            continue;\n          } else if (cmd === \"test\") {\n            const filterPattern = arg.trim() || undefined;\n            const discovered = discoverVerifier(this.config.workspace, filterPattern);\n            if (!discovered) {\n              console.log(pc.yellow(\"  no verifier: no verification command is configured or discovered in this workspace.\\n\"));\n              continue;\n            }\n            const commandOverride = discovered.command;\n            const desc = describeVerifier(this.config.workspace, commandOverride);\n            const testCmd = desc?.command || commandOverride;\n\n            // Verifier gating follows the permission mode; trust only controls workspace integrations.\n            const isTrusted = isWorkspaceTrusted(this.config.workspace, Boolean(this.config.readOnly));\n            const mode = this.config.approvalMode ?? (this.config.readOnly ? \"read-only\" : (this.config.fullAccess ? \"auto\" : \"review\"));\n            const policyContext: PolicyContext = {\n              mode,\n              trusted: isTrusted,\n              sandbox: this.config.sandbox,\n              fullAccess: Boolean(this.config.fullAccess),\n            };\n            if (this.agent.getApprovalPolicy().requiresDecision(\"exec\", policyContext)) {\n              const approved = await this.confirmAction(\"verifier\", {\n                command: testCmd,\n                script: desc?.script,\n                detail: desc?.evidence,\n                digest: desc?.digest,\n              });\n              if (!approved) {\n                console.log(pc.yellow(\"  Test run aborted by user.\\n\"));\n                continue;\n              }\n            }\n\n            console.log(pc.dim(`🧪 Running automated test suite${filterPattern ? ` matching \"${filterPattern}\"` : \"\"}...`));\n            const bridge = this.agent.getBridge();\n            const timeoutSecs = verifierTimeoutSecs(this.config.verifierTimeoutSecs);\n            const res = await runTestSuiteWithExecutor(\n              this.config.workspace,\n              (command) => bridge.executeTool(\"run_command\", { command, timeout_secs: timeoutSecs }),\n              commandOverride,\n            );\n            console.log(pc.dim(`  Command: ${res.command}`));\n            if (res.success) {\n              console.log(pc.green(`✔ Test suite PASSED!\\n`));\n            } else {\n              console.log(pc.red(`✖ Test suite FAILED.`));\n              if (res.failures.length > 0) {\n                console.log(pc.bold(pc.red(\"\\nFailing Tests:\")));\n                res.failures.slice(0, 10).forEach((f) => console.log(`  • ${pc.red(f)}`));\n              }\n              if (res.diagnostics.length > 0) {\n                console.log(pc.bold(pc.yellow(\"\\nParsed Diagnostics:\")));\n                res.diagnostics.slice(0, 5).forEach((d) => {\n                  console.log(`  • [${d.severity.toUpperCase()}] ${d.file || \"unknown\"}:${d.line || \"?\"} - ${d.message}`);\n                });\n              }\ncli/src/tools.ts:1530:            if (!sandboxed.sandboxed || sandboxed.engine !== \"bwrap\" || !sandboxed.argv) {\ncli/src/sandbox.ts:6:export type SandboxMode = \"auto\" | \"bwrap\" | \"docker\" | \"none\";\ncli/src/sandbox.ts:22:  engine: \"bwrap\" | \"docker\" | \"none\";\ncli/src/sandbox.ts:34: * Check if bubblewrap (bwrap) sandbox utility is installed\ncli/src/sandbox.ts:38:    execFileSync(\"bwrap\", [\"--version\"], { stdio: [\"ignore\", \"ignore\", \"ignore\"], timeout: 2000 });\ncli/src/sandbox.ts:58:  if (mode === \"bwrap\") return probeBwrapSandbox();\ncli/src/sandbox.ts:177:  const root = fs.mkdtempSync(path.join(os.homedir(), \".nexus-bwrap-probe-\"));\ncli/src/sandbox.ts:183:    const probe = wrapSandboxedCommand(`printf escaped > ${JSON.stringify(outside)}; printf writable > probe.txt`, workspace, { mode: \"bwrap\" });\ncli/src/sandbox.ts:236:  // 1. Try Bubblewrap (bwrap)\ncli/src/sandbox.ts:237:  if (mode === \"bwrap\" || (mode === \"auto\" && isBwrapAvailable())) {\ncli/src/sandbox.ts:238:    if (!isBwrapAvailable() && mode === \"bwrap\") {\ncli/src/sandbox.ts:243:        warning: \"Bubblewrap (bwrap) is requested but not found in PATH.\",\ncli/src/sandbox.ts:248:    const bwrapArgs: string[] = [\"bwrap\"];\ncli/src/sandbox.ts:262:      bwrapArgs.push(\"--unshare-pid\");\ncli/src/sandbox.ts:272:      bwrapArgs.push(\"--tmpfs\", \"/\");\ncli/src/sandbox.ts:275:        appendDirectoryTree(bwrapArgs, mountpoint, knownDirectories);\ncli/src/sandbox.ts:280:        appendDirectoryTree(bwrapArgs, userHome, knownDirectories);\ncli/src/sandbox.ts:286:        appendDirectoryTree(bwrapArgs, absWorkspace, knownDirectories);\ncli/src/sandbox.ts:289:      appendReadOnlyRuntime(bwrapArgs, knownDirectories);\ncli/src/sandbox.ts:291:      bwrapArgs.push(\"--remount-ro\", \"/\");\ncli/src/sandbox.ts:292:      bwrapArgs.push(\"--dev\", \"/dev\", \"--proc\", \"/proc\", \"--tmpfs\", \"/tmp\");\ncli/src/sandbox.ts:296:          appendDirectoryTree(bwrapArgs, userHome, new S