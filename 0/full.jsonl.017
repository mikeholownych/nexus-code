cript: (n) => n === 1 ? { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"a.txt\", content: \"1\" } }] } : n === 2 ? { kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary: \"ok\" } }] } : { kind: \"text\", content: \"x\" }, files: {}, code: 2, outcome: \"UNVERIFIED\", execution: \"COMPLETED\", success: false },\ncli/test/approval_policy.test.ts:164:    // Auto mode follows the operator's permission setting in both trusted and untrusted folders.\ncli/test/approval_policy.test.ts:191:  test(\"REQ-SEC-101: the unset mode stays review in trusted and untrusted workspaces\", async () => {\ncli/test/verifier_gating.test.ts:2: * SPEC-01 §3 rule 8 & ACC-SAFE-09: Verifier executions that Nexus initiates itself\ncli/test/verifier_gating.test.ts:4: * - In review mode, the first verifier run requires a one-time approval with command and script body.\ncli/test/verifier_gating.test.ts:45:describe(\"ACC-SAFE-09: Verifier Gating\", () => {\ncli/test/verifier_gating.test.ts:71:  test(\"describeVerifier extracts command, script body from package.json, and sha256 digest\", () => {\ncli/test/verifier_gating.test.ts:75:      assert.ok(desc, \"verifier should be discovered\");\ncli/test/verifier_gating.test.ts:85:  test(\"trusted and untrusted repos in review mode prompt for verifier and script body, write sentinel only after approval, and cache session decision\", async () => {\ncli/test/verifier_gating.test.ts:120:            // Sentinel must NOT be written before verifier is approved!\ncli/test/verifier_gating.test.ts:124:          if (tool === \"verifier\") {\ncli/test/verifier_gating.test.ts:125:            // Sentinel must NOT be written before operator confirms verifier!\ncli/test/verifier_gating.test.ts:126:            assert.equal(fs.existsSync(sentinelPath), false, \"sentinel must not exist before verifier is confirmed\");\ncli/test/verifier_gating.test.ts:136:        // Sentinel was written by the approved verifier execution!\ncli/test/verifier_gating.test.ts:137:        assert.equal(fs.existsSync(sentinelPath), true, \"sentinel must be written after verifier was approved and executed\");\ncli/test/verifier_gating.test.ts:140:        const verifierPrompts = promptLog.filter((p) => p.tool === \"verifier\");\ncli/test/verifier_gating.test.ts:141:        assert.equal(verifierPrompts.length, 1, \"verifier should only be prompted once during the session\");\ncli/test/verifier_gating.test.ts:152:  test(\"denied verifier does not execute verifier and sentinel is not written\", async () => {\ncli/test/verifier_gating.test.ts:177:        if (tool === \"verifier\") return false; // Reject verifier execution\ncli/test/verifier_gating.test.ts:181:      assert.equal(fs.existsSync(sentinelPath), false, \"sentinel must NOT be written when verifier was denied\");\ncli/test/verifier_gating.test.ts:193:    test(`${trusted ? \"trusted\" : \"untrusted\"} repo in explicitly configured auto mode runs verifier without prompts`, async () => {\ncli/test/verifier_gating.test.ts:238:  test(\"headless execution refuses verifier output without a matching pre-change baseline\", async () => {\ncli/test/verifier_gating.test.ts:274:        \"headless execution must reject a verifier result without a trusted pre-change baseline\",\ncli/test/verifier_gating.test.ts:285:  test(\"headless execution on untrusted workspace denies verifier execution without an operator\", async () => {\ncli/test/verifier_gating.test.ts:314:      // Headless execution has no onConfirm handler and must not execute the verifier.\ncli/test/verifier_gating.test.ts:323:        \"headless execution without an operator must deny verifier execution\",\ncli/test/verifier_gating.test.ts:327:      assert.equal(fs.existsSync(sentinelPath), false, \"the verifier must not execute without operator approval\");\ncli/test/check_requirements.test.ts:37:  const evidenceIds = options.evidenceIds ?? [\"ACC-SAFE-01\"];\ncli/test/check_requirements.test.ts:64:    \"| ACC-SAFE-01 | fix