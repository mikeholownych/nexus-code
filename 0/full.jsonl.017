d `r1d.py` into `cli/test/repl_approval_e2e.test.ts`, using the existing PTY helper in `cli/test/helpers/fixtures.ts`. Covers ACC-SAFE-03.\ndocs/v1.0.0/plans/PLAN-01-safe-execution-defaults.md:92:- ACC-SAFE-01 to ACC-SAFE-10 pass in CI. The PTY tests run in CI (they already run in `linux-x86_64`).\ncli/test/check_requirements.test.ts:37:  const evidenceIds = options.evidenceIds ?? [\"ACC-SAFE-01\"];\ncli/test/check_requirements.test.ts:64:    \"| ACC-SAFE-01 | fixture acceptance |\",\ncli/test/check_requirements.test.ts:79:  fs.writeFileSync(path.join(root, \"docs\", \"v1.0.0\", \"specs\", \"SPEC-01.md\"), \"| ACC-SAFE-01 | fixture |\\n\");\ncli/test/check_requirements.test.ts:192:  const file = ledger('| REQ-SEC-101 | x | x | x | x | test:cli/test/config.test.ts::\"no such test name\" | tested | ACC-SAFE-01 | **B** | x | SPEC-01 / PLAN-01 |');\ncli/test/check_requirements.test.ts:205:  const file = ledger('| REQ-SEC-101 | x | x | x | x | test:cli/test/config.test.ts::\"buildConfig applies flags\" | open | ACC-SAFE-01 | **B** | x | SPEC-01 / PLAN-01 |');\ncli/test/check_requirements.test.ts:213:  const row = '| REQ-SEC-101 | x | x | x | x | x | open | ACC-SAFE-01 | **B** | x | SPEC-01 / PLAN-01 |';\ncli/test/check_requirements.test.ts:536:  fs.writeFileSync(ledgerPath, fs.readFileSync(ledgerPath, \"utf8\").replace(\"ACC-SAFE-01 | **B**\", \"ACC-SAFE-01 to ACC-SAFE-02 | **B**\"));\ncli/test/verifier_gating.test.ts:2: * SPEC-01 §3 rule 8 & ACC-SAFE-09: Verifier executions that Nexus initiates itself\ncli/test/verifier_gating.test.ts:45:describe(\"ACC-SAFE-09: Verifier Gating\", () => {\n","exit_code":0,"duration":{"secs":0,"nanos":806279395}},"started_at_ms":1792884740705,"completed_at_ms":1792884741511}}
