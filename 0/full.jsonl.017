{"timestamp":"2026-10-24T21:53:57.186Z","ordinal":311482,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16fd6-d88e-7ad0-8956-d61230292d9e","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a16fd6-d88e-7ad0-8956-d61230292d9e","response_id":"resp_060b64278a9dfb15016add28f04a9881a0b2b8f3c16f1d75a5","usage":{"input_tokens":109495,"cached_input_tokens":107904,"cache_write_input_tokens":0,"output_tokens":521,"reasoning_output_tokens":429,"total_tokens":110016},"turn_token_usage":{"input_tokens":15095289,"cached_input_tokens":14898944,"cache_write_input_tokens":0,"output_tokens":58690,"reasoning_output_tokens":38645,"total_tokens":15153979},"thread_token_usage":{"input_tokens":5637288430,"cached_input_tokens":5576294400,"cache_write_input_tokens":0,"output_tokens":16041602,"reasoning_output_tokens":9221818,"total_tokens":5653330032}}}
{"timestamp":"2026-10-24T21:53:58.897Z","ordinal":311483,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a16fd6-d88e-7ad0-8956-d61230292d9e","item":{"type":"CommandExecution","id":"exec-d5225aad-6fe1-46bd-b3e4-00023a41f9e2","process_id":"97979","command":["/usr/bin/zsh","-lc","sed -n '1,180p' scripts/check_requirements.mjs && sed -n '1,200p' cli/test/verifier_gating.test.ts"],"cwd":"file:///home/mike/nexus-wt/startup-folder-trust-copy","parsed_cmd":[{"type":"read","cmd":"sed -n '1,180p' scripts/check_requirements.mjs","name":"check_requirements.mjs","path":"scripts/check_requirements.mjs"},{"type":"read","cmd":"sed -n '1,200p' cli/test/verifier_gating.test.ts","name":"verifier_gating.test.ts","path":"cli/test/verifier_gating.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"// Checks docs/v1.0.0/REQUIREMENTS.md against the rest of the repository (REQ-OPS-102).\n//   report mode (default): every B/RR row links a spec, a plan and an acceptance ID; every ACC id it names is defined\n//     (in a spec table, a spec's \"ACC-X-01 to ACC-X-NN\" range, or ACCEPTANCE.md); every `test:<file>::\"<name>\"` reference\n//     in a row names an existing test file that contains <name>.\n//   --enforce (pre-RC source gate): every B/RR row is at least `tested`, except rows explicitly\n//     mapped to post-RC qualification in ACCEPTANCE.md. Those rows remain deferred, not accepted.\n//     Exact-RC enforcement requires a qualification record with after-RC evidence for every mapped row.\n// Exit 1 on any problem; prints a summary table either way. `--ledger <file>` checks another ledger (used by its test).\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { execFileSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst args = process.argv.slice(2);\nconst enforce = args.includes(\"--enforce\");\nconst ledgerArg = args.indexOf(\"--ledger\");\nconst qualificationArg = args.indexOf(\"--qualification-record\");\nconst artifactArg = args.indexOf(\"--rc-artifact\");\nconst evidenceRootArg = args.indexOf(\"--evidence-root\");\nconst qualificationMode = [qualificationArg, artifactArg, evidenceRootArg].some((i) => i >= 0);\nconst pkg = path.join(root, \"docs\", \"v1.0.0\");\nconst ledgerPath = ledgerArg >= 0 ? path.resolve(args[ledgerArg + 1]) : path.join(pkg, \"REQUIREMENTS.md\");\n\nconst read = (p) => fs.readFileSync(p, \"utf8\");\nconst specs = fs.readdirSync(path.join(pkg, \"specs\")).map((f) => read(path.join(pkg, \"specs\", f)));\nconst acceptance = read(path.join(pkg, \"ACCEPTANCE.md\"));\nconst decisions = read(path.join(pkg, \"DECISIONS.md\"));\n\nfunction accDefined(id) {\n  const cell = new RegExp(`\\\\|\\\\s*${id}\\\\s*\\\\|`);\n  if (specs.some((s) => cell.test(s)) || cell.test(acceptance)) return true;\n  const m = /^ACC-([A-Z0-9]+)-(\\d+)$/.exec(id);\n  if (!m) return false;\n  const range = new RegExp(`ACC-${m[1]}-(\\\\d+) to ACC-${m[1]}-(\\\\d+)`, \"g\");\n  return specs.some((s) => [...s.matchAll(range)].some((r) => Number(r[1]) <= Number(m[2]) && Number(m[2]) <= Number(r[2])));\n}\n\nfunction testExists(file, name) {\n  const p = path.join(root, file);\n  return fs.existsSync(p) && read(p).includes(name);\n}\n\nfunction acceptanceIds(value) {\n  const ids = new Set(value.match(/(?<![A-Za-z0-9_-])ACC-[A-Z0-9]+(?:-[A-Z0-9]+)*(?![A-Za-z0-9_-])/g) ?? []);\n  const ranges = /ACC-([A-Z0-9]+)-(\\d+)\\s+to\\s+ACC-\\1-(\\d+)/g;\n  for (const [, family, first, last] of value.matchAll(ranges)) {\n    for (let number = Number(first); number <= Number(last); number++) ids.add(`ACC-${family}-${String(number).padStart(first.length, \"0\")}`);\n  }\n  return [...ids];\n}\n\nfunction decisionSection(decision) {\n  if (typeof decision !== \"string\" || !/^DEC-\\d{2}$/.test(decision)) return \"\";\n  const heading = new RegExp(`^## ${decision}:[^\\\\n]*`, \"m\").exec(decisions);\n  if (!heading) return \"\";\n  const start = heading.index + heading[0].length;\n  const remaining = decisions.slice(start);\n  const nextHeading = /^## /m.exec(remaining);\n  return remaining.slice(0, nextHeading ? nextHeading.index : remaining.length);\n}\n\nconst RANK = { open: 0, partial: 1, implemented: 2, tested: 3, \"visually-accepted\": 4, \"product-qualified\": 5 };\nconst problems = [];\nconst counts = {};\nconst requiredRows = new Map();\nconst seenRequirementIds = new Set();\nconst deferredQualificationRows = [];\nlet rows = 0;\nlet header = null;\nfor (const line of read(ledgerPath).split(\"\\n\")) {\n  if (!line.startsWith(\"|\")) { header = null; continue; }\n  const cells = line.slice(1, -1).split(\"|\").map((c) => c.trim());\n  if (cells[0] === \"ID\") { header = cells; continue; }\n  if (!header || !/^REQ-[A-Z]+-\\d+[a-z]?$/.test(cells[0])) continue;\n  const col = (name) => cells[header.findIndex((h) => h.startsWith(name))] ?? \"\";\n  const id = cells[0];\n  const cls = col(\"Class\");\n  const status = col(\"Status\").split(/[\\s(]/)[0];\n  const acc = col(\"Acceptance\");\n  const links = col(\"Spec\") || col(\"Links\");\n  const blocking = /\\*\\*B\\*\\*/.test(cls) || /^B\\b/.test(cls);\n  const required = blocking || /^RR\\b/.test(cls);\n  rows++;\n  counts[status] = (counts[status] ?? 0) + 1;\n  if (seenRequirementIds.has(id)) problems.push(`${id}: duplicate requirement ID in ledger`);\n  else seenRequirementIds.add(id);\n  if (required && !requiredRows.has(id)) requiredRows.set(id, { id, blocking, status, acceptanceIds: acceptanceIds(acc), line });\n  for (const accId of line.match(/(?<![A-Za-z0-9_-])ACC-[A-Z0-9]+(?:-[A-Z0-9]+)*(?![A-Za-z0-9_-])/g) ?? []) {\n    if (!accDefined(accId)) problems.push(`${id}: ${accId} is not defined in any spec or ACCEPTANCE.md`);\n  }\n  for (const m of line.matchAll(/test:([\\w./-]+)::\"([^\"]+)\"/g)) {\n    if (!testExists(m[1], m[2])) problems.push(`${id}: test reference ${m[1]}::\"${m[2]}\" not found`);\n  }\n  if (required && /^REQ-[A-Z]+-1\\d\\d/.test(id)) {\n    if (!/SPEC-\\w+/.test(links) || !/PLAN-\\w+/.test(links)) problems.push(`${id}: ${blocking ? \"blocker\" : \"release-required\"} row lacks a SPEC and PLAN link`);\n    if (!/ACC-|ACCEPTANCE/.test(acc)) problems.push(`${id}: no acceptance reference`);\n  }\n}\n\nfunction qualificationOnlyRequirements() {\n  // --ledger is a general fixture/report facility, not the authoritative release source. Exact-RC mode rejects it.\n  if (ledgerArg >= 0) return new Map();\n  const match = /<!-- RC-QUALIFICATION-ONLY:START -->([\\s\\S]*?)<!-- RC-QUALIFICATION-ONLY:END -->/.exec(acceptance);\n  const result = new Map();\n  if (!match) {\n    problems.push(\"ACCEPTANCE.md is missing the exact-RC qualification-only requirement map\");\n    return result;\n  }\n  for (const line of match[1].split(\"\\n\")) {\n    if (!line.startsWith(\"| REQ-\")) continue;\n    const cells = line.slice(1, -1).split(\"|\").map((cell) => cell.trim());\n    const [id, criteria] = cells;\n    if (!/^REQ-[A-Z]+-\\d+[a-z]?$/.test(id) || !requiredRows.has(id)) {\n      problems.push(`qualification-only map references unknown or non-required requirement ${id}`);\n      continue;\n    }\n    if (result.has(id)) {\n      problems.push(`qualification-only map repeats ${id}`);\n      continue;\n    }\n    const ids = acceptanceIds(criteria);\n    if (ids.length === 0) problems.push(`${id}: qualification-only map must name acceptance criteria`);\n    for (const accId of ids) {\n      if (!accDefined(accId)) problems.push(`${id}: qualification-only criterion ${accId} is not defined`);\n    }\n    for (const accId of requiredRows.get(id).acceptanceIds) {\n      if (!ids.includes(accId)) problems.push(`${id}: qualification-only map omits ledger acceptance criterion ${accId}`);\n    }\n    result.set(id, ids);\n  }\n  return result;\n}\n\nconst rcQualificationOnly = qualificationOnlyRequirements();\n\nfunction qualificationExceptions() {\n  if (ledgerArg >= 0) return new Map();\n  const match = /<!-- RC-QUALIFICATION-EXCEPTIONS:START -->([\\s\\S]*?)<!-- RC-QUALIFICATION-EXCEPTIONS:END -->/.exec(acceptance);\n  const result = new Map();\n  if (!match) {\n    problems.push(\"ACCEPTANCE.md is missing the approved exact-RC qualification exception map\");\n    return result;\n  }\n  for (const line of match[1].split(\"\\n\")) {\n    if (!line.startsWith(\"| REQ-\")) continue;\n    const cells = line.slice(1, -1).split(\"|\").map((cell) => cell.trim());\n    const [id, decision] = cells;\n    if (!/^REQ-[A-Z]+-\\d+[a-z]?$/.test(id) || requiredRows.get(id)?.blocking !== true) {\n      problems.push(\"qualification exception map references unknown or non-blocking requirement \" + id);\n      continue;\n    }\n    if (result.has(id)) {\n      problems.push(\"qualification exception map repeats \" + id);\n      continue;\n    }\n    if (!/^DEC-\\d{2}$/.test(decision) || !decisionSection(decision)) {\n      problems.push(id + \": qualification exception map must cite an existing decision\");\n      continue;\n    }\n    result.set(id, decision);\n  }\n  return result;\n}\n\nconst rcQualificationExceptions = qualificationExceptions();\n\nconst sha256 = (file) => {\n  // Keep hashing synchronous with the checker's other filesystem validation.\n  return createHash(\"sha256\").update(fs.readFileSync(file)).digest(\"hex\");\n};\nfunction hasSymlinkComponent(absolutePath) {\n  const resolved = path.resolve(absolutePath);\n  let current = path.parse(resolved).root;\n  for (const part of resolved.slice(current.length).split(path.sep).filter(Boolean)) {\n    current = path.join(current, part);\n    try {\n      if (fs.lstatSync(current).isSymbolicLink()) return true;\n    } catch {\n/**\n * SPEC-01 §3 rule 8 & ACC-SAFE-09: Verifier executions that Nexus initiates itself\n * (change baseline, completion oracle, independence copy, /test) are exec-class actions.\n * - In review mode, the first verifier run requires a one-time approval with command and script body.\n * - Explicit auto mode runs without asking regardless of workspace trust.\n * - Approvals are cached per (workspace, command, digest) for the session.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execSync } from \"node:child_process\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { isWorkspaceTrusted, setWorkspaceTrusted } from \"../src/workspace_trust.js\";\nimport { describeVerifier } from \"../src/tester.js\";\nimport { startGateway } from \"./helpers/provider_fixture.js\";\n\nfunction setupRepo(name: string): { ws: string; sentinelPath: string } {\n  const ws = fs.mkdtempSync(path.join(os.tmpdir(), `nexus-vg-${name}-`));\n  const sentinelPath = path.join(ws, \"sentinel.txt\");\n  const testScript = `const fs = require('fs'); fs.writeFileSync(${JSON.stringify(sentinelPath)}, 'ok');`;\n  fs.writeFileSync(path.join(ws, \"test.js\"), testScript);\n  fs.writeFileSync(\n    path.join(ws, \"package.json\"),\n    JSON.stringify(\n      {\n        name: \"vg-fixture\",\n        scripts: {\n          test: \"node test.js\",\n        },\n      },\n      null,\n      2,\n    ),\n  );\n  fs.writeFileSync(path.join(ws, \"file.txt\"), \"hello\\n\");\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm init\", {\n    cwd: ws,\n    stdio: \"ignore\",\n  });\n  return { ws, sentinelPath };\n}\n\ndescribe(\"ACC-SAFE-09: Verifier Gating\", () => {\n  test(\"folder trust alone keeps an unset permission mode in review\", () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n    process.env.HOME = tempHome;\n\n    const { ws } = setupRepo(\"default-review-trusted\");\n    setWorkspaceTrusted(ws, true);\n    const agent = new AutonomousAgent({\n      endpoint: \"http://127.0.0.1:1/v1\",\n      model: \"m\",\n      workspace: ws,\n      shell: \"bash\",\n    } as any);\n\n    try {\n      assert.equal(isWorkspaceTrusted(ws), true, \"repo should be trusted\");\n      assert.equal(agent.getApprovalMode(), \"review\");\n    } finally {\n      agent.shutdown();\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(tempHome, { recursive: true, force: true });\n      process.env.HOME = savedHome;\n    }\n  });\n\n  test(\"describeVerifier extracts command, script body from package.json, and sha256 digest\", () => {\n    const { ws } = setupRepo(\"describe\");\n    try {\n      const desc = describeVerifier(ws);\n      assert.ok(desc, \"verifier should be discovered\");\n      assert.equal(desc.command, \"npm test\");\n      assert.equal(desc.script, \"node test.js\");\n      assert.equal(desc.evidence, \"package.json:scripts.test\");\n      assert.ok(/^[0-9a-f]{64}$/.test(desc.digest), `digest should be sha256 hex: ${desc.digest}`);\n    } finally {\n      fs.rmSync(ws, { recursive: true, force: true });\n    }\n  });\n\n  for (const trusted of [false, true]) {\n    test(`${trusted ? \"trusted\" : \"untrusted\"} repo in review mode prompts for verifier and script body, writes sentinel only after approval, and caches session decision`, async () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n    process.env.HOME = tempHome;\n\n    const { ws, sentinelPath } = setupRepo(`review-${trusted ? \"trusted\" : \"untrusted\"}`);\n    if (trusted) setWorkspaceTrusted(ws, true);\n    const replies = [\n      {\n        kind: \"tools\" as const,\n        calls: [{ name: \"edit_file\", args: { path: \"file.txt\", old_content: \"hello\\n\", new_content: \"world\\n\" } }],\n      },\n      {\n        kind: \"tools\" as const,\n        calls: [{ name: \"task_completed\", args: { summary: \"Finished editing file\" } }],\n      },\n      { kind: \"text\" as const, content: \"Done.\" },\n    ];\n    const gw = await startGateway((n) => replies[Math.min(n, replies.length) - 1]);\n    const agent = new AutonomousAgent({\n      endpoint: gw.url,\n      model: \"m\",\n      workspace: ws,\n      shell: \"bash\",\n      approvalMode: \"review\",\n    } as any);\n\n    const promptLog: Array<{ tool: string; args: any }> = [];\n    try {\n      assert.equal(isWorkspaceTrusted(ws), trusted, `repo trust should be ${trusted}`);\n\n      await agent.runTurn(\"make changes and finish\", async (tool, args) => {\n        promptLog.push({ tool, args });\n        if (tool === \"edit_file\") {\n          // Sentinel must NOT be written before verifier is approved!\n          assert.equal(fs.existsSync(sentinelPath), false, \"sentinel must not exist when edit_file is prompted\");\n          return true;\n        }\n        if (tool === \"verifier\") {\n          // Sentinel must NOT be written before operator confirms verifier!\n          assert.equal(fs.existsSync(sentinelPath), false, \"sentinel must not exist before verifier is confirmed\");\n          assert.equal(args.command, \"npm test\");\n          assert.equal(args.script, \"node test.js\");\n          assert.equal(args.detail, \"package.json:scripts.test\");\n          assert.ok(args.digest, \"digest must be provided\");\n          return true;\n        }\n        return true;\n      });\n\n      // Sentinel was written by the approved verifier execution!\n      assert.equal(fs.existsSync(sentinelPath), true, \"sentinel must be written after verifier was approved and executed\");\n\n      // Verifier should be prompted exactly once because session caching applies\n      const verifierPrompts = promptLog.filter((p) => p.tool === \"verifier\");\n      assert.equal(verifierPrompts.length, 1, \"verifier should only be prompted once during the session\");\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(tempHome, { recursive: true, force: true });\n      process.env.HOME = savedHome;\n    }\n    });\n  }\n\n  test(\"denied verifier does not execute verifier and sentinel is not written\", async () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n    process.env.HOME = tempHome;\n\n    const { ws, sentinelPath } = setupRepo(\"denied\");\n    const replies = [\n      {\n        kind: \"tools\" as const,\n        calls: [{ name: \"edit_file\", args: { path: \"file.txt\", old_content: \"hello\\n\", new_content: \"world\\n\" } }],\n      },\n      { kind: \"text\" as const, content: \"Done.\" },\n    ];\n    const gw = await startGateway((n) => replies[Math.min(n, replies.length) - 1]);\n    const agent = new AutonomousAgent({\n      endpoint: gw.url,\n      model: \"m\",\n      workspace: ws,\n      shell: \"bash\",\n      approvalMode: \"review\",\n    } as any);\n\n    try {\n      await agent.runTurn(\"make change\", async (tool) => {\n        if (tool === \"edit_file\") return true;\n        if (tool === \"verifier\") return false; // Reject verifier execution\n        return false;\n      });\n\n      assert.equal(fs.existsSync(sentinelPath), false, \"sentinel must NOT be written when verifier was denied\");\n      assert.equal(fs.readFileSync(path.join(ws, \"file.txt\"), \"utf-8\"), \"world\\n\", \"file edit still succeeded\");\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(tempHome, { recursive: true, force: true });\n      process.env.HOME = savedHome;\n    }\n  });\n\n  for (const trusted of [false, true]) {\n    test(`${trusted ? \"trusted\" : \"untrusted\"} repo in explicitly configured auto mode runs verifier without prompts`, async () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n    process.env.HOME = tempHome;\n\n    const { ws, sentinelPath } = setupRepo(`auto-${trusted ? \"trusted\" : \"untrusted\"}`);\n    if (trusted) setWorkspaceTrusted(ws, true);\n\n","exit_code":0,"duration":{"secs":0,"nanos":731865063}},"started_at_ms":1792878838164,"completed_at_ms":1792878838897}}
{"timestamp":"2026-10-24T21:53:59.868Z","ordinal":311484,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a16fe8-083b-7220-8537-3fca49d9fcd7","call_id":"call_40d426b53b944859b5f61ff0b926ab10","output":[{"type":"input_text","text":"Script completed\nWall time 2.8 seconds\nOutput:\n"},{"type":"input_text","text":"// Checks docs/v1.0.0/REQUIREMENTS.md against the rest of the repository (REQ-OPS-102).\n//   report mode (default): every B/RR row links a spec, a plan and an acceptance ID; every ACC id it names is defined\n//     (in a spec table, a spec's \"ACC-X-01 to ACC-X-NN\" range, or ACCEPTANCE.md); every `test:<file>::\"<name>\"` reference\n//     in a row names an existing test file that contains <name>.\n//   --enforce (pre-RC source gate): every B/RR row is at least `tested`, except rows explicitly\n//     mapped to post-RC qualification in ACCEPTANCE.md. Those rows remain deferred, not accepted.\n//     Exact-RC enforcement requires a qualification record with after-RC evidence for every mapped row.\n// Exit 1 on any problem; prints a summary table either way. `--ledger <file>` checks another ledger (used by its test).\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { execFileSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst args = process.argv.slice(2);\nconst enforce = args.includes(\"--enforce\");\nconst ledgerArg = args.indexOf(\"--ledger\");\nconst qualificationArg = args.indexOf(\"--qualification-record\");\nconst artifactArg = args.indexOf(\"--rc-artifact\");\nconst evidenceRootArg = args.indexOf(\"--evidence-root\");\nconst qualificationMode = [qualificationArg, artifactArg, evidenceRootArg].some((i) => i >= 0);\nconst pkg = path.join(root, \"docs\", \"v1.0.0\");\nconst ledgerPath = ledgerArg >= 0 ? path.resolve(args[ledgerArg + 1]) : path.join(pkg, \"REQUIREMENTS.md\");\n\nconst read = (p) => fs.readFileSync(p, \"utf8\");\nconst specs = fs.readdirSync(path.join(pkg, \"specs\")).map((f) => read(path.join(pkg, \"specs\", f)));\nconst acceptance = read(path.join(pkg, \"ACCEPTANCE.md\"));\nconst decisions = read(path.join(pkg, \"DECISIONS.md\"));\n\nfunction accDefined(id) {\n  const cell = new RegExp(`\\\\|\\\\s*${id}\\\\s*\\\\|`);\n  if (specs.some((s) => cell.test(s)) || cell.test(acceptance)) return true;\n  const m = /^ACC-([A-Z0-9]+)-(\\d+)$/.exec(id);\n  if (!m) return false;\n  const range = new RegExp(`ACC-${m[1]}-(\\\\d+) to ACC-${m[1]}-(\\\\d+)`, \"g\");\n  return specs.some((s) => [...s.matchAll(range)].some((r) => Number(r[1]) <= Number(m[2]) && Number(m[2]) <= Number(r[2])));\n}\n\nfunction testExists(file, name) {\n  const p = path.join(root, file);\n  return fs.existsSync(p) && read(p).includes(name);\n}\n\nfunction acceptanceIds(value) {\n  const ids = new Set(value.match(/(?<![A-Za-z0-9_-])ACC-[A-Z0-9]+(?:-[A-Z0-9]+)*(?![A-Za-z0-9_-])/g) ?? []);\n  const ranges = /ACC-([A-Z0-9]+)-(\\d+)\\s+to\\s+ACC-\\1-(\\d+)/g;\n  for (const [, family, first, last] of value.matchAll(ranges)) {\n    for (let number = Number(first); number <= Number(last); number++) ids.add(`ACC-${family}-${String(number).padStart(first.length, \"0\")}`);\n  }\n  return [...ids];\n}\n\nfunction decisionSection(decision) {\n  if (typeof decision !== \"string\" || !/^DEC-\\d{2}$/.test(decision)) return \"\";\n  const heading = new RegExp(`^## ${decision}:[^\\\\n]*`, \"m\").exec(decisions);\n  if (!heading) return \"\";\n  const start = heading.index + heading[0].length;\n  const remaining = decisions.slice(start);\n  const nextHeading = /^## /m.exec(remaining);\n  return remaining.slice(0, nextHeading ? nextHeading.index : remaining.length);\n}\n\nconst RANK = { open: 0, partial: 1, implemented: 2, tested: 3, \"visually-accepted\": 4, \"product-qualified\": 5 };\nconst problems = [];\nconst counts = {};\nconst requiredRows = new Map();\nconst seenRequirementIds = new Set();\nconst deferredQualificationRows = [];\nlet rows = 0;\nlet header = null;\nfor (const line of read(ledgerPath).split(\"\\n\")) {\n  if (!line.startsWith(\"|\")) { header = null; continue; }\n  const cells = line.slice(1, -1).split(\"|\").map((c) => c.trim());\n  if (cells[0] === \"ID\") { header = cells; continue; }\n  if (!header || !/^REQ-[A-Z]+-\\d+[a-z]?$/.test(cells[0])) continue;\n  const col = (name) => cells[header.findIndex((h) => h.startsWith(name))] ?? \"\";\n  const id = cells[0];\n  const cls = col(\"Class\");\n  const status = col(\"Status\").split(/[\\s(]/)[0];\n  const acc = col(\"Acceptance\");\n  const links = col(\"Spec\") || col(\"Links\");\n  const blocking = /\\*\\*B\\*\\*/.test(cls) || /^B\\b/.test(cls);\n  const required = blocking || /^RR\\b/.test(cls);\n  rows++;\n  counts[status] = (counts[status] ?? 0) + 1;\n  if (seenRequirementIds.has(id)) problems.push(`${id}: duplicate requirement ID in ledger`);\n  else seenRequirementIds.add(id);\n  if (required && !requiredRows.has(id)) requiredRows.set(id, { id, blocking, status, acceptanceIds: acceptanceIds(acc), line });\n  for (const accId of line.match(/(?<![A-Za-z0-9_-])ACC-[A-Z0-9]+(?:-[A-Z0-9]+)*(?![A-Za-z0-9_-])/g) ?? []) {\n    if (!accDefined(accId)) problems.push(`${id}: ${accId} is not defined in any spec or ACCEPTANCE.md`);\n  }\n  for (const m of line.matchAll(/test:([\\w./-]+)::\"([^\"]+)\"/g)) {\n    if (!testExists(m[1], m[2])) problems.push(`${id}: test reference ${m[1]}::\"${m[2]}\" not found`);\n  }\n  if (required && /^REQ-[A-Z]+-1\\d\\d/.test(id)) {\n    if (!/SPEC-\\w+/.test(links) || !/PLAN-\\w+/.test(links)) problems.push(`${id}: ${blocking ? \"blocker\" : \"release-required\"} row lacks a SPEC and PLAN link`);\n    if (!/ACC-|ACCEPTANCE/.test(acc)) problems.push(`${id}: no acceptance reference`);\n  }\n}\n\nfunction qualificationOnlyRequirements() {\n  // --ledger is a general fixture/report facility, not the authoritative release source. Exact-RC mode rejects it.\n  if (ledgerArg >= 0) return new Map();\n  const match = /<!-- RC-QUALIFICATION-ONLY:START -->([\\s\\S]*?)<!-- RC-QUALIFICATION-ONLY:END -->/.exec(acceptance);\n  const result = new Map();\n  if (!match) {\n    problems.push(\"ACCEPTANCE.md is missing the exact-RC qualification-only requirement map\");\n    return result;\n  }\n  for (const line of match[1].split(\"\\n\")) {\n    if (!line.startsWith(\"| REQ-\")) continue;\n    const cells = line.slice(1, -1).split(\"|\").map((cell) => cell.trim());\n    const [id, criteria] = cells;\n    if (!/^REQ-[A-Z]+-\\d+[a-z]?$/.test(id) || !requiredRows.has(id)) {\n      problems.push(`qualification-only map references unknown or non-required requirement ${id}`);\n      continue;\n    }\n    if (result.has(id)) {\n      problems.push(`qualification-only map repeats ${id}`);\n      continue;\n    }\n    const ids = acceptanceIds(criteria);\n    if (ids.length === 0) problems.push(`${id}: qualification-only map must name acceptance criteria`);\n    for (const accId of ids) {\n      if (!accDefined(accId)) problems.push(`${id}: qualification-only criterion ${accId} is not defined`);\n    }\n    for (const accId of requiredRows.get(id).acceptanceIds) {\n      if (!ids.includes(accId)) problems.push(`${id}: qualification-only map omits ledger acceptance criterion ${accId}`);\n    }\n    result.set(id, ids);\n  }\n  return result;\n}\n\nconst rcQualificationOnly = qualificationOnlyRequirements();\n\nfunction qualificationExceptions() {\n  if (ledgerArg >= 0) return new Map();\n  const match = /<!-- RC-QUALIFICATION-EXCEPTIONS:START -->([\\s\\S]*?)<!-- RC-QUALIFICATION-EXCEPTIONS:END -->/.exec(acceptance);\n  const result = new Map();\n  if (!match) {\n    problems.push(\"ACCEPTANCE.md is missing the approved exact-RC qualification exception map\");\n    return result;\n  }\n  for (const line of match[1].split(\"\\n\")) {\n    if (!line.startsWith(\"| REQ-\")) continue;\n    const cells = line.slice(1, -1).split(\"|\").map((cell) => cell.trim());\n    const [id, decision] = cells;\n    if (!/^REQ-[A-Z]+-\\d+[a-z]?$/.test(id) || requiredRows.get(id)?.blocking !== true) {\n      problems.push(\"qualification exception map references unknown or non-blocking requirement \" + id);\n      continue;\n    }\n    if (result.has(id)) {\n      problems.push(\"qualification exception map repeats \" + id);\n      continue;\n    }\n    if (!/^DEC-\\d{2}$/.test(decision) || !decisionSection(decision)) {\n      problems.push(id + \": qualification exception map must cite an existing decision\");\n      continue;\n    }\n    result.set(id, decision);\n  }\n  return result;\n}\n\nconst rcQualificationExceptions = qualificationExceptions();\n\nconst sha256 = (file) => {\n  // Keep hashing synchronous with the checker's other filesystem validation.\n  return createHash(\"sha256\").update(fs.readFileSync(file)).digest(\"hex\");\n};\nfunction hasSymlinkComponent(absolutePath) {\n  const resolved = path.resolve(absolutePath);\n  let current = path.parse(resolved).root;\n  for (const part of resolved.slice(current.length).split(path.sep).filter(Boolean)) {\n    current = path.join(current, part);\n    try {\n      if (fs.lstatSync(current).isSymbolicLink()) return true;\n    } catch {\n/**\n * SPEC-01 §3 rule 8 & ACC-SAFE-09: Verifier executions that Nexus initiates itself\n * (change baseline, completion oracle, independence copy, /test) are exec-class actions.\n * - In review mode, the first verifier run requires a one-time approval with command and script body.\n * - Explicit auto mode runs without asking regardless of workspace trust.\n * - Approvals are cached per (workspace, command, digest) for the session.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execSync } from \"node:child_process\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { isWorkspaceTrusted, setWorkspaceTrusted } from \"../src/workspace_trust.js\";\nimport { describeVerifier } from \"../src/tester.js\";\nimport { startGateway } from \"./helpers/provider_fixture.js\";\n\nfunction setupRepo(name: string): { ws: string; sentinelPath: string } {\n  const ws = fs.mkdtempSync(path.join(os.tmpdir(), `nexus-vg-${name}-`));\n  const sentinelPath = path.join(ws, \"sentinel.txt\");\n  const testScript = `const fs = require('fs'); fs.writeFileSync(${JSON.stringify(sentinelPath)}, 'ok');`;\n  fs.writeFileSync(path.join(ws, \"test.js\"), testScript);\n  fs.writeFileSync(\n    path.join(ws, \"package.json\"),\n    JSON.stringify(\n      {\n        name: \"vg-fixture\",\n        scripts: {\n          test: \"node test.js\",\n        },\n      },\n      null,\n      2,\n    ),\n  );\n  fs.writeFileSync(path.join(ws, \"file.txt\"), \"hello\\n\");\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm init\", {\n    cwd: ws,\n    stdio: \"ignore\",\n  });\n  return { ws, sentinelPath };\n}\n\ndescribe(\"ACC-SAFE-09: Verifier Gating\", () => {\n  test(\"folder trust alone keeps an unset permission mode in review\", () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n    process.env.HOME = tempHome;\n\n    const { ws } = setupRepo(\"default-review-trusted\");\n    setWorkspaceTrusted(ws, true);\n    const agent = new AutonomousAgent({\n      endpoint: \"http://127.0.0.1:1/v1\",\n      model: \"m\",\n      workspace: ws,\n      shell: \"bash\",\n    } as any);\n\n    try {\n      assert.equal(isWorkspaceTrusted(ws), true, \"repo should be trusted\");\n      assert.equal(agent.getApprovalMode(), \"review\");\n    } finally {\n      agent.shutdown();\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(tempHome, { recursive: true, force: true });\n      process.env.HOME = savedHome;\n    }\n  });\n\n  test(\"describeVerifier extracts command, script body from package.json, and sha256 digest\", () => {\n    const { ws } = setupRepo(\"describe\");\n    try {\n      const desc = describeVerifier(ws);\n      assert.ok(desc, \"verifier should be discovered\");\n      assert.equal(desc.command, \"npm test\");\n      assert.equal(desc.script, \"node test.js\");\n      assert.equal(desc.evidence, \"package.json:scripts.test\");\n      assert.ok(/^[0-9a-f]{64}$/.test(desc.digest), `digest should be sha256 hex: ${desc.digest}`);\n    } finally {\n      fs.rmSync(ws, { recursive: true, force: true });\n    }\n  });\n\n  for (const trusted of [false, true]) {\n    test(`${trusted ? \"trusted\" : \"untrusted\"} repo in review mode prompts for verifier and script body, writes sentinel only after approval, and caches session decision`, async () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n    process.env.HOME = tempHome;\n\n    const { ws, sentinelPath } = setupRepo(`review-${trusted ? \"trusted\" : \"untrusted\"}`);\n    if (trusted) setWorkspaceTrusted(ws, true);\n    const replies = [\n      {\n        kind: \"tools\" as const,\n        calls: [{ name: \"edit_file\", args: { path: \"file.txt\", old_content: \"hello\\n\", new_content: \"world\\n\" } }],\n      },\n      {\n        kind: \"tools\" as const,\n        calls: [{ name: \"task_completed\", args: { summary: \"Finished editing file\" } }],\n      },\n      { kind: \"text\" as const, content: \"Done.\" },\n    ];\n    const gw = await startGateway((n) => replies[Math.min(n, replies.length) - 1]);\n    const agent = new AutonomousAgent({\n      endpoint: gw.url,\n      model: \"m\",\n      workspace: ws,\n      shell: \"bash\",\n      approvalMode: \"review\",\n    } as any);\n\n    const promptLog: Array<{ tool: string; args: any }> = [];\n    try {\n      assert.equal(isWorkspaceTrusted(ws), trusted, `repo trust should be ${trusted}`);\n\n      await agent.runTurn(\"make changes and finish\", async (tool, args) => {\n        promptLog.push({ tool, args });\n        if (tool === \"edit_file\") {\n          // Sentinel must NOT be written before verifier is approved!\n          assert.equal(fs.existsSync(sentinelPath), false, \"sentinel must not exist when edit_file is prompted\");\n          return true;\n        }\n        if (tool === \"verifier\") {\n          // Sentinel must NOT be written before operator confirms verifier!\n          assert.equal(fs.existsSync(sentinelPath), false, \"sentinel must not exist before verifier is confirmed\");\n          assert.equal(args.command, \"npm test\");\n          assert.equal(args.script, \"node test.js\");\n          assert.equal(args.detail, \"package.json:scripts.test\");\n          assert.ok(args.digest, \"digest must be provided\");\n          return true;\n        }\n        return true;\n      });\n\n      // Sentinel was written by the approved verifier execution!\n      assert.equal(fs.existsSync(sentinelPath), true, \"sentinel must be written after verifier was approved and executed\");\n\n      // Verifier should be prompted exactly once because session caching applies\n      const verifierPrompts = promptLog.filter((p) => p.tool === \"verifier\");\n      assert.equal(verifierPrompts.length, 1, \"verifier should only be prompted once during the session\");\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(tempHome, { recursive: true, force: true });\n      process.env.HOME = savedHome;\n    }\n    });\n  }\n\n  test(\"denied verifier does not execute verifier and sentinel is not written\", async () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n    process.env.HOME = tempHome;\n\n    const { ws, sentinelPath } = setupRepo(\"denied\");\n    const replies = [\n      {\n        kind: \"tools\" as const,\n        calls: [{ name: \"edit_file\", args: { path: \"file.txt\", old_content: \"hello\\n\", new_content: \"world\\n\" } }],\n      },\n      { kind: \"text\" as const, content: \"Done.\" },\n    ];\n    const gw = await startGateway((n) => replies[Math.min(n, replies.length) - 1]);\n    const agent = new AutonomousAgent({\n      endpoint: gw.url,\n      model: \"m\",\n      workspace: ws,\n      shell: \"bash\",\n      approvalMode: \"review\",\n    } as any);\n\n    try {\n      await agent.runTurn(\"make change\", async (tool) => {\n        if (tool === \"edit_file\") return true;\n        if (tool === \"verifier\") return false; // Reject verifier execution\n        return false;\n      });\n\n      assert.equal(fs.existsSync(sentinelPath), false, \"sentinel must NOT be written when verifier was denied\");\n      assert.equal(fs.readFileSync(path.join(ws, \"file.txt\"), \"utf-8\"), \"world\\n\", \"file edit still succeeded\");\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(tempHome, { recursive: true, force: true });\n      process.env.HOME = savedHome;\n    }\n  });\n\n  for (const trusted of [false, true]) {\n    test(`${trusted ? \"trusted\" : \"untrusted\"} repo in explicitly configured auto mode runs verifier without prompts`, async () => {\n    const savedHome = process.env.HOME;\n    const tempHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-vg-home-\"));\n    process.env.HOME = tempHome;\n\n    const { ws, sentinelPath } = setupRepo(`auto-${trusted ? \"trusted\" : \"untrusted\"}`);\n    if (trusted) setWorkspaceTrusted(ws, true);\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a16fd6-d88e-7ad0-8956-d61230292d9e","create_time":1792878839.8679836}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
