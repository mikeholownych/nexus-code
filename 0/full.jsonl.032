 git('init','-q');git('config','user.email','p@invalid');git('config','user.name','p')\n magic=':(exclude)ignored.bin'\n open(os.path.join(r,'.gitignore'),'w').write(magic+'\\n');open(os.path.join(r,'tracked'),'w').write('x')\n git('add','.gitignore','tracked');git('commit','-qm','base')\n open(os.path.join(r,magic),'w').write('magic');open(os.path.join(r,'other.txt'),'w').write('other')\n p=git('add','-f','--',magic,check=False)\n print('status',p.returncode,p.stderr.strip())\n print('index:',repr(git('ls-files','-z').stdout.split('\\0')))\n print('staged:',git('diff','--cached','--name-only','-z').stdout.split('\\0'))\nPY"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"status 0 \nindex: ['.gitignore', ':(exclude)ignored.bin', 'other.txt', 'tracked', '']\nstaged: [':(exclude)ignored.bin', 'other.txt', '']\n","exit_code":0,"duration":{"secs":0,"nanos":352705741}},"started_at_ms":1793216923850,"completed_at_ms":1793216924203}}
