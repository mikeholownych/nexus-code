ndalone qualification (DEC-16, ACCEPTANCE §4): serve the gateway to Nexus as a plain OpenAI-compatible server,\norigin/main:eval/t4_fixtures.mjs:27:    problems.push(\"full_disk requires a positive storageLimitBytes matching the qualification resource contract\");\norigin/main:eval/validate.mjs:2:// a qualification run records which model actually answered (a fingerprint, not an alias), and hidden tests are out of\norigin/main:eval/validate.mjs:19:/** Problems with one task.json (empty when valid). `qualification` adds the fields held-out tasks must carry. */\norigin/main:eval/validate.mjs:20:export function validateTask(task, dir, { qualification = false } = {}) {\norigin/main:eval/validate.mjs:48:  // candidate code from inspecting or mutating that runtime, so they are never valid independent qualification.\norigin/main:eval/validate.mjs:49:  if (qualification) need(hiddenOracle && !hiddenCommand, \"qualification requires the isolated blackbox-v1 hidden oracle; in-process legacy validators are not accepted\");\norigin/main:eval/validate.mjs:69:  if (task.class !== undefined || qualification) need(CLASSES.includes(task.class), `class must be one of ${CLASSES.join(\", \")}`);\norigin/main:eval/validate.mjs:70:  if (task.difficulty !== undefined || qualification) need(DIFFICULTIES.includes(task.difficulty), `difficulty must be one of ${DIFFICULTIES.join(\", \")}`);\norigin/main:eval/validate.mjs:76: * operator's config (`fingerprint`: weights sha256, server build; `sampling`: temperature, seed). A qualification config\norigin/main:eval/validate.mjs:92:  if (config.qualification) {\norigin/main:eval/validate.mjs:107:    return \"qualification requires a positive limits.context override (or serverProfile native discovery) and positive limits.output\";\norigin/main:eval/validate.mjs:111:    return \"qualification must declare a Nexus context override through limits.context; --context-limit in args is ambiguous\";\norigin/main:eval/validate.mjs:137:export function qualificationBudgetProblem(config) {\norigin/main:eval/validate.mjs:141:      return `qualification requires a frozen positive limits.${key} cap for proxy enforcement`;\norigin/main:eval/validate.mjs:144:  if (limits.totalOutput < limits.output) return \"qualification limits.totalOutput cannot be lower than limits.output\";\norigin/main:eval/validate.mjs:176:    return \"qualification runtime and corpus paths must be explicit arrays\";\norigin/main:eval/validate.mjs:179:  if (!taskPath || !fs.existsSync(tasksDir)) return \"qualification task corpus path is unavailable\";\norigin/main:eval/validate.mjs:184:  const includeParent = mountContext.qualification === true || parentDir.canonical !== evalDir.canonical;\norigin/main:eval/validate.mjs:189:    if (!resolved) return \"qualification private corpus paths must be absolute\";\norigin/main:eval/validate.mjs:193:    if (typeof item !== \"string\" || !path.isAbsolute(item)) return \"qualification runtime paths and roots must be absolute\";\norigin/main:eval/validate.mjs:194:    if (!fs.existsSync(item)) return `qualification runtime path is unavailable: ${item}`;\n.github\n.gitignore\nAGENTS.md\nCHANGELOG.md\nCODE_OF_CONDUCT.md\nCONTRIBUTING.md\nGOVERNANCE.md\nLICENSE\nMakefile\nREADME.md\nSECURITY.md\nSUPPORT.md\nabout.hbs\nabout.toml\ncli\ncore\ndemo\ndeny.toml\ndocs\neval\nexperiments\nharness.sh\ninstall.sh\npackage.json\nquickstart.md\nrust-toolchain.toml\nscripts\ntasks\n","exit_code":0,"duration":{"secs":0,"nanos":29500}},"started_at_ms":1793219599200,"completed_at_ms":1793219599201}}
