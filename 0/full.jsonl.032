lines: 0,\n                        content: String::new(),\n                        error: Some(\"File does not exist\".into()),\n                    });\n                    continue;\n                }\n                if target.is_dir() {\n                    results.push(BatchReadFileEntry {\n                        path: path_str.clone(),\n                        success: false,\n                        total_lines: 0,\n                        content: String::new(),\n                        error: Some(\"Target is a directory\".into()),\n                    });\n                    continue;\n                }\n\n                match File::open(&target) {\n                    Ok(mut file) => {\n                        if let Err(e) = verify_descriptor_confinement(&file, &base_canon) {\n                            results.push(BatchReadFileEntry {\n                                path: path_str.clone(),\n                                success: false,\n                                total_lines: 0,\n                                content: String::new(),\n                                error: Some(e),\n                            });\n                            continue;\n                        }\n                        let file_size = match file.metadata() {\n                            Ok(m) => m.len() as usize,\n                            Err(e) => {\n                                results.push(BatchReadFileEntry {\n                                    path: path_str.clone(),\n                                    success: false,\n                                    total_lines: 0,\n                                    content: String::new(),\n                                    error: Some(format!(\"Failed to get metadata: {e}\")),\n                                });\n                                continue;\n                            }\n                        };\n\n                        if file_size > MAX_READ_BYTES && args.offset.is_none() && args.length.is_none() {\n                            results.push(BatchReadFileEntry {\n                                path: path_str.clone(),\n                                success: false,\n                                total_lines: 0,\n                                content: String::new(),\n                                error: Some(format!(\n                                    \"File size ({} bytes) exceeds 8 MB limit ({} bytes). Use 'offset' and 'length' arguments to page through the file.\",\n                                    file_size, MAX_READ_BYTES\n                                )),\n                            });\n                            continue;\n                        }\n\n                        if is_binary_file_descriptor(&file).unwrap_or(false) {\n                            results.push(BatchReadFileEntry {\n                                path: path_str.clone(),\n                                success: false,\n                                total_lines: 0,\n                                content: String::new(),\n                                error: Some(\"File is binary\".into()),\n                            });\n                            continue;\n                        }\n\n                        if args.offset.is_some() || args.length.is_some() {\n                            let offset = args.offset.unwrap_or(0);\n                            if offset > file_size {\n                                results.push(BatchReadFileEntry {\n                                    path: path_str.clone(),\n                                    success: false,\n                                    total_lines: 0,\n                                    content: String::new(),\n                                    error: Some(format!(\"offset ({offset}) exceeds file size ({file_size})\")),\n                                });\n                                continue;\n                            }\n                            let requested_len = args.length.unwrap_or(MAX_READ_BYTES).min(MAX_READ_BYTES);\n                            let actual_len = requested_len.min(file_size.saturating_sub(offset));\n                            if let Err(e) = file.seek(SeekFrom::Start(offset as u64)) {\n                                results.push(BatchReadFileEntry {\n                                    path: path_str.clone(),\n                                    success: false,\n                                    total_lines: 0,\n                                    content: String::new(),\n                                    error: Some(format!(\"Failed to seek file: {e}\")),\n                                });\n                                continue;\n                            }\n                            let mut buf = vec![0u8; actual_len];\n                            if let Err(e) = file.read_exact(&mut buf) {\n                                results.push(BatchReadFileEntry {\n                                    path: path_str.clone(),\n                                    success: false,\n                                    total_lines: 0,\n                                    content: String::new(),\n                                    error: Some(format!(\"Failed to read file slice: {e}\")),\n                                });\n                                continue;\n                            }\n                            let text = String::from_utf8_lossy(&buf);\n                            let lines: Vec<&str> = text.lines().collect();\n                            let total = lines.len();\n                            let slice = &lines[..total.min(max_lines)];\n                            let mut numbered = String::new();\n                            for (idx, line) in slice.iter().enumerate() {\n                                numbered.push_str(&format!(\"{:>5} | {}\\n\", idx + 1, line));\n                            }\n                            results.push(BatchReadFileEntry {\n                                path: path_str.clone(),\n                                success: true,\n                                total_lines: total,\n                                content: numbered,\n                                error: None,\n                            });\n                            continue;\n                        }\n\n                        let reader = BufReader::new(file);\n                        let all_lines: Vec<String> = reader.lines().map_while(Result::ok).collect();\n                        let total = all_lines.len();\n                        let slice = &all_lines[..total.min(max_lines)];\n                        let mut numbered = String::new();\n                        for (idx, line) in slice.iter().enumerate() {\n                            numbered.push_str(&format!(\"{:>5} | {}\\n\", idx + 1, line));\n                        }\n                        results.push(BatchReadFileEntry {\n                            path: path_str.clone(),\n                            success: true,\n                            total_lines: total,\n                            content: numbered,\n                            error: None,\n                        });\n                    }\n                    Err(e) => {\n                        results.push(BatchReadFileEntry {\n                            path: path_str.clone(),\n                            success: false,\n                            total_lines: 0,\n                            content: String::new(),\n                            error: Some(format!(\"Open error: {e}\")),\n                        });\n                    }\n                }\n            }\n            Err(e) => {\n                results.push(BatchReadFileEntry {\n                    path: path_str.clone(),\n                    success: false,\n                    total_lines: 0,\n                    content: String::new(),\n                    error: Some(e),\n                });\n            }\n        }\n    }\n\nb84c542d fix(core): stop batch reads on read errors\n core/src/file_ops.rs | 2 +-\n 1 file changed, 1 insertion(+), 1 deletion(-)\ncommit b84c542de6a4c8de918bd6441b08c0bf1c0affd9\nAuthor:     Mike Holownych <mike@holownych.com>\nAuthorDate: Wed Oct 28 21:34:23 2026 +0000\nCommit:     Mike Holownych <mike@holownych.com>\nCommitDate: Wed Oct 28 21:38:03 2026 +0000\n\n    fix(core): stop batch reads on read errors\n\ndiff --git a/core/src/file_ops.rs b/core/src/file_ops.rs\nindex e918db53..acb74aa9 100644\n--- a/core/src/file_ops.rs\n+++ b/core/src/file_ops.rs\n@@ -1115,7 +1115,7 @@ pub fn batch_read(args: BatchReadArgs, base_dir: &Path) -> Result<BatchReadResul\n                         }\n \n                         let reader = BufReader::new(file);\n-                        let all_lines: Vec<String> = reader.lines().filter_map(Result::ok).collect();\n+                        let all_lines: Vec<String> = reader.lines().map_while(Result::ok).collect();\n                         let total = all_lines.len();\n                         let slice = &all_lines[..total.min(max_lines)];\n                         let mut numbered = String::new();\n","exit_code":0,"duration":{"secs":1,"nanos":25369570}},"started_at_ms":1793225327070,"completed_at_ms":1793225328096}}
