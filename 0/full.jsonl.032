{"timestamp":"2026-10-28T20:34:14.125Z","ordinal":463890,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18432-af9c-7882-80ce-70535521cb1b","item":{"type":"CommandExecution","id":"exec-5e483658-6030-44c2-ae4d-ff493fd7f3b3","process_id":"28903","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-code show origin/main:cli/test/eval_hardened.test.ts | sed -n '1,100p'; git -C /home/mike/nexus-code show origin/main:cli/test/eval_harness.test.ts | sed -n '1,70p'; ls /home/mike/nexus-code/.git/nexus-claims/FILE_cli_test_eval_hardened.test.ts 2>/dev/null || true"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-code show origin/main:cli/test/eval_hardened.test.ts | sed -n '1,100p'; git -C /home/mike/nexus-code show origin/main:cli/test/eval_harness.test.ts | sed -n '1,70p'; ls /home/mike/nexus-code/.git/nexus-claims/FILE_cli_test_eval_hardened.test.ts 2>/dev/null || true"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * Hardened legacy hidden tests (owner decision 2026-10-18) and the sealed heldout-v2 corpus binding: test\n * infrastructure is never carried from the agent's workspace into the checks, test-runner configuration changes refuse\n * the checks, and the custodian's task/hidden digests bind the selected corpus exactly.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway } from \"./helpers/fixtures.js\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\nconst hardened = () => import(path.join(ROOT, \"eval/hardened_check.mjs\"));\nconst gitEnv = { PATH: \"/usr/bin:/bin\", HOME: os.tmpdir(), GIT_CONFIG_NOSYSTEM: \"1\", GIT_CONFIG_GLOBAL: \"/dev/null\" };\nconst git = (cwd: string, ...argv: string[]) => {\n  const r = spawnSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@example.invalid\", \"-c\", \"init.defaultBranch=main\", ...argv], { cwd, env: gitEnv, encoding: \"utf8\" });\n  assert.equal(r.status, 0, r.stderr);\n  return r.stdout.trim();\n};\n\ntest(\"runAsAclArgs scopes evaluator and operator permissions with directory defaults\", async () => {\n  const { runAsAclArgs } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  assert.deepEqual(runAsAclArgs(\"nexus-eval\", 1000, \"/workspace\", true), {\n    access: [\"-R\", \"-m\", \"u:nexus-eval:rwX,u:1000:rwX\", \"/workspace\"],\n    defaults: [\"-m\", \"d:u:nexus-eval:rwx,d:u:1000:rwx,d:m::rwx\", \"/workspace\"],\n  });\n  assert.deepEqual(runAsAclArgs(\"nexus-eval\", 1000, \"/workspace/file\", false), {\n    access: [\"-R\", \"-m\", \"u:nexus-eval:rwX,u:1000:rwX\", \"/workspace/file\"],\n    defaults: null,\n  });\n});\n\ntest(\"configured Go toolchain takes precedence over the host fallback\", async () => {\n  const { selectToolchainRoot } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"go-root-precedence-\"));\n  try {\n    const configured = path.join(root, \"configured-go-root\");\n    const fallback = path.join(root, \"host-go-root\");\n    fs.mkdirSync(configured);\n    fs.mkdirSync(fallback);\n    assert.equal(selectToolchainRoot(configured, fallback), configured);\n    assert.equal(selectToolchainRoot(null, fallback), fallback);\n    assert.equal(selectToolchainRoot(null, null), null);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"asUserSpec preserves timeout metadata and isolated processes reject missing timeouts\", async () => {\n  const { asUserSpec } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const { runIsolatedProcess } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const spec = { cmd: \"/usr/bin/bwrap\", argv: [\"--version\"], timeoutMs: 1200, marker: \"preserved\" };\n  assert.deepEqual(asUserSpec(\"nexus-eval\", spec), {\n    ...spec,\n    cmd: \"/usr/bin/sudo\",\n    argv: [\"-n\", \"-u\", \"nexus-eval\", \"--\", \"/usr/bin/bwrap\", \"--version\"],\n  });\n  assert.throws(() => runIsolatedProcess({ cmd: \"/usr/bin/true\", argv: [] }), /isolated process spec has no timeoutMs/);\n  assert.throws(() => runIsolatedProcess({ cmd: \"/usr/bin/true\", argv: [], timeoutMs: 0 }), /isolated process spec has no timeoutMs/);\n});\n\ntest(\"test infrastructure is recognised across Python, Go, JS/TS and Rust layouts\", async () => {\n  const { isTestInfraPath } = await hardened();\n  for (const p of [\"conftest.py\", \"pkg/conftest.py\", \"pytest.ini\", \"tox.ini\", \"setup.cfg\", \"sitecustomize.py\", \"x.pth\", \"tests/test_a.py\", \"src/test_a.py\", \"a_test.py\",\n    \"pkg/x_test.go\", \"src/x.test.ts\", \"web/a.spec.jsx\", \"__tests__/a.js\", \"jest.config.js\", \"vitest.config.mts\", \".mocharc.json\", \"build.rs\", \".cargo/config.toml\", \".github/workflows/ci.yml\", \"Makefile\", \".env.local\",\n    \"karma.conf.js\", \"jest-preset.js\", \"vitest.workspace.ts\", \"globalSetup.ts\", \"setup-tests.js\", \"test-helpers.ts\", \"internal/testhelper/x.go\", \"pkg/_testing.py\",\n    \".npmrc\", \".yarnrc.yml\", \".pnpmfile.cjs\", \"go.work\", \"rust-toolchain.toml\", \"tsconfig.json\", \".coveragerc\", \".gitattributes\", \"node_modules/x/i.js\", \".venv/lib/x.py\", \"a/__pycache__/m.pyc\"]) {\n    assert.equal(isTestInfraPath(p), true, p);\n  }\n  for (const p of [\"src/app.py\", \"pkg/server.go\", \"src/index.ts\", \"src/lib.rs\", \"README.md\", \"package.json\", \"pyproject.toml\", \"Cargo.toml\", \"contest.py\"]) {\n    assert.equal(isTestInfraPath(p), false, p);\n  }\n});\n\ntest(\"hidden test staging preserves workspace files and mounts only copied hidden files\", async () => {\n  const { stageHiddenFiles, hiddenOutputHasTests } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"hidden-stage-\"));\n  try {\n    const source = path.join(root, \"task/hidden\");\n    const ws = path.join(root, \"workspace\");\n    fs.mkdirSync(source, { recursive: true });\n    fs.mkdirSync(path.join(ws, \"test\"), { recursive: true });\n    fs.writeFileSync(path.join(source, \"private.test.js\"), \"hidden\\n\");\n    fs.writeFileSync(path.join(ws, \"existing.js\"), \"keep root\\n\");\n    fs.writeFileSync(path.join(ws, \"test/existing.js\"), \"keep test\\n\");\n    assert.deepEqual(stageHiddenFiles(source, ws, \".\", { readOnlyHidden: true }), [\"private.test.js\"]);\n    assert.deepEqual(stageHiddenFiles(source, ws, \"test\", { readOnlyHidden: true }), [\"test/private.test.js\"]);\n    assert.equal(fs.readFileSync(path.join(ws, \"existing.js\"), \"utf8\"), \"keep root\\n\");\n    assert.equal(fs.readFileSync(path.join(ws, \"test/existing.js\"), \"utf8\"), \"keep test\\n\");\n    assert.equal(fs.readFileSync(path.join(ws, \"private.test.js\"), \"utf8\"), \"hidden\\n\");\n    assert.equal(fs.readFileSync(path.join(ws, \"test/private.test.js\"), \"utf8\"), \"hidden\\n\");\n    const outsideDir = path.join(root, \"outside\");\n    fs.mkdirSync(outsideDir);\n    fs.symlinkSync(outsideDir, path.join(ws, \"sym\"));\n    assert.throws(() => stageHiddenFiles(source, ws, \"sym/newparent\", { readOnlyHidden: true }), /unsafe hidden test parent directory/);\n    assert.equal(fs.existsSync(path.join(outsideDir, \"newparent\")), false);\n/**\n * The evaluation harness end to end against a scripted model (Stage 8, T1 smoke): fresh workspaces, hidden tests the\n * agent never sees, separate scores. The self-test task is the assessment's A1 case: a repository whose own suite is\n * green but never exercises the deliverable. A wrong deliverable must fail the hidden test and must never be VERIFIED.\n */\n\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, Reply } from \"./helpers/fixtures.js\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n\nasync function sealTestTasks(tasksDir: string, taskId: string) {\n  const { corpusTaskRows } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const rows = corpusTaskRows(tasksDir, [taskId]);\n  const manifestPath = path.join(tasksDir, \"custody-manifest.json\");\n  const manifest = { schemaVersion: 1, split: \"heldout\", custody: { status: \"approved\", custodian: \"synthetic-test-role\", approvedAt: \"2026-01-01T00:00:00Z\" }, tasks: rows };\n  const bytes = JSON.stringify(manifest);\n  fs.writeFileSync(manifestPath, bytes);\n  return { corpusManifest: manifestPath, corpusManifestSha256: createHash(\"sha256\").update(bytes).digest(\"hex\") };\n}\n\n/** Async: the scripted gateway answers from this process, so the runner must not block its event loop. */\nfunction runNode(argv: string[], env: NodeJS.ProcessEnv = process.env): Promise<{ status: number | null; stdout: string; stderr: string }> {\n  return new Promise((resolve) => {\n    const child = spawn(process.execPath, argv, { stdio: [\"ignore\", \"pipe\", \"pipe\"], env });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout.on(\"data\", (c) => (stdout += c));\n    child.stderr.on(\"data\", (c) => (stderr += c));\n    child.on(\"close\", (status) => resolve({ status, stdout, stderr }));\n  });\n}\n\nfunction writer(content: string) {\n  return (_n: number, body: any): Reply => {\n    const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n    if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"math.js\", content } }] };\n    if (tools === 1) return { kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary: \"math.js added\" } }] };\n    return { kind: \"text\", content: \"Done.\" };\n  };\n}\n\nasync function evaluate(content: string, extra: Record<string, unknown> = {}): Promise<{ records: any[]; score: any; hiddenLog: string; agentLog: string; agentError: string }> {\n  const gw = await startGateway(writer(content));\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-out-\"));\n  const out = path.join(root, \"run\");\n  const config = path.join(root, \"config.json\");\n  fs.writeFileSync(config, JSON.stringify({ name: \"nexus@mock\", agent: \"nexus\", endpoint: gw.url, model: \"m\", runs: 1, steps: 20, minutes: 5, ...extra }));\n  try {\n    const run = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(run.status, 0, `${run.stdout}\\n${run.stderr}`);\n    const records = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(out, \"results.jsonl\"), \"--json\"], { encoding: \"utf8\" });\n    assert.equal(scored.status, 0, scored.stderr);\n    const manifest = JSON.parse(fs.readFileSync(path.join(out, \"manifest.json\"), \"utf8\"));\n    assert.deepEqual(manifest.tasks.map((task: any) => task.id), [\"selftest-add\"]);\n    assert.match(manifest.harness.sourceSha256, /^[0-9a-f]{64}$/);\n    assert.match(manifest.configSha256, /^[0-9a-f]{64}$/);\n    const priorResults = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\");\n    const replay = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(replay.status, 2);\n    assert.match(replay.stderr, /output directory must be new/);\n    assert.equal(fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\"), priorResults, \"reusing an output directory changed prior evidence\");\n","exit_code":0,"duration":{"secs":0,"nanos":30243}},"started_at_ms":1793219654124,"completed_at_ms":1793219654125}}
