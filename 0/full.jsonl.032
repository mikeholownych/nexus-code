et currentUrl = url;\\\\n  let hops = 0;\\\\n  let connectionResets = 0;\\\\n\\\\n  const controller = new AbortController();\\\\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\\\\n  if (signal) {\\\\n    signal.addEventListener(\\\\\\\"abort\\\\\\\", () => controller.abort(signal.reason), { once: true });\\\\n  }\\\\n\\\\n  try {\\\\n    while (hops <= maxHops) {\\\\n      if (!validateDownloadUrl(currentUrl)) {\\\\n        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\\\\n      }\\\\n\\\\n      const headers: Record<string, string> = { \\\\\\\"User-Agent\\\\\\\": \\\\\\\"nexus-upgrade\\\\\\\" };\\\\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\\\\n      if (token && (new URL(currentUrl)).hostname === \\\\\\\"github.com\\\\\\\") {\\\\n        headers.Authorization = `Bearer ${token}`;\\\\n      }\\\\n\\\\n      let res: Response;\\\\n      try {\\\\n        res = await fetch(currentUrl, {\\\\n          headers,\\\\n          signal: controller.signal,\\\\n          redirect: \\\\\\\"manual\\\\\\\",\\\\n        });\\\\n      } catch (error) {\\\\n        if (connectionResets < 1 && isDownloadConnectionReset(error)) {\\\\n          connectionResets++;\\\\n          continue;\\\\n        }\\\\n        throw error;\\\\n      }\\\\n\\\\n      // Handle redirect\\\\n      if (res.status === 301 || res.status === 302 || res.status === 307 || res.status === 308) {\\\\n        const location = res.headers.get(\\\\\\\"location\\\\\\\");\\\\n        if (!location) {\\\\n          throw new Error(`HTTP ${res.status} redirect without Location header from ${safeDownloadOrigin(currentUrl)}`);\\\\n        }\\\\n        currentUrl = new URL(location, currentUrl).toString();\\\\n        hops++;\\\\n        continue;\\\\n      }\\\\n\\\\n      if (!res.ok) {\\\\n        throw new Error(`HTTP ${res.status} downloading from ${safeDownloadOrigin(currentUrl)}`);\\\\n      }\\\\n\\\\n      const contentLengthHeader = res.headers.get(\\\\\\\"content-length\\\\\\\");\\\\n      if (contentLengthHeader) {\\\\n        const contentLength = parseInt(contentLengthHeader, 10);\\\\n        if (contentLength > MAX_DOWNLOAD_BYTES) {\\\\n          throw new Error(`Download size (${contentLength} bytes) exceeds maximum allowed limit (${MAX_DOWNLOAD_BYTES} bytes)`);\\\\n        }\\\\n      }\\\\n\\\\n      const fileStream = fs.createWriteStream(destPath);\\\\n      if (!res.body) {\\\\n        throw new Error(`Empty body downloading from ${safeDownloadOrigin(currentUrl)}`);\\\\n      }\\\\n\\\\n      let bytesDownloaded = 0;\\\\n      const reader = res.body.getReader();\\\\n\\\\n      try {\\\\n        await new Promise<void>((resolve, reject) => {\\\\n          fileStream.on(\\\\\\\"error\\\\\\\", reject);\\\\n          fileStream.on(\\\\\\\"finish\\\\\\\", () => resolve());\\\\n          function pump() {\\\\n            reader.read().then(({ done, value }) => {\\\\n              if (done) {\\\\n                fileStream.end();\\\\n                return;\\\\n              }\\\\n              bytesDownloaded += value.byteLength;\\\\n              if (bytesDownloaded > MAX_DOWNLOAD_BYTES) {\\\\n                reject(new Error(`Download exceeded maximum limit of ${MAX_DOWNLOAD_BYTES} bytes`));\\\\n                return;\\\\n              }\\\\n              fileStream.write(Buffer.from(value), (err) => {\\\\n                if (err) reject(err);\\\\n                else pump();\\\\n              });\\\\n            }).catch(reject);\\\\n          }\\\\n          pump();\\\\n        });\\\\n      } catch (streamErr) {\\\\n        try { fs.unlinkSync(destPath); } catch {}\\\\n        throw streamErr;\\\\n      }\\\\n\\\\n      return;\\\\n    }\\\\n\\\\n    throw new Error(`Too many redirects (exceeded ${maxHops} hops) while downloading`);\\\\n  } finally {\\\\n    clearTimeout(timer);\\\\n  }\\\\n}\\\"}]},\\\"match_line\\\":714,\\\"match_lines\\\":[695,701,706,714,717,719,757,781]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"7bbc907d8fc55aac94a8f316f3be185a\\\",\\\"_score\\\":37.206444,\\\"_source\\\":{\\\"title\\\":\\\"compatibility.ts\\\",\\\"ax_path\\\":\\\"compatibility.ts\\\",\\\"ax_file\\\":\\\"axf2-0c4ee6de527152e9f21db58642d32119-3971\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":198,\\\"start_offset\\\":8227,\\\"end_offset\\\":10278,\\\"text\\\":\\\"export function validateCompatibilityAssetBinding(\\\\n  external: ReleaseCompatibilityMetadata,\\\\n  embedded: ReleaseCompatibilityMetadata,\\\\n  expectedVersion: string,\\\\n  expectedArchive: string,\\\\n  actualArchiveSha256: string,\\\\n  platformKey = \\\\\\\"linux-x86_64\\\\\\\"\\\\n): { valid: boolean; errors: string[] } {\\\\n  const errors: string[] = [];\\\\n  const externalValidation = validateCompatibilityMetadata(external);\\\\n  const embeddedValidation = validateCompatibilityMetadata(embedded);\\\\n  if (!externalValidation.valid) errors.push(...externalValidation.errors.map((error) => `external ${error}`));\\\\n  if (!embeddedValidation.valid) errors.push(...embeddedValidation.errors.map((error) => `embedded ${error}`));\\\\n  const externalAsset = external?.platforms?.[platformKey];\\\\n  const embeddedAsset = embedded?.platforms?.[platformKey];\\\\n  if (!externalAsset || externalAsset.archive !== expectedArchive) errors.push(`external metadata does not name expected archive '${expectedArchive}'`);\\\\n  if (!embeddedAsset || embeddedAsset.archive !== expectedArchive) errors.push(`embedded metadata does not name expected archive '${expectedArchive}'`);\\\\n  if (externalAsset?.sha256?.toLowerCase() !== actualArchiveSha256.toLowerCase()) errors.push(\\\\\\\"external metadata archive digest does not match downloaded archive\\\\\\\");\\\\n  if (external?.version !== expectedVersion.replace(/^[vV]/, \\\\\\\"\\\\\\\") || embedded?.version !== expectedVersion.replace(/^[vV]/, \\\\\\\"\\\\\\\")) {\\\\n    errors.push(\\\\\\\"compatibility metadata version does not match release tag\\\\\\\");\\\\n  }\\\\n  if (external && embedded) {\\\\n    const externalComparable = JSON.parse(JSON.stringify(external));\\\\n    const embeddedComparable = JSON.parse(JSON.stringify(embedded));\\\\n    for (const data of [externalComparable, embeddedComparable]) {\\\\n      for (const asset of Object.values(data.platforms ?? {}) as any[]) delete asset.sha256;\\\\n    }\\\\n    if (canonicalJson(externalComparable) !== canonicalJson(embeddedComparable)) errors.push(\\\\\\\"external metadata does not match metadata embedded in the verified archive\\\\\\\");\\\\n  }\\\\n  return { valid: errors.length === 0, errors };\\\\n}\\\"}]},\\\"match_line\\\":218,\\\"match_lines\\\":[218]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"9f6971e47da63c3e73d01c79d2a88854\\\",\\\"_score\\\":31.256306,\\\"_source\\\":{\\\"title\\\":\\\"upgrade_journal.ts\\\",\\\"ax_path\\\":\\\"upgrade_journal.ts\\\",\\\"ax_file\\\":\\\"axf2-76f67f02d97d90f8a9f9ac9403e3640e-776f\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":451,\\\"start_offset\\\":22078,\\\"end_offset\\\":26432,\\\"text\\\":\\\"function recoverUpgradeLocked(prefix: string, options: { forceRollback?: boolean; timeoutMs?: number; lockHeld?: boolean } = {}): RecoveryOutcome {\\\\n  const journalPath = getJournalPath(prefix);\\\\n  const journal = readJournal(prefix);\\\\n  const failed = (details: string): RecoveryOutcome => ({ recovered:false, action:\\\\\\\"manual_intervention\\\\\\\", details });\\\\n  if (!journal && fs.existsSync(journalPath)) return failed(\\\\\\\"Upgrade journal failed schema or path validation; no recovery action was taken.\\\\\\\");\\\\n  if (!journal || ([\\\\\\\"idle\\\\\\\", \\\\\\\"complete\\\\\\\", \\\\\\\"rolled_back\\\\\\\"].includes(journal.state) && !options.forceRollback)) return { recovered:false, action:\\\\\\\"none\\\\\\\", details:\\\\\\\"No interrupted upgrade found in journal.\\\\\\\" };\\\\n  const libRoot = path.join(path.resolve(prefix), \\\\\\\"lib\\\\\\\", \\\\\\\"nexus\\\\\\\");\\\\n  if (!isRealDirectory(libRoot) || !isRealDirectory(path.dirname(journal.binPath))) return failed(\\\\\\\"Upgrade recovery roots are not real contained directories; no recovery action was taken.\\\\\\\");\\\\n  for (const directory of [journal.sourceInstallDir, journal.targetInstallDir, journal.replacementBackupDir, journal.displacedTargetDir, journal.stagingDir]) {\\\\n    if (directory && fs.existsSync(directory) && !isRealDirectory(directory)) return failed(\\\\\\\"A recovery path is not a contained real directory; no recovery action was taken.\\\\\\\");\\\\n    // lstat also detects dangling symlinks, which existsSync deliberately ignores.\\\\n    if (directory) { try { if (fs.lstatSync(directory).isSymbolicLink()) return failed(\\\\\\\"A recovery path is a symlink; no recovery action was taken.\\\\\\\"); } catch (error: any) { if (error.code !== \\\\\\\"ENOENT\\\\\\\") return failed(error.message); } }\\\\n  }\\\\n  try {\\\\n    if (!options.forceRollback && journal.state === \\\\\\\"verified\\\\\\\" && verifyInstalledRuntime(journal.targetInstallDir, journal.targetVersion, options.timeoutMs).healthy) {\\\\n      atomicSymlinkSwap(path.join(journal.targetInstallDir, \\\\\\\"bin\\\\\\\", \\\\\\\"nexus\\\\\\\"), journal.binPath);\\\\n      journal.state = \\\\\\\"complete\\\\\\\";\\\\n      journal.updatedAt = new Date().toISOString();\\\\n      writeJournal(prefix, journal);\\\\n      return { recovered:true, action:\\\\\\\"finalized\\\\\\\", details:`Finalized verified release ${journal.targetVersion}.` };\\\\n    }\\\\n    // The old package is kept outside disposable staging. The journal records its\\\\n    // identity BEFORE the first rename, covering crashes on either side of it.\\\\n    const early = [\\\\\\\"preparing\\\\\\\", \\\\\\\"downloading\\\\\\\", \\\\\\\"staged\\\\\\\"].includes(journal.state);\\\\n    const sameVersion = journal.sourceInstallDir === journal.targetInstallDir;\\\\n    const saved = journal.replacementBackupDir;\\\\n    if (saved && fs.existsSync(saved)) {\\\\n      if (!verifyInstalledRuntime(saved, sameVersion ? journal.sourceVersion : journal.targetVersion, options.timeoutMs).healthy && sameVersion) throw new Error(\\\\\\\"Preserved source package failed runtime validation; retained for manual intervention\\\\\\\");\\\\n      if (fs.existsSync(journal.targetInstallDir)) {\\\\n        if (!journal.displacedTargetDir || fs.existsSync(journal.displacedTargetDir)) throw new Error(\\\\\\\"Cannot displace failed target safely; all packages retained\\\\\\\");\\\\n        fs.renameSync(journal.targetInstallDir, journal.displacedTargetDir);\\\\n        syncDirectory(libRoot);\\\\n      }\\\\n      fs.renameSync(saved, journal.targetInstallDir);\\\\n      syncDirectory(libRoot);\\\\n    }\\\\n    const health = verifyInstalledRuntime(journal.sourceInstallDir, journal.sourceVersion, options.timeoutMs);\\\\n    if (!health.healthy) throw new Error(`source launcher/runtime is unverified: ${health.error}`);\\\\n    atomicSymlinkSwap(journal.sourceSymlinkTarget, journal.binPath);\\\\n    journal.state = \\\\\\\"rolled_back\\\\\\\";\\\\n    journal.updatedAt = new Date().toISOString();\\\\n    delete journal.error;\\\\n    writeJournal(prefix, journal);\\\\n    // Never delete staging before successful source restoration. Failed packages\\\\n    // and the original backup remain available if any step above fails.\\\\n    if (journal.stagingDir && fs.existsSync(journal.stagingDir)) fs.rmSync(journal.stagingDir, { recursive:true, force:true });\\\\n    return { recovered:true, action:early ? \\\\\\\"cleaned_up\\\\\\\" : \\\\\\\"rolled_back\\\\\\\", details:`Restored verified source release ${journal.sourceVersion}.` };\\\\n  } catch (error: any) {\\\\n    journal.state = \\\\\\\"recovery_required\\\\\\\";\\\\n    journal.error = `Manual intervention required: ${error.message}`;\\\\n    journal.updatedAt = new Date().toISOString();\\\\n    try { writeJournal(prefix, journal); } catch {}\\\\n    return failed(journal.error);\\\\n  }\\\\n}\\\"}]},\\\"match_line\\\":471,\\\"match_lines\\\":[456,457,459,471,498]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"ae033d65725b1664ef636dd609cc7d41\\\",\\\"_score\\\":30.1926,\\\"_source\\\":{\\\"title\\\":\\\"repl.ts\\\",\\\"ax_path\\\":\\\"repl.ts\\\",\\\"ax_file\\\":\\\"axf2-9781cd8156a2afcaea2488902ce27ee5-16f4b\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":1286,\\\"start_offset\\\":62647,\\\"end_offset\\\":64669,\\\"text\\\":\\\"            const mcp = this.agent.getMcpManager();\\\\n            const subArgs = arg.trim().split(/\\\\\\\\s+/).filter(Boolean);\\\\n            const subCmd = subArgs[0]?.toLowerCase();\\\\n\\\\n            if (subCmd === \\\\\\\"add\\\\\\\") {\\\\n              console.log(pc.bold(pc.white(\\\\\\\"\\\\\\\\n=== MCP Server Configuration Wizard ===\\\\\\\")));\\\\n              const name = (await this.rl!.question(pc.bold(pc.white(\\\\\\\"  Server Identifier (e.g. sqlite-db, github): \\\\\\\")))).trim();\\\\n              if (!name) {\\\\n                console.log(pc.dim(\\\\\\\"Empty server name. Wizard cancelled.\\\\\\\\n\\\\\\\"));\\\\n                continue;\\\\n              }\\\\n\\\\n              const transportInput = (await this.rl!.question(pc.bold(pc.white(\\\\\\\"  Transport [stdio/sse/websocket] (default: stdio): \\\\\\\")))).trim().toLowerCase();\\\\n              const transport = transportInput === \\\\\\\"sse\\\\\\\" || transportInput === \\\\\\\"websocket\\\\\\\" ? transportInput : \\\\\\\"stdio\\\\\\\";\\\\n\\\\n              let config: any = { transport };\\\\n              if (transport === \\\\\\\"stdio\\\\\\\") {\\\\n                const command = (await this.rl!.question(pc.bold(pc.white(\\\\\\\"  Executable command (e.g. npx -y @modelcontextprotocol/server-sqlite): \\\\\\\")))).trim();\\\\n                if (!command) {\\\\n                  console.log(pc.dim(\\\\\\\"Empty command. Wizard cancelled.\\\\\\\\n\\\\\\\"));\\\\n                  continue;\\\\n                }\\\\n                const parts = command.split(/\\\\\\\\s+/);\\\\n                config.command = parts[0];\\\\n                config.args = parts.slice(1);\\\\n              } else {\\\\n                const url = (await this.rl!.question(pc.bold(pc.white(\\\\\\\"  Endpoint URL (e.g. http://localhost:8000/sse): \\\\\\\")))).trim();\\\\n                if (!url) {\\\\n                  console.log(pc.dim(\\\\\\\"Empty URL. Wizard cancelled.\\\\\\\\n\\\\\\\"));\\\\n                  continue;\\\\n                }\\\\n                config.url = url;\\\\n              }\\\\n\\\\n              console.log(pc.dim(`  Connecting to MCP server '${name}'...`));\\\\n              const res = await mcp.addServer(name, config, true);\\\\n              if (res.success) {\\\\n                console.log(pc.green(`✔ Connected to MCP server '${name}'!`));\\\"}]},\\\"match_line\\\":1293,\\\"match_lines\\\":[1293,1313,1314,1315,1318]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"7dca3b6530ab467e3c984d24dbe9fa7b\\\",\\\"_score\\\":25.430168,\\\"_source\\\":{\\\"title\\\":\\\"client.ts\\\",\\\"ax_path\\\":\\\"client.ts\\\",\\\"ax_file\\\":\\\"axf2-33f9bd7d6b5dee989d474b71676aaa45-17404\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":858,\\\"start_offset\\\":40893,\\\"end_offset\\\":42902,\\\"text\\\":\\\"   * (refresh tokens rotate; refreshing would sign that client out). A Copilot GitHub token from another client is\\\\n   * exchanged for a Copilot API token in memory, which rotates nothing.\\\\n   */\\\\n  private async prepareCredential(url: string, requestId?: string, force = false): Promise<void> {\\\\n    if (this.conn.auth !== \\\\\\\"oauth\\\\\\\" || !this.conn.providerId) return;\\\\n    const id = this.conn.providerId;\\\\n    const label = providerDefinition(id)?.label ?? id;\\\\n    const found = resolveCredential(id);\\\\n    const fail = (message: string) =>\\\\n      new InferenceError(\\\\\\\"configuration_error\\\\\\\", \\\\\\\"client\\\\\\\", message, { requestId, failoverEligible: false, condition: \\\\\\\"AUTH_FAILURE\\\\\\\" });\\\\n    if (!found || found.credential.type !== \\\\\\\"oauth\\\\\\\") {\\\\n      this.explicitKey = undefined;\\\\n      return; // preflight reports the missing sign-in\\\\n    }\\\\n    let cred: OAuthCredential = found.credential;\\\\n    const fresh = (c?: OAuthCredential) => Boolean(c?.access) && (c!.expiresAt === undefined || c!.expiresAt - Date.now() > 60_000);\\\\n    if (!fresh(cred) || force) {\\\\n      try {\\\\n        if (found.refreshable) {\\\\n          cred = (await refreshOAuth(id, cred)) as OAuthCredential;\\\\n          saveCredential(id, cred);\\\\n        } else if (id === \\\\\\\"copilot\\\\\\\" && cred.refresh) {\\\\n          if (force || !fresh(this.exchangedToken) || this.exchangedToken?.refresh !== cred.refresh) {\\\\n            this.exchangedToken = REDACTED copilotToken(cred.refresh)) as OAuthCredential;\\\\n          }\\\\n          cred = this.exchangedToken!;\\\\n        } else if (!fresh(cred)) {\\\\n          throw new Error(`the ${label} sign-in read from ${found.source} has expired. Use ${found.source} once to refresh it, or sign in from Nexus (/model, then ctrl+p).`);\\\\n        }\\\\n      } catch (err: any) {\\\\n        throw fail(`Cannot use ${label}: ${redactSecrets(err?.message ?? String(err))}`);\\\\n      }\\\\n    }\\\\n    this.explicitKey = cred.access;\\\\n    this.explicitOrigin = originOf(url);\\\\n    this.rotated.delete(this.explicitOrigin ?? \\\\\\\"\\\\\\\");\\\\n    this.oauthAccountId = cred.accountId;\\\\n  }\\\\n\\\"}]},\\\"match_line\\\":859,\\\"match_lines\\\":[859,862,893]}]}}\"}],\"isError\":false}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18422-99d5-74d1-8392-e2c348b8135f","create_time":1793218297.8126137}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
