v: gitEnv, encoding: \"utf8\" });\n  assert.equal(r.status, 0, r.stderr);\n  return r.stdout.trim();\n};\n\ntest(\"runAsAclArgs scopes evaluator and operator permissions with directory defaults\", async () => {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1843d-be16-7a30-8bd0-717d10d5833e","create_time":1793220162.0708253}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
