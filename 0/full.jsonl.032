\\":\\\"655da502f70a75f2aca5dca8fcc177cb\\\",\\\"_score\\\":14.930874,\\\"_source\\\":{\\\"title\\\":\\\"version_only_diff.test.ts\\\",\\\"ax_path\\\":\\\"version_only_diff.test.ts\\\",\\\"ax_file\\\":\\\"axf2-8d9612e9d31f3710a2677bbf4da03d2c-1921\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":15,\\\"start_offset\\\":653,\\\"end_offset\\\":2633,\\\"text\\\":\\\"  const base = fs.mkdtempSync(path.join(os.tmpdir(), \\\\\\\"version-only-\\\\\\\"));\\\\n  const env = { ...process.env, HOME: base, GIT_CONFIG_NOSYSTEM: \\\\\\\"1\\\\\\\", GIT_CONFIG_GLOBAL: \\\\\\\"/dev/null\\\\\\\" };\\\\n  const repo = path.join(base, \\\\\\\"repo\\\\\\\");\\\\n  const git = (...argv: string[]) => {\\\\n    const r = spawnSync(\\\\\\\"git\\\\\\\", [\\\\\\\"-c\\\\\\\", \\\\\\\"user.name=t\\\\\\\", \\\\\\\"-c\\\\\\\", \\\\\\\"user.email=t@example.invalid\\\\\\\", ...argv], { cwd: repo, env, encoding: \\\\\\\"utf8\\\\\\\" });\\\\n    assert.equal(r.status, 0, r.stderr);\\\\n    return r.stdout.trim();\\\\n  };\\\\n  const check = (rc: string, stable: string) => spawnSync(process.execPath, [path.join(repo, \\\\\\\"scripts/check-version-only-diff.mjs\\\\\\\"), rc, stable], { cwd: repo, env, encoding: \\\\\\\"utf8\\\\\\\" });\\\\n  const setVersion = (version: string) => {\\\\n    const file = path.join(repo, \\\\\\\"package.json\\\\\\\");\\\\n    fs.writeFileSync(file, fs.readFileSync(file, \\\\\\\"utf8\\\\\\\").replace(/(\\\\\\\"version\\\\\\\":\\\\\\\\s*)\\\\\\\"[^\\\\\\\"]*\\\\\\\"/, `$1\\\\\\\"${version}\\\\\\\"`));\\\\n    const sync = spawnSync(process.execPath, [path.join(repo, \\\\\\\"scripts/sync-version.mjs\\\\\\\")], { cwd: repo, env, encoding: \\\\\\\"utf8\\\\\\\" });\\\\n    assert.equal(sync.status, 0, sync.stderr);\\\\n  };\\\\n  try {\\\\n    assert.equal(spawnSync(\\\\\\\"git\\\\\\\", [\\\\\\\"clone\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"--no-local\\\\\\\", ROOT, repo], { env }).status, 0);\\\\n    // The checkout under test may carry uncommitted changes to the script itself: test that version.\\\\n    fs.copyFileSync(path.join(ROOT, \\\\\\\"scripts/check-version-only-diff.mjs\\\\\\\"), path.join(repo, \\\\\\\"scripts/check-version-only-diff.mjs\\\\\\\"));\\\\n    setVersion(\\\\\\\"9.9.9-rc.1\\\\\\\");\\\\n    git(\\\\\\\"add\\\\\\\", \\\\\\\"-A\\\\\\\");\\\\n    git(\\\\\\\"commit\\\\\\\", \\\\\\\"-qm\\\\\\\", \\\\\\\"rc\\\\\\\", \\\\\\\"--allow-empty\\\\\\\");\\\\n    const rc = git(\\\\\\\"rev-parse\\\\\\\", \\\\\\\"HEAD\\\\\\\");\\\\n\\\\n    setVersion(\\\\\\\"9.9.9\\\\\\\");\\\\n    git(\\\\\\\"commit\\\\\\\", \\\\\\\"-qam\\\\\\\", \\\\\\\"release: v9.9.9\\\\\\\");\\\\n    const good = check(rc, \\\\\\\"HEAD\\\\\\\");\\\\n    assert.equal(good.status, 0, good.stderr);\\\\n    assert.match(good.stdout, /version-only: .* \\\\\\\\+ v9\\\\\\\\.9\\\\\\\\.9/);\\\\n    const validStable = git(\\\\\\\"rev-parse\\\\\\\", \\\\\\\"HEAD\\\\\\\");\\\\n\\\\n    git(\\\\\\\"reset\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"--hard\\\\\\\", rc);\\\\n    setVersion(\\\\\\\"9.9.10\\\\\\\");\\\\n    git(\\\\\\\"commit\\\\\\\", \\\\\\\"-qam\\\\\\\", \\\\\\\"stable version does not match accepted RC\\\\\\\");\\\\n    const mismatchedPromotion = check(rc, \\\\\\\"HEAD\\\\\\\");\\\"}]},\\\"match_line\\\":36,\\\"match_lines\\\":[19,20,32,36,37,38,41,45]},{\\\"_index\\\":\\\"nexus-test-docs\\\",\\\"_id\\\":\\\"3e61883b9b40197c9dd90212a7cbd3e1\\\",\\\"_score\\\":13.962232,\\\"_source\\\":{\\\"title\\\":\\\"checkpoint_snapshot_confinement.test.ts\\\",\\\"ax_path\\\":\\\"checkpoint_snapshot_confinement.test.ts\\\",\\\"ax_file\\\":\\\"axf2-d6f1366b940ced4d91c67aee5bfc374e-19ab\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":87,\\\"start_offset\\\":3353,\\\"end_offset\\\":5355,\\\"text\\\":\\\"    cm.pruneCheckpoints(0);\\\\n    assert.equal(fs.existsSync(path.join(victim, \\\\\\\"keep.txt\\\\\\\")), true);\\\\n  });\\\\n});\\\\n\\\\ntest(\\\\\\\"restore cannot copy a directory outside the checkpoint snapshots\\\\\\\", () => {\\\\n  withSetup(false, ({ root, ws, cpDir, cm }) => {\\\\n    const victim = path.join(root, \\\\\\\"victim\\\\\\\");\\\\n    fs.mkdirSync(victim);\\\\n    fs.writeFileSync(path.join(victim, \\\\\\\"secret.txt\\\\\\\"), \\\\\\\"outside\\\\\\\");\\\\n    writeRecord(cpDir, \\\\\\\"cp_1_abcd.json\\\\\\\", { id: \\\\\\\"cp_1_abcd\\\\\\\", name: \\\\\\\"old\\\\\\\", timestamp: \\\\\\\"1\\\\\\\", snapshotDir: victim });\\\\n    const result = cm.restore(\\\\\\\"cp_1_abcd\\\\\\\");\\\\n    assert.equal(result.success, false);\\\\n    assert.equal(fs.existsSync(path.join(ws, \\\\\\\"secret.txt\\\\\\\")), false);\\\\n  });\\\\n});\\\\n\\\\ntest(\\\\\\\"git-backed prune, diff and restore never execute state text\\\\\\\", () => {\\\\n  withSetup(true, ({ root, cpDir, cm }) => {\\\\n    const marker = path.join(root, \\\\\\\"PWNED\\\\\\\");\\\\n    writeRecord(cpDir, \\\\\\\"inj.json\\\\\\\", {\\\\n      id: `cp_x; touch ${marker}`,\\\\n      name: \\\\\\\"inj\\\\\\\",\\\\n      timestamp: \\\\\\\"1\\\\\\\",\\\\n      gitRef: \\\\\\\"HEAD\\\\\\\",\\\\n    });\\\\n    writeRecord(cpDir, \\\\\\\"cp_1_abcd.json\\\\\\\", {\\\\n      id: \\\\\\\"cp_1_abcd\\\\\\\",\\\\n      name: \\\\\\\"inj\\\\\\\",\\\\n      timestamp: \\\\\\\"2\\\\\\\",\\\\n      gitRef: `HEAD; touch ${marker}2`,\\\\n    });\\\\n    cm.pruneCheckpoints(0);\\\\n    assert.equal(fs.existsSync(marker), false, \\\\\\\"id text must not reach a shell\\\\\\\");\\\\n    assert.equal(fs.existsSync(`${marker}2`), false, \\\\\\\"prune must not use a non-hex gitRef\\\\\\\");\\\\n\\\\n    writeRecord(cpDir, \\\\\\\"cp_1_abcd.json\\\\\\\", {\\\\n      id: \\\\\\\"cp_1_abcd\\\\\\\",\\\\n      name: \\\\\\\"inj\\\\\\\",\\\\n      timestamp: \\\\\\\"2\\\\\\\",\\\\n      gitRef: `HEAD; touch ${marker}3`,\\\\n    });\\\\n    cm.getDiff(\\\\\\\"cp_1_abcd\\\\\\\");\\\\n    assert.equal(fs.existsSync(`${marker}3`), false, \\\\\\\"diff must not use a non-hex gitRef\\\\\\\");\\\\n\\\\n    writeRecord(cpDir, \\\\\\\"cp_1_abcd.json\\\\\\\", {\\\\n      id: \\\\\\\"cp_1_abcd\\\\\\\",\\\\n      name: \\\\\\\"inj\\\\\\\",\\\\n      timestamp: \\\\\\\"2\\\\\\\",\\\\n      gitRef: `HEAD; touch ${marker}4`,\\\\n    });\\\\n    cm.restore(\\\\\\\"cp_1_abcd\\\\\\\");\\\\n    assert.equal(fs.existsSync(`${marker}4`), false, \\\\\\\"restore must not use a non-hex gitRef\\\\\\\");\\\\n  });\\\\n});\\\\n\\\\ntest(\\\\\\\"a record id that does not match its filename is ignored\\\\\\\", () => {\\\\n  withSetup(false, ({ cpDir, cm }) => {\\\"}]},\\\"match_line\\\":93,\\\"match_lines\\\":[93,99,105,139,140,144]}]},\\\"_token_budget\\\":{\\\"tokenizer\\\":\\\"standard-uax29-words\\\",\\\"max_tokens\\\":1400,\\\"hits_full\\\":4,\\\"hits_locator_only\\\":[{\\\"_index\\\":\\\"nexus-test-docs\\\",\\\"_id\\\":\\\"4929cd6e88851bb84bac1fc18b4ef236\\\",\\\"ax_path\\\":\\\"repro_identity.test.ts\\\",\\\"ax_file\\\":\\\"axf2-cd7c60239479657d75b73511d5b369e2-3304\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"match_line\\\":126,\\\"match_lines\\\":[103,104,115,116,117,126,127,128]}],\\\"deduped_overlapping\\\":0,\\\"hits_dropped\\\":0,\\\"tokens_used\\\":1268}}\"}],\"isError\":false}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18405-0795-7761-83bc-7e851bfd6fd4","create_time":1793216652.4296885}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
