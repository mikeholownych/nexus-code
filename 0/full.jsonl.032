{"timestamp":"2026-10-28T23:03:14.673Z","ordinal":468874,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a184b8-1382-7c51-b7ba-1106ed9497c7","item":{"type":"CommandExecution","id":"exec-c7ca9396-bc5d-4b63-b6bf-8f9648850fbe","process_id":"31383","command":["/usr/bin/zsh","-lc","nl -ba /home/mike/nexus-wt/qualify-all-accepted-v9/cli/src/operation_cli.ts | sed -n '1,110p;180,390p' && nl -ba /home/mike/nexus-wt/qualify-all-accepted-v9/cli/src/ui.ts | sed -n '1,45p' && nl -ba /home/mike/nexus-wt/qualify-all-accepted-v9/cli/src/operation_cli.ts | sed -n '1,110p'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"read","cmd":"nl -ba /home/mike/nexus-wt/qualify-all-accepted-v9/cli/src/operation_cli.ts","name":"operation_cli.ts","path":"/home/mike/nexus-wt/qualify-all-accepted-v9/cli/src/operation_cli.ts"},{"type":"read","cmd":"nl -ba /home/mike/nexus-wt/qualify-all-accepted-v9/cli/src/ui.ts","name":"ui.ts","path":"/home/mike/nexus-wt/qualify-all-accepted-v9/cli/src/ui.ts"},{"type":"read","cmd":"nl -ba /home/mike/nexus-wt/qualify-all-accepted-v9/cli/src/operation_cli.ts","name":"operation_cli.ts","path":"/home/mike/nexus-wt/qualify-all-accepted-v9/cli/src/operation_cli.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"     1\t/**\n     2\t * `nexus operation run|resume|status`: convergence-scheduled operations from a work-unit spec.\n     3\t *\n     4\t * Spec (JSON): { \"objective\": string, \"id\"?: string, \"units\": WorkUnitSpec[], \"resources\"?: ResourceDescriptor[],\n     5\t * \"discoverCatalog\"?: boolean, \"policy\"?: Partial<OperationPolicy> }. Without \"resources\" the configured endpoint,\n     6\t * fallbacks and planner/coder models are the resources.\n     7\t *\n     8\t * `nexus operation decide <id> <decision> <option>` applies an operator decision to a BLOCKED unit: it is validated\n     9\t * against the persisted decision, recorded on the unit, and the operation is re-evaluated (and resumed unless\n    10\t * --no-resume). /team operations are ordinary operations and use the same commands.\n    11\t */\n    12\timport * as fs from \"node:fs\";\n    13\timport * as path from \"node:path\";\n    14\timport { randomUUID } from \"node:crypto\";\n    15\timport type { Command } from \"commander\";\n    16\timport pc from \"picocolors\";\n    17\timport { buildConfig, mergeOperationPolicy } from \"./config.js\";\n    18\timport { DecisionRejected, newOperation, type DurableOperationState, type OperationEvent, type OperationPolicy, type WorkUnitSpec } from \"./core/operation.js\";\n    19\timport { AgentWorkUnitExecutor, applyOperatorDecision, driveOperation, OperationLockedError, OperationStore, resourcesFromConfig } from \"./core/operation_runner.js\";\n    20\timport { buildOperationView, renderOperationView, watchOperation } from \"./operation_view.js\";\n    21\timport { ensureIntegrationWorktree, newOperationGitState, planOperationGit } from \"./core/operation_git.js\";\n    22\timport { ContextCheckpointError, createContextCheckpoint, listContextCheckpoints, restoreContextCheckpoint } from \"./core/operation_checkpoints.js\";\n    23\timport { safeTerminal } from \"./ui.js\";\n    24\timport { credentialFingerprint, type ResourceDescriptor } from \"./core/resources.js\";\n    25\timport { createOperationAccountIdentity } from \"./core/account_identity.js\";\n    26\timport { credentialStorageHome, operatorSetting } from \"./client.js\";\n    27\timport { baseUrlSetting, originOf, providerDefinition } from \"./providers.js\";\n    28\timport { providerApiKey } from \"./credentials.js\";\n    29\timport type { HarnessConfig } from \"./types.js\";\n    30\t\n    31\tinterface OperationSpec {\n    32\t  id?: string;\n    33\t  objective: string;\n    34\t  units: WorkUnitSpec[];\n    35\t  resources?: Array<Partial<ResourceDescriptor> & { id: string; endpoint?: string; model: string }>;\n    36\t  discoverCatalog?: boolean;\n    37\t  policy?: Partial<OperationPolicy>;\n    38\t  /** Opt-in Git isolation: each unit runs on its own worktree/branch; completions merge into an operation branch. */\n    39\t  git?: { isolate?: boolean; baseRef?: string };\n    40\t}\n    41\t\n    42\tfunction normalizeResources(spec: OperationSpec, config: HarnessConfig, identity: ReturnType<typeof createOperationAccountIdentity>): ResourceDescriptor[] {\n    43\t  if (!spec.resources?.length) return resourcesFromConfig(config, identity);\n    44\t  const configOrigin = new URL(config.endpoint.replace(/\\/+$/, \"\")).origin;\n    45\t  return spec.resources.map((r) => {\n    46\t    const def = providerDefinition(r.providerId);\n    47\t    if (r.providerId && !def) throw new Error(`Resource ${r.id}: unknown providerId '${r.providerId}'.`);\n    48\t    const base = def ? (r.endpoint || operatorSetting(baseUrlSetting(def.id)) || def.baseUrl || \"\") : \"\";\n    49\t    if (def && !originOf(base)) throw new Error(`Resource ${r.id}: provider '${def.id}' needs an endpoint (base URL).`);\n    50\t    if (!def && !r.endpoint) throw new Error(`Resource ${r.id}: endpoint is required unless providerId is given.`);\n    51\t    const plain = (r.endpoint ?? \"\").replace(/\\/+$/, \"\");\n    52\t    // A provider base URL carries its own API path; only plain endpoints get the legacy /v1 suffix.\n    53\t    const endpoint = def ? base.replace(/\\/+$/, \"\") : plain.endsWith(\"/v1\") ? plain : `${plain}/v1`;\n    54\t    const provider = r.provider ?? (def ? def.id : new URL(endpoint).origin);\n    55\t    const key = r.apiKeyEnv ? process.env[r.apiKeyEnv] : def ? providerApiKey(def.id, def.credentialEnv) : provider === configOrigin ? config.apiKey : undefined;\n    56\t    const account = r.account ?? credentialFingerprint(key, identity);\n    57\t    return {\n    58\t      ...r,\n    59\t      endpoint,\n    60\t      provider,\n    61\t      capabilities: r.capabilities ?? [\"tools\"],\n    62\t      ...(account ? { account, accountIdentitySource: r.account !== undefined ? \"explicit\" as const : \"credential\" as const } : {}),\n    63\t    } as ResourceDescriptor;\n    64\t  });\n    65\t}\n    66\t\n    67\tfunction printEvent(e: OperationEvent): void {\n    68\t  const color = e.type === \"OPERATION_BLOCKED\" || e.type === \"WORK_BLOCKED\" ? pc.red : e.type.startsWith(\"RESOURCE_\") ? pc.dim : e.type === \"OPERATION_COMPLETED\" ? pc.green : pc.cyan;\n    69\t  console.log(color(`◆ ${safeTerminal(e.message)}`));\n    70\t}\n    71\t\n    72\tfunction printStatus(op: DurableOperationState): void {\n    73\t  console.log(pc.bold(`Operation ${safeTerminal(op.id)}: ${safeTerminal(op.status)}`) + pc.dim(`  (${safeTerminal(op.objective)})`));\n    74\t  for (const u of op.units) {\n    75\t    const extra =\n    76\t      u.status === \"PARKED\" ? ` — ${u.parked!.reason}; wakes ${u.parked!.wakeAt}` :\n    77\t      u.status === \"BLOCKED\" ? ` — ${u.blocked!.reason}` :\n    78\t      u.status === \"COMPLETE\" ? ` — on ${u.result!.resourceId}` :\n    79\t      u.assignment ? ` — ${u.assignment.resourceId}` : \"\";\n    80\t    console.log(`  ${safeTerminal(u.status).padEnd(22)} ${safeTerminal(u.title)}${pc.dim(safeTerminal(extra))}`);\n    81\t  }\n    82\t  if (op.wait) console.log(pc.yellow(`Waiting until ${safeTerminal(op.wait.wakeAt)}: ${safeTerminal(op.wait.reason)}`));\n    83\t  for (const d of op.blocked?.decisions ?? []) {\n    84\t    console.log(pc.red(`Decision ${safeTerminal(d.id)} needed: ${safeTerminal(d.question)}`));\n    85\t    for (const o of d.options) console.log(pc.red(`  [${safeTerminal(o.id)}] ${safeTerminal(o.label)}`));\n    86\t    if (d.options.length) console.log(pc.dim(`  nexus operation decide ${safeTerminal(op.id)} ${safeTerminal(d.id)} <option> [--note <text>]`));\n    87\t  }\n    88\t}\n    89\t\n    90\tasync function drive(op: DurableOperationState, config: HarnessConfig, store: OperationStore, discoverCatalog: boolean, json: boolean): Promise<void> {\n    91\t  const controller = new AbortController();\n    92\t  const onSignal = () => controller.abort();\n    93\t  process.once(\"SIGINT\", onSignal);\n    94\t  try {\n    95\t    const out = await driveOperation(op, {\n    96\t      store,\n    97\t      signal: controller.signal,\n    98\t      executor: new AgentWorkUnitExecutor({ baseConfig: config, discoverCatalog }),\n    99\t      ...(json ? {} : { onEvent: printEvent }),\n   100\t    });\n   101\t    if (json) console.log(JSON.stringify(out, null, 2));\n   102\t    else printStatus(out);\n   103\t    process.exitCode = out.status === \"COMPLETE\" ? 0 : out.status === \"CANCELLED\" ? 130 : 2;\n   104\t  } finally {\n   105\t    process.off(\"SIGINT\", onSignal);\n   106\t  }\n   107\t}\n   108\t\n   109\tfunction operationAction<T extends unknown[]>(action: (...args: T) => void | Promise<void>): (...args: T) => Promise<void> {\n   110\t  return async (...args: T) => {\n   180\t  common(op.command(\"decide\").argument(\"<id>\", \"Operation id\").argument(\"<decision>\", \"Decision id (e.g. review#1)\").argument(\"<option>\", \"Option id\"))\n   181\t    .option(\"--note <text>\", \"Operator note (required to revise a unit)\")\n   182\t    .option(\"--no-resume\", \"Record the decision without resuming the operation\")\n   183\t    .description(\"Apply an operator decision to a blocked unit, then resume the operation\")\n   184\t    .action(operationAction(async (id: string, decisionId: string, optionId: string, options: any) => {\n   185\t      const config = buildConfig(options);\n   186\t      const store = new OperationStore(config.workspace);\n   187\t      let state: DurableOperationState;\n   188\t      try {\n   189\t        state = applyOperatorDecision(store, id, decisionId, optionId, options.note, { onEvent: printEvent });\n   190\t      } catch (err) {\n   191\t        if (!(err instanceof DecisionRejected)) throw err;\n   192\t        console.error(pc.red(`Decision rejected: ${safeTerminal(String(err.message))}`));\n   193\t        process.exitCode = 2;\n   194\t        return;\n   195\t      }\n   196\t      if (options.resume === false) return void printStatus(state);\n   197\t      await drive(state, config, store, Boolean(options.discover), Boolean(options.json));\n   198\t    }));\n   199\t\n   200\t  op.command(\"status\")\n   201\t    .argument(\"[id]\", \"Operation id (default: all operations in this workspace)\")\n   202\t    .option(\"-w, --workspace <path>\", \"Workspace directory (default: current directory)\")\n   203\t    .option(\"-j, --json\", \"JSON output\")\n   204\t    .option(\"--dag\", \"Read-only view: work-unit DAG, resource eligibility and the open decision\")\n   205\t    .option(\"--events <count>\", \"Events to include with --dag (newest kept)\", \"20\")\n   206\t    .description(\"Show operation state, parked work, wake time and pending decisions\")\n   207\t    .action(operationAction((id: string | undefined, options: any) => {\n   208\t      const store = new OperationStore(path.resolve(options.workspace ?? process.cwd()));\n   209\t      if (options.dag) {\n   210\t        const eventsText = String(options.events);\n   211\t        const eventLimit = Number(eventsText);\n   212\t        if (!eventsText.trim() || !Number.isFinite(eventLimit) || eventLimit < 0) {\n   213\t          console.error(pc.red(`--events must be a non-negative number (got '${safeTerminal(String(options.events))}')`));\n   214\t          process.exitCode = 2;\n   215\t          return;\n   216\t        }\n   217\t        // The view path never takes the operation lock, so it can inspect an operation another process is driving.\n   218\t        // The state loader may still migrate or quarantine a legacy/corrupt record, exactly as `status` does.\n   219\t        let ops: DurableOperationState[];\n   220\t        try {\n   221\t          ops = id ? [store.load(id)] : store.list();\n   222\t        } catch (error: any) {\n   223\t          console.error(pc.red(`Cannot read operation ${safeTerminal(id ?? \"(all)\")}: ${safeTerminal(String(error?.message ?? error))}`));\n   224\t          process.exitCode = 2;\n   225\t          return;\n   226\t        }\n   227\t        const views = ops.map((state) => buildOperationView(state, { events: Math.floor(eventLimit) }));\n   228\t        if (options.json) return void console.log(JSON.stringify(views, null, 2));\n   229\t        if (!views.length) return void console.log(\"No operations in this workspace.\");\n   230\t        const width = process.stdout.isTTY ? process.stdout.columns ?? 0 : 0;\n   231\t        views.forEach((view) => console.log(renderOperationView(view, { width })));\n   232\t        return;\n   233\t      }\n   234\t      const ops = id ? [store.loadForInspection(id)] : store.listForInspection();\n   235\t      if (options.json) return void console.log(JSON.stringify(ops, null, 2));\n   236\t      if (!ops.length) return void console.log(\"No operations in this workspace.\");\n   237\t      ops.forEach(printStatus);\n   238\t    }));\n   239\t\n   240\t  op.command(\"checkpoint\")\n   241\t    .argument(\"<id>\", \"Operation id\")\n   242\t    .argument(\"<unit>\", \"Work unit id\")\n   243\t    .option(\"--name <name>\", \"Checkpoint name (default: a timestamp)\")\n   244\t    .option(\"-w, --workspace <path>\", \"Workspace directory (default: current directory)\")\n   245\t    .description(\"Snapshot a settled unit's conversation so it can be restored later\")\n   246\t    .action((id: string, unitId: string, options: any) => {\n   247\t      const store = new OperationStore(path.resolve(options.workspace ?? process.cwd()));\n   248\t      const name = options.name ?? `cp-${new Date().toISOString().replace(/[:.]/g, \"-\")}`;\n   249\t      try {\n   250\t        // Checkpointing mutates the operation document; hold the driver lock for the whole read-modify-write.\n   251\t        const release = store.acquire(id);\n   252\t        try {\n   253\t          const state = store.load(id);\n   254\t          const record = createContextCheckpoint(store.manager, state, unitId, name);\n   255\t          store.save(state);\n   256\t          console.log(pc.bold(`Checkpoint ${record.name}`) + pc.dim(` — ${record.messages} messages, ${record.bytes} bytes`));\n   257\t          console.log(pc.dim(`  restore with: nexus operation restore ${id} ${unitId} ${record.name}`));\n   258\t        } finally {\n   259\t          release();\n   260\t        }\n   261\t      } catch (error: any) {\n   262\t        if (error instanceof OperationLockedError) {\n   263\t          console.error(pc.red(`Operation ${id} is being driven by another process; checkpoint it when the driver is stopped.`));\n   264\t          process.exitCode = 2;\n   265\t          return;\n   266\t        }\n   267\t        if (!(error instanceof ContextCheckpointError)) {\n   268\t          console.error(pc.red(`Cannot checkpoint ${id}: ${safeTerminal(String(error?.message ?? error))}`));\n   269\t          process.exitCode = 2;\n   270\t          return;\n   271\t        }\n   272\t        console.error(pc.red(`Checkpoint rejected: ${safeTerminal(error.message)}`));\n   273\t        process.exitCode = 2;\n   274\t      }\n   275\t    });\n   276\t\n   277\t  op.command(\"checkpoints\")\n   278\t    .argument(\"<id>\", \"Operation id\")\n   279\t    .option(\"-w, --workspace <path>\", \"Workspace directory (default: current directory)\")\n   280\t    .option(\"-j, --json\", \"JSON output\")\n   281\t    .description(\"List the operation's context checkpoints\")\n   282\t    .action((id: string, options: any) => {\n   283\t      const store = new OperationStore(path.resolve(options.workspace ?? process.cwd()));\n   284\t      let state: DurableOperationState;\n   285\t      try {\n   286\t        state = store.load(id);\n   287\t      } catch (error: any) {\n   288\t        console.error(pc.red(`Cannot read operation ${id}: ${safeTerminal(String(error?.message ?? error))}`));\n   289\t        process.exitCode = 2;\n   290\t        return;\n   291\t      }\n   292\t      const checkpoints = listContextCheckpoints(state);\n   293\t      if (options.json) return void console.log(JSON.stringify(checkpoints, null, 2));\n   294\t      if (!checkpoints.length) return void console.log(\"No context checkpoints for this operation.\");\n   295\t      for (const checkpoint of checkpoints) {\n   296\t        console.log(`  ${checkpoint.name.padEnd(28)} ${checkpoint.unitId.padEnd(20)} ${checkpoint.at}  ${checkpoint.messages} messages`);\n   297\t      }\n   298\t    });\n   299\t\n   300\t  op.command(\"restore\")\n   301\t    .argument(\"<id>\", \"Operation id\")\n   302\t    .argument(\"<unit>\", \"Work unit id\")\n   303\t    .argument(\"<name>\", \"Checkpoint name\")\n   304\t    .option(\"-w, --workspace <path>\", \"Workspace directory (default: current directory)\")\n   305\t    .description(\"Restore a unit's conversation from a checkpoint (verification restarts fail-closed)\")\n   306\t    .action((id: string, unitId: string, name: string, options: any) => {\n   307\t      const store = new OperationStore(path.resolve(options.workspace ?? process.cwd()));\n   308\t      try {\n   309\t        const release = store.acquire(id);\n   310\t        try {\n   311\t          const state = store.load(id);\n   312\t          const restored = restoreContextCheckpoint(store.manager, state, unitId, name);\n   313\t          store.save(state);\n   314\t          console.log(pc.bold(`Restored ${unitId} from ${name}`) + pc.dim(` — ${restored.record.messages} messages`));\n   315\t          if (restored.backupDir) console.log(pc.dim(`  previous task state kept at ${restored.backupDir}`));\n   316\t          console.log(pc.yellow(`The restored conversation is recovered as unverified; resume with: nexus operation resume ${id}`));\n   317\t        } finally {\n   318\t          release();\n   319\t        }\n   320\t      } catch (error: any) {\n   321\t        if (error instanceof OperationLockedError) {\n   322\t          console.error(pc.red(`Operation ${id} is being driven by another process; restore it when the driver is stopped.`));\n   323\t          process.exitCode = 2;\n   324\t          return;\n   325\t        }\n   326\t        if (!(error instanceof ContextCheckpointError)) {\n   327\t          console.error(pc.red(`Cannot restore ${id}: ${safeTerminal(String(error?.message ?? error))}`));\n   328\t          process.exitCode = 2;\n   329\t          return;\n   330\t        }\n   331\t        console.error(pc.red(`Restore rejected: ${safeTerminal(error.message)}`));\n   332\t        process.exitCode = 2;\n   333\t      }\n   334\t    });\n   335\t\n   336\t  op.command(\"watch\")\n   337\t    .argument(\"[id]\", \"Operation id (default: the only operation in this workspace)\")\n   338\t    .option(\"-w, --workspace <path>\", \"Workspace directory (default: current directory)\")\n   339\t    .option(\"--interval <seconds>\", \"Refresh interval (minimum 0.25)\", \"2\")\n   340\t    .option(\"--events <count>\", \"Events to include (newest kept)\", \"20\")\n   341\t    .description(\"Watch an operation read-only until it completes or you stop it (Ctrl-C)\")\n   342\t    .action(operationAction(async (id: string | undefined, options: any) => {\n   343\t      const store = new OperationStore(path.resolve(options.workspace ?? process.cwd()));\n   344\t      const intervalSecs = Number(options.interval);\n   345\t      const eventsText = String(options.events);\n   346\t      const eventLimit = Number(eventsText);\n   347\t      if (!Number.isFinite(intervalSecs) || intervalSecs <= 0 || !eventsText.trim() || !Number.isFinite(eventLimit) || eventLimit < 0) {\n   348\t        console.error(pc.red(\"--interval must be a positive number of seconds and --events a non-negative number\"));\n   349\t        process.exitCode = 2;\n   350\t        return;\n   351\t      }\n   352\t      let target = id;\n   353\t      if (!target) {\n   354\t        let operations: DurableOperationState[];\n   355\t        try {\n   356\t          operations = store.list();\n   357\t        } catch (error: any) {\n   358\t          console.error(pc.red(`Cannot read operations: ${safeTerminal(String(error?.message ?? error))}`));\n   359\t          process.exitCode = 2;\n   360\t          return;\n   361\t        }\n   362\t        if (!operations.length) {\n   363\t          console.error(pc.red(\"No operations in this workspace.\"));\n   364\t          process.exitCode = 2;\n   365\t          return;\n   366\t        }\n   367\t        if (operations.length > 1) {\n   368\t          console.error(pc.red(\"More than one operation in this workspace; pass an id:\"));\n   369\t          for (const operation of operations) {\n   370\t            const id = safeTerminal(operation.id).replace(/[\\r\\n\\t]+/g, \" \");\n   371\t            const status = safeTerminal(operation.status).replace(/[\\r\\n\\t]+/g, \" \");\n   372\t            const objective = safeTerminal(operation.objective).replace(/[\\r\\n\\t]+/g, \" \");\n   373\t            console.error(`  ${id}  ${status}  ${objective}`);\n   374\t          }\n   375\t          process.exitCode = 2;\n   376\t          return;\n   377\t        }\n   378\t        target = operations[0].id;\n   379\t      }\n   380\t      const watchId = target;\n   381\t      if (!process.stdout.isTTY) {\n   382\t        // A pipe is not a live view; render the current snapshot once so scripts get an answer instead of a hang.\n   383\t        let state: DurableOperationState;\n   384\t        try {\n   385\t          state = store.load(watchId);\n   386\t        } catch (error: any) {\n   387\t          console.error(pc.red(`Cannot read operation ${safeTerminal(watchId)}: ${safeTerminal(String(error?.message ?? error))}`));\n   388\t          process.exitCode = 2;\n   389\t          return;\n   390\t        }\n     1\timport pc from \"picocolors\";\n     2\timport ora, { Ora } from \"ora\";\n     3\timport { TurnResult, summarizeTurn } from \"./core/turn.js\";\n     4\timport { highlightDiff, highlightCode } from \"./syntax.js\";\n     5\timport { InformationFlowBoundary } from \"./core/egress.js\";\n     6\timport { visibleControls } from \"./file_diff.js\";\n     7\timport { isNexusDirPermissive } from \"./core/durable_file.js\";\n     8\t\n     9\texport function redactSecrets(text: string): string {\n    10\t  if (!text) return text;\n    11\t  let result = text;\n    12\t  try {\n    13\t    const boundary = InformationFlowBoundary.getGlobalInstance();\n    14\t    const redacted = boundary.redactForTelemetry(text);\n    15\t    if (typeof redacted === \"string\") {\n    16\t      result = redacted;\n    17\t    }\n    18\t  } catch {}\n    19\t  return result\n    20\t    .replace(/Bearer\\s+[A-Za-z0-9_\\-\\.]{15,}/gi, \"Bearer [REDACTED_TOKEN]\")\n    21\t    .replace(/((?:proxy-)?authorization[\"']?\\s*[:=]\\s*[\"']?(?:basic|bearer|token)\\s+[\"']?)[A-Za-z0-9._~+/=-]{8,}/gi, \"$1[REDACTED]\")\n    22\t    .replace(/(?:sk-|ghp_|gho_|glpat-|xoxb-|xoxp-)[A-Za-z0-9_\\-]{16,}/g, \"[REDACTED_KEY]\")\n    23\t    .replace(/-----BEGIN[ A-Z0-9_-]*PRIVATE KEY-----[\\s\\S]*?-----END[ A-Z0-9_-]*PRIVATE KEY-----/g, \"[REDACTED_PRIVATE_KEY]\")\n    24\t    .replace(/((?:password|secret|token|api[_-]?key)[\"']?\\s*[:=]\\s*[\"']?)([^\"' \\s\\n\\r]{6,})([\"']?)/gi, \"$1[REDACTED]$3\");\n    25\t}\n    26\t\n    27\t/** Text safe to write to a terminal: secrets redacted, then every terminal control/bidi character made visible. */\n    28\texport function safeTerminal(text: string): string {\n    29\t  return visibleControls(redactSecrets(text));\n    30\t}\n    31\t\n    32\texport class TerminalUI {\n    33\t  private spinner: Ora | null = null;\n    34\t\n    35\t  banner(): void {\n    36\t    console.log(`\\n${pc.bold(pc.black(pc.bgCyan(\" NEXUS \")))} ${pc.dim(\"local engineering agent\")}`);\n    37\t    console.log(pc.dim(\"Understand the work. Inspect the evidence. Keep the decision yours.\\n\"));\n    38\t    if (isNexusDirPermissive()) {\n    39\t      console.log(pc.yellow(\"your Nexus state is readable by other users; run `nexus doctor --fix`\\n\"));\n    40\t    }\n    41\t  }\n    42\t\n    43\t  stepHeader(step: number, maxSteps: number): void {\n    44\t    if (process.env.NEXUS_DEBUG === \"1\") console.log(pc.dim(`\\nwork step ${step}${Number.isFinite(maxSteps) ? `/${maxSteps}` : \"\"}`));\n    45\t  }\n     1\t/**\n     2\t * `nexus operation run|resume|status`: convergence-scheduled operations from a work-unit spec.\n     3\t *\n     4\t * Spec (JSON): { \"objective\": string, \"id\"?: string, \"units\": WorkUnitSpec[], \"resources\"?: ResourceDescriptor[],\n     5\t * \"discoverCatalog\"?: boolean, \"policy\"?: Partial<OperationPolicy> }. Without \"resources\" the configured endpoint,\n     6\t * fallbacks and planner/coder models are the resources.\n     7\t *\n     8\t * `nexus operation decide <id> <decision> <option>` applies an operator decision to a BLOCKED unit: it is validated\n     9\t * against the persisted decision, recorded on the unit, and the operation is re-evaluated (and resumed unless\n    10\t * --no-resume). /team operations are ordinary operations and use the same commands.\n    11\t */\n    12\timport * as fs from \"node:fs\";\n    13\timport * as path from \"node:path\";\n    14\timport { randomUUID } from \"node:crypto\";\n    15\timport type { Command } from \"commander\";\n    16\timport pc from \"picocolors\";\n    17\timport { buildConfig, mergeOperationPolicy } from \"./config.js\";\n    18\timport { DecisionRejected, newOperation, type DurableOperationState, type OperationEvent, type OperationPolicy, type WorkUnitSpec } from \"./core/operation.js\";\n    19\timport { AgentWorkUnitExecutor, applyOperatorDecision, driveOperation, OperationLockedError, OperationStore, resourcesFromConfig } from \"./core/operation_runner.js\";\n    20\timport { buildOperationView, renderOperationView, watchOperation } from \"./operation_view.js\";\n    21\timport { ensureIntegrationWorktree, newOperationGitState, planOperationGit } from \"./core/operation_git.js\";\n    22\timport { ContextCheckpointError, createContextCheckpoint, listContextCheckpoints, restoreContextCheckpoint } from \"./core/operation_checkpoints.js\";\n    23\timport { safeTerminal } from \"./ui.js\";\n    24\timport { credentialFingerprint, type ResourceDescriptor } from \"./core/resources.js\";\n    25\timport { createOperationAccountIdentity } from \"./core/account_identity.js\";\n    26\timport { credentialStorageHome, operatorSetting } from \"./client.js\";\n    27\timport { baseUrlSetting, originOf, providerDefinition } from \"./providers.js\";\n    28\timport { providerApiKey } from \"./credentials.js\";\n    29\timport type { HarnessConfig } from \"./types.js\";\n    30\t\n    31\tinterface OperationSpec {\n    32\t  id?: string;\n    33\t  objective: string;\n    34\t  units: WorkUnitSpec[];\n    35\t  resources?: Array<Partial<ResourceDescriptor> & { id: string; endpoint?: string; model: string }>;\n    36\t  discoverCatalog?: boolean;\n    37\t  policy?: Partial<OperationPolicy>;\n    38\t  /** Opt-in Git isolation: each unit runs on its own worktree/branch; completions merge into an operation branch. */\n    39\t  git?: { isolate?: boolean; baseRef?: string };\n    40\t}\n    41\t\n    42\tfunction normalizeResources(spec: OperationSpec, config: HarnessConfig, identity: ReturnType<typeof createOperationAccountIdentity>): ResourceDescriptor[] {\n    43\t  if (!spec.resources?.length) return resourcesFromConfig(config, identity);\n    44\t  const configOrigin = new URL(config.endpoint.replace(/\\/+$/, \"\")).origin;\n    45\t  return spec.resources.map((r) => {\n    46\t    const def = providerDefinition(r.providerId);\n    47\t    if (r.providerId && !def) throw new Error(`Resource ${r.id}: unknown providerId '${r.providerId}'.`);\n    48\t    const base = def ? (r.endpoint || operatorSetting(baseUrlSetting(def.id)) || def.baseUrl || \"\") : \"\";\n    49\t    if (def && !originOf(base)) throw new Error(`Resource ${r.id}: provider '${def.id}' needs an endpoint (base URL).`);\n    50\t    if (!def && !r.endpoint) throw new Error(`Resource ${r.id}: endpoint is required unless providerId is given.`);\n    51\t    const plain = (r.endpoint ?? \"\").replace(/\\/+$/, \"\");\n    52\t    // A provider base URL carries its own API path; only plain endpoints get the legacy /v1 suffix.\n    53\t    const endpoint = def ? base.replace(/\\/+$/, \"\") : plain.endsWith(\"/v1\") ? plain : `${plain}/v1`;\n    54\t    const provider = r.provider ?? (def ? def.id : new URL(endpoint).origin);\n    55\t    const key = r.apiKeyEnv ? process.env[r.apiKeyEnv] : def ? providerApiKey(def.id, def.credentialEnv) : provider === configOrigin ? config.apiKey : undefined;\n    56\t    const account = r.account ?? credentialFingerprint(key, identity);\n    57\t    return {\n    58\t      ...r,\n    59\t      endpoint,\n    60\t      provider,\n    61\t      capabilities: r.capabilities ?? [\"tools\"],\n    62\t      ...(account ? { account, accountIdentitySource: r.account !== undefined ? \"explicit\" as const : \"credential\" as const } : {}),\n    63\t    } as ResourceDescriptor;\n    64\t  });\n    65\t}\n    66\t\n    67\tfunction printEvent(e: OperationEvent): void {\n    68\t  const color = e.type === \"OPERATION_BLOCKED\" || e.type === \"WORK_BLOCKED\" ? pc.red : e.type.startsWith(\"RESOURCE_\") ? pc.dim : e.type === \"OPERATION_COMPLETED\" ? pc.green : pc.cyan;\n    69\t  console.log(color(`◆ ${safeTerminal(e.message)}`));\n    70\t}\n    71\t\n    72\tfunction printStatus(op: DurableOperationState): void {\n    73\t  console.log(pc.bold(`Operation ${safeTerminal(op.id)}: ${safeTerminal(op.status)}`) + pc.dim(`  (${safeTerminal(op.objective)})`));\n    74\t  for (const u of op.units) {\n    75\t    const extra =\n    76\t      u.status === \"PARKED\" ? ` — ${u.parked!.reason}; wakes ${u.parked!.wakeAt}` :\n    77\t      u.status === \"BLOCKED\" ? ` — ${u.blocked!.reason}` :\n    78\t      u.status === \"COMPLETE\" ? ` — on ${u.result!.resourceId}` :\n    79\t      u.assignment ? ` — ${u.assignment.resourceId}` : \"\";\n    80\t    console.log(`  ${safeTerminal(u.status).padEnd(22)} ${safeTerminal(u.title)}${pc.dim(safeTerminal(extra))}`);\n    81\t  }\n    82\t  if (op.wait) console.log(pc.yellow(`Waiting until ${safeTerminal(op.wait.wakeAt)}: ${safeTerminal(op.wait.reason)}`));\n    83\t  for (const d of op.blocked?.decisions ?? []) {\n    84\t    console.log(pc.red(`Decision ${safeTerminal(d.id)} needed: ${safeTerminal(d.question)}`));\n    85\t    for (const o of d.options) console.log(pc.red(`  [${safeTerminal(o.id)}] ${safeTerminal(o.label)}`));\n    86\t    if (d.options.length) console.log(pc.dim(`  nexus operation decide ${safeTerminal(op.id)} ${safeTerminal(d.id)} <option> [--note <text>]`));\n    87\t  }\n    88\t}\n    89\t\n    90\tasync function drive(op: DurableOperationState, config: HarnessConfig, store: OperationStore, discoverCatalog: boolean, json: boolean): Promise<void> {\n    91\t  const controller = new AbortController();\n    92\t  const onSignal = () => controller.abort();\n    93\t  process.once(\"SIGINT\", onSignal);\n    94\t  try {\n    95\t    const out = await driveOperation(op, {\n    96\t      store,\n    97\t      signal: controller.signal,\n    98\t      executor: new AgentWorkUnitExecutor({ baseConfig: config, discoverCatalog }),\n    99\t      ...(json ? {} : { onEvent: printEvent }),\n   100\t    });\n   101\t    if (json) console.log(JSON.stringify(out, null, 2));\n   102\t    else printStatus(out);\n   103\t    process.exitCode = out.status === \"COMPLETE\" ? 0 : out.status === \"CANCELLED\" ? 130 : 2;\n   104\t  } finally {\n   105\t    process.off(\"SIGINT\", onSignal);\n   106\t  }\n   107\t}\n   108\t\n   109\tfunction operationAction<T extends unknown[]>(action: (...args: T) => void | Promise<void>): (...args: T) => Promise<void> {\n   110\t  return async (...args: T) => {\n","exit_code":0,"duration":{"secs":0,"nanos":37848}},"started_at_ms":1793228594672,"completed_at_ms":1793228594673}}
