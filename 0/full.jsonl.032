and: \"npm test\", timeoutSecs: 60 } }, dir), []);\n   370\t  assert.deepEqual(validateTask({ ...good, tier: \"T4\", t4Fixture: { kind: \"full_disk\", tool: \"run_command\", command: \"./test-disk-cap.sh\", storageLimitBytes: 64 * 1024 * 1024 } }, dir), []);\n   371\t  assert.match(validateTask({ ...good, t4Fixture: { kind: \"full_disk\", tool: \"run_command\", command: \"./test-disk-cap.sh\", storageLimitBytes: 64 } }, dir).join(), /only as an object on a T4 task/);\n   372\t  assert.match(validateTask({ ...good, tier: \"T4\", t4Fixture: { kind: \"full_disk\", tool: \"run_command\", command: \"./test-disk-cap.sh\" } }, dir).join(), /positive storageLimitBytes/);\n   373\t  assert.match(validateTask({ ...good, repo: { url: good.repo.url, commit: \"main\" } }, dir).join(), /pinned/);\n   374\t  assert.match(validateTask({ ...good, fixture: \"repo\" }, dir).join(), /exactly one of fixture or repo/);\n   375\t  assert.match(validateTask({ ...good, hidden: {} }, dir).join(), /hidden.command/);\n   376\t  // Legacy checks execute candidate modules in the validator process and are therefore not independent qualification.\n   377\t  assert.match(validateTask(good, dir, { qualification: true }).join(), /qualification requires the isolated blackbox-v1 hidden oracle/);\n   378\t  assert.match(validateTask({ ...good, class: \"bugfix\", difficulty: \"medium\", hidden: { dir: \"candidate\", command: \"npm test\" } }, dir, { qualification: true }).join(), /in-process legacy validators are not accepted/);\n   379\t  assert.match(validateTask({ ...good, class: \"bugfix\", difficulty: \"medium\", hidden: { protocol: \"blackbox-v1\", command: \"npm test\" } }, dir, { qualification: true }).join(), /unsupported fields/);\n   380\t  const cases = path.join(dir, \"private-cases.json\");\n   381\t  fs.writeFileSync(cases, JSON.stringify([{ input: { x: 1 }, expected: { x: 1 } }]));\n   382\t  fs.symlinkSync(cases, path.join(dir, \"private-cases-link.json\"));\n   383\t  const oracle = { p