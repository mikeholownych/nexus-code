marker}3`), false, \\\"diff must not use a non-hex gitRef\\\");\\n\\n    writeRecord(cpDir, \\\"cp_1_abcd.json\\\", {\\n      id: \\\"cp_1_abcd\\\",\\n      name: \\\"inj\\\",\\n      timestamp: \\\"2\\\",\\n      gitRef: `HEAD; touch ${marker}4`,\\n    });\\n    cm.restore(\\\"cp_1_abcd\\\");\\n    assert.equal(fs.existsSync(`${marker}4`), false, \\\"restore must not use a non-hex gitRef\\\");\\n  });\\n});\\n\\ntest(\\\"a record id that does not match its filename is ignored\\\", () => {\\n  withSetup(false, ({ cpDir, cm }) => {\"}]},\"match_line\":93,\"match_lines\":[93,99,105,139,140,144]}]},\"_token_budget\":{\"tokenizer\":\"standard-uax29-words\",\"max_tokens\":1400,\"hits_full\":4,\"hits_locator_only\":[{\"_index\":\"nexus-test-docs\",\"_id\":\"4929cd6e88851bb84bac1fc18b4ef236\",\"ax_path\":\"repro_identity.test.ts\",\"ax_file\":\"axf2-cd7c60239479657d75b73511d5b369e2-3304\",\"ax_locator\":\"code\",\"match_line\":126,\"match_lines\":[103,104,115,116,117,126,127,128]}],\"deduped_overlapping\":0,\"hits_dropped\":0,\"tokens_used\":1268}}"}],"isError":false},"duration":{"secs":1,"nanos":106405548}},"started_at_ms":1793216649362,"completed_at_ms":1793216650469}}
