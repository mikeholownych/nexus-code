{"timestamp":"2026-10-28T22:23:39.960Z","ordinal":467651,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a1849a-b358-70f3-86ea-b2ec73ad98ca","item":{"type":"CommandExecution","id":"exec-dc282480-88fe-48ec-9353-36a8d06fecfb","process_id":"8709","command":["/usr/bin/zsh","-lc","git show origin/main:eval/validate.mjs | nl -ba | sed -n '35,70p'; git show origin/main:eval/run.mjs | nl -ba | sed -n '700,740p'; git show origin/main:eval/README.md | rg -n -C 5 'legacy|hidden|custodian|convert|replace'; git show origin/main:docs/v1.0.0/DECISIONS.md | rg -n -C 3 'PR #33|legacy|hidden command|qualification'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git show origin/main:eval/validate.mjs | nl -ba | sed -n '35,70p'; git show origin/main:eval/run.mjs | nl -ba | sed -n '700,740p'; git show origin/main:eval/README.md | rg -n -C 5 'legacy|hidden|custodian|convert|replace'; git show origin/main:docs/v1.0.0/DECISIONS.md | rg -n -C 3 'PR #33|legacy|hidden command|qualification'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    35\t      const repoUrl = new URL(task.repo.url);\n    36\t      need(repoUrl.protocol === \"https:\" && !repoUrl.username && !repoUrl.password, \"repo.url must use HTTPS without embedded credentials\");\n    37\t    } catch { need(false, \"repo.url must be a valid HTTPS URL without embedded credentials\"); }\n    38\t    need(/^[0-9a-f]{40}$/.test(task.repo.commit ?? \"\"), \"repo.commit must be a full 40-character commit id (pinned)\");\n    39\t  }\n    40\t  const hiddenCommand = typeof task.hidden?.command === \"string\" && task.hidden.command.length > 0;\n    41\t  const hiddenOracle = task.hidden?.protocol === \"blackbox-v1\";\n    42\t  need(hiddenCommand || hiddenOracle, \"hidden.command or hidden blackbox-v1 oracle is required\");\n    43\t  if (hiddenOracle) {\n    44\t    const oracleProblem = blackBoxOracleProblem(task.hidden, dir, task.fixture ?? null);\n    45\t    need(!oracleProblem, oracleProblem ?? \"hidden black-box oracle is invalid\");\n    46\t  }\n    47\t  // Legacy validators execute candidate modules in the same runtime. File hiding and a fresh workspace cannot prevent\n    48\t  // candidate code from inspecting or mutating that runtime, so they are never valid independent qualification.\n    49\t  if (qualification) need(hiddenOracle && !hiddenCommand, \"qualification requires the isolated blackbox-v1 hidden oracle; in-process legacy validators are not accepted\");\n    50\t  if (task.hidden?.dir) {\n    51\t    try { confinedPath(dir, task.hidden.dir); }\n    52\t    catch (error) { need(false, error.message); }\n    53\t  }\n    54\t  if (task.regression?.dir) {\n    55\t    try { confinedPath(dir, task.regression.dir); }\n    56\t    catch (error) { need(false, error.message); }\n    57\t  }\n    58\t  for (const key of [\"steps\", \"minutes\"]) {\n    59\t    if (task[key] !== undefined) need(Number.isInteger(task[key]) && task[key] > 0, `${key} must be a positive integer`);\n    60\t  }\n    61\t  if (task.faults !== undefined) {\n    62\t    const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n    63\t    need(Array.isArray(task.faults) && task.faults.every((f) => kinds.includes(f?.kind) && Number.isInteger(f?.atRequest) && f.atRequest >= 1), `faults must be [{ kind: ${kinds.join(\"|\")}, atRequest: n >= 1 }]`);\n    64\t  }\n    65\t  if (task.t4RunnerFault !== undefined) {\n    66\t    need(task.tier === \"T4\" && task.t4RunnerFault === \"sigterm_resume\", \"t4RunnerFault is supported only as sigterm_resume on a T4 task\");\n    67\t  }\n    68\t  problems.push(...t4FixtureProblems(task));\n    69\t  if (task.class !== undefined || qualification) need(CLASSES.includes(task.class), `class must be one of ${CLASSES.join(\", \")}`);\n    70\t  if (task.difficulty !== undefined || qualification) need(DIFFICULTIES.includes(task.difficulty), `difficulty must be one of ${DIFFICULTIES.join(\", \")}`);\n   700\tfunction runCheck(task, ws, check, hidden, { readOnlyHidden = false } = {}) {\n   701\t  if (hidden && check.protocol === \"blackbox-v1\") {\n   702\t    return runBlackBoxOracle(task, ws, check, { resources: config.resources ?? null }).then((result) => ({\n   703\t      ...result,\n   704\t      status: result.pass ? 0 : 1,\n   705\t      output: JSON.stringify({\n   706\t        cases: result.cases,\n   707\t        failedCases: result.failedCases,\n   708\t        timeoutCases: result.timeoutCases,\n   709\t        outputLimitCases: result.outputLimitCases,\n   710\t        executionFailureCases: result.executionFailureCases,\n   711\t        invalidOutputCases: result.invalidOutputCases,\n   712\t        mismatchCases: result.mismatchCases,\n   713\t        outcome: result.outcome,\n   714\t      }),\n   715\t    }));\n   716\t  }\n   717\t  if (hidden && config.qualification === true) {\n   718\t    throw new Error(\"qualification refuses in-process legacy hidden validators; use the isolated blackbox-v1 oracle\");\n   719\t  }\n   720\t  const hiddenSubpaths = [];\n   721\t  if (hidden && check.dir) {\n   722\t    const source = confinedPath(task.dir, check.dir);\n   723\t    hiddenSubpaths.push(...stageHiddenFiles(source, ws, check.into ?? check.dir, { readOnlyHidden }));\n   724\t  }\n   725\t  const command = check.command;\n   726\t  return runIsolated(command, { cwd: ws, home: true, timeoutSec: check.timeoutSec ?? 300, outputLimit: 1_000_000, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun(), hiddenSubpaths: hidden && readOnlyHidden ? hiddenSubpaths : [], readOnlySubpaths: hidden && readOnlyHidden ? [] : hiddenSubpaths })\n   727\t    .then((r) => {\n   728\t      const output = `${r.stdout}${r.stderr}`;\n   729\t      // Qualification keeps hidden-test output out of the evidence: it would disclose the sealed tests.\n   730\t      const kept = hidden && config.qualification === true\n   731\t        ? JSON.stringify({ status: r.status, timedOut: r.timedOut, overflow: r.overflow, bytes: Buffer.byteLength(output), outputSha256: createHash(\"sha256\").update(output).digest(\"hex\") })\n   732\t        : output.slice(-20_000);\n   733\t      const vacuousHiddenPass = hidden && readOnlyHidden && !hiddenOutputHasTests(output);\n   734\t      return { pass: r.status === 0 && !r.timedOut && !r.overflow && !vacuousHiddenPass, status: r.status, timedOut: r.timedOut, overflow: r.overflow, output: kept, resources: r.resources ?? null, containmentProblem: r.containmentProblem ?? null };\n   735\t    });\n   736\t}\n   737\t\n   738\tfunction saveLogs(task, run, agent, hidden, regression) {\n   739\t  const dir = path.join(args.out, \"logs\", `${task.id}-${run}`);\n   740\t  fs.mkdirSync(dir, { recursive: true });\n13-```\n14-\n15-Each run uses a frozen copy of the task tree, a fresh workspace and `HOME`, and a unique output directory. The agent\n16-receives only its workspace, isolated home, selected read-only runtime files, and a run-scoped token for a local proxy;\n17-the real gateway credential stays in the harness process. The candidate runs in Bubblewrap user, PID and network\n18:namespaces, with nested user namespaces disabled. Legacy development tasks may still use `hidden: { dir, into, command }`;\n19-those commands execute against the candidate workspace after the agent exits and are **not safe for qualification**, because\n20:validator code can inspect or modify files in that workspace. Qualification requires `hidden: { protocol: \"blackbox-v1\",\n21-casesFile, runtime, argv, timeoutMs, totalTimeoutMs, maxOutputBytes }`. Its private JSON cases contain only `input` and\n22-`expected`; the host evaluator keeps expected values in its process and launches the candidate runtime separately for each\n23-input using a fresh top-level Bubblewrap boundary. The candidate receives one input on stdin and returns one JSON value on\n24-stdout. Its workspace is read-only; private oracle files are not mounted. Candidate output and diagnostics are discarded,\n25-and result logs contain only case counts and failed indexes. Supported runtimes are explicitly allowlisted (`node`,\n26-`python3`); the only argument is a validated relative candidate entrypoint (no runtime flags, eval expressions, or extra\n27-arguments), and per-case/aggregate time and output bounds are enforced. Oracle files must be outside the copied fixture.\n28-Absolute paths, traversal, symlinks and unsupported fixture entries are rejected. `manifest.json` records the harness source-file hashes, model fingerprint, corpus/task\n29-hashes when qualification is configured, executable version, budgets, host and Node version. Each result records the\n30-executable version and effective step/minute budget; per-run logs go to `logs/<task>-<run>/`. The runner refuses an\n31:existing output directory so a retry cannot append to or replace prior evidence.\n32-\n33-Qualification runs require `nexusExecutable` to name the absolute path of the installed RC,\n34-`expectedAgentVersion` to pin its version, and `nexusPackageSha256` to record the expected release-asset digest from checksum verification. The runner checks `nexus --version` and refuses the checkout\n35-`cli/dist/index.js` or a version mismatch before starting an agent. Peer versions are read using each adapter's\n36-`--version` command inside the same Bubblewrap filesystem/network boundary, with a cleared environment and bounded\n--\n38-digest. `score.mjs --pairs` takes exactly the Nexus,\n39-Goose and OpenCode result files and refuses mismatched model fingerprints, sampling declarations, context/output\n40-limits, explicit per-task request and aggregate requested-output ceilings, run pairs, executable identities, or\n41-effective step/minute budgets. The proxy permits only model-catalog and inference routes, strips client-supplied\n42-authorization and control-plane headers, and enforces configured request/body/output ceilings. These are requested\n43:completion-token ceilings, not exact usage accounting. It reports peer hidden-test results\n44-separately; scores are never combined. The Nexus adapter passes the recorded temperature and step/minute limits;\n45-OpenCode receives a primary evaluation agent with the recorded step limit, temperature and seed; Goose receives the\n46-matching `--max-turns`, context/output limits and temperature settings. Qualification mode currently requires\n47-`sampling.temperature` to be `0` across all three adapters; seed metadata remains recorded when configured.\n48-\n--\n53-| `id`, `tier` | T1 smoke (scripted model, CI), T2 standard, T3 long-task, T4 fault-injected |\n54-| `fixture` or `repo` | a directory in the task, or `{ \"url\", \"commit\" }` (external repositories at pinned commits) |\n55-| `setup` | shell commands run in the workspace before the agent (e.g. `npm ci`) |\n56-| `objective` | the operator text given to the agent |\n57-| `steps`, `minutes` | budgets (defaults from the configuration: 300 steps, 120 min) |\n58:| `hidden` | `{ dir, into, command, timeoutSec }` — tests the agent never sees; pass = artifact correct |\n59-| `regression` | `{ command }` — the repository's own suite after the run |\n60-\n61-## Scores\n62-\n63:completion claimed · artifact correct (hidden tests) · false VERIFIED (VERIFIED while hidden tests fail) · regressions\n64-introduced · timed out / harness errors · wall time, steps, tokens (median). Context qualifier (`contextNotRetained`) is\n65-recorded per run.\n66-\n67-## Scoring integrity\n68-\n69-- **Model proxy.** Every agent reaches the model through a per-run forwarder (`eval/model_proxy.mjs`) that `run.mjs`\n70-  starts. Each record carries `model: { requests, answered, upstreamFailures, firstRequestAt, firstAnswerAt }`. Set\n71:  `\"proxy\": false` in a config to connect agents directly; such runs are then scored only by the legacy rule below.\n72-- **Infrastructure reruns** (`eval/infra.mjs`). A run is rerun only when the model never answered *and* the endpoint\n73-  was observed failing, or when the harness itself errored. The rule is the same for every agent. A run in which the\n74-  model answered is always scored: a crash is a failure (and counts towards the crash rate), not a rerun. Records from\n75-  before the proxy fall back to each agent's own connection-failure message, and the script says how many it judged\n76-  that way.\n77-- **Contamination.** Contaminated runs (the task directory changed, or its path appeared in the agent's output) are\n78-  left out of pooled pass rates and counted separately.\n79:- **Reruns are listed.** `score.mjs` lists every replaced run with what it showed and what the rerun showed.\n80-- **Pooled metrics.** Pooled rows report crash rate, regressions, tokens per correct result and wall seconds per\n81-  correct result. The cost of failed runs counts towards these.\n82-\n83-## Fault injection (T4)\n84-\n--\n97-What was injected is recorded in `model.faultsInjected`. Such runs are never treated as infrastructure reruns.\n98-`score.mjs` reports, per fault kind:\n99-\n100-- runs;\n101-- **truthful** (the run ended with its own result, did not hang past its budget, and never claimed VERIFIED while the\n102:  hidden tests failed);\n103:- **recovered** (the hidden tests pass);\n104-- hung past budget.\n105-\n106-The remaining T4 classes come from task fixtures (a hanging test command, a full disk) and from the SIGTERM-then-resume\n107-runner case. A fixture task declares `t4Fixture: { kind, tool: \"run_command\", command, timeoutSecs }` for a hanging\n108-test, or `t4Fixture: { kind: \"full_disk\", tool: \"run_command\", command, storageLimitBytes }` for a full disk. Nexus\n--\n116-\n117-A config with `\"qualification\": true` is the v1.0.0 evidence run (docs/v1.0.0/ACCEPTANCE.md §6). `run.mjs` refuses to start\n118-one, before any agent runs, unless every item below holds:\n119-\n120-- **Tasks are well formed** (`eval/validate.mjs`): one source (fixture, or a repo pinned to a full commit id), an isolated\n121:  `blackbox-v1` hidden oracle, and `class` (bugfix · feature · refactor · debug) and `difficulty` (easy · medium · hard). Development runs check\n122-  everything except class and difficulty.\n123-- **The model is identified, not just named.** `fingerprint: { weightsSha256, serverBuild }` and\n124-  `sampling: { temperature, seed }` are set in the config, and the endpoint lists the model. The fingerprint (with the\n125-  listed owner and context) is written to `manifest.json`.\n126:- **Hidden tests are out of the agent's reach.** `runAs` names a separate evaluator user. Candidate execution occurs\n127-  inside the Bubblewrap mount namespace and does not bind the task store or validator sources; its `HOME`, `/tmp`,\n128-  `/run`, and network namespace are isolated. Runtime files are explicit read-only binds. The harness grants the\n129-  evaluator UID ACL access only to the disposable workspace, home and per-run proxy directory. Before qualification,\n130-  verify the account and these existing operating-system permissions through the approved local setup procedure:\n131-  1. `sudo useradd --system --create-home nexus-eval`\n--\n145-  descendant object, so the upstream fix that follows a held-out baseline is not reachable from the workspace. Staging\n146-  verifies this and refuses the run otherwise.\n147-\n148-- **Corpus binding is integrity evidence, not approval authentication.** The qualification config pins the exact\n149-  corpus-manifest SHA-256, and the run manifest repeats the selected task hashes. The v1 manifest binds every task's\n150:  full task tree in row `sha256`. The heldout-v2 manifest binds each task's raw `task.json` and hidden-directory digest for\n151-  pinned-repository tasks; a local fixture additionally requires a full-tree `sha256` because those two v2 digests do\n152:  not cover fixture files. The frozen config carries `corpusCustody: { custodian, approvedAt, reportPath, reportSha256 }`\n153-  and may also name `storeRoot`, `validatorPath`, `referencePath`, and `authorLogPath`; the report path and optional\n154-  private paths are protected from runtime mounts. These values and the manifest's custody labels are claims, not\n155-  signatures. Independent custody acceptance, pre-RC commit timing, and configuration freeze must be verified and\n156-  archived by the acceptance reviewer before any qualification run. The current candidate task package has not been\n157-  independently accepted.\n158-\n159-### Isolation limits\n160-\n161-Bubblewrap plus the current runner enforces separate mount/user/PID/network namespaces, a cleared task-command\n162-environment, a bounded wall clock, bounded captured output, per-run process-group teardown, and read-only runtime\n163:binds. Black-box qualification keeps oracle expectations outside candidate namespaces. Legacy hidden commands share a\n164:process with candidate code and are rejected during qualification preflight. The hardened legacy path below is only for\n165-development and pilot scoring; it is not qualification evidence. Aggregate CPU, memory, process-count and\n166-writable-storage limits come from the resource contract below, not from request/token ceilings. Appliance-specific\n167-Bubblewrap enforcement is a separate, unverified condition.\n168-\n169:### Hardened legacy hidden tests (development and pilot only)\n170-\n171:Legacy tasks use `hidden: { dir, command }` (for example `pytest` or `go test` over copied test files) and run candidate\n172-code in the same process as the oracle. They do not meet the qualification boundary, even when hardened. Qualification\n173:preflight accepts only the isolated `blackbox-v1` protocol. Any legacy task in a qualification corpus must be replaced\n174:or converted by the authorized custodian, with custody checks repeated and a new immutable manifest identity recorded.\n175-Development configs may opt into the hardened diagnostic path with `\"hardenedChecks\": true`.\n176-\n177-1. The agent's workspace is never tested, and nothing runs git or any other program against it after the agent ran.\n178-   An agent-written `.git/config` or `.gitattributes` would otherwise run commands as the harness user. The baseline\n179-   tree hash is taken before the agent starts. The harness then stages the task again (the same pinned commit or\n--\n206-     - `package.json`: anything but the dependency maps and metadata, or a `file:`/`git:`/path dependency;\n207-     - `pyproject.toml`: anything outside `[project]`;\n208-     - `Cargo.toml`: anything outside `[dependencies]`/`[dependencies.<name>]`, or a `path`, `git` or `registry`\n209-       source. Adding `[dev-dependencies]` or `[build-dependencies]` is refused, which costs legitimate test-only\n210-       dependency additions;\n211:     - `go.mod`: anything outside its `require` lines and blocks, including entries inside an existing `replace (…)`.\n212:3. Anything the agent left at the oracle's path is removed. The hidden command then runs with the hidden directory\n213-   bind-mounted **read-only**. The regression\n214-   command runs in a separate byte-identical copy, so candidate code executed by one check cannot prepare the other.\n215:4. In development/pilot runs, hidden-test output is kept only as a status, byte count and SHA-256, so diagnostic\n216-   records do not disclose the tests. Each run record carries\n217-   `hardened: { baseline, applied, discarded, configChanges }`.\n218-\n219:This legacy hardening path supports development and pilot scoring only. Candidate source still executes in the same\n220:runtime as its legacy validator, so it can inspect or alter validator state; file hiding and a fresh workspace do not\n221:provide independent qualification. `qualification: true` rejects every legacy hidden command before any candidate\n222:starts. Do not relabel legacy evidence as qualification evidence.\n223-\n224:The legacy output checks below are diagnostic safeguards for development scoring, not acceptance evidence. Qualification\n225-keeps black-box expected values in the evaluator process and runs candidate code in a separate Bubblewrap process.\n226-- Fairness cost: a real source directory named `vendor/` or `target/` is skipped like a dependency tree, so the\n227-  agent's changes there are dropped. The `npm:` alias form of a dependency spec is not refused; setup is not re-run\n228-  after the copy, so it cannot install anything.\n229-\n230-The sealed corpus is bound through its own manifest schema (`eval/heldout-manifest.json`, `hash_scheme`). The runner\n231:recomputes each selected task's `task_sha256` (raw `task.json`) and `hidden_sha256`. The latter is computed over the\n232:regular files of `hidden.dir`, with `/`-separated relative paths sorted byte-wise, each line `<path>  <sha256>\\n`. For\n233:pinned-repository tasks these bind the task declaration and hidden tests while the repository commit pins the source.\n234-A task using a local `fixture` must also carry `sha256` for the full task tree; without it, fixture content outside\n235:`task.json` and `hidden.dir` would be unbound. The selected population must equal the manifest's. The manifest carries\n236:no custody fields, so the frozen config states `corpusCustody: { custodian, approvedAt, reportPath, reportSha256 }`;\n237-optional private paths are `storeRoot`, `validatorPath`, `referencePath`, and `authorLogPath`. The acceptance reviewer\n238-checks the report against its digest and verifies custody claims independently.\n239-\n240-### Resource contract\n241-\n242-A config's `resources` object — `{ \"cpuPercent\", \"memoryBytes\", \"tasks\", \"storageBytes\", \"workspaceRoot\" }` — applies to every\n243:task-controlled execution: setup commands, the candidate agent, legacy hidden and regression commands, every black-box\n244-oracle case and the agent version probe. Qualification refuses to start without it.\n245-\n246-- Each execution runs under `eval/cgroup_supervisor.mjs` as the only process of its own delegated transient\n247-  `systemd-run --user --scope`. The supervisor writes cgroup v2 `cpu.max` (`cpuPercent`% of one CPU), `memory.max`\n248-  (`memoryBytes`), `memory.swap.max` (0), `memory.oom.group` (1) and `pids.max` (`tasks`) on a `payload` leaf, reads them back, and refuses to\n--\n258-  `ENOSPC`. Runs are serial and each workspace is removed afterwards; `--keep` is refused under the contract.\n259-- Within that cap, tmpfs pages, including the sandbox's own `/tmp`, are charged to the writing phase's memory cgroup and\n260-  cannot be swapped. A phase therefore also cannot hold more than `memoryBytes` of memory and new writes together. When\n261-  it reaches that bound the whole phase is OOM-killed (`memory.oom.group`), and this is recorded. When a phase's cgroup\n262-  is removed, the kernel moves its charges to the unlimited parent cgroup. Later phases get their own `memoryBytes`,\n263:  which is why the filesystem cap, not the memory limit, is the cross-phase storage bound. An OOM in a hidden or\n264-  regression check is the candidate's outcome, a failed check, not an infrastructure error.\n265-- CPU is bounded in rate by `cpu.max` and in total by the phase's wall-clock timeout.\n266-- This contract is supported only on Linux with cgroup v2 CPU, memory and pids controllers, a delegated systemd user\n267-  manager, Bubblewrap and the dedicated tmpfs described above. Missing controllers, mount metadata, user-manager\n268-  delegation or any read-back mismatch fail preflight. Other operating systems and container hosts that cannot expose\n--\n270-- After the command exits or times out, the supervisor records the remaining processes, empties the cgroup with\n271-  `cgroup.kill` (which reaches daemonized processes and other uids), and waits for `populated 0`. A timeout or output\n272-  overflow empties the payload leaf, repeatedly until the supervisor exits, so a stop that arrives before the command\n273-  has joined the leaf is not lost. It also sends the supervisor `SIGTERM` so that it can still report. If the supervisor\n274-  does not exit within 10 s it is killed, and the run fails for lack of a report.\n275:- Each run record carries `resources.{agent,hidden,regression}`: the applied limits, `memoryPeakBytes`, `oomKills`,\n276-  `memoryMaxEvents`, `pidsPeak`, `pidsMaxEvents`, `cpuUsageUsec`, `cpuThrottledUsec`, `survivorsAfterExit` and\n277-  `cleaned`. A missing report, a failed limit read-back or `cleaned: false` makes the run an error. It is never scored\n278-  as a pass or fail.\n279-- Preflight runs a contained probe and refuses qualification unless this host applies and cleans up the contract. CI\n280-  provisions delegation with `scripts/ensure-ci-user-cgroups.sh`, and the fixture tests in\n--\n290-connection closed; that behavior requires runtime-specific evidence. The total request limit remains a separate cap.\n291-\n292-## Pre-registered thresholds (from the assessment, fixed before any live run)\n293-\n294-- false VERIFIED = 0 across all runs;\n295:- T2 hidden-test pass rate (pooled over all T2 runs of a configuration, point estimate, 95 % intervals reported) ≥ the\n296-  best matched peer on the same local model **minus 10 percentage points**; and no task where that peer passes ≥ 4/5\n297-  runs while Nexus passes ≤ 1/5. (Fixed 2026-10-13, before the first scored run. Rationale: at ~50 runs per\n298-  configuration the 95 % interval half-width near 50 % is ~13 points, so a tighter margin is not distinguishable from\n299-  noise and a looser one would accept a clear loss; the per-task guard stops a pooled rate hiding a task class Nexus\n300-  cannot do.) The 6-task pilot is directional only; qualification needs the full task set;\n--\n317-\n318-## Pilot 2026-10-13 (4 h appliance window)\n319-\n320-Configurations `configs/pilot-*.json`: Nexus, Aider 0.86.2, OpenCode 1.18.35, Goose 1.27.2, all on\n321-`engineering/lead` (Qwen3.6-35B-A3B Q4_K_M, llama.cpp b11347) through the appliance gateway, 64k context. Six T2\n322:fixture tasks (`t2-*`; each hidden test checked to fail on the fixture and pass on a reference fix kept outside the\n323-repo). Budgets 60 steps / 20 min per task (Nexus steps; others by wall clock). The four agents run concurrently on the\n324-same worker, so wall times include queueing.\n325-\n326-Deviations from §9, recorded before the run: fixture tasks rather than external repositories at pinned commits; T2\n327-only (no T3/T4 — the window is too short); Codex CLI excluded (the gateway does not serve `/v1/responses`); Aider runs\n21-| [DEC-13](#dec-13-contest-track-disposition) | Contest track | Submission completed and judging ended; no contest freeze applies, PLAN-C1 continues as post-contest hardening | No |\n22-| [DEC-14](#dec-14-free-text-on-the-command-line) | Free text on the command line | Explicit `nexus run` required | No |\n23-| [DEC-15](#dec-15-knowledge-auto-extraction) | Knowledge auto-extraction | Off by default, opt-in | No |\n24:| [DEC-16](#dec-16-standalone-qualification-under-a-gateway-only-environment) | Standalone qualification with no direct worker access | Stripping proxy over the gateway for live runs, plus server-kind conformance fixtures | No |\n25-| [DEC-17](#dec-17-token-estimator-floor-versus-the-calibration-band) | Token-estimator floor vs the ACC-VER-07 calibration band | The REQ-AGT-118 ≥ 1 token/char floor takes precedence for merging scripts; the resulting over-estimate is an accepted, bounded bias | No |\n26-\n27----\n--\n59-\n60-## DEC-03: Team and operation scope in v1\n61-\n62:**Options.** (A) Fully supported. **(B, chosen)** Shipped and labelled **experimental** in help and docs. Excluded from the qualification task-quality claims. But the following are still fixed for v1:\n63-- **AGT-02a** (compaction originals lost on resume): BLOCKER, because it silently loses durable state behind a documented guarantee.\n64-- **AGT-02b–d and AGT-11**: RELEASE-REQUIRED.\n65-\n--\n107-| T3 steering honoured | ≥ 95% |\n108-| `run`-mode operator interventions | 0 |\n109-\n110:**Task authorship.** The owner authorized agent authorship for the T2 tasks on 2026-10-14. A separately-run agent session authors the held-out tasks. It is given only the task schema and the external repositories, with no access to Nexus source, the development set, or tuning history. Its sha256 manifest is committed before the RC freeze. The qualification report must state that the authors were agents, not humans.\n111-\n112-**Inference environment.** All runs go through the homelab-ai gateway, which is the only inference path (owner, 2026-10-14). There is no direct worker access and no extra GPU. Every run, Nexus and peers alike, is serial on one gateway-backed model. Wall time is the critical-path cost (PLAN-10). Live cloud connections (ChatGPT sign-in, OpenRouter) may be used for small-spend checks, but are not used for matched comparisons. One reason: `openrouter/free` routed 3 requests to 3 different models in the 2026-10-14 verify run, which breaks model matching.\n113-\n--\n125-\n126-## DEC-07: Experimental surfaces (`nexus eval`, `/tdd`, team roles)\n127-\n128:- **`nexus eval`.** Labelled experimental. Its scoring is not fixed in v1, but its unsafe `git checkout` in the operator's workspace **is** fixed: it must run in a worktree (VER-07a). It is excluded from all claims. The SPEC-10 harness (`eval/`) is the qualification tool.\n129-- **`/tdd` / `--tdd`.** Labelled experimental. Fixing the phase enforcement is post-v1.\n130-- **Team roles.** Reviewer and researcher units run with a **read-only tool set** (cheap and safety-relevant). Other role allowlists are post-v1.\n131-\n--\n168-- The contest is a separate track (SPEC-C1). It never gates the client.\n169-- **Historical freeze (ended):** while judging was open, the submitted material (contest docs, `experiments/cloudflare-artifacts-vertical-slice/`, `demo/`, contest CI job) was not changed because post-deadline edits could have been read as amending the entry. The audit findings CON-001 to CON-014 were recorded during that period.\n170-- After judging concluded, PLAN-C1 proceeded as **post-contest hardening**. Its first task is the CON-001 correction, with a dated \"post-submission correction\" note in CONTEST.md.\n171:- During that historical freeze, one exception was considered: if contest rules permitted errata, an erratum could state that the documented deploy builds the legacy Experiment-1 Worker and reproduction is operator-host only. That restriction ended with judging; it does not limit current maintenance.\n172-- Client work that touched `demo/lib/real-agent-runner.mjs` (PLAN-01 task 8, `--yes`) was deferred while judging was open. That deferral has ended; update the demo alongside the client where needed. The runner may continue to pass `NEXUS_APPROVAL_MODE=auto` when required by the current CLI contract.\n173-\n174:**Tradeoff:** judges who follow the documented deploy may deploy the legacy Worker. That Worker deploys into their own account, so the exposure is confined to their own test deployment.\n175-\n176-**Status amendment (2026-10-21):** The contest has concluded. The release coordinator confirmed that no contest freeze applies. The historical freeze above is no longer a restriction; PLAN-C1 and other contest-related maintenance may proceed through normal claims, review, and validation. Preserve submitted tags, run records, and manifests as historical evidence, and do not represent changed current sources as the original submission. The retired `cloudflare-contest-contract` check remains retired and must not be reintroduced as a release gate.\n177-\n--\n185-\n186----\n187-\n188:## DEC-16: Standalone qualification under a gateway-only environment\n189-\n190-**Constraint (owner, 2026-10-14):** there is no separately accessible worker and no extra GPU. Gateway access to the workers must be sufficient, and direct workload requests to workers are not allowed.\n191-\n--\n234-\n235-This amendment is **narrow by design**. It applies only to corpora where the measured estimator is floor-bound — currently exactly the two in the table above — and it **does not silently exempt any other corpus**: any corpus whose estimator lands between the floor and the band must be examined and recorded (`tokens.test.ts` pins the floor-bound set to these two names and the full 14-corpus set, so neither an added exemption nor a silent corpus deletion can pass the test). The original accuracy failures are **preserved** — in the table above, in the fixture's `floorBound` entries, and in the base ledger wording (git history at `e1759ca`; the live row now records the amendment and stays `partial` until the changed tests pass and the amendment is independently accepted) — as recorded, failed accuracy evidence. They are not deleted or rewritten into passes.\n236-\n237:**Rejected alternatives.** (A) Lower the floor to satisfy the band — rejected: reintroduces under-estimation and the context-overflow class REQ-AGT-118 exists to prevent. (B) Drop the CJK/Hangul corpora from the fixture — rejected: removes the evidence. (C) Change the pinned tokenizer — out of scope; the fixture pins the qualification worker.\n238-\n239-**Affected:** REQ-AGT-118; SPEC-11 §2.7 and ACC-VER-07; REQUIREMENTS ledger row REQ-AGT-118; `cli/test/fixtures/token_calibration.json` and `cli/test/tokens.test.ts`. No change to `cli/src/tokens.ts` behaviour.\n240-\n","exit_code":0,"duration":{"secs":0,"nanos":39265}},"started_at_ms":1793226219959,"completed_at_ms":1793226219959}}
{"timestamp":"2026-10-28T22:23:42.268Z","ordinal":467652,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1849c-aabc-7521-a3e9-449687e32fa1","call_id":"call_6076361781b94b288a7e0c0e667c5262","output":[{"type":"input_text","text":"Script completed\nWall time 3.8 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 7988)\nTotal output lines: 362\n\n    35\t      const repoUrl = new URL(task.repo.url);\n    36\t      need(repoUrl.protocol === \"https:\" && !repoUrl.username && !repoUrl.password, \"repo.url must use HTTPS without embedded credentials\");\n    37\t    } catch { need(false, \"repo.url must be a valid HTTPS URL without embedded credentials\"); }\n    38\t    need(/^[0-9a-f]{40}$/.test(task.repo.commit ?? \"\"), \"repo.commit must be a full 40-character commit id (pinned)\");\n    39\t  }\n    40\t  const hiddenCommand = typeof task.hidden?.command === \"string\" && task.hidden.command.length > 0;\n    41\t  const hiddenOracle = task.hidden?.protocol === \"blackbox-v1\";\n    42\t  need(hiddenCommand || hiddenOracle, \"hidden.command or hidden blackbox-v1 oracle is required\");\n    43\t  if (hiddenOracle) {\n    44\t    const oracleProblem = blackBoxOracleProblem(task.hidden, dir, task.fixture ?? null);\n    45\t    need(!oracleProblem, oracleProblem ?? \"hidden black-box oracle is invalid\");\n    46\t  }\n    47\t  // Legacy validators execute candidate modules in the same runtime. File hiding and a fresh workspace cannot prevent\n    48\t  // candidate code from inspecting or mutating that runtime, so they are never valid independent qualification.\n    49\t  if (qualification) need(hiddenOracle && !hiddenCommand, \"qualification requires the isolated blackbox-v1 hidden oracle; in-process legacy validators are not accepted\");\n    50\t  if (task.hidden?.dir) {\n    51\t    try { confinedPath(dir, task.hidden.dir); }\n    52\t    catch (error) { need(false, error.message); }\n    53\t  }\n    54\t  if (task.regression?.dir) {\n    55\t    try { confinedPath(dir, task.regression.dir); }\n    56\t    catch (error) { need(false, error.message); }\n    57\t  }\n    58\t  for (const key of [\"steps\", \"minutes\"]) {\n    59\t    if (task[key] !== undefined) need(Number.isInteger(task[key]) && task[key] > 0, `${key} must be a positive integer`);\n    60\t  }\n    61\t  if (task.faults !== undefined) {\n    62\t    const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n    63\t    need(Array.isArray(task.faults) && task.faults.every((f) => kinds.includes(f?.kind) && Number.isInteger(f?.atRequest) && f.atRequest >= 1), `faults must be [{ kind: ${kinds.join(\"|\")}, atRequest: n >= 1 }]`);\n    64\t  }\n    65\t  if (task.t4RunnerFault !== undefined) {\n    66\t    need(task.tier === \"T4\" && task.t4RunnerFault === \"sigterm_resume\", \"t4RunnerFault is supported only as sigterm_resume on a T4 task\");\n    67\t  }\n    68\t  problems.push(...t4FixtureProblems(task));\n    69\t  if (task.class !== undefined || qualification) need(CLASSES.includes(task.class), `class must be one of ${CLASSES.join(\", \")}`);\n    70\t  if (task.difficulty !== undefined || qualification) need(DIFFICULTIES.includes(task.difficulty), `difficulty must be one of ${DIFFICULTIES.join(\", \")}`);\n   700\tfunction runCheck(task, ws, check, hidden, { readOnlyHidden = false } = {}) {\n   701\t  if (hidden && check.protocol === \"blackbox-v1\") {\n   702\t    return runBlackBoxOracle(task, ws, check, { resources: config.resources ?? null }).then((result) => ({\n   703\t      ...result,\n   704\t      status: result.pass ? 0 : 1,\n   705\t      output: JSON.stringify({\n   706\t        cases: result.cases,\n   707\t        failedCases: result.failedCases,\n   708\t        timeoutCases: result.timeoutCases,\n   709\t        outputLimitCases: result.outputLimitCases,\n   710\t        executionFailureCases: result.executionFailureCases,\n   711\t        invalidOutputCases: result.invalidOutputCases,\n   712\t        mismatchCases: result.mismatchCases,\n   713\t        outcome: result.outcome,\n   714\t      }),\n   715\t    }));\n   716\t  }\n   717\t  if (hidden && config.qualification === true) {\n   718\t    throw new Error(\"qualification refuses in-process legacy hidden validators; use the isolated blackbox-v1 oracle\");\n   719\t  }\n   720\t  const hiddenSubpaths = [];\n   721\t  if (hidden && check.dir) {\n   722\t    const source = confinedPath(task.dir, check.dir);\n   723\t    hiddenSubpaths.push(...stageHiddenFiles(source, ws, check.into ?? check.dir, { readOnlyHidden }));\n   724\t  }\n   725\t  const command = check.command;\n   726\t  return runIsolated(command, { cwd: ws, home: true, timeoutSec: check.timeoutSec ?? 300, outputLimit: 1_000_000, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun(), hiddenSubpaths: hidden && readOnlyHidden ? hiddenSubpaths : [], readOnlySubpaths: hidden && readOnlyHidden ? [] : hiddenSubpaths })\n   727\t    .then((r) => {\n   728\t      const output = `${r.stdout}${r.stderr}`;\n   729\t      // Qualification keeps hidden-test output out of the evidence: it would disclose the sealed tests.\n   730\t      const kept = hidden && config.qualification === true\n   731\t        ? JSON.stringify({ status: r.status, timedOut: r.timedOut, overflow: r.overflow, bytes: Buffer.byteLength(output), outputSha256: createHash(\"sha256\").update(output).digest(\"hex\") })\n   732\t        : output.slice(-20_000);\n   733\t      const vacuousHiddenPass = hidden && readOnlyHidden && !hiddenOutputHasTests(output);\n   734\t      return { pass: r.status === 0 && !r.timedOut && !r.overflow && !vacuousHiddenPass, status: r.status, timedOut: r.timedOut, overflow: r.overflow, output: kept, resources: r.resources ?? null, containmentProblem: r.containmentProblem ?? null };\n   735\t    });\n   736\t}\n   737\t\n   738\tfunction saveLogs(task, run, agent, hidden, regression) {\n   739\t  const dir = path.join(args.out, \"logs\", `${task.id}-${run}`);\n   740\t  fs.mkdirSync(dir, { recursive: true });\n13-```\n14-\n15-Each run uses a frozen copy of the task tree, a fresh workspace and `HOME`, and a unique output directory. The agent\n16-receives only its workspace, isolated home, selected read-only runtime files, and a run-scoped token for a local proxy;\n17-the real gateway credential stays in the harness process. The candidate runs in Bubblewrap user, PID and network\n18:namespaces, with nested user namespaces disabled. Legacy development tasks may still use `hidden: { dir, into, command }`;\n19-those commands execute against the candidate workspace after the agent exits and are **not safe for qualification**, because\n20:validator code can inspect or modify files in that workspace. Qualification requires `hidden: { protocol: \"blackbox-v1\",\n21-casesFile, runtime, argv, timeoutMs, totalTimeoutMs, maxOutputBytes }`. Its private JSON cases contain only `input` and\n22-`expected`; the host evaluator keeps expected values in its process and launches the candidate runtime separately for each\n23-input using a fresh top-level Bubblewrap boundary. The candidate receives one input on stdin and returns one JSON value on\n24-stdout. Its workspace is read-only; private oracle files are not mounted. Candidate output and diagnostics are discarded,\n25-and result logs contain only case counts and failed indexes. Supported runtimes are explicitly allowlisted (`node`,\n26-`python3`); the only argument is a validated relative candidate entrypoint (no runtime flags, eval expressions, or extra\n27-arguments), and per-case/aggregate time and output bounds are enforced. Oracle files must be outside the copied fixture.\n28-Absolute paths, traversal, symlinks and unsupported fixture entries are rejected. `manifest.json` records the harness source-file hashes, model fingerprint, corpus/task\n29-hashes when qualification is configured, executable version, budgets, host and Node version. Each result records the\n30-executable version and effective step/minute budget; per-run logs go to `logs/<task>-<run>/`. The runner refuses an\n31:existing output directory so a retry cannot append to or replace prior evidence.\n32-\n33-Qualification runs require `nexusExecutable` to name the absolute path of the installed RC,\n34-`expectedAgentVersion` to pin its version, and `nexusPackageSha256` to record the expected release-asset digest from checksum verification. The runner checks `nexus --version` and refuses the checkout\n35-`cli/dist/index.js` or a version mismatch before starting an agent. Peer versions are read using each adapter's\n36-`--version` command inside the same Bubblewrap filesystem/network boundary, with a cleared environment and bounded\n--\n38-digest. `score.mjs --pairs` takes exactly the Nexus,\n39-Goose and OpenCode result files and refuses mismatched model fingerprints, sampling declarations, context/output\n40-limits, explicit per-task request and aggregate requested-output ceilings, run pairs, executable identities, or\n41-effective step/minute budgets. The proxy permits only model-catalog and inference routes, strips client-supplied\n42-authorization and control-plane headers, and enforces configured request/body/output ceilings. These are requested\n43:completion-token ceilings, not exact usage accounting. It reports peer hidden-test results\n44-separately; scores are never combined. The Nexus adapter passes the recorded temperature and step/minute limits;\n45-OpenCode receives a primary evaluation agent with the recorded step…3488 tokens truncated…urvivorsAfterExit` and\n277-  `cleaned`. A missing report, a failed limit read-back or `cleaned: false` makes the run an error. It is never scored\n278-  as a pass or fail.\n279-- Preflight runs a contained probe and refuses qualification unless this host applies and cleans up the contract. CI\n280-  provisions delegation with `scripts/ensure-ci-user-cgroups.sh`, and the fixture tests in\n--\n290-connection closed; that behavior requires runtime-specific evidence. The total request limit remains a separate cap.\n291-\n292-## Pre-registered thresholds (from the assessment, fixed before any live run)\n293-\n294-- false VERIFIED = 0 across all runs;\n295:- T2 hidden-test pass rate (pooled over all T2 runs of a configuration, point estimate, 95 % intervals reported) ≥ the\n296-  best matched peer on the same local model **minus 10 percentage points**; and no task where that peer passes ≥ 4/5\n297-  runs while Nexus passes ≤ 1/5. (Fixed 2026-10-13, before the first scored run. Rationale: at ~50 runs per\n298-  configuration the 95 % interval half-width near 50 % is ~13 points, so a tighter margin is not distinguishable from\n299-  noise and a looser one would accept a clear loss; the per-task guard stops a pooled rate hiding a task class Nexus\n300-  cannot do.) The 6-task pilot is directional only; qualification needs the full task set;\n--\n317-\n318-## Pilot 2026-10-13 (4 h appliance window)\n319-\n320-Configurations `configs/pilot-*.json`: Nexus, Aider 0.86.2, OpenCode 1.18.35, Goose 1.27.2, all on\n321-`engineering/lead` (Qwen3.6-35B-A3B Q4_K_M, llama.cpp b11347) through the appliance gateway, 64k context. Six T2\n322:fixture tasks (`t2-*`; each hidden test checked to fail on the fixture and pass on a reference fix kept outside the\n323-repo). Budgets 60 steps / 20 min per task (Nexus steps; others by wall clock). The four agents run concurrently on the\n324-same worker, so wall times include queueing.\n325-\n326-Deviations from §9, recorded before the run: fixture tasks rather than external repositories at pinned commits; T2\n327-only (no T3/T4 — the window is too short); Codex CLI excluded (the gateway does not serve `/v1/responses`); Aider runs\n21-| [DEC-13](#dec-13-contest-track-disposition) | Contest track | Submission completed and judging ended; no contest freeze applies, PLAN-C1 continues as post-contest hardening | No |\n22-| [DEC-14](#dec-14-free-text-on-the-command-line) | Free text on the command line | Explicit `nexus run` required | No |\n23-| [DEC-15](#dec-15-knowledge-auto-extraction) | Knowledge auto-extraction | Off by default, opt-in | No |\n24:| [DEC-16](#dec-16-standalone-qualification-under-a-gateway-only-environment) | Standalone qualification with no direct worker access | Stripping proxy over the gateway for live runs, plus server-kind conformance fixtures | No |\n25-| [DEC-17](#dec-17-token-estimator-floor-versus-the-calibration-band) | Token-estimator floor vs the ACC-VER-07 calibration band | The REQ-AGT-118 ≥ 1 token/char floor takes precedence for merging scripts; the resulting over-estimate is an accepted, bounded bias | No |\n26-\n27----\n--\n59-\n60-## DEC-03: Team and operation scope in v1\n61-\n62:**Options.** (A) Fully supported. **(B, chosen)** Shipped and labelled **experimental** in help and docs. Excluded from the qualification task-quality claims. But the following are still fixed for v1:\n63-- **AGT-02a** (compaction originals lost on resume): BLOCKER, because it silently loses durable state behind a documented guarantee.\n64-- **AGT-02b–d and AGT-11**: RELEASE-REQUIRED.\n65-\n--\n107-| T3 steering honoured | ≥ 95% |\n108-| `run`-mode operator interventions | 0 |\n109-\n110:**Task authorship.** The owner authorized agent authorship for the T2 tasks on 2026-10-14. A separately-run agent session authors the held-out tasks. It is given only the task schema and the external repositories, with no access to Nexus source, the development set, or tuning history. Its sha256 manifest is committed before the RC freeze. The qualification report must state that the authors were agents, not humans.\n111-\n112-**Inference environment.** All runs go through the homelab-ai gateway, which is the only inference path (owner, 2026-10-14). There is no direct worker access and no extra GPU. Every run, Nexus and peers alike, is serial on one gateway-backed model. Wall time is the critical-path cost (PLAN-10). Live cloud connections (ChatGPT sign-in, OpenRouter) may be used for small-spend checks, but are not used for matched comparisons. One reason: `openrouter/free` routed 3 requests to 3 different models in the 2026-10-14 verify run, which breaks model matching.\n113-\n--\n125-\n126-## DEC-07: Experimental surfaces (`nexus eval`, `/tdd`, team roles)\n127-\n128:- **`nexus eval`.** Labelled experimental. Its scoring is not fixed in v1, but its unsafe `git checkout` in the operator's workspace **is** fixed: it must run in a worktree (VER-07a). It is excluded from all claims. The SPEC-10 harness (`eval/`) is the qualification tool.\n129-- **`/tdd` / `--tdd`.** Labelled experimental. Fixing the phase enforcement is post-v1.\n130-- **Team roles.** Reviewer and researcher units run with a **read-only tool set** (cheap and safety-relevant). Other role allowlists are post-v1.\n131-\n--\n168-- The contest is a separate track (SPEC-C1). It never gates the client.\n169-- **Historical freeze (ended):** while judging was open, the submitted material (contest docs, `experiments/cloudflare-artifacts-vertical-slice/`, `demo/`, contest CI job) was not changed because post-deadline edits could have been read as amending the entry. The audit findings CON-001 to CON-014 were recorded during that period.\n170-- After judging concluded, PLAN-C1 proceeded as **post-contest hardening**. Its first task is the CON-001 correction, with a dated \"post-submission correction\" note in CONTEST.md.\n171:- During that historical freeze, one exception was considered: if contest rules permitted errata, an erratum could state that the documented deploy builds the legacy Experiment-1 Worker and reproduction is operator-host only. That restriction ended with judging; it does not limit current maintenance.\n172-- Client work that touched `demo/lib/real-agent-runner.mjs` (PLAN-01 task 8, `--yes`) was deferred while judging was open. That deferral has ended; update the demo alongside the client where needed. The runner may continue to pass `NEXUS_APPROVAL_MODE=auto` when required by the current CLI contract.\n173-\n174:**Tradeoff:** judges who follow the documented deploy may deploy the legacy Worker. That Worker deploys into their own account, so the exposure is confined to their own test deployment.\n175-\n176-**Status amendment (2026-10-21):** The contest has concluded. The release coordinator confirmed that no contest freeze applies. The historical freeze above is no longer a restriction; PLAN-C1 and other contest-related maintenance may proceed through normal claims, review, and validation. Preserve submitted tags, run records, and manifests as historical evidence, and do not represent changed current sources as the original submission. The retired `cloudflare-contest-contract` check remains retired and must not be reintroduced as a release gate.\n177-\n--\n185-\n186----\n187-\n188:## DEC-16: Standalone qualification under a gateway-only environment\n189-\n190-**Constraint (owner, 2026-10-14):** there is no separately accessible worker and no extra GPU. Gateway access to the workers must be sufficient, and direct workload requests to workers are not allowed.\n191-\n--\n234-\n235-This amendment is **narrow by design**. It applies only to corpora where the measured estimator is floor-bound — currently exactly the two in the table above — and it **does not silently exempt any other corpus**: any corpus whose estimator lands between the floor and the band must be examined and recorded (`tokens.test.ts` pins the floor-bound set to these two names and the full 14-corpus set, so neither an added exemption nor a silent corpus deletion can pass the test). The original accuracy failures are **preserved** — in the table above, in the fixture's `floorBound` entries, and in the base ledger wording (git history at `e1759ca`; the live row now records the amendment and stays `partial` until the changed tests pass and the amendment is independently accepted) — as recorded, failed accuracy evidence. They are not deleted or rewritten into passes.\n236-\n237:**Rejected alternatives.** (A) Lower the floor to satisfy the band — rejected: reintroduces under-estimation and the context-overflow class REQ-AGT-118 exists to prevent. (B) Drop the CJK/Hangul corpora from the fixture — rejected: removes the evidence. (C) Change the pinned tokenizer — out of scope; the fixture pins the qualification worker.\n238-\n239-**Affected:** REQ-AGT-118; SPEC-11 §2.7 and ACC-VER-07; REQUIREMENTS ledger row REQ-AGT-118; `cli/test/fixtures/token_calibration.json` and `cli/test/tokens.test.ts`. No change to `cli/src/tokens.ts` behaviour.\n240-\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1849a-b358-70f3-86ea-b2ec73ad98ca","create_time":1793226222.2685146}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
