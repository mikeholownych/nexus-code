usy sends steering, not a second prompt).\n     snapshot_a = s.screen.text()\n     s.send(\"keep line 1 unchanged\\r\", settle=0.1)\n-    s.pump(0.6)\n+    # The status timer updates once per second; wait past its first tick before asserting 0:01 is visible.\n+    s.pump(1.2)\n     snapshot_b = s.screen.text()\n     s.pump(0.3)\n     busy_cpu = (cpu_seconds(s.pid) - cpu0) / (time.monotonic() - t0)\ndiff --git a/cli/test/operation_view.test.ts b/cli/test/operation_view.test.ts\nindex 70cc0029..3c4ee74e 100644\n--- a/cli/test/operation_view.test.ts\n+++ b/cli/test/operation_view.test.ts\n@@ -398,6 +398,12 @@ function runCli(args: string[], fixture: CliFixture): { status: number; stdout:\n   }\n }\n \n+function assertNoUnsafeTerminalControls(output: string): void {\n+  // CLI styling is expected; only discard the known SGR styling form before checking for controls from input data.\n+  const withoutSgr = output.replace(/\\x1b\\[[0-9;]*m/g, \"\");\n+  assert.doesNotMatch(withoutSgr, /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/);\n+}\n+\n function saveFixture(fixture: CliFixture, id: string): string {\n   const op = state();\n   op.id = id;\n@@ -517,7 +523,7 @@ test(\"ordinary status sanitizes blocked decision identifiers\", (t) => {\n \n   const result = runCli([\"operation\", \"status\", \"op-cli-decision\"], fixture);\n   assert.equal(result.status, 0);\n-  assert.doesNotMatch(result.stdout + result.stderr, /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/);\n+  assertNoUnsafeTerminalControls(result.stdout + result.stderr);\n });\n \n test(\"rejected decisions sanitize the failing decision id\", (t) => {\n@@ -527,7 +533,7 @@ test(\"rejected decisions sanitize the failing decision id\", (t) => {\n \n   const result = runCli([\"operation\", \"decide\", \"op-cli-reject\", \"decision\\u001b[2J\", \"1\"], fixture);\n   assert.equal(result.status, 2);\n-  assert.doesNotMatch(result.stdout + result.stderr, /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/);\n+  assertNoUnsafeTerminalControls(result.stdout + result.stderr);\n });\n \n test(\"run sanitizes an operation id in its resume banner\", (t) => {\n@@ -538,7 +544,7 @@ test(\"run sanitizes an operation id in its resume banner\", (t) => {\n \n   const result = runCli([\"operation\", \"run\", spec], fixture);\n   assert.notEqual(result.status, 0);\n-  assert.doesNotMatch(result.stdout + result.stderr, /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/);\n+  assertNoUnsafeTerminalControls(result.stdout + result.stderr);\n });\n \n test(\"status and watch sanitize invalid operation identifiers and event arguments\", (t) => {\n@@ -552,7 +558,7 @@ test(\"status and watch sanitize invalid operation identifiers and event argument\n   ]) {\n     const result = runCli(args, fixture);\n     assert.notEqual(result.status, 0);\n-    assert.doesNotMatch(result.stdout + result.stderr, /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/);\n+    assertNoUnsafeTerminalControls(result.stdout + result.stderr);\n   }\n });\n \n@@ -568,7 +574,7 @@ test(\"run sanitizes resource and spec validation errors\", (t) => {\n     fs.writeFileSync(spec, JSON.stringify(value));\n     const result = runCli([\"operation\", \"run\", spec], fixture);\n     assert.notEqual(result.status, 0);\n-    assert.doesNotMatch(result.stdout + result.stderr, /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/);\n+    assertNoUnsafeTerminalControls(result.stdout + result.stderr);\n   }\n });\n \n","exit_code":0,"duration":{"secs":0,"nanos":27954}},"started_at_ms":1793228666510,"completed_at_ms":1793228666510}}
