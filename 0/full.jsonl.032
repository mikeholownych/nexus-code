filea.txt\");\n   206\t    const manager = new CheckpointManager(repo);\n   207\t    const checkpoint = manager.createCheckpoint(\"before glob-bearing staged addition\");\n   208\t    fs.writeFileSync(path.join(repo, globName), \"literal bracket filename\\n\");\n   209\t    git(\"add\", globName);\n   210\t\n   211\t    const result = manager.restore(checkpoint.id);\n   212\t\n   213\t    assert.equal(result.success, true, result.message);\n   214\t    assert.equal(fs.existsSync(path.join(repo, globName)), false);\n   215\t    assert.equal(git(\"status\", \"--porcelain\"), \"\");\n   216\t  } finally {\n   217\t    cleanupGitRepo(repo);\n   218\t  }\n   219\t});\n   220\t\n   221\ttest(\"legacy Git restore removes a path renamed after the checkpoint\", () => {\n   222\t  const { repo, git } = gitRepo();\n   223\t  try {\n   224\t    fs.writeFileSync(path.join(repo, \"old.txt\"), \"checkpoint version\\n\");\n   225\t    git(\"add\", \"old.txt\");\n200:  const globName = \"file[ab].txt\";\n205:    assert.equal(git(\"check-ignore\", \"--no-index\", \"filea.txt\"), \"filea.txt\");\n{\n  \"agent\": \"codex-root\",\n  \"host\": \"mike-dev\",\n  \"branch\": \"v1/checkpoint-ordinary-child-fix\",\n  \"worktree\": \"/home/mike/nexus-wt/checkpoint-ordinary-child-fix\",\n  \"head\": \"41a63b4cfbd8c2ec40f384de28db4bea0faee49a\",\n  \"since\": \"2026-10-28T14:08:59Z\",\n  \"scope\": \"PR302 remediation: preflight every restore mutation path, including tracked deletions and exact-target bare repositories; preserve no-mutation guarantees; add regressions\",\n  \"status\": \"Exact-head PR #308 CI: Node 22 and Node 24 full test matrices passed on 41a63b4cfbd8c2ec40f384de28db4bea0faee49a; Linux packaging/reproducibility job is running. CodeQL 40748933431 passed. Independent reviewer plan05_readonly_review ACCEPT exact diff 9b8e1e2723b9168e5cfd7c34fce4cd05e7dbe84bf6c25e29c97e9b673d297ca1. Entire Gates pending; no merge or release acceptance claim.\",\n  \"base\": \"8580c821f57119768db0