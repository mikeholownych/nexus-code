    \\\"run\\\", \\\"--resume\\\", \\\"--json\\\", \\\"--endpoint\\\", \\\"http://127.0.0.1:1/v1\\\", \\\"--model\\\", \\\"m\\\", \\\"--workspace\\\", gitRepoDir,\\ncli/test/state.test.ts:597:      CorruptStateError\\ncli/test/fetch_web_ssrf.test.ts:262:            err.message,\\ncli/test/fetch_web_ssrf.test.ts:264:            `Expected redirect to be blocked by SSRF Guard, got: ${err.message}`\\ncli/test/task_state_v2.test.ts:9:import { DurableStateManager, CorruptStateError, UnsupportedSchemaVersionError, TaskStateReadError, TaskStateWriteError, type DurableTaskState } from \\\"../src/core/state.js\\\";\\ncli/test/task_state_v2.test.ts:157:  assert.throws(() => manager.loadTaskState(state.taskId), CorruptStateError);\\ncli/test/task_state_v2.test.ts:172:      assert.ok(!(err instanceof CorruptStateError), \\\"Must not be CorruptStateError\\\");\\ncli/test/task_state_v2.test.ts:411:  assert.throws(() => manager.loadTaskState(state.taskId), CorruptStateError);\\ncli/test/engine_handshake.test.ts:70:        assert.match(err.message, /Engine protocol mismatch: core engine reports protocol 99, but CLI expects 1\\\\./);\\ncli/test/engine_handshake.test.ts:71:        assert.match(err.message, /Run 'make build' to update\\\\./);\\ncli/test/engine_handshake.test.ts:104:        assert.match(err.message, /Engine version mismatch: core engine reports version 0\\\\.99\\\\.0-wrong, but CLI is/);\\ncli/test/engine_handshake.test.ts:105:        assert.match(err.message, /Run 'make build' to update\\\\./);\\ncli/test/engine_handshake.test.ts:137:        assert.match(err.message, /Core engine handshake failed: Internal initialization failure/);\\ncli/test/engine_handshake.test.ts:165:        assert.match(err.message, /Invalid JSON in core engine hello handshake response/);\\ncli/test/durable_continuity.test.ts:417:  test(\\\"nexus run --resume <task> and /recover: a restarted process inherits the unverified change; a read-only turn is not NOT_REQUIRED\\\", async () => {\\ncli/test/durable_continuity.test.ts:448:  test(\\\"ACC-CONT-01: run --resume <id> continues the recovered conversation, objective and task id\\\", async () => {\\ncli/test/durable_continuity.test.ts:464:        // Gateway fixture: the second request of run --resume <id> contains the first turn's messages\\ncli/test/durable_continuity.test.ts:477:  test(\\\"ACC-CONT-02: run --resume (no id) resumes latest task, or fails with code 2 and guidance\\\", async () => {\\ncli/test/durable_continuity.test.ts:489:            assert.match(err.message, /no task to resume in .*?; see 'nexus status'/);\\ncli/test/durable_continuity.test.ts:497:        // CLI run --resume in an empty workspace exits 2 with guidance\\ncli/test/durable_continuity.test.ts:498:        const cliResEmpty = await cli([\\\"run\\\", \\\"--resume\\\", \\\"--endpoint\\\", gw.url, \\\"--model\\\", \\\"m\\\"], { cwd: repo, home });\\ncli/test/durable_continuity.test.ts:515:        // CLI run --resume without id resolves and resumes the latest task\\ncli/test/durable_continuity.test.ts:516:        const cliRes = await cli([\\\"run\\\", \\\"--resume\\\", \\\"--endpoint\\\", gw.url, \\\"--model\\\", \\\"m\\\", \\\"--yes\\\"], { cwd: repo, home });\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1850d-3ac5-7c63-97bb-ed8b070a7d6e","create_time":1793233623.4882016}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
