\": \"open\",\n  \"metadata\": {},\n  \"type\": \"task\",\n  \"priority\": \"none\",\n  \"assignees\": [\n    \"ulid:01M5ZY9PW7S4G4GZP5GHKKS428\"\n  ],\n  \"assigneeAccountIds\": [\n    \"01M5ZY9PW7S4G4GZP5GHKKS428\"\n  ],\n  \"repoIds\": [\n    \"01M5ZYH5RC035FNYGB8DHGEZJV\"\n  ],\n  \"authorAccountId\": \"01M5ZY9PW7S4G4GZP5GHKKS428\",\n  \"createdAt\": \"2026-10-28T21:26:52.853Z\",\n  \"updatedAt\": \"0001-01-01T00:00:00Z\",\n  \"closedAt\": null,\n  \"isPossiblyPartial\": true,\n  \"changes\": [\n    {\n      \"id\": \"01M626H95PKWMZDRTNJ24AQ390\",\n      \"repositoryId\": \"01M5ZYH5RC035FNYGB8DHGEZJV\",\n      \"repository\": \"nexus-code\",\n      \"branch\": \"v1/readiness-post-308-merge-20261028\",\n      \"number\": 25,\n      \"title\": \"docs(release): refresh readiness after PR 308\",\n      \"status\": \"open\",\n      \"hasCodeChanges\": true,\n      \"createdAt\": \"2026-10-28T21:26:52.853Z\",\n      \"updatedAt\": \"2026-10-28T21:54:14.118Z\",\n      \"url\": \"https://entire.com/gh/mikeholownych/-/trails/25/changes/nexus-code/25\"\n    }\n  ]\n}\n{\n  \"counts\": {\n    \"Open\": 3,\n    \"OpenHigh\": 0,\n    \"OpenMedium\": 1,\n    \"OpenLow\": 2,\n    \"Resolved\": 0,\n    \"Dismissed\": 0,\n    \"Stale\": 0\n  },\n  \"findings\": [\n    {\n      \"id\": \"01M627HNDD19196HW00KKT6JXC\",\n      \"trailId\": \"01M626H95PKWMZDRTNJ24AQ390\",\n      \"repositoryId\": \"01M5ZYH5RC035FNYGB8DHGEZJV\",\n      \"reviewId\": \"01M627HNDAPCBWCHC9FV6WJ0J9\",\n      \"codeVersionId\": \"01M627G1Q686NRAC2ZNK9ZETDE\",\n      \"actorId\": \"automation:aut_01M60RASAYA3V4CJ8D61NZRDG5\",\n      \"title\": null,\n      \"body\": \"The screenshot waiver was added to ACCEPTANCE §5.3/ACC-TUI-MANUAL and SPEC-10 REQ-QUAL-108, but other gate documents were left unchanged. `docs/v1.0.0/TERMINAL-MATRIX-WORKSHEET.md` (lines 41-84) still requires both screenshots per cell, and line 75 makes the §5.3 gate PASS depend on them. `PLAN-10` row 12 still says \\\"Archive screenshots\\\". An operator filling in the worksheet now gets a gate that contradicts ACCEPTANCE. Update the worksheet and plan in the same change, and record the waiver in DECISIONS.md so all three can cite one decision instead of repeating free-text statements.\",\n      \"severity\": \"medium\",\n      \"confidence\": 0.75,\n      \"status\": \"open\",\n      \"statusReason\": null,\n      \"staleOutcome\": \"current\",\n      \"staleCheckedAt\": null,\n      \"staleCheckedCodeVersionId\": null,\n      \"clientId\": \"4ab6ffb35bb5d40005daa779f6ac2a8f\",\n      \"clientIdHash\": \"e5b4bd644a433863f0fa72185edb32759255600f40873881c7bd51752bc35839\",\n      \"createdAt\": \"2026-10-28T21:44:33.964Z\",\n      \"updatedAt\": \"2026-10-28T21:44:33.964Z\",\n      \"location\": {\n        \"id\": \"01M627HNDDD3TVAMJF28XX5JFX\",\n        \"reviewCommentId\": \"01M627HNDD19196HW00KKT6JXC\",\n        \"codeVersionId\": \"01M627G1Q686NRAC2ZNK9ZETDE\",\n        \"granularity\": \"line\",\n        \"filePath\": \"docs/v1.0.0/ACCEPTANCE.md\",\n        \"startLine\": 204,\n        \"startColumn\": null,\n        \"endLine\": null,\n        \"endColumn\": null,\n        \"selectedText\": \"Record PASS/FAIL per cell and the observed outcomes for each check, bound to the exact installed RC artifact, terminal environment, and size. The release owner has waived screenshot artifacts for v1.0.0; this waiver does not waive any interactive check, safety gate, per-cell verdict, or evidence record.\",\n        \"nearbyText\": null,\n        \"language\": null\n      },\n      \"discussionId\": \"01M627HNDD731MPCWMB2DZS734\"\n    },\n    {\n      \"id\": \"01M626Q7BC03YFWJAHJTWPVCDM\",\n      \"trailId\": \"01M626H95PKWMZDRTNJ24AQ390\",\n      \"repositoryId\": \"01M5ZYH5RC035FNYGB8DHGEZJV\",\n      \"reviewId\": \"01M626Q7B8ZZGFQWSK46XZJBZG\",\n      \"codeVersionId\": \"01M626NPESSBV2R87AJX7PK1GG\",\n      \"actorId\": \"automation:aut_01M60RASAYA3V4CJ8D61NZRDG5\",\n      \"title\": null,\n      \"body\": \"\\\"PR #310 is the open documentation-only readiness refresh against this exact main revision; its checks are running.\\\" and \\\"This checkpoint distinguishes the neutral GitHub check from the separate unresolved Entire trail report.\\\" describe this edit and its PR, not the release state. Once this PR merges, the first sentence is wrong. The second only comments on the paragraph it sits in. Remove both.\",\n      \"severity\": \"low\",\n      \"confidence\": 0.6,\n      \"status\": \"open\",\n      \"statusReason\": null,\n      \"staleOutcome\": \"current\",\n      \"staleCheckedAt\": \"2026-10-28T21:54:14.118Z\",\n      \"staleCheckedCodeVersionId\": \"01M6281V1SABW1YQ1AG6EQH8D3\",\n      \"clientId\": \"fd5bc8f1309ffcb31884938e44cda613\",\n      \"clientIdHash\": \"80c9f20881c76edada4a01d6efba46f17d4423ae9eb3cdceaff571bb917c53b5\",\n      \"createdAt\": \"2026-10-28T21:30:07.595Z\",\n      \"updatedAt\": \"2026-10-28T21:30:07.595Z\",\n      \"location\": {\n        \"id\": \"01M626Q7BCEZ45FCP9GFT3S0JB\",\n        \"reviewCommentId\": \"01M626Q7BC03YFWJAHJTWPVCDM\",\n        \"codeVersionId\": \"01M626NPESSBV2R87AJX7PK1GG\",\n        \"granularity\": \"line\",\n        \"filePath\": \"docs/v1.0.0/READINESS.md\",\n        \"startLine\": 7,\n        \"startColumn\": null,\n        \"endLine\": null,\n        \"endColumn\": null,\n        \"selectedText\": \"**Integrated changes:** PR #309 merged as `b3dea1a96fb204e5fa48becc90f12bf5042076af` at 20:36 UTC with checksummed RC10 ChatGPT-plan provider evidence. PR #300 merged as `79cba842e86d64f895e1a269636776cdf1e7e6da` at 21:07:46 UTC after Node 22/24, Linux packaging/tests, JavaScript/TypeScript and CodeQL passed. PR #308 merged as `10c84df89d391987454e4997aaa8f97529cc2496` at 21:15:37 UTC; exact PR head `9829c61d9b2556bba25a5ec6aee8fa9f1acf9bc8` passed Node 22/24 and Linux, with JavaScript/TypeScript and CodeQL passed; its GitHub Entire Gates check was neutral. A post-merge source reviewer found no blocking 