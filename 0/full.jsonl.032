-------------------------------------------------\\n\\nconst CONFIG_KEYS: Array<{ key: string; flag?: string; field: keyof HarnessConfig | ((c: HarnessConfig) => string | undefined); fallback?: string }> = [\\n  { key: \\\"NEXUS_PROVIDER\\\", flag: \\\"provider\\\", field: (c) => c.provider },\\n  { key: \\\"LOCAL_LLM_ENDPOINT\\\", flag: \\\"endpoint\\\", field: \\\"endpoint\\\", fallback: \\\"http://localhost:1234/v1\\\" },\\n  { key: \\\"LOCAL_LLM_MODEL\\\", flag: \\\"model\\\", field: \\\"model\\\", fallback: \\\"local-model\\\" },\\n  { key: \\\"LOCAL_LLM_API_KEY\\\", flag: \\\"apiKey\\\", field: (c) => (c.apiKey && c.apiKey !== \\\"local\\\" ? \\\"set (not shown)\\\" : \\\"not set\\\") },\\n  { key: \\\"LOCAL_HARNESS_SHELL\\\", flag: \\\"shell\\\", field: \\\"shell\\\", fallback: \\\"bash\\\" },\\n  { key: \\\"workspace\\\", flag: \\\"workspace\\\", field: \\\"workspace\\\" },\\n  { key: \\\"max steps per segment\\\", flag: \\\"maxSteps\\\", field: (c) => (c.continuation ? `${c.maxSteps} (checkpoint interval, not a limit)` : `${c.maxSteps} (turn limit: continuation off)`), fallback: \\\"30\\\" },\\n  { key: \\\"NEXUS_MAX_TOTAL_STEPS\\\", flag: \\\"maxTotalSteps\\\", field: (c) => (c.continuation ? (Number.isFinite(c.continuation.maxTotalSteps) ? String(c.continuation.maxTotalSteps) : \\\"none\\\") : \\\"continuation off\\\"), fallback: \\\"none\\\" },\\n  { key: \\\"NEXUS_MAX_TURN_MINUTES\\\", flag: \\\"maxTurnMinutes\\\", field: (c) => (c.continuation ? (Number.isFinite(c.continuation.maxTurnMinutes) ? String(c.continuation.maxTurnMinutes) : \\\"none\\\") : \\\"continuation off\\\"), fallback: \\\"none\\\" },\\n  { key: \\\"NEXUS_STAGNATION_STEPS\\\", flag: \\\"stagnationSteps\\\", field: (c) => (c.continuation ? String(c.continuation.stagnationSteps) : \\\"continuation off\\\"), fallback: \\\"12\\\" },\\n  { key: \\\"NEXUS_VERIFIER_TIMEOUT_SECS\\\", field: (c) => String(c.verifierTimeoutSecs ?? 300), fallback: \\\"300\\\" },\\n  { key: \\\"PLANNER_LLM_MODEL\\\", flag: \\\"plannerModel\\\", field: (c) => c.plannerModel },\"}]}},{\"_index\":\"nexus-cli-docs\",\"_id\":\"1431592c139321f077c6a66b9e6b52a1\",\"_score\":22.751545,\"_source\":{\"title\":\"agent.ts\",\"ax_path\":\"agent.ts\",\"ax_file\":\"axf2-6b3daf438676b559cd943bf2cac57e68-55672\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":773,\"start_offset\":38608,\"end_offset\":40645,\"text\":\"    cwd: workspace,\\n    encoding: \\\"utf-8\\\",\\n    stdio: [\\\"ignore\\\", \\\"pipe\\\", \\\"ignore\\\"],\\n    maxBuffer: 64 * 1024 * 1024,\\n  });\\n  return createHash(\\\"sha256\\\").update(out).digest(\\\"hex\\\").slice(0, 16);\\n}\\n\\n/** What an archive read means for a resumed conversation; undefined when the archive is whole. */\\nfunction describeArchiveRead(read: ArchiveRead<ChatMessage>): string | undefined {\\n  const notes: string[] = [];\\n  if (read.uncommittedLines) notes.push(`${read.uncommittedLines} archived message(s) from a compaction that was interrupted before it was committed were set aside; their originals are in the resumed conversation itself`);\\n  if (read.unreadableLines) notes.push(`${read.unreadableLines} archive line(s) could not be read (an interrupted write); they are not used`);\\n  if (read.missingCompactions.length) {\\n    notes.push(`this unit was compacted by an earlier version; originals before ${read.missingCompactions[0]} are not recoverable`);\\n  }\\n  return notes.length ? `Compaction archive: ${notes.join(\\\"; \\\")}.` : undefined;\\n}\\n\\n/** \\\"step 7\\\" under no step limit, \\\"step 7 of 40\\\" under one the operator set. */\\nfunction stepPosition(step: number, max: number): string {\\n  return Number.isFinite(max) ? `step ${step} of ${max}` : `step ${step}`;\\n}\\n\\n/** A workspace state identity that took longer than this disables further ones for the turn (reported, not hidden). */\\nconst STATE_IDENTITY_BUDGET_MS = 1_500;\\n\\nfunction triggerNotification(title: string, message: string, surface?: string) {\\n  // Desktop notification and BEL happen only when stdout is an interactive TTY and the surface is the REPL or TUI (REQ-AGT-109a).\\n  if (!process.stdout.isTTY) {\\n    return;\\n  }\\n  if (surface !== \\\"repl\\\" && surface !== \\\"tui\\\") {\\n    return;\\n  }\\n  try {\\n    process.stdout.write(\\\"\\\\x07\\\");\\n    execFile(\\\"notify-send\\\", [title, message], () => {});\\n  } catch {\\n    // Ignore notification errors\\n  }\\n}\\n\\nfunction logAudit(entry: {\\n  workspace: string;\\n  tool: string;\\n  args: any;\\n  success: boolean;\\n  durationMs: number;\\n  error?: string;\\n}) {\\n  try {\"}]},\"match_line\":798,\"match_lines\":[798]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"7dca3b6530ab467e3c984d24dbe9fa7b\",\"_score\":22.592318,\"_source\":{\"title\":\"client.ts\",\"ax_path\":\"client.ts\",\"ax_file\":\"axf2-33f9bd7d6b5dee989d474b71676aaa45-17404\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":1181,\"start_offset\":55546,\"end_offset\":57561,\"text\":\"    const cacheKey = `${this.endpoint}::${this.model}`;\\n    const cached = LocalLlmClient.serverContextCache.get(cacheKey);\\n    if (cached) return cached;\\n    const root = this.endpoint.replace(/\\\\/v1\\\\/?$/, \\\"\\\");\\n    const probes: Array<{ kind: \\\"llamacpp\\\" | \\\"lmstudio\\\" | \\\"ollama\\\"; url: string; init?: RequestInit }> = [\\n      { kind: \\\"llamacpp\\\" as const, url: `${root}/props` },\\n      { kind: \\\"lmstudio\\\" as const, url: `${root}/api/v0/models` },\\n      { kind: \\\"ollama\\\" as const, url: `${root}/api/show`, init: { method: \\\"POST\\\", body: JSON.stringify({ model: this.model }), headers: { \\\"content-type\\\": \\\"application/json\\\" } } },\\n    ].filter((p) => p.kind === kind);\\n    for (const probe of probes) {\\n      try {\\n        const res = await fetch(probe.url, {\\n          ...probe.init,\\n          headers: { ...(probe.init?.headers as Record<string, string> | undefined), ...this.authorization(probe.url), \\\"X-Nexus-Purpose\\\": \\\"capabilities\\\" },\\n          signal: signal ? AbortSignal.any([signal, AbortSignal.timeout(2_000)]) : AbortSignal.timeout(2_000),\\n          ...this.fetchPolicy(),\\n        });\\n        if (!res.ok) continue;\\n        const found = parseServerContext(probe.kind, await res.json(), this.model);\\n        if (found) {\\n          LocalLlmClient.serverContextCache.set(cacheKey, found);\\n          return found;\\n        }\\n      } catch {\\n        if (signal?.aborted) throw abortedError(randomUUID());\\n      }\\n    }\\n    return undefined;\\n  }\\n\\n  /**\\n   * Counts the prompt tokens of the request inference would send now, through the connection's `/v1/tokenize`\\n   * (advertised by the homelab-ai gateway contract). The body is `outboundChatBody` — the actual outbound messages,\\n   * tools, tool_choice and settings, after the same egress quarantine and sanitization — sent to the active endpoint\\n   * only, with the same credential scoping, disclosure checks and cancellation as inference. No failover: a counting\\n   * failure belongs to this connection and capability, and never moves task content elsewhere.\"}]},\"match_line\":1216,\"match_lines\":[1216]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"4ecf92c92d21d56a8a88f813ebf490a8\",\"_score\":22.502613,\"_source\":{\"title\":\"resources.ts\",\"ax_path\":\"core/resources.ts\",\"ax_file\":\"axf2-a15f5020befdf667b5cc1f10ad029d7a-4b86\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":28,\"start_offset\":1336,\"end_offset\":2599,\"text\":\"export interface ResourceDescriptor {\\n  id: string;\\n  /** Provider identity; defaults to the endpoint origin. */\\n  provider: string;\\n  endpoint: string;\\n  model: string;\\n  /** Serving pool shared with other models, when known (e.g. from a gateway catalog). */\\n  pool?: string;\\n  /** Credential identity label (a fingerprint, never the secret). */\\n  account?: string;\\n  /** Distinguishes caller-provided account labels from credential-derived legacy hashes during migration. */\\n  accountIdentitySource?: \\\"explicit\\\" | \\\"credential\\\";\\n  apiKeyEnv?: string;\\n  /** Cloud provider id (providers.ts); the endpoint is then that provider's base URL and its key its own. */\\n  providerId?: string;\\n  capabilities: string[];\\n  /** Roles/task classes this resource is qualified for; undefined qualifies it for any. */\\n  qualifications?: string[];\\n  /** Qualifications this resource is the preferred choice for; it outranks resources merely qualified for them. */\\n  preferredFor?: string[];\\n  contextLength?: number;\\n  /** Lower is preferred. */\\n  rank?: number;\\n  /** Operator knowledge of how the provider scopes rate limits; default \\\"model\\\". */\\n  rateLimitScope?: \\\"model\\\" | \\\"account\\\" | \\\"provider\\\";\\n  /** X-Task-Class routing hint sent with requests. */\\n  taskClass?: string;\\n}\"}]},\"match_line\":39,\"match_lines\":[39]}]}}"}],"isError":false},"duration":{"secs":0,"nanos":639520672}},"started_at_ms":1793219549769,"completed_at_ms":1793219550409}}
