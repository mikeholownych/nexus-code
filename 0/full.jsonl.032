{"timestamp":"2026-10-28T20:56:24.045Z","ordinal":464603,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a1844c-0389-7191-bd33-ba7c92f2b1e0","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a1844c-0389-7191-bd33-ba7c92f2b1e0","response_id":"resp_060b64278a9dfb15016ae261760ed881a0bcfd85bf34d93df6","usage":{"input_tokens":122863,"cached_input_tokens":122624,"cache_write_input_tokens":0,"output_tokens":104,"reasoning_output_tokens":32,"total_tokens":122967},"turn_token_usage":{"input_tokens":704393,"cached_input_tokens":690176,"cache_write_input_tokens":0,"output_tokens":1606,"reasoning_output_tokens":684,"total_tokens":705999},"thread_token_usage":{"input_tokens":8584332951,"cached_input_tokens":8492869888,"cache_write_input_tokens":0,"output_tokens":24415528,"reasoning_output_tokens":14069517,"total_tokens":8608748479}}}
{"timestamp":"2026-10-28T20:56:24.050Z","ordinal":464604,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1844c-bcf1-7bc0-b676-912b39898792","call_id":"call_1b980ea577f24eeb977e26ce5bf97a6f","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"[{\"name\":\"mcp__mcp_agent_mail__search_messages\",\"description\":\"You are the MCP Agent Mail coordination server. Provide message routing, coordination tooling, and project context to cooperating agents. Outputs are JSON by default; pass format='toon' (or set MCP_AGENT_MAIL_OUTPUT_FORMAT=toon) to receive {format:'toon', data:'<TOON>'}.\\n\\nFull-text search over subject and body for a project.\\n\\nTips\\n----\\n- SQLite FTS5 syntax supported: phrases (\\\"build plan\\\"), prefix (mig*), boolean (plan AND users)\\n- Results are ordered by bm25 score (best matches first)\\n- Limit defaults to 20; raise for broad queries\\n\\nQuery examples\\n---------------\\n- Phrase search: `\\\"build plan\\\"`\\n- Prefix: `migrat*`\\n- Boolean: `plan AND users`\\n- Require urgent: `urgent AND deployment`\\n\\nParame\"},{\"name\":\"mcp__mcp_agent_mail__send_message\",\"description\":\"You are the MCP Agent Mail coordination server. Provide message routing, coordination tooling, and project context to cooperating agents. Outputs are JSON by default; pass format='toon' (or set MCP_AGENT_MAIL_OUTPUT_FORMAT=toon) to receive {format:'toon', data:'<TOON>'}.\\n\\nSend a Markdown message to one or more recipients and persist canonical and mailbox copies to Git.\\n\\nDiscovery\\n---------\\nTo discover available agent names for recipients, use: resource://agents/{project_key}\\nAgent names are NOT the same as program names or user names.\\n\\nWhat this does\\n--------------\\n- Stores message (and recipients) in the database; updates sender's activity\\n- Writes a canonical `.md` under `messages/YYYY/MM/\"}]"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1844c-0389-7191-bd33-ba7c92f2b1e0","create_time":1793220984.0499492}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
