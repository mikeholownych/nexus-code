  645\t          return true;\n   646\t        }\n   647\t      }\n   648\t    } catch {}\n   649\t  }\n   650\t\n   651\t  // Localhost allowed for local mock testing\n   652\t  if (hostname === \"127.0.0.1\" || hostname === \"localhost\") {\n   653\t    return parsed.protocol === \"http:\" || parsed.protocol === \"https:\";\n   654\t  }\n   655\t\n   656\t  // GitHub allowed domains - must be HTTPS\n   657\t  if (parsed.protocol !== \"https:\") {\n   658\t    return false;\n   659\t  }\n   660\t\n   661\t  if (hostname === \"github.com\") {\n   662\t    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n   663\t  }\n   664\t\n   665\t  if (hostname === \"objects.githubusercontent.com\") {\n   666\t    return true;\n   667\t  }\n   668\t\n   669\t  // GitHub now redirects release downloads to its signed release-assets host.\n   670\t  // Restrict the path to release objects; never allow this host as a generic CDN.\n   671\t  if (hostname === \"release-assets.githubusercontent.com\") {\n   672\t    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n   673\t  }\n   674\t\n   675\t  return false;\n   676\t}\n   677\t\n   678\t/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\n   679\tfunction safeDownloadOrigin(urlString: string): string {\n   680\t  try {\n   681\t    return new URL(urlString).origin;\n   682\t  } catch {\n   683\t    return \"invalid URL\";\n   684\t  }\n   685\t}\n   686\t\n   687\tfunction isDownloadConnectionReset(error: any): boolean {\n   688\t  for (let current = error; current; current = current.cause) {\n   689\t    if (current.code === \"ECONNRESET\" || current.code === \"UND_ERR_SOCKET\") return true;\n   690\t  }\n   691\t  return false;\n   692\t}\n   693\t\n   694\texport async function downloadFile(\n   695\t  url: string,\n   145\t    } finally {\n   146\t      if (server) {\n   147\t        await new Promise<void>((resolve) => server!.close(() => resolve()));\n   148\t      }\n   149\t      fs.rmSync(testDir, { recursive: true, force: true });\n   150\t    }\n   151\t  });\n   152\t\n   153\t  it(\"follows the allowlisted signed GitHub release-asset redirect without forwarding credentials\", async () => {\n   154\t    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-release-asset-\"));\n   155\t    const originalFetch = globalThis.fetch;\n   156\t    const originalToken = process.env.GITHUB_TOKEN;\n   157\t    const requests: Array<{ url: string; authorization: string | null; redirect: string | undefined }> = [];\n   158\t    const downloadUrl = \"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.8/nexus.tar.gz\";\n   159\t    const signedAssetUrl = \"https://release-assets.githubusercontent.com/github-production-release-asset/1416386345/11111111-2222-4333-8444-555555555555?token=synthetic-signature\";\n   160\t\n   161\t    try {\n   162\t      process.env.GITHUB_TOKEN = \"REDACTED\";\n   163\t      globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit) => {\n   164\t        const url = String(input);\n   165\t        requests.push({\n   166\t          url,\n   167\t          authorization: new Headers(init?.headers).get(\"authorization\"),\n   168\t          redirect: init?.redirect,\n   169\t        });\n   170\t        if (url === downloadUrl) {\n   171\t          return new Response(null, { status: 302, headers: { location: signedAssetUrl } });\n   172\t        }\n   173\t        if (url === signedAssetUrl) {\n   174\t          return new Response(new Uint8Array([0x4e, 0x58, 0x53]), { status: 200 });\n   175\t        }\n   176\t        throw new Error(`Unexpected mocked download URL: ${new URL(url).origin}`);\n   177\t      }) as typeof globalThis.fetch;\n   178\t\n   179\t      const destination = path.join(testDir, \"release.tar.gz\");\n   180\t      await downloadFile(\n   181\t        downloadUrl,\n   182\t        destination,\n   183\t      );\n   184\t\n   185\t      assert.deepEqual(requests, [\n   186\t        {\n   187\t          url: downloadUrl,\n   188\t          authorization: \"Bearer synthetic-github-token\",\n   189\t          redirect: \"manual\",\n   190\t        },\n## main...origin/main [ahead 1, behind 1407]\n M .claude/settings.json\n M AGENTS.md\n M cli/dist/agent.js\n M cli/dist/core/state.js\n M cli/package.json\n M cli/src/agent.ts\n M cli/src/checkpoint.ts\n M cli/src/core/durable_file.ts\n M cli/src/core/persistence_protection.ts\n M cli/src/core/state.ts\n M cli/src/flight.ts\n M cli/src/knowledge.ts\n M cli/src/session.ts\n M cli/test/compaction_continuity.test.ts\n M core/tests/adversarial_path_traversal.rs\nA  docs/v1.0.0/ACCEPTANCE.md\nA  docs/v1.0.0/REQUIREMENTS.md\nA  scripts/check_requirements.mjs\n?? .entire/agent-guide.md\n?? CLAUDE.md\n?? cli/test/agent_prompt.test.ts\n?? cli/test/helpers/setup.ts\n?? cli/test/home_isolation.test.ts\n?? cli/test/persistence_hygiene.test.ts\n?? docs/codebase-review-enhancements.md\n?? docs/enhancement-opportunities.md\n?? docs/reviews/evidence/v1-qualification/\n?? docs/v1.0.0/AUDIT.md\n?? docs/v1.0.0/CONCURRENCY.md\n?? docs/v1.0.0/DECISIONS.md\n?? docs/v1.0.0/EVIDENCE.md\n?? docs/v1.0.0/LANGSMITH_REVIEW.md\n?? docs/v1.0.0/README.md\n?? docs/v1.0.0/ROADMAP.md\n?? docs/v1.0.0/SHA256SUMS\n?? docs/v1.0.0/evidence/\n?? docs/v1.0.0/plans/\n?? docs/v1.0.0/specs/\n?? jsf/\n?? nexus-continuity-validation/\n?? nexus-session-session_20261014_091558_9m78.json\n?? nexus-session-session_20261023_134635_z1dnlfek.json\n?? nexus-session-session_20261026_162439_34f2cnrn.json\n?? package-lock.json\n","exit_code":0,"duration":{"secs":0,"nanos":29912}},"started_at_ms":1793218320850,"completed_at_ms":1793218320850}}
