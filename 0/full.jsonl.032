n268:test(\"qualification separates native context discovery from explicit operator overrides\", async () => {\n269-  const { nexusContextLimitArgs, nexusLimitsProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n270-  const entry = { id: \"m\", context_length: 32768, max_completion_tokens: 8192 };\n271-  const native = { serverProfile: \"llamacpp\", limits: { output: 8192 } };\n--\n286-  const fingerprint = { alias: \"engineering/deep\", listed: true, ownedBy: \"fixture\", contextLength: 65536, weightsSha256: \"a\".repeat(64), serverBuild: \"llama.cpp b123\", sampling: { temperature: 0, seed: 17 } };\n287-  fs.writeFileSync(path.join(dir, \"manifest.json\"), JSON.stringify({\n288-    ...overrides,\n289:    config: { name: `${agent}@engineering/deep`, agent, model: \"engineering/deep\", qualification: true, limits: { context: 65536, output: 8192, requests: 200, totalOutput: 100_000 }, resources: { cpuPercent: 800, memoryBytes: 17179869184, tasks: 4096, storageBytes: 21474836480, workspaceRoot: \"/srv/nexus-qual/ws\" }, sampling: { temperature: 0, seed: 17 }, ...(agent === \"nexus\" ? { nexusPackageSha256: \"d\".repeat(64) } : {}), ...(overrides.config as object ?? {}) },\n290-    fingerprint: { ...fingerprint, ...(overrides.fingerprint as object ?? {}) },\n291-    agentVersion: { agent, version: `${agent} 1.2.3`, executablePath: `/usr/bin/${agent}`, executableSha256: \"c\".repeat(64), ...(agent === \"nexus\" ? { packageSha256: \"d\".repeat(64) } : {}) },\n292-    runs: 5,\n577\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18432-af9c-7882-80ce-70535521cb1b","create_time":1793219630.5164862}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
