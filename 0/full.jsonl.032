untime_identity.test.ts:43:    assert.match(systemPrompt, /provider and model are components Nexus connects to; they do not define or replace the host application/);\norigin/main:cli/test/agent_runtime_identity.test.ts:44:    assert.match(systemPrompt, /Do not identify this runtime as Claude Code/);\n7c172c0f docs(release): record runtime identity fix status\ne94208d0 Merge pull request #273 from mikeholownych/v1/defect-agent-runtime-identity\n674e5bf3 test(agent): isolate runtime identity state directory\nd97ccb70 fix(agent): preserve Nexus runtime identity\n2007b90b Merge pull request #51 from mikeholownych/v1/plan-12-post-review-transaction-fixes\nb590be26 test(upgrade): exercise killed transactions and live runtime identity failure\n","exit_code":0,"duration":{"secs":1,"nanos":158880995}},"started_at_ms":1793223687781,"completed_at_ms":1793223688940}}
