\");\n  git(\"config\", \"user.name\", \"Test\");\n  fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"base\\n\");\n  git(\"add\", \"tracked.txt\");\n  git(\"commit\", \"-qm\", \"base\");\n  return { repo, git };\n}\n\nfunction cleanupGitRepo(repo: string): void {\n  const checkpointKey = createHash(\"sha256\").update(path.resolve(repo)).digest(\"hex\").slice(0, 12);\n  fs.rmSync(path.join(os.homedir(), \".nexus\", \"checkpoints\", checkpointKey), { recursive: true, force: true });\n  fs.rmSync(repo, { recursive: true, force: true });\n}\n\ntest(\"Git restore preserves untracked work and HEAD while removing post-checkpoint files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"pre-existing user work\\n\");\n     1\timport assert from \"node:assert/strict\";\n     2\timport { test } from \"node:test\";\n     3\timport fs from \"node:fs\";\n     4\timport os from \"node:os\";\n     5\timport path from \"node:path\";\n     6\timport { createHash } from \"node:crypto\";\n     7\timport { execFileSync, spawnSync } from \"node:child_process\";\n     8\timport { CheckpointManager } from \"../src/checkpoint.js\";\n     9\timport { SensitivePersistenceError } from \"../src/core/persistence_protection.js\";\n    10\t\n    11\tlet previousHome: string | undefined;\n    12\tlet isolatedHome: string;\n    13\t\n    14\ttest.beforeEach(() => {\n    15\t  previousHome = process.env.HOME;\n    16\t  isolatedHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-home-\"));\n    17\t  process.env.HOME = isolatedHome;\n    18\t});\n    19\t\n    20\ttest.afterEach(() => {\n    21\t  if (previousHome === undefined) delete process.env.HOME;\n    22\t  else process.env.HOME = previousHome;\n    23\t  fs.rmSync(isolatedHome, { recursive: true, force: true });\n    24\t});\n    25\t\n","exit_code":0,"duration":{"secs":0,"nanos":81