{"timestamp":"2026-10-28T19:50:32.387Z","ordinal":462605,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18405-0795-7761-83bc-7e851bfd6fd4","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a18405-0795-7761-83bc-7e851bfd6fd4","response_id":"resp_060b64278a9dfb15016ae2520258a081a0a569f7b05f860095","usage":{"input_tokens":85673,"cached_input_tokens":84992,"cache_write_input_tokens":0,"output_tokens":418,"reasoning_output_tokens":277,"total_tokens":86091},"turn_token_usage":{"input_tokens":8370483,"cached_input_tokens":8286720,"cache_write_input_tokens":0,"output_tokens":27801,"reasoning_output_tokens":14885,"total_tokens":8398284},"thread_token_usage":{"input_tokens":8547793401,"cached_input_tokens":8456657152,"cache_write_input_tokens":0,"output_tokens":24315426,"reasoning_output_tokens":14017064,"total_tokens":8572108827}}}
{"timestamp":"2026-10-28T19:50:34.437Z","ordinal":462606,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a18405-0795-7761-83bc-7e851bfd6fd4","item":{"type":"CommandExecution","id":"exec-e5e9c684-7c0f-418e-bb4e-f38ee9bda198","process_id":"17238","command":["/usr/bin/zsh","-lc","node -e 'const p=require(\"./cli/package.json\"); console.log(p.scripts.test)' && sed -n '150,225p' cli/test/checkpoint_restore.test.ts && git diff 13e45a07361866d697e16b2c90e48e4fdfcd15e0...HEAD --check && git rev-parse HEAD && git status --short"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"unknown","cmd":"node -e 'const p=require(\"./cli/package.json\"); console.log(p.scripts.test)' && sed -n '150,225p' cli/test/checkpoint_restore.test.ts && git diff 13e45a07361866d697e16b2c90e48e4fdfcd15e0...HEAD --check && git rev-parse HEAD && git status --short"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"node scripts/run_tests.mjs && bash ../scripts/terminal-acceptance/test-scope-procs.sh\n\ntest(\"Git restore refuses an ignored staged addition before changing the index or workspace\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \".gitignore\"), \"ignored.bin\\n\");\n    git(\"add\", \".gitignore\");\n    git(\"commit\", \"-qm\", \"ignore generated artifact\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"before forced ignored addition\");\n    fs.writeFileSync(path.join(repo, \"ignored.bin\"), \"ignored staged payload\\n\");\n    git(\"add\", \"-f\", \"ignored.bin\");\n    const indexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /ignored by current Git rules/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"ignored.bin\"), \"utf8\"), \"ignored staged payload\\n\");\n    assert.equal(execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\"), indexBefore);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git restore treats pathspec-magic filenames literally when checking ignored additions\", () => {\n  const { repo, git } = gitRepo();\n  const magicName = \":(exclude)ignored.bin\";\n  try {\n    fs.writeFileSync(path.join(repo, \".gitignore\"), `${magicName}\\n`);\n    git(\"add\", \".gitignore\");\n    git(\"commit\", \"-qm\", \"ignore a pathspec-looking filename\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"before forced pathspec-looking addition\");\n    fs.writeFileSync(path.join(repo, magicName), \"ignored staged payload\\n\");\n    git(\"add\", \"-f\", `:(literal)${magicName}`);\n    assert.equal(git(\"ls-files\", \"--error-unmatch\", \"--\", `:(literal)${magicName}`), magicName);\n    const indexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /ignored by current Git rules/i);\n    assert.equal(fs.readFileSync(path.join(repo, magicName), \"utf8\"), \"ignored staged payload\\n\");\n    assert.equal(execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\"), indexBefore);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git restore does not treat glob syntax in a filename as an ignore-pattern match\", () => {\n  const { repo, git } = gitRepo();\n  const globName = \"file[ab].txt\";\n  try {\n    fs.writeFileSync(path.join(repo, \".gitignore\"), `${globName}\\n`);\n    git(\"add\", \".gitignore\");\n    git(\"commit\", \"-qm\", \"ignore matching glob paths\");\n    assert.equal(git(\"check-ignore\", \"--no-index\", \"filea.txt\"), \"filea.txt\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"before glob-bearing staged addition\");\n    fs.writeFileSync(path.join(repo, globName), \"literal bracket filename\\n\");\n    git(\"add\", `:(literal)${globName}`);\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.existsSync(path.join(repo, globName)), false);\n    assert.equal(git(\"status\", \"--porcelain\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy Git restore removes a path renamed after the checkpoint\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"old.txt\"), \"checkpoint version\\n\");\n9829c61d9b2556bba25a5ec6aee8fa9f1acf9bc8\n","exit_code":0,"duration":{"secs":1,"nanos":4451746}},"started_at_ms":1793217033432,"completed_at_ms":1793217034437}}
