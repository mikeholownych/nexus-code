lor(`◆ ${safeTerminal(e.message)}`));\\n    70\\t}\\n    71\\t\\n    72\\tfunction printStatus(op: DurableOperationState): void {\\n    73\\t  console.log(pc.bold(`Operation ${safeTerminal(op.id)}: ${safeTerminal(op.status)}`) + pc.dim(`  (${safeTerminal(op.objective)})`));\\n    74\\t  for (const u of op.units) {\\n    75\\t    const extra =\\n    76\\t      u.status === \\\"PARKED\\\" ? ` — ${u.parked!.reason}; wakes ${u.parked!.wakeAt}` :\\n    77\\t      u.status === \\\"BLOCKED\\\" ? ` — ${u.blocked!.reason}` :\\n    78\\t      u.status === \\\"COMPLETE\\\" ? ` — on ${u.result!.resourceId}` :\\n    79\\t      u.assignment ? ` — ${u.assignment.resourceId}` : \\\"\\\";\\n    80\\t    console.log(`  ${safeTerminal(u.status).padEnd(22)} ${safeTerminal(u.title)}${pc.dim(safeTerminal(extra))}`);\\n    81\\t  }\\n    82\\t  if (op.wait) console.log(pc.yellow(`Waiting until ${safeTerminal(op.wait.wakeAt)}: ${safeTerminal(op.wait.reason)}`));\\n    83\\t  for (const d of op.blocked?.decisions ?? []) {\\n    84\\t    console.log(pc.red(`Decision ${safeTerminal(d.id)} needed: ${safeTerminal(d.question)}`));\\n    85\\t    for (const o of d.options) console.log(pc.red(`  [${safeTerminal(o.id)}] ${safeTerminal(o.label)}`));\\n    86\\t    if (d.options.length) console.log(pc.dim(`  nexus operation decide ${safeTerminal(op.id)} ${safeTerminal(d.id)} <option> [--note <text>]`));\\n    87\\t  }\\n    88\\t}\\n    89\\t\\n    90\\tasync function drive(op: DurableOperationState, config: HarnessConfig, store: OperationStore, discoverCatalog: boolean, json: boolean): Promise<void> {\\n    91\\t  const controller = new AbortController();\\n    92\\t  const onSignal = () => controller.abort();\\n    93\\t  process.once(\\\"SIGINT\\\", onSignal);\\n    94\\t  try {\\n    95\\t    const out = await driveOperation(op, {\\n    96\\t      store,\\n    97\\t      signal: controller.signal,\\n    98\\t      executor: new AgentWorkUnitExecutor({ baseConfig: config, discoverCatalog }),\\n    99\\t      ...(json ? {} : { onEvent: printEvent }),\\n   100\\t    });\\n   101\\t    if (json) console.log(JSON.stringify(out, null, 2));\\n   102\\t    else printStatus(out);\\n   103\\t    process.exitCode = out.status === \\\"COMPLETE\\\" ? 0 : out.status === \\\"CANCELLED\\\" ? 130 : 2;\\n   104\\t  } finally {\\n   105\\t    process.off(\\\"SIGINT\\\", onSignal);\\n   106\\t  }\\n   107\\t}\\n   108\\t\\n   109\\tfunction operationAction<T extends unknown[]>(action: (...args: T) => void | Promise<void>): (...args: T) => Promise<void> {\\n   110\\t  return async (...args: T) => {\\n   180\\t  common(op.command(\\\"decide\\\").argument(\\\"<id>\\\", \\\"Operation id\\\").argument(\\\"<decision>\\\", \\\"Decision id (e.g. review#1)\\\").argument(\\\"<option>\\\", \\\"Option id\\\"))\\n   181\\t    .option(\\\"--note <text>\\\", \\\"Operator note (required to revise a unit)\\\")\\n   182\\t    .option(\\\"--no-resume\\\", \\\"Record the decision without resuming the operation\\\")\\n   183\\t    .description(\\\"Apply an operator decision to a blocked unit, then resume the operation\\\")\\n   184\\t    .action(operationAction(async (id: string, decisionId: string, optionId: string, options: any) => {\\n   185\\t      const config = buildConfig(options);\\n   186\\t      const store = new OperationStore(config.workspace);\\n   187\\t      let state: DurableOperationState;\\n   188\\t      try {\\n   189\\t        state = applyOperatorDecision(store, id, decisionId, optionId, options.note, { onEvent: printEvent });\\n   190\\t      } catch (err) {\\n   191\\t        if (!(err instanceof DecisionRejected)) throw err;\\n   192\\t        console.error(pc.red(`Decision rejected: ${safeTerminal(String(err.message))}`));\\n   193\\t        process.exitCode = 2;\\n   194\\t        return;\\n   195\\t      }\\n   196\\t      if (options.resume === false) return void printStatus(state);\\n   197\\t      await drive(state, config, store, Boolean(options.discover), Boolean(o