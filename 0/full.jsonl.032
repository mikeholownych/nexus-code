{"timestamp":"2026-10-28T23:02:58.064Z","ordinal":468858,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a184b8-1382-7c51-b7ba-1106ed9497c7","item":{"type":"CommandExecution","id":"exec-b6506190-29d9-4ddb-a36d-ed0b4bb6675f","process_id":"27553","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/qualify-all-accepted-v9 diff origin/main...HEAD -- cli/test/operation_view.test.ts && nl -ba /home/mike/nexus-wt/qualify-all-accepted-v9/cli/test/tui_maturity_e2e.test.ts | sed -n '75,105p' && git -C /home/mike/nexus-wt/qualify-all-accepted-v9 show origin/main:cli/src/operation_view.ts | sed -n '1,240p'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/qualify-all-accepted-v9 diff origin/main...HEAD -- cli/test/operation_view.test.ts && nl -ba /home/mike/nexus-wt/qualify-all-accepted-v9/cli/test/tui_maturity_e2e.test.ts | sed -n '75,105p' && git -C /home/mike/nexus-wt/qualify-all-accepted-v9 show origin/main:cli/src/operation_view.ts | sed -n '1,240p'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"diff --git a/cli/test/operation_view.test.ts b/cli/test/operation_view.test.ts\nindex ff891a92..70cc0029 100644\n--- a/cli/test/operation_view.test.ts\n+++ b/cli/test/operation_view.test.ts\n@@ -505,6 +505,73 @@ test(\"watch's multiple-operation list sanitizes persisted objectives\", (t) => {\n   assert.match(operationRows.join(\"\\n\"), /hostile.*forged line end<U\\+009C>/);\n });\n \n+test(\"ordinary status sanitizes blocked decision identifiers\", (t) => {\n+  const fixture = createCliFixture();\n+  t.after(fixture.cleanup);\n+  const file = saveFixture(fixture, \"op-cli-decision\");\n+  const record = JSON.parse(fs.readFileSync(file, \"utf8\"));\n+  record.operation.blocked.decisions[0].id = \"decision\\u001b]52;c;cGF5bG9hZA==\\u0007\\u001b[2J\";\n+  record.operation.blocked.decisions[0].options[0].id = \"option\\u001b]52;c;cGF5bG9hZA==\\u0007\\u001b[2J\";\n+  record.operation.units[1].status = \"BLOCKED\\u001b[2J\";\n+  fs.writeFileSync(file, JSON.stringify(record));\n+\n+  const result = runCli([\"operation\", \"status\", \"op-cli-decision\"], fixture);\n+  assert.equal(result.status, 0);\n+  assert.doesNotMatch(result.stdout + result.stderr, /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/);\n+});\n+\n+test(\"rejected decisions sanitize the failing decision id\", (t) => {\n+  const fixture = createCliFixture();\n+  t.after(fixture.cleanup);\n+  saveFixture(fixture, \"op-cli-reject\");\n+\n+  const result = runCli([\"operation\", \"decide\", \"op-cli-reject\", \"decision\\u001b[2J\", \"1\"], fixture);\n+  assert.equal(result.status, 2);\n+  assert.doesNotMatch(result.stdout + result.stderr, /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/);\n+});\n+\n+test(\"run sanitizes an operation id in its resume banner\", (t) => {\n+  const fixture = createCliFixture();\n+  t.after(fixture.cleanup);\n+  const spec = path.join(fixture.root, \"operation.json\");\n+  fs.writeFileSync(spec, JSON.stringify({ id: \"op-run\\u001b]52;c;cGF5bG9hZA==\\u0007\", objective: \"safe\", units: [{ id: \"u\", prompt: \"p\" }] }));\n+\n+  const result = runCli([\"operation\", \"run\", spec], fixture);\n+  assert.notEqual(result.status, 0);\n+  assert.doesNotMatch(result.stdout + result.stderr, /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/);\n+});\n+\n+test(\"status and watch sanitize invalid operation identifiers and event arguments\", (t) => {\n+  const fixture = createCliFixture();\n+  t.after(fixture.cleanup);\n+  saveFixture(fixture, \"op-cli-errors\");\n+  for (const args of [\n+    [\"operation\", \"status\", \"--dag\", \"missing\\u001b[2J\"],\n+    [\"operation\", \"status\", \"--dag\", \"--events\", \"bad\\u001b[2J\", \"op-cli-errors\"],\n+    [\"operation\", \"watch\", \"missing\\u001b[2J\"],\n+  ]) {\n+    const result = runCli(args, fixture);\n+    assert.notEqual(result.status, 0);\n+    assert.doesNotMatch(result.stdout + result.stderr, /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/);\n+  }\n+});\n+\n+test(\"run sanitizes resource and spec validation errors\", (t) => {\n+  const fixture = createCliFixture();\n+  t.after(fixture.cleanup);\n+  const cases = [\n+    { id: \"op-resource\", objective: \"safe\", units: [{ id: \"u\", prompt: \"p\" }], resources: [{ id: \"resource\\u001b[2J\", model: \"m\" }] },\n+    { id: \"op-dependency\", objective: \"safe\", units: [{ id: \"u\", prompt: \"p\", dependsOn: [\"missing\\u001b[2J\"] }] },\n+  ];\n+  for (const [index, value] of cases.entries()) {\n+    const spec = path.join(fixture.root, `invalid-${index}.json`);\n+    fs.writeFileSync(spec, JSON.stringify(value));\n+    const result = runCli([\"operation\", \"run\", spec], fixture);\n+    assert.notEqual(result.status, 0);\n+    assert.doesNotMatch(result.stdout + result.stderr, /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]/);\n+  }\n+});\n+\n test(\"terminal-safe rendering: operation text cannot emit control or escape sequences\", () => {\n   const op = state();\n   const evil = \"safe\\u001b]52;c;cGF5bG9hZA==\\u0007\\u001b[2Jafter\\nforged\\tline\\u001b[31m\";\n    75\t    });\n    76\t    assert.equal(code, 0, `driver failed:\\n${err}\\n${out}`);\n    77\t    const r = JSON.parse(out.trim().split(\"\\n\").pop()!);\n    78\t    const metricsFile = path.join(EVIDENCE, \"nexus_maturity_tui_2026-10-11.metrics.json\");\n    79\t    const runId = randomUUID();\n    80\t    let head = \"unknown\";\n    81\t    try {\n    82\t      head = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: ROOT, encoding: \"utf8\" }).trim();\n    83\t    } catch {}\n    84\t    fs.writeFileSync(metricsFile, JSON.stringify({ run: { id: runId, generatedAt: new Date().toISOString(), gitHead: head, workingTreeDirty: true, tuiSha256: sha256(TUI), sidecarSha256: sha256(SIDECAR) }, ...r }, null, 2) + \"\\n\");\n    85\t    fs.writeFileSync(\n    86\t      path.join(EVIDENCE, \"nexus_maturity_tui_2026-10-11.manifest.json\"),\n    87\t      JSON.stringify({ run: runId, files: Object.fromEntries([plan.cast, plan.transcript, metricsFile].map((f) => [path.basename(f), sha256(f)])) }, null, 2) + \"\\n\",\n    88\t    );\n    89\t    assert.ok(r.recording.monotonic, \"recording timestamps never go backwards\");\n    90\t    const commands = lines(plan.env.NEXUS_RECORD_COMMANDS);\n    91\t    const events = lines(plan.env.NEXUS_RECORD_EVENTS);\n    92\t\n    93\t    // 1. Slow inference: several spinner frames while no model output arrived; phase and elapsed time shown.\n    94\t    assert.ok(r.slow_inference.spinner_frames_seen.length >= 5, JSON.stringify(r.slow_inference));\n    95\t    assert.ok(r.slow_inference.thinking_shown && r.slow_inference.elapsed_shown, JSON.stringify(r.slow_inference));\n    96\t    assert.ok(r.slow_inference.busy_cpu_fraction < 0.25, `animating CPU ${r.slow_inference.busy_cpu_fraction}`);\n    97\t\n    98\t    // 2. Steering while busy: one steer command, queued then applied, seen by the model exactly once.\n    99\t    const steers = commands.filter((c) => c.type === \"steer\");\n   100\t    assert.equal(steers.length, 1);\n   101\t    assert.equal(steers[0].text, \"keep line 1 unchanged\");\n   102\t    assert.deepEqual(events.filter((e) => e.type === \"steer.ack\").map((e) => e.status), [\"queued\", \"applied\"]);\n   103\t    assert.equal(commands.filter((c) => c.type === \"prompt.submit\").length, 4, \"steering never became a second prompt\");\n   104\t    const second = (gw.requests[1] as any).messages.filter((m: any) => m.role === \"user\" && String(m.content).includes(\"keep line 1 unchanged\"));\n   105\t    assert.equal(second.length, 1);\n/**\n * Read-only projection of a durable operation for the operator: the unit DAG, resource eligibility, the open decision\n * and the event stream. Nothing here drives, mutates or resumes an operation — commands do that. The view is built from\n * a persisted `DurableOperationState` plus the same `ResourceRegistry` eligibility rules the scheduler uses, so a\n * displayed fact is never a second implementation of a scheduling decision.\n */\nimport type { DurableOperationState, OperationEvent, WorkUnit } from \"./core/operation.js\";\nimport { ResourceRegistry, type Eligibility, type ResourceConditionRecord, type ResourceDescriptor } from \"./core/resources.js\";\nimport { safeTerminal } from \"./ui.js\";\n\nexport const OPERATION_VIEW_SCHEMA_VERSION = 1;\n\nexport interface OperationViewUnit {\n  id: string;\n  title: string;\n  role?: string;\n  status: WorkUnit[\"status\"];\n  /** Why the unit is not running, when it is not. */\n  detail?: string;\n  dependsOn: string[];\n  required: boolean;\n  /** How many units must complete before this one is due. */\n  depth: number;\n  /** True when the unit already has a durable conversation to continue. */\n  durable: boolean;\n  runs: number;\n  assignment?: { resourceId: string; model: string; since: string };\n  parkedUntil?: string;\n  blocked?: { reason: string; decisionId: string };\n  result?: { summary: string; completedAt: string; resourceId: string; outcome: string };\n  /** Present when the unit's work was integrated into the operation branch. */\n  integration?: OperationViewIntegration;\n  /** Operator cap on the unit's prompt context, when set. */\n  contextBudget?: number;\n  /** The unit's last start-prompt estimate and the budget it was checked against. */\n  context?: { estimatedPromptTokens: number; budgetTokens: number; contextLimit: number; at: string };\n}\n\nexport interface OperationViewResource {\n  id: string;\n  provider: string;\n  model: string;\n  rank?: number;\n  capabilities: string[];\n  contextLength?: number;\n  taskClass?: string;\n  eligible: boolean;\n  /** Present when ineligible: the active conditions that block it. */\n  blocking?: Array<{ condition: string; reason: string; scope: string; eligibleAt?: string }>;\n  /** Earliest time the resource is expected back, when the block is temporary. */\n  eligibleAt?: string;\n}\n\nexport interface OperationViewIntegration {\n  commit: string;\n  integratedCommit: string;\n  mergedAt: string;\n  files: string[];\n  verification: string;\n}\n\nexport interface OperationViewGit {\n  integrationBranch: string;\n  integrationWorktree: string;\n}\n\nexport interface OperationViewDecisionOption {\n  id: string;\n  label: string;\n}\n\nexport interface OperationViewDecision {\n  id: string;\n  unitId: string;\n  cause: string;\n  question: string;\n  options: OperationViewDecisionOption[];\n  /** The command an operator can run to apply the decision. */\n  command: string;\n}\n\nexport interface OperationViewEvent {\n  type: OperationEvent[\"type\"];\n  at: string;\n  message: string;\n  unitId?: string;\n  resourceId?: string;\n}\n\nexport interface OperationViewDag {\n  nodes: Array<{ id: string; status: WorkUnit[\"status\"]; dependsOn: string[]; required: boolean }>;\n  edges: Array<{ from: string; to: string }>;\n  /** Longest chain of unfinished units; deterministic (ties broken by unit id). */\n  criticalPath: string[];\n  /** Dependency ids that name no unit in this operation. */\n  missingDependencies: string[];\n  /** Ids that participate in a dependency cycle (should be empty; shown rather than hidden). */\n  cycles: string[];\n}\n\nexport interface OperationView {\n  schemaVersion: typeof OPERATION_VIEW_SCHEMA_VERSION;\n  id: string;\n  objective: string;\n  status: DurableOperationState[\"status\"];\n  createdAt: string;\n  updatedAt: string;\n  /** True when no further transition is expected without an operator decision. */\n  terminal: boolean;\n  counts: {\n    total: number;\n    complete: number;\n    running: number;\n    ready: number;\n    blocked: number;\n    parked: number;\n    /** Units that cannot run yet because a dependency has not completed. */\n    waiting: number;\n  };\n  units: OperationViewUnit[];\n  resources: OperationViewResource[];\n  /** Present only for an isolated operation. */\n  git?: OperationViewGit;\n  /** Operator-created conversation snapshots, oldest first. */\n  checkpoints?: Array<{ unitId: string; name: string; at: string; messages: number }>;\n  wait?: { since: string; wakeAt: string; reason: string; parkedUnits: string[] };\n  decisions: OperationViewDecision[];\n  dag: OperationViewDag;\n  events: OperationViewEvent[];\n}\n\nexport interface WatchOptions {\n  /** Read the current persisted state. Called before every render. */\n  load: () => DurableOperationState;\n  /** Render one snapshot; defaults to `renderOperationView`. */\n  render?: (state: DurableOperationState) => string;\n  intervalMs?: number;\n  signal?: AbortSignal;\n  /** Injected for tests; defaults to a timer that resolves early on abort. */\n  sleep?: (ms: number, signal?: AbortSignal) => Promise<void>;\n  write?: (text: string) => void;\n  /** Clear the screen between snapshots (TTY only). Default false. */\n  clear?: boolean;\n  /** Stop after this many renders (tests); 0 means until terminal/aborted. */\n  maxRenders?: number;\n  /** Consecutive read failures tolerated before the watch gives up. Default 5. */\n  maxReadFailures?: number;\n  now?: () => number;\n}\n\nexport interface WatchResult {\n  renders: number;\n  stopped: \"terminal\" | \"aborted\" | \"limit\" | \"unreadable\";\n}\n\n/** A sleep that resolves early on abort and removes its listener on every path (no per-poll leak). */\nconst defaultSleep = (ms: number, signal?: AbortSignal) =>\n  new Promise<void>((resolve) => {\n    if (signal?.aborted) return resolve();\n    let timer: ReturnType<typeof setTimeout>;\n    const finish = () => {\n      clearTimeout(timer);\n      signal?.removeEventListener(\"abort\", finish);\n      resolve();\n    };\n    timer = setTimeout(finish, ms);\n    signal?.addEventListener(\"abort\", finish, { once: true });\n  });\n\n/**\n * Render an operation until it reaches a terminal state or the caller aborts. Read-only: the only input is `load`, so\n * this cannot drive, resume or mutate the operation. A transient read failure is reported and retried; after\n * `maxReadFailures` consecutive failures the watch gives up rather than pretending the operation vanished.\n */\nexport async function watchOperation(options: WatchOptions): Promise<WatchResult> {\n  const intervalMs = Math.max(0, options.intervalMs ?? 2_000);\n  const sleep = options.sleep ?? defaultSleep;\n  const write = options.write ?? ((text: string) => process.stdout.write(text));\n  const render = options.render ?? ((state) => renderOperationView(buildOperationView(state, { now: options.now?.() })));\n  let renders = 0;\n  let failures = 0;\n  for (;;) {\n    if (options.signal?.aborted) return { renders, stopped: \"aborted\" };\n    let state: DurableOperationState;\n    try {\n      state = options.load();\n      failures = 0;\n    } catch (error: any) {\n      failures += 1;\n      if (failures >= (options.maxReadFailures ?? 5)) return { renders, stopped: \"unreadable\" };\n      const reason = safeTerminal(String(error?.message ?? error)).replace(/[\\r\\n\\t]+/g, \" \");\n      write(`could not read the operation: ${reason}\\n`);\n      await sleep(intervalMs, options.signal);\n      continue;\n    }\n    if (options.clear) write(\"\\x1b[2J\\x1b[H\");\n    write(`${render(state)}\\n`);\n    renders += 1;\n    if (state.status === \"COMPLETE\" || state.status === \"CANCELLED\") return { renders, stopped: \"terminal\" };\n    if (options.maxRenders && renders >= options.maxRenders) return { renders, stopped: \"limit\" };\n    await sleep(intervalMs, options.signal);\n  }\n}\n\nexport interface OperationViewOptions {\n  /** Maximum events to include (newest kept). Default 20. */\n  events?: number;\n  /** Clock for eligibility; defaults to now. */\n  now?: number;\n}\n\nfunction detailFor(unit: WorkUnit): string | undefined {\n  switch (unit.status) {\n    case \"PARKED\":\n      return unit.parked\n        ? `${unit.parked.reason}${unit.parked.wakeAt ? `; wakes ${unit.parked.wakeAt}` : \"\"}`\n        : undefined;\n    case \"BLOCKED\":\n      return unit.blocked?.reason;\n    case \"WAITING_ON_DEPENDENCY\":\n      return unit.dependsOn.length ? `after ${unit.dependsOn.join(\", \")}` : undefined;\n    case \"COMPLETE\":\n      return unit.result ? `${unit.result.outcome} on ${unit.result.resourceId}` : undefined;\n    case \"RUNNING\":\n      return unit.assignment ? `${unit.assignment.resourceId} (${unit.assignment.model})` : \"assigned\";\n    default:\n      return undefined;\n  }\n}\n\n/** Depth = 1 + max(depth of dependencies); units in a cycle get the depth reached before the cycle was detected. */\nfunction unitDepths(units: WorkUnit[]): { depth: Map<string, number>; missing: string[]; cycles: string[] } {\n  const byId = new Map(units.map((unit) => [unit.id, unit]));\n  const depth = new Map<string, number>();\n  const stack: string[] = [];\n  const cycles = new Set<string>();\n  const missing = new Set<string>();\n\n  const visit = (id: string): number => {\n    const known = depth.get(id);\n","exit_code":0,"duration":{"secs":0,"nanos":43358}},"started_at_ms":1793228578063,"completed_at_ms":1793228578064}}
