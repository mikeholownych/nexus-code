mber;\\\\n  /** Lower is preferred. */\\\\n  rank?: number;\\\\n  /** Operator knowledge of how the provider scopes rate limits; default \\\\\\\"model\\\\\\\". */\\\\n  rateLimitScope?: \\\\\\\"model\\\\\\\" | \\\\\\\"account\\\\\\\" | \\\\\\\"provider\\\\\\\";\\\\n  /** X-Task-Class routing hint sent with requests. */\\\\n  taskClass?: string;\\\\n}\\\"}]},\\\"match_line\\\":39,\\\"match_lines\\\":[39]}]}}\"}],\"isError\":false}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18432-af9c-7882-80ce-70535521cb1b","create_time":1793219551.9292805}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
