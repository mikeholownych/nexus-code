args}: {p.returncode}: {p.stderr}\")\n    return p\n\nwith tempfile.TemporaryDirectory(prefix='nexus-pathspec-probe-') as td:\n    home = os.path.join(td, 'home'); os.makedirs(home)\n    env = dict(os.environ, HOME=home, GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL=os.devnull)\n    root = os.path.join(td, 'repo'); os.makedirs(root)\n    git(root, 'init', '-q')\n    git(root, 'config', 'user.email', 'probe@example.invalid'); git(root, 'config', 'user.name', 'probe')\n    magic = ':(exclude)ignored.bin'\n    with open(os.path.join(root, '.gitignore'), 'w') as f: f.write(magic+'\\n')\n    git(root, 'add', '.gitignore'); git(root, 'commit', '-qm', 'base')\n    with open(os.path.join(root, magic), 'w') as f: f.write('payload\\n')\n    for spec in (magic, ':(literal)'+magic, ':(literal,top)'+magic):\n        git(root, 'reset', '-q', 'HEAD')\n        p = git(root, 'add', '-f', '--', spec, check=False)\n        ls = git(root, 'ls-files', '-z').stdout.split('\\0')\n        print(f'{spec!r}: add_status={p.returncode}, staged_exact={magic in ls}, stderr={p.stderr.strip()}')\nPY"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"':(exclude)ignored.bin': add_status=0, staged_exact=True, stderr=\n':(literal):(exclude)ignored.bin': add_status=0, staged_exact=True, stderr=\n':(literal,top):(exclude)ignored.bin': add_status=0, staged_exact=True, stderr=\n","exit_code":0,"duration":{"secs":0,"nanos":36078010}},"started_at_ms":1793216910142,"completed_at_ms":1793216910179}}
