ntimeError(f\"git {args}: {p.returncode}: {p.stderr}\")\n    return p\n\nwith tempfile.TemporaryDirectory(prefix='nexus-pathspec-probe-') as td:\n    home = os.path.join(td, 'home')\n    os.makedirs(home)\n    env = dict(os.environ, HOME=home, GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL=os.devnull)\n    root = os.path.join(td, 'repo')\n    os.makedirs(root)\n    git(root, 'init', '-q')\n    git(root, '-c', 'user.name=probe', '-c', 'user.email=probe@example.invalid', 'config', 'core.excludesFile', os.path.join(root, '.gitignore'))\n    with open(os.path.join(root, '.gitignore'), 'w') as f: f.write('ignored.bin\\n')\n    with open(os.path.join(root, 'ignored.bin'), 'w') as f: f.write('payload\\n')\n    for spec in (':(literal):(exclude)ignored.bin', ':(literal,exclude)ignored.bin', ':(exclude,literal)ignored.bin'):\n        git(root, 'reset', '-q', '--hard', check=False)\n        p = git(root, 'add', '-f', '--', spec, check=False)\n        staged = git(root, 'ls-files', '--stage', '-z').stdout.split('\\0')\n        print(f'{spec}: add_status={p.returncode}, staged={staged}, stderr={p.stderr.strip()}')\nPY"}],"source":"unified_exec_startup","status":"completed","aggregated_output":":(literal):(exclude)ignored.bin: add_status=128, staged=[''], stderr=fatal: pathspec ':(literal):(exclude)ignored.bin' did not match any files\n:(literal,exclude)ignored.bin: add_status=0, staged=['100644 82429e218ab17231e31611745764b7d47bef7f1a 0\\t.gitignore', ''], stderr=\n:(exclude,literal)ignored.bin: add_status=0, staged=[''], stderr=\n","exit_code":0,"duration":{"secs":0,"nanos":34715410}},"started_at_ms":1793216864880,"completed_at_ms":1793216864916}}
