{"type":"file-history-delta","messageId":"5e82d12a-1df7-458c-8d1e-1a73ecfcfc4e","snapshotMessageId":"abca5e7e-c323-4cf5-8f4e-c8b6a618b236","trackingPath":"/tmp/claude-1000/-home-mike-nexus-code/43bcbb67-2cff-4fa8-a05e-f8aa598df73b/scratchpad/rev770.md","backup":{"backupFileName":null,"version":1,"backupTime":"2026-11-24T05:09:29.109Z","realParentDir":"/tmp/claude-1000/-home-mike-nexus-code/43bcbb67-2cff-4fa8-a05e-f8aa598df73b/scratchpad"},"timestamp":"2026-11-24T05:09:29.110Z"}
