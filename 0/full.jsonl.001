unmeasured=\\\"the connection advertises no request counting\\\"\\n[context_admission] step=8 request_id=cd78e090-250f-44b6-80bd-6ec6cc8c9e33 state=admitted estimated_tokens=5213 completion_reserve=8192 tool_response_reserve=4096 limit=65536 compacted=false messages=16\\n[token_count] step=8 request_id=cd78e090-250f-44b6-80bd-6ec6cc8c9e33 source=client_estimate prompt_tokens=5213 client_estimate=5213 context_limit=65536 (client_default) output_allowance=8192 (client_default) tool_headroom_policy=4096 unmeasured=\\\"the connection advertises no request counting\\\"\\n[context_admission] step=9 request_id=4f1b5c22-b66a-4005-baa7-56d3a7934e86 state=admitted estimated_tokens=5292 completion_reserve=8192 tool_response_reserve=4096 limit=65536 compacted=false messages=18\\n[token_count] step=9 request_id=4f1b5c22-b66a-4005-baa7-56d3a7934e86 source=client_estimate prompt_tokens=5292 client_estimate=5292 context_limit=65536 (client_default) output_allowance=8192 (client_default) tool_headroom_policy=4096 unmeasured=\\\"the connection advertises no request counting\\\"\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","create_time":1793654164.6306784}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
