{"timestamp":"2026-11-21T23:27:56.699Z","ordinal":38281,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","item":{"type":"CommandExecution","id":"exec-e1fe129d-0777-453a-b101-f2b82747d304","process_id":"39888","command":["/usr/bin/zsh","-lc","sed -n '1,260p' scripts/terminal-acceptance/test-scope-procs.sh && rg -n \"sleep|timeout|wait|NEXUS_TEST\" scripts/terminal-acceptance/test-scope-procs.sh"],"cwd":"file:///home/mike/nexus-wt/p10-02-tool-invocation-budget","parsed_cmd":[{"type":"read","cmd":"sed -n '1,260p' scripts/terminal-acceptance/test-scope-procs.sh","name":"test-scope-procs.sh","path":"scripts/terminal-acceptance/test-scope-procs.sh"},{"type":"search","cmd":"rg -n 'sleep|timeout|wait|NEXUS_TEST' scripts/terminal-acceptance/test-scope-procs.sh","query":"sleep|timeout|wait|NEXUS_TEST","path":"test-scope-procs.sh"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n\nHERE=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"$HERE/scope-procs.sh\"\ntmp=\"$(mktemp -d)\"\ncleanup() { python3 -c 'import shutil,sys; shutil.rmtree(sys.argv[1])' \"$tmp\"; }\ntrap cleanup EXIT\nmkdir -p \"$tmp/bin\" \"$tmp/cgroup/user.slice/test.scope\"\n\ncat > \"$tmp/bin/systemctl\" <<'STUB'\n#!/usr/bin/env bash\nset -euo pipefail\n[[ \"${SYSTEMCTL_FAIL:-0}\" == 1 ]] && exit 1\nproperty=\"\"\nfor arg in \"$@\"; do\n  case \"$arg\" in\n    --property=*) property=\"${arg#--property=}\" ;;\n  esac\ndone\ncat \"${FIXTURE_STATE_DIR:?}/$property\"\nSTUB\nchmod +x \"$tmp/bin/systemctl\"\nPATH=\"$tmp/bin:$PATH\"\nexport PATH FIXTURE_STATE_DIR=\"$tmp/state\" NEXUS_CGROUP_ROOT=\"$tmp/cgroup\"\nmkdir -p \"$FIXTURE_STATE_DIR\"\n\nset_state() {\n  printf '%s\\n' \"$1\" > \"$FIXTURE_STATE_DIR/LoadState\"\n  printf '%s\\n' \"$2\" > \"$FIXTURE_STATE_DIR/ActiveState\"\n  printf '%s\\n' \"$3\" > \"$FIXTURE_STATE_DIR/ControlGroup\"\n}\nexpect_count() {\n  local want=\"$1\" got\n  got=\"$(nexus_terminal_scope_procs test)\"\n  [[ \"$got\" == \"$want\" ]] || { echo \"expected $want processes, got $got\" >&2; exit 1; }\n}\nexpect_unavailable() {\n  if nexus_terminal_scope_procs test >/dev/null 2>&1; then\n    echo \"expected unavailable measurement to fail closed\" >&2\n    exit 1\n  fi\n}\n\nset_state loaded active /user.slice/test.scope\n: > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_count 0\nprintf '101\\n202\\n' > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_count 2\n\npython3 -c 'import os,sys; os.unlink(sys.argv[1])' \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_unavailable\n: > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nchmod 000 \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_unavailable\nchmod 600 \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nprintf 'not-a-pid\\n' > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_unavailable\npython3 -c 'import os,sys; os.unlink(sys.argv[1])' \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nmkdir \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_unavailable\npython3 -c 'import os,sys; os.rmdir(sys.argv[1])' \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\n\nset_state loaded inactive ''\nexpect_count 0\nset_state not-found inactive ''\nexpect_count 0\n\nset_state loaded active ''\nexpect_unavailable\nset_state loaded active /user.slice/../escape\nexpect_unavailable\nset_state loaded active /user.slice/test.scope\nSYSTEMCTL_FAIL=1 expect_unavailable\n\nmkdir -p \"$tmp/evidence\"\nwrite_evidence_fixture() {\n  MODE=\"$1\" RC=\"${2:-v1.0.0-rc.1}\" EVIDENCE_DIR=\"$tmp/evidence\" node --input-type=module <<'NODE'\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst dir = process.env.EVIDENCE_DIR;\nconst sha = (data) => createHash(\"sha256\").update(data).digest(\"hex\");\nconst contents = {\n  \"mock.log\": \"mock request log\",\n  \"answers.tsv\": \"checks\",\n  \"exits.tsv\": \"measurements\",\n};\nif (process.env.MODE !== \"no_screenshots\") contents[\"approval.png\"] = \"approval screenshot\";\nif (!new Set([\"no_screenshots\", \"one_screenshot\"]).has(process.env.MODE)) contents[\"post-exit.png\"] = \"post exit screenshot\";\nfor (const [name, body] of Object.entries(contents)) fs.writeFileSync(path.join(dir, name), body);\nconst fileNames = {\n  mockLog: \"mock.log\",\n  answers: \"answers.tsv\",\n  exits: \"exits.tsv\",\n};\nif (contents[\"approval.png\"]) fileNames.approvalScreenshot = \"approval.png\";\nif (contents[\"post-exit.png\"]) fileNames.postExitScreenshot = \"post-exit.png\";\nconst files = Object.fromEntries(Object.entries(fileNames).map(([key, name]) => [key, { path: name, sha256: sha(fs.readFileSync(path.join(dir, name))) }]));\nfor (const terminal of [\"xterm\", \"kitty\", \"tmux-gnome\", \"vscode\", \"gnome\"]) {\n  for (const size of [\"80x24\", \"40x14\", \"200x60\"]) {\n    const cell = `${terminal}-${size}`;\n    const measurement = (launch) => ({\n      launch,\n      exitStatus: 0,\n      sttyRestored: true,\n      survivors: 0,\n      scopeMeasurement: process.env.MODE === \"unavailable\" && cell === \"xterm-80x24\" && launch === \"main\" ? \"unavailable\" : \"verified\",\n      at: \"2026-10-19T00:00:00Z\",\n    });\n    const record = {\n      cell,\n      attempt: 1,\n      rc: process.env.RC,\n      packageManifestSha256: \"a\".repeat(64),\n      measured: [measurement(\"main\"), measurement(\"no_color\")],\n      scenarios: { approveToolRounds: [0, 1], stream: 1, sleepTool: 1 },\n      checks: Object.fromEntries([\"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"7\"].map((check) => [check, { result: \"PASS\", note: \"\" }])),\n      files,\n    };\n    const output = `${JSON.stringify(record, null, 2)}\\n`;\n    const file = path.join(dir, `cell-${cell}.attempt-1.json`);\n    fs.writeFileSync(file, output);\n    fs.writeFileSync(`${file}.sha256`, `${sha(output)}  ${path.basename(file)}\\n`);\n  }\n}\nNODE\n}\nwrite_evidence_fixture unavailable\nif node \"$HERE/summarize.mjs\" \"$tmp/evidence\" --rc v1.0.0-rc.1 --manifest-sha256 \"$(printf 'a%.0s' {1..64})\" > \"$tmp/unavailable-summary.log\" 2>&1; then\n  echo \"summary gate accepted an unavailable process-scope measurement\" >&2\n  exit 1\nfi\ngrep -q 'safety check 5 FAIL (scope measurement unavailable)' \"$tmp/unavailable-summary.log\"\nwrite_evidence_fixture verified\n# Only exact numeric attempt filenames count; similarly prefixed artifacts are ignored.\nprintf '%s\\n' '{}' > \"$tmp/evidence/cell-xterm-80x24.attempt-not-a-number.json\"\nprintf '%s\\n' '{}' > \"$tmp/evidence/cell-xterm-80x24.attempt-2.json.backup\"\nnode \"$HERE/summarize.mjs\" \"$tmp/evidence\" --rc v1.0.0-rc.1 --manifest-sha256 \"$(printf 'a%.0s' {1..64})\" > \"$tmp/verified-summary.log\"\ngrep -q 'manual matrix gate for v1.0.0-rc.1 .*: PASS' \"$tmp/verified-summary.log\"\ngrep -q '^| xterm-80x24 | 1 | PASS | PASS' \"$tmp/verified-summary.log\"\n\n# DEC-18 waives screenshot artifacts, but a supplied screenshot pair remains hash-checked.\nwrite_evidence_fixture no_screenshots\nnode \"$HERE/summarize.mjs\" \"$tmp/evidence\" --rc v1.0.0-rc.1 --manifest-sha256 \"$(printf 'a%.0s' {1..64})\" > \"$tmp/no-screenshots-summary.log\"\ngrep -q 'manual matrix gate for v1.0.0-rc.1 .*: PASS' \"$tmp/no-screenshots-summary.log\"\nwrite_evidence_fixture one_screenshot\nif node \"$HERE/summarize.mjs\" \"$tmp/evidence\" --rc v1.0.0-rc.1 --manifest-sha256 \"$(printf 'a%.0s' {1..64})\" > \"$tmp/one-screenshot-summary.log\" 2>&1; then\n  echo \"summary gate accepted an incomplete optional screenshot pair\" >&2\n  exit 1\nfi\ngrep -q 'optional screenshots must be supplied as a pair' \"$tmp/one-screenshot-summary.log\"\nwrite_evidence_fixture no_screenshots v1.0.1-rc.1\nif node \"$HERE/summarize.mjs\" \"$tmp/evidence\" --rc v1.0.1-rc.1 --manifest-sha256 \"$(printf 'a%.0s' {1..64})\" > \"$tmp/non-v100-no-screenshots.log\" 2>&1; then\n  echo \"summary gate applied the v1.0.0 screenshot waiver to another release series\" >&2\n  exit 1\nfi\ngrep -q 'required screenshots are missing for this release series' \"$tmp/non-v100-no-screenshots.log\"\n\n# Drive the actual manual runner in a PTY with a synthetic installed package to prove that\n# the interactive run can be recorded without prompting for screenshot paths. This is a\n# tooling regression fixture only and never counts as a manual qualification cell.\nrunner=\"$tmp/runner\"\nmkdir -p \"$runner/package/bin\" \"$runner/bin\" \"$runner/out\"\ncat > \"$runner/package/VERSION\" <<'EOF'\nv1.0.0-rc.1\nEOF\ncat > \"$runner/package/bin/nexus\" <<'EOF'\n#!/usr/bin/env bash\npackage=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\nversion=\"$(cat \"$package/VERSION\")\"\nif [[ \"${1:-}\" == --version ]]; then echo \"Nexus $version\"; exit 0; fi\n: > \"$HOME/mock.log\"\necho 'synthetic terminal runner fixture'\nEOF\nchmod +x \"$runner/package/bin/nexus\"\n(cd \"$runner/package\" && sha256sum VERSION bin/nexus > MANIFEST.sha256)\ncat > \"$runner/bin/systemd-run\" <<'EOF'\n#!/usr/bin/env bash\nset -euo pipefail\nwhile [[ $# -gt 0 && \"$1\" != -- ]]; do shift; done\n[[ $# -gt 0 ]] || exit 2\nshift\nexec \"$@\"\nEOF\ncat > \"$runner/bin/systemctl\" <<'EOF'\n#!/usr/bin/env bash\nset -euo pipefail\nproperty=\"\"\nfor arg in \"$@\"; do [[ \"$arg\" == --property=* ]] && property=\"${arg#--property=}\"; done\ncase \"$property\" in\n  LoadState) echo not-found ;;\n  ActiveState|ControlGroup) echo \"\" ;;\n  *) exit 2 ;;\nesac\nEOF\nchmod +x \"$runner/bin/systemd-run\" \"$runner/bin/systemctl\"\nRUNNER=\"$HERE/run-cell.sh\" FIXTURE=\"$runner\" python3 - <<'PY'\nimport fcntl, glob, hashlib, json, os, pty, select, struct, termios, time, sys\nfixture = os.environ[\"FIXTURE\"]\nout = os.path.join(fixture, \"out\")\nenv = os.environ.copy()\nenv.update({\n    \"HOME\": os.path.join(fixture, \"home\"),\n    \"TMPDIR\": fixture,\n    \"PATH\": os.path.join(fixture, \"package\", \"bin\") + os.pathsep + os.path.join(fixture, \"bin\") + os.pathsep + env[\"PATH\"],\n    \"TERM\": \"xterm\", \"XTERM_VERSION\": \"XTerm fixture\", \"COLUMNS\": \"80\", \"LINES\": \"24\",\n})\nos.makedirs(env[\"HOME\"], exist_ok=True)\n\ndef update_package_version(version):\n    package = os.path.join(fixture, \"package\")\n    with open(os.path.join(package, \"VERSION\"), \"w\", encoding=\"utf-8\") as f: f.write(version + \"\\n\")\n    paths = [\"VERSION\", \"bin/nexus\"]\n    with open(os.path.join(package, \"MANIFEST.sha256\"), \"w\", encoding=\"utf-8\") as f:\n        for relative in paths:\n            with open(os.path.join(package, relative), \"rb\") as source:\n                digest = hashlib.sha256(source.read()).hexdigest()\n            f.write(f\"{digest}  {relative}\\n\")\n\ndef run_cell(version, screenshot_inputs):\n    update_package_version(version)\n    pid, fd = pty.fork()\n    if pid == 0:\n        time.sleep(0.1)\n        os.execve(os.environ[\"RUNNER\"], [os.environ[\"RUNNER\"], \"--rc\", version, \"--terminal\", \"xterm\", \"--size\", \"80x24\", \"--out\", out], env)\n    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack(\"HHHH\", 24, 80, 0, 0))\n    payload = \"\\n\\n\" + \"PASS\\n\\n\" * 7 + \"test-operator\\n\" + screenshot_inputs\n    os.write(fd, payload.encode())\n    captured = bytearray()\n    deadline = time.monotonic() + 45\n    status = None\n    while time.monotonic() < deadline:\n        ready, _, _ = select.select([fd], [], [], 0.2)\n        if ready:\n            try: captured.extend(os.read(fd, 65536))\n            except OSError: pass\n        done, status = os.waitpid(pid, os.WNOHANG)\n        if done:\n            while True:\n                ready, _, _ = select.select([fd], [], [], 0)\n                if not ready: break\n                try: captured.extend(os.read(fd, 65536))\n                except OSError: break\n            break\n    if status is None:\n        os.kill(pid, 9)\n        os.waitpid(pid, 0)\n        raise SystemExit(f\"run-cell fixture timed out for {version}\")\n    text = captured.decode(errors=\"replace\")\n    if status != 0:\n        print(text[-6000:], file=sys.stderr)\n        raise SystemExit(f\"run-cell fixture exited with wait status {status} for {version}\")\n    return text\n\nv100 = run_cell(\"v1.0.0-rc.1\", \"n\\n\")\nif \"Attach optional approval and post-exit screenshots?\" not in v100:\n    raise SystemExit(\"v1.0.0 runner did not expose the optional screenshot choice\")\nif \"approval-panel screenshot path:\" in v100 or \"post-exit screenshot path:\" in v100:\n118:      scenarios: { approveToolRounds: [0, 1], stream: 1, sleepTool: 1 },\n226:        time.sleep(0.1)\n239:        done, status = os.waitpid(pid, os.WNOHANG)\n249:        os.waitpid(pid, 0)\n254:        raise SystemExit(f\"run-cell fixture exited with wait status {status} for {version}\")\n","exit_code":0,"duration":{"secs":0,"nanos":781777050}},"started_at_ms":1795303675917,"completed_at_ms":1795303676699}}
