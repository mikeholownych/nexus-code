Settings();\n  const temperature = options.temperature ? parseFloat(options.temperature) : 0.2;\n  const shell = options.shell || operatorSetting(\"LOCAL_HARNESS_SHELL\") || process.env.LOCAL_HARNESS_SHELL || \"bash\";\n  const dryRun = Boolean(options.dryRun);\n  const readOnly = Boolean(options.readOnly);\n  const yes = Boolean(options.yes);\n  const approve = Boolean(options.approve);\n  const modeOption = options.mode ? String(options.mode).trim().toLowerCase() : undefined;\n  const envMode = (operatorSetting(\"NEXUS_APPROVAL_MODE\") || process.env.NEXUS_APPROVAL_MODE)?.trim().toLowerCase();\n\n  let approvalMode: ApprovalMode;\n  let fullAccess = Boolean(options.fullAccess);\n\n  if (readOnly || modeOption === \"read-only\") {\n    // An explicit read-only request wins over --yes, --approve and --full-access on the same command line.\n    approvalMode = \"read-only\";\n    fullAccess = false;\n  } else if (yes) {\n    approvalMode = \"auto\";\n    fullAccess = true;\n  } else if (approve) {\n    approvalMode = \"review\";\ncli/test/observation_identity.test.ts\ncli/test/execution_tracking.test.ts\ncli/test/recovery_role_actions.test.ts\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","create_time":1795301120.0736969}},"metadata":{"history_sequence":16474,"sampled_through_sequence":16469,"client_authored":false,"fallback_token_limit_override":12000}}
