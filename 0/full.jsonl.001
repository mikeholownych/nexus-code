{"timestamp":"2026-11-20T05:00:41.282Z","ordinal":31243,"type":"token_usage_record","payload":{"thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a1f730-5dda-7050-8748-e755b63ef781","session_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","root_turn_id":"01a1f730-5dda-7050-8748-e755b63ef781","response_id":"resp_05793ea695c2aa2c016affd3f1d1ac87d296c902f3f196ce22","usage":{"input_tokens":71863,"cached_input_tokens":70912,"cache_write_input_tokens":0,"output_tokens":369,"reasoning_output_tokens":255,"total_tokens":72232},"turn_token_usage":{"input_tokens":30653401,"cached_input_tokens":30356864,"cache_write_input_tokens":0,"output_tokens":65738,"reasoning_output_tokens":38361,"total_tokens":30719139},"thread_token_usage":{"input_tokens":655488948,"cached_input_tokens":648210432,"cache_write_input_tokens":0,"output_tokens":1405814,"reasoning_output_tokens":745318,"total_tokens":656894762}}}
{"timestamp":"2026-11-20T05:00:41.441Z","ordinal":31244,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a1f730-5dda-7050-8748-e755b63ef781","item":{"type":"CommandExecution","id":"exec-ea092fdf-7460-4a7d-b941-dfbbd6f97ec9","process_id":"5205","command":["/usr/bin/zsh","-lc","sed -n '1,220p' cli/src/session.ts; sed -n '320,420p' cli/src/session.ts; sed -n '1,140p' cli/src/core/fork_start.ts; sed -n '1,190p' cli/test/session_fork_start.test.ts"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"read","cmd":"sed -n '1,220p' cli/src/session.ts","name":"session.ts","path":"cli/src/session.ts"},{"type":"read","cmd":"sed -n '320,420p' cli/src/session.ts","name":"session.ts","path":"cli/src/session.ts"},{"type":"read","cmd":"sed -n '1,140p' cli/src/core/fork_start.ts","name":"fork_start.ts","path":"cli/src/core/fork_start.ts"},{"type":"read","cmd":"sed -n '1,190p' cli/test/session_fork_start.test.ts","name":"session_fork_start.test.ts","path":"cli/test/session_fork_start.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { randomBytes } from \"node:crypto\";\nimport { ChatMessage } from \"./types.js\";\nimport {\n  DurableTaskState,\n  DurableStateManager,\n  TaskRecoveryOptions,\n  TaskRecoveryResult,\n  CURRENT_STATE_SCHEMA_VERSION,\n  CorruptStateError,\n  UnsupportedSchemaVersionError,\n} from \"./core/state.js\";\nimport { withStateStoreGuard } from \"./core/state_store_guard.js\";\nimport { WorkspacePath } from \"./core/workspace_path.js\";\nimport { protectArchivedMessages } from \"./core/persistence_protection.js\";\nimport { insertedBlockPresent, isCompactionRecord } from \"./core/compaction_record.js\";\nimport { appendLinesDurably, readArchiveLines, type ArchiveRead, ensurePrivateDir, writePrivateFile } from \"./core/durable_file.js\";\nimport { persistableEndpoint } from \"./core/endpoint_identity.js\";\n\n// Re-export core state primitives\nexport * from \"./core/state.js\";\n\nexport class AmbiguousSessionResumeError extends Error {\n  public readonly prefix: string;\n  public readonly candidates: string[];\n  constructor(prefix: string, candidates: string[]) {\n    super(`Ambiguous session ID prefix '${prefix}'. Matches: ${candidates.join(\", \")}`);\n    this.name = \"AmbiguousSessionResumeError\";\n    this.prefix = prefix;\n    this.candidates = candidates;\n  }\n}\n\n/**\n * Upgraded SessionData envelope conforming to DurableTaskState (PERS-001..PERS-004).\n */\nexport interface SessionData extends DurableTaskState {\n  id: string;\n  workspace: string;\n  model: string;\n}\n\nexport interface SessionIndexEntry {\n  id: string;\n  cleanId: string;\n  title: string;\n  updatedAt: string;\n  workspace: string;\n  messageCount: number;\n  mtime: number;\n  pinned?: boolean;\n}\n\nexport interface SessionIndexData {\n  version: 1;\n  updatedAt: string;\n  sessions: Record<string, SessionIndexEntry>;\n}\n\n/** Where interactive sessions are saved unless a directory is given. */\nexport function defaultSessionsDir(): string {  if (process.env.NEXUS_STATE_DIR) {\n    return path.join(process.env.NEXUS_STATE_DIR, \"sessions\");\n  }\n  return path.join(os.homedir(), \".nexus\", \"sessions\");\n}\n\n/** Cryptographically unpredictable base36 suffix; the length stays inside the\n *  egress classifier's session-id whitelist (session_\\d{8}_\\d{6}_[a-z0-9]{1,8}). */\nfunction randomBase36Suffix(length: number): string {\n  const alphabet = \"REDACTED\";\n  let suffix = \"\";\n  while (suffix.length < length) {\n    for (const byte of randomBytes(length)) {\n      // Rejection sampling keeps the base-36 mapping unbiased (36 * 7 = 252).\n      if (byte >= 252) continue;\n      if (suffix.length < length) suffix += alphabet[byte % 36];\n    }\n  }\n  return suffix;\n}\n\n/** The longest prefix of `messages` no longer than `n` that does not end inside a tool exchange (a call without all its results). */\nfunction completeExchangePrefix(messages: ChatMessage[], n: number): number {\n  let end = n;\n  while (end > 1) {\n    let owner = end - 1;\n    while (owner > 0 && messages[owner].role === \"tool\") owner--;\n    const head = messages[owner];\n    const calls = head.role === \"assistant\" ? head.tool_calls ?? [] : [];\n    if (!calls.length) return end;\n    const answered = new Set(messages.slice(owner + 1, end).filter((x) => x.role === \"tool\").map((x) => x.tool_call_id));\n    if (calls.every((c) => answered.has(c.id))) return end;\n    end = owner;\n  }\n  return end;\n}\n\nexport class SessionManager {\n  private sessionsDir: string;\n  private stateManager: DurableStateManager;\n  private readonly selectedWorkspace: (() => WorkspacePath) | undefined;\n\n  constructor(customDir?: string, selectedWorkspace?: () => WorkspacePath) {\n    this.sessionsDir = customDir || defaultSessionsDir();\n    this.selectedWorkspace = selectedWorkspace;\n    ensurePrivateDir(this.sessionsDir);\n    this.stateManager = new DurableStateManager({ baseDir: this.sessionsDir });\n    this.sessionsDir = this.stateManager.getBaseDir();\n  }\n\n  public getStateManager(): DurableStateManager {\n    return this.stateManager;\n  }\n\n  public generateSessionId(): string {\n    const d = new Date();\n    const pad = (n: number) => n.toString().padStart(2, \"0\");\n    const timestamp = `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}_${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;\n    return `session_${timestamp}_${randomBase36Suffix(8)}`;\n  }\n\n  /**\n   * Atomically saves session data conforming to the DurableTaskState envelope.\n   */\n  public saveSession(session: Partial<SessionData> & { id: string }, workspacePath?: WorkspacePath): void {\n    return withStateStoreGuard(this.sessionsDir, () => this.saveSessionLocked(session, workspacePath));\n  }\n\n  private saveSessionLocked(session: Partial<SessionData> & { id: string }, workspacePath?: WorkspacePath): void {\n    const selectedWorkspace = this.currentSelectedWorkspace();\n    if (workspacePath && (!selectedWorkspace || !selectedWorkspace.matches(workspacePath.value))) {\n      throw new Error(\"Session workspace identity is not selected by the application\");\n    }\n    if (selectedWorkspace) this.stateManager.setWorkspacePaths([selectedWorkspace]);\n    const taskId = session.taskId || session.id;\n    const sessionId = session.sessionId || session.id;\n    const workspace = session.workspace || session.workspacePath || process.cwd();\n\n    const fullState: SessionData = {\n      schemaVersion: session.schemaVersion || CURRENT_STATE_SCHEMA_VERSION,\n      taskId,\n      sessionId,\n      id: sessionId,\n      title: session.title || \"Active Session\",\n      workspacePath: workspace,\n      workspace,\n      model: session.model || \"default\",\n      ...(session.endpoint ? { endpoint: persistableEndpoint(session.endpoint) } : {}),\n      createdAt: session.createdAt || new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n      status: session.status || \"in_progress\",\n      activePlan: session.activePlan || [],\n      milestones: session.milestones || [],\n      worktreeBinding: session.worktreeBinding || null,\n      candidateId: session.candidateId || null,\n      candidateIdentity: session.candidateIdentity || null,\n      validationReceipts: session.validationReceipts || [],\n      currentOperation: session.currentOperation || null,\n      // Present-or-absent, not defaulted: an explicit null is a recorded \"none\", and absence must not invent a value.\n      ...(session.providerRecovery !== undefined ? { providerRecovery: session.providerRecovery } : {}),\n      ...(session.operation !== undefined ? { operation: session.operation } : {}),\n      ...(session.changeBaseline !== undefined ? { changeBaseline: session.changeBaseline } : {}),\n      messages: session.messages || [],\n      ...(session.pinned !== undefined ? { pinned: session.pinned } : {}),\n      ...(session.unverifiedChangesPending !== undefined ? { unverifiedChangesPending: session.unverifiedChangesPending } : {}),\n      durableNotes: session.durableNotes,\n      compactionProvenance: session.compactionProvenance,\n      cognitiveRouting: session.cognitiveRouting,\n      tokenStats: session.tokenStats,\n      ...(session.lastTurn !== undefined ? { lastTurn: session.lastTurn } : {}),\n      ...(session.objective !== undefined ? { objective: session.objective } : {}),\n      ...(session.findings !== undefined ? { findings: session.findings } : {}),\n      ...(session.verificationConfigAttempts !== undefined ? { verificationConfigAttempts: session.verificationConfigAttempts } : {}),\n      ...(session.history !== undefined ? { history: session.history } : {}),\n      ...(session.forkedFrom !== undefined ? { forkedFrom: session.forkedFrom } : {}),\n    };\n\n    this.stateManager.saveTaskState(fullState, selectedWorkspace ? [selectedWorkspace] : []);\n    const committed = this.stateManager.loadTaskState(taskId, undefined, selectedWorkspace ? [selectedWorkspace] : []);\n    this.updateIndexEntry({\n      id: sessionId,\n      cleanId: taskId.replace(/\\.json$/, \"\"),\n      title: committed.title || \"Active Session\",\n      updatedAt: committed.updatedAt || new Date().toISOString(),\n      workspace,\n      messageCount: committed.messages.length,\n      mtime: Date.now(),\n      pinned: Boolean(committed.pinned),\n    });\n  }\n\n  /**\n   * Resolves a session ID by exact match or unique prefix (REQ-PER-104).\n   * Throws AmbiguousSessionResumeError if a prefix matches multiple sessions.\n   * Returns null if no matching session is found.\n   */\n  public resolveResumeId(prefix: string): string | null {\n    return withStateStoreGuard(this.sessionsDir, () => this.resolveResumeIdLocked(prefix));\n  }\n\n  private resolveResumeIdLocked(prefix: string): string | null {\n    const cleanId = prefix.replace(/\\.json$/, \"\");\n    if (!cleanId) return null;\n\n    // 1. Exact match check against session file on disk\n    const exactFilePath = path.join(this.sessionsDir, `${cleanId}.json`);\n    if (fs.existsSync(exactFilePath)) {\n      return cleanId;\n    }\n\n    if (!fs.existsSync(this.sessionsDir)) return null;\n\n    // 2. Gather candidates for prefix matching\n    const candidates = new Set<string>();\n    const files = fs.readdirSync(this.sessionsDir);\n    for (const file of files) {\n      if (!file.endsWith(\".json\") || file === \"index.json\" || file.startsWith(\".corrupt-\")) continue;\n      const id = file.replace(/\\.json$/, \"\");\n      if (\n        err instanceof CorruptStateError ||\n        err instanceof UnsupportedSchemaVersionError ||\n        err instanceof AmbiguousSessionResumeError\n      ) {\n        throw err;\n      }\n      return null;\n    }\n  }\n\n  /**\n   * RD-6: forks a saved session into a new id holding its conversation up to `atMessage` (default: all of it). The\n   * source is only read. The cut backs up to the last complete tool exchange. Compactions whose summary is still in the\n   * kept conversation keep their record and archive lines (copied verbatim, so resume's audit still verifies them);\n   * a compaction whose summary the cut removed is left out, rather than letting resume \"undo\" it into history the\n   * operator did not choose. The objective ledger is carried only by a fork of the whole conversation: it describes\n   * the source's later state, which a truncated fork never reached.\n   */\n  public forkSession(sourceId: string, options: { atMessage?: number; newId?: string } = {}): { id: string; sourceId: string; atMessage: number; compactions: number } {\n    return withStateStoreGuard(this.sessionsDir, () => {\n      const source = this.loadSession(sourceId);\n      if (!source) throw new Error(`Session not found: ${sourceId}`);\n      // A worktree binding names one checkout. Copying it would put two sessions in that checkout (and let either's\n      // merge or discard pull it from under the other); creating a second checkout is not a fork's decision.\n      if (source.worktreeBinding) {\n        throw new Error(`Session ${source.id} is bound to the worktree ${source.worktreeBinding.worktreePath} (branch ${source.worktreeBinding.branch}); a fork would share it with the original, so nothing was forked. Continue the original with --resume, or start a new session.`);\n      }\n      const total = source.messages.length;\n      const asked = options.atMessage ?? total;\n      if (!Number.isInteger(asked) || asked < 1 || asked > total) throw new Error(`The fork point must be a whole number between 1 and ${total}.`);\n      const atMessage = completeExchangePrefix(source.messages, asked);\n      const whole = atMessage === total;\n      const messages = source.messages.slice(0, atMessage);\n      const id = options.newId ?? this.generateSessionId();\n      if (!/^[A-Za-z0-9._-]{1,160}$/.test(id) || id === \".\" || id === \"..\") throw new Error(\"The new session id is not a safe persistence name.\");\n      if (this.stateManager.hasTaskState(id) || fs.existsSync(this.archivedHistoryPath(id))) throw new Error(`Session ${id} already exists.`);\n\n      const committed: string[] = Array.isArray((source.history as any)?.committedCompactions) ? (source.history as any).committedCompactions.filter((c: unknown): c is string => typeof c === \"string\") : [];\n      const read = this.readArchivedHistory(source.id, new Set(committed));\n      const kept = committed.filter((c) => {\n        const record = read.byCompaction?.get(c)?.record;\n        return !isCompactionRecord(record) || insertedBlockPresent(record, messages);\n      });\n      // The archive goes first: a record never names a compaction whose originals are not already on disk.\n      const keep = new Set(kept);\n      const lines: string[] = [];\n      let archivedMessages = 0;\n      let raw = \"\";\n      try { raw = fs.readFileSync(this.archivedHistoryPath(source.id), \"utf8\"); } catch {}\n      for (const line of raw.split(\"\\n\")) {\n        if (!line.trim()) continue;\n        let parsed: { compactionId?: string };\n        try { parsed = JSON.parse(line); } catch { continue; }\n        if (parsed.compactionId !== undefined && !keep.has(parsed.compactionId)) continue;\n        lines.push(line);\n        archivedMessages++;\n      }\n      if (lines.length) appendLinesDurably(this.archivedHistoryPath(id), lines);\n\n      const at = new Date().toISOString();\n      this.saveSession({\n        id,\n        title: `Fork of ${source.title || \"session\"}`.slice(0, 120),\n        workspace: source.workspace,\n        model: source.model,\n        ...(source.endpoint ? { endpoint: source.endpoint } : {}),\n        messages,\n        history: { complete: kept.length === 0, compactions: kept.length, archivedMessages, committedCompactions: kept } as any,\n        ...(source.findings !== undefined ? { findings: source.findings } : {}),\n        ...(source.durableNotes !== undefined ? { durableNotes: source.durableNotes } : {}),\n        ...(source.activePlan ? { activePlan: source.activePlan } : {}),\n        ...(whole && source.objective !== undefined ? { objective: source.objective } : {}),\n        forkedFrom: { sessionId: source.id, atMessage, at },\n      });\n      return { id, sourceId: source.id, atMessage, compactions: kept.length };\n    });\n  }\n\n  /** Archive of messages context compaction replaced in this session (redacted JSON lines beside the record). */\n  public archivedHistoryPath(sessionId: string): string {\n    if (!/^[A-Za-z0-9._-]{1,160}$/.test(sessionId)) throw new Error(\"Session identity is not a safe persistence name\");\n    return path.join(this.sessionsDir, `${sessionId}.history.jsonl`);\n  }\n\n  /** Where the complete diff of one file operation in this session is kept (redacted; mode 0600). */\n  public operationDiffPath(sessionId: string, name: string): string {\n    if (!/^[A-Za-z0-9._-]{1,160}$/.test(sessionId) || !/^[A-Za-z0-9._-]{1,160}$/.test(name)) {\n      throw new Error(\"Session identity is not a safe persistence name\");\n    }\n    return path.join(this.sessionsDir, `${sessionId}.diffs`, `${name}.diff`);\n  }\n\n  /**\n   * Appends the originals one compaction replaced, durably (fsync), tagged with the compaction's id. Written before any\n   * record names the compaction as committed (see core/durable_file.ts).\n   */\n  public appendArchivedHistory(sessionId: string, messages: ChatMessage[], compactionId?: string, record?: unknown): void {\n    if (!messages.length) return;\n    withStateStoreGuard(this.sessionsDir, () => {\n      const at = new Date().toISOString();\n/**\n * RD-6: starting a run or session in a fork of a saved session (`--fork-session <id> [--fork-at <n>]`). The source is\n * only read; the fork gets a new id that the caller then resumes.\n */\nimport type { SessionManager } from \"../session.js\";\n\nexport interface ForkStartOptions {\n  forkSession?: string;\n  forkAt?: string;\n  resume?: string | boolean;\n}\n\n/** The refusal for an unusable flag combination, or undefined when the flags are fine. */\nexport function forkStartError(options: ForkStartOptions): string | undefined {\n  const resuming = options.resume !== undefined && options.resume !== false;\n  if (options.forkSession !== undefined && resuming) {\n    return \"--fork-session cannot be combined with --resume: it is ambiguous whether to continue a session in place or in a copy (use one of them)\";\n  }\n  if (options.forkAt !== undefined && options.forkSession === undefined) return \"--fork-at needs --fork-session\";\n  if (options.forkAt !== undefined && !/^[1-9]\\d*$/.test(options.forkAt)) return \"--fork-at must be a whole number of messages, 1 or more\";\n  return undefined;\n}\n\n/** Forks the named session; throws with a clear message for an unknown source, a bad fork point or a worktree-bound source. */\nexport function startFork(sessions: SessionManager, options: ForkStartOptions): { id: string; sourceId: string; atMessage: number } {\n  const bad = forkStartError(options);\n  if (bad) throw new Error(bad);\n  if (options.forkSession === undefined) throw new Error(\"--fork-session needs a session id\");\n  const forked = sessions.forkSession(options.forkSession, options.forkAt === undefined ? {} : { atMessage: Number(options.forkAt) });\n  return { id: forked.id, sourceId: forked.sourceId, atMessage: forked.atMessage };\n}\n\n/** The line that tells the operator which session they are now in. */\nexport function forkStartNotice(f: { id: string; sourceId: string; atMessage: number }): string {\n  return `Forked ${f.sourceId} at message ${f.atMessage} into ${f.id}; continuing in the fork (the original is unchanged).`;\n}\n/**\n * RD-6 (start flag): `--fork-session <id> [--fork-at <n>]` on `nexus run`, `nexus repl` and the top-level launch.\n * The source session is never mutated; an unknown source, a bad fork point and `--resume` together are refused with a\n * clear message and exit code 2; a session bound to a worktree is refused (the fork must not share a checkout).\n */\nimport { test, describe, before, after } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawnSync, execFileSync } from \"node:child_process\";\nimport { runWorktreeCommand } from \"../src/worktrunk/command.js\";\nimport { fileURLToPath } from \"node:url\";\nimport { SessionManager } from \"../src/session.js\";\nimport type { ChatMessage } from \"../src/types.js\";\nimport { WorkspacePath } from \"../src/core/workspace_path.js\";\nimport { routeSlash } from \"../src/slash/router.js\";\nimport type { SlashHost, SlashReply } from \"../src/slash/catalog.js\";\nimport { forkStartError, startFork } from \"../src/core/fork_start.js\";\n\nconst CLI = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../dist/index.js\");\nconst skip = fs.existsSync(CLI) ? false : \"cli/dist is not built\";\n\nlet dir = \"\";\nlet ws = \"\";\nbefore(() => {\n  dir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-forkstart-\")));\n  ws = path.join(dir, \"ws\");\n  fs.mkdirSync(ws);\n  // A real repository with a named worktree: a binding is only accepted for one the repository's registry knows.\n  const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: ws, stdio: \"ignore\" });\n  git(\"init\", \"-q\", \"-b\", \"main\");\n  git(\"config\", \"user.email\", \"t@example.com\");\n  git(\"config\", \"user.name\", \"T\");\n  git(\"config\", \"commit.gpgsign\", \"false\");\n  fs.writeFileSync(path.join(ws, \"a.txt\"), \"one\\n\");\n  git(\"add\", \".\");\n  git(\"commit\", \"-q\", \"-m\", \"init\");\n  const home = path.join(dir, \"wt-home\");\n  fs.mkdirSync(home);\n  const made = runWorktreeCommand([\"switch\", \"-c\", \"feature/x\", \"--no-copy\"], { cwd: ws, home });\n  assert.equal(made.success, true, made.output);\n});\nafter(() => { fs.rmSync(dir, { recursive: true, force: true }); });\n\nconst m = (role: ChatMessage[\"role\"], content: string): ChatMessage => ({ role, content } as ChatMessage);\nconst mk = (name: string) => new SessionManager(path.join(dir, name), () => WorkspacePath.fromSelectedWorkspace(ws));\nconst seed = (s: SessionManager, id: string, extra: Record<string, unknown> = {}) =>\n  s.saveSession({ id, title: \"Original\", workspace: ws, model: \"m\", messages: [m(\"system\", \"sys\"), m(\"user\", \"q1\"), m(\"assistant\", \"a1\"), m(\"user\", \"q2\"), m(\"assistant\", \"a2\")], ...extra } as any);\nconst digest = (s: SessionManager, id: string) => createHash(\"sha256\").update(fs.readFileSync(path.join(s.getSessionsDir(), `${id}.json`))).digest(\"hex\");\nconst listing = (s: SessionManager) => fs.readdirSync(s.getSessionsDir()).sort();\nconst binding = { taskId: \"t1\", worktreePath: path.join(dir, \"ws\", \".nexus\", \"worktrees\", \"feature-x\"), branch: \"feature/x\", kind: \"named\" as const, bindingVersion: 1, createdAt: new Date().toISOString() };\n\ndescribe(\"forkStartError (flag validation)\", () => {\n  test(\"--fork-session with --resume is refused as ambiguous\", () => {\n    assert.match(forkStartError({ forkSession: \"a\", resume: \"b\" }) ?? \"\", /--fork-session cannot be combined with --resume/);\n    assert.match(forkStartError({ forkSession: \"a\", resume: true }) ?? \"\", /ambiguous/);\n  });\n  test(\"--fork-at needs --fork-session and a positive whole number\", () => {\n    assert.match(forkStartError({ forkAt: \"3\" }) ?? \"\", /--fork-at needs --fork-session/);\n    for (const bad of [\"0\", \"-1\", \"2.5\", \"abc\", \"\"]) assert.match(forkStartError({ forkSession: \"a\", forkAt: bad }) ?? \"\", /--fork-at must be a whole number/, bad);\n  });\n  test(\"valid combinations pass\", () => {\n    assert.equal(forkStartError({}), undefined);\n    assert.equal(forkStartError({ forkSession: \"a\" }), undefined);\n    assert.equal(forkStartError({ forkSession: \"a\", forkAt: \"3\" }), undefined);\n    assert.equal(forkStartError({ resume: \"b\" }), undefined);\n    assert.equal(forkStartError({ resume: false, forkSession: \"a\" }), undefined);\n  });\n});\n\ndescribe(\"startFork\", () => {\n  test(\"forks into a new id and leaves the source byte for byte alone\", () => {\n    const s = mk(\"ok\");\n    seed(s, \"src\");\n    const before = digest(s, \"src\");\n    const r = startFork(s, { forkSession: \"src\", forkAt: \"3\" });\n    assert.notEqual(r.id, \"src\");\n    assert.equal(r.sourceId, \"src\");\n    assert.equal(s.loadSession(r.id)!.messages.length, r.atMessage);\n    assert.equal(s.loadSession(r.id)!.forkedFrom?.sessionId, \"src\");\n    assert.equal(digest(s, \"src\"), before);\n  });\n  test(\"an unknown source is a clear error and creates nothing\", () => {\n    const s = mk(\"unknown\");\n    seed(s, \"src\");\n    const files = listing(s);\n    assert.throws(() => startFork(s, { forkSession: \"nosuch\" }), /Session not found: nosuch/);\n    assert.deepEqual(listing(s), files);\n  });\n  test(\"a fork point beyond the conversation is a clear error\", () => {\n    const s = mk(\"range\");\n    seed(s, \"src\");\n    assert.throws(() => startFork(s, { forkSession: \"src\", forkAt: \"99\" }), /fork point must be a whole number between 1 and 5/);\n  });\n  test(\"a session bound to a worktree is refused: nothing is created and the source is untouched\", () => {\n    const s = mk(\"bound\");\n    seed(s, \"src\", { worktreeBinding: binding });\n    const files = listing(s);\n    const before = digest(s, \"src\");\n    assert.throws(() => startFork(s, { forkSession: \"src\" }), /bound to the worktree .*feature\\/x.*would share it/s);\n    assert.throws(() => s.forkSession(\"src\"), /bound to the worktree/);\n    assert.deepEqual(listing(s), files);\n    assert.equal(digest(s, \"src\"), before);\n  });\n});\n\ndescribe(\"nexus run --fork-session (through dist)\", () => {\n  const home = () => fs.mkdtempSync(path.join(dir, \"home-\"));\n  const nexus = (state: string, ...args: string[]) =>\n    spawnSync(process.execPath, [CLI, ...args], { encoding: \"utf8\", env: { ...process.env, HOME: state, XDG_CONFIG_HOME: path.join(state, \".config\"), NEXUS_STATE_DIR: state }, timeout: 60_000 });\n  // `run --resume` (and so the fork behind --fork-session) reads the task store.\n  const sessions = (state: string) => new SessionManager(path.join(state, \"tasks\"), () => WorkspacePath.fromSelectedWorkspace(ws));\n\n  test(\"an unknown source exits 2 with the reason\", { skip }, () => {\n    const state = home();\n    const r = nexus(state, \"run\", \"--fork-session\", \"nosuch\", \"-w\", ws, \"go\");\n    assert.equal(r.status, 2, `${r.stdout}${r.stderr}`);\n    assert.match(r.stderr, /error: .*Session not found: nosuch/);\n  });\n  test(\"--fork-session with --resume exits 2 as ambiguous\", { skip }, () => {\n    const r = nexus(home(), \"run\", \"--fork-session\", \"a\", \"--resume\", \"b\", \"-w\", ws, \"go\");\n    assert.equal(r.status, 2, `${r.stdout}${r.stderr}`);\n    assert.match(r.stderr, /--fork-session cannot be combined with --resume/);\n  });\n  test(\"an invalid --fork-at exits 2; --fork-at alone exits 2\", { skip }, () => {\n    const a = nexus(home(), \"run\", \"--fork-session\", \"a\", \"--fork-at\", \"0\", \"-w\", ws, \"go\");\n    assert.equal(a.status, 2, `${a.stdout}${a.stderr}`);\n    assert.match(a.stderr, /--fork-at must be a whole number/);\n    const b = nexus(home(), \"run\", \"--fork-at\", \"2\", \"-w\", ws, \"go\");\n    assert.equal(b.status, 2);\n    assert.match(b.stderr, /--fork-at needs --fork-session/);\n  });\n  test(\"a fork point past the end exits 2 with the range\", { skip }, () => {\n    const state = home();\n    seed(sessions(state), \"src\");\n    const r = nexus(state, \"run\", \"--fork-session\", \"src\", \"--fork-at\", \"99\", \"-w\", ws, \"go\");\n    assert.equal(r.status, 2, `${r.stdout}${r.stderr}`);\n    assert.match(r.stderr, /between 1 and 5/);\n  });\n  test(\"a worktree-bound source exits 2 and creates nothing\", { skip }, () => {\n    const state = home();\n    const s = sessions(state);\n    seed(s, \"src\", { worktreeBinding: binding });\n    const files = listing(s);\n    const r = nexus(state, \"run\", \"--fork-session\", \"src\", \"-w\", ws, \"go\");\n    assert.equal(r.status, 2, `${r.stdout}${r.stderr}`);\n    assert.match(r.stderr, /bound to the worktree/);\n    // (The run's own startup checkpoint, task-*.json, is not a fork.)\n    assert.deepEqual(listing(s).filter((f) => !/^task-/.test(f)), files);\n  });\n  test(\"nexus repl --fork-session starts the REPL in the fork (the cut conversation), source untouched\", { skip }, () => {\n    const state = home();\n    const s = new SessionManager(path.join(state, \"sessions\"), () => WorkspacePath.fromSelectedWorkspace(ws));\n    seed(s, \"src\");\n    const before = digest(s, \"src\");\n    const r = spawnSync(process.execPath, [CLI, \"repl\", \"--fork-session\", \"src\", \"--fork-at\", \"3\", \"-w\", ws, \"-e\", \"http://127.0.0.1:9/v1\", \"-m\", \"m\", \"-y\"], {\n      encoding: \"utf8\", input: \"/exit\\n\", timeout: 60_000, env: { ...process.env, HOME: state, XDG_CONFIG_HOME: path.join(state, \".config\"), NEXUS_STATE_DIR: state },\n    });\n    assert.equal(r.status, 0, `${r.stdout}${r.stderr}`);\n    const id = /Forked src at message 3 into (session_\\w+)/.exec(r.stderr)?.[1];\n    assert.ok(id, r.stderr);\n    assert.match(r.stdout, new RegExp(`session ${id} . 3 messages`));\n    assert.equal(s.loadSession(id!)!.forkedFrom?.sessionId, \"src\");\n    assert.equal(digest(s, \"src\"), before);\n  });\n  test(\"nexus repl --fork-session also reports an unknown source with exit 2\", { skip }, () => {\n    const r = nexus(home(), \"repl\", \"--fork-session\", \"nosuch\", \"-w\", ws);\n    assert.equal(r.status, 2, `${r.stdout}${r.stderr}`);\n    assert.match(r.stderr, /Session not found: nosuch/);\n  });\n  test(\"the top-level launch takes the flag too, and refuses it with --resume\", { skip }, () => {\n    const a = nexus(home(), \"--fork-session\", \"nosuch\", \"--repl\", \"-w\", ws);\n    assert.equal(a.status, 2, `${a.stdout}${a.stderr}`);\n    assert.match(a.stderr, /Session not found: nosuch/);\n    const b = nexus(home(), \"--fork-session\", \"a\", \"--resume\", \"b\", \"--repl\", \"-w\", ws);\n    assert.equal(b.status, 2);\n    assert.match(b.stderr, /ambiguous/);\n  });\n});\n\ndescribe(\"/fork while working in a worktree\", () => {\n  test(\"is refused before anything is saved or created\", async () => {\n    const s = mk(\"slash\");\n    seed(s, \"src\");\n    const files = listing(s);\n    const calls: string[] = [];\n    const host = {\n      sessionId: () => \"src\",\n","exit_code":0,"duration":{"secs":0,"nanos":43082}},"started_at_ms":1795150841440,"completed_at_ms":1795150841441}}
{"timestamp":"2026-11-20T05:00:41.571Z","ordinal":31245,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1f754-06e3-7962-9dee-549e5873b279","call_id":"call_08bb1e8c006d4361adce8109cd85b487","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 6945)\nTotal output lines: 547\n\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { randomBytes } from \"node:crypto\";\nimport { ChatMessage } from \"./types.js\";\nimport {\n  DurableTaskState,\n  DurableStateManager,\n  TaskRecoveryOptions,\n  TaskRecoveryResult,\n  CURRENT_STATE_SCHEMA_VERSION,\n  CorruptStateError,\n  UnsupportedSchemaVersionError,\n} from \"./core/state.js\";\nimport { withStateStoreGuard } from \"./core/state_store_guard.js\";\nimport { WorkspacePath } from \"./core/workspace_path.js\";\nimport { protectArchivedMessages } from \"./core/persistence_protection.js\";\nimport { insertedBlockPresent, isCompactionRecord } from \"./core/compaction_record.js\";\nimport { appendLinesDurably, readArchiveLines, type ArchiveRead, ensurePrivateDir, writePrivateFile } from \"./core/durable_file.js\";\nimport { persistableEndpoint } from \"./core/endpoint_identity.js\";\n\n// Re-export core state primitives\nexport * from \"./core/state.js\";\n\nexport class AmbiguousSessionResumeError extends Error {\n  public readonly prefix: string;\n  public readonly candidates: string[];\n  constructor(prefix: string, candidates: string[]) {\n    super(`Ambiguous session ID prefix '${prefix}'. Matches: ${candidates.join(\", \")}`);\n    this.name = \"AmbiguousSessionResumeError\";\n    this.prefix = prefix;\n    this.candidates = candidates;\n  }\n}\n\n/**\n * Upgraded SessionData envelope conforming to DurableTaskState (PERS-001..PERS-004).\n */\nexport interface SessionData extends DurableTaskState {\n  id: string;\n  workspace: string;\n  model: string;\n}\n\nexport interface SessionIndexEntry {\n  id: string;\n  cleanId: string;\n  title: string;\n  updatedAt: string;\n  workspace: string;\n  messageCount: number;\n  mtime: number;\n  pinned?: boolean;\n}\n\nexport interface SessionIndexData {\n  version: 1;\n  updatedAt: string;\n  sessions: Record<string, SessionIndexEntry>;\n}\n\n/** Where interactive sessions are saved unless a directory is given. */\nexport function defaultSessionsDir(): string {  if (process.env.NEXUS_STATE_DIR) {\n    return path.join(process.env.NEXUS_STATE_DIR, \"sessions\");\n  }\n  return path.join(os.homedir(), \".nexus\", \"sessions\");\n}\n\n/** Cryptographically unpredictable base36 suffix; the length stays inside the\n *  egress classifier's session-id whitelist (session_\\d{8}_\\d{6}_[a-z0-9]{1,8}). */\nfunction randomBase36Suffix(length: number): string {\n  const alphabet = \"REDACTED\";\n  let suffix = \"\";\n  while (suffix.length < length) {\n    for (const byte of randomBytes(length)) {\n      // Rejection sampling keeps the base-36 mapping unbiased (36 * 7 = 252).\n      if (byte >= 252) continue;\n      if (suffix.length < length) suffix += alphabet[byte % 36];\n    }\n  }\n  return suffix;\n}\n\n/** The longest prefix of `messages` no longer than `n` that does not end inside a tool exchange (a call without all its results). */\nfunction completeExchangePrefix(messages: ChatMessage[], n: number): number {\n  let end = n;\n  while (end > 1) {\n    let owner = end - 1;\n    while (owner > 0 && messages[owner].role === \"tool\") owner--;\n    const head = messages[owner];\n    const calls = head.role === \"assistant\" ? head.tool_calls ?? [] : [];\n    if (!calls.length) return end;\n    const answered = new Set(messages.slice(owner + 1, end).filter((x) => x.role === \"tool\").map((x) => x.tool_call_id));\n    if (calls.every((c) => answered.has(c.id))) return end;\n    end = owner;\n  }\n  return end;\n}\n\nexport class SessionManager {\n  private sessionsDir: string;\n  private stateManager: DurableStateManager;\n  private readonly selectedWorkspace: (() => WorkspacePath) | undefined;\n\n  constructor(customDir?: string, selectedWorkspace?: () => WorkspacePath) {\n    this.sessionsDir = customDir || defaultSessionsDir();\n    this.selectedWorkspace = selectedWorkspace;\n    ensurePrivateDir(this.sessionsDir);\n    this.stateManager = new DurableStateManager({ baseDir: this.sessionsDir });\n    this.sessionsDir = this.stateManager.getBaseDir();\n  }\n\n  public getStateManager(): DurableStateManager {\n    return this.stateManager;\n  }\n\n  public generateSessionId(): string {\n    const d = new Date();\n    const pad = (n: number) => n.toString().padStart(2, \"0\");\n    const timestamp = `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}_${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;\n    return `session_${timestamp}_${randomBase36Suffix(8)}`;\n  }\n\n  /**\n   * Atomically saves session data conforming to the DurableTaskState envelope.\n   */\n  public saveSession(session: Partial<SessionData> & { id: string }, workspacePath?: WorkspacePath): void {\n    return withStateStoreGuard(this.sessionsDir, () => this.saveSessionLocked(session, workspacePath));\n  }\n\n  private saveSessionLocked(session: Partial<SessionData> & { id: string }, workspacePath?: WorkspacePath): void {\n    const selectedWorkspace = this.currentSelectedWorkspace();\n    if (workspacePath && (!selectedWorkspace || !selectedWorkspace.matches(workspacePath.value))) {\n      throw new Error(\"Session workspace identity is not selected by the application\");\n    }\n    if (selectedWorkspace) this.stateManager.setWorkspacePaths([selectedWorkspace]);\n    const taskId = session.taskId || session.id;\n    const sessionId = session.sessionId || session.id;\n    const workspace = session.workspace || session.workspacePath || process.cwd();\n\n    const fullState: SessionData = {\n      schemaVersion: session.schemaVersion || CURRENT_STATE_SCHEMA_VERSION,\n      taskId,\n      sessionId,\n      id: sessionId,\n      title: session.title || \"Active Session\",\n      workspacePath: workspace,\n      workspace,\n      model: session.model || \"default\",\n      ...(session.endpoint ? { endpoint: persistableEndpoint(session.endpoint) } : {}),\n      createdAt: session.createdAt || new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n      status: session.status || \"in_progress\",\n      activePlan: session.activePlan || [],\n      milestones: session.milestones || [],\n      worktreeBinding: session.worktreeBinding || null,\n      candidateId: session.candidateId || null,\n      candidateIdentity: session.candidateIdentity || null,\n      validationReceipts: session.validationReceipts || [],\n      currentOperation: session.currentOperation || null,\n      // Present-or-absent, not defaulted: an explicit null is a recorded \"none\", and absence must not invent a value.\n      ...(session.providerRecovery !== undefined ? { providerRecovery: session.providerRecovery } : {}),\n      ...(session.operation !== undefined ? { operation: session.operation } : {}),\n      ...(session.changeBaseline !== undefined ? { changeBaseline: session.changeBaseline } : {}),\n      messages: session.messages || [],\n      ...(session.pinned !== undefined ? { pinned: session.pinned } : {}),\n      ...(session.unverifiedChangesPending !== undefined ? { unverifiedChangesPending: session.unverifiedChangesPending } : {}),\n      durableNotes: session.durableNotes,\n      compactionProvenance: session.compactionProvenance,\n      cognitiveRouting: session.cognitiveRouting,\n      tokenStats: session.tokenStats,\n      ...(session.lastTurn !== undefined ? { lastTurn: session.lastTurn } : {}),\n      ...(session.objective !== undefined ? { objective: session.objective } : {}),\n      ...(session.findings !== undefined ? { findings: session.findings } : {}),\n      ...(session.verificationConfigAttempts !== undefined ? { verificationConfigAttempts: session.verificationConfigAttempts } : {}),\n      ...(session.history !== undefined ? { history: session.history } : {}),\n      ...(session.forkedFrom !== undefined ? { forkedFrom: session.forkedFrom } : {}),\n    };\n\n    this.stateManager.saveTaskState(fullState, selectedWorkspace ? [selectedWorkspace] : []);\n    const committed = this.stateManager.loadTaskState(taskId, undefined, selectedWorkspace ? [selectedWorkspace] : []);\n    this.updateIndexEntry({\n      id: sessionId,\n      cleanId: taskId.replace(/\\.json$/, \"\"),\n      title: committed.title || \"Active Session\",\n      updatedAt: committed.updatedAt || new Date().toISOString(),\n      workspace,\n      messageCount: committed.messages.length,\n      mtime: Date.now(),\n      pinned: Boolean(committed.pinned),\n    });\n  }\n\n  /**\n   * Resolves a session ID by exact match or unique prefix (REQ-PER-104).\n   * Throws AmbiguousSessionResumeError if a prefix matches multiple sessions.\n   * Returns null if no matching session is found.\n   */\n  public resolveResumeId(prefix: string): string | null {\n    return withStateStoreGuard(this.sessionsDir, () => this.resolveResumeIdLocked(prefix));\n  }\n\n  private resolveResumeIdLocked(prefix: string): string | null {\n    const cleanId = prefix.replace(/\\.json$/, \"\");\n    if (!cleanId) return null;\n\n    // 1. Exact match check against session file on disk\n    const exactFilePath = path.join(this.sessionsDir, `${cleanId}.json`);\n    if (fs.existsSync(exactFilePath)) {\n      return cleanId;\n    }\n\n    if (!fs.existsSync(this.sessionsDir)) return null;\n\n    // 2. Gather candidates for prefix matching\n    const candidates = new Set<string>();\n    const files = fs.readdirSync(this.sessionsDir);\n    for (const file of files) {\n      if (!file.endsWith(\".json\") || file === \"index.json\" || file.startsWith(\".corrupt-\")) continue;\n      const id = file.replace(/\\.json$/, \"\");\n      if (\n        err instanceof CorruptStateError ||\n        err instanceof UnsupportedSchemaVersionError ||\n        err instanceof AmbiguousSessionResumeError\n      ) {\n        throw err;\n      }\n      return null;\n    }\n  }\n\n  /**\n   * RD-6: forks a saved session into a new id holding its conversation up to `atMessage` (default: all of it). The\n   * source is only read. The cut backs up to the last complete tool exchange. Compactions whose summary is still in the\n   * kept conversation keep their record and archive lines (copied verbatim, so resume's audit still verifies them);\n   * a compaction whose summary the cut removed is left out, rather than letting resume …1945 tokens truncated…rict\";\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawnSync, execFileSync } from \"node:child_process\";\nimport { runWorktreeCommand } from \"../src/worktrunk/command.js\";\nimport { fileURLToPath } from \"node:url\";\nimport { SessionManager } from \"../src/session.js\";\nimport type { ChatMessage } from \"../src/types.js\";\nimport { WorkspacePath } from \"../src/core/workspace_path.js\";\nimport { routeSlash } from \"../src/slash/router.js\";\nimport type { SlashHost, SlashReply } from \"../src/slash/catalog.js\";\nimport { forkStartError, startFork } from \"../src/core/fork_start.js\";\n\nconst CLI = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../dist/index.js\");\nconst skip = fs.existsSync(CLI) ? false : \"cli/dist is not built\";\n\nlet dir = \"\";\nlet ws = \"\";\nbefore(() => {\n  dir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-forkstart-\")));\n  ws = path.join(dir, \"ws\");\n  fs.mkdirSync(ws);\n  // A real repository with a named worktree: a binding is only accepted for one the repository's registry knows.\n  const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: ws, stdio: \"ignore\" });\n  git(\"init\", \"-q\", \"-b\", \"main\");\n  git(\"config\", \"user.email\", \"t@example.com\");\n  git(\"config\", \"user.name\", \"T\");\n  git(\"config\", \"commit.gpgsign\", \"false\");\n  fs.writeFileSync(path.join(ws, \"a.txt\"), \"one\\n\");\n  git(\"add\", \".\");\n  git(\"commit\", \"-q\", \"-m\", \"init\");\n  const home = path.join(dir, \"wt-home\");\n  fs.mkdirSync(home);\n  const made = runWorktreeCommand([\"switch\", \"-c\", \"feature/x\", \"--no-copy\"], { cwd: ws, home });\n  assert.equal(made.success, true, made.output);\n});\nafter(() => { fs.rmSync(dir, { recursive: true, force: true }); });\n\nconst m = (role: ChatMessage[\"role\"], content: string): ChatMessage => ({ role, content } as ChatMessage);\nconst mk = (name: string) => new SessionManager(path.join(dir, name), () => WorkspacePath.fromSelectedWorkspace(ws));\nconst seed = (s: SessionManager, id: string, extra: Record<string, unknown> = {}) =>\n  s.saveSession({ id, title: \"Original\", workspace: ws, model: \"m\", messages: [m(\"system\", \"sys\"), m(\"user\", \"q1\"), m(\"assistant\", \"a1\"), m(\"user\", \"q2\"), m(\"assistant\", \"a2\")], ...extra } as any);\nconst digest = (s: SessionManager, id: string) => createHash(\"sha256\").update(fs.readFileSync(path.join(s.getSessionsDir(), `${id}.json`))).digest(\"hex\");\nconst listing = (s: SessionManager) => fs.readdirSync(s.getSessionsDir()).sort();\nconst binding = { taskId: \"t1\", worktreePath: path.join(dir, \"ws\", \".nexus\", \"worktrees\", \"feature-x\"), branch: \"feature/x\", kind: \"named\" as const, bindingVersion: 1, createdAt: new Date().toISOString() };\n\ndescribe(\"forkStartError (flag validation)\", () => {\n  test(\"--fork-session with --resume is refused as ambiguous\", () => {\n    assert.match(forkStartError({ forkSession: \"a\", resume: \"b\" }) ?? \"\", /--fork-session cannot be combined with --resume/);\n    assert.match(forkStartError({ forkSession: \"a\", resume: true }) ?? \"\", /ambiguous/);\n  });\n  test(\"--fork-at needs --fork-session and a positive whole number\", () => {\n    assert.match(forkStartError({ forkAt: \"3\" }) ?? \"\", /--fork-at needs --fork-session/);\n    for (const bad of [\"0\", \"-1\", \"2.5\", \"abc\", \"\"]) assert.match(forkStartError({ forkSession: \"a\", forkAt: bad }) ?? \"\", /--fork-at must be a whole number/, bad);\n  });\n  test(\"valid combinations pass\", () => {\n    assert.equal(forkStartError({}), undefined);\n    assert.equal(forkStartError({ forkSession: \"a\" }), undefined);\n    assert.equal(forkStartError({ forkSession: \"a\", forkAt: \"3\" }), undefined);\n    assert.equal(forkStartError({ resume: \"b\" }), undefined);\n    assert.equal(forkStartError({ resume: false, forkSession: \"a\" }), undefined);\n  });\n});\n\ndescribe(\"startFork\", () => {\n  test(\"forks into a new id and leaves the source byte for byte alone\", () => {\n    const s = mk(\"ok\");\n    seed(s, \"src\");\n    const before = digest(s, \"src\");\n    const r = startFork(s, { forkSession: \"src\", forkAt: \"3\" });\n    assert.notEqual(r.id, \"src\");\n    assert.equal(r.sourceId, \"src\");\n    assert.equal(s.loadSession(r.id)!.messages.length, r.atMessage);\n    assert.equal(s.loadSession(r.id)!.forkedFrom?.sessionId, \"src\");\n    assert.equal(digest(s, \"src\"), before);\n  });\n  test(\"an unknown source is a clear error and creates nothing\", () => {\n    const s = mk(\"unknown\");\n    seed(s, \"src\");\n    const files = listing(s);\n    assert.throws(() => startFork(s, { forkSession: \"nosuch\" }), /Session not found: nosuch/);\n    assert.deepEqual(listing(s), files);\n  });\n  test(\"a fork point beyond the conversation is a clear error\", () => {\n    const s = mk(\"range\");\n    seed(s, \"src\");\n    assert.throws(() => startFork(s, { forkSession: \"src\", forkAt: \"99\" }), /fork point must be a whole number between 1 and 5/);\n  });\n  test(\"a session bound to a worktree is refused: nothing is created and the source is untouched\", () => {\n    const s = mk(\"bound\");\n    seed(s, \"src\", { worktreeBinding: binding });\n    const files = listing(s);\n    const before = digest(s, \"src\");\n    assert.throws(() => startFork(s, { forkSession: \"src\" }), /bound to the worktree .*feature\\/x.*would share it/s);\n    assert.throws(() => s.forkSession(\"src\"), /bound to the worktree/);\n    assert.deepEqual(listing(s), files);\n    assert.equal(digest(s, \"src\"), before);\n  });\n});\n\ndescribe(\"nexus run --fork-session (through dist)\", () => {\n  const home = () => fs.mkdtempSync(path.join(dir, \"home-\"));\n  const nexus = (state: string, ...args: string[]) =>\n    spawnSync(process.execPath, [CLI, ...args], { encoding: \"utf8\", env: { ...process.env, HOME: state, XDG_CONFIG_HOME: path.join(state, \".config\"), NEXUS_STATE_DIR: state }, timeout: 60_000 });\n  // `run --resume` (and so the fork behind --fork-session) reads the task store.\n  const sessions = (state: string) => new SessionManager(path.join(state, \"tasks\"), () => WorkspacePath.fromSelectedWorkspace(ws));\n\n  test(\"an unknown source exits 2 with the reason\", { skip }, () => {\n    const state = home();\n    const r = nexus(state, \"run\", \"--fork-session\", \"nosuch\", \"-w\", ws, \"go\");\n    assert.equal(r.status, 2, `${r.stdout}${r.stderr}`);\n    assert.match(r.stderr, /error: .*Session not found: nosuch/);\n  });\n  test(\"--fork-session with --resume exits 2 as ambiguous\", { skip }, () => {\n    const r = nexus(home(), \"run\", \"--fork-session\", \"a\", \"--resume\", \"b\", \"-w\", ws, \"go\");\n    assert.equal(r.status, 2, `${r.stdout}${r.stderr}`);\n    assert.match(r.stderr, /--fork-session cannot be combined with --resume/);\n  });\n  test(\"an invalid --fork-at exits 2; --fork-at alone exits 2\", { skip }, () => {\n    const a = nexus(home(), \"run\", \"--fork-session\", \"a\", \"--fork-at\", \"0\", \"-w\", ws, \"go\");\n    assert.equal(a.status, 2, `${a.stdout}${a.stderr}`);\n    assert.match(a.stderr, /--fork-at must be a whole number/);\n    const b = nexus(home(), \"run\", \"--fork-at\", \"2\", \"-w\", ws, \"go\");\n    assert.equal(b.status, 2);\n    assert.match(b.stderr, /--fork-at needs --fork-session/);\n  });\n  test(\"a fork point past the end exits 2 with the range\", { skip }, () => {\n    const state = home();\n    seed(sessions(state), \"src\");\n    const r = nexus(state, \"run\", \"--fork-session\", \"src\", \"--fork-at\", \"99\", \"-w\", ws, \"go\");\n    assert.equal(r.status, 2, `${r.stdout}${r.stderr}`);\n    assert.match(r.stderr, /between 1 and 5/);\n  });\n  test(\"a worktree-bound source exits 2 and creates nothing\", { skip }, () => {\n    const state = home();\n    const s = sessions(state);\n    seed(s, \"src\", { worktreeBinding: binding });\n    const files = listing(s);\n    const r = nexus(state, \"run\", \"--fork-session\", \"src\", \"-w\", ws, \"go\");\n    assert.equal(r.status, 2, `${r.stdout}${r.stderr}`);\n    assert.match(r.stderr, /bound to the worktree/);\n    // (The run's own startup checkpoint, task-*.json, is not a fork.)\n    assert.deepEqual(listing(s).filter((f) => !/^task-/.test(f)), files);\n  });\n  test(\"nexus repl --fork-session starts the REPL in the fork (the cut conversation), source untouched\", { skip }, () => {\n    const state = home();\n    const s = new SessionManager(path.join(state, \"sessions\"), () => WorkspacePath.fromSelectedWorkspace(ws));\n    seed(s, \"src\");\n    const before = digest(s, \"src\");\n    const r = spawnSync(process.execPath, [CLI, \"repl\", \"--fork-session\", \"src\", \"--fork-at\", \"3\", \"-w\", ws, \"-e\", \"http://127.0.0.1:9/v1\", \"-m\", \"m\", \"-y\"], {\n      encoding: \"utf8\", input: \"/exit\\n\", timeout: 60_000, env: { ...process.env, HOME: state, XDG_CONFIG_HOME: path.join(state, \".config\"), NEXUS_STATE_DIR: state },\n    });\n    assert.equal(r.status, 0, `${r.stdout}${r.stderr}`);\n    const id = /Forked src at message 3 into (session_\\w+)/.exec(r.stderr)?.[1];\n    assert.ok(id, r.stderr);\n    assert.match(r.stdout, new RegExp(`session ${id} . 3 messages`));\n    assert.equal(s.loadSession(id!)!.forkedFrom?.sessionId, \"src\");\n    assert.equal(digest(s, \"src\"), before);\n  });\n  test(\"nexus repl --fork-session also reports an unknown source with exit 2\", { skip }, () => {\n    const r = nexus(home(), \"repl\", \"--fork-session\", \"nosuch\", \"-w\", ws);\n    assert.equal(r.status, 2, `${r.stdout}${r.stderr}`);\n    assert.match(r.stderr, /Session not found: nosuch/);\n  });\n  test(\"the top-level launch takes the flag too, and refuses it with --resume\", { skip }, () => {\n    const a = nexus(home(), \"--fork-session\", \"nosuch\", \"--repl\", \"-w\", ws);\n    assert.equal(a.status, 2, `${a.stdout}${a.stderr}`);\n    assert.match(a.stderr, /Session not found: nosuch/);\n    const b = nexus(home(), \"--fork-session\", \"a\", \"--resume\", \"b\", \"--repl\", \"-w\", ws);\n    assert.equal(b.status, 2);\n    assert.match(b.stderr, /ambiguous/);\n  });\n});\n\ndescribe(\"/fork while working in a worktree\", () => {\n  test(\"is refused before anything is saved or created\", async () => {\n    const s = mk(\"slash\");\n    seed(s, \"src\");\n    const files = listing(s);\n    const calls: string[] = [];\n    const host = {\n      sessionId: () => \"src\",\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1f730-5dda-7050-8748-e755b63ef781","create_time":1795150841.5716467}},"metadata":{"history_sequence":13803,"sampled_through_sequence":13799,"client_authored":false,"fallback_token_limit_override":12000}}
