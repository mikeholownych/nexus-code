\"].join(\"\\n\"));\n   188\t  // Steering: one steer command, queued then applied.\n   189\t  assert.equal(commands.filter((c) => c.type === \"steer\").length, 1);\n   190\t  assert.deepEqual(events.filter((e) => e.type === \"steer.ack\").map((e) => e.status), [\"queued\", \"applied\"]);\n   350\t    const id = followUps[0].id;\n   351\t    const text = followUps.map((f) => f.text).join(\"\\n\\n\");\n   352\t    for (const f of followUps) this.steerAck(f.id, \"applied\", \"Applied as a follow-up turn.\");\n   353\t    this.runJob(id, undefined, (signal) => this.turn(id, text, text, `Turn: ${text.slice(0, 30)}`, signal));\n   354\t  }\n   355\t\n   356\t  private cancel(): void {\n   357\t    for (const f of this.followUps) this.steerAck(f.id, \"cancelled\", \"Cancelled with the turn before it could start; your message is back in the composer.\", f.text);\n   358\t    this.followUps = [];\n   359\t    this.dropPendingCompactions(\"cancelled with the running work\");\n   360\t    const spec = this.activeSpec;\n   361\t    if (this.activeTurn && spec && !spec.cancellable) {\n   362\t      const name = spec.name === \"!\" ? \"!\" : `/${spec.name}`;\n   363\t      this.emit({ type: \"notice\", text: `${name} cannot be cancelled; it finishes on its own.` });\n   364\t      return;\n   365\t    }\n   366\t    this.turnAbort?.abort(new Error(\"operator cancel\"));\n   367\t  }\n   368\t\n   369\t  /** Reports BUSY for `id` when a turn or command is running or the sidecar is shutting down. */\n   370\t  private rejectBusy(id: string): boolean {\n   371\t    if (!this.shutdownPromise && !this.activeTurn) return false;\n   372\t    const message = this.shutdownPromise ? \"The sidecar is shutting down.\" : \"A turn or command is running; cancel it or wait for its result.\";\n   373\t    this.emit({ type: \"error\", id, code: \"BUSY\", message });\n   374\t    return true;\n   375\t  }\n   376\t\n   377\t  /**\n   378\t   * /compact while a turn or command runs. During an agent turn the agent holds it until the turn's next step boundary\n   379\t   * (after the in-flight inference and its tool batch, approvals included, have settled) or the turn's end. While another\n   380\t   * command runs, it waits here and runs as its own job afterwards. Each request is acknowledged now (notice) and gets\n   381\t   * its outcome later (slash.result for its id). A duplicate shares the queued request's outcome; at most one request\n   382\t   * per kind (default, --llm) waits; cancellation and shutdown end waiting requests with that outcome.\n   383\t   */\n   384\t  private queueCompaction(id: string, llm: boolean): void {\n   385\t    const queued = this.app.getAgent().requestCompaction(id, llm);\n   386\t    if (queued.status !== \"no_active_turn\") {\n   387\t      this.emit({ type: \"notice\", text: queued.message });\n   388\t      return;\n   389\t    }\n   390\t    const existing = this.pendingCompactions.find((p) => p.llm === llm);\n   391\t    if (existing) {\n   392\t      existing.ids.push(id);\n   393\t      this.emit({ type: \"notice\", text: `A /compact${llm ? \" --llm\" : \"\"} is already waiting; this request shares its outcome.` });\n   394\t      return;\n   395\t    }\n   396\t    this.pendingCompactions.push({ ids: [id], llm });\n   397\t    this.emit({ type: \"notice\", text: `/compact${llm ? \" --llm\" : \"\"} queued: it runs when the current command finishes.` });\n   398\t  }\n   399\t\n   400\t  private compactionResult(ids: string[], ok: boolean, message: string): void {\n   401\t    for (const id of ids) this.emit({ type: \"slash.result\", id, command: \"compact\", success: ok, output: capText(redactSecrets(stripEscapes(message)), MAX_SLASH_OUTPUT) });\n   402\t  }\n   403\t\n   404\t  /** Ends waiting /compact requests that will not run. */\n   405\t  private dropPendingCompactions(reason: string): void {\n   406\t    for (const p of this.pendingCompactions) this.compactionResult(p.ids, false, `/compact was not run: ${reason}.`);\n   407\t    this.pendingCompactions = [];\n   408\t  }\n   409\t\n   410\t  /** Runs one turn or command as the session's only activity. Busy is reported before `body` starts. */\n   411\t  private runJob(id: string, spec: SlashSpec | undefined, body: (signal: AbortSignal) => Promise<void>): void {\n   412\t    const abort = new AbortController();\n   413\t    this.turnAbort = abort;\n   414\t    this.activeSpec = spec;\n   415\t    let settle!: () => void;\n   416\t    this.activeTurn = new Promise<void>((resolve) => {\n   417\t      settle = resolve;\n   418\t    });\n   419\t    this.emitSessionState();\n   420\t    void body(abort.signal)\n   421\t      .catch((err) => this.emit({ type: \"error\", id, code: \"INTERNAL\", message: redactSecrets(errorText(err)) }))\n   422\t      .finally(() => {\n   423\t        this.activeTurn = undefined;\n   424\t        this.turnAbort = undefined;\n   425\t        this.activeSpec = undefined;\n   426\t        // Queued /compact runs before anything else starts, without an idle state in between.\n   427\t        if (this.pendingCompactions.length && !this.shutdownPromise) {\n   428\t          const pending = this.pendingCompactions;\n   429\t          this.pendingCompactions = [];\n   430\t          settle();\ncli/src/upgrade.ts:40:export const DEFAULT_RELEASES_API = `https://api.github.com/repos/${CANONICAL_REPO}/releases`;\ncli/src/upgrade.ts:41:export const DEFAULT_RELEASE_BASE_URL = `https://github.com/${CANONICAL_REPO}/releases`;\ncli/src/upgrade.ts:399:  return process.env.NEXUS_RELEASES_API || DEFAULT_RELEASES_API;\ncli/src/upgrade.ts:403:  return process.env.NEXUS_RELEASE_BASE_URL || DEFAULT_RELEASE_BASE_URL;\ncli/src/upgrade.ts:416:  const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\ncli/src/upgrade.ts:478:        throw new Error(\"GitHub API rate limit exceeded; set GITHUB_TOKEN to authorize requests.\");\ncli/src/upgrade.ts:535:      throw new Error(\"GitHub API rate limit exceeded; set --vers