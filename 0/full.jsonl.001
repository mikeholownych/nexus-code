pectInventoryPath = (item) => {\n    let stat;\n    try { stat = fs.lstatSync(item); }\n    catch (error) {\n      // A runner can remove an ephemeral path after GNU find reports it. The\n      // executable check below already treats ENOENT as no remaining exposure.\n      // Preserve fail-closed behavior for every other inspection error.\n      if (error?.code === \"ENOENT\") return;\n      throw error;\n    }\n    inspectExecutable(item, stat.isSymbolicLink());\n  };\n  try {\n    const directoryRoots = new Set();\n    for (const root of roots) {\n      let stat;\n      try { stat = fs.statSync(root); }\n      catch (error) {\n        if (error?.code === \"ENOENT\") continue;\n        throw error;\n      }\n      if (stat.isDirectory()) directoryRoots.add(fs.realpathSync(root));\n      else if (stat.isFile()) inspectInventoryPath(root);\n    }\n\n    if (directoryRoots.size) {\n      // `readdirSync` in JavaScript made every task recursively enumerate the complete\n      // mounted system tree. Use GNU find's native directory traversal to keep this\n      // fail-closed inventory fast enough for repeated evaluator launches. Do not follow\n      // symlinked directories; inspect file symlinks (to catch compiler aliases) and\n      // regular files whose names could identify a compiler, then retain the same\n      // stat/realpath checks below.\n      const findStat = fs.lstatSync(FIND);\n      if (!findStat.isFile() || findStat.uid !== 0 || (findStat.mode & 0o022) !== 0\n        || (findStat.mode & 0o111) === 0 || fs.realpathSync(FIND) !== FIND) {\n        throw new Error(\"trusted compiler inventory tool is unavailable\");\n      }\n      // Broad system roots can contain millions of entries. Traverse independent,\n      // canonical roots concurrently, while keeping one fail-closed deadline and\n      // retaining per-process output buffers so NUL-delimited paths cannot interleave.\n      const inventory = path.join(path.dirname(fileURLToPath(import.meta.url)), \"scan-compiler-exposure.mjs\");\n      const inventoryStat = fs.lstatSync(inventory);\n      if (!inventoryStat.isFile() || inventoryStat.isSymbolicLink() || (inventoryStat.mode & 0o022) !== 0\n        || fs.realpathSync(inventory) !== inventory) {\n        throw new Error(\"trusted compiler inventory helper is unavailable\");\n      }\n      const result = spawnSync(process.execPath, [inventory, ...[...directoryRoots].sort()], {\n        encoding: null,\n        // Keep the parent deadline outside the helper's own bounded scan deadline so\n        // it can terminate and reap its find children before spawnSync is interrupted.\n        timeout: 70_000,\n        maxBuffer: 64 * 1024 * 1024,\n        env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n      });\n      if (result.error || result.status !== 0 || result.stderr?.length) {\n        const helperFailure = /^trusted compiler inventory could not complete: ([a-z_0-9]+)\\n$/.exec(result.stderr?.toString(\"utf8\") ?? \"\");\n        const spawnErrorCode = result.error?.code;\n        inventoryFailureReason = helperFailure?.[1]\n          ?? (spawnErrorCode === \"ETIMEDOUT\" ? \"parent_timeout\"\n            : spawnErrorCode ? \"spawn_error\"\n              : result.signal === \"SIGKILL\" ? \"helper_sigkill\"\n                : result.signal === \"SIGTERM\" ? \"helper_sigterm\"\n                  : result.status !== 0 ? \"helper_nonzero_exit\"\n                    : result.stderr?.length ? \"unexpected_stderr\" : \"helper_exit\");\n        throw new Error(\"trusted compiler inventory could not complete\");\n      }\n      for (const item of (result.stdout ?? Buffer.alloc(0)).toString(\"utf8\").split(\"\\0\")) {\n        if (item) inspectInventoryPath(item);\n      }\n    }\n  } catch {\n    const reason = inventoryFailureReason ? ` (inventory ${inventoryFailureReason})` : \"\";\n    return { paths: [], problem: `compiler exposure could not be checked; refusing qualification${reason}` };\n  }\n\n  return { paths: [...exposed].sort(), problem: null };\n}\n\nexport function compilerExposureMaskArgs(scan) {\n  if (scan.problem) throw new Error(scan.problem);\n  const targets = [...new Set(scan.paths)];\n  for (const target of targets) {\n    let stat;\n    try { stat = fs.lstatSync(target); }\n    catch { throw new Error(\"compiler exposure target is unavailable; refusing qualification\"); }\n    if (!stat.isFile()) throw new Error(\"compiler exposure target is not a regular file; refusing qualification\");\n  }\n  return targets.flatMap((target) => [\"--ro-bind\", \"/dev/null\", target]);\n}\n\nfunction executableVersion(command, argv) {\n  const result = spawnSync(command, argv, {\n    encoding: \"utf8\",\n    timeout: 5000,\n    env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n  });\n  return !result.error && result.status === 0 ? result.stdout.trim() : null;\n}\n    }\n    executionCommand = executionCommand.replace(/\\bPYTHONPATH=/g, \"PYTHONPATH=/runner:\");\n    executionCommand = executionCommand.replace(/\\bpytest\\b/g, \"pytest --assert=plain --noconftest\");\n    args.push(\"--setenv\", \"PYTHONDONTWRITEBYTECODE\", \"1\");\n  }\n  if (home) args.push(\"--tmpfs\", \"/home/eval\");\n  args.push(\"--\", \"/usr/bin/bash\", \"-c\", executionCommand);\n  return { cmd: BWRAP, argv: args, timeoutMs: timeoutSec * 1000 };\n}\n\nexport function runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles = []) {\n  if (!Array.isArray(readOnlyPaths) || !Array.isArray(allowedRoots) || !Array.isArray(allowedFiles) || allowedRoots.some((item) => typeof item !== \"string\" || !path.isAbsolute(item)) || allowedFiles.some((item) => typeof item !== \"string\" || !path.isAbsolute(item))) {\n    return \"candidate runtime mounts require explicit absolute paths and allowed roots\";\n  }\n  const roots = [];\n  for (const item of allowedRoots) {\n    const lexical = path.resolve(item);\n    const lexicalProblem = protectedRuntimeRootProblem(lexical);\n    if (lexicalProblem) return lexicalProblem;\n    try { roots.push(fs.realpathSync(lexical)); }\n    catch { return \"candidate runtime allowlist root is unavailable\"; }\n  }\n  let executableFiles;\n  try { executableFiles = allowedFiles.map((item) => fs.realpathSync(item)); }\n  catch { return \"candidate runtime executable is unavailable\"; }\n  for (const root of roots) {\n    const rootProblem = protectedRuntimeRootProblem(root);\n    if (rootProblem) return rootProblem;\n  }\n  for (const item of readOnlyPaths) {\n    if (typeof item !== \"string\" || !path.isAbsolute(item)) return \"candidate runtime paths must be absolute\";\n    let resolved;\n    try { resolved = fs.realpathSync(item); }\n    catch { return `candidate runtime path is unavailable: ${item}`; }\n    const stat = fs.statSync(resolved);\n    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n    const explicitlySelectedTempExecutable = executableFiles.includes(resolved) && stat.isFile() && resolved.startsWith(`/tmp${path.sep}`);\n    if (FORBIDDEN_RUNTIME_ROOTS.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !explicitlySelectedTempExecutable) {\n      return `protected candidate runtime path is forbidden: ${resolved}`;\n    }\n    if (resolved === os.homedir() || (resolved.startsWith(`${os.homedir()}${path.sep}`) && resolved.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part)))) {\n      return `sensitive candidate runtime path is forbidden: ${resolved}`;\n    }\n    if (!stat.isFile() && !stat.isDirectory()) return `candidate runtime path is not a regular file or directory: ${resolved}`;\n    if (!roots.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !executableFiles.includes(resolved)) {\n      return `candidate runtime path is outside its explicit allowlist: ${resolved}`;\n    }\n    if (executableFiles.includes(resolved) && !stat.isFile()) return `candidate runtime executable is not a regular file: ${resolved}`;\n    if (stat.isDirectory()) assertNoSymlinks(resolved);\n  }\n  return null;\n}\n\nfunction protectedRuntimeRootProblem(root) {\n  if (root.startsWith(`${os.homedir()}${path.sep}`) && root.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part))) return `sensitive candidate runtime root is forbidden: ${root}`;\n  if (root === \"/\" || root === \"/home\" || root === os.homedir() || FORBIDDEN_RUNTIME_ROOTS.some((item) => root === item || root.startsWith(`${item}${path.sep}`))) return `protected candidate runtime root is forbidden: ${root}`;\n  return null;\n}\n\nexport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n  if (protectedOverlap) throw new Error(protectedOverlap);\n  const maskedDirectories = maskedSystemDirectoryPaths(mountSources.systemDirectories);\n  const compilerExposure = scanOracleCompilerExposure(\n    mountSources.systemDirectories,\n    mountSources.systemEtcDirectories,\n    mountSources.runtimeSources.readOnlyPaths,\n    mountSources.toolchainDirectories,\n    maskedDirectories,\n  );\n#!/usr/bin/env bash\nset -euo pipefail\n\nrepo_root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd -P)\"\npolicy_file=\"$repo_root/eval/toolchain-versions.json\"\nrust_toolchain_file=\"$repo_root/rust-toolchain.toml\"\n\ngo_version=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"go\"])' \"$policy_file\")\"\nrust_version=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"rust\"])' \"$policy_file\")\"\ntoolchain_rust_version=\"$(sed -n 's/^channel = \"\\([0-9][0-9.]*\\)\"$/\\1/p' \"$rust_toolchain_file\")\"\n\nif [[ ! \"$go_version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ || ! \"$rust_version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]]; then\n  echo \"evaluator toolchain policy must contain exact semantic versions\" >&2\n  exit 1\nfi\nif [[ \"$rust_version\" != \"$toolchain_rust_version\" ]]; then\n  echo \"evaluator Rust version does not match rust-toolchain.toml\" >&2\n  exit 1\nfi\n\nassert_internal_symlinks() {\n  python3 - \"$1\" <<'PY'\nimport os\nimport sys\n\nroot = os.path.realpath(sys.argv[1], strict=True)\nfor current, directories, files in os.walk(root, followlinks=False):\n    for name in (*directories, *files):\n        item = os.path.join(current, name)\n        if not os.path.islink(item):\n            continue\n        try:\n            target = os.path.realpath(item, strict=True)\n            inside = os.path.commonpath((root, target)) == root\n        except (OSError, ValueError):\n            inside = False\n        if not inside:\n            print(f\"toolchain symlink is broken or escapes its root: {item}\", file=sys.stderr)\n            sys.exit(1)\nPY\n}\n\nexpected_go=\"go${go_version}\"\nactual_go=\"$(go version | awk '{print $3}')\"\nif [[ \"$actual_go\" != \"$expected_go\" ]]; then\n  echo \"Go version mismatch: expected $expected_go, got $actual_go\" >&2\n  exit 1\nfi\n\nrustup toolchain install \"$rust_version\" --profile minimal --component clippy --component rustfmt\nrust_root=\"$(rustup run \"$rust_version\" rustc --print sysroot)\"\nactual_rustc=\"$(rustup run \"$rust_version\" rustc --version | awk '{print $2}')\"\nactual_cargo=\"$(rustup run \"$rust_version\" cargo --version | awk '{print $2}')\"\nif [[ \"$actual_rustc\" != \"$rust_version\" || \"$actual_cargo\" != \"$rust_version\" ]]; then\n  echo \"Rust toolchain version mismatch: expected $rust_version, got rustc=$actual_rustc cargo=$actual_cargo\" >&2\n  exit 1\nfi\n\ngo_root=\"$(go env GOROOT)\"\ntest -n \"$go_root\" && test -d \"$go_root\"\ntest -n \"$rust_root\" && test -d \"$rust_root\"\ngo_root=\"$(realpath -e -- \"$go_root\")\"\nrust_root=\"$(realpath -e -- \"$rust_root\")\"\nassert_internal_symlinks \"$go_root\"\nassert_internal_symlinks \"$rust_root\"\nsudo rm -rf -- /usr/local/go /usr/local/nexus-qual/rust\nsudo install -d -o root -g root -m 0755 /usr/local /usr/local/go /usr/local/nexus-qual /usr/local/nexus-qual/rust\n# Materialize the trees so a symlinked hosted-toolcache root or any linked\n# entry cannot survive into the evaluator's pinned, non-replaceable roots.\nsudo cp -aL -- \"$go_root/.\" /usr/local/go/\nsudo cp -aL -- \"$rust_root/.\" /usr/local/nexus-qual/rust/\nsudo chown -hR root:root /usr/local/go /usr/local/nexus-qual/rust\nsudo chmod -R go-w /usr/local/go /usr/local/nexus-qual/rust\n\ncopied_go=\"$(/usr/local/go/bin/go version | awk '{print $3}')\"\ncopied_rustc=\"$(/usr/local/nexus-qual/rust/bin/rustc --version | awk '{print $2}')\"\ncopied_cargo=\"$(/usr/local/nexus-qual/rust/bin/cargo --version | awk '{print $2}')\"\nif [[ \"$copied_go\" != \"$expected_go\" || \"$copied_rustc\" != \"$rust_version\" || \"$copied_cargo\" != \"$rust_version\" ]]; then\n  echo \"copied evaluator toolchain version mismatch: go=$copied_go rustc=$copied_rustc cargo=$copied_cargo\" >&2\n  exit 1\nfi\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n      - run: sudo apt-get update\n      - run: sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.12'\n      - name: Install pinned evaluator toolchains\n        run: bash scripts/install-evaluator-toolchains.sh\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-release\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-release \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable\n      - name: Install cargo tools (audit, deny, about, cyclonedx)\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\n        with:\n          node-version: 22.22.1\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Require the pinned release Node and npm versions\n        run: |\n          test \"$(node --version)\" = \"v22.22.1\"\n          test \"$(npm --version)\" = \"10.9.4\"\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - name: Require a version-matched tag on main\n        run: |\n          git fetch origin main --no-tags\n          git merge-base --is-ancestor \"$GITHUB_SHA\" origin/main\n          test \"${GITHUB_REF_NAME#v}\" = \"$(node -p 'require(\"./package.json\").version')\"\n          node scripts/sync-version.mjs --check --tag \"$GITHUB_REF_NAME\"\n          test -f \"docs/releases/${GITHUB_REF_NAME}.md\" || { echo \"Missing docs/releases/${GITHUB_REF_NAME}.md\" >&2; exit 1; }\n      - name: Require a stable tag to be a version-only commit on its RC\n        if: ${{ !contains(github.ref_name, '-') }}\n        # The checkout has full history and tags (fetch-depth: 0). The checker runs from the RC's own copy so a stable\n        # commit cannot replace it; branch and tag protection remain the control over the workflow file itself.\n        run: |\n          rc=\"$(git tag --points-at \"$GITHUB_SHA^\" | grep -E \"^${GITHUB_REF_NAME//./\\\\.}-rc\\.[0-9]+$\" | sort -V | tail -n 1 || true)\"\n          test -n \"$rc\" || { echo \"the parent of $GITHUB_REF_NAME is not a ${GITHUB_REF_NAME}-rc.N tag\" >&2; exit 1; }\n          git show \"$rc:scripts/check-version-only-diff.mjs\" > \"$RUNNER_TEMP/check-version-only-diff.mjs\"\n          node \"$RUNNER_TEMP/check-version-only-diff.mjs\" \"$rc\" \"$GITHUB_SHA\"\n      - run: npm ci --prefix cli\n","exit_code":0,"duration":{"secs":0,"nanos":719154474}},"started_at_ms":1793655932298,"completed_at_ms":1793655933018}}
