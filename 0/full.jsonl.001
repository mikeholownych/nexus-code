tates: number; observations: number; ledgerStates: number; repetitions: number; events: number; coverage: number };\n}\n\nfunction createRecovery(): RecoveryState {\n  return { stage: \"normal\", episode: 0, notes: 0, denials: 0, allowedDenials: 0, events: [] };\n}\n\nexport function createTracking(): ExecutionTracking {\n  return {\n    version: TRACKING_VERSION,\n    cumulativeSteps: 0,\n    turns: 0,\n    stepsWithoutProgress: 0,\n    lastProgressStep: 0,\n    repetitions: [],\n    progress: [],\n    stagnation: [],\n    failedApproaches: [],\n    interventions: [],\n    compactions: [],\n    lowYieldCompactions: 0,\n    seenStates: [],\n    seenObservations: [],\n    seenLedgerStates: [],\n    coverage: [],\n    equivalents: [],\n    recovery: createRecovery(),\n    evicted: { states: 0, observations: 0, ledgerStates: 0, repetitions: 0, events: 0, coverage: 0 },\n  };\n}\n\n/**\n * Fills, in place, fields a tracking record written by an earlier version lacks (restored ledgers), and returns the\n * same object: every holder (the running turn's tracker, compaction, the ledger) must share one record.\n */\nexport function normalizeTracking(raw: unknown): ExecutionTracking {\n  if (!raw || typeof raw !== \"object\") return createTracking();\n  const t = raw as Record<string, any>;\n  const base = createTracking() as unknown as Record<string, any>;\n  for (const [key, value] of Object.entries(base)) {\n    if (Array.isArray(value)) {\n      if (!Array.isArray(t[key])) t[key] = [];\n    } else if (typeof value === \"number\") {\n      if (typeof t[key] !== \"number\" || !Number.isFinite(t[key])) t[key] = value;\n    } else if (key === \"evicted\") {\n      t[key] = { ...value, ...(t[key] && typeof t[key] === \"object\" ? t[key] : {}) };\n    } else if (key === \"recovery\") {\n      const r = t[key] && typeof t[key] === \"object\" ? t[key] : {};\n      const fresh = createRecovery() as unknown as Record<string, any>;\n      for (const [k, v] of Object.entries(fresh)) {\n        if (Array.isArray(v)) {\n          if (!Array.isArray(r[k])) r[k] = [];\n        } else if (typeof v === \"number\") {\n          if (typeof r[k] !== \"number\" || !Number.isFinite(r[k])) r[k] = v;\n        } else if (k === \"stage\" && ![\"normal\", \"advisory\", \"constrained\"].includes(r[k])) {\n          r[k] = v;\n        }\n      }\n      t[key] = r;\n    }\n  }\n  return t as ExecutionTracking;\n}\n\nconst digest = (text: string) => createHash(\"sha256\").update(text).digest(\"hex\").slice(0, 16);\nconst clip = (text: string, max: number) => (text.length <= max ? text : `${text.slice(0, max - 1)}…`);\n\nfunction canonical(value: unknown): unknown {\n  if (Array.isArray(value)) return value.map(canonical);\n  if (value && typeof value === \"object\") {\n    return Object.fromEntries(Object.keys(value as object).sort().map((k) => [k, canonical((value as any)[k])]));\n  }\n  if (typeof value === \"string\") return value.replace(/\\s+/g, \" \").trim();\n  return value;\n}\n\n/** Tool name and canonical arguments: the same request however it is formatted or whatever its call id. */\nexport function actionIdentity(name: string, args: unknown): string {\n  let parsed: unknown = args;\n  if (typeof args === \"string\") {\n    try {\n      parsed = JSON.parse(args || \"{}\");\n  /** Third (or later) observation of the same lines of a file on a known unchanged state: a semantic loop. */\n  equivalentLoop: boolean;\n  /** The record of these exact lines re-obtained on this state (set when the observation was equivalent); see `equivalentLoop`. */\n  equivalence?: EquivalenceRecord;\n}\n\n/** Why a call must not run during constrained recovery, and the earlier observations that already answered it. */\nexport interface RecoveryDenial {\n  reason: string;\n  /** Earlier observations whose output is still in the conversation and covers the request. */\n  coveredBy: CoverageSegment[];\n  /** Readable action that was refused. */\n  action: string;\n}\n\nexport interface StepEvaluation {\n  progressed: boolean;\n  reasons: string[];\n  stateUnknown: boolean;\n}\n\n/** Mutable view over the ledger's tracking record. */\nexport class ExecutionTracker {\n  constructor(public readonly data: ExecutionTracking, private readonly clock: () => string = () => new Date().toISOString()) {}\n\n  static fresh(): ExecutionTracker {\n    return new ExecutionTracker(createTracking());\n  }\n\n  private event(list: TrackingEvent[], max: number, step: number, kind: string, detail: string): void {\n    pushBounded(list, { step, at: this.clock(), kind, detail: clip(detail, 400) }, max, (n) => (this.data.evicted.events += n));\n  }\n\n  beginTurn(): void {\n    this.data.turns++;\n  }\n\n  beginStep(): number {\n    return ++this.data.cumulativeSteps;\n  }\n\n  /** Records a single tool result; the verdict says whether it was new, a poll, or part of a demonstrated loop. */\n  observe(step: number, o: Observation): ObservationVerdict {\n    const kind = o.kind ?? actionKind(o.name);\n    const command = commandResult(o.success, o.text);\n    const outcomeClass = classifyOutcome(command.success, o.text, o.timedOut || command.timedOut);\n    const action = actionIdentity(o.name, o.args);\n    const outcome = outcomeIdentity(command.success, o.text);\n    const stateUnknown = o.stateBefore === \"unknown\";\n    const actionId = digest(action);\n    const key = digest(`${action}\\u0000${outcome}\\u0000${o.stateBefore}`);\n    let record = this.data.repetitions.find((r) => r.key === key);\n    const seenBefore = !stateUnknown && this.data.seenObservations.includes(key);\n    if (!record) {\n      record = {\n        key,\n        action: clip(`${o.name} ${typeof o.args === \"string\" ? o.args : JSON.stringify(o.args ?? {})}`.replace(/\\s+/g, \" \"), 160),\n        actionId,\n        actionKind: kind,\n        outcomeClass,\n        state: o.stateBefore,\n  objectiveSha256: string;\n  startedAt: string;\n  requirements: Requirement[];\n  scopeChanges: ScopeChange[];\n  steering: SteeringRecord[];\n  steeringConflicts?: SteeringConflict[];\n  superseded?: SupersededObjective[];\n  verification: VerificationAttempt[];\n  /** Operator-authorised regression obligations (core/regression_obligations.ts); absent in ledgers written before DV-3. */\n  obligations?: RegressionObligation[];\n  /** Operator-authorised behavioural references, by requirement (DV-4 gate). */\n  references?: ReferenceDeclaration[];\n  /** Latest VC-3 differential run per requirement; finite agreement, never equivalence. */\n  differentials?: DifferentialRecord[];\n  continuation: ContinuationState;\n  /** The model's own statement of what comes next (update_requirements next_action). */\n  nextAction?: string;\n  /** Attempts numbered up to this were already judged non-converging and stopped the work; the next judgement starts after it. */\n  convergenceResetAfter?: number;\n  outcome?: ObjectiveOutcome;\n  /** Short follow-up messages the operator sent as new turns while this objective was unresolved. */\n  amendments: Array<{ at: string; text: string }>;\n  /**\n   * Objective-scoped execution tracking (core/execution_tracking.ts): cumulative steps, progress, repetition,\n   * failed approaches, interventions and compactions. Absent in ledgers written before it existed; `trackingOf` fills it.\n   */\n  execution?: ExecutionTracking;\n}\n\n/** The ledger's execution tracking, created (or completed, for a ledger restored from an earlier version) on first use. */\nexport function trackingOf(ledger: ObjectiveLedger): ExecutionTracker {\n  ledger.execution = normalizeTracking(ledger.execution);\n  // `ContinuationState.totalSteps` predates the richer execution record. Preserve its count when resuming a legacy\n  // task instead of normalizing a missing execution field to a false zero and granting fresh budget.\n  if (Number.isSafeInteger(ledger.continuation?.totalSteps) && ledger.continuation.totalSteps > ledger.execution.cumulativeSteps) {\n    ledger.execution.cumulativeSteps = ledger.continuation.totalSteps;\n  }\n  return new ExecutionTracker(ledger.execution);\n}\n\nconst now = () => new Date().toISOString();\nconst sha256 = (text: string) => createHash(\"sha256\").update(text).digest(\"hex\");\nconst clip = (text: string, max: number) => (text.length <= max ? text : `${text.slice(0, max - 1)}…`);\n\n/**\n * Acceptance criteria as written: top-level numbered items (`1.`, `2)`, `R3:`) of the objective. Each keeps its\n * heading line; the full wording stays in the verbatim objective. Fewer than two items means the objective is a\n * single request and is tracked as one requirement.\n */\nexport function seedRequirements(objective: string): Array<{ id: string; text: string; detail: string; kind?: RequirementKind; verifier?: string; verifierSource?: \"operator\"; note?: string }> {\n  const lines = objective.replace(/\\r\\n?/g, \"\\n\").split(\"\\n\");\n  const items: Array<{ indent: number; text: string; line: number }> = [];\n  lines.forEach((line, index) => {\n    const match = /^(\\s*)(?:R?(\\d{1,3})[.):]|R(\\d{1,3})\\s*[-–—])\\s+(\\S.*)$/.exec(line);\n    if (match) items.push({ indent: match[1].replace(/\\t/g, \"    \").length, text: match[4].trim(), line: index });\n  });\n  const whole = [{ id: \"R1\", text: clip(firstLine(objective), MAX_REQUIREMENT_TEXT), detail: objective }];\n  if (items.length < 2) return whole;\n  // Only the outermost numbering level: nested numbered sub-steps belong to their parent item.\n  const outer = Math.min(...items.map((item) => item.indent));\n  const top = items.filter((item) => item.indent <= outer + 1);\n  if (top.length < 2) return whole;\n  // Each requirement's full wording: from its own line up to the next top-level item (the last runs to the end).\n  return top.map((item, index) => ({\n    id: `R${index + 1}`,\n    text: clip(item.text, MAX_REQUIREMENT_TEXT),\n    detail: lines.slice(item.line, index + 1 < top.length ? top[index + 1].line : lines.length).join(\"\\n\").trimEnd(),\n    ...typedItem(item.text),\n  }));\n}\n\n      throw new Error(`Invalid operation policy ${field}: must not exceed Node's timer limit (${maxTimerDelayMs} ms).`);\n    }\n  }\n  const { maxWaitMs, minWaitMs } = effective;\n  if (minWaitMs > maxWaitMs) {\n    throw new Error(`Invalid operation wait settings: minWaitMs (${minWaitMs}) must not exceed maxWaitMs (${maxWaitMs}).`);\n  }\n  return Object.keys(policy).length ? policy : undefined;\n}\n\n/**\n * Continuation budgets: flags, then NEXUS_MAX_TOTAL_STEPS / NEXUS_MAX_TURN_MINUTES / NEXUS_STAGNATION_STEPS, then\n * finite defaults. Total steps are charged to the durable objective ledger, so resume does not reset them.\n * `--no-continuation` (or NEXUS_CONTINUATION=0) is the operator's explicit choice of the single-segment turn that\n * ends at --max-steps.\n */\nexport function continuationBudget(options: any): ContinuationBudget | undefined {\n  if (options.continuation === false || effectiveSetting(\"NEXUS_CONTINUATION\") === \"0\") return undefined;\n  const positive = (flag: unknown, env: string | undefined, fallback: number, maximum = Number.POSITIVE_INFINITY): number => {\n    for (const raw of [flag, env]) {\n      if (raw === undefined || raw === null || raw === \"\") continue;\n      const value = Number(raw);\n      if (!Number.isFinite(value) || value <= 0) throw new Error(`Invalid continuation budget '${String(raw)}': expected a positive number.`);\n      if (value > maximum) throw new Error(`Invalid continuation budget '${String(raw)}': maximum is ${maximum}.`);\n      return value;\n    }\n    return fallback;\n  };\n  const steps = positive(options.maxTotalSteps, effectiveSetting(\"NEXUS_MAX_TOTAL_STEPS\"), DEFAULT_CONTINUATION.maxTotalSteps, MAX_CONTINUATION_STEPS);\n  return {\n    ...DEFAULT_CONTINUATION,\n    maxTotalSteps: Number.isFinite(steps) ? Math.floor(steps) : steps,\n    maxTurnMinutes: positive(options.maxTurnMinutes, effectiveSetting(\"NEXUS_MAX_TURN_MINUTES\"), DEFAULT_CONTINUATION.maxTurnMinutes, MAX_CONTINUATION_MINUTES),\n    stagnationSteps: Math.floor(positive(options.stagnationSteps, effectiveSetting(\"NEXUS_STAGNATION_STEPS\"), DEFAULT_CONTINUATION.stagnationSteps)),\n    verifierConvergenceAttempts: Math.floor(positive(undefined, effectiveSetting(\"NEXUS_VERIFIER_CONVERGENCE_ATTEMPTS\"), DEFAULT_CONVERGENCE_ATTEMPTS)),\n  };\n}\n\n/** Repeated-call thresholds: the operator's values, which a project `.env` may only lower. */\nexport function repeatedCallSettings() {\n  return resolveRepeatedCallSettings(\n    { soft: operatorSetting(\"NEXUS_REPEATED_CALL_SOFT\"), hard: operatorSetting(\"NEXUS_REPEATED_CALL_HARD\") },\n    { soft: projectSetting(\"NEXUS_REPEATED_CALL_SOFT\"), hard: projectSetting(\"NEXUS_REPEATED_CALL_HARD\") },\n  );\n}\n\n/** Replaces the \"local-model\" placeholder with the first model the gateway lists; unchanged if the gateway is unreachable or the start is a resume. */\nexport async function autoDetectModel(config: HarnessConfig, options: { resuming?: boolean } = {}): Promise<HarnessConfig> {\n  // A provider's catalog lists billable models; one is never chosen on the operator's behalf.\n  if (config.provider || config.model !== \"local-model\") return config;\n  // A resumed start sends nothing before the agent knows whether the provider asked it to wait: the session record\n  // supplies the model (AutonomousAgent.adoptRecordedModel), else the first step detects it after the wait.\n  if (options.resuming) return config;\n  try {\n    const models = await new LocalLlmClient(config).listModels();\n    if (models.length > 0) return { ...config, model: models[0] };\n  } catch {\n    // Keep the placeholder; the first inference request will surface the connection problem.\n  }\n  return config;\n}\ncli/src/config.ts:433:  const continuation = continuationBudget(options);\ncli/src/config.ts:529:    ...(continuation ? { continuation } : {}),\ncli/src/config.ts:743: * `--no-continuation` (or NEXUS_CONT