/delegation_contract.ts\\n@@ -0,0 +1,228 @@\\n+export type DelegationExecutionMode = \\\"transient\\\" | \\\"durable\\\";\\n+export type DelegationOutcomeStatus = \\\"COMPLETED\\\" | \\\"FAILED\\\" | \\\"BLOCKED\\\" | \\\"CANCELLED\\\" | \\\"INTERRUPTED\\\" | \\\"UNKNOWN_EFFECT\\\";\\n+\\n+export interface DelegationModelRequirements {\\n+  capabilities?: string[];\\n+  minimumContext?: number;\\n+  qualification?: string;\\n+  independentOf?: string[];\\n+}\\n+\\n+/** Authority contributed by one existing policy boundary. Every layer narrows the resulting child authority. */\\n+export interface DelegationAuthorityLayer {\\n+  source: \\\"parent\\\" | \\\"profile\\\" | \\\"task\\\" | \\\"session\\\" | \\\"workspace\\\";\\n+  permittedCapabilities: readonly string[];\\n+  authorizedScope: readonly string[];\\n+}\\n+\\n+export interface DelegationContract {\\n+  id: string;\\n+  parentId: string;\\n+  objective: string;\\n+  profile: string;\\n+  inputs: Record<string, unknown>;\\n+  authorizedScope: string[];\\n+  permittedCapabilities: string[];\\n+  executionMode: DelegationExecutionMode;\\n+  contextBudget?: number;\\n+  outputBudget?: number;\\n+  executionDeadlineMs?: number;\\n+  modelRequirements?: DelegationModelRequirements;\\n+  dependencies?: string[];\\n+  expectedOutputSchema?: string;\\n+  requiresVerification: boolean;\\n+  requiresIndependentReview: boolean;\\n+}\\n+\\n+export interface DelegationEvidence {\\n+  kind: string;\\n+  reference: string;\\n+  digest?: string;\\n+  summary?: string;\\n+}\\n+\\n+export interface DelegationResourceUsage {\\n+  inferenceRequests: number;\\n+  toolCalls: number;\\n+  elapsedMs: number;\\n+  inputTokens?: { value: number; source: \\\"reported\\\" | \\\"estimated\\\" };\\n+  outputTokens?: { value: number; source: \\\"reported\\\" | \\\"estimated\\\" };\\n+}\\n+\\n+/** A child receipt keeps its status, evidence, uncertainty, usage, and remaining work distinct. */\\n+export interface DelegationOutcome {\\n+  id: string;\\n+  parentId: string;\\n+  status: DelegationOutcomeStatus;\\n+  summary: string;\\n+  evidence: DelegationEvidence[];\\n+  uncertainty: string[];\\n+  resourceUsage: DelegationResourceUsage;\\n+  outstandingObligations: string[];\\n+}\\n+\\n+const CAPABILITY_ID = /^[a-z][a-z0-9_.:-]*$/;\\n+\\n+function capabilityIds(values: readonly string[], label: string): string[] {\\n+  const output: string[] = [];\\n+  for (const value of values) {\\n+    if (typeof value !== \\\"string\\\") throw new Error(`${label} contains a non-string capability identity`);\\n+    const canonical = value.trim().toLowerCase();\\n+    if (!CAPABILITY_ID.test(canonical)) throw new Error(`${label} contains an invalid capability identity ${JSON.stringify(value)}`);\\n+    if (!output.includes(canonical)) output.push(canonical);\\n+  }\\n+  return output;\\n+}\\n+\\n+function scopes(values: readonly string[], label: string): string[] {\\n+  const output: string[] = [];\\n+  for (const value of values) {\\n+    if (typeof value !== \\\"string\\\") throw new Error(`${label} contains a non-string path`);\\n+    const written = value.trim().replace(/\\\\\\\\/g, \\\"/\\\");\\n+    if (written === \\\"*\\\") {\\n+      if (!output.includes(\\\"*\\\")) output.push(\\\"*\\\");\\n+      continue;\\n+    }\\n+    if (!written || written.startsWith(\\\"/\\\") || /^[A-Za-z]:/.test(written)) {\\n+      throw new Error(`${label} contains a path that is not workspace-relative: ${JSON.stringify(value)}`);\\n+    }\\n+    if (/[*?\\\\[\\\\]]/.test(written)) throw new Error(`${label} contains a non-canonical path pattern: ${JSON.stringify(value)}`);\\n+    const parts = written.split(\\\"/\\\").filter((part) => part && part !== \\\".\\\");\\n+    if (!parts.length || parts.includes(\\\"..\\\")) throw new Error(`${label} contains a path traversal: ${JSON.stringify(value)}`);\\n+    const canonical = parts.join(\\\"/\\\");\\n+    if (!output.includes(canonical)) output.push(canonical);\\n+  }\\n+  return output;\\n+}\\n+\\n+function withinScope(path: string, allowed: string): boolean {\\n+  return allowed === \\\"*\\\" || path === allowed || path.startsWith(`${allowed}/`);\\n+}\\n+\\n+function cloneAndFreeze<T>(value: T): T {\\n+  if (Array.isArray(value)) return Object.freeze(value.map((entry) => cloneAndFreeze(entry))) as T;\\n+  if (value && typeof value === \\\"object\\\") {\\n+    const copy = Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, cloneAndFreeze(entry)]));\\n+    return Object.freeze(copy) as T;\\n+  }\\n+  return value;\\n+}\\n+\\n+function inheritedCapabilities(layers: readonly DelegationAuthorityLayer[]): string[] {\\n+  if (!layers.length) return [];\\n+  return capabilityIds(layers[0].permittedCapabilities, layers[0].source)\\n+    .filter((candidate) => layers.slice(1).every((layer) => capabilityIds(layer.permittedCapabilities, layer.source).includes(candidate)));\\n+}\\n+\\n+function inheritedScopes(layers: readonly DelegationAuthorityLayer[]): string[] {\\n+  if (!layers.length) return [];\\n+  let effective = scopes(layers[0].authorizedScope, layers[0].source);\\n+  for (const layer of layers.slice(1)) {\\n+    const next = scopes(layer.authorizedScope, layer.source);\\n+    const narrowed: string[] = [];\\n+    for (const parent of effective) {\\n+      for (const child of next) {\\n+        if (parent === \\\"*\\\") narrowed.push(child);\\n+        else if (child === \\\"*\\\" || withinScope(child, parent)) narrowed.push(child);\\n+        else if (withinScope(parent, child)) narrowed.push(parent);\\n+      }\\n+    }\\n+    effective = [...new Set(narrowed)];\\n+  }\\n+  return effective;\\n+}\\n+\\n+/**\\n+ * Validates a contract and binds its requested authority to the intersection of parent, profile, task, session and\\n+ * workspace policy. Requests outside that intersection are refused before admission; this function never grants them.\\n+ */\\n+export function resolveDelegationContract(\\n+  contract: DelegationContract,\\n+  layers: readonly DelegationAuthorityLayer[],\\n+): DelegationContract {\\n+  if (!contract || typeof contract !== \\\"object\\\" || Array.isArray(contract)) throw new Error(\\\"delegation contract must be an object\\\");\\n+  for (const [field, value] of Object.entries({ id: contract.id, parentId: contract.parentId, objective: contract.objective, profile: contract.profile })) {\\n+    if (typeof value !== \\\"string\\\" || !value.trim()) throw new Error(`delegation contract needs a non-empty '${field}'`);\\n+  }\\n+  if (contract.executionMode !== \\\"transient\\\" && contract.executionMode !== \\\"durable\\\") throw new Error(\\\"delegation contract has an invalid executionMode\\\");\\n+  if (!contract.inputs || typeof contract.inputs !== \\\"object\\\" || Array.isArray(contract.inputs)) throw new Error(\\\"delegation contract 'inputs' must be an object\\\");\\n+  if (!Array.isArray(contract.permittedCapabilities)) throw new Error(\\\"delegation contract 'permittedCapabilities' must be an array\\\");\\n+  if (!Array.isArray(contract.authorizedScope)) throw new Error(\\\"delegation contract 'authorizedScope' must be an array\\\");\\n+  if (typeof contract.requiresVerification !== \\\"boolean\\\" || typeof contract.requiresIndependentReview !== \\\"boolean\\\") {\\n+    throw new Error(\\\"delegation contract verification requirements must be booleans\\\");\\n+  }\\n+  if (contract.modelRequirements !== undefined && (!contract.modelRequirements || typeof contract.modelRequirements !== \\\"object\\\" || Array.isArray(contract.modelRequirements))) {\\n+    throw new Error(\\\"delegation contract 'modelRequirements' must be an object\\\");\\n+  }\\n+  if (contract.modelRequirements?.capabilities !== undefined && (!Array.isArray(contract.modelRequirements.capabilities) || contract.modelRequirements.capabilities.some((value) => typeof value !== \\\"string\\\"))) {\\n+    throw new Error(\\\"delegation contract 'modelRequirements.capabilities' must be an array of strings\\\");\\n+  }\\n+  if (contract.modelRequirements?.independentOf !== undefined && (!Array.isArray(contract.modelRequirements.independentOf) || contract.modelRequirements.independentOf.some((value) => typeof value !== \\\"string\\\"))) {\\n+    throw new Error(\\\"delegation contract 'modelRequirements.independentOf' must be an array of strings\\\");\\n+  }\\n+  if (contract.dependencies !== undefined && (!Array.isArray(contract.dependencies) || contract.dependencies.some((value) => typeof value !== \\\"string\\\"))) {\\n+    throw new Error(\\\"delegation contract 'dependencies' must be an array of strings\\\");\\n+  }\\n+  if (contract.expectedOutputSchema !== undefined && typeof contract.expectedOutputSchema !== \\\"string\\\") {\\n+    throw new Error(\\\"delegation contract 'expectedOutputSchema' must be a string\\\");\\n+  }\\n+  for (const [field, value] of Object.entries({ contextBudget: contract.contextBudget, outputBudget: contract.outputBudget, executionDeadlineMs: contract.executionDeadlineMs, minimumContext: contract.modelRequirements?.minimumContext })) {\\n+    if (value !== undefined && (!Number.isSafeInteger(value) || value <= 0)) throw new Error(`delegation contract '${field}' must be a positive safe integer`);\\n+  }\\n+\\n+  const requestedCapabilities = capabilityIds(contract.permittedCapabilities, \\\"contract\\\");\\n+  const allowedCapabilities = inheritedCapabilities(layers);\\n+  const deniedCapabilities = requestedCapabilities.filter((capability) => !allowedCapabilities.includes(capability));\\n+  if (deniedCapabilities.length) throw new Error(`delegation requests unauthorized capability ${deniedCapabilities.join(\\\", \\\")}`);\\n+\\n+  const requestedScope = scopes(contract.authorizedScope, \\\"contract\\\");\\n+  const allowedScope = inheritedScopes(layers);\\n+  const deniedPaths = requestedScope.filter((requested) => !allowedScope.some((allowed) => withinScope(requested, allowed)));\\n+  if (deniedPaths.length) throw new Error(`delegation requests path outside inherited scope ${deniedPaths.join(\\\", \\\")}`);\\n+\\n+  return cloneAndFreeze({\\n+    ...contract,\\n+    authorizedScope: requestedScope,\\n+    permittedCapabilities: requestedCapabilities,\\n+  });\\n+}\\n+\\n+const OUTCOME_STATUSES = new Set<DelegationOutcomeStatus>([\\n+  \\\"COMPLETED\\\", \\\"FAILED\\\", \\\"BLOCKED\\\", \\\"CANCELLED\\\", \\\"INTERRUPTED\\\", \\\"UNKNOWN_EFFECT\\\",\\n+]);\\n+\\n+/** Validates and freezes the bounded receipt returned by a delegated execution. */\\n+export function createDelegationOutcome(outcome: DelegationOutcome): DelegationOutcome {\\n+  if (!outcome || typeof outcome !== \\\"object\\\" || Array.isA…3021 tokens truncated…es ([turn.ts:17](../../cli/src/core/turn.ts#L17), [turn.ts:423](../../cli/src/core/turn.ts#L423)). |\\n+| Transient delegation | Implemented, incomplete | `runSubagent` is an in-turn child path ([agent.ts:4463](../../cli/src/agent.ts#L4463)); the model tool is registered through the capability spine ([spine_handlers.ts:441](../../cli/src/core/spine_handlers.ts#L441)). Result type is only `{completed, summary, reason?, needsInput?}` ([agent_support.ts:35](../../cli/src/core/agent_support.ts#L35)); no shared typed delegation contract, authority-intersection record or recursive child graph is present in that type. Existing delegation coverage includes `agt111_subagent_parity.test.ts`, `team_convergence.test.ts`, `vc9_subagent_needs_input.test.ts` and convergence invariants.\\n+| Durable work units and scheduling | Implemented | `newOperation` constructs operation state and enforces unit invariants and cycle detection ([operation.ts:489](../../cli/src/core/operation.ts#L489), [operation.ts:559](../../cli/src/core/operation.ts#L559)); `ConvergenceScheduler` selects transitions ([scheduler.ts:53](../../cli/src/core/scheduler.ts#L53)); `driveOperation` and `OperationStore` persist and resume work ([operation_runner.ts:717](../../cli/src/core/operation_runner.ts#L717), [operation_runner_persistence.ts:28](../../cli/src/core/operation_runner_persistence.ts#L28)). Existing tests cover schema, restart, concurrency and isolated integration.\\n+| Roles and independent review | Implemented, incomplete | Specialist profiles define permitted tools, read-only declarations, inputs, ceilings and output contracts ([specialist_profiles.ts:22](../../cli/src/core/specialist_profiles.ts#L22)); operation roles include team and specialist profiles ([roles.ts:101](../../cli/src/core/roles.ts#L101)). Independent-review formatting and verdict validation exist ([independent_review.ts:131](../../cli/src/core/independent_review.ts#L131), [independent_review.ts:204](../../cli/src/core/independent_review.ts#L204)); source presence does not establish all requested independence dimensions or reviewer behavior under truncated evidence.\\n+| Resource and provider handling | Implemented, incomplete | `ResourceRegistry` handles eligibility and provider conditions ([resources.ts:194](../../cli/src/core/resources.ts#L194)); provider capability states include `unknown` and `unavailable` ([provider_capabilities.ts:26](../../cli/src/core/provider_capabilities.ts#L26)); recovery classification/controller exists ([provider_recovery.ts:96](../../cli/src/core/provider_recovery.ts#L96), [provider_recovery.ts:367](../../cli/src/core/provider_recovery.ts#L367)). Provider test sources include `provider_wire_matrix.test.ts`, `provider_capabilities.test.ts`, `provider_robustness.test.ts`, `cloud_providers.test.ts` and `provider_recovery.test.ts`; this assignment's complete workflow has not been run against the requested minimal contract fixture.\\n+| `/team` and operation CLI | Implemented, incomplete | `TeamOrchestrator` maps roles to durable work units ([team.ts:43](../../cli/src/team.ts#L43), [team.ts:126](../../cli/src/team.ts#L126)); the operation CLI accepts validated JSON work-unit specs ([operation_cli.ts:88](../../cli/src/operation_cli.ts#L88)). The REPL has a dedicated `/team` handler ([repl.ts:1688](../../cli/src/repl.ts#L1688)); the sidecar routes commands through a separate slash router ([sidecar.ts:890](../../cli/src/sidecar.ts#L890), [router.ts:14](../../cli/src/slash/router.ts#L14)). TUI completion/help comes from the slash catalogue, with remote invocation parsing in Rust ([catalog.ts:93](../../cli/src/slash/catalog.ts#L93), [slash.rs:25](../../core/src/bin/nexus_tui/slash.rs#L25)).\\n+| `/loop`, `/goal`, `/batch` | Unimplemented as command lifecycles | No command entries or handlers exist in the current slash catalogue/handlers or REPL. `loop_patterns.test.ts` and `nonprogress_recovery.test.ts` test agent-loop detection; neither implements a durable `/loop` controller. The objective ledger is available through `runTurn` and `/requirements`, but there is no `/goal` lifecycle controller. There is no `/batch` command; existing operation JSON work-unit specs are a compatible starting format.\\n+| Pause, cancellation and restart | Implemented, incomplete | The operation runner attaches abort signals and persists cancellation ([operation_runner.ts:127](../../cli/src/core/operation_runner.ts#L127)); `CANCELLED` is terminal in the runner ([operation_runner.ts:142](../../cli/src/core/operation_runner.ts#L142)), while resume explicitly changes a cancelled operation back to running ([operation_cli.ts:325](../../cli/src/operation_cli.ts#L325)). There is no distinct paused status. An operation interruption can also leave an unknown execution outcome; current work-unit recovery is bounded, but `/loop` and `/batch` reconciliation semantics are absent.\\n+| Skills and authority | Implemented, incomplete | Skill activation has constraints and content digests ([skill_activation.ts:67](../../cli/src/core/skill_activation.ts#L67), [skill_activation.ts:104](../../cli/src/core/skill_activation.ts#L104)). Capability registration exists ([capabilities.ts:120](../../cli/src/core/capabilities.ts#L120)) and the orchestration capability schema declares `spawn_subagent` ([orchestration.ts:38](../../cli/src/core/capability_definitions/orchestration.ts#L38)). Full effect-path mediation and path-scoped profile/skill eligibility still require adversarial tests from the assignment.\\n+\\n+## Roadmap and compatibility notes\\n+\\n+- v1.3 PA-1, PA-2 and PA-3 already cover parallel visibility, verified integration and goal semantics. PA-4 stages this assignment against those units and the active WP-P10-02 durable-budget work.\\n+- Operation records are versioned and reject records from a newer schema ([operation_schema.ts:26](../../cli/src/core/operation_schema.ts#L26), [operation_schema.ts:59](../../cli/src/core/operation_schema.ts#L59)). Lifecycle additions must use that migration gate rather than reinterpret old records.\\n+- XERJ definition-first lookup identified `TeamOrchestrator`, `WorkUnitSpec`, `newOperation` and the existing dependency-cycle check. The first batch-spec package reuses the operation parser and constructor; no orchestration code was copied.\\n+- No provider, gateway, or homelab-ai change is part of the workstream.\\ndiff --git a/docs/v1.3.0/PLAN.md b/docs/v1.3.0/PLAN.md\\nindex 932bcb79..f86c5851 100644\\n--- a/docs/v1.3.0/PLAN.md\\n+++ b/docs/v1.3.0/PLAN.md\\n@@ -94,6 +94,7 @@ This supersedes v1.2.1 unit RD-5 (ACP server mode), which moves here.\\n | PA-1 | Parallel run visibility: `nexus operation watch` (CLI view first) showing units, worktrees and owners; a worktree owner id recorded in the receipt (reference: Codex `worktree` crate `owner` and `bind_thread`); a concurrency cap tied to a CPU and memory budget instead of a count only | two parallel units show their owners and states; the cap refuses a third when the budget is exhausted | M | P1 |\\n | PA-2 | Verified merge arbitration: when parallel units integrate, apply each diff, run verification on the merged tree, reject on failure. No peer read does more than isolate; this is where Nexus can differ | two units whose changes conflict semantically (each passes alone) fail verification on the merged tree and neither is integrated silently | M | P1 |\\n | PA-3 | Goal semantics: a ledger entry active from an earlier process resumes **paused** (opencode `goal.ts` boot id), stall counting by failure fingerprint and not turn count, completion decided only by a verifier receipt, an optional token budget rolling up from sub-operations (reference: Codex goal budget); `/team` leaves experimental only after PA-1 and PA-2 | stale goal resumes paused with a visible reason; a model \\\"I am done\\\" does not complete a goal | M | P2 |\\n+| PA-4 | **Bounded delegation and workflow commands** (trail 428; [baseline](PA4_BASELINE.md)): extend transient `spawn_subagent` and durable operations with a shared validated delegation contract/outcome, enforce authority intersection and recursive/resource limits, then expose real `/goal`, `/loop`, and `/batch` lifecycles through REPL and TUI/sidecar. Reuse `TeamOrchestrator`, `ConvergenceScheduler`, `OperationStore`, `ResourceRegistry`, specialist profiles, provider recovery, completion evidence, and existing stagnation detectors; do not add a second scheduler or workflow store. `/goal` owns an immutable objective and requirement/evidence ledger; `/loop` is bounded and verifier-driven; `/batch` validates a task graph and maps it into existing work units. Parsing, cancellation, pause/resume, status, recovery, and provider-neutral fixtures are part of each command contract. Spec-format validation may proceed independently; lifecycle and shared-contract work depends on PA-1/PA-2 evidence and WP-P10-02, with `/goal` semantics aligned to PA-3. | prompt-only subagent compatibility; parent/profile/session authority intersection and enforced recursive limits; typed non-success and unknown-effect outcomes; each command has durable state, lifecycle controls, recovery and status through supported interfaces; dependency and workspace conflicts cannot silently complete or overwrite; deterministic verifiers and independent review gate acceptance; standard-contract mock plus existing local/cloud fixtures pass without provider changes | L (staged packages) | P1 |\\n \\n ## 5. Sequencing\\n \\n@@ -101,6 +102,7 @@ Phase A (foundation, parallelisable): PF-1, PF-2, GV-4, VR-1, GV-3. These unbloc\\n Phase B: AC-1, HK-1, GV-1, GV-2, PF-4, PA-2, VR-2.\\n Phase C: BG-1, BG-2, HK-2, PF-3, AC-2, PA-1, GV-5.\\n Phase D (stretch, may roll to v1.4): PA-3, HK-3, BG-3.\\n+PA-4 is staged: the existing operation-spec validator can be reused independently; command lifecycles and shared delegation changes follow WP-P10-02 and verified PA-1/PA-2 gates. `/goal` must also satisfy PA-3 before promotion.\\n \\n Dependencies on earlier plans: v1.2.1 RD-3 (`stream-json` output) feeds PF-2; RD-4 (GitHub Action) pairs with VR-1; CS-9 (per-command approval rules, v1.2.2) and GV-1 must agree on rule semantics (allow < prompt < forbidden, deciding rule recorded); MT-1 (the `agent.ts` split) makes AC-1 and BG-1 much easier and should land first if possible; PR-* (provider registry) is independent; MQ-* (measurement) should publish at least one result before this release claims anything.\\n \\n\"}}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"f208f0\",\"wall_time_seconds\":0.000048745,\"exit_code\":1,\"original_token_count\":2747,\"output\":\"Warning: truncated output (original token count: 2747)\\nTotal output lines: 80\\n\\n2026-11-21T08:46:03+00:00 RELEASE FILE_cli_src_batch.ts after PR #659 merged as 22a7dd60\\n2026-11-21T08:46:03+00:00 RELEASE FILE_cli_src_core_operation.ts after PR #659 merged as 22a7dd60\\n2026-11-21T08:46:03+00:00 RELEASE FILE_cli_src_core_operation_runner.ts after PR #659 merged as 22a7dd60\\n2026-11-21T08:46:03+00:00 RELEASE FILE_cli_src_core_operation_runner_persistence.ts after PR #659 merged as 22a7dd60\\n2026-11-21T08:46:03+00:00 RELEASE FILE_cli_src_core_operation_schema.ts after PR #659 merged as 22a7dd60\\n2026-11-