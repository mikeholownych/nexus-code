nreleased = []\nfor owner in sorted(claims.glob('*/owner.json')):\n    try:\n        data = json.loads(owner.read_text())\n    except Exception:\n        continue\n    branch = data.get('branch')\n    if branch in branches:\n        name = owner.parent.name\n        shutil.rmtree(owner.parent)\n        released.append((name, branch, branches[branch]))\nlog = pathlib.Path('.git/nexus-claims.log')\nwith log.open('a') as f:\n    for name, branch, reason in released:\n        f.write(f\"{datetime.datetime.now(datetime.timezone.utc).isoformat()} release {name} branch={branch} outcome={reason}\\n\")\nprint(f'released {len(released)} claims')\nfor row in released:\n    print(*row)\nPY\ngit worktree remove /home/mike/nexus-wt/v12x-claude-auth-reconcile\ngit worktree remove /home/mike/nexus-wt/v1-2x-cs6-multifile\ngit worktree remove /home/mike/nexus-wt/v1-2x-mcp-no-replay\ngit branch -D v1/v1.2x-claude-auth-reconcile v1/v1.2x-cs6-multifile v1/v1.2x-mcp-no-replay\ngit worktree list --porcelain; git status --short --branch"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"released 18 claims\nFILE_cli_src_client.ts v1/v1.2x-claude-auth-reconcile merged PR #638\nFILE_cli_src_core_operation.ts v1/v1.2x-claude-auth-reconcile merged PR #638\nFILE_cli_src_credentials.ts v1/v1.2x-claude-auth-reconcile merged PR #638\nFILE_cli_src_doctor.ts v1/v1.2x-claude-auth-reconcile merged PR #638\nFILE_cli_src_mcp.ts v1/v1.2x-mcp-no-replay merged PR #641\nFILE_cli_src_oauth.ts v1/v1.2x-claude-auth-reconcile merged PR #638\nFILE_cli_src_operation_cli.ts v1/v1.2x-claude-auth-reconcile merged PR #638\nFILE_cli_src_plugins.ts v1/v1.2x-claude-auth-reconcile merged PR #638\nFILE_cli_src_workspace_trust.ts v1/v1.2x-claude-auth-reconcile merged PR #638\nFILE_cli_test_context_management.test.ts v1/v1.2x-claude-auth-reconcile merged PR #638\nFILE_cli_test_durable_private_writers.test.ts v1/v1.2x-claude-auth-reconcile merged PR #638\nFILE_cli_test_lsp_real_servers.test.ts v1/v1.