ts, work units, provider recovery and tool dispatch.\n3. Enforce before dispatch and before any retry; classify exhaustion as `BLOCKED`/`LIMIT_REACHED`, never `VERIFIED` or successful operation completion.\n4. Add ceilings for response streaming and whole-turn wall time, including a finite total timeout for local inference streams; idle timeout remains separate.\n5. Report dimension, configured limit, consumed amount and resume behavior in CLI/TUI result.\n\n**Required tests / acceptance:** Model emits distinct writes indefinitely: run stops at exact step/tool/token/time budget with nonzero/non-success result. Nested subagent shares remaining budget. Repeated provider failures consume retry allowance. Exhaustion followed by process restart and resume does not reset counters. Resume near limit permits only remaining budget. A hung local tool and slow-drip stream stop by configured deadline. Budget persistence write failure prevents new side-effectful dispatch.\n\n**Migration / rollback:** New config defaults may shorten formerly unlimited runs; provide an explicit operator override with a hard documented maximum, not Infinity. Keep old records readable. Rollback must not turn persisted exhausted state into zero; older binaries should refuse unsupported budget schema versions. Residual risk: already-running external calls may finish after cancellation or have unknown outcomes.\n\n## WP-P10-03 — Acceptance evidence integrity and export\n\n**Priority:** P1 · **Complexity:** M · **Dependencies:** WP-P10-01 for independent policy identity.\n\norigin/main:cli/src/agent.ts:89:  private delegatedBudget?: { maxInferenceSteps: number; steps: number };\norigin/main:cli/src/agent.ts:357:    inheritedWorktreeScopeOrOptions?: { workspace: string; requireSandbox: true } | { durable?: boolean; role?: AgentRole; unitId?: string; delegatedToolAllowList?: readonly string[]; delegatedAuthorityGrants?: AuthorityGrant[]; delegatedBudget?: { maxInferenceSteps: number; steps: number } },\norigin/main:cli/src/agent.ts:358:    options?: { durable?: boolean; role?: AgentRole; unitId?: string; delegatedToolAllowList?: readonly string[]; delegatedAuthorityGrants?: AuthorityGrant[]; delegatedBudget?: { maxInferenceSteps: number; steps: number } },\norigin/main:cli/src/agent.ts:379:    let delegatedBudgetOption: { maxInferenceSteps: number; steps: number } | undefined;\norigin/main:cli/src/agent.ts:396:        delegatedBudgetOption = (inheritedWorktreeScopeOrOptions as { delegatedBudget?: { maxInferenceSteps: number; steps: number } }).delegatedBudget;\norigin/main:cli/src/agent.ts:4628:    const maxTotalSteps = this.config.continuation?.maxTotalSteps ?? this.config.maxSteps;\norigin/main:cli/src/agent.ts:4644:      if (this.delegatedBudget && this.delegatedBudget.steps >= this.delegatedBudget.maxInferenceSteps) {\norigin/main:cli/src/agent.ts:4645:        return { completed: false, summary: finalSummary, reason: `delegated inference budget exhausted (${this.delegatedBudget.steps}/${this.delegatedBudget.maxInferenceSteps})` };\norigin/main:cli/src/agent.ts:4648:      if (consumedTaskSteps >= maxTotalSteps) {\norigin/main:cli/src/agent.ts:4649:        return { completed: false, summary: finalSummary, reason: `objective step budget exhausted (${consumedTaskSteps}/${maxTotalSteps}); no further subagent inference was submitted` };\norigin/main:cli/src/config.ts:758:  const steps = positive(options.maxTotalSteps, effectiveSetting(\"NEXUS_MAX_TOTAL_STEPS\"), DEFAULT_CONTINUATION.maxTotalSteps, MAX_CONTINUATION_STEPS);\norigin/main:cli/src/config.ts:761:    maxTotalSteps: Number.isFinite(steps) ? Math.floor(steps) : steps,\nori…1736 tokens truncated…cts(ledger: ObjectiveLedger, answer: (conflict: SteeringConflict) => boolean | undefined, note: (text: string) => string, at = now()): SteeringConflict[] {\norigin/main:cli/src/core/objective.ts:706:export function settleSteeringConflicts(ledger: ObjectiveLedger, at = now()): SteeringConflict[] {\norigin/main:cli/src/core/objective.ts:718:export function supersededBy(previous: ObjectiveLedger, at = now()): SupersededObjective | undefined {\norigin/main:cli/src/core/objective.ts:736:export function invalidateVerified(ledger: ObjectiveLedger, reason: string, at = now(), keep?: (r: Requirement) => boolean): string[] {\norigin/main:cli/src/core/objective.ts:866:  ledger: ObjectiveLedger,\norigin/main:cli/src/core/objective.ts:886:export function recordAttempt(ledger: ObjectiveLedger, attempt: Omit<VerificationAttempt, \"n\" | \"at\">, at = now(), obligationOutput?: string): VerificationAttempt {\norigin/main:cli/src/core/objective.ts:937:  ledger: Pick<ObjectiveLedger, \"verification\" | \"convergenceResetAfter\">,\norigin/main:cli/src/core/objective.ts:997:  ledger: ObjectiveLedger,\norigin/main:cli/src/core/objective.ts:1112:export function missingGatingRequirements(ledger: ObjectiveLedger, sent: string): string[] {\norigin/main:cli/src/core/objective.ts:1190:export function recoveryInput(ledger: ObjectiveLedger): { objective: string; open: Array<{ id: string; text: string }>; execution: ExecutionTracking } {\norigin/main:cli/src/core/objective.ts:1195:export function ledgerNeedsPinning(ledger: ObjectiveLedger, objectiveInContext: boolean): boolean {\norigin/main:cli/src/core/objective.ts:1209:export function requirementRows(ledger: ObjectiveLedger): Array<[string, string]> {\norigin/main:cli/src/core/objective.ts:1303:  ledger: ObjectiveLedger,\norigin/main:cli/src/core/regression_obligations.ts:13:import type { ObjectiveLedger, VerificationAttempt } from \"./objective.js\";\norigin/main:cli/src/core/regression_obligations.ts:45:function confirmedFailure(ledger: ObjectiveLedger, attempt: number, testName: string): VerificationAttempt | string {\norigin/main:cli/src/core/regression_obligations.ts:54:export function authoriseObligation(ledger: ObjectiveLedger, req: { authority: \"operator\"; attempt: number; testName: string; at?: string }): Authorisation {\norigin/main:cli/src/core/regression_obligations.ts:84:export function minimiseObligation(ledger: ObjectiveLedger, id: string, to: { attempt: number; testName: string }): Authorisation {\norigin/main:cli/src/core/regression_obligations.ts:95:export function retireObligation(ledger: ObjectiveLedger, id: string): Authorisation {\norigin/main:cli/src/core/regression_obligations.ts:102:const active = (ledger: ObjectiveLedger) => (ledger.obligations ?? []).filter((o) => o.status === \"active\");\norigin/main:cli/src/core/regression_obligations.ts:105:export function replayCommands(ledger: ObjectiveLedger): string[] {\norigin/main:cli/src/core/regression_obligations.ts:110:export function unmetObligations(ledger: ObjectiveLedger): RegressionObligation[] {\norigin/main:cli/src/core/regression_obligations.ts:122:export function unmetObligationsMessage(ledger: ObjectiveLedger | undefined): string | undefined {\norigin/main:cli/src/core/regression_obligations.ts:184:export function replayObligations(ledger: ObjectiveLedger, attempt: VerificationAttempt, output?: string): void {\norigin/main:cli/src/core/regression_obligations.ts:200:export function recordTestEdit(ledger: ObjectiveLedger, edit: { path: string; before: string; after: string; at?: string }): void {\norigin/main:cli/src/core/regression_obligations.ts:212:export function recordUnverifiableTestEdit(ledger: ObjectiveLedger, path: string, detail: string, at?: string): void {\norigin/main:cli/src/core/regression_obligations.ts:223:export function authoriseReference(ledger: ObjectiveLedger, req: { authority: \"operator\"; requirementId: string; reference: string; at?: string }): Authorisation {\norigin/main:cli/src/core/regression_obligations.ts:245:export function differentialStatus(ledger: ObjectiveLedger, requirementId: string): DifferentialState {\norigin/main:cli/src/core/regression_obligations.ts:295:  ledger: ObjectiveLedger,\norigin/main:cli/src/core/state.ts:24:import type { ObjectiveLedger } from \"./objective.js\";\norigin/main:cli/src/core/state.ts:196:  objective?: ObjectiveLedger | null;\norigin/main:cli/src/core/state.ts:818:      objective?: ObjectiveLedger | null;\norigin/main:cli/src/types.ts:74:  continuation?: ContinuationBudget;\norigin/main:cli/src/types.ts:160:export interface ContinuationBudget {\norigin/main:cli/src/types.ts:185:export function assertValidContinuationBudget(budget: ContinuationBudget | undefined): void {\norigin/main:cli/src/types.ts:195:/** Failed verifier attempts on changing candidates that show no convergence before the turn stops (see ContinuationBudget). */\norigin/main:cli/src/types.ts:198:export const DEFAULT_CONTINUATION: ContinuationBudget = {\n{\"mergeCommit\":{\"oid\":\"3f9e72b55d79e07db1ece4f2a5e05d441ee31c9a\"},\"mergedAt\":\"2026-11-19T19:28:43Z\",\"number\":636,\"state\":\"MERGED\",\"title\":\"fix(agent): persist finite continuation budgets across delegation\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/636\"}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","create_time":1795300661.9867094}},"metadata":{"history_sequence":16373,"sampled_through_sequence":16370,"client_authored":false,"fallback_token_limit_override":12000}}
