{"timestamp":"2026-10-28T16:18:02.316Z","ordinal":463664,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a1834a-d12d-7c43-8f4a-96ee044d0ace","item":{"type":"CommandExecution","id":"exec-41147e7c-a0ba-48f9-b6a9-612926531164","process_id":"50208","command":["/usr/bin/zsh","-lc","rg -n \"restoreGitIndex|gitRefBlobPaths|workspace.*prefix|rev-parse.*show-prefix|checkout-index\" cli/src/checkpoint.ts cli/test/checkpoint_restore.test.ts; sed -n '900,1045p' cli/src/checkpoint.ts; sed -n '1080,1110p' cli/src/checkpoint.ts; sed -n '705,765p' cli/test/checkpoint_restore.test.ts; cat .git/nexus-claims/SUITE/owner.json"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"search","cmd":"rg -n 'restoreGitIndex|gitRefBlobPaths|workspace.*prefix|rev-parse.*show-prefix|checkout-index' cli/src/checkpoint.ts cli/test/checkpoint_restore.test.ts","query":"restoreGitIndex|gitRefBlobPaths|workspace.*prefix|rev-parse.*show-prefix|checkout-index","path":"checkpoint.ts"},{"type":"read","cmd":"sed -n '900,1045p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"read","cmd":"sed -n '1080,1110p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"read","cmd":"sed -n '705,765p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"},{"type":"read","cmd":"cat .git/nexus-claims/SUITE/owner.json","name":"owner.json","path":".git/nexus-claims/SUITE/owner.json"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"cli/src/checkpoint.ts:76:      const prefix = execFileSync(\"git\", [\"rev-parse\", \"--show-prefix\"], {\ncli/src/checkpoint.ts:80:      this.workspacePrefixCache = prefix.replace(/\\\\/g, \"/\");\ncli/src/checkpoint.ts:91:  private restoreGitIndex(gitRef: string, hookGuardEnv: NodeJS.ProcessEnv): void {\ncli/src/checkpoint.ts:623:  /** Tracked file entries that checkout-index may recreate from this checkpoint tree. Gitlinks are not blobs. */\ncli/src/checkpoint.ts:624:  private gitRefBlobPaths(gitRef: string): string[] {\ncli/src/checkpoint.ts:1069:        const checkoutPaths = this.gitRefBlobPaths(cp.gitRef);\ncli/src/checkpoint.ts:1094:        this.restoreGitIndex(cp.gitRef, hookGuardEnv);\ncli/src/checkpoint.ts:1099:        execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"checkout-index\", \"-f\", \"-a\"], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n        typeof entry === \"string\" && entry.length > 0 && !entry.includes(\"\\0\") && !entry.startsWith(\"/\") &&\n        !/^[A-Za-z]:/.test(entry) && path.posix.normalize(entry) === entry && entry !== \"..\" &&\n        !entry.startsWith(\"../\") && !entry.split(\"/\").includes(\".git\"),\n      )) return null;\n      checkpoint.untrackedFiles = [...new Set<string>(raw.untrackedFiles)];\n    }\n    if (Array.isArray(raw.files)) checkpoint.files = raw.files;\n    return checkpoint;\n  }\n\n  /** A snapshot is usable only when it resolves under this checkpoint's own snapshots/<id>. */\n  private confinedSnapshotDir(id: string, value: unknown): string | undefined {\n    if (typeof value !== \"string\" || !path.isAbsolute(value)) return undefined;\n    try {\n      const snapshots = path.join(this.checkpointDir, \"snapshots\");\n      const stat = fs.lstatSync(snapshots);\n      if (!stat.isDirectory() || stat.isSymbolicLink()) return undefined;\n      const root = fs.realpathSync(snapshots);\n      const expected = path.join(root, id);\n      const real = fs.realpathSync(value);\n      return real === expected || real.startsWith(expected + path.sep) ? real : undefined;\n    } catch {\n      return undefined;\n    }\n  }\n\n  public getCheckpoint(id: string): CheckpointInfo | null {\n    const list = this.listCheckpoints();\n    if (list.length === 0) return null;\n    const cleanId = id.trim().toLowerCase();\n    const found = list.find(\n      (cp) => cp.id.toLowerCase() === cleanId || cp.id.toLowerCase().includes(cleanId) || cp.name.toLowerCase().includes(cleanId)\n    );\n    return found || null;\n  }\n\n  public getDiff(checkpointId: string, baseCheckpointId?: string): { success: boolean; diff: string; error?: string } {\n    const cpTarget = this.getCheckpoint(checkpointId);\n    if (!cpTarget) {\n      return { success: false, diff: \"\", error: `Checkpoint '${checkpointId}' not found.` };\n    }\n\n    if (this.isGit && cpTarget.gitRef) {\n      try {\n        if (baseCheckpointId) {\n          const cpBase = this.getCheckpoint(baseCheckpointId);\n          if (!cpBase || !cpBase.gitRef) {\n            return { success: false, diff: \"\", error: `Base checkpoint '${baseCheckpointId}' not found.` };\n          }\n          const out = execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--no-ext-diff\", \"--no-textconv\", cpBase.gitRef, cpTarget.gitRef], {\n            cwd: this.workspace,\n            encoding: \"utf-8\",\n            maxBuffer: 10 * 1024 * 1024,\n          });\n          return { success: true, diff: out };\n        } else {\n          // Diff checkpoint ref against current working tree\n          const out = execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--no-ext-diff\", \"--no-textconv\", cpTarget.gitRef], {\n            cwd: this.workspace,\n            encoding: \"utf-8\",\n            maxBuffer: 10 * 1024 * 1024,\n          });\n          return { success: true, diff: out };\n        }\n      } catch (err: any) {\n        return { success: false, diff: \"\", error: `Failed to compute diff: ${err.message}` };\n      }\n    }\n\n    return {\n      success: true,\n      diff: `[Non-git checkpoint '${cpTarget.id}' - ${cpTarget.name} created at ${cpTarget.timestamp}]`,\n    };\n  }\n\n  public pruneCheckpoints(keepCount: number = 20): { prunedCount: number; message: string } {\n    const checkpoints = this.listCheckpoints();\n    if (checkpoints.length <= keepCount) {\n      return { prunedCount: 0, message: `No pruning needed (${checkpoints.length} checkpoints <= limit of ${keepCount}).` };\n    }\n\n    const toPrune = checkpoints.slice(keepCount);\n    let count = 0;\n    const failures: string[] = [];\n\n    for (const cp of toPrune) {\n      let deletedRefTarget: string | undefined;\n      let hookEnv: NodeJS.ProcessEnv | undefined;\n      const ref = cp.gitRef ? `refs/nexus/checkpoints/${cp.id}` : undefined;\n      try {\n        const jsonPath = path.join(this.checkpointDir, `${cp.id}.json`);\n        if (this.isGit && ref) {\n          // Resolve hook suppression before mutating checkpoint state. Git 2.54 cannot\n          // suppress every configured hook without a discovery race, so retain the record.\n          hookEnv = envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\"]);\n          try {\n            deletedRefTarget = execFileSync(\"git\", [\"show-ref\", \"--hash\", \"--verify\", ref], {\n              cwd: this.workspace,\n              env: hookEnv,\n              encoding: \"utf8\",\n              stdio: [\"ignore\", \"pipe\", \"ignore\"],\n            }).trim();\n          } catch (error: any) {\n            if (error?.status !== 1) throw error;\n          }\n          if (deletedRefTarget) {\n            execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", \"-d\", ref, deletedRefTarget], {\n              cwd: this.workspace,\n              stdio: \"ignore\",\n              env: hookEnv,\n            });\n          }\n        }\n\n        try {\n          if (fs.existsSync(jsonPath)) fs.unlinkSync(jsonPath);\n        } catch (error) {\n          if (deletedRefTarget && ref && hookEnv) {\n            try {\n              execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", ref, deletedRefTarget, \"0\".repeat(deletedRefTarget.length)], {\n                cwd: this.workspace,\n                stdio: \"ignore\",\n                env: hookEnv,\n              });\n            } catch (restoreError: any) {\n              throw new Error(`${error instanceof Error ? error.message : String(error)}; checkpoint ref restoration failed: ${restoreError?.message || String(restoreError)}`);\n            }\n          }\n          throw error;\n        }\n        if (cp.snapshotDir && fs.existsSync(cp.snapshotDir)) {\n          fs.rmSync(cp.snapshotDir, { recursive: true, force: true });\n        }\n        count++;\n      } catch (error: any) {\n        failures.push(`${cp.id}: ${error?.message || String(error)}`);\n      }\n    }\n\n    const message = `Pruned ${count} old checkpoints (retained ${keepCount} most recent).`;\n    return {\n      prunedCount: count,\n      message: failures.length === 0 ? message : `${message} ${failures.length} checkpoint(s) could not be pruned: ${failures.join(\"; \")}`,\n    };\n  }\n\n        }\n        // Validate every path that restore may write or remove before read-tree\n        // mutates the outer index. Tracked deletions are destructive too: they\n        // must not cross into nested repositories in the current worktree.\n        this.assertNoNestedGitRepositoryAncestors(writePaths, this.workspace);\n        // Tracked deletion cleanup intentionally leaves targets behind when a\n        // parent symlink resolves outside the workspace. Preserve that behavior\n        // while still rejecting a nested repository reachable within the tree.\n        this.assertNoNestedGitRepositoryAncestors(removalPaths, this.workspace, true);\n        if (cp.untrackedFiles !== undefined) {\n          const replacementTargets = [...new Set([...cp.untrackedFiles, ...checkoutPaths])];\n          this.assertGitSnapshotTargetsReplaceable(replacementTargets, cp.gitRef);\n        }\n        if (cp.untrackedFiles === undefined) this.assertLegacyUntrackedRestoreSafe(cp.gitRef);\n        this.restoreGitIndex(cp.gitRef, hookGuardEnv);\n        // Remove checkpoint-deleted paths while their current ancestors are still\n        // present. Installing checkpoint symlinks first could redirect deletion\n        // through an in-workspace link into unrelated ignored data.\n        this.removeTrackedDeletions(cp.gitRef, postCheckpointAdditions);\n        execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"checkout-index\", \"-f\", \"-a\"], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n        if (cp.untrackedFiles !== undefined) {\n          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"clean\", \"-fd\"], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n          if (cp.untrackedFiles.length > 0) {\n            this.copyUntrackedEntries(cp.untrackedFiles, cp.snapshotDir!, this.workspace, cp.allowSensitive === true);\n          }\n          return { success: true, message: `Restored workspace to checkpoint '${cp.name}' (${cp.id})` };\n        }\n        return { success: true, message: `Restored tracked workspace to checkpoint '${cp.name}' (${cp.id}); legacy untracked files were not captured and were left unchanged` };\n      }\n\n      if (cp.snapshotDir && cp.untrackedFiles !== undefined) {\n  const workspace = path.join(repo, \"sub\");\n  fs.mkdirSync(workspace);\n  fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"base\\n\");\n  git(\"add\", \"sub/tracked.txt\");\n  git(\"commit\", \"-qm\", \"subdirectory base\");\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.rmSync(path.join(workspace, \"tracked.txt\"));\n    fs.writeFileSync(path.join(workspace, \"draft.txt\"), \"subdirectory untracked draft\\n\");\n    git(\"add\", \"-u\", \"sub/tracked.txt\");\n    const checkpoint = manager.createCheckpoint(\"subdirectory deletion\");\n    git(\"reset\", \"--hard\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.existsSync(path.join(workspace, \"tracked.txt\")), false);\n    assert.equal(fs.readFileSync(path.join(workspace, \"draft.txt\"), \"utf8\"), \"subdirectory untracked draft\\n\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"subdirectory workspace restore preserves sibling worktree and index changes\", () => {\n  const { repo, git } = gitRepo();\n  const workspace = path.join(repo, \"sub\");\n  fs.mkdirSync(workspace);\n  fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"subdirectory base\\n\");\n  git(\"add\", \"tracked.txt\", \"sub/tracked.txt\");\n  git(\"commit\", \"-qm\", \"subdirectory restore base\");\n  const manager = new CheckpointManager(workspace);\n  try {\n    const checkpoint = manager.createCheckpoint(\"subdirectory scoped restore\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"sibling staged work\\n\");\n    git(\"add\", \"tracked.txt\");\n    fs.writeFileSync(path.join(workspace, \"tracked.txt\"), \"subdirectory later work\\n\");\n    git(\"add\", \"sub/tracked.txt\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"sibling staged work\\n\");\n    assert.equal(git(\"show\", \":tracked.txt\"), \"sibling staged work\");\n    assert.equal(fs.readFileSync(path.join(workspace, \"tracked.txt\"), \"utf8\"), \"subdirectory base\\n\");\n    assert.equal(git(\"show\", \":sub/tracked.txt\"), \"subdirectory base\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"tracked deletion cleanup runs before a checkpoint symlink can redirect it\", () => {\n  const { repo, git } = gitRepo();\n  const alias = path.join(repo, \"alias\");\n  const data = path.join(repo, \"data\");\n  fs.mkdirSync(alias);\n  fs.writeFileSync(path.join(alias, \"file\"), \"tracked alias file\\n\");\n  fs.mkdirSync(data);\n  fs.writeFileSync(path.join(data, \"file\"), \"ignored data must survive\\n\");\n  fs.writeFileSync(path.join(repo, \".gitignore\"), \"data/\\n\");\ncat: .git/nexus-claims/SUITE/owner.json: Not a directory\n","exit_code":1,"duration":{"secs":0,"nanos":986675938}},"started_at_ms":1793204281326,"completed_at_ms":1793204282313}}
