{"type":"file-history-delta","messageId":"3026bfa0-5951-4b5e-93fe-b5de0116ab45","snapshotMessageId":"abca5e7e-c323-4cf5-8f4e-c8b6a618b236","trackingPath":"/tmp/claude-1000/-home-mike-nexus-code/43bcbb67-2cff-4fa8-a05e-f8aa598df73b/scratchpad/rev771.md","backup":{"backupFileName":null,"version":1,"backupTime":"2026-11-24T05:59:00.127Z","realParentDir":"/tmp/claude-1000/-home-mike-nexus-code/43bcbb67-2cff-4fa8-a05e-f8aa598df73b/scratchpad"},"timestamp":"2026-11-24T05:59:00.127Z"}
