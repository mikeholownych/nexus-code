);\\n   444\\t    if (changedPaths.some((relativePath) => path.basename(relativePath) === \\\".gitignore\\\")) {\\n   445\\t      throw new Error(\\\"Checkpoint Git ignore rules differ from the current worktree\\\");\\n   446\\t    }\\n   447\\t\\n   448\\t    for (const relativePath of directoryTargets) {\\n   449\\t      // A clean preview can be empty when the directory path is also tracked in the index,\\n   450\\t      // even though ordinary untracked children beneath it are removable.\\n   451\\t      if (this.directoryContainsOnlyGitCleanRemovableEntries(relativePath)\\n   452\\t        && this.gitTrackedDescendantPaths(relativePath).length === 0) {\\n   453\\t        continue;\\n   454\\t      }\\n   455\\t      if (!this.directoryContainsOnlyTrackedRemovableEntries(relativePath)) {\\n   456\\t        throw new Error(\\\"Checkpoint snapshot target directory contains entries preserved by Git clean\\\");\\n   457\\t      }\\n   458\\t    }\\n   459\\t  }\\n   460\\t\\n   461\\t  /** Tracked file entries that checkout-index may recreate from this checkpoint tree. Gitlinks are not blobs. */\\n   462\\t  private gitRefBlobPaths(gitRef: string): string[] {\\n   463\\t    const entries = execFileSync(\\\"git\\\", [\\\"-c\\\", \\\"core.fsmonitor=false\\\", \\\"ls-tree\\\", \\\"-r\\\", \\\"-z\\\", \\\"--full-tree\\\", gitRef], {\\n   464\\t      cwd: this.workspace,\\n   465\\t      encoding: \\\"buffer\\\",\\n   150\\t    const checkpoint = manager.createCheckpoint(\\\"partial snapshot\\\");\\n   151\\t    fs.rmSync(path.join(checkpoint.snapshotDir!, \\\"draft.txt\\\"));\\n   152\\t    fs.writeFileSync(path.join(repo, \\\"draft.txt\\\"), \\\"current work must survive\\\\n\\\");\\n   153\\t\\n   154\\t    const result = manager.restore(checkpoint.id);\\n   155\\t\\n   156\\t    assert.equal(result.success, false);\\n   157\\t    assert.match(result.message, /untracked snapshot/i);\\n   158\\t    assert.equal(fs.readFileSync(path.join(repo, \\\"draft.txt\\\"), \\\"utf8\\\"), \\\"current work must survive\\\\n\\\");\\n   159\\t  } finally {\\n   160\\t    cleanupGitRepo(repo);\\n   161\\t  }\\n   162\\t});\\n   163\\t\\n   164\\ttest(\\\"restore preserves untracked symlinks without copying their external targets\\\", () => {\\n   165\\t  const { repo } = gitRepo();\\n   166\\t  const external = path.join(os.tmpdir(), `${path.basename(repo)}-external.txt`);\\n   167\\t  const manager = new CheckpointManager(repo);\\n   168\\t  try {\\n   169\\t    fs.writeFileSync(external, \\\"external target must not be copied\\\\n\\\");\\n   170\\t    fs.symlinkSync(external, path.join(repo, \\\"draft-link.txt\\\"));\\n   171\\t    const checkpoint = manager.createCheckpoint(\\\"symbolic link\\\");\\n   172\\t    fs.rmSync(path.join(repo, \\\"draft-link.txt\\\"));\\n   173\\t    fs.writeFileSync(path.join(repo, \\\"draft-link.txt\\\"), \\\"later regular file\\\\n\\\");\\n   174\\t\\n   175\\t    const result = manager.restore(checkpoint.id);\\n   176\\t\\n   177\\t    assert.equal(result.success, true, result.message);\\n   178\\t    assert.equal(fs.lstatSync(path.join(repo, \\\"draft-link.txt\\\")).isSymbolicLink(), true);\\n   179\\t    assert.equal(fs.readlinkSync(path.join(repo, \\\"draft-link.txt\\\")), external);\\n   180\\t    assert.equal(fs.lstatSync(path.join(checkpoint.snapshotDir!, \\\"draft-link.txt\\\")).isSymbolicLink(), true);\\n   181\\t  } finally {\\n   182\\t    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\\n   183\\t    cleanupGitRepo(repo);\\n   184\\t    fs.rmSync(external, { force: true });\\n   185\\t  }\\n   186\\t});\\n   187\\t\\n   188\\ttest(\\\"legacy restore removes tracked files deleted at the checkpoint\\\", () => {\\n   189\\t  const { repo, git } = gitRepo();\\n   190\\t  try {\\n   191\\t    fs.rmSync(path.join(repo, \\\"tracked.txt\\\"));\\n   192\\t    const head = git(\\\"rev-parse\\\", \\\"HEAD\\\");\\n   193\\t    const manager = new CheckpointManager(repo);\\n   194\\t    const checkpoint = manager.createCheckpoint(\\\"legacy tracked deletion\\\");\\n   195\\t    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\\n   196\\t    const record = JSON.parse(fs.readFileSync(recordPath, \\\"utf8\\\"));\\n   197\\t    delete record.untrackedFiles;\\n   198\\t    fs.writeFileSync(recordPath, JSON.stringify(record));\\n   199\\t    fs.writeFileSync(path.join(repo, \\\"tracked.txt\\\"), \\\"recreated later\\\\n\\\");\\n   200\\t\\n   201\\t    const result = manager.restore(checkpoint.id);\\n   202\\t\\n   203\\t    assert.equal(result.success, true, result.message);\\n   204\\t    assert.equal(git(\\\"rev-parse\\\", \\\"HEAD\\\"), head);\\n   205\\t    assert.equal(fs.existsSync(path.join(repo, \\\"tracked.txt\\\")), false);\\n   206\\t  } finally {\\n   207\\t    cleanupGitRepo(repo);\\n   208\\t  }\\n   209\\t});\\n   210\\t\\n   211\\ttest(\\\"a checkpoint manifest cannot write into Git metadata\\\", () => {\\n   212\\t  const { repo, git } = gitRepo();\\n   213\\t  try {\\n   214\\t    const head = git(\\\"rev-parse\\\", \\\"HEAD\\\");\\n   215\\t    fs.writeFileSync(path.join(repo, \\\"draft.txt\\\"), \\\"ordinary snapshot\\\\n\\\");\\n   216\\t    const manager = new CheckpointManager(repo);\\n   217\\t    const checkpoint = manager.createCheckpoint(\\\"malformed manifest\\\");\\n   218\\t    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\\n   219\\t    const record = JSON.parse(fs.readFileSync(recordPath, \\\"utf8\\\"));\\n   220\\t    record.untrackedFiles = [\\\".git/HEAD\\\"];\\n   221\\t    fs.writeFileSync(recordPath, JSON.stringify(record));\\n   222\\t    fs.mkdirSync(path.join(checkpoint.snapshotDir!, \\\".git\\\"), { recursive: true });\\n   223\\t    fs.writeFileSync(path.join(checkpoint.snapshotDir!, \\\".git\\\", \\\"HEAD\\\"), \\\"malicious replacement\\\\n\\\");\\n   224\\t\\n   225\\t    const result = manager.restore(checkpoint.id);\\n   226\\t\\n   227\\t    assert.equal(result.success, false);\\n   228\\t    assert.equal(git(\\\"rev-parse\\\", \\\"HEAD\\\"), head);\\n   229\\t    assert.notEqual(fs.readFileSync(path.join(repo, \\\".git\\\", \\\"HEAD\\\"), \\\"utf8\\\"), \\\"malicious replacement\\\\n\\\");\\n   230\\t  } finally {\\n   231\\t    cleanupGitRepo(repo);\\n   232\\t  }\\n   233\\t});\\n   234\\t\\n   235\\ttest(\\\"tracked deletion cleanup never follows a parent symlink outside the workspace\\\", () => {\\n   236\\t  const { repo, git } = gitRepo();\\n   237\\t  const external = fs.mkdtempSync(path.join(os.tmpdir(), \\\"nexus-checkpoint-external-\\\"));\\n   238\\t  try {\\n   239\\t    fs.mkdirSync(path.join(repo, \\\"dir\\\"));\\n   240\\t    fs.writeFileSync(path.join(repo, \\\"dir\\\", \\\"file.txt\\\"), \\\"tracked\\\\n\\\");\\n   241\\t    git(\\\"add\\\", \\\"dir/file.txt\\\");\\n   242\\t    git(\\\"commit\\\", \\\"-qm\\\", \\\"add tracked directory\\\");\\n   243\\t    fs.rmSync(path.join(repo, \\\"dir\\\"), { recursive: true });\\n   244\\t    const manager = new CheckpointManager(repo);\\n   245\\t    const checkpoint = manager.createCheckpoint(\\\"parent symlink\\\");\\n   246\\t    fs.writeFileSync(path.join(external, \\\"file.txt\\\"), \\\"external canary\\\\n\\\");\\n   247\\t    fs.symlinkSync(external, path.join(repo, \\\"dir\\\"));\\n   248\\t\\n   249\\t    const result = manager.restore(checkpoint.id);\\n   250\\t\\n   251\\t    assert.equal(result.success, true, result.message);\\n   252\\t    assert.equal(fs.readFileSync(path.join(external, \\\"file.txt\\\"), \\\"utf8\\\"), \\\"external canary\\\\n\\\");\\n   253\\t  } finally {\\n   254\\t    cleanupGitRepo(repo);\\n   255\\t    fs.rmSync(external, { recursive: true, force: true });\\n   256\\t  }\\n   257\\t});\\n   258\\t\\n   259\\ttest(\\\"untracked restore refuses an ignored destination parent symlink\\\", () => {\\n   260\\t  const { repo } = gitRepo();\\n   261\\t  const external = fs.mkdtempSync(path.join(os.tmpdir(), \\\"nexus-checkpoint-ignored-external-\\\"));\\n   262\\t  try {\\n   263\\t    fs.mkdirSync(path.join(repo, \\\"alias\\\"));\\n   264\\t    fs.writeFileSync(path.join(repo, \\\"alias\\\", \\\"file.txt\\\"), \\\"captured\\\\n\\\");\\n   265\\t    const manager = new CheckpointManager(repo);\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1831e-47db-7583-982e-1aab45c43e6a","create_time":1793202007.9942377}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
