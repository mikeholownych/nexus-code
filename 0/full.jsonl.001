{"timestamp":"2026-10-28T15:39:19.868Z","ordinal":462199,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a1831e-47db-7583-982e-1aab45c43e6a","item":{"type":"CommandExecution","id":"exec-7c8182a9-5515-4eec-bfa1-cbe882887944","process_id":"74733","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --stat --oneline --decorate HEAD; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --format=fuller --no-patch HEAD; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff --stat 3c52580ae1da6b7f1282018f4d3702dcb75f8bd7..HEAD; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff 3c52580ae1da6b7f1282018f4d3702dcb75f8bd7..HEAD -- cli/src/checkpoint.ts cli/test/checkpoint_restore.test.ts | sed -n '1,260p'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --stat --oneline --decorate HEAD; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix show --format=fuller --no-patch HEAD; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff --stat 3c52580ae1da6b7f1282018f4d3702dcb75f8bd7..HEAD; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff 3c52580ae1da6b7f1282018f4d3702dcb75f8bd7..HEAD -- cli/src/checkpoint.ts cli/test/checkpoint_restore.test.ts | sed -n '1,260p'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"72939ec8 (HEAD -> v1/checkpoint-ordinary-child-fix, origin/v1/defect-checkpoint-untracked-integration) fix(checkpoint): reject partial nested bare repositories\n cli/src/checkpoint.ts               |  33 +++++++---\n cli/test/checkpoint_restore.test.ts | 124 ++++++++++++++++++++++++++++++++++++\n 2 files changed, 149 insertions(+), 8 deletions(-)\ncommit 72939ec8da37bc22509c8c87ebaacc5de7724f02\nAuthor:     Mike Holownych <mike@holownych.com>\nAuthorDate: Wed Oct 28 15:37:51 2026 +0000\nCommit:     Mike Holownych <mike@holownych.com>\nCommitDate: Wed Oct 28 15:37:51 2026 +0000\n\n    fix(checkpoint): reject partial nested bare repositories\n cli/src/checkpoint.ts               |  33 +++++++---\n cli/test/checkpoint_restore.test.ts | 124 ++++++++++++++++++++++++++++++++++++\n 2 files changed, 149 insertions(+), 8 deletions(-)\ndiff --git a/cli/src/checkpoint.ts b/cli/src/checkpoint.ts\nindex d4679363..62df96f4 100644\n--- a/cli/src/checkpoint.ts\n+++ b/cli/src/checkpoint.ts\n@@ -214,14 +214,21 @@ export class CheckpointManager {\n         const bareConfig = fs.lstatSync(bareConfigPath, { throwIfNoEntry: false });\n         const bareObjects = fs.lstatSync(path.join(parent, \"objects\"), { throwIfNoEntry: false });\n         const bareRefs = fs.lstatSync(path.join(parent, \"refs\"), { throwIfNoEntry: false });\n-        const hasBareRepositoryLayout = bareHead?.isFile()\n-          && !bareHead.isSymbolicLink()\n-          && bareConfig?.isFile()\n-          && !bareConfig.isSymbolicLink()\n-          && bareObjects?.isDirectory()\n-          && !bareObjects.isSymbolicLink()\n-          && bareRefs?.isDirectory()\n-          && !bareRefs.isSymbolicLink();\n+        const bareRepositoryMarkerCount = [bareHead, bareObjects, bareRefs].filter(Boolean).length;\n+        const hasBareRepositoryMarkers = bareRepositoryMarkerCount > 0;\n+        const hasBareRepositoryShape = bareRepositoryMarkerCount >= 2;\n+        if (hasBareRepositoryMarkers && bareConfig && (\n+          (bareHead && (!bareHead.isFile() || bareHead.isSymbolicLink()))\n+          || (bareObjects && (!bareObjects.isDirectory() || bareObjects.isSymbolicLink()))\n+          || (bareRefs && (!bareRefs.isDirectory() || bareRefs.isSymbolicLink()))\n+          || !bareConfig.isFile() || bareConfig.isSymbolicLink()\n+        )) {\n+          throw new Error(\"Checkpoint destination has an ambiguous bare Git repository layout\");\n+        }\n+        if (hasBareRepositoryShape && !bareConfig) {\n+          throw new Error(\"Checkpoint destination has an ambiguous bare Git repository layout\");\n+        }\n+        const hasBareRepositoryLayout = hasBareRepositoryMarkers && !!bareConfig && bareConfig.isFile() && !bareConfig.isSymbolicLink();\n         let declaresBareRepository = false;\n         if (hasBareRepositoryLayout && bareConfig) {\n           if (bareConfig.size > 1024 * 1024) {\n@@ -230,6 +237,16 @@ export class CheckpointManager {\n           let inCoreSection = false;\n           for (const line of fs.readFileSync(bareConfigPath, \"utf8\").split(/\\r?\\n/)) {\n             const entry = line.replace(/[;#].*$/, \"\").trim();\n+            if (/\\\\\\s*$/.test(entry)) {\n+              // Git joins continued values across lines; this parser intentionally\n+              // does not emulate that syntax, so reject it rather than miss core.bare.\n+              throw new Error(\"Checkpoint destination Git configuration uses line continuations\");\n+            }\n+            if (/^\\[\\s*include(?:if)?(?:\\s|\\])/i.test(entry)) {\n+              // An include may change core.bare after this file is parsed. Do not\n+              // try to partially reproduce Git's includeIf matching here.\n+              throw new Error(\"Checkpoint destination Git configuration uses includes\");\n+            }\n             if (/^\\[\\s*core\\s*\\]$/i.test(entry)) {\n               inCoreSection = true;\n             } else if (/^\\[/.test(entry)) {\ndiff --git a/cli/test/checkpoint_restore.test.ts b/cli/test/checkpoint_restore.test.ts\nindex 294c3732..ac799b8c 100644\n--- a/cli/test/checkpoint_restore.test.ts\n+++ b/cli/test/checkpoint_restore.test.ts\n@@ -1049,6 +1049,9 @@ test(\"Git manifest restore refuses to copy an untracked file into a nested bare\n \n     fs.rmSync(path.join(bareRepo, \"captured.txt\"));\n     execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", bareRepo]);\n+    fs.writeFileSync(path.join(bareRepo, \"config\"), \"[core]\\n\\tfilemode = true\\n[include]\\n\\tpath = bare-core.ini\\n\");\n+    fs.writeFileSync(path.join(bareRepo, \"bare-core.ini\"), \"[core]\\n\\tbare = true\\n\");\n+    assert.equal(execFileSync(\"git\", [\"-C\", bareRepo, \"config\", \"--bool\", \"core.bare\"], { encoding: \"utf8\" }).trim(), \"true\");\n     const bareHeadBefore = fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\");\n     const bareConfigBefore = fs.readFileSync(path.join(bareRepo, \"config\"), \"utf8\");\n     fs.writeFileSync(path.join(bareRepo, \"repository-canary.txt\"), \"bare repository canary\\n\");\n@@ -1075,6 +1078,127 @@ test(\"Git manifest restore refuses to copy an untracked file into a nested bare\n   }\n });\n \n+test(\"Git manifest restore refuses a nested bare repository with a symlinked config\", () => {\n+  const { repo, git } = gitRepo();\n+  const bareRepo = path.join(repo, \"nested-bare\");\n+  const externalConfig = path.join(repo, \"external-bare-config\");\n+  try {\n+    fs.mkdirSync(bareRepo);\n+    fs.writeFileSync(path.join(bareRepo, \"captured.txt\"), \"checkpoint content\\n\");\n+    const manager = new CheckpointManager(repo);\n+    const checkpoint = manager.createCheckpoint(\"nested bare repository with symlinked config\");\n+\n+    fs.rmSync(path.join(bareRepo, \"captured.txt\"));\n+    execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", bareRepo]);\n+    fs.writeFileSync(externalConfig, \"[core]\\n\\tbare = true\\n\");\n+    fs.rmSync(path.join(bareRepo, \"config\"));\n+    fs.symlinkSync(externalConfig, path.join(bareRepo, \"config\"));\n+    assert.equal(execFileSync(\"git\", [\"-C\", bareRepo, \"config\", \"--bool\", \"core.bare\"], { encoding: \"utf8\" }).trim(), \"true\");\n+    const bareHeadBefore = fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\");\n+    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n+\n+    const result = manager.restore(checkpoint.id);\n+\n+    assert.equal(result.success, false);\n+    assert.match(result.message, /destination|unsafe|snapshot/i);\n+    assert.equal(fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\"), bareHeadBefore);\n+    assert.equal(fs.existsSync(path.join(bareRepo, \"captured.txt\")), false, \"rejection must not copy the captured file into the bare repository\");\n+    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n+  } finally {\n+    cleanupGitRepo(repo);\n+  }\n+});\n+\n+test(\"Git manifest restore refuses a nested bare repository with symlinked object storage\", () => {\n+  const { repo, git } = gitRepo();\n+  const bareRepo = path.join(repo, \"nested-bare\");\n+  const externalObjects = path.join(repo, \"external-bare-objects\");\n+  try {\n+    fs.mkdirSync(bareRepo);\n+    fs.writeFileSync(path.join(bareRepo, \"captured.txt\"), \"checkpoint content\\n\");\n+    const manager = new CheckpointManager(repo);\n+    const checkpoint = manager.createCheckpoint(\"nested bare repository with symlinked object storage\");\n+\n+    fs.rmSync(path.join(bareRepo, \"captured.txt\"));\n+    execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", bareRepo]);\n+    fs.renameSync(path.join(bareRepo, \"objects\"), externalObjects);\n+    fs.symlinkSync(externalObjects, path.join(bareRepo, \"objects\"), \"dir\");\n+    assert.equal(execFileSync(\"git\", [\"-C\", bareRepo, \"config\", \"--bool\", \"core.bare\"], { encoding: \"utf8\" }).trim(), \"true\");\n+    const bareHeadBefore = fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\");\n+    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n+\n+    const result = manager.restore(checkpoint.id);\n+\n+    assert.equal(result.success, false);\n+    assert.match(result.message, /destination|unsafe|snapshot/i);\n+    assert.equal(fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\"), bareHeadBefore);\n+    assert.equal(fs.existsSync(path.join(bareRepo, \"captured.txt\")), false, \"rejection must not copy the captured file into the bare repository\");\n+    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n+  } finally {\n+    cleanupGitRepo(repo);\n+  }\n+});\n+\n+test(\"Git manifest restore refuses a nested bare repository with continued core config\", () => {\n+  const { repo, git } = gitRepo();\n+  const bareRepo = path.join(repo, \"nested-bare\");\n+  try {\n+    fs.mkdirSync(bareRepo);\n+    fs.writeFileSync(path.join(bareRepo, \"captured.txt\"), \"checkpoint content\\n\");\n+    const manager = new CheckpointManager(repo);\n+    const checkpoint = manager.createCheckpoint(\"nested bare repository with continued config\");\n+\n+    fs.rmSync(path.join(bareRepo, \"captured.txt\"));\n+    execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", bareRepo]);\n+    fs.writeFileSync(path.join(bareRepo, \"config\"), \"[core]\\n\\tbare = \\\\\\n\\ttrue\\n\");\n+    assert.equal(execFileSync(\"git\", [\"-C\", bareRepo, \"config\", \"--bool\", \"core.bare\"], { encoding: \"utf8\" }).trim(), \"true\");\n+    const bareHeadBefore = fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\");\n+    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n+\n+    const result = manager.restore(checkpoint.id);\n+\n+    assert.equal(result.success, false);\n+    assert.match(result.message, /destination|unsafe|snapshot/i);\n+    assert.equal(fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\"), bareHeadBefore);\n+    assert.equal(fs.existsSync(path.join(bareRepo, \"captured.txt\")), false, \"rejection must not copy the captured file into the bare repository\");\n+    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n+  } finally {\n+    cleanupGitRepo(repo);\n+  }\n+});\n+\n+test(\"Git manifest restore refuses a partial bare repository whose config declares bare mode\", () => {\n+  const { repo, git } = gitRepo();\n+  const bareRepo = path.join(repo, \"nested-bare\");\n+  try {\n+    fs.mkdirSync(bareRepo);\n+    fs.writeFileSync(path.join(bareRepo, \"captured.txt\"), \"checkpoint content\\n\");\n+    const manager = new CheckpointManager(repo);\n+    const checkpoint = manager.createCheckpoint(\"partial nested bare repository\");\n+\n+    fs.rmSync(path.join(bareRepo, \"captured.txt\"));\n+    execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", bareRepo]);\n+    fs.rmSync(path.join(bareRepo, \"objects\"), { recursive: true });\n+    fs.rmSync(path.join(bareRepo, \"refs\"), { recursive: true });\n+    fs.writeFileSync(path.join(bareRepo, \"config\"), \"[core]\\n\\tbare = true\\n\");\n+    assert.equal(fs.existsSync(path.join(bareRepo, \"HEAD\")), true);\n+    assert.equal(fs.existsSync(path.join(bareRepo, \"objects\")), false);\n+    assert.equal(fs.existsSync(path.join(bareRepo, \"refs\")), false);\n+    const bareHeadBefore = fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\");\n+    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n+\n+    const result = manager.restore(checkpoint.id);\n+\n+    assert.equal(result.success, false);\n+    assert.match(result.message, /destination|unsafe|snapshot/i);\n+    assert.equal(fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\"), bareHeadBefore);\n+    assert.equal(fs.existsSync(path.join(bareRepo, \"captured.txt\")), false, \"rejection must not copy the captured file into the partial bare repository\");\n+    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n+  } finally {\n+    cleanupGitRepo(repo);\n+  }\n+});\n+\n test(\"Git manifest restore allows an ordinary directory with bare-repository-like names\", () => {\n   const { repo, git } = gitRepo();\n   const lookalike = path.join(repo, \"ordinary-layout\");\n","exit_code":0,"duration":{"secs":0,"nanos":36233}},"started_at_ms":1793201959867,"completed_at_ms":1793201959868}}
