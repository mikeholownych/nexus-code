{"type":"api-request-blob","sessionId":"43bcbb67-2cff-4fa8-a05e-f8aa598df73b","hash":"b85ea336c06da36f912ce5efa8ae3eb5a6032b800ee1baf8253791296da88581","message":{"role":"user","content":[{"tool_use_id":"toolu_01BDQdetWMdqd8f4PYjZvg95","type":"tool_result","content":"6:import \"./helpers/leak_guard.js\";\n7:import { test, describe, after } from \"node:test\";\n8:import assert from \"node:assert/strict\";\n9:import fs from \"node:fs\";\n10:import os from \"node:os\";\n11:import path from \"node:path\";\n12:import { POLICY_KEYS } from \"../src/core/managed_policy.js\";\n13:import { SYSTEM_POLICY_PATH } from \"../src/core/managed_policy_load.js\";\n14:import { proposedRepairs, type DoctorReport } from \"../src/doctor.js\";\n15:import { checkPolicyFile, effectivePolicyRows, policyFindings, policyReport, renderPolicyFileCheck, renderPolicyReport } from \"../src/policy_cli.js\";\n16:import { FAKE_SYSTEM, FAKE_USER, policyHome, policyWorld, runUnderPolicy, toml } from \"./helpers/policy_enforcement.js\";\n153:    assert.deepEqual(checkPolicyFile(file), { schemaVersion: 1, file, valid: true });\n154:    assert.match(renderPolicyFileCheck(checkPolicyFile(file)), /^VALID: /);\n170:      const result = checkPolicyFile(candidate(content));\nShell cwd was reset to /home/mike/nexus-code","is_error":false}]}}
{"type":"api-request-blob","sessionId":"43bcbb67-2cff-4fa8-a05e-f8aa598df73b","hash":"d6f6799aa2c0995aafe164494e0dbdb0349c245d950b1fdd2e0a58c0442187a8","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01S8cpfzYdPW6E1WVEaxgvRC","name":"Bash","input":{"command":"cd ~/nexus-wt/polfu && python3 - <<'EOF'\np='cli/test/policy_cli.test.ts'; s=open(p).read()\ns+='''\ntest(\"policy check does not read a file out through its errors: a rejected token that is not a policy key is cut short\", () => {\n  const dir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-policy-leak-\"));\n  try {\n    // Not a policy at all: a credentials file someone points the command at.\n    const secret = \"REDACTED\";\n    const file = path.join(dir, \"credentials\");\n    fs.writeFileSync(file, `${secret} = also-${secret}\\\\nallow = ${secret}\\\\n`);\n    const result = checkPolicyFile(file);\n    assert.equal(result.valid, false);\n    const shown = JSON.stringify(result) + renderPolicyFileCheck(result);\n    assert.equal(shown.includes(secret), false, shown);\n    assert.equal(shown.includes(secret.slice(0, 12)), false, \"no more than a few characters of a rejected token are shown\");\n    // A mistyped policy key is still named in full: that is what the command is for.\n    const typo = path.join(dir, \"policy.toml\");\n    fs.writeFileSync(typo, \"schema_version = 1\\\\n[approval]\\\\nstrictt = true\\\\n\");\n    assert.match(JSON.stringify(checkPolicyFile(typo)), /strictt/);\n  } finally {\n    fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n'''\nopen(p,'w').write(s)\nEOF\ncd cli && TMPDIR=/dev/shm HOME=$(mktemp -d) timeout 280 node --import tsx --test test/policy_cli.test.ts 2>&1 | rtk proxy grep -E \"^ℹ (pass|fail) |AssertionError\" | cut -c1-260 | head -4; echo \"--- name rule removed:\"; cp src/core/managed_policy.ts /dev/shm/mp.keep.ts; sed -i 's/    return entry === server.name \\&\\& !server.fromWorkspace;/    return entry === server.name;/' src/core/managed_policy.ts; TMPDIR=/dev/shm HOME=$(mktemp -d) timeout 280 node --import tsx --test test/managed_policy_merge.test.ts 2>&1 | rtk proxy grep -E \"^ℹ (pass|fail) |^✖ a name\" | cut -c1-160 | head -3; cp /dev/shm/mp.keep.ts src/core/managed_policy.ts; echo \"--- echo cut removed:\"; cp src/policy_cli.ts /dev/shm/pc.keep.ts; sed -i 's/\\${withoutFileText(error.detail)}/${error.detail}/' src/policy_cli.ts; TMPDIR=/dev/shm HOME=$(mktemp -d) timeout 280 node --import tsx --test test/policy_cli.test.ts 2>&1 | rtk proxy grep -E \"^ℹ (pass|fail) \" | head -2; cp /dev/shm/pc.keep.ts src/policy_cli.ts; npx tsc --noEmit -p . >/dev/null; echo \"restored, tsc $?\"","description":"Add the error-echo test, run it, then confirm each fix's test fails when that fix is removed","timeout":590000},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"43bcbb67-2cff-4fa8-a05e-f8aa598df73b","hash":"b8b6899fa85efaee4e6d0f9d1843935c435225547185accf5c7d73f53684588b","message":{"role":"user","content":[{"tool_use_id":"toolu_01S8cpfzYdPW6E1WVEaxgvRC","type":"tool_result","content":"ℹ pass 24\nℹ fail 0\n--- name rule removed:\n✖ a name in mcp.allow does not admit a server the workspace configures: the repository would choose what runs behind the name (9.065417ms)\nℹ pass 46\nℹ fail 1\n--- echo cut removed:\nℹ pass 23\nℹ fail 1\nrestored, tsc 0\nShell cwd was reset to /home/mike/nexus-code","is_error":false}]}}
{"type":"api-request-blob","sessionId":"43bcbb67-2cff-4fa8-a05e-f8aa598df73b","hash":"04df61c5be824eaf3197ad671e539473a49bedbe48534e1b8fccf4abcaa2aaf1","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01HhjcC2sy6VryM4wgGQBYDg","name":"Bash","input":{"command":"cd ~/nexus-wt/polfu && git fetch -q origin && git add -A cli docs && git commit -q -m \"fix(policy): a name in mcp.allow no longer admits a workspace-defined server; policy check stops echoing file text\n\nFrom the review of the allowlist enforcement:\n\n- With a name-only entry in mcp.allow, a workspace .mcp.json could define a\n  server of that name with any program or URL, and it was started. A server\n  configured by a workspace file is now admitted only by a command: or url:\n  entry that matches what it would reach; the refusal says so.\n- nexus policy check <file> quoted the tokens it rejected, so pointing it at\n  an arbitrary file printed fragments of it. A rejected token that is not\n  shaped like a policy key is cut to eight characters.\n\nThe document also states what an entry does not pin (arguments, a plugin's\nimports, a hard link in the user's configuration directory).\n\nCo-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>\" && git merge -q origin/release/v1.3.0 --no-edit 2>&1 | tail -1; cd cli && npx tsc --noEmit -p . >/dev/null; echo \"tsc $?\"; cd .. && git push -q -u origin v1/policy-followups 2>&1 | tail -1; echo \"remote: $(git ls-remote origin refs/heads/v1/policy-followups | cut -c1-8) local: $(git rev-parse --short=8 HEAD)\"; cd ~/nexus-code && u=$(gh pr create --base release/v1.3.0 --head v1/policy-followups --title \"fix(policy): a name in mcp.allow no longer admits a workspace-defined server; policy check stops echoing file text\" --body \"Follow-ups from the independent review of #778 (posted there; that PR merged before the review reported).\n\n## 1. A name entry did not hold against a workspace file\n\nWith \\`mcp.allow = [\\\"files\\\"]\\` and a trusted workspace, a \\`.mcp.json\\` that defines a server named \\`files\\` with its own \\`command\\` was started, and that program ran (confirmed by the reviewer by running it). The same held for a URL under an allowed name. A name is whatever the configuring file says it is.\n\nNow: a server configured by a file of the workspace is admitted only by a \\`command:\\` or \\`url:\\` entry that matches what it would reach. With only a name entry it is refused, and the message says to list its program or URL. A name entry still admits a server from the operator's own configuration. With no allowlist, nothing changes.\n\n**Behaviour change for the release notes:** an operator who allowed a workspace-defined server by name must switch that entry to \\`command:/absolute/path\\` or \\`url:https://origin\\`. A WebSocket server, which only a name entry can admit, can therefore only come from the operator's own configuration.\n\n## 2. \\`nexus policy check <file>\\` echoed file text\n\nIts parse errors quote the token they reject. Pointed at a file that is not a policy, it printed the first token of a line and rejected values. A quoted token that is not shaped like a policy key (lower-case words joined by dots and underscores) is now cut to eight characters. A mistyped key is still named in full.\n\n## 3. Checked and not a defect\n\nThe review asked whether \\`NEXUS_SANDBOX_NETWORK\\` gives \\`nexus verify\\` network access under a policy that refuses \\`--sandbox-network\\`. It does not: verify passes \\`network\\` explicitly from the flag (\\`index.ts:720-726\\`), and the sandbox consults the variable only when \\`network\\` is left undefined (\\`sandbox.ts:720, 892\\`).\n\n## Docs\n\n\\`docs/MANAGED_POLICY.md\\` states the new rule and what an entry does not pin: a \\`command:\\` entry's arguments, the modules a \\`sha256:\\`-pinned plugin imports, and a hard link in the user's configuration directory to a workspace file.\n\n## Tests\n\nNew test in \\`managed_policy_merge\\` (the operator's definition admitted; three workspace redefinitions refused with the message; \\`command:\\` and \\`url:\\` matches admitted; no allowlist unchanged) and in \\`policy_cli\\` (a credentials-shaped file is not readable through the errors; a mistyped key is still named). Each fails with its fix removed.\n\nLocal, Node 24: \\`managed_policy_merge\\` 47/47, \\`policy_cli\\` 24/24, \\`managed_policy_allowlists\\` 18/18, \\`managed_policy_enforcement\\` 113/113, \\`mcp\\` 4/4, \\`leak_guard\\` 6/6, \\`tsc\\` clean.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\" | tail -1); echo \"$u\"; echo \"$(date -u +%FT%TZ) PR (claude-invariants-audit): $u from ~/nexus-wt/polfu: follow-ups to the #778 review (name-only mcp.allow no longer admits a workspace-defined server; policy check errors no longer echo file text). Small; I will get a short independent review before merging. Do not merge before it is posted.\" >> \"$(git rev-parse --git-common-dir)/nexus-claims/nexus-claims.log\"","description":"Commit, merge the release tip, push, open the follow-up PR and log it","timeout":200000},"caller":{"type":"direct"}}]}}
