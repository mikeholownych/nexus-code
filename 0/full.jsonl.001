e saved conversation is used\ncli/test/fixtures/request_shape/before_resume.json:28:    \"read_archive\",\ncli/test/fixtures/request_shape/first_turn.json:28:    \"read_archive\",\ncli/test/fixtures/request_shape/retry_note.json:29:      \"read_archive\",\ncli/test/fixtures/request_shape/retry_note.json:87:      \"read_archive\",\ncli/test/fixtures/request_shape/retry_note.json:161:      \"read_archive\",\ncli/test/fixtures/request_shape/retry_note.json:237:      \"read_archive\",\ncli/test/fixtures/request_shape/after_compaction.json:28:    \"read_archive\",\ncli/test/recover_worktree_conversation.test.ts:132:    const readArchive = resumed.getSpine().getHandler(\"read_archive\");\ncli/test/recover_worktree_conversation.test.ts:133:    assert.ok(readArchive, \"read_archive handler was not registered\");\ncli/src/core/agent_support.ts:208:/** Archived originals kept searchable with read_archive (oldest dropped first). */\ncli/test/tool_output_mask.test.ts:2: * CX-4: old tool results above a token threshold are replaced, in the request only, by a marker carrying a content id;\ncli/test/tool_output_mask.test.ts:3: * the full output stays in the conversation and the archive and resolves with read_archive. Opt-in\ncli/test/tool_output_mask.test.ts:4: * (NEXUS_TOOL_OUTPUT_MASK_TOKENS); the pinned ledger, findings and the independent reviewer's evidence are never masked.\ncli/test/tool_output_mask.test.ts:54:    for (const name of [\"read_archive\", \"read_findings\", \"read_objective\"]) {\ncli/test/tool_output_mask.test.ts:66:    assert.equal(maskThresholdFromEnv({ NEXUS_TOOL_OUTPUT_MASK_TOKENS: \"abc\" }), undefined);\ncli/test/tool_output_mask.test.ts:67:    assert.equal(maskThresholdFromEnv({ NEXUS_TOOL_OUTPUT_MASK_TOKENS: \"0\" }), undefined);\ncli/test/tool_output_mask.test.ts:68:    assert.equal(maskThresholdFromEnv({ NEXUS_TOOL_OUTPUT_MASK_TOKENS: \"250\" }), 250);\ncli/test/tool_output_mask.test.ts:79:  test(\"the independent reviewer's evidence package does not