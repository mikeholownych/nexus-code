eam = http.createServer((req, res) => {\n  1726\t    req.resume();\n  1727\t    res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n  1728\t    res.end(\n  1729\t      sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: 0, id: \"c\", type: \"function\", function: { name: \"read_file\", arguments: \"\" } }] } }] }) +\n  1730\t      sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: 0, function: { arguments: '{\"path\":\"a\"}' } }] } }] }) +\n  1731\t      sse({ choices: [{ index: 0, delta: {}, finish_reason: \"tool_calls\" }] }) + \"data: [DONE]\\n\\n\",\n  1732\t    );\n  1733\t  });\n  1734\t  await new Promise<void>((r) => upstream.listen(0, \"127.0.0.1\", () => r()));\n  1735\t  const port = (upstream.address() as any).port;\n  1736\t  const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n  1737\t  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1`, faults: kinds.map((kind, i) => ({ kind, atRequest: i + 1 })) });\n  1738\t  const chat = () => fetch(`${proxy.url}/chat/completions`, { method: \"POST\", body: \"{}\" });\n  1739\t  try {\n  1740\t    await assert.rejects(chat(), \"refuse: the connection is dropped\");\n     1\t/**\n     2\t * The evaluation harness end to end against a scripted model (Stage 8, T1 smoke): fresh workspaces, hidden tests the\n     3\t * agent never sees, separate scores. The self-test task is the assessment's A1 case: a repository whose own suite is\n     4\t * green but never exercises the deliverable. A wrong deliverable must fail the hidden test and must never be VERIFIED.\n     5\t */\n     6\t\n     7\timport { test } from \"node:test\";\n     8\timport assert from \"node:assert/strict\";\n     9\timport { createHash } from \"node:crypto\";\n    10\timport fs from \"node:fs\";\n    11\timport os from \"node:os\";\n    12\timport path from \"node:path\";\n    13\timport { spawn, spawnSync } from \"node:child_process\";\n    14\timport { fileURLToPath } from \"node:url\";\n    15\timport { startGateway, Reply } from \"./helpers/fixtures.js\";\n    16\t\n    17\tconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n    18\t\n    19\tasync function sealTestTasks(tasksDir: string, taskId: string) {\n    20\t  const { corpusTaskRows } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n    21\t  const rows = corpusTaskRows(tasksDir, [taskId]);\n    22\t  const manifestPath = path.join(tasksDir, \"custody-manifest.json\");\n    23\t  const manifest = { schemaVersion: 1, split: \"heldout\", custody: { status: \"approved\", custodian: \"synthetic-test-role\", approvedAt: \"2026-01-01T00:00:00Z\" }, tasks: rows };\n    24\t  const bytes = JSON.stringify(manifest);\n    25\t  fs.writeFileSync(manifestPath, bytes);\n    26\t  return { corpusManifest: manifestPath, corpusManifestSha256: createHash(\"sha256\").update(bytes).digest(\"hex\") };\n    27\t}\n    28\t\n    29\t/** Async: the scripted gateway answers from this process, so the runner must not block its event loop. */\n    30\tfunction runNode(argv: string[], env: NodeJS.ProcessEnv = process.env): Promise<{ status: number | null; stdout: string; stderr: string }> {\n    31\t  return new Promise((resolve) => {\n    32\t    const child = spawn(process.execPath, argv, { stdio: [\"ignore\", \"pipe\", \"pipe\"], env });\n    33\t    let stdout = \"\";\n    34\t    let stderr = \"\";\n    35\t    child.stdout.on(\"data\", (c) => (stdout += c));\n    36\t    child.stderr.on(\"data\", (c) => (stderr += c));\n    37\t    child.on(\"close\", (status) => resolve({ status, stdout, stderr }));\n    38\t  });\n    39\t}\n    40\t\n    41\tfunction writer(content: string) {\n    42\t  return (_n: number, body: any): Reply => {\n    43\t    const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n    44\t    if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"math.js\", content } }] };\n    45\t    if (tools === 1) return { kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary: \"math.js added\" } }] };\n    46\t    return { kind: \"text\", content: \"Done.\" };\n    47\t  };\n    48\t}\n    49\t\n    50\tasync function evaluate(content: string, extra: Record<string, unknown> = {}): Promise<{ records: any[]; score: any; hiddenLog: string; agentLog: string; agentError: string }> {\n    51\t  const gw = await startGateway(writer(content));\n    52\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-out-\"));\n    53\t  const out = path.join(root, \"run\");\n    54\t  const config = path.join(root, \"config.json\");\n    55\t  fs.writeFileSync(config, JSON.stringify({ name: \"nexus@mock\", agent: \"nexus\", endpoint: gw.url, model: \"m\", runs: 1, steps: 20, minutes: 5, ...extra }));\n    56\t  try {\n    57\t    const run = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    58\t    assert.equal(run.status, 0, `${run.stdout}\\n${run.stderr}`);\n    59\t    const records = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    60\t    const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(out, \"results.jsonl\"), \"--json\"], { encoding: \"utf8\" });\n    61\t    assert.equal(scored.status, 0, scored.stderr);\n    62\t    const manifest = JSON.parse(fs.readFileSync(path.join(out, \"manifest.json\"), \"utf8\"));\n    63\t    assert.deepEqual(manifest.tasks.map((task: any) => task.id), [\"selftest-add\"]);\n    64\t    assert.match(manifest.harness.sourceSha256, /^[0-9a-f]{64}$/);\n    65\t    assert.match(manifest.configSha256, /^[0-9a-f]{64}$/);\n> Written by an AI agent and sent automatically by that agent after using xerj.\n\n# WP-1103 AC5 test design reference search for local fake SSE provider a