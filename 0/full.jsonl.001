CK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 504\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:d2be2da0d8f659f1e86ebfa8\",\n      \"paths\": [\n        \"workflow.review.rules\"\n      ],\n      \"kind\": \"convention\",\n      \"locus\": [\n        \"agent.ts\",\n        \"cli/src\",\n        \"ui.ts\"\n      ],\n      \"text\": \"Terminal-safety reviews must trace output paths across cli/src, including agent.ts streaming and task-prompt echoes; reviewing only ui.ts missed escape-sequence injection paths and led to a withdrawn approval.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 1642\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:728ccdd269fd39d8403cfaf6\",\n      \"paths\": [\n        \"workflow.review.constraints\"\n      ],\n      \"kind\": \"gotcha\",\n      \"locus\": [\n        \"github\"\n      ],\n      \"text\": \"All Nexus agents share one GitHub account, so GitHub rejects formal reviews of PRs created by another agent using that account; record independent review verdicts as PR comments and in the shared log.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 1384\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:050f2a39d9261b65895c0d5c\",\n      \"paths\": [\n        \"workflow.review.rules\"\n      ],\n      \"kind\": \"invariant\",\n      \"text\": \"Release merges require a recorded independent ACCEPT and green CI for the exact PR head; self-acceptance and unrecorded claims of reviewer acceptance do not satisfy the gate.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 504\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:9a1a6985df61a5fc25dfe89f\",\n      \"paths\": [\n        \"workflow.review.rules\"\n      ],\n      \"kind\": \"convention\",\n      \"text\": \"Verify each evidence-PR claim against what the producing workflow actually checked, including scope and verification settings; matching numbers alone do not establish that the claim is supported.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 2043\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:46d9cd77547a7b7d4d92d110\",\n      \"paths\": [\n        \"workflow.review.classification\"\n      ],\n      \"kind\": \"convention\",\n      \"text\": \"Architecture recommendations must distinguish architectural invariants, policy defaults, and implementation mechanisms; delegation depths, credential TTLs, and cache TTLs require justification rather than arbitrary constants.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"5e99063d-042c-4962-9221-1650fa0f4489\",\n          \"checkpoint_id\": \"01M41G6TDNTMPXWBKWES1FXNX9\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 1\n        },\n        {\n          \"session_id\": \"5e99063d-0