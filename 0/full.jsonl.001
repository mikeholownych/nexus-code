usion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/44667753045/job/136061116155\",\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-11-20T03:26:43Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-11-20T03:27:09Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/44667753045/job/136061116149\",\"name\":\"cloudflare-experiment (22)\",\"startedAt\":\"2026-11-20T03:26:43Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-11-20T03:27:09Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/44667753045/job/136061116036\",\"name\":\"cloudflare-experiment (24)\",\"startedAt\":\"2026-11-20T03:26:43Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/44667753045/job/136061115978\",\"name\":\"linux-x86_64\",\"startedAt\":\"2026-11-20T03:26:48Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://entire.com/gh/mikeholownych/-/trails/427/changes/nexus-code/377\",\"name\":\"Entire Gates\",\"startedAt\":\"2026-11-20T03:26:43Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-11-20T03:28:00Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/runs/136061588776\",\"name\":\"CodeQL\",\"startedAt\":\"2026-11-20T03:27:57Z\",\"status\":\"COMPLETED\",\"workflowName\":\"\"},{\"__typename\":\"StatusContext\",\"context\":\"CodeRabbit\",\"startedAt\":\"2026-11-20T03:26:46Z\",\"state\":\"SUCCESS\",\"targetUrl\":\"\"}]}\n## main...origin/main\nworktree /home/mike/nexus-code\nHEAD f