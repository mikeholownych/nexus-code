pted/README.md\ndocs/reviews/evidence/v1-qualification/rc.10/terminal-scripted/README.md\ndocs/NEXUS-CLOUD-PROVIDERS-PLAN.md\ndocs/reviews/NEXUS_CLOUD_PROVIDERS_ASSESSMENT_2026-10-11.md\ndocs/reviews/NEXUS_CLOUD_PROVIDERS_LIVE_QUALIFICATION_2026-10-11.md\ndocs/cloudflare/CONTEST_SUBSTRATE_TRUTH_MATRIX.md\ndocs/ISSUE12_POST_WP05_REQUIREMENT_CLOSURE_MATRIX.md\ndocs/assurance/POWER_OF_TEN_CONTROL_MATRIX.md\ndocs/ISSUE12_FINAL_ACCEPTANCE_MATRIX.md\ndocs/v1.1.4/G1.1-4-LIVE-MATRIX.md\ndocs/evidence/v1.2.0/wp-1107-provider-matrix.rc.1.json\ndocs/evidence/v1.2.0/wp-1107-provider-matrix.v1.2.0.json.sha256\ndocs/evidence/v1.2.0/wp-1107-provider-matrix.rc.1.attempt1-pool-outage.json\ndocs/evidence/v1.2.0/wp-1107-provider-matrix.rc.1.json.sha256\ndocs/evidence/v1.2.0/wp-1107-provider-matrix.rc.1.attempt1-pool-outage.json.sha256\ndocs/evidence/v1.2.0/wp-1107-provider-matrix.v1.2.0.json\ndocs/CLOUD_PROVIDERS.md\ndocs/evidence/v1.2.1/wp-1107-provider-matrix.rc.2.json.sha256\ndocs/evidence/v1.2.1/wp-1107-provider-matrix.v1.2.1.wm3.json.sha256\ndocs/evidence/v1.2.1/wp-1107-provider-matrix.rc.2.json\ndocs/evidence/v1.2.1/wp-1107-provider-matrix.v1.2.1.wm3.json\ndocs/evidence/v1.1.4/wp-1107-provider-matrix.json\ndocs/evidence/v1.1.4/wp-1107-provider-matrix.rc.2.json\ndocs/evidence/v1.1.4/wp-1107-provider-matrix.json.sha256\ndocs/v1.0.0/TERMINAL-MATRIX-WORKSHEET.md\ndocs/ISSUE12_REQUIREMENT_CLOSURE_MATRIX.md\ndocs/v1.0.0/evidence/B_providers.md\ndocs/reviews/evidence/v1-qualification/rc.9/platform-e2/run-rc9-e2-matrix.sh\ndocs/v1.0.0/evidence/rc14-acc-prv-live-2026-10-31/provider-verification/chatgpt-verify.json\ndocs/v1.0.0/evidence/rc14-acc-prv-live-2026-10-31/provider-verification/openrouter-verify.json\ndocs/reviews/evidence/v1-qualification/rc.10/platform-e2/run-rc10-e2-matrix.sh\ndocs/reviews/evidence/v1-qualification/rc.3/providers/provider-receipts-20261023T1659Z.jsonl\ndocs/reviews/evidence/v1-qualification/rc.3/providers/e5-provider-verification-20261023.json\ndocs/reviews/evidence/v1-qualification/rc.3/providers/e5-provider-verification-20261023T1659Z.json\ndocs/evidence/v1.1.4/wp-1107-provider-matrix.rc.2.json.sha256\ndocs/reviews/evidence/v1-qualification/rc.14/platform-e2/run-node24-matrix.sh\ndocs/reviews/evidence/v1-qualification/rc.10/providers/README.md\ndocs/reviews/evidence/v1-qualification/rc.10/providers/openrouter-verify-20261027T022710Z.json\ndocs/reviews/evidence/v1-qualification/rc.10/providers/openrouter-receipts-20261027T022710Z.jsonl\ndocs/reviews/evidence/v1-qualification/rc.10/providers/SHA256SUMS\ndocs/reviews/evidence/v1-qualification/rc.10/providers/chatgpt-receipts-20261028T190304Z.jsonl\ndocs/reviews/evidence/v1-qualification/rc.10/providers/chatgpt-verify-20261028T190304Z.json\ndocs/reviews/evidence/v1-qualification/rc.14/platform-e2/run-preflight-matrix.sh\ndocs/reviews/evidence/v1-qualification/rc.14/platform-e2/run-node22-matrix.sh\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1f72c-56d0-7a60-917e-bc2e070d3543","create_time":1795148413.989925}},"metadata":{"history_sequence":13135,"sampled_through_sequence":13132,"client_authored":false,"fallback_token_limit_override":12000}}
