{"timestamp":"2026-11-21T22:38:34.048Z","ordinal":36664,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0393e1fe95dcae93016b021d68474087d29f22f5d669f66537","status":"completed","call_id":"call_9c24e8e0f68c4bd6af9cbde099df632c","name":"exec","input":"const a = await tools.mcp__xerj__xerj_search({prefix:\"nexus-cli\",query:\"ContinuationBudget persistent objective task budget consume inference retry deadline resume\",size:4});\nconst b = await tools.mcp__xerj__xerj_search({prefix:\"goose\",query:\"scheduler durable task budget retry max runs execution timeout\",size:4});\ntext(JSON.stringify({nexus:a.content,peer:b.content}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","create_time":1795300712.3271575}},"metadata":{"history_sequence":16384,"sampled_through_sequence":16382,"client_authored":false}}
{"timestamp":"2026-11-21T22:38:34.106Z","ordinal":36665,"type":"token_usage_record","payload":{"thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","session_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","root_turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","response_id":"resp_0393e1fe95dcae93016b021d65fcf887d285c8b6af610f4237","usage":{"input_tokens":113108,"cached_input_tokens":112512,"cache_write_input_tokens":0,"output_tokens":186,"reasoning_output_tokens":86,"total_tokens":113294},"turn_token_usage":{"input_tokens":1217872,"cached_input_tokens":1167744,"cache_write_input_tokens":0,"output_tokens":6840,"reasoning_output_tokens":4381,"total_tokens":1224712},"thread_token_usage":{"input_tokens":780902750,"cached_input_tokens":773905152,"cache_write_input_tokens":0,"output_tokens":1147247,"reasoning_output_tokens":523925,"total_tokens":782049997}}}
{"timestamp":"2026-11-21T22:38:38.368Z","ordinal":36666,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","item":{"type":"McpToolCall","id":"exec-66eb6c58-640c-46e1-bd4d-2652faa4f7e3","server":"xerj","tool":"xerj_search","arguments":{"prefix":"nexus-cli","query":"ContinuationBudget persistent objective task budget consume inference retry deadline resume","size":4},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /nexus-cli-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"ContinuationBudget persistent objective task budget consume inference retry deadline resume\",\"k\":10}}}}}]},\"took\":4102,\"timed_out\":false,\"_shards\":{\"total\":2,\"successful\":2,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":264,\"relation\":\"eq\"},\"max_score\":82.421616,\"hits\":[{\"_index\":\"nexus-cli-docs\",\"_id\":\"0bb4eb8b19d51da2919f8ab552927f2f\",\"_score\":82.421616,\"_source\":{\"title\":\"types.ts\",\"ax_path\":\"types.ts\",\"ax_file\":\"axf2-6d204e771376e315f31b0bce312ffd4e-2c93\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":140,\"start_offset\":8113,\"end_offset\":8727,\"text\":\"export interface ExecutionResult {\\n  success: boolean;\\n  output: string;\\n  error?: string;\\n  /** The operation's deadline expired before an answer was received (bridge-level; the runner reports its own via `timed_out`). */\\n  timedOut?: boolean;\\n  /** The operator's cancel ended the operation (the runner ended the command's process group). */\\n  cancelled?: boolean;\\n  /** The request may have reached the executor, but no trustworthy result was received. */\\n  outcomeUnknown?: boolean;\\n  /** Why the call was refused before it ran (a stable code, e.g. VERIFICATION_CONFIG_PROTECTED). */\\n  denialReason?: string;\\n}\"}]},\"match_line\":145,\"match_lines\":[145]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"9924c753f725f01ef17daf84075d0d9c\",\"_score\":70.61245,\"_source\":{\"title\":\"config.ts\",\"ax_path\":\"config.ts\",\"ax_file\":\"axf2-c48039ebb5e58edf292473e733d50240-a8a3\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":719,\"start_offset\":38969,\"end_offset\":41005,\"text\":\"    [\\\"maxWaitMs\\\", effective.maxWaitMs, 1],\\n    [\\\"unknownResumeBudget\\\", effective.unknownResumeBudget, 0],\\n    [\\\"maxRunsPerUnit\\\", effective.maxRunsPerUnit, 1],\\n    [\\\"minWaitMs\\\", effective.minWaitMs, 1],\\n  ] as const;\\n  for (const [field, value, minimum] of fields) {\\n    if (typeof value !== \\\"number\\\" || !Number.isSafeInteger(value) || value < minimum) {\\n      throw new Error(`Invalid operation policy ${field}: expected a safe integer of at least ${minimum}.`);\\n    }\\n    if ((field === \\\"maxWaitMs\\\" || field === \\\"minWaitMs\\\") && value > maxTimerDelayMs) {\\n      throw new Error(`Invalid operation policy ${field}: must not exceed Node's timer limit (${maxTimerDelayMs} ms).`);\\n    }\\n  }\\n  const { maxWaitMs, minWaitMs } = effective;\\n  if (minWaitMs > maxWaitMs) {\\n    throw new Error(`Invalid operation wait settings: minWaitMs (${minWaitMs}) must not exceed maxWaitMs (${maxWaitMs}).`);\\n  }\\n  return Object.keys(policy).length ? policy : undefined;\\n}\\n\\n/**\\n * Continuation budgets: flags, then NEXUS_MAX_TOTAL_STEPS / NEXUS_MAX_TURN_MINUTES / NEXUS_STAGNATION_STEPS, then\\n * finite defaults. Total steps are charged to the durable objective ledger, so resume does not reset them.\\n * `--no-continuation` (or NEXUS_CONTINUATION=0) is the operator's explicit choice of the single-segment turn that\\n * ends at --max-steps.\\n */\\nexport function continuationBudget(options: any): ContinuationBudget | undefined {\\n  if (options.continuation === false || effectiveSetting(\\\"NEXUS_CONTINUATION\\\") === \\\"0\\\") return undefined;\\n  const positive = (flag: unknown, env: string | undefined, fallback: number, maximum = Number.POSITIVE_INFINITY): number => {\\n    for (const raw of [flag, env]) {\\n      if (raw === undefined || raw === null || raw === \\\"\\\") continue;\\n      const value = Number(raw);\\n      if (!Number.isFinite(value) || value <= 0) throw new Error(`Invalid continuation budget '${String(raw)}': expected a positive number.`);\\n      if (value > maximum) throw new Error(`Invalid continuation budget '${String(raw)}': maximum is ${maximum}.`);\"}]},\"match_line\":742,\"match_lines\":[742,746,752,753]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"a8bd6d54fcae1195a860c07a11d3b167\",\"_score\":59.27883,\"_source\":{\"title\":\"sidecar.ts\",\"ax_path\":\"sidecar.ts\",\"ax_file\":\"axf2-994a29d7a9a75ea68eac0027155266de-11745\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":174,\"start_offset\":9179,\"end_offset\":13218,\"text\":\"async handleLine(line: string): Promise<void> {\\n    if (!line.trim()) return;\\n    let command: SidecarCommand;\\n    try {\\n      command = parseCommand(line);\\n    } catch (err) {\\n      const id = err instanceof ProtocolError ? err.id : undefined;\\n      this.emit({ type: \\\"error\\\", ...(id ? { id } : {}), code: \\\"BAD_REQUEST\\\", message: (err as Error).message });\\n      return;\\n    }\\n    switch (command.type) {\\n      case \\\"prompt.submit\\\":\\n        this.submit(command.id, command.text);\\n        return;\\n      case \\\"steer\\\":\\n        this.steer(command.id, command.text);\\n        return;\\n      case \\\"cancel\\\":\\n        this.cancel();\\n        return;\\n      case \\\"approve\\\":\\n        this.resolveApproval(command.id, true, command.always);\\n        return;\\n      case \\\"deny\\\":\\n        this.resolveApproval(command.id, false, false);\\n        return;\\n      case \\\"answer\\\":\\n        // Bound to the decision by id; consumed when a turn reaches it (an unresolved steering conflict: at the next\\n        // turn's start). An id no turn asked about is simply never consumed.\\n        this.app.getAgent().setOperatorAnswers(new Map([[command.question, command.option]]));\\n        this.emit({ type: \\\"notice\\\", text: `Answer recorded for question ${command.question}: ${command.option}. It applies when the next turn reaches that decision.` });\\n        return;\\n      case \\\"checkpoint.choice\\\":\\n        this.resolveCheckpointChoice(command.id, command.choice);\\n        return;\\n      case \\\"slash\\\":\\n        this.slash(command.id, command.command, command.args);\\n        return;\\n      case \\\"tool.detail\\\":\\n      case \\\"receipt\\\":\\n        try {\\n          if (command.type === \\\"tool.detail\\\") this.toolDetail(command.id, command.evidence);\\n          else this.emit({ type: \\\"receipt\\\", id: command.id, sections: this.receipt() });\\n        } catch (err) {\\n          const message = errorText(err);\\n          this.emit({ type: \\\"error\\\", id: command.id, code: \\\"INTERNAL\\\", message });\\n        }\\n        return;\\n      case \\\"models.list\\\":\\n        if (this.app.getAgent().getApprovalMode() === \\\"read-only\\\") {\\n          this.emit({ type: \\\"error\\\", id: command.id, code: \\\"BUSY\\\", message: \\\"Provider discovery is disabled while the session is in read-only mode.\\\" });\\n          return;\\n        }\\n        void this.modelsList(command.id);\\n        return;\\n      case \\\"model.select\\\":\\n        if (this.app.getAgent().getApprovalMode() === \\\"read-only\\\") {\\n          this.emit({ type: \\\"error\\\", id: command.id, code: \\\"BUSY\\\", message: \\\"Model changes are disabled while the session is in read-only mode.\\\" });\\n          return;\\n        }\\n        this.modelSelect(command.id, command.provider, command.model);\\n        return;\\n      case \\\"provider.connect\\\":\\n        if (this.app.getAgent().getApprovalMode() === \\\"read-only\\\") {\\n          this.emit({ type: \\\"provider.result\\\", id: command.id, provider: command.provider, success: false, message: \\\"Provider connections are disabled while the session is in read-only mode.\\\" });\\n          return;\\n        }\\n        void this.providerConnect(command.id, command.provider, command.method, command.key, command.endpoint);\\n        return;\\n      case \\\"provider.cancel\\\":\\n        this.modelLists.get(command.id)?.abort();\\n        this.signIns.get(command.id)?.cancel();\\n        this.signIns.delete(command.id);\\n        cancelLocalEndpointSetup(command.id);\\n        return;\\n      case \\\"provider.local-cancel\\\":\\n        clearLocalEndpointSetup(command.id);\\n        return;\\n      case \\\"provider.disconnect\\\": {\\n        if (this.app.getAgent().getApprovalMode() === \\\"read-only\\\") {\\n          this.emit({ type: \\\"provider.result\\\", id: command.id, provider: command.provider, success: false, message: \\\"Provider changes are disabled while the session is in read-only mode.\\\" });\\n          return;\\n        }\\n        const r = disconnect(command.provider);\\n        this.emit({ type: \\\"provider.result\\\", id: command.id, provider: command.provider, success: r.ok, message: r.message });\\n        return;\\n      }\\n      case \\\"shutdown\\\":\\n        await this.shutdown();\\n        return;\\n    }\\n  }\"}]}},{\"_index\":\"nexus-cli-docs\",\"_id\":\"95a1414ca0ab35ad4a344da8abc96e25\",\"_score\":50.90848,\"_source\":{\"title\":\"run_turn.ts\",\"ax_path\":\"core/run_turn.ts\",\"ax_file\":\"axf2-fbd942dc3df6ecec33395bc515b98234-14921\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":244,\"start_offset\":13436,\"end_offset\":15462,\"text\":\"    tracker.beginTurn();\\n    if (continuingObjective) {\\n      const isHarnessResume = typeof taskPrompt === \\\"string\\\" && /^\\\\[(?:Nexus|Work unit resumed)/.test(taskPrompt);\\n      if (!isHarnessResume && !options?.resume && !isStep) {\\n        tracker.operatorInput(tracker.data.cumulativeSteps, `operator follow-up: ${promptText.slice(0, 160)}`);\\n      }\\n    }\\n    let stateNow = this.workspaceStateIdentity();\\n    this.turnStartState = stateNow;\\n    tracker.noteState(stateNow);\\n    tracker.noteLedgerState(this.ledgerProgressIdentity());\\n    const noticedPolls = new Set<string>();\\n    const noticedThrash = new Set<string>();\\n    let stateUnknownNoted = false;\\n    const callRing: CallRecord[] = [];\\n    let repeatedCallNote: string | undefined;\\n    let loopedCall: { name: string; count: number; arguments: string; history: NonNullable<TurnResult[\\\"repeatedCall\\\"]>[\\\"history\\\"] } | undefined;\\n\\n    while (modelStop === \\\"NONE\\\" && !interruption && !inferenceFailure && !persistenceFailure) {\\n      const convergence = this.turnConvergence as TurnResult[\\\"convergence\\\"];\\n      if (convergence && !stopReason) {\\n        stopReason = \\\"VERIFIER_NOT_CONVERGING\\\";\\n        stopDetail = convergence.evidence;\\n        if (this.objective && this.turnConvergenceUpTo !== undefined) this.objective.convergenceResetAfter = this.turnConvergenceUpTo;\\n      }\\n      if (stopReason) break;\\n      const taskStepLimitReached = budget\\n        ? tracker.data.cumulativeSteps >= maxTotalSteps\\n        : currentStep > maxTotalSteps;\\n      if (taskStepLimitReached) {\\n        stopReason = budget ? \\\"STEP_BUDGET_EXHAUSTED\\\" : \\\"STEP_LIMIT_REACHED\\\";\\n        stopDetail = budget\\n          ? `objective step limit ${maxTotalSteps} reached (${tracker.data.cumulativeSteps} steps consumed across runs)`\\n          : `--no-continuation: ${segmentSteps} steps`;\\n        break;\\n      }\\n      if (Date.now() > turnDeadline) {\\n        stopReason = \\\"TIME_BUDGET_EXHAUSTED\\\";\\n        stopDetail = `operator time limit ${budget!.maxTurnMinutes} min`;\\n        break;\\n      }\"}]},\"match_line\":248,\"match_lines\":[248,268,271,275,276,277,283]}]}}"}],"isError":false},"duration":{"secs":4,"nanos":231291711}},"started_at_ms":1795300714136,"completed_at_ms":1795300718368}}
{"timestamp":"2026-11-21T22:38:44.051Z","ordinal":36667,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","item":{"type":"McpToolCall","id":"exec-9ca9a996-3ba7-47ae-a7e9-496add21ad0d","server":"xerj","tool":"xerj_search","arguments":{"prefix":"goose","query":"scheduler durable task budget retry max runs execution timeout","size":4},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`text` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `text`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /goose-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"text\",\"query\":\"scheduler durable task budget retry max runs execution timeout\",\"k\":10}}}}}]},\"took\":5412,\"timed_out\":false,\"_shards\":{\"total\":22,\"successful\":22,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":4051,\"relation\":\"eq\"},\"max_score\":51.91136,\"hits\":[{\"_index\":\"goose-docs\",\"_id\":\"dc4a3ee2bc3da4df53c6a67f58ffa362\",\"_score\":51.91136,\"_source\":{\"title\":\"ops_retry.rs\",\"language\":\"rust\",\"ax_path\":\"crates/goose/src/agents/state_machine/ops_retry.rs\",\"ax_file\":\"axf2-810153849e3d1edc20bbabea2bc8c398-2718\",\"ax_locator\":\"code\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":171,\"start_offset\":5872,\"end_offset\":10005,\"text\":\"async fn run(\\n        &self,\\n        session: &Session,\\n        conversation: &Conversation,\\n        emit: &Emitter,\\n    ) -> Result<OperationResult<GooseEffect>> {\\n        let messages = messages_since_kickoff(conversation)?;\\n        if !ends_turn(messages) {\\n            return not_applicable();\\n        }\\n\\n        let state = GoalState::of(session);\\n        if !self.goal_was_nudged(messages) {\\n            if let Some(goal) = &state.goal {\\n                let nudge = format!(\\n                    \\\"Before finishing, check whether the following goal has been fully met:\\\\n\\\\n\\\\\\n                     **Goal:** {goal}\\\\n\\\\n\\\\\\n                     If not, continue working toward it.\\\"\\n                );\\n                let mut message = Message::user()\\n                    .with_text(&nudge)\\n                    .with_visibility(false, true);\\n                self.set_message_meta(&mut message, NUDGED, serde_json::json!(true));\\n                emit.message(Message::assistant().with_system_notification(\\n                    SystemNotificationType::InlineMessage,\\n                    format!(\\\"Goal: {goal}\\\"),\\n                ));\\n                return applied([message.into()]);\\n            }\\n        }\\n\\n        if let Some(grind) = &state.grind {\\n            let nudge = format!(\\n                \\\"Keep working. The grind goal is not yet complete:\\\\n\\\\n\\\\\\n                 **Goal:** {grind}\\\\n\\\\n\\\\\\n                 Continue until it is fully done.\\\"\\n            );\\n            let message = Message::user()\\n                .with_text(&nudge)\\n                .with_visibility(false, true);\\n            emit.message(Message::assistant().with_system_notification(\\n                SystemNotificationType::InlineMessage,\\n                format!(\\\"Grind: {grind}\\\"),\\n            ));\\n            return applied([message.into()]);\\n        }\\n\\n        if state.goal.is_some() {\\n            return applied([GooseEffect::extension_state(&GoalState::default())?]);\\n        }\\n\\n        let Some(retry_config) = Self::retry_config(session) else {\\n            return not_applicable();\\n        };\\n\\n        let retry_timeout = retry_config\\n            .timeout_seconds\\n            .map(Duration::from_secs)\\n            .unwrap_or(self.retry_timeout);\\n        let success =\\n            execute_success_checks_with_timeout(&retry_config.checks, retry_timeout).await;\\n        let success = match success {\\n            Ok(success) => success,\\n            Err(error) => {\\n                let message = emit.message(retry_error(&error.to_string()));\\n                return applied([message.into()]);\\n            }\\n        };\\n        if success {\\n            return not_applicable();\\n        }\\n\\n        let attempts = self.attempts(messages);\\n        if attempts >= retry_config.max_retries {\\n            let message = Message::assistant().with_error(\\n                MessageErrorKind::Other,\\n                format!(\\n                    \\\"Maximum retry attempts ({}) exceeded. Unable to complete the task successfully.\\\",\\n                    retry_config.max_retries\\n                ),\\n            );\\n            #[cfg(feature = \\\"telemetry\\\")]\\n            crate::posthog::emit_error(\\n                \\\"retry_max_exceeded\\\",\\n                &format!(\\\"Max retries ({}) exceeded\\\", retry_config.max_retries),\\n            );\\n            let message = emit.message(message);\\n            return applied([message.into()]);\\n        }\\n\\n        if let Some(command) = &retry_config.on_failure {\\n            let timeout = retry_config\\n                .on_failure_timeout_seconds\\n                .map(Duration::from_secs)\\n                .unwrap_or(self.on_failure_timeout);\\n            if let Err(error) = execute_on_failure_command_with_timeout(command, timeout).await {\\n                let message = emit.message(retry_error(&error.to_string()));\\n                return applied([message.into()]);\\n            }\\n        }\\n\\n        let mut reset = Self::reset_conversation(conversation)?;\\n        if let Some(kickoff) = reset.messages_mut().last_mut() {\\n            self.set_message_meta(kickoff, ATTEMPTS, serde_json::json!(attempts + 1));\\n        }\\n        applied([reset.into()])\\n    }\"}]},\"match_line\":249,\"match_lines\":[249,256,263,267]},{\"_index\":\"goose-docs\",\"_id\":\"fe4fbd41ca3bc706098fd99bbfa70966\",\"_score\":51.81205,\"_source\":{\"title\":\"provider.rs\",\"language\":\"rust\",\"ax_path\":\"crates/goose/src/acp/provider.rs\",\"ax_file\":\"axf2-eacbab89c2d7000fb563f80d3e2352c9-2c092\",\"ax_locator\":\"code\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":3931,\"start_offset\":148188,\"end_offset\":150233,\"text\":\"            &provider.effort.capability,\\n            &[SessionConfigOption::select(\\n                \\\"effort\\\",\\n                \\\"Thinking\\\",\\n                \\\"default\\\",\\n                effort_select_options(&[\\\"default\\\", \\\"high\\\"]),\\n            )\\n            .category(SessionConfigOptionCategory::ThoughtLevel)],\\n        );\\n\\n        let handle = tokio::spawn(async move {\\n            provider\\n                .apply_effort_if_changed(&model_with_effort(\\\"high\\\"))\\n                .await\\n                .unwrap()\\n        });\\n\\n        assert_eq!(\\n            expect_set_config_option(&mut rx).await,\\n            (\\\"effort\\\".to_string(), \\\"high\\\".to_string())\\n        );\\n\\n        handle.await.unwrap();\\n    }\\n\\n    /// The menu advertises the global default once the persisted pick stops\\n    /// being offered (a model switch rebuilt the agent's selector), so the send\\n    /// path has to apply it too — otherwise the agent silently runs at its own\\n    /// current while the client shows the global.\\n    #[tokio::test]\\n    async fn apply_effort_if_changed_falls_back_to_the_global_default() {\\n        let _guard = env_lock::lock_env([(\\\"GOOSE_THINKING_EFFORT\\\", Some(\\\"high\\\"))]);\\n        let (tx, mut rx) = mpsc::channel(1);\\n        let provider =\\n            test_provider_with_effort(tx, Some(effort_capability(&[\\\"default\\\", \\\"high\\\"], \\\"default\\\")));\\n        let model = model_with_effort(\\\"medium\\\");\\n\\n        let handle =\\n            tokio::spawn(async move { provider.apply_effort_if_changed(&model).await.unwrap() });\\n\\n        assert_eq!(\\n            expect_set_config_option(&mut rx).await,\\n            (\\\"effort\\\".to_string(), \\\"high\\\".to_string())\\n        );\\n\\n        handle.await.unwrap();\\n    }\\n\\n    #[tokio::test]\\n    async fn apply_effort_if_changed_skips_unmapped_value() {\\n        // Unoffered by the capability below, so the global default never wins\\n        // and the test doesn't depend on the machine's configured value.\\n        let _guard = env_lock::lock_env([(\\\"GOOSE_THINKING_EFFORT\\\", Some(\\\"medium\\\"))]);\\n        let (tx, mut rx) = mpsc::channel(1);\"}]},\"match_line\":3959,\"match_lines\":[3959]},{\"_index\":\"goose-docs\",\"_id\":\"aadfe3a185e74d0de6485b457f961e9a\",\"_score\":50.22988,\"_source\":{\"title\":\"full.rs\",\"language\":\"rust\",\"ax_path\":\"crates/goose/src/scheduler/full.rs\",\"ax_file\":\"axf2-532882ab5cb7924b47b99677c794c92e-e0ce\",\"ax_locator\":\"code\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":828,\"start_offset\":29001,\"end_offset\":36463,\"text\":\"async fn execute_job(\\n    job: ScheduledJob,\\n    jobs: Arc<Mutex<JobsMap>>,\\n    job_id: String,\\n    cancel_token: CancellationToken,\\n    session_manager: Arc<SessionManager>,\\n) -> Result<String> {\\n    if job.source.is_empty() {\\n        return Ok(job.id.to_string());\\n    }\\n\\n    let recipe_path = Path::new(&job.source);\\n    let recipe_content = fs::read_to_string(recipe_path)?;\\n    // Use the original recipe directory for path resolution so that relative\\n    // references (sub-recipes, template includes) survive the copy into scheduled_recipes/.\\n    let recipe_dir_owned;\\n    let recipe_dir = if let Some(ref base) = job.recipe_base_dir {\\n        recipe_dir_owned = PathBuf::from(base);\\n        recipe_dir_owned.as_path()\\n    } else {\\n        recipe_path.parent().unwrap_or(Path::new(\\\".\\\"))\\n    };\\n\\n    let recipe: Recipe = build_recipe_from_template(\\n        recipe_content,\\n        recipe_dir,\\n        job.parameters.clone(),\\n        None::<fn(&str, &str) -> anyhow::Result<String>>,\\n    )\\n    .map_err(|e| anyhow!(e.to_string()))?;\\n\\n    let agent = Agent::with_config(AgentConfig::new(\\n        session_manager,\\n        PermissionManager::instance(),\\n        None,\\n        true,\\n        GoosePlatform::GooseCli,\\n    ));\\n\\n    let config = Config::global();\\n    let provider_name = config.get_goose_provider()?;\\n    let model_name = config.get_goose_model()?;\\n    let model_config =\\n        crate::model_config::model_config_from_user_config(&provider_name, &model_name)?\\n            .with_cache_ttl_clamped();\\n\\n    let session = agent\\n        .config\\n        .session_manager\\n        .create_session(\\n            std::env::current_dir()?,\\n            format!(\\\"Scheduled job: {}\\\", job.id),\\n            SessionType::Scheduled,\\n            GooseMode::Auto,\\n        )\\n        .await?;\\n\\n    let mut extensions = resolve_extensions_for_new_session(recipe.extensions.as_deref(), None);\\n    if recipe.extensions.is_none() {\\n        extensions.extend(crate::plugins::mcp_servers::enabled_plugin_mcp_servers(\\n            std::env::current_dir().ok().as_deref(),\\n        ));\\n    }\\n    for ext in &extensions {\\n        agent.add_extension(ext.clone(), &session.id).await?;\\n    }\\n\\n    agent\\n        .switch_provider(&session.id, &provider_name, model_config)\\n        .await?;\\n    agent\\n        .update_goose_mode(GooseMode::Auto, &session.id)\\n        .await?;\\n\\n    let mut jobs_guard = jobs.lock().await;\\n    if let Some((_, job_def)) = jobs_guard.get_mut(job_id.as_str()) {\\n        job_def.current_session_id = Some(session.id.clone());\\n    }\\n    drop(jobs_guard);\\n\\n    let start_time = std::time::Instant::now();\\n\\n    let recipe_display_name = recipe_path\\n        .file_name()\\n        .and_then(|name| name.to_str())\\n        .unwrap_or(&job.id);\\n    let recipe_version = recipe.version.clone();\\n\\n    tracing::info!(\\n        monotonic_counter.goose.session_starts = 1,\\n        session_type = \\\"schedule\\\",\\n        interface = \\\"scheduler\\\",\\n        interactive = false,\\n        \\\"Scheduled session started\\\"\\n    );\\n\\n    tracing::info!(\\n        monotonic_counter.goose.recipe_runs = 1,\\n        recipe_name = %recipe_display_name,\\n        recipe_version = %recipe_version,\\n        session_type = \\\"schedule\\\",\\n        interface = \\\"scheduler\\\",\\n        \\\"Recipe execution started\\\"\\n    );\\n\\n    #[cfg(feature = \\\"telemetry\\\")]\\n    tokio::spawn(async move {\\n        let mut props = HashMap::new();\\n        props.insert(\\n            \\\"trigger\\\".to_string(),\\n            serde_json::Value::String(\\\"automated\\\".to_string()),\\n        );\\n        if let Err(e) = posthog::emit_event(\\\"schedule_job_started\\\", props).await {\\n            tracing::debug!(\\\"Failed to send schedule telemetry: {}\\\", e);\\n        }\\n    });\\n\\n    let prompt_text = recipe\\n        .prompt\\n        .as_deref()\\n        .filter(|s| !s.trim().is_empty())\\n        .or_else(|| {\\n            recipe\\n                .instructions\\n                .as_deref()\\n                .filter(|s| !s.trim().is_empty())\\n        })\\n        .ok_or_else(|| {\\n            anyhow!(\\\"Recipe must specify at least one of `instructions` or `prompt`.\\\")\\n        })?;\\n\\n    let user_message = Message::user().with_text(prompt_text);\\n    let mut conversation = Conversation::new_unvalidated(vec![user_message.clone()]);\\n\\n    agent\\n        .config\\n        .session_manager\\n        .update(&session.id)\\n        .schedule_id(Some(job.id.clone()))\\n        .recipe(Some(recipe.clone()))\\n        .apply()\\n        .await?;\\n\\n    let session_config = SessionConfig {\\n        id: session.id.clone(),\\n        schedule_id: Some(job.id.clone()),\\n        max_turns: None,\\n    };\\n\\n    let stream = agent\\n        .reply(user_message, session_config, Some(cancel_token.clone()))\\n        .await?;\\n\\n    use futures::StreamExt;\\n    let mut stream = std::pin::pin!(stream);\\n\\n    let mut stream_error = false;\\n    while let Some(message_result) = stream.next().await {\\n        tokio::task::yield_now().await;\\n\\n        match message_result {\\n            Ok(AgentEvent::Message(msg)) => {\\n                conversation.push(msg);\\n            }\\n            Ok(AgentEvent::HistoryReplaced(updated)) => {\\n                conversation = updated;\\n            }\\n            Ok(_) => {}\\n            Err(e) => {\\n                tracing::error!(\\\"Error in agent stream: {}\\\", e);\\n                stream_error = true;\\n                break;\\n            }\\n        }\\n    }\\n\\n    {\\n        let session_duration = start_time.elapsed();\\n        let exit_type = if stream_error { \\\"error\\\" } else { \\\"normal\\\" };\\n        let (total_tokens, message_count) = agent\\n            .config\\n            .session_manager\\n            .get_session(&session.id, false)\\n            .await\\n            .map(|s| (s.usage.total_tokens.unwrap_or(0), s.message_count))\\n            .unwrap_or((0, 0));\\n\\n        tracing::info!(\\n            monotonic_counter.goose.session_completions = 1,\\n            session_type = \\\"schedule\\\",\\n            interface = \\\"scheduler\\\",\\n            exit_type,\\n            duration_ms = session_duration.as_millis() as u64,\\n            total_tokens,\\n            message_count,\\n            \\\"Session completed\\\"\\n        );\\n\\n        tracing::info!(\\n            monotonic_counter.goose.session_duration_ms = session_duration.as_millis() as u64,\\n            session_type = \\\"schedule\\\",\\n            interface = \\\"scheduler\\\",\\n            \\\"Session duration\\\"\\n        );\\n\\n        if total_tokens > 0 {\\n            tracing::info!(\\n                monotonic_counter.goose.session_tokens = total_tokens,\\n                session_type = \\\"schedule\\\",\\n                interface = \\\"scheduler\\\",\\n                \\\"Session tokens\\\"\\n            );\\n        }\\n    }\\n\\n    #[cfg(feature = \\\"telemetry\\\")]\\n    {\\n        let duration_secs = start_time.elapsed().as_secs();\\n        tokio::spawn(async move {\\n            let mut props = HashMap::new();\\n            props.insert(\\n                \\\"trigger\\\".to_string(),\\n                serde_json::Value::String(\\\"automated\\\".to_string()),\\n            );\\n            props.insert(\\n                \\\"status\\\".to_string(),\\n                serde_json::Value::String(\\\"completed\\\".to_string()),\\n            );\\n            props.insert(\\n                \\\"duration_seconds\\\".to_string(),\\n                serde_json::Value::Number(serde_json::Number::from(duration_secs)),\\n            );\\n            if let Err(e) = posthog::emit_event(\\\"schedule_job_completed\\\", props).await {\\n                tracing::debug!(\\\"Failed to send schedule telemetry: {}\\\", e);\\n            }\\n        });\\n    }\\n\\n    Ok(session.id)\\n}\"}]},\"match_line\":931,\"match_lines\":[920,930,931,987,1019,1030,1038]},{\"_index\":\"goose-docs\",\"_id\":\"6c127720c4aceb3208700e9f4d305539\",\"_score\":49.62568,\"_source\":{\"title\":\"server.rs\",\"language\":\"rust\",\"ax_path\":\"crates/goose/src/acp/server.rs\",\"ax_file\":\"axf2-1cca7c298415c59a2f3e738c440c762f-23934\",\"ax_locator\":\"code\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":209,\"start_offset\":8946,\"end_offset\":10989,\"text\":\"        warn!(\\n            provider = provider_name,\\n            %error,\\n            \\\"Could not resume provider session during ACP session setup\\\"\\n        );\\n    }\\n}\\n\\npub(super) const DEFAULT_PROVIDER_ID: &str = \\\"goose\\\";\\npub(super) const DEFAULT_PROVIDER_LABEL: &str = \\\"Goose (Default)\\\";\\nconst PROVIDER_CONFIG_STATUS_CHECK_CONCURRENCY: usize = 16;\\n\\n/// In-memory state for an active ACP session.\\n///\\n/// ## Terminology (temporary, until all clients migrate to ACP)\\n///\\n/// The ACP protocol uses \\\"session\\\" to mean the conversation as the human sees it —\\n/// a durable, append-only exchange of messages. Internally, goose also has a concept\\n/// called \\\"Session\\\" (the `sessions` DB table) which represents the agent's working\\n/// state: the message list the LLM sees, compaction state, provider binding, etc.\\n///\\n/// The ACP session ID maps directly to a `sessions` row. The `sessions` HashMap\\n/// below is keyed by session ID.\\nstruct GooseAcpSession {\\n    agent: Arc<Agent>,\\n}\\n\\nstruct AgentStreamOutcome {\\n    was_cancelled: bool,\\n    output_token_limit_reached: bool,\\n}\\n\\n/// Releases a registry entry if the task consuming an agent stream is dropped\\n/// without reaching its explicit `clear_active_run` — e.g. a roaming\\n/// connection is revoked or lost mid-turn. Without this, the shared registry\\n/// retains the run forever and every later connection gets \\\"session already\\n/// has active run\\\".\\n///\\n/// The explicit clear still runs on normal paths; this drop is then a no-op\\n/// because the entry (matched by run id) is already gone.\\nstruct ActiveRunDropGuard {\\n    registry: Arc<ActiveRunRegistry>,\\n    session_id: String,\\n    run_id: String,\\n    cancel_token: CancellationToken,\\n}\\n\\nimpl Drop for ActiveRunDropGuard {\\n    fn drop(&mut self) {\\n        self.cancel_token.cancel();\\n        let session_id = std::mem::take(&mut self.session_id);\\n        let run_id = std::mem::take(&mut self.run_id);\\n        let agent = self.registry.remove_agent_run(&session_id, &run_id);\\n        if let Ok(handle) = tokio::runtime::Handle::try_current() {\"}]},\"match_line\":227,\"match_lines\":[227,242,248]}]}}"}],"isError":false},"duration":{"secs":5,"nanos":526991636}},"started_at_ms":1795300718524,"completed_at_ms":1795300724051}}
{"timestamp":"2026-11-21T22:38:44.200Z","ordinal":36668,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a20043-0de8-70a2-9652-ab4592dbee20","call_id":"call_9c24e8e0f68c4bd6af9cbde099df632c","output":[{"type":"input_text","text":"Script completed\nWall time 10.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"nexus\":[{\"type\":\"text\",\"text\":\"{\\\"_xerj\\\":{\\\"hints\\\":[{\\\"code\\\":\\\"lexical_on_semantic_text\\\",\\\"reason\\\":\\\"`body` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\\\",\\\"try\\\":{\\\"request\\\":\\\"POST /nexus-cli-*/_search\\\",\\\"body\\\":{\\\"query\\\":{\\\"semantic\\\":{\\\"field\\\":\\\"body\\\",\\\"query\\\":\\\"ContinuationBudget persistent objective task budget consume inference retry deadline resume\\\",\\\"k\\\":10}}}}}]},\\\"took\\\":4102,\\\"timed_out\\\":false,\\\"_shards\\\":{\\\"total\\\":2,\\\"successful\\\":2,\\\"skipped\\\":0,\\\"failed\\\":0},\\\"hits\\\":{\\\"total\\\":{\\\"value\\\":264,\\\"relation\\\":\\\"eq\\\"},\\\"max_score\\\":82.421616,\\\"hits\\\":[{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"0bb4eb8b19d51da2919f8ab552927f2f\\\",\\\"_score\\\":82.421616,\\\"_source\\\":{\\\"title\\\":\\\"types.ts\\\",\\\"ax_path\\\":\\\"types.ts\\\",\\\"ax_file\\\":\\\"axf2-6d204e771376e315f31b0bce312ffd4e-2c93\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":140,\\\"start_offset\\\":8113,\\\"end_offset\\\":8727,\\\"text\\\":\\\"export interface ExecutionResult {\\\\n  success: boolean;\\\\n  output: string;\\\\n  error?: string;\\\\n  /** The operation's deadline expired before an answer was received (bridge-level; the runner reports its own via `timed_out`). */\\\\n  timedOut?: boolean;\\\\n  /** The operator's cancel ended the operation (the runner ended the command's process group). */\\\\n  cancelled?: boolean;\\\\n  /** The request may have reached the executor, but no trustworthy result was received. */\\\\n  outcomeUnknown?: boolean;\\\\n  /** Why the call was refused before it ran (a stable code, e.g. VERIFICATION_CONFIG_PROTECTED). */\\\\n  denialReason?: string;\\\\n}\\\"}]},\\\"match_line\\\":145,\\\"match_lines\\\":[145]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"9924c753f725f01ef17daf84075d0d9c\\\",\\\"_score\\\":70.61245,\\\"_source\\\":{\\\"title\\\":\\\"config.ts\\\",\\\"ax_path\\\":\\\"config.ts\\\",\\\"ax_file\\\":\\\"axf2-c48039ebb5e58edf292473e733d50240-a8a3\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":719,\\\"start_offset\\\":38969,\\\"end_offset\\\":41005,\\\"text\\\":\\\"    [\\\\\\\"maxWaitMs\\\\\\\", effective.maxWaitMs, 1],\\\\n    [\\\\\\\"unknownResumeBudget\\\\\\\", effective.unknownResumeBudget, 0],\\\\n    [\\\\\\\"maxRunsPerUnit\\\\\\\", effective.maxRunsPerUnit, 1],\\\\n    [\\\\\\\"minWaitMs\\\\\\\", effective.minWaitMs, 1],\\\\n  ] as const;\\\\n  for (const [field, value, minimum] of fields) {\\\\n    if (typeof value !== \\\\\\\"number\\\\\\\" || !Number.isSafeInteger(value) || value < minimum) {\\\\n      throw new Error(`Invalid operation policy ${field}: expected a safe integer of at least ${minimum}.`);\\\\n    }\\\\n    if ((field === \\\\\\\"maxWaitMs\\\\\\\" || field === \\\\\\\"minWaitMs\\\\\\\") && value > maxTimerDelayMs) {\\\\n      throw new Error(`Invalid operation policy ${field}: must not exceed Node's timer limit (${maxTimerDelayMs} ms).`);\\\\n    }\\\\n  }\\\\n  const { maxWaitMs, minWaitMs } = effective;\\\\n  if (minWaitMs > maxWaitMs) {\\\\n    throw new Error(`Invalid operation wait settings: minWaitMs (${minWaitMs}) must not exceed maxWaitMs (${maxWaitMs}).`);\\\\n  }\\\\n  return Object.keys(policy).length ? policy : undefined;\\\\n}\\\\n\\\\n/**\\\\n * Continuation budgets: flags, then NEXUS_MAX_TOTAL_STEPS / NEXUS_MAX_TURN_MINUTES / NEXUS_STAGNATION_STEPS, then\\\\n * finite defaults. Total steps are charged to the durable objective ledger, so resume does not reset them.\\\\n * `--no-continuation` (or NEXUS_CONTINUATION=0) is the operator's explicit choice of the single-segment turn that\\\\n * ends at --max-steps.\\\\n */\\\\nexport function continuationBudget(options: any): ContinuationBudget | undefined {\\\\n  if (options.continuation === false || effectiveSetting(\\\\\\\"NEXUS_CONTINUATION\\\\\\\") === \\\\\\\"0\\\\\\\") return undefined;\\\\n  const positive = (flag: unknown, env: string | undefined, fallback: number, maximum = Number.POSITIVE_INFINITY): number => {\\\\n    for (const raw of [flag, env]) {\\\\n      if (raw === undefined || raw === null || raw === \\\\\\\"\\\\\\\") continue;\\\\n      const value = Number(raw);\\\\n      if (!Number.isFinite(value) || value <= 0) throw new Error(`Invalid continuation budget '${String(raw)}': expected a positive number.`);\\\\n      if (value > maximum) throw new Error(`Invalid continuation budget '${String(raw)}': maximum is ${maximum}.`);\\\"}]},\\\"match_line\\\":742,\\\"match_lines\\\":[742,746,752,753]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"a8bd6d54fcae1195a860c07a11d3b167\\\",\\\"_score\\\":59.27883,\\\"_source\\\":{\\\"title\\\":\\\"sidecar.ts\\\",\\\"ax_path\\\":\\\"sidecar.ts\\\",\\\"ax_file\\\":\\\"axf2-994a29d7a9a75ea68eac0027155266de-11745\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":174,\\\"start_offset\\\":9179,\\\"end_offset\\\":13218,\\\"text\\\":\\\"async handleLine(line: string): Promise<void> {\\\\n    if (!line.trim()) return;\\\\n    let command: SidecarCommand;\\\\n    try {\\\\n      command = parseCommand(line);\\\\n    } catch (err) {\\\\n      const id = err instanceof ProtocolError ? err.id : undefined;\\\\n      this.emit({ type: \\\\\\\"error\\\\\\\", ...(id ? { id } : {}), code: \\\\\\\"BAD_REQUEST\\\\\\\", message: (err as Error).message });\\\\n      return;\\\\n    }\\\\n    switch (command.type) {\\\\n      case \\\\\\\"prompt.submit\\\\\\\":\\\\n        this.submit(command.id, command.text);\\\\n        return;\\\\n      case \\\\\\\"steer\\\\\\\":\\\\n        this.steer(command.id, command.text);\\\\n        return;\\\\n      case \\\\\\\"cancel\\\\\\\":\\\\n        this.cancel();\\\\n        return;\\\\n      case \\\\\\\"approve\\\\\\\":\\\\n        this.resolveApproval(command.id, true, command.always);\\\\n        return;\\\\n      case \\\\\\\"deny\\\\\\\":\\\\n        this.resolveApproval(command.id, false, false);\\\\n        return;\\\\n      case \\\\\\\"answer\\\\\\\":\\\\n        // Bound to the decision by id; consumed when a turn reaches it (an unresolved steering conflict: at the next\\\\n        // turn's start). An id no turn asked about is simply never consumed.\\\\n        this.app.getAgent().setOperatorAnswers(new Map([[command.question, command.option]]));\\\\n        this.emit({ type: \\\\\\\"notice\\\\\\\", text: `Answer recorded for question ${command.question}: ${command.option}. It applies when the next turn reaches that decision.` });\\\\n        return;\\\\n      case \\\\\\\"checkpoint.choice\\\\\\\":\\\\n        this.resolveCheckpointChoice(command.id, command.choice);\\\\n        return;\\\\n      case \\\\\\\"slash\\\\\\\":\\\\n        this.slash(command.id, command.command, command.args);\\\\n        return;\\\\n      case \\\\\\\"tool.detail\\\\\\\":\\\\n      case \\\\\\\"receipt\\\\\\\":\\\\n        try {\\\\n          if (command.type === \\\\\\\"tool.detail\\\\\\\") this.toolDetail(command.id, command.evidence);\\\\n          else this.emit({ type: \\\\\\\"receipt\\\\\\\", id: command.id, sections: this.receipt() });\\\\n        } catch (err) {\\\\n          const message = errorText(err);\\\\n          this.emit({ type: \\\\\\\"error\\\\\\\", id: command.id, code: \\\\\\\"INTERNAL\\\\\\\", message });\\\\n        }\\\\n        return;\\\\n      case \\\\\\\"models.list\\\\\\\":\\\\n        if (this.app.getAgent().getApprovalMode() === \\\\\\\"read-only\\\\\\\") {\\\\n          this.emit({ type: \\\\\\\"error\\\\\\\", id: command.id, code: \\\\\\\"BUSY\\\\\\\", message: \\\\\\\"Provider discovery is disabled while the session is in read-only mode.\\\\\\\" });\\\\n          return;\\\\n        }\\\\n        void this.modelsList(command.id);\\\\n        return;\\\\n      case \\\\\\\"model.select\\\\\\\":\\\\n        if (this.app.getAgent().getApprovalMode() === \\\\\\\"read-only\\\\\\\") {\\\\n          this.emit({ type: \\\\\\\"error\\\\\\\", id: command.id, code: \\\\\\\"BUSY\\\\\\\", message: \\\\\\\"Model changes are disabled while the session is in read-only mode.\\\\\\\" });\\\\n          return;\\\\n        }\\\\n        this.modelSelect(command.id, command.provider, command.model);\\\\n        return;\\\\n      case \\\\\\\"provider.connect\\\\\\\":\\\\n        if (this.app.getAgent().getApprovalMode() === \\\\\\\"read-only\\\\\\\") {\\\\n          this.emit({ type: \\\\\\\"provider.result\\\\\\\", id: command.id, provider: command.provider, success: false, message: \\\\\\\"Provider connections are disabled while the session is in read-only mode.\\\\\\\" });\\\\n          return;\\\\n        }\\\\n        void this.providerConnect(command.id, command.provider, command.method, command.key, command.endpoint);\\\\n        return;\\\\n      case \\\\\\\"provider.cancel\\\\\\\":\\\\n        this.modelLists.get(command.id)?.abort();\\\\n        this.signIns.get(command.id)?.cancel();\\\\n        this.signIns.delete(command.id);\\\\n        cancelLocalEndpointSetup(command.id);\\\\n        return;\\\\n      case \\\\\\\"provider.local-cancel\\\\\\\":\\\\n        clearLocalEndpointSetup(command.id);\\\\n        return;\\\\n      case \\\\\\\"provider.disconnect\\\\\\\": {\\\\n        if (this.app.getAgent().getApprovalMode() === \\\\\\\"read-only\\\\\\\") {\\\\n          this.emit({ type: \\\\\\\"provider.result\\\\\\\", id: command.id, provider: command.provider, success: false, message: \\\\\\\"Provider changes are disabled while the session is in read-only mode.\\\\\\\" });\\\\n          return;\\\\n        }\\\\n        const r = disconnect(command.provider);\\\\n        this.emit({ type: \\\\\\\"provider.result\\\\\\\", id: command.id, provider: command.provider, success: r.ok, message: r.message });\\\\n        return;\\\\n      }\\\\n      case \\\\\\\"shutdown\\\\\\\":\\\\n        await this.shutdown();\\\\n        return;\\\\n    }\\\\n  }\\\"}]}},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"95a1414ca0ab35ad4a344da8abc96e25\\\",\\\"_score\\\":50.90848,\\\"_source\\\":{\\\"title\\\":\\\"run_turn.ts\\\",\\\"ax_path\\\":\\\"core/run_turn.ts\\\",\\\"ax_file\\\":\\\"axf2-fbd942dc3df6ecec33395bc515b98234-14921\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":244,\\\"start_offset\\\":13436,\\\"end_offset\\\":15462,\\\"text\\\":\\\"    tracker.beginTurn();\\\\n    if (continuingObjective) {\\\\n      const isHarnessResume = typeof taskPrompt === \\\\\\\"string\\\\\\\" && /^\\\\\\\\[(?:Nexus|Work unit resumed)/.test(taskPrompt);\\\\n      if (!isHarnessResume && !options?.resume && !isStep) {\\\\n        tracker.operatorInput(tracker.data.cumulativeSteps, `operator follow-up: ${promptText.slice(0, 160)}`);\\\\n      }\\\\n    }\\\\n    let stateNow = this.workspaceStateIdentity();\\\\n    this.turnStartState = stateNow;\\\\n    tracker.noteState(stateNow);\\\\n    tracker.noteLedgerState(this.ledgerProgressIdentity());\\\\n    const noticedPolls = new Set<string>();\\\\n    const noticedThrash = new Set<string>();\\\\n    let stateUnknownNoted = false;\\\\n    const callRing: CallRecord[] = [];\\\\n    let repeatedCallNote: string | undefined;\\\\n    let loopedCall: { name: string; count: number; arguments: string; history: NonNullable<TurnResult[\\\\\\\"repeatedCall\\\\\\\"]>[\\\\\\\"history\\\\\\\"] } | undefined;\\\\n\\\\n    while (modelStop === \\\\\\\"NONE\\\\\\\" && !interruption && !inferenceFailure && !persistenceFailure) {\\\\n      const convergence = this.turnConvergence as TurnResult[\\\\\\\"convergence\\\\\\\"];\\\\n      if (convergence && !stopReason) {\\\\n        stopReason = \\\\\\\"VERIFIER_NOT_CONVERGING\\\\\\\";\\\\n        stopDetail = convergence.evidence;\\\\n        if (this.objective && this.turnConvergenceUpTo !== undefined) this.objective.convergenceResetAfter = this.turnConvergenceUpTo;\\\\n      }\\\\n      if (stopReason) break;\\\\n      const taskStepLimitReached = budget\\\\n        ? tracker.data.cumulativeSteps >= maxTotalSteps\\\\n        : currentStep > maxTotalSteps;\\\\n      if (taskStepLimitReached) {\\\\n        stopReason = budget ? \\\\\\\"STEP_BUDGET_EXHAUSTED\\\\\\\" : \\\\\\\"STEP_LIMIT_REACHED\\\\\\\";\\\\n        stopDetail = budget\\\\n          ? `objective step limit ${maxTotalSteps} reached (${tracker.data.cumulativeSteps} steps consumed across runs)`\\\\n          : `--no-continuation: ${segmentSteps} steps`;\\\\n        break;\\\\n      }\\\\n      if (Date.now() > turnDeadline) {\\\\n        stopReason = \\\\\\\"TIME_BUDGET_EXHAUSTED\\\\\\\";\\\\n        stopDetail = `operator time limit ${budget!.maxTurnMinutes} min`;\\\\n        break;\\\\n      }\\\"}]},\\\"match_line\\\":248,\\\"match_lines\\\":[248,268,271,275,276,277,283]}]}}\"}],\"peer\":[{\"type\":\"text\",\"text\":\"{\\\"_xerj\\\":{\\\"hints\\\":[{\\\"code\\\":\\\"lexical_on_semantic_text\\\",\\\"reason\\\":\\\"`text` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `text`; to keep both signals, combine them with `hybrid`.\\\",\\\"try\\\":{\\\"request\\\":\\\"POST /goose-*/_search\\\",\\\"body\\\":{\\\"query\\\":{\\\"semantic\\\":{\\\"field\\\":\\\"text\\\",\\\"query\\\":\\\"scheduler durable task budget retry max runs execution timeout\\\",\\\"k\\\":10}}}}}]},\\\"took\\\":5412,\\\"timed_out\\\":false,\\\"_shards\\\":{\\\"total\\\":22,\\\"successful\\\":22,\\\"skipped\\\":0,\\\"failed\\\":0},\\\"hits\\\":{\\\"total\\\":{\\\"value\\\":4051,\\\"relation\\\":\\\"eq\\\"},\\\"max_score\\\":51.91136,\\\"hits\\\":[{\\\"_index\\\":\\\"goose-docs\\\",\\\"_id\\\":\\\"dc4a3ee2bc3da4df53c6a67f58ffa362\\\",\\\"_score\\\":51.91136,\\\"_source\\\":{\\\"title\\\":\\\"ops_retry.rs\\\",\\\"language\\\":\\\"rust\\\",\\\"ax_path\\\":\\\"crates/goose/src/agents/state_machine/ops_retry.rs\\\",\\\"ax_file\\\":\\\"axf2-810153849e3d1edc20bbabea2bc8c398-2718\\\",\\\"ax_locator\\\":\\\"code\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":171,\\\"start_offset\\\":5872,\\\"end_offset\\\":10005,\\\"text\\\":\\\"async fn run(\\\\n        &self,\\\\n        session: &Session,\\\\n        conversation: &Conversation,\\\\n        emit: &Emitter,\\\\n    ) -> Result<OperationResult<GooseEffect>> {\\\\n        let messages = messages_since_kickoff(conversation)?;\\\\n        if !ends_turn(messages) {\\\\n            return not_applicable();\\\\n        }\\\\n\\\\n        let state = GoalState::of(session);\\\\n        if !self.goal_was_nudged(messages) {\\\\n            if let Some(goal) = &state.goal {\\\\n                let nudge = format!(\\\\n                    \\\\\\\"Before finishing, check whether the following goal has been fully met:\\\\\\\\n\\\\\\\\n\\\\\\\\\\\\n                     **Goal:** {goal}\\\\\\\\n\\\\\\\\n\\\\\\\\\\\\n                     If not, continue working toward it.\\\\\\\"\\\\n                );\\\\n                let mut message = Message::user()\\\\n                    .with_text(&nudge)\\\\n                    .with_visibility(false, true);\\\\n                self.set_message_meta(&mut message, NUDGED, serde_json::json!(true));\\\\n                emit.message(Message::assistant().with_system_notification(\\\\n                    SystemNotificationType::InlineMessage,\\\\n                    format!(\\\\\\\"Goal: {goal}\\\\\\\"),\\\\n                ));\\\\n                return applied([message.into()]);\\\\n            }\\\\n        }\\\\n\\\\n        if let Some(grind) = &state.grind {\\\\n            let nudge = format!(\\\\n                \\\\\\\"Keep working. The grind goal is not yet complete:\\\\\\\\n\\\\\\\\n\\\\\\\\\\\\n                 **Goal:** {grind}\\\\\\\\n\\\\\\\\n\\\\\\\\\\\\n                 Continue until it is fully done.\\\\\\\"\\\\n            );\\\\n            let message = Message::user()\\\\n                .with_text(&nudge)\\\\n                .with_visibility(false, true);\\\\n            emit.message(Message::assistant().with_system_notification(\\\\n                SystemNotificationType::InlineMessage,\\\\n                format!(\\\\\\\"Grind: {grind}\\\\\\\"),\\\\n            ));\\\\n            return applied([message.into()]);\\\\n        }\\\\n\\\\n        if state.goal.is_some() {\\\\n            return applied([GooseEffect::extension_state(&GoalState::default())?]);\\\\n        }\\\\n\\\\n        let Some(retry_config) = Self::retry_config(session) else {\\\\n            return not_applicable();\\\\n        };\\\\n\\\\n        let retry_timeout = retry_config\\\\n            .timeout_seconds\\\\n            .map(Duration::from_secs)\\\\n            .unwrap_or(self.retry_timeout);\\\\n        let success =\\\\n            execute_success_checks_with_timeout(&retry_config.checks, retry_timeout).await;\\\\n        let success = match success {\\\\n            Ok(success) => success,\\\\n            Err(error) => {\\\\n                let message = emit.message(retry_error(&error.to_string()));\\\\n                return applied([message.into()]);\\\\n            }\\\\n        };\\\\n        if success {\\\\n            return not_applicable();\\\\n        }\\\\n\\\\n        let attempts = self.attempts(messages);\\\\n        if attempts >= retry_config.max_retries {\\\\n            let message = Message::assistant().with_error(\\\\n                MessageErrorKind::Other,\\\\n                format!(\\\\n                    \\\\\\\"Maximum retry attempts ({}) exceeded. Unable to complete the task successfully.\\\\\\\",\\\\n                    retry_config.max_retries\\\\n                ),\\\\n            );\\\\n            #[cfg(feature = \\\\\\\"telemetry\\\\\\\")]\\\\n            crate::posthog::emit_error(\\\\n                \\\\\\\"retry_max_exceeded\\\\\\\",\\\\n                &format!(\\\\\\\"Max retries ({}) exceeded\\\\\\\", retry_config.max_retries),\\\\n            );\\\\n            let message = emit.message(message);\\\\n            return applied([message.into()]);\\\\n        }\\\\n\\\\n        if let Some(command) = &retry_config.on_failure {\\\\n            let timeout = retry_config\\\\n                .on_failure_timeout_seconds\\\\n                .map(Duration::from_secs)\\\\n                .unwrap_or(self.on_failure_timeout);\\\\n            if let Err(error) = execute_on_failure_command_with_timeout(command, timeout).await {\\\\n                let message = emit.message(retry_error(&error.to_string()));\\\\n                return applied([message.into()]);\\\\n            }\\\\n        }\\\\n\\\\n        let mut reset = Self::reset_conversation(conversation)?;\\\\n        if let Some(kickoff) = reset.messages_mut().last_mut() {\\\\n            self.set_message_meta(kickoff, ATTEMPTS, serde_json::json!(attempts + 1));\\\\n        }\\\\n        applied([reset.into()])\\\\n    }\\\"}]},\\\"match_line\\\":249,\\\"match_lines\\\":[249,256,263,267]},{\\\"_index\\\":\\\"goose-docs\\\",\\\"_id\\\":\\\"fe4fbd41ca3bc706098fd99bbfa70966\\\",\\\"_score\\\":51.81205,\\\"_source\\\":{\\\"title\\\":\\\"provider.rs\\\",\\\"language\\\":\\\"rust\\\",\\\"ax_path\\\":\\\"crates/goose/src/acp/provider.rs\\\",\\\"ax_file\\\":\\\"axf2-eacbab89c2d7000fb563f80d3e2352c9-2c092\\\",\\\"ax_locator\\\":\\\"code\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":3931,\\\"start_offset\\\":148188,\\\"end_offset\\\":150233,\\\"text\\\":\\\"            &provider.effort.capability,\\\\n            &[SessionConfigOption::select(\\\\n                \\\\\\\"effort\\\\\\\",\\\\n                \\\\\\\"Thinking\\\\\\\",\\\\n                \\\\\\\"default\\\\\\\",\\\\n                effort_select_options(&[\\\\\\\"default\\\\\\\", \\\\\\\"high\\\\\\\"]),\\\\n            )\\\\n            .category(SessionConfigOptionCategory::ThoughtLevel)],\\\\n        );\\\\n\\\\n        let handle = tokio::spawn(async move {\\\\n            provider\\\\n                .apply_effort_if_changed(&model_with_effort(\\\\\\\"high\\\\\\\"))\\\\n                .await\\\\n                .unwrap()\\\\n        });\\\\n\\\\n        assert_eq!(\\\\n            expect_set_config_option(&mut rx).await,\\\\n            (\\\\\\\"effort\\\\\\\".to_string(), \\\\\\\"high\\\\\\\".to_string())\\\\n        );\\\\n\\\\n        handle.await.unwrap();\\\\n    }\\\\n\\\\n    /// The menu advertises the global default once the persisted pick stops\\\\n    /// being offered (a model switch rebuilt the agent's selector), so the send\\\\n    /// path has to apply it too — otherwise the agent silently runs at its own\\\\n    /// current while the client shows the global.\\\\n    #[tokio::test]\\\\n    async fn apply_effort_if_changed_falls_back_to_the_global_default() {\\\\n        let _guard = env_lock::lock_env([(\\\\\\\"GOOSE_THINKING_EFFORT\\\\\\\", Some(\\\\\\\"high\\\\\\\"))]);\\\\n        let (tx, mut rx) = mpsc::channel(1);\\\\n        let provider =\\\\n            test_provider_with_effort(tx, Some(effort_capability(&[\\\\\\\"default\\\\\\\", \\\\\\\"high\\\\\\\"], \\\\\\\"default\\\\\\\")));\\\\n        let model = model_with_effort(\\\\\\\"medium\\\\\\\");\\\\n\\\\n        let handle =\\\\n            tokio::spawn(async move { provider.apply_effort_if_changed(&model).await.unwrap() });\\\\n\\\\n        assert_eq!(\\\\n            expect_set_config_option(&mut rx).await,\\\\n            (\\\\\\\"effort\\\\\\\".to_string(), \\\\\\\"high\\\\\\\".to_string())\\\\n        );\\\\n\\\\n        handle.await.unwrap();\\\\n    }\\\\n\\\\n    #[tokio::test]\\\\n    async fn apply_effort_if_changed_skips_unmapped_value() {\\\\n        // Unoffered by the capability below, so the global default never wins\\\\n        // and the test doesn't depend on the machine's configured value.\\\\n        let _guard = env_lock::lock_env([(\\\\\\\"GOOSE_THINKING_EFFORT\\\\\\\", Some(\\\\\\\"medium\\\\\\\"))]);\\\\n        let (tx, mut rx) = mpsc::channel(1);\\\"}]},\\\"match_line\\\":3959,\\\"match_lines\\\":[3959]},{\\\"_index\\\":\\\"goose-docs\\\",\\\"_id\\\":\\\"aadfe3a185e74d0de6485b457f961e9a\\\",\\\"_score\\\":50.22988,\\\"_source\\\":{\\\"title\\\":\\\"full.rs\\\",\\\"language\\\":\\\"rust\\\",\\\"ax_path\\\":\\\"crates/goose/src/scheduler/full.rs\\\",\\\"ax_file\\\":\\\"axf2-532882ab5cb7924b47b99677c794c92e-e0ce\\\",\\\"ax_locator\\\":\\\"code\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":828,\\\"start_offset\\\":29001,\\\"end_offset\\\":36463,\\\"text\\\":\\\"async fn execute_job(\\\\n    job: ScheduledJob,\\\\n    jobs: Arc<Mutex<JobsMap>>,\\\\n    job_id: String,\\\\n    cancel_token: CancellationToken,\\\\n    session_manager: Arc<SessionManager>,\\\\n) -> Result<String> {\\\\n    if job.source.is_empty() {\\\\n        return Ok(job.id.to_string());\\\\n    }\\\\n\\\\n    let recipe_path = Path::new(&job.source);\\\\n    let recipe_content = fs::read_to_string(recipe_path)?;\\\\n    // Use the original recipe directory for path resolution so that relative\\\\n    // references (sub-recipes, template includes) survive the copy into scheduled_recipes/.\\\\n    let recipe_dir_owned;\\\\n    let recipe_dir = if let Some(ref base) = job.recipe_base_dir {\\\\n        recipe_dir_owned = PathBuf::from(base);\\\\n        recipe_dir_owned.as_path()\\\\n    } else {\\\\n        recipe_path.parent().unwrap_or(Path::new(\\\\\\\".\\\\\\\"))\\\\n    };\\\\n\\\\n    let recipe: Recipe = build_recipe_from_template(\\\\n        recipe_content,\\\\n        recipe_dir,\\\\n        job.parameters.clone(),\\\\n        None::<fn(&str, &str) -> anyhow::Result<String>>,\\\\n    )\\\\n    .map_err(|e| anyhow!(e.to_string()))?;\\\\n\\\\n    let agent = Agent::with_config(AgentConfig::new(\\\\n        session_manager,\\\\n        PermissionManager::instance(),\\\\n        None,\\\\n        true,\\\\n        GoosePlatform::GooseCli,\\\\n    ));\\\\n\\\\n    let config = Config::global();\\\\n    let provider_name = config.get_goose_provider()?;\\\\n    let model_name = config.get_goose_model()?;\\\\n    let model_config =\\\\n        crate::model_config::model_config_from_user_config(&provider_name, &model_name)?\\\\n            .with_cache_ttl_clamped();\\\\n\\\\n    let session = agent\\\\n        .config\\\\n        .session_manager\\\\n        .create_session(\\\\n            std::env::current_dir()?,\\\\n            format!(\\\\\\\"Scheduled job: {}\\\\\\\", job.id),\\\\n            SessionType::Scheduled,\\\\n            GooseMode::Auto,\\\\n        )\\\\n        .await?;\\\\n\\\\n    let mut extensions = resolve_extensions_for_new_session(recipe.extensions.as_deref(), None);\\\\n    if recipe.extensions.is_none() {\\\\n        extensions.extend(crate::plugins::mcp_servers::enabled_plugin_mcp_servers(\\\\n            std::env::current_dir().ok().as_deref(),\\\\n        ));\\\\n    }\\\\n    for ext in &extensions {\\\\n        agent.add_extension(ext.clone(), &session.id).await?;\\\\n    }\\\\n\\\\n    agent\\\\n        .switch_provider(&session.id, &provider_name, model_config)\\\\n        .await?;\\\\n    agent\\\\n        .update_goose_mode(GooseMode::Auto, &session.id)\\\\n        .await?;\\\\n\\\\n    let mut jobs_guard = jobs.lock().await;\\\\n    if let Some((_, job_def)) = jobs_guard.get_mut(job_id.as_str()) {\\\\n        job_def.current_session_id = Some(session.id.clone());\\\\n    }\\\\n    drop(jobs_guard);\\\\n\\\\n    let start_time = std::time::Instant::now();\\\\n\\\\n    let recipe_display_name = recipe_path\\\\n        .file_name()\\\\n        .and_then(|name| name.to_str())\\\\n        .unwrap_or(&job.id);\\\\n    let recipe_version = recipe.version.clone();\\\\n\\\\n    tracing::info!(\\\\n        monotonic_counter.goose.session_starts = 1,\\\\n        session_type = \\\\\\\"schedule\\\\\\\",\\\\n        interface = \\\\\\\"scheduler\\\\\\\",\\\\n        interactive = false,\\\\n        \\\\\\\"Scheduled session started\\\\\\\"\\\\n    );\\\\n\\\\n    tracing::info!(\\\\n        monotonic_counter.goose.recipe_runs = 1,\\\\n        recipe_name = %recipe_display_name,\\\\n        recipe_version = %recipe_version,\\\\n        session_type = \\\\\\\"schedule\\\\\\\",\\\\n        interface = \\\\\\\"scheduler\\\\\\\",\\\\n        \\\\\\\"Recipe execution started\\\\\\\"\\\\n    );\\\\n\\\\n    #[cfg(feature = \\\\\\\"telemetry\\\\\\\")]\\\\n    tokio::spawn(async move {\\\\n        let mut props = HashMap::new();\\\\n        props.insert(\\\\n            \\\\\\\"trigger\\\\\\\".to_string(),\\\\n            serde_json::Value::String(\\\\\\\"automated\\\\\\\".to_string()),\\\\n        );\\\\n        if let Err(e) = posthog::emit_event(\\\\\\\"schedule_job_started\\\\\\\", props).await {\\\\n            tracing::debug!(\\\\\\\"Failed to send schedule telemetry: {}\\\\\\\", e);\\\\n        }\\\\n    });\\\\n\\\\n    let prompt_text = recipe\\\\n        .prompt\\\\n        .as_deref()\\\\n        .filter(|s| !s.trim().is_empty())\\\\n        .or_else(|| {\\\\n            recipe\\\\n                .instructions\\\\n                .as_deref()\\\\n                .filter(|s| !s.trim().is_empty())\\\\n        })\\\\n        .ok_or_else(|| {\\\\n            anyhow!(\\\\\\\"Recipe must specify at least one of `instructions` or `prompt`.\\\\\\\")\\\\n        })?;\\\\n\\\\n    let user_message = Message::user().with_text(prompt_text);\\\\n    let mut conversation = Conversation::new_unvalidated(vec![user_message.clone()]);\\\\n\\\\n    agent\\\\n        .config\\\\n        .session_manager\\\\n        .update(&session.id)\\\\n        .schedule_id(Some(job.id.clone()))\\\\n        .recipe(Some(recipe.clone()))\\\\n        .apply()\\\\n        .await?;\\\\n\\\\n    let session_config = SessionConfig {\\\\n        id: session.id.clone(),\\\\n        schedule_id: Some(job.id.clone()),\\\\n        max_turns: None,\\\\n    };\\\\n\\\\n    let stream = agent\\\\n        .reply(user_message, session_config, Some(cancel_token.clone()))\\\\n        .await?;\\\\n\\\\n    use futures::StreamExt;\\\\n    let mut stream = std::pin::pin!(stream);\\\\n\\\\n    let mut stream_error = false;\\\\n    while let Some(message_result) = stream.next().await {\\\\n        tokio::task::yield_now().await;\\\\n\\\\n        match message_result {\\\\n            Ok(AgentEvent::Message(msg)) => {\\\\n                conversation.push(msg);\\\\n            }\\\\n            Ok(AgentEvent::HistoryReplaced(updated)) => {\\\\n                conversation = updated;\\\\n            }\\\\n            Ok(_) => {}\\\\n            Err(e) => {\\\\n                tracing::error!(\\\\\\\"Error in agent stream: {}\\\\\\\", e);\\\\n                stream_error = true;\\\\n                break;\\\\n            }\\\\n        }\\\\n    }\\\\n\\\\n    {\\\\n        let session_duration = start_time.elapsed();\\\\n        let exit_type = if stream_error { \\\\\\\"error\\\\\\\" } else { \\\\\\\"normal\\\\\\\" };\\\\n        let (total_tokens, message_count) = agent\\\\n            .config\\\\n            .session_manager\\\\n            .get_session(&session.id, false)\\\\n            .await\\\\n            .map(|s| (s.usage.total_tokens.unwrap_or(0), s.message_count))\\\\n            .unwrap_or((0, 0));\\\\n\\\\n        tracing::info!(\\\\n            monotonic_counter.goose.session_completions = 1,\\\\n            session_type = \\\\\\\"schedule\\\\\\\",\\\\n            interface = \\\\\\\"scheduler\\\\\\\",\\\\n            exit_type,\\\\n            duration_ms = session_duration.as_millis() as u64,\\\\n            total_tokens,\\\\n            message_count,\\\\n            \\\\\\\"Session completed\\\\\\\"\\\\n        );\\\\n\\\\n        tracing::info!(\\\\n            monotonic_counter.goose.session_duration_ms = session_duration.as_millis() as u64,\\\\n            session_type = \\\\\\\"schedule\\\\\\\",\\\\n            interface = \\\\\\\"scheduler\\\\\\\",\\\\n            \\\\\\\"Session duration\\\\\\\"\\\\n        );\\\\n\\\\n        if total_tokens > 0 {\\\\n            tracing::info!(\\\\n                monotonic_counter.goose.session_tokens = total_tokens,\\\\n                session_type = \\\\\\\"schedule\\\\\\\",\\\\n                interface = \\\\\\\"scheduler\\\\\\\",\\\\n                \\\\\\\"Session tokens\\\\\\\"\\\\n            );\\\\n        }\\\\n    }\\\\n\\\\n    #[cfg(feature = \\\\\\\"telemetry\\\\\\\")]\\\\n    {\\\\n        let duration_secs = start_time.elapsed().as_secs();\\\\n        tokio::spawn(async move {\\\\n            let mut props = HashMap::new();\\\\n            props.insert(\\\\n                \\\\\\\"trigger\\\\\\\".to_string(),\\\\n                serde_json::Value::String(\\\\\\\"automated\\\\\\\".to_string()),\\\\n            );\\\\n            props.insert(\\\\n                \\\\\\\"status\\\\\\\".to_string(),\\\\n                serde_json::Value::String(\\\\\\\"completed\\\\\\\".to_string()),\\\\n            );\\\\n            props.insert(\\\\n                \\\\\\\"duration_seconds\\\\\\\".to_string(),\\\\n                serde_json::Value::Number(serde_json::Number::from(duration_secs)),\\\\n            );\\\\n            if let Err(e) = posthog::emit_event(\\\\\\\"schedule_job_completed\\\\\\\", props).await {\\\\n                tracing::debug!(\\\\\\\"Failed to send schedule telemetry: {}\\\\\\\", e);\\\\n            }\\\\n        });\\\\n    }\\\\n\\\\n    Ok(session.id)\\\\n}\\\"}]},\\\"match_line\\\":931,\\\"match_lines\\\":[920,930,931,987,1019,1030,1038]},{\\\"_index\\\":\\\"goose-docs\\\",\\\"_id\\\":\\\"6c127720c4aceb3208700e9f4d305539\\\",\\\"_score\\\":49.62568,\\\"_source\\\":{\\\"title\\\":\\\"server.rs\\\",\\\"language\\\":\\\"rust\\\",\\\"ax_path\\\":\\\"crates/goose/src/acp/server.rs\\\",\\\"ax_file\\\":\\\"axf2-1cca7c298415c59a2f3e738c440c762f-23934\\\",\\\"ax_locator\\\":\\\"code\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":209,\\\"start_offset\\\":8946,\\\"end_offset\\\":10989,\\\"text\\\":\\\"        warn!(\\\\n            provider = provider_name,\\\\n            %error,\\\\n            \\\\\\\"Could not resume provider session during ACP session setup\\\\\\\"\\\\n        );\\\\n    }\\\\n}\\\\n\\\\npub(super) const DEFAULT_PROVIDER_ID: &str = \\\\\\\"goose\\\\\\\";\\\\npub(super) const DEFAULT_PROVIDER_LABEL: &str = \\\\\\\"Goose (Default)\\\\\\\";\\\\nconst PROVIDER_CONFIG_STATUS_CHECK_CONCURRENCY: usize = 16;\\\\n\\\\n/// In-memory state for an active ACP session.\\\\n///\\\\n/// ## Terminology (temporary, until all clients migrate to ACP)\\\\n///\\\\n/// The ACP protocol uses \\\\\\\"session\\\\\\\" to mean the conversation as the human sees it —\\\\n/// a durable, append-only exchange of messages. Internally, goose also has a concept\\\\n/// called \\\\\\\"Session\\\\\\\" (the `sessions` DB table) which represents the agent's working\\\\n/// state: the message list the LLM sees, compaction state, provider binding, etc.\\\\n///\\\\n/// The ACP session ID maps directly to a `sessions` row. The `sessions` HashMap\\\\n/// below is keyed by session ID.\\\\nstruct GooseAcpSession {\\\\n    agent: Arc<Agent>,\\\\n}\\\\n\\\\nstruct AgentStreamOutcome {\\\\n    was_cancelled: bool,\\\\n    output_token_limit_reached: bool,\\\\n}\\\\n\\\\n/// Releases a registry entry if the task consuming an agent stream is dropped\\\\n/// without reaching its explicit `clear_active_run` — e.g. a roaming\\\\n/// connection is revoked or lost mid-turn. Without this, the shared registry\\\\n/// retains the run forever and every later connection gets \\\\\\\"session already\\\\n/// has active run\\\\\\\".\\\\n///\\\\n/// The explicit clear still runs on normal paths; this drop is then a no-op\\\\n/// because the entry (matched by run id) is already gone.\\\\nstruct ActiveRunDropGuard {\\\\n    registry: Arc<ActiveRunRegistry>,\\\\n    session_id: String,\\\\n    run_id: String,\\\\n    cancel_token: CancellationToken,\\\\n}\\\\n\\\\nimpl Drop for ActiveRunDropGuard {\\\\n    fn drop(&mut self) {\\\\n        self.cancel_token.cancel();\\\\n        let session_id = std::mem::take(&mut self.session_id);\\\\n        let run_id = std::mem::take(&mut self.run_id);\\\\n        let agent = self.registry.remove_agent_run(&session_id, &run_id);\\\\n        if let Ok(handle) = tokio::runtime::Handle::try_current() {\\\"}]},\\\"match_line\\\":227,\\\"match_lines\\\":[227,242,248]}]}}\"}]}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","create_time":1795300724.200609}},"metadata":{"history_sequence":16385,"sampled_through_sequence":16382,"client_authored":false,"fallback_token_limit_override":12000}}
