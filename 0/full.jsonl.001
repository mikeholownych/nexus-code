);\n    const chunks = [];\n    let outputBytes = 0;\n    let oversized = false;\n    if (captureStdout) {\n      child.stdout.on(\"data\", (chunk) => {\n        outputBytes += chunk.length;\n        if (outputBytes > MAX_SCORE_OUTPUT_BYTES) {\n          oversized = true;\n          child.kill(\"SIGTERM\");\n          return;\n        }\n        chunks.push(chunk);\n      });\n    }\n    child.once(\"error\", reject);\n    child.once(\"close\", (code, signal) => {\n      if (oversized) return reject(new Error(\"score output exceeded the runner API size limit\"));\n      if (code !== 0) return reject(new Error(`${path.basename(script)} failed (${code ?? signal ?? \"unknown\"})`));\n      resolve(captureStdout ? Buffer.concat(chunks).toString(\"utf8\") : undefined);\n    });\n  });\n}\n\nfunction makeRunnerConfig(config, nexusExecutable, privateDir) {\n  const result = { ...config, agent: \"nexus\", nexusExecutable };\n  if (typeof result.apiKey === \"string\" && result.apiKey.length > 0) {\n    if (/[\\r\\n]/.test(result.apiKey)) throw new Error(\"API key cannot contain newline characters\");\n    const apiKeyFile = path.join(privateDir, \"api-key.env\");\n    fs.writeFileSync(apiKeyFile, `NEXUS_EVAL_API_KEY=REDACTED, { encoding: \"utf8\", mode: 0o600, flag: \"wx\" });\n    fs.chmodSync(apiKeyFile, 0o600);\n  // Under the resource contract these are on a tmpfs, so candidate writes count against the run's memory limit.\n  const scratch = config.resources?.workspaceRoot ?? os.tmpdir();\n  const ws = fs.mkdtempSync(path.join(scratch, `nexus-eval-${task.id}-`));\n  const checkDirs = [];\n  const home = fs.mkdtempSync(path.join(scratch, \"nexus-eval-home-\"));\n  const budget = effectiveBudget(task, config);\n  const base = { task: task.id, tier: task.tier, ...(task.tier === \"T3\" ? { t3SteeringItems: task.steering.length } : {}), config: config.name, agent: config.agent ?? \"nexus\", agentVersion: agentIdentity.record, budget, run, harness: identity.string, model: confi