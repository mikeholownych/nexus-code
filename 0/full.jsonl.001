renceSteps: number; steps: number } },\n379:    let delegatedBudgetOption: { maxInferenceSteps: number; steps: number } | undefined;\n389:        delegatedBudgetOption = options?.delegatedBudget;\n396:        delegatedBudgetOption = (inheritedWorktreeScopeOrOptions as { delegatedBudget?: { maxInferenceSteps: number; steps: number } }).delegatedBudget;\n404:      delegatedBudgetOption = options.delegatedBudget;\n411:    this.delegatedBudget = delegatedBudgetOption;\n1669:  private persistObjectiveBudget(): boolean {\n1686:      persist: () => parent.persistObjectiveBudget(),\n4325:      this.delegatedBudget = undefined;\n4644:      if (this.delegatedBudget && this.delegatedBudget.steps >= this.delegatedBudget.maxInferenceSteps) {\n4645:        return { completed: false, summary: finalSummary, reason: `delegated inference budget exhausted (${this.delegatedBudget.steps}/${this.delegatedBudget.maxInferenceSteps})` };\n4661:        const persisted = this.sharedObjectiveBudget ? this.sharedObjectiveBudget.persist() : this.persistObjectiveBudget();\n4667:      if (this.delegatedBudget) this.delegatedBudget.steps++;\n","exit_code":0,"duration":{"secs":0,"nanos":41991}},"started_at_ms":1795301094779,"completed_at_ms":1795301094780}}
