{"timestamp":"2026-10-28T17:36:02.028Z","ordinal":467203,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a1838f-4c7d-7b60-a64b-253c51d0a9ff","item":{"type":"CommandExecution","id":"exec-44cd67ae-cf2f-4f66-974d-0f4958272966","process_id":"95754","command":["/usr/bin/zsh","-lc","printf '%s\\n' '--- operation runner refactor test ---'; git show origin/main:cli/test/operation_runner_refactor.test.ts | sed -n '1,240p'; printf '%s\\n' '--- lifecycle-related test titles ---'; git grep -n -i 'test(\".*(operation|unit|schedule|execute|complete|lifecycle)' origin/main -- cli/test | head -80; printf '%s\\n' '--- DecisionRejected docs ---'; git show origin/main:docs/EXECUTION_CONVERGENCE.md | sed -n '85,106p'; printf '%s\\n' '--- policy config schema ---'; git show origin/main:cli/src/config.ts | rg -n -C 3 'operationPolicy|config.json|DEFAULT_OPERATION_POLICY' | head -90"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"printf '%s\\n' '--- operation runner refactor test ---'; git show origin/main:cli/test/operation_runner_refactor.test.ts | sed -n '1,240p'; printf '%s\\n' '--- lifecycle-related test titles ---'; git grep -n -i 'test(\".*(operation|unit|schedule|execute|complete|lifecycle)' origin/main -- cli/test | head -80; printf '%s\\n' '--- DecisionRejected docs ---'; git show origin/main:docs/EXECUTION_CONVERGENCE.md | sed -n '85,106p'; printf '%s\\n' '--- policy config schema ---'; git show origin/main:cli/src/config.ts | rg -n -C 3 'operationPolicy|config.json|DEFAULT_OPERATION_POLICY' | head -90"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"--- operation runner refactor test ---\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { test } from \"node:test\";\nimport { newOperation } from \"../src/core/operation.js\";\nimport { OperationRunner } from \"../src/core/operation_runner.js\";\nimport { reportOperationDiagnostic } from \"../src/core/operation_runner_diagnostics.js\";\nimport { OperationStore } from \"../src/core/operation_runner_persistence.js\";\nimport type { RecoveryClock } from \"../src/core/provider_recovery.js\";\n\nconst resource = {\n  id: \"primary\",\n  provider: \"https://provider.invalid\",\n  endpoint: \"https://provider.invalid/v1\",\n  model: \"test-model\",\n  capabilities: [\"tools\"],\n  rank: 0,\n};\n\ntest(\"default operation diagnostics keep machine-readable stdout clean\", () => {\n  const stdoutWrites: string[] = [];\n  const stderrWrites: string[] = [];\n  const originalStdoutWrite = process.stdout.write;\n  const originalStderrWrite = process.stderr.write;\n  process.stdout.write = ((chunk: string | Uint8Array) => {\n    stdoutWrites.push(String(chunk));\n    return true;\n  }) as typeof process.stdout.write;\n  process.stderr.write = ((chunk: string | Uint8Array) => {\n    stderrWrites.push(String(chunk));\n    return true;\n  }) as typeof process.stderr.write;\n  try {\n    reportOperationDiagnostic(undefined, \"revalidation\", \"catalog_refresh_failed\");\n  } finally {\n    process.stdout.write = originalStdoutWrite;\n    process.stderr.write = originalStderrWrite;\n  }\n\n  assert.deepEqual(stdoutWrites, []);\n  assert.deepEqual(stderrWrites, [\"[operation:debug:revalidation] catalog_refresh_failed\\n\"]);\n});\n\ntest(\"operation revalidation logs bounded diagnostics and continues after catalog refresh errors\", async () => {\n  const now = Date.now();\n  const clock: RecoveryClock = { now: () => now, random: () => 0.5, sleep: async () => undefined };\n  const state = newOperation(\"op-diagnostic\", \"objective\", [{ id: \"unit\", title: \"unit\", prompt: \"do work\" }], [resource], now);\n  const diagnostics: Array<{ level: string; area: string; action: string }> = [];\n  const runner = new OperationRunner(state, {\n    clock,\n    executor: {\n      refresh: async () => { throw new Error(\"secret endpoint and credential must not be logged\"); },\n      run: async () => ({ kind: \"completed\", summary: \"done\", outcome: \"NOT_REQUIRED\" }),\n    },\n    persist: () => undefined,\n    onDiagnostic: (event) => diagnostics.push(event),\n  });\n\n  const result = await runner.run();\n\n  assert.equal(result.status, \"COMPLETE\");\n  assert.deepEqual(diagnostics, [{ level: \"debug\", area: \"revalidation\", action: \"catalog_refresh_failed\" }]);\n  assert.equal(JSON.stringify(diagnostics).includes(\"secret\"), false);\n});\n\ntest(\"malformed operation lock emits a bounded diagnostic before refusing concurrent execution\", (t) => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-operation-lock-diagnostic-\"));\n  t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n  const workspace = path.join(root, \"workspace\");\n  fs.mkdirSync(workspace);\n  const diagnostics: Array<{ level: string; area: string; action: string }> = [];\n  const store = new OperationStore(workspace, path.join(root, \"state\"), root, (event) => diagnostics.push(event));\n  const lockPath = path.join(store.manager.getBaseDir(), \"op-lock.lock\");\n  fs.writeFileSync(lockPath, \"not-json\");\n\n  assert.throws(() => store.acquire(\"op-lock\"), /already being driven/);\n  assert.deepEqual(diagnostics, [{ level: \"debug\", area: \"persistence\", action: \"lock_read_failed\" }]);\n  assert.equal(fs.existsSync(lockPath), true);\n});\n--- lifecycle-related test titles ---\n--- DecisionRejected docs ---\ncontext compaction removes a tool observation (elided or truncated by the detail budget) and the turn does not run\nthat tool with the same arguments again, the turn is `UNVERIFIED` with reason `CONTEXT_EVIDENCE_NOT_RETAINED`. The\ndurable record tells the model exactly which outputs left its context (`Output no longer in context (rerun to see it\nagain): <tool> <args>`), carries which notes still hold full output (`retainedObservations`), and a resumed unit\nre-derives what it no longer holds from its recovered conversation. Removal tracking is per turn (plus resumed\nconversations); an interactive REPL turn relying on output compacted away in an earlier turn is not flagged.\n\n### Decisions\n\nA BLOCKED unit carries `{ id: \"<unit>#<n>\", cause, question, options[] }`. Every option is a typed `DecisionAction`:\n`retry` (optionally clearing operator-needed resource conditions), `keep_waiting`, `assign` (to a named resource,\nlisting the requirements it overrides — never independence or trust), `revise` (operator note appended to the unit's\ntask), `drop` (advisory units only) and `cancel_operation`. `ConvergenceScheduler.resolve` validates the decision id,\nthe option id and the action against current state and throws `DecisionRejected` otherwise; applying one records\nit on `unit.decisions`, emits `DECISION_APPLIED` and resumes the operation under the driver lock. Operators apply\nthem with `nexus operation decide <operation> <decision> <option> [--note …] [--no-resume]`. Nothing else mutates a\nBLOCKED unit.\n\n### Rejected decisions\n\n`nexus operation decide` reports a rejected choice as `Decision rejected: …` on stderr and exits with status `2`.\nThe rejection happens before the updated operation state is saved, so an invalid choice does not alter durable\n--- policy config schema ---\n6-import { credentialOriginOf, credentialStorageHome, environmentCredential, LocalLlmClient, operatorSetting, setCredentialAuthority } from \"./client.js\";\n7-import { baseUrlSetting, originOf, parseOriginList, PROVIDERS, providerDefinition } from \"./providers.js\";\n8-import { providerApiKey } from \"./credentials.js\";\n9:import { DEFAULT_OPERATION_POLICY } from \"./core/operation.js\";\n10-import { ContinuationBudget, DEFAULT_CONTINUATION, HarnessConfig, ApprovalMode } from \"./types.js\";\n11-\n12-const installEnv = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../.env\");\n--\n14-let credentialAuthorityRecorded = false;\n15-let shellEnvironment: Record<string, string | undefined> = {};\n16-let userConfigFile: Record<string, string> = {};\n17:let operatorJsonOperationPolicy: HarnessConfig[\"operationPolicy\"];\n18-let operatorJsonOperationPolicyError: Error | undefined;\n19-const SHELL_PRECEDENCE_KEYS = [\"NEXUS_VERIFY_ATTESTATION\"] as const;\n20-const OPERATOR_CONFIG_JSON_LIMIT = 64 * 1024;\n--\n29-    bytesRead += count;\n30-  }\n31-  if (bytesRead > OPERATOR_CONFIG_JSON_LIMIT) {\n32:    throw new Error(\"Nexus config.json exceeds the 64 KiB size limit.\");\n33-  }\n34-  return buffer.subarray(0, bytesRead).toString(\"utf8\");\n35-}\n--\n78-    userConfigFile = parseDotenv(fs.readFileSync(globalConfig));\n79-  }\n80-  // Structured operator settings are separate from the legacy dotenv file. They are read only from the\n81:  // operator's home; a project nexus.config.json is never trusted as operator policy.\n82-  operatorJsonOperationPolicy = undefined;\n83-  operatorJsonOperationPolicyError = undefined;\n84-  try {\n85:    operatorJsonOperationPolicy = readOperatorOperationPolicy(path.join(operatorHome, \".config/nexus/config.json\"));\n86-  } catch (error) {\n87-    // Preserve the invalid policy for buildConfig to reject. Deferring only the throw lets `nexus doctor`\n88-    // report a structured config.valid finding; no execution path may proceed with policy defaults instead.\n89:    operatorJsonOperationPolicyError = error instanceof Error ? error : new Error(\"Unable to read operator config.json.\");\n90-  }\n91-  // A provenance setting chosen in the operator's shell outranks config.env, which was applied with override above:\n92-  // config.env NEXUS_VERIFY_ATTESTATION=0 must not defeat an explicit NEXUS_VERIFY_ATTESTATION=1 for this run.\n--\n416-  if (coderProvider && !coderModel) throw new Error(`Coder provider '${coderProvider}' needs an explicit model: pass --coder-model or set CODER_LLM_MODEL.`);\n417-  const plannerApiKey = REDACTED ? providerKey(plannerProvider) : undefined;\n418-  const coderApiKey = REDACTED ? providerKey(coderProvider) : undefined;\n419:  const operationPolicy = configuredOperationPolicy();\n420-\n421-  // Disclosure authority: destinations the operator selected (flags, operator environment, config.env) plus origins\n422-  // listed in NEXUS_CLOUD_DISCLOSURE_ORIGINS. An endpoint chosen only by a project .env, and any fallback endpoint,\n--\n476-    ...(cloudRoutedOrigins.length ? { cloudRoutedOrigins } : {}),\n477-    ...(reasoningEffort ? { reasoningEffort } : {}),\n478-    ...(anthropicThinkingBudget ? { anthropicThinkingBudget } : {}),\n479:    ...(operationPolicy ? { operationPolicy } : {}),\n480-  };\n481-}\n482-\n--\n484- * Durable operation scheduling defaults are operator policy, so read them only through operatorSetting; a project\n485- * `.env` cannot silently change how long an operation waits or how often Nexus retries work.\n486- */\n487:export function configuredOperationPolicy(setting: (key: string) => string | undefined = operatorSetting): HarnessConfig[\"operationPolicy\"] {\n488-  if (operatorJsonOperationPolicyError) throw operatorJsonOperationPolicyError;\n489-  // Node timers clamp larger delays to 1 ms. Keep operator policy inside the\n490-  // supported timer range so long waits cannot turn into a wake/revalidate loop.\n--\n495-    [\"NEXUS_OPERATION_MAX_RUNS_PER_UNIT\", \"maxRunsPerUnit\", 1],\n496-    [\"NEXUS_OPERATION_MIN_WAIT_MS\", \"minWaitMs\", 1],\n497-  ] as const;\n498:  const policy: NonNullable<HarnessConfig[\"operationPolicy\"]> = {};\n499-  for (const [key, property, minimum] of fields) {\n500-    const shellValue = shellEnvironment[key];\n501-    const legacyFileValue = userConfigFile[key];\n502-    const structuredValue = operatorJsonOperationPolicy?.[property];\n503:    // Shell overrides the structured file; config.json supersedes config.env; config.env remains a\n504-    // compatibility fallback. `setting` remains injectable and covers callers before environment loading.\n505-    const raw = shellValue !== undefined\n506-      ? shellValue\n--\n526-}\n527-\n528-/** Read and validate only the supported operator-owned structured configuration fields. */\n529:function readOperatorOperationPolicy(file: string): HarnessConfig[\"operationPolicy\"] {\n530-  let pathStat: fs.Stats;\n531-  try {\n532-    pathStat = fs.lstatSync(file);\n533-  } catch (error: any) {\n534-    if (error?.code === \"ENOENT\") return undefined;\n535:    throw new Error(\"Unable to inspect the operator config.json file.\");\n536-  }\n537:  if (pathStat.isSymbolicLink()) throw new Error(\"Nexus config.json must not be a symbolic link.\");\n538:  if (!pathStat.isFile()) throw new Error(\"Nexus config.json must be a regular file.\");\n","exit_code":0,"duration":{"secs":0,"nanos":29799}},"started_at_ms":1793208962027,"completed_at_ms":1793208962028}}
