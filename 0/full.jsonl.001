.objective, \"<workspace-scan>\", \"The bounded shell snapshot did not cover the entire workspace; verification-file edits may be missing.\");\n+    }\n     for (const c of changes) {\n-      if (!this.objective || c.beforeText === undefined) continue;\n+      if (c.class !== \"test_file\") continue;\n+      if (c.beforeText === undefined) {\n+        recordUnverifiableTestEdit(this.objective, c.path, \"The changed test file exceeded the retained snapshot size, so weakening could not be assessed.\");\n+        continue;\n+      }\n       recordTestEdit(this.objective, { path: c.path, before: c.beforeText, after: c.afterText ?? \"\" });\n     }\n   } : undefined);\ndiff --git a/cli/src/core/regression_obligations.ts b/cli/src/core/regression_obligations.ts\nindex d1e77419..64836c98 100644\n--- a/cli/src/core/regression_obligations.ts\n+++ b/cli/src/core/regression_obligations.ts\n@@ -29,7 +29,7 @@ export interface RegressionObligation {\n   weakenings: Array<{ at: string; path: string; kind: WeakeningKind; detail: string }>;\n }\n \n-export type WeakeningKind = \"removed\" | \"skipped\" | \"fewer-assertions\";\n+export type WeakeningKind = \"removed\" | \"skipped\" | \"fewer-assertions\" | \"unverifiable-change\";\n \n export interface ReferenceDeclaration { requirementId: string; reference: string; authorisedAt: string }\n \n@@ -208,6 +208,14 @@ export function recordTestEdit(ledger: ObjectiveLedger, edit: { path: string; be\n   }\n }\n \n+/** Record a detected test-file change when bounded snapshots cannot establish whether an authorised test was weakened. */\n+export function recordUnverifiableTestEdit(ledger: ObjectiveLedger, path: string, detail: string, at?: string): void {\n+  for (const ob of active(ledger)) {\n+    if (ob.weakenings.some((w) => w.kind === \"unverifiable-change\" && w.path === path && w.detail === detail)) continue;\n+    ob.weakenings.push({ at: at ?? now(), path, kind: \"unverifiable-change\", detail });\n+  }\n+}\n+\n /**\n  * DV-4 gate: a behavioural reference (previous revision, golden cases) may be declared only by the operator, and only\n  * for a requirement the operator wrote. This records authority only; `runDifferential` (VC-3) runs the comparison.\ndiff --git a/cli/src/security.ts b/cli/src/security.ts\nindex 70bed79c..a1b7a7f1 100644\n--- a/cli/src/security.ts\n+++ b/cli/src/security.ts\n@@ -78,6 +78,7 @@ export interface VerificationSnapshot {\n }\n export interface VerificationShellGuard {\n   before: VerificationSnapshot;\n+  refusal?: string;\n }\n export interface VerificationShellChange {\n   path: string;\n@@ -884,7 +885,11 @@ export class SecurityManager {\n    */\n   public beginVerificationShellGuard(): VerificationShellGuard | undefined {\n     if ((this.policy.verificationPaths?.mode ?? \"approve\") !== \"block\" && !this.shellChangeObserver) return undefined;\n-    return { before: this.snapshotVerificationFiles() };\n+    const before = this.snapshotVerificationFiles();\n+    const refusal = (this.policy.verificationPaths?.mode ?? \"approve\") === \"block\" && !before.complete\n+      ? `${VERIFICATION_CONFIG_PROTECTED}: the bounded verification snapshot is incomplete, so shell execution is refused until the workspace can be scanned completely.`\n+      : undefined;\n+    return { before, ...(refusal ? { refusal } : {}) };\n   }\n \n   /**\n@@ -892,24 +897,24 @@ export class SecurityManager {\n    * refused). The agent sets it while an operator-authorised regression obligation exists, so a test edited through the\n    * shell is recorded from the same snapshot and diff the block mode uses.\n    */\n-  public setShellChangeObserver(observer: ((changes: VerificationShellChange[]) => void) | undefined): void {\n+  public setShellChangeObserver(observer: ((changes: VerificationShellChange[], scan: { complete: boolean }) => void) | undefined): void {\n     this.shellChangeObserver = observer;\n   }\n-  private shellChangeObserver?: (changes: VerificationShellChange[]) => void;\n+  private shellChangeObserver?: (changes: VerificationShellChange[], scan: { complete: boolean }) => void;\n \n   /** What changed in the verification files since `guard` began. In block mode each change is reverted, recorded as blocked and returned as the refusal. */\n   public finishVerificationShellGuard(guard: VerificationShellGuard, role?: string): { error?: string; note?: string } {\n     const after = this.snapshotVerificationFiles();\n     const block = (this.policy.verificationPaths?.mode ?? \"approve\") === \"block\";\n+    const complete = guard.before.complete && after.complete;\n+    const changes = diffVerificationSnapshots(guard.before.files, after.files, (rel) => this.classifyVerificationPath(rel)?.class);\n+    if (changes.length || !complete) this.shellChangeObserver?.(changes, { complete });\n     if (!block) {\n-      const seen = diffVerificationSnapshots(guard.before.files, after.files, (rel) => this.classifyVerificationPath(rel)?.class);\n-      if (seen.length) this.shellChangeObserver?.(seen);\n       return {};\n     }\n     const note = !guard.before.complete || !after.complete\n       ? `[nexus] Shell-write guard: the workspace is larger than the ${VERIFICATION_SNAPSHOT_MAX_ENTRIES}-entry scan limit, so verification files beyond it were not checked.`\n       : undefined;\n-    const changes = diffVerificationSnapshots(guard.before.files, after.files, (rel) => this.classifyVerificationPath(rel)?.class);\n     if (!changes.length) return note ? { note } : {};\n     const lines: string[] = [];\n     for (const change of changes) {\n@@ -956,7 +961,11 @@ export class SecurityManager {\n           if (!complete) return;\n         } else if (entry.isFile()) {\n           const rel = path.relative(this.workspace, child).replace(/\\\\/g, \"/\");\n-          if (this.classifyVerificationPath(rel)) files.set(rel, this.fingerprintVerificationFile(child, rel));\n+          if (this.classifyVerificationPath(rel)) {\n+            const state = this.fingerprintVerificationFile(child, rel);\n+            if (state) files.set(rel, state);\n+            else complete = false;\n+          }\n         }\n       }\n     };\n@@ -964,10 +973,10 @@ export class SecurityManager {\n     return { files, complete };\n   }\n \n-  private fingerprintVerificationFile(abs: string, rel: string): VerificationFileState {\n+  private fingerprintVerificationFile(abs: string, rel: string): VerificationFileState | undefined {\n     try {\n       const stat = fs.statSync(abs);\n-      if (stat.size > VERIFICATION_SNAPSHOT_MAX_BYTES) return { hash: `large:${stat.size}:${stat.mtimeMs}` };\n+      if (stat.size > VERIFICATION_SNAPSHOT_MAX_BYTES) return undefined;\n       const raw = fs.readFileSync(abs);\n       let subject: Buffer | string = raw;\n       if (isConditionalConfig(rel)) {\n@@ -982,7 +991,7 @@ export class SecurityManager {\n       }\n       return { hash: createHash(\"sha256\").update(subject).digest(\"hex\"), raw: raw.length <= VERIFICATION_SNAPSHOT_KEEP_BYTES ? raw : undefined };\n     } catch {\n-      return { hash: \"unreadable\" };\n+      return undefined;\n     }\n   }\n \ndiff --git a/cli/src/tools.ts b/cli/src/tools.ts\nindex d3286fea..109de8eb 100644\n--- a/cli/src/tools.ts\n+++ b/cli/src/tools.ts\n@@ -1160,6 +1160,7 @@ export class RustCoreBridge {\n   async executeTool(toolName: string, args: Record<string, any>, authority?: VerificationEditContext): Promise<ExecutionResult> {\n     // CS-2: in verificationPaths mode \"block\" a shell command may not change verification files (reverted and refused).\n     const guard = toolName === \"run_command\" ? this.securityManager.beginVerificationShellGuard() : undefined;\n+    if (guard?.refusal) return { success: false, output: \"\", error: guard.refusal, denialReason: VERIFICATION_CONFIG_PROTECTED };\n     const result = await this.executeToolChecked(toolName, args, authority);\n     if (!guard) return result;\n     const verdict = this.securityManager.finishVerificationShe