{"timestamp":"2026-11-21T22:58:48.702Z","ordinal":37439,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","item":{"type":"CommandExecution","id":"exec-a43cec78-363e-4890-af99-88767376508d","process_id":"81418","command":["/usr/bin/zsh","-lc","git diff --stat && git status --short && sed -n '105,145p' cli/test/objective_continuation.test.ts && sed -n '220,290p' cli/test/execution_tracking.test.ts"],"cwd":"file:///home/mike/nexus-wt/p10-02-tool-invocation-budget","parsed_cmd":[{"type":"unknown","cmd":"git diff --stat && git status --short && sed -n '105,145p' cli/test/objective_continuation.test.ts && sed -n '220,290p' cli/test/execution_tracking.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":" cli/src/config.ts                       | 16 ++++++++-\n cli/src/core/execution_tracking.ts      | 31 +++++++++++++++--\n cli/src/core/objective.ts               |  2 ++\n cli/src/core/run_turn.ts                | 58 ++++++++++++++++++++++++++++--\n cli/src/core/turn.ts                    | 10 ++++++\n cli/src/index.ts                        |  3 ++\n cli/src/types.ts                        | 10 ++++++\n cli/test/execution_tracking.test.ts     | 16 +++++++++\n cli/test/objective_continuation.test.ts | 62 ++++++++++++++++++++++++++++++++-\n 9 files changed, 202 insertions(+), 6 deletions(-)\n M cli/src/config.ts\n M cli/src/core/execution_tracking.ts\n M cli/src/core/objective.ts\n M cli/src/core/run_turn.ts\n M cli/src/core/turn.ts\n M cli/src/index.ts\n M cli/src/types.ts\n M cli/test/execution_tracking.test.ts\n M cli/test/objective_continuation.test.ts\n      (agent as any).config.maxToolInvocations = 5;\n      const resumed = await agent.runTurn(\"\", undefined, { resume: true });\n      assert.equal(resumed.execution, \"LIMIT_REACHED\");\n      assert.equal(resumed.reason, \"TOOL_INVOCATION_BUDGET_EXHAUSTED\");\n      assert.equal(gw.requests.length, 2, \"resume may inspect state but cannot dispatch beyond the persisted ceiling\");\n      assert.deepEqual(fs.readdirSync(repo).filter((name) => name.startsWith(\"budget-\")).sort(), [\"budget-1.txt\", \"budget-2.txt\"]);\n      assert.equal(agent.getObjective()!.execution!.toolInvocations, 2);\n      assert.equal(agent.getObjective()!.continuation.maxToolInvocations, 2, \"a later flag cannot renew an exhausted objective\");\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"legacy objective continuation counts are not reset when the execution tracker is missing or stale\", () => {\n    const ledger = createLedger(\"Continue the existing task.\");\n    ledger.continuation.totalSteps = 17;\n    delete ledger.execution;\n    assert.equal(trackingOf(ledger).data.cumulativeSteps, 17);\n\n    ledger.execution!.cumulativeSteps = 9;\n    assert.equal(trackingOf(ledger).data.cumulativeSteps, 17);\n  });\n\n  test(\"direct agent construction rejects step or time limits above the hard ceilings\", () => {\n    const repo = makeRepo();\n    try {\n      assert.throws(\n        () => new AutonomousAgent(cfg(\"http://127.0.0.1:9/v1\", repo, { continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: MAX_CONTINUATION_STEPS + 1 } })),\n        /expected an integer from 1 to 5000/,\n      );\n      assert.throws(\n        () => new AutonomousAgent(cfg(\"http://127.0.0.1:9/v1\", repo, { continuation: { ...DEFAULT_CONTINUATION, maxTurnMinutes: MAX_CONTINUATION_MINUTES + 1 } })),\n        /expected a finite value from 1 second to 4320 minutes/,\n      );\n    } finally {\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n    const t = ExecutionTracker.fresh();\n    const base = { step: 1, trigger: \"auto\" as const, archivedMessages: 1, committed: true };\n    assert.equal(t.compaction({ ...base, id: \"a\", beforeTokens: 52000, afterTokens: 51000 }, 65536, true).lowYield, true);\n    t.compaction({ ...base, id: \"b\", beforeTokens: 52000, afterTokens: 51500 }, 65536, true);\n    assert.equal(t.data.lowYieldCompactions, 2);\n    t.compaction({ ...base, id: \"c\", beforeTokens: 60000, afterTokens: 20000 }, 65536, true);\n    assert.equal(t.data.lowYieldCompactions, 0);\n    // A compaction forced because the request did not fit is never low-yield thrash.\n    assert.equal(t.compaction({ ...base, id: \"d\", beforeTokens: 70000, afterTokens: 69000 }, 65536, false).lowYield, undefined);\n  });\n});\n\ndescribe(\"the ledger carries tracking\", () => {\n  test(\"a new ledger has tracking; a restored ledger without it is completed; the pinned block shows loops and failures\", () => {\n    const ledger = createLedger(\"1. Fix A\\n2. Fix B\");\n    assert.ok(ledger.execution);\n    const old = structuredClone(ledger) as any;\n    delete old.execution;\n    const t = trackingOf(old);\n    assert.equal(t.data.cumulativeSteps, 0);\n    for (let i = 1; i <= 3; i++) t.observe(i, obs(\"run_command\", { command: \"make\" }, \"error 1\", \"S\", false));\n    const pinned = renderPinnedLedger(old, false);\n    assert.match(pinned, /Repeated without progress/);\n    assert.match(pinned, /Failed approaches/);\n    assert.deepEqual(normalizeTracking(JSON.parse(JSON.stringify(old.execution))).repetitions.length, 1);\n    assert.deepEqual(Object.keys(createTracking()).sort(), Object.keys(normalizeTracking(undefined)).sort());\n  });\n\n  test(\"every holder shares one tracking record: re-reading it never orphans a running tracker\", () => {\n    // Live finding (2026-10-13): compaction re-read the ledger's tracking mid-turn and replaced it with a copy, so the\n    // turn's further steps went to an orphaned record (persisted cumulativeSteps 1 after an 11-step turn).\n    const ledger = createLedger(\"Refactor the parser\");\n    const running = trackingOf(ledger);\n    running.beginStep();\n    const again = trackingOf(ledger);\n    running.beginStep();\n    assert.equal(again.data, running.data);\n    assert.equal(ledger.execution!.cumulativeSteps, 2);\n    const legacy: any = { cumulativeSteps: 4 };\n    assert.equal(normalizeTracking(legacy), legacy, \"filled in place\");\n    assert.deepEqual(legacy.repetitions, []);\n    assert.equal(legacy.toolInvocations, 0);\n    assert.equal(legacy.toolInvocationHistoryComplete, false, \"legacy records must not present a missing counter as an observed zero\");\n  });\n\n  test(\"tool invocation admissions are bounded and legacy counts remain explicitly incomplete\", () => {\n    const tracker = ExecutionTracker.fresh();\n    assert.equal(tracker.admitToolInvocations(5, 2), 2);\n    assert.equal(tracker.admitToolInvocations(1, 2), 0);\n    assert.equal(tracker.data.toolInvocations, 2);\n    assert.equal(tracker.data.toolInvocationHistoryComplete, true);\n\n    const restored = normalizeTracking({ version: 1, cumulativeSteps: 4 });\n    assert.equal(restored.toolInvocations, 0);\n    assert.equal(restored.toolInvocationHistoryComplete, false);\n    assert.equal(new ExecutionTracker(restored).admitToolInvocations(1, 1), 1);\n    assert.equal(restored.toolInvocationHistoryComplete, false, \"new counts remain a lower bound after a legacy upgrade\");\n  });\n\n  test(\"an unfinished single-request objective continued with 'continue' keeps its ledger; new work starts a new one\", () => {\n    const ledger = createLedger(\"Refactor the parser\");\n    ledger.outcome = { status: \"incomplete\", reason: \"stagnation\", remaining: [], at: \"x\" };\n    for (const p of [\"continue\", \"Continue.\", \"keep going\", \"please continue where you left off\", \"try again\", \"resume\"]) {\n      assert.equal(isContinuationPrompt(p), true, p);\n      assert.equal(isNewObjective(ledger, p), false, p);\n    }\n    for (const p of [\"continue with the README instead\", \"fix the lexer\", \"Now write docs for it\"]) {\n      assert.equal(isNewObjective(ledger, p), true, p);\n    }\n    ledger.outcome = { status: \"completed\", reason: \"done\", remaining: [], at: \"x\" };\n    assert.equal(isNewObjective(ledger, \"continue\"), true, \"a completed objective is never continued\");\n","exit_code":0,"duration":{"secs":0,"nanos":914532449}},"started_at_ms":1795301927787,"completed_at_ms":1795301928702}}
