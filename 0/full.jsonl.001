13003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 938\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:9e809e8eaf38f110c769c7fc\",\n      \"paths\": [\n        \"workflow.branching.rules\"\n      ],\n      \"kind\": \"convention\",\n      \"locus\": [\n        \"v1.0.0\"\n      ],\n      \"text\": \"The user has authorized necessary commits, pushes, PRs, merges, RC tags and stable publication for the v1.0.0 effort after required gates pass; do not request those approvals again, and coordinate publication through one designated release publisher.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"f73ff17f-fe7b-4087-bd8d-f26ad4102ad2\",\n          \"checkpoint_id\": \"01M59W4SMWH7G60B0E53VW0D22\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 3\n        },\n        {\n          \"session_id\": \"f73ff17f-fe7b-4087-bd8d-f26ad4102ad2\",\n          \"checkpoint_id\": \"01M59W4SMWH7G60B0E53VW0D22\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:50:18.135593148Z\",\n      \"updated_at\": \"2026-10-28T07:50:18.135593148Z\"\n    },\n    {\n      \"id\": \"fact:7216490098139ca86ee7cab2\",\n      \"paths\": [\n        \"workflow.release.notes\"\n      ],\n      \"kind\": \"convention\",\n      \"text\": \"Release-note approval covers only the reviewed merged scope; any additional user-visible change merged before tagging requires its own bullet and another review before the tag.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 1428\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:050f2a39d9261b65895c0d5c\",\n      \"paths\": [\n        \"workflow.review.rules\"\n      ],\n      \"kind\": \"invariant\",\n      \"text\": \"Release merges require a recorded independent ACCEPT and green CI for the exact PR head; self-acceptance and unrecorded claims of reviewer acceptance do not satisfy the gate.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 504\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n    