ted pre-change baseline survived resume/);\n      assert.notEqual(turn.verification?.status, \"PASSED\");\n      assert.notEqual(turn.outcome, \"VERIFIED\");\n    } finally {\n      for (const agent of agents) agent.shutdown();\n      await gw.close();\n      fs.rmSync(root, { recursive: true, force: true });\n      fs.rmSync(stateDir, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n      fs.rmSync(bin, { recursive: true, force: true });\n      process.env.HOME = saved.HOME;\n      if (saved.XDG_CONFIG_HOME === undefined) delete process.env.XDG_CONFIG_HOME;\n      else process.env.XDG_CONFIG_HOME = saved.XDG_CONFIG_HOME;\n      process.env.PATH = saved.PATH;\n      if (saved.NEXUS_TYPECHECK === undefined) delete process.env.NEXUS_TYPECHECK;\n      else process.env.NEXUS_TYPECHECK = saved.NEXUS_TYPECHECK;\n    }\n  });\n\n  test(\"classification with a baseline: a new error in an untouched file is FAILED, a known one PREEXISTING\", () => {\n    const check = { tool: \"tsc\" as const, configPath: \"tsconfig.json\" };\n    const ws = os.tmpdir();\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1f730-5dda-7050-8748-e755b63ef781","create_time":1795150223.5508811}},"metadata":{"history_sequence":13613,"sampled_through_sequence":13610,"client_authored":false,"fallback_token_limit_override":12000}}
