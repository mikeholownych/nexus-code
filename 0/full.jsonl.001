{"timestamp":"2026-11-02T08:27:50.547Z","ordinal":35241,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19b3e-e325-7090-bf1f-c31aa606240e","item":{"type":"CommandExecution","id":"exec-842a03bc-2815-4583-8c92-e5bf3c31b7ad","process_id":"83624","command":["/usr/bin/zsh","-lc","sed -n '295,322p' eval/run.mjs; sed -n '105,140p' eval/score.mjs; sed -n '1,85p' cli/src/eval_cli.ts"],"cwd":"file:///home/mike/nexus-wt/v112-wp1104-integration","parsed_cmd":[{"type":"read","cmd":"sed -n '295,322p' eval/run.mjs","name":"run.mjs","path":"eval/run.mjs"},{"type":"read","cmd":"sed -n '105,140p' eval/score.mjs","name":"score.mjs","path":"eval/score.mjs"},{"type":"read","cmd":"sed -n '1,85p' cli/src/eval_cli.ts","name":"eval_cli.ts","path":"cli/src/eval_cli.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    const turn = agent.json?.turn ?? null;\n    // Nexus reports a structured outcome; for the other agents a clean exit within the budget is their completion claim.\n    const claimedComplete = turn\n      ? turn.execution === \"COMPLETED\" && [\"VERIFIED\", \"REGRESSION_FREE\", \"UNVERIFIED\", \"NOT_REQUIRED\"].includes(turn.outcome)\n      : agent.code === 0 && !agent.timedOut && !agent.outputExceeded;\n    return {\n      ...base,\n      wallMs,\n      exitCode: agent.code,\n      timedOut: agent.timedOut,\n      outputExceeded: agent.outputExceeded,\n      turn: turn && { execution: turn.execution, outcome: turn.outcome, reason: turn.reason ?? null, steps: turn.steps ?? null, contextNotRetained: turn.contextNotRetained ?? 0 },\n      claimedComplete,\n      claimedVerified: turn?.outcome === \"VERIFIED\",\n      hiddenPass: hidden.pass,\n      regressionPass: regression ? regression.pass : null,\n      falseVerified: turn?.outcome === \"VERIFIED\" && !hidden.pass,\n      contaminated,\n      tokens: agent.json?.tokenStats ?? null,\n      ...(hardening ? { hardened: { baseline: hardening.baseline, applied: hardening.applied.length, discarded: hardening.discarded, configChanges: hardening.configChanges } } : {}),\n      ...(t3 ? { t3 } : {}),\n      model,\n      ...((agent.t4FaultsInjected?.length || fixtureFaults.length) ? { t4FaultsInjected: [...(agent.t4FaultsInjected ?? []), ...fixtureFaults] } : {}),\n      resources: config.resources ? { agent: agent.resources, hidden: hidden.resources ?? null, regression: regression?.resources ?? null, ...(t3BaselineResources.length ? { t3Baseline: t3BaselineResources } : {}) } : null,\n      logs: saveLogs(task, run, agent, hidden, regression),\n    };\n  } catch (err) {\n    return { ...base, wallMs: 0, error: String(err?.message ?? err), hiddenPass: false, regressionPass: null, falseVerified: false, claimedComplete: false, claimedVerified: false };\n// Pooled rates leave contaminated runs out (the agent could have seen the hidden tests); they are counted separately.\nconst pooled = [...new Set(records.map((r) => r.config))].map((config) => {\n  const all = records.filter((r) => r.config === config);\n  const rs = all.filter((r) => !r.contaminated);\n  const k = rs.filter((r) => r.hiddenPass).length;\n  const sum = (xs) => xs.reduce((a, b) => a + (b ?? 0), 0);\n  return {\n    config,\n    n: rs.length,\n    excludedContaminated: all.length - rs.length,\n    correct: k,\n    rate: rs.length ? k / rs.length : 0,\n    ci: wilson(k, rs.length),\n    falseVerified: all.filter((r) => r.falseVerified).length,\n    crashRate: all.length ? all.filter(crashed).length / all.length : 0,\n    regressions: rs.filter((r) => r.regressionPass === false).length,\n    // Cost of the whole configuration's runs per correct result (failed runs cost too).\n    tokensPerCorrect: k ? sum(rs.map((r) => r.tokens?.total)) / k : null,\n    wallSecondsPerCorrect: k ? sum(rs.map((r) => r.wallMs)) / 1000 / k : null,\n  };\n});\n\n// T4: emit all nine preregistered classes, including empty rows. Proxy, task-fixture, and\n// runner-injected events share one scoring path so a proxy-only result cannot look complete.\nconst t4Events = (r) => [\n  ...(r.model?.faultsInjected ?? []).map((f) => ({ ...f, source: f.source ?? \"model_proxy\" })),\n  ...(r.t4FaultsInjected ?? []),\n];\nconst expectedSource = (kind) => T4_PROXY_CLASSES.has(kind) ? \"model_proxy\" : T4_RUNNER_CLASSES.has(kind) ? \"task_fixture_or_runner\" : null;\nconst runnerEvidenceValid = (event) => {\n  const evidence = event.evidence;\n  if (!evidence || typeof evidence !== \"object\") return false;\n  if (event.kind === \"sigterm_resume\") {\n    return evidence.signal === \"SIGTERM\"\n      && evidence.delivered === true\n      && Number.isInteger(evidence.deliveredProcesses)\nimport * as fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { pathToFileURL } from \"node:url\";\nimport type { HarnessConfig } from \"./types.js\";\n\nexport interface VersionedEvalCommandOptions {\n  dataset?: string;\n  output?: string;\n  runs?: string | number;\n  limit?: string | number;\n  maxMinutes?: string | number;\n  split?: \"regression\" | \"benchmark\";\n  workspace?: string;\n  maxSteps?: string | number;\n  temperature?: string | number;\n}\n\nexport interface VersionedEvalRuntimeResolver {\n  packageRoot: string;\n  nexusExecutable: string;\n  runnerApiPath: string;\n}\n\nexport interface VersionedEvalRunnerResult {\n  outputDir: string;\n  resultsFile: string;\n  manifestFile: string;\n  scoreFile: string;\n  score: Record<string, unknown>;\n}\n\nfunction positiveInteger(value: string | number | undefined, option: string, fallback: number): number {\n  if (value === undefined) return fallback;\n  const text = String(value);\n  if (!/^[1-9][0-9]*$/.test(text)) throw new Error(`${option} must be a positive whole number`);\n  const parsed = Number(text);\n  if (!Number.isSafeInteger(parsed)) throw new Error(`${option} exceeds the supported integer range`);\n  return parsed;\n}\n\nexport function resolveInstalledEvalRuntime(env: NodeJS.ProcessEnv = process.env): VersionedEvalRuntimeResolver {\n  if (!env.NEXUS_HOME || !path.isAbsolute(env.NEXUS_HOME)) {\n    throw new Error(\"versioned evaluation requires the installed Nexus launcher (NEXUS_HOME is unavailable)\");\n  }\n  const packageRoot = fs.realpathSync(env.NEXUS_HOME);\n  const isWithinPackage = (candidate: string) => candidate === packageRoot || candidate.startsWith(`${packageRoot}${path.sep}`);\n  const nexusExecutable = fs.realpathSync(path.join(packageRoot, \"bin\", \"nexus\"));\n  if (!isWithinPackage(nexusExecutable)) throw new Error(\"installed Nexus launcher resolves outside NEXUS_HOME\");\n  const executableStat = fs.statSync(nexusExecutable);\n  if (!executableStat.isFile() || (executableStat.mode & 0o111) === 0) {\n    throw new Error(\"installed Nexus launcher is not executable\");\n  }\n  const runnerApiPath = fs.realpathSync(path.join(packageRoot, \"eval\", \"runner_api.mjs\"));\n  if (!isWithinPackage(runnerApiPath) || !fs.statSync(runnerApiPath).isFile()) {\n    throw new Error(\"installed evaluator runtime is incomplete or resolves outside NEXUS_HOME\");\n  }\n  return { packageRoot, nexusExecutable, runnerApiPath };\n}\n\n/** Isolate startup state before the launcher loads environment or operator configuration. */\nexport function isolateEvalCommandHome(args: readonly string[]): (() => void) | undefined {\n  if (args[0] !== \"eval\" || !args.includes(\"--isolated-home\")) return undefined;\n  const home = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-cli-home-\"));\n  fs.chmodSync(home, 0o700);\n  const isolatedEnvironment: Record<string, string> = {\n    HOME: home,\n    XDG_CONFIG_HOME: path.join(home, \".config\"),\n    XDG_DATA_HOME: path.join(home, \".local\", \"share\"),\n    XDG_STATE_HOME: path.join(home, \".local\", \"state\"),\n    XDG_CACHE_HOME: path.join(home, \".cache\"),\n  };\n  const previousEnvironment = new Map(Object.keys(isolatedEnvironment).map((key) => [key, process.env[key]]));\n  Object.assign(process.env, isolatedEnvironment);\n  return () => {\n    for (const [key, value] of previousEnvironment) {\n      if (value === undefined) delete process.env[key];\n      else process.env[key] = value;\n    }\n    fs.rmSync(home, { recursive: true, force: true });\n  };\n}\n\nexport async function runVersionedEvalCommand(\n  options: VersionedEvalCommandOptions,\n","exit_code":0,"duration":{"secs":1,"nanos":214341435}},"started_at_ms":1793608069331,"completed_at_ms":1793608070547}}
