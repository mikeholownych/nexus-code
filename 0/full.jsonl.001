ain a lower bound after a legacy upgrade\");\ntest/objective_continuation.test.ts:18:import { createLedger, seedRequirements, applyRequirementUpdates, isNewObjective, failedCheckFrom, renderPinnedLedger, acceptDescoping, requirementDone, readObjective, invalidateVerified, queueSteering, amendObjective, trackingOf } from \"../src/core/objective.js\";\ntest/objective_continuation.test.ts:62:  test(\"tool invocation ceilings have finite defaults, accept operator overrides, and stay hard bounded\", () => {\ntest/objective_continuation.test.ts:120:  test(\"legacy objective continuation counts are not reset when the execution tracker is missing or stale\", () => {\ntest/objective_continuation.test.ts:124:    assert.equal(trackingOf(ledger).data.cumulativeSteps, 17);\ntest/objective_continuation.test.ts:127:    assert.equal(trackingOf(ledger).data.cumulativeSteps, 17);\n","exit_code":0,"duration":{"secs":0,"nanos":856045399}},"started_at_ms":1795301919711,"completed_at_ms":1795301920568}}
