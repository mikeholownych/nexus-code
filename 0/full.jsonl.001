":\"2026-10-30T09:40:45Z\",\"conclusion\":\"success\",\"name\":\"Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":5,\"startedAt\":\"2026-10-30T09:40:39Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:40:54Z\",\"conclusion\":\"success\",\"name\":\"Install pinned evaluator toolchains\",\"number\":6,\"startedAt\":\"2026-10-30T09:40:45Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:40:56Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-bubblewrap.sh\",\"number\":7,\"startedAt\":\"2026-10-30T09:40:54Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:40:57Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-user-cgroups.sh\",\"number\":8,\"startedAt\":\"2026-10-30T09:40:56Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:40:57Z\",\"conclusion\":\"success\",\"name\":\"Mount a dedicated capped tmpfs for evaluator resource fixtures\",\"number\":9,\"startedAt\":\"2026-10-30T09:40:57Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:41:05Z\",\"conclusion\":\"success\",\"name\":\"Run dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec\",\"number\":10,\"startedAt\":\"2026-10-30T09:40:57Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:41:08Z\",\"conclusion\":\"success\",\"name\":\"Install cargo tools (audit, deny, about, cyclonedx)\",\"number\":11,\"startedAt\":\"2026-10-30T09:41:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:41:13Z\",\"conclusion\":\"success\",\"name\":\"Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":12,\"startedAt\":\"2026-10-30T09:41:08Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:41:13Z\",\"conclusion\":\"success\",\"name\":\"Require the pinned release Node and npm versions\",\"number\":13,\"startedAt\":\"2026-10-30T09:41:13Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:41:14Z\",\"conclusion\":\"success\",\"name\":\"Install selected Node runtime for isolated evaluation commands\",\"number\":14,\"startedAt\":\"2026-10-30T09:41:13Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:41:14Z\",\"conclusion\":\"success\",\"name\":\"Require a version-matched tag on main\",\"number\":15,\"startedAt\":\"2026-10-30T09:41:14Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:41:14Z\",\"conclusion\":\"skipped\",\"name\":\"Require a stable tag to be a version-only commit on its RC\",\"number\":16,\"startedAt\":\"2026-10-30T09:41:14Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:41:15Z\",\"conclusion\":\"success\",\"name\":\"Run npm ci --prefix cli\",\"number\":17,\"startedAt\":\"2026-10-30T09:41:14Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:41:19Z\",\"conclusion\":\"success\",\"name\":\"Run npm --prefix cli run build\",\"number\":18,\"startedAt\":\"2026-10-30T09:41:15Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:42:00Z\",\"conclusion\":\"success\",\"name\":\"Run cargo test --locked --manifest-path core/Cargo.toml\",\"number\":19,\"startedAt\":\"2026-10-30T09:41:19Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:43:02Z\",\"conclusion\":\"success\",\"name\":\"Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\",\"number\":20,\"startedAt\":\"2026-10-30T09:42:00Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:57:35Z\",\"conclusion\":\"success\",\"name\":\"Run the CLI suite with a hang bound\",\"number\":21,\"startedAt\":\"2026-10-30T09:43:02Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:57:37Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/security_gates.sh\",\"number\":22,\"startedAt\":\"2026-10-30T09:57:35Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:59:32Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/package-linux.sh \\\"$GITHUB_REF_NAME\\\" \\\"$RUNNER_TEMP/dist\\\"\",\"number\":23,\"startedAt\":\"2026-10-30T09:57:37Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:05Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/package-linux.sh \\\"$GITHUB_REF_NAME\\\" \\\"$RUNNER_TEMP/repro-check\\\"\",\"number\":24,\"startedAt\":\"2026-10-30T09:59:32Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:05Z\",\"conclusion\":\"success\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\\\" \\\"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\\\"\",\"number\":25,\"startedAt\":\"2026-10-30T10:01:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:05Z\",\"conclusion\":\"success\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/SHA256SUMS\\\" \\\"$RUNNER_TEMP/repro-check/SHA256SUMS\\\"\",\"number\":26,\"startedAt\":\"2026-10-30T10:01:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:05Z\",\"conclusion\":\"success\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/THIRD_PARTY_NOTICES.txt\\\" \\\"$RUNNER_TEMP/repro-check/THIRD_PARTY_NOTICES.txt\\\"\",\"number\":27,\"startedAt\":\"2026-10-30T10:01:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:05Z\",\"conclusion\":\"success\",\"name\":\"Run cyclonedx validate --input-file \\\"$RUNNER_TEMP/dist/sbom.cdx.json\\\" --fail-on-errors\",\"number\":28,\"startedAt\":\"2026-10-30T10:01:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:05Z\",\"conclusion\":\"success\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/sbom.cdx.json\\\" \\\"$RUNNER_TEMP/repro-check/sbom.cdx.json\\\"\",\"number\":29,\"startedAt\":\"2026-10-30T10:01:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:05Z\",\"conclusion\":\"success\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/install.sh\\\" \\\"$RUNNER_TEMP/repro-check/install.sh\\\"\",\"number\":30,\"startedAt\":\"2026-10-30T10:01:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:13Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/smoke-package.sh \\\"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\\\"\",\"number\":31,\"startedAt\":\"2026-10-30T10:01:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:21Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/installer-smoke.sh \\\"$GITHUB_WORKSPACE/install.sh\\\" \\\"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\\\"\",\"number\":32,\"startedAt\":\"2026-10-30T10:01:13Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:31Z\",\"conclusion\":\"success\",\"name\":\"Attest build provenance\",\"number\":33,\"startedAt\":\"2026-10-30T10:01:21Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:34Z\",\"conclusion\":\"success\",\"name\":\"Run softprops/action-gh-release@3bb12739c298aeb8a4eeaf626c5b8d85266b0e65\",\"number\":34,\"startedAt\":\"2026-10-30T10:01:31Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:34Z\",\"conclusion\":\"success\",\"name\":\"Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":66,\"startedAt\":\"2026-10-30T10:01:34Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:34Z\",\"conclusion\":\"success\",\"name\":\"Post Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":67,\"startedAt\":\"2026-10-30T10:01:34Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:34Z\",\"conclusion\":\"success\",\"name\":\"Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":68,\"startedAt\":\"2026-10-30T10:01:34Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T10:01:34Z\",\"conclusion\":\"success\",\"name\":\"Complete job\",\"number\":69,\"startedAt\":\"2026-10-30T10:01:34Z\",\"status\":\"completed\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/41035120551/job/123993952043\"}],\"status\":\"completed\",\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/41035120551\",\"workflowName\":\"Release\"}\nThe server is looked up on the PATH the product gives a language server (`buildLspEnvironment`: absolute entries only, none inside the workspace), and where the server has a `--version` mode it is run under that same environment. A server that is absent, or present but not runnable there, SKIPS with the reason. `NEXUS_LSP_REQUIRE` turns that into a failure: `1` (or `all`) requires every server, a comma list (`typescript,python`) requires those. Ids: `typescript`, `python`, `rust`, `go`. The workflow sets `typescript,python`; rust-analyzer and gopls are best-effort installs there, so their cases run when the install worked and skip otherwise.\n\n```sh\nnpm i -g typescript typescript-language-server pyright   # or put their bin directory on PATH\ncd cli && node scripts/run_tests.mjs test/lsp_real_servers.test.ts\nNEXUS_LSP_REQUIRE=1 node scripts/run_tests.mjs test/lsp_real_servers.test.ts   # missing server = failure\n```\n\nThe suite runs under a throwaway HOME, so a tool installed only for the current user (`pip install --user`, `~/.cargo/bin` reached through the real HOME) is invisible. The workflow installs with `npm -g`, and sets `RUSTUP_HOME` and `CARGO_HOME` for the rustup proxy.\n\n## What it found\n\nThe first real run showed the default launch commands for TypeScript, JavaScript and Python were missing `--stdio`; both servers print a usage error and exit without it, so `lsp_diagnostics` for those files was always `unavailable` in practice. Fixed in `getServerForFile`; a test that needs no server pins the arguments.\n\n## What it does not cover\n\n- The trust and sandbox gates with a real server (they are tested with the fake server; a gated manager never starts one).\n- A larger real project: navigation uses three source files, but there is no large workspace-wide diagnostics fixture, incremental-edit sequence, or server crash/restart scenario.\n- Server versions other than the pinned ones (typescript 5.6.3, typescript-language-server 4.3.4, pyright 1.1.390; gopls (`@latest`: v0.16.2 stopped building on a newer runner Go on 2026-11-18) and the runner's rust-analyzer are unpinned).\n- Hosted-runner result (manual run 44323291710 on `3732d911`, 2026-11-18): **typescript-language-server, pyright and gopls passed** (a deliberate error reported, a clean file a real empty report, a broken server `unavailable`), which also confirms on real servers that the default launch needs `--stdio`. **rust-analyzer failed**: the product reported \"not installed or failed to start\" although the rustup proxy answered `--version` in the test's probe. The cause is not diagnosed (it needs a host with the rust-analyzer component to reproduce); the Rust case therefore runs as a `todo` (reported, not failing the job) unless `NEXUS_LSP_REQUIRE` names it, and the workflow requires `typescript,python,go`. A manual run of that change on its branch (run 44323915622) completed successfully: 5 pass, 0 fail, 1 todo (Rust).\n- **rust-analyzer (2026-11-18, reproduced locally in an isolated rustup home):** two separate problems, both fixed. (1) *Setup:* the workflow added the component to the toolchain pinned by the repository's `rust-toolchain.toml`, but the product launches the server in a fixture directory outside the repository, where rustup uses the **default** toolchain, which had no rust-analyzer (\"failed to start\" in about 150 ms); the test's `--version` probe ran from the repository and could not see it. The probe now runs in the fixture directory and the workflow adds the component from a directory with no override. (2) *Product behaviour:* `lsp_diagnostics` used to return on the first `publishDiagnostics`, which rust-analyzer sends **empty** before it has loaded the Cargo project and analysed types, so a file with a type error was reported clean. A server can now be marked `awaitProgress` (rust-analyzer is, in the built-in table): the client advertises `window.workDoneProgress`, answers the server's own requests (`window/workDoneProgress/create`, `workspace/configuration`, ...), tracks `$/progress`, and after the first publish waits until the server's progress has ended and been quiet for 1.5 s (or, if it reports none, a 4 s grace), always within the caller's timeout. Server-free tests (`lsp_progress.test.ts`) pin it with a fake staged server (four mutations each fail a test); the real-server case passes locally against rust-analyzer 1.100.0 (about 13 s for a first call on a tiny crate).\n- **Hosted validation of this change:** manual run 44334778543 on the branch (2026-11-18): typescript-language-server, pyright, gopls and rust-analyzer all pass (6 tests, 0 fail, 0 todo; Rust about 18 s). Earlier runs of the same workflow found the setup mismatch (44323291710), the empty-first-publish behaviour (44332636397) and a `gopls@v0.16.2` build break on the runner's newer Go (now `@latest`).\n- **Three-file navigation extension:** hosted run [44606102675](https://github.com/mikeholownych/nexus-code/actions/runs/44606102675) on commit `99c6049f` (2026-11-19) passed all 10 tests with `NEXUS_LSP_REQUIRE=typescript,python,go,rust`: all four real servers passed the diagnostics and navigation cases, with 0 failures, skips, or todos. This is a small three-source-file chain, not evidence for large-project behavior.\n- **Hover and definition (CS-6 follow-up):** each real server is asked, through the product, to hover and go to the definition through a three-source-file project (positions are 1-based, as `lsp_hover` and `lsp_definition` take them); the call is retried until the case timeout because servers answer only after analysis, and the definition must point into the defining file. This checks a small import/re-export chain; it does not establish behavior on large projects.\n- **Cost and limit:** a first Rust diagnostics call on a large crate can take as long as the project load, and is bounded by the caller's timeout, after which the existing \"published no diagnostics\" `unavailable` applies. Later calls return as soon as progress is quiet. A change to an already-open file is not waited on separately: the latest published list is returned.\nname: LSP real servers\n\n# Weekly run of the product's language-server client (cli/src/lsp.ts) against REAL servers on a tiny fixture project\n# (CS-6): a deliberate error must be reported, and a clean file must be a published empty report, not \"unavailable\".\n# The ordinary suite exercises the client only against a fake server. Not a required check. See docs/LSP_REAL_SERVERS.md\n# for what it covers and what it does not.\n#\n# typescript-language-server and pyright are installed with npm at pinned versions and are REQUIRED here\n# (NEXUS_LSP_REQUIRE): a missing one fails the job. rust-analyzer and gopls are best-effort installs; if one cannot be\n# installed its case skips with a reason in the log.\non:\n  schedule:\n    - cron: \"17 4 * * 1\"\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\njobs:\n  lsp:\n    runs-on: ubuntu-22.04\n    timeout-minutes: 30\n    env:\n      NEXUS_LSP_REQUIRE: typescript,python,go,rust\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\n        with:\n          node-version: 22.22.1\n      # Installed system-wide (npm -g puts them on an absolute PATH entry): the tests run under a throwaway HOME, where\n      # per-user installs (pip --user) are invisible (the MQ-3 first-run failure).\n      - name: Install typescript-language-server and pyright\n        run: npm install --global --no-audit --no-fund typescript@5.6.3 typescript-language-server@4.3.4 pyright@1.1.390\n      - name: Install rust-analyzer (best effort)\n        continue-on-error: true\n        run: |\n          # The product launches the server in a fixture directory outside this repository, where rustup uses the DEFAULT toolchain,\n          # not the one the repository's rust-toolchain.toml pins: add the component there (from a directory with no override).\n          (cd \"$RUNNER_TEMP\" && rustup component add rust-analyzer)\n          # The rustup proxy finds its toolchain through RUSTUP_HOME / CARGO_HOME; the tests' throwaway HOME hides the defaults.\n          echo \"RUSTUP_HOME=$(rustup show home)\" >> \"$GITHUB_ENV\"\n          echo \"CARGO_HOME=${CARGO_HOME:-$HOME/.cargo}\" >> \"$GITHUB_ENV\"\n      - name: Install gopls (best effort)\n        continue-on-error: true\n        run: |\n          # Not pinned: an old gopls stops building when the runner image moves to a newer Go (gopls v0.16.2 failed to build on 2026-11-18); this job exists to meet the current servers.\n          # @latest may need a newer Go than the runner has and download that toolchain; the proxy can fail transiently (a stream error on 2026-11-18), so retry.\n          for attempt in 1 2 3; do\n            GOBIN=\"$RUNNER_TEMP/gobin\" go install golang.org/x/tools/gopls@latest && break\n            [ \"$attempt\" = 3 ] && exit 1\n            sleep 15\n          done\n          echo \"$RUNNER_TEMP/gobin\" >> \"$GITHUB_PATH\"\n      - run: npm ci --prefix cli\n      - name: Versions on the runner\n        run: |\n          typescript-language-server --version\n          pyright --version\n          rust-analyzer --version || true\n          gopls version || true\n      - name: Run the real-server tests\n        working-directory: cli\n        run: node scripts/run_tests.mjs test/lsp_real_servers.test.ts\n","exit_code":0,"duration":{"secs":0,"nanos":482338257}},"started_at_ms":1795146716042,"completed_at_ms":1795146716526}}
{"timestamp":"2026-11-20T03:51:57.106Z","ordinal":28806,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1f715-17b2-7773-8a73-e7fd164500d4","call_id":"call_687a20e2b0d94244a7c0d3f2107d116e","output":[{"type":"input_text","text":"Script completed\nWall time 1.3 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 8867)\nTotal output lines: 95\n\n.github/workflows/release.yml:27:      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n.github/workflows/ci.yml:22:      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n.github/workflows/ci.yml:119:      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\ndocs/reviews/evidence/v1-qualification/rc.14/source-ci.json:1:{\"conclusion\":\"success\",\"headSha\":\"16eeb6eeffe7fc0bae234aa34dcb671a6ba5ff99\",\"jobs\":[{\"completedAt\":\"2026-10-30T09:14:24Z\",\"conclusion\":\"success\",\"databaseId\":123975740176,\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-30T08:54:09Z\",\"status\":\"completed\",\"steps\":[{\"completedAt\":\"2026-10-30T08:54:11Z\",\"conclusion\":\"success\",\"name\":\"Set up job\",\"number\":1,\"startedAt\":\"2026-10-30T08:54:10Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:13Z\",\"conclusion\":\"success\",\"name\":\"Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":2,\"startedAt\":\"2026-10-30T08:54:11Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:28Z\",\"conclusion\":\"success\",\"name\":\"Run sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\",\"number\":3,\"startedAt\":\"2026-10-30T08:54:13Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:36Z\",\"conclusion\":\"success\",\"name\":\"Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":4,\"startedAt\":\"2026-10-30T08:54:28Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:47Z\",\"conclusion\":\"success\",\"name\":\"Install pinned evaluator toolchains\",\"number\":5,\"startedAt\":\"2026-10-30T08:54:36Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:49Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-bubblewrap.sh\",\"number\":6,\"startedAt\":\"2026-10-30T08:54:47Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:49Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-user-cgroups.sh\",\"number\":7,\"startedAt\":\"2026-10-30T08:54:49Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:49Z\",\"conclusion\":\"success\",\"name\":\"Mount a dedicated capped tmpfs for evaluator resource fixtures\",\"number\":8,\"startedAt\":\"2026-10-30T08:54:49Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:55Z\",\"conclusion\":\"success\",\"name\":\"Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":9,\"startedAt\":\"2026-10-30T08:54:49Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:57Z\",\"conclusion\":\"success\",\"name\":\"Install selected Node runtime for isolated evaluation commands\",\"number\":10,\"startedAt\":\"2026-10-30T08:54:55Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:57Z\",\"conclusion\":\"success\",\"name\":\"Run node scripts/sync-version.mjs --check\",\"number\":11,\"startedAt\":\"2026-10-30T08:54:57Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:57Z\",\"conclusion\":\"success\",\"name\":\"Run node scripts/check_requirements.mjs\",\"number\":12,\"startedAt\":\"2026-10-30T08:54:57Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:58Z\",\"conclusion\":\"success\",\"name\":\"Run npm ci --prefix cli\",\"number\":13,\"startedAt\":\"2026-10-30T08:54:57Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:55:04Z\",\"conclusion\":\"success\",\"name\":\"Run npm --prefix cli run build\",\"number\":14,\"startedAt\":\"2026-10-30T08:54:58Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:55:04Z\",\"conclusion\":\"success\",\"name\":\"Run git diff --exit-code -- cli/dist\",\"number\":15,\"startedAt\":\"2026-10-30T08:55:04Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:56:05Z\",\"conclusion\":\"success\",\"name\":\"Run cargo test --locked --manifest-path core/Cargo.toml\",\"number\":16,\"startedAt\":\"2026-10-30T08:55:04Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:57:28Z\",\"conclusion\":\"success\",\"name\":\"Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\",\"number\":17,\"startedAt\":\"2026-10-30T08:56:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:57:30Z\",\"conclusion\":\"success\",\"name\":\"Install pinned security and SBOM test tools\",\"number\":18,\"startedAt\":\"2026-10-30T08:57:28Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:14:18Z\",\"conclusion\":\"success\",\"name\":\"Run the CLI suite with a hang bound\",\"number\":19,\"startedAt\":\"2026-10-30T08:57:30Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:14:19Z\",\"conclusion\":\"success\",\"name\":\"Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":36,\"startedAt\":\"2026-10-30T09:14:18Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:14:19Z\",\"conclusion\":\"success\",\"name\":\"Post Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":37,\"startedAt\":\"2026-10-30T09:14:19Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:14:19Z\",\"conclusion\":\"success\",\"name\":\"Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":38,\"startedAt\":\"2026-10-30T09:14:19Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T09:14:19Z\",\"conclusion\":\"success\",\"name\":\"Complete job\",\"number\":39,\"startedAt\":\"2026-10-30T09:14:19Z\",\"status\":\"completed\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/41029564419/job/123975740176\"},{\"completedAt\":\"2026-10-30T09:14:41Z\",\"conclusion\":\"success\",\"databaseId\":123975740536,\"name\":\"test-matrix (22)\",\"startedAt\":\"2026-10-30T08:54:09Z\",\"status\":\"completed\",\"steps\":[{\"completedAt\":\"2026-10-30T08:54:11Z\",\"conclusion\":\"success\",\"name\":\"Set up job\",\"number\":1,\"startedAt\":\"2026-10-30T08:54:10Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:12Z\",\"conclusion\":\"success\",\"name\":\"Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":2,\"startedAt\":\"2026-10-30T08:54:11Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:28Z\",\"conclusion\":\"success\",\"name\":\"Run sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\",\"number\":3,\"startedAt\":\"2026-10-30T08:54:12Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:35Z\",\"conclusion\":\"success\",\"name\":\"Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":4,\"startedAt\":\"2026-10-30T08:54:28Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:46Z\",\"conclusion\":\"success\",\"name\":\"Install pinned evaluator toolchains\",\"number\":5,\"startedAt\":\"2026-10-30T08:54:35Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:48Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-bubblewrap.sh\",\"number\":6,\"startedAt\":\"2026-10-30T08:54:46Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:49Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-user-cgroups.sh\",\"number\":7,\"startedAt\":\"2026-10-30T08:54:48Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:49Z\",\"conclusion\":\"success\",\"name\":\"Mount a dedicated capped tmpfs for evaluator resource fixtures\",\"number\":8,\"startedAt\":\"2026-10-30T08:54:49Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:53Z\",\"conclusion\":\"success\",\"name\":\"Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d…5367 tokens truncated…: the product reported \"not installed or failed to start\" although the rustup proxy answered `--version` in the test's probe. The cause is not diagnosed (it needs a host with the rust-analyzer component to reproduce); the Rust case therefore runs as a `todo` (reported, not failing the job) unless `NEXUS_LSP_REQUIRE` names it, and the workflow requires `typescript,python,go`. A manual run of that change on its branch (run 44323915622) completed successfully: 5 pass, 0 fail, 1 todo (Rust).\n- **rust-analyzer (2026-11-18, reproduced locally in an isolated rustup home):** two separate problems, both fixed. (1) *Setup:* the workflow added the component to the toolchain pinned by the repository's `rust-toolchain.toml`, but the product launches the server in a fixture directory outside the repository, where rustup uses the **default** toolchain, which had no rust-analyzer (\"failed to start\" in about 150 ms); the test's `--version` probe ran from the repository and could not see it. The probe now runs in the fixture directory and the workflow adds the component from a directory with no override. (2) *Product behaviour:* `lsp_diagnostics` used to return on the first `publishDiagnostics`, which rust-analyzer sends **empty** before it has loaded the Cargo project and analysed types, so a file with a type error was reported clean. A server can now be marked `awaitProgress` (rust-analyzer is, in the built-in table): the client advertises `window.workDoneProgress`, answers the server's own requests (`window/workDoneProgress/create`, `workspace/configuration`, ...), tracks `$/progress`, and after the first publish waits until the server's progress has ended and been quiet for 1.5 s (or, if it reports none, a 4 s grace), always within the caller's timeout. Server-free tests (`lsp_progress.test.ts`) pin it with a fake staged server (four mutations each fail a test); the real-server case passes locally against rust-analyzer 1.100.0 (about 13 s for a first call on a tiny crate).\n- **Hosted validation of this change:** manual run 44334778543 on the branch (2026-11-18): typescript-language-server, pyright, gopls and rust-analyzer all pass (6 tests, 0 fail, 0 todo; Rust about 18 s). Earlier runs of the same workflow found the setup mismatch (44323291710), the empty-first-publish behaviour (44332636397) and a `gopls@v0.16.2` build break on the runner's newer Go (now `@latest`).\n- **Three-file navigation extension:** hosted run [44606102675](https://github.com/mikeholownych/nexus-code/actions/runs/44606102675) on commit `99c6049f` (2026-11-19) passed all 10 tests with `NEXUS_LSP_REQUIRE=typescript,python,go,rust`: all four real servers passed the diagnostics and navigation cases, with 0 failures, skips, or todos. This is a small three-source-file chain, not evidence for large-project behavior.\n- **Hover and definition (CS-6 follow-up):** each real server is asked, through the product, to hover and go to the definition through a three-source-file project (positions are 1-based, as `lsp_hover` and `lsp_definition` take them); the call is retried until the case timeout because servers answer only after analysis, and the definition must point into the defining file. This checks a small import/re-export chain; it does not establish behavior on large projects.\n- **Cost and limit:** a first Rust diagnostics call on a large crate can take as long as the project load, and is bounded by the caller's timeout, after which the existing \"published no diagnostics\" `unavailable` applies. Later calls return as soon as progress is quiet. A change to an already-open file is not waited on separately: the latest published list is returned.\nname: LSP real servers\n\n# Weekly run of the product's language-server client (cli/src/lsp.ts) against REAL servers on a tiny fixture project\n# (CS-6): a deliberate error must be reported, and a clean file must be a published empty report, not \"unavailable\".\n# The ordinary suite exercises the client only against a fake server. Not a required check. See docs/LSP_REAL_SERVERS.md\n# for what it covers and what it does not.\n#\n# typescript-language-server and pyright are installed with npm at pinned versions and are REQUIRED here\n# (NEXUS_LSP_REQUIRE): a missing one fails the job. rust-analyzer and gopls are best-effort installs; if one cannot be\n# installed its case skips with a reason in the log.\non:\n  schedule:\n    - cron: \"17 4 * * 1\"\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\njobs:\n  lsp:\n    runs-on: ubuntu-22.04\n    timeout-minutes: 30\n    env:\n      NEXUS_LSP_REQUIRE: typescript,python,go,rust\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\n        with:\n          node-version: 22.22.1\n      # Installed system-wide (npm -g puts them on an absolute PATH entry): the tests run under a throwaway HOME, where\n      # per-user installs (pip --user) are invisible (the MQ-3 first-run failure).\n      - name: Install typescript-language-server and pyright\n        run: npm install --global --no-audit --no-fund typescript@5.6.3 typescript-language-server@4.3.4 pyright@1.1.390\n      - name: Install rust-analyzer (best effort)\n        continue-on-error: true\n        run: |\n          # The product launches the server in a fixture directory outside this repository, where rustup uses the DEFAULT toolchain,\n          # not the one the repository's rust-toolchain.toml pins: add the component there (from a directory with no override).\n          (cd \"$RUNNER_TEMP\" && rustup component add rust-analyzer)\n          # The rustup proxy finds its toolchain through RUSTUP_HOME / CARGO_HOME; the tests' throwaway HOME hides the defaults.\n          echo \"RUSTUP_HOME=$(rustup show home)\" >> \"$GITHUB_ENV\"\n          echo \"CARGO_HOME=${CARGO_HOME:-$HOME/.cargo}\" >> \"$GITHUB_ENV\"\n      - name: Install gopls (best effort)\n        continue-on-error: true\n        run: |\n          # Not pinned: an old gopls stops building when the runner image moves to a newer Go (gopls v0.16.2 failed to build on 2026-11-18); this job exists to meet the current servers.\n          # @latest may need a newer Go than the runner has and download that toolchain; the proxy can fail transiently (a stream error on 2026-11-18), so retry.\n          for attempt in 1 2 3; do\n            GOBIN=\"$RUNNER_TEMP/gobin\" go install golang.org/x/tools/gopls@latest && break\n            [ \"$attempt\" = 3 ] && exit 1\n            sleep 15\n          done\n          echo \"$RUNNER_TEMP/gobin\" >> \"$GITHUB_PATH\"\n      - run: npm ci --prefix cli\n      - name: Versions on the runner\n        run: |\n          typescript-language-server --version\n          pyright --version\n          rust-analyzer --version || true\n          gopls version || true\n      - name: Run the real-server tests\n        working-directory: cli\n        run: node scripts/run_tests.mjs test/lsp_real_servers.test.ts\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1f712-aaf3-7db1-9f93-ddce93b124cb","create_time":1795146717.1067796}},"metadata":{"history_sequence":12709,"sampled_through_sequence":12706,"client_authored":false,"fallback_token_limit_override":12000}}
