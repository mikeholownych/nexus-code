able gap marker should survive classifier failure\");\n+    const flightRows = fs.readFileSync(flight.getLogPath(), \"utf8\").trim().split(\"\\n\").map((line) => JSON.parse(line));\n+    assert.ok(flightRows.length > 0);\n+    assert.ok(flightRows.every((row) => row.type === \"recording_gap\"), \"classifier failures must not persist caller payloads\");\n+    for (const row of flightRows) assert.deepEqual(Object.keys(row.payload).sort(), [\"reason\", \"recordingSkipped\"]);\n+    assert.doesNotMatch(JSON.stringify(flightRows), new RegExp(secret));\n+    assert.equal(FlightPlayer.loadFlight(workspace, flight.getFlightId()).integrity.recordingSkipped, true);\nflight_sanitization ℹ pass 3 ℹ fail 0 \nhash_chain ℹ pass 28 ℹ fail 0 \n153:| 1 | `error` | The command itself failed (the bundle directory cannot be read, an export could not be written), so nothing was established. |","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"3d7a79ba-966c-435c-a0bf-a04ea8c16ec9","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"d25d0d24-8aed-4b03-a951-966dc54f0666","userType":"external","entrypoint":"cli","cwd":"/home/mike/nexus-code","sessionId":"43bcbb67-2cff-4fa8-a05e-f8aa598df73b","version":"2.1.329","gitBranch":"main","slug":"synthetic-moseying-seahorse","dataFlowOn":true}
