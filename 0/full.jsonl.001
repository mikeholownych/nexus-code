{"timestamp":"2026-10-28T17:21:08.125Z","ordinal":466502,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18366-2421-7770-adb2-8a0eb3a8a68d","item":{"type":"CommandExecution","id":"exec-127f37ac-6ac7-4494-9dbb-a0c7cac143eb","process_id":"74819","command":["/usr/bin/zsh","-lc","for p in FILE_cli_src_core_operation_runner_execution.ts FILE_cli_src_core_operation.ts V1_CONTEXT_MANAGEMENT; do echo \"--- $p ---\"; cat \"/home/mike/nexus-code/.git/nexus-claims/$p/owner.json\" 2>/dev/null || true; done; printf '\\n--- operation runner current branch refs ---\\n'; git -C /home/mike/nexus-wt/operation-restart-conversation diff --unified=30 origin/main...HEAD -- cli/src/core/operation_runner_execution.ts cli/test/operation_runner_restart.test.ts"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"for p in FILE_cli_src_core_operation_runner_execution.ts FILE_cli_src_core_operation.ts V1_CONTEXT_MANAGEMENT; do echo \"--- $p ---\"; cat \"/home/mike/nexus-code/.git/nexus-claims/$p/owner.json\" 2>/dev/null || true; done; printf '\\n--- operation runner current branch refs ---\\n'; git -C /home/mike/nexus-wt/operation-restart-conversation diff --unified=30 origin/main...HEAD -- cli/src/core/operation_runner_execution.ts cli/test/operation_runner_restart.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"--- FILE_cli_src_core_operation_runner_execution.ts ---\n--- FILE_cli_src_core_operation.ts ---\n--- V1_CONTEXT_MANAGEMENT ---\n\n--- operation runner current branch refs ---\ndiff --git a/cli/src/core/operation_runner_execution.ts b/cli/src/core/operation_runner_execution.ts\nindex 40c3be4f..ddb79a10 100644\n--- a/cli/src/core/operation_runner_execution.ts\n+++ b/cli/src/core/operation_runner_execution.ts\n@@ -244,61 +244,69 @@ export class AgentWorkUnitExecutor implements WorkUnitExecutor {\n     }\n     let lastCondition: ResourceConditionRecord | null = null;\n     try {\n       let prompt: string;\n       let unusable: string | undefined;\n       if (unit.agentTaskId) {\n         let recovered: TaskRecoveryResult | undefined;\n         try {\n           recovered = await agent.recoverFromTaskState(unit.agentTaskId);\n         } catch (err: any) {\n           unusable = `its durable state could not be loaded (${String(err?.message ?? err).slice(0, 160)})`;\n         }\n         if (recovered?.interrupted) {\n           const op = recovered.interruptedOperation;\n           const what = op?.completedAt ? \"finished, but its result was not saved before the process stopped\" : \"was in flight when the process stopped\";\n           return {\n             kind: \"failed\",\n             cause: \"INTERRUPTED\",\n             reason: `tool ${op?.toolName ?? \"?\"} ${what}`,\n             question: `${unit.title}: tool '${op?.toolName ?? \"?\"}' may have partially run before Nexus stopped. Inspect and continue, or stop?`,\n             options: [{ label: \"continue after inspection\", action: { kind: \"retry\" } }],\n           };\n         }\n         // Only a record that tracks obligations can show that nothing happened; without one, earlier work is unknown.\n         const notStarted =\n           !unusable && recovered?.obligationRecordPresent === true && conversationNotStarted(agent.getMessages());\n         if (!notStarted) unusable ??= resumeHistoryProblem(agent.getMessages(), unit);\n         const decision = ctx.operatorDecision\n           ? `The operator decided: ${ctx.operatorDecision.label}${ctx.operatorDecision.note ? ` — ${ctx.operatorDecision.note}` : \"\"}.\\n`\n           : \"\";\n-        if (unusable) {\n+        if (ctx.operatorDecision?.restart && !unusable) {\n+          // A restart may have recreated this unit's isolated worktree from the integration tip. Its former\n+          // conversation describes discarded files, so never resume that history on the fresh worktree.\n+          agent.restartConversation(!recovered?.obligationRecordPresent);\n+          prompt =\n+            `${this.initialPrompt(unit, ctx)}\\n\\n${decision}` +\n+            \"Note: this unit was explicitly restarted after recovery. Its earlier conversation is not being continued. \" +\n+            \"Earlier workspace history may be incomplete; inspect any changes that remain, because they remain unverified.\";\n+        } else if (unusable) {\n           // A partial record is never continued or taken as evidence; only the operator can start the unit over.\n           if (!ctx.operatorDecision?.restart) {\n             return {\n               kind: \"failed\",\n               cause: \"INTERRUPTED\",\n               reason: `durable history unusable: ${unusable}`,\n               question: `${unit.title} cannot be resumed: ${unusable}. Restart it from its authorized task (its earlier progress is lost, and changes it may have made stay unverified), or stop?`,\n               options: [{ label: \"restart the unit from its authorized task\", action: { kind: \"retry\", restart: true } }],\n             };\n           }\n           // Without a recorded obligation (state unloadable, or written before obligations were recorded) earlier\n           // changes are unknown, so they count as unverified.\n           agent.restartConversation(!recovered || !recovered.obligationRecordPresent);\n           prompt =\n             `${this.initialPrompt(unit, ctx)}\\n\\n${decision}` +\n             `Note: earlier task history was unusable (${unusable}). Prior workspace changes may be unknown and remain unverified; inspect the workspace before relying on them.`;\n         } else if (notStarted) {\n           const restartNotice = ctx.operatorDecision?.restart\n             ? \"\\n\\nNote: this unit was explicitly restarted after recovery. Earlier workspace history may be incomplete, and any prior changes remain unverified; inspect the workspace before relying on them.\"\n             : \"\";\n           prompt = `${this.initialPrompt(unit, ctx)}${decision ? `\\n\\n${decision}` : \"\"}${restartNotice}`;\n         } else {\n           const op = recovered?.state.currentOperation;\n           const stopped = op?.status === \"interrupted\"\n             ? `Nexus stopped while ${op.toolName} ${op.argsSummary ?? \"\"} was running or before its result was saved; it may have partially run. Check its effects before relying on them.\\n`\n             : \"\";\n           prompt =\n             `[Work unit resumed on ${resource.id} (${resource.model}) after: ${ctx.resumeReason ?? \"a resource change\"}]\\n${decision}` +\n             `The unit's authorized task, which remains its only objective:\\n${unit.prompt}\\n${stopped}` +\n             `Your earlier progress on this unit is above; tools that already ran are not repeated. Continue the unit and call task_completed with a concise summary when done.`;\ndiff --git a/cli/test/operation_runner_restart.test.ts b/cli/test/operation_runner_restart.test.ts\nnew file mode 100644\nindex 00000000..935c5b23\n--- /dev/null\n+++ b/cli/test/operation_runner_restart.test.ts\n@@ -0,0 +1,123 @@\n+import assert from \"node:assert/strict\";\n+import { test } from \"node:test\";\n+import type { AutonomousAgent } from \"../src/agent.js\";\n+import { AgentWorkUnitExecutor } from \"../src/core/operation_runner_execution.js\";\n+import type { UnitRunContext } from \"../src/core/operation_runner.js\";\n+import type { ResourceDescriptor } from \"../src/core/resources.js\";\n+import type { WorkUnit } from \"../src/core/operation.js\";\n+import type { ChatMessage, HarnessConfig } from \"../src/types.js\";\n+import type { TaskRecoveryResult } from \"../src/core/state.js\";\n+import type { TurnResult } from \"../src/core/turn.js\";\n+\n+test(\"explicit operation-unit restart starts a fresh conversation instead of resuming discarded worktree history\", async () => {\n+  const messages: ChatMessage[] = [\n+    { role: \"system\", content: \"Nexus system prompt\" },\n+    {\n+      role: \"user\",\n+      content: \"[Work unit 'u1': Implement feature] Part of the operation: Ship the feature\\nTask:\\nImplement feature\",\n+    },\n+    { role: \"assistant\", content: \"I edited files in the previous unit worktree.\" },\n+  ];\n+  const turnCalls: Array<{ prompt: string; resume?: boolean }> = [];\n+  const restartCalls: boolean[] = [];\n+  const recovery = {\n+    success: true,\n+    state: { currentOperation: null },\n+    obligationRecordPresent: true,\n+    interrupted: false,\n+    worktreeStatus: \"consistent\",\n+    candidateStatus: \"no_candidate\",\n+    invalidatedReceiptCount: 0,\n+    reconstructedStateSummary: {\n+      milestonesRecovered: 0,\n+      planPhasesRecovered: 0,\n+      messagesRecovered: 3,\n+      ephemeralPidsCleared: false,\n+      authorityResurrected: false,\n+    },\n+    diagnostics: [],\n+  } as unknown as TaskRecoveryResult;\n+  const turn = {\n+    execution: \"COMPLETED\",\n+    outcome: \"NOT_REQUIRED\",\n+    acceptance: \"NOT_REQUESTED\",\n+    modelStop: \"NONE\",\n+    finalOutputComplete: true,\n+    verification: null,\n+    interruption: null,\n+    inferenceFailure: null,\n+    steps: { used: 1, max: 5, limitReached: false },\n+    unverifiedChangesPending: false,\n+    finishedAt: new Date().toISOString(),\n+  } as TurnResult;\n+  const fakeAgent = {\n+    durable: false,\n+    getTaskId: () => \"task-u1\",\n+    getMessages: () => messages,\n+    recoverFromTaskState: async () => recovery,\n+    restartConversation: (priorChangesUnknown: boolean) => {\n+      restartCalls.push(priorChangesUnknown);\n+      messages.splice(0, messages.length, { role: \"system\", content: \"Nexus system prompt\" });\n+    },\n+    setProviderRecoveryHooks: () => undefined,\n+    checkpointDurableState: () => undefined,\n+    getObjective: () => ({ verification: [] }),\n+    getCompletionSummary: () => ({ summary: \"completed from fresh task\" }),\n+    runTurn: async (prompt: string, _objective: unknown, options: { resume?: boolean }) => {\n+      turnCalls.push({ prompt, resume: options.resume });\n+      return turn;\n+    },\n+    shutdown: () => undefined,\n+  } as unknown as AutonomousAgent;\n+  const executor = new AgentWorkUnitExecutor({\n+    baseConfig: {\n+      endpoint: \"https://provider.invalid/v1\",\n+      model: \"test-model\",\n+      workspace: \"/tmp/nexus-operation-restart-workspace\",\n+      shell: \"bash\",\n+      maxSteps: 5,\n+      temperature: 0,\n+    } as HarnessConfig,\n+    createAgent: () => fakeAgent,\n+  });\n+  const unit: WorkUnit = {\n+    id: \"u1\",\n+    title: \"Implement feature\",\n+    prompt: \"Implement feature\",\n+    dependsOn: [],\n+    requires: { capabilities: [\"tools\"] },\n+    status: \"RUNNABLE\",\n+    agentTaskId: \"task-u1\",\n+    reroutes: [],\n+    runs: 1,\n+    unknownResumes: 0,\n+    modelsUsed: [],\n+  };\n+  const resource: ResourceDescriptor = {\n+    id: \"primary\",\n+    endpoint: \"https://provider.invalid/v1\",\n+    provider: \"https://provider.invalid\",\n+    model: \"test-model\",\n+    capabilities: [\"tools\"],\n+    rank: 0,\n+  };\n+  const ctx: UnitRunContext = {\n+    objective: \"Ship the feature\",\n+    dependencies: [],\n+    operatorDecision: { label: \"restart the unit from the integration tip\", restart: true },\n+    bindAgentTask: () => undefined,\n+    observeFailure: () => null,\n+    observeSuccess: () => undefined,\n+    shouldYield: () => false,\n+  };\n+\n+  const outcome = await executor.run(unit, resource, ctx);\n+\n+  assert.equal(outcome.kind, \"completed\");\n+  assert.deepEqual(restartCalls, [false], \"the existing obligation record should be preserved\");\n+  assert.equal(turnCalls.length, 1);\n+  assert.equal(turnCalls[0].resume, false);\n+  assert.match(turnCalls[0].prompt, /operator decided: restart the unit from the integration tip/i);\n+  assert.match(turnCalls[0].prompt, /earlier conversation is not being continued/i);\n+  assert.doesNotMatch(turnCalls[0].prompt, /I edited files in the previous unit worktree/);\n+});\n","exit_code":0,"duration":{"secs":0,"nanos":40354}},"started_at_ms":1793208068125,"completed_at_ms":1793208068125}}
