"test@example.invalid\");\n  git(\"config\", \"user.name\", \"Test\");\n  fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"base\\n\");\n  git(\"add\", \"tracked.txt\");\n  git(\"commit\", \"-qm\", \"base\");\n  return { repo, git };\n}\n\nfunction cleanupGitRepo(repo: string): void {\n  const checkpointKey = createHash(\"sha256\").update(path.resolve(repo)).digest(\"hex\").slice(0, 12);\n  fs.rmSync(path.join(os.homedir(), \".nexus\", \"checkpoints\", checkpointKey), { recursive: true, force: true });\n  fs.rmSync(repo, { recursive: true, force: true });\n}\n\ntest(\"Git restore preserves untracked work and HEAD while removing post-checkpoint files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"pre-existing user work\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"preserve work\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"after checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"created-later.txt\"), \"remove me\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"at checkpoint\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"pre-existing user work\\n\");\n    assert.equal(fs.existsSync(path.join(repo, \"created-later.txt\")), false);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git checkpoint refuses sensitive untracked content before writing a ref\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), `ghp_${\"H\".repeat(36)}\\n`);\n    const manager = new CheckpointManager(repo);\n\n    assert.throws(() => manager.createCheckpoint(\"protected\"), SensitivePersistenceError);\n    assert.equal(manager.listCheckpoints().length, 0);\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"restore refuses to clean when the untracked snapshot is missing\", () => {\n  const { repo } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"captured work\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"missing snapshot\");\n    fs.rmSync(checkpoint.snapshotDir!, { recursive: true });\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"work that must not be deleted\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked snapshot/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"work that must not be deleted\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy Git restore does not delete uncaptured untracked files or move HEAD\", () => {\n    assert.equal(fs.readFileSync(path.join(repo, \"later.txt\"), \"utf8\"), \"post-checkpoint untracked canary\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore refuses to copy an untracked file into a nested bare repository\", () => {\n  const { repo, git } = gitRepo();\n  const bareRepo = path.join(repo, \"nested-bare\");\n  try {\n    fs.mkdirSync(bareRepo);\n    fs.writeFileSync(path.join(bareRepo, \"captured.txt\"), \"checkpoint content\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"nested bare repository descendant\");\n\n    fs.rmSync(path.join(bareRepo, \"captured.txt\"));\n    execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", bareRepo]);\n    fs.writeFileSync(path.join(bareRepo, \"config\"), \"[core]\\n\\tfilemode = true\\n[include]\\n\\tpath = bare-core.ini\\n\");\n    fs.writeFileSync(path.join(bareRepo, \"bare-core.ini\"), \"[core]\\n\\tbare = true\\n\");\n    assert.equal(execFileSync(\"git\", [\"-C\", bareRepo, \"config\", \"--bool\", \"core.bare\"], { encoding: \"utf8\" }).trim(), \"true\");\n    const bareHeadBefore = fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\");\n    const bareConfigBefore = fs.readFileSync(path.join(bareRepo, \"config\"), \"utf8\");\n    fs.writeFileSync(path.join(bareRepo, \"repository-canary.txt\"), \"bare repository canary\\n\");\n    fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n    git(\"add\", \"staged-after-checkpoint.txt\");\n    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n    const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe|snapshot/i);\n    assert.equal(fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\"), bareHeadBefore);\n    assert.equal(fs.readFileSync(path.join(bareRepo, \"config\"), \"utf8\"), bareConfigBefore);\n    assert.equal(fs.existsSync(path.join(bareRepo, \"captured.txt\")), false, \"rejection must not copy the captured file into the bare repository\");\n    assert.equal(fs.readFileSync(path.join(bareRepo, \"repository-canary.txt\"), \"utf8\"), \"bare repository canary\\n\");\n    assert.equal(execFileSync(\"git\", [\"-C\", bareRepo, \"rev-parse\", \"--is-bare-repository\"], { encoding: \"utf8\" }).trim(), \"true\");\n    assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n    const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve outer index entries\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    }).toString(\"utf8\").split(\"\\0\").filter(Boolean);\n    const mutationPaths = new Set([...checkoutPaths, ...deletedPaths]);\n    if (this.gitUntrackedPaths(true).some((relativePath) => {\n      for (let candidate = relativePath; candidate && candidate !== \".\"; candidate = path.posix.dirname(candidate)) {\n        if (mutationPaths.has(candidate)) return true;\n      }\n      return false;\n    })) {\n      throw new Error(\"Checkpoint legacy restore would overwrite or delete an uncaptured untracked file\");\n    }\n  }\n\n  private removeTrackedDeletions(gitRef: string, addedPaths: string[] = []): void {\n    const deletedPaths = this.gitRefDeletedPaths(gitRef);\n    const workspaceRoot = fs.realpathSync(this.workspace);\n    for (const relativePath of new Set([...deletedPaths, ...addedPaths])) {\n      const targetPath = path.join(workspaceRoot, relativePath);\n      let parent: string;\n      try {\n        parent = fs.realpathSync(path.dirname(targetPath));\n      } catch {\n        continue;\n      }\n      if (parent !== workspaceRoot && !parent.startsWith(workspaceRoot + path.sep)) continue;\n      try {\n        if (fs.lstatSync(targetPath, { throwIfNoEntry: false })?.isDirectory()) continue;\n        fs.rmSync(targetPath, { force: true });\n      } catch (error) {\n        const code = (error as NodeJS.ErrnoException).code;\n        if (code !== \"ENOENT\" && code !== \"ENOTDIR\") throw error;\n      }\n    }\n  }\n\n  private gitRefDeletedPaths(gitRef: string): string[] {\n    return execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--name-only\", \"--diff-filter=D\", \"-z\", \"HEAD\", gitRef], {\n      cwd: this.workspace,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    }).toString(\"utf8\").split(\"\\0\").filter(Boolean);\n  }\n\n  private trackedPathsAddedSince(gitRef: string): string[] {\n    const committed = execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--name-only\", \"--diff-filter=A\", \"-z\", gitRef, \"HEAD\"], {\n      cwd: this.workspace,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    }).toString(\"utf8\").split(\"\\0\").filter(Boolean);\n    const staged = execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff-index\", \"--cached\", \"--name-only\", \"--diff-filter=A\", \"-z\", gitRef], {\n      if (this.isGit && cp.gitRef) {\n        const hookGuardEnv = envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\", \"post-index-change\"]);\n        const postCheckpointAdditions = cp.untrackedFiles === undefined ? this.trackedPathsAddedSince(cp.gitRef) : [];\n        const deletedPaths = this.gitRefDeletedPaths(cp.gitRef);\n        const checkoutPaths = this.gitRefBlobPaths(cp.gitRef);\n        const mutationPaths = [...new Set([\n          ...checkoutPaths,\n          ...deletedPaths,\n          ...postCheckpointAdditions,\n          ...(cp.untrackedFiles ?? []),\n        ])];\n        if (cp.untrackedFiles !== undefined && cp.untrackedFiles.length > 0) {\n          if (!cp.snapshotDir) return { success: false, message: `Rollback failed: checkpoint '${cp.id}' is missing its untracked snapshot; workspace was not changed` };\n          try {\n            this.assertUntrackedSnapshotSafe(cp.untrackedFiles, cp.snapshotDir, cp.allowSensitive === true);\n            this.assertUntrackedDestinationSafe(cp.untrackedFiles, this.workspace);\n          } catch {\n            return { success: false, message: `Rollback failed: checkpoint '${cp.id}' has an unsafe untracked snapshot or destination; workspace was not changed` };\n          }\n        }\n        // Validate every path that restore may write or remove before read-tree\n        // mutates the outer index. Tracked deletions are destructive too: they\n        // must not cross into nested repositories in the current worktree.\n        this.assertNoNestedGitRepositoryAncestors(mutationPaths, this.workspace);\n        if (cp.untrackedFiles !== undefined) {\n          const replacementTargets = [...new Set([...cp.untrackedFiles, ...checkoutPaths])];\n          this.assertGitSnapshotTargetsReplaceable(replacementTargets, cp.gitRef);\n        }\n        if (cp.untrackedFiles === undefined) this.assertLegacyUntrackedRestoreSafe(cp.gitRef);\n        execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"read-tree\", cp.gitRef], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n        execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"checkout-index\", \"-f\", \"-a\"], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n        this.removeTrackedDeletions(cp.gitRef, postCheckpointAdditions);\n        if (cp.untrackedFiles !== undefined) {\n          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"clean\", \"-fd\"], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n          if (cp.untrackedFiles.length > 0) {\n            this.copyUntrackedEntries(cp.untrackedFiles, cp.snapshotDir!, this.workspace, cp.allowSensitive === true);\n          }\n          return { success: true, message: `Restored workspace to checkpoint '${cp.name}' (${cp.id})` };\n        }\n        return { success: true, message: `Restored tracked workspace to checkpoint '${cp.name}' (${cp.id}); legacy untracked files were not captured and were left unchanged` };\n      }\n","exit_code":0,"duration":{"secs":0,"nanos":826095443}},"started_at_ms":1793202284503,"completed_at_ms":1793202285329}}
