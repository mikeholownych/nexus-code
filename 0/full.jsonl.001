ncli/src/core/turn.ts:49:  | \"STEP_BUDGET_EXHAUSTED\"\ncli/src/core/turn.ts:587:    if (t.reason === \"STEP_BUDGET_EXHAUSTED\") {\ncli/src/core/run_turn.ts:275:        stopReason = budget ? \"STEP_BUDGET_EXHAUSTED\" : \"STEP_LIMIT_REACHED\";\ncli/src/core/run_turn.ts:1048:      stepsUsed: stopReason === \"STEP_BUDGET_EXHAUSTED\" ? tracker.data.cumulativeSteps : (stepsUsed || Math.min(currentStep, maxTotalSteps)),\ncli/src/core/run_turn.ts:1307:      reason: input.stopReason ?? \"STEP_LIMIT_REACHED\",\n      );\n    }\n\n    triggerNotification(\"Nexus Code\", \"Turn finished.\", this.surface);\n\n    try {\n      this.knowledge.autoExtract(promptText, \"\");\n    } catch {}\n\n    const limitReached = !interruption && !inferenceFailure && !capacityBlock && !persistenceFailure && modelStop === \"NONE\" && stopReason !== undefined;\n    const resultInput = {\n      persistenceFailure,\n      modelStop,\n      finalOutputComplete,\n      inferenceFailure,\n      interruption,\n      limitReached,\n      capacityBlock,\n      stepsUsed: stopReason === \"STEP_BUDGET_EXHAUSTED\" ? tracker.data.cumulativeSteps : (stepsUsed || Math.min(currentStep, maxTotalSteps)),\n      providerRecoveries,\n      maxSteps: maxTotalSteps,\n      stopReason,\n      stopDetail,\n      ...(budget\n        ? {\n            continuation: {\n              segments: segment,\n              segmentSteps,\n              ...(stopReason ? { stopReason } : {}),\n              stepsWithoutProgress: tracker.data.stepsWithoutProgress,\n              cumulativeSteps: tracker.data.cumulativeSteps,\n              ...(tracker.loops().length ? { repeated: tracker.loops().slice(0, 5).map((r) => ({ action: r.action, count: r.count, firstStep: r.firstStep, lastStep: r.lastStep })) } : {}),\n              ...(this.stateIdentityUncertainty ? { stateUncertainty: this.stateIdentityUncertainty } : {}),\n            },\n          }\n        : {}),\n    };\n    let result = this.buildTurnResult(resultInput);\n    if (this.objective) {\n      if (this.durable) this.objective.continuation.totalSteps = tracker.data.cumulativeSteps;\n      this.objective.continuation.stopReason = stopReason ?? (persistenceFailure ? \"PERSISTENCE_FAILED\" : undefined);\n      this.objective.outcome = { ...this.objectiveOutcome(result), at: result.finishedAt };\n      try {\n        withDurableSync(() => this.checkpointDurableState(undefined, result));\n      } catch (err: any) {\n        this.reportPersistenceFailure(\"final_checkpoint\", err);\n        result = this.buildTurnResult(resultInput);\n      }\n    } else if (this.durable) {\n      try {\n        withDurableSync(() => this.checkpointDurableState(undefined, result));\n      } catch (err: any) {\n        this.reportPersistenceFailure(\"final_checkpoint\", err);\n        result = this.buildTurnResult(resultInput);\n      }\n    }\n    this.lastTurnResult = result;\n    if (this.flightRecorder) {\n      this.flightRecorder.recordSessionEnd(\n    }));\n  }\n  if (input.inferenceFailure) {\n    const exhaustedDetail =\n      lastRecovery?.state === \"EXHAUSTED\"\n        ? `; provider recovery exhausted after ${lastRecovery.submissions.length} submissions, ${Math.round(lastRecovery.waitedMs / 1000)}s waiting` +\n          (lastRecovery.everSucceeded === false ? \" — run `nexus doctor`, check LOCAL_LLM_ENDPOINT in ~/.config/nexus/config.env, or use /connect\" : \"\")\n        : \"\";\n    return deepFreezeTurn(assertTurnResultInvariants({\n      ...base, execution: \"FAILED\", outcome: \"NOT_ESTABLISHED\", reason: \"INFERENCE_FAILED\",\n      detail: `${input.inferenceFailure.kind}/${input.inferenceFailure.origin}${input.inferenceFailure.httpStatus ? ` HTTP ${input.inferenceFailure.httpStatus}` : \"\"}${exhaustedDetail}`,\n      finalOutputComplete: false,\n    }));\n  }\n  if (input.capacityBlock) {\n    const c = input.capacityBlock;\n    return deepFreezeTurn(assertTurnResultInvariants({\n      ...base, execution: \"BLOCKED\", outcome: \"NOT_ESTABLISHED\", reason: \"CONTEXT_CAPACITY_EXCEEDED\",\n      detail: `${c.estimatedPromptTokens}+${c.completionReserveTokens}+${c.toolResponseReserveTokens}>${c.contextLimit}`,\n      finalOutputComplete: false, capacity: c,\n    }));\n  }\n  if (input.limitReached && input.stopReason === \"VERIFIER_NOT_CONVERGING\" && this.turnConvergence) {\n    return deepFreezeTurn(assertTurnResultInvariants({\n      ...base, execution: \"BLOCKED\", outcome: \"NOT_ESTABLISHED\", reason: \"VERIFIER_NOT_CONVERGING\",\n      detail: this.turnConvergence.evidence.slice(0, 300), finalOutputComplete: false, convergence: this.turnConvergence,\n    }));\n  }\n  if (input.limitReached && input.stopReason === \"NEEDS_INPUT\" && this.pendingNeedsInput) {\n    return deepFreezeTurn(assertTurnResultInvariants({\n      ...base, execution: \"BLOCKED\", outcome: \"NOT_ESTABLISHED\", reason: \"NEEDS_INPUT\",\n      detail: this.pendingNeedsInput.prompt.slice(0, 300), finalOutputComplete: false, needsInput: this.pendingNeedsInput,\n      ...(this.furtherNeedsInput.length ? { furtherNeedsInput: [...this.furtherNeedsInput] } : {}),\n    }));\n  }\n  if (input.limitReached && input.stopReason === \"TOOL_CALL_LOOP\" && this.turnRepeatedCall) {\n    return deepFreezeTurn(assertTurnResultInvariants({\n      ...base, execution: \"BLOCKED\", outcome: \"NOT_ESTABLISHED\", reason: \"TOOL_CALL_LOOP\",\n      detail: input.stopDetail, finalOutputComplete: false, repeatedCall: this.turnRepeatedCall,\n    }));\n  }\n  if (input.limitReached) {\n    const stepPaused = input.stopReason === \"STEP_PAUSED\";\n    return deepFreezeTurn(assertTurnResultInvariants({\n      ...base,\n      execution: \"LIMIT_REACHED\",\n      outcome: \"NOT_ESTABLISHED\",\n      reason: input.stopReason ?? \"STEP_LIMIT_REACHED\",\n      ...(stepPaused ? { stepPaused: true } : {}),\n      ...(input.stopDetail ? { detail: input.stopDetail } : {}),\n      finalOutputComplete: false,\n    }));\n  }\n  // A finished turn with operator requirements still open or blocked established nothing about the objective, whatever\n  // the verifier said about the code (a failing verifier is the more specific reason and is reported below).\n  const requirementsIncomplete = open.length > 0 || blocked.length > 0;\n  // VC-9 row 8: in a headless run (`nexus run`) nobody is there to read \"R3 is blocked\" and reply, so a requirement the\n  // model marked blocked ends the turn BLOCKED / NEEDS_INPUT with the blocker as a question. Other surfaces have an\n  // operator or a client and keep REQUIREMENTS_INCOMPLETE; so does a requirement that is only still open.\n  const blockedByModel = this.config.surface === \"headless\" && this.depth === 0 ? blocked.filter((r) => r.status === \"blocked\") : [];\n  const blockedRequirementTurn = (): TurnResult | undefined => {\n    if (!blockedByModel.length) return undefined;\n    const [first, ...rest] = blockedByModel.map((r) => buildBlockedRequirementQuestion(r));\n    const further = rest.filter((q, i) => q.id !== first.id && rest.findIndex((x) => x.id === q.id) === i);\n    return deepFreezeTurn(assertTurnResultInvariants({\n      ...base, execution: \"BLOCKED\", outcome: \"NOT_ESTABLISHED\", reason: \"NEEDS_INPUT\",\n      detail: first.prompt.slice(0, 300), needsInput: first,\n      ...(further.length ? { furtherNeedsInput: further } : {}),\n    }));\n  };\n  // VC-9 row 7: steering that would drop a requirement went undecided in this turn (nobody could be asked, or the turn\n  // closed first). It was not applied, so what the turn did is not what the operator last asked for: a turn that would\n  // otherwise report completion ends BLOCKED / NEEDS_INPUT with the decision as the question.\n  const steeringConflictTurn = (): TurnResult | undefined => {\n    const undecided = (ledger?.steeringConflicts ?? []).filter((c: any) => c.status === \"unresolved\" && !c.carried);\n    if (!undecided.length) return undefined;\n/**\n * Structured turn result (slice: truthful, interruptible turns).\n *\n * Three orthogonal dimensions are reported separately so that no single value has to\n * carry execution, engineering and acceptance meaning at once:\n *\n *   execution   - what happened to the turn itself\n *   outcome     - what Nexus can *demonstrate* about the engineering result\n *   acceptance  - whether an operator accepted the result (never set by Nexus itself)\n *\n * This module is presentation-free: callers (CLI, REPL, a future TUI) project it, they do not\n * reinterpret it. VERIFIED can only be produced from verifier evidence, never asserted.\n */\nimport type { ToolCallSyntaxCounts } from \"../parser.js\";\nimport type { NeedsInputQuestion } from \"./needs_input.js\";\n\nexport type ExecutionState = \"COMPLETED\" | \"INTERRUPTED\" | \"FAILED\" | \"BLOCKED\" | \"LIMIT_REACHED\";\n\n/**\n * VERIFIED        - the verifier selected for this workspace ran and passed against the current changes\n * UNVERIFIED      - work ended with a result that was not (or could not be) verified; see reason. Either changes\n *                   no passing verifier covers, or an answer resting on tool output that context compaction removed\n *                   during the turn and the model did not re-read (CONTEXT_EVIDENCE_NOT_RETAINED)\n * NOT_ESTABLISHED - no engineering result was established (turn did not complete, or verifier failed)\n * NOT_REQUIRED    - the turn made no workspace change and every tool output it relied on was still in context\n */\nexport type EngineeringOutcome = \"VERIFIED\" | \"REGRESSION_FREE\" | \"UNVERIFIED\" | \"NOT_ESTABLISHED\" | \"NOT_REQUIRED\";\n\nexport type OperatorAcceptance = \"NOT_REQUESTED\" | \"ACCEPTED\" | \"NOT_ACCEPTED\";\n\nexport type TurnReason =\n  | \"NO_APPLICABLE_VERIFIER\"\n  | \"NO_TESTS_EXECUTED\"\n  | \"VERIFICATION_NOT_RUN\"\n  | \"REGRESSION_FREE\"\n  | \"CONTEXT_EVIDENCE_NOT_RETAINED\"\n  | \"VERIFIER_FAILED\"\n  | \"VERIFIER_TIMED_OUT\"\n  /** The same failure repeated, alternated or grew across fresh candidates: the turn stopped for the operator to decide. */\n  | \"VERIFIER_NOT_CONVERGING\"\n  /** The model repeated one tool call with identical arguments and an identical result until the hard threshold. */\n  | \"TOOL_CALL_LOOP\"\n  /** A headless run needs an operator decision (approval): BLOCKED with the question in TurnResult.needsInput (VC-9). */\n  | \"NEEDS_INPUT\"\n  | \"INFERENCE_FAILED\"\n  | \"STEP_LIMIT_REACHED\"\n  | \"STEP_PAUSED\"\n  /** Continued turn: the total step budget across segments is spent. */\n  | \"STEP_BUDGET_EXHAUSTED\"\n  /** Continued turn: the wall-clock budget is spent. */\n  | \"TIME_BUDGET_EXHAUSTED\"\n  /** Continued turn: no progress for the configured number of steps, or bounded recovery from a repeated action failed. */\n  | \"STAGNATION_DETECTED\"\n  /** The work stopped with operator acceptance requirements still open or blocked (see TurnResult.objective). */\n  | \"REQUIREMENTS_INCOMPLETE\"\n  | \"OPERATOR_INTERRUPT\"\n  | \"REPOSITORY_STATE_CHANGED\"\n  | \"CONTEXT_CAPACITY_EXCEEDED\"\n  /** A compaction (or other state the next action depends on) could not be written durably; the turn stopped. */\n  | \"PERSISTENCE_FAILED\"\n  | \"UNHANDLED_ERROR\";\n\n/** What made the model/agent loop stop issuing actions. Not itself evidence of success. */\nexport type ModelStop = \"TASK_COMPLETED_TOOL\" | \"FINAL_TEXT\" | \"NONE\";\n\nexport type InferenceFailureKind =\n  | \"http_error\"\n  | \"network_error\"\n  | \"timeout\"\n  | \"stream_interrupted\"\n  | \"stream_incomplete\"\n  | \"provider_error_frame\"\n  | \"malformed_event\"\n  | \"output_truncated\"\n  | \"protocol_error\"\n  | \"aborted\"\n  /** Refused before sending: disclosure not authorized, or a spending limit reached. */\n  | \"policy_denied\"\n  /** Refused before sending: the connection lacks a required credential or model. */\n  | \"configuration_error\";\n\nexport type InferenceFailureOrigin = \"provider\" | \"transport\" | \"client\" | \"operator\";\n\n/**\n * What a failed inference request says about the provider. The first four are temporary: the agent loop may wait\n * for them. The rest need a different request, configuration, or the operator.\n */\nexport type ProviderCondition =\n  | \"TEMPORARILY_UNAVAILABLE\"\n  | \"RATE_LIMITED\"\n  | \"OVERLOADED\"\n  | \"DRAINING\"\n  | \"AUTH_FAILURE\"\n  /** Billing or quota exhausted (HTTP 402, insufficient_quota): not waited out, never retried. */\n  | \"QUOTA_EXHAUSTED\"\n  | \"CAPACITY_REJECTED\"\n  | \"REQUEST_REJECTED\"\n  | \"PERMANENT_FAILURE\"\n  | \"AVAILABLE\";\n\n/**\n * What is known about whether the provider executed the failed request.\n * NOT_EXECUTED: proven not run (never sent, refused, or answered with a rejection status).\n * UNKNOWN: it may have been admitted and generated; nothing complete reached Nexus.\n * COMPLETED: the provider finished it (terminal evidence was received).\n */\nexport type ExecutionStatus = \"NOT_EXECUTED\" | \"UNKNOWN\" | \"COMPLETED\";\n\n/** Retry metadata a provider advertised with a failure. All optional: plain OpenAI-compatible servers send none. */\nexport interface ProviderHints {\n  retryAfterMs?: number;\n  rateLimitResetMs?: number;\n  remainingRequests?: number;\n  remainingTokens?: number;\n  /** Provider error code, e.g. `context_length_exceeded`, `gateway_restarting`, `pre_generation`. */\n  errorCode?: string;\n  errorType?: string;\n}\n\n/** One level of a transport error's cause chain (socket, TLS, or parser error beneath `fetch failed`). */\n","exit_code":0,"duration":{"secs":1,"nanos":182185026}},"started_at_ms":1795301159927,"completed_at_ms":1795301161110}}
