re/objective.ts:203:export interface ObjectiveLedger {\ncli/src/core/objective.ts:222:  continuation: ContinuationState;\ncli/src/core/objective.ts:242:  if (Number.isSafeInteger(ledger.continuation?.totalSteps) && ledger.continuation.totalSteps > ledger.execution.cumulativeSteps) {\ncli/src/core/objective.ts:317:    continuation: { segments: 1, totalSteps: 0, lastProgressStep: 0 },\n  trigger?: string;\n  /** Step of the last escalation: several unproductive calls in one batch are one event, not several. */\n  lastEscalationStep?: number;\n  /** Correlated recovery evidence: non_progress_detected, recovery_advisory_issued, recovery_constrained, ... */\n  events: TrackingEvent[];\n}\n\nexport interface ExecutionTracking {\n  version: number;\n  /** Steps charged to this objective across turns and in-turn delegated agents. */\n  cumulativeSteps: number;\n  turns: number;\n  /** Consecutive steps without progress, across turns; operator input resets it. */\n  stepsWithoutProgress: number;\n  lastProgressStep: number;\n  repetitions: RepetitionRecord[];\n  progress: TrackingEvent[];\n  stagnation: TrackingEvent[];\n  failedApproaches: TrackingEvent[];\n  interventions: TrackingEvent[];\n  compactions: CompactionEvent[];\n  /** Consecutive pressure compactions that yielded little (thrashing evidence; reset by a useful one). */\n  lowYieldCompactions: number;\n  seenStates: string[];\n  seenObservations: string[];\n  seenLedgerStates: string[];\n  coverage: CoverageSegment[];\n  equivalents: EquivalenceRecord[];\n  recovery: RecoveryState;\n  evicted: { states: number; observations: number; ledgerStates: number; repetitions: number; events: number; coverage: number };\n}\n\nfunction createRecovery(): RecoveryState {\n  return { stage: \"normal\", episode: 0, notes: 0, denials: 0, allowedDenials: 0, events: [] };\n}\n\nexport function createTracking(): ExecutionTracking {\n  return {\n    version: TRACKING_VERSION,\n    cumulativeSteps: 0,\n    turns: 0,\n    stepsWithoutProgress: 0,\n    lastProgressStep: 0,\n    repetitions: [],\n    progress: [],\n    stagnation: [],\n    failedApproaches: [],\n    interventions: [],\n    compactions: [],\n    lowYieldCompactions: 0,\n    seenStates: [],\n    seenObservations: [],\n    seenLedgerStates: [],\n    coverage: [],\n    equivalents: [],\n    recovery: createRecovery(),\n    evicted: { states: 0, observations: 0, ledgerStates: 0, repetitions: 0, events: 0, coverage: 0 },\n  };\n}\n\n/**\n * Fills, in place, fields a tracking record written by an earlier version lacks (restored ledgers), and returns the\n * same object: every holder (the running turn's tracker, compaction, the ledger) must share one record.\n */\nexport function normalizeTracking(raw: unknown): ExecutionTracking {\n  if (!raw || typeof raw !== \"object\") return createTracking();\n  const t = raw as Record<string, any>;\n  const base = createTracking() as unknown as Record<string, any>;\n  for (const [key, value] of Object.entries(base)) {\n    if (Array.isArray(value)) {\n      if (!Array.isArray(t[key])) t[key] = [];\n    } else if (typeof value === \"number\") {\n      if (typeof t[key] !== \"number\" || !Number.isFinite(t[key])) t[key] = value;\n    } else if (key === \"evicted\") {\n      t[key] = { ...value, ...(t[key] && typeof t[key] === \"object\" ? t[key] : {}) };\n    } else if (key === \"recovery\") {\n      const r = t[key] && typeof t[key] === \"object\" ? t[key] : {};\n      const fresh = createRecovery() as unknown as Record<string, any>;\n      for (const [k, v] of Object.entries(fresh)) {\n        if (Array.isArray(v)) {\n          if (!Array.isArray(r[k])) r[k] = [];\n  coveredBy: CoverageSegment[];\n  /** Readable action that was refused. */\n  action: string;\n}\n\nexport interface StepEvaluation {\n  progressed: boolean;\n  reasons: string[];\n  stateUnknown: boolean;\n}\n\n/** Mutable view over the ledger's tracking record. */\nexport class ExecutionTracker {\n  constructor(public readonly data: ExecutionTracking, private readonly clock: () => string = () => new Date().toISOString()) {}\n\n  static fresh(): ExecutionTracker {\n    return new ExecutionTracker(createTracking());\n  }\n\n  private event(list: TrackingEvent[], max: number, step: number, kind: string, detail: string): void {\n    pushBounded(list, { step, at: this.clock(), kind, detail: clip(detail, 400) }, max, (n) => (this.data.evicted.events += n));\n  }\n\n  beginTurn(): void {\n    this.data.turns++;\n  }\n\n  beginStep(): number {\n    return ++this.data.cumulativeSteps;\n  }\n\n  /** Records a single tool result; the verdict says whether it was new, a poll, or part of a demonstrated loop. */\n  observe(step: number, o: Observation): ObservationVerdict {\n    const kind = o.kind ?? actionKind(o.name);\n    const command = commandResult(o.success, o.text);\n    const outcomeClass = classifyOutcome(command.success, o.text, o.timedOut || command.timedOut);\n    const action = actionIdentity(o.name, o.args);\n    const outcome = outcomeIdentity(command.success, o.text);\n    const stateUnknown = o.stateBefore === \"unknown\";\n    const actionId = digest(action);\n    const key = digest(`${action}\\u0000${outcome}\\u0000${o.stateBefore}`);\n    let record = this.data.repetitions.find((r) => r.key === key);\n    const seenBefore = !stateUnknown && this.data.seenObservations.includes(key);\n    if (!record) {\n      record = {\n        key,\n        action: clip(`${o.name} ${typeof o.args === \"string\" ? o.args : JSON.stringify(o.args ?? {})}`.replace(/\\s+/g, \" \"), 160),\n        actionId,\n        actionKind: kind,\n        outcomeClass,\n        state: o.stateBefore,\n        // Seen before but its record was evicted: the recurrence still counts.\n        count: seenBefore ? 1 : 0,\n        firstStep: step,\n        lastStep: step,\n        outcome: clip(normalizeOutcomeText(o.text), 240),\n      };\n      this.insertRepetition(record);\n    }\n    record.count++;\n    record.lastStep = step;\n    if ((field === \"maxWaitMs\" || field === \"minWaitMs\") && value > 2_147_483_647) {\n      throw new Error(`Invalid Nexus config.json operationPolicy.${field}: must not exceed Node's timer limit (2147483647 ms).`);\n    }\n    policy[field] = value;\n  }\n  return Object.keys(policy).length ? policy : undefined;\n}\n\n/** Merge operator defaults and spec overrides, then validate the effective operation policy. */\nexport function mergeOperationPolicy(\n  configured: HarnessConfig[\"operationPolicy\"],\n  override: HarnessConfig[\"operationPolicy\"],\n): HarnessConfig[\"operationPolicy\"] {\n  const policy = { ...configured, ...override };\n  const effective = { ...DEFAULT_OPERATION_POLICY, ...policy };\n  const maxTimerDelayMs = 2_147_483_647;\n  const fields = [\n    [\"maxWaitMs\", effective.maxWaitMs, 1],\n    [\"unknownResumeBudget\", effective.unknownResumeBudget, 0],\n    [\"maxRunsPerUnit\", effective.maxRunsPerUnit, 1],\n    [\"minWaitMs\", effective.minWaitMs, 1],\n  ] as const;\n  for (const [field, value, minimum] of fields) {\n    if (typeof value !== \"number\" || !Number.isSafeInteger(value) || value < minimum) {\n      throw new Error(`Invalid operation policy ${field}: expected a safe integer of at least ${minimum}.`);\n    }\n    if ((field === \"maxWaitMs\" || field === \"minWaitMs\") && value > maxTimerDelayMs) {\n      throw new Error(`Invalid operation policy ${field}: must not exceed Node's timer limit (${maxTimerDelayMs} ms).`);\n    }\n  }\n  const { maxWaitMs, minWaitMs } = effective;\n  if (minWaitMs > maxWaitMs) {\n    throw new Error(`Invalid operation wait settings: minWaitMs (${minWaitMs}) must not exceed maxWaitMs (${maxWaitMs}).`);\n  }\n  return Object.keys(policy).length ? policy : undefined;\n}\n\n/**\n * Continuation budgets: flags, then NEXUS_MAX_TOTAL_STEPS / NEXUS_MAX_TURN_MINUTES / NEXUS_STAGNATION_STEPS, then\n * finite defaults. Total steps are charged to the durable objective ledger, so resume does not reset them.\n * `--no-continuation` (or NEXUS_CONTINUATION=0) is the operator's explicit choice of the single-segment turn that\n * ends at --max-steps.\n */\nexport function continuationBudget(options: any): ContinuationBudget | undefined {\n  if (options.continuation === false || effectiveSetting(\"NEXUS_CONTINUATION\") === \"0\") return undefined;\n  const positive = (flag: unknown, env: string | undefined, fallback: number, maximum = Number.POSITIVE_INFINITY): number => {\n    for (const raw of [flag, env]) {\n      if (raw === undefined || raw === null || raw === \"\") continue;\n      const value = Number(raw);\n      if (!Number.isFinite(value) || value <= 0) throw new Error(`Invalid continuation budget '${String(raw)}': expected a positive number.`);\n      if (value > maximum) throw new Error(`Invalid continuation budget '${String(raw)}': maximum is ${maximum}.`);\n      return value;\n    }\n    return fallback;\n  };\n  const steps = positive(options.maxTotalSteps, effectiveSetting(\"NEXUS_MAX_TOTAL_STEPS\"), DEFAULT_CONTINUATION.maxTotalSteps, MAX_CONTINUATION_STEPS);\n  return {\n    ...DEFAULT_CONTINUATION,\n    maxTotalSteps: Number.isFinite(steps) ? Math.floor(steps) : steps,\n    maxTurnMinutes: positive(options.maxTurnMinutes, effectiveSetting(\"NEXUS_MAX_TURN_MINUTES\"), DEFAULT_CONTINUATION.maxTurnMinutes, MAX_CONTINUATION_MINUTES),\n    stagnationSteps: Math.floor(positive(options.stagnationSteps, effectiveSetting(\"NEXUS_STAGNATION_STEPS\"), DEFAULT_CONTINUATION.stagnationSteps)),\n    verifierConvergenceAttempts: Math.floor(positive(undefined, effectiveSetting(\"NEXUS_VERIFIER_CONVERGENCE_ATTEMPTS\"), DEFAULT_CONVERGENCE_ATTEMPTS)),\n  };\n}\n\n/** Repeated-call thresholds: the operator's values, which a project `.env` may only lower. */\nexport function repeatedCallSettings() {\n  return resolveRepeatedCallSettings(\n    { soft: operatorSetting(\"NEXUS_REPEATED_CALL_SOFT\"), hard: operatorSetting(\"NEXUS_REPEATED_CALL_HARD\") },\n    { soft: projectSetting(\"NEXUS_REPEATED_CALL_SOFT\"), hard: projectSetting(\"NEXUS_REPEATED_CALL_HARD\") },\n  );\n        amendObjective(ledger, taskPrompt);\n      }\n    }\n    ledger.outcome = undefined;\n    ledger.continuation = { ...ledger.continuation, segments: 1, lastProgressStep: 0, stopReason: undefined };\n    this.objective = ledger;\n  }\n\n  let currentStep = 1;\n  let stepsUsed = 0;\n  const providerRecoveries: ProviderRecoveryRecord[] = [];\n  const budget = this.config.continuation;\n  const segmentSteps = Math.max(1, this.config.maxSteps);\n  const maxTotalSteps = budget ? budget.maxTotalSteps : segmentSteps;\n  let segment = 1;\n  const tracker = this.objective && this.durable ? trackingOf(this.objective) : ExecutionTracker.fresh();\n\n  try {\n    if (this.flightRecorder) {\n      if (!this.flightRecorder.isSessionActive()) {\n        this.flightRecorder.startSession({\n          model: this.config.model,\n          endpoint: this.config.endpoint,\n          taskPrompt: promptText,\n        });\n      }\n      this.flightRecorder.recordTurnStart(1, promptText);\n    }\n\n    // Dynamic runtime state injected into turn-level context without invalidating system prompt prefix cache\n    const gitInfo = getGitInfo(this.config.workspace);\n    let runtimeContext = \"\";\n    if (gitInfo.isRepo) {\n      runtimeContext += `\\n[Git Status: ${gitInfo.branch} (${gitInfo.dirtyCount} uncommitted dirty files)]`;\n    }\n    if (this.activePlan && this.activePlan.length > 0) {\n      runtimeContext += `\\n[Active Plan: ${this.activePlan.map((p: any, i: any) => `${i + 1}. [${p.status}] ${p.name}`).join(\" -> \")}]`;\n    }\n\n    const skipPromptSubmission =\n      (isStep || isResume) &&\n      typeof taskPrompt === \"string\" &&\n      taskPrompt.trim() === \"\" &&\n      (this.messages.length > 0 || continuingObjective);\n\n    const effectiveUserContent = typeof taskPrompt === \"string\"\n      ? (runtimeContext ? `${taskPrompt}\\n${runtimeContext}` : taskPrompt)\n      : taskPrompt;\n\n    const historyBeforeSubmission = this.messages.length;\n    if (!skipPromptSubmission) {\n        undispatchedToolCalls: undispatched,\n        ...extra,\n      };\n    };\n    const cancelledToolMessage = (call: ToolCall) => ({\n      role: \"tool\" as const,\n      tool_call_id: call.id,\n      name: call.function.name,\n      content: \"Cancelled by operator before execution. No action was taken.\",\n    });\n\n    // Continuation: `maxSteps` is a segment, a durable checkpoint. The total-step budget is objective-scoped and\n    // survives resumes; the active invocation also has a finite wall-clock limit. Without continuation\n    // (`--no-continuation`), the first segment boundary ends the turn (LIMIT_REACHED, legacy).\n    const turnDeadline = budget && Number.isFinite(budget.maxTurnMinutes) ? Date.now() + budget.maxTurnMinutes * 60_000 : Number.POSITIVE_INFINITY;\n    let stopReason: TurnReason | undefined;\n    let stopDetail: string | undefined;\n    let completionNudges = 0;\n    // Recovery state (notes, stage, refusals) lives in the tracker: in the ledger when durable, so compaction cannot\n    // remove it and resume restores it.\n    const allowedDenials = budget ? Math.max(1, budget.maxRecoveries) : 0;\n    this.stateIdentityDisabled = false;\n    this.stateIdentityUncertainty = undefined;\n    tracker.beginTurn();\n    if (continuingObjective) {\n      const isHarnessResume = typeof taskPrompt === \"string\" && /^\\[(?:Nexus|Work unit resumed)/.test(taskPrompt);\n      if (!isHarnessResume && !options?.resume && !isStep) {\n        tracker.operatorInput(tracker.data.cumulativeSteps, `operator follow-up: ${promptText.slice(0, 160)}`);\n      }\n    }\n    let stateNow = this.workspaceStateIdentity();\n    this.turnStartState = stateNow;\n    tracker.noteState(stateNow);\n    tracker.noteLedgerState(this.ledgerProgressIdentity());\n    const noticedPolls = new Set<string>();\n    const noticedThrash = new Set<string>();\n    let stateUnknownNoted = false;\n    const callRing: CallRecord[] = [];\n    let repeatedCallNote: string | undefined;\n    let loopedCall: { name: string; count: number; arguments: string; history: NonNullable<TurnResult[\"repeatedCall\"]>[\"history\"] } | undefined;\n\n    while (modelStop === \"NONE\" && !interruption && !inferenceFailure && !persistenceFailure) {\n      const convergence = this.turnConvergence as TurnResult[\"convergence\"];\n      if (convergence && !stopReason) {\n        stopReason = \"VERIFIER_NOT_CONVERGING\";\n        stopDetail = convergence.evidence;\n        if (this.objective && this.turnConvergenceUpTo !== undefined) this.objective.convergenceResetAfter = this.turnConvergenceUpTo;\n      }\n      if (stopReason) break;\n      const taskStepLimitReached = budget\n        ? tracker.data.cumulativeSteps >= maxTotalSteps\n        : currentStep > maxTotalSteps;\n      if (taskStepLimitReached) {\n        stopReason = budget ? \"STEP_BUDGET_EXHAUSTED\" : \"STEP_LIMIT_REACHED\";\n        stopDetail = budget\n          ? `objective step limit ${maxTotalSteps} reached (${tracker.data.cumulativeSteps} steps consumed across runs)`\n          : `--no-continuation: ${segmentSteps} steps`;\n        break;\n      }\n      if (Date.now() > turnDeadline) {\n        stopReason = \"TIME_BUDGET_EXHAUSTED\";\n        stopDetail = `operator time limit ${budget!.maxTurnMinutes} min`;\n        break;\n      }\n      if (budget && tracker.data.stepsWithoutProgress >= budget.stagnationSteps) {\n        stopReason = \"STAGNATION_DETECTED\";\n        const loops = tracker.loops().slice(0, 2).map((r) => `${r.action} ×${r.count}`).join(\"; \");\n        const thrash = tracker.reacquisitions().filter((r) => (r.reacquired ?? 0) >= 2).slice(0, 2).map((r) => `${r.action} re-read ×${r.reacquired} after compaction`).join(\"; \");\n        stopDetail = `${tracker.data.stepsWithoutProgress} consecutive steps without progress${loops ? ` (repeated: ${loops})` : \"\"}${thrash ? ` (context thrash: ${thrash})` : \"\"}${this.stateIdentityUncertainty ? `; ${this.stateIdentityUncertainty}` : \"\"}`;\n        tracker.stagnation(tracker.data.cumulativeSteps, \"no_progress\", stopDetail);\n        break;\n      }\n      if (signal.aborted) {\n        markInterrupted(\"between_steps\");\n        break;\n      }\n      // --step: one model/tool cycle per turn. Every path that continues the loop ends its cycle with endStep (recovery\n      // note delivered, progress evaluated) and comes back here, so this one boundary covers the sequential, parallel-read\n      // and notice paths alike; a stop set by the cycle or by the checks above (STAGNATION_DETECTED, a budget, a cancel)\n      // is reported instead. currentStep advances only in endStep, so it is past 1 once this turn finished a cycle.\n      if (isStep && currentStep > 1) {\n        stopReason = \"STEP_PAUSED\";\n        stopDetail = \"paused after one model/tool cycle (--step)\";\n        break;\n      }\n      // Operator /compact queued during the previous step runs here: its inference and tool batch have settled.\n      // False when a compaction that is not durable ends the turn.\n      const drainQueuedCompactions = async (): Promise<boolean> => {\n        // A `/compact --llm` stays queued while a resumed window covers the provider it calls (see drainCompactionQueue).\n        if (!this.compactionQueue.length) return true;\n        try {\n          await this.drainCompactionQueue(currentStep, signal);\n        } catch (err) {\n          if (!(err instanceof CompactionCommitError)) throw err;\n          persistenceFailure = err.outcome.message;\n          return false;\n        }\n        return true;\n      };\n      if (!(await drainQueuedCompactions())) break;\n      if (budget && currentStep > 1 && (currentStep - 1) % segmentSteps === 0) {\n        segment++;\n        if (this.objective) this.objective.continuation.segments = segment;\n        withDurableSync(() => {\n          try {\n            this.checkpointDurableState(`continuation: segment ${segment} begins at step ${currentStep}`);\n          } catch (err: any) {\n            this.reportPersistenceFailure(\"continuation\", err);\n          }\n          this.persistProgress({ messages: true });\n        });\n        console.warn(pc.dim(`↻ Continuing automatically: segment ${segment} begins at step ${currentStep}; the work is still progressing.`));\n      }\n      const cumulativeStep = tracker.beginStep();\n      if (this.objective && this.durable) this.objective.continuation.totalSteps = tracker.data.cumulativeSteps;\n      // Charge and persist this inference step before contacting a provider. If durable state cannot record the\n      // consumed budget, stop here: a resume must not repeat an unaccounted request.\n      if (this.durable && !this.persistProgress({ messages: true })) {\n        persistenceFailure = this.turnPersistenceFailures.at(-1) ?? \"The objective step budget could not be saved before inference.\";\n        stopReason = \"PERSISTENCE_FAILED\";\n        break;\n      }\n      const stepStateBefore = stateNow;\n      const verdicts: ObservationVerdict[] = [];\n      /**\n       * Evidence-backed progress earlier in this step, judged as endStep will judge it: new information, or a\n      text = `The delegated task budget could not be saved durably (${message}); no further delegated inference or tool execution is allowed.`;\n      this.objectiveBudgetPersistenceFailure = text;\n    } else if (kind === \"operation_start\" || kind === \"operation_end\") {\n      text = `Tool operation record (${kind}) could not be written durably (${message}); crash recovery degraded.`;\n    } else if (kind === \"init\") {\n      text = `Initial durable task state was not persisted (${message}); restart recovery is unavailable until a later successful checkpoint.`;\n      this.initialStatePersistenceFailure = text;\n    } else if (kind === \"final_checkpoint\") {\n      text = `The turn's final task state could not be saved: ${message}`;\n    } else {\n      text = `Durable checkpoint (${kind}) could not be saved (${message}); if the process stops, state since last save may be lost.`;\n    }\n    this.turnPersistenceFailures.push(text);\n    try {\n      if (this.observer?.onNotice) this.observer.onNotice(text);\n      else console.warn(pc.yellow(text));\n    } catch {}\n  }\n\n  /** Persist only the shared objective ledger, never the subagent's temporary conversation. */\n  private persistObjectiveBudget(): boolean {\n    if (!this.durable) return true;\n    try {\n      if (!this.stateManager || !this.currentTaskId || !this.objective) throw new Error(\"durable objective state is unavailable\");\n      this.stateManager.recordProgress(this.currentTaskId, { objective: this.objective });\n      return true;\n    } catch (err) {\n      this.reportPersistenceFailure(\"objective_budget\", err);\n      return false;\n    }\n  }\n\n  /** Share the parent's ledger and durable checkpoint with an ephemeral delegated agent. */\n  public inheritObjectiveBudget(parent: AutonomousAgent): void {\n    if (!parent.durable || !parent.objective) return;\n    this.sharedObjectiveBudget = {\n      ledger: parent.objective,\n      persist: () => parent.persistObjectiveBudget(),\n    };\n  }\n\n  /**\n   * Gives every tool call in a recovered conversation a result: a call whose result was never recorded gets a note\n   * that its outcome is unknown. Returns the tools of those calls.\n   */\n  private settleUnrecordedToolCalls(): string[] {\n    let last = -1;\n    for (let i = this.messages.length - 1; i >= 0; i--) {\n      if (this.messages[i].role === \"assistant\" && this.messages[i].tool_calls?.length) {\n        last = i;\n        break;\n      }\n    }\n    if (last < 0) return [];\n    const calls = this.messages[last].tool_calls!;\n    const recorded = this.messages.slice(last + 1).filter((m) => m.role === \"tool\").length;\n    this.runningAsSubagent = true;\n    this.subagentObjective = prompt;\n    // A subagent is used for one run: its commands are tied to the parent turn's cancellation for its lifetime.\n    this.bridge.setTurnSignal(signal);\n    this.resetConversation();\n    this.messages.push({\n      role: \"user\",\n      content: `[Subagent Objective]: ${prompt}\\n\\nPlease inspect, execute tools as needed, and produce a concise, comprehensive report answering the objective. Call task_completed when done.`,\n    });\n\n    const stagnationSteps = this.config.continuation?.stagnationSteps ?? DEFAULT_CONTINUATION.stagnationSteps;\n    const maxRecoveries = this.config.continuation?.maxRecoveries ?? DEFAULT_CONTINUATION.maxRecoveries;\n    const maxTotalSteps = this.config.continuation?.maxTotalSteps ?? this.config.maxSteps;\n    // A subagent consumes the same objective-wide step allowance as its parent. The shared tracking data survives\n    // resume; the subagent's local tracker below is only for its own progress/stagnation decisions.\n    const budgetLedger = this.sharedObjectiveBudget?.ledger ?? (this.durable ? this.objective : undefined);\n    const objectiveTracker = budgetLedger ? trackingOf(budgetLedger) : undefined;\n    const tracker = ExecutionTracker.fresh();\n    tracker.beginTurn();\n    let state = this.workspaceStateIdentity();\n    tracker.noteState(state);\n    let recoveries = 0;\n    let currentStep = 1;\n    let finalSummary = \"\";\n    let previousReplyTruncated = false;\n\n    for (;;) {\n      if (signal?.aborted) return { completed: false, summary: finalSummary, reason: \"cancelled with the parent turn\" };\n      const consumedTaskSteps = objectiveTracker?.data.cumulativeSteps ?? (currentStep - 1);\n      if (consumedTaskSteps >= maxTotalSteps) {\n        return { completed: false, summary: finalSummary, reason: `objective step budget exhausted (${consumedTaskSteps}/${maxTotalSteps}); no further subagent inference was submitted` };\n      }\n      if (tracker.data.stepsWithoutProgress >= stagnationSteps) {\n        const loops = tracker.loops().slice(0, 2).map((r) => `${r.action} ×${r.count}`).join(\"; \");\n        return { completed: false, summary: finalSummary, reason: `no progress for ${tracker.data.stepsWithoutProgress} consecutive steps${loops ? ` (repeated: ${loops})` : \"\"}` };\n      }\n      const cumulativeStep = tracker.beginStep();\n      if (objectiveTracker) {\n        objectiveTracker.beginStep();\n        if (budgetLedger) budgetLedger.continuation.totalSteps = objectiveTracker.data.cumulativeSteps;\n        // The helper runs through this parent agent, so its extra inference steps must be in the durable objective\n        // ledger before any request is sent. Do not persist the helper's temporary message array as the parent chat.\n        const persisted = this.sharedObjectiveBudget ? this.sharedObjectiveBudget.persist() : this.persistObjectiveBudget();\n        if (!persisted) {\n          return { completed: false, summary: finalSummary, reason: \"PERSISTENCE_FAILED: the shared objective budget could not be saved before delegated inference\" };\n        }\n      }\n      let assistantMessage: ChatMessage;\n      const requestId = randomUUID();\n      const { client: activeClient } = this.selectCognitiveClient(currentStep, this.messages);\n      try {\n        await this.admitWithFindings(activeClient, currentStep, requestId, signal);\n        await this.measureAdmission(activeClient, currentStep, requestId, signal);\n        const policy = this.recoveryPolicy ?? recoveryPolicyFromEnv();\n        const lengthGuard = { step: currentStep, cutAfterMs: 0 };\n        assistantMessage = await new ProviderRecoveryController(policy, this.recoveryClock, currentStep, {\n          everSucceeded: typeof activeClient.hasEverSucceeded === \"function\" ? activeClient.hasEverSucceeded() : true,\n          endpoint: activeClient.endpoint,\n        }).run(requestId, {\n          submit: (s) => this.submitGenAiRequest(activeClient, () =>\n            this.submitGuardingLength(lengthGuard, this.messages, (request) =>\n              activeClient.chatCompletion(request, this.getEffectiveTools(), s.requestId, signal))),\n          probe: (probeSignal, opts) =>\n            typeof activeClient.probeAvailability === \"function\"\n              ? activeClient.probeAvailability(probeSignal, { timeoutMs: policy.probeTimeoutMs, ...opts })\n              : Promise.resolve({ available: true, condition: \"AVAILABLE\" as const }),\n          classify: (err) => (err instanceof InferenceError && err.kind !== \"output_truncated\" ? err.toFailure() : null),\n          newRequestId: () => randomUUID(),\n        }, signal);\n      } catch (err: any) {\n        if (signal?.aborted) return { completed: false, summary: finalSummary, reason: \"cancelled with the parent turn\" };\n","exit_code":0,"duration":{"secs":0,"nanos":29374}},"started_at_ms":1795156496742,"completed_at_ms":1795156496742}}
{"timestamp":"2026-11-20T06:34:56.906Z","ordinal":32708,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1f7aa-520a-7342-a9ba-bee3a9dce807","call_id":"call_ac61ea22afdd41d59e10308855ec8eee","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 6536)\nTotal output lines: 521\n\ncli/src/core/objective.ts:203:export interface ObjectiveLedger {\ncli/src/core/objective.ts:222:  continuation: ContinuationState;\ncli/src/core/objective.ts:242:  if (Number.isSafeInteger(ledger.continuation?.totalSteps) && ledger.continuation.totalSteps > ledger.execution.cumulativeSteps) {\ncli/src/core/objective.ts:317:    continuation: { segments: 1, totalSteps: 0, lastProgressStep: 0 },\n  trigger?: string;\n  /** Step of the last escalation: several unproductive calls in one batch are one event, not several. */\n  lastEscalationStep?: number;\n  /** Correlated recovery evidence: non_progress_detected, recovery_advisory_issued, recovery_constrained, ... */\n  events: TrackingEvent[];\n}\n\nexport interface ExecutionTracking {\n  version: number;\n  /** Steps charged to this objective across turns and in-turn delegated agents. */\n  cumulativeSteps: number;\n  turns: number;\n  /** Consecutive steps without progress, across turns; operator input resets it. */\n  stepsWithoutProgress: number;\n  lastProgressStep: number;\n  repetitions: RepetitionRecord[];\n  progress: TrackingEvent[];\n  stagnation: TrackingEvent[];\n  failedApproaches: TrackingEvent[];\n  interventions: TrackingEvent[];\n  compactions: CompactionEvent[];\n  /** Consecutive pressure compactions that yielded little (thrashing evidence; reset by a useful one). */\n  lowYieldCompactions: number;\n  seenStates: string[];\n  seenObservations: string[];\n  seenLedgerStates: string[];\n  coverage: CoverageSegment[];\n  equivalents: EquivalenceRecord[];\n  recovery: RecoveryState;\n  evicted: { states: number; observations: number; ledgerStates: number; repetitions: number; events: number; coverage: number };\n}\n\nfunction createRecovery(): RecoveryState {\n  return { stage: \"normal\", episode: 0, notes: 0, denials: 0, allowedDenials: 0, events: [] };\n}\n\nexport function createTracking(): ExecutionTracking {\n  return {\n    version: TRACKING_VERSION,\n    cumulativeSteps: 0,\n    turns: 0,\n    stepsWithoutProgress: 0,\n    lastProgressStep: 0,\n    repetitions: [],\n    progress: [],\n    stagnation: [],\n    failedApproaches: [],\n    interventions: [],\n    compactions: [],\n    lowYieldCompactions: 0,\n    seenStates: [],\n    seenObservations: [],\n    seenLedgerStates: [],\n    coverage: [],\n    equivalents: [],\n    recovery: createRecovery(),\n    evicted: { states: 0, observations: 0, ledgerStates: 0, repetitions: 0, events: 0, coverage: 0 },\n  };\n}\n\n/**\n * Fills, in place, fields a tracking record written by an earlier version lacks (restored ledgers), and returns the\n * same object: every holder (the running turn's tracker, compaction, the ledger) must share one record.\n */\nexport function normalizeTracking(raw: unknown): ExecutionTracking {\n  if (!raw || typeof raw !== \"object\") return createTracking();\n  const t = raw as Record<string, any>;\n  const base = createTracking() as unknown as Record<string, any>;\n  for (const [key, value] of Object.entries(base)) {\n    if (Array.isArray(value)) {\n      if (!Array.isArray(t[key])) t[key] = [];\n    } else if (typeof value === \"number\") {\n      if (typeof t[key] !== \"number\" || !Number.isFinite(t[key])) t[key] = value;\n    } else if (key === \"evicted\") {\n      t[key] = { ...value, ...(t[key] && typeof t[key] === \"object\" ? t[key] : {}) };\n    } else if (key === \"recovery\") {\n      const r = t[key] && typeof t[key] === \"object\" ? t[key] : {};\n      const fresh = createRecovery() as unknown as Record<string, any>;\n      for (const [k, v] of Object.entries(fresh)) {\n        if (Array.isArray(v)) {\n          if (!Array.isArray(r[k])) r[k] = [];\n  coveredBy: CoverageSegment[];\n  /** Readable action that was refused. */\n  action: string;\n}\n\nexport interface StepEvaluation {\n  progressed: boolean;\n  reasons: string[];\n  stateUnknown: boolean;\n}\n\n/** Mutable view over the ledger's tracking record. */\nexport class ExecutionTracker {\n  constructor(public readonly data: ExecutionTracking, private readonly clock: () => string = () => new Date().toISOString()) {}\n\n  static fresh(): ExecutionTracker {\n    return new ExecutionTracker(createTracking());\n  }\n\n  private event(list: TrackingEvent[], max: number, step: number, kind: string, detail: string): void {\n    pushBounded(list, { step, at: this.clock(), kind, detail: clip(detail, 400) }, max, (n) => (this.data.evicted.events += n));\n  }\n\n  beginTurn(): void {\n    this.data.turns++;\n  }\n\n  beginStep(): number {\n    return ++this.data.cumulativeSteps;\n  }\n\n  /** Records a single tool result; the verdict says whether it was new, a poll, or part of a demonstrated loop. */\n  observe(step: number, o: Observation): ObservationVerdict {\n    const kind = o.kind ?? actionKind(o.name);\n    const command = commandResult(o.success, o.text);\n    const outcomeClass = classifyOutcome(command.success, o.text, o.timedOut || command.timedOut);\n    const action = actionIdentity(o.name, o.args);\n    const outcome = outcomeIdentity(command.success, o.text);\n    const stateUnknown = o.stateBefore === \"unknown\";\n    const actionId = digest(action);\n    const key = digest(`${action}\\u0000${outcome}\\u0000${o.stateBefore}`);\n    let record = this.data.repetitions.find((r) => r.key === key);\n    const seenBefore = !stateUnknown && this.data.seenObservations.includes(key);\n    if (!record) {\n      record = {\n        key,\n        action: clip(`${o.name} ${typeof o.args === \"string\" ? o.args : JSON.stringify(o.args ?? {})}`.replace(/\\s+/g, \" \"), 160),\n        actionId,\n        actionKind: kind,\n        outcomeClass,\n        state: o.stateBefore,\n        // Seen before but its record was evicted: the recurrence still counts.\n        count: seenBefore ? 1 : 0,\n        firstStep: step,\n        lastStep: step,\n        outcome: clip(normalizeOutcomeText(o.text), 240),\n      };\n      this.insertRepetition(record);\n    }\n    record.count++;\n    record.lastStep = step;\n    if ((field === \"maxWaitMs\" || field === \"minWaitMs\") && value > 2_147_483_647) {\n      throw new Error(`Invalid Nexus config.json operationPolicy.${field}: must not exceed Node's timer limit (2147483647 ms).`);\n    }\n    policy[field] = value;\n  }\n  return Object.keys(policy).length ? policy : undefined;\n}\n\n/** Merge operator defaults and spec overrides, then validate the effective operation policy. */\nexport function mergeOperationPolicy(\n  configured: HarnessConfig[\"operationPolicy\"],\n  override: HarnessConfig[\"operationPolicy\"],\n): HarnessConfig[\"operationPolicy\"] {\n  const policy = { ...configured, ...override };\n  const effective = { ...DEFAULT_OPERATION_POLICY, ...policy };\n  const maxTimerDelayMs = 2_147_483_647;\n  const fields = [\n    [\"maxWaitMs\", effective.maxWaitMs, 1],\n    [\"unknownResumeBudget\", effective.unknownResumeBudget, 0],\n    [\"maxRunsPerUnit\", effective.maxRunsPerUnit, 1],\n    [\"minWaitMs\", effective.minWaitMs, 1],\n  ] as const;\n  for (const [field, value, minimum] of fields) {\n    if (typeof value !== \"number\" || !Number.isSafeInteger(value) || value < minimum) {\n      throw new Error(`Invalid operation policy ${field}: expected a safe integer of at least ${minimum}.`);\n    }\n    if ((field === \"maxWaitMs\" || field === \"minWaitMs\") && value > maxTimerDelayMs) {\n      throw new Error(`Invalid operation policy ${field}: must not exceed Node's timer limit (${maxTimerDelayMs} ms).`);\n    }\n  }\n  const { maxWaitMs, minWaitMs } = effective;\n  if (minWaitMs > maxWaitMs) {\n    throw new Error(`Invalid operation wait settings: minWaitMs (${minWaitMs}) must not exceed maxWaitMs (${maxWaitMs}).`);\n  }\n  return Object.keys(policy).length ? policy : undefined;\n}\n\n/**\n * Continuation budgets: flags, then NEXUS_MAX_TOTAL_STEPS / NEXUS_MAX_TURN_MINUTES / NEXUS_STAGNATION_STEPS, then\n * finite defaults. Total steps are charged to the durable objective ledger, so resume does not reset them.\n * `--no-continuation` (or NEXUS_CONTINUATION=0) is the operator's explicit choice of the single-segment turn that\n * ends at --max-steps.\n */\nexport function continuationBudget(options: any): ContinuationBudget | undefined {…2536 tokens truncated… step before contacting a provider. If durable state cannot record the\n      // consumed budget, stop here: a resume must not repeat an unaccounted request.\n      if (this.durable && !this.persistProgress({ messages: true })) {\n        persistenceFailure = this.turnPersistenceFailures.at(-1) ?? \"The objective step budget could not be saved before inference.\";\n        stopReason = \"PERSISTENCE_FAILED\";\n        break;\n      }\n      const stepStateBefore = stateNow;\n      const verdicts: ObservationVerdict[] = [];\n      /**\n       * Evidence-backed progress earlier in this step, judged as endStep will judge it: new information, or a\n      text = `The delegated task budget could not be saved durably (${message}); no further delegated inference or tool execution is allowed.`;\n      this.objectiveBudgetPersistenceFailure = text;\n    } else if (kind === \"operation_start\" || kind === \"operation_end\") {\n      text = `Tool operation record (${kind}) could not be written durably (${message}); crash recovery degraded.`;\n    } else if (kind === \"init\") {\n      text = `Initial durable task state was not persisted (${message}); restart recovery is unavailable until a later successful checkpoint.`;\n      this.initialStatePersistenceFailure = text;\n    } else if (kind === \"final_checkpoint\") {\n      text = `The turn's final task state could not be saved: ${message}`;\n    } else {\n      text = `Durable checkpoint (${kind}) could not be saved (${message}); if the process stops, state since last save may be lost.`;\n    }\n    this.turnPersistenceFailures.push(text);\n    try {\n      if (this.observer?.onNotice) this.observer.onNotice(text);\n      else console.warn(pc.yellow(text));\n    } catch {}\n  }\n\n  /** Persist only the shared objective ledger, never the subagent's temporary conversation. */\n  private persistObjectiveBudget(): boolean {\n    if (!this.durable) return true;\n    try {\n      if (!this.stateManager || !this.currentTaskId || !this.objective) throw new Error(\"durable objective state is unavailable\");\n      this.stateManager.recordProgress(this.currentTaskId, { objective: this.objective });\n      return true;\n    } catch (err) {\n      this.reportPersistenceFailure(\"objective_budget\", err);\n      return false;\n    }\n  }\n\n  /** Share the parent's ledger and durable checkpoint with an ephemeral delegated agent. */\n  public inheritObjectiveBudget(parent: AutonomousAgent): void {\n    if (!parent.durable || !parent.objective) return;\n    this.sharedObjectiveBudget = {\n      ledger: parent.objective,\n      persist: () => parent.persistObjectiveBudget(),\n    };\n  }\n\n  /**\n   * Gives every tool call in a recovered conversation a result: a call whose result was never recorded gets a note\n   * that its outcome is unknown. Returns the tools of those calls.\n   */\n  private settleUnrecordedToolCalls(): string[] {\n    let last = -1;\n    for (let i = this.messages.length - 1; i >= 0; i--) {\n      if (this.messages[i].role === \"assistant\" && this.messages[i].tool_calls?.length) {\n        last = i;\n        break;\n      }\n    }\n    if (last < 0) return [];\n    const calls = this.messages[last].tool_calls!;\n    const recorded = this.messages.slice(last + 1).filter((m) => m.role === \"tool\").length;\n    this.runningAsSubagent = true;\n    this.subagentObjective = prompt;\n    // A subagent is used for one run: its commands are tied to the parent turn's cancellation for its lifetime.\n    this.bridge.setTurnSignal(signal);\n    this.resetConversation();\n    this.messages.push({\n      role: \"user\",\n      content: `[Subagent Objective]: ${prompt}\\n\\nPlease inspect, execute tools as needed, and produce a concise, comprehensive report answering the objective. Call task_completed when done.`,\n    });\n\n    const stagnationSteps = this.config.continuation?.stagnationSteps ?? DEFAULT_CONTINUATION.stagnationSteps;\n    const maxRecoveries = this.config.continuation?.maxRecoveries ?? DEFAULT_CONTINUATION.maxRecoveries;\n    const maxTotalSteps = this.config.continuation?.maxTotalSteps ?? this.config.maxSteps;\n    // A subagent consumes the same objective-wide step allowance as its parent. The shared tracking data survives\n    // resume; the subagent's local tracker below is only for its own progress/stagnation decisions.\n    const budgetLedger = this.sharedObjectiveBudget?.ledger ?? (this.durable ? this.objective : undefined);\n    const objectiveTracker = budgetLedger ? trackingOf(budgetLedger) : undefined;\n    const tracker = ExecutionTracker.fresh();\n    tracker.beginTurn();\n    let state = this.workspaceStateIdentity();\n    tracker.noteState(state);\n    let recoveries = 0;\n    let currentStep = 1;\n    let finalSummary = \"\";\n    let previousReplyTruncated = false;\n\n    for (;;) {\n      if (signal?.aborted) return { completed: false, summary: finalSummary, reason: \"cancelled with the parent turn\" };\n      const consumedTaskSteps = objectiveTracker?.data.cumulativeSteps ?? (currentStep - 1);\n      if (consumedTaskSteps >= maxTotalSteps) {\n        return { completed: false, summary: finalSummary, reason: `objective step budget exhausted (${consumedTaskSteps}/${maxTotalSteps}); no further subagent inference was submitted` };\n      }\n      if (tracker.data.stepsWithoutProgress >= stagnationSteps) {\n        const loops = tracker.loops().slice(0, 2).map((r) => `${r.action} ×${r.count}`).join(\"; \");\n        return { completed: false, summary: finalSummary, reason: `no progress for ${tracker.data.stepsWithoutProgress} consecutive steps${loops ? ` (repeated: ${loops})` : \"\"}` };\n      }\n      const cumulativeStep = tracker.beginStep();\n      if (objectiveTracker) {\n        objectiveTracker.beginStep();\n        if (budgetLedger) budgetLedger.continuation.totalSteps = objectiveTracker.data.cumulativeSteps;\n        // The helper runs through this parent agent, so its extra inference steps must be in the durable objective\n        // ledger before any request is sent. Do not persist the helper's temporary message array as the parent chat.\n        const persisted = this.sharedObjectiveBudget ? this.sharedObjectiveBudget.persist() : this.persistObjectiveBudget();\n        if (!persisted) {\n          return { completed: false, summary: finalSummary, reason: \"PERSISTENCE_FAILED: the shared objective budget could not be saved before delegated inference\" };\n        }\n      }\n      let assistantMessage: ChatMessage;\n      const requestId = randomUUID();\n      const { client: activeClient } = this.selectCognitiveClient(currentStep, this.messages);\n      try {\n        await this.admitWithFindings(activeClient, currentStep, requestId, signal);\n        await this.measureAdmission(activeClient, currentStep, requestId, signal);\n        const policy = this.recoveryPolicy ?? recoveryPolicyFromEnv();\n        const lengthGuard = { step: currentStep, cutAfterMs: 0 };\n        assistantMessage = await new ProviderRecoveryController(policy, this.recoveryClock, currentStep, {\n          everSucceeded: typeof activeClient.hasEverSucceeded === \"function\" ? activeClient.hasEverSucceeded() : true,\n          endpoint: activeClient.endpoint,\n        }).run(requestId, {\n          submit: (s) => this.submitGenAiRequest(activeClient, () =>\n            this.submitGuardingLength(lengthGuard, this.messages, (request) =>\n              activeClient.chatCompletion(request, this.getEffectiveTools(), s.requestId, signal))),\n          probe: (probeSignal, opts) =>\n            typeof activeClient.probeAvailability === \"function\"\n              ? activeClient.probeAvailability(probeSignal, { timeoutMs: policy.probeTimeoutMs, ...opts })\n              : Promise.resolve({ available: true, condition: \"AVAILABLE\" as const }),\n          classify: (err) => (err instanceof InferenceError && err.kind !== \"output_truncated\" ? err.toFailure() : null),\n          newRequestId: () => randomUUID(),\n        }, signal);\n      } catch (err: any) {\n        if (signal?.aborted) return { completed: false, summary: finalSummary, reason: \"cancelled with the parent turn\" };\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1f730-5dda-7050-8748-e755b63ef781","create_time":1795156496.9063795}},"metadata":{"history_sequence":14440,"sampled_through_sequence":14437,"client_authored":false,"fallback_token_limit_override":12000}}
