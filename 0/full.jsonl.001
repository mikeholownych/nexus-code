\ntest/objective_continuation.test.ts:127:    assert.equal(trackingOf(ledger).data.cumulativeSteps, 17);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","create_time":1795301920.801396}},"metadata":{"history_sequence":16726,"sampled_through_sequence":16723,"client_authored":false,"fallback_token_limit_override":12000}}
