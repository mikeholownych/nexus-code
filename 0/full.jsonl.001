 = spawn(wrapped.cmd, wrapped.argv, { ...options, env: wrapped.env, stdio: [...stdio, \"pipe\", \"pipe\"] });\n  const control = child.stdio[4];\n  let text = \"\";\n  let cgroup = null;\n  const final = new Promise((resolve) => {\n    child.stdio[3].on(\"data\", (chunk) => {\n      text += chunk.toString(\"utf8\");\n      const reports = parseReports(text);\n      cgroup ??= reports.cgroup;\n      // Close the supervisor's control pipe after its final report. Otherwise the parent write end can\n      // keep ChildProcess's `close` event pending even though the supervised command and scope have exited.\n      if (reports.final && control && !control.destroyed) control.end();\n    });\n    child.stdio[3].on(\"close\", () => resolve(parseReports(text).final));\n    child.on(\"error\", () => resolve(null));\n  });\n  const signal = (name, graceMs = 5000) => {\n    if (name !== \"SIGTERM\" || !Number.isSafeInteger(graceMs) || graceMs < 0 || graceMs > 30_000) {\n      throw new Error(\"contained payload supports SIGTERM with a grace period from 0 to 30000 ms\");\n    }\n    if (!control || control.destroyed || !control.writable) return false;\n    return control.write(`${JSON.stringify({ type: \"signal\", name, graceMs })}\\n`);\n  };\n  let repeat = null;\n  let fallback = null;\n  let childClosed = false;\n  const killPayload = () => { if (cgroup) { try { fs.writeFileSync(path.join(cgroup, \"cgroup.kill\"), \"1\"); } catch {} } };\n  const kill = () => {\n    if (childClosed) { killPayload(); return; }\n    if (repeat) return;\n    // The payload may not have joined its leaf yet, or may fork after a kill: keep emptying the leaf until the\n    // supervisor exits. The supervisor also stops on SIGTERM. One that does not exit loses its report, so the run fails\n    // on containmentProblem; the fallback then kills the supervisor while the repeat keeps emptying the payload leaf.\n    killPayload();\n    try { process.kill(child.pid, \"SIGTERM\"); } catch {}\n    repeat = setInterval(killPayload, 50);\n    fallback = setTimeout(() => { try { process.kill(-child.pid, \"SIGKILL\"); } catch {} }, 10_000);\n    setTimeout(() => clearInterval(repeat), 30_000).unref();\n  };\n  child.on(\"close\", () => { childClosed = true; clearInterval(repeat); clearTimeout(fallback); killPayload(); });\n  return { child, containment: { final, kill, signal } };\n}\n\n/** Why a finished contained execution cannot be trusted as bounded, or null. */\nexport function containmentProblem(final) {\n  if (!final) return \"no containment report from the resource supervisor\";\n  if (final.error) return final.error;\n  if (!final.cleaned) return \"payload cgroup was not emptied\";\n  return null;\n}\n\nfunction parseReports(text) {\n  let cgroup = null;\n  let final = null;\n  for (const line of text.split(\"\\n\")) {\n    if (!line.trim()) continue;\n    let value;\n    try { value = JSON.parse(line); } catch { continue; }\n    if (value.cgroup && Object.keys(value).length === 1) cgroup = value.cgroup;\n    else final = value;\n  }\n  return { cgroup, final };\n}\n    if (lexicalProblem) return lexicalProblem;\n    try { roots.push(fs.realpathSync(lexical)); }\n    catch { return \"candidate runtime allowlist root is unavailable\"; }\n  }\n  let executableFiles;\n  try { executableFiles = allowedFiles.map((item) => fs.realpathSync(item)); }\n  catch { return \"candidate runtime executable is unavailable\"; }\n  for (const root of roots) {\n    const rootProblem = protectedRuntimeRootProblem(root);\n    if (rootProblem) return rootProblem;\n  }\n  for (const item of readOnlyPaths) {\n    if (typeof item !== \"string\" || !path.isAbsolute(item)) return \"candidate runtime paths must be absolute\";\n    let resolved;\n    try { resolved = fs.realpathSync(item); }\n    catch { return `candidate runtime path is unavailable: ${item}`; }\n    const stat = fs.statSync(resolved);\n    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n    const explicitlySelectedTempExecutable = executableFiles.includes(resolved) && stat.isFile() && resolved.startsWith(`/tmp${path.sep}`);\n    if (FORBIDDEN_RUNTIME_ROOTS.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !explicitlySelectedTempExecutable) {\n      return `protected candidate runtime path is forbidden: ${resolved}`;\n    }\n    if (resolved === os.homedir() || (resolved.startsWith(`${os.homedir()}${path.sep}`) && resolved.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part)))) {\n      return `sensitive candidate runtime path is forbidden: ${resolved}`;\n    }\n    if (!stat.isFile() && !stat.isDirectory()) return `candidate runtime path is not a regular file or directory: ${resolved}`;\n    if (!roots.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !executableFiles.includes(resolved)) {\n      return `candidate runtime path is outside its explicit allowlist: ${resolved}`;\n    }\n    if (executableFiles.includes(resolved) && !stat.isFile()) return `candidate runtime executable is not a regular file: ${resolved}`;\n    if (stat.isDirectory()) assertNoSymlinks(resolved);\n  }\n  return null;\n}\n\nfunction protectedRuntimeRootProblem(root) {\n  if (root.startsWith(`${os.homedir()}${path.sep}`) && root.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part))) return `sensitive candidate runtime root is forbidden: ${root}`;\n  if (root === \"/\" || root === \"/home\" || root === os.homedir() || FORBIDDEN_RUNTIME_ROOTS.some((item) => root === item || root.startsWith(`${item}${path.sep}`))) return `protected candidate runtime root is forbidden: ${root}`;\n  return null;\n}\n\nexport function agentSandboxArgv({ cwd, home, proxyDirectory, readOnlyPaths = [], allowedRuntimeRoots = [], runtimeExecutablePaths = [], supervisorPath, protectedCorpusPaths = [] }) {\n  const mountSources = candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths, nodeRuntime: process.execPath, supervisorPath });\n  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n  if (protectedOverlap) throw new Error(protectedOverlap);\n  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing candidate execution\");\n  const mountProblem = runtimeMountProblem(readOnlyPaths, allowedRuntimeRoots, runtimeExecutablePaths);\n  if (mountProblem) throw new Error(mountProblem);\n  if (!mountSources.runtimeSources.cwd || !mountSources.runtimeSources.home || !mountSources.runtimeSources.proxyDirectory || !mountSources.runtimeSources.supervisorPath) {\n    throw new Error(\"candidate sandbox cwd, home, proxyDirectory, and supervisorPath are required mount sources\");\n  }\n  const nodeRuntime = mountSources.runtimeSources.nodeRuntime;\n  if (!fs.statSync(nodeRuntime).isFile() || (fs.statSync(nodeRuntime).mode & 0o111) === 0) {\n    throw new Error(\"trusted evaluator Node.js runtime is unavailable\");\n  }\n  const workspace = mountSources.runtimeSources.cwd;\n\ntest(\"infrastructure reruns use one rule for every agent: a crash after the model answered is scored\", () => {\n  const dir = writeResults([\n    { ...base, agent: \"nexus\", task: \"crash-after-answers\", run: 1, turn: null, model: { requests: 4, answered: 4, upstreamFailures: 0 } },\n    { ...base, agent: \"goose\", task: \"endpoint-down\", run: 1, model: { requests: 3, answered: 0, upstreamFailures: 3 } },\n    { ...base, agent: \"nexus\", task: \"endpoint-down\", run: 1, turn: null, model: { requests: 2, answered: 0, upstreamFailures: 2 } },\n    { ...base, agent: \"opencode\", task: \"slow-but-answered\", run: 1, model: { requests: 5, answered: 3, upstreamFailures: 2 } },\n  ]);\n  const out = spawnSync(process.execPath, [path.join(ROOT, \"eval/infra.mjs\"), dir], { encoding: \"utf8\" });\n  assert.equal(out.status, 0, out.stderr);\n  assert.deepEqual(out.stdout.trim().split(\"\\n\").sort(), [\"endpoint-down 1\", \"endpoint-down 1\"]);\n});\n\ntest(\"contaminated runs leave the pass rate, crashes are counted, and reruns are listed\", () => {\n  const first = writeResults([\n    { ...base, agent: \"nexus\", task: \"a\", run: 1, hiddenPass: true, turn: { outcome: \"VERIFIED\" }, exitCode: 0, tokens: { total: 1000 } },\n    { ...base, agent: \"nexus\", task: \"b\", run: 1, hiddenPass: true, contaminated: true, turn: { outcome: \"VERIFIED\" }, exitCode: 0, tokens: { total: 1000 } },\n    { ...base, agent: \"nexus\", task: \"c\", run: 1, turn: null },\n    { ...base, agent: \"nexus\", task: \"d\", run: 1, error: \"workspace setup failed\" },\n  ]);\n  const rerun = writeResults([{ ...base, agent: \"nexus\", task: \"d\", run: 1, turn: { outcome: \"UNVERIFIED\" }, exitCode: 2, tokens: { total: 1000 } }]);\n  const out = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(first, \"results.jsonl\"), path.join(rerun, \"results.jsonl\"), \"--json\"], { encoding: \"utf8\" });\n  assert.equal(out.status, 0, out.stderr);\n  const score = JSON.parse(out.stdout);\n  const pooled = score.pooled[0];\n  assert.equal(pooled.excludedContaminated, 1);\n  assert.equal(pooled.n, 3, \"the contaminated run is not in the denominator\");\n  assert.equal(pooled.correct, 1, \"the contaminated pass is not counted\");\n  assert.equal(score.totals.crashed, 1, \"a Nexus run without a result is a crash\");\n  assert.equal(pooled.crashRate, 0.25);\n  assert.equal(pooled.tokensPerCorrect, 2000);\n  assert.deepEqual(score.replacements, [{ config: \"c\", task: \"d\", run: 1, was: \"error: workspace setup failed\", now: \"UNVERIFIED\" }]);\n});\n\ntest(\"T4 scoring requires all nine classes and five injected runs per class\", () => {\n  const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"hanging_test_command\", \"full_disk\", \"context_overflow\", \"malformed_tool_json\", \"sigterm_resume\"];\n","exit_code":0,"duration":{"secs":0,"nanos":26964}},"started_at_ms":1793201881736,"completed_at_ms":1793201881737}}
