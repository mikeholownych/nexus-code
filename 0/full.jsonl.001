never fetched or modified. The result is written to a local cache that the snapshot reader\n * prefers (see models_snapshot.ts), and every provider passes the same validation as the bundled snapshot.\n * This mirrors scripts/gen_models_snapshot.mjs without the tool-choice clone step: `api.json` carries no tool-choice\n * data, so the reader keeps the bundled snapshot's modes for models the cache lists without them.\n */\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { parseSnapshot, type ModelsSnapshot, type ProviderPin, type SnapshotModel, type SnapshotProvider } from \"./models_snapshot.js\";\n\nexport const MODELS_API_URL = \"https://models.dev/api.json\";\nconst MAX_API_BYTES = 30 * 1024 * 1024;\n\nconst OPENAI_CHAT_NPM = new Set([\n  \"@ai-sdk/openai-compatible\", \"@ai-sdk/groq\", \"@ai-sdk/mistral\", \"@ai-sdk/xai\", \"@ai-sdk/cerebras\",\n  \"@ai-sdk/togetherai\", \"@ai-sdk/perplexity\", \"@ai-sdk/deepinfra\", \"@openrouter/ai-sdk-provider\",\n]);\n\nexport function modelsCachePath(home = process.env.HOME || os.homedir()): string {\n  return path.join(home, \".cache/nexus/models-snapshot.json\");\n}\n\nconst protocolClass = (npm: unknown): string =>\n  OPENAI_CHAT_NPM.has(String(npm)) ? \"openai-chat\" : npm === \"@ai-sdk/openai\" ? \"openai-responses\" : npm === \"@ai-sdk/anthropic\" ? \"anthropic-messages\" : `native:${String(npm)}`;\nconst num = (v: unknown): number | undefined => (typeof v === \"number\" && Number.isFinite(v) && v >= 0 ? v : undefined);\nconst cmp = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);\n\nfunction keepModel(m: any): boolean {\n  if (m?.type !== undefined && m.type !== \"chat\") return false;\n  if (m?.tool_call !== true) return false;\n  if (m.status === \"deprecated\" || m.status === \"alpha\") return false;\n  if (typeof m.provider?.api === \"string\" && !/^https?:/.test(m.provider.api)) return false;\n  return typeof m.id === \"string\";\n}\n\nfunction buildModel(m: any): SnapshotModel {\n  const out: SnapshotModel = { id: m.id, context: num(m.limit?.context) ?? 0, output: num(m.limit?.output) ?? 0, toolCall: true, reasoning: m.reasoning === true };\n  const input = num(m.limit?.input);\n  if (input !== undefined) out.input = input;\n  const effort = (Array.isArray(m.reasoning_options) ? m.reasoning_options : []).find((o: any) => o?.type === \"effort\" && Array.isArray(o.values))?.values;\n  if (Array.isArray(effort) && effort.length && effort.every((v: unknown) => typeof v === \"string\")) out.effort = [...effort];\n  const pin = num(m.cost?.input);\n  const pout = num(m.cost?.output);\n  if (pin !== undefined && pout !== undefined) out.price = { input: pin, output: pout };\n  return out;\n}\n\n/** Convert a models.dev `api.json` document; providers failing validation are dropped and listed in `rejected`. */\nexport function snapshotFromApi(api: unknown, date: string, pins: Record<string, ProviderPin>): { snapshot: ModelsSnapshot; rejected: string[] } {\n  if (!api || typeof api !== \"object\" || Array.isArray(api)) throw new Error(\"models.dev data is not an object of providers\");\n  const providers: SnapshotProvider[] = Object.keys(api).sort(cmp).map((key) => {\n    const p = (api as Record<string, any>)[key] ?? {};\n    const id = typeof p.id === \"string\" ? p.id : key;\n    const entry: SnapshotProvider = { id, name: p.name, env: Array.isArray(p.env) ? [...p.env] : [], protocol: protocolClass(p.npm), models: [] };\n    const pin = Object.hasOwn(pins, id) ? pins[id] : undefined;\n    if (typeof p.api === \"string\" && p.api) entry.baseUrl = p.api;\n    else if (pin?.defaultBaseUrl && entry.protocol === \"openai-chat\") entry.baseUrl = pin.defaultBaseUrl;\n    if (entry.baseUrl && (entry.baseUrl.startsWith(\"${\") || (entry.baseUrl.split(\"://\")[1] ?? \"\").split(/[/?#]/)[0]!.includes(\"${\"))) entry.hostFromEnv = true;\n    if (!entry.baseUrl && entry.protocol === \"openai-chat\") entry.needsBaseUrl = true;\n    entry.models = Object.values(p.models ?? {}).filter(keepModel).sort((a: any, b: any) => cmp(a.id, b.id)).map(buildModel);\n    return entry;\n  });\n  return parseSnapshot({ date, license: \"MIT\", source: MODELS_API_URL, providers }, pins);\n}\n\nexport interface RefreshResult {\n  file: string;\n  date: string;\n  providers: number;\n  models: number;\n  rejected: string[];\n}\n\n/** The response body as text, refusing more than `maxBytes` bytes: by the declared length first, then while reading, so an oversized body is never held whole. */\nasync function readCapped(res: Response, maxBytes: number): Promise<string> {\n  const declared = Number(res.headers.get(\"content-length\"));\n  if (Number.isFinite(declared) && declared > maxBytes) throw new Error(\"models.dev data is larger than the 30 MiB limit\");\n  if (!res.body) {\n    const text = await res.text();\n    if (Buffer.byteLength(text) > maxBytes) throw new Error(\"models.dev data is larger than the 30 MiB limit\");\n    return text;\n  }\n  const chunks: Buffer[] = [];\n  let total = 0;\n  const reader = res.body.getReader();\n  for (;;) {\n    const { done, value } = await reader.read();\n    if (done) break;\n    total += value.byteLength;\n    if (total > maxBytes) {\n      await reader.cancel();\n      throw new Error(\"models.dev data is larger than the 30 MiB limit\");\n    }\n    chunks.push(Buffer.from(value));\n  }\n  return Buffer.concat(chunks).toString(\"utf8\");\n}\n\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\n\nexport interface SnapshotModel {\n  id: string;\n  context: number;\n  output: number;\n  input?: number;\n  toolCall: boolean;\n  toolChoice?: string[];\n  reasoning: boolean;\n  effort?: string[];\n  price?: { input: number; output: number };\n}\n\nexport interface SnapshotProvider {\n  id: string;\n  name: string;\n  env: string[];\n  protocol: string;\n  /** Absent means unresolvable from the snapshot: a native protocol, or `needsBaseUrl` (the operator must supply it). */\n  baseUrl?: string;\n  /** The base URL takes its host (or all of itself) from an env variable: validate it after substitution. */\n  hostFromEnv?: true;\n  needsBaseUrl?: true;\n  models: SnapshotModel[];\n}\n\nexport interface ModelsSnapshot {\n  date: string;\n  commit?: string;\n  license: string;\n  source: string;\n  providers: SnapshotProvider[];\n}\n\nexport interface ProviderPin {\n  suffixes: string[];\n  defaultBaseUrl?: string;\n  source: string;\n}\n\nexport type ToolChoiceMode = \"auto\" | \"none\" | \"required\" | \"tool\";\n\nconst ENV_NAME = /^[A-Z0-9][A-Z0-9_]{1,63}$/;\nconst ENV_DENY = /^AWS_|^GOOGLE_APPLICATION_CREDENTIALS$|_SSH|^GITHUB_TOKEN$/;\nconst ENV_DENY_ALLOWED = new Set([\"amazon-bedrock\", \"google-vertex\", \"google-vertex-anthropic\", \"github-copilot\"]);\nconst LOOPBACK = new Set([\"localhost\", \"127.0.0.1\", \"[::1]\"]);\n\nconst unsafeId = (id: unknown, max: number): boolean =>\n  typeof id !== \"string\" || !id || id.length > max || id.includes(\"..\") || id.startsWith(\"/\") || id.includes(\"\\0\");\n\n/** Reasons a provider entry is refused (empty when it is acceptable). Mirrors scripts/gen_models_snapshot.mjs. */\nexport function providerViolations(p: SnapshotProvider, pins: Record<string, ProviderPin>): string[] {\n  const out: string[] = [];\n  if (typeof p?.id !== \"string\" || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(p.id) || p.id.includes(\"..\")) out.push(\"id\");\n  if (typeof p?.name !== \"string\" || !p.name || p.name.length > 200) out.push(\"name\");\n  if (typeof p?.protocol !== \"string\" || !(/^(openai-chat|openai-responses|anthropic-messages)$/.test(p.protocol) || /^native:.{1,200}$/.test(p.protocol))) out.push(\"protocol\");\n  const env = Array.isArray(p?.env) ? p.env : [];\n  if (!Array.isArray(p?.env)) out.push(\"env\");\n  for (const e of env) {\n    if (typeof e !== \"string\" || !ENV_NAME.test(e)) out.push(\"env name\");\n    else if (ENV_DENY.test(e) && !ENV_DENY_ALLOWED.has(p.id)) out.push(`env name ${e} not allowed`);\n  }\n  const pin = Object.hasOwn(pins, p?.id) ? pins[p.id] : undefined;\n  if (p?.baseUrl !== undefined) {\n    const url = p.baseUrl;\n    if (typeof url !== \"string\" || /[\\s\\u0000-\\u001f]/.test(url)) out.push(\"baseUrl\");\n    else {\n      for (const m of url.matchAll(/\\$\\{([^}]*)\\}/g)) if (!env.includes(m[1]!)) out.push(\"baseUrl variable not in env\");\n      const fromEnv = url.startsWith(\"${\") || (url.split(\"://\")[1] ?? \"\").split(/[/?#]/)[0]!.includes(\"${\");\n      if (fromEnv !== (p.hostFromEnv === true)) out.push(\"hostFromEnv mismatch\");\n      if (url.startsWith(\"${\")) {\n        if (!/^\\$\\{[A-Z0-9_]+\\}(\\/[^$]*)?$/.test(url)) out.push(\"baseUrl template\");\n      } else {\n        try {\n          const u = new URL(url.replace(/\\$\\{[^}]*\\}/g, \"placeholder\"));\n          if (!(u.protocol === \"https:\" || (u.protocol === \"http:\" && LOOPBACK.has(u.hostname)))) out.push(\"baseUrl scheme\");\n          if (u.username || u.password) out.push(\"baseUrl credentials\");\n          if (pin && !fromEnv && !pin.suffixes.some((s) => u.hostname === s || u.hostname.endsWith(`.${s}`))) out.push(\"baseUrl leaves pinned host\");\n        } catch {\n          out.push(\"baseUrl does not parse\");\n        }\n      }\n    }\n  } else if (p?.hostFromEnv !== undefined) out.push(\"hostFromEnv without baseUrl\");\n  if (pin && p.hostFromEnv) out.push(\"pinned provider takes its host from env\");\n  return out;\n}\n\n/** Keeps only provider entries that pass `providerViolations`; the rest are listed in `rejected`. Never throws. */\nexport function parseSnapshot(raw: unknown, pins: Record<string, ProviderPin>): { snapshot: ModelsSnapshot; rejected: string[] } {\n  const r = (raw ?? {}) as Partial<ModelsSnapshot>;\n  const rejected: string[] = [];\n  const providers: SnapshotProvider[] = [];\n  const seen = new Set<string>();\n  for (const p of Array.isArray(r.providers) ? r.providers : []) {\n    const bad = providerViolations(p, pins);\n    if (!bad.length && seen.has(p.id)) bad.push(\"duplicate\");\n        return answer;\n      } catch (err) {\n        if (signal?.aborted || (err instanceof InferenceError && err.kind === \"aborted\")) throw err;\n        this.emitDiagnostic(\"error\", pc.dim(`[nexus] Asking ${this.conn.label} again for a native tool call failed (${err instanceof Error ? err.message : String(err)}); keeping its first reply.`));\n        return undefined;\n      }\n    };\n    const finish = (message: ChatMessage): ChatMessage => {\n      this.lastUsageReport = sumUsage(usages);\n      return message;\n    };\n    this.emitDiagnostic(\"error\", pc.dim(`[nexus] ${this.conn.label} answered a tool request with the call as text; telling it so and asking again.`));\n    const noted = await ask(\"auto\");\n    if (!noted) return finish(response);\n    if (noted.tool_calls?.length) return finish({ ...noted, toolCallSource: \"feedback\" });\n    if (!isContentCallReply(noted, tools, messages)) {\n      if (typeof noted.content !== \"string\" || !noted.content.trim()) return finish(response);\n      onToken?.(`\\n\\n${noted.content}`);\n      return finish(noted);\n    }\n    // A model whose listed tool-choice modes exclude `required` would answer a forced request with an error: the\n    // corrective note above was the only re-ask it can take. \"unknown\" (no data) keeps the forced request.\n    if (this.conn.providerId && acceptsToolChoice(this.conn.providerId, this.model, \"required\") === false) {\n      this.emitDiagnostic(\"error\", pc.dim(`[nexus] ${this.conn.label} lists no tool_choice=required for ${this.model}; keeping its reply.`));\n      return finish(response);\n    }\n    this.emitDiagnostic(\"error\", pc.dim(`[nexus] ${this.conn.label} wrote the call as text again; asking once more with tool_choice=required.`));\n    const forced = await ask(\"required\");\n    if (forced && !forced.tool_calls?.length && !this.warnedToolCallTextOnly) {\n      this.warnedToolCallTextOnly = true;\n      this.emitDiagnostic(\"warn\", pc.yellow(`[nexus] ${this.conn.label} (${this.model}) did not return a native tool call even when one was required; call-like text is never executed. Check that the selected model or server supports tool calls.`));\n    }\n    return finish(forced?.tool_calls?.length ? { ...forced, toolCallSource: \"required\" } : response);\n  }\n\n  private async chatCompletionOnce(messages: ChatMessage[], tools: ToolDefinition[], requestId: string, signal?: AbortSignal, toolChoice: \"auto\" | \"required\" = \"auto\"): Promise<ChatMessage> {\n    if (wireProtocol(this.conn.protocol).native) return this.nativeCompletion(messages, tools, undefined, requestId, signal, this.conn.streamOnly);\n    if (this.conn.streamOnly) return this.chatCompletionStreamOnce(messages, tools, undefined, requestId, signal);\n    return this.executeWithFailover(\"chatCompletion\", async (currentEp) => {\n      if (signal?.aborted) throw abortedError(requestId);\n      const url = this.endpointUrl(currentEp, \"/chat/completions\");\n      await this.prepareCredential(currentEp, requestId);\n      this.preflight(currentEp, requestId, JSON.stringify(messages).length + JSON.stringify(tools).length);\n\n      // 1. Egress Interception & Quarantine (DISC-001..003, CTX-006, FAIL-003)\n      const egressEvaluation = this.boundary.evaluateEgress(\n        messages,\n        currentEp,\n        {\n          taskId: this.taskId,\n          sessionId: this.sessionId,\n","exit_code":0,"duration":{"secs":0,"nanos":32947}},"started_at_ms":1795147094936,"completed_at_ms":1795147094937}}
