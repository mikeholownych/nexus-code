{"timestamp":"2026-11-21T21:51:53.310Z","ordinal":35774,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20014-b98e-7f50-9b44-1c38f2a1201a","item":{"type":"CommandExecution","id":"exec-e738be2b-c24e-4d38-98eb-e1cd696231a0","process_id":"65227","command":["/usr/bin/zsh","-lc","git show origin/main:cli/test/helpers/fixtures.ts | sed -n '1,235p'; git show origin/main:cli/test/objective_continuation.test.ts | sed -n '1,275p'; git show origin/main:cli/src/core/agent_support.ts 2>/dev/null | rg -n 'SubagentResult' -C3"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git show origin/main:cli/test/helpers/fixtures.ts | sed -n '1,235p'; git show origin/main:cli/test/objective_continuation.test.ts | sed -n '1,275p'; git show origin/main:cli/src/core/agent_support.ts 2>/dev/null | rg -n 'SubagentResult' -C3"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import { test } from \"node:test\";\nimport http from \"node:http\";\nimport type { Socket } from \"node:net\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execSync, spawnSync } from \"node:child_process\";\nimport { trackResource } from \"./leak_registry.js\";\n\nexport type Reply =\n  /** `truncated`: the reply hits the output limit (finish_reason=length) partway through its tool calls' arguments. */\n  | { kind: \"tools\"; calls: Array<{ name: string; args: unknown; id?: string }>; content?: string; delayMs?: number; truncated?: boolean }\n  /** `chunks`: stream the text in these pieces, `gapMs` apart (the default sends it in one delta). `truncated`: finish_reason=length. */\n  | { kind: \"text\"; content: string; delayMs?: number; chunks?: string[]; gapMs?: number; truncated?: boolean }\n  | { kind: \"http\"; status: number; body?: string; delayMs?: number };\n\nexport interface Gateway {\n  url: string;\n  requests: unknown[];\n  /** Bodies of /tokenize requests (only with `options.tokenize`). */\n  tokenizeRequests: any[];\n  /** Number of GET /models requests served. */\n  modelRequests: number;\n  /** Authorization headers seen, per path kind. */\n  authSeen: Array<{ path: string; authorization?: string }>;\n  close(): Promise<void>;\n}\n\n/** Optional gateway capabilities (homelab-ai contract shape): catalog entries, request counting, admission headers. */\nexport interface GatewayOptions {\n  /** `data` entries for GET /models (default: [{ id: \"m\" }]). Called per request, so tests can change capacity. */\n  models?: () => any[];\n  /** Answer to POST /tokenize; absent: 404. */\n  tokenize?: (body: any, n: number) => { status: number; body: unknown; delayMs?: number };\n  /** Response headers for the n-th chat request (e.g. X-AIHost-* admission headers). */\n  headers?: (n: number, body: any) => Record<string, string>;\n}\n\nfunction sse(obj: unknown): string {\n  return `data: ${JSON.stringify(obj)}\\n\\n`;\n}\n\n/** A tool call's arguments as sent: whole, or cut off partway like a reply that hit the output limit. */\nfunction wireArguments(args: unknown, truncated?: boolean): string {\n  const json = JSON.stringify(args);\n  return truncated ? json.slice(0, Math.max(1, Math.floor(json.length / 2))) : json;\n}\n\nfunction finishReason(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  return r.truncated ? \"length\" : r.kind === \"tools\" ? \"tool_calls\" : \"stop\";\n}\n\nfunction streamBody(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  let out = \"\";\n  if (r.kind === \"text\") out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n  else {\n    if (r.content) out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n    r.calls.forEach((c, i) => {\n      out += sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: i, id: c.id ?? `call_${i}_${Math.random().toString(36).slice(2, 7)}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } }] } }] });\n    });\n  }\n  out += sse({ choices: [{ index: 0, delta: {}, finish_reason: finishReason(r) }] });\n  return out + \"data: [DONE]\\n\\n\";\n}\n\n/** Deterministic OpenAI-compatible gateway. `script(n, body)` decides the reply to the n-th chat request (1-based). */\nexport async function startGateway(script: (n: number, body?: any) => Reply, options: GatewayOptions = {}): Promise<Gateway> {\n  const requests: unknown[] = [];\n  const tokenizeRequests: any[] = [];\n  const authSeen: Array<{ path: string; authorization?: string }> = [];\n  let modelRequests = 0;\n  const sockets = new Set<Socket>();\n  const server = http.createServer((req, res) => {\n    authSeen.push({ path: req.url ?? \"\", authorization: req.headers.authorization });\n    if (req.url?.endsWith(\"/models\")) {\n      modelRequests++;\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ data: options.models ? options.models() : [{ id: \"m\" }] }));\n      return;\n    }\n    if (req.url?.endsWith(\"/tokenize\")) {\n      let raw = \"\";\n      req.on(\"data\", (c) => (raw += c));\n      req.on(\"end\", () => {\n        let body: any = {};\n        try { body = JSON.parse(raw); } catch {}\n        tokenizeRequests.push(body);\n        if (!options.tokenize) {\n          res.statusCode = 404;\n          res.end(JSON.stringify({ status: \"not_found\", message: \"no tokenize\" }));\n          return;\n        }\n        const answer = options.tokenize(body, tokenizeRequests.length);\n        const send = () => {\n          if (res.writableEnded || res.destroyed) return;\n          res.statusCode = answer.status;\n          res.setHeader(\"content-type\", \"application/json\");\n          res.end(typeof answer.body === \"string\" ? answer.body : JSON.stringify(answer.body));\n        };\n        if (answer.delayMs) setTimeout(send, answer.delayMs); else send();\n      });\n      return;\n    }\n    let raw = \"\";\n    req.on(\"data\", (c) => (raw += c));\n    req.on(\"end\", () => {\n      let body: any = {};\n      try { body = JSON.parse(raw); } catch {}\n      requests.push(body);\n      const extraHeaders = options.headers ? options.headers(requests.length, body) : {};\n      for (const [k, v] of Object.entries(extraHeaders)) res.setHeader(k, v);\n      const r = script(requests.length, body);\n      const respond = () => {\n        if (res.writableEnded || res.destroyed) return;\n        if (r.kind === \"http\") {\n          res.statusCode = r.status;\n          res.end(r.body ?? \"{}\");\n        } else if (body.stream && r.kind === \"text\" && r.chunks?.length) {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          const pieces = [...r.chunks];\n          const next = () => {\n            if (res.writableEnded || res.destroyed) return;\n            const piece = pieces.shift();\n            if (piece === undefined) {\n              res.end(sse({ choices: [{ index: 0, delta: {}, finish_reason: \"stop\" }] }) + \"data: [DONE]\\n\\n\");\n              return;\n            }\n            res.write(sse({ choices: [{ index: 0, delta: { content: piece } }] }));\n            setTimeout(next, r.gapMs ?? 50);\n          };\n          next();\n        } else if (body.stream) {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          res.end(streamBody(r));\n        } else {\n          res.setHeader(\"content-type\", \"application/json\");\n          const message = r.kind === \"text\"\n            ? { role: \"assistant\", content: r.content }\n            : { role: \"assistant\", content: r.content ?? null, tool_calls: r.calls.map((c, i) => ({ id: c.id ?? `call_${i}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } })) };\n          res.end(JSON.stringify({ choices: [{ index: 0, message, finish_reason: r.truncated ? \"length\" : \"stop\" }] }));\n        }\n      };\n      if (r.delayMs) setTimeout(respond, r.delayMs); else respond();\n    });\n  });\n  server.on(\"connection\", (s) => { sockets.add(s); s.on(\"close\", () => sockets.delete(s)); });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", () => resolve()));\n  const port = (server.address() as any).port;\n  trackResource(\"gateway\", `scripted gateway on port ${port} not closed`, () => server.listening, () => close());\n  const close = async () => {\n    for (const s of sockets) s.destroy();\n    await new Promise<void>((resolve) => server.close(() => resolve()));\n  };\n  return {\n    url: `http://127.0.0.1:${port}/v1`,\n    requests,\n    tokenizeRequests,\n    get modelRequests() {\n      return modelRequests;\n    },\n    authSeen,\n    close,\n  };\n}\n\n/** Temporary git repository with one committed file. */\nexport function makeRepo(files: Record<string, string> = {}): string {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-sidecar-\"));\n  fs.writeFileSync(path.join(repo, \"base.txt\"), \"base\\n\");\n  for (const [name, content] of Object.entries(files)) {\n    const full = path.join(repo, name);\n    fs.mkdirSync(path.dirname(full), { recursive: true });\n    fs.writeFileSync(full, content);\n  }\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm base\", { cwd: repo, stdio: \"ignore\" });\n  return repo;\n}\n\nexport function makeHome(): string {\n  return fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-home-\"));\n}\n\n/** Seed an isolated HOME with explicit trust for a PTY test that needs to reach the REPL. */\nexport function trustWorkspace(home: string, workspace: string): void {\n  const trustDir = path.join(home, \".config\", \"nexus\");\n  fs.mkdirSync(trustDir, { recursive: true, mode: 0o700 });\n  fs.writeFileSync(\n    path.join(trustDir, \"trusted_workspaces.json\"),\n    JSON.stringify({ trustedPaths: [fs.realpathSync(workspace)] }, null, 2),\n    { mode: 0o600 },\n  );\n}\n\nexport async function waitUntil(cond: () => boolean, timeoutMs = 10000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (!cond()) {\n    if (Date.now() > deadline) throw new Error(\"timed out\");\n    await new Promise((r) => setTimeout(r, 10));\n  }\n}\n\n/**\n * True once `pid` has terminated. A zombie counts as terminated: under a PID 1 that does not reap (some containers), a\n * killed process stays a zombie, and `kill(pid, 0)` still succeeds on it.\n */\nexport function processGone(pid: number): boolean {\n  try {\n    process.kill(pid, 0);\n  } catch (error: unknown) {\n    return (error as NodeJS.ErrnoException)?.code === \"ESRCH\";\n  }\n  // The process exists or is a zombie. `ps -p` exits 1 with no output once the pid is gone; if ps cannot run, the\n  // process is not proven gone.\n  const ps = spawnSync(\"ps\", [\"-o\", \"stat=\", \"-p\", String(pid)], { encoding: \"utf8\" });\n  if (ps.error || (ps.status !== 0 && ps.status !== 1)) return false;\n  const stat = ps.stdout.trim();\n  return stat === \"\" || stat.startsWith(\"Z\");\n}\n\nexport async function waitForEvent(events: any[], pred: (e: any) => boolean, timeoutMs = 10000): Promise<any> {\n  try {\n    await waitUntil(() => events.some(pred), timeoutMs);\n  } catch {\n    throw new Error(`timed out waiting for event; saw: ${events.map((e) => e.type).join(\", \")}`);\n  }\n  return events.find(pred);\n}\n\n/**\n * Pseudo-terminal scenarios measure timing (spinner frames, idle redraws, approval grace) and drive real processes;\n * run concurrently by the test runner they starve each other and keys arrive late. `ptyTest` holds a cross-process\n * lock (a directory under the system temp dir, taken over when its owner is gone) so they run one at a time.\n */\nexport async function acquirePtyLock(timeoutMs = 15 * 60_000): Promise<() => void> {\n  const dir = path.join(os.tmpdir(), \"nexus-pty-test.lock\");\n/**\n * Continuation past the per-segment step limit, bounded stopping, acceptance requirements, verifier attempts and\n * steering at the agent layer. Every scenario runs the real agent loop against a deterministic local gateway.\n *\n * Evidence session: nexus-session-session_20261011_162349_6lvu.json — the objective ended at step 30 (STEP LIMIT\n * REACHED), the operator had to type \"continue\", the original request survived only as a truncatable compaction note,\n * and task_completed re-ran the same failing `make test` twice on unchanged inputs.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { DEFAULT_CONTINUATION, HarnessConfig, MAX_CONTINUATION_MINUTES, MAX_CONTINUATION_STEPS } from \"../src/types.js\";\nimport { startGateway, makeRepo, Reply } from \"./helpers/fixtures.js\";\nimport { createLedger, seedRequirements, applyRequirementUpdates, isNewObjective, failedCheckFrom, renderPinnedLedger, acceptDescoping, requirementDone, readObjective, invalidateVerified, queueSteering, amendObjective, trackingOf } from \"../src/core/objective.js\";\nimport { stableToolCallId, redactTaskStateForPersistence } from \"../src/core/persistence_protection.js\";\nimport { SessionManager } from \"../src/session.js\";\nimport { WorkspacePath } from \"../src/core/workspace_path.js\";\n\nimport { requirementRows as require_rows } from \"../src/core/objective.js\";\nconst quiet = (agent: AutonomousAgent) => {\n  (agent as any).ui = new Proxy({}, { get: () => () => {} });\n  return agent;\n};\nconst cfg = (endpoint: string, workspace: string, o: Partial<HarnessConfig> = {}): HarnessConfig => ({\n  endpoint,\n  model: \"m\",\n  maxSteps: 30,\n  temperature: 0,\n  workspace,\n  shell: \"bash\",\n  approvalMode: \"auto\",\n  fullAccess: true,\n  ...o,\n});\nconst write = (name: string, content = `${name}\\n`): Reply => ({ kind: \"tools\", calls: [{ name: \"write_file\", args: { path: name, content } }] });\nconst read = (name: string): Reply => ({ kind: \"tools\", calls: [{ name: \"read_file\", args: { path: name } }] });\nconst text = (content: string): Reply => ({ kind: \"text\", content });\n/** Resolves once the agent's turn is running inference (extension start-up can delay it). */\nasync function inferring(agent: AutonomousAgent, timeoutMs = 20_000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (agent.getTurnLifecycle()?.phase !== \"inference\") {\n    if (Date.now() > deadline) throw new Error(\"the turn never reached inference\");\n    await new Promise((r) => setTimeout(r, 5));\n  }\n}\nconst userMessages = (body: any) => (body.messages as any[]).filter((m) => m.role === \"user\").map((m) => String(m.content));\nconst systemText = (body: any) => (body.messages as any[]).filter((m) => m.role === \"system\").map((m) => String(m.content)).join(\"\\n\");\n\ndescribe(\"continuation beyond the per-segment step limit\", () => {\n  test(\"automatic continuation has finite default step and invocation time ceilings\", () => {\n    assert.equal(DEFAULT_CONTINUATION.maxTotalSteps, 500);\n    assert.equal(DEFAULT_CONTINUATION.maxTurnMinutes, 480);\n    assert.ok(Number.isFinite(DEFAULT_CONTINUATION.maxTotalSteps));\n    assert.ok(Number.isFinite(DEFAULT_CONTINUATION.maxTurnMinutes));\n  });\n\n  test(\"legacy objective continuation counts are not reset when the execution tracker is missing or stale\", () => {\n    const ledger = createLedger(\"Continue the existing task.\");\n    ledger.continuation.totalSteps = 17;\n    delete ledger.execution;\n    assert.equal(trackingOf(ledger).data.cumulativeSteps, 17);\n\n    ledger.execution!.cumulativeSteps = 9;\n    assert.equal(trackingOf(ledger).data.cumulativeSteps, 17);\n  });\n\n  test(\"direct agent construction rejects step or time limits above the hard ceilings\", () => {\n    const repo = makeRepo();\n    try {\n      assert.throws(\n        () => new AutonomousAgent(cfg(\"http://127.0.0.1:9/v1\", repo, { continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: MAX_CONTINUATION_STEPS + 1 } })),\n        /expected an integer from 1 to 5000/,\n      );\n      assert.throws(\n        () => new AutonomousAgent(cfg(\"http://127.0.0.1:9/v1\", repo, { continuation: { ...DEFAULT_CONTINUATION, maxTurnMinutes: MAX_CONTINUATION_MINUTES + 1 } })),\n        /expected a finite value from 1 second to 4320 minutes/,\n      );\n    } finally {\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"a progressing task runs past 30 steps without the operator typing continue\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway((n) => (n <= 34 ? write(`f${n}.txt`) : text(\"All files written.\")));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, { continuation: { ...DEFAULT_CONTINUATION } })));\n    try {\n      const turn = await agent.runTurn(\"Write files f1.txt through f34.txt, one per step.\");\n      assert.equal(turn.execution, \"COMPLETED\", JSON.stringify(turn));\n      assert.equal(turn.steps.used, 35);\n      assert.equal(turn.steps.limitReached, false);\n      assert.equal(turn.continuation?.segments, 2, \"step 31 begins the second segment\");\n      assert.equal(gw.requests.length, 35);\n      assert.ok(fs.existsSync(path.join(repo, \"f34.txt\")));\n      // No \"continue\" was typed or injected: the only user message is the operator's own.\n      const last = gw.requests[34] as any;\n      assert.deepEqual(userMessages(last).map((m) => m.split(\"\\n\")[0]), [\"Write files f1.txt through f34.txt, one per step.\"]);\n      assert.match(systemText(last), /Continuation: segment 2 of this turn/);\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"without a continuation budget the same task still ends at the segment limit (legacy single-segment turn)\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway((n) => (n <= 34 ? write(`f${n}.txt`) : text(\"done\")));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo)));\n    try {\n      const turn = await agent.runTurn(\"Write files f1.txt through f34.txt, one per step.\");\n      assert.equal(turn.execution, \"LIMIT_REACHED\");\n      assert.equal(turn.reason, \"STEP_LIMIT_REACHED\");\n      assert.equal(gw.requests.length, 30);\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"a stuck task stops boundedly: recovery notes, then STAGNATION_DETECTED\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway(() => read(\"base.txt\"));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, { continuation: { ...DEFAULT_CONTINUATION, stagnationSteps: 50, maxRecoveries: 2 } })));\n    try {\n      const turn = await agent.runTurn(\"Inspect base.txt.\");\n      assert.equal(turn.execution, \"LIMIT_REACHED\");\n      assert.equal(turn.reason, \"STAGNATION_DETECTED\");\n      // v1.1.2: after the second note recovery is constrained; the repeats are refused before they run, and the turn\n      // stops when the refusals are used up.\n      assert.match(turn.detail ?? \"\", /recovery exhausted after 2 recovery notes: \\d+ equivalent observation\\(s\\) refused on an unchanged workspace/);\n      const refused = agent.getMessages().filter((m: any) => m.role === \"tool\" && String(m.content).startsWith(\"[Nexus refused: not executed]\"));\n      assert.ok(refused.length >= 2, `refused repeats: ${refused.length}`);\n      assert.ok(gw.requests.length <= 10, `bounded: ${gw.requests.length} requests`);\n      const notes = userMessages(gw.requests[gw.requests.length - 1]).filter((m) => m.startsWith(\"[Nexus recovery\"));\n      assert.equal(notes.length, 2, \"two bounded recovery notes before stopping\");\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"no progress for the configured window ends the turn with STAGNATION_DETECTED\", { timeout: 60_000 }, async () => {\n    // Alternating reads of two unchanging files: never the same call three times in a row, never new information.\n    const gw = await startGateway((n) => read(n % 2 ? \"base.txt\" : \"other.txt\"));\n    const repo = makeRepo({ \"other.txt\": \"other\\n\" });\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, { continuation: { ...DEFAULT_CONTINUATION, stagnationSteps: 4, maxRecoveries: 10 } })));\n    try {\n      const turn = await agent.runTurn(\"Inspect the two files.\");\n      assert.equal(turn.reason, \"STAGNATION_DETECTED\", JSON.stringify(turn));\n      assert.match(turn.detail ?? \"\", /4 consecutive steps without progress/);\n      assert.ok(gw.requests.length <= 8, `bounded: ${gw.requests.length}`);\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"the total step budget ends a long task with STEP_BUDGET_EXHAUSTED and its segment count\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway((n) => write(`g${n}.txt`));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, { maxSteps: 5, continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: 12 } })));\n    try {\n      const turn = await agent.runTurn(\"Keep writing files.\");\n      assert.equal(turn.execution, \"LIMIT_REACHED\");\n      assert.equal(turn.reason, \"STEP_BUDGET_EXHAUSTED\");\n      assert.equal(turn.steps.used, 12);\n      assert.equal(turn.steps.max, 12);\n      assert.equal(turn.continuation?.segments, 3);\n      assert.equal(gw.requests.length, 12);\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"the total step budget is shared by durable resume instead of resetting per invocation\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway((n) => write(`resume-${n}.txt`));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, {\n      maxSteps: 30,\n      continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: 2 },\n    })));\n    try {\n      const first = await agent.runTurn(\"Keep writing distinct files.\");\n      assert.equal(first.reason, \"STEP_BUDGET_EXHAUSTED\");\n      assert.equal(first.steps.used, 2);\n      assert.equal(gw.requests.length, 2);\n\n      const resumed = await agent.runTurn(\"\", undefined, { resume: true });\n      assert.equal(resumed.execution, \"LIMIT_REACHED\");\n      assert.equal(resumed.reason, \"STEP_BUDGET_EXHAUSTED\");\n      assert.equal(gw.requests.length, 2, \"resume at an exhausted budget submits no new inference request\");\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"a delegated helper consumes only the parent's remaining durable steps\", { timeout: 60_000 }, async () => {\n    let writes = 0;\n    const gw = await startGateway((_n, body) => {\n      const subagent = (body.messages as any[]).some((message) => typeof message.content === \"string\" && message.content.includes(\"[Subagent Objective]\"));\n      if (!subagent) return { kind: \"tools\", calls: [{ name: \"spawn_subagent\", args: { prompt: \"write until stopped\", profile: \"implementer\" } }] };\n      return write(`shared-${++writes}.txt`);\n    });\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, {\n      worktree: true,\n      continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: 3 },\n    })));\n    try {\n      const turn = await agent.runTurn(\"Delegate an open-ended sequence of writes.\");\n      assert.equal(turn.execution, \"LIMIT_REACHED\");\n      assert.equal(turn.reason, \"STEP_BUDGET_EXHAUSTED\");\n      assert.equal(turn.steps.used, 3);\n      assert.equal(agent.getObjective()!.execution!.cumulativeSteps, 3);\n      assert.equal(gw.requests.length, 3, \"one parent request and exactly two delegated requests consumed the budget\");\n      assert.equal(writes, 2);\n      const workspace = agent.getActiveWorktree()?.worktreePath ?? repo;\n      assert.ok(fs.existsSync(path.join(workspace, \"shared-1.txt\")));\n      assert.ok(fs.existsSync(path.join(workspace, \"shared-2.txt\")));\n    } finally {\n      if (agent.getActiveWorktree()) agent.discardActiveWorktree();\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"a delegated inference is not sent when saving its shared budget fails\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway((n) => n === 1\n      ? { kind: \"tools\", calls: [{ name: \"spawn_subagent\", args: { prompt: \"write a child file\" } }] }\n      : text(\"parent must not get another request\"));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, {\n      continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: 2 },\n    })));\n    const stateManager = (agent as any).stateManager;\n    const recordProgress = stateManager.recordProgress.bind(stateManager);\n    let injected = false;\n    stateManager.recordProgress = (taskId: string, progress: any) => {\n      if (!injected && progress.objective?.execution?.cumulativeSteps === 2) {\n        injected = true;\n        throw new Error(\"simulated objective budget disk failure\");\n      }\n      return recordProgress(taskId, progress);\n    };\n    try {\n      const turn = await agent.runTurn(\"Delegate one write.\");\n      assert.equal(injected, true, \"the child step budget checkpoint was attempted\");\n      assert.equal(turn.execution, \"FAILED\");\n      assert.equal(turn.reason, \"PERSISTENCE_FAILED\");\n      assert.equal(gw.requests.length, 1, \"only the parent request ran; no child inference or parent retry was submitted\");\n      assert.ok(turn.persistence?.failures.some((failure: string) => /simulated objective budget disk failure/.test(failure)));\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"a failed durable budget checkpoint prevents the next inference request\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway(() => write(\"must-not-run.txt\"));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, {\n      continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: 2 },\n39-\n40-/** Structured projection of turn activity for non-terminal surfaces such as the TUI sidecar. Observers must not throw. */\n41-/** Outcome of in-turn delegation (spawn_subagent). `summary` is whatever report exists, even when not completed. */\n42:export interface SubagentResult {\n43-  completed: boolean;\n44-  summary: string;\n45-  reason?: string;\n","exit_code":0,"duration":{"secs":0,"nanos":45050}},"started_at_ms":1795297913309,"completed_at_ms":1795297913310}}
{"timestamp":"2026-11-21T21:51:53.444Z","ordinal":35775,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a20018-2a64-7260-91a9-a6bcf37119fe","call_id":"call_4e63b2813aeb41848371073754fd72dd","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"import { test } from \"node:test\";\nimport http from \"node:http\";\nimport type { Socket } from \"node:net\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execSync, spawnSync } from \"node:child_process\";\nimport { trackResource } from \"./leak_registry.js\";\n\nexport type Reply =\n  /** `truncated`: the reply hits the output limit (finish_reason=length) partway through its tool calls' arguments. */\n  | { kind: \"tools\"; calls: Array<{ name: string; args: unknown; id?: string }>; content?: string; delayMs?: number; truncated?: boolean }\n  /** `chunks`: stream the text in these pieces, `gapMs` apart (the default sends it in one delta). `truncated`: finish_reason=length. */\n  | { kind: \"text\"; content: string; delayMs?: number; chunks?: string[]; gapMs?: number; truncated?: boolean }\n  | { kind: \"http\"; status: number; body?: string; delayMs?: number };\n\nexport interface Gateway {\n  url: string;\n  requests: unknown[];\n  /** Bodies of /tokenize requests (only with `options.tokenize`). */\n  tokenizeRequests: any[];\n  /** Number of GET /models requests served. */\n  modelRequests: number;\n  /** Authorization headers seen, per path kind. */\n  authSeen: Array<{ path: string; authorization?: string }>;\n  close(): Promise<void>;\n}\n\n/** Optional gateway capabilities (homelab-ai contract shape): catalog entries, request counting, admission headers. */\nexport interface GatewayOptions {\n  /** `data` entries for GET /models (default: [{ id: \"m\" }]). Called per request, so tests can change capacity. */\n  models?: () => any[];\n  /** Answer to POST /tokenize; absent: 404. */\n  tokenize?: (body: any, n: number) => { status: number; body: unknown; delayMs?: number };\n  /** Response headers for the n-th chat request (e.g. X-AIHost-* admission headers). */\n  headers?: (n: number, body: any) => Record<string, string>;\n}\n\nfunction sse(obj: unknown): string {\n  return `data: ${JSON.stringify(obj)}\\n\\n`;\n}\n\n/** A tool call's arguments as sent: whole, or cut off partway like a reply that hit the output limit. */\nfunction wireArguments(args: unknown, truncated?: boolean): string {\n  const json = JSON.stringify(args);\n  return truncated ? json.slice(0, Math.max(1, Math.floor(json.length / 2))) : json;\n}\n\nfunction finishReason(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  return r.truncated ? \"length\" : r.kind === \"tools\" ? \"tool_calls\" : \"stop\";\n}\n\nfunction streamBody(r: Extract<Reply, { kind: \"tools\" | \"text\" }>): string {\n  let out = \"\";\n  if (r.kind === \"text\") out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n  else {\n    if (r.content) out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n    r.calls.forEach((c, i) => {\n      out += sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: i, id: c.id ?? `call_${i}_${Math.random().toString(36).slice(2, 7)}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } }] } }] });\n    });\n  }\n  out += sse({ choices: [{ index: 0, delta: {}, finish_reason: finishReason(r) }] });\n  return out + \"data: [DONE]\\n\\n\";\n}\n\n/** Deterministic OpenAI-compatible gateway. `script(n, body)` decides the reply to the n-th chat request (1-based). */\nexport async function startGateway(script: (n: number, body?: any) => Reply, options: GatewayOptions = {}): Promise<Gateway> {\n  const requests: unknown[] = [];\n  const tokenizeRequests: any[] = [];\n  const authSeen: Array<{ path: string; authorization?: string }> = [];\n  let modelRequests = 0;\n  const sockets = new Set<Socket>();\n  const server = http.createServer((req, res) => {\n    authSeen.push({ path: req.url ?? \"\", authorization: req.headers.authorization });\n    if (req.url?.endsWith(\"/models\")) {\n      modelRequests++;\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ data: options.models ? options.models() : [{ id: \"m\" }] }));\n      return;\n    }\n    if (req.url?.endsWith(\"/tokenize\")) {\n      let raw = \"\";\n      req.on(\"data\", (c) => (raw += c));\n      req.on(\"end\", () => {\n        let body: any = {};\n        try { body = JSON.parse(raw); } catch {}\n        tokenizeRequests.push(body);\n        if (!options.tokenize) {\n          res.statusCode = 404;\n          res.end(JSON.stringify({ status: \"not_found\", message: \"no tokenize\" }));\n          return;\n        }\n        const answer = options.tokenize(body, tokenizeRequests.length);\n        const send = () => {\n          if (res.writableEnded || res.destroyed) return;\n          res.statusCode = answer.status;\n          res.setHeader(\"content-type\", \"application/json\");\n          res.end(typeof answer.body === \"string\" ? answer.body : JSON.stringify(answer.body));\n        };\n        if (answer.delayMs) setTimeout(send, answer.delayMs); else send();\n      });\n      return;\n    }\n    let raw = \"\";\n    req.on(\"data\", (c) => (raw += c));\n    req.on(\"end\", () => {\n      let body: any = {};\n      try { body = JSON.parse(raw); } catch {}\n      requests.push(body);\n      const extraHeaders = options.headers ? options.headers(requests.length, body) : {};\n      for (const [k, v] of Object.entries(extraHeaders)) res.setHeader(k, v);\n      const r = script(requests.length, body);\n      const respond = () => {\n        if (res.writableEnded || res.destroyed) return;\n        if (r.kind === \"http\") {\n          res.statusCode = r.status;\n          res.end(r.body ?? \"{}\");\n        } else if (body.stream && r.kind === \"text\" && r.chunks?.length) {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          const pieces = [...r.chunks];\n          const next = () => {\n            if (res.writableEnded || res.destroyed) return;\n            const piece = pieces.shift();\n            if (piece === undefined) {\n              res.end(sse({ choices: [{ index: 0, delta: {}, finish_reason: \"stop\" }] }) + \"data: [DONE]\\n\\n\");\n              return;\n            }\n            res.write(sse({ choices: [{ index: 0, delta: { content: piece } }] }));\n            setTimeout(next, r.gapMs ?? 50);\n          };\n          next();\n        } else if (body.stream) {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          res.end(streamBody(r));\n        } else {\n          res.setHeader(\"content-type\", \"application/json\");\n          const message = r.kind === \"text\"\n            ? { role: \"assistant\", content: r.content }\n            : { role: \"assistant\", content: r.content ?? null, tool_calls: r.calls.map((c, i) => ({ id: c.id ?? `call_${i}`, type: \"function\", function: { name: c.name, arguments: wireArguments(c.args, r.truncated) } })) };\n          res.end(JSON.stringify({ choices: [{ index: 0, message, finish_reason: r.truncated ? \"length\" : \"stop\" }] }));\n        }\n      };\n      if (r.delayMs) setTimeout(respond, r.delayMs); else respond();\n    });\n  });\n  server.on(\"connection\", (s) => { sockets.add(s); s.on(\"close\", () => sockets.delete(s)); });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", () => resolve()));\n  const port = (server.address() as any).port;\n  trackResource(\"gateway\", `scripted gateway on port ${port} not closed`, () => server.listening, () => close());\n  const close = async () => {\n    for (const s of sockets) s.destroy();\n    await new Promise<void>((resolve) => server.close(() => resolve()));\n  };\n  return {\n    url: `http://127.0.0.1:${port}/v1`,\n    requests,\n    tokenizeRequests,\n    get modelRequests() {\n      return modelRequests;\n    },\n    authSeen,\n    close,\n  };\n}\n\n/** Temporary git repository with one committed file. */\nexport function makeRepo(files: Record<string, string> = {}): string {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-sidecar-\"));\n  fs.writeFileSync(path.join(repo, \"base.txt\"), \"base\\n\");\n  for (const [name, content] of Object.entries(files)) {\n    const full = path.join(repo, name);\n    fs.mkdirSync(path.dirname(full), { recursive: true });\n    fs.writeFileSync(full, content);\n  }\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm base\", { cwd: repo, stdio: \"ignore\" });\n  return repo;\n}\n\nexport function makeHome(): string {\n  return fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-home-\"));\n}\n\n/** Seed an isolated HOME with explicit trust for a PTY test that needs to reach the REPL. */\nexport function trustWorkspace(home: string, workspace: string): void {\n  const trustDir = path.join(home, \".config\", \"nexus\");\n  fs.mkdirSync(trustDir, { recursive: true, mode: 0o700 });\n  fs.writeFileSync(\n    path.join(trustDir, \"trusted_workspaces.json\"),\n    JSON.stringify({ trustedPaths: [fs.realpathSync(workspace)] }, null, 2),\n    { mode: 0o600 },\n  );\n}\n\nexport async function waitUntil(cond: () => boolean, timeoutMs = 10000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (!cond()) {\n    if (Date.now() > deadline) throw new Error(\"timed out\");\n    await new Promise((r) => setTimeout(r, 10));\n  }\n}\n\n/**\n * True once `pid` has terminated. A zombie counts as terminated: under a PID 1 that does not reap (some containers), a\n * killed process stays a zombie, and `kill(pid, 0)` still succeeds on it.\n */\nexport function processGone(pid: number): boolean {\n  try {\n    process.kill(pid, 0);\n  } catch (error: unknown) {\n    return (error as NodeJS.ErrnoException)?.code === \"ESRCH\";\n  }\n  // The process exists or is a zombie. `ps -p` exits 1 with no output once the pid is gone; if ps cannot run, the\n  // process is not proven gone.\n  const ps = spawnSync(\"ps\", [\"-o\", \"stat=\", \"-p\", String(pid)], { encoding: \"utf8\" });\n  if (ps.error || (ps.status !== 0 && ps.status !== 1)) return false;\n  const stat = ps.stdout.trim();\n  return stat === \"\" || stat.startsWith(\"Z\");\n}\n\nexport async function waitForEvent(events: any[], pred: (e: any) => boolean, timeoutMs = 10000): Promise<any> {\n  try {\n    await waitUntil(() => events.some(pred), timeoutMs);\n  } catch {\n    throw new Error(`timed out waiting for event; saw: ${events.map((e) => e.type).join(\", \")}`);\n  }\n  return events.find(pred);\n}\n\n/**\n * Pseudo-terminal scenarios measure timing (spinner frames, idle redraws, approval grace) and drive real processes;\n * run concurrently by the test runner they starve each other and keys arrive late. `ptyTest` holds a cross-process\n * lock (a directory under the system temp dir, taken over when its owner is gone) so they run one at a time.\n */\nexport async function acquirePtyLock(timeoutMs = 15 * 60_000): Promise<() => void> {\n  const dir = path.join(os.tmpdir(), \"nexus-pty-test.lock\");\n/**\n * Continuation past the per-segment step limit, bounded stopping, acceptance requirements, verifier attempts and\n * steering at the agent layer. Every scenario runs the real agent loop against a deterministic local gateway.\n *\n * Evidence session: nexus-session-session_20261011_162349_6lvu.json — the objective ended at step 30 (STEP LIMIT\n * REACHED), the operator had to type \"continue\", the original request survived only as a truncatable compaction note,\n * and task_completed re-ran the same failing `make test` twice on unchanged inputs.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { DEFAULT_CONTINUATION, HarnessConfig, MAX_CONTINUATION_MINUTES, MAX_CONTINUATION_STEPS } from \"../src/types.js\";\nimport { startGateway, makeRepo, Reply } from \"./helpers/fixtures.js\";\nimport { createLedger, seedRequirements, applyRequirementUpdates, isNewObjective, failedCheckFrom, renderPinnedLedger, acceptDescoping, requirementDone, readObjective, invalidateVerified, queueSteering, amendObjective, trackingOf } from \"../src/core/objective.js\";\nimport { stableToolCallId, redactTaskStateForPersistence } from \"../src/core/persistence_protection.js\";\nimport { SessionManager } from \"../src/session.js\";\nimport { WorkspacePath } from \"../src/core/workspace_path.js\";\n\nimport { requirementRows as require_rows } from \"../src/core/objective.js\";\nconst quiet = (agent: AutonomousAgent) => {\n  (agent as any).ui = new Proxy({}, { get: () => () => {} });\n  return agent;\n};\nconst cfg = (endpoint: string, workspace: string, o: Partial<HarnessConfig> = {}): HarnessConfig => ({\n  endpoint,\n  model: \"m\",\n  maxSteps: 30,\n  temperature: 0,\n  workspace,\n  shell: \"bash\",\n  approvalMode: \"auto\",\n  fullAccess: true,\n  ...o,\n});\nconst write = (name: string, content = `${name}\\n`): Reply => ({ kind: \"tools\", calls: [{ name: \"write_file\", args: { path: name, content } }] });\nconst read = (name: string): Reply => ({ kind: \"tools\", calls: [{ name: \"read_file\", args: { path: name } }] });\nconst text = (content: string): Reply => ({ kind: \"text\", content });\n/** Resolves once the agent's turn is running inference (extension start-up can delay it). */\nasync function inferring(agent: AutonomousAgent, timeoutMs = 20_000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (agent.getTurnLifecycle()?.phase !== \"inference\") {\n    if (Date.now() > deadline) throw new Error(\"the turn never reached inference\");\n    await new Promise((r) => setTimeout(r, 5));\n  }\n}\nconst userMessages = (body: any) => (body.messages as any[]).filter((m) => m.role === \"user\").map((m) => String(m.content));\nconst systemText = (body: any) => (body.messages as any[]).filter((m) => m.role === \"system\").map((m) => String(m.content)).join(\"\\n\");\n\ndescribe(\"continuation beyond the per-segment step limit\", () => {\n  test(\"automatic continuation has finite default step and invocation time ceilings\", () => {\n    assert.equal(DEFAULT_CONTINUATION.maxTotalSteps, 500);\n    assert.equal(DEFAULT_CONTINUATION.maxTurnMinutes, 480);\n    assert.ok(Number.isFinite(DEFAULT_CONTINUATION.maxTotalSteps));\n    assert.ok(Number.isFinite(DEFAULT_CONTINUATION.maxTurnMinutes));\n  });\n\n  test(\"legacy objective continuation counts are not reset when the execution tracker is missing or stale\", () => {\n    const ledger = createLedger(\"Continue the existing task.\");\n    ledger.continuation.totalSteps = 17;\n    delete ledger.execution;\n    assert.equal(trackingOf(ledger).data.cumulativeSteps, 17);\n\n    ledger.execution!.cumulativeSteps = 9;\n    assert.equal(trackingOf(ledger).data.cumulativeSteps, 17);\n  });\n\n  test(\"direct agent construction rejects step or time limits above the hard ceilings\", () => {\n    const repo = makeRepo();\n    try {\n      assert.throws(\n        () => new AutonomousAgent(cfg(\"http://127.0.0.1:9/v1\", repo, { continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: MAX_CONTINUATION_STEPS + 1 } })),\n        /expected an integer from 1 to 5000/,\n      );\n      assert.throws(\n        () => new AutonomousAgent(cfg(\"http://127.0.0.1:9/v1\", repo, { continuation: { ...DEFAULT_CONTINUATION, maxTurnMinutes: MAX_CONTINUATION_MINUTES + 1 } })),\n        /expected a finite value from 1 second to 4320 minutes/,\n      );\n    } finally {\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"a progressing task runs past 30 steps without the operator typing continue\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway((n) => (n <= 34 ? write(`f${n}.txt`) : text(\"All files written.\")));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, { continuation: { ...DEFAULT_CONTINUATION } })));\n    try {\n      const turn = await agent.runTurn(\"Write files f1.txt through f34.txt, one per step.\");\n      assert.equal(turn.execution, \"COMPLETED\", JSON.stringify(turn));\n      assert.equal(turn.steps.used, 35);\n      assert.equal(turn.steps.limitReached, false);\n      assert.equal(turn.continuation?.segments, 2, \"step 31 begins the second segment\");\n      assert.equal(gw.requests.length, 35);\n      assert.ok(fs.existsSync(path.join(repo, \"f34.txt\")));\n      // No \"continue\" was typed or injected: the only user message is the operator's own.\n      const last = gw.requests[34] as any;\n      assert.deepEqual(userMessages(last).map((m) => m.split(\"\\n\")[0]), [\"Write files f1.txt through f34.txt, one per step.\"]);\n      assert.match(systemText(last), /Continuation: segment 2 of this turn/);\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"without a continuation budget the same task still ends at the segment limit (legacy single-segment turn)\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway((n) => (n <= 34 ? write(`f${n}.txt`) : text(\"done\")));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo)));\n    try {\n      const turn = await agent.runTurn(\"Write files f1.txt through f34.txt, one per step.\");\n      assert.equal(turn.execution, \"LIMIT_REACHED\");\n      assert.equal(turn.reason, \"STEP_LIMIT_REACHED\");\n      assert.equal(gw.requests.length, 30);\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"a stuck task stops boundedly: recovery notes, then STAGNATION_DETECTED\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway(() => read(\"base.txt\"));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, { continuation: { ...DEFAULT_CONTINUATION, stagnationSteps: 50, maxRecoveries: 2 } })));\n    try {\n      const turn = await agent.runTurn(\"Inspect base.txt.\");\n      assert.equal(turn.execution, \"LIMIT_REACHED\");\n      assert.equal(turn.reason, \"STAGNATION_DETECTED\");\n      // v1.1.2: after the second note recovery is constrained; the repeats are refused before they run, and the turn\n      // stops when the refusals are used up.\n      assert.match(turn.detail ?? \"\", /recovery exhausted after 2 recovery notes: \\d+ equivalent observation\\(s\\) refused on an unchanged workspace/);\n      const refused = agent.getMessages().filter((m: any) => m.role === \"tool\" && String(m.content).startsWith(\"[Nexus refused: not executed]\"));\n      assert.ok(refused.length >= 2, `refused repeats: ${refused.length}`);\n      assert.ok(gw.requests.length <= 10, `bounded: ${gw.requests.length} requests`);\n      const notes = userMessages(gw.requests[gw.requests.length - 1]).filter((m) => m.startsWith(\"[Nexus recovery\"));\n      assert.equal(notes.length, 2, \"two bounded recovery notes before stopping\");\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"no progress for the configured window ends the turn with STAGNATION_DETECTED\", { timeout: 60_000 }, async () => {\n    // Alternating reads of two unchanging files: never the same call three times in a row, never new information.\n    const gw = await startGateway((n) => read(n % 2 ? \"base.txt\" : \"other.txt\"));\n    const repo = makeRepo({ \"other.txt\": \"other\\n\" });\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, { continuation: { ...DEFAULT_CONTINUATION, stagnationSteps: 4, maxRecoveries: 10 } })));\n    try {\n      const turn = await agent.runTurn(\"Inspect the two files.\");\n      assert.equal(turn.reason, \"STAGNATION_DETECTED\", JSON.stringify(turn));\n      assert.match(turn.detail ?? \"\", /4 consecutive steps without progress/);\n      assert.ok(gw.requests.length <= 8, `bounded: ${gw.requests.length}`);\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"the total step budget ends a long task with STEP_BUDGET_EXHAUSTED and its segment count\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway((n) => write(`g${n}.txt`));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, { maxSteps: 5, continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: 12 } })));\n    try {\n      const turn = await agent.runTurn(\"Keep writing files.\");\n      assert.equal(turn.execution, \"LIMIT_REACHED\");\n      assert.equal(turn.reason, \"STEP_BUDGET_EXHAUSTED\");\n      assert.equal(turn.steps.used, 12);\n      assert.equal(turn.steps.max, 12);\n      assert.equal(turn.continuation?.segments, 3);\n      assert.equal(gw.requests.length, 12);\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"the total step budget is shared by durable resume instead of resetting per invocation\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway((n) => write(`resume-${n}.txt`));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, {\n      maxSteps: 30,\n      continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: 2 },\n    })));\n    try {\n      const first = await agent.runTurn(\"Keep writing distinct files.\");\n      assert.equal(first.reason, \"STEP_BUDGET_EXHAUSTED\");\n      assert.equal(first.steps.used, 2);\n      assert.equal(gw.requests.length, 2);\n\n      const resumed = await agent.runTurn(\"\", undefined, { resume: true });\n      assert.equal(resumed.execution, \"LIMIT_REACHED\");\n      assert.equal(resumed.reason, \"STEP_BUDGET_EXHAUSTED\");\n      assert.equal(gw.requests.length, 2, \"resume at an exhausted budget submits no new inference request\");\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"a delegated helper consumes only the parent's remaining durable steps\", { timeout: 60_000 }, async () => {\n    let writes = 0;\n    const gw = await startGateway((_n, body) => {\n      const subagent = (body.messages as any[]).some((message) => typeof message.content === \"string\" && message.content.includes(\"[Subagent Objective]\"));\n      if (!subagent) return { kind: \"tools\", calls: [{ name: \"spawn_subagent\", args: { prompt: \"write until stopped\", profile: \"implementer\" } }] };\n      return write(`shared-${++writes}.txt`);\n    });\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, {\n      worktree: true,\n      continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: 3 },\n    })));\n    try {\n      const turn = await agent.runTurn(\"Delegate an open-ended sequence of writes.\");\n      assert.equal(turn.execution, \"LIMIT_REACHED\");\n      assert.equal(turn.reason, \"STEP_BUDGET_EXHAUSTED\");\n      assert.equal(turn.steps.used, 3);\n      assert.equal(agent.getObjective()!.execution!.cumulativeSteps, 3);\n      assert.equal(gw.requests.length, 3, \"one parent request and exactly two delegated requests consumed the budget\");\n      assert.equal(writes, 2);\n      const workspace = agent.getActiveWorktree()?.worktreePath ?? repo;\n      assert.ok(fs.existsSync(path.join(workspace, \"shared-1.txt\")));\n      assert.ok(fs.existsSync(path.join(workspace, \"shared-2.txt\")));\n    } finally {\n      if (agent.getActiveWorktree()) agent.discardActiveWorktree();\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"a delegated inference is not sent when saving its shared budget fails\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway((n) => n === 1\n      ? { kind: \"tools\", calls: [{ name: \"spawn_subagent\", args: { prompt: \"write a child file\" } }] }\n      : text(\"parent must not get another request\"));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, {\n      continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: 2 },\n    })));\n    const stateManager = (agent as any).stateManager;\n    const recordProgress = stateManager.recordProgress.bind(stateManager);\n    let injected = false;\n    stateManager.recordProgress = (taskId: string, progress: any) => {\n      if (!injected && progress.objective?.execution?.cumulativeSteps === 2) {\n        injected = true;\n        throw new Error(\"simulated objective budget disk failure\");\n      }\n      return recordProgress(taskId, progress);\n    };\n    try {\n      const turn = await agent.runTurn(\"Delegate one write.\");\n      assert.equal(injected, true, \"the child step budget checkpoint was attempted\");\n      assert.equal(turn.execution, \"FAILED\");\n      assert.equal(turn.reason, \"PERSISTENCE_FAILED\");\n      assert.equal(gw.requests.length, 1, \"only the parent request ran; no child inference or parent retry was submitted\");\n      assert.ok(turn.persistence?.failures.some((failure: string) => /simulated objective budget disk failure/.test(failure)));\n    } finally {\n      agent.shutdown();\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n\n  test(\"a failed durable budget checkpoint prevents the next inference request\", { timeout: 60_000 }, async () => {\n    const gw = await startGateway(() => write(\"must-not-run.txt\"));\n    const repo = makeRepo();\n    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, {\n      continuation: { ...DEFAULT_CONTINUATION, maxTotalSteps: 2 },\n39-\n40-/** Structured projection of turn activity for non-terminal surfaces such as the TUI sidecar. Observers must not throw. */\n41-/** Outcome of in-turn delegation (spawn_subagent). `summary` is whatever report exists, even when not completed. */\n42:export interface SubagentResult {\n43-  completed: boolean;\n44-  summary: string;\n45-  reason?: string;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20014-b98e-7f50-9b44-1c38f2a1201a","create_time":1795297913.4439993}},"metadata":{"history_sequence":15964,"sampled_through_sequence":15960,"client_authored":false,"fallback_token_limit_override":12000}}
