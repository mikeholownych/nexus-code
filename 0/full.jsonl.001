e), entryPath);\n      }\n    };\n    visit(root, \"\");\n    return paths;\n  }\n\n  private directoryHasCleanupPreservedEntries(directory: string): boolean {\n    const ignored = new Set([\"node_modules\", \".git\", \"target\", \"dist\", \".nexus\", \".next\", \".cache\"]);\n    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n      if (ignored.has(entry.name)) return true;\n      if (entry.isDirectory()) {\n        if (this.directoryHasCleanupPreservedEntries(path.join(directory, entry.name))) return true;\n      } else if (!entry.isFile() && !entry.isSymbolicLink()) {\n        return true;\n      }\n    }\n    return false;\n  }\n\n  private assertSnapshotTargetsReplaceable(relativePaths: string[]): void {\n    for (const relativePath of relativePaths) {\n      const targetPath = path.join(this.workspace, relativePath);\n      const stat = fs.lstatSync(targetPath, { throwIfNoEntry: false });\n      if (stat?.isDirectory() && this.directoryHasCleanupPreservedEntries(targetPath)) {\n        throw new Error(\"Checkpoint snapshot target directory contains entries preserved by cleanup\");\n      }\n    }\n  }\n\n  private assertGitSnapshotTargetsReplaceable(relativePaths: string[], gitRef: string): void {\n    const directoryTargets = relativePaths.filter((relativePath) =>\n      fs.lstatSync(path.join(this.workspace, relativePath), { throwIfNoEntry: false })?.isDirectory(),\n    );\n    if (directoryTargets.length === 0) return;\n\n    const changedPaths = execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"diff\", \"--name-only\", \"-z\", gitRef, \"--\"], {\n      cwd: this.workspace,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    }).toString(\"utf8\").split(\"\\0\").filter(Boolean);\n    if (changedPaths.some((relativePath) => path.basename(relativePath) === \".gitignore\")) {\n      throw new Error(\"Checkpoint Git ignore rules differ from the current worktree\");\n    }\n\n    for (const relativePath of directoryTargets) {\n      // A clean preview can be empty when the directory path is also tracked in the index,\n      // even though ordinary untracked children beneath it are removable.\n      if (this.directoryContainsOnlyGitCleanRemovableEntries(relativePath)\n        && this.gitTrackedDescendantPaths(relativePath).length === 0) {\n        continue;\n      }\n      if (!this.directoryContainsOnlyTrackedRemovableEntries(relativePath)) {\n        throw new Error(\"Checkpoint snapshot target directory contains entries preserved by Git clean\");\n      }\n    }\n  }\n\n  /** Tracked file entries that checkout-index may recreate from this checkpoint tree. Gitlinks are not blobs. */\n  private gitRefBlobPaths(gitRef: string): string[] {\n    const entries = execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"ls-tree\", \"-r\", \"-z\", \"--full-tree\", gitRef], {\n      cwd: this.workspace,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    }).toString(\"utf8\").split(\"\\0\").filter(Boolean);\n\n    const paths: string[] = [];\n    for (const entry of entries) {\n      const separator = entry.indexOf(\"\\t\");\n      if (separator < 0) throw new Error(\"Could not parse checkpoint Git tree entry\");\n      const objectType = entry.slice(0, separator).split(\" \")[1];\n      if (objectType === \"blob\") paths.push(entry.slice(separator + 1));\n    }\n    return paths;\n  }\n\n  private directoryContainsOnlyGitCleanRemovableEntries(relativePath: string): boolean {\n    const root = path.join(this.workspace, relativePath);\n    const visit = (directory: string, relative: string): boolean => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        const child = relative ? `${relative}/${entry.name}` : entry.name;\n        if (entry.name === \".git\") return false;\n        const fullPath = path.join(directory, entry.name);\n        if (entry.isDirectory()) {\n          try {\n            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `${relativePath}/${child}`], {\n              cwd: this.workspace,\n              stdio: \"ignore\",\n            });\n            return false;\n          } catch (error) {\n      return { success: false, message: `Checkpoint '${id}' not found.` };\n    }\n\n    try {\n      if (this.isGit && cp.gitRef) {\n        const hookGuardEnv = envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\", \"post-index-change\"]);\n        const postCheckpointAdditions = cp.untrackedFiles === undefined ? this.trackedPathsAddedSince(cp.gitRef) : [];\n        if (cp.untrackedFiles !== undefined && cp.untrackedFiles.length > 0) {\n          if (!cp.snapshotDir) return { success: false, message: `Rollback failed: checkpoint '${cp.id}' is missing its untracked snapshot; workspace was not changed` };\n          try {\n            this.assertUntrackedSnapshotSafe(cp.untrackedFiles, cp.snapshotDir, cp.allowSensitive === true);\n            this.assertUntrackedDestinationSafe(cp.untrackedFiles, this.workspace);\n          } catch {\n            return { success: false, message: `Rollback failed: checkpoint '${cp.id}' has an unsafe untracked snapshot or destination; workspace was not changed` };\n          }\n        }\n        if (cp.untrackedFiles !== undefined) {\n          const replacementTargets = [...new Set([...cp.untrackedFiles, ...this.gitRefBlobPaths(cp.gitRef)])];\n          this.assertGitSnapshotTargetsReplaceable(replacementTargets, cp.gitRef);\n        }\n        if (cp.untrackedFiles === undefined) this.assertLegacyUntrackedRestoreSafe(cp.gitRef);\n        execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"read-tree\", cp.gitRef], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n        execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"checkout-index\", \"-f\", \"-a\"], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n        this.removeTrackedDeletions(cp.gitRef, postCheckpointAdditions);\n        if (cp.untrackedFiles !== undefined) {\n          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"clean\", \"-fd\"], { cwd: this.workspace, stdio: \"ignore\", env: hookGuardEnv });\n          if (cp.untrackedFiles.length > 0) {\n            this.copyUntrackedEntries(cp.untrackedFiles, cp.snapshotDir!, this.workspace, cp.allowSensitive === true);\n          }\n          return { success: true, message: `Restored workspace to checkpoint '${cp.name}' (${cp.id})` };\n        }\n    assert.match(result.message, /destination|unsafe|snapshot/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"a\", \"ignored\"), \"utf8\"), \"ignored canary\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"tracked canary\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"untracked.txt\"), \"utf8\"), \"untracked canary\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore refuses a nested-repository file-target obstruction before Git mutation\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"a\"), \"captured file\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"Git nested repository file target\");\n    fs.rmSync(path.join(repo, \"a\"));\n    fs.mkdirSync(path.join(repo, \"a\"));\n    execFileSync(\"git\", [\"-C\", path.join(repo, \"a\"), \"init\", \"-q\"]);\n    fs.writeFileSync(path.join(repo, \"a\", \"nested.txt\"), \"nested canary\\n\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"tracked canary\\n\");\n    fs.writeFileSync(path.join(repo, \"untracked.txt\"), \"untracked canary\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe|snapshot/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"a\", \"nested.txt\"), \"utf8\"), \"nested canary\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"tracked canary\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"untracked.txt\"), \"utf8\"), \"untracked canary\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore refuses to copy an untracked file into a nested-repository ancestor\", () => {\n  const { repo, git } = gitRepo();\n  const nestedRepo = path.join(repo, \"a\");\n  const nestedGit = (...args: string[]) => execFileSync(\"git\", [\"-C\", nestedRepo, ...args], { encoding: \"utf8\" }).trim();\n  try {\n    fs.mkdirSync(nestedRepo);\n    fs.writeFileSync(path.join(nestedRepo, \"captured.txt\"), \"checkpoint content\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"untracked path below nested repo\");\n    fs.rmSync(nestedRepo, { recursive: true, force: true });\n\n    fs.mkdirSync(nestedRepo);\n    nestedGit(\"init\", \"-q\");\n    nestedGit(\"config\", \"user.email\", \"nested@example.invalid\");\n    nestedGit(\"config\", \"user.name\", \"Nested Test\");\n    fs.writeFileSync(path.join(nestedRepo, \"captured.txt\"), \"nested repository canary\\n\");\n    nestedGit(\"add\", \"captured.txt\");\n    nestedGit(\"commit\", \"-qm\", \"nested canary\");\n    const nestedHeadBefore = nestedGit(\"rev-parse\", \"HEAD\");\n    const nestedIndexBefore = execFileSync(\"git\", [\"-C\", nestedRepo, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"post-checkpoint tracked canary\\n\");\n    fs.writeFileSync(path.join(repo, \"staged.txt\"), \"post-checkpoint staged canary\\n\");\n    git(\"add\", \"staged.txt\");\n    fs.writeFileSync(path.join(repo, \"later.txt\"), \"post-checkpoint untracked canary\\n\");\n    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n    const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe|snapshot/i);\n    assert.equal(fs.readFileSync(path.join(nestedRepo, \"captured.txt\"), \"utf8\"), \"nested repository canary\\n\");\n    assert.equal(nestedGit(\"rev-parse\", \"HEAD\"), nestedHeadBefore);\n    const nestedIndexAfter = execFileSync(\"git\", [\"-C\", nestedRepo, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(nestedIndexAfter, nestedIndexBefore, \"rejection must preserve nested repository index entries\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n    const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve outer repository index entries\");\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"post-checkpoint tracked canary\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"staged.txt\"), \"utf8\"), \"post-checkpoint staged canary\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"later.txt\"), \"utf8\"), \"post-checkpoint untracked canary\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\nls: cannot access '.git/nexus-claims/FILE_cli_src_checkpoint.ts': Not a directory\nls: cannot access '.git/nexus-claims/FILE_cli_test_checkpoint_restore.test.ts': Not a directory\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a182b5-7df6-71b2-a955-13339511caaf","create_time":1793194926.907034}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
