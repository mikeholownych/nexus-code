_linear__complete_authentication","mcp__plugin_design_notion__authenticate","mcp__plugin_design_notion__complete_authentication","mcp__plugin_design_slack__authenticate","mcp__plugin_design_slack__complete_authentication","mcp__rea__act_on_build_computer","mcp__rea__address_name","mcp__rea__address_to_file_offset","mcp__rea__analyze_function","mcp__rea__analyze_javascript_application","mcp__rea__analyze_swift_types","mcp__rea__analyze_web_bundle","mcp__rea__annotate_native_function","mcp__rea__audit_release_exposure","mcp__rea__batch_decompile","mcp__rea__binary_overview","mcp__rea__binary_session","mcp__rea__build_call_path","mcp__rea__build_reconstruction_obligation_ledger","mcp__rea__capture_adb_screen","mcp__rea__capture_browser_scenario","mcp__rea__capture_electron_scenario","mcp__rea__capture_native_ui_scenario","mcp__rea__capture_process_scenario","mcp__rea__capture_web_screenshot","mcp__rea__check_build_task","mcp__rea__close_binary","mcp__rea__close_build_computer","mcp__rea__close_frida_session","mcp__rea__close_gdb_session","mcp__rea__close_rizin_debug_session","mcp__rea__collect_adb_bugreport","mcp__rea__comment","mcp__rea__compare_application_versions","mcp__rea__compare_artifacts","mcp__rea__compare_bundles","mcp__rea__compare_functions","mcp__rea__compare_javascript_export_shapes","mcp__rea__compare_managed_members","mcp__rea__compare_process_captures","mcp__rea__compare_source_to_bundle","mcp__rea__compare_static_and_observed_endpoints","mcp__rea__compare_wasm_interfaces","mcp__rea__compare_web_captures","mcp__rea__compare_web_screenshots","mcp__rea__correlate_static_and_runtime","mcp__rea__current_address","mcp__rea__current_document","mcp__rea__current_procedure","mcp__rea__cutter_command","mcp__rea__decode_android_resources","mcp__rea__decode_interface_builder","mcp__rea__decode_signal_recording","mcp__rea__decompile_all","mcp__rea__decompile_jeb_item","mcp__rea__demangle_swift","mcp__rea__discover_webmcp_tools","mcp__rea__evaluate_reconstruction_