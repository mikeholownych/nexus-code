    durable: true,\n    role: \"implementer\",\n    unitId: \"u1\",\n    getTaskId: () => taskId,\n    getMessages: () => messages,\n    setMessages: (next: ChatMessage[]) => {\n      messages.splice(0, messages.length, ...next);\n    },\n    restartConversation: () => {\n      const systemMessage = messages.find((message) => message.role === \"system\") ?? { role: \"system\", content: \"system\" };\n      messages.splice(0, messages.length, systemMessage);\n    },\n    checkpointDurableState: (note?: string) => {\n      if (note) checkpoints.push(note);\n    },\n    getStateManager: () => ({ getBaseDir: () => options.tasks }),\n    getChangeBaseline: () => undefined,\n    validateTddRedVerifierBaseline: () => ({ ok: true }),\n    getCandidateTracker: () => new CandidateTracker(),\n    setProviderRecoveryHooks: () => {},\n    getObjective: () => undefined,\n    getCompletionSummary: () => ({ summary: \"done\" }),\n    recoverFromTaskState: async () => options.recover ?? {\n      success: true,\n277:          agent.restartConversation(!recovered?.obligationRecordPresent);\n280:            \"Note: this unit was explicitly restarted after recovery. Its earlier conversation was not continued. \" +\n295:          agent.restartConversation(!recovered || !recovered.obligationRecordPresent);\n301:            ? \"\\n\\nNote: this unit was explicitly restarted after recovery. Earlier workspace history may be incomplete, and any prior changes remain unverified; inspect the workspace before relying on them.\"\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a182b5-7df6-71b2-a955-13339511caaf","create_time":1793195080.596911}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
