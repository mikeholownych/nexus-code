'\\n' ' '); echo \"head=${HEAD:0:8} nonpass=$NONPASS tested=${T:0:8} testedbase=$(git rev-parse --short=8 $T^1 2>/dev/null) main=$(git rev-parse --short=8 origin/main) overlap=[$OVER]\"","description":"Verify #557's checks, Node 22 totals, the floor test, tested base and overlap"},"caller":{"type":"direct"}}]}}
