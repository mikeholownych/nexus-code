dencies.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"plugin_name\":\"plugin-management\",\"plugin_release_id\":\"pluginrel_6a7e9f7d0ef08191b97b213bb9e118ef\",\"plugin_release_version\":\"0.1.0\",\"apps\":[\"app://connector_openai_plugin_management\"],\"skills\":[\"skill://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\"],\"requires_executor\":false,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"plugin://plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"name\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"title\":\"Sites\",\"description\":\"Build and deploy websites with Sites. Use of Sites is subject to the ChatGPT Sites Terms (https://openai.com/policies/chatgpt-sites-terms/), and you are responsible for your website content.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"plugin_name\":\"sites\",\"plugin_release_id\":\"pluginrel_6adbbe74820481918f7ce521432d9acb\",\"plugin_release_version\":\"1.1.2\",\"apps\":[\"app://connector_20205bf7d4e99a89d7154bb849718324\"],\"skills\":[\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites\",\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-remix\"],\"requires_executor\":true,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_689987207de08191979cf68eca2941c6/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-analytics-dashboard\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-analytics-dashboard\",\"title\":\"Analytics Dashboard\",\"description\":\"Create a spreadsheet using the Analytics Dashboard template and its retained reference file. Use when the user selects or names Analytics Dashboard. Monitor acquisition, engagement, retention, revenue, and conversion funnel KPIs with charts.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdbd081918551b9ff949b0dcd\",\"skill_name\":\"artifact-template-analytics-dashboard\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-business-review\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-business-review\",\"title\":\"Business Review\",\"description\":\"Create a presentation using the Business Review template and its retained reference file. Use when the user selects or names Business Review. Review business performance, KPIs, segment results, strategic priorities, decisions, and outlook.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"REDACTED\",\"skill_name\":\"artifact-template-business-review\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-design-report\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-design-report\",\"title\":\"Design Report\",\"description\":\"Create a document using the Design Report template and its retained reference file. Use when the user selects or names Design Report. Produce design reports with an executive summary, key findings, implications, recommendations, and appendix.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdbe08191918c70c8437a0f90\",\"skill_name\":\"artifact-template-design-report\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-experiment-analysis\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-experiment-analysis\",\"title\":\"Experiment Analysis\",\"description\":\"Create a document using the Experiment Analysis template and its retained reference file. Use when the user selects or names Experiment Analysis. Analyze experiments with hypotheses, methodology, results, interpretation, limitations, and next steps.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdbe88191a5da52bf989269b8\",\"skill_name\":\"artifact-template-experiment-analysis\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-financial-budget\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-financial-budget\",\"title\":\"Financial Budget\",\"description\":\"Create a spreadsheet using the Financial Budget template and its retained reference file. Use when the user selects or names Financial Budget. Model actuals, budget and scenario forecasts, variances, cash runway, and departmental plans.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"