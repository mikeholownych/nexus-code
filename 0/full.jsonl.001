sc\" }, steps: [fix, breakLib, done], env: { NEXUS_TYPECHECK: \"off\" } });\ncli/test/vc6_typecheck_gaps.test.ts:148:    assert.equal(turn.verification?.typecheck?.status, \"NOT_APPLICABLE\");\ncli/test/vc6_typecheck_gaps.test.ts:152:  test(\"classification with a baseline: a new error in an untouched file is FAILED, a known one PREEXISTING\", () => {\ncli/test/vc6_typecheck_gaps.test.ts:156:    const baseline = new Set(typecheckSignatures(check, \"a.ts(9,9): error TS2322: old\", ws));\ncli/test/vc6_typecheck_gaps.test.ts:157:    const r = classifyTypecheck(check, out, ws, new Set(), baseline);\ncli/test/vc6_typecheck_gaps.test.ts:160:    assert.equal(classifyTypecheck(check, out, ws, new Set()).status, \"PREEXISTING\", \"no baseline: unchanged behaviour\");\ncli/test/vc6_typecheck_gaps.test.ts:161:    assert.equal(classifyTypecheck(check, \"a.ts(1,1): error TS2322: old\", ws, new Set(), baseline).status, \"PREEXISTING\", \"the line number moving does not make it new\");\ncli/test/vc6_typecheck_gaps.test.ts:169:      const checks = discoverTypechecks(root);\ncli/test/vc6_typecheck_gaps.test.ts:171:      assert.equal(discoverTypecheck(root)?.configPath, \"tsconfig.json\", \"the single-project compatibility API remains root-scoped\");\ncli/test/vc6_typecheck_gaps.test.ts:178:  test(\"discovers multiple typecheck configurations in one project\", () => {\ncli/test/vc6_typecheck_gaps.test.ts:181:      assert.deepEqual(discoverTypechecks(root).map((check) => check.configPath), [\"tsconfig.json\", \"Cargo.toml\"]);\ncli/test/vc6_typecheck_gaps.test.ts:195:      const checks = discoverTypechecks(root);\ncli/test/vc6_typecheck_gaps.test.ts:205:    const turn = await turnOf(files, { tools: { tsc: \"real-tsc\", cargo: FAKE_CARGO }, steps: [fix, write(\"core/src/lib.rs\", \"pub fn fail() { BADRUST; }\\n\"), done], config: { authoritativeVerifierCommand: NODE_VERIFIER }, env: { NEXUS_TYPECHECK: \"enforce\" } });\ncli/test/vc6_typecheck_gaps.test.ts:206:    const checks = turn.ve