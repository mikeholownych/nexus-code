{"timestamp":"2026-11-20T03:59:48.108Z","ordinal":29097,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_05793ea695c2aa2c016affc5b1f27487d28dedc118678537ea","status":"completed","call_id":"call_55f2f992664346518c12e4e1078bfb8c","name":"exec","input":"const r=await tools.exec_command({cmd:\"git show v1/invariants-audit:scripts/check_invariants.mjs | sed -n '1,240p'; git show v1/invariants-audit:docs/INVARIANTS.md | sed -n '1,220p'; git show v1/invariants-audit:cli/test/invariants_doc.test.ts | sed -n '1,180p'\",workdir:\"/home/mike/nexus-code\",yield_time_ms:10000,max_output_tokens:6000});text(r.output)\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a1f712-aaf3-7db1-9f93-ddce93b124cb","create_time":1795147185.9502995}},"metadata":{"history_sequence":12839,"sampled_through_sequence":12835,"client_authored":false}}
{"timestamp":"2026-11-20T03:59:48.137Z","ordinal":29098,"type":"token_usage_record","payload":{"thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a1f712-aaf3-7db1-9f93-ddce93b124cb","session_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","root_turn_id":"01a1f712-aaf3-7db1-9f93-ddce93b124cb","response_id":"resp_05793ea695c2aa2c016affc59516e487d29457b8558b9d0005","usage":{"input_tokens":134525,"cached_input_tokens":123520,"cache_write_input_tokens":0,"output_tokens":1668,"reasoning_output_tokens":1541,"total_tokens":136193},"turn_token_usage":{"input_tokens":4441707,"cached_input_tokens":4341120,"cache_write_input_tokens":0,"output_tokens":22002,"reasoning_output_tokens":14131,"total_tokens":4463709},"thread_token_usage":{"input_tokens":608389089,"cached_input_tokens":601553280,"cache_write_input_tokens":0,"output_tokens":1292669,"reasoning_output_tokens":676002,"total_tokens":609681758}}}
{"timestamp":"2026-11-20T03:59:48.340Z","ordinal":29099,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a1f712-aaf3-7db1-9f93-ddce93b124cb","item":{"type":"CommandExecution","id":"exec-16db73fe-92e0-4ec8-8f90-5d9253013f21","process_id":"7093","command":["/usr/bin/zsh","-lc","git show v1/invariants-audit:scripts/check_invariants.mjs | sed -n '1,240p'; git show v1/invariants-audit:docs/INVARIANTS.md | sed -n '1,220p'; git show v1/invariants-audit:cli/test/invariants_doc.test.ts | sed -n '1,180p'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git show v1/invariants-audit:scripts/check_invariants.mjs | sed -n '1,240p'; git show v1/invariants-audit:docs/INVARIANTS.md | sed -n '1,220p'; git show v1/invariants-audit:cli/test/invariants_doc.test.ts | sed -n '1,180p'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"// Checks docs/INVARIANTS.md against the repository.\n//   - every rule row names enforcing files and test files that exist;\n//   - every rule id appears in at least one test (or fixture) under cli/test, so a rule has proof;\n//   - every `I-<AREA>-<n>` id written in cli/src or cli/test is a row in the table, so code cannot cite an undefined rule.\n// Exit 1 on any problem. Run from anywhere: paths resolve from this file.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst doc = fs.readFileSync(path.join(root, \"docs\", \"INVARIANTS.md\"), \"utf8\");\nconst problems = [];\n\nconst rows = doc.split(\"\\n\").filter((line) => /^\\| I-[A-Z]+-\\d+ \\|/.test(line)).map((line) => {\n  const cells = line.split(\"|\").slice(1, -1).map((c) => c.trim());\n  const files = (cell) => [...cell.matchAll(/`([^`]+)`/g)].map((m) => m[1]);\n  return { id: cells[0], enforced: files(cells[2] ?? \"\"), proofs: files(cells[3] ?? \"\") };\n});\nif (rows.length === 0) problems.push(\"no rule rows found in docs/INVARIANTS.md\");\nconst ids = new Set(rows.map((r) => r.id));\nif (ids.size !== rows.length) problems.push(\"a rule id appears twice\");\n\nfunction walk(dir) {\n  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {\n    const full = path.join(dir, e.name);\n    if (e.isDirectory()) return e.name === \"node_modules\" || e.name === \"dist\" ? [] : walk(full);\n    return /\\.(ts|mjs|json)$/.test(e.name) ? [full] : [];\n  });\n}\nconst testFiles = walk(path.join(root, \"cli\", \"test\"));\nconst srcFiles = walk(path.join(root, \"cli\", \"src\"));\nconst textOf = new Map([...testFiles, ...srcFiles].map((f) => [f, fs.readFileSync(f, \"utf8\")]));\n\nfor (const row of rows) {\n  if (row.enforced.length === 0) problems.push(`${row.id}: no enforcing file named`);\n  if (row.proofs.length === 0) problems.push(`${row.id}: no proving test named`);\n  for (const file of [...row.enforced, ...row.proofs]) {\n    if (!fs.existsSync(path.join(root, file))) problems.push(`${row.id}: ${file} does not exist`);\n  }\n  const mentioned = testFiles.some((f) => textOf.get(f).includes(row.id));\n  if (!mentioned) problems.push(`${row.id}: no test or fixture under cli/test mentions this id`);\n}\nfor (const [file, text] of textOf) {\n  for (const match of text.matchAll(/\\bI-[A-Z]+-\\d+\\b/g)) {\n    if (!ids.has(match[0])) problems.push(`${path.relative(root, file)}: cites ${match[0]}, which is not a row in docs/INVARIANTS.md`);\n  }\n}\n\nif (problems.length) {\n  for (const p of [...new Set(problems)]) console.error(`invariants: ${p}`);\n  process.exit(1);\n}\nconsole.log(`invariants: ${rows.length} rules, each with enforcing code and a proving test`);\n# Engineering invariants: execution authority, side effects, failure semantics, change cost\n\nStatus: in force on `v1/invariants-impl` (not yet released). This file is the map from each rule to the code that enforces it, the test that proves it, and why it exists. It is checked by `node scripts/check_invariants.mjs`, so a row cannot point at a file that moved, and a rule named in code or tests cannot be missing here. It replaces no other document: `docs/EXECUTION_CONVERGENCE.md` describes the spine, `docs/v1.2.0/SEMANTIC_AND_ARCHITECTURAL_INTEGRITY.md` the acceptance gates.\n\nHow to read a row: **Enforced in** is the authoritative boundary (where the rule is decided, not where it is described). **Proven by** is a test that fails if the rule is removed. **Why** is the incident or audit finding, so a later change can tell a deliberate rule from an accident.\n\n## Rules\n\n| ID | Invariant | Enforced in | Proven by | Why (provenance) |\n|---|---|---|---|---|\n| I-LIFE-1 | A lifecycle change is decided at the authoritative boundary, under the driver lock: `run` never overwrites an existing operation id; `resume` and `decide` re-read the record after the lock is held; a COMPLETE operation or unit never leaves COMPLETE; unknown statuses and unknown decision action kinds are rejected at load, and the decision switch is exhaustive at compile time. | `cli/src/core/operation_runner.ts`, `cli/src/core/operation_schema.ts`, `cli/src/core/operation_runner_persistence.ts` | `cli/test/operation_entry_integrity.test.ts`, `cli/test/operation_schema.test.ts` | Audit 2026-11-17: `operation_cli.ts` loaded state before the lock was taken, so a stale snapshot could be written over a finished record; `run` with an existing id replaced its history. |\n| I-LIFE-3 | An upgrade lock is held only by a process that can still be the upgrader: a lock written before a reboot, or older than the longest plausible upgrade (6 h), is stale even if its pid is alive, so a reused pid cannot wedge recovery. Older locks without these fields keep the pid check. | `cli/src/upgrade_journal.ts`, `cli/src/doctor.ts` | `cli/test/upgrade_transaction_recovery.test.ts`, `cli/test/doctor_lock_window.test.ts` | EI-4: liveness was pid-only (and `doctor --fix`'s own lock took over a lock whose pid was not yet written, so it could steal a live one: an empty or unreadable pid on a file under 5 s old is now held, `cli/test/doctor_lock_window.test.ts`); after a reboot a pid could belong to an unrelated process and recovery reported \"upgrade in progress\" forever. |\n| I-EFFECT-1 | A mutating MCP `tools/call` over HTTP is delivered at most once per model request. Only a definitive \"no such route\" answer (404/405/501 from `/message`) may fall back to the legacy URL; any other failure is reported as unknown. | `cli/src/mcp.ts` | `cli/test/mcp_tool_call_delivery.test.ts` | Audit 2026-11-17: `sendRequest` re-POSTed the same payload after any fetch failure, including a reset or timeout after the server had received it. |\n| I-EFFECT-2 | An unknown outcome (timeout, cancel, lost connection) is never reported as a confirmed failure. The receipt says OUTCOME UNKNOWN, and a mutating tool in that state counts as possibly mutated, so the unverified-change obligation is raised. | `cli/src/core/spine.ts`, `cli/src/tools.ts`, `cli/src/types.ts` | `cli/test/spine_unknown_outcome.test.ts` | Audit: a timed-out `write_file` produced `candidateMutated=false`, so the workspace could change with no verification owed. |\n| I-EFFECT-3 | A call identical to one whose outcome was left unknown by a crash is not re-issued silently on resume, even in auto mode: it needs an explicit approval. The identity is a hash of the tool and canonical arguments written ahead of the call. | `cli/src/core/operation_identity.ts`, `cli/src/core/state.ts`, `cli/src/agent.ts` | `cli/test/resume_reissue_interrupted.test.ts`, `cli/test/fault_kill_mid_tool_call.test.ts`, `cli/test/start_record_durability.test.ts` | Audit: recovery marked the operation interrupted but the model could re-issue the same effect on resume. |\n| I-EFFECT-4 | Dry-run never executes a mutating capability, in whichever layer would simulate it. The bridge simulates file edits and the shell; the spine simulates every other mutating capability (extension tools, the knowledge store). | `cli/src/core/spine.ts` | `cli/test/dry_run_effects.test.ts` | Audit: extension tools and `manage_knowledge` ran for real under `--dry-run` while their receipt said `simulated: true`. |\n| I-AUTH-1 | A repository cannot weaken verification-path protection. `.nexus-security.json` may set `mode` off or record, or `allow` paths, only in a workspace the operator has trusted; approve, block and `extra` only add protection and are always honoured. | `cli/src/security.ts` | `cli/test/verification_guard.test.ts` | Audit: cloning a repository that shipped `\"mode\": \"off\"` switched the guard off for the agent working in it. |\n| I-AUTH-2 | Every tool offered to the model has a capability with an explicit effect class. MCP and plugin tools are registered after connection as `extension` capabilities (conservative: mutating, `egress` for a remote server, `exec` for a local process or plugin), so the spine can run them and review mode asks first. | `cli/src/core/extension_capabilities.ts`, `cli/src/agent.ts` | `cli/test/mcp_tool_through_spine.test.ts` | Audit: every MCP tool call failed with `FAIL-001 not registered`; reproduced at runtime before the fix. |\n| I-AUTH-3 | The base URL an operator gives a provider follows the same rules as a provider file's: no credentials in the URL, no fragment, no cleartext http to a non-local host. The provider key is sent to that URL. | `cli/src/config.ts`, `cli/src/provider_safety.ts` | `cli/test/provider_safety.test.ts` | Audit: the override accepted `http://public-host/` and sent the API key in cleartext. |\n| I-AUTH-4 | A plugin's `onToolCall` hook is an observer: it receives a copy of the arguments, so it cannot change the path, command or content of a call the operator approved. | `cli/src/plugins.ts` | `cli/test/plugin_args_isolation.test.ts` | EI-3: reproduced (a plugin rewrote `args.path` of an approved call); the hook is typed to return void and documented as a notification. |\n| I-AUTH-5 | Concurrent refreshes of one provider's rotating refresh token share a single request in this process, and a file guard beside the credential store serialises them across processes; after taking the guard the store is re-read, so a sign-in another process just refreshed is used as it is instead of re-using a consumed token. The guard wait is bounded (10 s); on a timeout the refresh proceeds unguarded. | `cli/src/oauth.ts`, `cli/src/oauth_shared_refresh.ts` | `cli/test/oauth_refresh_singleflight.test.ts`, `cli/test/oauth_shared_refresh.test.ts` | EI-3: reproduced against a local issuer that rejects a reused token: the second of two concurrent refreshes failed. |\n| I-ACCEPT-1 | The validation receipt written at completion binds the verifier's actual output (its digest), not a constant, and a receipt that could not be persisted is not reported as a verified completion. | `cli/src/agent.ts` | `cli/test/completion_receipt_binding.test.ts` | Audit: `stdoutHash` was the hash of a fixed string, so two different runs produced identical receipts. |\n| I-ACCEPT-2 | A reviewer's ACCEPT, an engineering assessment or any model text never overrides a deterministic gate: a failing or absent verifier, a scope violation, or an unproven criterion forces REJECT. The reviewer's ACCEPT is evidence, not acceptance authority. A work unit's outcome equals its turn's outcome except for one named case (`unitOutcome`: a tester that ran a passing verifier this turn on a turn that needed none). | `cli/src/core/independent_review.ts`, `cli/src/core/operation_runner_execution.ts` | `cli/test/independent_review.test.ts`, `cli/test/ceri_semantic_integrity.test.ts`, `cli/test/unit_outcome.test.ts` | Existing control (credited, not new): `parseIndependentReviewVerdict` fails closed. Pinned here so the review contract cannot weaken it. |\n| I-PROVIDER-1 | A subagent sizes its requests from its own connection's advertised limits, discovered once, not from the 64k fallback. | `cli/src/agent.ts` | `cli/test/subagent_capability_discovery.test.ts` | Audit: `runSubagent` never called capability discovery; a helper on a 24k model was admitted against 65536. |\n| I-PROVIDER-2 | A chat answer ending with `finish_reason=content_filter` is not a complete answer. It is refused, not retried and not failed over. | `cli/src/client.ts` | `cli/test/client_robustness.test.ts` | Audit: a filtered answer was returned as the model's reply. |\n| I-PROVIDER-3 | A connection that writes a tool call as text even when a call is required (`tool_choice=required`) is recorded as not tool-capable and reported once to the operator; its text is never executed. A failed forced request says nothing about tool support. | `cli/src/client.ts` | `cli/test/content_tool_call.test.ts` | Audit P4 / EI-6: such a server was silently usable; the turn could not act and nothing said why. |\n| I-CHANGE-1 | The implementer prompt states the change-scope rules: smallest change, no abstraction nothing needs, a refactor keeps behaviour, find the reason before removing code, keep comments, tests and docs true, state side effects and unchecked assumptions. Instructions only: acceptance still rests on the verifier and the review. | `cli/src/agent.ts` | `cli/test/change_scope_prompt.test.ts` | Follow-up assignment 2026-11-17: nothing told the implementer about scope or rationale. The text is short on purpose: it is sent with every request and context-budget tests are calibrated against the prompt size. |\n| I-CHANGE-2 | The review verdict carries an engineering assessment (purpose, evidence, boundaryImpact, invariantImpact, failureBehaviour, maintainabilityImpact, validation, residualRisk). It is required, complete, for a significant change (five or more files, 300 or more changed lines, or any file under a core directory) and optional otherwise. A `change-risk:` defect (hidden side effect, unneeded abstraction, behaviour change inside a refactor, lost rationale) blocks ACCEPT. | `cli/src/core/independent_review.ts` | `cli/test/independent_review.test.ts`, `cli/test/ceri_semantic_integrity.test.ts` | Follow-up assignment 2026-11-17. Extends the existing verdict schema; adds no reviewer and no gate beyond the existing fail-closed parse. |\n\n## Where rationale lives (no append-only history)\n\n- The rule and its reason: the row above.\n- Why a specific line exists: the comment or test header at the enforcing code, which names the rule id.\n- Scenarios that exercise the rules with expected outcomes frozen outside the code: `cli/test/fixtures/ceri/semantic_integrity.scenarios.json` (category `change_cost` and the existing ones). These run real gating code with scripted inputs; they do not measure whether a live model produces the finding.\n- Roadmap and open work: `docs/v1.2.1/PLAN.md`.\n\nTrust, credential and models-cache stores are written through `writePrivateFile` (0600, atomic, fsynced for the first two, temporary file removed on failure): `cli/test/durable_private_writers.test.ts` (audit A2; a hygiene pin, not a rule of its own).\n\nA checkpoint restore now writes a `CHECKPOINT_RESTORED` event to the operation journal with where the previous task state was kept (`cli/test/operation_entry_integrity.test.ts`, part of I-LIFE-1).\n\n## Credited as already enforced (verified in this pass, not changed)\n\nReviewer cannot self-accept and a frozen, invariant-checked `TurnResult`; upgrade-journal recovery; the operation driver lock with merge reconciliation; per-endpoint credential and egress binding on failover; atomic task-state writes with quarantine of corrupt files; EXECUTION_UNKNOWN blocking replay of an operation unit; failover wait treats any non-5xx/429/408 answer as \"the server is serving\" (documented in `LocalLlmClient.probeAvailability`; a permanent auth failure must surface, not be waited out).\n\n## Decided\n\n- **Intent-record write failure stays fail-open, by decision (2026-11-17, resolving EI-1).** When the write-ahead record of a call cannot be written, the call still runs, because refusing every tool on a full or failing disk would stop all work while the workspace is still writable. It is never silent: a notice is emitted, the turn result carries `persistence.durable = false` with the failure text, and an operation unit whose turn is not durable is failed for the operator (`operation_runner_execution.ts`, \"persistence failure\"), so a degraded record cannot be accepted as a clean result. Pinned by `cli/test/durable_continuity.test.ts` (\"durable-write failures ... are reported through reportPersistenceFailure\"). Revisit only if a run must be provably recoverable after every call; that is a different mode, not a silent default.\n\n- **The start record is already fsynced (EI-2, closed: audit premise disproved).** The state store writes temp file, fsync, rename and directory fsync on every write; `cli/test/start_record_durability.test.ts` pins it. Cost on the dev host: about 3 ms per synced write.\n- **Spine hooks `processLifecycle`, `contextAdmission`, `evidenceEmission` stay no-op in production (EI-7, decided 2026-11-17).** They are extension seams for tests and embedders. Receipts reach the operator through the observer and the flight recorder, and context admission is decided in the agent; wiring them would add a second path for the same evidence. Deleting them would change a tested interface for no demonstrated failure. The hooks the agent depends on (`authorityAdmission`, `egressQuarantine`, `candidateMutation`) are installed in production.\n- **Task-state arrays are not normalised on load; the downstream guards stay (EI-7, decided).** Removing a guard needs a proof that no stored shape reaches it; none was found cheaper than the guard.\n- **No document claims a tamper-evident audit log (checked 2026-11-17).** The \"immutable\" wording in `docs/PHASE2_RECONCILED_REQUIREMENTS.md` is about candidate and invocation identities, which the code keeps stable; it is not a claim of a hash-chained log. Nexus does not have one, and none of its documents should be read as promising it.\n\n## Known gaps (recorded, not fixed here)\n\n| Gap | Why it stays open | Next step |\n|---|---|---|\n| The change-cost scenarios (A to H) are mechanism-level, and the live runs of five matching tasks (`docs/evidence/change-cost-live-2026-11-18/`) found no measurable difference between the base and branch builds (37/50 each at 10 runs per cell; a 14 vs 20 gap at 5 runs per cell did not replicate). The CHANGE SCOPE prompt rule (I-CHANGE-1) is therefore unproven as a behaviour change. | One model, 15 runs per cell at most, two tasks at ceiling; the reviewer path is not exercised. | A second model and tasks that drive the review contract, before any claim that the rules change outcomes. |\n/** docs/INVARIANTS.md is consistent with the code and tests it names (scripts/check_invariants.mjs). */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { execFileSync } from \"node:child_process\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n\ntest(\"every invariant row names existing code and a proving test, and code cites only defined rules\", () => {\n  const out = execFileSync(process.execPath, [path.join(root, \"scripts\", \"check_invariants.mjs\")], { encoding: \"utf8\" });\n  assert.match(out, /invariants: \\d+ rules/);\n});\n","exit_code":0,"duration":{"secs":0,"nanos":45487}},"started_at_ms":1795147188339,"completed_at_ms":1795147188340}}
{"timestamp":"2026-11-20T03:59:48.506Z","ordinal":29100,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1f71c-491a-7992-8bf9-6a9f66de725d","call_id":"call_55f2f992664346518c12e4e1078bfb8c","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"// Checks docs/INVARIANTS.md against the repository.\n//   - every rule row names enforcing files and test files that exist;\n//   - every rule id appears in at least one test (or fixture) under cli/test, so a rule has proof;\n//   - every `I-<AREA>-<n>` id written in cli/src or cli/test is a row in the table, so code cannot cite an undefined rule.\n// Exit 1 on any problem. Run from anywhere: paths resolve from this file.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst doc = fs.readFileSync(path.join(root, \"docs\", \"INVARIANTS.md\"), \"utf8\");\nconst problems = [];\n\nconst rows = doc.split(\"\\n\").filter((line) => /^\\| I-[A-Z]+-\\d+ \\|/.test(line)).map((line) => {\n  const cells = line.split(\"|\").slice(1, -1).map((c) => c.trim());\n  const files = (cell) => [...cell.matchAll(/`([^`]+)`/g)].map((m) => m[1]);\n  return { id: cells[0], enforced: files(cells[2] ?? \"\"), proofs: files(cells[3] ?? \"\") };\n});\nif (rows.length === 0) problems.push(\"no rule rows found in docs/INVARIANTS.md\");\nconst ids = new Set(rows.map((r) => r.id));\nif (ids.size !== rows.length) problems.push(\"a rule id appears twice\");\n\nfunction walk(dir) {\n  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {\n    const full = path.join(dir, e.name);\n    if (e.isDirectory()) return e.name === \"node_modules\" || e.name === \"dist\" ? [] : walk(full);\n    return /\\.(ts|mjs|json)$/.test(e.name) ? [full] : [];\n  });\n}\nconst testFiles = walk(path.join(root, \"cli\", \"test\"));\nconst srcFiles = walk(path.join(root, \"cli\", \"src\"));\nconst textOf = new Map([...testFiles, ...srcFiles].map((f) => [f, fs.readFileSync(f, \"utf8\")]));\n\nfor (const row of rows) {\n  if (row.enforced.length === 0) problems.push(`${row.id}: no enforcing file named`);\n  if (row.proofs.length === 0) problems.push(`${row.id}: no proving test named`);\n  for (const file of [...row.enforced, ...row.proofs]) {\n    if (!fs.existsSync(path.join(root, file))) problems.push(`${row.id}: ${file} does not exist`);\n  }\n  const mentioned = testFiles.some((f) => textOf.get(f).includes(row.id));\n  if (!mentioned) problems.push(`${row.id}: no test or fixture under cli/test mentions this id`);\n}\nfor (const [file, text] of textOf) {\n  for (const match of text.matchAll(/\\bI-[A-Z]+-\\d+\\b/g)) {\n    if (!ids.has(match[0])) problems.push(`${path.relative(root, file)}: cites ${match[0]}, which is not a row in docs/INVARIANTS.md`);\n  }\n}\n\nif (problems.length) {\n  for (const p of [...new Set(problems)]) console.error(`invariants: ${p}`);\n  process.exit(1);\n}\nconsole.log(`invariants: ${rows.length} rules, each with enforcing code and a proving test`);\n# Engineering invariants: execution authority, side effects, failure semantics, change cost\n\nStatus: in force on `v1/invariants-impl` (not yet released). This file is the map from each rule to the code that enforces it, the test that proves it, and why it exists. It is checked by `node scripts/check_invariants.mjs`, so a row cannot point at a file that moved, and a rule named in code or tests cannot be missing here. It replaces no other document: `docs/EXECUTION_CONVERGENCE.md` describes the spine, `docs/v1.2.0/SEMANTIC_AND_ARCHITECTURAL_INTEGRITY.md` the acceptance gates.\n\nHow to read a row: **Enforced in** is the authoritative boundary (where the rule is decided, not where it is described). **Proven by** is a test that fails if the rule is removed. **Why** is the incident or audit finding, so a later change can tell a deliberate rule from an accident.\n\n## Rules\n\n| ID | Invariant | Enforced in | Proven by | Why (provenance) |\n|---|---|---|---|---|\n| I-LIFE-1 | A lifecycle change is decided at the authoritative boundary, under the driver lock: `run` never overwrites an existing operation id; `resume` and `decide` re-read the record after the lock is held; a COMPLETE operation or unit never leaves COMPLETE; unknown statuses and unknown decision action kinds are rejected at load, and the decision switch is exhaustive at compile time. | `cli/src/core/operation_runner.ts`, `cli/src/core/operation_schema.ts`, `cli/src/core/operation_runner_persistence.ts` | `cli/test/operation_entry_integrity.test.ts`, `cli/test/operation_schema.test.ts` | Audit 2026-11-17: `operation_cli.ts` loaded state before the lock was taken, so a stale snapshot could be written over a finished record; `run` with an existing id replaced its history. |\n| I-LIFE-3 | An upgrade lock is held only by a process that can still be the upgrader: a lock written before a reboot, or older than the longest plausible upgrade (6 h), is stale even if its pid is alive, so a reused pid cannot wedge recovery. Older locks without these fields keep the pid check. | `cli/src/upgrade_journal.ts`, `cli/src/doctor.ts` | `cli/test/upgrade_transaction_recovery.test.ts`, `cli/test/doctor_lock_window.test.ts` | EI-4: liveness was pid-only (and `doctor --fix`'s own lock took over a lock whose pid was not yet written, so it could steal a live one: an empty or unreadable pid on a file under 5 s old is now held, `cli/test/doctor_lock_window.test.ts`); after a reboot a pid could belong to an unrelated process and recovery reported \"upgrade in progress\" forever. |\n| I-EFFECT-1 | A mutating MCP `tools/call` over HTTP is delivered at most once per model request. Only a definitive \"no such route\" answer (404/405/501 from `/message`) may fall back to the legacy URL; any other failure is reported as unknown. | `cli/src/mcp.ts` | `cli/test/mcp_tool_call_delivery.test.ts` | Audit 2026-11-17: `sendRequest` re-POSTed the same payload after any fetch failure, including a reset or timeout after the server had received it. |\n| I-EFFECT-2 | An unknown outcome (timeout, cancel, lost connection) is never reported as a confirmed failure. The receipt says OUTCOME UNKNOWN, and a mutating tool in that state counts as possibly mutated, so the unverified-change obligation is raised. | `cli/src/core/spine.ts`, `cli/src/tools.ts`, `cli/src/types.ts` | `cli/test/spine_unknown_outcome.test.ts` | Audit: a timed-out `write_file` produced `candidateMutated=false`, so the workspace could change with no verification owed. |\n| I-EFFECT-3 | A call identical to one whose outcome was left unknown by a crash is not re-issued silently on resume, even in auto mode: it needs an explicit approval. The identity is a hash of the tool and canonical arguments written ahead of the call. | `cli/src/core/operation_identity.ts`, `cli/src/core/state.ts`, `cli/src/agent.ts` | `cli/test/resume_reissue_interrupted.test.ts`, `cli/test/fault_kill_mid_tool_call.test.ts`, `cli/test/start_record_durability.test.ts` | Audit: recovery marked the operation interrupted but the model could re-issue the same effect on resume. |\n| I-EFFECT-4 | Dry-run never executes a mutating capability, in whichever layer would simulate it. The bridge simulates file edits and the shell; the spine simulates every other mutating capability (extension tools, the knowledge store). | `cli/src/core/spine.ts` | `cli/test/dry_run_effects.test.ts` | Audit: extension tools and `manage_knowledge` ran for real under `--dry-run` while their receipt said `simulated: true`. |\n| I-AUTH-1 | A repository cannot weaken verification-path protection. `.nexus-security.json` may set `mode` off or record, or `allow` paths, only in a workspace the operator has trusted; approve, block and `extra` only add protection and are always honoured. | `cli/src/security.ts` | `cli/test/verification_guard.test.ts` | Audit: cloning a repository that shipped `\"mode\": \"off\"` switched the guard off for the agent working in it. |\n| I-AUTH-2 | Every tool offered to the model has a capability with an explicit effect class. MCP and plugin tools are registered after connection as `extension` capabilities (conservative: mutating, `egress` for a remote server, `exec` for a local process or plugin), so the spine can run them and review mode asks first. | `cli/src/core/extension_capabilities.ts`, `cli/src/agent.ts` | `cli/test/mcp_tool_through_spine.test.ts` | Audit: every MCP tool call failed with `FAIL-001 not registered`; reproduced at runtime before the fix. |\n| I-AUTH-3 | The base URL an operator gives a provider follows the same rules as a provider file's: no credentials in the URL, no fragment, no cleartext http to a non-local host. The provider key is sent to that URL. | `cli/src/config.ts`, `cli/src/provider_safety.ts` | `cli/test/provider_safety.test.ts` | Audit: the override accepted `http://public-host/` and sent the API key in cleartext. |\n| I-AUTH-4 | A plugin's `onToolCall` hook is an observer: it receives a copy of the arguments, so it cannot change the path, command or content of a call the operator approved. | `cli/src/plugins.ts` | `cli/test/plugin_args_isolation.test.ts` | EI-3: reproduced (a plugin rewrote `args.path` of an approved call); the hook is typed to return void and documented as a notification. |\n| I-AUTH-5 | Concurrent refreshes of one provider's rotating refresh token share a single request in this process, and a file guard beside the credential store serialises them across processes; after taking the guard the store is re-read, so a sign-in another process just refreshed is used as it is instead of re-using a consumed token. The guard wait is bounded (10 s); on a timeout the refresh proceeds unguarded. | `cli/src/oauth.ts`, `cli/src/oauth_shared_refresh.ts` | `cli/test/oauth_refresh_singleflight.test.ts`, `cli/test/oauth_shared_refresh.test.ts` | EI-3: reproduced against a local issuer that rejects a reused token: the second of two concurrent refreshes failed. |\n| I-ACCEPT-1 | The validation receipt written at completion binds the verifier's actual output (its digest), not a constant, and a receipt that could not be persisted is not reported as a verified completion. | `cli/src/agent.ts` | `cli/test/completion_receipt_binding.test.ts` | Audit: `stdoutHash` was the hash of a fixed string, so two different runs produced identical receipts. |\n| I-ACCEPT-2 | A reviewer's ACCEPT, an engineering assessment or any model text never overrides a deterministic gate: a failing or absent verifier, a scope violation, or an unproven criterion forces REJECT. The reviewer's ACCEPT is evidence, not acceptance authority. A work unit's outcome equals its turn's outcome except for one named case (`unitOutcome`: a tester that ran a passing verifier this turn on a turn that needed none). | `cli/src/core/independent_review.ts`, `cli/src/core/operation_runner_execution.ts` | `cli/test/independent_review.test.ts`, `cli/test/ceri_semantic_integrity.test.ts`, `cli/test/unit_outcome.test.ts` | Existing control (credited, not new): `parseIndependentReviewVerdict` fails closed. Pinned here so the review contract cannot weaken it. |\n| I-PROVIDER-1 | A subagent sizes its requests from its own connection's advertised limits, discovered once, not from the 64k fallback. | `cli/src/agent.ts` | `cli/test/subagent_capability_discovery.test.ts` | Audit: `runSubagent` never called capability discovery; a helper on a 24k model was admitted against 65536. |\n| I-PROVIDER-2 | A chat answer ending with `finish_reason=content_filter` is not a complete answer. It is refused, not retried and not failed over. | `cli/src/client.ts` | `cli/test/client_robustness.test.ts` | Audit: a filtered answer was returned as the model's reply. |\n| I-PROVIDER-3 | A connection that writes a tool call as text even when a call is required (`tool_choice=required`) is recorded as not tool-capable and reported once to the operator; its text is never executed. A failed forced request says nothing about tool support. | `cli/src/client.ts` | `cli/test/content_tool_call.test.ts` | Audit P4 / EI-6: such a server was silently usable; the turn could not act and nothing said why. |\n| I-CHANGE-1 | The implementer prompt states the change-scope rules: smallest change, no abstraction nothing needs, a refactor keeps behaviour, find the reason before removing code, keep comments, tests and docs true, state side effects and unchecked assumptions. Instructions only: acceptance still rests on the verifier and the review. | `cli/src/agent.ts` | `cli/test/change_scope_prompt.test.ts` | Follow-up assignment 2026-11-17: nothing told the implementer about scope or rationale. The text is short on purpose: it is sent with every request and context-budget tests are calibrated against the prompt size. |\n| I-CHANGE-2 | The review verdict carries an engineering assessment (purpose, evidence, boundaryImpact, invariantImpact, failureBehaviour, maintainabilityImpact, validation, residualRisk). It is required, complete, for a significant change (five or more files, 300 or more changed lines, or any file under a core directory) and optional otherwise. A `change-risk:` defect (hidden side effect, unneeded abstraction, behaviour change inside a refactor, lost rationale) blocks ACCEPT. | `cli/src/core/independent_review.ts` | `cli/test/independent_review.test.ts`, `cli/test/ceri_semantic_integrity.test.ts` | Follow-up assignment 2026-11-17. Extends the existing verdict schema; adds no reviewer and no gate beyond the existing fail-closed parse. |\n\n## Where rationale lives (no append-only history)\n\n- The rule and its reason: the row above.\n- Why a specific line exists: the comment or test header at the enforcing code, which names the rule id.\n- Scenarios that exercise the rules with expected outcomes frozen outside the code: `cli/test/fixtures/ceri/semantic_integrity.scenarios.json` (category `change_cost` and the existing ones). These run real gating code with scripted inputs; they do not measure whether a live model produces the finding.\n- Roadmap and open work: `docs/v1.2.1/PLAN.md`.\n\nTrust, credential and models-cache stores are written through `writePrivateFile` (0600, atomic, fsynced for the first two, temporary file removed on failure): `cli/test/durable_private_writers.test.ts` (audit A2; a hygiene pin, not a rule of its own).\n\nA checkpoint restore now writes a `CHECKPOINT_RESTORED` event to the operation journal with where the previous task state was kept (`cli/test/operation_entry_integrity.test.ts`, part of I-LIFE-1).\n\n## Credited as already enforced (verified in this pass, not changed)\n\nReviewer cannot self-accept and a frozen, invariant-checked `TurnResult`; upgrade-journal recovery; the operation driver lock with merge reconciliation; per-endpoint credential and egress binding on failover; atomic task-state writes with quarantine of corrupt files; EXECUTION_UNKNOWN blocking replay of an operation unit; failover wait treats any non-5xx/429/408 answer as \"the server is serving\" (documented in `LocalLlmClient.probeAvailability`; a permanent auth failure must surface, not be waited out).\n\n## Decided\n\n- **Intent-record write failure stays fail-open, by decision (2026-11-17, resolving EI-1).** When the write-ahead record of a call cannot be written, the call still runs, because refusing every tool on a full or failing disk would stop all work while the workspace is still writable. It is never silent: a notice is emitted, the turn result carries `persistence.durable = false` with the failure text, and an operation unit whose turn is not durable is failed for the operator (`operation_runner_execution.ts`, \"persistence failure\"), so a degraded record cannot be accepted as a clean result. Pinned by `cli/test/durable_continuity.test.ts` (\"durable-write failures ... are reported through reportPersistenceFailure\"). Revisit only if a run must be provably recoverable after every call; that is a different mode, not a silent default.\n\n- **The start record is already fsynced (EI-2, closed: audit premise disproved).** The state store writes temp file, fsync, rename and directory fsync on every write; `cli/test/start_record_durability.test.ts` pins it. Cost on the dev host: about 3 ms per synced write.\n- **Spine hooks `processLifecycle`, `contextAdmission`, `evidenceEmission` stay no-op in production (EI-7, decided 2026-11-17).** They are extension seams for tests and embedders. Receipts reach the operator through the observer and the flight recorder, and context admission is decided in the agent; wiring them would add a second path for the same evidence. Deleting them would change a tested interface for no demonstrated failure. The hooks the agent depends on (`authorityAdmission`, `egressQuarantine`, `candidateMutation`) are installed in production.\n- **Task-state arrays are not normalised on load; the downstream guards stay (EI-7, decided).** Removing a guard needs a proof that no stored shape reaches it; none was found cheaper than the guard.\n- **No document claims a tamper-evident audit log (checked 2026-11-17).** The \"immutable\" wording in `docs/PHASE2_RECONCILED_REQUIREMENTS.md` is about candidate and invocation identities, which the code keeps stable; it is not a claim of a hash-chained log. Nexus does not have one, and none of its documents should be read as promising it.\n\n## Known gaps (recorded, not fixed here)\n\n| Gap | Why it stays open | Next step |\n|---|---|---|\n| The change-cost scenarios (A to H) are mechanism-level, and the live runs of five matching tasks (`docs/evidence/change-cost-live-2026-11-18/`) found no measurable difference between the base and branch builds (37/50 each at 10 runs per cell; a 14 vs 20 gap at 5 runs per cell did not replicate). The CHANGE SCOPE prompt rule (I-CHANGE-1) is therefore unproven as a behaviour change. | One model, 15 runs per cell at most, two tasks at ceiling; the reviewer path is not exercised. | A second model and tasks that drive the review contract, before any claim that the rules change outcomes. |\n/** docs/INVARIANTS.md is consistent with the code and tests it names (scripts/check_invariants.mjs). */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { execFileSync } from \"node:child_process\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n\ntest(\"every invariant row names existing code and a proving test, and code cites only defined rules\", () => {\n  const out = execFileSync(process.execPath, [path.join(root, \"scripts\", \"check_invariants.mjs\")], { encoding: \"utf8\" });\n  assert.match(out, /invariants: \\d+ rules/);\n});\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1f712-aaf3-7db1-9f93-ddce93b124cb","create_time":1795147188.5067797}},"metadata":{"history_sequence":12840,"sampled_through_sequence":12835,"client_authored":false,"fallback_token_limit_override":12000}}
