{"timestamp":"2026-11-02T22:51:13.992Z","ordinal":49246,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"CommandExecution","id":"exec-acceaf6a-1cb3-4867-bc18-3deab51ebf77","process_id":"46377","command":["/usr/bin/zsh","-lc","sed -n '1,100p' scripts/package-linux.sh; sed -n '1,110p' scripts/repro-identity.mjs; git diff -- scripts/package-linux.sh"],"cwd":"file:///home/mike/nexus-wt/v112-integrated-exact","parsed_cmd":[{"type":"unknown","cmd":"sed -n '1,100p' scripts/package-linux.sh; sed -n '1,110p' scripts/repro-identity.mjs; git diff -- scripts/package-linux.sh"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n\n# An externally selected package tool may target a separate immutable RC checkout, but it must\n# still run from that checkout so version, source and lockfile identity stay bound together.\nROOT=${NEXUS_PACKAGE_SOURCE:-$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)}\nROOT=$(cd \"$ROOT\" && pwd -P)\nif [[ -n \"${NEXUS_PACKAGE_SOURCE:-}\" ]]; then\n  CALLER_ROOT=$(git rev-parse --show-toplevel)\n  SOURCE_ROOT=$(git -C \"$ROOT\" rev-parse --show-toplevel)\n  if [[ \"$ROOT\" != \"$CALLER_ROOT\" || \"$ROOT\" != \"$SOURCE_ROOT\" ]]; then\n    echo \"NEXUS_PACKAGE_SOURCE must be the current Git worktree root\" >&2\n    exit 2\n  fi\nfi\nVERSION=${1:?usage: package-linux.sh VERSION OUTPUT_DIR}\nOUT=${2:?usage: package-linux.sh VERSION OUTPUT_DIR}\nAPPROVED_RUST_BUILD_IMAGE='rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb'\ncase \"$VERSION\" in v[0-9]*.[0-9]*.[0-9]*) ;; *) echo \"version must look like v1.2.3\" >&2; exit 2 ;; esac\nif [[ -z \"${NEXUS_BUILD_CONTAINER_IMAGE:-}\" ]]; then\n  if [[ \"${NEXUS_ALLOW_HOST_RUST_BUILD:-}\" != \"1\" ]]; then\n    echo \"NEXUS_BUILD_CONTAINER_IMAGE must use the approved digest-pinned Rust 1.95 Bookworm builder (set NEXUS_ALLOW_HOST_RUST_BUILD=1 only for local development)\" >&2\n    exit 2\n  fi\nelif [[ \"$NEXUS_BUILD_CONTAINER_IMAGE\" != \"$APPROVED_RUST_BUILD_IMAGE\" ]]; then\n  echo \"NEXUS_BUILD_CONTAINER_IMAGE must use the approved digest-pinned Rust 1.95 Bookworm builder\" >&2\n  exit 2\nfi\nmkdir -p \"$OUT\"\nOUT=$(cd \"$OUT\" && pwd -P)\nWORK=$(mktemp -d)\ntrap 'rm -rf \"$WORK\"' EXIT\n\nnpm --prefix \"$ROOT/cli\" ci\nnpm --prefix \"$ROOT/cli\" run build\n\nif [[ -n \"${NEXUS_BUILD_CONTAINER_IMAGE:-}\" ]]; then\n  if [[ ! \"$NEXUS_BUILD_CONTAINER_IMAGE\" =~ @sha256:[0-9a-f]{64}$ ]]; then\n    echo \"NEXUS_BUILD_CONTAINER_IMAGE must be pinned by sha256 digest\" >&2\n    exit 2\n  fi\n  command -v docker >/dev/null || { echo \"docker is required for the pinned Rust build image\" >&2; exit 2; }\n  mkdir -p \"$WORK/rust-build\"\n  docker run --rm --pull=always --platform linux/amd64 \\\n    --user \"$(id -u):$(id -g)\" \\\n    --mount \"type=bind,src=$ROOT,dst=/nexus-source,readonly\" \\\n    --mount \"type=bind,src=$WORK/rust-build,dst=/nexus-build\" \\\n    --workdir /nexus-source \\\n    --env HOME=/tmp/nexus-package-build-home \\\n    --env CARGO_HOME=/nexus-build/cargo-home \\\n    --env CARGO_TARGET_DIR=/nexus-build/target \\\n    --env RUSTUP_HOME=/usr/local/rustup \\\n    \"$NEXUS_BUILD_CONTAINER_IMAGE\" \\\n    cargo build --locked --release --manifest-path /nexus-source/core/Cargo.toml --bin harness-core --bin nexus-tui\n  RUST_CORE_TARGET=\"$WORK/rust-build/target/release\"\nelse\n  cargo build --locked --release --manifest-path \"$ROOT/core/Cargo.toml\" --bin harness-core --bin nexus-tui\n  RUST_CORE_TARGET=\"$ROOT/core/target/release\"\nfi\n\nPKG=\"$WORK/nexus\"\nmkdir -p \"$PKG/bin\" \"$PKG/lib/core\" \"$PKG/lib/cli\"\ncp -R \"$ROOT/cli/dist\" \"$PKG/lib/cli/dist\"\ncp \"$ROOT/cli/package.json\" \"$ROOT/cli/package-lock.json\" \"$PKG/lib/cli/\"\nnpm ci --omit=dev --prefix \"$PKG/lib/cli\"\ncp \"$RUST_CORE_TARGET/harness-core\" \"$RUST_CORE_TARGET/nexus-tui\" \"$PKG/lib/core/\"\nnode \"$ROOT/scripts/stage_eval_runtime.mjs\" \"$ROOT\" \"$PKG\"\ncommand -v readelf >/dev/null || { echo \"readelf is required to verify package glibc compatibility\" >&2; exit 2; }\nfor binary in \"$PKG/lib/core/harness-core\" \"$PKG/lib/core/nexus-tui\"; do\n  required_glibc=$(readelf --version-info --wide \"$binary\" | grep -oE 'Name: GLIBC_[0-9]+(\\.[0-9]+)+' | sed 's/.*GLIBC_//' | sort -V | tail -n 1)\n  if [[ -n \"$required_glibc\" ]]; then\n    IFS=. read -r glibc_major glibc_minor _ <<< \"$required_glibc\"\n    if (( glibc_major > 2 || (glibc_major == 2 && glibc_minor > 35) )); then\n      echo \"$binary requires GLIBC_$required_glibc, above the GLIBC_2.35 compatibility ceiling\" >&2\n      exit 1\n    fi\n  fi\ndone\ncp \"$ROOT/LICENSE\" \"$PKG/LICENSE\"\nprintf '%s\\n' \"$VERSION\" > \"$PKG/VERSION\"\n\nSOURCE_DATE_EPOCH=$(git -C \"$ROOT\" log -1 --format=%ct)\nexport SOURCE_DATE_EPOCH\nGIT_COMMIT=$(git -C \"$ROOT\" rev-parse HEAD)\nBUILD_DATE=$(date -u -d \"@$SOURCE_DATE_EPOCH\" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r \"$SOURCE_DATE_EPOCH\" +%Y-%m-%dT%H:%M:%SZ)\nARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\nSTATE_SCHEMA_VERSION=$(node --input-type=module - \"$PKG/lib/cli/dist/core/state.js\" <<'EOF'\nimport { pathToFileURL } from 'node:url';\nconst { CURRENT_STATE_SCHEMA_VERSION: version } = await import(pathToFileURL(process.argv[2]).href);\nif (!Number.isSafeInteger(version) || version < 1) throw new Error('packaged client has no valid state schema');\nprocess.stdout.write(String(version));\nEOF\n)\n\n# Embed the compatibility contract in the attested archive. The detached asset\n# adds the archive digest after the archive is built and is covered by SHA256SUMS.\ncat > \"$PKG/compatibility.json\" <<EOF\n{\n  \"schemaVersion\": 1,\n  \"product\": \"nexus-code\",\n// Source identity for the cross-runner reproducibility workflow (ACC-SUP-08, REQ-REL-114).\n//   record  <version> <dist-dir> <out.json> <runner-label>   identity of the checked-out RC source, package tool, workflow, toolchain and artifacts\n//   compare <expected-version> <expected-commit> <expected-workflow-commit> <out.json> <identity.json>...\n// `compare` fails unless every builder packaged the expected version and commit from identical source and lockfiles\n// and produced identical artifact digests; on success it writes the combined evidence record.\nimport { createHash } from \"node:crypto\";\nimport { execFileSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst LOCKFILES = [\"cli/package-lock.json\", \"core/Cargo.lock\", \"rust-toolchain.toml\", \"scripts/release-tools/package-lock.json\"];\nconst BUILDERS = [\"ubuntu-22.04\", \"ubuntu-24.04\"];\nconst RELEASE_ASSETS = [\"compatibility.json\", \"SHA256SUMS\", \"THIRD_PARTY_NOTICES.txt\", \"sbom.cdx.json\", \"install.sh\"];\nconst APPROVED_RUST_BUILD_IMAGE = \"rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\";\nconst sha256 = (file) => createHash(\"sha256\").update(fs.readFileSync(file)).digest(\"hex\");\nconst run = (cmd, ...argv) => execFileSync(cmd, argv, { encoding: \"utf8\" }).trim();\nconst fail = (message) => { console.error(`repro-identity: ${message}`); process.exit(1); };\n\nconst [mode, ...rest] = process.argv.slice(2);\nif (mode === \"record\") {\n  const [version, dist, out, label] = rest;\n  if (!version || !dist || !out || !label) fail(\"usage: record <version> <dist-dir> <out.json> <runner-label>\");\n  if (process.env.NEXUS_BUILD_CONTAINER_IMAGE !== APPROVED_RUST_BUILD_IMAGE) fail(\"Rust build image is not the approved digest-pinned Bookworm builder\");\n  if (process.env.GITHUB_REF !== \"refs/heads/main\") fail(\"reproducibility workflow must run from reviewed main\");\n  // Packaging must not have changed tracked source: the artifacts must still correspond to the recorded commit.\n  const dirty = run(\"git\", \"status\", \"--porcelain\", \"--untracked-files=no\");\n  if (dirty) fail(`packaging modified tracked files:\\n${dirty}`);\n  const commit = run(\"git\", \"rev-parse\", \"HEAD\");\n  const tagCommit = run(\"git\", \"rev-parse\", `refs/tags/${version}^{commit}`);\n  if (tagCommit !== commit) fail(`fetched tag ${version} resolves to ${tagCommit}, not checked-out source commit ${commit}`);\n  const workflowSha = process.env.GITHUB_WORKFLOW_SHA ?? \"\";\n  if (!/^[0-9a-f]{40}$/.test(workflowSha)) fail(\"reviewed main workflow commit is missing or invalid\");\n  const packageToolCommit = process.env.NEXUS_PACKAGE_TOOL_COMMIT ?? \"\";\n  const packageToolScript = process.env.NEXUS_PACKAGE_TOOL_SCRIPT ?? \"\";\n  if (!/^[0-9a-f]{40}$/.test(packageToolCommit) || packageToolCommit !== workflowSha) fail(\"packaging tool commit must be the exact reviewed workflow commit\");\n  if (!packageToolScript || !fs.existsSync(packageToolScript)) fail(\"packaging tool script identity is missing\");\n  if (!fs.statSync(packageToolScript).isFile()) fail(\"packaging tool script identity must name a file\");\n  const reviewedPackageScript = execFileSync(\"git\", [\"show\", `${packageToolCommit}:scripts/package-linux.sh`], { encoding: \"utf8\" });\n  if (reviewedPackageScript !== fs.readFileSync(packageToolScript, \"utf8\")) fail(\"packaging script does not match the reviewed tool commit\");\n  const artifactNames = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n  const missingArtifacts = artifactNames.filter((file) => !fs.existsSync(path.join(dist, file)));\n  if (missingArtifacts.length) fail(`release output is missing required assets: ${missingArtifacts.join(\", \")}`);\n  const identity = {\n    source: {\n      version,\n      commit,\n      tree: run(\"git\", \"rev-parse\", \"HEAD^{tree}\"),\n      tagObject: run(\"git\", \"rev-parse\", `refs/tags/${version}`),\n      tagCommit,\n      lockfiles: Object.fromEntries(LOCKFILES.map((file) => [file, sha256(file)])),\n      // Non-ignored untracked files could be packaged without being part of the commit; both builders must agree.\n      untracked: run(\"git\", \"ls-files\", \"--others\", \"--exclude-standard\").split(\"\\n\").filter(Boolean),\n    },\n    toolchain: { node: process.version, npm: run(\"npm\", \"--version\"), rustc: run(\"rustc\", \"-V\"), cargo: run(\"cargo\", \"-V\") },\n    buildEnvironment: { rustContainerImage: process.env.NEXUS_BUILD_CONTAINER_IMAGE ?? null },\n    packagingTool: { commit: packageToolCommit, packageScriptSha256: sha256(packageToolScript) },\n    runner: { label, image: process.env.ImageOS ?? null, imageVersion: process.env.ImageVersion ?? null },\n    workflow: { ref: process.env.GITHUB_REF ?? null, sha: workflowSha, runId: process.env.GITHUB_RUN_ID ?? null, runAttempt: process.env.GITHUB_RUN_ATTEMPT ?? null },\n    artifacts: Object.fromEntries(artifactNames.map((file) => [file, sha256(path.join(dist, file))])),\n  };\n  fs.writeFileSync(out, `${JSON.stringify(identity, null, 2)}\\n`);\n} else if (mode === \"compare\") {\n  const [version, commit, workflowCommit, out, ...files] = rest;\n  if (!version || !/^[0-9a-f]{40}$/.test(commit ?? \"\") || !/^[0-9a-f]{40}$/.test(workflowCommit ?? \"\") || !out || files.length < 2) fail(\"usage: compare <version> <commit> <workflow-commit> <out.json> <identity.json> <identity.json>...\");\n  const builders = files.map((file) => JSON.parse(fs.readFileSync(file, \"utf8\")));\n  for (const id of builders) {\n    if (id.source.version !== version || id.source.commit !== commit) fail(`${id.runner.label} packaged ${id.source.version}@${id.source.commit}, not ${version}@${commit}`);\n  }\n  const [first] = builders;\n  const labels = builders.map((id) => id.runner.label).sort();\n  if (JSON.stringify(labels) !== JSON.stringify(BUILDERS)) fail(`builders must be exactly ${BUILDERS.join(\", \")}; got ${labels.join(\", \")}`);\n  if (builders.some((id) => !id.runner.image || !id.runner.imageVersion)) fail(\"every builder must record its runner image and image version\");\n  const buildImages = builders.map((id) => id.buildEnvironment?.rustContainerImage);\n  if (buildImages.some((image) => image !== APPROVED_RUST_BUILD_IMAGE)) fail(\"every builder must use the approved digest-pinned Bookworm Rust build image\");\n  if (new Set(buildImages).size !== 1) fail(\"builders used different Rust build images\");\n  const packageToolCommits = builders.map((id) => id.packagingTool?.commit);\n  const packageToolHashes = builders.map((id) => id.packagingTool?.packageScriptSha256);\n  if (packageToolCommits.some((value) => value !== workflowCommit) || packageToolHashes.some((value) => !/^[0-9a-f]{64}$/.test(value ?? \"\"))) fail(\"builders did not record the exact reviewed packaging tool commit and script hash\");\n  if (new Set(packageToolHashes).size !== 1) fail(\"builders used different packaging tool scripts\");\n  // The released workflow is reviewed on main; the built product source remains bound to the exact RC tag commit above.\n  for (const id of builders) {\n    if (id.workflow?.ref !== \"refs/heads/main\" || id.workflow?.sha !== workflowCommit) fail(`${id.runner.label} did not record the expected reviewed main workflow commit ${workflowCommit}`);\n  }\n  if (new Set(builders.map((id) => id.workflow.sha)).size !== 1) fail(\"builders used different workflow definitions\");\n  if (new Set(builders.map((id) => `${id.workflow.runId}/${id.workflow.runAttempt}`)).size !== 1) fail(\"builders belong to different workflow runs\");\n  if (builders.some((id) => JSON.stringify(id.source) !== JSON.stringify(first.source))) fail(\"builders packaged different source or lockfiles\");\n  if (builders.some((id) => JSON.stringify(id.artifacts) !== JSON.stringify(first.artifacts))) fail(\"artifact digests differ between builders\");\n  const expectedAssets = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n  if (JSON.stringify(Object.keys(first.artifacts).sort()) !== JSON.stringify(expectedAssets)) fail(\"identity evidence does not cover the six selected reproducibility artifacts\");\n  const workflowRun = process.env.GITHUB_RUN_ID ? `${process.env.GITHUB_SERVER_URL}/${process.env.GITHUB_REPOSITORY}/actions/runs/${process.env.GITHUB_RUN_ID}` : null;\n  const evidence = { requirement: \"REQ-REL-114\", acceptance: \"ACC-SUP-08\", result: \"PASS\", workflowRun, workflow: first.workflow, source: first.source, buildEnvironment: first.buildEnvironment, packagingTool: first.packagingTool, artifacts: first.artifacts, builders: builders.map(({ runner, toolchain }) => ({ runner, toolchain })) };\n  fs.writeFileSync(out, `${JSON.stringify(evidence, null, 2)}\\n`);\n} else {\n  fail(\"mode must be record or compare\");\n}\ndiff --git a/scripts/package-linux.sh b/scripts/package-linux.sh\nindex 5f410376..606b1f23 100644\n--- a/scripts/package-linux.sh\n+++ b/scripts/package-linux.sh\n@@ -64,6 +64,7 @@ cp -R \"$ROOT/cli/dist\" \"$PKG/lib/cli/dist\"\n cp \"$ROOT/cli/package.json\" \"$ROOT/cli/package-lock.json\" \"$PKG/lib/cli/\"\n npm ci --omit=dev --prefix \"$PKG/lib/cli\"\n cp \"$RUST_CORE_TARGET/harness-core\" \"$RUST_CORE_TARGET/nexus-tui\" \"$PKG/lib/core/\"\n+node \"$ROOT/scripts/stage_eval_runtime.mjs\" \"$ROOT\" \"$PKG\"\n command -v readelf >/dev/null || { echo \"readelf is required to verify package glibc compatibility\" >&2; exit 2; }\n for binary in \"$PKG/lib/core/harness-core\" \"$PKG/lib/core/nexus-tui\"; do\n   required_glibc=$(readelf --version-info --wide \"$binary\" | grep -oE 'Name: GLIBC_[0-9]+(\\.[0-9]+)+' | sed 's/.*GLIBC_//' | sort -V | tail -n 1)\n","exit_code":0,"duration":{"secs":0,"nanos":705826842}},"started_at_ms":1793659873286,"completed_at_ms":1793659873992}}
