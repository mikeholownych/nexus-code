{"timestamp":"2026-10-28T13:41:53.562Z","ordinal":458101,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a182b5-7df6-71b2-a955-13339511caaf","item":{"type":"McpToolCall","id":"exec-b6c5700d-3d6b-4366-a3cb-333722bb1923","server":"xerj","tool":"xerj_search","arguments":{"prefix":"nexus-cli","query":"assertGitSnapshotTargetsReplaceable gitRefBlobPaths restore read-tree checkout-index","size":4,"max_tokens":1500},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /nexus-cli-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"assertGitSnapshotTargetsReplaceable gitRefBlobPaths restore read-tree checkout-index\",\"k\":10}}}}}]},\"took\":435,\"timed_out\":false,\"_shards\":{\"total\":1,\"successful\":1,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":96,\"relation\":\"eq\"},\"max_score\":39.499176,\"hits\":[{\"_index\":\"nexus-cli-docs\",\"_id\":\"c809da1acca0ab7f0674c48bb11b7c0c\",\"_score\":39.499176,\"_source\":{\"title\":\"checkpoint.ts\",\"ax_path\":\"checkpoint.ts\",\"ax_file\":\"axf2-cf607e9b77c403fe2763f3e696113466-4ea6\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":366,\"start_offset\":15551,\"end_offset\":18493,\"text\":\"public pruneCheckpoints(keepCount: number = 20): { prunedCount: number; message: string } {\\n    const checkpoints = this.listCheckpoints();\\n    if (checkpoints.length <= keepCount) {\\n      return { prunedCount: 0, message: `No pruning needed (${checkpoints.length} checkpoints <= limit of ${keepCount}).` };\\n    }\\n\\n    const toPrune = checkpoints.slice(keepCount);\\n    let count = 0;\\n    const failures: string[] = [];\\n\\n    for (const cp of toPrune) {\\n      let deletedRefTarget: string | undefined;\\n      let hookEnv: NodeJS.ProcessEnv | undefined;\\n      const ref = cp.gitRef ? `refs/nexus/checkpoints/${cp.id}` : undefined;\\n      try {\\n        const jsonPath = path.join(this.checkpointDir, `${cp.id}.json`);\\n        if (this.isGit && ref) {\\n          // Resolve hook suppression before mutating checkpoint state. Git 2.54 cannot\\n          // suppress every configured hook without a discovery race, so retain the record.\\n          hookEnv = envWithoutConfiguredHooks(this.workspace, [\\\"reference-transaction\\\"]);\\n          try {\\n            deletedRefTarget = execFileSync(\\\"git\\\", [\\\"show-ref\\\", \\\"--hash\\\", \\\"--verify\\\", ref], {\\n              cwd: this.workspace,\\n              env: hookEnv,\\n              encoding: \\\"utf8\\\",\\n              stdio: [\\\"ignore\\\", \\\"pipe\\\", \\\"ignore\\\"],\\n            }).trim();\\n          } catch (error: any) {\\n            if (error?.status !== 1) throw error;\\n          }\\n          if (deletedRefTarget) {\\n            execFileSync(\\\"git\\\", [\\\"-c\\\", \\\"core.hooksPath=/dev/null\\\", \\\"update-ref\\\", \\\"-d\\\", ref, deletedRefTarget], {\\n              cwd: this.workspace,\\n              stdio: \\\"ignore\\\",\\n              env: hookEnv,\\n            });\\n          }\\n        }\\n\\n        try {\\n          if (fs.existsSync(jsonPath)) fs.unlinkSync(jsonPath);\\n        } catch (error) {\\n          if (deletedRefTarget && ref && hookEnv) {\\n            try {\\n              execFileSync(\\\"git\\\", [\\\"-c\\\", \\\"core.hooksPath=/dev/null\\\", \\\"update-ref\\\", ref, deletedRefTarget, \\\"0\\\".repeat(deletedRefTarget.length)], {\\n                cwd: this.workspace,\\n                stdio: \\\"ignore\\\",\\n                env: hookEnv,\\n              });\\n            } catch (restoreError: any) {\\n              throw new Error(`${error instanceof Error ? error.message : String(error)}; checkpoint ref restoration failed: ${restoreError?.message || String(restoreError)}`);\\n            }\\n          }\\n          throw error;\\n        }\\n        if (cp.snapshotDir && fs.existsSync(cp.snapshotDir)) {\\n          fs.rmSync(cp.snapshotDir, { recursive: true, force: true });\\n        }\\n        count++;\\n      } catch (error: any) {\\n        failures.push(`${cp.id}: ${error?.message || String(error)}`);\\n      }\\n    }\\n\\n    const message = `Pruned ${count} old checkpoints (retained ${keepCount} most recent).`;\\n    return {\\n      prunedCount: count,\\n      message: failures.length === 0 ? message : `${message} ${failures.length} checkpoint(s) could not be pruned: ${failures.join(\\\"; \\\")}`,\\n    };\\n  }\"}]}},{\"_index\":\"nexus-cli-docs\",\"_id\":\"f6a8816e64de72e8fafcea842d90e4f5\",\"_score\":34.02372,\"_source\":{\"title\":\"doctor.ts\",\"ax_path\":\"doctor.ts\",\"ax_file\":\"axf2-c4828053138ecd8097b72d4771f66f62-12e36\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":325,\"start_offset\":14941,\"end_offset\":16250,\"text\":\"async () => {\\n  const build = getBuildIdentity();\\n  const dist = path.join(CLI_ROOT, \\\"dist/index.js\\\");\\n  const evidence = [\\n    `version ${build.version}`,\\n    build.commit === \\\"unknown\\\" ? (PACKAGED_HOME ? \\\"build identity unknown\\\" : \\\"build identity unknown (built before build-info was recorded; run `make build`)\\\") : `built from ${build.commit}${build.dirty ? \\\" with uncommitted changes\\\" : \\\"\\\"}${build.branch ? ` on ${build.branch}` : \\\"\\\"}`,\\n    `install root ${INSTALL_ROOT}`,\\n  ];\\n  if (!fs.existsSync(dist)) return f(\\\"install.build\\\", \\\"install\\\", \\\"fail\\\", \\\"The CLI build (cli/dist) is missing.\\\", evidence, PACKAGED_HOME ? \\\"Re-run the installer to restore missing files.\\\" : `Run \\\\`make build\\\\` in ${INSTALL_ROOT}.`);\\n  const built = fs.statSync(dist).mtimeMs;\\n  const source = PACKAGED_HOME ? 0 : newestMtime(path.join(CLI_ROOT, \\\"src\\\"), \\\".ts\\\");\\n  if (source > built) {\\n    return f(\\\"install.build\\\", \\\"install\\\", \\\"warn\\\", \\\"cli/dist is older than cli/src: the running CLI may not include the latest source changes.\\\", [...evidence, `dist ${new Date(built).toISOString()}`, `newest source ${new Date(source).toISOString()}`], `Run \\\\`npm --prefix ${path.join(INSTALL_ROOT, \\\"cli\\\")} run build\\\\`.`);\\n  }\\n  return f(\\\"install.build\\\", \\\"install\\\", \\\"pass\\\", \\\"The CLI build is present and not older than its source.\\\", evidence);\\n}\"}]},\"match_line\":328,\"match_lines\":[328,334]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"97c99d1aafabadac11b3322555823d7c\",\"_score\":29.838448,\"_source\":{\"title\":\"agent.ts\",\"ax_path\":\"agent.ts\",\"ax_file\":\"axf2-2bdd63a9ce782ac3ba1557de15fc3875-54ffb\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":2474,\"start_offset\":118970,\"end_offset\":119907,\"text\":\"public restoreConversation(\\n    session: {\\n      messages: ChatMessage[];\\n      unverifiedChangesPending?: boolean;\\n      objective?: ObjectiveLedger | null;\\n      findings?: readonly string[] | null;\\n      history?: any;\\n      providerRecovery?: DurableTaskState[\\\"providerRecovery\\\"];\\n      operation?: DurableTaskState[\\\"operation\\\"];\\n      changeBaseline?: DurableTaskState[\\\"changeBaseline\\\"];\\n    },\\n    readArchive: (committed?: ReadonlySet<string>) => ArchiveRead<ChatMessage>,\\n  ): string | undefined {\\n    this.restoreSession(session.messages, session.unverifiedChangesPending, session.objective, session.findings, session);\\n    this.restoreHistory(session.history);\\n    const committed = Array.isArray(session.history?.committedCompactions) ? new Set<string>(session.history.committedCompactions) : undefined;\\n    const read = readArchive(committed);\\n    this.restoreArchive(read.messages);\\n    return describeArchiveRead(read);\\n  }\"}]},\"match_line\":2491,\"match_lines\":[2491,2492,2493]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"3e128a73103a1d57f64c824c92cd88c5\",\"_score\":21.597786,\"_source\":{\"title\":\"index.ts\",\"ax_path\":\"index.ts\",\"ax_file\":\"axf2-0daa3ef6c891b0d3664177a1d1b59a5c-dad1\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":51,\"start_offset\":2214,\"end_offset\":4239,\"text\":\"// TUI dispatch. Maintenance recovery acquires its own exclusive lease instead.\\nconst startupArgs = process.argv.slice(2);\\nconst { acquireClientLease, releaseClientLease, clientInvocationKind } = await import(\\\"./core/client_lease.js\\\");\\nconst invocationKind = clientInvocationKind(startupArgs);\\nconst startupReadOnly = invocationKind === \\\"metadata\\\" || (startupArgs[0] === \\\"upgrade\\\" && startupArgs.includes(\\\"--check\\\"));\\n// `upgrade --check` is read-only, so it must not replay a transaction. It also\\n// must not load configuration while a restore journal says that config may be\\n// only partially applied. Refuse before loadEnvironment() and let a normal\\n// managed launch perform recovery.\\nif (startupArgs[0] === \\\"upgrade\\\" && startupArgs.includes(\\\"--check\\\")) {\\n  try {\\n    const { hasPendingStateRestore } = await import(\\\"./core/state_restore.js\\\");\\n    if (hasPendingStateRestore(process.env.HOME || os.homedir())) {\\n      throw new Error(\\\"Pending state restore must be recovered before running upgrade --check\\\");\\n    }\\n  } catch (error: any) {\\n    console.error(`[maintenance] ${error?.message ?? \\\"Nexus restore state could not be verified\\\"}`);\\n    process.exit(2);\\n  }\\n}\\n// A durable state-restore intent must be replayed before environment/config\\n// loading or any normal client is admitted. The recovery command takes the\\n// exclusive lifetime lease; ordinary clients take their shared lease below.\\nif (invocationKind === \\\"restore\\\" || (invocationKind === \\\"client\\\" && !startupReadOnly)) {\\n  try {\\n    const { hasPendingStateRestore, recoverPendingStateRestore } = await import(\\\"./core/state_restore.js\\\");\\n    const home = process.env.HOME || os.homedir();\\n    if (hasPendingStateRestore(home) && !recoverPendingStateRestore(home)) {\\n      throw new Error(\\\"Pending state restore could not be recovered; no state was admitted\\\");\\n    }\\n  } catch (error: any) {\\n    console.error(`[maintenance] ${error?.message ?? \\\"Nexus restore recovery failed closed\\\"}`);\\n    process.exit(2);\\n  }\\n}\\nif (invocationKind === \\\"client\\\") {\\n  try {\"}]},\"match_line\":57,\"match_lines\":[57,58,65,68,72,75,80,83]}]}}"}],"isError":false},"duration":{"secs":0,"nanos":541135343}},"started_at_ms":1793194913020,"completed_at_ms":1793194913561}}
{"timestamp":"2026-10-28T13:41:55.043Z","ordinal":458102,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a182be-f4e3-7262-8c36-3aa78b33bb7c","call_id":"call_1c22e2445aa340dd9d63fc0e98d66fa6","output":[{"type":"input_text","text":"Script completed\nWall time 2.0 seconds\nOutput:\n"},{"type":"input_text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /nexus-cli-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"assertGitSnapshotTargetsReplaceable gitRefBlobPaths restore read-tree checkout-index\",\"k\":10}}}}}]},\"took\":435,\"timed_out\":false,\"_shards\":{\"total\":1,\"successful\":1,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":96,\"relation\":\"eq\"},\"max_score\":39.499176,\"hits\":[{\"_index\":\"nexus-cli-docs\",\"_id\":\"c809da1acca0ab7f0674c48bb11b7c0c\",\"_score\":39.499176,\"_source\":{\"title\":\"checkpoint.ts\",\"ax_path\":\"checkpoint.ts\",\"ax_file\":\"axf2-cf607e9b77c403fe2763f3e696113466-4ea6\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":366,\"start_offset\":15551,\"end_offset\":18493,\"text\":\"public pruneCheckpoints(keepCount: number = 20): { prunedCount: number; message: string } {\\n    const checkpoints = this.listCheckpoints();\\n    if (checkpoints.length <= keepCount) {\\n      return { prunedCount: 0, message: `No pruning needed (${checkpoints.length} checkpoints <= limit of ${keepCount}).` };\\n    }\\n\\n    const toPrune = checkpoints.slice(keepCount);\\n    let count = 0;\\n    const failures: string[] = [];\\n\\n    for (const cp of toPrune) {\\n      let deletedRefTarget: string | undefined;\\n      let hookEnv: NodeJS.ProcessEnv | undefined;\\n      const ref = cp.gitRef ? `refs/nexus/checkpoints/${cp.id}` : undefined;\\n      try {\\n        const jsonPath = path.join(this.checkpointDir, `${cp.id}.json`);\\n        if (this.isGit && ref) {\\n          // Resolve hook suppression before mutating checkpoint state. Git 2.54 cannot\\n          // suppress every configured hook without a discovery race, so retain the record.\\n          hookEnv = envWithoutConfiguredHooks(this.workspace, [\\\"reference-transaction\\\"]);\\n          try {\\n            deletedRefTarget = execFileSync(\\\"git\\\", [\\\"show-ref\\\", \\\"--hash\\\", \\\"--verify\\\", ref], {\\n              cwd: this.workspace,\\n              env: hookEnv,\\n              encoding: \\\"utf8\\\",\\n              stdio: [\\\"ignore\\\", \\\"pipe\\\", \\\"ignore\\\"],\\n            }).trim();\\n          } catch (error: any) {\\n            if (error?.status !== 1) throw error;\\n          }\\n          if (deletedRefTarget) {\\n            execFileSync(\\\"git\\\", [\\\"-c\\\", \\\"core.hooksPath=/dev/null\\\", \\\"update-ref\\\", \\\"-d\\\", ref, deletedRefTarget], {\\n              cwd: this.workspace,\\n              stdio: \\\"ignore\\\",\\n              env: hookEnv,\\n            });\\n          }\\n        }\\n\\n        try {\\n          if (fs.existsSync(jsonPath)) fs.unlinkSync(jsonPath);\\n        } catch (error) {\\n          if (deletedRefTarget && ref && hookEnv) {\\n            try {\\n              execFileSync(\\\"git\\\", [\\\"-c\\\", \\\"core.hooksPath=/dev/null\\\", \\\"update-ref\\\", ref, deletedRefTarget, \\\"0\\\".repeat(deletedRefTarget.length)], {\\n                cwd: this.workspace,\\n                stdio: \\\"ignore\\\",\\n                env: hookEnv,\\n              });\\n            } catch (restoreError: any) {\\n              throw new Error(`${error instanceof Error ? error.message : String(error)}; checkpoint ref restoration failed: ${restoreError?.message || String(restoreError)}`);\\n            }\\n          }\\n          throw error;\\n        }\\n        if (cp.snapshotDir && fs.existsSync(cp.snapshotDir)) {\\n          fs.rmSync(cp.snapshotDir, { recursive: true, force: true });\\n        }\\n        count++;\\n      } catch (error: any) {\\n        failures.push(`${cp.id}: ${error?.message || String(error)}`);\\n      }\\n    }\\n\\n    const message = `Pruned ${count} old checkpoints (retained ${keepCount} most recent).`;\\n    return {\\n      prunedCount: count,\\n      message: failures.length === 0 ? message : `${message} ${failures.length} checkpoint(s) could not be pruned: ${failures.join(\\\"; \\\")}`,\\n    };\\n  }\"}]}},{\"_index\":\"nexus-cli-docs\",\"_id\":\"f6a8816e64de72e8fafcea842d90e4f5\",\"_score\":34.02372,\"_source\":{\"title\":\"doctor.ts\",\"ax_path\":\"doctor.ts\",\"ax_file\":\"axf2-c4828053138ecd8097b72d4771f66f62-12e36\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":325,\"start_offset\":14941,\"end_offset\":16250,\"text\":\"async () => {\\n  const build = getBuildIdentity();\\n  const dist = path.join(CLI_ROOT, \\\"dist/index.js\\\");\\n  const evidence = [\\n    `version ${build.version}`,\\n    build.commit === \\\"unknown\\\" ? (PACKAGED_HOME ? \\\"build identity unknown\\\" : \\\"build identity unknown (built before build-info was recorded; run `make build`)\\\") : `built from ${build.commit}${build.dirty ? \\\" with uncommitted changes\\\" : \\\"\\\"}${build.branch ? ` on ${build.branch}` : \\\"\\\"}`,\\n    `install root ${INSTALL_ROOT}`,\\n  ];\\n  if (!fs.existsSync(dist)) return f(\\\"install.build\\\", \\\"install\\\", \\\"fail\\\", \\\"The CLI build (cli/dist) is missing.\\\", evidence, PACKAGED_HOME ? \\\"Re-run the installer to restore missing files.\\\" : `Run \\\\`make build\\\\` in ${INSTALL_ROOT}.`);\\n  const built = fs.statSync(dist).mtimeMs;\\n  const source = PACKAGED_HOME ? 0 : newestMtime(path.join(CLI_ROOT, \\\"src\\\"), \\\".ts\\\");\\n  if (source > built) {\\n    return f(\\\"install.build\\\", \\\"install\\\", \\\"warn\\\", \\\"cli/dist is older than cli/src: the running CLI may not include the latest source changes.\\\", [...evidence, `dist ${new Date(built).toISOString()}`, `newest source ${new Date(source).toISOString()}`], `Run \\\\`npm --prefix ${path.join(INSTALL_ROOT, \\\"cli\\\")} run build\\\\`.`);\\n  }\\n  return f(\\\"install.build\\\", \\\"install\\\", \\\"pass\\\", \\\"The CLI build is present and not older than its source.\\\", evidence);\\n}\"}]},\"match_line\":328,\"match_lines\":[328,334]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"97c99d1aafabadac11b3322555823d7c\",\"_score\":29.838448,\"_source\":{\"title\":\"agent.ts\",\"ax_path\":\"agent.ts\",\"ax_file\":\"axf2-2bdd63a9ce782ac3ba1557de15fc3875-54ffb\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":2474,\"start_offset\":118970,\"end_offset\":119907,\"text\":\"public restoreConversation(\\n    session: {\\n      messages: ChatMessage[];\\n      unverifiedChangesPending?: boolean;\\n      objective?: ObjectiveLedger | null;\\n      findings?: readonly string[] | null;\\n      history?: any;\\n      providerRecovery?: DurableTaskState[\\\"providerRecovery\\\"];\\n      operation?: DurableTaskState[\\\"operation\\\"];\\n      changeBaseline?: DurableTaskState[\\\"changeBaseline\\\"];\\n    },\\n    readArchive: (committed?: ReadonlySet<string>) => ArchiveRead<ChatMessage>,\\n  ): string | undefined {\\n    this.restoreSession(session.messages, session.unverifiedChangesPending, session.objective, session.findings, session);\\n    this.restoreHistory(session.history);\\n    const committed = Array.isArray(session.history?.committedCompactions) ? new Set<string>(session.history.committedCompactions) : undefined;\\n    const read = readArchive(committed);\\n    this.restoreArchive(read.messages);\\n    return describeArchiveRead(read);\\n  }\"}]},\"match_line\":2491,\"match_lines\":[2491,2492,2493]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"3e128a73103a1d57f64c824c92cd88c5\",\"_score\":21.597786,\"_source\":{\"title\":\"index.ts\",\"ax_path\":\"index.ts\",\"ax_file\":\"axf2-0daa3ef6c891b0d3664177a1d1b59a5c-dad1\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":51,\"start_offset\":2214,\"end_offset\":4239,\"text\":\"// TUI dispatch. Maintenance recovery acquires its own exclusive lease instead.\\nconst startupArgs = process.argv.slice(2);\\nconst { acquireClientLease, releaseClientLease, clientInvocationKind } = await import(\\\"./core/client_lease.js\\\");\\nconst invocationKind = clientInvocationKind(startupArgs);\\nconst startupReadOnly = invocationKind === \\\"metadata\\\" || (startupArgs[0] === \\\"upgrade\\\" && startupArgs.includes(\\\"--check\\\"));\\n// `upgrade --check` is read-only, so it must not replay a transaction. It also\\n// must not load configuration while a restore journal says that config may be\\n// only partially applied. Refuse before loadEnvironment() and let a normal\\n// managed launch perform recovery.\\nif (startupArgs[0] === \\\"upgrade\\\" && startupArgs.includes(\\\"--check\\\")) {\\n  try {\\n    const { hasPendingStateRestore } = await import(\\\"./core/state_restore.js\\\");\\n    if (hasPendingStateRestore(process.env.HOME || os.homedir())) {\\n      throw new Error(\\\"Pending state restore must be recovered before running upgrade --check\\\");\\n    }\\n  } catch (error: any) {\\n    console.error(`[maintenance] ${error?.message ?? \\\"Nexus restore state could not be verified\\\"}`);\\n    process.exit(2);\\n  }\\n}\\n// A durable state-restore intent must be replayed before environment/config\\n// loading or any normal client is admitted. The recovery command takes the\\n// exclusive lifetime lease; ordinary clients take their shared lease below.\\nif (invocationKind === \\\"restore\\\" || (invocationKind === \\\"client\\\" && !startupReadOnly)) {\\n  try {\\n    const { hasPendingStateRestore, recoverPendingStateRestore } = await import(\\\"./core/state_restore.js\\\");\\n    const home = process.env.HOME || os.homedir();\\n    if (hasPendingStateRestore(home) && !recoverPendingStateRestore(home)) {\\n      throw new Error(\\\"Pending state restore could not be recovered; no state was admitted\\\");\\n    }\\n  } catch (error: any) {\\n    console.error(`[maintenance] ${error?.message ?? \\\"Nexus restore recovery failed closed\\\"}`);\\n    process.exit(2);\\n  }\\n}\\nif (invocationKind === \\\"client\\\") {\\n  try {\"}]},\"match_line\":57,\"match_lines\":[57,58,65,68,72,75,80,83]}]}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a182b5-7df6-71b2-a955-13339511caaf","create_time":1793194915.0437815}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
