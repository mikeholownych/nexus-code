{"timestamp":"2026-10-28T16:35:21.265Z","ordinal":464346,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a1834a-d12d-7c43-8f4a-96ee044d0ace","item":{"type":"CommandExecution","id":"exec-b38d7223-da13-491f-9cf8-6870f3d921cd","process_id":"79400","command":["/usr/bin/zsh","-lc","python3 - <<'PY'\nfrom pathlib import Path\np = Path('cli/test/checkpoint_restore.test.ts')\ns = p.read_text()\nstart = s.index('for (const coreBare of [\"false\", \"unset\"] as const) {')\nend = s.index('\\ntest(\"Git manifest restore refuses a nested bare repository with a symlinked config\"', start)\nblock = s[start:end]\nlines = block.splitlines()\nlines = [lines[0]] + [('  ' + line if line else line) for line in lines[1:-1]] + [lines[-1]]\np.write_text(s[:start] + '\\n'.join(lines) + s[end:])\nPY\nsed -n '1240,1280p' cli/test/checkpoint_restore.test.ts; git diff --check; git diff --stat"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"unknown","cmd":"python3 - <<'PY'\nfrom pathlib import Path\np = Path('cli/test/checkpoint_restore.test.ts')\ns = p.read_text()\nstart = s.index('for (const coreBare of [\"false\", \"unset\"] as const) {')\nend = s.index('\\ntest(\"Git manifest restore refuses a nested bare repository with a symlinked config\"', start)\nblock = s[start:end]\nlines = block.splitlines()\nlines = [lines[0]] + [('  ' + line if line else line) for line in lines[1:-1]] + [lines[-1]]\np.write_text(s[:start] + '\\n'.join(lines) + s[end:])\nPY\nsed -n '1240,1280p' cli/test/checkpoint_restore.test.ts; git diff --check; git diff --stat"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"for (const coreBare of [\"false\", \"unset\"] as const) {\n  test(`Git manifest restore refuses an exact nested Git directory with core.bare=${coreBare}`, () => {\n    const { repo, git } = gitRepo();\n    const destination = path.join(repo, \"replace-me\");\n    try {\n      fs.writeFileSync(destination, \"checkpoint file\\n\");\n      const manager = new CheckpointManager(repo);\n      const checkpoint = manager.createCheckpoint(\"bare repository exact destination\");\n\n      fs.rmSync(destination);\n      execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", destination]);\n      if (coreBare === \"false\") {\n        execFileSync(\"git\", [\"--git-dir\", destination, \"config\", \"core.bare\", \"false\"]);\n      } else {\n        execFileSync(\"git\", [\"--git-dir\", destination, \"config\", \"--unset\", \"core.bare\"]);\n      }\n      fs.writeFileSync(path.join(destination, \"repository-canary.txt\"), \"bare repository canary\\n\");\n      fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n      git(\"add\", \"staged-after-checkpoint.txt\");\n      const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n      const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n      const result = manager.restore(checkpoint.id);\n\n      assert.equal(result.success, false);\n      assert.match(result.message, /nested Git repository|destination|unsafe/i);\n      assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n      const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n      assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve the outer index\");\n      assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n      assert.equal(fs.readFileSync(path.join(destination, \"repository-canary.txt\"), \"utf8\"), \"bare repository canary\\n\");\n      assert.equal(execFileSync(\"git\", [\"-C\", destination, \"rev-parse\", \"--absolute-git-dir\"], { encoding: \"utf8\" }).trim(), destination);\n      assert.equal(execFileSync(\"git\", [\"-C\", destination, \"rev-parse\", \"--is-bare-repository\"], { encoding: \"utf8\" }).trim(), coreBare === \"false\" ? \"false\" : \"true\");\n      assert.equal(fs.existsSync(path.join(destination, \"captured.txt\")), false, \"rejection must not copy checkpoint data into the repository\");\n    } finally {\n      cleanupGitRepo(repo);\n    }\n  });\n}\ntest(\"Git manifest restore refuses a nested bare repository with a symlinked config\", () => {\n  const { repo, git } = gitRepo();\n cli/src/checkpoint.ts               | 91 +++++++++++++++++++------------------\n cli/test/checkpoint_restore.test.ts | 65 ++++++++++++++------------\n 2 files changed, 82 insertions(+), 74 deletions(-)\n","exit_code":0,"duration":{"secs":1,"nanos":335484361}},"started_at_ms":1793205319929,"completed_at_ms":1793205321265}}
{"timestamp":"2026-10-28T16:35:23.117Z","ordinal":464347,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1835d-c56d-7fe1-a789-d43438d7dac6","call_id":"call_6fc89df00eab4e7e974886f8f8e03f3c","output":[{"type":"input_text","text":"Script completed\nWall time 4.6 seconds\nOutput:\n"},{"type":"input_text","text":"for (const coreBare of [\"false\", \"unset\"] as const) {\n  test(`Git manifest restore refuses an exact nested Git directory with core.bare=${coreBare}`, () => {\n    const { repo, git } = gitRepo();\n    const destination = path.join(repo, \"replace-me\");\n    try {\n      fs.writeFileSync(destination, \"checkpoint file\\n\");\n      const manager = new CheckpointManager(repo);\n      const checkpoint = manager.createCheckpoint(\"bare repository exact destination\");\n\n      fs.rmSync(destination);\n      execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", destination]);\n      if (coreBare === \"false\") {\n        execFileSync(\"git\", [\"--git-dir\", destination, \"config\", \"core.bare\", \"false\"]);\n      } else {\n        execFileSync(\"git\", [\"--git-dir\", destination, \"config\", \"--unset\", \"core.bare\"]);\n      }\n      fs.writeFileSync(path.join(destination, \"repository-canary.txt\"), \"bare repository canary\\n\");\n      fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n      git(\"add\", \"staged-after-checkpoint.txt\");\n      const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n      const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n      const result = manager.restore(checkpoint.id);\n\n      assert.equal(result.success, false);\n      assert.match(result.message, /nested Git repository|destination|unsafe/i);\n      assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n      const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n      assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve the outer index\");\n      assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n      assert.equal(fs.readFileSync(path.join(destination, \"repository-canary.txt\"), \"utf8\"), \"bare repository canary\\n\");\n      assert.equal(execFileSync(\"git\", [\"-C\", destination, \"rev-parse\", \"--absolute-git-dir\"], { encoding: \"utf8\" }).trim(), destination);\n      assert.equal(execFileSync(\"git\", [\"-C\", destination, \"rev-parse\", \"--is-bare-repository\"], { encoding: \"utf8\" }).trim(), coreBare === \"false\" ? \"false\" : \"true\");\n      assert.equal(fs.existsSync(path.join(destination, \"captured.txt\")), false, \"rejection must not copy checkpoint data into the repository\");\n    } finally {\n      cleanupGitRepo(repo);\n    }\n  });\n}\ntest(\"Git manifest restore refuses a nested bare repository with a symlinked config\", () => {\n  const { repo, git } = gitRepo();\n cli/src/checkpoint.ts               | 91 +++++++++++++++++++------------------\n cli/test/checkpoint_restore.test.ts | 65 ++++++++++++++------------\n 2 files changed, 82 insertions(+), 74 deletions(-)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1834a-d12d-7c43-8f4a-96ee044d0ace","create_time":1793205323.117567}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
