A failed `session/load` still consumes a pin slot (the pin is taken at session start, as before).\n- The three new fields are on the ACP result only; the shared service summary and the MCP output are unchanged. The receipt carries the base commit only in `result.base`, when verification got that far.\n- The kill grace + 5 s bound mirrors MCP and does not cover the final worker kill at twice the grace.\n- Node 22 and hosted CI were not run.</result>\n<usage><subagent_tokens>196330</subagent_tokens><tool_uses>40</tool_uses><duration_ms>1769291</duration_ms></usage>\n</task-notification>"},"uuid":"4b71dbad-c2e3-4fba-8c29-f3c1078723b9","timestamp":"2026-11-24T09:26:53.333Z","permissionMode":"bypassPermissions","origin":{"kind":"task-notification","producer":"session-task","runId":"0mwugofjg-0bc1c3ed"},"promptSource":"system","turnOrigin":"task_notification","turnPromptId":"6644ffa3-29b3-4f01-8c15-053e06b38f99","turnPosition":{"promptIndex":40,"turnIndex":258},"queueSkipAttachments":true,"userType":"external","entrypoint":"cli","cwd":"/home/mike/nexus-code","sessionId":"43bcbb67-2cff-4fa8-a05e-f8aa598df73b","version":"2.1.329","gitBranch":"main","slug":"synthetic-moseying-seahorse","dataFlowOn":true}
