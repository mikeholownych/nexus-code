{"timestamp":"2026-11-20T04:53:35.294Z","ordinal":31007,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a1f730-5dda-7050-8748-e755b63ef781","item":{"type":"CommandExecution","id":"exec-c9a3b4ef-7c62-40bc-9420-bf256ee06380","process_id":"63849","command":["/usr/bin/zsh","-lc","git log --oneline --graph origin/main..origin/v1/v1.2x-vc2-large-shell-edits; git diff --check origin/main...origin/v1/v1.2x-vc2-large-shell-edits; git diff --stat origin/main...origin/v1/v1.2x-vc2-large-shell-edits; git diff origin/main...origin/v1/v1.2x-vc2-large-shell-edits -- cli/src/core/run_turn.ts cli/src/core/operation_runner.ts cli/src/core/operation_runner_execution.ts cli/test"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git log --oneline --graph origin/main..origin/v1/v1.2x-vc2-large-shell-edits; git diff --check origin/main...origin/v1/v1.2x-vc2-large-shell-edits; git diff --stat origin/main...origin/v1/v1.2x-vc2-large-shell-edits; git diff origin/main...origin/v1/v1.2x-vc2-large-shell-edits -- cli/src/core/run_turn.ts cli/src/core/operation_runner.ts cli/src/core/operation_runner_execution.ts cli/test"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"* 271a3aef Merge branch 'main' into v1/v1.2x-vc2-large-shell-edits\n* 7864312d Merge branch 'main' into v1/v1.2x-vc2-large-shell-edits\n* 061dc68c fix(security): fail closed on incomplete verification snapshots\n* ab5a382e fix(verification): record bounded shell scan uncertainty\n cli/src/core/dispatch_tool_call.ts            | 14 ++++++++++---\n cli/src/core/regression_obligations.ts        | 10 ++++++++-\n cli/src/security.ts                           | 29 ++++++++++++++++++---------\n cli/src/tools.ts                              |  1 +\n cli/test/regression_obligations_agent.test.ts | 24 ++++++++++++++++++++++\n cli/test/verification_shell_guard.test.ts     |  9 +++++++++\n 6 files changed, 73 insertions(+), 14 deletions(-)\ndiff --git a/cli/test/regression_obligations_agent.test.ts b/cli/test/regression_obligations_agent.test.ts\nindex bac72ce7..ef0cbf00 100644\n--- a/cli/test/regression_obligations_agent.test.ts\n+++ b/cli/test/regression_obligations_agent.test.ts\n@@ -135,6 +135,30 @@ describe(\"DV-3 weakening edits are recorded by the dispatch hook\", () => {\n     });\n   });\n \n+  test(\"a shell edit to a test larger than the retained snapshot is recorded as unverifiable\", { timeout: 90_000 }, async () => {\n+    const largeTest = `${TEST_BODY}${\"// padding\\n\".repeat(7000)}`;\n+    await withAgent({ Makefile: MAKEFILE, [TEST_PATH]: largeTest }, [call(\"run_command\", { command: `sed -i 's/${TEST_NAME}/renamed test/' ${TEST_PATH}` })], ledgerWithObligation(), async (agent) => {\n+      await agent.runTurn(\"continue\");\n+      const w = agent.getObjective()!.obligations![0].weakenings;\n+      assert.equal(w.length, 1);\n+      assert.equal(w[0].kind, \"unverifiable-change\");\n+      assert.equal(w[0].path, TEST_PATH);\n+    });\n+  });\n+\n+  test(\"an incomplete workspace scan is recorded against active obligations\", { timeout: 90_000 }, async () => {\n+    await withAgent({ Makefile: MAKEFILE, [TEST_PATH]: TEST_BODY }, [call(\"run_command\", { command: \"echo unchanged\" })], ledgerWithObligation(), async (agent, repo) => {\n+      const overflow = path.join(repo, \"scan-overflow\");\n+      fs.mkdirSync(overflow);\n+      for (let i = 0; i < 20_010; i++) fs.writeFileSync(path.join(overflow, `entry-${i}`), \"x\");\n+      await agent.runTurn(\"continue\");\n+      const w = agent.getObjective()!.obligations![0].weakenings;\n+      assert.equal(w.length, 1);\n+      assert.equal(w[0].kind, \"unverifiable-change\");\n+      assert.equal(w[0].path, \"<workspace-scan>\");\n+    });\n+  });\n+\n   test(\"a shell command that changes nothing the obligation names records nothing\", { timeout: 90_000 }, async () => {\n     await withAgent({ Makefile: MAKEFILE, [TEST_PATH]: TEST_BODY }, [call(\"run_command\", { command: \"echo hi > note.txt\" })], ledgerWithObligation(), async (agent, repo) => {\n       await agent.runTurn(\"continue\");\ndiff --git a/cli/test/verification_shell_guard.test.ts b/cli/test/verification_shell_guard.test.ts\nindex a2466b38..87a562c9 100644\n--- a/cli/test/verification_shell_guard.test.ts\n+++ b/cli/test/verification_shell_guard.test.ts\n@@ -68,6 +68,15 @@ describe(\"mode block: a shell command cannot change how work is verified\", () =>\n     assert.equal(fs.existsSync(path.join(repo, \"test/new.test.js\")), true);\n   });\n \n+  test(\"block mode refuses shell execution when a verification file exceeds the fingerprint bound\", async () => {\n+    write(\"test/large.test.js\", \"x\".repeat(2 * 1024 * 1024 + 1));\n+    const r = await run(bridge(\"block\"), \"echo executed > should-not-exist.txt\");\n+    assert.equal(r.success, false);\n+    assert.equal(r.denialReason, VERIFICATION_CONFIG_PROTECTED);\n+    assert.match(r.error ?? \"\", /snapshot is incomplete/);\n+    assert.equal(fs.existsSync(path.join(repo, \"should-not-exist.txt\")), false);\n+  });\n+\n   test(\"ordinary commands are unaffected, including a dependency bump in package.json (not a verification key)\", async () => {\n     const b = bridge(\"block\");\n     const plain = await run(b, \"echo hello > src/out.txt && echo done\");\n","exit_code":0,"duration":{"secs":0,"nanos":39748}},"started_at_ms":1795150415294,"completed_at_ms":1795150415294}}
