nst inputs: ProductionPolicyInputs = { systemPath: FAKE_SYSTEM, systemOwnerUid: 0, userPath: FAKE_USER, userUid: FAKE_UID, trustStorePath: FAKE_STORE, fs: fake };\n47-  let resolved = 0;\n48-  const host = createPolicyHost(() => {\nShell cwd was reset to /home/mike/nexus-code","is_error":false}]}}
