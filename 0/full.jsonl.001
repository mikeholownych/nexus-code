{"timestamp":"2026-11-02T21:45:40.699Z","ordinal":47461,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"CommandExecution","id":"exec-9933b5e9-e388-4610-a4c6-7cb10d5d6edb","process_id":"32910","command":["/usr/bin/zsh","-lc","rg -n 'export function.*[Ee]xposure|compilerExposure|scanCompiler|inventory' eval/isolate.mjs; sed -n '1,130p' cli/test/eval_integrity.test.ts; sed -n '1060,1105p' cli/test/eval_integrity.test.ts; sed -n '1,180p' eval/scan-compiler-exposure.mjs"],"cwd":"file:///home/mike/nexus-wt/v112-wp1103-a0d374e8","parsed_cmd":[{"type":"search","cmd":"rg -n 'export function.*[Ee]xposure|compilerExposure|scanCompiler|inventory' eval/isolate.mjs","query":"export function.*[Ee]xposure|compilerExposure|scanCompiler|inventory","path":"isolate.mjs"},{"type":"read","cmd":"sed -n '1,130p' cli/test/eval_integrity.test.ts","name":"eval_integrity.test.ts","path":"cli/test/eval_integrity.test.ts"},{"type":"read","cmd":"sed -n '1060,1105p' cli/test/eval_integrity.test.ts","name":"eval_integrity.test.ts","path":"cli/test/eval_integrity.test.ts"},{"type":"read","cmd":"sed -n '1,180p' eval/scan-compiler-exposure.mjs","name":"scan-compiler-exposure.mjs","path":"eval/scan-compiler-exposure.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"19:// and exclude only those exact subtrees from compiler inventory; every other mounted path\n241:export function scanOracleCompilerExposure(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS, additionalMountedPaths = [], approvedToolchainRoots = [], excludedDirectories = []) {\n258:  let inventoryFailureReason;\n321:      // fail-closed inventory fast enough for repeated evaluator launches. Do not follow\n328:        throw new Error(\"trusted compiler inventory tool is unavailable\");\n333:      const inventory = path.join(path.dirname(fileURLToPath(import.meta.url)), \"scan-compiler-exposure.mjs\");\n334:      const inventoryStat = fs.lstatSync(inventory);\n335:      if (!inventoryStat.isFile() || inventoryStat.isSymbolicLink() || (inventoryStat.mode & 0o022) !== 0\n336:        || fs.realpathSync(inventory) !== inventory) {\n337:        throw new Error(\"trusted compiler inventory helper is unavailable\");\n339:      const result = spawnSync(process.execPath, [inventory, ...[...directoryRoots].sort()], {\n348:        const helperFailure = /^trusted compiler inventory could not complete: ([a-z_0-9]+)\\n$/.exec(result.stderr?.toString(\"utf8\") ?? \"\");\n350:        inventoryFailureReason = helperFailure?.[1]\n357:        throw new Error(\"trusted compiler inventory could not complete\");\n364:    const reason = inventoryFailureReason ? ` (inventory ${inventoryFailureReason})` : \"\";\n371:export function compilerExposureMaskArgs(scan) {\n581:  const compilerExposure = scanOracleCompilerExposure(mountSources.systemDirectories, mountSources.systemEtcDirectories, [], mountSources.toolchainDirectories, maskedDirectories);\n582:  if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n611:  args.push(...compilerExposureMaskArgs(compilerExposure));\n704:  const compilerExposure = scanOracleCompilerExposure(\n711:  if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n750:  args.push(...compilerExposureMaskArgs(compilerExposure));\n762:  let compilerExposure = null;\n768:    compilerExposure = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths, Object.values(oracleToolchainSources).filter(Boolean), maskedDirectories);\n769:    if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n815:  if (compilerExposure) args.push(...compilerExposureMaskArgs(compilerExposure));\n/**\n * Scoring integrity of the evaluation harness (REQ-QUAL-106, EVL-002/003/005): infrastructure failures are decided by\n * what the harness's model proxy observed, the same way for every agent; contaminated runs leave the pass rate;\n * reruns are listed; crashes are counted as crashes rather than rerun.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport http from \"node:http\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\nconst proxyModule = path.join(ROOT, \"eval/model_proxy.mjs\");\n\ntest(\"the model proxy forwards requests and counts answers and upstream failures\", async () => {\n  const { startModelProxy, isInfrastructureFailure } = await import(proxyModule);\n  const upstream = http.createServer((req, res) => {\n    if (req.url?.endsWith(\"/chat/completions\")) {\n      res.writeHead(503);\n      return void res.end(\"busy\");\n    }\n    res.setHeader(\"content-type\", \"application/json\");\n    res.end(JSON.stringify({ path: req.url }));\n  });\n  await new Promise<void>((r) => upstream.listen(0, \"127.0.0.1\", () => r()));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1` });\n  try {\n    assert.match(proxy.url, /^http:\\/\\/127\\.0\\.0\\.1:\\d+\\/v1$/);\n    const ok = await (await fetch(`${proxy.url}/models`)).json();\n    assert.equal(ok.path, \"/v1/models\");\n    assert.equal((await fetch(`${proxy.url}/chat/completions`, { method: \"POST\", body: \"{}\" })).status, 503);\n    assert.equal((await fetch(`${proxy.url}/admin/secrets`)).status, 404, \"control-plane paths are not forwarded\");\n    assert.equal((await fetch(`${proxy.url}/chat/completions`, { method: \"GET\" })).status, 404, \"unsupported methods are not forwarded\");\n    const stats = proxy.stats();\n    assert.equal(stats.requests, 4);\n    assert.equal(stats.answered, 1);\n    assert.equal(stats.upstreamFailures, 1);\n    assert.equal(isInfrastructureFailure({ model: stats }), false, \"the model answered: the run is scored\");\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n\n  const dead = await startModelProxy({ upstream: \"http://127.0.0.1:9/v1\" });\n  try {\n    assert.equal((await fetch(`${dead.url}/chat/completions`, { method: \"POST\", body: \"{}\" })).status, 502);\n    assert.equal(isInfrastructureFailure({ model: dead.stats() }), true, \"the model never answered and the endpoint failed\");\n  } finally {\n    await dead.close();\n  }\n});\n\ntest(\"the evaluation proxy authenticates the local run token and replaces it with the upstream credential\", async () => {\n  const { startModelProxy } = await import(proxyModule);\n  const seen: string[] = [];\n  const upstream = http.createServer((req, res) => {\n    seen.push(String(req.headers.authorization ?? \"\"));\n    res.end(JSON.stringify({ ok: true }));\n  });\n  await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1`, authToken: \"UPSTREAM_SECRET_CANARY\", clientToken: \"RUN_SCOPED_TOKEN\" });\n  try {\n    assert.equal((await fetch(`${proxy.url}/models`)).status, 401);\n    const accepted = await fetch(`${proxy.url}/models`, { headers: { authorization: \"Bearer RUN_SCOPED_TOKEN\" } });\n    assert.equal(accepted.status, 200);\n    assert.deepEqual(seen, [\"Bearer UPSTREAM_SECRET_CANARY\"]);\n    assert.equal((await fetch(`${proxy.url}/admin`, { headers: { authorization: \"Bearer RUN_SCOPED_TOKEN\" } })).status, 404);\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n});\n\ntest(\"the evaluation proxy bounds request count and body size\", async () => {\n  const { startModelProxy } = await import(proxyModule);\n  let upstreamRequests = 0;\n  const upstream = http.createServer((req, res) => { upstreamRequests++; req.resume(); res.end(\"ok\"); });\n  await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1`, maxRequests: 1, maxRequestBytes: 8 });\n  try {\n    const oversized = await fetch(`${proxy.url}/chat/completions`, { method: \"POST\", body: \"123456789\" }).catch(() => null);\n    assert.ok(oversized === null || oversized.status === 413);\n    assert.equal(upstreamRequests, 0, \"oversized bodies never reach the provider\");\n    assert.equal((await fetch(`${proxy.url}/models`)).status, 429);\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n});\n\ntest(\"the evaluation proxy bounds concurrent inference and cancels upstream work on client abort\", { timeout: 10_000 }, async () => {\n  const { startModelProxy, isInfrastructureFailure } = await import(proxyModule);\n  let upstreamRequests = 0;\n  let resolveFirstStarted!: () => void;\n  let resolveFirstClosed!: () => void;\n  const firstStarted = new Promise<void>((resolve) => { resolveFirstStarted = resolve; });\n  const firstClosed = new Promise<void>((resolve) => { resolveFirstClosed = resolve; });\n  const upstream = http.createServer((req, res) => {\n    upstreamRequests++;\n    req.resume();\n    if (upstreamRequests === 1) {\n      resolveFirstStarted();\n      res.once(\"close\", resolveFirstClosed);\n      return;\n    }\n    res.end(\"second request accepted after cancellation\");\n  });\n  await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1` });\n  const body = JSON.stringify({ max_tokens: 1 });\n  const send = (signal?: AbortSignal) => fetch(`${proxy.url}/chat/completions`, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/json\" },\n    body,\n    signal,\n  });\n  try {\n    const controller = new AbortController();\n    const first = send(controller.signal);\n    await firstStarted;\n    assert.equal(proxy.stats().activeInferenceRequests, 1);\n\n      protectedCorpusPaths: [custodyReportPath],\n    }), /overlaps protected corpus material/);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"qualification remains fail-closed without enforced aggregate resource controls\", async () => {\n  const { qualificationResourceIsolationProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const { dedicatedTmpfsMountProblem } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\n  const tmpfs = fs.statfsSync(workspaceRoot);\n  const ok = { cpuPercent: 100, memoryBytes: 256 * 1024 * 1024, tasks: 64, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\n  const shared = fs.statfsSync(\"/dev/shm\");\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: \"/dev/shm\", storageBytes: shared.blocks * shared.bsize } }) ?? \"\", /dedicated tmpfs|exact mount point/);\n  assert.match(qualificationResourceIsolationProblem(), /enforced CPU, memory, process-count, and workspace-storage limits/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: ROOT } }) ?? \"\", /tmpfs/);\n  const nested = fs.mkdtempSync(path.join(workspaceRoot, \"nested-\"));\n  try {\n    assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: nested } }) ?? \"\", /exact mount point/);\n  } finally {\n    fs.rmdirSync(nested);\n  }\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, memoryBytes: 1024 } }) ?? \"\", /memoryBytes/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, tasks: 0 } }) ?? \"\", /tasks/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, cpuPercent: 1.5 } }) ?? \"\", /cpuPercent/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, memoryBytes: 256 * 1024 * 1024 + 1 } }) ?? \"\", /multiple of 4096/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, storageBytes: ok.storageBytes - 4096 } }) ?? \"\", /tmpfs with size<=storageBytes|owner-accessible/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, storageBytes: undefined } }) ?? \"\", /storageBytes/);\n  const isolation = qualificationResourceIsolationProblem({ resources: ok });\n  if (process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) assert.equal(isolation, null, \"the dedicated test tmpfs and kernel resource contract must pass preflight\");\n  else assert.match(isolation ?? \"\", /dedicated tmpfs|exact mount point/, \"a shared /dev/shm must fail qualification preflight\");\n  if (process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) {\n    // CI mounts the capped workspace as 0711 (owner rwx, other --x). Mode probes must restore\n    // that contract so later runAs / version-probe suites can still traverse as the evaluator.\n    const restoreMode = 0o711;\n    fs.chmodSync(workspaceRoot, 0o755);\n    try {\n      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \"\", /non-readable\\/non-writable by group or other/);\n    } finally {\n      fs.chmodSync(workspaceRoot, restoreMode);\n    }\n    assert.equal(qualificationResourceIsolationProblem({ resources: ok }), null, \"restored dedicated mount root must pass preflight\");\n    fs.chmodSync(workspaceRoot, 0o731);\n    try {\n      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \"\", /non-readable\\/non-writable by group or other/);\n// Run trusted GNU find inventories across canonical system roots. Large roots are\n// split at bounded-depth subtrees so a broad directory cannot monopolize a worker.\nimport { isUtf8 } from \"node:buffer\";\nimport { spawn } from \"node:child_process\";\nimport path from \"node:path\";\n\nconst FIND = \"/usr/bin/find\";\nconst MAX_OUTPUT = 64 * 1024 * 1024;\nconst MAX_ENUMERATION_OUTPUT = 64 * 1024 * 1024;\n// This is a hard fail-closed bound. Keep the full inventory within it by letting GNU\n// find optimize the cheap name predicates ahead of filesystem metadata checks.\nconst TIMEOUT_MS = 25_000;\nconst MAX_ENTRIES = 500_000;\nconst MAX_JOBS = 100_000;\nconst MAX_ROOTS = 4_096;\nconst MAX_ROOT_BYTES = 1024 * 1024;\n// Amortize GNU find startup cost across disjoint system roots without approaching\n// the per-process argv size limit on Linux.\nconst MAX_ENUMERATION_ROOTS = 64;\nconst MAX_ENUMERATION_ROOT_BYTES = 64 * 1024;\n// Bundle enough sibling directories to avoid spawning one `find` process for\n// every pair on large hosted system roots, while keeping independent jobs for\n// bounded parallel scanning.\nconst DIRECTORY_BATCH_SIZE = 64;\nconst DIRECT_ENTRY_BATCH_SIZE = 256;\nconst SCAN_WORKERS = 8;\nconst COMPILER_NAMES = [\n  \"go\", \"go[0-9]*\", \"go-[0-9]*\",\n  \"rustc\", \"rustc[0-9]*\", \"rustc-[0-9]*\",\n  \"cargo\", \"cargo[0-9]*\", \"cargo-[0-9]*\",\n  \"rustup\",\n];\n\nfunction findArgs(roots) {\n  const nameExpression = COMPILER_NAMES.flatMap((name, index) => index === 0\n    ? [\"-name\", name]\n    : [\"-o\", \"-name\", name]);\n  const linkTargetExpression = COMPILER_NAMES.flatMap((name, index) => {\n    const patterns = [name, `*/${name}`];\n    return patterns.flatMap((pattern, patternIndex) => index === 0 && patternIndex === 0\n      ? [\"-lname\", pattern]\n      : [\"-o\", \"-lname\", pattern]);\n  });\n  return [\n    \"-O3\", \"-P\", ...roots,\n    \"(\", \"(\", \"-type\", \"l\", \"(\", ...nameExpression, \"-o\", ...linkTargetExpression, \")\", \")\",\n    \"-o\",\n    \"(\", \"(\", ...nameExpression, \")\", \"-a\", \"-type\", \"f\", \"-a\", \"-perm\", \"/111\", \")\",\n    \")\", \"-print0\",\n  ];\n}\n\nconst roots = process.argv.slice(2);\nconst rootBytes = roots.reduce((total, root) => total + Buffer.byteLength(root) + 1, 0);\nif (roots.length === 0 || roots.length > MAX_ROOTS || rootBytes > MAX_ROOT_BYTES || roots.some((root) => !root.startsWith(\"/\"))) {\n  process.stderr.write(\"compiler inventory roots must be absolute and within bounded input limits\\n\");\n  process.exit(2);\n}\n\nasync function* enumerateJobs() {\n  let entryCount = 0;\n  let jobCount = 0;\n  let enumerationBytes = 0;\n  let rootOffset = 0;\n  let batchIndex = 0;\n  while (rootOffset < roots.length) {\n    const batch = [];\n    let batchBytes = 0;\n    while (rootOffset < roots.length && batch.length < MAX_ENUMERATION_ROOTS) {\n      const root = roots[rootOffset];\n      const rootBytes = Buffer.byteLength(root) + 1;\n      if (batch.length > 0 && batchBytes + rootBytes > MAX_ENUMERATION_ROOT_BYTES) break;\n      batch.push(root);\n      batchBytes += rootBytes;\n      rootOffset += 1;\n    }\n    const child = spawn(FIND, [\"-P\", ...batch, \"-mindepth\", \"1\", \"-maxdepth\", \"3\", \"-printf\", \"%d\\\\0%y\\\\0%p\\\\0\"], {\n      env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    children.add(child);\n    let stderrBytes = 0;\n    let spawnError = null;\n    child.stderr.on(\"data\", (chunk) => {\n      stderrBytes += chunk.length;\n      failed = true;\n      stopAll(\"enumeration_stderr\");\n    });\n    child.on(\"error\", (error) => {\n      spawnError = error;\n      failed = true;\n      stopAll(\"enumeration_spawn_error\");\n    });\n    const closed = new Promise((resolve) => child.once(\"close\", (code, signal) => resolve({ code, signal })));\n    let scanDirectories = [];\n    let directEntries = [];\n    let entryDepth = null;\n    let entryType = null;\n    let pending = Buffer.alloc(0);\n    try {\n      for await (const chunk of child.stdout) {\n        enumerationBytes += chunk.length;\n        if (enumerationBytes > MAX_ENUMERATION_OUTPUT) {\n          failed = true;\n          stopAll(\"enumeration_output_limit\");\n          throw new Error(\"compiler inventory enumeration output limit exceeded\");\n        }\n        const data = pending.length ? Buffer.concat([pending, chunk]) : chunk;\n        let offset = 0;\n        while (true) {\n          const delimiter = data.indexOf(0, offset);\n          if (delimiter < 0) break;\n          const field = data.subarray(offset, delimiter);\n          offset = delimiter + 1;\n          if (entryDepth === null) {\n            if (field.length !== 1 || field[0] < 0x31 || field[0] > 0x33) {\n              throw new Error(\"invalid compiler inventory entry depth\");\n            }\n            entryDepth = field[0] - 0x30;\n            continue;\n          }\n          if (entryType === null) {\n            if (field.length !== 1) throw new Error(\"invalid compiler inventory entry type\");\n            entryType = field.toString(\"ascii\");\n            continue;\n          }\n          if (++entryCount > MAX_ENTRIES) {\n            failed = true;\n            stopAll(\"entry_limit\");\n            throw new Error(\"compiler inventory entry limit exceeded\");\n          }\n          const item = field.toString(\"utf8\");\n          if (!Buffer.from(item, \"utf8\").equals(field)) {\n            throw new Error(\"compiler inventory path is not valid UTF-8\");\n          }\n          let job;\n          // Enumerate three levels before scheduling recursive scans. This splits large\n          // immediate subtrees into independent jobs without following symlinked dirs.\n          if (entryType === \"d\" && entryDepth === 3) {\n            scanDirectories.push(item);\n            if (scanDirectories.length === DIRECTORY_BATCH_SIZE) {\n              job = scanDirectories;\n              scanDirectories = [];\n            }\n          } else {\n            if (entryType !== \"d\") {\n              directEntries.push(item);\n              if (directEntries.length === DIRECT_ENTRY_BATCH_SIZE) {\n                job = directEntries;\n                directEntries = [];\n              }\n            }\n          }\n          entryDepth = null;\n          entryType = null;\n          if (job) {\n            if (++jobCount > MAX_JOBS) {\n              failed = true;\n              stopAll(\"job_limit\");\n              throw new Error(\"compiler inventory job limit exceeded\");\n            }\n            yield job;\n          }\n        }\n        pending = data.subarray(offset);\n      }\n    } finally {\n      if (child.exitCode === null && !child.killed) child.kill(\"SIGTERM\");\n      const { code, signal } = await closed;\n      children.delete(child);\n      if (spawnError || code !== 0 || stderrBytes !== 0 || entryDepth !== null || entryType !== null || pending.length !== 0) {\n        failed = true;\n        const exitStatus = signal ? `signal_${signal.toLowerCase()}` : `code_${code ?? \"unknown\"}`;\n        stopAll(stderrBytes ? \"enumeration_stderr\" : spawnError ? \"enumeration_spawn_error\" : `enumeration_exit_batch_${batchIndex}_${exitStatus}`);\n      }\n    }\n    if (failed) throw new Error(\"compiler inventory enumeration failed\");\n    for (const remaining of [scanDirectories, directEntries]) {\n      if (remaining.length) {\n        if (++jobCount > MAX_JOBS) throw new Error(\"compiler inventory job limit exceeded\");\n","exit_code":0,"duration":{"secs":0,"nanos":633511888}},"started_at_ms":1793655940065,"completed_at_ms":1793655940699}}
{"timestamp":"2026-11-02T21:45:41.854Z","ordinal":47462,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a19e39-aade-7181-aa5b-d136408fb2f6","call_id":"call_4bd927013d2d437b8de0972cdcac59ee","output":[{"type":"input_text","text":"Script completed\nWall time 3.1 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 4830)\nTotal output lines: 382\n\n19:// and exclude only those exact subtrees from compiler inventory; every other mounted path\n241:export function scanOracleCompilerExposure(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS, additionalMountedPaths = [], approvedToolchainRoots = [], excludedDirectories = []) {\n258:  let inventoryFailureReason;\n321:      // fail-closed inventory fast enough for repeated evaluator launches. Do not follow\n328:        throw new Error(\"trusted compiler inventory tool is unavailable\");\n333:      const inventory = path.join(path.dirname(fileURLToPath(import.meta.url)), \"scan-compiler-exposure.mjs\");\n334:      const inventoryStat = fs.lstatSync(inventory);\n335:      if (!inventoryStat.isFile() || inventoryStat.isSymbolicLink() || (inventoryStat.mode & 0o022) !== 0\n336:        || fs.realpathSync(inventory) !== inventory) {\n337:        throw new Error(\"trusted compiler inventory helper is unavailable\");\n339:      const result = spawnSync(process.execPath, [inventory, ...[...directoryRoots].sort()], {\n348:        const helperFailure = /^trusted compiler inventory could not complete: ([a-z_0-9]+)\\n$/.exec(result.stderr?.toString(\"utf8\") ?? \"\");\n350:        inventoryFailureReason = helperFailure?.[1]\n357:        throw new Error(\"trusted compiler inventory could not complete\");\n364:    const reason = inventoryFailureReason ? ` (inventory ${inventoryFailureReason})` : \"\";\n371:export function compilerExposureMaskArgs(scan) {\n581:  const compilerExposure = scanOracleCompilerExposure(mountSources.systemDirectories, mountSources.systemEtcDirectories, [], mountSources.toolchainDirectories, maskedDirectories);\n582:  if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n611:  args.push(...compilerExposureMaskArgs(compilerExposure));\n704:  const compilerExposure = scanOracleCompilerExposure(\n711:  if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n750:  args.push(...compilerExposureMaskArgs(compilerExposure));\n762:  let compilerExposure = null;\n768:    compilerExposure = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths, Object.values(oracleToolchainSources).filter(Boolean), maskedDirectories);\n769:    if (compilerExposure.problem) throw new Error(compilerExposure.problem);\n815:  if (compilerExposure) args.push(...compilerExposureMaskArgs(compilerExposure));\n/**\n * Scoring integrity of the evaluation harness (REQ-QUAL-106, EVL-002/003/005): infrastructure failures are decided by\n * what the harness's model proxy observed, the same way for every agent; contaminated runs leave the pass rate;\n * reruns are listed; crashes are counted as crashes rather than rerun.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport http from \"node:http\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\nconst proxyModule = path.join(ROOT, \"eval/model_proxy.mjs\");\n\ntest(\"the model proxy forwards requests and counts answers and upstream failures\", async () => {\n  const { startModelProxy, isInfrastructureFailure } = await import(proxyModule);\n  const upstream = http.createServer((req, res) => {\n    if (req.url?.endsWith(\"/chat/completions\")) {\n      res.writeHead(503);\n      return void res.end(\"busy\");\n    }\n    res.setHeader(\"content-type\", \"application/json\");\n    res.end(JSON.stringify({ path: req.url }));\n  });\n  await new Promise<void>((r) => upstream.listen(0, \"127.0.0.1\", () => r()));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1` });\n  try {\n    assert.match(proxy.url, /^http:\\/\\/127\\.0\\.0\\.1:\\d+\\/v1$/);\n    const ok = await (await fetch(`${proxy.url}/models`)).json();\n    assert.equal(ok.path, \"/v1/models\");\n    assert.equal((await fetch(`${proxy.url}/chat/completions`, { method: \"POST\", body: \"{}\" })).status, 503);\n    assert.equal((await fetch(`${proxy.url}/admin/secrets`)).status, 404, \"control-plane paths are not forwarded\");\n    assert.equal((await fetch(`${proxy.url}/chat/completions`, { method: \"GET\" })).status, 404, \"unsupported methods are not forwarded\");\n    const stats = proxy.stats();\n    assert.equal(stats.requests, 4);\n    assert.equal(stats.answered, 1);\n    assert.equal(stats.upstreamFailures, 1);\n    assert.equal(isInfrastructureFailure({ model: stats }), false, \"the model answered: the run is scored\");\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n\n  const dead = await startModelProxy({ upstream: \"http://127.0.0.1:9/v1\" });\n  try {\n    assert.equal((await fetch(`${dead.url}/chat/completions`, { method: \"POST\", body: \"{}\" })).status, 502);\n    assert.equal(isInfrastructureFailure({ model: dead.stats() }), true, \"the model never answered and the endpoint failed\");\n  } finally {\n    await dead.close();\n  }\n});\n\ntest(\"the evaluation proxy authenticates the local run token and replaces it with the upstream credential\", async () => {\n  const { startModelProxy } = await import(proxyModule);\n  const seen: string[] = [];\n  const upstream = http.createServer((req, res) => {\n    seen.push(String(req.headers.authorization ?? \"\"));\n    res.end(JSON.stringify({ ok: true }));\n  });\n  await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1`, authToken: \"UPSTREAM_SECRET_CANARY\", clientToken: \"RUN_SCOPED_TOKEN\" });\n  try {\n    assert.equal((await fetch(`${proxy.url}/models`)).status, 401);\n    const accepted = await fetch(`${proxy.url}/models`, { headers: { authorization: \"Bearer RUN_SCOPED_TOKEN\" } });\n    assert.equal(accepted.status, 200);\n    assert.deepEqual(seen, [\"Bearer UPSTREAM_SECRET_CANARY\"]);\n    assert.equal((await fetch(`${proxy.url}/admin`, { headers: { authorization: \"Bearer RUN_SCOPED_TOKEN\" } })).status, 404);\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n});\n\ntest(\"the evaluation proxy bounds request count and body size\", async () => {\n  const { startModelProxy } = await import(proxyModule);\n  let upstreamRequests = 0;\n  const upstream = http.createServer((req, res) => { upstreamRequests++; req.resume(); res.end(\"ok\"); });\n  await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1`, maxRequests: 1, maxRequestBytes: 8 });\n  try {\n    const oversized = await fetch(`${proxy.url}/chat/completions`, { method: \"POST\", body: \"123456789\" }).catch(() => null);\n    assert.ok(oversized === null || oversized.status === 413);\n    assert.equal(upstreamRequests, 0, \"oversized bodies never reach t…1330 tokens truncated…path\";\n\nconst FIND = \"/usr/bin/find\";\nconst MAX_OUTPUT = 64 * 1024 * 1024;\nconst MAX_ENUMERATION_OUTPUT = 64 * 1024 * 1024;\n// This is a hard fail-closed bound. Keep the full inventory within it by letting GNU\n// find optimize the cheap name predicates ahead of filesystem metadata checks.\nconst TIMEOUT_MS = 25_000;\nconst MAX_ENTRIES = 500_000;\nconst MAX_JOBS = 100_000;\nconst MAX_ROOTS = 4_096;\nconst MAX_ROOT_BYTES = 1024 * 1024;\n// Amortize GNU find startup cost across disjoint system roots without approaching\n// the per-process argv size limit on Linux.\nconst MAX_ENUMERATION_ROOTS = 64;\nconst MAX_ENUMERATION_ROOT_BYTES = 64 * 1024;\n// Bundle enough sibling directories to avoid spawning one `find` process for\n// every pair on large hosted system roots, while keeping independent jobs for\n// bounded parallel scanning.\nconst DIRECTORY_BATCH_SIZE = 64;\nconst DIRECT_ENTRY_BATCH_SIZE = 256;\nconst SCAN_WORKERS = 8;\nconst COMPILER_NAMES = [\n  \"go\", \"go[0-9]*\", \"go-[0-9]*\",\n  \"rustc\", \"rustc[0-9]*\", \"rustc-[0-9]*\",\n  \"cargo\", \"cargo[0-9]*\", \"cargo-[0-9]*\",\n  \"rustup\",\n];\n\nfunction findArgs(roots) {\n  const nameExpression = COMPILER_NAMES.flatMap((name, index) => index === 0\n    ? [\"-name\", name]\n    : [\"-o\", \"-name\", name]);\n  const linkTargetExpression = COMPILER_NAMES.flatMap((name, index) => {\n    const patterns = [name, `*/${name}`];\n    return patterns.flatMap((pattern, patternIndex) => index === 0 && patternIndex === 0\n      ? [\"-lname\", pattern]\n      : [\"-o\", \"-lname\", pattern]);\n  });\n  return [\n    \"-O3\", \"-P\", ...roots,\n    \"(\", \"(\", \"-type\", \"l\", \"(\", ...nameExpression, \"-o\", ...linkTargetExpression, \")\", \")\",\n    \"-o\",\n    \"(\", \"(\", ...nameExpression, \")\", \"-a\", \"-type\", \"f\", \"-a\", \"-perm\", \"/111\", \")\",\n    \")\", \"-print0\",\n  ];\n}\n\nconst roots = process.argv.slice(2);\nconst rootBytes = roots.reduce((total, root) => total + Buffer.byteLength(root) + 1, 0);\nif (roots.length === 0 || roots.length > MAX_ROOTS || rootBytes > MAX_ROOT_BYTES || roots.some((root) => !root.startsWith(\"/\"))) {\n  process.stderr.write(\"compiler inventory roots must be absolute and within bounded input limits\\n\");\n  process.exit(2);\n}\n\nasync function* enumerateJobs() {\n  let entryCount = 0;\n  let jobCount = 0;\n  let enumerationBytes = 0;\n  let rootOffset = 0;\n  let batchIndex = 0;\n  while (rootOffset < roots.length) {\n    const batch = [];\n    let batchBytes = 0;\n    while (rootOffset < roots.length && batch.length < MAX_ENUMERATION_ROOTS) {\n      const root = roots[rootOffset];\n      const rootBytes = Buffer.byteLength(root) + 1;\n      if (batch.length > 0 && batchBytes + rootBytes > MAX_ENUMERATION_ROOT_BYTES) break;\n      batch.push(root);\n      batchBytes += rootBytes;\n      rootOffset += 1;\n    }\n    const child = spawn(FIND, [\"-P\", ...batch, \"-mindepth\", \"1\", \"-maxdepth\", \"3\", \"-printf\", \"%d\\\\0%y\\\\0%p\\\\0\"], {\n      env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    children.add(child);\n    let stderrBytes = 0;\n    let spawnError = null;\n    child.stderr.on(\"data\", (chunk) => {\n      stderrBytes += chunk.length;\n      failed = true;\n      stopAll(\"enumeration_stderr\");\n    });\n    child.on(\"error\", (error) => {\n      spawnError = error;\n      failed = true;\n      stopAll(\"enumeration_spawn_error\");\n    });\n    const closed = new Promise((resolve) => child.once(\"close\", (code, signal) => resolve({ code, signal })));\n    let scanDirectories = [];\n    let directEntries = [];\n    let entryDepth = null;\n    let entryType = null;\n    let pending = Buffer.alloc(0);\n    try {\n      for await (const chunk of child.stdout) {\n        enumerationBytes += chunk.length;\n        if (enumerationBytes > MAX_ENUMERATION_OUTPUT) {\n          failed = true;\n          stopAll(\"enumeration_output_limit\");\n          throw new Error(\"compiler inventory enumeration output limit exceeded\");\n        }\n        const data = pending.length ? Buffer.concat([pending, chunk]) : chunk;\n        let offset = 0;\n        while (true) {\n          const delimiter = data.indexOf(0, offset);\n          if (delimiter < 0) break;\n          const field = data.subarray(offset, delimiter);\n          offset = delimiter + 1;\n          if (entryDepth === null) {\n            if (field.length !== 1 || field[0] < 0x31 || field[0] > 0x33) {\n              throw new Error(\"invalid compiler inventory entry depth\");\n            }\n            entryDepth = field[0] - 0x30;\n            continue;\n          }\n          if (entryType === null) {\n            if (field.length !== 1) throw new Error(\"invalid compiler inventory entry type\");\n            entryType = field.toString(\"ascii\");\n            continue;\n          }\n          if (++entryCount > MAX_ENTRIES) {\n            failed = true;\n            stopAll(\"entry_limit\");\n            throw new Error(\"compiler inventory entry limit exceeded\");\n          }\n          const item = field.toString(\"utf8\");\n          if (!Buffer.from(item, \"utf8\").equals(field)) {\n            throw new Error(\"compiler inventory path is not valid UTF-8\");\n          }\n          let job;\n          // Enumerate three levels before scheduling recursive scans. This splits large\n          // immediate subtrees into independent jobs without following symlinked dirs.\n          if (entryType === \"d\" && entryDepth === 3) {\n            scanDirectories.push(item);\n            if (scanDirectories.length === DIRECTORY_BATCH_SIZE) {\n              job = scanDirectories;\n              scanDirectories = [];\n            }\n          } else {\n            if (entryType !== \"d\") {\n              directEntries.push(item);\n              if (directEntries.length === DIRECT_ENTRY_BATCH_SIZE) {\n                job = directEntries;\n                directEntries = [];\n              }\n            }\n          }\n          entryDepth = null;\n          entryType = null;\n          if (job) {\n            if (++jobCount > MAX_JOBS) {\n              failed = true;\n              stopAll(\"job_limit\");\n              throw new Error(\"compiler inventory job limit exceeded\");\n            }\n            yield job;\n          }\n        }\n        pending = data.subarray(offset);\n      }\n    } finally {\n      if (child.exitCode === null && !child.killed) child.kill(\"SIGTERM\");\n      const { code, signal } = await closed;\n      children.delete(child);\n      if (spawnError || code !== 0 || stderrBytes !== 0 || entryDepth !== null || entryType !== null || pending.length !== 0) {\n        failed = true;\n        const exitStatus = signal ? `signal_${signal.toLowerCase()}` : `code_${code ?? \"unknown\"}`;\n        stopAll(stderrBytes ? \"enumeration_stderr\" : spawnError ? \"enumeration_spawn_error\" : `enumeration_exit_batch_${batchIndex}_${exitStatus}`);\n      }\n    }\n    if (failed) throw new Error(\"compiler inventory enumeration failed\");\n    for (const remaining of [scanDirectories, directEntries]) {\n      if (remaining.length) {\n        if (++jobCount > MAX_JOBS) throw new Error(\"compiler inventory job limit exceeded\");\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","create_time":1793655941.8540633}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
