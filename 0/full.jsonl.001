ames of the failing tests (redacted, capped). */\n  failingTests?: string[];\n  /** How many distinct failing tests the run named, uncapped (up to MAX_COUNTED_FAILING_TESTS); absent on older attempts. */\n  failingTotal?: number;\n  /** True when `failingTests` holds fewer names than the run reported. */\n  failingTruncated?: boolean;\n  /** Redacted tail of the verifier's output, capped at MAX_ATTEMPT_EXCERPT_BYTES. */\n  excerpt?: string;\n  /** Lineage (DV-4): the previous real attempt (a skipped re-report is never a parent) and the hash of the step from its inputs to these. */\n  parent?: number;\n  /** sha256 of `parent.inputs NUL inputs`: it identifies the transition between two candidate identities, it is not a content diff. */\n  diffHash?: string;\n}\n\nexport interface ObjectiveOutcome {\n  status: \"completed\" | \"incomplete\" | \"blocked\";\n  reason: string;\n  failedCheck?: string;\n  remaining: string[];\n  nextAction?: string;\n  at: string;\n}\n\nexport interface ContinuationState {\n  /** Segments of `segmentSteps` steps the current turn has run (1 for an ordinary turn). */\n  segments: number;\n  /** Steps run against this objective across turns. */\n  totalSteps: number;\n  /** Step (within the current turn) of the last observed progress. */\n  lastProgressStep: number;\n  stopReason?: string;\n}\n\nexport interface ObjectiveLedger {\n  version: number;\n  /** Work unit id when this ledger is scoped to a work unit in an operation or team (REQ-AGT-102/103). */\n  unitId?: string;\n  objective: string;\n  objectiveSha256: string;\n  startedAt: string;\n  requirements: Requirement[];\n  scopeChanges: ScopeChange[];\n  steering: SteeringRecord[];\n  steeringConflicts?: SteeringConflict[];\n  return refusal ? { kind, note: refusal } : { kind, verifier: clean, verifierSource: \"operator\" };\n}\n\nfunction firstLine(text: string): string {\n  return text.split(\"\\n\").map((line) => line.trim()).find(Boolean) ?? text.trim();\n}\n\nexport function createLedger(objective: string, at = now(), unitId?: string): ObjectiveLedger {\n  return {\n    version: LEDGER_VERSION,\n    ...(unitId ? { unitId } : {}),\n    objective,\n    objectiveSha256: sha256(objective),\n    startedAt: at,\n    requirements: seedRequirements(objective).map((seed) => ({\n      ...seed,\n      status: \"open\" as const,\n      source: \"objective\" as const,\n      evidence: [],\n      updatedAt: at,\n    })),\n    scopeChanges: [],\n    steering: [],\n    verification: [],\n    continuation: { segments: 1, totalSteps: 0, lastProgressStep: 0 },\n    amendments: [],\n    execution: createTracking(),\n  };\n}\n\n/**\n * Requirements an operator follow-up adds to the objective it continues: its numbered items, appended after the\n * existing ones (an amendment never removes or rewrites what was asked before).\n */\nexport function amendObjective(ledger: ObjectiveLedger, prompt: string, at = now()): Requirement[] {\n  ledger.amendments.push({ at, text: prompt });\n  const seeds = seedRequirements(prompt);\n  if (seeds.length < 2) return [];\n  const base = ledger.requirements.filter((r) => r.source === \"objective\").length;\n  const added = seeds.map((seed, i) => ({\n    id: `R${base + i + 1}`,\n  /** Operator-authorised behavioural references, by requirement (DV-4 gate). */\n  references?: ReferenceDeclaration[];\n  /** Latest VC-3 differential run per requirement; finite agreement, never equivalence. */\n  differentials?: DifferentialRecord[];\n  continuation: ContinuationState;\n  /** The model's own statement of what comes next (update_requirements next_action). */\n  nextAction?: string;\n  /** Attempts numbered up to this were already judged non-converging and stopped the work; the next judgement starts after it. */\n  convergenceResetAfter?: number;\n  outcome?: ObjectiveOutcome;\n  /** Short follow-up messages the operator sent as new turns while this objective was unresolved. */\n  amendments: Array<{ at: string; text: string }>;\n  /**\n   * Objective-scoped execution tracking (core/execution_tracking.ts): cumulative steps, progress, repetition,\n   * failed approaches, interventions and compactions. Absent in ledgers written before it existed; `trackingOf` fills it.\n   */\n  execution?: ExecutionTracking;\n}\n\n/** The ledger's execution tracking, created (or completed, for a ledger restored from an earlier version) on first use. */\nexport function trackingOf(ledger: ObjectiveLedger): ExecutionTracker {\n  ledger.execution = normalizeTracking(ledger.execution);\n  // `ContinuationState.totalSteps` predates the richer execution record. Preserve its count when resuming a legacy\n  // task instead of normalizing a missing execution field to a false zero and granting fresh budget.\n  if (Number.isSafeInteger(ledger.continuation?.totalSteps) && ledger.continuation.totalSteps > ledger.execution.cumulativeSteps) {\n    ledger.execution.cumulativeSteps = ledger.continuation.totalSteps;\n  }\n  return new ExecutionTracker(ledger.execution);\n}\n5:import { assertValidContinuationBudget, ChatMessage, DEFAULT_CONTINUATION, EvaluationToolReceipt, HarnessConfig, MAX_CONTINUATION_STEPS, ToolCall, ToolDefinition } from \"./types.js\";\n361:    assertValidContinuationBudget(config.continuation);\n364:    if (!Number.isSafeInteger(config.maxSteps) || config.maxSteps < 1 || config.maxSteps > MAX_CONTINUATION_STEPS) {\n365:      throw new Error(`Invalid --max-steps value: expected an integer from 1 to ${MAX_CONTINUATION_STEPS}.`);\n1435:      this.objective.continuation = { ...this.objective.continuation, segments: 1, lastProgressStep: 0 };\n2296:    const recovery = { present: (id: string) => presentCalls.has(id), stagnationSteps: this.config.continuation?.stagnationSteps ?? DEFAULT_CONTINUATION.stagnationSteps, permits: this.toolPermitted() };\n2430:      this.observer.onActivity({ phase, step: turn.step, segment: this.objective?.continuation.segments ?? 1, ...extra });\n4394:    /** Step budget of this turn (the continuation total, or `maxSteps` for a single-segment turn). */\n4398:    continuation?: TurnResult[\"continuation\"];\n4626:    const stagnationSteps = this.config.continuation?.stagnationSteps ?? DEFAULT_CONTINUATION.stagnationSteps;\n4627:    const maxRecoveries = this.config.continuation?.maxRecoveries ?? DEFAULT_CONTINUATION.maxRecoveries;\n4628:    const maxTotalSteps = this.config.continuation?.maxTotalSteps ?? this.config.maxSteps;\n4658:        if (budgetLedger) budgetLedger.continuation.totalSteps = objectiveTracker.data.cumulativeSteps;\n      const orphaned = ledger ? supersededBy(ledger) : undefined;\n      ledger = createLedger(taskPrompt, undefined, this.unitId);\n      ledger.steering.push(...carried);\n      const prior = this.objective?.superseded ?? [];\n      if (prior.length || orphaned) ledger.superseded = [...prior, ...(orphaned ? [orphaned] : [])];\n    } else {\n      if (this.unitId && !ledger.unitId) {\n        ledger.unitId = this.unitId;\n      }\n      const isHarnessResume = /^\\[(?:Nexus|Work unit resumed)/.test(taskPrompt);\n      if (!isHarnessResume && !isStep && taskPrompt.trim() !== \"\") {\n        // The unfinished objective is kept; numbered items in the follow-up are added as further requirements.\n        amendObjective(ledger, taskPrompt);\n      }\n    }\n    ledger.outcome = undefined;\n    ledger.continuation = { ...ledger.continuation, segments: 1, lastProgressStep: 0, stopReason: undefined };\n    this.objective = ledger;\n    // VC-9 row 7: a steering conflict an earlier turn left unresolved is decided here if the operator answered its\n    // question; the others are carried, so only the turn that left a conflict unresolved reports it.\n    carryUnresolvedConflicts(\n      ledger,\n      (conflict) => {\n        const answer = this.operatorAnswers.get(buildSteeringConflictQuestion(conflict, safeOperatorText).id);\n        return answer === undefined ? undefined : answer === \"approve\";\n      },\n      (text) => safeOperatorText(text),\n    );\n  }\n\n  let currentStep = 1;\n  let stepsUsed = 0;\n  const providerRecoveries: ProviderRecoveryRecord[] = [];\n  const budget = this.config.continuation;\n  const segmentSteps = Math.max(1, this.config.maxSteps);\n  const maxTotalSteps = budget ? budget.maxTotalSteps : segmentSteps;\n  let segment = 1;\n  const tracker = this.objective && this.durable ? trackingOf(this.objective) : ExecutionTracker.fresh();\n\n  try {\n    if (this.flightRecorder) {\n      if (!this.flightRecorder.isSessionActive()) {\n        this.flightRecorder.startSession({\n          model: this.config.model,\n          endpoint: this.config.endpoint,\n          taskPrompt: promptText,\n        });\n      }\n      this.flightRecorder.recordTurnStart(1, promptText);\n    }\n\n","exit_code":0,"duration":{"secs":0,"nanos":892825226}},"started_at_ms":1795300986206,"completed_at_ms":1795300987100}}
