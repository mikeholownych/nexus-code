{"timestamp":"2026-11-21T22:39:34.577Z","ordinal":36703,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","item":{"type":"CommandExecution","id":"exec-713c8c7b-37ca-45ca-b269-3eca10cb1b35","process_id":"75179","command":["/usr/bin/zsh","-lc","git show origin/main:cli/src/core/spine_handlers.ts | sed -n '400,530p'; git show origin/main:cli/src/agent.ts | sed -n '4580,4685p'; git show origin/main:cli/src/core/run_turn.ts | sed -n '110,310p'; git show origin/main:cli/src/types.ts | sed -n '150,215p'; git grep -n \"delegatedBudget\" origin/main -- cli/test | head -n 100"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git show origin/main:cli/src/core/spine_handlers.ts | sed -n '400,530p'; git show origin/main:cli/src/agent.ts | sed -n '4580,4685p'; git show origin/main:cli/src/core/run_turn.ts | sed -n '110,310p'; git show origin/main:cli/src/types.ts | sed -n '150,215p'; git grep -n \"delegatedBudget\" origin/main -- cli/test | head -n 100"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"          const candidateWorkspace = this.activeWorktree.worktreePath;\n          const candidateIdentity = this.candidateTracker.computeCandidateIdentitySync(candidateWorkspace);\n          this.activeValidationReceipt = this.candidateTracker.recordValidationReceipt({\n            candidateId: candidateIdentity.candidateId,\n            verifierCommand: this.config.authoritativeVerifierCommand?.trim() || \"authoritative_verifier\",\n            exitCode: 0,\n            stdoutHash: verifierOutputHash,\n            status: \"PASSED\",\n            evaluatorBinding: {\n              evaluatorId: \"authoritative_verifier\",\n              evaluatorType: \"runTestSuiteWithExecutor\",\n              testSuite: this.config.authoritativeVerifierCommand?.trim(),\n            },\n            materialDependencies: collectMaterialDependencies(candidateWorkspace),\n          });\n          this.verifiedWorktreeCompletion = true;\n          if (this.durable && this.stateManager && this.currentTaskId) {\n            try {\n              this.stateManager.recordCandidateAndReceipt(this.currentTaskId, {\n                candidateId: candidateIdentity.candidateId,\n                candidateIdentity,\n                receipt: this.activeValidationReceipt,\n              });\n            } catch (err: any) {\n              this.reportPersistenceFailure(\"candidate_receipt\", err);\n            }\n          }\n        } catch {\n          this.verifiedWorktreeCompletion = false;\n        }\n      } else {\n        this.verifiedWorktreeCompletion = !worktreeHasChanges;\n      }\n    }\n    // DV-3: after the verifier above has had its chance to replay, an operator-authorised obligation still unmet blocks completion.\n    if (this.objective && (this.depth === 0 || this.role === \"implementer\" || this.role === \"tester\")) {\n      const unmet = unmetObligationsMessage(this.objective);\n      if (unmet) return { success: false, output: \"\", error: unmet };\n    }\n    this.completionSummary = { summary: args.summary || \"Task completed.\", notes: args.notes };\n    return {\n      success: true,\n      output: JSON.stringify({\n        status: \"completed\",\n        summary: args.summary || \"Task completed.\",\n        notes: args.notes || \"\",\n        verification: noApplicableVerifier ? \"NO_APPLICABLE_VERIFIER\" : verifierSucceeded ? \"PASSED\" : \"NOT_REQUIRED\",\n      }),\n    };\n  });\n\n  this.spine.registerHandler(\"spawn_subagent\", async (args: any, context: any) => {\n    let limits;\n    try { limits = delegationRuntimeLimits(); }\n    catch (error: any) { return { success: false, output: \"\", error: `Delegation configuration is invalid: ${error.message}` }; }\n    if (this.depth >= limits.maxDepth || context.metadata?.actor === \"subagent\") {\n      return {\n        success: false,\n        output: \"\",\n        error:\n          \"Error: Subagent depth limit reached. Solve the task directly without spawning additional subagents.\",\n      };\n    }\n\n    if (++this.delegatedChildrenStarted > limits.maxChildrenPerParent) {\n      return { success: false, output: \"\", error: `Subagent not started: this parent reached its limit of ${limits.maxChildrenPerParent} delegated children.` };\n    }\n\n    if (!args || typeof args !== \"object\" || Array.isArray(args) || Object.keys(args).some((key) => ![\"prompt\", \"profile\", \"inputs\", \"max_steps\"].includes(key))) {\n      return { success: false, output: \"\", error: \"Invalid delegation request. Only prompt, profile, inputs, and the ignored legacy max_steps field are accepted.\" };\n    }\n    const profile = args.profile === undefined ? \"semantic_explorer\" : args.profile;\n    if (typeof profile !== \"string\" || !Object.hasOwn(ROLE_PROFILES, profile)) {\n      return { success: false, output: \"\", error: \"Invalid delegation profile.\" };\n    }\n    let requestedInputs: Record<string, string> = args.inputs === undefined ? {} : args.inputs;\n    const inputsProblem = specialistInputsProblem(requestedInputs);\n    if (inputsProblem) {\n      return { success: false, output: \"\", error: `Invalid delegation inputs: ${inputsProblem}.` };\n    }\n\n    // A helper's agent builds its own clients from this config, so its first request would reach the provider a\n    // resumed turn is still waiting out. Declined for now; the model can go on without it or ask again later.\n    if (this.helperWindowOpen()) {\n      return {\n        success: false,\n        output: \"\",\n        error: `Subagent not started: ${RESUMED_WINDOW_REASON}. Continue without it, or start it in a later step.`,\n      };\n    }\n\n    if (typeof args.prompt !== \"string\" || args.prompt.length > 8_000 || Object.values(requestedInputs).some((value) => (value as string).length > 2_000)) {\n      return { success: false, output: \"\", error: \"Delegation prompt or inputs exceed the bounded request size.\" };\n    }\n    const prompt = args.prompt.trim() || \"Investigate the task\";\n    if (args.inputs === undefined && profile === \"semantic_explorer\") {\n      requestedInputs = { target_query: prompt, focus_directories: \".\" };\n    }\n    if (isSpecialistRole(profile)) {\n      const missing = missingSpecialistInputs(profile, requestedInputs);\n      if (missing.length) return { success: false, output: \"\", error: `Profile '${profile}' requires inputs: ${missing.join(\", \")}.` };\n    }\n    const subPrompt = `${prompt}${Object.keys(requestedInputs).length ? `\\n\\nAuthorized inputs:\\n${Object.entries(requestedInputs).map(([key, value]) => `- ${key}: ${value}`).join(\"\\n\")}` : \"\"}`;\n    // No step allowance: a helper stops on its report, on demonstrated lack of progress, or with the parent's turn\n    // (cancellation). A `max_steps` argument from the model is not an operator limit and is ignored.\n    const inheritedWorktreeScope = this.activeWorktree\n      ? { workspace: this.activeWorktree.worktreePath, requireSandbox: true as const }\n      : undefined;\n    if (!isReadOnlyRole(profile) && !this.activeWorktree) {\n      return { success: false, output: \"\", error: `Subagent not started: writable profile '${profile}' requires an established isolated worktree.` };\n    }\n    const profileTools = roleToolAllowList(profile) ?? new Set(ROLE_PROFILES[profile as AgentRole].recommendedTools);\n    const parentTools = new Set(this.getEffectiveTools().map((tool: any) => tool.function.name));\n    const parentGrants = this.authorityEngine.getGrants();\n    const hasExplicitParentGrants = parentGrants.length > 0;\n    const parentCapabilityAllowed = (name: string) => {\n      if (!hasExplicitParentGrants) return true;\n      const capabilityId = this.capabilityRegistry.getByToolName(name)?.id;\n      return Boolean(capabilityId && parentGrants.some((grant: any) => {\n        const actors = grant.actor === undefined ? [\"*\"] : Array.isArray(grant.actor) ? grant.actor : [grant.actor];\n        const domains = grant.executionDomain === undefined ? [\"*\"] : Array.isArray(grant.executionDomain) ? grant.executionDomain : [grant.executionDomain];\n        return (actors.includes(\"*\") || actors.includes(\"agent\")) &&\n          (domains.includes(\"*\") || domains.includes(\"agent_orchestration\")) &&\n          (grant.capabilities.includes(\"*\") || grant.capabilities.includes(capabilityId) || grant.capabilities.includes(name));\n      }));\n    };\n    const delegatedToolAllowList = [...profileTools].filter((name) => parentTools.has(name) && parentCapabilityAllowed(name));\n    const permittedCapabilities = delegatedToolAllowList.map((name) => this.capabilityRegistry.getByToolName(name)?.id).filter(Boolean);\n    const delegatedCapabilitySet = new Set(permittedCapabilities as string[]);\n    const delegatedAuthorityGrants = hasExplicitParentGrants\n      ? parentGrants.flatMap((grant: any) => {\n              `nexus: apply verified changes from ${this.activeWorktree.taskId}`,\n              this.activeValidationReceipt\n            );\n            if (!result.success) {\n              console.log(pc.yellow(`⚠️ Worktree merge did not complete cleanly: ${result.error || \"unknown error\"}`));\n            }\n          } else {\n            console.log(pc.yellow(`⚠️ Speculative changes are unverified or the root workspace is dirty; retaining worktree at ${this.activeWorktree.worktreePath}`));\n          }\n        } else {\n          const discarded = this.discardActiveWorktree();\n          if (!discarded.success) {\n            console.warn(pc.yellow(`⚠️ Clean worktree retained because discard could not be durably recorded: ${discarded.error || \"unknown error\"}`));\n          }\n        }\n      }\n    }\n    if (!turnResult) throw new Error(\"Turn ended without a result\");\n    return turnResult;\n  }\n\n  /**\n   * In-turn delegation for the spawn_subagent tool: a non-durable helper loop whose result is part of the parent's turn\n   * (the parent is the durable unit). It has no step allowance: it runs while it progresses (core/execution_tracking.ts)\n   * and stops on its report, on the same repetition and stagnation rules as a turn, or when the parent's turn is\n   * cancelled. Completed only when the subagent called task_completed or delivered a final report; inference failure,\n   * stagnation and cancellation are reported as not completed. Durable autonomous work (/team, nexus operation) does\n   * not use this path: it runs as scheduled work units.\n   */\n  public async runSubagent(prompt: string, onConfirm?: ConfirmHandler, signal?: AbortSignal): Promise<SubagentResult> {\n    if (this.config.worktree && !this.activeWorktree && !this.inheritedWorktreeScope) {\n      throw new Error(\"Cannot run a worktree-enabled subagent without an established worktree authority.\");\n    }\n    if (this.inheritedWorktreeScope && path.resolve(this.config.workspace) !== path.resolve(this.inheritedWorktreeScope.workspace)) {\n      throw new Error(\"Subagent workspace no longer matches its inherited worktree authority.\");\n    }\n    this.runningAsSubagent = true;\n    this.subagentObjective = prompt;\n    // A subagent is used for one run: its commands are tied to the parent turn's cancellation for its lifetime.\n    this.bridge.setTurnSignal(signal);\n    this.resetConversation();\n    this.messages.push({\n      role: \"user\",\n      content: `[Subagent Objective]: ${prompt}\\n\\nPlease inspect, execute tools as needed, and produce a concise, comprehensive report answering the objective. Call task_completed when done.`,\n    });\n\n    const stagnationSteps = this.config.continuation?.stagnationSteps ?? DEFAULT_CONTINUATION.stagnationSteps;\n    const maxRecoveries = this.config.continuation?.maxRecoveries ?? DEFAULT_CONTINUATION.maxRecoveries;\n    const maxTotalSteps = this.config.continuation?.maxTotalSteps ?? this.config.maxSteps;\n    // A subagent consumes the same objective-wide step allowance as its parent. The shared tracking data survives\n    // resume; the subagent's local tracker below is only for its own progress/stagnation decisions.\n    const budgetLedger = this.sharedObjectiveBudget?.ledger ?? (this.durable ? this.objective : undefined);\n    const objectiveTracker = budgetLedger ? trackingOf(budgetLedger) : undefined;\n    const tracker = ExecutionTracker.fresh();\n    tracker.beginTurn();\n    let state = this.workspaceStateIdentity();\n    tracker.noteState(state);\n    let recoveries = 0;\n    let currentStep = 1;\n    let finalSummary = \"\";\n    let previousReplyTruncated = false;\n\n    for (;;) {\n      if (signal?.aborted) return { completed: false, summary: finalSummary, reason: \"cancelled with the parent turn\" };\n      if (this.delegatedBudget && this.delegatedBudget.steps >= this.delegatedBudget.maxInferenceSteps) {\n        return { completed: false, summary: finalSummary, reason: `delegated inference budget exhausted (${this.delegatedBudget.steps}/${this.delegatedBudget.maxInferenceSteps})` };\n      }\n      const consumedTaskSteps = objectiveTracker?.data.cumulativeSteps ?? (currentStep - 1);\n      if (consumedTaskSteps >= maxTotalSteps) {\n        return { completed: false, summary: finalSummary, reason: `objective step budget exhausted (${consumedTaskSteps}/${maxTotalSteps}); no further subagent inference was submitted` };\n      }\n      if (tracker.data.stepsWithoutProgress >= stagnationSteps) {\n        const loops = tracker.loops().slice(0, 2).map((r) => `${r.action} ×${r.count}`).join(\"; \");\n        return { completed: false, summary: finalSummary, reason: `no progress for ${tracker.data.stepsWithoutProgress} consecutive steps${loops ? ` (repeated: ${loops})` : \"\"}` };\n      }\n      const cumulativeStep = tracker.beginStep();\n      if (objectiveTracker) {\n        objectiveTracker.beginStep();\n        if (budgetLedger) budgetLedger.continuation.totalSteps = objectiveTracker.data.cumulativeSteps;\n        // The helper runs through this parent agent, so its extra inference steps must be in the durable objective\n        // ledger before any request is sent. Do not persist the helper's temporary message array as the parent chat.\n        const persisted = this.sharedObjectiveBudget ? this.sharedObjectiveBudget.persist() : this.persistObjectiveBudget();\n        if (!persisted) {\n          return { completed: false, summary: finalSummary, reason: \"PERSISTENCE_FAILED: the shared objective budget could not be saved before delegated inference\" };\n        }\n      }\n      let assistantMessage: ChatMessage;\n      if (this.delegatedBudget) this.delegatedBudget.steps++;\n      const requestId = randomUUID();\n      const { client: activeClient } = this.selectCognitiveClient(currentStep, this.messages);\n      try {\n        // Subagent inference uses the selected connection's advertised limits too; after the first discovery the depth\n        // guard prevents nested workers from repeatedly reading the same catalog.\n        await this.refreshCapabilities(activeClient, \"subagent step\", false, signal);\n        await this.admitWithFindings(activeClient, currentStep, requestId, signal);\n        await this.measureAdmission(activeClient, currentStep, requestId, signal);\n        const policy = this.recoveryPolicy ?? recoveryPolicyFromEnv();\n        const lengthGuard = { step: currentStep, cutAfterMs: 0 };\n        assistantMessage = await new ProviderRecoveryController(policy, this.recoveryClock, currentStep, {\n          everSucceeded: typeof activeClient.hasEverSucceeded === \"function\" ? activeClient.hasEverSucceeded() : true,\n          endpoint: activeClient.endpoint,\n        }).run(requestId, {\n          submit: (s) => this.submitGenAiRequest(activeClient, () =>\n            this.submitGuardingLength(lengthGuard, this.messages, (request) =>\n              activeClient.chatCompletion(request, this.getEffectiveTools(), s.requestId, signal))),\n          probe: (probeSignal, opts) =>\n  // The objective this turn works toward: a new one, or a short follow-up on the one still unresolved.\n  const priorLedger = this.objective ? structuredClone(this.objective) : undefined;\n  let continuingObjective = false;\n  const isResume = Boolean(options?.resume);\n  const isStep = Boolean(options?.step ?? this.config.step);\n  if (typeof taskPrompt === \"string\" && this.durable) {\n    let ledger = this.objective;\n    continuingObjective = Boolean(ledger && (isResume || isStep || !isNewObjective(ledger, taskPrompt)));\n    if (!ledger || (!isResume && !isStep && isNewObjective(ledger, taskPrompt))) {\n      const carried = ledger?.steering.filter((s: any) => s.status === \"queued\") ?? [];\n      const orphaned = ledger ? supersededBy(ledger) : undefined;\n      ledger = createLedger(taskPrompt, undefined, this.unitId);\n      ledger.steering.push(...carried);\n      const prior = this.objective?.superseded ?? [];\n      if (prior.length || orphaned) ledger.superseded = [...prior, ...(orphaned ? [orphaned] : [])];\n    } else {\n      if (this.unitId && !ledger.unitId) {\n        ledger.unitId = this.unitId;\n      }\n      const isHarnessResume = /^\\[(?:Nexus|Work unit resumed)/.test(taskPrompt);\n      if (!isHarnessResume && !isStep && taskPrompt.trim() !== \"\") {\n        // The unfinished objective is kept; numbered items in the follow-up are added as further requirements.\n        amendObjective(ledger, taskPrompt);\n      }\n    }\n    ledger.outcome = undefined;\n    ledger.continuation = { ...ledger.continuation, segments: 1, lastProgressStep: 0, stopReason: undefined };\n    this.objective = ledger;\n    // VC-9 row 7: a steering conflict an earlier turn left unresolved is decided here if the operator answered its\n    // question; the others are carried, so only the turn that left a conflict unresolved reports it.\n    carryUnresolvedConflicts(\n      ledger,\n      (conflict) => {\n        const answer = this.operatorAnswers.get(buildSteeringConflictQuestion(conflict, safeOperatorText).id);\n        return answer === undefined ? undefined : answer === \"approve\";\n      },\n      (text) => safeOperatorText(text),\n    );\n  }\n\n  let currentStep = 1;\n  let stepsUsed = 0;\n  const providerRecoveries: ProviderRecoveryRecord[] = [];\n  const budget = this.config.continuation;\n  const segmentSteps = Math.max(1, this.config.maxSteps);\n  const maxTotalSteps = budget ? budget.maxTotalSteps : segmentSteps;\n  let segment = 1;\n  const tracker = this.objective && this.durable ? trackingOf(this.objective) : ExecutionTracker.fresh();\n\n  try {\n    if (this.flightRecorder) {\n      if (!this.flightRecorder.isSessionActive()) {\n        this.flightRecorder.startSession({\n          model: this.config.model,\n          endpoint: this.config.endpoint,\n          taskPrompt: promptText,\n        });\n      }\n      this.flightRecorder.recordTurnStart(1, promptText);\n    }\n\n    // Dynamic runtime state injected into turn-level context without invalidating system prompt prefix cache\n    const gitInfo = getGitInfo(this.config.workspace);\n    let runtimeContext = \"\";\n    if (gitInfo.isRepo) {\n      runtimeContext += `\\n[Git Status: ${gitInfo.branch} (${gitInfo.dirtyCount} uncommitted dirty files)]`;\n    }\n    if (this.activePlan && this.activePlan.length > 0) {\n      runtimeContext += `\\n[Active Plan: ${this.activePlan.map((p: any, i: any) => `${i + 1}. [${p.status}] ${p.name}`).join(\" -> \")}]`;\n    }\n\n    const skipPromptSubmission =\n      (isStep || isResume) &&\n      typeof taskPrompt === \"string\" &&\n      taskPrompt.trim() === \"\" &&\n      (this.messages.length > 0 || continuingObjective);\n\n    const effectiveUserContent = typeof taskPrompt === \"string\"\n      ? (runtimeContext ? `${taskPrompt}\\n${runtimeContext}` : taskPrompt)\n      : taskPrompt;\n\n    const historyBeforeSubmission = this.messages.length;\n    if (!skipPromptSubmission) {\n      this.messages.push({\n        role: \"user\",\n        content: effectiveUserContent,\n      });\n      // Skills whose descriptions fit this message, written once right after it and never moved: every later\n      // request extends the earlier ones, so the provider's prefix cache survives each new prompt.\n      const skillNote = this.skillNoteFor(taskPrompt);\n      if (skillNote) this.messages.push({ role: \"user\", content: skillNote, harness: \"skill-note\" });\n      // The objective is durable before anything acts on it.\n      this.persistProgress({ messages: true });\n    }\n    const pendingMessageChars = typeof effectiveUserContent === \"string\" ? effectiveUserContent.length : JSON.stringify(effectiveUserContent).length;\n\n    let capacityBlock: CapacityRecord | null = null;\n    let modelStop: ModelStop = \"NONE\";\n    let finalOutputComplete = false;\n    let previousReplyEmpty = false;\n    // The previous step's reply was cut off at the output limit; a second one in a row ends the turn.\n    let previousReplyTruncated = false;\n    let capacityRetryAttempted = false;\n    let inferenceFailure: InferenceFailure | null = null;\n    let interruption: InterruptionRecord | null = null;\n    let undispatched = 0;\n    let persistenceFailure: string | undefined;\n\n    const markInterrupted = (phase: InterruptionRecord[\"phase\"], extra: Partial<InterruptionRecord> = {}) => {\n      interruption = {\n        requestedAt: turn.cancelRequestedAt || new Date().toISOString(),\n        phase,\n        undispatchedToolCalls: undispatched,\n        ...extra,\n      };\n    };\n    const cancelledToolMessage = (call: ToolCall) => ({\n      role: \"tool\" as const,\n      tool_call_id: call.id,\n      name: call.function.name,\n      content: \"Cancelled by operator before execution. No action was taken.\",\n    });\n\n    // Continuation: `maxSteps` is a segment, a durable checkpoint. The total-step budget is objective-scoped and\n    // survives resumes; the active invocation also has a finite wall-clock limit. Without continuation\n    // (`--no-continuation`), the first segment boundary ends the turn (LIMIT_REACHED, legacy).\n    const turnDeadline = budget && Number.isFinite(budget.maxTurnMinutes) ? Date.now() + budget.maxTurnMinutes * 60_000 : Number.POSITIVE_INFINITY;\n    let stopReason: TurnReason | undefined;\n    let stopDetail: string | undefined;\n    let completionNudges = 0;\n    // Recovery state (notes, stage, refusals) lives in the tracker: in the ledger when durable, so compaction cannot\n    // remove it and resume restores it.\n    const allowedDenials = budget ? Math.max(1, budget.maxRecoveries) : 0;\n    this.stateIdentityDisabled = false;\n    this.stateIdentityUncertainty = undefined;\n    tracker.beginTurn();\n    if (continuingObjective) {\n      const isHarnessResume = typeof taskPrompt === \"string\" && /^\\[(?:Nexus|Work unit resumed)/.test(taskPrompt);\n      if (!isHarnessResume && !options?.resume && !isStep) {\n        tracker.operatorInput(tracker.data.cumulativeSteps, `operator follow-up: ${promptText.slice(0, 160)}`);\n      }\n    }\n    let stateNow = this.workspaceStateIdentity();\n    this.turnStartState = stateNow;\n    tracker.noteState(stateNow);\n    tracker.noteLedgerState(this.ledgerProgressIdentity());\n    const noticedPolls = new Set<string>();\n    const noticedThrash = new Set<string>();\n    let stateUnknownNoted = false;\n    const callRing: CallRecord[] = [];\n    let repeatedCallNote: string | undefined;\n    let loopedCall: { name: string; count: number; arguments: string; history: NonNullable<TurnResult[\"repeatedCall\"]>[\"history\"] } | undefined;\n\n    while (modelStop === \"NONE\" && !interruption && !inferenceFailure && !persistenceFailure) {\n      const convergence = this.turnConvergence as TurnResult[\"convergence\"];\n      if (convergence && !stopReason) {\n        stopReason = \"VERIFIER_NOT_CONVERGING\";\n        stopDetail = convergence.evidence;\n        if (this.objective && this.turnConvergenceUpTo !== undefined) this.objective.convergenceResetAfter = this.turnConvergenceUpTo;\n      }\n      if (stopReason) break;\n      const taskStepLimitReached = budget\n        ? tracker.data.cumulativeSteps >= maxTotalSteps\n        : currentStep > maxTotalSteps;\n      if (taskStepLimitReached) {\n        stopReason = budget ? \"STEP_BUDGET_EXHAUSTED\" : \"STEP_LIMIT_REACHED\";\n        stopDetail = budget\n          ? `objective step limit ${maxTotalSteps} reached (${tracker.data.cumulativeSteps} steps consumed across runs)`\n          : `--no-continuation: ${segmentSteps} steps`;\n        break;\n      }\n      if (Date.now() > turnDeadline) {\n        stopReason = \"TIME_BUDGET_EXHAUSTED\";\n        stopDetail = `operator time limit ${budget!.maxTurnMinutes} min`;\n        break;\n      }\n      if (budget && tracker.data.stepsWithoutProgress >= budget.stagnationSteps) {\n        stopReason = \"STAGNATION_DETECTED\";\n        const loops = tracker.loops().slice(0, 2).map((r) => `${r.action} ×${r.count}`).join(\"; \");\n        const thrash = tracker.reacquisitions().filter((r) => (r.reacquired ?? 0) >= 2).slice(0, 2).map((r) => `${r.action} re-read ×${r.reacquired} after compaction`).join(\"; \");\n        stopDetail = `${tracker.data.stepsWithoutProgress} consecutive steps without progress${loops ? ` (repeated: ${loops})` : \"\"}${thrash ? ` (context thrash: ${thrash})` : \"\"}${this.stateIdentityUncertainty ? `; ${this.stateIdentityUncertainty}` : \"\"}`;\n        tracker.stagnation(tracker.data.cumulativeSteps, \"no_progress\", stopDetail);\n        break;\n      }\n      if (signal.aborted) {\n        markInterrupted(\"between_steps\");\n        break;\n      }\n      // --step: one model/tool cycle per turn. Every path that continues the loop ends its cycle with endStep (recovery\n      // note delivered, progress evaluated) and comes back here, so this one boundary covers the sequential, parallel-read\n      // and notice paths alike; a stop set by the cycle or by the checks above (STAGNATION_DETECTED, a budget, a cancel)\n      // is reported instead. currentStep advances only in endStep, so it is past 1 once this turn finished a cycle.\n      if (isStep && currentStep > 1) {\n        stopReason = \"STEP_PAUSED\";\n        stopDetail = \"paused after one model/tool cycle (--step)\";\n        break;\n      }\n      // Operator /compact queued during the previous step runs here: its inference and tool batch have settled.\n      // False when a compaction that is not durable ends the turn.\n      const drainQueuedCompactions = async (): Promise<boolean> => {\n        // A `/compact --llm` stays queued while a resumed window covers the provider it calls (see drainCompactionQueue).\n  outcomeUnknown?: boolean;\n  /** Why the call was refused before it ran (a stable code, e.g. VERIFICATION_CONFIG_PROTECTED). */\n  denialReason?: string;\n}\n\n/**\n * Bounds for automatically continued work. The total-step limit is cumulative across every invocation that continues\n * the same durable objective; the wall-clock limit bounds one active invocation. Progress detection remains a separate\n * early-stop mechanism, not a substitute for these hard ceilings.\n */\nexport interface ContinuationBudget {\n  /** Maximum steps for one objective across runs and resumes (STEP_BUDGET_EXHAUSTED). */\n  maxTotalSteps: number;\n  /** Maximum wall-clock minutes for one invocation (TIME_BUDGET_EXHAUSTED). */\n  maxTurnMinutes: number;\n  /**\n   * Consecutive steps without observed progress before the turn stops (STAGNATION_DETECTED). A repeated-state\n   * threshold, not a task length: any progressing step resets it (core/execution_tracking.ts defines progress).\n   */\n  stagnationSteps: number;\n  /** Recovery notes the agent may inject for a repeated identical action before stopping (bounded recovery). */\n  maxRecoveries: number;\n  /** Times the agent may be asked to continue when it stops with acceptance requirements still open. */\n  maxCompletionNudges: number;\n  /**\n   * Consecutive failed verifier attempts on changing candidates that stop the turn as VERIFIER_NOT_CONVERGING when they\n   * show the same failure, an A/B alternation or a rising failing-test count (default 3, NEXUS_VERIFIER_CONVERGENCE_ATTEMPTS).\n   */\n  verifierConvergenceAttempts?: number;\n}\n\n/** Hard upper bounds keep an operator override finite even when a config or direct API caller bypasses CLI parsing. */\nexport const MAX_CONTINUATION_STEPS = 5_000;\nexport const MAX_CONTINUATION_MINUTES = 4_320;\n\nexport function assertValidContinuationBudget(budget: ContinuationBudget | undefined): void {\n  if (!budget) return;\n  if (!Number.isSafeInteger(budget.maxTotalSteps) || budget.maxTotalSteps < 1 || budget.maxTotalSteps > MAX_CONTINUATION_STEPS) {\n    throw new Error(`Invalid continuation step budget: expected an integer from 1 to ${MAX_CONTINUATION_STEPS}.`);\n  }\n  if (!Number.isFinite(budget.maxTurnMinutes) || budget.maxTurnMinutes < 1 / 60 || budget.maxTurnMinutes > MAX_CONTINUATION_MINUTES) {\n    throw new Error(`Invalid continuation time budget: expected a finite value from 1 second to ${MAX_CONTINUATION_MINUTES} minutes.`);\n  }\n}\n\n/** Failed verifier attempts on changing candidates that show no convergence before the turn stops (see ContinuationBudget). */\nexport const DEFAULT_CONVERGENCE_ATTEMPTS = 3;\n\nexport const DEFAULT_CONTINUATION: ContinuationBudget = {\n  maxTotalSteps: 500,\n  maxTurnMinutes: 480,\n  stagnationSteps: 12,\n  maxRecoveries: 2,\n  maxCompletionNudges: 2,\n};\n\nexport type ApprovalMode = \"auto\" | \"review\" | \"read-only\";\n","exit_code":0,"duration":{"secs":0,"nanos":72781}},"started_at_ms":1795300774576,"completed_at_ms":1795300774577}}
{"timestamp":"2026-11-21T22:39:34.721Z","ordinal":36704,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a20043-d341-7fc1-95da-ba2dfb47fd29","call_id":"call_9a0c11bf4bad475bb20de7c69e8c018b","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 6977)\nTotal output lines: 495\n\n          const candidateWorkspace = this.activeWorktree.worktreePath;\n          const candidateIdentity = this.candidateTracker.computeCandidateIdentitySync(candidateWorkspace);\n          this.activeValidationReceipt = this.candidateTracker.recordValidationReceipt({\n            candidateId: candidateIdentity.candidateId,\n            verifierCommand: this.config.authoritativeVerifierCommand?.trim() || \"authoritative_verifier\",\n            exitCode: 0,\n            stdoutHash: verifierOutputHash,\n            status: \"PASSED\",\n            evaluatorBinding: {\n              evaluatorId: \"authoritative_verifier\",\n              evaluatorType: \"runTestSuiteWithExecutor\",\n              testSuite: this.config.authoritativeVerifierCommand?.trim(),\n            },\n            materialDependencies: collectMaterialDependencies(candidateWorkspace),\n          });\n          this.verifiedWorktreeCompletion = true;\n          if (this.durable && this.stateManager && this.currentTaskId) {\n            try {\n              this.stateManager.recordCandidateAndReceipt(this.currentTaskId, {\n                candidateId: candidateIdentity.candidateId,\n                candidateIdentity,\n                receipt: this.activeValidationReceipt,\n              });\n            } catch (err: any) {\n              this.reportPersistenceFailure(\"candidate_receipt\", err);\n            }\n          }\n        } catch {\n          this.verifiedWorktreeCompletion = false;\n        }\n      } else {\n        this.verifiedWorktreeCompletion = !worktreeHasChanges;\n      }\n    }\n    // DV-3: after the verifier above has had its chance to replay, an operator-authorised obligation still unmet blocks completion.\n    if (this.objective && (this.depth === 0 || this.role === \"implementer\" || this.role === \"tester\")) {\n      const unmet = unmetObligationsMessage(this.objective);\n      if (unmet) return { success: false, output: \"\", error: unmet };\n    }\n    this.completionSummary = { summary: args.summary || \"Task completed.\", notes: args.notes };\n    return {\n      success: true,\n      output: JSON.stringify({\n        status: \"completed\",\n        summary: args.summary || \"Task completed.\",\n        notes: args.notes || \"\",\n        verification: noApplicableVerifier ? \"NO_APPLICABLE_VERIFIER\" : verifierSucceeded ? \"PASSED\" : \"NOT_REQUIRED\",\n      }),\n    };\n  });\n\n  this.spine.registerHandler(\"spawn_subagent\", async (args: any, context: any) => {\n    let limits;\n    try { limits = delegationRuntimeLimits(); }\n    catch (error: any) { return { success: false, output: \"\", error: `Delegation configuration is invalid: ${error.message}` }; }\n    if (this.depth >= limits.maxDepth || context.metadata?.actor === \"subagent\") {\n      return {\n        success: false,\n        output: \"\",\n        error:\n          \"Error: Subagent depth limit reached. Solve the task directly without spawning additional subagents.\",\n      };\n    }\n\n    if (++this.delegatedChildrenStarted > limits.maxChildrenPerParent) {\n      return { success: false, output: \"\", error: `Subagent not started: this parent reached its limit of ${limits.maxChildrenPerParent} delegated children.` };\n    }\n\n    if (!args || typeof args !== \"object\" || Array.isArray(args) || Object.keys(args).some((key) => ![\"prompt\", \"profile\", \"inputs\", \"max_steps\"].includes(key))) {\n      return { success: false, output: \"\", error: \"Invalid delegation request. Only prompt, profile, inputs, and the ignored legacy max_steps field are accepted.\" };\n    }\n    const profile = args.profile === undefined ? \"semantic_explorer\" : args.profile;\n    if (typeof profile !== \"string\" || !Object.hasOwn(ROLE_PROFILES, profile)) {\n      return { success: false, output: \"\", error: \"Invalid delegation profile.\" };\n    }\n    let requestedInputs: Record<string, string> = args.inputs === undefined ? {} : args.inputs;\n    const inputsProblem = specialistInputsProblem(requestedInputs);\n    if (inputsProblem) {\n      return { success: false, output: \"\", error: `Invalid delegation inputs: ${inputsProblem}.` };\n    }\n\n    // A helper's agent builds its own clients from this config, so its first request would reach the provider a\n    // resumed turn is still waiting out. Declined for now; the model can go on without it or ask again later.\n    if (this.helperWindowOpen()) {\n      return {\n        success: false,\n        output: \"\",\n        error: `Subagent not started: ${RESUMED_WINDOW_REASON}. Continue without it, or start it in a later step.`,\n      };\n    }\n\n    if (typeof args.prompt !== \"string\" || args.prompt.length > 8_000 || Object.values(requestedInputs).some((value) => (value as string).length > 2_000)) {\n      return { success: false, output: \"\", error: \"Delegation prompt or inputs exceed the bounded request size.\" };\n    }\n    const prompt = args.prompt.trim() || \"Investigate the task\";\n    if (args.inputs === undefined && profile === \"semantic_explorer\") {\n      requestedInputs = { target_query: prompt, focus_directories: \".\" };\n    }\n    if (isSpecialistRole(profile)) {\n      const missing = missingSpecialistInputs(profile, requestedInputs);\n      if (missing.length) return { success: false, output: \"\", error: `Profile '${profile}' requires inputs: ${missing.join(\", \")}.` };\n    }\n    const subPrompt = `${prompt}${Object.keys(requestedInputs).length ? `\\n\\nAuthorized inputs:\\n${Object.entries(requestedInputs).map(([key, value]) => `- ${key}: ${value}`).join(\"\\n\")}` : \"\"}`;\n    // No step allowance: a helper stops on its report, on demonstrated lack of progress, or with the parent's turn\n    // (cancellation). A `max_steps` argument from the model is not an operator limit and is ignored.\n    const inheritedWorktreeScope = this.activeWorktree\n      ? { workspace: this.activeWorktree.worktreePath, requireSandbox: true as const }\n      : undefined;\n    if (!isReadOnlyRole(profile) && !this.activeWorktree) {\n      return { success: false, output: \"\", error: `Subagent not started: writable profile '${profile}' requires an established isolated worktree.` };\n    }\n    const profileTools = roleToolAllowList(profile) ?? new Set(ROLE_PROFILES[profile as AgentRole].recommendedTools);\n    const parentTools = new Set(this.getEffectiveTools().map((tool: any) => tool.function.name));\n    const parentGrants = this.authorityEngine.getGrants();\n    const hasExplicitParentGrants = parentGrants.length > 0;\n    const parentCapabilityAllowed = (name: string) => {\n      if (!hasExplicitParentGrants) return true;\n      const capabilityId = this.capabilityRegistry.getByToolName(name)?.id;\n      return Boolean(capabilityId && parentGrants.some((grant: any) => {\n        const actors = grant.actor === undefined ? [\"*\"] : Array.isArray(grant.actor) ? grant.actor : [grant.actor];\n        const domains = grant.executionDomain === undefined ? [\"*\"] : Array.isArray(grant.executionDomain) ? grant.executionDomain : [grant.executionDomain];\n        return (actors.includes(\"*\") || actors.includes(\"agent\")) &&\n          (domains.includes(\"*\") || domains.includes(\"agent_orchestration\")) &&\n          (grant.capabilities.includes(\"*\") || grant.capabilities.includes(capabilityId) || grant.capabilities.includes(name));\n      }));\n    };\n    const delegatedToolAllowList = [...profileTools].filter((name) => parentTools.has(name) && parentCapabilityAllowed(name));\n    const permittedCapabilities = delegatedToolAllowList.map((name) => this.capabilityRegistry.getByToolName(name)?.id).filter(Boolean);\n    const delegatedCapabilitySet = new Set(permittedCapabilities as string[]);\n    const delegatedAuthorityGrants = hasExplicitParentGrants\n      ? parentGrants.flatMap((grant: any) => {\n              `nexus: apply verified changes from ${this.activeWorktree.taskId}`,\n              this.activeValidationReceipt\n            );\n            if (!result.success) {\n              console.log(pc.yellow(`⚠️ Worktree merge did not complete cleanly: ${result.error || \"unknown error\"}`));\n            }\n          } else {\n            console.log(pc.yellow(`⚠️ Speculative changes are unverified or the root workspace is dirty; retaining worktree at ${this.activeWorktree.worktreePath}`));\n          }\n        } else {\n          const discarded = this.discardActiveWorktree();\n          if (!discarded.success) {\n            console.warn(pc.yellow(`⚠️ Clean worktree retained because discard could not be durably recorded: ${discarded.error || \"unknown error\"}`));\n          }\n        }\n      }\n    }\n    if (!turnResult) throw new Error(\"Turn ended without a result\");\n    return turnResult;\n  }\n\n  /**\n   * In-turn delegation for the spawn_subagent tool: a non-durable helper loop whose result is part of the parent's turn\n   * (the parent is the durable unit). It has no step allowance: it runs while it progresses (core/execution_tracking.ts)\n   * and stops on its report, on the same repetition and stagnation rules as a turn, or when the parent's turn is\n   * cancelled. Completed only when the subagent called task_completed or delivered a final report; inference failure,\n   * stagnation and cancellation are reported as not completed. Durable autonomous work (/team, nexus operation) does\n   * not use this path: it runs as scheduled work units.\n   */\n  public async runSubagent(prompt: string, onConfirm?: ConfirmHandler, signal?: AbortSignal): Promise<SubagentResult> {\n    if (this.config.worktree && !this.activeWorktree && !this.inheritedWorktreeScope) {\n      throw new Error(\"Cannot run a worktree-enabled subagent without an established worktree authority.\");\n    }\n    if (this.inheritedWorktreeScope && path.resolve(this.config.workspace) !== path.resolve(this.inheritedWorktreeScope.workspace)) {\n      throw new Error(\"Subagent workspace no longer matches its inherited worktree authority.\");\n    }\n    this.runningAsSubagent = true;\n    this.subagentObjective = prompt;\n    // A subagent is used for one run: its commands are tied to the parent turn's cancellation for its lifetime.\n    this.bridge.setTurnSignal(signal);\n    t…1977 tokens truncated….activePlan.map((p: any, i: any) => `${i + 1}. [${p.status}] ${p.name}`).join(\" -> \")}]`;\n    }\n\n    const skipPromptSubmission =\n      (isStep || isResume) &&\n      typeof taskPrompt === \"string\" &&\n      taskPrompt.trim() === \"\" &&\n      (this.messages.length > 0 || continuingObjective);\n\n    const effectiveUserContent = typeof taskPrompt === \"string\"\n      ? (runtimeContext ? `${taskPrompt}\\n${runtimeContext}` : taskPrompt)\n      : taskPrompt;\n\n    const historyBeforeSubmission = this.messages.length;\n    if (!skipPromptSubmission) {\n      this.messages.push({\n        role: \"user\",\n        content: effectiveUserContent,\n      });\n      // Skills whose descriptions fit this message, written once right after it and never moved: every later\n      // request extends the earlier ones, so the provider's prefix cache survives each new prompt.\n      const skillNote = this.skillNoteFor(taskPrompt);\n      if (skillNote) this.messages.push({ role: \"user\", content: skillNote, harness: \"skill-note\" });\n      // The objective is durable before anything acts on it.\n      this.persistProgress({ messages: true });\n    }\n    const pendingMessageChars = typeof effectiveUserContent === \"string\" ? effectiveUserContent.length : JSON.stringify(effectiveUserContent).length;\n\n    let capacityBlock: CapacityRecord | null = null;\n    let modelStop: ModelStop = \"NONE\";\n    let finalOutputComplete = false;\n    let previousReplyEmpty = false;\n    // The previous step's reply was cut off at the output limit; a second one in a row ends the turn.\n    let previousReplyTruncated = false;\n    let capacityRetryAttempted = false;\n    let inferenceFailure: InferenceFailure | null = null;\n    let interruption: InterruptionRecord | null = null;\n    let undispatched = 0;\n    let persistenceFailure: string | undefined;\n\n    const markInterrupted = (phase: InterruptionRecord[\"phase\"], extra: Partial<InterruptionRecord> = {}) => {\n      interruption = {\n        requestedAt: turn.cancelRequestedAt || new Date().toISOString(),\n        phase,\n        undispatchedToolCalls: undispatched,\n        ...extra,\n      };\n    };\n    const cancelledToolMessage = (call: ToolCall) => ({\n      role: \"tool\" as const,\n      tool_call_id: call.id,\n      name: call.function.name,\n      content: \"Cancelled by operator before execution. No action was taken.\",\n    });\n\n    // Continuation: `maxSteps` is a segment, a durable checkpoint. The total-step budget is objective-scoped and\n    // survives resumes; the active invocation also has a finite wall-clock limit. Without continuation\n    // (`--no-continuation`), the first segment boundary ends the turn (LIMIT_REACHED, legacy).\n    const turnDeadline = budget && Number.isFinite(budget.maxTurnMinutes) ? Date.now() + budget.maxTurnMinutes * 60_000 : Number.POSITIVE_INFINITY;\n    let stopReason: TurnReason | undefined;\n    let stopDetail: string | undefined;\n    let completionNudges = 0;\n    // Recovery state (notes, stage, refusals) lives in the tracker: in the ledger when durable, so compaction cannot\n    // remove it and resume restores it.\n    const allowedDenials = budget ? Math.max(1, budget.maxRecoveries) : 0;\n    this.stateIdentityDisabled = false;\n    this.stateIdentityUncertainty = undefined;\n    tracker.beginTurn();\n    if (continuingObjective) {\n      const isHarnessResume = typeof taskPrompt === \"string\" && /^\\[(?:Nexus|Work unit resumed)/.test(taskPrompt);\n      if (!isHarnessResume && !options?.resume && !isStep) {\n        tracker.operatorInput(tracker.data.cumulativeSteps, `operator follow-up: ${promptText.slice(0, 160)}`);\n      }\n    }\n    let stateNow = this.workspaceStateIdentity();\n    this.turnStartState = stateNow;\n    tracker.noteState(stateNow);\n    tracker.noteLedgerState(this.ledgerProgressIdentity());\n    const noticedPolls = new Set<string>();\n    const noticedThrash = new Set<string>();\n    let stateUnknownNoted = false;\n    const callRing: CallRecord[] = [];\n    let repeatedCallNote: string | undefined;\n    let loopedCall: { name: string; count: number; arguments: string; history: NonNullable<TurnResult[\"repeatedCall\"]>[\"history\"] } | undefined;\n\n    while (modelStop === \"NONE\" && !interruption && !inferenceFailure && !persistenceFailure) {\n      const convergence = this.turnConvergence as TurnResult[\"convergence\"];\n      if (convergence && !stopReason) {\n        stopReason = \"VERIFIER_NOT_CONVERGING\";\n        stopDetail = convergence.evidence;\n        if (this.objective && this.turnConvergenceUpTo !== undefined) this.objective.convergenceResetAfter = this.turnConvergenceUpTo;\n      }\n      if (stopReason) break;\n      const taskStepLimitReached = budget\n        ? tracker.data.cumulativeSteps >= maxTotalSteps\n        : currentStep > maxTotalSteps;\n      if (taskStepLimitReached) {\n        stopReason = budget ? \"STEP_BUDGET_EXHAUSTED\" : \"STEP_LIMIT_REACHED\";\n        stopDetail = budget\n          ? `objective step limit ${maxTotalSteps} reached (${tracker.data.cumulativeSteps} steps consumed across runs)`\n          : `--no-continuation: ${segmentSteps} steps`;\n        break;\n      }\n      if (Date.now() > turnDeadline) {\n        stopReason = \"TIME_BUDGET_EXHAUSTED\";\n        stopDetail = `operator time limit ${budget!.maxTurnMinutes} min`;\n        break;\n      }\n      if (budget && tracker.data.stepsWithoutProgress >= budget.stagnationSteps) {\n        stopReason = \"STAGNATION_DETECTED\";\n        const loops = tracker.loops().slice(0, 2).map((r) => `${r.action} ×${r.count}`).join(\"; \");\n        const thrash = tracker.reacquisitions().filter((r) => (r.reacquired ?? 0) >= 2).slice(0, 2).map((r) => `${r.action} re-read ×${r.reacquired} after compaction`).join(\"; \");\n        stopDetail = `${tracker.data.stepsWithoutProgress} consecutive steps without progress${loops ? ` (repeated: ${loops})` : \"\"}${thrash ? ` (context thrash: ${thrash})` : \"\"}${this.stateIdentityUncertainty ? `; ${this.stateIdentityUncertainty}` : \"\"}`;\n        tracker.stagnation(tracker.data.cumulativeSteps, \"no_progress\", stopDetail);\n        break;\n      }\n      if (signal.aborted) {\n        markInterrupted(\"between_steps\");\n        break;\n      }\n      // --step: one model/tool cycle per turn. Every path that continues the loop ends its cycle with endStep (recovery\n      // note delivered, progress evaluated) and comes back here, so this one boundary covers the sequential, parallel-read\n      // and notice paths alike; a stop set by the cycle or by the checks above (STAGNATION_DETECTED, a budget, a cancel)\n      // is reported instead. currentStep advances only in endStep, so it is past 1 once this turn finished a cycle.\n      if (isStep && currentStep > 1) {\n        stopReason = \"STEP_PAUSED\";\n        stopDetail = \"paused after one model/tool cycle (--step)\";\n        break;\n      }\n      // Operator /compact queued during the previous step runs here: its inference and tool batch have settled.\n      // False when a compaction that is not durable ends the turn.\n      const drainQueuedCompactions = async (): Promise<boolean> => {\n        // A `/compact --llm` stays queued while a resumed window covers the provider it calls (see drainCompactionQueue).\n  outcomeUnknown?: boolean;\n  /** Why the call was refused before it ran (a stable code, e.g. VERIFICATION_CONFIG_PROTECTED). */\n  denialReason?: string;\n}\n\n/**\n * Bounds for automatically continued work. The total-step limit is cumulative across every invocation that continues\n * the same durable objective; the wall-clock limit bounds one active invocation. Progress detection remains a separate\n * early-stop mechanism, not a substitute for these hard ceilings.\n */\nexport interface ContinuationBudget {\n  /** Maximum steps for one objective across runs and resumes (STEP_BUDGET_EXHAUSTED). */\n  maxTotalSteps: number;\n  /** Maximum wall-clock minutes for one invocation (TIME_BUDGET_EXHAUSTED). */\n  maxTurnMinutes: number;\n  /**\n   * Consecutive steps without observed progress before the turn stops (STAGNATION_DETECTED). A repeated-state\n   * threshold, not a task length: any progressing step resets it (core/execution_tracking.ts defines progress).\n   */\n  stagnationSteps: number;\n  /** Recovery notes the agent may inject for a repeated identical action before stopping (bounded recovery). */\n  maxRecoveries: number;\n  /** Times the agent may be asked to continue when it stops with acceptance requirements still open. */\n  maxCompletionNudges: number;\n  /**\n   * Consecutive failed verifier attempts on changing candidates that stop the turn as VERIFIER_NOT_CONVERGING when they\n   * show the same failure, an A/B alternation or a rising failing-test count (default 3, NEXUS_VERIFIER_CONVERGENCE_ATTEMPTS).\n   */\n  verifierConvergenceAttempts?: number;\n}\n\n/** Hard upper bounds keep an operator override finite even when a config or direct API caller bypasses CLI parsing. */\nexport const MAX_CONTINUATION_STEPS = 5_000;\nexport const MAX_CONTINUATION_MINUTES = 4_320;\n\nexport function assertValidContinuationBudget(budget: ContinuationBudget | undefined): void {\n  if (!budget) return;\n  if (!Number.isSafeInteger(budget.maxTotalSteps) || budget.maxTotalSteps < 1 || budget.maxTotalSteps > MAX_CONTINUATION_STEPS) {\n    throw new Error(`Invalid continuation step budget: expected an integer from 1 to ${MAX_CONTINUATION_STEPS}.`);\n  }\n  if (!Number.isFinite(budget.maxTurnMinutes) || budget.maxTurnMinutes < 1 / 60 || budget.maxTurnMinutes > MAX_CONTINUATION_MINUTES) {\n    throw new Error(`Invalid continuation time budget: expected a finite value from 1 second to ${MAX_CONTINUATION_MINUTES} minutes.`);\n  }\n}\n\n/** Failed verifier attempts on changing candidates that show no convergence before the turn stops (see ContinuationBudget). */\nexport const DEFAULT_CONVERGENCE_ATTEMPTS = 3;\n\nexport const DEFAULT_CONTINUATION: ContinuationBudget = {\n  maxTotalSteps: 500,\n  maxTurnMinutes: 480,\n  stagnationSteps: 12,\n  maxRecoveries: 2,\n  maxCompletionNudges: 2,\n};\n\nexport type ApprovalMode = \"auto\" | \"review\" | \"read-only\";\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","create_time":1795300774.7215748}},"metadata":{"history_sequence":16401,"sampled_through_sequence":16398,"client_authored":false,"fallback_token_limit_override":12000}}
