ROPIC_THINKING_BUDGET);\n  const anthropicThinkingBudget = Number.isFinite(thinkingRaw) && thinkingRaw >= 1024 ? Math.floor(thinkingRaw) : undefined;\n  const tdd = Boolean(options.tdd);\n  const verifierTimeoutRaw = Number(effectiveSetting(\"NEXUS_VERIFIER_TIMEOUT_SECS\"));\n  const verifierTimeoutSecs = Number.isFinite(verifierTimeoutRaw) && verifierTimeoutRaw > 0 ? verifierTimeoutRaw : undefined;\n  const taskClass = effectiveSetting(\"NEXUS_TASK_CLASS\") || effectiveSetting(\"LOCAL_LLM_TASK_CLASS\") || undefined;\n  const plannerTaskClass = effectiveSetting(\"PLANNER_TASK_CLASS\") || undefined;\n  return {\n    taskClass,\n    plannerTaskClass,\n    endpoint,\n    model,\n    apiKey,\n    ...(credentialOrigin ? { credentialOrigin } : {}),\n    workspace,\n    maxSteps,\n    ...(continuation ? { continuation } : {}),\n    repeatedCalls: { soft: repeatedCalls.soft, hard: repeatedCalls.hard },\n    temperature,\n    shell,\n    dryRun,\n    readOnly,\n    approvalMode,\n    yes,\n    fullAccess,\n    sandbox,\n    fallbackEndpoints,\n    contextLimit,\n    ...(strictTokenCount ? { strictTokenCount } : {}),\n    worktree,\n    ...(worktreeBranch ? { worktreeBranch } : {}),\n    authoritativeVerifierCommand,\n    trustedDeliverableFiles,\n    verifierTimeoutSecs,\n    recordFlight,\n    plannerModel,\n    plannerEndpoint,\n    coderModel,\n    coderEndpoint,\n    tdd,\n    ...(provider ? { provider } : {}),\n    ...(plannerProvider ? { plannerProvider, plannerApiKey } : {}),\n    ...(coderProvider ? { coderProvider, coderApiKey } : {}),\n    authorizedDisclosureOrigins: [...authorized],\n    ...(cloudRoutedOrigins.length ? { cloudRoutedOrigins } : {}),\n    ...(reasoningEffort ? { reasoningEffort } : {}),\n    ...(anthropicThinkingBudget ? { anthropicThinkingBudget } : {}),\n    ...(operationPolicy ? { operationPolicy } : {}),\n    ...(options.step ? { step: true } : {}),\n  };\n}\n\n/**\n * Durable operation scheduling defaults are operator policy, so read them only through operatorSetting; a project\n * `.env` cannot silently change how long an operation waits or how often Nexus retries work.\n */\nexport function configuredOperationPolicy(setting: (key: string) => string | undefined = operatorSetting): HarnessConfig[\"operationPolicy\"] {\n  if (operatorJsonOperationPolicyError) throw operatorJsonOperationPolicyError;\n411:export function buildConfig(options: any): HarnessConfig {\n433:  const continuation = continuationBudget(options);\n747:  if (options.continuation === false || effectiveSetting(\"NEXUS_CONTINUATION\") === \"0\") return undefined;\n","exit_code":0,"duration":{"secs":0,"nanos":752570891}},"started_at_ms":1795301212798,"completed_at_ms":1795301213551}}
