{"timestamp":"2026-11-02T21:45:45.608Z","ordinal":47467,"type":"token_usage_record","payload":{"thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","session_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","root_turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","response_id":"resp_0fd4138577b17921016ae90486262881a3b43ce553f7b6db27","usage":{"input_tokens":124586,"cached_input_tokens":120448,"cache_write_input_tokens":0,"output_tokens":417,"reasoning_output_tokens":289,"total_tokens":125003},"turn_token_usage":{"input_tokens":52052559,"cached_input_tokens":51404800,"cache_write_input_tokens":0,"output_tokens":90042,"reasoning_output_tokens":43154,"total_tokens":52142601},"thread_token_usage":{"input_tokens":914464288,"cached_input_tokens":906567424,"cache_write_input_tokens":0,"output_tokens":1906230,"reasoning_output_tokens":968325,"total_tokens":916370518}}}
