n import { startGateway, makeRepo, Reply } from \"./helpers/fixtures.js\";\n import { createLedger, seedRequirements, applyRequirementUpdates, isNewObjective, failedCheckFrom, renderPinnedLedger, acceptDescoping, requirementDone, readObjective, invalidateVerified, queueSteering, amendObjective, trackingOf } from \"../src/core/objective.js\";\n import { stableToolCallId, redactTaskStateForPersistence } from \"../src/core/persistence_protection.js\";\n@@ -53,15 +54,75 @@ describe(\"continuation beyond the per-segment step limit\", () => {\n   test(\"automatic continuation has finite default step and invocation time ceilings\", () => {\n     assert.equal(DEFAULT_CONTINUATION.maxTotalSteps, 500);\n     assert.equal(DEFAULT_CONTINUATION.maxTurnMinutes, 480);\n+    assert.equal(DEFAULT_CONTINUATION.maxToolInvocations, DEFAULT_MAX_TOOL_INVOCATIONS);\n     assert.ok(Number.isFinite(DEFAULT_CONTINUATION.maxTotalSteps));\n     assert.ok(Number.isFinite(DEFAULT_CONTINUATION.maxTurnMinutes));\n   });\n \n+  test(\"tool invocation ceilings have finite defaults, accept operator overrides, and stay hard bounded\", () => {\n+    const saved = process.env.NEXUS_MAX_TOOL_INVOCATIONS;\n+    delete process.env.NEXUS_MAX_TOOL_INVOCATIONS;\n+    try {\n+      assert.equal(toolInvocationLimit({}), DEFAULT_MAX_TOOL_INVOCATIONS);\n+      assert.equal(toolInvocationLimit({ maxToolInvocations: \"12\" }), 12);\n+      assert.equal(continuationBudget({ maxToolInvocations: \"8\" })!.maxToolInvocations, 8);\n+      assert.throws(() => toolInvocationLimit({ maxToolInvocations: String(MAX_TOOL_INVOCATIONS + 1) }), /maximum is 10000/);\n+      assert.throws(() => toolInvocationLimit({ maxToolInvocations: \"1.5\" }), /positive integer/);\n+    } finally {\n+      if (saved !== undefined) process.env.NEXUS_MAX_TOOL_INVOCATIONS = saved;\n+    }\n+  });\n+\n+  test(\"a burst of distinct writes stops at the objective tool budget and resume cannot raise it\", { timeout: 60_000 }, async () => {\n+    let request = 0;\n+    const gw = await startGateway(() => {\n+      request++;\n+      if (request === 1) {\n+        return {\n+          kind: \"tools\",\n+          calls: Array.from({ length: 5 }, (_, i) => ({\n+            name: \"write_file\",\n+            args: { path: `budget-${i + 1}.txt`, content: `write ${i + 1}` },\n+          })),\n+        };\n+      }\n+      return write(\"budget-after-resume.txt\");\n+    });\n+    const repo = makeRepo();\n+    const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, {\n+      continuation: undefined,\n+      maxToolInvocations: 2,\n+    })));\n+    try {\n+      const first = await agent.runTurn(\"Write several distinct files.\");\n+      assert.equal(first.execution, \"LIMIT_REACHED\");\n+      assert.equal(first.reason, \"TOOL_INVOCATION_BUDGET_EXHAUSTED\");\n+      assert.match(first.detail ?? \"\", /2\\/2 dispatcher admissions/);\n+      assert.deepEqual(fs.readdirSync(repo).filter((name) => name.startsWith(\"budget-\")).sort(), [\"budget-1.txt\", \"budget-2.txt\"]);\n+      assert.equal(agent.getObjective()!.execution!.toolInvocations, 2);\n+      assert.equal(agent.getObjective()!.continuation.maxToolInvocations, 2);\n+\n+      (agent as any).config.maxToolInvocations = 5;\n+      const resumed = await agent.runTurn(\"\", undefined, { resume: true });\n+      assert.equal(resumed.execution, \"LIMIT_REACHED\");\n+      assert.equal(resumed.reason, \"TOOL_INVOCATION_BUDGET_EXHAUSTED\");\n+      assert.equal(gw.requests.length, 2, \"resume may inspect state but cannot dispatch beyond the persisted ceiling\");\n+      assert.deepEqual(fs.readdirSync(repo).filter((name) => name.startsWith(\"budget-\")).sort(), [\"budget-1.txt\", \"budget-2.txt\"]);\n+      assert.equal(agent.getObjective()!.execution!.toolInvocations, 2);\n+      assert.equal(agent.getObjective()!.continuation.maxToolInvocations, 2, \"a later flag cannot renew an exhausted objective\");\n+    } finally {\n+      agent.shutdown();\n+      await gw.close();\n+      fs.rmSync(repo, { recursive: true, force: true });\n+    }\n+  });\n+\n   test(\"legacy objective continuation counts are not reset when the execution tracker is missing or stale\", () => {\n     const ledger = createLedger(\"Continue the existing task.\");\n     ledger.continuation.totalSteps = 17;\n     delete ledger.execution;\n     assert.equal(trackingOf(ledger).data.cumulativeSteps, 17);\n+    assert.equal(trackingOf(ledger).data.toolInvocationHistoryComplete, false);\n \n     ledger.execution!.cumulativeSteps = 9;\n     assert.equal(trackingOf(ledger).data.cumulativeSteps, 17);\ndiff --git a/docs/USER_MANUAL.md b/docs/USER_MANUAL.md\nindex 532eab3d..acda1261 100644\n--- a/docs/USER_MANUAL.md\n+++ b/docs/USER_MANUAL.md\n@@ -364,6 +364,14 @@ A single model response may request at most 16 tool calls. A larger batch is rej\n run, and Nexus reports the rejection in the next model context. This bounds tool fan-out from one response; it does\n not replace the objective-wide step budget.\n \n+The objective also has a durable tool-dispatch ceiling: 1,000 calls by default, configurable with\n+`--max-tool-invocations` or `NEXUS_MAX_TOOL_INVOCATIONS` up to 10,000. It applies even when automatic continuation is\n+disabled. The first run saves its ceiling with the objective; later runs may lower it but cannot raise or renew it.\n+Older objectives without a complete dispatch history retain an explicitly incomplete count, so the displayed total is\n+a lower bound rather than an observed zero. This ceiling currently covers direct agent turns; delegated child loops\n+are not yet charged to the same counter. Exhaustion stops the objective as `LIMIT_REACHED` and cannot establish\n+successful completion.\n+\n A second, independent brake watches the verifier itself: when `task_completed` fails the same verifier\n `NEXUS_VERIFIER_CONVERGENCE_ATTEMPTS` times in a row (default 3; a check-only failure with no test names needs one\n more) with the same failing tests across changed workspace states, with the failure alternating between two sets\ndiff --git a/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md b/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md\nindex cfaf735d..6087f1a2 100644\n--- a/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md\n+++ b/docs/assurance/POWER_OF_TEN_IMPLEMENTATION_PLAN.md\n@@ -34,7 +34,7 @@ Reuse `ContinuationBudget`, `ExecutionTracker`, `ProviderRecoveryController`, `R\n \n **Priority:** P0 · **Complexity:** L · **Dependencies:** WP-P10-01 recommended first; can be implemented independently.\n \n-**Gap/evidence:** `DEFAULT_CONTINUATION` sets total steps and minutes to Infinity (`cli/src/types.ts:182-188`); `runTurnImpl` checks a local `currentStep` (`run_turn.ts:137-145,220-267`); `runSubagent` uses an unbounded `for (;;)` (`agent.ts:4440-4457`); resumed invocation recreates local counters while cumulative steps are observational only (`turn.ts:348-359`).\n+**Gap/evidence:** Direct objective continuation already has finite total-step and per-invocation time ceilings (`cli/src/types.ts`, `cli/src/core/run_turn.ts`), but tool dispatches were not capped cumulatively. `runSubagent` uses its own loop (`cli/src/agent.ts`) and is not yet covered by the direct-turn tracker. Cumulative elapsed time, inference submissions, provider retries and tokens are also not tracked as one durable task budget.\n \n **Affected surfaces:** `types.ts`, `config.ts`, `run_turn.ts`, subagent execution in `agent.ts`, provider recovery, tool deadlines, durable objective/task state, operation runner and CLI/UI reporting.\n \n@@ -52,6 +52,8 @@ Reuse `ContinuationBudget`, `ExecutionTracker`, `ProviderRecoveryController`, `R\n \n **Migration / rollback:** New config defaults may shorten formerly unlimited runs; provide an explicit operator override with a hard documented maximum, not Infinity. Keep old records readable. Rollback must not turn persisted exhausted state into zero; older binaries should refuse unsupported budget schema versions. Residual risk: already-running external calls may finish after cancellation or have unknown outcomes.\n \n+**Progress (2026-11-21):** The direct `runTurnImpl` path now persists a per-objective tool invocation ceiling (default 1,000; hard maximum 10,000), admits calls before dispatch, and checkpoints the count before dispatcher effects. A saved ceiling cannot be raised by a later invocation. Legacy execution records explicitly mark tool history incomplete, so migrated counts are not presented as exact. Targeted tests cover bounded distinct writes, resume without budget renewal, admission bounds and legacy lower-bound tracking. Remaining P10-02 work includes sharing the tracker with `runSubagent`, provider recovery, inference/token accounting, cumulative elapsed limits, per-tool deadlines, process-crash reconciliation, and persistence-failure fault injection.\n+\n ## WP-P10-03 — Acceptance evidence integrity and export\n \n **Priority:** P1 · **Complexity:** M · **Dependencies:** WP-P10-01 for independent policy identity.\n\nWarning: truncated output (original token count: 3897)\nTotal output lines: 156\n\n# Running multiple agents on this plan without collisions\n\nThese rules apply to every agent (Claude Code, Codex, Cursor, Nexus itself, or a human) that implements any part of this package at the same time as another. The repository's root `AGENTS.md` points here. The rules come from incidents recorded in `tasks/lessons.md`:\n\n- a concurrent agent overwrote newer evidence;\n- full test suites were contaminated by edits made mid-run;\n- `pkill -f` killed the agent's own shell;\n- HEAD moved during a pause.\n\nThey also follow from audit finding PER-03: the test suite writes into the real `~/.nexus`.\n\n## 1. Unit of work: one claimed PR slice per agent\n\n- The unit of concurrent work is **one PR slice** from a plan, for example `PLAN-01/PR-1a`. Every slice lists its tasks and its safe change boundary in its plan.\n- An agent works on exactly one claimed slice at a time.\n- An agent must not edit files outside its slice's boundary. The exceptions are the ledger rows and the shared files covered by §4. If the work needs a file outside the boundary, the agent stops and records a **boundary request** (§6). It does not edit the file.\n\n## 2. Claiming a slice (atomic and machine-local)\n\nClaims live in the repository's shared git directory. They are visible to every worktree, and they are never committed.\n\n```sh\nCLAIMS=\"$(git rev-parse --git-common-dir)/nexus-claims\"\nmkdir -p \"$CLAIMS\"\nSLICE=\"PLAN-01_PR-1a\"\nif mkdir \"$CLAIMS/$SLICE\" 2>/dev/null; then          # mkdir is atomic: exactly one agent wins\n  printf '{\"agent\":\"%s\",\"branch\":\"%s\",\"since\":\"%s\",\"pid\":%s}\\n' \\\n    \"$AGENT_NAME\" \"v1/plan-01-pr-1a\" \"$(date -u +%FT%TZ)\" \"$$\" > \"$CLAIMS/$SLICE/owner.json\"\nelse\n  echo \"claimed by: $(cat \"$CLAIMS/$SLICE/owner.json\")\"; exit 1\nfi\n```\n\n- **Release** the claim by deleting its directory (`rm -r \"$CLAIMS/$SLICE\"`) after the slice merges or is abandoned. Write one line about the outcome to `$CLAIMS/../nexus-claims.log`.\n- **Hot-file claims** use the same mechanism with the name `FILE_<path with / replaced by _>`, for example `FILE_cli_src_agent.ts`. See §4.\n- **Stale claims.** A claim older than 24 h whose PID is gone may be broken, but only by the owner, or by an agent that first records the broken claim in the log.\n- If the MCP Agent Mail server is available, its file reservations (`file_reservation_paths`) may be used as well. The git-common-dir claim stays authoritative, because every agent can see it without extra tooling.\n\n## 3. Isolation: worktree, branch, HOME, ports, processes\n\n| Resource | Rule |\n|---|---|\n| Source | One `git worktree` per claimed slice: `git worktree add ../nexus-wt/<slice> -b v1/<plan>-<slice> origin/main`. Never edit `~/nexus-code` itself. It is the owner's checkout, and `/usr/local/bin/nexus` runs from it. |\n| Branch | `v1/plan-NN-pr-Nx`. One branch per slice. Never commit to `main` directly. |\n| HOME and state | Until PLAN-08 PR-8a lands, every test, build and probe run sets `HOME=$(mktemp -d)` and `XDG_CONFIG_HOME=\"$HOME/.config\"`. After PR-8a, the test setup enforces this, but scripts and probes outside `npm test` must still set it. **Never** run anything that writes to the real `~/.nexus` or `~/.config/nexus`. |\n| Test runs | Full suites run on a **snapshot copy** of the worktree (`git worktree add` at the commit under test, or `git archive`), never on the tree being edited. `tsx` reads `src/` live. |\n| Builds | Each worktree builds into its own `core/target`, and `cli/dist` is per worktree. To share the Rust build cache, set `CARGO_TARGET_DIR` per worktree, never to one shared directory. |\n| Ports | Mock servers bind `127.0.0.1:0` (an ephemeral port) and publish the chosen port to a file. Fixed ports are forbidden. |\n| Processes | Kill only PIDs you started, taken from `$!` or `ps -eo pid,args \\| grep -v grep`. **Never `pkill -f` or `killall`.** Long background jobs are stopped through the agent's own task controls. |\n| Full test suites | The PTY and provider tests are timing-sensitive. Take the claim `SUITE` before running a full suite (`make test`, or `npm test` over all files). While anyone holds `SUITE`, nobody runs other suites or targeted test files on the same machine. Concurrent load caused a false failure on 2026-10-15: `cloud_providers` saw an extra provider request after a load-induced timeout. Release the claim when the run ends. |\n| Inference | There is one inference host (DEC-16). Any run that uses the gateway takes the claim `GATEWAY` first. That includes eval runs, live checks and stripped-proxy runs. One gateway run at a time, which keeps eval timings valid and prevents overload. Small cloud checks (E5) take `CLOUD` to avoid duplicate spend. |\n| Credentials | Agents never read or copy `~/.config/nexus/credentials.json`, `config.env` values, or gateway tokens. The stripped proxy reads the token file itself. |\n\n## 4. Hot files: serialise, do not merge blindly\n\nThese files are touched by several plans. An agent editing one must hold its `FILE_` claim for the **shortest** period: edit…1397 tokens truncated…lows, scripts). (b) PLAN-06 PR-6b after PLAN-01 PR-1b (shares `index.ts` flags). |\n| M3 | (a) PLAN-04 (`agent.ts` turn, operation runner). (b) PLAN-05 (`client.ts`, provider modules). (c) PLAN-10 harness (`eval/`, no product files). (d) Held-out task authoring by the agent author, **outside the repository**: no access to Nexus source or the development set (DEC-05). |\n| M4 (alongside M3) | PLAN-08 PR-8b..8e. Coordinate with PLAN-04 on `state.ts` through `FILE_` claims. |\n| M5 | **Serial on `GATEWAY`.** The eval runner, the stripped-proxy runs and the independent reviewer's live task each take the `GATEWAY` claim. The terminal matrix (E3) and the install matrix (E2) can run in parallel with gateway runs. |\n\n## 8. Independence constraints\n\n- The held-out task author must not see Nexus source, the development tasks or tuning history. It runs in a separate session with only the task schema and external repositories. Its output is sealed by a sha256 manifest committed before RC1.\n- The independent reviewer in ACCEPTANCE §8 must not be the agent or session that implemented the slices under review.\n- An implementing agent never edits `eval/heldout-manifest.json`, scorer thresholds or ACCEPTANCE §6.4 after the freeze.\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261109T195144Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261109T195144Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T022126Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T022126Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261119-rd7\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261119-rd7/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T005132Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T005132Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T060116Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T060116Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261120T081416Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261120T081416Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T063752Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T063752Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md/owner.json\n/home/mike/nexus-code/.git/nexus-claims/archived.released-20261105T142659Z/FILE_docs_USER_MANUAL.md-codex-root-pr299-docs-complete-20261028T1146Z.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_assurance_POWER_OF_TEN_IMPLEMENTATION_PLAN.md\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_assurance_POWER_OF_TEN_IMPLEMENTATION_PLAN.md/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T070402Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T070402Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261109T194217Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261109T194217Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261115T224557Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261115T224557Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T063339Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T063339Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261115T215303Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261115T215303Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T055233Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T055233Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T023630Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T023630Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T072250Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T072250Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T075448Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T075448Z/owner.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T032842Z\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_USER_MANUAL.md.released-20261110T032842Z/owner.json\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","create_time":1795301989.1617105}},"metadata":{"history_sequence":16755,"sampled_through_sequence":16751,"client_authored":false,"fallback_token_limit_override":12000}}
