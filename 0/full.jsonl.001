by de\",\"mcp__mcp_agent_mail__register_agent :: You are the MCP Agent Mail coordination server. Provide message routing, coordination tooling, and project context to cooperating agents. Outputs are JSON by de\",\"mcp__mcp_agent_mail__reply_message :: You are the MCP Agent Mail coordination server. Provide message routing, coordination tooling, and project context to cooperating agents. Outputs are JSON by de\",\"mcp__mcp_agent_mail__retire_agent :: You are the MCP Agent Mail coordination server. Provide message routing, coordination tooling, and project context to cooperating agents. Outputs are JSON by de\",\"mcp__mcp_agent_mail__search_messages :: You are the MCP Agent Mail coordination server. Provide message routing, coordination tooling, and project context to cooperating agents. Outputs are JSON by de\",\"mcp__mcp_agent_mail__send_message :: You are the MCP Agent Mail coordination server. Provide message routing, coordination tooling, and project context to cooperating agents. Outputs are JSON by de\",\"mcp__mcp_agent_mail__sweep_stale_agents :: You are the MCP Agent Mail coordination server. Provide message routing, coordination tooling, and project context to cooperating agents. Outputs are JSON by de\",\"mcp__mcp_agent_mail__unretire_agent :: You are the MCP Agent Mail coordination server. Provide message routing, coordination tooling, and project context to cooperating agents. Outputs are JSON by de\"]"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1831e-47db-7583-982e-1aab45c43e6a","create_time":1793201405.745158}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
