{"timestamp":"2026-11-02T08:26:17.400Z","ordinal":35177,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19b3e-e325-7090-bf1f-c31aa606240e","item":{"type":"CommandExecution","id":"exec-e9557e67-adae-4e80-b22f-65f983872bc9","process_id":"70792","command":["/usr/bin/zsh","-lc","sed -n '45,105p' eval/score.mjs; sed -n '145,220p' eval/run.mjs; sed -n '115,160p' eval/package_runtime.test.mjs"],"cwd":"file:///home/mike/nexus-wt/v112-wp1104-integration","parsed_cmd":[{"type":"read","cmd":"sed -n '45,105p' eval/score.mjs","name":"score.mjs","path":"eval/score.mjs"},{"type":"read","cmd":"sed -n '145,220p' eval/run.mjs","name":"run.mjs","path":"eval/run.mjs"},{"type":"read","cmd":"sed -n '115,160p' eval/package_runtime.test.mjs","name":"package_runtime.test.mjs","path":"eval/package_runtime.test.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"const records = [...byRun.values()];\n/** A run that ended without a result of its own: Nexus without a turn report, or any agent killed by a signal. */\nconst crashed = (r) => !r.error && !r.timedOut && (r.exitCode === null || ((r.agent ?? \"nexus\") === \"nexus\" && !r.turn));\n\n/** 95 % Wilson score interval for k successes out of n. */\nexport function wilson(k, n) {\n  if (!n) return [0, 0];\n  const z = 1.96;\n  const p = k / n;\n  const denom = 1 + (z * z) / n;\n  const centre = (p + (z * z) / (2 * n)) / denom;\n  const half = (z * Math.sqrt((p * (1 - p)) / n + (z * z) / (4 * n * n))) / denom;\n  return [Math.max(0, centre - half), Math.min(1, centre + half)];\n}\n\nconst median = (xs) => {\n  const s = xs.filter((x) => typeof x === \"number\").sort((a, b) => a - b);\n  return s.length ? (s.length % 2 ? s[(s.length - 1) / 2] : (s[s.length / 2 - 1] + s[s.length / 2]) / 2) : null;\n};\n\nconst groups = new Map();\nfor (const r of records) {\n  const key = `${r.config}\\t${r.task}`;\n  if (!groups.has(key)) groups.set(key, []);\n  groups.get(key).push(r);\n}\n\nconst rows = [...groups.entries()].map(([key, rs]) => {\n  const [config, task] = key.split(\"\\t\");\n  const n = rs.length;\n  const count = (f) => rs.filter(f).length;\n  const correct = count((r) => r.hiddenPass);\n  return {\n    config,\n    task,\n    tier: rs[0].tier,\n    n,\n    claimed: count((r) => r.claimedComplete),\n    correct,\n    correctCI: wilson(correct, n),\n    falseVerified: count((r) => r.falseVerified),\n    regressions: count((r) => r.regressionPass === false),\n    errors: count((r) => r.error),\n    contaminated: count((r) => r.contaminated),\n    timedOut: count((r) => r.timedOut),\n    medianWallS: median(rs.map((r) => r.wallMs / 1000)),\n    medianSteps: median(rs.map((r) => r.turn?.steps?.used)),\n    medianTokens: median(rs.map((r) => r.tokens?.total)),\n  };\n});\n\nconst totals = {\n  runs: records.length,\n  falseVerified: records.filter((r) => r.falseVerified).length,\n  errors: records.filter((r) => r.error).length,\n  crashed: records.filter(crashed).length,\n  contaminated: records.filter((r) => r.contaminated).length,\n  replacedByRerun: replaced,\n};\n\n// Pooled rates leave contaminated runs out (the agent could have seen the hidden tests); they are counted separately.\nconst agentIdentity = problems.length ? { record: null, problem: null } : await resolveAgentIdentity(config);\nif (agentIdentity.problem) problems.push(agentIdentity.problem);\nlet fingerprint = null;\nif (!problems.length) {\n  const probe = config.proxy === false ? null : await startModelProxy({ upstream: config.endpoint, caFile });\n  try {\n    const entry = await fetchModelEntry(probe?.url ?? config.endpoint, config.model, apiKey);\n    const fp = modelFingerprint(config, entry);\n    fingerprint = fp.fingerprint;\n    problems.push(...fp.missing.map((m) => `model fingerprint: ${m}`));\n    if (config.qualification === true && (config.agent ?? \"nexus\") === \"nexus\") {\n      const limitsProblem = nexusLimitsProblem(config, entry);\n      if (limitsProblem) problems.push(limitsProblem);\n    }\n  } finally {\n    await probe?.close();\n  }\n}\nif (problems.length) {\n  console.error(`eval/run.mjs: not starting; ${problems.length} problem(s):\\n${problems.map((p) => `  - ${p}`).join(\"\\n\")}`);\n  process.exit(2);\n}\nconst resultsFile = path.join(args.out, \"results.jsonl\");\n// The scorer consumes this file even when the selected dataset split is empty.\nfs.writeFileSync(resultsFile, \"\", { flag: \"wx\" });\nconst frozenTaskRows = taskRecords.map(({ id }) => corpusTaskRows(taskSnapshots, [id])[0]);\nfs.writeFileSync(path.join(args.out, \"manifest.json\"), JSON.stringify({\n  createdAt: new Date().toISOString(),\n  harness: identity,\n  config: redactConfig(config),\n  configSha256,\n  dataset: dataset ? { name: dataset.manifest.name, version: dataset.manifest.version, split: args.split ?? null, manifestSha256: dataset.manifestSha256, taskIds: tasks } : null,\n  qualificationCorpus: config.qualification === true ? { manifestSha256: config.corpusManifestSha256, tasks: frozenTaskRows } : null,\n  fingerprint,\n  agentVersion: agentIdentity.record,\n  budget: effectiveBudget({}, config),\n  runs,\n  tasks: frozenTaskRows,\n  host: os.hostname(),\n  node: process.version,\n}, null, 2) + \"\\n\");\n\n// Run-major order (every task once, then again): a pass cut short still has the same number of runs per task.\nfor (let run = 1; run <= runs; run++) {\n  for (const { id, dir, treeSha256, task: taskData, versionedDataset } of taskRecords) {\n    if (pairs && !pairs.some(([t, r]) => t === id && Number(r) === run)) continue;\n    assertTaskSnapshotDigest({ dir, treeSha256, id, versionedDataset });\n    const task = { ...taskData, dir };\n    const record = await runOnce(task, run);\n    fs.appendFileSync(resultsFile, JSON.stringify(record) + \"\\n\");\n    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\n  }\n}\n\nasync function runOnce(task, run) {\n  // Under the resource contract these are on a tmpfs, so candidate writes count against the run's memory limit.\n  const scratch = config.resources?.workspaceRoot ?? os.tmpdir();\n  const ws = fs.mkdtempSync(path.join(scratch, `nexus-eval-${task.id}-`));\n  const checkDirs = [];\n  const home = fs.mkdtempSync(path.join(scratch, \"nexus-eval-home-\"));\n  const budget = effectiveBudget(task, config);\n  const base = { task: task.id, tier: task.tier, ...(task.tier === \"T3\" ? { t3SteeringItems: task.steering.length } : {}), config: config.name, agent: config.agent ?? \"nexus\", agentVersion: agentIdentity.record, budget, run, harness: identity.string, model: config.model, startedAt: new Date().toISOString() };\n  try {\n    await prepareWorkspace(task, ws);\n    // Taken now, while .git is the harness's own: after the agent runs, nothing executes git against its workspace.\n    const baselineTree = gitRev(ws, \"HEAD^{tree}\");\n    const t3Baseline = task.tier === \"T3\" ? steeringBaseline(task, ws) : null;\n    // On the per-run task copy, so the steering hook in runAgent can read it. The commands run on a throwaway copy of\n    // the staged workspace, so the agent starts on exactly the staged tree.\n    const t3BaselineResources = [];\n    if (task.tier === \"T3\") {\n      const probe = fs.mkdtempSync(path.join(scratch, `nexus-eval-t3-baseline-${task.id}-`));\n      try {\n        fs.cpSync(ws, probe, { recursive: true, verbatimSymlinks: true });\n        task.t3CommandBaseline = await commandBaseline(task, (command) => runIsolated(command, { cwd: probe, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => {\n          if (r.resources) t3BaselineResources.push(r.resources);\n    assert.equal(fs.statSync(path.join(outputDir, \"score.json\")).mode & 0o777, 0o600);\n  } finally {\n    fs.rmSync(outside, { recursive: true, force: true });\n  }\n});\n\ntest(\"installed package launches a non-empty candidate without mounting evaluator code\", { timeout: 120_000, skip: process.env.NEXUS_PACKAGE_ROOT ? false : \"set NEXUS_PACKAGE_ROOT to a freshly built package\" }, async () => {\n  const packageRoot = fs.realpathSync(process.env.NEXUS_PACKAGE_ROOT);\n  const sourceRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n  assert.equal(packageRoot === sourceRoot || packageRoot.startsWith(`${sourceRoot}${path.sep}`), false, \"package must be staged outside the source checkout\");\n  const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-installed-eval-candidate-\"));\n  const dataset = path.join(outside, \"dataset\");\n  fs.cpSync(path.join(sourceRoot, \"eval\", \"datasets\", \"core-v1\"), dataset, { recursive: true });\n  const requests = [];\n  const server = http.createServer((req, res) => {\n    if (req.method === \"GET\" && req.url?.endsWith(\"/models\")) {\n      res.writeHead(200, { \"content-type\": \"application/json\" });\n      res.end(JSON.stringify({ data: [{ id: \"package-smoke\" }] }));\n      return;\n    }\n    let raw = \"\";\n    req.on(\"data\", (chunk) => { raw += chunk; });\n    req.on(\"end\", () => {\n      const body = JSON.parse(raw);\n      requests.push(body);\n      res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n      const frame = (value) => `data: ${JSON.stringify(value)}\\n\\n`;\n      if (requests.length === 1) {\n        res.end(frame({ choices: [{ index: 0, delta: { tool_calls: [{ index: 0, id: \"write-math\", type: \"function\", function: { name: \"write_file\", arguments: JSON.stringify({ path: \"math.js\", content: \"exports.add = (a, b) => a + b;\\n\" }) } }] } }] }) + frame({ choices: [{ index: 0, delta: {}, finish_reason: \"tool_calls\" }] }) + \"data: [DONE]\\n\\n\");\n      } else {\n        res.end(frame({ choices: [{ index: 0, delta: { content: \"Implemented math.js.\" } }] }) + frame({ choices: [{ index: 0, delta: {}, finish_reason: \"stop\" }] }) + \"data: [DONE]\\n\\n\");\n      }\n    });\n  });\n  await new Promise((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const address = server.address();\n  assert.ok(address && typeof address === \"object\");\n  const launcher = path.join(packageRoot, \"bin\", \"nexus\");\n  const child = spawn(launcher, [\"eval\", \"--dataset\", dataset, \"--split\", \"regression\", \"--runs\", \"1\", \"--max-steps\", \"3\", \"--output\", path.join(outside, \"score.json\")], {\n    cwd: outside,\n    env: { PATH: process.env.PATH ?? \"/usr/bin:/bin\", HOME: outside, NEXUS_HOME: packageRoot, LOCAL_LLM_ENDPOINT: `http://127.0.0.1:${address.port}/v1`, LOCAL_LLM_MODEL: \"package-smoke\" },\n    stdio: [\"ignore\", \"pipe\", \"pipe\"],\n  });\n  let stdout = \"\";\n  let stderr = \"\";\n  child.stdout.setEncoding(\"utf8\").on(\"data\", (chunk) => { stdout += chunk; });\n","exit_code":0,"duration":{"secs":0,"nanos":865203207}},"started_at_ms":1793607976534,"completed_at_ms":1793607977400}}
