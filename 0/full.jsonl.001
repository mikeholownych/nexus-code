{"timestamp":"2026-10-28T13:49:23.682Z","ordinal":458460,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a182b5-7df6-71b2-a955-13339511caaf","item":{"type":"CommandExecution","id":"exec-761fc606-9b1a-4850-b6ab-aea131656fa2","process_id":"2243","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff --stat; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff -- cli/src/checkpoint.ts cli/test/checkpoint_restore.test.ts | head -180; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix status --porcelain=v1"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff --stat; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix diff -- cli/src/checkpoint.ts cli/test/checkpoint_restore.test.ts | head -180; git -C /home/mike/nexus-wt/checkpoint-ordinary-child-fix status --porcelain=v1"}],"source":"unified_exec_startup","status":"completed","aggregated_output":" cli/src/checkpoint.ts               |  7 ++++++-\n cli/test/checkpoint_restore.test.ts | 36 ++++++++++++++++++++++++++++++++++++\n 2 files changed, 42 insertions(+), 1 deletion(-)\ndiff --git a/cli/src/checkpoint.ts b/cli/src/checkpoint.ts\nindex 6d5d63b6..6d963bf8 100644\n--- a/cli/src/checkpoint.ts\n+++ b/cli/src/checkpoint.ts\n@@ -208,7 +208,12 @@ export class CheckpointManager {\n           throw new Error(\"Checkpoint destination parent is a symbolic link\");\n         }\n         if (!stat.isDirectory()) break;\n-        if (fs.lstatSync(path.join(parent, \".git\"), { throwIfNoEntry: false })) {\n+        const dotGit = fs.lstatSync(path.join(parent, \".git\"), { throwIfNoEntry: false });\n+        const bareHead = fs.statSync(path.join(parent, \"HEAD\"), { throwIfNoEntry: false });\n+        const bareConfig = fs.statSync(path.join(parent, \"config\"), { throwIfNoEntry: false });\n+        const bareObjects = fs.statSync(path.join(parent, \"objects\"), { throwIfNoEntry: false });\n+        const bareRefs = fs.statSync(path.join(parent, \"refs\"), { throwIfNoEntry: false });\n+        if (dotGit || (bareHead?.isFile() && bareConfig?.isFile() && bareObjects?.isDirectory() && bareRefs?.isDirectory())) {\n           throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n         }\n       }\ndiff --git a/cli/test/checkpoint_restore.test.ts b/cli/test/checkpoint_restore.test.ts\nindex cdf59b40..beddb4f5 100644\n--- a/cli/test/checkpoint_restore.test.ts\n+++ b/cli/test/checkpoint_restore.test.ts\n@@ -1038,6 +1038,42 @@ test(\"Git manifest restore refuses to copy an untracked file into a nested-repos\n   }\n });\n \n+test(\"Git manifest restore refuses to copy an untracked file into a nested bare repository\", () => {\n+  const { repo, git } = gitRepo();\n+  const bareRepo = path.join(repo, \"nested-bare\");\n+  try {\n+    fs.mkdirSync(bareRepo);\n+    fs.writeFileSync(path.join(bareRepo, \"captured.txt\"), \"checkpoint content\\n\");\n+    const manager = new CheckpointManager(repo);\n+    const checkpoint = manager.createCheckpoint(\"nested bare repository descendant\");\n+\n+    fs.rmSync(path.join(bareRepo, \"captured.txt\"));\n+    execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", bareRepo]);\n+    const bareHeadBefore = fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\");\n+    const bareConfigBefore = fs.readFileSync(path.join(bareRepo, \"config\"), \"utf8\");\n+    fs.writeFileSync(path.join(bareRepo, \"repository-canary.txt\"), \"bare repository canary\\n\");\n+    fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n+    git(\"add\", \"staged-after-checkpoint.txt\");\n+    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n+    const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n+\n+    const result = manager.restore(checkpoint.id);\n+\n+    assert.equal(result.success, false);\n+    assert.match(result.message, /destination|unsafe|snapshot/i);\n+    assert.equal(fs.readFileSync(path.join(bareRepo, \"HEAD\"), \"utf8\"), bareHeadBefore);\n+    assert.equal(fs.readFileSync(path.join(bareRepo, \"config\"), \"utf8\"), bareConfigBefore);\n+    assert.equal(fs.readFileSync(path.join(bareRepo, \"repository-canary.txt\"), \"utf8\"), \"bare repository canary\\n\");\n+    assert.equal(execFileSync(\"git\", [\"-C\", bareRepo, \"rev-parse\", \"--is-bare-repository\"], { encoding: \"utf8\" }).trim(), \"true\");\n+    assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n+    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n+    const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n+    assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve outer index entries\");\n+  } finally {\n+    cleanupGitRepo(repo);\n+  }\n+});\n+\n test(\"Git manifest restore refuses a tracked destination inside a nested repository before changing either index\", () => {\n   const { repo, git } = gitRepo();\n   const trackedParent = path.join(repo, \"a\");\n M cli/src/checkpoint.ts\n M cli/test/checkpoint_restore.test.ts\n","exit_code":0,"duration":{"secs":0,"nanos":26896}},"started_at_ms":1793195363682,"completed_at_ms":1793195363682}}
