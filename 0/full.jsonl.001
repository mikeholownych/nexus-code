les\", () => {\n    68\t  const { repo } = gitRepo();\n    69\t  try {\n    70\t    const tool = path.join(repo, \"tool.sh\");\n    71\t    fs.writeFileSync(tool, \"#!/bin/sh\\nexit 0\\n\", { mode: 0o751 });\n    72\t    fs.chmodSync(tool, 0o751);\n    73\t    const manager = new CheckpointManager(repo);\n    74\t    const checkpoint = manager.createCheckpoint(\"untracked executable\");\n    75\t    fs.chmodSync(tool, 0o600);\n    76\t\n    77\t    const result = manager.restore(checkpoint.id);\n    78\t\n    79\t    assert.equal(result.success, true, result.message);\n    80\t    assert.equal(fs.statSync(tool).mode & 0o777, 0o751);\n    81\t  } finally {\n    82\t    cleanupGitRepo(repo);\n    83\t  }\n    84\t});\n    85\t\n    86\ttest(\"Git restore refuses to mutate while merge metadata is present\", () => {\n    87\t  const { repo, git } = gitRepo();\n    88\t  try {\n    89\t    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"checkpoint state\\n\");\n    90\t    const manager = new CheckpointManager(repo);\n    91\t    const checkpoint = manager.createCheckpoint(\"before resolved merge commit\");\n    92\t    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"current state\\n\");\n    93\t    const indexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n    94\t    const mergeHead = git(\"rev-parse\", \"HEAD\");\n    95\t    fs.writeFileSync(path.join(repo, \".git\", \"MERGE_HEAD\"), `${mergeHead}\\n\");\n    96\t\n    97\t    const result = manager.restore(checkpoint.id);\n    98\t\n    99\t    assert.equal(result.success, false);\n   100\t    assert.match(result.message, /Git operation state/i);\n   101\t    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"current state\\n\");\n   102\t    assert.equal(execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\"), indexBefore);\n   103\t    assert.equal(fs.readFileSync(path.join(repo, \".git\", \"MERGE_HEAD\"), \"utf8\"), `${mergeHead}\\n`);\n   104\t  } finally {\n   105\t    cleanupGitRepo(repo);\n   106\t  }\n   107\t});\n   108\t\n   109\ttest(\"checkpoint creation fails closed for non-UTF-8 Git paths before publishing a ref\", { skip: process.platform === \"win32\" }, () => {\n   110\t  const { repo, git } = gitRepo();\n✘ [ERROR] Expected \")\" but found \"$\"\n\n    test/checkpoint_restore.test.ts:103:82:\n      103 │ ...ath.join(repo, \".git\", \"MERGE_HEAD\"), \"utf8\"), `${mergeHead}\\n`);\n          │                                                    ^\n          ╵                                                    )\n\n1 error\n","exit_code":1,"duration":{"secs":0,"nanos":952843815}},"started_at_ms":1793206486969,"completed_at_ms":1793206487922}}
