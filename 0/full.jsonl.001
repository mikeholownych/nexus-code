 && !bareConfig.isSymbolicLink();\n369:        if (hasBareRepositoryLayout && bareConfig) {\n370:          if (bareConfig.size > 1024 * 1024) {\n374:          for (const line of fs.readFileSync(bareConfigPath, \"utf8\").split(/\\r?\\n/)) {\n404:    this.assertNoNestedGitRepositoryAncestors(relativePaths, targetRoot);\n1084:        this.assertNoNestedGitRepositoryAncestors(writePaths, this.workspace);\n1088:        this.assertNoNestedGitRepositoryAncestors(removalPaths, this.workspace, true);\n            stdio: \"ignore\",\n          });\n          throw new Error(\"Checkpoint could not verify protected Git index state\");\n        } catch (indexError) {\n          if (\n            indexError instanceof Error &&\n            indexError.message === \"Checkpoint could not verify protected Git index state\"\n          ) throw indexError;\n          if ((indexError as NodeJS.ErrnoException & { status?: number })?.status !== 1) {\n            throw new Error(\"Checkpoint could not verify protected Git index state\");\n          }\n          // Not present in the index: the path may be a staged deletion. Git's\n          // checkpoint operation will not persist any untracked replacement.\n        }\n      }\n\n      const worktreePath = path.join(gitRoot, relativePath);\n      const stat = fs.lstatSync(worktreePath, { throwIfNoEntry: false });\n      if (stat?.isSymbolicLink()) {\n        if (!allowSensitive) this.assertSnapshotTextSafe(fs.readlinkSync(worktreePath));\n      } else if (stat?.isFile()) {\n        if (!allowSensitive) assertNoSensitivePersistenceContent(fs.readFileSync(worktreePath, \"utf8\"), \"checkpoint\");\n      }\n    }\n  }\n\n  private gitUntrackedPaths(includeIgnored = false): string[] {\n    const paths = execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"ls-files\", \"--others\", \"--full-name\", ...(includeIgnored ? [] : [\"--exclude-standard\"]), \"-z\"], {\n      cwd: this.workspace,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    }).toString(\"utf8\").split(\"\\0\").filter(Boolean);\n    return paths.flatMap((gitPath) => {\n      const relativePath = this.workspaceRelativeGitPath(gitPath);\n      return relativePath ? [relativePath] : [];\n    });\n  }\n\n  private assertSnapshotTextSafe(value: string): void {\n    assertNoSensitivePersistenceContent(value, \"checkpoint\");\n    for (const component of value.split(/[\\\\/]/)) assertNoSensitivePersistenceContent(component, \"checkpoint\");\n  }\n\n  private assertUntrackedEntriesSafe(relativePaths: string[], sourceRoot: string, allowSensitive: boolean): void {\n    for (const relativePath of relativePaths) {\n      const sourcePath = path.join(sourceRoot, relativePath);\n      const stat = fs.lstatSync(sourcePath);\n      if (!allowSensitive) this.assertSnapshotTextSafe(relativePath);\n      if (stat.isSymbolicLink()) {\n        if (!allowSensitive) this.assertSnapshotTextSafe(fs.readlinkSync(sourcePath));\n      } else if (stat.isFile()) {\n        if (!allowSensitive) assertNoSensitivePersistenceContent(fs.readFileSync(sourcePath, \"utf8\"), \"checkpoint\");\n      } else {\n        throw new Error(\"Checkpoint untracked entries must be regular files or symbolic links\");\n      }\n    }\n  }\n\n  private assertNoNestedGitRepositoryAncestors(\n    relativePaths: string[],\n    targetRoot: string,\n    allowExternalSymlinkAncestors = false,\n  ): void {\n    const root = fs.realpathSync(targetRoot);\n    for (const relativePath of relativePaths) {\n      const destination = path.resolve(root, relativePath);\n      const relativeDestination = path.relative(root, destination);\n      if (!relativeDestination || relativeDestination === \"..\" || relativeDestination.startsWith(`..${path.sep}`) || path.isAbsolute(relativeDestination)) {\n        throw new Error(\"Checkpoint destination path escapes the workspace\");\n      }\n      const relativeParent = path.dirname(relativeDestination);\n      const parentComponents = relativeParent === \".\" ? [] : relativeParent.split(path.sep);\n      const destinationStat = fs.lstatSync(destination, { throwIfNoEntry: false });\n      // A directory at the exact destination can itself be a repository, for\n      // example when an untracked checkpoint file was replaced by a bare repo.\n      // Include that leaf only when it is currently a directory; ordinary file\n    fs.mkdirSync(refsDir, { recursive: true });\n    fs.writeFileSync(path.join(objectsDir, \"item.ts\"), \"checkpoint content\\n\");\n    fs.writeFileSync(path.join(refsDir, \"item.ts\"), \"ordinary project content\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"ordinary objects and refs directories\");\n\n    fs.rmSync(path.join(objectsDir, \"item.ts\"));\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(objectsDir, \"item.ts\"), \"utf8\"), \"checkpoint content\\n\");\n    assert.equal(fs.readFileSync(path.join(refsDir, \"item.ts\"), \"utf8\"), \"ordinary project content\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore allows an ordinary directory with bare-repository-like names\", () => {\n  const { repo, git } = gitRepo();\n  const lookalike = path.join(repo, \"ordinary-layout\");\n  try {\n    fs.mkdirSync(path.join(lookalike, \"objects\"), { recursive: true });\n    fs.mkdirSync(path.join(lookalike, \"refs\"), { recursive: true });\n    fs.writeFileSync(path.join(lookalike, \"HEAD\"), \"this is an ordinary project file\\n\");\n    fs.writeFileSync(path.join(lookalike, \"config\"), \"[core]\\nfilemode = true\\n\");\n    fs.writeFileSync(path.join(lookalike, \"captured.txt\"), \"checkpoint content\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"ordinary directory resembles a bare repository\");\n    fs.writeFileSync(path.join(lookalike, \"captured.txt\"), \"changed after checkpoint\\n\");\n    const headBefore = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(lookalike, \"captured.txt\"), \"utf8\"), \"checkpoint content\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore refuses a tracked destination inside a nested repository before changing either index\", () => {\n  const { repo, git } = gitRepo();\n  const trackedParent = path.join(repo, \"a\");\n  const nestedGit = (...args: string[]) => execFileSync(\"git\", [\"-C\", trackedParent, ...args], { encoding: \"utf8\" }).trim();\n  try {\n    fs.mkdirSync(trackedParent);\n    fs.writeFileSync(path.join(trackedParent, \"captured.txt\"), \"checkpoint tracked content\\n\");\n    git(\"add\", \"a/captured.txt\");\n    git(\"commit\", \"-qm\", \"tracked nested destination\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"tracked path below nested repo\");\n\n    fs.rmSync(trackedParent, { recursive: true, force: true });\n    fs.mkdirSync(trackedParent);\n    nestedGit(\"init\", \"-q\");\n","exit_code":0,"duration":{"secs":0,"nanos":975025009}},"started_at_ms":1793204785738,"completed_at_ms":1793204786713}}
