{"timestamp":"2026-10-28T16:46:38.149Z","ordinal":464824,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18366-2421-7770-adb2-8a0eb3a8a68d","item":{"type":"CommandExecution","id":"exec-0241a48f-acec-4003-9e57-71c094202df4","process_id":"78442","command":["/usr/bin/zsh","-lc","sed -n '300,390p' cli/src/checkpoint.ts; sed -n '710,835p' cli/src/checkpoint.ts; sed -n '850,885p' cli/src/checkpoint.ts; sed -n '1,145p' cli/test/checkpoint_restore.test.ts; sed -n '1450,1650p' cli/test/checkpoint_restore.test.ts"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"read","cmd":"sed -n '300,390p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"read","cmd":"sed -n '710,835p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"read","cmd":"sed -n '850,885p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"read","cmd":"sed -n '1,145p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"},{"type":"read","cmd":"sed -n '1450,1650p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"        if (!allowSensitive) assertNoSensitivePersistenceContent(fs.readFileSync(sourcePath, \"utf8\"), \"checkpoint\");\n      } else {\n        throw new Error(\"Checkpoint untracked entries must be regular files or symbolic links\");\n      }\n    }\n  }\n\n  private assertNoNestedGitRepositoryAncestors(\n    relativePaths: string[],\n    targetRoot: string,\n    allowExternalSymlinkAncestors = false,\n  ): void {\n    const root = fs.realpathSync(targetRoot);\n    for (const relativePath of relativePaths) {\n      const destination = path.resolve(root, relativePath);\n      const relativeDestination = path.relative(root, destination);\n      if (!relativeDestination || relativeDestination === \"..\" || relativeDestination.startsWith(`..${path.sep}`) || path.isAbsolute(relativeDestination)) {\n        throw new Error(\"Checkpoint destination path escapes the workspace\");\n      }\n      const relativeParent = path.dirname(relativeDestination);\n      const parentComponents = relativeParent === \".\" ? [] : relativeParent.split(path.sep);\n      const destinationStat = fs.lstatSync(destination, { throwIfNoEntry: false });\n      // A directory at the exact destination can itself be a repository, for\n      // example when an untracked checkpoint file was replaced by a bare repo.\n      // Include that leaf only when it is currently a directory; ordinary file\n      // destinations still need only their parents checked.\n      const components = destinationStat?.isDirectory()\n        ? [...parentComponents, path.basename(relativeDestination)]\n        : parentComponents;\n      let parent = root;\n      for (const component of components) {\n        parent = path.join(parent, component);\n        const stat = fs.lstatSync(parent, { throwIfNoEntry: false });\n        if (!stat) break;\n        if (stat.isSymbolicLink()) {\n          if (allowExternalSymlinkAncestors) {\n            try {\n              const resolvedParent = fs.realpathSync(parent);\n              if (resolvedParent !== root && !resolvedParent.startsWith(root + path.sep)) break;\n            } catch {\n              // Deletion cleanup already skips dangling or inaccessible parents.\n              break;\n            }\n          }\n          throw new Error(\"Checkpoint destination parent is a symbolic link\");\n        }\n        if (!stat.isDirectory()) break;\n        const dotGit = fs.lstatSync(path.join(parent, \".git\"), { throwIfNoEntry: false });\n        const bareHead = fs.lstatSync(path.join(parent, \"HEAD\"), { throwIfNoEntry: false });\n        const bareConfig = fs.lstatSync(path.join(parent, \"config\"), { throwIfNoEntry: false });\n        const bareObjects = fs.lstatSync(path.join(parent, \"objects\"), { throwIfNoEntry: false });\n        const bareRefs = fs.lstatSync(path.join(parent, \"refs\"), { throwIfNoEntry: false });\n        if (dotGit) {\n          throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n        }\n\n        // Probe a private, bounded snapshot instead of asking Git to inspect\n        // the destination. The destination config may be a FIFO, may change\n        // during inspection, or may include an external file. Ordinary source\n        // directories named `HEAD`, `config`, `objects`, or `refs` remain\n        // valid unless Git recognizes their safe snapshot as a repository.\n        if (bareHead && (bareConfig || bareObjects || bareRefs)) {\n          const nestedRepositoryError = \"Checkpoint destination parent is a nested Git repository\";\n          if (!bareHead.isFile() || !bareConfig?.isFile() || bareHead.size > 4096 || bareConfig.size > 1024 * 1024) {\n            throw new Error(nestedRepositoryError);\n          }\n          if ((bareObjects && !bareObjects.isDirectory()) || (bareRefs && !bareRefs.isDirectory())) {\n            throw new Error(nestedRepositoryError);\n          }\n\n          const readBoundedRegularFile = (filePath: string, expected: fs.Stats, maxBytes: number): Buffer => {\n            const noFollow = fs.constants.O_NOFOLLOW ?? 0;\n            const nonBlocking = fs.constants.O_NONBLOCK ?? 0;\n            const fd = fs.openSync(filePath, fs.constants.O_RDONLY | noFollow | nonBlocking);\n            try {\n              const opened = fs.fstatSync(fd);\n              if (!opened.isFile() || opened.dev !== expected.dev || opened.ino !== expected.ino || opened.size > maxBytes) {\n                throw new Error(nestedRepositoryError);\n              }\n              const content = Buffer.alloc(opened.size);\n              let offset = 0;\n              while (offset < content.length) {\n                const count = fs.readSync(fd, content, offset, content.length - offset, offset);\n                if (count === 0) throw new Error(nestedRepositoryError);\n                offset += count;\n              }\n              const afterRead = fs.fstatSync(fd);\n              if (afterRead.size !== opened.size || afterRead.mtimeMs !== opened.mtimeMs) {\n                throw new Error(nestedRepositoryError);\n              }\n              return content;\n        if (entry.isDirectory()) {\n          try {\n            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `${relativePath}/${child}`], {\n              cwd: this.workspace,\n              stdio: \"ignore\",\n            });\n            return false;\n          } catch (error) {\n            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n          }\n          if (!visit(fullPath, child)) return false;\n        } else if (entry.isFile() || entry.isSymbolicLink()) {\n          try {\n            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `${relativePath}/${child}`], {\n              cwd: this.workspace,\n              stdio: \"ignore\",\n            });\n            return false;\n          } catch (error) {\n            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n          }\n        } else {\n          return false;\n        }\n      }\n      return true;\n    };\n    return visit(root, \"\");\n  }\n\n  private gitTrackedDescendantPaths(relativePath: string): string[] {\n    return execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"ls-files\", \"--cached\", \"-z\", \"--\", relativePath], {\n      cwd: this.workspace,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    }).toString(\"utf8\").split(\"\\0\").filter((entry) => entry.startsWith(`${relativePath}/`));\n  }\n\n  private directoryContainsOnlyTrackedRemovableEntries(relativePath: string): boolean {\n    const root = path.join(this.workspace, relativePath);\n    const diskEntries: string[] = [];\n    const visit = (directory: string, relative: string): boolean => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        const child = relative ? `${relative}/${entry.name}` : entry.name;\n        const fullPath = path.join(directory, entry.name);\n        if (entry.name === \".git\") return false;\n        if (entry.isDirectory()) {\n          try {\n            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `${relativePath}/${child}`], {\n              cwd: this.workspace,\n              stdio: \"ignore\",\n            });\n            return false;\n          } catch (error) {\n            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n          }\n          if (!visit(fullPath, child)) return false;\n        } else if (entry.isFile() || entry.isSymbolicLink()) {\n          diskEntries.push(`${relativePath}/${child}`);\n        } else {\n          return false;\n        }\n      }\n      return true;\n    };\n\n    if (!visit(root, \"\")) return false;\n    if (diskEntries.length === 0) return false;\n    const trackedEntries = this.gitTrackedDescendantPaths(relativePath);\n    const tracked = new Set(trackedEntries);\n    if (diskEntries.length !== tracked.size || diskEntries.some((entry) => !tracked.has(entry))) return false;\n\n    for (const entry of diskEntries) {\n      try {\n        execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", entry], {\n          cwd: this.workspace,\n          stdio: \"ignore\",\n        });\n        return false;\n      } catch (error) {\n        if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n      }\n    }\n    return true;\n  }\n\n  private removeNonSnapshotEntries(snapshotFiles: string[]): void {\n    const retained = new Set(snapshotFiles);\n    const ignored = new Set([\"node_modules\", \".git\", \"target\", \"dist\", \".nexus\", \".next\", \".cache\"]);\n    const visit = (directory: string, relative: string): void => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        if (ignored.has(entry.name)) continue;\n        const entryPath = relative ? `${relative}/${entry.name}` : entry.name;\n        const fullPath = path.join(directory, entry.name);\n        if (entry.isDirectory()) {\n          visit(fullPath, entryPath);\n          if (fs.readdirSync(fullPath).length === 0 && ![...retained].some((file) => file.startsWith(entryPath + \"/\"))) {\n            fs.rmdirSync(fullPath);\n          }\n        } else if ((entry.isFile() || entry.isSymbolicLink()) && !retained.has(entryPath)) {\n          fs.rmSync(fullPath, { force: true });\n        }\n      }\n    };\n    visit(this.workspace, \"\");\n  }\n\n  public createCheckpoint(name?: string, options: { allowSensitive?: boolean } = {}): CheckpointInfo {\n    const allowSensitive = options.allowSensitive === true;\n    const rand = Math.random().toString(36).slice(2, 6);\n    const id = `cp_${Date.now()}_${rand}`;\n    const desc = redactForPersistence(name || `Checkpoint at ${new Date().toLocaleTimeString()}`);\n    const timestamp = new Date().toISOString();\n\n    let gitRef: string | undefined;\n    let snapshotDir: string | undefined;\n    let untrackedPaths: string[] = [];\n\n    if (this.isGit) {\n      try {\n        this.assertGitIndexUnlocked();\n        this.assertGitChangesSafe(allowSensitive);\n        untrackedPaths = this.gitUntrackedPaths();\n        this.assertUntrackedEntriesSafe(untrackedPaths, this.workspace, allowSensitive);\n        // Create an untracked + tracked git stash commit without modifying working tree\n        // Clean/smudge filter drivers (filter.* selected through .gitattributes) can still run external\n            stdio: \"ignore\",\n            env: hookGuardEnv,\n          });\n          gitRef = stashCommit;\n        } else {\n          // Working tree was clean; record HEAD\n          const headCommit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: this.workspace, encoding: \"utf-8\" }).trim();\n          this.assertGitIndexUnlocked();\n          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", `refs/nexus/checkpoints/${id}`, headCommit], {\n            cwd: this.workspace,\n            stdio: \"ignore\",\n            env: hookGuardEnv,\n          });\n          gitRef = headCommit;\n        }\n      } catch (error) {\n        if (\n          error instanceof SensitivePersistenceError ||\n          error instanceof GitIndexLockError ||\n          error instanceof GitIndexLockCheckError\n        ) throw error;\n        if (this.gitIndexLockExists()) throw new GitIndexLockError();\n        throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n      }\n    }\n\n    if (untrackedPaths.length > 0 || !gitRef) {\n      const snapTarget = path.join(this.checkpointDir, \"snapshots\", id);\n      try {\n        if (gitRef) {\n          this.copyUntrackedEntries(untrackedPaths, this.workspace, snapTarget, allowSensitive);\n        } else {\n          untrackedPaths = this.workspaceSnapshotPaths(this.workspace);\n          this.assertUntrackedEntriesSafe(untrackedPaths, this.workspace, allowSensitive);\n          this.copyUntrackedEntries(untrackedPaths, this.workspace, snapTarget, allowSensitive);\n        }\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { CheckpointManager } from \"../src/checkpoint.js\";\nimport { SensitivePersistenceError } from \"../src/core/persistence_protection.js\";\n\nlet previousHome: string | undefined;\nlet isolatedHome: string;\n\ntest.beforeEach(() => {\n  previousHome = process.env.HOME;\n  isolatedHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-home-\"));\n  process.env.HOME = isolatedHome;\n});\n\ntest.afterEach(() => {\n  if (previousHome === undefined) delete process.env.HOME;\n  else process.env.HOME = previousHome;\n  fs.rmSync(isolatedHome, { recursive: true, force: true });\n});\n\nfunction gitRepo(): { repo: string; git: (...args: string[]) => string } {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-\"));\n  const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: repo, encoding: \"utf8\" }).trim();\n  git(\"init\", \"-q\");\n  git(\"config\", \"user.email\", \"test@example.invalid\");\n  git(\"config\", \"user.name\", \"Test\");\n  fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"base\\n\");\n  git(\"add\", \"tracked.txt\");\n  git(\"commit\", \"-qm\", \"base\");\n  return { repo, git };\n}\n\nfunction cleanupGitRepo(repo: string): void {\n  const checkpointKey = createHash(\"sha256\").update(path.resolve(repo)).digest(\"hex\").slice(0, 12);\n  fs.rmSync(path.join(os.homedir(), \".nexus\", \"checkpoints\", checkpointKey), { recursive: true, force: true });\n  fs.rmSync(repo, { recursive: true, force: true });\n}\n\ntest(\"Git restore preserves untracked work and HEAD while removing post-checkpoint files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"pre-existing user work\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"preserve work\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"after checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"created-later.txt\"), \"remove me\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    assert.equal(fs.readFileSync(path.join(repo, \"tracked.txt\"), \"utf8\"), \"at checkpoint\\n\");\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"pre-existing user work\\n\");\n    assert.equal(fs.existsSync(path.join(repo, \"created-later.txt\")), false);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git checkpoint refuses sensitive untracked content before writing a ref\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), `ghp_${\"H\".repeat(36)}\\n`);\n    const manager = new CheckpointManager(repo);\n\n    assert.throws(() => manager.createCheckpoint(\"protected\"), SensitivePersistenceError);\n    assert.equal(manager.listCheckpoints().length, 0);\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"restore refuses to clean when the untracked snapshot is missing\", () => {\n  const { repo } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"captured work\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"missing snapshot\");\n    fs.rmSync(checkpoint.snapshotDir!, { recursive: true });\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"work that must not be deleted\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked snapshot/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"work that must not be deleted\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy Git restore does not delete uncaptured untracked files or move HEAD\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy shape\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"uncaptured user work\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.match(result.message, /legacy untracked files/);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"uncaptured user work\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"explicitly allowed sensitive untracked content can be restored\", () => {\n  const { repo } = gitRepo();\n  try {\n    const marker = `ghp_${\"I\".repeat(36)}`;\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), `${marker}\\n`);\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"allowed sensitive draft\", { allowSensitive: true });\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"changed later\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), `${marker}\\n`);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"restore captures untracked files even under conventional build directory names\", () => {\n  const { repo } = gitRepo();\n  try {\n    fs.mkdirSync(path.join(repo, \"node_modules\"));\n  const objectsDir = path.join(projectDir, \"objects\");\n  const refsDir = path.join(projectDir, \"refs\");\n  try {\n    fs.mkdirSync(objectsDir, { recursive: true });\n    fs.mkdirSync(refsDir, { recursive: true });\n    fs.writeFileSync(path.join(objectsDir, \"item.ts\"), \"checkpoint content\\n\");\n    fs.writeFileSync(path.join(refsDir, \"item.ts\"), \"ordinary project content\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"ordinary objects and refs directories\");\n\n    fs.rmSync(path.join(objectsDir, \"item.ts\"));\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(objectsDir, \"item.ts\"), \"utf8\"), \"checkpoint content\\n\");\n    assert.equal(fs.readFileSync(path.join(refsDir, \"item.ts\"), \"utf8\"), \"ordinary project content\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore allows an ordinary directory with bare-repository-like names\", () => {\n  const { repo, git } = gitRepo();\n  const lookalike = path.join(repo, \"ordinary-layout\");\n  try {\n    fs.mkdirSync(path.join(lookalike, \"objects\"), { recursive: true });\n    fs.mkdirSync(path.join(lookalike, \"refs\"), { recursive: true });\n    fs.writeFileSync(path.join(lookalike, \"HEAD\"), \"this is an ordinary project file\\n\");\n    fs.writeFileSync(path.join(lookalike, \"config\"), \"[core]\\nfilemode = true\\n\");\n    fs.writeFileSync(path.join(lookalike, \"captured.txt\"), \"checkpoint content\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"ordinary directory resembles a bare repository\");\n    fs.writeFileSync(path.join(lookalike, \"captured.txt\"), \"changed after checkpoint\\n\");\n    const headBefore = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(lookalike, \"captured.txt\"), \"utf8\"), \"checkpoint content\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore refuses a tracked destination inside a nested repository before changing either index\", () => {\n  const { repo, git } = gitRepo();\n  const trackedParent = path.join(repo, \"a\");\n  const nestedGit = (...args: string[]) => execFileSync(\"git\", [\"-C\", trackedParent, ...args], { encoding: \"utf8\" }).trim();\n  try {\n    fs.mkdirSync(trackedParent);\n    fs.writeFileSync(path.join(trackedParent, \"captured.txt\"), \"checkpoint tracked content\\n\");\n    git(\"add\", \"a/captured.txt\");\n    git(\"commit\", \"-qm\", \"tracked nested destination\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"tracked path below nested repo\");\n\n    fs.rmSync(trackedParent, { recursive: true, force: true });\n    fs.mkdirSync(trackedParent);\n    nestedGit(\"init\", \"-q\");\n    nestedGit(\"config\", \"user.email\", \"nested@example.invalid\");\n    nestedGit(\"config\", \"user.name\", \"Nested Test\");\n    fs.writeFileSync(path.join(trackedParent, \"captured.txt\"), \"nested repository canary\\n\");\n    nestedGit(\"add\", \"captured.txt\");\n    nestedGit(\"commit\", \"-qm\", \"nested canary\");\n    const nestedHeadBefore = nestedGit(\"rev-parse\", \"HEAD\");\n    const nestedIndexBefore = execFileSync(\"git\", [\"-C\", trackedParent, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n\n    fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n    git(\"add\", \"staged-after-checkpoint.txt\");\n    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n    const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe|snapshot/i);\n    assert.equal(fs.readFileSync(path.join(trackedParent, \"captured.txt\"), \"utf8\"), \"nested repository canary\\n\");\n    assert.equal(nestedGit(\"rev-parse\", \"HEAD\"), nestedHeadBefore);\n    const nestedIndexAfter = execFileSync(\"git\", [\"-C\", trackedParent, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(nestedIndexAfter, nestedIndexBefore, \"rejection must preserve nested repository index entries\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n    const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve outer index entries\");\n    assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore preflights tracked deletions before removing files inside nested repositories\", () => {\n  const { repo, git } = gitRepo();\n  const trackedParent = path.join(repo, \"a\");\n  const nestedGit = (...args: string[]) => execFileSync(\"git\", [\"-C\", trackedParent, ...args], { encoding: \"utf8\" }).trim();\n  try {\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"before tracked nested file\");\n\n    fs.mkdirSync(trackedParent);\n    fs.writeFileSync(path.join(trackedParent, \"file\"), \"outer tracked file\\n\");\n    git(\"add\", \"a/file\");\n    git(\"commit\", \"-qm\", \"add tracked nested file\");\n    fs.rmSync(trackedParent, { recursive: true, force: true });\n    fs.mkdirSync(trackedParent);\n    nestedGit(\"init\", \"-q\");\n    nestedGit(\"config\", \"user.email\", \"nested@example.invalid\");\n    nestedGit(\"config\", \"user.name\", \"Nested Test\");\n    fs.writeFileSync(path.join(trackedParent, \"file\"), \"nested repository canary\\n\");\n    nestedGit(\"add\", \"file\");\n    nestedGit(\"commit\", \"-qm\", \"nested canary\");\n    const nestedHeadBefore = nestedGit(\"rev-parse\", \"HEAD\");\n    const nestedIndexBefore = execFileSync(\"git\", [\"-C\", trackedParent, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n\n    fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n    git(\"add\", \"staged-after-checkpoint.txt\");\n    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n    const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /nested Git repository|destination|unsafe/i);\n    assert.equal(fs.readFileSync(path.join(trackedParent, \"file\"), \"utf8\"), \"nested repository canary\\n\");\n    assert.equal(nestedGit(\"rev-parse\", \"HEAD\"), nestedHeadBefore);\n    const nestedIndexAfter = execFileSync(\"git\", [\"-C\", trackedParent, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(nestedIndexAfter, nestedIndexBefore, \"rejection must preserve the nested repository index\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n    const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve the outer index\");\n    assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore refuses a tracked destination through a symlinked nested repository before mutation\", () => {\n  const { repo, git } = gitRepo();\n  const nestedRepo = path.join(repo, \"nested-repo\");\n  const nestedGit = (...args: string[]) => execFileSync(\"git\", [\"-C\", nestedRepo, ...args], { encoding: \"utf8\" }).trim();\n  try {\n    fs.mkdirSync(path.join(repo, \"a\"));\n    fs.writeFileSync(path.join(repo, \"a\", \"captured.txt\"), \"checkpoint tracked content\\n\");\n    git(\"add\", \"a/captured.txt\");\n    git(\"commit\", \"-qm\", \"tracked nested destination\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"tracked path through nested repo symlink\");\n\n    fs.rmSync(path.join(repo, \"a\"), { recursive: true, force: true });\n    fs.mkdirSync(nestedRepo);\n    nestedGit(\"init\", \"-q\");\n    nestedGit(\"config\", \"user.email\", \"nested@example.invalid\");\n    nestedGit(\"config\", \"user.name\", \"Nested Test\");\n    fs.writeFileSync(path.join(nestedRepo, \"captured.txt\"), \"nested repository canary\\n\");\n    nestedGit(\"add\", \"captured.txt\");\n    nestedGit(\"commit\", \"-qm\", \"nested canary\");\n    fs.symlinkSync(\"nested-repo\", path.join(repo, \"a\"));\n    const nestedHeadBefore = nestedGit(\"rev-parse\", \"HEAD\");\n    const nestedIndexBefore = execFileSync(\"git\", [\"-C\", nestedRepo, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n\n    fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n    git(\"add\", \"staged-after-checkpoint.txt\");\n    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n    const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe|snapshot/i);\n    assert.equal(fs.readFileSync(path.join(nestedRepo, \"captured.txt\"), \"utf8\"), \"nested repository canary\\n\");\n    assert.equal(nestedGit(\"rev-parse\", \"HEAD\"), nestedHeadBefore);\n    const nestedIndexAfter = execFileSync(\"git\", [\"-C\", nestedRepo, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(nestedIndexAfter, nestedIndexBefore, \"rejection must preserve nested repository index entries\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n    const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve outer index entries\");\n    assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore refuses an ignored directory replacing a tracked checkpoint file before Git mutation\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \".gitignore\"), \"a/ignored\\n\");\n    git(\"add\", \".gitignore\");\n    git(\"commit\", \"-qm\", \"ignore obstruction beneath tracked target\");\n    fs.writeFileSync(path.join(repo, \"a\"), \"captured file\\n\");\n    git(\"add\", \"a\");\n    git(\"commit\", \"-qm\", \"track checkpoint file target\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"tracked file replaced by ignored directory\");\n    fs.rmSync(path.join(repo, \"a\"));\n    fs.mkdirSync(path.join(repo, \"a\"));\n    fs.writeFileSync(path.join(repo, \"a\", \"ignored\"), \"ignored canary\\n\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"tracked canary\\n\");\n    fs.writeFileSync(path.join(repo, \"untracked.txt\"), \"untracked canary\\n\");\n    fs.writeFileSync(path.join(repo, \"staged.txt\"), \"staged canary\\n\");\n    git(\"add\", \"staged.txt\");\n    assert.equal(git(\"check-ignore\", \"a/ignored\"), \"a/ignored\");\n    const headBefore = git(\"rev-parse\", \"HEAD\");\n","exit_code":0,"duration":{"secs":0,"nanos":952023364}},"started_at_ms":1793205997196,"completed_at_ms":1793205998148}}
{"timestamp":"2026-10-28T16:46:39.525Z","ordinal":464825,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18368-17a5-7b52-a71c-27bb2268ff45","call_id":"call_98e18908966947e09fba77571ab764f7","output":[{"type":"input_text","text":"Script completed\nWall time 3.8 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 7317)\nTotal output lines: 599\n\n        if (!allowSensitive) assertNoSensitivePersistenceContent(fs.readFileSync(sourcePath, \"utf8\"), \"checkpoint\");\n      } else {\n        throw new Error(\"Checkpoint untracked entries must be regular files or symbolic links\");\n      }\n    }\n  }\n\n  private assertNoNestedGitRepositoryAncestors(\n    relativePaths: string[],\n    targetRoot: string,\n    allowExternalSymlinkAncestors = false,\n  ): void {\n    const root = fs.realpathSync(targetRoot);\n    for (const relativePath of relativePaths) {\n      const destination = path.resolve(root, relativePath);\n      const relativeDestination = path.relative(root, destination);\n      if (!relativeDestination || relativeDestination === \"..\" || relativeDestination.startsWith(`..${path.sep}`) || path.isAbsolute(relativeDestination)) {\n        throw new Error(\"Checkpoint destination path escapes the workspace\");\n      }\n      const relativeParent = path.dirname(relativeDestination);\n      const parentComponents = relativeParent === \".\" ? [] : relativeParent.split(path.sep);\n      const destinationStat = fs.lstatSync(destination, { throwIfNoEntry: false });\n      // A directory at the exact destination can itself be a repository, for\n      // example when an untracked checkpoint file was replaced by a bare repo.\n      // Include that leaf only when it is currently a directory; ordinary file\n      // destinations still need only their parents checked.\n      const components = destinationStat?.isDirectory()\n        ? [...parentComponents, path.basename(relativeDestination)]\n        : parentComponents;\n      let parent = root;\n      for (const component of components) {\n        parent = path.join(parent, component);\n        const stat = fs.lstatSync(parent, { throwIfNoEntry: false });\n        if (!stat) break;\n        if (stat.isSymbolicLink()) {\n          if (allowExternalSymlinkAncestors) {\n            try {\n              const resolvedParent = fs.realpathSync(parent);\n              if (resolvedParent !== root && !resolvedParent.startsWith(root + path.sep)) break;\n            } catch {\n              // Deletion cleanup already skips dangling or inaccessible parents.\n              break;\n            }\n          }\n          throw new Error(\"Checkpoint destination parent is a symbolic link\");\n        }\n        if (!stat.isDirectory()) break;\n        const dotGit = fs.lstatSync(path.join(parent, \".git\"), { throwIfNoEntry: false });\n        const bareHead = fs.lstatSync(path.join(parent, \"HEAD\"), { throwIfNoEntry: false });\n        const bareConfig = fs.lstatSync(path.join(parent, \"config\"), { throwIfNoEntry: false });\n        const bareObjects = fs.lstatSync(path.join(parent, \"objects\"), { throwIfNoEntry: false });\n        const bareRefs = fs.lstatSync(path.join(parent, \"refs\"), { throwIfNoEntry: false });\n        if (dotGit) {\n          throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n        }\n\n        // Probe a private, bounded snapshot instead of asking Git to inspect\n        // the destination. The destination config may be a FIFO, may change\n        // during inspection, or may include an external file. Ordinary source\n        // directories named `HEAD`, `config`, `objects`, or `refs` remain\n        // valid unless Git recognizes their safe snapshot as a repository.\n        if (bareHead && (bareConfig || bareObjects || bareRefs)) {\n          const nestedRepositoryError = \"Checkpoint destination parent is a nested Git repository\";\n          if (!bareHead.isFile() || !bareConfig?.isFile() || bareHead.size > 4096 || bareConfig.size > 1024 * 1024) {\n            throw new Error(nestedRepositoryError);\n          }\n          if ((bareObjects && !bareObjects.isDirectory()) || (bareRefs && !bareRefs.isDirectory())) {\n            throw new Error(nestedRepositoryError);\n          }\n\n          const readBoundedRegularFile = (filePath: string, expected: fs.Stats, maxBytes: number): Buffer => {\n            const noFollow = fs.constants.O_NOFOLLOW ?? 0;\n            const nonBlocking = fs.constants.O_NONBLOCK ?? 0;\n            const fd = fs.openSync(filePath, fs.constants.O_RDONLY | noFollow | nonBlocking);\n            try {\n              const opened = fs.fstatSync(fd);\n              if (!opened.isFile() || opened.dev !== expected.dev || opened.ino !== expected.ino || opened.size > maxBytes) {\n                throw new Error(nestedRepositoryError);\n              }\n              const content = Buffer.alloc(opened.size);\n              let offset = 0;\n              while (offset < content.length) {\n                const count = fs.readSync(fd, content, offset, content.length - offset, offset);\n                if (count === 0) throw new Error(nestedRepositoryError);\n                offset += count;\n              }\n              const afterRead = fs.fstatSync(fd);\n              if (afterRead.size !== opened.size || afterRead.mtimeMs !== opened.mtimeMs) {\n                throw new Error(nestedRepositoryError);\n              }\n              return content;\n        if (entry.isDirectory()) {\n          try {\n            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `${relativePath}/${child}`], {\n              cwd: this.workspace,\n              stdio: \"ignore\",\n            });\n            return false;\n          } catch (error) {\n            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n          }\n          if (!visit(fullPath, child)) return false;\n        } else if (entry.isFile() || entry.isSymbolicLink()) {\n          try {\n            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `${relativePath}/${child}`], {\n              cwd: this.workspace,\n              stdio: \"ignore\",\n            });\n            return false;\n          } catch (error) {\n            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n          }\n        } else {\n          return false;\n        }\n      }\n      return true;\n    };\n    return visit(root, \"\");\n  }\n\n  private gitTrackedDescendantPaths(relativePath: string): string[] {\n    return execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"ls-files\", \"--cached\", \"-z\", \"--\", relativePath], {\n      cwd: this.workspace,\n      encoding: \"buffer\",\n      maxBuffer: 64 * 1024 * 1024,\n    }).toString(\"utf8\").split(\"\\0\").filter((entry) => entry.startsWith(`${relativePath}/`));\n  }\n\n  private directoryContainsOnlyTrackedRemovableEntries(relativePath: string): boolean {\n    const root = path.join(this.workspace, relativePath);\n    const diskEntries: string[] = [];\n    const visit = (directory: string, relative: string): boolean => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        const child = relative ? `${relative}/${entry.name}` : entry.name;\n        const fullPath = path.join(directory, entry.name);\n        if (entry.name === \".git\") return false;\n        if (entry.isDirectory()) {\n          try {\n            execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", `${relativePath}/${child}`], {\n              cwd: this.workspace,\n              stdio: \"ignore\",\n            });\n            return false;\n          } catch (error) {\n            if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n          }\n          if (!visit(fullPath, child)) return false;\n        } else if (entry.isFile() || entry.isSymbolicLink()) {\n          diskEntries.push(`${relativePath}/${child}`);\n        } else {\n          return false;\n        }\n      }\n      return true;\n    };\n\n    if (!visit(root, \"\")) return false;\n    if (diskEntries.length === 0) return false;\n    const trackedEntries = this.gitTrackedDescendantPaths(relativePath);\n    const tracked = new Set(trackedEntries);\n    if (diskEntries.length !== tracked.size || diskEntries.some((entry) => !tracked.has(entry))) return false;\n\n    for (const entry of diskEntries) {\n      try {\n        execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", entry], {\n          cwd: this.workspace,\n          stdio: \"ignore\",\n        });\n        return false;\n      } catch (error) {\n        if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n      }\n    }\n    return true;\n  }\n\n  private removeNonSnapshotEntries(snapshotFiles: string[]): void {\n    const retained = new Set(snapshotFiles);\n    const ignored = new Set([\"node_modules\", \".git\", \"target\", \"dist\", \".nexus\", \".next\", \".cache\"]);\n    const visit = (directory: string, relative: string): void => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        if (ignored.has(entry.name)) continue;\n        const entryPath = relative ? `${relative}/${entry.name}` : entry.name;\n        const fullPath = path.join(directory, entry.name);\n        if (entry.isDirectory()) {\n          visit(fullPath, entryPath);\n          if (fs.readdirSync(fullPath).length === 0 && ![...retained].some((file) => file.startsWith(entryPath + \"/\"))) {\n            fs.rmdirSync(fullPath);\n          }\n        } else if ((entry.isFile() || entry.isSymbolicLink()) && !retained.has(entryPath)) {\n          fs.rmSync(fullPath, { force: true });\n        }\n      }\n    };\n    visit(this.workspace, \"\");\n  }\n\n  public createCheckpoint(name?: string, options: { allowSensitive?: boolean } = {}): CheckpointInfo {\n    const allowSensitive = options.allowSensitive === true;\n    const rand = Math.random().toString(36).slice(2, 6);\n    const id = `cp_${Date.now()}_${rand}`;\n    const desc = redactForPersistence(name || `Checkpoint at ${new Date().toLocaleTimeString()}`);\n    const timestamp = new Date().toISOString();\n\n    let gitRef: string | undefined;\n    let snapshotDir: string | undefined;\n    let untrackedPaths: string[] = [];\n\n    if (this.isGit) {\n      try {\n        this.assertGitIndexUnlocked();\n        this.assertGitChangesSafe(allowSensitive);\n        untrackedPaths = this.gitUntrackedPaths();\n        this.assertUntrackedEntriesSafe(untrackedPaths, this.workspace, allowSensitive);\n        // Create an untracked + tracked git stash commit without modifying working tree\n        // Clean/smudge filter drivers (filter.* selected through .gitattributes) can still run external\n            stdio: \"ignore\",\n            env: hookGuardEnv,\n          });\n          gitRef = stashCommit;\n        } else {\n          // Working tree was clean; record HEAD\n          const headCommit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: this.workspace, encoding: \"utf-8\" }).trim();\n          this.assertGitIndexUnlocked();\n          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", `refs/nexus/checkpoints/${id}`, headCommit], {\n            cwd: this.workspace,\n            stdio: \"ignore\",\n            env: hookGuardEnv,\n          });\n          gitRef = headCommit;\n        }\n      } catch (error) {\n        if (\n          error instanceof SensitivePersistenceError ||\n          error instanceof GitIndexLockError ||\n          error instanceof GitIndexLockCheckError\n        ) throw error;\n        if (this.gitIndexLockExists()) throw new GitIndexLockError();\n        throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n      }\n    }\n\n    if (untrackedPaths.length > 0 || !gitRef) {\n      const snapTarget = path.join(this.checkpointDir, \"snapshots\", id);\n      try {\n        if (gitRef) {\n          this.copyUntrackedEntries(untrackedPaths, this.workspace, snapTarget, allowSensitive);\n        } else {\n          untrackedPaths = this.workspaceSnapshotPaths(this.workspace);\n          this.assertUntrackedEntriesSafe(untrackedPaths, this.workspace, allowSensitive);\n          this.copyUntrackedEntries(untrackedPaths, this.workspace, snapTarget, allowSensitive);\n        }\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { CheckpointManager } from \"../src/checkpoint.js\";\nimport { SensitivePersistenceError } from \"../src/core/persistence_protection.js\";\n\nlet previousHome: string | undefined;\nlet isolatedHome: string;\n\ntest.beforeEach(() => {\n  previousHome = process.env.HOME;\n  isolatedHome = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-home-\"));\n  process.env.HOME = isolatedHome;\n});\n\ntest.afterEach(() => {\n  if (previousHome === undefined) delete process.env.HOME;\n  else process.env.HOME = previousHome;\n  fs.rmSync(isolatedHome, { recursive: true, force: true });\n});\n\nfunction gitRepo(): { repo: string; git: (...args: string[]) => string } {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-checkpoint-restore-\"));\n  const git = (...args: string[]) => execFileSync(\"git\", args, { cwd: repo, encoding: \"utf8\" }).trim();\n  git(\"init\", \"-q\");\n  git(\"config\", \"user.email\", \"test@example.invalid\");\n  git(\"config\", \"user.name\", \"Test\");\n  fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"base\\n\");\n  git(\"add\", \"tracked.txt\");\n  git(\"commit\", \"-qm\", \"base\");\n  return { repo, git };\n}\n\nfunction cleanupGitRepo(repo: string): void {\n  const checkpointKey = createHash(\"sha256\").update(path.resolve(repo)).digest(\"hex\").slice(0, 12);\n  fs.rmSync(path.join(os.homedir(), \".nexus\", \"checkpoints\", checkpointKey), { recursive: true, force: true });\n  fs.rmSync(repo, { recursive: true, force: true });\n}\n\ntest(\"Git restore preserves untracked work and HEAD while removing post-checkpoint files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"pre-existing user work\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = …317 tokens truncated…acked snapshot is missing\", () => {\n  const { repo } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"captured work\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"missing snapshot\");\n    fs.rmSync(checkpoint.snapshotDir!, { recursive: true });\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"work that must not be deleted\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked snapshot/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"work that must not be deleted\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"legacy Git restore does not delete uncaptured untracked files or move HEAD\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"at checkpoint\\n\");\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy shape\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"uncaptured user work\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.match(result.message, /legacy untracked files/);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"uncaptured user work\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"explicitly allowed sensitive untracked content can be restored\", () => {\n  const { repo } = gitRepo();\n  try {\n    const marker = `ghp_${\"I\".repeat(36)}`;\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), `${marker}\\n`);\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"allowed sensitive draft\", { allowSensitive: true });\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"changed later\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), `${marker}\\n`);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"restore captures untracked files even under conventional build directory names\", () => {\n  const { repo } = gitRepo();\n  try {\n    fs.mkdirSync(path.join(repo, \"node_modules\"));\n  const objectsDir = path.join(projectDir, \"objects\");\n  const refsDir = path.join(projectDir, \"refs\");\n  try {\n    fs.mkdirSync(objectsDir, { recursive: true });\n    fs.mkdirSync(refsDir, { recursive: true });\n    fs.writeFileSync(path.join(objectsDir, \"item.ts\"), \"checkpoint content\\n\");\n    fs.writeFileSync(path.join(refsDir, \"item.ts\"), \"ordinary project content\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"ordinary objects and refs directories\");\n\n    fs.rmSync(path.join(objectsDir, \"item.ts\"));\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(objectsDir, \"item.ts\"), \"utf8\"), \"checkpoint content\\n\");\n    assert.equal(fs.readFileSync(path.join(refsDir, \"item.ts\"), \"utf8\"), \"ordinary project content\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore allows an ordinary directory with bare-repository-like names\", () => {\n  const { repo, git } = gitRepo();\n  const lookalike = path.join(repo, \"ordinary-layout\");\n  try {\n    fs.mkdirSync(path.join(lookalike, \"objects\"), { recursive: true });\n    fs.mkdirSync(path.join(lookalike, \"refs\"), { recursive: true });\n    fs.writeFileSync(path.join(lookalike, \"HEAD\"), \"this is an ordinary project file\\n\");\n    fs.writeFileSync(path.join(lookalike, \"config\"), \"[core]\\nfilemode = true\\n\");\n    fs.writeFileSync(path.join(lookalike, \"captured.txt\"), \"checkpoint content\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"ordinary directory resembles a bare repository\");\n    fs.writeFileSync(path.join(lookalike, \"captured.txt\"), \"changed after checkpoint\\n\");\n    const headBefore = git(\"rev-parse\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.readFileSync(path.join(lookalike, \"captured.txt\"), \"utf8\"), \"checkpoint content\\n\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore refuses a tracked destination inside a nested repository before changing either index\", () => {\n  const { repo, git } = gitRepo();\n  const trackedParent = path.join(repo, \"a\");\n  const nestedGit = (...args: string[]) => execFileSync(\"git\", [\"-C\", trackedParent, ...args], { encoding: \"utf8\" }).trim();\n  try {\n    fs.mkdirSync(trackedParent);\n    fs.writeFileSync(path.join(trackedParent, \"captured.txt\"), \"checkpoint tracked content\\n\");\n    git(\"add\", \"a/captured.txt\");\n    git(\"commit\", \"-qm\", \"tracked nested destination\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"tracked path below nested repo\");\n\n    fs.rmSync(trackedParent, { recursive: true, force: true });\n    fs.mkdirSync(trackedParent);\n    nestedGit(\"init\", \"-q\");\n    nestedGit(\"config\", \"user.email\", \"nested@example.invalid\");\n    nestedGit(\"config\", \"user.name\", \"Nested Test\");\n    fs.writeFileSync(path.join(trackedParent, \"captured.txt\"), \"nested repository canary\\n\");\n    nestedGit(\"add\", \"captured.txt\");\n    nestedGit(\"commit\", \"-qm\", \"nested canary\");\n    const nestedHeadBefore = nestedGit(\"rev-parse\", \"HEAD\");\n    const nestedIndexBefore = execFileSync(\"git\", [\"-C\", trackedParent, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n\n    fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n    git(\"add\", \"staged-after-checkpoint.txt\");\n    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n    const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe|snapshot/i);\n    assert.equal(fs.readFileSync(path.join(trackedParent, \"captured.txt\"), \"utf8\"), \"nested repository canary\\n\");\n    assert.equal(nestedGit(\"rev-parse\", \"HEAD\"), nestedHeadBefore);\n    const nestedIndexAfter = execFileSync(\"git\", [\"-C\", trackedParent, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(nestedIndexAfter, nestedIndexBefore, \"rejection must preserve nested repository index entries\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n    const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve outer index entries\");\n    assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore preflights tracked deletions before removing files inside nested repositories\", () => {\n  const { repo, git } = gitRepo();\n  const trackedParent = path.join(repo, \"a\");\n  const nestedGit = (...args: string[]) => execFileSync(\"git\", [\"-C\", trackedParent, ...args], { encoding: \"utf8\" }).trim();\n  try {\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"before tracked nested file\");\n\n    fs.mkdirSync(trackedParent);\n    fs.writeFileSync(path.join(trackedParent, \"file\"), \"outer tracked file\\n\");\n    git(\"add\", \"a/file\");\n    git(\"commit\", \"-qm\", \"add tracked nested file\");\n    fs.rmSync(trackedParent, { recursive: true, force: true });\n    fs.mkdirSync(trackedParent);\n    nestedGit(\"init\", \"-q\");\n    nestedGit(\"config\", \"user.email\", \"nested@example.invalid\");\n    nestedGit(\"config\", \"user.name\", \"Nested Test\");\n    fs.writeFileSync(path.join(trackedParent, \"file\"), \"nested repository canary\\n\");\n    nestedGit(\"add\", \"file\");\n    nestedGit(\"commit\", \"-qm\", \"nested canary\");\n    const nestedHeadBefore = nestedGit(\"rev-parse\", \"HEAD\");\n    const nestedIndexBefore = execFileSync(\"git\", [\"-C\", trackedParent, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n\n    fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n    git(\"add\", \"staged-after-checkpoint.txt\");\n    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n    const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /nested Git repository|destination|unsafe/i);\n    assert.equal(fs.readFileSync(path.join(trackedParent, \"file\"), \"utf8\"), \"nested repository canary\\n\");\n    assert.equal(nestedGit(\"rev-parse\", \"HEAD\"), nestedHeadBefore);\n    const nestedIndexAfter = execFileSync(\"git\", [\"-C\", trackedParent, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(nestedIndexAfter, nestedIndexBefore, \"rejection must preserve the nested repository index\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n    const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve the outer index\");\n    assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore refuses a tracked destination through a symlinked nested repository before mutation\", () => {\n  const { repo, git } = gitRepo();\n  const nestedRepo = path.join(repo, \"nested-repo\");\n  const nestedGit = (...args: string[]) => execFileSync(\"git\", [\"-C\", nestedRepo, ...args], { encoding: \"utf8\" }).trim();\n  try {\n    fs.mkdirSync(path.join(repo, \"a\"));\n    fs.writeFileSync(path.join(repo, \"a\", \"captured.txt\"), \"checkpoint tracked content\\n\");\n    git(\"add\", \"a/captured.txt\");\n    git(\"commit\", \"-qm\", \"tracked nested destination\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"tracked path through nested repo symlink\");\n\n    fs.rmSync(path.join(repo, \"a\"), { recursive: true, force: true });\n    fs.mkdirSync(nestedRepo);\n    nestedGit(\"init\", \"-q\");\n    nestedGit(\"config\", \"user.email\", \"nested@example.invalid\");\n    nestedGit(\"config\", \"user.name\", \"Nested Test\");\n    fs.writeFileSync(path.join(nestedRepo, \"captured.txt\"), \"nested repository canary\\n\");\n    nestedGit(\"add\", \"captured.txt\");\n    nestedGit(\"commit\", \"-qm\", \"nested canary\");\n    fs.symlinkSync(\"nested-repo\", path.join(repo, \"a\"));\n    const nestedHeadBefore = nestedGit(\"rev-parse\", \"HEAD\");\n    const nestedIndexBefore = execFileSync(\"git\", [\"-C\", nestedRepo, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n\n    fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n    git(\"add\", \"staged-after-checkpoint.txt\");\n    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n    const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe|snapshot/i);\n    assert.equal(fs.readFileSync(path.join(nestedRepo, \"captured.txt\"), \"utf8\"), \"nested repository canary\\n\");\n    assert.equal(nestedGit(\"rev-parse\", \"HEAD\"), nestedHeadBefore);\n    const nestedIndexAfter = execFileSync(\"git\", [\"-C\", nestedRepo, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(nestedIndexAfter, nestedIndexBefore, \"rejection must preserve nested repository index entries\");\n    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n    const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n    assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve outer index entries\");\n    assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git manifest restore refuses an ignored directory replacing a tracked checkpoint file before Git mutation\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.writeFileSync(path.join(repo, \".gitignore\"), \"a/ignored\\n\");\n    git(\"add\", \".gitignore\");\n    git(\"commit\", \"-qm\", \"ignore obstruction beneath tracked target\");\n    fs.writeFileSync(path.join(repo, \"a\"), \"captured file\\n\");\n    git(\"add\", \"a\");\n    git(\"commit\", \"-qm\", \"track checkpoint file target\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"tracked file replaced by ignored directory\");\n    fs.rmSync(path.join(repo, \"a\"));\n    fs.mkdirSync(path.join(repo, \"a\"));\n    fs.writeFileSync(path.join(repo, \"a\", \"ignored\"), \"ignored canary\\n\");\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"tracked canary\\n\");\n    fs.writeFileSync(path.join(repo, \"untracked.txt\"), \"untracked canary\\n\");\n    fs.writeFileSync(path.join(repo, \"staged.txt\"), \"staged canary\\n\");\n    git(\"add\", \"staged.txt\");\n    assert.equal(git(\"check-ignore\", \"a/ignored\"), \"a/ignored\");\n    const headBefore = git(\"rev-parse\", \"HEAD\");\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18366-2421-7770-adb2-8a0eb3a8a68d","create_time":1793205999.5251482}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
