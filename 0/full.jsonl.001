{"timestamp":"2026-10-28T13:41:48.895Z","ordinal":458094,"type":"response_item","payload":{"author":"/root/review_pr302","content":[{"text":"Message Type: MESSAGE\nTask name: /root\nSender: /root/review_pr302\nPayload:\n","type":"input_text"}],"id":"amsg_01a182be-dcdf-7151-b491-5e2b5982496d","internal_chat_message_metadata_passthrough":{"content_item_metadata":[{"provenance":{"namespace":"collaboration","type":"tool"}},{"provenance":{"namespace":"collaboration","type":"tool"}}],"create_time":1793194908.8952124,"turn_id":"01a182b5-7df6-71b2-a955-13339511caaf"},"recipient":"/root","type":"agent_message"}}
