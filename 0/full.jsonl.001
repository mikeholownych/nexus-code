tchAll(NO_NEED)) refs.push(m[0]);\n629:     for (const m of clause.matchAll(NO_LONGER)) refs.push(m[0]);\n630:     for (const ref of refs) for (const n of ref.match(/\\d+/g) ?? []) found.add(`R${Number(n)}`);\n631:     for (const r of live) {\n632:       const own = normalizeClause(r.text);\n633:       if (own.split(\" \").length < 3) continue;\n634:       if (new RegExp(String.raw`(?:^|\\s)(?:dont|do not|never|no need to)\\s+(?:to\\s+)?${own}(?:\\s|$)`).test(clause)) found.add(r.id);\n635:     }\n636:   }\n637:   return live.filter((r) => found.has(r.id.toUpperCase())).map((r) => r.id);\n638: }\n639: \n640: /** Records steering that negates requirements, once per steering id. The ledger's requirements are not touched. */\n641: export function recordSteeringConflict(ledger: ObjectiveLedger, id: string, text: string, requirements: string[], at = now()): SteeringConflict | undefined {\n642:   if (ledger.steering.some((s) => s.id === id) || ledger.steeringConflicts?.some((c) => c.id === id)) return undefined;\n643:   const conflict: SteeringConflict = { id, text, requirements, receivedAt: at, status: \"pending\" };\n644:   (ledger.steeringConflicts ??= []).push(conflict);\n645:   return conflict;\n646: }\n647: \n648: /**\n649:  * The operator's decision, recorded only while the conflict is still pending: approval descopes the negated\n650:  * requirements (accepted) and queues the steering; a refusal changes nothing. `note` is the sanitised steering text.\n651:  */\n652: export function resolveSteeringConflict(ledger: ObjectiveLedger, conflict: SteeringConflict, approved: boolean, note: string, at = now()): boolean {\n653:   if (conflict.status !== \"pending\") return false;\n654:   conflict.status = approved ? \"approved\" : \"declined\";\n655:   conflict.decidedAt = at;\n656:   if (!approved) return true;\n657:   for (const id of conflict.requirements) {\n658:     const r = ledger.requirements.find((req) => req.id === id);","is_error":false}]},"uuid":"e9876c32-ca75-4