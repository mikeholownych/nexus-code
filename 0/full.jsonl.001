{"timestamp":"2026-11-21T23:03:53.300Z","ordinal":37752,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0393e1fe95dcae93016b022358591887d2a64c570132ecff6b","status":"completed","call_id":"call_6955798ae8e948f9a4da7deb8113d4d3","name":"exec","input":"const results = ALL_TOOLS.filter(x => x.name.includes(\"github\") && /review|pull request|pull_request|comment/i.test(x.description+\" \"+x.name)).slice(0,20);\ntext(JSON.stringify(results));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","create_time":1795302232.350161}},"metadata":{"history_sequence":16868,"sampled_through_sequence":16866,"client_authored":false}}
