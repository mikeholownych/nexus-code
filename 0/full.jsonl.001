> execFileSync(\"git\", args, { cwd: cli, encoding: \"utf8\" }).trim();\n \n+test(\"the build identity writer creates dist when run from a clean source checkout\", () => {\n+  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-build-identity-clean-\"));\n+  try {\n+    const script = path.join(root, \"cli\", \"scripts\", \"write_build_info.mjs\");\n+    fs.mkdirSync(path.dirname(script), { recursive: true });\n+    fs.copyFileSync(path.join(cli, \"scripts/write_build_info.mjs\"), script);\n+\n+    execFileSync(process.execPath, [script]);\n+\n+    const infoPath = path.join(root, \"cli\", \"dist\", \"build-info.json\");\n+    const info = JSON.parse(fs.readFileSync(infoPath, \"utf8\"));\n+    assert.equal(info.commit, \"unknown\", \"a non-Git source fixture still gets a usable build identity file\");\n+  } finally {\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n test(\"the build writes the commit, its time, the branch and whether the source (not cli/dist) was dirty\", () => {\n   execFileSync(process.execPath, [path.join(cli, \"scripts/write_build_info.mjs\")]);\n   const info = JSON.parse(fs.readFileSync(path.join(cli, \"dist/build-info.json\"), \"utf8\"));\n// Records the identity of this build in cli/dist/build-info.json (read by `nexus --version` and the doctor):\n// the commit, its time, and whether the source differed from it. Deterministic for a given tree (no wall-clock time),\n// so two builds of the same source are byte-identical. Not tracked: it describes a build, not the source.\nimport { execFileSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst cli = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst root = path.resolve(cli, \"..\");\nconst git = (...args) => {\n  try {\n    return execFileSync(\"git\", args, { cwd: root, encoding: \"utf8\", stdio: [\"ignore\", \"pipe\", \"ignore\"] }).trim();\n  } catch {\n    return null;\n  }\n};\nconst buildInfoPath = path.join(cli, \"dist\", \"build-info.json\");\nfs.mkdirSync(path.dirname(buildInfoPath), { recursive: true });\nconst commit = git(\"rev-parse\", \"--short=12\", \"HEAD\");\nconst info = {\n  commit: commit ?? \"unknown\",\n  commitTime: commit ? git(\"log\", \"-1\", \"--format=%cI\") : null,\n  // A detached checkout has no branch (\"HEAD\" is not one).\n  branch: commit ? (git(\"rev-parse\", \"--abbrev-ref\", \"HEAD\") || \"\").replace(/^HEAD$/, \"\") || null : null,\n  // Build output is tracked in this repository; a rebuilt cli/dist alone does not make the source dirty.\n  dirty: commit ? Boolean(git(\"status\", \"--porcelain\", \"--untracked-files=no\", \"--\", \".\", \":(exclude)cli/dist\")) : false,\n};\nfs.writeFileSync(buildInfoPath, JSON.stringify(info, null, 2) + \"\\n\");\n    PID STAT     ELAPSED\n3669407 Ss         03:32\n2026-10-28 14:44:03.312352379 +0000 63712\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a182ef-691b-71a3-bfbc-43ac959f5248","create_time":1793198646.814912}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
