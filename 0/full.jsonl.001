n previews only when descendants are ordinary nonignored filesystem entries and no tracked descendants exist; tracked descendants continue through the tracked-only validator\",\n      \"treat ENOENT and ENOTDIR during deletion cleanup as already absent paths\"\n    ],\n    \"regressions\": [\n      \"ordinary untracked child restore succeeds\",\n      \"staged and committed child restore test explicitly asserts success without ENOTDIR\",\n      \"ignored canary and nested .git obstruction tests assert staged index/content and HEAD unchanged\"\n    ],\n    \"verification\": \"git diff --check passed; no tests/builds/probes because SUITE remains active under kimi-main\",\n    \"review_disposition\": \"PENDING_FRESH_INDEPENDENT_REVIEW\"\n  },\n  \"remediation_round_4\": {\n    \"commit\": \"d880a388\",\n    \"finding\": \"existing committed-child test checkpointed a as untracked rather than a tracked Git blob\",\n    \"change\": \"added dedicated regression that commits a before checkpoint, then commits a/child and restores the tracked-blob checkpoint\",\n    \"acceptance\": \"restore succeeds without ENOTDIR; checkpoint blob content returns, child disappears, HEAD stays at post-checkpoint commit, and index tracks a\",\n    \"verification\": \"git diff --check passed; no tests/builds/probes because SUITE recorded active under kimi-main\",\n    \"review_disposition\": \"PENDING_FRESH_INDEPENDENT_REVIEW\"\n  },\n  \"released_at\": \"2026-10-28T09:55:37Z\",\n  \"released_to\": \"root coordinator for immutable suite-validation snapshot\",\n  \"independent_review_final\": {\n    \"disposition\": \"ACCEPT\",\n    \"head\": \"d880a3882512c8f3823200ce4be27dadd03d98d0\",\n    \"reported_by\": \"root coordinator\",\n    \"reviewer\": \"independent reviewer\",\n    \"comment\": \"PR #302 exact-head review accepted\",\n    \"tests_run\": \"not reported here\"\n  },\n  \"entire_gate_diagnostic\": {\n    \"check_run_id\": \"122811110603\",\n    \"external_id\": \"entire-gates:c45e34