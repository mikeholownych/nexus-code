{"parentUuid":"4d75846f-0378-4d2e-99d8-5b0135bbe19f","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PreToolUse:Bash","toolUseID":"toolu_01MLJi7jnv66KS41Gj51qsoP","hookEvent":"PreToolUse","content":"","stdout":"{}\n","stderr":"","exitCode":0,"command":"claude-mem hook claude-code file-context","durationMs":493},"type":"attachment","uuid":"fe763267-74d5-40dc-8db4-a9178e1f55a4","timestamp":"2026-11-24T14:46:45.725Z","session_id":"d25d0d24-8aed-4b03-a951-966dc54f0666","userType":"external","entrypoint":"cli","cwd":"/home/mike/nexus-code","sessionId":"43bcbb67-2cff-4fa8-a05e-f8aa598df73b","version":"2.1.329","gitBranch":"main","slug":"synthetic-moseying-seahorse","dataFlowOn":true}
{"parentUuid":"4d75846f-0378-4d2e-99d8-5b0135bbe19f","isSidechain":false,"promptId":"a6a580ba-bf20-439e-a180-58e9ad5c5dee","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MLJi7jnv66KS41Gj51qsoP","type":"tool_result","content":"    assert.deepEqual(clampSandboxNetwork(required, true, origin), {\n      allowed: false,\n      message: `${origin} is refused: managed policy forbids network access in the sandbox. [policy: system /fake/etc/nexus/policy.toml sandbox.forbid_network]`,\n      source: { tier: \"system\", file: SYS, key: \"sandbox.forbid_network\" },\n    });\n  }\n  assert.deepEqual(clampSandboxNetwork(required, false, \"default\"), { allowed: true, value: false, source: { tier: \"system\", file: SYS, key: \"sandbox.forbid_network\" } });\n  assert.deepEqual(clampSandboxNetwork(NONE, true, \"--sandbox-network\"), { allowed: true, value: true, source: { tier: \"default\", key: \"sandbox.forbid_network\" } });\n});\n\ntest(\"an MCP server outside mcp.allow is refused; a workspace server is refused under disable_workspace\", () => {\n  const policy = sys({ mcp: { allow: [\"github\", \"command:/usr/local/bin/mcp-files\", \"url:https://mcp.example.com\"], disable_workspace: true } });\n  const source = { tier: \"system\", file: SYS, key: \"mcp.allow\" };\n  assert.deepEqual(permitsMcpServer(policy, { name: \"shell\", command: \"/usr/bin/evil\", fromWorkspace: false }), {\n    allowed: false,\n    message: \"MCP server 'shell' is not started: it is not in the managed allowlist (mcp.allow). [policy: system /fake/etc/nexus/policy.toml mcp.allow]\",\n    source,\n  });\n  assert.ok(permitsMcpServer(policy, { name: \"github\", fromWorkspace: false }).allowed);\n  assert.ok(permitsMcpServer(policy, { name: \"anything\", command: \"/usr/local/bin/mcp-files\", fromWorkspace: false }).allowed);\n  assert.ok(permitsMcpServer(policy, { name: \"remote\", url: \"https://mcp.example.com/sse?x=1\", fromWorkspace: false }).allowed);\n  assert.ok(!permitsMcpServer(policy, { name: \"remote\", url: \"https://mcp.example.com.evil.test/sse\", fromWorkspace: false }).allowed);\n  assert.ok(!permitsMcpServer(policy, { name: \"remote\", url: \"http://mcp.example.com/sse\", fromWorkspace: false }).allowed, \"another scheme is another origin\");\n  assert.ok(!permitsMcpServer(policy, { name: \"remote\", url: \"not a url\", fromWorkspace: false }).allowed);\n  assert.ok(!permitsMcpServer(policy, { name: \"x\", command: \"/usr/local/bin/mcp-files-2\", fromWorkspace: false }).allowed);\nShell cwd was reset to /home/mike/nexus-code","is_error":false}]},"uuid":"79cc034d-ac59-4f89-a1be-efea0f0fe617","timestamp":"2026-11-24T14:46:45.969Z","toolUseResult":{"stdout":"    assert.deepEqual(clampSandboxNetwork(required, true, origin), {\n      allowed: false,\n      message: `${origin} is refused: managed policy forbids network access in the sandbox. [policy: system /fake/etc/nexus/policy.toml sandbox.forbid_network]`,\n      source: { tier: \"system\", file: SYS, key: \"sandbox.forbid_network\" },\n    });\n  }\n  assert.deepEqual(clampSandboxNetwork(required, false, \"default\"), { allowed: true, value: false, source: { tier: \"system\", file: SYS, key: \"sandbox.forbid_network\" } });\n  assert.deepEqual(clampSandboxNetwork(NONE, true, \"--sandbox-network\"), { allowed: true, value: true, source: { tier: \"default\", key: \"sandbox.forbid_network\" } });\n});\n\ntest(\"an MCP server outside mcp.allow is refused; a workspace server is refused under disable_workspace\", () => {\n  const policy = sys({ mcp: { allow: [\"github\", \"command:/usr/local/bin/mcp-files\", \"url:https://mcp.example.com\"], disable_workspace: true } });\n  const source = { tier: \"system\", file: SYS, key: \"mcp.allow\" };\n  assert.deepEqual(permitsMcpServer(policy, { name: \"shell\", command: \"/usr/bin/evil\", fromWorkspace: false }), {\n    allowed: false,\n    message: \"MCP server 'shell' is not started: it is not in the managed allowlist (mcp.allow). [policy: system /fake/etc/nexus/policy.toml mcp.allow]\",\n    source,\n  });\n  assert.ok(permitsMcpServer(policy, { name: \"github\", fromWorkspace: false }).allowed);\n  assert.ok(permitsMcpServer(policy, { name: \"anything\", command: \"/usr/local/bin/mcp-files\", fromWorkspace: false }).allowed);\n  assert.ok(permitsMcpServer(policy, { name: \"remote\", url: \"https://mcp.example.com/sse?x=1\", fromWorkspace: false }).allowed);\n  assert.ok(!permitsMcpServer(policy, { name: \"remote\", url: \"https://mcp.example.com.evil.test/sse\", fromWorkspace: false }).allowed);\n  assert.ok(!permitsMcpServer(policy, { name: \"remote\", url: \"http://mcp.example.com/sse\", fromWorkspace: false }).allowed, \"another scheme is another origin\");\n  assert.ok(!permitsMcpServer(policy, { name: \"remote\", url: \"not a url\", fromWorkspace: false }).allowed);\n  assert.ok(!permitsMcpServer(policy, { name: \"x\", command: \"/usr/local/bin/mcp-files-2\", fromWorkspace: false }).allowed);","stderr":"\nShell cwd was reset to /home/mike/nexus-code","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"4d75846f-0378-4d2e-99d8-5b0135bbe19f","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"d25d0d24-8aed-4b03-a951-966dc54f0666","userType":"external","entrypoint":"cli","cwd":"/home/mike/nexus-code","sessionId":"43bcbb67-2cff-4fa8-a05e-f8aa598df73b","version":"2.1.329","gitBranch":"main","slug":"synthetic-moseying-seahorse","dataFlowOn":true}
