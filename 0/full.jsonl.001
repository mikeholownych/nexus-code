{"timestamp":"2026-10-28T13:58:46.768Z","ordinal":458945,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0db389702a7164cc016ae1ff937f14819f87ab41078160082d","status":"completed","call_id":"call_4bb1b45fee314e2b9aaef6c833c2e245","name":"exec","input":"const patch = \"*** Begin Patch\\n*** Update File: /home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/test/checkpoint_restore.test.ts\\n@@\\n test(\\\"Git manifest restore refuses to copy an untracked file into a nested bare repository\\\", () => {\\n@@\\n });\\n+\\n+test(\\\"Git manifest restore allows an ordinary directory with bare-repository-like names\\\", () => {\\n+  const { repo, git } = gitRepo();\\n+  const lookalike = path.join(repo, \\\"ordinary-layout\\\");\\n+  try {\\n+    fs.mkdirSync(path.join(lookalike, \\\"objects\\\"), { recursive: true });\\n+    fs.mkdirSync(path.join(lookalike, \\\"refs\\\"), { recursive: true });\\n+    fs.writeFileSync(path.join(lookalike, \\\"HEAD\\\"), \\\"this is an ordinary project file\\\\n\\\");\\n+    fs.writeFileSync(path.join(lookalike, \\\"config\\\"), \\\"[core]\\\\nfilemode = true\\\\n\\\");\\n+    fs.writeFileSync(path.join(lookalike, \\\"captured.txt\\\"), \\\"checkpoint content\\\\n\\\");\\n+    const manager = new CheckpointManager(repo);\\n+    const checkpoint = manager.createCheckpoint(\\\"ordinary directory resembles a bare repository\\\");\\n+    fs.writeFileSync(path.join(lookalike, \\\"captured.txt\\\"), \\\"changed after checkpoint\\\\n\\\");\\n+    const headBefore = git(\\\"rev-parse\\\", \\\"HEAD\\\");\\n+\\n+    const result = manager.restore(checkpoint.id);\\n+\\n+    assert.equal(result.success, true, result.message);\\n+    assert.equal(fs.readFileSync(path.join(lookalike, \\\"captured.txt\\\"), \\\"utf8\\\"), \\\"checkpoint content\\\\n\\\");\\n+    assert.equal(git(\\\"rev-parse\\\", \\\"HEAD\\\"), headBefore);\\n+  } finally {\\n+    cleanupGitRepo(repo);\\n+  }\\n+});\\n \\n test(\\\"Git manifest restore refuses a tracked destination inside a nested repository before changing either index\\\", () => {\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a182b5-7df6-71b2-a955-13339511caaf","create_time":1793195923.4978209}}}
{"timestamp":"2026-10-28T13:58:46.804Z","ordinal":458946,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a182b5-7df6-71b2-a955-13339511caaf","item":{"type":"FileChange","id":"exec-60e78260-48ba-4778-92a7-8b862adb889d","changes":{"/home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/test/checkpoint_restore.test.ts":{"type":"update","unified_diff":"@@ -1077,2 +1077,26 @@\n \n+test(\"Git manifest restore allows an ordinary directory with bare-repository-like names\", () => {\n+  const { repo, git } = gitRepo();\n+  const lookalike = path.join(repo, \"ordinary-layout\");\n+  try {\n+    fs.mkdirSync(path.join(lookalike, \"objects\"), { recursive: true });\n+    fs.mkdirSync(path.join(lookalike, \"refs\"), { recursive: true });\n+    fs.writeFileSync(path.join(lookalike, \"HEAD\"), \"this is an ordinary project file\\n\");\n+    fs.writeFileSync(path.join(lookalike, \"config\"), \"[core]\\nfilemode = true\\n\");\n+    fs.writeFileSync(path.join(lookalike, \"captured.txt\"), \"checkpoint content\\n\");\n+    const manager = new CheckpointManager(repo);\n+    const checkpoint = manager.createCheckpoint(\"ordinary directory resembles a bare repository\");\n+    fs.writeFileSync(path.join(lookalike, \"captured.txt\"), \"changed after checkpoint\\n\");\n+    const headBefore = git(\"rev-parse\", \"HEAD\");\n+\n+    const result = manager.restore(checkpoint.id);\n+\n+    assert.equal(result.success, true, result.message);\n+    assert.equal(fs.readFileSync(path.join(lookalike, \"captured.txt\"), \"utf8\"), \"checkpoint content\\n\");\n+    assert.equal(git(\"rev-parse\", \"HEAD\"), headBefore);\n+  } finally {\n+    cleanupGitRepo(repo);\n+  }\n+});\n+\n test(\"Git manifest restore refuses a tracked destination inside a nested repository before changing either index\", () => {\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/test/checkpoint_restore.test.ts\n","stderr":""},"started_at_ms":1793195926802,"completed_at_ms":1793195926804}}
