nnection's request counting.\n   * Off by default: without it an unmeasured request proceeds on the labelled client estimate (provider_capabilities.ts).\n   */\n  strictTokenCount?: boolean;\n  sandbox?: boolean | string; // Linux namespace / bwrap / container isolation (default: false)\n  worktree?: boolean;        // Isolated ephemeral git worktree execution (default: false)\n  /** A diagnostic run works on a snapshot of a failing candidate: its diagnosis completes it, so no completion verifier runs. */\n  diagnosticRun?: boolean;\n  worktreeBranch?: string;   // Run in a named worktree for this branch instead of nexus/<task-id> (implies worktree; kept, never auto-merged)\n  authoritativeVerifierCommand?: string; // Explicit trusted verifier: gates every task completion and authorizes automatic worktree merge\n  /** Workspace-relative deliverable paths declared by the operator before the task starts. */\n  trustedDeliverableFiles?: string[];\n  typecheck?: \"off\" | \"record\" | \"enforce\"; // Type-check beside the verifier (default enforce; record with a configured verifier); env NEXUS_TYPECHECK=off|enforce\n  verifierTimeoutSecs?: number; // Deadline for the completion verifier (default 300); env NEXUS_VERIFIER_TIMEOUT_SECS\n  recordFlight?: boolean;    // Deterministic .flightlog session recording (default: false)\n  plannerModel?: string;     // Deep reasoning / architecture planner (e.g. Claude 3.7 Thinking / o3 / DeepSeek R1)\n  plannerEndpoint?: string;  // Dedicated endpoint for planner model\n  plannerApiKey?: string;    // API key for planner model\n  coderModel?: string;       // Ultra-fast surgical implementation model (e.g. Qwen 2.5 Coder 32B @ 150 tok/s)\n  coderEndpoint?: string;    // Dedicated endpoint for coder model\n  coderApiKey?: string;      // API key for coder model\n  tdd?: boolean;             // Enforce strict RED-GREEN-REFACTOR protocol\n  role?: \"researcher\" | \"architect\" | \"implementer\" | \"tester\" | \"reviewer\"; // Specialized agent role\n  provider?: string;         // Cloud provider id (see providers.ts); undefined = the appliance/endpoint path\n  plannerProvider?: string;  // Provider for the planner role; undefined inherits the rules in agent.ts\n  coderProvider?: string;    // Provider for the coder role\n  /** Origins the operator authorized to receive task content when they are cloud destinations. */\n  authorizedDisclosureOrigins?: string[];\n  /** Origins that look local but forward to a cloud service (treated as cloud disclosure). */\n  cloudRoutedOrigins?: string[];\n  /** Execution surface: 'repl', 'tui', or 'headless' (REQ-AGT-109a). */\n  surface?: \"repl\" | \"tui\" | \"headless\" | string;\n  reasoningEffort?: string;  // OpenAI Responses reasoning effort; enables owner-scoped reasoning replay\n  anthropicThinkingBudget?: number; // Anthropic extended-thinking budget tokens; enables signed thinking replay\n  /** Operator-owned defaults for durable operation scheduling; operation-spec policy values override these defaults. */\n  operationPolicy?: Partial<{\n    maxWaitMs: number;\n    unknownResumeBudget: number;\n    maxRunsPerUnit: number;\n    minWaitMs: number;\n  }>;\n  /** Execute one model/tool cycle and pause deterministically for operator confirmation (WP-1106). */\n  step?: boolean;\n}\n\nexport interface ExecutionResult {\n  success: boolean;\n  output: string;\n  error?: string;\n  /** The operation's deadline expired before an answer was received (bridge-level; the runner reports its own via `timed_out`). */\n  timedOut?: boolean;\n  /** The operator's cancel ended the operation (the runner ended the command's process group). */\n  cancelled?: boolean;\n  /** The request may have reached the executor, but no trustworthy result was received. */\n  outcomeUnknown?: boolean;\n  /** Why the call was refused before it ran (a stable code, e.g. VERIFICATION_CONFIG_PROTECTED). */\n  denialReason?: string;\n}\n\n/**\n * Bounds for automatically continued work. The total-step limit is cumulative across every invocation that continues\n * the same durable objective; the wall-clock limit bounds one active invocation. Progress detection remains a separate\n * early-stop mechanism, not a substitute for these hard ceilings.\n */\nexport interface Continuatio…634 tokens truncated… (see ContinuationBudget). */\nexport const DEFAULT_CONVERGENCE_ATTEMPTS = 3;\n\nexport const DEFAULT_CONTINUATION: ContinuationBudget = {\n  maxTotalSteps: 500,\n  maxToolInvocations: DEFAULT_MAX_TOOL_INVOCATIONS,\n  maxTurnMinutes: 480,\n  stagnationSteps: 12,\n  maxRecoveries: 2,\n  maxCompletionNudges: 2,\n};\n\nexport type ApprovalMode = \"auto\" | \"review\" | \"read-only\";\n  return Object.keys(policy).length ? policy : undefined;\n}\n\n/**\n * Continuation budgets: flags, then NEXUS_MAX_TOTAL_STEPS / NEXUS_MAX_TURN_MINUTES / NEXUS_STAGNATION_STEPS, then\n * finite defaults. Total steps are charged to the durable objective ledger, so resume does not reset them.\n * `--no-continuation` (or NEXUS_CONTINUATION=0) is the operator's explicit choice of the single-segment turn that\n * ends at --max-steps.\n */\nexport function continuationBudget(options: any): ContinuationBudget | undefined {\n  if (options.continuation === false || effectiveSetting(\"NEXUS_CONTINUATION\") === \"0\") return undefined;\n  const positive = (flag: unknown, env: string | undefined, fallback: number, maximum = Number.POSITIVE_INFINITY): number => {\n    for (const raw of [flag, env]) {\n      if (raw === undefined || raw === null || raw === \"\") continue;\n      const value = Number(raw);\n      if (!Number.isFinite(value) || value <= 0) throw new Error(`Invalid continuation budget '${String(raw)}': expected a positive number.`);\n      if (value > maximum) throw new Error(`Invalid continuation budget '${String(raw)}': maximum is ${maximum}.`);\n      return value;\n    }\n    return fallback;\n  };\n  const steps = positive(options.maxTotalSteps, effectiveSetting(\"NEXUS_MAX_TOTAL_STEPS\"), DEFAULT_CONTINUATION.maxTotalSteps, MAX_CONTINUATION_STEPS);\n  return {\n    ...DEFAULT_CONTINUATION,\n    maxTotalSteps: Number.isFinite(steps) ? Math.floor(steps) : steps,\n    maxToolInvocations: toolInvocationLimit(options),\n    maxTurnMinutes: positive(options.maxTurnMinutes, effectiveSetting(\"NEXUS_MAX_TURN_MINUTES\"), DEFAULT_CONTINUATION.maxTurnMinutes, MAX_CONTINUATION_MINUTES),\n    stagnationSteps: Math.floor(positive(options.stagnationSteps, effectiveSetting(\"NEXUS_STAGNATION_STEPS\"), DEFAULT_CONTINUATION.stagnationSteps)),\n    verifierConvergenceAttempts: Math.floor(positive(undefined, effectiveSetting(\"NEXUS_VERIFIER_CONVERGENCE_ATTEMPTS\"), DEFAULT_CONVERGENCE_ATTEMPTS)),\n  };\n}\n\n/** Objective-wide tool dispatch ceiling. It remains active when automatic continuation is disabled. */\nexport function toolInvocationLimit(options: any): number {\n  const raw = options.maxToolInvocations ?? effectiveSetting(\"NEXUS_MAX_TOOL_INVOCATIONS\");\n  if (raw === undefined || raw === null || raw === \"\") return DEFAULT_MAX_TOOL_INVOCATIONS;\n  const value = Number(raw);\n  if (!Number.isSafeInteger(value) || value < 1) throw new Error(`Invalid tool invocation budget '${String(raw)}': expected a positive integer.`);\n  if (value > MAX_TOOL_INVOCATIONS) throw new Error(`Invalid tool invocation budget '${String(raw)}': maximum is ${MAX_TOOL_INVOCATIONS}.`);\n  return value;\n}\n\n/** Repeated-call thresholds: the operator's values, which a project `.env` may only lower. */\nexport function repeatedCallSettings() {\n  return resolveRepeatedCallSettings(\n    { soft: operatorSetting(\"NEXUS_REPEATED_CALL_SOFT\"), hard: operatorSetting(\"NEXUS_REPEATED_CALL_HARD\") },\n      },\n      (text) => safeOperatorText(text),\n    );\n  }\n\n  let currentStep = 1;\n  let stepsUsed = 0;\n  const providerRecoveries: ProviderRecoveryRecord[] = [];\n  const budget = this.config.continuation;\n  const segmentSteps = Math.max(1, this.config.maxSteps);\n  const maxTotalSteps = budget ? budget.maxTotalSteps : segmentSteps;\n  let segment = 1;\n  const tracker = this.objective && this.durable ? trackingOf(this.objective) : ExecutionTracker.fresh();\n  const configuredToolLimit = this.config.maxToolInvocations ?? budget?.maxToolInvocations ?? DEFAULT_MAX_TOOL_INVOCATIONS;\n  if (!Number.isSafeInteger(configuredToolLimit) || configuredToolLimit < 1 || configuredToolLimit > MAX_TOOL_INVOCATIONS) {\n    throw new Error(`Invalid tool invocation budget: expected an integer from 1 to ${MAX_TOOL_INVOCATIONS}.`);\n  }\n  let maxToolInvocations = configuredToolLimit;\n  if (this.objective) {\n    const storedLimit = this.objective.continuation.maxToolInvocations;\n    if (storedLimit !== undefined && (!Number.isSafeInteger(storedLimit) || storedLimit < 1 || storedLimit > MAX_TOOL_INVOCATIONS)) {\n      throw new Error(\"Persisted objective tool invocation budget is invalid; refusing to dispatch tools.\");\n    }\n    maxToolInvocations = storedLimit === undefined ? configuredToolLimit : Math.min(storedLimit, configuredToolLimit);\n    this.objective.continuation.maxToolInvocations = maxToolInvocations;\n  }\n\n  try {\n    if (this.flightRecorder) {\n      if (!this.flightRecorder.isSessionActive()) {\n        this.flightRecorder.startSession({\n          model: this.config.model,\n          endpoint: this.config.endpoint,\n          taskPrompt: promptText,\n        });\n      }\n"},{"type":"input_text","text":"origin\thttps://github.com/mikeholownych/nexus-code.git (fetch)\norigin\tgit@github.com:mikeholownych/nexus-code.git (push)\n[]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","create_time":1795302014.775207}},"metadata":{"history_sequence":16763,"sampled_through_sequence":16758,"client_authored":false,"fallback_token_limit_override":12000}}
