est on immutable snapshot; isolated HOME; no gateway inference\"}\\n' \"$expected_head\" \"$(date -u +%FT%TZ)\" \"$$\" \"$snapshot\" > \"$claim/owner.json\" printf '%s\\n' \"$(date -u +%FT%TZ) CLAIM SUITE PR302 exact-head full make test; snapshot=$snapshot; isolated_HOME=$isolated_home; pid=$$\" >> \"$claims/../nexus-claims.log\" cd \"$snapshot\" set +e env HOME=\"$isolated_home\" XDG_CONFIG_HOME=\"$isolated_home/.config\" XDG_CACHE_HOME=\"$isolated_home/.cache\" XDG_DATA_HOME=\"$isolated_home/.local/share\" XDG_STATE_HOME=\"$isolated_home/.local/state\" XDG_RUNTIME_DIR=\"$isolated_home/.runtime\" CARGO_HOME=/home/mike/.cargo RUSTUP_HOME=/home/mike/.rustup CARGO_NET_OFFLINE=true make test > \"$run_root/make-test.log\" 2>&1 test_status=$? set -e printf '%s\\n' \"$(date -u +%FT%TZ) PR302_EXACT_HEAD_MAKE_TEST head=$expected_head exit=$test_status logs=$run_root\" >> \"$claims/../nexus-claims.log\" if [ -d \"$claim\" ]; then rm \"$claim/owner.json\"; rmdir \"$claim\"; fi printf 'RUN_ROOT=%s\\nMAKE_TEST_EXIT=%s\\n' \"$run_root\" \"$test_status\" tail -n 40 \"$run_root/make-test.log\" if [ \"$test_status\" -ne 0 ]; then exit 1; fi\n    PID    PPID STAT     ELAPSED                  STARTED COMMAND\n cli/src/checkpoint.ts               | 5 +++++\n cli/test/checkpoint_restore.test.ts | 3 +++\n 2 files changed, 8 insertions(+)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a182ef-691b-71a3-bfbc-43ac959f5248","create_time":1793198135.4100902}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
