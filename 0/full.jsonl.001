{"timestamp":"2026-10-28T16:47:24.218Z","ordinal":464856,"type":"token_usage_record","payload":{"thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18366-2421-7770-adb2-8a0eb3a8a68d","session_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","root_turn_id":"01a18366-2421-7770-adb2-8a0eb3a8a68d","response_id":"resp_0db389702a7164cc016ae227131144819fb298808faf116643","usage":{"input_tokens":140187,"cached_input_tokens":137728,"cache_write_input_tokens":0,"output_tokens":951,"reasoning_output_tokens":844,"total_tokens":141138},"turn_token_usage":{"input_tokens":1866676,"cached_input_tokens":1819904,"cache_write_input_tokens":0,"output_tokens":10514,"reasoning_output_tokens":8385,"total_tokens":1877190},"thread_token_usage":{"input_tokens":8630946888,"cached_input_tokens":8538811264,"cache_write_input_tokens":0,"output_tokens":24640465,"reasoning_output_tokens":14278978,"total_tokens":8655587353}}}
{"timestamp":"2026-10-28T16:47:26.458Z","ordinal":464857,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18366-2421-7770-adb2-8a0eb3a8a68d","item":{"type":"CommandExecution","id":"exec-740191e0-705e-4961-8f1a-d226e067c61a","process_id":"22603","command":["/usr/bin/zsh","-lc","sed -n '780,875p' cli/src/checkpoint.ts; sed -n '170,230p' cli/test/checkpoint_restore.test.ts; sed -n '450,620p' cli/test/checkpoint_restore.test.ts"],"cwd":"file:///home/mike/nexus-wt/checkpoint-ordinary-child-fix","parsed_cmd":[{"type":"read","cmd":"sed -n '780,875p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"read","cmd":"sed -n '170,230p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"},{"type":"read","cmd":"sed -n '450,620p' cli/test/checkpoint_restore.test.ts","name":"checkpoint_restore.test.ts","path":"cli/test/checkpoint_restore.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    if (diskEntries.length !== tracked.size || diskEntries.some((entry) => !tracked.has(entry))) return false;\n\n    for (const entry of diskEntries) {\n      try {\n        execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", entry], {\n          cwd: this.workspace,\n          stdio: \"ignore\",\n        });\n        return false;\n      } catch (error) {\n        if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n      }\n    }\n    return true;\n  }\n\n  private removeNonSnapshotEntries(snapshotFiles: string[]): void {\n    const retained = new Set(snapshotFiles);\n    const ignored = new Set([\"node_modules\", \".git\", \"target\", \"dist\", \".nexus\", \".next\", \".cache\"]);\n    const visit = (directory: string, relative: string): void => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        if (ignored.has(entry.name)) continue;\n        const entryPath = relative ? `${relative}/${entry.name}` : entry.name;\n        const fullPath = path.join(directory, entry.name);\n        if (entry.isDirectory()) {\n          visit(fullPath, entryPath);\n          if (fs.readdirSync(fullPath).length === 0 && ![...retained].some((file) => file.startsWith(entryPath + \"/\"))) {\n            fs.rmdirSync(fullPath);\n          }\n        } else if ((entry.isFile() || entry.isSymbolicLink()) && !retained.has(entryPath)) {\n          fs.rmSync(fullPath, { force: true });\n        }\n      }\n    };\n    visit(this.workspace, \"\");\n  }\n\n  public createCheckpoint(name?: string, options: { allowSensitive?: boolean } = {}): CheckpointInfo {\n    const allowSensitive = options.allowSensitive === true;\n    const rand = Math.random().toString(36).slice(2, 6);\n    const id = `cp_${Date.now()}_${rand}`;\n    const desc = redactForPersistence(name || `Checkpoint at ${new Date().toLocaleTimeString()}`);\n    const timestamp = new Date().toISOString();\n\n    let gitRef: string | undefined;\n    let snapshotDir: string | undefined;\n    let untrackedPaths: string[] = [];\n\n    if (this.isGit) {\n      try {\n        this.assertGitIndexUnlocked();\n        this.assertGitChangesSafe(allowSensitive);\n        untrackedPaths = this.gitUntrackedPaths();\n        this.assertUntrackedEntriesSafe(untrackedPaths, this.workspace, allowSensitive);\n        // Create an untracked + tracked git stash commit without modifying working tree\n        // Clean/smudge filter drivers (filter.* selected through .gitattributes) can still run external\n        // programs here and during restore; Git offers no single override for them, and refusing to\n        // checkpoint whenever a filter is configured would break Git LFS. Recorded as a known limitation\n        // in docs/reviews/evidence/v1/DEFECT-CHECKPOINT-GIT-HOOKS-20261026/README.md.\n        // Config-declared hooks (Git 2.54+) ignore core.hooksPath; disable the events these\n        // commands can raise while keeping traditional hooks off with the argv override.\n        const hookGuardEnv = envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\", \"post-index-change\"]);\n        const stashCommit = execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"stash\", \"create\"], { cwd: this.workspace, encoding: \"utf-8\", env: hookGuardEnv }).trim();\n        if (stashCommit) {\n          // Catch a Git operation that began during validation or stash creation.\n          // This is a point-in-time guard; Git exposes no atomic lock spanning\n          // stash creation and publication of this separate checkpoint ref.\n          this.assertGitIndexUnlocked();\n          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", `refs/nexus/checkpoints/${id}`, stashCommit], {\n            cwd: this.workspace,\n            stdio: \"ignore\",\n            env: hookGuardEnv,\n          });\n          gitRef = stashCommit;\n        } else {\n          // Working tree was clean; record HEAD\n          const headCommit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: this.workspace, encoding: \"utf-8\" }).trim();\n          this.assertGitIndexUnlocked();\n          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", `refs/nexus/checkpoints/${id}`, headCommit], {\n            cwd: this.workspace,\n            stdio: \"ignore\",\n            env: hookGuardEnv,\n          });\n          gitRef = headCommit;\n        }\n      } catch (error) {\n        if (\n          error instanceof SensitivePersistenceError ||\n          error instanceof GitIndexLockError ||\n          error instanceof GitIndexLockCheckError\n        ) throw error;\n        if (this.gitIndexLockExists()) throw new GitIndexLockError();\n        throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n      }\n    }\n\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked snapshot/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"current work must survive\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"restore preserves untracked symlinks without copying their external targets\", () => {\n  const { repo } = gitRepo();\n  const external = path.join(os.tmpdir(), `${path.basename(repo)}-external.txt`);\n  const manager = new CheckpointManager(repo);\n  try {\n    fs.writeFileSync(external, \"external target must not be copied\\n\");\n    fs.symlinkSync(external, path.join(repo, \"draft-link.txt\"));\n    const checkpoint = manager.createCheckpoint(\"symbolic link\");\n    fs.rmSync(path.join(repo, \"draft-link.txt\"));\n    fs.writeFileSync(path.join(repo, \"draft-link.txt\"), \"later regular file\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.lstatSync(path.join(repo, \"draft-link.txt\")).isSymbolicLink(), true);\n    assert.equal(fs.readlinkSync(path.join(repo, \"draft-link.txt\")), external);\n    assert.equal(fs.lstatSync(path.join(checkpoint.snapshotDir!, \"draft-link.txt\")).isSymbolicLink(), true);\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    cleanupGitRepo(repo);\n    fs.rmSync(external, { force: true });\n  }\n});\n\ntest(\"legacy restore removes tracked files deleted at the checkpoint\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.rmSync(path.join(repo, \"tracked.txt\"));\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy tracked deletion\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"recreated later\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    assert.equal(fs.existsSync(path.join(repo, \"tracked.txt\")), false);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"a checkpoint manifest cannot write into Git metadata\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    const head = git(\"rev-parse\", \"HEAD\");\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"ordinary snapshot\\n\");\n\ntest(\"non-Git restore refuses an incomplete snapshot before changing the workspace\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-partial-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"captured\\n\");\n    fs.writeFileSync(path.join(workspace, \"b.txt\"), \"also captured\\n\");\n    const checkpoint = manager.createCheckpoint(\"partial non-Git snapshot\");\n    fs.rmSync(path.join(checkpoint.snapshotDir!, \"a.txt\"));\n    fs.writeFileSync(path.join(workspace, \"b.txt\"), \"current work must survive\\n\");\n    const result = manager.restore(checkpoint.id);\n    assert.equal(result.success, false);\n    assert.match(result.message, /snapshot/i);\n    assert.equal(fs.readFileSync(path.join(workspace, \"b.txt\"), \"utf8\"), \"current work must survive\\n\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"non-Git restore preserves symlinks without copying external targets\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-link-\"));\n  const external = path.join(os.tmpdir(), `${path.basename(workspace)}-external.txt`);\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(external, \"external target\\n\");\n    fs.symlinkSync(external, path.join(workspace, \"link.txt\"));\n    const checkpoint = manager.createCheckpoint(\"non-Git symlink\");\n    fs.rmSync(path.join(workspace, \"link.txt\"));\n    const result = manager.restore(checkpoint.id);\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.lstatSync(path.join(workspace, \"link.txt\")).isSymbolicLink(), true);\n    assert.equal(fs.readlinkSync(path.join(workspace, \"link.txt\")), external);\n    assert.equal(fs.lstatSync(path.join(checkpoint.snapshotDir!, \"link.txt\")).isSymbolicLink(), true);\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n    fs.rmSync(external, { force: true });\n  }\n});\n\ntest(\"legacy non-Git restore never deletes entries absent from old metadata\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-legacy-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"captured\\n\");\n    const checkpoint = manager.createCheckpoint(\"legacy non-Git snapshot\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    fs.writeFileSync(path.join(workspace, \"b.txt\"), \"must survive legacy restore\\n\");\n    const result = manager.restore(checkpoint.id);\n    assert.equal(result.success, true, result.message);\n    assert.match(result.message, /legacy/i);\n    assert.equal(fs.readFileSync(path.join(workspace, \"b.txt\"), \"utf8\"), \"must survive legacy restore\\n\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"non-Git restore refuses an unsafe destination parent before copying\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-destination-\"));\n  const external = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-external-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.mkdirSync(path.join(workspace, \"alias\"));\n    fs.writeFileSync(path.join(workspace, \"alias\", \"file.txt\"), \"captured\\n\");\n    const checkpoint = manager.createCheckpoint(\"unsafe non-Git destination\");\n    fs.rmSync(path.join(workspace, \"alias\"), { recursive: true });\n    fs.symlinkSync(external, path.join(workspace, \"alias\"));\n    fs.writeFileSync(path.join(external, \"file.txt\"), \"external canary\\n\");\n    const result = manager.restore(checkpoint.id);\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe/i);\n    assert.equal(fs.readFileSync(path.join(external, \"file.txt\"), \"utf8\"), \"external canary\\n\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n    fs.rmSync(external, { recursive: true, force: true });\n  }\n});\n\ntest(\"non-Git checkpoint rejects sensitive nested filename components\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-sensitive-name-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.mkdirSync(path.join(workspace, \"dir\"));\n    fs.writeFileSync(path.join(workspace, \"dir\", \"API_KEY=REDACTED, \"ordinary content\\n\");\n\n    assert.throws(() => manager.createCheckpoint(\"sensitive nested name\"), SensitivePersistenceError);\n    assert.equal(manager.listCheckpoints().length, 0);\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"checkpoint rejects sensitive symlink-target components\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-sensitive-link-target-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.symlinkSync(\"dir/API_KEY=REDACTED, path.join(workspace, \"link.txt\"));\n\n    assert.throws(() => manager.createCheckpoint(\"sensitive link target\"), SensitivePersistenceError);\n    assert.equal(manager.listCheckpoints().length, 0);\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"legacy non-Git restore refuses a destination parent symlink before copying\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-legacy-destination-\"));\n  const external = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-legacy-external-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.mkdirSync(path.join(workspace, \"alias\"));\n    fs.writeFileSync(path.join(workspace, \"alias\", \"file.txt\"), \"captured\\n\");\n    const checkpoint = manager.createCheckpoint(\"legacy non-Git destination\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    fs.rmSync(path.join(workspace, \"alias\"), { recursive: true });\n    fs.symlinkSync(external, path.join(workspace, \"alias\"));\n    fs.writeFileSync(path.join(workspace, \"workspace.txt\"), \"workspace canary\\n\");\n    fs.writeFileSync(path.join(external, \"file.txt\"), \"external canary\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /destination|unsafe/i);\n    assert.equal(fs.readFileSync(path.join(external, \"file.txt\"), \"utf8\"), \"external canary\\n\");\n    assert.equal(fs.readFileSync(path.join(workspace, \"workspace.txt\"), \"utf8\"), \"workspace canary\\n\");\n    assert.equal(fs.readlinkSync(path.join(workspace, \"alias\")), external);\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n    fs.rmSync(external, { recursive: true, force: true });\n  }\n});\n\ntest(\"Git checkpoint rejects sensitive tracked nested filename components without writing a ref\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.mkdirSync(path.join(repo, \"dir\"));\n    fs.writeFileSync(path.join(repo, \"dir\", \"API_KEY=REDACTED, \"ordinary content\\n\");\n    git(\"add\", \"dir/API_KEY=REDACTED;\n    const manager = new CheckpointManager(repo);\n\n    assert.throws(() => manager.createCheckpoint(\"sensitive tracked name\"), SensitivePersistenceError);\n    assert.equal(manager.listCheckpoints().length, 0);\n    assert.equal(git(\"for-each-ref\", \"--format=%(refname)\", \"refs/nexus/checkpoints\"), \"\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"Git checkpoint rejects sensitive index symlink-target components without writing a ref\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.symlinkSync(\"dir/API_KEY=REDACTED, path.join(repo, \"link.txt\"));\n    git(\"add\", \"link.txt\");\n    fs.unlinkSync(path.join(repo, \"link.txt\"));\n    fs.symlinkSync(\"ordinary-target\", path.join(repo, \"link.txt\"));\n    const manager = new CheckpointManager(repo);\n\n    assert.throws(() => manager.createCheckpoint(\"sensitive index link\"), SensitivePersistenceError);\n    assert.equal(manager.listCheckpoints().length, 0);\n","exit_code":0,"duration":{"secs":0,"nanos":929973440}},"started_at_ms":1793206045527,"completed_at_ms":1793206046458}}
{"timestamp":"2026-10-28T16:47:27.720Z","ordinal":464858,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18368-d3e8-7a40-9441-de09eecf32c7","call_id":"call_e1c940e26dfc465594a4bfdf905c8ac5","output":[{"type":"input_text","text":"Script completed\nWall time 3.5 seconds\nOutput:\n"},{"type":"input_text","text":"    if (diskEntries.length !== tracked.size || diskEntries.some((entry) => !tracked.has(entry))) return false;\n\n    for (const entry of diskEntries) {\n      try {\n        execFileSync(\"git\", [\"-c\", \"core.fsmonitor=false\", \"check-ignore\", \"--no-index\", \"-q\", \"--\", entry], {\n          cwd: this.workspace,\n          stdio: \"ignore\",\n        });\n        return false;\n      } catch (error) {\n        if ((error as NodeJS.ErrnoException & { status?: number })?.status !== 1) return false;\n      }\n    }\n    return true;\n  }\n\n  private removeNonSnapshotEntries(snapshotFiles: string[]): void {\n    const retained = new Set(snapshotFiles);\n    const ignored = new Set([\"node_modules\", \".git\", \"target\", \"dist\", \".nexus\", \".next\", \".cache\"]);\n    const visit = (directory: string, relative: string): void => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        if (ignored.has(entry.name)) continue;\n        const entryPath = relative ? `${relative}/${entry.name}` : entry.name;\n        const fullPath = path.join(directory, entry.name);\n        if (entry.isDirectory()) {\n          visit(fullPath, entryPath);\n          if (fs.readdirSync(fullPath).length === 0 && ![...retained].some((file) => file.startsWith(entryPath + \"/\"))) {\n            fs.rmdirSync(fullPath);\n          }\n        } else if ((entry.isFile() || entry.isSymbolicLink()) && !retained.has(entryPath)) {\n          fs.rmSync(fullPath, { force: true });\n        }\n      }\n    };\n    visit(this.workspace, \"\");\n  }\n\n  public createCheckpoint(name?: string, options: { allowSensitive?: boolean } = {}): CheckpointInfo {\n    const allowSensitive = options.allowSensitive === true;\n    const rand = Math.random().toString(36).slice(2, 6);\n    const id = `cp_${Date.now()}_${rand}`;\n    const desc = redactForPersistence(name || `Checkpoint at ${new Date().toLocaleTimeString()}`);\n    const timestamp = new Date().toISOString();\n\n    let gitRef: string | undefined;\n    let snapshotDir: string | undefined;\n    let untrackedPaths: string[] = [];\n\n    if (this.isGit) {\n      try {\n        this.assertGitIndexUnlocked();\n        this.assertGitChangesSafe(allowSensitive);\n        untrackedPaths = this.gitUntrackedPaths();\n        this.assertUntrackedEntriesSafe(untrackedPaths, this.workspace, allowSensitive);\n        // Create an untracked + tracked git stash commit without modifying working tree\n        // Clean/smudge filter drivers (filter.* selected through .gitattributes) can still run external\n        // programs here and during restore; Git offers no single override for them, and refusing to\n        // checkpoint whenever a filter is configured would break Git LFS. Recorded as a known limitation\n        // in docs/reviews/evidence/v1/DEFECT-CHECKPOINT-GIT-HOOKS-20261026/README.md.\n        // Config-declared hooks (Git 2.54+) ignore core.hooksPath; disable the events these\n        // commands can raise while keeping traditional hooks off with the argv override.\n        const hookGuardEnv = envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\", \"post-index-change\"]);\n        const stashCommit = execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"-c\", \"core.fsmonitor=false\", \"stash\", \"create\"], { cwd: this.workspace, encoding: \"utf-8\", env: hookGuardEnv }).trim();\n        if (stashCommit) {\n          // Catch a Git operation that began during validation or stash creation.\n          // This is a point-in-time guard; Git exposes no atomic lock spanning\n          // stash creation and publication of this separate checkpoint ref.\n          this.assertGitIndexUnlocked();\n          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", `refs/nexus/checkpoints/${id}`, stashCommit], {\n            cwd: this.workspace,\n            stdio: \"ignore\",\n            env: hookGuardEnv,\n          });\n          gitRef = stashCommit;\n        } else {\n          // Working tree was clean; record HEAD\n          const headCommit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: this.workspace, encoding: \"utf-8\" }).trim();\n          this.assertGitIndexUnlocked();\n          execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", `refs/nexus/checkpoints/${id}`, headCommit], {\n            cwd: this.workspace,\n            stdio: \"ignore\",\n            env: hookGuardEnv,\n          });\n          gitRef = headCommit;\n        }\n      } catch (error) {\n        if (\n          error instanceof SensitivePersistenceError ||\n          error instanceof GitIndexLockError ||\n          error instanceof GitIndexLockCheckError\n        ) throw error;\n        if (this.gitIndexLockExists()) throw new GitIndexLockError();\n        throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n      }\n    }\n\n\n    assert.equal(result.success, false);\n    assert.match(result.message, /untracked snapshot/i);\n    assert.equal(fs.readFileSync(path.join(repo, \"draft.txt\"), \"utf8\"), \"current work must survive\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"restore preserves untracked symlinks without copying their external targets\", () => {\n  const { repo } = gitRepo();\n  const external = path.join(os.tmpdir(), `${path.basename(repo)}-external.txt`);\n  const manager = new CheckpointManager(repo);\n  try {\n    fs.writeFileSync(external, \"external target must not be copied\\n\");\n    fs.symlinkSync(external, path.join(repo, \"draft-link.txt\"));\n    const checkpoint = manager.createCheckpoint(\"symbolic link\");\n    fs.rmSync(path.join(repo, \"draft-link.txt\"));\n    fs.writeFileSync(path.join(repo, \"draft-link.txt\"), \"later regular file\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.lstatSync(path.join(repo, \"draft-link.txt\")).isSymbolicLink(), true);\n    assert.equal(fs.readlinkSync(path.join(repo, \"draft-link.txt\")), external);\n    assert.equal(fs.lstatSync(path.join(checkpoint.snapshotDir!, \"draft-link.txt\")).isSymbolicLink(), true);\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    cleanupGitRepo(repo);\n    fs.rmSync(external, { force: true });\n  }\n});\n\ntest(\"legacy restore removes tracked files deleted at the checkpoint\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.rmSync(path.join(repo, \"tracked.txt\"));\n    const head = git(\"rev-parse\", \"HEAD\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"legacy tracked deletion\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    fs.writeFileSync(path.join(repo, \"tracked.txt\"), \"recreated later\\n\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(git(\"rev-parse\", \"HEAD\"), head);\n    assert.equal(fs.existsSync(path.join(repo, \"tracked.txt\")), false);\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"a checkpoint manifest cannot write into Git metadata\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    const head = git(\"rev-parse\", \"HEAD\");\n    fs.writeFileSync(path.join(repo, \"draft.txt\"), \"ordinary snapshot\\n\");\n\ntest(\"non-Git restore refuses an incomplete snapshot before changing the workspace\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-partial-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"captured\\n\");\n    fs.writeFileSync(path.join(workspace, \"b.txt\"), \"also captured\\n\");\n    const checkpoint = manager.createCheckpoint(\"partial non-Git snapshot\");\n    fs.rmSync(path.join(checkpoint.snapshotDir!, \"a.txt\"));\n    fs.writeFileSync(path.join(workspace, \"b.txt\"), \"current work must survive\\n\");\n    const result = manager.restore(checkpoint.id);\n    assert.equal(result.success, false);\n    assert.match(result.message, /snapshot/i);\n    assert.equal(fs.readFileSync(path.join(workspace, \"b.txt\"), \"utf8\"), \"current work must survive\\n\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"non-Git restore preserves symlinks without copying external targets\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-link-\"));\n  const external = path.join(os.tmpdir(), `${path.basename(workspace)}-external.txt`);\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(external, \"external target\\n\");\n    fs.symlinkSync(external, path.join(workspace, \"link.txt\"));\n    const checkpoint = manager.createCheckpoint(\"non-Git symlink\");\n    fs.rmSync(path.join(workspace, \"link.txt\"));\n    const result = manager.restore(checkpoint.id);\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.lstatSync(path.join(workspace, \"link.txt\")).isSymbolicLink(), true);\n    assert.equal(fs.readlinkSync(path.join(workspace, \"link.txt\")), external);\n    assert.equal(fs.lstatSync(path.join(checkpoint.snapshotDir!, \"link.txt\")).isSymbolicLink(), true);\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n    fs.rmSync(external, { force: true });\n  }\n});\n\ntest(\"legacy non-Git restore never deletes entries absent from old metadata\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-legacy-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.writeFileSync(path.join(workspace, \"a.txt\"), \"captured\\n\");\n    const checkpoint = manager.createCheckpoint(\"legacy non-Git snapshot\");\n    const recordPath = path.join(manager.getCheckpointDir(), `${checkpoint.id}.json`);\n    const record = JSON.parse(fs.readFileSync(recordPath, \"utf8\"));\n    delete record.untrackedFiles;\n    fs.writeFileSync(recordPath, JSON.stringify(record));\n    fs.writeFileSync(path.join(workspace, \"b.txt\"), \"must survive legacy restore\\n\");\n    const result = manager.restore(checkpoint.id);\n    assert.equal(result.success, true, result.message);\n    assert.match(result.message, /legacy/i);\n    assert.equal(fs.readFileSync(path.join(workspace, \"b.txt\"), \"utf8\"), \"must survive legacy restore\\n\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    fs.rmSync(workspace, { recursive: true, force: true });\n  }\n});\n\ntest(\"non-Git restore refuses an unsafe destination parent before copying\", () => {\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-destination-\"));\n  const external = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-non-git-external-\"));\n  const manager = new CheckpointManager(workspace);\n  try {\n    fs.mkdirSync(path.join(workspace, \"alias\"));\n    fs.writeFileSync(path.join(workspace, \"alias\", \"file.txt\"), \"captured\\n\");\n    const checkpoint = manager.createCheckpoint(\"unsafe non-Git destination\");\n    fs.rmSync(path.join(workspace, \"alias\"), { recur