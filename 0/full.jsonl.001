Git restore refuses an untracked checkout collision before overwriting it\n1376-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7612454Z ok 97 - legacy Git restore refuses an untracked checkout collision before overwriting it\n1377-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7612836Z   ---\n1378-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7613052Z   duration_ms: 76.589888\n1379-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7613282Z   type: 'test'\n--\n1466:test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7681808Z not ok 112 - Git restore rejects nested bare repository config FIFOs and external FIFO includes without hanging\n1467-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7682254Z   ---\n1468-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7682458Z   duration_ms: 168.494801\n1469-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7682688Z   type: 'test'\n1470-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7683188Z   location: '/home/runner/work/nexus-code/nexus-code/cli/test/checkpoint_restore.test.ts:1240:1'\n1471-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7683858Z   failureType: 'testCodeFailure'\n1472-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7684116Z   error: |-\n1473-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7684566Z     The input did not match the regular expression /nested Git repository/i. Input:\n1474-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7685293Z     \n1475-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7686288Z     \"Rollback failed: checkpoint 'cp_1793206270332_b2gi' has an unsafe untracked snapshot or destination; workspace was not changed\\n\"\n1476-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7687260Z     \n1477-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7687513Z   code: 'ERR_ASSERTION'\n1478-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7687769Z   name: 'AssertionError'\n1479-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7688007Z   expected:\n1480-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7688464Z   actual: |-\n1481-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7689684Z     Rollback failed: checkpoint 'cp_1793206270332_b2gi' has an unsafe untracked snapshot or destination; workspace was not changed\n1482-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7690452Z     \n1483-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7690856Z   operator: 'match'\n1484-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7691315Z   stack: |-\n1485-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7692125Z     TestContext.<anonymous> (/home/runner/work/nexus-code/nexus-code/cli/test/checkpoint_restore.test.ts:1270:12)\n1486-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7692901Z     Test.runInAsyncScope (node:async_hooks:214:14)\n1487-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7693722Z     Test.run (node:internal/test_runner/test:1047:25)\n1488-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7694561Z     async Test.processPendingSubtests (node:internal/test_runner/test:744:7)\n1489-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7725359Z   ...\n1490-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7726286Z # Subtest: Git manifest restore refuses an exact nested Git directory with core.bare=false\n1491-test-matrix (22)\tRun npm --prefix cli test\t2026-10-28T16:51:11.7727777Z ok 113 - Git manifest restore refuses an exact nested Git directory with core.bare=false\n    assert.equal(fs.readFileSync(path.join(workspace, \"tracked.txt\"), \"utf8\"), \"subdirectory base\\n\");\n    assert.equal(git(\"show\", \":sub/tracked.txt\"), \"subdirectory base\");\n  } finally {\n    fs.rmSync(manager.getCheckpointDir(), { recursive: true, force: true });\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"tracked deletion cleanup runs before a checkpoint symlink can redirect it\", () => {\n  const { repo, git } = gitRepo();\n  const alias = path.join(repo, \"alias\");\n  const data = path.join(repo, \"data\");\n  fs.mkdirSync(alias);\n  fs.writeFileSync(path.join(alias, \"file\"), \"tracked alias file\\n\");\n  fs.mkdirSync(data);\n  fs.writeFileSync(path.join(data, \"file\"), \"ignored data must survive\\n\");\n  fs.writeFileSync(path.join(repo, \".gitignore\"), \"data/\\n\");\n  git(\"add\", \"alias/file\", \".gitignore\");\n  git(\"commit\", \"-qm\", \"tracked alias and ignored data\");\n  const manager = new CheckpointManager(repo);\n  try {\n    fs.rmSync(path.join(alias, \"file\"));\n    fs.rmdirSync(alias);\n    fs.symlinkSync(\"data\", alias);\n    git(\"add\", \"-A\", \"alias\");\n    const checkpoint = manager.createCheckpoint(\"symlink replacement deletion\");\n    git(\"reset\", \"--hard\", \"HEAD\");\n\n    const result = manager.restore(checkpoint.id);\n\n    assert.equal(result.success, true, result.message);\n    assert.equal(fs.lstatSync(alias).isSymbolicLink(), true);\n    assert.equal(fs.readFileSync(path.join(data, \"file\"), \"utf8\"), \"ignored data must survive\\n\");\n  } finally {\n    cleanupGitRepo(repo);\n  }\n});\n\ntest(\"manifest restore refuses a regular-file parent before changing tracked or untracked files\", () => {\n  const { repo, git } = gitRepo();\n  try {\n    fs.mkdirSync(path.join(repo, \"a\"));\n    fs.writeFileSync(path.join(repo, \"a\", \"b\"), \"captured\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"file parent collision\");\n    fs.rmSync(path.join(repo, \"a\"), { recursive: true });\n    fs.writeFileSync(path.join(repo, \"a\"), \"tracked canary\\n\");\n    git(\"add\", \"a\");\n    git(\"commit\", \"-qm\", \"replace directory with tracked file\");\n    fs.writeFileSync(path.join(repo, \"untracked.txt\"), \"untracked canary\\n\");\n\n});\n\ntest(\"Git restore rejects nested bare repository config FIFOs and external FIFO includes without hanging\", () => {\n  const { repo } = gitRepo();\n  const bareRepo = path.join(repo, \"nested-bare\");\n  const externalInclude = path.join(repo, \"external-config.fifo\");\n  try {\n    fs.mkdirSync(bareRepo);\n    fs.writeFileSync(path.join(bareRepo, \"captured.txt\"), \"checkpoint content\\n\");\n    const manager = new CheckpointManager(repo);\n    const checkpoint = manager.createCheckpoint(\"nested bare repository with blocking config paths\");\n\n    fs.rmSync(path.join(bareRepo, \"captured.txt\"));\n    execFileSync(\"git\", [\"init\", \"--bare\", \"-q\", bareRepo]);\n    execFileSync(\"mkfifo\", [externalInclude]);\n\n    const runRestoreWithDeadline = () => spawnSync(process.execPath, [\n      \"--import\", \"tsx\", \"--input-type=module\", \"--eval\",\n      \"import { CheckpointManager } from './src/checkpoint.ts'; const result = new CheckpointManager(process.argv[1]).restore(process.argv[2]); if (result.success) process.exitCode = 1; else console.log(result.message);\",\n      \"--\", repo, checkpoint.id,\n    ], {\n      cwd: path.resolve(\".\"),\n      encoding: \"utf8\",\n      env: { ...process.env, HOME: isolatedHome },\n      timeout: 3_000,\n    });\n\n    fs.rmSync(path.join(bareRepo, \"config\"));\n    execFileSync(\"mkfifo\", [path.join(bareRepo, \"config\")]);\n    const fifoConfigResult = runRestoreWithDeadline();\n    assert.equal(fifoConfigResult.error, undefined, `restore must not block on a FIFO config: ${fifoConfigResult.error?.message}`);\n    assert.equal(fifoConfigResult.status, 0, fifoConfigResult.stderr);\n    assert.match(fifoConfigResult.stdout, /nested Git repository/i);\n\n    fs.rmSync(path.join(bareRepo, \"config\"));\n    fs.writeFileSync(path.join(bareRepo, \"config\"), `[include]\\n\\tpath = ${externalInclude}\\n`);\n    const externalIncludeResult = runRestoreWithDeadline();\n    assert.equal(externalIncludeResult.error, undefined, `restore must not follow an external FIFO include: ${externalIncludeResult.error?.message}`);\n","exit_code":0,"duration":{"secs":1,"nanos":131824919}},"started_at_ms":1793207405688,"completed_at_ms":1793207406820}}
