ef = providerDefinition(id);\ncli/src/providers.ts:196:  return def?.credentialEnv ?? (def ? `sign in with /model → ctrl+p → ${def.label}` : \"the provider's API key variable\");\ncli/src/provider_cli.ts:2: * Operator surface for cloud providers: what is configured, which credentials are present (never their values),\ncli/src/provider_cli.ts:3: * where each role's requests go, and an opt-in live check that a provider/model completes a tool round trip.\ncli/src/provider_cli.ts:10:import { baseUrlSetting, disclosureClass, PROVIDERS } from \"./providers.js\";\ncli/src/provider_cli.ts:14:import { connectLocalEndpoint, connectWithKey, disconnect, startSignIn } from \"./provider_connect.js\";\ncli/src/provider_cli.ts:19:  const target = (provider: string | undefined, endpoint: string, model: string) => {\ncli/src/provider_cli.ts:23:    const label = provider ? PROVIDERS[provider]?.label ?? \"Cloud provider\" : \"Local endpoint\";\ncli/src/provider_cli.ts:25:    return `${where} · ${model ? safeModelId(model) : \"no model\"} · ${disclosureClass(endpoint, provider, config.cloudRoutedOrigins)}`;\ncli/src/provider_cli.ts:27:  const parts = [`main: ${target(config.provider, config.endpoint, config.model)}`];\ncli/src/provider_cli.ts:29:    const p = config.plannerProvider ?? (config.plannerEndpoint ? undefined : config.provider);\ncli/src/provider_cli.ts:33:    const p = config.coderProvider ?? (config.coderEndpoint ? undefined : config.provider);\ncli/src/provider_cli.ts:70:  return value && Object.prototype.hasOwnProperty.call(PROVIDERS, value) ? value : value ? \"(unrecognized provider)\" : undefined;\ncli/src/provider_cli.ts:75:  const match = /^Unknown provider '([^'\\r\\n]{1,128})' \\([A-Z0-9_]{1,64}\\)\\. Known providers: [A-Za-z0-9, ]+\\.$/.exec(message);\ncli/src/provider_cli.ts:76:  if (!match) return \"Configuration error: provider configuration is invalid\";\ncli/src/provider_cli.ts:77:  // An unknown provider name comes from user configuration; even identifier-sha