ackedFileModes)) {\n        if (!checkpoint.untrackedFiles?.includes(filePath) || !Number.isInteger(mode) || (mode as number) < 0 || (mode as number) > 0o777) return null;\n        modes[filePath] = mode as number;\n      }\n      checkpoint.untrackedFileModes = modes;\n    }\n    if (Array.isArray(raw.files)) checkpoint.files = raw.files;\n    return checkpoint;\n  }\n\n  /** A snapshot is usable only when it resolves under this checkpoint's own snapshots/<id>. */\n  private confinedSnapshotDir(id: string, value: unknown): string | undefined {\n    if (typeof value !== \"string\" || !path.isAbsolute(value)) return undefined;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18366-2421-7770-adb2-8a0eb3a8a68d","create_time":1793206280.4364507}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
