CallSource: \"required\" } : response);\n  }\n\n  private async chatCompletionOnce(messages: ChatMessage[], tools: ToolDefinition[], requestId: string, signal?: AbortSignal, toolChoice: \"auto\" | \"required\" = \"auto\"): Promise<ChatMessage> {\n    if (wireProtocol(this.conn.protocol).native) return this.nativeCompletion(messages, tools, undefined, requestId, signal, this.conn.streamOnly);\n    if (this.conn.streamOnly) return this.chatCompletionStreamOnce(messages, tools, undefined, requestId, signal);\n    return this.executeWithFailover(\"chatCompletion\", async (currentEp) => {\n      if (signal?.aborted) throw abortedError(requestId);\n      …3407 tokens truncated…is.conn.auth !== \"oauth\" || !this.conn.providerId) return;\n     const id = this.conn.providerId;\n     const label = providerDefinition(id)?.label ?? id;\n@@ -1102,8 +1132,7 @@ export class LocalLlmClient {\n   /** The clock of the resend budget; a test replaces it. */\n   public resendClock: () => number = Date.now;\n \n-  private createWatchdog(operatorSignal?: AbortSignal, currentEp?: string, streaming = false): StreamWatchdog {\n-    const disclosure = this.disclosureOf(currentEp ?? this.endpoint);\n+  private createWatchdog(operatorSignal?: AbortSignal, _currentEp?: string, streaming = false): StreamWatchdog {\n     const parseNum = (k: string) => {\n       const raw = process.env[k];\n       if (raw === undefined || raw === \"\") return undefined;\n@@ -1112,8 +1141,9 @@ export class LocalLlmClient {\n     };\n     const firstByteMs = parseNum(\"LOCAL_LLM_FIRST_BYTE_TIMEOUT_MS\") ?? 120_000;\n     const idleMs = parseNum(\"LOCAL_LLM_IDLE_TIMEOUT_MS\") ?? 120_000;\n-    const defaultTotal = disclosure === \"cloud\" ? 900_000 : 0;\n-    const totalMs = parseNum(\"LOCAL_LLM_TIMEOUT_MS\") ?? defaultTotal;\n+    // A zero or invalid setting cannot disable the whole-request deadline. Keep the first-byte and idle\n+    // watchdogs independent; clamp operator overrides below Node's maximum timer an