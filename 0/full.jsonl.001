unner | 0600 | the job receipt (§1.7) |","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"3249abb9-1e14-4d91-a88d-8264d99901e3","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"d25d0d24-8aed-4b03-a951-966dc54f0666","userType":"external","entrypoint":"cli","cwd":"/home/mike/nexus-code","sessionId":"43bcbb67-2cff-4fa8-a05e-f8aa598df73b","version":"2.1.329","gitBranch":"main","slug":"synthetic-moseying-seahorse","dataFlowOn":true}
