{"timestamp":"2026-11-02T20:46:49.556Z","ordinal":45825,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"CommandExecution","id":"exec-1d7aeecd-0836-4cda-939e-c7aa1dd6ed34","process_id":"24434","command":["/usr/bin/zsh","-lc","rg -n 'test\\(|describe\\(' cli/test/turn_semantics.test.ts | tail -n 30; sed -n '1,180p' cli/test/turn_semantics.test.ts"],"cwd":"file:///home/mike/nexus-wt/v112-wp1103-a0d374e8","parsed_cmd":[{"type":"search","cmd":"rg -n \"test\\\\(|describe\\\\(\" cli/test/turn_semantics.test.ts","query":"test\\(|describe\\(","path":"turn_semantics.test.ts"},{"type":"read","cmd":"sed -n '1,180p' cli/test/turn_semantics.test.ts","name":"turn_semantics.test.ts","path":"cli/test/turn_semantics.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"271:  test(\"the same trajectory with a passing verifier is VERIFIED only through the verifier run\", async () => {\n286:  test(\"a mutation after a passing verification invalidates it\", async () => {\n302:  test(\"running the tests is not a change: a test-only turn stays NOT_REQUIRED\", async () => {\n313:  test(\"no applicable verifier: completion is honestly UNVERIFIED with an explicit reason\", async () => {\n333:  test(\"discoverVerifier does not guess: bare package.json without a test script has none\", () => {\n345:describe(\"A-4 stream integrity\", () => {\n349:  test(\"clean complete stream (finish_reason + [DONE]) is accepted\", async () => {\n357:  test(\"[DONE] alone (no finish_reason) is accepted as terminal evidence\", async () => {\n364:  test(\"stream that ends early without a terminal event is stream_incomplete, partial text preserved but not returned\", async () => {\n377:  test(\"connection reset mid-stream is stream_interrupted\", async () => {\n388:  test(\"provider error frame mid-stream is a structured failure, not silently ignored\", async () => {\n405:  test(\"malformed event is a client-visible protocol failure and is not retried on another endpoint\", async () => {\n415:  test(\"timeout mid-stream is a timeout failure; partial text is not promoted\", async () => {\n432:  test(\"operator abort is 'aborted', is not failed over, and is distinct from timeout\", async () => {\n448:  test(\"non-streaming fallback for an empty stream is a new request with its own X-Request-ID\", async () => {\n465:  test(\"agent turn: truncated stream is an INFERENCE_FAILED turn, partial text is not accepted as the answer\", async () => {\n476:  test(\"agent turn: mid-stream provider error frame is a FAILED turn\", async () => {\n486:describe(\"A-2 cancellation\", () => {\n495:  test(\"delayed mutating loop: one cancel admits no new mutation and records INTERRUPTED\", async () => {\n533:  test(\"cancel kills an in-flight command and prevents its queued tool call from dispatching\", async () => {\n564:  test(\"an external AbortSignal is honoured as the cancellation authority\", async () => {\n579:  test(\"an agent can run a normal turn after an interrupted one\", async () => {\n619:describe(\"process exit contract (harness run)\", () => {\n624:    { name: \"verified completion\", script: (n) => n === 1 ? { kind: \"tools\", calls: [{ name: \"edit_file\", args: { path: \"a.mjs\", old_content: 'export const value = \"BEFORE\";', new_content: 'export const value = \"1\";' } }] } : n === 2 ? { kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary: \"ok\" } }] } : { kind: \"text\", content: \"x\" }, files: { Makefile: '.PHONY: test\\ntest:\\n\\tenv -u NODE_TEST_CONTEXT node --test test/impl.test.mjs\\n', \"a.mjs\": 'export const value = \"BEFORE\";\\n', \"test/impl.test.mjs\": 'import test from \"node:test\";\\nimport assert from \"node:assert/strict\";\\nimport { value } from \"../a.mjs\";\\ntest(\"declared deliverable\", () => assert.equal(value, \"1\"));\\n' }, deliverables: [\"a.mjs\"], code: 0, outcome: \"VERIFIED\", execution: \"COMPLETED\", success: true },\n629:    test(`${c.name} -> exit ${c.code}`, async () => {\n650:  test(\"a global deliverable declaration before the command is retained by the run action\", async () => {\n657:      \"test/impl.test.mjs\": 'import test from \"node:test\";\\nimport assert from \"node:assert/strict\";\\nimport { value } from \"../a.mjs\";\\ntest(\"declared deliverable\", () => assert.equal(value, \"1\"));\\n',\n676:describe(\"interactive REPL (pty)\", { skip: hasScript ? false : \"util-linux `script` not available\" }, () => {\n708:  test(\"Ctrl-C during a delayed mutating trajectory: one interrupt, no new mutation, prompt returns, next turn works\", async () => {\n753:  test(\"multiple prompts in one session keep working; Ctrl-C at idle still exits deliberately\", async () => {\n/**\n * Regression tests for the \"truthful, interruptible turns\" slice.\n *\n * Every scenario here was first reproduced against the pre-change code (see\n * docs/reviews/NEXUS_TRUTHFUL_INTERRUPTIBLE_TURNS_2026-10-03.md) using a deterministic local gateway.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport http from \"node:http\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execSync, spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { LocalLlmClient, InferenceError } from \"../src/client.js\";\nimport { discoverVerifier } from \"../src/tester.js\";\nimport {\n  assertTurnResultInvariants,\n  exitCodeForTurn,\n  TurnResult,\n  TurnResultInvariantError,\n} from \"../src/core/turn.js\";\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst srcIndex = path.resolve(here, \"../src/index.ts\");\nconst cliRoot = path.resolve(here, \"..\");\n\ntype Reply =\n  | { kind: \"tools\"; calls: Array<{ name: string; args: any }>; content?: string; delayMs?: number }\n  | { kind: \"text\"; content: string; delayMs?: number }\n  | { kind: \"http\"; status: number; body?: string }\n  | { kind: \"raw\"; chunks: string[]; hang?: boolean; resetAfter?: boolean };\n\ninterface Gateway {\n  url: string;\n  requests: Array<{ body: any; id: string | undefined; attempt?: string; previous?: string }>;\n  close(): Promise<void>;\n}\n\nfunction sse(obj: unknown): string {\n  return `data: ${JSON.stringify(obj)}\\n\\n`;\n}\n\nfunction streamBody(r: Reply & { kind: \"tools\" | \"text\" }): string {\n  let out = \"\";\n  if (r.kind === \"text\") out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n  else {\n    if (r.content) out += sse({ choices: [{ index: 0, delta: { content: r.content } }] });\n    r.calls.forEach((c, i) => {\n      out += sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: i, id: `call_${i}_${Math.random().toString(36).slice(2, 7)}`, type: \"function\", function: { name: c.name, arguments: JSON.stringify(c.args) } }] } }] });\n    });\n  }\n  out += sse({ choices: [{ index: 0, delta: {}, finish_reason: r.kind === \"tools\" ? \"tool_calls\" : \"stop\" }] });\n  return out + \"data: [DONE]\\n\\n\";\n}\n\nasync function startGateway(script: (n: number, body: any) => Reply): Promise<Gateway> {\n  const requests: Gateway[\"requests\"] = [];\n  const sockets = new Set<import(\"node:net\").Socket>();\n  const server = http.createServer((req, res) => {\n    if (req.url?.endsWith(\"/models\")) {\n      res.setHeader(\"content-type\", \"application/json\");\n      res.end(JSON.stringify({ data: [{ id: \"m\" }] }));\n      return;\n    }\n    let raw = \"\";\n    req.on(\"data\", (c) => (raw += c));\n    req.on(\"end\", () => {\n      let body: any = {};\n      try { body = JSON.parse(raw); } catch {}\n      requests.push({\n        body,\n        id: req.headers[\"x-request-id\"] as string | undefined,\n        attempt: req.headers[\"x-aihost-attempt\"] as string | undefined,\n        previous: req.headers[\"x-aihost-previous-request\"] as string | undefined,\n      });\n      const r = script(requests.length, body);\n      const respond = () => {\n        if (r.kind === \"http\") {\n          res.statusCode = r.status;\n          res.end(r.body ?? \"{}\");\n        } else if (r.kind === \"raw\") {\n          res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n          for (const c of r.chunks) res.write(c);\n          if (r.resetAfter) res.destroy();\n          else if (!r.hang) res.end();\n        } else {\n          if (body.stream) {\n            res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n            res.end(streamBody(r));\n          } else {\n            res.setHeader(\"content-type\", \"application/json\");\n            const message = r.kind === \"text\"\n              ? { role: \"assistant\", content: r.content }\n              : { role: \"assistant\", content: r.content ?? null, tool_calls: r.calls.map((c, i) => ({ id: `call_${i}`, type: \"function\", function: { name: c.name, arguments: JSON.stringify(c.args) } })) };\n            res.end(JSON.stringify({ choices: [{ index: 0, message, finish_reason: \"stop\" }] }));\n          }\n        }\n      };\n      const delay = (r as any).delayMs as number | undefined;\n      if (delay) setTimeout(respond, delay); else respond();\n    });\n  });\n  server.on(\"connection\", (s) => { sockets.add(s); s.on(\"close\", () => sockets.delete(s)); });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", () => resolve()));\n  const port = (server.address() as any).port;\n  return {\n    url: `http://127.0.0.1:${port}/v1`,\n    requests,\n    close: async () => {\n      for (const s of sockets) s.destroy();\n      await new Promise<void>((resolve) => server.close(() => resolve()));\n    },\n  };\n}\n\nfunction makeRepo(files: Record<string, string> = {}): string {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-turn-\"));\n  fs.writeFileSync(path.join(repo, \"base.txt\"), \"base\\n\");\n  for (const [name, content] of Object.entries(files)) {\n    const fullPath = path.join(repo, name);\n    fs.mkdirSync(path.dirname(fullPath), { recursive: true });\n    fs.writeFileSync(fullPath, content);\n  }\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm base\", { cwd: repo, stdio: \"ignore\" });\n  return repo;\n}\n\nfunction newAgent(gw: Gateway, repo: string, extra: Record<string, unknown> = {}): AutonomousAgent {\n  return new AutonomousAgent({\n    endpoint: gw.url, model: \"m\", maxSteps: 6, temperature: 0, workspace: repo, shell: \"bash\", approvalMode: \"auto\", fullAccess: true, ...extra,\n  } as any);\n}\n\nasync function withTurn<T>(\n  script: (n: number, body: any) => Reply,\n  files: Record<string, string>,\n  fn: (gw: Gateway, repo: string, agent: AutonomousAgent) => Promise<T>,\n  extra: Record<string, unknown> = {},\n): Promise<T> {\n  const gw = await startGateway(script);\n  const repo = makeRepo(files);\n  const agent = newAgent(gw, repo, extra);\n  try {\n    return await fn(gw, repo, agent);\n  } finally {\n    agent.shutdown();\n    await gw.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n  }\n}\n\nconst quiet = async <T>(fn: () => Promise<T>): Promise<T> => fn();\n\ndescribe(\"A-1 outcome truth: structured TurnResult\", () => {\n  test(\"HTTP 500 is a structured inference failure, not a success\", async () => {\n    await withTurn(() => ({ kind: \"http\", status: 500, body: '{\"error\":\"boom\"}' }), {}, async (_gw, _repo, agent) => {\n      const r = await quiet(() => agent.runTurn(\"do work\"));\n      assert.equal(r.execution, \"FAILED\");\n      assert.equal(r.outcome, \"NOT_ESTABLISHED\");\n      assert.equal(r.reason, \"INFERENCE_FAILED\");\n      assert.equal(r.inferenceFailure?.kind, \"http_error\");\n      assert.equal(r.inferenceFailure?.origin, \"provider\");\n      assert.equal(r.inferenceFailure?.httpStatus, 500);\n      assert.equal(r.finalOutputComplete, false);\n      assert.notEqual(exitCodeForTurn(r), 0);\n    });\n  });\n\n  test(\"step-limit exhaustion is LIMIT_REACHED, never completion\", async () => {\n    await withTurn(() => ({ kind: \"tools\", calls: [{ name: \"list_dir\", args: { path: \".\" } }] }), {}, async (_gw, _repo, agent) => {\n      (agent as any).config.maxSteps = 3;\n      const r = await quiet(() => agent.runTurn(\"loop\"));\n      assert.equal(r.execution, \"LIMIT_REACHED\");\n      assert.equal(r.outcome, \"NOT_ESTABLISHED\");\n      assert.equal(r.steps.limitReached, true);\n      assert.equal(r.steps.used, 3);\n      assert.equal(exitCodeForTurn(r), 1);\n    });\n","exit_code":0,"duration":{"secs":0,"nanos":625946724}},"started_at_ms":1793652408930,"completed_at_ms":1793652409556}}
