p_trust.test.ts:40:test(\"an ungated (trusted) manager starts the server\", async () => {\ncli/test/lsp_trust.test.ts:50:test(\"the lsp tools through the executor refuse in an untrusted workspace with success:false\", async () => {\ncli/test/lsp_trust.test.ts:52:  const saved = { HOME: process.env.HOME, T: process.env.NEXUS_TRUST_WORKSPACE };\ncli/test/lsp_trust.test.ts:54:  delete process.env.NEXUS_TRUST_WORKSPACE;\ncli/test/lsp_trust.test.ts:60:    for (const [tool, args] of [[\"lsp_diagnostics\", { path: \"a.ts\" }], [\"lsp_hover\", { path: \"a.ts\", line: 1, character: 1 }], [\"lsp_definition\", { path: \"a.ts\", line: 1, character: 1 }]] as const) {\ncli/test/lsp_trust.test.ts:63:      assert.match(res.error ?? \"\", /workspace not trusted; language server not started/, tool);\ncli/test/lsp_trust.test.ts:68:    if (saved.T !== undefined) process.env.NEXUS_TRUST_WORKSPACE = saved.T;\ncli/test/lsp_trust.test.ts:72:test(\"a read-only bridge refuses even when the workspace is trusted\", async () => {\ncli/test/lsp_trust.test.ts:73:  const saved = process.env.NEXUS_TRUST_WORKSPACE;\ncli/test/lsp_trust.test.ts:74:  process.env.NEXUS_TRUST_WORKSPACE = \"1\";\ncli/test/lsp_trust.test.ts:80:    const res = await bridge.executeTool(\"lsp_hover\", { path: \"a.ts\", line: 1, character: 1 });\ncli/test/lsp_trust.test.ts:85:    if (saved === undefined) delete process.env.NEXUS_TRUST_WORKSPACE; else process.env.NEXUS_TRUST_WORKSPACE = saved;\ncli/test/lsp_trust.test.ts:89:test(\"a required sandbox refuses a trusted workspace rather than starting an unsandboxed server\", async () => {\ncli/test/lsp_trust.test.ts:90:  const saved = process.env.NEXUS_TRUST_WORKSPACE;\ncli/test/lsp_trust.test.ts:91:  process.env.NEXUS_TRUST_WORKSPACE = \"1\";\ncli/test/lsp_trust.test.ts:99:    assert.match(res.error ?? \"\", /sandbox/);\ncli/test/lsp_trust.test.ts:102:    if (saved === undefined) delete process.env.NEXUS_TRUST_WORKSPACE; else process.env.NEXUS_TRUST_WORKSPACE = saved;\ncli/test/lsp_trust.test.ts:200:test(\"revoking trust after a server started stops it and refuses the next query\", async () => {\ncli/test/lsp_trust.test.ts:202:  const { mgr, pidfile } = setup({ \"a.ts\": \"fine\" }, () => (allowed ? null : \"workspace not trusted; language server not started\"));\ncli/test/lsp_real_servers.test.ts:156:    // Default server table (no `servers` override) and no gate: a trusted, unsandboxed workspace.\ncli/test/lsp_real_servers.test.ts:157:    const mgr = new LspBridgeManager(dir, { gate: () => null });\ncli/test/lsp_real_servers.test.ts:219:  /** The call site (1-based line and character, as the product's lsp_hover/lsp_definition take them, on the callee's name) and the file that defines it. */\ncli/test/lsp_real_servers.test.ts:286:    const mgr = new LspBridgeManager(dir, { gate: () => null });\n    at: { file: \"main.go\", line: 4, character: 7 },\n    definedIn: \"service.go\",\n    hoverMentions: /welcome/,\n  },\n];\n\nfor (const n of NAV) {\n  const c = CASES.find((x) => x.id === n.id)!;\n  test(`real ${c.label}: hover and definition name the function defined in another file`, { timeout: c.timeoutMs * 2 + 30_000 }, async (t) => {\n    const dir = writeFixture(n.files);\n    const reason = unavailableReason(c, dir);\n    if (reason) {\n      if (required(c.id)) assert.fail(`NEXUS_LSP_REQUIRE names ${c.id} but ${reason}`);\n      t.skip(`${reason}; install it to run this case`);\n      return;\n    }\n    const mgr = new LspBridgeManager(dir, { gate: () => null });\n    try {\n      const deadline = Date.now() + c.timeoutMs;\n      let hover: Awaited<ReturnType<typeof mgr.hover>> = { found: false };\n      let def: Awaited<ReturnType<typeof mgr.definition>> = { found: false };\n      // A server may answer early from what it has loaded so far (tsserver names the import itself until the imported file is\n      // loaded), so an answer counts once it points where the definition is; the last answer is what the assertions report.\n      const pointsAtDefinition = (d: typeof def) => (d.locations ?? []).some((l) => l.uri.endsWith(`/${n.definedIn}`));\n      while (Date.now() < deadline && !(hover.found && pointsAtDefinition(def))) {\n        if (!hover.found) hover = await mgr.hover(n.at.file, n.at.line, n.at.character);\n        if (!pointsAtDefinition(def)) def = await mgr.definition(n.at.file, n.at.line, n.at.character);\n        if (!(hover.found && pointsAtDefinition(def))) await new Promise((r) => setTimeout(r, 1000));\n      }\n      assert.ok(hover.found, `hover never answered: ${JSON.stringify(hover)}`);\n      assert.match(hover.hoverText ?? \"\", n.hoverMentions, \"hover text should name the function\");\n      assert.ok(def.found, `definition never answered: ${JSON.stringify(def)}`);\n      const uris = (def.locations ?? []).map((l) => l.uri);\n      assert.ok(uris.some((u) => u.endsWith(`/${n.definedIn}`)), `definition should point into ${n.definedIn}, got ${JSON.stringify(uris)}`);\n    } finally {\n      mgr.shutdownAll();\n    }\n  });\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1f70b-846a-7860-9aa2-ec3e0d5fdc10","create_time":1795146357.51001}},"metadata":{"history_sequence":12629,"sampled_through_sequence":12626,"client_authored":false,"fallback_token_limit_override":12000}}
