_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:d03646b7f483da70cf518747\",\n      \"paths\": [\n        \"workflow.release.acceptance\"\n      ],\n      \"kind\": \"invariant\",\n      \"text\": \"Green CI and independent code review do not constitute qualification or release acceptance; source may merge for RC construction, but publication requires all acceptance gates and evidence tied to the actual candidate.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"f73ff17f-fe7b-4087-bd8d-f26ad4102ad2\",\n          \"checkpoint_id\": \"01M59W4SMWH7G60B0E53VW0D22\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 180\n        },\n        {\n          \"session_id\": \"f73ff17f-fe7b-4087-bd8d-f26ad4102ad2\",\n          \"checkpoint_id\": \"01M59W4SMWH7G60B0E53VW0D22\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:50:18.135593148Z\",\n      \"updated_at\": \"2026-10-28T07:50:18.135593148Z\"\n    },\n    {\n      \"id\": \"fact:3ee09d8f3cf429b06de6ae2f\",\n      \"paths\": [\n        \"workflow.release.authorization\"\n      ],\n      \"kind\": \"convention\",\n      \"text\": \"The user authorized necessary commits, pushes, PRs, merges, release candidates, tags, and stable publication after required gates pass; agents should not request these approvals again and must coordinate with one designated release publisher.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"f73ff17f-fe7b-4087-bd8d-f26ad4102