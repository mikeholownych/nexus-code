d blocked: refuse it where the operator can see why.\n       const human = humanRequirementForEffect(managedPolicy(), \"write_workspace\");\n  +4 -0\n\ncli/src/core/verifier_check.ts\n  @@ -0,0 +1,30 @@\n  +/**\n  + * BG-1/BG-2: what the operator's verifier command must look like. Shared by every place a verifier is accepted (a job\n  + * submission, a schedule at add and at fire, and the runner when it reads a request), so no route is looser than another.\n  + */\n  +import * as os from \"node:os\";\n  +import * as path from \"node:path\";\n  +import { SecurityManager } from \"../security.js\";\n  +import { decideCommand, NO_COMMAND_RULES, readCommandRulesFile } from \"./command_rules.js\";\n  +\n  +/**\n  + * Why the operator's verifier command may not be used, or undefined. An unattended run starts this one command without\n  + * asking (the operator chose it), so it is held to what an interactive command is: bounded, one line, not on the\n  + * security tripwire list, and not forbidden by the operator's own command rules. Checked when a job or schedule is made\n  + * and again each time a schedule fires, because a schedule record is a file on disk.\n  + */\n  +export function verifierProblem(workspace: string, verifier: string | null): string | undefined {\n  +  if (verifier === null) return undefined;\n  +  if (!verifier.trim() || verifier.length > 2000 || /[\\0\\r\\n]/.test(verifier)) return \"the verifier must be one command line of at most 2000 characters\";\n  +  const blocked = new SecurityManager(workspace).isCommandBlocked(verifier);\n  +  if (blocked.blocked) return `the verifier command is refused by the security policy: ${blocked.reason ?? \"blocked\"}`;\n  +  let rules = NO_COMMAND_RULES;\n  +  try {\n  +    rules = readCommandRulesFile(path.join(os.homedir(), \".config\", \"nexus\", \"command_rules.json\"));\n  +  } catch {\n  +    // A rules file that does not load is ignored by every command, as the agent ignores it.\n  +  }\n  +  const verdict = decideCommand(rules, verifier);\n  +  if (verdict?.decision === \"forbidden\") return \"the verifier command is forbidden by your command rules\";\n  +  return undefined;\n  +}\n  +30 -0","is_error":false}]},"uuid":"43c45fe6-e710-4d3c-882d-7bfdb4e57f26","timestamp":"2026-11-24T23:00:22.678Z","toolUseResult":{"stdout":"ok fetched\ncli/src/core/job_receipt.ts                | 12 +++++++++++-\n cli/src/core/job_runner.ts                 |  4 ++++\n cli/src/core/job_submission.ts             | 29 +++--------------------------\n cli/src/core/schedule.ts                   | 21 +++++++++++++++++----\n cli/src/core/verifier_check.ts             | 30 ++++++++++++++++++++++++++++++\n cli/test/schedule.test.ts                  | 13 +++++++++++--\n cli/test/schedule_cli.test.ts              |  3 ++-\n cli/test/schedule_failing_verifier.test.ts | 30 ++++++++++++++++++++++++++++++\n cli/test/unattended_verifier.test.ts       | 23 +++++++++++++++++++++++\n docs/SCHEDULES.md                          |  3 ++-\n docs/USER_MANUAL.md                        |  2 +-\n 11 files changed, 134 insertions(+), 36 deletions(-)\ncli/src/core/job_runner.ts     |  4 ++++\n cli/src/core/verifier_check.ts | 30 ++++++++++++++++++++++++++++++\n 2 files changed, 34 insertions(+)\n\nChanges:\n\ncli/src/core/job_runner.ts\n  @@ -27,6 +27,7 @@ import {\n  +import { verifierProblem } from \"./verifier_check.js\";\n   import { ScheduleEngine, type ScheduleEngineOptions } from \"./schedule_engine.js\";\n   import { UNATTENDED_ENV_SCRUB } from \"./unattended.js\";\n   import { isWorkspaceListed } from \"../workspace_trust.js\";\n  @@ -105,6 +106,9 @@ export function submissionProblem(job: JobSubmission, spec: unknown): string | u\n  +  // A request is a file a client wrote: its verifier is held to the same checks `nexus job start` and `schedule add` apply.\n  +  const verifier = verifierProblem(job.workspace, job.verifier);\n  +  if (verifier) return verifier;\n     if (job.policy === \"worktree-write\") {\n       // Every write would be denied, so the job could only ever end blocked: refuse it where the operator can see why.\n       const human = humanRequirementForEffect(managedPolicy(), \"write_workspace\");\n  +4 -0\n\ncli/src/core/verifier_check.ts\n  @@ -0,0 +1,30 @@\n  +/**\n  + * BG-1/BG-2: what the operator's verifier command must look like. Shared by every place a verifier is accepted (a job\n  + * submission, a schedule at add and at fire, and the runner when it reads a request), so no route is looser than another.\n  + */\n  +import * as os from \"node:os\";\n  +import * as path from \"node:path\";\n  +import { SecurityManager } from \"../security.js\";\n  +import { decideCommand, NO_COMMAND_RULES, readCommandRulesFile } from \"./command_rules.js\";\n  +\n  +/**\n  + * Why the operator's verifier command may not be used, or undefined. An unattended run starts this one command without\n  + * asking (the operator chose it), so it is held to what an interactive command is: bounded, one line, not on the\n  + * security tripwire list, and not forbidden by the operator's own command rules. Checked when a job or schedule is made\n  + * and again each time a schedule fires, because a schedule record is a file on disk.\n  + */\n  +export function verifierProblem(workspace: string, verifier: string | null): string | undefined {\n  +  if (verifier === null) return undefined;\n  +  if (!verifier.trim() || verifier.length > 2000 || /[\\0\\r\\n]/.test(verifier)) return \"the verifier must be one command line of at most 2000 characters\";\n  +  const blocked = new SecurityManager(workspace).isCommandBlocked(verifier);\n  +  if (blocked.blocked) return `the verifier command is refused by the security policy: ${blocked.reason ?? \"blocked\"}`;\n  +  let rules = NO_COMMAND_RULES;\n  +  try {\n  +    rules = readCommandRulesFile(path.join(os.homedir(), \".config\", \"nexus\", \"command_rules.json\"));\n  +  } catch {\n  +    // A rules file that does not load is ignored by every command, as the agent ignores it.\n  +  }\n  +  const verdict = decideCommand(rules, verifier);\n  +  if (verdict?.decision === \"forbidden\") return \"the verifier command is forbidden by your command rules\";\n  +  return undefined;\n  +}\n  +30 -0","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"0aac6446-9636-40ff-a882-1d0ab7d66819","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"d25d0d24-8aed-4b03-a951-966dc54f0666","userType":"external","entrypoint":"cli","cwd":"/home/mike/nexus-code","sessionId":"43bcbb67-2cff-4fa8-a05e-f8aa598df73b","version":"2.1.329","gitBranch":"v1/bg3-trust-abuse-model","slug":"synthetic-moseying-seahorse","dataFlowOn":true}
