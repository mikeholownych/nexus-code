\n  description?: string;\n  enum?: string[];\n  items?: Record<string, unknown>;\n}\n\nexport interface ToolDefinition {\n  type: \"function\";\n  function: {\n    name: string;\n    description: string;\n    parameters: {\n      type: \"object\";\n      properties: Record<string, ToolParameterProperty>;\n      required?: string[];\n    };\n  };\n}\n\nexport interface HarnessConfig {\n  endpoint: string;          // e.g. \"http://localhost:1234/v1\" (LM Studio) or \"http://localhost:8000/v1\" (vLLM)\n  model: string;             // e.g. \"qwen2.5-coder-32b-instruct\"\n  apiKey?: string;           // Optional for local servers (defaults to \"local\")\n  maxSteps: number;          // Steps per segment (default 30). With `continuation` (the default), a segment boundary is a durable checkpoint, never the end of the task.\n  /**\n   * Automatic continuation past `maxSteps` while the work makes progress (see AutonomousAgent.runTurn). Absent:\n   * `maxSteps` ends the turn (LIMIT_REACHED), the legacy single-segment behaviour.\n   */\n  continuation?: ContinuationBudget;\n  /** Identical-tool-call thresholds (soft: corrective note; hard: TOOL_CALL_LOOP for an observer, scaled for commands and polls). Independent of `continuation`. */\n  repeatedCalls?: { soft: number; hard: number };\n  temperature: number;       // Default 0.2 for precise coding\n  workspace: string;         // Working directory for tools\n  shell: string;             // Linux shell: \"bash\", \"zsh\", \"sh\" (default: \"bash\")\n  coreBinaryPath?: string;   // Path to compiled harness-core executable\n  dryRun?: boolean;          // Dry-run simulation mode without persisting file modifications\n  readOnly?: boolean;        // Reject all mutating tool executions and commands\n  readOnlyModeSelected?: boolean; // Read-only is mode-selected (not the explicit --read-only launch) and may be changed deliberately\n  approvalMode?: \"auto\" | \"review\" | \"read-only\"; // Permission posture: auto, review, or read-only (DEC-01, independent of folder trust)\n  yes?: boolean;             // Run non-interactively without confirmation prompts (forces auto mode)\n  fullAccess?: boolean;      // Broad full-access mode executing without confirmation prompts (AUTH-007, AUTH-008)\n  taskClass?: string;        // Routing hint sent to the gateway as X-Task-Class (e.g. \"review\", \"architecture\")\n  plannerTaskClass?: string; // Same, for the planner client\n  fallbackEndpoints?: string[]; // Failover endpoint URLs if primary endpoint is unavailable\n  pinEndpoint?: boolean;     // Use only `endpoint` (no fallbacks): the operation scheduler owns resource selection\n      throw new Error(`Invalid operation policy ${field}: must not exceed Node's timer limit (${maxTimerDelayMs} ms).`);\n    }\n  }\n  const { maxWaitMs, minWaitMs } = effective;\n  if (minWaitMs > maxWaitMs) {\n    throw new Error(`Invalid operation wait settings: minWaitMs (${minWaitMs}) must not exceed maxWaitMs (${maxWaitMs}).`);\n  }\n  return Object.keys(policy).length ? policy : undefined;\n}\n\n/**\n * Continuation budgets: flags, then NEXUS_MAX_TOTAL_STEPS / NEXUS_MAX_TURN_MINUTES / NEXUS_STAGNATION_STEPS, then\n * finite defaults. Total steps are charged to the durable objective ledger, so resume does not reset them.\n * `--no-continuation` (or NEXUS_CONTINUATION=0) is the operator's explicit choice of the single-segment turn that\n * ends at --max-steps.\n */\nexport function continuationBudget(options: any): ContinuationBudget | undefined {\n  if (options.continuation === false || effectiveSetting(\"NEXUS_CONTINUATION\") === \"0\") return undefined;\n  const positive = (flag: unknown, env: string | undefined, fallback: number, maximum = Number.POSITIVE_INFINITY): number => {\n    for (const raw of [flag, env]) {\n      if (raw === undefined || raw === null || raw === \"\") continue;\n      const value = Number(raw);\n      if (!Number.isFinite(value) || value <= 0) throw new Error(`Invalid continuation budget