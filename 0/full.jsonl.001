n    }\n    return saved;\n  }\n\n  /**\n   * Routes all durable-write failures (op start/end, baseline, plan, requirements, recovery)\n   * through one path (AGT-14). Warns and records the failure in `turnPersistenceFailures`.\n   */\n  public reportPersistenceFailure(kind: string, err: unknown): void {\n    const message = redactSecrets(err instanceof Error ? err.message : String(err)).slice(0, 200);\n    let text: string;\n    if (kind === \"objective_budget\") {\n      text = `The delegated task budget could not be saved durably (${message}); no further delegated inference or tool execution is allowed.`;\n      this.objectiveBudgetPersistenceFailure = text;\n    } else if (kind === \"operation_start\" || kind === \"operation_end\") {\n      text = `Tool operation record (${kind}) could not be written durably (${message}); crash recovery degraded.`;\n    } else if (kind === \"init\") {\n      text = `Initial durable task state was not persisted (${message}); restart recovery is unavailable until a later successful checkpoint.`;\n      this.initialStatePersistenceFailure = text;\n    } else if (kind === \"final_checkpoint\") {\n      text = `The turn's final task state could not be saved: ${message}`;\n    } else {\n      text = `Durable checkpoint (${kind}) could not be saved (${message}); if the process stops, state since last save may be lost.`;\n    }\n    this.turnPersistenceFailures.push(text);\n    try {\n      if (this.observer?.onNotice) this.observer.onNotice(text);\n      else console.warn(pc.yellow(text));\n    } catch {}\n  }\n\n  /** Persist only the shared objective ledger, never the subagent's temporary conversation. */\n  private persistObjectiveBudget(): boolean {\n    if (!this.durable) return true;\n    try {\n      if (!this.stateManager || !this.currentTaskId || !this.objective) throw new Error(\"durable objective state is unavailable\");\n      this.stateManager.recordProgress(this.currentTaskId, { objective: this.objective });\n      return true;\n    } catch (err) {\n      this.reportPersistenceFailure(\"objective_budget\", err);\n      return false;\n    }\n  }\n\n  /** Share the parent's ledger and durable checkpoint with an ephemeral delegated agent. */\n  public inheritObjectiveBudget(parent: AutonomousAgent): void {\n    if (!parent.durable || !parent.objective) return;\n    this.sharedObjectiveBudget = {\n      ledger: parent.objective,\n      persist: () => parent.persistObjectiveBudget(),\n    };\n  }\n\n  /**\n   * Gives every tool call in a recovered conversation a result: a call whose result was never recorded gets a note\n   * that its outcome is unknown. Returns the tools of those calls.\n   */\n  private settleUnrecordedToolCalls(): string[] {\n  /** sha256 of `parent.inputs NUL inputs`: it identifies the transition between two candidate identities, it is not a content diff. */\n  diffHash?: string;\n}\n\nexport interface ObjectiveOutcome {\n  status: \"completed\" | \"incomplete\" | \"blocked\";\n  reason: string;\n  failedCheck?: string;\n  remaining: string[];\n  nextAction?: string;\n  at: string;\n}\n\nexport interface ContinuationState {\n  /** Segments of `segmentSteps` steps the current turn has run (1 for an ordinary turn). */\n  segments: number;\n  /** Steps run against this objective across turns. */\n  totalSteps: number;\n  /** Step (within the current turn) of the last observed progress. */\n  lastProgressStep: number;\n  stopReason?: string;\n}\n\nexport interface ObjectiveLedger {\n  version: number;\n  /** Work unit id when this ledger is scoped to a work unit in an operation or team (REQ-AGT-102/103). */\n  unitId?: string;\n  objective: string;\n  objectiveSha256: string;\n  startedAt: string;\n  requirements: Requirement[];\n  scopeChanges: ScopeChange[];\n  steering: SteeringRecord[];\n  steeringConflicts?: SteeringConflict[];\n  superseded?: SupersededObjective[];\n  verification: VerificationAttempt[];\n  /** Operator-authorised regression obligations (core/regression_obligations.ts); absent in ledgers written before DV-3. */\n  obligations?: RegressionObligation[];\n  /** Operator-authorised behavioural references, by requirement (DV-4 gate). */\n  references?: ReferenceDeclaration[];\n  /** Latest VC-3 differential run per requirement; finite agreement, never equivalence. */\n  differentials?: DifferentialRecord[];\n  continuation: ContinuationState;\n  /** The model's own statement of what comes next (update_requirements next_action). */\n  nextAction?: string;\n  /** Attempts numbered up to this were already judged non-converging and stopped the work; the next judgement starts after it. */\n  convergenceResetAfter?: number;\n  outcome?: ObjectiveOutcome;\n  /** Short follow-up messages the operator sent as new turns while this objective was unresolved. */\n  amendments: Array<{ at: string; text: string }>;\n  /**\n   * Objective-scoped execution tracking (core/execution_tracking.ts): cumulative steps, progress, repetition,\n   * failed approaches, interventions and compactions. Absent in ledgers written before it existed; `trackingOf` fills it.\n   */\n  execution?: ExecutionTracking;\n}\n\n/** The ledger's execution tracking, created (or completed, for a ledger restored from an earlier version) on first use. */\nexport function trackingOf(ledger: ObjectiveLedger): ExecutionTracker {\n  ledger.execution = normalizeTracking(ledger.execution);\n  // `ContinuationState.totalSteps` predates the richer execution record. Preserve its count when resuming a legacy\n  // task instead of normalizing a missing execution field to a false zero and granting fresh budget.\n  if (Number.isSafeInteger(ledger.continuation?.totalSteps) && ledger.continuation.totalSteps > ledger.execution.cumulativeSteps) {\n    ledger.execution.cumulativeSteps = ledger.continuation.totalSteps;\n  }\n  return new ExecutionTracker(ledger.execution);\n}\n\nconst now = () => new Date().toISOString();\nconst sha256 = (text: string) => createHash(\"sha256\").update(text).digest(\"hex\");\nconst clip = (text: string, max: number) => (text.length <= max ? text : `${text.slice(0, max - 1)}…`);\n\n/**\n * Acceptance criteria as written: top-level numbered items (`1.`, `2)`, `R3:`) of the objective. Each keeps its\n * heading line; the full wording stays in the verbatim objective. Fewer than two items means the objective is a\n * single request and is tracked as one requirement.\nexport function createLedger(objective: string, at = now(), unitId?: string): ObjectiveLedger {\n  return {\n    version: LEDGER_VERSION,\n    ...(unitId ? { unitId } : {}),\n    objective,\n    objectiveSha256: sha256(objective),\n    startedAt: at,\n    requirements: seedRequirements(objective).map((seed) => ({\n      ...seed,\n      status: \"open\" as const,\n      source: \"objective\" as const,\n      evidence: [],\n      updatedAt: at,\n    })),\n    scopeChanges: [],\n    steering: [],\n    verification: [],\n    continuation: { segments: 1, totalSteps: 0, lastProgressStep: 0 },\n    amendments: [],\n    execution: createTracking(),\n  };\n}\n\n/**\n * Requirements an operator follow-up adds to the objective it continues: its numbered items, appended after the\n * existing ones (an amendment never removes or rewrites what was asked before).\n */\nexport function amendObjective(ledger: ObjectiveLedger, prompt: string, at = now()): Requirement[] {\n  ledger.amendments.push({ at, text: prompt });\n  const seeds = seedRequirements(prompt);\n  if (seeds.length < 2) return [];\n  const base = ledger.requirements.filter((r) => r.source === \"objective\").length;\n  const added = seeds.map((seed, i) => ({\n    id: `R${base + i + 1}`,\n    text: seed.text,\n    detail: seed.detail,\n  static fresh(): ExecutionTracker {\n    return new ExecutionTracker(createTracking());\n  }\n\n  private event(list: TrackingEvent[], max: number, step: number, kind: string, detail: string): void {\n    pushBounded(list, { step, at: this.clock(), kind, detail: clip(detail, 400) }, max, (n) => (this.data.evicted.events += n));\n  }\n\n  beginTurn(): void {\n    this.data.turns++;\n  }\n\n  beginStep(): number {\n    return ++this.data.cumulativeSteps;\n  }\n\n  /** Records a single tool result; the verdict says whether it was new, a poll, or part of a demonstrated loop. */\n  observe(step: number, o: Observation): ObservationVerdict {\n    const kind = o.kind ?? actionKind(o.name);\n    const command = commandResult(o.success, o.text);\n    const outcomeClass = classifyOutcome(command.success, o.text, o.timedOut || command.timedOut);\n    const action = actionIdentity(o.name, o.args);\n    const outcome = outcomeIdentity(command.success, o.text);\n    const stateUnknown = o.stateBefore === \"unknown\";\n    const actionId = digest(action);\n    const key = digest(`${action}\\u0000${outcome}\\u0000${o.stateBefore}`);\n    let record = this.data.repetitions.find((r) => r.key === key);\n    const seenBefore = !stateUnknown && this.data.seenObservations.includes(key);\n    if (!record) {\n      record = {\n        key,\n","exit_code":0,"duration":{"secs":0,"nanos":29342}},"started_at_ms":1795156572187,"completed_at_ms":1795156572187}}
