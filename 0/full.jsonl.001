        }\\n   263\\t      }\\n   264\\t    }\\n   265\\t  }\\n   266\\t\\n   267\\t  private assertUntrackedDestinationSafe(relativePaths: string[], targetRoot: string): void {\\n   433\\t  private assertGitSnapshotTargetsReplaceable(relativePaths: string[], gitRef: string): void {\\n   434\\t    const directoryTargets = relativePaths.filter((relativePath) =>\\n   435\\t      fs.lstatSync(path.join(this.workspace, relativePath), { throwIfNoEntry: false })?.isDirectory(),\\n   436\\t    );\\n   437\\t    if (directoryTargets.length === 0) return;\\n   438\\t\\n   439\\t    const changedPaths = execFileSync(\\\"git\\\", [\\\"-c\\\", \\\"core.fsmonitor=false\\\", \\\"diff\\\", \\\"--name-only\\\", \\\"-z\\\", gitRef, \\\"--\\\"], {\\n   440\\t      cwd: this.workspace,\\n   441\\t      encoding: \\\"buffer\\\",\\n   442\\t      maxBuffer: 64 * 1024 * 1024,\\n   443\\t    }).toString(\\\"utf8\\\").split(\\\"\\\\0\\\").filter(Boolean);\\n   444\\t    if (changedPaths.some((relativePath) => path.basename(relativePath) === \\\".gitignore\\\")) {\\n   445\\t      throw new Error(\\\"Checkpoint Git ignore rules differ from the current worktree\\\");\\n   446\\t    }\\n   447\\t\\n   448\\t    for (const relativePath of directoryTargets) {\\n   449\\t      // A clean preview can be empty when the directory path is also tracked in the index,\\n   450\\t      // even though ordinary untracked children beneath it are removable.\\n   451\\t      if (this.directoryContainsOnlyGitCleanRemovableEntries(relativePath)\\n   452\\t        && this.gitTrackedDescendantPaths(relativePath).length === 0) {\\n   453\\t        continue;\\n   454\\t      }\\n   455\\t      if (!this.directoryContainsOnlyTrackedRemovableEntries(relativePath)) {\\n   456\\t        throw new Error(\\\"Checkpoint snapshot target directory contains entries preserved by Git clean\\\");\\n   457\\t      }\\n   458\\t    }\\n   459\\t  }\\n   460\\t\\n   461\\t  /** Tracked file entries that checkout-index may recreat