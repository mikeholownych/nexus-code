{"type":"api-request-blob","sessionId":"43bcbb67-2cff-4fa8-a05e-f8aa598df73b","hash":"4c3032f59b56769464b917ca796855d77b5d0707685114f648a19966c4b9f723","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_0139DAbK217qbFZFytHj8XvL","name":"Bash","input":{"command":"cd ~/nexus-code && bash -c 'for i in $(seq 1 14); do st=$(gh pr view 783 --json state --jq .state); c=$(gh pr checks 783 2>&1 | grep -E \"^(test-matrix|linux-x86_64)\" | grep -c pass); f=$(gh pr checks 783 2>&1 | grep -E \"^test-|^linux\" | grep -c fail); [ \"$st\" != OPEN ] && break; [ \"$c\" = 3 ] && break; [ \"$f\" != 0 ] && break; sleep 30; done; echo \"783: state $st pass $c fail $f head $(gh pr view 783 --json headRefOid --jq .headRefOid | cut -c1-8)\"; gh pr checks 783 2>&1 | grep -E \"^test-.*fail\" | cut -c1-50; git fetch -q origin; echo \"tip $(git rev-parse --short=8 origin/release/v1.3.0)\"; gh run list --branch release/v1.3.0 --workflow ci.yml --limit 1 --json status,conclusion,headSha --jq \".[0]|[.status,.conclusion,.headSha[0:8]]|@tsv\"'","description":"Wait for PR 783's checks at its new head and re-read the release state","timeout":480000},"caller":{"type":"direct"}}]}}
