e OperationEventType, type UnitRunResult, type WorkUnit } from \"../src/core/operation.js\";\norigin/main:cli/test/team_convergence.test.ts:205:      operationPolicy: { maxWaitMs: 3_600_000, unknownResumeBudget: 0, maxRunsPerUnit: 8, minWaitMs: 250 },\norigin/main:cli/test/team_convergence.test.ts:920:      const tryApply = (d: string, o: string, note?: string) => assert.throws(() => applyOperatorDecision(env.store, \"team-dec\", d, o, note), DecisionRejected);\n--- tests ---\ncli/test/convergence_scheduler_properties.test.ts\ncli/test/process_lifecycle.test.ts\n--- relevant open PRs ---\n#305 fde0b7b9 v1/fix-operation-restart-conversation fix(operation): restart unit conversation on fresh worktree\n--- operation runner silent catches ---\n   150\t            });\n   151\t            this.save();\n   152\t            continue;\n   153\t          }\n   154\t        }\n   155\t        if (await this.revalidator.beforeAssign(d.resource, signal)) continue;\n   156\t        this.scheduler.start(d);\n   157\t        this.save();\n   158\t        const result = await this.execute(d, signal);\n   159\t        if (result.kind === \"cancelled\" || signal?.aborted) {\n   160\t          this.scheduler.apply(d.unit.id, { kind: \"cancelled\" });\n   161\t          return this.cancelled();\n   162\t        }\n   163\t        this.scheduler.apply(d.unit.id, result);\n   164\t        this.save();\n   165\t        continue;\n   166\t      }\n   167\t      if (d.kind === \"wait\") {\n   168\t        this.scheduler.wait(d);\n   169\t        this.save();\n   170\t        if (this.opts.maxInProcessWaitMs !== undefined && d.wakeAt - this.clock.now() > this.opts.maxInProcessWaitMs) return this.state;\n   171\t        try {\n   172\t          await this.clock.sleep(Math.max(0, d.wakeAt - this.clock.now()), signal);\n   173\t        } catch {\n   174\t          return this.cancelled();\n   175\t        }\n   176\t        await this.revalidator.revalidate(signal);\n   177\t        continue;\n   178\t      }\n   179\t      this.scheduler.finish(d);\n   180\t      // A blocked operation keeps its unit worktrees: the retry/restart remedies run the unit again in them.\n   181\t      if (d.kind === \"complete\") this.git?.disposeAllUnits();\n   182\t      this.save();\n   183\t      return this.state;\n   184\t    }\n   185\t    this.scheduler.finish({\n   410\t  const release = store.acquire(id);\n   411\t  try {\n   412\t    const state = store.load(id);\n   413\t    const now = opts.now ?? Date.now;\n   414\t    const registry = new ResourceRegistry(state.resources, state.conditions, { now, random: Math.random });\n   415\t    new ConvergenceScheduler(state, registry, now, opts.onEvent, opts.onDiagnostic).resolve(decisionId, optionId, note);\n   416\t    state.conditions = registry.snapshot();\n   417\t    state.updatedAt = new Date(now()).toISOString();\n   418\t    store.save(state);\n   419\t    return state;\n   420\t  } finally {\n   421\t    release();\n   422\t  }\n   423\t}\n   424\t\n   425\t// ---------------------------------------------------------------- resources from configuration\n   426\t\n   427\tfunction origin(endpoint: string): string {\n   428\t  try {\n   429\t    return new URL(endpoint).origin;\n   430\t  } catch {\n   431\t    return endpoint;\n   432\t  }\n   433\t}\n   434\t\n   435\tfunction normalizeEndpoint(ep: string): string {\n   436\t  const e = ep.trim().replace(/\\/+$/, \"\");\n   437\t  return e.endsWith(\"/v1\") ? e : `${e}/v1`;\n   438\t}\n   439\t\n   440\t/** The configured planner/coder models keep their cognitive-routing roles as scheduling preferences. */\n--- scheduler test coverage ---\n/**\n * Generated dependency-graph invariants for ConvergenceScheduler.\n *\n * The fixed seeds make failures reproducible while exploring many valid DAG shapes.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { ConvergenceScheduler, newOperation } from \"../src/core/operation.js\";\nimport { ResourceRegistry, type ResourceDescriptor } from \"../src/core/resources.js\";\n\nfunction random(seed: number): () => number {\n  let state = seed >>> 0;\n  return () => {\n    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;\n    return state / 0x1_0000_0000;\n  };\n}\n\nfunction resource(): ResourceDescriptor {\n  return {\n    id: \"r1\",\n    provider: \"https://provider.test\",\n    endpoint: \"https://provider.test/v1\",\n    model: \"fixture\",\n    capabilities: [\"tools\"],\n    rank: 0,\n  };\n}\n\ntest(\"generated acyclic operations schedule only after dependencies complete and converge\", () => {\n  for (let seed = 1; seed <= 100; seed++) {\n    const next = random(seed);\n    const count = 1 + Math.floor(next() * 12);\n    const specs = Array.from({ length: count }, (_, index) => ({\n      id: `u${index}`,\n      prompt: `work ${index}`,\n      dependsOn: Array.from({ length: index }, (_, dependency) => dependency)\n        .filter(() => next() < 0.25)\n        .map((dependency) => `u${dependency}`),\n    }));\n    const now = 1_798_000_000_000;\n    const state = newOperation(`generated-${seed}`, \"generated objective\", specs, [resource()], now);\n    const registry = new ResourceRegistry(state.resources, [], { now: () => now, random: () => 0.5 });\n    const scheduler = new ConvergenceScheduler(state, registry, () => now);\n    const completed = new Set<string>();\n\n    for (let step = 0; step < count; step++) {\n      const decision = scheduler.decide();\n      assert.equal(decision.kind, \"run\", `seed ${seed}, step ${step}`);\n      if (decision.kind !== \"run\") break;\n      assert.ok(\n        decision.unit.dependsOn.every((dependency) => completed.has(dependency)),\n        `seed ${seed}: ${decision.unit.id} ran before its dependencies`,\n      );\n      scheduler.start(decision);\n      scheduler.apply(decision.unit.id, { kind: \"completed\", summary: \"done\", outcome: \"VERIFIED\" });\n      completed.add(decision.unit.id);\n    }\n\n    assert.equal(completed.size, count, `seed ${seed}: every generated unit should run`);\n    assert.equal(scheduler.decide().kind, \"complete\", `seed ${seed}: operation should converge`);\n  }\n});\n\ntest(\"scheduler event callback failures produce bounded debug diagnostics\", () => {\n  const now = 1_798_000_000_000;\n  const state = newOperation(\"scheduler-diagnostic\", \"objective\", [{ id: \"u1\", prompt: \"work\" }], [resource()], now);\n  const diagnostics: Array<{ level: string; area: string; action: string }> = [];\n  const scheduler = new ConvergenceScheduler(\n    state,\n    new ResourceRegistry(state.resources, [], { now: () => now, random: () => 0.5 }),\n    () => now,\n    () => { throw new Error(\"do not log exception details\"); },\n    (event) => diagnostics.push(event),\n  );\n\n  scheduler.emit(\"WORK_STARTED\", \"started\", { unitId: \"u1\" });\n\n  assert.deepEqual(diagnostics, [{ level: \"debug\", area: \"scheduler\", action: \"event_callback_failed\" }]);\n  assert.equal(JSON.stringify(diagnostics).includes(\"do not log\"), false);\n  assert.equal(state.events.at(-1)?.type, \"WORK_STARTED\", \"observer failure must not undo the scheduler event\");\n});\n","exit_code":0,"duration":{"secs":1,"nanos":799808359}},"started_at_ms":1793208930584,"completed_at_ms":1793208932385}}
