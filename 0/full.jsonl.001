pe: [\"*\"],\n    permittedCapabilities: [\"fs_read\"],\n  }));\n  assert.deepEqual(resolveDelegationContract(contract, layers).permittedCapabilities, [\"fs_read\"]);\n  assert.throws(() => resolveDelegationContract({ ...contract, permittedCapabilities: [\"fs_write\"] }, layers), /unauthorized capability/);\n});\n\ntest(\"dispatcher denies a delegated tool omitted from its host allowlist\", async () => {\n  const agent: any = {\n    delegatedToolAllowList: new Set([\"read_file\"]),\n    config: { dryRun: false },\n    activeWorktree: undefined,\n    currentTaskId: \"parent-1\",\n    capabilityRegistry: { getByToolName: (name: string) => ({ id: name }) },\n    lastToolReceipts: [],\n    getEffectiveTools: () => [],\n  };\n  const result = await dispatchToolCallImpl.call(agent, {\n    id: \"call-1\",\n    function: { name: \"write_file\", arguments: JSON.stringify({ path: \"src/a.ts\", content: \"bad\" }) },\n  } as any, 1, \"subagent\");\n  assert.equal(result.receipt.status, \"DENIED\");\n  assert.equal(result.receipt.denialReason, \"DELEGATION_AUTHORITY\");\n  assert.equal(result.receipt.candidateMutated, false);\n});\norigin/main:cli/test/agent_discovered_verifier_premutation.test.ts:107:      ? { kind: \"tools\", calls: [{ name: \"spawn_subagent\", args: { prompt: \"Fix the failing addition test.\", profile: \"implementer\" } }] }\norigin/main:cli/test/agent_observer.test.ts:408:          ? { kind: \"tools\", calls: [{ name: \"spawn_subagent\", args: { prompt: \"Inspect the workspace.\" } }] }\norigin/main:cli/test/agt111_subagent_parity.test.ts:105:        ? { kind: \"tools\", calls: [{ name: \"spawn_subagent\", args: { prompt: \"Read notes.txt and report.\" } }] }\norigin/main:cli/test/approval_policy.test.ts:31:  spawn_subagent: \"delegate\", activate_skill: \"context_inject\",\norigin/main:cli/test/capabilities.test.ts:38:      \"spawn_subagent\",\norigin/main:cli/test/code_evaluators.test.ts:436:      ? { kind: \"tools\", calls: [{ name: \"spawn_subagent\", 