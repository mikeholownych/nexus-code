{"timestamp":"2026-11-21T21:51:19.809Z","ordinal":35756,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20014-b98e-7f50-9b44-1c38f2a1201a","item":{"type":"CommandExecution","id":"exec-fd7ca1a0-3297-4e2a-b8f3-6304ee1d3ca2","process_id":"15009","command":["/usr/bin/zsh","-lc","git log --all --oneline --decorate --grep='P10\\|durable.*budget\\|aggregate.*budget' -i -30 && git show origin/main:cli/src/types.ts | sed -n '150,220p' && git show origin/main:cli/src/core/turn.ts | sed -n '320,380p' && git show origin/main:cli/src/core/delegation_contract.ts | sed -n '1,260p' && git show origin/main:cli/test/delegation_contract.test.ts | sed -n '1,180p'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git log --all --oneline --decorate --grep='P10\\|durable.*budget\\|aggregate.*budget' -i -30 && git show origin/main:cli/src/types.ts | sed -n '150,220p' && git show origin/main:cli/src/core/turn.ts | sed -n '320,380p' && git show origin/main:cli/src/core/delegation_contract.ts | sed -n '1,260p' && git show origin/main:cli/test/delegation_contract.test.ts | sed -n '1,180p'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"3f9e72b5 fix(agent): persist finite continuation budgets across delegation (#636)\n459827fc fix(tui): project validation receipts and worktree from application core state (F-WP10-MAT-01)\n659ead45 fix(tui): project validation receipts and worktree from application core state (F-WP10-MAT-01)\n  outcomeUnknown?: boolean;\n  /** Why the call was refused before it ran (a stable code, e.g. VERIFICATION_CONFIG_PROTECTED). */\n  denialReason?: string;\n}\n\n/**\n * Bounds for automatically continued work. The total-step limit is cumulative across every invocation that continues\n * the same durable objective; the wall-clock limit bounds one active invocation. Progress detection remains a separate\n * early-stop mechanism, not a substitute for these hard ceilings.\n */\nexport interface ContinuationBudget {\n  /** Maximum steps for one objective across runs and resumes (STEP_BUDGET_EXHAUSTED). */\n  maxTotalSteps: number;\n  /** Maximum wall-clock minutes for one invocation (TIME_BUDGET_EXHAUSTED). */\n  maxTurnMinutes: number;\n  /**\n   * Consecutive steps without observed progress before the turn stops (STAGNATION_DETECTED). A repeated-state\n   * threshold, not a task length: any progressing step resets it (core/execution_tracking.ts defines progress).\n   */\n  stagnationSteps: number;\n  /** Recovery notes the agent may inject for a repeated identical action before stopping (bounded recovery). */\n  maxRecoveries: number;\n  /** Times the agent may be asked to continue when it stops with acceptance requirements still open. */\n  maxCompletionNudges: number;\n  /**\n   * Consecutive failed verifier attempts on changing candidates that stop the turn as VERIFIER_NOT_CONVERGING when they\n   * show the same failure, an A/B alternation or a rising failing-test count (default 3, NEXUS_VERIFIER_CONVERGENCE_ATTEMPTS).\n   */\n  verifierConvergenceAttempts?: number;\n}\n\n/** Hard upper bounds keep an operator override finite even when a config or direct API caller bypasses CLI parsing. */\nexport const MAX_CONTINUATION_STEPS = 5_000;\nexport const MAX_CONTINUATION_MINUTES = 4_320;\n\nexport function assertValidContinuationBudget(budget: ContinuationBudget | undefined): void {\n  if (!budget) return;\n  if (!Number.isSafeInteger(budget.maxTotalSteps) || budget.maxTotalSteps < 1 || budget.maxTotalSteps > MAX_CONTINUATION_STEPS) {\n    throw new Error(`Invalid continuation step budget: expected an integer from 1 to ${MAX_CONTINUATION_STEPS}.`);\n  }\n  if (!Number.isFinite(budget.maxTurnMinutes) || budget.maxTurnMinutes < 1 / 60 || budget.maxTurnMinutes > MAX_CONTINUATION_MINUTES) {\n    throw new Error(`Invalid continuation time budget: expected a finite value from 1 second to ${MAX_CONTINUATION_MINUTES} minutes.`);\n  }\n}\n\n/** Failed verifier attempts on changing candidates that show no convergence before the turn stops (see ContinuationBudget). */\nexport const DEFAULT_CONVERGENCE_ATTEMPTS = 3;\n\nexport const DEFAULT_CONTINUATION: ContinuationBudget = {\n  maxTotalSteps: 500,\n  maxTurnMinutes: 480,\n  stagnationSteps: 12,\n  maxRecoveries: 2,\n  maxCompletionNudges: 2,\n};\n\nexport type ApprovalMode = \"auto\" | \"review\" | \"read-only\";\n  /**\n   * Context sizing and request counting: the limits in effect and where each came from (advertised, operator, client\n   * default), the tool-output headroom policy, capability availability, and how the last request was counted (source:\n   * exact_admitted, exact_sampled_worker, gateway_conservative, client_estimate), including worker differences.\n   */\n  tokenAccounting?: {\n    contextLimit: number;\n    contextSource: string;\n    outputAllowance: number;\n    outputSource: string;\n    toolHeadroomPolicy: number;\n    discovery: string;\n    tokenCounting: string;\n    limitsVersion?: string;\n    workers?: string[];\n    lastRequest?: {\n      step: number;\n      promptTokens: number;\n      source: string;\n      clientEstimate: number;\n      countedWorker?: string;\n      uncertainty?: string;\n      admittedTokens?: number;\n      admittedSource?: string;\n      admittedWorker?: string;\n      workerDiffers?: boolean;\n    };\n  };\n  /** Durable writes that failed during the turn (absent when every write succeeded). Never hidden behind a success. */\n  persistence?: { durable: false; failures: string[] };\n  continuation?: {\n    segments: number;\n    segmentSteps: number;\n    stopReason?: string;\n    stepsWithoutProgress: number;\n    /** Steps run on this objective across all its turns (observability; never a limit). */\n    cumulativeSteps?: number;\n    /** Demonstrated loops: the same action and result on an unchanged workspace, at least REPEAT_THRESHOLD times. */\n    repeated?: Array<{ action: string; count: number; firstStep: number; lastStep: number }>;\n    /** Why repetition could not be judged against workspace state this turn, when it could not. */\n    stateUncertainty?: string;\n  };\n  /**\n   * Tool outputs that left the context during the turn and were not read again, when the turn still ended VERIFIED or\n   * REGRESSION_FREE: the verifier's result stands, but the work may rest on observations the model no longer had.\n   */\n  contextNotRetained?: number;\n  /** Argument syntax of the tool calls the model issued this turn (native, repaired or invalid JSON); absent when none. */\n  toolCallSyntax?: ToolCallSyntaxCounts;\n  /** True when the turn paused deterministically after one model/tool cycle under step mode. */\n  stepPaused?: boolean;\n  /**\n   * What this turn itself did, so a verdict never reports earlier turns' changes or a pre-change verifier run as this\n   * turn's (TUI-AUDIT D-04). Absent on results built outside a turn.\n   */\n  turnEvidence?: TurnEvidence;\n  /** Present when the turn stopped because verifier attempts were not converging: the signal and the attempts behind it. */\n  convergence?: {\n    state: \"stalled\" | \"oscillating\" | \"diverging\";\n    evidence: string;\n    attempts: Array<{ n: number; command: string; status: string; classification?: string; failingTests?: string[]; failedCheck?: string; candidate: string }>;\nexport type DelegationExecutionMode = \"transient\" | \"durable\";\nexport type DelegationOutcomeStatus = \"COMPLETED\" | \"FAILED\" | \"BLOCKED\" | \"CANCELLED\" | \"INTERRUPTED\" | \"UNKNOWN_EFFECT\";\n\nexport interface DelegationModelRequirements {\n  capabilities?: string[];\n  minimumContext?: number;\n  qualification?: string;\n  independentOf?: string[];\n}\n\n/** Authority contributed by one existing policy boundary. Every layer narrows the resulting child authority. */\nexport interface DelegationAuthorityLayer {\n  source: \"parent\" | \"profile\" | \"task\" | \"session\" | \"workspace\";\n  permittedCapabilities: readonly string[];\n  authorizedScope: readonly string[];\n}\n\nexport interface DelegationContract {\n  id: string;\n  parentId: string;\n  objective: string;\n  profile: string;\n  inputs: Record<string, unknown>;\n  authorizedScope: string[];\n  permittedCapabilities: string[];\n  executionMode: DelegationExecutionMode;\n  contextBudget?: number;\n  outputBudget?: number;\n  executionDeadlineMs?: number;\n  modelRequirements?: DelegationModelRequirements;\n  dependencies?: string[];\n  expectedOutputSchema?: string;\n  requiresVerification: boolean;\n  requiresIndependentReview: boolean;\n}\n\nexport interface DelegationRuntimeLimits {\n  maxDepth: number;\n  maxChildrenPerParent: number;\n  maxActiveChildren: number;\n  maxInferenceSteps: number;\n  maxDurationMs: number;\n}\n\nfunction boundedLimit(name: string, fallback: number, minimum: number, maximum: number): number {\n  const raw = process.env[name];\n  if (raw === undefined || raw.trim() === \"\") return fallback;\n  if (!/^\\d+$/.test(raw)) throw new Error(`${name} must be an integer from ${minimum} to ${maximum}`);\n  const value = Number(raw);\n  if (!Number.isSafeInteger(value) || value < minimum || value > maximum) {\n    throw new Error(`${name} must be an integer from ${minimum} to ${maximum}`);\n  }\n  return value;\n}\n\n/** Optional operator tuning is strictly bounded; absent settings use conservative client-side limits. */\nexport function delegationRuntimeLimits(): DelegationRuntimeLimits {\n  return {\n    maxDepth: boundedLimit(\"NEXUS_DELEGATION_MAX_DEPTH\", 1, 1, 1),\n    maxChildrenPerParent: boundedLimit(\"NEXUS_DELEGATION_MAX_CHILDREN\", 4, 1, 16),\n    maxActiveChildren: boundedLimit(\"NEXUS_DELEGATION_MAX_ACTIVE\", 4, 1, 16),\n    maxInferenceSteps: boundedLimit(\"NEXUS_DELEGATION_MAX_STEPS\", 64, 1, 256),\n    maxDurationMs: boundedLimit(\"NEXUS_DELEGATION_MAX_DURATION_MS\", 120_000, 1_000, 600_000),\n  };\n}\n\nlet activeTransientChildren = 0;\nexport function acquireTransientDelegationSlot(maxActive: number): (() => void) | undefined {\n  if (!Number.isSafeInteger(maxActive) || maxActive < 1 || activeTransientChildren >= maxActive) return undefined;\n  activeTransientChildren++;\n  let released = false;\n  return () => {\n    if (!released) {\n      released = true;\n      activeTransientChildren = Math.max(0, activeTransientChildren - 1);\n    }\n  };\n}\n\nexport interface DelegationEvidence {\n  kind: string;\n  reference: string;\n  digest?: string;\n  summary?: string;\n}\n\nexport interface DelegationResourceUsage {\n  inferenceRequests: number;\n  toolCalls: number;\n  elapsedMs: number;\n  inputTokens?: { value: number; source: \"reported\" | \"estimated\" };\n  outputTokens?: { value: number; source: \"reported\" | \"estimated\" };\n}\n\n/** A child receipt keeps its status, evidence, uncertainty, usage, and remaining work distinct. */\nexport interface DelegationOutcome {\n  id: string;\n  parentId: string;\n  status: DelegationOutcomeStatus;\n  summary: string;\n  evidence: DelegationEvidence[];\n  uncertainty: string[];\n  resourceUsage: DelegationResourceUsage;\n  outstandingObligations: string[];\n}\n\nconst CAPABILITY_ID = /^[a-z][a-z0-9_.:-]*$/;\n\nfunction capabilityIds(values: readonly string[], label: string): string[] {\n  const output: string[] = [];\n  for (const value of values) {\n    if (typeof value !== \"string\") throw new Error(`${label} contains a non-string capability identity`);\n    const canonical = value.trim().toLowerCase();\n    if (!CAPABILITY_ID.test(canonical)) throw new Error(`${label} contains an invalid capability identity ${JSON.stringify(value)}`);\n    if (!output.includes(canonical)) output.push(canonical);\n  }\n  return output;\n}\n\nfunction scopes(values: readonly string[], label: string): string[] {\n  const output: string[] = [];\n  for (const value of values) {\n    if (typeof value !== \"string\") throw new Error(`${label} contains a non-string path`);\n    const written = value.trim().replace(/\\\\/g, \"/\");\n    if (written === \"*\") {\n      if (!output.includes(\"*\")) output.push(\"*\");\n      continue;\n    }\n    if (!written || written.startsWith(\"/\") || /^[A-Za-z]:/.test(written)) {\n      throw new Error(`${label} contains a path that is not workspace-relative: ${JSON.stringify(value)}`);\n    }\n    if (/[*?\\[\\]]/.test(written)) throw new Error(`${label} contains a non-canonical path pattern: ${JSON.stringify(value)}`);\n    const parts = written.split(\"/\").filter((part) => part && part !== \".\");\n    if (!parts.length || parts.includes(\"..\")) throw new Error(`${label} contains a path traversal: ${JSON.stringify(value)}`);\n    const canonical = parts.join(\"/\");\n    if (!output.includes(canonical)) output.push(canonical);\n  }\n  return output;\n}\n\nfunction withinScope(path: string, allowed: string): boolean {\n  return allowed === \"*\" || path === allowed || path.startsWith(`${allowed}/`);\n}\n\nfunction cloneAndFreeze<T>(value: T): T {\n  if (Array.isArray(value)) return Object.freeze(value.map((entry) => cloneAndFreeze(entry))) as T;\n  if (value && typeof value === \"object\") {\n    const copy = Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, cloneAndFreeze(entry)]));\n    return Object.freeze(copy) as T;\n  }\n  return value;\n}\n\nfunction inheritedCapabilities(layers: readonly DelegationAuthorityLayer[]): string[] {\n  if (!layers.length) return [];\n  return capabilityIds(layers[0].permittedCapabilities, layers[0].source)\n    .filter((candidate) => layers.slice(1).every((layer) => capabilityIds(layer.permittedCapabilities, layer.source).includes(candidate)));\n}\n\nfunction inheritedScopes(layers: readonly DelegationAuthorityLayer[]): string[] {\n  if (!layers.length) return [];\n  let effective = scopes(layers[0].authorizedScope, layers[0].source);\n  for (const layer of layers.slice(1)) {\n    const next = scopes(layer.authorizedScope, layer.source);\n    const narrowed: string[] = [];\n    for (const parent of effective) {\n      for (const child of next) {\n        if (parent === \"*\") narrowed.push(child);\n        else if (child === \"*\" || withinScope(child, parent)) narrowed.push(child);\n        else if (withinScope(parent, child)) narrowed.push(parent);\n      }\n    }\n    effective = [...new Set(narrowed)];\n  }\n  return effective;\n}\n\n/**\n * Validates a contract and binds its requested authority to the intersection of parent, profile, task, session and\n * workspace policy. Requests outside that intersection are refused before admission; this function never grants them.\n */\nexport function resolveDelegationContract(\n  contract: DelegationContract,\n  layers: readonly DelegationAuthorityLayer[],\n): DelegationContract {\n  if (!contract || typeof contract !== \"object\" || Array.isArray(contract)) throw new Error(\"delegation contract must be an object\");\n  for (const [field, value] of Object.entries({ id: contract.id, parentId: contract.parentId, objective: contract.objective, profile: contract.profile })) {\n    if (typeof value !== \"string\" || !value.trim()) throw new Error(`delegation contract needs a non-empty '${field}'`);\n  }\n  if (contract.executionMode !== \"transient\" && contract.executionMode !== \"durable\") throw new Error(\"delegation contract has an invalid executionMode\");\n  if (!contract.inputs || typeof contract.inputs !== \"object\" || Array.isArray(contract.inputs)) throw new Error(\"delegation contract 'inputs' must be an object\");\n  if (!Array.isArray(contract.permittedCapabilities)) throw new Error(\"delegation contract 'permittedCapabilities' must be an array\");\n  if (!Array.isArray(contract.authorizedScope)) throw new Error(\"delegation contract 'authorizedScope' must be an array\");\n  if (typeof contract.requiresVerification !== \"boolean\" || typeof contract.requiresIndependentReview !== \"boolean\") {\n    throw new Error(\"delegation contract verification requirements must be booleans\");\n  }\n  if (contract.modelRequirements !== undefined && (!contract.modelRequirements || typeof contract.modelRequirements !== \"object\" || Array.isArray(contract.modelRequirements))) {\n    throw new Error(\"delegation contract 'modelRequirements' must be an object\");\n  }\n  if (contract.modelRequirements?.capabilities !== undefined && (!Array.isArray(contract.modelRequirements.capabilities) || contract.modelRequirements.capabilities.some((value) => typeof value !== \"string\"))) {\n    throw new Error(\"delegation contract 'modelRequirements.capabilities' must be an array of strings\");\n  }\n  if (contract.modelRequirements?.independentOf !== undefined && (!Array.isArray(contract.modelRequirements.independentOf) || contract.modelRequirements.independentOf.some((value) => typeof value !== \"string\"))) {\n    throw new Error(\"delegation contract 'modelRequirements.independentOf' must be an array of strings\");\n  }\n  if (contract.dependencies !== undefined && (!Array.isArray(contract.dependencies) || contract.dependencies.some((value) => typeof value !== \"string\"))) {\n    throw new Error(\"delegation contract 'dependencies' must be an array of strings\");\n  }\n  if (contract.expectedOutputSchema !== undefined && typeof contract.expectedOutputSchema !== \"string\") {\n    throw new Error(\"delegation contract 'expectedOutputSchema' must be a string\");\n  }\n  for (const [field, value] of Object.entries({ contextBudget: contract.contextBudget, outputBudget: contract.outputBudget, executionDeadlineMs: contract.executionDeadlineMs, minimumContext: contract.modelRequirements?.minimumContext })) {\n    if (value !== undefined && (!Number.isSafeInteger(value) || value <= 0)) throw new Error(`delegation contract '${field}' must be a positive safe integer`);\n  }\n\n  const requestedCapabilities = capabilityIds(contract.permittedCapabilities, \"contract\");\n  const allowedCapabilities = inheritedCapabilities(layers);\n  const deniedCapabilities = requestedCapabilities.filter((capability) => !allowedCapabilities.includes(capability));\n  if (deniedCapabilities.length) throw new Error(`delegation requests unauthorized capability ${deniedCapabilities.join(\", \")}`);\n\n  const requestedScope = scopes(contract.authorizedScope, \"contract\");\n  const allowedScope = inheritedScopes(layers);\n  const deniedPaths = requestedScope.filter((requested) => !allowedScope.some((allowed) => withinScope(requested, allowed)));\n  if (deniedPaths.length) throw new Error(`delegation requests path outside inherited scope ${deniedPaths.join(\", \")}`);\n\n  return cloneAndFreeze({\n    ...contract,\n    authorizedScope: requestedScope,\n    permittedCapabilities: requestedCapabilities,\n  });\n}\n\nconst OUTCOME_STATUSES = new Set<DelegationOutcomeStatus>([\n  \"COMPLETED\", \"FAILED\", \"BLOCKED\", \"CANCELLED\", \"INTERRUPTED\", \"UNKNOWN_EFFECT\",\n]);\n\n/** Validates and freezes the bounded receipt returned by a delegated execution. */\nexport function createDelegationOutcome(outcome: DelegationOutcome): DelegationOutcome {\n  if (!outcome || typeof outcome !== \"object\" || Array.isArray(outcome)) throw new Error(\"delegation outcome must be an object\");\n  for (const field of [\"id\", \"parentId\", \"summary\"] as const) {\n    if (typeof outcome[field] !== \"string\" || !outcome[field].trim()) throw new Error(`delegation outcome needs a non-empty '${field}'`);\n  }\n  if (!OUTCOME_STATUSES.has(outcome.status)) throw new Error(\"delegation outcome has an invalid status\");\n  if (!Array.isArray(outcome.evidence) || outcome.evidence.some((item) =>\n    !item || typeof item !== \"object\" || typeof item.kind !== \"string\" || !item.kind.trim() ||\n    typeof item.reference !== \"string\" || !item.reference.trim() ||\n    (item.digest !== undefined && typeof item.digest !== \"string\") ||\n    (item.summary !== undefined && typeof item.summary !== \"string\"))) {\n    throw new Error(\"delegation outcome evidence must contain kind and reference strings\");\n  }\n  for (const field of [\"uncertainty\", \"outstandingObligations\"] as const) {\n    if (!Array.isArray(outcome[field]) || outcome[field].some((entry) => typeof entry !== \"string\")) {\n      throw new Error(`delegation outcome '${field}' must be an array of strings`);\n    }\n  }\n  const usage = outcome.resourceUsage;\n  if (!usage || typeof usage !== \"object\" || Array.isArray(usage)) throw new Error(\"delegation outcome resourceUsage must be an object\");\n  for (const field of [\"inferenceRequests\", \"toolCalls\"] as const) {\n    if (!Number.isSafeInteger(usage[field]) || usage[field] < 0) throw new Error(`${field} must be a non-negative integer`);\n  }\nimport assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { createDelegationOutcome, resolveDelegationContract, type DelegationAuthorityLayer, type DelegationContract } from \"../src/core/delegation_contract.js\";\n\nconst base = {\n  id: \"child-1\",\n  parentId: \"parent-1\",\n  objective: \"Inspect the requested files\",\n  profile: \"semantic_explorer\",\n  inputs: {},\n  authorizedScope: [\"src\"],\n  permittedCapabilities: [\"fs_read\", \"code_search_lexical\"],\n  executionMode: \"transient\" as const,\n  requiresVerification: true,\n  requiresIndependentReview: false,\n};\n\nfunction authority(overrides: Partial<DelegationAuthorityLayer> = {}): DelegationAuthorityLayer {\n  return {\n    source: \"parent\",\n    permittedCapabilities: [\"fs_read\", \"code_search_lexical\", \"proc_exec\"],\n    authorizedScope: [\"*\"],\n    ...overrides,\n  };\n}\n\ntest(\"delegation authority is the intersection of parent, profile, session, workspace and task policy\", () => {\n  const resolved = resolveDelegationContract({ ...base, authorizedScope: [\"src/lib\"], permittedCapabilities: [\"fs_read\"] }, [\n    authority(),\n    authority({ source: \"profile\", permittedCapabilities: [\"fs_read\", \"code_search_lexical\"], authorizedScope: [\"src\"] }),\n    authority({ source: \"task\", permittedCapabilities: [\"fs_read\"], authorizedScope: [\"src/lib\"] }),\n    authority({ source: \"session\", permittedCapabilities: [\"fs_read\", \"proc_exec\"], authorizedScope: [\"src\"] }),\n    authority({ source: \"workspace\", permittedCapabilities: [\"fs_read\", \"code_search_lexical\"], authorizedScope: [\"src\"] }),\n  ]);\n\n  assert.deepEqual(resolved.permittedCapabilities, [\"fs_read\"]);\n  assert.deepEqual(resolved.authorizedScope, [\"src/lib\"]);\n});\n\ntest(\"delegation cannot request a capability outside inherited authority\", () => {\n  assert.throws(\n    () => resolveDelegationContract({ ...base, permittedCapabilities: [\"fs_read\", \"admin_exec\"] }, [authority()]),\n    /unauthorized capability.*admin_exec/,\n  );\n});\n\ntest(\"delegation cannot broaden inherited path scope\", () => {\n  assert.throws(\n    () => resolveDelegationContract({ ...base, authorizedScope: [\"src\", \"secrets\"] }, [authority({ authorizedScope: [\"src/lib\"] })]),\n    /outside inherited scope.*secrets/,\n  );\n});\n\ntest(\"capability identities normalize before intersection and empty policy fails closed\", () => {\n  const normalized = resolveDelegationContract(\n    { ...base, permittedCapabilities: [\" FS_READ \", \"FS_READ\"] },\n    [authority({ permittedCapabilities: [\"fs_read\"] })],\n  );\n  assert.deepEqual(normalized.permittedCapabilities, [\"fs_read\"]);\n  const denied = resolveDelegationContract({ ...base, permittedCapabilities: [], authorizedScope: [] }, []);\n  assert.deepEqual(denied.permittedCapabilities, []);\n  assert.deepEqual(denied.authorizedScope, []);\n});\n\ntest(\"malformed model-generated authority fields are refused before admission\", () => {\n  assert.throws(\n    () => resolveDelegationContract({ ...base, permittedCapabilities: undefined as unknown as string[] }, [authority()]),\n    /permittedCapabilities.*must be an array/,\n  );\n  assert.throws(\n    () => resolveDelegationContract({ ...base, modelRequirements: [] as unknown as DelegationContract[\"modelRequirements\"] }, [authority()]),\n    /modelRequirements.*must be an object/,\n  );\n});\n\ntest(\"resolved authority cannot be widened by mutating the returned contract\", () => {\n  const resolved = resolveDelegationContract({ ...base, permittedCapabilities: [\"fs_read\"] }, [authority()]);\n\n  assert.throws(() => resolved.permittedCapabilities.push(\"proc_exec\"), TypeError);\n  assert.deepEqual(resolved.permittedCapabilities, [\"fs_read\"]);\n});\n\ntest(\"delegation outcomes preserve all terminal states and keep evidence and obligations separate\", () => {\n  const statuses = [\"COMPLETED\", \"FAILED\", \"BLOCKED\", \"CANCELLED\", \"INTERRUPTED\", \"UNKNOWN_EFFECT\"] as const;\n  const outcomes = statuses.map((status) => createDelegationOutcome({\n    id: `child-${status.toLowerCase()}`,\n    parentId: \"parent-1\",\n    status,\n    summary: \"Partial report\",\n    evidence: [{ kind: \"test\", reference: \"test.log\", digest: \"abc123\" }],\n    uncertainty: status === \"UNKNOWN_EFFECT\" ? [\"write may have reached the filesystem\"] : [],\n    resourceUsage: {\n      inferenceRequests: 2,\n      toolCalls: 3,\n      elapsedMs: 1250,\n      inputTokens: { value: 120, source: \"estimated\" },\n    },\n    outstandingObligations: [\"verify the generated file\"],\n  }));\n\n  assert.deepEqual(outcomes.map((outcome) => outcome.status), statuses);\n  assert.deepEqual(outcomes[5].uncertainty, [\"write may have reached the filesystem\"]);\n  assert.deepEqual(outcomes[0].outstandingObligations, [\"verify the generated file\"]);\n  assert.equal(outcomes[0].resourceUsage.inputTokens?.source, \"estimated\");\n});\n\ntest(\"delegation outcomes reject impossible or unlabeled resource measurements\", () => {\n  assert.throws(\n    () => createDelegationOutcome({\n      id: \"child-bad\",\n      parentId: \"parent-1\",\n      status: \"COMPLETED\",\n      summary: \"Done\",\n      evidence: [],\n      uncertainty: [],\n      resourceUsage: { inferenceRequests: -1, toolCalls: 0, elapsedMs: 10 },\n      outstandingObligations: [],\n    }),\n    /inferenceRequests must be a non-negative integer/,\n  );\n  assert.throws(\n    () => createDelegationOutcome({\n      id: \"child-unlabeled\",\n      parentId: \"parent-1\",\n      status: \"COMPLETED\",\n      summary: \"Done\",\n      evidence: [],\n      uncertainty: [],\n      resourceUsage: { inferenceRequests: 1, toolCalls: 0, elapsedMs: 10, inputTokens: { value: 42, source: \"observed\" } },\n      outstandingObligations: [],\n    } as unknown as DelegationOutcome),\n    /token usage source must be reported or estimated/,\n  );\n});\n","exit_code":0,"duration":{"secs":0,"nanos":134328054}},"started_at_ms":1795297879674,"completed_at_ms":1795297879809}}
{"timestamp":"2026-11-21T21:51:19.981Z","ordinal":35757,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a20017-a7ad-76d0-b37f-75f7ab55a6d3","call_id":"call_5aec37c97a4748048c84736a842ed347","output":[{"type":"input_text","text":"Script completed\nWall time 0.5 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 6144)\nTotal output lines: 515\n\n3f9e72b5 fix(agent): persist finite continuation budgets across delegation (#636)\n459827fc fix(tui): project validation receipts and worktree from application core state (F-WP10-MAT-01)\n659ead45 fix(tui): project validation receipts and worktree from application core state (F-WP10-MAT-01)\n  outcomeUnknown?: boolean;\n  /** Why the call was refused before it ran (a stable code, e.g. VERIFICATION_CONFIG_PROTECTED). */\n  denialReason?: string;\n}\n\n/**\n * Bounds for automatically continued work. The total-step limit is cumulative across every invocation that continues\n * the same durable objective; the wall-clock limit bounds one active invocation. Progress detection remains a separate\n * early-stop mechanism, not a substitute for these hard ceilings.\n */\nexport interface ContinuationBudget {\n  /** Maximum steps for one objective across runs and resumes (STEP_BUDGET_EXHAUSTED). */\n  maxTotalSteps: number;\n  /** Maximum wall-clock minutes for one invocation (TIME_BUDGET_EXHAUSTED). */\n  maxTurnMinutes: number;\n  /**\n   * Consecutive steps without observed progress before the turn stops (STAGNATION_DETECTED). A repeated-state\n   * threshold, not a task length: any progressing step resets it (core/execution_tracking.ts defines progress).\n   */\n  stagnationSteps: number;\n  /** Recovery notes the agent may inject for a repeated identical action before stopping (bounded recovery). */\n  maxRecoveries: number;\n  /** Times the agent may be asked to continue when it stops with acceptance requirements still open. */\n  maxCompletionNudges: number;\n  /**\n   * Consecutive failed verifier attempts on changing candidates that stop the turn as VERIFIER_NOT_CONVERGING when they\n   * show the same failure, an A/B alternation or a rising failing-test count (default 3, NEXUS_VERIFIER_CONVERGENCE_ATTEMPTS).\n   */\n  verifierConvergenceAttempts?: number;\n}\n\n/** Hard upper bounds keep an operator override finite even when a config or direct API caller bypasses CLI parsing. */\nexport const MAX_CONTINUATION_STEPS = 5_000;\nexport const MAX_CONTINUATION_MINUTES = 4_320;\n\nexport function assertValidContinuationBudget(budget: ContinuationBudget | undefined): void {\n  if (!budget) return;\n  if (!Number.isSafeInteger(budget.maxTotalSteps) || budget.maxTotalSteps < 1 || budget.maxTotalSteps > MAX_CONTINUATION_STEPS) {\n    throw new Error(`Invalid continuation step budget: expected an integer from 1 to ${MAX_CONTINUATION_STEPS}.`);\n  }\n  if (!Number.isFinite(budget.maxTurnMinutes) || budget.maxTurnMinutes < 1 / 60 || budget.maxTurnMinutes > MAX_CONTINUATION_MINUTES) {\n    throw new Error(`Invalid continuation time budget: expected a finite value from 1 second to ${MAX_CONTINUATION_MINUTES} minutes.`);\n  }\n}\n\n/** Failed verifier attempts on changing candidates that show no convergence before the turn stops (see ContinuationBudget). */\nexport const DEFAULT_CONVERGENCE_ATTEMPTS = 3;\n\nexport const DEFAULT_CONTINUATION: ContinuationBudget = {\n  maxTotalSteps: 500,\n  maxTurnMinutes: 480,\n  stagnationSteps: 12,\n  maxRecoveries: 2,\n  maxCompletionNudges: 2,\n};\n\nexport type ApprovalMode = \"auto\" | \"review\" | \"read-only\";\n  /**\n   * Context sizing and request counting: the limits in effect and where each came from (advertised, operator, client\n   * default), the tool-output headroom policy, capability availability, and how the last request was counted (source:\n   * exact_admitted, exact_sampled_worker, gateway_conservative, client_estimate), including worker differences.\n   */\n  tokenAccounting?: {\n    contextLimit: number;\n    contextSource: string;\n    outputAllowance: number;\n    outputSource: string;\n    toolHeadroomPolicy: number;\n    discovery: string;\n    tokenCounting: string;\n    limitsVersion?: string;\n    workers?: string[];\n    lastRequest?: {\n      step: number;\n      promptTokens: number;\n      source: string;\n      clientEstimate: number;\n      countedWorker?: string;\n      uncertainty?: string;\n      admittedTokens?: number;\n      admittedSource?: string;\n      admittedWorker?: string;\n      workerDiffers?: boolean;\n    };\n  };\n  /** Durable writes that failed during the turn (absent when every write succeeded). Never hidden behind a success. */\n  persistence?: { durable: false; failures: string[] };\n  continuation?: {\n    segments: number;\n    segmentSteps: number;\n    stopReason?: string;\n    stepsWithoutProgress: number;\n    /** Steps run on this objective across all its turns (observability; never a limit). */\n    cumulativeSteps?: number;\n    /** Demonstrated loops: the same action and result on an unchanged workspace, at least REPEAT_THRESHOLD times. */\n    repeated?: Array<{ action: string; count: number; firstStep: number; lastStep: number }>;\n    /** Why repetition could not be judged against workspace state this turn, when it could not. */\n    stateUncertainty?: string;\n  };\n  /**\n   * Tool outputs that left the context during the turn and were not read again, when the turn still ended VERIFIED or\n   * REGRESSION_FREE: the verifier's result stands, but the work may rest on observations the model no longer had.\n   */\n  contextNotRetained?: number;\n  /** Argument syntax of the tool calls the model issued this turn (native, repaired or invalid JSON); absent when none. */\n  toolCallSyntax?: ToolCallSyntaxCounts;\n  /** True when the turn paused deterministically after one model/tool cycle under step mode. */\n  stepPaused?: boolean;\n  /**\n   * What this turn itself did, so a verdict never reports earlier turns' changes or a pre-change verifier run as this\n   * turn's (TUI-AUDIT D-04). Absent on results built outside a turn.\n   */\n  turnEvidence?: TurnEvidence;\n  /** Present when the turn stopped because verifier attempts were not converging: the signal and the attempts behind it. */\n  convergence?: {\n    state: \"stalled\" | \"oscillating\" | \"diverging\";\n    evidence: string;\n    attempts: Array<{ n: number; command: string; status: string; classification?: string; failingTests?: string[]; failedCheck?: string; candidate: string }>;\nexport type DelegationExecutionMode = \"transient\" | \"durable\";\nexport type DelegationOutcomeStatus = \"COMPLETED\" | \"FAILED\" | \"BLOCKED\" | \"CANCELLED\" | \"INTERRUPTED\" | \"UNKNOWN_EFFECT\";\n\nexport interface DelegationModelRequirements {\n  capabilities?: string[];\n  minimumContext?: number;\n  qualification?: string;\n  independentOf?: string[];\n}\n\n/** Authority contributed by one existing policy boundary. Every layer narrows the resulting child authority. */\nexport interface DelegationAuthorityLayer {\n  source: \"parent\" | \"profile\" | \"task\" | \"session\" | \"workspace\";\n  permittedCapabilities: readonly string[];\n  authorizedScope: readonly string[];\n}\n\nexport interface DelegationContract {\n  id: string;\n  parentId: string;\n  objective: string;\n  profile: string;\n  inputs: Record<string, unknown>;\n  authorizedScope: string[];\n  permittedCapabilities: string[];\n  executionMode: DelegationExecutionMode;\n  contextBudget?: number;\n  outputBudget?: number;\n  executionDeadlineMs?: number;\n  modelRequirements?: DelegationModelRequirements;\n  dependencies?: string[];\n  expectedOutputSchema?: string;\n  requiresVerification: boolean;\n  requiresIndependentReview: boolean;\n}\n\nexport interface DelegationRuntimeLimits {\n  maxDepth: number;\n  maxChildrenPerParent: number;\n  maxActiveChildren: number;\n  maxInferenceSteps: number;\n  maxDurationMs: number;\n}\n\nfunction boundedLimit(name: string, fallback: number, minimum: number, maximum: number): number {\n  const raw = process.env[name];\n  if (raw === undefined || raw.trim() === \"\") return fallback;\n  if (!/^\\d+$/.test(raw)) throw new Error(`${name} must be an integer from ${minimum} to ${maximum}`);\n  const value = Number(raw);\n  if (!Number.isSafeInteger(value) || value < minimum || value > maximum) {\n    throw new Error(`${name} must be an integer from ${minimum} to ${maximum}`);\n  }\n  return value;\n}\n\n/** Optional operator tuning is strictly bounded; absent settings use conservative client-side limits. */\nexport function delegationRuntimeLimits(): DelegationRuntimeLimits {\n  return {\n    maxDepth: boundedLimit(\"NEXUS_DELEGATION_MAX_DEPTH\", 1, 1, 1),\n    maxChildrenPerParent: boundedLimit(\"NEXUS_DELEGATION_MAX_CHILDREN\", 4, 1, 16),\n    maxActiveChildren: boundedLimit(\"NEXUS_DELEGATION_MAX_ACTIVE\", 4, 1, 16),\n    maxInferenceSteps: boundedLimit(\"NEXUS_DELEGATION_MAX_STEPS\", 64, 1, 256),\n    maxDurationMs: boundedLimit(\"NEXUS_DELEGATION_MAX_DURATION_MS\", 120_000, 1_000, 600_000),\n  };\n}\n\nlet activeTransientChildren = 0;\nexport function acquireTransientDelegationSlot(maxActive: number): (() => void) | undefined {\n  if (!Number.isSafeInteger(maxActive) || maxActive < 1 || activeTransientChildren >= maxActive) return undefined;\n  activeTransientChildren++;\n  let released = false;\n  return () => {\n    if (!released) {\n      released = true;\n      activeTransientChildren = Math.max(0, activeTransientChildren - 1);\n    }\n  };\n}\n\nexport interface DelegationEvidence {\n  kind: string;\n  reference: string;\n  digest?: string;\n  summary?: string;\n}\n\nexport interface DelegationResourceUsage {\n  inferenceRequests: number;\n  toolCalls: number;\n  elapsedMs: number;\n  inputTokens?: { value: number; source: \"reported\" | \"estimated\" };\n  outputTokens?: { value: number; source: \"reported\" | \"estimated\" };\n}\n\n/** A child receipt keeps its status, evidence, uncertainty, usage, and remaining work distinct. */\nexport interface DelegationOutcome {\n  id: string;\n  parentId: string;\n  status: DelegationOutcomeStatus;\n  summary: string;\n  evidence: DelegationEvidence[];\n  uncertainty: string[];\n  resourceUsage: DelegationResourceUsage;\n  outstandingObligations: string[];\n}\n\nconst CAPABILITY_ID = /^[a-z][a-z0-9_.:-]*$/;\n\nfunction capabilityIds(values: readonly string[], label: string): string[] {\n  const output: string[] = [];\n  for (const value of values) {\n    if (typeof value !== \"string\") throw new Error(`${label} contains a non-string capability identity`);\n    const canonical = value.trim().toLowerCase();\n    i…1144 tokens truncated…delRequirements' must be an object\");\n  }\n  if (contract.modelRequirements?.capabilities !== undefined && (!Array.isArray(contract.modelRequirements.capabilities) || contract.modelRequirements.capabilities.some((value) => typeof value !== \"string\"))) {\n    throw new Error(\"delegation contract 'modelRequirements.capabilities' must be an array of strings\");\n  }\n  if (contract.modelRequirements?.independentOf !== undefined && (!Array.isArray(contract.modelRequirements.independentOf) || contract.modelRequirements.independentOf.some((value) => typeof value !== \"string\"))) {\n    throw new Error(\"delegation contract 'modelRequirements.independentOf' must be an array of strings\");\n  }\n  if (contract.dependencies !== undefined && (!Array.isArray(contract.dependencies) || contract.dependencies.some((value) => typeof value !== \"string\"))) {\n    throw new Error(\"delegation contract 'dependencies' must be an array of strings\");\n  }\n  if (contract.expectedOutputSchema !== undefined && typeof contract.expectedOutputSchema !== \"string\") {\n    throw new Error(\"delegation contract 'expectedOutputSchema' must be a string\");\n  }\n  for (const [field, value] of Object.entries({ contextBudget: contract.contextBudget, outputBudget: contract.outputBudget, executionDeadlineMs: contract.executionDeadlineMs, minimumContext: contract.modelRequirements?.minimumContext })) {\n    if (value !== undefined && (!Number.isSafeInteger(value) || value <= 0)) throw new Error(`delegation contract '${field}' must be a positive safe integer`);\n  }\n\n  const requestedCapabilities = capabilityIds(contract.permittedCapabilities, \"contract\");\n  const allowedCapabilities = inheritedCapabilities(layers);\n  const deniedCapabilities = requestedCapabilities.filter((capability) => !allowedCapabilities.includes(capability));\n  if (deniedCapabilities.length) throw new Error(`delegation requests unauthorized capability ${deniedCapabilities.join(\", \")}`);\n\n  const requestedScope = scopes(contract.authorizedScope, \"contract\");\n  const allowedScope = inheritedScopes(layers);\n  const deniedPaths = requestedScope.filter((requested) => !allowedScope.some((allowed) => withinScope(requested, allowed)));\n  if (deniedPaths.length) throw new Error(`delegation requests path outside inherited scope ${deniedPaths.join(\", \")}`);\n\n  return cloneAndFreeze({\n    ...contract,\n    authorizedScope: requestedScope,\n    permittedCapabilities: requestedCapabilities,\n  });\n}\n\nconst OUTCOME_STATUSES = new Set<DelegationOutcomeStatus>([\n  \"COMPLETED\", \"FAILED\", \"BLOCKED\", \"CANCELLED\", \"INTERRUPTED\", \"UNKNOWN_EFFECT\",\n]);\n\n/** Validates and freezes the bounded receipt returned by a delegated execution. */\nexport function createDelegationOutcome(outcome: DelegationOutcome): DelegationOutcome {\n  if (!outcome || typeof outcome !== \"object\" || Array.isArray(outcome)) throw new Error(\"delegation outcome must be an object\");\n  for (const field of [\"id\", \"parentId\", \"summary\"] as const) {\n    if (typeof outcome[field] !== \"string\" || !outcome[field].trim()) throw new Error(`delegation outcome needs a non-empty '${field}'`);\n  }\n  if (!OUTCOME_STATUSES.has(outcome.status)) throw new Error(\"delegation outcome has an invalid status\");\n  if (!Array.isArray(outcome.evidence) || outcome.evidence.some((item) =>\n    !item || typeof item !== \"object\" || typeof item.kind !== \"string\" || !item.kind.trim() ||\n    typeof item.reference !== \"string\" || !item.reference.trim() ||\n    (item.digest !== undefined && typeof item.digest !== \"string\") ||\n    (item.summary !== undefined && typeof item.summary !== \"string\"))) {\n    throw new Error(\"delegation outcome evidence must contain kind and reference strings\");\n  }\n  for (const field of [\"uncertainty\", \"outstandingObligations\"] as const) {\n    if (!Array.isArray(outcome[field]) || outcome[field].some((entry) => typeof entry !== \"string\")) {\n      throw new Error(`delegation outcome '${field}' must be an array of strings`);\n    }\n  }\n  const usage = outcome.resourceUsage;\n  if (!usage || typeof usage !== \"object\" || Array.isArray(usage)) throw new Error(\"delegation outcome resourceUsage must be an object\");\n  for (const field of [\"inferenceRequests\", \"toolCalls\"] as const) {\n    if (!Number.isSafeInteger(usage[field]) || usage[field] < 0) throw new Error(`${field} must be a non-negative integer`);\n  }\nimport assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { createDelegationOutcome, resolveDelegationContract, type DelegationAuthorityLayer, type DelegationContract } from \"../src/core/delegation_contract.js\";\n\nconst base = {\n  id: \"child-1\",\n  parentId: \"parent-1\",\n  objective: \"Inspect the requested files\",\n  profile: \"semantic_explorer\",\n  inputs: {},\n  authorizedScope: [\"src\"],\n  permittedCapabilities: [\"fs_read\", \"code_search_lexical\"],\n  executionMode: \"transient\" as const,\n  requiresVerification: true,\n  requiresIndependentReview: false,\n};\n\nfunction authority(overrides: Partial<DelegationAuthorityLayer> = {}): DelegationAuthorityLayer {\n  return {\n    source: \"parent\",\n    permittedCapabilities: [\"fs_read\", \"code_search_lexical\", \"proc_exec\"],\n    authorizedScope: [\"*\"],\n    ...overrides,\n  };\n}\n\ntest(\"delegation authority is the intersection of parent, profile, session, workspace and task policy\", () => {\n  const resolved = resolveDelegationContract({ ...base, authorizedScope: [\"src/lib\"], permittedCapabilities: [\"fs_read\"] }, [\n    authority(),\n    authority({ source: \"profile\", permittedCapabilities: [\"fs_read\", \"code_search_lexical\"], authorizedScope: [\"src\"] }),\n    authority({ source: \"task\", permittedCapabilities: [\"fs_read\"], authorizedScope: [\"src/lib\"] }),\n    authority({ source: \"session\", permittedCapabilities: [\"fs_read\", \"proc_exec\"], authorizedScope: [\"src\"] }),\n    authority({ source: \"workspace\", permittedCapabilities: [\"fs_read\", \"code_search_lexical\"], authorizedScope: [\"src\"] }),\n  ]);\n\n  assert.deepEqual(resolved.permittedCapabilities, [\"fs_read\"]);\n  assert.deepEqual(resolved.authorizedScope, [\"src/lib\"]);\n});\n\ntest(\"delegation cannot request a capability outside inherited authority\", () => {\n  assert.throws(\n    () => resolveDelegationContract({ ...base, permittedCapabilities: [\"fs_read\", \"admin_exec\"] }, [authority()]),\n    /unauthorized capability.*admin_exec/,\n  );\n});\n\ntest(\"delegation cannot broaden inherited path scope\", () => {\n  assert.throws(\n    () => resolveDelegationContract({ ...base, authorizedScope: [\"src\", \"secrets\"] }, [authority({ authorizedScope: [\"src/lib\"] })]),\n    /outside inherited scope.*secrets/,\n  );\n});\n\ntest(\"capability identities normalize before intersection and empty policy fails closed\", () => {\n  const normalized = resolveDelegationContract(\n    { ...base, permittedCapabilities: [\" FS_READ \", \"FS_READ\"] },\n    [authority({ permittedCapabilities: [\"fs_read\"] })],\n  );\n  assert.deepEqual(normalized.permittedCapabilities, [\"fs_read\"]);\n  const denied = resolveDelegationContract({ ...base, permittedCapabilities: [], authorizedScope: [] }, []);\n  assert.deepEqual(denied.permittedCapabilities, []);\n  assert.deepEqual(denied.authorizedScope, []);\n});\n\ntest(\"malformed model-generated authority fields are refused before admission\", () => {\n  assert.throws(\n    () => resolveDelegationContract({ ...base, permittedCapabilities: undefined as unknown as string[] }, [authority()]),\n    /permittedCapabilities.*must be an array/,\n  );\n  assert.throws(\n    () => resolveDelegationContract({ ...base, modelRequirements: [] as unknown as DelegationContract[\"modelRequirements\"] }, [authority()]),\n    /modelRequirements.*must be an object/,\n  );\n});\n\ntest(\"resolved authority cannot be widened by mutating the returned contract\", () => {\n  const resolved = resolveDelegationContract({ ...base, permittedCapabilities: [\"fs_read\"] }, [authority()]);\n\n  assert.throws(() => resolved.permittedCapabilities.push(\"proc_exec\"), TypeError);\n  assert.deepEqual(resolved.permittedCapabilities, [\"fs_read\"]);\n});\n\ntest(\"delegation outcomes preserve all terminal states and keep evidence and obligations separate\", () => {\n  const statuses = [\"COMPLETED\", \"FAILED\", \"BLOCKED\", \"CANCELLED\", \"INTERRUPTED\", \"UNKNOWN_EFFECT\"] as const;\n  const outcomes = statuses.map((status) => createDelegationOutcome({\n    id: `child-${status.toLowerCase()}`,\n    parentId: \"parent-1\",\n    status,\n    summary: \"Partial report\",\n    evidence: [{ kind: \"test\", reference: \"test.log\", digest: \"abc123\" }],\n    uncertainty: status === \"UNKNOWN_EFFECT\" ? [\"write may have reached the filesystem\"] : [],\n    resourceUsage: {\n      inferenceRequests: 2,\n      toolCalls: 3,\n      elapsedMs: 1250,\n      inputTokens: { value: 120, source: \"estimated\" },\n    },\n    outstandingObligations: [\"verify the generated file\"],\n  }));\n\n  assert.deepEqual(outcomes.map((outcome) => outcome.status), statuses);\n  assert.deepEqual(outcomes[5].uncertainty, [\"write may have reached the filesystem\"]);\n  assert.deepEqual(outcomes[0].outstandingObligations, [\"verify the generated file\"]);\n  assert.equal(outcomes[0].resourceUsage.inputTokens?.source, \"estimated\");\n});\n\ntest(\"delegation outcomes reject impossible or unlabeled resource measurements\", () => {\n  assert.throws(\n    () => createDelegationOutcome({\n      id: \"child-bad\",\n      parentId: \"parent-1\",\n      status: \"COMPLETED\",\n      summary: \"Done\",\n      evidence: [],\n      uncertainty: [],\n      resourceUsage: { inferenceRequests: -1, toolCalls: 0, elapsedMs: 10 },\n      outstandingObligations: [],\n    }),\n    /inferenceRequests must be a non-negative integer/,\n  );\n  assert.throws(\n    () => createDelegationOutcome({\n      id: \"child-unlabeled\",\n      parentId: \"parent-1\",\n      status: \"COMPLETED\",\n      summary: \"Done\",\n      evidence: [],\n      uncertainty: [],\n      resourceUsage: { inferenceRequests: 1, toolCalls: 0, elapsedMs: 10, inputTokens: { value: 42, source: \"observed\" } },\n      outstandingObligations: [],\n    } as unknown as DelegationOutcome),\n    /token usage source must be reported or estimated/,\n  );\n});\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20014-b98e-7f50-9b44-1c38f2a1201a","create_time":1795297879.9816875}},"metadata":{"history_sequence":15956,"sampled_through_sequence":15953,"client_authored":false,"fallback_token_limit_override":12000}}
