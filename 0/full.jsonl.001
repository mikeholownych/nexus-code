ath\": \"cli/test/convergence_invariants.test.ts\",\n            \"start_line\": 39,\n            \"end_line\": 39,\n            \"signature\": \"checkpoints : Req[]\"\n          },\n          \"reason\": \"task match (graph store)\"\n        }\n      ]\n    },\n    \"source\": \"graph-context\"\n  },\n  \"status\": {\n    \"generated_at\": \"2026-10-28T16:43:55.873824848Z\",\n    \"repo\": {\n      \"root\": \"/home/mike/nexus-code\",\n      \"key\": \"gh/mikeholownych/nexus-code\"\n    },\n    \"brain\": {\n      \"path\": \"/home/mike/.local/share/entire/plugins/data/brain/repos/gh/mikeholownych/nexus-code\",\n      \"schema_version\": 4,\n      \"supported_schema_version\": 4,\n      \"manifest_state\": \"current\",\n      \"generated_at\": \"2026-10-28T16:40:59Z\"\n    },\n    \"sources\": {\n      \"seed\": false,\n      \"sessions\": true,\n      \"semantic\": true,\n      \"history\": true,\n      \"facts\": true,\n      \"docs\": true\n    },\n    \"facts\": {\n      \"facts\": 200,\n      \"distilled\": 200,\n      \"authored\": 0,\n      \"superseded\": 0,\n      \"branches\": 1,\n      \"proposals\": 28\n    },\n    \"hosted\": {\n      \"state\": \"connected\",\n      \"repo_state\": \"connected\",\n      \"no_egress\": false,\n      \"repo_id\": \"01M5ZYH5RC035FNYGB8DHGEZJV\",\n      \"base_url\": \"https://aws-us-east-2.api.entire.io\",\n      \"synced_branches\": [\n        \"main\"\n      ]\n    },\n    \"semantic\": {\n      \"provider\": {\n        \"name\": \"entire-graph\",\n        \"version\": \"v0.6.0\",\n        \"schema_version\": \"1.4\",\n        \"store_path\": \"graph-owned\",\n        \"capabilities\": [\n          \"local-only\",\n          \"ndjson\",\n          \"partial-failures\",\n          \"stable-symbol-id-v1\"\n        ]\n      },\n      \"freshness\": {\n        \"severity\": \"degraded\",\n        \"axes\": {\n          \"graph\": {\n            \"state\": \"ok\",\n            \"detail\": \"Graph owns the committed-tree store\",\n            \"current\": \"31303130761ea23027800c993c7e17291e2a2d3f\",\n            \"indexed\": \"31303130761ea23027800c993c7e17291e2a2d3f\"\n          },\n          \"worktree\": {\n            \"state\": \"dirty-unindexed\",\n            \"detail\": \"Graph store describes committed HEAD\"\n          }\n        }\n      }\n    },\n    \"retrieval\": {\n      \"docs_generated_at\": \"2026-10-28T07:36:39Z\",\n      \"conversation\": {\n        \"exchanges\": 0,\n        \"vector_state\": \"removed\"\n      },\n      \"freshness\": {\n        \"severity\": \"unsafe\",\n        \"axes\": {\n          \"docs\": {\n            \"state\": \"unsafe\",\n            \"detail\": \"docs index provenance cannot be checked without a seed source\",\n            \"remedy\": \"run `entire brain refresh --agent none` to rebuild both\"\n          },\n          \"seed\": {\n            \"state\": \"missing\",\n            \"detail\": \"no seed source in manifest; run entire brain refresh --agent none\"\n          }\n        }\n      }\n    },\n    \"onboarding\": {\n      \"facts_backfill\": {\n        \"sessions\": 10,\n        \"distilled\": 10,\n        \"running\": false,\n        \"pid\": 1609188,\n        \"started_at\": \"2026-10-28T07:43:29.356449859Z\",\n        \"agent\": \"codex\",\n        \"log_path\": \"/home/mike/.local/state/entire/repos/gh/mikeholownych/nexus-code/backfill.log\"\n      },\n      \"daemon\": {\n        \"manager\": \"systemd\",\n        \"label\": \"entire-brain-watch.service\",\n        \"unit_path\": \"/home/mike/.config/systemd/user/entire-brain-watch.service\",\n        \"installed\": true,\n        \"current\": true,\n        \"running\": true\n      },\n      \"last_tick_at\": \"2026-10-28T07:44:26.493369455Z\",\n      \"components\": [\n        {\n          \"name\": \"sessions\",\n          \"state\": \"built\"\n        },\n        {\n          \"name\": \"seed\",\n          \"state\": \"failed\",\n          \"detail\": \"dirty_worktre