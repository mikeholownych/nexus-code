validateBaseUrl } from \"./provider_safety.js\";\nimport { DEFAULT_OPERATION_POLICY } from \"./core/operation.js\";\nimport { setSandboxNetworkFlag } from \"./sandbox_network.js\";\nimport { readSmallFile } from \"./core/checkout_trust.js\";\nimport { resolveRepeatedCallSettings } from \"./core/repeated_calls.js\";\nimport { ContinuationBudget, DEFAULT_CONTINUATION, DEFAULT_CONVERGENCE_ATTEMPTS, MAX_CONTINUATION_MINUTES, MAX_CONTINUATION_STEPS, HarnessConfig, ApprovalMode } from \"./types.js\";\n\n/** A project `.env` larger than this is ignored (it is repository-controlled). */\nconst MAX_PROJECT_ENV_BYTES = 256 * 1024;\n\nconst installEnv = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../.env\");\nconst DEFAULT_ENDPOINT = \"http://localhost:1234/v1\";\nlet credentialAuthorityRecorded = false;\nlet shellEnvironment: Record<string, string | undefined> = {};\nlet userConfigFile: Record<string, string> = {};\n\n/** Names set by ~/.config/nexus/config.env (not their values), so a child process can be kept clear of them. */\nexport function userConfigEnvKeys(): string[] {\n  return Object.keys(userConfigFile);\n}\nlet operatorJsonOperationPolicy: HarnessConfig[\"operationPolicy\"];\nlet operatorJsonOperationPolicyError: Error | undefined;\nconst SHELL_PRECEDENCE_KEYS = [\"NEXUS_VERIFY_ATTESTATION\"] as const;\nconst OPERATOR_CONFIG_JSON_LIMIT = 64 * 1024;\n\n/** Read UTF-8 config data with a strict byte cap, even if the open file grows after stat. */\n  const model = provider ? options.model || operatorSetting(\"NEXUS_MODEL\") || \"\" : options.model || (options.appliance ? applianceEndpointOverride?.model : undefined) || effectiveSetting(\"LOCAL_LLM_MODEL\") || \"local-model\";\n  // Stored gateway credentials are not baked in here: the client attaches them only to the gateway they belong to.\n  const provisionalKey = options.appliance ? pendingApplianceEndpointKey(endpoint) : undefined;\n  const operatorKey = operatorSetting(\"LOCAL_LLM_API_KEY\");\n  const projectApiKey = REDACTED;\n  const configuredCredentialOrigin = operatorSetting(\"LOCAL_LLM_CREDENTIAL_ORIGIN\");\n  const operatorOrigin = credentialOriginOf(configuredCredentialOrigin ?? operatorSetting(\"LOCAL_LLM_ENDPOINT\") ?? options.endpoint ?? DEFAULT_ENDPOINT);\n  const invalidOperatorBinding = Boolean(operatorKey && configuredCredentialOrigin && !operatorOrigin);\n  const projectCredential = projectSetting(\"LOCAL_LLM_API_KEY\");\n  const invalidFallback = projectCredential !== undefined ? (projectCredential === operatorKey ? undefined : projectCredential) : (projectApiKey === operatorKey ? undefined : projectApiKey);\n  const envCredential = options.apiKey || provider ? undefined : environmentCredential(options.endpoint || DEFAULT_ENDPOINT);\n  const apiKey = options.apiKey || (provider ? providerKey(provider) : provisionalKey || (invalidOperatorBinding ? invalidFallback : operatorKey || projectApiKey || envCredential?.apiKey)) || \"local\";\n  const credentialOrigin = apiKey === \"local\" ? undefined : options.apiKey || provider || provisionalKey ? credentialOriginOf(endpoint) : (invalidOperatorBinding ? credentialOriginOf(endpoint) : (operatorKey ? operatorOrigin : (projectApiKey ? credentialOriginOf(endpoint) : envCredential?.origin)));\n  const workspace = options.workspace ? path.resolve(options.workspace) : process.cwd();\n  const maxSteps = options.maxSteps ? parseInt(options.maxSteps, 10) : 30;\n  const continuation = continuationBudget(options);\n  const repeatedCalls = repeatedCallSettings();\n  const temperature = options.temperature ? parseFloat(options.temperature) : 0.2;\n  const shell = options.shell || operatorSetting(\"LOCAL_HARNESS_SHELL\") || process.env.LOCAL_HARNESS_SHELL || \"bash\";\n  const dryRun = Boolean(options.dryRun);\n  const readOnly = Boolean(options.readOnly);\nexport interface FunctionCall {\n  name: string;\n  arguments: string;\n}\n\nexport interface ToolCall {\n  id: string;\n  type: \"function\";\n  function: FunctionCall;\n}\n\n/** Sanitized, opt-in evaluator receipt for a real run_command invocation. */\nexport interface EvaluationToolReceipt {\n  invocationId: string;\n  tool: \"run_command\";\n  commandSha256: string;\n  timeoutSecs: number | null;\n  exitCode: number | null;\n// doctor), and a dependency bump should not change the CLI contract, so keep that. Set before any subcommand is\n// created: subcommands copy this setting when they are added.\nprogram.allowExcessArguments(true);\n\nprogram\n  .name(\"nexus\")\n  .description(\"Nexus Code - Custom Autonomous Coding Harness for Local AI (LM Studio / vLLM)\")\n  .version(getBuildIdentity().string)\n  .option(\"--repl\", \"Start interactive coding session (REPL)\")\n  .option(\"--live\", \"Start live TUI\")\n  .option(\"-r, --resume [id]\", \"Resume previous session (defaults to latest if id omitted)\")\n  .option(\"--fork-session <id>\", \"Start in a new copy of the named session (the original is never changed; prints the new id)\")\n  .option(\"--fork-at <n>\", \"With --fork-session: copy only the first n messages (default: all)\")\n  .option(\"--approve\", \"Require human approval before destructive actions (edits, shell commands)\")\n  .option(\"-y, --yes\", \"Run non-interactively without approval prompts (forces auto mode)\")\n  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\n  .option(\"--read-only\", \"Reject all mutating tool executions and commands\")\n  .option(\"-e, --endpoint <url>\", \"Local LLM endpoint (default: $LOCAL_LLM_ENDPOINT)\")\n  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in vLLM)\")\n  .option(\"-w, --workspace <path>\", \"Workspace directory (default: current directory)\")\n  .option(\"-s, --max-steps <number>\", \"Steps per segment; continuation checkpoints there instead of stopping (default: 30)\")\n  .option(\"--max-total-steps <number>\", \"Continuation: objective-wide step limit shared across resumes (default: 500)\")\n  .option(\"--strict-token-count\", \"Refuse a request the connection could not count on a worker (default: proceed on the labelled estimate)\")\n  .option(\"--max-turn-minutes <number>\", \"Continuation: active invocation wall-clock limit in minutes (default: 480)\")\n  .option(\"--stagnation-steps <number>\", \"Continuation: stop after this many steps without progress (default 12)\")\n  .option(\"--no-continuation\", \"End a turn at --max-steps instead of continuing while it makes progress\")\n  .option(\"-t, --temperature <number>\", \"Model temperature (default: 0.2)\")\n  .option(\"--shell <type>\", \"Linux shell to use: bash, zsh, or sh (default: bash)\", \"bash\")\n  .option(\"--fallback <urls>\", \"Comma-separated fallback LLM endpoints if primary is unavailable\")\n  .option(\"--context-limit <tokens>\", \"Context window limit in tokens; below the provider's advertised capacity it is kept, above it the advertised capacity applies (default: advertised capacity, else 65536)\")\n  .option(\"--dry-run\", \"Simulate file modifications without writing changes to disk\")\n  .option(\"--sandbox [mode]\", \"Isolate command execution using bubblewrap (bwrap) or Docker (default: auto)\")\n  .option(\"--sandbox-network\", \"With --sandbox: let sandboxed commands and the sandboxed native worker use the network (off by default; also NEXUS_SANDBOX_NETWORK=1 in the operator environment)\")\n  .option(\"--worktree\", \"Isolate execution inside an ephemeral git worktree under .nexus/worktrees/<task-id>\")\n  .option(\"--worktree-branch <name>\", \"Run inside the named git worktree for this branch (created if missing); kept after the run, merge it with `nexus worktree merge`\")\n  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\n  .option(\"--deliverable-file <path>\", \"Operator-declared workspace-relative product file used for VERIFIED binding (repeatable)\", collectDeliverableFile, [])\n  .option(\"--record-flight\", \"Record execution into an append-only deterministic .flightlog\")\n  .option(\"--planner-model <name>\", \"Deep reasoning model for architecture planning (o3, R1, Sonnet)\")\n  .option(\"--planner-endpoint <url>\", \"Dedicated inference endpoint for planner model\")\n  .option(\"--coder-model <name>\", \"High-throughput model for surgical code implementation (Qwen 2.5 Coder)\")\n  .option(\"--coder-endpoint <url>\", \"Dedicated inference endpoint for coder model\")\n  .option(\"--provider <id>\", \"Cloud inference provider: openrouter, openai, anthropic, compatible (default: appliance endpoint)\")\n  .option(\"--base-url <url>\", \"Override the provider's base URL (operator-only; required for 'compatible')\")\n  .option(\"--planner-provider <id>\", \"Cloud provider for the planner model (requires --planner-model)\")\n  .option(\"--coder-provider <id>\", \"Cloud provider for the coder model (requires --coder-model)\")\n  .action(async (options: any, cmd: Command) => {\n    if (cmd.args && cmd.args.length > 0) {\n      program.error(`error: unknown command '${cmd.args[0]}'`);\n    }\n    await runDefault(options);\n  });\n\nprogram\n  .command(\"repl\")\n  .description(\"Start interactive coding session (REPL / TUI)\")\n  .option(\"-e, --endpoint <url>\", \"Local LLM endpoint (default: $LOCAL_LLM_ENDPOINT)\")\n  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in vLLM)\")\n  .option(\"-w, --workspace <path>\", \"Workspace directory (default: current directory)\")\n  .option(\"-s, --max-steps <number>\", \"Steps per segment; continuation checkpoints there instead of stopping (default: 30)\")\n  .option(\"--max-total-steps <number>\", \"Continuation: objective-wide step limit shared across resumes (default: 500)\")\n  .option(\"--strict-token-count\", \"Refuse a request the connection could not count on a worker (default: proceed on the labelled estimate)\")\n  .option(\"--max-turn-minutes <number>\", \"Continuation: active invocation wall-clock limit in minutes (default: 480)\")\n  .option(\"--stagnation-steps <number>\", \"Continuation: stop after this many steps without progress (default 12)\")\n  .option(\"--no-continuation\", \"End a turn at --max-steps instead of continuing while it makes progress\")\n  .option(\"-t, --temperature <number>\", \"Model temperature (default: 0.2)\")\n  .option(\"--shell <type>\", \"Linux shell to use: bash, zsh, or sh (default: bash)\", \"bash\")\n  .option(\"--fallback <urls>\", \"Comma-separated fallback LLM endpoints if primary is unavailable\")\n  .option(\"--context-limit <tokens>\", \"Context window limit in tokens; below the provider's advertised capacity it is kept, above it the advertised capacity applies (default: advertised capacity, else 65536)\")\n  .option(\"--dry-run\", \"Simulate file modifications without writing changes to disk\")\n  .option(\"--read-only\", \"Reject all mutating tool executions and commands\")\n  .option(\"--sandbox [mode]\", \"Isolate command execution using bubblewrap (bwrap) or Docker (default: auto)\")\n  .option(\"--sandbox-network\", \"With --sandbox: let sandboxed commands and the sandboxed native worker use the network (off by default; also NEXUS_SANDBOX_NETWORK=1 in the operator environment)\")\n  .option(\"--worktree\", \"Isolate execution inside an ephemeral git worktree under .nexus/worktrees/<task-id>\")\n  .option(\"--worktree-branch <name>\", \"Run inside the named git worktree for this branch (created if missing); kept after the run, merge it with `nexus worktree merge`\")\n  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\n  .option(\"--deliverable-file <path>\", \"Operator-declared workspace-relative product file used for VERIFIED binding (repeatable)\", collectDeliverableFile, [])\n  .option(\"--record-flight\", \"Record execution into an append-only deterministic .flightlog\")\n  .option(\"--planner-model <name>\", \"Deep reasoning model for architecture planning (o3, R1, Sonnet)\")\n  .option(\"--planner-endpoint <url>\", \"Dedicated inference endpoint for planner model\")\n  .option(\"--coder-model <name>\", \"High-throughput model for surgical code implementation (Qwen 2.5 Coder)\")\n  .option(\"--coder-model <name>\", \"High-throughput model for surgical code implementation (Qwen 2.5 Coder)\")\n  .option(\"--coder-endpoint <url>\", \"Dedicated inference endpoint for coder model\")\n  .option(\"--approve\", \"Require human approval before destructive actions (edits, shell commands)\")\n  .option(\"-y, --yes\", \"Run non-interactively without approval prompts (forces auto mode)\")\n  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\n  .option(\"--provider <id>\", \"Cloud inference provider: openrouter, openai, anthropic, compatible (default: appliance endpoint)\")\n  .option(\"--base-url <url>\", \"Override the provider's base URL (operator-only; required for 'compatible')\")\n  .option(\"--planner-provider <id>\", \"Cloud provider for the planner model (requires --planner-model)\")\n  .option(\"--coder-provider <id>\", \"Cloud provider for the coder model (requires --coder-model)\")\n  .option(\"-r, --resume [id]\", \"Resume previous session (defaults to latest if id omitted)\")\n  .option(\"--fork-session <id>\", \"Start in a new copy of the named session (the original is never changed; prints the new id)\")\n  .option(\"--fork-at <n>\", \"With --fork-session: copy only the first n messages (default: all)\")\n  .action(async (_options: any, cmd: Command) => {\n    const options = commandOptions(cmd);\n    await startRepl(options);\n  });\n\nprogram\n  .command(\"run\")\n  .description(\"Run an autonomous coding task\")\n  .argument(\"[prompt...]\", \"The coding instructions / task prompt\")\n  .option(\"-e, --endpoint <url>\", \"Local LLM endpoint (default: http://localhost:1234/v1 or $LOCAL_LLM_ENDPOINT)\")\n  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in LM Studio/vLLM)\")\n  .option(\"-w, --workspace <path>\", \"Workspace directory to inspect and modify (default: current directory)\")\n  .option(\"-s, --max-steps <number>\", \"Steps per segment; continuation checkpoints there instead of stopping\", \"30\")\n  .option(\"--max-total-steps <number>\", \"Continuation: objective-wide step limit shared across resumes (default: 500)\")\n  .option(\"--strict-token-count\", \"Refuse a request the connection could not count on a worker (default: proceed on the labelled estimate)\")\n  .option(\"--max-turn-minutes <number>\", \"Continuation: active invocation wall-clock limit in minutes (default: 480)\")\n  .option(\"--stagnation-steps <number>\", \"Continuation: stop after this many steps without progress (default 12)\")\n  .option(\"--no-continuation\", \"End a turn at --max-steps instead of continuing while it makes progress\")\n  .option(\"-t, --temperature <number>\", \"Model temperature\", \"0.2\")\n  .option(\"--shell <type>\", \"Linux shell to use: bash, zsh, or sh (default: bash or $LOCAL_HARNESS_SHELL)\", \"bash\")\n  .option(\"--fallback <urls>\", \"Comma-separated fallback LLM endpoints if primary is unavailable\")\n  .option(\"--context-limit <tokens>\", \"Context window limit in tokens; below the provider's advertised capacity it is kept, above it the advertised capacity applies (default: advertised capacity, else 65536)\")\n","exit_code":0,"duration":{"secs":0,"nanos":845248111}},"started_at_ms":1795301201116,"completed_at_ms":1795301201962}}
