sages?.map((message) => ({ role: message.role, content: typeof message.content === \"string\" ? message.content.slice(-240) : JSON.stringify(message.content).slice(-240) }))))}`);\n+      const requestIndex = captured.findIndex((messages) => messages.includes(example.objective));\n+      assert.notEqual(requestIndex, -1, `captured candidate request is missing ${example.id}`);\n+      requestIndexByTask.set(example.id, requestIndex);\n+      const request = captured[requestIndex];\n       assert.equal(request.includes(\"/hidden/\"), false, `hidden oracle path leaked to candidate request for ${example.id}`);\n@@ -153,3 +151,3 @@\n           invocations: 1,\n-          requestSha256: createHash(\"sha256\").update(captured[requests.findIndex((request) => JSON.stringify(request.messages).includes(benchmark.find((example) => example.id === taskId).objective))]).digest(\"hex\"),\n+          requestSha256: createHash(\"sha256\").update(JSON.stringify(requests[requestIndexByTask.get(taskId)])).digest(\"hex\"),\n           validatorResult: { hiddenPass: record.hiddenPass, regressionPass: record.regressionPass, exitCode: record.exitCode, timedOut: record.timedOut },\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /home/mike/nexus-wt/v112-wp1104-integration/eval/package_runtime.test.mjs\n","stderr":""},"started_at_ms":1793608692747,"completed_at_ms":1793608692748}}
