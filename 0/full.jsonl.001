ckedParent, \\\"captured.txt\\\"), \\\"checkpoint tracked content\\\\n\\\");\\n+    git(\\\"add\\\", \\\"a/captured.txt\\\");\\n+    git(\\\"commit\\\", \\\"-qm\\\", \\\"tracked nested destination\\\");\\n+    const manager = new CheckpointManager(repo);\\n+    const checkpoint = manager.createCheckpoint(\\\"tracked path below nested repo\\\");\\n+\\n+    fs.rmSync(trackedParent, { recursive: true, force: true });\\n+    fs.mkdirSync(trackedParent);\\n+    nestedGit(\\\"init\\\", \\\"-q\\\");\\n+    nestedGit(\\\"config\\\", \\\"user.email\\\", \\\"nested@example.invalid\\\");\\n+    nestedGit(\\\"config\\\", \\\"user.name\\\", \\\"Nested Test\\\");\\n+    fs.writeFileSync(path.join(trackedParent, \\\"captured.txt\\\"), \\\"nested repository canary\\\\n\\\");\\n+    nestedGit(\\\"add\\\", \\\"captured.txt\\\");\\n+    nestedGit(\\\"commit\\\", \\\"-qm\\\", \\\"nested canary\\\");\\n+    const nestedHeadBefore = nestedGit(\\\"rev-parse\\\", \\\"HEAD\\\");\\n+    const nestedIndexBefore = execFileSync(\\\"git\\\", [\\\"-C\\\", trackedParent, \\\"ls-files\\\", \\\"--stage\\\", \\\"-z\\\"], { encoding: \\\"buffer\\\" }).toString(\\\"hex\\\");\\n+\\n+    fs.writeFileSync(path.join(repo, \\\"staged-after-checkpoint.txt\\\"), \\\"staged canary\\\\n\\\");\\n+    git(\\\"add\\\", \\\"staged-after-checkpoint.txt\\\");\\n+    const outerHeadBefore = git(\\\"rev-parse\\\", \\\"HEAD\\\");\\n+    const outerIndexBefore = execFileSync(\\\"git\\\", [\\\"ls-files\\\", \\\"--stage\\\", \\\"-z\\\"], { cwd: repo, encoding: \\\"buffer\\\" }).toString(\\\"hex\\\");\\n+\\n+    const result = manager.restore(checkpoint.id);\\n+\\n+    assert.equal(result.success, false);\\n+    assert.match(result.message, /destination|unsafe|snapshot/i);\\n+    assert.equal(fs.readFileSync(path.join(trackedParent, \\\"captured.txt\\\"), \\\"utf8\\\"), \\\"nested repository canary\\\\n\\\");\\n+    assert.equal(nestedGit(\\\"rev-parse\\\", \\\"HEAD\\\"), nestedHeadBefore);\\n+    const nestedIndexAfter = execFileSync(\\\"git\\\", [\\\"-C\\\", trackedParent, \\\"ls-files\\\", \\\"--stage\\\", \\\"-z\\\"], { encoding: \\\"buffer\\\" }).toString(\\\"hex\\\");\\n+    assert.equal(nestedIndexAfter, nestedIndexBefore, \\\"rejection must preserve nested repository index entries\\\");\\n+    assert.equal(git(\\\"rev-parse\\\", \\\"HEAD\\\"), outerHeadBefore);\\n+    const outerIndexAfter = execFileSync(\\\"git\\\", [\\\"ls-files\\\", \\\"--stage\\\", \\\"-z\\\"], { cwd: repo, encoding: \\\"buffer\\\" }).toString(\\\"hex\\\");\\n+    assert.equal(outerIndexAfter, outerIndexBefore, \\\"rejection must preserve outer index entries\\\");\\n+    assert.equal(fs.readFileSync(path.join(repo, \\\"staged-after-checkpoint.txt\\\"), \\\"utf8\\\"), \\\"staged canary\\\\n\\\");\\n+  } finally {\\n+    cleanupGitRepo(repo);\\n+  }\\n+});\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a182b5-7df6-71b2-a955-13339511caaf","create_time":1793194963.508818}}}
{"timestamp":"2026-10-28T13:42:54.218Z","ordinal":458135,"type":"token_usage_record","payload":{"thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a182b5-7df6-71b2-a955-13339511caaf","session_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","root_turn_id":"01a182b5-7df6-71b2-a955-13339511caaf","response_id":"resp_0db389702a7164cc016ae1fbcad5e4819fb5545deddf15dbb2","usage":{"input_tokens":131856,"cached_input_tokens":127872,"cache_write_input_tokens":0,"output_tokens":2520,"reasoning_output_tokens":879,"total_tokens":134376},"turn_token_usage":{"input_tokens":9906852,"cached_input_tokens":9699584,"cache_write_input_tokens":0,"output_tokens":42213,"reasoning_output_tokens":27745,"total_tokens":9949065},"thread_token_usage":{"input_tokens":8482973483,"cached_input_tokens":8392123136,"cache_write_input_tokens":0,"output_tokens":24211647,"reasoning_output_tokens":14004068,"total_tokens":8507185130}}}
{"timestamp":"2026-10-28T13:42:54.263Z","ordinal":458136,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a182b5-7df6-71b2-a955-13339511caaf","item":{"type":"FileChange","id":"exec-e3e48156-cabc-4329-b33b-920dcfc45090","changes":{"/home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/test/checkpoint_restore.test.ts":{"type":"update","unified_diff":"@@ -1040,2 +1040,47 @@\n \n+test(\"Git manifest restore refuses a tracked destination inside a nested repository before changing either index\", () => {\n+  const { repo, git } = gitRepo();\n+  const trackedParent = path.join(repo, \"a\");\n+  const nestedGit = (...args: string[]) => execFileSync(\"git\", [\"-C\", trackedParent, ...args], { encoding: \"utf8\" }).trim();\n+  try {\n+    fs.mkdirSync(trackedParent);\n+    fs.writeFileSync(path.join(trackedParent, \"captured.txt\"), \"checkpoint tracked content\\n\");\n+    git(\"add\", \"a/captured.txt\");\n+    git(\"commit\", \"-qm\", \"tracked nested destination\");\n+    const manager = new CheckpointManager(repo);\n+    const checkpoint = manager.createCheckpoint(\"tracked path below nested repo\");\n+\n+    fs.rmSync(trackedParent, { recursive: true, force: true });\n+    fs.mkdirSync(trackedParent);\n+    nestedGit(\"init\", \"-q\");\n+    nestedGit(\"config\", \"user.email\", \"nested@example.invalid\");\n+    nestedGit(\"config\", \"user.name\", \"Nested Test\");\n+    fs.writeFileSync(path.join(trackedParent, \"captured.txt\"), \"nested repository canary\\n\");\n+    nestedGit(\"add\", \"captured.txt\");\n+    nestedGit(\"commit\", \"-qm\", \"nested canary\");\n+    const nestedHeadBefore = nestedGit(\"rev-parse\", \"HEAD\");\n+    const nestedIndexBefore = execFileSync(\"git\", [\"-C\", trackedParent, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n+\n+    fs.writeFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"staged canary\\n\");\n+    git(\"add\", \"staged-after-checkpoint.txt\");\n+    const outerHeadBefore = git(\"rev-parse\", \"HEAD\");\n+    const outerIndexBefore = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n+\n+    const result = manager.restore(checkpoint.id);\n+\n+    assert.equal(result.success, false);\n+    assert.match(result.message, /destination|unsafe|snapshot/i);\n+    assert.equal(fs.readFileSync(path.join(trackedParent, \"captured.txt\"), \"utf8\"), \"nested repository canary\\n\");\n+    assert.equal(nestedGit(\"rev-parse\", \"HEAD\"), nestedHeadBefore);\n+    const nestedIndexAfter = execFileSync(\"git\", [\"-C\", trackedParent, \"ls-files\", \"--stage\", \"-z\"], { encoding: \"buffer\" }).toString(\"hex\");\n+    assert.equal(nestedIndexAfter, nestedIndexBefore, \"rejection must preserve nested repository index entries\");\n+    assert.equal(git(\"rev-parse\", \"HEAD\"), outerHeadBefore);\n+    const outerIndexAfter = execFileSync(\"git\", [\"ls-files\", \"--stage\", \"-z\"], { cwd: repo, encoding: \"buffer\" }).toString(\"hex\");\n+    assert.equal(outerIndexAfter, outerIndexBefore, \"rejection must preserve outer index entries\");\n+    assert.equal(fs.readFileSync(path.join(repo, \"staged-after-checkpoint.txt\"), \"utf8\"), \"staged canary\\n\");\n+  } finally {\n+    cleanupGitRepo(repo);\n+  }\n+});\n+\n test(\"Git manifest restore refuses an ignored directory replacing a tracked checkpoint file before Git mutation\", () => {\n","move_path":null},"/home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/src/checkpoint.ts":{"type":"update","unified_diff":"@@ -192,3 +192,3 @@\n \n-  private assertUntrackedDestinationSafe(relativePaths: string[], targetRoot: string): void {\n+  private assertNoNestedGitRepositoryAncestors(relativePaths: string[], targetRoot: string): void {\n     const root = fs.realpathSync(targetRoot);\n@@ -200,3 +200,21 @@\n       }\n+      const relativeParent = path.dirname(relativeDestination);\n+      let parent = root;\n+      for (const component of relativeParent === \".\" ? [] : relativeParent.split(path.sep)) {\n+        parent = path.join(parent, component);\n+        const stat = fs.lstatSync(parent, { throwIfNoEntry: false });\n+        if (!stat || !stat.isDirectory() || stat.isSymbolicLink()) break;\n+        if (fs.lstatSync(path.join(parent, \".git\"), { throwIfNoEntry: false })) {\n+          throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n+        }\n+      }\n+    }\n+  }\n \n+  private assertUntrackedDestinationSafe(relativePaths: string[], targetRoot: string): void {\n+    this.assertNoNestedGitRepositoryAncestors(relativePaths, targetRoot);\n+    const root = fs.realpathSync(targetRoot);\n+    for (const relativePath of relativePaths) {\n+      const destination = path.resolve(root, relativePath);\n+      const relativeDestination = path.relative(root, destination);\n       const relativeParent = path.dirname(relativeDestination);\n@@ -208,5 +226,2 @@\n           throw new Error(\"Checkpoint destination parent is not a real directory\");\n-        }\n-        if (stat && fs.lstatSync(path.join(parent, \".git\"), { throwIfNoEntry: false })) {\n-          throw new Error(\"Checkpoint destination parent is a nested Git repository\");\n         }\n@@ -842,2 +857,3 @@\n           const replacementTargets = [...new Set([...cp.untrackedFiles, ...this.gitRefBlobPaths(cp.gitRef)])];\n+          this.assertNoNestedGitRepositoryAncestors(replacementTargets, this.workspace);\n           this.assertGitSnapshotTargetsReplaceable(replacementTargets, cp.gitRef);\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/src/checkpoint.ts\nM /home/mike/nexus-wt/checkpoint-ordinary-child-fix/cli/test/checkpoint_restore.test.ts\n","stderr":""},"started_at_ms":1793194974258,"completed_at_ms":1793194974263}}
