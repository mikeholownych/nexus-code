or(`Invalid tool invocation budget '${String(raw)}': expected a positive integer.`);\\n+  if (value > MAX_TOOL_INVOCATIONS) throw new Error(`Invalid tool invocation budget '${String(raw)}': maximum is ${MAX_TOOL_INVOCATIONS}.`);\\n+  return value;\\n+}\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","create_time":1795301216.829768}},"metadata":{"history_sequence":16508,"sampled_through_sequence":16506,"client_authored":false}}
