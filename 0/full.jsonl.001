gence_scheduler_properties.test.ts | sed -n '1,150p'; git show origin/main:cli/test/convergence_integration.test.ts | sed -n '1,120p'; git grep -n -E 'DecisionRejected|operationPolicy|DEFAULT_OPERATION_POLICY|nexus.config.json' origin/main -- docs/EXECUTION_CONVERGENCE.md cli/src/config.ts cli/src/core/scheduler.ts | head -80"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"RC10_PRESENT cli/src/core/capabilities.ts\nRC10_PRESENT cli/src/core/operation.ts\nRC10_PRESENT cli/src/core/operation_runner.ts\nRC10_ABSENT cli/src/core/capability_definitions/browser.ts\nRC10_ABSENT cli/src/core/scheduler.ts\nRC10_ABSENT cli/src/core/operation_runner_execution.ts\nRC10_ABSENT cli/src/core/operation_runner_revalidation.ts\nRC10_ABSENT cli/src/core/operation_runner_persistence.ts\nRC10_ABSENT cli/src/core/operation_runner_diagnostics.ts\nRC10_ABSENT cli/test/convergence_scheduler_properties.test.ts\nRC10_PRESENT cli/test/convergence_integration.test.ts\n/**\n * Generated dependency-graph invariants for ConvergenceScheduler.\n *\n * The fixed seeds make failures reproducible while exploring many valid DAG shapes.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { ConvergenceScheduler, newOperation } from \"../src/core/operation.js\";\nimport { ResourceRegistry, type ResourceDescriptor } from \"../src/core/resources.js\";\n\nfunction random(seed: number): () => number {\n  let state = seed >>> 0;\n  return () => {\n    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;\n    return state / 0x1_0000_0000;\n  };\n}\n\nfunction resource(): ResourceDescriptor {\n  return {\n    id: \"r1\",\n    provider: \"https://provider.test\",\n    endpoint: \"https://provider.test/v1\",\n    model: \"fixture\",\n    capabilities: [\"tools\"],\n    rank: 0,\n  };\n}\n\ntest(\"generated acyclic operations schedule only after dependencies complete and converge\", () => {\n  for (let seed = 1; seed <= 100; seed++) {\n    const next = random(seed);\n    const count = 1 + Math.floor(next() * 12);\n    const specs = Array.from({ length: count }, (_, index) => ({\n      id: `u${index}`,\n      prompt: `work ${index}`,\n      dependsOn: Array.from({ length: index }, (_, dependency) => dependency)\n        .filter(() => next() < 0.25)\n        .map((dependency) => `u${dependency}`),\n    }));\n    const now = 1_798_000_000_000;\n    const state = newOperation(`generated-${seed}`, \"generated objective\", specs, [resource()], now);\n    const registry = new ResourceRegistry(state.resources, [], { now: () => now, random: () => 0.5 });\n    const scheduler = new ConvergenceScheduler(state, registry, () => now);\n    const completed = new Set<string>();\n\n    for (let step = 0; step < count; step++) {\n      const decision = scheduler.decide();\n      assert.equal(decision.kind, \"run\", `seed ${seed}, step ${step}`);\n      if (decision.kind !== \"run\") break;\n      assert.ok(\n        decision.unit.dependsOn.every((dependency) => completed.has(dependency)),\n        `seed ${seed}: ${decision.unit.id} ran before its dependencies`,\n      );\n      scheduler.start(decision);\n      scheduler.apply(decision.unit.id, { kind: \"completed\", summary: \"done\", outcome: \"VERIFIED\" });\n      completed.add(decision.unit.id);\n    }\n\n    assert.equal(completed.size, count, `seed ${seed}: every generated unit should run`);\n    assert.equal(scheduler.decide().kind, \"complete\", `seed ${seed}: operation should converge`);\n  }\n});\n\ntest(\"scheduler event callback failures produce bounded debug diagnostics\", () => {\n  const now = 1_798_000_000_000;\n  const state = newOperation(\"scheduler-diagnostic\", \"objective\", [{ id: \"u1\", prompt: \"work\" }], [resource()], now);\n  const diagnostics: Array<{ level: string; area: string; action: string }> = [];\n  const scheduler = new ConvergenceScheduler(\n    state,\n    new ResourceRegistry(state.resources, [], { now: () => now, random: () => 0.5 }),\n    () => now,\n    () => { throw new Error(\"do not log exception details\"); },\n    (event) => diagnostics.push(event),\n  );\n\n  scheduler.emit(\"WORK_STARTED\", \"started\", { unitId: \"u1\" });\n\n  assert.deepEqual(diagnostics, [{ level: \"debug\", area: \"scheduler\", action: \"event_callback_failed\" }]);\n  assert.equal(JSON.stringify(diagnostics).includes(\"do not log\"), false);\n  assert.equal(state.events.at(-1)?.type, \"WORK_STARTED\", \"observer failure must not undo the scheduler event\");\n});\n/**\n * Convergence scheduling end to end: real AutonomousAgent turns against local OpenAI-compatible gateways.\n * A: reroute. B: park, continue independent work, resume the parked unit from its history. C: true wait before\n * task execution, then implement and validate after wake. D: process restart while waiting. Fake clocks throughout.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execSync } from \"node:child_process\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { newOperation, type DurableOperationState, type WorkUnitSpec } from \"../src/core/operation.js\";\nimport { AgentWorkUnitExecutor, OperationRunner, OperationStore } from \"../src/core/operation_runner.js\";\nimport { ResourceRegistry, type ResourceDescriptor } from \"../src/core/resources.js\";\nimport { DurableStateManager } from \"../src/core/state.js\";\nimport type { InferenceFailure } from \"../src/core/turn.js\";\nimport type { HarnessConfig } from \"../src/types.js\";\nimport { fakeClock, startGateway, type FakeClock, type Gateway, type Reply } from \"./helpers/provider_fixture.js\";\n\nconst complete = (summary: string): Reply => ({ kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary } }] });\nconst limited = (secs: number): Reply => ({ kind: \"http\", status: 429, headers: { \"retry-after\": String(secs) }, body: '{\"error\":{\"message\":\"rate limited\",\"type\":\"rate_limit_exceeded\"}}' });\nconst userText = (body: any): string => (body.messages ?? []).filter((m: any) => m.role === \"user\").map((m: any) => String(m.content)).join(\"\\n\");\nconst unitOf = (body: any): string | undefined => userText(body).match(/Work unit '(\\w+)'/)?.[1];\n\ninterface Env {\n  repo: string;\n  stateDir: string;\n  executor(config?: Partial<HarnessConfig>): AgentWorkUnitExecutor;\n  store(): OperationStore;\n}\n\nasync function withEnv<T>(gws: Gateway[], fn: (env: Env) => Promise<T>): Promise<T> {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-conv-\"));\n  fs.writeFileSync(path.join(repo, \"notes.txt\"), \"the answer is 42\\n\");\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm base\", { cwd: repo, stdio: \"ignore\" });\n  const stateDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-conv-state-\"));\n  const base: HarnessConfig = { endpoint: gws[0].url, model: \"unused\", maxSteps: 6, temperature: 0, workspace: repo, shell: \"bash\" };\n  const env: Env = {\n    repo,\n    stateDir,\n    executor: (config: Partial<HarnessConfig> = {}) =>\n      new AgentWorkUnitExecutor({\n        baseConfig: { ...base, ...config },\n        createAgent: (config) => {\n          const agent = new AutonomousAgent(config, 1);\n          const a = agent as any;\n          a.recoveryClock = fakeClock();\n          a.stateManager = new DurableStateManager({ baseDir: stateDir, workspacePaths: [a.primaryWorkspacePathIdentity] });\n          return agent;\n        },\n      }),\n    store: () => new OperationStore(repo, stateDir),\n  };\n  try {\n    return await fn(env);\n  } finally {\n    for (const g of gws) await g.close();\n    fs.rmSync(repo, { recursive: true, force: true });\n    fs.rmSync(stateDir, { recursive: true, force: true });\n  }\n}\n\nconst resource = (id: string, gw: Gateway, o: Partial<ResourceDescriptor> = {}): ResourceDescriptor => ({\n  id, provider: new URL(gw.url).origin, endpoint: gw.url, model: id, capabilities: [\"tools\"], rank: 0, ...o,\n});\n\nfunction run(env: Env, state: DurableOperationState, clock: FakeClock = fakeClock()) {\n  const store = env.store();\n  return { runner: new OperationRunner(state, { executor: env.executor(), clock, persist: (s) => store.save(s) }), clock, store };\n}\n\ndescribe(\"convergence scheduling with real agent turns\", () => {\n  test(\"A. reroute: recovered work preserves routing evidence but cannot complete unverified\", async () => {\n    const gwA = await startGateway(() => limited(120));\n    const gwB = await startGateway(() => complete(\"review done on b\"));\n    await withEnv([gwA, gwB], async (env) => {\n      const state = newOperation(\"op-a\", \"review the change\", [{ id: \"review\", title: \"Review\", prompt: \"Review notes.txt\", requires: { capabilities: [\"review\"] } }],\n        [resource(\"rev-a\", gwA, { capabilities: [\"tools\", \"review\"] }), resource(\"rev-b\", gwB, { capabilities: [\"tools\", \"review\"], rank: 1 }), resource(\"cheap\", gwB, { model: \"cheap\" })], 0);\n      const { runner, clock } = run(env, state);\n      const out = await runner.run();\n      assert.equal(out.status, \"BLOCKED\", \"recovered evidence cannot establish an operation result\");\n      assert.equal(gwA.requests.length, 1, \"one request to the rate-limited reviewer, then none\");\n      assert.equal(gwB.requests.length, 1);\n      assert.equal(gwB.requests[0].body.model, \"rev-b\", \"the qualified alternate, not the cheap model\");\n      assert.notEqual(gwA.requests[0].id, gwB.requests[0].id, \"a fresh request id on the new resource\");\n      const u = out.units[0];\n      assert.deepEqual(u.reroutes.map((r) => [r.from, r.to]), [[\"rev-a\", \"rev-b\"]]);\n      assert.match(u.reroutes[0].reason, /rate limited \\(HTTP 429\\)/);\n      assert.equal(u.status, \"BLOCKED\");\n      assert.match(u.blocked?.reason ?? \"\", /COMPLETED\\/UNVERIFIED \\(NO_APPLICABLE_VERIFIER\\)/);\n      assert.equal(u.result, undefined, \"the model's report is not promoted to an established operation result\");\n      assert.equal(clock.sleeps.length, 0, \"no waiting when a qualified alternate exists\");\n    });\n  });\n\n  test(\"B. park and continue: independent work completes while recovered review remains unverified\", async () => {\n    const gwDeep = await startGateway((n) => (n === 1 ? { kind: \"tools\", calls: [{ name: \"read_file\", args: { path: \"notes.txt\" } }] } : n === 2 ? limited(60) : complete(\"deep review: answer verified as 42\")));\n    const gwLead = await startGateway((n, body) => complete(`${userText(body).match(/Work unit '(\\w+)'/)?.[1]} done`));\n    await withEnv([gwDeep, gwLead], async (env) => {\n      const units: WorkUnitSpec[] = [\n        { id: \"review\", title: \"Deep review\", prompt: \"Review notes.txt deeply\", requires: { capabilities: [\"reasoning\"] } },\n        { id: \"docs\", title: \"Docs\", prompt: \"Summarise notes.txt\" },\n        { id: \"tests\", title: \"Tests\", prompt: \"List test gaps\" },\n        { id: \"final\", title: \"Final acceptance\", prompt: \"Confirm all results\", dependsOn: [\"review\", \"docs\", \"tests\"] },\n      ];\n      const state = newOperation(\"op-b\", \"ship the change\", units, [resource(\"deep\", gwDeep, { capabilities: [\"tools\", \"reasoning\"], rank: 1 }), resource(\"lead\", gwLead)], 0);\n      const { runner, clock } = run(env, state);\n      const out = await runner.run();\n      assert.equal(out.status, \"BLOCKED\", \"the recovered review remains pending despite successful continuation\");\n      const types = out.events.map((e) => e.type);\n      const parkedEvent = out.events.find((e) => e.type === \"WORK_PARKED\")!;\n      assert.match(parkedEvent.message, /Deep review parked: deep rate limited \\(HTTP 429\\); eligible again \\d\\d:\\d\\d UTC\\. Continuing 2 independent tasks\\./);\n      assert.ok(types.indexOf(\"OPERATION_WAITING\") > out.events.findIndex((e) => e.type === \"WORK_COMPLETED\" && e.unitId === \"tests\"));\n      assert.equal(clock.sleeps.length, 1);\n      assert.ok(clock.sleeps[0] >= 59_000 && clock.sleeps[0] <= 61_000, `wait ${clock.sleeps[0]}`);\n      // Resumed from history: the read_file result from before parking is in the resumed request, not re-run.\n      assert.equal(gwDeep.requests.length, 3);\n      const resumed = gwDeep.requests[2].body.messages;\n      assert.equal(resumed.filter((m: any) => m.role === \"tool\" && /the answer is 42/.test(String(m.content))).length, 1);\norigin/main:cli/src/config.ts:9:import { DEFAULT_OPERATION_POLICY } from \"./core/operation.js\";\norigin/main:cli/src/config.ts:17:let operatorJsonOperationPolicy: HarnessConfig[\"operationPolicy\"];\norigin/main:cli/src/config.ts:80:  // operator's home; a project nexus.config.json is never trusted as operator policy.\norigin/main:cli/src/config.ts:81:  operatorJsonOperationPolicy = readOperatorOperationPolicy(path.join(operatorHome, \".config/nexus/config.json\"));\norigin/main:cli/src/config.ts:404:  const operationPolicy = configuredOperationPolicy();\norigin/main:cli/src/config.ts:464:    ...(operationPolicy ? { operationPolicy } : {}),\norigin/main:cli/src/config.ts:472:export function configuredOperationPolicy(setting: (key: string) => string | undefined = operatorSetting): HarnessConfig[\"operationPolicy\"] {\norigin/main:cli/src/config.ts:482:  const policy: NonNullable<HarnessConfig[\"operationPolicy\"]> = {};\norigin/main:cli/src/config.ts:513:function readOperatorOperationPolicy(file: string): HarnessConfig[\"operationPolicy\"] {\norigin/main:cli/src/config.ts:557:    if (key !== \"version\" && key !== \"operationPolicy\") throw new Error(`Unsupported Nexus config.json field '${key}'.`);\norigin/main:cli/src/config.ts:559:  if (root.operationPolicy === undefined) return undefined;\norigin/main:cli/src/config.ts:560:  if (!root.operationPolicy || typeof root.operationPolicy !== \"object\" || Array.isArray(root.operationPolicy)) {\norigin/main:cli/src/config.ts:561:    throw new Error(\"Nexus config.json operationPolicy must be an object.\");\norigin/main:cli/src/config.ts:564:  const rawPolicy = root.operationPolicy as Record<string, unknown>;\norigin/main:cli/src/config.ts:565:  const policy: NonNullable<HarnessConfig[\"operationPolicy\"]> = {};\norigin/main:cli/src/config.ts:573:    if (!fields.some(([field]) => field === key)) throw new Error(`Unsupported Nexus config.json operationPolicy field '${key}'.`);\norigin/main:cli/src/config.ts:579:      throw new Error(`Invalid Nexus config.json operationPolicy.${field}: expected a safe integer of at least ${minimum}.`);\norigin/main:cli/src/config.ts:582:      throw new Error(`Invalid Nexus config.json operationPolicy.${field}: must not exceed Node's timer limit (2147483647 ms).`);\norigin/main:cli/src/config.ts:591:  configured: HarnessConfig[\"operationPolicy\"],\norigin/main:cli/src/config.ts:592:  override: HarnessConfig[\"operationPolicy\"],\norigin/main:cli/src/config.ts:593:): HarnessConfig[\"operationPolicy\"] {\norigin/main:cli/src/config.ts:595:  const effective = { ...DEFAULT_OPERATION_POLICY, ...policy };\norigin/main:cli/src/core/scheduler.ts:32:export class DecisionRejected extends Error {}\norigin/main:cli/src/core/scheduler.ts:250:      throw new DecisionRejected(`Operation ${this.state.id} is ${this.state.status}; it has no pending decisions.`);\norigin/main:cli/src/core/scheduler.ts:258:          throw new DecisionRejected(`Option '${optionId}' was not offered for ${decisionId} (offered: ${opDecision.options.map((o) => `${o.id}=${o.label}`).join(\"; \")}).`);\norigin/main:cli/src/core/scheduler.ts:279:      throw new DecisionRejected(`No pending decision '${decisionId}' (pending: ${pending.join(\", \") || \"none\"}).`);\norigin/main:cli/src/core/scheduler.ts:284:      throw new DecisionRejected(`Option '${optionId}' was not offered for ${decisionId} (offered: ${decision.options.map((o) => `${o.id}=${o.label}`).join(\"; \")}).`);\norigin/main:cli/src/core/scheduler.ts:288:    if (action.kind === \"revise\" && !text) throw new DecisionRejected(\"Revising a unit requires a note describing the revision.\");\norigin/main:cli/src/core/scheduler.ts:289:    if (action.kind === \"drop\" && isRequired(u)) throw new DecisionRejected(`${u.title} is required; dropping it would leave the objective unmet.`);\norigin/main:cli/src/core/scheduler.ts:292:      if (!r) throw new DecisionRejected(`Resource ${action.resourceId} is not configured for this operation.`);\norigin/main:cli/src/core/scheduler.ts:294:        throw new DecisionRejected(`${action.resourceId} is outside ${u.title}'s trust boundary; that cannot be overridden by a decision.`);\norigin/main:docs/EXECUTION_CONVERGENCE.md:98:the option id and the action against current state and throws `DecisionRejected` otherwise; applying one records\n","exit_code":0,"duration":{"secs":0,"nanos":32748505}},"started_at_ms":1793196906784,"completed_at_ms":1793196906818}}
{"timestamp":"2026-10-28T14:15:08.113Z","ordinal":459517,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a182dd-5e51-73e1-a97e-7c3893c7568a","call_id":"call_7d0dd8fcfaa8455588d1f18d88c517f7","output":[{"type":"input_text","text":"Script completed\nWall time 2.9 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 4001)\nTotal output lines: 245\n\nRC10_PRESENT cli/src/core/capabilities.ts\nRC10_PRESENT cli/src/core/operation.ts\nRC10_PRESENT cli/src/core/operation_runner.ts\nRC10_ABSENT cli/src/core/capability_definitions/browser.ts\nRC10_ABSENT cli/src/core/scheduler.ts\nRC10_ABSENT cli/src/core/operation_runner_execution.ts\nRC10_ABSENT cli/src/core/operation_runner_revalidation.ts\nRC10_ABSENT cli/src/core/operation_runner_persistence.ts\nRC10_ABSENT cli/src/core/operation_runner_diagnostics.ts\nRC10_ABSENT cli/test/convergence_scheduler_properties.test.ts\nRC10_PRESENT cli/test/convergence_integration.test.ts\n/**\n * Generated dependency-graph invariants for ConvergenceScheduler.\n *\n * The fixed seeds make failures reproducible while exploring many valid DAG shapes.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { ConvergenceScheduler, newOperation } from \"../src/core/operation.js\";\nimport { ResourceRegistry, type ResourceDescriptor } from \"../src/core/resources.js\";\n\nfunction random(seed: number): () => number {\n  let state = seed >>> 0;\n  return () => {\n    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;\n    return state / 0x1_0000_0000;\n  };\n}\n\nfunction resource(): ResourceDescriptor {\n  return {\n    id: \"r1\",\n    provider: \"https://provider.test\",\n    endpoint: \"https://provider.test/v1\",\n    model: \"fixture\",\n    capabilities: [\"tools\"],\n    rank: 0,\n  };\n}\n\ntest(\"generated acyclic operations schedule only after dependencies complete and converge\", () => {\n  for (let seed = 1; seed <= 100; seed++) {\n    const next = random(seed);\n    const count = 1 + Math.floor(next() * 12);\n    const specs = Array.from({ length: count }, (_, index) => ({\n      id: `u${index}`,\n      prompt: `work ${index}`,\n      dependsOn: Array.from({ length: index }, (_, dependency) => dependency)\n        .filter(() => next() < 0.25)\n        .map((dependency) => `u${dependency}`),\n    }));\n    const now = 1_798_000_000_000;\n    const state = newOperation(`generated-${seed}`, \"generated objective\", specs, [resource()], now);\n    const registry = new ResourceRegistry(state.resources, [], { now: () => now, random: () => 0.5 });\n    const scheduler = new ConvergenceScheduler(state, registry, () => now);\n    const completed = new Set<string>();\n\n    for (let step = 0; step < count; step++) {\n      const decision = scheduler.decide();\n      assert.equal(decision.kind, \"run\", `seed ${seed}, step ${step}`);\n      if (decision.kind !== \"run\") break;\n      assert.ok(\n        decision.unit.dependsOn.every((dependency) => completed.has(dependency)),\n        `seed ${seed}: ${decision.unit.id} ran before its dependencies`,\n      );\n      scheduler.start(decision);\n      scheduler.apply(decision.unit.id, { kind: \"completed\", summary: \"done\", outcome: \"VERIFIED\" });\n      completed.add(decision.unit.id);\n    }\n\n    assert.equal(completed.size, count, `seed ${seed}: every generated unit should run`);\n    assert.equal(scheduler.decide().kind, \"complete\", `seed ${seed}: operation should converge`);\n  }\n});\n\ntest(\"scheduler event callback failures produce bounded debug diagnostics\", () => {\n  const now = 1_798_000_000_000;\n  const state = newOperation(\"scheduler-diagnostic\", \"objective\", [{ id: \"u1\", prompt: \"work\" }], [resource()], now);\n  const diagnostics: Array<{ level: string; area: string; action: string }> = [];\n  const scheduler = new ConvergenceScheduler(\n    state,\n    new ResourceRegistry(state.resources, [], { now: () => now, random: () => 0.5 }),\n    () => now,\n    () => { throw new Error(\"do not log exception details\"); },\n    (event) => diagnostics.push(event),\n  );\n\n  scheduler.emit(\"WORK_STARTED\", \"started\", { unitId: \"u1\" });\n\n  assert.deepEqual(diagnostics, [{ level: \"debug\", area: \"scheduler\", action: \"event_callback_failed\" }]);\n  assert.equal(JSON.stringify(diagnostics).includes(\"do not log\"), false);\n  assert.equal(state.events.at(-1)?.type, \"WORK_STARTED\", \"observer failure must not undo the scheduler event\");\n});\n/**\n * Convergence scheduling end to end: real AutonomousAgent turns against local OpenAI-compatible gateways.\n * A: reroute. B: park, continue independent work, resume the parked unit from its history. C: true wait before\n * task execution, then implement and validate after wake. D: process restart while waiting. Fake clocks throughout.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { execSync } from \"node:child_process\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { newOperation, type DurableOperationState, type WorkUnitSpec } from \"../src/core/operation.js\";\nimport { AgentWorkUnitExecutor, OperationRunner, OperationStore } from \"../src/core/operation_runner.js\";\nimport { ResourceRegistry, type ResourceDescriptor } from \"../src/core/resources.js\";\nimport { DurableStateManager } from \"../src/core/state.js\";\nimport type { InferenceFailure } from \"../src/core/turn.js\";\nimport type { HarnessConfig } from \"../src/types.js\";\nimport { fakeClock, startGateway, type FakeClock, type Gateway, type Reply } from \"./helpers/provider_fixture.js\";\n\nconst complete = (summary: string): Reply => ({ kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary } }] });\nconst limited = (secs: number): Reply => ({ kind: \"http\", status: 429, headers: { \"retry-after\": String(secs) }, body: '{\"error\":{\"message\":\"rate limited\",\"type\":\"rate_limit_exceeded\"}}' });\nconst userText = (body: any): string => (body.messages ?? []).filter((m: any) => m.role === \"user\").map((m: any) => String(m.content)).join(\"\\n\");\nconst unitOf = (body: any): string | undefined => userText(body).match(/Work unit '(\\w+)'/)?.[1];\n\ninterface Env {\n  repo: string;\n  stateDir: string;\n  executor(config?: Partial<HarnessConfig>): AgentWorkUnitExecutor;\n  store(): OperationStore;\n}\n\nasync function withEnv<T>(gws: Gateway[], fn: (env: Env) => Promise<T>): Promise<T> {\n  const repo = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-conv-\"));\n  fs.writeFileSync(path.join(repo, \"notes.txt\"), \"the answer is 42\\n\");\n  execSync(\"git init -q && git config user.name t && git config user.email t@t.invalid && git add . && git commit -qm base\", { cwd: repo, stdio: \"ignore\" });\n  const stateDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-conv-state-\"));\n  const base: HarnessConfig = { endpoint: gws[0].url, model: \"unused\", maxSteps: 6, temperature: 0, workspace: repo, shell: \"bash\" };\n  const env: Env = {\n    repo,\n    stateDir,\n    executor: (config: Partial<HarnessConfig> = {}) =>\n      new AgentWorkUnitExecutor({\n        baseConfig: { ...base, ...config },\n        createAgent: (config) => {\n          const agent = new AutonomousAgent(config, 1);\n          const a = agent as any;\n          a.recoveryClock = fakeClock();\n          a.stateManager = new DurableStateManager({ baseDir: stateDir, workspacePaths: [a.primaryWorkspacePathIdentity] });\n          return agent;\n        },\n      }),\n    store: () => …501 tokens truncated…;\n      assert.deepEqual(u.reroutes.map((r) => [r.from, r.to]), [[\"rev-a\", \"rev-b\"]]);\n      assert.match(u.reroutes[0].reason, /rate limited \\(HTTP 429\\)/);\n      assert.equal(u.status, \"BLOCKED\");\n      assert.match(u.blocked?.reason ?? \"\", /COMPLETED\\/UNVERIFIED \\(NO_APPLICABLE_VERIFIER\\)/);\n      assert.equal(u.result, undefined, \"the model's report is not promoted to an established operation result\");\n      assert.equal(clock.sleeps.length, 0, \"no waiting when a qualified alternate exists\");\n    });\n  });\n\n  test(\"B. park and continue: independent work completes while recovered review remains unverified\", async () => {\n    const gwDeep = await startGateway((n) => (n === 1 ? { kind: \"tools\", calls: [{ name: \"read_file\", args: { path: \"notes.txt\" } }] } : n === 2 ? limited(60) : complete(\"deep review: answer verified as 42\")));\n    const gwLead = await startGateway((n, body) => complete(`${userText(body).match(/Work unit '(\\w+)'/)?.[1]} done`));\n    await withEnv([gwDeep, gwLead], async (env) => {\n      const units: WorkUnitSpec[] = [\n        { id: \"review\", title: \"Deep review\", prompt: \"Review notes.txt deeply\", requires: { capabilities: [\"reasoning\"] } },\n        { id: \"docs\", title: \"Docs\", prompt: \"Summarise notes.txt\" },\n        { id: \"tests\", title: \"Tests\", prompt: \"List test gaps\" },\n        { id: \"final\", title: \"Final acceptance\", prompt: \"Confirm all results\", dependsOn: [\"review\", \"docs\", \"tests\"] },\n      ];\n      const state = newOperation(\"op-b\", \"ship the change\", units, [resource(\"deep\", gwDeep, { capabilities: [\"tools\", \"reasoning\"], rank: 1 }), resource(\"lead\", gwLead)], 0);\n      const { runner, clock } = run(env, state);\n      const out = await runner.run();\n      assert.equal(out.status, \"BLOCKED\", \"the recovered review remains pending despite successful continuation\");\n      const types = out.events.map((e) => e.type);\n      const parkedEvent = out.events.find((e) => e.type === \"WORK_PARKED\")!;\n      assert.match(parkedEvent.message, /Deep review parked: deep rate limited \\(HTTP 429\\); eligible again \\d\\d:\\d\\d UTC\\. Continuing 2 independent tasks\\./);\n      assert.ok(types.indexOf(\"OPERATION_WAITING\") > out.events.findIndex((e) => e.type === \"WORK_COMPLETED\" && e.unitId === \"tests\"));\n      assert.equal(clock.sleeps.length, 1);\n      assert.ok(clock.sleeps[0] >= 59_000 && clock.sleeps[0] <= 61_000, `wait ${clock.sleeps[0]}`);\n      // Resumed from history: the read_file result from before parking is in the resumed request, not re-run.\n      assert.equal(gwDeep.requests.length, 3);\n      const resumed = gwDeep.requests[2].body.messages;\n      assert.equal(resumed.filter((m: any) => m.role === \"tool\" && /the answer is 42/.test(String(m.content))).length, 1);\norigin/main:cli/src/config.ts:9:import { DEFAULT_OPERATION_POLICY } from \"./core/operation.js\";\norigin/main:cli/src/config.ts:17:let operatorJsonOperationPolicy: HarnessConfig[\"operationPolicy\"];\norigin/main:cli/src/config.ts:80:  // operator's home; a project nexus.config.json is never trusted as operator policy.\norigin/main:cli/src/config.ts:81:  operatorJsonOperationPolicy = readOperatorOperationPolicy(path.join(operatorHome, \".config/nexus/config.json\"));\norigin/main:cli/src/config.ts:404:  const operationPolicy = configuredOperationPolicy();\norigin/main:cli/src/config.ts:464:    ...(operationPolicy ? { operationPolicy } : {}),\norigin/main:cli/src/config.ts:472:export function configuredOperationPolicy(setting: (key: string) => string | undefined = operatorSetting): HarnessConfig[\"operationPolicy\"] {\norigin/main:cli/src/config.ts:482:  const policy: NonNullable<HarnessConfig[\"operationPolicy\"]> = {};\norigin/main:cli/src/config.ts:513:function readOperatorOperationPolicy(file: string): HarnessConfig[\"operationPolicy\"] {\norigin/main:cli/src/config.ts:557:    if (key !== \"version\" && key !== \"operationPolicy\") throw new Error(`Unsupported Nexus config.json field '${key}'.`);\norigin/main:cli/src/config.ts:559:  if (root.operationPolicy === undefined) return undefined;\norigin/main:cli/src/config.ts:560:  if (!root.operationPolicy || typeof root.operationPolicy !== \"object\" || Array.isArray(root.operationPolicy)) {\norigin/main:cli/src/config.ts:561:    throw new Error(\"Nexus config.json operationPolicy must be an object.\");\norigin/main:cli/src/config.ts:564:  const rawPolicy = root.operationPolicy as Record<string, unknown>;\norigin/main:cli/src/config.ts:565:  const policy: NonNullable<HarnessConfig[\"operationPolicy\"]> = {};\norigin/main:cli/src/config.ts:573:    if (!fields.some(([field]) => field === key)) throw new Error(`Unsupported Nexus config.json operationPolicy field '${key}'.`);\norigin/main:cli/src/config.ts:579:      throw new Error(`Invalid Nexus config.json operationPolicy.${field}: expected a safe integer of at least ${minimum}.`);\norigin/main:cli/src/config.ts:582:      throw new Error(`Invalid Nexus config.json operationPolicy.${field}: must not exceed Node's timer limit (2147483647 ms).`);\norigin/main:cli/src/config.ts:591:  configured: HarnessConfig[\"operationPolicy\"],\norigin/main:cli/src/config.ts:592:  override: HarnessConfig[\"operationPolicy\"],\norigin/main:cli/src/config.ts:593:): HarnessConfig[\"operationPolicy\"] {\norigin/main:cli/src/config.ts:595:  const effective = { ...DEFAULT_OPERATION_POLICY, ...policy };\norigin/main:cli/src/core/scheduler.ts:32:export class DecisionRejected extends Error {}\norigin/main:cli/src/core/scheduler.ts:250:      throw new DecisionRejected(`Operation ${this.state.id} is ${this.state.status}; it has no pending decisions.`);\norigin/main:cli/src/core/scheduler.ts:258:          throw new DecisionRejected(`Option '${optionId}' was not offered for ${decisionId} (offered: ${opDecision.options.map((o) => `${o.id}=${o.label}`).join(\"; \")}).`);\norigin/main:cli/src/core/scheduler.ts:279:      throw new DecisionRejected(`No pending decision '${decisionId}' (pending: ${pending.join(\", \") || \"none\"}).`);\norigin/main:cli/src/core/scheduler.ts:284:      throw new DecisionRejected(`Option '${optionId}' was not offered for ${decisionId} (offered: ${decision.options.map((o) => `${o.id}=${o.label}`).join(\"; \")}).`);\norigin/main:cli/src/core/scheduler.ts:288:    if (action.kind === \"revise\" && !text) throw new DecisionRejected(\"Revising a unit requires a note describing the revision.\");\norigin/main:cli/src/core/scheduler.ts:289:    if (action.kind === \"drop\" && isRequired(u)) throw new DecisionRejected(`${u.title} is required; dropping it would leave the objective unmet.`);\norigin/main:cli/src/core/scheduler.ts:292:      if (!r) throw new DecisionRejected(`Resource ${action.resourceId} is not configured for this operation.`);\norigin/main:cli/src/core/scheduler.ts:294:        throw new DecisionRejected(`${action.resourceId} is outside ${u.title}'s trust boundary; that cannot be overridden by a decision.`);\norigin/main:docs/EXECUTION_CONVERGENCE.md:98:the option id and the action against current state and throws `DecisionRejected` otherwise; applying one records\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a182d5-76db-7c32-855f-8a7a037c7e55","create_time":1793196908.1134636}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
