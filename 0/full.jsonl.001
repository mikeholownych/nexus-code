// Named hooks first became available in Git 2.54, but Git only gained an event-wide\n  // disable switch in 2.55. On 2.54, suppressing only hooks discovered by name has a\n  // configuration race, so protected operations must fail closed.\n  if (major === 2 && minor === 54) {\n    throw new Error(\"Git 2.54 cannot safely disable all configured hooks; upgrade Git to 2.55 or later\");\n  }\n  const assignments = disabledEvents.map((event) =>\n    `${quoteConfigValue(`hook.${event}.enabled`)}=${quoteConfigValue(\"false\")}`\n  );\n  const existingParameters = (process.env.GIT_CONFIG_PARAMETERS ?? \"\").trim();\n  return {\n    ...process.env,\n    GIT_CONFIG_PARAMETERS: existingParameters\n      ? `${existingParameters} ${assignments.join(\" \")}`\n      : assignments.join(\" \"),\n  };\n}\n5:import { envWithoutConfiguredHooks } from \"./core/git_hook_guard.js\";\n786:        const hookGuardEnv = envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\", \"post-index-change\"]);\n835:          if (gitRef) execFileSync(\"git\", [\"-c\", \"core.hooksPath=/dev/null\", \"update-ref\", \"-d\", `refs/nexus/checkpoints/${id}`], { cwd: this.workspace, stdio: \"ignore\", env: envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\"]) });\n998:          hookEnv = envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\"]);\n1070:        const hookGuardEnv = envWithoutConfiguredHooks(this.workspace, [\"reference-transaction\", \"post-index-change\"]);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1834a-d12d-7c43-8f4a-96ee044d0ace","create_time":1793205102.5579143}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
