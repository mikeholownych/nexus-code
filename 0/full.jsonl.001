ur behind the gateway.\")\nopen(n,\"w\").write(t)\nv=\"docs/releases/v1.2.0.md\"\nu=open(v).read()\nold=\"- Live inference is the project's gateway only. The G1.1-4 tool-call validity measurement was taken for v1.1.4 (200/200 on two aliases); it is repeated for this candidate in the rc notes.\"\nassert old in u\nu=u.replace(old,\"- Live inference is the project's gateway only. The G1.1-4 tool-call validity measurement for this release is **not met**: on v1.2.0-rc.1 `engineering/lead-reasoning` was 195/200 native valid (bar 99.5%; `engineering/deep` 200/200). The five failures are \\\"think before the call\\\" `edit_file` prompts where the model reasons to the output cap without calling the tool. The client code is identical to v1.1.4 (which passed on a rerun), nothing was changed to get a better number, and the owner accepted shipping with this recorded. See `docs/evidence/v1.2.0/G1.1-4-rc.1.md`.\")\nopen(v,\"w\").write(u)\nEOF\ngit diff --stat; grep -n -i \"g1.1-4\\|status\" docs/v1.2.0/SEMANTIC_AND_ARCHITECTURAL_INTEGRITY.md | head -8 | cut -c1-200","description":"Update evidence doc, rc.1 notes and stable notes on main"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":640,"cache_read_input_tokens":215859,"output_tokens":1453,"output_tokens_details":{"thinking_tokens":234},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":640,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1453,"cache_read_input_tokens":215859,"cache_creation_input_tokens":640,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":640},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"toolInputStreamMs":6388,"wireToolInputs":{"toolu