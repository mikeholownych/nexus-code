ounded warning when this connection keeps returning tool-call-shaped text after a required-call request. */\n  private warnedToolCallTextOnly = false;\n  private pending?: PendingRequest;\n  /** Ledger reservations taken by the request in progress (released when its receipt is recorded). */\n  private reservations: string[] = [];\n\n  constructor(\n    config: HarnessConfig,\n    options?: {\n      boundary?: InformationFlowBoundary;\n      taskId?: string;\n      sessionId?: string;\n      taskClass?: string;\n      /** Receipt label: main, planner, coder, subagent, work-unit. */\n      role?: string;\n      /** Optional diagnostic sink for bounded command surfaces that must sanitize provider-controlled labels. */\n      diagnosticHandler?: (level: \"error\" | \"warn\", message: string) => void;\n      /** Disable 401 fallback to stored credentials while explicitly verifying a replacement local endpoint key. */\n      allowCredentialReload?: boolean;\n    }\n  ) {\n    this.conn = connectionFor(config.provider, config.model);\n    this.unsupportedParams = this.initialUnsupportedParams();\n    // A provider's base URL already carries its API path and version; only the legacy endpoint path appends /v1.\n    const normalizeEp = (urlStr: string) => {\n      let ep = urlStr.trim();\n      while (ep.length > 0 && ep.endsWith(\"/\")) ep = ep.slice(0, -1);\n      if (!this.conn.providerId && !ep.endsWith(\"/v1\")) {\n        ep = `${ep}/v1`;\n      }\n      return ep;\n  ): Promise<ChatMessage> {\n    await this.reverifyExpiredKind(signal);\n    const response = await this.withReceipt(requestId, purpose, () =>\n      this.withOAuthRetry(this.endpoint, requestId, () => this.withParameterRetry(() => this.chatCompletionOnce(messages, tools, requestId, signal))),\n    );\n    return this.askAgainForNativeCall(response, messages, tools, signal);\n  }\n\n  /**\n   * A server that answered a tool request with the call as reply text (never executed, REQ-AGT-112) is asked again, at