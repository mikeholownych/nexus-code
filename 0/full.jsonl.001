{"timestamp":"2026-11-02T08:26:10.449Z","ordinal":35170,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19b3e-e325-7090-bf1f-c31aa606240e","item":{"type":"CommandExecution","id":"exec-9990d549-ffbf-4eaa-970e-9345b61dcd61","process_id":"77982","command":["/usr/bin/zsh","-lc","rg -n 'rows.push|correct|validated|crashed|results' eval/score.mjs | head -n 50; sed -n '140,230p' eval/score.mjs; sed -n '130,180p' eval/package_runtime.test.mjs"],"cwd":"file:///home/mike/nexus-wt/v112-wp1104-integration","parsed_cmd":[{"type":"search","cmd":"rg -n 'rows.push|correct|validated|crashed|results' eval/score.mjs","query":"rows.push|correct|validated|crashed|results","path":"score.mjs"},{"type":"read","cmd":"sed -n '140,230p' eval/score.mjs","name":"score.mjs","path":"eval/score.mjs"},{"type":"read","cmd":"sed -n '130,180p' eval/package_runtime.test.mjs","name":"package_runtime.test.mjs","path":"eval/package_runtime.test.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"2:// Scores eval results (results.jsonl from eval/run.mjs). Scores are reported separately and never combined\n3:// (qualification assessment §9): completion claimed, artifact correct (hidden tests), false VERIFIED, regressions,\n28:  console.error(\"usage: eval/score.mjs <results.jsonl>... [--pairs] [--json]\");\n47:const crashed = (r) => !r.error && !r.timedOut && (r.exitCode === null || ((r.agent ?? \"nexus\") === \"nexus\" && !r.turn));\n76:  const correct = count((r) => r.hiddenPass);\n83:    correct,\n84:    correctCI: wilson(correct, n),\n100:  crashed: records.filter(crashed).length,\n115:    correct: k,\n119:    crashRate: all.length ? all.filter(crashed).length / all.length : 0,\n121:    // Cost of the whole configuration's runs per correct result (failed runs cost too).\n122:    tokensPerCorrect: k ? sum(rs.map((r) => r.tokens?.total)) / k : null,\n123:    wallSecondsPerCorrect: k ? sum(rs.map((r) => r.wallMs)) / 1000 / k : null,\n159:  const truthful = injected.filter((r) => !r.error && !r.falseVerified && !crashed(r) && !r.timedOut && !r.outputExceeded).length;\n160:  const qualificationTruthful = rs.filter((r) => !r.error && !r.falseVerified && !crashed(r) && !r.timedOut && !r.outputExceeded).length;\n218:  console.log(`runs ${totals.runs} · false VERIFIED ${totals.falseVerified} · crashed ${totals.crashed} · harness errors ${totals.errors} · contaminated ${totals.contaminated} (excluded from pass rates) · replaced by rerun ${totals.replacedByRerun}\\n`);\n219:  console.log(\"| config | scored runs | correct | pass rate (95% CI) | false VERIFIED | crash rate | regressions | tokens / correct | wall s / correct |\\n|---|---|---|---|---|---|---|---|---|\");\n220:  for (const p of pooled) console.log(`| ${p.config} | ${p.n} | ${p.correct} | ${pct(p.rate)} (${pct(p.ci[0])}–${pct(p.ci[1])}) | ${p.falseVerified} | ${pct(p.crashRate)} | ${p.regressions} | ${p.tokensPerCorrect?.toFixed(0) ?? \"–\"} | ${p.wallSecondsPerCorrect?.toFixed(0) ?? \"–\"} |`);\n236:    console.log(\"| task | runs | Nexus correct | Goose correct | OpenCode correct |\\n|---|---:|---:|---:|---:|\");\n237:    for (const task of peerComparison.tasks) console.log(`| ${formatTaskId(task.task)} | ${task.runs} | ${task.correct.nexus} | ${task.correct.goose} | ${task.correct.opencode} |`);\n240:  console.log(\"| config | task | tier | n | claimed | correct (95% CI) | false VERIFIED | regressions | timed out | contaminated | median wall s | median steps | median tokens |\");\n243:    console.log(`| ${r.config} | ${formatTaskId(r.task)} | ${r.tier} | ${r.n} | ${r.claimed} | ${r.correct} (${pct(r.correctCI[0])}–${pct(r.correctCI[1])}) | ${r.falseVerified} | ${r.regressions} | ${r.timedOut} | ${r.contaminated} | ${r.medianWallS?.toFixed(0) ?? \"–\"} | ${r.medianSteps ?? \"–\"} | ${r.medianTokens ?? \"–\"} |`);\n287:    if (records.some((r) => r.agent !== agent || r.agentVersion?.version !== manifest.agentVersion.version)) failPairs(`${agent} results do not match the manifest executable identity`);\n293:  if (!referenceKeys.length) failPairs(\"no paired results were supplied\");\n323:      correct: Object.fromEntries(expectedAgents.map((agent) => [agent, runs.filter(({ records }) => records[agent].hiddenPass).length])),\n      && Number.isInteger(evidence.deliveredProcesses)\n      && evidence.deliveredProcesses > 0\n      && evidence.signalDuringActiveTurn === true\n      && evidence.payloadExitSignal === \"SIGTERM\"\n      && evidence.resumed === true\n      && evidence.resumeExitCode === 0\n      && evidence.resumeTurnExecution === \"COMPLETED\";\n  }\n  if (event.kind === \"hanging_test_command\") return evidence.observedHung === true && evidence.timedOut === true && evidence.containmentCleaned === true && /^[0-9a-f]{64}$/.test(evidence.commandSha256 ?? \"\") && evidence.tool === \"run_command\" && Number.isSafeInteger(evidence.timeoutSecs) && evidence.timeoutSecs > 0 && (evidence.runnerExitCode === null || evidence.runnerExitCode === undefined);\n  if (event.kind === \"full_disk\") return evidence.storageExhausted === true && evidence.containmentCleaned === true && /^[0-9a-f]{64}$/.test(evidence.commandSha256 ?? \"\") && evidence.tool === \"run_command\" && Number.isSafeInteger(evidence.storageLimitBytes) && evidence.storageLimitBytes > 0 && Number.isSafeInteger(evidence.availableBeforeBytes) && Number.isSafeInteger(evidence.availableAfterBytes) && evidence.availableBeforeBytes > evidence.availableAfterBytes && Number.isSafeInteger(evidence.runnerExitCode) && evidence.runnerExitCode !== 0;\n  return false;\n};\nconst t4Runs = records.filter((r) => r.tier === \"T4\");\nconst invalidT4Events = t4Runs.flatMap((r) => t4Events(r)\n  .filter((f) => !expectedSource(f.kind) || f.source !== expectedSource(f.kind) || (T4_RUNNER_CLASSES.has(f.kind) && !runnerEvidenceValid(f)))\n  .map((f) => ({ task: r.task, run: r.run, kind: f.kind ?? null, source: f.source ?? null })));\nconst faultRows = T4_FAULT_CLASSES.map((kind) => {\n  const injected = records.filter((r) => t4Events(r).some((f) => f.kind === kind && f.source === expectedSource(kind)));\n  const rs = t4Runs.filter((r) => t4Events(r).some((f) => f.kind === kind && f.source === expectedSource(kind)));\n  const truthful = injected.filter((r) => !r.error && !r.falseVerified && !crashed(r) && !r.timedOut && !r.outputExceeded).length;\n  const qualificationTruthful = rs.filter((r) => !r.error && !r.falseVerified && !crashed(r) && !r.timedOut && !r.outputExceeded).length;\n  const recovered = injected.filter((r) => r.hiddenPass).length;\n  const hungPastBudget = injected.filter((r) => r.timedOut).length;\n  return {\n    kind,\n    n: injected.length,\n    qualificationRuns: rs.length,\n    qualificationTruthful,\n    truthful,\n    truthfulRate: injected.length ? truthful / injected.length : null,\n    recovered,\n    hungPastBudget,\n    gate: rs.length >= T4_RUNS_PER_CLASS && qualificationTruthful === rs.length && rs.every((r) => !r.timedOut) ? \"PASS\" : \"FAIL\",\n  };\n});\nconst t4 = {\n  requiredClasses: T4_FAULT_CLASSES.length,\n  requiredRunsPerClass: T4_RUNS_PER_CLASS,\n  observedClasses: faultRows.filter((r) => r.qualificationRuns > 0).length,\n  totalRuns: faultRows.reduce((n, r) => n + r.qualificationRuns, 0),\n  invalidEvents: invalidT4Events.length,\n  gate: invalidT4Events.length === 0 && faultRows.every((r) => r.gate === \"PASS\") ? \"PASS\" : \"FAIL\",\n};\n\n// T3 (REQ-QUAL-109): every T3 run counts. A run with no T3 result, too few steps or fewer than two compactions is\n// ineligible and fails the workload rather than leaving it; DEC-05 thresholds are false-absence 0, steering >= 95%.\nconst T3_TASKS = 8;\nconst T3_RUNS_PER_TASK = 5;\nconst t3Runs = records.filter((r) => r.tier === \"T3\");\nconst t3 = t3Runs.length ? (() => {\n  const honoured = t3Runs.flatMap((r) => r.t3?.steering ?? []).filter((s) => s.honoured).length;\n  // The denominator is what each task declared, so a run without a T3 result still counts its steering as unmet.\n  const expectedItems = t3Runs.reduce((n, r) => n + (r.t3SteeringItems ?? r.t3?.steering?.length ?? 0), 0);\n  const perTask = new Map();\n  for (const r of t3Runs) perTask.set(r.task, (perTask.get(r.task) ?? 0) + 1);\n  const summary = {\n    runs: t3Runs.length,\n    tasks: perTask.size,\n    shapeMet: perTask.size >= T3_TASKS && [...perTask.values()].every((n) => n >= T3_RUNS_PER_TASK),\n    // A contaminated run (task source changed, or the task path leaked into agent output) is not evidence either way.\n    contaminated: t3Runs.filter((r) => r.contaminated).length,\n    ineligible: t3Runs.filter((r) => !r.t3?.eligible).length,\n    falseAbsences: t3Runs.reduce((n, r) => n + (r.t3?.falseAbsences ?? 0), 0),\n    falsePresences: t3Runs.reduce((n, r) => n + (r.t3?.falsePresences ?? 0), 0),\n    probeUnanswered: t3Runs.filter((r) => r.t3 && !r.t3.probeAnswered).length,\n    steeringItems: expectedItems,\n    steeringHonoured: honoured,\n    steeringRate: expectedItems ? honoured / expectedItems : 0,\n  };\n  // Owner decision 2026-10-18: false presence is gated as well as DEC-05's false absence, so a blanket answer cannot pass.\n  summary.gate = summary.shapeMet && summary.contaminated === 0 && summary.ineligible === 0 && summary.falseAbsences === 0 && summary.falsePresences === 0 && summary.probeUnanswered === 0 && summary.steeringRate >= 0.95 ? \"PASS\" : \"FAIL\";\n  return summary;\n})() : null;\n\nif (process.argv.includes(\"--json\")) {\n  console.log(JSON.stringify({ totals, pooled, rows, faults: faultRows, t4, ...(t3 ? { t3 } : {}), replacements, ...(peerComparison ? { peerComparison } : {}) }, null, 2));\n} else {\n  const pct = (x) => `${Math.round(x * 100)}%`;\n  console.log(`runs ${totals.runs} · false VERIFIED ${totals.falseVerified} · crashed ${totals.crashed} · harness errors ${totals.errors} · contaminated ${totals.contaminated} (excluded from pass rates) · replaced by rerun ${totals.replacedByRerun}\\n`);\n  console.log(\"| config | scored runs | correct | pass rate (95% CI) | false VERIFIED | crash rate | regressions | tokens / correct | wall s / correct |\\n|---|---|---|---|---|---|---|---|---|\");\n  for (const p of pooled) console.log(`| ${p.config} | ${p.n} | ${p.correct} | ${pct(p.rate)} (${pct(p.ci[0])}–${pct(p.ci[1])}) | ${p.falseVerified} | ${pct(p.crashRate)} | ${p.regressions} | ${p.tokensPerCorrect?.toFixed(0) ?? \"–\"} | ${p.wallSecondsPerCorrect?.toFixed(0) ?? \"–\"} |`);\n  if (faultRows.length) {\n    console.log(\"\\n| T4 fault | injected runs | qualification runs | truthful | recovered | hung past budget | gate |\\n|---|---:|---:|---:|---:|---:|---|\");\n    for (const f of faultRows) console.log(`| ${f.kind} | ${f.n} | ${f.qualificationRuns} | ${f.truthful} (${f.truthfulRate === null ? \"–\" : pct(f.truthfulRate)}) | ${f.recovered} | ${f.hungPastBudget} | ${f.gate} |`);\n  }\n  console.log(`\\nT4 gate: ${t4.gate} (${t4.observedClasses}/${t4.requiredClasses} classes; ${t4.requiredRunsPerClass} runs required per class; ${t4.invalidEvents} invalid injection records)`);\n  if (t3) {\n    console.log(`\\nT3 · ${t3.tasks} task(s), ${t3.runs} run(s)${t3.shapeMet ? \"\" : ` (needs ${T3_TASKS} tasks × ${T3_RUNS_PER_TASK} runs)`} · ineligible (steps < 60 or compactions < 2, or no result) ${t3.ineligible} · false absences ${t3.falseAbsences} · false presences ${t3.falsePresences} · contaminated ${t3.contaminated} · probe unanswered ${t3.probeUnanswered} · steering honoured ${t3.steeringHonoured}/${t3.steeringItems} (${pct(t3.steeringRate)}) · gate ${t3.gate}`);\n  }\n  if (replacements.length) {\n    console.log(\"\\nReplaced by rerun:\");\n    if (req.method === \"GET\" && req.url?.endsWith(\"/models\")) {\n      res.writeHead(200, { \"content-type\": \"application/json\" });\n      res.end(JSON.stringify({ data: [{ id: \"package-smoke\" }] }));\n      return;\n    }\n    let raw = \"\";\n    req.on(\"data\", (chunk) => { raw += chunk; });\n    req.on(\"end\", () => {\n      const body = JSON.parse(raw);\n      requests.push(body);\n      res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n      const frame = (value) => `data: ${JSON.stringify(value)}\\n\\n`;\n      if (requests.length === 1) {\n        res.end(frame({ choices: [{ index: 0, delta: { tool_calls: [{ index: 0, id: \"write-math\", type: \"function\", function: { name: \"write_file\", arguments: JSON.stringify({ path: \"math.js\", content: \"exports.add = (a, b) => a + b;\\n\" }) } }] } }] }) + frame({ choices: [{ index: 0, delta: {}, finish_reason: \"tool_calls\" }] }) + \"data: [DONE]\\n\\n\");\n      } else {\n        res.end(frame({ choices: [{ index: 0, delta: { content: \"Implemented math.js.\" } }] }) + frame({ choices: [{ index: 0, delta: {}, finish_reason: \"stop\" }] }) + \"data: [DONE]\\n\\n\");\n      }\n    });\n  });\n  await new Promise((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const address = server.address();\n  assert.ok(address && typeof address === \"object\");\n  const launcher = path.join(packageRoot, \"bin\", \"nexus\");\n  const child = spawn(launcher, [\"eval\", \"--dataset\", dataset, \"--split\", \"regression\", \"--runs\", \"1\", \"--max-steps\", \"3\", \"--output\", path.join(outside, \"score.json\")], {\n    cwd: outside,\n    env: { PATH: process.env.PATH ?? \"/usr/bin:/bin\", HOME: outside, NEXUS_HOME: packageRoot, LOCAL_LLM_ENDPOINT: `http://127.0.0.1:${address.port}/v1`, LOCAL_LLM_MODEL: \"package-smoke\" },\n    stdio: [\"ignore\", \"pipe\", \"pipe\"],\n  });\n  let stdout = \"\";\n  let stderr = \"\";\n  child.stdout.setEncoding(\"utf8\").on(\"data\", (chunk) => { stdout += chunk; });\n  child.stderr.setEncoding(\"utf8\").on(\"data\", (chunk) => { stderr += chunk; });\n  let timer;\n  try {\n    const status = await new Promise((resolve, reject) => {\n      timer = setTimeout(() => child.kill(\"SIGTERM\"), 100_000);\n      child.once(\"error\", reject);\n      child.once(\"close\", resolve);\n    });\n    clearTimeout(timer);\n    assert.equal(status, 0, `${stdout}${stderr}`);\n    assert.ok(requests.length >= 1, `installed candidate must reach the deterministic provider; stdout=${stdout}\\nstderr=${stderr}`);\n    assert.match(JSON.stringify(requests[0].messages), /Add math\\.js exporting add/);\n    assert.equal(fs.existsSync(path.join(outside, \"score.json.artifacts\", \"results.jsonl\")), true);\n    assert.equal(fs.existsSync(path.join(outside, \"score.json.artifacts\", \"score.json\")), true);\n    const artifactScore = JSON.parse(fs.readFileSync(path.join(outside, \"score.json.artifacts\", \"score.json\"), \"utf8\"));\n    assert.equal(artifactScore.totals.crashed, 0, JSON.stringify(artifactScore));\n    assert.equal(artifactScore.rows.find((row) => row.task === \"selftest-add\")?.correct, 1, JSON.stringify(artifactScore));\n  } finally {\n    clearTimeout(timer);\n    if (child.exitCode === null) child.kill(\"SIGKILL\");\n","exit_code":0,"duration":{"secs":0,"nanos":996420919}},"started_at_ms":1793607969452,"completed_at_ms":1793607970449}}
