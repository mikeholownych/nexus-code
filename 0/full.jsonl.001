{"timestamp":"2026-11-20T06:34:28.062Z","ordinal":32691,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a1f730-5dda-7050-8748-e755b63ef781","item":{"type":"CommandExecution","id":"exec-d4d4aa18-502e-4268-ab18-4c9599bdd063","process_id":"27805","command":["/usr/bin/zsh","-lc","sed -n '140,230p' cli/src/types.ts; sed -n '1,190p' cli/src/core/objective.ts; sed -n '4400,4585p' cli/src/agent.ts; sed -n '120,290p' cli/src/core/run_turn.ts; sed -n '1,220p' cli/src/client.ts"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"read","cmd":"sed -n '140,230p' cli/src/types.ts","name":"types.ts","path":"cli/src/types.ts"},{"type":"read","cmd":"sed -n '1,190p' cli/src/core/objective.ts","name":"objective.ts","path":"cli/src/core/objective.ts"},{"type":"read","cmd":"sed -n '4400,4585p' cli/src/agent.ts","name":"agent.ts","path":"cli/src/agent.ts"},{"type":"read","cmd":"sed -n '120,290p' cli/src/core/run_turn.ts","name":"run_turn.ts","path":"cli/src/core/run_turn.ts"},{"type":"read","cmd":"sed -n '1,220p' cli/src/client.ts","name":"client.ts","path":"cli/src/client.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"\nexport interface ExecutionResult {\n  success: boolean;\n  output: string;\n  error?: string;\n  /** The operation's deadline expired before an answer was received (bridge-level; the runner reports its own via `timed_out`). */\n  timedOut?: boolean;\n  /** The operator's cancel ended the operation (the runner ended the command's process group). */\n  cancelled?: boolean;\n  /** Why the call was refused before it ran (a stable code, e.g. VERIFICATION_CONFIG_PROTECTED). */\n  denialReason?: string;\n}\n\n/**\n * Bounds for automatically continued work. The total-step limit is cumulative across every invocation that continues\n * the same durable objective; the wall-clock limit bounds one active invocation. Progress detection remains a separate\n * early-stop mechanism, not a substitute for these hard ceilings.\n */\nexport interface ContinuationBudget {\n  /** Maximum steps for one objective across runs and resumes (STEP_BUDGET_EXHAUSTED). */\n  maxTotalSteps: number;\n  /** Maximum wall-clock minutes for one invocation (TIME_BUDGET_EXHAUSTED). */\n  maxTurnMinutes: number;\n  /**\n   * Consecutive steps without observed progress before the turn stops (STAGNATION_DETECTED). A repeated-state\n   * threshold, not a task length: any progressing step resets it (core/execution_tracking.ts defines progress).\n   */\n  stagnationSteps: number;\n  /** Recovery notes the agent may inject for a repeated identical action before stopping (bounded recovery). */\n  maxRecoveries: number;\n  /** Times the agent may be asked to continue when it stops with acceptance requirements still open. */\n  maxCompletionNudges: number;\n  /**\n   * Consecutive failed verifier attempts on changing candidates that stop the turn as VERIFIER_NOT_CONVERGING when they\n   * show the same failure, an A/B alternation or a rising failing-test count (default 3, NEXUS_VERIFIER_CONVERGENCE_ATTEMPTS).\n   */\n  verifierConvergenceAttempts?: number;\n}\n\n/** Hard upper bounds keep an operator override finite even when a config or direct API caller bypasses CLI parsing. */\nexport const MAX_CONTINUATION_STEPS = 5_000;\nexport const MAX_CONTINUATION_MINUTES = 4_320;\n\nexport function assertValidContinuationBudget(budget: ContinuationBudget | undefined): void {\n  if (!budget) return;\n  if (!Number.isSafeInteger(budget.maxTotalSteps) || budget.maxTotalSteps < 1 || budget.maxTotalSteps > MAX_CONTINUATION_STEPS) {\n    throw new Error(`Invalid continuation step budget: expected an integer from 1 to ${MAX_CONTINUATION_STEPS}.`);\n  }\n  if (!Number.isFinite(budget.maxTurnMinutes) || budget.maxTurnMinutes < 1 / 60 || budget.maxTurnMinutes > MAX_CONTINUATION_MINUTES) {\n    throw new Error(`Invalid continuation time budget: expected a finite value from 1 second to ${MAX_CONTINUATION_MINUTES} minutes.`);\n  }\n}\n\n/** Failed verifier attempts on changing candidates that show no convergence before the turn stops (see ContinuationBudget). */\nexport const DEFAULT_CONVERGENCE_ATTEMPTS = 3;\n\nexport const DEFAULT_CONTINUATION: ContinuationBudget = {\n  maxTotalSteps: 500,\n  maxTurnMinutes: 480,\n  stagnationSteps: 12,\n  maxRecoveries: 2,\n  maxCompletionNudges: 2,\n};\n\nexport type ApprovalMode = \"auto\" | \"review\" | \"read-only\";\n/**\n * The objective ledger: what the operator asked for, and how far the work has got against it.\n *\n * The plan (`update_plan`) is the agent's own roadmap and may be coarser than the request. The ledger keeps the\n * request itself — verbatim — and the acceptance criteria seeded from it, so a reduced plan can never stand in for\n * them. Requirements change state only with evidence, scope changes are recorded explicitly, operator steering is\n * kept until applied, and verifier attempts are remembered against the exact workspace inputs they ran on.\n *\n * Pure data and pure functions; the agent owns persistence and presentation.\n */\nimport { createHash } from \"node:crypto\";\nimport type { VerificationStatus } from \"./turn.js\";\nimport { DEFAULT_CONVERGENCE_ATTEMPTS } from \"../types.js\";\nimport type { CanonicalCapability } from \"./capabilities.js\";\nimport { isFilteredVerifierCommand } from \"../tester.js\";\nimport { redactSecrets, safeTerminal } from \"../ui.js\";\nimport { replayObligations, type RegressionObligation, type ReferenceDeclaration, type DifferentialRecord } from \"./regression_obligations.js\";\nimport { createTracking, ExecutionTracker, normalizeTracking, type ExecutionTracking } from \"./execution_tracking.js\";\n\nexport const LEDGER_VERSION = 1;\nexport const PINNED_LEDGER_PREFIX = \"[Objective Ledger - pinned by Nexus; never summarised]\";\nexport const STEERING_PREFIX = \"[Operator steering\";\n/** Objectives longer than this are pinned in full only while the original message has left the context. */\nexport const MAX_PINNED_OBJECTIVE_CHARS = 24_000;\n/** Operator follow-ups and steering pinned verbatim, newest first, up to this many characters (or the block's budget). */\nconst MAX_PINNED_OPERATOR_CHARS = 12_000;\nconst MAX_REQUIREMENT_TEXT = 240;\nconst MAX_EVIDENCE_ITEMS = 6;\nconst MAX_EVIDENCE_CHARS = 300;\nconst MAX_VERIFIER_CHARS = 400;\nconst MAX_TEST_LINKS = 6;\nconst MAX_TEST_LINK_CHARS = 120;\n\nexport type RequirementKind = \"feature\" | \"constraint\" | \"invariant\";\nconst REQUIREMENT_KINDS: readonly string[] = [\"feature\", \"constraint\", \"invariant\"];\n\n/** Verifier and test-link text comes from the operator or the model: one line, no control characters, capped. */\nconst oneLine = (text: string) => text.replace(/[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+/g, \" \").trim();\nconst cleanLine = (text: string, max: number) => clip(oneLine(text), max);\n/** Text shown in the pinned ledger as a code span: nothing inside it can read as ledger structure. */\nconst span = (text: string, max: number) => `\\`${cleanLine(text, max).replace(/`/g, \"'\")}\\``;\n\n/** A command that exits 0 whatever the workspace holds checks nothing. */\nexport function isConstantVerifier(command: string): boolean {\n  return /^(?:true|:|exit\\s+0|\\/(?:usr\\/)?bin\\/true)$/.test(command.trim().replace(/\\s*;+\\s*$/, \"\"));\n}\n\n/** Constraints and invariants hold for the whole task; unlike a feature they are not done on the model's word. */\nexport function isHardRequirement(r: Pick<Requirement, \"kind\">): boolean {\n  return r.kind === \"constraint\" || r.kind === \"invariant\";\n}\n\n/** Claimed implemented, but neither verified by its own verifier nor accepted by the operator. */\nfunction unverifiedHard(r: Requirement): boolean {\n  return isHardRequirement(r) && r.status === \"implemented\" && r.operatorAccepted !== true;\n}\n\nexport type RequirementStatus = \"open\" | \"in_progress\" | \"implemented\" | \"verified\" | \"blocked\" | \"descoped\";\n/** Statuses that need no further work in this task. `blocked` is terminal for the turn but never \"done\". */\nexport const DONE_STATUSES: ReadonlySet<RequirementStatus> = new Set([\"implemented\", \"verified\", \"descoped\"]);\n\n/**\n * Done for the purpose of completion. Descoping reduces what the operator asked for, so only the operator can make\n * it count: a descoped operator or steering requirement stays unresolved until `operatorAccepted` is set (by the\n * operator's `/requirements accept`), while a sub-requirement the agent added itself may be descoped freely.\n */\nexport function requirementDone(r: Requirement): boolean {\n  if (r.status === \"verified\") return true;\n  if (r.status === \"implemented\") return !unverifiedHard(r);\n  return r.status === \"descoped\" && (r.source === \"model\" || r.operatorAccepted === true);\n}\n\nexport interface Requirement {\n  id: string;\n  /** Heading line (capped), for lists. */\n  text: string;\n  /** The requirement's complete wording from the operator's message (nested items included), never truncated. */\n  detail?: string;\n  status: RequirementStatus;\n  /** Absent means a feature (ledgers written before typed requirements). */\n  kind?: RequirementKind;\n  /** Command that checks a constraint or invariant; `verified` needs a passing run of it after the last change. */\n  verifier?: string;\n  /** Who set the verifier. One the model declared is advisory: its run is evidence, never `verified`. */\n  verifierSource?: \"operator\" | \"model\";\n  /** Tests (names or paths) that exercise this requirement. */\n  tests?: string[];\n  /** Where it came from: the operator's objective, operator steering, or the model (added sub-requirement). */\n  source: \"objective\" | \"steering\" | \"model\";\n  /** Implementation and validation evidence (file paths, commands, test names). */\n  evidence: string[];\n  /** Who produced each evidence item, keyed by its text. Items without an entry are the model's claim. */\n  evidenceSources?: Record<string, \"tool\" | \"model\">;\n  /** Reason for blocked/descoped; required for both. */\n  note?: string;\n  /** The operator accepted this requirement's descoping (only the operator's own command sets this). */\n  operatorAccepted?: boolean;\n  /**\n   * The passing verifier run that a `verified` status rests on, recorded on the then-current workspace. Nexus can\n   * show that this run passed on these inputs; it cannot prove the verifier exercises this particular requirement.\n   */\n  verifiedBy?: { attempt: number; command: string; inputs: string; at: string };\n  updatedAt: string;\n}\n\nexport interface ScopeChange {\n  at: string;\n  requirement: string;\n  from: RequirementStatus;\n  to: RequirementStatus;\n  reason: string;\n}\n\nexport interface SteeringRecord {\n  id: string;\n  text: string;\n  receivedAt: string;\n  status: \"queued\" | \"applied\" | \"cancelled\";\n  appliedAt?: string;\n  appliedAtStep?: number;\n}\n\n/** Steering that negates a requirement: held out of the conversation and the ledger until the operator decides. */\nexport interface SteeringConflict {\n  id: string;\n  text: string;\n  requirements: string[];\n  receivedAt: string;\n  /** `unresolved`: no operator was available, so the ledger is unchanged and the negation was not applied. */\n  status: \"pending\" | \"approved\" | \"declined\" | \"unresolved\";\n  decidedAt?: string;\n}\n\n/** Requirements of an earlier objective still unmet when a new request replaced it; the operator decides what happens to them. */\nexport interface SupersededObjective {\n  at: string;\n  objective: string;\n  objectiveSha256: string;\n  requirements: Array<{ id: string; text: string; status: RequirementStatus }>;\n  status: \"pending_decision\";\n}\n\nexport interface VerificationAttempt {\n  n: number;\n  command: string;\n  /** Candidate identity of the workspace the verifier ran on (tracked and untracked, non-ignored files). */\n  inputs: string;\n  /**\n   * What else must be unchanged before a prior failure is reused: the agent process that ran it, the count of\n   * mutating tool calls (any edit, write or shell command) at that time, and a fingerprint of inputs git ignores\n   * (PATH, dependency install markers, .env files).\n   */\n  epoch?: string;\n  mutationSeq?: number;\n  external?: string;\n  status: VerificationStatus | \"SKIPPED_UNCHANGED_INPUTS\";\n  isDeliverableBound?: boolean;\n  /** False when the run passed but nothing independent of the agent shows the change (see core/independent_check). */\n  independent?: boolean;\n  filtered?: boolean;\n  /** Set when the run was a constraint's own verifier: it is evidence for that requirement only, never a general test run. */\n  requirementId?: string;\n  at: string;\n  /** First failing line of the verifier's output, when it failed. */\n  failedCheck?: string;\n  /** ENVIRONMENT: the verifier could not run (tool missing, exit 126/127, sandbox error); it says nothing about the candidate. */\n  classification?: \"ENVIRONMENT\" | \"CANDIDATE_FAILED\";\n  /** The verifier process's exit code; absent when it never ran or was killed. */\n  exitCode?: number;\n  /** Names of the failing tests (redacted, capped). */\n  failingTests?: string[];\n  /** How many distinct failing tests the run named, uncapped (up to MAX_COUNTED_FAILING_TESTS); absent on older attempts. */\n  failingTotal?: number;\n  /** True when `failingTests` holds fewer names than the run reported. */\n  failingTruncated?: boolean;\n  /** Redacted tail of the verifier's output, capped at MAX_ATTEMPT_EXCERPT_BYTES. */\n  excerpt?: string;\n  /** Lineage (DV-4): the previous real attempt (a skipped re-report is never a parent) and the hash of the step from its inputs to these. */\n  parent?: number;\n  /** sha256 of `parent.inputs NUL inputs`: it identifies the transition between two candidate identities, it is not a content diff. */\n  diffHash?: string;\n}\n\nexport interface ObjectiveOutcome {\n  status: \"completed\" | \"incomplete\" | \"blocked\";\n  reason: string;\n  failedCheck?: string;\n  remaining: string[];\n  nextAction?: string;\n  at: string;\n    this.worktreeRunTurnAuthorized = true;\n    let turnResult: TurnResult | undefined;\n    try {\n      if (this.config.tdd) {\n        this.config.tdd = false;\n        try {\n          if (typeof taskPrompt !== \"string\") throw new Error(\"TDD mode does not accept multimodal task input.\");\n          const tdd = await this.synthesizer.runAutonomousTdd(this, taskPrompt);\n          // The TDD workflow is several turns; report the last turn, downgraded if the workflow itself did not succeed.\n          const last = this.lastTurnResult;\n          if (last && !tdd.success && last.execution === \"COMPLETED\" && (last.outcome === \"VERIFIED\" || last.outcome === \"NOT_REQUIRED\")) {\n            turnResult = deepFreezeTurn(assertTurnResultInvariants({\n              ...last, outcome: \"NOT_ESTABLISHED\", reason: \"VERIFIER_FAILED\", detail: `TDD workflow: ${tdd.summary}`, verification: last.verification,\n            }));\n          } else {\n            turnResult = last;\n          }\n        } finally {\n          this.config.tdd = true;\n        }\n      } else {\n        turnResult = await this.runTurn(taskPrompt, onConfirm, options);\n      }\n    } finally {\n      this.worktreeRunTurnAuthorized = false;\n      if (this.activeWorktree?.kind === \"named\") {\n        console.log(pc.cyan(`🌲 Named worktree ${this.activeWorktree.branch} kept at ${this.activeWorktree.worktreePath}. Merge it with \\`nexus worktree merge\\` from inside it, or remove it with \\`nexus worktree remove\\`.`));\n      } else if (this.activeWorktree && this.config.worktree) {\n        const hasChanges = this.worktreeManager.hasChanges(this.activeWorktree.taskId);\n        if (hasChanges) {\n          if (\n            this.activeValidationReceipt &&\n            !this.worktreeManager.rootHasChanges() &&\n            !this.worktreeManager.hasIgnoredChanges(this.activeWorktree.taskId)\n          ) {\n            console.log(pc.cyan(`🌲 Merging verified changes from worktree ${this.activeWorktree.branch}...`));\n            const result = this.mergeActiveWorktree(\n              `nexus: apply verified changes from ${this.activeWorktree.taskId}`,\n              this.activeValidationReceipt\n            );\n            if (!result.success) {\n              console.log(pc.yellow(`⚠️ Worktree retained because merge was refused: ${result.error || \"unknown error\"}`));\n            }\n          } else {\n            console.log(pc.yellow(`⚠️ Speculative changes are unverified or the root workspace is dirty; retaining worktree at ${this.activeWorktree.worktreePath}`));\n          }\n        } else {\n          this.discardActiveWorktree();\n        }\n      }\n    }\n    if (!turnResult) throw new Error(\"Turn ended without a result\");\n    return turnResult;\n  }\n\n  /**\n   * In-turn delegation for the spawn_subagent tool: a non-durable helper loop whose result is part of the parent's turn\n   * (the parent is the durable unit). It has no step allowance: it runs while it progresses (core/execution_tracking.ts)\n   * and stops on its report, on the same repetition and stagnation rules as a turn, or when the parent's turn is\n   * cancelled. Completed only when the subagent called task_completed or delivered a final report; inference failure,\n   * stagnation and cancellation are reported as not completed. Durable autonomous work (/team, nexus operation) does\n   * not use this path: it runs as scheduled work units.\n   */\n  public async runSubagent(prompt: string, onConfirm?: ConfirmHandler, signal?: AbortSignal): Promise<SubagentResult> {\n    if (this.config.worktree && !this.activeWorktree && !this.inheritedWorktreeScope) {\n      throw new Error(\"Cannot run a worktree-enabled subagent without an established worktree authority.\");\n    }\n    if (this.inheritedWorktreeScope && path.resolve(this.config.workspace) !== path.resolve(this.inheritedWorktreeScope.workspace)) {\n      throw new Error(\"Subagent workspace no longer matches its inherited worktree authority.\");\n    }\n    this.runningAsSubagent = true;\n    this.subagentObjective = prompt;\n    // A subagent is used for one run: its commands are tied to the parent turn's cancellation for its lifetime.\n    this.bridge.setTurnSignal(signal);\n    this.resetConversation();\n    this.messages.push({\n      role: \"user\",\n      content: `[Subagent Objective]: ${prompt}\\n\\nPlease inspect, execute tools as needed, and produce a concise, comprehensive report answering the objective. Call task_completed when done.`,\n    });\n\n    const stagnationSteps = this.config.continuation?.stagnationSteps ?? DEFAULT_CONTINUATION.stagnationSteps;\n    const maxRecoveries = this.config.continuation?.maxRecoveries ?? DEFAULT_CONTINUATION.maxRecoveries;\n    const maxTotalSteps = this.config.continuation?.maxTotalSteps ?? this.config.maxSteps;\n    // A subagent consumes the same objective-wide step allowance as its parent. The shared tracking data survives\n    // resume; the subagent's local tracker below is only for its own progress/stagnation decisions.\n    const budgetLedger = this.sharedObjectiveBudget?.ledger ?? (this.durable ? this.objective : undefined);\n    const objectiveTracker = budgetLedger ? trackingOf(budgetLedger) : undefined;\n    const tracker = ExecutionTracker.fresh();\n    tracker.beginTurn();\n    let state = this.workspaceStateIdentity();\n    tracker.noteState(state);\n    let recoveries = 0;\n    let currentStep = 1;\n    let finalSummary = \"\";\n    let previousReplyTruncated = false;\n\n    for (;;) {\n      if (signal?.aborted) return { completed: false, summary: finalSummary, reason: \"cancelled with the parent turn\" };\n      const consumedTaskSteps = objectiveTracker?.data.cumulativeSteps ?? (currentStep - 1);\n      if (consumedTaskSteps >= maxTotalSteps) {\n        return { completed: false, summary: finalSummary, reason: `objective step budget exhausted (${consumedTaskSteps}/${maxTotalSteps}); no further subagent inference was submitted` };\n      }\n      if (tracker.data.stepsWithoutProgress >= stagnationSteps) {\n        const loops = tracker.loops().slice(0, 2).map((r) => `${r.action} ×${r.count}`).join(\"; \");\n        return { completed: false, summary: finalSummary, reason: `no progress for ${tracker.data.stepsWithoutProgress} consecutive steps${loops ? ` (repeated: ${loops})` : \"\"}` };\n      }\n      const cumulativeStep = tracker.beginStep();\n      if (objectiveTracker) {\n        objectiveTracker.beginStep();\n        if (budgetLedger) budgetLedger.continuation.totalSteps = objectiveTracker.data.cumulativeSteps;\n        // The helper runs through this parent agent, so its extra inference steps must be in the durable objective\n        // ledger before any request is sent. Do not persist the helper's temporary message array as the parent chat.\n        const persisted = this.sharedObjectiveBudget ? this.sharedObjectiveBudget.persist() : this.persistObjectiveBudget();\n        if (!persisted) {\n          return { completed: false, summary: finalSummary, reason: \"PERSISTENCE_FAILED: the shared objective budget could not be saved before delegated inference\" };\n        }\n      }\n      let assistantMessage: ChatMessage;\n      const requestId = randomUUID();\n      const { client: activeClient } = this.selectCognitiveClient(currentStep, this.messages);\n      try {\n        await this.admitWithFindings(activeClient, currentStep, requestId, signal);\n        await this.measureAdmission(activeClient, currentStep, requestId, signal);\n        const policy = this.recoveryPolicy ?? recoveryPolicyFromEnv();\n        const lengthGuard = { step: currentStep, cutAfterMs: 0 };\n        assistantMessage = await new ProviderRecoveryController(policy, this.recoveryClock, currentStep, {\n          everSucceeded: typeof activeClient.hasEverSucceeded === \"function\" ? activeClient.hasEverSucceeded() : true,\n          endpoint: activeClient.endpoint,\n        }).run(requestId, {\n          submit: (s) => this.submitGenAiRequest(activeClient, () =>\n            this.submitGuardingLength(lengthGuard, this.messages, (request) =>\n              activeClient.chatCompletion(request, this.getEffectiveTools(), s.requestId, signal))),\n          probe: (probeSignal, opts) =>\n            typeof activeClient.probeAvailability === \"function\"\n              ? activeClient.probeAvailability(probeSignal, { timeoutMs: policy.probeTimeoutMs, ...opts })\n              : Promise.resolve({ available: true, condition: \"AVAILABLE\" as const }),\n          classify: (err) => (err instanceof InferenceError && err.kind !== \"output_truncated\" ? err.toFailure() : null),\n          newRequestId: () => randomUUID(),\n        }, signal);\n      } catch (err: any) {\n        if (signal?.aborted) return { completed: false, summary: finalSummary, reason: \"cancelled with the parent turn\" };\n        if (err instanceof InferenceError && err.kind === \"output_truncated\" && !previousReplyTruncated) {\n          previousReplyTruncated = true;\n          tracker.intervention(cumulativeStep, \"output_truncated\", `reply cut off at the output limit: ${err.truncatedCalls.map((c) => c.name).join(\", \") || \"text\"}; nothing ran`);\n          this.messages.push(harnessNoteMessage(truncatedReplyNotice(err.truncatedCalls, activeClient.getOutputAllowance?.(), `subagent step ${currentStep}`)));\n          tracker.evaluateStep(cumulativeStep, { stateBefore: state, stateAfter: state, verdicts: [] });\n          currentStep++;\n          continue;\n        }\n        const what = err instanceof ContextBudgetError ? \"context admission refused the request\" : \"inference failed\";\n        return { completed: false, summary: finalSummary, reason: `${what}: ${err?.message ?? err}` };\n      }\n\n      previousReplyTruncated = false;\n      const promptEst = calculateContextBudget(\n        this.requestMessages(this.messages),\n        this.getEffectiveTools(),\n        this.contextLimit(),\n      ).totalActiveTokens;\n      const compContent = typeof assistantMessage.content === \"string\"\n        ? assistantMessage.content\n        : Array.isArray(assistantMessage.content)\n        ? JSON.stringify(assistantMessage.content)\n        : \"\";\n      const compEst =\n        countTokens(compContent) +\n        countTokens(JSON.stringify(assistantMessage.tool_calls || []));\n      const reported = activeClient.getProviderId?.() ? activeClient.getLastUsage?.() : undefined;\n      this.totalTokens.prompt += reported?.inputTokens ?? promptEst;\n      this.totalTokens.completion += reported?.outputTokens ?? compEst;\n      this.totalTokens.total = this.totalTokens.prompt + this.totalTokens.completion;\n      this.totalTokens.requests++;\n      if (reported?.inputTokens !== undefined) this.totalTokens.reportedRequests++;\n      else this.totalTokens.estimatedRequests++;\n      const nativeTools = activeClient?.supportsNativeTools?.() ?? true;\n      const parsed = this.parseNormalizedResponse(assistantMessage, nativeTools);\n      this.addToolCallSyntax(parsed.toolCallSyntax);\n      this.uniqueCallIds(parsed.toolCalls, tracker);\n      this.messages.push({\n        role: \"assistant\",\n        content: assistantMessage.content || \"\",\n        ...(parsed.toolCalls.length > 0 ? { tool_calls: parsed.toolCalls } : {}),\n      });\n\n      if (parsed.toolCalls.length === 0) {\n        const report = parsed.thoughtText || (typeof assistantMessage.content === \"string\" ? assistantMessage.content : \"\");\n      ledger.steering.push(...carried);\n      const prior = this.objective?.superseded ?? [];\n      if (prior.length || orphaned) ledger.superseded = [...prior, ...(orphaned ? [orphaned] : [])];\n    } else {\n      if (this.unitId && !ledger.unitId) {\n        ledger.unitId = this.unitId;\n      }\n      const isHarnessResume = /^\\[(?:Nexus|Work unit resumed)/.test(taskPrompt);\n      if (!isHarnessResume && !isStep && taskPrompt.trim() !== \"\") {\n        // The unfinished objective is kept; numbered items in the follow-up are added as further requirements.\n        amendObjective(ledger, taskPrompt);\n      }\n    }\n    ledger.outcome = undefined;\n    ledger.continuation = { ...ledger.continuation, segments: 1, lastProgressStep: 0, stopReason: undefined };\n    this.objective = ledger;\n  }\n\n  let currentStep = 1;\n  let stepsUsed = 0;\n  const providerRecoveries: ProviderRecoveryRecord[] = [];\n  const budget = this.config.continuation;\n  const segmentSteps = Math.max(1, this.config.maxSteps);\n  const maxTotalSteps = budget ? budget.maxTotalSteps : segmentSteps;\n  let segment = 1;\n  const tracker = this.objective && this.durable ? trackingOf(this.objective) : ExecutionTracker.fresh();\n\n  try {\n    if (this.flightRecorder) {\n      if (!this.flightRecorder.isSessionActive()) {\n        this.flightRecorder.startSession({\n          model: this.config.model,\n          endpoint: this.config.endpoint,\n          taskPrompt: promptText,\n        });\n      }\n      this.flightRecorder.recordTurnStart(1, promptText);\n    }\n\n    // Dynamic runtime state injected into turn-level context without invalidating system prompt prefix cache\n    const gitInfo = getGitInfo(this.config.workspace);\n    let runtimeContext = \"\";\n    if (gitInfo.isRepo) {\n      runtimeContext += `\\n[Git Status: ${gitInfo.branch} (${gitInfo.dirtyCount} uncommitted dirty files)]`;\n    }\n    if (this.activePlan && this.activePlan.length > 0) {\n      runtimeContext += `\\n[Active Plan: ${this.activePlan.map((p: any, i: any) => `${i + 1}. [${p.status}] ${p.name}`).join(\" -> \")}]`;\n    }\n\n    const skipPromptSubmission =\n      (isStep || isResume) &&\n      typeof taskPrompt === \"string\" &&\n      taskPrompt.trim() === \"\" &&\n      (this.messages.length > 0 || continuingObjective);\n\n    const effectiveUserContent = typeof taskPrompt === \"string\"\n      ? (runtimeContext ? `${taskPrompt}\\n${runtimeContext}` : taskPrompt)\n      : taskPrompt;\n\n    const historyBeforeSubmission = this.messages.length;\n    if (!skipPromptSubmission) {\n      this.messages.push({\n        role: \"user\",\n        content: effectiveUserContent,\n      });\n      // Skills whose descriptions fit this message, written once right after it and never moved: every later\n      // request extends the earlier ones, so the provider's prefix cache survives each new prompt.\n      const skillNote = this.skillNoteFor(taskPrompt);\n      if (skillNote) this.messages.push({ role: \"user\", content: skillNote, harness: \"skill-note\" });\n      // The objective is durable before anything acts on it.\n      this.persistProgress({ messages: true });\n    }\n    const pendingMessageChars = typeof effectiveUserContent === \"string\" ? effectiveUserContent.length : JSON.stringify(effectiveUserContent).length;\n\n    let capacityBlock: CapacityRecord | null = null;\n    let modelStop: ModelStop = \"NONE\";\n    let finalOutputComplete = false;\n    let previousReplyEmpty = false;\n    // The previous step's reply was cut off at the output limit; a second one in a row ends the turn.\n    let previousReplyTruncated = false;\n    let capacityRetryAttempted = false;\n    let inferenceFailure: InferenceFailure | null = null;\n    let interruption: InterruptionRecord | null = null;\n    let undispatched = 0;\n    let persistenceFailure: string | undefined;\n\n    const markInterrupted = (phase: InterruptionRecord[\"phase\"], extra: Partial<InterruptionRecord> = {}) => {\n      interruption = {\n        requestedAt: turn.cancelRequestedAt || new Date().toISOString(),\n        phase,\n        undispatchedToolCalls: undispatched,\n        ...extra,\n      };\n    };\n    const cancelledToolMessage = (call: ToolCall) => ({\n      role: \"tool\" as const,\n      tool_call_id: call.id,\n      name: call.function.name,\n      content: \"Cancelled by operator before execution. No action was taken.\",\n    });\n\n    // Continuation: `maxSteps` is a segment, a durable checkpoint. The total-step budget is objective-scoped and\n    // survives resumes; the active invocation also has a finite wall-clock limit. Without continuation\n    // (`--no-continuation`), the first segment boundary ends the turn (LIMIT_REACHED, legacy).\n    const turnDeadline = budget && Number.isFinite(budget.maxTurnMinutes) ? Date.now() + budget.maxTurnMinutes * 60_000 : Number.POSITIVE_INFINITY;\n    let stopReason: TurnReason | undefined;\n    let stopDetail: string | undefined;\n    let completionNudges = 0;\n    // Recovery state (notes, stage, refusals) lives in the tracker: in the ledger when durable, so compaction cannot\n    // remove it and resume restores it.\n    const allowedDenials = budget ? Math.max(1, budget.maxRecoveries) : 0;\n    this.stateIdentityDisabled = false;\n    this.stateIdentityUncertainty = undefined;\n    tracker.beginTurn();\n    if (continuingObjective) {\n      const isHarnessResume = typeof taskPrompt === \"string\" && /^\\[(?:Nexus|Work unit resumed)/.test(taskPrompt);\n      if (!isHarnessResume && !options?.resume && !isStep) {\n        tracker.operatorInput(tracker.data.cumulativeSteps, `operator follow-up: ${promptText.slice(0, 160)}`);\n      }\n    }\n    let stateNow = this.workspaceStateIdentity();\n    this.turnStartState = stateNow;\n    tracker.noteState(stateNow);\n    tracker.noteLedgerState(this.ledgerProgressIdentity());\n    const noticedPolls = new Set<string>();\n    const noticedThrash = new Set<string>();\n    let stateUnknownNoted = false;\n    const callRing: CallRecord[] = [];\n    let repeatedCallNote: string | undefined;\n    let loopedCall: { name: string; count: number; arguments: string; history: NonNullable<TurnResult[\"repeatedCall\"]>[\"history\"] } | undefined;\n\n    while (modelStop === \"NONE\" && !interruption && !inferenceFailure && !persistenceFailure) {\n      const convergence = this.turnConvergence as TurnResult[\"convergence\"];\n      if (convergence && !stopReason) {\n        stopReason = \"VERIFIER_NOT_CONVERGING\";\n        stopDetail = convergence.evidence;\n        if (this.objective && this.turnConvergenceUpTo !== undefined) this.objective.convergenceResetAfter = this.turnConvergenceUpTo;\n      }\n      if (stopReason) break;\n      const taskStepLimitReached = budget\n        ? tracker.data.cumulativeSteps >= maxTotalSteps\n        : currentStep > maxTotalSteps;\n      if (taskStepLimitReached) {\n        stopReason = budget ? \"STEP_BUDGET_EXHAUSTED\" : \"STEP_LIMIT_REACHED\";\n        stopDetail = budget\n          ? `objective step limit ${maxTotalSteps} reached (${tracker.data.cumulativeSteps} steps consumed across runs)`\n          : `--no-continuation: ${segmentSteps} steps`;\n        break;\n      }\n      if (Date.now() > turnDeadline) {\n        stopReason = \"TIME_BUDGET_EXHAUSTED\";\n        stopDetail = `operator time limit ${budget!.maxTurnMinutes} min`;\n        break;\n      }\n      if (budget && tracker.data.stepsWithoutProgress >= budget.stagnationSteps) {\n        stopReason = \"STAGNATION_DETECTED\";\n        const loops = tracker.loops().slice(0, 2).map((r) => `${r.action} ×${r.count}`).join(\"; \");\n        const thrash = tracker.reacquisitions().filter((r) => (r.reacquired ?? 0) >= 2).slice(0, 2).map((r) => `${r.action} re-read ×${r.reacquired} after compaction`).join(\"; \");\n        stopDetail = `${tracker.data.stepsWithoutProgress} consecutive steps without progress${loops ? ` (repeated: ${loops})` : \"\"}${thrash ? ` (context thrash: ${thrash})` : \"\"}${this.stateIdentityUncertainty ? `; ${this.stateIdentityUncertainty}` : \"\"}`;\n        tracker.stagnation(tracker.data.cumulativeSteps, \"no_progress\", stopDetail);\n        break;\n      }\n      if (signal.aborted) {\n        markInterrupted(\"between_steps\");\n        break;\n      }\n      // --step: one model/tool cycle per turn. Every path that continues the loop ends its cycle with endStep (recovery\n      // note delivered, progress evaluated) and comes back here, so this one boundary covers the sequential, parallel-read\n      // and notice paths alike; a stop set by the cycle or by the checks above (STAGNATION_DETECTED, a budget, a cancel)\n      // is reported instead. currentStep advances only in endStep, so it is past 1 once this turn finished a cycle.\n      if (isStep && currentStep > 1) {\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { randomUUID } from \"node:crypto\";\nimport { parse as parseDotenv } from \"dotenv\";\nimport { CONTENT_CALL_NOTE, isContentCallReply } from \"./core/content_tool_call.js\";\nimport { acceptsToolChoice } from \"./core/models_snapshot.js\";\nimport { parseAdmissionHeaders, parseAdvertisement, parseOllamaVersion, parseServerContext, parseTokenizeResponse, parseVllmVersion, serverKindOf, type AdmissionReport, type Advertisement, type RequestCount, type ServerKind } from \"./core/provider_capabilities.js\";\nimport { adaptToolDefinitionsForServer, constrainTextModeToolCall, isGrammarRejection, toolGrammarEnabled } from \"./core/tool_grammar_provider.js\";\nimport { ChatMessage, ToolDefinition, HarnessConfig, ToolCall } from \"./types.js\";\nimport { InformationFlowBoundary, DestinationTrustBoundary } from \"./core/egress.js\";\nimport pc from \"picocolors\";\nimport type {\n  ExecutionStatus,\n  InferenceFailure,\n  InferenceFailureKind,\n  InferenceFailureOrigin,\n  ProviderCondition,\n  ProviderHints,\n  TransportCause,\n} from \"./core/turn.js\";\nimport {\n  classifyHttpFailure,\n  classifyTransportFailure,\n  isTlsVerificationError,\n  providerHints,\n  TEMPORARY_CONDITIONS,\n  type ProbeResult,\n  type ProviderClassification,\n} from \"./core/provider_recovery.js\";\nimport { redactSecrets } from \"./ui.js\";\nimport { classifyLocality, setLocalityAuthorityResolver } from \"./core/egress.js\";\nimport { connectionFor, disclosureClass, promptCacheEnabled, operatorSettingKeyForAuth, type ResolvedConnection } from \"./providers.js\";\nimport { ProviderStreamError, readSse, type NativeRequestInput, type NativeResult } from \"./protocols/common.js\";\nimport { wireProtocol } from \"./protocols/index.js\";\nimport { GcpAuthError, gcpTokenSource, resolveVertexTarget, vertexPath } from \"./protocols/gcp_adc.js\";\nimport { buildChatRequest, chatStreamParser, chatUsage, ChatErrorFrame, parseChatResponse, readChatStream } from \"./protocols/openai_chat.js\";\nimport { UsageLedger, type UsageReport } from \"./usage.js\";\nimport { localEndpointCredential, localEndpointCredentials, resolveCredential, type StoredCredential } from \"./credentials.js\";\nimport { COPILOT_HEADERS, copilotToken } from \"./oauth.js\";\nimport { refreshStoredSignIn } from \"./oauth_shared_refresh.js\";\nimport { providerDefinition } from \"./providers.js\";\nimport { ServerKindCache } from \"./core/server_kind_cache.js\";\nimport { persistableEndpoint } from \"./core/endpoint_identity.js\";\n\n/** Longest a request waits for an expired server identity to be re-read before proceeding without it. */\nconst REVERIFY_WAIT_MS = 1000;\n/** How long an endpoint that rejected the tool-call grammar is sent requests without it. */\nconst GRAMMAR_REJECTION_TTL_MS = 10 * 60_000;\n\n/**\n * Opaque per-process account markers for the server-kind cache key. No hash of the credential is computed: the\n * credential is compared by equality here and only a small integer enters the cache key (never logged or persisted).\n */\nconst accountMarkers = new Map<string, number>();\nlet nextAccountMarker = 1;\nfunction accountMarker(credential: string): number {\n  let marker = accountMarkers.get(credential);\n  if (marker === undefined) {\n    if (accountMarkers.size >= 64) accountMarkers.clear(); // bounded; a cleared marker only costs one re-discovery\n    marker = nextAccountMarker++;\n    accountMarkers.set(credential, marker);\n  }\n  return marker;\n}\n\ntype OAuthCredential = Extract<StoredCredential, { type: \"oauth\" }>;\n\nfunction originOf(url: string | undefined): string | undefined {\n  if (!url?.trim()) return undefined;\n  try {\n    return new URL(url.trim()).origin;\n  } catch {\n    return undefined;\n  }\n}\n\n/** The origin a credential configured for `endpoint` belongs to. */\nexport function credentialOriginOf(endpoint: string | undefined): string | undefined {\n  return originOf(endpoint);\n}\n\nfunction readConfigEnv(): Record<string, string> {\n  try {\n    return parseDotenv(fs.readFileSync(path.join(credentialStorageHome(), \".config/nexus/config.env\"), \"utf-8\"));\n  } catch {}\n  return {};\n}\n\n/**\n * The stored gateway token: the file named by the operator's NEXUS_GATEWAY_TOKEN_FILE (environment or config.env, never\n * a project .env), else ~/.config/nexus/gateway-token. It is sent only to the origin config.env names (see credentialOriginOf).\n */\nfunction readGatewayTokenFile(): string | undefined {\n  const configured = operatorSetting(\"NEXUS_GATEWAY_TOKEN_FILE\");\n  const file = configured\n    ? path.resolve(credentialStorageHome(), configured.replace(/^~(?=\\/)/, credentialStorageHome()))\n    : path.join(credentialStorageHome(), \".config/nexus/gateway-token\");\n  try {\n    return fs.readFileSync(file, \"utf-8\").trim() || undefined;\n  } catch {\n    return undefined;\n  }\n}\n\n/**\n * Settings with authority over where credentials may be sent: the operator's process environment as it was before\n * any env file was loaded, overlaid by ~/.config/nexus/config.env. Project and installation .env files are excluded:\n * they may choose endpoints and carry their own keys, but they never decide where a stored credential goes.\n * Undefined until loadEnvironment() records it; until then nothing but the operator has written process.env.\n */\nlet credentialAuthority: Readonly<Record<string, string | undefined>> | undefined;\n/**\n * The operator's home directory as resolved when the authority was recorded: the stored credentials (config.env, the\n * gateway token file) are read from there, never from a HOME that an env file set later.\n */\nlet credentialHome: string | undefined;\n\nexport function setCredentialAuthority(settings: Record<string, string | undefined>, operatorHome: string = os.homedir()): void {\n  credentialAuthority = Object.freeze({ ...settings });\n  credentialHome = operatorHome;\n}\n\n/** Where the operator's stored credentials live (the live home only before any authority is recorded). */\nexport function credentialStorageHome(): string {\n  return credentialHome ?? os.homedir();\n}\n\nfunction authoritySetting(key: string): string | undefined {\n  return (credentialAuthority ? credentialAuthority[key] : process.env[key])?.trim() || undefined;\n}\n\n/** A setting as the operator configured it (operator environment + config.env; never a project or install .env). */\nexport function operatorSetting(key: string): string | undefined {\n  return authoritySetting(key);\n}\n\nsetLocalityAuthorityResolver(operatorSetting);\n\n/** Origins that stored credentials belong to, and the operator-environment key with its own origin. */\nfunction storedCredentialHomes(): { gateway?: string; listed: Set<string>; envKey?: string; envKeyOrigin?: string } {\n  const file = readConfigEnv();\n  // When a legacy config.env key was present before the endpoint changed, the setup writer records its original\n  // origin explicitly. Apply that binding to the merged operator key too: loadEnvironment() intentionally combines\n  // shell and config.env values, so deriving the key origin from the new endpoint would silently rebind the old key.\n  const configuredCredentialOrigin = authoritySetting(\"LOCAL_LLM_CREDENTIAL_ORIGIN\") ?? file.LOCAL_LLM_CREDENTIAL_ORIGIN;\n  const invalidCredentialOrigin = Boolean(configuredCredentialOrigin && !originOf(configuredCredentialOrigin));\n  // A malformed explicit binding is not equivalent to an absent binding. Do not fall back to the currently\n  // selected endpoint, which could silently attach a legacy key to a different gateway.\n  const envKeyOrigin = invalidCredentialOrigin ? undefined : originOf(configuredCredentialOrigin)\n    ?? originOf(authoritySetting(\"LOCAL_LLM_ENDPOINT\"));\n  const gateway = invalidCredentialOrigin ? undefined : originOf(configuredCredentialOrigin)\n    ?? originOf(file.LOCAL_LLM_ENDPOINT)\n    ?? envKeyOrigin;\n  const listed = new Set(\n    (authoritySetting(\"LOCAL_LLM_CREDENTIAL_ORIGINS\") ?? \"\").split(\",\").map((o) => originOf(o)).filter((o): o is string => Boolean(o)),\n  );\n  return { gateway, listed, envKey: authoritySetting(\"LOCAL_LLM_API_KEY\"), envKeyOrigin };\n}\n\n/**\n * The locally stored credential for `endpoint`, only if it belongs to that endpoint's gateway; null otherwise.\n *\n * Stored credentials are scoped to where they were configured: the gateway token file and the config.env key belong\n * to config.env's LOCAL_LLM_ENDPOINT (or, without one, the operator's $LOCAL_LLM_ENDPOINT) and to origins the operator\n * lists in LOCAL_LLM_CREDENTIAL_ORIGINS; the operator's $LOCAL_LLM_API_KEY belongs to the operator's\n * $LOCAL_LLM_ENDPOINT. Only the credential authority (see setCredentialAuthority) decides these bindings. A\n * credential is never attached to another provider merely because that provider has no key of its own.\n */\nexport function storedCredentialFor(endpoint: string): string | null {\n  const target = originOf(endpoint);\n  if (!target) return null;\n  const homes = storedCredentialHomes();\n  if (target === homes.gateway || homes.listed.has(target)) {\n    const token = readGatewayTokenFile() || readConfigEnv().LOCAL_LLM_API_KEY;\n    if (token) return token;\n  }\n  const endpointCredential = localEndpointCredential(target);\n  if (endpointCredential?.origin === target) return endpointCredential.key;\n  if (target === homes.envKeyOrigin && homes.envKey) return homes.envKey;\n  return null;\n}\n\n/** True when `value` is one of the locally stored credentials (token file, config.env key, operator env key). */\nfunction isStoredCredential(value: string): boolean {\n  const homes = storedCredentialHomes();\n  return [readGatewayTokenFile(), readConfigEnv().LOCAL_LLM_API_KEY, homes.envKey, ...localEndpointCredentials().map((credential) => credential.key)]\n    .some((stored) => stored && stored === value);\n}\n\n/**\n * Whether `key`, supplied for `endpoint` by configuration other than the credential authority (an operation spec's\n * apiKeyEnv, for example), may be sent there. Keys of their own are; a stored credential only to where it belongs.\n */\nexport function mayBindCredential(key: string | undefined, endpoint: string): boolean {\n  const value = key?.trim();\n  if (!value || !isStoredCredential(value)) return true;\n  const target = originOf(endpoint);\n  if (!target) return false;\n  const homes = storedCredentialHomes();\n  const endpointCredential = localEndpointCredentials().find((credential) => credential.key === value);\n  return target === homes.gateway || homes.listed.has(target) || (target === homes.envKeyOrigin && value === homes.envKey) || endpointCredential?.origin === target;\n}\n\n/**\n * $LOCAL_LLM_API_KEY and the origin it is bound to. The operator's key belongs to the operator's endpoint (or, when\n * the operator configured none, `operatorEndpoint`: the command-line endpoint or the built-in default). A key that a\n * project .env supplied belongs to the endpoint that configuration selects; it is that project's credential.\n */\nexport function environmentCredential(operatorEndpoint: string): { apiKey: string; origin: string | undefined } | undefined {\n  const apiKey = REDACTED;\n  if (!apiKey) return undefined;\n  const operatorKey = authoritySetting(\"LOCAL_LLM_API_KEY\");\n  const configuredCredentialOrigin = authoritySetting(\"LOCAL_LLM_CREDENTIAL_ORIGIN\") ?? readConfigEnv().LOCAL_LLM_CREDENTIAL_ORIGIN;\n  if (configuredCredentialOrigin && !originOf(configuredCredentialOrigin) && (operatorKey === apiKey || isStoredCredential(apiKey))) {\n    return undefined;\n  }\n  if (operatorKey === apiKey) {\n    return {\n      apiKey,\n","exit_code":0,"duration":{"secs":0,"nanos":36586}},"started_at_ms":1795156468062,"completed_at_ms":1795156468062}}
{"timestamp":"2026-11-20T06:34:28.203Z","ordinal":32692,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1f7a9-e1eb-7e51-8984-a9a55cbd13a7","call_id":"call_8b533df8675c46fc89268b5af6eb2d0e","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 10994)\nTotal output lines: 832\n\n\nexport interface ExecutionResult {\n  success: boolean;\n  output: string;\n  error?: string;\n  /** The operation's deadline expired before an answer was received (bridge-level; the runner reports its own via `timed_out`). */\n  timedOut?: boolean;\n  /** The operator's cancel ended the operation (the runner ended the command's process group). */\n  cancelled?: boolean;\n  /** Why the call was refused before it ran (a stable code, e.g. VERIFICATION_CONFIG_PROTECTED). */\n  denialReason?: string;\n}\n\n/**\n * Bounds for automatically continued work. The total-step limit is cumulative across every invocation that continues\n * the same durable objective; the wall-clock limit bounds one active invocation. Progress detection remains a separate\n * early-stop mechanism, not a substitute for these hard ceilings.\n */\nexport interface ContinuationBudget {\n  /** Maximum steps for one objective across runs and resumes (STEP_BUDGET_EXHAUSTED). */\n  maxTotalSteps: number;\n  /** Maximum wall-clock minutes for one invocation (TIME_BUDGET_EXHAUSTED). */\n  maxTurnMinutes: number;\n  /**\n   * Consecutive steps without observed progress before the turn stops (STAGNATION_DETECTED). A repeated-state\n   * threshold, not a task length: any progressing step resets it (core/execution_tracking.ts defines progress).\n   */\n  stagnationSteps: number;\n  /** Recovery notes the agent may inject for a repeated identical action before stopping (bounded recovery). */\n  maxRecoveries: number;\n  /** Times the agent may be asked to continue when it stops with acceptance requirements still open. */\n  maxCompletionNudges: number;\n  /**\n   * Consecutive failed verifier attempts on changing candidates that stop the turn as VERIFIER_NOT_CONVERGING when they\n   * show the same failure, an A/B alternation or a rising failing-test count (default 3, NEXUS_VERIFIER_CONVERGENCE_ATTEMPTS).\n   */\n  verifierConvergenceAttempts?: number;\n}\n\n/** Hard upper bounds keep an operator override finite even when a config or direct API caller bypasses CLI parsing. */\nexport const MAX_CONTINUATION_STEPS = 5_000;\nexport const MAX_CONTINUATION_MINUTES = 4_320;\n\nexport function assertValidContinuationBudget(budget: ContinuationBudget | undefined): void {\n  if (!budget) return;\n  if (!Number.isSafeInteger(budget.maxTotalSteps) || budget.maxTotalSteps < 1 || budget.maxTotalSteps > MAX_CONTINUATION_STEPS) {\n    throw new Error(`Invalid continuation step budget: expected an integer from 1 to ${MAX_CONTINUATION_STEPS}.`);\n  }\n  if (!Number.isFinite(budget.maxTurnMinutes) || budget.maxTurnMinutes < 1 / 60 || budget.maxTurnMinutes > MAX_CONTINUATION_MINUTES) {\n    throw new Error(`Invalid continuation time budget: expected a finite value from 1 second to ${MAX_CONTINUATION_MINUTES} minutes.`);\n  }\n}\n\n/** Failed verifier attempts on changing candidates that show no convergence before the turn stops (see ContinuationBudget). */\nexport const DEFAULT_CONVERGENCE_ATTEMPTS = 3;\n\nexport const DEFAULT_CONTINUATION: ContinuationBudget = {\n  maxTotalSteps: 500,\n  maxTurnMinutes: 480,\n  stagnationSteps: 12,\n  maxRecoveries: 2,\n  maxCompletionNudges: 2,\n};\n\nexport type ApprovalMode = \"auto\" | \"review\" | \"read-only\";\n/**\n * The objective ledger: what the operator asked for, and how far the work has got against it.\n *\n * The plan (`update_plan`) is the agent's own roadmap and may be coarser than the request. The ledger keeps the\n * request itself — verbatim — and the acceptance criteria seeded from it, so a reduced plan can never stand in for\n * them. Requirements change state only with evidence, scope changes are recorded explicitly, operator steering is\n * kept until applied, and verifier attempts are remembered against the exact workspace inputs they ran on.\n *\n * Pure data and pure functions; the agent owns persistence and presentation.\n */\nimport { createHash } from \"node:crypto\";\nimport type { VerificationStatus } from \"./turn.js\";\nimport { DEFAULT_CONVERGENCE_ATTEMPTS } from \"../types.js\";\nimport type { CanonicalCapability } from \"./capabilities.js\";\nimport { isFilteredVerifierCommand } from \"../tester.js\";\nimport { redactSecrets, safeTerminal } from \"../ui.js\";\nimport { replayObligations, type RegressionObligation, type ReferenceDeclaration, type DifferentialRecord } from \"./regression_obligations.js\";\nimport { createTracking, ExecutionTracker, normalizeTracking, type ExecutionTracking } from \"./execution_tracking.js\";\n\nexport const LEDGER_VERSION = 1;\nexport const PINNED_LEDGER_PREFIX = \"[Objective Ledger - pinned by Nexus; never summarised]\";\nexport const STEERING_PREFIX = \"[Operator steering\";\n/** Objectives longer than this are pinned in full only while the original message has left the context. */\nexport const MAX_PINNED_OBJECTIVE_CHARS = 24_000;\n/** Operator follow-ups and steering pinned verbatim, newest first, up to this many characters (or the block's budget). */\nconst MAX_PINNED_OPERATOR_CHARS = 12_000;\nconst MAX_REQUIREMENT_TEXT = 240;\nconst MAX_EVIDENCE_ITEMS = 6;\nconst MAX_EVIDENCE_CHARS = 300;\nconst MAX_VERIFIER_CHARS = 400;\nconst MAX_TEST_LINKS = 6;\nconst MAX_TEST_LINK_CHARS = 120;\n\nexport type RequirementKind = \"feature\" | \"constraint\" | \"invariant\";\nconst REQUIREMENT_KINDS: readonly string[] = [\"feature\", \"constraint\", \"invariant\"];\n\n/** Verifier and test-link text comes from the operator or the model: one line, no control characters, capped. */\nconst oneLine = (text: string) => text.replace(/[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+/g, \" \").trim();\nconst cleanLine = (text: string, max: number) => clip(oneLine(text), max);\n/** Text shown in the pinned ledger as a code span: nothing inside it can read as ledger structure. */\nconst span = (text: string, max: number) => `\\`${cleanLine(text, max).replace(/`/g, \"'\")}\\``;\n\n/** A command that exits 0 whatever the workspace holds checks nothing. */\nexport function isConstantVerifier(command: string): boolean {\n  return /^(?:true|:|exit\\s+0|\\/(?:usr\\/)?bin\\/true)$/.test(command.trim().replace(/\\s*;+\\s*$/, \"\"));\n}\n\n/** Constraints and invariants hold for the whole task; unlike a feature they are not done on the model's word. */\nexport function isHardRequirement(r: Pick<Requirement, \"kind\">): boolean {\n  return r.kind === \"constraint\" || r.kind === \"invariant\";\n}\n\n/** Claimed implemented, but neither verified by its own verifier nor accepted by the operator. */\nfunction unverifiedHard(r: Requirement): boolean {\n  return isHardRequirement(r) && r.status === \"implemented\" && r.operatorAccepted !== true;\n}\n\nexport type RequirementStatus = \"open\" | \"in_progress\" | \"implemented\" | \"verified\" | \"blocked\" | \"descoped\";\n/** Statuses that need no further work in this task. `blocked` is terminal for the turn but never \"done\". */\nexport const DONE_STATUSES: ReadonlySet<RequirementStatus> = new Set([\"implemented\", \"verified\", \"descoped\"]);\n\n/**\n * Done for the purpose of completion. Descoping reduces what the operator asked for, so only the operator can make\n * it count: a descoped operator or steering requirement stays unresolved until `operatorAccepted` is set (by the\n * operator's `/requirements accept`), while a sub-requirement the agent added itself may be descoped freely.\n */\nexport function requirementDone(r: Requirement): boolean {\n  if (r.status === \"verified\") return true;\n  if (r.status === \"implemented\") return !unverifiedHard(r);\n  return r.status === \"descoped\" && (r.source === \"model\" || r.operatorAccepted === true);\n}\n\nexport interface Requirement {\n  id: string;\n  /** Heading line (capped), for lists. */\n  text: string;\n  /** The requirement's complete wording from the operator's message (nested items included), never truncated. */\n  detail?: string;\n  status: RequirementStatus;\n  /** Absent means a feature (ledgers written before typed requirements). */\n  kind?: RequirementKind;\n  /** Command that checks a constraint or invariant; `verified` needs a passing run of it after the last change. */\n  verifier?: string;\n  /** Who set the verifier. One the model declared is advisory: its run is evidence, never `verified`. */\n  verifierSource?: \"operator\" | \"model\";\n  /** Tests (names or paths) that exercise this requirement. */\n  tests?: string[];\n  /** Where it came from: the operator's objective, operator steering, or the model (added sub-requirement). */\n  source: \"objective\" | \"steering\" | \"model\";\n  /** Implementation and validation evidence (file paths, commands, test names). */\n  evidence: string[];\n  /** Who produced each evidence item, keyed by its text. Items without an entry are the model's claim. */\n  evidenceSources?: Record<string, \"tool\" | \"model\">;\n  /** Reason for blocked/descoped; required for both. */\n  note?: string;\n  /** The operator accepted this requirement's descoping (only the operator's own command sets this). */\n  operatorAccepted?: boolean;\n  /**\n   * The passing verifier run that a `verified` status rests on, recorded on the then-current workspace. Nexus can\n   * show that this run passed on these inputs; it cannot prove the verifier exercises this particular requirement.\n   */\n  verifiedBy?: { attempt: number; command: string; inputs: string; at: string };\n  updatedAt: string;\n}\n\nexport interface ScopeChange {\n  at: string;\n  requirement: string;\n  from: RequirementStatus;\n  to: RequirementStatus;\n  reason: string;\n}