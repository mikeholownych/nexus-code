f (budget <= 0) {\n657:     const essential = notes.filter((note) => !isVerboseDetailNote(note) && note !== DETAIL_ELISION);\n658:     const pinned = pin ? [pin.note] : [];\n659:     return pinned.length || essential.length !== notes.length\n660:       ? essential.concat(pinned, essential.concat(pinned).length < notes.length ? [DETAIL_ELISION] : [])\n661:       : notes;\n662:   }\n663:   const cheap = verbose.filter(({ note }) => note.length <= VERBOSE_NOTE_CHEAP_LIMIT);\n664:   const large = verbose.filter(({ note }) => note.length > VERBOSE_NOTE_CHEAP_LIMIT);\n665:   const retained = new Map<number, string>();\n666:   let remaining = budget;\n667:   if (pin) {\n668:     retained.set(pin.index, pin.note);\n669:     remaining -= pin.note.length;\n670:   }\n671:   if (remaining > 0) {\n672:     for (const item of [...cheap.filter((candidate) => candidate.index !== pin?.index)].reverse()) {\n673:       if (remaining <= 0) break;\n674:       retained.set(item.index, remaining >= item.note.length ? item.note : `${item.note.slice(0, remaining)}${DETAIL_TRUNCATION}`);\n675:       remaining = Math.max(0, remaining - item.note.length);\n676:     }\n677:   }\n678:   // The model's own analysis cannot be reacquired by rerunning a tool, so it is budgeted before raw tool output.\n679:   const isAnalysis = (note: string) => note.startsWith(\"Earlier assistant message: \");\n680:   if (remaining > 0) {\n681:     for (const item of [...large.filter(({ note }) => isAnalysis(note)).reverse(), ...large.filter(({ note }) => !isAnalysis(note)).reverse()]) {\n682:       if (remaining <= 0) break;\n683:       retained.set(item.index, remaining >= item.note.length ? item.note : `${item.note.slice(0, remaining)}${DETAIL_TRUNCATION}`);\n684:       remaining = Math.max(0, remaining - item.note.length);\n685:     }\n686:   }\n687:   if (retained.size === verbose.length) return notes;\n688:   const result: string[] = [];\n689:   let elidedAny = false;\n690:   for (let index = 0; index < notes.