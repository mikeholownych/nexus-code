{"timestamp":"2026-11-20T03:51:56.526Z","ordinal":28805,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f090-96c7-7f02-ae7d-1a090d633b76","turn_id":"01a1f712-aaf3-7db1-9f93-ddce93b124cb","item":{"type":"CommandExecution","id":"exec-57a92732-e80a-40ef-ab1f-90c29a63c1e2","process_id":"44160","command":["/usr/bin/zsh","-lc","rg -n 'setup-go|setup-rust|rustup toolchain install|1\\.27\\.4|rust-analyzer@' .github/workflows docs cli | head -100; git show origin/main:docs/LSP_REAL_SERVERS.md | tail -25; git show origin/main:.github/workflows/lsp-real-servers.yml"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"rg -n 'setup-go|setup-rust|rustup toolchain install|1\\.27\\.4|rust-analyzer@' .github/workflows docs cli | head -100; git show origin/main:docs/LSP_REAL_SERVERS.md | tail -25; git show origin/main:.github/workflows/lsp-real-servers.yml"}],"source":"unified_exec_startup","status":"completed","aggregated_output":".github/workflows/release.yml:27:      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n.github/workflows/ci.yml:22:      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n.github/workflows/ci.yml:119:      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\ndocs/reviews/evidence/v1-qualification/rc.14/source-ci.json:1:{\"conclusion\":\"success\",\"headSha\":\"16eeb6eeffe7fc0bae234aa34dcb671a6ba5ff99\",\"jobs\":[{\"completedAt\":\"2026-10-30T09:14:24Z\",\"conclusion\":\"success\",\"databaseId\":123975740176,\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-30T08:54:09Z\",\"status\":\"completed\",\"steps\":[{\"completedAt\":\"2026-10-30T08:54:11Z\",\"conclusion\":\"success\",\"name\":\"Set up job\",\"number\":1,\"startedAt\":\"2026-10-30T08:54:10Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:13Z\",\"conclusion\":\"success\",\"name\":\"Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":2,\