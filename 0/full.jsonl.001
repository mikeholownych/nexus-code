re-v1/tasks/t2-debug-logs/repo/src/report.js\neval/datasets/core-v1/tasks/t2-debug-logs/repo/test/report.test.js\neval/datasets/core-v1/tasks/t2-debug-logs/task.json\neval/datasets/core-v1/tasks/t2-feature-inventory/hidden/test_inventory_hidden.py\neval/datasets/core-v1/tasks/t2-feature-inventory/repo/inventory.py\neval/datasets/core-v1/tasks/t2-feature-inventory/repo/tests/test_inventory.py\neval/datasets/core-v1/tasks/t2-feature-inventory/task.json\neval/datasets/core-v1/tasks/t2-feature-slugify/hidden/slugify.hidden.test.js\neval/datasets/core-v1/tasks/t2-feature-slugify/repo/package.json\neval/datasets/core-v1/tasks/t2-feature-slugify/repo/slugify.js\neval/datasets/core-v1/tasks/t2-feature-slugify/repo/test/slugify.test.js\neval/datasets/core-v1/tasks/t2-feature-slugify/task.json\neval/datasets/core-v1/tasks/t2-refactor-tax/hidden/test_tax_hidden.py\neval/datasets/core-v1/tasks/t2-refactor-tax/repo/cart.py\neval/datasets/core-v1/tasks/t2-refactor-tax/repo/invoice.py\neval/datasets/core-v1/tasks/t2-refactor-tax/repo/tests/test_totals.py\neval/datasets/core-v1/tasks/t2-refactor-tax/task.json\n--- eval/datasets/core-v1/examples.jsonl\n{\"id\":\"selftest-add\",\"split\":\"regression\",\"domain\":\"harness-integrity\",\"objective\":\"1. Add math.js exporting add(a, b) that returns a + b.\",\"taskDir\":\"tasks/selftest-add\",\"tier\":\"T1\",\"steps\":20,\"minutes\":5}\n{\"id\":\"t2-bugfix-csv\",\"split\":\"benchmark\",\"domain\":\"coding-task\",\"objective\":\"npm test fails. Fix parseLine in csv.js so quoted fields (which may contain commas and doubled quotes \\\"\\\") are parsed correctly. Do not change the tests.\",\"taskDir\":\"tasks/t2-bugfix-csv\",\"tier\":\"T2\",\"steps\":60,\"minutes\":20}\n{\"id\":\"t2-bugfix-duration\",\"split\":\"benchmark\",\"domain\":\"coding-task\",\"objective\":\"The test suite fails (run: python3 -m unittest discover -s tests). Fix the bug in durations.py so the tests pass. Do not change the tests.\",\"taskDir\":\"tasks/t2-bugfix-duration\",\"tier\":\"T2\",\"steps\":60,\"minutes\":20}\n{\"id\":\"t2-debug-logs\",\"split\":\"benchmark\",\"domain\":\"coding-task\",\"objective\":\"logs/app.log shows the report job crashing in production. Find the cause and fix it so the report handles that case, then add a regression test. Do not change the report format for normal input.\",\"taskDir\":\"tasks/t2-debug-logs\",\"tier\":\"T2\",\"steps\":60,\"minutes\":20}\n{\"id\":\"t2-feature-inventory\",\"split\":\"benchmark\",\"domain\":\"coding-task\",\"objective\":\"Add a method remove(name, qty) to Inventory in inventory.py. It decreases the stock of name by qty and returns the remaining quantity; when the remaining quantity is 0 the item is dropped from the inventory. It raises ValueError if qty is not a positive integer, and KeyError if the item is unknown. If there is not enough stock it raises ValueError and leaves the stock unchanged. Add tests for it in tests/.\",\"taskDir\":\"tasks/t2-feature-inventory\",\"tier\":\"T2\",\"steps\":60,\"minutes\":20}\n{\"id\":\"t2-feature-slugify\",\"split\":\"benchmark\",\"domain\":\"coding-task\",\"objective\":\"Add an optional second argument to slugify in slugify.js: an options object with maxLength. When the slug is longer than maxLength, cut it at the last '-' boundary that fits within maxLength (no trailing '-'); if the first word alone is longer than maxLength, cut that word at maxLength. Without the option, behaviour is unchanged. Add tests.\",\"taskDir\":\"tasks/t2-feature-slugify\",\"tier\":\"T2\",\"steps\":60,\"minutes\":20}\n{\"id\":\"t2-refactor-tax\",\"split\":\"benchmark\",\"domain\":\"coding-task\",\"objective\":\"cart.py and invoice.py each compute tax with duplicated code. Extract it into a new module pricing.py with a function apply_tax(amount, rate) returning the taxed total rounded to cents (half-up), and make both cart.py and invoice.py use it (no duplicate tax code left in them). Behaviour must not change; keep the existing tests passing.\",\"taskDir\":\"tasks/t2-refactor-tax\",\"tier\":\"T2\",\"steps\":60,\"minutes\":20}\n--- eval/datasets/core-v1/oracles.jsonl\n{\"id\":\"selftest-add\",\"hidden\":{\"dir\":\"hidden\",\"into\":\"hidden\",\"command\":\"node hidden/math.hidden.test.js\"},\"regression\":{\"command\":\"npm test --silent\"}}\n{\"id\":\"t2-bugfix-csv\",\"hidden\":{\"dir\":\"hidden\",\"command\":\"node hidden/csv.hidden.test.js\"},\"regression\":{\"command\":\"npm test --silent\"}}\n{\"id\":\"t2-bugfix-duration\",\"hidden\":{\"dir\":\"hidden\",\"command\":\"python3 hidden/test_duration_hidden.py\"},\"regression\":{\"command\":\"python3 -m unittest discover -s tests\"}}\n{\"id\":\"t2-debug-logs\",\"hidden\":{\"dir\":\"hidden\",\"command\":\"node hidden/report.hidden.test.js\"},\"regression\":{\"command\":\"npm test --silent\"}}\n{\"id\":\"t2-feature-inventory\",\"hidden\":{\"dir\":\"hidden\",\"command\":\"python3 hidden/test_inventory_hidden.py\"},\"regression\":{\"command\":\"python3 -m unittest discover -s tests\"}}\n{\"id\":\"t2-feature-slugify\",\"hidden\":{\"dir\":\"hidden\",\"command\":\"node hidden/slugify.hidden.test.js\"},\"regression\":{\"command\":\"npm test --silent\"}}\n{\"id\":\"t2-refactor-tax\",\"hidden\":{\"dir\":\"hidden\",\"command\":\"python3 hidden/test_tax_hidden.py\"},\"regression\":{\"command\":\"python3 -m unittest discover -s tests\"}}\n","exit_code":0,"duration":{"secs":0,"nanos":743908161}},"started_at_ms":1793607838346,"completed_at_ms":1793607839090}}
