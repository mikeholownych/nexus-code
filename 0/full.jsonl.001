daction_monotone_corpus.ts\ncli/test/fixtures/request_shape/after_compaction.json\ncli/test/fixtures/request_shape/after_resume.json\ncli/test/fixtures/request_shape/after_tool_call.json\ncli/test/fixtures/request_shape/before_compaction.json\ncli/test/fixtures/request_shape/before_resume.json\ncli/test/fixtures/request_shape/first_turn.json\ncli/test/fixtures/request_shape/retry_note.json\ncli/test/fixtures/state/v1/session-v1-valid.json\ncli/test/fixtures/state/v1/task-corrupt.json\ncli/test/fixtures/state/v1/task-v0-legacy.json\ncli/test/fixtures/state/v1/task-v1-valid.json\ncli/test/fixtures/state/v1/task-v99-future.json\ncli/test/fixtures/token_calibration.json\ncli/test/fixtures/volatile_text_corpus.json\ncli/test/helpers/capacity_fixture.ts\ncli/test/helpers/compaction_crash_child.ts\ncli/test/helpers/fixtures.ts\ncli/test/helpers/gbnf_match.ts\ncli/test/helpers/injection_corpus.ts\ncli/test/helpers/leak_guard.ts\ncli/test/helpers/leak_registry.ts\ncli/test/helpers/operation_lock_child.ts\ncli/test/helpers/provider_fixture.ts\ncli/test/helpers/render_screens.py\ncli/test/helpers/repl_approval_driver.py\ncli/test/helpers/setup.ts\ncli/test/helpers/sidecar_recorder.mjs\ncli/test/helpers/startup_permission_driver.py\ncli/test/helpers/state_store_replacement_child.ts\ncli/test/helpers/tui_approval_driver.py\ncli/test/helpers/tui_approval_single_key_driver.py\ncli/test/helpers/tui_diff_driver.py\ncli/test/helpers/tui_pty_driver.py\ncli/test/helpers/tui_surface_driver.py\ncli/test/redaction_helpers.test.ts\ncli/test/skills_qualification/fixtures/docs-helper.json\ncli/test/skills_qualification/fixtures/reader.json\ncli/test/subagent_delegation_authority.test.ts\ncli/test/vc9_subagent_needs_input.test.ts\norigin/main:cli/test/approval_policy.test.ts:36:function makeRepo(): string {\norigin/main:cli/test/cloud_providers.test.ts:660:function makeRepo(): string {\norigin/main:cli/test/convergence_invariants.test.ts:99:function makeRepo(files: Record<string, string> = {}): string {\norigin/main:cli/test/durable_continuity.test.ts:273:function makeRepo(files: Record<string, string> = {}): string {\norigin/main:cli/test/git_exclude.test.ts:15:function makeRepo(exclude: string | null): { root: string; excludePath: string } {\norigin/main:cli/test/helpers/fixtures.ts:67:export async function startGateway(script: (n: number, body?: any) => Reply, options: GatewayOptions = {}): Promise<Gateway> {\norigin/main:cli/test/helpers/fixtures.ts:167:export function makeRepo(files: Record<string, string> = {}): string {\norigin/main:cli/test/helpers/provider_fixture.ts:61:export async function startGateway(script: (n: number, body: any) => Reply, opts: { startDown?: boolean } = {}): Promise<Gateway> {\norigin/main:cli/test/leak_guard.test.ts:44:    \"definition.ts\": \"export async function startGateway(script) {}\\n\",\norigin/main:cli/test/notification_gating.test.ts:15:function makeRepo(): string {\norigin/main:cli/test/process_bounds_and_services.test.ts:20:function makeRepo(): string {\norigin/main:cli/test/process_lifecycle.test.ts:38:function makeRepo(): string {\norigin/main:cli/test/provider_recovery_agent.test.ts:21:function makeRepo(): string {\norigin/main:cli/test/provider_wait_resume.test.ts:419:function makeRepo(root: string): string {\norigin/main:cli/test/recover_worktree_conversation.test.ts:21:function makeRepo(root: string): string {\norigin/main:cli/test/team_convergence.test.ts:41:function makeRepo(): string {\norigin/main:cli/test/turn_semantics.test.ts:59:async function startGateway(script: (n: number, body: any) => Reply): Promise<Gateway> {\norigin/main:cli/test/turn_semantics.test.ts:119:function makeRepo(files: Record<string, string> = {}): string {\n3. Update ruleset to require review/code-owner approval and strict check freshness. Keep bypass actors empty or explicitly owner-controlled.\n4. Add a canary PR/harness mutation that removes a required check or makes it unconditional and demonstrate merge is blocked by independent policy.\n5. Document emergency bypass ownership and audit record.\n\n**Required tests / acceptance:** API readback confirms required approvals >=1, code-owner approval, strict status checks, no unapproved bypass actor. Seeded workflow change without approval cannot merge. A normal workflow change with independent approval and green required checks can merge. Exact SHA and ruleset JSON archived.\n\n**Migration / rollback:** Existing open PRs may require new approvals and reruns. Rollback is ruleset restoration only by repository owner; retain the last known ruleset export. Residual risk: repository administrators can alter rulesets outside source control.\n\n## WP-P10-02 — Durable task-level execution budgets\n\n**Priority:** P0 · **Complexity:** L · **Dependencies:** WP-P10-01 recommended first; can be implemented independently.\n\n**Gap/evidence:** `DEFAULT_CONTINUATION` sets total steps and minutes to Infinity (`cli/src/types.ts:182-188`); `runTurnImpl` checks a local `currentStep` (`run_turn.ts:137-145,220-267`); `runSubagent` uses an unbounded `for (;;)` (`agent.ts:4440-4457`); resumed invocation recreates local counters while cumulative steps are observational only (`turn.ts:348-359`).\n\n**Affected surfaces:** `types.ts`, `config.ts`, `run_turn.ts`, subagent execution in `agent.ts`, provider recovery, tool deadlines, durable objective/task state, operation runner and CLI/UI reporting.\n\n**Design / reuse:** Extend `ContinuationBudget` and existing durable objective/operation records with a task budget id, maximum total steps/tool invocations/inference submissions/elapsed time/tokens, per-tool deadline and delegation depth. Persist consumed counters before/after side effects with `withDurableSync`. Child agents inherit the parent’s remaining budget; provider retry consumes the same inference allowance. A resumed task cannot regain budget. Require explicit operator-authorized budget renewal after exhaustion.\n\n**Implementation steps:**\n\n1. Define additive schema fields with migration defaults that do not silently claim prior counters are zero; old tasks resume in a conservative bounded mode or require explicit operator choice.\n2. Add a shared budget tracker passed through direct turns, subagents, work units, provider recovery and tool dispatch.\n3. Enforce before dispatch and before any retry; classify exhaustion as `BLOCKED`/`LIMIT_REACHED`, never `VERIFIED` or successful operation completion.\n4. Add ceilings for response streaming and whole-turn wall time, including a finite total timeout for local inference streams; idle timeout remains separate.\n5. Report dimension, configured limit, consumed amount and resume behavior in CLI/TUI result.\n\n**Required tests / acceptance:** Model emits distinct writes indefinitely: run stops at exact step/tool/token/time budget with nonzero/non-success result. Nested subagent shares remaining budget. Repeated provider failures consume retry allowance. Exhaustion followed by process restart and resume does not reset counters. Resume near limit permits only remaining budget. A hung local tool and slow-drip stream stop by configured deadline. Budget persistence write failure prevents new side-effectful dispatch.\n\n**Migration / rollback:** New config defaults may shorten formerly unlimited runs; provide an explicit operator override with a hard documented maximum, not Infinity. Keep old records readable. Rollback must not turn persisted exhausted state into zero; older binaries should refuse unsupported budget schema versions. Residual risk: already-running external calls may finish after cancellation or have unknown outcomes.\n\n## WP-P10-03 — Acceptance evidence integrity and export\n\n**Priority:** P1 · **Complexity:** M · **Dependencies:** WP-P10-01 for independent policy identity.\n\n**Gap/evidence:** Flight events are append-only by convention, but append failures are ignored (`cli/src/flight.ts:77-108`); no chain/signature verification exists. `TurnResult` has `candidateId` and output SHA but not complete environment/policy identity (`cli/src/core/turn.ts:191-219`).\n\n**Affected surfaces:** `flight.ts`, `evidence.ts`, completion oracle, durable state and audit commands.\n\n**Design / reuse:** Add an evidence manifest to existing receipt/event structures. Chain each event over prior digest; include candidate tree/commit identity, verifier definition/config digest, command, tool/runtime versions, exit code, timestamp, actor/model/provider identity and policy version. Use an operator-supplied signing key only if explicitly configured; unsigned bundles must say “integrity checked, not signed.” Required acceptance evidence write failure must produce a visible non-success result; optional telemetry remains best effort and explicitly marked.\n\n**Implementation steps:**\n\n**Required tests / acceptance:** CI runs Clippy on exact PR merge head; seeded warning fails. TypeScript strict build is verified on Node 22 and 24. A changed critical function crossing an agreed CC/nesting threshold requires review or decomposition. Workflow is protected by WP-P10-01.\n\n**Migration / rollback:** If historical warnings appear on a new toolchain, baseline them narrowly with tracked expiry/owner; do not suppress globally. Rollback is removal of a specific analyzer job only with independent approval. Residual risk: static analysis cannot establish requirements correctness or provider behavior.\n\n## Dependency-aware order\n\n1. **WP-P10-01** governance/acceptance authority (P0).\n2. **WP-P10-02** aggregate budgets across direct, delegated, retry and resume paths (P0).\n3. **WP-P10-03** durable evidence and candidate/policy binding (P1; can start schema design in parallel after WP-P10-01).\n4. **WP-P10-04** aggregate resource admission and cleanup (P1; budget counters feed this work).\n5. **WP-P10-05** static-analysis/complexity gate (P2; protected by WP-P10-01).\n\nEach package lands independently with its own negative tests. CI green on a PR is not proof the implementation is correct; hosted checks must be tied to the exact candidate and accepted under the protected review policy.\n# PA-1 explicit execution resource admission\n\nStatus: **partial implementation verified on the PA-1 resource-admission slice**. CPU/memory admission and compatibility behavior are implemented; worktree owner receipts and broader host-resource governance remain open.\n\n## Contract\n\nDurable operations may opt into parallel execution with `policy.maxConcurrentUnits > 1`. Every such operation must declare an operation-local `policy.executionBudget` and every work unit must declare `executionResources`:\n\n```json\n{\n  \"policy\": {\n    \"maxConcurrentUnits\": 3,\n    \"executionBudget\": { \"cpuMilli\": 3000, \"memoryBytes\": 2147483648 }\n  },\n  \"units\": [\n    { \"id\": \"one\", \"prompt\": \"...\", \"executionResources\": { \"cpuMilli\": 1000, \"memoryBytes\": 536870912 } }\n  ]\n}\n```\n\n`cpuMilli` is an operator-provided reservation in thousandths of a core. `memoryBytes` is an operator-provided reservation in bytes. These values are admission declarations, not provider telemetry, observed usage, or enforced operating-system quotas. A unit is admitted only when its declared CPU and memory fit alongside currently running declarations, the unit-count limit, provider concurrency slots, capability qualification, dependencies, and workspace isolation.\n\nThe operation count limit, provider request slots, and declared CPU/memory reservations are separate constraints. The scheduler does not infer CPU or memory limits from provider names, model identity, hardware count, or absent metadata. Serial execution remains available without resource declarations.\n\n## Compatibility and failure behavior\n\nOperation schema v4 records explicit resource reservations. Older operation records migrate additively; if they requested parallel execution without reservations, their effective concurrency is clamped to one with a warning. New parallel operation specifications missing a budget or any unit reservation are rejected before state creation. A request larger than the operation budget is also rejected. Single-unit operations do not need reservations.\n\nThese reservations cannot protect the host from a subprocess that exceeds its declared demand. Hard CPU or memory limits require a separately implemented execution boundary and are not claimed here.\n\n## Verification record\n\nOn branch `v1/pa1-resource-admission`, 44 focused tests passed across operation concurrency, operation schema, isolated concurrency, and batch spec validation; 28 operation release/review regression tests also passed. `npm run build` passed in `cli/`. The tests cover separate CPU and memory budget exhaustion, provider slot limits, malformed/missing reservation rejection, migration of old records, legacy serial behavior, and prior operation/batch regression cases. The release acceptance tests use an ephemeral local mock provider; no live inference endpoint was used. These results qualify this slice only, not the full PA-1 roadmap item.\n","exit_code":0,"duration":{"secs":0,"nanos":38351}},"started_at_ms":1795297862183,"completed_at_ms":1795297862184}}
