62Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:1520c86db00597dd2a8ea76d\",\n      \"paths\": [\n        \"workflow.branching.rules\"\n      ],\n      \"kind\": \"convention\",\n      \"text\": \"After any pause or rate-limit interruption, re-read current claim files and ownership before merging, pushing, or editing; ownership may have been reassigned during the pause, even when the reviewed patch and green CI remain unchanged.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\",\n          \"transcript\": \"sessions/unknown/REDACTED.jsonl\",\n          \"line\": 578\n        },\n        {\n          \"session_id\": \"90831ce7-12dd-4e3f-a07d-bc2921efe403\",\n          \"checkpoint_id\": \"01M5ZZTDS74T864B7F1GCVGKCK\"\n        }\n      ],\n      \"created_at\": \"2026-10-28T07:43:47.162972762Z\",\n      \"updated_at\": \"2026-10-28T07:43:47.162972762Z\"\n    },\n    {\n      \"id\": \"fact:1b7cb482cdcdfcc59e6a84f6\",\n      \"paths\": [\n        \"architecture.boundaries.rationale\"\n      ],\n      \"kind\": \"invariant\",\n      \"text\": \"Nexus treats capability availability as distinct from authority; authorization should govern concrete operations and resources, with bounded authority, distrust by default, and fail-closed behavior when authority cannot be established.\",\n      \"branch\": \"main\",\n      \"origin\": \"distilled\",\n      \"author\": \"google-113003937408701635470\",\n      \"agent\": \"codex\",\n      \"effort\": \"low\",\n      \"status\": \"active\",\n      \"provenance\": [\n        {\n          \"session_id\": \"5e99063d-042c-4962-9221-1650fa0f4489\",\n          \"checkp