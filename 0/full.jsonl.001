ress.changeBaseline.tddRedTests) } : {}),\n                at: progress.changeBaseline.at,\n              }\n            : null,\n        } : {}),\n      });\n      this.progressSaveFailing = false;\n    } catch (err: any) {\n      saved = false;\n      // Tolerated (the turn-end checkpoint writes the same state), but not silent: a crash before then would lose the\n      // work since the last save. Said once until a save succeeds again.\n      if (!this.progressSaveFailing) {\n        this.progressSaveFailing = true;\n        const text = `Progress could not be saved mid-turn (${redactSecrets(String(err?.message ?? err)).slice(0, 200)}); if the process stops before the turn ends, work since the last save is lost.`;\n        this.turnPersistenceFailures.push(text);\n        if (this.observer?.onNotice) this.observer.onNotice(text);\n        else console.warn(pc.yellow(text));\n      }\n    }\n    try {\n      this.progressListener?.();\n    ...DEFAULT_CONTINUATION,\n    maxTotalSteps: Number.isFinite(steps) ? Math.floor(steps) : steps,\n    maxTurnMinutes: positive(options.maxTurnMinutes, effectiveSetting(\"NEXUS_MAX_TURN_MINUTES\"), DEFAULT_CONTINUATION.maxTurnMinutes, MAX_CONTINUATION_MINUTES),\n    stagnationSteps: Math.floor(positive(options.stagnationSteps, effectiveSetting(\"NEXUS_STAGNATION_STEPS\"), DEFAULT_CONTINUATION.stagnationSteps)),\n    verifierConvergenceAttempts: Math.floor(positive(undefined, effectiveSetting(\"NEXUS_VERIFIER_CONVERGENCE_ATTEMPTS\"), DEFAULT_CONVERGENCE_ATTEMPTS)),\n  };\n}\n\n/** Repeated-call thresholds: the operator's values, which a project `.env` may only lower. */\nexport function repeatedCallSettings() {\n  return resolveRepeatedCallSettings(\n    { soft: operatorSetting(\"NEXUS_REPEATED_CALL_SOFT\"), hard: operatorSetting(\"NEXUS_REPEATED_CALL_HARD\") },\n    { soft: projectSetting(\"NEXUS_REPEATED_CALL_SOFT\"), hard: projectSetting(\"NEXUS_REPEATED_CALL_HARD\") },\n  );\n}\n\n/** Replaces the \"local-model\" placeholder with the first model the gateway lists; unchanged if the gateway is unreachable or the start is a resume. */\nexport async function autoDetectModel(config: HarnessConfig, options: { resuming?: boolean } = {}): Promise<HarnessConfig> {\n  // A provider's catalog lists billable models; one is never chosen on the operator's behalf.\n  if (config.provider || config.model !== \"local-model\") return config;\n  // A resumed start sends nothing before the agent knows whether the provider asked it to wait: the session record\n  // supplies the model (AutonomousAgent.adoptRecordedModel), else the first step detects it after the wait.\n  if (options.resuming) return config;\n  try {\n    const models = await new LocalLlmClient(config).listModels();\n    if (models.length > 0) return { ...config, model: models[0] };\n  .name(\"nexus\")\n  .description(\"Nexus Code - Custom Autonomous Coding Harness for Local AI (LM Studio / vLLM)\")\n  .version(getBuildIdentity().string)\n  .option(\"--repl\", \"Start interactive coding session (REPL)\")\n  .option(\"--live\", \"Start live TUI\")\n  .option(\"-r, --resume [id]\", \"Resume previous session (defaults to latest if id omitted)\")\n  .option(\"--fork-session <id>\", \"Start in a new copy of the named session (the original is never changed; prints the new id)\")\n  .option(\"--fork-at <n>\", \"With --fork-session: copy only the first n messages (default: all)\")\n  .option(\"--approve\", \"Require human approval before destructive actions (edits, shell commands)\")\n  .option(\"-y, --yes\", \"Run non-interactively without approval prompts (forces auto mode)\")\n  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\n  .option(\"--read-only\", \"Reject all mutating tool executions and commands\")\n  .option(\"-e, --endpoint <url>\", \"Local LLM endpoint (default: $LOCAL_LLM_ENDPOINT)\")\n  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in vLLM)\")\n  .option(\"-w, --workspace <path>\", \"Workspace directory (default: current directory)\")\n  .option(\"-s, --max-steps <number>\", \"Steps per segment; continuation checkpoints there instead of stopping (default: 30)\")\n  .option(\"--max-total-steps <number>\", \"Continuation: objective-wide step limit shared across resumes (default: 500)\")\n  .option(\"--strict-token-count\", \"Refuse a request the connection could not count on a worker (default: proceed on the labelled estimate)\")\n  .option(\"--max-turn-minutes <number>\", \"Continuation: active invocation wall-clock limit in minutes (default: 480)\")\n  .option(\"--stagnation-steps <number>\", \"Continuation: stop after this many steps without progress (default 12)\")\n  .option(\"--no-continuation\", \"End a turn at --max-steps instead of continuing while it makes progress\")\n  .option(\"-t, --temperature <number>\", \"Model temperature (default: 0.2)\")\n  .option(\"--shell <type>\", \"Linux shell to use: bash, zsh, or sh (default: bash)\", \"bash\")\n  .option(\"--fallback <urls>\", \"Comma-separated fallback LLM endpoints if primary is unavailable\")\n  .option(\"--context-limit <tokens>\", \"Context window limit in tokens; below the provider's advertised capacity it is kept, above it the advertised capacity applies (default: advertised capacity, else 65536)\")\n  .option(\"--dry-run\", \"Simulate file modifications without writing changes to disk\")\n  .option(\"--sandbox [mode]\", \"Isolate command execution using bubblewrap (bwrap) or Docker (default: auto)\")\n  .option(\"--sandbox-network\", \"With --sandbox: let sandboxed commands and the sandboxed native worker use the network (off by default; also NEXUS_SANDBOX_NETWORK=1 in the operator environment)\")\n  .option(\"--worktree\", \"Isolate execution inside an ephemeral git worktree under .nexus/worktrees/<task-id>\")\n  .option(\"--worktree-branch <name>\", \"Run inside the named git worktree for this branch (created if missing); kept after the run, merge it with `nexus worktree merge`\")\n  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\nimport * as path from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport { ChatMessage, ToolCall } from \"../types.js\";\nimport { ExecutionSpine, ExecutionReceipt } from \"./spine.js\";\nimport { ExecutionTracker, REPEAT_THRESHOLD, actionKind, backoffMs, type ObservationVerdict } from \"./execution_tracking.js\";\nimport { fileSignature, readCoverage, readRequests } from \"./observation_identity.js\";\nimport { redactSecrets, safeTerminal } from \"../ui.js\";\nimport { getGitInfo } from \"../git.js\";\nimport { extractCompilerDiagnostics, formatDiagnosticHints } from \"../diagnostics.js\";\nimport { calculateContextBudget, countTokens } from \"../tokens.js\";\nimport { discoverVerifier } from \"../tester.js\";\nimport { groupsTriggeredBy } from \"./tool_groups.js\";\nimport { snapshotTests } from \"./independent_check.js\";\nimport { InferenceError } from \"../client.js\";\nimport { TurnResult, InterruptionRecord, InferenceFailure, CapacityRecord, ModelStop, ProviderRecoveryRecord, assertTurnResultInvariants, deepFreezeTurn, summarizeTurn } from \"./turn.js\";\nimport { withDurableSync } from \"./durable_file.js\";\nimport { ProviderRecoveryController, RecoveryCancelled, recoveryPolicyFromEnv } from \"./provider_recovery.js\";\nimport { amendObjective, blockedRequirements, carryUnresolvedConflicts, createLedger, gatingRequirements, isNewObjective, openRequirements, supersededBy, trackingOf } from \"./objective.js\";\nimport { snapshot } from \"../file_diff.js\";\nimport { buildBlockedRequirementQuestion, buildSteeringConflictQuestion } from \"./needs_input.js\";\nimport { safeOperatorText } from \"../protocol.js\";\nimport { TurnEvidence, TurnReason } from \"./turn.js\";\nimport { DEFAULT_REPEATED_CALL_HARD, DEFAULT_REPEATED_CALL_SOFT, judgeRepeatedCalls, makeCallRecord, pushCall, repeatedCallHistory, type CallClass, type CallRecord } from \"./repeated_calls.js\";\nimport pc from \"picocolors\";\nimport { ConfirmHandler, CompactionCommitError, ContextBudgetError, LedgerNotRetainedError, observationKey, recoveryDenialMessage, notExecutedMessage, observationPresence, unreacquiredRemovals, STEP_NOTICE, CUT_NOTICE, truncatedReplyNotice, harnessNoteMessage, READ_ONLY_TOOLS, foldVoluminousOutput, stepPosition, triggerNotification } from \"./agent_support.js\";\nimport type { AutonomousAgent } from \"../agent.js\";\n\nexport async function runTurnImpl(this: any, taskPrompt: string | any[], onConfirm?: ConfirmHandler, options?: { signal?: AbortSignal; resume?: boolean; tddRed?: boolean; step?: boolean }): Promise<TurnResult> {\n  // The REPL calls runTurn directly. Route worktree-enabled turns through the\n  // same establishment and resolution boundary as one-shot `run` tasks. A retained\n  // named worktree is where the session keeps working; `run` reuses it.\n  if (this.config.worktree && this.activeWorktree && this.activeWorktree.kind !== \"named\" && !this.worktreeRunTurnAuthorized) {\n    throw new Error(`Cannot start a new task: unresolved worktree ${this.activeWorktree.taskId}; merge or discard it first.`);\n  }\n  if (this.config.worktree && !this.worktreeRunTurnAuthorized) {\n    return await this.run(taskPrompt, onConfirm, options);\n  }\n  if (!this.config.worktree) this.assertNamedBindingCurrent();\n  if (this.activeTurn) throw new Error(\"A turn is already active; wait for it to finish or cancel it.\");\n  const authoritativeVerifier = this.config.authoritativeVerifierCommand?.trim();\n  if (authoritativeVerifier && this.changeBaseline === undefined) {\n    // Capture workspace-resolved operator verifier files before plugins or the model can change them.\n    // Existing pending work without an earlier snapshot remains unverified rather than being blessed retroactively.\n    // A linked worktree the agent already worked in (an earlier session, another terminal) gives a baseline taken from\n    // files the agent may have rewritten: verification proceeds as usual, but no receipt is issued on that baseline.\n    this.judgeReceiptBaselineOnce();\n    this.changeBaseline = {\n      command: authoritativeVerifier,\n      failed: false,\n      tests: this.hasPendingModifications ? null : snapshotTests(this.config.workspace),\n      ...(this.hasPendingModifications ? { verifier: null } : this.verifierDefinitionAtCapture(authoritativeVerifier, this.config.trustedDeliverableFiles ?? [])),\n      trustedDeliverables: [...(this.config.trustedDeliverableFiles ?? [])],\n      at: new Date().toISOString(),\n    };\n    if (this.durable) {\n      try {\n        this.checkpointDurableState(\"authoritative verifier definition captured\");\n      } catch (err: any) {\n        this.reportPersistenceFailure(\"baseline\", err);\n      }\n    }\n  }\n  await this.initExtensibility();\n  const promptText = typeof taskPrompt === \"string\" ? taskPrompt : \"[Multi-modal Vision Input]\";\n  for (const group of groupsTriggeredBy(promptText)) this.enabledToolGroups.add(group);\n  await this.pluginManager.notifyTurnStart(promptText, this.config.workspace);\n\n  const turn: NonNullable<AutonomousAgent[\"activeTurn\"]> = {\n    controller: new AbortController(),\n    phase: \"idle\",\n    step: 0,\n    onConfirm,\n    tddRed: options?.tddRed === true,\n  };\n  this.activeTurn = turn;\n  const signal = turn.controller.signal;\n  this.bridge.setTurnSignal(signal);\n  if (options?.signal) {\n    if (options.signal.aborted) this.requestCancel(\"external signal\");\n    else options.signal.addEventListener(\"abort\", () => this.requestCancel(\"external signal\"), { once: true });\n  }\n  this.completionSummary = undefined;\n  this.turnPersistenceFailures = this.initialStatePersistenceFailure ? [this.initialStatePersistenceFailure] : [];\n  this.objectiveBudgetPersistenceFailure = undefined;\n  this.turnMutations = 0;\n  this.turnToolCallSyntax = { native: 0, trailing: 0, structural: 0, invalid: 0, schema: 0 };\n  this.turnConfiguredVerifier = \"NOT_RUN\";\n  this.turnConvergence = undefined;\n  this.turnConvergenceUpTo = undefined;\n  this.turnRepeatedCall = undefined;\n  this.pendingNeedsInput = undefined;\n  this.furtherNeedsInput = [];\n  this.turnCarriedChanges = this.hasPendingModifications;\n  this.turnDenials = 0;\n  this.turnFileWrites = 0;\n  this.turnBackgroundCommands = 0;\n  this.turnLatchLifted = false;\n  this.turnVerifierRuns = [];\n  this.turnStartState = undefined;\n  // What compaction removed earlier in this conversation is still not in context, whichever way the turn began.\n  this.turnRemovedObservations = new Set([...this.carriedRemovedObservations, ...unreacquiredRemovals(this.messages)]);\n  this.findingsOutgrown = false;\n  this.stepNoticeStep = 0;\n  this.cutResponse = undefined;\n  // Step notices speak for the turn that issued them; this turn has its own step budget.\n  for (const message of this.messages) {\n    if (message.role === \"tool\" && typeof message.content === \"string\") message.content = message.content.replace(CUT_NOTICE, \"\").replace(STEP_NOTICE, \"\");\n  }\n  this.carriedRemovedObservations = new Set();\n  // The objective this turn works toward: a new one, or a short follow-up on the one still unresolved.\n28:export async function runTurnImpl(this: any, taskPrompt: string | any[], onConfirm?: ConfirmHandler, options?: { signal?: AbortSignal; resume?: boolean; tddRed?: boolean; step?: boolean }): Promise<TurnResult> {\n266:        stopReason = \"VERIFIER_NOT_CONVERGING\";\n275:        stopReason = budget ? \"STEP_BUDGET_EXHAUSTED\" : \"STEP_LIMIT_REACHED\";\n282:        stopReason = \"TIME_BUDGET_EXHAUSTED\";\n287:        stopReason = \"STAGNATION_DETECTED\";\n303:        stopReason = \"STEP_PAUSED\";\n341:        stopReason = \"PERSISTENCE_FAILED\";\n458:          stopReason = \"STAGNATION_DETECTED\";\n491:          stopReason = \"STAGNATION_DETECTED\";\n515:          stopReason = \"TOOL_CALL_LOOP\";\n521:          stopReason = \"NEEDS_INPUT\";\n877:            const { receipt } = await this.dispatchToolCall(call, currentStep, \"agent\");\n940:          stopReason = \"NEEDS_INPUT\";\n959:        const { receipt, shouldExit } = await this.dispatchToolCall(\n991:          stopReason = \"PERSISTENCE_FAILED\";\n1048:      stepsUsed: stopReason === \"STEP_BUDGET_EXHAUSTED\" ? tracker.data.cumulativeSteps : (stepsUsed || Math.min(currentStep, maxTotalSteps)),\n1070:      this.objective.continuation.stopReason = stopReason ?? (persistenceFailure ? \"PERSISTENCE_FAILED\" : undefined);\n1139:      this.objective.continuation.stopReason = \"UNHANDLED_ERROR\";\n1282:  if (input.limitReached && input.stopReason === \"VERIFIER_NOT_CONVERGING\" && this.turnConvergence) {\n1288:  if (input.limitReached && input.stopReason === \"NEEDS_INPUT\" && this.pendingNeedsInput) {\n1295:  if (input.limitReached && input.stopReason === \"TOOL_CALL_LOOP\" && this.turnRepeatedCall) {\n1302:    const stepPaused = input.stopReason === \"STEP_PAUSED\";\n","exit_code":0,"duration":{"secs":0,"nanos":679829506}},"started_at_ms":1795300947041,"completed_at_ms":1795300947721}}
