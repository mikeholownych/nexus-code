f-a07d-bc2921efe403, agent_id=aee07e8fc8440b3df, stopped_at=2026-10-31T12:54:02.488Z, stopped_at_epoch=1793451242488, stop_source=subagent-stop-hook), updated about 3 days ago\n  - [done] Agent afcf57fc85247cefe in claude session 575fdc5c-0980-467b-a238-8f673c2cf4b3 (platform_source=claude, content_session_id=575fdc5c-0980-467b-a238-8f673c2cf4b3, agent_id=afcf57fc85247cefe, stopped_at=2026-11-01T16:49:37.756Z, stopped_at_epoch=1793551777756, stop_source=subagent-stop-hook), updated about 2 days ago\n  - [done] Agent a541ff8979938f616 in claude session 575fdc5c-0980-467b-a238-8f673c2cf4b3 (platform_source=claude, content_session_id=575fdc5c-0980-467b-a238-8f673c2cf4b3, agent_id=a541ff8979938f616, stopped_at=2026-11-01T16:55:43.887Z, stopped_at_epoch=1793552143887, stop_source=subagent-stop-hook), updated about 2 days ago\n  - [done] Agent a23e8e98bfc630d31 in claude session 575fdc5c-0980-467b-a238-8f673c2cf4b3 (platform_source=claude, content_session_id=575fdc5c-0980-467b-a238-8f673c2cf4b3, agent_id=a23e8e98bfc630d31, stopped_at=2026-11-01T16:56:14.136Z, stopped_at_epoch=1793552174136, stop_source=subagent-stop-hook), updated about 2 days ago\n  - [done] Agent a8f1ebcf5057acb66 in claude session 575fdc5c-0980-467b-a238-8f673c2cf4b3 (platform_source=claude, content_session_id=575fdc5c-0980-467b-a238-8f673c2cf4b3, agent_id=a8f1ebcf5057acb66, stopped_at=2026-11-01T17:04:06.182Z, stopped_at_epoch=1793552646182, stop_source=subagent-stop-hook), updated about 2 days ago\n  - [done] Agent a38feccc4d210d731 in claude session 575fdc5c-0980-467b-a238-8f673c2cf4b3 (platform_source=claude, content_session_id=575fdc5c-0980-467b-a238-8f673c2cf4b3, agent_id=a38feccc4d210d731, stopped_at=2026-11-01T17:17:17.499Z, stopped_at_epoch=1793553437499, stop_source=subagent-stop-hook), updated about 2 days ago\n  - [done] Agent a7c949be03755aab6 in claude session 575fdc5c-0980-467b-a238-8f673c2cf4b3 (platform_source=claude, content_session_id=575fdc5c-0980-467b-a238-8f673c2cf4b3, agent_id=a7c949be03755aab6, stopped_at=2026-11-01T17:27:31.233Z, stopped_at_epoch=1793554051233, stop_source=subagent-stop-hook), updated about 2 days ago\n  - [done] Agent a57059888eaedcd41 in claude session 575fdc5c-0980-467b-a238-8f673c2cf4b3 (platform_source=claude, content_session_id=575fdc5c-0980-467b-a238-8f673c2cf4b3, agent_id=a57059888eaedcd41, stopped_at=2026-11-01T17:29:25.854Z, stopped_at_epoch=1793554165854, stop_source=subagent-stop-hook), updated about 2 days ago\n  - [done] Agent aa4b5c8fd14c2e7a4 in claude session 575fdc5c-0980-467b-a238-8f673c2cf4b3 (platform_source=claude, content_session_id=575fdc5c-0980-467b-a238-8f673c2cf4b3, agent_id=aa4b5c8fd14c2e7a4, stopped_at=2026-11-01T17:30:26.384Z, stopped_at_epoch=1793554226384, stop_source=subagent-stop-hook), updated about 2 days ago\n  - [done] Agent ae6c8f9681b3a0c56 in claude session 575fdc5c-0980-467b-a238-8f673c2cf4b3 (platform_source=claude, content_session_id=575fdc5c-0980-467b-a238-8f673c2cf4b3, agent_id=ae6c8f9681b3a0c56, stopped_at=2026-11-01T17:35:27.429Z, stopped_at_epoch=1793554527429, stop_source=subagent-stop-hook), updated about 2 days ago\n  - [done] Agent ad1e37424bc4193b3 in claude session 575fdc5c-0980-467b-a238-8f673c2cf4b3 (platform_source\n[Response shortened; request fewer selected records for more detail.]"}]},"duration":{"secs":0,"nanos":394915526}},"started_at_ms":1793736429304,"completed_at_ms":1793736429701}}
{"timestamp":"2026-11-03T20:07:11.538Z","ordinal":80403,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"CommandExecution","id":"exec-00af40b3-6a9f-4244-bf3e-a1934a322ebe","process_id":"75346","command":["/usr/bin/zsh","-lc","git status --short && git rev-parse HEAD && sed -n '1,260p' docs/v1.1.0/WP-1107-PLAN.md && sed -n '1,180p' docs/v1.1.0/ROADMAP.md"],"cwd":"file:///home/mike/nexus-wt/v112-wp1101-integration","parsed_cmd":[{"type":"unknown","cmd":"git status --short && git rev-parse HEAD && sed -n '1,260p' docs/v1.1.0/WP-1107-PLAN.md && sed -n '1,180p' docs/v1.1.0/ROADMAP.md"}],"source":"unified_exec_startup","status":"completed","aggregated_output":" M docs/releases/v1.1.2-qualification.md\n?? docs/v1.1.0/WP-1107-PLAN.md\n3eea888abbf20b4b63c75c2b554debd67038f5a1\n# WP-1107 — Provider-Constrained Tool Grammar\n\n## Specification\n\n**User story:** As a Nexus user running a supported local inference engine, I need registered tool arguments constrained by that engine so tool calls arrive as valid JSON and require fewer syntax repairs.\n\n**Acceptance criteria:**\n\n- **AC1:** An identified llama.cpp chat endpoint receives the grammar generated from the active allowlisted tool schemas. Test: `client sends llama.cpp GBNF for supported tool calls`.\n- **AC2:** An identified vLLM endpoint receives the provider's supported JSON-schema-constrained tool-call request shape. Test: `client sends vLLM structured tool schema for supported tool calls`.\n- **AC3:** An identified Ollama endpoint receives its supported schema-constrained tool-call request shape. Test: `client sends Ollama JSON schema format for supported tool calls`.\n- **AC4:** Unknown, unsupported, or ambiguously identified endpoints retain their current request shape; no grammar field is sent based only on a configured lane label or generic OpenAI-compatible catalog fields. Tests: `client omits constrained fields for unknown and unsupported providers`; `generic context catalog remains unknown and receives no grammar field`; `provider identity accepts llama.cpp only with its marker and valid props handshake`; `provider identity accepts vLLM only with its documented version response`; `provider identity accepts Ollama only with version and selected-model show response`; `client omits constrained fields for missing malformed or mismatched provider identity`.\n- **AC5:** On each supported endpoint, the exact installed candidate completes 200 attempts: 50 for each of four fixed allowlisted tool schemas. Each attempt requests exactly one tool call. `native_valid` means the raw provider argument string parses with `JSON.parse` before any normalization or repair; `repaired` means raw parsing fails and the existing tool-call repair path produces parseable JSON; `invalid` includes every other outcome, including provider errors, timeouts, missing calls, and unparseable arguments. An endpoint passes only when `native_valid * 1000 >= attempts * 995` and `invalid == 0`; report exact integer counts and do not round percentages for the decision. Tests/evidence: `tool grammar matrix evidence schema rejects invalid counts and identity omissions`; `tool grammar matrix computes endpoint pass without percentage rounding`; `tool grammar matrix runner records archive and per-endpoint identity`; live `WP-1107 supported-endpoint syntax matrix`.\n\n**Out of scope:** Changing tool schemas or the allowlist; applying constraints to non-tool completions; measuring task-solving quality; enabling constraints on an endpoint that does not positively identify itself.\n\n**Dependencies:** Existing schema-derived grammar generator and `toolCallSyntax` telemetry; source implementation is otherwise independent. AC5 depends on an approved shared inference window and the exact candidate package.\n\n**Scope reconciliation:** The user selected the full failed v1.1.0 WP-1101–WP-1108 roadmap for v1.1.2. This explicit scope supersedes the older deferral in `ROADMAP-REVIEW.md` §2.5. It does not waive the required provider references, test gates, review, or G1.1-4 endpoint evidence.\n\n## Implementation plan\n\n**Chunk 1 — Provider request adapter**\n\n- Add a typed adapter mapping provider kinds to documented request constraint fields only after a provider-specific positive identity check. A configured lane label or `context_length`/`max_model_len` alone is insufficient.\n- Derive constraints from the current allowlisted tool schemas; preserve the existing request when provider kind is unknown or the endpoint/protocol does not support the field.\n- Files: `cli/src/core/tool_grammar_provider.ts` (new), `cli/src/core/provider_capabilities.ts`, `cli/test/client_tool_grammar.test.ts` (new), `cli/test/provider_capabilities.test.ts`.\n- Tests: AC1–AC4 request-shape and identity tests above, including positive provider-handshake fixtures and generic/missing/malformed/mismatched negative cases.\n- Identity contract: llama.cpp requires the exact `/v1/models` `owned_by: \"llamacpp\"` marker or its `meta.n_ctx_train` marker plus a successful `/props` response matching the existing llama.cpp schema; Ollama requires its `/api/version` response with a non-empty `version` string and a successful `/api/show` response for the selected model; vLLM requires a successful `GET /version` returning the provider's documented JSON version response and the selected model in `/v1/models`. A generic catalog containing only `context_length` or `max_model_len` remains `unknown` for grammar attachment, even if the matrix lane is configured as vLLM. These are provider self-identification handshakes on the operator-configured endpoint, not cryptographic server authentication; any mismatch, missing probe, or malformed response disables constrained fields.\n- References to retrieve: official llama.cpp, vLLM, and Ollama server request implementations/docs.\n\n**Chunk 2 — Client integration**\n\n- Attach the adapter output to non-streaming, streaming, and supported native client request bodies without changing message, tool, credential, or egress handling.\n- Files: `cli/src/client.ts`, `cli/test/client_tool_grammar.test.ts`.\n- Tests: captured request-body tests for each applicable transport path, plus AC4 fallback.\n- Reference to retrieve: `LocalLlmClient` request construction and provider identification on the exact candidate.\n\n**Chunk 3 — Candidate endpoint matrix**\n\n- Add a deterministic runner and schema validator. Fake-provider/serialization tests validate request construction and evidence validation only; they do not count as live endpoint measurements.\n- Files: `eval/tool_grammar_matrix.mjs` (new), `eval/tool_grammar_matrix.test.mjs` (new), `docs/evidence/v1.1.2/wp-1107-provider-matrix.json` (new), `docs/evidence/v1.1.2/wp-1107-provider-matrix.json.sha256` (new detached digest), `docs/releases/v1.1.2-qualification.md`.\n- Tests: `tool grammar matrix evidence schema rejects invalid counts and identity omissions`; `tool grammar matrix computes endpoint pass without percentage rounding`; `tool grammar matrix runner records archive and per-endpoint identity`.\n- Matrix: run the exact installed archive against one allowlisted llama.cpp, vLLM, and Ollama endpoint. Before the run, the matrix must pin each server to an immutable image/version and record model name plus immutable model digest, context size, sampling settings, tool choice, prompt fixture digest, server flags, and relevant compatibility mode. Record provider identification from the detected `serverKind` returned by the client; the lane is valid only when that value exactly matches the configured provider (`llamacpp`, `vllm`, or `ollama`). Unknown/mismatched identities fail before attempts and receive no constraint fields.\n- Evidence fields: archive SHA-256 and source commit; provider/server kind; server version and immutable image digest; model name and immutable model digest; non-secret configuration and stimulus digest; total attempts and per-tool attempts; native-valid/repaired/invalid counts per endpoint; exact pass equation result; evidence schema version. Store the finalized evidence file’s SHA-256 in the detached `.sha256` sidecar and qualification record (the JSON cannot hash itself). Omit endpoint URLs, credentials, and other secrets.\n- Test/evidence: AC5 threshold and zero-invalid requirement for every provider. This measures argument JSON only; it does not certify tool selection or task correctness.\n- Dependency: explicit release of the shared `GATEWAY` claim before any inference.\n\n## Risks and reference queries\n\n- Provider request contracts may have changed since the roadmap draft. Retrieve current primary references before implementation:\n  - `llama.cpp` (`https://github.com/ggml-org/llama.cpp`) — chat-completion grammar request field and interaction with function tools.\n  - `vLLM` (`https://github.com/vllm-project/vllm`) — current structured-output request field and function-tool compatibility.\n  - `Ollama` (`https://github.com/ollama/ollama`) — current chat `format` schema and function-tool compatibility.\n  - `nexus-cli` XERJ prefix — exact candidate request construction and provider identification.\n- A provider field that constrains the whole response may conflict with native function calling; retain only combinations shown to be supported by the primary references and captured-request tests.\n- G1.1-4 requires a real endpoint matrix. A loopback mock proves serialization only and cannot satisfy the 99.5% metric.\n- The provider lane’s immutable server and model identities are not yet confirmed because the shared `GATEWAY` claim is still held by the RC15 stream. Treat them as a pre-run gate: record and peer-review the three exact identities/configurations in the matrix plan before starting any provider call; do not substitute mutable tags or infer identity from an endpoint URL.\n# Nexus Code Post-v1.0.0 Roadmap: v1.1.0 – v1.3.0\n\n**Status:** Draft / Active Planning\n**Baseline:** Nexus Code `v1.0.0` (Release Candidate Baseline)\n**Parent Strategy:** Evaluation-Driven Development, Local-First Observability & Operator Sovereignty\n\n---\n\n## 1. Release Schedule Overview\n\n```\n2026-Q4                             2027-Q1                             2027-Q2\n───┬───────────────────────────────────┬───────────────────────────────────┬───►\n   │                                   │                                   │\n   ▼                                   ▼                                   ▼\nv1.0.0 (Baseline Freeze)            v1.1.0                              v1.2.0\n- Linux x86-64 Hardened             - OTel Local Tracing                - Session Replay Engine\n- Security Boundaries & Sandbox     - Versioned Eval Datasets           - Experiment Comparator\n- Ratatui TUI & Token Accounting    - Flight Recorder Redaction         - TUI Trace Inspector\n- Deterministic Packages & Provenance - Standalone `nexus eval` CLI      - Human Annotation Queue\n                                    - Deterministic Code Evaluators     - Failure Clustering\n                                    - GBNF Tool Grammar Engine          - Composio Dev Bridge (WP-1207)\n                                    - Dependabot Modernization (WP-1108)│\n                                                                        ▼\n                                                                        v1.3.0\n                                                                        - Standard OTLP Exporter\n                                                                        - Full Context Provenance (CTX-1)\n                                                                        - macOS / arm64 Builds\n                                                                        - Knowledge Freshness (CTX-2)\n                                                                        - Composio 250+ App Mesh (WP-1306)\n```\n\n---\n\n## 2. Milestone v1.1.0: Observability Foundations & Eval Harness\n\n**Target:** Initial feature release post-v1.0.0\n**Theme:** Establish the local trace standard, sanitize flight recordings, and migrate evaluation from ad-hoc scripts to versioned datasets with reference oracles.\n\n### Work Packages\n\n| ID | Title | Summary & Deliverables | Backlog / Audit Source |\n| :--- | :--- | :--- | :--- |\n| **WP-1101** | **OpenTelemetry Local Tracing** | Implement `cli/src/core/trace.ts` providing hierarchical tracing conforming to OpenTelemetry GenAI semantics. Captures agent turn roots, model request spans, tool execution spans, and context compactions into local `trace.jsonl` files. | `LANGSMITH_REVIEW` §2.1 |\n| **WP-1102** | **Flight Recorder Credential Redaction** | Implement automated zero-leak credential sanitization across all recorded spans, CLI error dumps, and debug journals, validating against the test fixtures in `docs/CRED003_FLIGHTRECORDER_SANITIZATION_EVIDENCE.md`. | `REQ-DX-105`, `CRED003` |\n| **WP-1103** | **Versioned Evaluation Datasets** | Migrate `eval/tasks/` into structured datasets under `eval/datasets/`. Decouple task input specifications (`examples.jsonl`) from evaluation assertions (`oracles.jsonl`). Add versioning and dataset splits (`regression`, `benchmark`). | `LANGSMITH_REVIEW` §2.3 |\n| **WP-1104** | **Standalone `nexus eval` Command** | Implement `nexus eval` subcommand in launcher grammar, supporting `--dataset <path>`, `--runs <count>`, `--isolated-home`, and structured JSON score outputs. | `REQ-EVL-101`, `ROADMAP.md` |\n| **WP-1105** | **Deterministic Code Evaluators** | Implement modular evaluator library in `eval/evaluators/code/`: AST syntax validation, build pass/fail, typecheck exit codes, diff boundary compliance, and JSON repair rates. | `LANGSMITH_REVIEW` §4.1 |\n| **WP-1106** | **Single Step Loop Mode** | Implement `--step` flag in `nexus run` and `/step` REPL command to execute one agent turn and pause deterministically for operator confirmation. | `REQ-AGT-111` |\n| **WP-1107** | **Constrained Decoding & GBNF Tool Grammar Engine** | Implement dynamic Context-Free Grammar (GBNF) generation from registered tool schemas (`read_file`, `write_file`, `edit_file`, `run_command`). Interfaces with `llama.cpp` (`grammar`), `vLLM` (`guided_json`), and `Ollama` (`format`). Supports hybrid grammars (`<think>...</think>` + tool call) for reasoning models (DeepSeek R1). Targets near-zero JSON argument parse errors and enables reliable agentic execution on 7B/14B Q4_K_M local models. | `POSITIONING.md` §3.6, `SPEC-EVALUATION.md` §6 |\n| **WP-1108** | **Zero Technical Debt & Dependency Modernization** | Triage, validate, and integrate the 27 post-v1.0.0 Dependabot PRs (#103–#129) under an absolute zero-deprecation policy for third-party libraries. Categorized across 5 staged batches: Core Rust runtime (#105, #107, #110, #113), GitHub Actions CI workflows (#103, #104, #106, #108, #112), Cloudflare micro-workers (#109, #115–#118, #121–#123, #125–#128), TypeScript compiler (#119, #124, #129), and CLI runtime migrations (#111, #114, #120 including Commander 12→15 compatibility audit). Enforces continuous zero-technical-debt invariants. | PRs #103–#129, `ROADMAP.md` §2.1 |\n\n### v1.1.0 Release Gates\n\n- **Gate G1.1-1 (Zero-Leak Tracing):** Local trace engine produces valid OTel GenAI spans for all turn steps without leaking environment credentials or writing outside `~/.local/share/nexus/traces/`.\n- **Gate G1.1-2 (Dataset Decoupling):** Evaluator executes 100% of benchmark tasks with zero leakage of `oracles.jsonl` to agent prompt context.\n- **Gate G1.1-3 (CLI Parity):** `nexus eval` executes cleanly from packaged binary installations without developer dependencies.\n- **Gate G1.1-4 (Constrained Decoding Reliability):** GBNF-constrained execution achieves >=99.5% valid JSON tool call syntax (minimizing syntax repair retries) across supported local inference endpoints (llama.cpp, vLLM, Ollama).\n- **Gate G1.1-5 (Zero Technical Debt & Zero Deprecated Packages):** Strictly 0 deprecated packages, 0 unmaintained dependencies, 0 CodeQL alerts, and 0 compiler warnings repository-wide. All 27 Dependabot PR upgrades pass unit/PTY suites, `cargo deny check`, automated npm registry deprecation scans, package reproducibility (`cmp`), and CLI option compatibility without breaking unprivileged sandbox invariants.\n\n### 2.1 Dependabot Triage & Integration Matrix (WP-1108)\n\nFollowing the PR #8 integration merge to `main`, Dependabot opened 27 automated dependency update pull requests (PRs #103–#129). These are triaged into 5 distinct integration batches scheduled for the v1.1.0 development cycle (deferred from v1.0.0):\n\n#### Batch 1: Core Rust Engine Runtime (Low Risk / Initial v1.1.0 Release Cycle)\nPatches to Rust core dependencies that preserve API compatibility and improve stability and performance:\n- **PR #105:** `tokio` (1.53.1 → 1.53.3 in `/core`) — Async runtime maintenance patch.\n- **PR #107:** `similar` (2.7.0 → 3.2.0 in `/core`) — Text diffing library major SemVer upgrade.\n- **PR #110:** `libc` (0.2.189 → 0.2.191 in `/core`) — System call bindings patch.\n- **PR #113:** `serde_json` (1.0.151 → 1.0.154 in `/core`) — Serialization optimization patch.\n- *Verification Requirement:* `cargo test --locked --manifest-path core/Cargo.toml` under isolated HOME; bit-for-bit packaging `cmp` check.\n\n#### Batch 2: Cloudflare Experimental Micro-Workers (Low Risk / Isolated)\nMaintenance updates for the isolated Cloudflare artifacts vertical slice (retired contest contract track):\n- **PRs #125, #126, #127, #128:** `vite` (8.3.3 → 8.3.4 across root and worker packages).\n- **PRs #115, #117, #118:** `@cloudflare/vite-plugin` (2.0.0-beta.sha-52b0dc0e9 → 2.0.0-beta.v.1).\n- **PRs #109, #116, #121, #122, #123:** `cf` (1.0.0-beta.10 → 1.0.0-beta.18 across worker bundles).\n- *Verification Requirement:* `npm run build --prefix experiments/cloudflare-artifacts-vertical-slice` and typecheck pass.\n\n#### Batch 3: GitHub Actions CI Workflows (Medium Risk / CI Pipeline Validation)\nModernization of hosted automation actions in `.github/workflows/`:\n- **PR #103:** `actions/attest-build-provenance` (commit hash update for SLSA build provenance).\n- **PR #104:** `actions/checkout` (v4.4.0 → v7.0.1) — Major runner checkout upgrade.\n- **PR #106:** `actions/download-artifact` (v4.3.0 → v8.0.2) — Artifact fetcher upgrade.\n- **PR #108:** `softprops/action-gh-release` (v2.6.2 → v3.0.3) — GitHub release asset upload upgrade.\n- **PR #112:** `actions/setup-node` (v4.4.0 → v7.1.0) — Node environment provisioning upgrade.\n- *Verification Requirement:* Staged workflow validation on test branch; assert identical artifact download and release asset publishing behavior.\n\n#### Batch 4: TypeScript Compiler & Typing Toolchain (Medium Risk / Type Safety Validation)\nModernization of the TypeScript compiler toolchain:\n- **PR #119:** `typescript` (5.9.3 → 7.0.2 in `/demo`) — Demo runner compiler bump.\n- **PR #124:** `@types/node` (22.20.4 → 26.6.5 in `/cli`) — Node.js runtime typings.\n- **PR #129:** `typescript` (5.9.3 → 7.0.2 in `/cli`) — Core CLI compiler bump.\n- *Verification Requirement:* Zero TypeScript compiler errors (`npm run build --prefix cli`, `tsc --noEmit`), clean declaration emission, and zero new `any` casts.\n\n#### Batch 5: Production CLI Runtime Libraries (High Risk / Breaking API Migration)\nMajor version bumps requiring focused API compatibility audits and code changes:\n- **PR #111:** `dotenv` (16.6.1 → 18.0.8 in `/cli`) — Environment loading library update. Verify untrusted workspace `.env` rejection invariants (REQ-SEC-001) remain strictly intact.\n- **PR #114:** `commander` (12.1.0 → 15.0.0 in `/cli`) — Major CLI option parser upgrade. Requires comprehensive audit of subcommands (`nexus run`, `check`, `models`, `upgrade`), option parsing (`--strict-token-count`, `--isolated-home`), and exit code propagation.\n- **PR #120:** `ora` (8.2.0 → 9.4.1 in `/cli`) — Terminal spinner library update. Validate stdout/stderr streaming, non-interactive CI fallback, and Ratatui TUI coexistence.\n- *Verification Requirement:* Full CLI unit and PTY suite (1,511+ tests), CLI journey tests (`cli/test/system_journey.test.ts`), and doctor verification.\n\n---\n\n## 3. Milestone v1.2.0: Experiment Comparison, Replay & Annotation\n\n**Target:** Second feature release post-v1.0.0\n**Theme:** Diagnostic reproducibility, statistical comparison across agent versions, interactive TUI trace inspection, and human annotation workflows.\n\n### Work Packages\n\n| ID | Title | Summary & Deliverables | Backlog / Audit Source |\n| :--- | :--- | :--- | :--- |\n| **WP-1201** | **Deterministic Session Replay** | Implement `nexus replay <trace-id>`: Re-executes tool calls and container steps from a recorded trace inside an isolated bubblewrap container to reproduce bugs without re-calling the model. | `LANGSMITH_REVIEW` §1.1 |\n| **WP-1202** | **Experiment Comparator** | Implement `eval/compare.mjs` comparing two experiment runs with Wilson score 95% confidence intervals, token cost deltas, duration deltas, and regression matrices. | `LANGSMITH_REVIEW` §2.4 |\n| **WP-1203** | **Interactive TUI Trace Inspector** | Add a hierarchical trace inspector panel to `nexus-tui` (Ratatui), allowing operators to view the tool call tree, intermediate stdout, and latency distributions. | `LANGSMITH_REVIEW` §2.1 |\n| **WP-1204** | **Human Review & Annotation Queue** | Implement `nexus review <session-id>`: Interactive CLI / TUI prompt guiding reviewers through structured rubrics (tool correctness, intent fulfillment) and recording signed audit evidence. | `REQ-AGT-010`, `LANGSMITH_REVIEW` §6 |\n| **WP-1205** | **Heuristic Failure Clustering** | Implement automated classification of failing eval runs into structured failure modes (`TIMEOUT`, `LOOP_DETECTED`, `SCHEMA_CORRUPTION`, `UNAUTHORIZED_PATH`, `COMPILER_ERROR`). | `LANGSMITH_REVIEW` §7 |\n| **WP-1206** | **`/tdd` Phase Enforcement** | Enforce red-green-refactor phase invariants when running under test-driven development posture. | `VER-08`, `REQUIREMENTS.md` §5 |\n| **WP-1207** | **Composio Developer Ecosystem & Review Bridge** | Integrate Composio platform connectors (backed by Composio Startup Program Pro) to provide managed OAuth and bidirectional developer workflows: automated Linear and Jira issue creation from failure clusters (`WP-1205`), GitHub pull request review synchronization, and Slack/Discord notification dispatch for human annotation queues (`WP-1204`). Operates under strict zero-leak credential isolation (`CRED003`), unprivileged execution sandbox boundaries, and requires explicit operator confirmation for write actions. | Composio Startup Program, `POSITIONING.md` §3.8 |\n\n---\n\n## 4. Milestone v1.3.0: Standard OTLP Exporters & Platform Expansion\n\n**Target:** Enterprise & multi-platform release\n**Theme:** Standard OpenTelemetry network export, full context provenance graphs, knowledge lifecycle management, and macOS/arm64 architecture support.\n\n### Work Packages\n\n| ID | Title | Summary & Deliverables | Backlog / Audit Source |\n| :--- | :--- | :--- | :--- |\n| **WP-1301** | **OpenTelemetry OTLP Exporter** | Add standard OTLP HTTP/gRPC exporter plug-in allowing operators to stream traces to local or network collectors (Jaeger, SigNoz, Langfuse, LangSmith) under strict egress allowlists. | `LANGSMITH_REVIEW` §9.3 |\n| **WP-1302** | **Full Context Provenance Graph** | Implement complete graph metadata for all context admissions (tracking origin file, trust classification, transformation history, and compaction survival). | `CTX-001`, `REQ-AGT-010` |\n| **WP-1303** | **macOS & arm64 Build Pipelines** | Add native GitHub Actions packaging runners and platform sandboxing (macOS `sandbox-exec` / Linux `arm64`). | `DEC-12`, `REQUIREMENTS.md` §5 |\n| **WP-1304** | **Knowledge Freshness & Lifecycle** | Implement automated staleness detection, contradiction resolution, and operator prompts for expiring project knowledge. | `CTX-002`, `REQUIREMENTS.md` §5 |\n| **WP-1305** | **cgroup v2 Fine-Grained Limits** | Add direct per-command CPU throttling and memory caps via systemd/cgroup-v2 scopes. | `REQUIREMENTS.md` §5 |\n| **WP-1306** | **Composio Enterprise Multi-App MCP Mesh** | Enable dynamic discovery and tool execution across 250+ enterprise SaaS applications (Salesforce, Google Workspace, AWS, Notion, Datadog, Sentry, Asana) using Composio's Model Context Protocol (MCP) toolsets. Compiles enterprise action schemas into logit-constrained GBNF grammars via `WP-1107` to enforce JSON schema syntactic compliance on local models. Enforces egress domain filtering, tmpfs execution isolation, and sovereign zero-telemetry defaults. | Composio Startup Program, `SPEC-OBSERVABILITY.md` §7 |\n\n---\n\n## 5. Architectural Invariants Across All Post-v1 Releases\n\n1. **Security & Boundary Preservation:** No post-v1 observability or evaluation feature may bypass or weaken the v1.0.0 security boundaries (untrusted `.env` rejection, SSRF blocking, container path confinement, or workspace trust).\n2. **Local Sovereignty:** Nexus remains 100% operational in air-gapped, offline, and self-hosted environments. External network transmission of telemetry is disabled by default and strictly opt-in.\n3. **Open Standards:** Telemetry formats conform to OpenTelemetry GenAI semantic conventions rather than proprietary vendor SDKs.\n4. **Reproducibility:** All benchmark datasets, evaluator code, and comparison tools are committed directly to the repository and execute deterministically under isolated `$HOME`.\n5. **Zero Technical Debt & Zero Deprecated Packages (Inviolable Invariant):**\n   - Strictly **NO deprecated packages or unmaintained third-party library dependencies** may ever be introduced, merged, or retained in any component or release—ever.\n   - Every npm dependency and Cargo crate must be on active, supported upstream releases.\n   - Automated CI gates fail closed on:\n     - Any npm package marked `deprecated` by the npm registry (`npm audit` and package-tree deprecation scans).\n     - Any Rust crate flagged as unmaintained, yanked, or deprecated in the RustSec advisory database (`cargo deny check bans advisories`).\n   - *Platform engines vs. libraries:* Platform runtime engine requirements (such as Node.js) follow explicit project architectural decisions (DEC-12), with upstream EOL status disclosed and modern LTS versions recommended.\n   - When upstream library dependencies announce deprecation or breaking lifecycles, Nexus must refactor, migrate, or replace them before minor release qualification. Under no circumstances may technical debt be deferred into permanent legacy layers.\n6. **Opt-In External Integrations & Boundary Invariant:**\n   - All third-party services and app connectors (including Composio developer bridges and enterprise app toolsets) are strictly **opt-in** and disabled by default.\n   - Nexus Code must always retain 100% operational capability in air-gapped, zero-network environments without external API keys.\n   - External tokens (`NEXUS_COMPOSIO_API_KEY`) must never be leaked into git commits, trace logs, or flight recordings (`CRED003`).\n   - High-impact or state-mutating actions on external services require explicit operator confirmation prompts before execution.\n","exit_code":0,"duration":{"secs":0,"nanos":805576024}},"started_at_ms":1793736430732,"completed_at_ms":1793736431538}}
{"timestamp":"2026-11-03T20:07:13.072Z","ordinal":80404,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1a305-ddb0-7091-acdf-55c1edf27b73","call_id":"call_82d6713eb62b4f61b6e051f2252877e2","output":[{"type":"input_text","text":"Script completed\nWall time 3.8 seconds\nOutput:\n"},{"type":"input_text","text":"WORKSTATE_CHARS 32870\n{\"content\":[{\"type\":\"text\",\"text\":\"- v1.1.2-release: state=WP-1103/1104 full qualification completed at 789b247a; WP-1105 code evaluators integrated into runner and scorer at e2bacf1a. Ready for WP-1106 single-step loop mode., phase=scope reconciliation and owner coordination, gate=WP-1101 source candidate 97945557 full CLI suite PASS 2314/0/5; RC.2 version-only test PASS 1/1; npm build PASS; current make test on f6d474a4 started with 43 Rust core tests and CLI suite active; Rust core unit group 43 PASS, TUI group 254 in progress., next=Make qualification record explicitly separate the user's approved WP-1101–WP-1108 release scope from the current specialist roadmap; then resume dependent G1.1-4 only after GATEWAY holder clears or coordinates., friction=No current assertion failures. Existing remote GATEWAY claim remains held by a separate RC15 agent on ubuntu-desktop; avoid inference-backed benchmark until cleared., updated=2026-11-03T00:33:00Z, reviewer=/root/review_delta fresh independent review requested and running., REDACTED; final narrow update confirmation pending, retrieval=XERJ nexus-cli client.ts:1317 chatCompletion signature; agent.ts:5819 recovery submit boundary; exact local call sites reviewed; XERJ follow-up field report submitted., active_agents=Read-only audit delegated to /root/v112_unblocked_work to identify safe progress that does not load the shared test host., heartbeat=2026-11-03 13:14:51 UTC, claim=WP1101_TRACING plus cli/src/agent.ts, cli/test/agent_observer.test.ts, docs/v1.1.0/WP-1101-PLAN.md and SUITE held., candidateTree=1518780db3fbc3f2bc06312aa7bea137a67ce26d clean integrated branch; 1ecdd557 detached qualification snapshot, suite=/tmp/wp1101-full-suite-rerun.log; snapshot /home/mike/nexus-wt/v112-wp1101-qualification; run started after copy of current WP-1101 files and local node_modules replacement., build=npm run build PASS, cargo release builds PASS, artifactAcceptance=PASS: pinned Bookworm package archive 27dbbb8120e755061e92218eaceb5e12b7d9457230b9b0aa82b96d28cc3791ee; six benchmark tasks PASS, packageRevision=1ecdd557ebe31267c67f281b49d64605e5464777, wp1102Fix=cli/src/sidecar.ts preserves typed workspac"},{"type":"input_text","text":"RESULT 1\n{\"chunk_id\":\"443dd5\",\"wall_time_seconds\":0.805641272,\"exit_code\":0,\"original_token_count\":6677,\"output\":\"Warning: truncated output (original token count: 6677)\\nTotal output lines: 221\\n\\n M docs/releases/v1.1.2-qualification.md\\n?? docs/v1.1.0/WP-1107-PLAN.md\\n3eea888abbf20b4b63c75c2b554debd67038f5a1\\n# WP-1107 — Provider-Constrained Tool Grammar\\n\\n## Specification\\n\\n**User story:** As a Nexus user running a supported local inference engine, I need registered tool arguments constrained by that engine so tool calls arrive as valid JSON and require fewer syntax repairs.\\n\\n**Acceptance criteria:**\\n\\n- **AC1:** An identified llama.cpp chat endpoint receives the grammar generated from the active allowlisted tool schemas. Test: `client sends llama.cpp GBNF for supported tool calls`.\\n- **AC2:** An identified vLLM endpoint receives the provider's supported JSON-schema-constrained tool-call request shape. Test: `client sends vLLM structured tool schema for supported tool calls`.\\n- **AC3:** An identified Ollama endpoint receives its supported schema-constrained tool-call request shape. Test: `client sends Ollama JSON schema format for supported tool calls`.\\n- **AC4:** Unknown, unsupported, or ambiguously identified endpoints retain their current request shape; no grammar field is sent based only on a configured lane label or generic OpenAI-compatible catalog fields. Tests: `client omits constrained fields for unknown and unsupported providers`; `generic context catalog remains unknown and receives no grammar field`; `provider identity accepts llama.cpp only with its marker and valid props handshake`; `provider identity accepts vLLM only with its documented version response`; `provider identity accepts Ollama only with version and selected-model show response`; `client omits constrained fields for missing malformed or mismatched provider identity`.\\n- **AC5:** On each supported endpoint, the exact installed candidate completes 200 attempts: 50 for each of four fixed allowlisted tool schemas. Each attempt requests exactly one tool call. `native_valid` means the raw provider argument string parses with `JSON.parse` before any normalization or repair; `repaired` means raw parsing fails and the existing tool-call repair path produces parseable JSON; `invalid` includes every other outcome, including provider errors, timeouts, missing calls, and unparseable arguments. An endpoint passes only when `native_valid * 1000 >= attempts * 995` and `invalid == 0`; report exact integer counts and do not round percentages for the decision. Tests/evidence: `tool grammar matrix evidence schema rejects invalid counts and identity omissions`; `tool grammar matrix computes endpoint pass without percentage rounding`; `tool grammar matrix runner records archive and per-endpoint identity`; live `WP-1107 supported-endpoint syntax matrix`.\\n\\n**Out of scope:** Changing tool schemas or the allowlist; applying constraints to non-tool completions; measuring task-solving quality; enabling constraints on an endpoint that does not positively identify itself.\\n\\n**Dependencies:** Existing schema-derived grammar generator and `toolCallSyntax` telemetry; source implementation is otherwise independent. AC5 depends on an approved shared inference window and the exact candidate package.\\n\\n**Scope reconciliation:** The user selected the full failed v1.1.0 WP-1101–WP-1108 roadmap for v1.1.2. This explicit scope supersedes the older deferral in `ROADMAP-REVIEW.md` §2.5. It does not waive the required provider references, test gates, review, or G1.1-4 endpoint evidence.\\n\\n## Implementation plan\\n\\n**Chunk 1 — Provider request adapter**\\n\\n- Add a typed adapter mapping provider kinds to documented request constraint fields only after a provider-specific positive identity check. A configured lane label or `context_length`/`max_model_len` alone is insufficient.\\n- Derive constraints from the current allowlisted tool schemas; preserve the existing request when provider kind is unknown or the endpoint/protocol does not support the field.\\n- Files: `cli/src/core/tool_grammar_provider.ts` (new), `cli/src/core/provider_capabilities.ts`, `cli/test/client_tool_grammar.test.ts` (new), `cli/test/provider_capabilities.test.ts`.\\n- Tests: AC1–AC4 request-shape and identity tests above, including positive provider-handshake fixtures and generic/missing/malformed/mismatched negative cases.\\n- Identity contract: llama.cpp requires the exact `/v1/models` `owned_by: \\\"llamacpp\\\"` marker or its `meta.n_ctx_train` marker plus a successful `/props` response matching the existing llama.cpp schema; Ollama requires its `/api/version` response with a non-empty `version` string and a successful `/api/show` response for the selected model; vLLM requires a successful `GET /version` returning the provider's documented JSON version response and the selected model in `/v1/models`. A generic catalog containing only `context_length` or `max_model_len` remains `unknown` for grammar attachment, even if the matrix lane is configured as vLLM. These are provider self-identification handshakes on the operator-configured endpoint, not cryptographic server authentication; any mismatch, missing probe, or malformed response disables constrained fields.\\n- References to retrieve: official llama.cpp, vLLM, and Ollama server request implementations/docs.\\n\\n**Chunk 2 — Client integration**\\n\\n- Attach the adapter output to non-streaming, streaming, and supported native client request bodies without changing message, tool, credential, or egress handling.\\n- Files: `cli/src/client.ts`, `cli/test/client_tool_grammar.test.ts`.\\n- Tests: captured request-body tests for each applicable transport path, plus AC4 fallback.\\n- Reference to retrieve: `LocalLlmClient` request construction and provider identification on the exact candidate.\\n\\n**Chunk 3 — Candidate endpoint matrix**\\n\\n- Add a deterministic runner and schema validator. Fake-provider/serialization tests validate request construction and evidence validation only; they do not count as live endpoint measurements.\\n- Files: `eval/tool_grammar_matrix.mjs` (new), `eval/tool_grammar_matrix.test.mjs` (new), `docs/evidence/v1.1.2/wp-1107-provider-matrix.json` (new), `docs/evidence/v1.1.2/wp-1107-provider-matrix.json.sha256` (new detached digest), `docs/releases/v1.1.2-qualification.md`.\\n- Tests: `tool grammar matrix evidence schema rejects invalid counts and identity omissions`; `tool grammar matrix computes endpoint pass without percentage rounding`; `tool grammar matrix runner records archive and per-endpoint identity`.\\n- Matrix: run the exact installed archive against one allowlisted llama.cpp, vLLM, and Ollama endpoint. Before the run, the matrix must pin each server to an immutable image/version and record model name plus immutable model digest, context size, sampling settings, tool choice, prompt fixture digest, server flags, and relevant compatibility mode. Record provider identification from the detected `serverKind` returned by the client; the lane is valid only when that value exactly matches the configured provider (`llamacpp`, `vllm`, or `ollama`). Unknown/mismatched identities fail before attempts and receive no constraint fields.\\n- Evidence fields: archive SHA-256 and source commit; provider/server kind; server version and immutable image digest; model name and immutable model digest; non-secret configuration and stimulus digest; total attempts and per-tool attempts; native-valid/repaired/invalid counts per endpoint; exact pass equation result; evidence schema version. Store the finalized evidence file’s SHA-256 in the detached `.sha256` sidecar and qualification record (the JSON cannot hash itself). Omit endpoint URLs, credentials, and other secrets.\\n- Test/evidence: AC5 threshold and zero-invalid requirement for every provider. This measures argument JSON only; it does not certify tool selection or task correctness.\\n- Dependency: explicit release of the shared `GATEWAY` claim before any inference.\\n\\n## Risks and reference queries\\n\\n- Provider request contracts may have changed since the roadmap draft. Retrieve current primary references before implementation:\\n  - `llama.cpp` (`https://github.com/ggml-org/llama.cpp`) — chat-completion grammar request field and interaction with function tools.\\n  - `vLLM` (`https://github.com/vllm-project/vllm`) — current structured-output request field and function-tool compatibility.\\n  - `Ollama` (`https://github.com/ollama/ollama`) — current chat `format` schema and function-tool compatibility.\\n  - `nexus-cli` XERJ prefix — exact candidate request construction and provider identification.\\n- A provider field that constrains the whole response may conflict with native function calling; retain only combinations shown to be supported by the primary references and captured-request tests.\\n- G1.1-4 requires a real endpoint matrix. A loopback mock proves serialization only and cannot satisfy the 99.5% metric.\\n- The provider lane’s immutable server and model identities are not yet confirmed because the shared `GATEWAY` claim is still held by the RC15 stream. Treat them as a pre-run gate: record and peer-review the three exact identities/configurations in the matrix plan before starting any provider call; do not substitute mutable tags or infer identity from an endpoint URL.\\n# Nexus Code Post-v1.0.0 Roadmap: v1.1.0 – v1.3.0\\n\\n**Status:** Draft / Active Planning\\n**Baseline:** Nexus Code `v1.0.0` (Release Candidate Baseline)\\n**Parent Strategy:** Evaluation-Driven Development, Local-First Observability & Operator Sovereignty\\n\\n---\\n\\n## 1. Release Schedule Overview\\n\\n```\\n2026-Q4                             2027-Q1                             2027-Q2\\n───┬───────────────────────────────────┬───────────────────────────────────┬───►\\n   │                                   │                                   │\\n   ▼                                   ▼                                   ▼\\nv1.0.0 (Baseline Freeze)            v1.1.0                              v1.2.0\\n-…1677 tokens truncated…E; bit-for-bit packaging `cmp` check.\\n\\n#### Batch 2: Cloudflare Experimental Micro-Workers (Low Risk / Isolated)\\nMaintenance updates for the isolated Cloudflare artifacts vertical slice (retired contest contract track):\\n- **PRs #125, #126, #127, #128:** `vite` (8.3.3 → 8.3.4 across root and worker packages).\\n- **PRs #115, #117, #118:** `@cloudflare/vite-plugin` (2.0.0-beta.sha-52b0dc0e9 → 2.0.0-beta.v.1).\\n- **PRs #109, #116, #121, #122, #123:** `cf` (1.0.0-beta.10 → 1.0.0-beta.18 across worker bundles).\\n- *Verification Requirement:* `npm run build --prefix experiments/cloudflare-artifacts-vertical-slice` and typecheck pass.\\n\\n#### Batch 3: GitHub Actions CI Workflows (Medium Risk / CI Pipeline Validation)\\nModernization of hosted automation actions in `.github/workflows/`:\\n- **PR #103:** `actions/attest-build-provenance` (commit hash update for SLSA build provenance).\\n- **PR #104:** `actions/checkout` (v4.4.0 → v7.0.1) — Major runner checkout upgrade.\\n- **PR #106:** `actions/download-artifact` (v4.3.0 → v8.0.2) — Artifact fetcher upgrade.\\n- **PR #108:** `softprops/action-gh-release` (v2.6.2 → v3.0.3) — GitHub release asset upload upgrade.\\n- **PR #112:** `actions/setup-node` (v4.4.0 → v7.1.0) — Node environment provisioning upgrade.\\n- *Verification Requirement:* Staged workflow validation on test branch; assert identical artifact download and release asset publishing behavior.\\n\\n#### Batch 4: TypeScript Compiler & Typing Toolchain (Medium Risk / Type Safety Validation)\\nModernization of the TypeScript compiler toolchain:\\n- **PR #119:** `typescript` (5.9.3 → 7.0.2 in `/demo`) — Demo runner compiler bump.\\n- **PR #124:** `@types/node` (22.20.4 → 26.6.5 in `/cli`) — Node.js runtime typings.\\n- **PR #129:** `typescript` (5.9.3 → 7.0.2 in `/cli`) — Core CLI compiler bump.\\n- *Verification Requirement:* Zero TypeScript compiler errors (`npm run build --prefix cli`, `tsc --noEmit`), clean declaration emission, and zero new `any` casts.\\n\\n#### Batch 5: Production CLI Runtime Libraries (High Risk / Breaking API Migration)\\nMajor version bumps requiring focused API compatibility audits and code changes:\\n- **PR #111:** `dotenv` (16.6.1 → 18.0.8 in `/cli`) — Environment loading library update. Verify untrusted workspace `.env` rejection invariants (REQ-SEC-001) remain strictly intact.\\n- **PR #114:** `commander` (12.1.0 → 15.0.0 in `/cli`) — Major CLI option parser upgrade. Requires comprehensive audit of subcommands (`nexus run`, `check`, `models`, `upgrade`), option parsing (`--strict-token-count`, `--isolated-home`), and exit code propagation.\\n- **PR #120:** `ora` (8.2.0 → 9.4.1 in `/cli`) — Terminal spinner library update. Validate stdout/stderr streaming, non-interactive CI fallback, and Ratatui TUI coexistence.\\n- *Verification Requirement:* Full CLI unit and PTY suite (1,511+ tests), CLI journey tests (`cli/test/system_journey.test.ts`), and doctor verification.\\n\\n---\\n\\n## 3. Milestone v1.2.0: Experiment Comparison, Replay & Annotation\\n\\n**Target:** Second feature release post-v1.0.0\\n**Theme:** Diagnostic reproducibility, statistical comparison across agent versions, interactive TUI trace inspection, and human annotation workflows.\\n\\n### Work Packages\\n\\n| ID | Title | Summary & Deliverables | Backlog / Audit Source |\\n| :--- | :--- | :--- | :--- |\\n| **WP-1201** | **Deterministic Session Replay** | Implement `nexus replay <trace-id>`: Re-executes tool calls and container steps from a recorded trace inside an isolated bubblewrap container to reproduce bugs without re-calling the model. | `LANGSMITH_REVIEW` §1.1 |\\n| **WP-1202** | **Experiment Comparator** | Implement `eval/compare.mjs` comparing two experiment runs with Wilson score 95% confidence intervals, token cost deltas, duration deltas, and regression matrices. | `LANGSMITH_REVIEW` §2.4 |\\n| **WP-1203** | **Interactive TUI Trace Inspector** | Add a hierarchical trace inspector panel to `nexus-tui` (Ratatui), allowing operators to view the tool call tree, intermediate stdout, and latency distributions. | `LANGSMITH_REVIEW` §2.1 |\\n| **WP-1204** | **Human Review & Annotation Queue** | Implement `nexus review <session-id>`: Interactive CLI / TUI prompt guiding reviewers through structured rubrics (tool correctness, intent fulfillment) and recording signed audit evidence. | `REQ-AGT-010`, `LANGSMITH_REVIEW` §6 |\\n| **WP-1205** | **Heuristic Failure Clustering** | Implement automated classification of failing eval runs into structured failure modes (`TIMEOUT`, `LOOP_DETECTED`, `SCHEMA_CORRUPTION`, `UNAUTHORIZED_PATH`, `COMPILER_ERROR`). | `LANGSMITH_REVIEW` §7 |\\n| **WP-1206** | **`/tdd` Phase Enforcement** | Enforce red-green-refactor phase invariants when running under test-driven development posture. | `VER-08`, `REQUIREMENTS.md` §5 |\\n| **WP-1207** | **Composio Developer Ecosystem & Review Bridge** | Integrate Composio platform connectors (backed by Composio Startup Program Pro) to provide managed OAuth and bidirectional developer workflows: automated Linear and Jira issue creation from failure clusters (`WP-1205`), GitHub pull request review synchronization, and Slack/Discord notification dispatch for human annotation queues (`WP-1204`). Operates under strict zero-leak credential isolation (`CRED003`), unprivileged execution sandbox boundaries, and requires explicit operator confirmation for write actions. | Composio Startup Program, `POSITIONING.md` §3.8 |\\n\\n---\\n\\n## 4. Milestone v1.3.0: Standard OTLP Exporters & Platform Expansion\\n\\n**Target:** Enterprise & multi-platform release\\n**Theme:** Standard OpenTelemetry network export, full context provenance graphs, knowledge lifecycle management, and macOS/arm64 architecture support.\\n\\n### Work Packages\\n\\n| ID | Title | Summary & Deliverables | Backlog / Audit Source |\\n| :--- | :--- | :--- | :--- |\\n| **WP-1301** | **OpenTelemetry OTLP Exporter** | Add standard OTLP HTTP/gRPC exporter plug-in allowing operators to stream traces to local or network collectors (Jaeger, SigNoz, Langfuse, LangSmith) under strict egress allowlists. | `LANGSMITH_REVIEW` §9.3 |\\n| **WP-1302** | **Full Context Provenance Graph** | Implement complete graph metadata for all context admissions (tracking origin file, trust classification, transformation history, and compaction survival). | `CTX-001`, `REQ-AGT-010` |\\n| **WP-1303** | **macOS & arm64 Build Pipelines** | Add native GitHub Actions packaging runners and platform sandboxing (macOS `sandbox-exec` / Linux `arm64`). | `DEC-12`, `REQUIREMENTS.md` §5 |\\n| **WP-1304** | **Knowledge Freshness & Lifecycle** | Implement automated staleness detection, contradiction resolution, and operator prompts for expiring project knowledge. | `CTX-002`, `REQUIREMENTS.md` §5 |\\n| **WP-1305** | **cgroup v2 Fine-Grained Limits** | Add direct per-command CPU throttling and memory caps via systemd/cgroup-v2 scopes. | `REQUIREMENTS.md` §5 |\\n| **WP-1306** | **Composio Enterprise Multi-App MCP Mesh** | Enable dynamic discovery and tool execution across 250+ enterprise SaaS applications (Salesforce, Google Workspace, AWS, Notion, Datadog, Sentry, Asana) using Composio's Model Context Protocol (MCP) toolsets. Compiles enterprise action schemas into logit-constrained GBNF grammars via `WP-1107` to enforce JSON schema syntactic compliance on local models. Enforces egress domain filtering, tmpfs execution isolation, and sovereign zero-telemetry defaults. | Composio Startup Program, `SPEC-OBSERVABILITY.md` §7 |\\n\\n---\\n\\n## 5. Architectural Invariants Across All Post-v1 Releases\\n\\n1. **Security & Boundary Preservation:** No post-v1 observability or evaluation feature may bypass or weaken the v1.0.0 security boundaries (untrusted `.env` rejection, SSRF blocking, container path confinement, or workspace trust).\\n2. **Local Sovereignty:** Nexus remains 100% operational in air-gapped, offline, and self-hosted environments. External network transmission of telemetry is disabled by default and strictly opt-in.\\n3. **Open Standards:** Telemetry formats conform to OpenTelemetry GenAI semantic conventions rather than proprietary vendor SDKs.\\n4. **Reproducibility:** All benchmark datasets, evaluator code, and comparison tools are committed directly to the repository and execute deterministically under isolated `$HOME`.\\n5. **Zero Technical Debt & Zero Deprecated Packages (Inviolable Invariant):**\\n   - Strictly **NO deprecated packages or unmaintained third-party library dependencies** may ever be introduced, merged, or retained in any component or release—ever.\\n   - Every npm dependency and Cargo crate must be on active, supported upstream releases.\\n   - Automated CI gates fail closed on:\\n     - Any npm package marked `deprecated` by the npm registry (`npm audit` and package-tree deprecation scans).\\n     - Any Rust crate flagged as unmaintained, yanked, or deprecated in the RustSec advisory database (`cargo deny check bans advisories`).\\n   - *Platform engines vs. libraries:* Platform runtime engine requirements (such as Node.js) follow explicit project architectural decisions (DEC-12), with upstream EOL status disclosed and modern LTS versions recommended.\\n   - When upstream library dependencies announce deprecation or breaking lifecycles, Nexus must refactor, migrate, or replace them before minor release qualification. Under no circumstances may technical debt be deferred into permanent legacy layers.\\n6. **Opt-In External Integrations & Boundary Invariant:**\\n   - All third-party services and app connectors (including Composio developer bridges and enterprise app toolsets) are strictly **opt-in** and disabled by default.\\n   - Nexus Code must always retain 100% operational capability in air-gapped, zero-network environments without external API keys.\\n   - External tokens (`NEXUS_COMPOSIO_API_KEY`) must never be leaked into git commits, trace logs, or flight recordings (`CRED003`).\\n   - High-impact or state-mutating actions on external services require explicit operator confirmation prompts before execution.\\n\"}"},{"type":"input_text","text":"RESULT 2\n{\"chunk_id\":\"d8a8fa\",\"wall_time_seconds\":1.001570719,\"session_id\":58333,\"original_token_count\":48,\"output\":\"autoindex: 2 scan threads, 2 index workers, 4 pdf workers, --bulk-mb 8 [cores=18 ram_total_mib=48105 ram_available_mib=36468 safe_zone_mib=24052]\\nautoindex: bulk HTTP request timeout: 300s\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","create_time":1793736433.0720017}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
