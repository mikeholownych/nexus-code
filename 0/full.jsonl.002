    // TODO @ngxson : this function may need to be improved in the future\\\\n    // handle input files\\\\n    out_files.clear();\\\\n    auto it = in_files.find(\\\\\\\"file\\\\\\\");\\\\n    if (it != in_files.end()) {\\\\n        out_files.push_back(it->second.data);\\\\n    } else {\\\\n        throw std::invalid_argument(\\\\\\\"No input file found for transcription\\\\\\\");\\\\n    }\\\\n\\\\n    // handle input data\\\\n    std::string prompt          = json_value(inp_body, \\\\\\\"prompt\\\\\\\", std::string());\\\\n    std::string language        = json_value(inp_body, \\\\\\\"language\\\\\\\", std::string());\\\\n    std::string response_format = json_value(inp_body, \\\\\\\"response_format\\\\\\\", std::string(\\\\\\\"json\\\\\\\"));\\\\n    if (response_format != \\\\\\\"json\\\\\\\") {\\\\n        throw std::invalid_argument(\\\\\\\"Only 'json' response_format is supported for transcription\\\\\\\");\\\\n    }\\\\n    const common_chat_prompt_preset preset = common_chat_get_asr_prompt(tmpls, language);\\\\n    if (prompt.empty()) {\\\\n        prompt = preset.user;\\\\n    }\\\\n    if (!language.empty() && !preset.has_language) {\\\\n        prompt += string_format(\\\\\\\" (language: %s)\\\\\\\", language.c_str());\\\\n    }\\\\n    prompt += get_media_marker();\\\\n\\\\n    json messages = json::array();\\\\n    if (!preset.system.empty()) {\\\\n        messages.push_back({{\\\\\\\"role\\\\\\\", \\\\\\\"system\\\\\\\"}, {\\\\\\\"content\\\\\\\", preset.system}});\\\\n    }\\\\n    messages.push_back({{\\\\\\\"role\\\\\\\", \\\\\\\"user\\\\\\\"}, {\\\\\\\"content\\\\\\\", prompt}});\\\\n\\\\n    json chatcmpl_body = inp_body; // copy all fields\\\\n    chatcmpl_body[\\\\\\\"messages\\\\\\\"] = messages;\\\\n\\\\n    // because input from form-data, everything is string, we need to correct the types here\\\\n    std::string stream = json_value(inp_body, \\\\\\\"stream\\\\\\\", std::string(\\\\\\\"false\\\\\\\"));\\\\n    chatcmpl_body[\\\\\\\"stream\\\\\\\"] = stream == \\\\\\\"true\\\\\\\";\\\\n\\\\n    if (inp_body.contains(\\\\\\\"max_tokens\\\\\\\")) {\\\\n        std::string inp = inp_body[\\\\\\\"max_tokens\\\\\\\"].get<std::string>();\\\\n        chatcmpl_body[\\\\\\\"max_tokens\\\\\\\"] = std::stoul(inp);\\\\n    }\\\\n\\\\n    if (inp_body.contains(\\\\\\\"temperature\\\\\\\")) {\\\\n        std::string inp = inp_body[\\\\\\\"temperature\\\\\\\"].get<std::string>();\\\\n        chatcmpl_body[\\\\\\\"temperature\\\\\\\"] = std::stof(inp);\\\\n    }\\\\n\\\\n    return chatcmpl_body;\\\\n}\\\"}]},\\\"match_line\\\":701,\\\"match_lines\\\":[701,702,703]},{\\\"_index\\\":\\\"wp1107-llama-docs\\\",\\\"_id\\\":\\\"bf861bdc3a65cff03d06730b3f45872b\\\",\\\"_score\\\":25.476736,\\\"_source\\\":{\\\"title\\\":\\\"server-realtime.cpp\\\",\\\"ax_path\\\":\\\"tools/server/server-realtime.cpp\\\",\\\"ax_file\\\":\\\"axf2-f3f9f119eb9ce2113d5bb520950ad524-bb15\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"cpp\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":467,\\\"start_offset\\\":19316,\\\"end_offset\\\":23510,\\\"text\\\":\\\"void on_response_create(const json & ev) {\\\\n        if (type == \\\\\\\"transcription\\\\\\\") {\\\\n            send_error(\\\\\\\"response.create: not supported in a transcription session\\\\\\\");\\\\n            return;\\\\n        }\\\\n        if (!turn_open && !tool_results) {\\\\n            send_error(\\\\\\\"response.create: commit audio or create a message first\\\\\\\", \\\\\\\"conversation_empty\\\\\\\");\\\\n            return;\\\\n        }\\\\n        mtmd_helper_gen_audio_out_mode mode = out_mode;\\\\n        const json resp = ev.value(\\\\\\\"response\\\\\\\", json::object());\\\\n        if (resp.contains(\\\\\\\"output_modalities\\\\\\\")) {\\\\n            std::string err;\\\\n            if (!parse_output_modalities(resp[\\\\\\\"output_modalities\\\\\\\"], mode, err)) {\\\\n                send_error(\\\\\\\"response.create: \\\\\\\" + err);\\\\n                return;\\\\n            }\\\\n        }\\\\n        if (!deps.cap.audio_gen && mode != MTMD_HELPER_GEN_AUDIO_OUT_TEXT && mode != MTMD_HELPER_GEN_AUDIO_OUT_AUTO) {\\\\n            send_error(\\\\\\\"response.create: the model cannot generate audio\\\\\\\");\\\\n            return;\\\\n        }\\\\n        if (!deps.cap.text_gen && mode != MTMD_HELPER_GEN_AUDIO_OUT_AUDIO && mode != MTMD_HELPER_GEN_AUDIO_OUT_AUTO) {\\\\n            send_error(\\\\\\\"response.create: the model cannot generate text\\\\\\\");\\\\n            return;\\\\n        }\\\\n        // audio not committed yet belongs to this turn\\\\n        if (has_audio && !commit()) {\\\\n            return;\\\\n        }\\\\n\\\\n        common_chat_tool_choice choice = tool_choice;\\\\n        if (resp.contains(\\\\\\\"tool_choice\\\\\\\")) {\\\\n            std::string err;\\\\n            if (!parse_tool_choice(resp[\\\\\\\"tool_choice\\\\\\\"], choice, err)) {\\\\n                send_error(\\\\\\\"response.create: \\\\\\\" + err);\\\\n                return;\\\\n            }\\\\n        }\\\\n\\\\n        // the gen-audio pipeline opens the response in the asked mode, after tool results the assistant turn opens right away\\\\n        const std::string prompt = (turn_open ? user_footer : \\\\\\\"\\\\\\\") + assistant_header;\\\\n        server_control_response response;\\\\n        response.n_predict = max_output_tokens;\\\\n        if (resp.contains(\\\\\\\"max_output_tokens\\\\\\\") && !parse_max_output_tokens(resp[\\\\\\\"max_output_tokens\\\\\\\"], response.n_predict)) {\\\\n            send_error(\\\\\\\"response.create: max_output_tokens must be an integer or \\\\\\\\\\\\\\\"inf\\\\\\\\\\\\\\\"\\\\\\\");\\\\n            return;\\\\n        }\\\\n        response.out_mode = mode;\\\\n\\\\n        // with tools, the output goes through the tool call parser of the chat template and its grammar\\\\n        std::optional<common_chat_session> chat;\\\\n        if (!tools.empty()) {\\\\n            common_chat_msg user;\\\\n            user.role    = \\\\\\\"user\\\\\\\";\\\\n            user.content = \\\\\\\"@@USER@@\\\\\\\";\\\\n            common_chat_templates_inputs inputs = chat_inputs({user}, true);\\\\n            inputs.tool_choice         = choice;\\\\n            inputs.parallel_tool_calls = true;\\\\n            try {\\\\n                chat.emplace(deps.meta.chat_params.tmpls.get(), deps.vocab, inputs);\\\\n            } catch (const std::exception & e) {\\\\n                send_error(std::string(\\\\\\\"response.create: \\\\\\\") + e.what(), \\\\\\\"server_error\\\\\\\");\\\\n                return;\\\\n            }\\\\n        }\\\\n        response.sampling = response_sampling(chat ? &*chat : nullptr);\\\\n\\\\n        {\\\\n            std::lock_guard<std::mutex> lock(mutex);\\\\n            response_id      = \\\\\\\"resp_\\\\\\\" + random_string();\\\\n            response_item_id = \\\\\\\"item_\\\\\\\" + random_string();\\\\n            response_text.clear();\\\\n            parts       = json::array();\\\\n            idx_text    = -1;\\\\n            idx_audio   = -1;\\\\n            output      = json::array();\\\\n            idx_message = -1;\\\\n            call_items.clear();\\\\n            parse.reset();\\\\n            if (chat) {\\\\n                parse.emplace(std::move(*chat));\\\\n            }\\\\n            send_event({{\\\\\\\"type\\\\\\\", \\\\\\\"response.created\\\\\\\"}, {\\\\\\\"response\\\\\\\", {{\\\\\\\"id\\\\\\\", response_id}, {\\\\\\\"object\\\\\\\", \\\\\\\"realtime.response\\\\\\\"},\\\\n                        {\\\\\\\"status\\\\\\\", \\\\\\\"in_progress\\\\\\\"}, {\\\\\\\"output_modalities\\\\\\\", output_modalities_json(mode)}, {\\\\\\\"output\\\\\\\", json::array()}}}});\\\\n        }\\\\n        if (!control(SERVER_CONTROL_ACTION_RESPONSE_CREATE, prompt, {}, response)) {\\\\n            return;\\\\n        }\\\\n        // the response ends the turn, its tokens are in the slot; the footer goes in before the next turn\\\\n        next_header  = assistant_footer;\\\\n        turn_open    = false;\\\\n        tool_results = false;\\\\n        n_turns++;\\\\n    }\\\"}]},\\\"match_line\\\":518,\\\"match_lines\\\":[518,519,520,524,525,526,528,534]}]}}\"}],\"isError\":false}}\n{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"546385\",\"wall_time_seconds\":0.00007215,\"exit_code\":0,\"original_token_count\":139,\"output\":\"rg: /home/mike/xerj-references/llama.cpp/common: No such file or directory (os error 2)\\n/home/mike/xerj-references/llama.cpp/tools/server/server-common.cpp:1444:    inputs.json_schema            = json_schema.is_null() ? \\\"\\\" : json_schema.dump();\\n/home/mike/xerj-references/llama.cpp/tools/server/server-schema.cpp:295:                    if (grammar_type == \\\"tool_calls\\\") {\\n/home/mike/xerj-references/llama.cpp/tools/server/server-schema.cpp:296:                        params.sampling.grammar = {COMMON_GRAMMAR_TYPE_TOOL_CALLS, std::move(grammar_str)};\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","create_time":1793736069.9128668}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
