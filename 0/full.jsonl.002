TemplateField | None = None,\n871-    answer: ResponseTemplateField | None = None,\n872-    answer_format: dict[str, Any] | None = None,\n873-    message_start: list[str] | None = None,\n874-    requires_reasoning: bool = False,\n875-    sorted_arguments: bool = False,\n876-    strict_arguments: bool = False,\n877-) -> dict[str, Any] | None:\n55:    {\"type\", \"properties\", \"required\", \"additionalProperties\", \"$defs\", \"definitions\"}\n598:    strict: bool,\n634:    if strict and (set(parameters) - _ANNOTATIONS - _OBJECT_KEYWORDS or not typed):\n636:    required = parameters.get(\"required\") or []\n638:    if strict and properties is not None:\n640:        if not isinstance(required, list) or not all(\n641:            isinstance(key, str) for key in required\n644:        names = (*properties, *(key for key in required if key not in properties))\n692:    if not strict:\n695:        extra = parameters.get(\"additionalProperties\", True)\n700:    if parameters.get(\"additionalProperties\", False) is not False:\n754:        # A required name without a schema takes any value.\n770:        before = [more[k] if k in required else _optional(more[k]) for k in keys]\n787:        # The last parameter follows every required one.\n788:        first = max((i for i, k in enumerate(keys) if k in required), default=0)\n794:    return arguments(_one_of([ordered(keys) for keys in orders]), not required)\n801:    strict: bool,\n808:        schema = parameters if strict else {\"type\": \"object\"}\n814:            strict=strict,\n876:    strict_arguments: bool = False,\n879:    `field`, respecting strict arguments, count and reasoning.\n881:    `functions` are OpenAI function definitions. `strict_arguments` enforces\n909:        strict = bool(function.get(\"strict\"))\n911:        if strict or strict_arguments:\n914:                    field, parameters, strict=True, sorted_arguments=sorted_arguments\n917:                if strict:\n920:        if function_arguments is None and