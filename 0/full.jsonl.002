{"timestamp":"2026-11-03T22:08:42.650Z","ordinal":84233,"type":"token_usage_record","payload":{"thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","session_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","root_turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","response_id":"resp_0fd4138577b17921016aea5b619df481a3b6ab5a54a7f04f77","usage":{"input_tokens":213299,"cached_input_tokens":211968,"cache_write_input_tokens":0,"output_tokens":468,"reasoning_output_tokens":374,"total_tokens":213767},"turn_token_usage":{"input_tokens":40731577,"cached_input_tokens":40428928,"cache_write_input_tokens":0,"output_tokens":77718,"reasoning_output_tokens":40460,"total_tokens":40809295},"thread_token_usage":{"input_tokens":1708022245,"cached_input_tokens":1695161984,"cache_write_input_tokens":0,"output_tokens":3172595,"reasoning_output_tokens":1558184,"total_tokens":1711194840}}}
{"timestamp":"2026-11-03T22:08:44.958Z","ordinal":84234,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","item":{"type":"CommandExecution","id":"exec-616f2ac0-3340-401d-970d-d0f2d655dc00","process_id":"23073","command":["/usr/bin/zsh","-lc","sed -n '72,130p' cli/src/core/provider_capabilities.ts; sed -n '25,60p' cli/test/provider_capabilities.test.ts"],"cwd":"file:///home/mike/nexus-wt/v112-wp1101-integration","parsed_cmd":[{"type":"read","cmd":"sed -n '72,130p' cli/src/core/provider_capabilities.ts","name":"provider_capabilities.ts","path":"cli/src/core/provider_capabilities.ts"},{"type":"read","cmd":"sed -n '25,60p' cli/test/provider_capabilities.test.ts","name":"provider_capabilities.test.ts","path":"cli/test/provider_capabilities.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":" * Which server kind an entry positively identifies: gateway (limits_version), llama.cpp (owned_by llamacpp or\n * n_ctx_train meta), LM Studio (organization_owner), Ollama (library or ollama), or unknown. Generic context fields\n * describe capacity, not the server implementation; vLLM is identified separately with its /version response.\n */\nexport function serverKindOf(entry: Record<string, any> | undefined): ServerKind {\n  if (!entry || typeof entry !== \"object\") return \"unknown\";\n  if (typeof entry.limits_version === \"string\" && entry.limits_version.length > 0) return \"gateway\";\n  const owner = typeof entry.owned_by === \"string\" ? entry.owned_by.toLowerCase() : \"\";\n  if (owner === \"llamacpp\" || (entry.meta && typeof entry.meta === \"object\" && \"n_ctx_train\" in entry.meta)) return \"llamacpp\";\n  if (owner === \"organization_owner\") return \"lmstudio\";\n  if (owner === \"library\" || owner === \"ollama\") return \"ollama\";\n  return \"unknown\";\n}\n\n/** The vLLM GET /version contract; capacity fields in a generic model catalog are not identity evidence. */\nexport function parseVllmVersion(body: unknown): string | undefined {\n  if (!body || typeof body !== \"object\" || Array.isArray(body)) return undefined;\n  const version = (body as Record<string, unknown>).version;\n  return typeof version === \"string\" && version.trim().length > 0 ? version.trim() : undefined;\n}\n\n/** The Ollama GET /api/version contract; malformed or empty versions do not identify the endpoint. */\nexport function parseOllamaVersion(body: unknown): string | undefined {\n  if (!body || typeof body !== \"object\" || Array.isArray(body)) return undefined;\n  const version = (body as Record<string, unknown>).version;\n  return typeof version === \"string\" && version.trim().length > 0 ? version.trim() : undefined;\n}\n\nexport function serverKindOfAdvertisement(ad: Advertisement | undefined): ServerKind {\n  if (!ad) return \"unknown\";\n  if (ad.via === \"aihost_gateway\") return \"gateway\";\n  if (ad.via === \"vllm\") return \"vllm\";\n  if (ad.via === \"llamacpp\") return \"llamacpp\";\n  if (ad.via === \"lmstudio\") return \"lmstudio\";\n  if (ad.via === \"ollama\") return \"ollama\";\n  return \"unknown\";\n}\n\n/** Reads one `/models` entry. Unknown shapes yield a catalog advertisement with no limits (never an error). */\nexport function parseAdvertisement(entry: Record<string, any> | undefined): Advertisement | undefined {\n  if (!entry || typeof entry !== \"object\") return undefined;\n  const gateway = typeof entry.limits_version === \"string\" && entry.limits_version.length > 0;\n  const workers = Array.isArray(entry.serving)\n    ? entry.serving.map((s: any) => (typeof s?.worker_id === \"string\" ? s.worker_id : undefined)).filter((w: string | undefined): w is string => Boolean(w)).sort()\n    : undefined;\n  const contextLength = entry.context_length === null ? null : positiveInt(entry.context_length) ?? positiveInt(entry.max_model_len);\n  const reasoning = entry.reasoning && typeof entry.reasoning === \"object\"\n    ? { ...(typeof entry.reasoning.mode === \"string\" ? { mode: entry.reasoning.mode } : {}), ...(positiveInt(entry.reasoning.budget) ? { budget: positiveInt(entry.reasoning.budget) } : {}) }\n    : undefined;\n  return {\n    via: gateway ? \"aihost_gateway\" : contextLength !== undefined ? \"vllm\" : \"catalog\",\n    ...(contextLength !== undefined ? { contextLength } : {}),\n    ...(positiveInt(entry.max_completion_tokens) ? { maxCompletionTokens: positiveInt(entry.max_completion_tokens) } : {}),\n    ...(gateway ? { limitsVersion: entry.limits_version } : {}),\n    ...(reasoning && Object.keys(reasoning).length ? { reasoning } : {}),\n    ...(workers?.length ? { workers } : {}),\n    tokenize: gateway,\n  };\n}\n  max_completion_tokens: 8192,\n  limits_version: \"0123456789abcdef\",\n  reasoning: { budget: 8192, mode: \"off\" },\n  serving: [{ worker_id: \"b0-live-llama-worker1\", pool: \"lead\", role: \"production\", capacity_source: \"observed\" }],\n  capabilities: { tools: { available: false, provenance: \"unavailable\" } },\n};\n\ndescribe(\"advertisements\", () => {\n  test(\"generic context catalogs remain unknown until a vLLM version handshake succeeds\", () => {\n    assert.equal(serverKindOf({ id: \"m\", context_length: 32768 }), \"unknown\");\n    assert.equal(serverKindOf({ id: \"m\", max_model_len: 32768 }), \"unknown\");\n  });\n\n  test(\"the gateway entry is read as a gateway advertisement with request counting\", () => {\n    const ad = parseAdvertisement(gatewayEntry)!;\n    assert.equal(ad.via, \"aihost_gateway\");\n    assert.equal(ad.contextLength, 65536);\n    assert.equal(ad.maxCompletionTokens, 8192);\n    assert.equal(ad.limitsVersion, \"0123456789abcdef\");\n    assert.deepEqual(ad.workers, [\"b0-live-llama-worker1\"]);\n    assert.equal(ad.tokenize, true);\n  });\n\n  test(\"vLLM-style max_model_len is capacity without request counting; a bare catalog advertises nothing\", () => {\n    assert.deepEqual(parseAdvertisement({ id: \"m\", max_model_len: 32768 }), { via: \"vllm\", contextLength: 32768, tokenize: false });\n    assert.deepEqual(parseAdvertisement({ id: \"m\" }), { via: \"catalog\", tokenize: false });\n    assert.equal(parseAdvertisement(undefined), undefined);\n  });\n\n  test(\"a gateway reporting unknown capacity (null) is not a number\", () => {\n    const ad = parseAdvertisement({ ...gatewayEntry, context_length: null, max_model_len: null })!;\n    assert.equal(ad.contextLength, null);\n    const limits = resolveLimits(ad);\n    assert.equal(limits.contextSource, \"client_default\");\n  });\n\n","exit_code":0,"duration":{"secs":1,"nanos":33919346}},"started_at_ms":1793743723924,"completed_at_ms":1793743724958}}
