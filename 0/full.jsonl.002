{"timestamp":"2026-11-03T20:17:22.879Z","ordinal":81020,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"CommandExecution","id":"exec-67bec555-e0c0-4620-9874-19be10460d13","process_id":"65908","command":["/usr/bin/zsh","-lc","sed -n '1,120p' cli/test/client_robustness.test.ts; rg -n \"async discover|serverKind|advertisedCapabilities|serverKindOfAdvertisement|serverContextCache\" cli/src/client.ts | head -55; sed -n '900,1060p' cli/src/client.ts"],"cwd":"file:///home/mike/nexus-wt/v112-wp1101-integration","parsed_cmd":[{"type":"read","cmd":"sed -n '1,120p' cli/test/client_robustness.test.ts","name":"client_robustness.test.ts","path":"cli/test/client_robustness.test.ts"},{"type":"search","cmd":"rg -n 'async discover|serverKind|advertisedCapabilities|serverKindOfAdvertisement|serverContextCache' cli/src/client.ts","query":"async discover|serverKind|advertisedCapabilities|serverKindOfAdvertisement|serverContextCache","path":"client.ts"},{"type":"read","cmd":"sed -n '900,1060p' cli/src/client.ts","name":"client.ts","path":"cli/src/client.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport http from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { LocalLlmClient } from \"../src/client.js\";\n\ntype Handler = (req: http.IncomingMessage, res: http.ServerResponse, body: string) => void;\n\nasync function withServer<T>(handler: Handler, fn: (base: string) => Promise<T>): Promise<T> {\n  const server = http.createServer((req, res) => {\n    let body = \"\";\n    req.on(\"data\", (c) => (body += c));\n    req.on(\"end\", () => handler(req, res, body));\n  });\n  await new Promise<void>((r) => server.listen(0, \"127.0.0.1\", r));\n  try {\n    return await fn(`http://127.0.0.1:${(server.address() as AddressInfo).port}`);\n  } finally {\n    server.closeAllConnections?.();\n    server.close();\n  }\n}\n\nconst json = (res: http.ServerResponse, body: unknown) => {\n  res.setHeader(\"Content-Type\", \"application/json\");\n  res.end(JSON.stringify(body));\n};\n\ntest(\"setModel switches the model in place and keeps the routing hint\", async () => {\n  const seen: { model?: string; taskClass?: string | string[] }[] = [];\n  await withServer(\n    (req, res, body) => {\n      seen.push({ model: JSON.parse(body).model, taskClass: req.headers[\"x-task-class\"] });\n      json(res, { choices: [{ message: { role: \"assistant\", content: \"ok\" }, finish_reason: \"stop\" }] });\n    },\n    async (base) => {\n      const c = new LocalLlmClient({ model: \"a\", endpoint: base, apiKey: \"k\", taskClass: \"review\" } as any);\n      await c.chatCompletion([{ role: \"user\", content: \"x\" }], []);\n      c.setModel(\"b\");\n      await c.chatCompletion([{ role: \"user\", content: \"x\" }], []);\n    },\n  );\n  assert.deepEqual(seen, [\n    { model: \"a\", taskClass: \"review\" },\n    { model: \"b\", taskClass: \"review\" },\n  ]);\n});\n\ntest(\"a tool call cut off by the token limit is rejected, not executed\", async () => {\n  await withServer(\n    (_req, res) =>\n      json(res, {\n        choices: [\n          {\n            finish_reason: \"length\",\n            message: { role: \"assistant\", content: \"\", tool_calls: [{ id: \"1\", type: \"function\", function: { name: \"write_file\", arguments: '{\"path\":\"a.py\",\"content\":\"def f(' } }] },\n          },\n        ],\n      }),\n    async (base) => {\n      const c = new LocalLlmClient({ model: \"m\", endpoint: base, apiKey: \"k\" } as any);\n      await assert.rejects(() => c.chatCompletion([{ role: \"user\", content: \"x\" }], []), /truncated/);\n    },\n  );\n});\n\ntest(\"a truncated plain-text answer is rejected as incomplete, with the partial text preserved for diagnosis\", async () => {\n  // Superseded contract (truthful-turns slice): finish_reason=length means the answer was cut off, so it is\n  // not a complete model response. The partial text stays available on the error for diagnosis.\n  await withServer(\n    (_req, res) => json(res, { choices: [{ finish_reason: \"length\", message: { role: \"assistant\", content: \"partial answer\" } }] }),\n    async (base) => {\n      const c = new LocalLlmClient({ model: \"m\", endpoint: base, apiKey: \"k\" } as any);\n      await assert.rejects(\n        () => c.chatCompletion([{ role: \"user\", content: \"x\" }], []),\n        (e: any) => e.kind === \"output_truncated\" && e.partialText === \"partial answer\",\n      );\n    },\n  );\n});\n\ntest(\"a stalled server fails after the configured request timeout instead of hanging\", async () => {\n  const prev = process.env.LOCAL_LLM_TIMEOUT_MS;\n  process.env.LOCAL_LLM_TIMEOUT_MS = \"300\";\n  try {\n    await withServer(\n      () => {\n        /* never respond */\n      },\n      async (base) => {\n        const c = new LocalLlmClient({ model: \"m\", endpoint: base, apiKey: \"k\" } as any);\n        const t0 = Date.now();\n        await assert.rejects(() => c.chatCompletion([{ role: \"user\", content: \"x\" }], []));\n        assert.ok(Date.now() - t0 < 5000, \"should give up promptly\");\n      },\n    );\n  } finally {\n    if (prev === undefined) delete process.env.LOCAL_LLM_TIMEOUT_MS;\n    else process.env.LOCAL_LLM_TIMEOUT_MS = prev;\n  }\n});\n\ntest(\"streamed tool call cut off by length is rejected\", async () => {\n  await withServer(\n    (_req, res) => {\n      res.setHeader(\"Content-Type\", \"text/event-stream\");\n      res.write(`data: ${JSON.stringify({ choices: [{ delta: { tool_calls: [{ index: 0, id: \"1\", function: { name: \"write_file\", arguments: '{\"path\":\"a' } }] }, finish_reason: null }] })}\\n\\n`);\n      res.write(`data: ${JSON.stringify({ choices: [{ delta: {}, finish_reason: \"length\" }] })}\\n\\n`);\n      res.end(\"data: [DONE]\\n\\n\");\n    },\n    async (base) => {\n      const c = new LocalLlmClient({ model: \"m\", endpoint: base, apiKey: \"k\" } as any);\n      await assert.rejects(() => c.chatCompletionStream([{ role: \"user\", content: \"x\" }], [], () => {}), /truncated/);\n    },\n  );\n});\n\nconst sse = (res: http.ServerResponse, chunks: unknown[]) => {\n  res.setHeader(\"Content-Type\", \"text/event-stream\");\n  for (const c of chunks) res.write(`data: ${JSON.stringify(c)}\\n\\n`);\n6:import { parseAdmissionHeaders, parseAdvertisement, parseServerContext, parseTokenizeResponse, serverKindOf, type AdmissionReport, type Advertisement, type RequestCount, type ServerKind } from \"./core/provider_capabilities.js\";\n810:    const kind = LocalLlmClient.serverKindCache.get(this.endpoint);\n1133:  async discoverAdvertisement(signal?: AbortSignal): Promise<{ state: \"supported\" | \"unsupported\" | \"unavailable\"; advertised?: Advertisement; detail?: string }> {\n1151:      const entryKind = advertised?.serverKind ?? serverKindOf(entry);\n1152:      LocalLlmClient.serverKindCache.set(ep, entryKind);\n1158:          if (local.serverKind) LocalLlmClient.serverKindCache.set(ep, local.serverKind);\n1170:  private static serverContextCache = new Map<string, Advertisement>();\n1171:  private static serverKindCache = new Map<string, ServerKind>();\n1179:  private async discoverServerContext(entry: Record<string, any>, signal?: AbortSignal): Promise<Advertisement | undefined> {\n1180:    const kind = serverKindOf(entry);\n1183:    const cached = LocalLlmClient.serverContextCache.get(cacheKey);\n1202:          LocalLlmClient.serverContextCache.set(cacheKey, found);\n1227:    const kind = LocalLlmClient.serverKindCache.get(ep);\n    try {\n      return await run();\n    } catch (err) {\n      if (this.conn.auth !== \"oauth\" || !(err instanceof InferenceError) || err.httpStatus !== 401) throw err;\n      await this.prepareCredential(url, requestId, true);\n      return run();\n    }\n  }\n\n  /** Headers a provider requires that depend on the request (sign-in account, Copilot editor identity). */\n  private providerHeaders(messages: ChatMessage[]): Record<string, string> {\n    if (this.conn.providerId === \"chatgpt\") return this.oauthAccountId ? { \"chatgpt-account-id\": this.oauthAccountId } : {};\n    if (this.conn.providerId === \"copilot\") {\n      return { ...COPILOT_HEADERS, \"X-Initiator\": messages.some((m) => m.role === \"assistant\") ? \"agent\" : \"user\" };\n    }\n    return {};\n  }\n\n  private createWatchdog(operatorSignal?: AbortSignal, currentEp?: string): StreamWatchdog {\n    const disclosure = this.disclosureOf(currentEp ?? this.endpoint);\n    const parseNum = (k: string) => {\n      const raw = process.env[k];\n      if (raw === undefined || raw === \"\") return undefined;\n      const v = Number(raw);\n      return Number.isFinite(v) && v >= 0 ? v : undefined;\n    };\n    const firstByteMs = parseNum(\"LOCAL_LLM_FIRST_BYTE_TIMEOUT_MS\") ?? 120_000;\n    const idleMs = parseNum(\"LOCAL_LLM_IDLE_TIMEOUT_MS\") ?? 120_000;\n    const defaultTotal = disclosure === \"cloud\" ? 900_000 : 0;\n    const totalMs = parseNum(\"LOCAL_LLM_TIMEOUT_MS\") ?? defaultTotal;\n    return new StreamWatchdog(firstByteMs, idleMs, totalMs, operatorSignal);\n  }\n\n  public setTaskId(taskId?: string): void {\n    this.taskId = taskId;\n  }\n\n  public getTaskId(): string | undefined {\n    return this.taskId;\n  }\n\n  public setSessionId(sessionId?: string): void {\n    this.sessionId = sessionId;\n  }\n\n  public getSessionId(): string | undefined {\n    return this.sessionId;\n  }\n\n  public getBoundary(): InformationFlowBoundary {\n    return this.boundary;\n  }\n\n  public setBoundary(boundary: InformationFlowBoundary): void {\n    this.boundary = boundary;\n  }\n\n  public get endpoint(): string {\n    return this.endpoints[this.activeEndpointIndex] || this.endpoints[0];\n  }\n\n  public getActiveEndpoint(): string {\n    return this.endpoint;\n  }\n\n  public getEndpoints(): string[] {\n    return [...this.endpoints];\n  }\n\n  public addFallbackEndpoint(endpoint: string): void {\n    // A provider connection is pinned to its own endpoint: task content never fails over elsewhere (PRV-13).\n    if (this.conn.providerId) return;\n    let ep = endpoint.trim().replace(/\\/+$/, \"\");\n    if (!ep.endsWith(\"/v1\")) {\n      ep = `${ep}/v1`;\n    }\n    if (!this.endpoints.includes(ep)) {\n      this.endpoints.push(ep);\n    }\n  }\n\n  /** Sets the key for the active endpoint's origin. */\n  public setApiKey(key: string): void {\n    this.explicitKey = key;\n    this.explicitOrigin = originOf(this.endpoints[this.activeEndpointIndex]);\n    if (this.explicitOrigin) this.rotated.delete(this.explicitOrigin);\n  }\n\n  /** The credential sent to `url`: its own explicit key, else its gateway's stored credential, else none. */\n  private credentialFor(url: string): string | undefined {\n    const origin = originOf(url);\n    if (!origin) return undefined;\n    if (this.explicitKey && this.explicitOrigin === origin && !this.rotated.has(origin)) return this.explicitKey;\n    // A provider connection uses only its own key: never the appliance's stored token or any other credential.\n    if (this.conn.providerId) return undefined;\n    if (!this.storedKeys.has(origin)) this.storedKeys.set(origin, storedCredentialFor(url));\n    return this.storedKeys.get(origin) ?? undefined;\n  }\n\n  private authorization(url: string): Record<string, string> {\n    if (!this.conn.providerId) return { Authorization: `Bearer ${this.credentialFor(url) ?? \"not-needed\"}` };\n    const key = this.credentialFor(url);\n    const auth: Record<string, string> = !key ? {} : this.conn.auth === \"x-api-key\" ? { \"x-api-key\": key } : { Authorization: `Bearer ${key}` };\n    if (this.conn.providerId === \"copilot\") Object.assign(auth, COPILOT_HEADERS);\n    return { ...this.conn.staticHeaders, ...auth };\n  }\n\n  /** Requests stay on the explicitly configured destination; fetch must never forward credentials across redirects. */\n  private fetchPolicy(): { redirect?: \"error\" } {\n    return { redirect: \"error\" };\n  }\n\n  /** After a 401 from `url`: re-read that gateway's stored credential (rotation). Never borrows another provider's. */\n  public reloadAuthToken(url: string = this.endpoints[this.activeEndpointIndex]): boolean {\n    if (!this.allowCredentialReload) return false;\n    const origin = originOf(url);\n    if (!origin || this.conn.providerId) return false;\n    const fresh = storedCredentialFor(url);\n    if (!fresh || fresh === this.credentialFor(url)) return false;\n    this.storedKeys.set(origin, fresh);\n    this.rotated.add(origin);\n    return true;\n  }\n\n  private async executeWithFailover<T>(\n    operationName: string,\n    operation: (endpoint: string) => Promise<T>\n  ): Promise<T> {\n    const total = this.endpoints.length;\n    let lastError: Error | null = null;\n\n    for (let attempt = 0; attempt < total; attempt++) {\n      const idx = (this.activeEndpointIndex + attempt) % total;\n      const currentEp = this.endpoints[idx];\n      // An endpoint not authorized for cloud disclosure is never tried; a fallback never widens disclosure.\n      const denial = this.disclosureDenial(currentEp);\n      if (denial) {\n        lastError = lastError ?? denial;\n        continue;\n      }\n\n      try {\n        const result = await operation(currentEp);\n        if (idx !== this.activeEndpointIndex) {\n          this.emitDiagnostic(\"warn\",\n            pc.yellow(`\\n⚡ Failover: Active inference endpoint switched to ${currentEp}`)\n          );\n          this.activeEndpointIndex = idx;\n        }\n        return result;\n      } catch (err: any) {\n        lastError = err;\n        if (err instanceof InferenceError && !err.failoverEligible) throw err;\n        if (total > 1 && attempt < total - 1) {\n          const nextIdx = (idx + 1) % total;\n          this.emitDiagnostic(\"warn\",\n            pc.dim(\n              `⚠️ [Failover] ${operationName} failed on ${currentEp} (${err.message}). Trying backup endpoint ${this.endpoints[nextIdx]}...`\n            )\n          );\n        }\n","exit_code":0,"duration":{"secs":0,"nanos":643471716}},"started_at_ms":1793737042235,"completed_at_ms":1793737042879}}
{"timestamp":"2026-11-03T20:17:24.134Z","ordinal":81021,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1a30f-30a6-74b2-a940-0138c2f1cb45","call_id":"call_f0bece0cccec42d68d91504db3c45301","output":[{"type":"input_text","text":"Script completed\nWall time 3.3 seconds\nOutput:\n"},{"type":"input_text","text":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport http from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { LocalLlmClient } from \"../src/client.js\";\n\ntype Handler = (req: http.IncomingMessage, res: http.ServerResponse, body: string) => void;\n\nasync function withServer<T>(handler: Handler, fn: (base: string) => Promise<T>): Promise<T> {\n  const server = http.createServer((req, res) => {\n    let body = \"\";\n    req.on(\"data\", (c) => (body += c));\n    req.on(\"end\", () => handler(req, res, body));\n  });\n  await new Promise<void>((r) => server.listen(0, \"127.0.0.1\", r));\n  try {\n    return await fn(`http://127.0.0.1:${(server.address() as AddressInfo).port}`);\n  } finally {\n    server.closeAllConnections?.();\n    server.close();\n  }\n}\n\nconst json = (res: http.ServerResponse, body: unknown) => {\n  res.setHeader(\"Content-Type\", \"application/json\");\n  res.end(JSON.stringify(body));\n};\n\ntest(\"setModel switches the model in place and keeps the routing hint\", async () => {\n  const seen: { model?: string; taskClass?: string | string[] }[] = [];\n  await withServer(\n    (req, res, body) => {\n      seen.push({ model: JSON.parse(body).model, taskClass: req.headers[\"x-task-class\"] });\n      json(res, { choices: [{ message: { role: \"assistant\", content: \"ok\" }, finish_reason: \"stop\" }] });\n    },\n    async (base) => {\n      const c = new LocalLlmClient({ model: \"a\", endpoint: base, apiKey: \"k\", taskClass: \"review\" } as any);\n      await c.chatCompletion([{ role: \"user\", content: \"x\" }], []);\n      c.setModel(\"b\");\n      await c.chatCompletion([{ role: \"user\", content: \"x\" }], []);\n    },\n  );\n  assert.deepEqual(seen, [\n    { model: \"a\", taskClass: \"review\" },\n    { model: \"b\", taskClass: \"review\" },\n  ]);\n});\n\ntest(\"a tool call cut off by the token limit is rejected, not executed\", async () => {\n  await withServer(\n    (_req, res) =>\n      json(res, {\n        choices: [\n          {\n            finish_reason: \"length\",\n            message: { role: \"assistant\", content: \"\", tool_calls: [{ id: \"1\", type: \"function\", function: { name: \"write_file\", arguments: '{\"path\":\"a.py\",\"content\":\"def f(' } }] },\n          },\n        ],\n      }),\n    async (base) => {\n      const c = new LocalLlmClient({ model: \"m\", endpoint: base, apiKey: \"k\" } as any);\n      await assert.rejects(() => c.chatCompletion([{ role: \"user\", content: \"x\" }], []), /truncated/);\n    },\n  );\n});\n\ntest(\"a truncated plain-text answer is rejected as incomplete, with the partial text preserved for diagnosis\", async () => {\n  // Superseded contract (truthful-turns slice): finish_reason=length means the answer was cut off, so it is\n  // not a complete model response. The partial text stays available on the error for diagnosis.\n  await withServer(\n    (_req, res) => json(res, { choices: [{ finish_reason: \"length\", message: { role: \"assistant\", content: \"partial answer\" } }] }),\n    async (base) => {\n      const c = new LocalLlmClient({ model: \"m\", endpoint: base, apiKey: \"k\" } as any);\n      await assert.rejects(\n        () => c.chatCompletion([{ role: \"user\", content: \"x\" }], []),\n        (e: any) => e.kind === \"output_truncated\" && e.partialText === \"partial answer\",\n      );\n    },\n  );\n});\n\ntest(\"a stalled server fails after the configured request timeout instead of hanging\", async () => {\n  const prev = process.env.LOCAL_LLM_TIMEOUT_MS;\n  process.env.LOCAL_LLM_TIMEOUT_MS = \"300\";\n  try {\n    await withServer(\n      () => {\n        /* never respond */\n      },\n      async (base) => {\n        const c = new LocalLlmClient({ model: \"m\", endpoint: base, apiKey: \"k\" } as any);\n        const t0 = Date.now();\n        await assert.rejects(() => c.chatCompletion([{ role: \"user\", content: \"x\" }], []));\n        assert.ok(Date.now() - t0 < 5000, \"should give up promptly\");\n      },\n    );\n  } finally {\n    if (prev === undefined) delete process.env.LOCAL_LLM_TIMEOUT_MS;\n    else process.env.LOCAL_LLM_TIMEOUT_MS = prev;\n  }\n});\n\ntest(\"streamed tool call cut off by length is rejected\", async () => {\n  await withServer(\n    (_req, res) => {\n      res.setHeader(\"Content-Type\", \"text/event-stream\");\n      res.write(`data: ${JSON.stringify({ choices: [{ delta: { tool_calls: [{ index: 0, id: \"1\", function: { name: \"write_file\", arguments: '{\"path\":\"a' } }] }, finish_reason: null }] })}\\n\\n`);\n      res.write(`data: ${JSON.stringify({ choices: [{ delta: {}, finish_reason: \"length\" }] })}\\n\\n`);\n      res.end(\"data: [DONE]\\n\\n\");\n    },\n    async (base) => {\n      const c = new LocalLlmClient({ model: \"m\", endpoint: base, apiKey: \"k\" } as any);\n      await assert.rejects(() => c.chatCompletionStream([{ role: \"user\", content: \"x\" }], [], () => {}), /truncated/);\n    },\n  );\n});\n\nconst sse = (res: http.ServerResponse, chunks: unknown[]) => {\n  res.setHeader(\"Content-Type\", \"text/event-stream\");\n  for (const c of chunks) res.write(`data: ${JSON.stringify(c)}\\n\\n`);\n6:import { parseAdmissionHeaders, parseAdvertisement, parseServerContext, parseTokenizeResponse, serverKindOf, type AdmissionReport, type Advertisement, type RequestCount, type ServerKind } from \"./core/provider_capabilities.js\";\n810:    const kind = LocalLlmClient.serverKindCache.get(this.endpoint);\n1133:  async discoverAdvertisement(signal?: AbortSignal): Promise<{ state: \"supported\" | \"unsupported\" | \"unavailable\"; advertised?: Advertisement