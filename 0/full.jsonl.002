itions/orchestration.js\";\nimport { activateSkillCapability } from \"./capability_definitions/skill.js\";\nimport {\n  lspHoverCapability,\n  lspDefinitionCapability,\n  lspDiagnosticsCapability,\n} from \"./capability_definitions/lsp.js\";\nimport {\n  gitStatusCapability,\n  gitDiffCapability,\n  gitLogCapability,\n} from \"./capability_definitions/vcs.js\";\nimport {\n  browserNavigateCapability,\n  browserScreenshotCapability,\n  browserClickCapability,\n  browserTypeCapability,\n  browserConsoleLogsCapability,\n} from \"./capability_definitions/browser.js\";\nimport { manageKnowledgeCapability } from \"./capability_definitions/knowledge.js\";\n\n1808:    registerBridgeCapabilities(registry, this);\n1812:export function registerBridgeCapabilities(\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a205e5-07d1-72b3-b0a4-db59d82d43bb","create_time":1795395526.509578}},"metadata":{"history_sequence":30362,"sampled_through_sequence":30359,"client_authored":false,"fallback_token_limit_override":12000}}
