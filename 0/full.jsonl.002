   path = os.path.join(fixture, name)\n    with open(path, \"wb\") as f: f.write(body)\n    future = time.time() + 120\n    os.utime(path, (future, future))\nnon_v100 = run_cell(\"v1.0.1-rc.1\", os.path.join(fixture, \"approval.png\") + \"\\n\" + os.path.join(fixture, \"post-exit.png\") + \"\\n\")\nif \"Screenshots are required for v1.0.1-rc.1\" not in non_v100:\n    raise SystemExit(\"non-v1.0.0 runner did not retain required screenshot behavior\")\nrecords = sorted(glob.glob(os.path.join(out, \"cell-xterm-80x24.attempt-*.json\")))\nif len(records) != 2:\n    raise SystemExit(f\"expected two synthetic runner records, found {len(records)}\")\nv100_record = json.load(open(records[0], encoding=\"utf-8\"))\nif set(v100_record[\"files\"]) != {\"mockLog\", \"answers\", \"exits\"}:\n    raise SystemExit(f\"v1.0.0 record unexpectedly requires screenshots: {sorted(v100_record['files'])}\")\nnon_v100_record = json.load(open(records[1], encoding=\"utf-8\"))\nif not {\"approvalScreenshot\", \"postExitScreenshot\"}.issubset(non_v100_record[\"files\"]):\n    raise SystemExit(\"non-v1.0.0 record did not retain both required screenshot artifacts\")\nPY\n\necho \"scope measurement fixtures passed\"\n205abeed3aba7f71b260c7a9443bb170dabf2f1a117f759a9ca27d47483963e0  /tmp/wp1107-task-class-red.log\n872fd5f44236fea722a05a46eda67a93848b42424533e5f38c8159bb9730f72b  /tmp/wp1107-task-class-green.log\n3529433705023b050d4e7228912f283ca286a972be86de15303fd96054c1c932  /tmp/wp1107-build-final6.log\n0d000bd655d8069b44dcc1e34003b1fc1e445c983844a8f5c1007224d6b74c21  /tmp/wp1107-snapshot-build-final7.log\n0d3962c5cde8459813833214082bfd095cbcb702ca197bf0e7805630b3ba1331  /tmp/wp1107-full-gate-final6.log\n3:**Status as of 2026-11-03: RC2 source and installed-package gates passed for the recorded candidate, but WP-1107 provider integration is incomplete; provider-matrix, external CI/CodeQL, and publication gates remain open.**\n6:The v1.1.0 release failed and published no release files. v1.1.1 is the immutable published predecessor. The earlier RC1 package archive and the first local RC2 packaging attempt are superseded and are not eligible for release. The qualified local RC2 archive is not published; its checksum, installer, and installed-package evidence are recorded below. The installer test used a local HTTP feed and skipped GitHub provenance-attestation verification because this candidate is unpublished. Since WP-1107 is not connected to a provider request path on this source commit, this RC2 artifact is historical qualification evidence and is not the final release candidate.\n32:| WP-1107 — GBNF tool grammar | Generate tool-schema grammars and integrate supported provider paths. | Commit `1518780d` adds a bounded schema compiler and four generator tests, but the generator has no callsite in client/provider request construction on `e134dcd5`. No GBNF, `guided_json`, or Ollama schema field is sent. The user-approved full v1.1.0 scope supersedes the older deferral in `ROADMAP-REVIEW.md` §2.5. | **INCOMPLETE — provider integration required** | Existing `cli/test/tool_grammar.test.ts` checks generation only (4/4). Provider request tests and G1.1-4 endpoint measurements are still required. |\n42:| G1.1-4 — Constrained decoding | At least 99.5% valid tool-call JSON across supported provider endpoints. | The generator is not connected to any client/provider request path on `e134dcd5`; its unit tests do not demonstrate constrained decoding. The shared `GATEWAY` claim remains held by another release stream, so no endpoint metric has been collected. | **IMPLEMENTATION INCOMPLETE; PROVIDER MATRIX PENDING** |\n86:- [ ] WP-1107 provider-specific request integration and request-shape tests pass on the final source candidate.\n","exit_code":0,"duration":{"secs":0,"nanos":692175892}},"started_at_ms":1793754569553,"completed_at_ms":1793754570246}}
