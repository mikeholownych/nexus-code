n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /home/mike/nexus-wt/context-maturity-v130/cli/test/context_inventory.test.ts\n","stderr":""},"started_at_ms":1795398360344,"completed_at_ms":1795398360347}}
