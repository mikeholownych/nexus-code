{"timestamp":"2026-11-23T01:46:25.119Z","ordinal":70401,"type":"token_usage_record","payload":{"thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20602-56e4-7401-a61d-85bcc9f8019b","session_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","root_turn_id":"01a20602-56e4-7401-a61d-85bcc9f8019b","response_id":"resp_0f4fd85789ec756b016b039aeef11887d297929dfea2961982","usage":{"input_tokens":119645,"cached_input_tokens":118784,"cache_write_input_tokens":0,"output_tokens":89,"reasoning_output_tokens":0,"total_tokens":119734},"turn_token_usage":{"input_tokens":15383311,"cached_input_tokens":15171968,"cache_write_input_tokens":0,"output_tokens":49750,"reasoning_output_tokens":27707,"total_tokens":15433061},"thread_token_usage":{"input_tokens":1486594024,"cached_input_tokens":1474080384,"cache_write_input_tokens":0,"output_tokens":2652751,"reasoning_output_tokens":1327644,"total_tokens":1489246775}}}
{"timestamp":"2026-11-23T01:46:26.874Z","ordinal":70402,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20602-56e4-7401-a61d-85bcc9f8019b","item":{"type":"CommandExecution","id":"exec-80397bcc-3f3e-4488-9dbd-829f35c1760e","process_id":"54054","command":["/usr/bin/zsh","-lc","rg -n \"type SizingSource\" cli/src/core/provider_capabilities.ts && sed -n '155,210p' cli/src/core/provider_capabilities.ts"],"cwd":"file:///home/mike/nexus-wt/context-maturity-v130","parsed_cmd":[{"type":"search","cmd":"rg -n 'type SizingSource' cli/src/core/provider_capabilities.ts","query":"type SizingSource","path":"provider_capabilities.ts"},{"type":"read","cmd":"sed -n '155,210p' cli/src/core/provider_capabilities.ts","name":"provider_capabilities.ts","path":"cli/src/core/provider_capabilities.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"24:export type SizingSource = \"advertised\" | \"operator\" | \"operator_capped_by_advertised\" | \"snapshot\" | \"client_default\";\n/**\n * The context and output limits in effect, and where each came from. `operatorContext` / `operatorOutput` are values\n * the operator set explicitly (undefined otherwise).\n */\nexport function resolveLimits(\n  advertised: Advertisement | undefined,\n  operatorContext?: number,\n  operatorOutput?: number,\n  /** The bundled or refreshed model data (models.dev): below advertised capacity and the operator's setting, above the client default. */\n  reference?: { context?: number; output?: number },\n): Pick<ProviderCapabilities, \"contextLimit\" | \"contextSource\" | \"outputAllowance\" | \"outputSource\"> {\n  const adCtx = typeof advertised?.contextLength === \"number\" ? advertised.contextLength : undefined;\n  let contextLimit: number;\n  let contextSource: SizingSource;\n  if (adCtx !== undefined && operatorContext !== undefined) {\n    contextLimit = Math.min(adCtx, operatorContext);\n    contextSource = operatorContext <= adCtx ? \"operator\" : \"operator_capped_by_advertised\";\n  } else if (adCtx !== undefined) {\n    contextLimit = adCtx;\n    contextSource = \"advertised\";\n  } else if (operatorContext !== undefined) {\n    contextLimit = operatorContext;\n    contextSource = \"operator\";\n  } else if (reference?.context && reference.context > 0) {\n    contextLimit = reference.context;\n    contextSource = \"snapshot\";\n  } else {\n    contextLimit = CLIENT_DEFAULT_CONTEXT;\n    contextSource = \"client_default\";\n  }\n  const adOut = advertised?.maxCompletionTokens;\n  let outputAllowance: number;\n  let outputSource: SizingSource;\n  if (adOut !== undefined && operatorOutput !== undefined) {\n    outputAllowance = Math.min(adOut, operatorOutput);\n    outputSource = operatorOutput <= adOut ? \"operator\" : \"operator_capped_by_advertised\";\n  } else if (adOut !== undefined) {\n    outputAllowance = adOut;\n    outputSource = \"advertised\";\n  } else if (operatorOutput !== undefined) {\n    outputAllowance = operatorOutput;\n    outputSource = \"operator\";\n  } else if (reference?.output && reference.output > 0) {\n    outputAllowance = reference.output;\n    outputSource = \"snapshot\";\n  } else {\n    outputAllowance = Math.min(CLIENT_DEFAULT_OUTPUT, Math.floor(contextLimit / 4));\n    outputSource = \"client_default\";\n  }\n  // An output allowance can never take the whole window.\n  outputAllowance = Math.max(1, Math.min(outputAllowance, Math.floor(contextLimit / 2)));\n  return { contextLimit, contextSource, outputAllowance, outputSource };\n}\n\n/** Whether a new advertisement changes what was in effect (model, limits version, workers or capacity). */\nexport function advertisementChanged(before: Advertisement | undefined, after: Advertisement | undefined): boolean {\n","exit_code":0,"duration":{"secs":1,"nanos":426096647}},"started_at_ms":1795398385443,"completed_at_ms":1795398386870}}
{"timestamp":"2026-11-23T01:46:27.065Z","ordinal":70403,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a20615-4579-7a92-9dd9-95cf83fc4174","call_id":"call_64b2abd226c545f9b10ece4cf290d1bc","output":[{"type":"input_text","text":"Script completed\nWall time 1.9 seconds\nOutput:\n"},{"type":"input_text","text":"24:export type SizingSource = \"advertised\" | \"operator\" | \"operator_capped_by_advertised\" | \"snapshot\" | \"client_default\";\n/**\n * The context and output limits in effect, and where each came from. `operatorContext` / `operatorOutput` are values\n * the operator set explicitly (undefined otherwise).\n */\nexport function resolveLimits(\n  advertised: Advertisement | undefined,\n  operatorContext?: number,\n  operatorOutput?: number,\n  /** The bundled or refreshed model data (models.dev): below advertised capacity and the operator's setting, above the client default. */\n  reference?: { context?: number; output?: number },\n): Pick<ProviderCapabilities, \"contextLimit\" | \"contextSource\" | \"outputAllowance\" | \"outputSource\"> {\n  const adCtx = typeof advertised?.contextLength === \"number\" ? advertised.contextLength : undefined;\n  let contextLimit: number;\n  let contextSource: SizingSource;\n  if (adCtx !== undefined && operatorContext !== undefined) {\n    contextLimit = Math.min(adCtx, operatorContext);\n    contextSource = operatorContext <= adCtx ? \"operator\" : \"operator_capped_by_advertised\";\n  } else if (adCtx !== undefined) {\n    contextLimit = adCtx;\n    contextSource = \"advertised\";\n  } else if (operatorContext !== undefined) {\n    contextLimit = operatorContext;\n    contextSource = \"operator\";\n  } else if (reference?.context && reference.context > 0) {\n    contextLimit = reference.context;\n    contextSource = \"snapshot\";\n  } else {\n    contextLimit = CLIENT_DEFAULT_CONTEXT;\n    contextSource = \"client_default\";\n  }\n  const adOut = advertised?.maxCompletionTokens;\n  let outputAllowance: number;\n  let outputSource: SizingSource;\n  if (adOut !== undefined && operatorOutput !== undefined) {\n    outputAllowance = Math.min(adOut, operatorOutput);\n    outputSource = operatorOutput <= adOut ? \"operator\" : \"operator_capped_by_advertised\";\n  } else if (adOut !== undefined) {\n    outputAllowance = adOut;\n    outputSource = \"advertised\";\n  } else if (operatorOutput !== undefined) {\n    outputAllowance = operatorOutput;\n    outputSource = \"operator\";\n  } else if (reference?.output && reference.output > 0) {\n    outputAllowance = reference.output;\n    outputSource = \"snapshot\";\n  } else {\n    outputAllowance = Math.min(CLIENT_DEFAULT_OUTPUT, Math.floor(contextLimit / 4));\n    outputSource = \"client_default\";\n  }\n  // An output allowance can never take the whole window.\n  outputAllowance = Math.max(1, Math.min(outputAllowance, Math.floor(contextLimit / 2)));\n  return { contextLimit, contextSource, outputAllowance, outputSource };\n}\n\n/** Whether a new advertisement changes what was in effect (model, limits version, workers or capacity). */\nexport function advertisementChanged(before: Advertisement | undefined, after: Advertisement | undefined): boolean {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20602-56e4-7401-a61d-85bcc9f8019b","create_time":1795398387.0656545}},"metadata":{"history_sequence":31156,"sampled_through_sequence":31154,"client_authored":false,"fallback_token_limit_override":12000}}
