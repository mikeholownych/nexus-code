ummarize.mjs \"$OUT\" --rc <rc> --manifest-sha256 \"$MANIFEST_SHA\" [--dispositions dispositions.json]\nscripts/terminal-acceptance/README.md:72:- every attempt names the given RC, and its installed package manifest equals the archive's;\ncli/test/install_durability.test.ts:8:// repoints a working launcher, so the extracted package must be flushed before it\ncli/test/install_durability.test.ts:12:const lines = fs.readFileSync(path.join(root, \"install.sh\"), \"utf8\").split(\"\\n\").map((line) => line.trim());\ncli/test/install_durability.test.ts:16:  assert.ok(index >= 0, `install.sh contains: ${statement}`);\ncli/test/install_durability.test.ts:21:test(\"installer flushes the extracted package before it replaces the installed version\", () => {\ncli/test/install_durability.test.ts:25:test(\"installer flushes the package move before and the launcher switch after repointing\", () => {\ncli/test/review_unit_boundary.test.ts:43:test(\"review roles are reviewer and acceptance_reviewer only\", () => {\ncli/test/review_unit_boundary.test.ts:45:  assert.equal(isReviewRole(\"acceptance_reviewer\"), true);\ncli/test/review_unit_boundary.test.ts:143:test(\"a failed or test-less dependency verification reaches the package as a non-zero exit code and blocks ACCEPT\", () => {\ncli/test/review_unit_boundary.test.ts:164:test(\"the runtime package carries the real operation id and declares no scope it does not have\", () => {\nscripts/terminal-acceptance/test-scope-procs.sh:116:      packageManifestSha256: \"a\".repeat(64),\nscripts/terminal-acceptance/test-scope-procs.sh:161:# Drive the actual manual runner in a PTY with a synthetic installed package to prove that\nscripts/terminal-acceptance/test-scope-procs.sh:165:mkdir -p \"$runner/package/bin\" \"$runner/bin\" \"$runner/out\"\nscripts/terminal-acceptance/test-scope-procs.sh:166:cat > \"$runner/package/VERSION\" <<'EOF'\nscripts/terminal-acceptance/test-scope-procs.sh:169:cat > \"$runner/package/bin/nexus\" <<'EOF'\nscripts/terminal-acceptance/test-scope-procs.sh:171:package=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\nscripts/terminal-acceptance/test-scope-procs.sh:172:version=\"$(cat \"$package/VERSION\")\"\nscripts/terminal-acceptance/test-scope-procs.sh:177:chmod +x \"$runner/package/bin/nexus\"\nscripts/terminal-acceptance/test-scope-procs.sh:178:(cd \"$runner/package\" && sha256sum VERSION bin/nexus > MANIFEST.sha256)\nscripts/terminal-acceptance/test-scope-procs.sh:207:    \"PATH\": os.path.join(fixture, \"package\", \"bin\") + os.pathsep + os.path.join(fixture, \"bin\") + os.pathsep + env[\"PATH\"],\nscripts/terminal-acceptance/test-scope-procs.sh:212:def update_package_version(version):\nscripts/terminal-acceptance/test-scope-procs.sh:213:    package = os.path.join(fixture, \"package\")\nscripts/terminal-acceptance/test-scope-procs.sh:214:    with open(os.path.join(package, \"VERSION\"), \"w\", encoding=\"utf-8\") as f: f.write(version + \"\\n\")\nscripts/terminal-acceptance/test-scope-procs.sh:216:    with open(os.path.join(package, \"MANIFEST.sha256\"), \"w\", encoding=\"utf-8\") as f:\nscripts/terminal-acceptance/test-scope-procs.sh:218:            with open(os.path.join(package, relative), \"rb\") as source:\nscripts/terminal-acceptance/test-scope-procs.sh:223:    update_package_version(version)\ncli/test/tui_surface_e2e.test.ts:97:    \"package.json\": JSON.stringify({ name: \"demo\", version: \"1.0.0\", scripts: { test: \"node -e \\\"if (require('fs').existsSync('parser.js')) { console.error('parser test failed: expected 3 tokens, got 2'); process.exit(1) }\\\"\" } }, null, 2) + \"\\n\",\ncli/test/tui_surface_e2e.test.ts:152:    // Assertions are added with the acceptance matrix (see docs/reviews/NEXUS_TUI_SURFACE_2026-10-12.md).\nscripts/terminal-acceptance/run-cell.sh:3:# to the cell. It verifies the installed RC package and the terminal, launches the TUI against a deterministic local\nscripts/terminal-acceptance/run-cell.sh:9:#   scripts/terminal-acceptance/run-cell.sh --rc v1.0.0-rc.N --terminal <xterm|kitty|tmux-gnome|vscode|gnome> \\\nscripts/terminal-acceptance/run-cell.sh:32:# Identity: the installed RC package (VERSION and its own MANIFEST.sha256), never a checkout build.\nscripts/terminal-acceptance/run-cell.sh:35:package=\"$(dirname \"$(dirname \"$nexus_real\")\")\"\nscripts/terminal-acceptance/run-cell.sh:36:[[ \"$(cat \"$package/VERSION\" 2>/dev/null)\" == \"$rc\" ]] || { echo \"nexus resolves to $nexus_real, which is not an installed $rc package\" >&2; exit 2; }\nscripts/terminal-acceptance/run-cell.sh:37:(cd \"$package\" && sha256sum --check --status MANIFEST.sha256) || { echo \"installed package at $package fails its MANIFEST.sha256\" >&2; exit 2; }\nscripts/terminal-acceptance/run-cell.sh:38:# The manifest must also list every file: an extra file in the package would pass sha256sum --check.\nscripts/terminal-acceptance/run-cell.sh:39:diff <(cd \"$package\" && find . -type f ! -name MANIFEST.sha256 | sed 's|^\\./||' | LC_ALL=C sort) \\\nscripts/terminal-acceptance/run-cell.sh:40:     <(sed -E 's/^[0-9a-f]{64} [ *]//; s|^\\./||' \"$package/MANIFEST.sha256\" | LC_ALL=C sort) >/dev/null \\\nscripts/terminal-acceptance/run-cell.sh:41:  || { echo \"installed package at $package has files its MANIFEST.sha256 does not list\" >&2; exit 2; }\nscripts/terminal-acceptance/run-cell.sh:42:manifest_sha=\"$(sha256sum \"$package/MANIFEST.sha256\" | cut -d' ' -f1)\"\nscripts/terminal-acceptance/run-cell.sh:142:=== Cell $cell, attempt $attempt ($rc, package $package) ===\nscripts/terminal-acceptance/run-cell.sh:202:NEXUS_PATH=\"$nexus_real\" PACKAGE_DIR=\"$package\" MANIFEST_SHA=\"$manifest_sha\" TMUX_VERSION=\"$tmux_version\" \\\nscripts/terminal-acceptance/run-cell.sh:232:    \"acceptance\": \"ACCEPTANCE §5.3\", \"cell\": e[\"CELL\"], \"attempt\": int(e[\"ATTEMPT\"]), \"terminal\": e[\"TERMINAL_NAME\"], \"size\": e[\"CELL_SIZE\"],\nscripts/terminal-acceptance/run-cell.sh:233:    \"rc\": e[\"RC\"], \"nexusVersion\": e[\"NEXUS_VERSION_LI