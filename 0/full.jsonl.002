nt: cutResponseNotice(guard.step, seconds) }] : messages;\n3410:  private admitContext(step: number, requestId: string): string[] {\n3413:    const original = this.messages;\n3436:                (pressureCompactionAllowed && isContextPressureHigh(this.requestMessages(original), this.getEffectiveTools(), contextLimit, 80, reserves.completion, reserves.toolResponse, 1000)))\n3447:      const accept = (candidate: { messages: ChatMessage[]; removedObservations: string[] }, truncatedUnseen = false): boolean => {\n3448:        const candidateBudget = this.scaledBudget(candidate.messages, contextLimit);\n3450:        this.messages = candidate.messages;\n3455:          console.log(`[context_admission] step=${step} request_id=${requestId} state=auto_compacted attempts=${compactionAttempts} estimated_tokens=${budget.totalActiveTokens} completion_reserve=${reserves.completion} tool_response_reserve=${reserves.toolResponse} limit=${contextLimit} compacted=${compacted} messages=${this.messages.length}${truncatedUnseen ? \" unseen_output=truncated\" : \"\"}`);\n3467:            const room = contextLimit - reserves.completion - reserves.toolResponse - this.scaledBudget(floor.messages, contextLimit).totalActiveTokens;\n3485:        budget = this.scaledBudget(this.messages, contextLimit);\n3492:    // Step 0 is the /compact --llm summary request, whose prompt is a copy of messages compactConversation archives.\n3494:    if (this.messages !== original && step > 0) {\n3499:      if (!process.stdout.isTTY || process.env.NEXUS_DEBUG === \"1\") console.log(`[context_admission] step=${step} request_id=${requestId} state=blocked estimated_tokens=${budget.totalActiveTokens} completion_reserve=${reserves.completion} tool_response_reserve=${reserves.toolResponse} limit=${contextLimit} compacted=${compacted} messages=${this.messages.length}`);\n3504:    this.assertLedgerRetained(this.messages);\n3506:    if (!process.stdout.isTTY || process.env.NEXUS_DEBUG === \"1\") console.log(`[context_admission] step=${step} request_id=${requestId} state=admitted estimated_tokens=${budget.totalActiveTokens} completion_reserve=${reserves.completion} tool_response_reserve=${reserves.toolResponse} limit=${contextLimit} compacted=${compacted} messages=${this.messages.length}`);\n3518:   * messages; after 3, everything agrees. Nothing is replayed: compaction rewrites context, it never re-runs actions,\n3543:          \"nexus.compaction.archived_messages\": outcome.archived,\n3608:    this.messages = compacted;\n3652:  /** Tool calls of the last assistant message that have no recorded result in `messages`. */\n3653:  private unsettledToolCalls(messages: ChatMessage[]): string[] {\n3654:    for (let i = messages.length - 1; i >= 0; i--) {\n3655:      const m = messages[i];\n3657:      const results = new Set(messages.slice(i + 1).filter((r) => r.role === \"tool\").map((r) => r.tool_call_id));\n3664:  public restoreArchive(messages: ChatMessage[]): void {\n3665:    this.archiveForReading = messages.slice(-ARCHIVE_FOR_READING);\n3738:      const answer = await this.submitGenAiRequest(this.client, () => this.client.chatCompletion(prompt, [], requestId, probeSignal, \"compaction\"));\n3747:    if (this.messages.length <= 2) {\n3750:    const original = this.messages;\n3770:          this.messages = llmPrompt;\n3771:          this.admitContext(0, requestId);\n3772:          admittedPrompt = this.messages;\n3774:          this.messages = original;\n3777:        const res = await this.submitGenAiRequest(this.client, () => this.client.chatCompletion(admittedPrompt, [], requestId, signal, \"compaction\"));\n3787:        this.messages = original;\n3792:    if (this.messages !== original) return { ok: false, durable: false, message: \"The conversation changed while the summary was prepared; not compacted.\" };\n3799:    const beforeTokens = calculateContextBudget(this.requestMessages(original), this.getEffectiveTools(), limit).totalActiveTokens;\n3800:    const afterTokens = calculateContextBudget(this.requestMessages(compacted), this.getEffectiveTools(), limit).totalActiveTokens;\n3803:      return { ok: true, durable: outcome.durable, message: `Compacted context: distilled ${discarded.length} messages, ${this.messages.length} active messages in memory. ${outcome.message}${llmNote}`, outcome };\n3878:   * `messages[0]` rewrites the message journal and drops the provider's prefix cache. Only the catalog text is\n3884:    const first = this.messages[0];\n3894:      this.messages[0] = { ...first, content: first.content.slice(0, span.start) + text + first.content.slice(span.end) };\n3906:    // and the `activate_skill` lookup reach the skills without it, and rewriting `messages[0]` drops the prefix cache.\n3908:    this.messages[0] = { ...first, content: first.content.slice(0, at) + text + first.content.slice(at + sized.text.length) };\n3926:    const tail = this.messages.slice(from);\n3966:8. BOUNDED CONTEXT: Your context window is limited, and earlier tool output is compacted out of the conversation as you work; your own messages are what carry forward. After inspecting large output you will rely on later, state its key findings in a line or two (with file and symbol references) before moving on; do not restate small files or narrate routine steps. Re-read earlier output only when you need a specific detail you did not record or it may have changed.\n3976:The pinned Objective Ledger lists the operator's requirements; your plan never replaces them. Record progress with \\`update_requirements\\` (implemented/verified only with evidence; blocked/descoped only with a reason). Steering messages from the operator apply on top of the objective.\n4662:    this.messages.push({\n4710:      const { client: activeClient } = this.selectCognitiveClient(currentStep, this.messages);\n4724:            this.submitGuardingLength(lengthGuard, this.messages, (request) =>\n4725:              activeClient.chatCompletion(request, this.getEffectiveTools(), s.requestId, 