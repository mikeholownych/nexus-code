{"timestamp":"2026-11-03T21:32:40.189Z","ordinal":83371,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":1674834099,"cached_input_tokens":1662123264,"cache_write_input_tokens":0,"output_tokens":3008301,"reasoning_output_tokens":1545599,"total_tokens":1677842400},"last_token_usage":{"input_tokens":158579,"cached_input_tokens":158080,"cache_write_input_tokens":0,"output_tokens":366,"reasoning_output_tokens":364,"total_tokens":158945},"last_usage_includes_reasoning":true,"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":3.0,"window_minutes":300,"resets_at":1793758232},"secondary":{"used_percent":53.0,"window_minutes":10080,"resets_at":1794123386},"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"plus","rate_limit_reached_type":null}}}
