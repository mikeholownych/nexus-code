{"timestamp":"2026-11-04T01:12:38.505Z","ordinal":88237,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","item":{"type":"CommandExecution","id":"exec-90f43cb5-2f2a-4bb9-9661-d1b34b7230d3","process_id":"3134","command":["/usr/bin/zsh","-lc","nl -ba eval/tool_grammar_matrix.mjs | sed -n '240,360p'; rg -n 'runtime|runToolGrammarMatrix|installed|caller' eval/tool_grammar_matrix.test.mjs"],"cwd":"file:///home/mike/nexus-wt/v112-wp1101-integration","parsed_cmd":[{"type":"read","cmd":"nl -ba eval/tool_grammar_matrix.mjs","name":"tool_grammar_matrix.mjs","path":"eval/tool_grammar_matrix.mjs"},{"type":"search","cmd":"rg -n 'runtime|runToolGrammarMatrix|installed|caller' eval/tool_grammar_matrix.test.mjs","query":"runtime|runToolGrammarMatrix|installed|caller","path":"tool_grammar_matrix.test.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"   240\t  const expected = PROVIDER_KIND[provider.provider];\n   241\t  if (!expected || provider.serverKind !== expected) throw new TypeError(\"configured provider identity is invalid\");\n   242\t  if (typeof provider.endpointUrl !== \"string\" || !provider.endpointUrl) throw new TypeError(\"provider endpoint is required\");\n   243\t  if (typeof provider.serverVersion !== \"string\" || !provider.serverVersion.trim()) throw new TypeError(\"server version must be pinned before inference\");\n   244\t  if (typeof provider.imageDigest !== \"string\" || !/^sha256:[a-f0-9]{64}$/i.test(provider.imageDigest)) throw new TypeError(\"immutable server image digest must be pinned before inference\");\n   245\t  if (typeof provider.modelName !== \"string\" || !provider.modelName.trim()) throw new TypeError(\"model identity requires a name\");\n   246\t  if (typeof provider.modelDigest !== \"string\" || !/^sha256:[a-f0-9]{64}$/i.test(provider.modelDigest)) throw new TypeError(\"immutable model digest must be pinned before inference\");\n   247\t  if (!Number.isSafeInteger(provider.contextSize) || provider.contextSize <= 0) throw new TypeError(\"positive context size must be pinned before inference\");\n   248\t  if (!isRecord(provider.sampling) || !Number.isFinite(provider.sampling.temperature)) throw new TypeError(\"sampling temperature must be pinned before inference\");\n   249\t  if (provider.sampling.max_tokens !== undefined && (!Number.isSafeInteger(provider.sampling.max_tokens) || provider.sampling.max_tokens <= 0)) throw new TypeError(\"sampling max_tokens must be a positive integer\");\n   250\t  if (provider.toolChoice !== \"auto\") throw new TypeError(\"tool choice must be auto for the candidate client\");\n   251\t  if (!Array.isArray(provider.serverFlags) || provider.serverFlags.some((flag) => typeof flag !== \"string\")) throw new TypeError(\"server flags must be pinned before inference\");\n   252\t  if (provider.serverFlags.some((flag) => /api[-_]?key|token|secret|password|credential|authorization|bearer/i.test(flag))) {\n   253\t    throw new TypeError(\"server flags must omit credentials and authentication options before inference\");\n   254\t  }\n   255\t  if (typeof provider.compatibilityMode !== \"string\" || !provider.compatibilityMode.trim()) throw new TypeError(\"compatibility mode must be pinned before inference\");\n   256\t  return expected;\n   257\t}\n   258\t\n   259\tfunction verifyInstalledArchive(installRoot, archiveSha256, sourceCommit) {\n   260\t  const provenancePath = path.join(path.resolve(installRoot), \".provenance.json\");\n   261\t  let provenance;\n   262\t  try {\n   263\t    provenance = JSON.parse(fs.readFileSync(provenancePath, \"utf8\"));\n   264\t  } catch {\n   265\t    throw new TypeError(\"installed candidate has no readable installer provenance\");\n   266\t  }\n   267\t  if (provenance.method !== \"installer\" || provenance.archiveSha256 !== archiveSha256 || provenance.revision !== sourceCommit) {\n   268\t    throw new TypeError(\"installed candidate provenance does not bind the exact archive and source commit\");\n   269\t  }\n   270\t}\n   271\t\n   272\t/** Invoke the exact installed candidate client for 50 attempts/tool and retain only non-secret aggregate evidence. */\n   273\texport async function runToolGrammarMatrix(options) {\n   274\t  if (!options || typeof options.archivePath !== \"string\" || typeof options.installRoot !== \"string\") throw new TypeError(\"candidate archive and installed root are required\");\n   275\t  if (Object.hasOwn(options, \"tools\")) throw new TypeError(\"tool schemas must be loaded from the exact installed candidate\");\n   276\t  if (!commitPattern.test(options.sourceCommit)) throw new TypeError(\"full candidate source commit is required\");\n   277\t  const archivePath = fs.realpathSync(options.archivePath);\n   278\t  const archiveSha256 = sha256(fs.readFileSync(archivePath));\n   279\t  if (options.archiveSha256 && options.archiveSha256 !== archiveSha256) throw new TypeError(\"candidate archive SHA-256 does not match the pinned digest\");\n   280\t  verifyInstalledArchive(options.installRoot, archiveSha256, options.sourceCommit);\n   281\t  if (!Array.isArray(options.providers) || options.providers.length !== 3) throw new TypeError(\"exactly one configuration per supported provider is required\");\n   282\t  const configuredProviders = options.providers.map((provider) => {\n   283\t    validProviderIdentity(provider);\n   284\t    return provider;\n   285\t  });\n   286\t  const runtime = options.runtime ?? await loadInstalledRuntime(options.installRoot);\n   287\t  const tools = validateTools(runtime.tools);\n   288\t  const clientFactory = runtime.clientFactory;\n   289\t  const repairJsonWithClass = runtime.repairJsonWithClass;\n   290\t  const adaptToolsForServer = runtime.adaptToolsForServer;\n   291\t  if (typeof clientFactory !== \"function\" || typeof repairJsonWithClass !== \"function\" || typeof adaptToolsForServer !== \"function\") throw new TypeError(\"installed candidate runtime is incomplete\");\n   292\t  const digests = { archiveSha256, sourceCommit: options.sourceCommit };\n   293\t  const endpoints = [];\n   294\t  for (const provider of configuredProviders) {\n   295\t    const expectedKind = validProviderIdentity(provider);\n   296\t    const promptFixtures = TOOL_NAMES.flatMap((toolName) => Array.from({ length: 50 }, (_, index) => promptFor(toolName, index < 5)));\n   297\t    const client = await clientFactory(provider, runtime);\n   298\t    const discovery = await client.discoverAdvertisement();\n   299\t    const detectedKind = client.getDetectedServerKind?.();\n   300\t    if (discovery?.state !== \"supported\" || detectedKind !== expectedKind) {\n   301\t      throw new Error(`provider identity mismatch: configured ${expectedKind}, detected ${detectedKind ?? \"unknown\"}`);\n   302\t    }\n   303\t    const providerTools = validateTools(adaptToolsForServer(detectedKind, tools));\n   304\t    const counts = Object.fromEntries(TOOL_NAMES.map((name) => [name, {\n   305\t      attempts: 50, native_valid: 0, repaired: 0, schema_invalid: 0, invalid: 0,\n   306\t      hybrid_attempts: 5, hybrid_reasoning_present: 0, hybrid_schema_valid: 0,\n   307\t    }]));\n   308\t    for (const toolName of TOOL_NAMES) {\n   309\t      const tool = providerTools.find((entry) => entry.function.name === toolName);\n   310\t      const toolCounts = counts[toolName];\n   311\t      for (let index = 0; index < 50; index++) {\n   312\t        const hybrid = index < 5;\n   313\t        let response;\n   314\t        try {\n   315\t          response = await client.chatCompletion([{ role: \"user\", content: promptFor(toolName, hybrid) }], [tool]);\n   316\t        } catch {\n   317\t          toolCounts.invalid++;\n   318\t          continue;\n   319\t        }\n   320\t        const calls = Array.isArray(response?.tool_calls) ? response.tool_calls : [];\n   321\t        if (calls.length !== 1 || calls[0]?.function?.name !== toolName) {\n   322\t          toolCounts.invalid++;\n   323\t          continue;\n   324\t        }\n   325\t        const classification = classifyToolArguments({\n   326\t          schema: tool.function.parameters,\n   327\t          rawArguments: calls[0].function.arguments,\n   328\t          repairJsonWithClass,\n   329\t        });\n   330\t        toolCounts[classification.category]++;\n   331\t        const reasoningMatch = /<think>\\s*([\\s\\S]*?)\\s*<\\/think>/i.exec(typeof response.content === \"string\" ? response.content : \"\");\n   332\t        const reasoningPresent = Boolean(reasoningMatch?.[1]?.trim());\n   333\t        if (hybrid && reasoningPresent) toolCounts.hybrid_reasoning_present++;\n   334\t        if (hybrid && classification.schemaValid) toolCounts.hybrid_schema_valid++;\n   335\t      }\n   336\t    }\n   337\t    const totals = { attempts: 200, native_valid: 0, repaired: 0, schema_invalid: 0, invalid: 0 };\n   338\t    for (const tool of Object.values(counts)) for (const category of categories) totals[category] += tool[category];\n   339\t    const fixtureBytes = Buffer.from(promptFixtures.join(\"\\n\"), \"utf8\");\n   340\t    const endpoint = {\n   341\t      provider: provider.provider,\n   342\t      serverKind: detectedKind,\n   343\t      serverVersion: provider.serverVersion,\n   344\t      imageDigest: provider.imageDigest,\n   345\t      modelName: provider.modelName,\n   346\t      modelDigest: provider.modelDigest,\n   347\t      contextSize: provider.contextSize,\n   348\t      sampling: provider.sampling,\n   349\t      toolChoice: provider.toolChoice,\n   350\t      promptFixtureSha256: sha256(fixtureBytes),\n   351\t      serverFlags: provider.serverFlags,\n   352\t      compatibilityMode: provider.compatibilityMode,\n   353\t      attempts: 200,\n   354\t      tools: counts,\n   355\t      totals,\n   356\t      passed: false,\n   357\t    };\n   358\t    endpoint.passed = endpointPasses(endpoint);\n   359\t    endpoints.push(endpoint);\n   360\t  }\n10:  runToolGrammarMatrix,\n108:test(\"matrix evidence rejects caller-supplied tool schemas instead of replacing installed schemas\", async () => {\n109:  await assert.rejects(runToolGrammarMatrix({ archivePath: \"unused\", installRoot: \"unused\", tools: [] }), /exact installed candidate/i);\n128:  const installRoot = path.join(root, \"installed\");\n144:  const runtime = {\n178:  const evidence = await runToolGrammarMatrix({\n182:    runtime,\n199:  const failed = await runToolGrammarMatrix({ archivePath, installRoot, sourceCommit, runtime, providers, outputPath: failedPath });\n212:  const installRoot = path.join(root, \"installed\");\n229:  await assert.rejects(runToolGrammarMatrix({\n231:    runtime: { tools: [], clientFactory: async () => { calls++; return {}; } },\n","exit_code":0,"duration":{"secs":0,"nanos":731043625}},"started_at_ms":1793754757773,"completed_at_ms":1793754758505}}
