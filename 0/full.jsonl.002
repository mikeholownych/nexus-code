 size-capped resources.workspaceRoot\");\nif (config.qualification === true) {\n  const corpusProblem = corpusManifestProblem(config, tasksDir, tasks, corpusTaskRows(taskSnapshots, tasks));\n  if (corpusProblem) problems.push(corpusProblem);\n}\nif (config.qualification === true && config.sampling?.temperature !== 0) {\n  problems.push(\"qualification adapters require sampling.temperature=0 so the matched Nexus, Goose and OpenCode runs use the same deterministic setting\");\n}\nif (config.qualification === true) {\n  const budgetProblem = qualificationBudgetProblem(config);\n  if (budgetProblem) problems.push(budgetProblem);\n}\nconst agentIdentity = problems.length ? { record: null, problem: null } : await resolveAgentIdentity(config);\nif (agentIdentity.problem) problems.push(agentIdentity.problem);\nlet fingerprint = null;\nif (!problems.length) {\n  const probe = config.proxy === false ? null : await startModelProxy({ upstream: config.endpoint, caFile });\n  try {\n    const entry = await fetchModelEntry(probe?.url ?? config.endpoint, config.model, apiKey);\n    const fp = modelFingerprint(config, entry);\n    fingerprint = fp.fingerprint;\n    problems.push(...fp.missing.map((m) => `model fingerprint: ${m}`));\n    if (config.qualification === true && (config.agent ?? \"nexus\") === \"nexus\") {\n      const limitsProblem = nexusLimitsProblem(config, entry);\n      if (limitsProblem) problems.push(limitsProblem);\n    }\n  } finally {\n    await probe?.close();\n  }\n}\nif (problems.length) {\n  console.error(`eval/run.mjs: not starting; ${problems.length} problem(s):\\n${problems.map((p) => `  - ${p}`).join(\"\\n\")}`);\n  process.exit(2);\n}\nconst resultsFile = path.join(args.out, \"results.jsonl\");\n// The scorer consumes this file even when the selected dataset split is empty.\nfs.writeFileSync(resultsFile, \"\", { flag: \"wx\" });\nconst frozenTaskRows = taskRecords.map(({ id }) => corpusTaskRows(taskSnapshots, [id])[0]);\nfs.writeFileSync(path.join(args.out, \"manifest.json\"), JSON.stringify({\n  createdAt: new Date().toISOString(),\n  harness: identity,\n  config: redactConfig(config),\n  configSha256,\n  dataset: dataset ? { name: dataset.manifest.name, version: dataset.manifest.version, split: args.split ?? null, manifestSha256: dataset.manifestSha256, taskIds: tasks } : null,\n  qualificationCorpus: config.qualification === true ? { manifestSha256: config.corpusManifestSha256, tasks: frozenTaskRows } : null,\n  fingerprint,\n  agentVersion: agentIdentity.record,\n  budget: effectiveBudget({}, config),\n  runs,\n  tasks: frozenTaskRows,\n  host: os.hostname(),\n  node: process.version,\n}, null, 2) + \"\\n\");\n\n// Run-major order (every task once, then again): a pass cut short still has the same number of runs per task.\nfor (let run = 1; run <= runs; run++) {\n  for (const { id, dir, treeSha256, task: taskData, versionedDataset } of taskRecords) {\n    if (pairs && !pairs.some(([t, r]) => t === id && Number(r) === run)) continue;\n    assertTaskSnapshotDigest({ dir, treeSha256, id, versionedDataset });\n    const task = { ...taskData, dir };\n    const record = await runOnce(task, run);\n    fs.appendFileSync(resultsFile, JSON.stringify(record) + \"\\n\");\n    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\n  }\n}\n\nasync function runOnce(task, run) {\n  // Under the resource contract these are on a tmpfs, so candidate writes count against the run's memory limit.\n  const scratch = config.resources?.workspaceRoot ?? os.tmpdir();\n  const ws = fs.mkdtempSync(path.join(scratch, `nexus-eval-${task.id}-`));\n  const checkDirs = [];\n  let typecheckBaselineWorkspace = null;\n  const home = fs.mkdtempSync(path.join(scratch, \"nexus-eval-home-\"));\n  const budget = effectiveBudget(task, config);\n  const base = { task: task.id, tier: task.tier, ...(task.tier === \"T3\" ? { t3SteeringItems: task.steering.length } : {}), config: config.name, agent: config.agent ?? \"nexus\", agentVersion: agentIdentity.record, budget, run, harness: identity.string, model: config.model, startedAt: new Date().toISOString() };\n  try {\n    await prepareWorkspace(task, ws);\n    const needsTypecheckBaseline = task.evaluators?.some((item) => {\n      const spec = typeof item === \"string\" ? { type: item } : item;\n      return spec?.type === \"typecheck_clean\" && !spec.baseline && !task.typecheck?.baseline;\n    });\n    if (needsTypecheckBaseline) {\n      typecheckBaselineWorkspace = fs.mkdtempSync(path.join(scratch, `nexus-eval-typecheck-baseline-${task.id}-`));\n      checkDirs.push(typecheckBaselineWorkspace);\n      cloneWorkspace(ws, typecheckBaselineWorkspace);\n    }\n    // Taken now, while .git is the harness's own: after the agent runs, nothing executes git against its workspace.\n    const baselineTree = gitRev(ws, \"HEAD^{tree}\");\n    const needsChangedFiles = task.evaluators?.some((item) => [\"syntax_ast\", \"diff_boundary\"].includes(typeof item === \"string\" ? item : item?.type));\n    const evaluatorBaseline = needsChangedFiles ? captureWorkspaceSnapshot(ws) : null;\n    const t3Baseline = task.tier === \"T3\" ? steeringBaseline(task, ws) : null;\n    // On the per-run task copy, so the steering hook in runAgent can read it. The commands run on a throwaway copy of\n    // the staged workspace, so the agent starts on exactly the staged tree.\n    const t3BaselineResources = [];\n    if (task.tier === \"T3\") {\n      const probe = fs.mkdtempSync(path.join(scratch, `nexus-eval-t3-baseline-${task.id}-`));\n      try {\n        fs.cpSync(ws, probe, { recursive: true, verbatimSymlinks: true });\n        task.t3CommandBaseline = await commandBaseline(task, (command) => runIsolated(command, { cwd: probe, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => {\n          if (r.resources) t3BaselineResources.push(r.resources);\n          const error = r.containmentProblem ?? (r.timedOut ? \"timed out\" : r.overflow ? \"output limit\" : r.status === null ? \"did not exit\" : null);\n          return { pass: r.status === 0 && !error, error };\n        }));\n      } finally {\n        fs.rmSync(probe, { recursive: true, force: true });\n      }\n    }\n#!/usr/bin/env node\n// Marks runs that failed on infrastructure (the agent never reached the model), so they are rerun rather than scored as\n// task failures. Runs recorded through the harness's model proxy are classified by what it observed, the same way for\n// every agent: the model never answered and the endpoint failed. A run whose model answered is always scored (a crash\n// is a failure, not a rerun). Older records fall back to each agent's own connection-failure message.\n// usage: eval/infra.mjs <out-dir-of-one-config>   → prints \"task run\" per infrastructure failure\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { isInfrastructureFailure } from \"./model_proxy.mjs\";\n\nconst SIGNATURES = {\n  goose: /Network error: Could not connect to/,\n  opencode: /Cannot connect to API: Unable to connect/,\n  aider: /litellm\\.(InternalServerError|APIConnectionError).*Connection\\s+error/s,\n  nexus: null,\n};\n/** Total time a Nexus run waited for an unavailable provider, from its JSON report. */\nfunction recoveryWaitMs(stdout) {\n  try {\n    const report = JSON.parse(stdout.slice(stdout.indexOf(\"{\"), stdout.lastIndexOf(\"}\") + 1));\n    return (report.turn?.providerRecovery ?? []).reduce((sum, r) => sum + (r.waitedMs ?? 0), 0);\n  } catch {\n    return 0;\n  }\n}\n\nconst dir = process.argv[2];\nlet legacy = 0;\nfor (const line of fs.readFileSync(path.join(dir, \"results.jsonl\"), \"utf8\").split(\"\\n\").filter(Boolean)) {\n  const r = JSON.parse(line);\n  let infra;\n  if (r.error || r.model) {\n    // Observed by the harness's model proxy: the same rule for every agent (REQ-QUAL-106).\n    infra = isInfrastructureFailure(r);\n  } else {\n    // Records from before the proxy: each agent's own failure message (Nexus: INFERENCE_FAILED or a long provider wait).\n    legacy++;\n    const logs = path.join(dir, r.logs ?? \"\");\n    const read = (f) => (fs.existsSync(path.join(logs, f)) ? fs.readFileSync(path.join(logs, f), \"utf8\") : \"\");\n    const text = [read(\"agent.stdout.json\"), read(\"agent.stderr.log\")].join(\"\\n\");\n    infra = r.agent === \"nexus\"\n      ? r.turn?.reason === \"INFERENCE_FAILED\" || recoveryWaitMs(read(\"agent.stdout.json\")) > 60_000\n      : SIGNATURES[r.agent]?.test(text) && !r.hiddenPass;\n  }\n  if (infra) console.log(`${r.task} ${r.run}`);\n}\nif (legacy) console.error(`infra: ${legacy} record(s) predate the model proxy; classified by agent failure messages`);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","create_time":1793733699.4523838}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
