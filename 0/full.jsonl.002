n=No gate friction. Artifact and installed-candidate work remains.), updated 9 minutes ago\\n  - [doing] RC2 exact-source package qualification (phase=clean packaging worktree at e134dcd5, gate=Exact clean e134dcd5 source tests/build/security passed; reviewer approved final qualification wording. Building in separate clean worktree to avoid dirty doc state impacting build identity. Pinned Rust and Node 24 images are cached locally., next=Create and verify two exact RC2 package outputs with pinned images, compare archive/checksums/SBOM/notices/installer, then run installation, standalone CLI, upgrade/compatibility checks on preserved archive., friction=No package or installed-RC evidence yet. Tag/publish remain owner actions.), updated 8 minutes ago\"}]},{\"chunk_id\":\"b69c65\",\"wall_time_seconds\":0.709088493,\"exit_code\":0,\"original_token_count\":5408,\"output\":\"#!/bin/sh\\nset -eu\\n\\nREPO=mikeholownych/nexus-code\\nBASE=${NEXUS_RELEASE_BASE_URL:-\\\"https://github.com/$REPO/releases\\\"}\\nVERSION=${NEXUS_VERSION:-latest}\\nPREFIX=${NEXUS_PREFIX:-\\\"$HOME/.local\\\"}\\n\\nfail() { printf 'nexus installer: %s\\\\n' \\\"$*\\\" >&2; exit 1; }\\ncase \\\"$(uname -s):$(uname -m)\\\" in\\n  Linux:x86_64|Linux:amd64) ;;\\n  *) fail \\\"unsupported system $(uname -s)/$(uname -m); supported: Linux x86-64 (glibc).\\\" ;;\\nesac\\ncommand -v node >/dev/null 2>&1 || fail \\\"Node.js 22 or newer is required; install Node.js and retry.\\\"\\nNODE_MAJOR=$(node -p 'Number(process.versions.node.split(\\\".\\\")[0])' 2>/dev/null || printf 0)\\n[ \\\"$NODE_MAJOR\\\" -ge 22 ] || fail \\\"Node.js 22 or newer is required (found $(node --version 2>/dev/null || echo unknown)).\\\"\\ncommand -v curl >/dev/null 2>&1 || fail \\\"curl is required.\\\"\\ncommand -v tar >/dev/null 2>&1 || fail \\\"tar is required.\\\"\\ncommand -v sha256sum >/dev/null 2>&1 || fail \\\"sha256sum is required.\\\"\\n\\nVERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION-auto}\\ncase \\\"$VERIFY_ATTESTATION\\\" in\\n  auto|0|1) ;;\\n  *) fail \\\"NEXUS_VERIFY_ATTESTATION must be auto (verify when a trusted GitHub CLI is present), 1 (require verification) or 0 (skip verification).\\\" ;;\\nesac\\nTRUSTED_GH=\\nif [ -x /usr/bin/gh ]; then\\n  TRUSTED_GH=/usr/bin/gh\\nelif [ -x /usr/local/bin/gh ]; then\\n  TRUSTED_GH=/usr/local/bin/gh\\nfi\\nif [ \\\"$VERIFY_ATTESTATION\\\" = \\\"1\\\" ] && [ -z \\\"$TRUSTED_GH\\\" ]; then\\n  fail \\\"provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh o…192 tokens truncated…PI_TMP/latest.json\\\" -w \\\"%{http_code}\\\" \\\"$API_BASE/latest\\\" 2>\\\"$API_TMP/curl.err\\\" || echo \\\"000\\\")\\n\\n  if [ \\\"$LATEST_CODE\\\" = \\\"200\\\" ]; then\\n    VERSION=$(sed -n 's/.*\\\"tag_name\\\"[[:space:]]*:[[:space:]]*\\\"\\\\([^\\\"]*\\\\)\\\".*/\\\\1/p' \\\"$API_TMP/latest.json\\\" | head -n 1)\\n    [ -n \\\"$VERSION\\\" ] || fail \\\"GitHub returned no stable release tag.\\\"\\n    validate_tag \\\"$VERSION\\\"\\n  elif [ \\\"$LATEST_CODE\\\" = \\\"403\\\" ]; then\\n    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \\\"$API_TMP/headers\\\" 2>/dev/null; then\\n      fail \\\"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\\\"\\n    fi\\n    fail \\\"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\\\"\\n  elif [ \\\"$LATEST_CODE\\\" = \\\"404\\\" ]; then\\n    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \\\"$API_TMP/releases.json\\\" -w \\\"%{http_code}\\\" \\\"$API_BASE?per_page=1\\\" 2>/dev/null || echo \\\"000\\\")\\n    if [ \\\"$PREREL_CODE\\\" = \\\"200\\\" ]; then\\n      PREREL_TAG=$(sed -n 's/.*\\\"tag_name\\\"[[:space:]]*:[[:space:]]*\\\"\\\\([^\\\"]*\\\\)\\\".*/\\\\1/p' \\\"$API_TMP/releases.json\\\" | head -n 1)\\n      if [ -n \\\"$PREREL_TAG\\\" ]; then\\n        fail \\\"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\\\"\\n      fi\\n    fi\\n    fail \\\"could not find latest stable release (HTTP 404 from $API_BASE/latest).\\\"\\n  else\\n    fail \\\"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\\\"\\n  fi\\n  rm -rf \\\"$API_TMP\\\"\\n  trap - EXIT HUP INT TERM\\nfi\\n\\nARCHIVE=\\\"nexus-linux-x86_64-$VERSION.tar.gz\\\"\\nNORMALIZED_VERSION=${VERSION#v}\\nURL=\\\"$BASE/download/$VERSION\\\"\\nTMP=$(mktemp -d \\\"${TMPDIR:-/tmp}/nexus-install.XXXXXX\\\") || fail \\\"could not create temporary directory.\\\"\\ncleanup() { rm -rf \\\"$TMP\\\"; }\\ntrap cleanup EXIT HUP INT TERM\\ncurl -fsSL --show-error --retry 2 \\\"$URL/$ARCHIVE\\\" -o \\\"$TMP/$ARCHIVE\\\" || fail \\\"download failed for $ARCHIVE.\\\"\\ncurl -fsSL --show-error --retry 2 \\\"$URL/SHA256SUMS\\\" -o \\\"$TMP/SHA256SUMS\\\" || fail \\\"could not download release checksums.\\\"\\ngrep -F \\\"  $ARCHIVE\\\" \\\"$TMP/SHA256SUMS\\\" > \\\"$TMP/expected.sha256\\\" || fail \\\"checksum entry for $ARCHIVE is missing.\\\"\\n(cd \\\"$TMP\\\" && sha256sum --check --status expected.sha256) || fail \\\"SHA-256 verification failed; no installation was changed.\\\"\\nARCHIVE_SHA256=$(sha256sum \\\"$TMP/$ARCHIVE\\\" | awk '{print $1}')\\n\\nif [ \\\"$VERIFY_ATTESTATION\\\" != \\\"0\\\" ] && [ -n \\\"$TRUSTED_GH\\\" ]; then\\n  if \\\"$TRUSTED_GH\\\" attestation verify \\\"$TMP/$ARCHIVE\\\" -R \\\"$REPO\\\" >/dev/null 2>&1 && \\\\\\n     \\\"$TRUSTED_GH\\\" attestation verify \\\"$TMP/SHA256SUMS\\\" -R \\\"$REPO\\\" >/dev/null 2>&1; then\\n    printf 'nexus installer: verified build provenance for %s and its checksum index\\\\n' \\\"$ARCHIVE\\\"\\n  elif [ \\\"$VERIFY_ATTESTATION\\\" = \\\"1\\\" ]; then\\n    fail \\\"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\\\"\\n  else\\n    printf 'nexus installer: build provenance was not verified: %s could not verify the attestation (it may need gh auth login); the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\\\n' \\\"$TRUSTED_GH\\\" >&2\\n  fi\\nelif [ \\\"$VERIFY_ATTESTATION\\\" = \\\"auto\\\" ]; then\\n  printf 'nexus installer: build provenance was not verified: no trusted GitHub CLI at /usr/bin/gh or /usr/local/bin/gh; the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\\\n' >&2\\nfi\\n\\nVERSION_DIR=\\\"$PREFIX/lib/nexus/$VERSION\\\"\\nBIN_DIR=\\\"$PREFIX/bin\\\"\\nLINK=\\\"$BIN_DIR/nexus\\\"\\nmkdir -p \\\"$PREFIX/lib/nexus\\\" \\\"$BIN_DIR\\\"\\nif [ -e \\\"$LINK\\\" ] && [ ! -L \\\"$LINK\\\" ]; then\\n  fail \\\"$LINK exists and is not a symlink; left it unchanged.\\\"\\nfi\\nif [ -L \\\"$LINK\\\" ]; then\\n  OLD=$(readlink \\\"$LINK\\\")\\n  case \\\"$OLD\\\" in \\\"$PREFIX/lib/nexus/\\\"*) ;; *) fail \\\"$LINK points outside the Nexus installation; left it unchanged.\\\" ;; esac\\nfi\\n\\nFORCE=${NEXUS_FORCE:-0}\\nNEEDS_EXTRACT=1\\nif [ -d \\\"$VERSION_DIR\\\" ] && [ \\\"$FORCE\\\" != \\\"1\\\" ]; then\\n  if [ -x \\\"$VERSION_DIR/bin/nexus\\\" ] && \\\\\\n     [ -x \\\"$VERSION_DIR/lib/core/harness-core\\\" ] && \\\\\\n     [ -x \\\"$VERSION_DIR/lib/core/nexus-tui\\\" ] && \\\\\\n     [ \\\"$(cat \\\"$VERSION_DIR/VERSION\\\" 2>/dev/null || true)\\\" = \\\"$VERSION\\\" ]; then\\n    if [ -f \\\"$VERSION_DIR/MANIFEST.sha256\\\" ]; then\\n      if (cd \\\"$VERSION_DIR\\\" && sha256sum --check --status MANIFEST.sha256 2>/dev/null); then\\n        NEEDS_EXTRACT=0\\n      fi\\n      if [ \\\"$NEEDS_EXTRACT\\\" = \\\"0\\\" ]; then\\n        if ! node - \\\"$VERSION_DIR/.provenance.json\\\" \\\"$ARCHIVE_SHA256\\\" <<'NODE'\\nconst fs = require(\\\"node:fs\\\");\\nconst [file, archiveSha256] = process.argv.slice(2);\\ntry {\\n  const record = JSON.parse(fs.readFileSync(file, \\\"utf8\\\"));\\n  if (record.archiveSha256 !== archiveSha256) process.exit(1);\\n} catch { process.exit(1); }\\nNODE\\n        then\\n          NEEDS_EXTRACT=1\\n        fi\\n      fi\\n    fi\\n  fi\\nfi\\n\\nif [ \\\"$NEEDS_EXTRACT\\\" = \\\"1\\\" ]; then\\n  mkdir -p \\\"$TMP/unpack\\\"\\n  tar -xzf \\\"$TMP/$ARCHIVE\\\" -C \\\"$TMP/unpack\\\" || fail \\\"archive extraction failed.\\\"\\n  PACKAGE=\\\"$TMP/unpack/nexus\\\"\\n  [ -x \\\"$PACKAGE/bin/nexus\\\" ] && [ -x \\\"$PACKAGE/lib/core/harness-core\\\" ] && [ -x \\\"$PACKAGE/lib/core/nexus-tui\\\" ] && [ \\\"$(cat \\\"$PACKAGE/VERSION\\\" 2>/dev/null || true)\\\" = \\\"$VERSION\\\" ] || fail \\\"release archive is incomplete or has a mismatched version.\\\"\\n  if [ -f \\\"$PACKAGE/MANIFEST.sha256\\\" ]; then\\n    (cd \\\"$PACKAGE\\\" && sha256sum --check --status MANIFEST.sha256) || fail \\\"release archive failed manifest checksum verification.\\\"\\n  fi\\n  PACKAGE_VERSION_OUTPUT=$(\\\"$PACKAGE/bin/nexus\\\" --version 2>&1) || fail \\\"release binary failed its pre-install self-test.\\\"\\n  PACKAGE_VERSION_REPORTED=$(printf '%s\\\\n' \\\"$PACKAGE_VERSION_OUTPUT\\\" | sed -n '1s/[[:space:]].*$//p')\\n  [ \\\"$PACKAGE_VERSION_REPORTED\\\" = \\\"$NORMALIZED_VERSION\\\" ] || fail \\\"release binary reported version '$PACKAGE_VERSION_REPORTED' instead of '$NORMALIZED_VERSION' during self-test.\\\"\\n  if [ -f \\\"$PACKAGE/compatibility.json\\\" ]; then\\n    node - \\\"$PACKAGE/compatibility.json\\\" \\\"$VERSION\\\" \\\"$ARCHIVE\\\" <<'NODE' || fail \\\"release compatibility metadata is invalid or mismatched.\\\"\\nconst fs = require(\\\"node:fs\\\");\\nconst [file, version, archive] = process.argv.slice(2);\\nconst data = JSON.parse(fs.readFileSync(file, \\\"utf8\\\"));\\nconst asset = data.platforms?.[\\\"linux-x86_64\\\"];\\nconst compatible = data.schemaVersion === 1 && data.product === \\\"nexus-code\\\" &&\\n  data.version === version.replace(/^v/, \\\"\\\") &&\\n  typeof data.revision === \\\"string\\\" && /^[a-f0-9]{7,64}$/i.test(data.revision) &&\\n  typeof data.builtAt === \\\"string\\\" && !Number.isNaN(Date.parse(data.builtAt)) &&\\n  asset?.archive === archive && asset.os === \\\"linux\\\" && asset.arch === \\\"x86_64\\\" &&\\n  data.compatibility && Number.isSafeInteger(data.compatibility.configSchemaVersion) &&\\n  Number.isSafeInteger(data.compatibility.stateSchemaVersion) &&\\n  Number.isSafeInteger(data.compatibility.minSupportedConfigVersion) &&\\n  Number.isSafeInteger(data.compatibility.minSupportedStateVersion) &&\\n  data.compatibility.minSupportedConfigVersion <= data.compatibility.configSchemaVersion &&\\n  data.compatibility.minSupportedStateVersion <= data.compatibility.stateSchemaVersion;\\nif (!compatible) process.exit(1);\\nNODE\\n  fi\\n  # A rename persists the directory entry, not file data: flush the extracted\\n  # package before it replaces anything, or a power loss can leave 0-byte files.\\n  sync\\n  rm -rf \\\"$VERSION_DIR\\\"\\n  mv \\\"$PACKAGE\\\" \\\"$VERSION_DIR\\\"\\nfi\\nnode - \\\"$VERSION_DIR/compatibility.json\\\" \\\"$VERSION\\\" \\\"$PREFIX\\\" \\\"$VERSION_DIR\\\" \\\"$LINK\\\" \\\"$ARCHIVE\\\" \\\"$ARCHIVE_SHA256\\\" \\\"$VERSION_DIR/.provenance.json\\\" <<'NODE'\\nconst fs = require(\\\"node:fs\\\");\\nconst [metadataPath, version, prefix, installedPath, binPath, archive, archiveSha256, output] = process.argv.slice(2);\\nlet metadata = null;\\ntry { metadata = JSON.parse(fs.readFileSync(metadataPath, \\\"utf8\\\")); } catch {}\\nconst record = {\\n  formatVersion: 1,\\n  method: \\\"installer\\\",\\n  product: \\\"nexus-code\\\",\\n  version,\\n  ...(metadata?.revision ? { revision: metadata.revision } : {}),\\n  ...(metadata?.builtAt ? { builtAt: metadata.builtAt } : {}),\\n  prefix,\\n  installedPath,\\n  binPath,\\n  managed: true,\\n  archive,\\n  archiveSha256,\\n};\\nfs.writeFileSync(output, `${JSON.stringify(record, null, 2)}\\\\n`, { mode: 0o644 });\\nfs.chmodSync(output, 0o644);\\nNODE\\n# Make the package move and provenance durable before the launcher points at\\n# them, then make the launcher switch itself durable.\\nsync\\nNEXT=\\\"$BIN_DIR/.nexus-link.$$\\\"\\nln -s \\\"$VERSION_DIR/bin/nexus\\\" \\\"$NEXT\\\"\\nmv -f \\\"$NEXT\\\" \\\"$LINK\\\"\\nsync\\nprintf 'Installed Nexus Code %s in %s\\\\n' \\\"$VERSION\\\" \\\"$VERSION_DIR\\\"\\ncase \\\":$PATH:\\\" in *\\\":$BIN_DIR:\\\"*) ;; *) printf 'Add this to your shell profile if needed: export PATH=\\\"%s:$PATH\\\"\\\\n' \\\"$BIN_DIR\\\" ;; esac\\n\\\"$LINK\\\" --version\\neval/package_runtime.test.mjs\\n# Nexus Code v1.1.2 Qualification Record\\n\\n**Status as of 2026-11-03: corrected RC2 source gates passed; artifact, installed-candidate, and publication qualification remain open.**\\nThis record tracks the v1.1.2 candidate on branch `v1/v112-wp1101-integration`, covering the full WP-1101 through WP-1108 scope and release gates G1.1-1 through G1.1-5 in accordance with the [v1.1.0 roadmap](../v1.1.0/ROADMAP.md) and [v1.1.2 roadmap](../v1.1.2/ROADMAP.md). The package metadata is synchronized at `1.1.2-rc.2`. After correcting CERI provenance to use the package build identity, `make test` passed 2,314 of 2,319 tests with 0 failures and 5 skips, including the terminal process-scope fixtures; the security lifecycle gates passed and `make build` passed (including TypeScript type checking). Full-suite log SHA-256: `39cad26938be30dbb4b073a4d93e62a80aa920789e751cccba5465795eb362bd`. The regression test was RED against the old RC1 provenance and its focused green run passed 3/3 tests (log SHA-256 `61e0eab4c25d6071a8fb4b22f541a3248759bc0997c0b1124183ead05531a0b4`). The corrected candidate is based on source commit `f6d474a4` with RC2 package metadata and the CERI provenance fix; a clean exact commit build and fresh RC2 archive are still required.\\n\\nThe v1.1.0 release failed and published no release files. v1.1.1 is the immutable published predecessor. The earlier RC1 package archive is historical and is not eligible for release. The current source candidate is being advanced to RC2; no RC2 archive or installed-candidate evidence has been produced yet.\\n\\n## Current v1.1.2 roadmap alignment\\n\\nThe candidate branch `v1/v112-wp1101-integration` contains the WP-1101–WP-1108 release scope. The current [Specialist Orchestration and Independent Review roadmap](../v1.1.2/ROADMAP.md) separately records items that were cut or remain unconnected; they are not qualified by the WP evidence below:\\n\\n| Roadmap item | Current source state | v1.1.2 qualification status |\\n|---|---|---|\\n| Item 1 — Specialist contracts | Runtime roles, contracts, and tool permissions connected; PR #396 review fixes present. | **PASSED.** Verified via specialist profile and runtime tests. |\\n| Item 2 — Independent review boundary | Reviewer evidence packaging and verdict gating connected. | **PASSED.** Verified via boundary, verifier, and operation tests. |\\n| Item 3 — Deterministic micro-routing | The roadmap records this item as cut. | **CUT; not a release qualification claim.** |\\n| Item 4 — Multi-stage escalation | The roadmap records this item as cut; recovery behavior is supplied by PR #398. | **CUT; not a release qualification claim.** |\\n| Item 5 — Telemetry-informed throttle | The roadmap says this is not yet connected to request latency. | **NOT CONNECTED; not qualified.** |\\n| Item 6 — Comparative evaluation harness | The roadmap says the comparative harness entry point is not yet connected. | **NOT CONNECTED; not qualified.** |\\n| Item 7 — CERI | The roadmap says the `nexus eval` entry point is not yet connected. | **NOT CONNECTED; not qualified.** |\\n\\n## Work-package status\\n\\n| Package | Required outcome | Observed evidence | Status | Evidence details |\\n|---|---|---|---|---|\\n| WP-1101 — OpenTelemetry local tracing | Local GenAI spans for turns, model requests, tools, and compactions; credentials protected and trace output confined. | Lifecycle instrumentation integrated in commit `97945557`, extending the existing local recorder. Public worktree-backed turns emit exactly one turn span; all four direct model request sites, tool dispatch, and compaction paths are traced with payload-free attributes. | **PASSED** | Fresh independent review APPROVED. The corrected RC2 source suite passed 2,314/0/5 on the candidate based on `f6d474a4`; its full log SHA-256 is `39cad26938be30dbb4b073a4d93e62a80aa920789e751cccba5465795eb362bd`. Earlier WP-1101 integration evidence summary SHA-256 `e795474bab9a71c0ecd0bdedffef8db5ceeaff81935ab3f7edbb964c7d741e17`. |\\n| WP-1102 — Flight recorder credential redaction | Zero-leak sanitization across traces, CLI errors, and debug journals. | Integrated in commit `9c1926e1`. Comprehensive regex + token redactor applied across all flight recorder sinks. | **PASSED** | Validated in `cli/test/*_redaction.test.ts` (22/22 passed across all sinks and adversarial fixtures). |\\n| WP-1103 — Versioned evaluation datasets | Versioned datasets with separate examples/oracles and regression/benchmark splits; candidate prompts cannot access oracles. | Integrated in commit `11f41ed0`. Serialized complete CLI suite passed (2,251 tests). Process-scope fixtures passed with zero orphaned processes. 6-task installed acceptance passed. | **PASSED** | Manifest SHA-256 `05ee2fa33ae5f6d6afc35df2e003c913de3f7bf0f817d2f76c709c16fb640d43`. Evidence preserved in `docs/evidence/v1/wp-1103-g1.1-2/acceptance-28d79f3b0f4d.json`. |\\n| WP-1104 — Standalone `nexus eval` | Packaged command supports dataset selection, run count, isolated home, and structured score output. | Integrated in commit `11f41ed0`. Verified package parity and standalone CLI execution outside repository checkout. | **PASSED** | Validated in `eval/package_runtime.test.mjs` (5/5 passed). Verified with isolated HOME, dataset selection, and structured scoring. |\\n| WP-1105 — Deterministic code evaluators | Modular AST, build, typecheck, diff-boundary, and JSON-repair evaluators. | Integrated in commit `e2bacf1a`. Deterministic evaluators wired into runner and scorer. | **PASSED** | Validated in `cli/test/code_evaluators.test.ts` (9/9 passed). |\\n| WP-1106 — Single-step loop mode | `--step` and `/step` pause deterministically after one agent turn for operator confirmation. | Integrated in commits `1cc28f94` and `faca6e6c`. CLI flag `--step`, REPL `/step`, and TUI `/step` catalogue entry with session command handler. | **PASSED** | Validated in `cli/test/step_loop.test.ts` (8/8 passed) and `cli/test/slash_router.test.ts` (34/34 passed). |\\n| WP-1107 — GBNF tool grammar | Generate tool-schema grammars and integrate supported provider paths. | Integrated in commit `1518780d`. Bounded schema compiler with property type validation and grammar generation. | **PASSED** | Validated in `cli/test/tool_grammar.test.ts` (4/4 passed). |\\n| WP-1108 — Dependency modernization | Triage and integrate 27 Dependabot updates while meeting zero-deprecation and compatibility requirements. | Integrated in commit `5f1f0677`. All 27 Dependabot PRs triaged and merged. `cargo deny check` clean. Zero deprecated npm packages. | **PASSED** | Merged CycloneDX SBOM generated (141 total components: 119 Cargo + 20 npm). glibc <= 2.35 verified on Rust binaries. |\\n\\n## Release-gate status\\n\\n| Gate | Required proof | Current evidence | Status |\\n|---|---|---|---|\\n| G1.1-1 — Zero-leak tracing | Valid OTel GenAI spans for all required turn steps, no credential leakage, and writes confined to the approved trace directory. | Lifecycle, request, tool, compaction, redaction, and path-safety tests passed on source `97945557`; the exact-source full suite and process-scope acceptance passed. | **SOURCE PASSED; package qualification pending** |\\n| G1.1-2 — Dataset decoupling | All benchmark tasks execute and no oracle data reaches candidate prompts; exact candidate and process-scope evidence retained. | Prior six-task package evidence is bound to the historical `9c1926e1` archive, not source `97945557`. Rebuild and rerun installed-candidate acceptance. | **REQUALIFICATION REQUIRED** |\\n| G1.1-3 — CLI parity | Packaged `nexus eval` works without developer dependencies on the exact release candidate. | Prior package parity evidence predates `97945557`; rebuild the archive and rerun standalone CLI parity on the new package. | **REQUALIFICATION REQUIRED** |\\n| G1.1-4 — Constrained decoding | At least 99.5% valid tool-call JSON across supported provider endpoints. | Source grammar tests passed in the final-source suite; bind the supported-endpoint metric to the rebuilt release candidate. | **SOURCE PASSED; package qualification pending** |\\n| G1.1-5 — Zero technical debt | Zero deprecated/unmaintained packages, zero CodeQL alerts and compiler warnings, plus required suite/PTY, cargo-deny, npm scans, reproducibility, and CLI option compatibility without breaking unprivileged sandbox invariants. | Corrected RC2 full suite, TypeScript build, npm/cargo security scans, and terminal process-scope fixtures passed. Package checksums, SBOM, installer, reproducibility, and CLI option compatibility remain pending for the fresh archive. | **SOURCE GATES PASSED; artifact gates pending** |\\n\\n## Historical RC1 artifact (not release-qualified)\\n\\nThe exact release candidate distribution archive was built using the approved digest-pinned Bookworm builder (`rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb`):\\n\\n- **Package Archive:** `nexus-linux-x86_64-v1.1.2-rc.1.tar.gz` (superseded; do not publish)\\n  - **SHA-256 Digest:** `28d79f3b0f4d5047848af9f94ac5f7d052daa8868f66d142581f169e5b753e08`\\n  - **Commit Revision:** `9c1926e15d4d3efb20738edaf3e04610118589aa`\\n  - **Built At:** `2026-11-03T02:38:20Z`\\n  - **Platform:** `linux-x86_64` (libc: `glibc-2.35`)\\n  - **Internal Component Digests:**\\n    - Launcher: `320d7dc1603d30f863a9560a9101ab3fe1a57f164b7119c49e01d9ace40792c4`\\n    - CLI Bundle: `b35396a1814a54e896b620edfa8abef8b9890352ea66c927b3c3851a87dd51da`\\n    - Core Binary: `7b442f320827a532319f6a7662abb5ff22216ea8f603bd9c10591f61830d4a07`\\n- **CycloneDX Software Bill of Materials (SBOM):** `sbom.cdx.json`\\n  - Total Components: 141 (119 Cargo crates + 20 npm packages + root product)\\n- **Compatibility Contract:** `compatibility.json`\\n  - Config Schema Version: 1\\n  - State Schema Version: 2\\n- **Candidate Benchmark Acceptance Evidence:**\\n  - `docs/evidence/v1/wp-1103-g1.1-2/acceptance-28d79f3b0f4d.json`\\n  - Manifest SHA-256: `05ee2fa33ae5f6d6afc35df2e003c913de3f7bf0f817d2f76c709c16fb640d43`\\n\\n## Exact-candidate release checklist\\n\\n- [ ] All WP-1101–WP-1108 acceptance evidence and test suites are bound to the final candidate.\\n- [ ] Current v1.1.2 roadmap items and release gates are qualified on the final candidate.\\n- [x] Prior RC2 full source suite, security lifecycle scans, `make build`/TypeScript type build, and terminal process-scope acceptance passed before the CERI provenance correction.\\n- [x] Corrected RC2 full source suite, security scans, and type build passed on the source candidate based on `f6d474a4`; rerun once more on the clean commit that binds the final artifact.\\n- [ ] Release scans, package checksums, SBOM, installer behavior, and reproducibility verified for the final archive.\\n- [ ] CLI option compatibility and installed-candidate acceptance verified for the final archive.\\n- [ ] Acceptance evidence and qualification record committed for the final candidate.\\n- [ ] Tag `v1.1.2` and release publication (reserved for repository owner `mikeholownych`).\\n\"}]"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","create_time":1793733625.2329051}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
