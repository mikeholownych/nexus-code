{"timestamp":"2026-11-03T21:17:27.020Z","ordinal":82991,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":1667497279,"cached_input_tokens":1654838912,"cache_write_input_tokens":0,"output_tokens":2986938,"reasoning_output_tokens":1534885,"total_tokens":1670484217},"last_token_usage":{"input_tokens":114557,"cached_input_tokens":114176,"cache_write_input_tokens":0,"output_tokens":81,"reasoning_output_tokens":0,"total_tokens":114638},"last_usage_includes_reasoning":true,"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":1.0,"window_minutes":300,"resets_at":1793758232},"secondary":{"used_percent":53.0,"window_minutes":10080,"resets_at":1794123386},"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"plus","rate_limit_reached_type":null}}}
