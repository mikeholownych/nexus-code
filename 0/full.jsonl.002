aders); undefined when absent. */\\ncli/src/core/provider_capabilities.ts:283:  const source: CountSource | undefined = !raw ? undefined : !estimated && declared === \\\"exact\\\" ? \\\"exact_admitted\\\" : \\\"gateway_conservative\\\";\\ncli/src/core/operation_runner_execution.ts:201:      taskClass: resource.taskClass ?? unit?.taskClass ?? base.taskClass,\\ncli/src/core/roles.ts:133:  /** X-Task-Class routing hint for gateways that route by task class. */\\ncli/src/core/roles.ts:134:  taskClass?: string;\\ncli/src/core/roles.ts:138:  researcher: { qualification: \\\"research\\\", capabilities: [\\\"tools\\\"], taskClass: \\\"subagent\\\" },\\ncli/src/core/roles.ts:139:  architect: { qualification: \\\"architecture\\\", capabilities: [\\\"tools\\\"], taskClass: \\\"architecture\\\" },\\ncli/src/core/roles.ts:141:  tester: { qualification: \\\"verification\\\", capabilities: [\\\"tools\\\"], taskClass: \\\"review\\\" },\\ncli/src/core/roles.ts:142:  reviewer: { qualification: \\\"review\\\", capabilities: [\\\"tools\\\"], taskClass: \\\"review\\\" },\\ncli/src/core/roles.ts:143:  semantic_explorer: { qualification: \\\"research\\\", capabilities: [\\\"tools\\\"], taskClass: \\\"subagent\\\" },\\ncli/src/core/roles.ts:144:  call_site_analyzer: { qualification: \\\"research\\\", capabilities: [\\\"tools\\\"], taskClass: \\\"subagent\\\" },\\ncli/src/core/roles.ts:145:  failure_debugger: { qualification: \\\"verification\\\", capabilities: [\\\"tools\\\"], taskClass: \\\"review\\\" },\\ncli/src/core/roles.ts:146:  security_reviewer: { qualification: \\\"review\\\", capabilities: [\\\"tools\\\"], taskClass: \\\"review\\\" },\\ncli/src/core/roles.ts:147:  acceptance_reviewer: { qualification: \\\"review\\\", capabilities: [\\\"tools\\\"], taskClass: \\\"review\\\" },\\ncli/src/core/operation.ts:131:  /** X-Task-Class routing hint for this unit (used when the resource has none of its own). */\\ncli/src/core/operation.ts:132:  taskClass?: string;\\ncli/src/core/operation.t