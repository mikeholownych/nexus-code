uncated\", `reply cut off at the output limit: ${err.truncatedCalls.map((c) => c.name).join(\", \") || \"text\"}; nothing ran`);\n          this.messages.push(harnessNoteMessage(truncatedReplyNotice(err.truncatedCalls, activeClient.getOutputAllowance?.(), `subagent step ${currentStep}`)));\n          tracker.evaluateStep(cumulativeStep, { stateBefore: state, stateAfter: state, verdicts: [] });\n          currentStep++;\ncli/src/session.ts:130:  public saveSession(session: Partial<SessionData> & { id: string }, workspacePath?: WorkspacePath): void {\ncli/src/session.ts:131:    return withStateStoreGuard(this.sessionsDir, () => this.saveSessionLocked(session, workspacePath));\ncli/src/session.ts:134:  private saveSessionLocked(\ncli/src/session.ts:173:      contextInventory: isContextInventorySnapshot(session.contextInventory) &&\ncli/src/session.ts:174:          (!session.contextInventory.sessionId || session.contextInventory.sessionId === sessionId) &&\ncli/src/session.ts:175:          (!session.contextInventory.workspace || path.resolve(session.contextInventory.workspace) === path.resolve(workspace))\ncli/src/session.ts:176:        ? session.contextInventory\ncli/src/session.ts:296:      if (session.contextInventory !== undefined && !isContextInventorySnapshot(session.contextInventory)) delete session.contextInventory;\ncli/src/session.ts:297:      else if (session.contextInventory) session.contextInventory = markPersistedContextFreshnessUnknown(session.contextInventory);\ncli/src/session.ts:404:        this.saveSessionLocked({\ncli/src/core/state.ts:182:  contextInventory?: ContextInventorySnapshot;\ncli/src/agent.ts:161:  private progressListener?: () => void;\ncli/src/agent.ts:307:  private lastRequestCount?: RequestCount & { estimate: number; step: number; admitted?: AdmissionReport; workerDiffers?: boolean };\ncli/src/agent.ts:1485:    this.progressListener = listener;\ncli/src/agent.ts:1634:      this.progressListener?.();\ncli/src/agent.ts:2528:    const las