{"timestamp":"2026-11-03T20:04:15.969Z","ordinal":80231,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"McpToolCall","id":"exec-63b72e29-78a9-4c8c-9e26-fee7417713de","server":"xerj","tool":"xerj_search","arguments":{"prefix":"wp1107-vllm","query":"guided_json structured_outputs function tools tool calling coexist request JSON schema","size":5,"max_tokens":3000},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body`, `text` are `semantic_text`, but this query scored them with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /wp1107-vllm-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"guided_json structured_outputs function tools tool calling coexist request JSON schema\",\"k\":10}}}}}]},\"took\":671,\"timed_out\":false,\"_shards\":{\"total\":1,\"successful\":1,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":230,\"relation\":\"eq\"},\"max_score\":46.125355,\"hits\":[{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"3f424f28fdb48d5d36b83bc38553fdc8\",\"_score\":46.125355,\"_source\":{\"title\":\"protocol.py\",\"ax_path\":\"vllm/entrypoints/openai/chat_completion/protocol.py\",\"ax_file\":\"axf2-dd2a7d79bec66e262e311cb6cec4b8a8-cc0e\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":826,\"start_offset\":33255,\"end_offset\":34361,\"text\":\"@model_validator(mode=\\\"before\\\")\\n    @classmethod\\n    def validate_response_format(cls, data):\\n        if not isinstance(data, dict):\\n            return data\\n        response_format = data.get(\\\"response_format\\\")\\n        if response_format is None:\\n            return data\\n\\n        rf_type = (\\n            response_format.get(\\\"type\\\")\\n            if isinstance(response_format, dict)\\n            else getattr(response_format, \\\"type\\\", None)\\n        )\\n\\n        if rf_type == \\\"json_schema\\\":\\n            json_schema = (\\n                response_format.get(\\\"json_schema\\\")\\n                if isinstance(response_format, dict)\\n                else getattr(response_format, \\\"json_schema\\\", None)\\n            )\\n            if json_schema is None:\\n                raise VLLMValidationError(\\n                    \\\"When response_format type is 'json_schema', the \\\"\\n                    \\\"'json_schema' field must be provided.\\\",\\n                    parameter=\\\"response_format\\\",\\n                )\\n\\n        if rf_type == \\\"structural_tag\\\":\\n            validate_structural_tag_response_format(response_format)\\n\\n        return data\"}]}},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"0d8c6a078a62f0de0f8dca11d8e0f884\",\"_score\":44.112354,\"_source\":{\"title\":\"protocol.py\",\"ax_path\":\"vllm/entrypoints/openai/responses/protocol.py\",\"ax_file\":\"axf2-195f0982d65a65cf4d9d7efbebbf7469-a3e1\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":550,\"start_offset\":19637,\"end_offset\":20802,\"text\":\"def extract_structured_outputs(self) -> StructuredOutputsParams | None:\\n        \\\"\\\"\\\"Normalize request constraints into ``StructuredOutputsParams``.\\\"\\\"\\\"\\n        if self._parser_structured_outputs is not None:\\n            return self._parser_structured_outputs\\n        if self.text is None or self.text.format is None:\\n            return self.structured_outputs\\n\\n        if self.structured_outputs is not None:\\n            raise VLLMValidationError(\\n                \\\"Cannot specify both structured_outputs and text.format\\\",\\n                parameter=\\\"structured_outputs\\\",\\n            )\\n\\n        response_format = self.text.format\\n        if response_format.type == \\\"json_object\\\":\\n            return StructuredOutputsParams(json_object=True)\\n        if (\\n            response_format.type == \\\"json_schema\\\"\\n            and response_format.schema_ is not None\\n        ):\\n            return StructuredOutputsParams(\\n                json=response_format.schema_  # type: ignore[call-arg]\\n                # --follow-imports skip hides the class definition but also hides\\n                # multiple third party conflicts, so best of both evils\\n            )\\n        return None\"}]},\"match_line\":552,\"match_lines\":[552,556,558,560,561,572]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"ccf0860265ea8b42671be15446da628a\",\"_score\":42.197716,\"_source\":{\"title\":\"sampling_params.py\",\"ax_path\":\"vllm/sampling_params.py\",\"ax_file\":\"axf2-254afc553bad202a73eafa29b6eeb6e5-1079e\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":0,\"start_offset\":0,\"end_offset\":2041,\"text\":\"# SPDX-License-Identifier: Apache-2.0\\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\\n\\\"\\\"\\\"Sampling parameters for text generation.\\\"\\\"\\\"\\n\\nimport copy\\nimport json as json_mod\\nimport math\\nfrom dataclasses import field\\nfrom enum import Enum, IntEnum\\nfrom functools import cached_property\\nfrom typing import TYPE_CHECKING, Annotated, Any\\n\\nimport msgspec\\nimport numpy as np\\nfrom pydantic import BeforeValidator, GetPydanticSchema, StrictInt\\nfrom pydantic.dataclasses import dataclass\\n\\nimport vllm.envs as envs\\nfrom vllm.config import ModelConfig, SpeculativeConfig, StructuredOutputsConfig\\nfrom vllm.exceptions import VLLMValidationError\\nfrom vllm.logger import init_logger\\nfrom vllm.tokenizers import TokenizerLike\\nfrom vllm.utils.mistral import is_mistral_tokenizer\\nfrom vllm.utils.torch_utils import make_ndarray_with_pad\\nfrom vllm.v1.serial_utils import PydanticMsgspecMixin\\n\\nif TYPE_CHECKING:\\n    from vllm.config import VllmConfig\\n\\nlogger = init_logger(__name__)\\n\\n_SAMPLING_EPS = 1e-5\\n_MAX_TEMP = 1e-2\\n\\nMAX_LOGPROB_TOKEN_IDS = 128\\n\\\"\\\"\\\"Upper bound on `SamplingParams.logprob_token_ids` list length. Must match\\nthe per-request row width allocated by the sampler's `LogprobTokenIdsState`.\\\"\\\"\\\"\\n\\nMAX_STRUCTURED_OUTPUT_JSON_NESTING = 64\\n\\\"\\\"\\\"Upper bound on nested objects and arrays in a structured-output JSON schema\\nor structural tag. Grammar conversion runs on the API server and its cost grows\\nsteeply with nesting. OpenAI allows 10 levels of schema nesting.\\\"\\\"\\\"\\n\\nSTRUCTURAL_TAG_WRAPPER_NESTING = 16\\n\\\"\\\"\\\"Extra nesting allowed for a structural tag, which wraps its JSON schemas in\\ntag structure (up to 15 levels for tool-call tags generated by tool parsers).\\\"\\\"\\\"\\n\\n\\ndef _verify_num_sequences(value: int, parameter_name: str) -> None:\\n    if not isinstance(value, int):\\n        raise VLLMValidationError(\\n            f\\\"{parameter_name} must be an int, but is of type {type(value)}\\\"\\n        )\\n    if value < 1:\\n        raise VLLMValidationError(f\\\"{parameter_name} must be at least 1, got {value}.\\\")\\n    max_n = envs.VLLM_MAX_N_SEQUENCES\"}]},\"match_line\":37,\"match_lines\":[6,37,40,42,45,46]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"e517c4f75ed83d22efbc751bbf62cf09\",\"_score\":35.041912,\"_source\":{\"title\":\"envs.py\",\"ax_path\":\"vllm/envs.py\",\"ax_file\":\"axf2-a2916a3078f8d7b850eb9c99a42f61b7-1ea88\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":1901,\"start_offset\":90917,\"end_offset\":92938,\"text\":\"    # NVFP4 MoE CUTLASS Kernel. This value is used to create a buffer for\\n    # the blockscale tensor of activations NVFP4 Quantization.\\n    # This is used to prevent the kernel from running out of memory.\\n    \\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\": lambda: int(\\n        os.getenv(\\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\", \\\"163840\\\")\\n    ),\\n    # MoE routing strategy selector.\\n    # See `RoutingSimulator.get_available_strategies()` # for available\\n    # strategies.\\n    # Custom routing strategies can be registered by\\n    # RoutingSimulator.register_strategy()\\n    # Note: custom strategies may not produce correct model outputs\\n    \\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\": lambda: os.environ.get(\\n        \\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\", \\\"\\\"\\n    ).lower(),\\n    # Regex timeout for use by the vLLM tool parsing plugins.\\n    \\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\": lambda: int(\\n        os.getenv(\\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\", \\\"1\\\")\\n    ),\\n    # Enforce function parameter schemas in structural-tag based tool calling.\\n    \\\"VLLM_ENFORCE_STRICT_TOOL_CALLING\\\": lambda: (\\n        os.getenv(\\\"VLLM_ENFORCE_STRICT_TOOL_CALLING\\\", \\\"True\\\").lower() in (\\\"true\\\", \\\"1\\\")\\n    ),\\n    # Constrain every `beam` output to its response template's format, also\\n    # without tool or structured output constraints.\\n    \\\"VLLM_BEAM_ALWAYS_CONSTRAIN_OUTPUT\\\": lambda: (\\n        os.getenv(\\\"VLLM_BEAM_ALWAYS_CONSTRAIN_OUTPUT\\\", \\\"True\\\").lower() in (\\\"true\\\", \\\"1\\\")\\n    ),\\n    # Control the max chunk bytes (in MB) for the rpc message queue.\\n    # Object larger than this threshold will be broadcast to worker\\n    # processes via zmq.\\n    \\\"VLLM_MQ_MAX_CHUNK_BYTES_MB\\\": lambda: int(\\n        os.getenv(\\\"VLLM_MQ_MAX_CHUNK_BYTES_MB\\\", \\\"16\\\")\\n    ),\\n    # Timeout in seconds for execute_model RPC calls in multiprocessing\\n    # executor (only applies when TP > 1).\\n    \\\"VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS\\\": lambda: int(\\n        os.getenv(\\\"VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS\\\", \\\"300\\\")\\n    ),\\n    # Timeout in seconds for engine and worker process shutdown\"}]},\"match_line\":1921,\"match_lines\":[1917,1921,1926]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"397b6fb2a7bb0a5b325ef2dfab3931e9\",\"_score\":31.107132,\"_source\":{\"title\":\"utils.py\",\"ax_path\":\"vllm/entrypoints/openai/responses/utils.py\",\"ax_file\":\"axf2-ef3da54eca3c0b130df61c4eb4187f52-551b\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":573,\"start_offset\":20866,\"end_offset\":21360,\"text\":\"def convert_tool_responses_to_completions_format(\\n    tool: dict,\\n) -> ChatCompletionToolsParam:\\n    \\\"\\\"\\\"Convert a flat Responses tool schema:\\n        {\\\"type\\\": \\\"function\\\", \\\"name\\\": \\\"...\\\", \\\"description\\\": \\\"...\\\", \\\"parameters\\\": {...}}\\n    into a Chat Completions tool param for chat-template rendering.\\n    \\\"\\\"\\\"\\n    return ChatCompletionToolsParam(\\n        type=\\\"function\\\",\\n        function=FunctionDefinition.model_validate(\\n            {k: v for k, v in tool.items() if k != \\\"type\\\"}\\n        ),\\n    )\"}]},\"match_line\":577,\"match_lines\":[575,577,578,579,582,583,584]}]}}"}],"isError":false},"duration":{"secs":0,"nanos":743712602}},"started_at_ms":1793736255225,"completed_at_ms":1793736255969}}
{"timestamp":"2026-11-03T20:04:17.509Z","ordinal":80232,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"McpToolCall","id":"exec-528045ba-caa4-4665-a356-0b3765015f7b","server":"xerj","tool":"xerj_search","arguments":{"prefix":"wp1107-vllm","query":"structured outputs guided_json request field tools chat completion parameter","size":5,"max_tokens":3000},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body`, `text` are `semantic_text`, but this query scored them with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /wp1107-vllm-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"structured outputs guided_json request field tools chat completion parameter\",\"k\":10}}}}}]},\"took\":231,\"timed_out\":false,\"_shards\":{\"total\":1,\"successful\":1,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":267,\"relation\":\"eq\"},\"max_score\":49.394577,\"hits\":[{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"154870edc787c553efb1e529838a318b\",\"_score\":49.394577,\"_source\":{\"title\":\"llm.py\",\"ax_path\":\"vllm/entrypoints/llm.py\",\"ax_file\":\"axf2-afd034156e6a8edc32d1168aef99ae76-a5ef\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":262,\"start_offset\":13214,\"end_offset\":13569,\"text\":\"def _make_config(value: Any, cls: type[_R]) -> _R:\\n            \\\"\\\"\\\"Convert dict/None/instance to a config instance.\\\"\\\"\\\"\\n            if value is None:\\n                return cls()\\n            if isinstance(value, dict):\\n                return cls(**{k: v for k, v in value.items() if is_init_field(cls, k)})  # type: ignore[arg-type]\\n            return value\"}]}},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"3f424f28fdb48d5d36b83bc38553fdc8\",\"_score\":42.273018,\"_source\":{\"title\":\"protocol.py\",\"ax_path\":\"vllm/entrypoints/openai/chat_completion/protocol.py\",\"ax_file\":\"axf2-dd2a7d79bec66e262e311cb6cec4b8a8-cc0e\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":930,\"start_offset\":37396,\"end_offset\":39030,\"text\":\"@model_validator(mode=\\\"before\\\")\\n    @classmethod\\n    def check_structured_outputs_count(cls, data):\\n        if isinstance(data, ValueError):\\n            raise data\\n        if not isinstance(data, dict):\\n            return data\\n\\n        if data.get(\\\"structured_outputs\\\", None) is None:\\n            return data\\n\\n        structured_outputs_kwargs = data[\\\"structured_outputs\\\"]\\n        # structured_outputs may arrive as a dict (from JSON/raw kwargs) or\\n        # as a StructuredOutputsParams dataclass instance.\\n        is_dataclass = isinstance(structured_outputs_kwargs, StructuredOutputsParams)\\n        count = sum(\\n            (\\n                getattr(structured_outputs_kwargs, k, None)\\n                if is_dataclass\\n                else structured_outputs_kwargs.get(k)\\n            )\\n            is not None\\n            for k in (\\\"json\\\", \\\"regex\\\", \\\"choice\\\")\\n        )\\n        # you can only use one kind of constraints for structured outputs\\n        if count > 1:\\n            raise VLLMValidationError(\\n                \\\"You can only use one kind of constraints for structured \\\"\\n                \\\"outputs ('json', 'regex' or 'choice').\\\",\\n            )\\n        # you can only either use structured outputs or tools, not both\\n        if count > 0 and data.get(\\\"tool_choice\\\", \\\"none\\\") not in (\\n            \\\"none\\\",\\n            \\\"auto\\\",\\n            \\\"required\\\",\\n        ):\\n            raise VLLMValidationError(\\n                \\\"You can only either use constraints for structured outputs \\\"\\n                \\\"or tools, not both.\\\",\\n            )\\n        validate_structured_outputs_structural_tag(structured_outputs_kwargs)\\n        return data\"}]},\"match_line\":961,\"match_lines\":[955,958,959,961,968,969]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"ccf0860265ea8b42671be15446da628a\",\"_score\":35.86368,\"_source\":{\"title\":\"sampling_params.py\",\"ax_path\":\"vllm/sampling_params.py\",\"ax_file\":\"axf2-254afc553bad202a73eafa29b6eeb6e5-1079e\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":0,\"start_offset\":0,\"end_offset\":2041,\"text\":\"# SPDX-License-Identifier: Apache-2.0\\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\\n\\\"\\\"\\\"Sampling parameters for text generation.\\\"\\\"\\\"\\n\\nimport copy\\nimport json as json_mod\\nimport math\\nfrom dataclasses import field\\nfrom enum import Enum, IntEnum\\nfrom functools import cached_property\\nfrom typing import TYPE_CHECKING, Annotated, Any\\n\\nimport msgspec\\nimport numpy as np\\nfrom pydantic import BeforeValidator, GetPydanticSchema, StrictInt\\nfrom pydantic.dataclasses import dataclass\\n\\nimport vllm.envs as envs\\nfrom vllm.config import ModelConfig, SpeculativeConfig, StructuredOutputsConfig\\nfrom vllm.exceptions import VLLMValidationError\\nfrom vllm.logger import init_logger\\nfrom vllm.tokenizers import TokenizerLike\\nfrom vllm.utils.mistral import is_mistral_tokenizer\\nfrom vllm.utils.torch_utils import make_ndarray_with_pad\\nfrom vllm.v1.serial_utils import PydanticMsgspecMixin\\n\\nif TYPE_CHECKING:\\n    from vllm.config import VllmConfig\\n\\nlogger = init_logger(__name__)\\n\\n_SAMPLING_EPS = 1e-5\\n_MAX_TEMP = 1e-2\\n\\nMAX_LOGPROB_TOKEN_IDS = 128\\n\\\"\\\"\\\"Upper bound on `SamplingParams.logprob_token_ids` list length. Must match\\nthe per-request row width allocated by the sampler's `LogprobTokenIdsState`.\\\"\\\"\\\"\\n\\nMAX_STRUCTURED_OUTPUT_JSON_NESTING = 64\\n\\\"\\\"\\\"Upper bound on nested objects and arrays in a structured-output JSON schema\\nor structural tag. Grammar conversion runs on the API server and its cost grows\\nsteeply with nesting. OpenAI allows 10 levels of schema nesting.\\\"\\\"\\\"\\n\\nSTRUCTURAL_TAG_WRAPPER_NESTING = 16\\n\\\"\\\"\\\"Extra nesting allowed for a structural tag, which wraps its JSON schemas in\\ntag structure (up to 15 levels for tool-call tags generated by tool parsers).\\\"\\\"\\\"\\n\\n\\ndef _verify_num_sequences(value: int, parameter_name: str) -> None:\\n    if not isinstance(value, int):\\n        raise VLLMValidationError(\\n            f\\\"{parameter_name} must be an int, but is of type {type(value)}\\\"\\n        )\\n    if value < 1:\\n        raise VLLMValidationError(f\\\"{parameter_name} must be at least 1, got {value}.\\\")\\n    max_n = envs.VLLM_MAX_N_SEQUENCES\"}]},\"match_line\":8,\"match_lines\":[8,37,40]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"0d8c6a078a62f0de0f8dca11d8e0f884\",\"_score\":35.291843,\"_source\":{\"title\":\"protocol.py\",\"ax_path\":\"vllm/entrypoints/openai/responses/protocol.py\",\"ax_file\":\"axf2-195f0982d65a65cf4d9d7efbebbf7469-a3e1\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":483,\"start_offset\":16875,\"end_offset\":18754,\"text\":\"def build_chat_params(\\n        self,\\n        default_template: str | None,\\n        default_template_content_format: ChatTemplateContentFormatOption,\\n        reasoning_effort_map: dict[str, str] | None = None,\\n    ) -> ChatParams:\\n        from .utils import should_continue_final_message\\n\\n        # Check if we should continue the final message (partial completion)\\n        # This enables Anthropic-style partial message completion where the\\n        # user provides an incomplete assistant message to continue from.\\n        continue_final = should_continue_final_message(self.input)\\n\\n        reasoning = self.reasoning\\n        reasoning_effort = map_reasoning_effort(\\n            None if reasoning is None else reasoning.effort, reasoning_effort_map\\n        )\\n\\n        extra_kwargs: dict[str, Any] = dict(\\n            add_generation_prompt=not continue_final,\\n            continue_final_message=continue_final,\\n            reasoning_effort=reasoning_effort,\\n        )\\n\\n        # When reasoning is requested, activate thinking for models whose\\n        # chat templates require explicit opt-in (e.g., Gemma4 defaults\\n        # enable_thinking to false). For templates that don't declare the\\n        # variable, resolve_chat_template_kwargs filters it out harmlessly.\\n        user_kwargs = self.chat_template_kwargs or {}\\n        if reasoning_effort is not None and \\\"enable_thinking\\\" not in user_kwargs:\\n            extra_kwargs[\\\"enable_thinking\\\"] = reasoning_effort != \\\"none\\\"\\n\\n        return ChatParams(\\n            chat_template=default_template,\\n            chat_template_content_format=default_template_content_format,\\n            chat_template_kwargs=merge_kwargs(\\n                self.chat_template_kwargs,\\n                extra_kwargs,\\n            ),\\n            media_io_kwargs=self.media_io_kwargs,\\n            tool_choice=self.tool_choice if self.tools else None,\\n        )\"}]},\"match_line\":509,\"match_lines\":[492,493,509,524]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"e517c4f75ed83d22efbc751bbf62cf09\",\"_score\":33.057495,\"_source\":{\"title\":\"envs.py\",\"ax_path\":\"vllm/envs.py\",\"ax_file\":\"axf2-a2916a3078f8d7b850eb9c99a42f61b7-1ea88\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":1899,\"start_offset\":90839,\"end_offset\":92874,\"text\":\"    ),\\n    # Control the maximum number of tokens per expert supported by the\\n    # NVFP4 MoE CUTLASS Kernel. This value is used to create a buffer for\\n    # the blockscale tensor of activations NVFP4 Quantization.\\n    # This is used to prevent the kernel from running out of memory.\\n    \\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\": lambda: int(\\n        os.getenv(\\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\", \\\"163840\\\")\\n    ),\\n    # MoE routing strategy selector.\\n    # See `RoutingSimulator.get_available_strategies()` # for available\\n    # strategies.\\n    # Custom routing strategies can be registered by\\n    # RoutingSimulator.register_strategy()\\n    # Note: custom strategies may not produce correct model outputs\\n    \\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\": lambda: os.environ.get(\\n        \\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\", \\\"\\\"\\n    ).lower(),\\n    # Regex timeout for use by the vLLM tool parsing plugins.\\n    \\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\": lambda: int(\\n        os.getenv(\\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\", \\\"1\\\")\\n    ),\\n    # Enforce function parameter schemas in structural-tag based tool calling.\\n    \\\"VLLM_ENFORCE_STRICT_TOOL_CALLING\\\": lambda: (\\n        os.getenv(\\\"VLLM_ENFORCE_STRICT_TOOL_CALLING\\\", \\\"True\\\").lower() in (\\\"true\\\", \\\"1\\\")\\n    ),\\n    # Constrain every `beam` output to its response template's format, also\\n    # without tool or structured output constraints.\\n    \\\"VLLM_BEAM_ALWAYS_CONSTRAIN_OUTPUT\\\": lambda: (\\n        os.getenv(\\\"VLLM_BEAM_ALWAYS_CONSTRAIN_OUTPUT\\\", \\\"True\\\").lower() in (\\\"true\\\", \\\"1\\\")\\n    ),\\n    # Control the max chunk bytes (in MB) for the rpc message queue.\\n    # Object larger than this threshold will be broadcast to worker\\n    # processes via zmq.\\n    \\\"VLLM_MQ_MAX_CHUNK_BYTES_MB\\\": lambda: int(\\n        os.getenv(\\\"VLLM_MQ_MAX_CHUNK_BYTES_MB\\\", \\\"16\\\")\\n    ),\\n    # Timeout in seconds for execute_model RPC calls in multiprocessing\\n    # executor (only applies when TP > 1).\\n    \\\"VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS\\\": lambda: int(\\n        os.getenv(\\\"VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS\\\", \\\"300\\\")\\n    ),\"}]},\"match_line\":1913,\"match_lines\":[1913,1921,1926]}]}}"}],"isError":false},"duration":{"secs":0,"nanos":283993995}},"started_at_ms":1793736257225,"completed_at_ms":1793736257509}}
{"timestamp":"2026-11-03T20:04:19.218Z","ordinal":80233,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"McpToolCall","id":"exec-4efebd3c-45d0-4401-876b-cc0b81d8d5b2","server":"xerj","tool":"xerj_search","arguments":{"prefix":"wp1107-vllm","query":"GET /version response version field server identification OpenAI API server","size":4,"max_tokens":2000},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body`, `text` are `semantic_text`, but this query scored them with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /wp1107-vllm-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"GET version response field server identification OpenAI API\",\"k\":10}}}}}]},\"took\":226,\"timed_out\":false,\"_shards\":{\"total\":1,\"successful\":1,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":198,\"relation\":\"eq\"},\"max_score\":36.163128,\"hits\":[{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"17f72f6474c93703436b85971719a86c\",\"_score\":36.163128,\"_source\":{\"title\":\"# OpenAI-Compatible Server\",\"ax_path\":\"docs/serving/online_serving/openai_compatible_server.md\",\"ax_file\":\"axf2-edcb9a3e790e379662e30f18d870850a-26e5\",\"ax_locator\":\"s5\",\"start_line\":173},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":0,\"start_offset\":0,\"end_offset\":1956,\"text\":\"`image_url.detail` parameter is not supported.*\\n\\nCode example: [examples/basic/online_serving/openai_chat_completion_client.py](../../../examples/basic/online_serving/openai_chat_completion_client.py)\\n\\nWith `--enable-prompt-tokens-details`, `/v1/chat/completions/batch` sums `cached_tokens`, `created_cache_tokens` and per-modality `multimodal_tokens` across conversations in `usage.prompt_tokens_details`; an unreported cache count makes that total `null`, and disabling the flag leaves the details `null`.\\n\\n#### Extra parameters\\n\\nThe following [sampling parameters](../../api/README.md#inference-parameters) are supported.\\n\\n??? code\\n\\n    ```python\\n    --8<-- \\\"vllm/entrypoints/openai/chat_completion/protocol.py:chat-completion-sampling-params\\\"\\n    ```\\n\\nThe following extra parameters are supported:\\n\\n??? code\\n\\n    ```python\\n    --8<-- \\\"vllm/entrypoints/openai/chat_completion/protocol.py:chat-completion-extra-params\\\"\\n    ```\\n\\n### Responses API\\n\\nOur Responses API is compatible with [OpenAI's Responses API](https://platform.openai.com/docs/api-reference/responses);\\nyou can use the [official OpenAI Python client](https://github.com/openai/openai-python) to interact with it.\\n\\nCode example: [examples/tool_calling/openai_responses_client_with_tools.py](../../../examples/tool_calling/openai_responses_client_with_tools.py)\\n\\nTo get prompt token IDs before generation, use\\n[`/v1/responses/render`](renderer.md#get-responses-prompt-token-ids). It preprocesses\\na self-contained Responses request without inference and returns the prompt\\ntoken IDs, so a separate `/tokenize` call is not needed.\\n\\n#### Sampling parameters\\n\\nIn addition to the OpenAI request fields, the Responses API forwards vLLM\\n[sampling parameters](../../api/README.md#inference-parameters) such as `top_k`,\\n`min_p`, `repetition_penalty`, `seed`, `stop`, and `ignore_eos` to the engine.\\n\\n#### Extra parameters\\n\\nThe following extra parameters in the request object are supported:\\n\\n??? code\"}]},\"match_line\":204,\"match_lines\":[181,197,199,200,204,205,211,212]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"07a851b1843f6c3f317603e2825f75b4\",\"_score\":30.387255,\"_source\":{\"title\":\"ResponsesRequest\",\"ax_path\":\"vllm/entrypoints/openai/responses/protocol.py\",\"ax_file\":\"axf2-195f0982d65a65cf4d9d7efbebbf7469-a3e1\",\"ax_locator\":\"code:247:ResponsesRequest\",\"language\":\"python\",\"path\":\"protocol.py\",\"kind\":\"class\",\"line\":247,\"code\":\"class ResponsesRequest(OpenAIBaseModel):\\n    # Ordered by official OpenAI API documentation\\n    # https://platform.openai.com/docs/api-reference/responses/create\"},\"fields\":{\"_passage\":[{\"field\":\"code\",\"ordinal\":0,\"start_offset\":0,\"end_offset\":161,\"text\":\"class ResponsesRequest(OpenAIBaseModel):\\n    # Ordered by official OpenAI API documentation\\n    # https://platform.openai.com/docs/api-reference/responses/create\"}]},\"match_line\":248,\"match_lines\":[248,249]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"e517c4f75ed83d22efbc751bbf62cf09\",\"_score\":29.355965,\"_source\":{\"title\":\"envs.py\",\"ax_path\":\"vllm/envs.py\",\"ax_file\":\"axf2-a2916a3078f8d7b850eb9c99a42f61b7-1ea88\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":2278,\"start_offset\":111096,\"end_offset\":113085,\"text\":\"    \\\"VLLM_KV_OFFLOAD_MAX_BATCH_DESCRIPTORS\\\": lambda: int(\\n        os.getenv(\\\"VLLM_KV_OFFLOAD_MAX_BATCH_DESCRIPTORS\\\", \\\"0\\\")\\n    ),\\n    # On WSL2 with a compatible kernel (>= 4.19.121), pinned memory is\\n    # supported but disabled by default due to a small performance regression.\\n    # Set to 1 when pinned memory or UVA is required (e.g. CPU offloading\\n    # or v2 model runner).\\n    \\\"VLLM_WSL2_ENABLE_PIN_MEMORY\\\": lambda: bool(\\n        int(os.getenv(\\\"VLLM_WSL2_ENABLE_PIN_MEMORY\\\", \\\"0\\\"))\\n    ),\\n    # Disable logging of vLLM logo at server startup time.\\n    \\\"VLLM_DISABLE_LOG_LOGO\\\": lambda: bool(int(os.getenv(\\\"VLLM_DISABLE_LOG_LOGO\\\", \\\"0\\\"))),\\n    # Disable PDL for LoRA, as enabling PDL with LoRA on SM100 causes\\n    # Triton compilation to fail.\\n    \\\"VLLM_LORA_DISABLE_PDL\\\": lambda: bool(int(os.getenv(\\\"VLLM_LORA_DISABLE_PDL\\\", \\\"0\\\"))),\\n    # Enable CUDA compatibility mode for datacenter GPUs with older\\n    # driver versions than the CUDA toolkit major version of vLLM.\\n    \\\"VLLM_ENABLE_CUDA_COMPATIBILITY\\\": lambda: (\\n        os.environ.get(\\\"VLLM_ENABLE_CUDA_COMPATIBILITY\\\", \\\"0\\\").strip().lower()\\n        in (\\\"1\\\", \\\"true\\\")\\n    ),\\n    # Path to the CUDA compatibility libraries when CUDA compatibility is enabled.\\n    \\\"VLLM_CUDA_COMPATIBILITY_PATH\\\": lambda: os.environ.get(\\n        \\\"VLLM_CUDA_COMPATIBILITY_PATH\\\", None\\n    ),\\n    # Skip model name validation in OpenAI API requests.\\n    # When set to 1, any model name will be accepted in the 'model' field\\n    # of API requests. This is useful for proxy/gateway scenarios where\\n    # the actual model is served but different names may be used in requests.\\n    \\\"VLLM_SKIP_MODEL_NAME_VALIDATION\\\": lambda: (\\n        os.getenv(\\\"VLLM_SKIP_MODEL_NAME_VALIDATION\\\", \\\"0\\\").strip().lower()\\n        in (\\\"1\\\", \\\"true\\\")\\n    ),\\n    # Whether it is a scale up launch engine for elastic EP,\\n    # Should only be set by EngineCoreClient.\\n    \\\"VLLM_ELASTIC_EP_SCALE_UP_LAUNCH\\\": lambda: bool(\\n        int(os.getenv(\\\"VLLM_ELASTIC_EP_SCALE_UP_LAUNCH\\\", \\\"0\\\"))\\n    ),\"}]},\"match_line\":2304,\"match_lines\":[2289,2295,2297,2301,2304,2305,2306]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"3f424f28fdb48d5d36b83bc38553fdc8\",\"_score\":28.587217,\"_source\":{\"title\":\"protocol.py\",\"ax_path\":\"vllm/entrypoints/openai/chat_completion/protocol.py\",\"ax_file\":\"axf2-dd2a7d79bec66e262e311cb6cec4b8a8-cc0e\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":114,\"start_offset\":3221,\"end_offset\":4756,\"text\":\"class ChatCompletionResponseChoice(OpenAIBaseModel):\\n    index: int\\n    # ``SerializeAsAny`` lets pydantic honor subclasses of ``ChatMessage``\\n    # (e.g. ``vllm.entrypoints.cohere.cohere_chat_message.CohereChatMessage``)\\n    # so that added fields like ``citations`` survive JSON serialization\\n    # instead of being stripped down to the base schema. Plain\\n    # ``ChatMessage`` instances serialize identically to before.\\n    message: SerializeAsAny[ChatMessage]\\n    logprobs: ChatCompletionLogProbs | None = None\\n    # per OpenAI spec this is the default\\n    finish_reason: str | None = \\\"stop\\\"\\n    # not part of the OpenAI spec but included in vLLM for legacy reasons\\n    stop_reason: int | str | None = None\\n    # not part of the OpenAI spec but is useful for tracing the tokens\\n    # in agent scenarios\\n    token_ids: list[int] | None = None\\n    # Per-token expert routing decisions, base64-encoded ``.npy`` bytes\\n    # (numpy serialization). Shape after decode:\\n    #   (num_tokens - 1, num_layers, num_experts_per_tok) dtype uint8/uint16/int32\\n    # ``num_tokens - 1`` because the last sampled token has not been\\n    # forwarded yet and therefore has no routing data.\\n    # Decode:\\n    #   np.load(io.BytesIO(base64.b64decode(s)))\\n    # ``None`` if (a) the request was aborted before any forward pass,\\n    # or (b) ``enable_return_routed_experts`` is off server-side.\\n    routed_experts: str | None = None\\n    # Contiguous weight version spans over output-token indexes.\\n    weight_versions: list[WeightVersionSpan] | None = None\"}]},\"match_line\":139,\"match_lines\":[124,126,128,139,141]}]}}"}],"isError":false},"duration":{"secs":0,"nanos":315389536}},"started_at_ms":1793736258902,"completed_at_ms":1793736259218}}
{"timestamp":"2026-11-03T20:04:20.780Z","ordinal":80234,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1a303-3cac-7340-906b-52e8d3837a84","call_id":"call_9434e06e851f43368920048cb76b77db","output":[{"type":"input_text","text":"Script completed\nWall time 5.6 seconds\nOutput:\n"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"_xerj\\\":{\\\"hints\\\":[{\\\"code\\\":\\\"lexical_on_semantic_text\\\",\\\"reason\\\":\\\"`body`, `text` are `semantic_text`, but this query scored them with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\\\",\\\"try\\\":{\\\"request\\\":\\\"POST /wp1107-vllm-*/_search\\\",\\\"body\\\":{\\\"query\\\":{\\\"semantic\\\":{\\\"field\\\":\\\"body\\\",\\\"query\\\":\\\"guided_json structured_outputs function tools tool calling coexist request JSON schema\\\",\\\"k\\\":10}}}}}]},\\\"took\\\":671,\\\"timed_out\\\":false,\\\"_shards\\\":{\\\"total\\\":1,\\\"successful\\\":1,\\\"skipped\\\":0,\\\"failed\\\":0},\\\"hits\\\":{\\\"total\\\":{\\\"value\\\":230,\\\"relation\\\":\\\"eq\\\"},\\\"max_score\\\":46.125355,\\\"hits\\\":[{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"3f424f28fdb48d5d36b83bc38553fdc8\\\",\\\"_score\\\":46.125355,\\\"_source\\\":{\\\"title\\\":\\\"protocol.py\\\",\\\"ax_path\\\":\\\"vllm/entrypoints/openai/chat_completion/protocol.py\\\",\\\"ax_file\\\":\\\"axf2-dd2a7d79bec66e262e311cb6cec4b8a8-cc0e\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":826,\\\"start_offset\\\":33255,\\\"end_offset\\\":34361,\\\"text\\\":\\\"@model_validator(mode=\\\\\\\"before\\\\\\\")\\\\n    @classmethod\\\\n    def validate_response_format(cls, data):\\\\n        if not isinstance(data, dict):\\\\n            return data\\\\n        response_format = data.get(\\\\\\\"response_format\\\\\\\")\\\\n        if response_format is None:\\\\n            return data\\\\n\\\\n        rf_type = (\\\\n            response_format.get(\\\\\\\"type\\\\\\\")\\\\n            if isinstance(response_format, dict)\\\\n            else getattr(response_format, \\\\\\\"type\\\\\\\", None)\\\\n        )\\\\n\\\\n        if rf_type == \\\\\\\"json_schema\\\\\\\":\\\\n            json_schema = (\\\\n                response_format.get(\\\\\\\"json_schema\\\\\\\")\\\\n                if isinstance(response_format, dict)\\\\n                else getattr(response_format, \\\\\\\"json_schema\\\\\\\", None)\\\\n            )\\\\n            if json_schema is None:\\\\n                raise VLLMValidationError(\\\\n                    \\\\\\\"When response_format type is 'json_schema', the \\\\\\\"\\\\n                    \\\\\\\"'json_schema' field must be provided.\\\\\\\",\\\\n                    parameter=\\\\\\\"response_format\\\\\\\",\\\\n                )\\\\n\\\\n        if rf_type == \\\\\\\"structural_tag\\\\\\\":\\\\n            validate_structural_tag_response_format(response_format)\\\\n\\\\n        return data\\\"}]}},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"0d8c6a078a62f0de0f8dca11d8e0f884\\\",\\\"_score\\\":44.112354,\\\"_source\\\":{\\\"title\\\":\\\"protocol.py\\\",\\\"ax_path\\\":\\\"vllm/entrypoints/openai/responses/protocol.py\\\",\\\"ax_file\\\":\\\"axf2-195f0982d65a65cf4d9d7efbebbf7469-a3e1\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":550,\\\"start_offset\\\":19637,\\\"end_offset\\\":20802,\\\"text\\\":\\\"def extract_structured_outputs(self) -> StructuredOutputsParams | None:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"Normalize request constraints into ``StructuredOutputsParams``.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        if self._parser_structured_outputs is not None:\\\\n            return self._parser_structured_outputs\\\\n        if self.text is None or self.text.format is None:\\\\n            return self.structured_outputs\\\\n\\\\n        if self.structured_outputs is not None:\\\\n            raise VLLMValidationError(\\\\n                \\\\\\\"Cannot specify both structured_outputs and text.format\\\\\\\",\\\\n                parameter=\\\\\\\"structured_outputs\\\\\\\",\\\\n            )\\\\n\\\\n        response_format = self.text.format\\\\n        if response_format.type == \\\\\\\"json_object\\\\\\\":\\\\n            return StructuredOutputsParams(json_object=True)\\\\n        if (\\\\n            response_format.type == \\\\\\\"json_schema\\\\\\\"\\\\n            and response_format.schema_ is not None\\\\n        ):\\\\n            return StructuredOutputsParams(\\\\n                json=response_format.schema_  # type: ignore[call-arg]\\\\n                # --follow-imports skip hides the class definition but also hides\\\\n                # multiple third party conflicts, so best of both evils\\\\n            )\\\\n        return None\\\"}]},\\\"match_line\\\":552,\\\"match_lines\\\":[552,556,558,560,561,572]},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"ccf0860265ea8b42671be15446da628a\\\",\\\"_score\\\":42.197716,\\\"_source\\\":{\\\"title\\\":\\\"sampling_params.py\\\",\\\"ax_path\\\":\\\"vllm/sampling_params.py\\\",\\\"ax_file\\\":\\\"axf2-254afc553bad202a73eafa29b6eeb6e5-1079e\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":0,\\\"start_offset\\\":0,\\\"end_offset\\\":2041,\\\"text\\\":\\\"# SPDX-License-Identifier: Apache-2.0\\\\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Sampling parameters for text generation.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nimport copy\\\\nimport json as json_mod\\\\nimport math\\\\nfrom dataclasses import field\\\\nfrom enum import Enum, IntEnum\\\\nfrom functools import cached_property\\\\nfrom typing import TYPE_CHECKING, Annotated, Any\\\\n\\\\nimport msgspec\\\\nimport numpy as np\\\\nfrom pydantic import BeforeValidator, GetPydanticSchema, StrictInt\\\\nfrom pydantic.dataclasses import dataclass\\\\n\\\\nimport vllm.envs as envs\\\\nfrom vllm.config import ModelConfig, SpeculativeConfig, StructuredOutputsConfig\\\\nfrom vllm.exceptions import VLLMValidationError\\\\nfrom vllm.logger import init_logger\\\\nfrom vllm.tokenizers import TokenizerLike\\\\nfrom vllm.utils.mistral import is_mistral_tokenizer\\\\nfrom vllm.utils.torch_utils import make_ndarray_with_pad\\\\nfrom vllm.v1.serial_utils import PydanticMsgspecMixin\\\\n\\\\nif TYPE_CHECKING:\\\\n    from vllm.config import VllmConfig\\\\n\\\\nlogger = init_logger(__name__)\\\\n\\\\n_SAMPLING_EPS = 1e-5\\\\n_MAX_TEMP = 1e-2\\\\n\\\\nMAX_LOGPROB_TOKEN_IDS = 128\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Upper bound on `SamplingParams.logprob_token_ids` list length. Must match\\\\nthe per-request row width allocated by the sampler's `LogprobTokenIdsState`.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nMAX_STRUCTURED_OUTPUT_JSON_NESTING = 64\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Upper bound on nested objects and arrays in a structured-output JSON schema\\\\nor structural tag. Grammar conversion runs on the API server and its cost grows\\\\nsteeply with nesting. OpenAI allows 10 levels of schema nesting.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nSTRUCTURAL_TAG_WRAPPER_NESTING = 16\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Extra nesting allowed for a structural tag, which wraps its JSON schemas in\\\\ntag structure (up to 15 levels for tool-call tags generated by tool parsers).\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n\\\\ndef _verify_num_sequences(value: int, parameter_name: str) -> None:\\\\n    if not isinstance(value, int):\\\\n        raise VLLMValidationError(\\\\n            f\\\\\\\"{parameter_name} must be an int, but is of type {type(value)}\\\\\\\"\\\\n        )\\\\n    if value < 1:\\\\n        raise VLLMValidationError(f\\\\\\\"{parameter_name} must be at least 1, got {value}.\\\\\\\")\\\\n    max_n = envs.VLLM_MAX_N_SEQUENCES\\\"}]},\\\"match_line\\\":37,\\\"match_lines\\\":[6,37,40,42,45,46]},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"e517c4f75ed83d22efbc751bbf62cf09\\\",\\\"_score\\\":35.041912,\\\"_source\\\":{\\\"title\\\":\\\"envs.py\\\",\\\"ax_path\\\":\\\"vllm/envs.py\\\",\\\"ax_file\\\":\\\"axf2-a2916a3078f8d7b850eb9c99a42f61b7-1ea88\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":1901,\\\"start_offset\\\":90917,\\\"end_offset\\\":92938,\\\"text\\\":\\\"    # NVFP4 MoE CUTLASS Kernel. This value is used to create a buffer for\\\\n    # the blockscale tensor of activations NVFP4 Quantization.\\\\n    # This is used to prevent the kernel from running out of memory.\\\\n    \\\\\\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\\\\\": lambda: int(\\\\n        os.getenv(\\\\\\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\\\\\", \\\\\\\"163840\\\\\\\")\\\\n    ),\\\\n    # MoE routing strategy selector.\\\\n    # See `RoutingSimulator.get_available_strategies()` # for available\\\\n    # strategies.\\\\n    # Custom routing strategies can be registered by\\\\n    # RoutingSimulator.register_strategy()\\\\n    # Note: custom strategies may not produce correct model outputs\\\\n    \\\\\\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\\\\\": lambda: os.environ.get(\\\\n        \\\\\\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\\\\\", \\\\\\\"\\\\\\\"\\\\n    ).lower(),\\\\n    # Regex timeout for use by the vLLM tool parsing plugins.\\\\n    \\\\\\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\\\\\": lambda: int(\\\\n        os.getenv(\\\\\\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\\\\\", \\\\\\\"1\\\\\\\")\\\\n    ),\\\\n    # Enforce function parameter schemas in structural-tag based tool calling.\\\\n    \\\\\\\"VLLM_ENFORCE_STRICT_TOOL_CALLING\\\\\\\": lambda: (\\\\n        os.getenv(\\\\\\\"VLLM_ENFORCE_STRICT_TOOL_CALLING\\\\\\\", \\\\\\\"True\\\\\\\").lower() in (\\\\\\\"true\\\\\\\", \\\\\\\"1\\\\\\\")\\\\n    ),\\\\n    # Constrain every `beam` output to its response template's format, also\\\\n    # without tool or structured output constraints.\\\\n    \\\\\\\"VLLM_BEAM_ALWAYS_CONSTRAIN_OUTPUT\\\\\\\": lambda: (\\\\n        os.getenv(\\\\\\\"VLLM_BEAM_ALWAYS_CONSTRAIN_OUTPUT\\\\\\\", \\\\\\\"True\\\\\\\").lower() in (\\\\\\\"true\\\\\\\", \\\\\\\"1\\\\\\\")\\\\n    ),\\\\n    # Control the max chunk bytes (in MB) for the rpc message queue.\\\\n    # Object larger than this threshold will be broadcast to worker\\\\n    # processes via zmq.\\\\n    \\\\\\\"VLLM_MQ_MAX_CHUNK_BYTES_MB\\\\\\\": lambda: int(\\\\n        os.getenv(\\\\\\\"VLLM_MQ_MAX_CHUNK_BYTES_MB\\\\\\\", \\\\\\\"16\\\\\\\")\\\\n    ),\\\\n    # Timeout in seconds for execute_model RPC calls in multiprocessing\\\\n    # executor (only applies when TP > 1).\\\\n    \\\\\\\"VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS\\\\\\\": lambda: int(\\\\n        os.getenv(\\\\\\\"VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS\\\\\\\", \\\\\\\"300\\\\\\\")\\\\n    ),\\\\n    # Timeout in seconds for engine and worker process shutdown\\\"}]},\\\"match_line\\\":1921,\\\"match_lines\\\":[1917,1921,1926]},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"397b6fb2a7bb0a5b325ef2dfab3931e9\\\",\\\"_score\\\":31.107132,\\\"_source\\\":{\\\"title\\\":\\\"utils.py\\\",\\\"ax_path\\\":\\\"vllm/entrypoints/openai/responses/utils.py\\\",\\\"ax_file\\\":\\\"axf2-ef3da54eca3c0b130df61c4eb4187f52-551b\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":573,\\\"start_offset\\\":20866,\\\"end_offset\\\":21360,\\\"text\\\":\\\"def convert_tool_responses_to_completions_format(\\\\n    tool: dict,\\\\n) -> ChatCompletionToolsParam:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Convert a flat Responses tool schema:\\\\n        {\\\\\\\"type\\\\\\\": \\\\\\\"function\\\\\\\", \\\\\\\"name\\\\\\\": \\\\\\\"...\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"...\\\\\\\", \\\\\\\"parameters\\\\\\\": {...}}\\\\n    into a Chat Completions tool param for chat-template rendering.\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n    return ChatCompletionToolsParam(\\\\n        type=\\\\\\\"function\\\\\\\",\\\\n        function=FunctionDefinition.model_validate(\\\\n            {k: v for k, v in tool.items() if k != \\\\\\\"type\\\\\\\"}\\\\n        ),\\\\n    )\\\"}]},\\\"match_line\\\":577,\\\"match_lines\\\":[575,577,578,579,582,583,584]}]}}\"}],\"isError\":false}}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"_xerj\\\":{\\\"hints\\\":[{\\\"code\\\":\\\"lexical_on_semantic_text\\\",\\\"reason\\\":\\\"`body`, `text` are `semantic_text`, but this query scored them with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\\\",\\\"try\\\":{\\\"request\\\":\\\"POST /wp1107-vllm-*/_search\\\",\\\"body\\\":{\\\"query\\\":{\\\"semantic\\\":{\\\"field\\\":\\\"body\\\",\\\"query\\\":\\\"structured outputs guided_json request field tools chat completion parameter\\\",\\\"k\\\":10}}}}}]},\\\"took\\\":231,\\\"timed_out\\\":false,\\\"_shards\\\":{\\\"total\\\":1,\\\"successful\\\":1,\\\"skipped\\\":0,\\\"failed\\\":0},\\\"hits\\\":{\\\"total\\\":{\\\"value\\\":267,\\\"relation\\\":\\\"eq\\\"},\\\"max_score\\\":49.394577,\\\"hits\\\":[{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"154870edc787c553efb1e529838a318b\\\",\\\"_score\\\":49.394577,\\\"_source\\\":{\\\"title\\\":\\\"llm.py\\\",\\\"ax_path\\\":\\\"vllm/entrypoints/llm.py\\\",\\\"ax_file\\\":\\\"axf2-afd034156e6a8edc32d1168aef99ae76-a5ef\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":262,\\\"start_offset\\\":13214,\\\"end_offset\\\":13569,\\\"text\\\":\\\"def _make_config(value: Any, cls: type[_R]) -> _R:\\\\n            \\\\\\\"\\\\\\\"\\\\\\\"Convert dict/None/instance to a config instance.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n            if value is None:\\\\n                return cls()\\\\n            if isinstance(value, dict):\\\\n                return cls(**{k: v for k, v in value.items() if is_init_field(cls, k)})  # type: ignore[arg-type]\\\\n            return value\\\"}]}},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"3f424f28fdb48d5d36b83bc38553fdc8\\\",\\\"_score\\\":42.273018,\\\"_source\\\":{\\\"title\\\":\\\"protocol.py\\\",\\\"ax_path\\\":\\\"vllm/entrypoints/openai/chat_completion/protocol.py\\\",\\\"ax_file\\\":\\\"axf2-dd2a7d79bec66e262e311cb6cec4b8a8-cc0e\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":930,\\\"start_offset\\\":37396,\\\"end_offset\\\":39030,\\\"text\\\":\\\"@model_validator(mode=\\\\\\\"before\\\\\\\")\\\\n    @classmethod\\\\n    def check_structured_outputs_count(cls, data):\\\\n        if isinstance(data, ValueError):\\\\n            raise data\\\\n        if not isinstance(data, dict):\\\\n            return data\\\\n\\\\n        if data.get(\\\\\\\"structured_outputs\\\\\\\", None) is None:\\\\n            return data\\\\n\\\\n        structured_outputs_kwargs = data[\\\\\\\"structured_outputs\\\\\\\"]\\\\n        # structured_outputs may arrive as a dict (from JSON/raw kwargs) or\\\\n        # as a StructuredOutputsParams dataclass instance.\\\\n        is_dataclass = isinstance(structured_outputs_kwargs, StructuredOutputsParams)\\\\n        count = sum(\\\\n            (\\\\n                getattr(structured_outputs_kwargs, k, None)\\\\n                if is_dataclass\\\\n                else structured_outputs_kwargs.get(k)\\\\n            )\\\\n            is not None\\\\n            for k in (\\\\\\\"json\\\\\\\", \\\\\\\"regex\\\\\\\", \\\\\\\"choice\\\\\\\")\\\\n        )\\\\n        # you can only use one kind of constraints for structured outputs\\\\n        if count > 1:\\\\n            raise VLLMValidationError(\\\\n                \\\\\\\"You can only use one kind of constraints for structured \\\\\\\"\\\\n                \\\\\\\"outputs ('json', 'regex' or 'choice').\\\\\\\",\\\\n            )\\\\n        # you can only either use structured outputs or tools, not both\\\\n        if count > 0 and data.get(\\\\\\\"tool_choice\\\\\\\", \\\\\\\"none\\\\\\\") not in (\\\\n            \\\\\\\"none\\\\\\\",\\\\n            \\\\\\\"auto\\\\\\\",\\\\n            \\\\\\\"required\\\\\\\",\\\\n        ):\\\\n            raise VLLMValidationError(\\\\n                \\\\\\\"You can only either use constraints for structured outputs \\\\\\\"\\\\n                \\\\\\\"or tools, not both.\\\\\\\",\\\\n            )\\\\n        validate_structured_outputs_structural_tag(structured_outputs_kwargs)\\\\n        return data\\\"}]},\\\"match_line\\\":961,\\\"match_lines\\\":[955,958,959,961,968,969]},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"ccf0860265ea8b42671be15446da628a\\\",\\\"_score\\\":35.86368,\\\"_source\\\":{\\\"title\\\":\\\"sampling_params.py\\\",\\\"ax_path\\\":\\\"vllm/sampling_params.py\\\",\\\"ax_file\\\":\\\"axf2-254afc553bad202a73eafa29b6eeb6e5-1079e\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":0,\\\"start_offset\\\":0,\\\"end_offset\\\":2041,\\\"text\\\":\\\"# SPDX-License-Identifier: Apache-2.0\\\\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Sampling parameters for text generation.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nimport copy\\\\nimport json as json_mod\\\\nimport math\\\\nfrom dataclasses import field\\\\nfrom enum import Enum, IntEnum\\\\nfrom functools import cached_property\\\\nfrom typing import TYPE_CHECKING, Annotated, Any\\\\n\\\\nimport msgspec\\\\nimport numpy as np\\\\nfrom pydantic import BeforeValidator, GetPydanticSchema, StrictInt\\\\nfrom pydantic.dataclasses import dataclass\\\\n\\\\nimport vllm.envs as envs\\\\nfrom vllm.config import ModelConfig, SpeculativeConfig, StructuredOutputsConfig\\\\nfrom vllm.exceptions import VLLMValidationError\\\\nfrom vllm.logger import init_logger\\\\nfrom vllm.tokenizers import TokenizerLike\\\\nfrom vllm.utils.mistral import is_mistral_tokenizer\\\\nfrom vllm.utils.torch_utils import make_ndarray_with_pad\\\\nfrom vllm.v1.serial_utils import PydanticMsgspecMixin\\\\n\\\\nif TYPE_CHECKING:\\\\n    from vllm.config import VllmConfig\\\\n\\\\nlogger = init_logger(__name__)\\\\n\\\\n_SAMPLING_EPS = 1e-5\\\\n_MAX_TEMP = 1e-2\\\\n\\\\nMAX_LOGPROB_TOKEN_IDS = 128\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Upper bound on `SamplingParams.logprob_token_ids` list length. Must match\\\\nthe per-request row width allocated by the sampler's `LogprobTokenIdsState`.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nMAX_STRUCTURED_OUTPUT_JSON_NESTING = 64\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Upper bound on nested objects and arrays in a structured-output JSON schema\\\\nor structural tag. Grammar conversion runs on the API server and its cost grows\\\\nsteeply with nesting. OpenAI allows 10 levels of schema nesting.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nSTRUCTURAL_TAG_WRAPPER_NESTING = 16\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Extra nesting allowed for a structural tag, which wraps its JSON schemas in\\\\ntag structure (up to 15 levels for tool-call tags generated by tool parsers).\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n\\\\ndef _verify_num_sequences(value: int, parameter_name: str) -> None:\\\\n    if not isinstance(value, int):\\\\n        raise VLLMValidationError(\\\\n            f\\\\\\\"{parameter_name} must be an int, but is of type {type(value)}\\\\\\\"\\\\n        )\\\\n    if value < 1:\\\\n        raise VLLMValidationError(f\\\\\\\"{parameter_name} must be at least 1, got {value}.\\\\\\\")\\\\n    max_n = envs.VLLM_MAX_N_SEQUENCES\\\"}]},\\\"match_line\\\":8,\\\"match_lines\\\":[8,37,40]},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"0d8c6a078a62f0de0f8dca11d8e0f884\\\",\\\"_score\\\":35.291843,\\\"_source\\\":{\\\"title\\\":\\\"protocol.py\\\",\\\"ax_path\\\":\\\"vllm/entrypoints/openai/responses/protocol.py\\\",\\\"ax_file\\\":\\\"axf2-195f0982d65a65cf4d9d7efbebbf7469-a3e1\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":483,\\\"start_offset\\\":16875,\\\"end_offset\\\":18754,\\\"text\\\":\\\"def build_chat_params(\\\\n        self,\\\\n        default_template: str | None,\\\\n        default_template_content_format: ChatTemplateContentFormatOption,\\\\n        reasoning_effort_map: dict[str, str] | None = None,\\\\n    ) -> ChatParams:\\\\n        from .utils import should_continue_final_message\\\\n\\\\n        # Check if we should continue the final message (partial completion)\\\\n        # This enables Anthropic-style partial message completion where the\\\\n        # user provides an incomplete assistant message to continue from.\\\\n        continue_final = should_continue_final_message(self.input)\\\\n\\\\n        reasoning = self.reasoning\\\\n        reasoning_effort = map_reasoning_effort(\\\\n            None if reasoning is None else reasoning.effort, reasoning_effort_map\\\\n        )\\\\n\\\\n        extra_kwargs: dict[str, Any] = dict(\\\\n            add_generation_prompt=not continue_final,\\\\n            continue_final_message=continue_final,\\\\n            reasoning_effort=reasoning_effort,\\\\n        )\\\\n\\\\n        # When reasoning is requested, activate thinking for models whose\\\\n        # chat templates require explicit opt-in (e.g., Gemma4 defaults\\\\n        # enable_thinking to false). For templates that don't declare the\\\\n        # variable, resolve_chat_template_kwargs filters it out harmlessly.\\\\n        user_kwargs = self.chat_template_kwargs or {}\\\\n        if reasoning_effort is not None and \\\\\\\"enable_thinking\\\\\\\" not in user_kwargs:\\\\n            extra_kwargs[\\\\\\\"enable_thinking\\\\\\\"] = reasoning_effort != \\\\\\\"none\\\\\\\"\\\\n\\\\n        return ChatParams(\\\\n            chat_template=default_template,\\\\n            chat_template_content_format=default_template_content_format,\\\\n            chat_template_kwargs=merge_kwargs(\\\\n                self.chat_template_kwargs,\\\\n                extra_kwargs,\\\\n            ),\\\\n            media_io_kwargs=self.media_io_kwargs,\\\\n            tool_choice=self.tool_choice if self.tools else None,\\\\n        )\\\"}]},\\\"match_line\\\":509,\\\"match_lines\\\":[492,493,509,524]},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"e517c4f75ed83d22efbc751bbf62cf09\\\",\\\"_score\\\":33.057495,\\\"_source\\\":{\\\"title\\\":\\\"envs.py\\\",\\\"ax_path\\\":\\\"vllm/envs.py\\\",\\\"ax_file\\\":\\\"axf2-a2916a3078f8d7b850eb9c99a42f61b7-1ea88\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":1899,\\\"start_offset\\\":90839,\\\"end_offset\\\":92874,\\\"text\\\":\\\"    ),\\\\n    # Control the maximum number of tokens per expert supported by the\\\\n    # NVFP4 MoE CUTLASS Kernel. This value is used to create a buffer for\\\\n    # the blockscale tensor of activations NVFP4 Quantization.\\\\n    # This is used to prevent the kernel from running out of memory.\\\\n    \\\\\\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\\\\\": lambda: int(\\\\n        os.getenv(\\\\\\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\\\\\", \\\\\\\"163840\\\\\\\")\\\\n    ),\\\\n    # MoE routing strategy selector.\\\\n    # See `RoutingSimulator.get_available_strategies()` # for available\\\\n    # strategies.\\\\n    # Custom routing strategies can be registered by\\\\n    # RoutingSimulator.register_strategy()\\\\n    # Note: custom strategies may not produce correct model outputs\\\\n    \\\\\\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\\\\\": lambda: os.environ.get(\\\\n        \\\\\\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\\\\\", \\\\\\\"\\\\\\\"\\\\n    ).lower(),\\\\n    # Regex timeout for use by the vLLM tool parsing plugins.\\\\n    \\\\\\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\\\\\": lambda: int(\\\\n        os.getenv(\\\\\\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\\\\\", \\\\\\\"1\\\\\\\")\\\\n    ),\\\\n    # Enforce function parameter schemas in structural-tag based tool calling.\\\\n    \\\\\\\"VLLM_ENFORCE_STRICT_TOOL_CALLING\\\\\\\": lambda: (\\\\n        os.getenv(\\\\\\\"VLLM_ENFORCE_STRICT_TOOL_CALLING\\\\\\\", \\\\\\\"True\\\\\\\").lower() in (\\\\\\\"true\\\\\\\", \\\\\\\"1\\\\\\\")\\\\n    ),\\\\n    # Constrain every `beam` output to its response template's format, also\\\\n    # without tool or structured output constraints.\\\\n    \\\\\\\"VLLM_BEAM_ALWAYS_CONSTRAIN_OUTPUT\\\\\\\": lambda: (\\\\n        os.getenv(\\\\\\\"VLLM_BEAM_ALWAYS_CONSTRAIN_OUTPUT\\\\\\\", \\\\\\\"True\\\\\\\").lower() in (\\\\\\\"true\\\\\\\", \\\\\\\"1\\\\\\\")\\\\n    ),\\\\n    # Control the max chunk bytes (in MB) for the rpc message queue.\\\\n    # Object larger than this threshold will be broadcast to worker\\\\n    # processes via zmq.\\\\n    \\\\\\\"VLLM_MQ_MAX_CHUNK_BYTES_MB\\\\\\\": lambda: int(\\\\n        os.getenv(\\\\\\\"VLLM_MQ_MAX_CHUNK_BYTES_MB\\\\\\\", \\\\\\\"16\\\\\\\")\\\\n    ),\\\\n    # Timeout in seconds for execute_model RPC calls in multiprocessing\\\\n    # executor (only applies when TP > 1).\\\\n    \\\\\\\"VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS\\\\\\\": lambda: int(\\\\n        os.getenv(\\\\\\\"VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS\\\\\\\", \\\\\\\"300\\\\\\\")\\\\n    ),\\\"}]},\\\"match_line\\\":1913,\\\"match_lines\\\":[1913,1921,1926]}]}}\"}],\"isError\":false}}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"_xerj\\\":{\\\"hints\\\":[{\\\"code\\\":\\\"lexical_on_semantic_text\\\",\\\"reason\\\":\\\"`body`, `text` are `semantic_text`, but this query scored them with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\\\",\\\"try\\\":{\\\"request\\\":\\\"POST /wp1107-vllm-*/_search\\\",\\\"body\\\":{\\\"query\\\":{\\\"semantic\\\":{\\\"field\\\":\\\"body\\\",\\\"query\\\":\\\"GET version response field server identification OpenAI API\\\",\\\"k\\\":10}}}}}]},\\\"took\\\":226,\\\"timed_out\\\":false,\\\"_shards\\\":{\\\"total\\\":1,\\\"successful\\\":1,\\\"skipped\\\":0,\\\"failed\\\":0},\\\"hits\\\":{\\\"total\\\":{\\\"value\\\":198,\\\"relation\\\":\\\"eq\\\"},\\\"max_score\\\":36.163128,\\\"hits\\\":[{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"17f72f6474c93703436b85971719a86c\\\",\\\"_score\\\":36.163128,\\\"_source\\\":{\\\"title\\\":\\\"# OpenAI-Compatible Server\\\",\\\"ax_path\\\":\\\"docs/serving/online_serving/openai_compatible_server.md\\\",\\\"ax_file\\\":\\\"axf2-edcb9a3e790e379662e30f18d870850a-26e5\\\",\\\"ax_locator\\\":\\\"s5\\\",\\\"start_line\\\":173},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":0,\\\"start_offset\\\":0,\\\"end_offset\\\":1956,\\\"text\\\":\\\"`image_url.detail` parameter is not supported.*\\\\n\\\\nCode example: [examples/basic/online_serving/openai_chat_completion_client.py](../../../examples/basic/online_serving/openai_chat_completion_client.py)\\\\n\\\\nWith `--enable-prompt-tokens-details`, `/v1/chat/completions/batch` sums `cached_tokens`, `created_cache_tokens` and per-modality `multimodal_tokens` across conversations in `usage.prompt_tokens_details`; an unreported cache count makes that total `null`, and disabling the flag leaves the details `null`.\\\\n\\\\n#### Extra parameters\\\\n\\\\nThe following [sampling parameters](../../api/README.md#inference-parameters) are supported.\\\\n\\\\n??? code\\\\n\\\\n    ```python\\\\n    --8<-- \\\\\\\"vllm/entrypoints/openai/chat_completion/protocol.py:chat-completion-sampling-params\\\\\\\"\\\\n    ```\\\\n\\\\nThe following extra parameters are supported:\\\\n\\\\n??? code\\\\n\\\\n    ```python\\\\n    --8<-- \\\\\\\"vllm/entrypoints/openai/chat_completion/protocol.py:chat-completion-extra-params\\\\\\\"\\\\n    ```\\\\n\\\\n### Responses API\\\\n\\\\nOur Responses API is compatible with [OpenAI's Responses API](https://platform.openai.com/docs/api-reference/responses);\\\\nyou can use the [official OpenAI Python client](https://github.com/openai/openai-python) to interact with it.\\\\n\\\\nCode example: [examples/tool_calling/openai_responses_client_with_tools.py](../../../examples/tool_calling/openai_responses_client_with_tools.py)\\\\n\\\\nTo get prompt token IDs before generation, use\\\\n[`/v1/responses/render`](renderer.md#get-responses-prompt-token-ids). It preprocesses\\\\na self-contained Responses request without inference and returns the prompt\\\\ntoken IDs, so a separate `/tokenize` call is not needed.\\\\n\\\\n#### Sampling parameters\\\\n\\\\nIn addition to the OpenAI request fields, the Responses API forwards vLLM\\\\n[sampling parameters](../../api/README.md#inference-parameters) such as `top_k`,\\\\n`min_p`, `repetition_penalty`, `seed`, `stop`, and `ignore_eos` to the engine.\\\\n\\\\n#### Extra parameters\\\\n\\\\nThe following extra parameters in the request object are supported:\\\\n\\\\n??? code\\\"}]},\\\"match_line\\\":204,\\\"match_lines\\\":[181,197,199,200,204,205,211,212]},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"07a851b1843f6c3f317603e2825f75b4\\\",\\\"_score\\\":30.387255,\\\"_source\\\":{\\\"title\\\":\\\"ResponsesRequest\\\",\\\"ax_path\\\":\\\"vllm/entrypoints/openai/responses/protocol.py\\\",\\\"ax_file\\\":\\\"axf2-195f0982d65a65cf4d9d7efbebbf7469-a3e1\\\",\\\"ax_locator\\\":\\\"code:247:ResponsesRequest\\\",\\\"language\\\":\\\"python\\\",\\\"path\\\":\\\"protocol.py\\\",\\\"kind\\\":\\\"class\\\",\\\"line\\\":247,\\\"code\\\":\\\"class ResponsesRequest(OpenAIBaseModel):\\\\n    # Ordered by official OpenAI API documentation\\\\n    # https://platform.openai.com/docs/api-reference/responses/create\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"code\\\",\\\"ordinal\\\":0,\\\"start_offset\\\":0,\\\"end_offset\\\":161,\\\"text\\\":\\\"class ResponsesRequest(OpenAIBaseModel):\\\\n    # Ordered by official OpenAI API documentation\\\\n    # https://platform.openai.com/docs/api-reference/responses/create\\\"}]},\\\"match_line\\\":248,\\\"match_lines\\\":[248,249]},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"e517c4f75ed83d22efbc751bbf62cf09\\\",\\\"_score\\\":29.355965,\\\"_source\\\":{\\\"title\\\":\\\"envs.py\\\",\\\"ax_path\\\":\\\"vllm/envs.py\\\",\\\"ax_file\\\":\\\"axf2-a2916a3078f8d7b850eb9c99a42f61b7-1ea88\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":2278,\\\"start_offset\\\":111096,\\\"end_offset\\\":113085,\\\"text\\\":\\\"    \\\\\\\"VLLM_KV_OFFLOAD_MAX_BATCH_DESCRIPTORS\\\\\\\": lambda: int(\\\\n        os.getenv(\\\\\\\"VLLM_KV_OFFLOAD_MAX_BATCH_DESCRIPTORS\\\\\\\", \\\\\\\"0\\\\\\\")\\\\n    ),\\\\n    # On WSL2 with a compatible kernel (>= 4.19.121), pinned memory is\\\\n    # supported but disabled by default due to a small performance regression.\\\\n    # Set to 1 when pinned memory or UVA is required (e.g. CPU offloading\\\\n    # or v2 model runner).\\\\n    \\\\\\\"VLLM_WSL2_ENABLE_PIN_MEMORY\\\\\\\": lambda: bool(\\\\n        int(os.getenv(\\\\\\\"VLLM_WSL2_ENABLE_PIN_MEMORY\\\\\\\", \\\\\\\"0\\\\\\\"))\\\\n    ),\\\\n    # Disable logging of vLLM logo at server startup time.\\\\n    \\\\\\\"VLLM_DISABLE_LOG_LOGO\\\\\\\": lambda: bool(int(os.getenv(\\\\\\\"VLLM_DISABLE_LOG_LOGO\\\\\\\", \\\\\\\"0\\\\\\\"))),\\\\n    # Disable PDL for LoRA, as enabling PDL with LoRA on SM100 causes\\\\n    # Triton compilation to fail.\\\\n    \\\\\\\"VLLM_LORA_DISABLE_PDL\\\\\\\": lambda: bool(int(os.getenv(\\\\\\\"VLLM_LORA_DISABLE_PDL\\\\\\\", \\\\\\\"0\\\\\\\"))),\\\\n    # Enable CUDA compatibility mode for datacenter GPUs with older\\\\n    # driver versions than the CUDA toolkit major version of vLLM.\\\\n    \\\\\\\"VLLM_ENABLE_CUDA_COMPATIBILITY\\\\\\\": lambda: (\\\\n        os.environ.get(\\\\\\\"VLLM_ENABLE_CUDA_COMPATIBILITY\\\\\\\", \\\\\\\"0\\\\\\\").strip().lower()\\\\n        in (\\\\\\\"1\\\\\\\", \\\\\\\"true\\\\\\\")\\\\n    ),\\\\n    # Path to the CUDA compatibility libraries when CUDA compatibility is enabled.\\\\n    \\\\\\\"VLLM_CUDA_COMPATIBILITY_PATH\\\\\\\": lambda: os.environ.get(\\\\n        \\\\\\\"VLLM_CUDA_COMPATIBILITY_PATH\\\\\\\", None\\\\n    ),\\\\n    # Skip model name validation in OpenAI API requests.\\\\n    # When set to 1, any model name will be accepted in the 'model' field\\\\n    # of API requests. This is useful for proxy/gateway scenarios where\\\\n    # the actual model is served but different names may be used in requests.\\\\n    \\\\\\\"VLLM_SKIP_MODEL_NAME_VALIDATION\\\\\\\": lambda: (\\\\n        os.getenv(\\\\\\\"VLLM_SKIP_MODEL_NAME_VALIDATION\\\\\\\", \\\\\\\"0\\\\\\\").strip().lower()\\\\n        in (\\\\\\\"1\\\\\\\", \\\\\\\"true\\\\\\\")\\\\n    ),\\\\n    # Whether it is a scale up launch engine for elastic EP,\\\\n    # Should only be set by EngineCoreClient.\\\\n    \\\\\\\"VLLM_ELASTIC_EP_SCALE_UP_LAUNCH\\\\\\\": lambda: bool(\\\\n        int(os.getenv(\\\\\\\"VLLM_ELASTIC_EP_SCALE_UP_LAUNCH\\\\\\\", \\\\\\\"0\\\\\\\"))\\\\n    ),\\\"}]},\\\"match_line\\\":2304,\\\"match_lines\\\":[2289,2295,2297,2301,2304,2305,2306]},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"3f424f28fdb48d5d36b83bc38553fdc8\\\",\\\"_score\\\":28.587217,\\\"_source\\\":{\\\"title\\\":\\\"protocol.py\\\",\\\"ax_path\\\":\\\"vllm/entrypoints/openai/chat_completion/protocol.py\\\",\\\"ax_file\\\":\\\"axf2-dd2a7d79bec66e262e311cb6cec4b8a8-cc0e\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":114,\\\"start_offset\\\":3221,\\\"end_offset\\\":4756,\\\"text\\\":\\\"class ChatCompletionResponseChoice(OpenAIBaseModel):\\\\n    index: int\\\\n    # ``SerializeAsAny`` lets pydantic honor subclasses of ``ChatMessage``\\\\n    # (e.g. ``vllm.entrypoints.cohere.cohere_chat_message.CohereChatMessage``)\\\\n    # so that added fields like ``citations`` survive JSON serialization\\\\n    # instead of being stripped down to the base schema. Plain\\\\n    # ``ChatMessage`` instances serialize identically to before.\\\\n    message: SerializeAsAny[ChatMessage]\\\\n    logprobs: ChatCompletionLogProbs | None = None\\\\n    # per OpenAI spec this is the default\\\\n    finish_reason: str | None = \\\\\\\"stop\\\\\\\"\\\\n    # not part of the OpenAI spec but included in vLLM for legacy reasons\\\\n    stop_reason: int | str | None = None\\\\n    # not part of the OpenAI spec but is useful for tracing the tokens\\\\n    # in agent scenarios\\\\n    token_ids: list[int] | None = None\\\\n    # Per-token expert routing decisions, base64-encoded ``.npy`` bytes\\\\n    # (numpy serialization). Shape after decode:\\\\n    #   (num_tokens - 1, num_layers, num_experts_per_tok) dtype uint8/uint16/int32\\\\n    # ``num_tokens - 1`` because the last sampled token has not been\\\\n    # forwarded yet and therefore has no routing data.\\\\n    # Decode:\\\\n    #   np.load(io.BytesIO(base64.b64decode(s)))\\\\n    # ``None`` if (a) the request was aborted before any forward pass,\\\\n    # or (b) ``enable_return_routed_experts`` is off server-side.\\\\n    routed_experts: str | None = None\\\\n    # Contiguous weight version spans over output-token indexes.\\\\n    weight_versions: list[WeightVersionSpan] | None = None\\\"}]},\\\"match_line\\\":139,\\\"match_lines\\\":[124,126,128,139,141]}]}}\"}],\"isError\":false}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","create_time":1793736260.7803524}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
