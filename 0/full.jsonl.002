{"timestamp":"2026-11-03T19:21:45.580Z","ordinal":78329,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"CommandExecution","id":"exec-5e5da0ee-76a5-4ad7-b96b-71e50738d40a","process_id":"45579","command":["/usr/bin/zsh","-lc","rg -n 'isolatedHome|isolated-home|LOCAL_LLM_ENDPOINT|config.env|loadConfig|load.*Config' cli/src/eval_cli.ts eval/run.mjs cli/src | rg 'eval_cli|eval/run.mjs' | head -80 && sed -n '1,260p' cli/src/eval_cli.ts && sed -n '1,180p' eval/agent_sandbox.mjs"],"cwd":"file:///home/mike/nexus-wt/v112-rc2-package","parsed_cmd":[{"type":"search","cmd":"rg -n 'isolatedHome|isolated-home|LOCAL_LLM_ENDPOINT|config.env|loadConfig|load.*Config' cli/src/eval_cli.ts eval/run.mjs cli/src","query":"isolatedHome|isolated-home|LOCAL_LLM_ENDPOINT|config.env|loadConfig|load.*Config","path":"eval_cli.ts"},{"type":"search","cmd":"rg 'eval_cli|eval/run.mjs'","query":"eval_cli|eval/run.mjs","path":null},{"type":"read","cmd":"sed -n '1,260p' cli/src/eval_cli.ts","name":"eval_cli.ts","path":"cli/src/eval_cli.ts"},{"type":"read","cmd":"sed -n '1,180p' eval/agent_sandbox.mjs","name":"agent_sandbox.mjs","path":"eval/agent_sandbox.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"eval/run.mjs:406:    command = resolvePathExecutable(agent, { ...process.env, ...(config.env ?? {}) }) ?? agent;\neval/run.mjs:765:/** `{ file, var }`: the key is read from a KEY=value file (e.g. ~/.config/nexus/config.env); never logged. */\ncli/src/eval_cli.ts:63:  if (args[0] !== \"eval\" || !args.includes(\"--isolated-home\")) return undefined;\ncli/src/eval_cli.ts:63:  if (args[0] !== \"eval\" || !args.includes(\"--isolated-home\")) return undefined;\nimport * as fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { pathToFileURL } from \"node:url\";\nimport type { HarnessConfig } from \"./types.js\";\n\nexport interface VersionedEvalCommandOptions {\n  dataset?: string;\n  output?: string;\n  runs?: string | number;\n  limit?: string | number;\n  maxMinutes?: string | number;\n  split?: \"regression\" | \"benchmark\";\n  workspace?: string;\n  maxSteps?: string | number;\n  temperature?: string | number;\n}\n\nexport interface VersionedEvalRuntimeResolver {\n  packageRoot: string;\n  nexusExecutable: string;\n  runnerApiPath: string;\n}\n\nexport interface VersionedEvalRunnerResult {\n  outputDir: string;\n  resultsFile: string;\n  manifestFile: string;\n  scoreFile: string;\n  score: Record<string, unknown>;\n}\n\nfunction positiveInteger(value: string | number | undefined, option: string, fallback: number): number {\n  if (value === undefined) return fallback;\n  const text = String(value);\n  if (!/^[1-9][0-9]*$/.test(text)) throw new Error(`${option} must be a positive whole number`);\n  const parsed = Number(text);\n  if (!Number.isSafeInteger(parsed)) throw new Error(`${option} exceeds the supported integer range`);\n  return parsed;\n}\n\nexport function resolveInstalledEvalRuntime(env: NodeJS.ProcessEnv = process.env): VersionedEvalRuntimeResolver {\n  if (!env.NEXUS_HOME || !path.isAbsolute(env.NEXUS_HOME)) {\n    throw new Error(\"versioned evaluation requires the installed Nexus launcher (NEXUS_HOME is unavailable)\");\n  }\n  const packageRoot = fs.realpathSync(env.NEXUS_HOME);\n  const isWithinPackage = (candidate: string) => candidate === packageRoot || candidate.startsWith(`${packageRoot}${path.sep}`);\n  const nexusExecutable = fs.realpathSync(path.join(packageRoot, \"bin\", \"nexus\"));\n  if (!isWithinPackage(nexusExecutable)) throw new Error(\"installed Nexus launcher resolves outside NEXUS_HOME\");\n  const executableStat = fs.statSync(nexusExecutable);\n  if (!executableStat.isFile() || (executableStat.mode & 0o111) === 0) {\n    throw new Error(\"installed Nexus launcher is not executable\");\n  }\n  const runnerApiPath = fs.realpathSync(path.join(packageRoot, \"eval\", \"runner_api.mjs\"));\n  if (!isWithinPackage(runnerApiPath) || !fs.statSync(runnerApiPath).isFile()) {\n    throw new Error(\"installed evaluator runtime is incomplete or resolves outside NEXUS_HOME\");\n  }\n  return { packageRoot, nexusExecutable, runnerApiPath };\n}\n\n/** Isolate startup state before the launcher loads environment or operator configuration. */\nexport function isolateEvalCommandHome(args: readonly string[]): (() => void) | undefined {\n  if (args[0] !== \"eval\" || !args.includes(\"--isolated-home\")) return undefined;\n  const home = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-cli-home-\"));\n  fs.chmodSync(home, 0o700);\n  const isolatedEnvironment: Record<string, string> = {\n    HOME: home,\n    XDG_CONFIG_HOME: path.join(home, \".config\"),\n    XDG_DATA_HOME: path.join(home, \".local\", \"share\"),\n    XDG_STATE_HOME: path.join(home, \".local\", \"state\"),\n    XDG_CACHE_HOME: path.join(home, \".cache\"),\n  };\n  const previousEnvironment = new Map(Object.keys(isolatedEnvironment).map((key) => [key, process.env[key]]));\n  Object.assign(process.env, isolatedEnvironment);\n  return () => {\n    for (const [key, value] of previousEnvironment) {\n      if (value === undefined) delete process.env[key];\n      else process.env[key] = value;\n    }\n    fs.rmSync(home, { recursive: true, force: true });\n  };\n}\n\nexport async function runVersionedEvalCommand(\n  options: VersionedEvalCommandOptions,\n  config: HarnessConfig,\n  resolver: () => VersionedEvalRuntimeResolver = resolveInstalledEvalRuntime,\n): Promise<{ output: string; runner: VersionedEvalRunnerResult }> {\n  if (!options.dataset?.trim()) throw new Error(\"--dataset is required\");\n  if (options.limit !== undefined) {\n    throw new Error(\"--limit is not supported for versioned datasets; select a split or provide a dataset with the desired task population\");\n  }\n  const runs = positiveInteger(options.runs, \"--runs\", 1);\n  const minutes = positiveInteger(options.maxMinutes, \"--max-minutes\", 120);\n  const runtime = resolver();\n  const runnerModule = await import(pathToFileURL(runtime.runnerApiPath).href) as {\n    runVersionedEvaluation(options: Record<string, unknown>): Promise<VersionedEvalRunnerResult>;\n  };\n  const outputPath = path.resolve(options.output ?? \"eval-score.json\");\n  const outputDir = `${outputPath}.artifacts`;\n  if (fs.existsSync(outputPath)) throw new Error(`score output already exists: ${outputPath}`);\n  if (fs.existsSync(outputDir)) throw new Error(`evaluation artifact directory already exists: ${outputDir}`);\n  const runner = await runnerModule.runVersionedEvaluation({\n    config: {\n      name: \"nexus-eval-cli\",\n      agent: \"nexus\",\n      endpoint: config.endpoint,\n      model: config.model,\n      apiKey: config.apiKey,\n      steps: positiveInteger(options.maxSteps, \"--max-steps\", config.maxSteps),\n      minutes,\n      sampling: { temperature: Number(options.temperature ?? config.temperature) },\n      limits: { context: config.contextLimit, output: config.completionReserveTokens },\n      workspace: path.resolve(options.workspace ?? config.workspace),\n      sandboxRuntimeRoots: [runtime.packageRoot],\n      // Mount only the installed candidate's CLI and core closures. The package root\n      // also contains evaluator code and private dataset material, which stay unmounted.\n      sandboxRuntimePaths: [path.join(runtime.packageRoot, \"lib\", \"cli\"), path.join(runtime.packageRoot, \"lib\", \"core\")],\n    },\n    nexusExecutable: runtime.nexusExecutable,\n    dataset: path.resolve(options.dataset),\n    outputDir,\n    runs,\n    split: options.split,\n  });\n  const output = JSON.stringify({\n    schemaVersion: 1,\n    dataset: path.resolve(options.dataset),\n    runs,\n    score: runner.score,\n    artifacts: {\n      outputDir: runner.outputDir,\n      resultsFile: runner.resultsFile,\n      manifestFile: runner.manifestFile,\n      scoreFile: runner.scoreFile,\n    },\n  }, null, 2);\n  fs.mkdirSync(path.dirname(outputPath), { recursive: true });\n  fs.writeFileSync(outputPath, `${output}\\n`, { encoding: \"utf8\", mode: 0o600, flag: \"wx\" });\n  return { output, runner };\n}\n// Runs one evaluation candidate behind a namespace-local TCP endpoint and a host-side Unix-socket proxy.\n// The candidate sees only the run-scoped local token; the upstream gateway credential stays in run.mjs.\nimport http from \"node:http\";\nimport { spawn } from \"node:child_process\";\nimport { StringDecoder } from \"node:string_decoder\";\n\n// The launch payload is the first stdin line. With payload.protocol the rest of stdin is the agent's stdin (the T3\n// sidecar protocol); otherwise the agent gets no stdin.\nconst payload = JSON.parse(await readPayloadLine());\nconst port = 40127; // private to this network namespace; no host listener uses this port\nconst server = http.createServer((req, res) => {\n  const upstream = http.request({ socketPath: \"/run/eval-proxy/proxy.sock\", agent: new http.Agent({ keepAlive: false }), method: req.method, path: req.url, headers: { ...req.headers, host: \"eval-proxy\", connection: \"close\" } }, (response) => {\n    res.writeHead(response.statusCode ?? 502, response.headers);\n    response.pipe(res);\n    response.once(\"end\", () => upstream.destroy());\n  });\n  upstream.on(\"error\", (error) => {\n    if (!res.headersSent) res.writeHead(502, { \"content-type\": \"application/json\" });\n    res.end(JSON.stringify({ error: { type: \"proxy_unavailable\", message: \"evaluation proxy unavailable\" } }));\n  });\n  req.pipe(upstream);\n});\nawait new Promise((resolve, reject) => {\n  server.once(\"error\", reject);\n  server.listen(port, \"127.0.0.1\", resolve);\n});\n\nconst endpoint = `http://127.0.0.1:${port}/v1`;\nconst env = { ...payload.env };\nfor (const [key, value] of Object.entries(env)) {\n  if (typeof value === \"string\") env[key] = value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint);\n}\nconst argv = payload.argv.map((value) => value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint));\nconst agent = spawn(payload.command, argv, { cwd: \"/workspace\", env, stdio: [payload.protocol ? \"pipe\" : \"ignore\", \"inherit\", \"inherit\"] });\nif (payload.protocol) {\n  agent.stdin.on(\"error\", () => {});\n  process.stdin.pipe(agent.stdin);\n  process.stdin.resume();\n}\nlet stopping = false;\nconst stop = (signal) => {\n  if (stopping) return;\n  stopping = true;\n  try { process.kill(-agent.pid, signal); } catch { agent.kill(signal); }\n};\nprocess.on(\"SIGTERM\", () => stop(\"SIGTERM\"));\nprocess.on(\"SIGINT\", () => stop(\"SIGINT\"));\nagent.on(\"error\", (error) => {\n  process.stderr.write(`candidate spawn failed: ${error.message}\\n`);\n  closeBridge(127);\n});\nagent.on(\"close\", (code, signal) => {\n  closeBridge(code ?? (signal ? 128 : 1));\n});\n\n/** Reads stdin up to the first newline (or its end); anything after the newline is put back for the agent. */\nfunction readPayloadLine() {\n  return new Promise((resolve, reject) => {\n    let body = \"\";\n    const decoder = new StringDecoder(\"utf8\");\n    const onData = (chunk) => {\n      body += decoder.write(chunk);\n      if (body.length > 1_000_000) { cleanup(); reject(new Error(\"sandbox launch payload too large\")); return; }\n      const newline = body.indexOf(\"\\n\");\n      if (newline < 0) return;\n      cleanup();\n      process.stdin.pause();\n      const rest = body.slice(newline + 1);\n      if (rest) process.stdin.unshift(Buffer.from(rest, \"utf8\"));\n      resolve(body.slice(0, newline));\n    };\n    const onEnd = () => { cleanup(); resolve(body); };\n    const cleanup = () => { process.stdin.off(\"data\", onData); process.stdin.off(\"end\", onEnd); process.stdin.off(\"error\", reject); };\n    process.stdin.on(\"data\", onData);\n    process.stdin.on(\"end\", onEnd);\n    process.stdin.on(\"error\", reject);\n  });\n}\n\nfunction closeBridge(exitCode) {\n  process.exitCode = exitCode;\n  server.closeAllConnections?.();\n  server.close();\n}\n","exit_code":0,"duration":{"secs":0,"nanos":723893149}},"started_at_ms":1793733704855,"completed_at_ms":1793733705579}}
{"timestamp":"2026-11-03T19:21:46.750Z","ordinal":78330,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1a2dc-43fd-70a3-8077-c9658353ca88","call_id":"call_28cd3b99a9c34bd49a6204c5b63714a9","output":[{"type":"input_text","text":"Script completed\nWall time 3.2 seconds\nOutput:\n"},{"type":"input_text","text":"eval/run.mjs:406:    command = resolvePathExecutable(agent, { ...process.env, ...(config.env ?? {}) }) ?? agent;\neval/run.mjs:765:/** `{ file, var }`: the key is read from a KEY=value file (e.g. ~/.config/nexus/config.env); never logged. */\ncli/src/eval_cli.ts:63:  if (args[0] !== \"eval\" || !args.includes(\"--isolated-home\")) return undefined;\ncli/src/eval_cli.ts:63:  if (args[0] !== \"eval\" || !args.includes(\"--isolated-home\")) return undefined;\nimport * as fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { pathToFileURL } from \"node:url\";\nimport type { HarnessConfig } from \"./types.js\";\n\nexport interface VersionedEvalCommandOptions {\n  dataset?: string;\n  output?: string;\n  runs?: string | number;\n  limit?: string | number;\n  maxMinutes?: string | number;\n  split?: \"regression\" | \"benchmark\";\n  workspace?: string;\n  maxSteps?: string | number;\n  temperature?: string | number;\n}\n\nexport interface VersionedEvalRuntimeResolver {\n  packageRoot: string;\n  nexusExecutable: string;\n  runnerApiPath: string;\n}\n\nexport interface VersionedEvalRunnerResult {\n  outputDir: string;\n  resultsFile: string;\n  manifestFile: string;\n  scoreFile: string;\n  score: Record<string, unknown>;\n}\n\nfunction positiveInteger(value: string | number | undefined, option: string, fallback: number): number {\n  if (value === undefined) return fallback;\n  const text = String(value);\n  if (!/^[1-9][0-9]*$/.test(text)) throw new Error(`${option} must be a positive whole number`);\n  const parsed = Number(text);\n  if (!Number.isSafeInteger(parsed)) throw new Error(`${option} exceeds the supported integer range`);\n  return parsed;\n}\n\nexport function resolveInstalledEvalRuntime(env: NodeJS.ProcessEnv = process.env): VersionedEvalRuntimeResolver {\n  if (!env.NEXUS_HOME || !path.isAbsolute(env.NEXUS_HOME)) {\n    throw new Error(\"versioned evaluation requires the installed Nexus launcher (NEXUS_HOME is unavailable)\");\n  }\n  const packageRoot = fs.realpathSync(env.NEXUS_HOME);\n  const isWithinPackage = (candidate: string) => candidate === packageRoot || candidate.startsWith(`${packageRoot}${path.sep}`);\n  const nexusExecutable = fs.realpathSync(path.join(packageRoot, \"bin\", \"nexus\"));\n  if (!isWithinPackage(nexusExecutable)) throw new Error(\"installed Nexus launcher resolves outside NEXUS_HOME\");\n  const executableStat = fs.statSync(nexusExecutable);\n  if (!executableStat.isFile() || (executableStat.mode & 0o111) === 0) {\n    throw new Error(\"installed Nexus launcher is not executable\");\n  }\n  const runnerApiPath = fs.realpathSync(path.join(packageRoot, \"eval\", \"runner_api.mjs\"));\n  if (!isWithinPackage(runnerApiPath) || !fs.statSync(runnerApiPath).isFile()) {\n    throw new Error(\"installed evaluator runtime is incomplete or resolves outside NEXUS_HOME\");\n  }\n  return { packageRoot, nexusExecutable, runnerApiPath };\n}\n\n/** Isolate startup state before the launcher loads environment or operator configuration. */\nexport function isolateEvalCommandHome(args: readonly string[]): (() => void) | undefined {\n  if (args[0] !== \"eval\" || !args.includes(\"--isolated-home\")) return undefined;\n  const home = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-cli-home-\"));\n  fs.chmodSync(home, 0o700);\n  const isolatedEnvironment: Record<string, string> = {\n    HOME: home,\n    XDG_CONFIG_HOME: path.join(home, \".config\"),\n    XDG_DATA_HOME: path.join(home, \".local\", \"share\"),\n    XDG_STATE_HOME: path.join(home, \".local\", \"state\"),\n    XDG_CACHE_HOME: path.join(home, \".cache\"),\n  };\n  const previousEnvironment = new Map(Object.keys(isolatedEnvironment).map((key) => [key, process.env[key]]));\n  Object.assign(process.env, isolatedEnvironment);\n  return () => {\n    for (const [key, value] of previousEnvironment) {\n      if (value === undefined) delete process.env[key];\n      else process.env[key] = value;\n    }\n    fs.rmSync(home, { recursive: true, force: true });\n  };\n}\n\nexport async function runVersionedEvalCommand(\n  options: VersionedEvalCommandOptions,\n  config: HarnessConfig,\n  resolver: () => VersionedEvalRuntimeResolver = resolveInstalledEvalRuntime,\n): Promise<{ output: string; runner: VersionedEvalRunnerResult }> {\n  if (!options.dataset?.trim()) throw new Error(\"--dataset is required\");\n  if (options.limit !== undefined) {\n    throw new Error(\"--limit is not supported for versioned datasets; select a split or provide a dataset with the desired task population\");\n  }\n  const runs = positiveInteger(options.runs, \"--runs\", 1);\n  const minutes = positiveInteger(options.maxMinutes, \"--max-minutes\", 120);\n  const runtime = resolver();\n  const runnerModule = await import(pathToFileURL(runtime.runnerApiPath).href) as {\n    runVersionedEvaluation(options: Record<string, unknown>): Promise<VersionedEvalRunnerResult>;\n  };\n  const outputPath = path.resolve(options.output ?? \"eval-score.json\");\n  const outputDir = `${outputPath}.artifacts`;\n  if (fs.existsSync(outputPath)) throw new Error(`score output already exists: ${outputPath}`);\n  if (fs.existsSync(outputDir)) throw new Error(`evaluation artifact directory already exists: ${outputDir}`);\n  const runner = await runnerModule.runVersionedEvaluation({\n    config: {\n      name: \"nexus-eval-cli\",\n      agent: \"nexus\",\n      endpoint: config.endpoint,\n      model: config.model,\n      apiKey: config.apiKey,\n      steps: positiveInteger(options.maxSteps, \"--max-steps\", config.maxSteps),\n      minutes,\n      sampling: { temperature: Number(options.temperature ?? config.temperature) },\n      limits: { context: config.contextLimit, output: config.completionReserveTokens },\n      workspace: path.resolve(options.workspace ?? config.workspace),\n      sandboxRuntimeRoots: [runtime.packageRoot],\n      // Mount only the installed candidate's CLI and core closures. The package root\n      // also contains evaluator code and private dataset material, which stay unmounted.\n      sandboxRuntimePaths: [path.join(runtime.packageRoot, \"lib\", \"cli\"), path.join(runtime.packageRoot, \"lib\", \"core\")],\n    },\n    nexusExecutable: runtime.nexusExecutable,\n    dataset: path.resolve(options.dataset),\n    outputDir,\n    runs,\n    split: options.split,\n  });\n  const output = JSON.stringify({\n    schemaVersion: 1,\n    dataset: path.resolve(options.dataset),\n    runs,\n    score: runner.score,\n    artifacts: {\n      outputDir: runner.outputDir,\n      resultsFile: runner.resultsFile,\n      manifestFile: runner.manifestFile,\n      scoreFile: runner.scoreFile,\n    },\n  }, null, 2);\n  fs.mkdirSync(path.dirname(outputPath), { recursive: true });\n  fs.writeFileSync(outputPath, `${output}\\n`, { encoding: \"utf8\", mode: 0o600, flag: \"wx\" });\n  return { output, runner };\n}\n// Runs one evaluation candidate behind a namespace-local TCP endpoint and a host-side Unix-socket proxy.\n// The candidate sees only the run-scoped local token; the upstream gateway credential stays in run.mjs.\nimport http from \"node:http\";\nimport { spawn } from \"node:child_process\";\nimport { StringDecoder } from \"node:string_decoder\";\n\n// The launch payload is the first stdin line. With payload.protocol the rest of stdin is the agent's stdin (the T3\n// sidecar protocol); otherwise the agent gets no stdin.\nconst payload = JSON.parse(await readPayloadLine());\nconst port = 40127; // private to this network namespace; no host listener uses this port\nconst server = http.createServer((req, res) => {\n  const upstream = http.request({ socketPath: \"/run/eval-proxy/proxy.sock\", agent: new http.Agent({ keepAlive: false }), method: req.method, path: req.url, headers: { ...req.headers, host: \"eval-proxy\", connection: \"close\" } }, (response) => {\n    res.writeHead(response.statusCode ?? 502, response.headers);\n    response.pipe(res);\n    response.once(\"end\", () => upstream.destroy());\n  });\n  upstream.on(\"error\", (error) => {\n    if (!res.headersSent) res.writeHead(502, { \"content-type\": \"application/json\" });\n    res.end(JSON.stringify({ error: { type: \"proxy_unavailable\", message: \"evaluation proxy unavailable\" } }));\n  });\n  req.pipe(upstream);\n});\nawait new Promise((resolve, reject) => {\n  server.once(\"error\", reject);\n  server.listen(port, \"127.0.0.1\", resolve);\n});\n\nconst endpoint = `http://127.0.0.1:${port}/v1`;\nconst env = { ...payload.env };\nfor (const [key, value] of Object.entries(env)) {\n  if (typeof value === \"string\") env[key] = value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint);\n}\nconst argv = payload.argv.map((value) => value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint));\nconst agent = spawn(payload.command, argv, { cwd: \"/workspace\", env, stdio: [payload.protocol ? \"pipe\" : \"ignore\", \"inherit\", \"inherit\"] });\nif (payload.protocol) {\n  agent.stdin.on(\"error\", () => {});\n  process.stdin.pipe(agent.stdin);\n  process.stdin.resume();\n}\nlet stopping = false;\nconst stop = (signal) => {\n  if (stopping) return;\n  stopping = true;\n  try { process.kill(-agent.pid, signal); } catch { agent.kill(signal); }\n};\nprocess.on(\"SIGTERM\", () => stop(\"SIGTERM\"));\nprocess.on(\"SIGINT\", () => stop(\"SIGINT\"));\nagent.on(\"error\", (error) => {\n  process.stderr.write(`candidate spawn failed: ${error.message}\\n`);\n  closeBridge(127);\n});\nagent.on(\"close\", (code, signal) => {\n  closeBridge(code ?? (signal ? 128 : 1));\n});\n\n/** Reads stdin up to the first newline (or its end); anything after the newline is put back for the agent. */\nfunction readPayloadLine() {\n  return new Promise((resolve, reject) => {\n    let body = \"\";\n    const decoder = new StringDecoder(\"utf8\");\n    const onData = (chunk) => {\n      body += decoder.write(chunk);\n      if (body.length > 1_000_000) { cleanup(); reject(new Error(\"sandbox launch payload too large\")); return; }\n      const newline = body.indexOf(\"\\n\");\n      if (newline < 0) return;\n      cleanup();\n      process.stdin.pause();\n      const rest = body.slice(newline + 1);\n      if (rest) process.stdin.unshift(Buffer.from(rest, \"utf8\"));\n      resolve(body.slice(0, newline));\n    };\n    const onEnd = () => { cleanup(); resolve(body); };\n    const cleanup = () => { process.stdin.off(\"data\", onData); process.stdin.off(\"end\", onEnd); process.stdin.off(\"error\", reject); };\n    process.stdin.on(\"data\", onData);\n    process.stdin.on(\"end\", onEnd);\n    process.stdin.on(\"error\", reject);\n  });\n}\n\nfunction closeBridge(exitCode) {\n  process.exitCode = exitCode;\n  server.closeAllConnections?.();\n  server.close();\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","create_time":1793733706.7499187}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
