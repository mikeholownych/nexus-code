n: number; toolResponse: number; total: number } {\n    const limits = this.effectiveLimits();\n    const completion = limits.outputAllowance;\n    const toolResponse = toolHeadroomPolicy(limits.contextLimit, this.config.toolResponseReserveTokens);\n    return { completion, toolResponse, total: completion + toolResponse };\n  }\n\n  /** The selected model's context and output limits from the models.dev data, for cloud providers only (never the appliance). */\n  private referenceLimits(): { context?: number; output?: number } | undefined {\n    const provider = this.config.provider;\n    if (!provider || !this.config.model) return undefined;\n    const model = snapshotModel(provider, this.config.model);\n    return model ? { context: model.context, output: model.output } : undefined;\n  }\n\n  /**\n   * The limits in effect, resolved on every read from the last advertisement and the operator's current settings\n   * (resolveLimits): a changed `--context-limit` or allowance takes effect at once, without waiting for a refresh.\n   */\n  private effectiveLimits(): ReturnType<typeof resolveLimits> {\n    const limits = resolveLimits(this.capabilities?.advertised, this.config.contextLimit, this.config.completionReserveTokens, this.referenceLimits());\n    if (this.capabilities) Object.assign(this.capabilities, limits);\n    return limits;\n  }\n\n  /**\n   * The client estimate of a request, scaled by the last measured/estimated ratio when the connection counts requests\n   * (estimateScale): admission's compaction ladder then aims at what the provider will actually count.\n   */\n  private scaledBudget(messages: ChatMessage[], contextLimit: number, tools: ToolDefinition[] = this.getEffectiveTools()): TokenBudget {\n    const budget = calculateContextBudget(this.requestMessages(messages), tools, contextLimit);\n    return this.estimateScale === 1 ? budget : { ...budget, totalActiveTokens: Math.ceil(budget.totalActiveTokens * this.estimateScale) };\n  }\n\n  /** The context window in effect: advertised capacity, the operator's setting, or the client default (in that order of authority, see resolveLimits). */\n  private contextLimit(): number {\n    return this.effectiveLimits().contextLimit;\n  }\n\n  /** Sizing and counting evidence for receipts: what the limits were, where they came from, how the last request was counted. */\n  private tokenAccounting(): NonNullable<TurnResult[\"tokenAccounting\"]> {\n    const caps = this.capabilities;\n    const reserves = this.getContextReserves();\n    const last = this.lastRequestCount;\n    return {\n      contextLimit: this.contextLimit(),\n      contextSource: caps?.contextSource ?? (this.config.contextLimit ? \"operator\" : \"client_default\"),\n      outputAllowance: reserves.completion,\n      outputSource: caps?.outputSource ?? (this.config.completionReserveTokens ? \"operator\" : \"client_default\"),\n      toolHeadroomPolicy: reserves.toolResponse,\n      discovery: caps?.discovery ?? \"unknown\",\n      tokenCounting: caps?.tokenCounting ?? \"unknown\",\n      ...(caps?.advertised?.limitsVersion ? { limitsVersion: caps.advertised.limitsVersion } : {}),\n      ...(caps?.advertised?.workers?.length ? { workers: caps.advertised.workers } : {}),\n      ...(last\n        ? {\n            lastRequest: {\n              step: last.step,\n              promptTokens: last.promptTokens,\n              source: last.source,\n              clientEstimate: last.estimate,\n              ...(last.workerId ? { countedWorker: last.workerId } : {}),\n              ...(last.detail ? { uncertainty: last.detail } : {}),\n              ...(last.admitted?.promptTokens !== undefined ? { admittedTokens: last.admitted.promptTokens, admittedSource: last.admitted.source } : {}),\n              ...(last.admitted?.workerId ? { admittedWorker: last.admitted.workerId } : {}),\n              ...(last.workerDiffers ? { workerDiffers: true } : {}),\n            },\n          }\n        : {}),\n    };\n  }\n\n  public getProviderCapabilities(): ProviderCapabilities | undefined {\n    return this.capabilities;\n  }\n\n  /**\n   * What the gateway reported about the request it admitted (response headers): its own count (`exact_admitted`), the\n   * worker and pool it routed to, and the limits in force there. A different worker than the counted one, or a capacity\n   * other than the one in effect, is recorded and makes the next step re-read the provider's capabilities.\n   */\n  private noteAdmission(client: LocalLlmClient, step: number): void {\n    const admitted = typeof client.getLastAdmission === \"function\" ? client.getLastAdmission() : undefined;\n    if (!admitted) return;\n    const counted = this.lastRequestCount?.step === step ? this.lastRequestCount : undefined;\n    const workerDiffers = Boolean(counted?.workerId && admitted.workerId && counted.workerId !== admitted.workerId);\n    if (counted) {\n      counted.admitted = admitted;\n      counted.workerDiffers = workerDiffers;\n    }\n    const advertisedContext = this.capabilities?.advertised?.contextLength;\n    if (admitted.contextLimit && admitted.contextLimit !== (typeof advertisedContext === \"number\" ? advertisedContext : this.contextLimit())) {\n      this.capabilitiesStale = `admitted on ${admitted.workerId ?? \"a worker\"} with context ${admitted.contextLimit} (advertised: ${advertisedContext ?? \"none\"})`;\n    }\n    if (!process.stdout.isTTY || process.env.NEXUS_DEBUG === \"1\") {\n      console.log(`[token_count] step=${step} admitted source=${admitted.source ?? \"none\"} prompt_tokens=${admitted.promptTokens ?? \"?\"} worker=${admitted.workerId ?? \"?\"} pool=${admitted.pool ?? \"?\"} limits_version=${admitted.limitsVersion ?? \"?\"} context_limit=${admitted.contextLimit ?? \"?\"}${counted ? ` counted_source=${counted.source} counted_tokens=${counted.promptTokens} counted_worker=${counted.workerId ?? \"?\"}` : \"\"}${workerDiffers ? \" worker_differs=true\" : \"\"}${admitted.clamped ? \" clamped=true\" : \"\"}`);\n    }\n  }\n\n  public getLastRequestCount(): (RequestCount & { estimate: number; step: number; admitted?: AdmissionReport; workerDiffers?: boolean }) | undefined {\n    return this.lastRequestCount;\n  }\n\n  /**\n   * Discovers (or refreshes) what the connection `client` advertises: context capacity, output allowance, limits\n   * version, serving workers and request counting. Network only when nothing is known for this endpoint and model,\n   * when `force` (model or routing changed, capacity rejected, a different worker or capacity was observed), or after\n   * CAPABILITY_TTL_MS. Failure is scoped to this capability: the connection keeps the operator's or default limits,\n   * labelled as such. Never consults another endpoint or provider.\n   */\n  private async refreshCapabilities(client: LocalLlmClient, reason: string, force = false, signal?: AbortSignal): Promise<void> {\n    if (this.depth > 0 && this.capabilities) return;\n    // Clients without discovery (test doubles, minimal connections) keep the configured or default limits.\n    if (typeof client.discoverAdvertisement !== \"function\" || typeof client.getModel !== \"function\") return;\n    const key = `${client.getActiveEndpoint?.() ?? \"\"}|${client.getModel()}`;\n    const current = this.capabilities;\nimport { createHash } from \"node:crypto\";\nimport { countTokens } from \"../tokens.js\";\n\nexport type ContextScope = \"turn\" | \"session\" | \"task\" | \"repository\" | \"profile\" | \"user\";\nexport type ContextFreshness = \"current\" | \"stale\" | \"unknown\";\nexport type ContextTrust = \"operator_input_untrusted\" | \"model_generated_unverified\" | \"tool_output_unverified\" | \"persisted_unverified\" | \"system_instruction\" | \"verified_evidence\";\nexport type ContextSourceStatus = \"ok\" | \"partial\" | \"failed\";\n\nexport interface ContextInventoryItem {\n  id: string;\n  sourceType: string;\n  sourceLocation: string;\n  scope: ContextScope;\n  observedAt: string;\n  freshness: ContextFreshness;\n  freshnessRule?: string;\n  trust: ContextTrust;\n  retention: string;\n  inclusionReason: string;\n  retrievalMethod: string;\n  estimatedTokens: number;\n  sourceRefs?: string[];\n}\n\nexport interface ContextSourceMeasurement {\n  source: string;\n  status: ContextSourceStatus;\n  durationMs: number;\n  itemCount: number;\n  includedItemCount: number;\n  omittedItemCount: number;\n  estimatedTokens: number;\n  detail?: string;\n}\n\nexport interface ContextInventorySnapshot {\n  schemaVersion: 1;\n  capturedAt: string;\n  sessionId?: string;\n  taskId?: string;\n  workspace?: string;\n  coverage: \"complete\" | \"partial\";\n  coverageGaps: string[];\n  items: ContextInventoryItem[];\n  sourceMeasurements: ContextSourceMeasurement[];\n  metrics: {\n    assemblyDurationMs: number;\n    includedItems: number;\n    omittedItems: number;\n    estimatedTokens: number;\n    tokenSource: \"client_estimate\";\n    contextLimit?: number;\n    contextLimitSource?: string;\n    lastRequestTokens?: number;\n    lastRequestTokenSource?: string;\n    budgetStatus: \"within_budget\" | \"over_budget\" | \"unknown\";\n  };\n}\n\nexport interface ContextSourceItemInput {\n  sourceType: string;\n  sourceLocation: string;\n  scope: ContextScope;\n  content: string;\n  trust: ContextTrust;\n  retention: string;\n  inclusionReason: string;\n  retrievalMethod: string;\n  freshness?: ContextFreshness;\n  freshnessRule?: string;\n  sourceRefs?: string[];\n}\n\nexport interface ContextInventoryInput {\n  capturedAt?: string;\n  sessionId?: string;\n  taskId?: string;\n  workspace?: string;\n  sources: Array<{ name: string; status: ContextSourceStatus; durationMs: number; items: ContextSourceItemInput[]; detail?: string }>;\n  coverageGaps?: string[];\n  maxItems?: number;\n  contextLimit?: number;\n  contextLimitSource?: string;\n  lastRequestTokens?: number;\n  lastRequestTokenSource?: string;\n}\n\nconst DEFAULT_MAX_ITEMS = 500;\nconst MAX_SOURCE_DETAIL = 240;\n\nfunction stableId(sourceType: string, sourceLocation: string, scope: ContextScope): string {\n  const digest = createHash(\"sha256\").update(`${sourceType}\\0${sourceLocation}\\0${scope}`).digest(\"hex\").slice(0, 24);\n  return `ctx_${digest}`;\n}\n\nfunction metadataText(value: string, max = 1000): string {\n  return value.replace(/[\\u0000-\\u001f\\u007f-\\u009f]/g, \" \").slice(0, max);\n}\n\nfunction boundedDuration(value: number): number {\n  return Number.isFinite(value) ? Math.max(0, Math.round(value * 100) / 100) : 0;\n}\n\n/** Build a content-free inventory. Source text is counted and discarded; it is never included in the returned record. */\nexport function buildContextInventory(input: ContextInventoryInput): ContextInventorySnapshot {\n  const capturedAt = input.capturedAt ?? new Date().toISOString();\n  const started = performance.now();\n  const maxItems = Number.isSafeInteger(input.maxItems) && (input.maxItems ?? 0) > 0 ? input.maxItems! : DEFAULT_MAX_ITEMS;\n  const candidates: ContextInventoryItem[] = [];\n  const sourceMeasurements: ContextSourceMeasurement[] = [];\n  let totalCandidateItems = 0;\n  for (const source of input.sources) {\n    let estimatedTokens = 0;\n    const remaining = Math.max(0, maxItems - candidates.length);\n    const included = source.items.slice(0, remaining);\n    totalCandidateItems += source.items.length;\n    for (const item of included) {\n      const tokens = countTokens(item.content);\n      estimatedTokens += tokens;\n      const sourceType = metadataText(item.sourceType, 80);\n      const sourceLocation = metadataText(item.sourceLocation);\n      const freshness = item.freshnessRule ? item.freshness ?? \"unknown\" : \"unknown\";\n      candidates.push({\n        id: stableId(sourceType, sourceLocation, item.scope),\n        sourceType,\n        sourceLocation,\n        scope: item.scope,\n        observedAt: capturedAt,\n        freshness,\n        ...(item.freshnessRule ? { freshnessRule: metadataText(item.freshnessRule) } : {}),\n        trust: item.trust,\n        retention: metadataText(item.retention, 120),\n        inclusionReason: metadataText(item.inclusionReason),\n        retrievalMethod: metadataText(item.retrievalMethod, 100),\n        estimatedTokens: tokens,\n        ...(item.sourceRefs?.length ? { sourceRefs: item.sourceRefs.slice(0, 100).map((ref) => metadataText(ref, 200)) } : {}),\n      });\n    }\n    sourceMeasurements.push({\n      source: source.name,\n      status: source.status,\n      durationMs: boundedDuration(source.durationMs),\n      itemCount: source.items.length,\n      includedItemCount: included.length,\n      omittedItemCount: source.items.length - included.length,\n      estimatedTokens,\n      ...(source.detail ? { detail: source.detail.replace(/[\\r\\n\\t]/g, \" \").slice(0, MAX_SOURCE_DETAIL) } : {}),\n    });\n  }\n\n  // Keep a deterministic prefix so the same source order produces the same bounded snapshot and token work.\n  const items = candidates;\n  const omittedItems = totalCandidateItems - items.length;\n  const gaps = [...(input.coverageGaps ?? [])];\n  if (omittedItems) gaps.push(`inventory item limit omitted ${omittedItems} item(s)`);\n  if (sourceMeasurements.some((source) => source.status !== \"ok\")) gaps.push(\"one or more context sources were partial or unavailable\");\n  const estimatedTokens = items.reduce((sum, item) => sum + item.estimatedTokens, 0);\n  const coverage: ContextInventorySnapshot[\"coverage\"] = gaps.length ? \"partial\" : \"complete\";\n  const limit = input.contextLimit;\n  const budgetStatus = limit === undefined || gaps.length > 0 || omittedItems > 0 || sourceMeasurements.some((source) => source.status !== \"ok\")\n    ? \"unknown\"\n    : estimatedTokens <= limit ? \"within_budget\" : \"over_budget\";\n\n  return {\n    schemaVersion: 1,\n    capturedAt,\n    ...(input.sessionId ? { sessionId: input.sessionId } : {}),\n    ...(input.taskId ? { taskId: input.taskId } : {}),\n    ...(input.workspace ? { workspace: input.workspace } : {}),\n    coverage,\n    coverageGaps: [...new Set(gaps)],\n    items,\n    sourceMeasurements,\n    metrics: {\n      assemblyDurationMs: boundedDuration(performance.now() - started),\n      includedItems: items.length,\n      omittedItems,\n      estimatedTokens,\n      tokenSource: \"client_estimate\",\n      ...(limit !== undefined ? { contextLimit: limit } : {}),\n      ...(input.contextLimitSource ? { contextLimitSource: input.contextLimitSource } : {}),\n      ...(input.lastRequestTokens !== undefined ? { lastRequestTokens: input.lastRequestTokens } : {}),\n      ...(input.lastRequestTokenSource ? { lastRequestTokenSource: input.lastRequestTokenSource } : {}),\n      budgetStatus,\n    },\n  };\n}\n\n/** Rebuild only what legacy/session records can establish; repository freshness remains unknown. */\nexport function inventorySourcesFromMessages(messages: readonly any[], options: { archived?: boolean; sourcePrefix?: string } = {}): ContextSourceItemInput[] {\n  const archived = Boolean(options.archived);\n  const sourcePrefix = options.sourcePrefix ?? (archived ? \"archive\" : \"session\");\n  const items: ContextSourceItemInput[] = [];\n  messages.forEach((message, index) => {\n    const content = typeof message?.content === \"string\" ? message.content : safeJson(message?.content);\n    if (!content) return;\n    let sourceType: string;\n    let scope: ContextScope = \"session\";\n    let trust: ContextTrust;\n    if (message?.role === \"tool\") {\n      sourceType = \"tool_output\";\n      trust = \"tool_output_unverified\";\n    } else if (message?.role === \"assistant\") {\n      sourceType = \"model_output\";\n      trust = \"model_generated_unverified\";\n    } else if (message?.role === \"user\" && message?.harness === \"skill-note\") {\n      sourceType = \"skill_note\";\n      scope = \"profile\";\n      trust = \"persisted_unverified\";\n    } else if (message?.role === \"user\") {\n      sourceType = \"operator_message\";\n      trust = \"operator_input_untrusted\";\n    } else if (message?.role === \"system\" && content.startsWith(\"[Structured Context Memory - durable task state]\")) {\n      sourceType = \"compaction_summary\";\n      trust = \"persisted_unverified\";\n    } else {\n      sourceType = \"system_context\";\n      trust = \"persisted_unverified\";\n    }\n    const location = `${sourcePrefix}:message:${index}:${String(message?.role ?? \"unknown\")}`;\n    if (workspacePath && (!selectedWorkspace || !selectedWorkspace.matches(workspacePath.value))) {\n      throw new Error(\"Session workspace identity is not selected by the application\");\n    }\n    if (selectedWorkspace) this.stateManager.setWorkspacePaths([selectedWorkspace]);\n    const taskId = session.taskId || session.id;\n    const sessionId = session.sessionId || session.id;\n    const workspace = session.workspace || session.workspacePath || process.cwd();\n\n    const fullState: SessionData = {\n      schemaVersion: session.schemaVersion || CURRENT_STATE_SCHEMA_VERSION,\n      taskId,\n      sessionId,\n      id: sessionId,\n      title: session.title || \"Active Session\",\n      workspacePath: workspace,\n      workspace,\n      model: session.model || \"default\",\n      ...(session.endpoint ? { endpoint: persistableEndpoint(session.endpoint) } : {}),\n      createdAt: session.createdAt || new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n      status: session.status || \"in_progress\",\n      activePlan: session.activePlan || [],\n      milestones: session.milestones || [],\n      worktreeBinding: session.worktreeBinding || null,\n      candidateId: session.candidateId || null,\n      candidateIdentity: session.candidateIdentity || null,\n      validationReceipts: session.validationReceipts || [],\n      currentOperation: session.currentOperation || null,\n      // Present-or-absent, not defaulted: an explicit null is a recorded \"none\", and absence must not invent a value.\n      ...(session.providerRecovery !== undefined ? { providerRecovery: session.providerRecovery } : {}),\n      ...(session.operation !== undefined ? { operation: session.operation } : {}),\n      ...(session.changeBaseline !== undefined ? { changeBaseline: session.changeBaseline } : {}),\n      messages: session.messages || [],\n      contextInventory: isContextInventorySnapshot(session.contextInventory) &&\n          (!session.contextInventory.sessionId || session.contextInventory.sessionId === sessionId) &&\n          (!session.contextInventory.workspace || path.resolve(session.contextInventory.workspace) === path.resolve(workspace))\n        ? session.contextInventory\n        : buildSessionContextInventory({ ...session, id: sessionId, taskId, sessionId, workspace, messages: session.messages || [] }),\n      ...(session.pinned !== undefined ? { pinned: session.pinned } : {}),\n      ...(session.unverifiedChangesPending !== undefined ? { unverifiedChangesPending: session.unverifiedChangesPending } : {}),\n      durableNotes: session.durableNotes,\n      compactionProvenance: session.compactionProvenance,\n      cognitiveRouting: session.cognitiveRouting,\n      tokenStats: session.tokenStats,\n      ...(session.lastTurn !== undefined ? { lastTurn: session.lastTurn } : {}),\n      ...(session.objective !== undefined ? { objective: session.objective } : {}),\n      ...(session.findings !== undefined ? { findings: session.findings } : {}),\n      ...(session.verificationConfigAttempts !== undefined ? { verificationConfigAttempts: session.verificationConfigAttempts } : {}),\n      ...(session.commandRuleDecisions !== undefined ? { commandRuleDecisions: session.commandRuleDecisions } : {}),\n      ...(session.history !== undefined ? { history: session.history } : {}),\n      ...(session.forkedFrom !== undefined ? { forkedFrom: session.forkedFrom } : {}),\n    };\n\n    this.stateManager.saveTaskState(fullState, selectedWorkspace ? [selectedWorkspace] : []);\n    const committed = this.stateManager.loadTaskState(taskId, undefined, selectedWorkspace ? [selectedWorkspace] : []);\n    this.updateIndexEntry({\n      id: sessionId,\n      cleanId: taskId.replace(/\\.json$/, \"\"),\n      title: committed.title || \"Active Session\",\n      updatedAt: committed.updatedAt || new Date().toISOString(),\n      workspace,\n      messageCount: committed.messages.length,\n      mtime: Date.now(),\n      pinned: Boolean(committed.pinned),\n    });\n  }\n  model?: string;\n  /** The inference endpoint the model was chosen on (a resume without --model adopts the model only on the same one). */\n  endpoint?: string;\n  createdAt: string;\n  updatedAt: string;\n  status: TaskLifecycleStatus;\n\n  // Retention: pinned sessions are never pruned by GC (REQ-PER-102, DEC-11)\n  pinned?: boolean;\n\n  // Authoritative task milestones (PERS-001)\n  activePlan: DurablePlanPhase[];\n  milestones: DurableMilestoneRecord[];\n\n  // Worktree binding (PERS-004)\n  worktreeBinding?: DurableWorktreeBinding | null;\n\n  // Candidate & validation binding (WP-04, PERS-003, PERS-004)\n  candidateId?: string | null;\n  candidateIdentity?: CandidateIdentity | null;\n  validationReceipts: ValidationReceipt[];\n\n  // Authoritative result of the most recent turn (execution / outcome / acceptance dimensions)\n  lastTurn?: TurnResult | null;\n\n  // In-flight operation tracking for interrupted-state detection (PERS-002, F-07). Cleared once the operation's\n  // result is part of the durable conversation; a record still present at recovery means the result was not saved.\n  currentOperation?: InFlightOperationRecord | null;\n\n  // Workspace changes this task made that no verifier has established yet. Recorded when the change happens and\n  // restored on every resume, so a later attempt that changes nothing cannot finish as NOT_REQUIRED.\n  unverifiedChangesPending?: boolean;\n\n  // Inference step waiting out a temporary provider failure (no tool or history change happens while waiting)\n  providerRecovery?: ProviderRecoveryRecord | null;\n\n  // Convergence-scheduled operation: work units, resource conditions and the wake condition while waiting\n  operation?: DurableOperationState;\n\n  // Context & conversation memory\n  messages: ChatMessage[];\n  /** Content-free, optional context provenance snapshot. Missing legacy values reconstruct as partial/unknown. */\n  contextInventory?: ContextInventorySnapshot;\n  durableNotes?: string[];\n  compactionProvenance?: CompactionProvenanceRecord | null;\n\n  // Reconstructible cognitive routing stats\n  cognitiveRouting?: DurableCognitiveRouting;\n  tokenStats?: {\n    prompt: number;\n    completion: number;\n    total: number;\n    /** Inference requests counted, and how many totals came from provider usage reports rather than estimates. */\n    requests?: number;\n    reportedRequests?: number;\n    estimatedRequests?: number;\n  };\n\n  // The operator's objective, acceptance requirements, steering and verifier attempts (core/objective.ts)\n  objective?: ObjectiveLedger | null;\n\n  /** Bounded `/loop` controller state; child work remains in the existing operation records. */\n  loop?: DurableLoopState | null;\n\n  // Full text of the findings the model recorded from inspected output (core/findings.ts); the durable record in\n  // `messages` may show them only condensed or by id.\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { randomBytes } from \"node:crypto\";\nimport { ChatMessage } from \"./types.js\";\nimport {\n  DurableTaskState,\n  DurableStateManager,\n  TaskRecoveryOptions,\n  TaskRecoveryResult,\n  CURRENT_STATE_SCHEMA_VERSION,\n  WORKTREE_BINDING_VERSION,\n  CorruptStateError,\n  UnsupportedSchemaVersionError,\n} from \"./core/state.js\";\nimport { withStateStoreGuard } from \"./core/state_store_guard.js\";\nimport { WorkspacePath } from \"./core/workspace_path.js\";\nimport { isManagedWorktreePath, isNamedWorktreePath, protectArchivedMessages } from \"./core/persistence_protection.js\";\nimport { insertedBlockPresent, isCompactionRecord } from \"./core/compaction_record.js\";\nimport { appendLinesDurably, readArchiveLines, type ArchiveRead, ensurePrivateDir, writePrivateFile } from \"./core/durable_file.js\";\nimport { persistableEndpoint } from \"./core/endpoint_identity.js\";\nimport { WorktreeManager } from \"./worktree.js\";\nimport { buildSessionContextInventory, isContextInventorySnapshot, markPersistedContextFreshnessUnknown } from \"./core/context_inventory.js\";\n\n// Re-export core state primitives\nexport * from \"./core/state.js\";\n\nexport class AmbiguousSessionResumeError extends Error {\n  public readonly prefix: string;\n  public readonly candidates: string[];\n  constructor(prefix: string, candidates: string[]) {\n    super(`Ambiguous session ID prefix '${prefix}'. Matches: ${candidates.join(\", \")}`);\n    this.name = \"AmbiguousSessionResumeError\";\n    this.prefix = prefix;\n    this.candidates = candidates;\n  }\n}\n\n/**\n * Upgraded SessionData envelope conforming to DurableTaskState (PERS-001..PERS-004).\n */\nexport interface SessionData extends DurableTaskState {\n  id: string;\n  workspace: string;\n  model: string;\n}\n\nexport interface SessionIndexEntry {\n  id: string;\n  cleanId: string;\n  title: string;\n  updatedAt: string;\n  workspace: string;\n  messageCount: number;\n  mtime: number;\n  pinned?: boolean;\n}\n\nexport interface SessionIndexData {\n  version: 1;\n  updatedAt: string;\n  sessions: Record<string, SessionIndexEntry>;\n}\n\n/** Where interactive sessions are saved unless a directory is given. */\nexport function defaultSessionsDir(): string {  if (process.env.NEXUS_STATE_DIR) {\n    return path.join(process.env.NEXUS_STATE_DIR, \"sessions\");\n  }\n  return path.join(os.homedir(), \".nexus\", \"sessions\");\n}\n\n/** Cryptographically unpredictable base36 suffix; the length stays inside the\n *  egress classifier's session-id whitelist (session_\\d{8}_\\d{6}_[a-z0-9]{1,8}). */\nfunction randomBase36Suffix(length: number): string {\n  const alphabet = \"REDACTED\";\n  let suffix = \"\";\n  while (suffix.length < length) {\n    for (const byte of randomBytes(length)) {\n      // Rejection sampling keeps the base-36 mapping unbiased (36 * 7 = 252).\n      if (byte >= 252) continue;\n      if (suffix.length < length) suffix += alphabet[byte % 36];\n    }\n  }\n  return suffix;\n}\n\n/** The longest prefix of `messages` no longer than `n` that does not end inside a tool exchange (a call without all its results). */\nfunction completeExchangePrefix(messages: ChatMessage[], n: number): number {\n  let end = n;\n  while (end > 1) {\n    let owner = end - 1;\n    while (owner > 0 && messages[owner].role === \"tool\") owner--;\n    const head = messages[owner];\n    const calls = head.role === \"assistant\" ? head.tool_calls ?? [] : [];\n    if (!calls.length) return end;\n    const answered = new Set(messages.slice(owner + 1, end).filter((x) => x.role === \"tool\").map((x) => x.tool_call_id));\n    if (calls.every((c) => answered.has(c.id))) return end;\n    end = owner;\n  }\n  return end;\n}\n\nexport class SessionManager {\n  private sessionsDir: string;\n  private stateManager: DurableStateManager;\n  private readonly selectedWorkspace: (() => WorkspacePath) | undefined;\n\n  constructor(customDir?: string, selectedWorkspace?: () => WorkspacePath) {\n    this.sessionsDir = customDir || defaultSessionsDir();\n    this.selectedWorkspace = selectedWorkspace;\n","exit_code":0,"duration":{"secs":0,"nanos":861933722}},"started_at_ms":1795397910682,"completed_at_ms":1795397911545}}
{"timestamp":"2026-11-23T01:38:31.752Z","ordinal":70115,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a2060e-04c7-7d31-b402-3ac9403d337c","call_id":"call_8a6a092f6b2d48d0bd8d114d2e43630b","output":[{"type":"input_text","text":"Script completed\nWall time 1.3 seconds\nOutput:\n"},{"type":"input_text","text":"    try {\n      this.observer.onActivity({ phase, step: turn.step, segment: this.objective?.continuation.segments ?? 1, ...extra });\n    } catch {}\n  }\n\n  public getContextBudget(): TokenBudget {\n    const limit = this.contextLimit();\n    return calculateContextBudget(this.messages, this.getEffectiveTools(), limit);\n  }\n\n  /**\n   * What admission keeps free beside the prompt: the output allowance (advertised by the provider, set by the operator,\n   * or the client default, see provider_capabilities.ts) and the tool-output headroom, a scheduling policy for the next\n   * tool results (min(4096, context/8) unless configured). Neither is a measurement.\n   */\n  private getContextReserves(): { completion: number; toolResponse: number; total: number } {\n    const limits = this.effectiveLimits();\n    const completion = limits.outputAllowance;\n    const toolResponse = toolHeadroomPolicy(limits.contextLimit, this.config.toolResponseReserveTokens);\n    return { completion, toolResponse, total: completion + toolResponse };\n  }\n\n  /** The selected model's context and output limits from the models.dev data, for cloud providers only (never the appliance). */\n  private referenceLimits(): { context?: number; output?: number } | undefined {\n    const provider = this.config.provider;\n    if (!provider || !this.config.model) return undefined;\n    const model = snapshotModel(provider, this.config.model);\n    return model ? { context: model.context, output: model.output } : undefined;\n  }\n\n  /**\n   * The limits in effect, resolved on every read from the last advertisement and the operator's current settings\n   * (resolveLimits): a changed `--context-limit` or allowance takes effect at once, without waiting for a refresh.\n   */\n  private effectiveLimits(): ReturnType<typeof resolveLimits> {\n    const limits = resolveLimits(this.capabilities?.advertised, this.config.contextLimit, this.config.completionReserveTokens, this.referenceLimits());\n    if (this.capabilities) Object.assign(this.capabilities, limits);\n    return limits;\n  }\n\n  /**\n   * The client estimate of a request, scaled by the last measured/estimated ratio when the connection counts requests\n   * (estimateScale): admission's compaction ladder then aims at what the provider will actually count.\n   */\n  private scaledBudget(messages: ChatMessage[], contextLimit: number, tools: ToolDefinition[] = this.getEffectiveTools()): TokenBudget {\n    const budget = calculateContextBudget(this.requestMessages(messages), tools, contextLimit);\n    return this.estimateScale === 1 ? budget : { ...budget, totalActiveTokens: Math.ceil(budget.totalActiveTokens * this.estimateScale) };\n  }\n\n  /** The context window in effect: advertised capacity, the operator's setting, or the client default (in that order of authority, see resolveLimits). */\n  private contextLimit(): number {\n    return this.effectiveLimits().contextLimit;\n  }\n\n  /** Sizing and counting evidence for receipts: what the limits were, where they came from, how the last request was counted. */\n  private tokenAccounting(): NonNullable<TurnResult[\"tokenAccounting\"]> {\n    const caps = this.capabilities;\n    const reserves = this.getContextReserves();\n    const last = this.lastRequestCount;\n    return {\n      contextLimit: this.contextLimit(),\n      contextSource: caps?.contextSource ?? (this.config.contextLimit ? \"operator\" : \"client_default\"),\n      outputAllowance: reserves.completion,\n      outputSource: caps?.outputSource ?? (this.config.completionReserveTokens ? \"operator\" : \"client_default\"),\n      toolHeadroomPolicy: reserves.toolResponse,\n      discovery: caps?.discovery ?? \"unknown\",\n      tokenCounting: caps?.tokenCounting ?? \"unknown\",\n      ...(caps?.advertised?.limitsVersion ? { limitsVersion: caps.advertised.limitsVersion } : {}),\n      ...(caps?.advertised?.workers?.length ? { workers: caps.advertised.workers } : {}),\n      ...(last\n        ? {\n            lastRequest: {\n              step: last.step,\n              promptTokens: last.promptTokens,\n              source: last.source,\n              clientEstimate: last.estimate,\n              ...(last.workerId ? { countedWorker: last.workerId } : {}),\n              ...(last.detail ? { uncertainty: last.detail } : {}),\n              ...(last.admitted?.promptTokens !== undefined ? { admittedTokens: last.admitted.promptTokens, admittedSource: last.admitted.source } : {}),\n              ...(last.admitted?.workerId ? { admittedWorker: last.admitted.workerId } : {}),\n              ...(last.workerDiffers ? { workerDiffers: true } : {}),\n            },\n          }\n        : {}),\n    };\n  }\n\n  public getProviderCapabilities(): ProviderCapabilities | undefined {\n    return this.capabilities;\n  }\n\n  /**\n   * What the gateway reported about the request it admitted (response headers): its own count (`exact_admitted`), the\n   * worker and pool it routed to, and the limits in force there. A different worker than the counted one, or a capacity\n   * other than the one in effect, is recorded and makes the next step re-read the provider's capabilities.\n   */\n  private noteAdmission(client: LocalLlmClient, step: number): void {\n    const admitted = typeof client.getLastAdmission === \"function\" ? client.getLastAdmission() : undefined;\n    if (!admitted) return;\n    const counted = this.lastRequestCount?.step === step ? this.lastRequestCount : undefined;\n    const workerDiffers = Boolean(counted?.workerId && admitted.workerId && counted.workerId !== admitted.workerId);\n    if (counted) {\n      counted.admitted = admitted;\n      counted.workerDiffers = workerDiffers;\n    }\n    const advertisedContext = this.capabilities?.advertised?.contextLength;\n    if (admitted.contextLimit && admitted.contextLimit !== (typeof advertisedContext === \"number\" ? advertisedContext : this.contextLimit())) {\n      this.capabilitiesStale = `admitted on ${admitted.workerId ?? \"a worker\"} with context ${admitted.contextLimit} (advertised: ${advertisedContext ?? \"none\"})`;\n    }\n    if (!process.stdout.isTTY || process.env.NEXUS_DEBUG === \"1\") {\n      console.log(`[token_count] step=${step} admitted source=${admitted.source ?? \"none\"} prompt_tokens=${admitted.promptTokens ?? \"?\"} worker=${admitted.workerId ?? \"?\"} pool=${admitted.pool ?? \"?\"} limits_version=${admitted.limitsVersion ?? \"?\"} context_limit=${admitted.contextLimit ?? \"?\"}${counted ? ` counted_source=${counted.source} counted_tokens=${counted.promptTokens} counted_worker=${counted.workerId ?? \"?\"}` : \"\"}${workerDiffers ? \" worker_differs=true\" : \"\"}${admitted.clamped ? \" clamped=true\" : \"\"}`);\n    }\n  }\n\n  public getLastRequestCount(): (RequestCount & { estimate: number; step: number; admitted?: AdmissionReport; workerDiffers?: boolean }) | undefined {\n    return this.lastRequestCount;\n  }\n\n  /**\n   * Discovers (or refreshes) what the connection `client` advertises: context capacity, output allowance, limits\n   * version, serving workers and request counting. Network only when nothing is known for this endpoint and model,\n   * when `force` (model or routing changed, capacity rejected, a different worker or capacity was observed), or after\n   * CAPABILITY_TTL_MS. Failure is scoped to this capability: the connection keeps the operator's or default limits,\n   * labelled as such. Never consults another endpoint or provider.\n   */\n  private async refreshCapabilities(client: LocalLlmClient, reason: string, force = false, signal?: AbortSignal): Promise<void> {\n    if (this.depth > 0 && this.capabilities) return;\n    // Clients without discovery (test doubles, minimal connections) keep the configured or default limits.\n    if (typeof client.discoverAdvertisement !== \"function\" || typeof client.getModel !== \"function\") return;\n    const key = `${client.getActiveEndpoint?.() ?? \"\"}|${client.getModel()}`;\n    const current = this.capabilities;\nimport { createHash } from \"node:crypto\";\nimport { countTokens } from \"../tokens.js\";\n\nexport type ContextScope = \"turn\" | \"session\" | \"task\" | \"repository\" | \"profile\" | \"user\";\nexport type ContextFreshness = \"current\" | \"stale\" | \"unknown\";\nexport type ContextTrust = \"operator_input_untrusted\" | \"model_generated_unverified\" | \"tool_output_unverified\" | \"persisted_unverified\" | \"system_instruction\" | \"verified_evidence\";\nexport type ContextSourceStatus = \"ok\" | \"partial\" | \"failed\";\n\nexport interface ContextInventoryItem {\n  id: string;\n  sourceType: string;\n  sourceLocation: string;\n  scope: ContextScope;\n  observedAt: string;\n  freshness: ContextFreshness;\n  freshnessRule?: string;\n  trust: ContextTrust;\n  retention: string;\n  inclusionReason: string;\n  retrievalMethod: string;\n  estimatedTokens: number;\n  sourceRefs?: string[];\n}\n\nexport interface ContextSourceMeasurement {\n  source: string;\n  status: ContextSourceStatus;\n  durationMs: number;\n  itemCount: number;\n  includedItemCount: number;\n  omittedItemCount: number;\n  estimatedTokens: number;\n  detail?: string;\n}\n\nexport interface ContextInventorySnapshot {\n  schemaVersion: 1;\n  capturedAt: string;\n  sessionId?: string;\n  taskId?: string;\n  workspace?: string;\n  coverage: \"complete\" | \"partial\";\n  coverageGaps: string[];\n  items: ContextInventoryItem[];\n  sourceMeasurements: ContextSourceMeasurement[];\n  metrics: {\n    assemblyDurationMs: number;\n    includedItems: number;\n    omittedItems: number;\n    estimatedTokens: number;\n    tokenSource: \"client_estimate\";\n    contextLimit?: number;\n    contextLimitSource?: string;\n    lastRequestTokens?: number;\n    lastRequestTokenSource?: string;\n    budgetStatus: \"within_budget\" | \"over_budget\" | \"unknown\";\n  };\n}\n\nexport interface ContextSourceItemInput {\n  sourceType: string;\n  sourceLocation: string;\n  scope: ContextScope;\n  content: string;\n  trust: ContextTrust;\n  retention: string;\n  inclusionReason: string;\n  retrievalMethod: string;\n  freshness?: ContextFreshness;\n  freshnessRule?: string;\n  sourceRefs?: string[];\n}\n\nexport interface ContextInventoryInput {\n  capturedAt?: string;\n  sessionId?: string;\n  taskId?: string;\n  workspace?: string;\n  sources: Array<{ name: string; status: ContextSourceStatus; durationMs: number; items: ContextSourceItemInput[]; detail?: string }>;\n  coverageGaps?: string[];\n  maxItems?: number;\n  contextLimit?: number;\n  contextLimitSource?: string;\n  lastRequestTokens?: number;\n  lastRequestTokenSource?: string;\n}\n\nconst DEFAULT_MAX_ITEMS = 500;\nconst MAX_SOURCE_DETAIL = 240;\n\nfunction stableId(sourceType: string, sourceLocation: string, scope: ContextScope): string {\n  const digest = createHash(\"sha256\").update(`${sourceType}\\0${sourceLocation}\\0${scope}`).digest(\"hex\").slice(0, 24);\n  return `ctx_${digest}`;\n}\n\nfunction metadataText(value: string, max = 1000): string {\n  return value.replace(/[\\u0000-\\u001f\\u007f-\\u009f]/g, \" \").slice(0, max);\n}\n\nfunction boundedDuration(value: number): number {\n  return Number.isFinite(value) ? Math.max(0, Math.round(value * 100) / 100) : 0;\n}\n\n/** Build a content-free inventory. Source text is counted and discarded; it is never included in the returned record. */\nexport function buildContextInventory(input: ContextInventoryInput): ContextInventorySnapshot {\n  const capturedAt = input.capturedAt ?? new Date().toISOString();\n  const started = performance.now();\n  const maxItems = Number.isSafeInteger(input.maxItems) && (input.maxItems ?? 0) > 0 ? input.maxItems! : DEFAULT_MAX_ITEMS;\n  const candidates: ContextInventoryItem[] = [];\n  const sourceMeasurements: ContextSourceMeasurement[] = [];\n  let totalCandidateItems = 0;\n  for (const source of input.sources) {\n    let estimatedTokens = 0;\n    const remaining = Math.max(0, maxItems - candidates.length);\n    const included = source.items.slice(0, remaining);\n    totalCandidateItems += source.items.length;\n    for (const item of included) {\n      const tokens = countTokens(item.content);\n      estimatedTokens += tokens;\n      const sourceType = metadataText(item.sourceType, 80);\n      const sourceLocation = metadataText(item.sourceLocation);\n      const freshness = item.freshnessRule ? item.freshness ?? \"unknown\" : \"unknown\";\n      candidates.push({\n        id: stableId(sourceType, sourceLocation, item.scope),\n        sourceType,\n        sourceLocation,\n        scope: item.scope,\n        observedAt: capturedAt,\n        freshness,\n        ...(item.freshnessRule ? { freshnessRule: metadataText(item.freshnessRule) } : {}),\n        trust: item.trust,\n        retention: metadataText(item.retention, 120),\n        inclusionReason: metadataText(item.inclusionReason),\n        retrievalMethod: metadataText(item.retrievalMethod, 100),\n        estimatedTokens: tokens,\n        ...(item.sourceRefs?.length ? { sourceRefs: item.sourceRefs.slice(0, 100).map((ref) => metadataText(ref, 200)) } : {}),\n      });\n    }\n    sourceMeasurements.push({\n      source: source.name,\n      status: source.status,\n      durationMs: boundedDuration(source.durationMs),\n      itemCount: source.items.length,\n      includedItemCount: included.length,\n      omittedItemCount: source.items.length - included.length,\n      estimatedTokens,\n      ...(source.detail ? { detail: source.detail.replace(/[\\r\\n\\t]/g, \" \").slice(0, MAX_SOURCE_DETAIL) } : {}),\n    });\n  }\n\n  // Keep a deterministic prefix so the same source order produces the same bounded snapshot and token work.\n  const items = candidates;\n  const omittedItems = totalCandidateItems - items.length;\n  const gaps = [...(input.coverageGaps ?? [])];\n  if (omittedItems) gaps.push(`inventory item limit omitted ${omittedItems} item(s)`);\n  if (sourceMeasurements.some((source) => source.status !== \"ok\")) gaps.push(\"one or more context sources were partial or unavailable\");\n  const estimatedTokens = items.reduce((sum, item) => sum + item.estimatedTokens, 0);\n  const coverage: ContextInventorySnapshot[\"coverage\"] = gaps.length ? \"partial\" : \"complete\";\n  const limit = input.contextLimit;\n  const budgetStatus = limit === undefined || gaps.length > 0 || omittedItems > 0 || sourceMeasurements.some((source) => source.status !== \"ok\")\n    ? \"unknown\"\n    : estimatedTokens <= limit ? \"within_budget\" : \"over_budget\";\n\n  return {\n    schemaVersion: 1,\n    capturedAt,\n    ...(input.sessionId ? { sessionId: input.sessionId } : {}),\n    ...(input.taskId ? { taskId: input.taskId } : {}),\n    ...(input.workspace ? { workspace: input.workspace } : {}),\n    coverage,\n    coverageGaps: [...new Set(gaps)],\n    items,\n    sourceMeasurements,\n    metrics: {\n      assemblyDurationMs: boundedDuration(performance.now() - started),\n      includedItems: items.length,\n      omittedItems,\n      estimatedTokens,\n      tokenSource: \"client_estimate\",\n      ...(limit !== undefined ? { contextLimit: limit } : {}),\n      ...(input.contextLimitSource ? { contextLimitSource: input.contextLimitSource } : {}),\n      ...(input.lastRequestTokens !== undefined ? { lastRequestTokens: input.lastRequestTokens } : {}),\n      ...(input.lastRequestTokenSource ? { lastRequestTokenSource: input.lastRequestTokenSource } : {}),\n      budgetStatus,\n    },\n  };\n}\n\n/** Rebuild only what legacy/session records can establish; repository freshness remains unknown. */\nexport function inventorySourcesFromMessages(messages: readonly any[], options: { archived?: boolean; sourcePrefix?: string } = {}): ContextSourceItemInput[] {\n  const archived = Boolean(options.archived);\n  const sourcePrefix = options.sourcePrefix ?? (archived ? \"archive\" : \"session\");\n  const items: ContextSourceItemInput[] = [];\n  messages.forEach((message, index) => {\n    const content = typeof message?.content === \"string\" ? message.content : safeJson(message?.content);\n    if (!content) return;\n    let sourceType: string;\n    let scope: ContextScope = \"session\";\n    let trust: ContextTrust;\n    if (message?.role === \"tool\") {\n      sourceType = \"tool_output\";\n      trust = \"tool_output_unverified\";\n    } else if (message?.role === \"assistant\") {\n      sourceType = \"model_output\";\n      trust = \"model_generated_unverified\";\n    } else if (message?.role === \"user\" && message?.harness === \"skill-note\") {\n      sourceType = \"skill_note\";\n      scope = \"profile\";\n      trust = \"persisted_unverified\";\n    } else if (message?.role === \"user\") {\n      sourceType = \"operator_message\";\n      trust = \"operator_input_untrusted\";\n    } else if (message?.role === \"system\" && content.startsWith(\"[Structured Context Memory - durable task state]\")) {\n      sourceType = \"compaction_summary\";\n      trust = \"persisted_unverified\";\n    } else {\n      sourceType = \"system_context\";\n      trust = \"persisted_unverified\";\n    }\n    const location = `${sourcePrefix}:message:${index}:${String(message?.role ?? \"unknown\")}`;\n    if (workspacePath && (!selectedWorkspace || !selectedWorkspace.matches(workspacePath.value))) {\n      throw new Error(\"Session workspace identity is not selected by the application\");\n    }\n    if (selectedWorkspace) this.stateManager.setWorkspacePaths([selectedWorkspace]);\n    const taskId = session.taskId || session.id;\n    const sessionId = session.sessionId || session.id;\n    const workspace = session.workspace || session.workspacePath || process.cwd();\n\n    const fullState: SessionData = {\n      schemaVersion: session.schemaVersion || CURRENT_STATE_SCHEMA_VERSION,\n      taskId,\n      sessionId,\n      id: sessionId,\n      title: session.title || \"Active Session\",\n      workspacePath: workspace,\n      workspace,\n      model: session.model || \"default\",\n      ...(session.endpoint ? { endpoint: persistableEndpoint(session.endpoint) } : {}),\n      createdAt: session.createdAt || new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n      status: session.status || \"in_progress\",\n      activePlan: session.activePlan || [],\n      milestones: session.milestones || [],\n      worktreeBinding: session.worktreeBinding || null,\n      candidateId: session.candidateId || null,\n      candidateIdentity: session.candidateIdentity || null,\n      validationReceipts: session.validationReceipts || [],\n      currentOperation: session.currentOperation || null,\n      // Present-or-absent, not defaulted: an explicit null is a recorded \"none\", and absence must not invent a value.\n      ...(session.providerRecovery !== undefined ? { providerRecovery: session.providerRecovery } : {}),\n      ...(session.operation !== undefined ? { operation: session.operation } : {}),\n      ...(session.changeBaseline !== undefined ? { changeBaseline: session.changeBaseline } : {}),\n      messages: session.messages || [],\n      contextInventory: isContextInventorySnapshot(session.contextInventory) &&\n          (!session.contextInventory.sessionId || session.contextInventory.sessionId === sessionId) &&\n          (!session.contextInventory.workspace || path.resolve(session.contextInventory.workspace) === path.resolve(workspace))\n        ? session.contextInventory\n        : buildSessionContextInventory({ ...session, id: sessionId, taskId, sessionId, workspace, messages: session.messages || [] }),\n      ...(session.pinned !== undefined ? { pinned: session.pinned } : {}),\n      ...(session.unverifiedChangesPending !== undefined ? { unverifiedChangesPending: session.unverifiedChangesPending } : {}),\n      durableNotes: session.durableNotes,\n      compactionProvenance: session.compactionProvenance,\n      cognitiveRouting: session.cognitiveRouting,\n      tokenStats: session.tokenStats,\n      ...(session.lastTurn !== undefined ? { lastTurn: session.lastTurn } : {}),\n      ...(session.objective !== undefined ? { objective: session.objective } : {}),\n      ...(session.findings !== undefined ? { findings: session.findings } : {}),\n      ...(session.verificationConfigAttempts !== undefined ? { verificationConfigAttempts: session.verificationConfigAttempts } : {}),\n      ...(session.commandRuleDecisions !== undefined ? { commandRuleDecisions: session.commandRuleDecisions } : {}),\n      ...(session.history !== undefined ? { history: session.history } : {}),\n      ...(session.forkedFrom !== undefined ? { forkedFrom: session.forkedFrom } : {}),\n    };\n\n    this.stateManager.saveTaskState(fullState, selectedWorkspace ? [selectedWorkspace] : []);\n    const committed = this.stateManager.loadTaskState(taskId, undefined, selectedWorkspace ? [selectedWorkspace] : []);\n    this.updateIndexEntry({\n      id: sessionId,\n      cleanId: taskId.replace(/\\.json$/, \"\"),\n      title: committed.title || \"Active Session\",\n      updatedAt: committed.updatedAt || new Date().toISOString(),\n      workspace,\n      messageCount: committed.messages.length,\n      mtime: Date.now(),\n      pinned: Boolean(committed.pinned),\n    });\n  }\n  model?: string;\n  /** The inference endpoint the model was chosen on (a resume without --model adopts the model only on the same one). */\n  endpoint?: string;\n  createdAt: string;\n  updatedAt: string;\n  status: TaskLifecycleStatus;\n\n  // Retention: pinned sessions are never pruned by GC (REQ-PER-102, DEC-11)\n  pinned?: boolean;\n\n  // Authoritative task milestones (PERS-001)\n  activePlan: DurablePlanPhase[];\n  milestones: DurableMilestoneRecord[];\n\n  // Worktree binding (PERS-004)\n  worktreeBinding?: DurableWorktreeBinding | null;\n\n  // Candidate & validation binding (WP-04, PERS-003, PERS-004)\n  candidateId?: string | null;\n  candidateIdentity?: CandidateIdentity | null;\n  validationReceipts: ValidationReceipt[];\n\n  // Authoritative result of the most recent turn (execution / outcome / acceptance dimensions)\n  lastTurn?: TurnResult | null;\n\n  // In-flight operation tracking for interrupted-state detection (PERS-002, F-07). Cleared once the operation's\n  // result is part of the durable conversation; a record still present at recovery means the result was not saved.\n  currentOperation?: InFlightOperationRecord | null;\n\n  // Workspace changes this task made that no verifier has established yet. Recorded when the change happens and\n  // restored on every resume, so a later attempt that changes nothing cannot finish as NOT_REQUIRED.\n  unverifiedChangesPending?: boolean;\n\n  // Inference step waiting out a temporary provider failure (no tool or history change happens while waiting)\n  providerRecovery?: ProviderRecoveryRecord | null;\n\n  // Convergence-scheduled operation: work units, resource conditions and the wake condition while waiting\n  operation?: DurableOperationState;\n\n  // Context & conversation memory\n  messages: ChatMessage[];\n  /** Content-free, optional context provenance snapshot. Missing legacy values reconstruct as partial/unknown. */\n  contextInventory?: ContextInventorySnapshot;\n  durableNotes?: string[];\n  compactionProvenance?: CompactionProvenanceRecord | null;\n\n  // Reconstructible cognitive routing stats\n  cognitiveRouting?: DurableCognitiveRouting;\n  tokenStats?: {\n    prompt: number;\n    completion: number;\n    total: number;\n    /** Inference requests counted, and how many totals came from provider usage reports rather than estimates. */\n    requests?: number;\n    reportedRequests?: number;\n    estimatedRequests?: number;\n  };\n\n  // The operator's objective, acceptance requirements, steering and verifier attempts (core/objective.ts)\n  objective?: ObjectiveLedger | null;\n\n  /** Bounded `/loop` controller state; child work remains in the existing operation records. */\n  loop?: DurableLoopState | null;\n\n  // Full text of the findings the model recorded from inspected output (core/findings.ts); the durable record in\n  // `messages` may show them only condensed or by id.\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { randomBytes } from \"node:crypto\";\nimport { ChatMessage } from \"./types.js\";\nimport {\n  DurableTaskState,\n  DurableStateManager,\n  TaskRecoveryOptions,\n  TaskRecoveryResult,\n  CURRENT_STATE_SCHEMA_VERSION,\n  WORKTREE_BINDING_VERSION,\n  CorruptStateError,\n  UnsupportedSchemaVersionError,\n} from \"./core/state.js\";\nimport { withStateStoreGuard } from \"./core/state_store_guard.js\";\nimport { WorkspacePath } from \"./core/workspace_path.js\";\nimport { isManagedWorktreePath, isNamedWorktreePath, protectArchivedMessages } from \"./core/persistence_protection.js\";\nimport { insertedBlockPresent, isCompactionRecord } from \"./core/compaction_record.js\";\nimport { appendLinesDurably, readArchiveLines, type ArchiveRead, ensurePrivateDir, writePrivateFile } from \"./core/durable_file.js\";\nimport { persistableEndpoint } from \"./core/endpoint_identity.js\";\nimport { WorktreeManager } from \"./worktree.js\";\nimport { buildSessionContextInventory, isContextInventorySnapshot, markPersistedContextFreshnessUnknown } from \"./core/context_inventory.js\";\n\n// Re-export core state primitives\nexport * from \"./core/state.js\";\n\nexport class AmbiguousSessionResumeError extends Error {\n  public readonly prefix: string;\n  public readonly candidates: string[];\n  constructor(prefix: string, candidates: string[]) {\n    super(`Ambiguous session ID prefix '${prefix}'. Matches: ${candidates.join(\", \")}`);\n    this.name = \"AmbiguousSessionResumeError\";\n    this.prefix = prefix;\n    this.candidates = candidates;\n  }\n}\n\n/**\n * Upgraded SessionData envelope conforming to DurableTaskState (PERS-001..PERS-004).\n */\nexport interface SessionData extends DurableTaskState {\n  id: string;\n  workspace: string;\n  model: string;\n}\n\nexport interface SessionIndexEntry {\n  id: string;\n  cleanId: string;\n  title: string;\n  updatedAt: string;\n  workspace: string;\n  messageCount: number;\n  mtime: number;\n  pinned?: boolean;\n}\n\nexport interface SessionIndexData {\n  version: 1;\n  updatedAt: string;\n  sessions: Record<string, SessionIndexEntry>;\n}\n\n/** Where interactive sessions are saved unless a directory is given. */\nexport function defaultSessionsDir(): string {  if (process.env.NEXUS_STATE_DIR) {\n    return path.join(process.env.NEXUS_STATE_DIR, \"sessions\");\n  }\n  return path.join(os.homedir(), \".nexus\", \"sessions\");\n}\n\n/** Cryptographically unpredictable base36 suffix; the length stays inside the\n *  egress classifier's session-id whitelist (session_\\d{8}_\\d{6}_[a-z0-9]{1,8}). */\nfunction randomBase36Suffix(length: number): string {\n  const alphabet = \"REDACTED\";\n  let suffix = \"\";\n  while (suffix.length < length) {\n    for (const byte of randomBytes(length)) {\n      // Rejection sampling keeps the base-36 mapping unbiased (36 * 7 = 252).\n      if (byte >= 252) continue;\n      if (suffix.length < length) suffix += alphabet[byte % 36];\n    }\n  }\n  return suffix;\n}\n\n/** The longest prefix of `messages` no longer than `n` that does not end inside a tool exchange (a call without all its results). */\nfunction completeExchangePrefix(messages: ChatMessage[], n: number): number {\n  let end = n;\n  while (end > 1) {\n    let owner = end - 1;\n    while (owner > 0 && messages[owner].role === \"tool\") owner--;\n    const head = messages[owner];\n    const calls = head.role === \"assistant\" ? head.tool_calls ?? [] : [];\n    if (!calls.length) return end;\n    const answered = new Set(messages.slice(owner + 1, end).filter((x) => x.role === \"tool\").map((x) => x.tool_call_id));\n    if (calls.every((c) => answered.has(c.id))) return end;\n    end = owner;\n  }\n  return end;\n}\n\nexport class SessionManager {\n  private sessionsDir: string;\n  private stateManager: DurableStateManager;\n  private readonly selectedWorkspace: (() => WorkspacePath) | undefined;\n\n  constructor(customDir?: string, selectedWorkspace?: () => WorkspacePath) {\n    this.sessionsDir = customDir || defaultSessionsDir();\n    this.selectedWorkspace = selectedWorkspace;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20602-56e4-7401-a61d-85bcc9f8019b","create_time":1795397911.7519326}},"metadata":{"history_sequence":31030,"sampled_through_sequence":31027,"client_authored":false,"fallback_token_limit_override":12000}}
