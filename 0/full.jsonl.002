dDirectories(roots, excludedDirectories) {\n  const canonicalExclusions = [];\n  for (const excluded of excludedDirectories) {\n    try { canonicalExclusions.push(fs.realpathSync(excluded)); }\n    catch (error) {\n      if (error?.code !== \"ENOENT\") throw error;\n    }\n  }\n  const expanded = [];\n  const expand = (root) => {\ncli/test/eval_integrity.test.ts:481:  const { candidateToolchainRootProblem, candidateToolchainRootSources, candidateToolchainVersionProblem, selectCandidateToolchainSource, compilerExposureMaskArgs, maskedSystemDirectoryPaths, scanOracleCompilerExposure, oracleToolchainPathProblem, oracleToolchainVersionProblem, oracleToolchainsProblem, isolatedProcessArgv, sandboxAvailable } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\ncli/test/eval_integrity.test.ts:608:  assert.ok(changedScan.paths.includes(introducedCompiler), \"compiler exposure is rescanned after filesystem changes\");\ncli/test/eval_integrity.test.ts:609:  assert.deepEqual(compilerExposureMaskArgs(changedScan), [\"--ro-bind\", \"/dev/null\", introducedCompiler], \"the discovered compiler is converted to an actual sandbox mask\");\ncli/test/eval_integrity.test.ts:627:  assert.equal(disappearedDuringInspection, true, \"the fixture removes a compiler after inventory enumeration\");\ncli/test/eval_integrity.test.ts:628:  assert.deepEqual(disappearanceExposure, { paths: [], problem: null }, \"a disappeared inventory path is ignored while other inspection failures remain fail-closed\");\ncli/test/eval_integrity.test.ts:654:  assert.deepEqual(approvedToolchainScan, { paths: [], problem: null }, \"an independently validated approved toolchain is excluded from the unapproved compiler inventory\");\ncli/test/eval_integrity.test.ts:668:  assert.ok(fakeHostOnlySdkScan.paths.includes(fakeGoTarget), \"unmasked compiler paths remain in the inventory\");\ncli/test/eval_integrity.test.ts:676:  assert.match(invalidUtf8Exposure.problem ?? \"\", /compiler exposure could not be checked/, \"n