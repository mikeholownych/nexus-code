undary } from \\\"./core/egress.js\\\";\\n import pc from \\\"picocolors\\\";\\n@@ -1148,7 +1149,10 @@ export class LocalLlmClient {\\n       const entry = Array.isArray(data?.data) ? data.data.find((e) => e?.id === this.model) : undefined;\\n       if (!entry) return { state: \\\"unsupported\\\", detail: `model ${this.model} not listed` };\\n       const advertised = parseAdvertisement(entry);\\n-      const entryKind = advertised?.serverKind ?? serverKindOf(entry);\\n+      let entryKind = advertised?.serverKind ?? serverKindOf(entry);\\n+      if (entryKind === \\\"unknown\\\" && !this.conn.providerId && await this.discoverVllmVersion(signal)) {\\n+        entryKind = \\\"vllm\\\";\\n+      }\\n       LocalLlmClient.serverKindCache.set(ep, entryKind);\\n       if (!advertised || (advertised.contextLength === undefined && advertised.maxCompletionTokens === undefined)) {\\n         // An OpenAI-style catalog without limits (llama.cpp, LM Studio, Ollama): ask the server itself what it loaded.\\n@@ -1170,6 +1174,24 @@ export class LocalLlmClient {\\n   private static serverContextCache = new Map<string, Advertisement>();\\n   private static serverKindCache = new Map<string, ServerKind>();\\n \\n+  private async discoverVllmVersion(signal?: AbortSignal): Promise<string | undefined> {\\n+    const root = this.endpoint.replace(/\\\\/v1\\\\/?$/, \\\"\\\");\\n+    const url = `${root}/version`;\\n+    try {\\n+      await this.prepareCredential(this.endpoint);\\n+      const res = await fetch(url, {\\n+        headers: { ...this.authorization(url), \\\"X-Nexus-Purpose\\\": \\\"capabilities\\\" },\\n+        signal: signal ? AbortSignal.any([signal, AbortSignal.timeout(2_000)]) : AbortSignal.timeout(2_000),\\n+        ...this.fetchPolicy(),\\n+      });\\n+      if (!res.ok) return undefined;\\n+      return parseVllmVersion(await res.json());\\n+    } catch (err: any) {\\n+      if (signal?.aborted) throw abortedError(randomUUID());\\n+      return undefined;\\n+    }\\n+  }\\n+\\n   /**\\n    * The loaded context of a local server that lists no limits in its catalog, from that server's own endpoint (llama.cpp\\n    * `/props`, LM Studio `/api/v0/models`, Ollama `/api/show`) on the endpoint's origin with the same credential and a 2 s\\ndiff --git a/cli/src/core/provider_capabilities.ts b/cli/src/core/provider_capabilities.ts\\nindex 381c3628..77b77a37 100644\\n--- a/cli/src/core/provider_capabilities.ts\\n+++ b/cli/src/core/provider_capabilities.ts\\n@@ -69,8 +69,9 @@ export interface ProviderCapabilities {\\n const positiveInt = (v: unknown): number | undefined => (typeof v === \\\"number\\\" && Number.isFinite(v) && v > 0 ? Math.floor(v) : undefined);\\n \\n /**\\n- * Which server kind an entry represents: gateway (limits_version), vLLM (context_length/max_model_len),\\n- * llama.cpp (owned_by llamacpp or n_ctx_train meta), LM Studio (organization_owner), Ollama (library or ollama), or unknown.\\n+ * Which server kind an entry positively identifies: gateway (limits_version), llama.cpp (owned_by llamacpp or\\n+ * n_ctx_train meta), LM Studio (organization_owner), Ollama (library or ollama), or unknown. Generic context fields\\n+ * describe capacity, not the server implementation; vLLM is identified separately with its /version response.\\n  */\\n export function serverKindOf(entry: Record<string, any> | undefined): ServerKind {\\n   if (!entry || typeof entry !== \\\"object\\\") return \\\"unknown\\\";\\n@@ -79,11 +80,16 @@ export function serverKindOf(entry: Record<string, any> | undefined): ServerKind\\n   if (owner === \\\"llamacpp\\\" || (entry.meta && typeof entry.meta === \\\"object\\\" && \\\"n_ctx_train\\\" in entry.meta)) return \\\"llamacpp\\\";\\n   if (owner === \\\"organization_owner\\\") return \\\"lmstudio\\\";\\n   if (owner === \\\"library\\\" || owner === \\\"ollama\\\") return \\\"ollama\\\";\\n-  const contextLength = entry.context_length === null ? null : (positiveInt(entry.context_length) ?? positiveInt(entry.max_model_len));\\n-  if (contextLength !== undefined) return \\\"vllm\\\";\\n   return \\\"unknown\\\";\\n }\\n \\n+/** The vLLM GET /version contract; capacity fields in a generic model catalog are not identity evidence. */\\n+export function parseVllmVersion(body: unknown): string | undefined {\\n+  if (!body || typeof body !== \\\"object\\\" || Array.isArray(body)) return undefined;\\n+  const version = (body as Record<string, unknown>).version;\\n+  return typeof version === \\\"string\\\" && version.trim().length > 0 ? version.trim() : undefined;\\n+}\\n+\\n export function serverKindOfAdvertisement(ad: Advertisement | undefined): ServerKind {\\n   if (!ad) return \\\"unknown\\\";\\n   if (ad.via === \\\"aihost_gateway\\\") return \\\"gateway\\\";\\ndiff --git a/cli/test/provider_capabilities.test.ts b/cli/test/provider_capabilities.test.ts\\nindex f9f50554..0ac1dca8 100644\\n--- a/cli/test/provider_capabilities.test.ts\\n+++ b/cli/test/provider_capabilities.test.ts\\n@@ -11,6 +11,7 @@ import {\\n   parseAdvertisement,\\n   parseTokenizeResponse,\\n   resolveLimits,\\n+  serverKindOf,\\n   toolHeadroomPolicy,\\n } from \\\"../src/core/provider_capabilities.js\\\";\\n \\n@@ -28,6 +29,11 @@ const gatewayEntry = {\\n };\\n \\n describe(\\\"advertisements\\\", () => {\\n+  test(\\\"generic context catalogs remain unknown until a vLLM version handshake succeeds\\\", () => {\\n+    assert.equal(serverKindOf({ id: \\\"m\\\", context_length: 32768 }), \\\"unknown\\\");\\n+    assert.equal(serverKindOf({ id: \\\"m\\\", max_model_len: 32768 }), \\\"unknown\\\");\\n+  });\\n+\\n   test(\\\"the gateway entry is read as a gateway advertisement with request counting\\\", () => {\\n     const ad = parseAdvertisement(gatewayEntry)!;\\n     assert.equal(ad.via, \\\"aihost_gateway\\\");\\n\"}\n{\"chunk_id\":\"3ae124\",\"wall_time_seconds\":0.708020389,\"exit_code\":0,\"original_token_count\":705,\"output\":\"import type { ServerKind } from \\\"./provider_capabilities.js\\\";\\nimport { GBNF_TOOL_ALLOWLIST } from \\\"./tool_grammar.js\\\";\\nimport type { ToolDefinition } from \\\"../types.js\\\";\\n\\nconst constrainedToolNames: ReadonlySet<string> = new Set(GBNF_TOOL_ALLOWLIST);\\n\\n/** Enable only vLLM's documented strict function-schema path for the bounded tool grammar pilot. */\\nexport function adaptToolDefinitionsForServer(serverKind: ServerKind, tools: ToolDefinition[]): ToolDefinition[] {\\n  if (serverKind !== \\\"vllm\\\" || tools.length === 0) return tools;\\n\\n  let changed = false;\\n  const adapted = tools.map((tool) => {\\n    if (tool.type !== \\\"function\\\" || !constrainedToolNames.has(tool.function.name)) return tool;\\n    changed = true;\\n    return { ...tool, function: { ...tool.function, strict: true } };\\n  });\\n  return changed ? adapted : tools;\\n}\\n6:import { parseAdmissionHeaders, parseAdvertisement, parseServerContext, parseTokenizeResponse, parseVllmVersion, serverKindOf, type AdmissionReport, type Advertisement, type RequestCount, type ServerKind } from \\\"./core/provider_capabilities.js\\\";\\n811:    const kind = LocalLlmClient.serverKindCache.get(this.endpoint);\\n1134:  async discoverAdvertisement(signal?: AbortSignal): Promise<{ state: \\\"supported\\\" | \\\"unsupported\\\" | \\\"unavailable\\\"; advertised?: Advertisement; detail?: string }> {\\n1151:      const advertised = parseAdvertisement(entry);\\n1156:      LocalLlmClient.serverKindCache.set(ep, entryKind);\\n1162:          if (local.serverKind) LocalLlmClient.serverKindCache.set(ep, local.serverKind);\\n1175:  private static serverKindCache = new Map<string, ServerKind>();\\n1236:   * (advertised by the homelab-ai gateway contract). The body is `outboundChatBody` — the actual outbound messages,\\n1249:    const kind = LocalLlmClient.serverKindCache.get(ep);\\n1256:      body = this.outboundChatBody(ep, messages, tools);\\n1348:      this.withOAuthRetry(this.endpoint, requestId, () => this.withParameterRetry(() => this.chatCompletionOnce(messages, tools, requestId, signal))),\\n1352:  private async chatCompletionOnce(messages: ChatMessage[], tools: ToolDefinition[], requestId: string, signal?: AbortSignal): Promise<ChatMessage> {\\n1380:      let outboundTools = tools;\\n1396:        outboundTools = toolsEgress.sanitizedPayload || tools;\\n1413:      if (outboundTools.length > 0) {\\n1414:        payload.tools = outboundTools;\\n1514:  private outboundChatBody(currentEp: string, messages: ChatMessage[], tools: ToolDefinition[]): any {\\n1534:    let outboundTools = tools;\\n1550:      outboundTools = toolsEgress.sanitizedPayload || tools;\\n1566:    if (outboundTools.length > 0) {\\n1567:      payload.tools = outboundTools;\\n1593:      const payload = this.outboundChatBody(currentEp, messages, tools);\\n1812:        const res = await this.chatCompletionOnce(messages, tools, randomUUID(), signal);\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","create_time":1793737771.4040606}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
