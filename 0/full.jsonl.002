quest(this.client, () => this.client.chatCompletion(prompt, [], requestId, probeSignal, \"compaction\"));\n3781:          this.admitContext(0, requestId);\n3787:        const res = await this.submitGenAiRequest(this.client, () => this.client.chatCompletion(admittedPrompt, [], requestId, signal, \"compaction\"));\n3809:    const beforeTokens = calculateContextBudget(this.requestMessages(original), this.getEffectiveTools(), limit).totalActiveTokens;\n3810:    const afterTokens = calculateContextBudget(this.requestMessages(compacted), this.getEffectiveTools(), limit).totalActiveTokens;\n4735:              activeClient.chatCompletion(request, this.getEffectiveTools(), s.requestId, signal))),\n4759:        this.requestMessages(this.messages),\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20602-56e4-7401-a61d-85bcc9f8019b","create_time":1795397417.2637494}},"metadata":{"history_sequence":30880,"sampled_through_sequence":30877,"client_authored":false,"fallback_token_limit_override":12000}}
