mated companion pets that appear inside ChatGPT Work mode.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\",\"plugin_name\":\"work-pets\",\"plugin_release_id\":\"pluginrel_6a605738d6308191b431b6477919eafb\",\"plugin_release_version\":\"0.1.6\",\"apps\":[\"app://connector_openai_chatgpt_pets\"],\"skills\":[\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/create-pet\",\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/pets\",\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/update-pet\"],\"requires_executor\":true,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"plugin://plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"name\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"title\":\"Plugin Management\",\"description\":\"Discover relevant plugins and manage app connections, permissions, and dependencies.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"plugin_name\":\"plugin-management\",\"plugin_release_id\":\"pluginrel_6a7e9f7d0ef08191b97b213bb9e118ef\",\"plugin_release_version\":\"0.1.0\",\"apps\":[\"app://connector_openai_plugin_management\"],\"skills\":[\"skill://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\"],\"requires_executor\":false,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"plugin://plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"name\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"title\":\"Sites\",\"description\":\"Build and deploy websites with Sites. Use of Sites is subject to the ChatGPT Sites Terms (https://openai.com/policies/chatgpt-sites-terms/), and you are responsible for your website content.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"plugin_name\":\"sites\",\"plugin_release_id\":\"pluginrel_6b3c885c57c48191a71cbb5196efd47e\",\"plugin_release_version\":\"1.1.7\",\"apps\":[\"app://connector_20205bf7d4e99a89d7154bb849718324\"],\"skills\":[\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites\",\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-remix\"],\"requires_executor\":true,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_689987207de08191979cf68eca2941c6/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"plugin://plugin_connector_1p_e27075fa9af48191968b90b68ab08ba3\",\"name\":\"plugin_connector_1p_e27075fa9af48191968b90b68ab08ba3\",\"title\":\"Visualize\",\"description\":\"Create interactive charts, maps, diagrams, simulations, 3D models, data explorers, and UI previews directly in Codex.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_e27075fa9af48191968b90b68ab08ba3\",\"plugin_name\":\"visualize\",\"plugin_release_id\":\"pluginrel_6aed1cac71e48191bd46a385da2158a0\",\"plugin_release_version\":\"1.0.89\",\"apps\":[\"app://connector_openai_visualize\"],\"skills\":[\"skill://plugin_connector_1p_e27075fa9af48191968b90b68ab08ba3/visualize\"],\"requires_executor\":true,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_e27075fa9af48191968b90b68ab08ba3/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-analytics-dashboard\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-analytics-dashboard\",\"title\":\"Analytics Dashboard\",\"description\":\"Create a spreadsheet using the Analytics Dashboard template and its retained reference file. Use when the user selects or names Analytics Dashboard. Monitor acquisition, engagement, retention, revenue, and conversion funnel KPIs with charts.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdbd081918551b9ff949b0dcd\",\"skill_name\":\"artifact-template-analytics-dashboard\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-business-review\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-business-review\",\"title\":\"Business Review\",\"description\":\"Create a presentation using the Business Review template and its retained reference file. Use when the user selects or names Business Review. Review business performance, KPIs, segment results, strategic priorities, decisions, and outlook.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"REDACTED\",\"skill_name\":\"artifact-template-business-review\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-design-report\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-design-report\",\"title\":\"Design Report\",\"description\":\"Create a document using the Design Report template and its retained reference file. Use when the user selects or names Design Report. Produce design reports with an executive summary, key findings, implications, recommendations, and appendix.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdbe08191918c70c8437a0f90\",\"skill_name\":\"artifact-template-design-report\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-experiment-analysis\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-experiment-analysis\",\"title\":\"Experiment Analysis\",\"description\":\"Create a document using the Experiment Analysis template and its retained reference file. Use when the user selects or names Experiment Analysis. Analyze experiments with hypotheses, methodology, results, interpretation, limitations, and next steps.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdbe88191a5da52bf989269b8\",\"skill_name\":\"artifact-template-experiment-analysis\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-financial-budget\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-financial-budget\",\"title\":\"Financial Budget\",\"description\":\"Create a spreadsheet using the Financial Budget template and its retained reference file. Use when the user selects or names Financial Budget. Model actuals, budget and scenario forecasts, variances, cash runway, and departmental plans.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdbec8191ab9fb1dfa916b101\",\"skill_name\":\"artifact-template-financial-budget\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-investment-committee-memo\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-investment-committee-memo\",\"title\":\"Investment Committee Memo\",\"description\":\"Create a document using the Investment Committee Memo template and its retained reference file. Use when the user selects or names Investment Committee Memo. Prepare investment committee memos with the thesis, transaction details, financial analysis, risks, and recommendation.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdbf08191b1e46e0069bf9d39\",\"skill_name\":\"artifact-template-investment-committee-memo\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-legal-memorandum\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-legal-memorandum\",\"title\":\"Legal Memorandum\",\"description\":\"Create a document using the Legal Memorandum template and its retained reference file. Use when the user selects or names Legal Memorandum. Draft legal memoranda with the issue, brief answer, relevant facts, analysis, and conclusion.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"REDACTED\",\"skill_name\":\"artifact-template-legal-memorandum\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-market-trends-report\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-market-trends-report\",\"title\":\"Market Trends Report\",\"description\":\"Create a presentation using the Market Trends Report template and its retained reference file. Use when the user selects or names Market Trends Report. Communicate market or industry trends, supporting evidence, implications, and recommended responses.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdbf88191b625517e4a40d184\",\"skill_name\":\"artifact-template-market-trends-report\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-minimal-letterhead\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-minimal-letterhead\",\"title\":\"Minimal Letterhead\",\"description\":\"Create a document using the Minimal Letterhead template and its retained reference file. Use when the user selects or names Minimal Letterhead. Write professional business letters with sender, recipient, message, and signature fields in a minimal letterhead layout.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"REDACTED\",\"skill_name\":\"artifact-template-minimal-letterhead\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-operating-calendar\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-operating-calendar\",\"title\":\"Operating Calendar\",\"description\":\"Create a spreadsheet using the Operating Calendar template and its retained reference file. Use when the user selects or names Operating Calendar. Plan annual and monthly operating milestones, campaigns, launches, deadlines, and recurring events.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc0081919445bd6adfeee9ba\",\"skill_name\":\"artifact-template-operating-calendar\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-operating-review\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-operating-review\",\"title\":\"Operating Review\",\"description\":\"Create a presentation using the Operating Review template and its retained reference file. Use when the user selects or names Operating Review. Run weekly operating reviews with scorecards, functional updates, risks, decisions, and action items.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc048191b1dd87c6d0bb3190\",\"skill_name\":\"artifact-template-operating-review\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-project-kickoff\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-project-kickoff\",\"title\":\"Project Kickoff\",\"description\":\"Create a presentation using the Project Kickoff template and its retained reference file. Use when the user selects or names Project Kickoff. Align teams on project goals, scope, roles, milestones, risks, and the working model.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc0c819183f2aba3389112f3\",\"skill_name\":\"artifact-template-project-kickoff\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-project-tracker\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-project-tracker\",\"title\":\"Project Tracker\",\"description\":\"Create a spreadsheet using the Project Tracker template and its retained reference file. Use when the user selects or names Project Tracker. Manage workstreams, tasks, owners, status, priority, dates, launch pulse, and a Gantt schedule.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"REDACTED\",\"skill_name\":\"artifact-template-project-tracker\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-sales-pipeline\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-sales-pipeline\",\"title\":\"Sales Pipeline\",\"description\":\"Create a spreadsheet using the Sales Pipeline template and its retained reference file. Use when the user selects or names Sales Pipeline. Track opportunities, stages, owners, deal sizes, probabilities, forecasts, next steps, and risks.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc148191b504023513d219ca\",\"skill_name\":\"artifact-template-sales-pipeline\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-simple-dark-mode\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-simple-dark-mode\",\"title\":\"Simple Dark Mode\",\"description\":\"Create a presentation using the Simple Dark Mode template and its retained reference file. Use when the user selects or names Simple Dark Mode. Create clean dark-mode presentations with bold typography, simple sections, charts, and imagery.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc188191ac80335d6d2609f2\",\"skill_name\":\"artifact-template-simple-dark-mode\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-simple-light-mode\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-simple-light-mode\",\"title\":\"Simple Light Mode\",\"description\":\"Create a presentation using the Simple Light Mode template and its retained reference file. Use when the user selects or names Simple Light Mode. Create clean light-mode presentations with spacious typography, simple sections, charts, and imagery.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc1c81918b1d571866753f69\",\"skill_name\":\"artifact-template-simple-light-mode\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-strategy-memorandum\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-strategy-memorandum\",\"title\":\"Strategy Memorandum\",\"description\":\"Create a document using the Strategy Memorandum template and its retained reference file. Use when the user selects or names Strategy Memorandum. Present strategic context, choices, rationale, risks, milestones, and a clear recommendation.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc208191b851e518f7d802bb\",\"skill_name\":\"artifact-template-strategy-memorandum\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-system-design\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-system-design\",\"title\":\"System Design\",\"description\":\"Create a document using the System Design template and its retained reference file. Use when the user selects or names System Design. Document system architecture, requirements, components, data flows, APIs, tradeoffs, and operational considerations.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc2481918c654b7fa5b8a772\",\"skill_name\":\"artifact-template-system-design\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-team-alignment\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-team-alignment\",\"title\":\"Team Alignment\",\"description\":\"Create a presentation using the Team Alignment template and its retained reference file. Use when the user selects or names Team Alignment. Facilitate team offsites and planning with context, goals, priorities, decisions, and action items.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc288191a9c1edc952010f81\",\"skill_name\":\"artifact-template-team-alignment\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-three-statement-forecast\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-three-statement-forecast\",\"title\":\"Three-Statement Forecast\",\"description\":\"Create a spreadsheet using the Three-Statement Forecast template and its retained reference file. Use when the user selects or names Three-Statement Forecast. Build an integrated income statement, balance sheet, and cash flow forecast with assumptions, checks, and an executive summary.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc2c8191ab4516ba7697f480\",\"skill_name\":\"artifact-template-three-statement-forecast\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/maintain-space\",\"name\":\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/maintain-space\",\"title\":\"Maintain page content\",\"description\":\"Reconcile new evidence into existing ChatGPT Pages or a Space when the user requests upkeep. For a direct text correction, use write-page. Do not use for ordinary chat drafts, writing, or advice, or treat a selected Page as a request to save. Schedule future upkeep only when requested.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c\",\"plugin_name\":\"pages\",\"plugin_release_id\":\"pluginrel_6ab68a367fcc8191ad5a130fa1d93a6c\",\"plugin_release_skill_id\":\"pluginrsk_104170f7511c8191b7df56f8802ea4d5\",\"skill_name\":\"maintain-space\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/manage-schedules\",\"name\":\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/manage-schedules\",\"title\":\"Manage schedules for this page\",\"description\":\"Review a ChatGPT Space page and its schedules, recommend useful recurring work, and create, update, or remove scheduled automations.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c\",\"plugin_name\":\"pages\",\"plugin_release_id\":\"pluginrel_6ab68a367fcc8191ad5a130fa1d93a6c\",\"plugin_release_skill_id\":\"pluginrsk_4dba0cd90350819192783a844d8c1a87\",\"skill_name\":\"manage-schedules\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/organize-space\",\"name\":\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/organize-space\",\"title\":\"Organize pages\",\"description\":\"Organize existing ChatGPT Pages and Space structure when the user requests changes to that structure. Do not use for ordinary chat drafts or advice; a selected Page alone does not authorize reorganization. A narrow text edit does not need this workflow.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c\",\"plugin_name\":\"pages\",\"plugin_release_id\":\"pluginrel_6ab68a367fcc8191ad5a130fa1d93a6c\",\"plugin_release_skill_id\":\"pluginrsk_a360f8e994508191b71da65db46f23ad\",\"skill_name\":\"organize-space\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/write-page\",\"name\":\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c/write-page\",\"title\":\"Write and edit a page\",\"description\":\"Create or edit requested Page/Space content, or use for prose you have already decided to save as a standalone Markdown file, only if the user did not explicitly request a Markdown file. Honor established formats, destinations, and repository documentation. A selected Page alone does not authorize a write.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_4a72ddeef4c481918f92d8e8df18fb2c\",\"plugin_name\":\"pages\",\"plugin_release_id\":\"pluginrel_6ab68a367fcc8191ad5a130fa1d93a6c\",\"plugin_release_skill_id\":\"pluginrsk_2247832b32088191a6f73b5984466667\",\"skill_name\":\"write-page\",\"contents\":[\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/create-pet\",\"name\":\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/create-pet\",\"title\":\"Create pet\",\"description\":\"Create, repair, validate, preview, upload, or activate an animated v2 pet in ChatGPT Work mode from a character idea, brand cue, or reference image. Use for new ChatGPT Pets, custom mascots, non-pixel styles, and unattached sprite sheets requiring nine animation states plus sixteen look directions. Preserve Library artifacts and Pets MCP lifecycle behavior. Exclude real pets, standalone images, and other-app pets; clarify before invoking.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\",\"plugin_name\":\"work-pets\",\"plugin_release_id\":\"pluginrel_6a605738d6308191b431b6477919eafb\",\"plugin_release_skill_id\":\"pluginrsk_6a60573a53888191b6f2c38c1a8ad4ca\",\"skill_name\":\"create-pet\",\"contents\":[\"references\",\"scripts\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/pets\",\"name\":\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/pets\",\"title\":\"Pets\",\"description\":\"List, inspect, select, download, or delete animated pets in ChatGPT Work mode. Use for an explicit pet in ChatGPT or established ChatGPT Pets context. Exclude real-world and other-app pets; clarify before invoking.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\",\"plugin_name\":\"work-pets\",\"plugin_release_id\":\"pluginrel_6a605738d6308191b431b6477919eafb\",\"plugin_release_skill_id\":\"pluginrsk_6a60573ba8bc819186e79bd4858c707b\",\"skill_name\":\"pets\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/update-pet\",\"name\":\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/update-pet\",\"title\":\"Update pet\",\"description\":\"Inspect, validate, preview, repair, or update a custom pet in ChatGPT Work mode, including its name, description, or sprite sheet. Use for a pet in ChatGPT or established ChatGPT Pets context. Exclude real-world and other-app pets; clarify before invoking.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\",\"plugin_name\":\"work-pets\",\"plugin_release_id\":\"pluginrel_6a605738d6308191b431b6477919eafb\",\"plugin_release_skill_id\":\"pluginrsk_6a60573d52608191b967e6759086094c\",\"skill_name\":\"update-pet\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\",\"name\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\",\"title\":\"plugin-management\",\"description\":\"Discover and suggest relevant plugins, inspect app permissions and dependencies, and manage plugin connections or removal. Use when the user asks about plugins or when a task would materially benefit from an external app, account, service, or data source that available tools cannot access.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"plugin_name\":\"plugin-management\",\"plugin_release_id\":\"pluginrel_6a7e9f7d0ef08191b97b213bb9e118ef\",\"plugin_release_skill_id\":\"pluginrsk_6a7e9f7d68608191bca9945146cbe6f1\",\"skill_name\":\"plugin-management\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites\",\"name\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6/sites\",\"title\":\"sites\",\"description\":\"Use Sites when the user wants a website built for them (including a landing page, portfolio, dashboard, portal, tracker, hub, game, event registration, or tool), requests changes to a website already built with Sites, wants to publish a website with Sites, or wants to manage Sites hosting.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"plugin_name\":\"sites\",\"plugin_release_id\":\"pluginrel_6b3c885c57c48191a71cbb5196efd47e\",\"plugin_release_skill_id\":\"pluginrsk_6afdf4bca63c8191b0f1e2c4deee0eaa\",\"skill_name\":\"sites\",\"contents\":[\"references\",\"scripts\",\"templates\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-remix\",\"name\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-remix\",\"title\":\"sites-remix\",\"description\":\"Remix a Site built with the Sites plugin into a new Site. Use when the user has identified the source Site and asks to remix it.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"plugin_name\":\"sites\",\"plugin_release_id\":\"pluginrel_6b3c885c57c48191a71cbb5196efd47e\",\"plugin_release_skill_id\":\"pluginrsk_6afdf4bc884c8191af8db3afe0d84116\",\"skill_name\":\"sites-remix\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_e27075fa9af48191968b90b68ab08ba3/visualize\",\"name\":\"plugin_connector_1p_e27075fa9af48191968b90b68ab08ba3/visualize\",\"title\":\"Visualize\",\"description\":\"Create visualizations and interactive tools directly in conversation. Proactively use to show how something works; explore 'what happens when', 'what changes', or 'help me understand'; compare or inspect; create simulations, maps, charts, graphs, and mockups. Use standard tools for static scientific figures.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_e27075fa9af48191968b90b68ab08ba3\",\"plugin_name\":\"visualize\",\"plugin_release_id\":\"pluginrel_6aed1cac71e48191bd46a385da2158a0\",\"plugin_release_skill_id\":\"pluginrsk_6aed1cacc2e081918bd2cd29af0e110b\",\"skill_name\":\"visualize\",\"contents\":[\"assets\",\"charts\",\"scripts\",\"widgets\"],\"allow_implicit_invocation\":true}},{\