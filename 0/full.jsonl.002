.\n      const findStat = fs.lstatSync(FIND);\n      if (!findStat.isFile() || findStat.uid !== 0 || (findStat.mode & 0o022) !== 0\n        || (findStat.mode & 0o111) === 0 || fs.realpathSync(FIND) !== FIND) {\n        throw new Error(\"trusted compiler inventory tool is unavailable\");\n      }\n      // Broad system roots can contain millions of entries. Traverse independent,\n      // canonical roots concurrently, while keeping one fail-closed deadline and\n      // retaining per-process output buffers so NUL-delimited paths cannot interleave.\n      const inventory = path.join(path.dirname(fileURLToPath(import.meta.url)), \"scan-compiler-exposure.mjs\");\n      const inventoryStat = fs.lstatSync(inventory);\n      if (!inventoryStat.isFile() || inventoryStat.isSymbolicLink() || (inventoryStat.mode & 0o022) !== 0\n        || fs.realpathSync(inventory) !== inventory) {\n        throw new Error(\"trusted compiler inventory helper is unavailable\");\n      }\n      const result = spawnSync(process.execPath, [inventory, ...[...directoryRoots].sort()], {\n        encoding: null,\n        // Keep the parent deadline outside the helper's own bounded scan deadline so\n        // it can terminate and reap its find children before spawnSync is interrupted.\n        timeout: 70_000,\n        maxBuffer: 64 * 1024 * 1024,\n        env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n      });\n      if (result.error || result.status !== 0 || result.stderr?.length) {\n        const helperFailure = /^trusted compiler inventory could not complete: ([a-z_0-9]+)\\n$/.exec(result.stderr?.toString(\"utf8\") ?? \"\");\n        const spawnErrorCode = result.error?.code;\n        inventoryFailureReason = helperFailure?.[1]\n          ?? (spawnErrorCode === \"ETIMEDOUT\" ? \"parent_timeout\"\n            : spawnErrorCode ? \"spawn_error\"\n              : result.signal === \"SIGKILL\" ? \"helper_sigkill\"\n                : result.signal === \"SIGTERM\" ? \"helper_sigterm\"\n                  : result.status !== 0 ? \"helper_nonzero_exit\"\n                    : result.stderr?.length ? \"unexpected_stderr\" : \"helper_exit\");\n        throw new Error(\"trusted compiler inventory could not complete\");\n      }\n      for (const item of (result.stdout ?? Buffer.alloc(0)).toString(\"utf8\").split(\"\\0\")) {\n        if (item) inspectInventoryPath(item);\n      }\n    }\n  } catch {\n    const reason = inventoryFailureReason ? ` (inventory ${inventoryFailureReason})` : \"\";\n    return { paths: [], problem: `compiler exposure could not be checked; refusing qualification${reason}` };\n  }\n\n  return { paths: [...exposed].sort(), problem: null };\n}\n\nexport function compilerExposureMaskArgs(scan) {\n  if (scan.problem) throw new Error(scan.problem);\n  const targets = [...new Set(scan.paths)];\n  for (const target of targets) {\n    let stat;\n    try { stat = fs.lstatSync(target); }\n    catch { throw new Error(\"compiler exposure target is unavailable; refusing qualification\"); }\n    if (!stat.isFile()) throw new Error(\"compiler exposure target is not a regular file; refusing qualification\");\n  }\n  return targets.flatMap((target) => [\"--ro-bind\", \"/dev/null\", target]);\n}\n\nfunction executableVersion(command, argv) {\n  const result = spawnSync(command, argv, {\n    encoding: \"utf8\",\n}, TIMEOUT_MS);\n\nfunction scanRoots(roots) {\n  return new Promise((resolve) => {\n    const child = spawn(FIND, findArgs(roots), {\n      env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    children.add(child);\n    const stdout = [];\n    let stderrBytes = 0;\n    child.stdout.on(\"data\", (chunk) => {\n      outputBytes += chunk.length;\n      if (outputBytes > MAX_OUTPUT) {\n        failed = true;\n        stopAll(\"output_limit\");\n        return;\n      }\n      stdout.push(chunk);\n    });\n    child.stderr.on(\"data\", (chunk) => {\n      stderrBytes += chunk.length;\n      failed = true;\n      stopAll(\"find_stderr\");\n    });\n    child.on(\"error\", () => {\n      failed = true;\n      stopAll(\"spawn_error\");\n    });\n    child.on(\"close\", (code) => {\n      children.delete(child);\n      if (code !== 0 || stderrBytes !== 0) {\n        failed = true;\n        stopAll(stderrBytes ? \"find_stderr\" : \"find_exit\");\n      }\n      outputs.push(stdout);\n      resolve();\n    });\n  });\n}\n\nasync function worker() {\n  while (!failed) {\n    try {\n      const next = await jobs.next();\n      if (failed || next.done) return;\n      await scanRoots(next.value);\n    } catch {\n      failed = true;\n      stopAll();\n      return;\n    }\n  }\n}\n\nawait Promise.all(Array.from({ length: SCAN_WORKERS }, () => worker()));\nclearTimeout(deadline);\nclearTimeout(killTimer);\nif (failed) {\n  process.stderr.write(`trusted compiler inventory could not complete: ${failureReason ?? \"unknown\"}\\n`);\n  process.exitCode = 1;\n} else {\n  const output = Buffer.concat(outputs.flat(), outputBytes);\n  if (!isUtf8(output)) {\n    process.stderr.write(\"trusted compiler inventory paths are not valid UTF-8\\n\");\n    process.exitCode = 1;\n  } else {\n    process.stdout.write(output);\n  }\n}\n    pass: true,\n    cases: 1,\n    failedCases: [],\n    timeoutCases: [],\n    outputLimitCases: [],\n    executionFailureCases: [],\n    invalidOutputCases: [],\n    mismatchCases: [],\n    timedOut: false,\n    overflow: false,\n    outcome: \"matched\",\n    resources: null,\n  });\n  assert.deepEqual(fs.readFileSync(candidate), candidateBefore, \"candidate workspace is read-only during oracle execution\");\n  assert.equal(JSON.stringify(result).includes(canary), false, \"oracle evidence never serializes hidden expectations or candidate output\");\n  assert.equal(JSON.stringify(result).includes(diagnosticCanary), false, \"candidate diagnostics are not persisted in oracle evidence\");\n  assert.equal(fs.readFileSync(privateFile, \"utf8\").includes(canary), false);\n\n  fs.writeFileSync(privateFile, JSON.stringify([{ input: { value: \"public-input\" }, expected: { value: \"different\", oracle: canary } }]));\n  const failed = await runBlackBoxOracle({ dir: taskDir }, workspace, check);\n  assert.equal(failed.pass, false);\n  assert.deepEqual(failed.failedCases, [0]);\n  assert.deepEqual(failed.mismatchCases, [0]);\n  assert.equal(JSON.stringify(failed).includes(canary), false, \"failure summaries do not leak hidden values\");\n\n  fs.writeFileSync(candidate, \"console.log('x'.repeat(10000));\\n\");\n  const overflow = await runBlackBoxOracle({ dir: taskDir }, workspace, { ...check, maxOutputBytes: 64 });\n  assert.equal(overflow.pass, false);\n  assert.deepEqual(overflow.outputLimitCases, [0]);\n  assert.equal(overflow.overflow, true);\n  assert.equal(JSON.stringify(overflow).includes(\"xxxx\"), false, \"output-overflow evidence discards candidate output\");\n\n  fs.writeFileSync(candidate, \"while (true) {}\\n\");\n  const timed = await runBlackBoxOracle({ dir: taskDir }, workspace, { ...check, timeoutMs: 100, totalTimeoutMs: 500 });\n  assert.equal(timed.pass, false);\n  assert.deepEqual(timed.timeoutCases, [0]);\n  assert.equal(timed.timedOut, true);\n  assert.equal(JSON.stringify(timed).includes(canary), false);\n\n  const fixtureTask = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-fixture-task-\"));\n  const fixtureWorkspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-fixture-ws-\"));\n  fs.mkdirSync(path.join(fixtureTask, \"fixture\"));\n  fs.writeFileSync(path.join(fixtureTask, \"fixture\", \"private.json\"), JSON.stringify([{ input: {}, expected: canary }]));\n  await assert.rejects(\n    runBlackBoxOracle({ dir: fixtureTask, fixture: \"fixture\" }, fixtureWorkspace, { ...check, casesFile: \"fixture/private.json\" }),\n    /outside the candidate fixture/,\n  );\n});\n\ntest(\"Python black-box oracle uses only pinned offline Go and Rust toolchains, or fails preflight\", { timeout: 60_000 }, async (t) => {\n  const { blackBoxOracleProblem, runBlackBoxOracle } = await import(path.join(ROOT, \"eval/oracle.mjs\"));\n  const { candidateToolchainRootProblem, candidateToolchainRootSources, candidateToolchainVersionProblem, selectCandidateToolchainSource, compilerExposureMaskArgs, maskedSystemDirectoryPaths, scanOracleCompilerExposure, oracleToolchainPathProblem, oracleToolchainVersionProblem, oracleToolchainsProblem, isolatedProcessArgv, sandboxAvailable } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const toolchainPolicy = JSON.parse(fs.readFileSync(path.join(ROOT, \"eval/toolchain-versions.json\"), \"utf8\"));\n  const rustToolchain = fs.readFileSync(path.join(ROOT, \"rust-toolchain.toml\"), \"utf8\");\n  const workflow = fs.readFileSync(path.join(ROOT, \".github/workflows/ci.yml\"), \"utf8\");\n  assert.equal(toolchainPolicy.go, \"1.22.12\");\n  assert.equal(toolchainPolicy.rust, /^channel = \"([^\"]+)\"$/m.exec(rustToolchain)?.[1]);\n  assert.equal((workflow.match(/go-version: '([^']+)'/g) ?? []).length, 2);\n  assert.equal((workflow.match(/go-version: '1\\.22\\.12'/g) ?? []).length, 2, \"both CI jobs install the exact approved Go version\");\n  assert.equal((workflow.match(/run: bash scripts\\/install-evaluator-toolchains\\.sh/g) ?? []).length, 2, \"both CI jobs use the same exact-version installer\");\n  assert.equal(oracleToolchainVersionProblem({\n    goVersion: \"go version go1.22.12 linux/amd64\",\n    rustcVersion: \"rustc 1.95.0 (fixture)\",\n    cargoVersion: \"cargo 1.95.0 (fixture)\",\n  }), null);\n  assert.match(oracleToolchainVersionProblem({\n    goVersion: \"go version go1.22.11 linux/amd64\",\n    rustcVersion: \"rustc 1.95.0 (fixture)\",\n    cargoVersion: \"cargo 1.95.0 (fixture)\",\n  }), /do not match policy/);\n  assert.equal(candidateToolchainVersionProblem(\"/usr/local/go\", { goVersion: \"go version go1.22.12 linux/amd64\" }), null);\n  assert.match(candidateToolchainVersionProblem(\"/usr/local/go\", { goVersion: \"go version go1.22.11 linux/amd64\" }), /expected 1\\.22\\.12/);\n  assert.equal(candidateToolchainVersionProblem(\"/usr/local/nexus-qual/rust\", {\n    rustcVersion: \"rustc 1.95.0 (fixture)\", cargoVersion: \"cargo 1.95.0 (fixture)\",\n  }), null);\n  assert.match(candidateToolchainVersionProblem(\"/usr/local/nexus-qual/rust\", {\n    rustcVersion: \"rustc 1.94.0 (fixture)\", cargoVersion: \"cargo 1.95.0 (fixture)\",\n  }), /expected 1\\.95\\.0/);\n  const staleGoFallback = \"/opt/nexus-qual/go\";\n  const pinnedGoFallback = \"/usr/local/go\";\n  assert.equal(selectCandidateToolchainSource([staleGoFallback, pinnedGoFallback], (sourceRoot) => candidateToolchainVersionProblem(\"/usr/local/go\", {\ndocs/releases/v1.0.0-rc.12.md:20:- The evaluator binds the pinned Go and Rust toolchains read-only and masks unpinned compilers that are visible to candidates. CI removes the hosted runner's preinstalled SDK trees before evaluator tests, so the fail-closed compiler inventory stays inside its fixed 25 s deadline.\ndocs/releases/v1.0.0-rc.13.md:13:- The release job now prepares the same evaluator environment as CI before it runs the test suite: the pinned Go toolchain, the pinned evaluator toolchains, and removal of the hosted runner's preinstalled SDK trees. RC12's release run failed without them (`go: command not found`, and `compiler exposure could not be checked; refusing qualification`). A test now fails if the release and CI workflows disagree on this setup.\n","exit_code":0,"duration":{"secs":0,"nanos":737727740}},"started_at_ms":1793733796136,"completed_at_ms":1793733796874}}
