{"timestamp":"2026-11-03T20:17:27.732Z","ordinal":81027,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"CommandExecution","id":"exec-dafffb76-4200-4d4c-a5f1-5089bb16c9c9","process_id":"63393","command":["/usr/bin/zsh","-lc","sed -n '1125,1265p' cli/src/client.ts; sed -n '1,160p' cli/src/core/tool_grammar_provider.ts 2>/dev/null || true; sed -n '1,160p' cli/test/provider_capabilities.test.ts"],"cwd":"file:///home/mike/nexus-wt/v112-wp1101-integration","parsed_cmd":[{"type":"unknown","cmd":"sed -n '1125,1265p' cli/src/client.ts; sed -n '1,160p' cli/src/core/tool_grammar_provider.ts 2>/dev/null || true; sed -n '1,160p' cli/test/provider_capabilities.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    return this.lastAdmission;\n  }\n\n  /**\n   * This connection's `/models` entry for the selected model, read from the active endpoint only (never a fallback or\n   * another provider: capability discovery is scoped to the connection in use). Not content-bearing.\n   * `unsupported`: the provider has no catalog or does not list the model; `unavailable`: it could not be read now.\n   */\n  async discoverAdvertisement(signal?: AbortSignal): Promise<{ state: \"supported\" | \"unsupported\" | \"unavailable\"; advertised?: Advertisement; detail?: string }> {\n    const ep = this.endpoint;\n    if (this.conn.protocol !== \"openai-chat\") return { state: \"unsupported\", detail: `${this.conn.protocol} connection` };\n    const url = `${ep}/models`;\n    try {\n      await this.prepareCredential(ep);\n      const res = await fetch(url, {\n        // Marked so providers (and their logs) can tell a capability read from an availability probe.\n        headers: { ...this.authorization(url), \"X-Nexus-Purpose\": \"capabilities\" },\n        signal: signal ? AbortSignal.any([signal, AbortSignal.timeout(10_000)]) : AbortSignal.timeout(10_000),\n        ...this.fetchPolicy(),\n      });\n      if (res.status === 404) return { state: \"unsupported\", detail: \"no /models catalog\" };\n      if (!res.ok) return { state: \"unavailable\", detail: `HTTP ${res.status}` };\n      const data = (await res.json()) as { data?: Array<Record<string, any>> };\n      const entry = Array.isArray(data?.data) ? data.data.find((e) => e?.id === this.model) : undefined;\n      if (!entry) return { state: \"unsupported\", detail: `model ${this.model} not listed` };\n      const advertised = parseAdvertisement(entry);\n      const entryKind = advertised?.serverKind ?? serverKindOf(entry);\n      LocalLlmClient.serverKindCache.set(ep, entryKind);\n      if (!advertised || (advertised.contextLength === undefined && advertised.maxCompletionTokens === undefined)) {\n        // An OpenAI-style catalog without limits (llama.cpp, LM Studio, Ollama): ask the server itself what it loaded.\n        // Only for a plain endpoint: cloud provider connections have no such endpoints.\n        const local = this.conn.providerId ? undefined : await this.discoverServerContext(entry, signal);\n        if (local) {\n          if (local.serverKind) LocalLlmClient.serverKindCache.set(ep, local.serverKind);\n          return { state: \"supported\", advertised: local };\n        }\n        return { state: \"unsupported\", advertised, detail: \"catalog lists no limits\" };\n      }\n      return { state: \"supported\", advertised };\n    } catch (err: any) {\n      if (signal?.aborted) throw abortedError(randomUUID());\n      return { state: \"unavailable\", detail: redactSecrets(String(err?.message ?? err)).slice(0, 160) };\n    }\n  }\n\n  private static serverContextCache = new Map<string, Advertisement>();\n  private static serverKindCache = new Map<string, ServerKind>();\n\n  /**\n   * The loaded context of a local server that lists no limits in its catalog, from that server's own endpoint (llama.cpp\n   * `/props`, LM Studio `/api/v0/models`, Ollama `/api/show`) on the endpoint's origin with the same credential and a 2 s\n   * limit. The server is recognised from its catalog entry first, so an unrecognised server is never probed. Not\n   * content-bearing. Undefined when the server is not recognised or does not answer with a context size.\n   */\n  private async discoverServerContext(entry: Record<string, any>, signal?: AbortSignal): Promise<Advertisement | undefined> {\n    const kind = serverKindOf(entry);\n    if (kind !== \"llamacpp\" && kind !== \"lmstudio\" && kind !== \"ollama\") return undefined;\n    const cacheKey = `${this.endpoint}::${this.model}`;\n    const cached = LocalLlmClient.serverContextCache.get(cacheKey);\n    if (cached) return cached;\n    const root = this.endpoint.replace(/\\/v1\\/?$/, \"\");\n    const probes: Array<{ kind: \"llamacpp\" | \"lmstudio\" | \"ollama\"; url: string; init?: RequestInit }> = [\n      { kind: \"llamacpp\" as const, url: `${root}/props` },\n      { kind: \"lmstudio\" as const, url: `${root}/api/v0/models` },\n      { kind: \"ollama\" as const, url: `${root}/api/show`, init: { method: \"POST\", body: JSON.stringify({ model: this.model }), headers: { \"content-type\": \"application/json\" } } },\n    ].filter((p) => p.kind === kind);\n    for (const probe of probes) {\n      try {\n        const res = await fetch(probe.url, {\n          ...probe.init,\n          headers: { ...(probe.init?.headers as Record<string, string> | undefined), ...this.authorization(probe.url), \"X-Nexus-Purpose\": \"capabilities\" },\n          signal: signal ? AbortSignal.any([signal, AbortSignal.timeout(2_000)]) : AbortSignal.timeout(2_000),\n          ...this.fetchPolicy(),\n        });\n        if (!res.ok) continue;\n        const found = parseServerContext(probe.kind, await res.json(), this.model);\n        if (found) {\n          LocalLlmClient.serverContextCache.set(cacheKey, found);\n          return found;\n        }\n      } catch {\n        if (signal?.aborted) throw abortedError(randomUUID());\n      }\n    }\n    return undefined;\n  }\n\n  /**\n   * Counts the prompt tokens of the request inference would send now, through the connection's `/v1/tokenize`\n   * (advertised by the homelab-ai gateway contract). The body is `outboundChatBody` — the actual outbound messages,\n   * tools, tool_choice and settings, after the same egress quarantine and sanitization — sent to the active endpoint\n   * only, with the same credential scoping, disclosure checks and cancellation as inference. No failover: a counting\n   * failure belongs to this connection and capability, and never moves task content elsewhere.\n   * Throws TokenCountError: `unsupported` (no such endpoint or model), `unavailable` (temporary), `malformed`,\n   * `denied` (credential or disclosure), `aborted`.\n   */\n  async countRequestTokens(messages: ChatMessage[], tools: ToolDefinition[], requestId: string, signal?: AbortSignal): Promise<RequestCount> {\n    if (this.conn.providerId || this.conn.protocol !== \"openai-chat\") throw new TokenCountError(\"unsupported\", \"provider connections have no request-counting endpoint\");\n    const ep = this.endpoint;\n    const denial = this.disclosureDenial(ep, requestId);\n    if (denial) throw new TokenCountError(\"denied\", denial.message);\n    if (signal?.aborted) throw new TokenCountError(\"aborted\", \"cancelled\");\n    const kind = LocalLlmClient.serverKindCache.get(ep);\n    const root = ep.replace(/\\/v1\\/?$/, \"\");\n    const urls = (kind === \"llamacpp\" || kind === \"vllm\") && root !== ep ? [`${ep}/tokenize`, `${root}/tokenize`] : [`${ep}/tokenize`];\n    let body: any;\n    try {\n      await this.prepareCredential(ep, requestId);\n      this.preflight(ep, requestId, JSON.stringify(messages).length + JSON.stringify(tools).length);\n      body = this.outboundChatBody(ep, messages, tools);\n    } catch (err: any) {\n      throw new TokenCountError(\"denied\", boundedProviderText(String(err?.message ?? err)).slice(0, 200));\n    }\n    let res: Response | undefined;\n    let text = \"\";\n    for (let i = 0; i < urls.length; i++) {\n      const url = urls[i];\n      const reqBody = kind === \"llamacpp\" && url === `${root}/tokenize`\n        ? { content: JSON.stringify({ messages: body.messages, ...(body.tools ? { tools: body.tools } : {}) }), ...body }\n        : body;\n      try {\n        res = await fetch(url, {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\", ...this.authorization(url), \"X-Request-ID\": requestId, ...this.routingHeaders() },\n          body: JSON.stringify(reqBody),\n          signal: metadataSignal(signal),\n          ...this.fetchPolicy(),\n        });\n      } catch (err: any) {\n        if (signal?.aborted) throw new TokenCountError(\"aborted\", \"cancelled\");\n        throw new TokenCountError(\"unavailable\", boundedProviderText(String(err?.message ?? err)).slice(0, 160));\n      }\n      text = await res.text().catch(() => \"\");\n      if ((res.status === 404 || res.status === 405) && i + 1 < urls.length && !/blocked|capacity/i.test(text)) {\n        continue;\n      }\n      break;\n    }\n    if (!res) throw new TokenCountError(\"unsupported\", \"no tokenize endpoint\");\n    if (res.status === 401 || res.status === 403) throw new TokenCountError(\"denied\", `HTTP ${res.status}`);\n    // The gateway answers 404 both for an unknown model and when every worker of the alias is blocked.\n/**\n * Provider capability parsing and limit resolution (core/provider_capabilities.ts), against the homelab-ai gateway's\n * `/v1/models`, `/v1/tokenize` and admission-header shapes and against providers that advertise nothing.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport {\n  CLIENT_DEFAULT_CONTEXT,\n  advertisementChanged,\n  parseAdmissionHeaders,\n  parseAdvertisement,\n  parseTokenizeResponse,\n  resolveLimits,\n  toolHeadroomPolicy,\n} from \"../src/core/provider_capabilities.js\";\n\nconst gatewayEntry = {\n  id: \"engineering/lead\",\n  object: \"model\",\n  owned_by: \"aihost-orchestrator\",\n  context_length: 65536,\n  max_model_len: 65536,\n  max_completion_tokens: 8192,\n  limits_version: \"0123456789abcdef\",\n  reasoning: { budget: 8192, mode: \"off\" },\n  serving: [{ worker_id: \"b0-live-llama-worker1\", pool: \"lead\", role: \"production\", capacity_source: \"observed\" }],\n  capabilities: { tools: { available: false, provenance: \"unavailable\" } },\n};\n\ndescribe(\"advertisements\", () => {\n  test(\"the gateway entry is read as a gateway advertisement with request counting\", () => {\n    const ad = parseAdvertisement(gatewayEntry)!;\n    assert.equal(ad.via, \"aihost_gateway\");\n    assert.equal(ad.contextLength, 65536);\n    assert.equal(ad.maxCompletionTokens, 8192);\n    assert.equal(ad.limitsVersion, \"0123456789abcdef\");\n    assert.deepEqual(ad.workers, [\"b0-live-llama-worker1\"]);\n    assert.equal(ad.tokenize, true);\n  });\n\n  test(\"vLLM-style max_model_len is capacity without request counting; a bare catalog advertises nothing\", () => {\n    assert.deepEqual(parseAdvertisement({ id: \"m\", max_model_len: 32768 }), { via: \"vllm\", contextLength: 32768, tokenize: false });\n    assert.deepEqual(parseAdvertisement({ id: \"m\" }), { via: \"catalog\", tokenize: false });\n    assert.equal(parseAdvertisement(undefined), undefined);\n  });\n\n  test(\"a gateway reporting unknown capacity (null) is not a number\", () => {\n    const ad = parseAdvertisement({ ...gatewayEntry, context_length: null, max_model_len: null })!;\n    assert.equal(ad.contextLength, null);\n    const limits = resolveLimits(ad);\n    assert.equal(limits.contextSource, \"client_default\");\n  });\n\n  test(\"changes in limits version, capacity, output allowance or serving workers are detected\", () => {\n    const a = parseAdvertisement(gatewayEntry)!;\n    assert.equal(advertisementChanged(a, parseAdvertisement(gatewayEntry)), false);\n    assert.equal(advertisementChanged(a, parseAdvertisement({ ...gatewayEntry, limits_version: \"x\" })), true);\n    assert.equal(advertisementChanged(a, parseAdvertisement({ ...gatewayEntry, context_length: 32768 })), true);\n    assert.equal(advertisementChanged(a, parseAdvertisement({ ...gatewayEntry, serving: [{ worker_id: \"w2\" }] })), true);\n  });\n});\n\ndescribe(\"limits in effect\", () => {\n  test(\"advertised capacity wins over client defaults; an operator setting below it is kept, above it is capped\", () => {\n    const ad = parseAdvertisement({ ...gatewayEntry, context_length: 131072, max_completion_tokens: 16384 })!;\n    assert.deepEqual(resolveLimits(ad), { contextLimit: 131072, contextSource: \"advertised\", outputAllowance: 16384, outputSource: \"advertised\" });\n    assert.equal(resolveLimits(ad, 32768).contextLimit, 32768);\n    assert.equal(resolveLimits(ad, 32768).contextSource, \"operator\");\n    assert.equal(resolveLimits(ad, 500000).contextLimit, 131072);\n    assert.equal(resolveLimits(ad, 500000).contextSource, \"operator_capped_by_advertised\");\n    assert.equal(resolveLimits(ad, undefined, 4096).outputAllowance, 4096);\n  });\n\n  test(\"standalone: operator configuration, else labelled client defaults; never unlimited\", () => {\n    assert.deepEqual(resolveLimits(undefined), { contextLimit: CLIENT_DEFAULT_CONTEXT, contextSource: \"client_default\", outputAllowance: 8192, outputSource: \"client_default\" });\n    assert.deepEqual(resolveLimits(undefined, 16384), { contextLimit: 16384, contextSource: \"operator\", outputAllowance: 4096, outputSource: \"client_default\" });\n    assert.ok(resolveLimits(undefined, 4000, 100000).outputAllowance <= 2000, \"an output allowance never takes more than half the window\");\n  });\n\n  test(\"the tool-output headroom is a policy value, separate from capacity and allowance\", () => {\n    assert.equal(toolHeadroomPolicy(65536), 4096);\n    assert.equal(toolHeadroomPolicy(16000), 2000);\n    assert.equal(toolHeadroomPolicy(65536, 1000), 1000);\n  });\n});\n\ndescribe(\"counts\", () => {\n  test(\"gateway 'exact' is exact for the sampled worker; 'estimated_conservative' is the gateway's estimate\", () => {\n    assert.deepEqual(parseTokenizeResponse({ model: \"m\", prompt_tokens: 1234, source: \"exact\", context_length: 65536, limits_version: \"lv\", worker_id: \"w1\" }), {\n      promptTokens: 1234, source: \"exact_sampled_worker\", workerId: \"w1\", limitsVersion: \"lv\", contextLength: 65536,\n    });\n    assert.equal((parseTokenizeResponse({ prompt_tokens: 9, source: \"estimated_conservative\" }) as any).source, \"gateway_conservative\");\n  });\n\n  test(\"malformed answers are rejected, never guessed\", () => {\n    assert.ok(\"malformed\" in parseTokenizeResponse(null));\n    assert.ok(\"malformed\" in parseTokenizeResponse({ prompt_tokens: \"10\", source: \"exact\" }));\n    assert.ok(\"malformed\" in parseTokenizeResponse({ prompt_tokens: 10, source: \"estimate\" }));\n    assert.ok(\"malformed\" in parseTokenizeResponse({ prompt_tokens: -1, source: \"exact\" }));\n  });\n\n  test(\"admission headers: an exact count is the admitted request's; '~' or a non-exact source is conservative; absence is nothing\", () => {\n    const h = (o: Record<string, string>) => (name: string) => o[name.toLowerCase()] ?? null;\n    assert.deepEqual(parseAdmissionHeaders(h({ \"x-aihost-prompt-tokens\": \"4180\", \"x-aihost-prompt-tokens-source\": \"exact\", \"x-aihost-route\": \"rule=review;pool=deep;worker=w2;fallback=\", \"x-aihost-context-limit\": \"40000\", \"x-aihost-limits-version\": \"lv\", \"x-aihost-clamped\": \"true\" })), {\n      promptTokens: 4180, source: \"exact_admitted\", contextLimit: 40000, limitsVersion: \"lv\", workerId: \"w2\", pool: \"deep\", clamped: true,\n    });\n    assert.equal(parseAdmissionHeaders(h({ \"x-aihost-prompt-tokens\": \"~5000\", \"x-aihost-prompt-tokens-source\": \"estimated_conservative\" }))!.source, \"gateway_conservative\");\n    assert.equal(parseAdmissionHeaders(h({})), undefined);\n  });\n});\n","exit_code":0,"duration":{"secs":0,"nanos":707803866}},"started_at_ms":1793737047023,"completed_at_ms":1793737047731}}
