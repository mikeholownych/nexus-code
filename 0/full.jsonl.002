"tool_name":"xerj_field_report"},{"first_turn_id":"01a1fbee-7b1a-7413-b09f-0a39b35b3b03","server_name":"xerj","tool_name":"xerj_code_search"},{"first_turn_id":"01a1feda-0fbd-7040-8752-70765f3a9e98","server_name":"xerj","tool_name":"xerj_search"},{"connector_id":"connector_76869538009648d5b282a4bb21c3d157","first_turn_id":"01a1ffa0-c475-7561-be45-26e55293b3ca","server_name":"codex_apps","tool_name":"github.fetch_workflow_job_logs"},{"first_turn_id":"01a20014-b98e-7f50-9b44-1c38f2a1201a","server_name":"xerj","tool_name":"xerj_def"},{"first_turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","server_name":"xerj","tool_name":"xerj_corpus_feedback"}],"status":"complete"},"retained_source":{"complete":true,"id":{"message_id":"msg_01a20118-dfee-7ff1-9140-48acb9b7e46d","role":"user","turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819"},"revision":"retained_01a20118-dfee-7ff1-9140-48ce2670e4e7"},"sampled_through_sequence":18741,"user_input_order":1728},{"client_authored":false,"history_sequence":24284,"mcp_attribution":{"sources":[{"first_turn_id":"01a1f876-8040-7be1-b13f-9cdb453fceba","server_name":"xerj","tool_name":"xerj_field_report"},{"first_turn_id":"01a1fbee-7b1a-7413-b09f-0a39b35b3b03","server_name":"xerj","tool_name":"xerj_code_search"},{"first_turn_id":"01a1feda-0fbd-7040-8752-70765f3a9e98","server_name":"xerj","tool_name":"xerj_search"},{"connector_id":"connector_76869538009648d5b282a4bb21c3d157","first_turn_id":"01a1ffa0-c475-7561-be45-26e55293b3ca","server_name":"codex_apps","tool_name":"github.fetch_workflow_job_logs"},{"first_turn_id":"01a20014-b98e-7f50-9b44-1c38f2a1201a","server_name":"xerj","tool_name":"xerj_def"},{"first_turn_id":"01a2003f-4e12-7811-a5cb-72eb7d9f7819","server_name":"xerj","tool_name":"xerj_corpus_feedback"}],"status":"complete"},"retained_source":{"complete":true,"id":{"message_id":"msg_01a20301-6114-7543-98a9-8a5d90b213c5","role":"user","turn_id":"01a20267-417a-7580-ac0e-5275ab8a9467"},"revision":"retained_01a20301-6115-7542-8280-7eb8618a7f35"},"