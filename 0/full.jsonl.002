resAt?: string;\n}\n\nexport interface KnowledgeProvenance {\n  source: \"operator_entry\" | \"legacy_import\";\n  sourceRefs: string[];\n}\n\nexport interface KnowledgeEntry {\n  id: string;\n  category: KnowledgeCategory;\n  key: string;\n  value: string;\n  confidence: number;\n  createdAt: string;\n  updatedAt: string;\n  tags?: string[];\n  scope: \"repository\";\n  provenance: KnowledgeProvenance;\n  validationStatus: KnowledgeValidationStatus;\n  retention: KnowledgeRetention;\n}\n\nexport interface KnowledgeGraphData {\n  version: 1 | 2;\n  updatedAt: string;\n  entries: KnowledgeEntry[];\n}\n\nexport interface KnowledgeOptions {\n  readOnly?: boolean;\n  trusted?: boolean;\n}\n\n/**\n * Persistent Project Knowledge Graph\n * Retains project idioms, architectural decisions, and conventions across sessions.\n */\nexport class KnowledgeGraph {\n  private workspace: string;\n  private dbPath: string;\n  private readOnly: boolean;\n  private explicitTrusted?: boolean;\n  private entries: Map<string, KnowledgeEntry> = new Map();\n\n  constructor(workspace: string = process.cwd(), options: KnowledgeOptions = {}) {\n    this.workspace = path.resolve(workspace);\n    this.readOnly = Boolean(options.readOnly);\n    this.explicitTrusted = options.trusted;\n    this.dbPath = path.join(this.workspace, \".nexus\", \"knowledge.json\");\n    // LAZY: no mkdir in constructor (REQ-SEC-114)\n    this.load();\n  }\n\n  public setWorkspace(workspace: string, options: KnowledgeOptions = {}): void {\n    this.workspace = path.resolve(workspace);\n    if (options.readOnly !== undefined) this.readOnly = options.readOnly;\n    if (options.trusted !== undefined) this.explicitTrusted = options.trusted;\n    this.dbPath = path.join(this.workspace, \".nexus\", \"knowledge.json\");\n    this.load();\n  }\n\n  /**\n   * Loads knowledge entries from persistent storage. Legacy entries are\n   * explicitly labeled unverified and migrated additively on writable loads.\n   */\n  public load(): void {\n    this.entries.clear();\n    if (!fs.existsSync(this.dbPath)) return;\n\n    let raw: string;\n    let data: KnowledgeGraphData;\n    try {\n      raw = fs.readFileSync(this.dbPath, \"utf-8\");\n      data = JSON.parse(raw);\n    } catch {\n      // Ignore parse errors on corrupt file\n      return;\n    }\n\n    try {\n      const protectedData = redactForPersistence(data);\n      const storedVersion = (protectedData as any)?.version;\n      if (typeof storedVersion !== \"number\" || storedVersion < 1 || storedVersion > 2) {\n        throw new Error(\"Unsupported knowledge graph schema version\");\n      }\n      const safeSerialized = JSON.stringify(protectedData, null, 2);\n      if (safeSerialized !== JSON.stringify(data, null, 2)) {\n        writeProtectedTextFile(this.dbPath, safeSerialized);\n      }\n      let migrated = protectedData.version !== 2;\n      if (Array.isArray(protectedData.entries)) {\n        for (const entry of protectedData.entries) {\n          if (entry.key && entry.value) {\n            const rawRefs = entry.provenance?.sourceRefs;\n            const refsValid = Array.isArray(rawRefs) && rawRefs.length <= 100 && rawRefs.every((ref: unknown) => typeof ref === \"string\" && ref.length > 0 && ref.length <= 300 && !/[\\u0000-\\u001f\\u007f-\\u009f]/.test(ref));\n            const provenanceValid = [\"operator_entry\", \"legacy_import\"].includes(entry.provenance?.source) && refsValid;\n            const safeRefs = refsValid ? rawRefs.slice() : [];\n            const retention = entry.retention === undefined\n              ? { policy: \"until_deleted\" as const }\n              : validRetention(entry.retention)\n                ? entry.retention\n                : { policy: \"expires_at\" as const, expiresAt: \"1970-01-01T00:00:00.000Z\" };\n            if (!refsValid || !provenanceValid || (entry.validationStatus !== \"operator_reviewed_unverified\" && entry.validationStatus !== \"legacy_unverified\")) migrated = true;\n            const normalized: KnowledgeEntry = {\n              ...entry,\n              scope: \"repository\",\n              provenance: provenanceValid\n                ? { source: entry.provenance.source, sourceRefs: safeRefs }\n                : { source: \"legacy_import\", sourceRefs: [] },\n              validationStatus: entry.validationStatus === \"operator_reviewed_unverified\" ? \"operator_reviewed_unverified\" : \"legacy_unverified\",\n              retention,\n            };\n\n  private rankCache?: { skills: Skill[]; docs: Array<{ tf: Map<string, number>; len: number }>; df: Map<string, number>; avg: number; shortNames: Set<string> };\n  /** The term statistics of the trusted skills, built once per catalog (`refresh` drops it). */\n  private rankIndex() {\n    if (this.rankCache) return this.rankCache;\n    const skills = this.listSkills();\n    if (skills.length === 0) return undefined;\n    const df = new Map<string, number>();\n    // Two-character words that occur in some skill's name: the only short words worth scoring.\n    const shortNames = new Set(skills.flatMap((s) => tokenize(s.name, () => true).filter((t) => t.length === 2)));\n    const docs = skills.map((s) => {\n      const tf = new Map<string, number>();\n      for (const t of tokenize(s.name, () => true)) tf.set(t, (tf.get(t) ?? 0) + 2);\n      for (const t of tokenize(s.description, (w) => shortNames.has(w))) tf.set(t, (tf.get(t) ?? 0) + 1);\n      let len = 0;\n      for (const n of tf.values()) len += n;\n      for (const t of tf.keys()) df.set(t, (df.get(t) ?? 0) + 1);\n      return { tf, len };\n    });\n    const avg = docs.reduce((n, d) => n + d.len, 0) / docs.length || 1;\n    return (this.rankCache = { skills, docs, df, avg, shortNames });\n  }\n\n  public getUntrustedSkill(name: string): Skill | null {\n    return this.untrustedSkills.get(name) || null;\n  }\n\n  /**\n   * The skill catalog for the system prompt, at most `maxChars` long. Every discovered skill is advertised on every\n   * request, so a large install (hundreds of skills under ~/.agents and ~/.claude) must not crowd out the task: when\n   * the full listing does not fit, descriptions are shortened, then dropped, then names past the budget are counted.\n   * Source and trust stay on the `activate_skill` output either way. The result is never longer than `maxChars`.\n   */\n  public getPromptSection(maxChars: number = SKILL_CATALOG_MAX_CHARS): string {\n    // Workspace skills first: they are the most specific to the task and survive any cut.\n    // Descriptions and source paths as one safe line each (template tokens, control markers and secrets removed), as in\n    // the per-prompt note: they are untrusted text whether or not the skill is trusted. Names were sanitised at load.\n    const skills = this.listSkills()\n      .sort((a, b) => Number(Boolean(b.isWorkspaceSkill)) - Number(Boolean(a.isWorkspaceSkill)))\n      .map((s) => ({ ...s, description: oneLine(s.description), path: oneLine(s.path) }));\n    if (skills.length === 0) {\n      return \"\";\n    }\n\n    const head =\n      `${SKILL_CATALOG_HEADING}\\n${SKILL_CATALOG_INTRO}` +\n      \" If a user task matches a skill's description, call the `activate_skill` tool with the skill's name to load its specialized workflows and guidelines into context.\\n\";\n\n    const full = head + \"\\n\" + skills.map((s) => `- **${s.name}** [source: ${s.path}] [trust: ${s.trusted ? \"trusted\" : \"untrusted\"}]: ${s.description}\\n`).join(\"\");\n    if (full.length <= maxChars) return full;\n\n    const note = `The list below is abbreviated to fit the context window (${skills.length} skills); \\`activate_skill\\` shows each skill's source and full instructions.\\n\\n`;\n    const clip = (d: string, n: number) => (d.length <= n ? d : `${d.slice(0, Math.max(0, n - 1)).trimEnd()}…`);\n    const described = (n: number) => head + note + skills.map((s) => `- **${s.name}**: ${clip(s.description, n)}\\n`).join(\"\");\n\n    // Longest uniform description length that fits; below MIN_DESCRIPTION_CHARS a description no longer helps choose.\n    let lo = MIN_DESCRIPTION_CHARS;\n    let hi = Math.max(...skills.map((s) => s.description.length));\n    if (described(lo).length <= maxChars) {\n      while (lo < hi) {\n        const mid = Math.ceil((lo + hi) / 2);\n        if (described(mid).length <= maxChars) lo = mid;\n        else hi = mid - 1;\n      }\n      return described(lo);\n    }\n\n    // Names only, then as many names as fit with a count of the rest.\n    const names = skills.map((s) => s.name);\n    const listing = (shown: number) =>\n      head + note + [...names.slice(0, shown), ...(shown < names.length ? [`…and ${names.length - shown} more (pass words describing the task to \\`activate_skill\\` to search them)`] : [])].join(\", \") + \"\\n\";\n    let shown = names.length;\n    let result = listing(shown);\n    while (shown > 0 && result.length > maxChars) result = listing(--shown);\n    // A window too small for even the heading gets no catalog; `activate_skill` still works by name.\n    return result.length <= maxChars ? result : \"\";\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20602-56e4-7401-a61d-85bcc9f8019b","create_time":1795397273.677938}},"metadata":{"history_sequence":30850,"sampled_through_sequence":30846,"client_authored":false,"fallback_token_limit_override":12000}}
