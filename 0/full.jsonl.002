dential_boundary.test.ts:107:        const client = new LocalLlmClient(cfg(foreign.url, { apiKey: FOREIGN_KEY, fallbackEndpoints: [aihost.url] }));\ncli/test/parser_safety.test.ts:53:    const client = new LocalLlmClient({ model: \"m\", endpoint: `http://127.0.0.1:${port}/v1`, apiKey: \"k\" } as any);\ncli/test/server_context_discovery.test.ts:78:      const found = await new LocalLlmClient({ endpoint: srv.url, model: \"m\", workspace: \"/tmp\", maxSteps: 1 } as any).discoverAdvertisement();\ncli/test/server_context_discovery.test.ts:93:      const found = await new LocalLlmClient({ endpoint: srv.url, model: \"m\", workspace: \"/tmp\", maxSteps: 1 } as any).discoverAdvertisement();\ncli/test/server_context_discovery.test.ts:109:      const found = await new LocalLlmClient({ endpoint: srv.url, model: \"m\", workspace: \"/tmp\", maxSteps: 1 } as any).discoverAdvertisement();\ncli/test/server_context_discovery.test.ts:123:      const found = await new LocalLlmClient({ endpoint: srv.url, model: \"m\", workspace: \"/tmp\", maxSteps: 1 } as any).discoverAdvertisement();\ncli/test/server_context_discovery.test.ts:139:      const client = new LocalLlmClient({ endpoint: srv.url, model: \"m\", workspace: \"/tmp\", maxSteps: 1 } as any);\ncli/test/server_context_discovery.test.ts:155:      const found = await new LocalLlmClient({ endpoint: srv.url, model: \"m\", workspace: \"/tmp\", maxSteps: 1 } as any).discoverAdvertisement();\ncli/test/convergence_integration.test.ts:65:  id, provider: new URL(gw.url).origin, endpoint: gw.url, model: id, capabilities: [\"tools\"], rank: 0, ...o,\ncli/test/app.test.ts:90:    // Nothing listens on the test endpoint; fail the inference at once instead of waiting for the provider.\ncli/test/context_convergence.test.ts:344:        const resource: ResourceDescriptor = { id: \"primary\", provider: gw.origin, endpoint: gw.url, model: \"m\", capabilities: [\"tools\"], rank: 0 };\ncli/src/core/resources.ts:2: * Resource eligibility: which inference resources (provider × endpoint × model, optionally a serving pool) may be\ncli/src/core/resources.ts:6: * model ineligible; a refused connection makes the endpoint ineligible, not the provider; a quota or credential\ncli/src/core/resources.ts:26:export type ConditionScope = \"model\" | \"endpoint\" | \"provider\" | \"account\" | \"pool\";\ncli/src/core/resources.ts:42:  /** Cloud provider id (providers.ts); the endpoint is then that provider's base URL and its key its own. */\ncli/src/core/resources.ts:150:const SCOPES: ConditionScope[] = [\"model\", \"endpoint\", \"provider\", \"account\", \"pool\"];\ncli/src/core/resources.ts:305:    const endpointKeys = new Set([scopeKey(resource, \"endpoint\"), scopeKey(resource, \"provider\")]);\ncli/test/tokens.test.ts:183:      const llamaClient = new LocalLlmClient({ endpoint, model: \"m\", workspace: \"/tmp\", maxSteps: 1 } as any);\ncli/test/tokens.test.ts:191:      const vllmClient = new LocalLlmClient({ endpoint, model: \"m\", workspace: \"/tmp\", maxSteps: 1 } as any);\ncli/test/provider_connect.test.ts:111:      [\"null endpoint credential\", { version: 1, providers: { [id]: null } }],\ncli/test/provider_connect.test.ts:112:      [\"invalid endpoint credential\", { version: 1, providers: { [id]: { type: \"api\", key: 7, savedAt: \"fixed\" } } }],\ncli/test/provider_connect.test.ts:274:      const client = new LocalLlmClient(cfg({ provider: \"chatgpt\", endpoint: backend.url, model: \"gpt-5-codex\" }));\ncli/test/provider_connect.test.ts:297:      const err = await new LocalLlmClient(cfg({ provider: \"chatgpt\", endpoint: backend.url, model: \"gpt-5\" }))\ncli/test/provider_connect.test.ts:315:      const client = new LocalLlmClient(cfg({ provider: \"copilot\", endpoint: api.url, model: \"claude-sonnet-4\" }));\ncli/test/provider_connect.test.ts:351:      const out = await new LocalLlmClient(cfg({ provider: \"chatgpt\", endpoint: backend.url, model: \"gpt-5\" })).chatCompletionStream([{ role: \"user\", content: \"x\" }],