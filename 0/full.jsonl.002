{"timestamp":"2026-11-03T23:23:03.193Z","ordinal":86146,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","item":{"type":"CommandExecution","id":"exec-14beb671-821b-41af-910e-eac2f71d0f32","process_id":"86193","command":["/usr/bin/zsh","-lc","sed -n '565,610p' cli/test/eval_integrity.test.ts; rg -n 'scanOracleCompilerExposure\\(' eval/isolate.mjs"],"cwd":"file:///home/mike/nexus-wt/v112-wp1107-qualification","parsed_cmd":[{"type":"read","cmd":"sed -n '565,610p' cli/test/eval_integrity.test.ts","name":"eval_integrity.test.ts","path":"cli/test/eval_integrity.test.ts"},{"type":"search","cmd":"rg -n \"scanOracleCompilerExposure\\\\(\" eval/isolate.mjs","query":"scanOracleCompilerExposure\\(","path":"isolate.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    fs.rmSync(manyRootsSystem, { recursive: true, force: true });\n    fs.rmSync(changingSystem, { recursive: true, force: true });\n    fs.rmSync(disappearingSystem, { recursive: true, force: true });\n    fs.rmSync(fakeSystemAlias, { recursive: true, force: true });\n    fs.rmSync(fakeAlternatives, { recursive: true, force: true });\n    fs.rmSync(fakeSymlinkTarget, { recursive: true, force: true });\n    fs.rmSync(fakeMountedRuntime, { recursive: true, force: true });\n    fs.rmSync(fakeApprovedToolchain, { recursive: true, force: true });\n  });\n  // Keep the compiler under the 65th depth-3 subtree so this catches dropped later batches.\n  const batchedChildren = Array.from({ length: 65 }, (_, index) => {\n    const child = path.join(batchedSystem, `child-${String(index).padStart(2, \"0\")}`);\n    const scanDirectory = path.join(child, \"scan-subtree\", \"deep\");\n    fs.mkdirSync(scanDirectory, { recursive: true });\n    return scanDirectory;\n  });\n  const batchedRootEntries = spawnSync(\"/usr/bin/find\", [\"-P\", batchedSystem, \"-mindepth\", \"3\", \"-maxdepth\", \"3\", \"-type\", \"d\", \"-print0\"], { encoding: \"buffer\" });\n  assert.equal(batchedRootEntries.status, 0, \"the fixture can enumerate the bounded directory batches\");\n  const orderedBatchedChildren = batchedRootEntries.stdout.toString(\"utf8\").split(\"\\0\").filter(Boolean);\n  assert.equal(orderedBatchedChildren.length, batchedChildren.length);\n  const lateBatchedCompiler = path.join(orderedBatchedChildren.at(-1), \"rustc\");\n  fs.writeFileSync(lateBatchedCompiler, compilerCanary);\n  fs.chmodSync(lateBatchedCompiler, 0o755);\n  const batchedExposure = scanOracleCompilerExposure([batchedSystem], [], []);\n  assert.equal(batchedExposure.problem, null);\n  assert.ok(batchedExposure.paths.includes(lateBatchedCompiler), \"compiler binaries in later sibling batches remain discoverable and maskable\");\n  const manyRoots = Array.from({ length: 129 }, (_, index) => {\n    const root = path.join(manyRootsSystem, `root-${String(index).padStart(3, \"0\")}`);\n    fs.mkdirSync(root);\n    return root;\n  });\n  const lateRootCompiler = path.join(manyRoots.at(-1), \"rustc\");\n  fs.writeFileSync(lateRootCompiler, compilerCanary);\n  fs.chmodSync(lateRootCompiler, 0o755);\n  const manyRootsExposure = scanOracleCompilerExposure(manyRoots, [], []);\n  assert.equal(manyRootsExposure.problem, null, \"more than 128 disjoint system roots stay within the bounded scanner input contract\");\n  assert.ok(manyRootsExposure.paths.includes(lateRootCompiler), \"a compiler in the final root remains discoverable when the root list exceeds 128\");\n  assert.deepEqual(scanOracleCompilerExposure([changingSystem], [], []), { paths: [], problem: null }, \"an initially clean mounted system has no compiler masks\");\n  const introducedCompiler = path.join(changingSystem, \"go\");\n  fs.writeFileSync(introducedCompiler, compilerCanary);\n  fs.chmodSync(introducedCompiler, 0o755);\n  const changedScan = scanOracleCompilerExposure([changingSystem], [], []);\n  assert.equal(changedScan.problem, null);\n  assert.ok(changedScan.paths.includes(introducedCompiler), \"compiler exposure is rescanned after filesystem changes\");\n  assert.deepEqual(compilerExposureMaskArgs(changedScan), [\"--ro-bind\", \"/dev/null\", introducedCompiler], \"the discovered compiler is converted to an actual sandbox mask\");\n  const mutableFs = fs as unknown as { lstatSync: (...args: unknown[]) => unknown };\n241:export function scanOracleCompilerExposure(systemDirectories = SYSTEM_BINARIES, systemEtcDirectories = SYSTEM_ETC_DIRS, additionalMountedPaths = [], approvedToolchainRoots = [], excludedDirectories = []) {\n394:  const exposureScan = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths, [], maskedDirectories);\n581:  const compilerExposure = scanOracleCompilerExposure(mountSources.systemDirectories, mountSources.systemEtcDirectories, [], mountSources.toolchainDirectories, maskedDirectories);\n704:  const compilerExposure = scanOracleCompilerExposure(\n768:    compilerExposure = scanOracleCompilerExposure(systemDirectories, systemEtcDirectories, additionalMountedPaths, Object.values(oracleToolchainSources).filter(Boolean), maskedDirectories);\n","exit_code":0,"duration":{"secs":0,"nanos":748180518}},"started_at_ms":1793748182444,"completed_at_ms":1793748183193}}
