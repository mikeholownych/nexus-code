ievalMethod: \"compaction_record\", sourceRefs: [session.compactionProvenance.recordId, ...session.compactionProvenance.predecessorIds] });\ncli/src/core/context_inventory.ts:315:        : coverageGaps.length > 0 || items.some((item) => item.freshness === \"unknown\") || primary.metrics.omittedItems > 0 || supplemental.metrics.omittedItems > 0\ncli/src/core/context_inventory.ts:325:export function markPersistedContextFreshnessUnknown(snapshot: ContextInventorySnapshot): ContextInventorySnapshot {\ncli/src/core/context_inventory.ts:326:  const invalidated = snapshot.items.some((item) => item.freshness === \"current\");\ncli/src/core/context_inventory.ts:328:  const coverageGaps = [...new Set([...snapshot.coverageGaps, \"persisted context freshness was not revalidated against current session and workspace state\"])];\ncli/src/core/context_inventory.ts:333:    items: snapshot.items.map((item) => item.freshness === \"current\"\ncli/src/core/context_inventory.ts:334:      ? { ...item, freshness: \"unknown\", freshnessRule: \"persisted observation requires revalidation before it can be considered current\" }\ncli/src/core/context_inventory.ts:350:  const freshness = [\"current\", \"stale\", \"unknown\"];\ncli/src/core/context_inventory.ts:359:    Array.isArray(snapshot.items) && snapshot.items.length <= DEFAULT_MAX_ITEMS && snapshot.items.every((item) => item && safeText(item.id, 80) && safeText(item.sourceType, 80) && safeText(item.sourceLocation) && scopes.includes(item.scope) && safeText(item.observedAt, 80) && freshness.includes(item.freshness) && (item.freshnessRule === undefined || safeText(item.freshnessRule)) && (item.freshness === \"unknown\" || safeText(item.freshnessRule)) && trust.includes(item.trust) && safeText(item.retention) && safeText(item.inclusionReason) && safeText(item.retrievalMethod, 100) && Number.isFinite(item.estimatedTokens) && item.estimatedTokens >= 0 && (item.sourceRefs === undefined || (Array.isArray(item.sourceRefs) && item.sourceRefs.length <= 100 && item.sourceRefs.every((ref) => safeText(ref, 200))))) &&\ncli/src/core/context_inventory.ts:367:  dimension: \"navigability\" | \"retrieval_speed\" | \"freshness\" | \"compounding_value\";\ncli/src/core/context_inventory.ts:394:  const allFreshnessKnown = inventoryExists && snapshot.items.every((item) => item.freshness !== \"unknown\");\ncli/src/core/context_inventory.ts:406:          { reference: \"cli/src/core/context_inventory.ts:inventorySourcesFromMessages\", finding: `${snapshot.items.length} source-linked context item(s) are represented without storing their content.`, status: inventoryExists ? \"observed\" : \"unknown\" },\ncli/src/core/context_inventory.ts:410:        unmetCriteria: [\"Complete source-by-source provenance for all content included in each inference request.\", \"A unified retrieval graph connecting repository, task, session, profile, and memory items.\"],\ncli/src/core/context_inventory.ts:415:        dimension: \"retrieval_speed\", level: hasMeasuredSourceLatency ? 2 : null,\ncli/src/core/context_inventory.ts:417:          { reference: \"cli/src/core/context_inventory.ts:buildContextInventory\", finding: hasMeasuredSourceLatency ? \"Source and total inventory-assembly durations are recorded for this capture; they are not inference latency measurements.\" : \"No source retrieval duration was measured in this snapshot.\", status: hasMeasuredSourceLatency ? \"measured\" : \"unknown\" },\ncli/src/core/context_inventory.ts:418:          { reference: \"cli/src/agent.ts:admitContext\", finding: \"Context admission enforces token estimates and output/tool reserves; this is budget evidence, not a retrieval latency SLO.\", status: \"observed\" },\ncli/src/core/context_inventory.ts:420:        unmetCriteria: [\"Repeated per-inference source latency and timeout measurements.\", \"A defined retrieval latency budget/SLO and measured failure rate.\"],\ncli/src/core/context_inventory.ts:425:        dimension: \"freshness\", level: inventoryExists ? allFreshnessKnown ? 2 : 1 : null,\ncli/src/core/context_inventory.ts:427:          { reference: \"cli/src/core/context_inventory.ts:ContextFreshness\", finding: `${snapshot.items.filter((item) => item.freshness === \"unknown\").length} item(s) have unknown freshness; no current-state claim is inferred from persistence.`, status: \"observed\" },\ncli/src/core/context_inventory.ts:430:        unmetCriteria: [\"Per-source version/fingerprint and invalidation rules for repository-derived observations.\", \"A freshness objective backed by observed change-to-invalidation latency.\"],\ncli/src/core/context_inventory.ts:464:    ...snapshot.items.map((item) => `${item.id} ${item.sourceType} @ ${item.sourceLocation} [${item.scope}; ${item.freshness}${item.freshnessRule ? ` (${item.freshnessRule})` : \"\"}; ${item.trust}] ${item.estimatedTokens} est. tokens; via ${item.retrievalMethod}`),\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:1:# Nexus context maturity and inventory\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:7:Repository: Nexus Code. The initial operator checkout was clean `main` at `9156571f7d5fd8f8436c3105f0237628ab35e857`; the requested implementation target is `release/v1.3.0`, initially at `79ebb92c7254340effd5cd296181794d665648ae`. The isolated branch `codex/context-maturity-v130` remains based on that initial release head pending integration with the latest `origin/release/v1.3.0` (`96e963772f36d84561afdca409468f5963746210`).\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:13:| Navigability | 2 — Exploratory | `AutonomousAgent.requestMessages` carries conversation and pins the durable objective (`cli/src/agent.ts:2318-2338`); `getContextBudget` accounts for messages and tool schemas (`agent.ts:2475-2478`); repository search, skills, and `KnowledgeGraph` exist (`cli/src/knowledge.ts:37-45`, `cli/src/skills.ts:498-518`). | These sources do not have a shared inspectable inventory; the prompt combines several sources and history is replayed as messages. Retrieval reasons and cross-source relationships are not reported together. | Add a common inventory format and a read-only inspection command, while explicitly listing uncovered sources. |\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:14:| Retrieval speed | 2 — Exploratory | Deterministic client token estimates, provider-advertised counts where available, admission and bounded compaction exist (`cli/src/tokens.ts:97-158`, `cli/src/agent.ts:3410-3507`). | No source-level retrieval latency budget or SLO is recorded. Admission logs do not measure time spent assembling each source; estimates are not provider measurements. | Record per-source and total inventory-assembly duration; keep it distinct from inference latency and token estimates. |\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:15:| Freshness | 1 — Ad hoc | Context is gathered from the live session; candidate/verification evidence has identity-based invalidation elsewhere in the execution model. | Ordinary transcript/tool observations do not consistently carry a repository fingerprint or invalidation rule. Persisted knowledge has timestamps but no enforced applicability fingerprint. Unknown freshness can look current if rendered as prose. | Attach explicit freshness state and source references; report `unknown` where no applicable fingerprint exists. |\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:20:The current `/context maturity` output is computed from one content-free on-demand inventory and can change with observed session evidence. On the deterministic command fixture used here, it reports navigability 2 — Exploratory, retrieval speed 2 — Exploratory, freshness 1 — Ad hoc, and compounding value 1 — Ad hoc (no durable memory was present in that fixture). Ratings remain independent and do not claim a managed maturity level.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:24:| Navigability | 2 — Exploratory | `/context inspect [--json]` reports stable source IDs, locations, scope, trust, freshness, retrieval reason/method, source counts, and explicit coverage gaps. `SessionManager` persists optional metadata; exports include active and archived source references. | Exact per-inference request manifest and relationships among prompt components are not captured. Capture at request assembly after the `agent.ts` owner handoff. |\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:25:| Retrieval speed | 2 — Exploratory | The inspection command reports per-source and total local collection timings; token counts are labeled client estimates. Source exceptions are represented as failed and gaps are explicit. | No configured deadline, per-inference latency distribution, cache telemetry, or retrieval SLO. Keep this dimension exploratory until request-time measurements and timeout behavior are integrated and measured. |\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:26:| Freshness | 1 — Ad hoc | Items carry explicit `current` / `stale` / `unknown` plus an invalidation rule when freshness is asserted; session and archive reconstruction marks history unknown, and persisted current items are demoted to unknown until revalidated. The live repository-state item is current only at its capture time and names workspace mutation as its invalidation condition. | There is no persisted worktree fingerprint or systematic detector that turns old repository observations stale; future inspections must re-read source state. |\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:29:Ratings are per dimension. There is no aggregate maturity grade. A feature's presence alone does not satisfy a stage: the report requires evidence for shared behavior, freshness, and measured service levels.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:39:- `ContextInventoryItem`: stable source-identity id (source type + location + scope; no content hash is persisted), source kind/location, estimated tokens, observed time, freshness (`current`, `stale`, `unknown`), trust state, retention, inclusion reason, retrieval method, and optional source references. Message and tool-call identifiers are retained only as opaque hashes.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:41:- The persisted snapshot is optional. Older session records remain valid; inventory reconstruction labels transcript freshness unknown and marks session-save coverage partial because the exact provider request is unavailable.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:42:- `/context inspect [--json] [--record]` measures current client-visible sources on demand and optionally stores a content-free session snapshot; `/context maturity [--json]` emits a deterministic four-dimension assessment with evidence, gaps, limitations, and next improvements.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:49:- Workspace changes do not silently make an old observation current. If Nexus has no compatible source fingerprint, freshness remains `unknown`.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:52:- Knowledge entries retain repository scope, provenance, validation status, timestamps, and retention policy. Legacy entries migrate additively as `legacy_unverified`; expiring entries are removed from retrieval and pruned on load. Prompt injection labels all knowledge as unverified memory, never evidence. Secret-bearing values are rejected before entering the prompt-visible map.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:57:2. Inventory content contains no source plaintext and distinguishes operator, model, tool, and persisted-knowledge trust states. A non-unknown freshness claim requires an explicit invalidation rule; persistence or resume without revalidation demotes `current` to `unknown`.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:58:3. Compaction and resume retain predecessor source references or mark reconstructed provenance and freshness as unknown; exports carry the inventory and archive references.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:67:- A bounded `FILE_cli_src_agent.ts` handoff request was recorded in the shared claims log for exact per-inference capture at request construction/admission. The current claim is associated with PR #738 validation/publication; the owner has been asked to transfer the file or provide an owner-applied integration plan. The file was not edited. Until the transfer or integration occurs, `/context inspect` is an on-demand approximation and session snapshots remain explicitly partial.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:68:- Automatic memory learning, retrieval ranking changes, and context eviction remain deferred. Durable promotion is operator-only; accumulated memory has not yet been shown to improve task quality on held-out work.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:73:XERJ retrieval on `nexus-cli` located the existing context admission/token-accounting path in `cli/src/agent.ts` (`requestMessages`, `admitContext`), the `manage_knowledge` capability (`cli/src/core/capability_definitions/knowledge.ts:23`), and the local project knowledge graph (`cli/src/knowledge.ts:37-45`). OpenCode results showed permission checks belong at the application boundary; Goose results offered no relevant durable-memory analogue. Nexus therefore keeps the existing `KnowledgeGraph`, removes model-write affordances at both schema and handler, and uses the existing operator CLI as the promotion boundary. It rejects a second planner, provider-specific context protocol, external retrieval service, or copied peer implementation. XERJ indexes committed `origin/main`; the active worktree was checked directly.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:77:Implementation worktree: `codex/context-maturity-v130`, currently based on the initial `release/v1.3.0` commit `79ebb92c7254340effd5cd296181794d665648ae`; the release branch has advanced to `96e963772f36d84561afdca409468f5963746210`, so integration/rebase remains pending. Changes are uncommitted.\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:82:| `node --import tsx --test test/context_inventory.test.ts` (from `cli/`, isolated `HOME`/`XDG_CONFIG_HOME`) | 9 passed, 0 failed on current run | Provenance, scope-specific IDs, source failure, deterministic caps, bounded merge, separate/insufficient maturity evidence, common route and read-only policy, no provider call/plaintext persistence, saved-session and archive export. |\ndocs/research/context-engineering/CONTEXT-MATURITY-SYSTEM.md:99:- Freshness has no repository/worktree fingerprint or systematic invalidation, and no retrieval-latency SLO or cache instrumentation exists.\n/home/mike/nexus-code/.git/nexus-claims/FILE_cli_src_slash_workspace_commands.ts\ncat: /home/mike/nexus-code/.git/nexus-claims/FILE_cli_src_slash_workspace_commands.ts: Is a directory\n/home/mike/nexus-code/.git/nexus-claims/FILE_cli_src_slash_workspace_commands.ts/owner.json\n{\"agent\":\"codex-gpt-6\",\"branch\":\"codex/context-maturity-v130\",\"since\":\"2026-11-22T00:00:00Z\",\"pid\":3474547,\"worktree\":\"/home/mike/nexus-wt/context-maturity-v130\",\"scope\":\"Implement context inventory and maturity slash handler.\"}\n/home/mike/nexus-code/.git/nexus-claims/FILE_cli_src_core_context_inventory.ts/owner.json\n{\"agent\":\"codex-gpt-6\",\"branch\":\"codex/context-maturity-v130\",\"since\":\"2026-11-23T00:35:00Z\",\"worktree\":\"/home/mike/nexus-wt/context-maturity-v130\",\"scope\":\"Preserve privacy-safe message and tool-call provenance references in context inventory.\"}\nimport { execFileSync } from \"node:child_process\";\nimport * as fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { SANITIZATION_FAILED, formatSafeSidecarText } from \"../safe_text.js\";\nimport { copyWithFallback, readFromClipboard } from \"../clipboard.js\";\nimport { commitChanges, generateConventionalCommit, getGitInfo, trustedGitArgs, workspaceStatus } from \"../git.js\";\nimport { HunkStager } from \"../stager.js\";\nimport { runTestSuiteWithExecutor, discoverVerifier, describeVerifier, verifierTimeoutSecs } from \"../tester.js\";\nimport { isWorkspaceTrusted } from \"../workspace_trust.js\";\nimport { PolicyContext } from \"../core/approval_policy.js\";\nimport { isLegacyWorktreeArgs, relocationAfter, runWorktreeCommandAsync, tokenizeWorktreeArgs } from \"../worktrunk/command.js\";\nimport { providerCompleter } from \"../worktrunk/provider.js\";\nimport { assessContextMaturity, buildContextInventory, inventorySourcesFromMessages, renderContextInventoryText, renderContextMaturityText, type ContextSourceItemInput } from \"../core/context_inventory.js\";\nimport { NOT_A_REPO, SlashContext, SlashHandler, SlashOutcome, errorText, reply } from \"./catalog.js\";\nimport { MAX_PASTE } from \"../protocol.js\";\n\nfunction git(cwd: string, args: string[]): string {\n  return execFileSync(\"git\", [...trustedGitArgs(cwd), ...args], { cwd, encoding: \"utf-8\", stdio: [\"ignore\", \"pipe\", \"pipe\"], maxBuffer: 64 * 1024 * 1024 });\n}\n\nfunction workspace(ctx: SlashContext): string {\n  return ctx.host.app.getConfig().workspace;\n}\n\nfunction diff(ctx: SlashContext): SlashOutcome {\n  const cwd = workspace(ctx);\n  { const info = getGitInfo(cwd); if (!info.isRepo) return reply(\"diff\", info.refusal ?? NOT_A_REPO, false); }\n  try {\n    const out = git(cwd, [\"diff\", \"--no-color\"]);\n    if (out.trim()) return reply(\"diff\", out.trimEnd(), true, { format: \"diff\" });\n    // `git diff` shows unstaged edits to tracked files only; say what else is uncommitted rather than calling it clean.\n    const lines = workspaceStatus(cwd, \"--porcelain\").split(\"\\n\").filter(Boolean);\n    const untracked = lines.filter((l) => l.startsWith(\"??\")).length;\n    const staged = lines.filter((l) => l[0] !== \" \" && l[0] !== \"?\").length;\n    if (!untracked && !staged) return reply(\"diff\", \"Working tree clean: no uncommitted changes.\");\n    const parts = [untracked ? `${untracked} untracked` : \"\", staged ? `${staged} staged` : \"\"].filter(Boolean).join(\", \");\n    return reply(\"diff\", `No unstaged changes to tracked files; ${parts} (see /git).`);\n  } catch (err) {\n    return reply(\"diff\", `git diff failed: ${errorText(err)}`, false);\n  }\n}\n\nfunction gitStatus(ctx: SlashContext): SlashOutcome {\n  const cwd = workspace(ctx);\n  { const info = getGitInfo(cwd); if (!info.isRepo) return reply(\"git\", info.refusal ?? NOT_A_REPO, false); }\n  try {\n    return reply(\"git\", workspaceStatus(cwd, \"--short\").trimEnd() || \"Working tree clean.\");\n  } catch (err) {\n    return reply(\"git\", `git status failed: ${errorText(err)}`, false);\n  }\n}\n\nfunction stage(ctx: SlashContext): SlashOutcome {\n  const cwd = workspace(ctx);\n  { const info = getGitInfo(cwd); if (!info.isRepo) return reply(\"stage\", info.refusal ?? NOT_A_REPO, false); }\n  const stager = new HunkStager(cwd);\n  if (ctx.args.trim() === \"reset\") {\n    stager.unstage();\n    return reply(\"stage\", \"Unstaged all changes.\");\n  }\n  const summary = stager.getStatusSummary();\n  if (!summary.files.length) return reply(\"stage\", \"No unstaged hunks in the working tree.\");\n  const lines = [`${summary.files.length} modified files, ${summary.unstagedHunkCount} hunks`];\n  for (const file of summary.files) {\n    lines.push(\"\", `${file.newPath} (${file.hunks.length} hunks)`);\n    file.hunks.forEach((hunk, index) => {\n      lines.push(`  [hunk ${index + 1}] ${hunk.header}`);\n      lines.push(...hunk.lines.slice(0, 5).map((line) => `    ${line}`));\n      if (hunk.lines.length > 5) lines.push(`    … ${hunk.lines.length - 5} more lines`);\n    });\n  }\n  lines.push(\"\", \"Unstage with /stage reset, or commit with /commit.\");\n  return reply(\"stage\", lines.join(\"\\n\"));\n}\n\nfunction commit(ctx: SlashContext): SlashOutcome {\n  const cwd = workspace(ctx);\n  const info = getGitInfo(cwd);\n  if (!info.isRepo) return reply(\"commit\", info.refusal ?? NOT_A_REPO, false);\n  if (info.dirtyCount === 0) return reply(\"commit\", \"Working tree clean: nothing to commit.\");\n  const message = ctx.args.trim();\n  if (!message) {\n    const suggestion = generateConventionalCommit(cwd);\n    return reply(\n      \"commit\",\n      `${suggestion.files.length} changed files. Suggested message:\\n  ${suggestion.message}\\n\\nThe composer now holds /commit with this message: edit it and press enter to commit.`,\n      true,\n      { composer: `/commit ${suggestion.message}` },\n    );\n  }\n  const result = commitChanges(cwd, message);\n  return result.success ? reply(\"commit\", `Committed ${result.hash ?? \"\"}: ${message}`) : reply(\"commit\", `Commit failed: ${result.error}`, false);\n}\n\nfunction checkpoint(ctx: SlashContext): SlashOutcome {\n  const manager = ctx.host.checkpoints();\n  const [sub, ...rest] = ctx.args.trim().split(/\\s+/).filter(Boolean);\n  if (sub?.toLowerCase() === \"diff\") {\n    const [id, base] = rest;\n    if (!id) return reply(\"checkpoint\", \"Usage: /checkpoint diff <id> [base-id]\", false);\n    const result = manager.getDiff(id, base);\n    if (!result.success) return reply(\"checkpoint\", `Diff failed: ${result.error}`, false);\n    return result.diff.trim()\n      ? reply(\"checkpoint\", result.diff.trimEnd(), true, { format: \"diff\" })\n      : reply(\"checkpoint\", `No changes between ${id} and ${base ?? \"the working tree\"}.`);\n  }\n  if (sub?.toLowerCase() === \"prune\") {\n    const keep = Number.parseInt(rest[0] ?? \"20\", 10);\n    return reply(\"checkpoint\", manager.pruneCheckpoints(Number.isNaN(keep) ? 20 : keep).message);\n  }\n  const created = manager.createCheckpoint(ctx.args.trim() || undefined);\n  return reply(\"checkpoint\", `Checkpoint saved: ${created.name} (${created.id})`);\n}\n\nfunction checkpoints(ctx: SlashContext): SlashOutcome {\n  const list = ctx.host.checkpoints().listCheckpoints();\n  if (!list.length) return reply(\"checkpoints\", \"No saved checkpoints.\");\n  const rows = list.map((cp, index) => `${index + 1}. ${cp.id}  ${cp.name}  (${cp.timestamp})`);\n  return reply(\"checkpoints\", [...rows, \"\", \"Compare with /checkpoint diff <id>, roll back with /undo.\"].join(\"\\n\"));\n}\n\nfunction undo(ctx: SlashContext): SlashOutcome {\n  const result = ctx.host.checkpoints().rollbackLast();\n  return reply(\"undo\", result.message, result.success);\n}\n\nasync function worktree(ctx: SlashContext): Promise<SlashOutcome> {\n  const agent = ctx.host.app.getAgent();\n  const active = agent.getActiveWorktree();\n  const sub = ctx.args.trim().toLowerCase();\n  // Legacy forms act on the speculative worktree of this run; everything else is the named-worktree command set.\n  if (!isLegacyWorktreeArgs(sub)) {\n    const cwd = workspace(ctx);\n    const result = await runWorktreeCommandAsync(tokenizeWorktreeArgs(ctx.args), { cwd, readOnly: ctx.host.mode() === \"read-only\" }, {\n      completer: providerCompleter(ctx.host.app.getConfig()),\n      signal: ctx.signal,\n    });\n    // A merge removes the worktree this session may be standing in: move it to the branch it was merged into.\n    const moveTo = relocationAfter(result, cwd);\n    if (moveTo) ctx.host.setWorkspace(moveTo);\n    return reply(\"worktree\", moveTo ? `${result.output}\\nWorkspace changed to ${moveTo}` : result.output, result.success);\n  }\n  if (sub === \"merge\" || sub === \"discard\") {\n    if (!active) return reply(\"worktree\", `No active speculative worktree to ${sub}.`, false);\n    if (sub === \"merge\") {\n      const result = agent.mergeActiveWorktree();\n      return result.success\n        ? reply(\"worktree\", `Merged ${result.commitsMerged} speculative commit(s) from ${result.branch}.`)\n        : reply(\"worktree\", `Merge failed: ${result.error}`, false);\n    }\n    const result = agent.discardActiveWorktree();\n    return result.success ? reply(\"worktree\", \"Discarded the active speculative worktree.\") : reply(\"worktree\", `Discard failed: ${result.error}`, false);\n  }\n  const lines: string[] = [];\n  if (active) lines.push(`* active: ${active.branch} at ${active.worktreePath}`);\n  lines.push(...agent.getWorktreeManager().listWorktrees().map((wt) => `• ${wt.taskId}  ${wt.branch}  ${wt.path}`));\n  return reply(\"worktree\", lines.length ? lines.join(\"\\n\") : \"No speculative worktrees. Start Nexus with --worktree to isolate changes.\");\n}\n\nfunction audit(ctx: SlashContext): SlashOutcome {\n  const file = path.join(os.homedir(), \".nexus\", \"audit.log\");\n  if (!fs.existsSync(file)) return reply(\"audit\", \"No audit records yet.\");\n  const limit = Number.parseInt(ctx.args.trim(), 10) || 15;\n  const records = fs\n    .readFileSync(file, \"utf-8\")\n    .trim()\n    .split(\"\\n\")\n    .filter(Boolean)\n    .slice(-limit)\n    .flatMap((line) => {\n      try {\n        return [JSON.parse(line)];\n      } catch {\n        return [];\n      }\n    });\n  const rows = records.map((r) => {\n    const row = `${String(r.timestamp ?? \"\").slice(11, 19)}  ${r.success ? \"PASS\" : \"FAIL\"}  ${String(r.tool ?? \"\").padEnd(16)} ${String(r.duration_ms ?? 0).padStart(6)}ms`;\n    return r.error ? `${row}\\n    error: ${r.error}` : row;\n  });\n  return reply(\"audit\", rows.join(\"\\n\") || \"No audit records yet.\");\n}\n\nasync function test(ctx: SlashContext): Promise<SlashOutcome> {\n  const ws = workspace(ctx);\n  const filter = ctx.args.trim() || undefined;\n  const discovered = discoverVerifier(ws, filter);\n  if (!discovered) {\n    return reply(\"test\", \"no verifier: no verification command is configured or discovered in this workspace.\", false);\n  }\n  const description = describeVerifier(ws, discovered.command);\n  const testCommand = description?.command || discovered.command;\n  const agent = ctx.host.app.getAgent();\n  const bridge = agent.getBridge();\n  const config = ctx.host.app.getConfig();\n  const policyContext: PolicyContext = {\n    mode: ctx.host.mode(),\n    trusted: isWorkspaceTrusted(ws, Boolean(config.readOnly)),\n    sandbox: config.sandbox,\n    fullAccess: Boolean(config.fullAccess),\n  };\n  if (agent.getApprovalPolicy().requiresDecision(\"exec\", policyContext)) {\n    const approved = ctx.host.requestApproval\n      ? await ctx.host.requestApproval(\"verifier\", {\n          command: testCommand,\n          script: description?.script,\n          detail: description?.evidence ?? discovered.evidence,\n          digest: description?.digest,\n        }, ctx.signal)\n      : false;\n    if (!approved) return reply(\"test\", \"Test run aborted by user.\", false);\n  }\n  const timeoutSecs = verifierTimeoutSecs(ctx.host.app.getConfig().verifierTimeoutSecs);\n  bridge.setTurnSignal(ctx.signal);\n  let result;\n  try {\n    result = await runTestSuiteWithExecutor(\n      ws,\n      (command) => bridge.executeTool(\"run_command\", { command, timeout_secs: timeoutSecs }),\n      testCommand,\n    );\n  } finally {\n    bridge.setTurnSignal(undefined);\n  }\n  const lines = [`$ ${result.command}`, result.success ? \"Test suite passed.\" : \"Test suite failed.\"];\n  if (!result.success && result.failures.length) lines.push(\"\", \"Failing tests:\", ...result.failures.slice(0, 10).map((f) => `  • ${f}`));\n  if (!result.success && result.diagnostics.length) {\n    lines.push(\"\", \"Diagnostics:\", ...result.diagnostics.slice(0, 5).map((d) => `  • [${d.severity.toUpperCase()}] ${d.file || \"unknown\"}:${d.line || \"?\"} ${d.message}`));\n  }\n  return reply(\"test\", lines.join(\"\\n\"), result.success);\n}\n\nfunction lastAssistant(ctx: SlashContext): string {\n  const messages = ctx.host.app.getAgent().getMessages();\n  for (let i = messages.length - 1; i >= 0; i--) {\n    const content = messages[i].content;\n    if (messages[i].role === \"assistant\" && content) return typeof content === \"string\" ? content : JSON.stringify(content);\n  }\n  return \"\";\n","exit_code":0,"duration":{"secs":0,"nanos":796295014}},"started_at_ms":1795397187902,"completed_at_ms":1795397188699}}
