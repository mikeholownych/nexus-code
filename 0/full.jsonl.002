ge.exportPromptSection()}` : \\\"\\\";\\n    \\n        // Invariant prompt prefix optimization for local AI:\\n        // Fixed canonical few-shots ensure byte-exact prefix caching across turns (vLLM / llama.cpp / Ollama)\\n        const nativeTools = this.client?.supportsNativeTools?.() ?? tru\\n    … (--full 1200 to see more)\\n\\n─── model_catalog.ts:2  (score 27.16)\\n    /**\\n     * What the model picker shows: the appliance and every cloud provider, whether and how each is connected, the models\\n     * each lists, and the operator's recent selections. Listing never blocks on a slow or offline provider: each list\\n     * is fetched with a timeout and falls back to the last good list cached in ~/.cache/nexus/models.\\n     */\\n    import * as fs from \\\"node:fs\\\";\\n    import * as path from \\\"node:path\\\";\\n    import { createHash } from \\\"node:crypto\\\";\\n    import { credentialStorageHome, LocalLlmClient, operatorSetting } from \\\"./client.js\\\";\\n    import { applianceEndpointSelection, buildConfig, providerBaseUrl,\\n    … (--full 1200 to see more)\\n\\n─── providers.ts:30  (score 25.53)\\n    export interface ProviderDefinition {\\n      id: string;\\n      label: string;\\n      protocol: WireProtocol;\\n      /** Includes the provider's API path and version; nothing is appended except the operation path. */\\n      baseUrl?: string;\\n      /** Environment variable holding this provider's key (none for sign-in-only providers). Sent only to the connection's own origin. */\\n      credentialEnv?: string;\\n      methods: ConnectMethod[];\\n      /** The backend accepts streamed requests only; non-streaming calls are streamed internally. */\\n      streamOnly?: boolean;\\n      /** Request parameters this backend rejects for every model; never sen\\n    … (--full 1200 to see more)\\n\\n5 passage(s) from 'nexus-cli-*'. Cite ax_path:line (ax_path#locator for a data row) for anything you rely on.\\nxerj search: these hits are lexical; this command does not consult the embedding.\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"6f6c51\",\"wall_time_seconds\":0.799847692,\"exit_code\":0,\"original_token_count\":3836,\"output\":\"/**\\n * Standalone qualification without a second inference host (DEC-16, REQ-PRV-106): the harness's proxy shows Nexus the\\n * gateway as a plain OpenAI-compatible server (no limits, no /tokenize, no X-AIHost-* headers), or shaped like\\n * llama.cpp, vLLM or Ollama. Nexus's own discovery must then find the context the way it would on that server.\\n */\\nimport { test, describe, before, after } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport http from \\\"node:http\\\";\\nimport path from \\\"node:path\\\";\\nimport { fileURLToPath } from \\\"node:url\\\";\\nimport { LocalLlmClient } from \\\"../src/client.js\\\";\\nimport { classifyHttpFailure, providerHints } from \\\"../src/core/provider_recovery.js\\\";\\n\\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \\\"../..\\\");\\n\\ndescribe(\\\"standalone profiles of the model proxy\\\", () => {\\n  let gateway: http.Server;\\n  let url = \\\"\\\";\\n  const seenAuth: Array<string | undefined> = [];\\n  before(async () => {\\n    gateway = http.createServer((req, res) => {\\n      seenAuth.push(req.headers.authorization);\\n      req.resume();\\n      res.setHeader(\\\"x-aihost-route\\\", \\\"worker=w1;pool=p\\\");\\n      if (req.url === \\\"/v1/models\\\") {\\n        res.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n        return void res.end(JSON.stringify({ data: [{ id: \\\"m\\\", object: \\\"model\\\", context_length: 8192, max_completion_tokens: 2048, limits_version: \\\"lv1\\\", serving: [{ worker_id: \\\"w1\\\" }] }] }));\\n      }\\n      if (req.url === \\\"/v1/tokenize\\\") {\\n        res.setHeader(\\\"content-type\\\", \\\"application/json\\\");\\n        return void res.end(JSON.stringify({ prompt_tokens: 10, source: \\\"exact\\\" }));\\n      }\\n      res.writeHead(400, { \\\"content-type\\\": \\\"application/json\\\" });\\n      res.end(JSON.stringify({ error: { message: \\\"prompt is too long for the context window\\\", type: \\\"context_length_exceeded\\\" } }));\\n    });\\n    await new Promise<void>((r) => gateway.listen(0, \\\"127.0.0.1\\\", () => r()));\\n    url = `http://127.0.0.1:${(gateway.address() as any).port}/v1`;\\n  });\\n  after(() => gateway.close());\\n\\n  const withProxy = async (profile: string, fn: (proxyUrl: string) => Promise<void>) => {\\n    const { startModelProxy } = await import(path.join(ROOT, \\\"eval/model_proxy.mjs\\\"));\\n    const proxy = await startModelProxy({ upstream: url, profile, authToken: \\\"gateway-token\\\" });\\n    try {\\n      await fn(proxy.url);\\n    } finally {\\n      await proxy.close();\\n    }\\n  };\\n  const discover = (proxyUrl: string) => new LocalLlmClient({ endpoint: proxyUrl, model: \\\"m\\\", workspace: \\\"/tmp\\\", maxSteps: 1, apiKey: \\\"local\\\" } as any).discoverAdvertisement();\\n\\n  test(\\\"plain: no limits, no request counting, no gateway headers; the gateway token is added by the proxy\\\", async () => {\\n    await withProxy(\\\"plain\\\", async (p) => {\\n      const found = await discover(p);\\n      assert.equal(found.state, \\\"unsupported\\\");\\n      assert.equal(found.detail, \\\"catalog lists no limits\\\");\\n      assert.equal((await fetch(`${p}/tokenize`, { method: \\\"POST\\\", body: \\\"{}\\\" })).status, 404);\\n      const models = await fetch(`${p}/models`);\\n      assert.equal(models.headers.get(\\\"x-aihost-route\\\"), null);\\n      assert.deepEqual((await models.json()).data, [{ id: \\\"m\\\", object: \\\"model\\\", owned_by: \\\"organization\\\" }]);\\n      assert.ok(seenAuth.length && seenAuth.every((a) => a === \\\"Bearer gateway-token\\\"), \\\"the gateway saw only the proxy's token\\\");\\n    });\\n  });\\n\\n  for (const [profile, via] of [[\\\"llamacpp\\\", \\\"llamacpp\\\"], [\\\"vllm\\\", \\\"vllm\\\"], [\\\"ollama\\\", \\\"ollama\\\"]] as const) {\\n    test(`${profile}: Nexus finds the gateway's real context the way that server reports it`, async () => {\\n      await withProxy(profile, async (p) => {\\n        const found = await discover(p);\\n        assert.equal(found.state, \\\"supported\\\", JSON.stringify(found));\\n        assert.equal(found.advertised?.via, via);\\n        assert.equal(found.advertised?.contextLength, 8192);\\n        assert.equal(found.advertised?.tokenize, false);\\n      });\\n    });\\n  }\\n\\n  test(\\\"context-overflow errors take the profile's shape and stay capacity rejections\\\", async () => {\\n    for (const profile of [\\\"llamacpp\\\", \\\"vllm\\\", \\\"ollama\\\"]) {\\n      await withProxy(profile, async (p) => {\\n        const res = await fetch(`${p}/chat/completions`, { method: \\\"POST\\\", body: \\\"{}\\\" });\\n        const body = await res.text();\\n        assert.equal(res.status, 400);\\n        assert.equal(classifyHttpFailure(400, providerHints(res.headers, body), body).condition, \\\"CAPACITY_REJECTED\\\", `${profile}: ${body}`);\\n        if (profile === \\\"llamacpp\\\") assert.match(body, /exceed_context_size_error/);\\n        if (profile === \\\"vllm\\\") assert.match(body, /maximum context length is 8192/);\\n      });\\n    }\\n  });\\n});\\n      assert.equal(found.advertised?.via, \\\"vllm\\\");\\n      assert.equal(serverKindOfAdvertisement(found.advertised), \\\"vllm\\\");\\n      assert.equal(found.advertised?.contextLength, 16384);\\n      assert.deepEqual(srv.seen, [\\\"GET /v1/models\\\"]);\\n    } finally {\\n      await srv.close();\\n    }\\n  });\\n  test(\\\"subsequent context discovery reuses cached advertisement without hitting probe endpoint again\\\", async () => {\\n    const srv = await server({\\n      \\\"GET /v1/models\\\": () => ({ data: [{ id: \\\"m\\\", object: \\\"model\\\", owned_by: \\\"llamacpp\\\", meta: { n_ctx_train: 131072 } }] }),\\n      \\\"GET /props\\\": () => ({ default_generation_settings: { n_ctx: 8192 } }),\\n    });\\n    try {\\n      const client = new LocalLlmClient({ endpoint: srv.url, model: \\\"m\\\", workspace: \\\"/tmp\\\", maxSteps: 1 } as any);\\n      const first = await client.discoverAdvertisement();\\n      assert.equal(first.advertised?.contextLength, 8192);\\n      const propsCallsBefore = srv.seen.filter((s) => s.startsWith(\\\"GET /props\\\")).length;\\n      assert.equal(propsCallsBefore, 1);\\n      const second = await client.discoverAdvertisement();\\n      assert.equal(second.advertised?.contextLength, 8192);\\n      const propsCallsAfter = srv.seen.filter((s) => s.startsWith(\\\"GET /props\\\")).length;\\n      assert.equal(propsCallsAfter, 1, \\\"no second probe made to /props due to caching\\\");\\n    } finally {\\n      await srv.close();\\n    }\\n  });\\n  test(\\\"an unrecognised server is not probed and stays on labelled defaults\\\", async () => {\\n    const srv = await server({ \\\"GET /v1/models\\\": () => ({ data: [{ id: \\\"m\\\", object: \\\"model\\\" }] }) });\\n    try {\\n      const found = await new LocalLlmClient({ endpoint: srv.url, model: \\\"m\\\", workspace: \\\"/tmp\\\", maxSteps: 1 } as any).discoverAdvertisement();\\n      assert.equal(found.state, \\\"unsupported\\\");\\n      assert.equal(found.detail, \\\"catalog lists no limits\\\");\\n      assert.deepEqual(srv.seen, [\\\"GET /v1/models\\\"], \\\"no guessed endpoints were requested\\\");\\n    } finally {\\n      await srv.close();\\n    }\\n  });\\n});\\n\\ndescribe(\\\"context-overflow classification (ACC-INF-02 table)\\\", () => {\\nimport { test, describe } from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport fs from \\\"node:fs\\\";\\nimport path from \\\"node:path\\\";\\nimport http from \\\"node:http\\\";\\nimport { fileURLToPath } from \\\"node:url\\\";\\nimport { createHash } from \\\"node:crypto\\\";\\nimport { countTokens } from \\\"../src/tokens.js\\\";\\nimport { LocalLlmClient } from \\\"../src/client.js\\\";\\nimport { parseTokenizeResponse } from \\\"../src/core/provider_capabilities.js\\\";\\n\\nconst __dirname = path.dirname(fileURLToPath(import.meta.url));\\nconst fixturePath = path.join(__dirname, \\\"fixtures\\\", \\\"token_calibration.json\\\");\\n\\ninterface CalibrationEntry {\\n  name: string;\\n  kind: string;\\n  repeat?: [string, number];\\n  generator?: string;\\n  referenceTokens: number;\\n  floorBound?: boolean;\\n  floorTokens?: number;\\n  note?: string;\\n}\\n\\ninterface CalibrationFixture {\\n  tokenizer: {\\n    id: string;\\n    limitsVersion: string;\\n    capturedAt: string;\\n    templateOverheadTokens: number;\\n  };\\n  corpora: CalibrationEntry[];\\n}\\n\\nfunction materializeCorpus(entry: CalibrationEntry): string {\\n  if (entry.repeat) {\\n    const [unit, times] = entry.repeat;\\n    return unit.repeat(times);\\n  }\\n  if (entry.generator === \\\"minified_json_50\\\") {\\n    return JSON.stringify(Array.from({ length: 50 }, (_, i) => ({ id: i, k: \\\"v\\\" + i, ok: true })));\\n  }\\n  if (entry.generator === \\\"base64_3072_7\\\") {\\n    return Buffer.alloc(3072, 7).toString(\\\"base64\\\");\\n  }\\n  if (entry.generator === \\\"base64_lcg_3072\\\") {\\n    const b = Buffer.alloc(3072);\\n    let x = 12345;\\n    for (let i = 0; i < b.length; i++) {\\n      x = (x * 1103515245 + 12345) & 0x7fffffff;\\n      b[i] = (x >> 16) & 255;\\n    }\\n    return b.toString(\\\"base64\\\");\\n  }\\n  if (entry.generator === \\\"base64_text_120\\\") {\\n    return Buffer.from(\\\"Hello world 1234567890!@# \\\".repeat(120)).toString(\\\"base64\\\");\\n  }\\n  if (entry.generator === \\\"hex_sha256_20\\\") {\\n    return Array.from({ length: 20 }, (_, i) => createHash(\\\"sha256\\\").update(String(i)).digest(\\\"hex\\\")).join(\\\"\\\");\\n  }\\n  throw new Error(`Unknown corpus generator: ${entry.generator}`);\\n}\\n\\ndescribe(\\\"ACC-VER-07 & REQ-AGT-118: Conservative token estimator and calibration\\\", () => {\\n  test(\\\"long whitespace runs are processed without changing conservative counts\\\", () => {\\n    const run = \\\" \\\".repeat(131_072);\\n    assert.equal(countTokens(run), Math.ceil(run.length / 3));\\n    assert.equal(countTokens(`${run}a`), Math.ceil((run.length - 1) / 3) + 1);\\n    const tabs = \\\"\\\\t\\\".repeat(131_072);\\n    assert.equal(countTokens(`${tabs}a`), Math.ceil((tabs.length - 1) / 3) + 2);\\n  });\\n\\n  test(\\\"ACC-VER-07: countTokens is within 1.5x of pinned tokenizer reference counts (floor-bound corpora excepted per DEC-17)\\\", () => {\\n    const fixture = JSON.parse(fs.readFileSync(fixturePath, \\\"utf8\\\")) as CalibrationFixture;\\n    assert.ok(fixture.corpora.length >= 8, \\\"calibration fixture must contain all required corpora\\\");\\n    // The pinned corpora are the calibration evidence: none may be silently deleted, and any new corpus\\n    // must run through the band/floor logic below (DEC-17: examined and recorded, not exempted by default).\\n    const pinnedCorpora = [\\n      \\\"english prose (200 words)\\\",\\n      \\\"CJK one 400-char run\\\",\\n      \\\"CJK 16-char classical x 25\\\",\\n      \\\"CJK 7-char sentences x 50\\\",\\n      \\\"Kana 200 chars\\\",\\n      \\\"Hangul 200 chars\\\",\\n      \\\"digits 1000\\\",\\n      \\\"minified JSON\\\",\\n      \\\"base64 4KB\\\",\\n      \\\"base64 random 3072B (LCG seed 12345)\\\",\\n      \\\"base64 of text\\\",\\n      \\\"hex sha256 x20\\\",\\n      \\\"whitespace-indented code\\\",\\n      \\\"emoji 100\\\",\\n    ];\\n    for (const name of pinnedCorpora) {\\n      assert.ok(fixture.corpora.some((c) => c.name === name), `calibration fixture must still contain corpus \\\"${name}\\\"`);\\n    }\\n\\n    const floorBound: string[] = [];\\n    for (const entry of fixture.corpora) {\\n      const text = materializeCorpus(entry);\\n      const estimated = countTokens(text);\\n      const ref = entry.referenceTokens;\\n      // Conservative: never under-estimate by more than 20% (A2 §6, R-VER-10).\\n      assert.ok(estimated >= ref * 0.8, `${entry.name}: estimated=${estimated} under-estimates reference=${ref}`);\\n      const ratio = estimated >= ref ? estimated / ref : ref / estimated;\\n      if (entry.floorBound) {\\n        // DEC-17: REQ-AGT-118's >= 1 token/character floor dominates a merging tokenizer here.\\n        // The over-estimate is an accepted, bounded safety bias: it must never under-count, and the\\n        // floor (one token per CJK/Hangul char) must be applied exactly. Preserved as evidence, not hidden.\\n        assert.ok(estimated >= ref, `${entry.name}: a floor-bound corpus must remain an over-estimate`);\\n        assert.equal(estimated, entry.floorTokens, `${entry.name}: the >= 1 token/char floor must be applied exactly`);\\n        floorBound.push(`${entry.name} ratio=${ratio.toFixed(2)}`);\\n        continue;\\n      }\\n      assert.ok(ratio <= 1.5, `${entry.name}: estimated=${estimated} vs reference=${ref} (ratio=${ratio.toFixed(3)} exceeds 1.5x)`);\\n    }\\n    // Only the two merging-script corpora may sit above the band (DEC-17); a new one must be examined and recorded, not silently added.\\n    assert.deepEqual(floorBound.map((c) => c.split(\\\" ratio=\\\")[0]).sort(), [\\\"CJK 7-char sentences x 50\\\", \\\"Hangul 200 chars\\\"]);\\n  });\\n\\n  test(\\\"REQ-AGT-118: conservative script and symbol rules (>= 1 per CJK/Hangul/kana, 1 per digit, len/3 for base64)\\\", () => {\\n    const cjk = \\\"测试中文字符计数\\\".repeat(25); // 200 Han chars\\n    assert.ok(countTokens(cjk) >= 200, `expected >= 200 tokens for 200 CJK chars, got ${countTokens(cjk)}`);\\n\\ncli/test/client_tool_grammar.test.ts:55:    if (req.url === \\\"/v1/models\\\") return json(res, { data: [{ id: \\\"model-a\\\", max_model_len: 8192 }] });\\ncli/test/client_tool_grammar.test.ts:114:    if (req.url === \\\"/v1/models\\\") return json(res, { data: [{ id: \\\"model-a\\\", max_model_len: 8192 }] });\\ncli/test/client_tool_grammar.test.ts:135:    if (req.url === \\\"/v1/models\\\") return json(res, { data: [{ id: \\\"model-a\\\", max_model_len: 8192 }] });\\ncli/test/client_tool_grammar.test.ts:297:    { name: \\\"missing version\\\", models: [{ id: \\\"model-a\\\", max_model_len: 8192 }], versionStatus: 404, version: undefined },\\ncli/test/client_tool_grammar.test.ts:298:    { name: \\\"malformed version\\\", models: [{ id: \\\"model-a\\\", max_model_len: 8192 }], versionStatus: 200, version: { version: 7 } },\\ncli/test/client_tool_grammar.test.ts:299:    { name: \\\"mismatched model\\\", models: [{ id: \\\"other-model\\\", context_length: 8192 }], versionStatus: 200, version: { version: \\\"0.10.0\\\" } },\\ncli/test/provider_capabilities.test.ts:23:  context_length: 65536,\\ncli/test/provider_capabilities.test.ts:24:  max_model_len: 65536,\\ncli/test/provider_capabilities.test.ts:34:    assert.equal(serverKindOf({ id: \\\"m\\\", context_length: 32768 }), \\\"unknown\\\");\\ncli/test/provider_capabilities.test.ts:35:    assert.equal(serverKindOf({ id: \\\"m\\\", max_model_len: 32768 }), \\\"unknown\\\");\\ncli/test/provider_capabilities.test.ts:39:    const ad = parseAdvertisement(gatewayEntry)!;\\ncli/test/provider_capabilities.test.ts:48:  test(\\\"vLLM-style max_model_len is capacity without request counting; a bare catalog advertises nothing\\\", () => {\\ncli/test/provider_capabilities.test.ts:49:    assert.deepEqual(parseAdvertisement({ id: \\\"m\\\", max_model_len: 32768 }), { via: \\\"vllm\\\", contextLength: 32768, tokenize: false });\\ncli/test/provider_capabilities.test.ts:50:    assert.deepEqual(parseAdvertisement({ id: \\\"m\\\" }), { via: \\\"catalog\\\", tokenize: false });\\ncli/test/provider_capabilities.test.ts:51:    assert.equal(parseAdvertisement(undefined), undefined);\\ncli/test/provider_capabilities.test.ts:55:    const ad = parseAdvertisement({ ...gatewayEntry, context_length: null, max_model_len: null })!;\\ncli/test/provider_capabilities.test.ts:62:    const a = parseAdvertisement(gatewayEntry)!;\\ncli/test/provider_capabilities.test.ts:63:    assert.equal(advertisementChanged(a, parseAdvertisement(gatewayEntry)), false);\\ncli/test/provider_capabilities.test.ts:64:    assert.equal(advertisementChanged(a, parseAdvertisement({ ...gatewayEntry, limits_version: \\\"x\\\" })), true);\\ncli/test/provider_capabilities.test.ts:65:    assert.equal(advertisementChanged(a, parseAdvertisement({ ...gatewayEntry, context_length: 32768 })), true);\\ncli/test/provider_capabilities.test.ts:66:    assert.equal(advertisementChanged(a, parseAdvertisement({ ...gatewayEntry, serving: [{ worker_id: \\\"w2\\\" }] })), true);\\ncli/test/provider_capabilities.test.ts:79:    const ad = parseAdvertisement({ ...gatewayEntry, context_length: 131072, max_completion_tokens: 16384 })!;\\ncli/test/provider_capabilities.test.ts:103:    assert.deepEqual(parseTokenizeResponse({ model: \\\"m\\\", prompt_tokens: 1234, source: \\\"exact\\\", context_length: 65536, limits_version: \\\"lv\\\", worker_id: \\\"w1\\\" }), {\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","create_time":1793747174.2454681}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
