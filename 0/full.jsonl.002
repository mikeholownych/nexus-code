(args.command || \"\").trim();\n        if (!isSafeReadOnlyCommand(cmd, undefined, this.workspace)) {\n          return {\n            success: true,\n            output: `[DRY-RUN SIMULATION] Command '${cmd}' simulated without execution to protect disk state.`,\n          };\n        }\n      }\n    }\n\n    if (toolName === \"task_completed\") {\n      return {\n        success: true,\n        output: JSON.stringify({\n          status: \"completed\",\n          summary: args.summary || \"Task marked as completed.\",\n          notes: args.notes || \"\",\n        }),\n      };\n    }\n\n    if (toolName === \"update_plan\") {\n      return {\n        success: true,\n        output: JSON.stringify({\n          status: \"plan_updated\",\n          phases: args.phases || [],\n        }),\n      };\n    }\n\n    if (toolName === \"run_tests\") {\n      const { discoverVerifier, runTestSuiteWithExecutor, verifierTimeoutSecs } = await import(\"./tester.js\");\n      const discovered = discoverVerifier(this.workspace, args.filter);\n      if (!discovered) {\n        return {\n          success: false,\n          output: JSON.stringify({\n            command: \"none\",\n            passed: false,\n            noVerifier: true,\n/**\n * Common Execution Spine & Invocation Pipeline\n * Nexus Issue #12 — WP-01 (INC-02, EXEC-001..013, FAIL-001..004, F-09)\n */\n\nimport { randomUUID } from \"node:crypto\";\nimport { ExecutionResult } from \"../types.js\";\nimport {\n  CanonicalCapability,\n  CapabilityRegistry,\n  defaultRegistry,\n  CapabilityHandler,\n  changesWorkspace,\n} from \"./capabilities.js\";\nimport type { SkillAttribution } from \"./skill_activation.js\";\n\nexport interface InvocationRequest {\n  /** Unique invocation identity (assigned if omitted) (EXEC-002) */\n  invocationId?: string;\n  /** Owning task identity (EXEC-002) */\n  taskId?: string;\n  /** Actor identity requesting invocation (ACT-001..004, EXEC-008) */\n  actor?: \"agent\" | \"subagent\" | \"operator\" | \"extension\" | string;\n  /** Execution domain in effect (EXEC-013) */\n  executionDomain?: \"agent_orchestration\" | \"operator_direct_shell\" | \"subagent\" | \"extension\" | string;\n  /** Model-visible tool name */\n  toolName: string;\n  /** Invocation arguments */\n  args: Record<string, any>;\n  /** Step index in active turn */\n  stepIndex?: number;\n  /** Active skill attribution (WP-GS-01); omitted when no activation or disabled */\n  skillAttribution?: SkillAttribution;\n}\n\nexport interface InvocationContext {\n  /** Effective verified workspace or worktree root path (EXEC-003) */\n  workspaceRoot: string;\n  /** Dry-run simulation mode flag */\n  dryRun?: boolean;\n  /** Read-only mode flag */\n  readOnly?: boolean;\n  /** Custom metadata */\n  metadata?: Record<string, any>;\n  /** RustCoreBridge instance if available */\n  bridge?: any;\n  /** Fallback default execution handler */\n  defaultHandler?: (\n    toolName: string,\n    args: Record<string, any>,\n    context: InvocationContext\n  ) => Promise<ExecutionResult>;\n  [key: string]: any;\n}\n\nexport interface AdmissionDecision {\n  admitted: boolean;\n  reason?: string;\n  effectiveScope?: string;\n}\n\nexport interface ResourceConfinementDecision {\n  confined: boolean;\n  reason?: string;\n  normalizedPath?: string;\n}\n\nexport interface EgressDecision {\n  allowed: boolean;\n  quarantined?: boolean;\n  sanitizedArgs?: Record<string, any>;\n  reason?: string;\n}\n\nexport interface ProcessLifecycleEvent {\n  stage: \"start\" | \"exit\" | \"cancel\" | \"timeout\";\n  invocationId: string;\n  toolName: string;\n  command?: string;\n  pid?: number;\n  exitCode?: number;\n  error?: string;\n}\n\nexport interface CandidateMutationEvent {\n  invocationId: string;\n  toolName: string;\n  mutatedPaths: string[];\n  durationMs: number;\n}\n\nexport interface ContextAdmissionDecision {\n  admitted: boolean;\n  reason?: string;\n  tokenCount?: number;\n}\n\nexport interface ExecutionReceipt