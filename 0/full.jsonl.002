atic deprecatedOptions\\nfunction warnDeprecatedOptions\\nfunction usesAutomaticNumCtx\\nfunction usesAutomaticNumBatch\\nfunction normalizeRunner\\nmethod scheduleRunner\\nmethod scheduleRunnerForModel\\nfunction signinURL\\nmethod GenerateHandler\\nmethod systemOneLlamaServer\\nmethod SystemOneHandler\\nmethod EmbedHandler\\ntype embedInput\\nfunction normalize\\nmethod EmbeddingsHandler\\nmethod PullHandler\\nmethod PushHandler\\nmethod getExistingModelForRunner\\nfunction loadExistingModelForRunner\\nfunction getExistingName\\nmethod DeleteHandler\\nmethod ShowHandler\\nfunction GetModelInfo\\nfunction getModelData\\nfunction selectedModelTemplate\\nmethod ListHandler\\nmethod CopyHandler\\nmethod HeadBlobHandler\\nmethod CreateBlobHandler\\nfunction isLocalIP\\nfunction allowedHost\\nfunction allowedHostsMiddleware\\nmethod GenerateRoutes\\nmethod ModelRecommendationsExperimentalHandler\\nfunction Serve\\nfunction waitForStream\\nfunction streamResponse\\nmethod StatusHandler\\nmethod BalanceHandler\\nmethod UsageHandler\\nmethod WebSearchExperimentalHandler\\nmethod WebFetchExperimentalHandler\\nmethod webExperimentalProxyHandler\\nmethod WhoamiHandler\\nmethod SignoutHandler\\nmethod PsHandler\\nfunction toolCallId\\nfunction preservedTokensForCompletion\\nfunction toolCallTagForCompletion\\nfunction thinkingCloseForCompletion\\nfunction leadingBOSForModel\\nfunction optionsForPrompt\\ntype chatExecutionMode\\nconst chatExecutionModeNative\\nconst chatExecutionModeRendered\\nfunction chatModeForModel\\nfunction llamaServerConfigForModel\\nfunction usesOllamaRenderedChat\\nfunction shouldUseGoTemplate\\nfunction writeChatResponse\\nmethod ChatHandler\\nfunction prepareNativeChatRequest\\nmethod handleNativeChat\\nfunction truncateNativeChatMessages\\nfunction countChatImages\\nfunction handleScheduleError\\nfunction scheduleError\\nfunction chatMessagesForRequest\\nfunction filterThinkTags\"}]}},{\"_index\":\"wp1107-ollama-docs\",\"_id\":\"38f411d3e9ef26a13803