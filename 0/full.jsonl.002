LLM_API_KEY=legacy-old-origin-key\\n`);\ncli/test/provider_connect.test.ts:501:    setCredentialAuthority({ LOCAL_LLM_ENDPOINT: oldEndpoint, LOCAL_LLM_API_KEY: \"legacy-old-origin-key\" }, home);\ncli/test/provider_connect.test.ts:507:        LOCAL_LLM_ENDPOINT: newEndpoint,\ncli/test/provider_connect.test.ts:508:        LOCAL_LLM_API_KEY: \"legacy-old-origin-key\",\ncli/test/provider_connect.test.ts:529:    operator({ LOCAL_LLM_ENDPOINT: endpoint, LOCAL_LLM_API_KEY: \"legacy-origin-key\", LOCAL_LLM_CREDENTIAL_ORIGIN: \"not a valid origin\" });\ncli/test/provider_connect.test.ts:540:    const configFile = write(\".config/nexus/config.env\", `LOCAL_LLM_ENDPOINT=${JSON.stringify(endpoint)}\\nLOCAL_LLM_API_KEY=legacy-origin-key\\nLOCAL_LLM_CREDENTIAL_ORIGIN=\"not a valid origin\"\\n`);\ncli/test/provider_connect.test.ts:543:    assert.equal(environmentCredential(endpoint), undefined, \"the key from config.env also remains unbound\");\ncli/test/provider_connect.test.ts:550:    const previous = process.env.LOCAL_LLM_API_KEY;\ncli/test/provider_connect.test.ts:553:      process.env.LOCAL_LLM_API_KEY = \"REDACTED\";\ncli/test/provider_connect.test.ts:554:      setCredentialAuthority({ LOCAL_LLM_API_KEY: \"operator-key\", LOCAL_LLM_CREDENTIAL_ORIGIN: origin }, home);\ncli/test/provider_connect.test.ts:559:      if (previous === undefined) delete process.env.LOCAL_LLM_API_KEY;\ncli/test/provider_connect.test.ts:560:      else process.env.LOCAL_LLM_API_KEY = REDACTED;\ncli/test/provider_connect.test.ts:565:    const previous = process.env.LOCAL_LLM_API_KEY;\ncli/test/provider_connect.test.ts:568:      process.env.LOCAL_LLM_API_KEY = \"REDACTED\";\ncli/test/provider_connect.test.ts:569:      setCredentialAuthority({ LOCAL_LLM_API_KEY: \"legacy-origin-key\", LOCAL_LLM_CREDENTIAL_ORIGIN: \"not a valid origin\" }, home);\ncli/test/provider_connect.test.ts:574:      if (previous === undefined) delete process.env.LOCAL_LLM_API_KEY;\ncli/test/provider_connect.test.ts:575:      else process.env.LOCAL_LLM_API_KEY = REDACTED;\ncli/test/provider_connect.test.ts:583:      fs.writeFileSync(path.join(project, \".env\"), \"LOCAL_LLM_API_KEY=REDACTED;\ncli/test/provider_connect.test.ts:595:          LOCAL_LLM_API_KEY: \"legacy-origin-key\",\ncli/test/provider_connect.test.ts:597:          LOCAL_LLM_ENDPOINT: \"http://operator-endpoint.invalid/v1\",\ncli/test/provider_connect.test.ts:613:      fs.writeFileSync(path.join(project, \".env\"), \"LOCAL_LLM_API_KEY=REDACTED;\ncli/test/provider_connect.test.ts:624:          LOCAL_LLM_API_KEY: \"legacy-origin-key\",\ncli/test/provider_connect.test.ts:626:          LOCAL_LLM_ENDPOINT: \"http://operator-endpoint.invalid/v1\",\ncli/test/provider_connect.test.ts:639:    const configFile = write(\".config/nexus/config.env\", 'LOCAL_LLM_ENDPOINT=\"http://127.0.0.1:1234/v1\"\\nLOCAL_LLM_MODEL=\"prior-model\"\\n');\ncli/test/provider_connect.test.ts:654:    const previous = 'LOCAL_LLM_ENDPOINT=\"http://127.0.0.1:9/v1\"\\nLOCAL_LLM_MODEL=\"previous-model\"\\n';\ncli/test/provider_connect.test.ts:711:      operator({ LOCAL_LLM_ENDPOINT: `${appliance.url}/v1`, NEXUS_OPENROUTER_BASE_URL: `${or.url}/api/v1` });\ncli/test/provider_connect.test.ts:731:        LOCAL_LLM_ENDPOINT: `${appliance.url}/v1`,\ncli/test/provider_connect.test.ts:751:      operator({ LOCAL_LLM_ENDPOINT: `${endpoint.url}/tenant-a/v1` });\ncli/test/provider_connect.test.ts:755:      operator({ LOCAL_LLM_ENDPOINT: `${endpoint.url}/tenant-b/v1` });\ncli/test/provider_connect.test.ts:820:    operator({ LOCAL_LLM_ENDPOINT: `${appliance.url}/v1`, NEXUS_ANTHROPIC_BASE_URL: `${anth.url}/v1` });\ncli/test/provider_connect.test.ts:868:    operator({ LOCAL_LLM_ENDPOINT: `${appliance.url}/v1` });\ncli/test/provider_connect.test.ts:894:      assert.equal(fs.readFileSync(path.join(home, \".config/nexus/config.env\"), \"utf8\").includes(\"LOCAL_LLM_MODEL=\\\"local/selected-model\\\"\"), true);\ncli/test/provider_connect.test.ts:911:    const previousConfig = 'LOCAL_LLM_ENDPOINT=\"http://127.0.0.1:9/v1\"\\nLOCAL_LLM_MODEL=\"previous-model\"\\n';\ncli/test/provider_connect.test.ts:967:    operator({ LOCAL_LLM_ENDPOINT: `${previous.url}/v1`, LOCAL_LLM_MODEL: \"previous-model\" });\ncli/test/provider_connect.test.ts:1012:    operator({ LOCAL_LLM_ENDPOINT: `${previous.url}/v1` });\ncli/test/provider_connect.test.ts:1054:    const previousConfig = 'LOCAL_LLM_ENDPOINT=\"http://127.0.0.1:9/v1\"\\nLOCAL_LLM_MODEL=\"previous-model\"\\n';\ncli/test/provider_connect.test.ts:1100:    operator({ LOCAL_LLM_ENDPOINT: `${oldEndpoint.url}/v1` });\n#!/usr/bin/env node\n// Runs evaluation tasks against an agent configuration and appends one JSON line per run (see eval/README.md).\n// Each run gets a fresh workspace (the task's repository at its pinned commit, or its fixture), the agent runs with the\n// task's budgets and a wall-clock timeout, then the task's hidden tests (never present while the agent runs) and its\n// regression command are run in that workspace. Nothing is scored here: eval/score.mjs reads the JSON lines.\nimport { spawnSync } from \"node:child_process\";\nimport { createHash, randomBytes } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { startModelProxy } from \"./model_proxy.mjs\";\nimport { asUserSpec, corpusManifestProblem, corpusTaskRows, fetchModelEntry, hiddenTestIsolationProblem, modelFingerprint, nexusLimitsProblem, qualificationBudgetProblem, runtimeCorpusOverlapProblem, taskTreeDigest, validateTask } from \"./validate.mjs\";\nimport { agentSandboxArgv, assertNoSymlinks, confinedPath, grantRunAsAccess, hiddenOutputHasTests, isolatedProcessArgv, normalizeRunAsPermissions, runIsolated, runIsolatedProcess, sandboxAvailable, stageHiddenFiles } from \"./isolate.mjs\";\nimport { runBlackBoxOracle } from \"./oracle.mjs\";\nimport { stageRepoWorkspace } from \"./workspace.mjs\";\nimport { applyAgentChanges, cloneWorkspace } from \"./hardened_check.mjs\";\nimport { containmentProblem, resourceProbeProblem, spawnContained } from \"./resources.mjs\";\nimport { StringDecoder } from \"node:string_decoder\";\nimport { commandBaseline, countCompactions, createT3Driver, scoreT3Run, steeringBaseline, steeringPrecondition, t3Snapshot } from \"./t3.mjs\";\nimport { observeT4Fixture } from \"./t4_fixtures.mjs\";\nimport { assertDatasetTaskDigest, loadDataset } from \"./dataset.mjs\";\nimport { createAgentLaunchPayload, serializeAgentLaunchPayload } from \"./runner_api.mjs\";\nimport { assertTaskSnapshotDigest } from \"./runner_integrity.mjs\";\nimport { captureWorkspaceSnapshot, runCodeEvaluators } from \"./evaluators/code/runner.mjs\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst args = parseArgs(process.argv.slice(2));\nif (args.out) args.out = path.resolve(args.out); // agents run elsewhere: paths handed to them must be absolute\nif (!args.config || !args.out || (args.dataset && (args.dataset === true || args.tasks)) || (Object.hasOwn(args, \"split\") && !args.dataset)) {\n  console.error(\"usage: eval/run.mjs --config eval/configs/<name>.json --out <dir> [--dataset eval/datasets/<name> [--split regression|benchmark] | --tasks eval/tasks] [--only id,id] [--runs N]\");\n  process.exit(2);\n}\nconst configBytes = fs.readFileSync(args.config);\nconst configSha256 = createHash(\"sha256\").update(configBytes).digest(\"hex\");\nconst config = JSON.parse(configBytes.toString(\"utf8\"));\nconst datasetRoot = args.dataset ? path.resolve(args.dataset) : null;\nconst only = args.only ? new Set(String(args.only).split(\",\")) : null;\nlet dataset = null;\ntry {\n  if (datasetRoot) dataset = loadDataset(datasetRoot, { split: args.split ?? null, only });\n} catch (error) {\n  console.error(`eval/run.mjs: dataset invalid: ${error.message}`);\n  process.exit(2);\n}\nconst tasksDir = dataset ? path.join(datasetRoot, \"tasks\") : path.resolve(args.tasks ?? path.join(ROOT, \"eval/tasks\"));\nfunction custodyCorpusPathsForRun() {\n  return [\n    config.corpusCustody?.reportPath,\n    config.corpusCustody?.storeRoot,\n    config.corpusCustody?.validatorPath,\n    config.corpusCustody?.referencePath,\n    config.corpusCustody?.authorLogPath,\n  ].filter(Boolean);\n}\nfunction protectedCorpusPathsForRun() {\n  const parent = path.dirname(tasksDir);\n  const evalDir = path.join(ROOT, \"eval\");\n  const includeParent = config.qualification === true || fs.realpathSync(parent) !== fs.realpathSync(evalDir);\n  return [tasksDir, ...(includeParent ? [parent] : []), ...custodyCorpusPathsForRun()];\n}\nconst runs = Number(args.runs ?? config.runs ?? 1);\n// --pairs \"task run,task run\": rerun exactly these (runs that failed on infrastructure; see eval/infra.mjs).\nconst pairs = args.pairs ? String(args.pairs).split(\",\").filter(Boolean).map((p) => p.trim().split(/\\s+/)) : null;\nfs.mkdirSync(path.dirname(args.out), { recursive: true });\ntry {\n  fs.mkdirSync(args.out, { mode: 0o700 });\n  fs.chmodSync(args.out, 0o700);\n} catch (error) {\n  if (error.code === \"EEXIST\") {\n    console.error(\"eval/run.mjs: output directory must be new; refusing to overwrite or append to prior evidence\");\n    process.exit(2);\n  }\n  throw error;\n}\nconst identity = harnessIdentity();\nconst availableTaskIds = dataset ? dataset.rows.map((row) => row.id).sort() : fs.readdirSync(tasksDir).filter((d) => {\n  const entry = path.join(tasksDir, d);\n  try { return fs.lstatSync(entry).isDirectory() && fs.existsSync(path.join(entry, \"task.json\")); }\n  catch { return false; }\n}).sort();\nconst tasks = availableTaskIds.filter((d) => !only || only.has(d));\nconst taskSnapshots = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-task-snapshot-\"));\nfs.chmodSync(taskSnapshots, 0o700);\nprocess.on(\"exit\", () => fs.rmSync(taskSnapshots, { recursive: true, force: true }));\nconst taskRecords = [];\nfor (const id of tasks) {\n  const datasetRow = dataset?.rows.find((row) => row.id === id);\n  const source = datasetRow?.dir ?? confinedPath(tasksDir, id);\n  let before;\n  if (datasetRow) {\n    assertDatasetTaskDigest(source, datasetRow.treeSha256, id);\n    before = datasetRow.treeSha256;\n  } else {\n    assertNoSymlinks(source);\n    before = taskTreeDigest(source);\n  }\n  const snapshot = path.join(taskSnapshots, id);\n  fs.cpSync(source, snapshot, { recursive: true, verbatimSymlinks: true });\n  if (datasetRow) assertDatasetTaskDigest(snapshot, datasetRow.treeSha256, id);\n  else if (taskTreeDigest(snapshot) !== before) throw new Error(`task ${id} changed while the runner froze its input`);\n  const taskFile = confinedPath(snapshot, \"task.json\");\n  const frozenTask = JSON.parse(fs.readFileSync(taskFile, \"utf8\"));\n  taskRecords.push({ id, dir: snapshot, treeSha256: before, task: datasetRow ? { ...datasetRow.task, dir: snapshot } : frozenTask, split: datasetRow?.split ?? null, versionedDataset: Boolean(datasetRow) });\n}\nif (config.qualification === true && only) {\n  console.error(\"eval/run.mjs: qualification task subsets are forbidden; use a frozen corpus run or an explicitly recorded infrastructure-pair rerun\");\n  process.exit(2);\n}\nif (config.qualification === true && config.proxy === false) {\n  console.error(\"eval/run.mjs: qualification requires the authenticated per-run model proxy\");\n  process.exit(2);\n}\nif (!sandboxAvailable()) {\n  console.error(\"eval/run.mjs: Bubblewrap unavailable; refusing to execute task-controlled setup and validators\");\n  process.exit(2);\n}\nconst apiKey = readApiKey(config.apiKey);\nconst caFile = config.caFile ? expandHome(config.caFile) : null;\nconst caBundle = caFile ? writeCaBundle(caFile) : null;\n\n// A run is valid only with well-formed tasks, hidden tests the agent cannot read, and (for qualification) a model\n// identified beyond its alias. Any problem stops the run before an agent starts (eval/validate.mjs).\nconst problems = taskRecords.flatMap(({ id, dir, task }) => {\n  return validateTask(task, dir, { qualification: config.qualification === true }).map((p) => `${id}: ${p}`);\n});\nconst isolation = hiddenTestIsolationProblem(config, tasksDir);\nif (isolation) problems.push(isolation);\n// Qualification proves the resource contract inside hiddenTestIsolationProblem; a development config may opt in.\nif (config.resources !== undefined && config.qualification !== true) {\n  const resourceProblem = resourceProbeProblem(config.resources);\n  if (resourceProblem) problems.push(resourceProblem);\n}\nif (config.resources !== undefined && args.keep) problems.push(\"--keep would accumulate run workspaces on the size-capped resources.workspaceRoot\");\nif (config.qualification === true) {\n  const corpusProblem = corpusManifestProblem(config, tasksDir, tasks, corpusTaskRows(taskSnapshots, tasks));\n  if (corpusProblem) problems.push(corpusProblem);\n}\nif (config.qualification === true && config.sampling?.temperature !== 0) {\n  problems.push(\"qualification adapters require sampling.temperature=0 so the matched Nexus, Goose and OpenCode runs use the same deterministic setting\");\n}\nif (config.qualification === true) {\n  const budgetProblem = qualificationBudgetProblem(config);\n  if (budgetProblem) problems.push(budgetProblem);\n}\nconst agentIdentity = problems.length ? { record: null, problem: null } : await resolveAgentIdentity(config);\nif (agentIdentity.problem) problems.push(agentIdentity.problem);\nlet fingerprint = null;\nif (!problems.length) {\n  const probe = config.proxy === false ? null : await startModelProxy({ upstream: config.endpoint, caFile });\n  try {\n    const entry = await fetchModelEntry(probe?.url ?? config.endpoint, config.model, apiKey);\n    const fp = modelFingerprint(config, entry);\n    fingerprint = fp.fingerprint;\n    problems.push(...fp.missing.map((m) => `model fingerprint: ${m}`));\n    if (config.qualification === true && (config.agent ?? \"nexus\") === \"nexus\") {\n      const limitsProblem = nexusLimitsProblem(config, entry);\n      if (limitsProblem) problems.push(limitsProblem);\n    }\n  } finally {\n    await probe?.close();\n  }\n}\nif (problems.length) {\n  console.error(`eval/run.mjs: not starting; ${problems.length} problem(s):\\n${problems.map((p) => `  - ${p}`).join(\"\\n\")}`);\n  process.exit(2);\n}\nconst resultsFile = path.join(args.out, \"results.jsonl\");\n// The scorer consumes this file even when the selected dataset split is empty.\nfs.writeFileSync(resultsFile, \"\", { flag: \"wx\" });\nconst frozenTaskRows = taskRecords.map(({ id }) => corpusTaskRows(taskSnapshots, [id])[0]);\nfs.writeFileSync(path.join(args.out, \"manifest.json\"), JSON.stringify({\n  createdAt: new Date().toISOString(),\n  harness: identity,\n  config: redactConfig(config),\n  configSha256,\n  dataset: dataset ? { name: dataset.manifest.name, version: dataset.manifest.version, split: args.split ?? null, manifestSha256: dataset.manifestSha256, taskIds: tasks } : null,\n  qualificationCorpus: config.qualification === true ? { manifestSha256: config.corpusManifestSha256, tasks: frozenTaskRows } : null,\n  fingerprint,\n  agentVersion: agentIdentity.record,\n  budget: effectiveBudget({}, config),\n  runs,\n  tasks: frozenTaskRows,\n  host: os.hostname(),\n  node: process.version,\n}, null, 2) + \"\\n\");\n\n// Run-major order (every task once, then again): a pass cut short still has the same number of runs per task.\nfor (let run = 1; run <= runs; run++) {\n  for (const { id, dir, treeSha256, task: taskData, versionedDataset } of taskRecords) {\n    if (pairs && !pairs.some(([t, r]) => t === id && Number(r) === run)) continue;\n    assertTaskSnapshotDigest({ dir, treeSha256, id, versionedDataset });\n    const task = { ...taskData, dir };\n    const record = await runOnce(task, run);\n    fs.appendFileSync(resultsFile, JSON.stringify(record) + \"\\n\");\n    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\n  }\n}\n\nasync function runOnce(task, run) {\n  // Under the resource contract these are on a tmpfs, so candidate writes count against the run's memory limit.\n  const scratch = config.resources?.workspaceRoot ?? os.tmpdir();\n  const ws = fs.mkdtempSync(path.join(scratch, `nexus-eval-${task.id}-`));\n  const checkDirs = [];\n  let typecheckBaselineWorkspace = null;\n  const home = fs.mkdtempSync(path.join(scratch, \"nexus-eval-home-\"));\n  const budget = effectiveBudget(task, config);\n  const base = { task: task.id, tier: task.tier, ...(task.tier === \"T3\" ? { t3SteeringItems: task.steering.length } : {}), config: config.name, agent: config.agent ?? \"nexus\", agentVersion: agentIdentity.record, budget, run, harness: identity.string, model: config.model, startedAt: new Date().toISOString() };\n  try {\n    await prepareWorkspace(task, ws);\n    const needsTypecheckBaseline = task.evaluators?.some((item) => {\n      const spec = typeof item === \"string\" ? { type: item } : item;\n      return spec?.type === \"typecheck_clean\" && !spec.baseline && !task.typecheck?.baseline;\n    });\n    if (needsTypecheckBaseline) {\n      typecheckBaselineWorkspace = fs.mkdtempSync(path.join(scratch, `nexus-eval-typecheck-baseline-${task.id}-`));\n      checkDirs.push(typecheckBaselineWorkspace);\n      cloneWorkspace(ws, typecheckBaselineWorkspace);\n    }\n    // Taken now, while .git is the harness's own: after the agent runs, nothing executes git against its workspace.\n    const baselineTree = gitRev(ws, \"HEAD^{tree}\");\n    const needsChangedFiles = task.evaluators?.some((item) => [\"syntax_ast\", \"diff_boundary\"].includes(typeof item === \"string\" ? item : item?.type));\n    const evaluatorBaseline = needsChangedFiles ? captureWorkspaceSnapshot(ws) : null;\n    const t3Baseline = task.tier === \"T3\" ? steeringBaseline(task, ws) : null;\n    // On the per-run task copy, so the steering hook in runAgent can read it. The commands run on a throwaway copy of\n    // the staged workspace, so the agent starts on exactly the staged tree.\n    const t3BaselineResources = [];\n    if (task.tier === \"T3\") {\n      const probe = fs.mkdtempSync(path.join(scratch, `nexus-eval-t3-baseline-${task.id}-`));\n      try {\n        fs.cpSync(ws, probe, { recursive: true, verbatimSymlinks: true });\n        task.t3CommandBaseline = await commandBaseline(task, (command) => runIsolated(command, { cwd: probe, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => {\n          if (r.resources) t3BaselineResources.push(r.resources);\n          const error = r.containmentProblem ?? (r.timedOut ? \"timed out\" : r.overflow ? \"output limit\" : r.status === null ? \"did not exit\" : null);\n          return { pass: r.status === 0 && !error, error };\n        }));\n      } finally {\n        fs.rmSync(probe, { recursive: true, force: true });\n      }\n    }\n#!/usr/bin/env node\n// Marks runs that failed on infrastructure (the agent never reached the model), so they are rerun rather than scored as\n// task failures. Runs recorded through the harness's model proxy are classified by what it observed, the same way for\n// every agent: the model never answered and the endpoint failed. A run whose model answered is always scored (a crash\n// is a failure, not a rerun). Older records fall back to each agent's own connection-failure message.\n// usage: eval/infra.mjs <out-dir-of-one-config>   → prints \"task run\" per infrastructure failure\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { isInfrastructureFailure } from \"./model_proxy.mjs\";\n\nconst SIGNATURES = {\n  goose: /Network error: Could not connect to/,\n  opencode: /Cannot connect to API: Unable to connect/,\n  aider: /litellm\\.(InternalServerError|APIConnectionError).*Connection\\s+error/s,\n  nexus: null,\n};\n/** Total time a Nexus run waited for an unavailable provider, from its JSON report. */\nfunction recoveryWaitMs(stdout) {\n  try {\n    const report = JSON.parse(stdout.slice(stdout.indexOf(\"{\"), stdout.lastIndexOf(\"}\") + 1));\n    return (report.turn?.providerRecovery ?? []).reduce((sum, r) => sum + (r.waitedMs ?? 0), 0);\n  } catch {\n    return 0;\n  }\n}\n\nconst dir = process.argv[2];\nlet legacy = 0;\nfor (const line of fs.readFileSync(path.join(dir, \"results.jsonl\"), \"utf8\").split(\"\\n\").filter(Boolean)) {\n  const r = JSON.parse(line);\n  let infra;\n  if (r.error || r.model) {\n    // Observed by the harness's model proxy: the same rule for every agent (REQ-QUAL-106).\n    infra = isInfrastructureFailure(r);\n  } else {\n    // Records from before the proxy: each agent's own failure message (Nexus: INFERENCE_FAILED or a long provider wait).\n    legacy++;\n    const logs = path.join(dir, r.logs ?? \"\");\n    const read = (f) => (fs.existsSync(path.join(logs, f)) ? fs.readFileSync(path.join(logs, f), \"utf8\") : \"\");\n    const text = [read(\"agent.stdout.json\"), read(\"agent.stderr.log\")].join(\"\\n\");\n    infra = r.agent === \"nexus\"\n      ? r.turn?.reason === \"INFERENCE_FAILED\" || recoveryWaitMs(read(\"agent.stdout.json\")) > 60_000\n      : SIGNATURES[r.agent]?.test(text) && !r.hiddenPass;\n  }\n  if (infra) console.log(`${r.task} ${r.run}`);\n}\nif (legacy) console.error(`infra: ${legacy} record(s) predate the model proxy; classified by agent failure messages`);\n","exit_code":0,"duration":{"secs":1,"nanos":6762443}},"started_at_ms":1793733697137,"completed_at_ms":1793733698145}}
