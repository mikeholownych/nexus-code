{"timestamp":"2026-11-23T01:09:47.921Z","ordinal":68972,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a205e5-07d1-72b3-b0a4-db59d82d43bb","item":{"type":"FileChange","id":"exec-15c5d0c9-5199-452c-8786-6680ad1f9666","changes":{"/home/mike/nexus-wt/context-maturity-v130/cli/src/knowledge.ts":{"type":"update","unified_diff":"@@ -94,2 +94,6 @@\n       const protectedData = redactForPersistence(data);\n+      const storedVersion = (protectedData as any)?.version;\n+      if (typeof storedVersion !== \"number\" || storedVersion < 1 || storedVersion > 2) {\n+        throw new Error(\"Unsupported knowledge graph schema version\");\n+      }\n       const safeSerialized = JSON.stringify(protectedData, null, 2);\n@@ -102,2 +106,8 @@\n           if (entry.key && entry.value) {\n+            const provenanceValid = entry.provenance?.source === \"operator_entry\" && Array.isArray(entry.provenance.sourceRefs);\n+            const retention = entry.retention === undefined\n+              ? { policy: \"until_deleted\" as const }\n+              : validRetention(entry.retention)\n+                ? entry.retention\n+                : { policy: \"expires_at\" as const, expiresAt: \"1970-01-01T00:00:00.000Z\" };\n             const normalized: KnowledgeEntry = {\n@@ -105,3 +115,3 @@\n               scope: \"repository\",\n-              provenance: entry.provenance && entry.provenance.source === \"operator_entry\"\n+              provenance: provenanceValid\n                 ? { source: \"operator_entry\", sourceRefs: Array.isArray(entry.provenance.sourceRefs) ? entry.provenance.sourceRefs.filter((ref: unknown) => typeof ref === \"string\").slice(0, 100) : [] }\n@@ -109,5 +119,5 @@\n               validationStatus: entry.validationStatus === \"operator_reviewed_unverified\" ? \"operator_reviewed_unverified\" : \"legacy_unverified\",\n-              retention: validRetention(entry.retention) ? entry.retention : { policy: \"until_deleted\" },\n+              retention,\n             };\n-            if (!entry.scope || !entry.provenance || !entry.validationStatus || !entry.retention) migrated = true;\n+            if (entry.scope !== \"repository\" || !provenanceValid || !entry.validationStatus || !validRetention(entry.retention)) migrated = true;\n             this.entries.set(normalized.key, normalized);\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /home/mike/nexus-wt/context-maturity-v130/cli/src/knowledge.ts\n","stderr":""},"started_at_ms":1795396187919,"completed_at_ms":1795396187920}}
