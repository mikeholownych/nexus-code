{"timestamp":"2026-11-03T20:04:37.284Z","ordinal":80260,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"McpToolCall","id":"exec-e489422a-f959-489c-a31d-68fabe6e5eed","server":"xerj","tool":"xerj_search","arguments":{"prefix":"wp1107-vllm","query":"ChatCompletionRequest tool_choice required structured_outputs JSON grammar validation","size":5,"max_tokens":2500},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body`, `text` are `semantic_text`, but this query scored them with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /wp1107-vllm-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"ChatCompletionRequest tool_choice required structured_outputs JSON grammar validation\",\"k\":10}}}}}]},\"took\":126,\"timed_out\":false,\"_shards\":{\"total\":1,\"successful\":1,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":139,\"relation\":\"eq\"},\"max_score\":105.062836,\"hits\":[{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"3f424f28fdb48d5d36b83bc38553fdc8\",\"_score\":105.062836,\"_source\":{\"title\":\"protocol.py\",\"ax_path\":\"vllm/entrypoints/openai/chat_completion/protocol.py\",\"ax_file\":\"axf2-dd2a7d79bec66e262e311cb6cec4b8a8-cc0e\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":599,\"start_offset\":23498,\"end_offset\":25546,\"text\":\"            reasoning_content = msg.pop(\\\"reasoning_content\\\", None)\\n            if reasoning_content is not None and msg.get(\\\"reasoning\\\") is None:\\n                msg[\\\"reasoning\\\"] = reasoning_content\\n        return data\\n\\n    @model_validator(mode=\\\"after\\\")\\n    def _materialize_tool_calls_after(self) -> \\\"ChatCompletionRequest\\\":\\n        \\\"\\\"\\\"Convert Pydantic ValidatorIterator wrappers back to lists.\\n\\n        Even after the \\\"before\\\" validator converts iterables to lists,\\n        Pydantic re-wraps them in a ValidatorIterator when validating\\n        against ChatCompletionAssistantMessageParam's Iterable[...] type.\\n        This \\\"after\\\" pass materialises those wrappers so downstream code\\n        (tokenizers, model_dump_json) always sees plain lists.\\n        \\\"\\\"\\\"\\n        for msg in self.messages:\\n            if not isinstance(msg, dict):\\n                continue\\n            tool_calls = msg.get(\\\"tool_calls\\\")\\n            if tool_calls is not None and not isinstance(tool_calls, list):\\n                msg[\\\"tool_calls\\\"] = list(tool_calls)\\n        return self\\n\\n    _grammar_from_parser: bool = PrivateAttr(default=False)\\n    \\\"\\\"\\\"CAUTION: Should only be set by the parser-engine adapter's adjust_request.\\\"\\\"\\\"\\n\\n    def resolve_reasoning_ended(\\n        self, parser: \\\"Parser | None\\\", prompt_token_ids: list[int]\\n    ) -> bool | None:\\n        \\\"\\\"\\\"Resolve the engine's `reasoning_ended` for structured outputs.\\n\\n        Call after `adjust_request`, which may set `_grammar_from_parser`.\\n        `True` constrains from the first generated token; `None` lets the\\n        engine check the prompt with its own reasoning parser.\\n        \\\"\\\"\\\"\\n        if not self.include_reasoning:\\n            return True\\n        if self._grammar_from_parser:\\n            # The Mistral grammar already includes an optional `think?`\\n            # rule that handles both reasoning and non-reasoning outputs.\\n            return True\\n        if parser is not None and parser.reasoning_parser is not None:\\n            return parser.is_reasoning_end(prompt_token_ids)\\n        return None\"}]},\"match_line\":606,\"match_lines\":[606,638]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"0d8c6a078a62f0de0f8dca11d8e0f884\",\"_score\":45.090595,\"_source\":{\"title\":\"protocol.py\",\"ax_path\":\"vllm/entrypoints/openai/responses/protocol.py\",\"ax_file\":\"axf2-195f0982d65a65cf4d9d7efbebbf7469-a3e1\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":836,\"start_offset\":31316,\"end_offset\":32310,\"text\":\"@model_validator(mode=\\\"before\\\")\\n    @classmethod\\n    def check_custom_tool_format(cls, data):\\n        if not isinstance(data, dict):\\n            return data\\n        tools = data.get(\\\"tools\\\")\\n        if not isinstance(tools, list):\\n            return data\\n        for tool in tools:\\n            if isinstance(tool, dict):\\n                tool_dict = tool\\n            elif hasattr(tool, \\\"model_dump\\\"):\\n                tool_dict = tool.model_dump()\\n            else:\\n                continue\\n            tool_format = tool_dict.get(\\\"format\\\")\\n            if (\\n                tool_dict.get(\\\"type\\\") == \\\"custom\\\"\\n                and isinstance(tool_format, dict)\\n                and tool_format.get(\\\"type\\\") == \\\"grammar\\\"\\n            ):\\n                raise VLLMValidationError(\\n                    \\\"Custom tools with a grammar format are not supported; \\\"\\n                    \\\"only free-form text custom tools are accepted.\\\",\\n                    parameter=\\\"tools\\\",\\n                )\\n        return data\"}]},\"match_line\":856,\"match_lines\":[856,859]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"ccf0860265ea8b42671be15446da628a\",\"_score\":44.37419,\"_source\":{\"title\":\"sampling_params.py\",\"ax_path\":\"vllm/sampling_params.py\",\"ax_file\":\"axf2-254afc553bad202a73eafa29b6eeb6e5-1079e\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":213,\"start_offset\":7367,\"end_offset\":9382,\"text\":\"    FINAL_ONLY = 2\\n\\n\\ndef _exceeds_json_nesting(spec: str | dict[str, Any], limit: int) -> bool:\\n    \\\"\\\"\\\"Whether a JSON document nests objects and arrays deeper than `limit`.\\\"\\\"\\\"\\n    if isinstance(spec, str):\\n        try:\\n            spec = json_mod.loads(spec)\\n        except RecursionError:\\n            return True\\n        except ValueError:\\n            # Malformed JSON is reported by the backend validation.\\n            return False\\n\\n    level: list[Any] = [spec]\\n    for _ in range(limit):\\n        level = [\\n            child\\n            for node in level\\n            if isinstance(node, (dict, list))\\n            for child in (node.values() if isinstance(node, dict) else node)\\n            if isinstance(child, (dict, list))\\n        ]\\n        if not level:\\n            return False\\n    return True\\n\\n\\ndef check_json_nesting(\\n    spec: str | dict[str, Any] | None, *, structural_tag: bool = False\\n) -> None:\\n    \\\"\\\"\\\"Reject a JSON schema nested more than `MAX_STRUCTURED_OUTPUT_JSON_NESTING`\\n    levels deep, or a structural tag nested deeper than that plus\\n    `STRUCTURAL_TAG_WRAPPER_NESTING`.\\n\\n    Raises:\\n        VLLMValidationError: If `spec` is nested too deeply.\\n\\n    \\\"\\\"\\\"\\n    limit = MAX_STRUCTURED_OUTPUT_JSON_NESTING\\n    if structural_tag:\\n        limit += STRUCTURAL_TAG_WRAPPER_NESTING\\n    if spec and _exceeds_json_nesting(spec, limit):\\n        raise VLLMValidationError(\\n            \\\"The JSON schema is nested too deeply: objects and arrays may nest at \\\"\\n            f\\\"most {MAX_STRUCTURED_OUTPUT_JSON_NESTING} levels\\\"\\n        )\\n\\n\\ndef _is_non_tekken_mistral(tokenizer: TokenizerLike) -> bool:\\n    return is_mistral_tokenizer(tokenizer) and not tokenizer.is_tekken\\n\\n\\ndef _get_llg_tokenizer(tokenizer: TokenizerLike) -> Any:\\n    return tokenizer.llg_tokenizer if is_mistral_tokenizer(tokenizer) else None\\n\\n\\nclass SamplingParams(\\n    PydanticMsgspecMixin,\\n    msgspec.Struct,\\n    omit_defaults=True,  # type: ignore[call-arg]\\n    # required for @cached_property.\\n    dict=True,\\n):  # type: ignore[call-arg]\"}]},\"match_line\":225,\"match_lines\":[218,225,245,258,275]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"678e922b63dd129bf05b318ca93e3d21\",\"_score\":14.180765,\"_source\":{\"title\":\"ChatCompletionRequest\",\"ax_path\":\"vllm/entrypoints/openai/chat_completion/protocol.py\",\"ax_file\":\"axf2-dd2a7d79bec66e262e311cb6cec4b8a8-cc0e\",\"ax_locator\":\"code:237:ChatCompletionRequest\",\"language\":\"python\",\"path\":\"protocol.py\",\"kind\":\"class\",\"line\":237,\"code\":\"class ChatCompletionRequest(OpenAIBaseModel):\\n    # Ordered by official OpenAI API documentation\\n    # https://platform.openai.com/docs/api-reference/chat/create\"},\"fields\":{\"_passage\":[{\"field\":\"code\",\"ordinal\":0,\"start_offset\":0,\"end_offset\":161,\"text\":\"class ChatCompletionRequest(OpenAIBaseModel):\\n    # Ordered by official OpenAI API documentation\\n    # https://platform.openai.com/docs/api-reference/chat/create\"}]},\"match_line\":237,\"match_lines\":[237]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"58bf41e28c09d3eaacaf17879cd78e2a\",\"_score\":13.692471,\"_source\":{\"title\":\"message_assembly.py\",\"ax_path\":\"vllm/entrypoints/openai/chat_completion/message_assembly.py\",\"ax_file\":\"axf2-70b94262e2190efbca0af94b90b06e34-eed\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":64,\"start_offset\":2113,\"end_offset\":3341,\"text\":\"def keeps_tool_calls(\\n    request: ChatCompletionRequest,\\n    *,\\n    enable_auto_tools: bool,\\n    parser_cls: type[Parser] | None,\\n) -> bool:\\n    \\\"\\\"\\\"Whether a chat choice returns the tool calls its parser extracts.\\n\\n    Shared by the non-streaming and streaming chat paths so both apply\\n    `tool_choice` the same way. Parsers don't all gate on it themselves:\\n    `HarmonyParser` ignores `\\\"none\\\"` and `null` is parsed like `\\\"auto\\\"`.\\n\\n    Args:\\n        request: Supplies `tools` and `tool_choice`.\\n        enable_auto_tools: The server's `--enable-auto-tool-choice`.\\n        parser_cls: The server's parser class, if any.\\n\\n    Returns:\\n        True for `\\\"required\\\"`, a named tool, or `\\\"auto\\\"` with tools and auto\\n        tool choice enabled.\\n\\n    \\\"\\\"\\\"\\n    if _forces_tool_calls(request):\\n        return True\\n    auto_tools = (\\n        enable_auto_tools\\n        and parser_cls is not None\\n        and parser_cls.tool_parser_cls is not None\\n    )\\n    if not auto_tools or request.tool_choice != \\\"auto\\\":\\n        return False\\n    if not request.tools:\\n        logger.error(\\n            \\\"Cannot determine if tools should be extracted. \\\"\\n            \\\"Returning a standard chat completion.\\\"\\n        )\\n        return False\\n    return True\"}]},\"match_line\":66,\"match_lines\":[66,74,78,83,94]}]}}"}],"isError":false},"duration":{"secs":0,"nanos":192426241}},"started_at_ms":1793736277091,"completed_at_ms":1793736277283}}
{"timestamp":"2026-11-03T20:04:39.266Z","ordinal":80261,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"McpToolCall","id":"exec-ebb82c40-ab56-4730-b158-b00f4a1674ba","server":"xerj","tool":"xerj_search","arguments":{"prefix":"wp1107-vllm","query":"strict tool calling function parameter schema enforce strict tool calling structured output","size":5,"max_tokens":2500},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body`, `text` are `semantic_text`, but this query scored them with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /wp1107-vllm-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"strict tool calling function parameter schema enforce structured output\",\"k\":10}}}}}]},\"took\":573,\"timed_out\":false,\"_shards\":{\"total\":1,\"successful\":1,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":186,\"relation\":\"eq\"},\"max_score\":95.06064,\"hits\":[{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"e517c4f75ed83d22efbc751bbf62cf09\",\"_score\":95.06064,\"_source\":{\"title\":\"envs.py\",\"ax_path\":\"vllm/envs.py\",\"ax_file\":\"axf2-a2916a3078f8d7b850eb9c99a42f61b7-1ea88\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":1891,\"start_offset\":90325,\"end_offset\":92364,\"text\":\"    \\\"VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE\\\": lambda: int(\\n        os.getenv(\\\"VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE\\\", str(394 * 1024 * 1024))\\n    ),\\n    # Transmit MoE all-to-all combine (expert-output) payloads in FP8 instead\\n    # of BF16, halving NVLink traffic on the combine leg. Only takes effect\\n    # when the installed FlashInfer MoeAlltoAll kernel supports it.\\n    \\\"VLLM_FLASHINFER_MOE_A2A_LOW_PRECISION_COMBINE\\\": lambda: bool(\\n        int(os.getenv(\\\"VLLM_FLASHINFER_MOE_A2A_LOW_PRECISION_COMBINE\\\", \\\"0\\\"))\\n    ),\\n    # Control the maximum number of tokens per expert supported by the\\n    # NVFP4 MoE CUTLASS Kernel. This value is used to create a buffer for\\n    # the blockscale tensor of activations NVFP4 Quantization.\\n    # This is used to prevent the kernel from running out of memory.\\n    \\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\": lambda: int(\\n        os.getenv(\\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\", \\\"163840\\\")\\n    ),\\n    # MoE routing strategy selector.\\n    # See `RoutingSimulator.get_available_strategies()` # for available\\n    # strategies.\\n    # Custom routing strategies can be registered by\\n    # RoutingSimulator.register_strategy()\\n    # Note: custom strategies may not produce correct model outputs\\n    \\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\": lambda: os.environ.get(\\n        \\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\", \\\"\\\"\\n    ).lower(),\\n    # Regex timeout for use by the vLLM tool parsing plugins.\\n    \\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\": lambda: int(\\n        os.getenv(\\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\", \\\"1\\\")\\n    ),\\n    # Enforce function parameter schemas in structural-tag based tool calling.\\n    \\\"VLLM_ENFORCE_STRICT_TOOL_CALLING\\\": lambda: (\\n        os.getenv(\\\"VLLM_ENFORCE_STRICT_TOOL_CALLING\\\", \\\"True\\\").lower() in (\\\"true\\\", \\\"1\\\")\\n    ),\\n    # Constrain every `beam` output to its response template's format, also\\n    # without tool or structured output constraints.\\n    \\\"VLLM_BEAM_ALWAYS_CONSTRAIN_OUTPUT\\\": lambda: (\\n        os.getenv(\\\"VLLM_BEAM_ALWAYS_CONSTRAIN_OUTPUT\\\", \\\"True\\\").lower() in (\\\"true\\\", \\\"1\\\")\\n    ),\"}]},\"match_line\":1921,\"match_lines\":[1895,1917,1921,1925,1926]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"ccf0860265ea8b42671be15446da628a\",\"_score\":49.826385,\"_source\":{\"title\":\"sampling_params.py\",\"ax_path\":\"vllm/sampling_params.py\",\"ax_file\":\"axf2-254afc553bad202a73eafa29b6eeb6e5-1079e\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":0,\"start_offset\":0,\"end_offset\":2041,\"text\":\"# SPDX-License-Identifier: Apache-2.0\\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\\n\\\"\\\"\\\"Sampling parameters for text generation.\\\"\\\"\\\"\\n\\nimport copy\\nimport json as json_mod\\nimport math\\nfrom dataclasses import field\\nfrom enum import Enum, IntEnum\\nfrom functools import cached_property\\nfrom typing import TYPE_CHECKING, Annotated, Any\\n\\nimport msgspec\\nimport numpy as np\\nfrom pydantic import BeforeValidator, GetPydanticSchema, StrictInt\\nfrom pydantic.dataclasses import dataclass\\n\\nimport vllm.envs as envs\\nfrom vllm.config import ModelConfig, SpeculativeConfig, StructuredOutputsConfig\\nfrom vllm.exceptions import VLLMValidationError\\nfrom vllm.logger import init_logger\\nfrom vllm.tokenizers import TokenizerLike\\nfrom vllm.utils.mistral import is_mistral_tokenizer\\nfrom vllm.utils.torch_utils import make_ndarray_with_pad\\nfrom vllm.v1.serial_utils import PydanticMsgspecMixin\\n\\nif TYPE_CHECKING:\\n    from vllm.config import VllmConfig\\n\\nlogger = init_logger(__name__)\\n\\n_SAMPLING_EPS = 1e-5\\n_MAX_TEMP = 1e-2\\n\\nMAX_LOGPROB_TOKEN_IDS = 128\\n\\\"\\\"\\\"Upper bound on `SamplingParams.logprob_token_ids` list length. Must match\\nthe per-request row width allocated by the sampler's `LogprobTokenIdsState`.\\\"\\\"\\\"\\n\\nMAX_STRUCTURED_OUTPUT_JSON_NESTING = 64\\n\\\"\\\"\\\"Upper bound on nested objects and arrays in a structured-output JSON schema\\nor structural tag. Grammar conversion runs on the API server and its cost grows\\nsteeply with nesting. OpenAI allows 10 levels of schema nesting.\\\"\\\"\\\"\\n\\nSTRUCTURAL_TAG_WRAPPER_NESTING = 16\\n\\\"\\\"\\\"Extra nesting allowed for a structural tag, which wraps its JSON schemas in\\ntag structure (up to 15 levels for tool-call tags generated by tool parsers).\\\"\\\"\\\"\\n\\n\\ndef _verify_num_sequences(value: int, parameter_name: str) -> None:\\n    if not isinstance(value, int):\\n        raise VLLMValidationError(\\n            f\\\"{parameter_name} must be an int, but is of type {type(value)}\\\"\\n        )\\n    if value < 1:\\n        raise VLLMValidationError(f\\\"{parameter_name} must be at least 1, got {value}.\\\")\\n    max_n = envs.VLLM_MAX_N_SEQUENCES\"}]},\"match_line\":40,\"match_lines\":[40,42,46]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"3f424f28fdb48d5d36b83bc38553fdc8\",\"_score\":39.516697,\"_source\":{\"title\":\"protocol.py\",\"ax_path\":\"vllm/entrypoints/openai/chat_completion/protocol.py\",\"ax_file\":\"axf2-dd2a7d79bec66e262e311cb6cec4b8a8-cc0e\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":826,\"start_offset\":33255,\"end_offset\":34361,\"text\":\"@model_validator(mode=\\\"before\\\")\\n    @classmethod\\n    def validate_response_format(cls, data):\\n        if not isinstance(data, dict):\\n            return data\\n        response_format = data.get(\\\"response_format\\\")\\n        if response_format is None:\\n            return data\\n\\n        rf_type = (\\n            response_format.get(\\\"type\\\")\\n            if isinstance(response_format, dict)\\n            else getattr(response_format, \\\"type\\\", None)\\n        )\\n\\n        if rf_type == \\\"json_schema\\\":\\n            json_schema = (\\n                response_format.get(\\\"json_schema\\\")\\n                if isinstance(response_format, dict)\\n                else getattr(response_format, \\\"json_schema\\\", None)\\n            )\\n            if json_schema is None:\\n                raise VLLMValidationError(\\n                    \\\"When response_format type is 'json_schema', the \\\"\\n                    \\\"'json_schema' field must be provided.\\\",\\n                    parameter=\\\"response_format\\\",\\n                )\\n\\n        if rf_type == \\\"structural_tag\\\":\\n            validate_structural_tag_response_format(response_format)\\n\\n        return data\"}]},\"match_line\":852,\"match_lines\":[852]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"45e5eb0389b81e8739d0afbd54a16209\",\"_score\":37.794834,\"_source\":{\"title\":\"_aiter_ops.py\",\"ax_path\":\"vllm/_aiter_ops.py\",\"ax_file\":\"axf2-b00900bb0beb66415e8179e281d1f13f-2b235\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":2132,\"start_offset\":64440,\"end_offset\":65731,\"text\":\"def _flat_sigmoid_bias_topk_is_profitable(\\n    gating_output: \\\"torch.Tensor\\\",\\n    correction_bias: \\\"torch.Tensor\\\",\\n    topk_weights: \\\"torch.Tensor\\\",\\n    topk_ids: \\\"torch.Tensor\\\",\\n    num_expert_group: int,\\n    topk_group: int,\\n) -> bool:\\n    \\\"\\\"\\\"Replace the grouped kernel with a register-resident Triton top-k when\\n    the grouping eliminates nothing and the call is being captured into a\\n    CUDA graph.\\n\\n    The Triton kernel wins on device time under graph replay but loses eagerly,\\n    where it is a Triton launch from Python against a single C++ dispatch --\\n    measured at -1.8% to -3.5% end-to-end throughput with --enforce-eager.\\n    Stream capture is the test because it holds for every graph vLLM records,\\n    FULL and PIECEWISE, under either model runner, while the forward context's\\n    cudagraph_runtime_mode reads NONE during the V2 model runner's FULL capture.\\n    \\\"\\\"\\\"\\n    from vllm.model_executor.layers.fused_moe.router.rocm_sigmoid_bias_flat_topk import (  # noqa: E501\\n        can_use_sigmoid_bias_flat_topk,\\n    )\\n\\n    if not torch.cuda.is_current_stream_capturing():\\n        return False\\n    return can_use_sigmoid_bias_flat_topk(\\n        gating_output,\\n        correction_bias,\\n        topk_weights,\\n        topk_ids,\\n        num_expert_group,\\n        topk_group,\\n    )\"}]},\"match_line\":2147,\"match_lines\":[2147]},{\"_index\":\"wp1107-vllm-docs\",\"_id\":\"0d8c6a078a62f0de0f8dca11d8e0f884\",\"_score\":37.50067,\"_source\":{\"title\":\"protocol.py\",\"ax_path\":\"vllm/entrypoints/openai/responses/protocol.py\",\"ax_file\":\"axf2-195f0982d65a65cf4d9d7efbebbf7469-a3e1\",\"ax_locator\":\"code\",\"language\":\"python\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":550,\"start_offset\":19637,\"end_offset\":20802,\"text\":\"def extract_structured_outputs(self) -> StructuredOutputsParams | None:\\n        \\\"\\\"\\\"Normalize request constraints into ``StructuredOutputsParams``.\\\"\\\"\\\"\\n        if self._parser_structured_outputs is not None:\\n            return self._parser_structured_outputs\\n        if self.text is None or self.text.format is None:\\n            return self.structured_outputs\\n\\n        if self.structured_outputs is not None:\\n            raise VLLMValidationError(\\n                \\\"Cannot specify both structured_outputs and text.format\\\",\\n                parameter=\\\"structured_outputs\\\",\\n            )\\n\\n        response_format = self.text.format\\n        if response_format.type == \\\"json_object\\\":\\n            return StructuredOutputsParams(json_object=True)\\n        if (\\n            response_format.type == \\\"json_schema\\\"\\n            and response_format.schema_ is not None\\n        ):\\n            return StructuredOutputsParams(\\n                json=response_format.schema_  # type: ignore[call-arg]\\n                # --follow-imports skip hides the class definition but also hides\\n                # multiple third party conflicts, so best of both evils\\n            )\\n        return None\"}]},\"match_line\":561,\"match_lines\":[561]}]}}"}],"isError":false},"duration":{"secs":0,"nanos":698612364}},"started_at_ms":1793736278567,"completed_at_ms":1793736279266}}
