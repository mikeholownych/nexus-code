\\\n    # This is used to prevent the kernel from running out of memory.\\\\n    \\\\\\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\\\\\": lambda: int(\\\\n        os.getenv(\\\\\\\"VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE\\\\\\\", \\\\\\\"163840\\\\\\\")\\\\n    ),\\\\n    # MoE routing strategy selector.\\\\n    # See `RoutingSimulator.get_available_strategies()` # for available\\\\n    # strategies.\\\\n    # Custom routing strategies can be registered by\\\\n    # RoutingSimulator.register_strategy()\\\\n    # Note: custom strategies may not produce correct model outputs\\\\n    \\\\\\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\\\\\": lambda: os.environ.get(\\\\n        \\\\\\\"VLLM_MOE_ROUTING_SIMULATION_STRATEGY\\\\\\\", \\\\\\\"\\\\\\\"\\\\n    ).lower(),\\\\n    # Regex timeout for use by the vLLM tool parsing plugins.\\\\n    \\\\\\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\\\\\": lambda: int(\\\\n        os.getenv(\\\\\\\"VLLM_TOOL_PARSE_REGEX_TIMEOUT_SECONDS\\\\\\\", \\\\\\\"1\\\\\\\")\\\\n    ),\\\\n    # Enforce function parameter schemas in structural-tag based tool calling.\\\\n    \\\\\\\"VLLM_ENFORCE_STRICT_TOOL_CALLING\\\\\\\": lambda: (\\\\n        os.ge"},{"type":"input_text","text":"Q1 {\"content\":[{\"type\":\"text\",\"text\":\"{\\\"_xerj\\\":{\\\"hints\\\":[{\\\"code\\\":\\\"lexical_on_semantic_text\\\",\\\"reason\\\":\\\"`body`, `text` are `semantic_text`, but this query scored them with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\\\",\\\"try\\\":{\\\"request\\\":\\\"POST /wp1107-vllm-*/_search\\\",\\\"body\\\":{\\\"query\\\":{\\\"semantic\\\":{\\\"field\\\":\\\"body\\\",\\\"query\\\":\\\"check_structured_outputs_count structured_outputs tool_choice only either use structured outputs tools\\\",\\\"k\\\":10}}}}}]},\\\"took\\\":203,\\\"timed_out\\\":false,\\\"_shards\\\":{\\\"total\\\":1,\\\"successful\\\":1,\\\"skipped\\\":0,\\\"failed\\\":0},\\\"hits\\\":{\\\"total\\\":{\\\"value\\\":256,\\\"relation\\\":\\\"eq\\\"},\\\"max_score\\\":104.715744,\\\"hits\\\":[{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"3f424f28fdb48d5d36b83bc38553fdc8\\\",\\\"_score\\\":104.715744,\\\"_source\\\":{\\\"title\\\":\\\"protocol.py\\\",\\\"ax_path\\\":\\\"vllm/entrypoints/openai/chat_completion/protocol.py\\\",\\\"ax_file\\\":\\\"axf2-dd2a7d79bec66e262e311cb6cec4b8a8-cc0e\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":930,\\\"start_offset\\\":37396,\\\"end_offset\\\":39030,\\\"text\\\":\\\"@model_validator(mode=\\\\\\\"before\\\\\\\")\\\\n    @classmethod\\\\n    def check_structured_outputs_count(cls, data):\\\\n        if isinstance(data, ValueError):\\\\n            raise data\\\\n        if not isinstance(data, dict):\\\\n            return data\\\\n\\\\n        if data.get(\\\\\\\"structured_outputs\\\\\\\", None) is None:\\\\n            return data\\\\n\\\\n        structured_outputs_kwargs = data[\\\\\\\"structured_outputs\\\\\\\"]\\\\n        # structured_outputs may arrive as a dict (from JSON/raw kwargs) or\\\\n        # as a StructuredOutputsParams dataclass instance.\\\\n        is_dataclass = isinstance(structured_outputs_kwargs, StructuredOutputsParams)\\\\n        count = sum(\\\\n            (\\\\n                getattr(structured_outputs_kwargs, k, None)\\\\n                if is_dataclass\\\\n                else structured_outputs_kwargs.get(k)\\\\n            )\\\\n            is not None\\\\n            for k in (\\\\\\\"json\\\\\\\", \\\\\\\"regex\\\\\\\", \\\\\\\"choice\\\\\\\")\\\\n        )\\\\n        # you can only use one kind of constraints for structured outputs\\\\n        if count > 1:\\\\n            raise VLLMValidationError(\\\\n                \\\\\\\"You can only use one kind of constraints for structured \\\\\\\"\\\\n                \\\\\\\"outputs ('json', 'regex' or 'choice').\\\\\\\",\\\\n            )\\\\n        # you can only either use structured outputs or tools, not both\\\\n        if count > 0 and data.get(\\\\\\\"tool_choice\\\\\\\", \\\\\\\"none\\\\\\\") not in (\\\\n            \\\\\\\"none\\\\\\\",\\\\n            \\\\\\\"auto\\\\\\\",\\\\n            \\\\\\\"required\\\\\\\",\\\\n        ):\\\\n            raise VLLMValidationError(\\\\n                \\\\\\\"You can only either use constraints for structured outputs \\\\\\\"\\\\n                \\\\\\\"or tools, not both.\\\\\\\",\\\\n            )\\\\n        validate_structured_outputs_structural_tag(structured_outputs_kwargs)\\\\n        return data\\\"}]},\\\"match_line\\\":961,\\\"match_lines\\\":[933,939,955,958,961,962,968,969]},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"f2227b15e2c93beb15fb109e90d6ebf9\\\",\\\"_score\\\":53.99078,\\\"_source\\\":{\\\"title\\\":\\\"protocol.py\\\",\\\"ax_path\\\":\\\"vllm/entrypoints/openai/completion/protocol.py\\\",\\\"ax_file\\\":\\\"axf2-85c05192e2b0e30a367d7bb961409b78-73ed\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":611,\\\"start_offset\\\":23689,\\\"end_offset\\\":24404,\\\"text\\\":\\\"@model_validator(mode=\\\\\\\"before\\\\\\\")\\\\n    @classmethod\\\\n    def validate_prompt_and_prompt_embeds(cls, data):\\\\n        if not isinstance(data, dict):\\\\n            return data\\\\n        prompt = data.get(\\\\\\\"prompt\\\\\\\")\\\\n        prompt_embeds = data.get(\\\\\\\"prompt_embeds\\\\\\\")\\\\n\\\\n        prompt_is_empty = prompt is None or (isinstance(prompt, str) and prompt == \\\\\\\"\\\\\\\")\\\\n        embeds_is_empty = prompt_embeds is None or (\\\\n            isinstance(prompt_embeds, list) and len(prompt_embeds) == 0\\\\n        )\\\\n\\\\n        if prompt_is_empty and embeds_is_empty:\\\\n            raise VLLMValidationError(\\\\n                \\\\\\\"Either prompt or prompt_embeds must be provided and non-empty.\\\\\\\",\\\\n                parameter=\\\\\\\"prompt\\\\\\\",\\\\n            )\\\\n\\\\n        return data\\\"}]},\\\"match_line\\\":627,\\\"match_lines\\\":[627]},{\\\"_index\\\":\\\"wp1107-vllm-docs\\\",\\\"_id\\\":\\\"0d8c6a078a62f0de0f8dca11d8e0f884\\\",\\\"_score\\\":40.24453,\\\"_source\\\":{\\\"title\\\":\\\"protocol.py\\\",\\\"ax_path\\\":\\\"vllm/entrypoints/openai/responses/protocol.py\\\",\\\"ax_file\\\":\\\"axf2-195f0982d65a65cf4d9d7efbebbf7469-a3e1\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"python\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":523,\\\"start_offset\\\":18679,\\\"end_offset\\\":20696,\\\"text\\\":\\\"            tool_choice=self.tool_choice if self.tools else None,\\\\n        )\\\\n\\\\n    def build_tok_params(self, model_config: ModelConfig) -> TokenizeParams:\\\\n        return TokenizeParams(\\\\n            max_total_tokens=model_config.max_model_len,\\\\n            max_output_tokens=self.max_output_tokens,\\\\n            truncate_prompt_tokens=-1 if self.truncation != \\\\\\\"disabled\\\\\\\" else None,\\\\n            max_total_tokens_param=\\\\\\\"max_model_len\\\\\\\",\\\\n            max_output_tokens_param=\\\\\\\"max_output_tokens\\\\\\\",\\\\n        )\\\\n\\\\n    _grammar_from_parser: bool = PrivateAttr(default=False)\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"CAUTION: Should only be set by the parser's adjust_request.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    _parser_structured_outputs: StructuredOutputsParams | None = PrivateAttr(\\\\n        default=None\\\\n    )\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Parser-derived constraints that preserve the public request's text metadata.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    _DEFAULT_SAMPLING_PARAMS = {\\\\n        \\\\\\\"temperature\\\\\\\": 1.0,\\\\n        \\\\\\\"top_p\\\\\\\": 1.0,\\\\n    