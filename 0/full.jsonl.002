{"timestamp":"2026-11-04T01:14:55.468Z","ordinal":88298,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","item":{"type":"CommandExecution","id":"exec-e06f5158-4e96-4e71-aba0-2ca9e1c80cef","process_id":"26273","command":["/usr/bin/zsh","-lc","sed -n '1,125p' eval/tool_grammar_matrix.test.mjs; sed -n '123,215p' eval/tool_grammar_matrix.test.mjs"],"cwd":"file:///home/mike/nexus-wt/v112-wp1101-integration","parsed_cmd":[{"type":"read","cmd":"sed -n '1,125p' eval/tool_grammar_matrix.test.mjs","name":"tool_grammar_matrix.test.mjs","path":"eval/tool_grammar_matrix.test.mjs"},{"type":"read","cmd":"sed -n '123,215p' eval/tool_grammar_matrix.test.mjs","name":"tool_grammar_matrix.test.mjs","path":"eval/tool_grammar_matrix.test.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { createHash } from \"node:crypto\";\nimport { test } from \"node:test\";\nimport {\n  classifyToolArguments,\n  endpointPasses,\n  runToolGrammarMatrix,\n  validateMatrixEvidence,\n  writeEvidence,\n} from \"./tool_grammar_matrix.mjs\";\n\nconst schema = {\n  type: \"object\",\n  properties: { path: { type: \"string\" } },\n  required: [\"path\"],\n};\n\nfunction endpointResult(nativeValid, repaired = 0, schemaInvalid = 0, invalid = 0) {\n  return {\n    attempts: 200,\n    tools: Object.fromEntries([\"read_file\", \"write_file\", \"edit_file\", \"run_command\"].map((name) => [name, {\n      attempts: 50,\n      native_valid: name === \"read_file\" ? nativeValid : 50,\n      repaired: name === \"read_file\" ? repaired : 0,\n      schema_invalid: name === \"read_file\" ? schemaInvalid : 0,\n      invalid: name === \"read_file\" ? invalid : 0,\n      hybrid_attempts: 5,\n      hybrid_reasoning_present: 5,\n      hybrid_schema_valid: 5,\n    }])),\n    totals: { attempts: 200, native_valid: nativeValid + 150, repaired, schema_invalid: schemaInvalid, invalid },\n    passed: false,\n  };\n}\n\nfunction identifiedEndpoint(provider, result = endpointResult(50)) {\n  const initial = provider === \"llamacpp\" ? \"1\" : provider === \"vllm\" ? \"c\" : \"f\";\n  const model = provider === \"llamacpp\" ? \"2\" : provider === \"vllm\" ? \"d\" : \"a\";\n  return {\n    provider,\n    serverKind: provider,\n    serverVersion: provider === \"vllm\" ? \"0.10.0\" : \"1.0.0\",\n    imageDigest: `sha256:${initial.repeat(64)}`,\n    modelName: \"reasoning-model\",\n    modelDigest: `sha256:${model.repeat(64)}`,\n    contextSize: 32768,\n    sampling: { temperature: 0 },\n    toolChoice: \"auto\",\n    promptFixtureSha256: \"e\".repeat(64),\n    serverFlags: [],\n    compatibilityMode: \"openai-chat\",\n    ...result,\n    passed: endpointPasses(result),\n  };\n}\n\nfunction evidenceWith(endpoints = [\"llamacpp\", \"vllm\", \"ollama\"].map((provider) => identifiedEndpoint(provider))) {\n  return { schemaVersion: 1, candidate: { archiveSha256: \"a\".repeat(64), sourceCommit: \"b\".repeat(40) }, endpoints };\n}\n\ntest(\"tool grammar matrix evidence schema rejects invalid counts and identity omissions\", () => {\n  assert.equal(validateMatrixEvidence(evidenceWith()).valid, true);\n\n  const omittedIdentity = evidenceWith([identifiedEndpoint(\"llamacpp\"), { provider: \"vllm\", ...endpointResult(50) }, identifiedEndpoint(\"ollama\")]);\n  assert.throws(() => validateMatrixEvidence(omittedIdentity), /identity/i);\n\n  const badCounts = evidenceWith([identifiedEndpoint(\"llamacpp\"), { ...identifiedEndpoint(\"vllm\"), totals: { ...endpointResult(50).totals, invalid: -1 } }, identifiedEndpoint(\"ollama\")]);\n  assert.throws(() => validateMatrixEvidence(badCounts), /count|attempt/i);\n\n  const secretMetadata = evidenceWith();\n  secretMetadata.endpoints[0].sampling.apiKey = \"REDACTED\";\n  assert.throws(() => validateMatrixEvidence(secretMetadata), /sensitive/i);\n});\n\ntest(\"tool grammar matrix computes endpoint pass without percentage rounding\", () => {\n  const atThreshold = identifiedEndpoint(\"vllm\", endpointResult(49, 1));\n  assert.equal(endpointPasses(atThreshold), true, \"199/200 is exactly the inclusive 99.5% boundary\");\n  const belowThreshold = identifiedEndpoint(\"vllm\", endpointResult(48, 2));\n  assert.equal(endpointPasses(belowThreshold), false, \"198/200 must fail even if a rounded display says 99%\");\n});\n\ntest(\"tool grammar matrix rejects schema-invalid tool arguments\", () => {\n  const result = classifyToolArguments({ schema, rawArguments: '{\"path\":4}', repairJsonWithClass: () => assert.fail(\"valid JSON must not be repaired\") });\n  assert.deepEqual(result, { category: \"schema_invalid\", parsed: true, schemaValid: false, repaired: false });\n});\n\ntest(\"tool grammar matrix accepts nullable optional fields from strict provider schemas\", () => {\n  const strictSchema = {\n    type: \"object\",\n    properties: { path: { type: \"string\" }, start_line: { type: [\"number\", \"null\"] } },\n    required: [\"path\", \"start_line\"],\n    additionalProperties: false,\n  };\n  const result = classifyToolArguments({ schema: strictSchema, rawArguments: '{\"path\":\"a\",\"start_line\":null}', repairJsonWithClass: () => assert.fail(\"valid JSON must not be repaired\") });\n  assert.deepEqual(result, { category: \"native_valid\", parsed: true, schemaValid: true, repaired: false });\n});\n\ntest(\"matrix evidence retains a measured provider miss as a failed result\", () => {\n  const missed = identifiedEndpoint(\"vllm\", endpointResult(48, 1, 1));\n  missed.passed = false;\n  const result = validateMatrixEvidence(evidenceWith([identifiedEndpoint(\"llamacpp\"), missed, identifiedEndpoint(\"ollama\")]));\n  assert.deepEqual(result, { valid: true, passed: false });\n});\n\ntest(\"matrix evidence rejects caller-supplied tool schemas instead of replacing installed schemas\", async () => {\n  await assert.rejects(runToolGrammarMatrix({ archivePath: \"unused\", installRoot: \"unused\", tools: [] }), /exact installed candidate/i);\n});\n\ntest(\"tool grammar matrix preserves missing hybrid reasoning as a failed endpoint\", () => {\n  const endpoint = identifiedEndpoint(\"vllm\");\n  endpoint.tools.read_file.hybrid_reasoning_present = 4;\n  endpoint.passed = false;\n  assert.equal(endpointPasses(endpoint), false);\n  assert.deepEqual(\n    validateMatrixEvidence(evidenceWith([identifiedEndpoint(\"llamacpp\"), endpoint, identifiedEndpoint(\"ollama\")])),\n    { valid: true, passed: false },\n  );\n});\n\ntest(\"tool grammar matrix runner records archive and per-endpoint identity\", async () => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"wp1107-matrix-test-\"));\n  const archivePath = path.join(root, \"candidate.tar.gz\");\ntest(\"tool grammar matrix runner records archive and per-endpoint identity\", async () => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"wp1107-matrix-test-\"));\n  const archivePath = path.join(root, \"candidate.tar.gz\");\n  const archiveBytes = Buffer.from(\"candidate fixture bytes\");\n  fs.writeFileSync(archivePath, archiveBytes);\n  const installRoot = path.join(root, \"installed\");\n  fs.mkdirSync(installRoot);\n  const sourceCommit = \"b\".repeat(40);\n  fs.writeFileSync(path.join(installRoot, \".provenance.json\"), JSON.stringify({\n    method: \"installer\",\n    archiveSha256: createHash(\"sha256\").update(archiveBytes).digest(\"hex\"),\n    revision: sourceCommit,\n  }));\n  const tools = [\n    [\"read_file\", { path: { type: \"string\" }, start_line: { type: \"number\" } }, [\"path\"]],\n    [\"write_file\", { path: { type: \"string\" }, content: { type: \"string\" } }, [\"path\", \"content\"]],\n    [\"edit_file\", { path: { type: \"string\" }, old_content: { type: \"string\" }, new_content: { type: \"string\" } }, [\"path\", \"old_content\", \"new_content\"]],\n    [\"run_command\", { command: { type: \"string\" } }, [\"command\"]],\n  ].map(([name, properties, required]) => ({ type: \"function\", function: { name, parameters: { type: \"object\", properties, required } } }));\n  let calls = 0;\n  let failVllm = false;\n  const runtime = {\n    tools,\n    adaptToolsForServer: (kind, definitions) => kind === \"vllm\" ? definitions.map((tool) => {\n      const params = tool.function.parameters;\n      const properties = Object.fromEntries(Object.entries(params.properties).map(([name, property]) => [\n        name,\n        (params.required ?? []).includes(name) ? property : { ...property, type: [property.type, \"null\"] },\n      ]));\n      return { ...tool, function: { ...tool.function, strict: true, parameters: { ...params, properties, required: Object.keys(properties), additionalProperties: false } } };\n    }) : definitions,\n    repairJsonWithClass: (raw) => ({ value: JSON.parse(raw), repaired: \"none\" }),\n    clientFactory: async (provider) => ({\n      discoverAdvertisement: async () => ({ state: \"supported\" }),\n      getDetectedServerKind: () => provider.serverKind,\n      chatCompletion: async (messages, offered) => {\n        calls++;\n        if (failVllm && provider.provider === \"vllm\") return { content: \"\", tool_calls: [] };\n        const name = offered[0].function.name;\n        const args = name === \"read_file\" ? { path: \"safe fixture\", ...(provider.provider === \"vllm\" ? { start_line: null } : {}) }\n          : name === \"write_file\" ? { path: \"safe fixture\", content: \"fixture\" }\n            : name === \"edit_file\" ? { path: \"safe fixture\", old_content: \"a\", new_content: \"b\" }\n              : { command: \"true\" };\n        const hybrid = messages[0].content.includes(\"<think>\");\n        return { content: hybrid ? \"<think>check arguments</think>\" : \"\", tool_calls: [{ function: { name, arguments: JSON.stringify(args) } }] };\n      },\n    }),\n  };\n  const providers = [\"llamacpp\", \"vllm\", \"ollama\"].map((provider) => ({\n    provider, serverKind: provider, endpointUrl: \"http://127.0.0.1:8000/v1\", modelName: \"m\",\n    serverVersion: provider === \"vllm\" ? \"0.10.0\" : \"1.0.0\",\n    imageDigest: `sha256:${(provider === \"llamacpp\" ? \"1\" : provider === \"vllm\" ? \"c\" : \"f\").repeat(64)}`,\n    modelDigest: `sha256:${(provider === \"llamacpp\" ? \"2\" : provider === \"vllm\" ? \"d\" : \"a\").repeat(64)}`,\n    contextSize: 32768, sampling: { temperature: 0 }, toolChoice: \"auto\", serverFlags: [], compatibilityMode: \"openai-chat\",\n  }));\n  await assert.rejects(\n    runToolGrammarMatrix({ archivePath, installRoot, sourceCommit, runtime, providers }),\n    /caller-supplied runtime/i,\n    \"production evidence collection must never accept a substitute for the installed candidate runtime\",\n  );\n  calls = 0;\n  const evidence = await runToolGrammarMatrix({\n    archivePath,\n    installRoot,\n    sourceCommit,\n    runtime,\n    providers,\n    attemptsPerTool: 50,\n    hybridAttemptsPerTool: 5,\n  });\n\n  assert.equal(calls, 600);\n  assert.equal(evidence.candidate.archiveSha256.length, 64);\n  assert.deepEqual(evidence.endpoints.map((endpoint) => endpoint.provider), [\"llamacpp\", \"vllm\", \"ollama\"]);\n  assert.equal(evidence.endpoints[1].serverKind, \"vllm\");\n  assert.equal(\"endpointUrl\" in evidence.endpoints[0], false);\n  assert.equal(evidence.endpoints[0].totals.attempts, 200);\n  assert.equal(evidence.endpoints[1].tools.read_file.schema_invalid, 0, \"nullable vLLM parameters must be checked against the adapted candidate schema\");\n  assert.equal(evidence.passed, true);\n\n  failVllm = true;\n  const failedPath = path.join(root, \"provider-miss.json\");\n  const failed = await runToolGrammarMatrix({ archivePath, installRoot, sourceCommit, runtime, providers, outputPath: failedPath });\n  assert.equal(failed.passed, false);\n  assert.equal(failed.endpoints.find((endpoint) => endpoint.provider === \"vllm\").passed, false);\n  assert.equal(failed.endpoints.find((endpoint) => endpoint.provider === \"vllm\").totals.invalid, 200);\n  assert.equal(fs.existsSync(failedPath), true, \"failed endpoint counts must be written before returning failure status\");\n  fs.rmSync(root, { recursive: true, force: true });\n});\n\ntest(\"tool grammar matrix rejects credential-like server flags before inference\", async () => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"wp1107-secret-flags-\"));\n  const archivePath = path.join(root, \"candidate.tar.gz\");\n","exit_code":0,"duration":{"secs":0,"nanos":644645475}},"started_at_ms":1793754894823,"completed_at_ms":1793754895468}}
{"timestamp":"2026-11-04T01:14:56.664Z","ordinal":88299,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1a41f-9918-7fd1-a66a-67825ee51cf9","call_id":"call_7f97e059209344fd9b7e2dfaee98be39","output":[{"type":"input_text","text":"Script completed\nWall time 3.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"bb65ea\",\"wall_time_seconds\":0.644727559,\"exit_code\":0,\"original_token_count\":2776,\"output\":\"Warning: truncated output (original token count: 2776)\\nTotal output lines: 218\\n\\nimport assert from \\\"node:assert/strict\\\";\\nimport fs from \\\"node:fs\\\";\\nimport os from \\\"node:os\\\";\\nimport path from \\\"node:path\\\";\\nimport { createHash } from \\\"node:crypto\\\";\\nimport { test } from \\\"node:test\\\";\\nimport {\\n  classifyToolArguments,\\n  endpointPasses,\\n  runToolGrammarMatrix,\\n  validateMatrixEvidence,\\n  writeEvidence,\\n} from \\\"./tool_grammar_matrix.mjs\\\";\\n\\nconst schema = {\\n  type: \\\"object\\\",\\n  properties: { path: { type: \\\"string\\\" } },\\n  required: [\\\"path\\\"],\\n};\\n\\nfunction endpointResult(nativeValid, repaired = 0, schemaInvalid = 0, invalid = 0) {\\n  return {\\n    attempts: 200,\\n    tools: Object.fromEntries([\\\"read_file\\\", \\\"write_file\\\", \\\"edit_file\\\", \\\"run_command\\\"].map((name) => [name, {\\n      attempts: 50,\\n      native_valid: name === \\\"read_file\\\" ? nativeValid : 50,\\n      repaired: name === \\\"read_file\\\" ? repaired : 0,\\n      schema_invalid: name === \\\"read_file\\\" ? schemaInvalid : 0,\\n      invalid: name === \\\"read_file\\\" ? invalid : 0,\\n      hybrid_attempts: 5,\\n      hybrid_reasoning_present: 5,\\n      hybrid_schema_valid: 5,\\n    }])),\\n    totals: { attempts: 200, native_valid: nativeValid + 150, repaired, schema_invalid: schemaInvalid, invalid },\\n    passed: false,\\n  };\\n}\\n\\nfunction identifiedEndpoint(provider, result = endpointResult(50)) {\\n  const initial = provider === \\\"llamacpp\\\" ? \\\"1\\\" : provider === \\\"vllm\\\" ? \\\"c\\\" : \\\"f\\\";\\n  const model = provider === \\\"llamacpp\\\" ? \\\"2\\\" : provider === \\\"vllm\\\" ? \\\"d\\\" : \\\"a\\\";\\n  return {\\n    provider,\\n    serverKind: provider,\\n    serverVersion: provider === \\\"vllm\\\" ? \\\"0.10.0\\\" : \\\"1.0.0\\\",\\n    imageDigest: `sha256:${initial.repeat(64)}`,\\n    modelName: \\\"reasoning-model\\\",\\n    modelDigest: `sha256:${model.repeat(64)}`,\\n    contextSize: 32768,\\n    sampling: { temperature: 0 },\\n    toolChoice: \\\"auto\\\",\\n    promptFixtureSha256: \\\"e\\\".repeat(64),\\n    serverFlags: [],\\n    compatibilityMode: \\\"openai-chat\\\",\\n    ...result,\\n    passed: endpointPasses(result),\\n  };\\n}\\n\\nfunction evidenceWith(endpoints = [\\\"llamacpp\\\", \\\"vllm\\\", \\\"ollama\\\"].map((provider) => identifiedEndpoint(provider))) {\\n  return { schemaVersion: 1, candidate: { archiveSha256: \\\"a\\\".repeat(64), sourceCommit: \\\"b\\\".repeat(40) }, endpoints };\\n}\\n\\ntest(\\\"tool grammar matrix evidence schema rejects invalid counts and identity omissions\\\", () => {\\n  assert.equal(validateMatrixEvidence(evidenceWith()).valid, true);\\n\\n  const omittedIdentity = evidenceWith([identifiedEndpoint(\\\"llamacpp\\\"), { provider: \\\"vllm\\\", ...endpointResult(50) }, identifiedEndpoint(\\\"ollama\\\")]);\\n  assert.throws(() => validateMatrixEvidence(omittedIdentity), /identity/i);\\n\\n  const badCounts = evidenceWith([identifiedEndpoint(\\\"llamacpp\\\"), { ...identifiedEndpoint(\\\"vllm\\\"), totals: { ...endpointResult(50).totals, invalid: -1 } }, identifiedEndpoint(\\\"ollama\\\")]);\\n  assert.throws(() => validateMatrixEvidence(badCounts), /count|attempt/i);\\n\\n  const secretMetadata = evidenceWith();\\n  secretMetadata.endpoints[0].sampling.apiKey = REDACTED not be recorded\\\";\\n  assert.throws(() => validateMatrixEvidence(secretMetadata), /sensitive/i);\\n});\\n\\ntest(\\\"tool grammar matrix computes endpoint pass without percentage rounding\\\", () => {\\n  const atThreshold = identifiedEndpoint(\\\"vllm\\\", endpointResult(49, 1));\\n  assert.equal(endpointPasses(atThreshold), true, \\\"199/200 is exactly the inclusive 99.5% boundary\\\");\\n  const belowThreshold = identifiedEndpoint(\\\"vllm\\\", endpointResult(48, 2));\\n  assert.equal(endpointPasses(belowThreshold), false, \\\"198/200 must fail even if a rounded display says 99%\\\");\\n});\\n\\ntest(\\\"tool grammar matrix rejects schema-invalid tool arguments\\\", () => {\\n  const result = classifyToolArguments({ schema, rawArguments: '{\\\"path\\\":4}', repairJsonWithClass: () => assert.fail(\\\"valid JSON must not be repaired\\\") });\\n  assert.deepEqual(result, { category: \\\"schema_invalid\\\", parsed: true, schemaValid: false, repaired: false });\\n});\\n\\ntest(\\\"tool grammar matrix accepts nullable optional fields from strict provider schemas\\\", () => {\\n  const strictSchema = {\\n    type: \\\"object\\\",\\n    properties: { path: { type: \\\"string\\\" }, start_line: { type: [\\\"number\\\", \\\"null\\\"] } },\\n    required: [\\\"path\\\", \\\"start_line\\\"],\\n    additionalProperties: false,\\n  };\\n  const result = classifyToolArguments({ schema: strictSchema, rawArguments: '{\\\"path\\\":\\\"a\\\",\\\"start_line\\\":null}', repairJsonWithClass: () => assert.fail(\\\"valid JSON must not be repaired\\\") });\\n  assert.deepEqual(result, { category: \\\"native_valid\\\", parsed: true, schemaValid: true, repaired: false });\\n});\\n\\ntest(\\\"matrix evidence retains a measured provider miss as a failed result\\\", () => {\\n  const missed = identifiedEndpoint(\\\"vllm\\\", endpointResult(48, 1, 1));\\n  missed.passed = false;\\n  const result = validateMatrixEvidence(evidenceWith([identifiedEndpoint(\\\"llamacpp\\\"), missed, identifiedEndpoint(\\\"ollama\\\")]));\\n  assert.deepEqual(result, { valid: true, passed: false });\\n});\\n\\ntest(\\\"matrix evidence rejects caller-supplied tool schemas instead of replacing installed schemas\\\", async () => {\\n  await assert.rejects(runToolGrammarMatrix({ archivePath: \\\"unused\\\", installRoot: \\\"unused\\\", tools: [] }), /exact installed candidate/i);\\n});\\n\\ntest(\\\"tool grammar matrix preserves missing hybrid reasoning as a failed endpoint\\\", () => {\\n  const endpoint = identifiedEndpoint(\\\"vllm\\\");\\n  endpoint.tools.read_file.hybrid_reasoning_present = 4;\\n  endpoint.passed = false;\\n  assert.equal(endpointPasses(endpoint), false);\\n  assert.deepEqual(\\n    validateMatrixEvidence(evidenceWith([identifiedEndpoint(\\\"llamacpp\\\"), endpoint, identif…76 tokens truncated…t(\\\"tool grammar matrix runner records archive and per-endpoint identity\\\", async () => {\\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \\\"wp1107-matrix-test-\\\"));\\n  const archivePath = path.join(root, \\\"candidate.tar.gz\\\");\\n  const archiveBytes = Buffer.from(\\\"candidate fixture bytes\\\");\\n  fs.writeFileSync(archivePath, archiveBytes);\\n  const installRoot = path.join(root, \\\"installed\\\");\\n  fs.mkdirSync(installRoot);\\n  const sourceCommit = \\\"b\\\".repeat(40);\\n  fs.writeFileSync(path.join(installRoot, \\\".provenance.json\\\"), JSON.stringify({\\n    method: \\\"installer\\\",\\n    archiveSha256: createHash(\\\"sha256\\\").update(archiveBytes).digest(\\\"hex\\\"),\\n    revision: sourceCommit,\\n  }));\\n  const tools = [\\n    [\\\"read_file\\\", { path: { type: \\\"string\\\" }, start_line: { type: \\\"number\\\" } }, [\\\"path\\\"]],\\n    [\\\"write_file\\\", { path: { type: \\\"string\\\" }, content: { type: \\\"string\\\" } }, [\\\"path\\\", \\\"content\\\"]],\\n    [\\\"edit_file\\\", { path: { type: \\\"string\\\" }, old_content: { type: \\\"string\\\" }, new_content: { type: \\\"string\\\" } }, [\\\"path\\\", \\\"old_content\\\", \\\"new_content\\\"]],\\n    [\\\"run_command\\\", { command: { type: \\\"string\\\" } }, [\\\"command\\\"]],\\n  ].map(([name, properties, required]) => ({ type: \\\"function\\\", function: { name, parameters: { type: \\\"object\\\", properties, required } } }));\\n  let calls = 0;\\n  let failVllm = false;\\n  const runtime = {\\n    tools,\\n    adaptToolsForServer: (kind, definitions) => kind === \\\"vllm\\\" ? definitions.map((tool) => {\\n      const params = tool.function.parameters;\\n      const properties = Object.fromEntries(Object.entries(params.properties).map(([name, property]) => [\\n        name,\\n        (params.required ?? []).includes(name) ? property : { ...property, type: [property.type, \\\"null\\\"] },\\n      ]));\\n      return { ...tool, function: { ...tool.function, strict: true, parameters: { ...params, properties, required: Object.keys(properties), additionalProperties: false } } };\\n    }) : definitions,\\n    repairJsonWithClass: (raw) => ({ value: JSON.parse(raw), repaired: \\\"none\\\" }),\\n    clientFactory: async (provider) => ({\\n      discoverAdvertisement: async () => ({ state: \\\"supported\\\" }),\\n      getDetectedServerKind: () => provider.serverKind,\\n      chatCompletion: async (messages, offered) => {\\n        calls++;\\n        if (failVllm && provider.provider === \\\"vllm\\\") return { content: \\\"\\\", tool_calls: [] };\\n        const name = offered[0].function.name;\\n        const args = name === \\\"read_file\\\" ? { path: \\\"safe fixture\\\", ...(provider.provider === \\\"vllm\\\" ? { start_line: null } : {}) }\\n          : name === \\\"write_file\\\" ? { path: \\\"safe fixture\\\", content: \\\"fixture\\\" }\\n            : name === \\\"edit_file\\\" ? { path: \\\"safe fixture\\\", old_content: \\\"a\\\", new_content: \\\"b\\\" }\\n              : { command: \\\"true\\\" };\\n        const hybrid = messages[0].content.includes(\\\"<think>\\\");\\n        return { content: hybrid ? \\\"<think>check arguments</think>\\\" : \\\"\\\", tool_calls: [{ function: { name, arguments: JSON.stringify(args) } }] };\\n      },\\n    }),\\n  };\\n  const providers = [\\\"llamacpp\\\", \\\"vllm\\\", \\\"ollama\\\"].map((provider) => ({\\n    provider, serverKind: provider, endpointUrl: \\\"http://127.0.0.1:8000/v1\\\", modelName: \\\"m\\\",\\n    serverVersion: provider === \\\"vllm\\\" ? \\\"0.10.0\\\" : \\\"1.0.0\\\",\\n    imageDigest: `sha256:${(provider === \\\"llamacpp\\\" ? \\\"1\\\" : provider === \\\"vllm\\\" ? \\\"c\\\" : \\\"f\\\").repeat(64)}`,\\n    modelDigest: `sha256:${(provider === \\\"llamacpp\\\" ? \\\"2\\\" : provider === \\\"vllm\\\" ? \\\"d\\\" : \\\"a\\\").repeat(64)}`,\\n    contextSize: 32768, sampling: { temperature: 0 }, toolChoice: \\\"auto\\\", serverFlags: [], compatibilityMode: \\\"openai-chat\\\",\\n  }));\\n  await assert.rejects(\\n    runToolGrammarMatrix({ archivePath, installRoot, sourceCommit, runtime, providers }),\\n    /caller-supplied runtime/i,\\n    \\\"production evidence collection must never accept a substitute for the installed candidate runtime\\\",\\n  );\\n  calls = 0;\\n  const evidence = await runToolGrammarMatrix({\\n    archivePath,\\n    installRoot,\\n    sourceCommit,\\n    runtime,\\n    providers,\\n    attemptsPerTool: 50,\\n    hybridAttemptsPerTool: 5,\\n  });\\n\\n  assert.equal(calls, 600);\\n  assert.equal(evidence.candidate.archiveSha256.length, 64);\\n  assert.deepEqual(evidence.endpoints.map((endpoint) => endpoint.provider), [\\\"llamacpp\\\", \\\"vllm\\\", \\\"ollama\\\"]);\\n  assert.equal(evidence.endpoints[1].serverKind, \\\"vllm\\\");\\n  assert.equal(\\\"endpointUrl\\\" in evidence.endpoints[0], false);\\n  assert.equal(evidence.endpoints[0].totals.attempts, 200);\\n  assert.equal(evidence.endpoints[1].tools.read_file.schema_invalid, 0, \\\"nullable vLLM parameters must be checked against the adapted candidate schema\\\");\\n  assert.equal(evidence.passed, true);\\n\\n  failVllm = true;\\n  const failedPath = path.join(root, \\\"provider-miss.json\\\");\\n  const failed = await runToolGrammarMatrix({ archivePath, installRoot, sourceCommit, runtime, providers, outputPath: failedPath });\\n  assert.equal(failed.passed, false);\\n  assert.equal(failed.endpoints.find((endpoint) => endpoint.provider === \\\"vllm\\\").passed, false);\\n  assert.equal(failed.endpoints.find((endpoint) => endpoint.provider === \\\"vllm\\\").totals.invalid, 200);\\n  assert.equal(fs.existsSync(failedPath), true, \\\"failed endpoint counts must be written before returning failure status\\\");\\n  fs.rmSync(root, { recursive: true, force: true });\\n});\\n\\ntest(\\\"tool grammar matrix rejects credential-like server flags before inference\\\", async () => {\\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \\\"wp1107-secret-flags-\\\"));\\n  const archivePath = path.join(root, \\\"candidate.tar.gz\\\");\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","create_time":1793754896.6641586}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
