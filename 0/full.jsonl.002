{"timestamp":"2026-11-03T21:23:19.599Z","ordinal":83160,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","item":{"type":"CommandExecution","id":"exec-80e5931d-c890-4a21-b3aa-2aab74d5b028","process_id":"87441","command":["/usr/bin/zsh","-lc","sed -n '202,238p' eval/tool_grammar_matrix.test.mjs"],"cwd":"file:///home/mike/nexus-wt/v112-wp1101-integration","parsed_cmd":[{"type":"read","cmd":"sed -n '202,238p' eval/tool_grammar_matrix.test.mjs","name":"tool_grammar_matrix.test.mjs","path":"eval/tool_grammar_matrix.test.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"});\n\ntest(\"tool grammar matrix rejects credential-like server flags before inference\", async () => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"wp1107-secret-flags-\"));\n  const archivePath = path.join(root, \"candidate.tar.gz\");\n  const archiveBytes = Buffer.from(\"candidate fixture bytes\");\n  fs.writeFileSync(archivePath, archiveBytes);\n  const installRoot = path.join(root, \"installed\");\n  fs.mkdirSync(installRoot);\n  const sourceCommit = \"b\".repeat(40);\n  fs.writeFileSync(path.join(installRoot, \".provenance.json\"), JSON.stringify({\n    method: \"installer\",\n    archiveSha256: createHash(\"sha256\").update(archiveBytes).digest(\"hex\"),\n    revision: sourceCommit,\n  }));\n  let calls = 0;\n  const providers = [\"llamacpp\", \"vllm\", \"ollama\"].map((provider) => ({\n    provider, serverKind: provider, endpointUrl: \"http://127.0.0.1:8000/v1\", modelName: \"m\",\n    serverVersion: \"1.0.0\", imageDigest: `sha256:${\"1\".repeat(64)}`,\n    modelDigest: `sha256:${\"2\".repeat(64)}`, contextSize: 32768,\n    sampling: { temperature: 0 }, toolChoice: \"auto\", serverFlags: [\"--api-key=REDACTED,\n    compatibilityMode: \"openai-chat\",\n  }));\n\n  await assert.rejects(runToolGrammarMatrix({\n    archivePath, installRoot, sourceCommit, providers,\n    tools: [], clientFactory: async () => { calls++; return {}; },\n    repairJsonWithClass: () => ({}),\n  }), /credential|authentication|sensitive/i);\n  assert.equal(calls, 0, \"credential-bearing configuration must fail before provider initialization\");\n  fs.rmSync(root, { recursive: true, force: true });\n});\n\ntest(\"tool grammar matrix evidence is immutable and has a detached SHA-256 sidecar\", () => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"wp1107-evidence-test-\"));\n  const outputPath = path.join(root, \"wp-1107-provider-matrix.json\");\n  const result = writeEvidence(outputPath, evidenceWith());\n","exit_code":0,"duration":{"secs":0,"nanos":728692681}},"started_at_ms":1793740998869,"completed_at_ms":1793740999599}}
{"timestamp":"2026-11-03T21:23:21.943Z","ordinal":83161,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1a34b-94d6-79d2-b4cd-db60b98ac60b","call_id":"call_52199a4f618d4c47ac3dd148e951f605","output":[{"type":"input_text","text":"Script completed\nWall time 4.4 seconds\nOutput:\n"},{"type":"input_text","text":"});\n\ntest(\"tool grammar matrix rejects credential-like server flags before inference\", async () => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"wp1107-secret-flags-\"));\n  const archivePath = path.join(root, \"candidate.tar.gz\");\n  const archiveBytes = Buffer.from(\"candidate fixture bytes\");\n  fs.writeFileSync(archivePath, archiveBytes);\n  const installRoot = path.join(root, \"installed\");\n  fs.mkdirSync(installRoot);\n  const sourceCommit = \"b\".repeat(40);\n  fs.writeFileSync(path.join(installRoot, \".provenance.json\"), JSON.stringify({\n    method: \"installer\",\n    archiveSha256: createHash(\"sha256\").update(archiveBytes).digest(\"hex\"),\n    revision: sourceCommit,\n  }));\n  let calls = 0;\n  const providers = [\"llamacpp\", \"vllm\", \"ollama\"].map((provider) => ({\n    provider, serverKind: provider, endpointUrl: \"http://127.0.0.1:8000/v1\", modelName: \"m\",\n    serverVersion: \"1.0.0\", imageDigest: `sha256:${\"1\".repeat(64)}`,\n    modelDigest: `sha256:${\"2\".repeat(64)}`, contextSize: 32768,\n    sampling: { temperature: 0 }, toolChoice: \"auto\", serverFlags: [\"--api-key=REDACTED,\n    compatibilityMode: \"openai-chat\",\n  }));\n\n  await assert.rejects(runToolGrammarMatrix({\n    archivePath, installRoot, sourceCommit, providers,\n    tools: [], clientFactory: async () => { calls++; return {}; },\n    repairJsonWithClass: () => ({}),\n  }), /credential|authentication|sensitive/i);\n  assert.equal(calls, 0, \"credential-bearing configuration must fail before provider initialization\");\n  fs.rmSync(root, { recursive: true, force: true });\n});\n\ntest(\"tool grammar matrix evidence is immutable and has a detached SHA-256 sidecar\", () => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"wp1107-evidence-test-\"));\n  const outputPath = path.join(root, \"wp-1107-provider-matrix.json\");\n  const result = writeEvidence(outputPath, evidenceWith());\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","create_time":1793741001.9428878}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
