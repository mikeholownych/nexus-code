{"timestamp":"2026-11-04T00:18:48.731Z","ordinal":87195,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","item":{"type":"CommandExecution","id":"exec-5d571ff3-fe2f-4ac1-a4e0-2f68a46b3b69","process_id":"58899","command":["/usr/bin/zsh","-lc","nl -ba cli/test/task_class.test.ts | sed -n '1,125p'; rg -n 'X-Task-Class|taskClass|serverKindCache|serverContextCache|discoverAdvertisement|isGateway|gateway' cli/src/client.ts cli/src/core -g '*.ts' | head -110"],"cwd":"file:///home/mike/nexus-wt/v112-wp1107-qualification","parsed_cmd":[{"type":"read","cmd":"nl -ba cli/test/task_class.test.ts","name":"task_class.test.ts","path":"cli/test/task_class.test.ts"},{"type":"search","cmd":"rg -n 'X-Task-Class|taskClass|serverKindCache|serverContextCache|discoverAdvertisement|isGateway|gateway' cli/src/client.ts cli/src/core -g '*.ts'","query":"X-Task-Class|taskClass|serverKindCache|serverContextCache|discoverAdvertisement|isGateway|gateway","path":"client.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"     1\timport { test } from \"node:test\";\n     2\timport assert from \"node:assert/strict\";\n     3\timport http from \"node:http\";\n     4\timport type { AddressInfo } from \"node:net\";\n     5\timport { LocalLlmClient } from \"../src/client.js\";\n     6\t\n     7\tasync function captureHeaders(configure: (c: LocalLlmClient) => void, taskClass?: string) {\n     8\t  let seen: http.IncomingHttpHeaders = {};\n     9\t  const server = http.createServer((req, res) => {\n    10\t    seen = req.headers;\n    11\t    req.resume();\n    12\t    req.on(\"end\", () => {\n    13\t      res.setHeader(\"Content-Type\", \"application/json\");\n    14\t      res.end(JSON.stringify({ choices: [{ message: { role: \"assistant\", content: \"ok\" }, finish_reason: \"stop\" }], usage: {} }));\n    15\t    });\n    16\t  });\n    17\t  await new Promise<void>((r) => server.listen(0, \"127.0.0.1\", r));\n    18\t  try {\n    19\t    const { port } = server.address() as AddressInfo;\n    20\t    const client = new LocalLlmClient({ model: \"m\", endpoint: `http://127.0.0.1:${port}`, apiKey: \"k\", taskClass } as any);\n    21\t    configure(client);\n    22\t    await client.chatCompletion([{ role: \"user\", content: \"hello\" }], []);\n    23\t    return seen;\n    24\t  } finally {\n    25\t    server.close();\n    26\t  }\n    27\t}\n    28\t\n    29\ttest(\"X-Task-Class is sent when configured\", async () => {\n    30\t  const h = await captureHeaders(() => {}, \"review\");\n    31\t  assert.equal(h[\"x-task-class\"], \"review\");\n    32\t});\n    33\t\n    34\ttest(\"X-Task-Class is absent by default and can be set at runtime\", async () => {\n    35\t  assert.equal((await captureHeaders(() => {}))[\"x-task-class\"], undefined);\n    36\t  assert.equal((await captureHeaders((c) => c.setTaskClass(\"architecture\")))[\"x-task-class\"], \"architecture\");\n    37\t});\n    38\t\n    39\ttest(\"an invalid task class is never sent (no header injection)\", async () => {\n    40\t  const h = await captureHeaders((c) => c.setTaskClass(\"bad value\\r\\nX-Evil: 1\"));\n    41\t  assert.equal(h[\"x-task-class\"], undefined);\n    42\t  assert.equal(h[\"x-evil\"], undefined);\n    43\t});\n    44\t\n    45\ttest(\"standalone local servers discovered via /models do not receive X-Task-Class unless configured (REQ-PRV-109)\", async () => {\n    46\t  let lastChatHeaders: http.IncomingHttpHeaders = {};\n    47\t  let mode: \"llamacpp\" | \"gateway\" = \"llamacpp\";\n    48\t  const server = http.createServer((req, res) => {\n    49\t    req.resume();\n    50\t    req.on(\"end\", () => {\n    51\t      res.setHeader(\"Content-Type\", \"application/json\");\n    52\t      if (req.url?.startsWith(\"/v1/models\")) {\n    53\t        const entry =\n    54\t          mode === \"llamacpp\"\n    55\t            ? { id: \"m\", owned_by: \"llamacpp\", meta: { n_ctx_train: 32768 } }\n    56\t            : { id: \"m\", owned_by: \"gateway\", context_length: 32768, limits_version: \"1\" };\n    57\t        res.end(JSON.stringify({ data: [entry] }));\n    58\t        return;\n    59\t      }\n    60\t      if (req.url === \"/props\") {\n    61\t        res.end(JSON.stringify({ default_generation_settings: { n_ctx: 16384 } }));\n    62\t        return;\n    63\t      }\n    64\t      lastChatHeaders = req.headers;\n    65\t      res.end(JSON.stringify({ choices: [{ message: { role: \"assistant\", content: \"ok\" }, finish_reason: \"stop\" }], usage: {} }));\n    66\t    });\n    67\t  });\n    68\t  await new Promise<void>((r) => server.listen(0, \"127.0.0.1\", r));\n    69\t  try {\n    70\t    const { port } = server.address() as AddressInfo;\n    71\t    const ep = `http://127.0.0.1:${port}/v1`;\n    72\t    const main = new LocalLlmClient({ model: \"m\", endpoint: ep, apiKey: \"k\" } as any);\n    73\t    await main.discoverAdvertisement();\n    74\t    const sub = new LocalLlmClient({ model: \"m\", endpoint: ep, apiKey: \"k\", taskClass: \"subagent\" } as any);\n    75\t    await sub.chatCompletion([{ role: \"user\", content: \"hello\" }], []);\n    76\t    assert.equal(lastChatHeaders[\"x-task-class\"], undefined, \"standalone llamacpp server should not receive X-Task-Class\");\n    77\t\n    78\t    mode = \"gateway\";\n    79\t    await main.discoverAdvertisement();\n    80\t    await sub.chatCompletion([{ role: \"user\", content: \"hello\" }], []);\n    81\t    assert.equal(lastChatHeaders[\"x-task-class\"], \"subagent\", \"gateway server should receive X-Task-Class\");\n    82\t  } finally {\n    83\t    server.close();\n    84\t  }\n    85\t});\n    86\t\n    87\ttest(\"ACC-INF-08: code and docs carry no homelab-specific identifiers (t5820, engineering/b0, A770, 18010)\", async () => {\n    88\t  const fs = await import(\"node:fs\");\n    89\t  const path = await import(\"node:path\");\n    90\t  const repoRoot = path.resolve(import.meta.dirname, \"../..\");\n    91\t  const forbidden = /\\b(t5820|A770|18010)\\b|engineering\\/b0/;\n    92\t  const offenders: string[] = [];\n    93\t\n    94\t  const scanFile = (filePath: string) => {\n    95\t    const text = fs.readFileSync(filePath, \"utf-8\");\n    96\t    const lines = text.split(\"\\n\");\n    97\t    for (let i = 0; i < lines.length; i++) {\n    98\t      if (forbidden.test(lines[i])) {\n    99\t        offenders.push(`${path.relative(repoRoot, filePath)}:${i + 1}: ${lines[i].trim()}`);\n   100\t      }\n   101\t    }\n   102\t  };\n   103\t\n   104\t  const walkSrc = (dir: string) => {\n   105\t    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n   106\t      const full = path.join(dir, entry.name);\n   107\t      if (entry.isDirectory()) walkSrc(full);\n   108\t      else if (entry.isFile() && /\\.(ts|js|mjs)$/.test(entry.name)) scanFile(full);\n   109\t    }\n   110\t  };\n   111\t\n   112\t  walkSrc(path.join(repoRoot, \"cli/src\"));\n   113\t  for (const entry of fs.readdirSync(path.join(repoRoot, \"docs\"), { withFileTypes: true })) {\n   114\t    if (entry.isFile() && entry.name.endsWith(\".md\")) {\n   115\t      scanFile(path.join(repoRoot, \"docs\", entry.name));\n   116\t    }\n   117\t  }\n   118\t  scanFile(path.join(repoRoot, \"README.md\"));\n   119\t  scanFile(path.join(repoRoot, \"quickstart.md\"));\n   120\t\n   121\t  assert.deepEqual(offenders, [], `Found forbidden homelab identifiers:\\n${offenders.join(\"\\n\")}`);\n   122\t});\ncli/src/client.ts:64: * The stored gateway token: the file named by the operator's NEXUS_GATEWAY_TOKEN_FILE (environment or config.env, never\ncli/src/client.ts:65: * a project .env), else ~/.config/nexus/gateway-token. It is sent only to the origin config.env names (see credentialOriginOf).\ncli/src/client.ts:71:    : path.join(credentialStorageHome(), \".config/nexus/gateway-token\");\ncli/src/client.ts:88: * gateway token file) are read fr