?: { signal?: AbortSignal; resume?: boolean; tddRed?: boolean; step?: boolean }): Promise<TurnResult> {\n4723:          submit: (s) => this.submitGenAiRequest(activeClient, () =>\n4725:              activeClient.chatCompletion(request, this.getEffectiveTools(), s.requestId, signal))),\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20602-56e4-7401-a61d-85bcc9f8019b","create_time":1795397461.1898522}},"metadata":{"history_sequence":30901,"sampled_through_sequence":30898,"client_authored":false,"fallback_token_limit_override":12000}}
