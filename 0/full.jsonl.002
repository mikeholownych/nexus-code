{"timestamp":"2026-11-03T19:19:34.825Z","ordinal":78220,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a19de1-2f43-7663-a2d9-f17adf8cb101","item":{"type":"CommandExecution","id":"exec-8014c1b6-6f8c-4df6-ac04-a779fe15dd53","process_id":"37108","command":["/usr/bin/zsh","-lc","sed -n '45,175p' /tmp/v112-rc2-artifact-a/install.sh; sed -n '1,52p' scripts/terminal-acceptance/README.md; rg -n 'package_runtime|install.sh|package parity' docs/evidence docs/releases cli/test | head -70"],"cwd":"file:///home/mike/nexus-wt/v112-rc2-package","parsed_cmd":[{"type":"read","cmd":"sed -n '45,175p' /tmp/v112-rc2-artifact-a/install.sh","name":"install.sh","path":"/tmp/v112-rc2-artifact-a/install.sh"},{"type":"read","cmd":"sed -n '1,52p' scripts/terminal-acceptance/README.md","name":"README.md","path":"scripts/terminal-acceptance/README.md"},{"type":"search","cmd":"rg -n 'package_runtime|install.sh|package parity' docs/evidence docs/releases cli/test","query":"package_runtime|install.sh|package parity","path":"evidence"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"  API_BASE=${NEXUS_RELEASES_API:-\"https://api.github.com/repos/$REPO/releases\"}\n  API_TMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-api.XXXXXX\") || fail \"could not create temporary directory.\"\n  api_cleanup() { rm -rf \"$API_TMP\"; }\n  trap api_cleanup EXIT HUP INT TERM\n\n  LATEST_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -D \"$API_TMP/headers\" -o \"$API_TMP/latest.json\" -w \"%{http_code}\" \"$API_BASE/latest\" 2>\"$API_TMP/curl.err\" || echo \"000\")\n\n  if [ \"$LATEST_CODE\" = \"200\" ]; then\n    VERSION=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/latest.json\" | head -n 1)\n    [ -n \"$VERSION\" ] || fail \"GitHub returned no stable release tag.\"\n    validate_tag \"$VERSION\"\n  elif [ \"$LATEST_CODE\" = \"403\" ]; then\n    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \"$API_TMP/headers\" 2>/dev/null; then\n      fail \"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\"\n    fi\n    fail \"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\"\n  elif [ \"$LATEST_CODE\" = \"404\" ]; then\n    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \"$API_TMP/releases.json\" -w \"%{http_code}\" \"$API_BASE?per_page=1\" 2>/dev/null || echo \"000\")\n    if [ \"$PREREL_CODE\" = \"200\" ]; then\n      PREREL_TAG=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/releases.json\" | head -n 1)\n      if [ -n \"$PREREL_TAG\" ]; then\n        fail \"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\"\n      fi\n    fi\n    fail \"could not find latest stable release (HTTP 404 from $API_BASE/latest).\"\n  else\n    fail \"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\"\n  fi\n  rm -rf \"$API_TMP\"\n  trap - EXIT HUP INT TERM\nfi\n\nARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\nNORMALIZED_VERSION=${VERSION#v}\nURL=\"$BASE/download/$VERSION\"\nTMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-install.XXXXXX\") || fail \"could not create temporary directory.\"\ncleanup() { rm -rf \"$TMP\"; }\ntrap cleanup EXIT HUP INT TERM\ncurl -fsSL --show-error --retry 2 \"$URL/$ARCHIVE\" -o \"$TMP/$ARCHIVE\" || fail \"download failed for $ARCHIVE.\"\ncurl -fsSL --show-error --retry 2 \"$URL/SHA256SUMS\" -o \"$TMP/SHA256SUMS\" || fail \"could not download release checksums.\"\ngrep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksum entry for $ARCHIVE is missing.\"\n(cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\nARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n\nif [ \"$VERIFY_ATTESTATION\" != \"0\" ] && [ -n \"$TRUSTED_GH\" ]; then\n  if \"$TRUSTED_GH\" attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n     \"$TRUSTED_GH\" attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n    printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n  elif [ \"$VERIFY_ATTESTATION\" = \"1\" ]; then\n    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n  else\n    printf 'nexus installer: build provenance was not verified: %s could not verify the attestation (it may need gh auth login); the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' \"$TRUSTED_GH\" >&2\n  fi\nelif [ \"$VERIFY_ATTESTATION\" = \"auto\" ]; then\n  printf 'nexus installer: build provenance was not verified: no trusted GitHub CLI at /usr/bin/gh or /usr/local/bin/gh; the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' >&2\nfi\n\nVERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\nBIN_DIR=\"$PREFIX/bin\"\nLINK=\"$BIN_DIR/nexus\"\nmkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\nif [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n  fail \"$LINK exists and is not a symlink; left it unchanged.\"\nfi\nif [ -L \"$LINK\" ]; then\n  OLD=$(readlink \"$LINK\")\n  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\nfi\n\nFORCE=${NEXUS_FORCE:-0}\nNEEDS_EXTRACT=1\nif [ -d \"$VERSION_DIR\" ] && [ \"$FORCE\" != \"1\" ]; then\n  if [ -x \"$VERSION_DIR/bin/nexus\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/harness-core\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/nexus-tui\" ] && \\\n     [ \"$(cat \"$VERSION_DIR/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ]; then\n    if [ -f \"$VERSION_DIR/MANIFEST.sha256\" ]; then\n      if (cd \"$VERSION_DIR\" && sha256sum --check --status MANIFEST.sha256 2>/dev/null); then\n        NEEDS_EXTRACT=0\n      fi\n      if [ \"$NEEDS_EXTRACT\" = \"0\" ]; then\n        if ! node - \"$VERSION_DIR/.provenance.json\" \"$ARCHIVE_SHA256\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [file, archiveSha256] = process.argv.slice(2);\ntry {\n  const record = JSON.parse(fs.readFileSync(file, \"utf8\"));\n  if (record.archiveSha256 !== archiveSha256) process.exit(1);\n} catch { process.exit(1); }\nNODE\n        then\n          NEEDS_EXTRACT=1\n        fi\n      fi\n    fi\n  fi\nfi\n\nif [ \"$NEEDS_EXTRACT\" = \"1\" ]; then\n  mkdir -p \"$TMP/unpack\"\n  tar -xzf \"$TMP/$ARCHIVE\" -C \"$TMP/unpack\" || fail \"archive extraction failed.\"\n  PACKAGE=\"$TMP/unpack/nexus\"\n  [ -x \"$PACKAGE/bin/nexus\" ] && [ -x \"$PACKAGE/lib/core/harness-core\" ] && [ -x \"$PACKAGE/lib/core/nexus-tui\" ] && [ \"$(cat \"$PACKAGE/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ] || fail \"release archive is incomplete or has a mismatched version.\"\n  if [ -f \"$PACKAGE/MANIFEST.sha256\" ]; then\n    (cd \"$PACKAGE\" && sha256sum --check --status MANIFEST.sha256) || fail \"release archive failed manifest checksum verification.\"\n  fi\n  PACKAGE_VERSION_OUTPUT=$(\"$PACKAGE/bin/nexus\" --version 2>&1) || fail \"release binary failed its pre-install self-test.\"\n  PACKAGE_VERSION_REPORTED=$(printf '%s\\n' \"$PACKAGE_VERSION_OUTPUT\" | sed -n '1s/[[:space:]].*$//p')\n  [ \"$PACKAGE_VERSION_REPORTED\" = \"$NORMALIZED_VERSION\" ] || fail \"release binary reported version '$PACKAGE_VERSION_REPORTED' instead of '$NORMALIZED_VERSION' during self-test.\"\n  if [ -f \"$PACKAGE/compatibility.json\" ]; then\n    node - \"$PACKAGE/compatibility.json\" \"$VERSION\" \"$ARCHIVE\" <<'NODE' || fail \"release compatibility metadata is invalid or mismatched.\"\nconst fs = require(\"node:fs\");\nconst [file, version, archive] = process.argv.slice(2);\nconst data = JSON.parse(fs.readFileSync(file, \"utf8\"));\nconst asset = data.platforms?.[\"linux-x86_64\"];\nconst compatible = data.schemaVersion === 1 && data.product === \"nexus-code\" &&\n  data.version === version.replace(/^v/, \"\") &&\n  typeof data.revision === \"string\" && /^[a-f0-9]{7,64}$/i.test(data.revision) &&\n  typeof data.builtAt === \"string\" && !Number.isNaN(Date.parse(data.builtAt)) &&\n  asset?.archive === archive && asset.os === \"linux\" && asset.arch === \"x86_64\" &&\n  data.compatibility && Number.isSafeInteger(data.compatibility.configSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.stateSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedConfigVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedStateVersion) &&\n  data.compatibility.minSupportedConfigVersion <= data.compatibility.configSchemaVersion &&\n  data.compatibility.minSupportedStateVersion <= data.compatibility.stateSchemaVersion;\nif (!compatible) process.exit(1);\nNODE\n  fi\n  # A rename persists the directory entry, not file data: flush the extracted\n  # package before it replaces anything, or a power loss can leave 0-byte files.\n  sync\n# Manual real-terminal matrix (ACCEPTANCE §5.3, REQ-QUAL-108)\n\nA human may run this procedure against the **installed RC** for optional terminal checks. For v1.0.0, the manual matrix is waived by DEC-20; these runs are not a release gate. Automated CI (§5.1) and scripted PTY (§5.2) remain mandatory.\n\n**Cells:** five terminals, each at 80×24, 40×14 and 200×60, giving 15 cells.\n- xterm\n- kitty, with the kitty keyboard protocol on\n- tmux 3.x inside GNOME Terminal\n- the VS Code integrated terminal\n- GNOME Terminal\n\n**Optional check:** zero FAIL on checks 2, 5 and 6. Any other FAIL needs a written disposition if these optional checks are run.\n\n**v1.0.0 disposition:** DEC-20 waives the manual 5×3 matrix. DEC-18 separately waives screenshot artifacts for\n`v1.0.0-rc.N`. Other release series retain their applicable terminal acceptance and screenshot requirements.\nAutomated PTY evidence remains mandatory under ACCEPTANCE §§5.1–5.2.\n\n## Before you start\n\n1. Install the RC with the documented one-line command. `nexus --version` must print the RC version, and `nexus` must\n   not resolve into a checkout.\n2. Choose a new evidence directory, `OUT=docs/reviews/evidence/v1-qualification/<rc>/terminal`, and use it for every cell.\n3. You need `python3` and `git` on `PATH`. No inference is used: a local mock gateway\n   (`mockgw.py`) answers every request.\n\n## Each cell\n\nOpen the terminal and resize it to the cell's size. For tmux, start tmux inside GNOME Terminal. For kitty, enable the\nkeyboard protocol. Then run:\n\n```sh\nscripts/terminal-acceptance/run-cell.sh --rc <rc> --terminal <xterm|kitty|tmux-gnome|vscode|gnome> --size <WxH> --out \"$OUT\"\n```\n\nThe script refuses to start in these cases: the wrong RC, a checkout build, the wrong size, not inside tmux for\n`tmux-gnome`, or a cell already recorded. It creates an isolated HOME and workspace and starts the mock. Then it opens\nthe TUI twice, once normally and once with `NO_COLOR=1`, and prompts you through checks 1–7:\n\n| # | You do | You judge |\n|---|---|---|\n| 1 | The TUI opens | It renders correctly at this size |\n| 2 | Prompt `approve`. At each approval panel, type continuously, paste 3 lines, then approve with a deliberate key | No decision is made by the stray input, and the deliberate key decides |\n| 3 | Shift+Enter or Alt+Enter while composing | It inserts a newline and does not submit |\n| 4 | Prompt `stream`, then resize while it streams and restore the size | Layout recovers and nothing is garbled or lost |\n| 5 | Prompt `sleep`, then press Esc while `sleep 30` runs | Cancel is acknowledged, and nothing survives |\n| 6 | Press Ctrl-C twice to quit | The terminal is restored: echo on, no stray escape codes |\n| 7 | Second launch, with `NO_COLOR=1` | The TUI is readable without colour |\n\nThe script also **measures** two things:\n- whether `stty` state after each exit equals the state before it;\n- any process started from the cell's HOME that is still running after exit.\n\ncli/test/node_floor.test.ts:27:    return spawnSync(\"/bin/sh\", [path.join(root, \"install.sh\")], {\ncli/test/node_floor.test.ts:78:  assert.match(read(\"install.sh\"), new RegExp(`\"\\\\$NODE_MAJOR\" -ge ${FLOOR} \\\\]`));\ndocs/releases/v1.1.2-qualification.md:29:| WP-1104 — Standalone `nexus eval` | Packaged command supports dataset selection, run count, isolated home, and structured score output. | Integrated in commit `11f41ed0`. Verified package parity and standalone CLI execution outside repository checkout. | **PASSED** | Validated in `eval/package_runtime.test.mjs` (5/5 passed). Verified with isolated HOME, dataset selection, and structured scoring. |\ndocs/releases/v1.1.2-qualification.md:41:| G1.1-3 — CLI parity | Packaged `nexus eval` works without developer dependencies on the exact release candidate. | Prior package parity evidence predates `97945557`; rebuild the archive and rerun standalone CLI parity on the new package. | **REQUALIFICATION REQUIRED** |\ndocs/releases/v1.0.0-rc.12.md:16:- **Installer durability:** `install.sh` now syncs after the verified extraction, before repointing the launcher, and after the switch. Re-running the installer over a working installation had the same 0-byte launcher exposure.\ncli/test/install_durability.test.ts:12:const lines = fs.readFileSync(path.join(root, \"install.sh\"), \"utf8\").split(\"\\n\").map((line) => line.trim());\ncli/test/install_durability.test.ts:16:  assert.ok(index >= 0, `install.sh contains: ${statement}`);\ncli/test/repro_identity.test.ts:44:      ...(overrides.missingAsset ? {} : { \"install.sh\": \"i\" }),\ncli/test/repro_identity.test.ts:132:    for (const name of [\"nexus-linux-x86_64-v1.0.0-rc.1.tar.gz\", \"compatibility.json\", \"SHA256SUMS\", \"THIRD_PARTY_NOTICES.txt\", \"sbom.cdx.json\", \"install.sh\"]) {\n","exit_code":0,"duration":{"secs":1,"nanos":251109022}},"started_at_ms":1793733573571,"completed_at_ms":1793733574823}}
