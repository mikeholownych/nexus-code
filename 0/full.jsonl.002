{"timestamp":"2026-11-04T00:19:08.307Z","ordinal":87206,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","item":{"type":"CommandExecution","id":"exec-70e93355-abf0-485a-a45d-b9722c944091","process_id":"68189","command":["/usr/bin/zsh","-lc","rg -n 'taskClass|X-Task-Class|serverKindCache' cli/src/client.ts | head -40; git show HEAD:cli/test/task_class.test.ts | sed -n '45,84p'; git show HEAD:cli/src/client.ts | sed -n '1130,1188p';"],"cwd":"file:///home/mike/nexus-wt/v112-wp1107-qualification","parsed_cmd":[{"type":"unknown","cmd":"rg -n 'taskClass|X-Task-Class|serverKindCache' cli/src/client.ts | head -40; git show HEAD:cli/test/task_class.test.ts | sed -n '45,84p'; git show HEAD:cli/src/client.ts | sed -n '1130,1188p';"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"533:  private taskClass?: string;\n569:      taskClass?: string;\n618:    this.taskClass = options?.taskClass ?? config.taskClass;\n628:    this.role = options?.role ?? (config.taskClass === \"subagent\" ? \"subagent\" : \"main\");\n779:  /** Hint the gateway's route table (sent as X-Task-Class); undefined sends none. */\n780:  public setTaskClass(taskClass?: string): void {\n781:    this.taskClass = taskClass;\n811:    const kind = LocalLlmClient.serverKindCache.get(this.endpoint);\n821:    return this.taskClass && /^[A-Za-z0-9_.-]{1,64}$/.test(this.taskClass) ? { \"X-Task-Class\": this.taskClass } : {};\n1152:      const cachedKind = LocalLlmClient.serverKindCache.get(ep);\n1170:          LocalLlmClient.serverKindCache.set(ep, local.serverKind ?? entryKind);\n1175:      LocalLlmClient.serverKindCache.set(ep, entryKind);\n1184:  private static serverKindCache = new Map<string, ServerKind>();\n1189:    return LocalLlmClient.serverKindCache.get(this.endpoint) ?? \"unknown\";\n1302:    const kind = LocalLlmClient.serverKindCache.get(ep);\n1451:      outboundTools = adaptToolDefinitionsForServer(LocalLlmClient.serverKindCache.get(currentEp) ?? \"unknown\", outboundTools);\n1606:    outboundTools = adaptToolDefinitionsForServer(LocalLlmClient.serverKindCache.get(currentEp) ?? \"unknown\", outboundTools);\ntest(\"standalone local servers discovered via /models do not receive X-Task-Class unless configured (REQ-PRV-109)\", async () => {\n  let lastChatHeaders: http.IncomingHttpHeaders = {};\n  let mode: \"llamacpp\" | \"gateway\" = \"llamacpp\";\n  const server = http.createServer((req, res) => {\n    req.resume();\n    req.on(\"end\", () => {\n      res.setHeader(\"Content-Type\", \"application/json\");\n      if (req.url?.startsWith(\"/v1/models\")) {\n        const entry =\n          mode === \"llamacpp\"\n            ? { id: \"m\", owned_by: \"llamacpp\", meta: { n_ctx_train: 32768 } }\n            : { id: \"m\", owned_by: \"gateway\", context_length: 32768, limits_version: \"1\" };\n        res.end(JSON.stringify({ data: [entry] }));\n        return;\n      }\n      if (req.url === \"/props\") {\n        res.end(JSON.stringify({ default_generation_settings: { n_ctx: 16384 } }));\n        return;\n      }\n      lastChatHeaders = req.headers;\n      res.end(JSON.stringify({ choices: [{ message: { role: \"assistant\", content: \"ok\" }, finish_reason: \"stop\" }], usage: {} }));\n    });\n  });\n  await new Promise<void>((r) => server.listen(0, \"127.0.0.1\", r));\n  try {\n    const { port } = server.address() as AddressInfo;\n    const ep = `http://127.0.0.1:${port}/v1`;\n    const main = new LocalLlmClient({ model: \"m\", endpoint: ep, apiKey: \"k\" } as any);\n    await main.discoverAdvertisement();\n    const sub = new LocalLlmClient({ model: \"m\", endpoint: ep, apiKey: \"k\", taskClass: \"subagent\" } as any);\n    await sub.chatCompletion([{ role: \"user\", content: \"hello\" }], []);\n    assert.equal(lastChatHeaders[\"x-task-class\"], undefined, \"standalone llamacpp server should not receive X-Task-Class\");\n\n    mode = \"gateway\";\n    await main.discoverAdvertisement();\n    await sub.chatCompletion([{ role: \"user\", content: \"hello\" }], []);\n    assert.equal(lastChatHeaders[\"x-task-class\"], \"subagent\", \"gateway server should receive X-Task-Class\");\n  } finally {\n    server.close();\n  }\n   * another provider: capability discovery is scoped to the connection in use). Not content-bearing.\n   * `unsupported`: the provider has no catalog or does not list the model; `unavailable`: it could not be read now.\n   */\n  async discoverAdvertisement(signal?: AbortSignal): Promise<{ state: \"supported\" | \"unsupported\" | \"unavailable\"; advertised?: Advertisement; detail?: string }> {\n    const ep = this.endpoint;\n    if (this.conn.protocol !== \"openai-chat\") return { state: \"unsupported\", detail: `${this.conn.protocol} connection` };\n    const url = `${ep}/models`;\n    try {\n      await this.prepareCredential(ep);\n      const res = await fetch(url, {\n        // Marked so providers (and their logs) can tell a capability read from an availability probe.\n        headers: { ...this.authorization(url), \"X-Nexus-Purpose\": \"capabilities\" },\n        signal: signal ? AbortSignal.any([signal, AbortSignal.timeout(10_000)]) : AbortSignal.timeout(10_000),\n        ...this.fetchPolicy(),\n      });\n      if (res.status === 404) return { state: \"unsupported\", detail: \"no /models catalog\" };\n      if (!res.ok) return { state: \"unavailable\", detail: `HTTP ${res.status}` };\n      const data = (await res.json()) as { data?: Array<Record<string, any>> };\n      const entry = Array.isArray(data?.data) ? data.data.find((e) => e?.id === this.model) : undefined;\n      if (!entry) return { state: \"unsupported\", detail: `model ${this.model} not listed` };\n      const advertised = parseAdvertisement(entry);\n      const entryKind = advertised?.serverKind ?? serverKindOf(entry);\n      LocalLlmClient.serverKindCache.set(ep, entryKind);\n      if (!advertised || (advertised.contextLength === undefined && advertised.maxCompletionTokens === undefined)) {\n        // An OpenAI-style catalog without limits (llama.cpp, LM Studio, Ollama): ask the server itself what it loaded.\n        // Only for a plain endpoint: cloud provider connections have no such endpoints.\n        const local = this.conn.providerId ? undefined : await this.discoverServerContext(entry, signal);\n        if (local) {\n          if (local.serverKind) LocalLlmClient.serverKindCache.set(ep, local.serverKind);\n          return { state: \"supported\", advertised: local };\n        }\n        return { state: \"unsupported\", advertised, detail: \"catalog lists no limits\" };\n      }\n      return { state: \"supported\", advertised };\n    } catch (err: any) {\n      if (signal?.aborted) throw abortedError(randomUUID());\n      return { state: \"unavailable\", detail: redactSecrets(String(err?.message ?? err)).slice(0, 160) };\n    }\n  }\n\n  private static serverContextCache = new Map<string, Advertisement>();\n  private static serverKindCache = new Map<string, ServerKind>();\n\n  /**\n   * The loaded context of a local server that lists no limits in its catalog, from that server's own endpoint (llama.cpp\n   * `/props`, LM Studio `/api/v0/models`, Ollama `/api/show`) on the endpoint's origin with the same credential and a 2 s\n   * limit. The server is recognised from its catalog entry first, so an unrecognised server is never probed. Not\n   * content-bearing. Undefined when the server is not recognised or does not answer with a context size.\n   */\n  private async discoverServerContext(entry: Record<string, any>, signal?: AbortSignal): Promise<Advertisement | undefined> {\n    const kind = serverKindOf(entry);\n    if (kind !== \"llamacpp\" && kind !== \"lmstudio\" && kind !== \"ollama\") return undefined;\n    const cacheKey = `${this.endpoint}::${this.model}`;\n    const cached = LocalLlmClient.serverContextCache.get(cacheKey);\n    if (cached) return cached;\n    const root = this.endpoint.replace(/\\/v1\\/?$/, \"\");\n    const probes: Array<{ kind: \"llamacpp\" | \"lmstudio\" | \"ollama\"; url: string; init?: RequestInit }> = [\n      { kind: \"llamacpp\" as const, url: `${root}/props` },\n      { kind: \"lmstudio\" as const, url: `${root}/api/v0/models` },\n","exit_code":0,"duration":{"secs":0,"nanos":786880165}},"started_at_ms":1793751547519,"completed_at_ms":1793751548307}}
{"timestamp":"2026-11-04T00:19:09.819Z","ordinal":87207,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1a3ec-877b-79c1-94ea-2651056c556a","call_id":"call_8d217d379a794387a303574c0d0a795b","output":[{"type":"input_text","text":"Script completed\nWall time 3.9 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"7bea87\",\"wall_time_seconds\":0.786963545,\"exit_code\":0,\"original_token_count\":1786,\"output\":\"533:  private taskClass?: string;\\n569:      taskClass?: string;\\n618:    this.taskClass = options?.taskClass ?? config.taskClass;\\n628:    this.role = options?.role ?? (config.taskClass === \\\"subagent\\\" ? \\\"subagent\\\" : \\\"main\\\");\\n779:  /** Hint the gateway's route table (sent as X-Task-Class); undefined sends none. */\\n780:  public setTaskClass(taskClass?: string): void {\\n781:    this.taskClass = taskClass;\\n811:    const kind = LocalLlmClient.serverKindCache.get(this.endpoint);\\n821:    return this.taskClass && /^[A-Za-z0-9_.-]{1,64}$/.test(this.taskClass) ? { \\\"X-Task-Class\\\": this.taskClass } : {};\\n1152:      const cachedKind = LocalLlmClient.serverKindCache.get(ep);\\n1170:          LocalLlmClient.serverKindCache.set(ep, local.serverKind ?? entryKind);\\n1175:      LocalLlmClient.serverKindCache.set(ep, entryKind);\\n1184:  private static serverKindCache = new Map<string, ServerKind>();\\n1189:    return LocalLlmClient.serverKindCache.get(this.endpoint) ?? \\\"unknown\\\";\\n1302:    const kind = LocalLlmClient.serverKindCache.get(ep);\\n1451:      outboundTools = adaptToolDefinitionsForServer(LocalLlmClient.serverKindCache.get(currentEp) ?? \\\"unknown\\\", outboundTools);\\n1606:    outboundTools = adaptToolDefinitionsForServer(LocalLlmClient.serverKindCache.get(currentEp) ?? \\\"unknown\\\", outboundTools);\\ntest(\\\"standalone local servers discovered via /models do not receive X-Task-Class unless configured (REQ-PRV-109)\\\", async () => {\\n  let lastChatHeaders: http.IncomingHttpHeaders = {};\\n  let mode: \\\"llamacpp\\\" | \\\"gateway\\\" = \\\"llamacpp\\\";\\n  const server = http.createServer((req, res) => {\\n    req.resume();\\n    req.on(\\\"end\\\", () => {\\n      res.setHeader(\\\"Content-Type\\\", \\\"application/json\\\");\\n      if (req.url?.startsWith(\\\"/v1/models\\\")) {\\n        const entry =\\n          mode === \\\"llamacpp\\\"\\n            ? { id: \\\"m\\\", owned_by: \\\"llamacpp\\\", meta: { n_ctx_train: 32768 } }\\n            : { id: \\\"m\\\", owned_by: \\\"gateway\\\", context_length: 32768, limits_version: \\\"1\\\" };\\n        res.end(JSON.stringify({ data: [entry] }));\\n        return;\\n      }\\n      if (req.url === \\\"/props\\\") {\\n        res.end(JSON.stringify({ default_generation_settings: { n_ctx: 16384 } }));\\n        return;\\n      }\\n      lastChatHeaders = req.headers;\\n      res.end(JSON.stringify({ choices: [{ message: { role: \\\"assistant\\\", content: \\\"ok\\\" }, finish_reason: \\\"stop\\\" }], usage: {} }));\\n    });\\n  });\\n  await new Promise<void>((r) => server.listen(0, \\\"127.0.0.1\\\", r));\\n  try {\\n    const { port } = server.address() as AddressInfo;\\n    const ep = `http://127.0.0.1:${port}/v1`;\\n    const main = new LocalLlmClient({ model: \\\"m\\\", endpoint: ep, apiKey: \\\"k\\\" } as any);\\n    await main.discoverAdvertisement();\\n    const sub = new LocalLlmClient({ model: \\\"m\\\", endpoint: ep, apiKey: \\\"k\\\", taskClass: \\\"subagent\\\" } as any);\\n    await sub.chatCompletion([{ role: \\\"user\\\", content: \\\"hello\\\" }], []);\\n    assert.equal(lastChatHeaders[\\\"x-task-class\\\"], undefined, \\\"standalone llamacpp server should not receive X-Task-Class\\\");\\n\\n    mode = \\\"gateway\\\";\\n    await main.discoverAdvertisement();\\n    await sub.chatCompletion([{ role: \\\"user\\\", content: \\\"hello\\\" }], []);\\n    assert.equal(lastChatHeaders[\\\"x-task-class\\\"], \\\"subagent\\\", \\\"gateway server should receive X-Task-Class\\\");\\n  } finally {\\n    server.close();\\n  }\\n   * another provider: capability discovery is scoped to the connection in use). Not content-bearing.\\n   * `unsupported`: the provider has no catalog or does not list the model; `unavailable`: it could not be read now.\\n   */\\n  async discoverAdvertisement(signal?: AbortSignal): Promise<{ state: \\\"supported\\\" | \\\"unsupported\\\" | \\\"unavailable\\\"; advertised?: Advertisement; detail?: string }> {\\n    const ep = this.endpoint;\\n    if (this.conn.protocol !== \\\"openai-chat\\\") return { state: \\\"unsupported\\\", detail: `${this.conn.protocol} connection` };\\n    const url = `${ep}/models`;\\n    try {\\n      await this.prepareCredential(ep);\\n      const res = await fetch(url, {\\n        // Marked so providers (and their logs) can tell a capability read from an availability probe.\\n        headers: { ...this.authorization(url), \\\"X-Nexus-Purpose\\\": \\\"capabilities\\\" },\\n        signal: signal ? AbortSignal.any([signal, AbortSignal.timeout(10_000)]) : AbortSignal.timeout(10_000),\\n        ...this.fetchPolicy(),\\n      });\\n      if (res.status === 404) return { state: \\\"unsupported\\\", detail: \\\"no /models catalog\\\" };\\n      if (!res.ok) return { state: \\\"unavailable\\\", detail: `HTTP ${res.status}` };\\n      const data = (await res.json()) as { data?: Array<Record<string, any>> };\\n      const entry = Array.isArray(data?.data) ? data.data.find((e) => e?.id === this.model) : undefined;\\n      if (!entry) return { state: \\\"unsupported\\\", detail: `model ${this.model} not listed` };\\n      const advertised = parseAdvertisement(entry);\\n      const entryKind = advertised?.serverKind ?? serverKindOf(entry);\\n      LocalLlmClient.serverKindCache.set(ep, entryKind);\\n      if (!advertised || (advertised.contextLength === undefined && advertised.maxCompletionTokens === undefined)) {\\n        // An OpenAI-style catalog without limits (llama.cpp, LM Studio, Ollama): ask the server itself what it loaded.\\n        // Only for a plain endpoint: cloud provider connections have no such endpoints.\\n        const local = this.conn.providerId ? undefined : await this.discoverServerContext(entry, signal);\\n        if (local) {\\n          if (local.serverKind) LocalLlmClient.serverKindCache.set(ep, local.serverKind);\\n          return { state: \\\"supported\\\", advertised: local };\\n        }\\n        return { state: \\\"unsupported\\\", advertised, detail: \\\"catalog lists no limits\\\" };\\n      }\\n      return { state: \\\"supported\\\", advertised };\\n    } catch (err: any) {\\n      if (signal?.aborted) throw abortedError(randomUUID());\\n      return { state: \\\"unavailable\\\", detail: redactSecrets(String(err?.message ?? err)).slice(0, 160) };\\n    }\\n  }\\n\\n  private static serverContextCache = new Map<string, Advertisement>();\\n  private static serverKindCache = new Map<string, ServerKind>();\\n\\n  /**\\n   * The loaded context of a local server that lists no limits in its catalog, from that server's own endpoint (llama.cpp\\n   * `/props`, LM Studio `/api/v0/models`, Ollama `/api/show`) on the endpoint's origin with the same credential and a 2 s\\n   * limit. The server is recognised from its catalog entry first, so an unrecognised server is never probed. Not\\n   * content-bearing. Undefined when the server is not recognised or does not answer with a context size.\\n   */\\n  private async discoverServerContext(entry: Record<string, any>, signal?: AbortSignal): Promise<Advertisement | undefined> {\\n    const kind = serverKindOf(entry);\\n    if (kind !== \\\"llamacpp\\\" && kind !== \\\"lmstudio\\\" && kind !== \\\"ollama\\\") return undefined;\\n    const cacheKey = `${this.endpoint}::${this.model}`;\\n    const cached = LocalLlmClient.serverContextCache.get(cacheKey);\\n    if (cached) return cached;\\n    const root = this.endpoint.replace(/\\\\/v1\\\\/?$/, \\\"\\\");\\n    const probes: Array<{ kind: \\\"llamacpp\\\" | \\\"lmstudio\\\" | \\\"ollama\\\"; url: string; init?: RequestInit }> = [\\n      { kind: \\\"llamacpp\\\" as const, url: `${root}/props` },\\n      { kind: \\\"lmstudio\\\" as const, url: `${root}/api/v0/models` },\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1a331-c45a-70a3-a6bd-1ee2b1ee1a25","create_time":1793751549.8198113}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
