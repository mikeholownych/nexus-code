{"timestamp":"2026-11-03T19:53:30.921Z","ordinal":79590,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":1604886585,"cached_input_tokens":1593015936,"cache_write_input_tokens":0,"output_tokens":2802170,"reasoning_output_tokens":1429624,"total_tokens":1607688755},"last_token_usage":{"input_tokens":68157,"cached_input_tokens":65664,"cache_write_input_tokens":0,"output_tokens":158,"reasoning_output_tokens":148,"total_tokens":68315},"last_usage_includes_reasoning":true,"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":24.0,"window_minutes":300,"resets_at":1793740229},"secondary":{"used_percent":50.0,"window_minutes":10080,"resets_at":1794123386},"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"plus","rate_limit_reached_type":null}}}
