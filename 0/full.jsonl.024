 to the new origin\", async () => {\ncli/test/provider_connect.test.ts:491:  test(\"provisional local endpoint discovery authenticates in memory without persisting selection or key\", async () => {\ncli/test/provider_connect.test.ts:506:      resetApplianceEndpointOverride();\ncli/test/provider_connect.test.ts:665:  test(\"sidecar: local endpoint setup verifies and scopes a key, then exposes its models for selection\", async () => {\ncli/test/provider_connect.test.ts:786:    const listApplianceModels = async (id: string) => {\ncli/test/provider_connect.test.ts:796:      assert.deepEqual(await listApplianceModels(\"after-unrelated-cancel\"), [\"provisional-model\"], \"an unrelated cancel cannot clear the active setup\");\ncli/test/provider_connect.test.ts:798:      assert.deepEqual(await listApplianceModels(\"after-wrong-local-clear\"), [\"provisional-model\"], \"the explicit clear is also owner-correlated\");\ncli/test/provider_connect.test.ts:801:      assert.deepEqual(await listApplianceModels(\"after-local-picker-close\"), [\"previous-model\"], \"closing the owning picker restores prior routing\");\ncli/test/provider_connect.test.ts:812:  test(\"sidecar: cancelling local endpoint discovery prevents a late response from activating setup\", async () => {\ncore/src/bin/nexus_tui/live_view.rs:505:    (\"ctrl+p\", \"in /model: connect a provider (API key or sign-in); /connect opens it directly\"),\ncore/src/bin/nexus_tui/live_view.rs:3090:    const CATALOG: &str = r#\"{\"v\":1,\"type\":\"models.catalog\",\"id\":\"ID\",\"providers\":[{\"id\":\"appliance\",\"label\":\"Appliance (10.0.8.5:8443)\",\"disclosure\":\"local\",\"connected\":true,\"methods\":[],\"status\":\"ok\"},{\"id\":\"chatgpt\",\"label\":\"ChatGPT plan\",\"disclosure\":\"cloud\",\"connected\":true,\"source\":\"Codex CLI\",\"external\":true,\"methods\":[{\"id\":\"chatgpt-oauth\",\"label\":\"Sign in with ChatGPT (unofficial)\",\"kind\":\"browser\",\"unofficial\":true}],\"status\":\"ok\"},{\"id\":\"anthropic\",\"label\":\"Anthropic\",\"disclosure\":\"cloud\",\"connected\":false,\"methods\":[{\"id\":\"api-key\",\"label\":\"API key\",\"kind\":\"key\"}],\"status\":\"disconnected\"}],\"models\":[{\"provider\":\"appliance\",\"id\":\"engineering/b0\"},{\"provider\":\"chatgpt\",\"id\":\"gpt-5-codex\"}],\"current\":{\"provider\":\"appliance\",\"model\":\"engineering/b0\"},\"recent\":[]}\"#;\ncore/src/bin/nexus_tui/live_view.rs:3104:        assert!(screen.contains(\"Appliance (10.0.8.5:8443)\"), \"{screen}\");\ncore/src/bin/nexus_tui/live_view.rs:3122:        assert!(screen.contains(\"Appliance\"), \"the connect menu exposes local setup: {screen}\");\ncore/src/bin/nexus_tui/live_view.rs:3197:        Paragraph::new(key_hints(&[(\"enter\", \"use\"), (\"ctrl+p\", \"connect a provider\"), (\"↑↓\", \"move\"), (\"esc\", \"close\")])),\ncore/src/bin/nexus_tui/live_view.rs:3367:                None if method == \"local-endpoint\" => lines.push(Line::from(Span::styled(\"Checking the local endpoint and discovering models…\", white))),\ncore/src/bin/nexus_tui/protocol.rs:37:/// A way to connect a provider: an API key, a browser sign-in, or a device-code sign-in.\ncore/src/bin/nexus_tui/live_state.rs:385:    /// ctrl+p in the picker (or `/connect`): connect a provider.\ncore/src/bin/nexus_tui/live_state.rs:3990:    const CATALOG: &str = r#\"{\"v\":1,\"type\":\"models.catalog\",\"id\":\"ID\",\"providers\":[{\"id\":\"appliance\",\"label\":\"Appliance (10.0.8.5:8443)\",\"disclosure\":\"local\",\"connected\":true,\"methods\":[],\"status\":\"ok\"},{\"id\":\"chatgpt\",\"label\":\"ChatGPT plan\",\"disclosure\":\"cloud\",\"connected\":true,\"source\":\"Codex CLI\",\"external\":true,\"methods\":[{\"id\":\"chatgpt-oauth\",\"label\":\"Sign in with ChatGPT (unofficial)\",\"kind\":\"browser\",\"unofficial\":true}],\"status\":\"ok\"},{\"id\":\"anthropic\",\"label\":\"Anthropic\",\"disclosure\":\"cloud\",\"connected\":false,\"methods\":[{\"id\":\"api-key\",\"label\":\"API key\",\"kind\":\"key\"}],\"status\":\"disconnected\"}],\"models\":[{\"provider\":\"appliance\",\"id\":\"engineering/b0\"},{\"provider\":\"chatgpt\",\"id\":\"gpt-5-codex\"}],\"current\":{\"provider\":\"appliance\",\"model\":\"engineering/b0\"},\"recent\":[]}\"#;\ncore/src/bin/nexus_tui/live_state.rs:4046:        state.on_key(key(KeyCode::Down)); // local endpoint -> ChatGPT\ncore/src/bin/nexus_tui/live_state.rs:4062:        assert_eq!(state.on_key(key(KeyCode::Enter)), None, \"appliance opens local endpoint setup\");\ncore/src/bin/nexus_tui/live_state.rs:4072:        state.apply(ev(&format!(r#\"{{\"v\":1,\"type\":\"provider.result\",\"id\":\"{request}\",\"provider\":\"appliance\",\"success\":true,\"message\":\"Local endpoint ready (127.0.0.1; 2 models found). Choose a model to finish setup.\"}}\"#)));\n      }\n    },\n    (err) => ({ ok: false, message: `${def.label} sign-in failed: ${describe(err)}` }),\n  );\n  return { prompt: flow.prompt, done, cancel: () => { abort.abort(); flow.cancel(); } };\n}\n\nexport function disconnect(providerId: string): { ok: boolean; message: string } {\n  const def = providerDefinition(providerId);\n  if (!def) return { ok: false, message: `Unknown provider '${providerId}'.` };\n  const removed = removeCredential(providerId);\n  const still = resolveCredential(providerId, def.credentialEnv);\n  if (still) {\n    return {\n      ok: removed,\n      message: `${removed ? \"Removed Nexus's saved credential. \" : \"\"}${def.label} is still connected via ${still.source}; Nexus does not change ${still.kind === \"env\" ? \"your environment\" : \"other clients' sign-ins\"}.`,\n    };\n  }\n  return { ok: removed, message: removed ? `${def.label} disconnected.` : `${def.label} had no credential saved by Nexus.` };\n}\n\n/**\n * Switches the agent to `ref` — the operator's explicit choice, which authorizes that destination for this session.\n * Returns the operator-facing outcome.\n */\nexport function selectModel(agent: AutonomousAgent, config: HarnessConfig, ref: ModelRef): { ok: boolean; message: string } {\n  const model = ref.model.trim();\n  if (!model) return { ok: false, message: \"Choose a model.\" };\n  if (ref.provider === APPLIANCE) {\n    const a = applianceConfig(config);\n    const pendingSelection = applianceEndpointSelection();\n    if (pendingSelection?.persistModelOnSelection && originOf(a.endpoint) === originOf(pendingSelection.endpoint)) {\n      try {\n        const pendingKey = pendingApplianceEndpointKey(a.endpoint);\n        if (pendingKey) {\n          const committed = commitLocalEndpointSetup(a.endpoint, pendingKey, () => saveLocalEndpointSettings(a.endpoint, model));\n          if (!committed) return { ok: false, message: \"The endpoint was verified, but Nexus could not securely save the API key.\" };\n        } else {\n          saveLocalEndpointSettings(a.endpoint, model);\n        }\n        activateApplianceEndpoint(a.endpoint, model, false);\n        provisionalLocalEndpointRequestId = undefined;\n      } catch {\n        return { ok: false, message: \"The model is available for this session, but Nexus could not securely save the selection.\" };\n      }\n    }\n    agent.setInferenceTarget({\n      provider: undefined,\n      endpoint: a.endpoint,\n      model,\n      apiKey: a.apiKey,\n      credentialOrigin: a.credentialOrigin,\n      authorizedDisclosureOrigins: [...new Set([...(config.authorizedDisclosureOrigins ?? []), ...(a.authorizedDisclosureOrigins ?? []), ...(originOf(a.endpoint) ? [originOf(a.endpoint)!] : [])])],\n    });\n    recordRecent({ provider: APPLIANCE, model });\n    const disclosure = disclosureClass(a.endpoint, undefined, config.cloudRoutedOrigins);\n    return {\n      ok: true,\n      message: disclosure === \"cloud\"\n        ? `Model: ${model} via the configured endpoint. Task content will be sent there.`\n        : `Model: ${model} on the local appliance.`,\n    };\n  }\n  const def = providerDefinition(ref.provider);\n  if (!def) return { ok: false, message: `Unknown provider '${ref.provider}'.` };\n  if (!connectionOf(def.id).connected) return { ok: false, message: `${def.label} is not connected. Open /model and press ctrl+p to connect it.` };\n            \"Continue without checkpoint\",\n            \"Create checkpoint anyway\",\n            \"Cancel this turn\",\n            \"Other (re-enter instruction)\",\n        ]\n    };\n    // The modal has one border cell on each side and one column of margin on each side.\n    // Pre-wrap every line at the actual inner width so the height estimate includes wrapped text.\n    let width = area.width.saturating_sub(4).max(1);\n    // The sidecar message enumerates every choice for non-TUI clients. This modal\n    // renders those choices separately, so keep the explanation compact enough for 40x14.\n    let display_message = if message.starts_with(\"Sensitive content blocked the checkpoint\") {\n        \"Sensitive content may persist if you create a checkpoint anyway.\".to_owned()\n    } else if let Some(failure) = message.strip_prefix(\"Checkpoint failed: \") {\n        let failure = failure.split(\". Choose \").next().unwrap_or(failure);\n        let failure = failure.strip_suffix(\". No checkpoint was written.\").unwrap_or(failure);\n        format!(\"Checkpoint failed: {failure}. Retry keeps the sensitive-data choice unchanged.\")\n    } else {\n        message.to_owned()\n    };\n    let mut lines = markdown::wrap(\n        vec![Span::raw(display_message)],\n        usize::from(width),\n        Vec::new(),\n        Vec::new(),\n    );\n    for (index, option) in options.iter().enumerate() {\n        let marker = if selected == Some(index) { \"▸\" } else { \" \" };\n        let style = Style::default().fg(Color::White);\n        lines.extend(markdown::wrap(\n            vec![Span::styled(\n                format!(\"{marker} {}. {option}\", index + 1),\n                style,\n            )],\n            usize::from(width),\n            Vec::new(),\n            Vec::new(),\n        ));\n    }\n    lines.push(Line::from(Span::styled(\n        \"1–5 choose · enter · esc cancel\",\n        key,\n    )));\n    let height = u16::try_from(lines.len() + 2)\n        .unwrap_or(area.height)\n        .min(area.height);\n    let rect = modal(area, 92, height);\n    let block = modal_block(\" Checkpoint could not be created \");\n    let inner = block.inner(rect);\n    frame.render_widget(Clear, rect);\n    frame.render_widget(block, rect);\n    frame.render_widget(Paragraph::new(lines).wrap(Wrap { trim: false }), inner);\n    usize::from(inner.height)\n}\n\n/// The complete diff of one operation (or the cumulative workspace diff), with hunk and file/edit navigation,\n/// vertical and horizontal scrolling and a wrap toggle. Returns the body rows, the largest useful `top` and the\n/// largest useful `left`.\nfn render_review(frame: &mut Frame, area: Rect, state: &LiveState, review: &DiffReview) -> (usize, usize, usize) {\n    let pal = diff_view::palette(state.depth);\n    let muted = Style::default().fg(MUTED);\n    let key = Style::default().fg(ACCENT).add_modifier(Modifier::BOLD);\n    // The whole transcript area: tinted transcript rows never show beside the panel.\n    let rect = area;\n    let (title, between) = match &review.scope {\n        ReviewScope::Operation { .. } => (\" Edit diff · this operation only \", \"edit\"),\n        ReviewScope::Workspace { .. } => (\" Workspace diff · unstaged changes to tracked files (git diff) \", \"file\"),\n    };\n    let mut keys = vec![Span::styled(\" esc\", key), Span::raw(\" back  \"), Span::styled(\"↑↓\", key), Span::raw(\" scroll  \")];\n    if !review.wrap {\n        keys.extend([Span::styled(\"←→\", key), Span::raw(\" pan  \")]);\n    }\n    keys.extend([Span::styled(\"n p\", key), Span::raw(\" hunk  \"), Span::styled(\"[ ]\", key), Span::raw(format!(\" {between}  \"))]);\n    keys.extend([Span::styled(\"w\", key), Span::raw(if review.wrap { \" no wrap \" } else { \" wrap \" })]);\n    if matches!(review.scope, ReviewScope::Operation { .. }) {\n        keys.extend([Span::raw(\" \"), Span::styled(\"i\", key), Span::raw(\" call \")]);\n    }\n    let mut block = Block::bordered()\n        .border_type(BorderType::Rounded)\n        .border_style(Style::default().fg(ACCENT))\n        .title(Span::styled(title, Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)))\n        .title_bottom(Line::from(keys));\n    let inner_width = usize::from(rect.width.saturating_sub(2));\n    // The heading: what is shown, the operation's place among this session's edits, and any limit on it.\n    let mut head: Vec<Line> = Vec::new();\n    match &review.scope {\n        ReviewScope::Operation { entry, path } => {\n            let card = state.transcript.get(*entry).and_then(Entry::card);\n            let edits: Vec<usize> = state.transcript.iter().enumerate().filter(|(_, e)| e.card().is_some()).map(|(i, _)| i).collect();\n            let rank = edits.iter().position(|i| i == entry).map_or(0, |p| p + 1);\n            let (status, mut counts) = card.map_or((diff_view::Status::Modified, None), |c| (c.status(), c.note.is_none().then_some((c.added as usize, c.removed as usize))));\n","exit_code":0,"duration":{"secs":0,"nanos":770773009}},"started_at_ms":1793036562541,"completed_at_ms":1793036563313}}
