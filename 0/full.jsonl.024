module}.${name}`)) return true;\n+      }\n+      continue;\n+    }\n+\n+    const directImport = line.match(/^import\\s+(.+)$/);\n+    if (!directImport) continue;\n+    for (const part of directImport[1].split(\",\")) {\n+      const name = part.trim().split(/\\s+as\\s+/i, 1)[0];\n+      if (moduleMatchesTarget(name)) return true;\n+    }\n+  }\n+  return false;\n+}\n+\n+/**\n  * Extract workspace-relative path tokens from command and output.\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /home/mike/nexus-wt/python-verifier-binding/cli/src/tester.ts\n","stderr":""},"started_at_ms":1793068509959,"completed_at_ms":1793068509961}}
