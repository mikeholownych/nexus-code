{"timestamp":"2026-10-26T15:59:25.241Z","ordinal":392757,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a178d5-a588-7873-8790-fb703eb53a02","item":{"type":"CommandExecution","id":"exec-7d02c5b5-74fa-4417-91bd-ba06de56350a","process_id":"53074","command":["/usr/bin/zsh","-lc","sed -n '620,810p' cli/src/upgrade.ts && sed -n '45,210p' cli/test/upgrade_safety.test.ts && cat .git/nexus-claims/DEFECT_UPGRADE_RESET_RETRY_20261026/owner.json 2>/dev/null; cat .git/nexus-claims/FILE_cli_src_upgrade.ts/owner.json"],"cwd":"file:///home/mike/nexus-wt/upgrade-tui-contamination","parsed_cmd":[{"type":"unknown","cmd":"sed -n '620,810p' cli/src/upgrade.ts && sed -n '45,210p' cli/test/upgrade_safety.test.ts && cat .git/nexus-claims/DEFECT_UPGRADE_RESET_RETRY_20261026/owner.json 2>/dev/null; cat .git/nexus-claims/FILE_cli_src_upgrade.ts/owner.json"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"// Download, Verification, and Atomic Installation\n// -----------------------------------------------------------------------------\n\nexport function validateDownloadUrl(urlString: string): boolean {\n  let parsed: URL;\n  try {\n    parsed = new URL(urlString);\n  } catch {\n    return false;\n  }\n\n  // Reject URLs with embedded credentials (user:REDACTED@...)\n  if (parsed.username || parsed.REDACTEDword) {\n    return false;\n  }\n\n  const hostname = parsed.hostname.toLowerCase();\n\n  // Test / override environments: allow custom release base URL or releases API host\n  const customBase = process.env.NEXUS_RELEASE_BASE_URL || process.env.NEXUS_RELEASES_URL || process.env.NEXUS_RELEASES_API;\n  if (customBase) {\n    try {\n      const customParsed = new URL(customBase);\n      if (hostname === customParsed.hostname.toLowerCase()) {\n        if (parsed.protocol === \"https:\" || parsed.protocol === \"http:\") {\n          return true;\n        }\n      }\n    } catch {}\n  }\n\n  // Localhost allowed for local mock testing\n  if (hostname === \"127.0.0.1\" || hostname === \"localhost\") {\n    return parsed.protocol === \"http:\" || parsed.protocol === \"https:\";\n  }\n\n  // GitHub allowed domains - must be HTTPS\n  if (parsed.protocol !== \"https:\") {\n    return false;\n  }\n\n  if (hostname === \"github.com\") {\n    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n  }\n\n  if (hostname === \"objects.githubusercontent.com\") {\n    return true;\n  }\n\n  // GitHub now redirects release downloads to its signed release-assets host.\n  // Restrict the path to release objects; never allow this host as a generic CDN.\n  if (hostname === \"release-assets.githubusercontent.com\") {\n    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n  }\n\n  return false;\n}\n\n/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\nfunction safeDownloadOrigin(urlString: string): string {\n  try {\n    return new URL(urlString).origin;\n  } catch {\n    return \"invalid URL\";\n  }\n}\n\nfunction isDownloadConnectionReset(error: any): boolean {\n  for (let current = error; current; current = current.cause) {\n    if (current.code === \"ECONNRESET\" || current.code === \"UND_ERR_SOCKET\") return true;\n  }\n  return false;\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n  let connectionResets = 0;\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\n  if (signal) {\n    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n  }\n\n  try {\n    while (hops <= maxHops) {\n      if (!validateDownloadUrl(currentUrl)) {\n        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n      }\n\n      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n        headers.Authorization = `Bearer ${token}`;\n      }\n\n      let res: Response;\n      try {\n        res = await fetch(currentUrl, {\n          headers,\n          signal: controller.signal,\n          redirect: \"manual\",\n        });\n      } catch (error) {\n        if (connectionResets < 1 && isDownloadConnectionReset(error)) {\n          connectionResets++;\n          continue;\n        }\n        throw error;\n      }\n\n      // Handle redirect\n      if (res.status === 301 || res.status === 302 || res.status === 307 || res.status === 308) {\n        const location = res.headers.get(\"location\");\n        if (!location) {\n          throw new Error(`HTTP ${res.status} redirect without Location header from ${safeDownloadOrigin(currentUrl)}`);\n        }\n        currentUrl = new URL(location, currentUrl).toString();\n        hops++;\n        continue;\n      }\n\n      if (!res.ok) {\n        throw new Error(`HTTP ${res.status} downloading from ${safeDownloadOrigin(currentUrl)}`);\n      }\n\n      const contentLengthHeader = res.headers.get(\"content-length\");\n      if (contentLengthHeader) {\n        const contentLength = parseInt(contentLengthHeader, 10);\n        if (contentLength > MAX_DOWNLOAD_BYTES) {\n          throw new Error(`Download size (${contentLength} bytes) exceeds maximum allowed limit (${MAX_DOWNLOAD_BYTES} bytes)`);\n        }\n      }\n\n      const fileStream = fs.createWriteStream(destPath);\n      if (!res.body) {\n        throw new Error(`Empty body downloading from ${safeDownloadOrigin(currentUrl)}`);\n      }\n\n      let bytesDownloaded = 0;\n      const reader = res.body.getReader();\n\n      try {\n        await new Promise<void>((resolve, reject) => {\n          fileStream.on(\"error\", reject);\n          fileStream.on(\"finish\", () => resolve());\n          function pump() {\n            reader.read().then(({ done, value }) => {\n              if (done) {\n                fileStream.end();\n                return;\n              }\n              bytesDownloaded += value.byteLength;\n              if (bytesDownloaded > MAX_DOWNLOAD_BYTES) {\n                reject(new Error(`Download exceeded maximum limit of ${MAX_DOWNLOAD_BYTES} bytes`));\n                return;\n              }\n              fileStream.write(Buffer.from(value), (err) => {\n                if (err) reject(err);\n                else pump();\n              });\n            }).catch(reject);\n          }\n          pump();\n        });\n      } catch (streamErr) {\n        try { fs.unlinkSync(destPath); } catch {}\n        throw streamErr;\n      }\n\n      return;\n    }\n\n    throw new Error(`Too many redirects (exceeded ${maxHops} hops) while downloading`);\n  } finally {\n    clearTimeout(timer);\n  }\n}\n\nexport function computeSha256(filePath: string): string {\n  const hash = crypto.createHash(\"sha256\");\n  const data = fs.readFileSync(filePath);\n  hash.update(data);\n  return hash.digest(\"hex\");\n  recoverUpgrade,\n  UpgradeJournalEntry,\n} from \"../src/upgrade_journal.js\";\n\nfunction completeRuntimeFixture(directory: string, version: string): void {\n  for (const sub of [\"bin\", \"lib/core\", \"lib/cli/dist\"]) fs.mkdirSync(path.join(directory, sub), { recursive:true });\n  fs.writeFileSync(path.join(directory, \"VERSION\"), version);\n  fs.writeFileSync(path.join(directory, \"lib/cli/dist/index.js\"), \"// fixture CLI payload\\n\");\n  fs.writeFileSync(path.join(directory, \"bin/nexus\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/harness-core\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/nexus-tui\"), `#!/bin/sh\\nif [ \"$1\" = --version ]; then echo ${version}; else echo NEXUS; fi\\n`, { mode:0o755 });\n}\n\ndescribe(\"Download Origin, Redirect & Bounds Safety (REQ-REL-116, ACC-UPG-08)\", () => {\n  it(\"validates allowed release download origins\", () => {\n    // Official GitHub releases\n    assert.equal(\n      validateDownloadUrl(\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0/nexus-linux-x86_64-v1.0.0.tar.gz\"),\n      true\n    );\n    // GitHub release CDN redirect host\n    assert.equal(\n      validateDownloadUrl(\"https://objects.githubusercontent.com/github-production-release-asset-2e65be/12345/nexus.tar.gz\"),\n      true\n    );\n    // Newer GitHub releases redirect to a signed, release-specific asset host.\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/github-production-release-asset/12345/a1111111-1111-4111-8111-111111111111\"),\n      true\n    );\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/other-content/payload.tar.gz\"),\n      false\n    );\n    assert.equal(\n      validateDownloadUrl(\"http://release-assets.githubusercontent.com/github-production-release-asset/12345/asset\"),\n      false\n    );\n    // Localhost allowed for mock test servers\n    assert.equal(validateDownloadUrl(\"http://127.0.0.1:4567/download/v1.0.0/nexus.tar.gz\"), true);\n    assert.equal(validateDownloadUrl(\"http://localhost:4567/download/v1.0.0/nexus.tar.gz\"), true);\n\n    // Disallowed origins\n    assert.equal(validateDownloadUrl(\"https://evil.com/releases/download/nexus.tar.gz\"), false);\n    assert.equal(validateDownloadUrl(\"https://github.com/attacker/nexus-code/releases/download/nexus.tar.gz\"), false);\n    // Reject plain HTTP for remote github.com\n    assert.equal(validateDownloadUrl(\"http://github.com/mikeholownych/nexus-code/releases/download/v1.0.0/nexus.tar.gz\"), false);\n    // Reject embedded credentials\n    assert.equal(validateDownloadUrl(\"REDACTED\"), false);\n  });\n\n  it(\"rejects downloads redirecting to disallowed hosts or exceeding hop limits\", async () => {\n    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-test-\"));\n    let server: http.Server | null = null;\n\n    try {\n      // 1. Server redirecting to evil.com\n      const evilPort = await new Promise<number>((resolve) => {\n        server = http.createServer((req, res) => {\n          if (req.url === \"/redirect-evil\") {\n            res.writeHead(302, { Location: \"https://evil-untrusted-site.com/payload.tar.gz\" });\n            res.end();\n          } else if (req.url === \"/redirect-evil-signed\") {\n            res.writeHead(302, { Location: \"https://evil-untrusted-site.com/payload.tar.gz?token=must-not-appear\" });\n            res.end();\n          } else if (req.url?.startsWith(\"/loop-\")) {\n            const count = parseInt(req.url.replace(\"/loop-\", \"\"), 10);\n            res.writeHead(302, { Location: `http://127.0.0.1:${evilPort}/loop-${count + 1}` });\n            res.end();\n          } else {\n            res.writeHead(404);\n            res.end();\n          }\n        });\n        server.listen(0, \"127.0.0.1\", () => {\n          const addr = server!.address() as any;\n          resolve(addr.port);\n        });\n      });\n\n      const dest1 = path.join(testDir, \"test1.tar.gz\");\n      await assert.rejects(\n        downloadFile(`http://127.0.0.1:${evilPort}/redirect-evil`, dest1, undefined, 5000),\n        /Disallowed download origin or invalid URL/\n      );\n\n      const secretUrl = `http://127.0.0.1:${evilPort}/redirect-evil-signed`;\n      await assert.rejects(downloadFile(secretUrl, path.join(testDir, \"signed.tar.gz\"), undefined, 5000), (error: Error) => {\n        assert.match(error.message, /Disallowed download origin or invalid URL \\(https:\\/\\/evil-untrusted-site\\.com\\)/);\n        assert.doesNotMatch(error.message, /must-not-appear/);\n        return true;\n      });\n\n      // 2. Too many redirects\n      const dest2 = path.join(testDir, \"test2.tar.gz\");\n      await assert.rejects(\n        downloadFile(`http://127.0.0.1:${evilPort}/loop-0`, dest2, undefined, 5000, 3),\n        /Too many redirects/\n      );\n    } finally {\n      if (server) {\n        await new Promise<void>((resolve) => server!.close(() => resolve()));\n      }\n      fs.rmSync(testDir, { recursive: true, force: true });\n    }\n  });\n\n  it(\"follows the allowlisted signed GitHub release-asset redirect without forwarding credentials\", async () => {\n    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-release-asset-\"));\n    const originalFetch = globalThis.fetch;\n    const originalToken = process.env.GITHUB_TOKEN;\n    const requests: Array<{ url: string; authorization: string | null; redirect: string | undefined }> = [];\n    const downloadUrl = \"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.8/nexus.tar.gz\";\n    const signedAssetUrl = \"https://release-assets.githubusercontent.com/github-production-release-asset/1416386345/11111111-2222-4333-8444-555555555555?token=synthetic-signature\";\n\n    try {\n      process.env.GITHUB_TOKEN = \"REDACTED\";\n      globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit) => {\n        const url = String(input);\n        requests.push({\n          url,\n          authorization: new Headers(init?.headers).get(\"authorization\"),\n          redirect: init?.redirect,\n        });\n        if (url === downloadUrl) {\n          return new Response(null, { status: 302, headers: { location: signedAssetUrl } });\n        }\n        if (url === signedAssetUrl) {\n          return new Response(new Uint8Array([0x4e, 0x58, 0x53]), { status: 200 });\n        }\n        throw new Error(`Unexpected mocked download URL: ${new URL(url).origin}`);\n      }) as typeof globalThis.fetch;\n\n      const destination = path.join(testDir, \"release.tar.gz\");\n      await downloadFile(\n        downloadUrl,\n        destination,\n      );\n\n      assert.deepEqual(requests, [\n        {\n          url: downloadUrl,\n          authorization: \"Bearer synthetic-github-token\",\n          redirect: \"manual\",\n        },\n        { url: signedAssetUrl, authorization: null, redirect: \"manual\" },\n      ]);\n      assert.deepEqual(fs.readFileSync(destination), Buffer.from([0x4e, 0x58, 0x53]));\n    } finally {\n      globalThis.fetch = originalFetch;\n      if (originalToken === undefined) delete process.env.GITHUB_TOKEN;\n      else process.env.GITHUB_TOKEN = REDACTED;\n      fs.rmSync(testDir, { recursive: true, force: true });\n    }\n  });\n});\n\ndescribe(\"Tar Archive Structural Safety Engine (REQ-REL-116, ACC-UPG-08)\", () => {\n  let tmpRoot: string;\n\n  beforeEach(() => {\n    tmpRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-tar-safety-\"));\n  });\n\n  afterEach(() => {\n    fs.rmSync(tmpRoot, { recursive: true, force: true });\ncat: .git/nexus-claims/FILE_cli_src_upgrade.ts/owner.json: Not a directory\n","exit_code":1,"duration":{"secs":0,"nanos":734673558}},"started_at_ms":1793030364506,"completed_at_ms":1793030365241}}
{"timestamp":"2026-10-26T15:59:26.254Z","ordinal":392758,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a178f0-242e-72e3-aa5c-2bb9c2dd8d76","call_id":"call_c5d6e37d9b55471f901e5c92c9051057","output":[{"type":"input_text","text":"Script completed\nWall time 3.1 seconds\nOutput:\n"},{"type":"input_text","text":"// Download, Verification, and Atomic Installation\n// -----------------------------------------------------------------------------\n\nexport function validateDownloadUrl(urlString: string): boolean {\n  let parsed: URL;\n  try {\n    parsed = new URL(urlString);\n  } catch {\n    return false;\n  }\n\n  // Reject URLs with embedded credentials (user:REDACTED@...)\n  if (parsed.username || parsed.REDACTEDword) {\n    return false;\n  }\n\n  const hostname = parsed.hostname.toLowerCase();\n\n  // Test / override environments: allow custom release base URL or releases API host\n  const customBase = process.env.NEXUS_RELEASE_BASE_URL || process.env.NEXUS_RELEASES_URL || process.env.NEXUS_RELEASES_API;\n  if (customBase) {\n    try {\n      const customParsed = new URL(customBase);\n      if (hostname === customParsed.hostname.toLowerCase()) {\n        if (parsed.protocol === \"https:\" || parsed.protocol === \"http:\") {\n          return true;\n        }\n      }\n    } catch {}\n  }\n\n  // Localhost allowed for local mock testing\n  if (hostname === \"127.0.0.1\" || hostname === \"localhost\") {\n    return parsed.protocol === \"http:\" || parsed.protocol === \"https:\";\n  }\n\n  // GitHub allowed domains - must be HTTPS\n  if (parsed.protocol !== \"https:\") {\n    return false;\n  }\n\n  if (hostname === \"github.com\") {\n    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n  }\n\n  if (hostname === \"objects.githubusercontent.com\") {\n    return true;\n  }\n\n  // GitHub now redirects release downloads to its signed release-assets host.\n  // Restrict the path to release objects; never allow this host as a generic CDN.\n  if (hostname === \"release-assets.githubusercontent.com\") {\n    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n  }\n\n  return false;\n}\n\n/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\nfunction safeDownloadOrigin(urlString: string): string {\n  try {\n    return new URL(urlString).origin;\n  } catch {\n    return \"invalid URL\";\n  }\n}\n\nfunction isDownloadConnectionReset(error: any): boolean {\n  for (let current = error; current; current = current.cause) {\n    if (current.code === \"ECONNRESET\" || current.code === \"UND_ERR_SOCKET\") return true;\n  }\n  return false;\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n  let connectionResets = 0;\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\n  if (signal) {\n    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n  }\n\n  try {\n    while (hops <= maxHops) {\n      if (!validateDownloadUrl(currentUrl)) {\n        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n      }\n\n      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n        headers.Authorization = `Bearer ${token}`;\n      }\n\n      let res: Response;\n      try {\n        res = await fetch(currentUrl, {\n          headers,\n          signal: controller.signal,\n          redirect: \"manual\",\n        });\n      } catch (error) {\n        if (connectionResets < 1 && isDownloadConnectionReset(error)) {\n          connectionResets++;\n          continue;\n        }\n        throw error;\n      }\n\n      // Handle redirect\n      if (res.status === 301 || res.status === 302 || res.status === 307 || res.status === 308) {\n        const location = res.headers.get(\"location\");\n        if (!location) {\n          throw new Error(`HTTP ${res.status} redirect without Location header from ${safeDownloadOrigin(currentUrl)}`);\n        }\n        currentUrl = new URL(location, currentUrl).toString();\n        hops++;\n        continue;\n      }\n\n      if (!res.ok) {\n        throw new Error(`HTTP ${res.status} downloading from ${safeDownloadOrigin(currentUrl)}`);\n      }\n\n      const contentLengthHeader = res.headers.get(\"content-length\");\n      if (contentLengthHeader) {\n        const contentLength = parseInt(contentLengthHeader, 10);\n        if (contentLength > MAX_DOWNLOAD_BYTES) {\n          throw new Error(`Download size (${contentLength} bytes) exceeds maximum allowed limit (${MAX_DOWNLOAD_BYTES} bytes)`);\n        }\n      }\n\n      const fileStream = fs.createWriteStream(destPath);\n      if (!res.body) {\n        throw new Error(`Empty body downloading from ${safeDownloadOrigin(currentUrl)}`);\n      }\n\n      let bytesDownloaded = 0;\n      const reader = res.body.getReader();\n\n      try {\n        await new Promise<void>((resolve, reject) => {\n          fileStream.on(\"error\", reject);\n          fileStream.on(\"finish\", () => resolve());\n          function pump() {\n            reader.read().then(({ done, value }) => {\n              if (done) {\n                fileStream.end();\n                return;\n              }\n              bytesDownloaded += value.byteLength;\n              if (bytesDownloaded > MAX_DOWNLOAD_BYTES) {\n                reject(new Error(`Download exceeded maximum limit of ${MAX_DOWNLOAD_BYTES} bytes`));\n                return;\n              }\n              fileStream.write(Buffer.from(value), (err) => {\n                if (err) reject(err);\n                else pump();\n              });\n            }).catch(reject);\n          }\n          pump();\n        });\n      } catch (streamErr) {\n        try { fs.unlinkSync(destPath); } catch {}\n        throw streamErr;\n      }\n\n      return;\n    }\n\n    throw new Error(`Too many redirects (exceeded ${maxHops} hops) while downloading`);\n  } finally {\n    clearTimeout(timer);\n  }\n}\n\nexport function computeSha256(filePath: string): string {\n  const hash = crypto.createHash(\"sha256\");\n  const data = fs.readFileSync(filePath);\n  hash.update(data);\n  return hash.digest(\"hex\");\n  recoverUpgrade,\n  UpgradeJournalEntry,\n} from \"../src/upgrade_journal.js\";\n\nfunction completeRuntimeFixture(directory: string, version: string): void {\n  for (const sub of [\"bin\", \"lib/core\", \"lib/cli/dist\"]) fs.mkdirSync(path.join(directory, sub), { recursive:true });\n  fs.writeFileSync(path.join(directory, \"VERSION\"), version);\n  fs.writeFileSync(path.join(directory, \"lib/cli/dist/index.js\"), \"// fixture CLI payload\\n\");\n  fs.writeFileSync(path.join(directory, \"bin/nexus\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/harness-core\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/nexus-tui\"), `#!/bin/sh\\nif [ \"$1\" = --version ]; then echo ${version}; else echo NEXUS; fi\\n`, { mode:0o755 });\n}\n\ndescribe(\"Download Origin, Redirect & Bounds Safety (REQ-REL-116, ACC-UPG-08)\", () => {\n  it(\"validates allowed release download origins\", () => {\n    // Official GitHub releases\n    assert.equal(\n      validateDownloadUrl(\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0/nexus-linux-x86_64-v1.0.0.tar.gz\"),\n      true\n    );\n    // GitHub release CDN redirect host\n    assert.equal(\n      validateDownloadUrl(\"https://objects.githubusercontent.com/github-production-release-asset-2e65be/12345/nexus.tar.gz\"),\n      true\n    );\n    // Newer GitHub releases redirect to a signed, release-specific asset host.\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/github-production-release-asset/12345/a1111111-1111-4111-8111-111111111111\"),\n      true\n    );\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/other-content/payload.tar.gz\"),\n      false\n    );\n    assert.equal(\n      validateDownloadUrl(\"http://release-assets.githubusercontent.com/github-production-release-asset/12345/asset\"),\n      false\n    );\n    // Localhost allowed for mock test servers\n    assert.equal(validateDownloadUrl(\"http://127.0.0.1:4567/download/v1.0.0/nexus.tar.gz\"), true);\n    assert.equal(validateDownloadUrl(\"http://localhost:4567/download/v1.0.0/nexus.tar.gz\"), true);\n\n    // Disallowed origins\n    assert.equal(validateDownloadUrl(\"https://evil.com/releases/download/nexus.tar.gz\"), false);\n    assert.equal(validateDownloadUrl(\"https://github.com/attacker/nexus-code/releases/download/nexus.tar.gz\"), false);\n    // Reject plain HTTP for remote github.com\n    assert.equal(validateDownloadUrl(\"http://github.com/mikeholownych/nexus-code/releases/download/v1.0.0/nexus.tar.gz\"), false);\n    // Reject embedded credentials\n    assert.equal(validateDownloadUrl(\"REDACTED\"), false);\n  });\n\n  it(\"rejects downloads redirecting to disallowed hosts or exceeding hop limits\", async () => {\n    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-test-\"));\n    let server: http.Server | null = null;\n\n    try {\n      // 1. Server redirecting to evil.com\n      const evilPort = await new Promise<number>((resolve) => {\n        server = http.createServer((req, res) => {\n          if (req.url === \"/redirect-evil\") {\n            res.writeHead(302, { Location: \"https://evil-untrusted-site.com/payload.tar.gz\" });\n            res.end();\n          } else if (req.url === \"/redirect-evil-signed\") {\n            res.writeHead(302, { Location: \"https://evil-untrusted-site.com/payload.tar.gz?token=must-not-appear\" });\n            res.end();\n          } else if (req.url?.startsWith(\"/loop-\")) {\n            const count = parseInt(req.url.replace(\"/loop-\", \"\"), 10);\n            res.writeHead(302, { Location: `http://127.0.0.1:${evilPort}/loop-${count + 1}` });\n            res.end();\n          } else {\n            res.writeHead(404);\n            res.end();\n          }\n        });\n        server.listen(0, \"127.0.0.1\", () => {\n          const addr = server!.address() as any;\n          resolve(addr.port);\n        });\n      });\n\n      const dest1 = path.join(testDir, \"test1.tar.gz\");\n      await assert.rejects(\n        downloadFile(`http://127.0.0.1:${evilPort}/redirect-evil`, dest1, undefined, 5000),\n        /Disallowed download origin or invalid URL/\n      );\n\n      const secretUrl = `http://127.0.0.1:${evilPort}/redirect-evil-signed`;\n      await assert.rejects(downloadFile(secretUrl, path.join(testDir, \"signed.tar.gz\"), undefined, 5000), (error: Error) => {\n        assert.match(error.message, /Disallowed download origin or invalid URL \\(https:\\/\\/evil-untrusted-site\\.com\\)/);\n        assert.doesNotMatch(error.message, /must-not-appear/);\n        return true;\n      });\n\n      // 2. Too many redirects\n      const dest2 = path.join(testDir, \"test2.tar.gz\");\n      await assert.rejects(\n        downloadFile(`http://127.0.0.1:${evilPort}/loop-0`, dest2, undefined, 5000, 3),\n        /Too many redirects/\n      );\n    } finally {\n      if (server) {\n        await new Promise<void>((resolve) => server!.close(() => resolve()));\n      }\n      fs.rmSync(testDir, { recursive: true, force: true });\n    }\n  });\n\n  it(\"follows the allowlisted signed GitHub release-asset redirect without forwarding credentials\", async () => {\n    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-release-asset-\"));\n    const originalFetch = globalThis.fetch;\n    const originalToken = process.env.GITHUB_TOKEN;\n    const requests: Array<{ url: string; authorization: string | null; redirect: string | undefined }> = [];\n    const downloadUrl = \"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.8/nexus.tar.gz\";\n    const signedAssetUrl = \"https://release-assets.githubusercontent.com/github-production-release-asset/1416386345/11111111-2222-4333-8444-555555555555?token=synthetic-signature\";\n\n    try {\n      process.env.GITHUB_TOKEN = \"REDACTED\";\n      globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit) => {\n        const url = String(input);\n        requests.push({\n          url,\n          authorization: new Headers(init?.headers).get(\"authorization\"),\n          redirect: init?.redirect,\n        });\n        if (url === downloadUrl) {\n          return new Response(null, { status: 302, headers: { location: signedAssetUrl } });\n        }\n        if (url === signedAssetUrl) {\n          return new Response(new Uint8Array([0x4e, 0x58, 0x53]), { status: 200 });\n        }\n        throw new Error(`Unexpected mocked download URL: ${new URL(url).origin}`);\n      }) as typeof globalThis.fetch;\n\n      const destination = path.join(testDir, \"release.tar.gz\");\n      await downloadFile(\n        downloadUrl,\n        destination,\n      );\n\n      assert.deepEqual(requests, [\n        {\n          url: downloadUrl,\n          authorization: \"Bearer synthetic-github-token\",\n          redirect: \"manual\",\n        },\n        { url: signedAssetUrl, authorization: null, redirect: \"manual\" },\n      ]);\n      assert.deepEqual(fs.readFileSync(destination), Buffer.from([0x4e, 0x58, 0x53]));\n    } finally {\n      globalThis.fetch = originalFetch;\n      if (originalToken === undefined) delete process.env.GITHUB_TOKEN;\n      else process.env.GITHUB_TOKEN = REDACTED;\n      fs.rmSync(testDir, { recursive: true, force: true });\n    }\n  });\n});\n\ndescribe(\"Tar Archive Structural Safety Engine (REQ-REL-116, ACC-UPG-08)\", () => {\n  let tmpRoot: string;\n\n  beforeEach(() => {\n    tmpRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-tar-safety-\"));\n  });\n\n  afterEach(() => {\n    fs.rmSync(tmpRoot, { recursive: true, force: true });\ncat: .git/nexus-claims/FILE_cli_src_upgrade.ts/owner.json: Not a directory\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a178d5-a588-7873-8790-fb703eb53a02","create_time":1793030366.2546735}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
