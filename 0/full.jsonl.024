ed.\n18: * VERIFIED        - the verifier selected for this workspace ran and passed against the current changes\n19: * UNVERIFIED      - work ended with a result that was not (or could not be) verified; see reason. Either changes\n22: * NOT_ESTABLISHED - no engineering result was established (turn did not complete, or verifier failed)\n25:export type EngineeringOutcome = \"VERIFIED\" | \"REGRESSION_FREE\" | \"UNVERIFIED\" | \"NOT_ESTABLISHED\" | \"NOT_REQUIRED\";\n156: * the rest are final. Created only when a submission fails.\n195:   * passed before, check it — the turn is then REGRESSION_FREE, not VERIFIED.\n239:  outcome: EngineeringOutcome;\n244:  /** True only if the final model response was received completely (positive protocol evidence). */\n245:  finalOutputComplete: boolean;\n301:   * Tool outputs that left the context during the turn and were not read again, when the turn still ended VERIFIED or\n325:  if (t.outcome === \"VERIFIED\") {\n326:    if (t.execution !== \"COMPLETED\") throw new TurnResultInvariantError(\"VERIFIED requires execution COMPLETED\");\n329:      throw new TurnResultInvariantError(\"VERIFIED requires passing verifier evidence\");\n331:    if (t.unverifiedChangesPending) throw new TurnResultInvariantError(\"VERIFIED conflicts with pending unverified changes\");\n333:  if (t.outcome === \"REGRESSION_FREE\") {\n340:  if (t.outcome === \"NOT_REQUIRED\" && (t.execution !== \"COMPLETED\" || t.unverifiedChangesPending)) {\n344:  if (t.execution === \"INTERRUPTED\" && t.outcome !== \"NOT_ESTABLISHED\") {\n345:    throw new TurnResultInvariantError(\"INTERRUPTED must not claim an engineering outcome\");\n347:  if (t.execution === \"BLOCKED\" && t.outcome !== \"NOT_ESTABLISHED\") {\n348:    throw new TurnResultInvariantError(\"BLOCKED must not claim an engineering outcome\");\n350:  if (t.execution === \"FAILED\" && t.outcome !== \"NOT_ESTABLISHED\") {\n351:    throw new TurnResultInvariantError(\"FAILED must not claim an engineering outcome\");\n367:    if (t.outcome === \"VERIFIED\" || t.outcome === \"NOT_REQUIRED\") return 0;\n368:    if (t.outcome === \"REGRESSION_FREE\" || t.outcome === \"UNVERIFIED\") return 2;\n398:    return { heading: \"TURN INTERRUPTED\", line: `execution=INTERRUPTED outcome=NOT_ESTABLISHED${extra}; ${i?.undispatchedToolCalls ?? 0} tool call(s) not dispatched` };\n400:  if (exec === \"FAILED\") return { heading: \"TURN FAILED\", line: `execution=FAILED outcome=NOT_ESTABLISHED${tail}` };\n407:        line: `execution=BLOCKED outcome=NOT_ESTABLISHED (CONTEXT_CAPACITY_EXCEEDED: ${c.unmeasured}). No request was sent. Strict token counting is on (--strict-token-count / NEXUS_STRICT_TOKEN_COUNT=1); turn it off to proceed on the labelled estimate.`,\n412:      line: `execution=BLOCKED outcome=NOT_ESTABLISHED (CONTEXT_CAPACITY_EXCEEDED: ${c.estimatedPromptTokens} prompt${c.promptCountSource ? ` (${c.promptCountSource})` : \"\"} + ${c.completionReserveTokens} completion + ${c.toolResponseReserveTokens} tool reserve > ${c.contextLimit} limit). ` +\n417:  if (exec === \"BLOCKED\") return { heading: \"TURN BLOCKED\", line: `execution=BLOCKED outcome=NOT_ESTABLISHED${tail}` };\n422:      return { heading: \"STOPPED - NO PROGRESS\", line: `execution=LIMIT_REACHED outcome=NOT_ESTABLISHED (STAGNATION_DETECTED${t.detail ? `: ${t.detail}` : \"\"}; ${t.steps.used} steps${segments})` };\n425:      return { heading: \"TIME BUDGET EXHAUSTED\", line: `execution=LIMIT_REACHED outcome=NOT_ESTABLISHED (TIME_BUDGET_EXHAUSTED${t.detail ? `: ${t.detail}` : \"\"}; ${t.steps.used} steps${segments})` };\n428:      return { heading: \"STEP BUDGET EXHAUSTED\", line: `execution=LIMIT_REACHED outcome=NOT_ESTABLISHED (${t.steps.used}/${t.steps.max} steps${segments}; raise --max-total-steps to allow more)` };\n430:    return { heading: \"STEP LIMIT REACHED\", line: `execution=LIMIT_REACHED outcome=NOT_ESTABLISHED (${t.steps.used}/${t.steps.max} steps)` };\n432:  switch (t.outcome) {\n433:    case \"VERIFIED\":\n43