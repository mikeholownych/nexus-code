arizing away results the model has not seen yet makes it repeat the same calls; keep them, truncated, first.\n        if (recentTurns === 0 && unseen.length) {\n          const unseenText = unseen.map((index) => normalizeMessageContent(original[index].content).text.join(\"\")).join(\"\");\n          const tokensPerChar = unseenText.length ? Math.max(countTokens(unseenText) / unseenText.length, 0.05) : 1;\n          for (const detailBudgetChars of detailBudgetList) {\n            const floor = this.compactionCandidate(original, 1, detailBudgetChars, 0);\n            const room = contextLimit - reserves.completion - reserves.toolResponse - this.scaledBudget(floor.messages, contextLimit).totalActiveTokens;\n            if (room <= 0) continue;\n            for (let chars = Math.floor(room / tokensPerChar), tries = 0; tries < 4 && !accepted; chars = Math.floor(chars * 0.75), tries++) {\n3860-        !this.isReadOnly()\n3861-      ) {\n3862-        try {\n3863:          const configured = this.config.authoritativeVerifierCommand?.trim();\n3864:          const discovered = configured ? null : discoverVerifier(this.config.workspace);\n3865-          const verifierCommand = configured || discovered?.command;\n3866-          const source: \"configured\" | \"discovered\" = configured ? \"configured\" : \"discovered\";\n3867-          if (!verifierCommand) {\n3868-            // No repository evidence supports any verifier. Completion is allowed but honestly UNVERIFIED.\n3869-            noApplicableVerifier = true;\n3870-            this.verificationEvidence = { status: \"NO_APPLICABLE_VERIFIER\", at: new Date().toISOString() };\n3871-          } else {\n3872-            // Inputs the verifier would run on. A failure on exactly these inputs is not rerun: nothing it checks has\n--\n4062-      // Files a passing run covered are verified; ones it did not cover stay for a later run to cover.\n4063-      if (verifierSucceeded && hasExecuted && this.verificationEvidence?.isDelivera