{"timestamp":"2026-10-26T18:16:24.538Z","ordinal":396398,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a178fa-f0ed-7ab3-bb71-477460bd1a0a","item":{"type":"CommandExecution","id":"exec-feb9aba4-c6d2-4a4a-8b12-af98b86528c2","process_id":"21435","command":["/usr/bin/zsh","-lc","sed -n '1,170p' cli/src/credentials.ts; sed -n '1,125p' cli/src/config.ts; rg -n -e 'authoritative-verifier' -e 'folder trust' -e 'trust.*workspace' docs/v1.0.0 docs/USER_MANUAL.md cli/src | head -100"],"cwd":"file:///home/mike/nexus-wt/readiness-rc8-install-terminal-20261026","parsed_cmd":[{"type":"read","cmd":"sed -n '1,170p' cli/src/credentials.ts","name":"credentials.ts","path":"cli/src/credentials.ts"},{"type":"read","cmd":"sed -n '1,125p' cli/src/config.ts","name":"config.ts","path":"cli/src/config.ts"},{"type":"search","cmd":"rg -n -e authoritative-verifier -e 'folder trust' -e 'trust.*workspace' docs/v1.0.0 docs/USER_MANUAL.md cli/src","query":"authoritative-verifier","path":"folder trust"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * Provider credentials: where each provider's key or sign-in comes from, in precedence order.\n *\n * 1. The provider's environment variable (operator environment / config.env / process env).\n * 2. Nexus's own store, ~/.config/nexus/credentials.json (mode 0600), written by `nexus connect` and the TUI.\n * 3. Connections already registered in other clients on this machine, read in place and never modified:\n *    Codex CLI (~/.codex/auth.json), opencode (~/.local/share/opencode/auth.json), crush\n *    (~/.local/share/crush/crush.json) and the GitHub Copilot editor plugins (~/.config/github-copilot/apps.json).\n *\n * An OAuth token read from another client is used while valid and re-read when it expires; Nexus never refreshes it,\n * because refresh tokens rotate and refreshing would sign the owning client out. All files are read from the\n * operator's credential home (credentialStorageHome), never from a HOME a project .env set.\n */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { credentialStorageHome } from \"./client.js\";\n\nexport type StoredCredential =\n  | { type: \"api\"; key: string; label?: string; savedAt: string }\n  | {\n      type: \"oauth\";\n      access: string;\n      /** Refresh token (ChatGPT) or GitHub OAuth token (Copilot). */\n      refresh?: string;\n      /** Epoch ms; undefined when unknown. */\n      expiresAt?: number;\n      accountId?: string;\n      label?: string;\n      savedAt: string;\n    };\n\nexport interface ResolvedCredential {\n  /** Where it came from, for the operator: \"$OPENAI_API_KEY\", \"Nexus\", \"Codex CLI\", \"opencode\", ... */\n  source: string;\n  kind: \"env\" | \"nexus\" | \"external\";\n  credential: StoredCredential;\n  /** False for tokens owned by another client: Nexus must not refresh them. */\n  refreshable: boolean;\n  /** File it was read from (external and nexus). */\n  file?: string;\n}\n\ninterface StoreFile {\n  version: 1;\n  providers: Record<string, StoredCredential>;\n}\n\nconst LOCAL_ENDPOINT_CREDENTIAL_PREFIX = \"nexus-local-endpoint:\";\n\n/** Stable credential-store key for one exact HTTP(S) origin; the credential never follows another endpoint. */\nfunction localEndpointCredentialId(endpoint: string): string | undefined {\n  try {\n    const url = new URL(endpoint);\n    if ((url.protocol !== \"http:\" && url.protocol !== \"https:\") || url.username || url.password || url.origin === \"null\") return undefined;\n    return `${LOCAL_ENDPOINT_CREDENTIAL_PREFIX}${url.origin}`;\n  } catch {\n    return undefined;\n  }\n}\n\nexport function saveLocalEndpointCredential(endpoint: string, key: string): boolean {\n  const id = localEndpointCredentialId(endpoint);\n  const value = key.trim();\n  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n  saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n  return true;\n}\n\n/** Save a verified endpoint key and its selected model as one failure-atomic setup operation. */\nexport function commitLocalEndpointSetup(endpoint: string, key: string, commitSettings: () => void): boolean {\n  const id = localEndpointCredentialId(endpoint);\n  const value = key.trim();\n  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n\n  const file = credentialsPath();\n  let previous: StoredCredential | undefined;\n  try {\n    const stat = fs.lstatSync(file);\n    if (stat.isSymbolicLink() || !stat.isFile()) throw new Error(\"The Nexus credential store is not a regular file.\");\n    const parsed = JSON.parse(fs.readFileSync(file, \"utf8\"));\n    if (!parsed || typeof parsed !== \"object\" || parsed.version !== 1 || !parsed.providers || typeof parsed.providers !== \"object\" || Array.isArray(parsed.providers)) {\n      throw new Error(\"The Nexus credential store has an unsupported format.\");\n    }\n    if (Object.hasOwn(parsed.providers, id)) {\n      const entry = parsed.providers[id];\n      if (!entry || typeof entry !== \"object\" || entry.type !== \"api\" || typeof entry.key !== \"string\" || !entry.key || typeof entry.savedAt !== \"string\") {\n        throw new Error(\"The local endpoint credential has an unsupported format.\");\n      }\n      previous = entry;\n    }\n  } catch (error: any) {\n    if (error?.code !== \"ENOENT\") throw new Error(\"Nexus could not safely update its credential store.\");\n  }\n  const hadStore = fs.existsSync(file);\n  try {\n    saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n    commitSettings();\n    return true;\n  } catch (error) {\n    try {\n      if (previous) {\n        saveCredential(id, previous);\n      } else {\n        removeCredential(id);\n        if (!hadStore && Object.keys(readStore().providers).length === 0) {\n          try { fs.unlinkSync(file); } catch (unlinkError: any) { if (unlinkError?.code !== \"ENOENT\") throw unlinkError; }\n        }\n      }\n    } catch (rollbackError) {\n      throw new AggregateError([error, rollbackError], \"Local endpoint setup failed and its saved credential could not be restored.\");\n    }\n    throw error;\n  }\n}\n\nexport function localEndpointCredential(endpoint: string): { origin: string; key: string } | undefined {\n  const id = localEndpointCredentialId(endpoint);\n  if (!id) return undefined;\n  const credential = readStore().providers[id];\n  if (credential?.type !== \"api\") return undefined;\n  return { origin: id.slice(LOCAL_ENDPOINT_CREDENTIAL_PREFIX.length), key: credential.key };\n}\n\n/** Used only to prevent a project or caller-supplied key from escaping its saved endpoint origin. */\nexport function localEndpointCredentials(): Array<{ origin: string; key: string }> {\n  const store = readStore();\n  const result: Array<{ origin: string; key: string }> = [];\n  for (const [id, credential] of Object.entries(store.providers)) {\n    if (!id.startsWith(LOCAL_ENDPOINT_CREDENTIAL_PREFIX) || credential.type !== \"api\") continue;\n    const origin = id.slice(LOCAL_ENDPOINT_CREDENTIAL_PREFIX.length);\n    if (localEndpointCredentialId(origin) === id) result.push({ origin, key: credential.key });\n  }\n  return result;\n}\n\nexport function credentialsPath(): string {\n  return path.join(credentialStorageHome(), \".config/nexus/credentials.json\");\n}\n\nfunction readJson(file: string): any {\n  try {\n    return JSON.parse(fs.readFileSync(file, \"utf-8\"));\n  } catch {\n    return undefined;\n  }\n}\n\nfunction readStore(): StoreFile {\n  const raw = readJson(credentialsPath());\n  return raw && typeof raw === \"object\" && raw.providers && typeof raw.providers === \"object\"\n    ? { version: 1, providers: raw.providers }\n    : { version: 1, providers: {} };\n}\n\n/** Atomic, owner-only write: a credential file is never briefly world-readable or half-written. */\nfunction writeStore(store: StoreFile): void {\n  const file = credentialsPath();\n  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });\n  const tmp = `${file}.${process.pid}.tmp`;\n  fs.writeFileSync(tmp, JSON.stringify(store, null, 2) + \"\\n\", { mode: 0o600 });\n  fs.renameSync(tmp, file);\n  fs.chmodSync(file, 0o600);\n}\n\nexport function saveCredential(providerId: string, credential: StoredCredential): void {\n  const store = readStore();\n  store.providers[providerId] = credential;\n  writeStore(store);\n}\n\nimport fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { config as loadDotenv, parse as parseDotenv } from \"dotenv\";\nimport { credentialOriginOf, credentialStorageHome, environmentCredential, LocalLlmClient, operatorSetting, setCredentialAuthority } from \"./client.js\";\nimport { baseUrlSetting, originOf, parseOriginList, PROVIDERS, providerDefinition } from \"./providers.js\";\nimport { providerApiKey } from \"./credentials.js\";\nimport { ContinuationBudget, DEFAULT_CONTINUATION, HarnessConfig, ApprovalMode } from \"./types.js\";\n\nconst installEnv = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../.env\");\nconst DEFAULT_ENDPOINT = \"http://localhost:1234/v1\";\nlet credentialAuthorityRecorded = false;\nlet shellEnvironment: Record<string, string | undefined> = {};\nlet userConfigFile: Record<string, string> = {};\nconst SHELL_PRECEDENCE_KEYS = [\"NEXUS_VERIFY_ATTESTATION\"] as const;\nlet applianceEndpointOverride: { endpoint: string; model?: string; apiKey?: string; persistModelOnSelection: boolean } | undefined;\n\n/** Session-scoped endpoint override established by the explicit local connect flow. */\nexport function activateApplianceEndpoint(endpoint: string, model?: string, persistModelOnSelection = false, apiKey?: string): void {\n  applianceEndpointOverride = { endpoint, ...(model ? { model } : {}), ...(apiKey ? { apiKey } : {}), persistModelOnSelection };\n}\n\nexport function applianceEndpointSelection(): { endpoint: string; model?: string; persistModelOnSelection: boolean } | undefined {\n  if (!applianceEndpointOverride) return undefined;\n  return {\n    endpoint: applianceEndpointOverride.endpoint,\n    ...(applianceEndpointOverride.model ? { model: applianceEndpointOverride.model } : {}),\n    persistModelOnSelection: applianceEndpointOverride.persistModelOnSelection,\n  };\n}\n\n/** Return the provisional key only for the exact endpoint origin during the setup session. */\nexport function pendingApplianceEndpointKey(endpoint: string): string | undefined {\n  if (!applianceEndpointOverride?.apiKey) return undefined;\n  return originOf(applianceEndpointOverride.endpoint) === originOf(endpoint) ? applianceEndpointOverride.apiKey : undefined;\n}\n\n/** Test isolation for session-scoped endpoint changes. */\nexport function resetApplianceEndpointOverride(): void {\n  applianceEndpointOverride = undefined;\n}\n\n/** Loads env files in precedence order; CLI flags are applied afterwards by buildConfig. */\nexport function loadEnvironment(): void {\n  // The operator's own environment and home, before any file has written to process.env.\n  const operatorEnvironment = credentialAuthorityRecorded ? undefined : { ...process.env };\n  if (!credentialAuthorityRecorded && operatorEnvironment) {\n    shellEnvironment = { ...operatorEnvironment };\n  }\n  const operatorHome = credentialAuthorityRecorded ? credentialStorageHome() : os.homedir();\n  // 1. Installation directory defaults\n  loadDotenv({ path: installEnv });\n  // 2. Global user config (~/.config/nexus/config.env)\n  const globalConfig = path.join(operatorHome, \".config/nexus/config.env\");\n  userConfigFile = {};\n  if (fs.existsSync(globalConfig)) {\n    loadDotenv({ path: globalConfig, override: true });\n    userConfigFile = parseDotenv(fs.readFileSync(globalConfig));\n  }\n  // A provenance setting chosen in the operator's shell outranks config.env, which was applied with override above:\n  // config.env NEXUS_VERIFY_ATTESTATION=0 must not defeat an explicit NEXUS_VERIFY_ATTESTATION=1 for this run.\n  for (const key of SHELL_PRECEDENCE_KEYS) {\n    const shellValue = shellEnvironment[key];\n    if (shellValue !== undefined) process.env[key] = shellValue;\n  }\n  // Credential bindings are decided by the operator environment and config.env only (see setCredentialAuthority).\n  if (operatorEnvironment) {\n    setCredentialAuthority({ ...operatorEnvironment, ...userConfigFile }, operatorHome);\n    credentialAuthorityRecorded = true;\n  }\n  // 3. Current working directory overrides (skipped when cwd is the install directory: that file is the\n  //    shipped default already applied in step 1 and must not outrank the user's global config). A project .env\n  //    belongs to the repository, not the operator: only per-project settings in PROJECT_ENV_KEYS are applied; the\n  //    rest (TLS and proxy settings, credentials, HOME, the shell, timeouts, fallbacks, trust) is ignored and reported.\n  const cwdEnv = path.resolve(process.cwd(), \".env\");\n  projectEnvSettings = {};\n  projectEnvIgnored = [];\n  if (cwdEnv !== installEnv && fs.existsSync(cwdEnv)) {\n    let project: Record<string, string> = {};\n    try {\n      project = parseDotenv(fs.readFileSync(cwdEnv));\n    } catch {}\n    for (const [key, value] of Object.entries(project)) {\n      if (isProjectEnvKey(key)) projectEnvSettings[key] = value;\n      else projectEnvIgnored.push(key);\n    }\n    if (projectEnvIgnored.length) {\n      warnOnce(`ignored in ${cwdEnv}: ${projectEnvIgnored.join(\", \")} (a project .env may set only per-project settings; put operator settings in ~/.config/nexus/config.env)`);\n    }\n  }\n}\n\n/**\n * Settings a repository's .env may choose for itself: which endpoint, model and endpoint key to use (a cloud destination\n * still needs the operator's authorization, and the key is bound to that endpoint's origin), task classes, budgets and\n * reasoning effort. Everything else is operator authority, including cloud provider keys and selection.\n */\nconst PROJECT_ENV_KEYS = new Set([\n  \"LOCAL_LLM_ENDPOINT\",\n  \"LOCAL_LLM_MODEL\",\n  // The project's own key for the project's own endpoint: credential binding sends it only to that origin.\n  \"LOCAL_LLM_API_KEY\",\n  \"LOCAL_LLM_TASK_CLASS\",\n  \"PLANNER_LLM_ENDPOINT\",\n  \"PLANNER_LLM_MODEL\",\n  \"PLANNER_TASK_CLASS\",\n  \"CODER_LLM_ENDPOINT\",\n  \"CODER_LLM_MODEL\",\n  \"NEXUS_TASK_CLASS\",\n  \"NEXUS_CONTINUATION\",\n  \"NEXUS_MAX_TOTAL_STEPS\",\n  \"NEXUS_MAX_TURN_MINUTES\",\n  \"NEXUS_STAGNATION_STEPS\",\n  \"NEXUS_VERIFIER_TIMEOUT_SECS\",\n  \"NEXUS_REASONING_EFFORT\",\n  \"NEXUS_STRICT_TOKEN_COUNT\",\n  \"NEXUS_CONTEXT_LIMIT\",\n]);\n\nexport function isProjectEnvKey(key: string): boolean {\n  return PROJECT_ENV_KEYS.has(key) || /^NEXUS_PROJECT_[A-Z0-9_]+$/.test(key);\n}\n\nlet projectEnvSettings: Record<string, string> = {};\ndocs/USER_MANUAL.md:20:- On each interactive launch from an untrusted folder, Nexus asks whether to trust the folder, continue without trust, or exit. Trust loads project instructions when present and enables trusted workspace integrations. Folder trust is separate from tool permissions: an explicit mode controls approvals, and an unset mode defaults to `review` in every folder. Non-interactive launches do not prompt and do not load project instructions unless the folder is already trusted.\ndocs/USER_MANUAL.md:25:- **Default:** `review` posture, requiring human confirmation before executing shell commands, file modifications, network requests, or verifier test runs, regardless of folder trust.\ndocs/USER_MANUAL.md:26:- **Auto:** Select with `--mode auto`. Writes and commands run without approval; network egress still asks on first use of each origin. This is independent of folder trust.\ndocs/USER_MANUAL.md:30:- **Trust your workspace:** Run `nexus trust .` to load project instructions and workspace integrations. It does not change tool permission settings.\ndocs/USER_MANUAL.md:366:- **In-Process Plugin Execution & Middleware Auditing**: Custom plugin handlers and middleware execute in-process with full user authority. Plugins are loaded only from documented directories: `~/.config/nexus/plugins/`, `~/.nexus/plugins/`, and trusted workspace directories (`.nexus/plugins/`, `plugins/`). The undocumented foreign directory `~/.config/opencode/plugins` has been removed (REQ-SEC-115), and the legacy worker-thread sandbox claim has been retired (`executeSandboxed` deleted, REQ-SEC-117). Any middleware rewriting of tool I/O (`preToolExecution` or `postToolExecution`) is cryptographically audited with before-and-after SHA-256 digests in both `~/.nexus/audit.log` (`kind: \"middleware_rewrite\"`) and the flight log (EXT-004, REQ-SEC-116).\ndocs/USER_MANUAL.md:367:- **Workspace Trust & Context Provenance (REQ-SEC-113, CTX-001)**: An opened workspace is data until explicitly trusted by the operator. Workspace trust covers:\ndocs/USER_MANUAL.md:373:  Trust is managed via `nexus trust [path]` (undo with `nexus trust --remove`, list with `nexus trust --list`; stored in `~/.config/nexus/trusted_workspaces.json`, which the agent's file tools cannot write). In an untrusted workspace:\ndocs/USER_MANUAL.md:376:  - Workspace skills are not loaded into context; `/skills` lists them as \"untrusted (not loaded)\". Attempting to use `/skill <name>` or the `activate_skill` tool on an untrusted skill is refused with: `Skill '<name>' belongs to an untrusted workspace. Run 'nexus trust .' to trust this workspace.`.\ndocs/USER_MANUAL.md:390:- **Verifier Execution Gating (REQ-SEC-119)**: Automated test runs and verifiers (`run_tests`, `/test`, completion oracle) are classified as `exec` capabilities subject to the configured approval mode. In review mode, the first verifier execution prompts for approval, displaying the exact test command and resolved script body from `package.json`, `Makefile`, or `Cargo.toml`; folder trust alone does not authorize it.\ndocs/v1.0.0/README.md:27:| 03 | Untrusted workspace inputs and egress boundary | [SPEC-03](specs/SPEC-03-untrusted-inputs-and-egress.md) | [PLAN-03](plans/PLAN-03-untrusted-inputs-and-egress.md) | M1 | SEC-110, 111, 115, 116 |\ncli/src/knowledge.ts:6:import { isWorkspaceTrusted } from \"./workspace_trust.js\";\ncli/src/knowledge.ts:211:   * Gated by workspace trust: returns empty string if workspace is untrusted (REQ-SEC-113).\ncli/src/knowledge.ts:218:        : isWorkspaceTrusted(this.workspace, this.readOnly);\ncli/src/knowledge.ts:247:        : isWorkspaceTrusted(this.workspace, this.readOnly);\ncli/src/sidecar.ts:21:import { isWorkspaceTrusted } from \"./workspace_trust.js\";\ncli/src/sidecar.ts:1013:    const trusted = isWorkspaceTrusted(config.workspace, Boolean(config.readOnly));\ncli/src/sidecar.ts:1094:    .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\ncli/src/sidecar.ts:1103:    .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\ncli/src/plugins.ts:7:import { isWorkspaceTrusted, WORKSPACE_PLUGIN_DIRS } from \"./workspace_trust.js\";\ncli/src/plugins.ts:49:  if (isWorkspaceTrusted) dirs.unshift(...WORKSPACE_PLUGIN_DIRS.map((dir) => path.join(workspace, dir)));\ncli/src/plugins.ts:65:    this.trusted = options?.trusted !== undefined ? options.trusted : isWorkspaceTrusted(this.workspace, this.readOnly);\ncli/src/startup_trust.ts:5:import { isWorkspaceTrusted, setWorkspaceTrusted } from \"./workspace_trust.js\";\ncli/src/startup_trust.ts:17:    isTrusted: (workspace: string) => boolean;\ncli/src/startup_trust.ts:18:    trust: (workspace: string) => unknown;\ncli/src/startup_trust.ts:76:/** Project instructions are untrusted workspace input and are injected only after the operator explicitly trusts it. */\ncli/src/startup_trust.ts:79:  isTrusted: (workspace: string) => boolean = isWorkspaceTrusted,\ncli/src/startup_trust.ts:81:  return isTrusted(workspace) ? getProjectRules(workspace) : null;\ncli/src/startup_trust.ts:86: * existing untrusted-workspace policy and never persist trust implicitly.\ncli/src/startup_trust.ts:96:    isTrusted: isWorkspaceTrusted,\ncli/src/startup_trust.ts:97:    trust: (target: string) => setWorkspaceTrusted(target, true),\ncli/src/startup_trust.ts:102:  if (trustStore.isTrusted(resolvedWorkspace)) return Promise.resolve(\"trusted\");\ncli/src/startup_trust.ts:105:      `Nexus: ${displayWorkspace} is not trusted. Project instructions and workspace integrations stay unloaded. ` +\ncli/src/startup_trust.ts:142:        \"Folder trust doesn't change approvals.\",\ncli/src/startup_trust.ts:179:          trustStore.trust(resolvedWorkspace);\ncli/src/config.ts:269:function normalizeTrustedDeliverableFiles(workspace: string, value: unknown): string[] {\ncli/src/config.ts:354:    // Folder trust controls project instructions and integrations, not tool authority.\ncli/src/config.ts:366:  const trustedDeliverableFiles = normalizeTrustedDeliverableFiles(workspace, options.deliverableFile);\ndocs/v1.0.0/DECISIONS.md:9:| [DEC-01](#dec-01-default-execution-posture) | Default execution posture | Review by default; permission mode is independent of folder trust | No (resolved) |\ndocs/v1.0.0/DECISIONS.md:37:| **C (original choice; amended 2026-10-24)** | Permission mode controls approvals independently of workspace trust. The default is `review`. `--mode auto` permits writes and commands regardless of folder trust and keeps first-use egress approval per origin. `--yes` and `NEXUS_APPROVAL_MODE=auto` select full access and bypass confirmation prompts, including egress. | Folder trust is a separate choice for loading project instructions and workspace integrations. |\ndocs/v1.0.0/DECISIONS.md:40:**Rationale.** Folder trust protects project instructions and workspace integrations from being loaded before the operator approves those sources. Tool authority is governed by the operator's permission settings and must not change when a folder is trusted. A configured `auto` mode remains the operator's choice; when no permission mode is configured, Nexus defaults to `review`.\ncli/src/slash/extension_commands.ts:78:    lines.push(`    ${s.description} — run 'nexus trust .' to enable workspace skills`);\ncli/src/slash/extension_commands.ts:100:    return reply(\"skill\", `Skill ${text} is in an untrusted workspace [untrusted (not loaded)]. Run 'nexus trust .' to trust this workspace.`, false);\ndocs/v1.0.0/evidence/F_requirements_history.md:38:| REQ-PRV-01..02 | DEST-001..002 | 4 trust boundaries (HOST_LOCAL, LOCAL_APPLIANCE, EXTERNAL_BOUNDED, EXTERNAL_PUBLIC); downward crossing = egress event | P2 §14 | DEMONSTRATED (egress.ts classifyDestination) | Y (WP05) | Maturity review 10-12 P0: workspace `.env` can select public endpoint; disclosure authorization not enforced (cites CLOUD_PROVIDERS_ASSESSMENT 10-11) |\ndocs/v1.0.0/evidence/F_requirements_history.md:45:| REQ-SEC-43..45 | EXT-001..003 | Extensions in declared domains; presence ≠ execution authority; preconfigured trust without prompts | P2 §19 | SBIS | P | **Contradicted 10-12 T-03** (workspace plugins + `.mcp.json` executed with no trust, even `--read-only --approve`); remediated 3290234 (`nexus trust`) |\ndocs/v1.0.0/evidence/F_requirements_history.md:66:| REQ-SEC-61 | B2/T-03 | Workspace plugins / `.mcp.json` only after `nexus trust`; never in `--read-only` | TOP_TIER B2; USER_MANUAL §4 | Implemented (workspace_trust.ts; plugins.ts:47-54,76; mcp.ts:509-511) | N |\ndocs/v1.0.0/evidence/F_requirements_history.md:119:- **Trust boundaries in commitments:** operator config (`~/.config/nexus`) = credential authority; project `.env` may configure endpoints but not cloud destinations or credential origins; workspace extensions require `nexus trust`; home plugin dirs always trusted — including `~/.config/opencode/plugins` (undocumented, cli/src/plugins.ts:51).\ndocs/v1.0.0/evidence/F_requirements_history.md:142:| 1 | EXT-002 / B2 workspace plugins+MCP need trust | plugins.ts:47-54,76; mcp.ts:509-511; workspace_trust.ts present | HOLDS (regressed 10-12, fixed 3290234) |\ncli/src/workspace_trust.ts:11: * is not trusted (or the session is read-only). Empty when there are none or the workspace is trusted.\ncli/src/workspace_trust.ts:13:export function untrustedWorkspaceExtensions(workspace: string, readOnly = false): string[] {\ncli/src/workspace_trust.ts:14:  if (isWorkspaceTrusted(workspace, readOnly)) return [];\ncli/src/workspace_trust.ts:28:  return path.join(os.homedir(), \".config\", \"nexus\", \"trusted_workspaces.json\");\ncli/src/workspace_trust.ts:35:export function isWorkspaceTrusted(workspace: string, readOnly = false): boolean {\ncli/src/workspace_trust.ts:37:  if (process.env.NEXUS_TRUST_WORKSPACE === \"1\") return true;\ncli/src/workspace_trust.ts:55:/** The trusted workspaces (real paths), as recorded in the trust store. */\ncli/src/workspace_trust.ts:56:export function listTrustedWorkspaces(): string[] {\ncli/src/workspace_trust.ts:66:/** Records (or removes) the operator's trust in a workspace. Returns its real path; throws when the store cannot be written. */\ncli/src/workspace_trust.ts:67:export function setWorkspaceTrusted(workspace: string, trusted: boolean): string {\ncli/src/workspace_trust.ts:72:  const list = listTrustedWorkspaces().filter((p) => p !== realWs);\ncli/src/slash/workspace_commands.ts:9:import { isWorkspaceTrusted } from \"../workspace_trust.js\";\ncli/src/slash/workspace_commands.ts:175:    trusted: isWorkspaceTrusted(ws, Boolean(config.readOnly)),\ncli/src/index.ts:208:  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\ncli/src/index.ts:249:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\ncli/src/index.ts:258:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\ncli/src/index.ts:288:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\ncli/src/index.ts:306:  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\ncli/src/index.ts:344:  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\ncli/src/index.ts:353:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\ncli/src/index.ts:385:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\ncli/src/index.ts:388:  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\ncli/src/index.ts:734:    const { untrustedWorkspaceExtensions } = await import(\"./workspace_trust.js\");\ncli/src/index.ts:735:    for (const file of untrustedWorkspaceExtensions(ws).filter((f) => /(^|[\\\\/])\\.?mcp\\.json$/.test(f))) {\ncli/src/index.ts:773:    const { untrustedWorkspaceExtensions } = await import(\"./workspace_trust.js\");\ncli/src/index.ts:774:    for (const file of untrustedWorkspaceExtensions(ws).filter((f) => !/(^|[\\\\/])\\.?mcp\\.json$/.test(f))) {\ncli/src/index.ts:791:  .description(\"Trust a workspace so its own .mcp.json servers and plugins are loaded (they run code from the workspace)\")\ncli/src/index.ts:792:  .option(\"--remove\", \"Stop trusting the workspace\")\ncli/src/index.ts:793:  .option(\"--list\", \"List trusted workspaces\")\ncli/src/index.ts:795:    const { listTrustedWorkspaces, setWorkspaceTrusted } = await import(\"./workspace_trust.js\");\ncli/src/index.ts:797:      const list = listTrustedWorkspaces();\ncli/src/index.ts:798:      console.log(list.length ? list.join(\"\\n\") : \"No trusted workspaces.\");\ncli/src/index.ts:808:    console.log(options.remove ? `No longer trusted: ${real}` : `Trusted: ${real}\\nIts .mcp.json servers and plugins will be loaded (they run code from this workspace). Undo with \\`nexus trust --remove\\`.`);\ncli/src/skills.ts:4:import { isWorkspaceTrusted } from \"./workspace_trust.js\";\ncli/src/skills.ts:48:        : isWorkspaceTrusted(this.workspace, this.readOnly);\ndocs/v1.0.0/evidence/A2_verification.md:37:- **Trust boundary.** Verifier commands run repository-defined code: Makefile recipes, package.json scripts, build.rs, conftest.py. They run through `bridge.executeTool(\"run_command\")` directly, so the dispatch approval gate (agent.ts:3947) never sees them. The sandbox applies only if `--sandbox`/read-only is set (tools.ts:755). No workspace-trust check applies.\ndocs/v1.0.0/evidence/A2_verification.md:52:| VER-01 | S2 | Any session on a cloned/untrusted repo, including `--approve` review mode | agent.ts:1602-1617 (baseline), 3432-3436 (oracle), 1630 (independence copy run); tester.ts:113-136 | SOURCE. Before the first file edit (agent.ts:4034, after the edit's own approval) and at every `task_completed`, Nexus runs `make test` / `npm test` / `cargo test` / `pytest` through `bridge.executeTool` directly. These run arbitrary repo-defined code with no approval prompt and no workspace-trust check (unlike MCP/plugins, workspace_trust.ts), and unsandboxed unless `--sandbox`. Review mode shows an approval for `edit_file` but never for the hidden repo script that follows. Builds on SEC-01; it is a separate path because it bypasses even review mode. | Cloning a hostile repo and asking for any edit runs its test script on the host without a prompt. | RELEASE-REQUIRED: gate discovered verifiers on workspace trust or a one-time approval of the exact command (shown with its script body), and run them sandboxed when one is available. Document this. |\ndocs/v1.0.0/evidence/A2_verification.md:134:| R-VER-1 | Repo-defined verifier commands (discovered) run only in a trusted workspace or after one approval that shows the command and script body. They run sandboxed when a sandbox is available. | safety | RELEASE-REQUIRED | An untrusted temp repo with `\"test\":\"touch /tmp/pwn\"` plus an edit request: no file created without a prompt, in both default and --approve modes. |\ndocs/v1.0.0/READINESS.md:367:  - `REQ-AGT-010` and historical `CTX-001` rows (`f68b5bc`, PR #17) are reconciled with `DEC-04`: the v1 subset (`ACC-TRUST-04` trust gating and source/trust annotations in `workspace_trust.test.ts`, 5/5 pass) is source-tested and independently accepted, while the full provenance graph and `CTX-002` remain post-v1.\ndocs/v1.0.0/READINESS.md:429:| `REQ-AGT-010` | partial (RR; v1 subset independently accepted at `f68b5bc`) | `ACC-TRUST-04` v1 subset (workspace skills/knowledge trust gating and source/trust annotations in `workspace_trust.test.ts`, 5/5 pass) is source-tested and independently accepted (PR #17 `f68b5bc`); `DEC-04` defers the full `CTX-001` provenance graph and `CTX-002` to post-v1. | Installed-RC verification; post-v1 deferral recorded | Requirement owner | Preserve the `DEC-04` v1 subset / post-v1 boundary in release notes and verify no regression on the installed RC. |\ndocs/v1.0.0/READINESS.md:488:- On the exact installed RC5 package, OpenRouter pinned model `nvidia/nemotron-3-ultra-550b-a55b:free` and ChatGPT sign-in model `gpt-6-luna` each passed streamed completion and tool-call/result verification. No workspace content was involved. OpenRouter's required live small engineering task remains pending; the disposable synthetic task has a failing baseline and waits for the operator's folder-trust choice. Nexus remains in its default `review` approval mode; folder trust does not change approvals.\ncli/src/doctor.ts:28:import { untrustedWorkspaceExtensions, WORKSPACE_MCP_FILES, isWorkspaceTrusted } from \"./workspace_trust.js\";\ncli/src/doctor.ts:1027:  for (const file of untrustedWorkspaceExtensions(workspace).filter((f) => WORKSPACE_MCP_FILES.includes(path.basename(f)))) {\ncli/src/doctor.ts:1028:    problems.push(`${file}: not loaded — this workspace is not trusted. Trust it with \\`nexus trust ${workspace}\\` to use its MCP servers.`);\ncli/src/doctor.ts:1040:  for (const file of untrustedWorkspaceExtensions(workspace).filter((f) => !WORKSPACE_MCP_FILES.includes(path.basename(f)))) {\ncli/src/doctor.ts:1041:    risky.push(`${file}: not loaded — this workspace is not trusted. Trust it with \\`nexus trust ${workspace}\\` to load its plugins.`);\ncli/src/doctor.ts:1058:  if (risky.length) return f(\"plugins.config\", \"extensions\", \"warn\", `${risky.length} plugin problem(s): untrusted workspace plugins are not loaded; world-writable plugin files could be changed by anyone. ${note}`, [...risky, ...found.slice(0, 10)], \"Trust the workspace (`nexus trust`) or remove its plugins; restrict writable files with `chmod o-w <file>`.\");\ncli/src/doctor.ts:1174:    const trusted = isWorkspaceTrusted(config.workspace, Boolean(config.readOnly));\ncli/src/security.ts:27:  // The operator's list of trusted workspaces: the agent must not trust a workspace for itself.\ncli/src/security.ts:28:  \"trusted_workspaces.json\",\ncli/src/core/capabilities.ts:12: * `egress`; `context_inject` is gated by workspace trust instead; `read_workspace`, `delegate` (the child's own calls are\ncli/src/repl.ts:13:import { isWorkspaceTrusted } from \"./workspace_trust.js\";\ncli/src/repl.ts:347:    const trusted = isWorkspaceTrusted(this.config.workspace, Boolean(this.config.readOnly));\n","exit_code":0,"duration":{"secs":0,"nanos":902881700}},"started_at_ms":1793038583635,"completed_at_ms":1793038584538}}
{"timestamp":"2026-10-26T18:16:31.030Z","ordinal":396399,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1796d-a436-74f2-9f00-369b637b9f54","call_id":"call_36b8b0efae464b00bf24d09f613aab51","output":[{"type":"input_text","text":"Script completed\nWall time 8.5 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 8006)\nTotal output lines: 395\n\n/**\n * Provider credentials: where each provider's key or sign-in comes from, in precedence order.\n *\n * 1. The provider's environment variable (operator environment / config.env / process env).\n * 2. Nexus's own store, ~/.config/nexus/credentials.json (mode 0600), written by `nexus connect` and the TUI.\n * 3. Connections already registered in other clients on this machine, read in place and never modified:\n *    Codex CLI (~/.codex/auth.json), opencode (~/.local/share/opencode/auth.json), crush\n *    (~/.local/share/crush/crush.json) and the GitHub Copilot editor plugins (~/.config/github-copilot/apps.json).\n *\n * An OAuth token read from another client is used while valid and re-read when it expires; Nexus never refreshes it,\n * because refresh tokens rotate and refreshing would sign the owning client out. All files are read from the\n * operator's credential home (credentialStorageHome), never from a HOME a project .env set.\n */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { credentialStorageHome } from \"./client.js\";\n\nexport type StoredCredential =\n  | { type: \"api\"; key: string; label?: string; savedAt: string }\n  | {\n      type: \"oauth\";\n      access: string;\n      /** Refresh token (ChatGPT) or GitHub OAuth token (Copilot). */\n      refresh?: string;\n      /** Epoch ms; undefined when unknown. */\n      expiresAt?: number;\n      accountId?: string;\n      label?: string;\n      savedAt: string;\n    };\n\nexport interface ResolvedCredential {\n  /** Where it came from, for the operator: \"$OPENAI_API_KEY\", \"Nexus\", \"Codex CLI\", \"opencode\", ... */\n  source: string;\n  kind: \"env\" | \"nexus\" | \"external\";\n  credential: StoredCredential;\n  /** False for tokens owned by another client: Nexus must not refresh them. */\n  refreshable: boolean;\n  /** File it was read from (external and nexus). */\n  file?: string;\n}\n\ninterface StoreFile {\n  version: 1;\n  providers: Record<string, StoredCredential>;\n}\n\nconst LOCAL_ENDPOINT_CREDENTIAL_PREFIX = \"nexus-local-endpoint:\";\n\n/** Stable credential-store key for one exact HTTP(S) origin; the credential never follows another endpoint. */\nfunction localEndpointCredentialId(endpoint: string): string | undefined {\n  try {\n    const url = new URL(endpoint);\n    if ((url.protocol !== \"http:\" && url.protocol !== \"https:\") || url.username || url.password || url.origin === \"null\") return undefined;\n    return `${LOCAL_ENDPOINT_CREDENTIAL_PREFIX}${url.origin}`;\n  } catch {\n    return undefined;\n  }\n}\n\nexport function saveLocalEndpointCredential(endpoint: string, key: string): boolean {\n  const id = localEndpointCredentialId(endpoint);\n  const value = key.trim();\n  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n  saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n  return true;\n}\n\n/** Save a verified endpoint key and its selected model as one failure-atomic setup operation. */\nexport function commitLocalEndpointSetup(endpoint: string, key: string, commitSettings: () => void): boolean {\n  const id = localEndpointCredentialId(endpoint);\n  const value = key.trim();\n  if (!id || !value || /[\\r\\n]/.test(value)) return false;\n\n  const file = credentialsPath();\n  let previous: StoredCredential | undefined;\n  try {\n    const stat = fs.lstatSync(file);\n    if (stat.isSymbolicLink() || !stat.isFile()) throw new Error(\"The Nexus credential store is not a regular file.\");\n    const parsed = JSON.parse(fs.readFileSync(file, \"utf8\"));\n    if (!parsed || typeof parsed !== \"object\" || parsed.version !== 1 || !parsed.providers || typeof parsed.providers !== \"object\" || Array.isArray(parsed.providers)) {\n      throw new Error(\"The Nexus credential store has an unsupported format.\");\n    }\n    if (Object.hasOwn(parsed.providers, id)) {\n      const entry = parsed.providers[id];\n      if (!entry || typeof entry !== \"object\" || entry.type !== \"api\" || typeof entry.key !== \"string\" || !entry.key || typeof entry.savedAt !== \"string\") {\n        throw new Error(\"The local endpoint credential has an unsupported format.\");\n      }\n      previous = entry;\n    }\n  } catch (error: any) {\n    if (error?.code !== \"ENOENT\") throw new Error(\"Nexus could not safely update its credential store.\");\n  }\n  const hadStore = fs.existsSync(file);\n  try {\n    saveCredential(id, { type: \"api\", key: value, savedAt: now() });\n    commitSettings();\n    return true;\n  } catch (error) {\n    try {\n      if (previous) {\n        saveCredential(id, previous);\n      } else {\n        removeCredential(id);\n        if (!hadStore && Object.keys(readStore().providers).length === 0) {\n          try { fs.unlinkSync(file); } catch (unlinkError: any) { if (unlinkError?.code !== \"ENOENT\") throw unlinkError; }\n        }\n      }\n    } catch (rollbackError) {\n      throw new AggregateError([error, rollbackError], \"Local endpoint setup failed and its saved credential could not be restored.\");\n    }\n    throw error;\n  }\n}\n\nexport function localEndpointCredential(endpoint: string): { origin: string; key: string } | undefined {\n  const id = localEndpointCredentialId(endpoint);\n  if (!id) return undefined;\n  const credential = readStore().providers[id];\n  if (credential?.type !== \"api\") return undefined;\n  return { origin: id.slice(LOCAL_ENDPOINT_CREDENTIAL_PREFIX.length), key: credential.key };\n}\n\n/** Used only to prevent a project or caller-supplied key from escaping its saved endpoint origin. */\nexport function localEndpointCredentials(): Array<{ origin: string; key: string }> {\n  const store = readStore();\n  const result: Array<{ origin: string; key: string }> = [];\n  for (const [id, credential] of Object.entries(store.providers)) {\n    if (!id.startsWith(LOCAL_ENDPOINT_CREDENTIAL_PREFIX) || credential.type !== \"api\") continue;\n    const origin = id.slice(LOCAL_ENDPOINT_CREDENTIAL_PREFIX.length);\n    if (localEndpointCredentialId(origin) === id) result.push({ origin, key: credential.key });\n  }\n  return result;\n}\n\nexport function credentialsPath(): string {\n  return path.join(credentialStorageHome(), \".config/nexus/credentials.json\");\n}\n\nfunction readJson(file: string): any {\n  try {\n    return JSON.parse(fs.readFileSync(file, \"utf-8\"));\n  } catch {\n    return undefined;\n  }\n}\n\nfunction readStore(): StoreFile {\n  const raw = readJson(credentialsPath());\n  return raw && typeof raw === \"object\" && raw.providers && typeof raw.providers === \"object\"\n    ? { version: 1, providers: raw.providers }\n    : { version: 1, providers: {} };\n}\n\n/** Atomic, owner-only write: a credential file is never briefly world-readable or half-written. */\nfunction writeStore(store: StoreFile): void {\n  const file = credentialsPath();\n  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });\n  const tmp = `${file}.${process.pid}.tmp`;\n  fs.writeFileSync(tmp, JSON.stringify(store, null, 2) + \"\\n\", { mode: 0o600 });\n  fs.renameSync(tmp, file);\n  fs.chmodSync(file, 0o600);\n}\n\nexport function saveCredential(providerId: string, credential: StoredCredential): void {\n  const store = readStore();\n  store.providers[providerId] = credential;\n  writeStore(store);\n}\n\nimport fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { config as loadDotenv, parse as parseDotenv } from \"dotenv\";\nimport { credentialOriginOf, credentialStorageHome, environmentCredential, LocalLlmClient, operatorSetting, setCredentialAuthority } from \"./client.js\";\nimport { baseUrlSetting, originOf, parseOriginList, PROVIDERS, providerDefinition } from \"./providers.js\";\nimport { providerApiKey } from \"./credentials.js\";\nimport { ContinuationBudget, DEFAULT_CONTINUATION, HarnessConfig, ApprovalMode } from \"./types.js\";\n\nconst installEnv = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../.env\");\nconst DEFAULT_ENDPOINT = \"http://localhost:1234/v1\";\nlet credentialAuthorityRecorded = false;\nlet shellEnvironment: Record<string, string | undefined> = {};\nlet userConfigFile: Record<string, string> = {};\nconst SHELL_PRE…4006 tokens truncated…readOnly)),\ncli/src/index.ts:208:  const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\ncli/src/index.ts:249:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\ncli/src/index.ts:258:    const trustDecision = await promptWorkspaceTrust(options.workspace ? path.resolve(options.workspace) : process.cwd());\ncli/src/index.ts:288:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\ncli/src/index.ts:306:  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\ncli/src/index.ts:344:  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\ncli/src/index.ts:353:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\ncli/src/index.ts:385:  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\ncli/src/index.ts:388:  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\ncli/src/index.ts:734:    const { untrustedWorkspaceExtensions } = await import(\"./workspace_trust.js\");\ncli/src/index.ts:735:    for (const file of untrustedWorkspaceExtensions(ws).filter((f) => /(^|[\\\\/])\\.?mcp\\.json$/.test(f))) {\ncli/src/index.ts:773:    const { untrustedWorkspaceExtensions } = await import(\"./workspace_trust.js\");\ncli/src/index.ts:774:    for (const file of untrustedWorkspaceExtensions(ws).filter((f) => !/(^|[\\\\/])\\.?mcp\\.json$/.test(f))) {\ncli/src/index.ts:791:  .description(\"Trust a workspace so its own .mcp.json servers and plugins are loaded (they run code from the workspace)\")\ncli/src/index.ts:792:  .option(\"--remove\", \"Stop trusting the workspace\")\ncli/src/index.ts:793:  .option(\"--list\", \"List trusted workspaces\")\ncli/src/index.ts:795:    const { listTrustedWorkspaces, setWorkspaceTrusted } = await import(\"./workspace_trust.js\");\ncli/src/index.ts:797:      const list = listTrustedWorkspaces();\ncli/src/index.ts:798:      console.log(list.length ? list.join(\"\\n\") : \"No trusted workspaces.\");\ncli/src/index.ts:808:    console.log(options.remove ? `No longer trusted: ${real}` : `Trusted: ${real}\\nIts .mcp.json servers and plugins will be loaded (they run code from this workspace). Undo with \\`nexus trust --remove\\`.`);\ncli/src/skills.ts:4:import { isWorkspaceTrusted } from \"./workspace_trust.js\";\ncli/src/skills.ts:48:        : isWorkspaceTrusted(this.workspace, this.readOnly);\ndocs/v1.0.0/evidence/A2_verification.md:37:- **Trust boundary.** Verifier commands run repository-defined code: Makefile recipes, package.json scripts, build.rs, conftest.py. They run through `bridge.executeTool(\"run_command\")` directly, so the dispatch approval gate (agent.ts:3947) never sees them. The sandbox applies only if `--