kspace(task, ws);\n189:    const t3Baseline = task.tier === \"T3\" ? steeringBaseline(task, ws) : null;\n190:    // On the per-run task copy, so the steering hook in runAgent can read it. The commands run on a throwaway copy of\n193:    if (task.tier === \"T3\") {\n194:      const probe = fs.mkdtempSync(path.join(scratch, `nexus-eval-t3-baseline-${task.id}-`));\n197:        task.t3CommandBaseline = await commandBaseline(task, (command) => runIsolated(command, { cwd: probe, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => {\n206:    const sourceBefore = treeDigest(task.dir);\n209:    // T4: a task (or the config) may schedule faults for the proxy to inject; they are recorded with the run.\n210:    const faults = task.faults ?? config.faults ?? [];\n{\n  \"sealed_at\": \"2026-10-18T03:05:52.513Z\",\n  \"store\": \"/home/mike/nexus-heldout-v2\",\n  \"tier\": \"T2\",\n  \"task_count\": 40,\n  \"external_repo_tasks\": 40,\n  \"by_class\": {\n    \"bugfix\": 10,\n    \"debug\": 10,\n    \"feature\": 10,\n    \"refactor\": 10\n  },\n  \"by_language\": {\n    \"go\": 10,\n    \"javascript\": 10,\n    \"python\": 10,\n    \"rust\": 10\n  },\n  \"hash_scheme\": {\n    \"task_sha256\": \"sha256 of raw tasks/<id>/task.json bytes\",\n    \"hidden_sha256\": \"sha256 of sorted '<path>  <sha256(file)>\\\\n' lines over tasks/<id>/<hidden.dir> (bin/hidden_digest.mjs)\"\n  },\n  \"tasks\": [\n    {\n      \"id\": \"ho2-go-bugfix-02\",\n      \"class\": \"bugfix\",\n      \"language\": \"go\",\n      \"difficulty\": \"easy\",\n      \"repo\": {\n        \"url\": \"https://github.com/hashicorp/go-version.git\",\n        \"commit\": \"1f6705b50d3f7137a753c1f61b2e292bef70c0c2\"\n      },\n      \"task_sha256\": \"5972189a560c809cc2d87060563842ce0fa591e4f07320d294d831a59638c233\",\n      \"hidden_sha256\": \"8b88607e573deb1810a52b92c4529f27fa752eb80698dadb265dbe138309cf2b\",\n      \"batch\": 2\n    },\n    