mpleted","conclusion":"success","number":4},{"name":"Run bash scripts/ensure-ci-bubblewrap.sh","status":"completed","conclusion":"success","number":5},{"name":"Run bash scripts/ensure-ci-user-cgroups.sh","status":"completed","conclusion":"success","number":6},{"name":"Mount a dedicated capped tmpfs for evaluator resource fixtures","status":"completed","conclusion":"success","number":7},{"name":"Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020","status":"completed","conclusion":"success","number":8},{"name":"Install selected Node runtime for isolated evaluation commands","status":"completed","conclusion":"success","number":9},{"name":"Run node scripts/sync-version.mjs --check","status":"completed","conclusion":"success","number":10},{"name":"Run node scripts/check_requirements.mjs","status":"completed","conclusion":"success","number":11},{"name":"Run npm ci --prefix cli","status":"completed","conclusion":"success","number":12},{"name":"Run npm --prefix cli run build","status":"completed","conclusion":"success","number":13},{"name":"Run git diff --exit-code -- cli/dist","status":"completed","conclusion":"success","number":14},{"name":"Run cargo test --locked --manifest-path core/Cargo.toml","status":"completed","conclusion":"success","number":15},{"name":"Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui","status":"completed","conclusion":"success","number":16},{"name":"Install pinned security and SBOM test tools","status":"completed","conclusion":"success","number":17},{"name":"Run npm --prefix cli test","status":"in_progress","conclusion":null,"number":18},{"name":"Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020","status":"pending","conclusion":null,"number":34},{"name":"Post Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff","status":"pending","conclusion":null,"number":35},{"name":"Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262","status":"pending