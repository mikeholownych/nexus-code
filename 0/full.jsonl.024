_grace + crate::live_state::APPROVAL_TYPING_RECENT), None);\\n        let approve = app\\n            .state\\n            .on_key_at(\\n                KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE),\\n                past_grace + crate::live_state::APPROVAL_TYPING_RECENT + crate::live_state::APPROVAL_CHOICE_SHOWN,\\n            )\\n            .unwrap();\\n        assert!(app.handle(approve));\\n        pump_until(&mut app, |s| {\\n            !s.session.busy\\n                && s.transcript\\n                    .iter()\\n                    .any(|e| matches!(e, Entry::Banner { .. }))\\n        });\\n        assert_eq!(\\n            app.state.link,\\n            Link::Ready,\\n            \\\"the fake exits 7 on a wrong answer\\\"\\n        );\\n        assert!(app.state.transcript.iter().any(|e| matches!(\\n            e,\\n            Entry::Decision {\\n                verdict: Verdict::Approved,\\n                ..\\n            }\\n        )));\\n        assert!(!app.handle(Action::Quit));\\n    }\\n\\n    #[test]\\n    fn a_slash_command_round_trips_through_the_sidecar() {\\n        let script = format!(\\n            r#\\\"{HELLO}\\nread cmd\\ncase \\\"$cmd\\\" in *'\\\"type\\\":\\\"slash\\\"'*) ;; *) exit 9;; esac\\ncase \\\"$cmd\\\" in *'\\\"command\\\":\\\"diff\\\"'*) ;; *) exit 9;; esac\\ncase \\\"$cmd\\\" in *'\\\"id\\\":\\\"s1\\\"'*) ;; *) exit 9;; esac\\necho '{{\\\"v\\\":1,\\\"type\\\":\\\"session.state\\\",\\\"workspace\\\":\\\"/w\\\",\\\"workspace_name\\\":\\\"w\\\",\\\"model\\\":\\\"m\\\",\\\"mode\\\":\\\"auto\\\",\\\"git\\\":null,\\\"busy\\\":true}}'\\necho '{{\\\"v\\\":1,\\\"type\\\":\\\"slash.result\\\",\\\"id\\\":\\\"s1\\\",\\\"command\\\":\\\"diff\\\",\\\"success\\\":true,\\\"output\\\":\\\"+added line\\\",\\\"format\\\":\\\"diff\\\"}}'\\necho '{{\\\"v\\\":1,\\\"type\\\":\\\"session.state\\\",\\\"workspace\\\":\\\"/w\\\",\\\"workspace_name\\\":\\\"w\\\",\\\"model\\\":\\\"m\\\",\\\"mode\\\":\\\"auto\\\",\\\"git\\\":null,\\\"busy\\\":false}}'\\nread shutdown\\ncase \\\"$shutdown\\\" in *'\\\"type\\\":\\\"shutdown\\\"'*) exit 0;; *) exit 8;; esac\\\"#\\ncore/src/bin/nexus_tui/live.rs:532:            TermEvent::Key(KeyEvent::new(KeyCode::Char('y'), KeyModifiers::NONE)),\\ncore/src/bin/nexus_tui/live.rs:539:        let with_resize = vec![TermEvent::Key(KeyEvent::new(KeyCode::Char('y'), KeyModifiers::NONE)), TermEvent::Resize(80, 24)];\\ncore/src/bin/nexus_tui/live.rs:647:        assert_eq!(app.state.on_key_at(KeyEvent::new(KeyCode::Char('y'), KeyModifiers::NONE), Instant::now()), None);\\ncore/src/bin/nexus_tui/live.rs:656:        assert_eq!(app.state.on_key_at(KeyEvent::new(KeyCode::Left, KeyModifiers::NONE), past_grace), None);\\ncore/src/bin/nexus_tui/live.rs:681:                verdict: Verdict::Approved,\\ncore/src/bin/nexus_tui/live_view.rs:602:        let unreachable = verdict == Verdict::ApprovedForSession && !approval.letters;\\ncore/src/bin/nexus_tui/live_view.rs:616:    buttons.extend(button(\\\"Approve\\\", Verdict::Approved, \\\"y\\\"));\\ncore/src/bin/nexus_tui/live_view.rs:617:    buttons.extend(button(if narrow { \\\"All later\\\" } else { \\\"Approve all later actions\\\" }, Verdict::ApprovedForSession, \\\"a\\\"));\\ncore/src/bin/nexus_tui/live_view.rs:622:        Some(Verdict::Approved) if approval.confirm_at.is_some() => if narrow {\\ncore/src/bin/nexus_tui/live_view.rs:627:        Some(Verdict::Approved) if !approval.letters => if narrow {\\ncore/src/bin/nexus_tui/live_view.rs:632:        Some(Verdict::Approved) => if narrow {\\ncore/src/bin/nexus_tui/live_view.rs:637:        Some(Verdict::ApprovedForSession) if approval.confirm_at.is_some() => if narrow {\\ncore/src/bin/nexus_tui/live_view.rs:642:        Some(Verdict::ApprovedForSession) => if narrow {\\ncore/src/bin/nexus_tui/live_view.rs:1653:                Verdict::Approved | Verdict::ApprovedForSession => (\\\"✓\\\", Color::Green, \\\"approved\\\"),\\ncore/src/bin/nexus_tui/live_view.rs:1663:            if *verdict == Verdi