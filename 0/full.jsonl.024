    ...DEFAULT_CONTINUATION,\n    maxTotalSteps: Number.isFinite(steps) ? Math.floor(steps) : steps,\n    maxTurnMinutes: positive(options.maxTurnMinutes, effectiveSetting(\"NEXUS_MAX_TURN_MINUTES\"), DEFAULT_CONTINUATION.maxTurnMinutes),\n    stagnationSteps: Math.floor(positive(options.stagnationSteps, effectiveSetting(\"NEXUS_STAGNATION_STEPS\"), DEFAULT_CONTINUATION.stagnationSteps)),\n  };\n}\n\n/** Replaces the \"local-model\" placeholder with the first model the gateway lists; unchanged if the gateway is unreachable. */\nexport async function autoDetectModel(config: HarnessConfig): Promise<HarnessConfig> {\n  // A provider's catalog lists billable models; one is never chosen on the operator's behalf.\n  if (config.provider || config.model !== \"local-model\") return config;\n  try {\n          amendObjective(ledger, taskPrompt);\n        }\n      }\n      ledger.outcome = undefined;\n      ledger.continuation = { ...ledger.continuation, segments: 1, lastProgressStep: 0, stopReason: undefined };\n      this.objective = ledger;\n    }\n\n    let currentStep = 1;\n    let stepsUsed = 0;\n    const providerRecoveries: ProviderRecoveryRecord[] = [];\n    const budget = this.config.continuation;\n    const segmentSteps = Math.max(1, this.config.maxSteps);\n    const maxTotalSteps = budget ? Math.max(budget.maxTotalSteps, segmentSteps) : segmentSteps;\n    let segment = 1;\n    const tracker = this.objective && this.durable ? trackingOf(this.objective) : ExecutionTracker.fresh();\n\n    try {\n      if (this.flightRecorder) {\n        if (!this.flightRecorder.isSessionActive()) {\n          this.flightRecorder.startSession({\n            model: this.config.model,\n            endpoint: this.config.endpoint,\n            taskPrompt: promptText,\n          });\n        }\n * a workspace with no applicable verifier has none (returns null).\n */\nexport function discoverVerifier(workspace: string, filterPattern?: string): DiscoveredVerifier | null {\n  const root = path