 not count on a worker (default: proceed on the labelled estimate)\")\n  .option(\"--max-turn-minutes <number>\", \"Continuation: an explicit wall-clock limit for one turn in minutes (default: none)\")\n  .option(\"--stagnation-steps <number>\", \"Continuation: stop after this many steps without progress (default 12)\")\n  .option(\"--no-continuation\", \"End a turn at --max-steps instead of continuing while it makes progress\")\n  .option(\"-t, --temperature <number>\", \"Model temperature (default: 0.2)\")\n  .option(\"--shell <type>\", \"Linux shell to use: bash, zsh, or sh (default: bash)\", \"bash\")\n  .option(\"--fallback <urls>\", \"Comma-separated fallback LLM endpoints if primary is unavailable\")\n  .option(\"--context-limit <tokens>\", \"Context window limit in tokens; below the provider's advertised capacity it is kept, above it the advertised capacity applies (default: advertised capacity, else 65536)\")\n  .option(\"--dry-run\", \"Simulate file modifications without writing changes to disk\")\n  .option(\"--read-only\", \"Reject all mutating tool executions and commands\")\n  .option(\"--sandbox [mode]\", \"Isolate command execution using bubblewrap (bwrap) or Docker (default: auto)\")\n  .option(\"--worktree\", \"Isolate execution inside an ephemeral git worktree under .nexus/worktrees/<task-id>\")\n  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\n  .option(\"--deliverable-file <path>\", \"Operator-declared workspace-relative product file used for VERIFIED binding (repeatable)\", collectDeliverableFile, [])\n  .option(\"--record-flight\", \"Record execution into an append-only deterministic .flightlog\")\n  .option(\"--planner-model <name>\", \"Deep reasoning model for architecture planning (o3, R1, Sonnet)\")\n  .option(\"--planner-endpoint <url>\", \"Dedicated inference endpoint for planner model\")\n  .option(\"--coder-model <name>\", \"High-throughput model for surgical code implementation (Qwen 2.5 Coder)\")\n  .option(\"--coder-endpoint <url>\", \"Dedicated inference endpoint for coder model\")\n  .option(\"--approve\", \"Require human approval before destructive actions (edits, shell commands)\")\n  .option(\"-y, --yes\", \"Run non-interactively without approval prompts (forces auto mode)\")\n  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\n  .option(\"--provider <id>\", \"Cloud inference provider: openrouter, openai, anthropic, compatible (default: appliance endpoint)\")\n  .option(\"--base-url <url>\", \"Override the provider's base URL (operator-only; required for 'compatible')\")\n  .option(\"--planner-provider <id>\", \"Cloud provider for the planner model (requires --planner-model)\")\n  .option(\"--coder-provider <id>\", \"Cloud provider for the coder model (requires --coder-model)\")\n  .option(\"-r, --resume [id]\", \"Resume previous session (defaults to latest if id omitted)\")\n  .action(async (_options: any, cmd: Command) => {\n    const options = cmd.optsWithGlobals();\n    await startRepl(options);\n  });\n\nprogram\n  .command(\"run\")\n  .description(\"Run an autonomous coding task\")\n  .argument(\"[prompt...]\", \"The coding instructions / task prompt\")\n  .option(\"-e, --endpoint <url>\", \"Local LLM endpoint (default: http://localhost:1234/v1 or $LOCAL_LLM_ENDPOINT)\")\n  .option(\"-m, --model <name>\", \"Model name identifier (default: active model in LM Studio/vLLM)\")\n  .option(\"-w, --workspace <path>\", \"Workspace directory to inspect and modify (default: current directory)\")\n  .option(\"-s, --max-steps <number>\", \"Steps per segment; continuation checkpoints there instead of stopping\", \"30\")\n  .option(\"--max-total-steps <number>\", \"Continuation: an explicit total-step limit for one turn (default: none; progressing work continues)\")\n  .option(\"--strict-token-count\", \"Refuse a request the connection could not count on a worker (default: proceed on the labelled estimate)\")\n  .option(\"--max-turn-minutes <number>\", \"Continuation: an explicit wall-clock limit for one turn in minutes (default: none)\")\n  .option(\"--stagnation-steps <number>\", \"Continuation: stop after this many steps without progress (default 12)\")\n  .option(\"--no-continuation\", \"End a turn at --max-steps instead of continuing while it makes progress\")\n  .option(\"-t, --temperature <number>\", \"Model temperature\", \"0.2\")\n  .option(\"--shell <type>\", \"Linux shell to use: bash, zsh, or sh (default: bash or $LOCAL_HARNESS_SHELL)\", \"bash\")\n  .option(\"--fallback <urls>\", \"Comma-separated fallback LLM endpoints if primary is unavailable\")\n  .option(\"--context-limit <tokens>\", \"Context window limit in tokens; below the provider's advertised capacity it is kept, above it the advertised capacity applies (default: advertised capacity, else 65536)\")\n  .option(\"--dry-run\", \"Simulate file modifications without writing changes to disk\")\n  .option(\"--read-only\", \"Reject all mutating tool executions and commands\")\n  .option(\"-y, --yes\", \"Run non-interactively without approval prompts (forces auto mode)\")\n  .option(\"--approve\", \"Require human approval before destructive actions (forces review mode)\")\n  .option(\"--mode <mode>\", \"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\")\n  .option(\"--sandbox [mode]\", \"Isolate command execution using bubblewrap (bwrap) or Docker (default: auto)\")\n  .option(\"--worktree\", \"Isolate execution inside an ephemeral git worktree under .nexus/worktrees/<task-id>\")\n  .option(\"--authoritative-verifier <command>\", \"Trusted command that must pass before any task completion; its success may authorize automatic worktree merge\")\n  .option(\"--deliverable-file <path>\", \"Operator-declared workspace-relative product file used for VERIFIED binding (repeatable)\", collectDeliverableFile, [])\n  .option(\"--record-flight\", \"Record execution into an append-only deterministic .flightlog\")\n  .option(\"--planner-model <name>\", \"Deep reasoning model for architecture planning (o3, R1, Sonnet)\")\n  .option(\"--planner-endpoint <url>\", \"Dedicated inference endpoint for planner model\")\n  .option(\"--coder-model <name>\", \"High-throughput model for surgical code implementation (Qwen 2.5 Coder)\")\n  .option(\"--coder-endpoint <url>\", \"Dedicated inference endpoint for coder model\")\n  .option(\"--tdd\", \"Enforce strict RED-GREEN-REFACTOR Test-Driven Development protocol\")\n/**\n * Continuation budgets: flags, then NEXUS_MAX_TOTAL_STEPS / NEXUS_MAX_TURN_MINUTES / NEXUS_STAGNATION_STEPS, then\n * defaults. There is no default step or time ceiling: progressing work continues until it completes, is cancelled,\n * stagnates or fails. A step or time limit exists only when the operator sets one. `--no-continuation` (or\n * NEXUS_CONTINUATION=0) is the operator's explicit choice of the single-segment turn that ends at --max-steps.\n */\nexport function continuationBudget(options: any): ContinuationBudget | undefined {\n  if (options.continuation === false || effectiveSetting(\"NEXUS_CONTINUATION\") === \"0\") return undefined;\n  const positive = (flag: unknown, env: string | undefined, fallback: number): number => {\n    for (const raw of [flag, env]) {\n      if (raw === undefined || raw === null || raw === \"\") continue;\n      const value = Number(raw);\n      if (!Number.isFinite(value) || value <= 0) throw new Error(`Invalid continuation budget '${String(raw)}': expected a positive number.`);\n      return value;\n    }\n    return fallback;\n  };\n  const steps = positive(options.maxTotalSteps, effectiveSetting(\"NEXUS_MAX_TOTAL_STEPS\"), DEFAULT_CONTINUATION.maxTotalSteps);\n  return {\n    ...DEFAULT_CONTINUATION,\n    maxTotalSteps: Number.isFinite(steps) ? Math.floor(steps) : steps,\n    maxTurnMinutes: positive(options.maxTurnMinutes, effectiveSetting(\"NEXUS_MAX_TURN_MINUTES\"), DEFAULT_CONTINUATION.maxTurnMinutes),\n    stagnationSteps: Math.floor(positive(options.stagnationSteps, effectiveSetting(\"NEXUS_STAGNATION_STEPS\"), DEFAULT_CONTINUATION.stagnationSteps)),\n  };\n}\n\n/** Replaces the \"local-model\" placeholder with the first model the gateway lists; unchanged if the gateway is unreachable. */\nexport async function autoDetectModel(config: HarnessConfig): Promise<HarnessConfig> {\n  // A provider's catalog lists billable models; one is never chosen on the operator's behalf.\n  if (config.provider || config.model !== \"local-model\") return config;\n  try {\n          amendObjective(ledger, taskPrompt);\n        }\n      }\n      ledger.outcome = undefined;\n      ledger.continuation = { ...ledger.continuation, segments: 1, lastProgressStep: 0, stopReason: undefined };\n      this.objective = ledger;\n    }\n\n    let currentStep = 1;\n    let stepsUsed = 0;\n    const providerRecoveries: ProviderRecoveryRecord[] = [];\n    const budget = this.config.continuation;\n    const segmentSteps = Math.max(1, this.config.maxSteps);\n    const maxTotalSteps = budget ? Math.max(budget.maxTotalSteps, segmentSteps) : segmentSteps;\n    let segment = 1;\n    const tracker = this.objective && this.durable ? trackingOf(this.objective) : ExecutionTracker.fresh();\n\n    try {\n      if (this.flightRecorder) {\n        if (!this.flightRecorder.isSessionActive()) {\n          this.flightRecorder.startSession({\n            model: this.config.model,\n            endpoint: this.config.endpoint,\n            taskPrompt: promptText,\n          });\n        }\n * a workspace with no applicable verifier has none (returns null).\n */\nexport function discoverVerifier(workspace: string, filterPattern?: string): DiscoveredVerifier | null {\n  const root = path.resolve(workspace);\n  const filter = validateFilterPattern(filterPattern);\n  const has = (p: string) => fs.existsSync(path.join(root, p));\n\n  if (has(\"Makefile\")) {\n    try {\n      if (/^test:/m.test(fs.readFileSync(path.join(root, \"Makefile\"), \"utf-8\"))) {\n        return {\n          command: filter ? `make test FILTER=\"${filter}\"` : \"make test\",\n          evidence: \"Makefile:test\",\n        };\n      }\n    } catch {}\n  }\n  if (has(\"Cargo.toml\")) {\n    return {\n      command: filter ? `cargo test -- ${filter}` : \"cargo test\",\n      evidence: \"Cargo.toml\",\n    };\n  }\n  if (has(\"core/Cargo.toml\")) {\n    return {\n      command: filter\n        ? `cargo test --manifest-path core/Cargo.toml -- ${filter}`\n        : \"cargo test --manifest-path core/Cargo.toml\",\n      evidence: \"core/Cargo.toml\",\n    };\n  }\n\n  const npmTest = (pkgRel: string): boolean => {\n    try {\n      const pkg = JSON.parse(fs.readFileSync(path.join(root, pkgRel), \"utf-8\"));\n      const script = pkg?.scripts?.test;\n      return typeof script === \"string\" && script.trim().length > 0 && !/no test specified/i.test(script);\n    } catch {\n      return false;\n    }\n  };\n  if (has(\"package.json\") && npmTest(\"package.json\")) {\n    return {\n      command: filter ? `npm test -- -t \"${filter}\"` : \"npm test\",\n      evidence: \"package.json:scripts.test\",\n    };\n  }\n  if (has(\"cli/package.json\") && npmTest(\"cli/package.json\")) {\n    return {\n      command: filter ? `npm --prefix cli test -- -t \"${filter}\"` : \"npm --prefix cli test\",\n      evidence: \"cli/package.json:scripts.test\",\n        // The same check as the authority engine: one allowlist, with argument-level escapes (find -exec, rg --pre…).\n        if (!isSafeReadOnlyCommand(cmd, undefined, this.workspace)) {\n          return {\n            success: false,\n            output: \"\",\n            error: `Read-only mode violation: Non-read command '${cmd}' is blocked.`,\n          };\n        }\n      }\n    }\n\n    // 3. Dry-run mode simulation\n    if (this.dryRun) {\n      if 