tation with unrelated passing tests ends REGRESSION_FREE (never VERIFIED)\", async () => {\ncli/test/repro_false_verified.test.ts:83:    assert.equal(result.turn.outcome, \"REGRESSION_FREE\");\ncli/test/verification_binding.test.ts:8:  isVerifierDeliverableBound,\ncli/test/verification_binding.test.ts:108:    const boundCoincidence = isVerifierDeliverableBound(d, [path.join(d, \"src/a.ts\")], \"npm test\", out);\ncli/test/verification_binding.test.ts:113:    const boundReadme = isVerifierDeliverableBound(d, [path.join(d, \"README.md\")], \"npm test\", \"ℹ tests 1\\nℹ pass 1\\nsee README.md\");\ncli/test/verification_binding.test.ts:117:    const boundExact = isVerifierDeliverableBound(d, [path.join(d, \"src/a.ts\")], \"npm test\", \"ℹ tests 1\\nℹ pass 1\\nPASS src/a.ts:10:2\");\ncli/test/verification_binding.test.ts:121:    const boundScopedImport = isVerifierDeliverableBound(d, [path.join(d, \"src/a.ts\")], \"npm test\", \"ℹ tests 1\\nℹ pass 1\", new Set([\"src/a.ts\"]), baselineTests);\ncli/test/verification_binding.test.ts:127:      isVerifierDeliverableBound(d, [path.join(d, \"src/a.ts\")], \"npm test\", \"ℹ tests 1\\nℹ pass 1\", new Set([\"src/a.ts\"]), wrongSameBasename),\ncli/test/verification_binding.test.ts:133:    const boundEmpty = isVerifierDeliverableBound(d, [], \"npm test\", \"ℹ tests 1\\nℹ pass 1\");\ncli/test/verification_binding.test.ts:135:    const boundEmptyScoped = isVerifierDeliverableBound(d, [], \"npm test\", \"ℹ tests 1\\nℹ pass 1\", new Set([\"src/a.ts\"]), baselineTests);\ncli/test/verification_binding.test.ts:137:    const boundFilteredScoped = isVerifierDeliverableBound(\ncli/test/verification_binding.test.ts:150:    const boundNotRun = isVerifierDeliverableBound(\ncli/test/verification_binding.test.ts:159:    const boundRan = isVerifierDeliverableBound(\ncli/test/verification_binding.test.ts:173:        isVerifierDeliverableBound(d, [path.join(d, \"linked/a.ts\")], \"npm test\", \"ℹ tests 1\\nℹ pass 1\", new Set([\"linked/a.ts\"]), new