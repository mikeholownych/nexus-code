AL_REPO}/releases/download/`);\n  }\n\n  if (hostname === \"objects.githubusercontent.com\") {\n    return true;\n  }\n\n  return false;\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\n  if (signal) {\n    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n  }\n\n  try {\n    while (hops <= maxHops) {\n      if (!validateDownloadUrl(currentUrl)) {\n        throw new Error(`Disallowed download origin or invalid URL: ${currentUrl}`);\n      }\n\n      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n        headers.Authorization = `Bearer ${token}`;\n      }\n\n      const res = await fetch(currentUrl, {\n\n--- RC6 error formatting ---\n689-    while (hops <= maxHops) {\n690-      if (!validateDownloadUrl(currentUrl)) {\n691:        throw new Error(`Disallowed download origin or invalid URL: ${currentUrl}`);\n692-      }\n693-\n\n--- RC8 fixed implementation ---\n666-    return true;\n667-  }\n668-\n669:  // GitHub now redirects release downloads to its signed release-assets host.\n670-  // Restrict the path to release objects; never allow this host as a generic CDN.\n671:  if (hostname === \"release-assets.githubusercontent.com\") {\n672-    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n673-  }\n674-\n675-  return false;\n676-}\n677-\n678-/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\n679:function safeDownloadOrigin(urlString: string): string {\n680