SS on exact main b73b6ec\",\n  \"postmerge_main\": \"CI40300214592 still active in linux-x86_64 npm test; CodeQL40300214410 SUCCESS\",\n  \"postmerge_main_ci\": \"40340228722 SUCCESS exact ff34938; Node22, Node24, Linux packaging/repro/install all passed\",\n  \"postmerge_main_codeql\": \"40340228417 SUCCESS exact ff34938\",\n  \"postmerge_readiness_ci\": \"main CI40300214592 and CodeQL40300214410 status pending/currently running\",\n  \"pr\": 241,\n  \"pr254_checks\": \"Exact head 24774a1136775a9069981a5d8d9b763d8fa09253: Node22 SUCCESS, Node24 SUCCESS, javascript-typescript SUCCESS, CodeQL SUCCESS; Linux packaging/reproducibility IN_PROGRESS run40322090307.\",\n  \"rc9_branch\": \"v1/rc9-version-bump\",\n  \"rc9_checks\": \"PR257 exact head 290c57d: CI40348135492 IN_PROGRESS; CodeQL40348135495 IN_PROGRESS.\",\n  \"rc9_head\": \"290c57d17aab5da44e28ad8fa5e8a29772c3a203\",\n  \"rc9_pr\": 257,\n  \"rc9_review\": \"Independent ACCEPT by rc5_candidate_review on exact diff a421f209015253ce7c574d675e06abbeb1028319a1a88d81c4e72570aef591b8; all package versions rc9; release notes accurate; Node>=22 retained.\",\n  \"rc9_worktree\": \"/home/mike/nexus-wt/rc9-version-bump\",\n  \"readiness_branch\": \"v1/readiness-post-rc8-pr254\",\n  \"readiness_head\": \"4564ac6e4a8bbbec8f033a53a552f01514c1cb7a\",\n  \"readiness_postmerge\": \"PR251 merge e9304b1cafa629a999e9165977588c9524a4d9da; post-merge main CI40300214592 SUCCESS all jobs (completed 2026-10-26T10:12:25Z); CodeQL40300214410 SUCCESS.\",\n  \"readiness_pr\": 255,\n  \"readiness_pr_base\": \"b73b6ecaf753ff3eba8d5e1930ede7a471359421\",\n  \"readiness_pr_checks\": \"Exact head 4564ac6: CodeQL SUCCESS; JS/TS SUCCESS; Node22 and Node24 full CLI suites in progress.\",\n  \"readiness_pr_ci\": \"40294952888 in progress; Linux npm test in progress; Node22/Node24 success\",\n  \"readiness_pr_codeql\": \"40294952933 SUCCESS\",\n  \"readiness_pr_head\": \"49eeea053dae33fe9389e000965b7d0de75e64d7\",\n  \"readiness_pr_merged\": \"e9304b1cafa629a999e9165977588c9524a4d9da\",\n  \"readiness_pr_review\": \"ACCEPT after body correction; reviewer plan05_readonly_review verified 08:05 checkpoint and signature status\",\n  \"readiness_pr_status\": \"PR255 MERGED 2026-10-26T14:30:34Z; exact head CI40333869626 Node22/24/Linux PASS; CodeQL40333869903 PASS; JS/TS PASS; independent ACCEPT; postmerge CI40340228722 and CodeQL40340228417 in progress.\",\n  \"readiness_worktree\": \"/home/mike/nexus-wt/readiness-post-rc8-pr254\",\n  \"release_status\": \"RC8 is a public prerelease based on bbafae868939084ccd49f21621695dff6b05f752; no accepted RC or stable v1.0.0. Issue #1 custody unanswered; human terminal matrix last recorded 0/15; exact-current-RC qualification and independent acceptance remain incomplete.\",\n  \"requirements_gate\": \"PASS: 123 rows; 12 exact-RC deferrals\",\n  \"reviewed_diff_sha256\": \"06ac7420c9901f4c9d77367900de7ce3e9b4eae3fa3535144501dd614a71f5a0\",\n  \"reviewer\": \"rc5_candidate_review\",\n  \"scope\": \"Release publisher owns RC lifecycle and exact-source/artifact acceptance coordination; no held-out access, no stable publication until every release gate passes.\",\n  \"stable_signing_identity\": \"one local GPG secret key matches GitHub-verified key metadata; no key material logged; reverify chosen signer on the final stable tag\",\n  \"status\": \"PR254 merged at b73b6ecaf753ff3eba8d5e1930ede7a471359421; exact-main CodeQL 40327501389 PASS; exact-main Node22 and Node24 pass, linux-x86_64 active. Requirements and version checks pass. Wait for Linux terminal result before RC9.\",\n  \"terminal_matrix_preflight\": \"Verified on ubuntu-desktop via SSH: RC8 isolated version bbafae868939; all five required terminals plus tmux/python3 installed; harness and output directory ready; 0 evidence cells. SSH lacks DISPLAY, therefore operator must run interactive cells from actual GNOME desktop session. Required 15 cells unchanged.\",\n  \"updated_at\": \"2026-10-26T15:25:00Z\",\n  \"version_sync\": \"PASS: components at 1.0.0-rc.8\",\n  \"worktree\": \"/home/mike/nexus-wt/rc7-version-bump\"\n}\n\n--- SUITE ---\n{\"agent\":\"codex-root\",\"host\":\"mike-dev\",\"branch\":\"main@33f7685\",\"scope\":\"exact post-merge version and requirements source gates\",\"since\":\"2026-10-26T16:00:00Z\",\"pid\":2417187}\n\n--- FILE_docs_v1.0.0_READINESS.md ---\n{\"agent\":\"codex-root\",\"host\":\"mike-dev\",\"branch\":\"v1/readiness-rc8-install-terminal-20261026\",\"scope\":\"append one exact-revision readiness checkpoint; preserve historical entries\",\"base\":\"ff349383537b10ec6198ceb0961e833bd519c2b4\"}\n\n--- DEFECT_UPGRADE_RESET_RETRY_20261026 ---\n{\n  \"agent\": \"codex-root\",\n  \"handoff_from\": \"KimiCode-defect-scan\",\n  \"host\": \"mike-dev\",\n  \"branch\": \"v1/defect-upgrade-tui-contamination-20261026\",\n  \"worktree\": \"/home/mike/nexus-wt/upgrade-tui-contamination\",\n  \"base\": \"e9304b1cafa629a999e9165977588c9524a4d9da\",\n  \"head\": \"afec611\",\n  \"since\": \"2026-10-26T09:35:36.202Z\",\n  \"scope\": \"integrate explicitly handed-off download reset retry fix; rebase to current main and exact-head CI; no unrelated behavior\",\n  \"status\": \"PR253 exact-head run40300910853: Node22 and Node24 full suites SUCCESS; Linux reproducible package build IN_PROGRESS at second package-linux.sh pass; CodeQL40300910924 and JS/TS SUCCESS. Exact base/head e9304b1/afec611; no merge until Linux job terminal.\",\n  \"independent_review\": \"agent-26 ACCEPT on handed-off candidate\",\n  \"rebased_from\": \"72743a66251828e6b9f883b7595f61ab04edd208\",\n  \"patch_sha256\": \"736d3df762b436d123b6e3fbc98e50a5dae1430bf1a565de33d8fa1abe2f9cff\",\n  \"updated_at\": \"2026-10-26T10:16:43Z\",\n  \"local_source_gates\": \"scripts/check_requirements.mjs --enforce PASS (123 rows, 12 explicit exact-RC deferrals); scripts/sync-version.mjs --check PASS; git diff --check PASS on afec611\",\n  \"pr\": 253\n}\n\n--- FILE_cli_src_upgrade.ts ---\n{\n  \"agent\": \"codex-root\",\n  