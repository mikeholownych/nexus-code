{"timestamp":"2026-10-26T16:18:29.192Z","ordinal":393180,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a178fa-f0ed-7ab3-bb71-477460bd1a0a","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a178fa-f0ed-7ab3-bb71-477460bd1a0a","response_id":"resp_060b64278a9dfb15016adf7d50258881a0898d7d8ad828a7fe","usage":{"input_tokens":178381,"cached_input_tokens":177152,"cache_write_input_tokens":0,"output_tokens":390,"reasoning_output_tokens":239,"total_tokens":178771},"turn_token_usage":{"input_tokens":4923616,"cached_input_tokens":4879104,"cache_write_input_tokens":0,"output_tokens":19705,"reasoning_output_tokens":13634,"total_tokens":4943321},"thread_token_usage":{"input_tokens":7227517386,"cached_input_tokens":7150904320,"cache_write_input_tokens":0,"output_tokens":20629589,"reasoning_output_tokens":11964758,"total_tokens":7248146975}}}
{"timestamp":"2026-10-26T16:18:30.727Z","ordinal":393181,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a178fa-f0ed-7ab3-bb71-477460bd1a0a","item":{"type":"CommandExecution","id":"exec-83e11634-03d6-407f-93f1-1a2db787afff","process_id":"81598","command":["/usr/bin/zsh","-lc","sed -n '130,220p' cli/src/client.ts; git -C /home/mike/nexus-wt/rc9-credential-origin-binding diff 33f7685..HEAD -- cli/test/provider_connect.test.ts docs/releases/v1.0.0-rc.9.md; rg -n \"environmentCredential\\(|configuredCredentialOrigin|apiKeyEnv|credentialOrigin\" cli/src cli/test/provider_connect.test.ts | head -120"],"cwd":"file:///home/mike/nexus-wt/rc9-credential-origin-binding","parsed_cmd":[{"type":"unknown","cmd":"sed -n '130,220p' cli/src/client.ts; git -C /home/mike/nexus-wt/rc9-credential-origin-binding diff 33f7685..HEAD -- cli/test/provider_connect.test.ts docs/releases/v1.0.0-rc.9.md; rg -n \"environmentCredential\\(|configuredCredentialOrigin|apiKeyEnv|credentialOrigin\" cli/src cli/test/provider_connect.test.ts | head -120"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"  return { gateway, listed, envKey: authoritySetting(\"LOCAL_LLM_API_KEY\"), envKeyOrigin };\n}\n\n/**\n * The locally stored credential for `endpoint`, only if it belongs to that endpoint's gateway; null otherwise.\n *\n * Stored credentials are scoped to where they were configured: the gateway token file and the config.env key belong\n * to config.env's LOCAL_LLM_ENDPOINT (or, without one, the operator's $LOCAL_LLM_ENDPOINT) and to origins the operator\n * lists in LOCAL_LLM_CREDENTIAL_ORIGINS; the operator's $LOCAL_LLM_API_KEY belongs to the operator's\n * $LOCAL_LLM_ENDPOINT. Only the credential authority (see setCredentialAuthority) decides these bindings. A\n * credential is never attached to another provider merely because that provider has no key of its own.\n */\nexport function storedCredentialFor(endpoint: string): string | null {\n  const target = originOf(endpoint);\n  if (!target) return null;\n  const homes = storedCredentialHomes();\n  if (target === homes.gateway || homes.listed.has(target)) {\n    const token = readGatewayTokenFile() || readConfigEnv().LOCAL_LLM_API_KEY;\n    if (token) return token;\n  }\n  const endpointCredential = localEndpointCredential(target);\n  if (endpointCredential?.origin === target) return endpointCredential.key;\n  if (target === homes.envKeyOrigin && homes.envKey) return homes.envKey;\n  return null;\n}\n\n/** True when `value` is one of the locally stored credentials (token file, config.env key, operator env key). */\nfunction isStoredCredential(value: string): boolean {\n  const homes = storedCredentialHomes();\n  return [readGatewayTokenFile(), readConfigEnv().LOCAL_LLM_API_KEY, homes.envKey, ...localEndpointCredentials().map((credential) => credential.key)]\n    .some((stored) => stored && stored === value);\n}\n\n/**\n * Whether `key`, supplied for `endpoint` by configuration other than the credential authority (an operation spec's\n * apiKeyEnv, for example), may be sent there. Keys of their own are; a stored credential only to where it belongs.\n */\nexport function mayBindCredential(key: string | undefined, endpoint: string): boolean {\n  const value = key?.trim();\n  if (!value || !isStoredCredential(value)) return true;\n  const target = originOf(endpoint);\n  if (!target) return false;\n  const homes = storedCredentialHomes();\n  const endpointCredential = localEndpointCredentials().find((credential) => credential.key === value);\n  return target === homes.gateway || homes.listed.has(target) || (target === homes.envKeyOrigin && value === homes.envKey) || endpointCredential?.origin === target;\n}\n\n/**\n * $LOCAL_LLM_API_KEY and the origin it is bound to. The operator's key belongs to the operator's endpoint (or, when\n * the operator configured none, `operatorEndpoint`: the command-line endpoint or the built-in default). A key that a\n * project .env supplied belongs to the endpoint that configuration selects; it is that project's credential.\n */\nexport function environmentCredential(operatorEndpoint: string): { apiKey: string; origin: string | undefined } | undefined {\n  const apiKey = REDACTED;\n  if (!apiKey) return undefined;\n  const operatorKey = authoritySetting(\"LOCAL_LLM_API_KEY\");\n  const configuredCredentialOrigin = authoritySetting(\"LOCAL_LLM_CREDENTIAL_ORIGIN\") ?? readConfigEnv().LOCAL_LLM_CREDENTIAL_ORIGIN;\n  if (configuredCredentialOrigin && !originOf(configuredCredentialOrigin) && (operatorKey === apiKey || isStoredCredential(apiKey))) {\n    return undefined;\n  }\n  if (operatorKey === apiKey) {\n    return {\n      apiKey,\n      origin: originOf(configuredCredentialOrigin ?? authoritySetting(\"LOCAL_LLM_ENDPOINT\") ?? operatorEndpoint),\n    };\n  }\n  if (isStoredCredential(apiKey)) return undefined;\n  return { apiKey, origin: originOf(process.env.LOCAL_LLM_ENDPOINT ?? operatorEndpoint) };\n}\n\nexport interface ChatCompletionResponse {\n  id: string;\n  choices: Array<{\n    index: number;\n    message: ChatMessage;\n    finish_reason: string;\n  }>;\n  usage?: {\n    prompt_tokens: number;\n    completion_tokens: number;\n    total_tokens: number;\n  };\n}\n\nexport type StreamTokenCallback = (token: string) => void;\n\nconst DEFAULT_CLASSIFICATION: Record<InferenceFailureKind, ProviderClassification> = {\n  http_error: { condition: \"PERMANENT_FAILURE\", execution: \"UNKNOWN\" },\n  network_error: { condition: \"TEMPORARILY_UNAVAILABLE\", execution: \"UNKNOWN\" },\n  timeout: { condition: \"TEMPORARILY_UNAVAILABLE\", execution: \"UNKNOWN\" },\n  stream_interrupted: { condition: \"TEMPORARILY_UNAVAILABLE\", execution: \"UNKNOWN\" },\ndiff --git a/cli/test/provider_connect.test.ts b/cli/test/provider_connect.test.ts\nindex e6add77..e153389 100644\n--- a/cli/test/provider_connect.test.ts\n+++ b/cli/test/provider_connect.test.ts\n@@ -428,23 +428,35 @@ describe(\"connecting from the picker\", () => {\n     }\n   });\n \n-  test(\"changing the local endpoint does not rebind a config.env key to the new origin\", () => {\n+  test(\"changing the local endpoint does not rebind a config.env key to the new origin\", async () => {\n     const oldEndpoint = \"http://127.0.0.1:4321/v1\";\n-    const newEndpoint = \"http://127.0.0.1:5432/v1\";\n+    const oldOrigin = \"http://127.0.0.1:4321\";\n+    const replacement = await mock((_s, res) => { res.writeHead(200, { \"content-type\": \"application/json\" }); res.end(JSON.stringify({ data: [] })); });\n+    const newEndpoint = `${replacement.url}/v1`;\n     const configFile = write(\".config/nexus/config.env\", `LOCAL_LLM_ENDPOINT=${JSON.stringify(oldEndpoint)}\\nLOCAL_LLM_API_KEY=legacy-old-origin-key\\n`);\n     setCredentialAuthority({ LOCAL_LLM_ENDPOINT: oldEndpoint, LOCAL_LLM_API_KEY: \"legacy-old-origin-key\" }, home);\n     assert.equal(storedCredentialFor(oldEndpoint), \"legacy-old-origin-key\");\n \n-    saveLocalEndpointSettings(newEndpoint, \"new-model\");\n-    setCredentialAuthority({\n-      LOCAL_LLM_ENDPOINT: newEndpoint,\n-      LOCAL_LLM_API_KEY: \"legacy-old-origin-key\",\n-      LOCAL_LLM_CREDENTIAL_ORIGIN: \"http://127.0.0.1:4321\",\n-    }, home);\n+    try {\n+      saveLocalEndpointSettings(newEndpoint, \"new-model\");\n+      operator({\n+        LOCAL_LLM_ENDPOINT: newEndpoint,\n+        LOCAL_LLM_API_KEY: \"legacy-old-origin-key\",\n+        LOCAL_LLM_CREDENTIAL_ORIGIN: oldOrigin,\n+      });\n \n-    assert.equal(storedCredentialFor(newEndpoint), null, \"the legacy key must not follow the changed endpoint\");\n-    assert.equal(storedCredentialFor(oldEndpoint), \"legacy-old-origin-key\", \"the legacy key remains usable only at its original origin\");\n-    assert.match(fs.readFileSync(configFile, \"utf8\"), /LOCAL_LLM_CREDENTIAL_ORIGIN=\"http:\\/\\/127\\.0\\.0\\.1:4321\"/);\n+      assert.equal(storedCredentialFor(newEndpoint), null, \"the legacy key must not follow the changed endpoint\");\n+      assert.equal(storedCredentialFor(oldEndpoint), \"legacy-old-origin-key\", \"the legacy key remains usable only at its original origin\");\n+      assert.deepEqual(environmentCredential(newEndpoint), { apiKey: \"legacy-old-origin-key\", origin: oldOrigin });\n+\n+      const config = buildConfig({ endpoint: newEndpoint });\n+      assert.equal(config.credentialOrigin, oldOrigin, \"buildConfig keeps the key bound to the recorded origin\");\n+      await new LocalLlmClient(config).listModels();\n+      assert.deepEqual(replacement.seen.map((request) => request.headers.authorization), [\"Bearer not-needed\"], \"the replacement endpoint never receives the old key\");\n+      assert.match(fs.readFileSync(configFile, \"utf8\"), /LOCAL_LLM_CREDENTIAL_ORIGIN=\"http:\\/\\/127\\.0\\.0\\.1:4321\"/);\n+    } finally {\n+      await replacement.close();\n+    }\n   });\n \n   test(\"a malformed credential origin cannot fall back to and bind a legacy key to the selected endpoint\", () => {\ndiff --git a/docs/releases/v1.0.0-rc.9.md b/docs/releases/v1.0.0-rc.9.md\nindex 89b7286..324b80b 100644\n--- a/docs/releases/v1.0.0-rc.9.md\n+++ b/docs/releases/v1.0.0-rc.9.md\n@@ -11,6 +11,7 @@ This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and\n - **Verifier baseline timing:** capture the discovered verifier baseline before the first workspace-mutating tool runs. This preserves the pre-mutation state for verification across both direct commands and subagent dispatch.\n - **Upgrade download recovery:** retry one idempotent release download after a connection reset before a response, within the existing timeout. HTTP errors, origin and checksum validation, archive handling, and recovery behavior remain unchanged.\n - **Provider stream handling:** preserve provider output and error-code semantics for streamed and non-streamed responses, avoid unsafe immediate failover after partial output, retain cancellation and watchdog cleanup while reading error bodies, and bound and redact provider error text.\n+- **Local endpoint setup:** configure an OpenAI-compatible local endpoint from the connect flow, verify it, discover and select models, and store an optional credential for that endpoint. Existing credentials remain bound to their recorded origin when the endpoint changes.\n \n ## Runtime requirements\n \ncli/test/provider_connect.test.ts:450:      assert.deepEqual(environmentCredential(newEndpoint), { apiKey: \"legacy-old-origin-key\", origin: oldOrigin });\ncli/test/provider_connect.test.ts:453:      assert.equal(config.credentialOrigin, oldOrigin, \"buildConfig keeps the key bound to the recorded origin\");\ncli/test/provider_connect.test.ts:466:    assert.equal(environmentCredential(endpoint), undefined, \"an invalid explicit binding must not become the key's new origin\");\ncli/test/provider_connect.test.ts:471:    assert.equal(environmentCredential(endpoint), undefined, \"the key from config.env also remains unbound\");\ncli/src/types.ts:81:  credentialOrigin?: string;     // Origin apiKey belongs to (default: endpoint's origin); never sent elsewhere\ncli/src/config.ts:6:import { credentialOriginOf, credentialStorageHome, environmentCredential, LocalLlmClient, operatorSetting, setCredentialAuthority } from \"./client.js\";\ncli/src/config.ts:322:  const envCredential = options.apiKey || provider ? undefined : environmentCredential(options.endpoint || DEFAULT_ENDPOINT);\ncli/src/config.ts:324:  const credentialOrigin = apiKey === \"local\" ? undefined : options.apiKey || provider || provisionalKey ? credentialOriginOf(endpoint) : (operatorKey ? envCredential?.origin : (projectApiKey ? credentialOriginOf(endpoint) : envCredential?.origin));\ncli/src/config.ts:405:    ...(credentialOrigin ? { credentialOrigin } : {}),\ncli/src/operation_cli.ts:49:    const key = r.apiKeyEnv ? process.env[r.apiKeyEnv] : def ? providerApiKey(def.id, def.credentialEnv) : provider === conf