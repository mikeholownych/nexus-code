ng }\n   /** `key` only for method \"api-key\"; it is never echoed back or logged. */\n   | { type: \"provider.connect\"; id: string; provider: string; method: string; key?: string; endpoint?: string }\n   | { type: \"provider.cancel\"; id: string }\n+  /** Clear a completed local endpoint setup associated with this exact provider.connect request. */\n+  | { type: \"provider.local-cancel\"; id: string }\n   | { type: \"provider.disconnect\"; id: string; provider: string }\n   | { type: \"shutdown\" };\n \n export class ProtocolError extends Error {\n@@ -272,8 +274,10 @@ export function parseCommand(line: string): SidecarCommand {\n       };\n     }\n     case \"provider.cancel\":\n       return { type: \"provider.cancel\", id: requireId(\"provider.cancel\") };\n+    case \"provider.local-cancel\":\n+      return { type: \"provider.local-cancel\", id: requireId(\"provider.local-cancel\") };\n     case \"provider.disconnect\": {\n       const requestId = requireId(\"provider.disconnect\");\n       if (typeof msg.provider !== \"string\" || !msg.provider) throw new ProtocolError(\"provider.disconnect requires provider\", requestId);\n       return { type: \"provider.disconnect\", id: requestId, provider: msg.provider };\ndiff --git a/cli/src/provider_connect.ts b/cli/src/provider_connect.ts\nindex 3d7e4b1..eb31548 100644\n--- a/cli/src/provider_connect.ts\n+++ b/cli/src/provider_connect.ts\n@@ -55,21 +55,32 @@ export interface LocalEndpointPreparation {\n   cancelled?: boolean;\n }\n \n const localEndpointSetupRequests = new Map<string, { cancelled: boolean }>();\n+let provisionalLocalEndpointRequestId: string | undefined;\n \n-/** Cancel an in-flight request, or clear provisional setup after the operator closes its model picker. */\n-export function cancelLocalEndpointSetup(requestId?: string): void {\n-  if (requestId) {\n-    const request = localEndpointSetupRequests.get(requestId);\n-    if (request) {\n-      request.cancelled = true;\n-      localEndpointSetupRequests.delete(requestId);\n-    }\n+/** Cancel only the matching in-flight or already-completed local endpoint request. */\n+export function cancelLocalEndpointSetup(requestId: string): void {\n+  const request = localEndpointSetupRequests.get(requestId);\n+  if (request) {\n+    request.cancelled = true;\n+    localEndpointSetupRequests.delete(requestId);\n   }\n+  clearLocalEndpointSetup(requestId);\n+}\n+\n+/** Explicitly clear the matching completed setup when its model picker closes. */\n+export function clearLocalEndpointSetup(requestId: string): void {\n+  if (!requestId || provisionalLocalEndpointRequestId !== requestId) return;\n+  provisionalLocalEndpointRequestId = undefined;\n   resetApplianceEndpointOverride();\n }\n \n+/** Clear provisional state after the operator's explicit local model selection could not be committed. */\n+export function clearLocalEndpointSetupAfterSelectionFailure(): void {\n+  if (provisionalLocalEndpointRequestId) clearLocalEndpointSetup(provisionalLocalEndpointRequestId);\n+}\n+\n function validatedEndpoint(input: string): { endpoint: string; origin: string } | undefined {\n   const endpoint = input.trim().replace(/\\/+$/, \"\");\n   try {\n     const url = new URL(endpoint);\n@@ -111,8 +122,9 @@ export async function prepareLocalEndpoint(base: HarnessConfig, endpointInput: s\n     if (request.cancelled) return { ok: false, cancelled: true, message: \"Local endpoint setup was cancelled.\" };\n     const available = models.filter((model) => /^[A-Za-z0-9._:/@+-]{1,160}$/.test(model));\n     if (available.length === 0) return { ok: false, message: \"That endpoint returned no usable chat models.\" };\n     activateApplianceEndpoint(parsed.endpoint, undefined, true, key || undefined);\n+    provisionalLocalEndpointRequestId = requestId;\n     return { ok: true, message: `Local endpoint verified (${parsed.origin}; ${available.length} models found). Choose a model to save setup.` };\n   } catch {\n     if (request.cancelled) return { ok: false, cancelled: true, message: \"Local endpoint setup was cancelled.\" };\n     return { ok: false, message: \"Could not list models from that endpoint. Check the URL and API key, then try again.\" };\n@@ -161,8 +173,9 @@ export async function connectLocalEndpoint(\n   if (key && !saveLocalEndpointCredential(origin, key)) {\n     return { ok: false, message: \"The endpoint and model were saved, but Nexus could not securely save the API key.\", models: available };\n   }\n   activateApplianceEndpoint(endpoint, model, false);\n+  provisionalLocalEndpointRequestId = undefined;\n   return {\n     ok: true,\n     message: `Local endpoint configured (${origin}; ${available.length} models available).${key ? \" API key saved for this origin only.\" : \" No API key was saved.\"}`,\n     models: available,\n@@ -230,8 +243,9 @@ export function selectModel(agent: AutonomousAgent, config: HarnessConfig, ref:\n         } else {\n           saveLocalEndpointSettings(a.endpoint, model);\n         }\n         activateApplianceEndpoint(a.endpoint, model, false);\n+        provisionalLocalEndpointRequestId = undefined;\n       } catch {\n         return { ok: false, message: \"The model is available for this session, but Nexus could not securely save the selection.\" };\n       }\n     }\ndiff --git a/cli/src/sidecar.ts b/cli/src/sidecar.ts\nindex 5257b4f..93d9301 100644\n--- a/cli/src/sidecar.ts\n+++ b/cli/src/sidecar.ts\n@@ -59,9 +59,9 @@ import {\n } from \"./protocol.js\";\n import { SlashHost, SlashOutcome, SlashSpec, errorText, findSlash, slashCatalog } from \"./slash/catalog.js\";\n import { routeSlash } from \"./slash/router.js\";\n import { buildCatalog } from \"./model_catalog.js\";\n-import { cancelLocalEndpointSetup, connectWithKey, disconnect, prepareLocalEndpoint, selectModel, startSignIn } from \"./provider_connect.js\";\n+import { cancelLocalEndpointSetup, clearLocalEndpointSetup, clearLocalEndpointSetupAfterSelectionFailure, connectWithKey, disconnect, prepareLocalEndpoint, selectModel, startSignIn } from \"./provider_connect.js\";\n \n export interface SidecarOptions {\n   app: ApplicationCore;\n   /** Receives complete protocol lines (each ends with \"\\n\"). */\n@@ -216,8 +216,11 @@ export class SidecarServer {\n         this.signIns.get(command.id)?.cancel();\n         this.signIns.delete(command.id);\n         cancelLocalEndpointSetup(command.id);\n         return;\n+      case \"provider.local-cancel\":\n+        clearLocalEndpointSetup(command.id);\n+        return;\n       case \"provider.disconnect\": {\n         if (this.app.getAgent().getApprovalMode() === \"read-only\") {\n           this.emit({ type: \"provider.result\", id: command.id, provider: command.provider, success: false, message: \"Provider changes are disabled while the session is in read-only mode.\" });\n           return;\n@@ -247,9 +250,9 @@ export class SidecarServer {\n   /** Switching models between turns is the operator's choice; during a turn it is refused like any command. */\n   private modelSelect(id: string, provider: string, model: string): void {\n     if (this.rejectBusy(id)) return;\n     const r = selectModel(this.app.getAgent(), this.app.getConfig(), { provider, model });\n-    if (!r.ok && provider === \"appliance\") cancelLocalEndpointSetup();\n+    if (!r.ok && provider === \"appliance\") clearLocalEndpointSetupAfterSelectionFailure();\n     this.emit({ type: \"model.result\", id, success: r.ok, message: r.message });\n     if (r.ok) this.emitSessionState();\n   }\n \ndiff --git a/cli/test/protocol.test.ts b/cli/test/protocol.test.ts\nindex bf85fcc..ec055c3 100644\n--- a/cli/test/protocol.test.ts\n+++ b/cli/test/protocol.test.ts\n@@ -38,8 +38,9 @@ describe(\"protocol: parseCommand\", () => {\n     assert.deepEqual(parseCommand('{\"v\":1,\"type\":\"slash\",\"id\":\"s1\",\"command\":\"status\"}'), { type: \"slash\", id: \"s1\", command: \"status\", args: \"\" });\n     assert.deepEqual(parseCommand('{\"v\":1,\"type\":\"shutdown\"}'), { type: \"shutdown\" });\n     assert.deepEqual(parseCommand('{\"v\":1,\"type\":\"tool.detail\",\"id\":\"d1\",\"evidence\":\"e3\"}'), { type: \"tool.detail\", id: \"d1\", evidence: \"e3\" });\n     assert.deepEqual(parseCommand('{\"v\":1,\"type\":\"receipt\",\"id\":\"r1\"}'), { type: \"receipt\", id: \"r1\" });\n+    assert.deepEqual(parseCommand('{\"v\":1,\"type\":\"provider.local-cancel\",\"id\":\"connect-1\"}'), { type: \"provider.local-cancel\", id: \"connect-1\" });\n   });\n \n   test(\"tool.detail needs an evidence id and receipt needs a request id\", () => {\n     assert.throws(() => parseCommand('{\"v\":1,\"type\":\"tool.detail\",\"id\":\"d1\"}'), (err: unknown) => err instanceof ProtocolError && err.id === \"d1\" && /requires evidence/.test(err.message));\ndiff --git a/cli/test/provider_connect.test.ts b/cli/test/provider_connect.test.ts\nindex d56712f..104727e 100644\n--- a/cli/test/provider_connect.test.ts\n+++ b/cli/test/provider_connect.test.ts\n@@ -52,9 +52,9 @@ const responsesDone = (text: string) => [\n   { type: \"response.completed\", response: { id: \"r\", status: \"completed\", output: [{ type: \"message\", content: [{ type: \"output_text\", text }] }], usage: { input_tokens: 3, output_tokens: 1 } } },\n ];\n const chatDone = (text: string) => [{ choices: [{ index: 0, delta: { content: text }, finish_reason: \"stop\" }] }, \"[DONE]\"];\n \n-const ENV = [\"OPENROUTER_API_KEY\", \"OPENAI_API_KEY\", \"ANTHROPIC_API_KEY\", \"NEXUS_PROVIDER\", \"LOCAL_LLM_ENDPOINT\", \"LOCAL_LLM_API_KEY\", \"NEXUS_NO_BROWSER\"];\n+const ENV = [\"OPENROUTER_API_KEY\", \"OPENAI_API_KEY\", \"ANTHROPIC_API_KEY\", \"NEXUS_PROVIDER\", \"LOCAL_LLM_ENDPOINT\", \"LOCAL_LLM_MODEL\", \"LOCAL_LLM_API_KEY\", \"NEXUS_NO_BROWSER\"];\n let home: string;\n let saved: Record<string, string | undefined>;\n beforeEach(() => {\n   resetApplianceEndpointOverride();\n@@ -596,8 +596,53 @@ describe(\"connecting from the picker\", () => {\n       await prior.close();\n     }\n   });\n \n+  test(\"sidecar: unrelated provider cancellation preserves setup and explicit local-picker clear removes it\", async () => {\n+    const previous = await mock((_s, res) => json(res, 200, { data: [{ id: \"previous-model\" }] }));\n+    const pending = await mock((s, res) => json(res, s.headers.authorization === \"Bearer provisional-key\" ? 200 : 401, { data: [{ id: \"provisional-model\" }] }));\n+    const repo = makeRepo();\n+    operator({ LOCAL_LLM_ENDPOINT: `${previous.url}/v1`, LOCAL_LLM_MODEL: \"previous-model\" });\n+    const app = new ApplicationCore({ endpoint: `${previous.url}/v1`, model: \"previous-model\", maxSteps: 3, temperature: 0, workspace: repo, shell: \"bash\" } as any);\n+    const lines: string[] = [];\n+    const server = new SidecarServer({ app, mode: \"auto\", write: (line) => lines.push(line) });\n+    server.start();\n+    const events = () => lines.map((line) => JSON.parse(line));\n+    const send = (message: Record<string, unknown>) => server.handleLine(JSON.stringify({ v: 1, ...message }));\n+    const waitFor = async (predicate: (event: any) => boolean) => {\n+      for (let i = 0; i < 200; i++) {\n+        const found = events().find(predicate);\n+        if (found) return found;\n+        await new Promise((resolve) => setTimeout(resolve, 25));\n+      }\n+      assert.fail(\"event not seen\");\n+    };\n+    const listApplianceModels = async (id: string) => {\n+      await send({ type: \"models.list\", id });\n+      const catalog = await waitFor((event) => event.type === \"models.catalog\" && event.id === id);\n+      return catalog.models.filter((entry: any) => entry.provider === \"appliance\").map((entry: any) => entry.id);\n+    };\n+    try {\n+      await send({ type: \"provider.connect\", id: \"local-setup-owner\", provider: \"appliance\", method: \"local-endpoint\", endpoint: `${pending.url}/v1`, key: \"provisional-key\" });\n+      assert.equal((await waitFor((event) => event.type === \"provider.result\" && event.id === \"local-setup-owner\")).success, true);\n+\n+      await send({ type: \"provider.cancel\", id: \"unrelated-request\" });\n+      assert.deepEqual(await listApplianceModels(\"after-unrelated-cancel\"), [\"provisional-model\"], \"an unrelated cancel cannot clear the active setup\");\n+      await send({ type: \"provider.local-cancel\", id: \"wrong-setup-owner\" });\n+      assert.deepEqual(await listApplianceModels(\"after-wrong-local-clear\"), [\"provisional-model\"], \"the explicit clear is also owner-correlated\");\n+\n+      await send({ type: \"provider.local-cancel\", id: \"local-setup-owner\" });\n+      assert.deepEqual(await listApplianceModels(\"after-local-picker-close\"), [\"previous-model\"], \"closing the owning picker restores prior routing\");\n+      assert.ok(previous.seen.length > 0);\n+      assert.ok(pending.seen.every((request) => request.headers.authorization === \"Bearer provisional-key\"));\n+      assert.equal(fs.existsSync(credentialsPath()), false);\n+    } finally {\n+      await server.shutdown();\n+      await previous.close();\n+      await pending.close();\n+    }\n+  });\n+\n   test(\"sidecar: cancelling local endpoint discovery prevents a late response from activating setup\", async () => {\n     const previous = await mock((_s, res) => json(res, 200, { data: [{ id: \"previous-model\" }] }));\n     const delayed = await mock((_s, res) => { setTimeout(() => json(res, 200, { data: [{ id: \"late-model\" }] }), 120); });\n     const repo = makeRepo();\n@@ -717,9 +762,9 @@ describe(\"connecting from the picker\", () => {\n       assert.ok(local.seen.every((request) => request.headers.authorization === \"Bearer pending-secret\"));\n       assert.equal(fs.readFileSync(configFile, \"utf8\"), previous);\n       assert.equal(fs.existsSync(credentialsPath()), false);\n \n-      await send({ type: \"provider.cancel\", id: \"pending-models\" });\n+      await send({ type: \"provider.local-cancel\", id: \"pending-connect\" });\n       await send({ type: \"models.list\", id: \"after-cancel\" });\n       const restored = await waitFor((event) => event.type === \"models.catalog\" && event.id === \"after-cancel\");\n       assert.deepEqual(restored.models.filter((model: any) => model.provider === \"appliance\").map((model: any) => model.id), [\"old-model\"]);\n       assert.ok(oldEndpoint.seen.length >= 1);\n","exit_code":0,"duration":{"secs":0,"nanos":856416430}},"started_at_ms":1793024912212,"completed_at_ms":1793024913069}}
