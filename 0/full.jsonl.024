adonlyMap<string, string>,\n): boolean {\n  if (!hasExecutedTests(testOutput)) return false;\n  const root = path.resolve(workspace);\n  const rel = (file: string) => path.relative(root, path.resolve(root, file)).replace(/\\\\/g, \"/\");\n\n  // An empty change list is not an operator scope. This matters for verification-only\n  // work units: a generic passing suite is regression evidence, not proof of a declared\n  // product deliverable. The operator-declared scope and pre-turn test snapshot are both\n  // required even when the current turn made no edits.\n  if (!baselineTests?.size || !trustedDeliverables?.size) return false;\n  const declaredScope = [...trustedDeliverables].map((file) => rel(file));\n  if (declaredScope.some((file) => !file || file.startsWith(\"../\") || path.isAbsolute(file) || !isSafeWorkspaceFile(root, file))) return false;\n  const declaredScopeSet = new Set(declaredScope);\n  const changedNonTestFiles = changedFiles.filter((file) => !TEST_PATH.test(rel(file)));\n  // A runtime graph cannot distinguish product code from dual-use oracle code.\n  // Require a pre-turn operator declaration and reject any changed product path\n  // outside that immutable task scope.\n  const changedTargets = changedNonTestFiles.map((file) => rel(file));\n  if (changedTargets.some((file) => !declaredScopeSet.has(file) || !isSafeWorkspaceFile(root, file))) return false;\n  const tokens = extractPathTokens(root, `${verifierCommand}\\n${testOutput}`);\n  const isFiltered = isFilteredVerifierCommand(verifierCommand);\n\n  const testFileExecuted = (testFileRel: string) => {\n    // An unfiltered verifier run that executed tests ran the repository test suite\n    if (!isFiltered) return true;\n    return tokens.has(testFileRel) || verifierCommand.includes(testFileRel);\n  };\n\n  // Verifier output is candidate-influenced. Bind every operator-declared product\n  // file to an actually executed, pre-existing test import instead of path text.\n  return declaredScope.every((file) => [...baselineTests].some(([testRel, content]) =>\n    (!isFiltered || testFileExecuted(testRel)) &&\n    Boolean(content) && testReferencesFile(content, testRel, rel(file), root),\n  ));\n}\n\n/** Resolve package-declared runtime entry points to the files that actually implement them. */\nexport function workspaceRuntimeFiles(root: string): Set<string> {\n  const workspace = path.resolve(root);\n  const manifests: string[] = [];\n  const walk = (directory: string, depth: number) => {\n    if (depth > 5 || manifests.length >= 128) return;\n    let entries: fs.Dirent[];\n    try { entries = fs.readdirSync(directory, { withFileTypes: true }); } catch { return; }\n    for (const entry of entries) {\n      if (entry.name === \"node_modules\" || entry.name === \".git\" || entry.name === \"dist\" || entry.name === \"build\") continue;\n      const full = path.join(directory, entry.name);\n      if (entry.isDirectory()) walk(full, depth + 1);\n      else if (entry.name === \"package.json\") manifests.push(full);\n    }\n  };\n  walk(workspace, 0);\n\n  const product = new Set<string>();\n  const sourceExtensions = [\".js\", \".cjs\", \".mjs\", \".ts\", \".tsx\", \".jsx\"];\n  const resolveModule = (base: string): string | null => {\n    const sourceAliases = /\\.(?:c|m)?js$/.test(base)\n      ? [base.replace(/\\.(?:c|m)?js$/, \".ts\"), base.replace(/\\.(?:c|m)?js$/, \".tsx\")]\n      : [];\n  } else if (approve) {\n    approvalMode = \"review\";\n  } else if (modeOption === \"auto\" || modeOption === \"review\" || modeOption === \"read-only\") {\n    approvalMode = modeOption as ApprovalMode;\n    if (approvalMode === \"auto\" && options.yes) fullAccess = true;\n  } else if (envMode === \"auto\" || envMode === \"review\" || envMode === \"read-only\") {\n    approvalMode = envMode as ApprovalMode;\n    if (approvalMode === \"auto\") fullAccess = true;\n  } else {\n    // Folder trust controls project instructions and integrations, not tool authority.\n    // Use an explicit full-access setting when present; otherwise default to review.\n    approvalMode = fullAccess ? \"auto\" : \"review\";\n  }\n\n  const sandbox = options.sandbox ? (typeof options.sandbox === \"string\" ? options.sandbox : true) : undefined;\n  if (provider && options.fallback) warnOnce(`--fallback is ignored for provider '${provider}': a provider connection is pinned to its own endpoint.`);\n  const fallbackEndpoints = options.fallback && !provider ? options.fallback.split(\",\").map((s: string) => s.trim()) : undefined;\n  const contextLimit = options.contextLimit ? parseInt(options.contextLimit, 10) : (effectiveSetting(\"NEXUS_CONTEXT_LIMIT\") ? parseInt(effectiveSetting(\"NEXUS_CONTEXT_LIMIT\")!, 10) : undefined);\n  const strictTokenCount = Boolean(options.strictTokenCount) || effectiveSetting(\"NEXUS_STRICT_TOKEN_COUNT\") === \"1\";\n  const worktree = Boolean(options.worktree);\n  const authoritativeVerifierCommand = options.authoritativeVerifier;\n  const trustedDeliverableFiles = normalizeTrustedDeliverableFiles(workspace, options.deliverableFile);\n  const recordFlight = Boolean(options.recordFlight || options.flight);\n  const plannerProvider = selectProvider(options.plannerProvider, \"PLANNER_LLM_PROVIDER\");\n  const coderProvider = selectProvider(options.coderProvider, \"CODER_LLM_PROVIDER\");\n  const plannerModel = options.plannerModel || effectiveSetting(\"PLANNER_LLM_MODEL\");\n  const plannerEndpoint = plannerProvider ? providerBaseUrl(plannerProvider) : options.plannerEndpoint || effectiveSetting(\"PLANNER_LLM_ENDPOINT\");\n  const coderModel = options.coderModel || effectiveSetting(\"CODER_LLM_MODEL\");\n  const coderEndpoint = coderProvider ? providerBaseUrl(coderProvider) : options.coderEndpoint || effectiveSetting(\"CODER_LLM_ENDPOINT\");\n  if (plannerProvider && !plannerModel) throw new Error(`Planner provider '${plannerProvider}' needs an explicit model: pass --planner-model or set PLANNER_LLM_MODEL.`);\n  if (coderProvider && !coderModel) throw new Error(`Coder provider '${coderProvider}' needs an explicit model: pass --coder-model or set CODER_LLM_MODEL.`);\n  const plannerApiKey = REDACTED ? providerKey(plannerProvider) : undefined;\n  const coderApiKey = REDACTED ? providerKey(coderProvider) : undefined;\n\n  // Disclosure authority: destinations the operator selected (flags, operator environment, config.env) plus origins\n  // listed in NEXUS_CLOUD_DISCLOSURE_ORIGINS. An endpoint chosen only by a project .env, and any fallback endpoint,\n  // is not authorized to receive task content when it is a cloud destination.\n  const authorized = new Set(parseOriginList(operatorSetting(\"NEXUS_CLOUD_DISCLOSURE_ORIGINS\")));\n  const authorize = (url: string | undefined) => {\n    const o = originOf(url);\n    if (o) authorized.add(o);\n  };\n  if (provider || options.endpoint || operatorChose(\"LOCAL_LLM_ENDPOINT\")) authorize(endpoint);\n  if (plannerProvider || options.plannerEndpoint || operatorChose(\"PLANNER_LLM_ENDPOINT\")) authorize(plannerEndpoint);\n  if (coderProvider || options.coderEndpoint || operatorChose(\"CODER_LLM_ENDPOINT\")) authorize(coderEndpoint);\n  const cloudRoutedOrigins = parseOriginList(operatorSetting(\"NEXUS_CLOUD_ROUTED_ORIGINS\"));\n  const reasoningEffort = effectiveSetting(\"NEXUS_REASONING_EFFORT\")?.trim() || undefined;\n  const thinkingRaw = Number(process.env.NEXUS_ANTHROPIC_THINKING_BUDGET);\n  const anthropicThinkingBudget = Number.isFinite(thinkingRaw) && thinkingRaw >= 1024 ? Math.floor(thinkingRaw) : undefined;\n  const tdd = Boolean(options.tdd);\n  const verifierTimeoutRaw = Number(effectiveSetting(\"NEXUS_VERIFIER_TIMEOUT_SECS\"));\n  const verifierTimeoutSecs = Number.isFinite(verifierTimeoutRaw) && verifierTimeoutRaw > 0 ? verifierTimeoutRaw : undefined;\n  const taskClass = effectiveSetting(\"NEXUS_TASK_CLASS\") || effectiveSetting(\"LOCAL_LLM_TASK_CLASS\") || undefined;\n  const plannerTaskClass = effectiveSetting(\"PLANNER_TASK_CLASS\") || undefined;\n  return {\n    taskClass,\n    plannerTaskClass,\n    endpoint,\n    model,\n    apiKey,\n    ...(credentialOrigin ? { credentialOrigin } : {}),\n    workspace,\n    maxSteps,\n    ...(continuation ? { continuation } : {}),\n    temperature,\n    shell,\n    dryRun,\n    readOnly,\n    approvalMode,\n    yes,\n    fullAccess,\n    sandbox,\n    fallbackEndpoints,\n    contextLimit,\n    ...(strictTokenCount ? { strictTokenCount } : {}),\n    worktree,\n    authoritativeVerifierCommand,\n    trustedDeliverableFiles,\n    verifierTimeoutSecs,\n    recordFlight,\n    plannerModel,\n    plannerEndpoint,\n    coderModel,\n    coderEndpoint,\n    tdd,\n    ...(provider ? { provider } : {}),\n            hasExecuted = hasExecutedTests(testRes.rawOutput || \"\");\n            const baselineTests = this.changeBaseline?.tests;\n            const baselineTestsChanged = !baselineTests || testsChangedSince(this.config.workspace, baselineTests);\n            // A generic current-invocation verifier cannot authenticate recovered scope or its\n            // candidate-controlled tests. Only a verifier definition and test snapshot captured\n            // before the current task's edits can bind workspace changes.\n            const configuredTestsStable = source !== \"configured\" || !baselineTestsChanged;\n            isDeliverableBound = (!this.verificationBaselineInvalidated && hasExecuted && configuredTestsStable && isVerifierDeliverableBound(\n              this.config.workspace,\n              Array.from(this.modifiedFiles),\n              verifierCommand,\n              testRes.rawOutput || \"\",\n              this.changeBaseline?.trustedDeliverables?.length\n                ? trustedDeliverablesFromBaseline(this.changeBaseline)\n                : new Set(this.config.trustedDeliverableFiles ?? []),\n              baselineTests ?? undefined,\n            ));\n            // A discovered verifier's pass makes the change VERIFIED only on independent evidence (fail-before /\n            // pass-after on tests the change did not write); the operator's configured verifier is their own check.\n            const independence = source === \"discovered\" && testRes.success && isDeliverableBound ? await this.judgeIndependence(verifierCommand, deadlineSecs, onConfirm) : undefined;\n            const evidence: VerificationEvidence = {\n              status: testRes.success ? \"PASSED\" : testRes.timedOut ? \"TIMED_OUT\" : \"FAILED\",\n              command: verifierCommand,\n              source,\n              exitSuccess: testRes.success,\n","exit_code":0,"duration":{"secs":0,"nanos":26817}},"started_at_ms":1793068416980,"completed_at_ms":1793068416980}}
