":"mcp-agent-mail","tool_name":"create_agent_identity"},{"connector_id":"connector_76869538009648d5b282a4bb21c3d157","first_turn_id":"01a16f03-b5c2-7ab2-ba06-07db849a401d","server_name":"codex_apps","tool_name":"github.search_issues"},{"first_turn_id":"01a177a5-7619-7f61-94e2-64d374be9e23","plugin_id":"claude-mem@claude-mem-local","server_name":"mcp-search","tool_name":"observation_search"}],"status":"complete"},"retained_source":{"complete":true,"id":{"message_id":"msg_01a1794f-4e1a-76d1-a25d-53dc42bae63f","role":"user","turn_id":"01a178fa-f0ed-7ab3-bb71-477460bd1a0a"},"revision":"retained_01a1794f-4e1a-76d1-a25d-53f78e533857"},"user_input_order":19463},{"client_authored":false,"compaction_model_hash":"3000","mcp_attribution":{"sources":[{"first_turn_id":"01a14cbb-b14a-7783-b5cf-c72089b0073b","server_name":"mcp-agent-mail","tool_name":"register_agent"},{"first_turn_id":"01a14cbb-b14a-7783-b5cf-c72089b0073b","server_name":"mcp-agent-mail","tool_name":"send_message"},{"first_turn_id":"01a14cd4-59f8-7720-a95a-13c578c1cd28","server_name":"mcp-agent-mail","tool_name":"request_contact"},{"first_turn_id":"01a14cd4-59f8-7720-a95a-13c578c1cd28","server_name":"mcp-agent-mail","tool_name":"fetch_inbox"},{"first_turn_id":"01a14cd4-59f8-7720-a95a-13c578c1cd28","server_name":"mcp-agent-mail","tool_name":"list_contacts"},{"first_turn_id":"01a14e58-1753-7d33-ae87-c1f74cb2b16e","server_name":"mcp-agent-mail","tool_name":"whois"},{"first_turn_id":"01a14e58-1753-7d33-ae87-c1f74cb2b16e","server_name":"mcp-agent-mail","tool_name":"list_window_identities"},{"connector_id":"connector_76869538009648d5b282a4bb21c3d157","first_turn_id":"01a14f64-82d3-76b3-b070-a092decace04","server_name":"codex_apps","tool_name":"github.fetch_workflow_run_jobs"},{"connector_id":"connector_76869538009648d5b282a4bb21c3d157","first_turn_id":"01a14f64-82d3-76b3-b070-a092decace04","server_name":"codex_apps","tool_name":"github.create_pull_request"},{"connector_id":"connector_76869538009648d5b282a4bb21c3d157","fi