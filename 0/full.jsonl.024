om the version under test, whatever it is, so the upgrade path is always exercised.\nscripts/installer-smoke.sh:31:UPGRADE_VERSION=\"$VERSION-upgrade-smoke\"\nscripts/installer-smoke.sh:32:mkdir -p \"$TMP/release/download/$UPGRADE_VERSION\" \"$TMP/upgrade-unpack\"\nscripts/installer-smoke.sh:33:tar -xzf \"$ARCHIVE\" -C \"$TMP/upgrade-unpack\"\nscripts/installer-smoke.sh:34:printf '%s\\n' \"$UPGRADE_VERSION\" > \"$TMP/upgrade-unpack/nexus/VERSION\"\nscripts/installer-smoke.sh:36:tar -C \"$TMP/upgrade-unpack\" -czf \"$TMP/release/download/$UPGRADE_VERSION/$UPGRADE_ARCHIVE\" nexus\ncli/test/system_journey.test.ts:170:      \"feat: upgrade without receipt\",\ncli/test/system_journey.test.ts:181:      \"feat: upgrade status to 2.0.0\",\ncli/test/state.test.ts:502:  test(\"SessionManager migration: Legacy session files transparently upgrade to DurableTaskState\", () => {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a178d5-a588-7873-8790-fb703eb53a02","create_time":1793030326.95591}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
