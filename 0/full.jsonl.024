\n    return false;\n  }\n\n  if (hostname === \"github.com\") {\n    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n  }\n\n  if (hostname === \"objects.githubusercontent.com\") {\n    return true;\n  }\n\n  return false;\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\n  if (signal) {\n    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n  }\n\n  try {\n    while (hops <= maxHops) {\n      if (!validateDownloadUrl(currentUrl)) {\n        throw new Error(`Disallowed download origin or invalid URL: ${currentUrl}`);\n      }\n\n      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n        headers.Authorization = `Bearer ${token}`;\n      }\n\n      const res = await fetch(currentUrl, {\n\n--- RC8 ---\n\n  // Localhost allowed for local mock testing\n  if (hostname === \"127.0.0.1\" || hostname === \"localhost\") {\n    return parsed.protocol === \"http:\" || parsed.protocol === \"https:\";\n  }\n\n  // GitHub allowed domains - must be HTTPS\n  if (parsed.protocol !== \"https:\") {\n    return false;\n  }\n\n  if (hostname === \"github.com\") {\n    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n  }\n\n  if (hostname === \"objects.githubusercontent.com\") {\n    return true;\n  }\n\n  // GitHub now redirects release downloads to its signed release-assets host.\n  // Restrict the path to release objects; never allow this host as a generic CDN.\n  if (hostname === \"release-assets.githubusercontent.com\") {\n    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n  }\n\n  return false;\n}\n\n/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\nfunction safeDownloadOrigin(urlString: string): string {\n  try {\n    return new URL(urlString).origin;\n  } catch {\n    return \"invalid URL\";\n  }\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n\n--- current change history ---\nafec611 fix(upgrade): retry reset downloads once\n64c22d3 fix: handle signed release download redirects\nc0093d1 fix(release): verify provenance when possible by default\n0831608 fix(upgrade): inject trusted gh paths and pin the fail-closed branch\ne2ee17f fix(upgrade): fail closed when required attestation has no trusted gh\n49273d6 fix(runtime): raise the supported Node.js floor to 22\n085e041 fix(runtime): raise the supported Node.js floor to 22\n22424c1 fix(state): make backup restore crash recoverable\n26d55d0 fix(state): make backup restore crash recoverable\n714fa79 fix(upgrade): serialize stale-lock reclamation with a permanent flock guard\n51d92d1 fix(upgrade): recover reclaim gates left by crashed reclaimers\n5e6d1f4 fix(upgrade): serialize stale-lock reclamation with O_EXCL gate and verify inode/token on unlock\n6eb2eaf fix(upgrade): skip lock on completed journal at startup and align acceptance fixtures\ne53f311 fix(upgrade): serialize recovery and reject malformed transaction locks\n8f3c3c9 fix(upgrade): bind release metadata and legacy runtime identities\n7a34e85 fix(upgrade): preserve durable rollback packages and verify recovery truthfully\nc74fd3e fix(upgrade): live performUpgrade rollback, non-destructive reinstall, and acceptance remediation\nd7b675a fix(release): bind compatibility metadata and install provenance\nff7aa88 feat(upgrade): implement compatibility metadata, extraction safety, backups, and recovery (PLAN-12_PR-12b)\ne352615 feat(upgrade): implement in-place CLI and TUI upgrade engine (REQ-REL-115, PLAN-12)\n","exit_code":0,"duration":{"secs":1,"nanos":281629980}},"started_at_ms":1793030375779,"completed_at_ms":1793030377061}}
