{"timestamp":"2026-10-26T18:38:07.019Z","ordinal":397021,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a178fa-f0ed-7ab3-bb71-477460bd1a0a","item":{"type":"CommandExecution","id":"exec-03789c11-6348-4ac3-a169-f240ad8b8b97","process_id":"10051","command":["/usr/bin/zsh","-lc","sed -n '1,180p' install.sh; sed -n '1280,1315p' cli/src/upgrade.ts; sed -n '1680,1715p' cli/src/upgrade.ts; sed -n '1,70p' docs/v1.0.0/ACCEPTANCE.md"],"cwd":"file:///home/mike/nexus-wt/readiness-rc8-install-terminal-20261026","parsed_cmd":[{"type":"read","cmd":"sed -n '1,180p' install.sh","name":"install.sh","path":"install.sh"},{"type":"read","cmd":"sed -n '1280,1315p' cli/src/upgrade.ts","name":"upgrade.ts","path":"cli/src/upgrade.ts"},{"type":"read","cmd":"sed -n '1680,1715p' cli/src/upgrade.ts","name":"upgrade.ts","path":"cli/src/upgrade.ts"},{"type":"read","cmd":"sed -n '1,70p' docs/v1.0.0/ACCEPTANCE.md","name":"ACCEPTANCE.md","path":"docs/v1.0.0/ACCEPTANCE.md"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"#!/bin/sh\nset -eu\n\nREPO=mikeholownych/nexus-code\nBASE=${NEXUS_RELEASE_BASE_URL:-\"https://github.com/$REPO/releases\"}\nVERSION=${NEXUS_VERSION:-latest}\nPREFIX=${NEXUS_PREFIX:-\"$HOME/.local\"}\n\nfail() { printf 'nexus installer: %s\\n' \"$*\" >&2; exit 1; }\ncase \"$(uname -s):$(uname -m)\" in\n  Linux:x86_64|Linux:amd64) ;;\n  *) fail \"unsupported system $(uname -s)/$(uname -m); supported: Linux x86-64 (glibc).\" ;;\nesac\ncommand -v node >/dev/null 2>&1 || fail \"Node.js 22 or newer is required; install Node.js and retry.\"\nNODE_MAJOR=$(node -p 'Number(process.versions.node.split(\".\")[0])' 2>/dev/null || printf 0)\n[ \"$NODE_MAJOR\" -ge 22 ] || fail \"Node.js 22 or newer is required (found $(node --version 2>/dev/null || echo unknown)).\"\ncommand -v curl >/dev/null 2>&1 || fail \"curl is required.\"\ncommand -v tar >/dev/null 2>&1 || fail \"tar is required.\"\ncommand -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n\nVERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION-auto}\ncase \"$VERIFY_ATTESTATION\" in\n  auto|0|1) ;;\n  *) fail \"NEXUS_VERIFY_ATTESTATION must be auto (verify when a trusted GitHub CLI is present), 1 (require verification) or 0 (skip verification).\" ;;\nesac\nTRUSTED_GH=\nif [ -x /usr/bin/gh ]; then\n  TRUSTED_GH=/usr/bin/gh\nelif [ -x /usr/local/bin/gh ]; then\n  TRUSTED_GH=/usr/local/bin/gh\nfi\nif [ \"$VERIFY_ATTESTATION\" = \"1\" ] && [ -z \"$TRUSTED_GH\" ]; then\n  fail \"provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\"\nfi\n\nvalidate_tag() {\n  printf '%s' \"$1\" | grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\"\n}\n\nif [ \"$VERSION\" != \"latest\" ]; then\n  validate_tag \"$VERSION\"\nfi\n\nif [ \"$VERSION\" = \"latest\" ]; then\n  API_BASE=${NEXUS_RELEASES_API:-\"https://api.github.com/repos/$REPO/releases\"}\n  API_TMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-api.XXXXXX\") || fail \"could not create temporary directory.\"\n  api_cleanup() { rm -rf \"$API_TMP\"; }\n  trap api_cleanup EXIT HUP INT TERM\n\n  LATEST_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -D \"$API_TMP/headers\" -o \"$API_TMP/latest.json\" -w \"%{http_code}\" \"$API_BASE/latest\" 2>\"$API_TMP/curl.err\" || echo \"000\")\n\n  if [ \"$LATEST_CODE\" = \"200\" ]; then\n    VERSION=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/latest.json\" | head -n 1)\n    [ -n \"$VERSION\" ] || fail \"GitHub returned no stable release tag.\"\n    validate_tag \"$VERSION\"\n  elif [ \"$LATEST_CODE\" = \"403\" ]; then\n    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \"$API_TMP/headers\" 2>/dev/null; then\n      fail \"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\"\n    fi\n    fail \"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\"\n  elif [ \"$LATEST_CODE\" = \"404\" ]; then\n    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \"$API_TMP/releases.json\" -w \"%{http_code}\" \"$API_BASE?per_page=1\" 2>/dev/null || echo \"000\")\n    if [ \"$PREREL_CODE\" = \"200\" ]; then\n      PREREL_TAG=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/releases.json\" | head -n 1)\n      if [ -n \"$PREREL_TAG\" ]; then\n        fail \"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\"\n      fi\n    fi\n    fail \"could not find latest stable release (HTTP 404 from $API_BASE/latest).\"\n  else\n    fail \"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\"\n  fi\n  rm -rf \"$API_TMP\"\n  trap - EXIT HUP INT TERM\nfi\n\nARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\nNORMALIZED_VERSION=${VERSION#v}\nURL=\"$BASE/download/$VERSION\"\nTMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-install.XXXXXX\") || fail \"could not create temporary directory.\"\ncleanup() { rm -rf \"$TMP\"; }\ntrap cleanup EXIT HUP INT TERM\ncurl -fsSL --show-error --retry 2 \"$URL/$ARCHIVE\" -o \"$TMP/$ARCHIVE\" || fail \"download failed for $ARCHIVE.\"\ncurl -fsSL --show-error --retry 2 \"$URL/SHA256SUMS\" -o \"$TMP/SHA256SUMS\" || fail \"could not download release checksums.\"\ngrep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksum entry for $ARCHIVE is missing.\"\n(cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\nARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n\nif [ \"$VERIFY_ATTESTATION\" != \"0\" ] && [ -n \"$TRUSTED_GH\" ]; then\n  if \"$TRUSTED_GH\" attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n     \"$TRUSTED_GH\" attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n    printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n  elif [ \"$VERIFY_ATTESTATION\" = \"1\" ]; then\n    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n  else\n    printf 'nexus installer: build provenance was not verified: %s could not verify the attestation (it may need gh auth login); the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' \"$TRUSTED_GH\" >&2\n  fi\nelif [ \"$VERIFY_ATTESTATION\" = \"auto\" ]; then\n  printf 'nexus installer: build provenance was not verified: no trusted GitHub CLI at /usr/bin/gh or /usr/local/bin/gh; the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' >&2\nfi\n\nVERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\nBIN_DIR=\"$PREFIX/bin\"\nLINK=\"$BIN_DIR/nexus\"\nmkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\nif [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n  fail \"$LINK exists and is not a symlink; left it unchanged.\"\nfi\nif [ -L \"$LINK\" ]; then\n  OLD=$(readlink \"$LINK\")\n  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\nfi\n\nFORCE=${NEXUS_FORCE:-0}\nNEEDS_EXTRACT=1\nif [ -d \"$VERSION_DIR\" ] && [ \"$FORCE\" != \"1\" ]; then\n  if [ -x \"$VERSION_DIR/bin/nexus\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/harness-core\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/nexus-tui\" ] && \\\n     [ \"$(cat \"$VERSION_DIR/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ]; then\n    if [ -f \"$VERSION_DIR/MANIFEST.sha256\" ]; then\n      if (cd \"$VERSION_DIR\" && sha256sum --check --status MANIFEST.sha256 2>/dev/null); then\n        NEEDS_EXTRACT=0\n      fi\n      if [ \"$NEEDS_EXTRACT\" = \"0\" ]; then\n        if ! node - \"$VERSION_DIR/.provenance.json\" \"$ARCHIVE_SHA256\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [file, archiveSha256] = process.argv.slice(2);\ntry {\n  const record = JSON.parse(fs.readFileSync(file, \"utf8\"));\n  if (record.archiveSha256 !== archiveSha256) process.exit(1);\n} catch { process.exit(1); }\nNODE\n        then\n          NEEDS_EXTRACT=1\n        fi\n      fi\n    fi\n  fi\nfi\n\nif [ \"$NEEDS_EXTRACT\" = \"1\" ]; then\n  mkdir -p \"$TMP/unpack\"\n  tar -xzf \"$TMP/$ARCHIVE\" -C \"$TMP/unpack\" || fail \"archive extraction failed.\"\n  PACKAGE=\"$TMP/unpack/nexus\"\n  [ -x \"$PACKAGE/bin/nexus\" ] && [ -x \"$PACKAGE/lib/core/harness-core\" ] && [ -x \"$PACKAGE/lib/core/nexus-tui\" ] && [ \"$(cat \"$PACKAGE/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ] || fail \"release archive is incomplete or has a mismatched version.\"\n  if [ -f \"$PACKAGE/MANIFEST.sha256\" ]; then\n    (cd \"$PACKAGE\" && sha256sum --check --status MANIFEST.sha256) || fail \"release archive failed manifest checksum verification.\"\n  fi\n  PACKAGE_VERSION_OUTPUT=$(\"$PACKAGE/bin/nexus\" --version 2>&1) || fail \"release binary failed its pre-install self-test.\"\n  PACKAGE_VERSION_REPORTED=$(printf '%s\\n' \"$PACKAGE_VERSION_OUTPUT\" | sed -n '1s/[[:space:]].*$//p')\n  [ \"$PACKAGE_VERSION_REPORTED\" = \"$NORMALIZED_VERSION\" ] || fail \"release binary reported version '$PACKAGE_VERSION_REPORTED' instead of '$NORMALIZED_VERSION' during self-test.\"\n  if [ -f \"$PACKAGE/compatibility.json\" ]; then\n    node - \"$PACKAGE/compatibility.json\" \"$VERSION\" \"$ARCHIVE\" <<'NODE' || fail \"release compatibility metadata is invalid or mismatched.\"\nconst fs = require(\"node:fs\");\nconst [file, version, archive] = process.argv.slice(2);\nconst data = JSON.parse(fs.readFileSync(file, \"utf8\"));\nconst asset = data.platforms?.[\"linux-x86_64\"];\nconst compatible = data.schemaVersion === 1 && data.product === \"nexus-code\" &&\n  data.version === version.replace(/^v/, \"\") &&\n  typeof data.revision === \"string\" && /^[a-f0-9]{7,64}$/i.test(data.revision) &&\n  typeof data.builtAt === \"string\" && !Number.isNaN(Date.parse(data.builtAt)) &&\n  asset?.archive === archive && asset.os === \"linux\" && asset.arch === \"x86_64\" &&\n  data.compatibility && Number.isSafeInteger(data.compatibility.configSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.stateSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedConfigVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedStateVersion) &&\n  data.compatibility.minSupportedConfigVersion <= data.compatibility.configSchemaVersion &&\n  data.compatibility.minSupportedStateVersion <= data.compatibility.stateSchemaVersion;\nif (!compatible) process.exit(1);\nNODE\n  fi\n  rm -rf \"$VERSION_DIR\"\n  mv \"$PACKAGE\" \"$VERSION_DIR\"\nfi\nnode - \"$VERSION_DIR/compatibility.json\" \"$VERSION\" \"$PREFIX\" \"$VERSION_DIR\" \"$LINK\" \"$ARCHIVE\" \"$ARCHIVE_SHA256\" \"$VERSION_DIR/.provenance.json\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [metadataPath, version, prefix, installedPath, binPath, archive, archiveSha256, output] = process.argv.slice(2);\nlet metadata = null;\ntry { metadata = JSON.parse(fs.readFileSync(metadataPath, \"utf8\")); } catch {}\n\n    journalEntry.state = \"switched\";\n    journalEntry.updatedAt = new Date().toISOString();\n    writeJournal(prefix, journalEntry);\n\n    // 7. Post-installation verification phase\n    options?.onProgress?.(\"verifying_install\", \"Verifying installed product...\");\n    const verifyRun = verifyInstalledRuntime(versionDir, targetVersion, options?.timeoutMs);\n    if (!verifyRun.healthy) throw new Error(`Installed binary failed self-test: ${verifyRun.error}`);\n\n    // Retain the old same-version package after success for --rollback-binary.\n    journalEntry.state = \"verified\";\n    journalEntry.updatedAt = new Date().toISOString();\n    writeJournal(prefix, journalEntry);\n\n    // Check for PATH shadowing\n    const shadowing = detectPathShadowing(binDir);\n    let pathWarning: string | undefined;\n    if (shadowing.shadowed) {\n      pathWarning = `Warning: Installed launcher at ${linkPath} is shadowed by '${shadowing.precedingPaths[0]}' earlier in PATH. Run 'hash -r' or adjust PATH order.`;\n      options?.onProgress?.(\"path_shadow_warning\", pathWarning);\n    }\n\n    // 8. Complete journal\n    journalEntry.state = \"complete\";\n    journalEntry.updatedAt = new Date().toISOString();\n    writeJournal(prefix, journalEntry);\n\n    return {\n      success: true,\n      previousVersion: installed.version,\n      newVersion: targetVersion,\n      installedPath: versionDir,\n      binPath: linkPath,\n      restartRequired: true,\n      restartNotice: `Nexus has been upgraded to ${targetVersion} in ${versionDir}. The current session continues running on ${installed.version}. Restart Nexus to activate the new version.${provenanceWarning ? `\\n\\n${provenanceWarning}` : \"\"}${pathWarning ? `\\n\\n${pathWarning}` : \"\"}`,\n        JSON.stringify(\n          {\n            schemaVersion: 1,\n            tool: \"nexus upgrade\",\n            status: \"error\",\n            error: err.message || String(err),\n          },\n          null,\n          2\n        )\n      );\n    } else {\n      console.error(`nexus upgrade failed: ${err.message || String(err)}`);\n    }\n    process.exit(UPGRADE_EXIT.error);\n  }\n}\n# Nexus Code v1.0.0: release qualification procedure\n\nThis is the procedure that decides whether a release candidate (RC) may become v1.0.0. It defines:\n\n- the environments;\n- the workflow matrix;\n- the evidence each step must produce;\n- explicit pass/fail gates.\n\nThree separate questions are judged and recorded separately:\n\n| Question | Who answers it |\n|---|---|\n| **Implementation self-assessment** | Did the implementer's tests pass? |\n| **Product qualification** | Did the RC meet these gates on real workflows? |\n| **Independent acceptance** | Did a reviewer other than the implementer agree? |\n\nA gate passes only on archived evidence bound to the source commit or installed RC artifact that the gate evaluates. Source-level evidence names the exact source commit; installed-RC evidence names both that commit and the installed package digest. A green test suite alone never qualifies the product.\n\n## 1.1 Release-candidate lifecycle and evidence identity\n\nThe release sequence has five distinct stages. Passing an earlier stage is a prerequisite for the next stage, not a substitute for it. Every G0–G4 acceptance ID remains mandatory; the stage determines which exact input and evidence it evaluates, not whether the check applies.\n\n1. **Pre-RC source gates.** Before creating an RC tag, run required source CI and every G0–G4 check whose acceptance method evaluates source, a source-built test binary, or an environment without requiring a published RC. Record the full commit ID and check results. Source checks do not establish behavior of the installed package.\n2. **RC artifact construction.** After the required owner authorization, create the version-matched RC tag on that exact source commit and use the repository release workflow to build and publish the RC artifacts. Record the workflow run, tag commit, artifact digests, and provenance. The workflow-produced artifacts are the candidates for qualification; a local build or a different commit is not interchangeable. RC artifact publication is not product qualification or final release acceptance.\n3. **RC artifact gates.** Before installed-RC product qualification, run every G0–G4 check whose acceptance method requires the RC archive, RC attestation/release, or workflow-produced artifact. This includes ACC-SUP-01/02/03/06/08. ACC-PKG checks that explicitly require an installed package run against this RC as specified by their test method. Record the RC tag commit, workflow run, artifact digests, and each check result. A source-level analogue does not replace an artifact-bound check.\n4. **Installed-RC qualification.** Install the workflow-produced RC package using the documented procedure and run the applicable product, provider, task-quality, terminal, installation, and independent-acceptance gates in §§4–8. Bind each result to both the RC source commit and installed package digest. If a source change or rebuilt artifact changes either identity, rerun every affected gate against the new candidate and retain prior results as historical evidence.\n5. **Stable promotion and publication.** After exact-RC acceptance and G6 pass, create a stable-version commit directly on the accepted RC commit, changing only the synchronized version metadata required for v1.0.0. Record both commits and the version-only diff. Run required source CI and all applicable source G0–G4 checks on this exact stable-version commit before tagging. If any other source changes, restart RC construction and qualification. Then create the `v1.0.0` tag on that checked commit and build a draft release. Keep its assets unpublished while verifying the stable artifact identity, provenance, package contents, installation, and publication metadata. Compare the stable package contents with the accepted RC; if packaged behavior or content differs beyond version-specific metadata, rerun affected installed-RC qualification gates and obtain independent acceptance for the stable artifact. Publish the draft only after these checks pass and the signed acceptance disposition is recorded. Record the published digests and provenance.\n\nThe final G6 decision in §10 applies to promoting the accepted RC toward a stable release. It requires the applicable gates to pass for the accepted RC and authorizes the version-only stable commit and its source checks, followed by the stable tag and draft build; it does not waive source CI, artifact identity, installed-RC qualification, or any threshold. Public publication is a separate post-build gate in stage 5 above. The release workflow must keep stable assets in draft state until stable artifact checks pass. Source verification at integration 6a16cb6 confirms the tag-triggered release workflow now supports published RC prereleases and draft stable releases. The earlier immediate-stable-publication source blocker is resolved; an actual stable draft build, artifact verification, signed acceptance, and deliberate publication are still required and remain unproven until their run evidence is recorded.\n\nExact-RC requirements records identify at least one implementer and an independent reviewer. For a blocking requirement recorded as `tested` instead of `product-qualified`, the cited decision must be explicitly allowlisted for that requirement in the approved qualification-exceptions table below, and its `DECISIONS.md` section must contain a matching requirement-specific line of the form `Qualification applicability: REQ-... = NOT REQUIRED ...`. A record-supplied or unrelated decision cannot authorize an exception. The record must include digest-bound evidence for every `ACC-*` criterion in that requirement's ledger Acceptance column.\n\nThe post-RC closure requirements listed below may remain `open`, `partial`, or `implemented` in the source ledger at the RC commit because their remaining acceptance is completed during G6 or installed-RC qualification. The bare `--enforce` invocation is the pre-RC source gate: it checks every other B/RR row against the source threshold and reports mapped rows as deferred, not accepted. At G6, the exact-RC invocation must provide a record meeting the normal B/RR status threshold and digest-bound evidence for every criterion in this table. The table also supplies the criterion mapping for rows whose ledger points to an ACCEPTANCE section instead of naming ACC IDs. The source ledger is never rewritten by the record. Any below-tested required row omitted from this table still fails.\n\n<!-- RC-QUALIFICATION-ONLY:START -->\n### Qualification-only requirements for exact-RC enforcement\n\n| Requirement | Acceptance criteria required in the exact-RC record | Remaining stage |\n|---|---|---|\n| REQ-REL-003 | ACC-PLAT | Installed-RC platform and Node-version matrix |\n| REQ-AGT-002 | ACC-VER-03, ACC-VER-04, ACC-VER-09, ACC-QUAL-T2, ACC-QUAL-T3, ACC-QUAL-T4 | Installed-RC T2/T3/T4 outcome thresholds |\n| REQ-AGT-010 | ACC-TRUST-04 | Independent acceptance of the DEC-04 v1 subset |\n| REQ-PRV-003 | ACC-INF-10 | Installed-RC standalone and absent-gateway behavior |\n| REQ-REL-005 | ACC-SUP-04, ACC-SUP-05 | Exact-RC security and dependency artifact checks |\n| REQ-AGT-110 | ACC-CONT-10, ACC-GOV-06 | Installed-RC continuity and independent acceptance |\n| REQ-PRV-111 | ACC-PRV-LIVE | Installed-RC provider verification |\n| REQ-REL-114 | ACC-SUP-08 | Exact-RC cross-runner reproducibility |\n| REQ-QUAL-101 | ACC-QUAL-T2 | Installed-RC held-out T2 qualification |\n| REQ-QUAL-107 | ACC-PRV-STANDALONE, ACC-PRV-LIVE | Installed-RC standalone and provider matrix |\n| REQ-QUAL-108 | ACC-TUI-STEER, ACC-TUI-A11Y, ACC-TUI-MANUAL | CI PTY checks and installed-RC real-terminal matrix |\n| REQ-QUAL-109 | ACC-QUAL-T3 | Installed-RC T3 long-task qualification |\n<!-- RC-QUALIFICATION-ONLY:END -->\n\n<!-- RC-QUALIFICATION-EXCEPTIONS:START -->\n### Approved exact-RC qualification exceptions\n\n| Requirement | Approved decision | Scope |\n|---|---|---|\n<!-- RC-QUALIFICATION-EXCEPTIONS:END -->\n\n## 1. Rules\n\n1. The RC is built and published by the release workflow from a clean tag. Its version is identical across all components (REQ-REL-103).\n2. All qualification runs use the **installed RC package**, installed with the documented one-line command. They never use a checkout build. The only exception is CI unit and PTY suites, which run from source at the same commit.\n3. Thresholds (DEC-05) are frozen before the first M5 run. A failing gate is fixed in code and the run is repeated as `rc.N+1`. A threshold is never relaxed after results are known.\n4. Evidence goes to `docs/reviews/evidence/v1-qualification/<rc>/`. The directory contains:\n   - `manifest.json`: commit, package sha256, environment, model fingerprint, dates;\n   - raw outputs;\n   - a `SHA256SUMS` file.\n","exit_code":0,"duration":{"secs":0,"nanos":780564071}},"started_at_ms":1793039886238,"completed_at_ms":1793039887019}}
{"timestamp":"2026-10-26T18:38:08.004Z","ordinal":397022,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17981-6e83-7053-b077-e135ded8f860","call_id":"call_7829e1d1b8b24e658f78396a4c323544","output":[{"type":"input_text","text":"Script completed\nWall time 2.9 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 5103)\nTotal output lines: 303\n\n#!/bin/sh\nset -eu\n\nREPO=mikeholownych/nexus-code\nBASE=${NEXUS_RELEASE_BASE_URL:-\"https://github.com/$REPO/releases\"}\nVERSION=${NEXUS_VERSION:-latest}\nPREFIX=${NEXUS_PREFIX:-\"$HOME/.local\"}\n\nfail() { printf 'nexus installer: %s\\n' \"$*\" >&2; exit 1; }\ncase \"$(uname -s):$(uname -m)\" in\n  Linux:x86_64|Linux:amd64) ;;\n  *) fail \"unsupported system $(uname -s)/$(uname -m); supported: Linux x86-64 (glibc).\" ;;\nesac\ncommand -v node >/dev/null 2>&1 || fail \"Node.js 22 or newer is required; install Node.js and retry.\"\nNODE_MAJOR=$(node -p 'Number(process.versions.node.split(\".\")[0])' 2>/dev/null || printf 0)\n[ \"$NODE_MAJOR\" -ge 22 ] || fail \"Node.js 22 or newer is required (found $(node --version 2>/dev/null || echo unknown)).\"\ncommand -v curl >/dev/null 2>&1 || fail \"curl is required.\"\ncommand -v tar >/dev/null 2>&1 || fail \"tar is required.\"\ncommand -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n\nVERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION-auto}\ncase \"$VERIFY_ATTESTATION\" in\n  auto|0|1) ;;\n  *) fail \"NEXUS_VERIFY_ATTESTATION must be auto (verify when a trusted GitHub CLI is present), 1 (require verification) or 0 (skip verification).\" ;;\nesac\nTRUSTED_GH=\nif [ -x /usr/bin/gh ]; then\n  TRUSTED_GH=/usr/bin/gh\nelif [ -x /usr/local/bin/gh ]; then\n  TRUSTED_GH=/usr/local/bin/gh\nfi\nif [ \"$VERIFY_ATTESTATION\" = \"1\" ] && [ -z \"$TRUSTED_GH\" ]; then\n  fail \"provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\"\nfi\n\nvalidate_tag() {\n  printf '%s' \"$1\" | grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\"\n}\n\nif [ \"$VERSION\" != \"latest\" ]; then\n  validate_tag \"$VERSION\"\nfi\n\nif [ \"$VERSION\" = \"latest\" ]; then\n  API_BASE=${NEXUS_RELEASES_API:-\"https://api.github.com/repos/$REPO/releases\"}\n  API_TMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-api.XXXXXX\") || fail \"could not create temporary directory.\"\n  api_cleanup() { rm -rf \"$API_TMP\"; }\n  trap api_cleanup EXIT HUP INT TERM\n\n  LATEST_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -D \"$API_TMP/headers\" -o \"$API_TMP/latest.json\" -w \"%{http_code}\" \"$API_BASE/latest\" 2>\"$API_TMP/curl.err\" || echo \"000\")\n\n  if [ \"$LATEST_CODE\" = \"200\" ]; then\n    VERSION=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/latest.json\" | head -n 1)\n    [ -n \"$VERSION\" ] || fail \"GitHub returned no stable release tag.\"\n    validate_tag \"$VERSION\"\n  elif [ \"$LATEST_CODE\" = \"403\" ]; then\n    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \"$API_TMP/headers\" 2>/dev/null; then\n      fail \"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\"\n    fi\n    fail \"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\"\n  elif [ \"$LATEST_CODE\" = \"404\" ]; then\n    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \"$API_TMP/releases.json\" -w \"%{http_code}\" \"$API_BASE?per_page=1\" 2>/dev/null || echo \"000\")\n    if [ \"$PREREL_CODE\" = \"200\" ]; then\n      PREREL_TAG=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/releases.json\" | head -n 1)\n      if [ -n \"$PREREL_TAG\" ]; then\n        fail \"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\"\n      fi\n    fi\n    fail \"could not find latest stable release (HTTP 404 from $API_BASE/latest).\"\n  else\n    fail \"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\"\n  fi\n  rm -rf \"$API_TMP\"\n  trap - EXIT HUP INT TERM\nfi\n\nARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\nNORMALIZED_VERSION=${VERSION#v}\nURL=\"$BASE/download/$VERSION\"\nTMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-install.XXXXXX\") || fail \"could not create temporary directory.\"\ncleanup() { rm -rf \"$TMP\"; }\ntrap cleanup EXIT HUP INT TERM\ncurl -fsSL --show-error --retry 2 \"$URL/$ARCHIVE\" -o \"$TMP/$ARCHIVE\" || fail \"download failed for $ARCHIVE.\"\ncurl -fsSL --show-error --retry 2 \"$URL/SHA256SUMS\" -o \"$TMP/SHA256SUMS\" || fail \"could not download release checksums.\"\ngrep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksum entry for $ARCHIVE is missing.\"\n(cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\nARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n\nif [ \"$VERIFY_ATTESTATION\" != \"0\" ] && [ -n \"$TRUSTED_GH\" ]; then\n  if \"$TRUSTED_GH\" attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n     \"$TRUSTED_GH\" attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n    printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n  elif [ \"$VERIFY_ATTESTATION\" = \"1\" ]; then\n    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n  else\n    printf 'nexus installer: build provenance was not verified: %s could not verify the attestation (it may need gh auth login); the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' \"$TRUSTED_GH\" >&2\n  fi\nelif [ \"$VERIFY_ATTESTATION\" = \"auto\" ]; then\n  printf 'nexus installer: build provenance was not verified: no trusted GitHub CLI at /usr/bin/gh or /usr/local/bin/gh; the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' >&2\nfi\n\nVERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\nBIN_DIR=\"$PREFIX/bin\"\nLINK=\"$BIN_DIR/nexus\"\nmkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\nif [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n  fail \"$LINK exists and is not a symlink; left it unchanged.\"\nfi\nif [ -L \"$LINK\" ]; then\n  OLD=$(readlink \"$LINK\")\n  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\nfi\n\nFORCE=${NEXUS_FORCE:-0}\nNEEDS_EXTRACT=1\nif [ -d \"$VERSION_DIR\" ] && [ \"$FORCE\" != \"1\" ];…2103 tokens truncated…uality, terminal, installation, and independent-acceptance gates in §§4–8. Bind each result to both the RC source commit and installed package digest. If a source change or rebuilt artifact changes either identity, rerun every affected gate against the new candidate and retain prior results as historical evidence.\n5. **Stable promotion and publication.** After exact-RC acceptance and G6 pass, create a stable-version commit directly on the accepted RC commit, changing only the synchronized version metadata required for v1.0.0. Record both commits and the version-only diff. Run required source CI and all applicable source G0–G4 checks on this exact stable-version commit before tagging. If any other source changes, restart RC construction and qualification. Then create the `v1.0.0` tag on that checked commit and build a draft release. Keep its assets unpublished while verifying the stable artifact identity, provenance, package contents, installation, and publication metadata. Compare the stable package contents with the accepted RC; if packaged behavior or content differs beyond version-specific metadata, rerun affected installed-RC qualification gates and obtain independent acceptance for the stable artifact. Publish the draft only after these checks pass and the signed acceptance disposition is recorded. Record the published digests and provenance.\n\nThe final G6 decision in §10 applies to promoting the accepted RC toward a stable release. It requires the applicable gates to pass for the accepted RC and authorizes the version-only stable commit and its source checks, followed by the stable tag and draft build; it does not waive source CI, artifact identity, installed-RC qualification, or any threshold. Public publication is a separate post-build gate in stage 5 above. The release workflow must keep stable assets in draft state until stable artifact checks pass. Source verification at integration 6a16cb6 confirms the tag-triggered release workflow now supports published RC prereleases and draft stable releases. The earlier immediate-stable-publication source blocker is resolved; an actual stable draft build, artifact verification, signed acceptance, and deliberate publication are still required and remain unproven until their run evidence is recorded.\n\nExact-RC requirements records identify at least one implementer and an independent reviewer. For a blocking requirement recorded as `tested` instead of `product-qualified`, the cited decision must be explicitly allowlisted for that requirement in the approved qualification-exceptions table below, and its `DECISIONS.md` section must contain a matching requirement-specific line of the form `Qualification applicability: REQ-... = NOT REQUIRED ...`. A record-supplied or unrelated decision cannot authorize an exception. The record must include digest-bound evidence for every `ACC-*` criterion in that requirement's ledger Acceptance column.\n\nThe post-RC closure requirements listed below may remain `open`, `partial`, or `implemented` in the source ledger at the RC commit because their remaining acceptance is completed during G6 or installed-RC qualification. The bare `--enforce` invocation is the pre-RC source gate: it checks every other B/RR row against the source threshold and reports mapped rows as deferred, not accepted. At G6, the exact-RC invocation must provide a record meeting the normal B/RR status threshold and digest-bound evidence for every criterion in this table. The table also supplies the criterion mapping for rows whose ledger points to an ACCEPTANCE section instead of naming ACC IDs. The source ledger is never rewritten by the record. Any below-tested required row omitted from this table still fails.\n\n<!-- RC-QUALIFICATION-ONLY:START -->\n### Qualification-only requirements for exact-RC enforcement\n\n| Requirement | Acceptance criteria required in the exact-RC record | Remaining stage |\n|---|---|---|\n| REQ-REL-003 | ACC-PLAT | Installed-RC platform and Node-version matrix |\n| REQ-AGT-002 | ACC-VER-03, ACC-VER-04, ACC-VER-09, ACC-QUAL-T2, ACC-QUAL-T3, ACC-QUAL-T4 | Installed-RC T2/T3/T4 outcome thresholds |\n| REQ-AGT-010 | ACC-TRUST-04 | Independent acceptance of the DEC-04 v1 subset |\n| REQ-PRV-003 | ACC-INF-10 | Installed-RC standalone and absent-gateway behavior |\n| REQ-REL-005 | ACC-SUP-04, ACC-SUP-05 | Exact-RC security and dependency artifact checks |\n| REQ-AGT-110 | ACC-CONT-10, ACC-GOV-06 | Installed-RC continuity and independent acceptance |\n| REQ-PRV-111 | ACC-PRV-LIVE | Installed-RC provider verification |\n| REQ-REL-114 | ACC-SUP-08 | Exact-RC cross-runner reproducibility |\n| REQ-QUAL-101 | ACC-QUAL-T2 | Installed-RC held-out T2 qualification |\n| REQ-QUAL-107 | ACC-PRV-STANDALONE, ACC-PRV-LIVE | Installed-RC standalone and provider matrix |\n| REQ-QUAL-108 | ACC-TUI-STEER, ACC-TUI-A11Y, ACC-TUI-MANUAL | CI PTY checks and installed-RC real-terminal matrix |\n| REQ-QUAL-109 | ACC-QUAL-T3 | Installed-RC T3 long-task qualification |\n<!-- RC-QUALIFICATION-ONLY:END -->\n\n<!-- RC-QUALIFICATION-EXCEPTIONS:START -->\n### Approved exact-RC qualification exceptions\n\n| Requirement | Approved decision | Scope |\n|---|---|---|\n<!-- RC-QUALIFICATION-EXCEPTIONS:END -->\n\n## 1. Rules\n\n1. The RC is built and published by the release workflow from a clean tag. Its version is identical across all components (REQ-REL-103).\n2. All qualification runs use the **installed RC package**, installed with the documented one-line command. They never use a checkout build. The only exception is CI unit and PTY suites, which run from source at the same commit.\n3. Thresholds (DEC-05) are frozen before the first M5 run. A failing gate is fixed in code and the run is repeated as `rc.N+1`. A threshold is never relaxed after results are known.\n4. Evidence goes to `docs/reviews/evidence/v1-qualification/<rc>/`. The directory contains:\n   - `manifest.json`: commit, package sha256, environment, model fingerprint, dates;\n   - raw outputs;\n   - a `SHA256SUMS` file.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a178fa-f0ed-7ab3-bb71-477460bd1a0a","create_time":1793039888.0038517}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
