{"timestamp":"2026-10-26T17:46:46.590Z","ordinal":394971,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a178fa-f0ed-7ab3-bb71-477460bd1a0a","item":{"type":"CommandExecution","id":"exec-6b8a0ef4-6a83-40ed-b85f-c2b86da88431","process_id":"97642","command":["/usr/bin/zsh","-lc","git diff --no-ext-diff --unified=4 4cae11cbc3b0eab9bd6f56df7cc34e946b5dc566 987c73a8178390b0ed710474648ca1a71eaf060e -- cli/src/client.ts cli/test/provider_connect.test.ts cli/package.json package.json cli/package-lock.json core/Cargo.toml core/Cargo.lock docs/releases/v1.0.0-rc.9.md"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git diff --no-ext-diff --unified=4 4cae11cbc3b0eab9bd6f56df7cc34e946b5dc566 987c73a8178390b0ed710474648ca1a71eaf060e -- cli/src/client.ts cli/test/provider_connect.test.ts cli/package.json package.json cli/package-lock.json core/Cargo.toml core/Cargo.lock docs/releases/v1.0.0-rc.9.md"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"diff --git a/cli/package-lock.json b/cli/package-lock.json\nindex 3f1055a..141fb15 100644\n--- a/cli/package-lock.json\n+++ b/cli/package-lock.json\n@@ -1,13 +1,13 @@\n {\n   \"name\": \"local-code-harness\",\n-  \"version\": \"1.0.0-rc.9\",\n+  \"version\": \"1.0.0-rc.8\",\n   \"lockfileVersion\": 3,\n   \"requires\": true,\n   \"packages\": {\n     \"\": {\n       \"name\": \"local-code-harness\",\n-      \"version\": \"1.0.0-rc.9\",\n+      \"version\": \"1.0.0-rc.8\",\n       \"license\": \"MIT\",\n       \"dependencies\": {\n         \"commander\": \"^12.1.0\",\n         \"dotenv\": \"^16.4.5\",\ndiff --git a/cli/package.json b/cli/package.json\nindex d1ee4c7..8d1426d 100644\n--- a/cli/package.json\n+++ b/cli/package.json\n@@ -1,7 +1,7 @@\n {\n   \"name\": \"local-code-harness\",\n-  \"version\": \"1.0.0-rc.9\",\n+  \"version\": \"1.0.0-rc.8\",\n   \"type\": \"module\",\n   \"description\": \"Autonomous local AI coding harness (Codex / Claude-Code style) for LM Studio and vLLM\",\n   \"main\": \"dist/index.js\",\n   \"bin\": {\ndiff --git a/cli/src/client.ts b/cli/src/client.ts\nindex 0dc11ae..65948df 100644\n--- a/cli/src/client.ts\n+++ b/cli/src/client.ts\n@@ -186,14 +186,9 @@ export function environmentCredential(operatorEndpoint: string): { apiKey: strin\n   const configuredCredentialOrigin = authoritySetting(\"LOCAL_LLM_CREDENTIAL_ORIGIN\") ?? readConfigEnv().LOCAL_LLM_CREDENTIAL_ORIGIN;\n   if (configuredCredentialOrigin && !originOf(configuredCredentialOrigin) && (operatorKey === apiKey || isStoredCredential(apiKey))) {\n     return undefined;\n   }\n-  if (operatorKey === apiKey) {\n-    return {\n-      apiKey,\n-      origin: originOf(configuredCredentialOrigin ?? authoritySetting(\"LOCAL_LLM_ENDPOINT\") ?? operatorEndpoint),\n-    };\n-  }\n+  if (operatorKey === apiKey) return { apiKey, origin: originOf(authoritySetting(\"LOCAL_LLM_ENDPOINT\") ?? operatorEndpoint) };\n   if (isStoredCredential(apiKey)) return undefined;\n   return { apiKey, origin: originOf(process.env.LOCAL_LLM_ENDPOINT ?? operatorEndpoint) };\n }\n \ndiff --git a/cli/test/provider_connect.test.ts b/cli/test/provider_connect.test.ts\nindex e153389..e6add77 100644\n--- a/cli/test/provider_connect.test.ts\n+++ b/cli/test/provider_connect.test.ts\n@@ -427,37 +427,25 @@ describe(\"connecting from the picker\", () => {\n       await endpoint.close();\n     }\n   });\n \n-  test(\"changing the local endpoint does not rebind a config.env key to the new origin\", async () => {\n+  test(\"changing the local endpoint does not rebind a config.env key to the new origin\", () => {\n     const oldEndpoint = \"http://127.0.0.1:4321/v1\";\n-    const oldOrigin = \"http://127.0.0.1:4321\";\n-    const replacement = await mock((_s, res) => { res.writeHead(200, { \"content-type\": \"application/json\" }); res.end(JSON.stringify({ data: [] })); });\n-    const newEndpoint = `${replacement.url}/v1`;\n+    const newEndpoint = \"http://127.0.0.1:5432/v1\";\n     const configFile = write(\".config/nexus/config.env\", `LOCAL_LLM_ENDPOINT=${JSON.stringify(oldEndpoint)}\\nLOCAL_LLM_API_KEY=legacy-old-origin-key\\n`);\n     setCredentialAuthority({ LOCAL_LLM_ENDPOINT: oldEndpoint, LOCAL_LLM_API_KEY: \"legacy-old-origin-key\" }, home);\n     assert.equal(storedCredentialFor(oldEndpoint), \"legacy-old-origin-key\");\n \n-    try {\n-      saveLocalEndpointSettings(newEndpoint, \"new-model\");\n-      operator({\n-        LOCAL_LLM_ENDPOINT: newEndpoint,\n-        LOCAL_LLM_API_KEY: \"legacy-old-origin-key\",\n-        LOCAL_LLM_CREDENTIAL_ORIGIN: oldOrigin,\n-      });\n+    saveLocalEndpointSettings(newEndpoint, \"new-model\");\n+    setCredentialAuthority({\n+      LOCAL_LLM_ENDPOINT: newEndpoint,\n+      LOCAL_LLM_API_KEY: \"legacy-old-origin-key\",\n+      LOCAL_LLM_CREDENTIAL_ORIGIN: \"http://127.0.0.1:4321\",\n+    }, home);\n \n-      assert.equal(storedCredentialFor(newEndpoint), null, \"the legacy key must not follow the changed endpoint\");\n-      assert.equal(storedCredentialFor(oldEndpoint), \"legacy-old-origin-key\", \"the legacy key remains usable only at its original origin\");\n-      assert.deepEqual(environmentCredential(newEndpoint), { apiKey: \"legacy-old-origin-key\", origin: oldOrigin });\n-\n-      const config = buildConfig({ endpoint: newEndpoint });\n-      assert.equal(config.credentialOrigin, oldOrigin, \"buildConfig keeps the key bound to the recorded origin\");\n-      await new LocalLlmClient(config).listModels();\n-      assert.deepEqual(replacement.seen.map((request) => request.headers.authorization), [\"Bearer not-needed\"], \"the replacement endpoint never receives the old key\");\n-      assert.match(fs.readFileSync(configFile, \"utf8\"), /LOCAL_LLM_CREDENTIAL_ORIGIN=\"http:\\/\\/127\\.0\\.0\\.1:4321\"/);\n-    } finally {\n-      await replacement.close();\n-    }\n+    assert.equal(storedCredentialFor(newEndpoint), null, \"the legacy key must not follow the changed endpoint\");\n+    assert.equal(storedCredentialFor(oldEndpoint), \"legacy-old-origin-key\", \"the legacy key remains usable only at its original origin\");\n+    assert.match(fs.readFileSync(configFile, \"utf8\"), /LOCAL_LLM_CREDENTIAL_ORIGIN=\"http:\\/\\/127\\.0\\.0\\.1:4321\"/);\n   });\n \n   test(\"a malformed credential origin cannot fall back to and bind a legacy key to the selected endpoint\", () => {\n     const endpoint = \"http://127.0.0.1:5432/v1\";\ndiff --git a/core/Cargo.lock b/core/Cargo.lock\nindex ee5ebd1..c275f38 100644\n--- a/core/Cargo.lock\n+++ b/core/Cargo.lock\n@@ -435,9 +435,9 @@ dependencies = [\n ]\n \n [[package]]\n name = \"harness-core\"\n-version = \"1.0.0-rc.9\"\n+version = \"1.0.0-rc.8\"\n dependencies = [\n  \"clap\",\n  \"crossterm\",\n  \"git2\",\ndiff --git a/core/Cargo.toml b/core/Cargo.toml\nindex 4372993..b12a0ad 100644\n--- a/core/Cargo.toml\n+++ b/core/Cargo.toml\n@@ -1,7 +1,7 @@\n [package]\n name = \"harness-core\"\n-version = \"1.0.0-rc.9\"\n+version = \"1.0.0-rc.8\"\n edition = \"2024\"\n rust-version = \"1.85.0\"\n license = \"Apache-2.0\"\n \ndiff --git a/docs/releases/v1.0.0-rc.9.md b/docs/releases/v1.0.0-rc.9.md\ndeleted file mode 100644\nindex 324b80b..0000000\n--- a/docs/releases/v1.0.0-rc.9.md\n+++ /dev/null\n@@ -1,26 +0,0 @@\n-# Nexus Code v1.0.0-rc.9 release candidate\n-\n-**Maturity:** release candidate; prerelease, not stable.\n-\n-**Status:** this candidate is for exact-artifact qualification. It does not establish independent acceptance or authorize stable v1.0.0 promotion. Qualification results must identify the workflow-produced package and its digest.\n-\n-This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and sidecar, production Node dependencies, Rust `harness-core`, and Ratatui `nexus-tui`.\n-\n-## Changes since RC8\n-\n-- **Verifier baseline timing:** capture the discovered verifier baseline before the first workspace-mutating tool runs. This preserves the pre-mutation state for verification across both direct commands and subagent dispatch.\n-- **Upgrade download recovery:** retry one idempotent release download after a connection reset before a response, within the existing timeout. HTTP errors, origin and checksum validation, archive handling, and recovery behavior remain unchanged.\n-- **Provider stream handling:** preserve provider output and error-code semantics for streamed and non-streamed responses, avoid unsafe immediate failover after partial output, retain cancellation and watchdog cleanup while reading error bodies, and bound and redact provider error text.\n-- **Local endpoint setup:** configure an OpenAI-compatible local endpoint from the connect flow, verify it, discover and select models, and store an optional credential for that endpoint. Existing credentials remain bound to their recorded origin when the endpoint changes.\n-\n-## Runtime requirements\n-\n-- Linux x86-64 with glibc 2.35 or newer.\n-- Node.js 22 or newer.\n-- An OpenAI-compatible inference endpoint, local or explicitly selected provider.\n-\n-The archive does not include Node.js. Rust and Cargo are not required at runtime. No other OS or architecture is claimed.\n-\n-## Candidate assets\n-\n-The release workflow for `v1.0.0-rc.9` is expected to produce the version-matched Linux archive, `SHA256SUMS`, SBOM, notices, installer, and provenance. The workflow run, tag commit, artifact digests, and qualification evidence must be recorded before this candidate can be accepted. Local builds are not interchangeable with the workflow-produced artifacts.\ndiff --git a/package.json b/package.json\nindex 737d076..55918fb 100644\n--- a/package.json\n+++ b/package.json\n@@ -1,7 +1,7 @@\n {\n   \"name\": \"nexus-code-harness\",\n-  \"version\": \"1.0.0-rc.9\",\n+  \"version\": \"1.0.0-rc.8\",\n   \"description\": \"High-Performance Autonomous Local AI Coding Harness (Codex / Claude-Code style) powered by Rust + TypeScript\",\n   \"scripts\": {\n     \"build:core\": \"cargo build --release --manifest-path core/Cargo.toml\",\n     \"build:cli\": \"npm --prefix cli run build\",\n","exit_code":0,"duration":{"secs":0,"nanos":26220}},"started_at_ms":1793036806589,"completed_at_ms":1793036806590}}
{"timestamp":"2026-10-26T17:46:47.637Z","ordinal":394972,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17952-6dd5-7d50-8940-b8eb052941d0","call_id":"call_8330cf97931c45a68173a2d8f47799fb","output":[{"type":"input_text","text":"Script completed\nWall time 2.1 seconds\nOutput:\n"},{"type":"input_text","text":"diff --git a/cli/package-lock.json b/cli/package-lock.json\nindex 3f1055a..141fb15 100644\n--- a/cli/package-lock.json\n+++ b/cli/package-lock.json\n@@ -1,13 +1,13 @@\n {\n   \"name\": \"local-code-harness\",\n-  \"version\": \"1.0.0-rc.9\",\n+  \"version\": \"1.0.0-rc.8\",\n   \"lockfileVersion\": 3,\n   \"requires\": true,\n   \"packages\": {\n     \"\": {\n       \"name\": \"local-code-harness\",\n-      \"version\": \"1.0.0-rc.9\",\n+      \"version\": \"1.0.0-rc.8\",\n       \"license\": \"MIT\",\n       \"dependencies\": {\n         \"commander\": \"^12.1.0\",\n         \"dotenv\": \"^16.4.5\",\ndiff --git a/cli/package.json b/cli/package.json\nindex d1ee4c7..8d1426d 100644\n--- a/cli/package.json\n+++ b/cli/package.json\n@@ -1,7 +1,7 @@\n {\n   \"name\": \"local-code-harness\",\n-  \"version\": \"1.0.0-rc.9\",\n+  \"version\": \"1.0.0-rc.8\",\n   \"type\": \"module\",\n   \"description\": \"Autonomous local AI coding harness (Codex / Claude-Code style) for LM Studio and vLLM\",\n   \"main\": \"dist/index.js\",\n   \"bin\": {\ndiff --git a/cli/src/client.ts b/cli/src/client.ts\nindex 0dc11ae..65948df 100644\n--- a/cli/src/client.ts\n+++ b/cli/src/client.ts\n@@ -186,14 +186,9 @@ export function environmentCredential(operatorEndpoint: string): { apiKey: strin\n   const configuredCredentialOrigin = authoritySetting(\"LOCAL_LLM_CREDENTIAL_ORIGIN\") ?? readConfigEnv().LOCAL_LLM_CREDENTIAL_ORIGIN;\n   if (configuredCredentialOrigin && !originOf(configuredCredentialOrigin) && (operatorKey === apiKey || isStoredCredential(apiKey))) {\n     return undefined;\n   }\n-  if (operatorKey === apiKey) {\n-    return {\n-      apiKey,\n-      origin: originOf(configuredCredentialOrigin ?? authoritySetting(\"LOCAL_LLM_ENDPOINT\") ?? operatorEndpoint),\n-    };\n-  }\n+  if (operatorKey === apiKey) return { apiKey, origin: originOf(authoritySetting(\"LOCAL_LLM_ENDPOINT\") ?? operatorEndpoint) };\n   if (isStoredCredential(apiKey)) return undefined;\n   return { apiKey, origin: originOf(process.env.LOCAL_LLM_ENDPOINT ?? operatorEndpoint) };\n }\n \ndiff --git a/cli/test/provider_connect.test.ts b/cli/test/provider_connect.test.ts\nindex e153389..e6add77 100644\n--- a/cli/test/provider_connect.test.ts\n+++ b/cli/test/provider_connect.test.ts\n@@ -427,37 +427,25 @@ describe(\"connecting from the picker\", () => {\n       await endpoint.close();\n     }\n   });\n \n-  test(\"changing the local endpoint does not rebind a config.env key to the new origin\", async () => {\n+  test(\"changing the local endpoint does not rebind a config.env key to the new origin\", () => {\n     const oldEndpoint = \"http://127.0.0.1:4321/v1\";\n-    const oldOrigin = \"http://127.0.0.1:4321\";\n-    const replacement = await mock((_s, res) => { res.writeHead(200, { \"content-type\": \"application/json\" }); res.end(JSON.stringify({ data: [] })); });\n-    const newEndpoint = `${replacement.url}/v1`;\n+    const newEndpoint = \"http://127.0.0.1:5432/v1\";\n     const configFile = write(\".config/nexus/config.env\", `LOCAL_LLM_ENDPOINT=${JSON.stringify(oldEndpoint)}\\nLOCAL_LLM_API_KEY=legacy-old-origin-key\\n`);\n     setCredentialAuthority({ LOCAL_LLM_ENDPOINT: oldEndpoint, LOCAL_LLM_API_KEY: \"legacy-old-origin-key\" }, home);\n     assert.equal(storedCredentialFor(oldEndpoint), \"legacy-old-origin-key\");\n \n-    try {\n-      saveLocalEndpointSettings(newEndpoint, \"new-model\");\n-      operator({\n-        LOCAL_LLM_ENDPOINT: newEndpoint,\n-        LOCAL_LLM_API_KEY: \"legacy-old-origin-key\",\n-        LOCAL_LLM_CREDENTIAL_ORIGIN: oldOrigin,\n-      });\n+    saveLocalEndpointSettings(newEndpoint, \"new-model\");\n+    setCredentialAuthority({\n+      LOCAL_LLM_ENDPOINT: newEndpoint,\n+      LOCAL_LLM_API_KEY: \"legacy-old-origin-key\",\n+      LOCAL_LLM_CREDENTIAL_ORIGIN: \"http://127.0.0.1:4321\",\n+    }, home);\n \n-      assert.equal(storedCredentialFor(newEndpoint), null, \"the legacy key must not follow the changed endpoint\");\n-      assert.equal(storedCredentialFor(oldEndpoint), \"legacy-old-origin-key\", \"the legacy key remains usable only at its original origin\");\n-      assert.deepEqual(environmentCredential(newEndpoint), { apiKey: \"legacy-old-origin-key\", origin: oldOrigin });\n-\n-      const config = buildConfig({ endpoint: newEndpoint });\n-      assert.equal(config.credentialOrigin, oldOrigin, \"buildConfig keeps the key bound to the recorded origin\");\n-      await new LocalLlmClient(config).listModels();\n-      assert.deepEqual(replacement.seen.map((request) => request.headers.authorization), [\"Bearer not-needed\"], \"the replacement endpoint never receives the old key\");\n-      assert.match(fs.readFileSync(configFile, \"utf8\"), /LOCAL_LLM_CREDENTIAL_ORIGIN=\"http:\\/\\/127\\.0\\.0\\.1:4321\"/);\n-    } finally {\n-      await replacement.close();\n-    }\n+    assert.equal(storedCredentialFor(newEndpoint), null, \"the legacy key must not follow the changed endpoint\");\n+    assert.equal(storedCredentialFor(oldEndpoint), \"legacy-old-origin-key\", \"the legacy key remains usable only at its original origin\");\n+    assert.match(fs.readFileSync(configFile, \"utf8\"), /LOCAL_LLM_CREDENTIAL_ORIGIN=\"http:\\/\\/127\\.0\\.0\\.1:4321\"/);\n   });\n \n   test(\"a malformed credential origin cannot fall back to and bind a legacy key to the selected endpoint\", () => {\n     const endpoint = \"http://127.0.0.1:5432/v1\";\ndiff --git a/core/Cargo.lock b/core/Cargo.lock\nindex ee5ebd1..c275f38 100644\n--- a/core/Cargo.lock\n+++ b/core/Cargo.lock\n@@ -435,9 +435,9 @@ dependencies = [\n ]\n \n [[package]]\n name = \"harness-core\"\n-version = \"1.0.0-rc.9\"\n+version = \"1.0.0-rc.8\"\n dependencies = [\n  \"clap\",\n  \"crossterm\",\n  \"git2\",\ndiff --git a/core/Cargo.toml b/core/Cargo.toml\nindex 4372993..b12a0ad 100644\n--- a/core/Cargo.toml\n+++ b/core/Cargo.toml\n@@ -1,7 +1,7 @@\n [package]\n name = \"harness-core\"\n-version = \"1.0.0-rc.9\"\n+version = \"1.0.0-rc.8\"\n edition = \"2024\"\n rust-version = \"1.85.0\"\n license = \"Apache-2.0\"\n \ndiff --git a/docs/releases/v1.0.0-rc.9.md b/docs/releases/v1.0.0-rc.9.md\ndeleted file mode 100644\nindex 324b80b..0000000\n--- a/docs/releases/v1.0.0-rc.9.md\n+++ /dev/null\n@@ -1,26 +0,0 @@\n-# Nexus Code v1.0.0-rc.9 release candidate\n-\n-**Maturity:** release candidate; prerelease, not stable.\n-\n-**Status:** this candidate is for exact-artifact qualification. It does not establish independent acceptance or authorize stable v1.0.0 promotion. Qualification results must identify the workflow-produced package and its digest.\n-\n-This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and sidecar, production Node dependencies, Rust `harness-core`, and Ratatui `nexus-tui`.\n-\n-## Changes since RC8\n-\n-- **Verifier baseline timing:** capture the discovered verifier baseline before the first workspace-mutating tool runs. This preserves the pre-mutation state for verification across both direct commands and subagent dispatch.\n-- **Upgrade download recovery:** retry one idempotent release download after a connection reset before a response, within the existing timeout. HTTP errors, origin and checksum validation, archive handling, and recovery behavior remain unchanged.\n-- **Provider stream handling:** preserve provider output and error-code semantics for streamed and non-streamed responses, avoid unsafe immediate failover after partial output, retain cancellation and watchdog cleanup while reading error bodies, and bound and redact provider error text.\n-- **Local endpoint setup:** configure an OpenAI-compatible local endpoint from the connect flow, verify it, discover and select models, and store an optional credential for that endpoint. Existing credentials remain bound to their recorded origin when the endpoint changes.\n-\n-## Runtime requirements\n-\n-- Linux x86-64 with glibc 2.35 or newer.\n-- Node.js 22 or newer.\n-- An OpenAI-compatible inference endpoint, local or explicitly selected provider.\n-\n-The archive does not include Node.js. Rust and Cargo are not required at runtime. No other OS or architecture is claimed.\n-\n-## Candidate assets\n-\n-The release workflow for `v1.0.0-rc.9` is expected to produce the version-matched Linux archive, `SHA256SUMS`, SBOM, notices, installer, and provenance. The workflow run, tag commit, artifact digests, and qualification evidence must be recorded before this candidate can be accepted. Local builds are not interchangeable with the workflow-produced artifacts.\ndiff --git a/package.json b/package.json\nindex 737d076..55918fb 100644\n--- a/package.json\n+++ b/package.json\n@@ -1,7 +1,7 @@\n {\n   \"name\": \"nexus-code-harness\",\n-  \"version\": \"1.0.0-rc.9\",\n+  \"version\": \"1.0.0-rc.8\",\n   \"description\": \"High-Performance Autonomous Local AI Coding Harness (Codex / Claude-Code style) powered by Rust + TypeScript\",\n   \"scripts\": {\n     \"build:core\": \"cargo build --release --manifest-path core/Cargo.toml\",\n     \"build:cli\": \"npm --prefix cli run build\",\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a178fa-f0ed-7ab3-bb71-477460bd1a0a","create_time":1793036807.6371431}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
