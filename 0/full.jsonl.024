ied; tag object d211d1c7545d2dd629531e4f712e98a240a782c6 dereferences to 4cae11cbc3b0eab9bd6f56df7cc34e946b5dc566; pushed 17:38Z\",\n  \"rc9_tag_build\": \"Signed tag v1.0.0-rc.9 dereferences to 4cae11cbc3b0eab9bd6f56df7cc34e946b5dc566; release workflow 40370485753 advanced from npm CLI tests to package-linux.sh; no GitHub release assets or provenance yet.\",\n  \"rc9_worktree\": \"/home/mike/nexus-wt/rc9-version-bump\",\n  \"readiness_branch\": \"v1/readiness-post-rc8-pr254\",\n  \"readiness_head\": \"4564ac6e4a8bbbec8f033a53a552f01514c1cb7a\",\n  \"readiness_postmerge\": \"PR251 merge e9304b1cafa629a999e9165977588c9524a4d9da; post-merge main CI40300214592 SUCCESS all jobs (completed 2026-10-26T10:12:25Z); CodeQL40300214410 SUCCESS.\",\n  \"readiness_pr\": 255,\n  \"readiness_pr259\": \"Updated PR259 to d508e1998d879dc4e0005b8c6a0cc3e2ccc2bda1; exact base 4cae11c; diff SHA-256 ab494c7bf2a97bc50e5142caa49e2d2efd60618d6be11ff76f374e88a9a69ca5; RC9 tag/build state corrected and operator-reported RC8 dogfood export classified exploratory only; independent review and exact-head CI requested/pending\",\n  \"readiness_pr_base\": \"b73b6ecaf753ff3eba8d5e1930ede7a471359421\",\n  \"readiness_pr_checks\": \"Exact head 4564ac6: CodeQL SUCCESS; JS/TS SUCCESS; Node22 and Node24 full CLI suites in progress.\",\n  \"readiness_pr_ci\": \"40294952888 in progress; Linux npm test in progress; Node22/Node24 success\",\n  \"readiness_pr_codeql\": \"40294952933 SUCCESS\",\n  \"readiness_pr_head\": \"49eeea053dae33fe9389e000965b7d0de75e64d7\",\n  \"readiness_pr_merged\": \"e9304b1cafa629a999e9165977588c9524a4d9da\",\n  \"readiness_pr_review\": \"ACCEPT after body correction; reviewer plan05_readonly_review verified 08:05 checkpoint and signature status\",\n  \"readiness_pr_status\": \"PR255 MERGED 2026-10-26T14:30:34Z; exact head CI40333869626 Node22/24/Linux PASS; CodeQL40333869903 PASS; JS/TS PASS; independent ACCEPT; postmerge CI40340228722 and CodeQL40340228417 in progress.\",\n  \"readiness_worktree\": \"/home/mike/nexus-wt/readiness-post-rc8-pr254\",\n  \"recovered_worktree\": \"/home/mike/nexus-wt/rc9-credential-origin-binding\",\n  \"release_status\": \"RC9 published as prerelease 2026-10-26T17:56:16Z; artifact and checksum index verified; installed on ubuntu-desktop at isolated prefix; no accepted RC or stable v1.0.0 release.\",\n  \"requirements_gate\": \"PASS: 123 rows; 12 exact-RC deferrals\",\n  \"reviewed_diff_sha256\": \"06ac7420c9901f4c9d77367900de7ce3e9b4eae3fa3535144501dd614a71f5a0\",\n  \"reviewer\": \"rc5_candidate_review\",\n  \"scope\": \"Release publisher owns RC lifecycle and exact-source/artifact acceptance coordination; no held-out access, no stable publication until every release gate passes.\",\n  \"stable_release\": \"Not authorized yet by G6; no stable v1.0.0 tag/release; held-out custody, exact-RC acceptance and human terminal matrix remain incomplete\",\n  \"stable_signing_identity\": \"one local GPG secret key matches GitHub-verified key metadata; no key material logged; reverify chosen signer on the final stable tag\",\n  \"status\": \"RC9 release workflow 40370485753 SUCCESS; tag signature locally good and GitHub verified; complete release assets SHA256SUMS pass; GitHub attestations pass for archive and checksum index; installed exact RC9 on ubuntu-desktop in isolated prefix with archive SHA-256 35795d2b7639b68a541c512976d8bc7f251115ebdccf48f6b9cf5f98ef1af9bb; acceptance IN_PROGRESS; held-out custody and manual terminal matrix still pending.\",\n  \"terminal_matrix_preflight\": \"Ubuntu desktop 10.0.8.3 verified strict SSH, GitHub CLI auth, GNOME session, xterm/kitty/GNOME Terminal/tmux/VS Code, and GNOME Shell screenshot D-Bus service. Exact RC9 installed at /home/mike/.local/nexus-rc9-qualification with verified provenance. Matrix remains 0/15 and requires genuine operator cells/screenshots; SSH is noninteractive and does not supply human evidence. Terminal runner/screenshot helper and exact 15-cell command checklist are staged under ~/.cache/nexus-rc9-terminal-matrix; output directory is empty.\",\n  \"updated_at\": \"2026-10-27T00:07:00Z\",\n  \"version_sync\": \"PASS: components at 1.0.0-rc.8\",\n  \"worktree\": \"/home/mike/nexus-wt/rc7-version-bump\"\n}\n\n--- .git/nexus-claims/FILE_docs_v1.0.0_TERMINAL-MATRIX-WORKSHEET.md/owner.json ---\n{\n  \"agent\": \"/root\",\n  \"host\": \"mike-dev\",\n  \"branch\": \"v1/terminal-matrix-rc4-worksheet\",\n  \"worktree\": \"/home/mike/nexus-wt/terminal-matrix-rc3\",\n  \"base\": \"016bbc332d694b32072f6346e7f3127fb98b691f\",\n  \"since\": \"2026-10-23T09:20:00Z\",\n  \"scope\": \"Prepare the REQ-QUAL-108 operator worksheet for the next eligible RC; no matrix results or acceptance claim\",\n  \"reviewer\": \"current_main_rc_path_audit\",\n  \"review_disposition\": \"ACCEPT\",\n  \"reviewed_at\": \"2026-10-25T05:47:00Z\",\n  \"status\": \"RC7 is now present on ubuntu-desktop at /home/mike/.local/lib/nexus/v1.0.0-rc.7; CLI reports 1.0.0-rc.7 (431cb194931f), installed package tree matches published archive byte-for-byte excluding installer-created .provenance.json, and provenance archive SHA256 matches public digest 367e9384e6de6df5801c3b015e7965becccb53b6b11ff94cf906da764724c58a. Host runs Ubuntu 26.04.1 LTS with xterm, kitty, GNOME Terminal, tmux 3.6, VS Code; active GNOME Wayland seat. Matrix remains 0/15; no screenshots/manual behavior claimed. Existing worksheet branch remains unintegrated; no evidence changes made.\",\n  \"head\": \"2b55c031498412747f5e2ef09b4ef9e288ac77ca\",\n  \"desktop_rc4_archive_sha256\": \"07867e26077e5eec6f2cb665c4c34045a116669cacbe7f81f62f40b6fac8b806\",\n  \"desktop_rc4_cli_version\": \"1.0.0-rc.4 (57b9285c6cea)\",\n  \"terminal_matrix_completed_cells\": 0,\n  \"updated_at\": \"2026-10-26T01:48:00Z\"\n}\n\n--- .git/nexus-claims/FILE_docs_reviews_evidence_v1_qualification_rc10_overlay_states/owner.json ---\n{\"agent\":\"/root\",\"host\":\"mike-dev\",\"branch\":\"v1/rc10-scripted-terminal\",\"worktree\":\"/home/mike/nexus-wt/rc10-scripted-terminal\",\"base\":\"16ee8ca3643824741b6da67936b41f262414fdf0\",\"head\":\"5bf40f4f79cac92f85543e4c89422cbf897ee6b9\",\"since\":\"2026-10-27T01:48:00Z\",\"scope\":\"Archive further installed RC10 PTY overlay readability evidence; synthetic only; no human acceptance claim.\"}\n\n--- current readiness markers ---\n235:**Checkpoint failure and remediation:** The operator reports that every attempt to start Nexus RC1 fails with `Sensitive content prevents durable persistence to checkpoint`. This is consistent with RC1's exact source predating PR #147's checkpoint-choice flow. PR #147 is integrated in current main and its exact-head CI and CodeQL passed; the interactive TUI now offers read-only, continue without a rollback checkpoint, create the checkpoint anyway with a sensitivity warning, cancel, or re-enter the instruction. RC1 and RC2 are immutable and do not contain this behavior. The next candidate must include the fix, and the installed candidate must be exercised to verify the choices before any acceptance claim.\n237:**RC identity and publication:** Remote immutable tags are `v1.0.0-rc.1` at `cb364c386c42faa53b67e04cacc81d7e01520779` and `v1.0.0-rc.2` at `19d6f0a80e21f9b640a46ee12200c4f5f6d967a4`; both predate the accepted Node 22 floor. GitHub currently publishes RC1 as a prerelease; RC2 has a tag but no published release. No accepted RC or stable v1.0.0 tag/release is established. The next candidate needs a fresh RC3 identity after its source/version checks; it must be installed and qualified before acceptance.\n239:**Qualification and release disposition:** Public Issue #1 remains open, with no custodian response to the latest metadata-only compatibility request posted at 22:08 UTC; T2 qualification has not started and no held-out payload was accessed. Installed-RC E2, standalone/provider, T3/T4, exact-RC reproducibility, human five-terminal by three-size acceptance ([terminal matrix worksheet](TERMINAL-MATRIX-WORKSHEET.md)), and independent exact-RC acceptance remain outstanding. Campaign status is `NEXUS_V1_CONVERGENCE_ACTIVE`; acceptance is `IN_PROGRESS`; publication authorization remains granted and gated. No RC is accepted and no stable v1.0.0 release is claimed.\n243:The authoritative source is `origin/main@269d611ca0a0c8a55244bf70d89fa4a918b9d218`. The Node 22 convergence branch was refreshed without rewriting history and its current candidate head is `v1/node22-floor-converged@658ace9d4ab67901b5b2db1c090f6b01537be27a`; the Node `>=22` source implementation was validated at `fb798a1bd517ac85fd3c99f76d3fda1709540a8d`, and the candidate adds reviewed ruleset and acceptance-stage reconciliations. It is not yet integrated. `node scripts/sync-version.mjs --check` passes at version `1.0.0-rc.2`. The source requirements check currently fails because REQ-REL-111 remains partial pending exact-candidate checks; REQ-REL-003 remains partial for installed-RC platform qualification and is now explicitly mapped to ACC-PLAT in the exact-RC stage. No threshold or qualification evidence was changed.\n245:The live GitHub `v1-protected-branches` ruleset (ID `25340146`) currently requires `test-matrix (22)`, `test-matrix (24)`, and `linux-x86_64`; it does not require Node 20. The checked-in ruleset snapshot now matches that live required-check set. No live protection setting was modified. PR #137 still targets an older base, PR #146 remains a draft, and the refreshed candidate branch has not yet been opened as a replacement PR. Independent review of the refreshed candidate requested these documentation reconciliations; code/runtime review otherwise found no blocker.\n247:PR #149 is open at `1972adb8a6d4b9bacf9974f33974b61d751de8ab` on base `269d611`; Node 20/22/24 matrix checks and CodeQL pass, while its exact-head Linux packaging job is still running. Its independent source review accepted the T3 symlink hardening, but it is not integrated until the required job concludes.\n249:The public `v1.0.0-rc.1` release remains the only published v1 candidate. `v1.0.0-rc.2` points to older source and is nonqualifying under the Node 22 decision. There is no accepted RC or stable release. Held-out custody, provider/standalone qualification, T2/T3/T4, cross-runner reproducibility, installed-RC packaging and qualification, five-terminal by three-size human evidence, and independent acceptance remain incomplete. Campaign status is `NEXUS_V1_CONVERGENCE_ACTIVE`; acceptance remains `IN_PROGRESS`; publication authorization remains granted and gated.\n253:`origin/main` is now `dceac980b3d77c99a26bb9ddedb61c443168952a`, after PR #142 merged as `08861feb2c6a164a89f4c0573e1c7793c9f938e5` and PR #143 merged as `dceac980b3d77c99a26bb9ddedb61c443168952a`. PR #143 corrects the Node 20 EOL date in the RC1 release note; independent review accepted its exact net diff, and exact-head CI `39769489238` plus CodeQL `39769489243` passed on PR head `5e1f221e920bf6738fb3d62296199f34c8db53a0` against base `08861fe`. Post-merge CI `39773603423` and CodeQL `39773603376` are running on exact `main@dceac980`; no post-merge conclusion is claimed yet. Contest work is over and no contest freeze applies. Campaign status remains `NEXUS_V1_CONVERGENCE_ACTIVE`; acceptance remains `IN_PROGRESS`. RC1 remains an older artifact, and no stable v1.0.0 release is asserted.\n257:**Authoritative source and CI:** `origin/main` is `44ca13d58a262b5f89be459b47aefa50c2d61683`, PR #140's merge commit. Exact-main CI [39747222866](https://github.com/mikeholownych/nexus-code/actions/runs/39747222866) passed all four jobs on that exact SHA: Node 20, 22, 24, and Linux x86-64 packaging, including the CLI suite and package smoke check. Exact-main CodeQL [39747222840](https://github.com/mikeholownych/nexus-code/actions/runs/39747222840) passed. PR #140's host report is synthetic-only: 10/10 infrastructure checks passed and independent review accepted it; it does not establish held-out qualification.\n259:**Requirements and acceptance:** I reran `node scripts/check_requirements.mjs --enforce` at 09:34 UTC from a clean detached worktree at exact source `44ca13d58a262b5f89be459b47aefa50c2d61683`, with isolated HOME/XDG; it exited 0 and reported 123 rows (109 tested, 5 partial, 2 implemented, 7 open), with 11 requirements explicitly mapped to exact-RC qualification in `ACCEPTANCE.md` §1.1. The checker output is reproducible from that source revision. This is a source-stage gate only; it does not establish RC qualification or acceptance. Campaign status is `NEXUS_V1_CONVERGENCE_ACTIVE`; acceptance remains `IN_PROGRESS`.\n261:**Evaluator containment and Git isolation:** Source tests cover CPU, memory, process-count, storage limits, process cleanup, solution-bearing Git refs/reflogs/dangling objects, and external canary stores in `cli/test/eval_integrity.test.ts`. PR #140 records a separate exact-source synthetic host preflight with 10/10 checks; its merge and CI do not establish held-out qualification. The public held-out manifest records 40 T2 tasks, ten each across four task classes and four languages; this metadata does not prove private digest re-derivation, author-session independence, effective access controls, custody acceptance, or qualification readiness. No private payloads or validators were accessed for this checkpoint.\n263:**RC and publication:** The published `v1.0.0-rc.1` tag resolves to `cb364c386c42faa53b67e04cacc81d7e01520779`, an ancestor of current `main`, and is not an artifact built from current source. Its published asset digest is `8d7dd32f3d00adb98d4f0ea2c6a484ea8e04fc547b4d78b21b060000eda22b9d`. The next candidate needs a new immutable identity, currently expected to be `v1.0.0-rc.2`, with synchronized version metadata and release notes. Exact-RC artifact/install checks, held-out T2, provider and standalone qualification, T3/T4, cross-runner reproducibility, the five-environment by three-size human terminal matrix, independent RC acceptance, and stable-promotion disposition remain outstanding. Publication authorization is granted but gated on those results. No stable `v1.0.0` tag or release exists.\n274:- The source requirements gate remains a clean-worktree pass on exact integration `7d6673f`; eleven requirements remain deferred to exact-RC qualification as listed in the checkpoint below. Acceptance remains `IN_PROGRESS`; this CI progression does not establish RC readiness or acceptance.\n282:**Acceptance status:** `IN_PROGRESS`\n284:**Release status:** no Nexus v1.0.0 RC or stable publication exists. Publication authorization is granted and remains gated on independent acceptance.\n289:- **Qualification and release:** PR #102 contributes synthetic host-preflight evidence only. Private held-out custody/schema compatibility, T2/T3/T4 qualification, live provider and standalone checks, exact-RC reproducibility, the five-environment by three-size human terminal matrix, and independent RC acceptance remain outstanding. No RC has been constructed, installed, or accepted.\n297:**Acceptance status:** `IN_PROGRESS`\n299:Exact-source CI and requirements enforcement pass on `8f4504e`, but held-out custody and corpus compatibility, installed-RC qualification, independent RC acceptance, and final publication remain incomplete. No v1.0.0 RC or stable release exists. Publication authorization is granted and remains gated on acceptance.\n301:This checkpoint reconciles the candidate ledger and acceptance procedure against recorded source and test evidence. It is not a release approval. Historical inspection sections below are preserved as audit evidence and do not represent current branch state where superseded by the 2026-10-21 update.\n306:- **PR and contest state:** PR #8 remains a draft integration-to-`main` candidate. Its CI and CodeQL checks are green, but it is not a release acceptance or publication. PR #102 is open at `3756afe05dbd75c4e6929d87cd50facbb8ab1748`, based on `8f4504e`, to record a synthetic qualification-host preflight; its CodeQL and TypeScript checks passed and its Node matrix was still running at this checkpoint. The preflight report records 10/10 checks using only an empty synthetic marker store; it does not establish private corpus custody or qualification acceptance. The contest has concluded; no contest freeze applies. Historical contest artifacts remain historical evidence only.\n307:- **Requirements enforcement:** `node scripts/check_requirements.mjs --enforce` passed on exact source tree `8f4504e` (tree `2a0799c8a32e88e34322b712cf937d73cbe4d637`), with isolated `HOME`/XDG: 123 rows (109 tested, 5 partial, 2 implemented, 7 open). Eleven rows remain below the ordinary tested threshold pending their approved exact-RC evidence: `REQ-AGT-002`, `REQ-AGT-010`, `REQ-PRV-003`, `REQ-REL-005`, `REQ-AGT-110`, `REQ-PRV-111`, `REQ-REL-114`, `REQ-QUAL-101`, `REQ-QUAL-107`, `REQ-QUAL-108`, and `REQ-QUAL-109`. The pre-RC checker pass does not imply those RC gates have passed or authorize an acceptance claim.\n308:- **Evaluator and qualification-host boundary:** Source fixtures for cgroup resource limits, process-tree cleanup, workspace storage, and staged Git-history isolation are in the integration source suite and passed its exact-source CI. A synthetic host preflight at source `8f4504e` recorded 10/10 checks and is being documented in PR #102. Neither source fixtures nor the synthetic-host report establish access separation against the custodian's real store or permit held-out execution before custody acceptance.\n309:- **Held-out corpus and custody:** Public T2 manifest `eval/heldout-manifest.json` remains the 40-task identity `50895b84a604fbfd45ed82e29cbef4ba795d7fffbe6611af23bfbc9851f3e89b`; T3 public manifest identity remains `85fb9cafbe18e846bd64fb13eb4bfa0f92df0792bc93d12adaa685e04c9f1383`. Issue [#1](https://github.com/mikeholownych/nexus-code/issues/1) has no custodian response since 2026-10-21 12:21 UTC. Current evaluator qualification rejects the sealed T2 corpus's legacy `hidden.command` format; the documented path requires a custodian-owned compatible immutable successor and repeated custody checks. Private digest re-derivation, exposure history, setup/reference validation, effective access separation, and current custody acceptance remain unverified here. No payload, validator, reference solution, or hidden answer was accessed, and no held-out run has started.\n310:- **Other qualification gates:** No installed-RC provider or standalone matrix, T2/T3/T4 scored qualification, exact-RC cross-runner reproducibility, or independent RC acceptance exists. `ACCEPTANCE.md` §5.3 and `scripts/terminal-acceptance/README.md` define the human five-environment × three-size matrix and evidence capture; all 15 real-terminal cells remain unrun because no RC is installed. Automated PTY results do not replace those operator results.\n311:- **Version, RC, and publication:** Root and CLI package versions remain `0.1.0-alpha.2`. GitHub currently lists only alpha pre-releases `v0.1.0-alpha.1` and `v0.1.0-alpha.2`; no `v1.0.0-rc.N` artifact/tag or stable v1.0.0 tag, npm package, or GitHub release exists. Follow the staged lifecycle in `ACCEPTANCE.md`: pre-RC source gates, RC construction, artifact-bound RC gates, installed-RC qualification and independent G6 acceptance, then stable promotion/publication and post-publication verification.\n321:- **Authoritative integration and CI:** `origin/v1/integration` is `6a16cb60635c9182f13be1635d5f44eddebdcde0`, merge commit for PR #45, whose only changed file was `docs/v1.0.0/READINESS.md`. PR #45 exact-head CI run `39144798481` and CodeQL run `39144798415` passed; independent read-only review accepted exact head `8041c0dbe1a982b2a9e275083f336eb4c5b768b3`. Post-merge CodeQL run `39146982807` passed. Post-merge CI run `39146982849` is in progress on exact `6a16cb6`: Cloudflare and Node 20/22/24 passed; Linux `linux-x86_64` is still executing the CLI suite. This checkpoint does not combine its status with results from another revision.\n322:- **PR and evaluator state:** PRs #9, #13, #15, #16, #44, and #45 are integrated. PR #33 remains open at `0ca77e5ee64f80db02e2b16178c5be551ce5de0c` on stale base `faf95803714a3c543f5c59bc0610ca6291a6184d`. Its exact CI run `39141771002` passed on that old head, but independent review found qualification preflight does not account for host-source mounts created unconditionally by `agentSandboxArgv`. The finding is recorded in comment `6252102243`; a read-only source inventory and shared-mount-plan remediation target are in comment `6252621855`. Owner handoff request `6252543078` has no response as of this checkpoint. The evaluator claim remains protected. Do not execute held-out tasks until this boundary is fixed, exact-head validated, and independently accepted.\n324:- **Held-out custody and qualification:** The custodian previously accepted the sealed 40-task manifest identity `50895b84a604fbfd45ed82e29cbef4ba795d7fffbe6611af23bfbc9851f3e89b` and its private digest/reference validation. This does not establish evaluator acceptance or T2 qualification. The implementing agent has not accessed private payloads. No held-out run has started because evaluator confidentiality preflight remains unaccepted and corpus/evaluator schema compatibility is unresolved.\n325:- **Other qualification and release gates:** Provider/standalone, T3/T4, cross-runner reproducibility, qualification-host validation, and human five-environment × three-size terminal acceptance remain incomplete. Package version remains `0.1.0-alpha.2`; no RC artifact/tag, stable tag, npm publication, or GitHub release exists. Publication authorization remains granted but gated on accepted exact-RC evidence.\n332:- **PR state:** PRs #9, #13, #15, #16, and #44 are integrated. PR #9's stale readiness changes were merged earlier and are retained in history. PR #33 remains open at `0ca77e5ee64f80db02e2b16178c5be551ce5de0c`, based on now-stale `faf9580`; its exact CI run `39141771002` passed all five jobs, including 1,243 CLI tests with zero failures, resource enforcement fixtures, staged Git-history/external-store canaries, security gates, deterministic package/SBOM comparison, and installer/package smoke. Independent review found a release-critical gap: preflight does not compare protected corpus paths with the evaluator's unconditional system mounts such as `/usr/local/lib`. The reviewer requested refusal of protected paths beneath every mounted host path and regression coverage. The evaluator claim remains active; no transfer or remediation checkpoint has been reported. Do not run held-out qualification. PR #33 must incorporate `4bce876`, fix this finding, pass exact-head checks, and receive independent re-review.\n334:- **Evaluator boundary and T2 custody:** PR #33's exact source CI passes resource-bound and Git-history canary fixtures, but the independent unconditional-system-mount finding remains open. Separately, the custodian report accepts the sealed manifest identity `50895b84a604fbfd45ed82e29cbef4ba795d7fffbe6611af23bfbc9851f3e89b`, its custody, author-session provenance, private digest validation, and reference validation; private payloads were not inspected for this checkpoint. The sealed tasks use legacy `hidden: { dir, into, command }` checks, while evaluator qualification requires `blackbox-v1`. Custody acceptance does not resolve this format mismatch or evaluator-boundary acceptance. No T2 qualification has started.\n335:- **Qualification host and terminal:** Qualification-host tooling is integrated through PR #31 (`8c0ab7b`), but this checkpoint has no evidence that the qualification host was provisioned and validated at `4bce876`. Terminal acceptance procedure is integrated; the required human matrix remains unexecuted. It requires five environments × three sizes on the exact installed RC, with per-cell PASS/FAIL and screenshots of the approval panel and post-exit state.\n336:- **Version, RC, and publication:** Package version remains `0.1.0-alpha.2`. PR #44's deterministic package checks are source CI evidence for that alpha package; they do not establish cross-runner RC reproducibility or installed-RC acceptance. No RC artifact, installed-RC provider/standalone, held-out, T3/T4, cross-runner, human-terminal, or independent acceptance evidence exists. The staged lifecycle in `ACCEPTANCE.md` remains authoritative. Publication authorization remains granted and gated; no RC tag, stable tag, npm publication, or GitHub release exists.\n342:- **Authoritative integration and CI:** `origin/v1/integration` is `519398495b7c3a2e5915ed76eee0bb731feb0bcf`. The earlier reported `2c70d39` and `d2c4bfc` are ancestors of this revision; they are not competing integration heads. PR #9 and PR #23 are integrated as `64ee88b` and `886766b`; PR #24's terminal acceptance kit is integrated at `5193984`. Exact-head integration CI run [39120013759](https://github.com/mikeholownych/nexus-code/actions/runs/39120013759) is in progress, so there is no current-head green claim yet. PR #24's checks passed on its exact head `91eaee9` in run [39117464186](https://github.com/mikeholownych/nexus-code/actions/runs/39117464186); its accepted procedure does not replace the human terminal matrix.\n345:- **Qualification host:** PR #22 is still based on `a7126aa` (head `7d30494`); its historical exact-head CI passed, but it is not current-base evidence. The owner confirmed the file split with PR #26 and requested owner approval before running `eval/host/provision.sh`. No host account, sudoers, mount unit, or runtime directory has been provisioned. Resource-limit qualification and held-out execution remain blocked until this host boundary is installed and validated.\n346:- **Held-out T2 custody:** The custodian reported re-derived manifest, 40 task, and 40 private-payload digest matches; isolated author-session audits; and 40/40 reference validation. The public manifest identity is `50895b84a604fbfd45ed82e29cbef4ba795d7fffbe6611af23bfbc9851f3e89b`. At 10:38:44 UTC the custodian recorded moving the store and quarantine to `root:root` mode `0700` (task/reference subdirectories `0500`) without changing contents or manifest identity, and explicitly accepted sealed-manifest custody under this boundary. Coordinator verification was limited to metadata (`stat`, `namei`, and a denied `ls` as uid `mike`); private payloads were not inspected. This is custody evidence, not T2 qualification: held-out execution remains blocked on host provisioning, frozen resources, and an installed RC.\n348:- **T3 and terminal lanes:** PR #27 T3 harness head `12edf74` has independent code review ACCEPT. Its CI run [39119197191](https://github.com/mikeholownych/nexus-code/actions/runs/39119197191) has the contest-contract and Node 20/22/24 jobs successful; `linux-x86_64` remains in progress. The custodian recorded an 8/8-task T3 corpus seal at 10:43:02 UTC, with corrected private manifest digest `dcbd794ed2998423787fdead4957b38b0c4a8a641855d87304d065d01c3fae37` at 10:43:22 UTC, and released both authoring claims. This is sealed, custodian-validated corpus evidence; no T3 qualification run has occurred. PR #24's real-terminal procedure is integrated, but all required five environments × three sizes still require the exact installed RC and genuine operator evidence; no matrix cell is claimed complete.\n349:- **RC and publication:** Package version remains `0.1.0-alpha.2`; PR #8 remains a draft integration-to-main candidate. No RC artifact, exact-RC test, cross-runner RC comparison, installed provider/standalone run, T2/T3/T4 qualification, or independent RC acceptance exists. Final stable publication remains authorized but gated on all mandatory exact-RC acceptance and release checks.\n354:- **Sealed held-out T2 corpus (`heldout-v2`, PR [#16](https://github.com/mikeholownych/nexus-code/pull/16), merged at `f776903`):**\n355:  - Committed public manifest: `eval/heldout-manifest.json` (SHA-256 `50895b84a604fbfd45ed82e29cbef4ba795d7fffbe6611af23bfbc9851f3e89b`), containing 40 external-repository T2 tasks pinned to full 40-hex baseline commits across Go (10), JavaScript (10), Python (10), and Rust (10), and across bugfix (10), debug (10), feature (10), and refactor (10).\n356:  - Custody record: `docs/reviews/evidence/v1/HELDOUT_CUSTODY/custody-report-2026-10-18.md` (updated at `ce3f590`).\n357:  - **Distinction of evidence:** Independent public metadata review (`codex-lead`) verified and accepted the committed manifest digest (`50895b84…`), 40 unique task IDs, 10×4 class/language balance, 40 full pinned commits, and schema/digest fields without inspecting private payloads. Private payload validation (2 rounds per task in bounded `SUITE` windows: fresh clone → checkout → setup → pre-patch regression pass → pre-patch hidden fail → reference patch apply → post-patch hidden pass → post-patch regression pass), rejection/quarantine of one provenance-contaminated batch (`author-b9` at `/home/mike/nexus-heldout-v2-quarantine/b9-contaminated-2026-10-18T0235Z/`), per-session exec-log audits for clean replacement authors (`author-b8c`, `author-b9c`), and store access tightening (`/home/mike/nexus-heldout-v2` mode `0700`, `tasks/` and `reference/` mode `0500` read-only) are custodian-attested in `custody-report-2026-10-18.md`. Earlier author-exposed packages (`v12`, `v15`, `v16`, `v17`, `v18`) recorded in historical sections below are superseded development/pilot artifacts and are never used for held-out qualification.\n361:  - Kernel-enforced resource contract (`91406bd`, PR #19, `eval/resources.mjs`, `eval/cgroup_supervisor.mjs`, `scripts/ensure-ci-user-cgroups.sh`) executes each task phase (setup, candidate sandbox, hidden/regression, oracle) inside a transient delegated `systemd --user` scope with verified cgroup v2 `CPUQuota`, `MemoryMax`, `MemorySwapMax=0`, `TasksMax`, `memory.oom.group=1`, dedicated size-capped tmpfs `workspaceRoot` storage enforcement, and `cgroup.kill` process-tree cleanup verified to `populated == 0`. These controls are source-implemented, independently reviewed, and CI-tested (`1,152/1,152` on `0cee0b7`, run `39104943950`), not live qualification results. Qualification-host provisioning (`nexus-eval` account, narrow sudoers rule, dedicated tmpfs mount, and frozen `config.resources` profile) remains a prerequisite before running held-out T2/T3/T4 workloads.\n362:- **Governance, tokenizer, and acceptance lifecycle reconciliations (PRs [#11](https://github.com/mikeholownych/nexus-code/pull/11)–[#15](https://github.com/mikeholownych/nexus-code/pull/15), [#17](https://github.com/mikeholownych/nexus-code/pull/17)):**\n363:  - `DEC-05` amendment (`f771a3c`, PR #11) and `ACCEPTANCE.md` §6.2 (`77102c5`, PR #13) resolve the historical eight-vs-nine T4 denominator conflict by retaining all **9 fault classes × 5 runs** (including SIGTERM + `run --resume`).\n366:  - `ACCEPTANCE.md` §1.1 (`77102c5`, PR #13) defines the five-stage RC lifecycle binding source gates, workflow-built RC artifact construction, RC artifact gates (`ACC-SUP-01/02/03/06/08`), installed-RC qualification, and version-only stable promotion.\n381:- A four-file follow-up in the PR #10 worktree avoids exposing external launcher paths in packaged doctor evidence and recognizes Node 20 TAP summaries while rejecting zero-test, all-skipped, and cancelled-only summaries. The cancelled-only edge case was found during independent review and fixed before acceptance; the reviewer accepted the corrected parser/test diff. Build succeeded, the focused four-file selection passed **47/47**, staged `git diff --check` passed, and staged Gitleaks found zero findings.\n389:## Historical evidence: Review update (2026-10-17 03:10 UTC; pilot packages superseded by `heldout-v2` above)\n391:This section records the historical inspection at `e1759cae9cf399e2d2586d05bfea3f86b757c412`. The pilot package attempts and their failures remain historical evidence and are not erased; the active sealed held-out corpus is `heldout-v2` (`eval/heldout-manifest.json`, SHA-256 `50895b84…`, PR #16).\n394:- Independent inspection of pilot candidate v17 verified manifest digest `ce44dd2066dc4dec6c5e1f56021e3b442aa293510cbf9f217cf2c2e2256d83fe`, all 227 listed file hashes/sizes, no unlisted package files, 40 parseable tasks, 20 repository/20 fixture tasks, and 80/80 validator-command digest coverage. That author-exposed set was not independently held out or accepted and was retired as development/pilot material when `heldout-v2` was commissioned.\n396:- A separate harmless synthetic canary reproduction against the pre-PR-#10 `runIsolated()` boundary confirmed a material hidden-oracle integrity defect at `e1759ca`: candidate-like code executed by a checker could read and overwrite a hidden file copied into the same writable `/workspace`; its canary appeared in captured output and would be persisted in `hidden.log`. No host escape was demonstrated, and no held-out payload or model candidate was used in that reproduction. (Subsequently remediated at the source level by `blackbox-v1` oracle separation in PR #10 `2c70d39`, workspace history isolation in PR #18 `96aeef2`, and kernel resource isolation in PR #19 `91406bd`.)\n398:## Historical evidence: Security and T2 update (2026-10-17)\n401:- The earlier corpus author supplied pilot overlay v18 at `/tmp/nexus-v1-heldout-author/DEC-05-v1-blackbox-dev-v18` (`SHA256SUMS.json` digest `e830c82c60a7767d4d235cc53764d8298abadc2d22107a5e6ee7ed3664509dd4`), with seven fixture tasks migrated and 33 unmigrated. That overlay remains unsealed historical pilot material and is superseded by the sealed 40-task external-repository corpus `heldout-v2` (`eval/heldout-manifest.json`, PR #16).\n410:- The earlier v12 (`82886448799cb9c63d28a8f5f28b940229b981a51982c49bad80b7f7d2c73092`), v15 (`6f78983cc860a4ed616f5aa5375b8d3fec5b7335ea6bac47a448924dc91af06d`), and v16 T2 pilot packages and their failed Docker validation attempts remain historical evidence only.\n418:- Automated PTY acceptance tests are included in the passing CLI suite. This is not human interaction in each required terminal emulator.\n419:- The source suite includes the T1 evaluator smoke and two-fault T4 smoke. These do not establish the full T2, T3, T4 qualification thresholds.\n425:| `REQ-AGT-002` | partial | Zero false `VERIFIED` across the frozen qualification workloads; source regression tests pass (`1,152/1,152` at `a7126aa`) but no held-out evaluation exists. | T2/T3/T4 RC runs | Qualification operator | Run the preregistered acceptance set on an installed RC and retain per-run evidence; fix and repeat any false `VERIFIED`. |\n429:| `REQ-PRV-003` | implemented | Standalone behavior has scripted tests but no qualifying live standalone evidence (HIST-08). | Installed RC; standalone matrix | Provider qualification operator | Run `ACCEPTANCE.md` §4 for supported server profiles and archive sanitized receipts. |\n431:| `REQ-REL-106` | open (post-v1; manual path defined for v1) | `SPEC-06` marks self-uninstall/prune post-v1 and retains the quickstart manual uninstall as the v1 path. The ledger's open status is a roadmap deferral, not a v1 implementation blocker. | Post-v1 scope; release documentation | Release/documentation owner | Preserve the documented manual uninstall path for v1 and record this item as explicitly deferred in the final release ledger. |\n433:| `REQ-AGT-110` | open | Independent continuity/compaction/truncation acceptance under `ACCEPTANCE.md` §8, including an independent long task with two compactions and kill/resume. | Installed RC and reviewer who did not implement the work | Owner-supplied independent reviewer | After RC freeze, execute the reviewer procedure and archive a per-area verdict; this cannot be self-signed. |\n435:| `REQ-PRV-111` | partial | RC-pinned live provider verification is incomplete. Historical OpenRouter/ChatGPT evidence is not RC evidence; OpenRouter must use a pinned model. OpenAI API-key and Anthropic paths have no configured authorization. | Installed RC; available provider authorization | Provider qualification operator | On the RC, run `providers verify` for OpenRouter with a pinned model and complete one live small §6-style bug-fix task with a correct outcome. Repeat ChatGPT sign-in verification and retain PASS on the RC; keep ChatGPT, OpenAI API-key, and Anthropic experimental unless separately verified. |\n437:| `REQ-QUAL-101` | tested (corpus sealed at `f776903`; live T2 run pending) | The 40-task external-repository T2 corpus (`heldout-v2`) is sealed and committed in `eval/heldout-manifest.json` (SHA-256 `50895b84a604fbfd45ed82e29cbef4ba795d7fffbe6611af23bfbc9851f3e89b`, PR #16 `f776903`, custody record `ce3f590`). Independent metadata review (`codex-lead`) accepted the public manifest structure/digest; private payload validation (40/40, 2 rounds each) and author-isolation audits are custodian-recorded with store permissions `0700`/`0500`. | Qualification-host provisioning, frozen resource config, installed RC, peer calibration | Custodian and qualification operator | Keep `/home/mike/nexus-heldout-v2` restricted from implementation agents; complete qualification-host provisioning and execute the 5-run T2 matrix on the installed RC. |\n438:| `REQ-QUAL-107` | open | No accepted live standalone/proxy matrix or RC-pinned provider verification. | RC, qualifying held-out subset, provider access, serial gateway window | Qualification operator | Execute `ACCEPTANCE.md` §4 through the approved stripped proxy and collect E5 provider verification receipts on the installed RC. |\n440:| `REQ-QUAL-103` | tested as harness control | Five-run pair validation and peer configuration forwarding are tested; no live matched T2 results exist. | Sealed T2 set, RC, peers on same model | Qualification operator | Run five serial repetitions for each task/configuration for Nexus, Goose and OpenCode; retain original and replacement records and paired score inputs. |\n441:| `REQ-QUAL-104` | tested as scorer control | The separate metrics and scorer are tested; threshold outcomes and zero-false-`VERIFIED` have not been measured on qualification workloads. | Completed T2/T3/T4 evidence | Qualification operator | Score every preregistered metric separately and apply the fixed thresholds and confidence intervals; any false `VERIFIED` fails the hard gate. |\n442:| `REQ-QUAL-105` | tested as injector/smoke (`DEC-05` 9-class count resolved) | `DEC-05` amendment (`f771a3c`) and `ACCEPTANCE.md` §6.2 (`77102c5`) resolve the scenario count to **9 fault classes × 5 runs** (retaining SIGTERM + `run --resume`). Injector and two-fault smoke pass in CI; full 9×5 RC evidence is pending M5 execution. | Installed RC and gateway window | Qualification operator | Execute and score all 9 fault classes × 5 runs against the installed RC. |\n444:| `REQ-QUAL-108` | partial | Automated PTY suite passes on `a7126aa`; the human matrix is absent for xterm, kitty (keyboard protocol enabled), tmux 3.x inside GNOME Terminal, VS Code terminal and GNOME Terminal at 80×24, 40×14 and 200×60. | Human terminal access and RC install | Human acceptance operator | Execute the `ACCEPTANCE.md` §5.3 manual matrix on the installed RC across all required terminal×size cells and archive screenshots and verdicts. |\n445:| `REQ-QUAL-109` | open | No T3 evidence for 8 tasks × 5 runs, each ≥60 steps with ≥2 compactions and steering; thresholds are false-absence 0 and steering ≥95%. | Frozen T3 workload, RC, gateway capacity | Qualification operator | Freeze/register T3 tasks before execution, then run all repetitions and score using the accepted rules. |\n447:At `a7126aa`, `node scripts/check_requirements.mjs` passes in report mode: **121 rows; 107 tested, 5 partial, 2 implemented, 7 open**. In `--enforce` mode (the G6 release gate), the checker remains fail-closed until the remaining blocker and release-required rows above reach their required post-qualification states.\n456:| G3 continuity/inference/verification/eval | Source suite, T1 self-test, T4 smoke, `blackbox-v1` oracle isolation, repo history isolation, cgroup v2 resource contract, and sealed 40-task T2 manifest (`50895b84…`) are integrated. `PLAN-04 PR-4g` (continuity M1/M3/L5) and qualification-host provisioning (`PLAN-10 QUAL-HOST` / `PR-10j`) are in flight. | Partial; live T2/T3/full T4 and standalone/provider matrices pending Stage 4 installed-RC execution. |\n457:| G4 persistence | Source persistence and retention tests pass in CI (`39108774170`). | Source gate green; independent RC acceptance (§8) pending Stage 4. |\n459:## Release and qualification sequence (`ACCEPTANCE.md` §1.1)\n461:1. **Close remaining source & host prerequisites on `v1/integration`:** Land and independently review `PLAN-04 PR-4g` (Continuity M1/M3/L5), `PLAN-10 PR-10j` (dedicated-tmpfs storage preflight & canary), and `PLAN-10 QUAL-HOST` (qualification-host provisioning bundle and frozen resource profile); update the stale `ACCEPTANCE.md` §1.1 sentence now that PR #21 (`a7126aa`) implements draft-then-publish for stable tags.\n465:5. **Stage 4 — Installed-RC qualification:** Install the workflow-produced `v1.0.0-rc.1` package via the documented installer and execute `ACCEPTANCE.md` §§4–8 (standalone/provider matrix, CI/scripted/manual terminal matrix, T2 40×5 held-out comparison, T4 9×5 fault matrix, T3 8×5 long-task matrix, install matrix, SPEC-09 §3.2 docs checklist, and §8 independent acceptance). Archive all evidence under `docs/reviews/evidence/v1-qualification/v1.0.0-rc.1/`.\n472:- **Campaign:** `NEXUS_V1_RC_QUALIFICATION_ACTIVE`. **Acceptance:** `IN_PROGRESS`. RC5 is a public prerelease; neither an accepted RC nor stable v1.0.0 is claimed.\n481:- E2 is **partial**: all eight fresh-install/minimum-runtime cells and eight expected negative preflight cells passed across the prepared Ubuntu 22.04/24.04, Debian 12 and Fedora 40 images. One Ubuntu 22.04 / Node 22 lifecycle cell passed alpha.2 upgrade, repair, rollback and uninstall. The remaining lifecycle cases are not complete. Current-source evaluator host preflight passed 10/10 using synthetic markers only; this is not held-out custody or qualification evidence.\n482:- Ubuntu/GNOME is reachable and has all five required terminal applications, but `gh auth status` there reports no GitHub login. The RC5 installer stopped before creating files; the version-scoped desktop install prefix is absent. The manual terminal matrix is **0/15**.\n484:### Provider, PTY and reproducibility evidence\n494:| T2/T3 held-out custody | Blocked. Issue #1 has no custodian reply; the public 40-task manifest does not establish private custody acceptance, and the legacy validator contract is incompatible with the current evaluator. No private payload was accessed or run. | Independent custodian confirms author/handoff, compatible immutable corpus or successor, validation, access separation, digests and custody acceptance; only then prepare and execute the approved runs. |\n495:| Evaluator resource/secret boundary | Synthetic current-source host preflight 10/10; no accepted qualification-host/custody result. | Complete independent host and custody acceptance before any held-out execution. |\n496:| Standalone profiles | Not run on the installed RC; T2 subset dependency remains unmet. | After custody and frozen configuration, execute §4.2 profiles and archive exact-artifact receipts. |\n497:| T4 and long-task T3 | Not run. T4 remains nine fault classes × five runs; T3 remains eight tasks × five runs. | Freeze approved workload/configurations and prerequisites, then run exact RC serially with independent scoring. |\n499:| Human terminal matrix (§5.3) | 0/15. No screenshots or per-cell operator verdicts. | Install exact RC on the desktop after GitHub CLI authentication; complete all five terminals × three sizes with two distinct screenshots per cell. |\n501:| Independent RC acceptance | Not performed. | Independent reviewer evaluates the exact candidate and all mandatory evidence after qualification gates pass. |\n504:Public metadata updates were added to issues [#3](https://github.com/mikeholownych/nexus-code/issues/3) and [#5](https://github.com/mikeholownych/nexus-code/issues/5). Publication authority remains granted but gated by acceptance; no additional authorization is requested here.\n\n--- published RCs ---\nv1.0.0-rc.10\tPre-release\tv1.0.0-rc.10\t2026-10-27T00:29:58Z\nv1.0.0-rc.9\tPre-release\tv1.0.0-rc.9\t2026-10-26T17:56:16Z\nv1.0.0-rc.8\tPre-release\tv1.0.0-rc.8\t2026-10-26T07:26:22Z\nv1.0.0-rc.7\tPre-release\tv1.0.0-rc.7\t2026-10-26T00:07:06Z\nv1.0.0-rc.6\tPre-release\tv1.0.0-rc.6\t2026-10-25T17:25:56Z\nv1.0.0-rc.5\tPre-release\tv1.0.0-rc.5\t2026-10-25T12:58:55Z\nv1.0.0-rc.4\tPre-release\tv1.0.0-rc.4\t2026-10-24T11:54:37Z\nv1.0.0-rc.3\tPre-release\tv1.0.0-rc.3\t2026-10-23T09:06:11Z\n","exit_code":0,"duration":{"secs":0,"nanos":463008761}},"started_at_ms":1793066159383,"completed_at_ms":1793066159847}}
