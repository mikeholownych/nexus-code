op = \"NONE\";\n5168:      let finalOutputComplete = false;\n5219:      while (modelStop === \"NONE\" && !interruption && !inferenceFailure && !persistenceFailure) {\n5643:                content: `[Nexus: your reply was empty: no text and no tool call. It does not finish the task. This is ${stepPosition(currentStep, maxTotalSteps)}. Continue the task where you left off; call task_completed when it is done.]`,\n5668:          modelStop = \"FINAL_TEXT\";\n5669:          finalOutputComplete = replied;\n5771:            modelStop = \"TASK_COMPLETED_TOOL\";\n5772:            finalOutputComplete = true;\n5779:        if (signal.aborted && modelStop === \"NONE\") {\n5784:        if (modelStop === \"TASK_COMPLETED_TOOL\" && this.hasQueuedSteering()) {\n5785:          modelStop = \"NONE\";\n5786:          finalOutputComplete = false;\n5813:      const limitReached = !interruption && !inferenceFailure && !capacityBlock && !persistenceFailure && modelStop === \"NONE\" && stopReason !== undefined;\n5816:        modelStop,\n5817:        finalOutputComplete,\n5885:        modelStop: \"NONE\" as const,\n5886:        finalOutputComplete: false,\n5953:    modelStop: ModelStop;\n5954:    finalOutputComplete: boolean;\n5989:      modelStop: input.modelStop,\n5990:      finalOutputComplete: input.finalOutputComplete,\n6005:        ...base, execution: \"INTERRUPTED\", outcome: \"NOT_ESTABLISHED\", reason: \"OPERATOR_INTERRUPT\", finalOutputComplete: false,\n6010:        ...base, execution: \"FAILED\", outcome: \"NOT_ESTABLISHED\", reason: \"UNHANDLED_ERROR\", detail: input.unhandledError.slice(0, 300), finalOutputComplete: false,\n6015:        ...base, execution: \"FAILED\", outcome: \"NOT_ESTABLISHED\", reason: \"PERSISTENCE_FAILED\", detail: input.persistenceFailure.slice(0, 300), finalOutputComplete: false,\n6025:        ...base, execution: \"FAILED\", outcome: \"NOT_ESTABLISHED\", reason: \"INFERENCE_FAILED\",\n6027:        finalOutputComplete: false,\n6033:        ...base, execution: \"BLOCKED\", outcome: \"NOT_ESTABLISHED\", reason: \"CONTEXT_CAPACITY_EXCEEDED\",\n6035:        finalOutputComplete: false, capacity: c,\n6040:        ...base, execution: \"LIMIT_REACHED\", outcome: \"NOT_ESTABLISHED\", reason: input.stopReason ?? \"STEP_LIMIT_REACHED\",\n6041:        ...(input.stopDetail ? { detail: input.stopDetail } : {}), finalOutputComplete: false,\n6065:        return deepFreezeTurn(assertTurnResultInvariants({ ...base, execution: \"COMPLETED\", outcome: \"NOT_ESTABLISHED\", reason: \"VERIFIER_FAILED\", detail: evidence.command }));\n6068:        return deepFreezeTurn(assertTurnResultInvariants({ ...base, execution: \"COMPLETED\", outcome: \"NOT_ESTABLISHED\", reason: \"VERIFIER_TIMED_OUT\", detail: `${evidence.command} (deadline ${evidence.deadlineSecs}s)` }));\n6071:        return deepFreezeTurn(assertTurnResultInvariants({ ...base, execution: \"COMPLETED\", outcome: \"NOT_ESTABLISHED\", reason: \"REQUIREMENTS_INCOMPLETE\", detail: incompleteDetail() }));\n6109:      return deepFreezeTurn(assertTurnResultInvariants({ ...base, execution: \"COMPLETED\", outcome: \"NOT_ESTABLISHED\", reason: \"REQUIREMENTS_INCOMPLETE\", detail: incompleteDetail() }));\n6153:        ...base, execution: \"COMPLETED\", outcome: \"NOT_ESTABLISHED\",\n6154:        reason: evidence.status === \"FAILED\" ? \"VERIFIER_FAILED\" : \"VERIFIER_TIMED_OUT\", detail: evidence.command,\n6158:    // without task_completed, or a dry-run or read-only turn, which never runs it) is not verified.\n6250:              ...last, outcome: \"NOT_ESTABLISHED\", reason: \"VERIFIER_FAILED\", detail: `TDD workflow: ${tdd.summary}`, verification: last.verification,\n6295:   * cancelled. Completed only when the subagent called task_completed or delivered a final report; inference failure,\n6312:      content: `[Subagent Objective]: ${prompt}\\n\\nPlease inspect, execute tools as needed, and produce a concise, comprehensive report answering the objective. Call task_completed when done.`,\n6462:  private subagentResult(modelStop: ModelStop, summary: string, stepsUsed: number): SubagentResult {\n6463:    const turn = this.buildTurnResult({ modelStop, finalOutputComplete: true, inferenceFailure: null, interruption: null, limitReached: false, stepsUsed });\n332:    console.log(pc.dim(\"Describe the outcome you want. Nexus will show meaningful activity and keep full evidence in the session.\"));\n8: *   outcome     - what Nexus can *demonstrate* about the engineering result\n12: * reinterpret it. VERIFIED can only be produced from verifier evidence, never asserted.\n18: * VERIFIED        - the verifier selected for this workspace ran and passed against the current changes\n19: * UNVERIFIED      - work ended with a result that was not (or could not be) verified; see reason. Either changes\n22: * NOT_ESTABLISHED - no engineering result was established (turn did not complete, or verifier failed)\n25:export type EngineeringOutcome = \"VERIFIED\" | \"REGRESSION_FREE\" | \"UNVERIFIED\" | \"NOT_ESTABLISHED\" | \"NOT_REQUIRED\";\n156: * the rest are final. Created only when a submission fails.\n195:   * passed before, check it — the turn is then REGRESSION_FREE, not VERIFIED.\n239:  outcome: EngineeringOutcome;\n244:  /** True only if the final model response was received completely (positive protocol evidence). */\n245:  finalOutputComplete: boolean;\n301:   * Tool outputs that left the context during the turn and were not read again, when the turn still ended VERIFIED or\n325:  if (t.outcome === \"VERIFIED\") {\n326:    if (t.execution !== \"COMPLETED\") throw new TurnResultInvariantError(\"VERIFIED requires execution COMPLETED\");\n329:      throw new TurnResultInvariantError(\"VERIFIED requires passing verifier evidence\");\n331:    if (t.unverifiedChangesPending) throw new TurnResultInvariantError(\"VERIFIED conflicts with pending unverified changes\");\n333:  if (t.outcome === \"REGRESSION_FREE\") {\n340:  if (t.outcome === \"NOT_REQUIRED\" && (t.execution !== \"COMPLETED\" || t.unverifiedChangesPending)) {\n344:  if (t.execution === \"INTERRUPTED\" && t.outcome !== \"NOT_ESTABLISHED\") {\n345:    throw new TurnResultInvariantError(\"INTERRUPTED must not claim an engineering outcome\");\n347:  if (t.execution === \"BLOCKED\" && t.outcome !== \"NOT_ESTABLISHED\") {\n348:    throw new TurnResultInvariantError(\"BLOCKED must not claim an engineering outcome\");\n350:  if (t.execution === \"FAILED\" && t.outcome !== \"NOT_ESTABLISHED\") {\n351:    throw new TurnResultInvariantError(\"FAILED must not claim an engineering outcome\");\n367:    if (t.outcome === \"VERIFIED\" || t.outcome === \"NOT_REQUIRED\") return 0;\n368:    if (t.outcome === \"REGRESSION_FREE\" || t.outcome === \"UNVERIFIED\") return 2;\n398:    return { heading: \"TURN INTERRUPTED\", line: `execution=INTERRUPTED outcome=NOT_ESTABLISHED${extra}; ${i?.undispatchedToolCalls ?? 0} tool call(s) not dispatched` };\n400:  if (exec === \"FAILED\") return { heading: \"TURN FAILED\", line: `execution=FAILED outcome=NOT_ESTABLISHED${tail}` };\n407:        line: `execution=BLOCKED outcome=NOT_ESTABLISHED (CONTEXT_CAPACITY_EXCEEDED: ${c.unmeasured}). No request was sent. Strict token counting is on (--strict-token-count / NEXUS_STRICT_TOKEN_COUNT=1); turn it off to proceed on the labelled estimate.`,\n412:      line: `execution=BLOCKED outcome=NOT_ESTABLISHED (CONTEXT_CAPACITY_EXCEEDED: ${c.estimatedPromptTokens} prompt${c.promptCountSource ? ` (${c.promptCountSource})` : \"\"} + ${c.completionReserveTokens} completion + ${c.toolResponseReserveTokens} tool reserve > ${c.contextLimit} limit). ` +\n417:  if (exec === \"BLOCKED\") return { heading: \"TURN BLOCKED\", line: `execution=BLOCKED outcome=NOT_ESTABLISHED${tail}` };\n422:      return { heading: \"STOPPED - NO PROGRESS\", line: `execution=LIMIT_REACHED outcome=NOT_ESTABLISHED (STAGNATION_DETECTED${t.detail ? `: ${t.detail}` : \"\"}; ${t.steps.used} steps${segments})` };\n425:      return { heading: \"TIME BUDGET EXHAUSTED\", line: `execution=LIMIT_REACHED outcome=NOT_ESTABLISHED (TIME_BUDGET_EXHAUSTED${t.detail ? `: ${t.detail}` : \"\"}; ${t.steps.used} steps${segments})` };\n428:      return { heading: \"STEP BUDGET EXHAUSTED\", line: `execution=LIMIT_REACHED outcome=NOT_ESTABLISHED (${t.steps.used}/${t.steps.max} steps${segments}; raise --max-total-steps to allow more)` };\n430:    return { heading: \"STEP LIMIT REACHED\", line: `execution=LIMIT_REACHED outcome=NOT_ESTABLISHED (${t.steps.used}/${t.steps.max} steps)` };\n432:  switch (t.outcome) {\n433:    case \"VERIFIED\":\n434:      return { heading: \"TASK COMPLETED - VERIFIED\", line: `execution=COMPLETED outcome=VERIFIED (${t.verification?.command})${contextTail(t)}` };\n436:      return { heading: \"TASK COMPLETED - REGRESSION FREE\", line: `execution=COMPLETED outcome=REGRESSION_FREE (${t.verification?.command})${tail}${contextTail(t)}` };\n438:      return { heading: \"TURN ENDED - NO CHANGES TO VERIFY\", line: `execution=COMPLETED outcome=NOT_REQUIRED modelStop=${t.modelStop}` };\n439:    case \"UNVERIFIED\":\n440:      return { heading: \"TURN ENDED - UNVERIFIED\", line: `execution=COMPLETED outcome=UNVERIFIED${tail}` };\n443:        return { heading: \"TURN ENDED - REQUIREMENTS OPEN\", line: `execution=COMPLETED outcome=NOT_ESTABLISHED${tail}` };\n445:      return { heading: \"TURN ENDED - NOT ESTABLISHED\", line: `execution=COMPLETED outcome=NOT_ESTABLISHED${tail}` };\n454:    outcome: \"NOT_ESTABLISHED\",\n459:    finalOutputComplete: false,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a178fa-f0ed-7ab3-bb71-477460bd1a0a","create_time":1793040088.9991596}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
