gins_dirs.test.ts::\\\\\\\"ACC-TRUST-06: plugin directories (REQ-SEC-115)\\\\\\\") | tested | ACC-TRUST-06 | *\n... command output truncated for persistence ...\n: \\\\\\\"function\\\\\\\", function: { name: \\\\\\\"write_file\\\\\\\", arguments: JSON.stringify({ path: `${scenario.name}.txt`, content: `${scenario.name}\\\\\\\\n` }) } },\\\\n  960 |             { index: 1, id: \\\\\\\"complete\\\\\\\", type: \\\\\\\"function\\\\\\\", function: { name: \\\\\\\"task_completed\\\\\\\", arguments: JSON.stringify({ summary: `${scenario.name} verifier scenario.` }) } },\\\\n  961 |           ] : [];\\\\n  962 |           res.writeHead(200, { \\\\\\\"Content-Type\\\\\\\": \\\\\\\"text/event-stream\\\\\\\" });\\\\n  963 |           res.end(`data: ${JSON.stringify({ choices: [{ delta: { content: \\\\\\\"Finish task.\\\\\\\", tool_calls: calls } }] })}\\\\\\\\n\\\\\\\\ndata: [DONE]\\\\\\\\n\\\\\\\\n`);\\\\n  964 |         });\\\\n  965 |       });\\\\n  966 |       let agent: AutonomousAgent | undefined;\\\\n  967 |       try {\\\\n  968 |         const port = await new Promise<number>((resolve) => server.listen(0, \\\\\\\"127.0.0.1\\\\\\\", () => resolve((server.address() as any).port)));\\\\n  969 |         agent = new AutonomousAgent({ endpoint: `http://127.0.0.1:${port}/v1`, model: \\\\\\\"test\\\\\\\", maxSteps: 2, temperature: 0, workspace: repo, shell: \\\\\\\"bash\\\\\\\", worktree: true, authoritativeVerifierCommand: scenario.command } as any);\\\\n  970 |         if (scenario.throws) {\\\\n  971 |           const originalSetWorkspace = agent.setWorkspace.bind(agent);\\\\n  972 |           (agent as any).setWorkspace = (workspace: string) => {\\\\n  973 |             originalSetWorkspace(workspace);\\\\n  974 |             const bridge = (agent as any).bridge;\\\\n  975 |             const executeTool = bridge.executeTool.bind(bridge);\\\\n  976 |             bridge.executeTool = async (name: string, args: any) => {\\\\n  977 |               if (name === \\\\\\\"run_command\\\\\\\" && args.command === scenario.command) throw new Error(\\\\\\\"injected verifier exception\\\\\\\");\\\\n  978 |               return executeTool(name, args);\\\\n  979 |             };\\\\n  980 |           };\\\\n  981 |         }\\\\n  982 |         await agent.run(`exercise ${scenario.name} authoritative verifier`);\\\\n  983 |         const active = agent.getActiveWorktree();\\\\n  984 |         assert.strictEqual((agent as any).verifiedWorktreeCompletion, scenario.expectedVerified);\\\\n  985 |         if (scenario.expectedVerified) {\\\\n  986 |           assert.strictEqual(active, undefined);\\\\n  987 |           assert.strictEqual(fs.existsSync(path.join(repo, `${scenario.name}.txt`)), true);\\\\n  988 |         } else {\\\\n  989 |           assert.ok(active, `${scenario.name} verifier must retain worktree`);\\\\n  990 |           assert.strictEqual(fs.existsSync(path.join(repo, `${scenario.name}.txt`)), false);\\\\n  991 |           assert.strictEqual(fs.existsSync(path.join(active!.worktreePath, `${scenario.name}.txt`)), true);\\\\n  992 |           assert.strictEqual(agent.discardActiveWorktree().success, true);\\\\n  993 |         }\\\\n  994 |         assert.strictEqual(requests, scenario.expectedVerified ? 1 : 2);\\\\n  995 |       } finally {\\\\n  996 |         agent?.shutdown();\\\\n  997 |         server.closeAllConnections();\\\\n  998 |         await new Promise<void>((resolve) => server.close(() => resolve()));\\\\n  999 |         fs.rmSync(repo, { recursive: true, force: true });\\\\n 1000 |       }\\\\n 1001 |     }\\\\n 1002 |   });\\\\n 1003 | \\\\n 1004 |   test(\\\\\\\"SecurityManager enforces default blocked commands and protected paths\\\\\\\", () => {\\\\n 1005 |     const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), \\\\\\\"nexus_sec_test_\\\\\\\"));\\\\n 1006 |     try {\\\\n 1007 |       const sm = new SecurityManager(tmpDir);\\\\n 1008 |       assert.strictEqual(sm.isCommandBlocked(\\\\\\\"rm -rf /\\\\\\\").blocked, true);\\\\n 1009 |       assert.strictEqual(sm.isCommandBlocked(\\\\\\\"rm -rf /*\\\\\\\").blocked, true);\\\\n 1010 |       assert.strictEqual(sm.isCommandBlocked(\\\\\\\"shutdown -h now\\\\\\\").blocked, true);\\\\n 1011 |       assert.strictEqual(sm.isCommandBlocked(\\\\\\\"git status\\\\\\\").blocked, false);\\\\n 1012 | \\\\n 1013 |       assert.strictEqual(sm.isPathProtected(\\\\\\\".git\\\\\\\").protected, true);\\\\n 1014 |       assert.strictEqual(sm.isPathProtected(\\\\\\\".git/config\\\\\\\").protected, true);\\\\n 1015 |       assert.strictEqual(sm.isPathProtected(\\\\\\\".env\\\\\\\").protected, true);\\\\n 1016 |       assert.strictEqual(sm.isPathProtected(\\\\\\\"src/index.ts\\\\\\\").protected, false);\\\\n 1017 |     } finally {\\\\n 1018 |       fs.rmSync(tmpDir, { recursive: true, force: true });\\\\n 1019 |     }\\\\n 1020 |   });\\\\n 1021 | \\\\n 1022 |   test(\\\\\\\"SecurityManager loads custom .nexus-security.json policy\\\\\\\", () => {\\\\n 1023 |     const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), \\\\\\\"nexus_sec_custom_\\\\\\\"));\\\\n 1024 |     try {\\\\n 1025 |       const customPolicy = {\\\\n 1026 |         blockedCommands: [\\\\\\\"curl evil.com\\\\\\\", \\\\\\\"npm publish\\\\\\\"],\\\\n 1027 |         protectedPaths: [\\\\\\\"config/secrets.json\\\\\\\", \\\\\\\"private\\\\\\\"],\\\\n 1028 |         allowedDomains: [\\\\\\\"api.github.com\\\\\\\", \\\\\\\"crates.io\\\\\\\"],\\\\n 1029 |       };\\\\n 1030 |       fs.writeFileSync(path.join(tmpDir, \\\\\\\".nexus-security.json\\\\\\\"), JSON.stringify(customPolicy));\\\\n 1031 | \\\\n 1032 |       const sm = new SecurityManager(tmpDir);\\\\n 1033 |       assert.strictEqual(sm.isCommandBlocked(\\\\\\\"curl evil.com\\\\\\\").blocked, true);\\\\n 1034 |       assert.strictEqual(sm.isCommandBlocked(\\\\\\\"npm publish\\\\\\\").blocked, true);\\\\n 1035 |       assert.strictEqual(sm.isPathProtected(\\\\\\\"config/secrets.json\\\\\\\").protected, true);\\\\n 1036 |       assert.strictEqual(sm.isPathProtected(\\\\\\\"private/key.pem\\\\\\\").protected, true);\\\\n 1037 |       assert.deepStrictEqual(sm.getPolicy().allowedDomains, [\\\\\\\"api.github.com\\\\\\\", \\\\\\\"crates.io\\\\\\\"]);\\\\n 1038 |     } finally {\\\\n 1039 |       fs.rmSync(tmpDir, { recursive: true, force: true });\\\\n 1040 |     }\\\\n 1041 |   });\\\\n 1042 | \\\\n 1043 |   test(\\\\\\\"RustCoreBridge dry-run mode intercepts mutations without modifying disk\\\\\\\", async () => {\\\\n 1044 |     const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), \\\\\\\"nexus_dryrun_test_\\\\\\\"));\\\\n 1045 |     const { RustCoreBridge } = await import(\\\\\\\"../src/tools.js\\\\\\\");\\\\n 1046 |     const bridge = new RustCoreBridge(tmpDir, \\\\\\\"bash\\\\\\\", undefined, true, false);\\\\n 1047 |     try {\\\\n 1048 |       // 1. write_file simulation\\\\n 1049 |       const resWrite = await bridge.executeTool(\\\\\\\"write_file\\\\\\\", {\\\\n 1050 |         path: \\\\\\\"simulated.txt\\\\\\\",\\\\n 1051 |         content: \\\\\\\"Hello Dry Run!\\\\\\\",\\\\n 1052 |       });\\\\n 1053 |       assert.strictEqual(resWrite.success, true);\\\\n 1054 |       const parsedWrite = JSON.parse(resWrite.output);\\\\n 1055 |       assert.strictEqual(parsedWrite.dry_run, true);\\\\n 1056 |       assert.strictEqual(fs.existsSync(path.join(tmpDir, \\\\\\\"simulated.txt\\\\\\\")), false);\\\\n 1057 | \\\\n 1058 |       // 2. mutating command simulation\\\\n 1059 |       const resCmd = await bridge.executeTool(\\\\\\\"run_command\\\\\\\", {\\\\n 1060 |         command: \\\\\\\"touch dummy_file.txt\\\\\\\",\\\\n 1061 |       });\\\\n 1062 |       assert.strictEqual(resCmd.success, true);\\\\n 1063 |       assert.ok(resCmd.output.includes(\\\\\\\"DRY-RUN SIMULATION\\\\\\\"));\\\\n 1064 |       assert.strictEqual(fs.existsSync(path.join(tmpDir, \\\\\\\"dummy_file.txt\\\\\\\")), false);\\\\n 1065 | \\\\n 1066 |       // 3. safe command allowed in dry-run\\\\n 1067 |       const resSafe = await bridge.executeTool(\\\\\\\"run_command\\\\\\\", {\\\\n 1068 |         command: \\\\\\\"echo 'safe probe'\\\\\\\",\\\\n 1069 |       });\\\\n 1070 |       assert.strictEqual(resSafe.success, true);\\\\n 1071 |       assert.ok(resSafe.output.includes(\\\\\\\"safe probe\\\\\\\"));\\\\n 1072 |     } finally {\\\\n 1073 |       bridge.shutdown();\\\\n 1074 |       fs.rmSync(tmpDir, { recursive: true, force: true });\\\\n 1075 |     }\\\\n 1076 |   });\\\\n 1077 | \\\\n 1078 |   test(\\\\\\\"RustCoreBridge read-only mode blocks file edits and non-safe commands\\\\\\\", async () => {\\\\n 1079 |     const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), \\\\\\\"nexus_readonly_test_\\\\\\\"));\\\\n 1080 |     const { RustCoreBridge } = await import(\\\\\\\"../src/tools.js\\\\\\\");\\\\n 1081 |     const bridge = new RustCoreBridge(tmpDir, \\\\\\\"bash\\\\\\\", undefined, false, true);\\\\n 1082 |     try {\\\\n 1083 |       const resWrite = await bridge.executeTool(\\\\\\\"write_file\\\\\\\", {\\\\n 1084 |         path: \\\\\\\"blocked.txt\\\\\\\",\\\\n 1085 |         content: \\\\\\\"Should fail\\\\\\\",\\\\n 1086 |       });\\\\n 1087 |       assert.strictEqual(resWrite.success, false);\\\\n 1088 |       assert.ok(resWrite.error?.includes(\\\\\\\"Read-only mode violation\\\\\\\"));\\\\n 1089 | \\\\n 1090 |       const resCmd = await bridge.executeTool(\\\\\\\"run_command\\\\\\\", {\\\\n 1091 |         command: \\\\\\\"rm -f something.txt\\\\\\\",\\\\n 1092 |       });\\\\n 1093 |       assert.strictEqual(resCmd.success, false);\\\\n 1094 |       assert.ok(resCmd.error?.includes(\\\\\\\"Read-only mode violation\\\\\\\"));\\\\n 1095 | \\\\n 1096 |       const mutatedPaths: string[] = [];\\\\n 1097 |       for (const [command, target] of [\\\\n 1098 |         [\\\\\\\"echo payload > echo-redirection.txt\\\\\\\", \\\\\\\"echo-redirection.txt\\\\\\\"],\\\\n 1099 |         [\\\\\\\"ls .; echo payload > compound-redirection.txt\\\\\\\", \\\\\\\"compound-redirection.txt\\\\\\\"],\\\\n 1100 |         [\\\\\\\"cat /etc/hosts > cat-redirection.txt\\\\\\\", \\\\\\\"cat-redirection.txt\\\\\\\"],\\\\n 1101 |         [\\\\\\\"echo payload | tee tee-redirection.txt\\\\\\\", \\\\\\\"tee-redirection.txt\\\\\\\"],\\\\n 1102 |         [\\\\\\\"git status && echo payload > chained-redirection.txt\\\\\\\", \\\\\\\"chained-redirection.txt\\\\\\\"],\\\\n 1103 |       ]) {\\\\n 1104 |         await bridge.executeTool(\\\\\\\"run_command\\\\\\\", { command });\\\\n 1105 |         if (fs.existsSync(path.join(tmpDir, target))) mutatedPaths.push(target);\\\\n 1106 |       }\\\\n 1107 |       assert.deepStrictEqual(mutatedPaths, [], \\\\\\\"read-only shell cannot mutate through redirection or compound syntax\\\\\\\");\\\\n 1108 |     } finally {\\\\n 1109 |       bridge.shutdown();\\\\n 1110 |       fs.rmSync(tmpDir, { recursive: true, force: true });\\\\n 1111 |     }\\\\n 1112 |   });\\\\n 1113 | \\\\n 1114 |   test(\\\\\\\"RustCoreBridge fails closed when an isolated worktree shell loses its sandbox\\\\\\\", async () => {\\\\n 1115 |     const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), \\\\\\\"nexus_required_sandbox_\\\\\\\"));\\\\n 1116 |     const { RustCoreBridge } = await import(\\\\\\\"../src/tools.js\\\\\\\");\\\\n 1117 |     const bridge = new RustCoreBridge(tmpDir, \\\\\\\"bash\\\\\\\", undefined, false, false, \\\\\\\"none\\\\\\\", true);\\\\n 1118 |     try {\\\\n 1119 |       const result = await bridge.executeTool(\\\\\\\"run_command\\\\\\\", { command: \\\\\\\"echo escaped > fallback-mutation.txt\\\\\\\" });\\\\n 1120 |       assert.strictEqual(result.success, false);\\\\n 1121 |       assert.ok(result.error?.includes(\\\\\\\"Worktree isolation violation\\\\\\\"));\\\\n 1122 |       assert.strictEqual(fs.existsSync(path.join(tmpDir, \\\\\\\"fallback-mutation.txt\\\\\\\")), false);\\\\n 1123 |     } finally {\\\\n 1124 |       bridge.shutdown();\\\\n 1125 |       fs.rmSync(tmpDir, { recursive: true, force: true });\\\\n 1126 |     }\\\\n 1127 |   });\\\\n 1128 | \\\\n 1129 |   test(\\\\\\\"run_tests keeps repository test side effects inside worktree authority and honors read-only, dry-run, and required sandbox\\\\\\\", async () => {\\\\n 1130 |     const base = fs.mkdtempSync(path.join(os.tmpdir(), \\\\\\\"nexus-run-tests-authority-\\\\\\\"));\\\\n 1131 |     const repo = path.join(base, \\\\\\\"repo\\\\\\\");\\\\n 1132 |     fs.mkdirSync(repo);\\\\n 1133 |     const rootTarget = path.join(repo, \\\\\\\"test-wrote-root.txt\\\\\\\");\\\\n 1134 |     const outsideTarget = path.join(base, \\\\\\\"test-wrote-outside.txt\\\\\\\");\\\\n 1135 |     fs.writeFileSync(path.join(repo, \\\\\\\"Makefile\\\\\\\"), [\\\\n 1136 |       \\\\\\\"test:\\\\\\\",\\\\n 1137 |       `\\\\\\\\t@mkdir -p generated; printf worktree > generated/test-output.txt 2>/dev/null; printf root > ${JSON.stringify(rootTarget)} 2>/dev/null; printf outside > ${JSON.stringify(outsideTarget)} 2>/dev/null; true`,\\\\n 1138 |       \\\\\\\"\\\\\\\",\\\\n 1139 |     ].join(\\\\\\\"\\\\\\\\n\\\\\\\"));\\\\n 1140 |     execSync(\\\\\\\"git init -q && git config user.name 'Nexus Test' && git config user.email 'nexus@example.invalid' && git add . && git commit -qm baseline\\\\\\\", { cwd: repo, stdio: \\\\\\\"ignore\\\\\\\" });\\\\n 1141 |     const manager = new WorktreeManager(repo);\\\\n 1142 |     const worktree = manager.createWorktree();\\\\n 1143 |     const generated = path.join(worktree.worktreePath, \\\\\\\"generated\\\\\\\", \\\\\\\"test-output.txt\\\\\\\");\\\\n 1144 |     const bridge = new RustCoreBridge(worktree.worktreePath, \\\\\\\"bash\\\\\\\", undefined, false, false, \\\\\\\"bwrap\\\\\\\", true);\\\\n 1145 |     try {\\\\n 1146 |       const result = await bridge.executeTool(\\\\\\\"run_tests\\\\\\\", {});\\\\n 1147 |       assert.strictEqual(result.success, true, \\\\\\\"the test command can report success inside the required sandbox\\\\\\\");\\\\n 1148 |       assert.strictEqual(fs.existsSync(generated), true, \\\\\\\"repository