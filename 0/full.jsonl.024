\" <<EOF\n{\"agent\":\"/root\",\"host\":\"mike-dev\",\"branch\":\"$branch_name\",\"worktree\":\"$worktree_path\",\"base\":\"$base_sha\",\"since\":\"$(date -u +%FT%TZ)\",\"scope\":\"Install exact published RC10 on ubuntu-desktop into version-scoped isolated prefix for later manual terminal matrix; require provenance; no UI launch, inference, or human acceptance cell.\"}\nEOF\ngit worktree add -b \"$branch_name\" \"$worktree_path\" \"$base_sha\"\nprintf '%s\\n' \"$(date -u +%FT%TZ) CLAIM RC10_DESKTOP_INSTALL_PREP agent=/root host=ubuntu-desktop base=$base_sha branch=$branch_name scope=official_RC10_provenance_required_version_scoped_isolated_prefix_no_terminal_cell\" >> \"$(git rev-parse --git-common-dir)/nexus-claims.log\"\ngit -C \"$worktree_path\" status --short\ngit -C \"$worktree_path\" rev-parse HEAD"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"Preparing worktree (new branch 'v1/rc10-desktop-install-prep')\nHEAD is now at 16ee8ca Merge pull request #262 from mikeholownych/v1/rc10-version-bump\n16ee8ca3643824741b6da67936b41f262414fdf0\n","exit_code":0,"duration":{"secs":1,"nanos":6971731}},"started_at_ms":1793066288677,"completed_at_ms":1793066289684}}
