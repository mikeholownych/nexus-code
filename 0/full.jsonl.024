okenCount ? { strictTokenCount } : {}),\n420-    worktree,\n421:    authoritativeVerifierCommand,\n422-    trustedDeliverableFiles,\n423-    verifierTimeoutSecs,\n424-    recordFlight,\n425-    plannerModel,\n426-    plannerEndpoint,\n427-    coderModel,\n428-    coderEndpoint,\n429-    tdd,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17b23-4ce0-7c11-90c6-74e78e580449","create_time":1793068271.533428}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
