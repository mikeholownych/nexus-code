ry()) for (const name of fs.readdirSync(source)) validatePrivateTree(path.join(source, name));\n }\n-function copyPrivateTree(source: string, destination: string, excluded = new Set<string>()): void {\n+function copyPrivateTree(\n+  source: string,\n+  destination: string,\n+  excluded = new Set<string>(),\n+  onFileCopied?: (bytes: number) => void,\n+): void {\n   validatePrivateTreeExcept(source, excluded);\n   const existed = fs.existsSync(destination);\n   fs.mkdirSync(destination, { recursive:true, mode:0o700 });\n@@ -248,14 +277,16 @@ function copyPrivateTree(source: string, destination: string, excluded = new Set\n   for (const entry of fs.readdirSync(source, { withFileTypes:true })) {\n     if (excluded.has(entry.name) || entry.name === STATE_STORE_GUARD_FILE || entry.name === STATE_RESTORE_PENDING_FILE) continue;\n     const from = path.join(source, entry.name), to = path.join(destination, entry.name);\n-    if (entry.isDirectory()) copyPrivateTree(from, to);\n-    else copyPrivateFileDurably(from, to);\n+    if (entry.isDirectory()) copyPrivateTree(from, to, new Set(), onFileCopied);\n+    else onFileCopied?.(copyPrivateFileDurably(from, to, false));\n   }\n+  // File contents are fsynced individually. Batch directory-entry durability\n+  // once per directory instead of forcing a journal commit for every file.\n   syncDirectory(destination);\n }\n \n /** A backup is not returned to the journal until its bytes and directory entry are durable. */\n-function copyPrivateFileDurably(source: string, destination: string): void {\n+function copyPrivateFileDurably(source: string, destination: string, syncParentOnSuccess = true): number {\n   const sourcePath = path.resolve(source);\n   if (fs.realpathSync(sourcePath) !== sourcePath) throw new Error(\"Backup source is redirected\");\n   const sourceFd = fs.openSync(sourcePath, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0) | (fs.constants.O_NONBLOCK ?? 0));\n@@ -282,7 +313,8 @@ function copyPrivateFileDurably(source: string, destination: string): void {\n     fs.fsyncSync(destinationFd);\n     fs.closeSync(destinationFd);\n     destinationFd = undefined;\n-    syncDirectory(path.dirname(destination));\n+    if (syncParentOnSuccess) syncDirectory(path.dirname(destination));\n+    return position;\n   } catch (error) {\n     if (destinationFd !== undefined) try { fs.closeSync(destinationFd); } catch {}\n     if (destinationCreated) {\ndiff --git a/cli/test/upgrade_transaction_recovery.test.ts b/cli/test/upgrade_transaction_recovery.test.ts\nindex 306f79d..c29e90c 100644\n--- a/cli/test/upgrade_transaction_recovery.test.ts\n+++ b/cli/test/upgrade_transaction_recovery.test.ts\n@@ -274,6 +274,46 @@ describe(\"durable same-version transaction recovery\",()=>{\n   });\n });\n describe(\"complete private state/config backup restore\",()=>{\n+ it(\"reports only aggregate backup progress and syncs each copied directory once\",()=>{\n+  const home=fs.mkdtempSync(path.join(os.tmpdir(),\"nexus-backup-progress-\"));\n+  const originalFsync=fsDefault.fsyncSync;\n+  const directoryFlushes=new Map<string,number>();\n+  const progress:Array<{filesCopied:number;bytesCopied:number}>=[];\n+  try{\n+   const source=path.join(home,\".nexus/tasks\");\n+   fs.mkdirSync(source,{recursive:true,mode:0o700});\n+   fs.chmodSync(path.join(home,\".nexus\"),0o700);fs.chmodSync(source,0o700);\n+   const payload=\"PRIVATE-PAYLOAD-CANARY\";\n+   for(let index=0;index<32;index++) fs.writeFileSync(path.join(source,`task-${index}.json`),`${payload}-${index}`,{mode:0o600});\n+\n+   fsDefault.fsyncSync=((fd:number)=>{\n+    const stat=fsDefault.fstatSync(fd);\n+    if(stat.isDirectory()){\n+     const key=`${stat.dev}:${stat.ino}`;\n+     directoryFlushes.set(key,(directoryFlushes.get(key)??0)+1);\n+    }\n+    return originalFsync(fd);\n+   }) as typeof fsDefault.fsyncSync;\n+   syncBuiltinESMExports();\n+\n+   const backup=createPreMigrationBackup(home,item=>progress.push(item));\n+   assert.ok(backup.stateBackupDir);\n+   const copiedDirectory=path.join(backup.stateBackupDir!,\"state\",\"tasks\");\n+   const stat=fs.statSync(copiedDirectory);\n+   assert.equal(directoryFlushes.get(`${stat.dev}:${stat.ino}`),1,\"all task file entries must be synced together after their payloads\");\n+   assert.equal(fs.readdirSync(copiedDirectory).length,32);\n+   assert.ok(progress.length>0,\"large backups must report progress\");\n+   assert.deepEqual(progress.at(-1),{filesCopied:32,bytesCopied:Array.from({length:32},(_,index)=>Buffer.byteLength(`${payload}-${index}`)).reduce((sum,size)=>sum+size,0)});\n+   assert.ok(progress.every(item=>Object.keys(item).sort().join(\",\")===\"bytesCopied,filesCopied\"),\"progress must not expose names or payloads\");\n+   assert.equal(JSON.stringify(progress).includes(payload),false);\n+   assert.equal(fs.statSync(path.join(copiedDirectory,\"task-0.json\")).mode&0o777,0o600);\n+  }finally{\n+   fsDefault.fsyncSync=originalFsync;\n+   syncBuiltinESMExports();\n+   fs.rmSync(home,{recursive:true,force:true});\n+  }\n+ });\n+\n  it(\"restores session payloads and config rather than copying an archive into config.env\",()=>{\n   const home=fs.mkdtempSync(path.join(os.tmpdir(),\"nexus-backup-roundtrip-\"));\n   try{\n","exit_code":0,"duration":{"secs":0,"nanos":829104696}},"started_at_ms":1792983401583,"completed_at_ms":1792983402412}}
{"timestamp":"2026-10-26T02:56:43.800Z","ordinal":371529,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17623-8d18-7ec2-8c6d-d57b2c78ba66","call_id":"call_0319c96b5ed34c469e845f75c2494d77","output":[{"type":"input_text","text":"Script completed\nWall time 3.7 seconds\nOutput:\n"},{"type":"input_text","text":"RESULT 1\nWarning: truncated output (original token count: 9470)\nTotal output lines: 160\n\ndocs/WP05_EGRESS_PROTECTION_EVIDENCE.md:98:- **Route Fallback Re-Admission (`CTX-006`):** In `LocalLlmClient.executeWithFailover`, each endpoint attempt evaluates egress against the specific `currentEp` for that attempt. If failover switches from a local endpoint to a public endpoint, the payload is dynamically re-admitted and sanitized against the new destination boundary.\ndocs/PHASE2_RECONCILED_REQUIREMENTS.md:269:| **SUBP-002** | Accidental ambient host authority MUST NOT silently exceed configured execution authority. In bounded or restricted execution domains, subprocesses MUST NOT inherit ambient host credentials, private keys, or sensitive configuration secrets by default unless explicitly injected. An execution domain policy MAY explicitly authorize an inherited credential set for broad or full-access domains without requiring per-invocation confirmation, but credential availability within a domain MUST NOT confer disclosure authority. | In bounded execution domains, sensitive host environment variables (e.g., `AWS_SECRET_ACCESS_KEY`, `GITHUB_TOKEN`, `LOCAL_LLM_API_KEY`) are scrubbed by default unless the domain policy explicitly authorizes their presence. |\ndocs/USER_MANUAL.md:385:- **Multi-Provider Failover**: Specify secondary fallback endpoints via `--fallback <url1,url2>` or `$LOCAL_LLM_FALLBACK_ENDPOINTS`. Automatic failover occurs if the primary LLM server drops connection or runs out of GPU VRAM (HTTP 503).\ndocs/PHASE2S_SECURITY_AND_DATA_REVIEW.md:138:1. **Host Authentication & Cloud Credentials:** SSH private keys (`~/.ssh/id_*`), AWS tokens (`~/.aws/credentials`), Git credentials (`~/.gitconfig`, `.token`), local config API keys (`LOCAL_LLM_API_KEY`).\ndocs/PHASE2S_SECURITY_AND_DATA_REVIEW.md:354:  1. In `cli/src/client.ts` (lines 72–87, 209–247), `LocalLlmClient` accepts a list of fallback endpoints (`config.fallbackEndpoints`, `process.env.LOCAL_LLM_FALLBACK_ENDPOINTS`).\ndocs/PHASE2S_SECURITY_AND_DATA_REVIEW.md:359:- **Undesirable Outcome:** Proprietary source code, local file paths, and unredacted sensitive data are silently transmitted across the network to external cloud APIs during an unannounced local endpoint failure.\ndocs/PHASE2S_SECURITY_AND_DATA_REVIEW.md:360:- **Preconditions / Reachability:** Primary endpoint local; fallback endpoint remote; local endpoint suffers connection error or timeout.\ndocs/PHASE2S_SECURITY_AND_DATA_REVIEW.md:542:- **Local Appliance vs Remote Cloud:** A local model running on localhost (e.g. vLLM or Ollama) resides inside the host/local network trust boundary. A remote provider (OpenAI, Anthropic) resides outside it.\ndocs/PHASE2S_SECURITY_AND_DATA_REVIEW.md:735:   *Add:* *\"Inference failover pools must not span different trust boundaries. Automatic fallback from a local provider to an external cloud provider is prohibited unless the request is fully re-processed through the egress data-protection pipeline.\"*\ndocs/CLIENT_GUIDE.md:22:The quickstart configures an OpenAI-compatible local endpoint. Nexus also supports explicit providers and provider-specific authentication; see [Cloud providers](CLOUD_PROVIDERS.md) for model selection, API keys, sign-in flows, endpoint disclosure, credential storage, and failure recovery. Keep credentials in the operator environment or `~/.config/nexus/config.env` with mode 0600. Never commit keys, put them in task prompts, or use real keys in examples. Project `.env` files cannot choose a cloud destination.\ndocs/DOCTOR_TROUBLESHOOTING.md:96:  \"effectiveConfig\": [{ \"key\": \"LOCAL_LLM_ENDPOINT\", \"value\": \"https://…/v1\", \"source\": \"~/.config/nexus/config.env\" }],\ndocs/reviews/NEXUS_CLOUD_PROVIDERS_LIVE_QUALIFICATION_2026-10-11.md:38:generation from gpt-5 on and Codex models; and a provider connection that is told an optional parameter is\ndocs/reviews/NEXUS_CONVERGENCE_INVARIANT_REMEDIATION.md:60:whose `.env` holds only `LOCAL_LLM_CREDENTIAL_ORIGINS=http://127.0.0.1:18557`, and once from an empty cwd.\ndocs/reviews/NEXUS_CONVERGENCE_INVARIANT_REMEDIATION.md:104:  (override) into the one flat `process.env`. `storedCredentialFor(url)` read `LOCAL_LLM_CREDENTIAL_ORIGINS` and\ndocs/reviews/NEXUS_CONVERGENCE_INVARIANT_REMEDIATION.md:105:  `LOCAL_LLM_ENDPOINT` from that `process.env`.\ndocs/reviews/NEXUS_CONVERGENCE_INVARIANT_REMEDIATION.md:107:  token goes. The same was true of `LOCAL_LLM_ENDPOINT`, which re-homed the token-file gateway when `config.env`\ndocs/reviews/NEXUS_CONVERGENCE_INVARIANT_REMEDIATION.md:108:  named none and the operator-env key binding. An operation spec's `apiKeyEnv: LOCAL_LLM_API_KEY` could also bind\ndocs/reviews/NEXUS_CONVERGENCE_INVARIANT_REMEDIATION.md:154:     operator `LOCAL_LLM_API_KEY`).\ndocs/EXECUTION_CONVERGENCE.md:156:- The stored token and config.env's `LOCAL_LLM_API_KEY` belong to config.env's `LOCAL_LLM_ENDPOINT` origin (else\ndocs/EXECUTION_CONVERGENCE.md:157:  `$LOCAL_LLM_ENDPOINT`), plus any origins listed in `LOCAL_LLM_CREDENTIAL_ORIGINS`. `$LOCAL_LLM_API_KEY` belongs to\ndocs/EXECUTION_CONVERGENCE.md:158:  `$LOCAL_LLM_ENDPOINT`. An explicit key belongs to `config.credentialOrigin`, else the endpoint it was given for.\ndocs/EXECUTION_CONVERGENCE.md:168:configure endpoints and models, but their `LOCAL_LLM_CREDENTIAL_ORIGINS` / `LOCAL_LLM_ENDPOINT` never widen or\ndocs/EXECUTION_CONVERGENCE.md:169:re-home a stored credential (token file, config.env key, or the operator's `LOCAL_LLM_API_KEY`). A key a project\ndocs/reviews/NEXUS_APPLICATION_MATURITY_REVIEW_2026-10-12.md:55:**Acceptance evidence:** scenario-based fault-injection suite (process kill during each durable boundary, disk full, permission changes, provider disconnect/429/partial stream, terminal resize/cancel); metrics with clear privacy controls; documented support bundle schema; recovery success and data-loss measurements.\ncli/src/sidecar.ts:63:import { connectWithKey, disconnect, selectModel, startSignIn } from \"./provider_connect.js\";\ncli/src/sidecar.ts:208:      case \"provider.connect\":\ncli/src/sidecar.ts:210:    …6470 tokens truncated…t disabled by default (`LOCAL_LLM_TIMEOUT_MS=0`) so long local generations are never cut off while tokens continue arriving.\ndocs/v1.0.0/specs/SPEC-05-standalone-local-inference.md:83:- **Timeouts.** In `client.ts:744-747,1627-1630`, replace the single `AbortSignal.timeout(total)` with a watchdog that is reset on each chunk. The env keys `LOCAL_LLM_FIRST_BYTE_TIMEOUT_MS`, `LOCAL_LLM_IDLE_TIMEOUT_MS` and `LOCAL_LLM_TIMEOUT_MS` (total, default 0 = off for local, 900 s for cloud) are operator-only (SPEC-03).\ndocs/v1.0.0/specs/SPEC-05-standalone-local-inference.md:91:- Changing the default total timeout for local endpoints to \"off\" (idle and first-byte only) is a behaviour change. It is beneficial for slow local generation, and the release notes must mention it.\ncli/src/core/operation_runner.ts:553:  // Same role binding as the agent: own provider, else own endpoint, else the main connection.\ndocs/v1.0.0/specs/SPEC-03-untrusted-inputs-and-egress.md:18:| Workspace `.env` | Loaded with `override:true` and no key filter (`cli/src/config.ts:36-39`). `NODE_TLS_REJECT_UNAUTHORIZED=0` from a repo disables TLS verification for every later fetch, including cloud API keys. Reproduced. It can also set timeouts, recovery policy, `LOCAL_LLM_FALLBACK_ENDPOINTS` and provider key vars, because `credentials.ts:243` reads live env. | PRV-01 (S2) |\ndocs/v1.0.0/specs/SPEC-03-untrusted-inputs-and-egress.md:31:1. **REQ-SEC-110.** A workspace `.env` may set only an allowlisted set of keys: `LOCAL_LLM_ENDPOINT`, `LOCAL_LLM_MODEL`, `LOCAL_LLM_TASK_CLASS`, `NEXUS_CONTEXT_LIMIT`, plus any key in the documented `NEXUS_PROJECT_*` namespace. All other keys are ignored, with one warning per key at startup and in `nexus doctor`. In particular it may not set `NODE_*`, `*_PROXY`, `HOME`, `PATH`, `SSL_*`, credential variables, timeouts, recovery policy or fallback endpoints. Project values are kept in a separate map and are never written into `process.env`.\ndocs/v1.0.0/specs/SPEC-11-verification-and-tool-call-integrity.md:82:| Parser | `parseModelResponse(reply, { nativeTools: boolean })`. The capability comes from the provider protocol: Responses, Anthropic and Chat Completions with `tools` accepted are native. Steps 4–5 run only when `!nativeTools` and are restricted as in REQ-AGT-112. The reasoning stripper handles the lone-close and unclosed-open cases. Remove the `json {\"tool\":…}` exemplars from `fewshots.ts` for native connections. |\ndocs/releases/v1.0.0.md:15:  - `LOCAL_LLM_ENDPOINT`\ndocs/releases/v1.0.0.md:16:  - `LOCAL_LLM_MODEL`\ndocs/releases/v1.0.0.md:17:  - `LOCAL_LLM_TASK_CLASS`\ndocs/releases/v1.0.0.md:20:- **Ignored project keys:** All other environment keys—including `NODE_*`, `*_PROXY`, `HOME`, `PATH`, `SSL_*`, provider credentials (`OPENAI_API_KEY`, etc.), `LOCAL_LLM_API_KEY`, `LOCAL_LLM_TIMEOUT_MS`, and `LOCAL_LLM_FALLBACK_ENDPOINTS`—are ignored with startup notices and flagged in `nexus doctor`.\ndocs/releases/v1.0.0.md:30:| Appliance API key (`LOCAL_LLM_API_KEY`) | `~/.config/nexus/config.env` |\ndocs/releases/v1.0.0.md:34:| Local LLM timeouts (`LOCAL_LLM_TIMEOUT_MS`) | `~/.config/nexus/config.env` |\ndocs/releases/v1.0.0.md:35:| Fallback endpoints (`LOCAL_LLM_FALLBACK_ENDPOINTS`) | `~/.config/nexus/config.env` or CLI `--fallback` |\ndocs/releases/v1.0.0.md:44:- Hostnames are treated as external destinations by default unless the host is `localhost`, matches the operator-configured local endpoint, or is explicitly declared in `NEXUS_LOCAL_ORIGINS`.\ndocs/CLOUDFLARE_CONTEST.md:54:5. Set `NEXUS_CF_ARTIFACT_CREDENTIAL_PATH` and `NEXUS_CF_WORKER_BEARER_PATH` if the root-owned capability files use non-default paths. Set the real inference endpoint and model using `LOCAL_LLM_ENDPOINT` and `LOCAL_LLM_MODEL`; store any model credential using the client’s credential store so it is not inherited by the restricted validation process. The endpoint must support OpenAI Chat Completions and tool-free JSON coding responses. A local fixture can run without inference or Cloudflare, but must be labelled offline.\ndocs/v1.0.0/REQUIREMENTS.md:179:| REQ-PRV-111 | DEC-06 | Live `providers verify` for each provider listed as supported. The others are labelled experimental. | compatibility claims | `provider_cli.ts` | **RT 2026-10-14 @db1ca55:** chatgpt (gpt-6-luna) PASS, openrouter (openrouter/free) PASS. **RT 2026-10-16 @6151a23+4d82578, pinned models:** openrouter `nvidia/nemotron-3-super-120b-a12b:free` PASS (one model served every request), chatgpt `gpt-6-luna` PASS (`evidence/live/verify_*_pinned_2026-10-16.json`). The run found and fixed the option-scope regression (4d82578). openai-key and anthropic not connected. | partial (repeat on the RC) | ACC-PRV-LIVE | RR | B §6 G2 | SPEC-05 / PLAN-10 |\ndocs/v1.0.0/evidence/D_terminal.md:62:| TUI-06 | S2 | Onboarding / unreachable endpoint | protocol.ts:306-315; startup screen | RUNTIME s1a: endpoint 127.0.0.1:9 -> startup shows no endpoint status; first prompt loops \"Inference provider temporarily unavailable (network_error); waiting Ns ... Work is preserved.\" 7x in 28s, no endpoint URL, no fix hint (`nexus doctor`, LOCAL_LLM_ENDPOINT, `/connect`), no bound seen | New user with wrong/absent endpoint sees an indefinite wait without actionable guidance | Probe endpoint at session start; error text names endpoint + `nexus doctor`; bound recovery for never-reachable endpoints (coordinate with provider scope) |\ndocs/v1.0.0/evidence/D_terminal.md:97:TUI-06 (`s1_startup.py`, LOCAL