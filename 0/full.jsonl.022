ent::ModelsCatalog { id, providers, models, current, recent } => {\n1090:                self.on_catalog(id, Catalog { providers, models, current, recent });\n3955:    const CATALOG: &str = r#\"{\"v\":1,\"type\":\"models.catalog\",\"id\":\"ID\",\"providers\":[{\"id\":\"appliance\",\"label\":\"Appliance (10.0.8.5:8443)\",\"disclosure\":\"local\",\"connected\":true,\"methods\":[],\"status\":\"ok\"},{\"id\":\"chatgpt\",\"label\":\"ChatGPT plan\",\"disclosure\":\"cloud\",\"connected\":true,\"source\":\"Codex CLI\",\"external\":true,\"methods\":[{\"id\":\"chatgpt-oauth\",\"label\":\"Sign in with ChatGPT (unofficial)\",\"kind\":\"browser\",\"unofficial\":true}],\"status\":\"ok\"},{\"id\":\"anthropic\",\"label\":\"Anthropic\",\"disclosure\":\"cloud\",\"connected\":false,\"methods\":[{\"id\":\"api-key\",\"label\":\"API key\",\"kind\":\"key\"}],\"status\":\"disconnected\"}],\"models\":[{\"provider\":\"appliance\",\"id\":\"engineering/b0\"},{\"provider\":\"chatgpt\",\"id\":\"gpt-5-codex\"}],\"current\":{\"provider\":\"appliance\",\"model\":\"engineering/b0\"},\"recent\":[]}\"#;\n4009:        assert!(matches!(state.overlay, Some(Overlay::Connect(_))), \"/connect opens the connect panel once providers are known\");\ncli/src/provider_cli.ts:76:  if (!match) return \"Configuration error: provider configuration is invalid\";\ncli/src/provider_cli.ts:77:  // An unknown provider name comes from user configuration; even identifier-shaped values may be secrets.\ncli/src/provider_cli.ts:115:  \"malformed_event\", \"output_truncated\", \"protocol_error\", \"aborted\", \"policy_denied\", \"configuration_error\", \"verification_error\",\ncli/src/provider_cli.ts:332:      console.log(pc.dim(\"Select with --provider <id> --model <id> (or NEXUS_PROVIDER / NEXUS_MODEL in ~/.config/nexus/config.env).\\n\"));\nquickstart.md:36:cat > \"$HOME/.config/nexus/config.env\" <<'EOF'\nquickstart.md:41:chmod 600 \"$HOME/.config/nexus/config.env\"\nquickstart.md:44:Use your endpoint's actual model ID. Nexus automatically discovers the loaded context window from LM Studio (`/api/v0/models`), llama.cpp (`/props`), vLLM (`/v1/models`), and Ollama (`/api/show`), or you can override it with `--context-limit` (`NEXUS_CONTEXT_LIMIT`). For HTTPS servers using a private certificate authority, set `NODE_EXTRA_CA_CERTS=/path/to/ca.pem` in `~/.config/nexus/config.env`. Do not put real credentials in a project `.env`, shell history, or this example. See [Local servers](docs/LOCAL_SERVERS.md) for per-server setup and [Cloud providers](docs/CLOUD_PROVIDERS.md) for cloud provider and credential handling.\nquickstart.md:108:User configuration, credentials, sessions, and project `.nexus` data are retained.\ndocs/CLIENT_GUIDE.md:22:The quickstart configures an OpenAI-compatible local endpoint. Nexus also supports explicit providers and provider-specific authentication; see [Cloud providers](CLOUD_PROVIDERS.md) for model selection, API keys, sign-in flows, endpoint disclosure, credential storage, and failure recovery. Keep credentials in the operator environment or `~/.config/nexus/config.env` with mode 0600. Never commit keys, put them in task prompts, or use real keys in examples. Project `.env` files cannot choose a cloud destination.\ndocs/USER_MANUAL.md:63:See [MCP_GUIDE.md](MCP_GUIDE.md) for full configuration details.\ndocs/USER_MANUAL.md:87:Nexus maintains a transaction journal (`$PREFIX/lib/nexus/.upgrade-journal.json`) and creates protected pre-migration configuration backups (mode `0600`) before modifications:\ndocs/USER_MANUAL.md:97:- Restore configuration from a pre-migration backup:\ndocs/USER_MANUAL.md:99:  nexus upgrade --restore-backup ~/.config/nexus/backups/config.env.bak\ndocs/USER_MANUAL.md:146:  which. A verifier you configure is your own check and is not held to this. Python projects without configuration\ndocs/USER_MANUAL.md:288:| `/doctor [--deep] [--fix [--yes]]` | Diagnose this session's configuration, endpoint, engine, shell and state (see `docs/DOCTOR_TROUBLESHOOTING.md`) |\ndocs/USER_MANUAL.md:380:  Servers, plugins, and skills in your home configuration (`~/.config/nexus/`, `~/.nexus/`) are always trusted and loaded.\n","exit_code":0,"duration":{"secs":0,"nanos":726879619}},"started_at_ms":1792983747517,"completed_at_ms":1792983748245}}
