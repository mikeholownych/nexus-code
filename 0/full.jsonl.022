er is invalid\");\n967:        const staleStat = fs.lstatSync(lockFile), staleIno = staleStat.ino;\n968-        try { process.kill(existing.pid, 0); throw new Error(`Another upgrade process (PID ${existing.pid}) is currently running.`); }\n969-        catch (probeErr: any) {\n970-          if (probeErr.code === \"EPERM\") throw new Error(`Another upgrade process (PID ${existing.pid}) is currently running.`);\n971-          if (probeErr.code !== \"ESRCH\") throw probeErr;\n972-        }\n973-        const guardPath = `${lockFile}.guard`;\n974-        let guard = acquireReclaimGuard(guardPath);\n975-        if (!guard) {\n976:          // A live reclaimer holds the kernel guard: give it a moment, then\n977-          // re-check whether it took over the lock before giving up.\n978-          Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 200);\n979-          const current = fs.lstatSync(lockFile, { throwIfNoEntry:false });\n980:          if (!current || current.ino !== staleIno) throw new Error(\"Another upgrade is in progress; lock was replaced.\");\n981-          guard = acquireReclaimGuard(guardPath);\n982:          if (!guard) throw new Error(`Another upgrade is in progress; stale lock reclaim guard is held at ${guardPath}.`);\n983-        }\n984-        try {\n985-          const current = fs.lstatSync(lockFile, { throwIfNoEntry:false });\n986:          if (current && current.ino !== staleIno) throw new Error(\"Another upgrade is in progress; lock was replaced.\");\n987-          if (current) {\n988:            if (JSON.parse(fs.readFileSync(lockFile, \"utf8\")).pid !== existing.pid) throw new Error(\"Another upgrade is in progress; lock owner changed.\");\n989-            fs.unlinkSync(lockFile);\n990-          }\n991-          writeOwnedLock();\n992-        } finally { releaseReclaimGuard(guard); }\n993-      } catch (inner: any) {\n994:        throw new Error(`Another upgrade is in progress (lockfile present at ${lockFile}): ${inner.message || inner}`);\n995-      }\n996-    } else {\n997-      throw new Error(`Could not acquire upgrade lock at ${lockFile}: ${err.message || err}`);\n998-    }\n999-  }\n1000-\n1001-  const transactionId = `upg-${Date.now()}-${process.pid}`;\n1002-  const tmpDir = path.join(libNexus, `.tmp-upgrade-${transactionId}`);\n1003-  let journalEntry: UpgradeJournalEntry | undefined;\n1004-  const cleanup = () => {\n1005-    // A failed recovery keeps every artifact, including staging, for the operator.\n1006-    if (!journalEntry || [\"complete\", \"rolled_back\"].includes(journalEntry.state)) {\n1007-      try { fs.rmSync(tmpDir, { recursive:true, force:true }); } catch {}\n1008-    }\n","exit_code":0,"duration":{"secs":0,"nanos":29856}},"started_at_ms":1792983104536,"completed_at_ms":1792983104536}}
