{"timestamp":"2026-10-26T01:30:24.183Z","ordinal":367496,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a175d0-ddec-7861-9122-03a48c8a4185","item":{"type":"CommandExecution","id":"exec-fab49b30-123c-439b-b05c-bb762800a870","process_id":"59829","command":["/usr/bin/zsh","-lc","rg -n 'restoreSession|providerRecovery|changeBaseline|checkpointDurableState|session round-trip' cli/test/durable_continuity.test.ts cli/test/experimental_and_readonly.test.ts; sed -n '1,70p' cli/test/durable_continuity.test.ts; sed -n '1160,1335p' cli/src/agent.ts; rg -n 'readOnlyModeSelected|setReadOnly|fullAccess' cli/src/agent.ts | head -n 45; git diff --cached --stat"],"cwd":"file:///home/mike/nexus-wt/agent-readonly-current","parsed_cmd":[{"type":"unknown","cmd":"rg -n 'restoreSession|providerRecovery|changeBaseline|checkpointDurableState|session round-trip' cli/test/durable_continuity.test.ts cli/test/experimental_and_readonly.test.ts; sed -n '1,70p' cli/test/durable_continuity.test.ts; sed -n '1160,1335p' cli/src/agent.ts; rg -n 'readOnlyModeSelected|setReadOnly|fullAccess' cli/src/agent.ts | head -n 45; git diff --cached --stat"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"cli/test/durable_continuity.test.ts:672:        a1.changeBaseline = mockBaseline;\ncli/test/durable_continuity.test.ts:673:        a1.checkpointDurableState(\"test baseline checkpoint\");\ncli/test/durable_continuity.test.ts:678:        assert.ok(saved.changeBaseline, \"saved state must contain changeBaseline\");\ncli/test/durable_continuity.test.ts:679:        assert.equal(saved.changeBaseline.command, \"npm test\");\ncli/test/durable_continuity.test.ts:680:        assert.equal(saved.changeBaseline.failed, true);\ncli/test/durable_continuity.test.ts:681:        assert.deepEqual(saved.changeBaseline.tests, { \"test.js\": \"throw new Error('fail');\\n\" });\ncli/test/durable_continuity.test.ts:682:        assert.deepEqual(saved.changeBaseline.verifier, { \"package.json\": '{\"scripts\":{\"test\":\"node test.js\"}}' });\ncli/test/durable_continuity.test.ts:688:        tampered.changeBaseline.trustedDeliverables = [\"src/math.js\"];\ncli/test/durable_continuity.test.ts:689:        tampered.changeBaseline.failed = false;\ncli/test/durable_continuity.test.ts:690:        tampered.changeBaseline.tests = { \"test/math.test.js\": \"// forged passing oracle\\n\" };\ncli/test/durable_continuity.test.ts:691:        tampered.changeBaseline.verifier = { \"package.json\": '{\"scripts\":{\"test\":\"node test/math.test.js\"}}' };\ncli/test/durable_continuity.test.ts:702:        assert.equal(a2.changeBaseline, null, \"recovered verifier baseline must be invalidated\");\ncli/test/durable_continuity.test.ts:707:        assert.equal(recovered.changeBaseline?.failed, false, \"the recovered record is retained, not trusted\");\ncli/test/durable_continuity.test.ts:708:        assert.deepEqual(recovered.changeBaseline?.trustedDeliverables, [\"src/math.js\"]);\ncli/test/durable_continuity.test.ts:709:        assert.deepEqual(recovered.changeBaseline?.tests, { \"test/math.test.js\": \"// forged passing oracle\\n\" });\ncli/test/durable_continuity.test.ts:716:        assert.deepEqual(progressSaved.changeBaseline, recovered.changeBaseline, \"message progress must not erase continuity data\");\ncli/test/durable_continuity.test.ts:717:        agent2.checkpointDurableState(\"recovery continuity checkpoint\");\ncli/test/durable_continuity.test.ts:719:        assert.deepEqual(checkpointed.changeBaseline, recovered.changeBaseline);\ncli/test/durable_continuity.test.ts:720:        assert.equal(a2.changeBaseline, null);\ncli/test/durable_continuity.test.ts:751:        firstAgent.changeBaseline = {\ncli/test/durable_continuity.test.ts:759:        first.checkpointDurableState(\"pending verifier baseline\");\ncli/test/durable_continuity.test.ts:768:        delete state.changeBaseline;\ncli/test/durable_continuity.test.ts:779:        assert.equal(resumedAgent.changeBaseline, null, \"pending recovery must not recapture current workspace as baseline\");\ncli/test/durable_continuity.test.ts:817:        firstAgent.changeBaseline = {\ncli/test/durable_continuity.test.ts:825:        first.checkpointDurableState(\"pending verifier baseline\");\ncli/test/durable_continuity.test.ts:837:        assert.equal(resumedAgent.changeBaseline, undefined, \"candidate-edited tests must not become a new pre-change baseline\");\ncli/test/durable_continuity.test.ts:1248:        agent.restoreSession([], false);\ncli/test/durable_continuity.test.ts:1252:        assert.equal(internal.changeBaseline, null, \"a saved or newly captured baseline cannot be trusted\");\ncli/test/durable_continuity.test.ts:1255:        assert.equal(internal.changeBaseline, null, \"the edited test oracle cannot become its own pre-change baseline\");\ncli/test/durable_continuity.test.ts:1291:        agent.restoreSession([], false);\n/**\n * Durable continuity of work across process death, retries and resumes (acceptance blockers V1 and V2,\n * docs/reviews/NEXUS_ACCEPTANCE_BLOCKERS_2026-10-08.md):\n *\n *   V1  a resumed unit continues its authorized task from its recorded conversation; missing or inconsistent durable\n *       history blocks the unit (only the operator can start it over) and is never read as NOT_REQUIRED.\n *   V2  workspace changes that no verifier has established stay unverified across step limits, retries, process\n *       restarts and every supported resume path, so a later attempt that changes nothing cannot complete the unit.\n *\n * Real AutonomousAgent turns against local scripted gateways; process death uses the real CLI in a child process.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport http from \"node:http\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { randomInt } from \"node:crypto\";\nimport { execSync, spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { ApplicationCore } from \"../src/core/app.js\";\nimport { newOperation, type DurableOperationState, type WorkUnitSpec } from \"../src/core/operation.js\";\nimport { AgentWorkUnitExecutor, applyOperatorDecision, driveOperation, OperationStore } from \"../src/core/operation_runner.js\";\nimport type { ResourceDescriptor } from \"../src/core/resources.js\";\nimport { DurableStateManager } from \"../src/core/state.js\";\nimport { WorkspacePath } from \"../src/core/workspace_path.js\";\nimport { SidecarServer } from \"../src/sidecar.js\";\nimport { type HarnessConfig, DEFAULT_CONTINUATION } from \"../src/types.js\";\nimport { readTaskMessages, updateTaskMessages } from \"../src/core/task_message_log.js\";\n\nconst cliRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst srcIndex = path.join(cliRoot, \"src/index.ts\");\nconst tsxLoader = import.meta.resolve(\"tsx\");\n\nfunction sourceFiles(dir: string): string[] {\n  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {\n    const file = path.join(dir, entry.name);\n    return entry.isDirectory() ? sourceFiles(file) : file.endsWith(\".ts\") ? [file] : [];\n  });\n}\n\ntest(\"all source AutonomousAgent construction sites declare durability explicitly\", () => {\n  const violations: string[] = [];\n  for (const file of sourceFiles(path.join(cliRoot, \"src\"))) {\n    const source = fs.readFileSync(file, \"utf8\");\n    let at = 0;\n    while ((at = source.indexOf(\"new AutonomousAgent(\", at)) >= 0) {\n      const start = at + \"new AutonomousAgent(\".length;\n      let depth = 1;\n      let end = start;\n      for (; end < source.length && depth > 0; end++) {\n        if (source[end] === \"(\") depth++;\n        else if (source[end] === \")\") depth--;\n      }\n      const args = source.slice(start, end - 1);\n      if (!/\\{[^{}]*\\bdurable\\s*:\\s*(?:true|false)\\b[^{}]*\\}\\s*$/s.test(args)) {\n        violations.push(`${path.relative(cliRoot, file)}:${source.slice(0, at).split(\"\\n\").length}`);\n      }\n      at = end;\n    }\n  }\n  assert.deepEqual(violations, []);\n});\n\ntest(\"AgentWorkUnitExecutor default construction persists a durable depth-1 implementer with its unit identity\", async () => {\n  await withHome(async (home) => {\n    const gw = await gateway(() => done(\"one-step unit complete\"));\n    const repo = makeRepo();\n    const stateDir = path.join(home, \".nexus\", \"tasks\");\n              sourceBoundary: \"HOST_LOCAL\",\n            });\n            if (!egressResult.allowed) {\n              return {\n                allowed: false,\n                reason: egressResult.reason || `Egress via '${toolName}' blocked by InformationFlowBoundary [FAIL-003]`,\n              };\n            }\n            return {\n              allowed: true,\n              quarantined: egressResult.quarantinedCount > 0,\n              sanitizedArgs: egressResult.sanitizedPayload || args,\n            };\n          }\n\n          // 3. If tool is remote MCP server\n          if (this.mcpManager.isMcpTool(toolName)) {\n            const serverInfo = this.mcpManager.getToolServer(toolName);\n            if (serverInfo?.url) {\n              const egressResult = boundary.evaluateEgress(args, serverInfo.url, {\n                taskId: effectiveTaskId,\n                sourceBoundary: \"HOST_LOCAL\",\n              });\n              if (!egressResult.allowed) {\n                return {\n                  allowed: false,\n                  reason: egressResult.reason || `Egress to remote MCP '${serverInfo.url}' blocked by InformationFlowBoundary [FAIL-003]`,\n                };\n              }\n              return {\n                allowed: true,\n                quarantined: egressResult.quarantinedCount > 0,\n                sanitizedArgs: egressResult.sanitizedPayload || args,\n              };\n            }\n          }\n\n          // 4. For authorized local execution sinks (HOST_LOCAL):\n          // Rehydrate tokens for local execution (REHYD-001..005, DISC-004)\n          // Invariant: Possession != Authority (REHYD-003). Local sinks are authorized within owning taskId.\n          const rehydratedResult = boundary.rehydrate(args, {\n            taskId: effectiveTaskId,\n            isAuthorizedSink: true,\n          });\n\n          return {\n            allowed: true,\n            quarantined: false,\n            sanitizedArgs: rehydratedResult.rehydrated,\n          };\n        },\n        candidateMutation: async (event, context) => {\n          // Orchestration tools flagged mutating (update_plan) record state, not workspace content: they neither make\n          // a verifier result stale nor demote a verified requirement.\n          if (this.capabilityRegistry.getByToolName(event.toolName)?.category !== \"orchestration\") {\n            this.mutationSeq++;\n            if (this.objective) invalidateVerified(this.objective, `${event.toolName} changed the workspace after the verifier run`);\n          }\n          this.setUnverifiedChanges(true);\n          this.verificationEvidence = undefined;\n          this.turnMutations++;\n          await this.candidateTracker.createMutationHook()(event, context);\n        },\n      },\n    });\n    if (depth === 0 || this.role === \"implementer\" || this.role === \"tester\") {\n      this.capabilityRegistry.register(REQUIREMENTS_CAPABILITY);\n      this.capabilityRegistry.register(READ_OBJECTIVE_CAPABILITY);\n    }\n    this.capabilityRegistry.register(READ_FINDINGS_CAPABILITY);\n    this.capabilityRegistry.register(READ_ARCHIVE_CAPABILITY);\n    this.capabilityRegistry.register(ENABLE_TOOLS_CAPABILITY);\n    this.setupSpineHandlers();\n    this.stateManager = new DurableStateManager({ workspacePaths: [this.primaryWorkspacePathIdentity] });\n    if (typeof (this.client as any)?.setTaskId === \"function\") this.client.setTaskId(this.currentTaskId);\n    if (typeof (this.plannerClient as any)?.setTaskId === \"function\") this.plannerClient.setTaskId(this.currentTaskId);\n    if (typeof (this.coderClient as any)?.setTaskId === \"function\") this.coderClient.setTaskId(this.currentTaskId);\n    if (this.durable) {\n      this.initTaskState();\n    }\n    this.resetConversation();\n  }\n\n  public getStateManager(): DurableStateManager {\n    return this.stateManager;\n  }\n\n  public getTaskId(): string {\n    return this.currentTaskId;\n  }\n\n  public setApprovalPolicy(policy: ApprovalPolicy): void {\n    this.approvalPolicy = policy;\n  }\n\n  public getApprovalPolicy(): ApprovalPolicy {\n    return this.approvalPolicy;\n  }\n\n  public clearApprovedEgressOrigins(): void {\n    this.approvedEgressOrigins.clear();\n  }\n\n  public clearApprovedVerifiers(): void {\n    this.approvedVerifiers.clear();\n  }\n\n  public setApprovalMode(mode: ApprovalMode): void {\n    // Read-only selected at runtime is a mode choice, not an explicit launch invariant: record that so a later\n    // /mode auto or /mode review can deliberately leave it, exactly like --mode read-only.\n    if (mode === \"read-only\" && !this.config.readOnly && !this.config.readOnlyModeSelected) {\n      this.config.readOnlyModeSelected = true;\n    }\n    // config.readOnly is the configured (launch or deliberate mode) posture. The checkpoint fallback is transient\n    // and must never leak into it, or releasing the fallback could never restore the operator's mode.\n    const configuredReadOnly = this.modeReadOnly(mode);\n    this.config.approvalMode = mode;\n    this.config.readOnly = configuredReadOnly;\n    this.config.fullAccess = mode === \"auto\" ? this.configuredFullAccess : false;\n    this.applyReadOnlyAuthority(this.checkpointReadOnlyFallback || configuredReadOnly);\n    this.clearApprovedEgressOrigins();\n    this.clearApprovedVerifiers();\n  }\n\n  /** Read-only configured by an explicit launch or by a deliberate mode choice (not the transient fallback). */\n  private modeReadOnly(mode: ApprovalMode): boolean {\n    return Boolean((this.config.readOnly && !this.config.readOnlyModeSelected) || mode === \"read-only\");\n  }\n\n  /** Effective read-only authority for a permission mode, including the transient checkpoint fallback. */\n  private readOnlyForMode(mode: ApprovalMode): boolean {\n    return Boolean(this.checkpointReadOnlyFallback || this.modeReadOnly(mode));\n  }\n\n  private applyReadOnlyAuthority(readOnly: boolean): void {\n    this.bridge?.setReadOnly(readOnly);\n    this.authorityEngine.setReadOnly(readOnly);\n    this.authorityEngine.setFullAccess(Boolean(this.config.fullAccess) && !readOnly);\n    this.applyExtensionReadOnly(readOnly);\n  }\n\n  /** Keep workspace-scoped extension managers on the same effective posture as the bridge and authority. */\n  private applyExtensionReadOnly(readOnly: boolean): void {\n    // A permission-mode change that does not alter the effective posture (review <-> auto) must not tear down\n    // connected MCP servers, loaded plugins or the current turn's extensibility state.\n    const workspace = this.config.workspace;\n    if (this.extensionPosture?.workspace === workspace && this.extensionPosture.readOnly === readOnly) return;\n    if (this.knowledge) this.knowledge.setWorkspace(workspace, { readOnly });\n    if (this.skillManager) this.skillManager.setWorkspace(workspace, { readOnly });\n    if (this.mcpManager) {\n      this.mcpManager.shutdownAll();\n      this.mcpManager = new McpClientManager(workspace, { readOnly });\n    }\n    if (this.pluginManager) {\n      this.pluginManager = new PluginManager(workspace, { readOnly });\n      if (this.flightRecorder) this.pluginManager.setFlightRecorder(this.flightRecorder);\n    }\n    this.extensibilityInitialized = false;\n    this.extensionPosture = { workspace, readOnly };\n  }\n\n  public getApprovalMode(): ApprovalMode {\n    // An explicit --read-only launch is an operator invariant: a later mode change (the /mode slash command,\n    // setApprovalMode) must not lower it. The checkpoint fallback is the same class of restriction.\n    if (this.readOnlyForMode(this.config.approvalMode ?? \"review\")) return \"read-only\";\n    if (this.config.approvalMode) return this.config.approvalMode;\n    if (this.config.fullAccess) return \"auto\";\n    // Workspace trust controls project instructions and integrations; permission settings alone select approval posture.\n    return \"review\";\n  }\n\n  /** Restrict this session to read-only authority when its workspace cannot be safely checkpointed. */\n  public setCheckpointReadOnlyFallback(enabled: boolean): void {\n    this.checkpointReadOnlyFallback = enabled;\n    this.applyReadOnlyAuthority(this.readOnlyForMode(this.config.approvalMode ?? \"review\"));\n    if (enabled) {\n1068:    this.configuredFullAccess = Boolean(this.config.fullAccess);\n1131:      fullAccess: Boolean(config.fullAccess) && !config.readOnly,\n1270:    if (mode === \"read-only\" && !this.config.readOnly && !this.config.readOnlyModeSelected) {\n1271:      this.config.readOnlyModeSelected = true;\n1278:    this.config.fullAccess = mode === \"auto\" ? this.configuredFullAccess : false;\n1286:    return Boolean((this.config.readOnly && !this.config.readOnlyModeSelected) || mode === \"read-only\");\n1295:    this.bridge?.setReadOnly(readOnly);\n1296:    this.authorityEngine.setReadOnly(readOnly);\n1297:    this.authorityEngine.setFullAccess(Boolean(this.config.fullAccess) && !readOnly);\n1326:    if (this.config.fullAccess) return \"auto\";\n1468:        fullAccess: this.config.fullAccess,\n1863:      fullAccess: Boolean(this.config.fullAccess) && !this.isReadOnly(),\n3936:                fullAccess: Boolean(this.config.fullAccess) && !this.isReadOnly(),\n4584:      fullAccess: Boolean(this.config.fullAccess) && !this.isReadOnly(),\n cli/src/agent.ts                           | 109 