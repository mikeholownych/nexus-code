{"timestamp":"2026-10-26T02:28:41.937Z","ordinal":370479,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17605-0c8f-7f42-8d4b-980a6c519c84","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a17605-0c8f-7f42-8d4b-980a6c519c84","response_id":"resp_060b64278a9dfb15016adebad286f881a08d59f376eb01cf86","usage":{"input_tokens":143794,"cached_input_tokens":142976,"cache_write_input_tokens":0,"output_tokens":836,"reasoning_output_tokens":648,"total_tokens":144630},"turn_token_usage":{"input_tokens":4411293,"cached_input_tokens":4365312,"cache_write_input_tokens":0,"output_tokens":16266,"reasoning_output_tokens":9217,"total_tokens":4427559},"thread_token_usage":{"input_tokens":6757550152,"cached_input_tokens":6684871168,"cache_write_input_tokens":0,"output_tokens":19478534,"reasoning_output_tokens":11295194,"total_tokens":6777028686}}}
{"timestamp":"2026-10-26T02:28:42.945Z","ordinal":370480,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17605-0c8f-7f42-8d4b-980a6c519c84","item":{"type":"CommandExecution","id":"exec-79f563e5-545b-49a9-875d-c006b457bdab","process_id":"13413","command":["/usr/bin/zsh","-lc","cat /home/mike/.agents/skills/code-review-analysis/SKILL.md"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"read","cmd":"cat /home/mike/.agents/skills/code-review-analysis/SKILL.md","name":"SKILL.md","path":"/home/mike/.agents/skills/code-review-analysis/SKILL.md"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"---\nname: code-review-analysis\ndescription: >\n  Perform comprehensive code reviews with best practices, security checks, and\n  constructive feedback. Use when reviewing pull requests, analyzing code\n  quality, checking for security vulnerabilities, or providing code improvement\n  suggestions.\n---\n\n# Code Review Analysis\n\n## Table of Contents\n\n- [Overview](#overview)\n- [When to Use](#when-to-use)\n- [Quick Start](#quick-start)\n- [Reference Guides](#reference-guides)\n- [Best Practices](#best-practices)\n\n## Overview\n\nSystematic code review process covering code quality, security, performance, maintainability, and best practices following industry standards.\n\n## When to Use\n\n- Reviewing pull requests and merge requests\n- Analyzing code quality before merging\n- Identifying security vulnerabilities\n- Providing constructive feedback to developers\n- Ensuring coding standards compliance\n- Mentoring through code review\n\n## Quick Start\n\nMinimal working example:\n\n```bash\n# Check the changes\ngit diff main...feature-branch\n\n# Review file changes\ngit diff --stat main...feature-branch\n\n# Check commit history\ngit log main...feature-branch --oneline\n```\n\n## Reference Guides\n\nDetailed implementations in the `references/` directory:\n\n| Guide | Contents |\n|---|---|\n| [Initial Assessment](references/initial-assessment.md) | Initial Assessment |\n| [Code Quality Analysis](references/code-quality-analysis.md) | Code Quality Analysis |\n| [Security Review](references/security-review.md) | Security Review |\n| [Performance Review](references/performance-review.md) | Performance Review |\n| [Testing Review](references/testing-review.md) | Testing Review |\n| [Best Practices](references/best-practices.md) | Best Practices |\n\n## Best Practices\n\n### ✅ DO\n\n- Be constructive and respectful\n- Explain the \"why\" behind suggestions\n- Provide code examples\n- Ask questions if unclear\n- Acknowledge good practices\n- Focus on important issues\n- Consider the context\n- Offer to pair program on complex issues\n\n### ❌ DON'T\n\n- Be overly critical or personal\n- Nitpick minor style issues (use automated tools)\n- Block on subjective preferences\n- Review too many changes at once (>400 lines)\n- Forget to check tests\n- Ignore security implications\n- Rush the review\n","exit_code":0,"duration":{"secs":0,"nanos":27066}},"started_at_ms":1792981722945,"completed_at_ms":1792981722945}}
{"timestamp":"2026-10-26T02:28:43.755Z","ordinal":370481,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17605-0c8f-7f42-8d4b-980a6c519c84","item":{"type":"CommandExecution","id":"exec-62b61e5f-9314-4ce3-ae15-a7057546e73c","process_id":"42743","command":["/usr/bin/zsh","-lc","git diff --find-renames --find-copies origin/main...HEAD -- cli/src/agent.ts cli/src/types.ts cli/test/experimental_and_readonly.test.ts cli/test/durable_continuity.test.ts"],"cwd":"file:///home/mike/nexus-wt/agent-readonly-current","parsed_cmd":[{"type":"unknown","cmd":"git diff --find-renames --find-copies origin/main...HEAD -- cli/src/agent.ts cli/src/types.ts cli/test/experimental_and_readonly.test.ts cli/test/durable_continuity.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"diff --git a/cli/src/agent.ts b/cli/src/agent.ts\nindex 56bdbd4..0e9935e 100644\n--- a/cli/src/agent.ts\n+++ b/cli/src/agent.ts\n@@ -859,6 +859,10 @@ export class AutonomousAgent {\n   private verificationBaselineInvalidated: boolean = false;\n   /** A persisted baseline retained only as untrusted continuity evidence after recovery. */\n   private untrustedRecoveredBaseline?: DurableTaskState[\"changeBaseline\"];\n+  private recoveredOperation?: DurableTaskState[\"operation\"];\n+  private extensionPosture?: { workspace: string; readOnly: boolean };\n+  /** Full-access intent captured at construction; effective only while the mode permits it and read-only is off. */\n+  private configuredFullAccess: boolean = false;\n   /** Evidence from the verifier run that covers the current workspace changes. Cleared by any later mutation. */\n   private verificationEvidence?: VerificationEvidence;\n   private verificationEvidenceRawOutput: string = \"\";\n@@ -1061,6 +1065,8 @@ export class AutonomousAgent {\n       this.config.readOnly = true;\n       this.config.approvalMode = \"read-only\";\n     }\n+    this.configuredFullAccess = Boolean(this.config.fullAccess);\n+    const initialReadOnly = this.isReadOnly();\n \n     this.inheritedWorktreeScope = inheritedWorktreeScope;\n     if (inheritedWorktreeScope && path.resolve(config.workspace) !== path.resolve(inheritedWorktreeScope.workspace)) {\n@@ -1097,22 +1103,23 @@ export class AutonomousAgent {\n     this.hybridSearch = new HybridSearchEngine(ws, this.client);\n     this.synthesizer = new SynthesizerEngine(ws, (command) => this.bridge.executeTool(\"run_command\", { command, timeout_secs: verifierTimeoutSecs(config.verifierTimeoutSecs) }));\n     this.browser = new BrowserDriver(ws);\n-    this.knowledge = new KnowledgeGraph(ws, { readOnly: config.readOnly });\n+    this.knowledge = new KnowledgeGraph(ws, { readOnly: initialReadOnly });\n     this.bridge = new RustCoreBridge(\n       ws,\n       config.shell,\n       config.coreBinaryPath,\n       config.dryRun,\n-      config.readOnly,\n+      initialReadOnly,\n       inheritedWorktreeScope ? (config.sandbox || \"auto\") : config.sandbox,\n       Boolean(inheritedWorktreeScope?.requireSandbox),\n     );\n     this.bridge.setVerifierTimeoutSecs(config.verifierTimeoutSecs);\n     this.securityManager = new SecurityManager(ws);\n     this.ui = new TerminalUI();\n-    this.skillManager = new SkillManager(ws, { readOnly: config.readOnly });\n-    this.mcpManager = new McpClientManager(ws, { readOnly: config.readOnly });\n-    this.pluginManager = new PluginManager(ws, { readOnly: config.readOnly });\n+    this.skillManager = new SkillManager(ws, { readOnly: initialReadOnly });\n+    this.mcpManager = new McpClientManager(ws, { readOnly: initialReadOnly });\n+    this.pluginManager = new PluginManager(ws, { readOnly: initialReadOnly });\n+    this.extensionPosture = { workspace: ws, readOnly: initialReadOnly };\n     this.worktreeManager = new WorktreeManager(ws);\n     if (config.recordFlight) {\n       this.flightRecorder = new FlightRecorder(ws);\n@@ -1121,8 +1128,8 @@ export class AutonomousAgent {\n     this.candidateTracker = new CandidateTracker();\n     this.capabilityRegistry = createDefaultRegistry();\n     this.authorityEngine = new AuthorityAdmissionEngine({\n-      readOnly: config.readOnly,\n-      fullAccess: config.fullAccess ?? false,\n+      readOnly: initialReadOnly,\n+      fullAccess: Boolean(config.fullAccess) && !initialReadOnly,\n       workspace: ws,\n       registry: this.capabilityRegistry,\n     });\n@@ -1259,18 +1266,63 @@ export class AutonomousAgent {\n   }\n \n   public setApprovalMode(mode: ApprovalMode): void {\n+    // Read-only selected at runtime is a mode choice, not an explicit launch invariant: record that so a later\n+    // /mode auto or /mode review can deliberately leave it, exactly like --mode read-only.\n+    if (mode === \"read-only\" && !this.config.readOnly && !this.config.readOnlyModeSelected) {\n+      this.config.readOnlyModeSelected = true;\n+    }\n+    // config.readOnly is the configured (launch or deliberate mode) posture. The checkpoint fallback is transient\n+    // and must never leak into it, or releasing the fallback could never restore the operator's mode.\n+    const configuredReadOnly = this.modeReadOnly(mode);\n     this.config.approvalMode = mode;\n-    if (mode !== \"auto\") {\n-      this.config.fullAccess = false;\n-    }\n+    this.config.readOnly = configuredReadOnly;\n+    this.config.fullAccess = mode === \"auto\" ? this.configuredFullAccess : false;\n+    this.applyReadOnlyAuthority(this.checkpointReadOnlyFallback || configuredReadOnly);\n     this.clearApprovedEgressOrigins();\n     this.clearApprovedVerifiers();\n   }\n \n+  /** Read-only configured by an explicit launch or by a deliberate mode choice (not the transient fallback). */\n+  private modeReadOnly(mode: ApprovalMode): boolean {\n+    return Boolean((this.config.readOnly && !this.config.readOnlyModeSelected) || mode === \"read-only\");\n+  }\n+\n+  /** Effective read-only authority for a permission mode, including the transient checkpoint fallback. */\n+  private readOnlyForMode(mode: ApprovalMode): boolean {\n+    return Boolean(this.checkpointReadOnlyFallback || this.modeReadOnly(mode));\n+  }\n+\n+  private applyReadOnlyAuthority(readOnly: boolean): void {\n+    this.bridge?.setReadOnly(readOnly);\n+    this.authorityEngine.setReadOnly(readOnly);\n+    this.authorityEngine.setFullAccess(Boolean(this.config.fullAccess) && !readOnly);\n+    this.applyExtensionReadOnly(readOnly);\n+  }\n+\n+  /** Keep workspace-scoped extension managers on the same effective posture as the bridge and authority. */\n+  private applyExtensionReadOnly(readOnly: boolean): void {\n+    // A permission-mode change that does not alter the effective posture (review <-> auto) must not tear down\n+    // connected MCP servers, loaded plugins or the current turn's extensibility state.\n+    const workspace = this.config.workspace;\n+    if (this.extensionPosture?.workspace === workspace && this.extensionPosture.readOnly === readOnly) return;\n+    if (this.knowledge) this.knowledge.setWorkspace(workspace, { readOnly });\n+    if (this.skillManager) this.skillManager.setWorkspace(workspace, { readOnly });\n+    if (this.mcpManager) {\n+      this.mcpManager.shutdownAll();\n+      this.mcpManager = new McpClientManager(workspace, { readOnly });\n+    }\n+    if (this.pluginManager) {\n+      this.pluginManager = new PluginManager(workspace, { readOnly });\n+      if (this.flightRecorder) this.pluginManager.setFlightRecorder(this.flightRecorder);\n+    }\n+    this.extensibilityInitialized = false;\n+    this.extensionPosture = { workspace, readOnly };\n+  }\n+\n   public getApprovalMode(): ApprovalMode {\n     // An explicit --read-only launch is an operator invariant: a later mode change (the /mode slash command,\n     // setApprovalMode) must not lower it. The checkpoint fallback is the same class of restriction.\n-    if (this.checkpointReadOnlyFallback || this.config.readOnly) return \"read-only\";\n+    if (this.readOnlyForMode(this.config.approvalMode ?? \"review\")) return \"read-only\";\n     if (this.config.approvalMode) return this.config.approvalMode;\n     if (this.config.fullAccess) return \"auto\";\n     // Workspace trust controls project instructions and integrations; permission settings alone select approval posture.\n@@ -1280,6 +1332,7 @@ export class AutonomousAgent {\n   /** Restrict this session to read-only authority when its workspace cannot be safely checkpointed. */\n   public setCheckpointReadOnlyFallback(enabled: boolean): void {\n     this.checkpointReadOnlyFallback = enabled;\n+    this.applyReadOnlyAuthority(this.readOnlyForMode(this.config.approvalMode ?? \"review\"));\n     if (enabled) {\n       this.clearApprovedEgressOrigins();\n       this.clearApprovedVerifiers();\n@@ -1287,7 +1340,9 @@ export class AutonomousAgent {\n   }\n \n   private isReadOnly(): boolean {\n-    return Boolean(this.config.readOnly || this.checkpointReadOnlyFallback);\n+    // An explicit launch is authoritative; a mode-selected read-only posture is enforced until the operator\n+    // deliberately changes the mode, and the checkpoint fallback is authoritative for the current turn.\n+    return this.readOnlyForMode(this.config.approvalMode ?? \"review\");\n   }\n \n   private initTaskState(): void {\n@@ -1351,6 +1406,7 @@ export class AutonomousAgent {\n       unverifiedChangesPending: this.hasPendingModifications,\n       durableNotes: notes ? [notes] : undefined,\n       ...(this.compactionProvenance ? { compactionProvenance: this.compactionProvenance } : {}),\n+      ...(this.recoveredOperation !== undefined ? { operation: this.recoveredOperation } : {}),\n       providerRecovery: this.activeProviderRecovery,\n       objective: this.objective ?? null,\n       findings: this.getFindings(),\n@@ -1421,6 +1477,8 @@ export class AutonomousAgent {\n     this.messages = state.messages || [];\n     this.restoreFindings(state.findings);\n     this.objective = state.objective ?? undefined;\n+    this.activeProviderRecovery = state.providerRecovery ?? null;\n+    this.recoveredOperation = state.operation;\n     // Durable task state is writable by the same local user who can run candidate\n     // commands. Never trust a saved baseline, nor capture a new one over a\n     // resumed workspace with pending changes: an attacker could delete the field\n@@ -1507,10 +1565,11 @@ export class AutonomousAgent {\n       await this.pluginManager.loadPlugins();\n       await this.mcpManager.loadAndConnect();\n       this.extensibilityInitialized = true;\n-      const skipped = untrustedWorkspaceExtensions(this.config.workspace, this.config.readOnly);\n+      const readOnly = this.isReadOnly();\n+      const skipped = untrustedWorkspaceExtensions(this.config.workspace, readOnly);\n       if (skipped.length && this.depth === 0) {\n         const names = skipped.map((file) => path.relative(this.config.workspace, file)).join(\", \");\n-        const text = this.config.readOnly\n+        const text = readOnly\n           ? `Workspace MCP servers and plugins are not loaded in read-only mode (${names}).`\n           : `Workspace MCP servers and plugins are not loaded because this workspace is not trusted (${names}). Run \\`nexus trust\\` in it to allow them.`;\n         if (this.observer?.onNotice) this.observer.onNotice(text);\n@@ -1726,7 +1785,13 @@ export class AutonomousAgent {\n     this.findingsCondensed = recorded.some((state) => state.reduced);\n   }\n \n-  public restoreSession(msgs: ChatMessage[], unverifiedChangesPending?: boolean, objective?: ObjectiveLedger | null, findings?: readonly string[] | null): void {\n+  public restoreSession(\n+    msgs: ChatMessage[],\n+    unverifiedChangesPending?: boolean,\n+    objective?: ObjectiveLedger | null,\n+    findings?: readonly string[] | null,\n+    recovery?: Pick<DurableTaskState, \"providerRecovery\" | \"operation\" | \"changeBaseline\">,\n+  ): void {\n     this.approvedEgressOrigins.clear();\n     this.approvedVerifiers.clear();\n     this.messages = [...msgs];\n@@ -1738,6 +1803,9 @@ export class AutonomousAgent {\n       this.objective.continuation = { ...this.objective.continuation, segments: 1, lastProgressStep: 0 };\n     }\n     this.settleUnrecordedToolCalls();\n+    this.activeProviderRecovery = recovery?.providerRecovery ?? null;\n+    this.recoveredOperation = recovery?.operation;\n+    this.untrustedRecoveredBaseline = recovery?.changeBaseline ?? undefined;\n     // Session files are writable by the same local identity that can run candidate\n     // commands. Their pending flag and any verifier snapshot cannot authenticate\n     // that the workspace remained unchanged since the session was saved. Treat\n@@ -2045,6 +2113,8 @@ export class AutonomousAgent {\n     const hasTrustedInMemoryBaseline = workspaceIdentityIsCurrent && this.changeBaseline !== undefined && !this.verificationBaselineInvalidated;\n     if (!hasTrustedInMemoryBaseline) this.changeBaseline = undefined;\n     this.verificationBaselineInvalidated = this.verificationBaselineInvalidated || (this.hasPendingModifications && !hasTrustedInMemoryBaseline);\n+    this.recoveredOperation = undefined;\n+    this.activeProviderRecovery = null;\n     this.enabledToolGroups = new Set();\n     this.stepNoticeStep = 0;\n     this.cutResponse = undefined;\n@@ -2120,6 +2190,7 @@ export class AutonomousAgent {\n         this.primaryWorkspacePathIdentity = selectedWorkspace;\n       }\n     }\n+    const readOnly = this.isReadOnly();\n     this.bridge.shutdown();\n     this.mcpManager.shutdownAll();\n     this.workspacePathIdentity = selectedWorkspace;\n@@ -2134,22 +2205,19 @@ export class AutonomousAgent {\n       this.config.shell,\n       this.config.coreBinaryPath,\n       this.config.dryRun,\n-      this.config.readOnly,\n+      readOnly,\n       this.bridgeSandboxSetting(),\n       Boolean(this.activeWorktree) || Boolean(this.inheritedWorktreeScope?.requireSandbox),\n     );\n-    this.skillManager.setWorkspace(newWorkspace);\n+    this.applyReadOnlyAuthority(readOnly);\n     // During an internally managed isolation switch, retain the manager bound\n     // to the selected original workspace; the active checkout is only a\n     // specimen worktree, not the repository manager's authority root.\n     if (!this.managedWorktreeWorkspaceSwitch) this.worktreeManager = new WorktreeManager(newWorkspace);\n-    this.mcpManager = new McpClientManager(newWorkspace, { readOnly: this.config.readOnly });\n-    this.pluginManager = new PluginManager(newWorkspace, { readOnly: this.config.readOnly });\n     this.hybridSearch = new HybridSearchEngine(newWorkspace, this.client);\n     this.synthesizer = new SynthesizerEngine(newWorkspace, (command) => this.bridge.executeTool(\"run_command\", { command, timeout_secs: 120 }));\n     this.browser = new BrowserDriver(newWorkspace);\n-    this.knowledge = new KnowledgeGraph(newWorkspace, { readOnly: this.config.readOnly });\n-    this.skillManager.setWorkspace(newWorkspace, { readOnly: this.config.readOnly });\n+    this.knowledge = new KnowledgeGraph(newWorkspace, { readOnly });\n     this.extensibilityInitialized = false;\n     this.setupSpineHandlers();\n     this.resetConversation();\n@@ -2157,6 +2225,7 @@ export class AutonomousAgent {\n \n   public setShell(newShell: string): void {\n     if (newShell !== this.config.shell) this.invalidateVerificationBaseline();\n+    const readOnly = this.isReadOnly();\n     this.bridge.shutdown();\n     this.config.shell = newShell;\n     this.bridge = new RustCoreBridge(\n@@ -2164,10 +2233,11 @@ export class AutonomousAgent {\n       this.config.shell,\n       this.config.coreBinaryPath,\n       this.config.dryRun,\n-      this.config.readOnly,\n+      readOnly,\n       this.bridgeSandboxSetting(),\n       Boolean(this.activeWorktree) || Boolean(this.inheritedWorktreeScope?.requireSandbox),\n     );\n+    this.applyReadOnlyAuthority(readOnly);\n     this.setupSpineHandlers();\n     this.resetConversation();\n   }\n@@ -2268,10 +2338,19 @@ export class AutonomousAgent {\n    * the archive (interrupted compactions set aside, torn lines, missing originals), or undefined when it is whole.\n    */\n   public restoreConversation(\n-    session: { messages: ChatMessage[]; unverifiedChangesPending?: boolean; objective?: ObjectiveLedger | null; findings?: readonly string[] | null; history?: any },\n+    session: {\n+      messages: ChatMessage[];\n+      unverifiedChangesPending?: boolean;\n+      objective?: ObjectiveLedger | null;\n+      findings?: readonly string[] | null;\n+      history?: any;\n+      providerRecovery?: DurableTaskState[\"providerRecovery\"];\n+      operation?: DurableTaskState[\"operation\"];\n+      changeBaseline?: DurableTaskState[\"changeBaseline\"];\n+    },\n     readArchive: (committed?: ReadonlySet<string>) => ArchiveRead<ChatMessage>,\n   ): string | undefined {\n-    this.restoreSession(session.messages, session.unverifiedChangesPending, session.objective, session.findings);\n+    this.restoreSession(session.messages, session.unverifiedChangesPending, session.objective, session.findings, session);\n     this.restoreHistory(session.history);\n     const committed = Array.isArray(session.history?.committedCompactions) ? new Set<string>(session.history.committedCompactions) : undefined;\n     const read = readArchive(committed);\ndiff --git a/cli/src/types.ts b/cli/src/types.ts\nindex 520d29a..ee0c947 100644\n--- a/cli/src/types.ts\n+++ b/cli/src/types.ts\n@@ -70,6 +70,7 @@ export interface HarnessConfig {\n   coreBinaryPath?: string;   // Path to compiled harness-core executable\n   dryRun?: boolean;          // Dry-run simulation mode without persisting file modifications\n   readOnly?: boolean;        // Reject all mutating tool executions and commands\n+  readOnlyModeSelected?: boolean; // Read-only is mode-selected (not the explicit --read-only launch) and may be changed deliberately\n   approvalMode?: \"auto\" | \"review\" | \"read-only\"; // Permission posture: auto, review, or read-only (DEC-01, independent of folder trust)\n   yes?: boolean;             // Run non-interactively without confirmation prompts (forces auto mode)\n   fullAccess?: boolean;      // Broad full-access mode executing without confirmation prompts (AUTH-007, AUTH-008)\ndiff --git a/cli/test/durable_continuity.test.ts b/cli/test/durable_continuity.test.ts\nindex 9feab76..9e4e3d6 100644\n--- a/cli/test/durable_continuity.test.ts\n+++ b/cli/test/durable_continuity.test.ts\n@@ -1703,3 +1703,37 @@ describe(\"durable operation records match their start whatever the provider's ca\n     }\n   });\n });\n+\n+\n+test(\"session continuation restores recovery fields without trusting its verifier baseline\", async () => {\n+  await withHome(async () => {\n+    const gw = await gateway(() => done());\n+    const repo = makeRepo();\n+    const now = new Date().toISOString();\n+    const operation = newOperation(\"resume-operation\", \"resume operation\", [{ id: \"unit\", prompt: \"continue\" }], [], Date.now());\n+    const providerRecovery = {\n+      state: \"WAITING\", step: 1, startedAt: now, updatedAt: now, condition: \"RATE_LIMITED\", submissions: [], probes: 0, waitedMs: 0, unknownReplays: 0,\n+      policy: { deadlineMs: 1000, maxDelayMs: 100, maxUnknownReplays: 1 },\n+    };\n+    const changeBaseline = { command: \"npm test\", failed: true, tests: null, at: now };\n+    const agent = quiet(new AutonomousAgent(cfg(gw, repo), 0, undefined, { durable: false }));\n+    try {\n+      agent.restoreConversation({\n+        messages: [{ role: \"user\", content: \"continue\" }],\n+        operation,\n+        providerRecovery,\n+        changeBaseline,\n+      } as any, () => ({ messages: [], unreadableLines: 0, uncommittedLines: 0, missingCompactions: [] }));\n+      const saved = agent.checkpointDurableState();\n+      assert.equal(saved.operation?.id, operation.id);\n+      assert.deepEqual(saved.providerRecovery, providerRecovery);\n+      assert.deepEqual(saved.changeBaseline, changeBaseline);\n+      assert.equal((agent as any).verificationBaselineInvalidated, true);\n+      assert.equal((agent as any).changeBaseline, null);\n+    } finally {\n+      agent.shutdown();\n+      await gw.close();\n+      fs.rmSync(repo, { recursive: true, force: true });\n+    }\n+  });\n+});\ndiff --git a/cli/test/experimental_and_readonly.test.ts b/cli/test/experimental_and_readonly.test.ts\nindex 16adea7..1b79dd5 100644\n--- a/cli/test/experimental_and_readonly.test.ts\n+++ b/cli/test/experimental_and_readonly.test.ts\n@@ -19,6 +19,7 @@ import { fileURLToPath } from \"node:url\";\n import { slashCatalog } from \"../src/slash/catalog.js\";\n import { BenchmarkEvaluator, SweBenchInstance } from \"../src/evaluator.js\";\n import { AutonomousAgent } from \"../src/agent.js\";\n+import { buildConfig } from \"../src/config.js\";\n import { isReadOnlyRole, READ_ONLY_ROLES } from \"../src/core/roles.js\";\n import { copyToClipboard } from \"../src/clipboard.js\";\n import { encodeImageFile, MAX_IMAGE_BYTES } from \"../src/image.js\";\n@@ -261,3 +262,121 @@ index 1111111..2222222 100644\n     assert.ok(files[0].hunks[0].lines.length >= 4);\n   });\n });\n+\n+function extensionManagersReadOnly(agent: AutonomousAgent): boolean[] {\n+  return [\n+    (agent as any).skillManager.readOnly,\n+    (agent as any).mcpManager.readOnly,\n+    (agent as any).pluginManager.readOnly,\n+    (agent as any).knowledge.readOnly,\n+  ];\n+}\n+\n+test(\"mode-selected read-only can be deliberately changed, unlike an explicit read-only launch\", async () => {\n+  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-readonly-mode-change-\"));\n+  try {\n+    const selected = new AutonomousAgent(buildConfig({ mode: \"read-only\", workspace: root }), 0, { durable: false });\n+    assert.equal(selected.getApprovalMode(), \"read-only\");\n+    assert.equal((selected as any).isReadOnly(), true, \"mode-selected read-only is enforced before it is changed\");\n+    assert.equal((selected as any).bridge.readOnly, true, \"the tool bridge starts read-only\");\n+    assert.equal((selected as any).authorityEngine.isReadOnly(), true, \"authority starts read-only\");\n+    assert.deepEqual(extensionManagersReadOnly(selected), [true, true, true, true], \"all extension managers start read-only\");\n+    selected.setApprovalMode(\"auto\");\n+    assert.equal(selected.getApprovalMode(), \"auto\");\n+    assert.equal((selected as any).isReadOnly(), false);\n+    assert.equal((selected as any).bridge.readOnly, false, \"changing the mode restores write authority\");\n+    assert.equal((selected as any).authorityEngine.isReadOnly(), false, \"authority also restores write authority\");\n+    assert.deepEqual(extensionManagersReadOnly(selected), [false, false, false, false]);\n+    selected.shutdown();\n+\n+    const explicit = new AutonomousAgent(buildConfig({ readOnly: true, workspace: root }), 0, { durable: false });\n+    explicit.setApprovalMode(\"auto\");\n+    assert.equal(explicit.getApprovalMode(), \"read-only\");\n+    assert.equal((explicit as any).isReadOnly(), true);\n+    assert.equal((explicit as any).bridge.readOnly, true, \"an explicit --read-only launch cannot lower the bridge\");\n+    assert.equal((explicit as any).authorityEngine.isReadOnly(), true);\n+    assert.deepEqual(extensionManagersReadOnly(explicit), [true, true, true, true]);\n+    explicit.shutdown();\n+\n+    const runtime = new AutonomousAgent(buildConfig({ workspace: root }), 0, { durable: false });\n+    runtime.setApprovalMode(\"read-only\");\n+    assert.equal(runtime.getApprovalMode(), \"read-only\");\n+    assert.equal((runtime as any).isReadOnly(), true);\n+    assert.equal((runtime as any).bridge.readOnly, true);\n+    assert.equal((runtime as any).authorityEngine.isReadOnly(), true);\n+    runtime.setApprovalMode(\"auto\");\n+    assert.equal(runtime.getApprovalMode(), \"auto\", \"runtime mode-selected read-only can be left deliberately\");\n+    assert.equal((runtime as any).isReadOnly(), false);\n+    assert.equal((runtime as any).bridge.readOnly, false);\n+    assert.equal((runtime as any).authorityEngine.isReadOnly(), false);\n+    assert.deepEqual(extensionManagersReadOnly(runtime), [false, false, false, false]);\n+    runtime.shutdown();\n+\n+    const stable = new AutonomousAgent(buildConfig({ mode: \"review\", workspace: root }), 0, { durable: false });\n+    const stableMcp = (stable as any).mcpManager;\n+    const stablePlugins = (stable as any).pluginManager;\n+    (stable as any).extensibilityInitialized = true;\n+    stable.setApprovalMode(\"auto\");\n+    assert.strictEqual((stable as any).mcpManager, stableMcp, \"review->auto must not recreate MCP\");\n+    assert.strictEqual((stable as any).pluginManager, stablePlugins, \"review->auto must not recreate plugins\");\n+    assert.equal((stable as any).extensibilityInitialized, true, \"review->auto keeps extensibility initialized\");\n+    stable.setApprovalMode(\"read-only\");\n+    assert.notStrictEqual((stable as any).mcpManager, stableMcp, \"an effective read-only change refreshes MCP posture\");\n+    assert.notStrictEqual((stable as any).pluginManager, stablePlugins, \"an effective read-only change refreshes plugins\");\n+    stable.shutdown();\n+\n+    const fallback = new AutonomousAgent(buildConfig({ mode: \"review\", workspace: root }), 0, { durable: false });\n+    fallback.setCheckpointReadOnlyFallback(true);\n+    assert.equal(fallback.getApprovalMode(), \"read-only\");\n+    assert.equal((fallback as any).config.readOnly, false, \"the transient fallback must not leak into config\");\n+    assert.equal((fallback as any).bridge.readOnly, true);\n+    assert.equal((fallback as any).authorityEngine.isReadOnly(), true);\n+    assert.deepEqual(extensionManagersReadOnly(fallback), [true, true, true, true]);\n+    fallback.setApprovalMode(\"auto\");\n+    assert.equal(fallback.getApprovalMode(), \"read-only\", \"the active fallback remains authoritative\");\n+    assert.equal((fallback as any).config.readOnly, false);\n+    assert.equal((fallback as any).bridge.readOnly, true);\n+    assert.equal((fallback as any).authorityEngine.isReadOnly(), true);\n+    const other = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-readonly-mode-other-\"));\n+    try {\n+      fallback.setWorkspace(other);\n+      assert.equal((fallback as any).isReadOnly(), true, \"workspace switch keeps the fallback\");\n+      assert.equal((fallback as any).bridge.readOnly, true, \"workspace switch rebuilds a read-only bridge\");\n+      assert.equal((fallback as any).authorityEngine.isReadOnly(), true);\n+      assert.deepEqual(extensionManagersReadOnly(fallback), [true, true, true, true]);\n+      fallback.setShell(\"bash\");\n+      assert.equal((fallback as any).bridge.readOnly, true, \"shell switch keeps the fallback bridge read-only\");\n+      assert.equal((fallback as any).authorityEngine.isReadOnly(), true);\n+      assert.deepEqual(extensionManagersReadOnly(fallback), [true, true, true, true]);\n+    } finally {\n+      fs.rmSync(other, { recursive: true, force: true });\n+    }\n+    fallback.setCheckpointReadOnlyFallback(false);\n+    assert.equal(fallback.getApprovalMode(), \"auto\", \"the queued auto mode resumes after the fallback\");\n+    assert.equal((fallback as any).bridge.readOnly, false);\n+    assert.equal((fallback as any).authorityEngine.isReadOnly(), false);\n+    assert.deepEqual(extensionManagersReadOnly(fallback), [false, false, false, false]);\n+    fallback.shutdown();\n+\n+    const full = new AutonomousAgent(buildConfig({ yes: true, workspace: root }), 0, { durable: false });\n+    assert.equal((full as any).authorityEngine.isFullAccess(), true, \"full-access launch starts unrestricted\");\n+    full.setApprovalMode(\"read-only\");\n+    assert.equal((full as any).authorityEngine.isReadOnly(), true);\n+    assert.equal((full as any).authorityEngine.isFullAccess(), false, \"read-only clears engine full access\");\n+    assert.equal((full as any).config.fullAccess, false);\n+    const outside = await (full as any).authorityEngine.confine(\n+      { toolName: \"read_file\", args: { path: \"/etc/passwd\" }, actor: \"agent\", executionDomain: \"agent_orchestration\" },\n+      { workspaceRoot: root },\n+    );\n+    assert.equal(outside.confined, false, \"read-only cannot read outside the workspace\");\n+    full.setApprovalMode(\"auto\");\n+    assert.equal((full as any).authorityEngine.isFullAccess(), true, \"configured full access returns in auto mode\");\n+    full.setCheckpointReadOnlyFallback(true);\n+    assert.equal((full as any).authorityEngine.isFullAccess(), false, \"the fallback disables engine full access\");\n+    full.setCheckpointReadOnlyFallback(false);\n+    assert.equal((full as any).authorityEngine.isFullAccess(), true, \"releasing the fallback restores engine full access\");\n+    full.shutdown();\n+  } finally {\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n","exit_code":0,"duration":{"secs":0,"nanos":731956241}},"started_at_ms":1792981723019,"completed_at_ms":1792981723752}}
{"timestamp":"2026-10-26T02:28:44.817Z","ordinal":370482,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17609-ee91-73c1-ac73-afbf765cc76d","call_id":"call_b08960e703cc4a208576cb9e17a53682","output":[{"type":"input_text","text":"Script completed\nWall time 2.9 seconds\nOutput:\n"},{"type":"input_text","text":"---\nname: code-review-analysis\ndescription: >\n  Perform comprehensive code reviews with best practices, security checks, and\n  constructive feedback. Use when reviewing pull requests, analyzing code\n  quality, checking for security vulnerabilities, or providing code improvement\n  suggestions.\n---\n\n# Code Review Analysis\n\n## Table of Contents\n\n- [Overview](#overview)\n- [When to Use](#when-to-use)\n- [Quick Start](#quick-start)\n- [Reference Guides](#reference-guides)\n- [Best Practices](#best-practices)\n\n## Overview\n\nSystematic code review process covering code quality, security, performance, maintainability, and best practices following industry standards.\n\n## When to Use\n\n- Reviewing pull requests and merge requests\n- Analyzing code quality before merging\n- Identifying security vulnerabilities\n- Providing constructive feedback to developers\n- Ensuring coding standards compliance\n- Mentoring through code review\n\n## Quick Start\n\nMinimal working example:\n\n```bash\n# Check the changes\ngit diff main...feature-branch\n\n# Review file changes\ngit diff --stat main...feature-branch\n\n# Check commit history\ngit log main...feature-branch --oneline\n```\n\n## Reference Guides\n\nDetailed implementations in the `references/` directory:\n\n| Guide | Contents |\n|---|---|\n| [Initial Assessment](references/initial-assessment.md) | Initial Assessment |\n| [Code Quality Analysis](references/code-quality-analysis.md) | Code Quality Analysis |\n| [Security Review](references/security-review.md) | Security Review |\n| [Performance Review](references/performance-review.md) | Performance Review |\n| [Testing Review](references/testing-review.md) | Testing Review |\n| [Best Practices](references/best-practices.md) | Best Practices |\n\n## Best Practices\n\n### ✅ DO\n\n- Be constructive and respectful\n- Explain the \"why\" behind suggestions\n- Provide code examples\n- Ask questions if unclear\n- Acknowledge good practices\n- Focus on important issues\n- Consider the context\n- Offer to pair program on complex issues\n\n### ❌ DON'T\n\n- Be overly critical or personal\n- Nitpick minor style issues (use automated tools)\n- Block on subjective preferences\n- Review too many changes at once (>400 lines)\n- Forget to check tests\n- Ignore security implications\n- Rush the review\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 6881)\nTotal output lines: 481\n\ndiff --git a/cli/src/agent.ts b/cli/src/agent.ts\nindex 56bdbd4..0e9935e 100644\n--- a/cli/src/agent.ts\n+++ b/cli/src/agent.ts\n@@ -859,6 +859,10 @@ export class AutonomousAgent {\n   private verificationBaselineInvalidated: boolean = false;\n   /** A persisted baseline retained only as untrusted continuity evidence after recovery. */\n   private untrustedRecoveredBaseline?: DurableTaskState[\"changeBaseline\"];\n+  private recoveredOperation?: DurableTaskState[\"operation\"];\n+  private extensionPosture?: { workspace: string; readOnly: boolean };\n+  /** Full-access intent captured at construction; effective only while the mode permits it and read-only is off. */\n+  private configuredFullAccess: boolean = false;\n   /** Evidence from the verifier run that covers the current workspace changes. Cleared by any later mutation. */\n   private verificationEvidence?: VerificationEvidence;\n   private verificationEvidenceRawOutput: string = \"\";\n@@ -1061,6 +1065,8 @@ export class AutonomousAgent {\n       this.config.readOnly = true;\n       this.config.approvalMode = \"read-only\";\n     }\n+    this.configuredFullAccess = Boolean(this.config.fullAccess);\n+    const initialReadOnly = this.isReadOnly();\n \n     this.inheritedWorktreeScope = inheritedWorktreeScope;\n     if (inheritedWorktreeScope && path.resolve(config.workspace) !== path.resolve(inheritedWorktreeScope.workspace)) {\n@@ -1097,22 +1103,23 @@ export class AutonomousAgent {\n     this.hybridSearch = new HybridSearchEngine(ws, this.client);\n     this.synthesizer = new SynthesizerEngine(ws, (command) => this.bridge.executeTool(\"run_command\", { command, timeout_secs: verifierTimeoutSecs(config.verifierTimeoutSecs) }));\n     this.browser = new BrowserDriver(ws);\n-    this.knowledge = new KnowledgeGraph(ws, { readOnly: config.readOnly });\n+    this.knowledge = new KnowledgeGraph(ws, { readOnly: initialReadOnly });\n     this.bridge = new RustCoreBridge(\n       ws,\n       config.shell,\n       config.coreBinaryPath,\n       config.dryRun,\n-      config.readOnly,\n+      initialReadOnly,\n       inheritedWorktreeScope ? (config.sandbox || \"auto\") : config.sandbox,\n       Boolean(inheritedWorktreeScope?.requireSandbox),\n     );\n     this.bridge.setVerifierTimeoutSecs(config.verifierTimeoutSecs);\n     this.securityManager = new SecurityManager(ws);\n     this.ui = new TerminalUI();\n-    this.skillManager = new SkillManager(ws, { readOnly: config.readOnly });\n-    this.mcpManager = new McpClientManager(ws, { readOnly: config.readOnly });\n-    this.pluginManager = new PluginManager(ws, { readOnly: config.readOnly });\n+    this.skillManager = new SkillManager(ws, { readOnly: initialReadOnly });\n+    this.mcpManager = new McpClientManager(ws, { readOnly: initialReadOnly });\n+    this.pluginManager = new PluginManager(ws, { readOnly: initialReadOnly });\n+    this.extensionPosture = { workspace: ws, readOnly: initialReadOnly };\n     this.worktreeManager = new WorktreeManager(ws);\n     if (config.recordFlight) {\n       this.flightRecorder = new FlightRecorder(ws);\n@@ -1121,8 +1128,8 @@ export class AutonomousAgent {\n     this.candidateTracker = new CandidateTracker();\n     this.capabilityRegistry = createDefaultRegistry();\n     this.authorityEngine = new AuthorityAdmissionEngine({\n-      readOnly: config.readOnly,\n-      fullAccess: config.fullAccess ?? false,\n+      readOnly: initialReadOnly,\n+      fullAccess: Boolean(config.fullAccess) && !initialReadOnly,\n       workspace: ws,\n       registry: this.capabilityRegistry,\n     });\n@@ -1259,18 +1266,63 @@ export class AutonomousAgent {\n   }\n \n   public setApprovalMode(mode: ApprovalMode): void {\n+    // Read-only selected at runtime is a mode choice, not an explicit launch invariant: record that so a later\n+    // /mode auto or /mode review can deliberately leave it, exactly like --mode read-only.\n+    if (mode === \"read-only\" && !this.config.readOnly && !this.config.readOnlyModeSelected) {\n+      this.config.readOnlyModeSelected = true;\n+    }\n+    // config.readOnly is the configured (launch or deliberate mode) posture. The checkpoint fallback is transient\n+    // and must never leak into it, or releasing the fallback could never restore the operator's mode.\n+    const configuredReadOnly = this.modeReadOnly(mode);\n     this.config.approvalMode = mode;\n-    if (mode !== \"auto\") {\n-      this.config.fullAccess = false;\n-    }\n+    this.config.readOnly = configuredReadOnly;\n+    this.config.fullAccess = mode === \"auto\" ? this.configuredFullAccess : false;\n+    this.applyReadOnlyAuthority(this.checkpointReadOnlyFallback || configuredReadOnly);\n     this.clearApprovedEgressOrigins();\n     this.clearApprovedVerifiers();\n   }\n \n+  /** Read-only configured by an explicit launch or by a deliberate mode choice (not the transient fallback). */\n+  private modeReadOnly(mode: ApprovalMode): boolean {\n+    return Boolean((this.config.readOnly && !this.config.readOnlyModeSelected) || mode === \"read-only\");\n+  }\n+\n+  /** Effective read-only authority for a permission mode, including the transient checkpoint fallback. */\n+  private readOnlyForMode(mode: ApprovalMode): boolean {\n+    return Boolean(this.checkpointReadOnlyFallback || this.modeReadOnly(mode));\n+  }\n+\n+  private applyReadOnlyAuthority(readOnly: boolean): void {\n+    this.bridge?.setReadOnly(readOnly);\n+    this.authorityEngine.setReadOnly(readOnly);\n+    this.authorityEngine.setFullAccess(Boolean(this.config.fullAccess) && !readOnly);\n+    this.applyExtensionReadOnly(readOnly);\n+  }\n+\n+  /** Keep workspace-scoped extension managers on the same effective posture as the bridge and authority. */\n+  private applyExtensionReadOnly(readOnly: boolean): void {\n+    // A permission-mode change that does not alter the effective posture (review <-> auto) must not tear down\n+    // connected MCP servers, loaded plugins or the current turn's extensibility state.\n+    const workspace = this.config.workspace;\n+    if (this.extensionPosture?.workspace === workspace && this.extensionPosture.readOnly === readOnly) return;\n+    if (this.knowledge) this.knowledge.setWorkspace(workspace, { readOnly });\n+    if (this.skillManager) this.skillManager.setWorkspace(workspace, { readOnly });\n+    if (this.mcpManager) {\n+      this.mcpManager.shutdownAll();\n+      this.mcpManager = new McpClientManager(workspace, { readOnly });\n+    }\n+    if (this.pluginManager) {\n+      this.pluginManager = new PluginManager(workspace, { readOnly });\n+      if (this.flightRecorder) this.pluginManager.setFlightRecorder(this.flightRecorder);\n+    }\n+    this.extensibilityInitialized = false;\n+    this.extensionPosture = { workspace, readOnly };\n+  }\n+\n   public getApprovalMode(): ApprovalMode {\n     // An explicit --read-only launch is an operator invariant: a later mode change (the /mode slash command,\n     // setApprovalMode) must not lower it. The checkpoint fallback is the same class of restriction.\n-    if (this.checkpointReadOnlyFallback || this.config.readOnly) return \"read-only\";\n+    if (this.readOnlyForMode(this.config.approvalMode ?? \"review\")) return \"read-only\";\n     if (this.config.approvalMode) return this.config.approvalMode;\n     if (this.config.fullAccess) return \"auto\";\n     // Workspace trust controls project instructions and integrations; permission settings alone select approval posture.\n@@ -1280,6 +1332,7 @@ export class AutonomousAgent {\n   /** Restrict this session to read-only authority when its workspace cannot be safely checkpointed. */\n   public setCheckpointReadOnlyFallback(enabled: boolean): void {\n     this.checkpointReadOnlyFallback = enabled;\n+    this.applyReadOnlyAuthority(this.readOnlyForMode(this.config.approvalMode ?? \"review\"));\n     if (enabled) {\n       this.clearApprovedEgressOrigins();\n       this.clearApprovedVerifiers();\n@@ -1287,7 +1340,9 @@ export class AutonomousAgent {\n   }\n \n   private isReadOnly(): boolean {\n-    return Boolean(this.config.readOnly || this.checkpointReadOnlyFallback);\n+    // An explicit launch is authoritative; a mode-selected read-only posture is enforced until the operator\n+    // deliberately changes the mode, and the checkpoint fallback is authoritative for the current turn.\n+    return this.readOnlyForMode(this.config.approvalMode ?? \"review\");\n   }\n \n   private initTaskState(): void {\n@@ -1351,6 +1406,7 @@ export class AutonomousAgent {\n       unverifiedChangesPending: this.hasPendingModifications,\n       durableNotes: notes ? [notes] : undefined,\n       ...(this.compactionProvenance ? { compactionProvenance: this.compactionProvenance } : {}),\n+      ...(this.recoveredOperation !== undefined ? { operation: this.recoveredOperation } : {}),\n       providerRecovery: this.activeProviderRecovery,\n       objective: this.objective ?? null,\n       findings: this.getFindings(),\n@@ -1421,6 +1477,8 @@ export class AutonomousAgent {\n     this.messages = state.messages || [];\n     this.restoreFindings(state.findings);\n     this.objective = state.objective ?? undefined;\n+    this.activeProviderRecovery = state.providerRecovery ?? null;\n+    this.recoveredOperation = state.operation;\n     // Durable task state is writable by the same local user who can run candidate\n     // commands. Never trust a saved baseline, nor capture a new one over a\n     // resumed workspace with pending changes: an attacker could delete the field\n@@ -1507,10 +1565,11 @@ export class AutonomousAgent {\n       await this.pluginManager.loadPlugins();\n       await this.mcpManager.loadAndConnect();\n       this.extensibilityInitialized = true;\n-      const skipped = untrustedWorkspaceExtensions(this.config.workspace, this.config.readOnly);\n+      const readOnly = this.isReadOnly();\n+      const skipped = untrustedWorkspaceExtensions(this.config.workspace, readOnly);\n       if (skipped.length && this.depth === 0) {\n         const names = skipped.map((file) => path.relative(this.config.workspace, file)).join(\", \");\n-        const text = this.config.readOnly\n+        const text = readOnly\n           ? `Workspace MCP serv…1881 tokens truncated…ifier baseline\", async () => {\n+  await withHome(async () => {\n+    const gw = await gateway(() => done());\n+    const repo = makeRepo();\n+    const now = new Date().toISOString();\n+    const operation = newOperation(\"resume-operation\", \"resume operation\", [{ id: \"unit\", prompt: \"continue\" }], [], Date.now());\n+    const providerRecovery = {\n+      state: \"WAITING\", step: 1, startedAt: now, updatedAt: now, condition: \"RATE_LIMITED\", submissions: [], probes: 0, waitedMs: 0, unknownReplays: 0,\n+      policy: { deadlineMs: 1000, maxDelayMs: 100, maxUnknownReplays: 1 },\n+    };\n+    const changeBaseline = { command: \"npm test\", failed: true, tests: null, at: now };\n+    const agent = quiet(new AutonomousAgent(cfg(gw, repo), 0, undefined, { durable: false }));\n+    try {\n+      agent.restoreConversation({\n+        messages: [{ role: \"user\", content: \"continue\" }],\n+        operation,\n+        providerRecovery,\n+        changeBaseline,\n+      } as any, () => ({ messages: [], unreadableLines: 0, uncommittedLines: 0, missingCompactions: [] }));\n+      const saved = agent.checkpointDurableState();\n+      assert.equal(saved.operation?.id, operation.id);\n+      assert.deepEqual(saved.providerRecovery, providerRecovery);\n+      assert.deepEqual(saved.changeBaseline, changeBaseline);\n+      assert.equal((agent as any).verificationBaselineInvalidated, true);\n+      assert.equal((agent as any).changeBaseline, null);\n+    } finally {\n+      agent.shutdown();\n+      await gw.close();\n+      fs.rmSync(repo, { recursive: true, force: true });\n+    }\n+  });\n+});\ndiff --git a/cli/test/experimental_and_readonly.test.ts b/cli/test/experimental_and_readonly.test.ts\nindex 16adea7..1b79dd5 100644\n--- a/cli/test/experimental_and_readonly.test.ts\n+++ b/cli/test/experimental_and_readonly.test.ts\n@@ -19,6 +19,7 @@ import { fileURLToPath } from \"node:url\";\n import { slashCatalog } from \"../src/slash/catalog.js\";\n import { BenchmarkEvaluator, SweBenchInstance } from \"../src/evaluator.js\";\n import { AutonomousAgent } from \"../src/agent.js\";\n+import { buildConfig } from \"../src/config.js\";\n import { isReadOnlyRole, READ_ONLY_ROLES } from \"../src/core/roles.js\";\n import { copyToClipboard } from \"../src/clipboard.js\";\n import { encodeImageFile, MAX_IMAGE_BYTES } from \"../src/image.js\";\n@@ -261,3 +262,121 @@ index 1111111..2222222 100644\n     assert.ok(files[0].hunks[0].lines.length >= 4);\n   });\n });\n+\n+function extensionManagersReadOnly(agent: AutonomousAgent): boolean[] {\n+  return [\n+    (agent as any).skillManager.readOnly,\n+    (agent as any).mcpManager.readOnly,\n+    (agent as any).pluginManager.readOnly,\n+    (agent as any).knowledge.readOnly,\n+  ];\n+}\n+\n+test(\"mode-selected read-only can be deliberately changed, unlike an explicit read-only launch\", async () => {\n+  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-readonly-mode-change-\"));\n+  try {\n+    const selected = new AutonomousAgent(buildConfig({ mode: \"read-only\", workspace: root }), 0, { durable: false });\n+    assert.equal(selected.getApprovalMode(), \"read-only\");\n+    assert.equal((selected as any).isReadOnly(), true, \"mode-selected read-only is enforced before it is changed\");\n+    assert.equal((selected as any).bridge.readOnly, true, \"the tool bridge starts read-only\");\n+    assert.equal((selected as any).authorityEngine.isReadOnly(), true, \"authority starts read-only\");\n+    assert.deepEqual(extensionManagersReadOnly(selected), [true, true, true, true], \"all extension managers start read-only\");\n+    selected.setApprovalMode(\"auto\");\n+    assert.equal(selected.getApprovalMode(), \"auto\");\n+    assert.equal((selected as any).isReadOnly(), false);\n+    assert.equal((selected as any).bridge.readOnly, false, \"changing the mode restores write authority\");\n+    assert.equal((selected as any).authorityEngine.isReadOnly(), false, \"authority also restores write authority\");\n+    assert.deepEqual(extensionManagersReadOnly(selected), [false, false, false, false]);\n+    selected.shutdown();\n+\n+    const explicit = new AutonomousAgent(buildConfig({ readOnly: true, workspace: root }), 0, { durable: false });\n+    explicit.setApprovalMode(\"auto\");\n+    assert.equal(explicit.getApprovalMode(), \"read-only\");\n+    assert.equal((explicit as any).isReadOnly(), true);\n+    assert.equal((explicit as any).bridge.readOnly, true, \"an explicit --read-only launch cannot lower the bridge\");\n+    assert.equal((explicit as any).authorityEngine.isReadOnly(), true);\n+    assert.deepEqual(extensionManagersReadOnly(explicit), [true, true, true, true]);\n+    explicit.shutdown();\n+\n+    const runtime = new AutonomousAgent(buildConfig({ workspace: root }), 0, { durable: false });\n+    runtime.setApprovalMode(\"read-only\");\n+    assert.equal(runtime.getApprovalMode(), \"read-only\");\n+    assert.equal((runtime as any).isReadOnly(), true);\n+    assert.equal((runtime as any).bridge.readOnly, true);\n+    assert.equal((runtime as any).authorityEngine.isReadOnly(), true);\n+    runtime.setApprovalMode(\"auto\");\n+    assert.equal(runtime.getApprovalMode(), \"auto\", \"runtime mode-selected read-only can be left deliberately\");\n+    assert.equal((runtime as any).isReadOnly(), false);\n+    assert.equal((runtime as any).bridge.readOnly, false);\n+    assert.equal((runtime as any).authorityEngine.isReadOnly(), false);\n+    assert.deepEqual(extensionManagersReadOnly(runtime), [false, false, false, false]);\n+    runtime.shutdown();\n+\n+    const stable = new AutonomousAgent(buildConfig({ mode: \"review\", workspace: root }), 0, { durable: false });\n+    const stableMcp = (stable as any).mcpManager;\n+    const stablePlugins = (stable as any).pluginManager;\n+    (stable as any).extensibilityInitialized = true;\n+    stable.setApprovalMode(\"auto\");\n+    assert.strictEqual((stable as any).mcpManager, stableMcp, \"review->auto must not recreate MCP\");\n+    assert.strictEqual((stable as any).pluginManager, stablePlugins, \"review->auto must not recreate plugins\");\n+    assert.equal((stable as any).extensibilityInitialized, true, \"review->auto keeps extensibility initialized\");\n+    stable.setApprovalMode(\"read-only\");\n+    assert.notStrictEqual((stable as any).mcpManager, stableMcp, \"an effective read-only change refreshes MCP posture\");\n+    assert.notStrictEqual((stable as any).pluginManager, stablePlugins, \"an effective read-only change refreshes plugins\");\n+    stable.shutdown();\n+\n+    const fallback = new AutonomousAgent(buildConfig({ mode: \"review\", workspace: root }), 0, { durable: false });\n+    fallback.setCheckpointReadOnlyFallback(true);\n+    assert.equal(fallback.getApprovalMode(), \"read-only\");\n+    assert.equal((fallback as any).config.readOnly, false, \"the transient fallback must not leak into config\");\n+    assert.equal((fallback as any).bridge.readOnly, true);\n+    assert.equal((fallback as any).authorityEngine.isReadOnly(), true);\n+    assert.deepEqual(extensionManagersReadOnly(fallback), [true, true, true, true]);\n+    fallback.setApprovalMode(\"auto\");\n+    assert.equal(fallback.getApprovalMode(), \"read-only\", \"the active fallback remains authoritative\");\n+    assert.equal((fallback as any).config.readOnly, false);\n+    assert.equal((fallback as any).bridge.readOnly, true);\n+    assert.equal((fallback as any).authorityEngine.isReadOnly(), true);\n+    const other = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-readonly-mode-other-\"));\n+    try {\n+      fallback.setWorkspace(other);\n+      assert.equal((fallback as any).isReadOnly(), true, \"workspace switch keeps the fallback\");\n+      assert.equal((fallback as any).bridge.readOnly, true, \"workspace switch rebuilds a read-only bridge\");\n+      assert.equal((fallback as any).authorityEngine.isReadOnly(), true);\n+      assert.deepEqual(extensionManagersReadOnly(fallback), [true, true, true, true]);\n+      fallback.setShell(\"bash\");\n+      assert.equal((fallback as any).bridge.readOnly, true, \"shell switch keeps the fallback bridge read-only\");\n+      assert.equal((fallback as any).authorityEngine.isReadOnly(), true);\n+      assert.deepEqual(extensionManagersReadOnly(fallback), [true, true, true, true]);\n+    } finally {\n+      fs.rmSync(other, { recursive: true, force: true });\n+    }\n+    fallback.setCheckpointReadOnlyFallback(false);\n+    assert.equal(fallback.getApprovalMode(), \"auto\", \"the queued auto mode resumes after the fallback\");\n+    assert.equal((fallback as any).bridge.readOnly, false);\n+    assert.equal((fallback as any).authorityEngine.isReadOnly(), false);\n+    assert.deepEqual(extensionManagersReadOnly(fallback), [false, false, false, false]);\n+    fallback.shutdown();\n+\n+    const full = new AutonomousAgent(buildConfig({ yes: true, workspace: root }), 0, { durable: false });\n+    assert.equal((full as any).authorityEngine.isFullAccess(), true, \"full-access launch starts unrestricted\");\n+    full.setApprovalMode(\"read-only\");\n+    assert.equal((full as any).authorityEngine.isReadOnly(), true);\n+    assert.equal((full as any).authorityEngine.isFullAccess(), false, \"read-only clears engine full access\");\n+    assert.equal((full as any).config.fullAccess, false);\n+    const outside = await (full as any).authorityEngine.confine(\n+      { toolName: \"read_file\", args: { path: \"/etc/passwd\" }, actor: \"agent\", executionDomain: \"agent_orchestration\" },\n+      { workspaceRoot: root },\n+    );\n+    assert.equal(outside.confined, false, \"read-only cannot read outside the workspace\");\n+    full.setApprovalMode(\"auto\");\n+    assert.equal((full as any).authorityEngine.isFullAccess(), true, \"configured full access returns in auto mode\");\n+    full.setCheckpointReadOnlyFallback(true);\n+    assert.equal((full as any).authorityEngine.isFullAccess(), false, \"the fallback disables engine full access\");\n+    full.setCheckpointReadOnlyFallback(false);\n+    assert.equal((full as any).authorityEngine.isFullAccess(), true, \"releasing the fallback restores engine full access\");\n+    full.shutdown();\n+  } finally {\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17605-0c8f-7f42-8d4b-980a6c519c84","create_time":1792981724.8176153}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
