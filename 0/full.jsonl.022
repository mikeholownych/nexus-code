Durable identity is already journaled. Never place the sole working\n1205-    // package in staging: cleanup or a killed process must not erase rollback.\n1206:    const backupDir = journalEntry.replacementBackupDir!;\n1207-    if (fs.existsSync(versionDir)) {\n1208:      fs.renameSync(versionDir, backupDir);\n1209-      syncDirectory(libNexus);\n1210-      options?.onProgress?.(\"package_preserved\", \"Previous package preserved for rollback.\");\n1211-    }\n1212-    fs.renameSync(packageRoot, versionDir);\n1213-    syncDirectory(libNexus);\n1214-    options?.onProgress?.(\"package_moved\", \"Staged package moved into place.\");\n--\n1326-          2\n1327-        )\n1328-      );\n1329-    } else {\n1330-      if (outcome.success) {\n1331-        console.log(`✔ Executable launcher reverted to ${outcome.revertedTo}.`);\n1332:        console.log(`Note: Run with --restore-backup <path> if state restoration is also required.`);\n1333-      } else {\n1334-        console.error(`Rollback failed: ${outcome.error}`);\n1335-      }\n1336-    }\n1337-    process.exit(outcome.success ? UPGRADE_EXIT.ok : UPGRADE_EXIT.error);\n1338-  }\n1339-\n1340:  // 2. Restore backup command\n1341-  if (options.restoreBackup) {\n1342:    const backupPath = String(options.restoreBackup);\n1343-    let restoreFailure: string | undefined;\n1344:    const restored = restoreConfigBackup(backupPath, undefined, (error) => {\n1345-      restoreFailure = error instanceof Error ? error.message : String(error);\n1346-    });\n1347-    if (isJson) {\n1348-      console.log(\n1349-        JSON.stringify(\n1350-          {\n1351-            schemaVersion: 1,\n1352-            tool: \"nexus upgrade\",\n1353-            status: restored ? \"restored\" : \"error\",\n1354:            backupPath,\n1355-            ...(restored ? {} : { error: restoreFailure ?? \"Backup path was not accepted or is unavailable.\" }),\n1356-          },\n1357-          null,\n1358-          2\n1359-        )\n1360-      );\n13