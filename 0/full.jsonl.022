tateStoreGuard(tasks, () => withStateStoreGuard(sessions, callback));\n}\n\nfunction validatePrivateTree(source: string): void {\n  if (fs.realpathSync(source) !== path.resolve(source)) throw new Error(\"Backup path is redirected\");\n  const stat = fs.lstatSync(source);\n  if (stat.isSymbolicLink() || (!stat.isDirectory() && !stat.isFile())) throw new Error(\"Backup contains unsupported files\");\n  if (stat.isDirectory()) for (const name of fs.readdirSync(source)) validatePrivateTree(path.join(source, name));\n}\nfunction copyPrivateTree(source: string, destination: string, excluded = new Set<string>()): void {\n  validatePrivateTreeExcept(source, excluded);\n  const existed = fs.existsSync(destination);\n  fs.mkdirSync(destination, { recursive:true, mode:0o700 });\n  if (fs.realpathSync(destination) !== path.resolve(destination)) throw new Error(\"Backup destination is redirected\");\n  if (!existed) syncDirectory(path.dirname(destination));\n  fs.chmodSync(destination, 0o700);\n  for (const entry of fs.readdirSync(source, { withFileTypes:true })) {\n    if (excluded.has(entry.name) || entry.name === STATE_STORE_GUARD_FILE || entry.name === STATE_RESTORE_PENDING_FILE) continue;\n    const from = path.join(source, entry.name), to = path.join(destination, entry.name);\n    if (entry.isDirectory()) copyPrivateTree(from, to);\n    else copyPrivateFileDurably(from, to);\n  }\n  syncDirectory(destination);\n}\n\n/** A backup is not returned to the journal until its bytes and directory entry are durable. */\nfunction copyPrivateFileDurably(source: string, destination: string): void {\n  const sourcePath = path.resolve(source);\n  if (fs.realpathSync(sourcePath) !== sourcePath) throw new Error(\"Backup source is redirected\");\n  const sourceFd = fs.openSync(sourcePath, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0) | (fs.constants.O_NONBLOCK ?? 0));\n  let destinationFd: number | undefined;\n  let destinationCreated = false;\n  try {\n    const opened = fs.fstatSync(sourceFd);\n    const current = fs.lstatSync(sourcePath);\n    if (!opened.isFile() || current.isSymbolicLink() || opened.dev !== current.dev || opened.ino !== current.ino) {\n      throw new Error(\"Backup source changed while opening\");\n    }\n    destinationFd = fs.openSync(destination, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | (fs.constants.O_NOFOLLOW ?? 0), 0o600);\n    destinationCreated = true;\n    const buffer = Buffer.alloc(64 * 1024);\n    let position = 0;\n    while (true) {\n      const count = fs.readSync(sourceFd, buffer, 0, buffer.length, position);\n      if (count === 0) break;\n      let written = 0;\n      while (written < count) written += fs.writeSync(destinationFd, buffer, written, count - written);\n      position += count;\n    }\n    fs.fchmodSync(destinationFd, 0o600);\n    fs.fsyncSync(destinationFd);\n    fs.closeSync(destinationFd);\n    destinationFd = undefined;\n    syncDirectory(path.dirname(destination));\n  } catch (error) {\n    if (destinationFd !== undefined) try { fs.closeSync(destinationFd); } catch {}\n    if (destinationCreated) {\n      try { fs.unlinkSync(destination); syncDirectory(path.dirname(destination)); } catch {}\n    }\n\n  const transactionId = `upg-${Date.now()}-${process.pid}`;\n  const tmpDir = path.join(libNexus, `.tmp-upgrade-${transactionId}`);\n  let journalEntry: UpgradeJournalEntry | undefined;\n  const cleanup = () => {\n    // A failed recovery keeps every artifact, including staging, for the operator.\n    if (!journalEntry || [\"complete\", \"rolled_back\"].includes(journalEntry.state)) {\n      try { fs.rmSync(tmpDir, { recursive:true, force:true }); } catch {}\n    }\n    if (lockFd !== null) {\n      try { fs.closeSync(lockFd); } catch {}\n      try {\n        const current = fs.lstatSync(lockFile, { throwIfNoEntry:false });\n        if (current?.ino === lockIno && JSON.parse(fs.readFileSync(lockFile, \"utf8\")).token === lockToken) fs.unlinkSync(lockFile);\n      } catch {}\n    }\n  };\n  try {\n    const pending = readJournal(prefix);\n    if (fs.existsSync(getJournalPath(prefix)) && (!pending || ![\"idle\", \"complete\", \"rolled_back\"].includes(pending.state))) throw new Error(\"Pending or invalid upgrade journal; run nexus upgrade --recover before starting another transaction.\");\n    options?.onProgress?.(\"pre_migration_backup\", \"Creating pre-migration configuration and state backup...\");\n    const backupResult = createPreMigrationBackup();\n    fs.mkdirSync(tmpDir, { mode:0o700 });\n    journalEntry = {\n      formatVersion:1, id:transactionId, state:\"preparing\",\n      sourceVersion:installed.version, sourceInstallDir:installed.installRoot || path.join(libNexus, installed.version),\n      sourceSymlinkTarget:path.join(installed.installRoot || path.join(libNexus, installed.version), \"bin\", \"nexus\"),\n      targetVersion, targetInstallDir:versionDir, stagingDir:tmpDir,\n      replacementBackupDir:path.join(libNexus, `.rollback-${transactionId}`),\n      displacedTargetDir:path.join(libNexus, `.failed-${transactionId}`),\n      prefix, binPath:linkPath, startedAt:new Date().toISOString(), updatedAt:new Date().toISOString(),\n      configBackupPath:backupResult.configBackupPath, stateBackupDir:backupResult.stateBackupDir,\n    };\n    writeJournal(prefix, journalEntry);\n    if (!readJournal(prefix)) throw new Error(\"Installation identity does not match the managed prefix; no package was changed.\");\n    // 4. Downloading phase\n    options?.onProgress?.(\"downloading\", `Fetching ${archiveName}...`);\n    journalEntry.state = \"downloading\";\n    journalEntry.updatedAt = new Date().toISOString();\n    writeJournal(prefix, journalEntry);\n\n","exit_code":0,"duration":{"secs":0,"nanos":819269551}},"started_at_ms":1792983322299,"completed_at_ms":1792983323119}}
