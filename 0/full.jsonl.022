44501dd614a71f5a0\"\n}\n62e541c (HEAD -> v1/defect-upgrade-backup-progress, origin/main, v1/defect-recover-worktree-conversation) Merge pull request #244 from mikeholownych/v1/readiness-rc7-current-state\n6dee7e6 (origin/v1/readiness-rc7-current-state) docs(release): reconcile RC7 and post-PR243 status\nce3c323 docs(release): label prior readiness snapshot superseded\n19d40b8 docs(release): reconcile current RC7 readiness\n82a0583 docs(release): record exact RC7 tag and source CI state\n5f40d25 docs(release): record exact-main requirements result\nc38c10c docs(release): record post-merge CodeQL result\n7e6c517 docs(release): refresh checkpoint after RC7 source merge\n","exit_code":0,"duration":{"secs":0,"nanos":45072}},"started_at_ms":1792983314072,"completed_at_ms":1792983314073}}
{"timestamp":"2026-10-26T02:55:14.906Z","ordinal":371446,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17605-0c8f-7f42-8d4b-980a6c519c84","item":{"type":"CommandExecution","id":"exec-5b78ea52-b5e2-4a0d-adf7-eb83a79ae78e","process_id":"68411","command":["/usr/bin/zsh","-lc","sed -n '1,260p' cli/src/upgrade_journal.ts; sed -n '1,260p' cli/src/upgrade.ts"],"cwd":"file:///home/mike/nexus-wt/upgrade-backup-progress","parsed_cmd":[{"type":"read","cmd":"sed -n '1,260p' cli/src/upgrade_journal.ts","name":"upgrade_journal.ts","path":"cli/src/upgrade_journal.ts"},{"type":"read","cmd":"sed -n '1,260p' cli/src/upgrade.ts","name":"upgrade.ts","path":"cli/src/upgrade.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * Upgrade Journal, Backups & Crash Recovery Engine (REQ-REL-116, ACC-UPG-09, ACC-UPG-11)\n *\n * Maintains a persistent transaction journal outside the version directory being replaced:\n * - Records stages: idle -> preparing -> downloading -> staged -> switching -> switched -> verified -> complete\n * - Automatic and explicit idempotent crash recovery (restoring previous symlink or completing verified transition)\n * - Safe pre-migration configuration and state backups with 0600 file / 0700 dir permissions\n * - Clean credential preservation without exposing secrets in journal files\n */\n\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { acquireFileGuard, releaseFileGuard, type FileGuard } from \"./core/file_guard.js\";\nimport { withStateStoreGuard, STATE_RESTORE_PENDING_FILE, STATE_STORE_GUARD_FILE } from \"./core/state_store_guard.js\";\nimport { restoreFromSources } from \"./core/state_restore.js\";\nimport { verifyInstalledRuntime } from \"./upgrade_health.js\";\n\nexport type JournalState =\n  | \"idle\"\n  | \"preparing\"\n  | \"downloading\"\n  | \"staged\"\n  | \"switching\"\n  | \"switched\"\n  | \"verified\"\n  | \"complete\"\n  | \"recovery_required\"\n  | \"rolled_back\";\n\nexport interface UpgradeJournalEntry {\n  formatVersion: 1;\n  id: string;\n  state: JournalState;\n  sourceVersion: string;\n  sourceInstallDir: string;\n  sourceSymlinkTarget: string;\n  targetVersion: string;\n  targetInstallDir: string;\n  stagingDir?: string;\n  replacementBackupDir?: string;\n  displacedTargetDir?: string;\n  prefix: string;\n  binPath: string;\n  startedAt: string;\n  updatedAt: string;\n  error?: string;\n  configBackupPath?: string;\n  stateBackupDir?: string;\n}\n\nexport interface BackupResult {\n  configBackupPath?: string;\n  stateBackupDir?: string;\n}\n\nexport function getJournalPath(prefix: string): string {\n  return path.join(prefix, \"lib\", \"nexus\", \".upgrade-journal.json\");\n}\n\nexport function readJournal(prefix: string): UpgradeJournalEntry | null {\n  const journalPath = getJournalPath(prefix);\n  if (!fs.existsSync(journalPath)) return null;\n  try {\n    if (!fs.lstatSync(journalPath).isFile() || fs.realpathSync(journalPath) !== path.resolve(journalPath)) return null;\n    const raw = fs.readFileSync(journalPath, \"utf8\");\n    const data = JSON.parse(raw);\n    if (isValidJournal(data, prefix)) {\n      return data as UpgradeJournalEntry;\n    }\n  } catch {}\n  return null;\n}\n\nfunction isValidJournal(value: any, prefix: string): value is UpgradeJournalEntry {\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) return false;\n  const states: JournalState[] = [\"idle\", \"preparing\", \"downloading\", \"staged\", \"switching\", \"switched\", \"verified\", \"complete\", \"recovery_required\", \"rolled_back\"];\n  const root = path.resolve(prefix);\n  const libRoot = path.join(root, \"lib\", \"nexus\");\n  const expectedBin = path.join(root, \"bin\", \"nexus\");\n  const versionDir = (version: unknown) => typeof version === \"string\" && /^[v]?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$/.test(version)\n    ? path.join(libRoot, version)\n    : \"\";\n  const sourceDir = versionDir(value.sourceVersion);\n  const targetDir = versionDir(value.targetVersion);\n  const expectedPath = (actual: unknown, expected: string) => typeof actual === \"string\" && expected !== \"\" && path.resolve(actual) === expected;\n  const isoDate = (date: unknown) => typeof date === \"string\" && Number.isFinite(Date.parse(date));\n\n  if (value.formatVersion !== 1 || typeof value.id !== \"string\" || value.id.length < 1 || value.id.length > 128 ||\n      !states.includes(value.state) || !sourceDir || !targetDir ||\n      !expectedPath(value.prefix, root) || !expectedPath(value.sourceInstallDir, sourceDir) ||\n      !expectedPath(value.targetInstallDir, targetDir) || !expectedPath(value.sourceSymlinkTarget, path.join(sourceDir, \"bin\", \"nexus\")) ||\n      !expectedPath(value.binPath, expectedBin) || !isoDate(value.startedAt) || !isoDate(value.updatedAt)) return false;\n\n  if (!/^[A-Za-z0-9._-]+$/.test(value.id)) return false;\n  for (const [field, name] of [[\"replacementBackupDir\", `.rollback-${value.id}`], [\"displacedTargetDir\", `.failed-${value.id}`]]) {\n    if (value[field] !== undefined && !expectedPath(value[field], path.join(libRoot, name))) return false;\n  }\n  if (sourceDir === targetDir && !value.replacementBackupDir) return false;\n  if (value.stagingDir !== undefined) {\n    if (typeof value.stagingDir !== \"string\" || path.dirname(path.resolve(value.stagingDir)) !== libRoot ||\n        !/^\\.tmp-upgrade-[A-Za-z0-9._-]{1,128}$/.test(path.basename(value.stagingDir))) return false;\n  }\n  if (value.configBackupPath !== undefined) {\n    const backups = path.join(process.env.HOME || \"\", \".config\", \"nexus\", \"backups\");\n    if (typeof value.configBackupPath !== \"string\" || path.dirname(path.resolve(value.configBackupPath)) !== backups ||\n        !/^config\\.env\\.bak\\.[A-Za-z0-9T_.-]+$/.test(path.basename(value.configBackupPath))) return false;\n  }\n  if (value.stateBackupDir !== undefined) {\n    const backups = path.join(process.env.HOME || \"\", \".nexus\", \"backups\");\n    if (typeof value.stateBackupDir !== \"string\" || path.dirname(path.resolve(value.stateBackupDir)) !== backups ||\n        !/^state-backup-[A-Za-z0-9T_.-]+$/.test(path.basename(value.stateBackupDir))) return false;\n  }\n  return true;\n}\n\nexport function writeJournal(prefix: string, entry: UpgradeJournalEntry): void {\n  const journalPath = getJournalPath(prefix);\n  const dir = path.dirname(journalPath);\n  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });\n  const tmp = `${journalPath}.tmp.${process.pid}.${Date.now()}`;\n  fs.writeFileSync(tmp, JSON.stringify(entry, null, 2), { mode: 0o600 });\n  const fd = fs.openSync(tmp, \"r\");\n  try { fs.fsyncSync(fd); } finally { fs.closeSync(fd); }\n  fs.renameSync(tmp, journalPath);\n  syncDirectory(dir);\n}\n\nexport function clearJournal(prefix: string): void {\n  const journalPath = getJournalPath(prefix);\n  if (fs.existsSync(journalPath)) {\n    try {\n      fs.unlinkSync(journalPath);\n    } catch {}\n  }\n}\n\n/**\n * Creates pre-migration backups of configuration and durable state.\n * Files are created with strict 0600 permissions in 0700 directories.\n */\nexport function createPreMigrationBackup(homeDir: string = process.env.HOME || \"\"): BackupResult {\n  const result: BackupResult = {};\n  const timestamp = new Date().toISOString().replace(/[:.]/g, \"-\");\n\n  // 1. Config backup\n  const configEnv = path.join(homeDir, \".config\", \"nexus\", \"config.env\");\n  if (fs.existsSync(configEnv)) {\n    if (!fs.lstatSync(configEnv).isFile() || fs.realpathSync(configEnv) !== path.resolve(configEnv)) throw new Error(\"Configuration backup source is redirected\");\n    const backupDir = path.join(homeDir, \".config\", \"nexus\", \"backups\");\n    const backupDirExisted = fs.existsSync(backupDir);\n    fs.mkdirSync(backupDir, { recursive: true, mode: 0o700 });\n    if (fs.realpathSync(backupDir) !== path.resolve(backupDir)) throw new Error(\"Configuration backup directory is redirected\");\n    if (!backupDirExisted) syncDirectory(path.dirname(backupDir));\n    const backupFile = path.join(backupDir, `config.env.bak.${timestamp}`);\n    copyPrivateFileDurably(configEnv, backupFile);\n    result.configBackupPath = backupFile;\n  }\n\n  // 2. State backup\n  const stateDir = path.join(homeDir, \".nexus\");\n  if (fs.existsSync(stateDir)) {\n    const stateBackupsDir = path.join(stateDir, \"backups\");\n    const stateBackupsDirExisted = fs.existsSync(stateBackupsDir);\n    fs.mkdirSync(stateBackupsDir, { recursive: true, mode: 0o700 });\n    if (fs.realpathSync(stateBackupsDir) !== path.resolve(stateBackupsDir)) throw new Error(\"State backup directory is redirected\");\n    if (!stateBackupsDirExisted) syncDirectory(stateDir);\n    const backupDest = path.join(stateBackupsDir, `state-backup-${timestamp}`);\n    // Each timestamped backup is a single immutable attempt. Never merge into\n    // an existing directory left by a collision or interrupted prior attempt.\n    fs.mkdirSync(backupDest, { mode: 0o700 });\n    syncDirectory(stateBackupsDir);\n\n    // Snapshot all durable state, not just its index. Backup directories are\n    // excluded to avoid recursion; symbolic links are refused rather than read.\n    withDurableStoreGuards(homeDir, () => copyPrivateTree(stateDir, path.join(backupDest, \"state\"), new Set([\"backups\", \"restore-control\", STATE_RESTORE_PENDING_FILE])));\n    const configDir = path.join(homeDir, \".config\", \"nexus\");\n    if (fs.existsSync(configDir)) copyPrivateTree(configDir, path.join(backupDest, \"config\"), new Set([\"backups\", STATE_RESTORE_PENDING_FILE]));\n    const metadataPath = path.join(backupDest, \"backup.json\");\n    const metadataFd = fs.openSync(metadataPath, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | (fs.constants.O_NOFOLLOW ?? 0), 0o600);\n    try {\n      fs.writeFileSync(metadataFd, JSON.stringify({ formatVersion:1, kind:\"nexus-state-config\", createdAt:new Date().toISOString() }));\n      fs.fchmodSync(metadataFd, 0o600);\n      fs.fsyncSync(metadataFd);\n    } finally { fs.closeSync(metadataFd); }\n    syncDirectory(backupDest);\n\n    result.stateBackupDir = backupDest;\n  }\n\n  return result;\n}\n\n/**\n * Restores configuration from a previous backup file.\n */\nexport function restoreConfigBackup(backupPath: string, homeDir: string = process.env.HOME || \"\", onError?: (error: unknown) => void): boolean {\n  try {\n    const resolved = path.resolve(backupPath);\n    if (fs.realpathSync(resolved) !== resolved) return false;\n    const configRoot = path.join(homeDir, \".config\", \"nexus\");\n    if (fs.lstatSync(resolved).isDirectory()) {\n      if (path.dirname(resolved) !== path.join(homeDir, \".nexus\", \"backups\") || !/^state-backup-[A-Za-z0-9T_.-]+$/.test(path.basename(resolved))) return false;\n      const metadata = JSON.parse(fs.readFileSync(path.join(resolved, \"backup.json\"), \"utf8\"));\n      if (metadata.formatVersion !== 1 || metadata.kind !== \"nexus-state-config\") return false;\n      // Validate the entire source tree before touching live configuration/state.\n      validatePrivateTree(resolved);\n      const state = path.join(resolved, \"state\");\n      const config = path.join(resolved, \"config\");\n      const sources = [];\n      if (fs.existsSync(state)) sources.push({ store: \"state\" as const, source: state, mode: \"tree\" as const });\n      if (fs.existsSync(config)) sources.push({ store: \"config\" as const, source: config, mode: \"tree\" as const });\n      return sources.length > 0 && restoreFromSources(homeDir, sources, onError);\n    }\n    // Legacy plain config backups are recognized by their canonical location\n    // and name. Archives and arbitrary files must never become config.env.\n    if (path.dirname(resolved) !== path.join(configRoot, \"backups\") || !/^config\\.env\\.bak\\.[A-Za-z0-9T_.-]+$/.test(path.basename(resolved)) || !fs.lstatSync(resolved).isFile()) return false;\n    return restoreFromSources(homeDir, [{ store:\"config\", source:resolved, mode:\"file\" }], onError);\n  } catch (error) {\n    try { onError?.(error); } catch {}\n    return false;\n  }\n}\n/** Keep permanent guard inodes even when rolling back to a backup without that store. */\n/** New clients serialize task/session multi-file snapshots in a fixed lock order. */\nfunction withDurableStoreGuards<T>(homeDir: string, callback: () => T): T {\n  const tasks = path.join(homeDir, \".nexus\", \"tasks\");\n  const sessions = path.join(homeDir, \".nexus\", \"sessions\");\n  for (const directory of [tasks, sessions]) {\n    fs.mkdirSync(directory, { recursive: true, mode: 0o700 });\n    if (fs.realpathSync(directory) !== path.resolve(directory)) throw new Error(\"State store is redirected\");\n  }\n  return withStateStoreGuard(tasks, () => withStateStoreGuard(sessions, callback));\n}\n\nfunction validatePrivateTree(source: string): void {\n  if (fs.realpathSync(source) !== path.resolve(source)) throw new Error(\"Backup path is redirected\");\n  const stat = fs.lstatSync(source);\n  if (stat.isSymbolicLink() || (!stat.isDirectory() && !stat.isFile())) throw new Error(\"Backup contains unsupported files\");\n  if (stat.isDirectory()) for (const name of fs.readdirSync(source)) validatePrivateTree(path.join(source, name));\n}\nfunction copyPrivateTree(source: string, destination: string, excluded = new Set<string>()): void {\n  validatePrivateTreeExcept(source, excluded);\n  const existed = fs.existsSync(destination);\n  fs.mkdirSync(destination, { recursive:true, mode:0o700 });\n  if (fs.realpathSync(destination) !== path.resolve(destination)) throw new Error(\"Backup destination is redirected\");\n  if (!existed) syncDirectory(path.dirname(destination));\n  fs.chmodSync(destination, 0o700);\n  for (const entry of fs.readdirSync(source, { withFileTypes:true })) {\n    if (excluded.has(entry.name) || entry.name === STATE_STORE_GUARD_FILE || entry.name === STATE_RESTORE_PENDING_FILE) continue;\n    const from = path.join(source, entry.name), to = path.join(destination, entry.name);\n    if (entry.isDirectory()) copyPrivateTree(from, to);\n    else copyPrivateFileDurably(from, to);\n  }\n  syncDirectory(destination);\n}\n\n/** A backup is not returned to the journal until its bytes and directory entry are durable. */\nfunction copyPrivateFileDurably(source: string, destination: string): void {\n  const sourcePath = path.resolve(source);\n  if (fs.realpathSync(sourcePath) !== sourcePath) throw new Error(\"Backup source is redirected\");\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as crypto from \"node:crypto\";\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { getBuildIdentity } from \"./build_identity.js\";\nimport {\n  isPathSafe,\n  isSymlinkSafe,\n  validateTarArchive,\n  safeExtractTar,\n  MAX_DOWNLOAD_BYTES,\n  MAX_EXTRACT_BYTES,\n} from \"./tar_safety.js\";\nimport {\n  ReleaseCompatibilityMetadata,\n  CURRENT_CONFIG_SCHEMA_VERSION,\n  checkReleaseCompatibility,\n  validateCompatibilityMetadata,\n  validateCompatibilityAssetBinding,\n  COMPATIBILITY_METADATA_FILENAME,\n} from \"./compatibility.js\";\nimport { verifyInstalledRuntime } from \"./upgrade_health.js\";\nimport { CURRENT_STATE_SCHEMA_VERSION } from \"./core/state.js\";\nimport {\n  UpgradeJournalEntry,\n  readJournal,\n  writeJournal,\n  clearJournal,\n  createPreMigrationBackup,\n  restoreConfigBackup,\n  recoverUpgrade,\n  getJournalPath,\n  syncDirectory,\n  acquireReclaimGuard,\n  releaseReclaimGuard,\n} from \"./upgrade_journal.js\";\n\nexport const CANONICAL_REPO = \"mikeholownych/nexus-code\";\nexport const DEFAULT_RELEASES_API = `https://api.github.com/repos/${CANONICAL_REPO}/releases`;\nexport const DEFAULT_RELEASE_BASE_URL = `https://github.com/${CANONICAL_REPO}/releases`;\n\nexport type InstallProvenance = \"packaged\" | \"development\" | \"package-manager\" | \"unsupported\";\nexport type UpgradeAction = \"upgrade\" | \"downgrade\" | \"reinstall\" | \"none\";\n\nexport interface ProvenanceRecord {\n  formatVersion: 1;\n  method: \"packaged\" | \"installer\" | \"upgrade\";\n  product: \"nexus-code\";\n  version: string;\n  revision?: string;\n  builtAt?: string;\n  prefix: string;\n  installedPath: string;\n  binPath: string;\n  managed: boolean;\n  packageManager?: string;\n  archive?: string;\n  archiveSha256?: string;\n}\n\nexport interface SemVer {\n  raw: string;\n  major: number;\n  minor: number;\n  patch: number;\n  prerelease: Array<string | number>;\n  build?: string;\n}\n\nexport interface InstalledProductInfo {\n  version: string;\n  normalizedVersion: string;\n  semver: SemVer | null;\n  isPrerelease: boolean;\n  provenance: InstallProvenance;\n  installRoot?: string;\n  prefix?: string;\n  binLink?: string;\n  writable: boolean;\n  permissionError?: string;\n  detail?: string;\n  provenanceRecord?: ProvenanceRecord;\n}\n\nexport interface ReleaseAsset {\n  name: string;\n  browser_download_url: string;\n  size?: number;\n}\n\nexport interface PublishedRelease {\n  tag_name: string;\n  name?: string;\n  draft: boolean;\n  prerelease: boolean;\n  published_at?: string;\n  html_url?: string;\n  assets: ReleaseAsset[];\n}\n\nexport interface UpgradeComparison {\n  installed: InstalledProductInfo;\n  target: PublishedRelease;\n  targetVersion: string;\n  targetSemver: SemVer;\n  action: UpgradeAction;\n  canUpgrade: boolean;\n  reasons: string[];\n}\n\nexport interface UpgradeExecutionResult {\n  success: boolean;\n  previousVersion: string;\n  newVersion: string;\n  installedPath: string;\n  binPath: string;\n  restartRequired: boolean;\n  restartNotice: string;\n  attestationVerified?: boolean;\n}\n\nexport interface UpgradeOptions {\n  check?: boolean;\n  version?: string;\n  yes?: boolean;\n  allowDowngrade?: boolean;\n  force?: boolean;\n  json?: boolean;\n  timeoutMs?: number;\n  prefix?: string;\n  signal?: AbortSignal;\n  onProgress?: (stage: string, detail?: string) => void;\n  confirm?: (proposal: UpgradeComparison) => Promise<boolean>;\n  /** Test/embedding hook: trusted gh candidates, in order. Production defaults to the system paths. */\n  trustedGhPaths?: string[];\n}\n\n// -----------------------------------------------------------------------------\n// SemVer 2.0.0\n// -----------------------------------------------------------------------------\n\nexport function parseSemver(input: string): SemVer | null {\n  if (!input || typeof input !== \"string\") return null;\n  const clean = input.trim().replace(/^[vV]/, \"\").split(/[\\s(]/)[0];\n  const regex = /^(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\+([0-9A-Za-z.-]+))?$/;\n  const match = clean.match(regex);\n  if (!match) return null;\n  const major = parseInt(match[1], 10);\n  const minor = parseInt(match[2], 10);\n  const patch = parseInt(match[3], 10);\n  const prerelease: Array<string | number> = [];\n  if (match[4]) {\n    for (const part of match[4].split(\".\")) {\n      if (/^\\d+$/.test(part)) {\n        prerelease.push(parseInt(part, 10));\n      } else {\n        prerelease.push(part);\n      }\n    }\n  }\n  return {\n    raw: input.trim(),\n    major,\n    minor,\n    patch,\n    prerelease,\n    build: match[5],\n  };\n}\n\nexport function compareSemver(a: SemVer, b: SemVer): number {\n  if (a.major !== b.major) return a.major > b.major ? 1 : -1;\n  if (a.minor !== b.minor) return a.minor > b.minor ? 1 : -1;\n  if (a.patch !== b.patch) return a.patch > b.patch ? 1 : -1;\n\n  // Normal releases have higher precedence than prereleases\n  if (a.prerelease.length === 0 && b.prerelease.length > 0) return 1;\n  if (a.prerelease.length > 0 && b.prerelease.length === 0) return -1;\n  if (a.prerelease.length === 0 && b.prerelease.length === 0) return 0;\n\n  const minLen = Math.min(a.prerelease.length, b.prerelease.length);\n  for (let i = 0; i < minLen; i++) {\n    const idA = a.prerelease[i];\n    const idB = b.prerelease[i];\n    if (idA === idB) continue;\n    const isNumA = typeof idA === \"number\";\n    const isNumB = typeof idB === \"number\";\n    if (isNumA && !isNumB) return -1;\n    if (!isNumA && isNumB) return 1;\n    if (isNumA && isNumB) return (idA as number) > (idB as number) ? 1 : -1;\n    return String(idA) > String(idB) ? 1 : -1;\n  }\n  if (a.prerelease.length !== b.prerelease.length) {\n    return a.prerelease.length > b.prerelease.length ? 1 : -1;\n  }\n  return 0;\n}\n\nexport function normalizeTag(tag: string): string {\n  const trimmed = tag.trim();\n  if (trimmed.startsWith(\"v\") || trimmed.startsWith(\"V\")) {\n    return `v${trimmed.slice(1)}`;\n  }\n  return `v${trimmed}`;\n}\n\nexport function isValidTag(tag: string): boolean {\n  return /^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$/.test(tag);\n}\n\n// -----------------------------------------------------------------------------\n// Provenance & Installation Layout\n// -----------------------------------------------------------------------------\n\nfunction testWritable(dir: string): { writable: boolean; error?: string } {\n  try {\n    // Diagnosis and --check must never create directories or probe files.\n    let existing = path.resolve(dir);\n    while (!fs.existsSync(existing) && path.dirname(existing) !== existing) existing = path.dirname(existing);\n    fs.accessSync(existing, fs.constants.W_OK);\n    return { writable: true };\n  } catch (err: any) {\n    return { writable: false, error: err?.message ?? String(err) };\n  }\n}\n\nexport function writeProvenance(versionDir: string, record: ProvenanceRecord): void {\n  const provPath = path.join(versionDir, \".provenance.json\");\n  const tmpPath = `${provPath}.tmp.${process.pid}.${Date.now()}`;\n  fs.writeFileSync(tmpPath, JSON.stringify(record, null, 2), { mode: 0o644 });\n  const fd = fs.openSync(tmpPath, \"r\");\n  try { fs.fsyncSync(fd); } finally { fs.closeSync(fd); }\n  fs.renameSync(tmpPath, provPath);\n  syncDirectory(versionDir);\n}\n\nexport function detectInstallation(customOptions?: {\n  nexusHome?: string;\n  hereDir?: string;\n  envPrefix?: string;\n}): InstalledProductInfo {\n  const nexusHome = customOptions?.nexusHome ?? process.env.NEXUS_HOME;\n  const here = customOptions?.hereDir ?? path.dirname(fileURLToPath(import.meta.url));\n  const envPrefix = customOptions?.envPrefix ?? process.env.NEXUS_PREFIX;\n\n  if (nexusHome) {\n    const resolvedHome = path.resolve(nexusHome);\n    const versionFile = path.join(resolvedHome, \"VERSION\");\n    let versionStr = \"unknown\";\n    if (fs.existsSync(versionFile)) {\n      try {\n        versionStr = fs.readFileSync(versionFile, \"utf8\").trim();\n      } catch {}\n    }\n    if (versionStr === \"unknown\") {\n      versionStr = getBuildIdentity().version;\n    }\n    const prefix = path.resolve(resolvedHome, \"../../..\");\n    const binLink = path.join(prefix, \"bin\", \"nexus\");\n","exit_code":0,"duration":{"secs":0,"nanos":894155693}},"started_at_ms":1792983314008,"completed_at_ms":1792983314903}}
