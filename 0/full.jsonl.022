ackup is not returned to the journal until its bytes and directory entry are durable. */\nfunction copyPrivateFileDurably(source: string, destination: string): void {\n  const sourcePath = path.resolve(source);\n  if (fs.realpathSync(sourcePath) !== sourcePath) throw new Error(\"Backup source is redirected\");\n  const sourceFd = fs.openSync(sourcePath, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0) | (fs.constants.O_NONBLOCK ?? 0));\n  let destinationFd: number | undefined;\n  let destinationCreated = false;\n  try {\n    const opened = fs.fstatSync(sourceFd);\n    const current = fs.lstatSync(sourcePath);\n    if (!opened.isFile() || current.isSymbolicLink() || opened.dev !== current.dev || opened.ino !== current.ino) {\n      throw new Error(\"Backup source changed while opening\");\n    }\n    destinationFd = fs.openSync(destination, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | (fs.constants.O_NOFOLLOW ?? 0), 0o600);\n    destinationCreated = true;\n    const buffer = Buffer.alloc(64 * 1024);\n    let position = 0;\n    while (true) {\n      const count = fs.readSync(sourceFd, buffer, 0, buffer.length, position);\n      if (count === 0) break;\n      let written = 0;\n      while (written < count) written += fs.writeSync(destinationFd, buffer, written, count - written);\n      position += count;\n    }\n    fs.fchmodSync(destinationFd, 0o600);\n    fs.fsyncSync(destinationFd);\n    fs.closeSync(destinationFd);\n    destinationFd = undefined;\n    syncDirectory(path.dirname(destination));\n  } catch (error) {\n    if (destinationFd !== undefined) try { fs.closeSync(destinationFd); } catch {}\n    if (destinationCreated) {\n      try { fs.unlinkSync(destination); syncDirectory(path.dirname(destination)); } catch {}\n    }\n    throw error;\n  } finally { fs.closeSync(sourceFd); }\n}\nfunction validatePrivateTreeExcept(source: string, excluded: Set<string>): void {\n  if (fs.realpathSync(source) !== path.resolve(source) || !fs.lstatSync(source).isDirectory()) throw new Error(\"State root is redirected\");\n  for (const entry of fs.readdirSync(source)) if (!excluded.has(entry)) validatePrivateTree(path.join(source, entry));\n}\n\nexport interface RecoveryOutcome {\n  recovered: boolean;\n  action: \"rolled_back\" | \"finalized\" | \"none\" | \"cleaned_up\" | \"manual_intervention\" | \"upgrade_in_progress\";\n  details: string;\n}\n\n/**\n * Permanent kernel-owned guard that serializes stale-lock reclamation between\n * concurrent processes. The guard is a regular file that is never unlinked or\n * replaced; mutual exclusion comes from an advisory flock held on the open file\n * description for the whole reclaim section. The kernel releases the lock when\n * the last referring descriptor closes, so a reclaimer killed by SIGKILL or a\n * power loss cannot wedge later upgrades, and no recursive takeover of a stale\n * gate directory is ever performed.\n */\nexport type ReclaimGuard = FileGuard;\n\nconst FLOCK_UTILITY = \"/usr/bin/flock\";\n\n/**\n * Acquires the reclaim guard. Returns null on contention (another live\n * reclaimer holds the kernel lock) and throws on any unsupported or failed\n * prerequisite so callers fail closed instead of proceeding unserialized.\n * The utility path is injectable so tests can demonstrate fail-closed\n * behavior without modifying the real system utility.\n */\nexport function acquireReclaimGuard(guardPath: string, flockUtility: string = FLOCK_UTILITY): ReclaimGuard | null {\n  return acquireFileGuard(guardPath, { utility: flockUtility, label: \"Reclaim guard\" });\n}\n\nexport function releaseReclaimGuard(guard: ReclaimGuard | null): void {\n  releaseFileGuard(guard);\n          }\n          writeOwnedLock();\n        } finally { releaseReclaimGuard(guard); }\n      } catch (inner: any) {\n        throw new Error(`Another upgrade is in progress (lockfile present at ${lockFile}): ${inner.message || inner}`);\n      }\n    } else {\n      throw new Error(`Could not acquire upgrade lock at ${lockFile}: ${err.message || err}`);\n    }\n  }\n\n  const transactionId = `upg-${Date.now()}-${process.pid}`;\n  const tmpDir = path.join(libNexus, `.tmp-upgrade-${transactionId}`);\n  let journalEntry: UpgradeJournalEntry | undefined;\n  const cleanup = () => {\n    // A failed recovery keeps every artifact, including staging, for the operator.\n    if (!journalEntry || [\"complete\", \"rolled_back\"].includes(journalEntry.state)) {\n      try { fs.rmSync(tmpDir, { recursive:true, force:true }); } catch {}\n    }\n    if (lockFd !== null) {\n      try { fs.closeSync(lockFd); } catch {}\n      try {\n        const current = fs.lstatSync(lockFile, { throwIfNoEntry:false });\n        if (current?.ino === lockIno && JSON.parse(fs.readFileSync(lockFile, \"utf8\")).token === lockToken) fs.unlinkSync(lockFile);\n      } catch {}\n    }\n  };\n  try {\n    const pending = readJournal(prefix);\n    if (fs.existsSync(getJournalPath(prefix)) && (!pending || ![\"idle\", \"complete\", \"rolled_back\"].includes(pending.state))) throw new Error(\"Pending or invalid upgrade journal; run nexus upgrade --recover before starting another transaction.\");\n    options?.onProgress?.(\"pre_migration_backup\", \"Creating pre-migration configuration and state backup...\");\n    const backupResult = createPreMigrationBackup();\n    fs.mkdirSync(tmpDir, { mode:0o700 });\n    journalEntry = {\n      formatVersion:1, id:transactionId, state:\"preparing\",\n      sourceVersion:installed.version, sourceInstallDir:installed.installRoot || path.join(libNexus, installed.version),\n      sourceSymlinkTarget:path.join(installed.installRoot || path.join(libNexus, installed.version), \"bin\", \"nexus\"),\n      targetVersion, targetInstallDir:versionDir, stagingDir:tmpDir,\n      replacementBackupDir:path.join(libNexus, `.rollback-${transactionId}`),\n      displacedTargetDir:path.join(libNexus, `.failed-${transactionId}`),\n      prefix, binPath:linkPath, startedAt:new Date().toISOString(), updatedAt:new Date().toISOString(),\n      configBackupPath:backupResult.configBackupPath, stateBackupDir:backupResult.stateBackupDir,\n    };\n    writeJournal(prefix, journalEntry);\n    if (!readJournal(prefix)) throw new Error(\"Installation identity does not match the managed prefix; no package was changed.\");\n    // 4. Downloading phase\n    options?.onProgress?.(\"downloading\", `Fetching ${archiveName}...`);\n    journalEntry.state = \"downloading\";\n    journalEntry.updatedAt = new Date().toISOString();\n    writeJournal(prefix, journalEntry);\n\n    const localArchive = path.join(tmpDir, archiveName);\n    const localSums = path.join(tmpDir, \"SHA256SUMS\");\n    const localCompat = path.join(tmpDir, \"compatibility.json\");\n\n    await downloadFile(archiveUrl, localArchive, options?.signal, options?.timeoutMs);\n    options?.onProgress?.(\"verifying_checksum\", \"Verifying release checksums...\");\n    await downloadFile(checksumsUrl, localSums, options?.signal, options?.timeoutMs);\n\n    const sumsContent = fs.readFileSync(localSums, \"utf8\");\n    const verified = verifyChecksum(localArchive, sumsContent, archiveName);\n    if (!verified) {\n      throw new Error(`SHA-256 verification failed for ${archiveName}; no installation was changed.`);\n    }\n\n    // A detached metadata asset is optional for legacy releases, but if present\n1016-  };\n1017-  try {\n1018-    const pending = readJournal(prefix);\n1019-    if (fs.existsSync(getJournalPath(prefix)) && (!pending || ![\"idle\", \"complete\", \"rolled_back\"].includes(pending.state))) throw new Error(\"Pending or invalid upgrade journal; run nexus upgrade --recover before starting another transaction.\");\n1020:    options?.onProgress?.(\"pre_migration_backup\", \"Creating pre-migration configuration and state backup...\");\n1021-    const backupResult = createPreMigrationBackup();\n1022-    fs.mkdirSync(tmpDir, { mode:0o700 });\n1023-    journalEntry = {\n1024-      formatVersion:1, id:transactionId, state:\"preparing\",\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17605-0c8f-7f42-8d4b-980a6c519c84","create_time":1792982857.3368206}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
