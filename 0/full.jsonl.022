{"timestamp":"2026-10-26T01:30:30.675Z","ordinal":367503,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a175d0-ddec-7861-9122-03a48c8a4185","item":{"type":"CommandExecution","id":"exec-355aeb6d-02b6-4427-b599-bd5cd2832a34","process_id":"93570","command":["/usr/bin/zsh","-lc","rg -n 'restoreConversation|restoreSession\\(' cli/src/agent.ts cli/test/durable_continuity.test.ts; sed -n '1225,1315p' cli/test/durable_continuity.test.ts; sed -n '620,730p' cli/test/durable_continuity.test.ts; git diff --cached cli/src/agent.ts | head -n 180; rg -n 'readOnlyModeSelected' cli/src/types.ts"],"cwd":"file:///home/mike/nexus-wt/agent-readonly-current","parsed_cmd":[{"type":"unknown","cmd":"rg -n 'restoreConversation|restoreSession\\(' cli/src/agent.ts cli/test/durable_continuity.test.ts; sed -n '1225,1315p' cli/test/durable_continuity.test.ts; sed -n '620,730p' cli/test/durable_continuity.test.ts; git diff --cached cli/src/agent.ts | head -n 180; rg -n 'readOnlyModeSelected' cli/src/types.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"cli/test/durable_continuity.test.ts:1248:        agent.restoreSession([], false);\ncli/test/durable_continuity.test.ts:1291:        agent.restoreSession([], false);\ncli/src/agent.ts:1786:  public restoreSession(\ncli/src/agent.ts:2102:    // recoverFromTaskState() and restoreSession(). If pending work has no trusted\ncli/src/agent.ts:2338:  public restoreConversation(\ncli/src/agent.ts:2351:    this.restoreSession(session.messages, session.unverifiedChangesPending, session.objective, session.findings, session);\n        assert.ok(sessions().every((f) => JSON.parse(fs.readFileSync(f, \"utf-8\")).unverifiedChangesPending === false), \"precondition: recorded false\");\n        assert.equal(await turn(\"latest\", \"Anything left?\"), \"UNVERIFIED\", \"a recorded false is not an authenticated clean-state claim\");\n        for (const f of sessions()) edit(f, (s) => ({ ...s, unverifiedChangesPending: false }));\n        assert.equal(await turn(\"latest\", \"Anything left?\"), \"UNVERIFIED\", \"a forged false remains fail-closed\");\n      } finally {\n        await gw.close();\n        fs.rmSync(repo, { recursive: true, force: true });\n      }\n    });\n  });\n\n  test(\"ACC-VER-08: restored session flags cannot authenticate a verifier baseline\", async () => {\n    await withHome(async () => {\n      const gw = await gateway(() => done());\n      const repo = makeRepo({\n        \"package.json\": '{\"scripts\":{\"test\":\"node test.js\"}}\\n',\n        \"math.js\": \"export const add = (a, b) => a - b;\\n\",\n        // Represents an oracle edited after a session was saved. The saved session\n        // can be changed by the same local identity, including its obligation flag.\n        \"test.js\": 'console.log(\"\\\\u2139 tests 1\\\\n\\\\u2139 pass 1\");\\n',\n      });\n      const agent = quiet(new AutonomousAgent(cfg(gw, repo, { trustedDeliverableFiles: [\"math.js\"] }), 1));\n      try {\n        agent.restoreSession([], false);\n        const internal = agent as any;\n        assert.equal(internal.hasPendingModifications, true, \"a forged saved false must not clear the obligation\");\n        assert.equal(internal.verificationBaselineInvalidated, true, \"session restoration invalidates any workspace baseline\");\n        assert.equal(internal.changeBaseline, null, \"a saved or newly captured baseline cannot be trusted\");\n\n        await internal.captureChangeBaseline();\n        assert.equal(internal.changeBaseline, null, \"the edited test oracle cannot become its own pre-change baseline\");\n        assert.equal(gw.requests.length, 0, \"fail-closed restoration does not invoke a verifier as baseline capture\");\n\n        const result = await muted(() => agent.runTurn(\"Continue and verify the implementation.\"));\n        assert.notEqual(result.outcome, \"VERIFIED\", \"a passing session-edited oracle cannot establish VERIFIED\");\n        assert.equal(internal.hasPendingModifications, true, \"the obligation remains until trustworthy verification\");\n      } finally {\n        agent.shutdown();\n        await gw.close();\n        fs.rmSync(repo, { recursive: true, force: true });\n      }\n    });\n  });\n\n  test(\"ACC-VER-09: generic verifier output cannot discharge an unauthenticated restored obligation\", async () => {\n    await withHome(async () => {\n      const gw = await gateway(() => done(\"implementation checked\"));\n      const repo = makeRepo({ \"math.js\": \"export const add = (a, b) => a + b;\\n\" });\n      const agent = quiet(new AutonomousAgent(cfg(gw, repo, {\n        authoritativeVerifierCommand: \"/usr/bin/true\",\n        trustedDeliverableFiles: [\"math.js\"],\n        sandbox: \"bwrap\",\n      }), 1));\n      const bridge = (agent as any).bridge;\n      const executeTool = bridge.executeTool.bind(bridge);\n      const verifierCalls: string[] = [];\n      bridge.executeTool = async (name: string, args: any) => {\n        if (name === \"run_command\" && args.command === \"/usr/bin/true\") {\n          verifierCalls.push(args.command);\n          // Deliberately adversarial executor output: a command's location and TAP-shaped text\n          // are not an authenticated binding to the restored workspace or its test oracle.\n          return { success: true, output: JSON.stringify({ exit_code: 0, stdout: \"ℹ tests 1\\nℹ pass 1\", stderr: \"\" }) };\n        }\n        return executeTool(name, args);\n      };\n      try {\n        agent.restoreSession([], false);\n        const result = await muted(() => agent.runTurn(\"Continue and verify the implementation.\"));\n        assert.equal(verifierCalls.length, 1, \"the configured verifier attempt is observed\");\n        assert.equal(verifierCalls[0], \"/usr/bin/true\");\n        assert.notEqual(result.outcome, \"VERIFIED\", `${result.outcome}: ${result.detail}`);\n        assert.equal(agent.hasUnverifiedChanges(), true, \"unbound output cannot discharge the restored obligation\");\n        assert.equal((agent as any).verificationBaselineInvalidated, true, \"the recovery boundary remains invalidated\");\n      } finally {\n        agent.shutdown();\n        await gw.close();\n        fs.rmSync(repo, { recursive: true, force: true });\n      }\n    });\n  });\n});\n\n// ---------------------------------------------------------------- V1: missing or inconsistent durable history\n\ndescribe(\"V1: a unit whose durable history is missing or inconsistent is blocked, never completed\", () => {\n  /** Reads markers; a blind model (no authorized task in context) claims there is nothing to do. */\n  const reader = (b: any): Reply => {\n    if (!allText(b).includes(\"OBJ-READ-ABC\")) return done(\"nothing to do\");\n    if (resumed(b)) return done(\"continued\");\n    if (allText(b).includes(\"earlier task history was unusable\") || allText(b).includes(\"explicitly restarted after recovery\")) {\n      return toolResults(b) === 0 ? read(\"a.txt\") : done(\"markers read\");\n        // Run first turn: unit performs 2 repetitions of read_file(\"notes.txt\")\n        let op = await muted(() =>\n          driveOperation(newOperation(id, \"continuity\", [{ id: \"u1\", prompt: \"Read notes.txt\" }], [{ id: \"primary\", provider: gw.origin, endpoint: gw.url, model: \"m\", capabilities: [\"tools\"], rank: 0 }], Date.now()), { store, executor })\n        );\n        taskId = op.units[0].agentTaskId!;\n        assert.ok(taskId, \"unit must have bound agentTaskId\");\n\n        // Verify task state saved execution tracking with repetitions count = 2\n        const savedState = new DurableStateManager({ baseDir: stateDir, workspacePaths: [WorkspacePath.fromSelectedWorkspace(repo)] }).loadTaskState(taskId);\n        assert.ok(savedState.objective?.execution, \"task state must have execution tracking\");\n        const rep = savedState.objective.execution.repetitions.find((r) => r.action.includes(\"read_file\"));\n        assert.ok(rep, \"must have recorded read_file repetition\");\n        assert.equal(rep.count, 2, \"repetition count before resume must be 2\");\n\n        // Now resume the unit in a second turn\n        // On the 3rd repetition (step 1 of resumed turn), tracker must see count = 3 and emit [Nexus recovery 1/3]\n        const more = decisionOf(op, \"u1\").options.find((o) => o.label === \"continue with more steps\")!;\n        applyOperatorDecision(store, id, decisionOf(op, \"u1\").id, more.id);\n        op = await muted(() =>\n          driveOperation(store.load(id), { store, executor })\n        );\n\n        // Check gateway requests: verify recovery note was received by the model\n        const recoveryReq = gw.requests.find((r) => allText(r).includes(\"[Nexus recovery\") && allText(r).includes(\"3 times\"));\n        assert.ok(recoveryReq, \"model must receive recovery note stating action was called 3 times\");\n      } finally {\n        await gw.close();\n        fs.rmSync(repo, { recursive: true, force: true });\n        fs.rmSync(stateDir, { recursive: true, force: true });\n      }\n    });\n  });\n\n  test(\"REQ-AGT-103: recovered verifier baseline persists as continuity evidence but is never trusted\", async () => {\n    await withHome(async () => {\n      const gw = await gateway((b) => done());\n      const repo = makeRepo({ \"test.js\": \"throw new Error('fail');\\n\" });\n      const config = cfg(gw, repo);\n      const identity = WorkspacePath.fromSelectedWorkspace(repo);\n      const stateDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-cont-baseline-\"));\n      try {\n        const agent1 = quiet(new AutonomousAgent(config, 1, undefined, { durable: true }));\n        const a1 = agent1 as any;\n        a1.stateManager = new DurableStateManager({ baseDir: stateDir, workspacePaths: [identity] });\n        // Set a change baseline\n        const mockBaseline = {\n          command: \"npm test\",\n          failed: true,\n          tests: new Map([[\"test.js\", \"throw new Error('fail');\\n\"]]),\n          verifier: new Map([[\"package.json\", '{\"scripts\":{\"test\":\"node test.js\"}}']]),\n          at: new Date().toISOString(),\n        };\n        a1.changeBaseline = mockBaseline;\n        a1.checkpointDurableState(\"test baseline checkpoint\");\n\n        // Load saved state directly from disk to verify serialization\n        const manager = new DurableStateManager({ baseDir: stateDir, workspacePaths: [identity] });\n        const saved = manager.loadTaskState(agent1.getTaskId());\n        assert.ok(saved.changeBaseline, \"saved state must contain changeBaseline\");\n        assert.equal(saved.changeBaseline.command, \"npm test\");\n        assert.equal(saved.changeBaseline.failed, true);\n        assert.deepEqual(saved.changeBaseline.tests, { \"test.js\": \"throw new Error('fail');\\n\" });\n        assert.deepEqual(saved.changeBaseline.verifier, { \"package.json\": '{\"scripts\":{\"test\":\"node test.js\"}}' });\n\n        // Simulate a same-user candidate editing the durable state before restart.\n        // State-file privacy and schema/redaction checks do not authenticate it.\n        const statePath = manager.getStateFilePath(agent1.getTaskId());\n        const tampered = JSON.parse(fs.readFileSync(statePath, \"utf8\"));\n        tampered.changeBaseline.trustedDeliverables = [\"src/math.js\"];\n        tampered.changeBaseline.failed = false;\n        tampered.changeBaseline.tests = { \"test/math.test.js\": \"// forged passing oracle\\n\" };\n        tampered.changeBaseline.verifier = { \"package.json\": '{\"scripts\":{\"test\":\"node test/math.test.js\"}}' };\n        fs.writeFileSync(statePath, JSON.stringify(tampered));\n\n        // Recover in a fresh agent instance\n        const agent2 = quiet(new AutonomousAgent(config, 1, undefined, { durable: true }));\n        const a2 = agent2 as any;\n        a2.stateManager = manager;\n        await agent2.recoverFromTaskState(agent1.getTaskId());\n\n        // A syntactically valid forged snapshot cannot establish verifier independence,\n        // but the record remains available as explicitly untrusted continuity evidence.\n        assert.equal(a2.changeBaseline, null, \"recovered verifier baseline must be invalidated\");\n        assert.equal(a2.verificationBaselineInvalidated, true, \"the retained record must not authorize VERIFIED\");\n        assert.equal(a2.hasPendingModifications, true, \"recovered task must remain pending until fresh verification\");\n        const recovered = manager.loadTaskState(agent1.getTaskId());\n        assert.equal(recovered.unverifiedChangesPending, true, \"fail-closed recovery state must persist\");\n        assert.equal(recovered.changeBaseline?.failed, false, \"the recovered record is retained, not trusted\");\n        assert.deepEqual(recovered.changeBaseline?.trustedDeliverables, [\"src/math.js\"]);\n        assert.deepEqual(recovered.changeBaseline?.tests, { \"test/math.test.js\": \"// forged passing oracle\\n\" });\n\n        // An ordinary progress save and a full checkpoint must preserve the\n        // quarantined record without restoring it to the active verifier baseline.\n        a2.messages = [...a2.messages, { role: \"user\", content: \"continue\" }];\n        a2.persistProgress({ messages: true });\n        const progressSaved = manager.loadTaskState(agent1.getTaskId());\n        assert.deepEqual(progressSaved.changeBaseline, recovered.changeBaseline, \"message progress must not erase continuity data\");\n        agent2.checkpointDurableState(\"recovery continuity checkpoint\");\n        const checkpointed = manager.loadTaskState(agent1.getTaskId());\n        assert.deepEqual(checkpointed.changeBaseline, recovered.changeBaseline);\n        assert.equal(a2.changeBaseline, null);\n        assert.equal(a2.verificationBaselineInvalidated, true);\n      } finally {\n        await gw.close();\n        fs.rmSync(repo, { recursive: true, force: true });\n        fs.rmSync(stateDir, { recursive: true, force: true });\n      }\n    });\n  });\n\n  test(\"ACC-VER-06: forged candidate identity cannot clear the verifier obligation after resume\", async () => {\ndiff --git a/cli/src/agent.ts b/cli/src/agent.ts\nindex 56bdbd4..65262ba 100644\n--- a/cli/src/agent.ts\n+++ b/cli/src/agent.ts\n@@ -859,6 +859,10 @@ export class AutonomousAgent {\n   private verificationBaselineInvalidated: boolean = false;\n   /** A persisted baseline retained only as untrusted continuity evidence after recovery. */\n   private untrustedRecoveredBaseline?: DurableTaskState[\"changeBaseline\"];\n+  private recoveredOperation?: DurableTaskState[\"operation\"];\n+  private extensionPosture?: { workspace: string; readOnly: boolean };\n+  /** Full-access intent captured at construction; effective only while the mode permits it and read-only is off. */\n+  private configuredFullAccess: boolean = false;\n   /** Evidence from the verifier run that covers the current workspace changes. Cleared by any later mutation. */\n   private verificationEvidence?: VerificationEvidence;\n   private verificationEvidenceRawOutput: string = \"\";\n@@ -1061,6 +1065,7 @@ export class AutonomousAgent {\n       this.config.readOnly = true;\n       this.config.approvalMode = \"read-only\";\n     }\n+    this.configuredFullAccess = Boolean(this.config.fullAccess);\n \n     this.inheritedWorktreeScope = inheritedWorktreeScope;\n     if (inheritedWorktreeScope && path.resolve(config.workspace) !== path.resolve(inheritedWorktreeScope.workspace)) {\n@@ -1113,6 +1118,7 @@ export class AutonomousAgent {\n     this.skillManager = new SkillManager(ws, { readOnly: config.readOnly });\n     this.mcpManager = new McpClientManager(ws, { readOnly: config.readOnly });\n     this.pluginManager = new PluginManager(ws, { readOnly: config.readOnly });\n+    this.extensionPosture = { workspace: ws, readOnly: this.isReadOnly() };\n     this.worktreeManager = new WorktreeManager(ws);\n     if (config.recordFlight) {\n       this.flightRecorder = new FlightRecorder(ws);\n@@ -1122,7 +1128,7 @@ export class AutonomousAgent {\n     this.capabilityRegistry = createDefaultRegistry();\n     this.authorityEngine = new AuthorityAdmissionEngine({\n       readOnly: config.readOnly,\n-      fullAccess: config.fullAccess ?? false,\n+      fullAccess: Boolean(config.fullAccess) && !config.readOnly,\n       workspace: ws,\n       registry: this.capabilityRegistry,\n     });\n@@ -1259,18 +1265,63 @@ export class AutonomousAgent {\n   }\n \n   public setApprovalMode(mode: ApprovalMode): void {\n+    // Read-only selected at runtime is a mode choice, not an explicit launch invariant: record that so a later\n+    // /mode auto or /mode review can deliberately leave it, exactly like --mode read-only.\n+    if (mode === \"read-only\" && !this.config.readOnly && !this.config.readOnlyModeSelected) {\n+      this.config.readOnlyModeSelected = true;\n+    }\n+    // config.readOnly is the configured (launch or deliberate mode) posture. The checkpoint fallback is transient\n+    // and must never leak into it, or releasing the fallback could never restore the operator's mode.\n+    const configuredReadOnly = this.modeReadOnly(mode);\n     this.config.approvalMode = mode;\n-    if (mode !== \"auto\") {\n-      this.config.fullAccess = false;\n-    }\n+    this.config.readOnly = configuredReadOnly;\n+    this.config.fullAccess = mode === \"auto\" ? this.configuredFullAccess : false;\n+    this.applyReadOnlyAuthority(this.checkpointReadOnlyFallback || configuredReadOnly);\n     this.clearApprovedEgressOrigins();\n     this.clearApprovedVerifiers();\n   }\n \n+  /** Read-only configured by an explicit launch or by a deliberate mode choice (not the transient fallback). */\n+  private modeReadOnly(mode: ApprovalMode): boolean {\n+    return Boolean((this.config.readOnly && !this.config.readOnlyModeSelected) || mode === \"read-only\");\n+  }\n+\n+  /** Effective read-only authority for a permission mode, including the transient checkpoint fallback. */\n+  private readOnlyForMode(mode: ApprovalMode): boolean {\n+    return Boolean(this.checkpointReadOnlyFallback || this.modeReadOnly(mode));\n+  }\n+\n+  private applyReadOnlyAuthority(readOnly: boolean): void {\n+    this.bridge?.setReadOnly(readOnly);\n+    this.authorityEngine.setReadOnly(readOnly);\n+    this.authorityEngine.setFullAccess(Boolean(this.config.fullAccess) && !readOnly);\n+    this.applyExtensionReadOnly(readOnly);\n+  }\n+\n+  /** Keep workspace-scoped extension managers on the same effective posture as the bridge and authority. */\n+  private applyExtensionReadOnly(readOnly: boolean): void {\n+    // A permission-mode change that does not alter the effective posture (review <-> auto) must not tear down\n+    // connected MCP servers, loaded plugins or the current turn's extensibility state.\n+    const workspace = this.config.workspace;\n+    if (this.extensionPosture?.workspace === workspace && this.extensionPosture.readOnly === readOnly) return;\n+    if (this.knowledge) this.knowledge.setWorkspace(workspace, { readOnly });\n+    if (this.skillManager) this.skillManager.setWorkspace(workspace, { readOnly });\n+    if (this.mcpManager) {\n+      this.mcpManager.shutdownAll();\n+      this.mcpManager = new McpClientManager(workspace, { readOnly });\n+    }\n+    if (this.pluginManager) {\n+      this.pluginManager = new PluginManager(workspace, { readOnly });\n+      if (this.flightRecorder) this.pluginManager.setFlightRecorder(this.flightRecorder);\n+    }\n+    this.extensibilityInitialized = false;\n+    this.extensionPosture = { workspace, readOnly };\n+  }\n+\n   public getApprovalMode(): ApprovalMode {\n     // An explicit --read-only launch is an operator invariant: a later mode change (the /mode slash command,\n     // setApprovalMode) must not lower it. The checkpoint fallback is the same class of restriction.\n-    if (this.checkpointReadOnlyFallback || this.config.readOnly) return \"read-only\";\n+    if (this.readOnlyForMode(this.config.approvalMode ?? \"review\")) return \"read-only\";\n     if (this.config.approvalMode) return this.config.approvalMode;\n     if (this.config.fullAccess) return \"auto\";\n     // Workspace trust controls project instructions and integrations; permission settings alone select approval posture.\n@@ -1280,6 +1331,7 @@ export class AutonomousAgent {\n   /** Restrict this session to read-only authority when its workspace cannot be safely checkpointed. */\n   public setCheckpointReadOnlyFallback(enabled: boolean): void {\n     this.checkpointReadOnlyFallback = enabled;\n+    this.applyReadOnlyAuthority(this.readOnlyForMode(this.config.approvalMode ?? \"review\"));\n     if (enabled) {\n       this.clearApprovedEgressOrigins();\n       this.clearApprovedVerifiers();\n@@ -1287,7 +1339,9 @@ export class AutonomousAgent {\n   }\n \n   private isReadOnly(): boolean {\n-    return Boolean(this.config.readOnly || this.checkpointReadOnlyFallback);\n+    // An explicit launch is authoritative; a mode-selected read-only posture is enforced until the operator\n+    // deliberately changes the mode, and the checkpoint fallback is authoritative for the current turn.\n+    return this.readOnlyForMode(this.config.approvalMode ?? \"review\");\n   }\n \n   private initTaskState(): void {\n@@ -1351,6 +1405,7 @@ export class AutonomousAgent {\n       unverifiedChangesPending: this.hasPendingModifications,\n       durableNotes: notes ? [notes] : undefined,\n       ...(this.compactionProvenance ? { compactionProvenance: this.compactionProvenance } : {}),\n+      ...(this.recoveredOperation !== undefined ? { operation: this.recoveredOperation } : {}),\n       providerRecovery: this.activeProviderRecovery,\n       objective: this.objective ?? null,\n       findings: this.getFindings(),\n@@ -1421,6 +1476,8 @@ export class AutonomousAgent {\n     this.messages = state.messages || [];\n     this.restoreFindings(state.findings);\n     this.objective = state.objective ?? undefined;\n+    this.activeProviderRecovery = state.providerRecovery ?? null;\n+    this.recoveredOperation = state.operation;\n     // Durable task state is writable by the same local user who can run candidate\n     // commands. Never trust a saved baseline, nor capture a new one over a\n     // resumed workspace with pending changes: an attacker could delete the field\n@@ -1726,7 +1783,13 @@ export class AutonomousAgent {\n     this.findingsCondensed = recorded.some((state) => state.reduced);\n   }\n \n-  public restoreSession(msgs: ChatMessage[], unverifiedChangesPending?: boolean, objective?: ObjectiveLedger | null, findings?: readonly string[] | null): void {\n+  public restoreSession(\n+    msgs: ChatMessage[],\n+    unverifiedChangesPending?: boolean,\n+    objective?: ObjectiveLedger | null,\n+    findings?: readonly string[] | null,\n+    recovery?: Pick<DurableTaskState, \"providerRecovery\" | \"operation\" | \"changeBaseline\">,\n+  ): void {\n     this.approvedEgressOrigins.clear();\n     this.approvedVerifiers.clear();\n     this.messages = [...msgs];\n@@ -1738,6 +1801,9 @@ export class AutonomousAgent {\n       this.objective.continuation = { ...this.objective.continuation, segments: 1, lastProgressStep: 0 };\n     }\n     this.settleUnrecordedToolCalls();\n+    this.activeProviderRecovery = recovery?.providerRecovery ?? null;\n+    this.recoveredOperation = recovery?.operation;\n+    this.untrustedRecoveredBaseline = recovery?.changeBaseline ?? undefined;\n     // Session files are writable by the same local identity that can run candidate\n     // commands. Their pending flag and any verifier snapshot cannot authenticate\n     // that the workspace remained unchanged since the session was saved. Treat\n@@ -2045,6 +2111,8 @@ export class AutonomousAgent {\n     const hasTrustedInMemoryBaseline = workspaceIdentityIsCurrent && this.changeBaseline !== undefined && !this.verificationBaselineInvalidated;\n     if (!hasTrustedInMemoryBaseline) this.changeBaseline = undefined;\n     this.verificationBaselineInvalidated = this.verificationBaselineInvalidated || (this.hasPendingModifications && !hasTrustedInMemoryBaseline);\n+    this.recoveredOperation = undefined;\n+    this.activeProviderRecovery = null;\n     this.enabledToolGroups = new Set();\n     this.stepNoticeStep = 0;\n     this.cutResponse = undefined;\n@@ -2120,6 +2188,7 @@ export class AutonomousAgent {\n         this.primaryWorkspacePathIdentity = selectedWorkspace;\n75:  readOnlyModeSelected?: boolean; // Read-only is mode-selected (not the explicit --read-only launch) and may be changed deliberately\n","exit_code":0,"duration":{"secs":0,"nanos":681799274}},"started_at_ms":1792978229993,"completed_at_ms":1792978230675}}
{"timestamp":"2026-10-26T01:30:31.631Z","ordinal":367504,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a175d4-a14f-76a0-9ea9-0ac8e437bbb1","call_id":"call_04b75d3b2b8d4e318e09b16a1a06f8a3","output":[{"type":"input_text","text":"Script completed\nWall time 2.8 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 5723)\nTotal output lines: 389\n\ncli/test/durable_continuity.test.ts:1248:        agent.restoreSession([], false);\ncli/test/durable_continuity.test.ts:1291:        agent.restoreSession([], false);\ncli/src/agent.ts:1786:  public restoreSession(\ncli/src/agent.ts:2102:    // recoverFromTaskState() and restoreSession(). If pending work has no trusted\ncli/src/agent.ts:2338:  public restoreConversation(\ncli/src/agent.ts:2351:    this.restoreSession(session.messages, session.unverifiedChangesPending, session.objective, session.findings, session);\n        assert.ok(sessions().every((f) => JSON.parse(fs.readFileSync(f, \"utf-8\")).unverifiedChangesPending === false), \"precondition: recorded false\");\n        assert.equal(await turn(\"latest\", \"Anything left?\"), \"UNVERIFIED\", \"a recorded false is not an authenticated clean-state claim\");\n        for (const f of sessions()) edit(f, (s) => ({ ...s, unverifiedChangesPending: false }));\n        assert.equal(await turn(\"latest\", \"Anything left?\"), \"UNVERIFIED\", \"a forged false remains fail-closed\");\n      } finally {\n        await gw.close();\n        fs.rmSync(repo, { recursive: true, force: true });\n      }\n    });\n  });\n\n  test(\"ACC-VER-08: restored session flags cannot authenticate a verifier baseline\", async () => {\n    await withHome(async () => {\n      const gw = await gateway(() => done());\n      const repo = makeRepo({\n        \"package.json\": '{\"scripts\":{\"test\":\"node test.js\"}}\\n',\n        \"math.js\": \"export const add = (a, b) => a - b;\\n\",\n        // Represents an oracle edited after a session was saved. The saved session\n        // can be changed by the same local identity, including its obligation flag.\n        \"test.js\": 'console.log(\"\\\\u2139 tests 1\\\\n\\\\u2139 pass 1\");\\n',\n      });\n      const agent = quiet(new AutonomousAgent(cfg(gw, repo, { trustedDeliverableFiles: [\"math.js\"] }), 1));\n      try {\n        agent.restoreSession([], false);\n        const internal = agent as any;\n        assert.equal(internal.hasPendingModifications, true, \"a forged saved false must not clear the obligation\");\n        assert.equal(internal.verificationBaselineInvalidated, true, \"session restoration invalidates any workspace baseline\");\n        assert.equal(internal.changeBaseline, null, \"a saved or newly captured baseline cannot be trusted\");\n\n        await internal.captureChangeBaseline();\n        assert.equal(internal.changeBaseline, null, \"the edited test oracle cannot become its own pre-change baseline\");\n        assert.equal(gw.requests.length, 0, \"fail-closed restoration does not invoke a verifier as baseline capture\");\n\n        const result = await muted(() => agent.runTurn(\"Continue and verify the implementation.\"));\n        assert.notEqual(result.outcome, \"VERIFIED\", \"a passing session-edited oracle cannot establish VERIFIED\");\n        assert.equal(internal.hasPendingModifications, true, \"the obligation remains until trustworthy verification\");\n      } finally {\n        agent.shutdown();\n        await gw.close();\n        fs.rmSync(repo, { recursive: true, force: true });\n      }\n    });\n  });\n\n  test(\"ACC-VER-09: generic verifier output cannot discharge an unauthenticated restored obligation\", async () => {\n    await withHome(async () => {\n      const gw = await gateway(() => done(\"implementation checked\"));\n      const repo = makeRepo({ \"math.js\": \"export const add = (a, b) => a + b;\\n\" });\n      const agent = quiet(new AutonomousAgent(cfg(gw, repo, {\n        authoritativeVerifierCommand: \"/usr/bin/true\",\n        trustedDeliverableFiles: [\"math.js\"],\n        sandbox: \"bwrap\",\n      }), 1));\n      const bridge = (agent as any).bridge;\n      const executeTool = bridge.executeTool.bind(bridge);\n      const verifierCalls: string[] = [];\n      bridge.executeTool = async (name: string, args: any) => {\n        if (name === \"run_command\" && args.command === \"/usr/bin/true\") {\n          verifierCalls.push(args.command);\n          // Deliberately adversarial executor output: a command's location and TAP-shaped text\n          // are not an authenticated binding to the restored workspace or its test oracle.\n          return { success: true, output: JSON.stringify({ exit_code: 0, stdout: \"ℹ tests 1\\nℹ pass 1\", stderr: \"\" }) };\n        }\n        return executeTool(name, args);\n      };\n      try {\n        agent.restoreSession([], false);\n        const result = await muted(() => agent.runTurn(\"Continue and verify the implementation.\"));\n        assert.equal(verifierCalls.length, 1, \"the configured verifier attempt is observed\");\n        assert.equal(verifierCalls[0], \"/usr/bin/true\");\n        assert.notEqual(result.outcome, \"VERIFIED\", `${result.outcome}: ${result.detail}`);\n        assert.equal(agent.hasUnverifiedChanges(), true, \"unbound output cannot discharge the restored obligation\");\n        assert.equal((agent as any).verificationBaselineInvalidated, true, \"the recovery boundary remains invalidated\");\n      } finally {\n        agent.shutdown();\n        await gw.close();\n        fs.rmSync(repo, { recursive: true, force: true });\n      }\n    });\n  });\n});\n\n// ---------------------------------------------------------------- V1: missing or inconsistent durable history\n\ndescribe(\"V1: a unit whose durable history is missing or inconsistent is blocked, never completed\", () => {\n  /** Reads markers; a blind model (no authorized task in context) claims there is nothing to do. */\n  const reader = (b: any): Reply => {\n    if (!allText(b).includes(\"OBJ-READ-ABC\")) return done(\"nothing to do\");\n    if (resumed(b)) return done(\"continued\");\n    if (allText(b).includes(\"earlier task history was unusable\") || allText(b).includes(\"explicitly restarted after recovery\")) {\n      return toolResults(b) === 0 ? read(\"a.txt\") : done(\"markers read\");\n        // Run first turn: unit performs 2 repetitions of read_file(\"notes.txt\")\n        let op = await muted(() =>\n          driveOperation(newOperation(id, \"continuity\", [{ id: \"u1\", prompt: \"Read notes.txt\" }], [{ id: \"primary\", provider: gw.origin, endpoint: gw.url, model: \"m\", capabilities: [\"tools\"], rank: 0 }], Date.now()), { store, executor })\n        );\n        taskId = op.units[0].agentTaskId!;\n        assert.ok(taskId, \"unit must have bound agentTaskId\");\n\n        // Verify task state saved execution tracking with repetitions count = 2\n        const savedState = new DurableStateManager({ baseDir: stateDir, workspacePaths: [WorkspacePath.fromSelectedWorkspace(repo)] }).loadTaskState(taskId);\n        assert.ok(savedState.objective?.execution, \"task state must have execution tracking\");\n        const rep = savedState.objective.execution.repetitions.find((r) => r.action.includes(\"read_file\"));\n        assert.ok(rep, \"must have recorded read_file repetition\");\n        assert.equal(rep.count, 2, \"repetition count before resume must be 2\");\n\n        // Now resume the unit in a second turn\n        // On the 3rd repetition (step 1 of resumed turn), tracker must see count = 3 and emit [Nexus recovery 1/3]\n        const more = decisionOf(op, \"u1\").options.find((o) => o.label === \"continue with more steps\")!;\n        applyOperatorDecision(store, id, decisionOf(op, \"u1\").id, more.id);\n        op = await muted(() =>\n          driveOperation(store.load(id), { store, executor })\n        );\n\n        // Check gateway requests: verify recovery note was received by the model\n        const recoveryReq = gw.requests.find((r) => allText(r).includes(\"[Nexus recovery\") && allText(r).includes(\"3 times\"));\n        assert.ok(recoveryReq, \"model must receive recovery note stating action was called 3 times\");\n      } finally {\n        await gw.close();\n        fs.rmSync(repo, { recursive: true, force: true });\n        fs.rmSync(stateDir, { recursive: true, force: true });\n      }\n    });\n  });\n\n  test(\"REQ-AGT-103: recovered verifier baseline persists as continuity evidence but is never trusted\", async () => {\n    await withHome(async () => {\n      const gw = await gateway((b) => done());\n      const repo = makeRepo({ \"test.js\": \"throw new Err…1723 tokens truncated…@@ export class AutonomousAgent {\n   }\n \n   public setApprovalMode(mode: ApprovalMode): void {\n+    // Read-only selected at runtime is a mode choice, not an explicit launch invariant: record that so a later\n+    // /mode auto or /mode review can deliberately leave it, exactly like --mode read-only.\n+    if (mode === \"read-only\" && !this.config.readOnly && !this.config.readOnlyModeSelected) {\n+      this.config.readOnlyModeSelected = true;\n+    }\n+    // config.readOnly is the configured (launch or deliberate mode) posture. The checkpoint fallback is transient\n+    // and must never leak into it, or releasing the fallback could never restore the operator's mode.\n+    const configuredReadOnly = this.modeReadOnly(mode);\n     this.config.approvalMode = mode;\n-    if (mode !== \"auto\") {\n-      this.config.fullAccess = false;\n-    }\n+    this.config.readOnly = configuredReadOnly;\n+    this.config.fullAccess = mode === \"auto\" ? this.configuredFullAccess : false;\n+    this.applyReadOnlyAuthority(this.checkpointReadOnlyFallback || configuredReadOnly);\n     this.clearApprovedEgressOrigins();\n     this.clearApprovedVerifiers();\n   }\n \n+  /** Read-only configured by an explicit launch or by a deliberate mode choice (not the transient fallback). */\n+  private modeReadOnly(mode: ApprovalMode): boolean {\n+    return Boolean((this.config.readOnly && !this.config.readOnlyModeSelected) || mode === \"read-only\");\n+  }\n+\n+  /** Effective read-only authority for a permission mode, including the transient checkpoint fallback. */\n+  private readOnlyForMode(mode: ApprovalMode): boolean {\n+    return Boolean(this.checkpointReadOnlyFallback || this.modeReadOnly(mode));\n+  }\n+\n+  private applyReadOnlyAuthority(readOnly: boolean): void {\n+    this.bridge?.setReadOnly(readOnly);\n+    this.authorityEngine.setReadOnly(readOnly);\n+    this.authorityEngine.setFullAccess(Boolean(this.config.fullAccess) && !readOnly);\n+    this.applyExtensionReadOnly(readOnly);\n+  }\n+\n+  /** Keep workspace-scoped extension managers on the same effective posture as the bridge and authority. */\n+  private applyExtensionReadOnly(readOnly: boolean): void {\n+    // A permission-mode change that does not alter the effective posture (review <-> auto) must not tear down\n+    // connected MCP servers, loaded plugins or the current turn's extensibility state.\n+    const workspace = this.config.workspace;\n+    if (this.extensionPosture?.workspace === workspace && this.extensionPosture.readOnly === readOnly) return;\n+    if (this.knowledge) this.knowledge.setWorkspace(workspace, { readOnly });\n+    if (this.skillManager) this.skillManager.setWorkspace(workspace, { readOnly });\n+    if (this.mcpManager) {\n+      this.mcpManager.shutdownAll();\n+      this.mcpManager = new McpClientManager(workspace, { readOnly });\n+    }\n+    if (this.pluginManager) {\n+      this.pluginManager = new PluginManager(workspace, { readOnly });\n+      if (this.flightRecorder) this.pluginManager.setFlightRecorder(this.flightRecorder);\n+    }\n+    this.extensibilityInitialized = false;\n+    this.extensionPosture = { workspace, readOnly };\n+  }\n+\n   public getApprovalMode(): ApprovalMode {\n     // An explicit --read-only launch is an operator invariant: a later mode change (the /mode slash command,\n     // setApprovalMode) must not lower it. The checkpoint fallback is the same class of restriction.\n-    if (this.checkpointReadOnlyFallback || this.config.readOnly) return \"read-only\";\n+    if (this.readOnlyForMode(this.config.approvalMode ?? \"review\")) return \"read-only\";\n     if (this.config.approvalMode) return this.config.approvalMode;\n     if (this.config.fullAccess) return \"auto\";\n     // Workspace trust controls project instructions and integrations; permission settings alone select approval posture.\n@@ -1280,6 +1331,7 @@ export class AutonomousAgent {\n   /** Restrict this session to read-only authority when its workspace cannot be safely checkpointed. */\n   public setCheckpointReadOnlyFallback(enabled: boolean): void {\n     this.checkpointReadOnlyFallback = enabled;\n+    this.applyReadOnlyAuthority(this.readOnlyForMode(this.config.approvalMode ?? \"review\"));\n     if (enabled) {\n       this.clearApprovedEgressOrigins();\n       this.clearApprovedVerifiers();\n@@ -1287,7 +1339,9 @@ export class AutonomousAgent {\n   }\n \n   private isReadOnly(): boolean {\n-    return Boolean(this.config.readOnly || this.checkpointReadOnlyFallback);\n+    // An explicit launch is authoritative; a mode-selected read-only posture is enforced until the operator\n+    // deliberately changes the mode, and the checkpoint fallback is authoritative for the current turn.\n+    return this.readOnlyForMode(this.config.approvalMode ?? \"review\");\n   }\n \n   private initTaskState(): void {\n@@ -1351,6 +1405,7 @@ export class AutonomousAgent {\n       unverifiedChangesPending: this.hasPendingModifications,\n       durableNotes: notes ? [notes] : undefined,\n       ...(this.compactionProvenance ? { compactionProvenance: this.compactionProvenance } : {}),\n+      ...(this.recoveredOperation !== undefined ? { operation: this.recoveredOperation } : {}),\n       providerRecovery: this.activeProviderRecovery,\n       objective: this.objective ?? null,\n       findings: this.getFindings(),\n@@ -1421,6 +1476,8 @@ export class AutonomousAgent {\n     this.messages = state.messages || [];\n     this.restoreFindings(state.findings);\n     this.objective = state.objective ?? undefined;\n+    this.activeProviderRecovery = state.providerRecovery ?? null;\n+    this.recoveredOperation = state.operation;\n     // Durable task state is writable by the same local user who can run candidate\n     // commands. Never trust a saved baseline, nor capture a new one over a\n     // resumed workspace with pending changes: an attacker could delete the field\n@@ -1726,7 +1783,13 @@ export class AutonomousAgent {\n     this.findingsCondensed = recorded.some((state) => state.reduced);\n   }\n \n-  public restoreSession(msgs: ChatMessage[], unverifiedChangesPending?: boolean, objective?: ObjectiveLedger | null, findings?: readonly string[] | null): void {\n+  public restoreSession(\n+    msgs: ChatMessage[],\n+    unverifiedChangesPending?: boolean,\n+    objective?: ObjectiveLedger | null,\n+    findings?: readonly string[] | null,\n+    recovery?: Pick<DurableTaskState, \"providerRecovery\" | \"operation\" | \"changeBaseline\">,\n+  ): void {\n     this.approvedEgressOrigins.clear();\n     this.approvedVerifiers.clear();\n     this.messages = [...msgs];\n@@ -1738,6 +1801,9 @@ export class AutonomousAgent {\n       this.objective.continuation = { ...this.objective.continuation, segments: 1, lastProgressStep: 0 };\n     }\n     this.settleUnrecordedToolCalls();\n+    this.activeProviderRecovery = recovery?.providerRecovery ?? null;\n+    this.recoveredOperation = recovery?.operation;\n+    this.untrustedRecoveredBaseline = recovery?.changeBaseline ?? undefined;\n     // Session files are writable by the same local identity that can run candidate\n     // commands. Their pending flag and any verifier snapshot cannot authenticate\n     // that the workspace remained unchanged since the session was saved. Treat\n@@ -2045,6 +2111,8 @@ export class AutonomousAgent {\n     const hasTrustedInMemoryBaseline = workspaceIdentityIsCurrent && this.changeBaseline !== undefined && !this.verificationBaselineInvalidated;\n     if (!hasTrustedInMemoryBaseline) this.changeBaseline = undefined;\n     this.verificationBaselineInvalidated = this.verificationBaselineInvalidated || (this.hasPendingModifications && !hasTrustedInMemoryBaseline);\n+    this.recoveredOperation = undefined;\n+    this.activeProviderRecovery = null;\n     this.enabledToolGroups = new Set();\n     this.stepNoticeStep = 0;\n     this.cutResponse = undefined;\n@@ -2120,6 +2188,7 @@ export class AutonomousAgent {\n         this.primaryWorkspacePathIdentity = selectedWorkspace;\n75:  readOnlyModeSelected?: boolean; // Read-only is mode-selected (not the explicit --read-only launch) and may be changed deliberately\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a175d0-ddec-7861-9122-03a48c8a4185","create_time":1792978231.631209}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
