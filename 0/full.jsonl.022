{"timestamp":"2026-10-26T07:42:00.124Z","ordinal":377270,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a176ed-37ea-76a2-9958-cddd74a6f333","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a176ed-37ea-76a2-9958-cddd74a6f333","response_id":"resp_060b64278a9dfb15016adf044629f481a0858a51c1b45d7d92","usage":{"input_tokens":76620,"cached_input_tokens":75648,"cache_write_input_tokens":0,"output_tokens":162,"reasoning_output_tokens":18,"total_tokens":76782},"turn_token_usage":{"input_tokens":27486011,"cached_input_tokens":27257088,"cache_write_input_tokens":0,"output_tokens":60604,"reasoning_output_tokens":32026,"total_tokens":27546615},"thread_token_usage":{"input_tokens":6905095430,"cached_input_tokens":6831291008,"cache_write_input_tokens":0,"output_tokens":19785447,"reasoning_output_tokens":11465480,"total_tokens":6924880877}}}
{"timestamp":"2026-10-26T07:42:02.297Z","ordinal":377271,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a176ed-37ea-76a2-9958-cddd74a6f333","item":{"type":"CommandExecution","id":"exec-33457dea-4a87-4dd0-a73c-b4785ba8fd5d","process_id":"68988","command":["/usr/bin/zsh","-lc","sed -n '610,730p' cli/src/upgrade.ts; sed -n '45,190p' cli/test/upgrade_safety.test.ts; cat /tmp/nexus-v1-main-bbafae/package.json | head -90; git -C /tmp/nexus-v1-main-bbafae tag --list 'v1.0.0-rc.*' --sort=-version:refname | head"],"cwd":"file:///tmp/nexus-v1-main-bbafae","parsed_cmd":[{"type":"unknown","cmd":"sed -n '610,730p' cli/src/upgrade.ts; sed -n '45,190p' cli/test/upgrade_safety.test.ts; cat /tmp/nexus-v1-main-bbafae/package.json | head -90; git -C /tmp/nexus-v1-main-bbafae tag --list 'v1.0.0-rc.*' --sort=-version:refname | head"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    target,\n    targetVersion: targetTag,\n    targetSemver: targetSem,\n    action,\n    canUpgrade,\n    reasons,\n  };\n}\n\n// -----------------------------------------------------------------------------\n// Download, Verification, and Atomic Installation\n// -----------------------------------------------------------------------------\n\nexport function validateDownloadUrl(urlString: string): boolean {\n  let parsed: URL;\n  try {\n    parsed = new URL(urlString);\n  } catch {\n    return false;\n  }\n\n  // Reject URLs with embedded credentials (user:REDACTED@...)\n  if (parsed.username || parsed.REDACTEDword) {\n    return false;\n  }\n\n  const hostname = parsed.hostname.toLowerCase();\n\n  // Test / override environments: allow custom release base URL or releases API host\n  const customBase = process.env.NEXUS_RELEASE_BASE_URL || process.env.NEXUS_RELEASES_URL || process.env.NEXUS_RELEASES_API;\n  if (customBase) {\n    try {\n      const customParsed = new URL(customBase);\n      if (hostname === customParsed.hostname.toLowerCase()) {\n        if (parsed.protocol === \"https:\" || parsed.protocol === \"http:\") {\n          return true;\n        }\n      }\n    } catch {}\n  }\n\n  // Localhost allowed for local mock testing\n  if (hostname === \"127.0.0.1\" || hostname === \"localhost\") {\n    return parsed.protocol === \"http:\" || parsed.protocol === \"https:\";\n  }\n\n  // GitHub allowed domains - must be HTTPS\n  if (parsed.protocol !== \"https:\") {\n    return false;\n  }\n\n  if (hostname === \"github.com\") {\n    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n  }\n\n  if (hostname === \"objects.githubusercontent.com\") {\n    return true;\n  }\n\n  // GitHub now redirects release downloads to its signed release-assets host.\n  // Restrict the path to release objects; never allow this host as a generic CDN.\n  if (hostname === \"release-assets.githubusercontent.com\") {\n    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n  }\n\n  return false;\n}\n\n/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\nfunction safeDownloadOrigin(urlString: string): string {\n  try {\n    return new URL(urlString).origin;\n  } catch {\n    return \"invalid URL\";\n  }\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\n  if (signal) {\n    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n  }\n\n  try {\n    while (hops <= maxHops) {\n      if (!validateDownloadUrl(currentUrl)) {\n        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n      }\n\n      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n        headers.Authorization = `Bearer ${token}`;\n      }\n\n      const res = await fetch(currentUrl, {\n        headers,\n        signal: controller.signal,\n        redirect: \"manual\",\n      });\n\n      // Handle redirect\n      if (res.status === 301 || res.status === 302 || res.status === 307 || res.status === 308) {\n        const location = res.headers.get(\"location\");\n        if (!location) {\n          throw new Error(`HTTP ${res.status} redirect without Location header from ${safeDownloadOrigin(currentUrl)}`);\n        }\n        currentUrl = new URL(location, currentUrl).toString();\n        hops++;\n        continue;\n      }\n  recoverUpgrade,\n  UpgradeJournalEntry,\n} from \"../src/upgrade_journal.js\";\n\nfunction completeRuntimeFixture(directory: string, version: string): void {\n  for (const sub of [\"bin\", \"lib/core\", \"lib/cli/dist\"]) fs.mkdirSync(path.join(directory, sub), { recursive:true });\n  fs.writeFileSync(path.join(directory, \"VERSION\"), version);\n  fs.writeFileSync(path.join(directory, \"lib/cli/dist/index.js\"), \"// fixture CLI payload\\n\");\n  fs.writeFileSync(path.join(directory, \"bin/nexus\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/harness-core\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/nexus-tui\"), `#!/bin/sh\\nif [ \"$1\" = --version ]; then echo ${version}; else echo NEXUS; fi\\n`, { mode:0o755 });\n}\n\ndescribe(\"Download Origin, Redirect & Bounds Safety (REQ-REL-116, ACC-UPG-08)\", () => {\n  it(\"validates allowed release download origins\", () => {\n    // Official GitHub releases\n    assert.equal(\n      validateDownloadUrl(\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0/nexus-linux-x86_64-v1.0.0.tar.gz\"),\n      true\n    );\n    // GitHub release CDN redirect host\n    assert.equal(\n      validateDownloadUrl(\"https://objects.githubusercontent.com/github-production-release-asset-2e65be/12345/nexus.tar.gz\"),\n      true\n    );\n    // Newer GitHub releases redirect to a signed, release-specific asset host.\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/github-production-release-asset/12345/a1111111-1111-4111-8111-111111111111\"),\n      true\n    );\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/other-content/payload.tar.gz\"),\n      false\n    );\n    assert.equal(\n      validateDownloadUrl(\"http://release-assets.githubusercontent.com/github-production-release-asset/12345/asset\"),\n      false\n    );\n    // Localhost allowed for mock test servers\n    assert.equal(validateDownloadUrl(\"http://127.0.0.1:4567/download/v1.0.0/nexus.tar.gz\"), true);\n    assert.equal(validateDownloadUrl(\"http://localhost:4567/download/v1.0.0/nexus.tar.gz\"), true);\n\n    // Disallowed origins\n    assert.equal(validateDownloadUrl(\"https://evil.com/releases/download/nexus.tar.gz\"), false);\n    assert.equal(validateDownloadUrl(\"https://github.com/attacker/nexus-code/releases/download/nexus.tar.gz\"), false);\n    // Reject plain HTTP for remote github.com\n    assert.equal(validateDownloadUrl(\"http://github.com/mikeholownych/nexus-code/releases/download/v1.0.0/nexus.tar.gz\"), false);\n    // Reject embedded credentials\n    assert.equal(validateDownloadUrl(\"REDACTED\"), false);\n  });\n\n  it(\"rejects downloads redirecting to disallowed hosts or exceeding hop limits\", async () => {\n    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-test-\"));\n    let server: http.Server | null = null;\n\n    try {\n      // 1. Server redirecting to evil.com\n      const evilPort = await new Promise<number>((resolve) => {\n        server = http.createServer((req, res) => {\n          if (req.url === \"/redirect-evil\") {\n            res.writeHead(302, { Location: \"https://evil-untrusted-site.com/payload.tar.gz\" });\n            res.end();\n          } else if (req.url === \"/redirect-evil-signed\") {\n            res.writeHead(302, { Location: \"https://evil-untrusted-site.com/payload.tar.gz?token=must-not-appear\" });\n            res.end();\n          } else if (req.url?.startsWith(\"/loop-\")) {\n            const count = parseInt(req.url.replace(\"/loop-\", \"\"), 10);\n            res.writeHead(302, { Location: `http://127.0.0.1:${evilPort}/loop-${count + 1}` });\n            res.end();\n          } else {\n            res.writeHead(404);\n            res.end();\n          }\n        });\n        server.listen(0, \"127.0.0.1\", () => {\n          const addr = server!.address() as any;\n          resolve(addr.port);\n        });\n      });\n\n      const dest1 = path.join(testDir, \"test1.tar.gz\");\n      await assert.rejects(\n        downloadFile(`http://127.0.0.1:${evilPort}/redirect-evil`, dest1, undefined, 5000),\n        /Disallowed download origin or invalid URL/\n      );\n\n      const secretUrl = `http://127.0.0.1:${evilPort}/redirect-evil-signed`;\n      await assert.rejects(downloadFile(secretUrl, path.join(testDir, \"signed.tar.gz\"), undefined, 5000), (error: Error) => {\n        assert.match(error.message, /Disallowed download origin or invalid URL \\(https:\\/\\/evil-untrusted-site\\.com\\)/);\n        assert.doesNotMatch(error.message, /must-not-appear/);\n        return true;\n      });\n\n      // 2. Too many redirects\n      const dest2 = path.join(testDir, \"test2.tar.gz\");\n      await assert.rejects(\n        downloadFile(`http://127.0.0.1:${evilPort}/loop-0`, dest2, undefined, 5000, 3),\n        /Too many redirects/\n      );\n    } finally {\n      if (server) {\n        await new Promise<void>((resolve) => server!.close(() => resolve()));\n      }\n      fs.rmSync(testDir, { recursive: true, force: true });\n    }\n  });\n\n  it(\"follows the allowlisted signed GitHub release-asset redirect without forwarding credentials\", async () => {\n    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-release-asset-\"));\n    const originalFetch = globalThis.fetch;\n    const originalToken = process.env.GITHUB_TOKEN;\n    const requests: Array<{ url: string; authorization: string | null; redirect: string | undefined }> = [];\n    const downloadUrl = \"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.8/nexus.tar.gz\";\n    const signedAssetUrl = \"https://release-assets.githubusercontent.com/github-production-release-asset/1416386345/11111111-2222-4333-8444-555555555555?token=synthetic-signature\";\n\n    try {\n      process.env.GITHUB_TOKEN = \"REDACTED\";\n      globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit) => {\n        const url = String(input);\n        requests.push({\n          url,\n          authorization: new Headers(init?.headers).get(\"authorization\"),\n          redirect: init?.redirect,\n        });\n        if (url === downloadUrl) {\n          return new Response(null, { status: 302, headers: { location: signedAssetUrl } });\n        }\n        if (url === signedAssetUrl) {\n          return new Response(new Uint8Array([0x4e, 0x58, 0x53]), { status: 200 });\n        }\n        throw new Error(`Unexpected mocked download URL: ${new URL(url).origin}`);\n      }) as typeof globalThis.fetch;\n\n      const destination = path.join(testDir, \"release.tar.gz\");\n      await downloadFile(\n        downloadUrl,\n        destination,\n      );\n\n      assert.deepEqual(requests, [\n        {\n          url: downloadUrl,\n          authorization: \"Bearer synthetic-github-token\",\n          redirect: \"manual\",\n        },\n        { url: signedAssetUrl, authorization: null, redirect: \"manual\" },\n{\n  \"name\": \"nexus-code-harness\",\n  \"version\": \"1.0.0-rc.8\",\n  \"description\": \"High-Performance Autonomous Local AI Coding Harness (Codex / Claude-Code style) powered by Rust + TypeScript\",\n  \"scripts\": {\n    \"build:core\": \"cargo build --release --manifest-path core/Cargo.toml\",\n    \"build:cli\": \"npm --prefix cli run build\",\n    \"build\": \"npm run build:core && npm run build:cli\",\n    \"install:cli\": \"npm --prefix cli install\",\n    \"setup\": \"npm run install:cli && npm run build\",\n    \"harness\": \"node cli/dist/index.js\",\n    \"check\": \"node cli/dist/index.js check\",\n    \"models\": \"node cli/dist/index.js models\",\n    \"security-scan\": \"bash scripts/security_gates.sh\",\n    \"audit\": \"npm --prefix cli audit\",\n    \"sbom\": \"bash scripts/generate_sbom.sh\"\n  },\n  \"keywords\": [\n    \"ai-agent\",\n    \"coding-harness\",\n    \"codex\",\n    \"claude-code\",\n    \"rust\",\n    \"typescript\",\n    \"vllm\",\n    \"lm-studio\"\n  ],\n  \"author\": \"\",\n  \"license\": \"MIT\",\n  \"engines\": {\n    \"node\": \">=22\"\n  }\n}\nv1.0.0-rc.8\nv1.0.0-rc.7\nv1.0.0-rc.6\nv1.0.0-rc.5\nv1.0.0-rc.4\nv1.0.0-rc.3\nv1.0.0-rc.2\nv1.0.0-rc.1\n","exit_code":0,"duration":{"secs":1,"nanos":82438450}},"started_at_ms":1793000521213,"completed_at_ms":1793000522296}}
{"timestamp":"2026-10-26T07:42:03.540Z","ordinal":377272,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17728-c713-72d1-adc7-16ecb50de5ca","call_id":"call_aa323d9d0d8b47dd98c55cebffd16ecb","output":[{"type":"input_text","text":"Script completed\nWall time 3.5 seconds\nOutput:\n"},{"type":"input_text","text":"    target,\n    targetVersion: targetTag,\n    targetSemver: targetSem,\n    action,\n    canUpgrade,\n    reasons,\n  };\n}\n\n// -----------------------------------------------------------------------------\n// Download, Verification, and Atomic Installation\n// -----------------------------------------------------------------------------\n\nexport function validateDownloadUrl(urlString: string): boolean {\n  let parsed: URL;\n  try {\n    parsed = new URL(urlString);\n  } catch {\n    return false;\n  }\n\n  // Reject URLs with embedded credentials (user:REDACTED@...)\n  if (parsed.username || parsed.REDACTEDword) {\n    return false;\n  }\n\n  const hostname = parsed.hostname.toLowerCase();\n\n  // Test / override environments: allow custom release base URL or releases API host\n  const customBase = process.env.NEXUS_RELEASE_BASE_URL || process.env.NEXUS_RELEASES_URL || process.env.NEXUS_RELEASES_API;\n  if (customBase) {\n    try {\n      const customParsed = new URL(customBase);\n      if (hostname === customParsed.hostname.toLowerCase()) {\n        if (parsed.protocol === \"https:\" || parsed.protocol === \"http:\") {\n          return true;\n        }\n      }\n    } catch {}\n  }\n\n  // Localhost allowed for local mock testing\n  if (hostname === \"127.0.0.1\" || hostname === \"localhost\") {\n    return parsed.protocol === \"http:\" || parsed.protocol === \"https:\";\n  }\n\n  // GitHub allowed domains - must be HTTPS\n  if (parsed.protocol !== \"https:\") {\n    return false;\n  }\n\n  if (hostname === \"github.com\") {\n    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n  }\n\n  if (hostname === \"objects.githubusercontent.com\") {\n    return true;\n  }\n\n  // GitHub now redirects release downloads to its signed release-assets host.\n  // Restrict the path to release objects; never allow this host as a generic CDN.\n  if (hostname === \"release-assets.githubusercontent.com\") {\n    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n  }\n\n  return false;\n}\n\n/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\nfunction safeDownloadOrigin(urlString: string): string {\n  try {\n    return new URL(urlString).origin;\n  } catch {\n    return \"invalid URL\";\n  }\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\n  if (signal) {\n    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n  }\n\n  try {\n    while (hops <= maxHops) {\n      if (!validateDownloadUrl(currentUrl)) {\n        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n      }\n\n      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n        headers.Authorization = `Bearer ${token}`;\n      }\n\n      const res = await fetch(currentUrl, {\n        headers,\n        signal: controller.signal,\n        redirect: \"manual\",\n      });\n\n      // Handle redirect\n      if (res.status === 301 || res.status === 302 || res.status === 307 || res.status === 308) {\n        const location = res.headers.get(\"location\");\n        if (!location) {\n          throw new Error(`HTTP ${res.status} redirect without Location header from ${safeDownloadOrigin(currentUrl)}`);\n        }\n        currentUrl = new URL(location, currentUrl).toString();\n        hops++;\n        continue;\n      }\n  recoverUpgrade,\n  UpgradeJournalEntry,\n} from \"../src/upgrade_journal.js\";\n\nfunction completeRuntimeFixture(directory: string, version: string): void {\n  for (const sub of [\"bin\", \"lib/core\", \"lib/cli/dist\"]) fs.mkdirSync(path.join(directory, sub), { recursive:true });\n  fs.writeFileSync(path.join(directory, \"VERSION\"), version);\n  fs.writeFileSync(path.join(directory, \"lib/cli/dist/index.js\"), \"// fixture CLI payload\\n\");\n  fs.writeFileSync(path.join(directory, \"bin/nexus\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/harness-core\"), `#!/bin/sh\\necho ${version}\\n`, { mode:0o755 });\n  fs.writeFileSync(path.join(directory, \"lib/core/nexus-tui\"), `#!/bin/sh\\nif [ \"$1\" = --version ]; then echo ${version}; else echo NEXUS; fi\\n`, { mode:0o755 });\n}\n\ndescribe(\"Download Origin, Redirect & Bounds Safety (REQ-REL-116, ACC-UPG-08)\", () => {\n  it(\"validates allowed release download origins\", () => {\n    // Official GitHub releases\n    assert.equal(\n      validateDownloadUrl(\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0/nexus-linux-x86_64-v1.0.0.tar.gz\"),\n      true\n    );\n    // GitHub release CDN redirect host\n    assert.equal(\n      validateDownloadUrl(\"https://objects.githubusercontent.com/github-production-release-asset-2e65be/12345/nexus.tar.gz\"),\n      true\n    );\n    // Newer GitHub releases redirect to a signed, release-specific asset host.\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/github-production-release-asset/12345/a1111111-1111-4111-8111-111111111111\"),\n      true\n    );\n    assert.equal(\n      validateDownloadUrl(\"https://release-assets.githubusercontent.com/other-content/payload.tar.gz\"),\n      false\n    );\n    assert.equal(\n      validateDownloadUrl(\"http://release-assets.githubusercontent.com/github-production-release-asset/12345/asset\"),\n      false\n    );\n    // Localhost allowed for mock test servers\n    assert.equal(validateDownloadUrl(\"http://127.0.0.1:4567/download/v1.0.0/nexus.tar.gz\"), true);\n    assert.equal(validateDownloadUrl(\"http://localhost:4567/download/v1.0.0/nexus.tar.gz\"), true);\n\n    // Disallowed origins\n    assert.equal(validateDownloadUrl(\"https://evil.com/releases/download/nexus.tar.gz\"), false);\n    assert.equal(validateDownloadUrl(\"https://github.com/attacker/nexus-code/releases/download/nexus.tar.gz\"), false);\n    // Reject plain HTTP for remote github.com\n    assert.equal(validateDownloadUrl(\"http://github.com/mikeholownych/nexus-code/releases/download/v1.0.0/nexus.tar.gz\"), false);\n    // Reject embedded credentials\n    assert.equal(validateDownloadUrl(\"REDACTED\"), false);\n  });\n\n  it(\"rejects downloads redirecting to disallowed hosts or exceeding hop limits\", async () => {\n    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-test-\"));\n    let server: http.Server | null = null;\n\n    try {\n      // 1. Server redirecting to evil.com\n      const evilPort = await new Promise<number>((resolve) => {\n        server = http.createServer((req, res) => {\n          if (req.url === \"/redirect-evil\") {\n            res.writeHead(302, { Location: \"https://evil-untrusted-site.com/payload.tar.gz\" });\n            res.end();\n          } else if (req.url === \"/redirect-evil-signed\") {\n            res.writeHead(302, { Location: \"https://evil-untrusted-site.com/payload.tar.gz?token=must-not-appear\" });\n            res.end();\n          } else if (req.url?.startsWith(\"/loop-\")) {\n            const count = parseInt(req.url.replace(\"/loop-\", \"\"), 10);\n            res.writeHead(302, { Location: `http://127.0.0.1:${evilPort}/loop-${count + 1}` });\n            res.end();\n          } else {\n            res.writeHead(404);\n            res.end();\n          }\n        });\n        server.listen(0, \"127.0.0.1\", () => {\n          const addr = server!.address() as any;\n          resolve(addr.port);\n        });\n      });\n\n      const dest1 = path.join(testDir, \"test1.tar.gz\");\n      await assert.rejects(\n        downloadFile(`http://127.0.0.1:${evilPort}/redirect-evil`, dest1, undefined, 5000),\n        /Disallowed download origin or invalid URL/\n      );\n\n      const secretUrl = `http://127.0.0.1:${evilPort}/redirect-evil-signed`;\n      await assert.rejects(downloadFile(secretUrl, path.join(testDir, \"signed.tar.gz\"), undefined, 5000), (error: Error) => {\n        assert.match(error.message, /Disallowed download origin or invalid URL \\(https:\\/\\/evil-untrusted-site\\.com\\)/);\n        assert.doesNotMatch(error.message, /must-not-appear/);\n        return true;\n      });\n\n      // 2. Too many redirects\n      const dest2 = path.join(testDir, \"test2.tar.gz\");\n      await assert.rejects(\n        downloadFile(`http://127.0.0.1:${evilPort}/loop-0`, dest2, undefined, 5000, 3),\n        /Too many redirects/\n      );\n    } finally {\n      if (server) {\n        await new Promise<void>((resolve) => server!.close(() => resolve()));\n      }\n      fs.rmSync(testDir, { recursive: true, force: true });\n    }\n  });\n\n  it(\"follows the allowlisted signed GitHub release-asset redirect without forwarding credentials\", async () => {\n    const testDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-dl-release-asset-\"));\n    const originalFetch = globalThis.fetch;\n    const originalToken = process.env.GITHUB_TOKEN;\n    const requests: Array<{ url: string; authorization: string | null; redirect: string | undefined }> = [];\n    const downloadUrl = \"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.8/nexus.tar.gz\";\n    const signedAssetUrl = \"https://release-assets.githubusercontent.com/github-production-release-asset/1416386345/11111111-2222-4333-8444-555555555555?token=synthetic-signature\";\n\n    try {\n      process.env.GITHUB_TOKEN = \"REDACTED\";\n      globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit) => {\n        const url = String(input);\n        requests.push({\n          url,\n          authorization: new Headers(init?.headers).get(\"authorization\"),\n          redirect: init?.redirect,\n        });\n        if (url === downloadUrl) {\n          return new Response(null, { status: 302, headers: { location: signedAssetUrl } });\n        }\n        if (url === signedAssetUrl) {\n          return new Response(new Uint8Array([0x4e, 0x58, 0x53]), { status: 200 });\n        }\n        throw new Error(`Unexpected mocked download URL: ${new URL(url).origin}`);\n      }) as typeof globalThis.fetch;\n\n      const destination = path.join(testDir, \"release.tar.gz\");\n      await downloadFile(\n        downloadUrl,\n        destination,\n      );\n\n      assert.deepEqual(requests, [\n        {\n          url: downloadUrl,\n          authorization: \"Bearer synthetic-github-token\",\n          redirect: \"manual\",\n        },\n        { url: signedAssetUrl, authorization: null, redirect: \"manual\" },\n{\n  \"name\": \"nexus-code-harness\",\n  \"version\": \"1.0.0-rc.8\",\n  \"description\": \"High-Performance Autonomous Local AI Coding Harness (Codex / Claude-Code style) powered by Rust + TypeScript\",\n  \"scripts\": {\n    \"build:core\": \"cargo build --release --manifest-path core/Cargo.toml\",\n    \"build:cli\": \"npm --prefix cli run build\",\n    \"build\": \"npm run build:core && npm run build:cli\",\n    \"install:cli\": \"npm --prefix cli install\",\n    \"setup\": \"npm run install:cli && npm run build\",\n    \"harness\": \"node cli/dist/index.js\",\n    \"check\": \"node cli/dist/index.js check\",\n    \"models\": \"node cli/dist/index.js models\",\n    \"security-scan\": \"bash scripts/security_gates.sh\",\n    \"audit\": \"npm --prefix cli audit\",\n    \"sbom\": \"bash scripts/generate_sbom.sh\"\n  },\n  \"keywords\": [\n    \"ai-agent\",\n    \"coding-harness\",\n    \"codex\",\n    \"claude-code\",\n    \"rust\",\n    \"typescript\",\n    \"vllm\",\n    \"lm-studio\"\n  ],\n  \"author\": \"\",\n  \"license\": \"MIT\",\n  \"engines\": {\n    \"node\": \">=22\"\n  }\n}\nv1.0.0-rc.8\nv1.0.0-rc.7\nv1.0.0-rc.6\nv1.0.0-rc.5\nv1.0.0-rc.4\nv1.0.0-rc.3\nv1.0.0-rc.2\nv1.0.0-rc.1\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a176ed-37ea-76a2-9958-cddd74a6f333","create_time":1793000523.5398154}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
