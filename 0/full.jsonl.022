ch origin \"refs/tags/$TARGET_TAG:refs/tags/$TARGET_TAG\"\n49:          tag_sha=\"$(git rev-parse \"$TARGET_TAG^{commit}\")\"\n50:          git merge-base --is-ancestor \"$tag_sha\" origin/main\n51:          git checkout --detach \"$tag_sha\"\n52:          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n53:          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n54:          test -f \"docs/releases/$TARGET_TAG.md\"\n55-          if [[ ! -s scripts/release-tools/package.json || ! -s scripts/release-tools/package-lock.json ]] || \\\n56-             ! grep -Fq 'scripts/release-tools/package-lock.json' scripts/package-linux.sh || \\\n57-             ! grep -Fq 'check_deprecated_lock.mjs' scripts/package-linux.sh || \\\n58-             grep -Eq '(^|[[:space:]])npx([[:space:]]|$)' scripts/package-linux.sh scripts/generate_sbom.sh; then\n59:            echo \"The selected RC predates or bypasses the locked notices tool and lock deprecation gate; cross-runner reproduction requires an RC whose tag includes them.\" >&2\n60-            exit 1\n61-          fi\n62:          printf 'tag_sha=%s\\n' \"$tag_sha\" >> \"$GITHUB_OUTPUT\"\n63-          printf 'workflow_sha=%s\\n' \"$GITHUB_WORKFLOW_SHA\" >> \"$GITHUB_OUTPUT\"\n64-      - name: Verify the public RC release is published\n65-        env:\n66-          GH_TOKEN: ${{ github.token }}\n67-        run: |\n68:          gh release view \"$TARGET_TAG\" --json isPrerelease,isDraft \\\n69-            | jq -e '.isPrerelease == true and .isDraft == false' >/dev/null\n70-\n71-  build:\n72:    needs: resolve-tag\n73:    runs-on: ${{ matrix.runner }}\n74-    timeout-minutes: 120\n75-    strategy:\n76-      fail-fast: false\n77-      matrix:\n78:        runner: [ubuntu-22.04, ubuntu-24.04]\n79-    env:\n80:      TARGET_TAG: ${{ inputs.tag }}\n81:      EXPECTED_TAG_SHA: ${{ needs.resolve-tag.outputs.tag_sha }}\n82:      EXPECTED_WORKFLOW_SHA: ${{ needs.resolve-tag.outputs.workflow_sha }}\n83:      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n84-    steps:\n85-      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n86-        with:\n87:          ref: ${{ needs.resolve-tag.outputs.tag_sha }}\n88-          fetch-depth: 0\n89-          persist-credentials: false\n90-      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n--\n96-        run: |\n97-          test \"$(node --version)\" = \"v22.22.1\"\n98-          test \"$(npm --version)\" = \"10.9.4\"\n99:      - name: Verify exact RC source\n100-        run: |\n101-          test \"$(git rev-parse HEAD)\" = \"$EXPECTED_TAG_SHA\"\n102:          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n103:          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n104-          test \"$GITHUB_REF\" = refs/heads/main\n105-      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n106-      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # pinned Rust toolchain action\n--\n122-      - name: Verify the pinned package builder is available\n123-        run: |\n124-          docker info >/dev/null\n125:          test \"$NEXUS_BUILD_CONTAINER_IMAGE\" = 'rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb'\n126:      - name: Build the exact RC package\n127-        env:\n128:          NEXUS_PACKAGE_TOOL_COMMIT: ${{ needs.resolve-tag.outputs.workflow_sha }}\n129-        run: |\n130:          git fetch origin main --no-tags\n131-          git merge-base --is-ancestor \"$NEXUS_PACKAGE_TOOL_COMMIT\" origin/main\n132-          package_tool=\"$RUNNER_TEMP/package-linux.sh\"\n133-          git show \"$NEXUS_PACKAGE_TOOL_COMMIT:scripts/package-linux.sh\" > \"$package_tool\"\n134:          NEXUS_PACKAGE_SOURCE=\"$GITHUB_WORKSPACE\" bash \"$package_tool\" \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\"\n135:      - name: Record source, toolchain, and published-asset identity\n136-        env:\n137:          NEXUS_PACKAGE_TOOL_COMMIT: ${{ needs.resolve-tag.outputs.workflow_sha }}\n138:          NEXUS_PACKAGE_TOOL_SCRIPT: ${{ runner.temp }}/package-linux.sh\n139-        run: |\n140-          git show \"$EXPECTED_WORKFLOW_SHA:scripts/repro-identity.mjs\" > \"$RUNNER_TEMP/repro-identity.mjs\"\n141:          node \"$RUNNER_TEMP/repro-identity.mjs\" record \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\" \\\n142:            \"$RUNNER_TEMP/dist/repro-identity.json\" \"${{ matrix.runner }}\"\n143:      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n144-        with:\n145:          name: nexus-repro-${{ matrix.runner }}\n146-          path: |\n147:            ${{ runner.temp }}/dist/nexus-linux-x86_64-${{ inputs.tag }}.tar.gz\n148:            ${{ runner.temp }}/dist/compatibility.json\n149:            ${{ runner.temp }}/dist/SHA256SUMS\n150:            ${{ runner.temp }}/dist/THIRD_PARTY_NOTICES.txt\n151:            ${{ runner.temp }}/dist/sbom.cdx.json\n152:            ${{ runner.temp }}/dist/install.sh\n153:            ${{ runner.temp }}/dist/repro-identity.json\n154-          if-no-files-found: error\n155-          retention-days: 14\n156-\n157-  compare:\n158:    needs: [resolve-tag, build]\n159-    runs-on: ubuntu-22.04\n160-    env:\n161:      TARGET_TAG: ${{ inputs.tag }}\n162:      EXPECTED_TAG_SHA: ${{ needs.resolve-tag.outputs.tag_sha }}\n163:      EXPECTED_WORKFLOW_SHA: ${{ needs.resolve-tag.outputs.workflow_sha }}\n164-    steps:\n165-      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n166-        with:\n167:          ref: ${{ needs.resolve-tag.outputs.workflow_sha }}\n168-          fetch-depth: 1\n169-          persist-credentials: false\n170-      - name: Verify comparison code is the exact reviewed workflow commit\n--\n172-      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n173-        with:\n174-          name: nexus-repro-ubuntu-22.04\n175:          path: ${{ runner.temp }}/ubuntu-22.04\n176-      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n177-        with:\n178-          name: nexus-repro-ubuntu-24.04\n179:          path: ${{ runner.temp }}/ubuntu-24.04\n180-      - name: Download published RC assets\n181-        env:\n182-          GH_TOKEN: ${{ github.token }}\n183-        run: |\n184:          archive=\"nexus-linux-x86_64-$TARGET_TAG.tar.gz\"\n185-          mkdir -p \"$RUNNER_TEMP/published\"\n186:          gh release download \"$TARGET_TAG\" \\\n187-            --pattern \"$archive\" \\\n188-            --pattern compatibility.json \\\n189-            --pattern SHA256SUMS \\\n--\n191-            --pattern sbom.cdx.json \\\n192-            --pattern install.sh \\\n193-            --dir \"$RUNNER_TEMP/published\"\n194:      - name: Compare both runner builds with each other and the published RC\n195-        run: |\n196:          archive=\"nexus-linux-x86_64-$TARGET_TAG.tar.gz\"\n197:          for runner in ubuntu-22.04 ubuntu-24.04; do\n198:            (cd \"$RUNNER_TEMP/$runner\" && sha256sum --check SHA256SUMS)\n199-          done\n200:          (cd \"$RUNNER_TEMP/published\" && sha256sum --check SHA256SUMS)\n201-          for file in \"$archive\" compatibility.json SHA256SUMS THIRD_PARTY_NOTICES.txt sbom.cdx.json install.sh; do\n202-            cmp \"$RUNNER_TEMP/ubuntu-22.04/$file\" \"$RUNNER_TEMP/ubuntu-24.04/$file\"\n203-            cmp \"$RUNNER_TEMP/ubuntu-22.04/$file\" \"$RUNNER_TEMP/published/$file\"\n204-          done\n205:          node scripts/repro-identity.mjs compare \"$TARGET_TAG\" \"$EXPECTED_TAG_SHA\" \"$EXPECTED_WORKFLOW_SHA\" \\\n206-            \"$RUNNER_TEMP/repro-evidence.json\" \\\n207-            \"$RUNNER_TEMP/ubuntu-22.04/repro-identity.json\" \\\n208-            \"$RUNNER_TEMP/ubuntu-24.04/repro-identit