}) as typeof globalThis.fetch;\\n+\\n+      const destination = path.join(testDir, \\\"release.tar.gz\\\");\\n+      await downloadFile(\\n+        \\\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.8/nexus.tar.gz\\\",\\n+        destination,\\n+      );\\n+\\n+      assert.deepEqual(requests, [\\n+        {\\n+          url: \\\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.8/nexus.tar.gz\\\",\\n+          authorization: \\\"Bearer synthetic-github-token\\\",\\n+          redirect: \\\"manual\\\",\\n+        },\\n+        { url: signedAssetUrl, authorization: null, redirect: \\\"manual\\\" },\\n+      ]);\\n+      assert.deepEqual(fs.readFileSync(destination), Buffer.from([0x4e, 0x58, 0x53]));\\n+    } finally {\\n+      globalThis.fetch = originalFetch;\\n+      if (originalToken === undefined) delete process.env.GITHUB_TOKEN;\\n+      else process.env.GITHUB_TOKEN = REDACTED      fs.rmSync(testDir, { recursive: true, force: true });\\n+    }\\n+  });\\n });\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a17631-4fbf-7c42-94d2-9588e023f6c0","create_time":1792984989.072922}}}
