fs.fsyncSync(destinationFd);\n    fs.closeSync(destinationFd);\n    destinationFd = undefined;\n    syncDirectory(path.dirname(destination));\n  } catch (error) {\n    if (destinationFd !== undefined) try { fs.closeSync(destinationFd); } catch {}\n    if (destinationCreated) {\n      try { fs.unlinkSync(destination); syncDirectory(path.dirname(destination)); } catch {}\n    }\n    throw error;\n  } finally { fs.closeSync(sourceFd); }\n}\nfunction validatePrivateTreeExcept(source: string, excluded: Set<string>): void {\n  if (fs.realpathSync(source) !== path.resolve(source) || !fs.lstatSync(source).isDirectory()) throw new Error(\"State root is redirected\");\n  for (const entry of fs.readdirSync(source)) if (!excluded.has(entry)) validatePrivateTree(path.join(source, entry));\n}\n\nexport interface RecoveryOutcome {\n  recovered: boolean;\n  action: \"rolled_back\" | \"finalized\" | \"none\" | \"cleaned_up\" | \"manual_intervention\" | \"upgrade_in_progress\";\n  details: string;\n}\n\n/**\n * Permanent kernel-owned guard that serializes stale-lock reclamation between\n * concurrent processes. The guard is a regular file that is never unlinked or\n * replaced; mutual exclusion comes from an advisory flock held on the open file\n * description for the whole reclaim section. The kernel releases the lock when\n * the last referring descriptor closes, so a reclaimer killed by SIGKILL or a\n * power loss cannot wedge later upgrades, and no recursive takeover of a stale\n * gate directory is ever performed.\n */\nexport type ReclaimGuard = FileGuard;\n\nconst FLOCK_UTILITY = \"/usr/bin/flock\";\n\n/**\n * Acquires the reclaim guard. Returns null on contention (another live\n * reclaimer holds the kernel lock) and throws on any unsupported or failed\n        process.exit(UPGRADE_EXIT.updateAvailableOrDeclined);\n      }\n    }\n\n    if (!isJson) {\n      console.log(`Starting ${comparison.action} to ${comparison.targetVersion}...`);\n    }\n\n    const result = await performUpgrade(comparison, {\n      prefix: options.prefix,\n      force: options.force,\n      allowDowngrade: options.allowDowngrade,\n      timeoutMs,\n      onProgress: (_stage, detail) => {\n        if (!isJson && detail) {\n          console.log(`  • ${detail}`);\n        }\n      },\n    });\n\n    if (isJson) {\n      console.log(\n        JSON.stringify(\n          {\n            schemaVersion: 1,\n            tool: \"nexus upgrade\",\n            status: \"success\",\n            previousVersion: result.previousVersion,\n            newVersion: result.newVersion,\n            installedPath: result.installedPath,\n            binPath: result.binPath,\nimport { describe, it, beforeEach, afterEach } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport * as fs from \"node:fs\";\nimport fsDefault from \"node:fs\";\nimport { syncBuiltinESMExports } from \"node:module\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { spawnSync, spawn } from \"node:child_process\";\nimport { CURRENT_STATE_SCHEMA_VERSION } from \"../src/core/state.js\";\nimport { verifyInstalledRuntime } from \"../src/upgrade_health.js\";\nimport { writeJournal, readJournal, recoverUpgrade, createPreMigrationBackup, restoreConfigBackup, acquireReclaimGuard, UpgradeJournalEntry, RecoveryOutcome } from \"../src/upgrade_journal.js\";\nimport * as http from \"node:http\";\nimport * as crypto from \"node:crypto\";\nimport { generateCompatibilityMetadata } from \"../src/compatibility.js\";\nimport { performUpgrade, compareInstallationWithRelease, parseSemver, rollbackBinary } from \"../src/upgrade.js\";\nimport { withStateStoreGuard } from \"../src/core/state_store_guard.js\";\nimport { hasPendingStateRestore, recoverPendingStateRestore, restoreFromSources } from \"../src/core/state_restore.js\";\nimport { clientInvocationKind } from \"../src/core/client_lease.js\";\n\ndescribe(\"managed client invocation classification\",()=>{\n it(\"keeps ambiguous maintenance options on the normal client path\",()=>{\n  assert.equal(clientInvocationKind([\"upgrade\",\"--prefix\",\"--restore-backup\"]),\"client\");\n  assert.equal(clientInvocationKind([\"upgrade\",\"--restore-backup\",\"--prefix\"]),\"client\");\n  assert.equal(clientInvocationKind([\"upgrade\",\"--restore-backup=\"]),\"client\");\n  assert.equal(clientInvocationKind([\"upgrade\",\"--restore-backup\",\"/backup\",\"--check\"]),\"client\");\n });\n\n it(\"releases the normal client lease only for recognized metadata and restore commands\",()=>{\n  assert.equal(clientInvocationKind([\"--version\"]),\"metadata\");\n  assert.equal(clientInvocationKind([\"sessions\",\"--help\"]),\"metadata\");\n  assert.equal(clientInvocationKind([\"upgrade\",\"--prefix\",\"/prefix\",\"--restore-backup\",\"/backup\"]),\"restore\");\n  assert.equal(clientInvocationKind([\"upgrade\",\"--prefix\",\"/prefix\"]),\"client\");\n });\n});\n\n"},{"type":"input_text","text":"RESULT 2\nFILE_cli_src_upgrade_journal.ts: {\"agent\":\"codex-root\",\"host\":\"mike-dev\",\"branch\":\"v1/defect-upgrade-backup-progress\",\"worktree\":\"/home/mike/nexus-wt/upgrade-backup-progress\",\"base\":\"62e541c9e170a51d02420753f0807c14d65d7074\",\"since\":\"2026-10-26T02:54:00Z\",\"scope\":\"DEFECT_UPGRADE_BACKUP_LATENCY_20261026; bounded progress and batched directory durability for pre-migration snapshot\"}\nFILE_cli_src_upgrade.ts: {\"agent\":\"codex-root\",\"host\":\"mike-dev\",\"branch\":\"v1/defect-upgrade-backup-progress\",\"worktree\":\"/home/mike/nexus-wt/upgrade-backup-progress\",\"base\":\"62e541c9e170a51d02420753f0807c14d65d7074\",\"since\":\"2026-10-26T02:54:00Z\",\"scope\":\"DEFECT_UPGRADE_BACKUP_LATENCY_20261026; bounded progress and batched directory durability for pre-migration snapshot\"}\nFILE_cli_test_upgrade_transaction_recovery.test.ts: {\"agent\":\"codex-root\",\"host\":\"mike-dev\",\"branch\":\"v1/defect-upgrade-backup-progress\",\"worktree\":\"/home/mike/nexus-wt/upgrade-backup-progress\",\"b