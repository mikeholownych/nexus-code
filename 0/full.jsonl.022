sponsibility.\"\n}\n=== fullAccess authority ===\n28:  readOnly?: boolean;\n32:  fullAccess?: boolean;\n33:  readOnly?: boolean;\n468:  private fullAccess: boolean = false;\n469:  private readOnly: boolean = false;\n478:    this.fullAccess = Boolean(config.fullAccess);\n479:    this.readOnly = Boolean(config.readOnly);\n490:  public setFullAccess(enabled: boolean): void {\n491:    this.fullAccess = enabled;\n494:  public isFullAccess(): boolean {\n495:    return this.fullAccess;\n499:    this.readOnly = enabled;\n503:    return this.readOnly;\n547:    const effectiveReadOnly = this.readOnly || Boolean(context.readOnly);\n550:    if (effectiveReadOnly) {\n568:    if (this.fullAccess) {\n613:    if (this.fullAccess) {\n=== agent fullAccess ===\n1128:      fullAccess: config.fullAccess ?? false,\n1277:      this.config.fullAccess = false;\n1324:    if (this.config.fullAccess) return \"auto\";\n1466:        fullAccess: this.config.fullAccess,\n1861:      fullAccess: Boolean(this.config.fullAccess) && !this.isReadOnly(),\n3934:                fullAccess: Boolean(this.config.fullAccess) && !this.isReadOnly(),\n4582:      fullAccess: Boolean(this.config.fullAccess) && !this.isReadOnly(),\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a175c8-706c-78b3-b68b-5c73a47471ae","create_time":1792977570.6562965}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
