pass 1\nℹ fail 0\n=== tsc ===\nnpm notice\nnpm notice New minor version of npm available! 11.19.0 -> 11.21.1\nnpm notice Changelog: https://github.com/npm/cli/releases/tag/v11.21.1\n=== diffcheck ===\n> build · deepseek-flash\n\u001b[0m$ \u001b[0mgit diff | grep -n \"extensionPosture\\|modeReadOnly\\|applyReadOnlyAuthority\\|recoveredOperation\\|readOnlyModeSelected\" | head -30; git diff --stat; git hash-object cli/src/agent.ts; git diff | wc -c\n9:+  private recoveredOperation?: DurableTaskState[\"operation\"];\n10:+  private extensionPosture?: { workspace: string; readOnly: boolean };\n18:+    this.extensionPosture = { workspace: ws, readOnly: this.isReadOnly() };\n28:+    if (mode === \"read-only\" && !this.config.readOnly && !this.config.readOnlyModeSelected) {\n29:+      this.config.readOnlyModeSelected = true;\n33:+    const configuredReadOnly = this.modeReadOnly(mode);\n36:+    this.applyReadOnlyAuthority(this.checkpointReadOnlyFallback || configuredReadOnly);\n45:+  private modeReadOnly(mode: ApprovalMode): boolean {\n46:+    return Boolean((this.config.readOnly && !this.config.readOnlyModeSelected) || mode === \"read-only\");\n51:+    return Boolean(this.checkpointReadOnlyFallback || this.modeReadOnly(mode));\n54:+  private applyReadOnlyAuthority(readOnly: boolean): void {\n65:+    if (this.extensionPosture?.workspace === workspace && this.extensionPosture.readOnly === readOnly) return;\n77:+    this.extensionPosture = { workspace, readOnly };\n92:+    this.applyReadOnlyAuthority(this.readOnlyForMode(this.config.approvalMode ?? \"review\"));\n111:+      ...(this.recoveredOperation !== undefined ? { operation: this.recoveredOperation } : {}),\n120:+    this.recoveredOperation = state.operation;\n144:+    this.recoveredOperation = recovery?.operation;\n153:+    this.recoveredOperation = undefined;\n176:+    this.applyReadOnlyAuthority(readOnly);\n209:+    this.applyReadOnlyAuthority(readOnly);\n243:-  readOnlyModeSelected?: boolean; // Read-only came from --