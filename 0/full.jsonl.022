ion createTestTar(entries: Array<{ name: string; typeflag?: string; linkname?: string; content?: string; declaredSize?: number }>): Buffer {\n    const blocks: Buffer[] = [];\n\n    for (const ent of entries) {\n      const header = Buffer.alloc(512);\n      // name (100)\n      header.write(ent.name, 0, 100, \"utf8\");\n      // mode (8)\n      header.write(\"0000755\\0\", 100, 8, \"utf8\");\n      // uid (8), gid (8)\n      header.write(\"0001750\\0\", 108, 8, \"utf8\");\n      header.write(\"0001750\\0\", 116, 8, \"utf8\");\n      // size (12)\n      const data = Buffer.from(ent.content || \"\");\n\n  if (hostname === \"github.com\") {\n    return parsed.pathname.startsWith(`/${CANONICAL_REPO}/releases/download/`);\n  }\n\n  if (hostname === \"objects.githubusercontent.com\") {\n    return true;\n  }\n\n  // GitHub now redirects release downloads to its signed release-assets host.\n  // Restrict the path to release objects; never allow this host as a generic CDN.\n  if (hostname === \"release-assets.githubusercontent.com\") {\n    return parsed.pathname.startsWith(\"/github-production-release-asset/\");\n  }\n\n  return false;\n}\n\n/** Release redirects can contain short-lived signed query parameters; diagnostics expose only the origin. */\nfunction safeDownloadOrigin(urlString: string): string {\n  try {\n    return new URL(urlString).origin;\n  } catch {\n    return \"invalid URL\";\n  }\n}\n\nexport async function downloadFile(\n  url: string,\n  destPath: string,\n  signal?: AbortSignal,\n  timeoutMs = 60000,\n  maxHops = 5\n): Promise<void> {\n  let currentUrl = url;\n  let hops = 0;\n\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(new Error(`Download timed out after ${timeoutMs}ms`)), timeoutMs);\n  if (signal) {\n    signal.addEventListener(\"abort\", () => controller.abort(signal.reason), { once: true });\n  }\n\n  try {\n    while (hops <= maxHops) {\n      if (!validateDownloadUrl(currentUrl)) {\n        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n      }\n\n      const headers: Record<string, string> = { \"User-Agent\": \"nexus-upgrade\" };\n      const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;\n      if (token && (new URL(currentUrl)).hostname === \"github.com\") {\n        headers.Authorization = `Bearer ${token}`;\n      }\n\n      const res = await fetch(currentUrl, {\n        headers,\n        signal: controller.signal,\n        redirect: \"manual\",\n      });\n\n      // Handle redirect\n      if (res.status === 301 || res.status === 302 || res.status === 307 || res.status === 308) {\n        const location = res.headers.get(\"location\");\n        if (!location) {\n          throw new Error(`HTTP ${res.status} redirect without Location header from ${safeDownloadOrigin(currentUrl)}`);\n        }\n        currentUrl = new URL(location, currentUrl).toString();\n        hops++;\n        continue;\n      }\n\n      if (!res.ok) {\n        throw new Error(`HTTP ${res.status} downloading from ${safeDownloadOrigin(currentUrl)}`);\n      }\n\n      const contentLengthHeader = res.headers.get(\"content-length\");\n      if (contentLengthHeader) {\n        const contentLength = parseInt(contentLengthHeader, 10);\n        if (contentLength > MAX_DOWNLOAD_BYTES) {\n          throw new Error(`Download size (${contentLength} bytes) exceeds maximum allowed limit (${MAX_DOWNLOAD_BYTES} bytes)`);\n        }\n      }\n\n      const fileStream = fs.createWriteStream(destPath);\n      if (!res.body) {\n        throw new Error(`Empty body downloading from ${safeDownloadOrigin(currentUrl)}`);\n      }\n\n      let bytesDownloaded = 0;\n      const reader = res.body.getReader();\n\n      try {\n        await new Promise<void>((resolve, reject) => {\n          fileStream.on(\"error\", reject);\n          fileStream.on(\"finish\", () => resolve());\n          function pump() {\n            reader.read().then(({ done, value }) => {\n              if (done) {\n                fileStream.end();\n                return;\n              }\n              bytesDownloaded += value.byteLength;\n              if (bytesDownloaded > MAX_DOWNLOAD_BYTES) {\n                reject(new Error(`Download exceeded maximum limit of ${MAX_DOWNLOAD_BYTES} bytes`));\n                return;\n              }\n              fileStream.write(Buffer.from(value), (err) => {\n                if (err) reject(err);\n                else pump();\n              });\n            }).catch(reject);\n          }\n          pump();\n        });\n      } catch (streamErr) {\n        try { fs.unlinkSync(destPath); } catch {}\n        throw streamErr;\n      }\n\n      return;\n    }\n\n    throw new Error(`Too many redirects (exceeded ${maxHops} hops) while downloading`);\n  } finally {\n    clearTimeout(timer);\n  }\n}\n\nexport function computeSha256(filePath: string): string {\n  const hash = crypto.createHash(\"sha256\");\ncli/test/upgrade_safety.test.ts:127:        downloadFile(`http://127.0.0.1:${evilPort}/redirect-evil`, dest1, undefined, 5000),\ncli/test/upgrade_safety.test.ts:132:      await assert.rejects(downloadFile(secretUrl, path.join(testDir, \"signed.tar.gz\"), undefined, 5000), (error: Error) => {\ncli/test/upgrade_safety.test.ts:141:        downloadFile(`http://127.0.0.1:${evilPort}/loop-0`, dest2, undefined, 5000, 3),\ncli/test/inference_transport.test.ts:232:    const realFetch = globalThis.fetch;\ncli/test/inference_transport.test.ts:233:    globalThis.fetch = ((url: any, init: any) => { calls.push(!!JSON.parse(init.body).stream); return realFetch(url, init); }) as any;\ncli/test/inference_transport.test.ts:245:      globalThis.fetch = realFetch;\ncli/test/upgrade_safety.test.ts:127:        downloadFile(`http://127.0.0.1:${evilPort}/redirect-evil`, dest1, undefined, 5000),\ncli/test/upgrade_safety.test.ts:132:      await assert.rejects(downloadFile(secretUrl, path.join(testDir, \"signed.tar.gz