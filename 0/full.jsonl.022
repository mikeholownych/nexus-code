readOnly?: boolean;        // Reject all mutating tool executions and commands\n++<<<<<<< HEAD\n++=======\n+   readOnlyModeSelected?: boolean; // Read-only is mode-selected (not the explicit --read-only launch) and may be changed deliberately\n++>>>>>>> f15618d (fix(agent): restore mode-selected read-only and recovery continuity)\n    approvalMode?: \"auto\" | \"review\" | \"read-only\"; // Permission posture: auto, review, or read-only (DEC-01, independent of folder trust)\n    yes?: boolean;             // Run non-interactively without confirmation prompts (forces auto mode)\n    fullAccess?: boolean;      // Broad full-access mode executing without confirmation prompts (AUTH-007, AUTH-008)\n* Unmerged path cli/test/session_durable_fields.test.ts\n58-  endpoint: string;          // e.g. \"http://localhost:1234/v1\" (LM Studio) or \"http://localhost:8000/v1\" (vLLM)\n59-  model: string;             // e.g. \"qwen2.5-coder-32b-instruct\"\n60-  apiKey?: string;           // Optional for local servers (defaults to \"local\")\n61:  maxSteps: number;          // Steps per segment (default 30). With `continuation` (the default), a segment boundary is a durable checkpoint, never the end of the task.\n62-  /**\n63-   * Automatic continuation past `maxSteps` while the work makes progress (see AutonomousAgent.runTurn). Absent:\n64-   * `maxSteps` ends the turn (LIMIT_REACHED), the legacy single-segment behaviour.\n--\n76-  taskClass?: string;        // Routing hint sent to the gateway as X-Task-Class (e.g. \"review\", \"architecture\")\n77-  plannerTaskClass?: string; // Same, for the planner client\n78-  fallbackEndpoints?: string[]; // Failover endpoint URLs if primary endpoint is unavailable\n79:  pinEndpoint?: boolean;     // Use only `endpoint` (no fallbacks): the operation scheduler owns resource selection\n80-  credentialOrigin?: string;     // Origin apiKey belongs to (default: endpoint's origin); never sent elsewhere\n81-  contextLimit?: number;     // Maximum model context window token limit (default: 65536)\n82-  completionReserveTokens?: number; // Context reserved for each model completion (default: 8192)\n--\n118-  success: boolean;\n119-  output: string;\n120-  error?: string;\n121:  /** The operation's deadline expired before an answer was received (bridge-level; the runner reports its own via `timed_out`). */\n122-  timedOut?: boolean;\n123:  /** The operator's cancel ended the operation (the runner ended the command's process group). */\n124-  cancelled?: boolean;\n125-}\n126-\n--\n139-   * threshold, not a task length: any progressing step resets it (core/execution_tracking.ts defines progress).\n140-   */\n141-  stagnationSteps: number;\n142:  /** Recovery notes the agent may inject for a repeated identical action before stopping (bounded recovery). */\n143-  maxRecoveries: number;\n144-  /** Times the agent may be asked to continue when it stops with acceptance requirements still open. */\n145-  maxCompletionNudges: number;\ncli/test/durable_continuity.test.ts\ncli/test/experimental_and_readonly.test.ts\ncli/test/output_truncation_recovery.test.ts\ncli/test/provider_recovery.test.ts\ncli/test/provider_recovery_agent.test.ts\ncli/test/readonly_command_paths.test.ts\ncli/test/readonly_home.test.ts\ncli/test/readonly_mode_escalation.test.ts\ncli/test/repl_readonly_commands.test.ts\ncli/test/repl_readonly_e2e.test.ts\ncli/test/upgrade_transaction_recovery.test.ts\ncommit f15618d5cbb36af79581bdd3912357a6abd5b0ee\nAuthor: Mike Holownych <mike@holownych.com>\nDate:   Mon Oct 26 01:28:04 2026 +0000\n\n    fix(agent): restore mode-selected read-only and recovery continuity\n    \n    Mode-selected and runtime read-only now stay enforced across the bridge,\n    authority engine, extension managers and workspace/shell reconstruction, while\n    a deliberate /mode change can leave them. The transient checkpoint fallback no\n    longer leaks into the configured posture, and full-access resource confinement\n    is disabled while read-only is effective.\n    \n    Session continuation restores provider recovery, the operation envelope and an\n    untrusted change baseline; durable task recovery preserves the same fields and\n    reset clears transient recovery. Focused regressions cover explicit,\n    mode-selected and runtime read-only, fallback release, manager sync, full-access\n    confinement and recovery fields.\n\ndiff --git a/cli/src/types.ts b/cli/src/types.ts\nindex 24bbb60..ee0c947 100644\n--- a/cli/src/types.ts\n+++ b/cli/src/types.ts\n@@ -70,7 +70,7 @@ export interface HarnessConfig {\n   coreBinaryPath?: string;   // Path to compiled harness-core executable\n   dryRun?: boolean;          // Dry-run simulation mode without persisting file modifications\n   readOnly?: boolean;        // Reject all mutating tool executions and commands\n-  readOnlyModeSelected?: boolean; // Read-only came from --mode or NEXUS_APPROVAL_MODE and may be changed deliberately\n+  readOnlyModeSelected?: boolean; // Read-only is mode-selected (not the explicit --read-only launch) and may be changed deliberately\n   approvalMode?: \"auto\" | \"review\" | \"read-only\"; // Permission posture: auto, review, or read-only (DEC-01, independent of folder trust)\n   yes?: boolean;             // Run non-interactively without confirmation prompts (forces auto mode)\n   fullAccess?: boolean;      // Broad full-access mode executing without confirmation prompts (AUTH-007, AUTH-008)\ndiff --git a/cli/test/session_durable_fields.test.ts b/cli/test/session_durable_fields.test.ts\nindex b4f44d7..51012be 100644\n--- a/cli/test/session_durable_fields.test.ts\n+++ b/cli/test/session_durable_fields.test.ts\n@@ -9,6 +9,7 @@ import { InteractiveRepl } from \"../src/repl.js\";\n import { SidecarServer } from \"../src/sidecar.js\";\n import { newOperation } from \"../src/core/operation.js\";\n import { WorkspacePath } from \"../src/core/workspace_path.js\";\n+import { AutonomousAgent } from \"../src/agent.js\";\n \n test(\"session round-trip preserves operation, provider recovery, and change baseline\", () => {\n   const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-session-durable-fields-\"));\n@@ -170,3 +171,32 @@ test(\"REPL and sidecar save the complete durable recovery envelope\", () => {\n     fs.rmSync(root, { recursive: true, force: true });\n   }\n });\n+\n+test(\"resume preserves recovery fields without trusting the recovered verifier baseline\", () => {\n+  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-resume-durable-fields-\"));\n+  const now = new Date().toISOString();\n+  const operation = newOperation(\"resume-operation\", \"resume operation\", [{ id: \"unit\", prompt: \"continue\" }], [], Date.now());\n+  const providerRecovery = {\n+    state: \"WAITING\", step: 1, startedAt: now, updatedAt: now, condition: \"RATE_LIMITED\", submissions: [], probes: 0, waitedMs: 0, unknownReplays: 0,\n+    policy: { deadlineMs: 1000, maxDelayMs: 100, maxUnknownReplays: 1 },\n+  } as const;\n+  const changeBaseline = { command: \"npm test\", failed: true, tests: null, at: now };\n+  const agent = new AutonomousAgent({ endpoint: \"http://127.0.0.1:9/v1\", model: \"m\", workspace: root, maxSteps: 1 } as any, 0, { durable: false });\n+  try {\n+    agent.restoreConversation({\n+      messages: [{ role: \"user\", content: \"continue\" }],\n+      operation,\n+      providerRecovery,\n+      changeBaseline,\n+    } as any, () => ({ messages: [], unreadableLines: 0, uncommittedLines: 0, missingCompactions: [] }));\n+    const saved = agent.checkpointDurableState();\n+    assert.equal(saved.operation?.id, operation.id);\n+    assert.deepEqual(saved.providerRecovery, providerRecovery);\n+    assert.deepEqual(saved.changeBaseline, changeBaseline);\n+    assert.equal((agent as any).verificationBaselineInvalidated, true);\n+    assert.equal((agent as any).changeBaseline, null);\n+  } finally {\n+    agent.shutdown();\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n","exit_code":0,"duration":{"secs":1,"nanos":3929230}},"started_at_ms":1792978205244,"completed_at_ms":1792978206248}}
