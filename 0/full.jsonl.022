{"timestamp":"2026-10-26T01:30:16.311Z","ordinal":367489,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a175d0-ddec-7861-9122-03a48c8a4185","item":{"type":"CommandExecution","id":"exec-ebf33efc-cc78-472e-81c3-f1868eb9d52b","process_id":"93162","command":["/usr/bin/zsh","-lc","sed -n '62,83p' cli/src/types.ts; git show origin/main:cli/src/types.ts | sed -n '62,83p'; git show origin/main:cli/test/durable_continuity.test.ts | sed -n '1,240p'; git show f15618d5cbb36af79581bdd3912357a6abd5b0ee:cli/test/session_durable_fields.test.ts | sed -n '160,215p'; git diff origin/main...f15618d5cbb36af79581bdd3912357a6abd5b0ee -- cli/src/agent.ts | head -n 220"],"cwd":"file:///home/mike/nexus-wt/agent-readonly-current","parsed_cmd":[{"type":"unknown","cmd":"sed -n '62,83p' cli/src/types.ts; git show origin/main:cli/src/types.ts | sed -n '62,83p'; git show origin/main:cli/test/durable_continuity.test.ts | sed -n '1,240p'; git show f15618d5cbb36af79581bdd3912357a6abd5b0ee:cli/test/session_durable_fields.test.ts | sed -n '160,215p'; git diff origin/main...f15618d5cbb36af79581bdd3912357a6abd5b0ee -- cli/src/agent.ts | head -n 220"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"  /**\n   * Automatic continuation past `maxSteps` while the work makes progress (see AutonomousAgent.runTurn). Absent:\n   * `maxSteps` ends the turn (LIMIT_REACHED), the legacy single-segment behaviour.\n   */\n  continuation?: ContinuationBudget;\n  temperature: number;       // Default 0.2 for precise coding\n  workspace: string;         // Working directory for tools\n  shell: string;             // Linux shell: \"bash\", \"zsh\", \"sh\" (default: \"bash\")\n  coreBinaryPath?: string;   // Path to compiled harness-core executable\n  dryRun?: boolean;          // Dry-run simulation mode without persisting file modifications\n  readOnly?: boolean;        // Reject all mutating tool executions and commands\n<<<<<<< HEAD\n=======\n  readOnlyModeSelected?: boolean; // Read-only is mode-selected (not the explicit --read-only launch) and may be changed deliberately\n>>>>>>> f15618d (fix(agent): restore mode-selected read-only and recovery continuity)\n  approvalMode?: \"auto\" | \"review\" | \"read-only\"; // Permission posture: auto, review, or read-only (DEC-01, independent of folder trust)\n  yes?: boolean;             // Run non-interactively without confirmation prompts (forces auto mode)\n  fullAccess?: boolean;      // Broad full-access mode executing without confirmation prompts (AUTH-007, AUTH-008)\n  taskClass?: string;        // Routing hint sent to the gateway as X-Task-Class (e.g. \"review\", \"architecture\")\n  plannerTaskClass?: string; // Same, for the planner client\n  fallbackEndpoints?: string[]; // Failover endpoint URLs if primary endpoint is unavailable\n  pinEndpoint?: boolean;     // Use only `endpoint` (no fallbacks): the operation scheduler owns resource selection\n  /**\n   * Automatic continuation past `maxSteps` while the work makes progress (see AutonomousAgent.runTurn). Absent:\n   * `maxSteps` ends the turn (LIMIT_REACHED), the legacy single-segment behaviour.\n   */\n  continuation?: ContinuationBudget;\n  temperature: number;       // Default 0.2 for precise coding\n  workspace: string;         // Working directory for tools\n  shell: string;             // Linux shell: \"bash\", \"zsh\", \"sh\" (default: \"bash\")\n  coreBinaryPath?: string;   // Path to compiled harness-core executable\n  dryRun?: boolean;          // Dry-run simulation mode without persisting file modifications\n  readOnly?: boolean;        // Reject all mutating tool executions and commands\n  approvalMode?: \"auto\" | \"review\" | \"read-only\"; // Permission posture: auto, review, or read-only (DEC-01, independent of folder trust)\n  yes?: boolean;             // Run non-interactively without confirmation prompts (forces auto mode)\n  fullAccess?: boolean;      // Broad full-access mode executing without confirmation prompts (AUTH-007, AUTH-008)\n  taskClass?: string;        // Routing hint sent to the gateway as X-Task-Class (e.g. \"review\", \"architecture\")\n  plannerTaskClass?: string; // Same, for the planner client\n  fallbackEndpoints?: string[]; // Failover endpoint URLs if primary endpoint is unavailable\n  pinEndpoint?: boolean;     // Use only `endpoint` (no fallbacks): the operation scheduler owns resource selection\n  credentialOrigin?: string;     // Origin apiKey belongs to (default: endpoint's origin); never sent elsewhere\n  contextLimit?: number;     // Maximum model context window token limit (default: 65536)\n  completionReserveTokens?: number; // Context reserved for each model completion (default: 8192)\n  toolResponseReserveTokens?: number; // Tool-output headroom policy for the following tool results (default: min(4096, context/8))\n/**\n * Durable continuity of work across process death, retries and resumes (acceptance blockers V1 and V2,\n * docs/reviews/NEXUS_ACCEPTANCE_BLOCKERS_2026-10-08.md):\n *\n *   V1  a resumed unit continues its authorized task from its recorded conversation; missing or inconsistent durable\n *       history blocks the unit (only the operator can start it over) and is never read as NOT_REQUIRED.\n *   V2  workspace changes that no verifier has established stay unverified across step limits, retries, process\n *       restarts and every supported resume path, so a later attempt that changes nothing cannot complete the unit.\n *\n * Real AutonomousAgent turns against local scripted gateways; process death uses the real CLI in a child process.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport http from \"node:http\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { randomInt } from \"node:crypto\";\nimport { execSync, spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { ApplicationCore } from \"../src/core/app.js\";\nimport { newOperation, type DurableOperationState, type WorkUnitSpec } from \"../src/core/operation.js\";\nimport { AgentWorkUnitExecutor, applyOperatorDecision, driveOperation, OperationStore } from \"../src/core/operation_runner.js\";\nimport type { ResourceDescriptor } from \"../src/core/resources.js\";\nimport { DurableStateManager } from \"../src/core/state.js\";\nimport { WorkspacePath } from \"../src/core/workspace_path.js\";\nimport { SidecarServer } from \"../src/sidecar.js\";\nimport { type HarnessConfig, DEFAULT_CONTINUATION } from \"../src/types.js\";\nimport { readTaskMessages, updateTaskMessages } from \"../src/core/task_message_log.js\";\n\nconst cliRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst srcIndex = path.join(cliRoot, \"src/index.ts\");\nconst tsxLoader = import.meta.resolve(\"tsx\");\n\nfunction sourceFiles(dir: string): string[] {\n  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {\n    const file = path.join(dir, entry.name);\n    return entry.isDirectory() ? sourceFiles(file) : file.endsWith(\".ts\") ? [file] : [];\n  });\n}\n\ntest(\"all source AutonomousAgent construction sites declare durability explicitly\", () => {\n  const violations: string[] = [];\n  for (const file of sourceFiles(path.join(cliRoot, \"src\"))) {\n    const source = fs.readFileSync(file, \"utf8\");\n    let at = 0;\n    while ((at = source.indexOf(\"new AutonomousAgent(\", at)) >= 0) {\n      const start = at + \"new AutonomousAgent(\".length;\n      let depth = 1;\n      let end = start;\n      for (; end < source.length && depth > 0; end++) {\n        if (source[end] === \"(\") depth++;\n        else if (source[end] === \")\") depth--;\n      }\n      const args = source.slice(start, end - 1);\n      if (!/\\{[^{}]*\\bdurable\\s*:\\s*(?:true|false)\\b[^{}]*\\}\\s*$/s.test(args)) {\n        violations.push(`${path.relative(cliRoot, file)}:${source.slice(0, at).split(\"\\n\").length}`);\n      }\n      at = end;\n    }\n  }\n  assert.deepEqual(violations, []);\n});\n\ntest(\"AgentWorkUnitExecutor default construction persists a durable depth-1 implementer with its unit identity\", async () => {\n  await withHome(async (home) => {\n    const gw = await gateway(() => done(\"one-step unit complete\"));\n    const repo = makeRepo();\n    const stateDir = path.join(home, \".nexus\", \"tasks\");\n    const priorStateDir = process.env.NEXUS_STATE_DIR;\n    process.env.NEXUS_STATE_DIR = path.join(home, \".nexus\");\n    const config = cfg(gw, repo, { maxSteps: 1 });\n    const store = new OperationStore(repo, path.join(home, \".nexus\", \"operations\"));\n    const unit: WorkUnitSpec = { id: \"u-default\", role: \"implementer\", prompt: \"Complete this one-step work unit.\" };\n    const resource: ResourceDescriptor = { id: \"primary\", provider: gw.origin, endpoint: gw.url, model: \"m\", capabilities: [\"tools\"], rank: 0 };\n    let constructed: AutonomousAgent | undefined;\n    const originalRunTurn = AutonomousAgent.prototype.runTurn;\n    AutonomousAgent.prototype.runTurn = function (...args: Parameters<AutonomousAgent[\"runTurn\"]>) {\n      constructed = this;\n      return originalRunTurn.apply(this, args);\n    };\n    try {\n      const executor = new AgentWorkUnitExecutor({ baseConfig: config });\n      const op = await muted(() => driveOperation(newOperation(\"op-default-construction\", \"default construction\", [unit], [resource], Date.now()), { store, executor }));\n      const savedUnit = unitOf(op, unit.id);\n      assert.ok(savedUnit.agentTaskId, \"the executor bound the work-unit task id\");\n      assert.ok(fs.existsSync(path.join(stateDir, `${savedUnit.agentTaskId}.json`)), \"durable task state was persisted under ~/.nexus/tasks\");\n      assert.ok(constructed, \"the default executor constructed an agent\");\n      assert.equal(constructed!.durable, true);\n      assert.equal((constructed as any).depth, 1, \"work-unit agents are depth 1\");\n      assert.equal(constructed!.role, unit.role);\n      assert.equal(constructed!.unitId, unit.id);\n    } finally {\n      AutonomousAgent.prototype.runTurn = originalRunTurn;\n      if (priorStateDir === undefined) delete process.env.NEXUS_STATE_DIR;\n      else process.env.NEXUS_STATE_DIR = priorStateDir;\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n});\n\ntest(\"AgentWorkUnitExecutor applies durable identity when a custom factory omits constructor options\", async () => {\n  await withHome(async (home) => {\n    const gw = await gateway(() => done(\"custom-factory unit complete\"));\n    const repo = makeRepo();\n    const stateDir = path.join(home, \".nexus\", \"tasks\");\n    const priorStateDir = process.env.NEXUS_STATE_DIR;\n    process.env.NEXUS_STATE_DIR = path.join(home, \".nexus\");\n    const config = cfg(gw, repo, { maxSteps: 1 });\n    const store = new OperationStore(repo, path.join(home, \".nexus\", \"operations\"));\n    const unit: WorkUnitSpec = { id: \"u-custom-factory\", role: \"implementer\", prompt: \"Complete this one-step work unit.\" };\n    const resource: ResourceDescriptor = { id: \"primary\", provider: gw.origin, endpoint: gw.url, model: \"m\", capabilities: [\"tools\"], rank: 0 };\n    let constructed: AutonomousAgent | undefined;\n    try {\n      const executor = new AgentWorkUnitExecutor({\n        baseConfig: config,\n        createAgent: (c, depth) => {\n          // Deliberately model a legacy custom factory that ignores the executor's durability options.\n          constructed = quiet(new AutonomousAgent(c, depth));\n          return constructed;\n        },\n      });\n      const op = await muted(() => driveOperation(newOperation(\"op-custom-factory\", \"custom factory\", [unit], [resource], Date.now()), { store, executor }));\n      const savedUnit = unitOf(op, unit.id);\n      assert.ok(savedUnit.agentTaskId, \"the executor bound the work-unit task id\");\n      assert.ok(fs.existsSync(path.join(stateDir, `${savedUnit.agentTaskId}.json`)), \"the custom-factory agent persisted durable task state\");\n      assert.ok(constructed, \"the custom factory constructed an agent\");\n      assert.equal(constructed!.durable, true, \"the executor applies the durability fallback\");\n      assert.equal((constructed as any).depth, 1, \"work-unit agents are depth 1\");\n      assert.equal(constructed!.role, unit.role, \"the executor applies the work-unit role fallback\");\n      assert.equal(constructed!.unitId, unit.id, \"the executor applies the work-unit identity fallback\");\n    } finally {\n      if (priorStateDir === undefined) delete process.env.NEXUS_STATE_DIR;\n      else process.env.NEXUS_STATE_DIR = priorStateDir;\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n});\n\ntest(\"ACC-CONT-03: pressure compaction of a work unit survives SIGKILL and restores archived markers\", async () => {\n  await withHome(async (home) => {\n    const work = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-cont-pressure-crash-\"));\n    const helper = path.join(cliRoot, \"test/helpers/compaction_crash_child.ts\");\n    const child = spawn(process.execPath, [\"--import\", tsxLoader, helper, work, \"work_unit_pressure\"], {\n      cwd: cliRoot,\n      env: { ...process.env, HOME: home },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout.on(\"data\", (chunk) => { stdout += chunk.toString(); });\n    child.stderr.on(\"data\", (chunk) => { stderr += chunk.toString(); });\n    let pressureRepo: string | undefined;\n    const exit = await new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => {\n      child.on(\"close\", (code, signal) => resolve({ code, signal }));\n    });\n    try {\n      assert.ok(exit.signal === \"SIGKILL\" || exit.code === 137, `child must die from SIGKILL; got ${JSON.stringify(exit)}\\n${stdout}\\n${stderr}`);\n      const info = JSON.parse(fs.readFileSync(path.join(work, \"info.json\"), \"utf8\")) as { taskId: string; compactionId: string; stateDir: string; repo: string; markers: string[] };\n      pressureRepo = info.repo;\n      assert.ok(info.markers.includes(\"MARKER-PRESSURE-ALPHA\"), \"the archived marker list includes the first pressure-read file\");\n      const historyPath = path.join(info.stateDir, `${info.taskId}.history.jsonl`);\n      assert.ok(fs.existsSync(historyPath), `history file ${historyPath} exists`);\n      assert.ok(fs.readFileSync(historyPath, \"utf8\").includes(info.compactionId), \"history includes the pressure compaction id\");\n\n      const resumedAgent = quiet(new AutonomousAgent({\n        endpoint: \"http://127.0.0.1:1\",\n        model: \"m\",\n        maxSteps: 2,\n        temperature: 0,\n        workspace: info.repo,\n        shell: \"bash\",\n        approvalMode: \"auto\",\n        fullAccess: true,\n        contextLimit: 18_000,\n        completionReserveTokens: 500,\n        toolResponseReserveTokens: 500,\n      }, 1, undefined, { durable: true, role: \"implementer\", unitId: \"pressure-unit\" }));\n      const resumedState = resumedAgent as any;\n      resumedState.stateManager = new DurableStateManager({ baseDir: info.stateDir, workspacePaths: [resumedState.primaryWorkspacePathIdentity] });\n      await resumedAgent.recoverFromTaskState(info.taskId);\n      for (const marker of info.markers) {\n        const result = await (resumedAgent as any).spine.execute(\n          { invocationId: `archive_${marker}`, taskId: info.taskId, actor: \"agent\", executionDomain: \"agent_orchestration\", toolName: \"read_archive\", args: { query: marker } },\n          { activeTurnSignal: undefined, observer: undefined, metadata: {} },\n        );\n        assert.equal(result.success, true, `read_archive succeeds for ${marker}`);\n        assert.ok(result.output.includes(marker), `archived originals contain ${marker}`);\n      }\n    } finally {\n      if (child.exitCode === null && child.signalCode === null) child.kill();\n      fs.rmSync(work, { recursive: true, force: true });\n      if (pressureRepo) fs.rmSync(pressureRepo, { recursive: true, force: true });\n    }\n  });\n});\n\n// ---------------------------------------------------------------- scripted gateway\n\ntype Reply = { tools: Array<{ name: string; args: unknown }> } | { text: string } | { hold: true };\ninterface Gw { url: string; origin: string; requests: any[]; held: boolean; close(): Promise<void> }\n\n/** Tool-call ids the provider issues: short ones survive persistence redaction, high-entropy ones may not. */\ntype IdStyle = \"low-entropy\" | \"high-entropy\";\nconst ID_ALPHABET = \"REDACTED\";\n/** 32 distinct characters: always above the persistence classifier's entropy threshold. */\nconst highEntropyId = () => {\n  const chars = [...ID_ALPHABET];\n  for (let i = chars.length - 1; i > 0; i--) {\n    const j = randomInt(i + 1);\n    [chars[i], chars[j]] = [chars[j], chars[i]];\n  }\n  return `call_${chars.slice(0, 32).join(\"\")}`;\n};\n\n/** OpenAI-compatible gateway (streaming and not). A `hold` reply never answers: the client waits until it is killed. */\nasync function gateway(script: (body: any) => Reply, ids: IdStyle = \"low-entropy\"): Promise<Gw> {\n  const gw: Gw = { url: \"\", origin: \"\", requests: [], held: false, close: async () => {} };\n  let n = 0;\n  const server = http.createServer((req, res) => {\n    if (req.url?.endsWith(\"/models\")) {\n      res.setHeader(\"content-type\", \"application/json\");\n      return void res.end('{\"data\":[{\"id\":\"m\"}]}');\n    }\n    let raw = \"\";\n    req.on(\"data\", (c) => (raw += c));\n    req.on(\"end\", () => {\n      let body: any = {};\n      try { body = JSON.parse(raw); } catch {}\n      gw.requests.push(body);\n      const reply = script(body);\n      if (\"hold\" in reply) {\n        gw.held = true;\n        return;\n      }\n      const calls = \"tools\" in reply\n        ? reply.tools.map((c, index) => ({ index, id: ids === \"low-entropy\" ? `call_${++n}` : highEntropyId(), type: \"function\", function: { name: c.name, arguments: JSON.stringify(c.args) } }))\n    };\n    sidecar.sessionId = \"sidecar-recovery\";\n    (sidecar as any).saveSession(\"interactive session\");\n\n    for (const id of [\"repl-recovery\", \"sidecar-recovery\"]) {\n      const restored = manager.loadSession(id)!;\n      assert.equal(restored.operation?.id, operation.id, id);\n      assert.deepEqual(restored.providerRecovery, providerRecovery, id);\n      assert.deepEqual(restored.changeBaseline, changeBaseline, id);\n    }\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"resume preserves recovery fields without trusting the recovered verifier baseline\", () => {\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-resume-durable-fields-\"));\n  const now = new Date().toISOString();\n  const operation = newOperation(\"resume-operation\", \"resume operation\", [{ id: \"unit\", prompt: \"continue\" }], [], Date.now());\n  const providerRecovery = {\n    state: \"WAITING\", step: 1, startedAt: now, updatedAt: now, condition: \"RATE_LIMITED\", submissions: [], probes: 0, waitedMs: 0, unknownReplays: 0,\n    policy: { deadlineMs: 1000, maxDelayMs: 100, maxUnknownReplays: 1 },\n  } as const;\n  const changeBaseline = { command: \"npm test\", failed: true, tests: null, at: now };\n  const agent = new AutonomousAgent({ endpoint: \"http://127.0.0.1:9/v1\", model: \"m\", workspace: root, maxSteps: 1 } as any, 0, { durable: false });\n  try {\n    agent.restoreConversation({\n      messages: [{ role: \"user\", content: \"continue\" }],\n      operation,\n      providerRecovery,\n      changeBaseline,\n    } as any, () => ({ messages: [], unreadableLines: 0, uncommittedLines: 0, missingCompactions: [] }));\n    const saved = agent.checkpointDurableState();\n    assert.equal(saved.operation?.id, operation.id);\n    assert.deepEqual(saved.providerRecovery, providerRecovery);\n    assert.deepEqual(saved.changeBaseline, changeBaseline);\n    assert.equal((agent as any).verificationBaselineInvalidated, true);\n    assert.equal((agent as any).changeBaseline, null);\n  } finally {\n    agent.shutdown();\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\ndiff --git a/cli/src/agent.ts b/cli/src/agent.ts\nindex 56bdbd4..65262ba 100644\n--- a/cli/src/agent.ts\n+++ b/cli/src/agent.ts\n@@ -859,6 +859,10 @@ export class AutonomousAgent {\n   private verificationBaselineInvalidated: boolean = false;\n   /** A persisted baseline retained only as untrusted continuity evidence after recovery. */\n   private untrustedRecoveredBaseline?: DurableTaskState[\"changeBaseline\"];\n+  private recoveredOperation?: DurableTaskState[\"operation\"];\n+  private extensionPosture?: { workspace: string; readOnly: boolean };\n+  /** Full-access intent captured at construction; effective only while the mode permits it and read-only is off. */\n+  private configuredFullAccess: boolean = false;\n   /** Evidence from the verifier run that covers the current workspace changes. Cleared by any later mutation. */\n   private verificationEvidence?: VerificationEvidence;\n   private verificationEvidenceRawOutput: string = \"\";\n@@ -1061,6 +1065,7 @@ export class AutonomousAgent {\n       this.config.readOnly = true;\n       this.config.approvalMode = \"read-only\";\n     }\n+    this.configuredFullAccess = Boolean(this.config.fullAccess);\n \n     this.inheritedWorktreeScope = inheritedWorktreeScope;\n     if (inheritedWorktreeScope && path.resolve(config.workspace) !== path.resolve(inheritedWorktreeScope.workspace)) {\n@@ -1113,6 +1118,7 @@ export class AutonomousAgent {\n     this.skillManager = new SkillManager(ws, { readOnly: config.readOnly });\n     this.mcpManager = new McpClientManager(ws, { readOnly: config.readOnly });\n     this.pluginManager = new PluginManager(ws, { readOnly: config.readOnly });\n+    this.extensionPosture = { workspace: ws, readOnly: this.isReadOnly() };\n     this.worktreeManager = new WorktreeManager(ws);\n     if (config.recordFlight) {\n       this.flightRecorder = new FlightRecorder(ws);\n@@ -1122,7 +1128,7 @@ export class AutonomousAgent {\n     this.capabilityRegistry = createDefaultRegistry();\n     this.authorityEngine = new AuthorityAdmissionEngine({\n       readOnly: config.readOnly,\n-      fullAccess: config.fullAccess ?? false,\n+      fullAccess: Boolean(config.fullAccess) && !config.readOnly,\n       workspace: ws,\n       registry: this.capabilityRegistry,\n     });\n@@ -1259,18 +1265,63 @@ export class AutonomousAgent {\n   }\n \n   public setApprovalMode(mode: ApprovalMode): void {\n+    // Read-only selected at runtime is a mode choice, not an explicit launch invariant: record that so a later\n+    // /mode auto or /mode review can deliberately leave it, exactly like --mode read-only.\n+    if (mode === \"read-only\" && !this.config.readOnly && !this.config.readOnlyModeSelected) {\n+      this.config.readOnlyModeSelected = true;\n+    }\n+    // config.readOnly is the configured (launch or deliberate mode) posture. The checkpoint fallback is transient\n+    // and must never leak into it, or releasing the fallback could never restore the operator's mode.\n+    const configuredReadOnly = this.modeReadOnly(mode);\n     this.config.approvalMode = mode;\n-    if (mode !== \"auto\") {\n-      this.config.fullAccess = false;\n-    }\n+    this.config.readOnly = configuredReadOnly;\n+    this.config.fullAccess = mode === \"auto\" ? this.configuredFullAccess : false;\n+    this.applyReadOnlyAuthority(this.checkpointReadOnlyFallback || configuredReadOnly);\n     this.clearApprovedEgressOrigins();\n     this.clearApprovedVerifiers();\n   }\n \n+  /** Read-only configured by an explicit la