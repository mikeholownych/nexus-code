{"timestamp":"2026-10-26T07:02:23.933Z","ordinal":376289,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a176ed-37ea-76a2-9958-cddd74a6f333","item":{"type":"CommandExecution","id":"exec-78f48109-03bf-48a8-bc37-818df300b27c","process_id":"82490","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-code fetch origin --tags && git -C /home/mike/nexus-code show-ref --tags | tail -12 && git -C /home/mike/nexus-code cat-file -t v1.0.0-rc.7 && git -C /home/mike/nexus-code cat-file -p v1.0.0-rc.7 | head -6 && git -C /home/mike/nexus-code show origin/main:.github/workflows/release.yml | sed -n '1,180p' && gh release view v1.0.0-rc.8 --json tagName,url,isPrerelease 2>&1"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-code fetch origin --tags && git -C /home/mike/nexus-code show-ref --tags | tail -12 && git -C /home/mike/nexus-code cat-file -t v1.0.0-rc.7 && git -C /home/mike/nexus-code cat-file -p v1.0.0-rc.7 | head -6 && git -C /home/mike/nexus-code show origin/main:.github/workflows/release.yml | sed -n '1,180p' && gh release view v1.0.0-rc.8 --json tagName,url,isPrerelease 2>&1"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"7e46bb0da88d06552a66ef703f53a05d1de1f37d refs/tags/v0.1.0-alpha.1\nc3dcafac93b5f52d913b4dfb6eb292bbcede4566 refs/tags/v0.1.0-alpha.2\n776cb68964b12b0023d1eaf1ec9c88fbc3546807 refs/tags/v1.0.0-rc.1\na5d01480a339b0f03cae84019858a3277fab9e96 refs/tags/v1.0.0-rc.2\ndd68c222c57d0be0a4245a5b88092ff9df69201f refs/tags/v1.0.0-rc.3\n79b2f4fab6b9584c4e4e3245a5359f009889b7e2 refs/tags/v1.0.0-rc.4\nffccefea5859db9fe5306450f891d1f137ac6c05 refs/tags/v1.0.0-rc.5\n28442fa4be7bfe6cbcb11718b0701360c21791d6 refs/tags/v1.0.0-rc.6\nd1f79e58a27c0f79f1663f662a153ae4ec5a7824 refs/tags/v1.0.0-rc.7\ntag\nobject 431cb194931f09eaaffdb6880dc464c1d7b5e2a1\ntype commit\ntag v1.0.0-rc.7\ntagger Mike Holownych <mike@holownych.com> 1792971813 +0000\n\nNexus Code v1.0.0-rc.7\nname: Release\n\non:\n  push:\n    tags: [\"v*.*.*\"]\n\npermissions:\n  contents: write\n  id-token: write\n  attestations: write\n\njobs:\n  package:\n    runs-on: ubuntu-22.04\n    permissions:\n      contents: write\n      id-token: write\n      attestations: write\n    env:\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          fetch-depth: 0\n      - run: sudo apt-get update\n      - run: sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-release\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-release \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable\n      - name: Install cargo tools (audit, deny, about, cyclonedx)\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22.22.1\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Require the pinned release Node and npm versions\n        run: |\n          test \"$(node --version)\" = \"v22.22.1\"\n          test \"$(npm --version)\" = \"10.9.4\"\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - name: Require a version-matched tag on main\n        run: |\n          git fetch origin main --no-tags\n          git merge-base --is-ancestor \"$GITHUB_SHA\" origin/main\n          test \"${GITHUB_REF_NAME#v}\" = \"$(node -p 'require(\"./package.json\").version')\"\n          node scripts/sync-version.mjs --check --tag \"$GITHUB_REF_NAME\"\n          test -f \"docs/releases/${GITHUB_REF_NAME}.md\" || { echo \"Missing docs/releases/${GITHUB_REF_NAME}.md\" >&2; exit 1; }\n      - name: Require a stable tag to be a version-only commit on its RC\n        if: ${{ !contains(github.ref_name, '-') }}\n        # The checkout has full history and tags (fetch-depth: 0). The checker runs from the RC's own copy so a stable\n        # commit cannot replace it; branch and tag protection remain the control over the workflow file itself.\n        run: |\n          rc=\"$(git tag --points-at \"$GITHUB_SHA^\" | grep -E \"^${GITHUB_REF_NAME//./\\\\.}-rc\\.[0-9]+$\" | sort -V | tail -n 1 || true)\"\n          test -n \"$rc\" || { echo \"the parent of $GITHUB_REF_NAME is not a ${GITHUB_REF_NAME}-rc.N tag\" >&2; exit 1; }\n          git show \"$rc:scripts/check-version-only-diff.mjs\" > \"$RUNNER_TEMP/check-version-only-diff.mjs\"\n          node \"$RUNNER_TEMP/check-version-only-diff.mjs\" \"$rc\" \"$GITHUB_SHA\"\n      - run: npm ci --prefix cli\n      - run: npm --prefix cli run build\n      - run: cargo test --locked --manifest-path core/Cargo.toml\n      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n      - run: npm --prefix cli test\n      - run: bash scripts/security_gates.sh\n      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/dist\"\n      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/repro-check\"\n      - run: cmp \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\" \"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - run: cmp \"$RUNNER_TEMP/dist/SHA256SUMS\" \"$RUNNER_TEMP/repro-check/SHA256SUMS\"\n      - run: cmp \"$RUNNER_TEMP/dist/THIRD_PARTY_NOTICES.txt\" \"$RUNNER_TEMP/repro-check/THIRD_PARTY_NOTICES.txt\"\n      - run: cyclonedx validate --input-file \"$RUNNER_TEMP/dist/sbom.cdx.json\" --fail-on-errors\n      - run: cmp \"$RUNNER_TEMP/dist/sbom.cdx.json\" \"$RUNNER_TEMP/repro-check/sbom.cdx.json\"\n      - run: cmp \"$RUNNER_TEMP/dist/install.sh\" \"$RUNNER_TEMP/repro-check/install.sh\"\n      - run: bash scripts/smoke-package.sh \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - run: bash scripts/installer-smoke.sh \"$GITHUB_WORKSPACE/install.sh\" \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - name: Attest build provenance\n        uses: actions/attest-build-provenance@92c65d2898f1f53cfdc910b962cecff86e7f8fcc # v1\n        with:\n          subject-path: |\n            ${{ runner.temp }}/dist/nexus-linux-x86_64-${{ github.ref_name }}.tar.gz\n            ${{ runner.temp }}/dist/SHA256SUMS\n      # RC tags (vX.Y.Z-rc.N) publish a prerelease: the workflow-produced RC is the qualification candidate\n      # (ACCEPTANCE §1.1 stage 2). Stable tags only build an unpublished draft (stage 5); it is published by hand with\n      # `gh release edit <tag> --draft=false` after the stable artifact checks and the signed acceptance disposition.\n      - uses: softprops/action-gh-release@3bb12739c298aeb8a4eeaf626c5b8d85266b0e65 # v2\n        with:\n          files: ${{ runner.temp }}/dist/*\n          body_path: docs/releases/${{ github.ref_name }}.md\n          prerelease: ${{ contains(github.ref_name, '-') }}\n          draft: ${{ !contains(github.ref_name, '-') }}\nrelease not found\n","exit_code":1,"duration":{"secs":0,"nanos":875315081}},"started_at_ms":1792998143057,"completed_at_ms":1792998143933}}
