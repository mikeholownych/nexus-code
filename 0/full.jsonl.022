/test/upgrade_safety.test.ts:128:        /Disallowed download origin or invalid URL/\n/tmp/nexus-v1-main-bbafae/cli/test/upgrade_safety.test.ts:133:        assert.match(error.message, /Disallowed download origin or invalid URL \\(https:\\/\\/evil-untrusted-site\\.com\\)/);\n/tmp/nexus-v1-main-bbafae/cli/test/upgrade_safety.test.ts:158:    const signedAssetUrl = \"https://release-assets.githubusercontent.com/github-production-release-asset/1416386345/11111111-2222-4333-8444-555555555555?token=synthetic-signature\";\n/tmp/nexus-v1-main-bbafae/cli/test/upgrade_safety.test.ts:175:        throw new Error(`Unexpected mocked download URL: ${new URL(url).origin}`);\n/tmp/nexus-v1-main-bbafae/cli/src/upgrade.ts:671:  if (hostname === \"release-assets.githubusercontent.com\") {\n/tmp/nexus-v1-main-bbafae/cli/src/upgrade.ts:706:        throw new Error(`Disallowed download origin or invalid URL (${safeDownloadOrigin(currentUrl)})`);\n","exit_code":0,"duration":{"secs":0,"nanos":36772}},"started_at_ms":1793000516693,"completed_at_ms":1793000516693}}
