    return [read(\"a.txt\"), read(\"b.txt\"), done(\"markers read\")][Math.min(toolResults(b), 2)];\n  };\n  /** The same unit, but its first attempt writes before reading. */\n  const writer = (b: any): Reply =>\n273:function makeRepo(files: Record<string, string> = {}): string {\n283:async function withHome<T>(fn: (home: string) => Promise<T>): Promise<T> {\n299:function quiet(agent: AutonomousAgent): AutonomousAgent {\n314:const cfg = (gw: Gw, workspace: string, o: Partial<HarnessConfig> = {}): HarnessConfig =>\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a175d0-ddec-7861-9122-03a48c8a4185","create_time":1792978237.9937816}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
