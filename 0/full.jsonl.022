ariable, auth style.\n * - Connection (ResolvedConnection): the base URL actually used, its credential scope and disclosure class.\n * - Model: the provider's model id, passed verbatim (ids may contain \"/\" and \":\").\n * - Role binding: main, planner and coder each name their own provider; subagents and auxiliary calls inherit main.\n */\nimport { classifyDestination } from \"./core/egress.js\";\n\nexport type WireProtocol = \"openai-chat\" | \"openai-responses\" | \"anthropic-messages\";\nexport type AuthStyle = \"bearer\" | \"x-api-key\" | \"none\" | \"oauth\";\n\n/** How an operator can connect a provider from the TUI or `nexus connect`. */\nexport interface ConnectMethod {\n  id: string;\n  label: string;\n  kind: \"key\" | \"browser\" | \"device\";\n  /** Uses another vendor's client identity; the providers' terms may not permit it. */\n  unofficial?: boolean;\n}\n\nexport interface ProviderDefinition {\n  id: string;\n  label: string;\n  protocol: WireProtocol;\n  /** Includes the provider's API path and version; nothing is appended except the operation path. */\n  baseUrl?: string;\n  /** Environment variable holding this provider's key (none for sign-in-only providers). Sent only to the connection's own origin. */\n  credentialEnv?: string;\n  methods: ConnectMethod[];\n  /** The backend accepts streamed requests only; non-streaming calls are streamed internally. */\n  streamOnly?: boolean;\n  /** Request parameters this backend rejects for every model; never sent. */\n  omitParams?: string[];\n  auth: AuthStyle;\n  /** Headers this provider requires on every request. */\n  staticHeaders?: Record<string, string>;\n  /** Ask the provider to report usage (and, where offered, cost) on streamed responses. */\n  usage: \"openrouter\" | \"stream-options\" | \"native\";\n}\n\nexport const PROVIDERS: Readonly<Record<string, ProviderDefinition>> = Object.freeze({\n  openrouter: {\n    id: \"openrouter\",\n    label: \"OpenRouter\",\n    protocol: \"openai-chat\",\n    baseUrl: \"https://openrouter.ai/api/v1\",\n    credentialEnv: \"OPENROUTER_API_KEY\",\n    auth: \"bearer\",\n    staticHeaders: { \"X-Title\": \"Nexus\" },\n    usage: \"openrouter\",\n    methods: [\n      { id: \"api-key\", label: \"API key\", kind: \"key\" },\n      { id: \"openrouter-oauth\", label: \"Sign in with OpenRouter\", kind: \"browser\" },\n    ],\n  },\n  openai: {\n    id: \"openai\",\n    label: \"OpenAI\",\n    protocol: \"openai-responses\",\n    baseUrl: \"https://api.openai.com/v1\",\n    credentialEnv: \"OPENAI_API_KEY\",\n    auth: \"bearer\",\n    usage: \"native\",\n    methods: [{ id: \"api-key\", label: \"API key\", kind: \"key\" }],\n  },\n  anthropic: {\n    id: \"anthropic\",\n    label: \"Anthropic\",\n    protocol: \"anthropic-messages\",\n    baseUrl: \"https://api.anthropic.com/v1\",\n    credentialEnv: \"ANTHROPIC_API_KEY\",\n    auth: \"x-api-key\",\n    staticHeaders: { \"anthropic-version\": \"2023-06-01\" },\n    usage: \"native\",\n    methods: [{ id: \"api-key\", label: \"API key\", kind: \"key\" }],\n  },\n  /** ChatGPT Plus/Pro plan through the Codex backend (unofficial: Codex CLI sign-in). */\n  chatgpt: {\n    id: \"chatgpt\",\n    label: \"ChatGPT plan\",\n    protocol: \"openai-responses\",\n    baseUrl: \"https://chatgpt.com/backend-api/codex\",\n    auth: \"oauth\",\n    staticHeaders: { originator: \"nexus\" },\n    usage: \"native\",\n    streamOnly: true,\n    // The Codex backend serves reasoning models only and sets its own output limit.\n    omitParams: [\"temperature\", \"max_output_tokens\"],\n    methods: [{ id: \"chatgpt-oauth\", label: \"Sign in with ChatGPT (unofficial)\", kind: \"browser\", unofficial: true }],\n  },\n  /** GitHub Copilot subscription (unofficial: VS Code Copilot sign-in). */\n  copilot: {\n    id: \"copilot\",\n    label: \"GitHub Copilot\",\n    protocol: \"openai-chat\",\n    baseUrl: \"https://api.githubcopilot.com\",\n    auth: \"oauth\",\n    usage: \"native\",\n    methods: [{ id: \"copilot-device\", label: \"Sign in with GitHub (unofficial)\", kind: \"device\", unofficial: true }],\n  },\n  /** Any other OpenAI-compatible Chat Completions service; its base URL must be configured by the operator. */\n  compatible: {\n    id: \"compatible\",\n    label: \"OpenAI-compatible\",\n    protocol: \"openai-chat\",\n    credentialEnv: \"NEXUS_COMPATIBLE_API_KEY\",\n    auth: \"bearer\",\n    usage: \"stream-options\",\n    methods: [{ id: \"api-key\", label: \"API key\", kind: \"key\" }],\n  },\n});\n\nexport function providerDefinition(id: string | undefined): ProviderDefinition | undefined {\n  return id ? PROVIDERS[id] : undefined;\n}\n\n/** `NEXUS_<ID>_BASE_URL`: the operator's override of a provider's base URL. */\nexport function baseUrlSetting(id: string): string {\n  return `NEXUS_${id.toUpperCase()}_BASE_URL`;\n}\n\nexport function originOf(url: string | undefined): string | undefined {\n  if (!url?.trim()) return undefined;\n  try {\n    return new URL(url.trim()).origin;\n  } catch {\n    return undefined;\n  }\n}\n\nexport interface ResolvedConnection {\n  /** Undefined for the legacy appliance/endpoint path. */\n  providerId?: string;\n  label: string;\n  protocol: WireProtocol;\n  auth: AuthStyle;\n  staticHeaders: Record<string, string>;\n  usage: ProviderDefinition[\"usage\"] | \"none\";\n  /** Whether requests carry the appliance's X-Task-Class routing hint. */\n  sendTaskClass: boolean;\n  streamOnly: boolean;\n  omitParams: string[];\n}\n\n/** Copilot serves some models through the Responses API only. */\n        Paragraph::new(key_hints(&[(\"enter\", \"use\"), (\"ctrl+p\", \"connect a provider\"), (\"↑↓\", \"move\"), (\"esc\", \"close\")])),\n        footer,\n    );\n    match &picker.catalog {\n        Fetch::Waiting => frame.render_widget(\n            Paragraph::new(Span::styled(\"Listing models from the appliance and connected providers…\", Style::default().fg(MUTED))),\n            list,\n        ),\n        Fetch::Failed(message) => frame.render_widget(\n            Paragraph::new(Span::styled(format!(\"Could not list models: {message}\"), Style::default().fg(Color::Red)))\n                .wrap(Wrap { trim: false }),\n            list,\n        ),\n        Fetch::Ready(_) => {\n            let rows = picker.rows();\n            let selected = picker.selected().map(|(index, _)| index);\n            let filtered = !picker.query.trim().is_empty();\n            if rows.is_empty() {\n                frame.render_widget(Paragraph::new(Span::styled(\"No model matches.\", Style::default().fg(MUTED))), list);\n                return;\n            }\n            let mut in_recent = false;\n            let lines: Vec<Line> = rows\n                .iter()\n                .enumerate()\n                .map(|(index, row)| {\n                    let highlight = Some(index) == selected;\n                    let base = if highlight { Style::default().fg(Color::Black).bg(ACCENT) } else { Style::default().fg(Color::White) };\n                    match row {\n                        Row::Header { title, detail } => {\n                            in_recent = title == \"Recent\";\n                            Line::from(vec![\n                                Span::styled(title.clone(), Style::default().fg(Color::White).add_modifier(Modifier::BOLD)),\n                                Span::styled(if detail.is_empty() { String::new() } else { format!(\"  {detail}\") }, Style::default().fg(MUTED)),\n                            ])\n                        }\n                        Row::Model { model, provider_label, current, .. } => {\n                            let marker = if *current { \"● \" } else { \"  \" };\n                            let mut spans = vec![Span::styled(format!(\"  {marker}{model}\"), if *current && !highlight { base.fg(ACCENT) } else { base })];\n                            if filtered || in_recent {\n                                spans.push(Span::styled(format!(\"  {provider_label}\"), if highlight { base } else { Style::default().fg(MUTED) }));\n                            }\n                            Line::from(spans)\n                        }\n                        Row::Connect { label, .. } => Line::from(Span::styled(\n                            format!(\"  + Connect {label}…\"),\n                            if highlight { base } else { Style::default().fg(Color::Yellow) },\n                        )),\n                        Row::Note(note) => Line::from(Span::styled(format!(\"  {note}\"), Style::default().fg(MUTED).add_modifier(Modifier::ITALIC))),\n                    }\n                })\n                .collect();\n            list_window(frame, list, lines, selected.unwrap_or(0));\n        }\n    }\n}\n\nfn render_connect(frame: &mut Frame, area: Rect, flow: &Connect) {\n    let rect = modal(area, 96, area.height.min(24));\n    let block = titled_block(\" Connect a provider \".into());\n    let inner = block.inner(rect);\n    frame.render_widget(Clear, rect);\n    frame.render_widget(block, rect);\n    if inner.height < 3 {\n        return;\n    }\n    let white = Style::default().fg(Color::White);\n    let muted = Style::default().fg(MUTED);\n    let warn = Style::default().fg(Color::Yellow);\n    let selected = Style::default().fg(Color::Black).bg(ACCENT);\n    let mut lines: Vec<Line> = Vec::new();\n    if let Some((ok, message)) = &flow.notice {\n        lines.push(Line::from(Span::styled(message.clone(), Style::default().fg(if *ok { Color::Green } else { Color::Red }))));\n        lines.push(Line::default());\n    }\n    let label = |id: &str| flow.provider(id).map_or_else(|| id.to_string(), |p| p.label.clone());\n    let mut focus = 0;\n    let hints: &[(&'static str, &'static str)] = match &flow.step {\n        Step::Providers { pick } => {\n            for (index, p) in flow.list().iter().enumerate() {\n                if index == *pick {\n                    focus = lines.len();\n                }\n                let (mark, mark_style) = if p.connected { (\"✓\", Style::default().fg(Color::Green)) } else { (\"○\", muted) };\n                let status = match (&p.source, p.connected) {\n                    (Some(source), true) => format!(\"connected via {source}\"),\n                    _ => \"not connected\".to_string(),\n                };\n                let unofficial = p.methods.iter().any(|m| m.unofficial);\n                let row = if index == *pick { selected } else { white };\n                lines.push(Line::from(vec![\n                    Span::styled(format!(\" {mark} \"), if index == *pick { selected } else { mark_style }),\n                    Span::styled(format!(\"{:<20}\", p.label), row),\n                    Span::styled(format!(\" {status}\"), if index == *pick { selected } else { muted }),\n                    Span::styled(if unofficial { \"  unofficial sign-in\".to_string() } else { String::new() }, if index == *pick { selected } else { warn }),\n                ]));\n            }\n            &[(\"enter\", \"connect\"), (\"ctrl+d\", \"remove Nexus's saved credential\"), (\"esc\", \"back to models\")]\n        }\n        Step::Methods { provider, pick } => {\n            lines.push(Line::from(Span::styled(format!(\"How do you want to connect {}?\", label(provider)), white.add_modifier(Modifier::BOLD))));\n            lines.push(Line::default());\n            let methods = flow.methods(provider);\n            for (index, m) in methods.iter().enumerate() {\n                if index == *pick {\n                    focus = lines.len();\n                                spans.push(Span::styled(format!(\"  {provider_label}\"), if highlight { base } else { Style::default().fg(MUTED) }));\n                            }\n                            Line::from(spans)\n                        }\n                        Row::Connect { label, .. } => Line::from(Span::styled(\n                            format!(\"  + Connect {label}…\"),\n                            if highlight { base } else { Style::default().fg(Color::Yellow) },\n                        )),\n                        Row::Note(note) => Line::from(Span::styled(format!(\"  {note}\"), Style::default().fg(MUTED).add_modifier(Modifier::ITALIC))),\n                    }\n                })\n                .collect();\n            list_window(frame, list, lines, selected.unwrap_or(0));\n        }\n    }\n}\n\nfn render_connect(frame: &mut Frame, area: Rect, flow: &Connect) {\n    let rect = modal(area, 96, area.height.min(24));\n    let block = titled_block(\" Connect a provider \".into());\n    let inner = block.inner(rect);\n    frame.render_widget(Clear, rect);\n    frame.render_widget(block, rect);\n    if inner.height < 3 {\n        return;\n    }\n    let white = Style::default().fg(Color::White);\n    let muted = Style::default().fg(MUTED);\n    let warn = Style::default().fg(Color::Yellow);\n    let selected = Style::default().fg(Color::Black).bg(ACCENT);\n    let mut lines: Vec<Line> = Vec::new();\n    if let Some((ok, message)) = &flow.notice {\n        lines.push(Line::from(Span::styled(message.clone(), Style::default().fg(if *ok { Color::Green } else { Color::Red }))));\n        lines.push(Line::default());\n    }\n    let label = |id: &str| flow.provider(id).map_or_else(|| id.to_string(), |p| p.label.clone());\n    let mut focus = 0;\n    let hints: &[(&'static str, &'static str)] = match &flow.step {\n        Step::Providers { pick } => {\n            for (index, p) in flow.list().iter().enumerate() {\n                if index == *pick {\n                    focus = lines.len();\n                }\n                let (mark, mark_style) = if p.connected { (\"✓\", Style::default().fg(Color::Green)) } else { (\"○\", muted) };\n                let status = match (&p.source, p.connected) {\n                    (Some(source), true) => format!(\"connected via {source}\"),\n                    _ => \"not connected\".to_string(),\n                };\n                let unofficial = p.methods.iter().any(|m| m.unofficial);\n                let row = if index == *pick { selected } else { white };\n                lines.push(Line::from(vec![\n                    Span::styled(format!(\" {mark} \"), if index == *pick { selected } else { mark_style }),\n                    Span::styled(format!(\"{:<20}\", p.label), row),\n                    Span::styled(format!(\" {status}\"), if index == *pick { selected } else { muted }),\n                    Span::styled(if unofficial { \"  unofficial sign-in\".to_string() } else { String::new() }, if index == *pick { selected } else { warn }),\n                ]));\n947:                    // A connect or model-select answer with no panel waiting for it still reaches the operator.\n3955:    const CATALOG: &str = r#\"{\"v\":1,\"type\":\"models.catalog\",\"id\":\"ID\",\"providers\":[{\"id\":\"appliance\",\"label\":\"Appliance (10.0.8.5:8443)\",\"disclosure\":\"local\",\"connected\":true,\"methods\":[],\"status\":\"ok\"},{\"id\":\"chatgpt\",\"label\":\"ChatGPT plan\",\"disclosure\":\"cloud\",\"connected\":true,\"source\":\"Codex CLI\",\"external\":true,\"methods\":[{\"id\":\"chatgpt-oauth\",\"label\":\"Sign in with ChatGPT (unofficial)\",\"kind\":\"browser\",\"unofficial\":true}],\"status\":\"ok\"},{\"id\":\"anthropic\",\"label\":\"Anthropic\",\"disclosure\":\"cloud\",\"connected\":false,\"methods\":[{\"id\":\"api-key\",\"label\":\"API key\",\"kind\":\"key\"}],\"status\":\"disconnected\"}],\"models\":[{\"provider\":\"appliance\",\"id\":\"engineering/b0\"},{\"provider\":\"chatgpt\",\"id\":\"gpt-5-codex\"}],\"current\":{\"provider\":\"appliance\",\"model\":\"engineering/b0\"},\"recent\":[]}\"#;\n3993:            panic!(\"expected provider.connect\");\ncli/src/provider_cli.ts:267:    .argument(\"<provider>\", \"openrouter, openai, anthropic, chatgpt, copilot, compatible\")\ncli/src/providers.ts:106:  /** Any other OpenAI-compatible Chat Completions service; its base URL must be configured by the operator. */\ncli/src/providers.ts:107:  compatible: {\ncli/src/providers.ts:108:    id: \"compatible\",\ncli/src/providers.ts:109:    label: \"OpenAI-compatible\",\ncli/src/providers.ts:111:    credentialEnv: \"NEXUS_COMPATIBLE_API_KEY\",\ncli/src/providers.ts:159:    // Usage is requested (OpenAI-compatible servers such as llama.cpp, vLLM and the appliance gateway report it, with\ncli/src/providers.ts:179: * forwards to a cloud service) is cloud, and every named provider except `compatible` is cloud by definition.\ncli/src/providers.ts:182:  if (providerId && providerId !== \"compatible\") return \"cloud\";\n","exit_code":0,"duration":{"secs":0,"nanos":768345457}},"started_at_ms":1792983515907,"completed_at_ms":1792983516676}}
