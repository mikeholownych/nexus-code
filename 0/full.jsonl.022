433:    if(!collidedPath && typeof directory===\"string\" && directory.includes(`${path.sep}state-backup-`)){\n","exit_code":0,"duration":{"secs":0,"nanos":750535639}},"started_at_ms":1792983391306,"completed_at_ms":1792983392057}}
