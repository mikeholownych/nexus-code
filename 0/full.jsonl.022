s\",\n    \"dev\": \"tsx watch src/index.ts\"\n  },\n  \"keywords\": [\n    \"ai\",\n    \"coding-agent\",\n    \"codex\",\n    \"claude-code\",\n    \"vllm\",\n    \"lm-studio\",\n    \"rust\"\n  ],\n  \"author\": \"\",\n  \"license\": \"MIT\",\n  \"engines\": {\n    \"node\": \">=22\"\n  },\n  \"dependencies\": {\n    \"commander\": \"^12.1.0\",\n    \"dotenv\": \"^16.4.5\",\n    \"ora\": \"^8.1.0\",\n    \"picocolors\": \"^1.1.1\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^22.5.0\",\n    \"tsx\": \"^4.19.0\",\n    \"typescript\": \"^5.5.4\"\n  }\n}\n206:  it(\"does not touch the lock for a completed journal in a read-only package directory\",()=>{\n277: it(\"reports only aggregate backup progress and syncs each copied directory once\",()=>{\n279:  const originalFsync=fsDefault.fsyncSync;\n280:  const directoryFlushes=new Map<string,number>();\n289:   fsDefault.fsyncSync=((fd:number)=>{\n291:    if(stat.isDirectory()){\n293:     directoryFlushes.set(key,(directoryFlushes.get(key)??0)+1);\n295:    return originalFsync(fd);\n296:   }) as typeof fsDefault.fsyncSync;\n301:   const copiedDirectory=path.join(backup.stateBackupDir!,\"state\",\"tasks\");\n302:   const stat=fs.statSync(copiedDirectory);\n303:   assert.equal(directoryFlushes.get(`${stat.dev}:${stat.ino}`),1,\"all task file entries must be synced together after their payloads\");\n304:   assert.equal(fs.readdirSync(copiedDirectory).length,32);\n309:   assert.equal(fs.statSync(path.join(copiedDirectory,\"task-0.json\")).mode&0o777,0o600);\n311:   fsDefault.fsyncSync=originalFsync;\n343: it(\"flushes every automatic backup payload and containing directory before returning\",()=>{\n344:  const home=fs.mkdtempSync(path.join(os.tmpdir(),\"nexus-backup-fsync-\"));\n345:  const originalFsync=fsDefault.fsyncSync;\n352:   for(const directory of [path.join(home,\".nexus\"),path.join(home,\".nexus/sessions\"),sessionDir,path.join(home,\".config\"),configDir]) fs.chmodSync(directory,0o700);\n356:   fsDefault.fsyncSync=((fd:number)=>{\n359:    return originalFsync(fd);\n360:   }) as typeof fsDefault.fsyncSync;\n373:    assert.ok(flushed.has(`${stat.dev}:${stat.ino}`),`backup file was not fsynced: ${file}`);\n383:   for(const directory of expectedDirectories){\n384:    const stat=fs.statSync(directory);\n385:    assert.ok(flushed.has(`${stat.dev}:${stat.ino}`),`backup directory was not fsynced: ${directory}`);\n388:   fsDefault.fsyncSync=originalFsync;\n423: it(\"does not merge into an existing timestamped state backup directory\",()=>{\n432:   fsDefault.mkdirSync=((directory:any,options?:any)=>{\n433:    if(!collidedPath && typeof directory===\"string\" && directory.includes(`${path.sep}state-backup-`)){\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17605-0c8f-7f42-8d4b-980a6c519c84","create_time":1792983393.1526945}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
