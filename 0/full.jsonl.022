) => {\n448:  test(\"ACC-CONT-01: run --resume <id> continues the recovered conversation, objective and task id\", async () => {\n477:  test(\"ACC-CONT-02: run --resume (no id) resumes latest task, or fails with code 2 and guidance\", async () => {\n526:  test(\"ACC-CONT-03: work unit compaction writes archive lines and read_archive returns originals after resume\", async () => {\n588:  test(\"ACC-CONT-04: resume a unit after two identical loops; a third repetition triggers recovery note\", async () => {\n730:  test(\"ACC-VER-06: forged candidate identity cannot clear the verifier obligation after resume\", async () => {\n1020:  test(\"interactive /resume (sidecar): a resumed session keeps its outstanding verification obligation\", async () => {\n1051:  test(\"interactive /resume after the process ended mid-turn: the change made before the end is still unverified\", async () => {\n1098:  test(\"interactive /resume after the host ended inside a writing command: the change is still unverified\", async () => {\n1201:  test(\"interactive /resume (sidecar): saved session obligation flags cannot authenticate a clean workspace\", async () => {\n1460:  test(\"a resumed unit is told its authorized task again and remains unverified after continuation\", async () => {\n1605:  test(\"killed while a writing tool ran: resume blocks, and continuing after inspection cannot complete the unit unverified\", async () => {\n1708:test(\"session continuation restores recovery fields without trusting its verifier baseline\", async () => {\n","exit_code":0,"duration":{"secs":0,"nanos":682006291}},"started_at_ms":1792978336088,"completed_at_ms":1792978336771}}
