\\":\\\"2026-10-25T07:08:15.834962+00:00\\\",\\\"project_id\\\":6,\\\"attachments_policy\\\":\\\"auto\\\",\\\"unread_count\\\":0},{\\\"id\\\":70,\\\"name\\\":\\\"SunnyDeer\\\",\\\"program\\\":\\\"codex-app\\\",\\\"model\\\":\\\"gpt-6.1\\\",\\\"task_description\\\":\\\"Nexus v1 release convergence; PR #211 CI monitoring and safe-boundary coordination\\\",\\\"inception_ts\\\":\\\"2026-10-25T05:26:12.198219+00:00\\\",\\\"last_active_ts\\\":\\\"2026-10-25T05:31:57.733695+00:00\\\",\\\"project_id\\\":6,\\\"attachments_policy\\\":\\\"auto\\\",\\\"unread_count\\\":1},{\\\"id\\\":68,\\\"name\\\":\\\"IvoryOwl\\\",\\\"program\\\":\\\"codex-app\\\",\\\"model\\\":\\\"gpt-6.1\\\",\\\"task_description\\\":\\\"Nexus v1 release convergence; PR207 git exclusion and SUITE safe-boundary coordination\\\",\\\"inception_ts\\\":\\\"2026-10-25T03:30:14.373580+00:00\\\",\\\"last_active_ts\\\":\\\"2026-10-25T04:01:56.660002+00:00\\\",\\\"project_id\\\":6,\\\"attachments_policy\\\":\\\"auto\\\",\\\"unread_count\\\":2},{\\\"id\\\":69,\\\"name\\\":\\\"EmeraldOtter\\\",\\\"program\\\":\\\"codex-app\\\",\\\"model\\\":\\\"gpt-6.1\\\",\\\"task_description\\\":\\\"Nexus v1 release coordinator; PR207 candidate and SUITE safe-boundary coordination\\\",\\\"inception_ts\\\":\\\"2026-10-25T03:41:40.403377+00:00\\\",\\\"last_active_ts\\\":\\\"2026-10-25T03:43:22.670611+00:00\\\",\\\"project_id\\\":6,\\\"attachments_policy\\\":\\\"auto\\\",\\\"unread_count\\\":5}],\\\"retired_agents\\\":[{\\\"id\\\":67,\\\"name\\\":\\\"BlackFox\\\",\\\"program\\\":\\\"codex-app\\\",\\\"model\\\":\\\"gpt-6.1\\\",\\\"task_description\\\":\\\"Nexus v1 release convergence; safe-boundary SUITE handoff and reproducibility fix\\\",\\\"inception_ts\\\":\\\"2026-10-24T13:59:04.523099+00:00\\\",\\\"last_active_ts\\\":\\\"2026-10-24T14:00:41.449428+00:00\\\",\\\"project_id\\\":6,\\\"attachments_policy\\\":\\\"auto\\\",\\\"retired_at\\\":\\\"2026-10-25T14:24:52.571256+00:00\\\",\\\"unread_count\\\":1},{\\\"id\\\":66,\\\"name\\\":\\\"B