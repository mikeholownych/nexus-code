xit0 1/1 log=/tmp/opencode/agent-sidecar-final.log), tsc (exit0 log=/tmp/opencode/agent-tsc-final.log), git diff --check (exit0 log=/tmp/opencode/agent-diffcheck-final.log); isolated HOME/XDG per run; no full suite\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a175e8-4eff-7233-b46c-53eb01e9d36a","create_time":1792979543.572119}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
