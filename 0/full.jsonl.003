{"timestamp":"2026-11-24T06:39:30.220Z","ordinal":107989,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a20c47-edac-76a0-b505-a50ab3c2c090","call_id":"call_6a876101e4a541fd86e2043fc5855e61","output":[{"type":"input_text","text":"Script completed\nWall time 9.3 seconds\nOutput:\n"},{"type":"input_text","text":"{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"_xerj\\\":{\\\"hints\\\":[{\\\"code\\\":\\\"lexical_on_semantic_text\\\",\\\"reason\\\":\\\"`text` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `text`; to keep both signals, combine them with `hybrid`.\\\",\\\"try\\\":{\\\"request\\\":\\\"POST /opencode-*/_search\\\",\\\"body\\\":{\\\"query\\\":{\\\"semantic\\\":{\\\"field\\\":\\\"text\\\",\\\"query\\\":\\\"core.fsmonitor false managed git/config Git commands config include path\\\",\\\"k\\\":10}}}}}]},\\\"took\\\":9006,\\\"timed_out\\\":false,\\\"_shards\\\":{\\\"total\\\":17,\\\"successful\\\":17,\\\"skipped\\\":0,\\\"failed\\\":0},\\\"hits\\\":{\\\"total\\\":{\\\"value\\\":10000,\\\"relation\\\":\\\"gte\\\"},\\\"max_score\\\":129.22124,\\\"hits\\\":[{\\\"_index\\\":\\\"opencode-docs\\\",\\\"_id\\\":\\\"4901d8785dba88b6a17a20f418c9fc78\\\",\\\"_score\\\":111.72904,\\\"_source\\\":{\\\"title\\\":\\\"snapshot-parity.ts\\\",\\\"language\\\":\\\"typescript\\\",\\\"ax_path\\\":\\\"packages/core/script/snapshot-parity.ts\\\",\\\"ax_file\\\":\\\"axf2-c70ea98854f3c98fac6f9932b655c921-6737\\\",\\\"ax_locator\\\":\\\"code\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":563,\\\"start_offset\\\":20334,\\\"end_offset\\\":20520,\\\"text\\\":\\\"(args: string[], cwd = dir) =>\\\\n    $`git -c core.fsmonitor=false -c core.splitIndex=false -c init.defaultBranch=main ${args}`\\\\n      .cwd(cwd)\\\\n      .env(env)\\\\n      .quiet()\\\\n      .text()\\\"}]},\\\"match_line\\\":565,\\\"match_lines\\\":[565]},{\\\"_index\\\":\\\"opencode-docs\\\",\\\"_id\\\":\\\"dd2258b82f2f2ba20340cd40a88720b9\\\",\\\"_score\\\":102.75914,\\\"_source\\\":{\\\"title\\\":\\\"types.ts\\\",\\\"ax_path\\\":\\\"packages/app/src/runtime/server/types.ts\\\",\\\"ax_file\\\":\\\"axf2-88746caba9d842f68e96790f9fdb1957-f95\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":130,\\\"start_offset\\\":2789,\\\"end_offset\\\":3132,\\\"text\\\":\\\"export type Provider = {\\\\n  id: string\\\\n  canonical?: string\\\\n  /** Integration that connects this provider; differs from `id` for Console-managed providers. */\\\\n  integrationID?: string\\\\n  name: string\\\\n  source: \\\\\\\"env\\\\\\\" | \\\\\\\"config\\\\\\\" | \\\\\\\"custom\\\\\\\" | \\\\\\\"api\\\\\\\"\\\\n  env: string[]\\\\n  key?: string\\\\n  options: Record<string, unknown>\\\\n  models: Record<string, Model>\\\\n}\\\"}]},\\\"match_line\\\":134,\\\"match_lines\\\":[134,137]},{\\\"_index\\\":\\\"opencode-docs\\\",\\\"_id\\\":\\\"cd2a3d67b66d7e6227421c3e2ff4994c\\\",\\\"_score\\\":90.65454,\\\"_source\\\":{\\\"title\\\":\\\"tabs.spec.ts\\\",\\\"language\\\":\\\"typescript\\\",\\\"ax_path\\\":\\\"packages/app/e2e/regression/tabs.spec.ts\\\",\\\"ax_file\\\":\\\"axf2-3a3ce700554e936295359e27c6d40ac6-978d\\\",\\\"ax_locator\\\":\\\"code\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":154,\\\"start_offset\\\":5867,\\\"end_offset\\\":7909,\\\"text\\\":\\\"  )\\\\n  await page.goto(sessionHref(a.id))\\\\n  await expect(page.locator(\\\\\\\"[data-titlebar-tab-slot]:visible\\\\\\\")).toHaveCount(2)\\\\n  await expect(page.locator(`[data-titlebar-tab-slot]:has(a[href=\\\\\\\"${sessionHref(c.id)}\\\\\\\"])`)).toBeVisible()\\\\n\\\\n  await page.keyboard.press(\\\\\\\"Control+Alt+ArrowRight\\\\\\\")\\\\n\\\\n  await expectPath(page, sessionHref(c.id))\\\\n})\\\\n\\\\ntest(\\\\\\\"option arrows move to the previous or next tab, and with shift to the next unread one\\\\\\\", async ({ page }) => {\\\\n  await mockWorkspace(page, {\\\\n    name: \\\\\\\"Tabs\\\\\\\",\\\\n    sessions: [a, b, c],\\\\n    sessionPermissions: {\\\\n      [c.id]: [\\\\n        { id: \\\\\\\"permission-tab-c\\\\\\\", sessionID: c.id, action: \\\\\\\"shell\\\\\\\", resources: [\\\\\\\"git status\\\\\\\"], metadata: {}, save: [] },\\\\n      ],\\\\n    },\\\\n  })\\\\n  await page.goto(sessionHref(a.id))\\\\n  await page.mouse.move(0, 0)\\\\n  await expect(\\\\n    page.locator(`[data-titlebar-tab-slot]:has(a[href=\\\\\\\"${sessionHref(c.id)}\\\\\\\"]) [data-slot=\\\\\\\"tab-unread-dot\\\\\\\"]`),\\\\n  ).toBeVisible()\\\\n\\\\n  await page.keyboard.press(\\\\\\\"Alt+ArrowDown\\\\\\\")\\\\n  await expectPath(page, sessionHref(b.id))\\\\n\\\\n  await page.keyboard.press(\\\\\\\"Alt+ArrowUp\\\\\\\")\\\\n  await expectPath(page, sessionHref(a.id))\\\\n\\\\n  await page.keyboard.press(\\\\\\\"Shift+Alt+ArrowDown\\\\\\\")\\\\n  await expectPath(page, sessionHref(c.id))\\\\n})\\\\n\\\\nfor (const row of [\\\\n  { tabLayout: \\\\\\\"horizontal\\\\\\\", width: 360, hasTouch: false, direction: \\\\\\\"ltr\\\\\\\" },\\\\n  { tabLayout: \\\\\\\"vertical\\\\\\\", width: 390, hasTouch: true, direction: \\\\\\\"rtl\\\\\\\" },\\\\n]) {\\\\n  test.describe(`mobile drawer (${row.tabLayout})`, () => {\\\\n    test.use({ hasTouch: row.hasTouch })\\\\n    test(`mobile drawer exposes close controls and navigates between tabs (${row.tabLayout})`, async ({ page }) => {\\\\n      await page.setViewportSize({ width: row.width, height: 720 })\\\\n      await mockWorkspace(page, {\\\\n        name: \\\\\\\"Tabs\\\\\\\",\\\\n        sessions: [a, b, c],\\\\n        sessionPermissions: {\\\\n          [b.id]: [\\\\n            {\\\\n              id: \\\\\\\"permission-mobile-b\\\\\\\",\\\\n              sessionID: b.id,\\\\n              action: \\\\\\\"shell\\\\\\\",\\\\n              resources: [\\\\\\\"git status\\\\\\\"],\\\\n              metadata: {},\\\\n              save: [],\\\\n            },\\\\n          ],\\\\n        },\\\"}]},\\\"match_line\\\":192,\\\"match_lines\\\":[171,192,208]}]},\\\"_token_budget\\\":{\\\"tokenizer\\\":\\\"standard-uax29-words\\\",\\\"max_tokens\\\":700,\\\"hits_full\\\":3,\\\"hits_locator_only\\\":[{\\\"_index\\\":\\\"opencode-docs\\\",\\\"_id\\\":\\\"a9c5944a6d7eadd348aa4049e82eee6c\\\",\\\"ax_path\\\":\\\"packages/cli/src/commands/commands.ts\\\",\\\"ax_file\\\":\\\"axf2-b81a59ab29e86f0acc51ad75343522df-59ae\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"match_line\\\":283,\\\"match_lines\\\":[283,289,290,297]}],\\\"deduped_overlapping\\\":0,\\\"hits_dropped\\\":0,\\\"tokens_used\\\":602}}\"}],\"isError\":false}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20c42-e8d0-7ec1-8d46-757074eef47b","create_time":1795502370.2206304}},"metadata":{"history_sequence":48549,"sampled_through_sequence":48538,"client_authored":false,"fallback_token_limit_override":12000}}
