{"timestamp":"2026-11-24T06:49:01.973Z","ordinal":108292,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20c49-1bcf-7563-9889-443e19f9956a","item":{"type":"CommandExecution","id":"exec-fab756d7-ef72-46fe-8a10-915721d0e4f8","process_id":"4530","command":["/usr/bin/zsh","-lc","rg -n 'context inspection and maturity execute' cli/test/context_inventory.test.ts; sed -n '440,570p' cli/test/context_inventory.test.ts; git diff --stat; git diff -- cli/src/core/workspace_git_safety.ts cli/src/agent.ts cli/src/slash/workspace_commands.ts cli/test/context_inventory.test.ts | sed -n '1,260p'"],"cwd":"file:///home/mike/nexus-wt/context-maturity-v130","parsed_cmd":[{"type":"unknown","cmd":"rg -n 'context inspection and maturity execute' cli/test/context_inventory.test.ts; sed -n '440,570p' cli/test/context_inventory.test.ts; git diff --stat; git diff -- cli/src/core/workspace_git_safety.ts cli/src/agent.ts cli/src/slash/workspace_commands.ts cli/test/context_inventory.test.ts | sed -n '1,260p'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"465:test(\"context inspection and maturity execute without provider calls and emit parseable evidence\", async () => {\n\n  const carried = buildContextInventory({ sources: [{\n    name: \"session\", status: \"ok\", durationMs: 1,\n    items: [{ ...input(\"session:summary\", \"session\"), sourceType: \"compaction_summary\" }],\n  }] });\n  assert.equal(assessContextMaturity(carried, { hasDurableKnowledge: false, hasActiveSkills: false }).dimensions.find((item) => item.dimension === \"compounding_value\")?.level, 2,\n    \"a carried compaction summary is observable cross-turn context evidence\");\n});\n\ntest(\"context command is discoverable and dispatched through the common REPL/TUI route\", async () => {\n  const spec = SLASH_COMMANDS.find((item) => item.name === \"context\");\n  assert.ok(spec);\n  assert.ok(spec.usage.includes(\"/context inspect\"));\n  assert.ok(spec.usage.includes(\"--budget-ms\"));\n  assert.equal(hasHandler(\"context\"), true);\n  const outcome = await routeSlash({} as any, \"context\", \"not-a-view\", new AbortController().signal);\n  assert.equal(outcome.kind, \"reply\");\n  assert.equal(outcome.command, \"context\");\n  assert.equal(outcome.success, false);\n  assert.equal(replReadOnlyAllowed(\"context\", \"inspect --json\"), true);\n  assert.equal(replReadOnlyAllowed(\"context\", \"inspect --record\"), false);\n  assert.equal(readOnlySlashAllowed(\"context\", \"maturity --json\"), true);\n  assert.equal(readOnlySlashAllowed(\"context\", \"inspect --record\"), false);\n});\n\ntest(\"context inspection and maturity execute without provider calls and emit parseable evidence\", async () => {\n  const systemPrompt = \"private composite system prompt\";\n  const agent = {\n    getMessages: () => [{ role: \"system\", content: systemPrompt }, { role: \"user\", content: \"private prompt text\" }],\n    getSystemPromptContextSources: () => [{ ...input(\"client:system-policy\", \"session\", systemPrompt), sourceType: \"client_system_prompt\", sourceRefs: [\"request:message:0\"] }],\n    getObjective: () => null,\n    getActivePlan: () => [],\n    getKnowledgeGraph: () => ({\n      list: () => [{\n        id: \"memory-1\",\n        updatedAt: \"2026-11-23T10:00:00.000Z\",\n        category: \"rule\",\n        key: \"test rule\",\n        value: \"remembered claim\",\n        validationStatus: \"operator_reviewed_unverified\",\n        provenance: { sourceRefs: [\"operator-note:1\"] },\n        retention: { policy: \"until_deleted\" },\n      }],\n    }),\n    getSkillManager: () => ({ listSkills: () => [\n      { name: \"workspace-guide\", description: \"Workspace rules\", path: path.join(process.cwd(), \".agents/skills/workspace-guide/SKILL.md\"), isWorkspaceSkill: true, trusted: true },\n      { name: \"profile-guide\", description: \"Profile rules\", path: path.join(os.homedir(), \".nexus/skills/profile-guide/SKILL.md\"), isWorkspaceSkill: false, trusted: true },\n    ] }),\n    getEffectiveTools: () => [],\n    getProviderCapabilities: () => null,\n    getLastRequestCount: () => undefined,\n    getContextBudget: () => ({ contextLimit: 2048 }),\n    getTaskId: () => \"ctx-task\",\n    getWorkspaceContextFingerprint: () => \"b\".repeat(64),\n    getInferenceContextManifests: () => [buildInferenceContextManifest({\n      id: \"ctxreq_aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee\", sequence: 1,\n      messages: [{ role: \"user\", content: \"private request body\" }], tools: [],\n      contextLimit: 2048, contextLimitSource: \"client_default\", outputAllowance: 128, outputAllowanceSource: \"client_default\", toolResponseReserve: 64,\n    })],\n  };\n  const host = {\n    app: {\n      getAgent: () => agent,\n      getConfig: () => ({ workspace: process.cwd() }),\n      getSessionManager: () => ({ loadSession: () => null }),\n    },\n    sessionId: () => \"ctx-session\",\n  } as any;\n  const inspected = await routeSlash(host, \"context\", \"inspect --json\", new AbortController().signal);\n  assert.equal(inspected.kind, \"reply\");\n  assert.equal(inspected.success, true);\n  const snapshot = JSON.parse(inspected.output);\n  assert.equal(snapshot.sessionId, \"ctx-session\");\n  assert.equal(snapshot.coverage, \"partial\");\n  assert.equal(JSON.stringify(snapshot).includes(\"private prompt text\"), false);\n  assert.ok(snapshot.items.some((item: any) => item.sourceType === \"inference_request_manifest\"));\n  assert.equal(snapshot.coverageGaps.some((gap: string) => gap.includes(\"does not yet persist a per-inference manifest\")), false);\n  assert.equal(snapshot.coverageGaps.some((gap: string) => gap.includes(\"active system prompt sections could not be linked\")), false);\n  assert.equal(snapshot.items.some((item: any) => item.sourceRefs?.includes(\"request:message:0\")), true);\n  const memoryItem = snapshot.items.find((item: any) => item.sourceType === \"durable_knowledge\");\n  assert.equal(memoryItem?.freshness, \"unknown\");\n  assert.match(memoryItem?.freshnessRule ?? \"\", /underlying memory sources are not fingerprinted/);\n  assert.equal(memoryItem?.sourceVersion, JSON.stringify([\"2026-11-23T10:00:00.000Z\", \"operator_reviewed_unverified\"]));\n  assert.equal(memoryItem?.sourceRefs?.includes(\"operator-note:1\"), true);\n  const workspaceSkill = snapshot.items.find((item: any) => item.sourceLocation === \"repository:skill:.agents/skills/workspace-guide/SKILL.md\");\n  const profileSkill = snapshot.items.find((item: any) => item.sourceLocation === \"profile:skill:profile-guide\");\n  assert.equal(workspaceSkill?.scope, \"repository\");\n  assert.equal(workspaceSkill?.freshness, \"unknown\", \"inventory does not claim file freshness without source revalidation\");\n  assert.equal(profileSkill?.scope, \"profile\");\n  assert.equal(profileSkill?.freshness, \"unknown\");\n  assert.equal(snapshot.items.some((item: any) => item.sourceType === \"system_context\"), false);\n  assert.equal(snapshot.metrics.tokenSource, \"client_estimate\");\n  const bounded = await routeSlash(host, \"context\", \"inspect --json --max-items 1\", new AbortController().signal);\n  const boundedSnapshot = JSON.parse(bounded.output);\n  assert.equal(boundedSnapshot.items.length, 1);\n  assert.ok(boundedSnapshot.metrics.omittedItems > 0);\n  assert.equal(boundedSnapshot.coverage, \"partial\");\n  const maturity = await routeSlash(host, \"context\", \"maturity --json\", new AbortController().signal);\n  const assessment = JSON.parse(maturity.output);\n  assert.equal(assessment.basis, \"deterministic_client_evidence\");\n  assert.equal(assessment.dimensions.length, 4);\n\n  const durableHost = {\n    ...host,\n    app: {\n      ...host.app,\n      getSessionManager: () => ({ loadSession: () => ({ durableNotes: [\"VERY_SECRET_NOTE_CONTENT\"], compactionProvenance: { recordId: \"compact-2\", predecessorIds: [\"history-3\"], summaryContent: \"summary\" } }) }),\n    },\n  };\n  const durable = await routeSlash(durableHost, \"context\", \"inspect --json\", new AbortController().signal);\n  const durableSnapshot = JSON.parse(durable.output);\n  assert.ok(durableSnapshot.items.some((item: any) => item.sourceType === \"durable_note\"));\n  assert.ok(durableSnapshot.items.some((item: any) => item.sourceRefs?.includes(\"history-3\")));\n  assert.equal(JSON.stringify(durableSnapshot).includes(\"VERY_SECRET_NOTE_CONTENT\"), false);\n\n  const previous = buildContextInventory({\n    workspaceState: { fingerprint: \"a\".repeat(64), comparison: \"no_previous_capture\", invalidatedRepositoryItemIds: [] },\n    sources: [{ name: \"repository\", status: \"ok\", durationMs: 1, items: [\n      input(\"repository:old\", \"repository\"),\n      { ...input(\"repository:skill:.agents/skills/workspace-guide/SKILL.md\", \"repository\"), sourceType: \"skill_catalog_entry\", freshness: \"unknown\", freshnessRule: \"workspace skill file content is not revalidated here\" },\n    ] }],\n  });\n  const changedHost = {\n    ...host,\n    app: {\n      ...host.app,\n      getSessionManager: () => ({ loadSession: () => ({ contextInventory: previous }) }),\n    },\n  };\n  const changed = await routeSlash(changedHost, \"context\", \"inspect --json\", new AbortController().signal);\n  const changedSnapshot = JSON.parse(changed.output);\n cli/src/agent.ts                    | 14 ++++--\n cli/src/slash/workspace_commands.ts | 34 ++++++++++++---\n cli/test/context_inventory.test.ts  | 85 +++++++++++++++++++++++++++++++++++--\n 3 files changed, 120 insertions(+), 13 deletions(-)\ndiff --git a/cli/src/agent.ts b/cli/src/agent.ts\nindex 857f3374..3648fec9 100644\n--- a/cli/src/agent.ts\n+++ b/cli/src/agent.ts\n@@ -34,6 +34,7 @@ import { captureVerificationState } from \"./worktrunk/verification.js\";\n import { homeDir } from \"./worktrunk/core.js\";\n import { openRepo, currentEntry, NotARepositoryError } from \"./worktrunk/repo.js\";\n import { replacedWorktreeReason, verifyCheckout } from \"./core/checkout_trust.js\";\n+import { inspectWorkspaceGitSafety, type WorkspaceGitSafetyReason } from \"./core/workspace_git_safety.js\";\n import { WORKTREE_BINDING_VERSION } from \"./core/state.js\";\n import { argsFingerprint } from \"./core/operation_identity.js\";\n import { isSandboxAvailable } from \"./sandbox.js\";\n@@ -1875,15 +1876,22 @@ export class AutonomousAgent {\n   }\n \n   /** A bounded, content-free candidate identity for revalidating recorded repository context. */\n-  public getWorkspaceContextFingerprint(): string | undefined {\n+  public getWorkspaceContextFingerprintResult(): { fingerprint?: string; unavailableReason?: WorkspaceGitSafetyReason } {\n+    const safety = inspectWorkspaceGitSafety(this.config.workspace);\n+    if (!safety.safe) return { unavailableReason: safety.reason };\n     try {\n-      return computeCandidateIdentitySync(this.config.workspace, { maxEntries: 4096, maxTotalBytes: 16 * 1024 * 1024 }).candidateId;\n+      return { fingerprint: computeCandidateIdentitySync(this.config.workspace, { maxEntries: 4096, maxTotalBytes: 16 * 1024 * 1024 }).candidateId };\n     } catch {\n       // Unknown is safer than presenting an old repository observation as current.\n-      return undefined;\n+      return { unavailableReason: \"fingerprint_failed\" };\n     }\n   }\n \n+  /** Backward-compatible fingerprint accessor; callers needing an explanation use the result form. */\n+  public getWorkspaceContextFingerprint(): string | undefined {\n+    return this.getWorkspaceContextFingerprintResult().fingerprint;\n+  }\n+\n   /** Judges, once per workspace, whether the session STARTED in a linked worktree the agent had already worked in. */\n   private judgeReceiptBaselineOnce(): void {\n     if (this.receiptBaselineJudged) return;\ndiff --git a/cli/src/slash/workspace_commands.ts b/cli/src/slash/workspace_commands.ts\nindex e36f2e3a..21ecf59a 100644\n--- a/cli/src/slash/workspace_commands.ts\n+++ b/cli/src/slash/workspace_commands.ts\n@@ -289,6 +289,20 @@ const DEFAULT_CONTEXT_BUDGET_MS = 2_000;\n const MAX_CONTEXT_BUDGET_MS = 30_000;\n const MAX_CONTEXT_ITEMS = 500;\n \n+class ContextSourceReadFailure extends Error {\n+  constructor(readonly safeDetail: string) { super(safeDetail); }\n+}\n+\n+function fingerprintUnavailableDetail(reason: string | undefined): string {\n+  switch (reason) {\n+    case \"program_settings_present\": return \"repository Git configuration contains program settings; fingerprinting was refused and freshness is unknown\";\n+    case \"configuration_unrecognized\": return \"repository Git configuration could not be safely interpreted; fingerprinting was refused and freshness is unknown\";\n+    case \"configuration_unavailable\": return \"repository Git configuration could not be inspected safely; fingerprinting was refused and freshness is unknown\";\n+    case \"fingerprint_failed\": return \"workspace fingerprint computation failed; freshness is unknown\";\n+    default: return \"workspace fingerprint API is unavailable; freshness is unknown\";\n+  }\n+}\n+\n async function context({ host, args, signal }: SlashContext): Promise<SlashOutcome> {\n   const [view, ...tokens] = args.trim().split(/\\s+/).filter(Boolean);\n   const usage = \"Usage: /context inspect [--json] [--record] [--budget-ms <1..30000>] [--max-items <1..500>] | /context maturity [--json] [--budget-ms <1..30000>] [--max-items <1..500>]\";\n@@ -383,9 +397,10 @@ async function context({ host, args, signal }: SlashContext): Promise<SlashOutco\n         }\n         recordSourceItems(name, status, durationMs, result as SourceReadResult, detail);\n       }\n-    } catch {\n-      sources.push({ name, status: \"failed\", durationMs: performance.now() - started, items: [], detail: \"source lookup failed; no source content was recorded\" });\n-      gaps.push(`${name} source lookup failed`);\n+    } catch (error) {\n+      const detail = error instanceof ContextSourceReadFailure ? error.safeDetail : \"source lookup failed; no source content was recorded\";\n+      sources.push({ name, status: \"failed\", durationMs: performance.now() - started, items: [], detail });\n+      gaps.push(`${name} ${detail}`);\n     } finally {\n       if (timeout) clearTimeout(timeout);\n       if (abortListener) signal.removeEventListener(\"abort\", abortListener);\n@@ -411,9 +426,16 @@ async function context({ host, args, signal }: SlashContext): Promise<SlashOutco\n   });\n   let workspaceFingerprint: string | undefined;\n   await measure(\"workspace_state_fingerprint\", () => {\n-    if (typeof agent.getWorkspaceContextFingerprint !== \"function\") throw new Error(\"workspace fingerprint API unavailable\");\n-    workspaceFingerprint = agent.getWorkspaceContextFingerprint();\n-    if (!workspaceFingerprint) throw new Error(\"workspace fingerprint unavailable\");\n+    if (typeof agent.getWorkspaceContextFingerprintResult === \"function\") {\n+      const result = agent.getWorkspaceContextFingerprintResult();\n+      workspaceFingerprint = result.fingerprint;\n+      if (!workspaceFingerprint) throw new ContextSourceReadFailure(fingerprintUnavailableDetail(result.unavailableReason));\n+    } else if (typeof agent.getWorkspaceContextFingerprint === \"function\") {\n+      workspaceFingerprint = agent.getWorkspaceContextFingerprint();\n+      if (!workspaceFingerprint) throw new ContextSourceReadFailure(fingerprintUnavailableDetail(undefined));\n+    } else {\n+      throw new ContextSourceReadFailure(fingerprintUnavailableDetail(undefined));\n+    }\n     return [{\n       sourceType: \"workspace_state_fingerprint\",\n       sourceLocation: \"repository:candidate-identity\",\ndiff --git a/cli/test/context_inventory.test.ts b/cli/test/context_inventory.test.ts\nindex 0ef6046a..de914aaa 100644\n--- a/cli/test/context_inventory.test.ts\n+++ b/cli/test/context_inventory.test.ts\n@@ -27,6 +27,7 @@ import { replReadOnlyAllowed } from \"../src/repl.js\