{"timestamp":"2026-11-24T06:50:18.688Z","ordinal":108335,"type":"token_usage_record","payload":{"thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20c49-1bcf-7563-9889-443e19f9956a","session_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","root_turn_id":"01a20c49-1bcf-7563-9889-443e19f9956a","response_id":"resp_0f4fd85789ec756b016b0533a239ac87d2a9a5f586ac1e0e59","usage":{"input_tokens":115271,"cached_input_tokens":114816,"cache_write_input_tokens":0,"output_tokens":191,"reasoning_output_tokens":70,"total_tokens":115462},"turn_token_usage":{"input_tokens":3836447,"cached_input_tokens":3752576,"cache_write_input_tokens":0,"output_tokens":23699,"reasoning_output_tokens":12252,"total_tokens":3860146},"thread_token_usage":{"input_tokens":2325030897,"cached_input_tokens":2306735744,"cache_write_input_tokens":0,"output_tokens":3821776,"reasoning_output_tokens":1837646,"total_tokens":2328852673}}}
{"timestamp":"2026-11-24T06:50:18.856Z","ordinal":108336,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a20c51-d368-7900-a562-e2122b73830e","call_id":"call_4b5f26e00e6540e6b961c3658464fda7","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"---0---\n{\"chunk_id\":\"913106\",\"wall_time_seconds\":0.000022477,\"exit_code\":0,\"original_token_count\":542,\"output\":\"✔ inventory has stable source identity, scope isolation, and omits source text (11.421661ms)\\n✔ freshness is asserted only with an invalidation rule and is demoted after persistence (1.488695ms)\\n✔ workspace fingerprints detect changed repository state and retain only stale repository references (3.173522ms)\\n✔ agent workspace fingerprint is bounded by candidate limits and returns unknown on failure (241.185692ms)\\n✔ workspace candidate fingerprint changes when tracked repository content changes (746.930533ms)\\n✔ context fingerprint refuses a configured clean filter without running it (418.916014ms)\\n✔ context fingerprint refuses fsmonitor and included Git configuration before invoking commands (305.799514ms)\\n✔ context fingerprint refuses a global clean filter used by workspace attributes (185.323113ms)\\n✔ message provenance retains opaque tool-call references without exposing raw identifiers (2.286661ms)\\n✔ inference request manifests capture the exact dispatch arrays without retaining content (7.528957ms)\\n✔ manifest estimates include all request messages even when source references are capped (37.241595ms)\\n✔ active system-prompt inventory slices current bytes and refuses stale offsets (1.919262ms)\\n✔ failed and interrupted inference manifest states remain unknown rather than successful (2.0668ms)\\n✔ source failures and deterministic inventory limits report incomplete context (0.877092ms)\\n✔ context inspection enforces a total retrieval budget and records timed-out sources (326.573267ms)\\n✔ merging a saved inventory with archive references stays bounded and reports omissions (27.920874ms)\\n✔ assessment keeps dimensions separate and reports insufficient evidence (2.396761ms)\\n✔ context command is discoverable and dispatched through the common REPL/TUI route (1.347084ms)\\n✔ context inspection and maturity execute without provider calls and emit parseable evidence (1439.915077ms)\\n✔ session save, resume, compaction, and export retain source references without promoting memory (135.806225ms)\\nℹ tests 20\\nℹ suites 0\\nℹ pass 20\\nℹ fail 0\\nℹ cancelled 0\\nℹ skipped 0\\nℹ todo 0\\nℹ duration_ms 6496.261409\\n\"}"},{"type":"input_text","text":"---1---\n{\"chunk_id\":\"aa9763\",\"wall_time_seconds\":0.000022854,\"exit_code\":0,\"original_token_count\":27,\"output\":\"\\n> local-code-harness@1.2.2 build\\n> tsc && node scripts/copy_data.mjs && node scripts/write_build_info.mjs\\n\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20c49-1bcf-7563-9889-443e19f9956a","create_time":1795503018.8565543}},"metadata":{"history_sequence":48705,"sampled_through_sequence":48702,"client_authored":false,"fallback_token_limit_override":12000}}
