plugin_connector_1p_1a69035c238881919c4190932b2df699/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"plugin://plugin_connector_1p_95d39881713c8191931482a62d6edff9\",\"name\":\"plugin_connector_1p_95d39881713c8191931482a62d6edff9\",\"title\":\"Gmail\",\"description\":\"Work with Gmail using the configured Gmail app connector.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_95d39881713c8191931482a62d6edff9\",\"plugin_name\":\"gmail\",\"plugin_release_id\":\"pluginrel_6a90cec942d081918e277126868c0912\",\"plugin_release_version\":\"0.1.10\",\"apps\":[\"app://connector_2128aebfecb84f64a06989751504…5673 tokens truncated…scription\":\"Inspect, validate, preview, repair, or update a custom pet in ChatGPT Work mode, including its name, description, or sprite sheet. Use for a pet in ChatGPT or established ChatGPT Pets context. Exclude real-world and other-app pets; clarify before invoking.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\",\"plugin_name\":\"work-pets\",\"plugin_release_id\":\"pluginrel_6a605738d6308191b431b6477919eafb\",\"plugin_release_skill_id\":\"pluginrsk_6a60573d52608191b967e6759086094c\",\"skill_name\":\"update-pet\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\",\"name\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\",\"title\":\"plugin-management\",\"description\":\"Discover and suggest relevant plugins, inspect app permissions and dependencies, and manage plugin connections or removal. Use when the user asks about plugins or when a task would materially benefit from an external app, account, service, or data source that available tools cannot access.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\",\"plugin_name\":\"plugin-management\",\"plugin_release_id\":\"pluginrel_6a7e9f7d0ef08191b97b213bb9e118ef\",\"plugin_release_skill_id\":\"pluginrsk_6a7e9f7d68608191bca9945146cbe6f1\",\"skill_name\":\"plugin-management\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites\",\"name\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6/sites\",\"title\":\"sites\",\"description\":\"Use Sites when the user wants a website built for them (including a landing page, portfolio, dashboard, portal, tracker, hub, game, event registration, or tool), requests changes to a website already built with Sites, wants to publish a website with Sites, or wants to manage Sites hosting.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"plugin_name\":\"sites\",\"plugin_release_id\":\"pluginrel_6aea101d13a881918cc3374a2ca69831\",\"plugin_release_skill_id\":\"pluginrsk_6aea101d5b00819193179eaf6bd39cf9\",\"skill_name\":\"sites\",\"contents\":[\"references\",\"scripts\",\"templates\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-remix\",\"name\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-remix\",\"title\":\"sites-remix\",\"description\":\"Remix a Site built with the Sites plugin into a new Site. Use when the user has identified the source Site and asks to remix it.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"plugin_name\":\"sites\",\"plugin_release_id\":\"pluginrel_6aea101d13a881918cc3374a2ca69831\",\"plugin_release_skill_id\":\"pluginrsk_6aea101d5b088191a1d3d733d8f5348d\",\"skill_name\":\"sites-remix\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"mcp-agent-mail\",\"uri\":\"resource://config/environment\",\"name\":\"environment_resource_exact\",\"mimeType\":\"application/json\",\"_meta\":{\"_fastmcp\":{\"tags\":[]}}},{\"server\":\"mcp-agent-mail\",\"uri\":\"resource://tooling/directory\",\"name\":\"tooling_directory_resource_exact\",\"mimeType\":\"application/json\",\"_meta\":{\"_fastmcp\":{\"tags\":[]}}},{\"server\":\"mcp-agent-mail\",\"uri\":\"resource://tooling/schemas\",\"name\":\"tooling_schemas_resource_exact\",\"mimeType\":\"application/json\",\"_meta\":{\"_fastmcp\":{\"tags\":[]}}},{\"server\":\"mcp-agent-mail\",\"uri\":\"resource://tooling/metrics\",\"name\":\"tooling_metrics_resource_exact\",\"mimeType\":\"application/json\",\"_meta\":{\"_fastmcp\":{\"tags\":[]}}},{\"server\":\"mcp-agent-mail\",\"uri\":\"resource://tooling/locks\",\"name\":\"tooling_locks_resource_exact\",\"mimeType\":\"application/json\",\"_meta\":{\"_fastmcp\":{\"tags\":[]}}},{\"server\":\"mcp-agent-mail\",\"uri\":\"resource://tooling/projects\",\"name\":\"projects_resource_exact\",\"mimeType\":\"application/json\",\"_meta\":{\"_fastmcp\":{\"tags\":[]}}}]}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1a7bc-bec1-76c3-8e8c-1894005f2121","create_time":1793815590.301203}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
