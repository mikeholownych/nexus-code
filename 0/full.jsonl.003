{"timestamp":"2026-11-04T20:52:37.158Z","ordinal":113363,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":2309995583,"cached_input_tokens":2292691968,"cache_write_input_tokens":0,"output_tokens":4055659,"reasoning_output_tokens":2036750,"total_tokens":2314051242},"last_token_usage":{"input_tokens":98296,"cached_input_tokens":93824,"cache_write_input_tokens":0,"output_tokens":1554,"reasoning_output_tokens":1552,"total_tokens":99850},"last_usage_includes_reasoning":true,"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":11.0,"window_minutes":300,"resets_at":1793830297},"secondary":{"used_percent":73.0,"window_minutes":10080,"resets_at":1794123385},"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"plus","rate_limit_reached_type":null}}}
