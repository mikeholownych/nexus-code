  /** Receipt label: main, planner, coder, subagent, work-unit. */\\n      role?: string;\\n      /** Optional diagnostic sink for bounded command surfaces that must sanitize provider-controlled labels. */\\n      diagnosticHandler?: (level: \\\"error\\\" | \\\"warn\\\", message: string) => void;\\n      /** Disable 401 fallback to stored credentials while explicitly verifying a replacement local endpoint key. */\\n      allowCredentialReload?: boolean;\\n    }\\n  ) {\\n    this.conn = connectionFor(config.provider, config.model);\\n    this.unsupportedParams = new Set(this.conn.omitParams);\\n    // A provider's base URL already carries its API path and version; only the legacy endpoint path appends /v1.\\n    const normalizeEp = (urlStr: string) => {\\n      let ep = urlStr.trim();\\n      while (ep.length > 0 && ep.endsWith(\\\"/\\\")) ep = ep.slice(0, -1);\\n      if (!this.conn.providerId && !ep.endsWith(\\\"/v1\\\")) {\\n        ep = `${ep}/v1`;\\n      }\\n      return ep;\\n    };\\n\\n    const endpointList: string[] = [normalizeEp(config.endpoint)];\\n    if (!config.pinEndpoint && !this.conn.providerId && config.fallbackEndpoints && Array.isArray(config.fallbackEndpoints)) {\\n      for (const fb of config.fallbackEndpoints) {\\n        if (fb && typeof fb === \\\"string\\\") {\\n          endpointList.push(normalizeEp(fb));\\n        }\\n      }\\n    }\\n    if (!config.pinEndpoint && !this.conn.providerId && process.env.LOCAL_LLM_FALLBACK_ENDPOINTS) {\\n      for (const fb of process.env.LOCAL_LLM_FALLBACK_ENDPOINTS.split(\\\",\\\")) {\\n        if (fb.trim()) {\\n          endpointList.push(normalizeEp(fb));\\n        }\\n      }\\n    }\\n    this.endpoints = Array.from(new Set(endpointList));\\n    this.activeEndpointIndex = 0;\\n\\n    if (config.apiKey && config.apiKey !== \\\"local\\\" && config.apiKey !== \\\"not-needed\\\") {\\n      this.explicitKey = config.apiKey;\\n      this.explicitOrigin = originOf(config.credentialOrigin ?? normalizeEp(config.endpoint));\\n    }\\n    this.model = config.model;\\n    this.temperature = config.temperature ?? 0.2;\\n    this.boundary = options?.boundary || InformationFlowBoundary.getGlobalInstance();\\n    this.diagnosticHandler = options?.diagnosticHandler;\\n    this.taskId = options?.taskId;\\n    this.sessionId = options?.sessionId;\\n    this.taskClass = options?.taskClass ?? config.taskClass;\\n    // Configurations built by buildConfig carry the operator's authorization; programmatic configurations authorize\\n    // the destinations they name directly (never their fallbacks).\\n    this.authorizedOrigins = new Set(\\n      (config.authorizedDisclosureOrigins ?? [config.endpoint, config.plannerEndpoint, config.coderEndpoint].map((e) => (e ? originOf(normalizeEp(e)) : undefined)))\\n        .filter((o): o is string => Boolean(o)),\\n    );\\n    this.cloudRoutedOrigins = config.cloudRoutedOrigins ?? [];\\n    this.allowCredentialReload = options?.allowCredentialReload !== false;\\n    this.workspace = config.workspace;\\n    this.role = options?.role ?? (config.taskClass === \\\"subagent\\\" ? \\\"subagent\\\" : \\\"main\\\");\\n    this.maxOutputTokens = config.completionReserveTokens ?? 8192;\\n    this.reasoningEffort = config.reasoningEffort;\\n    this.thinkingBudget = config.anthropicThinkingBudget;\\n  }\"}]},\"match_line\":571,\"match_lines\":[571]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"505fc3524bc3408b39a785543cc8ad4c\",\"_score\":52.90128,\"_source\":{\"title\":\"agent.ts\",\"ax_path\":\"agent.ts\",\"ax_file\":\"axf2-df8b8f2e7303bf5c495c136179cef46e-59073\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":1506,\"start_offset\":76782,\"end_offset\":77740,\"text\":\"private initTaskState(): void {\\n    if (!this.durable || !this.stateManager) return;\\n    try {\\n      this.stateManager.saveTaskState({\\n        schemaVersion: 1,\\n        taskId: this.currentTaskId,\\n        sessionId: this.currentTaskId,\\n        id: this.currentTaskId,\\n        title: \\\"Task \\\" + this.currentTaskId,\\n        workspacePath: this.workspacePathIdentity.value,\\n        workspace: this.workspacePathIdentity.value,\\n        model: this.config.model,\\n        createdAt: new Date().toISOString(),\\n        updatedAt: new Date().toISOString(),\\n        status: \\\"in_progress\\\",\\n        activePlan: this.activePlan,\\n        milestones: [],\\n        validationReceipts: this.activeValidationReceipt ? [this.activeValidationReceipt] : [],\\n        messages: this.messages,\\n        currentOperation: null,\\n        unverifiedChangesPending: this.hasPendingModifications,\\n      });\\n    } catch (err: any) {\\n      this.reportPersistenceFailure(\\\"init\\\", err);\\n    }\\n  }\"}]},\"match_line\":1526,\"match_lines\":[1526]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"38d18fece92ae02d66d5773d15119fa3\",\"_score\":31.702112,\"_source\":{\"title\":\"index.ts\",\"ax_path\":\"index.ts\",\"ax_file\":\"axf2-e0e6150dc4208f3cd727e91e0860750a-de8f\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":528,\"start_offset\":28164,\"end_offset\":28865,\"text\":\"async (_options: any, cmd: Command) => {\\n    const options = cmd.optsWithGlobals();\\n    const config = buildConfig(options);\\n    const client = new LocalLlmClient(config);\\n    console.log(pc.cyan(`\\\\nQuerying models from ${config.endpoint}...`));\\n    try {\\n      const models = await client.listModels();\\n      if (models.length === 0) {\\n        console.log(pc.yellow(\\\"No models returned by local server.\\\"));\\n      } else {\\n        console.log(pc.green(`\\\\nAvailable Models (${models.length}):`));\\n        for (const m of models) {\\n          console.log(`  • ${pc.bold(m)}`);\\n        }\\n      }\\n    } catch (err: any) {\\n      console.error(pc.red(`Error: ${err.message}`));\\n    }\\n    console.log();\\n  }\"}]},\"match_line\":537,\"match_lines\":[532,535,537]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"32e9c80ac5514a76d6a317cf82806284\",\"_score\":29.068195,\"_source\":{\"title\":\"execution_tracking.ts\",\"ax_path\":\"core/execution_tracking.ts\",\"ax_file\":\"axf2-1345f0ba5c1f5f93391592562e77b2c4-a4eb\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":53,\"start_offset\":3534,\"end_offset\":5576,\"text\":\" */\\nexport type ActionKind = \\\"observe_workspace\\\" | \\\"external\\\" | \\\"mutate\\\" | \\\"bookkeeping\\\";\\n\\nexport interface RepetitionRecord {\\n  /** Digest of action, outcome and input state. */\\n  key: string;\\n  /** Readable action: tool and subject, clipped. */\\n  action: string;\\n  /** Digest of the action identity alone (tool and canonical arguments). */\\n  actionId: string;\\n  actionKind: ActionKind;\\n  outcomeClass: OutcomeClass;\\n  /** Input state identity, or \\\"unknown\\\". */\\n  state: string;\\n  count: number;\\n  /**\\n   * Occurrences that re-acquired output compaction had removed from the model's context: not repetition (the model\\n   * no longer had the result), but evidence of context thrash when it recurs.\\n   */\\n  reacquired?: number;\\n  firstStep: number;\\n  lastStep: number;\\n  /** Clipped normalized outcome, kept as evidence. */\\n  outcome: string;\\n}\\n\\nexport interface TrackingEvent {\\n  step: number;\\n  at: string;\\n  kind: string;\\n  detail: string;\\n}\\n\\nexport interface CompactionEvent {\\n  id: string;\\n  step: number;\\n  at: string;\\n  trigger: \\\"auto\\\" | \\\"manual\\\" | \\\"manual_llm\\\";\\n  beforeTokens: number;\\n  afterTokens: number;\\n  archivedMessages: number;\\n  committed: boolean;\\n  /** Pressure-triggered compaction that freed less than the low-yield ratio of the window. */\\n  lowYield?: boolean;\\n  detail?: string;\\n}\\n\\n/**\\n * Lines of a workspace file an executed read returned, on the workspace state it ran on. `key` is the observation key\\n * of the call that returned them (the agent's `observationKey`), so whether that output is still in the conversation\\n * can be checked against the conversation itself. No file content is kept: only a 16-hex digest of it.\\n */\\nexport interface CoverageSegment {\\n  path: string;\\n  start: number;\\n  end: number;\\n  total?: number;\\n  fingerprint: string;\\n  state: string;\\n  /** Tool call id of the read that returned these lines: presence is judged for that call's output only. */\\n  key: string;\\n  step: number;\\n  /** The file's own signature when it was read (observation_identity.fileSignature). */\\n  sig?: string;\\n}\\n\"}]},\"match_line\":103,\"match_lines\":[62,102,103,113]}]},\"_token_budget\":{\"tokenizer\":\"standard-uax29-words\",\"max_tokens\":1200,\"hits_full\":4,\"hits_locator_only\":[{\"_index\":\"nexus-cli-docs\",\"_id\":\"d258e9429740a0bcaba914b4b2270549\",\"ax_path\":\"parser.ts\",\"ax_file\":\"axf2-5af02bb6a676cb2b8d433035aadf15ef-67f5\",\"ax_locator\":\"code\"}],\"deduped_overlapping\":0,\"hits_dropped\":0,\"tokens_used\":1076}}"}],"isError":false},"duration":{"secs":1,"nanos":45986272}},"started_at_ms":1793825792420,"completed_at_ms":1793825793466}}
