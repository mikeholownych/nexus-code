{"timestamp":"2026-11-04T21:00:53.840Z","ordinal":113585,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":2314282915,"cached_input_tokens":2296912512,"cache_write_input_tokens":0,"output_tokens":4065715,"reasoning_output_tokens":2043782,"total_tokens":2318348630},"last_token_usage":{"input_tokens":159602,"cached_input_tokens":158592,"cache_write_input_tokens":0,"output_tokens":258,"reasoning_output_tokens":235,"total_tokens":159860},"last_usage_includes_reasoning":true,"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":12.0,"window_minutes":300,"resets_at":1793830297},"secondary":{"used_percent":73.0,"window_minutes":10080,"resets_at":1794123386},"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"plus","rate_limit_reached_type":null}}}
