{"timestamp":"2026-11-04T21:35:23.363Z","ordinal":114496,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a1a879-e2d7-72f2-87a2-e9ee9357fdf7","item":{"type":"McpToolCall","id":"exec-c7f77a4b-7bf0-4c5f-a256-9cea3dba6269","server":"xerj","tool":"xerj_search","arguments":{"prefix":"nexus-cli","query":"refreshServerKind rediscovery catalog model unavailable previous vLLM kind retention","size":5,"max_tokens":1200},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /nexus-cli-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"refreshServerKind rediscovery catalog model unavailable previous vLLM kind retention\",\"k\":10}}}}}]},\"took\":454,\"timed_out\":false,\"_shards\":{\"total\":1,\"successful\":1,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":141,\"relation\":\"eq\"},\"max_score\":41.127476,\"hits\":[{\"_index\":\"nexus-cli-docs\",\"_id\":\"505fc3524bc3408b39a785543cc8ad4c\",\"_score\":41.127476,\"_source\":{\"title\":\"agent.ts\",\"ax_path\":\"agent.ts\",\"ax_file\":\"axf2-df8b8f2e7303bf5c495c136179cef46e-59073\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":2889,\"start_offset\":142312,\"end_offset\":145223,\"text\":\"private async refreshCapabilities(client: LocalLlmClient, reason: string, force = false, signal?: AbortSignal): Promise<void> {\\n    if (this.depth > 0 && this.capabilities) return;\\n    // Clients without discovery (test doubles, minimal connections) keep the configured or default limits.\\n    if (typeof client.discoverAdvertisement !== \\\"function\\\" || typeof client.getModel !== \\\"function\\\") return;\\n    const key = `${client.getActiveEndpoint?.() ?? \\\"\\\"}|${client.getModel()}`;\\n    const current = this.capabilities;\\n    const fresh = current && this.capabilitiesKey === key && Date.now() - this.capabilitiesCheckedAt < CAPABILITY_TTL_MS;\\n    if (fresh && !force) return;\\n    let found: Awaited<ReturnType<LocalLlmClient[\\\"discoverAdvertisement\\\"]>>;\\n    try {\\n      found = await client.discoverAdvertisement(signal);\\n    } catch {\\n      return; // cancelled: keep what is known\\n    }\\n    this.capabilitiesCheckedAt = Date.now();\\n    // A temporarily unreadable catalog keeps the last valid advertisement for the same connection.\\n    const advertised = found.state === \\\"unavailable\\\" && this.capabilitiesKey === key ? current?.advertised : found.advertised;\\n    const limits = resolveLimits(found.state === \\\"supported\\\" || advertised ? advertised : undefined, this.config.contextLimit, this.config.completionReserveTokens);\\n    const tokenCounting = !advertised?.tokenize ? \\\"unsupported\\\" : this.tokenCountingState === \\\"unavailable\\\" && Date.now() < this.tokenCountingCooldownUntil ? \\\"unavailable\\\" : \\\"supported\\\";\\n    const next: ProviderCapabilities = {\\n      model: client.getModel(),\\n      observedAt: new Date().toISOString(),\\n      discovery: found.state === \\\"unavailable\\\" && advertised ? \\\"supported\\\" : found.state,\\n      ...(found.detail ? { discoveryDetail: found.state === \\\"unavailable\\\" && advertised ? `refresh failed (${found.detail}); last advertisement kept` : found.detail } : {}),\\n      ...(advertised ? { advertised } : {}),\\n      tokenCounting,\\n      ...(tokenCounting === \\\"unavailable\\\" && this.tokenCountingDetail ? { tokenCountingDetail: this.tokenCountingDetail } : {}),\\n      ...limits,\\n    };\\n    const changed = !current || this.capabilitiesKey !== key || advertisementChanged(current.advertised, next.advertised) || current.contextLimit !== next.contextLimit || current.outputAllowance !== next.outputAllowance;\\n    this.capabilities = next;\\n    this.capabilitiesKey = key;\\n    client.setOutputAllowance?.(next.outputAllowance);\\n    if (changed) {\\n      const line = `[provider_capabilities] reason=${reason} model=${next.model} ${describeCapabilities(next)}`;\\n      if (!process.stdout.isTTY || process.env.NEXUS_DEBUG === \\\"1\\\") console.log(line);\\n      if (current && this.capabilitiesKey === key && this.activeTurn) {\\n        const text = `Provider limits changed (${reason}): ${describeCapabilities(next)}.`;\\n        if (this.observer?.onNotice) this.observer.onNotice(text);\\n      }\\n    }\\n  }\"}]},\"match_line\":2905,\"match_lines\":[2905,2906,2908,2910,2912,2913,2916,2924]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"38d18fece92ae02d66d5773d15119fa3\",\"_score\":38.737396,\"_source\":{\"title\":\"index.ts\",\"ax_path\":\"index.ts\",\"ax_file\":\"axf2-e0e6150dc4208f3cd727e91e0860750a-de8f\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":282,\"start_offset\":11995,\"end_offset\":14029,\"text\":\"\\nprogram\\n  .name(\\\"nexus\\\")\\n  .description(\\\"Nexus Code - Custom Autonomous Coding Harness for Local AI (LM Studio / vLLM)\\\")\\n  .version(getBuildIdentity().string)\\n  .option(\\\"--repl\\\", \\\"Start interactive coding session (REPL)\\\")\\n  .option(\\\"--live\\\", \\\"Start live TUI\\\")\\n  .option(\\\"-r, --resume [id]\\\", \\\"Resume previous session (defaults to latest if id omitted)\\\")\\n  .option(\\\"--approve\\\", \\\"Require human approval before destructive actions (edits, shell commands)\\\")\\n  .option(\\\"-y, --yes\\\", \\\"Run non-interactively without approval prompts (forces auto mode)\\\")\\n  .option(\\\"--mode <mode>\\\", \\\"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\\\")\\n  .option(\\\"--read-only\\\", \\\"Reject all mutating tool executions and commands\\\")\\n  .option(\\\"-e, --endpoint <url>\\\", \\\"Local LLM endpoint (default: $LOCAL_LLM_ENDPOINT)\\\")\\n  .option(\\\"-m, --model <name>\\\", \\\"Model name identifier (default: active model in vLLM)\\\")\\n  .option(\\\"-w, --workspace <path>\\\", \\\"Workspace directory (default: current directory)\\\")\\n  .option(\\\"-s, --max-steps <number>\\\", \\\"Steps per segment; continuation checkpoints there instead of stopping (default: 30)\\\")\\n  .option(\\\"--max-total-steps <number>\\\", \\\"Continuation: an explicit total-step limit for one turn (default: none; progressing work continues)\\\")\\n  .option(\\\"--strict-token-count\\\", \\\"Refuse a request the connection could not count on a worker (default: proceed on the labelled estimate)\\\")\\n  .option(\\\"--max-turn-minutes <number>\\\", \\\"Continuation: an explicit wall-clock limit for one turn in minutes (default: none)\\\")\\n  .option(\\\"--stagnation-steps <number>\\\", \\\"Continuation: stop after this many steps without progress (default 12)\\\")\\n  .option(\\\"--no-continuation\\\", \\\"End a turn at --max-steps instead of continuing while it makes progress\\\")\\n  .option(\\\"-t, --temperature <number>\\\", \\\"Model temperature (default: 0.2)\\\")\\n  .option(\\\"--shell <type>\\\", \\\"Linux shell to use: bash, zsh, or sh (default: bash)\\\", \\\"bash\\\")\\n  .option(\\\"--fallback <urls>\\\", \\\"Comma-separated fallback LLM endpoints if primary is unavailable\\\")\"}]},\"match_line\":290,\"match_lines\":[286,290,296,304,306]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"7dca3b6530ab467e3c984d24dbe9fa7b\",\"_score\":33.82603,\"_source\":{\"title\":\"client.ts\",\"ax_path\":\"client.ts\",\"ax_file\":\"axf2-33f9bd7d6b5dee989d474b71676aaa45-17404\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":1220,\"start_offset\":57735,\"end_offset\":61021,\"text\":\"async countRequestTokens(messages: ChatMessage[], tools: ToolDefinition[], requestId: string, signal?: AbortSignal): Promise<RequestCount> {\\n    if (this.conn.providerId || this.conn.protocol !== \\\"openai-chat\\\") throw new TokenCountError(\\\"unsupported\\\", \\\"provider connections have no request-counting endpoint\\\");\\n    const ep = this.endpoint;\\n    const denial = this.disclosureDenial(ep, requestId);\\n    if (denial) throw new TokenCountError(\\\"denied\\\", denial.message);\\n    if (signal?.aborted) throw new TokenCountError(\\\"aborted\\\", \\\"cancelled\\\");\\n    const kind = LocalLlmClient.serverKindCache.get(ep);\\n    const root = ep.replace(/\\\\/v1\\\\/?$/, \\\"\\\");\\n    const urls = (kind === \\\"llamacpp\\\" || kind === \\\"vllm\\\") && root !== ep ? [`${ep}/tokenize`, `${root}/tokenize`] : [`${ep}/tokenize`];\\n    let body: any;\\n    try {\\n      await this.prepareCredential(ep, requestId);\\n      this.preflight(ep, requestId, JSON.stringify(messages).length + JSON.stringify(tools).length);\\n      body = this.outboundChatBody(ep, messages, tools);\\n    } catch (err: any) {\\n      throw new TokenCountError(\\\"denied\\\", boundedProviderText(String(err?.message ?? err)).slice(0, 200));\\n    }\\n    let res: Response | undefined;\\n    let text = \\\"\\\";\\n    for (let i = 0; i < urls.length; i++) {\\n      const url = urls[i];\\n      const reqBody = kind === \\\"llamacpp\\\" && url === `${root}/tokenize`\\n        ? { content: JSON.stringify({ messages: body.messages, ...(body.tools ? { tools: body.tools } : {}) }), ...body }\\n        : body;\\n      try {\\n        res = await fetch(url, {\\n          method: \\\"POST\\\",\\n          headers: { \\\"Content-Type\\\": \\\"application/json\\\", ...this.authorization(url), \\\"X-Request-ID\\\": requestId, ...this.routingHeaders() },\\n          body: JSON.stringify(reqBody),\\n          signal: metadataSignal(signal),\\n          ...this.fetchPolicy(),\\n        });\\n      } catch (err: any) {\\n        if (signal?.aborted) throw new TokenCountError(\\\"aborted\\\", \\\"cancelled\\\");\\n        throw new TokenCountError(\\\"unavailable\\\", boundedProviderText(String(err?.message ?? err)).slice(0, 160));\\n      }\\n      text = await res.text().catch(() => \\\"\\\");\\n      if ((res.status === 404 || res.status === 405) && i + 1 < urls.length && !/blocked|capacity/i.test(text)) {\\n        continue;\\n      }\\n      break;\\n    }\\n    if (!res) throw new TokenCountError(\\\"unsupported\\\", \\\"no tokenize endpoint\\\");\\n    if (res.status === 401 || res.status === 403) throw new TokenCountError(\\\"denied\\\", `HTTP ${res.status}`);\\n    // The gateway answers 404 both for an unknown model and when every worker of the alias is blocked.\\n    if (res.status === 404) throw new TokenCountError(/blocked|capacity/i.test(text) ? \\\"unavailable\\\" : \\\"unsupported\\\", `HTTP 404 ${boundedProviderText(text).slice(0, 120)}`);\\n    if (res.status === 405 || res.status === 501) throw new TokenCountError(\\\"unsupported\\\", `HTTP ${res.status}`);\\n    if (!res.ok) throw new TokenCountError(\\\"unavailable\\\", `HTTP ${res.status} ${boundedProviderText(text).slice(0, 120)}`);\\n    let parsed: unknown;\\n    try {\\n      parsed = JSON.parse(text);\\n    } catch {\\n      throw new TokenCountError(\\\"malformed\\\", \\\"response is not JSON\\\");\\n    }\\n    const count = parseTokenizeResponse(parsed);\\n    if (\\\"malformed\\\" in count) throw new TokenCountError(\\\"malformed\\\", count.malformed);\\n    return count;\\n  }\"}]},\"match_line\":1229,\"match_lines\":[1227,1229,1242,1255,1265,1266,1268]}]},\"_token_budget\":{\"tokenizer\":\"standard-uax29-words\",\"max_tokens\":1200,\"hits_full\":3,\"hits_locator_only\":[{\"_index\":\"nexus-cli-docs\",\"_id\":\"03b7616f2b429c9e808b3447e7c239c8\",\"ax_path\":\"core/provider_capabilities.ts\",\"ax_file\":\"axf2-491885f42b0983dfca8c44d8958e2c91-3daa\",\"ax_locator\":\"code\",\"match_line\":56,\"match_lines\":[18,26,36,40,41,43,56]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"28069a378eb7d25e57be9dc6260d7b99\",\"ax_path\":\"doctor.ts\",\"ax_file\":\"axf2-f51faac2a36b9f3d60c3b232bb5ec1e4-12f84\",\"ax_locator\":\"code\",\"match_line\":482,\"match_lines\":[458,482,496,504,505,506,508,511]}],\"deduped_overlapping\":0,\"hits_dropped\":0,\"tokens_used\":1184}}"}],"isError":false},"duration":{"secs":0,"nanos":571219741}},"started_at_ms":1793828122791,"completed_at_ms":1793828123363}}
{"timestamp":"2026-11-04T21:35:24.253Z","ordinal":114497,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a192c0-f277-7f60-8574-21ce71edb8c2","turn_id":"01a1a879-e2d7-72f2-87a2-e9ee9357fdf7","item":{"type":"McpToolCall","id":"exec-eb2e8868-325d-4d56-a565-f9c7674aab2a","server":"xerj","tool":"xerj_search","arguments":{"prefix":"nexus-cli","query":"normalize optional null tool arguments strict provider dispatch read tracking observer","size":5,"max_tokens":1200},"status":"completed","result":{"content":[{"type":"text","text":"{\"_xerj\":{\"hints\":[{\"code\":\"lexical_on_semantic_text\",\"reason\":\"`body` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\",\"try\":{\"request\":\"POST /nexus-cli-*/_search\",\"body\":{\"query\":{\"semantic\":{\"field\":\"body\",\"query\":\"normalize optional null tool arguments strict provider dispatch read tracking observer\",\"k\":10}}}}}]},\"took\":557,\"timed_out\":false,\"_shards\":{\"total\":1,\"successful\":1,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":351,\"relation\":\"eq\"},\"max_score\":100.052925,\"hits\":[{\"_index\":\"nexus-cli-docs\",\"_id\":\"505fc3524bc3408b39a785543cc8ad4c\",\"_score\":100.052925,\"_source\":{\"title\":\"agent.ts\",\"ax_path\":\"agent.ts\",\"ax_file\":\"axf2-df8b8f2e7303bf5c495c136179cef46e-59073\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":3043,\"start_offset\":153169,\"end_offset\":155434,\"text\":\"(name: string, rawArgs: unknown): string | undefined => {\\n      let args: unknown;\\n      try {\\n        args = typeof rawArgs === \\\"string\\\" ? JSON.parse(rawArgs) : rawArgs;\\n      } catch {\\n        return undefined;\\n      }\\n      if (!args || typeof args !== \\\"object\\\" || Array.isArray(args)) return undefined;\\n      const prototype = Object.getPrototypeOf(args);\\n      if (prototype !== Object.prototype && prototype !== null) return undefined;\\n      const values = args as Record<string, unknown>;\\n      const optionalString = (key: string) => values[key] === undefined || (typeof values[key] === \\\"string\\\" && values[key] !== \\\"\\\");\\n      const optionalNumber = (key: string) => values[key] === undefined || (typeof values[key] === \\\"number\\\" && Number.isFinite(values[key]));\\n      if (name === \\\"file_tree\\\" || name === \\\"list_dir\\\") {\\n        if (Object.keys(values).some((key) => ![\\\"path\\\", \\\"max_depth\\\"].includes(key))) return undefined;\\n        if (!optionalString(\\\"path\\\") || !optionalNumber(\\\"max_depth\\\")) return undefined;\\n      } else if (name === \\\"find_files\\\") {\\n        if (Object.keys(values).some((key) => ![\\\"pattern\\\", \\\"max_results\\\"].includes(key))) return undefined;\\n        if (typeof values.pattern !== \\\"string\\\" || values.pattern.length === 0 || !optionalNumber(\\\"max_results\\\")) return undefined;\\n      } else if (name === \\\"file_info\\\" || name === \\\"outline_file\\\") {\\n        if (Object.keys(values).some((key) => key !== \\\"path\\\")) return undefined;\\n        if (typeof values.path !== \\\"string\\\" || values.path.length === 0) return undefined;\\n      } else if (name === \\\"cst_symbols\\\") {\\n        if (Object.keys(values).some((key) => ![\\\"path\\\", \\\"query\\\"].includes(key))) return undefined;\\n        if (typeof values.path !== \\\"string\\\" || values.path.length === 0 || !optionalString(\\\"query\\\")) return undefined;\\n      } else if (name === \\\"hybrid_search\\\" || name === \\\"trigram_search\\\") {\\n        if (typeof values.query !== \\\"string\\\" || values.query.length === 0) return undefined;\\n        if (!optionalString(\\\"path\\\") || !optionalString(\\\"mode\\\") || !optionalNumber(\\\"limit\\\") || !optionalNumber(\\\"max_results\\\")) return undefined;\\n      } else {\\n        return undefined;\\n      }\\n      try {\\n        return JSON.stringify(values);\\n      } catch {\\n        return undefined;\\n      }\\n    }\"}]},\"match_line\":3053,\"match_lines\":[3053]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"32e9c80ac5514a76d6a317cf82806284\",\"_score\":58.52153,\"_source\":{\"title\":\"execution_tracking.ts\",\"ax_path\":\"core/execution_tracking.ts\",\"ax_file\":\"axf2-1345f0ba5c1f5f93391592562e77b2c4-a4eb\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":303,\"start_offset\":13862,\"end_offset\":15850,\"text\":\" * carrying `exit_code` and `timed_out`): the command's own result decides success, not the tool's.\\n */\\nexport function commandResult(success: boolean, text: string): { success: boolean; timedOut: boolean } {\\n  if (!success || !text.trimStart().startsWith(\\\"{\\\")) return { success, timedOut: false };\\n  try {\\n    const parsed = JSON.parse(text);\\n    if (parsed && typeof parsed === \\\"object\\\" && typeof parsed.exit_code === \\\"number\\\") {\\n      const timedOut = parsed.timed_out === true;\\n      return { success: parsed.exit_code === 0 && !timedOut, timedOut };\\n    }\\n  } catch {}\\n  return { success, timedOut: false };\\n}\\n\\nexport function classifyOutcome(success: boolean, text: string, timedOut = false): OutcomeClass {\\n  if (success) return \\\"success\\\";\\n  return timedOut || TRANSIENT.test(text) ? \\\"transient_failure\\\" : \\\"deterministic_failure\\\";\\n}\\n\\nexport function outcomeIdentity(success: boolean, text: string): string {\\n  return digest(`${success ? \\\"ok\\\" : \\\"fail\\\"}\\\\u0000${normalizeOutcomeText(text)}`);\\n}\\n\\nconst WORKSPACE_OBSERVERS = new Set([\\n  \\\"read_file\\\", \\\"batch_read\\\", \\\"list_dir\\\", \\\"file_tree\\\", \\\"find_files\\\", \\\"search_code\\\", \\\"outline_file\\\", \\\"file_info\\\",\\n  \\\"read_findings\\\", \\\"read_objective\\\", \\\"read_archive\\\", \\\"git_status\\\", \\\"git_diff\\\", \\\"git_log\\\", \\\"semantic_search\\\",\\n  \\\"hybrid_search\\\", \\\"symbol_search\\\", \\\"lsp_definition\\\", \\\"lsp_references\\\", \\\"lsp_hover\\\", \\\"lsp_diagnostics\\\",\\n  // A completion attempt's verdict is determined by the workspace: resubmitting on an unchanged one cannot change it.\\n  \\\"task_completed\\\",\\n]);\\nconst BOOKKEEPING = new Set([\\\"update_plan\\\", \\\"update_requirements\\\", \\\"enable_tools\\\"]);\\nconst MUTATORS = new Set([\\\"write_file\\\", \\\"edit_file\\\", \\\"patch_file\\\", \\\"delete_file\\\", \\\"move_file\\\", \\\"create_dir\\\", \\\"apply_patch\\\", \\\"multi_edit\\\", \\\"write_workspace\\\"]);\\n\\nexport function actionKind(name: string): ActionKind {\\n  if (BOOKKEEPING.has(name)) return \\\"bookkeeping\\\";\\n  if (MUTATORS.has(name)) return \\\"mutate\\\";\\n  if (WORKSPACE_OBSERVERS.has(name)) return \\\"observe_workspace\\\";\\n  return \\\"external\\\";\\n}\\n\"}]},\"match_line\":304,\"match_lines\":[304]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"38d18fece92ae02d66d5773d15119fa3\",\"_score\":37.89047,\"_source\":{\"title\":\"index.ts\",\"ax_path\":\"index.ts\",\"ax_file\":\"axf2-e0e6150dc4208f3cd727e91e0860750a-de8f\",\"ax_locator\":\"code\",\"language\":\"typescript\"},\"fields\":{\"_passage\":[{\"field\":\"body\",\"ordinal\":44,\"start_offset\":2041,\"end_offset\":4064,\"text\":\"import pc from \\\"picocolors\\\";\\n\\nimport * as os from \\\"node:os\\\";\\n\\nconst __filename = fileURLToPath(import.meta.url);\\nconst __dirname = path.dirname(__filename);\\n\\n// Keep the lease for the full frontend/sidecar lifetime, including synchronous\\n// TUI dispatch. Maintenance recovery acquires its own exclusive lease instead.\\nconst startupArgs = process.argv.slice(2);\\nconst { acquireClientLease, releaseClientLease, clientInvocationKind } = await import(\\\"./core/client_lease.js\\\");\\nconst invocationKind = clientInvocationKind(startupArgs);\\nconst startupReadOnly = invocationKind === \\\"metadata\\\" || (startupArgs[0] === \\\"upgrade\\\" && startupArgs.includes(\\\"--check\\\"));\\nlet operatorConfigStartupError: Error | undefined;\\n// `upgrade --check` is read-only, so it must not replay a transaction. It also\\n// must not load configuration while a restore journal says that config may be\\n// only partially applied. Refuse before loadEnvironment() and let a normal\\n// managed launch perform recovery.\\nif (startupArgs[0] === \\\"upgrade\\\" && startupArgs.includes(\\\"--check\\\")) {\\n  try {\\n    const { hasPendingStateRestore } = await import(\\\"./core/state_restore.js\\\");\\n    if (hasPendingStateRestore(process.env.HOME || os.homedir())) {\\n      throw new Error(\\\"Pending state restore must be recovered before running upgrade --check\\\");\\n    }\\n  } catch (error: any) {\\n    console.error(`[maintenance] ${error?.message ?? \\\"Nexus restore state could not be verified\\\"}`);\\n    process.exit(2);\\n  }\\n}\\n// A durable state-restore intent must be replayed before environment/config\\n// loading or any normal client is admitted. The recovery command takes the\\n// exclusive lifetime lease; ordinary clients take their shared lease below.\\nif (invocationKind === \\\"restore\\\" || (invocationKind === \\\"client\\\" && !startupReadOnly)) {\\n  try {\\n    const { hasPendingStateRestore, recoverPendingStateRestore } = await import(\\\"./core/state_restore.js\\\");\\n    const home = process.env.HOME || os.homedir();\\n    if (hasPendingStateRestore(home) && !recoverPendingStateRestore(home)) {\"}]},\"match_line\":53,\"match_lines\":[53,59]}]},\"_token_budget\":{\"tokenizer\":\"standard-uax29-words\",\"max_tokens\":1200,\"hits_full\":3,\"hits_locator_only\":[{\"_index\":\"nexus-cli-docs\",\"_id\":\"62e37b6f560b30e21650caa28cb3a7da\",\"ax_path\":\"sidecar.ts\",\"ax_file\":\"axf2-c0aedef0039a7e38a28691f239e15d3b-d8f2\",\"ax_locator\":\"code\",\"match_line\":1091,\"match_lines\":[1082,1091,1103,1108,1110]},{\"_index\":\"nexus-cli-docs\",\"_id\":\"e75870f5b71a335ceda5a625276f599a\",\"ax_path\":\"core/objective.ts\",\"ax_file\":\"axf2-e81d890b2b7faf382fed1ee992cb3f45-a66b\",\"ax_locator\":\"code\",\"match_line\":665,\"match_lines\":[665,670]}],\"deduped_overlapping\":0,\"hits_dropped\":0,\"tokens_used\":963}}"}],"isError":false},"duration":{"secs":0,"nanos":678212500}},"started_at_ms":1793828123574,"completed_at_ms":1793828124252}}
{"timestamp":"2026-11-04T21:35:24.460Z","ordinal":114498,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1a87c-f72c-7cc2-9cd3-4a6fa59f79b1","call_id":"call_3c6f7c63044043149cdd2bec04e31e31","output":[{"type":"input_text","text":"Script completed\nWall time 1.7 seconds\nOutput:\n"},{"type":"input_text","text":"{\"rediscovery\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"_xerj\\\":{\\\"hints\\\":[{\\\"code\\\":\\\"lexical_on_semantic_text\\\",\\\"reason\\\":\\\"`body` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\\\",\\\"try\\\":{\\\"request\\\":\\\"POST /nexus-cli-*/_search\\\",\\\"body\\\":{\\\"query\\\":{\\\"semantic\\\":{\\\"field\\\":\\\"body\\\",\\\"query\\\":\\\"refreshServerKind rediscovery catalog model unavailable previous vLLM kind retention\\\",\\\"k\\\":10}}}}}]},\\\"took\\\":454,\\\"timed_out\\\":false,\\\"_shards\\\":{\\\"total\\\":1,\\\"successful\\\":1,\\\"skipped\\\":0,\\\"failed\\\":0},\\\"hits\\\":{\\\"total\\\":{\\\"value\\\":141,\\\"relation\\\":\\\"eq\\\"},\\\"max_score\\\":41.127476,\\\"hits\\\":[{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"505fc3524bc3408b39a785543cc8ad4c\\\",\\\"_score\\\":41.127476,\\\"_source\\\":{\\\"title\\\":\\\"agent.ts\\\",\\\"ax_path\\\":\\\"agent.ts\\\",\\\"ax_file\\\":\\\"axf2-df8b8f2e7303bf5c495c136179cef46e-59073\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":2889,\\\"start_offset\\\":142312,\\\"end_offset\\\":145223,\\\"text\\\":\\\"private async refreshCapabilities(client: LocalLlmClient, reason: string, force = false, signal?: AbortSignal): Promise<void> {\\\\n    if (this.depth > 0 && this.capabilities) return;\\\\n    // Clients without discovery (test doubles, minimal connections) keep the configured or default limits.\\\\n    if (typeof client.discoverAdvertisement !== \\\\\\\"function\\\\\\\" || typeof client.getModel !== \\\\\\\"function\\\\\\\") return;\\\\n    const key = `${client.getActiveEndpoint?.() ?? \\\\\\\"\\\\\\\"}|${client.getModel()}`;\\\\n    const current = this.capabilities;\\\\n    const fresh = current && this.capabilitiesKey === key && Date.now() - this.capabilitiesCheckedAt < CAPABILITY_TTL_MS;\\\\n    if (fresh && !force) return;\\\\n    let found: Awaited<ReturnType<LocalLlmClient[\\\\\\\"discoverAdvertisement\\\\\\\"]>>;\\\\n    try {\\\\n      found = await client.discoverAdvertisement(signal);\\\\n    } catch {\\\\n      return; // cancelled: keep what is known\\\\n    }\\\\n    this.capabilitiesCheckedAt = Date.now();\\\\n    // A temporarily unreadable catalog keeps the last valid advertisement for the same connection.\\\\n    const advertised = found.state === \\\\\\\"unavailable\\\\\\\" && this.capabilitiesKey === key ? current?.advertised : found.advertised;\\\\n    const limits = resolveLimits(found.state === \\\\\\\"supported\\\\\\\" || advertised ? advertised : undefined, this.config.contextLimit, this.config.completionReserveTokens);\\\\n    const tokenCounting = !advertised?.tokenize ? \\\\\\\"unsupported\\\\\\\" : this.tokenCountingState === \\\\\\\"unavailable\\\\\\\" && Date.now() < this.tokenCountingCooldownUntil ? \\\\\\\"unavailable\\\\\\\" : \\\\\\\"supported\\\\\\\";\\\\n    const next: ProviderCapabilities = {\\\\n      model: client.getModel(),\\\\n      observedAt: new Date().toISOString(),\\\\n      discovery: found.state === \\\\\\\"unavailable\\\\\\\" && advertised ? \\\\\\\"supported\\\\\\\" : found.state,\\\\n      ...(found.detail ? { discoveryDetail: found.state === \\\\\\\"unavailable\\\\\\\" && advertised ? `refresh failed (${found.detail}); last advertisement kept` : found.detail } : {}),\\\\n      ...(advertised ? { advertised } : {}),\\\\n      tokenCounting,\\\\n      ...(tokenCounting === \\\\\\\"unavailable\\\\\\\" && this.tokenCountingDetail ? { tokenCountingDetail: this.tokenCountingDetail } : {}),\\\\n      ...limits,\\\\n    };\\\\n    const changed = !current || this.capabilitiesKey !== key || advertisementChanged(current.advertised, next.advertised) || current.contextLimit !== next.contextLimit || current.outputAllowance !== next.outputAllowance;\\\\n    this.capabilities = next;\\\\n    this.capabilitiesKey = key;\\\\n    client.setOutputAllowance?.(next.outputAllowance);\\\\n    if (changed) {\\\\n      const line = `[provider_capabilities] reason=${reason} model=${next.model} ${describeCapabilities(next)}`;\\\\n      if (!process.stdout.isTTY || process.env.NEXUS_DEBUG === \\\\\\\"1\\\\\\\") console.log(line);\\\\n      if (current && this.capabilitiesKey === key && this.activeTurn) {\\\\n        const text = `Provider limits changed (${reason}): ${describeCapabilities(next)}.`;\\\\n        if (this.observer?.onNotice) this.observer.onNotice(text);\\\\n      }\\\\n    }\\\\n  }\\\"}]},\\\"match_line\\\":2905,\\\"match_lines\\\":[2905,2906,2908,2910,2912,2913,2916,2924]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"38d18fece92ae02d66d5773d15119fa3\\\",\\\"_score\\\":38.737396,\\\"_source\\\":{\\\"title\\\":\\\"index.ts\\\",\\\"ax_path\\\":\\\"index.ts\\\",\\\"ax_file\\\":\\\"axf2-e0e6150dc4208f3cd727e91e0860750a-de8f\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":282,\\\"start_offset\\\":11995,\\\"end_offset\\\":14029,\\\"text\\\":\\\"\\\\nprogram\\\\n  .name(\\\\\\\"nexus\\\\\\\")\\\\n  .description(\\\\\\\"Nexus Code - Custom Autonomous Coding Harness for Local AI (LM Studio / vLLM)\\\\\\\")\\\\n  .version(getBuildIdentity().string)\\\\n  .option(\\\\\\\"--repl\\\\\\\", \\\\\\\"Start interactive coding session (REPL)\\\\\\\")\\\\n  .option(\\\\\\\"--live\\\\\\\", \\\\\\\"Start live TUI\\\\\\\")\\\\n  .option(\\\\\\\"-r, --resume [id]\\\\\\\", \\\\\\\"Resume previous session (defaults to latest if id omitted)\\\\\\\")\\\\n  .option(\\\\\\\"--approve\\\\\\\", \\\\\\\"Require human approval before destructive actions (edits, shell commands)\\\\\\\")\\\\n  .option(\\\\\\\"-y, --yes\\\\\\\", \\\\\\\"Run non-interactively without approval prompts (forces auto mode)\\\\\\\")\\\\n  .option(\\\\\\\"--mode <mode>\\\\\\\", \\\\\\\"Execution mode: auto, review, or read-only (default: review; folder trust does not change it)\\\\\\\")\\\\n  .option(\\\\\\\"--read-only\\\\\\\", \\\\\\\"Reject all mutating tool executions and commands\\\\\\\")\\\\n  .option(\\\\\\\"-e, --endpoint <url>\\\\\\\", \\\\\\\"Local LLM endpoint (default: $LOCAL_LLM_ENDPOINT)\\\\\\\")\\\\n  .option(\\\\\\\"-m, --model <name>\\\\\\\", \\\\\\\"Model name identifier (default: active model in vLLM)\\\\\\\")\\\\n  .option(\\\\\\\"-w, --workspace <path>\\\\\\\", \\\\\\\"Workspace directory (default: current directory)\\\\\\\")\\\\n  .option(\\\\\\\"-s, --max-steps <number>\\\\\\\", \\\\\\\"Steps per segment; continuation checkpoints there instead of stopping (default: 30)\\\\\\\")\\\\n  .option(\\\\\\\"--max-total-steps <number>\\\\\\\", \\\\\\\"Continuation: an explicit total-step limit for one turn (default: none; progressing work continues)\\\\\\\")\\\\n  .option(\\\\\\\"--strict-token-count\\\\\\\", \\\\\\\"Refuse a request the connection could not count on a worker (default: proceed on the labelled estimate)\\\\\\\")\\\\n  .option(\\\\\\\"--max-turn-minutes <number>\\\\\\\", \\\\\\\"Continuation: an explicit wall-clock limit for one turn in minutes (default: none)\\\\\\\")\\\\n  .option(\\\\\\\"--stagnation-steps <number>\\\\\\\", \\\\\\\"Continuation: stop after this many steps without progress (default 12)\\\\\\\")\\\\n  .option(\\\\\\\"--no-continuation\\\\\\\", \\\\\\\"End a turn at --max-steps instead of continuing while it makes progress\\\\\\\")\\\\n  .option(\\\\\\\"-t, --temperature <number>\\\\\\\", \\\\\\\"Model temperature (default: 0.2)\\\\\\\")\\\\n  .option(\\\\\\\"--shell <type>\\\\\\\", \\\\\\\"Linux shell to use: bash, zsh, or sh (default: bash)\\\\\\\", \\\\\\\"bash\\\\\\\")\\\\n  .option(\\\\\\\"--fallback <urls>\\\\\\\", \\\\\\\"Comma-separated fallback LLM endpoints if primary is unavailable\\\\\\\")\\\"}]},\\\"match_line\\\":290,\\\"match_lines\\\":[286,290,296,304,306]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"7dca3b6530ab467e3c984d24dbe9fa7b\\\",\\\"_score\\\":33.82603,\\\"_source\\\":{\\\"title\\\":\\\"client.ts\\\",\\\"ax_path\\\":\\\"client.ts\\\",\\\"ax_file\\\":\\\"axf2-33f9bd7d6b5dee989d474b71676aaa45-17404\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":1220,\\\"start_offset\\\":57735,\\\"end_offset\\\":61021,\\\"text\\\":\\\"async countRequestTokens(messages: ChatMessage[], tools: ToolDefinition[], requestId: string, signal?: AbortSignal): Promise<RequestCount> {\\\\n    if (this.conn.providerId || this.conn.protocol !== \\\\\\\"openai-chat\\\\\\\") throw new TokenCountError(\\\\\\\"unsupported\\\\\\\", \\\\\\\"provider connections have no request-counting endpoint\\\\\\\");\\\\n    const ep = this.endpoint;\\\\n    const denial = this.disclosureDenial(ep, requestId);\\\\n    if (denial) throw new TokenCountError(\\\\\\\"denied\\\\\\\", denial.message);\\\\n    if (signal?.aborted) throw new TokenCountError(\\\\\\\"aborted\\\\\\\", \\\\\\\"cancelled\\\\\\\");\\\\n    const kind = LocalLlmClient.serverKindCache.get(ep);\\\\n    const root = ep.replace(/\\\\\\\\/v1\\\\\\\\/?$/, \\\\\\\"\\\\\\\");\\\\n    const urls = (kind === \\\\\\\"llamacpp\\\\\\\" || kind === \\\\\\\"vllm\\\\\\\") && root !== ep ? [`${ep}/tokenize`, `${root}/tokenize`] : [`${ep}/tokenize`];\\\\n    let body: any;\\\\n    try {\\\\n      await this.prepareCredential(ep, requestId);\\\\n      this.preflight(ep, requestId, JSON.stringify(messages).length + JSON.stringify(tools).length);\\\\n      body = this.outboundChatBody(ep, messages, tools);\\\\n    } catch (err: any) {\\\\n      throw new TokenCountError(\\\\\\\"denied\\\\\\\", boundedProviderText(String(err?.message ?? err)).slice(0, 200));\\\\n    }\\\\n    let res: Response | undefined;\\\\n    let text = \\\\\\\"\\\\\\\";\\\\n    for (let i = 0; i < urls.length; i++) {\\\\n      const url = urls[i];\\\\n      const reqBody = kind === \\\\\\\"llamacpp\\\\\\\" && url === `${root}/tokenize`\\\\n        ? { content: JSON.stringify({ messages: body.messages, ...(body.tools ? { tools: body.tools } : {}) }), ...body }\\\\n        : body;\\\\n      try {\\\\n        res = await fetch(url, {\\\\n          method: \\\\\\\"POST\\\\\\\",\\\\n          headers: { \\\\\\\"Content-Type\\\\\\\": \\\\\\\"application/json\\\\\\\", ...this.authorization(url), \\\\\\\"X-Request-ID\\\\\\\": requestId, ...this.routingHeaders() },\\\\n          body: JSON.stringify(reqBody),\\\\n          signal: metadataSignal(signal),\\\\n          ...this.fetchPolicy(),\\\\n        });\\\\n      } catch (err: any) {\\\\n        if (signal?.aborted) throw new TokenCountError(\\\\\\\"aborted\\\\\\\", \\\\\\\"cancelled\\\\\\\");\\\\n        throw new TokenCountError(\\\\\\\"unavailable\\\\\\\", boundedProviderText(String(err?.message ?? err)).slice(0, 160));\\\\n      }\\\\n      text = await res.text().catch(() => \\\\\\\"\\\\\\\");\\\\n      if ((res.status === 404 || res.status === 405) && i + 1 < urls.length && !/blocked|capacity/i.test(text)) {\\\\n        continue;\\\\n      }\\\\n      break;\\\\n    }\\\\n    if (!res) throw new TokenCountError(\\\\\\\"unsupported\\\\\\\", \\\\\\\"no tokenize endpoint\\\\\\\");\\\\n    if (res.status === 401 || res.status === 403) throw new TokenCountError(\\\\\\\"denied\\\\\\\", `HTTP ${res.status}`);\\\\n    // The gateway answers 404 both for an unknown model and when every worker of the alias is blocked.\\\\n    if (res.status === 404) throw new TokenCountError(/blocked|capacity/i.test(text) ? \\\\\\\"unavailable\\\\\\\" : \\\\\\\"unsupported\\\\\\\", `HTTP 404 ${boundedProviderText(text).slice(0, 120)}`);\\\\n    if (res.status === 405 || res.status === 501) throw new TokenCountError(\\\\\\\"unsupported\\\\\\\", `HTTP ${res.status}`);\\\\n    if (!res.ok) throw new TokenCountError(\\\\\\\"unavailable\\\\\\\", `HTTP ${res.status} ${boundedProviderText(text).slice(0, 120)}`);\\\\n    let parsed: unknown;\\\\n    try {\\\\n      parsed = JSON.parse(text);\\\\n    } catch {\\\\n      throw new TokenCountError(\\\\\\\"malformed\\\\\\\", \\\\\\\"response is not JSON\\\\\\\");\\\\n    }\\\\n    const count = parseTokenizeResponse(parsed);\\\\n    if (\\\\\\\"malformed\\\\\\\" in count) throw new TokenCountError(\\\\\\\"malformed\\\\\\\", count.malformed);\\\\n    return count;\\\\n  }\\\"}]},\\\"match_line\\\":1229,\\\"match_lines\\\":[1227,1229,1242,1255,1265,1266,1268]}]},\\\"_token_budget\\\":{\\\"tokenizer\\\":\\\"standard-uax29-words\\\",\\\"max_tokens\\\":1200,\\\"hits_full\\\":3,\\\"hits_locator_only\\\":[{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"03b7616f2b429c9e808b3447e7c239c8\\\",\\\"ax_path\\\":\\\"core/provider_capabilities.ts\\\",\\\"ax_file\\\":\\\"axf2-491885f42b0983dfca8c44d8958e2c91-3daa\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"match_line\\\":56,\\\"match_lines\\\":[18,26,36,40,41,43,56]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"28069a378eb7d25e57be9dc6260d7b99\\\",\\\"ax_path\\\":\\\"doctor.ts\\\",\\\"ax_file\\\":\\\"axf2-f51faac2a36b9f3d60c3b232bb5ec1e4-12f84\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"match_line\\\":482,\\\"match_lines\\\":[458,482,496,504,505,506,508,511]}],\\\"deduped_overlapping\\\":0,\\\"hits_dropped\\\":0,\\\"tokens_used\\\":1184}}\"}],\"isError\":false},\"normalization\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"_xerj\\\":{\\\"hints\\\":[{\\\"code\\\":\\\"lexical_on_semantic_text\\\",\\\"reason\\\":\\\"`body` is `semantic_text`, but this query scored it with BM25 over the analysed text — the embedding written at ingest was NOT consulted, so these hits are lexical and a paraphrase sharing no words with the target will not find it. For meaning-based recall run the `semantic` query on `body`; to keep both signals, combine them with `hybrid`.\\\",\\\"try\\\":{\\\"request\\\":\\\"POST /nexus-cli-*/_search\\\",\\\"body\\\":{\\\"query\\\":{\\\"semantic\\\":{\\\"field\\\":\\\"body\\\",\\\"query\\\":\\\"normalize optional null tool arguments strict provider dispatch read tracking observer\\\",\\\"k\\\":10}}}}}]},\\\"took\\\":557,\\\"timed_out\\\":false,\\\"_shards\\\":{\\\"total\\\":1,\\\"successful\\\":1,\\\"skipped\\\":0,\\\"failed\\\":0},\\\"hits\\\":{\\\"total\\\":{\\\"value\\\":351,\\\"relation\\\":\\\"eq\\\"},\\\"max_score\\\":100.052925,\\\"hits\\\":[{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"505fc3524bc3408b39a785543cc8ad4c\\\",\\\"_score\\\":100.052925,\\\"_source\\\":{\\\"title\\\":\\\"agent.ts\\\",\\\"ax_path\\\":\\\"agent.ts\\\",\\\"ax_file\\\":\\\"axf2-df8b8f2e7303bf5c495c136179cef46e-59073\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":3043,\\\"start_offset\\\":153169,\\\"end_offset\\\":155434,\\\"text\\\":\\\"(name: string, rawArgs: unknown): string | undefined => {\\\\n      let args: unknown;\\\\n      try {\\\\n        args = typeof rawArgs === \\\\\\\"string\\\\\\\" ? JSON.parse(rawArgs) : rawArgs;\\\\n      } catch {\\\\n        return undefined;\\\\n      }\\\\n      if (!args || typeof args !== \\\\\\\"object\\\\\\\" || Array.isArray(args)) return undefined;\\\\n      const prototype = Object.getPrototypeOf(args);\\\\n      if (prototype !== Object.prototype && prototype !== null) return undefined;\\\\n      const values = args as Record<string, unknown>;\\\\n      const optionalString = (key: string) => values[key] === undefined || (typeof values[key] === \\\\\\\"string\\\\\\\" && values[key] !== \\\\\\\"\\\\\\\");\\\\n      const optionalNumber = (key: string) => values[key] === undefined || (typeof values[key] === \\\\\\\"number\\\\\\\" && Number.isFinite(values[key]));\\\\n      if (name === \\\\\\\"file_tree\\\\\\\" || name === \\\\\\\"list_dir\\\\\\\") {\\\\n        if (Object.keys(values).some((key) => ![\\\\\\\"path\\\\\\\", \\\\\\\"max_depth\\\\\\\"].includes(key))) return undefined;\\\\n        if (!optionalString(\\\\\\\"path\\\\\\\") || !optionalNumber(\\\\\\\"max_depth\\\\\\\")) return undefined;\\\\n      } else if (name === \\\\\\\"find_files\\\\\\\") {\\\\n        if (Object.keys(values).some((key) => ![\\\\\\\"pattern\\\\\\\", \\\\\\\"max_results\\\\\\\"].includes(key))) return undefined;\\\\n        if (typeof values.pattern !== \\\\\\\"string\\\\\\\" || values.pattern.length === 0 || !optionalNumber(\\\\\\\"max_results\\\\\\\")) return undefined;\\\\n      } else if (name === \\\\\\\"file_info\\\\\\\" || name === \\\\\\\"outline_file\\\\\\\") {\\\\n        if (Object.keys(values).some((key) => key !== \\\\\\\"path\\\\\\\")) return undefined;\\\\n        if (typeof values.path !== \\\\\\\"string\\\\\\\" || values.path.length === 0) return undefined;\\\\n      } else if (name === \\\\\\\"cst_symbols\\\\\\\") {\\\\n        if (Object.keys(values).some((key) => ![\\\\\\\"path\\\\\\\", \\\\\\\"query\\\\\\\"].includes(key))) return undefined;\\\\n        if (typeof values.path !== \\\\\\\"string\\\\\\\" || values.path.length === 0 || !optionalString(\\\\\\\"query\\\\\\\")) return undefined;\\\\n      } else if (name === \\\\\\\"hybrid_search\\\\\\\" || name === \\\\\\\"trigram_search\\\\\\\") {\\\\n        if (typeof values.query !== \\\\\\\"string\\\\\\\" || values.query.length === 0) return undefined;\\\\n        if (!optionalString(\\\\\\\"path\\\\\\\") || !optionalString(\\\\\\\"mode\\\\\\\") || !optionalNumber(\\\\\\\"limit\\\\\\\") || !optionalNumber(\\\\\\\"max_results\\\\\\\")) return undefined;\\\\n      } else {\\\\n        return undefined;\\\\n      }\\\\n      try {\\\\n        return JSON.stringify(values);\\\\n      } catch {\\\\n        return undefined;\\\\n      }\\\\n    }\\\"}]},\\\"match_line\\\":3053,\\\"match_lines\\\":[3053]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"32e9c80ac5514a76d6a317cf82806284\\\",\\\"_score\\\":58.52153,\\\"_source\\\":{\\\"title\\\":\\\"execution_tracking.ts\\\",\\\"ax_path\\\":\\\"core/execution_tracking.ts\\\",\\\"ax_file\\\":\\\"axf2-1345f0ba5c1f5f93391592562e77b2c4-a4eb\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":303,\\\"start_offset\\\":13862,\\\"end_offset\\\":15850,\\\"text\\\":\\\" * carrying `exit_code` and `timed_out`): the command's own result decides success, not the tool's.\\\\n */\\\\nexport function commandResult(success: boolean, text: string): { success: boolean; timedOut: boolean } {\\\\n  if (!success || !text.trimStart().startsWith(\\\\\\\"{\\\\\\\")) return { success, timedOut: false };\\\\n  try {\\\\n    const parsed = JSON.parse(text);\\\\n    if (parsed && typeof parsed === \\\\\\\"object\\\\\\\" && typeof parsed.exit_code === \\\\\\\"number\\\\\\\") {\\\\n      const timedOut = parsed.timed_out === true;\\\\n      return { success: parsed.exit_code === 0 && !timedOut, timedOut };\\\\n    }\\\\n  } catch {}\\\\n  return { success, timedOut: false };\\\\n}\\\\n\\\\nexport function classifyOutcome(success: boolean, text: string, timedOut = false): OutcomeClass {\\\\n  if (success) return \\\\\\\"success\\\\\\\";\\\\n  return timedOut || TRANSIENT.test(text) ? \\\\\\\"transient_failure\\\\\\\" : \\\\\\\"deterministic_failure\\\\\\\";\\\\n}\\\\n\\\\nexport function outcomeIdentity(success: boolean, text: string): string {\\\\n  return digest(`${success ? \\\\\\\"ok\\\\\\\" : \\\\\\\"fail\\\\\\\"}\\\\\\\\u0000${normalizeOutcomeText(text)}`);\\\\n}\\\\n\\\\nconst WORKSPACE_OBSERVERS = new Set([\\\\n  \\\\\\\"read_file\\\\\\\", \\\\\\\"batch_read\\\\\\\", \\\\\\\"list_dir\\\\\\\", \\\\\\\"file_tree\\\\\\\", \\\\\\\"find_files\\\\\\\", \\\\\\\"search_code\\\\\\\", \\\\\\\"outline_file\\\\\\\", \\\\\\\"file_info\\\\\\\",\\\\n  \\\\\\\"read_findings\\\\\\\", \\\\\\\"read_objective\\\\\\\", \\\\\\\"read_archive\\\\\\\", \\\\\\\"git_status\\\\\\\", \\\\\\\"git_diff\\\\\\\", \\\\\\\"git_log\\\\\\\", \\\\\\\"semantic_search\\\\\\\",\\\\n  \\\\\\\"hybrid_search\\\\\\\", \\\\\\\"symbol_search\\\\\\\", \\\\\\\"lsp_definition\\\\\\\", \\\\\\\"lsp_references\\\\\\\", \\\\\\\"lsp_hover\\\\\\\", \\\\\\\"lsp_diagnostics\\\\\\\",\\\\n  // A completion attempt's verdict is determined by the workspace: resubmitting on an unchanged one cannot change it.\\\\n  \\\\\\\"task_completed\\\\\\\",\\\\n]);\\\\nconst BOOKKEEPING = new Set([\\\\\\\"update_plan\\\\\\\", \\\\\\\"update_requirements\\\\\\\", \\\\\\\"enable_tools\\\\\\\"]);\\\\nconst MUTATORS = new Set([\\\\\\\"write_file\\\\\\\", \\\\\\\"edit_file\\\\\\\", \\\\\\\"patch_file\\\\\\\", \\\\\\\"delete_file\\\\\\\", \\\\\\\"move_file\\\\\\\", \\\\\\\"create_dir\\\\\\\", \\\\\\\"apply_patch\\\\\\\", \\\\\\\"multi_edit\\\\\\\", \\\\\\\"write_workspace\\\\\\\"]);\\\\n\\\\nexport function actionKind(name: string): ActionKind {\\\\n  if (BOOKKEEPING.has(name)) return \\\\\\\"bookkeeping\\\\\\\";\\\\n  if (MUTATORS.has(name)) return \\\\\\\"mutate\\\\\\\";\\\\n  if (WORKSPACE_OBSERVERS.has(name)) return \\\\\\\"observe_workspace\\\\\\\";\\\\n  return \\\\\\\"external\\\\\\\";\\\\n}\\\\n\\\"}]},\\\"match_line\\\":304,\\\"match_lines\\\":[304]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"38d18fece92ae02d66d5773d15119fa3\\\",\\\"_score\\\":37.89047,\\\"_source\\\":{\\\"title\\\":\\\"index.ts\\\",\\\"ax_path\\\":\\\"index.ts\\\",\\\"ax_file\\\":\\\"axf2-e0e6150dc4208f3cd727e91e0860750a-de8f\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"language\\\":\\\"typescript\\\"},\\\"fields\\\":{\\\"_passage\\\":[{\\\"field\\\":\\\"body\\\",\\\"ordinal\\\":44,\\\"start_offset\\\":2041,\\\"end_offset\\\":4064,\\\"text\\\":\\\"import pc from \\\\\\\"picocolors\\\\\\\";\\\\n\\\\nimport * as os from \\\\\\\"node:os\\\\\\\";\\\\n\\\\nconst __filename = fileURLToPath(import.meta.url);\\\\nconst __dirname = path.dirname(__filename);\\\\n\\\\n// Keep the lease for the full frontend/sidecar lifetime, including synchronous\\\\n// TUI dispatch. Maintenance recovery acquires its own exclusive lease instead.\\\\nconst startupArgs = process.argv.slice(2);\\\\nconst { acquireClientLease, releaseClientLease, clientInvocationKind } = await import(\\\\\\\"./core/client_lease.js\\\\\\\");\\\\nconst invocationKind = clientInvocationKind(startupArgs);\\\\nconst startupReadOnly = invocationKind === \\\\\\\"metadata\\\\\\\" || (startupArgs[0] === \\\\\\\"upgrade\\\\\\\" && startupArgs.includes(\\\\\\\"--check\\\\\\\"));\\\\nlet operatorConfigStartupError: Error | undefined;\\\\n// `upgrade --check` is read-only, so it must not replay a transaction. It also\\\\n// must not load configuration while a restore journal says that config may be\\\\n// only partially applied. Refuse before loadEnvironment() and let a normal\\\\n// managed launch perform recovery.\\\\nif (startupArgs[0] === \\\\\\\"upgrade\\\\\\\" && startupArgs.includes(\\\\\\\"--check\\\\\\\")) {\\\\n  try {\\\\n    const { hasPendingStateRestore } = await import(\\\\\\\"./core/state_restore.js\\\\\\\");\\\\n    if (hasPendingStateRestore(process.env.HOME || os.homedir())) {\\\\n      throw new Error(\\\\\\\"Pending state restore must be recovered before running upgrade --check\\\\\\\");\\\\n    }\\\\n  } catch (error: any) {\\\\n    console.error(`[maintenance] ${error?.message ?? \\\\\\\"Nexus restore state could not be verified\\\\\\\"}`);\\\\n    process.exit(2);\\\\n  }\\\\n}\\\\n// A durable state-restore intent must be replayed before environment/config\\\\n// loading or any normal client is admitted. The recovery command takes the\\\\n// exclusive lifetime lease; ordinary clients take their shared lease below.\\\\nif (invocationKind === \\\\\\\"restore\\\\\\\" || (invocationKind === \\\\\\\"client\\\\\\\" && !startupReadOnly)) {\\\\n  try {\\\\n    const { hasPendingStateRestore, recoverPendingStateRestore } = await import(\\\\\\\"./core/state_restore.js\\\\\\\");\\\\n    const home = process.env.HOME || os.homedir();\\\\n    if (hasPendingStateRestore(home) && !recoverPendingStateRestore(home)) {\\\"}]},\\\"match_line\\\":53,\\\"match_lines\\\":[53,59]}]},\\\"_token_budget\\\":{\\\"tokenizer\\\":\\\"standard-uax29-words\\\",\\\"max_tokens\\\":1200,\\\"hits_full\\\":3,\\\"hits_locator_only\\\":[{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"62e37b6f560b30e21650caa28cb3a7da\\\",\\\"ax_path\\\":\\\"sidecar.ts\\\",\\\"ax_file\\\":\\\"axf2-c0aedef0039a7e38a28691f239e15d3b-d8f2\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"match_line\\\":1091,\\\"match_lines\\\":[1082,1091,1103,1108,1110]},{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"e75870f5b71a335ceda5a625276f599a\\\",\\\"ax_path\\\":\\\"core/objective.ts\\\",\\\"ax_file\\\":\\\"axf2-e81d890b2b7faf382fed1ee992cb3f45-a66b\\\",\\\"ax_locator\\\":\\\"code\\\",\\\"match_line\\\":665,\\\"match_lines\\\":[665,670]}],\\\"deduped_overlapping\\\":0,\\\"hits_dropped\\\":0,\\\"tokens_used\\\":963}}\"}],\"isError\":false}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1a879-e2d7-72f2-87a2-e9ee9357fdf7","create_time":1793828124.4605134}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
