\n  if (name.startsWith(\"mcp__\") || name.startsWith(\"custom__\")) return true;\n  return [\"write_file\", \"edit_file\", \"patch_file\", \"delete_file\", \"run_command\", \"run_tests\", \"git_commit\", \"git_stage\", \"checkpoint_restore\"].includes(name);\n}\n\nexport function isKnownToolName(name: string): boolean {\n  if (typeof name !== \"string\") return false;\n  return KNOWN_TOOLS.has(name) || name.startsWith(\"mcp__\") || name.startsWith(\"custom__\");\n}\n\nexport interface ParsedModelOutput {\n  thoughtText: string;\n  reasoningText?: string;\n  toolCalls: ToolCall[];\n  notices?: string[];\n  /** How the arguments of each recognized tool call parsed; present when the response carried one. */\n  toolCallSyntax?: ToolCallSyntaxCounts;\n}\n\n/**\n * Tool-call argument syntax, counted per recognized call: valid JSON as sent (`native`), JSON that parsed only after a\n * trailing or structural repair, or arguments that did not parse at all (`invalid`). Calls rejected for needing\n * structural repair are still counted under `structural`.\n */\nexport interface ToolCallSyntaxCounts {\n  native: number;\n  trailing: number;\n  structural: number;\n  invalid: number;\n}\n\nexport interface ParseModelResponseOptions {\n  offered?: Iterable<string>;\n  nativeTools?: boolean;\n}\n\n\nfunction escapeControlCharsInStrings(str: string): string {\n  let inString = false;\n  let isEscaped = false;\n  let quoteChar = \"\";\n  let buf = \"\";\n  for (let i = 0; i < str.length; i++) {\n    const ch = str[i];\n    if (inString) {\n      if (isEscaped) {\n        buf += ch;\n        isEscaped = false;\n      } else if (ch === \"\\\\\") {\n        buf += ch;\n        isEscaped = true;\n      } else if (ch === quoteChar) {\n        buf += ch;\n        inString = false;\n        quoteChar = \"\";\n      } else if (ch === \"\\n\") {\n        buf += \"\\\\n\";\n      } else if (ch === \"\\r\") {\n        buf += \"\\\\r\";\n      } else if (ch === \"\\t\") {\n        buf += \"\\\\t\";\n      } else {\n        buf += ch;\n      }\n    } else {\n      if (ch === '\"' || ch === \"'\") {\n        inString = true;\n        quoteChar = ch;\n      }\n      buf += ch;\n    }\n  }\n  return buf;\n}\n\nfunction replaceUnquotedPythonLiterals(str: string): string {\n  let result = \"\";\n  let inString = false;\n  let isEscaped = false;\n  let quoteChar = \"\";\n\n  let i = 0;\n  while (i < str.length) {\n    const ch = str[i];\n    if (inString) {\n      result += ch;\n      if (isEscaped) {\n        isEscaped = false;\n      } else if (ch === \"\\\\\") {\n        isEscaped = true;\n      } else if (ch === quoteChar) {\n        inString = false;\n        quoteChar = \"\";\n      }\n      i++;\n    } else {\n      if (ch === '\"' || ch === \"'\") {\n        inString = true;\n        quoteChar = ch;\n        result += ch;\n        i++;\n      } else if (str.startsWith(\"True\", i) && !/[a-zA-Z0-9_]/.test(str[i + 4] || \"\")) {\n        result += \"true\";\n        i += 4;\n      } else if (str.startsWith(\"False\", i) && !/[a-zA-Z0-9_]/.test(str[i + 5] || \"\")) {\n        result += \"false\";\n        i += 5;\n      } else if (str.startsWith(\"None\", i) && !/[a-zA-Z0-9_]/.test(str[i + 4] || \"\")) {\n        result += \"null\";\n        i += 4;\n      } else {\n        result += ch;\n        i++;\n      }\n    }\n  }\n  return result;\n}\n\n/**\n * Lenient self-healing JSON parser tailored for local LLM formatting artifacts.\n * Automatically repairs trailing commas, single quotes, unquoted keys, Python literals outside strings,\n * unescaped newlines/tabs inside string values, and missing closing brackets.\n */\n/** Applies `fix` to the parts of `str` outside quoted JSON string literals, leaving string contents untouched. */\nfunction mapOutsideStrings(str: string, fix: (segment: string) => string): string {\n  let out = \"\";\n  let segment = \"\";\n  let quoteChar = \"\";\n  let escaped = false;\n  for (const ch of str) {\n    if (quoteChar) {\n   