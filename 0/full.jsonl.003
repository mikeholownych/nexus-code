y.size) {\n      throw new Error(`candidate source is not a stable regular file: ${relative}`);\n    }\n    const descriptor = fs.openSync(filePath, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);\n    try {\n      const opened = fs.fstatSync(descriptor);\n      if (!opened.isFile() || opened.dev !== before.dev || opened.ino !== before.ino || opened.size !== before.size) throw new Error(`candidate source changed while opening: ${relative}`);\n      const bytes = fs.readFileSync(descriptor);\n      const after = fs.fstatSync(descriptor);\n      if (after.dev !== opened.dev || after.ino !== opened.ino || after.size !== opened.size ||\n          createHash(\"sha256\").update(bytes).digest(\"hex\") !== snapshotEntry.digest) {\n        throw new Error(`candidate source changed while copying: ${relative}`);\n      }\n      return { bytes, mode: after.mode & 0o777 };\n    } finally {\n      fs.closeSync(descriptor);\n    }\n  } finally {\n    fs.closeSync(directory);\n  }\n}\n\nfunction createPinnedCandidateWorkspace(baselineWorkspace, candidateWorkspace) {\n  if (!baselineWorkspace) throw new Error(\"no pre-agent build configuration workspace is available\");\n  const baseline = captureWorkspaceSnapshot(baselineWorkspace);\n  const candidate = captureWorkspaceSnapshot(candidateWorkspace);\n  const tempRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-evaluator-pinned-config-\"));\n  const pinnedWorkspace = path.join(tempRoot, \"workspace\");\n  try {\n    fs.cpSync(baselineWorkspace, pinnedWorkspace, { recursive: true, verbatimSymlinks: true, preserveTimestamps: true });\n    const paths = new Set([...baseline.keys(), ...candidate.keys()]);\n    for (const relative of paths) {\n      if (!sourceOverlayPath(relative)) continue;\n      const before = baseline.get(relative);\n      const after = candidate.get(relative);\n      if (before && after && sameEntry(before, after)) continue;\n      const target = path.join(pinnedWorkspace, ...relative.split(\"/\"));\n      if (!after) {\n        fs.rmSync(target, { force: true });\n        continue;\n      }\n      const { bytes, mode } = readVerifiedCandidateFile(candidateWorkspace, relative, after);\n      const targetParent = path.dirname(target);\n      const parents = [];\n      let current = targetParent;\n      while (current !== pinnedWorkspace && current.startsWith(`${pinnedWorkspace}${path.sep}`)) {\n        parents.push(current);\n        current = path.dirname(current);\n      }\n      for (const directory of parents.reverse()) {\n        try {\n          const stat = fs.lstatSync(directory);\n          if (stat.isSymbolicLink() || !stat.isDirectory()) {\n            fs.rmSync(directory, { recursive: true, force: true });\n            fs.mkdirSync(directory, { recursive: false });\n          }\n        } catch (error) {\n          if (error?.code !== \"ENOENT\") throw error;\n          fs.mkdirSync(directory, { recursive: true });\n        }\n      }\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { isolatedProcessArgv, runIsolatedProcess, sandboxAvailable } from \"../../isolate.mjs\";\n\nconst OUTPUT_LIMIT = 4 * 1024 * 1024;\nconst SYSTEM_COMMAND_DIRS = [\"/usr/bin\", \"/bin\"];\n\nfunction resolveCommand(command, cwd) {\n  if (path.isAbsolute(command) || command.includes(path.sep)) {\n    return fs.realpathSync(path.isAbsolute(command) ? command : path.resolve(cwd, command));\n  }\n  for (const directory of SYSTEM_COMMAND_DIRS) {\n    const candidate = path.join(directory, command);\n    try {\n      fs.accessSync(candidate, fs.constants.X_OK);\n      return fs.realpathSync(candidate);\n    } catch (error) {\n      if (error?.code !== \"ENOENT\" && error?.code !== \"EACCES\") throw error;\n    }\n  }\n  throw new Error(`command is not present in the isolated runtime: ${command}`);\n}\n\n/** Create an argv-only evaluator runner with injectable isolation checks for deterministic tests. */\nexport function createContainedRunner(dependencies = {}) {\n  const hasSandbox = dependencies.sandboxAvailable ?? sandboxAvailable;\n  const buildSpec = dependencies.isolatedProcessArgv ?? isolatedProcessArgv;\n  const runProcess = dependencies.runIsolatedProcess ?? runIsolatedProcess;\n  return async (command, args = [], { cwd, timeoutMs = 120_000 } = {}) => {\n    if (typeof command !== \"string\" || !command || !Array.isArray(args) || args.some((arg) => typeof arg !== \"string\")) {\n      throw new TypeError(\"command and string argv are required\");\n    }\n    if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1) throw new RangeError(\"timeoutMs must be a positive integer\");\n\n    let temporaryCwd;\n    try {\n      const workingDirectory = cwd ? fs.realpathSync(cwd) : (temporaryCwd = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-evaluator-command-\")));\n      if (!hasSandbox()) throw new Error(\"Bubblewrap is unavailable; refusing to execute candidate commands\");\n      const runtimeCommand = resolveCommand(command, workingDirectory);\n      const spec = buildSpec({\n        cwd: workingDirectory,\n        command: runtimeCommand,\n        argv: args,\n        readOnlyPaths: [runtimeCommand],\n        allowedFiles: [runtimeCommand],\n        timeoutMs,\n      });\n      const result = await runProcess(spec, { outputLimit: OUTPUT_LIMIT });\n      const error = result.error ?? (result.overflow ? \"candidate command exceeded the output limit\" : result.containmentProblem ?? null);\n      return {\n        status: Number.isInteger(result.status) ? result.status : null,\n        signal: result.signal ?? null,\n        timedOut: result.timedOut === true,\n        error,\n        stdout: result.stdout ?? \"\",\n        stderr: result.stderr ?? \"\",\n      };\n    } catch (error) {\n      return { status: null, signal: null, timedOut: false, error: String(error?.message ?? error), stdout: \"\", stderr: \"\" };\n    } finally {\n      if (temporaryCwd) fs.rmSync(temporaryCwd, { recursive: true, force: true });\n    }\n  };\n}\n\n/** Execute a fixed argv vector inside a Bubblewrap workspace with bounded output, time, and process cleanup. */\nexport const runArgv = createContainedRunner();\n\nexport function commandSucceeded(result) {\n  return result?.status === 0 && result?.signal == null && result?.timedOut !== true && result?.error == null;\n}\nimport { commandSucceeded, runArgv } from \"./command.mjs\";\nimport { evaluatorResult } from \"./result.mjs\";\n\n/** Run a configured build argv vector and score strictly by its exit result. */\nexport async function evaluateBuild({ command, args = [], cwd, timeoutMs, runner = runArgv }) {\n  if (typeof command !== \"string\" || !command || !Array.isArray(args)) throw new TypeError(\"build command and args are required\");\n  let run;\n  try { run = await runner(command, args, { cwd, timeoutMs }); }\n  catch (error) { run = { status: null, error: String(error?.message ?? error) }; }\n  const passed = commandSucceeded(run);\n  return evaluatorResult(\"build\", passed, passed ? 1 : 0, { command, args, status: run.status ?? null, signal: run.signal ?? null, timedOut: run.timedOut === true, error: run.error ?? null });\n}\nimport path from \"node:path\";\nimport { runArgv } from \"./command.mjs\";\nimport { evaluatorResult } from \"./result.mjs\";\n\nfunction diagnosticLines(result) {\n  return `${result?.stdout ?? \"\"}\\n${result?.stderr ?? \"\"}`.split(/\\r?\\n/).map((line) => line.trim()).filter(Boolean);\n}\n\n/**\n * Compare baseline and candidate typecheck diagnostics: new diagnostics fail, and so does a non-zero candidate exit when\n * the baseline exited 0 or the candidate printed no diagnostics (a silent failure).\n */\nexport async function evaluateTypecheckClean({ baseline, candidate, runner = runArgv }) {\n  for (const revision of [baseline, candidate]) {\n    if (!revision || typeof revision.command !== \"string\" || !revision.command || !Array.isArray(revision.args ?? []) ||\n        typeof revision.cwd !== \"string\" || !path.isAbsolute(revision.cwd)) {\n      throw new TypeError(\"baseline and candidate typecheck command specs are required\");\n    }\n  }\n  if (path.resolve(baseline.cwd) === path.resolve(candidate.cwd)) {\n    throw new TypeError(\"baseline and candidate typecheck workspaces must be separate\");\n  }\n  const invoke = async (spec) => {\n    try { return await runner(spec.command, spec.args ?? [], { cwd: spec.cwd, timeoutMs: spec.timeoutMs }); }\n    catch (error) { return { status: null, error: String(error?.message ?? error), stdout: \"\", stderr: \"\" }; }\n  };\n  const [baselineResult, candidateResult] = await Promise.all([invoke(baseline), invoke(candidate)]);\n  const baselineOutput = diagnosticLines(baselineResult);\n  const candidateOutput = diagnosticLines(candidateResult);\n  const baselineCounts = new Map();\n  for (const line of baselineOutput) baselineCounts.set(line, (baselineCounts.get(line) ?? 0) + 1);\n  const seenCandidate = new Map();\n  const newDiagnostics = candidateOutput.filter((line) => {\n    const seen = (seenCandidate.get(line) ?? 0) + 1;\n    seenCandidate.set(line, seen);\n    return seen > (baselineCounts.get(line) ?? 0);\n  });\n  const recognizedDiagnostic = (lines) => lines.some((line) => /\\berror\\s+TS\\d+:|\\berror\\[E\\d+\\]:/i.test(line));\n  const infrastructureFailure = [baselineResult, candidateResult].some((result) =>\n    result?.status == null || result?.signal != null || result?.timedOut === true || result?.error != null) ||\n    (baselineResult.status !== 0 && !recognizedDiagnostic(baselineOutput)) ||\n    (candidateResult.status !== 0 && !recognizedDiagnostic(candidateOutput));\n  // A candidate that fails where the baseline passed, or that fails without printing any diagnostic, has regressed even\n  // though no new diagnostic line appears. A failing baseline's exit code alone is not compared: it varies with settings.\n  const statusRegression = !infrastructureFailure && candidateResult.status !== 0 &&\n    (baselineResult.status === 0 || candidateOutput.length === 0);\n  const passed = !infrastructureFailure && !statusRegression && newDiagnostics.length === 0;\n  return evaluatorResult(\"typecheck_clean\", passed, passed ? 1 : 0, {\n    baseline: { command: baseline.command, args: baseline.args ?? [], status: baselineResult.status ?? null },\n    candidate: { command: candidate.command, args: candidate.args ?? [], status: candidateResult.status ?? null },\n    baselineDiagnosticCount: baselineOutput.length, candidateDiagnosticCount: candidateOutput.length,\n    newDiagnostics, infrastructureFailure, statusRegression,\n  });\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1a83e-2c55-7f73-bb41-4b9fa47da4c8","create_time":1793826493.8013294}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
