{"timestamp":"2026-11-24T06:42:54.671Z","ordinal":108106,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20c49-1bcf-7563-9889-443e19f9956a","item":{"type":"CommandExecution","id":"exec-570a805f-c952-49d6-ba92-c6b6bc49ce2e","process_id":"61462","command":["/usr/bin/zsh","-lc","rg -n \"execFileSync\\(|git\" cli/src/core/candidate.ts | sed -n '1,120p'; sed -n '325,375p' cli/src/slash/workspace_commands.ts; sed -n '370,430p' cli/src/slash/workspace_commands.ts; sed -n '1,120p' cli/src/core/checkout_trust.ts"],"cwd":"file:///home/mike/nexus-wt/context-maturity-v130","parsed_cmd":[{"type":"search","cmd":"rg -n \"execFileSync\\\\(|git\" cli/src/core/candidate.ts","query":"execFileSync\\(|git","path":"candidate.ts"},{"type":"read","cmd":"sed -n '325,375p' cli/src/slash/workspace_commands.ts","name":"workspace_commands.ts","path":"cli/src/slash/workspace_commands.ts"},{"type":"read","cmd":"sed -n '370,430p' cli/src/slash/workspace_commands.ts","name":"workspace_commands.ts","path":"cli/src/slash/workspace_commands.ts"},{"type":"read","cmd":"sed -n '1,120p' cli/src/core/checkout_trust.ts","name":"checkout_trust.ts","path":"cli/src/core/checkout_trust.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"347:/** A git path that cannot be turned into a path string (not valid UTF-8): the identity is unknown. */\n355:/** A git call of the identity that did not finish in time. `code` lets callers tell it from other failures. */\n365: * Splits NUL-delimited git output into path strings. `-z` output is never quoted, so a name with a space, a quote,\n384: * How long one git call of the identity may run. A hung git (a stale lock, a network filesystem) must fail the identity,\n387:export function gitTimeoutMs(): number {\n397: * Whether git ignores the executable bit here (`core.filemode=false`, common on WSL mounts, shared drives and exFAT).\n398: * Unset means git honours it. A git that hangs or cannot run is an error, not \"true\".\n400:function gitFilemodeIsFalse(workspacePath: string): boolean {\n402:    const value = execFileSync(\"git\", [\"config\", \"--type=bool\", \"--get\", \"core.filemode\"], {\n406:      timeout: gitTimeoutMs(),\n410:    if (isGitTimeout(err)) throw new GitTimeoutError(\"git config\", gitTimeoutMs());\n411:    // `git config --get` exits 1 when the key is unset: git then honours the executable bit.\n423: * Computes candidate identity for a workspace directory (git or non-git fallback).\n450:    const gitCheck = execFileSync(\"git\", [\"rev-parse\", \"--is-inside-work-tree\"], {\n454:      timeout: gitTimeoutMs(),\n456:    isGit = gitCheck === \"true\";\n458:    // A git that hangs is not \"not a repository\": the weaker non-git identity must not stand in for it.\n459:    if (isGitTimeout(err)) throw new GitTimeoutError(\"git rev-parse\", gitTimeoutMs());\n481:  // The agent can write a linked worktree's `.git` pointer; a replaced one or a planted nested repository would have Git\n489:    rootBaseSha = execFileSync(\n490:      \"git\",\n496:        timeout: gitTimeoutMs(),\n500:    if (isGitTimeout(err)) throw new GitTimeoutError(\"git rev-parse\", gitTimeoutMs());\n573:        if (child.name === \".git\") continue;\n595:      diffTokens = decodeGitTokens(execFileSync(\n596:        \"git\",\n602:          timeout: gitTimeoutMs(),\n606:      // A name that cannot be decoded, or a git that hangs, makes the identity unknown; any other diff failure keeps the\n609:      if (isGitTimeout(err)) throw new GitTimeoutError(\"git diff\", gitTimeoutMs());\n664:  // With core.filemode=false git ignores the executable bit, so a chmod of a clean tracked file is invisible to\n665:  // `git status`. The tracked files' type and executable bit are then digested from lstat (no hashing).\n668:  // 2. Query git status for working tree modifications, type changes, and untracked files\n672:    const statusTokens = decodeGitTokens(execFileSync(\n673:      \"git\",\n679:        timeout: gitTimeoutMs(),\n683:    // `git status` does not report an edit to a tracked file marked assume-unchanged or skip-worktree (a sparse\n684:    // checkout marks everything outside its cone). Those files are hashed by path, so an edit behind git's back changes\n686:    const flaggedTokens = decodeGitTokens(execFileSync(\"git\", [\"ls-files\", \"-v\", \"-z\"], {\n690:      timeout: gitTimeoutMs(),\n693:      if (record.length < 3 || record[1] !== \" \") throw new Error(`unrecognised git ls-files record: ${JSON.stringify(record.slice(0, 12))}`);\n721:    if (gitFilemodeIsFalse(workspacePath)) {\n742:        if (record.length < 4 || record[2] !== \" \") throw new Error(`unrecognised git status record: ${JSON.stringify(record.slice(0, 12))}`);\n813:    // A timeout keeps its type so callers can stop retrying a hung git (stateIdentityDisabled in agent.ts).\n815:    if (isGitTimeout(err)) throw new GitTimeoutError(\"git\", gitTimeoutMs());\n816:    throw new Error(`Failed to query git status for candidate identity: ${err.message}`);\n849:  const candidateId = hashContent(`candidate-v1:git:${rootBaseSha}:${manifestHash}`);\n877:    \".git\",\n935:          throw new Error(`Unsupported filesystem object type in non-git workspace at: ${relativePath}`);\n953:  const candidateId = hashContent(`candidate-v1:nongit:${manifestHash}`);\n  const savedSession = sessionManager.loadSession(host.sessionId());\n  const previousInventory = isContextInventorySnapshot(savedSession?.contextInventory) ? savedSession.contextInventory : undefined;\n  const sources: Array<{ name: string; status: ContextSourceStatus; outcome?: ContextSourceOutcome; durationMs: number; items: ContextSourceItemInput[]; omittedItemCount?: number; detail?: string }> = [];\n  const gaps: string[] = [];\n  if (typeof agent.getInferenceContextManifests !== \"function\") gaps.push(\"This agent instance does not expose persisted per-inference request manifests.\");\n  type SourceReadResult = ContextSourceItemInput[] | BoundedContextSourceItems;\n  const remainingItemBudget = () => Math.max(0, maxItems - sources.reduce((sum, source) => sum + source.items.length + (source.omittedItemCount ?? 0), 0));\n  const recordSourceItems = (name: string, status: ContextSourceStatus, durationMs: number, result: SourceReadResult, detail?: string) => {\n    const collection = Array.isArray(result) ? { items: result, omittedItemCount: 0 } : result;\n    const itemBudget = remainingItemBudget();\n    const items = collection.items.slice(0, itemBudget);\n    const omittedItemCount = collection.omittedItemCount + Math.max(0, collection.items.length - items.length);\n    sources.push({ name, status, durationMs, items, ...(omittedItemCount ? { omittedItemCount } : {}), ...(detail ? { detail } : {}) });\n  };\n  const measure = async (name: string, read: (itemBudget: number) => SourceReadResult | Promise<SourceReadResult>, status: \"ok\" | \"partial\" = \"ok\", detail?: string): Promise<void> => {\n    const remainingMs = Math.max(0, budgetMs - (performance.now() - assemblyStarted));\n    if (signal.aborted || remainingMs <= 0) {\n      const timedOut = !signal.aborted;\n      const outcome: ContextSourceOutcome = timedOut ? \"timed_out\" : \"cancelled\";\n      const reason = timedOut ? \"inspection budget exhausted before source lookup\" : \"inspection cancelled before source lookup\";\n      sources.push({ name, status: \"failed\", outcome, durationMs: 0, items: [], detail: reason });\n      gaps.push(`${name} ${reason}`);\n      return;\n    }\n    const started = performance.now();\n    let timeout: NodeJS.Timeout | undefined;\n    let abortListener: (() => void) | undefined;\n    try {\n      const result = read(remainingItemBudget());\n      if (result && typeof (result as Promise<ContextSourceItemInput[]>).then === \"function\") {\n        const interrupted = new Promise<{ kind: \"timeout\" } | { kind: \"cancelled\" }>((resolve) => {\n          timeout = setTimeout(() => resolve({ kind: \"timeout\" }), remainingMs);\n          abortListener = () => resolve({ kind: \"cancelled\" });\n          signal.addEventListener(\"abort\", abortListener, { once: true });\n        });\n        const completed = Promise.resolve(result).then(\n          (items) => ({ kind: \"ok\" as const, items }),\n          () => ({ kind: \"failed\" as const }),\n        );\n        const outcome = await Promise.race([completed, interrupted]);\n        if (outcome.kind === \"timeout\" || outcome.kind === \"cancelled\") {\n          const sourceOutcome: ContextSourceOutcome = outcome.kind === \"timeout\" ? \"timed_out\" : \"cancelled\";\n          const reason = outcome.kind === \"timeout\"\n            ? `source did not return within the remaining ${remainingMs}ms inspection budget; late results are discarded`\n            : \"inspection cancelled while the source was pending; late results are discarded\";\n          sources.push({ name, status: \"failed\", outcome: sourceOutcome, durationMs: performance.now() - started, items: [], detail: reason });\n          gaps.push(`${name} ${reason}`);\n          return;\n        }\n        if (outcome.kind === \"failed\") throw new Error(\"source rejected\");\n        recordSourceItems(name, status, performance.now() - started, outcome.items, detail);\n          sources.push({ name, status: \"failed\", outcome: sourceOutcome, durationMs: performance.now() - started, items: [], detail: reason });\n          gaps.push(`${name} ${reason}`);\n          return;\n        }\n        if (outcome.kind === \"failed\") throw new Error(\"source rejected\");\n        recordSourceItems(name, status, performance.now() - started, outcome.items, detail);\n      } else {\n        const durationMs = performance.now() - started;\n        if (durationMs > remainingMs) {\n          const reason = `synchronous source exceeded the remaining ${remainingMs}ms inspection budget by ${Math.round(durationMs - remainingMs)}ms; result discarded because synchronous reads cannot be preempted`;\n          sources.push({ name, status: \"failed\", outcome: \"timed_out\", durationMs, items: [], detail: reason });\n          gaps.push(`${name} ${reason}`);\n          return;\n        }\n        recordSourceItems(name, status, durationMs, result as SourceReadResult, detail);\n      }\n    } catch {\n      sources.push({ name, status: \"failed\", durationMs: performance.now() - started, items: [], detail: \"source lookup failed; no source content was recorded\" });\n      gaps.push(`${name} source lookup failed`);\n    } finally {\n      if (timeout) clearTimeout(timeout);\n      if (abortListener) signal.removeEventListener(\"abort\", abortListener);\n    }\n  };\n\n  let promptComponentsAvailable = false;\n  await measure(\"system_prompt_components\", () => {\n    if (typeof agent.getSystemPromptContextSources !== \"function\") throw new Error(\"system prompt source API unavailable\");\n    const components = agent.getSystemPromptContextSources();\n    if (!components?.length) throw new Error(\"active system prompt source references are unavailable or stale\");\n    promptComponentsAvailable = true;\n    return components;\n  }, \"partial\", \"content is sliced from the active prompt in memory for token estimation; only metadata and source references are retained\");\n  if (!promptComponentsAvailable) gaps.push(\"active system prompt sections could not be linked to the current message; the transcript fallback is retained as one opaque item\");\n  await measure(\"session_messages\", (itemBudget) => {\n    const messages: any = agent.getMessages();\n    const collect = (value: any[]) => inventorySourcesFromMessagesBounded(\n      promptComponentsAvailable ? value.filter((message: any, index: number) => !(index === 0 && message?.role === \"system\")) : value,\n      { maxItems: itemBudget },\n    );\n    return messages && typeof messages.then === \"function\" ? messages.then(collect) : collect(messages);\n  });\n  let workspaceFingerprint: string | undefined;\n  await measure(\"workspace_state_fingerprint\", () => {\n    if (typeof agent.getWorkspaceContextFingerprint !== \"function\") throw new Error(\"workspace fingerprint API unavailable\");\n    workspaceFingerprint = agent.getWorkspaceContextFingerprint();\n    if (!workspaceFingerprint) throw new Error(\"workspace fingerprint unavailable\");\n    return [{\n      sourceType: \"workspace_state_fingerprint\",\n      sourceLocation: \"repository:candidate-identity\",\n      scope: \"repository\",\n      content: \"bounded composite candidate identity\",\n      trust: \"tool_output_unverified\",\n      retention: \"session_context_inventory\",\n      inclusionReason: \"supports equality comparison with the previous recorded workspace state; it is not evidence that repository content is correct\",\n      retrievalMethod: \"candidate_identity\",\n      freshness: \"current\",\n      freshnessRule: \"computed at capture from current candidate identity; any workspace candidate change invalidates this observation\",\n    }];\n  });\n  if (typeof agent.getInferenceContextManifests === \"function\") {\n/**\n * Which checkouts the host may run Git in. The agent's sandbox can write its worktree (its `.git` pointer and nested\n * repositories included) but nothing outside it, and Git reads the configuration of whatever repository `.git` leads\n * to, so a planted one is a way to run a command on the host. Pure file-system checks, shared by the worktree Git helper\n * (`worktrunk/git.ts`), the session's own Git helpers and the checkpoint manager; no dependency on any of them.\n */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\n\nfunction inside(root: string, candidate: string): boolean {\n  return candidate === root || candidate.startsWith(root + path.sep);\n}\n\n/** Variables that change how Git reads pathspecs; an inherited one would turn a `:(top)` magic pathspec literal or case-insensitive. */\nexport const PATHSPEC_MODE_ENV: readonly string[] = [\"GIT_LITERAL_PATHSPECS\", \"GIT_GLOB_PATHSPECS\", \"GIT_NOGLOB_PATHSPECS\", \"GIT_ICASE_PATHSPECS\"];\n\n/**\n * The path in a `.git` pointer file, read the way Git reads it: the content must start with `gitdir: `, only the\n * trailing line break is dropped, and nothing else is trimmed. A guard that trimmed would resolve a different directory\n * than Git does for `gitdir: x ` and could be shown a harmless one; such a pointer is refused instead.\n */\nexport function parseGitfilePointer(content: string): string | undefined {\n  if (!content.startsWith(\"gitdir: \")) return undefined;\n  const target = content.slice(\"gitdir: \".length).replace(/\\r?\\n$/, \"\");\n  if (target === \"\" || target !== target.trim() || /[\\0\\r\\n]/.test(target)) return undefined;\n  return target;\n}\n\n/**\n * The text of a small regular file, or undefined. The agent controls these paths: a FIFO would block the host's\n * synchronous read for ever, a link to `/dev/zero` or a huge sparse file would exhaust memory. Nothing is opened unless\n * `lstat` says it is a plain file of at most `maxBytes`, and it is opened non-blocking without following links.\n */\nexport function readSmallFile(file: string, maxBytes: number): string | undefined {\n  try {\n    const stat = fs.lstatSync(file);\n    if (stat.isSymbolicLink() || !stat.isFile() || stat.size > maxBytes) return undefined;\n    const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NONBLOCK | fs.constants.O_NOFOLLOW);\n    try {\n      const opened = fs.fstatSync(fd);\n      if (!opened.isFile() || opened.size > maxBytes) return undefined;\n      return fs.readFileSync(fd, \"utf8\");\n    } finally { fs.closeSync(fd); }\n  } catch { return undefined; }\n}\n\nexport const MAX_POINTER_BYTES = 4096;\nconst MAX_CONFIG_BYTES = 1024 * 1024;\n\n/** Repositories this process has opened and their linked worktrees (from `git worktree list`, run where the operator is). */\nconst knownCommonDirs = new Set<string>();\nconst knownLinkedWorktrees = new Set<string>();\nexport function rememberRepository(commonDir: string, linkedWorktrees: readonly string[]): void {\n  knownCommonDirs.add(commonDir);\n  for (const dir of linkedWorktrees) {\n    try { knownLinkedWorktrees.add(fs.realpathSync(dir)); } catch { /* gone: nothing to run Git in */ }\n  }\n}\n\n/**\n * Whether `root`, which has a `.git` DIRECTORY, is really a linked worktree whose `.git` FILE the agent replaced: it is\n * a linked worktree of a repository this process opened, or it is registered (with its `.git` file) in an enclosing\n * repository's or an opened repository's worktree registry. A registry entry that cannot be read is skipped on its own,\n * never ending the scan of the others.\n */\nexport function replacedWorktreeReason(root: string): string | undefined {\n  if (knownLinkedWorktrees.has(root)) return `${root} is a linked worktree whose .git file was replaced by a repository`;\n  const registries = new Set<string>(Array.from(knownCommonDirs, (common) => path.join(common, \"worktrees\")));\n  for (let dir = path.dirname(root); ; dir = path.dirname(dir)) {\n    registries.add(path.join(dir, \".git\", \"worktrees\"));\n    if (path.dirname(dir) === dir) break;\n  }\n  // The sibling layout (`<repo>.<branch>` beside `<repo>`) puts the main repository next to the worktree, not above it.\n  const parent = path.dirname(root);\n  try {\n    for (const child of fs.readdirSync(parent)) {\n      if (path.basename(root).startsWith(child + \".\")) registries.add(path.join(parent, child, \".git\", \"worktrees\"));\n    }\n  } catch { /* unreadable */ }\n  for (const registry of registries) {\n    let names: string[];\n    try { names = fs.readdirSync(registry); } catch { continue; } // no registry here\n    for (const name of names) {\n      try {\n        const recorded = readSmallFile(path.join(registry, name, \"gitdir\"), MAX_POINTER_BYTES)?.trim();\n        if (recorded === undefin