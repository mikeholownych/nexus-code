ge: any, index: number) => !(index === 0 && message?.role === \"system\")) : value,\n      { maxItems: itemBudget },\n    );\n    return messages && typeof messages.then === \"function\" ? messages.then(collect) : collect(messages);\n  });\n  let workspaceFingerprint: string | undefined;\n  await measure(\"workspace_state_fingerprint\", () => {\n    if (typeof agent.getWorkspaceContextFingerprint !== \"function\") throw new Error(\"workspace fingerprint API unavailable\");\n    workspaceFingerprint = agent.getWorkspaceContextFingerprint();\n    if (!workspaceFingerprint) throw new Error(\"workspace fingerprint unavailable\");\n    return [{\n      sourceType: \"workspace_state_fingerprint\",\n      sourceLocation: \"repository:candidate-identity\",\n      scope: \"repository\",\n      content: \"bounded composite candidate identity\",\n      trust: \"tool_output_unverified\",\n      retention: \"session_context_inventory\",\n      inclusionReason: \"supports equality comparison with the previous recorded workspace state; it is not evidence that repository content is correct\",\n      retrievalMethod: \"candidate_identity\",\n      freshness: \"current\",\n      freshnessRule: \"computed at capture from current candidate identity; any workspace candidate change invalidates this observation\",\n    }];\n  });\n  if (typeof agent.getInferenceContextManifests === \"function\") {\n1878:  public getWorkspaceContextFingerprint(): string | undefined {\n    /** The loop has ended: steering can no longer be applied in this turn (the host starts a follow-up turn). */\n    closing?: boolean;\n    /** TDD RED boundary: task_completed may record a failing verifier as the phase result. */\n    tddRed?: boolean;\n  };\n  private lastTurnResult?: TurnResult;\n  /** VR-3: structured sandbox refusals observed during this process; shown in receipt projections. */\n  private sandboxDenialEvents: SandboxDenialEvent[] = [];\n  recordSandboxDenialEvent(event: SandboxDenialEvent): void {\n    this.sandboxDenialEvents.push(event);\n    if (this.sandboxDenialEvents.length > 50) this.sandboxDenialEvents.splice(0, this.sandboxDenialEvents.length - 50);\n  }\n  getSandboxDenialEvents(): readonly SandboxDenialEvent[] {\n    return this.sandboxDenialEvents;\n  }\n  private completionSummary?: { summary: string; notes?: string };\n  private observer?: AgentObserver;\n  private toolDispatchSeq = 0;\n  private evaluationToolReceipts: EvaluationToolReceipt[] = [];\n  /** Egress destinations the operator approved this session (cleared on reset and restore: approvals never persist). */\n  private approvedEgressOrigins = new Set<string>();\n  /** Verifier commands the operator approved this session (cleared on reset and restore). */\n  private approvedVerifiers = new Set<string>();\n  private approvalPolicy: ApprovalPolicy = defaultApprovalPolicy;\n  private verifiedWorktreeCompletion: boolean = false;\n  private worktreeRunTurnAuthorized: boolean = false;\n  private worktreeDelegatedTurnInProgress: boolean = false;\n  private managedWorktreeWorkspaceSwitch: boolean = false;\n  private flightRecorder?: FlightRecorder;\n  private traceRecorder?: LocalTraceRecorder;\n  private traceSessionId?: string;\n  private traceContextSessionId?: string;\n  private traceDisabled = false;\n  private activeTraceSpanId?: string;\n  private activeCompactionTrace?: { span: SpanHandle; ended: boolean };\n  private worktreeManager: WorktreeManager;\n  private activeWorktree?: { taskId: string; worktreePath: string; branch: string; kind?: \"task\" | \"named\" };\n  private originalWorkspace?: string;\n  private inheritedWorktreeScope?: { workspace: string; requireSandbox: true };\n  private plannerClient: LocalLlmClient;\n  private coderClient: LocalLlmClient;\n  private cognitiveRoutingEnabled: boolean = false;\n  private activeTier: \"planner\" | \"coder\" = \"planner\";\n  private tierStats = { plannerTurns: 0, coderTurns: 0 };\n  private hybridSearch: HybridSearchEngine;\n  private synthesizer: SynthesizerEngine;\n  private browser: BrowserDriver;\n  private knowledge: KnowledgeGraph;\n  public readonly capabilityRegistry: CapabilityRegistry;\n  public readonly authorityEngine: AuthorityAdmissionEngine;\n  public readonly spine: ExecutionSpine;\n  public readonly candidateTracker: CandidateTracker;\n  public readonly stateManager: DurableStateManager;\n  private primaryWorkspacePathIdentity: WorkspacePath;\n  private workspacePathIdentity: WorkspacePath;\n  private initialStatePersistenceFailure?: string;\n  private activeValidationReceipt?: ValidationReceipt;\n  private currentTaskId: string = \"task-\" + randomUUID().slice(0, 8);\n  /** The operator's objective and acceptance requirements (core/objective.ts); undefined before the first turn. */\n  private objective?: ObjectiveLedger;\n  /** Context compactions committed since the conversation started (their originals are in the archive). */\n  private compactions = 0;\n  /** Mutating tool calls so far (edits, writes, shell commands): a verifier failure is reused only while this is unchanged. */\n  private mutationSeq = 0;\n  /** Set when a workspace state identity proved too costly this turn; see workspaceStateIdentity. */\n  private stateIdentityDisabled = false;\n  private stateIdentityUncertainty?: string;\n  /** User-selected read-only mode after a sensitive pre-turn checkpoint was declined. */\n  private checkpointReadOnlyFallback = false;\n  /** Provider capabilities in effect for the main connection (provider_capabilities.ts); undefined until discovered. */\n  private capabilities?: ProviderCapabilities;\n  private capabilitiesKey = \"\";\n  private capabilitiesCheckedAt = 0;\n  private tokenCountingState: \"supported\" | \"unsupported\" | \"unavailable\" | \"unknown\" = \"unknown\";\n  private tokenCountingDetail?: string;\n  private tokenCountingCooldownUntil = 0;\n  private lastRequestCount?: RequestCount & { estimate: number; step: number; admitted?: AdmissionReport; workerDiffers?: boolean };\n  private inferenceContextManifests: InferenceContextManifest[] = [];\n  private inferenceContextSequence = 0;\n  /** Why capabilities must be re-read before the next request (a capacity rejection or a changed admission), if so. */\n  private capabilitiesStale?: string;\nexport function computeCandidateIdentitySync(\n  workspacePath: string,\n  options: CandidateComputeOptions = {}\n): CandidateIdentity {\n  return computeCandidateIdentitySyncForTesting(workspacePath, options, fs);\n}\n\n/** Test seam for deterministic filesystem race fixtures; production callers use computeCandidateIdentitySync. */\nexport function computeCandidateIdentitySyncForTesting(\n  workspacePath: string,\n  options: CandidateComputeOptions,\n  filesystem: typeof fs,\n): CandidateIdentity {\n  const resolvedWorkspace = path.resolve(workspacePath);\n  if (!filesystem.existsSync(resolvedWorkspace)) {\n    throw new Error(`Workspace path does not exist: ${resolvedWorkspace}`);\n  }\n\n  const stat = filesystem.statSync(resolvedWorkspace);\n  if (!stat.isDirectory()) {\n    throw new Error(`Workspace path is not a directory: ${resolvedWorkspace}`);\n  }\n\n  let isGit = false;\n  try {\n    const gitCheck = execFileSync(\"git\", [\"rev-parse\", \"--is-inside-work-tree\"], {\n      cwd: resolvedWorkspace,\n      encoding: \"utf-8\",\n      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n      timeout: gitTimeoutMs(),\n    }).trim();\n    isGit = gitCheck === \"true\";\n  } catch (err) {\n    // A git that hangs is not \"not a repository\": the weaker non-git identity must not stand in for it.\n    if (isGitTimeout(err)) throw new GitTimeoutError(\"git rev-parse\", gitTimeoutMs());\n    isGit = false;\n  }\n\n  const includeUntracked = options.includeUntracked !== false;\n\n  if (isGit) {\n    return computeGitCandidateIdentity(resolvedWorkspace, options, includeUntracked, filesystem);\n  } else {\n    return computeNonGitCandidateIdentity(resolvedWorkspace, options, filesystem);\n  }\n}\n\n/**\n * Computes candidate identity for a Git-backed workspace or worktree.\n */\nfunction computeGitCandidateIdentity(\n  workspacePath: string,\n  options: CandidateComputeOptions,\n  includeUntracked: boolean,\n  filesystem: typeof fs,\n): CandidateIdentity {\n  // The agent can write a linked worktree's `.git` pointer; a replaced one or a planted nested repository would have Git\n  // read configuration the agent authored (`core.fsmonitor`). The identity of such a workspace is not computed.\n  const untrusted = verifyCheckout(workspacePath).reason;\n  if (untrusted) throw new Error(`Refusing to compute the candidate identity of ${workspacePath}: ${untrusted}`);\n  const entryLimit = configuredEntryLimit(options);\n  const byteLimit = configuredByteLimit(options);\n  let rootBaseSha = \"UNKNOWN_BASE\";\n  try {\n    rootBaseSha = execFileSync(\n      \"git\",\n      [\"rev-parse\", options.baseRef || \"HEAD\"],\n      {\n        cwd: workspacePath,\n        encoding: \"utf-8\",\n        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n        timeout: gitTimeoutMs(),\n      }\n    ).trim();\n  } catch (err) {\n    if (isGitTimeout(err)) throw new GitTimeoutError(\"git rev-parse\", gitTimeoutMs());\n    rootBaseSha = \"EMPTY_GIT_BASE\";\n  }\n\n  const trackedEntriesMap = new Map<string, FileCandidateEntry>();\n  const untrackedEntriesMap = new Map<string, FileCandidateEntry>();\n/**\n * Candidate Identity, Validation Authority & Receipt Management\n * Nexus Issue #12 — WP-04 (INC-05, DEC-02, CAND-001..004, EVID-002, VER-001..005)\n */\n\nimport * as crypto from \"node:crypto\";\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\nimport { verifyCheckout } from \"./checkout_trust.js\";\nimport { CandidateMutationEvent, CandidateMutationHook } from \"./spine.js\";\nimport { TOOLCHAIN_PREFIX, UNVERIFIED_UNTRUSTED, defaultVersionProbe, type VersionProbe } from \"../material_deps.js\";\n\nexport type CandidateFileStatus = \"modified\" | \"added\" | \"deleted\" | \"untracked\" | \"typechange\";\n\nexport interface FileCandidateEntry {\n  path: string; // Relative POSIX path\n  mode: string; // \"100644\" | \"100755\" | \"120000\" | \"000000\"\n  contentHash: string; // SHA-256 hex\n  size: number;\n  status: CandidateFileStatus;\n}\n\nexport interface MaterialValidationDependency {\n  name: string;\n  path?: string; // Relative or absolute path to config/lockfile/toolchain\n  versionOrHash: string; // SHA-256 content hash or explicit version string\n}\n\nexport interface EvaluatorBinding {\n  evaluatorId: string;\n  evaluatorType: string;\n  evaluatorVersion?: string;\n  testSuite?: string;\n  instanceId?: string;\n  metadata?: Record<string, any>;\n}\n\nexport interface CandidateIdentity {\n  candidateId: string; // SHA-256 composite digest of rootBaseSha + canonical manifest\n  workspacePath: string;\n  rootBaseSha: string;\n  trackedChanges: FileCandidateEntry[];\n  untrackedFiles: FileCandidateEntry[];\n  manifestHash: string;\n  isGit: boolean;\n  timestamp: string;\n}\n\nexport interface ValidationReceipt {\n  receiptId: string;\n  candidateId: string; // Bound to exact candidateId\n  verifierCommand: string;\n  exitCode: number;\n  stdoutHash: string;\n  timestamp: string;\n  status: \"PASSED\" | \"FAILED\" | \"INVALIDATED\";\n  evaluatorBinding?: EvaluatorBinding;\n  materialDependencies: MaterialValidationDependency[];\n  invalidationReason?: string;\n  invalidatedAt?: string;\n  evidence?: Record<string, any>;\n}\n\nexport interface CandidateComputeOptions {\n  baseRef?: string;\n  includeUntracked?: boolean;\n  ignoredPatterns?: string[];\n  materialDependencies?: MaterialValidationDependency[];\n  /** Reads the current version of a toolchain dependency (default: node, the installed typescript, rustc). */\n  versionProbe?: VersionProbe;\n  /** Optional stricter manifest bound; values above the hard limit are clamped. */\n  maxEntries?: number;\n  /** Optional stricter byte bound; values above the hard limit are clamped. */\n  maxTotalBytes?: number;\n}\n\nconst MAX_CANDIDATE_ENTRIES = 100_000;\nconst MAX_CANDIDATE_FILE_BYTES = 256 * 1024 * 1024;\nconst MAX_CANDIDATE_TOTAL_BYTES = 1024 * 1024 * 1024;\nconst MAX_CANDIDATE_DIRECTORY_DEPTH = 128;\n\nfunction configuredEntryLimit(options: CandidateComputeOptions): number {\n  const configured = options.maxEntries;\n  if (configured === undefined) return MAX_CANDIDATE_ENTRIES;\n  if (!Number.isSafeInteger(configured) || configured < 1) {\n    throw new Error(\"Candidate maxEntries must be a positive safe integer\");\n  }\n  return Math.min(configured, MAX_CANDIDATE_ENTRIES);\n}\n\nfunction configuredByteLimit(options: CandidateComputeOptions): number {\n  const configured = options.maxTotalBytes;\n  if (configured === undefined) return MAX_CANDIDATE_TOTAL_BYTES;\n  if (!Number.isSafeInteger(configured) || configured < 1) {\n    throw new Error(\"Candidate maxTotalBytes must be a positive safe integer\");\n  }\n  return Math.min(configured, MAX_CANDIDATE_TOTAL_BYTES);\n}\n\nfunction procFdPath(fd: number, childName?: string, filesystem: typeof fs = fs): string {\n  if (process.platform !== \"linux\" || !filesystem.existsSync(\"/proc/self/fd\")) {\n    throw new Error(\"Platform cannot enforce descriptor-relative candidate traversal\");\n  }\n  return childName === undefined ? `/proc/self/fd/${fd}` : `/proc/self/fd/${fd}/${childName}`;\n}\n\nexport function openCandidateDirectory(\n  fullPath: string,\n  parentFd?: number,\n  childName?: string,\n  filesystem: typeof fs = fs,\n): { fd: number; dir: fs.Dir } {\n  const directoryFlag = filesystem.constants.O_DIRECTORY;\n  const noFollow = filesystem.constants.O_NOFOLLOW;\n  const nonBlocking = filesystem.constants.O_NONBLOCK;\n  if (typeof directoryFlag !== \"number\" || typeof noFollow !== \"number\" || typeof nonBlocking !== \"number\") {\n    throw new Error(\"Platform cannot enforce no-follow candidate directory traversal\");\n  }\n  if (parentFd !== undefined && childName === undefined) {\n    throw new Error(\"Descriptor-relative candidate directory requires a child name\");\n  }\n  const target = parentFd === undefined ? filesystem.realpathSync(fullPath) : procFdPath(parentFd, childName, filesystem);\n  const before = filesystem.lstatSync(target, { bigint: true });\n  if (!before.isDirectory()) throw new Error(`Candidate directory changed or is not a directory: ${fullPath}`);\n  const fd = filesystem.openSync(target, filesystem.constants.O_RDONLY | directoryFlag | noFollow | nonBlocking);\n  try {\n    const opened = filesystem.fstatSync(fd, { bigint: true });\n    if (!opened.isDirectory() || opened.dev !== before.dev || opened.ino !== before.ino) {\n      throw new Error(`Candidate directory changed while opening: ${fullPath}`);\n","exit_code":0,"duration":{"secs":0,"nanos":758370101}},"started_at_ms":1795502175496,"completed_at_ms":1795502176255}}
