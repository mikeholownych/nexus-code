3c8191941e5dc465bb899f/artifact-template-operating-calendar\",\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-operating-review\",\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-project-kickoff\",\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-project-tracker\",\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-sales-pipeline\",\"skill://plugin_connector_1p_2330815c823c…6673 tokens truncated…\":{\"plugin_id\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"plugin_name\":\"sites\",\"plugin_release_id\":\"pluginrel_6aea101d13a881918cc3374a2ca69831\",\"plugin_release_skill_id\":\"pluginrsk_6aea101d5b00819193179eaf6bd39cf9\",\"skill_name\":\"sites\",\"contents\":[\"references\",\"scripts\",\"templates\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-remix\",\"name\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-remix\",\"title\":\"sites-remix\",\"description\":\"Remix a Site built with the Sites plugin into a new Site. Use when the user has identified the source Site and asks to remix it.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"plugin_name\":\"sites\",\"plugin_release_id\":\"pluginrel_6aea101d13a881918cc3374a2ca69831\",\"plugin_release_skill_id\":\"pluginrsk_6aea101d5b088191a1d3d733d8f5348d\",\"skill_name\":\"sites-remix\",\"contents\":[],\"allow_implicit_invocation\":true}},{\"server\":\"mcp-agent-mail\",\"uri\":\"resource://config/environment\",\"name\":\"environment_resource_exact\",\"mimeType\":\"application/json\",\"_meta\":{\"_fastmcp\":{\"tags\":[]}}},{\"server\":\"mcp-agent-mail\",\"uri\":\"resource://tooling/directory\",\"name\":\"tooling_directory_resource_exact\",\"mimeType\":\"application/json\",\"_meta\":{\"_fastmcp\":{\"tags\":[]}}},{\"serv