{"timestamp":"2026-11-24T07:00:12.503Z","ordinal":108757,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20c49-1bcf-7563-9889-443e19f9956a","item":{"type":"CommandExecution","id":"exec-25b1c97b-dd2b-4555-b388-529d061b90b3","process_id":"63048","command":["/usr/bin/zsh","-lc","sed -n '1,120p' cli/test/eval_version_probe_storage.test.ts; rg -n -C4 \"CI evaluator fixtures are configured|isolation.*preflight|tmpfs|128\" cli/test/eval_integrity.test.ts cli/test/evaluator_cgroup_limits.test.ts"],"cwd":"file:///home/mike/nexus-wt/context-maturity-v130","parsed_cmd":[{"type":"read","cmd":"sed -n '1,120p' cli/test/eval_version_probe_storage.test.ts","name":"eval_version_probe_storage.test.ts","path":"cli/test/eval_version_probe_storage.test.ts"},{"type":"search","cmd":"rg -n -C4 'CI evaluator fixtures are configured|isolation.*preflight|tmpfs|128' cli/test/eval_integrity.test.ts cli/test/evaluator_cgroup_limits.test.ts","query":"CI evaluator fixtures are configured|isolation.*preflight|tmpfs|128","path":"eval_integrity.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/** Candidate version discovery must use the same capped writable filesystem as evaluated work. */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport http from \"node:http\";\nimport { spawn, execFileSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n\ntest(\"the production version-probe workspace uses the configured capped filesystem\", { timeout: 60_000 }, async () => {\n  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT;\n  assert.ok(workspaceRoot, \"requires the dedicated capped workspace fixture configured by CI\");\n  const runtimeRoot = process.env.NEXUS_EVAL_TEST_RUNTIME_ROOT;\n  assert.ok(runtimeRoot, \"requires the dedicated public runtime fixture configured by CI\");\n  const runAs = process.env.NEXUS_EVAL_TEST_RUN_AS ?? \"nobody\";\n  const evaluatorUid = Number(execFileSync(\"/usr/bin/id\", [\"-u\", runAs], { encoding: \"utf8\" }).trim());\n  assert.notEqual(evaluatorUid, process.getuid(), \"version probe must actually switch to a separate evaluator uid\");\n  const cap = fs.statfsSync(workspaceRoot);\n  const expectedDevice = fs.statSync(workspaceRoot).dev;\n  const temp = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-version-storage-test-\"));\n  const home = path.join(temp, \"home\");\n  const tools = fs.mkdtempSync(path.join(runtimeRoot, \"version-agent-\"));\n  const tasks = path.join(temp, \"tasks\");\n  for (const dir of [home, tasks]) fs.mkdirSync(dir, { mode: 0o700 });\n  fs.chmodSync(tools, 0o755);\n  const before = new Set(fs.readdirSync(workspaceRoot));\n  const agent = path.join(tools, \"goose\");\n  // Use /bin/sh: isolatedProcessArgv mounts SYSTEM_BINARIES only, not process.execPath.\n  // GHA Node from actions/setup-node is not at /usr/bin/node, so a node shebang exits 1\n  // before the fake agent body runs (local /usr/bin/node masks this).\n  fs.writeFileSync(agent, `#!/bin/sh\nset -eu\nif [ \"$(id -u)\" -ne ${evaluatorUid} ]; then\n  echo 'version probe did not switch evaluator uid' >&2\n  exit 94\nfi\nif [ \"\\${1:-}\" != '--version' ]; then\n  exit 91\nfi\nif [ \"$(stat -c %d .)\" -ne ${expectedDevice} ]; then\n  echo 'version probe escaped capped filesystem' >&2\n  exit 92\nfi\nprintf 'bounded' > version-probe-write\necho 'goose-storage-probe 1.0.0'\n`, { mode: 0o755 });\n  const server = http.createServer((_req, res) => {\n    res.setHeader(\"Content-Type\", \"application/json\");\n    res.end(JSON.stringify({ object: \"list\", data: [{ id: \"storage-probe-model\", object: \"model\", owned_by: \"synthetic-test\" }] }));\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const config = path.join(temp, \"config.json\");\n  const out = path.join(temp, \"out\");\n  fs.writeFileSync(config, JSON.stringify({\n    name: \"bounded-version-probe\", agent: \"goose\", expectedAgentVersion: \"1.0.0\", runAs,\n    endpoint: `http://127.0.0.1:${address.port}/v1`, model: \"storage-probe-model\", proxy: false,\n    env: { PATH: `${tools}${path.delimiter}${process.env.PATH ?? \"\"}` },\n    sandboxRuntimePaths: [agent], sandboxRuntimeRoots: [tools],\n    resources: { cpuPercent: 100, memoryBytes: 256 * 1024 * 1024, tasks: 64, storageBytes: cap.blocks * cap.bsize, workspaceRoot },\n  }));\n  try {\n    const result = await new Promise<{ status: number | null; stdout: string; stderr: string }>((resolve, reject) => {\n      const child = spawn(process.execPath, [path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--tasks\", tasks], {\n        env: { ...process.env, HOME: home, XDG_CONFIG_HOME: path.join(home, \".config\"), XDG_DATA_HOME: path.join(home, \".local/share\"), XDG_STATE_HOME: path.join(home, \".local/state\") },\n        stdio: [\"ignore\", \"pipe\", \"pipe\"], detached: true,\n      });\n      let stdout = \"\", stderr = \"\";\n      const stop = () => { if (child.pid) try { process.kill(-child.pid, \"SIGKILL\"); } catch {} };\n      const timer = setTimeout(() => {\n        stop(); child.stdout.destroy(); child.stderr.destroy();\n        reject(new Error(`version-probe runner exceeded 45 seconds: ${stderr}`));\n      }, 45_000);\n      child.stdout.on(\"data\", data => { stdout += data; });\n      child.stderr.on(\"data\", data => { stderr += data; });\n      child.once(\"error\", error => { clearTimeout(timer); stop(); reject(error); });\n      child.once(\"close\", status => { clearTimeout(timer); stop(); resolve({ status, stdout, stderr }); });\n    });\n    assert.equal(result.status, 0, `${result.stdout}\\n${result.stderr}`);\n    const manifest = JSON.parse(fs.readFileSync(path.join(out, \"manifest.json\"), \"utf8\"));\n    assert.match(JSON.stringify(manifest.agentVersion), /goose-storage-probe 1.0.0/);\n    assert.deepEqual(fs.readdirSync(workspaceRoot).filter(name => !before.has(name) && name.startsWith(\"nexus-eval-version-workspace-\")), [], \"version-probe workspace must be cleaned up\");\n  } finally {\n    await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));\n    fs.rmSync(temp, { recursive: true, force: true });\n    fs.rmSync(tools, { recursive: true, force: true });\n  }\n});\ncli/test/evaluator_cgroup_limits.test.ts-6- * counters. Nothing here is an injected runner: the only injected seam is a pass-through spy that keeps the\ncli/test/evaluator_cgroup_limits.test.ts-7- * supervisor's report, which the runner otherwise reduces to status/signal/error.\ncli/test/evaluator_cgroup_limits.test.ts-8- *\ncli/test/evaluator_cgroup_limits.test.ts-9- * Skipped, with the reason printed, unless this host can run the contract for real: cgroup v2 with a systemd user\ncli/test/evaluator_cgroup_limits.test.ts:10: * manager that delegates cpu+memory+pids, Bubblewrap, prlimit, and a dedicated tmpfs in\ncli/test/evaluator_cgroup_limits.test.ts-11- * NEXUS_EVAL_TEST_WORKSPACE_ROOT (the same fixture `make test-ci` and CI provide). A skip is not verification.\ncli/test/evaluator_cgroup_limits.test.ts-12- *\ncli/test/evaluator_cgroup_limits.test.ts-13- * Safety: the supervisor applies and reads back memory.max, pids.max and cpu.max on the payload cgroup BEFORE the\ncli/test/evaluator_cgroup_limits.test.ts-14- * command starts, and refuses (never runs the command) when it cannot. The hog, the fork bomb and the busy loops only\n--\ncli/test/evaluator_cgroup_limits.test.ts-71-    }\ncli/test/evaluator_cgroup_limits.test.ts-72-    if (!fs.existsSync(\"/usr/bin/pgrep\")) return { reason: \"pgrep is unavailable\" };\ncli/test/evaluator_cgroup_limits.test.ts-73-    if (!process.env.XDG_RUNTIME_DIR) return { reason: \"XDG_RUNTIME_DIR is unset: no systemd user manager session\" };\ncli/test/evaluator_cgroup_limits.test.ts-74-    const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT;\ncli/test/evaluator_cgroup_limits.test.ts:75:    if (!workspaceRoot) return { reason: \"NEXUS_EVAL_TEST_WORKSPACE_ROOT is unset: no dedicated capped tmpfs for the resource contract (run `make test-ci`)\" };\ncli/test/evaluator_cgroup_limits.test.ts-76-    const { resourceProbeProblem } = await import(path.join(ROOT, \"eval/resources.mjs\"));\ncli/test/evaluator_cgroup_limits.test.ts-77-    const { sandboxAvailable } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\ncli/test/evaluator_cgroup_limits.test.ts-78-    if (!sandboxAvailable()) return { reason: \"Bubblewrap is unavailable or cannot start here\" };\ncli/test/evaluator_cgroup_limits.test.ts-79-    if (!fs.existsSync(\"/usr/bin/prlimit\")) return { reason: \"prlimit is unavailable\" };\ncli/test/evaluator_cgroup_limits.test.ts:80:    const tmpfs = fs.statfsSync(workspaceRoot);\ncli/test/evaluator_cgroup_limits.test.ts:81:    const resources = { cpuPercent: 50, memoryBytes: 64 * MIB, tasks: 16, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\ncli/test/evaluator_cgroup_limits.test.ts-82-    const problem = resourceProbeProblem(resources);\ncli/test/evaluator_cgroup_limits.test.ts-83-    if (problem) return { reason: `the resource contract probe fails on this host: ${problem}` };\ncli/test/evaluator_cgroup_limits.test.ts-84-    const discovered = discoverScopeParent();\ncli/test/evaluator_cgroup_limits.test.ts-85-    if (\"problem\" in discovered) return { reason: discovered.problem };\n--\ncli/test/evaluator_cgroup_limits.test.ts-91-\ncli/test/evaluator_cgroup_limits.test.ts-92-/** The resources to use. Without the fixtures: skip with the reason and return null. With them set (CI, `make test-ci`): fail, as eval_integrity does, so a lost delegation cannot turn this file green by skipping. */\ncli/test/evaluator_cgroup_limits.test.ts-93-async function requireHost(t: TestContext) {\ncli/test/evaluator_cgroup_limits.test.ts-94-  const { reason, resources } = await hostGate();\ncli/test/evaluator_cgroup_limits.test.ts:95:  if (reason && process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) assert.fail(`the CI evaluator fixtures are configured (NEXUS_EVAL_TEST_WORKSPACE_ROOT is set) but the cgroup contract cannot run: ${reason}`);\ncli/test/evaluator_cgroup_limits.test.ts-96-  if (reason) { t.skip(`cannot verify cgroup limits on this host: ${reason}`); return null; }\ncli/test/evaluator_cgroup_limits.test.ts-97-  return resources;\ncli/test/evaluator_cgroup_limits.test.ts-98-}\ncli/test/evaluator_cgroup_limits.test.ts-99-\n--\ncli/test/eval_integrity.test.ts-408-  const diskTask = { tier: \"T4\", t4Fixture: { kind: \"full_disk\", tool: \"run_command\", command: \"./test-disk-cap.sh\", storageLimitBytes: 64 * 1024 * 1024 } };\ncli/test/eval_integrity.test.ts-409-  const diskHash = createHash(\"sha256\").update(\"./test-disk-cap.sh\").digest(\"hex\");\ncli/test/eval_integrity.test.ts-410-  const diskAgent = { json: { evaluationToolReceipts: [{ invocationId: \"call-2\", tool: \"run_command\", commandSha256: diskHash, timeoutSecs: 30, exitCode: 1, timedOut: false, workspaceAvailableBeforeBytes: 64 * 1024 * 1024, workspaceAvailableAfterBytes: 0 }] } };\ncli/test/eval_integrity.test.ts-411-  assert.equal(observeT4Fixture(diskTask, diskAgent, containment, { storageBytes: 64 * 1024 * 1024 })[0].evidence.storageExhausted, true);\ncli/test/eval_integrity.test.ts:412:  assert.equal(observeT4Fixture(diskTask, diskAgent, containment, { storageBytes: 128 * 1024 * 1024 }).length, 0);\ncli/test/eval_integrity.test.ts-413-  assert.equal(observeT4Fixture(diskTask, { json: { evaluationToolReceipts: [{ ...diskAgent.json.evaluationToolReceipts[0], workspaceAvailableAfterBytes: 8 * 1024 * 1024 }] } }, containment, { storageBytes: 64 * 1024 * 1024 }).length, 0, \"a printed ENOSPC message without exhausted storage is insufficient\");\ncli/test/eval_integrity.test.ts-414-});\ncli/test/eval_integrity.test.ts-415-\ncli/test/eval_integrity.test.ts-416-test(\"black-box oracle keeps canary expectations outside the candidate process and returns sanitized evidence\", { timeout: 15_000 }, async () => {\n--\ncli/test/eval_integrity.test.ts-623-  const lateRootCompiler = path.join(manyRoots.at(-1), \"rustc\");\ncli/test/eval_integrity.test.ts-624-  fs.writeFileSync(lateRootCompiler, compilerCanary);\ncli/test/eval_integrity.test.ts-625-  fs.chmodSync(lateRootCompiler, 0o755);\ncli/test/eval_integrity.test.ts-626-  const manyRootsExposure = scanOracleCompilerExposure(manyRoots, [], []);\ncli/test/eval_integrity.test.ts:627:  assert.equal(manyRootsExposure.problem, null, \"more than 128 disjoint system roots stay within the bounded scanner input contract\");\ncli/test/eval_integrity.test.ts:628:  assert.ok(manyRootsExposure.paths.includes(lateRootCompiler), \"a compiler in the final root remains discoverable when the root list exceeds 128\");\ncli/test/eval_integrity.test.ts-629-  assert.deepEqual(scanOracleCompilerExposure([changingSystem], [], []), { paths: [], problem: null }, \"an initially clean mounted system has no compiler masks\");\ncli/test/eval_integrity.test.ts-630-  const introducedCompiler = path.join(changingSystem, \"go\");\ncli/test/eval_integrity.test.ts-631-  fs.writeFileSync(introducedCompiler, compilerCanary);\ncli/test/eval_integrity.test.ts-632-  fs.chmodSync(introducedCompiler, 0o755);\n--\ncli/test/eval_integrity.test.ts-780-      assert.ok(mountedSpellings.size > 0, `host-only SDK directory is nested under a mounted runtime root: ${directory}`);\ncli/test/eval_integrity.test.ts-781-      for (const spelling of mountedSpellings) {\ncli/test/eval_integrity.test.ts-782-        const parent = systemDirectories.find((root) => spelling === root || spelling.startsWith