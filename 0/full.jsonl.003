son: \"configuration_unavailable\" };\n    97\t  }\n    98\t  const text = readSmallFile(configPath, MAX_GIT_CONFIG_BYTES);\n    99\t  return text === undefined ? { safe: false, reason: \"configuration_unavailable\" } : parseConfig(text);\n   100\t}\n   101\t\n   102\t/**\n   103\t * A filesystem-only guard for context freshness capture. Candidate identity invokes Git commands that can honor\n   104\t * repository-local filters and other configured programs. Refuse to invoke those commands when their configuration\n   105\t * cannot be inspected or contains a program hook. This is diagnostic conservatism: it does not sandbox Git generally.\n   106\t */\n   107\texport function inspectWorkspaceGitSafety(workspace: string): WorkspaceGitSafety {\n   108\t  let gitDir: string | undefined;\n   109\t  try {\n   110\t    if (verifyCheckout(workspace).reason) return { safe: false, reason: \"configuration_unavailable\" };\n   111\t    gitDir = findGitDir(workspace);\n   112\t    if (!gitDir) return { safe: true };\n   113\t  } catch {\n   114\t    return { safe: false, reason: \"configuration_unavailable\" };\n   115\t  }\n   116\t\n   117\t  const configPaths = new Set<string>([path.join(gitDir, \"config\")]);\n   118\t  const commonPointerPath = path.join(gitDir, \"commondir\");\n   119\t  let commonPointer: string | undefined;\n   120\t  try {\n   121\t    fs.lstatSync(commonPointerPath);\n   122\t    commonPointer = readSmallFile(commonPointerPath, 4096);\n   123\t    if (commonPointer === undefined) return { safe: false, reason: \"configuration_unavailable\" };\n   124\t  } catch (error: any) {\n   125\t    if (error?.code !== \"ENOENT\") return { safe: false, reason: \"configuration_unavailable\" };\n   126\t  }\n   127\t  if (commonPointer !== undefined) {\n   128\t    const commonName = commonPointer.replace(/\\r?\\n$/, \"\");\n   129\t    if (!commonName || commonName !== commonName.trim() || /[\\0\\r\\n]/.test(commonName)) {\n   130\t      return { safe: false, reason: \"configuration_unavailable\" };\n   131\t    }\n   132\t    try {\n   133\t      const commonDir = fs.realpathSync(path.resolve(gitDir, commonName));\n   134\t      configPaths.add(path.join(commonDir, \"config\"));\n   135\t    } catch {\n   136\t      return { safe: false, reason: \"configuration_unavailable\" };\n   137\t    }\n   138\t    configPaths.add(path.join(gitDir, \"config.worktree\"));\n   139\t  }\n   140\t\n   141\t  const processConfig = processGitConfigPaths();\n   142\t  if (processConfig.unavailable) return { safe: false, reason: \"configuration_unavailable\" };\n   143\t  for (const configPath of [...processConfig.paths, ...configPaths]) {\n   144\t    const result = inspectConfigFile(configPath);\n   145\t    if (!result.safe) return result;\n   146\t  }\n   147\t  return { safe: true };\n   148\t}\n  1870\t  public getConfig(): HarnessConfig {\n  1871\t    return this.config;\n  1872\t  }\n  1873\t\n  1874\t  public getWorkspacePathIdentity(): WorkspacePath {\n  1875\t    return this.workspacePathIdentity;\n  1876\t  }\n  1877\t\n  1878\t  /** A bounded, content-free candidate identity for revalidating recorded repository context. */\n  1879\t  public getWorkspaceContextFingerprintResult(): { fingerprint?: string; unavailableReason?: WorkspaceGitSafetyReason } {\n  1880\t    const safety = inspectWorkspaceGitSafety(this.config.workspace);\n  1881\t    if (!safety.safe) return { unavailableReason: safety.reason };\n  1882\t    try {\n  1883\t      return { fingerprint: computeCandidateIdentitySync(this.config.workspace, { maxEntries: 4096, maxTotalBytes: 16 * 1024 * 1024 }).candidateId };\n  1884\t    } catch {\n  1885\t      // Unknown is safer than presenting an old repository observation as current.\n  1886\t      return { unavailableReason: \"fingerprint_failed\" };\n  1887\t    }\n  1888\t  }\n  1889\t\n  1890\t  /** Backward-compatible fingerprint accessor; callers needing an explanation use the result form. */\n  1891\t  public getWorkspaceContextFingerprint(): string | undefined {\n  1892\t    return this.getWorkspaceContextFingerprintResult().fingerprint;\n  1893\t  }\n  1894\t\n  1895\t  /** Judges, once per workspace, whether the session STARTED in a linked worktree the agent had already worked in. */\n  1896\t  private judgeReceiptBaselineOnce(): void {\n  1897\t    if (this.receiptBaselineJudged) return;\n  1898\t    this.receiptBaselineJudged = true;\n  1899\t    this.receiptBaselineUntrusted = this.linkedWorktreeStartsDirty();\n  1900\t  }\n  1901\t\n  1902\t  /**\n  1903\t   * Whether the workspace is a linked worktree that either holds uncommitted work or cannot be certified (a nested\n  1904\t   * repository, a hidden edit, a dirty submodule). Fails closed there; a plain checkout or a non-repository is \"no\".\n  1905\t   */\n   285\t  return reply(\"paste\", `Pasted ${result.text.length} characters into the composer.`, true, { composer: result.text });\n   286\t}\n   287\t\n  …1170 tokens truncated…e_identity\",\n   448\t      freshness: \"current\",\n   449\t      freshnessRule: \"computed at capture from current candidate identity; any workspace candidate change invalidates this observation\",\n   450\t    }];\n   451\t  });\n   452\t  if (typeof agent.getInferenceContextManifests === \"function\") {\n   125\t    assert.equal(agent.getWorkspaceContextFingerprint(), before);\n   126\t    fs.writeFileSync(path.join(root, \"README.md\"), \"after\\n\");\n   127\t    assert.notEqual(agent.getWorkspaceContextFingerprint(), before);\n   128\t  } finally {\n   129\t    fs.rmSync(root, { recursive: true, force: true });\n   130\t  }\n   131\t});\n   132\t\n   133\ttest(\"context fingerprint refuses a configured clean filter without running it\", () => {\n   134\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-context-clean-filter-\"));\n   135\t  const marker = path.join(root, \"filter-ran\");\n   136\t  try {\n   137\t    execFileSync(\"git\", [\"init\", \"-q\", root]);\n   138\t    execFileSync(\"git\", [\"-C\", root, \"config\", \"user.email\", \"context-test@example.invalid\"]);\n   139\t    execFileSync(\"git\", [\"-C\", root, \"config\", \"user.name\", \"Context Test\"]);\n   140\t    fs.writeFileSync(path.join(root, \".gitattributes\"), \"tracked.txt filter=hostile\\n\");\n   141\t    fs.writeFileSync(path.join(root, \"tracked.txt\"), \"baseline\\n\");\n   142\t    execFileSync(\"git\", [\"-C\", root, \"add\", \".gitattributes\", \"tracked.txt\"]);\n   143\t    execFileSync(\"git\", [\"-C\", root, \"commit\", \"-q\", \"-m\", \"baseline\"]);\n   144\t    fs.writeFileSync(path.join(root, \"tracked.txt\"), \"changed\\n\");\n   145\t    execFileSync(\"git\", [\"-C\", root, \"config\", \"filter.hostile.clean\", `touch '${marker}'`]);\n   146\t\n   147\t    assert.deepEqual(inspectWorkspaceGitSafety(root), { safe: false, reason: \"program_settings_present\" });\n   148\t    const agent: any = Object.create(AutonomousAgent.prototype);\n   149\t    Object.assign(agent, { config: { workspace: root } });\n   150\t    assert.deepEqual(agent.getWorkspaceContextFingerprintResult(), { unavailableReason: \"program_settings_present\" });\n   151\t    assert.equal(fs.existsSync(marker), false, \"fingerprinting must not invoke the configured clean filter\");\n   152\t  } finally {\n   153\t    fs.rmSync(root, { recursive: true, force: true });\n   154\t  }\n   155\t});\n   156\t\n   157\ttest(\"context fingerprint refuses fsmonitor and included Git configuration before invoking commands\", () => {\n   158\t  for (const unsafeSetting of [\"fsmonitor\", \"include\"]) {\n   159\t    const root = fs.mkdtempSync(path.join(os.tmpdir(), `nexus-context-${unsafeSetting}-`));\n   160\t    const marker = path.join(root, \"program-ran\");\n   161\t    try {\n   162\t      execFileSync(\"git\", [\"init\", \"-q\", root]);\n   163\t      const config = path.join(root, \".git\", \"config\");\n   164\t      if (unsafeSetting === \"fsmonitor\") {\n   165\t        fs.appendFileSync(config, `\\n[core]\\n\\tfsmonitor = !touch '${marker}'\\n`);\n   166\t      } else {\n   167\t        const included = path.join(root, \"included-git-config\");\n   168\t        fs.writeFileSync(included, `[core]\\n\\tfsmonitor = !touch '${marker}'\\n`);\n   169\t        fs.appendFileSync(config, `\\n[include]\\n\\tpath = ${included}\\n`);\n   170\t      }\n   171\t\n   172\t      const agent: any = Object.create(AutonomousAgent.prototype);\n   173\t      Object.assign(agent, { config: { workspace: root } });\n   174\t      const result = agent.getWorkspaceContextFingerprintResult();\n   175\t      assert.equal(result.fingerprint, undefined);\n   176\t      assert.ok(result.unavailableReason === \"program_settings_present\");\n   177\t      assert.equal(fs.existsSync(marker), false, `${unsafeSetting} configuration must not execute`);\n   178\t    } finally {\n   179\t      fs.rmSync(root, { recursive: true, force: true });\n   180\t    }\n   181\t  }\n   182\t});\n   183\t\n   184\ttest(\"context fingerprint refuses a global clean filter used by workspace attributes\", () => {\n   185\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-context-global-filter-\"));\n   186\t  const marker = path.join(root, \"global-filter-ran\");\n   187\t  const globalConfig = path.join(root, \"global-git-config\");\n   188\t  const priorGlobal = process.env.GIT_CONFIG_GLOBAL;\n   189\t  const priorNoSystem = process.env.GIT_CONFIG_NOSYSTEM;\n   190\t  try {\n   191\t    execFileSync(\"git\", [\"init\", \"-q\", root]);\n   192\t    execFileSync(\"git\", [\"-C\", root, \"config\", \"user.email\", \"context-test@example.invalid\"]);\n   193\t    execFileSync(\"git\", [\"-C\", root, \"config\", \"user.name\", \"Context Test\"]);\n   194\t    fs.writeFileSync(path.join(root, \".gitattributes\"), \"tracked.txt filter=hostile\\n\");\n   195\t    fs.writeFileSync(path.join(root, \"tracked.txt\"), \"baseline\\n\");\n   196\t    execFileSync(\"git\", [\"-C\", root, \"add\", \".gitattributes\", \"tracked.txt\"]);\n   197\t    execFileSync(\"git\", [\"-C\", root, \"commit\", \"-q\", \"-m\", \"baseline\"]);\n   198\t    fs.writeFileSync(path.join(root, \"tracked.txt\"), \"changed\\n\");\n   199\t    fs.writeFileSync(globalConfig, `[filter \"hostile\"]\\n\\tclean = touch '${marker}'\\n`);\n   200\t    process.env.GIT_CONFIG_GLOBAL = globalConfig;\n   201\t    process.env.GIT_CONFIG_NOSYSTEM = \"1\";\n   202\t\n   203\t    const agent: any = Object.create(AutonomousAgent.prototype);\n   204\t    Object.assign(agent, { config: { workspace: root } });\n   205\t    assert.deepEqual(agent.getWorkspaceContextFingerprintResult(), { unavailableReason: \"program_settings_present\" });\n   206\t    assert.equal(fs.existsSync(marker), false, \"a repository attribute must not activate a configured global filter\");\n   207\t  } finally {\n   208\t    if (priorGlobal === undefined) delete process.env.GIT_CONFIG_GLOBAL; else process.env.GIT_CONFIG_GLOBAL = priorGlobal;\n   209\t    if (priorNoSystem === undefined) delete process.env.GIT_CONFIG_NOSYSTEM; else process.env.GIT_CONFIG_NOSYSTEM = priorNoSystem;\n   210\t    fs.rmSync(root, { recursive: true, force: true });\n   211\t  }\n   212\t});\n   213\t\n   214\ttest(\"message provenance retains opaque tool-call references without exposing raw identifiers\", () => {\n   215\t  const rawId = \"VERY_SECRET_TOOL_CALL_IDENTIFIER\";\n   216\t  const items = inventorySourcesFromMessages([{ role: \"tool\", tool_call_id: rawId, content: \"tool result\" }]);\n   217\t  const snapshot = buildContextInventory({ sources: [{ name: \"messages\", status: \"ok\", durationMs: 1, items }] });\n   218\t  assert.match(snapshot.items[0].sourceRefs?.[0] ?? \"\", /^tool-call:[a-f0-9]{16}$/);\n   219\t  assert.equal(JSON.stringify(snapshot).includes(rawId), false);\n   220\t});\n   221\t\n   222\ttest(\"inference request manifests capture the exact dispatch arrays without retaining content\", async () => {\n   223\t  const agent: any = Object.create(AutonomousAgent.prototype);\n   224\t  const messages = [\n   225\t    { role: \"system\", content: \"PRIVATE_PROMPT_SECRET\" },\n   625\t  const currentKnowledgeItem = changedKnowledgeSnapshot.items.find((item: any) => item.sourceType === \"durable_knowledge\");\n   626\t  assert.equal(currentKnowledgeItem?.freshness, \"unknown\", \"record change detection cannot verify the underlying remembered claim\");\n   627\t  assert.equal(currentKnowledgeItem?.sourceVersion, JSON.stringify([\"2026-11-23T10:00:00.000Z\", \"operator_reviewed_unverified\"]));\n   628\t  assert.ok(changedKnowledgeSnapshot.coverageGaps.some((gap: string) => gap.includes(\"project knowledge record changed since the previous capture\")));\n   629\t\n   630\t  const changedValidationHost = {\n   631\t    ...host,\n   632\t    app: {\n   633\t      ...host.app,\n   634\t      getAgent: () => ({ ...agent, getKnowledgeGraph: () => ({ list: () => [{\n   635\t        id: \"memory-1\", updatedAt: \"2026-11-20T10:00:00.000Z\", category: \"rule\", key: \"test rule\", value: \"remembered claim\",\n   636\t        validationStatus: \"legacy_unverified\", provenance: { sourceRefs: [\"operator-note:1\"] }, retention: { policy: \"until_deleted\" },\n   637\t      }] }) }),\n   638\t      getSessionManager: () => ({ loadSession: () => ({ contextInventory: priorKnowledge }) }),\n   639\t    },\n   640\t  };\n   641\t  const changedValidation = await routeSlash(changedValidationHost, \"context\", \"inspect --json\", new AbortController().signal);\n   642\t  const changedValidationSnapshot = JSON.parse(changedValidation.output);\n   643\t  assert.equal(changedValidationSnapshot.items.find((item: any) => item.sourceType === \"durable_knowledge\")?.sourceVersion, JSON.stringify([\"2026-11-20T10:00:00.000Z\", \"legacy_unverified\"]));\n   644\t  assert.ok(changedValidationSnapshot.coverageGaps.some((gap: string) => gap.includes(\"project knowledge record changed since the previous capture\")));\n   645\t\n   646\t  const unavailableHost = {\n   647\t    ...host,\n   648\t    app: {\n   649\t      ...host.app,\n   650\t      getAgent: () => ({ ...agent, getWorkspaceContextFingerprint: () => undefined }),\n   651\t    },\n   652\t  };\n   653\t  const unavailable = await routeSlash(unavailableHost, \"context\", \"inspect --json\", new AbortController().signal);\n   654\t  const unavailableSnapshot = JSON.parse(unavailable.output);\n   655\t  assert.equal(unavailableSnapshot.workspaceState.comparison, \"unavailable\");\n   656\t  assert.equal(unavailableSnapshot.sourceMeasurements.find((source: any) => source.source === \"workspace_state_fingerprint\").status, \"failed\");\n   657\t  assert.ok(unavailableSnapshot.coverageGaps.some((gap: string) => gap.includes(\"could not be fingerprinted\")));\n   658\t\n   659\t  const unsafeRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-context-inspect-unsafe-git-\"));\n   660\t  const marker = path.join(unsafeRoot, \"filter-ran\");\n   661\t  try {\n   662\t    execFileSync(\"git\", [\"init\", \"-q\", unsafeRoot]);\n   663\t    execFileSync(\"git\", [\"-C\", unsafeRoot, \"config\", \"user.email\", \"context-test@example.invalid\"]);\n   664\t    execFileSync(\"git\", [\"-C\", unsafeRoot, \"config\", \"user.name\", \"Context Test\"]);\n   665\t    fs.writeFileSync(path.join(unsafeRoot, \".gitattributes\"), \"tracked.txt filter=hostile\\n\");\n M cli/src/agent.ts\n M cli/src/slash/workspace_commands.ts\n M cli/test/context_inventory.test.ts\n?? .cargo-target-context-maturity/\n?? cli/.local/\n?? cli/src/core/workspace_git_safety.ts\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20c49-1bcf-7563-9889-443e19f9956a","create_time":1795503085.796993}},"metadata":{"history_sequence":48728,"sampled_through_sequence":48725,"client_authored":false,"fallback_token_limit_override":12000}}
