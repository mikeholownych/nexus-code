{"timestamp":"2026-11-24T06:41:50.495Z","ordinal":108058,"type":"token_usage_record","payload":{"thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20c49-1bcf-7563-9889-443e19f9956a","session_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","root_turn_id":"01a20c49-1bcf-7563-9889-443e19f9956a","response_id":"resp_0f4fd85789ec756b016b0531a589f887d2b409a438b125e42b","usage":{"input_tokens":67610,"cached_input_tokens":65024,"cache_write_input_tokens":0,"output_tokens":438,"reasoning_output_tokens":235,"total_tokens":68048},"turn_token_usage":{"input_tokens":379067,"cached_input_tokens":349312,"cache_write_input_tokens":0,"output_tokens":2650,"reasoning_output_tokens":935,"total_tokens":381717},"thread_token_usage":{"input_tokens":2321573517,"cached_input_tokens":2303332480,"cache_write_input_tokens":0,"output_tokens":3800727,"reasoning_output_tokens":1826329,"total_tokens":2325374244}}}
{"timestamp":"2026-11-24T06:41:51.522Z","ordinal":108059,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20c49-1bcf-7563-9889-443e19f9956a","item":{"type":"CommandExecution","id":"exec-4882cc9b-3302-4fd1-97ec-ddc306423812","process_id":"96780","command":["/usr/bin/zsh","-lc","sed -n '220,325p' cli/src/slash/workspace_commands.ts; sed -n '1,140p' cli/src/core/candidate.ts; rg -n \"function verifyCheckout|verifyCheckout\\(\" cli/src/core/candidate.ts; rg -n \"SUITE\" .git/nexus-claims/SUITE* -g owner.json 2>/dev/null | head; tail -15 .git/nexus-claims.log"],"cwd":"file:///home/mike/nexus-wt/context-maturity-v130","parsed_cmd":[{"type":"unknown","cmd":"sed -n '220,325p' cli/src/slash/workspace_commands.ts; sed -n '1,140p' cli/src/core/candidate.ts; rg -n \"function verifyCheckout|verifyCheckout\\(\" cli/src/core/candidate.ts; rg -n \"SUITE\" .git/nexus-claims/SUITE* -g owner.json 2>/dev/null | head; tail -15 .git/nexus-claims.log"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"      (command) => bridge.executeTool(\"run_command\", { command, timeout_secs: timeoutSecs }),\n      testCommand,\n    );\n  } finally {\n    bridge.setTurnSignal(undefined);\n  }\n  const lines = [`$ ${result.command}`, result.success ? \"Test suite passed.\" : \"Test suite failed.\"];\n  if (!result.success && result.failures.length) lines.push(\"\", \"Failing tests:\", ...result.failures.slice(0, 10).map((f) => `  • ${f}`));\n  if (!result.success && result.diagnostics.length) {\n    lines.push(\"\", \"Diagnostics:\", ...result.diagnostics.slice(0, 5).map((d) => `  • [${d.severity.toUpperCase()}] ${d.file || \"unknown\"}:${d.line || \"?\"} ${d.message}`));\n  }\n  return reply(\"test\", lines.join(\"\\n\"), result.success);\n}\n\nfunction lastAssistant(ctx: SlashContext): string {\n  const messages = ctx.host.app.getAgent().getMessages();\n  for (let i = messages.length - 1; i >= 0; i--) {\n    const content = messages[i].content;\n    if (messages[i].role === \"assistant\" && content) return typeof content === \"string\" ? content : JSON.stringify(content);\n  }\n  return \"\";\n}\n\n/** The sanitised form of a copy, or nothing when the sanitiser failed (it returns a placeholder then). */\nexport function sanitizeForTerminal(text: string): string {\n  const safe = formatSafeSidecarText(text);\n  return safe === SANITIZATION_FAILED ? \"\" : safe;\n}\n\nfunction copy(ctx: SlashContext): SlashOutcome {\n  const what = ctx.args.trim().toLowerCase() || \"last\";\n  let text: string;\n  let label: string;\n  if (what === \"diff\") {\n    const cwd = workspace(ctx);\n    { const info = getGitInfo(cwd); if (!info.isRepo) return reply(\"copy\", info.refusal ?? NOT_A_REPO, false); }\n    text = git(cwd, [\"diff\"]);\n    if (!text.trim()) return reply(\"copy\", \"No uncommitted changes to copy.\", false);\n    label = `the git diff (${text.split(\"\\n\").length} lines)`;\n  } else {\n    const last = lastAssistant(ctx);\n    if (!last) return reply(\"copy\", \"No assistant reply to copy yet.\", false);\n    const blocks = what === \"code\" ? [...last.matchAll(/```[a-zA-Z0-9_-]*\\n([\\s\\S]*?)```/g)].map((m) => m[1].trimEnd()) : [];\n    text = blocks.length ? blocks.join(\"\\n\\n// ────────────────────────────\\n\\n\") : last;\n    label = blocks.length ? `${blocks.length} code block(s)` : `the last reply (${last.length} chars)`;\n  }\n  const result = copyWithFallback(text, process.env, sanitizeForTerminal);\n  if (!result.success) return reply(\"copy\", `Clipboard error: ${result.error}`, false);\n  if (result.osc52 !== undefined) {\n    return reply(\n      \"copy\",\n      `No clipboard tool was found, so Nexus asked your terminal to copy ${label} (OSC 52, ${Buffer.byteLength(result.osc52, \"utf8\")} bytes). ` +\n        \"Nexus cannot confirm it: if nothing arrived, the terminal ignores OSC 52 (tmux needs `set -g set-clipboard on`; GNU screen is not supported). \" +\n        \"Credential-looking text and control characters in it are replaced, as in /paste. NEXUS_OSC52=off turns this fallback off.\",\n      true,\n      { clipboard: result.osc52 },\n    );\n  }\n  return reply(\"copy\", `Copied ${label} to the clipboard.`);\n}\n\nfunction paste(): SlashOutcome {\n  const result = readFromClipboard();\n  if (!result.success || !result.text) return reply(\"paste\", `Clipboard error: ${result.error || \"the clipboard is empty\"}`, false);\n  if (result.text.length > MAX_PASTE) return reply(\"paste\", `The clipboard holds ${result.text.length} characters; /paste takes at most ${MAX_PASTE}.`, false);\n  return reply(\"paste\", `Pasted ${result.text.length} characters into the composer.`, true, { composer: result.text });\n}\n\nconst DEFAULT_CONTEXT_BUDGET_MS = 2_000;\nconst MAX_CONTEXT_BUDGET_MS = 30_000;\nconst MAX_CONTEXT_ITEMS = 500;\n\nasync function context({ host, args, signal }: SlashContext): Promise<SlashOutcome> {\n  const [view, ...tokens] = args.trim().split(/\\s+/).filter(Boolean);\n  const usage = \"Usage: /context inspect [--json] [--record] [--budget-ms <1..30000>] [--max-items <1..500>] | /context maturity [--json] [--budget-ms <1..30000>] [--max-items <1..500>]\";\n  if (!view || ![\"inspect\", \"maturity\"].includes(view)) return reply(\"context\", usage, false);\n  let json = false;\n  let record = false;\n  let budgetMs = DEFAULT_CONTEXT_BUDGET_MS;\n  let maxItems = MAX_CONTEXT_ITEMS;\n  const seen = new Set<string>();\n  for (let index = 0; index < tokens.length; index++) {\n    const token = tokens[index];\n    if (seen.has(token)) return reply(\"context\", `Duplicate option: ${token}. ${usage}`, false);\n    seen.add(token);\n    if (token === \"--json\") { json = true; continue; }\n    if (token === \"--record\" && view === \"inspect\") { record = true; continue; }\n    if (token === \"--budget-ms\" || token === \"--max-items\") {\n      const value = tokens[++index];\n      if (!value || !/^[1-9]\\d*$/.test(value)) return reply(\"context\", `Invalid value for ${token}. ${usage}`, false);\n      const parsed = Number(value);\n      const upper = token === \"--budget-ms\" ? MAX_CONTEXT_BUDGET_MS : MAX_CONTEXT_ITEMS;\n      if (!Number.isSafeInteger(parsed) || parsed > upper) return reply(\"context\", `Value for ${token} must be between 1 and ${upper}.`, false);\n      if (token === \"--budget-ms\") budgetMs = parsed;\n      else maxItems = parsed;\n      continue;\n    }\n    return reply(\"context\", `Invalid option: ${token}. ${usage}`, false);\n  }\n  if (signal.aborted) return reply(\"context\", \"Context inspection was cancelled.\", false);\n\n  const agent = host.app.getAgent();\n  const config = host.app.getConfig();\n  const sessionManager = host.app.getSessionManager();\n  const assemblyStarted = performance.now();\n  const savedSession = sessionManager.loadSession(host.sessionId());\n/**\n * Candidate Identity, Validation Authority & Receipt Management\n * Nexus Issue #12 — WP-04 (INC-05, DEC-02, CAND-001..004, EVID-002, VER-001..005)\n */\n\nimport * as crypto from \"node:crypto\";\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\nimport { verifyCheckout } from \"./checkout_trust.js\";\nimport { CandidateMutationEvent, CandidateMutationHook } from \"./spine.js\";\nimport { TOOLCHAIN_PREFIX, UNVERIFIED_UNTRUSTED, defaultVersionProbe, type VersionProbe } from \"../material_deps.js\";\n\nexport type CandidateFileStatus = \"modified\" | \"added\" | \"deleted\" | \"untracked\" | \"typechange\";\n\nexport interface FileCandidateEntry {\n  path: string; // Relative POSIX path\n  mode: string; // \"100644\" | \"100755\" | \"120000\" | \"000000\"\n  contentHash: string; // SHA-256 hex\n  size: number;\n  status: CandidateFileStatus;\n}\n\nexport interface MaterialValidationDependency {\n  name: string;\n  path?: string; // Relative or absolute path to config/lockfile/toolchain\n  versionOrHash: string; // SHA-256 content hash or explicit version string\n}\n\nexport interface EvaluatorBinding {\n  evaluatorId: string;\n  evaluatorType: string;\n  evaluatorVersion?: string;\n  testSuite?: string;\n  instanceId?: string;\n  metadata?: Record<string, any>;\n}\n\nexport interface CandidateIdentity {\n  candidateId: string; // SHA-256 composite digest of rootBaseSha + canonical manifest\n  workspacePath: string;\n  rootBaseSha: string;\n  trackedChanges: FileCandidateEntry[];\n  untrackedFiles: FileCandidateEntry[];\n  manifestHash: string;\n  isGit: boolean;\n  timestamp: string;\n}\n\nexport interface ValidationReceipt {\n  receiptId: string;\n  candidateId: string; // Bound to exact candidateId\n  verifierCommand: string;\n  exitCode: number;\n  stdoutHash: string;\n  timestamp: string;\n  status: \"PASSED\" | \"FAILED\" | \"INVALIDATED\";\n  evaluatorBinding?: EvaluatorBinding;\n  materialDependencies: MaterialValidationDependency[];\n  invalidationReason?: string;\n  invalidatedAt?: string;\n  evidence?: Record<string, any>;\n}\n\nexport interface CandidateComputeOptions {\n  baseRef?: string;\n  includeUntracked?: boolean;\n  ignoredPatterns?: string[];\n  materialDependencies?: MaterialValidationDependency[];\n  /** Reads the current version of a toolchain dependency (default: node, the installed typescript, rustc). */\n  versionProbe?: VersionProbe;\n  /** Optional stricter manifest bound; values above the hard limit are clamped. */\n  maxEntries?: number;\n  /** Optional stricter byte bound; values above the hard limit are clamped. */\n  maxTotalBytes?: number;\n}\n\nconst MAX_CANDIDATE_ENTRIES = 100_000;\nconst MAX_CANDIDATE_FILE_BYTES = 256 * 1024 * 1024;\nconst MAX_CANDIDATE_TOTAL_BYTES = 1024 * 1024 * 1024;\nconst MAX_CANDIDATE_DIRECTORY_DEPTH = 128;\n\nfunction configuredEntryLimit(options: CandidateComputeOptions): number {\n  const configured = options.maxEntries;\n  if (configured === undefined) return MAX_CANDIDATE_ENTRIES;\n  if (!Number.isSafeInteger(configured) || configured < 1) {\n    throw new Error(\"Candidate maxEntries must be a positive safe integer\");\n  }\n  return Math.min(configured, MAX_CANDIDATE_ENTRIES);\n}\n\nfunction configuredByteLimit(options: CandidateComputeOptions): number {\n  const configured = options.maxTotalBytes;\n  if (configured === undefined) return MAX_CANDIDATE_TOTAL_BYTES;\n  if (!Number.isSafeInteger(configured) || configured < 1) {\n    throw new Error(\"Candidate maxTotalBytes must be a positive safe integer\");\n  }\n  return Math.min(configured, MAX_CANDIDATE_TOTAL_BYTES);\n}\n\nfunction procFdPath(fd: number, childName?: string, filesystem: typeof fs = fs): string {\n  if (process.platform !== \"linux\" || !filesystem.existsSync(\"/proc/self/fd\")) {\n    throw new Error(\"Platform cannot enforce descriptor-relative candidate traversal\");\n  }\n  return childName === undefined ? `/proc/self/fd/${fd}` : `/proc/self/fd/${fd}/${childName}`;\n}\n\nexport function openCandidateDirectory(\n  fullPath: string,\n  parentFd?: number,\n  childName?: string,\n  filesystem: typeof fs = fs,\n): { fd: number; dir: fs.Dir } {\n  const directoryFlag = filesystem.constants.O_DIRECTORY;\n  const noFollow = filesystem.constants.O_NOFOLLOW;\n  const nonBlocking = filesystem.constants.O_NONBLOCK;\n  if (typeof directoryFlag !== \"number\" || typeof noFollow !== \"number\" || typeof nonBlocking !== \"number\") {\n    throw new Error(\"Platform cannot enforce no-follow candidate directory traversal\");\n  }\n  if (parentFd !== undefined && childName === undefined) {\n    throw new Error(\"Descriptor-relative candidate directory requires a child name\");\n  }\n  const target = parentFd === undefined ? filesystem.realpathSync(fullPath) : procFdPath(parentFd, childName, filesystem);\n  const before = filesystem.lstatSync(target, { bigint: true });\n  if (!before.isDirectory()) throw new Error(`Candidate directory changed or is not a directory: ${fullPath}`);\n  const fd = filesystem.openSync(target, filesystem.constants.O_RDONLY | directoryFlag | noFollow | nonBlocking);\n  try {\n    const opened = filesystem.fstatSync(fd, { bigint: true });\n    if (!opened.isDirectory() || opened.dev !== before.dev || opened.ino !== before.ino) {\n      throw new Error(`Candidate directory changed while opening: ${fullPath}`);\n    }\n    const dir = filesystem.opendirSync(procFdPath(fd, undefined, filesystem), { bufferSize: 32 });\n    return { fd, dir };\n  } catch (error) {\n    filesystem.closeSync(fd);\n    throw error;\n  }\n}\n\nexport function openCandidatePathParent(\n483:  const untrusted = verifyCheckout(workspacePath).reason;\nzsh:1: no matches found: .git/nexus-claims/SUITE*\ntail: cannot open '.git/nexus-claims.log' for reading: Not a directory\n","exit_code":1,"duration":{"secs":0,"nanos":777748994}},"started_at_ms":1795502510743,"completed_at_ms":1795502511521}}
{"timestamp":"2026-11-24T06:41:51.663Z","ordinal":108060,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a20c4a-162f-78c2-bc15-5f6ccddd64ea","call_id":"call_0a906849e3e94d8c9b5f50bf213d8549","output":[{"type":"input_text","text":"Script completed\nWall time 1.1 seconds\nOutput:\n"},{"type":"input_text","text":"      (command) => bridge.executeTool(\"run_command\", { command, timeout_secs: timeoutSecs }),\n      testCommand,\n    );\n  } finally {\n    bridge.setTurnSignal(undefined);\n  }\n  const lines = [`$ ${result.command}`, result.success ? \"Test suite passed.\" : \"Test suite failed.\"];\n  if (!result.success && result.failures.length) lines.push(\"\", \"Failing tests:\", ...result.failures.slice(0, 10).map((f) => `  • ${f}`));\n  if (!result.success && result.diagnostics.length) {\n    lines.push(\"\", \"Diagnostics:\", ...result.diagnostics.slice(0, 5).map((d) => `  • [${d.severity.toUpperCase()}] ${d.file || \"unknown\"}:${d.line || \"?\"} ${d.message}`));\n  }\n  return reply(\"test\", lines.join(\"\\n\"), result.success);\n}\n\nfunction lastAssistant(ctx: SlashContext): string {\n  const messages = ctx.host.app.getAgent().getMessages();\n  for (let i = messages.length - 1; i >= 0; i--) {\n    const content = messages[i].content;\n    if (messages[i].role === \"assistant\" && content) return typeof content === \"string\" ? content : JSON.stringify(content);\n  }\n  return \"\";\n}\n\n/** The sanitised form of a copy, or nothing when the sanitiser failed (it returns a placeholder then). */\nexport function sanitizeForTerminal(text: string): string {\n  const safe = formatSafeSidecarText(text);\n  return safe === SANITIZATION_FAILED ? \"\" : safe;\n}\n\nfunction copy(ctx: SlashContext): SlashOutcome {\n  const what = ctx.args.trim().toLowerCase() || \"last\";\n  let text: string;\n  let label: string;\n  if (what === \"diff\") {\n    const cwd = workspace(ctx);\n    { const info = getGitInfo(cwd); if (!info.isRepo) return reply(\"copy\", info.refusal ?? NOT_A_REPO, false); }\n    text = git(cwd, [\"diff\"]);\n    if (!text.trim()) return reply(\"copy\", \"No uncommitted changes to copy.\", false);\n    label = `the git diff (${text.split(\"\\n\").length} lines)`;\n  } else {\n    const last = lastAssistant(ctx);\n    if (!last) return reply(\"copy\", \"No assistant reply to copy yet.\", false);\n    const blocks = what === \"code\" ? [...last.matchAll(/```[a-zA-Z0-9_-]*\\n([\\s\\S]*?)```/g)].map((m) => m[1].trimEnd()) : [];\n    text = blocks.length ? blocks.join(\"\\n\\n// ────────────────────────────\\n\\n\") : last;\n    label = blocks.length ? `${blocks.length} code block(s)` : `the last reply (${last.length} chars)`;\n  }\n  const result = copyWithFallback(text, process.env, sanitizeForTerminal);\n  if (!result.success) return reply(\"copy\", `Clipboard error: ${result.error}`, false);\n  if (result.osc52 !== undefined) {\n    return reply(\n      \"copy\",\n      `No clipboard tool was found, so Nexus asked your terminal to copy ${label} (OSC 52, ${Buffer.byteLength(result.osc52, \"utf8\")} bytes). ` +\n        \"Nexus cannot confirm it: if nothing arrived, the terminal ignores OSC 52 (tmux needs `set -g set-clipboard on`; GNU screen is not supported). \" +\n        \"Credential-looking text and control characters in it are replaced, as in /paste. NEXUS_OSC52=off turns this fallback off.\",\n      true,\n      { clipboard: result.osc52 },\n    );\n  }\n  return reply(\"copy\", `Copied ${label} to the clipboard.`);\n}\n\nfunction paste(): SlashOutcome {\n  const result = readFromClipboard();\n  if (!result.success || !result.text) return reply(\"paste\", `Clipboard error: ${result.error || \"the clipboard is empty\"}`, false);\n  if (result.text.length > MAX_PASTE) return reply(\"paste\", `The clipboard holds ${result.text.length} characters; /paste takes at most ${MAX_PASTE}.`, false);\n  return reply(\"paste\", `Pasted ${result.text.length} characters into the composer.`, true, { composer: result.text });\n}\n\nconst DEFAULT_CONTEXT_BUDGET_MS = 2_000;\nconst MAX_CONTEXT_BUDGET_MS = 30_000;\nconst MAX_CONTEXT_ITEMS = 500;\n\nasync function context({ host, args, signal }: SlashContext): Promise<SlashOutcome> {\n  const [view, ...tokens] = args.trim().split(/\\s+/).filter(Boolean);\n  const usage = \"Usage: /context inspect [--json] [--record] [--budget-ms <1..30000>] [--max-items <1..500>] | /context maturity [--json] [--budget-ms <1..30000>] [--max-items <1..500>]\";\n  if (!view || ![\"inspect\", \"maturity\"].includes(view)) return reply(\"context\", usage, false);\n  let json = false;\n  let record = false;\n  let budgetMs = DEFAULT_CONTEXT_BUDGET_MS;\n  let maxItems = MAX_CONTEXT_ITEMS;\n  const seen = new Set<string>();\n  for (let index = 0; index < tokens.length; index++) {\n    const token = tokens[index];\n    if (seen.has(token)) return reply(\"context\", `Duplicate option: ${token}. ${usage}`, false);\n    seen.add(token);\n    if (token === \"--json\") { json = true; continue; }\n    if (token === \"--record\" && view === \"inspect\") { record = true; continue; }\n    if (token === \"--budget-ms\" || token === \"--max-items\") {\n      const value = tokens[++index];\n      if (!value || !/^[1-9]\\d*$/.test(value)) return reply(\"context\", `Invalid value for ${token}. ${usage}`, false);\n      const parsed = Number(value);\n      const upper = token === \"--budget-ms\" ? MAX_CONTEXT_BUDGET_MS : MAX_CONTEXT_ITEMS;\n      if (!Number.isSafeInteger(parsed) || parsed > upper) return reply(\"context\", `Value for ${token} must be between 1 and ${upper}.`, false);\n      if (token === \"--budget-ms\") budgetMs = parsed;\n      else maxItems = parsed;\n      continue;\n    }\n    return reply(\"context\", `Invalid option: ${token}. ${usage}`, false);\n  }\n  if (signal.aborted) return reply(\"context\", \"Context inspection was cancelled.\", false);\n\n  const agent = host.app.getAgent();\n  const config = host.app.getConfig();\n  const sessionManager = host.app.getSessionManager();\n  const assemblyStarted = performance.now();\n  const savedSession = sessionManager.loadSession(host.sessionId());\n/**\n * Candidate Identity, Validation Authority & Receipt Management\n * Nexus Issue #12 — WP-04 (INC-05, DEC-02, CAND-001..004, EVID-002, VER-001..005)\n */\n\nimport * as crypto from \"node:crypto\";\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\nimport { verifyCheckout } from \"./checkout_trust.js\";\nimport { CandidateMutationEvent, CandidateMutationHook } from \"./spine.js\";\nimport { TOOLCHAIN_PREFIX, UNVERIFIED_UNTRUSTED, defaultVersionProbe, type VersionProbe } from \"../material_deps.js\";\n\nexport type CandidateFileStatus = \"modified\" | \"added\" | \"deleted\" | \"untracked\" | \"typechange\";\n\nexport interface FileCandidateEntry {\n  path: string; // Relative POSIX path\n  mode: string; // \"100644\" | \"100755\" | \"120000\" | \"000000\"\n  contentHash: string; // SHA-256 hex\n  size: number;\n  status: CandidateFileStatus;\n}\n\nexport interface MaterialValidationDependency {\n  name: string;\n  path?: string; // Relative or absolute path to config/lockfile/toolchain\n  versionOrHash: string; // SHA-256 content hash or explicit version string\n}\n\nexport interface EvaluatorBinding {\n  evaluatorId: string;\n  evaluatorType: string;\n  evaluatorVersion?: string;\n  testSuite?: string;\n  instanceId?: string;\n  metadata?: Record<string, any>;\n}\n\nexport interface CandidateIdentity {\n  candidateId: string; // SHA-256 composite digest of rootBaseSha + canonical manifest\n  workspacePath: string;\n  rootBaseSha: string;\n  trackedChanges: FileCandidateEntry[];\n  untrackedFiles: FileCandidateEntry[];\n  manifestHash: string;\n  isGit: boolean;\n  timestamp: string;\n}\n\nexport interface ValidationReceipt {\n  receiptId: string;\n  candidateId: string; // Bound to exact candidateId\n  verifierCommand: string;\n  exitCode: number;\n  stdoutHash: string;\n  timestamp: string;\n  status: \"PASSED\" | \"FAILED\" | \"INVALIDATED\";\n  evaluatorBinding?: EvaluatorBinding;\n  materialDependencies: MaterialValidationDependency[];\n  invalidationReason?: string;\n  invalidatedAt?: string;\n  evidence?: Record<string, any>;\n}\n\nexport interface CandidateComputeOptions {\n  baseRef?: string;\n  includeUntracked?: boolean;\n  ignoredPatterns?: string[];\n  materialDependencies?: MaterialValidationDependency[];\n  /** Reads the current version of a toolchain dependency (default: node, the installed typescript, rustc). */\n  versionProbe?: VersionProbe;\n  /** Optional stricter manifest bound; values above the hard limit are clamped. */\n  maxEntries?: number;\n  /** Optional stricter byte bound; values above the hard limit are clamped. */\n  maxTotalBytes?: number;\n}\n\nconst MAX_CANDIDATE_ENTRIES = 100_000;\nconst MAX_CANDIDATE_FILE_BYTES = 256 * 1024 * 1024;\nconst MAX_CANDIDATE_TOTAL_BYTES = 1024 * 1024 * 1024;\nconst MAX_CANDIDATE_DIRECTORY_DEPTH = 128;\n\nfunction configuredEntryLimit(options: CandidateComputeOptions): number {\n  const configured = options.maxEntries;\n  if (configured === undefined) return MAX_CANDIDATE_ENTRIES;\n  if (!Number.isSafeInteger(configured) || configured < 1) {\n    throw new Error(\"Candidate maxEntries must be a positive safe integer\");\n  }\n  return Math.min(configured, MAX_CANDIDATE_ENTRIES);\n}\n\nfunction configuredByteLimit(options: CandidateComputeOptions): number {\n  const configured = options.maxTotalBytes;\n  if (configured === undefined) return MAX_CANDIDATE_TOTAL_BYTES;\n  if (!Number.isSafeInteger(configured) || configured < 1) {\n    throw new Error(\"Candidate maxTotalBytes must be a positive safe integer\");\n  }\n  return Math.min(configured, MAX_CANDIDATE_TOTAL_BYTES);\n}\n\nfunction procFdPath(fd: number, childName?: string, filesystem: typeof fs = fs): string {\n  if (process.platform !== \"linux\" || !filesystem.existsSync(\"/proc/self/fd\")) {\n    throw new Error(\"Platform cannot enforce descriptor-relative candidate traversal\");\n  }\n  return childName === undefined ? `/proc/self/fd/${fd}` : `/proc/self/fd/${fd}/${childName}`;\n}\n\nexport function openCandidateDirectory(\n  fullPath: string,\n  parentFd?: number,\n  childName?: string,\n  filesystem: typeof fs = fs,\n): { fd: number; dir: fs.Dir } {\n  const directoryFlag = filesystem.constants.O_DIRECTORY;\n  const noFollow = filesystem.constants.O_NOFOLLOW;\n  const nonBlocking = filesystem.constants.O_NONBLOCK;\n  if (typeof directoryFlag !== \"number\" || typeof noFollow !== \"number\" || typeof nonBlocking !== \"number\") {\n    throw new Error(\"Platform cannot enforce no-follow candidate directory traversal\");\n  }\n  if (parentFd !== undefined && childName === undefined) {\n    throw new Error(\"Descriptor-relative candidate directory requires a child name\");\n  }\n  const target = parentFd === undefined ? filesystem.realpathSync(fullPath) : procFdPath(parentFd, childName, filesystem);\n  const before = filesystem.lstatSync(target, { bigint: true });\n  if (!before.isDirectory()) throw new Error(`Candidate directory changed or is not a directory: ${fullPath}`);\n  const fd = filesystem.openSync(target, filesystem.constants.O_RDONLY | directoryFlag | noFollow | nonBlocking);\n  try {\n    const opened = filesystem.fstatSync(fd, { bigint: true });\n    if (!opened.isDirectory() || opened.dev !== before.dev || opened.ino !== before.ino) {\n      throw new Error(`Candidate directory changed while opening: ${fullPath}`);\n    }\n    const dir = filesystem.opendirSync(procFdPath(fd, undefined, filesystem), { bufferSize: 32 });\n    return { fd, dir };\n  } catch (error) {\n    filesystem.closeSync(fd);\n    throw error;\n  }\n}\n\nexport function openCandidatePathParent(\n483:  const untrusted = verifyCheckout(workspacePath).reason;\nzsh:1: no matches found: .git/nexus-claims/SUITE*\ntail: cannot open '.git/nexus-cl