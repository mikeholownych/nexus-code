{"timestamp":"2026-11-24T06:51:25.589Z","ordinal":108387,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20c49-1bcf-7563-9889-443e19f9956a","item":{"type":"CommandExecution","id":"exec-0a47fb3e-e76c-415d-b12b-4e70a120e0af","process_id":"8821","command":["/usr/bin/zsh","-lc","nl -ba cli/src/core/workspace_git_safety.ts | sed -n '1,220p'; nl -ba cli/src/agent.ts | sed -n '1870,1905p'; nl -ba cli/src/slash/workspace_commands.ts | sed -n '285,330p;420,452p'; nl -ba cli/test/context_inventory.test.ts | sed -n '125,225p;625,665p'; git status --short"],"cwd":"file:///home/mike/nexus-wt/context-maturity-v130","parsed_cmd":[{"type":"unknown","cmd":"nl -ba cli/src/core/workspace_git_safety.ts | sed -n '1,220p'; nl -ba cli/src/agent.ts | sed -n '1870,1905p'; nl -ba cli/src/slash/workspace_commands.ts | sed -n '285,330p;420,452p'; nl -ba cli/test/context_inventory.test.ts | sed -n '125,225p;625,665p'; git status --short"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"     1\timport * as fs from \"node:fs\";\n     2\timport * as path from \"node:path\";\n     3\timport { parseGitfilePointer, readSmallFile, verifyCheckout } from \"./checkout_trust.js\";\n     4\t\n     5\tconst MAX_GIT_CONFIG_BYTES = 1024 * 1024;\n     6\t\n     7\texport type WorkspaceGitSafetyReason = \"program_settings_present\" | \"configuration_unavailable\" | \"configuration_unrecognized\" | \"fingerprint_failed\";\n     8\texport type WorkspaceGitSafety =\n     9\t  | { safe: true }\n    10\t  | { safe: false; reason: Exclude<WorkspaceGitSafetyReason, \"fingerprint_failed\"> };\n    11\t\n    12\tfunction findGitDir(workspace: string): string | undefined {\n    13\t  const realWorkspace = fs.realpathSync(workspace);\n    14\t  for (let directory = realWorkspace; ; directory = path.dirname(directory)) {\n    15\t    const dotGit = path.join(directory, \".git\");\n    16\t    let stat: fs.Stats;\n    17\t    try {\n    18\t      stat = fs.lstatSync(dotGit);\n    19\t    } catch (error: any) {\n    20\t      if (error?.code !== \"ENOENT\" && error?.code !== \"ENOTDIR\") throw error;\n    21\t      if (path.dirname(directory) === directory) return undefined;\n    22\t      continue;\n    23\t    }\n    24\t    if (stat.isSymbolicLink()) throw new Error(\"Git metadata link cannot be inspected safely\");\n    25\t    if (stat.isDirectory()) return fs.realpathSync(dotGit);\n    26\t    if (!stat.isFile()) throw new Error(\"Git metadata cannot be inspected safely\");\n    27\t    const pointer = readSmallFile(dotGit, 4096);\n    28\t    const target = pointer === undefined ? undefined : parseGitfilePointer(pointer);\n    29\t    if (!target) throw new Error(\"Git worktree pointer cannot be inspected safely\");\n    30\t    return fs.realpathSync(path.resolve(directory, target));\n    31\t  }\n    32\t}\n    33\t\n    34\tfunction parseConfig(text: string): WorkspaceGitSafety {\n    35\t  let section = \"\";\n    36\t  let subsection = \"\";\n    37\t  for (const rawLine of text.split(/\\r?\\n/)) {\n    38\t    const line = rawLine.trim();\n    39\t    if (!line || line.startsWith(\"#\") || line.startsWith(\";\")) continue;\n    40\t    if (line.endsWith(\"\\\\\")) return { safe: false, reason: \"configuration_unrecognized\" };\n    41\t    const header = /^\\[\\s*([A-Za-z][A-Za-z0-9.-]*)(?:\\s+(?:\"((?:[^\"\\\\]|\\\\.)*)\"|([A-Za-z0-9.-]+)))?\\s*\\]$/.exec(line);\n    42\t    if (header) {\n    43\t      section = header[1].toLowerCase();\n    44\t      subsection = (header[2] ?? header[3] ?? \"\").toLowerCase();\n    45\t      if (section === \"include\" || section === \"includeif\") return { safe: false, reason: \"program_settings_present\" };\n    46\t      continue;\n    47\t    }\n    48\t    const entry = /^([A-Za-z][A-Za-z0-9.-]*)(?:\\s*=.*)?$/.exec(line);\n    49\t    if (!entry || !section) return { safe: false, reason: \"configuration_unrecognized\" };\n    50\t    const key = entry[1].toLowerCase();\n    51\t    const commandBearing =\n    52\t      (section === \"filter\" && [\"clean\", \"smudge\", \"process\"].includes(key)) ||\n    53\t      (section === \"core\" && [\"fsmonitor\", \"hookspath\", \"sshcommand\", \"gitproxy\"].includes(key)) ||\n    54\t      (section === \"diff\" && ((subsection === \"\" && key === \"external\") || (subsection !== \"\" && [\"command\", \"textconv\"].includes(key)))) ||\n    55\t      (section === \"credential\" && key === \"helper\") ||\n    56\t      (section === \"gpg\" && key === \"program\") ||\n    57\t      (section === \"commit\" && key === \"gpgprogram\");\n    58\t    if (commandBearing) return { safe: false, reason: \"program_settings_present\" };\n    59\t  }\n    60\t  return { safe: true };\n    61\t}\n    62\t\n    63\tfunction processGitConfigPaths(): { paths: string[]; unavailable: boolean } {\n    64\t  if (process.env.GIT_CONFIG_PARAMETERS) return { paths: [], unavailable: true };\n    65\t  const count = process.env.GIT_CONFIG_COUNT;\n    66\t  if (count !== undefined && count !== \"0\") return { paths: [], unavailable: true };\n    67\t  const paths: string[] = [];\n    68\t  if (process.env.GIT_CONFIG_NOSYSTEM !== \"1\") {\n    69\t    const system = process.env.GIT_CONFIG_SYSTEM;\n    70\t    if (system === \"\") return { paths: [], unavailable: true };\n    71\t    paths.push(system ? path.resolve(system) : path.resolve(\"/etc/gitconfig\"));\n    72\t  }\n    73\t  const global = process.env.GIT_CONFIG_GLOBAL;\n    74\t  if (global !== undefined) {\n    75\t    if (!global) return { paths: [], unavailable: true };\n    76\t    paths.push(path.resolve(global));\n    77\t  } else {\n    78\t    const home = process.env.HOME;\n    79\t    const xdg = process.env.XDG_CONFIG_HOME || (home ? path.join(home, \".config\") : undefined);\n    80\t    if (xdg) paths.push(path.join(xdg, \"git\", \"config\"));\n    81\t    if (home) paths.push(path.join(home, \".gitconfig\"));\n    82\t  }\n    83\t  return { paths, unavailable: false };\n    84\t}\n    85\t\n    86\tfunction inspectConfigFile(configPath: string): WorkspaceGitSafety {\n    87\t  if (configPath === \"/dev/null\") return { safe: true };\n    88\t  let stat: fs.Stats;\n    89\t  try {\n    90\t    stat = fs.lstatSync(configPath);\n    91\t  } catch (error: any) {\n    92\t    if (error?.code === \"ENOENT\") return { safe: true };\n    93\t    return { safe: false, reason: \"configuration_unavailable\" };\n    94\t  }\n    95\t  if (stat.isSymbolicLink() || !stat.isFile() || stat.size > MAX_GIT_CONFIG_BYTES) {\n    96\t    return { safe: false, reason: \"configuration_unavailable\" };\n    97\t  }\n    98\t  const text = readSmallFile(configPath, MAX_GIT_CONFIG_BYTES);\n    99\t  return text === undefined ? { safe: false, reason: \"configuration_unavailable\" } : parseConfig(text);\n   100\t}\n   101\t\n   102\t/**\n   103\t * A filesystem-only guard for context freshness capture. Candidate identity invokes Git commands that can honor\n   104\t * repository-local filters and other configured programs. Refuse to invoke those commands when their configuration\n   105\t * cannot be inspected or contains a program hook. This is diagnostic conservatism: it does not sandbox Git generally.\n   106\t */\n   107\texport function inspectWorkspaceGitSafety(workspace: string): WorkspaceGitSafety {\n   108\t  let gitDir: string | undefined;\n   109\t  try {\n   110\t    if (verifyCheckout(workspace).reason) return { safe: false, reason: \"configuration_unavailable\" };\n   111\t    gitDir = findGitDir(workspace);\n   112\t    if (!gitDir) return { safe: true };\n   113\t  } catch {\n   114\t    return { safe: false, reason: \"configuration_unavailable\" };\n   115\t  }\n   116\t\n   117\t  const configPaths = new Set<string>([path.join(gitDir, \"config\")]);\n   118\t  const commonPointerPath = path.join(gitDir, \"commondir\");\n   119\t  let commonPointer: string | undefined;\n   120\t  try {\n   121\t    fs.lstatSync(commonPointerPath);\n   122\t    commonPointer = readSmallFile(commonPointerPath, 4096);\n   123\t    if (commonPointer === undefined) return { safe: false, reason: \"configuration_unavailable\" };\n   124\t  } catch (error: any) {\n   125\t    if (error?.code !== \"ENOENT\") return { safe: false, reason: \"configuration_unavailable\" };\n   126\t  }\n   127\t  if (commonPointer !== undefined) {\n   128\t    const commonName = commonPointer.replace(/\\r?\\n$/, \"\");\n   129\t    if (!commonName || commonName !== commonName.trim() || /[\\0\\r\\n]/.test(commonName)) {\n   130\t      return { safe: false, reason: \"configuration_unavailable\" };\n   131\t    }\n   132\t    try {\n   133\t      const commonDir = fs.realpathSync(path.resolve(gitDir, commonName));\n   134\t      configPaths.add(path.join(commonDir, \"config\"));\n   135\t    } catch {\n   136\t      return { safe: false, reason: \"configuration_unavailable\" };\n   137\t    }\n   138\t    configPaths.add(path.join(gitDir, \"config.worktree\"));\n   139\t  }\n   140\t\n   141\t  const processConfig = processGitConfigPaths();\n   142\t  if (processConfig.unavailable) return { safe: false, reason: \"configuration_unavailable\" };\n   143\t  for (const configPath of [...processConfig.paths, ...configPaths]) {\n   144\t    const result = inspectConfigFile(configPath);\n   145\t    if (!result.safe) return result;\n   146\t  }\n   147\t  return { safe: true };\n   148\t}\n  1870\t  public getConfig(): HarnessConfig {\n  1871\t    return this.config;\n  1872\t  }\n  1873\t\n  1874\t  public getWorkspacePathIdentity(): WorkspacePath {\n  1875\t    return this.workspacePathIdentity;\n  1876\t  }\n  1877\t\n  1878\t  /** A bounded, content-free candidate identity for revalidating recorded repository context. */\n  1879\t  public getWorkspaceContextFingerprintResult(): { fingerprint?: string; unavailableReason?: WorkspaceGitSafetyReason } {\n  1880\t    const safety = inspectWorkspaceGitSafety(this.config.workspace);\n  1881\t    if (!safety.safe) return { unavailableReason: safety.reason };\n  1882\t    try {\n  1883\t      return { fingerprint: computeCandidateIdentitySync(this.config.workspace, { maxEntries: 4096, maxTotalBytes: 16 * 1024 * 1024 }).candidateId };\n  1884\t    } catch {\n  1885\t      // Unknown is safer than presenting an old repository observation as current.\n  1886\t      return { unavailableReason: \"fingerprint_failed\" };\n  1887\t    }\n  1888\t  }\n  1889\t\n  1890\t  /** Backward-compatible fingerprint accessor; callers needing an explanation use the result form. */\n  1891\t  public getWorkspaceContextFingerprint(): string | undefined {\n  1892\t    return this.getWorkspaceContextFingerprintResult().fingerprint;\n  1893\t  }\n  1894\t\n  1895\t  /** Judges, once per workspace, whether the session STARTED in a linked worktree the agent had already worked in. */\n  1896\t  private judgeReceiptBaselineOnce(): void {\n  1897\t    if (this.receiptBaselineJudged) return;\n  1898\t    this.receiptBaselineJudged = true;\n  1899\t    this.receiptBaselineUntrusted = this.linkedWorktreeStartsDirty();\n  1900\t  }\n  1901\t\n  1902\t  /**\n  1903\t   * Whether the workspace is a linked worktree that either holds uncommitted work or cannot be certified (a nested\n  1904\t   * repository, a hidden edit, a dirty submodule). Fails closed there; a plain checkout or a non-repository is \"no\".\n  1905\t   */\n   285\t  return reply(\"paste\", `Pasted ${result.text.length} characters into the composer.`, true, { composer: result.text });\n   286\t}\n   287\t\n   288\tconst DEFAULT_CONTEXT_BUDGET_MS = 2_000;\n   289\tconst MAX_CONTEXT_BUDGET_MS = 30_000;\n   290\tconst MAX_CONTEXT_ITEMS = 500;\n   291\t\n   292\tclass ContextSourceReadFailure extends Error {\n   293\t  constructor(readonly safeDetail: string) { super(safeDetail); }\n   294\t}\n   295\t\n   296\tfunction fingerprintUnavailableDetail(reason: string | undefined): string {\n   297\t  switch (reason) {\n   298\t    case \"program_settings_present\": return \"repository Git configuration contains program settings; fingerprinting was refused and freshness is unknown\";\n   299\t    case \"configuration_unrecognized\": return \"repository Git configuration could not be safely interpreted; fingerprinting was refused and freshness is unknown\";\n   300\t    case \"configuration_unavailable\": return \"repository Git configuration could not be inspected safely; fingerprinting was refused and freshness is unknown\";\n   301\t    case \"fingerprint_failed\": return \"workspace fingerprint computation failed; freshness is unknown\";\n   302\t    default: return \"workspace fingerprint API is unavailable; freshness is unknown\";\n   303\t  }\n   304\t}\n   305\t\n   306\tasync function context({ host, args, signal }: SlashContext): Promise<SlashOutcome> {\n   307\t  const [view, ...tokens] = args.trim().split(/\\s+/).filter(Boolean);\n   308\t  const usage = \"Usage: /context inspect [--json] [--record] [--budget-ms <1..30000>] [--max-items <1..500>] | /context maturity [--json] [--budget-ms <1..30000>] [--max-items <1..500>]\";\n   309\t  if (!view || ![\"inspect\", \"maturity\"].includes(view)) return reply(\"context\", usage, false);\n   310\t  let json = false;\n   311\t  let record = false;\n   312\t  let budgetMs = DEFAULT_CONTEXT_BUDGET_MS;\n   313\t  let maxItems = MAX_CONTEXT_ITEMS;\n   314\t  const seen = new Set<string>();\n   315\t  for (let index = 0; index < tokens.length; index++) {\n   316\t    const token = tokens[index];\n   317\t    if (seen.has(token)) return reply(\"context\", `Duplicate option: ${token}. ${usage}`, false);\n   318\t    seen.add(token);\n   319\t    if (token === \"--json\") { json = true; continue; }\n   320\t    if (token === \"--record\" && view === \"inspect\") { record = true; continue; }\n   321\t    if (token === \"--budget-ms\" || token === \"--max-items\") {\n   322\t      const value = tokens[++index];\n   323\t      if (!value || !/^[1-9]\\d*$/.test(value)) return reply(\"context\", `Invalid value for ${token}. ${usage}`, false);\n   324\t      const parsed = Number(value);\n   325\t      const upper = token === \"--budget-ms\" ? MAX_CONTEXT_BUDGET_MS : MAX_CONTEXT_ITEMS;\n   326\t      if (!Number.isSafeInteger(parsed) || parsed > upper) return reply(\"context\", `Value for ${token} must be between 1 and ${upper}.`, false);\n   327\t      if (token === \"--budget-ms\") budgetMs = parsed;\n   328\t      else maxItems = parsed;\n   329\t      continue;\n   330\t    }\n   420\t    const messages: any = agent.getMessages();\n   421\t    const collect = (value: any[]) => inventorySourcesFromMessagesBounded(\n   422\t      promptComponentsAvailable ? value.filter((message: any, index: number) => !(index === 0 && message?.role === \"system\")) : value,\n   423\t      { maxItems: itemBudget },\n   424\t    );\n   425\t    return messages && typeof messages.then === \"function\" ? messages.then(collect) : collect(messages);\n   426\t  });\n   427\t  let workspaceFingerprint: string | undefined;\n   428\t  await measure(\"workspace_state_fingerprint\", () => {\n   429\t    if (typeof agent.getWorkspaceContextFingerprintResult === \"function\") {\n   430\t      const result = agent.getWorkspaceContextFingerprintResult();\n   431\t      workspaceFingerprint = result.fingerprint;\n   432\t      if (!workspaceFingerprint) throw new ContextSourceReadFailure(fingerprintUnavailableDetail(result.unavailableReason));\n   433\t    } else if (typeof agent.getWorkspaceContextFingerprint === \"function\") {\n   434\t      workspaceFingerprint = agent.getWorkspaceContextFingerprint();\n   435\t      if (!workspaceFingerprint) throw new ContextSourceReadFailure(fingerprintUnavailableDetail(undefined));\n   436\t    } else {\n   437\t      throw new ContextSourceReadFailure(fingerprintUnavailableDetail(undefined));\n   438\t    }\n   439\t    return [{\n   440\t      sourceType: \"workspace_state_fingerprint\",\n   441\t      sourceLocation: \"repository:candidate-identity\",\n   442\t      scope: \"repository\",\n   443\t      content: \"bounded composite candidate identity\",\n   444\t      trust: \"tool_output_unverified\",\n   445\t      retention: \"session_context_inventory\",\n   446\t      inclusionReason: \"supports equality comparison with the previous recorded workspace state; it is not evidence that repository content is correct\",\n   447\t      retrievalMethod: \"candidate_identity\",\n   448\t      freshness: \"current\",\n   449\t      freshnessRule: \"computed at capture from current candidate identity; any workspace candidate change invalidates this observation\",\n   450\t    }];\n   451\t  });\n   452\t  if (typeof agent.getInferenceContextManifests === \"function\") {\n   125\t    assert.equal(agent.getWorkspaceContextFingerprint(), before);\n   126\t    fs.writeFileSync(path.join(root, \"README.md\"), \"after\\n\");\n   127\t    assert.notEqual(agent.getWorkspaceContextFingerprint(), before);\n   128\t  } finally {\n   129\t    fs.rmSync(root, { recursive: true, force: true });\n   130\t  }\n   131\t});\n   132\t\n   133\ttest(\"context fingerprint refuses a configured clean filter without running it\", () => {\n   134\t  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-context-clean-filter-\"));\n   135\t  const marker = path.join(root, \"filter-ran\");\n   136\t  try {\n   137\t    execFileSync(\"git\", [\"init\", \"-q\", root]);\n   138\t    execFileSync(\"git\", [\"-C\", root, \"config\", \"user.email\", \"context-test@example.invalid\"]);\n   139\t    execFileSync(\"git\", [\"-C\", root, \"config\", \"user.name\", \"Context Test\"]);\n   140\t    fs.writeFileSync(path.join(root, \".gitattributes\"), \"tracked.txt filter=hostile\\n\");\n   141\t    fs.writeFileSync(path.join(root, \"tracked.txt\"), \"baseline\\n\");\n   142\t    execFileSync(\"git\", [\"-C\", root, \"add\", \".gitattributes\", \"tracked.txt\"