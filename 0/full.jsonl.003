{"timestamp":"2026-11-24T07:42:51.951Z","ordinal":109475,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1f54f-2cb2-7201-ad27-acf2d9bbd90e","turn_id":"01a20c6e-33b2-7660-a7f0-668b82778aee","item":{"type":"CommandExecution","id":"exec-6c8c7bcf-52de-48d9-a826-fc68042e8161","process_id":"51685","command":["/usr/bin/zsh","-lc","sed -n '1,250p' cli/test/durable_continuity.test.ts; sed -n '1,40p' cli/test/context_inventory.test.ts; rg -n 'durable_continuity' cli/test/context_inventory.test.ts cli/scripts/run_tests*"],"cwd":"file:///home/mike/nexus-wt/context-maturity-v130","parsed_cmd":[{"type":"unknown","cmd":"sed -n '1,250p' cli/test/durable_continuity.test.ts; sed -n '1,40p' cli/test/context_inventory.test.ts; rg -n 'durable_continuity' cli/test/context_inventory.test.ts cli/scripts/run_tests*"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"/**\n * Durable continuity of work across process death, retries and resumes (acceptance blockers V1 and V2,\n * docs/reviews/NEXUS_ACCEPTANCE_BLOCKERS_2026-10-08.md):\n *\n *   V1  a resumed unit continues its authorized task from its recorded conversation; missing or inconsistent durable\n *       history blocks the unit (only the operator can start it over) and is never read as NOT_REQUIRED.\n *   V2  workspace changes that no verifier has established stay unverified across step limits, retries, process\n *       restarts and every supported resume path, so a later attempt that changes nothing cannot complete the unit.\n *\n * Real AutonomousAgent turns against local scripted gateways; process death uses the real CLI in a child process.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport http from \"node:http\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { randomInt } from \"node:crypto\";\nimport { execSync, spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { ApplicationCore } from \"../src/core/app.js\";\nimport { newOperation, type DurableOperationState, type WorkUnitSpec } from \"../src/core/operation.js\";\nimport { AgentWorkUnitExecutor, applyOperatorDecision, driveOperation, OperationStore } from \"../src/core/operation_runner.js\";\nimport type { ResourceDescriptor } from \"../src/core/resources.js\";\nimport { DurableStateManager } from \"../src/core/state.js\";\nimport { WorkspacePath } from \"../src/core/workspace_path.js\";\nimport { SidecarServer } from \"../src/sidecar.js\";\nimport { type HarnessConfig, DEFAULT_CONTINUATION } from \"../src/types.js\";\nimport { readTaskMessages, updateTaskMessages } from \"../src/core/task_message_log.js\";\n\nconst cliRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst srcIndex = path.join(cliRoot, \"src/index.ts\");\nconst tsxLoader = import.meta.resolve(\"tsx\");\n\nfunction sourceFiles(dir: string): string[] {\n  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {\n    const file = path.join(dir, entry.name);\n    return entry.isDirectory() ? sourceFiles(file) : file.endsWith(\".ts\") ? [file] : [];\n  });\n}\n\ntest(\"all source AutonomousAgent construction sites declare durability explicitly\", () => {\n  const violations: string[] = [];\n  for (const file of sourceFiles(path.join(cliRoot, \"src\"))) {\n    const source = fs.readFileSync(file, \"utf8\");\n    let at = 0;\n    while ((at = source.indexOf(\"new AutonomousAgent(\", at)) >= 0) {\n      const start = at + \"new AutonomousAgent(\".length;\n      let depth = 1;\n      let end = start;\n      for (; end < source.length && depth > 0; end++) {\n        if (source[end] === \"(\") depth++;\n        else if (source[end] === \")\") depth--;\n      }\n      const args = source.slice(start, end - 1);\n      if (!/\\{[^{}]*\\bdurable\\s*:\\s*(?:true|false)\\b[^{}]*\\}\\s*$/s.test(args)) {\n        violations.push(`${path.relative(cliRoot, file)}:${source.slice(0, at).split(\"\\n\").length}`);\n      }\n      at = end;\n    }\n  }\n  assert.deepEqual(violations, []);\n});\n\ntest(\"AgentWorkUnitExecutor default construction persists a durable depth-1 implementer with its unit identity\", async () => {\n  await withHome(async (home) => {\n    const gw = await gateway(() => done(\"one-step unit complete\"));\n    const repo = makeRepo();\n    const stateDir = path.join(home, \".nexus\", \"tasks\");\n    const priorStateDir = process.env.NEXUS_STATE_DIR;\n    process.env.NEXUS_STATE_DIR = path.join(home, \".nexus\");\n    const config = cfg(gw, repo, { maxSteps: 1 });\n    const store = new OperationStore(repo, path.join(home, \".nexus\", \"operations\"));\n    const unit: WorkUnitSpec = { id: \"u-default\", role: \"implementer\", prompt: \"Complete this one-step work unit.\" };\n    const resource: ResourceDescriptor = { id: \"primary\", provider: gw.origin, endpoint: gw.url, model: \"m\", capabilities: [\"tools\"], rank: 0 };\n    let constructed: AutonomousAgent | undefined;\n    const originalRunTurn = AutonomousAgent.prototype.runTurn;\n    AutonomousAgent.prototype.runTurn = function (...args: Parameters<AutonomousAgent[\"runTurn\"]>) {\n      constructed = this;\n      return originalRunTurn.apply(this, args);\n    };\n    try {\n      const executor = new AgentWorkUnitExecutor({ baseConfig: config });\n      const op = await muted(() => driveOperation(newOperation(\"op-default-construction\", \"default construction\", [unit], [resource], Date.now()), { store, executor }));\n      const savedUnit = unitOf(op, unit.id);\n      assert.ok(savedUnit.agentTaskId, \"the executor bound the work-unit task id\");\n      assert.ok(fs.existsSync(path.join(stateDir, `${savedUnit.agentTaskId}.json`)), \"durable task state was persisted under ~/.nexus/tasks\");\n      assert.ok(constructed, \"the default executor constructed an agent\");\n      assert.equal(constructed!.durable, true);\n      assert.equal((constructed as any).depth, 1, \"work-unit agents are depth 1\");\n      assert.equal(constructed!.role, unit.role);\n      assert.equal(constructed!.unitId, unit.id);\n    } finally {\n      AutonomousAgent.prototype.runTurn = originalRunTurn;\n      if (priorStateDir === undefined) delete process.env.NEXUS_STATE_DIR;\n      else process.env.NEXUS_STATE_DIR = priorStateDir;\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n});\n\ntest(\"AgentWorkUnitExecutor applies durable identity when a custom factory omits constructor options\", async () => {\n  await withHome(async (home) => {\n    const gw = await gateway(() => done(\"custom-factory unit complete\"));\n    const repo = makeRepo();\n    const stateDir = path.join(home, \".nexus\", \"tasks\");\n    const priorStateDir = process.env.NEXUS_STATE_DIR;\n    process.env.NEXUS_STATE_DIR = path.join(home, \".nexus\");\n    const config = cfg(gw, repo, { maxSteps: 1 });\n    const store = new OperationStore(repo, path.join(home, \".nexus\", \"operations\"));\n    const unit: WorkUnitSpec = { id: \"u-custom-factory\", role: \"implementer\", prompt: \"Complete this one-step work unit.\" };\n    const resource: ResourceDescriptor = { id: \"primary\", provider: gw.origin, endpoint: gw.url, model: \"m\", capabilities: [\"tools\"], rank: 0 };\n    let constructed: AutonomousAgent | undefined;\n    try {\n      const executor = new AgentWorkUnitExecutor({\n        baseConfig: config,\n        createAgent: (c, depth) => {\n          // Deliberately model a legacy custom factory that ignores the executor's durability options.\n          constructed = quiet(new AutonomousAgent(c, depth));\n          return constructed;\n        },\n      });\n      const op = await muted(() => driveOperation(newOperation(\"op-custom-factory\", \"custom factory\", [unit], [resource], Date.now()), { store, executor }));\n      const savedUnit = unitOf(op, unit.id);\n      assert.ok(savedUnit.agentTaskId, \"the executor bound the work-unit task id\");\n      assert.ok(fs.existsSync(path.join(stateDir, `${savedUnit.agentTaskId}.json`)), \"the custom-factory agent persisted durable task state\");\n      assert.ok(constructed, \"the custom factory constructed an agent\");\n      assert.equal(constructed!.durable, true, \"the executor applies the durability fallback\");\n      assert.equal((constructed as any).depth, 1, \"work-unit agents are depth 1\");\n      assert.equal(constructed!.role, unit.role, \"the executor applies the work-unit role fallback\");\n      assert.equal(constructed!.unitId, unit.id, \"the executor applies the work-unit identity fallback\");\n    } finally {\n      if (priorStateDir === undefined) delete process.env.NEXUS_STATE_DIR;\n      else process.env.NEXUS_STATE_DIR = priorStateDir;\n      await gw.close();\n      fs.rmSync(repo, { recursive: true, force: true });\n    }\n  });\n});\n\ntest(\"ACC-CONT-03: pressure compaction of a work unit survives SIGKILL and restores archived markers\", async () => {\n  await withHome(async (home) => {\n    const work = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-cont-pressure-crash-\"));\n    const helper = path.join(cliRoot, \"test/helpers/compaction_crash_child.ts\");\n    const child = spawn(process.execPath, [\"--import\", tsxLoader, helper, work, \"work_unit_pressure\"], {\n      cwd: cliRoot,\n      env: { ...process.env, HOME: home },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout.on(\"data\", (chunk) => { stdout += chunk.toString(); });\n    child.stderr.on(\"data\", (chunk) => { stderr += chunk.toString(); });\n    let pressureRepo: string | undefined;\n    const exit = await new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => {\n      child.on(\"close\", (code, signal) => resolve({ code, signal }));\n    });\n    try {\n      assert.ok(exit.signal === \"SIGKILL\" || exit.code === 137, `child must die from SIGKILL; got ${JSON.stringify(exit)}\\n${stdout}\\n${stderr}`);\n      const info = JSON.parse(fs.readFileSync(path.join(work, \"info.json\"), \"utf8\")) as { taskId: string; compactionId: string; stateDir: string; repo: string; markers: string[] };\n      pressureRepo = info.repo;\n      assert.ok(info.markers.includes(\"MARKER-PRESSURE-ALPHA\"), \"the archived marker list includes the first pressure-read file\");\n      const historyPath = path.join(info.stateDir, `${info.taskId}.history.jsonl`);\n      assert.ok(fs.existsSync(historyPath), `history file ${historyPath} exists`);\n      assert.ok(fs.readFileSync(historyPath, \"utf8\").includes(info.compactionId), \"history includes the pressure compaction id\");\n\n      const resumedAgent = quiet(new AutonomousAgent({\n        endpoint: \"http://127.0.0.1:1\",\n        model: \"m\",\n        maxSteps: 2,\n        temperature: 0,\n        workspace: info.repo,\n        shell: \"bash\",\n        approvalMode: \"auto\",\n        fullAccess: true,\n        contextLimit: 18_000,\n        completionReserveTokens: 500,\n        toolResponseReserveTokens: 500,\n      }, 1, undefined, { durable: true, role: \"implementer\", unitId: \"pressure-unit\" }));\n      const resumedState = resumedAgent as any;\n      resumedState.stateManager = new DurableStateManager({ baseDir: info.stateDir, workspacePaths: [resumedState.primaryWorkspacePathIdentity] });\n      await resumedAgent.recoverFromTaskState(info.taskId);\n      for (const marker of info.markers) {\n        const result = await (resumedAgent as any).spine.execute(\n          { invocationId: `archive_${marker}`, taskId: info.taskId, actor: \"agent\", executionDomain: \"agent_orchestration\", toolName: \"read_archive\", args: { query: marker } },\n          { activeTurnSignal: undefined, observer: undefined, metadata: {} },\n        );\n        assert.equal(result.success, true, `read_archive succeeds for ${marker}`);\n        assert.ok(result.output.includes(marker), `archived originals contain ${marker}`);\n      }\n    } finally {\n      if (child.exitCode === null && child.signalCode === null) child.kill();\n      fs.rmSync(work, { recursive: true, force: true });\n      if (pressureRepo) fs.rmSync(pressureRepo, { recursive: true, force: true });\n    }\n  });\n});\n\n// ---------------------------------------------------------------- scripted gateway\n\ntype Reply = { tools: Array<{ name: string; args: unknown }> } | { text: string } | { hold: true };\ninterface Gw { url: string; origin: string; requests: any[]; held: boolean; close(): Promise<void> }\n\n/** Tool-call ids the provider issues: short ones survive persistence redaction, high-entropy ones may not. */\ntype IdStyle = \"low-entropy\" | \"high-entropy\";\nconst ID_ALPHABET = \"REDACTED\";\n/** 32 distinct characters: always above the persistence classifier's entropy threshold. */\nconst highEntropyId = () => {\n  const chars = [...ID_ALPHABET];\n  for (let i = chars.length - 1; i > 0; i--) {\n    const j = randomInt(i + 1);\n    [chars[i], chars[j]] = [chars[j], chars[i]];\n  }\n  return `call_${chars.slice(0, 32).join(\"\")}`;\n};\n\n/** OpenAI-compatible gateway (streaming and not). A `hold` reply never answers: the client waits until it is killed. */\nasync function gateway(script: (body: any) => Reply, ids: IdStyle = \"low-entropy\"): Promise<Gw> {\n  const gw: Gw = { url: \"\", origin: \"\", requests: [], held: false, close: async () => {} };\n  let n = 0;\n  const server = http.createServer((req, res) => {\n    if (req.url?.endsWith(\"/models\")) {\n      res.setHeader(\"content-type\", \"application/json\");\n      return void res.end('{\"data\":[{\"id\":\"m\"}]}');\n    }\n    let raw = \"\";\n    req.on(\"data\", (c) => (raw += c));\n    req.on(\"end\", () => {\n      let body: any = {};\n      try { body = JSON.parse(raw); } catch {}\n      gw.requests.push(body);\n      const reply = script(body);\n      if (\"hold\" in reply) {\n        gw.held = true;\n        return;\n      }\n      const calls = \"tools\" in reply\n        ? reply.tools.map((c, index) => ({ index, id: ids === \"low-entropy\" ? `call_${++n}` : highEntropyId(), type: \"function\", function: { name: c.name, arguments: JSON.stringify(c.args) } }))\n        : undefined;\n      if (!body.stream) {\n        res.setHeader(\"content-type\", \"application/json\");\n        const message = calls ? { role: \"assistant\", content: null, tool_calls: calls } : { role: \"assistant\", content: (reply as { text: string }).text };\n        return void res.end(JSON.stringify({ choices: [{ index: 0, message, finish_reason: calls ? \"tool_calls\" : \"stop\" }] }));\n      }\n      res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n      const delta = calls ? { tool_calls: calls } : { content: (reply as { text: string }).text };\n      res.end(`data: ${JSON.stringify({ choices: [{ index: 0, delta, finish_reason: calls ? \"tool_calls\" : \"stop\" }] })}\\n\\ndata: [DONE]\\n\\n`);\n    });\nimport assert from \"node:assert/strict\";\nimport { createHash } from \"node:crypto\";\nimport { execFileSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { test } from \"node:test\";\nimport {\n  assessContextMaturity,\n  buildContextInventory,\n  buildInferenceContextManifest,\n  buildSessionContextInventory,\n  compareWorkspaceState,\n  isInferenceContextManifest,\n  isContextInventorySnapshot,\n  inventorySourcesFromMessages,\n  markInterruptedInferenceManifestsUnknown,\n  markPersistedContextFreshnessUnknown,\n  mergeContextInventorySnapshots,\n} from \"../src/core/context_inventory.js\";\nimport { SessionManager } from \"../src/session.js\";\nimport { WorkspacePath } from \"../src/core/workspace_path.js\";\nimport { buildSessionExport } from \"../src/session_export.js\";\nimport { hasHandler, routeSlash } from \"../src/slash/router.js\";\nimport { SLASH_COMMANDS } from \"../src/slash/catalog.js\";\nimport { replReadOnlyAllowed } from \"../src/repl.js\";\nimport { readOnlySlashAllowed } from \"../src/sidecar.js\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { calculateContextBudget } from \"../src/tokens.js\";\nimport { inspectWorkspaceGitSafety } from \"../src/core/workspace_git_safety.js\";\n\nconst input = (sourceLocation: string, scope: \"session\" | \"repository\" = \"session\", content = \"sensitive source text\") => ({\n  sourceType: \"note\", sourceLocation, scope, content, trust: \"persisted_unverified\" as const,\n  retention: \"session\", inclusionReason: \"explicit test fixture\", retrievalMethod: \"fixture\",\n});\n\ntest(\"inventory has stable source identity, scope isolation, and omits source text\", () => {\n  const first = buildContextInventory({ capturedAt: \"2026-11-22T00:00:00.000Z\", sources: [{ name: \"notes\", status: \"ok\", durationMs: 3, items: [input(\"notes:1\")] }] });\n  const second = buildContextInventory({ capturedAt: \"2026-11-23T00:00:00.000Z\", sources: [{ name: \"notes\", status: \"ok\", durationMs: 3, items: [input(\"notes:1\")] }] });\n  const repository = buildContextInventory({ sources: [{ name: \"notes\", status: \"ok\", durationMs: 3, items: [input(\"notes:1\", \"repository\")] }] });\n","exit_code":1,"duration":{"secs":0,"nanos":789004099}},"started_at_ms":1795506171161,"completed_at_ms":1795506171950}}
{"timestamp":"2026-11-24T07:42:52.082Z","ordinal":109476,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a20c81-f0b1-7780-8138-1baee12929f4","call_id":"call_d31dbd7b2a1341538d715a32db720905","output":[{"type":"input_text","text":"Script completed\nWall time 1.1 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 3966)\nTotal output lines: 290\n\n/**\n * Durable continuity of work across process death, retries and resumes (acceptance blockers V1 and V2,\n * docs/reviews/NEXUS_ACCEPTANCE_BLOCKERS_2026-10-08.md):\n *\n *   V1  a resumed unit continues its authorized task from its recorded conversation; missing or inconsistent durable\n *       history blocks the unit (only the operator can start it over) and is never read as NOT_REQUIRED.\n *   V2  workspace changes that no verifier has established stay unverified across step limits, retries, process\n *       restarts and every supported resume path, so a later attempt that changes nothing cannot complete the unit.\n *\n * Real AutonomousAgent turns against local scripted gateways; process death uses the real CLI in a child process.\n */\nimport { test, describe } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport http from \"node:http\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { randomInt } from \"node:crypto\";\nimport { execSync, spawn } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { ApplicationCore } from \"../src/core/app.js\";\nimport { newOperation, type DurableOperationState, type WorkUnitSpec } from \"../src/core/operation.js\";\nimport { AgentWorkUnitExecutor, applyOperatorDecision, driveOperation, OperationStore } from \"../src/core/operation_runner.js\";\nimport type { ResourceDescriptor } from \"../src/core/resources.js\";\nimport { DurableStateManager } from \"../src/core/state.js\";\nimport { WorkspacePath } from \"../src/core/workspace_path.js\";\nimport { SidecarServer } from \"../src/sidecar.js\";\nimport { type HarnessConfig, DEFAULT_CONTINUATION } from \"../src/types.js\";\nimport { readTaskMessages, updateTaskMessages } from \"../src/core/task_message_log.js\";\n\nconst cliRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst srcIndex = path.join(cliRoot, \"src/index.ts\");\nconst tsxLoader = import.meta.resolve(\"tsx\");\n\nfunction sourceFiles(dir: string): string[] {\n  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {\n    const file = path.join(dir, entry.name);\n    return entry.isDirectory() ? sourceFiles(file) : file.endsWith(\".ts\") ? [file] : [];\n  });\n}\n\ntest(\"all source AutonomousAgent construction sites declare durability explicitly\", () => {\n  const violations: string[] = [];\n  for (const file of sourceFiles(path.join(cliRoot, \"src\"))) {\n    const source = fs.readFileSync(file, \"utf8\");\n    let at = 0;\n    while ((at = source.indexOf(\"new AutonomousAgent(\", at)) >= 0) {\n      const start = at + \"new AutonomousAgent(\".length;\n      let depth = 1;\n      let end = start;\n      for (; end < source.length && depth > 0; end++) {\n        if (source[end] === \"(\") depth++;\n        else if (source[end] === \")\") depth--;\n      }\n      const args = source.slice(start, end - 1);\n      if (!/\\{[^{}]*\\bdurable\\s*:\\s*(?:true|false)\\b[^{}]*\\}\\s*$/s.test(args)) {\n        violations.push(`${path.relative(cliRoot, file)}:${source.slice(0, at).split(\"\\n\").length}`);\n      }\n      at = end;\n    }\n  }\n  assert.deepEqual(violations, []);\n});\n\ntest(\"AgentWorkUnitExecutor default construction persists a durable depth-1 implementer with its unit identity\", async () => {\n  await withHome(async (home) => {\n    const gw = await gateway(() => done(\"one-step unit complete\"));\n    const repo = makeRepo();\n    const stateDir = path.join(home, \".nexus\", \"tasks\");\n    const priorStateDir = process.env.NEXUS_STATE_DIR;\n    process.env.NEXUS_STATE_DIR = path.join(home, \".nexus\");\n    const config = cfg(gw, repo, { maxSteps: 1 });\n    const store = new OperationStore(repo, path.join(home, \".nexus\", \"operations\"));\n    const unit: WorkUnitSpec = { id: \"u-default\", role: \"implementer\", prompt: \"Complete this one-step work unit.\" };\n    const resource: ResourceDescriptor = { id: \"primary\", provider: gw.origin, endpoint: gw.url, model: \"m\", capabilities: [\"tools\"], rank: 0 };\n    let constructed: AutonomousAgent | undefined;\n    const originalRunTurn = AutonomousAgent.prototype.runTurn;\n    AutonomousAgent.prototype.runTurn = function (...args: Parameters<AutonomousAgent[\"runTurn\"]>) {\n      constructed = this;\n      return originalRunTurn.apply(this, args);\n    };\n    try {\n      const executor = new AgentWorkUnitExecutor({ baseConfig: config });\n      const op = await muted(() => driveOperation(newOperation(\"op-default-construction\", \"default construction\", [unit], [resource], Date.now()), { store, executor }));\n      const savedUnit = unitOf(op, unit.id);\n      assert.ok(savedUnit.agentTaskId, \"the executor bound the work-unit task id\");\n      assert.ok(fs.existsSync(path.join(stateDir, `${savedUnit.agentTaskId}.json`)), \"durable task state was persisted under ~/.nexus/tasks\");\n      assert.ok(constructed, \"the default executor constructed an agent\");\n      assert.equal(constructed!.durable, true);\n      assert.equal((constructed as any).depth, 1, \"work-unit agents are…1466 tokens truncated…hild.signalCode === null) child.kill();\n      fs.rmSync(work, { recursive: true, force: true });\n      if (pressureRepo) fs.rmSync(pressureRepo, { recursive: true, force: true });\n    }\n  });\n});\n\n// ---------------------------------------------------------------- scripted gateway\n\ntype Reply = { tools: Array<{ name: string; args: unknown }> } | { text: string } | { hold: true };\ninterface Gw { url: string; origin: string; requests: any[]; held: boolean; close(): Promise<void> }\n\n/** Tool-call ids the provider issues: short ones survive persistence redaction, high-entropy ones may not. */\ntype IdStyle = \"low-entropy\" | \"high-entropy\";\nconst ID_ALPHABET = \"REDACTED\";\n/** 32 distinct characters: always above the persistence classifier's entropy threshold. */\nconst highEntropyId = () => {\n  const chars = [...ID_ALPHABET];\n  for (let i = chars.length - 1; i > 0; i--) {\n    const j = randomInt(i + 1);\n    [chars[i], chars[j]] = [chars[j], chars[i]];\n  }\n  return `call_${chars.slice(0, 32).join(\"\")}`;\n};\n\n/** OpenAI-compatible gateway (streaming and not). A `hold` reply never answers: the client waits until it is killed. */\nasync function gateway(script: (body: any) => Reply, ids: IdStyle = \"low-entropy\"): Promise<Gw> {\n  const gw: Gw = { url: \"\", origin: \"\", requests: [], held: false, close: async () => {} };\n  let n = 0;\n  const server = http.createServer((req, res) => {\n    if (req.url?.endsWith(\"/models\")) {\n      res.setHeader(\"content-type\", \"application/json\");\n      return void res.end('{\"data\":[{\"id\":\"m\"}]}');\n    }\n    let raw = \"\";\n    req.on(\"data\", (c) => (raw += c));\n    req.on(\"end\", () => {\n      let body: any = {};\n      try { body = JSON.parse(raw); } catch {}\n      gw.requests.push(body);\n      const reply = script(body);\n      if (\"hold\" in reply) {\n        gw.held = true;\n        return;\n      }\n      const calls = \"tools\" in reply\n        ? reply.tools.map((c, index) => ({ index, id: ids === \"low-entropy\" ? `call_${++n}` : highEntropyId(), type: \"function\", function: { name: c.name, arguments: JSON.stringify(c.args) } }))\n        : undefined;\n      if (!body.stream) {\n        res.setHeader(\"content-type\", \"application/json\");\n        const message = calls ? { role: \"assistant\", content: null, tool_calls: calls } : { role: \"assistant\", content: (reply as { text: string }).text };\n        return void res.end(JSON.stringify({ choices: [{ index: 0, message, finish_reason: calls ? \"tool_calls\" : \"stop\" }] }));\n      }\n      res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n      const delta = calls ? { tool_calls: calls } : { content: (reply as { text: string }).text };\n      res.end(`data: ${JSON.stringify({ choices: [{ index: 0, delta, finish_reason: calls ? \"tool_calls\" : \"stop\" }] })}\\n\\ndata: [DONE]\\n\\n`);\n    });\nimport assert from \"node:assert/strict\";\nimport { createHash } from \"node:crypto\";\nimport { execFileSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { test } from \"node:test\";\nimport {\n  assessContextMaturity,\n  buildContextInventory,\n  buildInferenceContextManifest,\n  buildSessionContextInventory,\n  compareWorkspaceState,\n  isInferenceContextManifest,\n  isContextInventorySnapshot,\n  inventorySourcesFromMessages,\n  markInterruptedInferenceManifestsUnknown,\n  markPersistedContextFreshnessUnknown,\n  mergeContextInventorySnapshots,\n} from \"../src/core/context_inventory.js\";\nimport { SessionManager } from \"../src/session.js\";\nimport { WorkspacePath } from \"../src/core/workspace_path.js\";\nimport { buildSessionExport } from \"../src/session_export.js\";\nimport { hasHandler, routeSlash } from \"../src/slash/router.js\";\nimport { SLASH_COMMANDS } from \"../src/slash/catalog.js\";\nimport { replReadOnlyAllowed } from \"../src/repl.js\";\nimport { readOnlySlashAllowed } from \"../src/sidecar.js\";\nimport { AutonomousAgent } from \"../src/agent.js\";\nimport { calculateContextBudget } from \"../src/tokens.js\";\nimport { inspectWorkspaceGitSafety } from \"../src/core/workspace_git_safety.js\";\n\nconst input = (sourceLocation: string, scope: \"session\" | \"repository\" = \"session\", content = \"sensitive source text\") => ({\n  sourceType: \"note\", sourceLocation, scope, content, trust: \"persisted_unverified\" as const,\n  retention: \"session\", inclusionReason: \"explicit test fixture\", retrievalMethod: \"fixture\",\n});\n\ntest(\"inventory has stable source identity, scope isolation, and omits source text\", () => {\n  const first = buildContextInventory({ capturedAt: \"2026-11-22T00:00:00.000Z\", sources: [{ name: \"notes\", status: \"ok\", durationMs: 3, items: [input(\"notes:1\")] }] });\n  const second = buildContextInventory({ capturedAt: \"2026-11-23T00:00:00.000Z\", sources: [{ name: \"notes\", status: \"ok\", durationMs: 3, items: [input(\"notes:1\")] }] });\n  const repository = buildContextInventory({ sources: [{ name: \"notes\", status: \"ok\", durationMs: 3, items: [input(\"notes:1\", \"repository\")] }] });\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20c6e-33b2-7660-a7f0-668b82778aee","create_time":1795506172.081931}},"metadata":{"history_sequence":49241,"sampled_through_sequence":49238,"client_authored":false,"fallback_token_limit_override":12000}}
