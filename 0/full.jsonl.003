r explicitly overrides endpoint identity\", async () => {\ncli/test/task_class.test.ts:44:test(\"X-Task-Class is absent by default and while the endpoint identity is unknown\", async () => {\ncli/test/task_class.test.ts:49:test(\"an invalid task class is never sent (no header injection)\", async () => {\ncli/test/task_class.test.ts:55:test(\"standalone local servers discovered via /models do not receive X-Task-Class unless configured (REQ-PRV-109)\", async () => {\ncli/test/task_class.test.ts:97:test(\"task class is suppressed without a positive gateway handshake\", async () => {\ncli/test/task_class.test.ts:125:test(\"failed rediscovery retains gateway identity only for the same endpoint\", async () => {\ncli/test/task_class.test.ts:169:test(\"successful generic rediscovery clears prior gateway identity\", async () => {\ncli/test/task_class.test.ts:201:test(\"ACC-INF-08: code and docs carry no homelab-specific identifiers (t5820, engineering/b0, A770, 18010)\", async () => {\n## v1/wp1107-review-remediation-plan\n M docs/v1.1.0/WP-1107-PLAN.md\n","exit_code":0,"duration":{"secs":0,"nanos":776977885}},"started_at_ms":1793828732227,"completed_at_ms":1793828733004}}
