en it recurs.\\\\n   */\\\\n  reacquired?: number;\\\\n  firstStep: number;\\\\n  lastStep: number;\\\\n  /** Clipped normalized outcome, kept as evidence. */\\\\n  outcome: string;\\\\n}\\\\n\\\\nexport interface TrackingEvent {\\\\n  step: number;\\\\n  at: string;\\\\n  kind: string;\\\\n  detail: string;\\\\n}\\\\n\\\\nexport interface CompactionEvent {\\\\n  id: string;\\\\n  step: number;\\\\n  at: string;\\\\n  trigger: \\\\\\\"auto\\\\\\\" | \\\\\\\"manual\\\\\\\" | \\\\\\\"manual_llm\\\\\\\";\\\\n  beforeTokens: number;\\\\n  afterTokens: number;\\\\n  archivedMessages: number;\\\\n  committed: boolean;\\\\n  /** Pressure-triggered compaction that freed less than the low-yield ratio of the window. */\\\\n  lowYield?: boolean;\\\\n  detail?: string;\\\\n}\\\\n\\\\n/**\\\\n * Lines of a workspace file an executed read returned, on the workspace state it ran on. `key` is the observation key\\\\n * of the call that returned them (the agent's `observationKey`), so whether that output is still in the conversation\\\\n * can be checked against the conversation itself. No file content is kept: only a 16-hex digest of it.\\\\n */\\\\nexport interface CoverageSegment {\\\\n  path: string;\\\\n  start: number;\\\\n  end: number;\\\\n  total?: number;\\\\n  fingerprint: string;\\\\n  state: string;\\\\n  /** Tool call id of the read that returned these lines: presence is judged for that call's output only. */\\\\n  key: string;\\\\n  step: number;\\\\n  /** The file's own signature when it was read (observation_identity.fileSignature). */\\\\n  sig?: string;\\\\n}\\\\n\\\"}]},\\\"match_line\\\":103,\\\"match_lines\\\":[62,102,103,113]}]},\\\"_token_budget\\\":{\\\"tokenizer\\\":\\\"standard-uax29-words\\\",\\\"max_tokens\\\":1200,\\\"hits_full\\\":4,\\\"hits_locator_only\\\":[{\\\"_index\\\":\\\"nexus-cli-docs\\\",\\\"_id\\\":\\\"d258e9429740a0bcaba914b4b2270549\\\",\\\"ax_path\\\":\\\"parser.ts\\\",\\\"ax_file\\\":\\\"axf2-5af02bb6a676cb2b8d433035aadf15ef-67f5\\\",\\\