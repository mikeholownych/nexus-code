source review; no tests or edits. Source review does not establish release qualification.\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18b36-b9ed-7bf3-88e9-b2dec9ee7bb0","create_time":1793337241.1473005,"content_item_metadata":[{"provenance":{"type":"tool","namespace":"collaboration"}}]}},"metadata":{"client_authored":false,"user_input_order":23852}}
