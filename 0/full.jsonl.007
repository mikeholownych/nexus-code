{"timestamp":"2026-10-30T08:55:16.251Z","ordinal":525369,"type":"token_usage_record","payload":{"thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18bff-7011-7da3-8833-52d22c944baa","session_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","root_turn_id":"01a18bff-7011-7da3-8833-52d22c944baa","response_id":"resp_0db389702a7164cc016ae45b707e88819f97c8115218c06c60","usage":{"input_tokens":176921,"cached_input_tokens":176384,"cache_write_input_tokens":0,"output_tokens":377,"reasoning_output_tokens":252,"total_tokens":177298},"turn_token_usage":{"input_tokens":8206860,"cached_input_tokens":8145024,"cache_write_input_tokens":0,"output_tokens":19528,"reasoning_output_tokens":11537,"total_tokens":8226388},"thread_token_usage":{"input_tokens":9905889405,"cached_input_tokens":9801314176,"cache_write_input_tokens":0,"output_tokens":28408110,"reasoning_output_tokens":16703623,"total_tokens":9934297515}}}
{"timestamp":"2026-10-30T08:55:17.685Z","ordinal":525370,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18bff-7011-7da3-8833-52d22c944baa","item":{"type":"CommandExecution","id":"exec-00ae0675-662a-4d72-9ca7-1d7a498bb216","process_id":"61197","command":["/usr/bin/zsh","-lc","sed -n '140,330p' eval/run.mjs; sed -n '1,145p' cli/test/eval_harness.test.ts; rg -n 'selftest-add|hiddenPass|NOT_REQUIRED|outcome' eval/run.mjs eval/tasks/selftest-add -g '!reference*'"],"cwd":"file:///home/mike/nexus-wt/eval-t4-overload-diagnostic","parsed_cmd":[{"type":"read","cmd":"sed -n '140,330p' eval/run.mjs","name":"run.mjs","path":"eval/run.mjs"},{"type":"read","cmd":"sed -n '1,145p' cli/test/eval_harness.test.ts","name":"eval_harness.test.ts","path":"cli/test/eval_harness.test.ts"},{"type":"search","cmd":"rg -n 'selftest-add|hiddenPass|NOT_REQUIRED|outcome' eval/run.mjs eval/tasks/selftest-add -g '!reference*'","query":"selftest-add|hiddenPass|NOT_REQUIRED|outcome","path":"run.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    }\n  } finally {\n    await probe?.close();\n  }\n}\nif (problems.length) {\n  console.error(`eval/run.mjs: not starting; ${problems.length} problem(s):\\n${problems.map((p) => `  - ${p}`).join(\"\\n\")}`);\n  process.exit(2);\n}\nconst frozenTaskRows = taskRecords.map(({ id }) => corpusTaskRows(taskSnapshots, [id])[0]);\nfs.writeFileSync(path.join(args.out, \"manifest.json\"), JSON.stringify({\n  createdAt: new Date().toISOString(),\n  harness: identity,\n  config: redactConfig(config),\n  configSha256,\n  qualificationCorpus: config.qualification === true ? { manifestSha256: config.corpusManifestSha256, tasks: frozenTaskRows } : null,\n  fingerprint,\n  agentVersion: agentIdentity.record,\n  budget: effectiveBudget({}, config),\n  runs,\n  tasks: frozenTaskRows,\n  host: os.hostname(),\n  node: process.version,\n}, null, 2) + \"\\n\");\n\n// Run-major order (every task once, then again): a pass cut short still has the same number of runs per task.\nfor (let run = 1; run <= runs; run++) {\n  for (const { id, dir, treeSha256, task: taskData } of taskRecords) {\n    if (pairs && !pairs.some(([t, r]) => t === id && Number(r) === run)) continue;\n    if (taskTreeDigest(dir) !== treeSha256) throw new Error(`frozen task ${id} changed after manifest creation`);\n    const task = { ...taskData, dir };\n    const record = await runOnce(task, run);\n    fs.appendFileSync(resultsFile, JSON.stringify(record) + \"\\n\");\n    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\n  }\n}\n\nasync function runOnce(task, run) {\n  // Under the resource contract these are on a tmpfs, so candidate writes count against the run's memory limit.\n  const scratch = config.resources?.workspaceRoot ?? os.tmpdir();\n  const ws = fs.mkdtempSync(path.join(scratch, `nexus-eval-${task.id}-`));\n  const checkDirs = [];\n  const home = fs.mkdtempSync(path.join(scratch, \"nexus-eval-home-\"));\n  const budget = effectiveBudget(task, config);\n  const base = { task: task.id, tier: task.tier, ...(task.tier === \"T3\" ? { t3SteeringItems: task.steering.length } : {}), config: config.name, agent: config.agent ?? \"nexus\", agentVersion: agentIdentity.record, budget, run, harness: identity.string, model: config.model, startedAt: new Date().toISOString() };\n  try {\n    await prepareWorkspace(task, ws);\n    // Taken now, while .git is the harness's own: after the agent runs, nothing executes git against its workspace.\n    const baselineTree = gitRev(ws, \"HEAD^{tree}\");\n    const t3Baseline = task.tier === \"T3\" ? steeringBaseline(task, ws) : null;\n    // On the per-run task copy, so the steering hook in runAgent can read it. The commands run on a throwaway copy of\n    // the staged workspace, so the agent starts on exactly the staged tree.\n    const t3BaselineResources = [];\n    if (task.tier === \"T3\") {\n      const probe = fs.mkdtempSync(path.join(scratch, `nexus-eval-t3-baseline-${task.id}-`));\n      try {\n        fs.cpSync(ws, probe, { recursive: true, verbatimSymlinks: true });\n        task.t3CommandBaseline = await commandBaseline(task, (command) => runIsolated(command, { cwd: probe, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => {\n          if (r.resources) t3BaselineResources.push(r.resources);\n          const error = r.containmentProblem ?? (r.timedOut ? \"timed out\" : r.overflow ? \"output limit\" : r.status === null ? \"did not exit\" : null);\n          return { pass: r.status === 0 && !error, error };\n        }));\n      } finally {\n        fs.rmSync(probe, { recursive: true, force: true });\n      }\n    }\n    const sourceBefore = treeDigest(task.dir);\n    // Every agent reaches the model through a per-run forwarder, so whether the model was reachable is observed by the\n    // harness, the same way for every agent (eval/infra.mjs). `config.proxy: false` connects agents directly.\n    // T4: a task (or the config) may schedule faults for the proxy to inject; they are recorded with the run.\n    const faults = task.faults ?? config.faults ?? [];\n    if (faults.length && config.proxy === false) throw new Error(\"fault injection needs the model proxy (proxy: false is set)\");\n    // A standalone profile (DEC-16) shows agents a plain server; the proxy then holds the real key, agents get none.\n    if (config.serverProfile && config.proxy === false) throw new Error(\"serverProfile needs the model proxy (proxy: false is set)\");\n    const proxyDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-proxy-\"));\n    fs.chmodSync(proxyDir, 0o700);\n    const socketPath = path.join(proxyDir, \"proxy.sock\");\n    const localToken = REDACTED;\n    const proxy = await startModelProxy({\n      upstream: config.endpoint,\n      caFile,\n      faults,\n      profile: config.serverProfile,\n      authToken: apiKey ?? undefined,\n      clientToken: localToken,\n      socketPath,\n      maxRequests: config.limits?.requests ?? 1_000,\n      maxCompletionTokens: config.limits?.output,\n      maxTotalCompletionTokens: config.limits?.totalOutput,\n    });\n    const started = Date.now();\n    let agent;\n    let agentEndedAt;\n    try {\n      agent = await runAgent(task, ws, home, budget, agentIdentity, proxyDir, localToken, proxy);\n      agentEndedAt = Date.now();\n      if (config.runAs) {\n        for (const dir of [ws, home]) await normalizeRunAsPermissions(config.runAs, dir, asUserSpec);\n      }\n    } finally {\n      await proxy?.close();\n      fs.rmSync(proxyDir, { recursive: true, force: true });\n    }\n    const wallMs = agentEndedAt - started;\n    if (agent.containmentProblem) throw new Error(`candidate containment failed: ${agent.containmentProblem}`);\n    const model = proxy ? proxy.stats() : null;\n    const fixtureFaults = observeT4Fixture(task, agent, agent.resources, config.resources);\n    const contaminated = treeDigest(task.dir) !== sourceBefore || `${agent.stdout}${agent.stderr}`.includes(tasksDir);\n    // T3 judges the workspace as it was when the objective's work ended (snapshot taken before the probe turn).\n    const t3 = agent.t3Driver ? scoreT3Run({ task, baseline: t3Baseline, driver: agent.t3Driver, preconditions: agent.t3Preconditions, compactions: countCompactions(home) }) : null;\n    // Legacy hidden tests share a process with candidate code. In qualification (or with hardenedChecks) they never\n    // run in the agent's workspace: each check gets a fresh staging of the baseline with only the agent's source\n    // changes (eval/hardened_check.mjs). Black-box oracles already keep expectations outside the candidate.\n    const hardened = (config.qualification === true || config.hardenedChecks === true) && task.hidden?.protocol !== \"blackbox-v1\";\n    let hardening = null;\n    let hiddenWs = ws;\n    let regressionWs = ws;\n    if (hardened) {\n      hiddenWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-check-${task.id}-`));\n      regressionWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-regression-${task.id}-`));\n      checkDirs.push(hiddenWs, regressionWs);\n      await prepareWorkspace(task, hiddenWs);\n      // Fixture tasks commit at staging time, so compare content (the tree), not the commit id.\n      if (gitRev(hiddenWs, \"HEAD^{tree}\") !== baselineTree) throw new Error(\"hardened check workspace staged a different baseline\");\n      hardening = { baseline: baselineTree, ...applyAgentChanges(ws, hiddenWs) };\n      cloneWorkspace(hiddenWs, regressionWs);\n    }\n    const refused = (check) => ({ pass: false, status: null, timedOut: false, overflow: false, output: `hardened check refused: ${hardening.configChanges.join(\"; \")}`, refused: true, resources: null, containmentProblem: null, check });\n    const hidden = hardening?.configChanges.length ? refused(\"hidden\") : await runCheck(task, hiddenWs, task.hidden, true, { readOnlyHidden: hardened, protectedCorpusPaths: protectedCorpusPathsForRun() });\n    const regression = task.regression ? (hardening?.configChanges.length ? refused(\"regression\") : await runCheck(task, regressionWs, task.regression, false)) : null;\n    for (const [phase, check] of [[\"hidden\", hidden], [\"regression\", regression]]) {\n      if (check?.containmentProblem) throw new Error(`${phase} check containment failed: ${check.containmentProblem}`);\n    }\n    const turn = agent.json?.turn ?? null;\n    // Nexus reports a structured outcome; for the other agents a clean exit within the budget is their completion claim.\n    const claimedComplete = turn\n      ? turn.execution === \"COMPLETED\" && [\"VERIFIED\", \"REGRESSION_FREE\", \"UNVERIFIED\", \"NOT_REQUIRED\"].includes(turn.outcome)\n      : agent.code === 0 && !agent.timedOut && !agent.outputExceeded;\n    return {\n      ...base,\n      wallMs,\n      exitCode: agent.code,\n      timedOut: agent.timedOut,\n      outputExceeded: agent.outputExceeded,\n      turn: turn && { execution: turn.execution, outcome: turn.outcome, reason: turn.reason ?? null, steps: turn.steps ?? null, contextNotRetained: turn.contextNotRetained ?? 0 },\n      claimedComplete,\n      claimedVerified: turn?.outcome === \"VERIFIED\",\n      hiddenPass: hidden.pass,\n      regressionPass: regression ? regression.pass : null,\n      falseVerified: turn?.outcome === \"VERIFIED\" && !hidden.pass,\n      contaminated,\n      tokens: agent.json?.tokenStats ?? null,\n      ...(hardening ? { hardened: { baseline: hardening.baseline, applied: hardening.applied.length, discarded: hardening.discarded, configChanges: hardening.configChanges } } : {}),\n      ...(t3 ? { t3 } : {}),\n      model,\n      ...((agent.t4FaultsInjected?.length || fixtureFaults.length) ? { t4FaultsInjected: [...(agent.t4FaultsInjected ?? []), ...fixtureFaults] } : {}),\n      resources: config.resources ? { agent: agent.resources, hidden: hidden.resources ?? null, regression: regression?.resources ?? null, ...(t3BaselineResources.length ? { t3Baseline: t3BaselineResources } : {}) } : null,\n      logs: saveLogs(task, run, agent, hidden, regression),\n    };\n  } catch (err) {\n    return { ...base, wallMs: 0, error: String(err?.message ?? err), hiddenPass: false, regressionPass: null, falseVerified: false, claimedComplete: false, claimedVerified: false };\n  } finally {\n    if (!args.keep) {\n      for (const dir of checkDirs) fs.rmSync(dir, { recursive: true, force: true });\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n    }\n  }\n}\n\nasync function prepareWorkspace(task, ws) {\n  if (task.fixture) {\n    const fixture = confinedPath(task.dir, task.fixture);\n    assertNoSymlinks(fixture);\n    fs.cpSync(fixture, ws, { recursive: true, verbatimSymlinks: true });\n    sh(\"git\", [\"init\", \"-q\"], ws);\n    sh(\"git\", [\"add\", \"-A\"], ws);\n    sh(\"git\", [\"-c\", \"user.name=eval\", \"-c\", \"user.email=eval@example.invalid\", \"commit\", \"-qm\", \"fixture\"], ws);\n  } else if (task.repo) {\n    const cache = path.join(ROOT, \"eval/.cache\", createHash(\"sha256\").update(task.repo.url).digest(\"hex\").slice(0, 16));\n    if (!fs.existsSync(cache)) sh(\"git\", [\"clone\", \"-q\", \"--no-checkout\", task.repo.url, cache], ROOT);\n    const object = `${task.repo.commit}^{commit}`;\n    if (sh(\"git\", [\"-C\", cache, \"cat-file\", \"-e\", object], ROOT, true) !== 0) sh(\"git\", [\"-C\", cache, \"fetch\", \"-q\", \"origin\", task.repo.commit], ROOT);\n    stageRepoWorkspace(cache, task.repo.commit, ws);\n  } else throw new Error(`task ${task.id} has neither fixture nor repo`);\n  for (const cmd of task.setup ?? []) {\n    const result = await runIsolated(cmd, { cwd: ws, home: true, timeoutSec: task.setupTimeoutSec ?? 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() });\n    if (result.containmentProblem) throw new Error(`isolated setup containment failed for ${task.id}: ${result.containmentProblem}`);\n    if (result.status !== 0 || result.timedOut || result.overflow) throw new Error(`isolated setup failed for ${task.id}: ${result.timedOut ? \"timeout\" : result.overflow ? \"output limit\" : `exit ${result.status}`}`);\n  }\n}\n/**\n * The evaluation harness end to end against a scripted model (Stage 8, T1 smoke): fresh workspaces, hidden tests the\n * agent never sees, separate scores. The self-test task is the assessment's A1 case: a repository whose own suite is\n * green but never exercises the deliverable. A wrong deliverable must fail the hidden test and must never be VERIFIED.\n */\n\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, Reply } from \"./helpers/fixtures.js\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n\nasync function sealTestTasks(tasksDir: string, taskId: string) {\n  const { corpusTaskRows } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const rows = corpusTaskRows(tasksDir, [taskId]);\n  const manifestPath = path.join(tasksDir, \"custody-manifest.json\");\n  const manifest = { schemaVersion: 1, split: \"heldout\", custody: { status: \"approved\", custodian: \"synthetic-test-role\", approvedAt: \"2026-01-01T00:00:00Z\" }, tasks: rows };\n  const bytes = JSON.stringify(manifest);\n  fs.writeFileSync(manifestPath, bytes);\n  return { corpusManifest: manifestPath, corpusManifestSha256: createHash(\"sha256\").update(bytes).digest(\"hex\") };\n}\n\n/** Async: the scripted gateway answers from this process, so the runner must not block its event loop. */\nfunction runNode(argv: string[], env: NodeJS.ProcessEnv = process.env): Promise<{ status: number | null; stdout: string; stderr: string }> {\n  return new Promise((resolve) => {\n    const child = spawn(process.execPath, argv, { stdio: [\"ignore\", \"pipe\", \"pipe\"], env });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout.on(\"data\", (c) => (stdout += c));\n    child.stderr.on(\"data\", (c) => (stderr += c));\n    child.on(\"close\", (status) => resolve({ status, stdout, stderr }));\n  });\n}\n\nfunction writer(content: string) {\n  return (_n: number, body: any): Reply => {\n    const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n    if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"math.js\", content } }] };\n    if (tools === 1) return { kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary: \"math.js added\" } }] };\n    return { kind: \"text\", content: \"Done.\" };\n  };\n}\n\nasync function evaluate(content: string, extra: Record<string, unknown> = {}): Promise<{ records: any[]; score: any; hiddenLog: string; agentLog: string; agentError: string }> {\n  const gw = await startGateway(writer(content));\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-out-\"));\n  const out = path.join(root, \"run\");\n  const config = path.join(root, \"config.json\");\n  fs.writeFileSync(config, JSON.stringify({ name: \"nexus@mock\", agent: \"nexus\", endpoint: gw.url, model: \"m\", runs: 1, steps: 20, minutes: 5, ...extra }));\n  try {\n    const run = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(run.status, 0, `${run.stdout}\\n${run.stderr}`);\n    const records = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(out, \"results.jsonl\"), \"--json\"], { encoding: \"utf8\" });\n    assert.equal(scored.status, 0, scored.stderr);\n    const manifest = JSON.parse(fs.readFileSync(path.join(out, \"manifest.json\"), \"utf8\"));\n    assert.deepEqual(manifest.tasks.map((task: any) => task.id), [\"selftest-add\"]);\n    assert.match(manifest.harness.sourceSha256, /^[0-9a-f]{64}$/);\n    assert.match(manifest.configSha256, /^[0-9a-f]{64}$/);\n    const priorResults = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\");\n    const replay = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(replay.status, 2);\n    assert.match(replay.stderr, /output directory must be new/);\n    assert.equal(fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\"), priorResults, \"reusing an output directory changed prior evidence\");\n    assert.match(manifest.harness.string, /^[0-9a-f]{12}/);\n    const logDir = records[0].logs ? path.join(out, records[0].logs) : null;\n    const readLog = (file: string) => logDir && fs.existsSync(path.join(logDir, file)) ? fs.readFileSync(path.join(logDir, file), \"utf8\") : \"<not written>\";\n    return { records, score: JSON.parse(scored.stdout), hiddenLog: readLog(\"hidden.log\"), agentLog: readLog(\"agent.stdout.json\"), agentError: readLog(\"agent.stderr.log\") };\n  } finally {\n    await gw.close();\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n}\n\ntest(\"a correct deliverable passes the hidden test; a wrong one fails it and is never VERIFIED (A1)\", { timeout: 300_000 }, async () => {\n  const good = await evaluate(\"exports.add = (a, b) => a + b;\\n\");\n  assert.equal(good.records.length, 1);\n  assert.equal(good.records[0].hiddenPass, true, `${JSON.stringify(good.records[0])}\\nagent=${good.agentLog}\\nagent-error=${good.agentError}\\nhidden=${good.hiddenLog}`);\n  assert.equal(good.records[0].regressionPass, true);\n  assert.equal(good.records[0].falseVerified, false);\n\n  const wrong = await evaluate(\"exports.add = (a, b) => a - b;\\n\");\n  const r = wrong.records[0];\n  assert.equal(r.hiddenPass, false, \"the hidden test catches the wrong deliverable\");\n  assert.equal(r.regressionPass, true, \"the repository's own suite is still green\");\n  assert.notEqual(r.turn?.outcome, \"VERIFIED\", `an unrelated green suite does not verify it: ${JSON.stringify(r.turn)}`);\n  assert.equal(r.falseVerified, false);\n  assert.equal(wrong.score.totals.falseVerified, 0);\n  assert.equal(wrong.score.rows[0].correct, 0);\n});\n\n// REQ-QUAL-110: T4 smoke in `make test` — faults injected by the harness's model proxy end truthfully.\ntest(\"standalone profile context discovery is not overridden by the harness default\", async () => {\n  const { nexusContextLimitArgs } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\" }, 65536), []);\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\", limits: { context: 8192 } }, 65536), [\"--context-limit\", \"8192\"]);\n  assert.deepEqual(nexusContextLimitArgs({}, 65536), [\"--context-limit\", \"65536\"]);\n});\n\ntest(\"a standalone server-profile run discovers context instead of forcing the harness default\", { timeout: 300_000 }, async () => {\n  const result = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { serverProfile: \"llamacpp\" });\n  assert.equal(result.records[0].hiddenPass, true);\n  assert.ok(result.records[0].model.profileContextLookups > 0, \"llama.cpp context comes from the profile endpoint\");\n});\n\ntest(\"T4 smoke: an overloaded endpoint is waited out and the task still completes; the fault is recorded\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"overloaded\", atRequest: 1 }] });\n  const r = records[0];\n  assert.ok(!r.error, `evaluation record failed before model telemetry was captured: ${JSON.stringify(r, null, 2)}`);\n  assert.deepEqual(r.model?.faultsInjected, [{ kind: \"overloaded\", atRequest: 1 }], `proxy telemetry: ${JSON.stringify(r.model, null, 2)}`);\n  assert.equal(r.hiddenPass, true, JSON.stringify(r.turn));\n  assert.equal(r.falseVerified, false);\n  assert.equal(score.faults.length, 9, \"the scorer always exposes all nine accepted T4 fault classes\");\n  assert.equal(score.t4.gate, \"FAIL\", \"one smoke fault is not a nine-class qualification\");\n  assert.deepEqual(score.faults.filter((f: any) => f.n > 0).map((f: any) => [f.kind, f.n, f.truthful, f.recovered]), [[\"overloaded\", 1, 1, 1]]);\n});\n\ntest(\"T4 smoke: a reply cut at the output limit is never run as a tool call, and the run ends truthfully\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"truncate\", atRequest: 1 }] });\n  const r = records[0];\n  assert.equal(r.model.faultsInjected[0].kind, \"truncate\");\n  assert.equal(r.falseVerified, false);\n  assert.ok(r.turn, \"the run produced its own result (no crash)\");\n  assert.equal(score.faults.find((fault: any) => fault.kind === \"truncate\").truthful, 1);\n});\n\ntest(\"peer run records the executable version and effective budget\", { timeout: 300_000 }, async () => {\n  const gw = await startGateway(() => ({ kind: \"text\", content: \"not used by the fake peer\" }));\n  const out = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-peer-out-\"));\n  const runOut = path.join(out, \"run\");\n  const bin = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-peer-bin-\"));\n  const config = path.join(out, \"config.json\");\n  const fakeOpenCode = path.join(bin, \"opencode\");\n  fs.writeFileSync(fakeOpenCode, `#!/usr/bin/env node\nif (process.argv.includes(\"--version\")) { console.log(\"OpenCode 9.8.7\"); process.exit(0); }\nconst cfg = JSON.parse(require(\"node:fs\").readFileSync(require(\"node:path\").join(process.env.HOME, \".config/opencode/opencode.json\"), \"utf8\"));\nrequire(\"node:fs\").writeFileSync(require(\"node:path\").join(process.cwd(), \"math.js\"), \"exports.add = (a, b) => a + b;\\\\n\");\nconsole.log(JSON.stringify({ observed: { agent: cfg.agent[\"nexus-eval\"], model: cfg.provider.gw.models.m } }));\nconsole.log(JSON.stringify({ turn: { execution: \"COMPLETED\", outcome: \"NOT_REQUIRED\", steps: { used: 1 } } }));\neval/run.mjs:173:    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\neval/run.mjs:274:    // Nexus reports a structured outcome; for the other agents a clean exit within the budget is their completion claim.\neval/run.mjs:276:      ? turn.execution === \"COMPLETED\" && [\"VERIFIED\", \"REGRESSION_FREE\", \"UNVERIFIED\", \"NOT_REQUIRED\"].includes(turn.outcome)\neval/run.mjs:284:      turn: turn && { execution: turn.execution, outcome: turn.outcome, reason: turn.reason ?? null, steps: turn.steps ?? null, contextNotRetained: turn.contextNotRetained ?? 0 },\neval/run.mjs:286:      claimedVerified: turn?.outcome === \"VERIFIED\",\neval/run.mjs:287:      hiddenPass: hidden.pass,\neval/run.mjs:289:      falseVerified: turn?.outcome === \"VERIFIED\" && !hidden.pass,\neval/run.mjs:300:    return { ...base, wallMs: 0, error: String(err?.message ?? err), hiddenPass: false, regressionPass: null, falseVerified: false, claimedComplete: false, claimedVerified: false };\neval/run.mjs:713:        outcome: result.outcome,\neval/tasks/selftest-add/repo/package.json:1:{ \"name\": \"selftest-add\", \"version\": \"1.0.0\", \"private\": true, \"scripts\": { \"test\": \"node test/other.test.js\" } }\neval/tasks/selftest-add/task.json:2:  \"id\": \"selftest-add\",\n","exit_code":0,"duration":{"secs":1,"nanos":109247045}},"started_at_ms":1793350516575,"completed_at_ms":1793350517685}}
{"timestamp":"2026-10-30T08:55:18.307Z","ordinal":525371,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18c05-4623-7083-a9c0-718edcfad753","call_id":"call_20fa2ac95f9d404698b7b939a3ba313b","output":[{"type":"input_text","text":"Script completed\nWall time 2.2 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 5805)\nTotal output lines: 347\n\n    }\n  } finally {\n    await probe?.close();\n  }\n}\nif (problems.length) {\n  console.error(`eval/run.mjs: not starting; ${problems.length} problem(s):\\n${problems.map((p) => `  - ${p}`).join(\"\\n\")}`);\n  process.exit(2);\n}\nconst frozenTaskRows = taskRecords.map(({ id }) => corpusTaskRows(taskSnapshots, [id])[0]);\nfs.writeFileSync(path.join(args.out, \"manifest.json\"), JSON.stringify({\n  createdAt: new Date().toISOString(),\n  harness: identity,\n  config: redactConfig(config),\n  configSha256,\n  qualificationCorpus: config.qualification === true ? { manifestSha256: config.corpusManifestSha256, tasks: frozenTaskRows } : null,\n  fingerprint,\n  agentVersion: agentIdentity.record,\n  budget: effectiveBudget({}, config),\n  runs,\n  tasks: frozenTaskRows,\n  host: os.hostname(),\n  node: process.version,\n}, null, 2) + \"\\n\");\n\n// Run-major order (every task once, then again): a pass cut short still has the same number of runs per task.\nfor (let run = 1; run <= runs; run++) {\n  for (const { id, dir, treeSha256, task: taskData } of taskRecords) {\n    if (pairs && !pairs.some(([t, r]) => t === id && Number(r) === run)) continue;\n    if (taskTreeDigest(dir) !== treeSha256) throw new Error(`frozen task ${id} changed after manifest creation`);\n    const task = { ...taskData, dir };\n    const record = await runOnce(task, run);\n    fs.appendFileSync(resultsFile, JSON.stringify(record) + \"\\n\");\n    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\n  }\n}\n\nasync function runOnce(task, run) {\n  // Under the resource contract these are on a tmpfs, so candidate writes count against the run's memory limit.\n  const scratch = config.resources?.workspaceRoot ?? os.tmpdir();\n  const ws = fs.mkdtempSync(path.join(scratch, `nexus-eval-${task.id}-`));\n  const checkDirs = [];\n  const home = fs.mkdtempSync(path.join(scratch, \"nexus-eval-home-\"));\n  const budget = effectiveBudget(task, config);\n  const base = { task: task.id, tier: task.tier, ...(task.tier === \"T3\" ? { t3SteeringItems: task.steering.length } : {}), config: config.name, agent: config.agent ?? \"nexus\", agentVersion: agentIdentity.record, budget, run, harness: identity.string, model: config.model, startedAt: new Date().toISOString() };\n  try {\n    await prepareWorkspace(task, ws);\n    // Taken now, while .git is the harness's own: after the agent runs, nothing executes git against its workspace.\n    const baselineTree = gitRev(ws, \"HEAD^{tree}\");\n    const t3Baseline = task.tier === \"T3\" ? steeringBaseline(task, ws) : null;\n    // On the per-run task copy, so the steering hook in runAgent can read it. The commands run on a throwaway copy of\n    // the staged workspace, so the agent starts on exactly the staged tree.\n    const t3BaselineResources = [];\n    if (task.tier === \"T3\") {\n      const probe = fs.mkdtempSync(path.join(scratch, `nexus-eval-t3-baseline-${task.id}-`));\n      try {\n        fs.cpSync(ws, probe, { recursive: true, verbatimSymlinks: true });\n        task.t3CommandBaseline = await commandBaseline(task, (command) => runIsolated(command, { cwd: probe, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => {\n          if (r.resources) t3BaselineResources.push(r.resources);\n          const error = r.containmentProblem ?? (r.timedOut ? \"timed out\" : r.overflow ? \"output limit\" : r.status === null ? \"did not exit\" : null);\n          return { pass: r.status === 0 && !error, error };\n        }));\n      } finally {\n        fs.rmSync(probe, { recursive: true, force: true });\n      }\n    }\n    const sourceBefore = treeDigest(task.dir);\n    // Every agent reaches the model through a per-run forwarder, so whether the model was reachable is observed by the\n    // harness, the same way for every agent (eval/infra.mjs). `config.proxy: false` connects agents directly.\n    // T4: a task (or the config) may schedule faults for the proxy to inject; they are recorded with the run.\n    const faults = task.faults ?? config.faults ?? [];\n    if (faults.length && config.proxy === false) throw new Error(\"fault injection needs the model proxy (proxy: false is set)\");\n    // A standalone profile (DEC-16) shows agents a plain server; the proxy then holds the real key, agents get none.\n    if (config.serverProfile && config.proxy === false) throw new Error(\"serverProfile needs the model proxy (proxy: false is set)\");\n    const proxyDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-proxy-\"));\n    fs.chmodSync(proxyDir, 0o700);\n    const socketPath = path.join(proxyDir, \"proxy.sock\");\n    const localToken = REDACTED;\n    const proxy = await startModelProxy({\n      upstream: config.endpoint,\n      caFile,\n      faults,\n      profile: config.serverProfile,\n      authToken: apiKey ?? undefined,\n      clientToken: localToken,\n      socketPath,\n      maxRequests: config.limits?.requests ?? 1_000,\n      maxCompletionTokens: config.limits?.output,\n      maxTotalCompletionTokens: config.limits?.totalOutput,\n    });\n    const started = Date.now();\n    let agent;\n    let agentEndedAt;\n    try {\n      agent = await runAgent(task, ws, home, budget, agentIdentity, proxyDir, localToken, proxy);\n      agentEndedAt = Date.now();\n      if (config.runAs) {\n        for (const dir of [ws, home]) await normalizeRunAsPermissions(config.runAs, dir, asUserSpec);\n      }\n    } finally {\n      await proxy?.close();\n      fs.rmSync(proxyDir, { recursive: true, force: true });\n    }\n    const wallMs = agentEndedAt - started;\n    if (agent.containmentProblem) throw new Error(`candidate containment failed: ${agent.containmentProblem}`);\n    const model = proxy ? proxy.stats() : null;\n    const fixtureFaults = observeT4Fixture(task, agent, agent.resources, config.resources);\n    const contaminated = treeDigest(task.dir) !== sourceBefore || `${agent.stdout}${agent.stderr}`.includes(tasksDir);\n    // T3 judges the workspace as it was when the objective's work ended (snapshot taken before the probe turn).\n    const t3 = agent.t3Driver ? scoreT3Run({ task, baseline: t3Baseline, driver: agent.t3Driver, preconditions: agent.t3Preconditions, compactions: countCompactions(home) }) : null;\n    // Legacy hidden tests share a process with candidate code. In qualification (or with hardenedChecks) they never\n    // run in the agent's workspace: each check gets a fresh staging of the baseline with only the agent's source\n    // changes (eval/hardened_check.mjs). Black-box oracles already keep expectations outside the candidate.\n    const hardened = (config.qualification === true || config.hardenedChecks === true) && task.hidden?.protocol !== \"blackbox-v1\";\n    let hardening = null;\n    let hiddenWs = ws;\n    let regressionWs = ws;\n    if (hardened) {\n      hiddenWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-check-${task.id}-`));\n      regressionWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-regression-${task.id}-`));\n      checkDirs.push(hiddenWs, regressionWs);\n      await prepareWorkspace(task, hiddenWs);\n      // Fixture tasks commit at staging time, so compare content (the tree), not the commit id.\n      if (gitRev(hiddenWs, \"HEAD^{tree}\") !== baselineTree) throw new Error(\"hardened check workspace staged a different baseline\");\n      hardening = { baseline: baselineTree, ...applyAgentChanges(ws, hiddenWs) };\n      cloneWorkspace(hiddenWs, regressionWs);\n    }\n    const refused = (check) => ({ pass: false, status: null, timedOut: false, overflow: false, output: `hardened check refused: ${hardening.configChanges.join(\"; \")}`, refused: true, resources: null, containmentProblem: null, check });\n    const hidden = hardening?.configChanges.length ? refused(\"hidden\") : await runCheck(task, hiddenWs, task.hidden, true, { readOnlyHidden: hardened, protectedCorpusPaths: protectedCorpusPathsForRun() });\n    const regression = task.regression ? (hardening?.configChanges.length ? refused(\"regression\") : await runCheck(task, regressionWs, task.regression, false)) : null;\n    for (const [phase, check] of [[\"hidden\", hidden], [\"regression\", regression]]) {\n      if (check?.containmentProblem) throw new Error(`${phase} check containment failed: ${check.containmentProblem}`);\n    }\n …1605 tokens truncated… await startGateway(writer(content));\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-out-\"));\n  const out = path.join(root, \"run\");\n  const config = path.join(root, \"config.json\");\n  fs.writeFileSync(config, JSON.stringify({ name: \"nexus@mock\", agent: \"nexus\", endpoint: gw.url, model: \"m\", runs: 1, steps: 20, minutes: 5, ...extra }));\n  try {\n    const run = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(run.status, 0, `${run.stdout}\\n${run.stderr}`);\n    const records = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(out, \"results.jsonl\"), \"--json\"], { encoding: \"utf8\" });\n    assert.equal(scored.status, 0, scored.stderr);\n    const manifest = JSON.parse(fs.readFileSync(path.join(out, \"manifest.json\"), \"utf8\"));\n    assert.deepEqual(manifest.tasks.map((task: any) => task.id), [\"selftest-add\"]);\n    assert.match(manifest.harness.sourceSha256, /^[0-9a-f]{64}$/);\n    assert.match(manifest.configSha256, /^[0-9a-f]{64}$/);\n    const priorResults = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\");\n    const replay = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(replay.status, 2);\n    assert.match(replay.stderr, /output directory must be new/);\n    assert.equal(fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\"), priorResults, \"reusing an output directory changed prior evidence\");\n    assert.match(manifest.harness.string, /^[0-9a-f]{12}/);\n    const logDir = records[0].logs ? path.join(out, records[0].logs) : null;\n    const readLog = (file: string) => logDir && fs.existsSync(path.join(logDir, file)) ? fs.readFileSync(path.join(logDir, file), \"utf8\") : \"<not written>\";\n    return { records, score: JSON.parse(scored.stdout), hiddenLog: readLog(\"hidden.log\"), agentLog: readLog(\"agent.stdout.json\"), agentError: readLog(\"agent.stderr.log\") };\n  } finally {\n    await gw.close();\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n}\n\ntest(\"a correct deliverable passes the hidden test; a wrong one fails it and is never VERIFIED (A1)\", { timeout: 300_000 }, async () => {\n  const good = await evaluate(\"exports.add = (a, b) => a + b;\\n\");\n  assert.equal(good.records.length, 1);\n  assert.equal(good.records[0].hiddenPass, true, `${JSON.stringify(good.records[0])}\\nagent=${good.agentLog}\\nagent-error=${good.agentError}\\nhidden=${good.hiddenLog}`);\n  assert.equal(good.records[0].regressionPass, true);\n  assert.equal(good.records[0].falseVerified, false);\n\n  const wrong = await evaluate(\"exports.add = (a, b) => a - b;\\n\");\n  const r = wrong.records[0];\n  assert.equal(r.hiddenPass, false, \"the hidden test catches the wrong deliverable\");\n  assert.equal(r.regressionPass, true, \"the repository's own suite is still green\");\n  assert.notEqual(r.turn?.outcome, \"VERIFIED\", `an unrelated green suite does not verify it: ${JSON.stringify(r.turn)}`);\n  assert.equal(r.falseVerified, false);\n  assert.equal(wrong.score.totals.falseVerified, 0);\n  assert.equal(wrong.score.rows[0].correct, 0);\n});\n\n// REQ-QUAL-110: T4 smoke in `make test` — faults injected by the harness's model proxy end truthfully.\ntest(\"standalone profile context discovery is not overridden by the harness default\", async () => {\n  const { nexusContextLimitArgs } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\" }, 65536), []);\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\", limits: { context: 8192 } }, 65536), [\"--context-limit\", \"8192\"]);\n  assert.deepEqual(nexusContextLimitArgs({}, 65536), [\"--context-limit\", \"65536\"]);\n});\n\ntest(\"a standalone server-profile run discovers context instead of forcing the harness default\", { timeout: 300_000 }, async () => {\n  const result = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { serverProfile: \"llamacpp\" });\n  assert.equal(result.records[0].hiddenPass, true);\n  assert.ok(result.records[0].model.profileContextLookups > 0, \"llama.cpp context comes from the profile endpoint\");\n});\n\ntest(\"T4 smoke: an overloaded endpoint is waited out and the task still completes; the fault is recorded\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"overloaded\", atRequest: 1 }] });\n  const r = records[0];\n  assert.ok(!r.error, `evaluation record failed before model telemetry was captured: ${JSON.stringify(r, null, 2)}`);\n  assert.deepEqual(r.model?.faultsInjected, [{ kind: \"overloaded\", atRequest: 1 }], `proxy telemetry: ${JSON.stringify(r.model, null, 2)}`);\n  assert.equal(r.hiddenPass, true, JSON.stringify(r.turn));\n  assert.equal(r.falseVerified, false);\n  assert.equal(score.faults.length, 9, \"the scorer always exposes all nine accepted T4 fault classes\");\n  assert.equal(score.t4.gate, \"FAIL\", \"one smoke fault is not a nine-class qualification\");\n  assert.deepEqual(score.faults.filter((f: any) => f.n > 0).map((f: any) => [f.kind, f.n, f.truthful, f.recovered]), [[\"overloaded\", 1, 1, 1]]);\n});\n\ntest(\"T4 smoke: a reply cut at the output limit is never run as a tool call, and the run ends truthfully\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"truncate\", atRequest: 1 }] });\n  const r = records[0];\n  assert.equal(r.model.faultsInjected[0].kind, \"truncate\");\n  assert.equal(r.falseVerified, false);\n  assert.ok(r.turn, \"the run produced its own result (no crash)\");\n  assert.equal(score.faults.find((fault: any) => fault.kind === \"truncate\").truthful, 1);\n});\n\ntest(\"peer run records the executable version and effective budget\", { timeout: 300_000 }, async () => {\n  const gw = await startGateway(() => ({ kind: \"text\", content: \"not used by the fake peer\" }));\n  const out = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-peer-out-\"));\n  const runOut = path.join(out, \"run\");\n  const bin = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-peer-bin-\"));\n  const config = path.join(out, \"config.json\");\n  const fakeOpenCode = path.join(bin, \"opencode\");\n  fs.writeFileSync(fakeOpenCode, `#!/usr/bin/env node\nif (process.argv.includes(\"--version\")) { console.log(\"OpenCode 9.8.7\"); process.exit(0); }\nconst cfg = JSON.parse(require(\"node:fs\").readFileSync(require(\"node:path\").join(process.env.HOME, \".config/opencode/opencode.json\"), \"utf8\"));\nrequire(\"node:fs\").writeFileSync(require(\"node:path\").join(process.cwd(), \"math.js\"), \"exports.add = (a, b) => a + b;\\\\n\");\nconsole.log(JSON.stringify({ observed: { agent: cfg.agent[\"nexus-eval\"], model: cfg.provider.gw.models.m } }));\nconsole.log(JSON.stringify({ turn: { execution: \"COMPLETED\", outcome: \"NOT_REQUIRED\", steps: { used: 1 } } }));\neval/run.mjs:173:    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\neval/run.mjs:274:    // Nexus reports a structured outcome; for the other agents a clean exit within the budget is their completion claim.\neval/run.mjs:276:      ? turn.execution === \"COMPLETED\" && [\"VERIFIED\", \"REGRESSION_FREE\", \"UNVERIFIED\", \"NOT_REQUIRED\"].includes(turn.outcome)\neval/run.mjs:284:      turn: turn && { execution: turn.execution, outcome: turn.outcome, reason: turn.reason ?? null, steps: turn.steps ?? null, contextNotRetained: turn.contextNotRetained ?? 0 },\neval/run.mjs:286:      claimedVerified: turn?.outcome === \"VERIFIED\",\neval/run.mjs:287:      hiddenPass: hidden.pass,\neval/run.mjs:289:      falseVerified: turn?.outcome === \"VERIFIED\" && !hidden.pass,\neval/run.mjs:300:    return { ...base, wallMs: 0, error: String(err?.message ?? err), hiddenPass: false, regressionPass: null, falseVerified: false, claimedComplete: false, claimedVerified: false };\neval/run.mjs:713:        outcome: result.outcome,\neval/tasks/selftest-add/repo/package.json:1:{ \"name\": \"selftest-add\", \"version\": \"1.0.0\", \"private\": true, \"scripts\": { \"test\": \"node test/other.test.js\" } }\neval/tasks/selftest-add/task.json:2:  \"id\": \"selftest-add\",\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18bff-7011-7da3-8833-52d22c944baa","create_time":1793350518.3070629}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
