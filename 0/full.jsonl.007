{"timestamp":"2026-10-30T10:05:37.923Z","ordinal":527713,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18c3d-7cdd-71d3-966d-f30f05df4fb0","item":{"type":"CommandExecution","id":"exec-7339133a-0365-4e3e-807c-2af71f02c585","process_id":"94628","command":["/usr/bin/zsh","-lc","sed -n '1,260p' scripts/smoke-package.sh; sed -n '1,240p' scripts/package-linux.sh | rg -n -A8 -B8 'SBOM|notices|metadata|validate|component|Cyclone|cyclone|package'; gh release view v1.0.0-rc.14 --json body -q .body > /tmp/nexus-rc14-release-body.md; git show 16eeb6ee:docs/releases/v1.0.0-rc.14.md > /tmp/nexus-rc14-source-notes.md; cmp -s /tmp/nexus-rc14-release-body.md /tmp/nexus-rc14-source-notes.md && echo 'release body matches source notes' || echo 'release body differs from source notes'; tar -tzf /tmp/nexus-rc14-workflow-assets/nexus-linux-x86_64-v1.0.0-rc.14.tar.gz | rg '(^|/)THIRD_PARTY_NOTICES\\.txt$|(^|/)sbom\\.cdx\\.json$|^nexus/' | head -n 15"],"cwd":"file:///home/mike/nexus-wt/rc14-artifact-verification","parsed_cmd":[{"type":"unknown","cmd":"sed -n '1,260p' scripts/smoke-package.sh; sed -n '1,240p' scripts/package-linux.sh | rg -n -A8 -B8 'SBOM|notices|metadata|validate|component|Cyclone|cyclone|package'; gh release view v1.0.0-rc.14 --json body -q .body > /tmp/nexus-rc14-release-body.md; git show 16eeb6ee:docs/releases/v1.0.0-rc.14.md > /tmp/nexus-rc14-source-notes.md; cmp -s /tmp/nexus-rc14-release-body.md /tmp/nexus-rc14-source-notes.md && echo 'release body matches source notes' || echo 'release body differs from source notes'; tar -tzf /tmp/nexus-rc14-workflow-assets/nexus-linux-x86_64-v1.0.0-rc.14.tar.gz | rg '(^|/)THIRD_PARTY_NOTICES\\.txt$|(^|/)sbom\\.cdx\\.json$|^nexus/' | head -n 15"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\nARCHIVE=${1:?usage: smoke-package.sh ARCHIVE}\nTMP=$(mktemp -d)\ntrap 'rm -rf \"$TMP\"' EXIT\ntar -xzf \"$ARCHIVE\" -C \"$TMP\"\nNEXUS=\"$TMP/nexus/bin/nexus\"\nVERSION=$(cat \"$TMP/nexus/VERSION\")\n\"$NEXUS\" --version | grep -F \"${VERSION#v}\" >/dev/null\n\"$NEXUS\" --help >/dev/null\nset +e\nmkdir -p \"$TMP/doctor-home\"\nHOME=\"$TMP/doctor-home\" \"$NEXUS\" doctor --json > \"$TMP/doctor.json\"\nDOCTOR_STATUS=$?\nset -e\n[ \"$DOCTOR_STATUS\" -le 2 ] || { cat \"$TMP/doctor.json\" >&2; echo \"packaged doctor failed to run\" >&2; exit 1; }\nnode -e 'const d=require(process.argv[1]); if (d.schemaVersion !== 2) process.exit(1)' \"$TMP/doctor.json\"\n# One version everywhere (REQ-REL-103): a fresh install's engine check passes, never a version warning.\nnode -e 'const d=require(process.argv[1]); const e=d.findings.find((f)=>f.id===\"engine.binary\"); if (!e || e.status!==\"pass\") { console.error(JSON.stringify(e)); process.exit(1) }' \"$TMP/doctor.json\"\n\n# ACC-PKG-06: nexus doctor 2>err; test ! -s err on a healthy fixture install\nset +e\nHOME=\"$TMP/doctor-home\" \"$NEXUS\" doctor 2>\"$TMP/doctor.err\" >/dev/null\nDOCTOR_RUN_STATUS=$?\nset -e\n[ \"$DOCTOR_RUN_STATUS\" -le 2 ] || { cat \"$TMP/doctor.err\" >&2; echo \"doctor failed to run\" >&2; exit 1; }\n[ ! -s \"$TMP/doctor.err\" ] || { cat \"$TMP/doctor.err\" >&2; echo \"doctor emitted stderr on healthy install\" >&2; exit 1; }\n\n# ACC-PKG-07: packaged doctor remedies contain no make or harness.sh\nif grep -E \"make|harness\\.sh\" \"$TMP/doctor.json\" >/dev/null; then\n  echo \"packaged doctor JSON contains make or harness.sh remedy\" >&2\n  exit 1\nfi\n\n# ACC-PKG-01: PTY launch of the installed nexus asserts the TUI header and idle hint\npython3 \"$(dirname \"$0\")/package-smoke-pty.py\" \"$NEXUS\" > \"$TMP/pty.out\"\ngrep -F \"NEXUS\" \"$TMP/pty.out\" >/dev/null || { cat \"$TMP/pty.out\" >&2; echo \"PTY launch missing TUI header\" >&2; exit 1; }\ngrep -E \"(ask Nexus|commands|enter send)\" \"$TMP/pty.out\" >/dev/null || { cat \"$TMP/pty.out\" >&2; echo \"PTY launch missing idle hint\" >&2; exit 1; }\n\n# ACC-PKG-01: nexus repl gives the REPL prompt\nprintf '/exit\\n' | \"$NEXUS\" repl > \"$TMP/repl.out\" 2>&1\ngrep -E \"(nexus|❯)\" \"$TMP/repl.out\" >/dev/null || { cat \"$TMP/repl.out\" >&2; echo \"nexus repl did not render REPL prompt\" >&2; exit 1; }\n\n# ACC-PKG-01: </dev/null nexus gives the REPL\n\"$NEXUS\" </dev/null > \"$TMP/null.out\" 2>&1\ngrep -E \"(nexus|❯)\" \"$TMP/null.out\" >/dev/null || { cat \"$TMP/null.out\" >&2; echo \"</dev/null nexus did not render REPL prompt\" >&2; exit 1; }\n\n# ACC-PKG-02: doc-command extraction test passes against the package\nnode \"$(dirname \"$0\")/doc_commands.mjs\" \"$NEXUS\"\n\n# ACC-SUP-01: archive contains THIRD_PARTY_NOTICES.txt covering full dependency closure\ntest -s \"$TMP/nexus/THIRD_PARTY_NOTICES.txt\"\nnode \"$(dirname \"$0\")/check_notices.mjs\" \"$TMP/nexus/THIRD_PARTY_NOTICES.txt\"\n\ntest -x \"$TMP/nexus/lib/core/harness-core\"\ntest -x \"$TMP/nexus/lib/core/nexus-tui\"\nnode --input-type=module - \"$TMP/nexus/lib/cli/dist/tools.js\" \"$TMP/nexus/lib/core/harness-core\" \"$TMP/nexus/compatibility.json\" \"$TMP/nexus/lib/cli/dist/core/state.js\" <<'EOF'\nimport { pathToFileURL } from 'node:url';\nimport fs from 'node:fs';\nconst moduleUrl = pathToFileURL(process.argv[2]).href;\nprocess.env.NEXUS_HOME = process.argv[3].replace(/\\/lib\\/core\\/harness-core$/, '');\nconst { resolveCoreBinary } = await import(moduleUrl);\nif (resolveCoreBinary() !== process.argv[3]) throw new Error('packaged core resolution failed');\nconst { CURRENT_STATE_SCHEMA_VERSION } = await import(pathToFileURL(process.argv[5]).href);\nconst metadata = JSON.parse(fs.readFileSync(process.argv[4], 'utf8'));\nif (metadata.compatibility.stateSchemaVersion !== CURRENT_STATE_SCHEMA_VERSION) throw new Error('packaged state schema disagrees with compatibility metadata');\nEOF\n\"$TMP/nexus/lib/core/harness-core\" --help >/dev/null\ncat > \"$TMP/snapshot.json\" <<'EOF'\n{\"model\":\"smoke\",\"workspace\":\"/tmp\",\"task_id\":\"smoke\",\"objective\":\"package smoke\",\"activity\":[],\"plan\":[],\"validation\":null,\"context\":\"0 messages\",\"status\":\"IDLE\",\"theme\":\"default\"}\nEOF\n\"$TMP/nexus/lib/core/nexus-tui\" --plain \"$TMP/snapshot.json\" | grep -F NEXUS >/dev/null\n\n# Create the log before starting the background process. Bash may schedule the\n# next command before the child's redirection creates this file.\n: > \"$TMP/server.out\"\nnode \"$(dirname \"$0\")/package-smoke-server.mjs\" > \"$TMP/server.out\" 2>&1 &\nSERVER_PID=$!\ntrap 'kill \"$SERVER_PID\" 2>/dev/null || true; rm -rf \"$TMP\"' EXIT\nfor _ in $(seq 1 50); do\n  PORT=$(sed -n 's/^PORT=//p' \"$TMP/server.out\" | head -n 1)\n  [ -n \"$PORT\" ] && break\n  sleep 0.1\ndone\n[ -n \"${PORT:-}\" ] || { cat \"$TMP/server.out\" >&2; echo \"inference fixture did not start\" >&2; exit 1; }\nmkdir -p \"$TMP/home\" \"$TMP/work\"\nset +e\nHOME=\"$TMP/home\" LOCAL_LLM_ENDPOINT=\"http://127.0.0.1:$PORT/v1\" LOCAL_LLM_MODEL=package-smoke LOCAL_LLM_API_KEY=REDACTED \\\n  \"$NEXUS\" run \"Reply exactly with NEXUS_PACKAGE_SMOKE_OK and make no changes.\" --json --max-steps 1 --max-total-steps 1 --no-continuation --workspace \"$TMP/work\" > \"$TMP/run.json\"\nRUN_STATUS=$?\nset -e\ngrep -F NEXUS_PACKAGE_SMOKE_OK \"$TMP/run.json\" >/dev/null || { cat \"$TMP/run.json\" >&2; echo \"installed client did not complete inference smoke\" >&2; exit 1; }\n[ \"$RUN_STATUS\" -eq 0 ] || [ \"$RUN_STATUS\" -eq 2 ] || { echo \"unexpected inference smoke exit status: $RUN_STATUS\" >&2; exit 1; }\nkill \"$SERVER_PID\" 2>/dev/null || true\nwait \"$SERVER_PID\" 2>/dev/null || true\nprintf 'PACKAGE_SMOKE_PASS %s\\n' \"$ARCHIVE\"\n1-#!/usr/bin/env bash\n2-set -euo pipefail\n3-\n4:# An externally selected package tool may target a separate immutable RC checkout, but it must\n5-# still run from that checkout so version, source and lockfile identity stay bound together.\n6-ROOT=${NEXUS_PACKAGE_SOURCE:-$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)}\n7-ROOT=$(cd \"$ROOT\" && pwd -P)\n8-if [[ -n \"${NEXUS_PACKAGE_SOURCE:-}\" ]]; then\n9-  CALLER_ROOT=$(git rev-parse --show-toplevel)\n10-  SOURCE_ROOT=$(git -C \"$ROOT\" rev-parse --show-toplevel)\n11-  if [[ \"$ROOT\" != \"$CALLER_ROOT\" || \"$ROOT\" != \"$SOURCE_ROOT\" ]]; then\n12-    echo \"NEXUS_PACKAGE_SOURCE must be the current Git worktree root\" >&2\n13-    exit 2\n14-  fi\n15-fi\n16:VERSION=${1:?usage: package-linux.sh VERSION OUTPUT_DIR}\n17:OUT=${2:?usage: package-linux.sh VERSION OUTPUT_DIR}\n18-APPROVED_RUST_BUILD_IMAGE='rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb'\n19-case \"$VERSION\" in v[0-9]*.[0-9]*.[0-9]*) ;; *) echo \"version must look like v1.2.3\" >&2; exit 2 ;; esac\n20-if [[ -z \"${NEXUS_BUILD_CONTAINER_IMAGE:-}\" ]]; then\n21-  if [[ \"${NEXUS_ALLOW_HOST_RUST_BUILD:-}\" != \"1\" ]]; then\n22-    echo \"NEXUS_BUILD_CONTAINER_IMAGE must use the approved digest-pinned Rust 1.95 Bookworm builder (set NEXUS_ALLOW_HOST_RUST_BUILD=1 only for local development)\" >&2\n23-    exit 2\n24-  fi\n25-elif [[ \"$NEXUS_BUILD_CONTAINER_IMAGE\" != \"$APPROVED_RUST_BUILD_IMAGE\" ]]; then\n--\n41-  fi\n42-  command -v docker >/dev/null || { echo \"docker is required for the pinned Rust build image\" >&2; exit 2; }\n43-  mkdir -p \"$WORK/rust-build\"\n44-  docker run --rm --pull=always --platform linux/amd64 \\\n45-    --user \"$(id -u):$(id -g)\" \\\n46-    --mount \"type=bind,src=$ROOT,dst=/nexus-source,readonly\" \\\n47-    --mount \"type=bind,src=$WORK/rust-build,dst=/nexus-build\" \\\n48-    --workdir /nexus-source \\\n49:    --env HOME=/tmp/nexus-package-build-home \\\n50-    --env CARGO_HOME=/nexus-build/cargo-home \\\n51-    --env CARGO_TARGET_DIR=/nexus-build/target \\\n52-    --env RUSTUP_HOME=/usr/local/rustup \\\n53-    \"$NEXUS_BUILD_CONTAINER_IMAGE\" \\\n54-    cargo build --locked --release --manifest-path /nexus-source/core/Cargo.toml --bin harness-core --bin nexus-tui\n55-  RUST_CORE_TARGET=\"$WORK/rust-build/target/release\"\n56-else\n57-  cargo build --locked --release --manifest-path \"$ROOT/core/Cargo.toml\" --bin harness-core --bin nexus-tui\n58-  RUST_CORE_TARGET=\"$ROOT/core/target/release\"\n59-fi\n60-\n61-PKG=\"$WORK/nexus\"\n62-mkdir -p \"$PKG/bin\" \"$PKG/lib/core\" \"$PKG/lib/cli\"\n63-cp -R \"$ROOT/cli/dist\" \"$PKG/lib/cli/dist\"\n64:cp \"$ROOT/cli/package.json\" \"$ROOT/cli/package-lock.json\" \"$PKG/lib/cli/\"\n65-npm ci --omit=dev --prefix \"$PKG/lib/cli\"\n66-cp \"$RUST_CORE_TARGET/harness-core\" \"$RUST_CORE_TARGET/nexus-tui\" \"$PKG/lib/core/\"\n67:command -v readelf >/dev/null || { echo \"readelf is required to verify package glibc compatibility\" >&2; exit 2; }\n68-for binary in \"$PKG/lib/core/harness-core\" \"$PKG/lib/core/nexus-tui\"; do\n69-  required_glibc=$(readelf --version-info --wide \"$binary\" | grep -oE 'Name: GLIBC_[0-9]+(\\.[0-9]+)+' | sed 's/.*GLIBC_//' | sort -V | tail -n 1)\n70-  if [[ -n \"$required_glibc\" ]]; then\n71-    IFS=. read -r glibc_major glibc_minor _ <<< \"$required_glibc\"\n72-    if (( glibc_major > 2 || (glibc_major == 2 && glibc_minor > 35) )); then\n73-      echo \"$binary requires GLIBC_$required_glibc, above the GLIBC_2.35 compatibility ceiling\" >&2\n74-      exit 1\n75-    fi\n--\n81-SOURCE_DATE_EPOCH=$(git -C \"$ROOT\" log -1 --format=%ct)\n82-export SOURCE_DATE_EPOCH\n83-GIT_COMMIT=$(git -C \"$ROOT\" rev-parse HEAD)\n84-BUILD_DATE=$(date -u -d \"@$SOURCE_DATE_EPOCH\" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r \"$SOURCE_DATE_EPOCH\" +%Y-%m-%dT%H:%M:%SZ)\n85-ARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\n86-STATE_SCHEMA_VERSION=$(node --input-type=module - \"$PKG/lib/cli/dist/core/state.js\" <<'EOF'\n87-import { pathToFileURL } from 'node:url';\n88-const { CURRENT_STATE_SCHEMA_VERSION: version } = await import(pathToFileURL(process.argv[2]).href);\n89:if (!Number.isSafeInteger(version) || version < 1) throw new Error('packaged client has no valid state schema');\n90-process.stdout.write(String(version));\n91-EOF\n92-)\n93-\n94-# Embed the compatibility contract in the attested archive. The detached asset\n95-# adds the archive digest after the archive is built and is covered by SHA256SUMS.\n96-cat > \"$PKG/compatibility.json\" <<EOF\n97-{\n98-  \"schemaVersion\": 1,\n99-  \"product\": \"nexus-code\",\n100-  \"version\": \"${VERSION#v}\",\n101-  \"revision\": \"$GIT_COMMIT\",\n102-  \"builtAt\": \"$BUILD_DATE\",\n103-  \"minimumUpdaterVersion\": \"0.1.0-alpha.2\",\n104:  \"components\": {\n105-    \"cli\": \"${VERSION#v}\",\n106-    \"core\": \"${VERSION#v}\",\n107-    \"tui\": \"${VERSION#v}\",\n108-    \"harness\": \"${VERSION#v}\"\n109-  },\n110-  \"compatibility\": {\n111-    \"configSchemaVersion\": 1,\n112-    \"stateSchemaVersion\": $STATE_SCHEMA_VERSION,\n--\n118-      \"archive\": \"$ARCHIVE\",\n119-      \"os\": \"linux\",\n120-      \"arch\": \"x86_64\",\n121-      \"libc\": \"glibc-2.35\"\n122-    }\n123-  }\n124-}\n125-EOF\n126:node \"$ROOT/scripts/validate_compatibility.mjs\" \"$PKG/compatibility.json\"\n127-\n128:cargo about generate -m \"$ROOT/core/Cargo.toml\" -c \"$ROOT/about.toml\" \"$ROOT/about.hbs\" > \"$WORK/notices-rust.txt\"\n129-# Keep the full release-tool dependency graph fixed across the RC builds.\n130-RELEASE_TOOLS=\"$WORK/release-tools\"\n131-mkdir -p \"$RELEASE_TOOLS\"\n132:cp \"$ROOT/scripts/release-tools/package.json\" \"$ROOT/scripts/release-tools/package-lock.json\" \"$RELEASE_TOOLS/\"\n133:node \"$ROOT/scripts/check_deprecated_lock.mjs\" \"$ROOT/scripts/release-tools/package-lock.json\"\n134-npm ci --ignore-scripts --prefix \"$RELEASE_TOOLS\"\n135-RELEASE_TOOLS_BIN=\"$RELEASE_TOOLS/node_modules/.bin\"\n136:\"$RELEASE_TOOLS_BIN/license-checker-rseidelsohn\" --production --plainVertical --start \"$PKG/lib/cli\" > \"$WORK/notices-npm.txt\"\n137-cat > \"$PKG/THIRD_PARTY_NOTICES.txt\" <<'EOF'\n138-================================================================================\n139-Nexus Code Third-Party Software Notices and Licenses\n140-================================================================================\n141-\n142:This package contains third-party software components licensed under open-source\n143:licenses. The following sections provide notices and license texts for all\n144-runtime and statically-linked dependencies included in this distribution.\n145-\n146-================================================================================\n147-Section 1: Rust Components (harness-core & nexus-tui)\n148-================================================================================\n149-EOF\n150:cat \"$WORK/notices-rust.txt\" >> \"$PKG/THIRD_PARTY_NOTICES.txt\"\n151-cat >> \"$PKG/THIRD_PARTY_NOTICES.txt\" <<'EOF'\n152-\n153-================================================================================\n154-Section 2: Node.js / npm Components (CLI Runtime)\n155-================================================================================\n156-EOF\n157:cat \"$WORK/notices-npm.txt\" >> \"$PKG/THIRD_PARTY_NOTICES.txt\"\n158-cp \"$PKG/THIRD_PARTY_NOTICES.txt\" \"$OUT/THIRD_PARTY_NOTICES.txt\"\n159-cat > \"$PKG/bin/nexus\" <<'EOF'\n160-#!/bin/sh\n161-set -eu\n162-NEXUS_HOME=$(CDPATH= cd -- \"$(dirname -- \"$(readlink -f -- \"$0\")\")/..\" && pwd)\n163-export NEXUS_HOME\n164-if [ -z \"${NODE_EXTRA_CA_CERTS:-}\" ] && [ -n \"${HOME:-}\" ] && [ -f \"$HOME/.config/nexus/config.env\" ]; then\n165-  _ca=$(sed -n 's/^[[:space:]]*NODE_EXTRA_CA_CERTS[[:space:]]*=[[:space:]]*//p' \"$HOME/.config/nexus/config.env\" | tail -n 1 | sed \"s/^['\\\"]//;s/['\\\"]$//\")\n--\n172-  unset _ca\n173-fi\n174-exec node \"$NEXUS_HOME/lib/cli/dist/index.js\" \"$@\"\n175-EOF\n176-chmod 0755 \"$PKG/bin/nexus\" \"$PKG/lib/core/harness-core\" \"$PKG/lib/core/nexus-tui\"\n177-(cd \"$PKG\" && find . -type f ! -name MANIFEST.sha256 | LC_ALL=C sort | xargs sha256sum > MANIFEST.sha256)\n178-# The RC build runs on multiple Ubuntu images. Their host tar versions encode\n179-# the unused PAX device-number fields differently, which changes the archive\n180:# digest even when every packaged file is identical. Use the same digest-pinned\n181-# image as the Rust build for tar and gzip so the complete archive format is\n182-# independent of the host runner. The explicitly opted-in local development\n183-# path remains host-built and must not be used as reproducibility evidence.\n184-if [[ -n \"${NEXUS_BUILD_CONTAINER_IMAGE:-}\" ]]; then\n185-  docker run --rm --pull=always --platform linux/amd64 \\\n186-    --user \"$(id -u):$(id -g)\" \\\n187:    --mount \"type=bind,src=$WORK,dst=/nexus-package,readonly\" \\\n188-    --mount \"type=bind,src=$OUT,dst=/nexus-output\" \\\n189:    --workdir /nexus-package \\\n190-    --env \"SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH\" \\\n191-    --env \"ARCHIVE=$ARCHIVE\" \\\n192-    \"$NEXUS_BUILD_CONTAINER_IMAGE\" \\\n193-    sh -ec 'tmp=$(mktemp); tar --sort=name --format=pax --mtime=\"@$SOURCE_DATE_EPOCH\" --owner=0 --group=0 --numeric-owner --pax-option=delete=atime,delete=ctime -cf \"$tmp\" nexus; gzip -n -c \"$tmp\" > \"/nexus-output/$ARCHIVE\"'\n194-else\n195-  tar --sort=name --format=pax --mtime=\"@$SOURCE_DATE_EPOCH\" --owner=0 --group=0 --numeric-owner \\\n196-    --pax-option=delete=atime,delete=ctime -C \"$WORK\" -cf - nexus | gzip -n > \"$OUT/$ARCHIVE\"\n197-fi\n198-\n199:# The detached metadata repeats only the authenticated in-archive contract and\n200-# adds the digest of the exact archive. The release checksum index covers both.\n201-ARCHIVE_SHA=$(sha256sum \"$OUT/$ARCHIVE\" | awk '{print $1}')\n202-node - \"$PKG/compatibility.json\" \"$OUT/compatibility.json\" \"$ARCHIVE\" \"$ARCHIVE_SHA\" <<'NODE'\n203-const fs = require(\"node:fs\");\n204-const [source, destination, archive, sha256] = process.argv.slice(2);\n205:const metadata = JSON.parse(fs.readFileSync(source, \"utf8\"));\n206:metadata.platforms[\"linux-x86_64\"].sha256 = sha256;\n207:if (metadata.platforms[\"linux-x86_64\"].archive !== archive) throw new Error(\"compatibility archive name mismatch\");\n208:fs.writeFileSync(destination, `${JSON.stringify(metadata, null, 2)}\\n`);\n209-NODE\n210-(cd \"$OUT\" && sha256sum \"$ARCHIVE\" compatibility.json > SHA256SUMS)\n211-\n212:# Generate lockfile-derived merged CycloneDX SBOM (REQ-REL-108, ACC-SUP-02)\n213-\"$ROOT/scripts/generate_sbom.sh\" \"$OUT/sbom.cdx.json\"\n214-\n215-# Publish install.sh as release asset (REQ-REL-109)\n216-cp \"$ROOT/install.sh\" \"$OUT/install.sh\"\n217-\n218:node \"$ROOT/scripts/validate_compatibility.mjs\" \"$OUT/compatibility.json\" --require-digest\n219-\n220-printf 'Built %s\\n' \"$OUT/$ARCHIVE\"\nrelease body differs from source notes\nnexus/\nnexus/LICENSE\nnexus/MANIFEST.sha256\nnexus/THIRD_PARTY_NOTICES.txt\nnexus/VERSION\nnexus/bin/\nnexus/bin/nexus\nnexus/compatibility.json\nnexus/lib/\nnexus/lib/cli/\nnexus/lib/cli/dist/\nnexus/lib/cli/dist/agent.js\nnexus/lib/cli/dist/approval_review.js\nnexus/lib/cli/dist/browser.js\nnexus/lib/cli/dist/build-info.json\n","exit_code":0,"duration":{"secs":1,"nanos":850574622}},"started_at_ms":1793354736065,"completed_at_ms":1793354737922}}
{"timestamp":"2026-10-30T10:05:38.450Z","ordinal":527714,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18c45-ab12-7a22-a642-eef67b4889a8","call_id":"call_12ffc9d8050845b29521d0745d46e68c","output":[{"type":"input_text","text":"Script completed\nWall time 2.8 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 4057)\nTotal output lines: 305\n\n#!/usr/bin/env bash\nset -euo pipefail\nARCHIVE=${1:?usage: smoke-package.sh ARCHIVE}\nTMP=$(mktemp -d)\ntrap 'rm -rf \"$TMP\"' EXIT\ntar -xzf \"$ARCHIVE\" -C \"$TMP\"\nNEXUS=\"$TMP/nexus/bin/nexus\"\nVERSION=$(cat \"$TMP/nexus/VERSION\")\n\"$NEXUS\" --version | grep -F \"${VERSION#v}\" >/dev/null\n\"$NEXUS\" --help >/dev/null\nset +e\nmkdir -p \"$TMP/doctor-home\"\nHOME=\"$TMP/doctor-home\" \"$NEXUS\" doctor --json > \"$TMP/doctor.json\"\nDOCTOR_STATUS=$?\nset -e\n[ \"$DOCTOR_STATUS\" -le 2 ] || { cat \"$TMP/doctor.json\" >&2; echo \"packaged doctor failed to run\" >&2; exit 1; }\nnode -e 'const d=require(process.argv[1]); if (d.schemaVersion !== 2) process.exit(1)' \"$TMP/doctor.json\"\n# One version everywhere (REQ-REL-103): a fresh install's engine check passes, never a version warning.\nnode -e 'const d=require(process.argv[1]); const e=d.findings.find((f)=>f.id===\"engine.binary\"); if (!e || e.status!==\"pass\") { console.error(JSON.stringify(e)); process.exit(1) }' \"$TMP/doctor.json\"\n\n# ACC-PKG-06: nexus doctor 2>err; test ! -s err on a healthy fixture install\nset +e\nHOME=\"$TMP/doctor-home\" \"$NEXUS\" doctor 2>\"$TMP/doctor.err\" >/dev/null\nDOCTOR_RUN_STATUS=$?\nset -e\n[ \"$DOCTOR_RUN_STATUS\" -le 2 ] || { cat \"$TMP/doctor.err\" >&2; echo \"doctor failed to run\" >&2; exit 1; }\n[ ! -s \"$TMP/doctor.err\" ] || { cat \"$TMP/doctor.err\" >&2; echo \"doctor emitted stderr on healthy install\" >&2; exit 1; }\n\n# ACC-PKG-07: packaged doctor remedies contain no make or harness.sh\nif grep -E \"make|harness\\.sh\" \"$TMP/doctor.json\" >/dev/null; then\n  echo \"packaged doctor JSON contains make or harness.sh remedy\" >&2\n  exit 1\nfi\n\n# ACC-PKG-01: PTY launch of the installed nexus asserts the TUI header and idle hint\npython3 \"$(dirname \"$0\")/package-smoke-pty.py\" \"$NEXUS\" > \"$TMP/pty.out\"\ngrep -F \"NEXUS\" \"$TMP/pty.out\" >/dev/null || { cat \"$TMP/pty.out\" >&2; echo \"PTY launch missing TUI header\" >&2; exit 1; }\ngrep -E \"(ask Nexus|commands|enter send)\" \"$TMP/pty.out\" >/dev/null || { cat \"$TMP/pty.out\" >&2; echo \"PTY launch missing idle hint\" >&2; exit 1; }\n\n# ACC-PKG-01: nexus repl gives the REPL prompt\nprintf '/exit\\n' | \"$NEXUS\" repl > \"$TMP/repl.out\" 2>&1\ngrep -E \"(nexus|❯)\" \"$TMP/repl.out\" >/dev/null || { cat \"$TMP/repl.out\" >&2; echo \"nexus repl did not render REPL prompt\" >&2; exit 1; }\n\n# ACC-PKG-01: </dev/null nexus gives the REPL\n\"$NEXUS\" </dev/null > \"$TMP/null.out\" 2>&1\ngrep -E \"(nexus|❯)\" \"$TMP/null.out\" >/dev/null || { cat \"$TMP/null.out\" >&2; echo \"</dev/null nexus did not render REPL prompt\" >&2; exit 1; }\n\n# ACC-PKG-02: doc-command extraction test passes against the package\nnode \"$(dirname \"$0\")/doc_commands.mjs\" \"$NEXUS\"\n\n# ACC-SUP-01: archive contains THIRD_PARTY_NOTICES.txt covering full dependency closure\ntest -s \"$TMP/nexus/THIRD_PARTY_NOTICES.txt\"\nnode \"$(dirname \"$0\")/check_notices.mjs\" \"$TMP/nexus/THIRD_PARTY_NOTICES.txt\"\n\ntest -x \"$TMP/nexus/lib/core/harness-core\"\ntest -x \"$TMP/nexus/lib/core/nexus-tui\"\nnode --input-type=module - \"$TMP/nexus/lib/cli/dist/tools.js\" \"$TMP/nexus/lib/core/harness-core\" \"$TMP/nexus/compatibility.json\" \"$TMP/nexus/lib/cli/dist/core/state.js\" <<'EOF'\nimport { pathToFileURL } from 'node:url';\nimport fs from 'node:fs';\nconst moduleUrl = pathToFileURL(process.argv[2]).href;\nprocess.env.NEXUS_HOME = process.argv[3].replace(/\\/lib\\/core\\/harness-core$/, '');\nconst { resolveCoreBinary } = await import(moduleUrl);\nif (resolveCoreBinary() !== process.argv[3]) throw new Error('packaged core resolution failed');\nconst { CURRENT_STATE_SCHEMA_VERSION } = await import(pathToFileURL(process.argv[5]).href);\nconst metadata = JSON.parse(fs.readFileSync(process.argv[4], 'utf8'));\nif (metadata.compatibility.stateSchemaVersion !== CURRENT_STATE_SCHEMA_VERSION) throw new Error('packaged state schema disagrees with compatibility metadata');\nEOF\n\"$TMP/nexus/lib/core/harness-core\" --help >/dev/null\ncat > \"$TMP/snapshot.json\" <<'EOF'\n{\"model\":\"smoke\",\"workspace\":\"/tmp\",\"task_id\":\"smoke\",\"objective\":\"package smoke\",\"activity\":[],\"plan\":[],\"validation\":null,\"context\":\"0 messages\",\"status\":\"IDLE\",\"theme\":\"default\"}\nEOF\n\"$TMP/nexus/lib/core/nexus-tui\" --plain \"$TMP/snapshot.json\" | grep -F NEXUS >/dev/null\n\n# Create the log before starting the background process. Bash may schedule the\n# next command before the child's redirection creates this file.\n: > \"$TMP/server.out\"\nnode \"$(dirname \"$0\")/package-smoke-server.mjs\" > \"$TMP/server.out\" 2>&1 &\nSERVER_PID=$!\ntrap 'kill \"$SERVER_PID\" 2>/dev/null || true; rm -rf \"$TMP\"' EXIT\nfor _ in $(seq 1 50); do\n  PORT=$(sed -n 's/^PORT=//p' \"$TMP/server.out\" | head -n 1)\n  [ -n \"$PORT\" ] && break\n  sleep 0.1\ndone\n[ -n \"${PORT:-}\" ] || { cat \"$TMP/server.out\" >&2; echo \"inference fixture did not start\" >&2; exit 1; }\nmkdir -p \"$TMP/home\" \"$TMP/work\"\nset +e\nHOME=\"$TMP/home\" LOCAL_LLM_ENDPOINT=\"http://127.0.0.1:$PORT/v1\" LOCAL_LLM_…1657 tokens truncated… Third-Party Software Notices and Licenses\n140-================================================================================\n141-\n142:This package contains third-party software components licensed under open-source\n143:licenses. The following sections provide notices and license texts for all\n144-runtime and statically-linked dependencies included in this distribution.\n145-\n146-===============================================================