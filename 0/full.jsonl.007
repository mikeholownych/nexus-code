a mismatched expected peer version\", async () => {\n259:test(\"qualification refuses peer output limits that differ from the installed Nexus limit\", async () => {\n268:test(\"qualification separates native context discovery from explicit operator overrides\", async () => {\n312:test(\"--pairs reports only model-, limit-, and budget-matched Nexus, Goose, and OpenCode runs\", () => {\n316:    const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), \"--pairs\", ...files, \"--json\"], { encoding: \"utf8\" });\n327:test(\"--pairs rejects a peer run with a different model fingerprint or effective budget\", () => {\n342:      const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), \"--pairs\", ...files, \"--json\"], { encoding: \"utf8\" });\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18c35-b249-7353-ae41-f481d8a53b29","create_time":1793353743.991779}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
