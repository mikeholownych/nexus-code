es/assets/691680067\",\"contentType\":\"application/x-sh\",\"createdAt\":\"2026-10-30T10:01:33Z\",\"digest\":\"sha256:b243cda661eb0a57890435cfa2170fb50ea8e507aeec595d364d3f2ce71c8125\",\"downloadCount\":0,\"id\":\"RA_kwDOVGxXKc4pOjND\",\"label\":\"\",\"name\":\"install.sh\",\"size\":10642,\"state\":\"uploaded\",\"updatedAt\":\"2026-10-30T10:01:33Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.14/install.sh\"},{\"apiUrl\":\"https://api.github.com/repos/mikeholownych/nexus-code/releases/assets/691680063\",\"contentType\":\"application/gzip\",\"createdAt\":\"2026-10-30T10:01:33Z\",\"digest\":\"sha256:52d1c855158c63dbc7cac2e9d87e2f64b1feffb193de97660e92276a2bd46eb7\",\"downloadCount\":0,\"id\":\"RA_kwDOVGxXKc4pOjM_\",\"label\":\"\",\"name\":\"nexus-linux-x86_64-v1.0.0-rc.14.tar.gz\",\"size\":4913202,\"state\":\"uploaded\",\"updatedAt\":\"2026-10-30T10:01:33Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/releases/download/v1.0.0-rc.14/nexus-linux-x86_64-v1.0.0-rc.14.tar.gz\"},{\"apiUrl\":\"https://api.github.com/repos/mikeholownych/nexus-code/releases/assets/691680071\",\"contentType\":\"application/json\",\"createdAt\":\"2026-10-30T10:01:33Z\",\"digest\":\"sha256:e5949950f523b303ca46e6dc4ce46aa01ce95274d582078537b9f70379c0d6bd\",\"downloadCount\":0,\"id\":\"RA_kwDO","exit_code":0,"duration":{"secs":1,"nanos":199545551}},"started_at_ms":1793354524407,"completed_at_ms":1793354525607}}
