{"timestamp":"2026-10-30T10:02:47.743Z","ordinal":527579,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18c3d-7cdd-71d3-966d-f30f05df4fb0","item":{"type":"CommandExecution","id":"exec-54097786-2ab4-48a7-8fd2-0f1ac2b7d971","process_id":"85179","command":["/usr/bin/zsh","-lc","sed -n '1,130p' install.sh; sed -n '1,80p' quickstart.md; gh attestation verify --help | sed -n '1,100p'; git verify-tag v1.0.0-rc.14"],"cwd":"file:///home/mike/nexus-wt/rc14-artifact-verification","parsed_cmd":[{"type":"unknown","cmd":"sed -n '1,130p' install.sh; sed -n '1,80p' quickstart.md; gh attestation verify --help | sed -n '1,100p'; git verify-tag v1.0.0-rc.14"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"#!/bin/sh\nset -eu\n\nREPO=mikeholownych/nexus-code\nBASE=${NEXUS_RELEASE_BASE_URL:-\"https://github.com/$REPO/releases\"}\nVERSION=${NEXUS_VERSION:-latest}\nPREFIX=${NEXUS_PREFIX:-\"$HOME/.local\"}\n\nfail() { printf 'nexus installer: %s\\n' \"$*\" >&2; exit 1; }\ncase \"$(uname -s):$(uname -m)\" in\n  Linux:x86_64|Linux:amd64) ;;\n  *) fail \"unsupported system $(uname -s)/$(uname -m); supported: Linux x86-64 (glibc).\" ;;\nesac\ncommand -v node >/dev/null 2>&1 || fail \"Node.js 22 or newer is required; install Node.js and retry.\"\nNODE_MAJOR=$(node -p 'Number(process.versions.node.split(\".\")[0])' 2>/dev/null || printf 0)\n[ \"$NODE_MAJOR\" -ge 22 ] || fail \"Node.js 22 or newer is required (found $(node --version 2>/dev/null || echo unknown)).\"\ncommand -v curl >/dev/null 2>&1 || fail \"curl is required.\"\ncommand -v tar >/dev/null 2>&1 || fail \"tar is required.\"\ncommand -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n\nVERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION-auto}\ncase \"$VERIFY_ATTESTATION\" in\n  auto|0|1) ;;\n  *) fail \"NEXUS_VERIFY_ATTESTATION must be auto (verify when a trusted GitHub CLI is present), 1 (require verification) or 0 (skip verification).\" ;;\nesac\nTRUSTED_GH=\nif [ -x /usr/bin/gh ]; then\n  TRUSTED_GH=/usr/bin/gh\nelif [ -x /usr/local/bin/gh ]; then\n  TRUSTED_GH=/usr/local/bin/gh\nfi\nif [ \"$VERIFY_ATTESTATION\" = \"1\" ] && [ -z \"$TRUSTED_GH\" ]; then\n  fail \"provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\"\nfi\n\nvalidate_tag() {\n  printf '%s' \"$1\" | grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\"\n}\n\nif [ \"$VERSION\" != \"latest\" ]; then\n  validate_tag \"$VERSION\"\nfi\n\nif [ \"$VERSION\" = \"latest\" ]; then\n  API_BASE=${NEXUS_RELEASES_API:-\"https://api.github.com/repos/$REPO/releases\"}\n  API_TMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-api.XXXXXX\") || fail \"could not create temporary directory.\"\n  api_cleanup() { rm -rf \"$API_TMP\"; }\n  trap api_cleanup EXIT HUP INT TERM\n\n  LATEST_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -D \"$API_TMP/headers\" -o \"$API_TMP/latest.json\" -w \"%{http_code}\" \"$API_BASE/latest\" 2>\"$API_TMP/curl.err\" || echo \"000\")\n\n  if [ \"$LATEST_CODE\" = \"200\" ]; then\n    VERSION=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/latest.json\" | head -n 1)\n    [ -n \"$VERSION\" ] || fail \"GitHub returned no stable release tag.\"\n    validate_tag \"$VERSION\"\n  elif [ \"$LATEST_CODE\" = \"403\" ]; then\n    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \"$API_TMP/headers\" 2>/dev/null; then\n      fail \"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\"\n    fi\n    fail \"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\"\n  elif [ \"$LATEST_CODE\" = \"404\" ]; then\n    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \"$API_TMP/releases.json\" -w \"%{http_code}\" \"$API_BASE?per_page=1\" 2>/dev/null || echo \"000\")\n    if [ \"$PREREL_CODE\" = \"200\" ]; then\n      PREREL_TAG=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/releases.json\" | head -n 1)\n      if [ -n \"$PREREL_TAG\" ]; then\n        fail \"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\"\n      fi\n    fi\n    fail \"could not find latest stable release (HTTP 404 from $API_BASE/latest).\"\n  else\n    fail \"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\"\n  fi\n  rm -rf \"$API_TMP\"\n  trap - EXIT HUP INT TERM\nfi\n\nARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\nNORMALIZED_VERSION=${VERSION#v}\nURL=\"$BASE/download/$VERSION\"\nTMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-install.XXXXXX\") || fail \"could not create temporary directory.\"\ncleanup() { rm -rf \"$TMP\"; }\ntrap cleanup EXIT HUP INT TERM\ncurl -fsSL --show-error --retry 2 \"$URL/$ARCHIVE\" -o \"$TMP/$ARCHIVE\" || fail \"download failed for $ARCHIVE.\"\ncurl -fsSL --show-error --retry 2 \"$URL/SHA256SUMS\" -o \"$TMP/SHA256SUMS\" || fail \"could not download release checksums.\"\ngrep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksum entry for $ARCHIVE is missing.\"\n(cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\nARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n\nif [ \"$VERIFY_ATTESTATION\" != \"0\" ] && [ -n \"$TRUSTED_GH\" ]; then\n  if \"$TRUSTED_GH\" attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n     \"$TRUSTED_GH\" attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n    printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n  elif [ \"$VERIFY_ATTESTATION\" = \"1\" ]; then\n    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n  else\n    printf 'nexus installer: build provenance was not verified: %s could not verify the attestation (it may need gh auth login); the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' \"$TRUSTED_GH\" >&2\n  fi\nelif [ \"$VERIFY_ATTESTATION\" = \"auto\" ]; then\n  printf 'nexus installer: build provenance was not verified: no trusted GitHub CLI at /usr/bin/gh or /usr/local/bin/gh; the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' >&2\nfi\n\nVERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\nBIN_DIR=\"$PREFIX/bin\"\nLINK=\"$BIN_DIR/nexus\"\nmkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\nif [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n  fail \"$LINK exists and is not a symlink; left it unchanged.\"\nfi\nif [ -L \"$LINK\" ]; then\n  OLD=$(readlink \"$LINK\")\n  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\nfi\n\nFORCE=${NEXUS_FORCE:-0}\nNEEDS_EXTRACT=1\nif [ -d \"$VERSION_DIR\" ] && [ \"$FORCE\" != \"1\" ]; then\n  if [ -x \"$VERSION_DIR/bin/nexus\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/harness-core\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/nexus-tui\" ] && \\\n     [ \"$(cat \"$VERSION_DIR/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ]; then\n    if [ -f \"$VERSION_DIR/MANIFEST.sha256\" ]; then\n      if (cd \"$VERSION_DIR\" && sha256sum --check --status MANIFEST.sha256 2>/dev/null); then\n        NEEDS_EXTRACT=0\n      fi\n      if [ \"$NEEDS_EXTRACT\" = \"0\" ]; then\n        if ! node - \"$VERSION_DIR/.provenance.json\" \"$ARCHIVE_SHA256\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [file, archiveSha256] = process.argv.slice(2);\ntry {\n  const record = JSON.parse(fs.readFileSync(file, \"utf8\"));\n# Nexus Code quickstart\n\nNexus Code is a local coding client. It is separate from the Cloudflare Workers and Artifacts collaboration service in the contest entry.\n\n## Install\n\nOn Linux x86-64 with glibc 2.35 or newer and Node.js 22 or newer:\n\n```sh\ncurl -fsSL https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh | sh\n```\n\nThe installer downloads the matching versioned client archive and `SHA256SUMS` from this repository's GitHub Release, verifies the archive, and installs under `~/.local/lib/nexus`. It adds a `nexus` symlink in `~/.local/bin`; it does not edit shell startup files or use root. If `~/.local/bin` is not in `PATH`, add it yourself:\n\n```sh\nexport PATH=\"$HOME/.local/bin:$PATH\"\n```\n\nWithout `NEXUS_VERSION`, the installer follows the latest stable release. If no stable release has been published yet, the installer exits with a hint to select a prerelease tag from [GitHub Releases](https://github.com/mikeholownych/nexus-code/releases). To install a prerelease or pin a version, set `NEXUS_VERSION` to its published tag. The `v1.0.0-rc.1` example below works after that tag appears on [GitHub Releases](https://github.com/mikeholownych/nexus-code/releases); before then, replace it with a prerelease tag already listed there:\n\n```sh\ncurl -fsSL https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh | NEXUS_VERSION=v1.0.0-rc.1 sh\n```\n\nFor inspect-before-running, download [install.sh](https://raw.githubusercontent.com/mikeholownych/nexus-code/main/install.sh), read it, then run `sh install.sh`.\n\nThe release package includes the TypeScript client, production Node dependencies, `harness-core`, and the Ratatui `nexus-tui` binary. Node is an external runtime prerequisite. Current release support is limited to Linux x86-64/glibc; macOS, Windows, ARM, musl, and other architectures are not claimed.\n\n## Configure an inference endpoint\n\nNexus works with an OpenAI-compatible local endpoint such as LM Studio or vLLM. Start that server and load a model first. For example:\n\n```sh\nmkdir -p \"$HOME/.config/nexus\"\nchmod 700 \"$HOME/.config/nexus\"\ncat > \"$HOME/.config/nexus/config.env\" <<'EOF'\nLOCAL_LLM_ENDPOINT=http://localhost:1234/v1\nLOCAL_LLM_MODEL=your-loaded-model\nLOCAL_LLM_API_KEY=REDACTED\nEOF\nchmod 600 \"$HOME/.config/nexus/config.env\"\n```\n\nUse your endpoint's actual model ID. Nexus automatically discovers the loaded context window from LM Studio (`/api/v0/models`), llama.cpp (`/props`), vLLM (`/v1/models`), and Ollama (`/api/show`), or you can override it with `--context-limit` (`NEXUS_CONTEXT_LIMIT`). For HTTPS servers using a private certificate authority, set `NODE_EXTRA_CA_CERTS=/path/to/ca.pem` in `~/.config/nexus/config.env`. Do not put real credentials in a project `.env`, shell history, or this example. See [Local servers](docs/LOCAL_SERVERS.md) for per-server setup and [Cloud providers](docs/CLOUD_PROVIDERS.md) for cloud provider and credential handling.\n\n## First run\n\nFrom a project directory:\n\n```sh\nnexus doctor\nnexus\n```\n\nEnter a small task, review requested actions, and inspect the reported turn outcome. On a terminal, running `nexus` with no arguments opens the live TUI; in non-interactive environments or with `nexus repl`, it opens the interactive REPL. For non-interactive tasks, run `nexus run \"<task>\"`. Use `nexus --help` and `/help` for implemented commands.\n\n### Folder trust and tool permissions\n\nBy default, Nexus opens in `review` posture, asking for your explicit confirmation before executing shell commands, file modifications, network egress, or test suites. Folder trust is separate: it controls whether project instructions and workspace integrations are loaded.\n\nIf this is your own repository and you want autonomous execution, trust it:\n\n```sh\nnexus trust .\n```\n\nTrusting a folder does not change its tool permission mode. Pass `--mode auto` to allow writes and commands without approval; network access still asks the first time each origin is used. Pass `--yes` (or set `NEXUS_APPROVAL_MODE=auto`) for full access without approval prompts, including network access. Use `--approve` or `--mode review` to require approval, and `--read-only` for read-only operation.\n\nNexus reports `VERIFIED` only when its selected verifier passes and the operator has declared the product files for that task before it starts. For example: `nexus run --deliverable-file src/math.ts \"Fix the addition defect\"`; repeat `--deliverable-file` for each expected product file. The scope must use literal workspace-relative paths and cannot name tests. A passing suite without a declared scope is regression evidence (`REGRESSION_FREE`), not proof that the requested product change was verified. `UNVERIFIED`, `BLOCKED`, and `LIMIT_REACHED` remain distinct outcomes; a completed model response alone does not mean the work is correct.\n\nResuming a saved session or durable task keeps verification pending because local session and task files do not authenticate their own history. No generic verifier is currently trusted to clear that obligation after recovery: even an external test runner can execute workspace-controlled tests. A resumed task may continue, but it remains `UNVERIFIED`. Before starting a new task to establish a new baseline, the operator must review the workspace state, including ignored and untracked files and verifier/test definitions, and restore or remove any state that is not trusted. A clean Git status alone does not establish that ignored files or external acceptance inputs are trustworthy. A future verifier could replace this manual boundary only after its implementation and acceptance inputs are independently bound outside candidate control. A current-invocation `--authoritative-verifier` alone does not clear recovered obligations.\n\n## Upgrade and remove\n\nCheck whether a newer release is published:\n\n```sh\nnexus upgrade --check\n```\n\nVerify the integrity and provenance of an artifact using its associated\ncryptographically signed attestations.\n\n## Understanding Verification\n\nAn attestation is a claim (i.e. a provenance statement) made by an actor\n(i.e. a GitHub Actions workflow) regarding a subject (i.e. an artifact).\n\nIn order to verify an attestation, you must provide an artifact and validate:\n* the identity of the actor that produced the attestation\n* the expected attestation predicate type (the nature of the claim)\n\nBy default, this command enforces the `https://slsa.dev/provenance/v1`\npredicate type. To verify other attestation predicate types use the\n`--predicate-type` flag.\n\nThe \"actor identity\" consists of:\n* the repository or the repository owner the artifact is linked with\n* the Actions workflow that produced the attestation (a.k.a the\n  signer workflow)\n\nThis identity is then validated against the attestation's certificate's\nSourceRepository, SourceRepositoryOwner, and SubjectAlternativeName\n(SAN) fields, among others.\n\nIt is up to you to decide how precisely you want to enforce this identity.\n\nAt a minimum, this command requires either:\n* the `--owner` flag (e.g. --owner github), or\n* the `--repo` flag (e.g. --repo github/example)\n\nThe more precisely you specify the identity, the more control you will\nhave over the security guarantees offered by the verification process.\n\nIdeally, the path of the signer workflow is also validated using the\n`--signer-workflow` or `--cert-identity` flags.\n\nPlease note: if your attestation was generated via a reusable workflow then\nthat reusable workflow is the signer whose identity needs to be validated.\nIn this situation, you must use either the `--signer-workflow` or\nthe `--signer-repo` flag.\n\nFor more options, see the other available flags.\n\n## Loading Artifacts And Attestations\n\nTo specify the artifact, this command requires:\n* a file path to an artifact, or\n* a container image URI (e.g. `oci://<image-uri>`)\n  * (note that if you provide an OCI URL, you must already be authenticated with\nits container registry)\n\nBy default, this command will attempt to fetch relevant attestations via the\nGitHub API using the values provided to `--owner` or  `--repo`.\n\nTo instead fetch attestations from your artifact's OCI registry, use the\n`--bundle-from-oci` flag.\n\nFor offline verification using attestations stored on disk (c.f. the download command)\nprovide a path to the `--bundle` flag.\n\nWhen you load attestations with `--bundle` or `--bundle-from-oci`, this command\ncompares the `--repo` or `--owner` value only with the repository and owner\nnames recorded in the attestation's certificate when the attestation was\ncreated. It cannot detect whether the repository or owner has since been\nrenamed, or whether a different repository or owner now uses that name. To\nconfirm that an attestation belongs to the repository or owner that currently\nhas the name, omit `--bundle` and `--bundle-from-oci` so that this command\nfetches attestations from the GitHub API.\n\n## Additional Policy Enforcement\n\nGiven the `--format=json` flag, upon successful verification this\ncommand will output a JSON array containing one entry per verified attestation.\n\nThis output can then be used for additional policy enforcement, i.e. by being\npiped into a policy engine.\n\nEach object in the array contains two properties:\n* an `attestation` object, which contains the bundle that was verified\n* a `verificationResult` object, which is a parsed representation of the\n  contents of the bundle that was verified.\n\nWithin the `verificationResult` object you will find:\n* `signature.certificate`, which is a parsed representation of the X.509\n  certificate embedded in the attestation,\n* `verifiedTimestamps`, an array of objects denoting when the attestation\n  was witnessed by a transparency log or a timestamp authority\n* `statement`, which contains the `subject` array referencing artifacts,\n  the `predicateType` field, and the `predicate` object which contains\n  additional, often user-controllable, metadata\n\nIMPORTANT: please note that only the `signature.certificate` and the\n`verifiedTimestamps` properties contain values that cannot be\nmanipulated by the workflow that originated the attestation.\n\nWhen dealing with attestations created within GitHub Actions, the contents of\n`signature.certificate` are populated directly from the OpenID Connect\ntoken that GitHub has generated. The contents of the `verifiedTimestamps`\narray are populated from the signed timestamps originating from either a\ngpg: Signature made Fri Oct 30 09:40:12 2026 UTC\ngpg:                using ECDSA key FAC522F6588C64266ABC7742140FD4DD53964C08\ngpg: Good signature from \"Mike Holownych <mike.holownych@aisyndicate.io>\" [ultimate]\n","exit_code":0,"duration":{"secs":1,"nanos":242379862}},"started_at_ms":1793354566500,"completed_at_ms":1793354567743}}
{"timestamp":"2026-10-30T10:02:47.940Z","ordinal":527580,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18c43-1104-7d31-94c3-6f39f12b6471","call_id":"call_f89eb2fbe888424983ab0760b1fcaeb4","output":[{"type":"input_text","text":"Script completed\nWall time 1.8 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 4321)\nTotal output lines: 313\n\n#!/bin/sh\nset -eu\n\nREPO=mikeholownych/nexus-code\nBASE=${NEXUS_RELEASE_BASE_URL:-\"https://github.com/$REPO/releases\"}\nVERSION=${NEXUS_VERSION:-latest}\nPREFIX=${NEXUS_PREFIX:-\"$HOME/.local\"}\n\nfail() { printf 'nexus installer: %s\\n' \"$*\" >&2; exit 1; }\ncase \"$(uname -s):$(uname -m)\" in\n  Linux:x86_64|Linux:amd64) ;;\n  *) fail \"unsupported system $(uname -s)/$(uname -m); supported: Linux x86-64 (glibc).\" ;;\nesac\ncommand -v node >/dev/null 2>&1 || fail \"Node.js 22 or newer is required; install Node.js and retry.\"\nNODE_MAJOR=$(node -p 'Number(process.versions.node.split(\".\")[0])' 2>/dev/null || printf 0)\n[ \"$NODE_MAJOR\" -ge 22 ] || fail \"Node.js 22 or newer is required (found $(node --version 2>/dev/null || echo unknown)).\"\ncommand -v curl >/dev/null 2>&1 || fail \"curl is required.\"\ncommand -v tar >/dev/null 2>&1 || fail \"tar is required.\"\ncommand -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n\nVERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION-auto}\ncase \"$VERIFY_ATTESTATION\" in\n  auto|0|1) ;;\n  *) fail \"NEXUS_VERIFY_ATTESTATION must be auto (verify when a trusted GitHub CLI is present), 1 (require verification) or 0 (skip verification).\" ;;\nesac\nTRUSTED_GH=\nif [ -x /usr/bin/gh ]; then\n  TRUSTED_GH=/usr/bin/gh\nelif [ -x /usr/local/bin/gh ]; then\n  TRUSTED_GH=/usr/local/bin/gh\nfi\nif [ \"$VERIFY_ATTESTATION\" = \"1\" ] && [ -z \"$TRUSTED_GH\" ]; then\n  fail \"provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\"\nfi\n\nvalidate_tag() {\n  printf '%s' \"$1\" | grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\"\n}\n\nif [ \"$VERSION\" != \"latest\" ]; then\n  validate_tag \"$VERSION\"\nfi\n\nif [ \"$VERSION\" = \"latest\" ]; then\n  API_BASE=${NEXUS_RELEASES_API:-\"https://api.github.com/repos/$REPO/releases\"}\n  API_TMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-api.XXXXXX\") || fail \"could not create temporary directory.\"\n  api_cleanup() { rm -rf \"$API_TMP\"; }\n  trap api_cleanup EXIT HUP INT TERM\n\n  LATEST_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -D \"$API_TMP/headers\" -o \"$API_TMP/latest.json\" -w \"%{http_code}\" \"$API_BASE/latest\" 2>\"$API_TMP/curl.err\" || echo \"000\")\n\n  if [ \"$LATEST_CODE\" = \"200\" ]; then\n    VERSION=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/latest.json\" | head -n 1)\n    [ -n \"$VERSION\" ] || fail \"GitHub returned no stable release tag.\"\n    validate_tag \"$VERSION\"\n  elif [ \"$LATEST_CODE\" = \"403\" ]; then\n    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \"$API_TMP/headers\" 2>/dev/null; then\n      fail \"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\"\n    fi\n    fail \"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\"\n  elif [ \"$LATEST_CODE\" = \"404\" ]; then\n    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \"$API_TMP/releases.json\" -w \"%{http_code}\" \"$API_BASE?per_page=1\" 2>/dev/null || echo \"000\")\n    if [ \"$PREREL_CODE\" = \"200\" ]; then\n      PREREL_TAG=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/releases.json\" | head -n 1)\n      if [ -n \"$PREREL_TAG\" ]; then\n        fail \"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\"\n      fi\n    fi\n    fail \"could not find latest stable release (HTTP 404 from $API_BASE/latest).\"\n  else\n    fail \"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\"\n  fi\n  rm -rf \"$API_TMP\"\n  trap - EXIT HUP INT TERM\nfi\n\nARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\nNORMALIZED_VERSION=${VERSION#v}\nURL=\"$BASE/download/$VERSION\"\nTMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-install.XXXXXX\") || fail \"could not create temporary directory.\"\ncleanup() { rm -rf \"$TMP\"; }\ntrap cleanup EXIT HUP INT TERM\ncurl -fsSL --show-error --retry 2 \"$URL/$ARCHIVE\" -o \"$TMP/$ARCHIVE\" || fail \"download failed for $ARCHIVE.\"\ncurl -fsSL --show-error --retry 2 \"$URL/SHA256SUMS\" -o \"$TMP/SHA256SUMS\" || fail \"could not download release checksums.\"\ngrep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksum entry for $ARCHIVE is missing.\"\n(cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\nARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n\nif [ \"$VERIFY_ATTESTATION\" != \"0\" ] && [ -n \"$TRUSTED_GH\" ]; then\n  if \"$TRUSTED_GH\" attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n     \"$TRUSTED_GH\" attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n    printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n  elif [ \"$VERIFY_ATTESTATION\" = \"1\" ]; then\n    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n  else\n    printf 'nexus installer: build provenance was not verified: %s could not verify the attestation (it may need gh auth login); the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' \"$TRUSTED_GH\" >&2\n  fi\nelif [ \"$VERIFY_ATTESTATION\" = \"auto\" ]; then\n  printf 'nexus installer: build provenance was not verified: no trusted GitHub CLI at /usr/bin/gh or /usr/local/bin/gh; the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' >&2\nfi\n\nVERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\nBIN_DIR=\"$PREFIX/bin\"\nLINK=\"$BIN_DIR/nexus\"\nmkdir -p \"$PREFIX…1521 tokens truncated…ently trusted to clear that obligation after recovery: even an external test runner can execute workspace-controlled tests. A resumed task may continue, but it remains `UNVERIFIED`. Before starting a new task to establish a new baseline, the operator must review the workspace state, including ignored and untracked files and verifier/test definitions, and restore or remove any state that is not trusted. A clean Git status alone does not establish that ignored files or external acceptance inputs are trustworthy. A future verifier could replace this manual boundary only after its implementation and acceptance inputs are independently bound outside candidate control. A current-invocation `--authoritative-verifier` alone does not clear recovered obligations.\n\n## Upgrade and remove\n\nCheck whether a newer release is published:\n\n```sh\nnexus upgrade --check\n```\n\nVerify the integrity and provenance of an artifact using its associated\ncryptographically signed attestations.\n\n## Understanding Verification\n\nAn attestation is a claim (i.e. a provenance statement) made by an actor\n(i.e. a GitHub Actions workflow) regarding a subject (i.e. an artifact).\n\nIn order to verify an attestation, you must provide an artifact and validate:\n* the identity of the actor that produced the attestation\n* the expected attestation predicate type (the nature of the claim)\n\nBy default, this command enforces the `https://slsa.dev/provenance/v1`\npredicate type. To verify other attestation predicate types use the\n`--predicate-type` flag.\n\nThe \"actor identity\" consists of:\n* the repository or the repository owner the artifact is linked with\n* the Actions workflow that produced the attestation (a.k.a the\n  signer workflow)\n\nThis identity is then validated against the attestation's certificate's\nSourceRepository, SourceRepositoryOwner, and SubjectAlternativeName\n(SAN) fields, among others.\n\nIt is up to you to decide how precisely you want to enforce this identity.\n\nAt a minimum, this command requires either:\n* the `--owner` flag (e.g. --owner github), or\n* the `--repo` flag (e.g. --repo github/example)\n\nThe more precisely you specify the identity, the more control you will\nhave over the security guarantees offered by the verification process.\n\nIdeally, the path of the signer workflow is also validated using the\n`--signer-workflow` or `--cert-identity` flags.\n\nPlease note: if your attestation was generated via a reusable workflow then\nthat reusable workflow is the signer whose identity needs to be validated.\nIn this situation, you must use either the `--signer-workflow` or\nthe `--signer-repo` flag.\n\nFor more options, see the other available flags.\n\n## Loading Artifacts And Attestations\n\nTo specify the artifact, this command requires:\n* a file path to an artifact, or\n* a container image URI (e.g. `oci://<image-uri>`)\n  * (note that if you provide an OCI URL, you must already be authenticated with\nits container registry)\n\nBy default, this command will attempt to fetch relevant attestations via the\nGitHub API using the values provided to `--owner` or  `--repo`.\n\nTo instead fetch attestations from your artifact's OCI registry, use the\n`--bundle-from-oci` flag.\n\nFor offline verification using attestations stored on disk (c.f. the download command)\nprovide a path to the `--bundle` flag.\n\nWhen you load attestations with `--bundle` or `--bundle-from-oci`, this command\ncompares the `--repo` or `--owner` value only with the repository and owner\nnames recorded in the attestation's certificate when the attestation was\ncreated. It cannot detect whether the repository or owner has since been\nrenamed, or whether a different repository or owner now uses that name. To\nconfirm that an attestation belongs to the repository or owner that currently\nhas the name, omit `--bundle` and `--bundle-from-oci` so that this command\nfetches attestations from the GitHub API.\n\n## Additional Policy Enforcement\n\nGiven the `--format=json` flag, upon successful verification this\ncommand will output a JSON array containing one entry per verified attestation.\n\nThis output can then be used for additional policy enforcement, i.e. by being\npiped into a policy engine.\n\nEach object in the array contains two properties:\n* an `attestation` object, which contains the bundle that was verified\n* a `verificationResult` object, which is a parsed representation of the\n  contents of the bundle that was verified.\n\nWithin the `verificationResult` object you will find:\n* `signature.certificate`, which is a parsed representation of the X.509\n  certificate embedded in the attestation,\n* `verifiedTimestamps`, an array of objects denoting when the attestation\n  was witnessed by a transparency log or a timestamp authority\n* `statement`, which contains the `subject` array referencing artifacts,\n  the `predicateType` field, and the `predicate` object which contains\n  additional, often user-controllable, metadata\n\nIMPORTANT: please note that only the `signature.certificate` and the\n`verifiedTimestamps` properties contain values that cannot be\nmanipulated by the workflow that originated the attestation.\n\nWhen dealing with attestations created within GitHub Actions, the contents of\n`signature.certificate` are populated directly from the OpenID Connect\ntoken that GitHub has generated. The contents of the `verifiedTimestamps`\narray are populated from the signed timestamps originating from either a\ngpg: Signature made Fri Oct 30 09:40:12 2026 UTC\ngpg:                using ECDSA key FAC522F6588C64266ABC7742140FD4DD53964C08\ngpg: Good signature from \"Mike Holownych <mike.holownych@aisyndicate.io>\" [ultimate]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18c3d-7cdd-71d3-966d-f30f05df4fb0","create_time":1793354567.9406817}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
