odel this misses is still handled: the client drops a parameter the provider reports as\\norigin/main:cli/src/protocols/openai_responses.ts:29:  return !reasoningEffort && !/^(o\\\\d|gpt-(?:[5-9]|\\\\d{2,})|.*codex)/i.test(model.replace(/^.*\\\\//, \\\"\\\"));\\norigin/main:cli/src/providers.ts:82:  /** ChatGPT Plus/Pro plan through the Codex backend (unofficial: Codex CLI sign-in). */\\norigin/main:cli/src/providers.ts:87:    baseUrl: \\\"https://chatgpt.com/backend-api/codex\\\",\\norigin/main:cli/src/providers.ts:92:    // The Codex backend serves reasoning models only and sets its own output limit.\\norigin/main:cli/src/session.ts:116:      throw new Error(\\\"Session workspace identity is not selected by the application\\\");\\norigin/main:cli/src/session.ts:540:    if (typeof value !== \\\"string\\\") throw new Error(\\\"Session record has no workspace identity\\\");\\norigin/main:cli/src/sidecar.ts:901:  /** Same record the REPL saves after each turn. Skipped while the conversation holds only the system prompt. */\\norigin/main:cli/src/startup_trust.ts:22:const PROJECT_INSTRUCTION_FILES = [\\\"AGENTS.md\\\", \\\"CLAUDE.md\\\", \\\"CODEX.md\\\", \\\".nexusrules\\\"];\\norigin/main:cli/src/tools.ts:719:      // Read-only command execution fails closed if the workspace identity is unavailable.\\norigin/main:cli/src/tools.ts:1510:                error: \\\"Read-only mode violation: workspace identity changed before command execution.\\\",\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18b8d-60e7-7130-962f-f0eb9e68c409","create_time":1793347573.636033}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
