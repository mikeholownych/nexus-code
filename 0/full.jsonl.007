eal attempt of `command` whose result still applies: same workspace identity, same agent process, no\norigin/main:cli/src/core/operation_runner_execution.ts:75: * Why a recovered conversation cannot continue `unit`, or undefined when it holds the system prompt and a unit prompt\norigin/main:cli/src/core/operation_runner_execution.ts:81:  if (messages[0].role !== \"system\") return \"its recorded conversation has no system prompt\";\norigin/main:cli/src/core/persistence_protection.ts:127:      throw new Error(\"Task state workspace path has no selected workspace identity\");\norigin/main:cli/src/core/persistence_protection.ts:136:    throw new Error(\"Task state workspace identity does not match the selected workspace\");\norigin/main:cli/src/core/persistence_protection.ts:149:        throw new Error(\"Task state worktree path has no selected workspace identity\");\norigin/main:cli/src/core/persistence_protection.ts:156:      throw new Error(\"Workspace identity contains positively classified sensitive material\");\norigin/main:cli/src/core/state.ts:259:    super(`Workspace identity mismatch: expected '${expectedWorkspace}', found '${actualWorkspace}'.`);\norigin/main:cli/src/core/state.ts:625:        // Earlier builds recorded the active speculative worktree as the task's workspace identity.\norigin/main:cli/src/core/state.ts:683:        throw new Error(\"Workspace identity is not selected by this state manager\");\norigin/main:cli/src/core/workspace_path.ts:19:  /** Establish workspace identity from the application workspace model. */\norigin/main:cli/src/core/workspace_path.ts:22:      throw new Error(\"Workspace identity must be an absolute path\");\norigin/main:cli/src/core/workspace_path.ts:25:    if (normalized !== input) throw new Error(\"Workspace identity must be normalized\");\norigin/main:cli/src/core/workspace_path.ts:27:    if (!stat.isDirectory()) throw new Error(\"Workspace identity must name a directory\");\norigin/main:cli/src/core/workspace_path.ts