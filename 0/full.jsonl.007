rgo test --locked --manifest-path core/Cargo.toml\",\"number\":16,\"startedAt\":\"2026-10-30T08:55:04Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:57:28Z\",\"conclusion\":\"success\",\"name\":\"Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\",\"number\":17,\"startedAt\":\"2026-10-30T08:56:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:57:30Z\",\"conclusion\":\"success\",\"name\":\"Install pinned security and SBOM test tools\",\"number\":18,\"startedAt\":\"2026-10-30T08:57:28Z\",\"status\":\"completed\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run the CLI suite with a hang bound\",\"number\":19,\"startedAt\":\"2026-10-30T08:57:30Z\",\"status\":\"in_progress\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":36,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":37,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":38,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/41029564419/job/123975740176\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"databaseId\":123975740536,\"name\":\"test-matrix (22)\",\"startedAt\":\"2026-10-30T08:54:09Z\",\"status\":\"in_progress\",\"steps\":[{\"completedAt\":\"2026-10-30T08:54:11Z\",\"conclusion\":\"success\",\"name\":\"Set up job\",\"number\":1,\"startedAt\":\"2026-10-30T08:54:10Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-30T08:54:12Z\",\"conclusion\":\"success\",\"name\":\"Ru