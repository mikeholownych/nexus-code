{"timestamp":"2026-10-30T08:22:37.118Z","ordinal":524057,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18be5-e339-7910-80af-f4c3f5102373","item":{"type":"CommandExecution","id":"exec-bc304176-b0dc-43a2-b975-1abd03a58bde","process_id":"71098","command":["/usr/bin/zsh","-lc","sed -n '1,48p' cli/test/eval_harness.test.ts; sed -n '76,112p' eval/model_proxy.mjs; sed -n '185,225p' eval/model_proxy.mjs; sed -n '200,255p' eval/run.mjs; sed -n '430,475p' cli/test/eval_hardened.test.ts; git diff --stat 1acff70018c00c2459c388f34dfb2997b8b4d7c6..origin/main -- eval/model_proxy.mjs eval/run.mjs cli/test/eval_harness.test.ts cli/test/eval_hardened.test.ts"],"cwd":"file:///home/mike/nexus-wt/rc14-release-parity-docs","parsed_cmd":[{"type":"unknown","cmd":"sed -n '1,48p' cli/test/eval_harness.test.ts; sed -n '76,112p' eval/model_proxy.mjs; sed -n '185,225p' eval/model_proxy.mjs; sed -n '200,255p' eval/run.mjs; sed -n '430,475p' cli/test/eval_hardened.test.ts; git diff --stat 1acff70018c00c2459c388f34dfb2997b8b4d7c6..origin/main -- eval/model_proxy.mjs eval/run.mjs cli/test/eval_harness.test.ts cli/test/eval_hardened.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * The evaluation harness end to end against a scripted model (Stage 8, T1 smoke): fresh workspaces, hidden tests the\n * agent never sees, separate scores. The self-test task is the assessment's A1 case: a repository whose own suite is\n * green but never exercises the deliverable. A wrong deliverable must fail the hidden test and must never be VERIFIED.\n */\n\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, Reply } from \"./helpers/fixtures.js\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n\nasync function sealTestTasks(tasksDir: string, taskId: string) {\n  const { corpusTaskRows } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const rows = corpusTaskRows(tasksDir, [taskId]);\n  const manifestPath = path.join(tasksDir, \"custody-manifest.json\");\n  const manifest = { schemaVersion: 1, split: \"heldout\", custody: { status: \"approved\", custodian: \"synthetic-test-role\", approvedAt: \"2026-01-01T00:00:00Z\" }, tasks: rows };\n  const bytes = JSON.stringify(manifest);\n  fs.writeFileSync(manifestPath, bytes);\n  return { corpusManifest: manifestPath, corpusManifestSha256: createHash(\"sha256\").update(bytes).digest(\"hex\") };\n}\n\n/** Async: the scripted gateway answers from this process, so the runner must not block its event loop. */\nfunction runNode(argv: string[], env: NodeJS.ProcessEnv = process.env): Promise<{ status: number | null; stdout: string; stderr: string }> {\n  return new Promise((resolve) => {\n    const child = spawn(process.execPath, argv, { stdio: [\"ignore\", \"pipe\", \"pipe\"], env });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout.on(\"data\", (c) => (stdout += c));\n    child.stderr.on(\"data\", (c) => (stderr += c));\n    child.on(\"close\", (status) => resolve({ status, stdout, stderr }));\n  });\n}\n\nfunction writer(content: string) {\n  return (_n: number, body: any): Reply => {\n    const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n    if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"math.js\", content } }] };\n    if (tools === 1) return { kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary: \"math.js added\" } }] };\n    return { kind: \"text\", content: \"Done.\" };\n  };\n}\nexport async function startModelProxy({ upstream, caFile, faults = [], profile, authToken, clientToken, socketPath, maxRequests = 1_000, maxConcurrentRequests = 1, maxRequestBytes = 1_000_000, maxCompletionTokens, maxTotalCompletionTokens }) {\n  if (profile !== undefined && !PROFILES.includes(profile)) throw new Error(`unknown profile ${profile}; one of ${PROFILES.join(\", \")}`);\n  if (!Number.isSafeInteger(maxRequests) || maxRequests < 1 || !Number.isSafeInteger(maxConcurrentRequests) || maxConcurrentRequests < 1 || !Number.isSafeInteger(maxRequestBytes) || maxRequestBytes < 1) throw new Error(\"invalid evaluation proxy request limits\");\n  if (maxCompletionTokens !== undefined && (!Number.isSafeInteger(maxCompletionTokens) || maxCompletionTokens < 1)) throw new Error(\"invalid per-request completion-token limit\");\n  if (maxTotalCompletionTokens !== undefined && (!Number.isSafeInteger(maxTotalCompletionTokens) || maxTotalCompletionTokens < 1)) throw new Error(\"invalid aggregate completion-token limit\");\n  for (const f of faults) {\n    if (!FAULT_KINDS.includes(f.kind) || !Number.isInteger(f.atRequest) || f.atRequest < 1) throw new Error(`invalid fault ${JSON.stringify(f)}`);\n  }\n  const target = new URL(upstream);\n  const basePath = target.pathname.replace(/\\/$/, \"\");\n  const allowedRoutes = new Map([\n    [\"GET /models\", \"catalog\"],\n    [\"POST /chat/completions\", \"inference\"],\n    [\"POST /responses\", \"inference\"],\n    [\"POST /messages\", \"inference\"],\n  ]);\n  const client = target.protocol === \"https:\" ? https : http;\n  const ca = caFile ? fs.readFileSync(caFile) : undefined;\n  const stats = { requests: 0, chatRequests: 0, activeInferenceRequests: 0, cancelledRequests: 0, profileContextLookups: 0, requestedCompletionTokens: 0, answered: 0, upstreamFailures: 0, faultsInjected: [], firstRequestAt: null, firstAnswerAt: null };\n\n  /** The upstream /models entries (for an emulated profile's context answers). */\n  const upstreamModels = () => new Promise((resolve) => {\n    const r = client.request({ protocol: target.protocol, hostname: target.hostname, port: target.port || (target.protocol === \"https:\" ? 443 : 80), method: \"GET\", path: `${target.pathname.replace(/\\/$/, \"\")}/models`, headers: { host: target.host, ...(authToken ? { authorization: `Bearer ${authToken}` } : {}) }, ca }, (res) => {\n      let body = \"\";\n      res.setEncoding(\"utf8\");\n      res.on(\"data\", (c) => (body += c));\n      res.on(\"end\", () => { try { resolve(JSON.parse(body).data ?? []); } catch { resolve([]); } });\n    });\n    r.on(\"error\", () => resolve([]));\n    r.end();\n  });\n  const firstContext = async () => { const m = (await upstreamModels())[0]; return m?.context_length ?? m?.max_model_len ?? null; };\n  const sendJson = (res, status, body) => { res.writeHead(status, { \"content-type\": \"application/json\" }); res.end(JSON.stringify(body)); };\n\n  const server = http.createServer(async (req, res) => {\n    stats.requests++;\n    if (clientToken) {\n    if (routeKind === \"inference\" && (maxCompletionTokens !== undefined || maxTotalCompletionTokens !== undefined)) {\n      let payload;\n      try { payload = JSON.parse(requestBody.toString(\"utf8\")); }\n      catch { return void sendJson(res, 400, { error: { type: \"invalid_request\", message: \"evaluation proxy requires a valid JSON inference request\" } }); }\n      const suppliedLimits = [payload.max_tokens, payload.max_completion_tokens].filter((value) => value !== undefined);\n      if (!suppliedLimits.length || suppliedLimits.some((value) => !Number.isSafeInteger(value) || value < 1) || new Set(suppliedLimits).size !== 1) {\n        return void sendJson(res, 400, { error: { type: \"invalid_request\", message: \"evaluation proxy requires one unambiguous positive completion-token limit\" } });\n      }\n      requestedTokens = suppliedLimits[0];\n      if (maxCompletionTokens !== undefined && requestedTokens > maxCompletionTokens) {\n        return void sendJson(res, 400, { error: { type: \"completion_limit\", message: \"evaluation proxy per-request completion-token limit exceeded\" } });\n      }\n      if (maxTotalCompletionTokens !== undefined && stats.requestedCompletionTokens + requestedTokens > maxTotalCompletionTokens) {\n        return void sendJson(res, 400, { error: { type: \"aggregate_completion_limit\", message: \"evaluation proxy aggregate requested completion-token limit exceeded\" } });\n      }\n      stats.requestedCompletionTokens += requestedTokens;\n    }\n    stats.firstRequestAt ??= new Date().toISOString();\n    const chatIndex = routeKind === \"inference\" ? ++stats.chatRequests : 0;\n    const fault = chatIndex ? faults.find((f) => f.atRequest === chatIndex) : undefined;\n    if (fault) stats.faultsInjected.push({ kind: fault.kind, atRequest: chatIndex });\n\n    if (fault?.kind === \"refuse\") {\n      req.resume();\n      return void req.socket.destroy();\n    }\n    if (fault?.kind === \"overloaded\") {\n      req.resume();\n      res.writeHead(503, { \"content-type\": \"application/json\", \"retry-after\": \"1\" });\n      return void res.end(JSON.stringify({ error: { message: \"overloaded (injected)\", type: \"overloaded\" } }));\n    }\n    if (fault?.kind === \"context_overflow\") {\n      req.resume();\n      res.writeHead(400, { \"content-type\": \"application/json\" });\n      return void res.end(JSON.stringify({ error: { code: 400, message: \"the request exceeds the available context size, try increasing it\", type: \"exceed_context_size_error\" } }));\n    }\n\n    const upstreamHeaders = { host: target.host, connection: \"close\" };\n    for (const header of [\"accept\", \"accept-encoding\", \"content-type\", \"user-agent\"]) {\n      const value = req.headers[header];\n      if (typeof value === \"string\") upstreamHeaders[header] = value;\n          return { pass: r.status === 0 && !error, error };\n        }));\n      } finally {\n        fs.rmSync(probe, { recursive: true, force: true });\n      }\n    }\n    const sourceBefore = treeDigest(task.dir);\n    // Every agent reaches the model through a per-run forwarder, so whether the model was reachable is observed by the\n    // harness, the same way for every agent (eval/infra.mjs). `config.proxy: false` connects agents directly.\n    // T4: a task (or the config) may schedule faults for the proxy to inject; they are recorded with the run.\n    const faults = task.faults ?? config.faults ?? [];\n    if (faults.length && config.proxy === false) throw new Error(\"fault injection needs the model proxy (proxy: false is set)\");\n    // A standalone profile (DEC-16) shows agents a plain server; the proxy then holds the real key, agents get none.\n    if (config.serverProfile && config.proxy === false) throw new Error(\"serverProfile needs the model proxy (proxy: false is set)\");\n    const proxyDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-proxy-\"));\n    fs.chmodSync(proxyDir, 0o700);\n    const socketPath = path.join(proxyDir, \"proxy.sock\");\n    const localToken = REDACTED;\n    const proxy = await startModelProxy({\n      upstream: config.endpoint,\n      caFile,\n      faults,\n      profile: config.serverProfile,\n      authToken: apiKey ?? undefined,\n      clientToken: localToken,\n      socketPath,\n      maxRequests: config.limits?.requests ?? 1_000,\n      maxCompletionTokens: config.limits?.output,\n      maxTotalCompletionTokens: config.limits?.totalOutput,\n    });\n    const started = Date.now();\n    let agent;\n    let agentEndedAt;\n    try {\n      agent = await runAgent(task, ws, home, budget, agentIdentity, proxyDir, localToken, proxy);\n      agentEndedAt = Date.now();\n      if (config.runAs) {\n        for (const dir of [ws, home]) await normalizeRunAsPermissions(config.runAs, dir, asUserSpec);\n      }\n    } finally {\n      await proxy?.close();\n      fs.rmSync(proxyDir, { recursive: true, force: true });\n    }\n    const wallMs = agentEndedAt - started;\n    if (agent.containmentProblem) throw new Error(`candidate containment failed: ${agent.containmentProblem}`);\n    const model = proxy ? proxy.stats() : null;\n    const fixtureFaults = observeT4Fixture(task, agent, agent.resources, config.resources);\n    const contaminated = treeDigest(task.dir) !== sourceBefore || `${agent.stdout}${agent.stderr}`.includes(tasksDir);\n    // T3 judges the workspace as it was when the objective's work ended (snapshot taken before the probe turn).\n    const t3 = agent.t3Driver ? scoreT3Run({ task, baseline: t3Baseline, driver: agent.t3Driver, preconditions: agent.t3Preconditions, compactions: countCompactions(home) }) : null;\n    // Legacy hidden tests share a process with candidate code. In qualification (or with hardenedChecks) they never\n    // run in the agent's workspace: each check gets a fresh staging of the baseline with only the agent's source\n    // changes (eval/hardened_check.mjs). Black-box oracles already keep expectations outside the candidate.\n    const hardened = (config.qualification === true || config.hardenedChecks === true) && task.hidden?.protocol !== \"blackbox-v1\";\n    let hardening = null;\n    let hiddenWs = ws;\n    await gw.close();\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n}\n\ntest(\"hardened checks: a correct change passes in a fresh workspace; a test-script change refuses the checks\", { timeout: 300_000 }, async () => {\n  const write = (p: string, content: string) => ({ name: \"write_file\", args: { path: p, content } });\n  const good = await hardenedRun([write(\"math.js\", \"exports.add = (a, b) => a + b;\\n\")]);\n  assert.equal(good.hiddenPass, true, JSON.stringify(good));\n  assert.equal(good.regressionPass, true);\n  assert.ok(good.hardened.applied >= 1);\n  assert.deepEqual(good.hardened.configChanges, []);\n\n  const pkg = JSON.parse(fs.readFileSync(path.join(ROOT, \"eval/tasks/selftest-add/repo/package.json\"), \"utf8\"));\n  // write_file refuses to replace an existing file unless overwrite is set.\n  const gamed = await