{"timestamp":"2026-10-30T10:09:33.798Z","ordinal":527898,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18c3d-7cdd-71d3-966d-f30f05df4fb0","item":{"type":"CommandExecution","id":"exec-417dffd4-981c-4582-89c0-4ab680410f51","process_id":"76555","command":["/usr/bin/zsh","-lc","set -e\nrepo=/home/mike/nexus-wt/rc14-artifact-verification\nevidence=\"$repo/docs/reviews/evidence/v1-qualification/rc.14\"\nassets=/tmp/nexus-rc14-workflow-assets\ngh release view v1.0.0-rc.14 --repo mikeholownych/nexus-code --json tagName,name,isDraft,isPrerelease,targetCommitish,url,assets > \"$evidence/release.json\"\ngh run view 41035120551 --json status,conclusion,headSha,event,workflowName,url,jobs > \"$evidence/release-workflow.json\"\ngh run view 41029564419 --json status,conclusion,headSha,url,jobs > \"$evidence/source-ci.json\"\ngh run view 41029564602 --json status,conclusion,headSha,url,jobs > \"$evidence/codeql.json\"\ngit verify-tag v1.0.0-rc.14 > \"$evidence/tag-signature.log\" 2>&1\ngh run view 41035120551 --log 2>&1 | rg 'Retained [0-9]+ Cargo production dependencies|Generated and validated CycloneDX SBOM|NOTICES_CHECK_PASS|Release ready at' > \"$evidence/package-build-key-lines.log\"\nnode scripts/check_notices.mjs /tmp/nexus-rc14-package-check.qS7YPZ/nexus/THIRD_PARTY_NOTICES.txt > \"$evidence/notices-check.log\"\npython3 - \"$evidence\" <<'PY'\nimport json,pathlib,sys\nroot=pathlib.Path(sys.argv[1]); sbom=json.loads(pathlib.Path('/tmp/nexus-rc14-workflow-assets/sbom.cdx.json').read_text()); lock=json.loads(pathlib.Path('cli/package-lock.json').read_text())\ncomponents=sbom['components']; cargo=sum(c.get('purl','').startswith('pkg:cargo/') for c in components); npm=sum(c.get('purl','').startswith('pkg:npm/') for c in components)\nprod=[(k,v) for k,v in lock.get('packages',{}).items() if k.startswith('node_modules/') and not v.get('dev',False)]\nassert cargo==120 and npm==22 and len(prod)==21\n(root/'sbom