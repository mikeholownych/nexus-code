{"timestamp":"2026-10-30T08:13:35.888Z","ordinal":523620,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18bda-0a8d-7963-bd38-a3a61a293f7d","item":{"type":"CommandExecution","id":"exec-476bcb14-fd9b-4332-a115-1740a0b3a943","process_id":"45059","command":["/usr/bin/zsh","-lc","tmp_home=$(mktemp -d /tmp/nexus-home-rc14-parity.XXXXXX); HOME=\"$tmp_home\" XDG_CONFIG_HOME=\"$tmp_home/.config\" node --test cli/test/release_workflow_parity.test.ts; test_status=$?; git diff --check; diff_status=$?; git diff --stat; git diff -- cli/test/release_workflow_parity.test.ts docs/releases/v1.0.0-rc.13.md; exit $((test_status || diff_status))"],"cwd":"file:///home/mike/nexus-wt/rc14-release-parity-docs","parsed_cmd":[{"type":"unknown","cmd":"tmp_home=$(mktemp -d /tmp/nexus-home-rc14-parity.XXXXXX); HOME=\"$tmp_home\" XDG_CONFIG_HOME=\"$tmp_home/.config\" node --test cli/test/release_workflow_parity.test.ts; test_status=$?; git diff --check; diff_status=$?; git diff --stat; git diff -- cli/test/release_workflow_parity.test.ts docs/releases/v1.0.0-rc.13.md; exit $((test_status || diff_status))"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"✔ release job prepares the same evaluator environment as CI before running the CLI suite (3.19155ms)\nℹ tests 1\nℹ suites 0\nℹ pass 1\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 237.900149\n cli/test/release_workflow_parity.test.ts | 2 +-\n docs/releases/v1.0.0-rc.13.md            | 2 --\n 2 files changed, 1 insertion(+), 3 deletions(-)\ndiff --git a/cli/test/release_workflow_parity.test.ts b/cli/test/release_workflow_parity.test.ts\nindex 9a057db5..e54389eb 100644\n--- a/cli/test/release_workflow_parity.test.ts\n+++ b/cli/test/release_workflow_parity.test.ts\n@@ -47,7 +47,7 @@ test(\"release job prepares the same evaluator environment as CI before running t\n     );\n     const suite = job.indexOf(\"run: npm --prefix cli test\");\n     assert.ok(suite >= 0, `${jobName} runs the CLI suite`);\n-    assert.match(job, /timeout-minutes: \\d+\\n\\s+run: npm --prefix cli test/, `${jobName} bounds the CLI suite so a hung test process fails the job`);\n+    assert.match(job, /timeout-minutes: 45\\n\\s+run: npm --prefix cli test/, `${jobName} bounds the CLI suite to 45 minutes so a hung test process fails the job`);\n     const positions = REQUIRED_EVALUATOR_SETUP.map((step) => {\n       const position = job.indexOf(step);\n       assert.ok(position >= 0, `${jobName} includes required evaluator setup: ${step}`);\ndiff --git a/docs/releases/v1.0.0-rc.13.md b/docs/releases/v1.0.0-rc.13.md\nindex a665ad9a..7f5a41e2 100644\n--- a/docs/releases/v1.0.0-rc.13.md\n+++ b/docs/releases/v1.0.0-rc.13.md\n@@ -2,8 +2,6 @@\n \n **Maturity:** release candidate; prerelease, not stable.\n \n-**Not published:** the `v1.0.0-rc.13` release workflow failed in its test step (two evaluator tests refused with `compiler exposure could not be checked; refusing qualification`, then the evaluator test process did not exit), so no RC13 package exists. [RC14](v1.0.0-rc.14.md) replaces it.\n-\n **Status:** this candidate is for exact-artifact qualification. It does not establish independent acceptance or authorize stable v1.0.0 promotion. Qualification results must identify the workflow-produced package and its digest.\n \n This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and sidecar, production Node dependencies, Rust `harness-core`, and Ratatui `nexus-tui`. It replaces RC12, which was tagged but never published: its release workflow failed in the test step, so no RC12 package exists. RC13 ships the same product changes as RC12; everything in the [RC12 notes](v1.0.0-rc.12.md) and the [RC11 notes](v1.0.0-rc.11.md) is included.\n","exit_code":0,"duration":{"secs":1,"nanos":621475402}},"started_at_ms":1793348014265,"completed_at_ms":1793348015887}}
{"timestamp":"2026-10-30T08:13:36.090Z","ordinal":523621,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18bdf-17d9-74c0-a07b-3658340c1de0","call_id":"call_adab1f8858b447ab97f42a45952f7d8c","output":[{"type":"input_text","text":"Script completed\nWall time 2.3 seconds\nOutput:\n"},{"type":"input_text","text":"✔ release job prepares the same evaluator environment as CI before running the CLI suite (3.19155ms)\nℹ tests 1\nℹ suites 0\nℹ pass 1\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 237.900149\n cli/test/release_workflow_parity.test.ts | 2 +-\n docs/releases/v1.0.0-rc.13.md            | 2 --\n 2 files changed, 1 insertion(+), 3 deletions(-)\ndiff --git a/cli/test/release_workflow_parity.test.ts b/cli/test/release_workflow_parity.test.ts\nindex 9a057db5..e54389eb 100644\n--- a/cli/test/release_workflow_parity.test.ts\n+++ b/cli/test/release_workflow_parity.test.ts\n@@ -47,7 +47,7 @@ test(\"release job prepares the same evaluator environment as CI before running t\n     );\n     const suite = job.indexOf(\"run: npm --prefix cli test\");\n     assert.ok(suite >= 0, `${jobName} runs the CLI suite`);\n-    assert.match(job, /timeout-minutes: \\d+\\n\\s+run: npm --prefix cli test/, `${jobName} bounds the CLI suite so a hung test process fails the job`);\n+    assert.match(job, /timeout-minutes: 45\\n\\s+run: npm --prefix cli test/, `${jobName} bounds the CLI suite to 45 minutes so a hung test process fails the job`);\n     const positions = REQUIRED_EVALUATOR_SETUP.map((step) => {\n       const position = job.indexOf(step);\n       assert.ok(position >= 0, `${jobName} includes required evaluator setup: ${step}`);\ndiff --git a/docs/releases/v1.0.0-rc.13.md b/docs/releases/v1.0.0-rc.13.md\nindex a665ad9a..7f5a41e2 100644\n--- a/docs/releases/v1.0.0-rc.13.md\n+++ b/docs/releases/v1.0.0-rc.13.md\n@@ -2,8 +2,6 @@\n \n **Maturity:** release candidate; prerelease, not stable.\n \n-**Not published:** the `v1.0.0-rc.13` release workflow failed in its test step (two evaluator tests refused with `compiler exposure could not be checked; refusing qualification`, then the evaluator test process did not exit), so no RC13 package exists. [RC14](v1.0.0-rc.14.md) replaces it.\n-\n **Status:** this candidate is for exact-artifact qualification. It does not establish independent acceptance or authorize stable v1.0.0 promotion. Qualification results must identify the workflow-produced package and its digest.\n \n This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and sidecar, production Node dependencies, Rust `harness-core`, and Ratatui `nexus-tui`. It replaces RC12, which was tagged but never published: its release workflow failed in the test step, so no RC12 package exists. RC13 ships the same product changes as RC12; everything in the [RC12 notes](v1.0.0-rc.12.md) and the [RC11 notes](v1.0.0-rc.11.md) is included.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18bda-0a8d-7963-bd38-a3a61a293f7d","create_time":1793348016.0898912}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
