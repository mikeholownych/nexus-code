93/job/123899075406\",\"name\":\"javascript-typescript\",\"startedAt\":\"2026-10-30T04:53:54Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CodeQL\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-30T05:14:13Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/41005410294/job/123899075380\",\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-30T04:53:54Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/41005410294/job/123904961345\",\"name\":\"linux-x86_64\",\"startedAt\":\"2026-10-30T05:14:15Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://entire.com/gh/mikeholownych/-/trails/50/changes/nexus-code/50\",\"name\":\"Entire Gates\",\"startedAt\":\"2026-10-30T04:53:49Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-30T04:54:49Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/runs/123899328484\",\"name\":\"CodeQL\",\"startedAt\":\"2026-10-30T04:54:46Z\",\"status\":\"COMPLETED\",\"workflowName\":\"\"},{\"__typename\":\"StatusContext\",\"context\":\"CodeRabbit\",\"startedAt\":\"2026-10-30T04:53:59Z\",\"state\":\"SUCCESS\",\"targetUrl\":\"\"}]}\n"},{"type":"input_text","text":"### 3\nv1.0.0-rc.11\tPre-release\tv1.0.0-rc.11\t2026-10-30T00:17:45Z\nv1.0.0-rc.10\tPre-release\tv1.0.0-rc.10\t2026-10-27T00:29:58Z\nv1.0.0-rc.9\tPre-release\tv1.0.0-rc.9\t2026-10-26T17:56:16Z\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18b4e-a8d9-78f0-bd60-966a1e9e4357","create_time":1793338752.34098}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
