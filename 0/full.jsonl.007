{"timestamp":"2026-10-30T10:02:59.392Z","ordinal":527588,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18c3d-7cdd-71d3-966d-f30f05df4fb0","item":{"type":"CommandExecution","id":"exec-36d51a4c-0655-4e42-bbb6-494ee0f5cba3","process_id":"77469","command":["/usr/bin/zsh","-lc","set -e\nartifact_dir=/tmp/nexus-rc14-workflow-assets\nmkdir -p \"$artifact_dir\"\ngh release download v1.0.0-rc.14 --repo mikeholownych/nexus-code --dir \"$artifact_dir\"\ngh release view v1.0.0-rc.14 --repo mikeholownych/nexus-code --json assets > \"$artifact_dir/release-assets.json\"\npython3 - \"$artifact_dir\" <<'PY'\nimport hashlib,json,pathlib,sys\nroot=pathlib.Path(sys.argv[1]); assets=json.loads((root/'release-assets.json').read_text())['assets']\nassert len(assets)==9, f\"expected 9 assets, got {len(assets)}\"\nfor asset in assets:\n p=root/asset['name']\n assert p.is_file(), f\"missing asset {p.name}\"\n b=p.read_bytes(); actual='sha256:'+hashlib.sha256(b).hexdigest()\n assert len(b)==asset['size'], f\"size mismatch for {p.name}\"\n assert actual==asset['digest'], f\"GitHub digest mismatch for {p.name}: {actual} != {asset['digest']}\"\n print(f\"MATCH {p.name} size={len(b)} {actual}\")\nPY\n(cd \"$artifact_dir\" && sha256sum --check SHA256SUMS)\n"],"cwd":"file:///home/mike/nexus-wt/rc14-artifact-verification","parsed_cmd":[{"type":"unknown","cmd":"set -e\nartifact_dir=/tmp/nexus-rc14-workflow-assets\nmkdir -p \"$artifact_dir\"\ngh release download v1.0.0-rc.14 --repo mikeholownych/nexus-code --dir \"$artifact_dir\"\ngh release view v1.0.0-rc.14 --repo mikeholownych/nexus-code --json assets > \"$artifact_dir/release-assets.json\"\npython3 - \"$artifact_dir\" <<'PY'\nimport hashlib,json,pathlib,sys\nroot=pathlib.Path(sys.argv[1]); assets=json.loads((root/'release-assets.json').read_text())['assets']\nassert len(assets)==9, f\"expected 9 assets, got {len(assets)}\"\nfor asset in assets:\n p=root/asset['name']\n assert p.is_file(), f\"missing asset {p.name}\"\n b=p.read_bytes(); actual='sha256:'+hashlib.sha256(b).hexdigest()\n assert len(b)==asset['size'], f\"size mismatch for {p.name}\"\n assert actual==asset['digest'], f\"GitHub digest mismatch for {p.name}: {actual} != {asset['digest']}\"\n print(f\"MATCH {p.name} size={len(b)} {actual}\")\nPY\n(cd \"$artifact_dir\" && sha256sum --check SHA256SUMS)\n"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"MATCH compatibility.json size=770 sha256:46b56e76ea3f662febb2de8328478892754ee67cecd301dfae7cdc0ebfe8f248\nMATCH install.sh size=10642 sha256:b243cda661eb0a57890435cfa2170fb50ea8e507aeec595d364d3f2ce71c8125\nMATCH nexus-linux-x86_64-v1.0.0-rc.14.tar.gz size=4913202 sha256:52d1c855158c63dbc7cac2e9d87e2f64b1feffb193de97660e92276a2bd46eb7\nMATCH sbom.cdx.json size=163412 sha256:e5949950f523b303ca46e6dc4ce46aa01ce95274d582078537b9f70379c0d6bd\nMATCH sbom.cdx.json.sha256 size=80 sha256:6b9d0c8af60544eea257265a6a7688888f800125581ce23aeb21d48fd53fb4f6\nMATCH sbom.json size=163412 sha256:e5949950f523b303ca46e6dc4ce46aa01ce95274d582078537b9f70379c0d6bd\nMATCH sbom.json.sha256 size=76 sha256:f28e0c729e977b0f12aed9358160d54220338f101a7e1714fbf6e0df3e8842ca\nMATCH SHA256SUMS size=190 sha256:f74f886870eb85ac8e1873b35f6c0d33cfa255f904cdec181ac09845446abde5\nMATCH THIRD_PARTY_NOTICES.txt size=242797 sha256:9dddfeb2c5131b2e4c6205acb9ed10da2c22f9e02d750e92c0167cb5e3436749\nnexus-linux-x86_64-v1.0.0-rc.14.tar.gz: OK\ncompatibility.json: OK\n","exit_code":0,"duration":{"secs":3,"nanos":31672579}},"started_at_ms":1793354576360,"completed_at_ms":1793354579392}}
