dCorpusPathsForRun();\n  const corpusOverlap = runtimeCorpusOverlapProblem(sandboxRuntimePaths, allowedRuntimeRoots, tasksDir, corpusPaths, {\n    cwd: ws,\n    home,\n    proxyDirectory,\n    nodeRuntime: cmd,\n    supervisorPath,\n    qualification: config.qualification === true,\n  });\n  if (corpusOverlap) throw new Error(corpusOverlap);\n  const sandbox = agentSandboxArgv({ cwd: ws, home, proxyDirectory, readOnlyPaths: sandboxRuntimePaths, allowedRuntimeRoots, runtimeExecutablePaths: [cmd, ...agentIdentity.argsPrefix], supervisorPath, protectedCorpusPaths });\n  const wrapped = config.runAs ? asUserSpec(config.runAs, sandbox) : sandbox;\n  return new Promise((resolve) => {\n    const { child, containment } = spawnContained(wrapped, config.resources ?? null, { cwd: \"/\", env: {}, stdio: [\"pipe\", \"pipe\", \"pipe\"], detached: true });\n    // T3: the payload is the first line and the sidecar protocol follows on the same stdin (eval/agent_sandbox.mjs).\n    const preconditions = {};\n    const runConstraint = (command) => runIsolated(command, { cwd: ws, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => ({ pass: r.status === 0 && !r.timedOut && !r.overflow }));\n    const driver = protocol ? createT3Driver(task, (line) => { if (!child.stdin.destroyed) child.stdin.write(line); }, {\n      onSteer: (item) => { preconditions[item.id] = steeringPrecondition(item, ws, task.t3CommandBaseline); },\n      beforeProbe: () => t3Snapshot(task, ws, runConstraint),\n    }) : null;\n    child.stdin.on(\"error\", () => {});\n    if (driver) {\n      child.stdin.write(`${JSON.stringify({ command: cmd, argv, env, protocol: true })}\\n`);\n      driver.done.then(() => setTimeout(() => child.stdin.end(), 2000).unref());\n    } else child.stdin.end(JSON.stringify({ command: cmd, argv, env }));\n    let stdout = \"\";\n    let stderr = \"\";\n    let timedOut = false;\n    let outputExceeded = false;\n    let outputBytes = 0;\n    const collect = (target, chunk) => {\n      outputBytes += chunk.length;\n      // A T3 protocol session over 60+ steps is verbose; its cap is larger but still bounded.\n      if (outputBytes > (driver ? 50_000_000 : 2_000_000)) {\n        outputExceeded = true;\n        killGroup(\"SIGKILL\");\n        return;\n      }\n      if (target === \"stdout\") stdout += chunk;\n      else stderr += chunk;\n    };\n    child.stdout.removeAllListeners(\"data\");\n    child.stderr.removeAllListeners(\"data\");\n    child.stdout.on(\"data\", (c) => collect(\"stdout\", c));\n    child.stderr.on(\"data\", (c) => collect(\"stderr\", c));\n    if (driver) {\n      // Registered after the collectors above (which reset the stream's listeners): every protocol line reaches the driver.\n      let pending = \"\";\n      const decoder = new StringDecoder(\"utf8\"); // a chunk can end inside a multibyte character\n      child.stdout.on(\"data\", (chunk) => {\n        pending += decoder.write(chunk);\n        let newline;\n        while ((newline = pending.indexOf(\"\\n\")) >= 0) { driver.handleLine(pending.slice(0, newline)); pending = pending.slice(newline + 1); }\n      });\n    }\n    // The whole process group: agents start helpers (servers, shells) that must not outlive the run.\n    // Under the resource contract the cgroup is emptied instead, so the supervisor survives to report cleanup.\n    const killGroup = (sig) => {\n      if (containment) return containment.kill();\n      try {\n        process.kill(-child.pid, sig);\n      } catch {}\n    };\n    let signalEvidence = null;\n    const signalPoll = signalAfterAnswer ? setInterval(() => {\n      if (signalEvidence || (proxy?.stats().answered ?? 0) < 1) return;\n      if (!containment) return;\n      const proxyState = proxy.stats();\n      // An answered request alone only proves the model replied sometime earlier. Require\n      // an in-flight inference request while this Nexus process is still alive so the\n      // injected interruption is demonstrably during an active turn.\n      if (proxyState.activeInferenceRequests < 1 || child.exitCode !== null) return;\n      try {\n        if (containment.signal(\"SIGTERM\", 5000)) signalEvidence = {\n          requestedAt: new Date().toISOString(),\n          answeredBeforeSignal: true,\n          activeInferenceRequests: proxyState.activeInferenceRequests,\n          signalDuringActiveTurn: true,\n        };\n      } catch {}\n    }, 25) : null;\n    const timer = setTimeout(() => {\n      timedOut = true;\n      killGroup(\"SIGTERM\");\n      setTimeout(() => killGroup(\"SIGKILL\"), 10_000).unref();\n    }, (budget.minutes + 5) * 60_000);\n    child.on(\"error\", (err) => (stderr += `spawn error: ${err.message}\\n`));\n    child.on(\"close\", async (code, exitSignal) => {\n      clearTimeout(timer);\n      if (signalPoll) clearInterval(signalPoll);\n      // A contained payload is already reaped by cgroup_supervisor before its final report. Do not race that\n      // report with a second force-kill; only the uncontained development path needs process-group cleanup here.\n      if (!containment) killGroup(\"SIGKILL\");\n      const final = containment ? await containment.final : undefined;\n      const json = driver ? { turn: driver.state.objectiveTurns.at(-1) ?? null } : lastJson(stdout);\n      const observedSignal = final?.signals?.find((entry) => entry.name === \"SIGTERM\");\n      const t4Signal = signalEvidence ? {\n        ...signalEvidence,\n        delivered: (observedSignal?.delivered ?? 0) > 0,\n        deliveredProcesses: observedSignal?.delivered ?? 0,\n        forced: observedSignal?.forced ?? null,\n        firstExitCode: code,\n        // `child` is the systemd-run wrapper; only the supervisor's final report identifies\n        // the task payload's signal disposition.\n        payloadExitSignal: final?.signal ?? null,\n        supervisorWrapperExitSignal: exitSignal ?? null,\n      } : null;\n      resolve({ code, timedOut, outputExceeded, stdout, stderr, json, ...(t4Signal ? { t4Signal } : {}), ...(driver ? { t3Driver: driver.state, t3Preconditions: preconditions } : {}), ...(containment ? { resources: final, containmentProblem: containmentProblem(final) } : {}) });\n    });\n  });\n}\n\nfunction runCheck(task, ws, check, hidden, { readOnlyHidden = false, protectedCorpusPaths = [] } = {}) {\n  if (hidden && check.protocol === \"blackbox-v1\") {\n    return runBlackBoxOracle(task, ws, check, { resources: config.resources ?? null, protectedCorpusPaths }).then((result) => ({\n      ...result,\n      status: result.pass ? 0 : 1,\n      output: JSON.stringify({\n        cases: result.cases,\n        failedCases: result.failedCases,\n        timeoutCases: result.timeoutCases,\n        outputLimitCases: result.outputLimitCases,\n        executionFailureCases: result.executionFailureCases,\n// Runs one evaluation candidate behind a namespace-local TCP endpoint and a host-side Unix-socket proxy.\n// The candidate sees only the run-scoped local token; the upstream gateway credential stays in run.mjs.\nimport http from \"node:http\";\nimport { spawn } from \"node:child_process\";\nimport { StringDecoder } from \"node:string_decoder\";\n\n// The launch payload is the first stdin line. With payload.protocol the rest of stdin is the agent's stdin (the T3\n// sidecar protocol); otherwise the agent gets no stdin.\nconst payload = JSON.parse(await readPayloadLine());\nconst port = 40127; // private to this network namespace; no host listener uses this port\nconst server = http.createServer((req, res) => {\n  const upstream = http.request({ socketPath: \"/run/eval-proxy/proxy.sock\", agent: new http.Agent({ keepAlive: false }), method: req.method, path: req.url, headers: { ...req.headers, host: \"eval-proxy\", connection: \"close\" } }, (response) => {\n    res.writeHead(response.statusCode ?? 502, response.headers);\n    response.pipe(res);\n    response.once(\"end\", () => upstream.destroy());\n  });\n  upstream.on(\"error\", (error) => {\n    if (!res.headersSent) res.writeHead(502, { \"content-type\": \"application/json\" });\n    res.end(JSON.stringify({ error: { type: \"proxy_unavailable\", message: \"evaluation proxy unavailable\" } }));\n  });\n  req.pipe(upstream);\n});\nawait new Promise((resolve, reject) => {\n  server.once(\"error\", reject);\n  server.listen(port, \"127.0.0.1\", resolve);\n});\n\nconst endpoint = `http://127.0.0.1:${port}/v1`;\nconst env = { ...payload.env };\nfor (const [key, value] of Object.entries(env)) {\n  if (typeof value === \"string\") env[key] = value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint);\n}\nconst argv = payload.argv.map((value) => value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint));\nconst agent = spawn(payload.command, argv, { cwd: \"/workspace\", env, stdio: [payload.protocol ? \"pipe\" : \"ignore\", \"inherit\", \"inherit\"] });\nif (payload.protocol) {\n  agent.stdin.on(\"error\", () => {});\n  process.stdin.pipe(agent.stdin);\n  process.stdin.resume();\n}\nlet stopping = false;\nconst stop = (signal) => {\n  if (stopping) return;\n  stopping = true;\n  try { process.kill(-agent.pid, signal); } catch { agent.kill(signal); }\n};\nprocess.on(\"SIGTERM\", () => stop(\"SIGTERM\"));\nprocess.on(\"SIGINT\", () => stop(\"SIGINT\"));\nagent.on(\"error\", (error) => {\n  process.stderr.write(`candidate spawn failed: ${error.message}\\n`);\n  closeBridge(127);\n});\nagent.on(\"close\", (code, signal) => {\n  closeBridge(code ?? (signal ? 128 : 1));\n});\n\n/** Reads stdin up to the first newline (or its end); anything after the newline is put back for the agent. */\nfunction readPayloadLine() {\n  return new Promise((resolve, reject) => {\n    let body = \"\";\n    const decoder = new StringDecoder(\"utf8\");\n    const onData = (chunk) => {\n      body += decoder.write(chunk);\n      if (body.length > 1_000_000) { cleanup(); reject(new Error(\"sandbox launch payload too large\")); return; }