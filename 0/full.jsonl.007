ct-head CI now running.\",\n.git/nexus-claims/FILE_eval_run.mjs/recovered-BlueFalcon-20261029T0435Z.json:1:{\"agent\":\"BlueFalcon\",\"program\":\"codex-app\",\"model\":\"gpt-6.1-sol\",\"host\":\"mike-dev\",\"branch\":\"v1/eval-agent-toolchain-binds\",\"worktree\":\"/home/mike/nexus-wt/eval-agent-toolchain-binds\",\"base\":\"b10a85ad6305a4a3564a81d9bc66e88f55036c8d\",\"since\":\"2026-10-29T03:04:00Z\",\"scope\":\"Add the approved read-only Go/Rust toolchain directories to the Nexus candidate PATH and sandbox mounts; add deterministic infrastructure regression coverage; preserve corpus-overlap checks and the existing toolchain trust roots\"}\n.git/nexus-claims/archived/REDACTED/owner.json:5:  \"branch\": \"v1/eval-agent-toolchain-binds\",\n.git/nexus-claims/archived/REDACTED/owner.json:6:  \"worktree\": \"/home/mike/nexus-wt/eval-agent-toolchain-binds\",\n.git/nexus-claims/archived/SUITE-pr318-curated-runtime-data-20261029T215311Z/owner.json:5:  \"branch\": \"v1/eval-agent-toolchain-binds\",\n.git/nexus-claims/archived/SUITE-pr318-curated-runtime-data-20261029T215311Z/owner.json:6:  \"worktree\": \"/home/mike/nexus-wt/eval-agent-toolchain-binds\",\n.git/nexus-claims/archived/SUITE-pr318-power-recovery-20261029T2323Z/owner.json:4:  \"branch\": \"v1/eval-agent-toolchain-binds\",\n.git/nexus-claims/archived/SUITE-pr318-power-recovery-20261029T2323Z/owner.json:5:  \"worktree\": \"/home/mike/nexus-wt/eval-agent-toolchain-binds\",\n.git/nexus-claims/archived/SUITE-pr318-power-recovery-20261029T2323Z/completed-owner.json:4:  \"branch\": \"v1/eval-agent-toolchain-binds\",\n.git/nexus-claims/archived/SUITE-pr318-power-recovery-20261029T2323Z/completed-owner.json:5:  \"worktree\": \"/home/mike/nexus-wt/eval-agent-toolchain-binds\",\n.git/nexus-claims/archived/REDACTED/owner.json:1:{\"agent\":\"codex-root\",\"program\":\"codex-app\",\"host\":\"mike-dev\",\"branch\":\"v1/eval-agent-toolchain-binds\",\"worktree\":\"/home/mike/nexus-wt/eval-agent-toolchain-binds\",\"base\":\"a70d0