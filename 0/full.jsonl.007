{"timestamp":"2026-10-30T08:52:38.612Z","ordinal":525173,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18bff-7011-7da3-8833-52d22c944baa","item":{"type":"CommandExecution","id":"exec-aa43702f-b43c-4bb4-9934-7eaa19144349","process_id":"42543","command":["/usr/bin/zsh","-lc","cat scripts/install-evaluator-toolchains.sh; sed -n '1,200p' eval/scan-compiler-exposure.mjs; sed -n '1,120p' .github/workflows/ci.yml"],"cwd":"file:///home/mike/nexus-wt/eval-t4-overload-diagnostic","parsed_cmd":[{"type":"read","cmd":"cat scripts/install-evaluator-toolchains.sh","name":"install-evaluator-toolchains.sh","path":"scripts/install-evaluator-toolchains.sh"},{"type":"read","cmd":"sed -n '1,200p' eval/scan-compiler-exposure.mjs","name":"scan-compiler-exposure.mjs","path":"eval/scan-compiler-exposure.mjs"},{"type":"read","cmd":"sed -n '1,120p' .github/workflows/ci.yml","name":"ci.yml","path":".github/workflows/ci.yml"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n\nrepo_root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd -P)\"\npolicy_file=\"$repo_root/eval/toolchain-versions.json\"\nrust_toolchain_file=\"$repo_root/rust-toolchain.toml\"\n\ngo_version=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"go\"])' \"$policy_file\")\"\nrust_version=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"rust\"])' \"$policy_file\")\"\ntoolchain_rust_version=\"$(sed -n 's/^channel = \"\\([0-9][0-9.]*\\)\"$/\\1/p' \"$rust_toolchain_file\")\"\n\nif [[ ! \"$go_version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ || ! \"$rust_version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]]; then\n  echo \"evaluator toolchain policy must contain exact semantic versions\" >&2\n  exit 1\nfi\nif [[ \"$rust_version\" != \"$toolchain_rust_version\" ]]; then\n  echo \"evaluator Rust version does not match rust-toolchain.toml\" >&2\n  exit 1\nfi\n\nassert_internal_symlinks() {\n  python3 - \"$1\" <<'PY'\nimport os\nimport sys\n\nroot = os.path.realpath(sys.argv[1], strict=True)\nfor current, directories, files in os.walk(root, followlinks=False):\n    for name in (*directories, *files):\n        item = os.path.join(current, name)\n        if not os.path.islink(item):\n            continue\n        try:\n            target = os.path.realpath(item, strict=True)\n            inside = os.path.commonpath((root, target)) == root\n        except (OSError, ValueError):\n            inside = False\n        if not inside:\n            print(f\"toolchain symlink is broken or escapes its root: {item}\", file=sys.stderr)\n            sys.exit(1)\nPY\n}\n\nexpected_go=\"go${go_version}\"\nactual_go=\"$(go version | awk '{print $3}')\"\nif [[ \"$actual_go\" != \"$expected_go\" ]]; then\n  echo \"Go version mismatch: expected $expected_go, got $actual_go\" >&2\n  exit 1\nfi\n\nrustup toolchain install \"$rust_version\" --profile minimal --component clippy --component rustfmt\nrust_root=\"$(rustup run \"$rust_version\" rustc --print sysroot)\"\nactual_rustc=\"$(rustup run \"$rust_version\" rustc --version | awk '{print $2}')\"\nactual_cargo=\"$(rustup run \"$rust_version\" cargo --version | awk '{print $2}')\"\nif [[ \"$actual_rustc\" != \"$rust_version\" || \"$actual_cargo\" != \"$rust_version\" ]]; then\n  echo \"Rust toolchain version mismatch: expected $rust_version, got rustc=$actual_rustc cargo=$actual_cargo\" >&2\n  exit 1\nfi\n\ngo_root=\"$(go env GOROOT)\"\ntest -n \"$go_root\" && test -d \"$go_root\"\ntest -n \"$rust_root\" && test -d \"$rust_root\"\ngo_root=\"$(realpath -e -- \"$go_root\")\"\nrust_root=\"$(realpath -e -- \"$rust_root\")\"\nassert_internal_symlinks \"$go_root\"\nassert_internal_symlinks \"$rust_root\"\nsudo rm -rf -- /usr/local/go /usr/local/nexus-qual/rust\nsudo install -d -o root -g root -m 0755 /usr/local /usr/local/go /usr/local/nexus-qual /usr/local/nexus-qual/rust\n# Materialize the trees so a symlinked hosted-toolcache root or any linked\n# entry cannot survive into the evaluator's pinned, non-replaceable roots.\nsudo cp -aL -- \"$go_root/.\" /usr/local/go/\nsudo cp -aL -- \"$rust_root/.\" /usr/local/nexus-qual/rust/\nsudo chown -hR root:root /usr/local/go /usr/local/nexus-qual/rust\nsudo chmod -R go-w /usr/local/go /usr/local/nexus-qual/rust\n\ncopied_go=\"$(/usr/local/go/bin/go version | awk '{print $3}')\"\ncopied_rustc=\"$(/usr/local/nexus-qual/rust/bin/rustc --version | awk '{print $2}')\"\ncopied_cargo=\"$(/usr/local/nexus-qual/rust/bin/cargo --version | awk '{print $2}')\"\nif [[ \"$copied_go\" != \"$expected_go\" || \"$copied_rustc\" != \"$rust_version\" || \"$copied_cargo\" != \"$rust_version\" ]]; then\n  echo \"copied evaluator toolchain version mismatch: go=$copied_go rustc=$copied_rustc cargo=$copied_cargo\" >&2\n  exit 1\nfi\n// Run trusted GNU find inventories across canonical system roots. Large roots are\n// split at bounded-depth subtrees so a broad directory cannot monopolize a worker.\nimport { isUtf8 } from \"node:buffer\";\nimport { spawn } from \"node:child_process\";\nimport path from \"node:path\";\n\nconst FIND = \"/usr/bin/find\";\nconst MAX_OUTPUT = 64 * 1024 * 1024;\nconst MAX_ENUMERATION_OUTPUT = 64 * 1024 * 1024;\n// This is a hard fail-closed bound. Keep the full inventory within it by letting GNU\n// find optimize the cheap name predicates ahead of filesystem metadata checks.\nconst TIMEOUT_MS = 25_000;\nconst MAX_ENTRIES = 500_000;\nconst MAX_JOBS = 100_000;\nconst MAX_ROOTS = 4_096;\nconst MAX_ROOT_BYTES = 1024 * 1024;\n// Amortize GNU find startup cost across disjoint system roots without approaching\n// the per-process argv size limit on Linux.\nconst MAX_ENUMERATION_ROOTS = 64;\nconst MAX_ENUMERATION_ROOT_BYTES = 64 * 1024;\n// Bundle enough sibling directories to avoid spawning one `find` process for\n// every pair on large hosted system roots, while keeping independent jobs for\n// bounded parallel scanning.\nconst DIRECTORY_BATCH_SIZE = 64;\nconst DIRECT_ENTRY_BATCH_SIZE = 256;\nconst SCAN_WORKERS = 8;\nconst COMPILER_NAMES = [\n  \"go\", \"go[0-9]*\", \"go-[0-9]*\",\n  \"rustc\", \"rustc[0-9]*\", \"rustc-[0-9]*\",\n  \"cargo\", \"cargo[0-9]*\", \"cargo-[0-9]*\",\n  \"rustup\",\n];\n\nfunction findArgs(roots) {\n  const nameExpression = COMPILER_NAMES.flatMap((name, index) => index === 0\n    ? [\"-name\", name]\n    : [\"-o\", \"-name\", name]);\n  const linkTargetExpression = COMPILER_NAMES.flatMap((name, index) => {\n    const patterns = [name, `*/${name}`];\n    return patterns.flatMap((pattern, patternIndex) => index === 0 && patternIndex === 0\n      ? [\"-lname\", pattern]\n      : [\"-o\", \"-lname\", pattern]);\n  });\n  return [\n    \"-O3\", \"-P\", ...roots,\n    \"(\", \"(\", \"-type\", \"l\", \"(\", ...nameExpression, \"-o\", ...linkTargetExpression, \")\", \")\",\n    \"-o\",\n    \"(\", \"(\", ...nameExpression, \")\", \"-a\", \"-type\", \"f\", \"-a\", \"-perm\", \"/111\", \")\",\n    \")\", \"-print0\",\n  ];\n}\n\nconst roots = process.argv.slice(2);\nconst rootBytes = roots.reduce((total, root) => total + Buffer.byteLength(root) + 1, 0);\nif (roots.length === 0 || roots.length > MAX_ROOTS || rootBytes > MAX_ROOT_BYTES || roots.some((root) => !root.startsWith(\"/\"))) {\n  process.stderr.write(\"compiler inventory roots must be absolute and within bounded input limits\\n\");\n  process.exit(2);\n}\n\nasync function* enumerateJobs() {\n  let entryCount = 0;\n  let jobCount = 0;\n  let enumerationBytes = 0;\n  let rootOffset = 0;\n  let batchIndex = 0;\n  while (rootOffset < roots.length) {\n    const batch = [];\n    let batchBytes = 0;\n    while (rootOffset < roots.length && batch.length < MAX_ENUMERATION_ROOTS) {\n      const root = roots[rootOffset];\n      const rootBytes = Buffer.byteLength(root) + 1;\n      if (batch.length > 0 && batchBytes + rootBytes > MAX_ENUMERATION_ROOT_BYTES) break;\n      batch.push(root);\n      batchBytes += rootBytes;\n      rootOffset += 1;\n    }\n    const child = spawn(FIND, [\"-P\", ...batch, \"-mindepth\", \"1\", \"-maxdepth\", \"3\", \"-printf\", \"%d\\\\0%y\\\\0%p\\\\0\"], {\n      env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    children.add(child);\n    let stderrBytes = 0;\n    let spawnError = null;\n    child.stderr.on(\"data\", (chunk) => {\n      stderrBytes += chunk.length;\n      failed = true;\n      stopAll(\"enumeration_stderr\");\n    });\n    child.on(\"error\", (error) => {\n      spawnError = error;\n      failed = true;\n      stopAll(\"enumeration_spawn_error\");\n    });\n    const closed = new Promise((resolve) => child.once(\"close\", (code, signal) => resolve({ code, signal })));\n    let scanDirectories = [];\n    let directEntries = [];\n    let entryDepth = null;\n    let entryType = null;\n    let pending = Buffer.alloc(0);\n    try {\n      for await (const chunk of child.stdout) {\n        enumerationBytes += chunk.length;\n        if (enumerationBytes > MAX_ENUMERATION_OUTPUT) {\n          failed = true;\n          stopAll(\"enumeration_output_limit\");\n          throw new Error(\"compiler inventory enumeration output limit exceeded\");\n        }\n        const data = pending.length ? Buffer.concat([pending, chunk]) : chunk;\n        let offset = 0;\n        while (true) {\n          const delimiter = data.indexOf(0, offset);\n          if (delimiter < 0) break;\n          const field = data.subarray(offset, delimiter);\n          offset = delimiter + 1;\n          if (entryDepth === null) {\n            if (field.length !== 1 || field[0] < 0x31 || field[0] > 0x33) {\n              throw new Error(\"invalid compiler inventory entry depth\");\n            }\n            entryDepth = field[0] - 0x30;\n            continue;\n          }\n          if (entryType === null) {\n            if (field.length !== 1) throw new Error(\"invalid compiler inventory entry type\");\n            entryType = field.toString(\"ascii\");\n            continue;\n          }\n          if (++entryCount > MAX_ENTRIES) {\n            failed = true;\n            stopAll(\"entry_limit\");\n            throw new Error(\"compiler inventory entry limit exceeded\");\n          }\n          const item = field.toString(\"utf8\");\n          if (!Buffer.from(item, \"utf8\").equals(field)) {\n            throw new Error(\"compiler inventory path is not valid UTF-8\");\n          }\n          let job;\n          // Enumerate three levels before scheduling recursive scans. This splits large\n          // immediate subtrees into independent jobs without following symlinked dirs.\n          if (entryType === \"d\" && entryDepth === 3) {\n            scanDirectories.push(item);\n            if (scanDirectories.length === DIRECTORY_BATCH_SIZE) {\n              job = scanDirectories;\n              scanDirectories = [];\n            }\n          } else {\n            if (entryType !== \"d\") {\n              directEntries.push(item);\n              if (directEntries.length === DIRECT_ENTRY_BATCH_SIZE) {\n                job = directEntries;\n                directEntries = [];\n              }\n            }\n          }\n          entryDepth = null;\n          entryType = null;\n          if (job) {\n            if (++jobCount > MAX_JOBS) {\n              failed = true;\n              stopAll(\"job_limit\");\n              throw new Error(\"compiler inventory job limit exceeded\");\n            }\n            yield job;\n          }\n        }\n        pending = data.subarray(offset);\n      }\n    } finally {\n      if (child.exitCode === null && !child.killed) child.kill(\"SIGTERM\");\n      const { code, signal } = await closed;\n      children.delete(child);\n      if (spawnError || code !== 0 || stderrBytes !== 0 || entryDepth !== null || entryType !== null || pending.length !== 0) {\n        failed = true;\n        const exitStatus = signal ? `signal_${signal.toLowerCase()}` : `code_${code ?? \"unknown\"}`;\n        stopAll(stderrBytes ? \"enumeration_stderr\" : spawnError ? \"enumeration_spawn_error\" : `enumeration_exit_batch_${batchIndex}_${exitStatus}`);\n      }\n    }\n    if (failed) throw new Error(\"compiler inventory enumeration failed\");\n    for (const remaining of [scanDirectories, directEntries]) {\n      if (remaining.length) {\n        if (++jobCount > MAX_JOBS) throw new Error(\"compiler inventory job limit exceeded\");\n        yield remaining;\n      }\n    }\n    batchIndex += 1;\n  }\n}\n\nconst jobs = enumerateJobs();\n\nconst children = new Set();\nconst outputs = [];\nlet outputBytes = 0;\nlet failed = false;\nlet failureReason = null;\nlet killTimer;\nlet stopping = false;\n\nfunction stopAll(reason = \"worker_error\") {\n  failureReason ??= reason;\n  if (stopping) return;\nname: CI\n\non:\n  push:\n    branches: [main]\n  pull_request:\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\njobs:\n  test-matrix:\n    runs-on: ubuntu-22.04\n    strategy:\n      fail-fast: false\n      matrix:\n        node: [22, 24]\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.12'\n      - name: Install pinned evaluator toolchains\n        run: bash scripts/install-evaluator-toolchains.sh\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: ${{ matrix.node }}\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - run: node scripts/sync-version.mjs --check\n      - run: node scripts/check_requirements.mjs\n      - run: npm ci --prefix cli\n      - run: npm --prefix cli run build\n      - run: git diff --exit-code -- cli/dist\n      - run: cargo test --locked --manifest-path core/Cargo.toml\n      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n      - name: Install pinned security and SBOM test tools\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - name: Run the CLI suite with a hang bound\n        # Normal runs take 12-20 minutes; a test process that never exits must fail the job, not hold it for 6 hours.\n        timeout-minutes: 45\n        run: npm --prefix cli test\n\n  linux-x86_64:\n    needs: [test-matrix]\n    runs-on: ubuntu-22.04\n    env:\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.12'\n      - name: Install pinned evaluator toolchains\n        run: bash scripts/install-evaluator-toolchains.sh\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n","exit_code":0,"duration":{"secs":1,"nanos":19501328}},"started_at_ms":1793350357588,"completed_at_ms":1793350358608}}
{"timestamp":"2026-10-30T08:52:38.824Z","ordinal":525174,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18c02-d727-79f2-b57a-43f4a4e4fca3","call_id":"call_b437da6c481348b999bc81d7963492d0","output":[{"type":"input_text","text":"Script completed\nWall time 1.6 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 4380)\nTotal output lines: 401\n\n#!/usr/bin/env bash\nset -euo pipefail\n\nrepo_root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd -P)\"\npolicy_file=\"$repo_root/eval/toolchain-versions.json\"\nrust_toolchain_file=\"$repo_root/rust-toolchain.toml\"\n\ngo_version=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"go\"])' \"$policy_file\")\"\nrust_version=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"rust\"])' \"$policy_file\")\"\ntoolchain_rust_version=\"$(sed -n 's/^channel = \"\\([0-9][0-9.]*\\)\"$/\\1/p' \"$rust_toolchain_file\")\"\n\nif [[ ! \"$go_version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ || ! \"$rust_version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]]; then\n  echo \"evaluator toolchain policy must contain exact semantic versions\" >&2\n  exit 1\nfi\nif [[ \"$rust_version\" != \"$toolchain_rust_version\" ]]; then\n  echo \"evaluator Rust version does not match rust-toolchain.toml\" >&2\n  exit 1\nfi\n\nassert_internal_symlinks() {\n  python3 - \"$1\" <<'PY'\nimport os\nimport sys\n\nroot = os.path.realpath(sys.argv[1], strict=True)\nfor current, directories, files in os.walk(root, followlinks=False):\n    for name in (*directories, *files):\n        item = os.path.join(current, name)\n        if not os.path.islink(item):\n            continue\n        try:\n            target = os.path.realpath(item, strict=True)\n            inside = os.path.commonpath((root, target)) == root\n        except (OSError, ValueError):\n            inside = False\n        if not inside:\n            print(f\"toolchain symlink is broken or escapes its root: {item}\", file=sys.stderr)\n            sys.exit(1)\nPY\n}\n\nexpected_go=\"go${go_version}\"\nactual_go=\"$(go version | awk '{print $3}')\"\nif [[ \"$actual_go\" != \"$expected_go\" ]]; then\n  echo \"Go version mismatch: expected $expected_go, got $actual_go\" >&2\n  exit 1\nfi\n\nrustup toolchain install \"$rust_version\" --profile minimal --component clippy --component rustfmt\nrust_root=\"$(rustup run \"$rust_version\" rustc --print sysroot)\"\nactual_rustc=\"$(rustup run \"$rust_version\" rustc --version | awk '{print $2}')\"\nactual_cargo=\"$(rustup run \"$rust_version\" cargo --version | awk '{print $2}')\"\nif [[ \"$actual_rustc\" != \"$rust_version\" || \"$actual_cargo\" != \"$rust_version\" ]]; then\n  echo \"Rust toolchain version mismatch: expected $rust_version, got rustc=$actual_rustc cargo=$actual_cargo\" >&2\n  exit 1\nfi\n\ngo_root=\"$(go env GOROOT)\"\ntest -n \"$go_root\" && test -d \"$go_root\"\ntest -n \"$rust_root\" && test -d \"$rust_root\"\ngo_root=\"$(realpath -e -- \"$go_root\")\"\nrust_root=\"$(realpath -e -- \"$rust_root\")\"\nassert_internal_symlinks \"$go_root\"\nassert_internal_symlinks \"$rust_root\"\nsudo rm -rf -- /usr/local/go /usr/local/nexus-qual/rust\nsudo install -d -o root -g root -m 0755 /usr/local /usr/local/go /usr/local/nexus-qual /usr/local/nexus-qual/rust\n# Materialize the trees so a symlinked hosted-toolcache root or any linked\n# entry cannot survive into the evaluator's pinned, non-replaceable roots.\nsudo cp -aL -- \"$go_root/.\" /usr/local/go/\nsudo cp -aL -- \"$rust_root/.\" /usr/local/nexus-qual/rust/\nsudo chown -hR root:root /usr/local/go /usr/local/nexus-qual/rust\nsudo chmod -R go-w /usr/local/go /usr/local/nexus-qual/rust\n\ncopied_go=\"$(/usr/local/go/bin/go version | awk '{print $3}')\"\ncopied_rustc=\"$(/usr/local/nexus-qual/rust/bin/rustc --version | awk '{print $2}')\"\ncopied_cargo=\"$(/usr/local/nexus-qual/rust/bin/cargo --version | awk '{print $2}')\"\nif [[ \"$copied_go\" != \"$expected_go\" || \"$copied_rustc\" != \"$rust_version\" || \"$copied_cargo\" != \"$rust_version\" ]]; then\n  echo \"copied evaluator toolchain version mismatch: go=$copied_go rustc=$copied_rustc cargo=$copied_cargo\" >&2\n  exit 1\nfi\n// Run trusted GNU find inventories across canonical system roots. Large roots are\n// split at bounded-depth subtrees so a broad directory cannot monopolize a worker.\nimport { isUtf8 } from \"node:buffer\";\nimport { spawn } from \"node:child_process\";\nimport path from \"node:path\";\n\nconst FIND = \"/usr/bin/find\";\nconst MAX_OUTPUT = 64 * 1024 * 1024;\nconst MAX_ENUMERATION_OUTPUT = 64 * 1024 * 1024;\n// This is a hard fail-closed bound. Keep the full inventory within it by letting GNU\n// find optimize the cheap name predicates ahead of filesystem metadata checks.\nconst TIMEOUT_MS = 25_000;\nconst MAX_ENTRIES = 500_000;\nconst MAX_JOBS = 100_000;\nconst MAX_ROOTS = 4_096;\nconst MAX_ROOT_BYTES = 1024 * 1024;\n// Amortize GNU find startup cost across disjoint system roots without approaching\n// the per-process argv size limit on Linux.\nconst MAX_ENUMERATION_ROOTS = 64;\nconst MAX_ENUMERATION_ROOT_BYTES = 64 * 1024;\n// Bundle enough sibling directories to avoid spawning one `find` process for\n// every pair on large hosted system roots, while keeping independent jobs for\n// bounded parallel scanning.\nconst DIRECTORY_BATCH_SIZE = 64;\nconst DIRECT_ENTRY_BATCH_SIZE = 256;\nconst SCAN_WORKERS = 8;\nconst COMPILER_NAMES = [\n  \"go\", \"go[0-9]*\", \"go-[0-9]*\",\n  \"rustc\", \"rustc[0-9]*\", \"rustc-[0-9]*\",\n  \"cargo\", \"cargo[0-9]*\", \"cargo-[0-9]*\",\n  \"rustup\",\n];\n\nfunction findArgs(roots) {\n  const nameExpression = COMPILER_NAMES.flatMap((name, index) => index === 0\n    ? [\"-name\", name]\n    : [\"-o\", \"-name\", name]);\n  const linkTargetExpression = COMPILER_NAMES.flatMap((name, index) => {\n    const patterns = [name, `*/${name}`];\n    return patterns.flatMap((pattern, patternIndex) => index === 0 && patternIndex === 0\n      ? [\"-lname\", pattern]\n      : [\"-o\", \"-lname\", pattern]);\n  });\n  return [\n    \"-O3\", \"-P\", ...roots,\n    \"(\", \"(\", \"-type\", \"l\", \"(\", ...nameExpression, \"-o\", ...linkTargetExpression, \")\", \")\",\n    \"-o\",\n    \"(\", \"(\", ...nameExpression, \")\", \"-a\", \"-type\", \"f\", \"-a\", \"-perm\", \"/111\", \")\",\n    \")\", \"-print0\",\n  ];\n}\n\nconst roots = process.argv.slice(2);\nconst rootBytes = roots.reduce((total, root) => total + Buffer.byteLength(root) + 1, 0);\nif (roots.length === 0 || roots.length > MAX_ROOTS || rootBytes > MAX_ROOT_BYTES || roots.some((root) => !root.startsWith(\"/\"))) {\n  process.stderr.write(\"compiler inventory roots must be absolute and within bounded input limits\\n\");\n  process.exit(2);\n}\n\nasync function* enumerateJobs() {\n  let entryCount = 0;\n  let jobCount = 0;\n  let enumerationBytes = 0;\n  let rootOffset = 0;\n  let batchIndex = 0;\n  while (rootOffset < roots.length) {\n    const batch = [];\n    let batchBytes = 0;\n    while (rootOffset < roots.length && batch.length < MAX_ENUMERATION_ROOTS) {\n      const root = roots[rootOffset];\n      const rootBytes = Buffer.byteLength(root) + 1;\n      if (batch.length > 0 && batchBytes + rootBytes > MAX_ENUMERATION_ROOT_BYTES) break;\n      batch.push(root);\n      batchBytes += rootBytes;\n      rootOffset += 1;\n    }\n    const child = spawn(FIND, [\"-P\", ...batch, \"-mindepth\", \"1\", \"-maxdepth\", \"3\", \"-printf\", \"%d\\\\0%y\\\\0%p\\\\0\"], {\n      env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    children.add(child);\n    let stderrBytes = 0;\n    let spawnError = null;\n    child.stderr.on(\"data\", (chunk) => {\n      stderrBytes += chunk.length;\n      failed = true;\n      stopAll(\"enumeration_stderr\");\n    });\n    child.on(\"error\", (error) => {\n      spawnError = error;\n      failed = true;\n      stopAll(\"enumeration_