ndpoint?: string }\ncli/src/protocol.ts:178:  /** Clear a completed local endpoint setup associated with this exact provider.connect request. */\ncli/src/protocol.ts:180:  | { type: \"provider.disconnect\"; id: string; provider: string }\ncli/src/protocol.ts:261:    case \"provider.connect\": {\ncli/src/protocol.ts:262:      const requestId = requireId(\"provider.connect\");\ncli/src/protocol.ts:264:        throw new ProtocolError(\"provider.connect requires provider and method\", requestId);\ncli/src/protocol.ts:266:      if (msg.key !== undefined && typeof msg.key !== \"string\") throw new ProtocolError(\"provider.connect key must be a string\", requestId);\ncli/src/protocol.ts:268:        throw new ProtocolError(\"provider.connect endpoint must be a valid single-line URL\", requestId);\ncli/src/protocol.ts:271:        type: \"provider.connect\", id: requestId, provider: msg.provider, method: msg.method,\ncli/src/protocol.ts:280:    case \"provider.disconnect\": {\ncli/src/protocol.ts:281:      const requestId = requireId(\"provider.disconnect\");\ncli/src/protocol.ts:282:      if (typeof msg.provider !== \"string\" || !msg.provider) throw new ProtocolError(\"provider.disconnect requires provider\", requestId);\ncli/src/protocol.ts:283:      return { type: \"provider.disconnect\", id: requestId, provider: msg.provider };\ncli/src/usage.ts:2: * Inference usage ledger: one receipt per provider-connection request (main agent, planner/coder, subagents and\ncli/src/config.ts:7:import { baseUrlSetting, originOf, parseOriginList, PROVIDERS, providerDefinition } from \"./providers.js\";\ncli/src/config.ts:275:    throw new Error(`Unknown provider '${chosen}' (${key}). Known providers: ${Object.keys(PROVIDERS).join(\", \")}.`);\ncli/src/config.ts:280:/** Base URL of a provider connection: the operator's override (flag or NEXUS_<ID>_BASE_URL), else the provider default. */\ncli/src/config.ts:290: * The provider's own key — its variable, Nexus's credential store, or a connection registered in another client —\ncli/src/config.ts:291: * bound to the connection's origin and never sent anywhere else. Sign-in (OAuth) providers resolve their token per\ncli/src/config.ts:348:  // `appliance: true` resolves the appliance connection regardless of any provider selection (the model picker's\ncli/src/config.ts:401:  if (provider && options.fallback) warnOnce(`--fallback is ignored for provider '${provider}': a provider connection is pinned to its own endpoint.`);\ncli/src/credentials.ts:363: * The credential a provider connection uses: its environment variable, else Nexus's store, else a connection\ncli/src/credentials.ts:366:/** The API key a provider connection uses (env, Nexus store, or another client); undefined for sign-in providers. */\ncli/src/doctor.ts:490:    out.push(f(\"endpoint.authenticated\", \"endpoint\", \"fail\", `The endpoint rejected the credential Nexus sends (HTTP ${status}).`, [where], config.provider ? `Reconnect with \\`nexus connect ${config.provider}\\` (or ctrl+p in /model).` : \"Set LOCAL_LLM_API_KEY (or pass -k) to a credential this gateway accepts.\"));\ncli/src/doctor.ts:926:    return f(\"credentials.store\", \"state\", \"fail\", \"Nexus's credential store is not valid JSON; stored provider connections are unavailable.\", [file], \"Move the file aside and reconnect with `nexus connect <provider>`.\");\ncli/src/provider_cli.ts:10:import { baseUrlSetting, disclosureClass, PROVIDERS } from \"./providers.js\";\ncli/src/provider_cli.ts:14:import { connectLocalEndpoint, connectWithKey, disconnect, startSignIn } from \"./provider_connect.js\";\ncli/src/provider_cli.ts:23:    const label = provider ? PROVIDERS[provider]?.label ?? \"Cloud provider\" : \"Local endpoint\";\ncli/src/provider_cli.ts:70:  return value && Object.prototype.hasOwnProperty.call(PROVIDERS, value) ? value : value ? \"(unrecognized provider)\" : undefined;\ncli/src/provider_cli.ts:78:  return `Configuration error: Unknown provider '(unrecognized provide