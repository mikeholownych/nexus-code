t instead.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18b4e-a8d9-78f0-bd60-966a1e9e4357","create_time":1793342521.9012513}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
