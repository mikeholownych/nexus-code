{"timestamp":"2026-10-30T08:03:46.103Z","ordinal":523181,"type":"token_usage_record","payload":{"thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18b8d-60e7-7130-962f-f0eb9e68c409","session_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","root_turn_id":"01a18b8d-60e7-7130-962f-f0eb9e68c409","response_id":"resp_0db389702a7164cc016ae44f5a67a0819fa63f0106bd6a5f9e","usage":{"input_tokens":215797,"cached_input_tokens":214912,"cache_write_input_tokens":0,"output_tokens":987,"reasoning_output_tokens":925,"total_tokens":216784},"turn_token_usage":{"input_tokens":53915483,"cached_input_tokens":53590656,"cache_write_input_tokens":0,"output_tokens":78801,"reasoning_output_tokens":40440,"total_tokens":53994284},"thread_token_usage":{"input_tokens":9862158849,"cached_input_tokens":9757941760,"cache_write_input_tokens":0,"output_tokens":28283817,"reasoning_output_tokens":16630841,"total_tokens":9890442666}}}
{"timestamp":"2026-10-30T08:03:46.361Z","ordinal":523182,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18b8d-60e7-7130-962f-f0eb9e68c409","item":{"type":"CommandExecution","id":"exec-c2b85dd4-3a9f-43f1-b9a0-a2d7809c9e1f","process_id":"17164","command":["/usr/bin/zsh","-lc","export ENTIRE_TOKEN_STORE=file; entire --help"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"export ENTIRE_TOKEN_STORE=file; entire --help"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"The command-line interface for Entire\n\nGetting Started:\n  To get started with Entire CLI, run 'entire enable' to enable\n  session tracking in your repository, then 'entire agent add <name>'\n  to install hooks for a specific agent. For more information, visit:\n  https://docs.entire.io/overview\n\n\nEnvironment Variables:\n  ACCESSIBLE    Set to any value (e.g., ACCESSIBLE=1) to enable accessibility\n                mode. This uses simpler text prompts instead of interactive\n                TUI elements, which works better with screen readers.\n\nUsage:\n  entire [flags]\n  entire [command]\n\nEntire Setup:\n  agent                      Manage agent integrations (add, remove, list)\n  clean                      Clean up Entire session data\n  configure                  Update Entire settings in the current repository\n  disable                    Disable Entire in current repository\n  doctor                     Diagnose and fix session issues\n  enable                     Enable Entire in current repository\n  plugin                     Manage Entire plugins (install, list, upgrade, search, remove)\n  status                     Show Entire status\n\nSessions & Checkpoints:\n  activity                   Show your activity overview\n  checkpoint                 Inspect and search checkpoints\n  dispatch                   Generate a dispatch summarizing recent agent work\n  recap                      Summarize recent checkpoint activity\n  search                     Search checkpoints, commits, and sessions using semantic and keyword matching\n  session                    Manage agent sessions tracked by Entire\n\nTrails:\n  trail                      Manage trails across repositories and branches\n\nAccount:\n  auth                       Manage authentication\n  login                      Log in to Entire\n  logout                     Log out of Entire\n\nControl Plane:\n  api                        Make an authenticated request to an Entire API and print the response\n  cluster                    Show the Entire clusters you can place projects and repos on\n  org                        Manage Entire organizations\n  project                    Manage Entire projects\n  repo                       Manage Entire repositories\n\nAdditional Commands:\n  agent-help                 Machine-readable usage for coding agents (always matches the installed CLI)\n  help                       Help about any command\n  labs                       Explore experimental Entire workflows\n  version                    Show build information\n\nFlags:\n      --context name   Act as this saved login name for this command only — including the git and agent processes it spawns — instead of the active context (entire auth contexts lists them)\n  -h, --help           help for entire\n  -v, --version        version for entire\n\nUse \"entire [command] --help\" for more information about a command.\n","exit_code":0,"duration":{"secs":0,"nanos":39269}},"started_at_ms":1793347426360,"completed_at_ms":1793347426361}}
{"timestamp":"2026-10-30T08:03:47.959Z","ordinal":523183,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18bd6-1e77-7401-9d41-25c5b3ee7237","call_id":"call_be3e8c78e2934ac7ba878ceb0cc6967d","output":[{"type":"input_text","text":"Script completed\nWall time 1.9 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"c619d5\",\"wall_time_seconds\":0.000039269,\"exit_code\":0,\"original_token_count\":717,\"output\":\"The command-line interface for Entire\\n\\nGetting Started:\\n  To get started with Entire CLI, run 'entire enable' to enable\\n  session tracking in your repository, then 'entire agent add <name>'\\n  to install hooks for a specific agent. For more information, visit:\\n  https://docs.entire.io/overview\\n\\n\\nEnvironment Variables:\\n  ACCESSIBLE    Set to any value (e.g., ACCESSIBLE=1) to enable accessibility\\n                mode. This uses simpler text prompts instead of interactive\\n                TUI elements, which works better with screen readers.\\n\\nUsage:\\n  entire [flags]\\n  entire [command]\\n\\nEntire Setup:\\n  agent                      Manage agent integrations (add, remove, list)\\n  clean                      Clean up Entire session data\\n  configure                  Update Entire settings in the current repository\\n  disable                    Disable Entire in current repository\\n  doctor                     Diagnose and fix session issues\\n  enable                     Enable Entire in current repository\\n  plugin                     Manage Entire plugins (install, list, upgrade, search, remove)\\n  status                     Show Entire status\\n\\nSessions & Checkpoints:\\n  activity                   Show your activity overview\\n  checkpoint                 Inspect and search checkpoints\\n  dispatch                   Generate a dispatch summarizing recent agent work\\n  recap                      Summarize recent checkpoint activity\\n  search                     Search checkpoints, commits, and sessions using semantic and keyword matching\\n  session                    Manage agent sessions tracked by Entire\\n\\nTrails:\\n  trail                      Manage trails across repositories and branches\\n\\nAccount:\\n  auth                       Manage authentication\\n  login                      Log in to Entire\\n  logout                     Log out of Entire\\n\\nControl Plane:\\n  api                        Make an authenticated request to an Entire API and print the response\\n  cluster                    Show the Entire clusters you can place projects and repos on\\n  org                        Manage Entire organizations\\n  project                    Manage Entire projects\\n  repo                       Manage Entire repositories\\n\\nAdditional Commands:\\n  agent-help                 Machine-readable usage for coding agents (always matches the installed CLI)\\n  help                       Help about any command\\n  labs                       Explore experimental Entire workflows\\n  version                    Show build information\\n\\nFlags:\\n      --context name   Act as this saved login name for this command only — including the git and agent processes it spawns — instead of the active context (entire auth contexts lists them)\\n  -h, --help           help for entire\\n  -v, --version        version for entire\\n\\nUse \\\"entire [command] --help\\\" for more information about a command.\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18b8d-60e7-7130-962f-f0eb9e68c409","create_time":1793347427.9598234}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
