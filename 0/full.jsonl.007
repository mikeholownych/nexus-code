{"timestamp":"2026-10-30T10:07:52.856Z","ordinal":527844,"type":"token_usage_record","payload":{"thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18c3d-7cdd-71d3-966d-f30f05df4fb0","session_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","root_turn_id":"01a18c3d-7cdd-71d3-966d-f30f05df4fb0","response_id":"resp_0db389702a7164cc016ae46c770e78819f8803180345ffd618","usage":{"input_tokens":230878,"cached_input_tokens":229248,"cache_write_input_tokens":0,"output_tokens":138,"reasoning_output_tokens":30,"total_tokens":231016},"turn_token_usage":{"input_tokens":11412535,"cached_input_tokens":11329408,"cache_write_input_tokens":0,"output_tokens":31061,"reasoning_output_tokens":20842,"total_tokens":11443596},"thread_token_usage":{"input_tokens":9961940489,"cached_input_tokens":9856913408,"cache_write_input_tokens":0,"output_tokens":28544423,"reasoning_output_tokens":16786004,"total_tokens":9990484912}}}
{"timestamp":"2026-10-30T10:07:54.160Z","ordinal":527845,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18c3d-7cdd-71d3-966d-f30f05df4fb0","item":{"type":"CommandExecution","id":"exec-cbc270db-2a4b-4eb5-b03e-9858a6bbdb33","process_id":"15047","command":["/usr/bin/zsh","-lc","sed -n '1,210p' .github/workflows/repro.yml; sed -n '1,80p' docs/reviews/evidence/v1-qualification/rc.10/cross-runner/repro-evidence.json"],"cwd":"file:///home/mike/nexus-wt/rc14-artifact-verification","parsed_cmd":[{"type":"read","cmd":"sed -n '1,210p' .github/workflows/repro.yml","name":"repro.yml","path":".github/workflows/repro.yml"},{"type":"read","cmd":"sed -n '1,80p' docs/reviews/evidence/v1-qualification/rc.10/cross-runner/repro-evidence.json","name":"repro-evidence.json","path":"docs/reviews/evidence/v1-qualification/rc.10/cross-runner/repro-evidence.json"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"name: Cross-runner RC reproducibility\n\non:\n  workflow_dispatch:\n    inputs:\n      tag:\n        description: Published v1.0.0 RC tag with lock-pinned release tools (for example v1.0.0-rc.4)\n        required: true\n        type: string\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: rc-repro-${{ inputs.tag }}\n  cancel-in-progress: false\n\njobs:\n  resolve-tag:\n    runs-on: ubuntu-22.04\n    outputs:\n      tag_sha: ${{ steps.resolve.outputs.tag_sha }}\n      workflow_sha: ${{ steps.resolve.outputs.workflow_sha }}\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n    steps:\n      - name: Require dispatch from main\n        run: |\n          if [[ \"$GITHUB_REF\" != \"refs/heads/main\" ]]; then\n            echo \"Dispatch this workflow from main so the checked workflow is the reviewed release version.\" >&2\n            exit 1\n          fi\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22.22.1\n      - id: resolve\n        name: Resolve published RC tag to an immutable commit\n        run: |\n          if [[ ! \"$TARGET_TAG\" =~ ^v1\\.0\\.0-rc\\.[1-9][0-9]*$ ]]; then\n            echo \"Expected a v1.0.0-rc.N tag; received an invalid tag.\" >&2\n            exit 1\n          fi\n          git fetch origin main --no-tags\n          git fetch origin \"refs/tags/$TARGET_TAG:refs/tags/$TARGET_TAG\"\n          tag_sha=\"$(git rev-parse \"$TARGET_TAG^{commit}\")\"\n          git merge-base --is-ancestor \"$tag_sha\" origin/main\n          git checkout --detach \"$tag_sha\"\n          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n          test -f \"docs/releases/$TARGET_TAG.md\"\n          if [[ ! -s scripts/release-tools/package.json || ! -s scripts/release-tools/package-lock.json ]] || \\\n             ! grep -Fq 'scripts/release-tools/package-lock.json' scripts/package-linux.sh || \\\n             ! grep -Fq 'check_deprecated_lock.mjs' scripts/package-linux.sh || \\\n             grep -Eq '(^|[[:space:]])npx([[:space:]]|$)' scripts/package-linux.sh scripts/generate_sbom.sh; then\n            echo \"The selected RC predates or bypasses the locked notices tool and lock deprecation gate; cross-runner reproduction requires an RC whose tag includes them.\" >&2\n            exit 1\n          fi\n          printf 'tag_sha=%s\\n' \"$tag_sha\" >> \"$GITHUB_OUTPUT\"\n          printf 'workflow_sha=%s\\n' \"$GITHUB_WORKFLOW_SHA\" >> \"$GITHUB_OUTPUT\"\n      - name: Verify the public RC release is published\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          gh release view \"$TARGET_TAG\" --json isPrerelease,isDraft \\\n            | jq -e '.isPrerelease == true and .isDraft == false' >/dev/null\n\n  build:\n    needs: resolve-tag\n    runs-on: ${{ matrix.runner }}\n    timeout-minutes: 120\n    strategy:\n      fail-fast: false\n      matrix:\n        runner: [ubuntu-22.04, ubuntu-24.04]\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n      EXPECTED_TAG_SHA: ${{ needs.resolve-tag.outputs.tag_sha }}\n      EXPECTED_WORKFLOW_SHA: ${{ needs.resolve-tag.outputs.workflow_sha }}\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: ${{ needs.resolve-tag.outputs.tag_sha }}\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22.22.1\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Require the pinned release Node and npm versions\n        run: |\n          test \"$(node --version)\" = \"v22.22.1\"\n          test \"$(npm --version)\" = \"10.9.4\"\n      - name: Verify exact RC source\n        run: |\n          test \"$(git rev-parse HEAD)\" = \"$EXPECTED_TAG_SHA\"\n          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n          test \"$GITHUB_REF\" = refs/heads/main\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # pinned Rust toolchain action\n        with:\n          toolchain: 1.95.0\n      - name: Install pinned SBOM and notices tools\n        run: |\n          cargo_home=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME=\"$cargo_home\"\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - name: Verify the pinned package builder is available\n        run: |\n          docker info >/dev/null\n          test \"$NEXUS_BUILD_CONTAINER_IMAGE\" = 'rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb'\n      - name: Build the exact RC package\n        env:\n          NEXUS_PACKAGE_TOOL_COMMIT: ${{ needs.resolve-tag.outputs.workflow_sha }}\n        run: |\n          git fetch origin main --no-tags\n          git merge-base --is-ancestor \"$NEXUS_PACKAGE_TOOL_COMMIT\" origin/main\n          package_tool=\"$RUNNER_TEMP/package-linux.sh\"\n          git show \"$NEXUS_PACKAGE_TOOL_COMMIT:scripts/package-linux.sh\" > \"$package_tool\"\n          NEXUS_PACKAGE_SOURCE=\"$GITHUB_WORKSPACE\" bash \"$package_tool\" \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\"\n      - name: Record source, toolchain, and published-asset identity\n        env:\n          NEXUS_PACKAGE_TOOL_COMMIT: ${{ needs.resolve-tag.outputs.workflow_sha }}\n          NEXUS_PACKAGE_TOOL_SCRIPT: ${{ runner.temp }}/package-linux.sh\n        run: |\n          git show \"$EXPECTED_WORKFLOW_SHA:scripts/repro-identity.mjs\" > \"$RUNNER_TEMP/repro-identity.mjs\"\n          node \"$RUNNER_TEMP/repro-identity.mjs\" record \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\" \\\n            \"$RUNNER_TEMP/dist/repro-identity.json\" \"${{ matrix.runner }}\"\n      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n        with:\n          name: nexus-repro-${{ matrix.runner }}\n          path: |\n            ${{ runner.temp }}/dist/nexus-linux-x86_64-${{ inputs.tag }}.tar.gz\n            ${{ runner.temp }}/dist/compatibility.json\n            ${{ runner.temp }}/dist/SHA256SUMS\n            ${{ runner.temp }}/dist/THIRD_PARTY_NOTICES.txt\n            ${{ runner.temp }}/dist/sbom.cdx.json\n            ${{ runner.temp }}/dist/install.sh\n            ${{ runner.temp }}/dist/repro-identity.json\n          if-no-files-found: error\n          retention-days: 14\n\n  compare:\n    needs: [resolve-tag, build]\n    runs-on: ubuntu-22.04\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n      EXPECTED_TAG_SHA: ${{ needs.resolve-tag.outputs.tag_sha }}\n      EXPECTED_WORKFLOW_SHA: ${{ needs.resolve-tag.outputs.workflow_sha }}\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: ${{ needs.resolve-tag.outputs.workflow_sha }}\n          fetch-depth: 1\n          persist-credentials: false\n      - name: Verify comparison code is the exact reviewed workflow commit\n        run: test \"$(git rev-parse HEAD)\" = \"$EXPECTED_WORKFLOW_SHA\"\n      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n        with:\n          name: nexus-repro-ubuntu-22.04\n          path: ${{ runner.temp }}/ubuntu-22.04\n      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n        with:\n          name: nexus-repro-ubuntu-24.04\n          path: ${{ runner.temp }}/ubuntu-24.04\n      - name: Download published RC assets\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          archive=\"nexus-linux-x86_64-$TARGET_TAG.tar.gz\"\n          mkdir -p \"$RUNNER_TEMP/published\"\n          gh release download \"$TARGET_TAG\" \\\n            --pattern \"$archive\" \\\n            --pattern compatibility.json \\\n            --pattern SHA256SUMS \\\n            --pattern THIRD_PARTY_NOTICES.txt \\\n            --pattern sbom.cdx.json \\\n            --pattern install.sh \\\n            --dir \"$RUNNER_TEMP/published\"\n      - name: Compare both runner builds with each other and the published RC\n        run: |\n          archive=\"nexus-linux-x86_64-$TARGET_TAG.tar.gz\"\n          for runner in ubuntu-22.04 ubuntu-24.04; do\n            (cd \"$RUNNER_TEMP/$runner\" && sha256sum --check SHA256SUMS)\n          done\n          (cd \"$RUNNER_TEMP/published\" && sha256sum --check SHA256SUMS)\n          for file in \"$archive\" compatibility.json SHA256SUMS THIRD_PARTY_NOTICES.txt sbom.cdx.json install.sh; do\n            cmp \"$RUNNER_TEMP/ubuntu-22.04/$file\" \"$RUNNER_TEMP/ubuntu-24.04/$file\"\n            cmp \"$RUNNER_TEMP/ubuntu-22.04/$file\" \"$RUNNER_TEMP/published/$file\"\n          done\n          node scripts/repro-identity.mjs compare \"$TARGET_TAG\" \"$EXPECTED_TAG_SHA\" \"$EXPECTED_WORKFLOW_SHA\" \\\n            \"$RUNNER_TEMP/repro-evidence.json\" \\\n            \"$RUNNER_TEMP/ubuntu-22.04/repro-identity.json\" \\\n            \"$RUNNER_TEMP/ubuntu-24.04/repro-identity.json\"\n          archive_sha=\"$(sha256sum \"$RUNNER_TEMP/ubuntu-22.04/$archive\" | cut -d' ' -f1)\"\n          {\n{\n  \"requirement\": \"REQ-REL-114\",\n  \"acceptance\": \"ACC-SUP-08\",\n  \"result\": \"PASS\",\n  \"workflowRun\": \"https://github.com/mikeholownych/nexus-code/actions/runs/40433818126\",\n  \"workflow\": {\n    \"ref\": \"refs/heads/main\",\n    \"sha\": \"16ee8ca3643824741b6da67936b41f262414fdf0\",\n    \"runId\": \"40433818126\",\n    \"runAttempt\": \"1\"\n  },\n  \"source\": {\n    \"version\": \"v1.0.0-rc.10\",\n    \"commit\": \"16ee8ca364