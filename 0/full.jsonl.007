{"timestamp":"2026-10-30T06:42:23.186Z","ordinal":521164,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18b4e-a8d9-78f0-bd60-966a1e9e4357","item":{"type":"CommandExecution","id":"exec-a163bb5c-e51c-445d-bb4f-c39370a263bb","process_id":"33406","command":["/usr/bin/zsh","-lc","cd /home/mike/nexus-wt/pr335-release-parity-combination && sed -n '170,245p' cli/src/model_catalog.ts && sed -n '290,335p' core/src/bin/nexus_tui/models.rs && sed -n '3130,3185p' core/src/bin/nexus_tui/live_view.rs && sed -n '100,180p' cli/test/tui_model_picker_e2e.test.ts"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"read","cmd":"sed -n '170,245p' cli/src/model_catalog.ts","name":"model_catalog.ts","path":"/home/mike/nexus-wt/pr335-release-parity-combination/cli/src/model_catalog.ts"},{"type":"read","cmd":"sed -n '290,335p' core/src/bin/nexus_tui/models.rs","name":"models.rs","path":"/home/mike/nexus-wt/pr335-release-parity-combination/core/src/bin/nexus_tui/models.rs"},{"type":"read","cmd":"sed -n '3130,3185p' core/src/bin/nexus_tui/live_view.rs","name":"live_view.rs","path":"/home/mike/nexus-wt/pr335-release-parity-combination/core/src/bin/nexus_tui/live_view.rs"},{"type":"read","cmd":"sed -n '100,180p' cli/test/tui_model_picker_e2e.test.ts","name":"tui_model_picker_e2e.test.ts","path":"/home/mike/nexus-wt/pr335-release-parity-combination/cli/test/tui_model_picker_e2e.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"      endpoint = source.endpoint;\n      const ids = (await withTimeout(source.list(), timeoutMs)).filter((id) => chatModel(entry.id, id));\n      cache(cacheId(entry.id, endpoint), ids);\n      models.push(...ids.map((id) => ({ provider: entry.id, id })));\n    } catch (err: any) {\n      const old = endpoint ? cached(cacheId(entry.id, endpoint)) : undefined;\n      entry.status = old ? \"cached\" : \"error\";\n      entry.error = String(err?.message ?? err).slice(0, 200);\n      if (old) models.push(...old.map((id) => ({ provider: entry.id, id })));\n    }\n  };\n\n  const applianceEntry: CatalogProvider = {\n    id: APPLIANCE,\n    label: `Appliance (${originOf(appliance.endpoint)?.replace(/^https?:\\/\\//, \"\") ?? appliance.endpoint})`,\n    disclosure: applianceClient.disclosureOf(),\n    connected: true,\n    methods: [],\n    status: \"ok\",\n  };\n  providers.push(applianceEntry);\n  const jobs: Promise<void>[] = [load(applianceEntry, () => ({ endpoint: appliance.endpoint, list: () => applianceClient.listModels() }))];\n\n  for (const def of Object.values(PROVIDERS)) {\n    const c = connectionOf(def.id);\n    if (def.id === \"compatible\" && !c.connected) continue; // needs a base URL before it is meaningful\n    const entry: CatalogProvider = {\n      id: def.id,\n      label: def.label,\n      disclosure: \"cloud\",\n      connected: c.connected,\n      ...(c.source ? { source: c.source } : {}),\n      ...(c.external ? { external: true } : {}),\n      methods: def.methods,\n      status: c.connected ? \"ok\" : \"disconnected\",\n    };\n    providers.push(entry);\n    if (c.connected) jobs.push(load(entry, () => {\n      const provider = providerConfig(config, def.id);\n      return { endpoint: provider.endpoint, list: () => new LocalLlmClient(provider).listModels() };\n    }));\n  }\n  await Promise.all(jobs);\n\n  const order = new Map(providers.map((p, i) => [p.id, i]));\n  models.sort((a, b) => (order.get(a.provider)! - order.get(b.provider)!) || a.id.localeCompare(b.id));\n  return {\n    providers,\n    models,\n    current: { provider: config.provider ?? APPLIANCE, model: config.model },\n    recent: readRecent(),\n  };\n}\npub enum ConnectIntent {\n    /// Back to the model picker.\n    Back,\n    /// Send provider.connect (`key` only for API keys).\n    Connect { provider: String, method: String, key: Option<String> },\n    LocalEndpoint { endpoint: String, key: Option<Secret> },\n    Cancel { request: String },\n    Disconnect { provider: String },\n}\n\n/// Connectable cloud providers and the local appliance endpoint setup entry.\nfn connectable(providers: &[CatalogProvider]) -> Vec<&CatalogProvider> {\n    providers.iter().filter(|p| p.id == \"appliance\" || !p.methods.is_empty()).collect()\n}\n\nimpl Connect {\n    /// Opens on the provider list, or straight at provider `at`; a sole sign-in method starts at once (the intent).\n    pub fn new(providers: Vec<CatalogProvider>, at: Option<&str>) -> (Self, Option<ConnectIntent>) {\n        let mut flow = Connect {\n            providers,\n            step: Step::Providers { pick: 0 },\n            notice: None,\n            refresh: None,\n        };\n        let mut intent = None;\n        if let Some(id) = at\n            && let Some(index) = connectable(&flow.providers).iter().position(|p| p.id == id)\n        {\n            flow.step = Step::Providers { pick: index };\n            intent = flow.choose_provider(id.to_string());\n        }\n        (flow, intent)\n    }\n\n    pub fn list(&self) -> Vec<&CatalogProvider> {\n        connectable(&self.providers)\n    }\n\n    pub fn provider(&self, id: &str) -> Option<&CatalogProvider> {\n        self.providers.iter().find(|p| p.id == id)\n    }\n\n    pub fn methods(&self, id: &str) -> Vec<ConnectMethod> {\n        self.provider(id).map(|p| p.methods.clone()).unwrap_or_default()\n    }\n\n        state.on_key(KeyEvent::new(KeyCode::Down, KeyModifiers::NONE)); // appliance -> ChatGPT\n        state.on_key(KeyEvent::new(KeyCode::Down, KeyModifiers::NONE)); // ChatGPT -> Anthropic\n        state.on_key(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));\n        state.on_paste(\"sk-ant-VISIBLE-NEVER\");\n        let screen = draw(&state, 100, 24);\n        assert!(!screen.contains(\"VISIBLE\"), \"the key is never drawn: {screen}\");\n        assert!(screen.contains(\"••••\"), \"{screen}\");\n        assert!(screen.contains(\"20 characters\"), \"{screen}\");\n    }\n\n}\n\n\n// ---------------------------------------------------------------- model picker and provider connection\n\nfn titled_block(title: String) -> Block<'static> {\n    Block::bordered()\n        .border_type(BorderType::Rounded)\n        .border_style(Style::default().fg(ACCENT))\n        .title(Span::styled(title, Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)))\n}\n\nfn key_hints(pairs: &[(&'static str, &'static str)]) -> Line<'static> {\n    let key = Style::default().fg(ACCENT).add_modifier(Modifier::BOLD);\n    let mut spans = Vec::new();\n    for (k, text) in pairs {\n        spans.push(Span::styled(format!(\" {k}\"), key));\n        spans.push(Span::styled(format!(\" {text} \"), Style::default().fg(MUTED)));\n    }\n    Line::from(spans)\n}\n\n/// Draws `lines` in `area`, scrolled so that line `focus` is visible.\nfn list_window(frame: &mut Frame, area: Rect, lines: Vec<Line<'_>>, focus: usize) {\n    let rows = usize::from(area.height);\n    let offset = if rows == 0 { 0 } else { (focus + 1).saturating_sub(rows) };\n    let shown: Vec<Line> = lines.into_iter().skip(offset).take(rows).collect();\n    frame.render_widget(Paragraph::new(shown), area);\n}\n\nfn render_models(frame: &mut Frame, area: Rect, picker: &Picker) {\n    let rect = modal(area, 96, area.height);\n    let title = match (&picker.only, &picker.catalog) {\n        (Some(only), Fetch::Ready(catalog)) => {\n            let label = catalog.providers.iter().find(|p| &p.id == only).map_or(only.as_str(), |p| p.label.as_str());\n            format!(\" Select model — {label} \")\n        }\n        _ => \" Select model \".to_string(),\n    };\n    let block = titled_block(title);\n    let inner = block.inner(rect);\n    frame.render_widget(Clear, rect);\n    frame.render_widget(block, rect);\n    if inner.height < 3 {\n        return;\n    }\n    const send = async (bytes: string) => {\n      proc.stdin!.write(bytes);\n      await sleep(200);\n    };\n    const events = () => read(eventsLog).split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    const screenSince = (mark: number) => stripCsi(pty.slice(mark));\n\n    await waitUntil(() => read(eventsLog).includes('\"type\":\"session.state\"') && stripCsi(pty).includes(\"newline\"), 20_000).catch(() => {\n      throw new Error(`the live TUI never became ready${diag()}`);\n    });\n    await sleep(300);\n\n    // 1. /model opens the picker with the appliance and a connect row for Anthropic.\n    let mark = pty.length;\n    await send(\"/model\");\n    await send(\"\\r\");\n    await waitUntil(() => read(eventsLog).includes('\"type\":\"models.catalog\"'), 20_000).catch(() => { throw new Error(`no catalog${diag()}`); });\n    await sleep(400);\n    assert.ok(screenSince(mark).includes(\"Select model\"), diag());\n    assert.ok(screenSince(mark).replace(/\\s+/g, \"\").includes(\"ConnectAnthropic\"), diag());\n\n    // 2. ctrl+p: the connect panel; the appliance setup row precedes OpenRouter, OpenAI, and Anthropic.\n    mark = pty.length;\n    await send(\"\\x10\");\n    assert.ok(screenSince(mark).includes(\"Connect a provider\"), diag());\n    await send(\"\\x1b[B\");\n    await send(\"\\x1b[B\");\n    await send(\"\\x1b[B\");\n    await send(\"\\r\");\n    await send(`\\x1b[200~${KEY}\\x1b[201~`);\n    await send(\"\\r\");\n    await waitUntil(() => events().some((e) => e.type === \"provider.result\"), 20_000).catch(() => { throw new Error(`no provider.result${diag()}`); });\n    const result = events().find((e) => e.type === \"provider.result\");\n    assert.equal(result.success, true, diag());\n\n    // 3. The picker returns showing Anthropic's models; enter switches the session.\n    await waitUntil(() => events().filter((e) => e.type === \"models.catalog\").length >= 2, 20_000).catch(() => { throw new Error(`picker did not reopen${diag()}`); });\n    await sleep(400);\n    await send(\"\\r\");\n    await waitUntil(() => events().some((e) => e.type === \"model.result\"), 20_000).catch(() => { throw new Error(`no model.result${diag()}`); });\n    assert.equal(events().find((e) => e.type === \"model.result\").success, true, diag());\n    await waitUntil(() => events().some((e) => e.type === \"session.state\" && e.model === \"anthropic · claude-e2e\"), 5_000).catch(() => { throw new Error(`session did not switch${diag()}`); });\n\n    // 4. The next prompt is answered by Anthropic with its own key.\n    await send(\"hello\");\n    await send(\"\\r\");\n    await waitUntil(() => read(eventsLog).includes('\"type\":\"turn.result\"'), 30_000).catch(() => { throw new Error(`no turn.result${diag()}`); });\n    const messages = anth.seen.filter((s) => s.path.startsWith(\"/v1/messages\"));\n    assert.equal(messages.length, 1, diag());\n    assert.equal(messages[0].key, KEY);\n    assert.equal(gw.requests.length, 0, \"the appliance received no chat request after the switch\");\n    await sleep(400);\n    assert.ok(stripCsi(pty).replace(/\\s+/g, \"\").includes(\"HellofromClaude.\"), diag());\n\n    // 5. The key is never drawn, never in sidecar output, and saved owner-only.\n    assert.ok(!pty.includes(KEY), \"the key appeared on screen\");\n    assert.ok(!read(eventsLog).includes(KEY), \"the key appeared in sidecar events\");\n    const stored = path.join(home, \".config/nexus/credentials.json\");\n    assert.equal(fs.statSync(stored).mode & 0o777, 0o600);\n\n    proc.stdin!.write(\"\\x03\");\n    const code = await Promise.race([exited, new Promise<\"timeout\">((r) => setTimeout(() => r(\"timeout\"), 20_000).unref())]);\n    assert.equal(code, 0, `script did not exit 0 (got ${code})${diag()}`);\n  } finally {\n    if (child && child.exitCode === null && child.signalCode === null) {\n      const gone = new Promise((resolve) => child!.once(\"exit\", resolve));\n      child.stdin?.write(\"\\x03\\x03\\x03\");\n      await Promise.race([gone, new Promise((resolve) => setTimeout(resolve, 3000).unref())]);\n      if (child.exitCode === null && child.signalCode === null) child.kill(\"SIGKILL\");\n    }\n    await gw.close();\n    await anth.close();\n    for (const dir of [repo, home, logs]) fs.rmSync(dir, { recursive: true, force: true });\n  }\n});\n","exit_code":0,"duration":{"secs":0,"nanos":35385}},"started_at_ms":1793342543185,"completed_at_ms":1793342543186}}
