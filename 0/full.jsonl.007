readFileSync(path.join(out, \"results.jsonl\"), \"utf8\");\n    const replay = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(replay.status, 2);\n    assert.match(replay.stderr, /output directory must be new/);\n    assert.equal(fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\"), priorResults, \"reusing an output directory changed prior evidence\");\n    assert.match(manifest.harness.string, /^[0-9a-f]{12}/);\n    const logDir = records[0].logs ? path.join(out, records[0].logs) : null;\n    const readLog = (file: string) => logDir && fs.existsSync(path.join(logDir, file)) ? fs.readFileSync(path.join(logDir, file), \"utf8\") : \"<not written>\";\n    return { records, score: JSON.parse(scored.stdout), hiddenLog: readLog(\"hidden.log\"), agentLog: readLog(\"agent.stdout.json\"), agentError: readLog(\"agent.stderr.log\") };\n  } finally {\n    await gw.close();\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n  const { nexusContextLimitArgs } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\" }, 65536), []);\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\", limits: { context: 8192 } }, 65536), [\"--context-limit\", \"8192\"]);\n  assert.deepEqual(nexusContextLimitArgs({}, 65536), [\"--context-limit\", \"65536\"]);\n});\n\ntest(\"a standalone server-profile run discovers context instead of forcing the harness default\", { timeout: 300_000 }, async () => {\n  const result = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { serverProfile: \"llamacpp\" });\n  assert.equal(result.records[0].hiddenPass, true);\n  assert.ok(result.records[0].model.profileContextLookups > 0, \"llama.cpp context comes from the profile endpoint\");\n});\n\ntest(\"T4 smoke: an overloaded endpoint is waited out and the task still completes; the fault is recorded\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"overloaded\", atRequest: 1 }] });\n  const r = records[0];\n  assert.deepEqual(r.model.faultsInjected, [{ kind: \"overloaded\", atRequest: 1 }]);\n  assert.equal(r.hiddenPass, true, JSON.stringify(r.turn));\n  assert.equal(r.falseVerified, false);\n  assert.equal(score.faults.length, 9, \"the scorer always exposes all nine accepted T4 fault classes\");\n  assert.equal(score.t4.gate, \"FAIL\", \"one smoke fault is not a nine-class qualification\");\n  assert.deepEqual(score.faults.filter((f: any) => f.n > 0).map((f: any) => [f.kind, f.n, f.truthful, f.recovered]), [[\"overloaded\", 1, 1, 1]]);\n});\n\ntest(\"T4 smoke: a reply cut at the output limit is never run as a tool call, and the run ends truthfully\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"truncate\", atRequest: 1 }] });\n  const r = records[0];\neval/README.md:85:A task or config may list `faults: [{ kind, atRequest }]`. The run's model proxy then injects that fault into the Nth\neval/README.md:97:What was injected is recorded in `model.faultsInjected`. Such runs are never treated as infrastructure reruns.\ncli/src/client.ts:1825:      : t === \"overloaded_error\" ? { condition: \"OVERLOADED\", execution: \"UNKNOWN\" }\ncli/src/team.ts:58:  /** Defaults: the workspace operation store, config-derived resources, agent-turn executor, real clock. */\neval/score.mjs:130:  ...(r.model?.faultsInjected ?? []).map((f) => ({ ...f, source: f.source ?? \"model_proxy\" })),\neval/score.mjs:215:  console.log(JSON.stringify({ totals, pooled, rows, faults: faultRows, t4, ...(t3 ? { t3 } : {}), replacements, ...(peerComparison ? { peerComparison } : {}) }, null, 2));\neval/standalone/plain_proxy.mjs:8:import { startModelProxy } from \"../model_proxy.mjs\";\neval/standalone/plain_proxy.mjs:16:const proxy = await startModelProxy({ upstream: args.upstream, caFile: args[\"ca-file\"], profile: args.emulate ?? \"plain\", authToken });\ncli/src/provider_cli.ts:118:  \"TEMPORARILY_UNAVAILABLE\", \"RATE_LIMITED\", \"OVERLOADED\", \"DRAINING\", \"AUTH_FAILURE\", \"QUOTA_EXHAUSTED\",\ncli/src/core/turn.ts:82:  | \"OVERLOADED\"\ncli/src/core/provider_capabilities.ts:28:/** Built-in client defaults: used only when neither the provider nor the operator gives a value. */\ncli/src/core/provider_recovery.ts:14:  \"OVERLOADED\",\ncli/src/core/provider_recovery.ts:56:  const rawMs = get(\"retry-after-ms\");\ncli/src/core/provider_recovery.ts:58:  const retryAfterMs = explicitMs ?? parseRetryAfter(get(\"retry-after\"), now);\ncli/src/core/provider_recovery.ts:107:    return { condition: draining ? \"DRAINING\" : \"OVERLOADED\", execution: \"NOT_EXECUTED\" };\ncli/src/core/provider_recovery.ts:111:  if (status === 529) return { condition: \"OVERLOADED\", execution: \"NOT_EXECUTED\" };\ncli/src/core/resources.ts:19:  | \"OVERLOADED\"\ncli/src/core/resources.ts:67:  source: \"retry-after\" | \"rate-limit-reset\" | \"backoff\" | \"provider-catalog\" | \"probe\";\ncli/src/core/resources.ts:157:    case \"OVERLOADED\":\ncli/src/core/resources.ts:158:      return { condition: \"OVERLOADED\", scope: code && POOL_CODES.has(code) && resource.pool ? \"pool\" : \"model\", temporary: true };\ncli/src/core/resources.ts:247:        record.source = (hints.rateLimitResetMs ?? -1) >= (hints.retryAfterMs ?? -1) ? \"rate-limit-reset\" : \"retry-after\";\neval/model_proxy.mjs:76:export async function startModelProxy({ upstream, caFile, faults = [], profile, authToken, clientToken, socketPath, maxRequests = 1_000, maxConcurrentRequests = 1, maxRequestBytes = 1_000_000, maxCompletionTokens, maxTotalCompletionTokens }) {\neval/model_proxy.mjs:94:  const stats = { requests: 0, chatRequests: 0, activeInferenceRequests: 0, cancelledRequests: 0, profileContextLookups: 0, requestedCompletionTokens: 0, answered: 0, upstreamFailures: 0, faultsInjected: [], firstRequestAt: null, firstAnswerAt: null };\neval/model_proxy.mjs:205:    if (fault) stats.faultsInjected.push({ kind: fault.kind, atRequest: chatIndex });\neval/model_proxy.mjs:213:      res.writeHead(503, { \"content-type\": \"application/json\", \"retry-after\": \"1\" });\neval/model_proxy.mjs:325:    stats: () => ({ ...stats, faultsInjected: [...stats.faultsInjected] }),\neval/model_proxy.mjs:344:  if (!m || (m.faultsInjected?.length ?? 0) > 0) return false;\neval/run.mjs:12:import { startModelProxy } from \"./model_proxy.mjs\";\neval/run.mjs:131:  const probe = config.proxy === false ? null : await startModelProxy({ upstream: config.endpoint, caFile });\neval/run.mjs:211:    if (faults.length && config.proxy === false) throw new Error(\"fault injection needs the model proxy (proxy: false is set)\");\neval/run.mjs:218:    const proxy = await startModelProxy({\neval/isolate.mjs:884:    defaults: directory ? [\"-m\", `d:u:${user}:rwx,d:u:${operatorUid}:rwx,d:m::rwx`, resolved] : null,\nzsh:1: no matches found: eval/mock*\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18be5-e339-7910-80af-f4c3f5102373","create_time":1793348550.4071784}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
