sfy installed-RC qualification.\n+\n1:name: Release\n2-\n3-on:\n4-  push:\n5-    tags: [\"v*.*.*\"]\n6-\n7-permissions:\n8-  contents: write\n9-  id-token: write\n10-  attestations: write\n11-\n12-jobs:\n13-  package:\n14-    runs-on: ubuntu-22.04\n15-    permissions:\n16-      contents: write\n--\n28-        with:\n29-          go-version: '1.22.12'\n30-      - name: Install pinned evaluator toolchains\n31-        run: bash scripts/install-evaluator-toolchains.sh\n32-      - run: bash scripts/ensure-ci-bubblewrap.sh\n33-      - run: bash scripts/ensure-ci-user-cgroups.sh\n34-      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n35-        run: |\n36:          root=/mnt/nexus-eval-release\n37-          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n38:          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-release \"$root\"\n39-          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n40-          runtime_root=/opt/nexus-eval-ci-runtime\n41-          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n42-          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n43-      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable\n44-      - name: Install cargo tools (audit, deny, about, cyclonedx)\n45-        run: |\n46-          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n47-          export CARGO_HOME\n48-          mkdir -p \"$CARGO_HOME/bin\"\n49-          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n50-          export PATH=\"$CARGO_HOME/bin:$PATH\"\n51-          cargo install cargo-audit --locked --version 0.22.2\n52:          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n53-          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n54:      