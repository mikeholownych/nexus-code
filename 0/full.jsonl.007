.mts\",\n        \"docs/v1.0.0/evidence/prv/probe.mts\",\n        \"docs/v1.0.0/evidence/prv/tls.mts\",\n        \"docs/v1.0.0/evidence/repro/agt_repro.test.ts\",\n        \"docs/v1.0.0/plans/PLAN-01-safe-execution-defaults.md\",\n        \"docs/v1.0.0/plans/PLAN-02-process-ownership-and-bounds.md\",\n        \"docs/v1.0.0/plans/PLAN-03-untrusted-inputs-and-egress.md\",\n        \"docs/v1.0.0/plans/PLAN-04-continuity-and-durable-work.md\",\n        \"docs/v1.0.0/plans/PLAN-05-standalone-local-inference.md\",\n        \"docs/v1.0.0/plans/PLAN-06-packaged-product-parity.md\",\n        \"docs/v1.0.0/plans/PLAN-07-supply-chain-and-release-engineering.md\",\n        \"docs/v1.0.0/plans/PLAN-08-persistence-hygiene.md\",\n        \"docs/v1.0.0/plans/PLAN-09-requirements-governance-and-docs.md\",\n        \"docs/v1.0.0/plans/PLAN-10-v1-qualification-and-evaluation.md\",\n        \"docs/v1.0.0/plans/PLAN-11-verification-and-tool-call-integrity.md\",\n        \"docs/v1.0.0/plans/PLAN-C1-contest-submission-track.md\",\n        \"docs/v1.0.0/specs/SPEC-01-safe-execution-defaults.md\",\n        \"docs/v1.0.0/specs/SPEC-02-process-ownership-and-bounds.md\",\n        \"docs/v1.0.0/specs/SPEC-03-untrusted-inputs-and-egress.md\",\n        \"docs/v1.0.0/specs/SPEC-04-continuity-and-durable-work.md\",\n        \"docs/v1.0.0/specs/SPEC-05-standalone-local-inference.md\",\n        \"docs/v1.0.0/specs/SPEC-06-packaged-product-parity.md\",\n        \"docs/v1.0.0/specs/SPEC-07-supply-chain-and-release-engineering.md\",\n        \"docs/v1.0.0/specs/SPEC-08-persistence-hygiene.md\",\n        \"docs/v1.0.0/specs/SPEC-09-requirements-governance-and-docs.md\",\n        \"docs/v1.0.0/specs/SPEC-10-v1-qualification-and-evaluation.md\",\n        \"docs/v1.0.0/specs/SPEC-11-verification-and-tool-call-integrity.md\",\n        \"docs/v1.0.0/specs/SPEC-C1-contest-submission-track.md\",\n        \"jsf/.git/HEAD\",\n        \"jsf/.git/config\",\n        \"jsf/.git/description\",\n        \"jsf/.git/hook