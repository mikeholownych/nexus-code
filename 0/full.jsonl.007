{"timestamp":"2026-10-30T05:19:23.651Z","ordinal":518181,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181ab-bb8d-7471-bcfe-7451f754e731","turn_id":"01a18b3d-3c3f-73c2-85d3-8d368e2725dd","item":{"type":"CommandExecution","id":"exec-7a37a40e-7ee8-49cf-a94b-6db94089f075","process_id":"18919","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/pr341-release-workflow-fix show --stat --oneline HEAD && git -C /home/mike/nexus-wt/pr341-release-workflow-fix diff origin/main -- .github/workflows/release.yml .github/workflows/ci.yml cli/test/release_workflow_parity.test.ts && git -C /home/mike/nexus-wt/pr341-release-workflow-fix show origin/pr/335:.github/workflows/ci.yml | sed -n '1,100p' && git -C /home/mike/nexus-wt/pr341-release-workflow-fix show origin/pr/335:scripts/ci-trim-runner-image.sh >/dev/null; echo 'script_exit='$?"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/pr341-release-workflow-fix show --stat --oneline HEAD && git -C /home/mike/nexus-wt/pr341-release-workflow-fix diff origin/main -- .github/workflows/release.yml .github/workflows/ci.yml cli/test/release_workflow_parity.test.ts && git -C /home/mike/nexus-wt/pr341-release-workflow-fix show origin/pr/335:.github/workflows/ci.yml | sed -n '1,100p' && git -C /home/mike/nexus-wt/pr341-release-workflow-fix show origin/pr/335:scripts/ci-trim-runner-image.sh >/dev/null; echo 'script_exit='$?"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"c8e69eac test(release): enforce evaluator setup parity\n cli/test/release_workflow_parity.test.ts | 42 ++++++++++++++++++++++++++------\n 1 file changed, 35 insertions(+), 7 deletions(-)\ndiff --git a/.github/workflows/release.yml b/.github/workflows/release.yml\nindex 53af5885..8f74db0f 100644\n--- a/.github/workflows/release.yml\n+++ b/.github/workflows/release.yml\n@@ -24,6 +24,13 @@ jobs:\n           fetch-depth: 0\n       - run: sudo apt-get update\n       - run: sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n+      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n+        with:\n+          go-version: '1.22.12'\n+      - name: Install pinned evaluator toolchains\n+        run: bash scripts/install-evaluator-toolchains.sh\n+      - name: Remove preinstalled SDK trees from the hosted runner\n+        run: bash scripts/ci-trim-runner-image.sh\n       - run: bash scripts/ensure-ci-bubblewrap.sh\n       - run: bash scripts/ensure-ci-user-cgroups.sh\n       - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\ndiff --git a/cli/test/release_workflow_parity.test.ts b/cli/test/release_workflow_parity.test.ts\nnew file mode 100644\nindex 00000000..e54126d1\n--- /dev/null\n+++ b/cli/test/release_workflow_parity.test.ts\n@@ -0,0 +1,61 @@\n+import { test } from \"node:test\";\n+import assert from \"node:assert/strict\";\n+import fs from \"node:fs\";\n+import path from \"node:path\";\n+import { fileURLToPath } from \"node:url\";\n+\n+// The release job runs the same CLI suite as CI, including evaluator tests that need the\n+// pinned toolchains and sandbox. rc.12's release failed with \"go: command not found\"\n+// because release.yml lacked steps that ci.yml had; keep the two environments aligned.\n+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n+const read = (name: string) => fs.readFileSync(path.join(root, \".github/workflows\", name), \"utf8\");\n+\n+const REQUIRED_EVALUATOR_SETUP = [\n+  \"go-version: '1.22.12'\",\n+  \"run: bash scripts/install-evaluator-toolchains.sh\",\n+  \"run: bash scripts/ensure-ci-bubblewrap.sh\",\n+  \"run: bash scripts/ensure-ci-user-cgroups.sh\",\n+  'echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"',\n+  'echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"',\n+  \"sudo install -o root -g root -m 0755 \\\"$node_runtime\\\" /usr/bin/node\",\n+];\n+const OPTIONAL_TRIM_STEP = \"run: bash scripts/ci-trim-runner-image.sh\";\n+\n+function jobSection(workflow: string, name: string): string {\n+  const marker = `\\n  ${name}:`;\n+  const start = workflow.indexOf(marker);\n+  assert.notEqual(start, -1, `workflow defines the ${name} job`);\n+  const bodyStart = start + marker.length;\n+  const remaining = workflow.slice(bodyStart);\n+  const nextJob = remaining.search(/\\n  [a-zA-Z0-9_-]+:/);\n+  return nextJob === -1 ? remaining : remaining.slice(0, nextJob);\n+}\n+\n+test(\"release job prepares the same evaluator environment as CI before running the CLI suite\", () => {\n+  const ci = read(\"ci.yml\");\n+  const release = read(\"release.yml\");\n+  const jobs = [\n+    [\"CI Node matrix\", jobSection(ci, \"test-matrix\")],\n+    [\"CI Linux packaging\", jobSection(ci, \"linux-x86_64\")],\n+    [\"release package\", jobSection(release, \"package\")],\n+  ] as const;\n+\n+  for (const [jobName, job] of jobs) {\n+    assert.equal(\n+      job.includes(OPTIONAL_TRIM_STEP),\n+      jobs[2][1].includes(OPTIONAL_TRIM_STEP),\n+      `${jobName} and release use the same runner SDK trim policy`,\n+    );\n+    const suite = job.indexOf(\"run: npm --prefix cli test\");\n+    assert.ok(suite >= 0, `${jobName} runs the CLI suite`);\n+    const positions = REQUIRED_EVALUATOR_SETUP.map((step) => {\n+      const position = job.indexOf(step);\n+      assert.ok(position >= 0, `${jobName} includes required evaluator setup: ${step}`);\n+      assert.ok(position < suite, `${jobName} runs evaluator setup before the CLI suite: ${step}`);\n+      return position;\n+    });\n+    for (let index = 1; index < positions.length; index += 1) {\n+      assert.ok(positions[index - 1] < positions[index], `${jobName} preserves evaluator setup order`);\n+    }\n+  }\n+});\nname: CI\n\non:\n  push:\n    branches: [main]\n  pull_request:\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\njobs:\n  test-matrix:\n    runs-on: ubuntu-22.04\n    strategy:\n      fail-fast: false\n      matrix:\n        node: [22, 24]\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.12'\n      - name: Install pinned evaluator toolchains\n        run: bash scripts/install-evaluator-toolchains.sh\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: ${{ matrix.node }}\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - run: node scripts/sync-version.mjs --check\n      - run: node scripts/check_requirements.mjs\n      - run: npm ci --prefix cli\n      - run: npm --prefix cli run build\n      - run: git diff --exit-code -- cli/dist\n      - run: cargo test --locked --manifest-path core/Cargo.toml\n      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n      - name: Install pinned security and SBOM test tools\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - run: npm --prefix cli test\n\n  linux-x86_64:\n    needs: [test-matrix]\n    runs-on: ubuntu-22.04\n    env:\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.12'\n      - name: Install pinned evaluator toolchains\n        run: bash scripts/install-evaluator-toolchains.sh\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\nfatal: path 'scripts/ci-trim-runner-image.sh' exists on disk, but not in 'origin/pr/335'\nscript_exit=128\n","exit_code":0,"duration":{"secs":0,"nanos":37297}},"started_at_ms":1793337563651,"completed_at_ms":1793337563651}}
{"timestamp":"2026-10-30T05:19:23.888Z","ordinal":518182,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a18b3f-9af0-7d31-833b-2ef21e173beb","call_id":"call_789fd2b5f5c14c2483b6bdadaa06c907","output":[{"type":"input_text","text":"Script completed\nWall time 0.6 seconds\nOutput:\n"},{"type":"input_text","text":"c8e69eac test(release): enforce evaluator setup parity\n cli/test/release_workflow_parity.test.ts | 42 ++++++++++++++++++++++++++------\n 1 file changed, 35 insertions(+), 7 deletions(-)\ndiff --git a/.github/workflows/release.yml b/.github/workflows/release.yml\nindex 53af5885..8f74db0f 100644\n--- a/.github/workflows/release.yml\n+++ b/.github/workflows/release.yml\n@@ -24,6 +24,13 @@ jobs:\n           fetch-depth: 0\n       - run: sudo apt-get update\n       - run: sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n+      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n+        with:\n+          go-version: '1.22.12'\n+      - name: Install pinned evaluator toolchains\n+        run: bash scripts/install-evaluator-toolchains.sh\n+      - name: Remove preinstalled SDK trees from the hosted runner\n+        run: bash scripts/ci-trim-runner-image.sh\n       - run: bash scripts/ensure-ci-bubblewrap.sh\n       - run: bash scripts/ensure-ci-user-cgroups.sh\n       - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\ndiff --git a/cli/test/release_workflow_parity.test.ts b/cli/test/release_workflow_parity.test.ts\nnew file mode 100644\nindex 00000000..e54126d1\n--- /dev/null\n+++ b/cli/test/release_workflow_parity.test.ts\n@@ -0,0 +1,61 @@\n+import { test } from \"node:test\";\n+import assert from \"node:assert/strict\";\n+import fs from \"node:fs\";\n+import path from \"node:path\";\n+import { fileURLToPath } from \"node:url\";\n+\n+// The release job runs the same CLI suite as CI, including evaluator tests that need the\n+// pinned toolchains and sandbox. rc.12's release failed with \"go: command not found\"\n+// because release.yml lacked steps that ci.yml had; keep the two environments aligned.\n+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n+const read = (name: string) => fs.readFileSync(path.join(root, \".github/workflows\", name), \"utf8\");\n+\n+const REQUIRED_EVALUATOR_SETUP = [\n+  \"go-version: '1.22.12'\",\n+  \"run: bash scripts/install-evaluator-toolchains.sh\",\n+  \"run: bash scripts/ensure-ci-bubblewrap.sh\",\n+  \"run: bash scripts/ensure-ci-user-cgroups.sh\",\n+  'echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"',\n+  'echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"',\n+  \"sudo install -o root -g root -m 0755 \\\"$node_runtime\\\" /usr/bin/node\",\n+];\n+const OPTIONAL_TRIM_STEP = \"run: bash scripts/ci-trim-runner-image.sh\";\n+\n+function jobSection(workflow: string, name: string): string {\n+  const marker = `\\n  ${name}:`;\n+  const start = workflow.indexOf(marker);\n+  assert.notEqual(start, -1, `workflow defines the ${name} job`);\n+  const bodyStart = start + marker.length;\n+  const remaining = workflow.slice(bodyStart);\n+  const nextJob = remaining.search(/\\n  [a-zA-Z0-9_-]+:/);\n+  return nextJob === -1 ? remaining : remaining.slice(0, nextJob);\n+}\n+\n+test(\"release job prepares the same evaluator environment as CI before running the CLI suite\", () => {\n+  const ci = read(\"ci.yml\");\n+  const release = read(\"release.yml\");\n+  const jobs = [\n+    [\"CI Node matrix\", jobSection(ci, \"test-matrix\")],\n+    [\"CI Linux packaging\", jobSection(ci, \"linux-x86_64\")],\n+    [\"release package\", jobSection(release, \"package\")],\n+  ] as const;\n+\n+  for (const [jobName, job] of jobs) {\n+    assert.equal(\n+      job.includes(OPTIONAL_TRIM_STEP),\n+      jobs[2][1].includes(OPTIONAL_TRIM_STEP),\n+      `${jobName} and release use the same runner SDK trim policy`,\n+    );\n+    const suite = job.indexOf(\"run: npm --prefix cli test\");\n+    assert.ok(suite >= 0, `${jobName} runs the CLI suite`);\n+    const positions = REQUIRED_EVALUATOR_SETUP.map((step) => {\n+      const position = job.indexOf(step);\n+      assert.ok(position >= 0, `${jobName} includes required evaluator setup: ${step}`);\n+      assert.ok(position < suite, `${jobName} runs evaluator setup before the CLI suite: ${step}`);\n+      return position;\n+    });\n+    for (let index = 1; index < positions.length; index += 1) {\n+      assert.ok(positions[index - 1] < positions[index], `${jobName} preserves evaluator setup order`);\n+    }\n+  }\n+});\nname: CI\n\non:\n  push:\n    branches: [main]\n  pull_request:\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\njobs:\n  test-matrix:\n    runs-on: ubuntu-22.04\n    strategy:\n      fail-fast: false\n      matrix:\n        node: [22, 24]\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.12'\n      - name: Install pinned evaluator toolchains\n        run: bash scripts/install-evaluator-toolchains.sh\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: ${{ matrix.node }}\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - run: node scripts/sync-version.mjs --check\n      - run: node scripts/check_requirements.mjs\n      - run: npm ci --prefix cli\n      - run: npm --prefix cli run build\n      - run: git diff --exit-code -- cli/dist\n      - run: cargo test --locked --manifest-path core/Cargo.toml\n      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n      - name: Install pinned security and SBOM test tools\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - run: npm --prefix cli test\n\n  linux-x86_64:\n    needs: [test-matrix]\n    runs-on: ubuntu-22.04\n    env:\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5\n        with:\n          go-version: '1.22.12'\n      - name: Install pinned evaluator toolchains\n        run: bash scripts/install-evaluator-toolchains.sh\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-ci\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\nfatal: path 'scripts/ci-trim-runner-image.sh' exists on disk, but not in 'origin/pr/335'\nscript_exit=128\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18b3d-3c3f-73c2-85d3-8d368e2725dd","create_time":1793337563.888182}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
