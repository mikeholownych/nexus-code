mand\"\ncore/src/bin/nexus_tui/live_view.rs:579:        None if approval.tool == \"run_command\" => Some(\"run a shell command in the workspace\".to_string()),\ncore/src/bin/nexus_tui/live_view.rs:1872:        \"run_command\" => \"Run\",\ncore/src/bin/nexus_tui/live_view.rs:1918:        feed(&mut state, &[BUSY, r#\"{\"v\":1,\"type\":\"activity\",\"turn_id\":\"t1\",\"phase\":\"tool\",\"step\":31,\"segment\":2,\"tool\":\"run_command\",\"subject\":\"make test\"}\"#]);\ncore/src/bin/nexus_tui/live_view.rs:2045:                r#\"{\"v\":1,\"type\":\"tool.start\",\"turn_id\":\"t1\",\"call_id\":\"b\",\"tool\":\"run_command\",\"subject\":\"npm test\"}\"#,\ncore/src/bin/nexus_tui/live_view.rs:2046:                r#\"{\"v\":1,\"type\":\"tool.end\",\"turn_id\":\"t1\",\"call_id\":\"b\",\"tool\":\"run_command\",\"success\":false,\"summary\":\"1 test failed\",\"lines\":12}\"#,\ncore/src/bin/nexus_tui/live_view.rs:2104:            r#\"{\"v\":1,\"type\":\"tool.start\",\"turn_id\":\"t1\",\"call_id\":\"c1\",\"tool\":\"run_command\",\"subject\":\"sleep 30\"}\"#,\ncore/src/bin/nexus_tui/live_view.rs:2111:        assert_shows(&draw(&state, 100, 12), &[\"cancelling — waiting for run_command (0s)\"]);\ncore/src/bin/nexus_tui/live_view.rs:2197:        assert_eq!(tool_verb(\"run_command\"), \"Run\");\ncore/src/bin/nexus_tui/live_view.rs:2427:                r#\"{\"v\":1,\"type\":\"tool.start\",\"turn_id\":\"t1\",\"call_id\":\"a\",\"tool\":\"run_command\",\"subject\":\"npm test -- --runInBand src/payments/parser.test.ts\"}\"#,\ncore/src/bin/nexus_tui/live_view.rs:2428:                r#\"{\"v\":1,\"type\":\"tool.end\",\"turn_id\":\"t1\",\"call_id\":\"a\",\"tool\":\"run_command\",\"success\":false,\"summary\":\"1 test failed: expected 3 to equal 4\",\"lines\":3}\"#,\ncore/src/bin/nexus_tui/live_view.rs:2559:            tool: \"run_command\".into(),\ncore/src/bin/nexus_tui/live_view.rs:3004:            tool: \"run_command\".into(),\ncore/src/bin/nexus_tui/live_view.rs:3732:                r#\"{\"v\":1,\"type\":\"tool.start\",\"turn_id\":\"t1\",\"call_id\":\"c1\",\"tool\":\"run_command\",\"subject\":\"seq 1 120\",\"evidence\":\"e1\"}\"#,\ncore/src/bin/nexus_tui/live_view.rs:3733:                &format!(r#\"{{\"v\":1,\"type\":\"tool.end\",\"turn_id\":\"t1\",\"call_id\":\"c1\",\"tool\":\"run_command\",\"success\":true,\"summary\":\"exit 0 · 120 lines\",\"lines\":120,\"evidence\":\"e1\",\"preview\":{},\"exit_code\":0,\"duration_ms\":1500}}\"#, serde_json::to_string(&preview.join(\"\\n\")).unwrap()),\ncore/src/bin/nexus_tui/live_view.rs:3734:                r#\"{\"v\":1,\"type\":\"tool.start\",\"turn_id\":\"t1\",\"call_id\":\"c2\",\"tool\":\"run_command\",\"subject\":\"true\",\"evidence\":\"e2\"}\"#,\ncore/src/bin/nexus_tui/live_view.rs:3735:                r#\"{\"v\":1,\"type\":\"tool.end\",\"turn_id\":\"t1\",\"call_id\":\"c2\",\"tool\":\"run_command\",\"success\":true,\"summary\":\"exit 0 · no output\",\"lines\":0,\"evidence\":\"e2\",\"preview\":\"\",\"exit_code\":0}\"#,\ncore/src/bin/nexus_tui/live_view.rs:3736:                r#\"{\"v\":1,\"type\":\"tool.start\",\"turn_id\":\"t1\",\"call_id\":\"c3\",\"tool\":\"run_command\",\"subject\":\"npm test\",\"evidence\":\"e3\"}\"#,\ncore/src/bin/nexus_tui/live_view.rs:3737:                r#\"{\"v\":1,\"type\":\"tool.end\",\"turn_id\":\"t1\",\"call_id\":\"c3\",\"tool\":\"run_command\",\"success\":false,\"summary\":\"Command exited with code 1\",\"lines\":2,\"evidence\":\"e3\",\"preview\":\"FAIL parser\\n\\u001b[31mexpected 3\\u001b[0m\",\"exit_code\":1}\"#,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","create_time":1792916701.437165}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
