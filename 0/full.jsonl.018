{"timestamp":"2026-10-25T08:20:16.099Z","ordinal":331696,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_060b64278a9dfb15016addbbbf4d6c81a0918d708d1e448009","status":"completed","call_id":"call_3f032bb3707a44f8b27acb4cc80bf89f","name":"exec","input":"const r = await tools.exec_command({cmd:\"sed -n '1,125p' eval/validate.mjs; sed -n '200,310p' eval/run.mjs; sed -n '570,640p' eval/run.mjs; sed -n '680,745p' cli/test/eval_integrity.test.ts; sed -n '1,130p' eval/resources.mjs; sed -n '1,120p' eval/host/resource-profile.json\",\"workdir\":\"/home/mike/nexus-wt/plan10-pr10c-t4\",\"yield_time_ms\":10000,\"max_output_tokens\":7000});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","create_time":1792916415.3053443}}}
{"timestamp":"2026-10-25T08:20:16.196Z","ordinal":331697,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","response_id":"resp_060b64278a9dfb15016addbbb7cbc481a0b48006f861981de5","usage":{"input_tokens":161373,"cached_input_tokens":157952,"cache_write_input_tokens":0,"output_tokens":1002,"reasoning_output_tokens":851,"total_tokens":162375},"turn_token_usage":{"input_tokens":616522,"cached_input_tokens":599168,"cache_write_input_tokens":0,"output_tokens":2846,"reasoning_output_tokens":1934,"total_tokens":619368},"thread_token_usage":{"input_tokens":6051477811,"cached_input_tokens":5986670208,"cache_write_input_tokens":0,"output_tokens":17194419,"reasoning_output_tokens":9908885,"total_tokens":6068672230}}}
{"timestamp":"2026-10-25T08:20:18.045Z","ordinal":331698,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","item":{"type":"CommandExecution","id":"exec-6fdbfe1b-c7c7-4b25-b8f4-e5f95a027779","process_id":"39726","command":["/usr/bin/zsh","-lc","sed -n '1,125p' eval/validate.mjs; sed -n '200,310p' eval/run.mjs; sed -n '570,640p' eval/run.mjs; sed -n '680,745p' cli/test/eval_integrity.test.ts; sed -n '1,130p' eval/resources.mjs; sed -n '1,120p' eval/host/resource-profile.json"],"cwd":"file:///home/mike/nexus-wt/plan10-pr10c-t4","parsed_cmd":[{"type":"read","cmd":"sed -n '1,125p' eval/validate.mjs","name":"validate.mjs","path":"eval/validate.mjs"},{"type":"read","cmd":"sed -n '200,310p' eval/run.mjs","name":"run.mjs","path":"eval/run.mjs"},{"type":"read","cmd":"sed -n '570,640p' eval/run.mjs","name":"run.mjs","path":"eval/run.mjs"},{"type":"read","cmd":"sed -n '680,745p' cli/test/eval_integrity.test.ts","name":"eval_integrity.test.ts","path":"cli/test/eval_integrity.test.ts"},{"type":"read","cmd":"sed -n '1,130p' eval/resources.mjs","name":"resources.mjs","path":"eval/resources.mjs"},{"type":"read","cmd":"sed -n '1,120p' eval/host/resource-profile.json","name":"resource-profile.json","path":"eval/host/resource-profile.json"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"// Checks that make an evaluation run valid before it starts (SPEC-10, REQ-QUAL-101/102/106): every task is well formed,\n// a qualification run records which model actually answered (a fingerprint, not an alias), and hidden tests are out of\n// the agent's reach when the agent runs as its own user.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { createHash } from \"node:crypto\";\nimport { assertNoSymlinks, candidateSandboxHostMountSources, confinedPath, runtimeMountProblem, sandboxAvailable } from \"./isolate.mjs\";\nimport { blackBoxOracleProblem } from \"./oracle.mjs\";\nimport { t3TaskProblems } from \"./t3.mjs\";\nimport { resourceProbeProblem } from \"./resources.mjs\";\n\nexport const TIERS = [\"T1\", \"T2\", \"T3\", \"T4\"];\nexport const CLASSES = [\"bugfix\", \"feature\", \"refactor\", \"debug\"];\nexport const DIFFICULTIES = [\"easy\", \"medium\", \"hard\"];\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n\n/** Problems with one task.json (empty when valid). `qualification` adds the fields held-out tasks must carry. */\nexport function validateTask(task, dir, { qualification = false } = {}) {\n  const problems = [];\n  const need = (cond, msg) => { if (!cond) problems.push(msg); };\n  need(typeof task.id === \"string\" && task.id === path.basename(dir), `id must equal its directory name (${path.basename(dir)})`);\n  need(TIERS.includes(task.tier), `tier must be one of ${TIERS.join(\", \")}`);\n  need(typeof task.objective === \"string\" && task.objective.trim().length > 0, \"objective is required\");\n  problems.push(...t3TaskProblems(task));\n  need(Boolean(task.fixture) !== Boolean(task.repo), \"exactly one of fixture or repo is required\");\n  if (task.fixture) {\n    try { confinedPath(dir, task.fixture); }\n    catch (error) { need(false, error.message); }\n  }\n  if (task.repo) {\n    need(typeof task.repo.url === \"string\" && task.repo.url.length > 0, \"repo.url is required\");\n    try {\n      const repoUrl = new URL(task.repo.url);\n      need(repoUrl.protocol === \"https:\" && !repoUrl.username && !repoUrl.password, \"repo.url must use HTTPS without embedded credentials\");\n    } catch { need(false, \"repo.url must be a valid HTTPS URL without embedded credentials\"); }\n    need(/^[0-9a-f]{40}$/.test(task.repo.commit ?? \"\"), \"repo.commit must be a full 40-character commit id (pinned)\");\n  }\n  const hiddenCommand = typeof task.hidden?.command === \"string\" && task.hidden.command.length > 0;\n  const hiddenOracle = task.hidden?.protocol === \"blackbox-v1\";\n  need(hiddenCommand || hiddenOracle, \"hidden.command or hidden blackbox-v1 oracle is required\");\n  if (hiddenOracle) {\n    const oracleProblem = blackBoxOracleProblem(task.hidden, dir, task.fixture ?? null);\n    need(!oracleProblem, oracleProblem ?? \"hidden black-box oracle is invalid\");\n  }\n  // Legacy validators execute candidate modules in the same runtime. File hiding and a fresh workspace cannot prevent\n  // candidate code from inspecting or mutating that runtime, so they are never valid independent qualification.\n  if (qualification) need(hiddenOracle && !hiddenCommand, \"qualification requires the isolated blackbox-v1 hidden oracle; in-process legacy validators are not accepted\");\n  if (task.hidden?.dir) {\n    try { confinedPath(dir, task.hidden.dir); }\n    catch (error) { need(false, error.message); }\n  }\n  if (task.regression?.dir) {\n    try { confinedPath(dir, task.regression.dir); }\n    catch (error) { need(false, error.message); }\n  }\n  for (const key of [\"steps\", \"minutes\"]) {\n    if (task[key] !== undefined) need(Number.isInteger(task[key]) && task[key] > 0, `${key} must be a positive integer`);\n  }\n  if (task.faults !== undefined) {\n    const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n    need(Array.isArray(task.faults) && task.faults.every((f) => kinds.includes(f?.kind) && Number.isInteger(f?.atRequest) && f.atRequest >= 1), `faults must be [{ kind: ${kinds.join(\"|\")}, atRequest: n >= 1 }]`);\n  }\n  if (task.t4RunnerFault !== undefined) {\n    need(task.tier === \"T4\" && task.t4RunnerFault === \"sigterm_resume\", \"t4RunnerFault is supported only as sigterm_resume on a T4 task\");\n  }\n  if (task.class !== undefined || qualification) need(CLASSES.includes(task.class), `class must be one of ${CLASSES.join(\", \")}`);\n  if (task.difficulty !== undefined || qualification) need(DIFFICULTIES.includes(task.difficulty), `difficulty must be one of ${DIFFICULTIES.join(\", \")}`);\n  return problems;\n}\n\n/**\n * What a run's model is, beyond its alias: from the endpoint's /models entry (id, owner, advertised context) and the\n * operator's config (`fingerprint`: weights sha256, server build; `sampling`: temperature, seed). A qualification config\n * that cannot state weights, server build and sampling is refused (REQ-QUAL-102).\n */\nexport function modelFingerprint(config, entry) {\n  const fp = config.fingerprint ?? {};\n  const sampling = config.sampling ?? null;\n  const fingerprint = {\n    alias: config.model,\n    listed: Boolean(entry),\n    ownedBy: entry?.owned_by ?? null,\n    contextLength: entry?.context_length ?? entry?.max_model_len ?? entry?.meta?.n_ctx_train ?? null,\n    weightsSha256: fp.weightsSha256 ?? null,\n    serverBuild: fp.serverBuild ?? null,\n    sampling,\n  };\n  const missing = [];\n  if (config.qualification) {\n    if (!fingerprint.listed) missing.push(`the endpoint does not list model ${config.model}`);\n    if (!/^[0-9a-f]{64}$/.test(fingerprint.weightsSha256 ?? \"\")) missing.push(\"fingerprint.weightsSha256 (sha256 of the served weights file)\");\n    if (!fingerprint.serverBuild) missing.push(\"fingerprint.serverBuild (inference server name and build)\");\n    if (!sampling || typeof sampling.temperature !== \"number\") missing.push(\"sampling.temperature (and sampling.seed where the server supports one)\");\n  }\n  return { fingerprint, missing };\n}\n\n/** Compare the requested Nexus output/context limits with the limits exposed by the serving endpoint. */\nexport function nexusLimitsProblem(config, entry) {\n  const limits = config.limits;\n  const nativeDiscovery = Boolean(config.serverProfile) && limits?.context === undefined;\n  const contextOverride = Number.isInteger(limits?.context) && limits.context > 0;\n  if (!limits || (!contextOverride && !nativeDiscovery) || !Number.isInteger(limits.output) || limits.output <= 0) {\n    return \"qualification requires a positive limits.context override (or serverProfile native discovery) and positive limits.output\";\n  }\n  const args = Array.isArray(config.args) ? config.args : [];\n  if (args.some((arg) => typeof arg === \"string\" && (arg === \"--context-limit\" || arg.startsWith(\"--context-limit=\")))) {\n    return \"qualification must declare a Nexus context override through limits.context; --context-limit in args is ambiguous\";\n  }\n  const advertisedContext = positiveInt(entry?.context_length) ?? positiveInt(entry?.max_model_len) ?? positiveInt(entry?.meta?.n_ctx_train);\n  if (nativeDiscovery && !advertisedContext) {\n    return \"native context discovery requires a positive provider-advertised context limit\";\n  }\n  if (contextOverride && advertisedContext && limits.context > advertisedContext) {\n    return `configured context limit ${limits.context} exceeds the installed Nexus provider limit ${advertisedContext}`;\n  }\n  const requestedContext = nativeDiscovery ? advertisedContext : limits.context;\n  const context = advertisedContext ? Math.min(advertisedContext, requestedContext) : requestedContext;\n  const advertisedOutput = positiveInt(entry?.max_completion_tokens);\n  const actualOutput = Math.max(1, Math.min(advertisedOutput ?? Math.min(8192, Math.floor(context / 4)), Math.floor(context / 2)));\n  if (limits.output !== actualOutput) {\n    return `Nexus output allowance ${actualOutput} differs from matched peer limit ${limits.output}`;\n  }\n  return null;\n        }));\n      } finally {\n        fs.rmSync(probe, { recursive: true, force: true });\n      }\n    }\n    const sourceBefore = treeDigest(task.dir);\n    // Every agent reaches the model through a per-run forwarder, so whether the model was reachable is observed by the\n    // harness, the same way for every agent (eval/infra.mjs). `config.proxy: false` connects agents directly.\n    // T4: a task (or the config) may schedule faults for the proxy to inject; they are recorded with the run.\n    const faults = task.faults ?? config.faults ?? [];\n    if (faults.length && config.proxy === false) throw new Error(\"fault injection needs the model proxy (proxy: false is set)\");\n    // A standalone profile (DEC-16) shows agents a plain server; the proxy then holds the real key, agents get none.\n    if (config.serverProfile && config.proxy === false) throw new Error(\"serverProfile needs the model proxy (proxy: false is set)\");\n    const proxyDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-proxy-\"));\n    fs.chmodSync(proxyDir, 0o700);\n    const socketPath = path.join(proxyDir, \"proxy.sock\");\n    const localToken = REDACTED;\n    const proxy = await startModelProxy({\n      upstream: config.endpoint,\n      caFile,\n      faults,\n      profile: config.serverProfile,\n      authToken: apiKey ?? undefined,\n      clientToken: localToken,\n      socketPath,\n      maxRequests: config.limits?.requests ?? 1_000,\n      maxCompletionTokens: config.limits?.output,\n      maxTotalCompletionTokens: config.limits?.totalOutput,\n    });\n    const started = Date.now();\n    let agent;\n    let agentEndedAt;\n    try {\n      agent = await runAgent(task, ws, home, budget, agentIdentity, proxyDir, localToken, proxy);\n      agentEndedAt = Date.now();\n      if (config.runAs) {\n        for (const dir of [ws, home]) await normalizeRunAsPermissions(config.runAs, dir, asUserSpec);\n      }\n    } finally {\n      await proxy?.close();\n      fs.rmSync(proxyDir, { recursive: true, force: true });\n    }\n    const wallMs = agentEndedAt - started;\n    if (agent.containmentProblem) throw new Error(`candidate containment failed: ${agent.containmentProblem}`);\n    const model = proxy ? proxy.stats() : null;\n    const contaminated = treeDigest(task.dir) !== sourceBefore || `${agent.stdout}${agent.stderr}`.includes(tasksDir);\n    // T3 judges the workspace as it was when the objective's work ended (snapshot taken before the probe turn).\n    const t3 = agent.t3Driver ? scoreT3Run({ task, baseline: t3Baseline, driver: agent.t3Driver, preconditions: agent.t3Preconditions, compactions: countCompactions(home) }) : null;\n    // Legacy hidden tests share a process with candidate code. In qualification (or with hardenedChecks) they never\n    // run in the agent's workspace: each check gets a fresh staging of the baseline with only the agent's source\n    // changes (eval/hardened_check.mjs). Black-box oracles already keep expectations outside the candidate.\n    const hardened = (config.qualification === true || config.hardenedChecks === true) && task.hidden?.protocol !== \"blackbox-v1\";\n    let hardening = null;\n    let hiddenWs = ws;\n    let regressionWs = ws;\n    if (hardened) {\n      hiddenWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-check-${task.id}-`));\n      regressionWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-regression-${task.id}-`));\n      checkDirs.push(hiddenWs, regressionWs);\n      await prepareWorkspace(task, hiddenWs);\n      // Fixture tasks commit at staging time, so compare content (the tree), not the commit id.\n      if (gitRev(hiddenWs, \"HEAD^{tree}\") !== baselineTree) throw new Error(\"hardened check workspace staged a different baseline\");\n      hardening = { baseline: baselineTree, ...applyAgentChanges(ws, hiddenWs) };\n      cloneWorkspace(hiddenWs, regressionWs);\n    }\n    const refused = (check) => ({ pass: false, status: null, timedOut: false, overflow: false, output: `hardened check refused: ${hardening.configChanges.join(\"; \")}`, refused: true, resources: null, containmentProblem: null, check });\n    const hidden = hardening?.configChanges.length ? refused(\"hidden\") : await runCheck(task, hiddenWs, task.hidden, true, { readOnlyHidden: hardened });\n    const regression = task.regression ? (hardening?.configChanges.length ? refused(\"regression\") : await runCheck(task, regressionWs, task.regression, false)) : null;\n    for (const [phase, check] of [[\"hidden\", hidden], [\"regression\", regression]]) {\n      if (check?.containmentProblem) throw new Error(`${phase} check containment failed: ${check.containmentProblem}`);\n    }\n    const turn = agent.json?.turn ?? null;\n    // Nexus reports a structured outcome; for the other agents a clean exit within the budget is their completion claim.\n    const claimedComplete = turn\n      ? turn.execution === \"COMPLETED\" && [\"VERIFIED\", \"REGRESSION_FREE\", \"UNVERIFIED\", \"NOT_REQUIRED\"].includes(turn.outcome)\n      : agent.code === 0 && !agent.timedOut && !agent.outputExceeded;\n    return {\n      ...base,\n      wallMs,\n      exitCode: agent.code,\n      timedOut: agent.timedOut,\n      outputExceeded: agent.outputExceeded,\n      turn: turn && { execution: turn.execution, outcome: turn.outcome, reason: turn.reason ?? null, steps: turn.steps ?? null, contextNotRetained: turn.contextNotRetained ?? 0 },\n      claimedComplete,\n      claimedVerified: turn?.outcome === \"VERIFIED\",\n      hiddenPass: hidden.pass,\n      regressionPass: regression ? regression.pass : null,\n      falseVerified: turn?.outcome === \"VERIFIED\" && !hidden.pass,\n      contaminated,\n      tokens: agent.json?.tokenStats ?? null,\n      ...(hardening ? { hardened: { baseline: hardening.baseline, applied: hardening.applied.length, discarded: hardening.discarded, configChanges: hardening.configChanges } } : {}),\n      ...(t3 ? { t3 } : {}),\n      model,\n      ...(agent.t4FaultsInjected?.length ? { t4FaultsInjected: agent.t4FaultsInjected } : {}),\n      resources: config.resources ? { agent: agent.resources, hidden: hidden.resources ?? null, regression: regression?.resources ?? null, ...(t3BaselineResources.length ? { t3Baseline: t3BaselineResources } : {}) } : null,\n      logs: saveLogs(task, run, agent, hidden, regression),\n    };\n  } catch (err) {\n    return { ...base, wallMs: 0, error: String(err?.message ?? err), hiddenPass: false, regressionPass: null, falseVerified: false, claimedComplete: false, claimedVerified: false };\n  } finally {\n    if (!args.keep) {\n      for (const dir of checkDirs) fs.rmSync(dir, { recursive: true, force: true });\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n    }\n  }\n}\n\nasync function prepareWorkspace(task, ws) {\n  if (task.fixture) {\n    const fixture = confinedPath(task.dir, task.fixture);\n  const runtimePaths = [fs.realpathSync(cmd), ...agentIdentity.argsPrefix.filter((item) => path.isAbsolute(item)), ...(config.sandboxRuntimePaths ?? [])];\n  if ((config.agent ?? \"nexus\") === \"nexus\" && agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\")) {\n    runtimePaths.push(path.join(ROOT, \"cli/dist\"));\n    const modules = path.join(ROOT, \"cli/node_modules\");\n    for (const entry of fs.readdirSync(modules, { withFileTypes: true })) {\n      if (entry.isDirectory() && entry.name !== \".bin\") runtimePaths.push(path.join(modules, entry.name));\n    }\n    const coreBinary = path.join(ROOT, \"core/target/release/harness-core\");\n    if (fs.existsSync(coreBinary)) runtimePaths.push(coreBinary);\n  }\n  const sandboxRuntimePaths = [...new Set(runtimePaths)];\n  const allowedRuntimeRoots = [...new Set([...(config.sandboxRuntimeRoots ?? []), ...((config.agent ?? \"nexus\") === \"nexus\" && agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\") ? [path.join(ROOT, \"cli\"), path.join(ROOT, \"core\")] : [])])];\n  const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n  const corpusPaths = custodyCorpusPathsForRun();\n  const protectedCorpusPaths = protectedCorpusPathsForRun();\n  const corpusOverlap = runtimeCorpusOverlapProblem(sandboxRuntimePaths, allowedRuntimeRoots, tasksDir, corpusPaths, {\n    cwd: ws,\n    home,\n    proxyDirectory,\n    nodeRuntime: cmd,\n    supervisorPath,\n    qualification: config.qualification === true,\n  });\n  if (corpusOverlap) throw new Error(corpusOverlap);\n  const sandbox = agentSandboxArgv({ cwd: ws, home, proxyDirectory, readOnlyPaths: sandboxRuntimePaths, allowedRuntimeRoots, runtimeExecutablePaths: [cmd, ...agentIdentity.argsPrefix], supervisorPath, protectedCorpusPaths });\n  const wrapped = config.runAs ? asUserSpec(config.runAs, sandbox) : sandbox;\n  return new Promise((resolve) => {\n    const { child, containment } = spawnContained(wrapped, config.resources ?? null, { cwd: \"/\", env: {}, stdio: [\"pipe\", \"pipe\", \"pipe\"], detached: true });\n    // T3: the payload is the first line and the sidecar protocol follows on the same stdin (eval/agent_sandbox.mjs).\n    const preconditions = {};\n    const runConstraint = (command) => runIsolated(command, { cwd: ws, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => ({ pass: r.status === 0 && !r.timedOut && !r.overflow }));\n    const driver = protocol ? createT3Driver(task, (line) => { if (!child.stdin.destroyed) child.stdin.write(line); }, {\n      onSteer: (item) => { preconditions[item.id] = steeringPrecondition(item, ws, task.t3CommandBaseline); },\n      beforeProbe: () => t3Snapshot(task, ws, runConstraint),\n    }) : null;\n    child.stdin.on(\"error\", () => {});\n    if (driver) {\n      child.stdin.write(`${JSON.stringify({ command: cmd, argv, env, protocol: true })}\\n`);\n      driver.done.then(() => setTimeout(() => child.stdin.end(), 2000).unref());\n    } else child.stdin.end(JSON.stringify({ command: cmd, argv, env }));\n    let stdout = \"\";\n    let stderr = \"\";\n    let timedOut = false;\n    let outputExceeded = false;\n    let outputBytes = 0;\n    const collect = (target, chunk) => {\n      outputBytes += chunk.length;\n      // A T3 protocol session over 60+ steps is verbose; its cap is larger but still bounded.\n      if (outputBytes > (driver ? 50_000_000 : 2_000_000)) {\n        outputExceeded = true;\n        killGroup(\"SIGKILL\");\n        return;\n      }\n      if (target === \"stdout\") stdout += chunk;\n      else stderr += chunk;\n    };\n    child.stdout.removeAllListeners(\"data\");\n    child.stderr.removeAllListeners(\"data\");\n    child.stdout.on(\"data\", (c) => collect(\"stdout\", c));\n    child.stderr.on(\"data\", (c) => collect(\"stderr\", c));\n    if (driver) {\n      // Registered after the collectors above (which reset the stream's listeners): every protocol line reaches the driver.\n      let pending = \"\";\n      const decoder = new StringDecoder(\"utf8\"); // a chunk can end inside a multibyte character\n      child.stdout.on(\"data\", (chunk) => {\n        pending += decoder.write(chunk);\n        let newline;\n        while ((newline = pending.indexOf(\"\\n\")) >= 0) { driver.handleLine(pending.slice(0, newline)); pending = pending.slice(newline + 1); }\n      });\n    }\n    // The whole process group: agents start helpers (servers, shells) that must not outlive the run.\n    try {\n      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \"\", /non-readable\\/non-writable by group or other/);\n    } finally {\n      fs.chmodSync(workspaceRoot, restoreMode);\n    }\n    fs.chmodSync(workspaceRoot, 0o711);\n    try {\n      assert.equal(qualificationResourceIsolationProblem({ resources: ok }), null, \"execute-only traversal for the isolated evaluator account is compatible with the private root\");\n    } finally {\n      fs.chmodSync(workspaceRoot, restoreMode);\n    }\n  }\n  const syntheticRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-mount-mode-\"));\n  try {\n    fs.chmodSync(syntheticRoot, 0o711);\n    const syntheticMount = `101 1 0:88 / ${syntheticRoot} rw,relatime - tmpfs tmpfs rw,size=131072k,mode=711,uid=${process.getuid()}`;\n    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, `${syntheticMount}\\n${syntheticMount.replace(\"101 \", \"102 \")}`) ?? \"\", /stacked or duplicate/);\n    assert.equal(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount), null, \"execute-only traversal is permitted for the isolated evaluator account\");\n    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount.replace(\"mode=711\", \"mode=755\")) ?? \"\", /non-readable\\/non-writable by group or other/);\n    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount.replace(\"mode=711\", \"mode=721\")) ?? \"\", /non-readable\\/non-writable by group or other/);\n  } finally {\n    fs.chmodSync(syntheticRoot, 0o700);\n    fs.rmdirSync(syntheticRoot);\n  }\n});\n\ntest(\"resource contract: candidate memory, processes, storage and CPU are kernel-bounded and every process is reaped\", async () => {\n  const { runIsolated, sandboxAvailable } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const { spawnContained } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n  assert.equal(sandboxAvailable(), true, \"this security test requires the real Bubblewrap executable\");\n  const memoryBytes = 256 * 1024 * 1024;\n  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\n  const tmpfs = fs.statfsSync(workspaceRoot);\n  const resources = { cpuPercent: 20, memoryBytes, tasks: 16, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\n  const ws = fs.mkdtempSync(path.join(resources.workspaceRoot, \"eval-resources-\"));\n  const run = (command: string, timeoutSec = 30) => runIsolated(command, { cwd: ws, home: true, timeoutSec, resources });\n  try {\n    // Actually allocate task-charged tmpfs pages. Streaming zeros to the captured pipe only tests output limits.\n    const memory = await run(\"dd if=/dev/zero of=/tmp/memory-fill bs=1M count=512 status=none\");\n    assert.notEqual(memory.status, 0);\n    assert.ok(memory.resources.oomKills >= 1, JSON.stringify(memory.resources));\n    assert.equal(memory.resources.limits[\"memory.oom.group\"], \"1\");\n    assert.equal(memory.resources.limits[\"memory.max\"], String(memoryBytes));\n    assert.equal(memory.resources.limits[\"memory.swap.max\"], \"0\");\n    assert.equal(memory.containmentProblem, null);\n\n    const forks = await run(\"for i in $(seq 64); do sleep 30 & done; wait\", 10);\n    assert.ok(forks.resources.pidsMaxEvents >= 1, JSON.stringify(forks.resources));\n    assert.ok(forks.resources.pidsPeak <= 16);\n    assert.equal(forks.resources.cleaned, true);\n\n    // The dedicated workspace mount caps storage before the larger memory limit; sandbox /tmp is separately charged\n    // to the task cgroup and must hit memory.max. Neither failure may leave a task process behind.\n    const workspaceDisk = await run(\"dd if=/dev/zero of=/workspace/fill bs=1M count=512 status=none\");\n    assert.notEqual(workspaceDisk.status, 0, JSON.stringify(workspaceDisk));\n    assert.equal(workspaceDisk.resources.oomKills, 0, JSON.stringify(workspaceDisk.resources));\n    assert.equal(workspaceDisk.resources.cleaned, true);\n    assert.ok((fs.existsSync(path.join(ws, \"fill\")) ? fs.statSync(path.join(ws, \"fill\")).size : 0) <= resources.storageBytes);\n\n    const sandboxDisk = await run(\"dd if=/dev/zero of=/tmp/fill bs=1M count=512 status=none\");\n    assert.notEqual(sandboxDisk.status, 0, JSON.stringify(sandboxDisk));\n    assert.ok(sandboxDisk.resources.oomKills >= 1, JSON.stringify(sandboxDisk.resources));\n    assert.equal(sandboxDisk.resources.cleaned, true);\n\n    const cpu = await run(\"timeout 2 sh -c 'while :; do :; done' & timeout 2 sh -c 'while :; do :; done' & wait\");\n    assert.equal(cpu.resources.limits[\"cpu.max\"], \"20000 100000\");\n// Kernel-enforced resource contract for task-controlled executions (eval/README.md, \"Resource contract\").\n// Each execution runs in its own delegated transient systemd --user scope under eval/cgroup_supervisor.mjs, which\n// applies cgroup v2 cpu.max, memory.max (swap 0) and pids.max to a payload leaf, verifies them, and kills the whole\n// cgroup afterwards. Workspaces and homes live on a dedicated size-capped tmpfs (storageBytes): that cap bounds\n// everything a run keeps on disk across phases, and each phase's writes are additionally charged to its memory.max.\nimport { spawn, spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst SYSTEMD_RUN = \"/usr/bin/systemd-run\";\nconst SUPERVISOR = fileURLToPath(new URL(\"./cgroup_supervisor.mjs\", import.meta.url));\nconst TMPFS_MAGIC = 0x01021994;\n\n/** Null when `resources` is a complete, sane contract; otherwise why it is not. */\nexport function resourceConfigProblem(resources) {\n  if (!resources || typeof resources !== \"object\") return \"resources must set cpuPercent, memoryBytes, tasks, storageBytes and workspaceRoot\";\n  const { cpuPercent, memoryBytes, tasks, storageBytes, workspaceRoot } = resources;\n  if (!Number.isInteger(cpuPercent) || cpuPercent < 10 || cpuPercent > 100 * 1024) return \"resources.cpuPercent must be an integer from 10 to 102400\";\n  if (!Number.isInteger(memoryBytes) || memoryBytes < 64 * 1024 * 1024 || memoryBytes % 4096 !== 0) return \"resources.memoryBytes must be a multiple of 4096 of at least 64 MiB\";\n  if (!Number.isInteger(tasks) || tasks < 8 || tasks > 1 << 20) return \"resources.tasks must be an integer from 8 to 1048576\";\n  if (!Number.isInteger(storageBytes) || storageBytes < 64 * 1024 * 1024) return \"resources.storageBytes must be an integer of at least 64 MiB\";\n  if (typeof workspaceRoot !== \"string\" || !path.isAbsolute(workspaceRoot)) return \"resources.workspaceRoot must be an absolute path\";\n  let stat;\n  try { stat = fs.statfsSync(workspaceRoot); }\n  catch { return \"resources.workspaceRoot is unavailable\"; }\n  if (stat.type !== TMPFS_MAGIC) return \"resources.workspaceRoot must be on a tmpfs so candidate writes are charged to the run's memory limit\";\n  const mountProblem = dedicatedTmpfsMountProblem(workspaceRoot);\n  if (mountProblem) return mountProblem;\n  if (stat.blocks * stat.bsize > storageBytes) return `resources.workspaceRoot tmpfs is ${stat.blocks * stat.bsize} bytes; mount a dedicated tmpfs with size<=storageBytes (${storageBytes})`;\n  return null;\n}\n\n/** A subdirectory of a shared tmpfs (including /dev/shm) does not enforce a per-run storage cap. */\nexport function dedicatedTmpfsMountProblem(workspaceRoot, mountInfoText = null) {\n  let lines;\n  try { lines = (mountInfoText ?? fs.readFileSync(\"/proc/self/mountinfo\", \"utf8\")).split(\"\\n\"); }\n  catch { return \"resources.workspaceRoot mount table is unavailable; refusing unverified workspace storage limits\"; }\n  const decode = (value) => value.replace(/\\\\([0-7]{3})/g, (_match, octal) => String.fromCharCode(Number.parseInt(octal, 8)));\n  const expected = path.resolve(workspaceRoot);\n  const matching = lines.filter((entry) => {\n    const fields = entry.split(\" \");\n    return fields.length > 6 && decode(fields[4]) === expected;\n  });\n  if (matching.length > 1) return \"resources.workspaceRoot has stacked or duplicate mount records; refusing ambiguous workspace storage boundary\";\n  const line = matching[0];\n  if (!line) return \"resources.workspaceRoot must be the exact mount point of a dedicated tmpfs, not a subdirectory\";\n  const fields = line.split(\" \");\n  const separator = fields.indexOf(\"-\");\n  if (separator < 0 || fields[separator + 1] !== \"tmpfs\" || decode(fields[3]) !== \"/\") {\n    return \"resources.workspaceRoot must be its own tmpfs mount, not a shared or bind-mounted filesystem\";\n  }\n  // A bind mount of a tmpfs root retains the same major:minor and root fields. Reject aliases of\n  // this mount so an apparently dedicated path cannot expose a tmpfs shared at another path.\n  const device = fields[2];\n  const aliases = lines.filter((entry) => {\n    const other = entry.split(\" \");\n    return other.length > 6 && other[2] === device && decode(other[4]) !== expected;\n  });\n  if (aliases.length > 0) return \"resources.workspaceRoot tmpfs is also mounted elsewhere; bind/shared mounts are not allowed\";\n  const options = `${fields[5]},${fields[separator + 3] ?? \"\"}`.split(\",\");\n  const mode = options.find((option) => option.startsWith(\"mode=\"))?.slice(5);\n  const uid = options.find((option) => option.startsWith(\"uid=\"))?.slice(4);\n  const mountMode = mode ? Number.parseInt(mode, 8) : null;\n  if (mountMode === null || (mountMode & 0o700) !== 0o700 || (mountMode & 0o066) !== 0 || uid !== String(process.getuid())) {\n    return \"dedicated tmpfs must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\";\n  }\n  let rootStat;\n  try { rootStat = fs.statSync(expected); }\n  catch { return \"resources.workspaceRoot mount root cannot be inspected; refusing unverified workspace permissions\"; }\n  const rootMode = rootStat.mode & 0o777;\n  if (rootStat.uid !== process.getuid() || (rootMode & 0o700) !== 0o700 || (rootMode & 0o066) !== 0) {\n    return \"dedicated tmpfs effective mount root must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\";\n  }\n  return null;\n}\n\n/** Null when a contained probe proves this host applies and cleans up the contract; otherwise the failure. */\nexport function resourceProbeProblem(resources) {\n  const configProblem = resourceConfigProblem(resources);\n  if (configProblem) return configProblem;\n  let wrapped;\n  try { wrapped = containedSpec({ cmd: \"/usr/bin/true\", argv: [] }, resources); }\n  catch (error) { return error.message; }\n  const result = spawnSync(wrapped.cmd, wrapped.argv, { cwd: \"/\", env: wrapped.env, stdio: [\"ignore\", \"ignore\", \"pipe\", \"pipe\"], timeout: 15_000, encoding: \"utf8\" });\n  const final = parseReports(result.output?.[3] ?? \"\").final;\n  if (!final) return `resource probe produced no containment report (${result.error?.message ?? `exit ${result.status}`}: ${(result.stderr ?? \"\").trim().slice(-300)})`;\n  if (final.error || !final.cleaned) return `resource probe failed: ${final.error ?? \"payload not cleaned\"}`;\n  if (final.exitCode !== 0) return `resource probe command exited ${final.exitCode}`;\n  return null;\n}\n\n/** The command line that runs `spec` under the supervisor in a fresh scope with `resources` applied. */\nexport function containedSpec(spec, resources) {\n  const { XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS } = process.env;\n  if (!XDG_RUNTIME_DIR) throw new Error(\"resource containment needs the systemd user manager (XDG_RUNTIME_DIR is unset)\");\n  if (!fs.existsSync(SYSTEMD_RUN)) throw new Error(\"resource containment needs systemd-run\");\n  const limits = { cpuPercent: resources.cpuPercent, memoryBytes: resources.memoryBytes, tasks: resources.tasks };\n  return {\n    cmd: SYSTEMD_RUN,\n    argv: [\"--user\", \"--scope\", \"--quiet\", \"--collect\", \"-p\", \"Delegate=yes\", \"--\", process.execPath, SUPERVISOR, JSON.stringify({ limits, cmd: spec.cmd, argv: spec.argv })],\n    env: { XDG_RUNTIME_DIR, ...(DBUS_SESSION_BUS_ADDRESS ? { DBUS_SESSION_BUS_ADDRESS } : {}) },\n    timeoutMs: spec.timeoutMs,\n  };\n}\n\n/**\n * Spawn `spec` (contained when `resources` is set). `containment.kill()` empties the payload cgroup;\n * `containment.final` resolves to the supervisor's last report, or null when it never reported.\n */\nexport function spawnContained(spec, resources, { stdio, ...options }) {\n  if (!resources) return { child: spawn(spec.cmd, spec.argv, { ...options, stdio, env: options.env ?? {} }), containment: null };\n  const wrapped = containedSpec(spec, resources);\n  const child = spawn(wrapped.cmd, wrapped.argv, { ...options, env: wrapped.env, stdio: [...stdio, \"pipe\", \"pipe\"] });\n  const control = child.stdio[4];\n  let text = \"\";\n  let cgroup = null;\n  const final = new Promise((resolve) => {\n    child.stdio[3].on(\"data\", (chunk) => {\n      text += chunk.toString(\"utf8\");\n      const reports = parseReports(text);\n      cgroup ??= reports.cgroup;\n      // Close the supervisor's control pipe after its final report. Otherwise the parent write end can\n      // keep ChildProcess's `close` event pending even though the supervised command and scope have exited.\n      if (reports.final && control && !control.destroyed) control.end();\n    });\n    child.stdio[3].on(\"close\", () => resolve(parseReports(text).final));\n    child.on(\"error\", () => resolve(null));\n  });\n  const signal = (name, graceMs = 5000) => {\n{\n  \"status\": \"frozen\",\n  \"host\": \"mike-dev\",\n  \"cpuPercent\": 800,\n  \"memoryBytes\": 17179869184,\n  \"tasks\": 4096,\n  \"storageBytes\": 21474836480,\n  \"workspaceRoot\": \"/srv/nexus-qual/ws\"\n}\n","exit_code":0,"duration":{"secs":0,"nanos":804975156}},"started_at_ms":1792916417240,"completed_at_ms":1792916418045}}
{"timestamp":"2026-10-25T08:20:19.339Z","ordinal":331699,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17225-730a-7b32-9a1d-81f717b6196d","call_id":"call_3f032bb3707a44f8b27acb4cc80bf89f","output":[{"type":"input_text","text":"Script completed\nWall time 3.2 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 8109)\nTotal output lines: 512\n\n// Checks that make an evaluation run valid before it starts (SPEC-10, REQ-QUAL-101/102/106): every task is well formed,\n// a qualification run records which model actually answered (a fingerprint, not an alias), and hidden tests are out of\n// the agent's reach when the agent runs as its own user.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { createHash } from \"node:crypto\";\nimport { assertNoSymlinks, candidateSandboxHostMountSources, confinedPath, runtimeMountProblem, sandboxAvailable } from \"./isolate.mjs\";\nimport { blackBoxOracleProblem } from \"./oracle.mjs\";\nimport { t3TaskProblems } from \"./t3.mjs\";\nimport { resourceProbeProblem } from \"./resources.mjs\";\n\nexport const TIERS = [\"T1\", \"T2\", \"T3\", \"T4\"];\nexport const CLASSES = [\"bugfix\", \"feature\", \"refactor\", \"debug\"];\nexport const DIFFICULTIES = [\"easy\", \"medium\", \"hard\"];\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n\n/** Problems with one task.json (empty when valid). `qualification` adds the fields held-out tasks must carry. */\nexport function validateTask(task, dir, { qualification = false } = {}) {\n  const problems = [];\n  const need = (cond, msg) => { if (!cond) problems.push(msg); };\n  need(typeof task.id === \"string\" && task.id === path.basename(dir), `id must equal its directory name (${path.basename(dir)})`);\n  need(TIERS.includes(task.tier), `tier must be one of ${TIERS.join(\", \")}`);\n  need(typeof task.objective === \"string\" && task.objective.trim().length > 0, \"objective is required\");\n  problems.push(...t3TaskProblems(task));\n  need(Boolean(task.fixture) !== Boolean(task.repo), \"exactly one of fixture or repo is required\");\n  if (task.fixture) {\n    try { confinedPath(dir, task.fixture); }\n    catch (error) { need(false, error.message); }\n  }\n  if (task.repo) {\n    need(typeof task.repo.url === \"string\" && task.repo.url.length > 0, \"repo.url is required\");\n    try {\n      const repoUrl = new URL(task.repo.url);\n      need(repoUrl.protocol === \"https:\" && !repoUrl.username && !repoUrl.password, \"repo.url must use HTTPS without embedded credentials\");\n    } catch { need(false, \"repo.url must be a valid HTTPS URL without embedded credentials\"); }\n    need(/^[0-9a-f]{40}$/.test(task.repo.commit ?? \"\"), \"repo.commit must be a full 40-character commit id (pinned)\");\n  }\n  const hiddenCommand = typeof task.hidden?.command === \"string\" && task.hidden.command.length > 0;\n  const hiddenOracle = task.hidden?.protocol === \"blackbox-v1\";\n  need(hiddenCommand || hiddenOracle, \"hidden.command or hidden blackbox-v1 oracle is required\");\n  if (hiddenOracle) {\n    const oracleProblem = blackBoxOracleProblem(task.hidden, dir, task.fixture ?? null);\n    need(!oracleProblem, oracleProblem ?? \"hidden black-box oracle is invalid\");\n  }\n  // Legacy validators execute candidate modules in the same runtime. File hiding and a fresh workspace cannot prevent\n  // candidate code from inspecting or mutating that runtime, so they are never valid independent qualification.\n  if (qualification) need(hiddenOracle && !hiddenCommand, \"qualification requires the isolated blackbox-v1 hidden oracle; in-process legacy validators are not accepted\");\n  if (task.hidden?.dir) {\n    try { confinedPath(dir, task.hidden.dir); }\n    catch (error) { need(false, error.message); }\n  }\n  if (task.regression?.dir) {\n    try { confinedPath(dir, task.regression.dir); }\n    catch (error) { need(false, error.message); }\n  }\n  for (const key of [\"steps\", \"minutes\"]) {\n    if (task[key] !== undefined) need(Number.isInteger(task[key]) && task[key] > 0, `${key} must be a positive integer`);\n  }\n  if (task.faults !== undefined) {\n    const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n    need(Array.isArray(task.faults) && task.faults.every((f) => kinds.includes(f?.kind) && Number.isInteger(f?.atRequest) && f.atRequest >= 1), `faults must be [{ kind: ${kinds.join(\"|\")}, atRequest: n >= 1 }]`);\n  }\n  if (task.t4RunnerFault !== undefined) {\n    need(task.tier === \"T4\" && task.t4RunnerFault === \"sigterm_resume\", \"t4RunnerFault is supported only as sigterm_resume on a T4 task\");\n  }\n  if (task.class !== undefined || qualification) need(CLASSES.includes(task.class), `class must be one of ${CLASSES.join(\", \")}`);\n  if (task.difficulty !== undefined || qualification) need(DIFFICULTIES.includes(task.difficulty), `difficulty must be one of ${DIFFICULTIES.join(\", \")}`);\n  return problems;\n}\n\n/**\n * What a run's model is, beyond its alias: from the endpoint's /models entry (id, owner, advertised context) and the\n * operator's config (`fingerprint`: weights sha256, server build; `sampling`: temperature, seed). A qualification config\n * that cannot state weights, server build and sampling is refused (REQ-QUAL-102).\n */\nexport function modelFingerprint(config, entry) {\n  const fp = config.fingerprint ?? {};\n  const sampling = config.sampling ?? null;\n  const fingerprint = {\n    alias: config.model,\n    listed: Boolean(entry),\n    ownedBy: entry?.owned_by ?? null,\n    contextLength: entry?.context_length ?? entry?.max_model_len ?? entry?.meta?.n_ctx_train ?? null,\n    weightsSha256: fp.weightsSha256 ?? null,\n    serverBuild: fp.serverBuild ?? null,\n    sampling,\n  };\n  const missing = [];\n  if (config.qualification) {\n    if (!fingerprint.listed) missing.push(`the endpoint does not list model ${config.model}`);\n    if (!/^[0-9a-f]{64}$/.test(fingerprint.weightsSha256 ?? \"\")) missing.push(\"fingerprint.weightsSha256 (sha256 of the served weights file)\");\n    if (!fingerprint.serverBuild) missing.push(\"fingerprint.serverBuild (inference server name and build)\");\n    if (!sampling || typeof sampling.temperature !== \"number\") missing.push(\"sampling.temperature (and sampling.seed where the server supports one)\");\n  }\n  return { fingerprint, missing };\n}\n\n/** Compare the requested Nexus output/context limits with the limits exposed by the serving endpoint. */\nexport function nexusLimitsProblem(config, entry) {\n  const limits = config.limits;\n  const nativeDiscovery = Boolean(config.serverProfile) && limits?.context === undefined;\n  const contextOverride = Number.isInteger(limits?.context) && limits.context > 0;\n  if (!limits || (!contextOverride && !nativeDiscovery) || !Number.isInteger(limits.output) || limits.output <= 0) {\n    return \"qualification requires a positive limits.context override (or serverProfile native discovery) and positive limits.output\";\n  }\n  const args = Array.isArray(config.args) ? config.args : [];\n  if (args.some((arg) => typeof arg === \"string\" && (arg === \"--context-limit\" || arg.startsWith(\"--context-limit=\")))) {\n    return \"qualification must declare a Nexus context override through limits.context; --context-limit in args is ambiguous\";\n  }\n  const advertisedContext = positiveInt(entry?.context_length) ?? positiveInt(entry?.max_model_len) ?? positiveInt(entry?.meta?.n_ctx_train);\n  if (nativeDiscovery && !advertisedContext) {\n    return \"native context discovery requires a positive provider-advertised context limit\";\n  }\n  if (contextOverride && advertisedContext && limits.context > advertisedContext) {\n    return `configured context limit ${limits.context} exceeds the installed Nexus provider limit ${advertisedContext}`;\n  }\n  const requestedContext = nativeDiscovery ? advertisedContext : limits.context;\n  const context = advertisedContext ? Math.min(advertisedContext, requestedContext) : requestedContext;\n  const advertisedOutput = positiveInt(entry?.max_completion_tokens);\n  const actualOutput = Math.max(1, Math.min(advertisedOutput ?? Math.min(8192, Math.floor(context / 4)), Math.floor(context / 2)));\n  if (limits.output !== actualOutput) {\n    return `Nexus output allowance ${actualOutput} differs from matched peer limit ${limits.output}`;\n  }\n  return null;\n        }));\n      } finally {\n        fs.rmSync(probe, { recursive: true, force: true });\n      }\n    }\n    const sourceBefore = treeDigest(task.dir);\n    // Every agent reaches the model through a per-run forwarder, so whether the model was reachable is observed by the\n    // harness, the same way for every agent (eval/infra.mjs). `config.proxy: false` connects agents directly.\n    // T4: a task (or the config) may schedule faults for the proxy to inject; they are recorded with the run.\n    const faults = task.faults ?? config.faults ?? [];\n    if (faults.length && config.proxy === false) throw new Error(\"fault injection needs the model proxy (proxy: false is set)\");\n    // A standalone profile (DEC-16) shows agents a plain server; the proxy then holds the real key, agents get none.\n    if (config.serverProfile && config.proxy === false) throw new Error(\"serverProfile needs the model proxy (proxy: false is set)\");\n    const proxyDir = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-proxy-\"));\n    fs.chmodSync(proxyDir, 0o700);\n    const socketPath = path.join(proxyDir, \"proxy.sock\");\n    const localToken = REDACTED;\n    const proxy = await startModelProxy({\n      upstream: config.endpoint,\n      caFile,\n      faults,\n      profile: config.serverProfile,\n      authToken: apiKey ?? undefined,\n      clientToken: localToken,\n      socketPath,\n      maxRequests: config.limits?.requests ?? 1_000,\n      maxCompletionTokens: config.limits?.output,\n      maxTotalCompletionTokens: config.limits?.totalOutput,\n    });\n    const started = Date.now();\n    let agent;\n    let agentEndedAt;\n    try {\n      agent = await runAgent(task, ws, home, budget, agentIdentity, proxyDir, localToken, proxy);\n      agentEndedAt = Date.now();\n      if (config.runAs) {\n        for (const dir of [ws, home]) await normalizeRunAsPermissions(config.runAs, dir, asUserSpec);\n      }\n    } finally {\n      await proxy?.close();\n      fs.rmSync(proxyDir, { recursive: true, force: true });\n    }\n    const wallMs = agentEndedAt - started;\n    if (agent.containmentProblem) throw new Error(`candidate containment failed: ${agent.containmentProblem}`);\n    const model = proxy ? proxy.stats() : null;\n    const contaminated = treeDigest(task.dir) !== sourceBefore || `${agent.stdout}${agent.stderr}`.includes(tasksDir);\n    // T3 judges the workspace as it was when the objective's work ended (snapshot taken before the probe turn).\n    const t3 = agent.t3Driver ? scoreT3Run({ task, baseline: t3Baseline, driver: agent.t3Driver, preconditions: agent.t3Preconditions, compactions: countCompactions(home) }) : null;\n    // Legacy hidden tests share a process with candidate code. In qualification (or with hardenedChecks) they never\n    // run in the agent's workspace: each check gets a fresh staging of the baseline with only the agent's source\n    // changes (eval/hardened_check.mjs). Black-box oracles already keep expectations outside the candidate.\n    const hardened = (config.qualification === true || config.hardenedChecks === true) && task.hidden?.protocol !== \"blackbox-v1\";\n    let hardening = null;\n    let hiddenWs = ws;\n    let regressionWs = ws;\n    if (hardened) {\n      hiddenWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-check-${task.id}-`));\n      regressionWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-regression-${task.id}-`));\n      checkDirs.push(hiddenWs, regressionWs);\n      await prepareWorkspace(task, hiddenWs);\n      // Fixture tasks commit at staging time, so compare content (the tree), not the commit id.\n      if (gitRev(hiddenWs, \"HEAD^{tree}\") !== baselineTree) throw new Error(\"hardened check workspace staged a different baseline\");\n      hardening = { baseline: baselineTree, ...applyAgentChanges(ws, hiddenWs) };\n      cloneWorkspace(hiddenWs, regressionWs);\n    }\n    const refused = (check) => ({ pass: false, status: null, timedOut: false, overflow: false, output: `hardened check refused: ${hardening.configChanges.join(\"; \")}`, refused: true, resources: null, containmentProblem: null, check });\n    const hidden = hardening?.configChanges.length ? refused(\"hidden\") : await runCheck(task, hiddenWs, task.hidden, true, { readOnlyHidden: hardened });\n    const regression = task.regression ? (hardening?.configChanges.length ? refused(\"regression\") : await runCheck(task, regressionWs, task.regression, false)) : null;\n    for (const [phase, check] of [[\"hidden\", hidden], [\"regression\", regression]]) {\n      if (check?.containmentProblem) throw new Error(`${phase} check containment failed: ${check.containmentProblem}`);\n    }\n    const turn = agent.json?.turn ?? null;\n    // Nexus reports a structured outcome; for the other agents a clean exit within the budget is their completion claim.\n    const claimedComplete = turn\n      ? turn.execution === \"COMPLETED\" && [\"VERIFIED\", \"REGRESSION_FREE\", \"UNVERIFIED\", \"NOT_REQUIRED\"].includes(turn.outcome)\n      : agent.code === 0 && !agent.timedOut && !agent.outputExceeded;\n    return {\n      ...base,\n      wallMs,\n      exitCode: agent.code,\n      timedOut: agent.timedOut,\n      outputExceeded: agent.outputExceeded,\n      turn: turn && { execution: turn.execution, outcome: turn.outcome, reason: turn.reason ?? null, steps: turn.steps ?? null, contextNotRetained: turn.contextNotRetained ?? 0 },\n      claimedComplete,\n      claimedVerified: turn?.outcome === \"VERIFIED\",\n      hiddenPass: hidden.pass,\n      regressionPass: regression ? regression.pass : null,\n      falseVerified: turn?.outcome === \"VERIFIED\" && !hidden.pass,\n      contaminated,\n      tokens: agent.json?.tokenStats ?? null,\n      ...(hardening ? { hardened: { baseline: hardening.baseline, applied: hardening.applied.length, discarded: hardening.discarded, configChanges: hardening.configChanges } } : {}),\n      ...(t3 ? { t3 } : {}),\n      model,\n      ...(agent.t4FaultsInjected?.length ? { t4FaultsInjected: agent.t4FaultsInjected } : {}),\n      resources: config.resources ? { agent: agent.resources, hidden: hidden.resources ?? null, regression: regression?.resources ?? null, ...(t3BaselineResources.length ? { t3Base…1109 tokens truncated…=> collect(\"stderr\", c));\n    if (driver) {\n      // Registered after the collectors above (which reset the stream's listeners): every protocol line reaches the driver.\n      let pending = \"\";\n      const decoder = new StringDecoder(\"utf8\"); // a chunk can end inside a multibyte character\n      child.stdout.on(\"data\", (chunk) => {\n        pending += decoder.write(chunk);\n        let newline;\n        while ((newline = pending.indexOf(\"\\n\")) >= 0) { driver.handleLine(pending.slice(0, newline)); pending = pending.slice(newline + 1); }\n      });\n    }\n    // The whole process group: agents start helpers (servers, shells) that must not outlive the run.\n    try {\n      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \"\", /non-readable\\/non-writable by group or other/);\n    } finally {\n      fs.chmodSync(workspaceRoot, restoreMode);\n    }\n    fs.chmodSync(workspaceRoot, 0o711);\n    try {\n      assert.equal(qualificationResourceIsolationProblem({ resources: ok }), null, \"execute-only traversal for the isolated evaluator account is compatible with the private root\");\n    } finally {\n      fs.chmodSync(workspaceRoot, restoreMode);\n    }\n  }\n  const syntheticRoot = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-mount-mode-\"));\n  try {\n    fs.chmodSync(syntheticRoot, 0o711);\n    const syntheticMount = `101 1 0:88 / ${syntheticRoot} rw,relatime - tmpfs tmpfs rw,size=131072k,mode=711,uid=${process.getuid()}`;\n    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, `${syntheticMount}\\n${syntheticMount.replace(\"101 \", \"102 \")}`) ?? \"\", /stacked or duplicate/);\n    assert.equal(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount), null, \"execute-only traversal is permitted for the isolated evaluator account\");\n    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount.replace(\"mode=711\", \"mode=755\")) ?? \"\", /non-readable\\/non-writable by group or other/);\n    assert.match(dedicatedTmpfsMountProblem(syntheticRoot, syntheticMount.replace(\"mode=711\", \"mode=721\")) ?? \"\", /non-readable\\/non-writable by group or other/);\n  } finally {\n    fs.chmodSync(syntheticRoot, 0o700);\n    fs.rmdirSync(syntheticRoot);\n  }\n});\n\ntest(\"resource contract: candidate memory, processes, storage and CPU are kernel-bounded and every process is reaped\", async () => {\n  const { runIsolated, sandboxAvailable } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const { spawnContained } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n  assert.equal(sandboxAvailable(), true, \"this security test requires the real Bubblewrap executable\");\n  const memoryBytes = 256 * 1024 * 1024;\n  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\n  const tmpfs = fs.statfsSync(workspaceRoot);\n  const resources = { cpuPercent: 20, memoryBytes, tasks: 16, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\n  const ws = fs.mkdtempSync(path.join(resources.workspaceRoot, \"eval-resources-\"));\n  const run = (command: string, timeoutSec = 30) => runIsolated(command, { cwd: ws, home: true, timeoutSec, resources });\n  try {\n    // Actually allocate task-charged tmpfs pages. Streaming zeros to the captured pipe only tests output limits.\n    const memory = await run(\"dd if=/dev/zero of=/tmp/memory-fill bs=1M count=512 status=none\");\n    assert.notEqual(memory.status, 0);\n    assert.ok(memory.resources.oomKills >= 1, JSON.stringify(memory.resources));\n    assert.equal(memory.resources.limits[\"memory.oom.group\"], \"1\");\n    assert.equal(memory.resources.limits[\"memory.max\"], String(memoryBytes));\n    assert.equal(memory.resources.limits[\"memory.swap.max\"], \"0\");\n    assert.equal(memory.containmentProblem, null);\n\n    const forks = await run(\"for i in $(seq 64); do sleep 30 & done; wait\", 10);\n    assert.ok(forks.resources.pidsMaxEvents >= 1, JSON.stringify(forks.resources));\n    assert.ok(forks.resources.pidsPeak <= 16);\n    assert.equal(forks.resources.cleaned, true);\n\n    // The dedicated workspace mount caps storage before the larger memory limit; sandbox /tmp is separately charged\n    // to the task cgroup and must hit memory.max. Neither failure may leave a task process behind.\n    const workspaceDisk = await run(\"dd if=/dev/zero of=/workspace/fill bs=1M count=512 status=none\");\n    assert.notEqual(workspaceDisk.status, 0, JSON.stringify(workspaceDisk));\n    assert.equal(workspaceDisk.resources.oomKills, 0, JSON.stringify(workspaceDisk.resources));\n    assert.equal(workspaceDisk.resources.cleaned, true);\n    assert.ok((fs.existsSync(path.join(ws, \"fill\")) ? fs.statSync(path.join(ws, \"fill\")).size : 0) <= resources.storageBytes);\n\n    const sandboxDisk = await run(\"dd if=/dev/zero of=/tmp/fill bs=1M count=512 status=none\");\n    assert.notEqual(sandboxDisk.status, 0, JSON.stringify(sandboxDisk));\n    assert.ok(sandboxDisk.resources.oomKills >= 1, JSON.stringify(sandboxDisk.resources));\n    assert.equal(sandboxDisk.resources.cleaned, true);\n\n    const cpu = await run(\"timeout 2 sh -c 'while :; do :; done' & timeout 2 sh -c 'while :; do :; done' & wait\");\n    assert.equal(cpu.resources.limits[\"cpu.max\"], \"20000 100000\");\n// Kernel-enforced resource contract for task-controlled executions (eval/README.md, \"Resource contract\").\n// Each execution runs in its own delegated transient systemd --user scope under eval/cgroup_supervisor.mjs, which\n// applies cgroup v2 cpu.max, memory.max (swap 0) and pids.max to a payload leaf, verifies them, and kills the whole\n// cgroup afterwards. Workspaces and homes live on a dedicated size-capped tmpfs (storageBytes): that cap bounds\n// everything a run keeps on disk across phases, and each phase's writes are additionally charged to its memory.max.\nimport { spawn, spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst SYSTEMD_RUN = \"/usr/bin/systemd-run\";\nconst SUPERVISOR = fileURLToPath(new URL(\"./cgroup_supervisor.mjs\", import.meta.url));\nconst TMPFS_MAGIC = 0x01021994;\n\n/** Null when `resources` is a complete, sane contract; otherwise why it is not. */\nexport function resourceConfigProblem(resources) {\n  if (!resources || typeof resources !== \"object\") return \"resources must set cpuPercent, memoryBytes, tasks, storageBytes and workspaceRoot\";\n  const { cpuPercent, memoryBytes, tasks, storageBytes, workspaceRoot } = resources;\n  if (!Number.isInteger(cpuPercent) || cpuPercent < 10 || cpuPercent > 100 * 1024) return \"resources.cpuPercent must be an integer from 10 to 102400\";\n  if (!Number.isInteger(memoryBytes) || memoryBytes < 64 * 1024 * 1024 || memoryBytes % 4096 !== 0) return \"resources.memoryBytes must be a multiple of 4096 of at least 64 MiB\";\n  if (!Number.isInteger(tasks) || tasks < 8 || tasks > 1 << 20) return \"resources.tasks must be an integer from 8 to 1048576\";\n  if (!Number.isInteger(storageBytes) || storageBytes < 64 * 1024 * 1024) return \"resources.storageBytes must be an integer of at least 64 MiB\";\n  if (typeof workspaceRoot !== \"string\" || !path.isAbsolute(workspaceRoot)) return \"resources.workspaceRoot must be an absolute path\";\n  let stat;\n  try { stat = fs.statfsSync(workspaceRoot); }\n  catch { return \"resources.workspaceRoot is unavailable\"; }\n  if (stat.type !== TMPFS_MAGIC) return \"resources.workspaceRoot must be on a tmpfs so candidate writes are charged to the run's memory limit\";\n  const mountProblem = dedicatedTmpfsMountProblem(workspaceRoot);\n  if (mountProblem) return mountProblem;\n  if (stat.blocks * stat.bsize > storageBytes) return `resources.workspaceRoot tmpfs is ${stat.blocks * stat.bsize} bytes; mount a dedicated tmpfs with size<=storageBytes (${storageBytes})`;\n  return null;\n}\n\n/** A subdirectory of a shared tmpfs (including /dev/shm) does not enforce a per-run storage cap. */\nexport function dedicatedTmpfsMountProblem(workspaceRoot, mountInfoText = null) {\n  let lines;\n  try { lines = (mountInfoText ?? fs.readFileSync(\"/proc/self/mountinfo\", \"utf8\")).split(\"\\n\"); }\n  catch { return \"resources.workspaceRoot mount table is unavailable; refusing unverified workspace storage limits\"; }\n  const decode = (value) => value.replace(/\\\\([0-7]{3})/g, (_match, octal) => String.fromCharCode(Number.parseInt(octal, 8)));\n  const expected = path.resolve(workspaceRoot);\n  const matching = lines.filter((entry) => {\n    const fields = entry.split(\" \");\n    return fields.length > 6 && decode(fields[4]) === expected;\n  });\n  if (matching.length > 1) return \"resources.workspaceRoot has stacked or duplicate mount records; refusing ambiguous workspace storage boundary\";\n  const line = matching[0];\n  if (!line) return \"resources.workspaceRoot must be the exact mount point of a dedicated tmpfs, not a subdirectory\";\n  const fields = line.split(\" \");\n  const separator = fields.indexOf(\"-\");\n  if (separator < 0 || fields[separator + 1] !== \"tmpfs\" || decode(fields[3]) !== \"/\") {\n    return \"resources.workspaceRoot must be its own tmpfs mount, not a shared or bind-mounted filesystem\";\n  }\n  // A bind mount of a tmpfs root retains the same major:minor and root fields. Reject aliases of\n  // this mount so an apparently dedicated path cannot expose a tmpfs shared at another path.\n  const device = fields[2];\n  const aliases = lines.filter((entry) => {\n    const other = entry.split(\" \");\n    return other.length > 6 && other[2] === device && decode(other[4]) !== expected;\n  });\n  if (aliases.length > 0) return \"resources.workspaceRoot tmpfs is also mounted elsewhere; bind/shared mounts are not allowed\";\n  const options = `${fields[5]},${fields[separator + 3] ?? \"\"}`.split(\",\");\n  const mode = options.find((option) => option.startsWith(\"mode=\"))?.slice(5);\n  const uid = options.find((option) => option.startsWith(\"uid=\"))?.slice(4);\n  const mountMode = mode ? Number.parseInt(mode, 8) : null;\n  if (mountMode === null || (mountMode & 0o700) !== 0o700 || (mountMode & 0o066) !== 0 || uid !== String(process.getuid())) {\n    return \"dedicated tmpfs must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\";\n  }\n  let rootStat;\n  try { rootStat = fs.statSync(expected); }\n  catch { return \"resources.workspaceRoot mount root cannot be inspected; refusing unverified workspace permissions\"; }\n  const rootMode = rootStat.mode & 0o777;\n  if (rootStat.uid !== process.getuid() || (rootMode & 0o700) !== 0o700 || (rootMode & 0o066) !== 0) {\n    return \"dedicated tmpfs effective mount root must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\";\n  }\n  return null;\n}\n\n/** Null when a contained probe proves this host applies and cleans up the contract; otherwise the failure. */\nexport function resourceProbeProblem(resources) {\n  const configProblem = resourceConfigProblem(resources);\n  if (configProblem) return configProblem;\n  let wrapped;\n  try { wrapped = containedSpec({ cmd: \"/usr/bin/true\", argv: [] }, resources); }\n  catch (error) { return error.message; }\n  const result = spawnSync(wrapped.cmd, wrapped.argv, { cwd: \"/\", env: wrapped.env, stdio: [\"ignore\", \"ignore\", \"pipe\", \"pipe\"], timeout: 15_000, encoding: \"utf8\" });\n  const final = parseReports(result.output?.[3] ?? \"\").final;\n  if (!final) return `resource probe produced no containment report (${result.error?.message ?? `exit ${result.status}`}: ${(result.stderr ?? \"\").trim().slice(-300)})`;\n  if (final.error || !final.cleaned) return `resource probe failed: ${final.error ?? \"payload not cleaned\"}`;\n  if (final.exitCode !== 0) return `resource probe command exited ${final.exitCode}`;\n  return null;\n}\n\n/** The command line that runs `spec` under the supervisor in a fresh scope with `resources` applied. */\nexport function containedSpec(spec, resources) {\n  const { XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS } = process.env;\n  if (!XDG_RUNTIME_DIR) throw new Error(\"resource containment needs the systemd user manager (XDG_RUNTIME_DIR is unset)\");\n  if (!fs.existsSync(SYSTEMD_RUN)) throw new Error(\"resource containment needs systemd-run\");\n  const limits = { cpuPercent: resources.cpuPercent, memoryBytes: resources.memoryBytes, tasks: resources.tasks };\n  return {\n    cmd: SYSTEMD_RUN,\n    argv: [\"--user\", \"--scope\", \"--quiet\", \"--collect\", \"-p\", \"Delegate=yes\", \"--\", process.execPath, SUPERVISOR, JSON.stringify({ limits, cmd: spec.cmd, argv: spec.argv })],\n    env: { XDG_RUNTIME_DIR, ...(DBUS_SESSION_BUS_ADDRESS ? { DBUS_SESSION_BUS_ADDRESS } : {}) },\n    timeoutMs: spec.timeoutMs,\n  };\n}\n\n/**\n * Spawn `spec` (contained when `resources` is set). `containment.kill()` empties the payload cgroup;\n * `containment.final` resolves to the supervisor's last report, or null when it never reported.\n */\nexport function spawnContained(spec, resources, { stdio, ...options }) {\n  if (!resources) return { child: spawn(spec.cmd, spec.argv, { ...options, stdio, env: options.env ?? {} }), containment: null };\n  const wrapped = containedSpec(spec, resources);\n  const child = spawn(wrapped.cmd, wrapped.argv, { ...options, env: wrapped.env, stdio: [...stdio, \"pipe\", \"pipe\"] });\n  const control = child.stdio[4];\n  let text = \"\";\n  let cgroup = null;\n  const final = new Promise((resolve) => {\n    child.stdio[3].on(\"data\", (chunk) => {\n      text += chunk.toString(\"utf8\");\n      const reports = parseReports(text);\n      cgroup ??= reports.cgroup;\n      // Close the supervisor's control pipe after its final report. Otherwise the parent write end can\n      // keep ChildProcess's `close` event pending even though the supervised command and scope have exited.\n      if (reports.final && control && !control.destroyed) control.end();\n    });\n    child.stdio[3].on(\"close\", () => resolve(parseReports(text).final));\n    child.on(\"error\", () => resolve(null));\n  });\n  const signal = (name, graceMs = 5000) => {\n{\n  \"status\": \"frozen\",\n  \"host\": \"mike-dev\",\n  \"cpuPercent\": 800,\n  \"memoryBytes\": 17179869184,\n  \"tasks\": 4096,\n  \"storageBytes\": 21474836480,\n  \"workspaceRoot\": \"/srv/nexus-qual/ws\"\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","create_time":1792916419.3388371}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
