sync () => {\n397:  test(\"a continuation cannot trust a carried baseline after recovery and keeps dependents blocked\", async () => {\n417:  test(\"nexus run --resume <task> and /recover: a restarted process inherits the unverified change; a read-only turn is not NOT_REQUIRED\", async () => {\n448:  test(\"ACC-CONT-01: run --resume <id> continues the recovered conversation, objective and task id\", async () => {\n477:  test(\"ACC-CONT-02: run --resume (no id) resumes latest task, or fails with code 2 and guidance\", async () => {\n526:  test(\"ACC-CONT-03: work unit compaction writes archive lines and read_archive returns originals after resume\", async () => {\n588:  test(\"ACC-CONT-04: resume a unit after two identical loops; a third repetition triggers recovery note\", async () => {\n653:  test(\"REQ-AGT-103: recovered verifier baseline persists as continuity evidence but is never trusted\", async () => {\n730:  test(\"ACC-VER-06: forged candidate identity cannot clear the verifier obligation after resume\", async () => {\n795:  test(\"ACC-VER-07: a new run cannot clear recovered verifier invalidation and rebaseline edited tests\", async () => {\n850:  test(\"ACC-CONT-05: subagent token accounting and no durable task files (REQ-AGT-104, REQ-AGT-105)\", async () => {\n892:  test(\"AGT-06: subagent obligation write increments turnMutations once and persists immediately\", async () => {\n931:  test(\"ACC-CONT-06: throwing admitContext after a write yields UNHANDLED_ERROR with pending=true and cancelled steering notice\", async () => {\n985:  test(\"AGT-14 / REQ-AGT-106: durable-write failures (operation start/end and checkpoints) are reported through reportPersistenceFailure\", async () => {\n1020:  test(\"interactive /resume (sidecar): a resumed session keeps its outstanding verification obligation\", async () => {\n1051:  test(\"interactive /resume after the process ended mid-turn: the change made before the end is still unverified\", async () => {\n1069:        while (!gw.held && Date.now() < deadline) await new Promise((r) => setTimeout(r, 20));\n1088:        await Promise.race([abandoned.catch(() => {}), new Promise((r) => setTimeout(r, 5_000))]);\n1098:  test(\"interactive /resume after the host ended inside a writing command: the change is still unverified\", async () => {\n1102:          ? { tools: [{ name: \"run_command\", args: { command: \"printf x > out.txt; sleep 6\" } }] }\n1128:        await Promise.race([abandoned.catch(() => {}), new Promise((r) => setTimeout(r, 10_000))]);\n1141:  test(\"an operation interrupted after an earlier clean turn: after 'continue after inspection' the unit stays UNVERIFIED and its dependent never runs\", async () => {\n1160:        edit(file, ({ unverifiedChangesPending: _p, ...s }) => ({\n1201:  test(\"interactive /resume (sidecar): saved session obligation flags cannot authenticate a clean workspace\", async () => {\n1227:        for (const f of sessions()) edit(f, (s) => ({ ...s, unverifiedChangesPending: false }));\n1236:  test(\"ACC-VER-08: restored session flags cannot authenticate a verifier baseline\", async () => {\n1269:  test(\"ACC-VER-09: generic verifier output cannot discharge an unauthenticated restored obligation\", async () => {\n1326:    { name: \"missing conversation (empty history)\", corrupt: (f) => edit(f, (s) => ({ ...s, messages: [] })), problem: /no conversation was recorded/, restartedOutcome: \"BLOCKED\" },\n1327:    { name: \"inconsistent conversation (a replacement objective)\", corrupt: (f) => edit(f, (s) => ({ ...s, messages: [s.messages[0], { role: \"user\", content: \"Merge the segment files into one.\" }] })), problem: /does not contain the unit's authorized task/, restartedOutcome: \"BLOCKED\" },\n1328:    { name: \"partial history after a write (the obligation record survives)\", corrupt: (f) => edit(f, (s) => ({ ...s, messages: [] })), problem: /no conversation was recorded/, restartedOutcome: \"BLOCKED\", firstTurnWrites: true },\n1332:      corrupt: (f) => edit(f, ({ unverifiedChangesPending: _p, lastTurn: _t, ...s }) => ({ ...s, messages: [] })),\n1338:      corrupt: (f) => edit(f, ({ unverifiedChangesPending: _p, lastTurn: _t, ...s }) => ({ ...s, messages: [s.messages[0]] })),\n1345:    test(`${c.name}: resume blocks without inference, and only an explicit restart runs the authorized task again`, async () => {\n1381:  test(\"a compacted recovered conversation continues its task but cannot claim verified completion\", async () => {\n1388:        edit(rig.taskFile(op, \"markers\"), (s) => ({\n1412:  test(\"a conversation where nothing happened yet (only the system prompt) starts the unit, without a restart decision\", async () => {\n1419:        edit(rig.taskFile(op, \"markers\"), (s) => ({ ...s, messages: [s.messages[0]] }));\n1435:  test(\"an operator revision continues the recorded conversation but keeps recovered changes unverified\", async () => {\n1460:  test(\"a resumed unit is told its authorized task again and remains unverified after continuation\", async () => {\n1486:function edit(file: string, fn: (state: any) => any): void {\n1533:  const killer = setTimeout(() => p.kill(), 90_000);\n1545:    await new Promise((r) => setTimeout(r, 25));\n1565:    test(`killed between tools (${ids} tool-call ids): resumed unit preserves task/results but cannot claim verified completion`, async () => {\n1605:  test(\"killed while a writing tool ran: resume blocks, and continuing after inspection cannot complete the unit unverified\", async () => {\n1610:      return toolResults(b) === 0 ? { tools: [{ name: \"run_command\", args: { command: \"sleep 30\" } }] } : done(\"ran it\");\n1641:  test(\"a subagent that wrote before the kill leaves the unit unverified after continuing\", async () => {\n1678:  test(\"a high-entropy invocation id is redacted on disk, yet the operation is recorded as completed; recorded progress clears it\", () => {\n3600381 3600365       14:54  0.0 Sl   ep_poll              node /home/mik