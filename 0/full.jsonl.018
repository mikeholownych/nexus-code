er accuracy-per-time in the engineering\\n# benchmark); configuration is retained for historical reference but install and service are disabled.\\nvllm_xpu_workers_state: stopped\\nvllm_xpu_model_revision: \\\"4bd30395b72ea6045edd04806c4fea448d4467b3\\\"\\nvllm_xpu_model_path: \\\"/var/lib/local-ai/models/hub/models--cyankiwi--Qwen3-Coder-30B-A3B-Instruct-AWQ-4bit/snapshots/\\\\\\n  4bd30395b72ea6045edd04806c4fea448d4467b3\\\"\\nvllm_xpu_workers:\\n  worker1:\\n    worker_id: b0-live-tp1-worker1\\n    service_name: aihost-vllm-worker1.service\\n    container_name: vllm-xpu-tp1-worker1\\n    gpu: 0\\n    port: 8000\\n    extra_config:\\n      speculative-config: '{\\\"method\\\":\\\"ngram\\\",\\\"num_speculative_tokens\\\":5,\\\"prompt_lookup_max\\\":5,\\\"prompt_lookup_min\\\":2}'\\n    config_dir: /etc/local-ai/vllm/worker1\\n    config_file: /etc/local-ai/vllm/worker1/vllm-config.yaml\\n    env_file: /etc/local-ai/vllm/worker1/vllm.env\\n    recovery_record: /var/lib/aihost/evidence/vllm-worker1-recovery.json\\n    readiness_record: /var/lib/aihost/evidence/vllm-worker1-readiness.json\\n    initial_recovery_record:\\n      service: \\\"vllm-worker1\\\"\\n      event: \\\"initialized\\\"\\n      class: \\\"none\\\"\\n      stage_reached: \\\"\\\"\\n      exit_code: 0\\n      restart_count: null\\n      restart_count_source: \\\"uninitialized\\\"\\n      restart_count_obtained_at: \\\"\\\"\\n      service_invocation_id: \\\"\\\"\\n      terminal: false\\n      started_at: \\\"\\\"\\n      boot_id: \\\"\\\"\\n    initial_readiness_record:\\n      schema_version: \\\"1.0.0\\\"\\n      service: \\\"vllm-worker1\\\"\\n      readiness_state: \\\"initialized\\\"\\n      process_started_at: \\\"\\\"\\n      health_ready_at: null\\n      model_ready_at: null\\n      validation_ready_at: null\\n      startup_duration: null\\n      model_identity: {\\\"expected\\\": \\\"\\\", \\\"observed\\\": \\\"\\\"}\\n      tensor_parallel_size: {\\\"expected\\\": 1, \\\"observed\\\": null}\\n      boot_id: \\\"\\\"\\n      service_invocation_id: \\\"\\\"\\n      endpoint: \\\"\\\"\\n      probe_note: \\\"record created by role\\\"\\n\\n# GPU 1 runs llama.cpp (SYCL) instead of a second vLLM worker: measured 4x faster decode on\\n# the same model (76-79 vs ~18 tok/s) with warm prompt-cache reuse; vLLM has been retired on this host.\\nllama_cpp_container_enabled: true\\nllama_cpp_container_digest: sha256:2f4940610095fe48aabff3db7f87feb4f553081302b1a5a8744a589eb123b451\\n# Retired vLLM worker2 config plus the manual dual-worker experiment configs; all embed API keys.\\nllama_cpp_container_retired_paths:\\n  - /etc/local-ai/vllm/worker2\\n  - /etc/local-ai/t5820-dual-worker\\n  - /etc/local-ai/t5820-dual-worker-attempt2\\nllama_cpp_container_workers:\\n  worker1:\\n    worker_id: b0-live-llama-worker1\\n    service_name: aihost-llama-worker1.service\\n    container_name: llama-sycl-worker1\\n    gpu: 0\\n    port: 8000\\n    config_dir: /etc/local-ai/llama/worker1\\n    model_file: qwen3.6-35b-a3b/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf\\n    served_name: Qwen3.6-35B-A3B-UD-Q4_K_M\\n    context: 65536\\n    # Q-BUDGET selected 8192 under the authorized quality-over-speed policy.\\n    reasoning_budget: 8192\\n    cpuset_cpus: \\\"0,1,4,5\\\"\\n  worker2:\\n    worker_id: b0-live-llama-deep-worker2\\n    service_name: aihost-llama-worker2.service\\n    container_name: llama-sycl-worker2\\n    gpu: 1\\n    port: 8001\\n    config_dir: /etc/local-ai/llama/worker2\\n    model_file: flashnext-gsq-coder/IQ1_M/Qwen3.8-Flash-Next-GSQ-RCO-IQ1_M-00001-of-00002.gguf\\n    served_name: Qwen3.8-Flash-Next-GSQ-RCO-IQ1_M\\n    context: 65536\\n    args: [\\\"-ngl\\\", \\\"99\\\", \\\"--jinja\\\", \\\"-np\\\", \\\"1\\\", \\\"-fa\\\", \\\"on\\\", \\\"-b\\\", \\\"4096\\\", \\\"-ub\\\", \\\"2048\\\", \\\"--metrics\\\",\\n           \\\"--lazy-mode\\\", \\\"on\\\"]\\n    reasoning_budget: 4096\\n    cpuset_cpus: \\\"2,3,6,7\\\"\\n\\n# Scheduled lifecycle timers are OFF. The snapshot runner needs a deployed repo snapshot at /opt/local-ai\\n# (absent), and the reconcile unit converges with site.yml, which would overwrite the live inference\\n# topology (OS tuning, single-vLLM unit). Re-enable only after (a) a snapshot is deployed, and\\n# (b) reconcile/validate target playbooks/inference.yml and a validate play that matches this topology.\\nscheduled_ansible_reconcile_enabled: false\\nscheduled_ansible_validate_enabled: false\\n\\n# eno1 is only the VLAN parent (address lives on eno1.2) and never reaches 'configured', which made\\n# systemd-networkd-wait-online time out (2 min) at every boot.\\nboot_network_wait_optional_interfaces: [eno1]\\n---\\nschema_version: 1.0.0\\nprofile_name: d5820_dual_b65\\n\\nplatform:\\n  manufacturer: Dell\\n  product_family: Precision 5820 Tower\\n  machine_type_model: \\\"Precision 5820 Tower\\\"\\n  product_name_patterns:\\n    - Precision 5820\\n    - Precision 5820 Tower\\n    - Precision Tower 5820\\n\\ncpu:\\n  vendor: Intel\\n  model_patterns:\\n    - Intel(R) Xeon(R) W-2123\\n    - Intel Xeon W-2123\\n    - W-2123\\n  sockets_expected: 1\\n\\ngpu:\\n  count_expected: 2\\n  architecture: Alchemist\\n  approved_pci_devices:\\n    - vendor_id: \\\"8086\\\"\\n      device_id: \\\"0xe222\\\"\\n      subsystem_vendor_id: \\\"0x1849\\\"\\n      subsystem_device_id: \\\"0xe222\\\"\\n      model: Intel Arc Pro B65\\n      source: Intel Xe KMD supported hardware table\\n      source_url: https://dgpu-docs.intel.com/overview/supported-hardware/xe-driver-gpus.html\\n  expected_models:\\n    - vendor: Intel\\n      model: Intel Arc Pro B65\\n      memory_gib:\\n        approximate: 32\\n        tolerance_gib: 4\\n    - vendor: Intel\\n      model: Intel Arc Pro B65\\n      memory_gib:\\n        approximate: 32\\n        tolerance_gib: 4\\n\\npcie:\\n  host_link:\\n    # The Arc Pro B65 card is PCIe 5.0-capable; the Precision 5820 (Xeon\\n    # W-2123, Skylake-W) platform exposes Gen3 root ports. Gen3 x16 per card\\n  