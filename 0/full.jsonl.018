d: string, reason: string, quarantinedPath?: string) {\n240:  constructor(version: number, maxSupported: number = CURRENT_STATE_SCHEMA_VERSION) {\n249:  constructor(expectedTaskId: string, actualTaskId: string) {\n256:  constructor(expectedWorkspace: string, actualWorkspace: string) {\n310:  if (process.env.NEXUS_STATE_DIR) {\n311:    return path.join(process.env.NEXUS_STATE_DIR, \"tasks\");\n313:  return path.join(os.homedir(), \".nexus\", \"tasks\");\n320:  constructor(options: DurableStateManagerOptions = {}) {\n    this.name = \"TaskStateNotFoundError\";\n  }\n}\n\nexport class TaskStateReadError extends TaskStateError {\n  constructor(taskId: string, message: string) {\n    super(`Failed to read task state for '${taskId}': ${message}`);\n    this.name = \"TaskStateReadError\";\n  }\n}\n\nexport class TaskStateWriteError extends TaskStateError {\n  constructor(taskId: string, message: string) {\n    super(`Failed to write task state for '${taskId}': ${message}`);\n    this.name = \"TaskStateWriteError\";\n  }\n}\n\nexport class CorruptStateError extends TaskStateError {\n  public readonly quarantinedPath?: string;\n  constructor(taskId: string, reason: string, quarantinedPath?: string) {\n    super(`Corrupt state for task ID '${taskId}': ${reason}${quarantinedPath ? ` (quarantined to ${quarantinedPath})` : \"\"}`);\n    this.name = \"CorruptStateError\";\n    this.quarantinedPath = quarantinedPath;\n  }\n}\n\nexport class UnsupportedSchemaVersionError extends TaskStateError {\n  public readonly version: number;\n  public readonly maxSupported: number;\n  constructor(version: number, maxSupported: number = CURRENT_STATE_SCHEMA_VERSION) {\n    super(`State was created by a newer Nexus (schema ${version}); upgrade to load this state. (Highest supported version is ${maxSupported})`);\n    this.name = \"UnsupportedSchemaVersionError\";\n    this.version = version;\n    this.maxSupported = maxSupported;\n  }\n}\n\nexport class TaskIdentityMismatchError extends TaskStateError {\n  constructor(expectedTaskId: string, actualTaskId: string) {\n    super(`Task identity mismatch: expected '${expectedTaskId}', found '${actualTaskId}'.`);\n    this.name = \"TaskIdentityMismatchError\";\n  }\n}\n\nexport class WorkspaceIdentityMismatchError extends TaskStateError {\n  constructor(expectedWorkspace: string, actualWorkspace: string) {\n    super(`Workspace identity mismatch: expected '${expectedWorkspace}', found '${actualWorkspace}'.`);\n    this.name = \"WorkspaceIdentityMismatchError\";\n  }\n}\n\n// -------------------------------------------------------------\n// Recovery Contract\n// -------------------------------------------------------------\n\nexport interface TaskRecoveryOptions {\n  expectedWorkspace?: string;\n  workspacePaths?: WorkspacePath[];\n  candidateTracker?: CandidateTracker;\n  worktreeManager?: WorktreeManager;\n  authorityEngine?: AuthorityAdmissionEngine;\n  currentConfig?: {\n    readOnly?: boolean;\n    fullAccess?: boolean;\n  };\n  revalidateCandidate?: boolean;\n}\n\nexport interface TaskRecoveryResult {\n  success: boolean;\n  state: DurableTaskState;\n  /** Whether the pre-recovery record contained an obligation field; descriptive only, never a trust signal. */\n  obligationRecordPresent: boolean;\n  interrupted: boolean;\n  interruptedOperation?: InFlightOperationRecord;\n  worktreeStatus: \"consistent\" | \"missing\" | \"detached\" | \"none\";\n  candidateStatus: \"consistent\" | \"mutated_offline\" | \"missing_workspace\" | \"no_candidate\";\n  invalidatedReceiptCount: number;\n  reconstructedStateSummary: {\n    milestonesRecovered: number;\n    planPhasesRecovered: number;\n    messagesRecovered: number;\n    ephemeralPidsCleared: boolean;\n    authorityResurrected: false;\n  };\n  diagnostics: string[];\n}\n\n// -------------------------------------------------------------\n// DurableStateManager\n// -------------------------------------------------------------\n\nexport interface DurableStateManagerOptions {\n  baseDir?: string;\n  workspacePaths?: WorkspacePath[];\n}\n\n/** Where durable task state is written unless a directory is given. */\nexport function defaultTaskStateDir(): string {\n  if (process.env.NEXUS_STATE_DIR) {\n        if (!state.candidateId && state.validationReceipts && state.validationReceipts.length > 0) {\n          state.candidateId = state.validationReceipts[state.validationReceipts.length - 1].candidateId;\n        }\n        return state;\n      } catch {}\n    }\n    return this.agent.checkpointDurableState();\n  }\n\n  public getActiveValidationReceipt(): ValidationReceipt | null {\n    const fromAgent = this.agent.getActiveValidationReceipt();\n    if (fromAgent) return fromAgent;\n    const taskId = this.agent.getTaskId();\n    if (this.stateManager.hasTaskState(taskId)) {\n      try {\n        const state = this.stateManager.loadTaskState(taskId);\n        if (state.validationReceipts && state.validationReceipts.length > 0) {\n          return state.validationReceipts[state.validationReceipts.length - 1];\n        }\n      } catch {}\n    }\n    return null;\n  }\n\n  /**\n   * Executes a task through the unified execution spine and durable state lifecycle (UI-001, UI-002, UI-003).\n   */\n  public async runTask(prompt: string, options: RunTaskOptions = {}): Promise<TaskExecutionResult> {\n    const startTime = Date.now();\n    let taskId = this.agent.getTaskId();\n\n      unverifiedChangesPending: this.agent.hasUnverifiedChanges(),\n      tokenStats: this.agent.getTokenStats(),\n      activePlan: durableState.activePlan,\n      milestones: durableState.milestones,\n      candidateId: durableState.candidateId,\n      validationReceipts: durableState.validationReceipts,\n      worktreeBinding: durableState.worktreeBinding,\n      findings: durableState.findings,\n      objective: this.agent.getObjective() ?? null,\n      // Compactions this record commits; their originals are archived beside the task state (`<task>.history.jsonl`).\n      history: this.agent.getHistoryCompleteness(),\n    }, this.agent.getWorkspacePathIdentity()));\n\n    // Extract last assistant output\n    let outputText = \"\";\n    for (let i = messages.length - 1; i >= 0; i--) {\n      if (messages[i].role === \"assistant\" && messages[i].content) {\n        const c = messages[i].content;\n        outputText = typeof c === \"string\" ? c : JSON.stringify(c);\n        break;\n      }\n    }\n\n    const durationMs = Date.now() - startTime;\n    const success = turnSucceeded(finalTurn);\n\n    const result: TaskExecutionResult = {\n      taskId,\n      success,\n      status: lifecycleStatusForTurn(finalTurn),\n      prompt,\n      output: outputText,\n      plan: durableState.activePlan || [],\n      milestones: durableState.milestones || [],\n      candidateId: durableState.candidateId || null,\n      candidateIdentity: durableState.candidateIdentity || null,\n      validationReceipts: durableState.validationReceipts || [],\n      worktreeBinding: durableState.worktreeBinding || null,\n      tokenStats: this.agent.getTokenStats(),\n      durationMs,\n      error: taskError ? taskError.message : undefined,\n","exit_code":0,"duration":{"secs":0,"nanos":28892}},"started_at_ms":1792917068064,"completed_at_ms":1792917068064}}
