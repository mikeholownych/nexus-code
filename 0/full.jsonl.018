ation verification failed for $ARCHIVE or SHA256SUMS.\"\n  fi\nfi\n\nVERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\nBIN_DIR=\"$PREFIX/bin\"\nLINK=\"$BIN_DIR/nexus\"\nmkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\nif [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n  fail \"$LINK exists and is not a symlink; left it unchanged.\"\nfi\nif [ -L \"$LINK\" ]; then\n  OLD=$(readlink \"$LINK\")\n  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\nfi\n\nFORCE=${NEXUS_FORCE:-0}\nNEEDS_EXTRACT=1\nif [ -d \"$VERSION_DIR\" ] && [ \"$FORCE\" != \"1\" ]; then\n  if [ -x \"$VERSION_DIR/bin/nexus\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/harness-core\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/nexus-tui\" ] && \\\norigin/main:cli/src/upgrade.ts:120:  attestationVerified?: boolean;\norigin/main:cli/src/upgrade.ts:517:    // Check if prereleases exist (matching install.sh behavior)\norigin/main:cli/src/upgrade.ts:581:      \"Nexus is running from a source development checkout. Use `git pull && make build` to update, or install the packaged release via `install.sh`.\"\norigin/main:cli/src/upgrade.ts:917:  const verifyAttestation = process.env.NEXUS_VERIFY_ATTESTATION ?? \"auto\";\norigin/main:cli/src/upgrade.ts:922:      \"Provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\",\norigin/main:cli/src/upgrade.ts:1069:    // Optional attestation check via a trusted gh if present. Do not resolve it from PATH: a shim that exits 0\norigin/main:cli/src/upgrade.ts:1070:    // must not be able to claim a verified attestation, and a missing gh must fail closed when verification is required.\norigin/main:cli/src/upgrade.ts:1071:    let attestationVerified: boolean | undefined;\norigin/main:cli/src/upgrade.ts:1074:        options?.onProgress?.(\"verifying_attestation\", \"Checking build provenanc