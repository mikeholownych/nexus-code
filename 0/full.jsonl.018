 null,\n    memoryMaxEvents: memoryEvents.max ?? null,\n    pidsPeak: Number(read(path.join(payload, \"pids.peak\")) ?? NaN) || null,\n    pidsMaxEvents: pidsEvents.max ?? null,\n    cpuUsageUsec: cpu.usage_usec ?? null,\n    cpuThrottledUsec: cpu.throttled_usec ?? null,\n    survivorsAfterExit: procs.length,\n  };\n  killPayload();\n  const deadline = Date.now() + 5000;\n  const poll = () => {\n    if (/^populated 0$/m.test(read(path.join(payload, \"cgroup.events\")) ?? \"\")) {\n      report({ ...stats, cleaned: true, stopped: stopRequested, signals: signalRequests, exitCode: code, signal, spawnError });\n      process.exit(code ?? (signal ? 128 + (os.constants.signals[signal] ?? 0) : 125));\n    }\n    if (Date.now() > deadline) {\n      report({ ...stats, cleaned: false, signals: signalRequests, exitCode: code, signal, spawnError, error: \"payload cgroup still populated after cgroup.kill\" });\n      process.exit(125);\n    }\n    setTimeout(poll, 20);\n  };\n  poll();\n}\n    regressions: rs.filter((r) => r.regressionPass === false).length,\n    // Cost of the whole configuration's runs per correct result (failed runs cost too).\n    tokensPerCorrect: k ? sum(rs.map((r) => r.tokens?.total)) / k : null,\n    wallSecondsPerCorrect: k ? sum(rs.map((r) => r.wallMs)) / 1000 / k : null,\n  };\n});\n\n// T4: emit all nine preregistered classes, including empty rows. Proxy, task-fixture, and\n// runner-injected events share one scoring path so a proxy-only result cannot look complete.\nconst t4Events = (r) => [\n  ...(r.model?.faultsInjected ?? []).map((f) => ({ ...f, source: f.source ?? \"model_proxy\" })),\n  ...(r.t4FaultsInjected ?? []),\n];\nconst expectedSource = (kind) => T4_PROXY_CLASSES.has(kind) ? \"model_proxy\" : T4_RUNNER_CLASSES.has(kind) ? \"task_fixture_or_runner\" : null;\nconst runnerEvidenceValid = (event) => {\n  const evidence = event.evidence;\n  if (!evidence || typeof evidence !== \"object\") return false;\n  if (event.kind === \"sigterm_resume\