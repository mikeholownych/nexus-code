{"timestamp":"2026-10-25T07:43:32.991Z","ordinal":329725,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a171fd-3278-7ca3-ad25-d2f716cb2b15","item":{"type":"CommandExecution","id":"exec-b932a80d-7663-4709-b91f-c13fc5c0ebcc","process_id":"94727","command":["/usr/bin/zsh","-lc","sed -n '228,330p' eval/run.mjs; sed -n '230,270p' docs/v1.0.0/ACCEPTANCE.md; sed -n '20,36p' docs/v1.0.0/plans/PLAN-10-v1-qualification-and-evaluation.md; rg -n 'faultsInjected|fixture|T4' cli/test/eval_harness.test.ts | head -40"],"cwd":"file:///home/mike/nexus-wt/plan10-pr10c-t4","parsed_cmd":[{"type":"read","cmd":"sed -n '228,330p' eval/run.mjs","name":"run.mjs","path":"eval/run.mjs"},{"type":"read","cmd":"sed -n '230,270p' docs/v1.0.0/ACCEPTANCE.md","name":"ACCEPTANCE.md","path":"docs/v1.0.0/ACCEPTANCE.md"},{"type":"read","cmd":"sed -n '20,36p' docs/v1.0.0/plans/PLAN-10-v1-qualification-and-evaluation.md","name":"PLAN-10-v1-qualification-and-evaluation.md","path":"docs/v1.0.0/plans/PLAN-10-v1-qualification-and-evaluation.md"},{"type":"search","cmd":"rg -n 'faultsInjected|fixture|T4' cli/test/eval_harness.test.ts","query":"faultsInjected|fixture|T4","path":"eval_harness.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    });\n    const started = Date.now();\n    let agent;\n    let agentEndedAt;\n    try {\n      agent = await runAgent(task, ws, home, budget, agentIdentity, proxyDir, localToken);\n      agentEndedAt = Date.now();\n      if (config.runAs) {\n        for (const dir of [ws, home]) await normalizeRunAsPermissions(config.runAs, dir, asUserSpec);\n      }\n    } finally {\n      await proxy?.close();\n      fs.rmSync(proxyDir, { recursive: true, force: true });\n    }\n    const wallMs = agentEndedAt - started;\n    if (agent.containmentProblem) throw new Error(`candidate containment failed: ${agent.containmentProblem}`);\n    const model = proxy ? proxy.stats() : null;\n    const contaminated = treeDigest(task.dir) !== sourceBefore || `${agent.stdout}${agent.stderr}`.includes(tasksDir);\n    // T3 judges the workspace as it was when the objective's work ended (snapshot taken before the probe turn).\n    const t3 = agent.t3Driver ? scoreT3Run({ task, baseline: t3Baseline, driver: agent.t3Driver, preconditions: agent.t3Preconditions, compactions: countCompactions(home) }) : null;\n    // Legacy hidden tests share a process with candidate code. In qualification (or with hardenedChecks) they never\n    // run in the agent's workspace: each check gets a fresh staging of the baseline with only the agent's source\n    // changes (eval/hardened_check.mjs). Black-box oracles already keep expectations outside the candidate.\n    const hardened = (config.qualification === true || config.hardenedChecks === true) && task.hidden?.protocol !== \"blackbox-v1\";\n    let hardening = null;\n    let hiddenWs = ws;\n    let regressionWs = ws;\n    if (hardened) {\n      hiddenWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-check-${task.id}-`));\n      regressionWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-regression-${task.id}-`));\n      checkDirs.push(hiddenWs, regressionWs);\n      await prepareWorkspace(task, hiddenWs);\n      // Fixture tasks commit at staging time, so compare content (the tree), not the commit id.\n      if (gitRev(hiddenWs, \"HEAD^{tree}\") !== baselineTree) throw new Error(\"hardened check workspace staged a different baseline\");\n      hardening = { baseline: baselineTree, ...applyAgentChanges(ws, hiddenWs) };\n      cloneWorkspace(hiddenWs, regressionWs);\n    }\n    const refused = (check) => ({ pass: false, status: null, timedOut: false, overflow: false, output: `hardened check refused: ${hardening.configChanges.join(\"; \")}`, refused: true, resources: null, containmentProblem: null, check });\n    const hidden = hardening?.configChanges.length ? refused(\"hidden\") : await runCheck(task, hiddenWs, task.hidden, true, { readOnlyHidden: hardened });\n    const regression = task.regression ? (hardening?.configChanges.length ? refused(\"regression\") : await runCheck(task, regressionWs, task.regression, false)) : null;\n    for (const [phase, check] of [[\"hidden\", hidden], [\"regression\", regression]]) {\n      if (check?.containmentProblem) throw new Error(`${phase} check containment failed: ${check.containmentProblem}`);\n    }\n    const turn = agent.json?.turn ?? null;\n    // Nexus reports a structured outcome; for the other agents a clean exit within the budget is their completion claim.\n    const claimedComplete = turn\n      ? turn.execution === \"COMPLETED\" && [\"VERIFIED\", \"REGRESSION_FREE\", \"UNVERIFIED\", \"NOT_REQUIRED\"].includes(turn.outcome)\n      : agent.code === 0 && !agent.timedOut && !agent.outputExceeded;\n    return {\n      ...base,\n      wallMs,\n      exitCode: agent.code,\n      timedOut: agent.timedOut,\n      outputExceeded: agent.outputExceeded,\n      turn: turn && { execution: turn.execution, outcome: turn.outcome, reason: turn.reason ?? null, steps: turn.steps ?? null, contextNotRetained: turn.contextNotRetained ?? 0 },\n      claimedComplete,\n      claimedVerified: turn?.outcome === \"VERIFIED\",\n      hiddenPass: hidden.pass,\n      regressionPass: regression ? regression.pass : null,\n      falseVerified: turn?.outcome === \"VERIFIED\" && !hidden.pass,\n      contaminated,\n      tokens: agent.json?.tokenStats ?? null,\n      ...(hardening ? { hardened: { baseline: hardening.baseline, applied: hardening.applied.length, discarded: hardening.discarded, configChanges: hardening.configChanges } } : {}),\n      ...(t3 ? { t3 } : {}),\n      model,\n      resources: config.resources ? { agent: agent.resources, hidden: hidden.resources ?? null, regression: regression?.resources ?? null, ...(t3BaselineResources.length ? { t3Baseline: t3BaselineResources } : {}) } : null,\n      logs: saveLogs(task, run, agent, hidden, regression),\n    };\n  } catch (err) {\n    return { ...base, wallMs: 0, error: String(err?.message ?? err), hiddenPass: false, regressionPass: null, falseVerified: false, claimedComplete: false, claimedVerified: false };\n  } finally {\n    if (!args.keep) {\n      for (const dir of checkDirs) fs.rmSync(dir, { recursive: true, force: true });\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n    }\n  }\n}\n\nasync function prepareWorkspace(task, ws) {\n  if (task.fixture) {\n    const fixture = confinedPath(task.dir, task.fixture);\n    assertNoSymlinks(fixture);\n    fs.cpSync(fixture, ws, { recursive: true, verbatimSymlinks: true });\n    sh(\"git\", [\"init\", \"-q\"], ws);\n    sh(\"git\", [\"add\", \"-A\"], ws);\n    sh(\"git\", [\"-c\", \"user.name=eval\", \"-c\", \"user.email=eval@example.invalid\", \"commit\", \"-qm\", \"fixture\"], ws);\n  } else if (task.repo) {\n    const cache = path.join(ROOT, \"eval/.cache\", createHash(\"sha256\").update(task.repo.url).digest(\"hex\").slice(0, 16));\n    if (!fs.existsSync(cache)) sh(\"git\", [\"clone\", \"-q\", \"--no-checkout\", task.repo.url, cache], ROOT);\n    const object = `${task.repo.commit}^{commit}`;\n    if (sh(\"git\", [\"-C\", cache, \"cat-file\", \"-e\", object], ROOT, true) !== 0) sh(\"git\", [\"-C\", cache, \"fetch\", \"-q\", \"origin\", task.repo.commit], ROOT);\n    stageRepoWorkspace(cache, task.repo.commit, ws);\n  } else throw new Error(`task ${task.id} has neither fixture nor repo`);\n  for (const cmd of task.setup ?? []) {\n    const result = await runIsolated(cmd, { cwd: ws, home: true, timeoutSec: task.setupTimeoutSec ?? 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() });\n    if (result.containmentProblem) throw new Error(`isolated setup containment failed for ${task.id}: ${result.containmentProblem}`);\n    if (result.status !== 0 || result.timedOut || result.overflow) throw new Error(`isolated setup failed for ${task.id}: ${result.timedOut ? \"timeout\" : result.overflow ? \"output limit\" : `exit ${result.status}`}`);\n  }\n}\n\n/**\n * The command line and environment for one agent run. Each agent gets a fresh HOME holding only its gateway settings\n\n  Record the resolved `T2_TASKS`, unique `T2_OUT`, config digests, installed RC identity, model fingerprint, and exact commands in the frozen run record before starting. A failed or interrupted invocation remains evidence; any permitted infrastructure rerun uses the accepted rerun procedure and is retained separately. Do not score until all required runs and manifests exist. The scorer accepts exactly the Nexus, Goose and OpenCode result files.\n\n### 6.2 T4 fault injection (ACC-QUAL-T4)\n\n9 fault classes × 5 runs on the Nexus RC. The configured faults run through `eval/run.mjs` and `eval/model_proxy.mjs`; the hanging-command and full-disk cases use task fixtures, and SIGTERM-then-resume uses the runner case (DEC-05 amendment, 2026-10-17: the union of the distinct scenarios below):\n\n1. refused connection mid-turn\n2. 5xx / overloaded\n3. stream cut mid-tool-call\n4. output-limit truncation\n5. hanging test command\n6. disk full\n7. context overflow at 32k\n8. malformed tool-call JSON\n9. SIGTERM then `run --resume`\n\n### 6.3 T3 long tasks (ACC-QUAL-T3)\n\n- 8 tasks × 5 runs. Each run must have ≥ 60 steps, ≥ 2 compactions and scripted steering.\n\n### 6.4 Thresholds (DEC-05; all must hold)\n\n| Metric | Gate |\n|---|---|\n| False VERIFIED (T2 + T3 + T4) | **= 0** |\n| T2 pooled hidden-test correctness | ≥ 60% and ≥ best matched peer − 10 pts |\n| T2 per class (bugfix, feature, refactor, debug) | ≥ 40% |\n| Crash rate (all Nexus runs) | ≤ 2% |\n| Regression rate | ≤ 5% |\n| T4 truthful outcome | = 100% |\n| T4 hang beyond budget + 5 min | = 0 |\n| T3 false-absence | = 0 |\n| T3 false-presence | = 0 |\n| T3 steering honoured | ≥ 95% |\n| Operator interventions in `run` mode | = 0 |\n\nThe scorer output `verdict.md` lists each metric with its Wilson 95% interval, along with the infrastructure reruns and the excluded contaminated runs.\n\n## 7. Install, upgrade, rollback, uninstall (ACC-PLAT; E2)\n\n## Tasks\n\n| # | Task | Location | Depends on |\n|---|---|---|---|\n| 1 | Symmetric infrastructure classification. A run counts as infrastructure only when `first_model_request_at` is missing **and** there is an unreachable signature. Same rule for every agent. Crash and timeout rates are reported. | `infra.mjs:31`; `run.mjs` (record `first_model_request_at` from the proxy log) | — |\n| 2 | Scorer: log replacements; exclude contaminated runs from pooled rates; add metric columns for intervention, recovery, bounded-failure truthfulness, cost per correct task, and pre/post regression diff. | `score.mjs:16-21,48-84` | 1 |\n| 3 | Hidden-test isolation. Hidden tests are stored under a separate uid (`nexus-eval`, created by the operator, owner action under X3) with mode 0700, and copied in after the agent exits. The agent runs with an allow-listed env. | `run.mjs:57-59,114,178` | — |\n| 4 | Fingerprint. Record server kind, build, weights sha256 (from config), and sampling settings. Refuse the run if the fingerprint is missing. Temperature 0 or a fixed seed for every agent where the agent supports it. | new `fingerprint.mjs`; `configs/*.json` | PLAN-05 task 1 |\n| 5 | Fault proxy for T4 classes 1–4 and 7–8, scheduled per run. Fixture hooks for 5 (hanging test), 6 (disk full via a small loop-mounted fs or `ulimit -f`), and 9 (SIGTERM then `run --resume`). | new `eval/faults/proxy.mjs`; task fixtures | PLAN-04 task 1 |\n| 6 | T4 smoke in `make test`: scripted model plus 2 fault cases. The T1 self-test stays. | `cli/test/eval_harness.test.ts`; `Makefile` | 5 |\n| 7 | Task schema `{repo, commit, prompt, hidden_tests, fail_to_pass, pass_to_pass, class, difficulty}`, with a validator. | `eval/tasks/schema.json`; `run.mjs` | — |\n| 8 | Author tasks (owner action X2). Development set: the existing 6 plus routing engx T01–T12. Held-out set: 40 T2 tasks, of which at least 20 are external, at least 6 per class, across 4 languages. Plus 8 T3 tasks. The sha256 manifest is committed before RC freeze. Calibrate on the development set only. | external store; `eval/heldout-manifest.json` | 7 |\n| 9 | Peer adapters: confirm Goose and OpenCode on the same model and budgets, and record peer versions. | `run.mjs:120-143` | 4 |\n| 10 | Mark `nexus eval` experimental (help and docs). Fix its operator-workspace checkout: run in a worktree (VER-07a). | `index.ts:663-688`; `evaluator.ts:128` | — |\n| 11 | M5 runs: T2 held-out (5×), T3 (5×), T4 (9×5), standalone subset (PLAN-05), provider verify (DEC-06). Archive everything under `docs/reviews/evidence/v1-qualification/<rc>/`. | runbook in ACCEPTANCE §4–§6 | all, RC build |\n| 13 | `eval/standalone/plain_proxy.mjs`: a forward proxy to the gateway. It injects the gateway token server-side. It strips `/v1/models` to `{id,object,owned_by}`, returns 404 for `/v1/tokenize`, and drops `X-AIHost-*` and admission headers. The `--emulate {llamacpp,vllm,ollama}` profiles add that server's `/models`, `/props`, `/api/show` and overflow-error shapes, derived from the real gateway limits. Unit-tested against a mock gateway. | new `eval/standalone/` | — |\n| 12 | Terminal matrix (manual): {xterm, kitty, tmux, VS Code, GNOME Terminal} × 3 sizes. Checklist per ACCEPTANCE §5.3. Archive screenshots. | ACCEPTANCE §5.3 | RC build |\n15:import { startGateway, Reply } from \"./helpers/fixtures.js\";\n98:// REQ-QUAL-110: T4 smoke in `make test` — faults injected by the harness's model proxy end truthfully.\n112:test(\"T4 smoke: an overloaded endpoint is waited out and the task still completes; the fault is recorded\", { timeout: 300_000 }, async () => {\n115:  assert.deepEqual(r.model.faultsInjected, [{ kind: \"overloaded\", atRequest: 1 }]);\n118:  assert.equal(score.faults.length, 9, \"the scorer always exposes all nine accepted T4 fault classes\");\n123:test(\"T4 smoke: a reply cut at the output limit is never run as a tool call, and the run ends truthfully\", { timeout: 300_000 }, async () => {\n126:  assert.equal(r.model.faultsInjected[0].kind, \"truncate\");\n214:  const task = path.join(tasks, \"qual-fixture\");\n215:  fs.mkdirSync(path.join(task, \"fixture\"), { recursive: true, mode: 0o700 });\n218:    id: \"qual-fixture\",\n220:    objective: \"Inspect the fixture\",\n221:    fixture: \"fixture\",\n239:    fingerprint: { weightsSha256: \"a\".repeat(64), serverBuild: \"fixture server\" },\n286:  const fingerprint = { alias: \"engineering/deep\", listed: true, ownedBy: \"fixture\", contextLength: 65536, weightsSha256: \"a\".repeat(64), serverBuild: \"llama.cpp b123\", sampling: { temperature: 0, seed: 17 } };\n","exit_code":0,"duration":{"secs":0,"nanos":727489325}},"started_at_ms":1792914212261,"completed_at_ms":1792914212989}}
{"timestamp":"2026-10-25T07:43:34.753Z","ordinal":329726,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17203-cf61-70c2-9007-849443a2de25","call_id":"call_187707e168884c14a7a7bc348708a955","output":[{"type":"input_text","text":"Script completed\nWall time 3.6 seconds\nOutput:\n"},{"type":"input_text","text":"    });\n    const started = Date.now();\n    let agent;\n    let agentEndedAt;\n    try {\n      agent = await runAgent(task, ws, home, budget, agentIdentity, proxyDir, localToken);\n      agentEndedAt = Date.now();\n      if (config.runAs) {\n        for (const dir of [ws, home]) await normalizeRunAsPermissions(config.runAs, dir, asUserSpec);\n      }\n    } finally {\n      await proxy?.close();\n      fs.rmSync(proxyDir, { recursive: true, force: true });\n    }\n    const wallMs = agentEndedAt - started;\n    if (agent.containmentProblem) throw new Error(`candidate containment failed: ${agent.containmentProblem}`);\n    const model = proxy ? proxy.stats() : null;\n    const contaminated = treeDigest(task.dir) !== sourceBefore || `${agent.stdout}${agent.stderr}`.includes(tasksDir);\n    // T3 judges the workspace as it was when the objective's work ended (snapshot taken before the probe turn).\n    const t3 = agent.t3Driver ? scoreT3Run({ task, baseline: t3Baseline, driver: agent.t3Driver, preconditions: agent.t3Preconditions, compactions: countCompactions(home) }) : null;\n    // Legacy hidden tests share a process with candidate code. In qualification (or with hardenedChecks) they never\n    // run in the agent's workspace: each check gets a fresh staging of the baseline with only the agent's source\n    // changes (eval/hardened_check.mjs). Black-box oracles already keep expectations outside the candidate.\n    const hardened = (config.qualification === true || config.hardenedChecks === true) && task.hidden?.protocol !== \"blackbox-v1\";\n    let hardening = null;\n    let hiddenWs = ws;\n    let regressionWs = ws;\n    if (hardened) {\n      hiddenWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-check-${task.id}-`));\n      regressionWs = fs.mkdtempSync(path.join(scratch, `nexus-eval-regression-${task.id}-`));\n      checkDirs.push(hiddenWs, regressionWs);\n      await prepareWorkspace(task, hiddenWs);\n      // Fixture tasks commit at staging time, so compare content (the tree), not the commit id.\n      if (gitRev(hiddenWs, \"HEAD^{tree}\") !== baselineTree) throw new Error(\"hardened check workspace staged a different baseline\");\n      hardening = { baseline: baselineTree, ...applyAgentChanges(ws, hiddenWs) };\n      cloneWorkspace(hiddenWs, regressionWs);\n    }\n    const refused = (check) => ({ pass: false, status: null, timedOut: false, overflow: false, output: `hardened check refused: ${hardening.configChanges.join(\"; \")}`, refused: true, resources: null, containmentProblem: null, check });\n    const hidden = hardening?.configChanges.length ? refused(\"hidden\") : await runCheck(task, hiddenWs, task.hidden, true, { readOnlyHidden: hardened });\n    const regression = task.regression ? (hardening?.configChanges.length ? refused(\"regression\") : await runCheck(task, regressionWs, task.regression, false)) : null;\n    for (const [phase, check] of [[\"hidden\", hidden], [\"regression\", regression]]) {\n      if (check?.containmentProblem) throw new Error(`${phase} check containment failed: ${check.containmentProblem}`);\n    }\n    const turn = agent.json?.turn ?? null;\n    // Nexus reports a structured outcome; for the other agents a clean exit within the budget is their completion claim.\n    const claimedComplete = turn\n      ? turn.execution === \"COMPLETED\" && [\"VERIFIED\", \"REGRESSION_FREE\", \"UNVERIFIED\", \"NOT_REQUIRED\"].includes(turn.outcome)\n      : agent.code === 0 && !agent.timedOut && !agent.outputExceeded;\n    return {\n      ...base,\n      wallMs,\n      exitCode: agent.code,\n      timedOut: agent.timedOut,\n      outputExceeded: agent.outputExceeded,\n      turn: turn && { execution: turn.execution, outcome: turn.outcome, reason: turn.reason ?? null, steps: turn.steps ?? null, contextNotRetained: turn.contextNotRetained ?? 0 },\n      claimedComplete,\n      claimedVerified: turn?.outcome === \"VERIFIED\",\n      hiddenPass: hidden.pass,\n      regressionPass: regression ? regression.pass : null,\n      falseVerified: turn?.outcome === \"VERIFIED\" && !hidden.pass,\n      contaminated,\n      tokens: agent.json?.tokenStats ?? null,\n      ...(hardening ? { hardened: { baseline: hardening.baseline, applied: hardening.applied.length, discarded: hardening.discarded, configChanges: hardening.configChanges } } : {}),\n      ...(t3 ? { t3 } : {}),\n      model,\n      resources: config.resources ? { agent: agent.resources, hidden: hidden.resources ?? null, regression: regression?.resources ?? null, ...(t3BaselineResources.length ? { t3Baseline: t3BaselineResources } : {}) } : null,\n      logs: saveLogs(task, run, agent, hidden, regression),\n    };\n  } catch (err) {\n    return { ...base, wallMs: 0, error: String(err?.message ?? err), hiddenPass: false, regressionPass: null, falseVerified: false, claimedComplete: false, claimedVerified: false };\n  } finally {\n    if (!args.keep) {\n      for (const dir of checkDirs) fs.rmSync(dir, { recursive: true, force: true });\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n    }\n  }\n}\n\nasync function prepareWorkspace(task, ws) {\n  if (task.fixture) {\n    const fixture = confinedPath(task.dir, task.fixture);\n    assertNoSymlinks(fixture);\n    fs.cpSync(fixture, ws, { recursive: true, verbatimSymlinks: true });\n    sh(\"git\", [\"init\", \"-q\"], ws);\n    sh(\"git\", [\"add\", \"-A\"], ws);\n    sh(\"git\", [\"-c\", \"user.name=eval\", \"-c\", \"user.email=eval@example.invalid\", \"commit\", \"-qm\", \"fixture\"], ws);\n  } else if (task.repo) {\n    const cache = path.join(ROOT, \"eval/.cache\", createHash(\"sha256\").update(task.repo.url).digest(\"hex\").slice(0, 16));\n    if (!fs.existsSync(cache)) sh(\"git\", [\"clone\", \"-q\", \"--no-checkout\", task.repo.url, cache], ROOT);\n    const object = `${task.repo.commit}^{commit}`;\n    if (sh(\"git\", [\"-C\", cache, \"cat-file\", \"-e\", object], ROOT, true) !== 0) sh(\"git\", [\"-C\", cache, \"fetch\", \"-q\", \"origin\", task.repo.commit], ROOT);\n    stageRepoWorkspace(cache, task.repo.commit, ws);\n  } else throw new Error(`task ${task.id} has neither fixture nor repo`);\n  for (const cmd of task.setup ?? []) {\n    const result = await runIsolated(cmd, { cwd: ws, home: true, timeoutSec: task.setupTimeoutSec ?? 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() });\n    if (result.containmentProblem) throw new Error(`isolated setup containment failed for ${task.id}: ${result.containmentProblem}`);\n    if (result.status !== 0 || result.timedOut || result.overflow) throw new Error(`isolated setup failed for ${task.id}: ${result.timedOut ? \"timeout\" : result.overflow ? \"output limit\" : `exit ${result.status}`}`);\n  }\n}\n\n/**\n * The command line and environment for one agent run. Each agent gets a fresh HOME holding only its gateway settings\n\n  Record the resolved `T2_TASKS`, unique `T2_OUT`, config digests, installed RC identity, model fingerprint, and exact commands in the frozen run record before starting. A failed or interrupted invocation remains evidence; any permitted infrastructure rerun uses the accepted rerun procedure and is retained separately. Do not score until all required runs and manifests exist. The scorer accepts exactly the Nexus, Goose and OpenCode result files.\n\n### 6.2 T4 fault injection (ACC-QUAL-T4)\n\n9 fault classes × 5 runs on the Nexus RC. The configured faults run through `eval/run.mjs` and `eval/model_proxy.mjs`; the hanging-command and full-disk cases use task fixtures, and SIGTERM-then-resume uses the runner case (DEC-05 amendment, 2026-10-17: the union of the distinct scenarios below):\n\n1. refused connection mid-turn\n2. 5xx / overloaded\n3. stream cut mid-tool-call\n4. output-limit truncation\n5. hanging test command\n6. disk full\n7. context overflow at 32k\n8. malformed tool-call JSON\n9. SIGTERM then `run --resume`\n\n### 6.3 T3 long tasks (ACC-QUAL-T3)\n\n- 8 tasks × 5 runs. Each run must have ≥ 60 steps, ≥ 2 compactions and scripted steering.\n\n### 6.4 Thresholds (DEC-05; all must hold)\n\n| Metric | Gate |\n|---|---|\n| False VERIFIED (T2 + T3 + T4) | **= 0** |\n| T2 pooled hidden-test correctness | ≥ 60% and ≥ best matched peer − 10 pts |\n| T2 per class (bugfix, feature, refactor, debug) | ≥ 40% |\n| Crash rate (all Nexus runs) | ≤ 2% |\n| Regression rate | ≤ 5% |\n| T4 truthful outcome | = 100% |\n| T4 hang beyond budget + 5 min | = 0 |\n| T3 false-absence | = 0 |\n| T3 false-presence | = 0 |\n| T3 steering honoured | ≥ 95% |\n| Operator interventions in `run` mode | = 0 |\n\nThe scorer output `verdict.md` lists each metric with its Wilson 95% interval, along with the infrastructure reruns and the excluded contaminated runs.\n\n## 7. Install, upgrade, rollback, uninstall (ACC-PLAT; E2)\n\n## Tasks\n\n| # | Task | Location | Depends on |\n|---|---|---|---|\n| 1 | Symmetric infrastructure classification. A run counts as infrastructure only when `first_model_request_at` is missing **and** there is an unreachable signature. Same rule for every agent. Crash and timeout rates are reported. | `infra.mjs:31`; `run.mjs` (record `first_model_request_at` from the proxy log) | — |\n| 2 | Scorer: log replacements; exclude contaminated runs from pooled rates; add metric columns for intervention, recovery, bounded-failure truthfulness, cost per correct task, and pre/post regression diff. | `score.mjs:16-21,48-84` | 1 |\n| 3 | Hidden-test isolation. Hidden tests are stored under a separate uid (`nexus-eval`, created by the operator, owner action under X3) with mode 0700, and copied in after the agent exits. The agent runs with an allow-listed env. | `run.mjs:57-59,114,178` | — |\n| 4 | Fingerprint. Record server kind, build, weights sha256 (from config), and sampling settings. Refuse the run if the fingerprint is missing. Temperature 0 or a fixed seed for every agent where the agent supports it. | new `fingerprint.mjs`; `configs/*.json` | PLAN-05 task 1 |\n| 5 | Fault proxy for T4 classes 1–4 and 7–8, scheduled per run. Fixture hooks for 5 (hanging test), 6 (disk full via a small loop-mounted fs or `ulimit -f`), and 9 (SIGTERM then `run --resume`). | new `eval/faults/proxy.mjs`; task fixtures | PLAN-04 task 1 |\n| 6 | T4 smoke in `make test`: scripted model plus 2 fault cases. The T1 self-test stays. | `cli/test/eval_harness.test.ts`; `Makefile` | 5 |\n| 7 | Task schema `{repo, commit, prompt, hidden_tests, fail_to_pass, pass_to_pass, class, difficulty}`, with a validator. | `eval/tasks/schema.json`; `run.mjs` | — |\n| 8 | Author tasks (owner action X2). Development set: the existing 6 plus routing engx T01–T12. Held-out set: 40 T2 tasks, of which at least 20 are external, at least 6 per class, across 4 languages. Plus 8 T3 tasks. The sha256 manifest is committed before RC freeze. Calibrate on the development set only. | external store; `eval/heldout-manifest.json` | 7 |\n| 9 | Peer adapters: confirm Goose and OpenCode on the same model and budgets, and record peer versions. | `run.mjs:120-143` | 4 |\n| 10 | Mark `nexus eval` experimental (help and docs). Fix its operator-workspace checkout: run in a worktree (VER-07a). | `index.ts:663-688`; `evaluator.ts:128` | — |\n| 11 | M5 runs: T2 held-out (5×), T3 (5×), T4 (9×5), standalone subset (PLAN-05), provider verify (DEC-06). Archive everything under `docs/reviews/evidence/v1-qualification/<rc>/`. | runbook in ACCEPTANCE §4–§6 | all, RC build |\n| 13 | `eval/standalone/plain_proxy.mjs`: a forward proxy to the gateway. It injects the gateway token server-side. It strips `/v1/models` to `{id,object,owned_by}`, returns 404 for `/v1/tokenize`, and drops `X-AIHost-*` and admission headers. The `--emulate {llamacpp,vllm,ollama}` profiles add that server's `/models`, `/props`, `/api/show` and overflow-error shapes, derived from the real gateway limits. Unit-tested against a mock gateway. | new `eval/standalone/` | — |\n| 12 | Terminal matrix (manual): {xterm, kitty, tmux, VS Code, GNOME Terminal} × 3 sizes. Checklist per ACCEPTANCE §5.3. Archive screenshots. | ACCEPTANCE §5.3 | RC build |\n15:import { startGateway, Reply } from \"./helpers/fixtures.js\";\n98:// REQ-QUAL-110: T4 smoke in `make test` — faults injected by the harness's model proxy end truthfully.\n112:test(\"T4 smoke: an overloaded endpoint is waited out and the task still completes; the fault is recorded\", { timeout: 300_000 }, async () => {\n115:  assert.deepEqual(r.model.faultsInjected, [{ kind: \"overloaded\", atRequest: 1 }]);\n118:  assert.equal(score.faults.length, 9, \"the scorer always exposes all nine accepted T4 fault classes\");\n123:test(\"T4 smoke: a reply cut at the output limit is never run as a tool call, and the run ends truthfully\", { timeout: 300_000 }, async () => {\n126:  assert.equal(r.model.faultsInjected[0].kind, \"truncate\");\n214:  const task = path.join(tasks, \"qual-fixture\");\n215:  fs.mkdirSync(path.join(task, \"fixture\"), { recursive: true, mode: 0o700 });\n218:    id: \"qual-fixture\",\n220:    objective: \"Inspect the fixture\",\n221:    fixture: \"fixture\",\n239:    fingerprint: { weightsSha256: \"a\".repeat(64), serverBuild: \"fixture server\" },\n286:  const fingerprint = { alias: \"engineering/deep\", listed: true, ownedBy: \"fixture\", contextLength: 65536, weightsSha256: \"a\".repeat(64), serverBuild: \"llama.cpp b123\", sampling: { temperature: 0, seed: 17 } };\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a171fd-3278-7ca3-ad25-d2f716cb2b15","create_time":1792914214.7531674}},"metadata":{"client_authored":false,"fallback_token_li