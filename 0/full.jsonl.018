{"timestamp":"2026-10-25T08:00:04.509Z","ordinal":330591,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17211-7ad4-71c1-9c02-690a797dca89","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a17211-7ad4-71c1-9c02-690a797dca89","response_id":"resp_060b64278a9dfb15016addb6f6f12c81a0a253ce6a11148728","usage":{"input_tokens":139450,"cached_input_tokens":136320,"cache_write_input_tokens":0,"output_tokens":1642,"reasoning_output_tokens":1535,"total_tokens":141092},"turn_token_usage":{"input_tokens":1086605,"cached_input_tokens":1035264,"cache_write_input_tokens":0,"output_tokens":5519,"reasoning_output_tokens":4255,"total_tokens":1092124},"thread_token_usage":{"input_tokens":6028589473,"cached_input_tokens":5963999104,"cache_write_input_tokens":0,"output_tokens":17117193,"reasoning_output_tokens":9863243,"total_tokens":6045706666}}}
{"timestamp":"2026-10-25T08:00:06.754Z","ordinal":330592,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17211-7ad4-71c1-9c02-690a797dca89","item":{"type":"CommandExecution","id":"exec-8f5c7d33-b7e1-4f21-b743-5521e782ae6e","process_id":"23787","command":["/usr/bin/zsh","-lc","sed -n '1,180p' cli/test/eval_harness.test.ts; cat eval/configs/t1-selftest.json 2>/dev/null; sed -n '1,125p' eval/model_proxy.mjs"],"cwd":"file:///home/mike/nexus-wt/plan10-pr10c-t4","parsed_cmd":[{"type":"unknown","cmd":"sed -n '1,180p' cli/test/eval_harness.test.ts; cat eval/configs/t1-selftest.json 2>/dev/null; sed -n '1,125p' eval/model_proxy.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * The evaluation harness end to end against a scripted model (Stage 8, T1 smoke): fresh workspaces, hidden tests the\n * agent never sees, separate scores. The self-test task is the assessment's A1 case: a repository whose own suite is\n * green but never exercises the deliverable. A wrong deliverable must fail the hidden test and must never be VERIFIED.\n */\n\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, Reply } from \"./helpers/fixtures.js\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n\nasync function sealTestTasks(tasksDir: string, taskId: string) {\n  const { corpusTaskRows } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const rows = corpusTaskRows(tasksDir, [taskId]);\n  const manifestPath = path.join(tasksDir, \"custody-manifest.json\");\n  const manifest = { schemaVersion: 1, split: \"heldout\", custody: { status: \"approved\", custodian: \"synthetic-test-role\", approvedAt: \"2026-01-01T00:00:00Z\" }, tasks: rows };\n  const bytes = JSON.stringify(manifest);\n  fs.writeFileSync(manifestPath, bytes);\n  return { corpusManifest: manifestPath, corpusManifestSha256: createHash(\"sha256\").update(bytes).digest(\"hex\") };\n}\n\n/** Async: the scripted gateway answers from this process, so the runner must not block its event loop. */\nfunction runNode(argv: string[], env: NodeJS.ProcessEnv = process.env): Promise<{ status: number | null; stdout: string; stderr: string }> {\n  return new Promise((resolve) => {\n    const child = spawn(process.execPath, argv, { stdio: [\"ignore\", \"pipe\", \"pipe\"], env });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout.on(\"data\", (c) => (stdout += c));\n    child.stderr.on(\"data\", (c) => (stderr += c));\n    child.on(\"close\", (status) => resolve({ status, stdout, stderr }));\n  });\n}\n\nfunction writer(content: string) {\n  return (_n: number, body: any): Reply => {\n    const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n    if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"math.js\", content } }] };\n    if (tools === 1) return { kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary: \"math.js added\" } }] };\n    return { kind: \"text\", content: \"Done.\" };\n  };\n}\n\nasync function evaluate(content: string, extra: Record<string, unknown> = {}): Promise<{ records: any[]; score: any; hiddenLog: string; agentLog: string; agentError: string }> {\n  const gw = await startGateway(writer(content));\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-out-\"));\n  const out = path.join(root, \"run\");\n  const config = path.join(root, \"config.json\");\n  fs.writeFileSync(config, JSON.stringify({ name: \"nexus@mock\", agent: \"nexus\", endpoint: gw.url, model: \"m\", runs: 1, steps: 20, minutes: 5, ...extra }));\n  try {\n    const run = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(run.status, 0, `${run.stdout}\\n${run.stderr}`);\n    const records = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(out, \"results.jsonl\"), \"--json\"], { encoding: \"utf8\" });\n    assert.equal(scored.status, 0, scored.stderr);\n    const manifest = JSON.parse(fs.readFileSync(path.join(out, \"manifest.json\"), \"utf8\"));\n    assert.deepEqual(manifest.tasks.map((task: any) => task.id), [\"selftest-add\"]);\n    assert.match(manifest.harness.sourceSha256, /^[0-9a-f]{64}$/);\n    assert.match(manifest.configSha256, /^[0-9a-f]{64}$/);\n    const priorResults = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\");\n    const replay = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(replay.status, 2);\n    assert.match(replay.stderr, /output directory must be new/);\n    assert.equal(fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\"), priorResults, \"reusing an output directory changed prior evidence\");\n    assert.match(manifest.harness.string, /^[0-9a-f]{12}/);\n    const logDir = records[0].logs ? path.join(out, records[0].logs) : null;\n    const readLog = (file: string) => logDir && fs.existsSync(path.join(logDir, file)) ? fs.readFileSync(path.join(logDir, file), \"utf8\") : \"<not written>\";\n    return { records, score: JSON.parse(scored.stdout), hiddenLog: readLog(\"hidden.log\"), agentLog: readLog(\"agent.stdout.json\"), agentError: readLog(\"agent.stderr.log\") };\n  } finally {\n    await gw.close();\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n}\n\ntest(\"a correct deliverable passes the hidden test; a wrong one fails it and is never VERIFIED (A1)\", { timeout: 300_000 }, async () => {\n  const good = await evaluate(\"exports.add = (a, b) => a + b;\\n\");\n  assert.equal(good.records.length, 1);\n  assert.equal(good.records[0].hiddenPass, true, `${JSON.stringify(good.records[0])}\\nagent=${good.agentLog}\\nagent-error=${good.agentError}\\nhidden=${good.hiddenLog}`);\n  assert.equal(good.records[0].regressionPass, true);\n  assert.equal(good.records[0].falseVerified, false);\n\n  const wrong = await evaluate(\"exports.add = (a, b) => a - b;\\n\");\n  const r = wrong.records[0];\n  assert.equal(r.hiddenPass, false, \"the hidden test catches the wrong deliverable\");\n  assert.equal(r.regressionPass, true, \"the repository's own suite is still green\");\n  assert.notEqual(r.turn?.outcome, \"VERIFIED\", `an unrelated green suite does not verify it: ${JSON.stringify(r.turn)}`);\n  assert.equal(r.falseVerified, false);\n  assert.equal(wrong.score.totals.falseVerified, 0);\n  assert.equal(wrong.score.rows[0].correct, 0);\n});\n\n// REQ-QUAL-110: T4 smoke in `make test` — faults injected by the harness's model proxy end truthfully.\ntest(\"standalone profile context discovery is not overridden by the harness default\", async () => {\n  const { nexusContextLimitArgs } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\" }, 65536), []);\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\", limits: { context: 8192 } }, 65536), [\"--context-limit\", \"8192\"]);\n  assert.deepEqual(nexusContextLimitArgs({}, 65536), [\"--context-limit\", \"65536\"]);\n});\n\ntest(\"a standalone server-profile run discovers context instead of forcing the harness default\", { timeout: 300_000 }, async () => {\n  const result = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { serverProfile: \"llamacpp\" });\n  assert.equal(result.records[0].hiddenPass, true);\n  assert.ok(result.records[0].model.profileContextLookups > 0, \"llama.cpp context comes from the profile endpoint\");\n});\n\ntest(\"T4 smoke: an overloaded endpoint is waited out and the task still completes; the fault is recorded\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"overloaded\", atRequest: 1 }] });\n  const r = records[0];\n  assert.deepEqual(r.model.faultsInjected, [{ kind: \"overloaded\", atRequest: 1 }]);\n  assert.equal(r.hiddenPass, true, JSON.stringify(r.turn));\n  assert.equal(r.falseVerified, false);\n  assert.equal(score.faults.length, 9, \"the scorer always exposes all nine accepted T4 fault classes\");\n  assert.equal(score.t4.gate, \"FAIL\", \"one smoke fault is not a nine-class qualification\");\n  assert.deepEqual(score.faults.filter((f: any) => f.n > 0).map((f: any) => [f.kind, f.n, f.truthful, f.recovered]), [[\"overloaded\", 1, 1, 1]]);\n});\n\ntest(\"T4 smoke: a reply cut at the output limit is never run as a tool call, and the run ends truthfully\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"truncate\", atRequest: 1 }] });\n  const r = records[0];\n  assert.equal(r.model.faultsInjected[0].kind, \"truncate\");\n  assert.equal(r.falseVerified, false);\n  assert.ok(r.turn, \"the run produced its own result (no crash)\");\n  assert.equal(score.faults.find((fault: any) => fault.kind === \"truncate\").truthful, 1);\n});\n\ntest(\"peer run records the executable version and effective budget\", { timeout: 300_000 }, async () => {\n  const gw = await startGateway(() => ({ kind: \"text\", content: \"not used by the fake peer\" }));\n  const out = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-peer-out-\"));\n  const runOut = path.join(out, \"run\");\n  const bin = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-peer-bin-\"));\n  const config = path.join(out, \"config.json\");\n  const fakeOpenCode = path.join(bin, \"opencode\");\n  fs.writeFileSync(fakeOpenCode, `#!/usr/bin/env node\nif (process.argv.includes(\"--version\")) { console.log(\"OpenCode 9.8.7\"); process.exit(0); }\nconst cfg = JSON.parse(require(\"node:fs\").readFileSync(require(\"node:path\").join(process.env.HOME, \".config/opencode/opencode.json\"), \"utf8\"));\nrequire(\"node:fs\").writeFileSync(require(\"node:path\").join(process.cwd(), \"math.js\"), \"exports.add = (a, b) => a + b;\\\\n\");\nconsole.log(JSON.stringify({ observed: { agent: cfg.agent[\"nexus-eval\"], model: cfg.provider.gw.models.m } }));\nconsole.log(JSON.stringify({ turn: { execution: \"COMPLETED\", outcome: \"NOT_REQUIRED\", steps: { used: 1 } } }));\n`);\n  fs.chmodSync(fakeOpenCode, 0o755);\n  fs.writeFileSync(config, JSON.stringify({ name: \"opencode@mock\", agent: \"opencode\", endpoint: gw.url, model: \"m\", runs: 1, steps: 20, minutes: 5, sampling: { temperature: 0, seed: 17 } }));\n  try {\n    const env = { ...process.env, PATH: `${bin}${path.delimiter}${process.env.PATH ?? \"\"}` };\n    const run = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", runOut, \"--only\", \"selftest-add\"], env);\n    assert.equal(run.status, 0, `${run.stdout}\\n${run.stderr}`);\n    const manifest = JSON.parse(fs.readFileSync(path.join(runOut, \"manifest.json\"), \"utf8\"));\n    const record = JSON.parse(fs.readFileSync(path.join(runOut, \"results.jsonl\"), \"utf8\").trim());\n    assert.equal(manifest.agentVersion.agent, \"opencode\");\n    assert.equal(manifest.agentVersion.version, \"OpenCode 9.8.7\");\n    assert.equal(manifest.agentVersion.executablePath, fs.realpathSync(fakeOpenCode));\n    assert.match(manifest.agentVersion.executableSha256, /^[0-9a-f]{64}$/);\n    assert.deepEqual(record.agentVersion, manifest.agentVersion);\n    assert.deepEqual(record.budget, { steps: 20, minutes: 5 });\n    assert.equal(record.hiddenPass, true);\n    const stdout = fs.readFileSync(path.join(runOut, record.logs, \"agent.stdout.json\"), \"utf8\");\n    const observedConfig = stdout.split(/\\r?\\n/).filter(Boolean).map((line) => JSON.parse(line)).find((value) => value.observed).observed;\n    assert.equal(observedConfig.agent.steps, 20);\n    assert.deepEqual(observedConfig.model.options, { temperature: 0, seed: 17 });\n  } finally {\n    await gw.close();\n    fs.rmSync(out, { recursive: true, force: true });\n    fs.rmSync(bin, { recursive: true, force: true });\n  }\n});\n\ntest(\"Goose adapter applies the matched turn, context, output, and temperature budgets\", { timeout: 300_000 }, async () => {\n  const gw = await startGateway(() => ({ kind: \"text\", content: \"not used by the fake peer\" }));\n  const out = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-goose-out-\"));\n  const runOut = path.join(out, \"run\");\n  const bin = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-goose-bin-\"));\n  const config = path.join(out, \"config.json\");\n  const fakeGoose = path.join(bin, \"goose\");\n  fs.writeFileSync(fakeGoose, `#!/usr/bin/env node\nif (process.argv.includes(\"--version\")) { console.log(\"Goose 1.27.2\"); process.exit(0); }\n// A per-run forwarder between an agent and the model endpoint. Every agent reaches the model through it the same way,\n// so the harness itself observes whether the model was reachable during a run (REQ-QUAL-106): how many requests were\n// made, how many got an answer, and how many failed upstream (connection errors and 502/503/504 from the endpoint).\n// Bodies are streamed through unchanged unless a fault is scheduled for a request (T4, REQ-QUAL-105); nothing is\n// logged.\nimport http from \"node:http\";\nimport https from \"node:https\";\nimport fs from \"node:fs\";\nimport { timingSafeEqual } from \"node:crypto\";\n\nconst UPSTREAM_DOWN = new Set([502, 503, 504]);\n\n/**\n * Faults the proxy can inject into the Nth chat request of a run (SPEC-10 T4 classes it can produce itself):\n * - refuse: the connection is dropped without an answer (the endpoint went away mid-turn);\n * - overloaded: 503 with Retry-After: 1 (the endpoint is busy);\n * - stream_cut: the stream is cut after its first tool-call fragment (a transport drop inside a tool call);\n * - truncate: the reply is marked cut at the output limit (finish_reason \"length\");\n * - context_overflow: llama.cpp's context-overflow error (HTTP 400, exceed_context_size_error);\n * - malformed_tool_json: the first tool call's arguments are made invalid JSON.\n * The other T4 classes (a hanging test command, a full disk, SIGTERM then resume) come from task fixtures and the runner.\n */\nexport const FAULT_KINDS = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n\n/**\n * Standalone profiles (DEC-16, REQ-PRV-106): the agent sees a plain OpenAI-compatible server instead of the gateway.\n * Every gateway extension is removed (limits and capabilities in /models, /tokenize, X-AIHost-* headers). An emulated\n * profile also answers as that server would about its context (llama.cpp /props, Ollama /api/show, vLLM max_model_len)\n * and reshapes context-overflow errors into its format; the numbers are the gateway's real ones.\n */\nexport const PROFILES = [\"plain\", \"llamacpp\", \"vllm\", \"ollama\"];\nconst OWNER = { plain: \"organization\", llamacpp: \"llamacpp\", vllm: \"vllm\", ollama: \"library\" };\n\nfunction profileModel(profile, entry) {\n  const ctx = entry.context_length ?? entry.max_model_len ?? null;\n  const base = { id: entry.id, object: \"model\", owned_by: OWNER[profile] };\n  if (profile === \"llamacpp\" && ctx) return { ...base, meta: { n_ctx_train: ctx } };\n  if (profile === \"vllm\" && ctx) return { ...base, max_model_len: ctx };\n  return base;\n}\n\nfunction overflowBody(profile, ctx) {\n  if (profile === \"llamacpp\") return { error: { code: 400, message: \"the request exceeds the available context size, try increasing it\", type: \"exceed_context_size_error\", n_ctx: ctx } };\n  if (profile === \"vllm\") return { object: \"error\", message: `This model's maximum context length is ${ctx ?? \"unknown\"} tokens. However, you requested more tokens.`, type: \"BadRequestError\", code: 400 };\n  return { error: { message: \"This request exceeds the model's maximum context length.\", type: \"invalid_request_error\", code: \"context_length_exceeded\" } };\n}\n\n/** Rewrites an SSE body as it passes, chunk by chunk; `edit` returns the text to forward (or null to cut the stream). */\nfunction rewriteStream(upstreamRes, res, edit) {\n  let pending = \"\";\n  upstreamRes.setEncoding(\"utf8\");\n  upstreamRes.on(\"data\", (chunk) => {\n    pending += chunk;\n    const events = pending.split(\"\\n\\n\");\n    pending = events.pop() ?? \"\";\n    for (const event of events) {\n      const out = edit(event);\n      if (out === null) {\n        res.socket?.destroy();\n        upstreamRes.destroy();\n        return;\n      }\n      res.write(`${out}\\n\\n`);\n    }\n  });\n  upstreamRes.on(\"end\", () => {\n    if (pending) res.write(edit(pending) ?? \"\");\n    res.end();\n  });\n}\n\n/**\n * Starts a forwarder on 127.0.0.1 for `upstream` (e.g. https://gateway:8443/v1). `faults`: [{ kind, atRequest }] where\n * atRequest counts chat requests from 1. Returns its base URL (same path as the upstream), live counters, and close().\n */\nexport async function startModelProxy({ upstream, caFile, faults = [], profile, authToken, clientToken, socketPath, maxRequests = 1_000, maxConcurrentRequests = 1, maxRequestBytes = 1_000_000, maxCompletionTokens, maxTotalCompletionTokens }) {\n  if (profile !== undefined && !PROFILES.includes(profile)) throw new Error(`unknown profile ${profile}; one of ${PROFILES.join(\", \")}`);\n  if (!Number.isSafeInteger(maxRequests) || maxRequests < 1 || !Number.isSafeInteger(maxConcurrentRequests) || maxConcurrentRequests < 1 || !Number.isSafeInteger(maxRequestBytes) || maxRequestBytes < 1) throw new Error(\"invalid evaluation proxy request limits\");\n  if (maxCompletionTokens !== undefined && (!Number.isSafeInteger(maxCompletionTokens) || maxCompletionTokens < 1)) throw new Error(\"invalid per-request completion-token limit\");\n  if (maxTotalCompletionTokens !== undefined && (!Number.isSafeInteger(maxTotalCompletionTokens) || maxTotalCompletionTokens < 1)) throw new Error(\"invalid aggregate completion-token limit\");\n  for (const f of faults) {\n    if (!FAULT_KINDS.includes(f.kind) || !Number.isInteger(f.atRequest) || f.atRequest < 1) throw new Error(`invalid fault ${JSON.stringify(f)}`);\n  }\n  const target = new URL(upstream);\n  const basePath = target.pathname.replace(/\\/$/, \"\");\n  const allowedRoutes = new Map([\n    [\"GET /models\", \"catalog\"],\n    [\"POST /chat/completions\", \"inference\"],\n    [\"POST /responses\", \"inference\"],\n    [\"POST /messages\", \"inference\"],\n  ]);\n  const client = target.protocol === \"https:\" ? https : http;\n  const ca = caFile ? fs.readFileSync(caFile) : undefined;\n  const stats = { requests: 0, chatRequests: 0, activeInferenceRequests: 0, cancelledRequests: 0, profileContextLookups: 0, requestedCompletionTokens: 0, answered: 0, upstreamFailures: 0, faultsInjected: [], firstRequestAt: null, firstAnswerAt: null };\n\n  /** The upstream /models entries (for an emulated profile's context answers). */\n  const upstreamModels = () => new Promise((resolve) => {\n    const r = client.request({ protocol: target.protocol, hostname: target.hostname, port: target.port || (target.protocol === \"https:\" ? 443 : 80), method: \"GET\", path: `${target.pathname.replace(/\\/$/, \"\")}/models`, headers: { host: target.host, ...(authToken ? { authorization: `Bearer ${authToken}` } : {}) }, ca }, (res) => {\n      let body = \"\";\n      res.setEncoding(\"utf8\");\n      res.on(\"data\", (c) => (body += c));\n      res.on(\"end\", () => { try { resolve(JSON.parse(body).data ?? []); } catch { resolve([]); } });\n    });\n    r.on(\"error\", () => resolve([]));\n    r.end();\n  });\n  const firstContext = async () => { const m = (await upstreamModels())[0]; return m?.context_length ?? m?.max_model_len ?? null; };\n  const sendJson = (res, status, body) => { res.writeHead(status, { \"content-type\": \"application/json\" }); res.end(JSON.stringify(body)); };\n\n  const server = http.createServer(async (req, res) => {\n    stats.requests++;\n    if (clientToken) {\n      const supplied = /^Bearer (.+)$/.exec(String(req.headers.authorization ?? \"\"))?.[1] ?? \"\";\n      const expected = Buffer.from(clientToken);\n      const actual = Buffer.from(supplied);\n      if (actual.length !== expected.length || !timingSafeEqual(actual, expected)) {\n        req.resume();\n        return void sendJson(res, 401, { error: { type: \"authentication_error\", message: \"evaluation proxy authentication failed\" } });\n      }\n    }\n    const urlPath = (req.url ?? \"\").split(\"?\")[0];\n    const relativePath = urlPath.startsWith(`${basePath}/`) ? urlPath.slice(basePath.length) : null;\n    const routeKind = relativePath === null ? null : allowedRoutes.get(`${req.method} ${relativePath}`);\n    const localProfileRoute = Boolean(profile && ((profile === \"llamacpp\" && req.method === \"GET\" && urlPath === \"/props\") || (profile === \"ollama\" && req.method === \"POST\" && urlPath === \"/api/show\") || urlPath.endsWith(\"/tokenize\")));\n    if (!routeKind && !localProfileRoute) {\n","exit_code":0,"duration":{"secs":0,"nanos":996497615}},"started_at_ms":1792915205757,"completed_at_ms":1792915206754}}
{"timestamp":"2026-10-25T08:00:08.810Z","ordinal":330593,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17212-fa6a-7dd0-9b88-b264c438958f","call_id":"call_5722f5692f8c445ab1e07ae07dddf54e","output":[{"type":"input_text","text":"Script completed\nWall time 4.3 seconds\nOutput:\n"},{"type":"input_text","text":"/**\n * The evaluation harness end to end against a scripted model (Stage 8, T1 smoke): fresh workspaces, hidden tests the\n * agent never sees, separate scores. The self-test task is the assessment's A1 case: a repository whose own suite is\n * green but never exercises the deliverable. A wrong deliverable must fail the hidden test and must never be VERIFIED.\n */\n\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, Reply } from \"./helpers/fixtures.js\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n\nasync function sealTestTasks(tasksDir: string, taskId: string) {\n  const { corpusTaskRows } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const rows = corpusTaskRows(tasksDir, [taskId]);\n  const manifestPath = path.join(tasksDir, \"custody-manifest.json\");\n  const manifest = { schemaVersion: 1, split: \"heldout\", custody: { status: \"approved\", custodian: \"synthetic-test-role\", approvedAt: \"2026-01-01T00:00:00Z\" }, tasks: rows };\n  const bytes = JSON.stringify(manifest);\n  fs.writeFileSync(manifestPath, bytes);\n  return { corpusManifest: manifestPath, corpusManifestSha256: createHash(\"sha256\").update(bytes).digest(\"hex\") };\n}\n\n/** Async: the scripted gateway answers from this process, so the runner must not block its event loop. */\nfunction runNode(argv: string[], env: NodeJS.ProcessEnv = process.env): Promise<{ status: number | null; stdout: string; stderr: string }> {\n  return new Promise((resolve) => {\n    const child = spawn(process.execPath, argv, { stdio: [\"ignore\", \"pipe\", \"pipe\"], env });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout.on(\"data\", (c) => (stdout += c));\n    child.stderr.on(\"data\", (c) => (stderr += c));\n    child.on(\"close\", (status) => resolve({ status, stdout, stderr }));\n  });\n}\n\nfunction writer(content: string) {\n  return (_n: number, body: any): Reply => {\n    const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n    if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"math.js\", content } }] };\n    if (tools === 1) return { kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary: \"math.js added\" } }] };\n    return { kind: \"text\", content: \"Done.\" };\n  };\n}\n\nasync function evaluate(content: string, extra: Record<string, unknown> = {}): Promise<{ records: any[]; score: any; hiddenLog: string; agentLog: string; agentError: string }> {\n  const gw = await startGateway(writer(content));\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-out-\"));\n  const out = path.join(root, \"run\");\n  const config = path.join(root, \"config.json\");\n  fs.writeFileSync(config, JSON.stringify({ name: \"nexus@mock\", agent: \"nexus\", endpoint: gw.url, model: \"m\", runs: 1, steps: 20, minutes: 5, ...extra }));\n  try {\n    const run = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(run.status, 0, `${run.stdout}\\n${run.stderr}`);\n    const records = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(out, \"results.jsonl\"), \"--json\"], { encoding: \"utf8\" });\n    assert.equal(scored.status, 0, scored.stderr);\n    const manifest = JSON.parse(fs.readFileSync(path.join(out, \"manifest.json\"), \"utf8\"));\n    assert.deepEqual(manifest.tasks.map((task: any) => task.id), [\"selftest-add\"]);\n    assert.match(manifest.harness.sourceSha256, /^[0-9a-f]{64}$/);\n    assert.match(manifest.configSha256, /^[0-9a-f]{64}$/);\n    const priorResults = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\");\n    const replay = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(replay.status, 2);\n    assert.match(replay.stderr, /output directory must be new/);\n    assert.equal(fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\"), priorResults, \"reusing an output directory changed prior evidence\");\n    assert.match(manifest.harness.string, /^[0-9a-f]{12}/);\n    const logDir = records[0].logs ? path.join(out, records[0].logs) : null;\n    const readLog = (file: string) => logDir && fs.existsSync(path.join(logDir, file)) ? fs.readFileSync(path.join(logDir, file), \"utf8\") : \"<not written>\";\n    return { records, score: JSON.parse(scored.stdout), hiddenLog: readLog(\"hidden.log\"), agentLog: readLog(\"agent.stdout.json\"), agentError: readLog(\"agent.stderr.log\") };\n  } finally {\n    await gw.close();\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n}\n\ntest(\"a correct deliverable passes the hidden test; a wrong one fails it and is never VERIFIED (A1)\", { timeout: 300_000 }, async () => {\n  const good = await evaluate(\"exports.add = (a, b) => a + b;\\n\");\n  assert.equal(good.records.length, 1);\n  assert.equal(good.records[0].hiddenPass, true, `${JSON.stringify(good.records[0])}\\nagent=${good.agentLog}\\nagent-error=${good.agentError}\\nhidden=${good.hiddenLog}`);\n  assert.equal(good.records[0].regressionPass, true);\n  assert.equal(good.records[0].falseVerified, false);\n\n  const wrong = await evaluate(\"exports.add = (a, b) => a - b;\\n\");\n  const r = wrong.records[0];\n  assert.equal(r.hiddenPass, false, \"the hidden test catches the wrong deliverable\");\n  assert.equal(r.regressionPass, true, \"the repository's own suite is still green\");\n  assert.notEqual(r.turn?.outcome, \"VERIFIED\", `an unrelated green suite does not verify it: ${JSON.stringify(r.turn)}`);\n  assert.equal(r.falseVerified, false);\n  assert.equal(wrong.score.totals.falseVerified, 0);\n  assert.equal(wrong.score.rows[0].correct, 0);\n});\n\n// REQ-QUAL-110: T4 smoke in `make test` — faults injected by the harness's model proxy end truthfully.\ntest(\"standalone profile context discovery is not overridden by the harness default\", async () => {\n  const { nexusContextLimitArgs } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\" }, 65536), []);\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\", limits: { context: 8192 } }, 65536), [\"--context-limit\", \"8192\"]);\n  assert.deepEqual(nexusContextLimitArgs({}, 65536), [\"--context-limit\", \"65536\"]);\n});\n\ntest(\"a standalone server-profile run discovers context instead of forcing the harness default\", { timeout: 300_000 }, async () => {\n  const result = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { serverProfile: \"llamacpp\" });\n  assert.equal(result.records[0].hiddenPass, true);\n  assert.ok(result.records[0].model.profileContextLookups > 0, \"llama.cpp context comes from the profile endpoint\");\n});\n\ntest(\"T4 smoke: an overloaded endpoint is waited out and the task still completes; the fault is recorded\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"overloaded\", atRequest: 1 }] });\n  const r = records[0];\n  assert.deepEqual(r.model.faultsInjected, [{ kind: \"overloaded\", atRequest: 1 }]);\n  assert.equal(r.hiddenPass, true, JSON.stringify(r.turn));\n  assert.equal(r.falseVerified, false);\n  assert.equal(score.faults.length, 9, \"the scorer always exposes all nine accepted T4 fault classes\");\n  assert.equal(score.t4.gate, \"FAIL\", \"one smoke fault is not a nine-class qualification\");\n  assert.deepEqual(score.faults.filter((f: any) => f.n > 0).map((f: any) => [f.kind, f.n, f.truthful, f.recovered]), [[\"overloaded\", 1, 1, 1]]);\n});\n\ntest(\"T4 smoke: a reply cut at the output limit is never run as a tool call, and the run ends truthfully\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"truncate\", atRequest: 1 }] });\n  const r = records[0];\n  assert.equal(r.model.faultsInjected[0].kind, \"truncate\");\n  assert.equal(r.falseVerified, false);\n  assert.ok(r.turn, \"the run produced its own result (no crash)\");\n  assert.equal(score.faults.find((fault: any) => fault.kind === \"truncate\").truthful, 1);\n});\n\ntest(\"peer run records the executable version and effective budget\", { timeout: 300_000 }, async () => {\n  const gw = await startGateway(() => ({ kind: \"text\", content: \"not used by the fake peer\" }));\n  const out = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-peer-out-\"));\n  const runOut = path.join(out, \"run\");\n  const bin = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-peer-bin-\"));\n  const config = path.join(out, \"config.json\");\n  const fakeOpenCode = path.join(bin, \"opencode\");\n  fs.writeFileSync(fakeOpenCode, `#!/usr/bin/env node\nif (process.argv.includes(\"--version\")) { console.log(\"OpenCode 9.8.7\"); process.exit(0); }\nconst cfg = JSON.parse(require(\"node:fs\").readFileSync(require(\"node:path\").join(process.env.HOME, \".config/opencode/opencode.json\"), \"utf8\"));\nrequire(\"node:fs\").writeFileSync(require(\"node:path\").join(process.cwd(), \"math.js\"), \"exports.add = (a, b) => a + b;\\\\n\");\nconsole.log(JSON.stringify({ observed: { agent: cfg.agent[\"nexus-eval\"], model: cfg.provider.gw.models.m } }));\nconsole.log(JSON.stringify({ turn: { execution: \"COMPLETED\", outcome: \"NOT_REQUIRED\", steps: { used: 1 } } }));\n`);\n  fs.chmodSync(fakeOpenCode, 0o755);\n  fs.writeFileSync(config, JSON.stringify({ name: \"opencode@mock\", agent: \"opencode\", endpoint: gw.url, model: \"m\", runs: 1, steps: 20, minutes: 5, sampling: { temperature: 0, seed: 17 } }));\n  try {\n    const env = { ...process.env, PATH: `${bin}${path.delimiter}${process.env.PATH ?? \"\"}` };\n    const run = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", runOut, \"--only\", \"selftest-add\"], env);\n    assert.equal(run.status, 0, `${run.stdout}\\n${run.stderr}`);\n    const manifest = JSON.parse(fs.readFileSync(path.join(runOut, \"manifest.json\"), \"utf8\"));\n    const record = JSON.parse(fs.readFileSync(path.join(runOut, \"results.jsonl\"), \"utf8\").trim());\n    assert.equal(manifest.agentVersion.agent, \"opencode\");\n    assert.equal(manifest.agentVersion.version, \"OpenCode 9.8.7\");\n    assert.equal(manifest.agentVersion.executablePath, fs.realpathSync(fakeOpenCode));\n    assert.match(manifest.agentVersion.executableSha256, /^[0-9a-f]{64}$/);\n    assert.deepEqual(record.agentVersion, manifest.agentVersion);\n    assert.deepEqual(record.budget, { steps: 20, minutes: 5 });\n    assert.equal(record.hiddenPass, true);\n    const stdout = fs.readFileSync(path.join(runOut, record.logs, \"agent.stdout.json\"), \"utf8\");\n    const observedConfig = stdout.split(/\\r?\\n/).filter(Boolean).map((line) => JSON.parse(line)).find((value) => value.observed).observed;\n    assert.equal(observedConfig.agent.steps, 20);\n    assert.deepEqual(observedConfig.model.options, { temperature: 0, seed: 17 });\n  } finally {\n    await gw.close();\n    fs.rmSync(out, { recursive: true, force: true });\n    fs.rmSync(bin, { recursive: true, force: true });\n  }\n});\n\ntest(\"Goose adapter applies the matched turn, context, output, and temperature budgets\", { timeout: 300_000 }, async () => {\n  const gw = await startGateway(() => ({ kind: \"text\", content: \"not used by the fake peer\" }));\n  const out = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-goose-out-\"));\n  const runOut = path.join(out, \"run\");\n  const bin = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-goose-bin-\"));\n  const config = path.join(out, \"config.json\");\n  const fakeGoose = path.join(bin, \"goose\");\n  fs.writeFileSync(fakeGoose, `#!/usr/bin/env node\nif (process.argv.includes(\"--version\")) { console.log(\"Goose 1.27.2\"); process.exit(0); }\n// A per-run forwarder between an agent and the model endpoint. Every agent reaches the model through it the same way,\n// so the harness itself observes whether the model was reachable during a run (REQ-QUAL-106): how many requests were\n// made, how many got an answer, and how many failed upstream (connection errors and 502/503/504 from the endpoint).\n// Bodies are streamed through unchanged unless a fault is scheduled for a request (T4, REQ-QUAL-105); nothing is\n// logged.\nimport http from \"node:http\";\nimport https from \"node:https\";\nimport fs from \"node:fs\";\nimport { timingSafeEqual } from \"node:crypto\";\n\nconst UPSTREAM_DOWN = new Set([502, 503, 504]);\n\n/**\n * Faults the proxy can inject into the Nth chat request of a run (SPEC-10 T4 classes it can produce itself):\n * - refuse: the connection is dropped without an answer (the endpoint went away mid-turn);\n * - overloaded: 503 with Retry-After: 1 (the endpoint is busy);\n * - stream_cut: the stream is cut after its first tool-call fragment (a transport drop inside a tool call);\n * - truncate: the reply is marked cut at the output limit (finish_reason \"length\");\n * - context_overflow: llama.cpp's context-overflow error (HTTP 400, exceed_context_size_error);\n * - malformed_tool_json: the first tool call's arguments are made invalid JSON.\n * The other T4 classes (a hanging test command, a full disk, SIGTERM then resume) come from task fixtures and the runner.\n */\nexport const FAULT_KINDS = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n\n/**\n * Standalone profiles (DEC-16, REQ-PRV-106): the agent sees a plain OpenAI-compatible server instead of the gateway.\n * Every gateway extension is removed (limits and capabilities in /models, /tokenize, X-AIHost-* headers). An emulated\n * profile also answers as that server would about its context (llama.cpp /props, Ollama /api/show, vLLM max_model_len)\n * and reshapes context-overflow errors into its format; the numbers are the gateway's real ones.\n */\nexport const PROFILES = [\"plain\", \"llamacpp\", \"vllm\", \"ollama\"];\nconst OWNER = { plain: \"organization\", llamacpp: \"llamacpp\", vllm: \"vllm\", ollama: \"library\" };\n\nfunction profileModel(profile, entry) {\n  const ctx = entry.context_length ?? entry.max_model_len ?? null;\n  const base = { id: entry.id, object: \"model\", owned_by: OWNER[profile] };\n  if (profile === \"llamacpp\" && ctx) return { ...base, meta: { n_ctx_train: ctx } };\n  if (profile === \"vllm\" && ctx) return { ...base, max_model_len: ctx };\n  return base;\n}\n\nfunction overflowBody(profile, ctx) {\n  if (profile === \"llamacpp\") return { error: { code: 400, message: \"the request exceeds the available context size, try increasing it\", type: \"exceed_context_size_error\", n_ctx: ctx } };\n  if (profile === \"vllm\") return { object: \"error\", message: `This model's maximum context length is ${ctx ?? \"unknown\"} tokens. However, you requested more tokens.`, type: \"BadRequestError\", code: 400 };\n  return { error: { message: \"This request exceeds the model's maximum context length.\", type: \"invalid_request_error\", code: \"context_length_exceeded\" } };\n}\n\n/** Rewrites an SSE body as it passes, chunk by chunk; `edit` returns the text to forward (or null to cut the stream). */\nfunction rewriteStream(upstreamRes, res, edit) {\n  let pending = \"\";\n  upstreamRes.setEncoding(\"utf8\");\n  upstreamRes.on(\"data\", (chunk) => {\n    pending += chunk;\n    const events = pending.split(\"\\n\\n\");\n    pending = events.pop() ?? \"\";\n    for (const event of events) {\n      const out = edit(event);\n      if (out === null) {\n        res.socket?.destroy();\n        upstreamRes.destroy();\n        return;\n      }\n      res.write(`${out}\\n\\n`);\n    }\n  });\n  upstreamRes.on(\"end\", () => {\n    if (pending) res.write(edit(pending) ?? \"\");\n    res.end();\n  });\n}\n\n/**\n * Starts a forwarder on 127.0.0.1 for `upstream` (e.g. https://gateway:8443/v1). `faults`: [{ kind, atRequest }] where\n * atRequest counts chat requests from 1. Returns its base URL (same path as the upstream), live counters, and close().\n */\nexport async function startModelProxy({ upstream, caFile, faults = [], profile, authToken, clientToken, socketPath, maxRequests = 1_000, maxConcurrentRequests = 1, maxRequestBytes = 1_000_000, maxCompletionTokens, maxTotalCompletionTokens }) {\n  if (profile !== undefined && !PROFILES.includes(profile)) throw new Error(`unknown profile ${profile}; one of ${PROFILES.join(\", \")}`);\n  if (!Number.isSafeInteger(maxRequests) || maxRequests < 1 || !Number.isSafeInteger(maxConcurrentRequests) || maxConcurrentRequests < 1 || !Number.isSafeInteger(maxRequestBytes) || maxRequestBytes < 1) throw new Error(\"invalid evaluation proxy request limits\");\n  if (maxCompletionTokens !== undefined && (!Number.isSafeInteger(maxCompletionTokens) || maxCompletionTokens < 1)) throw new Error(\"invalid per-request completion-token limit\");\n  if (maxTotalCompletionTokens !== undefined && (!Number.isSafeInteger(maxTotalCompletionTokens) || maxTotalCompletionTokens < 1)) throw new Error(\"invalid aggregate completion-token limit\");\n  for (const f of faults) {\n    if (!FAULT_KINDS.includes(f.kind) || !Number.isInteger(f.atRequest) || f.atRequest < 1) throw new Error(`invalid fault ${JSON.stringify(f)}`);\n  }\n  const target = new URL(upstream);\n  const basePath = target.pathname.replace(/\\/$/, \"\");\n  const allowedRoutes = new Map([\n    [\"GET /models\", \"catalog\"],\n    [\"POST /chat/completions\", \"inference\"],\n    [\"POST /responses\", \"inference\"],\n    [\"POST /messages\", \"inference\"],\n  ]);\n  const client = target.protocol === \"https:\" ? https : http;\n  const ca = caFile ? fs.readFileSync(caFile) : undefined;\n  const stats = { requests: 0, chatRequests: 0, activeInferenceRequests: 0, cancelledRequests: 0, profileContextLookups: 0, requestedCompletionTokens: 0, answered: 0, upstreamFailures: 0, faultsInjected: [], firstRequestAt: null, firstAnswerAt: null };\n\n  /** The upstream /models entries (for an emulated profile's context answers). */\n  const upstreamModels = () => new Promise((resolve) => {\n    const r = client.request({ protocol: target.protocol, hostname: target.hostname, port: target.port || (target.protocol === \"https:\" ? 443 : 80), method: \"GET\", path: `${target.pathname.replace(/\\/$/, \"\")}/models`, headers: { host: target.host, ...(authToken ? { authorization: `Bearer ${authToken}` } : {}) }, ca }, (res) => {\n      let body = \"\";\n      res.setEncoding(\"utf8\");\n      res.on(\"data\", (c) => (body += c));\n      res.on(\"end\", () => { try { resolve(JSON.parse(body).data ?? []); } catch { resolve([]); } });\n    });\n    r.on(\"error\", () => resolve([]));\n    r.end();\n  });\n  const firstContext = async () => { const m = (await upstreamModels())[0]; return m?.context_length ?? m?.max_model_len ?? null; };\n  const sendJson = (res, status, body) => { res.writeHead(status, { \"content-type\": \"application/json\" }); res.end(JSON.stringify(body)); };\n\n  const server = http.createServer(async (req, res) => {\n    stats.requests++;\n    if (clientToken) {\n      const supplied = /^Bearer (.+)$/.exec(String(req.headers.authorization ?? \"\"))?.[1] ?? \"\";\n      const expected = Buffer.from(clientToken);\n      const actual = Buffer.from(supplied);\n      if (actual.length !== expected.length || !timingSafeEqual(actual, expected)) {\n        req.resume();\n        return void sendJson(res, 401, { error: { type: \"authentication_error\", message: \"evaluation proxy authentication failed\" } });\n      }\n    }\n    const urlPath = (req.url ?? \"\").split(\"?\")[0];\n    const relativePath = urlPath.startsWith(`${basePath}/`) ? urlPath.slice(basePath.length) : null;\n    const routeKind = relativePath === null ? null : allowedRoutes.get(`${req.method} ${relativePath}`);\n    const localProfileRoute = Boolean(profile && ((profile === \"llamacpp\" && req.method === \"GET\" && urlPath === \"/props\") || (profile === \"ollama\" && req.method === \"POST\" && urlPath === \"/api/show\") || urlPath.endsWith(\"/tokenize\")));\n    if (!routeKind && !localProfileRoute) {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17211-7ad4-71c1-9c02-690a797dca89","create_time":1792915208.81026}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
