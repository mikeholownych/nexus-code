Oid\":\"4e0aeb140f4e9c20aea4443768bc106e88593130\",\"isDraft\":false,\"number\":115,\"title\":\"build(deps-dev): bump @cloudflare/vite-plugin from 2.0.0-beta.sha-52b0dc0e9 to 2.0.0-beta.v.1 in /experiments/cloudflare-artifacts-vertical-slice/agent-collab-worker\",\"updatedAt\":\"2026-10-21T23:19:25Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/115\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/npm_and_yarn/cli/commander-15.0.0\",\"headRefOid\":\"e0b5db3201eff965b7e9d31d13b9bc72e8317dbb\",\"isDraft\":false,\"number\":114,\"title\":\"chore(deps): bump commander from 12.1.0 to 15.0.0 in /cli\",\"updatedAt\":\"2026-10-23T17:58:54Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/114\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/cargo/core/serde_json-1.0.154\",\"headRefOid\":\"b11ec547a7ae9f44f51f9699d0619426a603f89e\",\"isDraft\":false,\"number\":113,\"title\":\"build(deps): bump serde_json from 1.0.151 to 1.0.154 in /core\",\"updatedAt\":\"2026-10-21T16:08:12Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/113\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/github_actions/actions/setup-node-7.1.0\",\"headRefOid\":\"dae77e4ecc23468facad0bb1bb3f1442b75055d6\",\"isDraft\":false,\"number\":112,\"title\":\"build(deps): bump actions/setup-node from 4.4.0 to 7.1.0\",\"updatedAt\":\"2026-10-24T04:23:43Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/112\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/npm_and_yarn/cli/dotenv-18.0.8\",\"headRefOid\":\"bb8f56e4f6343ebee54ab79ba73975e4062ba46f\",\"isDraft\":false,\"number\":111,\"title\":\"build(deps): bump dotenv from 16.6.1 to 18.0.8 in /cli\",\"updatedAt\":\"2026-10-21T16:04:30Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/111\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/cargo/core/libc-0.2.191\",\"headRefOid\":\"d70302124870dae35a4e33bfa536f782bc174cde\",\"isDraft\":false,\"number\":110,\"title\":\"ch