{"timestamp":"2026-10-25T08:36:39.192Z","ordinal":332576,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","item":{"type":"CommandExecution","id":"exec-b3e004b7-4948-4b0c-9105-aa2bf67fa728","process_id":"46427","command":["/usr/bin/zsh","-lc","sed -n '460,625p' cli/src/core/spine.ts; sed -n '4070,4155p' cli/src/agent.ts; sed -n '1,145p' cli/src/types.ts; sed -n '1,220p' eval/agent_sandbox.mjs; sed -n '1,190p' eval/run.mjs"],"cwd":"file:///home/mike/nexus-wt/plan10-pr10c-t4","parsed_cmd":[{"type":"read","cmd":"sed -n '460,625p' cli/src/core/spine.ts","name":"spine.ts","path":"cli/src/core/spine.ts"},{"type":"read","cmd":"sed -n '4070,4155p' cli/src/agent.ts","name":"agent.ts","path":"cli/src/agent.ts"},{"type":"read","cmd":"sed -n '1,145p' cli/src/types.ts","name":"types.ts","path":"cli/src/types.ts"},{"type":"read","cmd":"sed -n '1,220p' eval/agent_sandbox.mjs","name":"agent_sandbox.mjs","path":"eval/agent_sandbox.mjs"},{"type":"read","cmd":"sed -n '1,190p' eval/run.mjs","name":"run.mjs","path":"eval/run.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"        durationMs: 0,\n        candidateMutated: false,\n        status: \"FAILED\",\n        timestamp: new Date().toISOString(),\n        simulated: Boolean(context.dryRun),\n      };\n      await this.hooks.evidenceEmission(receipt);\n      return receipt;\n    }\n\n    // Stage 4: Pre-Execution Hooks\n    let effectiveArgs = request.args;\n    try {\n      const egressDecision = await this.hooks.egressQuarantine(request, context);\n      if (!egressDecision.allowed) {\n        const receipt: ExecutionReceipt = {\n          invocationId,\n          taskId,\n          actor,\n          executionDomain,\n          capabilityId: capability.id,\n          toolName,\n          targetResources,\n          success: false,\n          output: \"\",\n          error: egressDecision.reason || \"Egress quarantine gate blocked invocation.\",\n          durationMs: 0,\n          candidateMutated: false,\n          status: \"DENIED\",\n          timestamp: new Date().toISOString(),\n          simulated: Boolean(context.dryRun),\n        };\n        await this.hooks.evidenceEmission(receipt);\n        return receipt;\n      }\n      if (egressDecision.sanitizedArgs) {\n        effectiveArgs = egressDecision.sanitizedArgs;\n      }\n\n      await this.hooks.processLifecycle(\n        {\n          stage: \"start\",\n          invocationId,\n          toolName,\n          command: effectiveArgs.command,\n        },\n        context\n      );\n    } catch (err: any) {\n      const receipt: ExecutionReceipt = {\n        invocationId,\n        taskId,\n        actor,\n        executionDomain,\n        capabilityId: capability.id,\n        toolName,\n        targetResources,\n        success: false,\n        output: \"\",\n        error: `FAIL-001: Pre-execution hook exception: ${err.message}`,\n        durationMs: 0,\n        candidateMutated: false,\n        status: \"FAILED\",\n        timestamp: new Date().toISOString(),\n        simulated: Boolean(context.dryRun),\n      };\n      await this.hooks.evidenceEmission(receipt);\n      return receipt;\n    }\n\n    // Stage 5: Capability Dispatch\n    const t0 = Date.now();\n    let result: ExecutionResult;\n    try {\n      const handler =\n        this.handlers.get(toolName) ||\n        this.registry.getHandler(toolName) ||\n        capability.handler;\n\n      if (handler) {\n        result = await handler(effectiveArgs, context);\n      } else if (context.defaultHandler) {\n        result = await context.defaultHandler(toolName, effectiveArgs, context);\n      } else if (context.bridge && typeof context.bridge.executeTool === \"function\") {\n        result = await context.bridge.executeTool(toolName, effectiveArgs);\n      } else {\n        result = {\n          success: false,\n          output: \"\",\n          error: `No execution handler registered for capability '${capability.id}' (tool '${toolName}').`,\n        };\n      }\n    } catch (err: any) {\n      result = {\n        success: false,\n        output: \"\",\n        error: `FAIL-001: Invocation exception in '${toolName}': ${err?.message || String(err)}`,\n      };\n    }\n    const durationMs = Date.now() - t0;\n\n    try {\n      await this.hooks.processLifecycle(\n        {\n          stage: \"exit\",\n          invocationId,\n          toolName,\n          exitCode: result.success ? 0 : 1,\n          error: result.error,\n        },\n        context\n      );\n    } catch {\n      // Degraded-mode per FAIL-003: lifecycle notification error does not overwrite tool outcome\n    }\n\n    // Stage 6: Post-Execution Evidence & Receipt Generation\n    const candidateMutated = Boolean(\n      result.success && changesWorkspace(capability) && !context.dryRun\n    );\n\n    if (candidateMutated) {\n      try {\n        await this.hooks.candidateMutation(\n          {\n            invocationId,\n            toolName,\n            mutatedPaths: targetResources,\n            durationMs,\n          },\n          context\n        );\n      } catch {\n        // Degraded-mode per FAIL-003\n      }\n    }\n\n    const receipt: ExecutionReceipt = {\n      invocationId,\n      taskId,\n      actor,\n      executionDomain,\n      capabilityId: capability.id,\n      toolName,\n      targetResources,\n      success: result.success,\n      output: result.output || \"\",\n      error: result.error,\n      durationMs,\n      candidateMutated,\n      status: result.success ? \"COMPLETED\" : \"FAILED\",\n      timestamp: new Date().toISOString(),\n      simulated: Boolean(context.dryRun),\n    };\n\n    try {\n      await this.hooks.evidenceEmission(receipt);\n    } catch {\n      // Degraded-mode per FAIL-003\n    }\n\n    return receipt;\n  }\n}\n          success: true,\n          output: subResult.summary,\n        };\n      } catch (subErr: any) {\n        this.ui.stopSpinner(false);\n        return {\n          success: false,\n          output: \"\",\n          error: `Subagent failed with error: ${subErr.message}`,\n        };\n      } finally {\n        if (subagent) {\n          const subStats = subagent.getTokenStats();\n          this.totalTokens.prompt += subStats.prompt;\n          this.totalTokens.completion += subStats.completion;\n          this.totalTokens.total += subStats.total;\n          this.totalTokens.requests += subStats.requests;\n          this.totalTokens.reportedRequests += subStats.reportedRequests;\n          this.totalTokens.estimatedRequests += subStats.estimatedRequests;\n\n          // The child's workspace changes are this turn's changes: the parent's own completion must verify them.\n          const childMutations = subagent.turnMutations;\n          if (childMutations > 0 || subagent.turnCarriedChanges) {\n            this.mutationSeq += subagent.mutationSeq;\n            this.turnMutations += childMutations;\n            this.verificationEvidence = undefined;\n            if (this.objective) {\n              invalidateVerified(this.objective, `subagent changed workspace`);\n            }\n            this.setUnverifiedChanges(true);\n          }\n          subagent.shutdown();\n        }\n      }\n    });\n\n    this.spine.registerHandler(\"hybrid_search\", async (args) => {\n      try {\n        const matches = await this.hybridSearch.search(args.query || \"\", {\n          mode: args.mode,\n          path: args.path,\n          limit: args.limit ? parseInt(args.limit, 10) : 10,\n        });\n        return {\n          success: true,\n          output: JSON.stringify(\n            { query: args.query, totalMatches: matches.length, matches },\n            null,\n            2\n          ),\n        };\n      } catch (err: any) {\n        return { success: false, output: \"\", error: err.message };\n      }\n    });\n\n    this.spine.registerHandler(\"browser_navigate\", async (args) => {\n      try {\n        const nav = await this.browser.navigate(args.url || \"\");\n        return { success: true, output: JSON.stringify(nav, null, 2) };\n      } catch (err: any) {\n        return {\n          success: false,\n          output: \"\",\n          error: `Error executing browser_navigate: ${err.message}`,\n        };\n      }\n    });\n\n    this.spine.registerHandler(\"browser_screenshot\", async (args) => {\n      try {\n        const shot = await this.browser.screenshot(args.output_path);\n        return {\n          success: true,\n          output: JSON.stringify(\n            { path: shot.path, width: shot.width, height: shot.height },\n            null,\n            2\n          ),\n        };\n      } catch (err: any) {\n        return {\n          success: false,\n          output: \"\",\n          error: `Error executing browser_screenshot: ${err.message}`,\n        };\nexport interface FunctionCall {\n  name: string;\n  arguments: string;\n}\n\nexport interface ToolCall {\n  id: string;\n  type: \"function\";\n  function: FunctionCall;\n}\n\nexport interface ChatMessage {\n  role: \"system\" | \"user\" | \"assistant\" | \"tool\";\n  content?: string | null | any[];\n  tool_calls?: ToolCall[];\n  tool_call_id?: string;\n  name?: string;\n  /**\n   * Opaque provider-owned replay state (reasoning signatures / encrypted reasoning items). Never sent to any provider\n   * other than `owner` (\"<provider>:<model>\"); `digest` detects alteration (e.g. by persistence redaction).\n   */\n  provider_state?: { owner: string; items: any[]; digest: string };\n}\n\nexport interface ToolParameterProperty {\n  type: string;\n  description?: string;\n  enum?: string[];\n  items?: Record<string, unknown>;\n}\n\nexport interface ToolDefinition {\n  type: \"function\";\n  function: {\n    name: string;\n    description: string;\n    parameters: {\n      type: \"object\";\n      properties: Record<string, ToolParameterProperty>;\n      required?: string[];\n    };\n  };\n}\n\nexport interface HarnessConfig {\n  endpoint: string;          // e.g. \"http://localhost:1234/v1\" (LM Studio) or \"http://localhost:8000/v1\" (vLLM)\n  model: string;             // e.g. \"qwen2.5-coder-32b-instruct\"\n  apiKey?: string;           // Optional for local servers (defaults to \"local\")\n  maxSteps: number;          // Steps per segment (default 30). With `continuation` (the default), a segment boundary is a durable checkpoint, never the end of the task.\n  /**\n   * Automatic continuation past `maxSteps` while the work makes progress (see AutonomousAgent.runTurn). Absent:\n   * `maxSteps` ends the turn (LIMIT_REACHED), the legacy single-segment behaviour.\n   */\n  continuation?: ContinuationBudget;\n  temperature: number;       // Default 0.2 for precise coding\n  workspace: string;         // Working directory for tools\n  shell: string;             // Linux shell: \"bash\", \"zsh\", \"sh\" (default: \"bash\")\n  coreBinaryPath?: string;   // Path to compiled harness-core executable\n  dryRun?: boolean;          // Dry-run simulation mode without persisting file modifications\n  readOnly?: boolean;        // Reject all mutating tool executions and commands\n  approvalMode?: \"auto\" | \"review\" | \"read-only\"; // Permission posture: auto, review, or read-only (DEC-01, independent of folder trust)\n  yes?: boolean;             // Run non-interactively without confirmation prompts (forces auto mode)\n  fullAccess?: boolean;      // Broad full-access mode executing without confirmation prompts (AUTH-007, AUTH-008)\n  taskClass?: string;        // Routing hint sent to the gateway as X-Task-Class (e.g. \"review\", \"architecture\")\n  plannerTaskClass?: string; // Same, for the planner client\n  fallbackEndpoints?: string[]; // Failover endpoint URLs if primary endpoint is unavailable\n  pinEndpoint?: boolean;     // Use only `endpoint` (no fallbacks): the operation scheduler owns resource selection\n  credentialOrigin?: string;     // Origin apiKey belongs to (default: endpoint's origin); never sent elsewhere\n  contextLimit?: number;     // Maximum model context window token limit (default: 65536)\n  completionReserveTokens?: number; // Context reserved for each model completion (default: 8192)\n  toolResponseReserveTokens?: number; // Tool-output headroom policy for the following tool results (default: min(4096, context/8))\n  /**\n   * Operator opt-in: refuse a request that could not be counted on a worker by the connection's request counting.\n   * Off by default: without it an unmeasured request proceeds on the labelled client estimate (provider_capabilities.ts).\n   */\n  strictTokenCount?: boolean;\n  sandbox?: boolean | string; // Linux namespace / bwrap / container isolation (default: false)\n  worktree?: boolean;        // Isolated ephemeral git worktree execution (default: false)\n  authoritativeVerifierCommand?: string; // Explicit trusted verifier: gates every task completion and authorizes automatic worktree merge\n  /** Workspace-relative deliverable paths declared by the operator before the task starts. */\n  trustedDeliverableFiles?: string[];\n  verifierTimeoutSecs?: number; // Deadline for the completion verifier (default 300); env NEXUS_VERIFIER_TIMEOUT_SECS\n  recordFlight?: boolean;    // Deterministic .flightlog session recording (default: false)\n  plannerModel?: string;     // Deep reasoning / architecture planner (e.g. Claude 3.7 Thinking / o3 / DeepSeek R1)\n  plannerEndpoint?: string;  // Dedicated endpoint for planner model\n  plannerApiKey?: string;    // API key for planner model\n  coderModel?: string;       // Ultra-fast surgical implementation model (e.g. Qwen 2.5 Coder 32B @ 150 tok/s)\n  coderEndpoint?: string;    // Dedicated endpoint for coder model\n  coderApiKey?: string;      // API key for coder model\n  tdd?: boolean;             // Enforce strict RED-GREEN-REFACTOR protocol\n  role?: \"researcher\" | \"architect\" | \"implementer\" | \"tester\" | \"reviewer\"; // Specialized agent role\n  provider?: string;         // Cloud provider id (see providers.ts); undefined = the appliance/endpoint path\n  plannerProvider?: string;  // Provider for the planner role; undefined inherits the rules in agent.ts\n  coderProvider?: string;    // Provider for the coder role\n  /** Origins the operator authorized to receive task content when they are cloud destinations. */\n  authorizedDisclosureOrigins?: string[];\n  /** Origins that look local but forward to a cloud service (treated as cloud disclosure). */\n  cloudRoutedOrigins?: string[];\n  /** Execution surface: 'repl', 'tui', or 'headless' (REQ-AGT-109a). */\n  surface?: \"repl\" | \"tui\" | \"headless\" | string;\n  reasoningEffort?: string;  // OpenAI Responses reasoning effort; enables owner-scoped reasoning replay\n  anthropicThinkingBudget?: number; // Anthropic extended-thinking budget tokens; enables signed thinking replay\n}\n\nexport interface ExecutionResult {\n  success: boolean;\n  output: string;\n  error?: string;\n  /** The operation's deadline expired before an answer was received (bridge-level; the runner reports its own via `timed_out`). */\n  timedOut?: boolean;\n  /** The operator's cancel ended the operation (the runner ended the command's process group). */\n  cancelled?: boolean;\n}\n\n/**\n * How an automatically continued turn ends. Progressing work has no step or time ceiling by default: it ends on\n * completion, cancellation, demonstrated lack of progress, or an actionable failure. A step or time limit applies\n * only when the operator sets one explicitly; each limit has its own termination reason.\n */\nexport interface ContinuationBudget {\n  /** Operator-set total steps for one turn (STEP_BUDGET_EXHAUSTED); Infinity (the default) when none was set. */\n  maxTotalSteps: number;\n  /** Operator-set wall-clock minutes for one turn (TIME_BUDGET_EXHAUSTED); Infinity (the default) when none was set. */\n  maxTurnMinutes: number;\n  /**\n   * Consecutive steps without observed progress before the turn stops (STAGNATION_DETECTED). A repeated-state\n   * threshold, not a task length: any progressing step resets it (core/execution_tracking.ts defines progress).\n   */\n  stagnationSteps: number;\n  /** Recovery notes the agent may inject for a repeated identical action before stopping (bounded recovery). */\n  maxRecoveries: number;\n  /** Times the agent may be asked to continue when it stops with acceptance requirements still open. */\n  maxCompletionNudges: number;\n}\n\nexport const DEFAULT_CONTINUATION: ContinuationBudget = {\n  maxTotalSteps: Number.POSITIVE_INFINITY,\n  maxTurnMinutes: Number.POSITIVE_INFINITY,\n  stagnationSteps: 12,\n  maxRecoveries: 2,\n  maxCompletionNudges: 2,\n};\n\nexport type ApprovalMode = \"auto\" | \"review\" | \"read-only\";\n// Runs one evaluation candidate behind a namespace-local TCP endpoint and a host-side Unix-socket proxy.\n// The candidate sees only the run-scoped local token; the upstream gateway credential stays in run.mjs.\nimport http from \"node:http\";\nimport { spawn } from \"node:child_process\";\nimport { StringDecoder } from \"node:string_decoder\";\n\n// The launch payload is the first stdin line. With payload.protocol the rest of stdin is the agent's stdin (the T3\n// sidecar protocol); otherwise the agent gets no stdin.\nconst payload = JSON.parse(await readPayloadLine());\nconst port = 40127; // private to this network namespace; no host listener uses this port\nconst server = http.createServer((req, res) => {\n  const upstream = http.request({ socketPath: \"/run/eval-proxy/proxy.sock\", agent: new http.Agent({ keepAlive: false }), method: req.method, path: req.url, headers: { ...req.headers, host: \"eval-proxy\", connection: \"close\" } }, (response) => {\n    res.writeHead(response.statusCode ?? 502, response.headers);\n    response.pipe(res);\n    response.once(\"end\", () => upstream.destroy());\n  });\n  upstream.on(\"error\", (error) => {\n    if (!res.headersSent) res.writeHead(502, { \"content-type\": \"application/json\" });\n    res.end(JSON.stringify({ error: { type: \"proxy_unavailable\", message: \"evaluation proxy unavailable\" } }));\n  });\n  req.pipe(upstream);\n});\nawait new Promise((resolve, reject) => {\n  server.once(\"error\", reject);\n  server.listen(port, \"127.0.0.1\", resolve);\n});\n\nconst endpoint = `http://127.0.0.1:${port}/v1`;\nconst env = { ...payload.env };\nfor (const [key, value] of Object.entries(env)) {\n  if (typeof value === \"string\") env[key] = value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint);\n}\nconst argv = payload.argv.map((value) => value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint));\nconst agent = spawn(payload.command, argv, { cwd: \"/workspace\", env, stdio: [payload.protocol ? \"pipe\" : \"ignore\", \"inherit\", \"inherit\"] });\nif (payload.protocol) {\n  agent.stdin.on(\"error\", () => {});\n  process.stdin.pipe(agent.stdin);\n  process.stdin.resume();\n}\nlet stopping = false;\nconst stop = (signal) => {\n  if (stopping) return;\n  stopping = true;\n  try { process.kill(-agent.pid, signal); } catch { agent.kill(signal); }\n};\nprocess.on(\"SIGTERM\", () => stop(\"SIGTERM\"));\nprocess.on(\"SIGINT\", () => stop(\"SIGINT\"));\nagent.on(\"error\", (error) => {\n  process.stderr.write(`candidate spawn failed: ${error.message}\\n`);\n  closeBridge(127);\n});\nagent.on(\"close\", (code, signal) => {\n  closeBridge(code ?? (signal ? 128 : 1));\n});\n\n/** Reads stdin up to the first newline (or its end); anything after the newline is put back for the agent. */\nfunction readPayloadLine() {\n  return new Promise((resolve, reject) => {\n    let body = \"\";\n    const decoder = new StringDecoder(\"utf8\");\n    const onData = (chunk) => {\n      body += decoder.write(chunk);\n      if (body.length > 1_000_000) { cleanup(); reject(new Error(\"sandbox launch payload too large\")); return; }\n      const newline = body.indexOf(\"\\n\");\n      if (newline < 0) return;\n      cleanup();\n      process.stdin.pause();\n      const rest = body.slice(newline + 1);\n      if (rest) process.stdin.unshift(Buffer.from(rest, \"utf8\"));\n      resolve(body.slice(0, newline));\n    };\n    const onEnd = () => { cleanup(); resolve(body); };\n    const cleanup = () => { process.stdin.off(\"data\", onData); process.stdin.off(\"end\", onEnd); process.stdin.off(\"error\", reject); };\n    process.stdin.on(\"data\", onData);\n    process.stdin.on(\"end\", onEnd);\n    process.stdin.on(\"error\", reject);\n  });\n}\n\nfunction closeBridge(exitCode) {\n  process.exitCode = exitCode;\n  server.closeAllConnections?.();\n  server.close();\n}\n#!/usr/bin/env node\n// Runs evaluation tasks against an agent configuration and appends one JSON line per run (see eval/README.md).\n// Each run gets a fresh workspace (the task's repository at its pinned commit, or its fixture), the agent runs with the\n// task's budgets and a wall-clock timeout, then the task's hidden tests (never present while the agent runs) and its\n// regression command are run in that workspace. Nothing is scored here: eval/score.mjs reads the JSON lines.\nimport { spawnSync } from \"node:child_process\";\nimport { createHash, randomBytes } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { startModelProxy } from \"./model_proxy.mjs\";\nimport { asUserSpec, corpusManifestProblem, corpusTaskRows, fetchModelEntry, hiddenTestIsolationProblem, modelFingerprint, nexusContextLimitArgs, nexusLimitsProblem, qualificationBudgetProblem, runtimeCorpusOverlapProblem, taskTreeDigest, validateTask } from \"./validate.mjs\";\nimport { agentSandboxArgv, assertNoSymlinks, confinedPath, grantRunAsAccess, hiddenOutputHasTests, isolatedProcessArgv, normalizeRunAsPermissions, runIsolated, runIsolatedProcess, sandboxAvailable, stageHiddenFiles } from \"./isolate.mjs\";\nimport { runBlackBoxOracle } from \"./oracle.mjs\";\nimport { stageRepoWorkspace } from \"./workspace.mjs\";\nimport { applyAgentChanges, cloneWorkspace } from \"./hardened_check.mjs\";\nimport { containmentProblem, resourceProbeProblem, spawnContained } from \"./resources.mjs\";\nimport { StringDecoder } from \"node:string_decoder\";\nimport { commandBaseline, countCompactions, createT3Driver, scoreT3Run, steeringBaseline, steeringPrecondition, t3Snapshot } from \"./t3.mjs\";\nimport { observeT4Fixture } from \"./t4_fixtures.mjs\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst args = parseArgs(process.argv.slice(2));\nif (args.out) args.out = path.resolve(args.out); // agents run elsewhere: paths handed to them must be absolute\nif (!args.config || !args.out) {\n  console.error(\"usage: eval/run.mjs --config eval/configs/<name>.json --out <dir> [--tasks eval/tasks] [--only id,id] [--runs N]\");\n  process.exit(2);\n}\nconst configBytes = fs.readFileSync(args.config);\nconst configSha256 = createHash(\"sha256\").update(configBytes).digest(\"hex\");\nconst config = JSON.parse(configBytes.toString(\"utf8\"));\nconst tasksDir = path.resolve(args.tasks ?? path.join(ROOT, \"eval/tasks\"));\nfunction custodyCorpusPathsForRun() {\n  return [\n    config.corpusCustody?.reportPath,\n    config.corpusCustody?.storeRoot,\n    config.corpusCustody?.validatorPath,\n    config.corpusCustody?.referencePath,\n    config.corpusCustody?.authorLogPath,\n  ].filter(Boolean);\n}\nfunction protectedCorpusPathsForRun() {\n  const parent = path.dirname(tasksDir);\n  const evalDir = path.join(ROOT, \"eval\");\n  const includeParent = config.qualification === true || fs.realpathSync(parent) !== fs.realpathSync(evalDir);\n  return [tasksDir, ...(includeParent ? [parent] : []), ...custodyCorpusPathsForRun()];\n}\nconst runs = Number(args.runs ?? config.runs ?? 1);\nconst only = args.only ? new Set(String(args.only).split(\",\")) : null;\n// --pairs \"task run,task run\": rerun exactly these (runs that failed on infrastructure; see eval/infra.mjs).\nconst pairs = args.pairs ? String(args.pairs).split(\",\").filter(Boolean).map((p) => p.trim().split(/\\s+/)) : null;\nfs.mkdirSync(path.dirname(args.out), { recursive: true });\ntry {\n  fs.mkdirSync(args.out, { mode: 0o700 });\n  fs.chmodSync(args.out, 0o700);\n} catch (error) {\n  if (error.code === \"EEXIST\") {\n    console.error(\"eval/run.mjs: output directory must be new; refusing to overwrite or append to prior evidence\");\n    process.exit(2);\n  }\n  throw error;\n}\nconst resultsFile = path.join(args.out, \"results.jsonl\");\n\nconst identity = harnessIdentity();\nconst availableTaskIds = fs.readdirSync(tasksDir).filter((d) => {\n  const entry = path.join(tasksDir, d);\n  try { return fs.lstatSync(entry).isDirectory() && fs.existsSync(path.join(entry, \"task.json\")); }\n  catch { return false; }\n}).sort();\nconst tasks = availableTaskIds.filter((d) => !only || only.has(d));\nconst taskSnapshots = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-task-snapshot-\"));\nfs.chmodSync(taskSnapshots, 0o700);\nprocess.on(\"exit\", () => fs.rmSync(taskSnapshots, { recursive: true, force: true }));\nconst taskRecords = [];\nfor (const id of tasks) {\n  const source = confinedPath(tasksDir, id);\n  assertNoSymlinks(source);\n  const before = taskTreeDigest(source);\n  const snapshot = path.join(taskSnapshots, id);\n  fs.cpSync(source, snapshot, { recursive: true, verbatimSymlinks: true });\n  if (taskTreeDigest(snapshot) !== before) throw new Error(`task ${id} changed while the runner froze its input`);\n  const taskFile = confinedPath(snapshot, \"task.json\");\n  taskRecords.push({ id, dir: snapshot, treeSha256: before, task: JSON.parse(fs.readFileSync(taskFile, \"utf8\")) });\n}\nif (config.qualification === true && only) {\n  console.error(\"eval/run.mjs: qualification task subsets are forbidden; use a frozen corpus run or an explicitly recorded infrastructure-pair rerun\");\n  process.exit(2);\n}\nif (config.qualification === true && config.proxy === false) {\n  console.error(\"eval/run.mjs: qualification requires the authenticated per-run model proxy\");\n  process.exit(2);\n}\nif (!sandboxAvailable()) {\n  console.error(\"eval/run.mjs: Bubblewrap unavailable; refusing to execute task-controlled setup and validators\");\n  process.exit(2);\n}\nconst apiKey = readApiKey(config.apiKey);\nconst caFile = config.caFile ? expandHome(config.caFile) : null;\nconst caBundle = caFile ? writeCaBundle(caFile) : null;\n\n// A run is valid only with well-formed tasks, hidden tests the agent cannot read, and (for qualification) a model\n// identified beyond its alias. Any problem stops the run before an agent starts (eval/validate.mjs).\nconst problems = taskRecords.flatMap(({ id, dir, task }) => {\n  return validateTask(task, dir, { qualification: config.qualification === true }).map((p) => `${id}: ${p}`);\n});\nconst isolation = hiddenTestIsolationProblem(config, tasksDir);\nif (isolation) problems.push(isolation);\n// Qualification proves the resource contract inside hiddenTestIsolationProblem; a development config may opt in.\nif (config.resources !== undefined && config.qualification !== true) {\n  const resourceProblem = resourceProbeProblem(config.resources);\n  if (resourceProblem) problems.push(resourceProblem);\n}\nif (config.resources !== undefined && args.keep) problems.push(\"--keep would accumulate run workspaces on the size-capped resources.workspaceRoot\");\nif (config.qualification === true) {\n  const corpusProblem = corpusManifestProblem(config, tasksDir, tasks, corpusTaskRows(taskSnapshots, tasks));\n  if (corpusProblem) problems.push(corpusProblem);\n}\nif (config.qualification === true && config.sampling?.temperature !== 0) {\n  problems.push(\"qualification adapters require sampling.temperature=0 so the matched Nexus, Goose and OpenCode runs use the same deterministic setting\");\n}\nif (config.qualification === true) {\n  const budgetProblem = qualificationBudgetProblem(config);\n  if (budgetProblem) problems.push(budgetProblem);\n}\nconst agentIdentity = problems.length ? { record: null, problem: null } : await resolveAgentIdentity(config);\nif (agentIdentity.problem) problems.push(agentIdentity.problem);\nlet fingerprint = null;\nif (!problems.length) {\n  const probe = config.proxy === false ? null : await startModelProxy({ upstream: config.endpoint, caFile });\n  try {\n    const entry = await fetchModelEntry(probe?.url ?? config.endpoint, config.model, apiKey);\n    const fp = modelFingerprint(config, entry);\n    fingerprint = fp.fingerprint;\n    problems.push(...fp.missing.map((m) => `model fingerprint: ${m}`));\n    if (config.qualification === true && (config.agent ?? \"nexus\") === \"nexus\") {\n      const limitsProblem = nexusLimitsProblem(config, entry);\n      if (limitsProblem) problems.push(limitsProblem);\n    }\n  } finally {\n    await probe?.close();\n  }\n}\nif (problems.length) {\n  console.error(`eval/run.mjs: not starting; ${problems.length} problem(s):\\n${problems.map((p) => `  - ${p}`).join(\"\\n\")}`);\n  process.exit(2);\n}\nconst frozenTaskRows = taskRecords.map(({ id }) => corpusTaskRows(taskSnapshots, [id])[0]);\nfs.writeFileSync(path.join(args.out, \"manifest.json\"), JSON.stringify({\n  createdAt: new Date().toISOString(),\n  harness: identity,\n  config: redactConfig(config),\n  configSha256,\n  qualificationCorpus: config.qualification === true ? { manifestSha256: config.corpusManifestSha256, tasks: frozenTaskRows } : null,\n  fingerprint,\n  agentVersion: agentIdentity.record,\n  budget: effectiveBudget({}, config),\n  runs,\n  tasks: frozenTaskRows,\n  host: os.hostname(),\n  node: process.version,\n}, null, 2) + \"\\n\");\n\n// Run-major order (every task once, then again): a pass cut short still has the same number of runs per task.\nfor (let run = 1; run <= runs; run++) {\n  for (const { id, dir, treeSha256, task: taskData } of taskRecords) {\n    if (pairs && !pairs.some(([t, r]) => t === id && Number(r) === run)) continue;\n    if (taskTreeDigest(dir) !== treeSha256) throw new Error(`frozen task ${id} changed after manifest creation`);\n    const task = { ...taskData, dir };\n    const record = await runOnce(task, run);\n    fs.appendFileSync(resultsFile, JSON.stringify(record) + \"\\n\");\n    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\n  }\n}\n\nasync function runOnce(task, run) {\n  // Under the resource contract these are on a tmpfs, so candidate writes count against the run's memory limit.\n  const scratch = config.resources?.workspaceRoot ?? os.tmpdir();\n  const ws = fs.mkdtempSync(path.join(scratch, `nexus-eval-${task.id}-`));\n  const checkDirs = [];\n  const home = fs.mkdtempSync(path.join(scratch, \"nexus-eval-home-\"));\n  const budget = effectiveBudget(task, config);\n  const base = { task: task.id, tier: task.tier, ...(task.tier === \"T3\" ? { t3SteeringItems: task.steering.length } : {}), config: config.name, agent: config.agent ?? \"nexus\", agentVersion: agentIdentity.record, budget, run, harness: identity.string, model: config.model, startedAt: new Date().toISOString() };\n  try {\n    await prepareWorkspace(task, ws);\n    // Taken now, while .git is the harness's own: after the agent runs, nothing executes git against its workspace.\n    const baselineTree = gitRev(ws, \"HEAD^{tree}\");\n    const t3Baseline = task.tier === \"T3\" ? steeringBaseline(task, ws) : null;\n    // On the per-run task copy, so the steering hook in runAgent can read it. The commands run on a throwaway copy of\n","exit_code":0,"duration":{"secs":0,"nanos":931139565}},"started_at_ms":1792917398260,"completed_at_ms":1792917399191}}
{"timestamp":"2026-10-25T08:36:40.874Z","ordinal":332577,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17234-6d2a-72a0-801e-f4e7fa780108","call_id":"call_58a37071a1e8447ba396cb48c2005f94","output":[{"type":"input_text","text":"Script completed\nWall time 3.7 seconds\nOutput:\n"},{"type":"input_text","text":"        durationMs: 0,\n        candidateMutated: false,\n        status: \"FAILED\",\n        timestamp: new Date().toISOString(),\n        simulated: Boolean(context.dryRun),\n      };\n      await this.hooks.evidenceEmission(receipt);\n      return receipt;\n    }\n\n    // Stage 4: Pre-Execution Hooks\n    let effectiveArgs = request.args;\n    try {\n      const egressDecision = await this.hooks.egressQuarantine(request, context);\n      if (!egressDecision.allowed) {\n        const receipt: ExecutionReceipt = {\n          invocationId,\n          taskId,\n          actor,\n          executionDomain,\n          capabilityId: capability.id,\n          toolName,\n          targetResources,\n          success: false,\n          output: \"\",\n          error: egressDecision.reason || \"Egress quarantine gate blocked invocation.\",\n          durationMs: 0,\n          candidateMutated: false,\n          status: \"DENIED\",\n          timestamp: new Date().toISOString(),\n          simulated: Boolean(context.dryRun),\n        };\n        await this.hooks.evidenceEmission(receipt);\n        return receipt;\n      }\n      if (egressDecision.sanitizedArgs) {\n        effectiveArgs = egressDecision.sanitizedArgs;\n      }\n\n      await this.hooks.processLifecycle(\n        {\n          stage: \"start\",\n          invocationId,\n          toolName,\n          command: effectiveArgs.command,\n        },\n        context\n      );\n    } catch (err: any) {\n      const receipt: ExecutionReceipt = {\n        invocationId,\n        taskId,\n        actor,\n        executionDomain,\n        capabilityId: capability.id,\n        toolName,\n        targetResources,\n        success: false,\n        output: \"\",\n        error: `FAIL-001: Pre-execution hook exception: ${err.message}`,\n        durationMs: 0,\n        candidateMutated: false,\n        status: \"FAILED\",\n        timestamp: new Date().toISOString(),\n        simulated: Boolean(context.dryRun),\n      };\n      await this.hooks.evidenceEmission(receipt);\n      return receipt;\n    }\n\n    // Stage 5: Capability Dispatch\n    const t0 = Date.now();\n    let result: ExecutionResult;\n    try {\n      const handler =\n        this.handlers.get(toolName) ||\n        this.registry.getHandler(toolName) ||\n        capability.handler;\n\n      if (handler) {\n        result = await handler(effectiveArgs, context);\n      } else if (context.defaultHandler) {\n        result = await context.defaultHandler(toolName, effectiveArgs, context);\n      } else if (context.bridge && typeof context.bridge.executeTool === \"function\") {\n        result = await context.bridge.executeTool(toolName, effectiveArgs);\n      } else {\n        result = {\n          success: false,\n          output: \"\",\n          error: `No execution handler registered for capability '${capability.id}' (tool '${toolName}').`,\n        };\n      }\n    } catch (err: any) {\n      result = {\n        success: false,\n        output: \"\",\n        error: `FAIL-001: Invocation exception in '${toolName}': ${err?.message || String(err)}`,\n      };\n    }\n    const durationMs = Date.now() - t0;\n\n    try {\n      await this.hooks.processLifecycle(\n        {\n          stage: \"exit\",\n          invocationId,\n          toolName,\n          exitCode: result.success ? 0 : 1,\n          error: result.error,\n        },\n        context\n      );\n    } catch {\n      // Degraded-mode per FAIL-003: lifecycle notification error does not overwrite tool outcome\n    }\n\n    // Stage 6: Post-Execution Evidence & Receipt Generation\n    const candidateMutated = Boolean(\n      result.success && changesWorkspace(capability) && !context.dryRun\n    );\n\n    if (candidateMutated) {\n      try {\n        await this.hooks.candidateMutation(\n          {\n            invocationId,\n            toolName,\n            mutatedPaths: targetResources,\n            durationMs,\n          },\n          context\n        );\n      } catch {\n        // Degraded-mode per FAIL-003\n      }\n    }\n\n    const receipt: ExecutionReceipt = {\n      invocationId,\n      taskId,\n      actor,\n      executionDomain,\n      capabilityId: capability.id,\n      toolName,\n      targetResources,\n      success: result.success,\n      output: result.output || \"\",\n      error: result.error,\n      durationMs,\n      candidateMutated,\n      status: result.success ? \"COMPLETED\" : \"FAILED\",\n      timestamp: new Date().toISOString(),\n      simulated: Boolean(context.dryRun),\n    };\n\n    try {\n      await this.hooks.evidenceEmission(receipt);\n    } catch {\n      // Degraded-mode per FAIL-003\n    }\n\n    return receipt;\n  }\n}\n          success: true,\n          output: subResult.summary,\n        };\n      } catch (subErr: any) {\n        this.ui.stopSpinner(false);\n        return {\n          success: false,\n          output: \"\",\n          error: `Subagent failed with error: ${subErr.message}`,\n        };\n      } finally {\n        if (subagent) {\n          const subStats = subagent.getTokenStats();\n          this.totalTokens.prompt += subStats.prompt;\n          this.totalTokens.completion += subStats.completion;\n          this.totalTokens.total += subStats.total;\n          this.totalTokens.requests += subStats.requests;\n          this.totalTokens.reportedRequests += subStats.reportedRequests;\n          this.totalTokens.estimatedRequests += subStats.estimatedRequests;\n\n          // The child's workspace changes are this turn's changes: the parent's own completion must verify them.\n          const childMutations = subagent.turnMutations;\n          if (childMutations > 0 || subagent.turnCarriedChanges) {\n            this.mutationSeq += subagent.mutationSeq;\n            this.turnMutations += childMutations;\n            this.verificationEvidence = undefined;\n            if (this.objective) {\n              invalidateVerified(this.objective, `subagent changed workspace`);\n            }\n            this.setUnverifiedChanges(true);\n          }\n          subagent.shutdown();\n        }\n      }\n    });\n\n    this.spine.registerHandler(\"hybrid_search\", async (args) => {\n      try {\n        const matches = await this.hybridSearch.search(args.query || \"\", {\n          mode: args.mode,\n          path: args.path,\n          limit: args.limit ? parseInt(args.limit, 10) : 10,\n        });\n        return {\n          success: true,\n          output: JSON.stringify(\n            { query: args.query, totalMatches: matches.length, matches },\n            null,\n            2\n          ),\n        };\n      } catch (err: any) {\n        return { success: false, output: \"\", error: err.message };\n      }\n    });\n\n    this.spine.registerHandler(\"browser_navigate\", async (args) => {\n      try {\n        const nav = await this.browser.navigate(args.url || \"\");\n        return { success: true, output: JSON.stringify(nav, null, 2) };\n      } catch (err: any) {\n        return {\n          success: false,\n          output: \"\",\n          error: `Error executing browser_navigate: ${err.message}`,\n        };\n      }\n    });\n\n    this.spine.registerHandler(\"browser_screenshot\", async (args) => {\n      try {\n        const shot = await this.browser.screenshot(args.output_path);\n        return {\n          success: true,\n          output: JSON.stringify(\n            { path: shot.path, width: shot.width, height: shot.height },\n            null,\n            2\n          ),\n        };\n      } catch (err: any) {\n        return {\n          success: false,\n          output: \"\",\n          error: `Error executing browser_screenshot: ${err.message}`,\n        };\nexport interface FunctionCall {\n  name: string;\n  arguments: string;\n}\n\nexport interface ToolCall {\n  id: string;\n  type: \"function\";\n  function: FunctionCall;\n}\n\nexport interface ChatMessage {\n  role: \"system\" | \"user\" | \"assistant\" | \"tool\";\n  content?: string | null | any[];\n  tool_calls?: ToolCall[];\n  tool_call_id?: string;\n  name?: string;\n  /**\n   * Opaque provider-owned replay state (reasoning signatures / encrypted reasoning items). Never sent to any provider\n   * other than `owner` (\"<provider>:<model>\"); `digest` detects alteration (e.g. by persistence redaction).\n   */\n  provider_state?: { owner: string; items: any[]; digest: string };\n}\n\nexport interface ToolParameterProperty {\n  type: string;\n  description?: string;\n  enum?: string[];\n  items?: Record<string, unknown>;\n}\n\nexport interface ToolDefinition {\n  type: \"function\";\n  function: {\n    name: string;\n    description: string;\n    parameters: {\n      type: \"object\";\n      properties: Record<string, ToolParameterProperty>;\n      required?: string[];\n    };\n  };\n}\n\nexport interface HarnessConfig {\n  endpoint: string;          // e.g. \"http://localhost:1234/v1\" (LM Studio) or \"http://localhost:8000/v1\" (vLLM)\n  model: string;             // e.g. \"qwen2.5-coder-32b-instruct\"\n  apiKey?: string;           // Optional for local servers (defaults to \"local\")\n  maxSteps: number;          // Steps per segment (default 30). With `continuation` (the default), a segment boundary is a durable checkpoint, never the end of the task.\n  /**\n   * Automatic continuation past `maxSteps` while the work makes progress (see AutonomousAgent.runTurn). Absent:\n   * `maxSteps` ends the turn (LIMIT_REACHED), the legacy single-segment behaviour.\n   */\n  continuation?: ContinuationBudget;\n  temperature: number;       // Default 0.2 for precise coding\n  workspace: string;         // Working directory for tools\n  shell: string;             // Linux shell: \"bash\", \"zsh\", \"sh\" (default: \"bash\")\n  coreBinaryPath?: string;   // Path to compiled harness-core executable\n  dryRun?: boolean;          // Dry-run simulation mode without persisting file modifications\n  readOnly?: boolean;        // Reject all mutating tool executions and commands\n  approvalMode?: \"auto\" | \"review\" | \"read-only\"; // Permission posture: auto, review, or read-only (DEC-01, independent of folder trust)\n  yes?: boolean;             // Run non-interactively without confirmation prompts (forces auto mode)\n  fullAccess?: boolean;      // Broad full-access mode executing without confirmation prompts (AUTH-007, AUTH-008)\n  taskClass?: string;        // Routing hint sent to the gateway as X-Task-Class (e.g. \"review\", \"architecture\")\n  plannerTaskClass?: string; // Same, for the planner client\n  fallbackEndpoints?: string[]; // Failover endpoint URLs if primary endpoint is unavailable\n  pinEndpoint?: boolean;     // Use only `endpoint` (no fallbacks): the operation scheduler owns resource selection\n  credentialOrigin?: string;     // Origin apiKey belongs to (default: endpoint's origin); never sent elsewhere\n  contextLimit?: number;     // Maximum model context window token limit (default: 65536)\n  completionReserveTokens?: number; // Context reserved for each model completion (default: 8192)\n  toolResponseReserveTokens?: number; // Tool-output headroom policy for the following tool results (default: min(4096, context/8))\n  /**\n   * Operator opt-in: refuse a request that could not be counted on a worker by the connection's request counting.\n   * Off by default: without it an unmeasured request proceeds on the labelled client estimate (provider_capabilities.ts).\n   */\n  strictTokenCount?: boolean;\n  sandbox?: boolean | string; // Linux namespace / bwrap / container isolation (default: false)\n  worktree?: boolean;        // Isolated ephemeral git worktree execution (default: false)\n  authoritativeVerifierCommand?: string; // Explicit trusted verifier: gates every task completion and authorizes automatic worktree merge\n  /** Workspace-relative deliverable paths declared by the operator before the task starts. */\n  trustedDeliverableFiles?: string[];\n  verifierTimeoutSecs?: number; // Deadline for the completion verifier (default 300); env NEXUS_VERIFIER_TIMEOUT_SECS\n  recordFlight?: boolean;    // Deterministic .flightlog session recording (default: false)\n  plannerModel?: string;     // Deep reasoning / architecture planner (e.g. Claude 3.7 Thinking / o3 / DeepSeek R1)\n  plannerEndpoint?: string;  // Dedicated endpoint for planner model\n  plannerApiKey?: string;    // API key for planner model\n  coderModel?: string;       // Ultra-fast surgical implementation model (e.g. Qwen 2.5 Coder 32B @ 150 tok/s)\n  coderEndpoint?: string;    // Dedicated endpoint for coder model\n  coderApiKey?: string;      // API key for coder model\n  tdd?: boolean;             // Enforce strict RED-GREEN-REFACTOR protocol\n  role?: \"researcher\" | \"architect\" | \"implementer\" | \"tester\" | \"reviewer\"; // Specialized agent role\n  provider?: string;         // Cloud provider id (see providers.ts); undefined = the appliance/endpoint path\n  plannerProvider?: string;  // Provider for the planner role; undefined inherits the rules in agent.ts\n  coderProvider?: string;    // Provider for the coder role\n  /** Origins the operator authorized to receive task content when they are cloud destinations. */\n  authorizedDisclosureOrigins?: string[];\n  /** Origins that look local but forward to a cloud service (treated as cloud disclosure). */\n  cloudRoutedOrigins?: string[];\n  /** Execution surface: 'repl', 'tui', or 'headless' (REQ-AGT-109a). */\n  surface?: \"repl\" | \"tui\" | \"headless\" | string;\n  reasoningEffort?: string;  // OpenAI Responses reasoning effort; enables owner-scoped reasoning replay\n  anthropicThinkingBudget?: number; // Anthropic extended-thinking budget tokens; enables signed thinking replay\n}\n\nexport interface ExecutionResult {\n  success: boolean;\n  output: string;\n  error?: string;\n  /** The operation's deadline expired before an answer was received (bridge-level; the runner reports its own via `timed_out`). */\n  timedOut?: boolean;\n  /** The operator's cancel ended the operation (the runner ended the command's process group). */\n  cancelled?: boolean;\n}\n\n/**\n * How an automatically continued turn ends. Progressing work has no step or time ceiling by default: it ends on\n * completion, cancellation, demonstrated lack of progress, or an actionable failure. A step or time limit applies\n * only when the operator sets one explicitly; each limit has its own termination reason.\n */\nexport interface ContinuationBudget {\n  /** Operator-set total steps for one turn (STEP_BUDGET_EXHAUSTED); Infinity (the default) when none was set. */\n  maxTotalSteps: number;\n  /** Operator-set wall-clock minutes for one turn (TIME_BUDGET_EXHAUSTED); Infinity (the default) when none was set. */\n  maxTurnMinutes: number;\n  /**\n   * Consecutive steps without observed progress before the turn stops (STAGNATION_DETECTED). A repeated-state\n   * threshold, not a task length: any progressing step resets it (core/execution_tracking.ts defines progress).\n   */\n  stagnationSteps: number;\n  /** Recovery notes the agent may inject for a repeated identical action before stopping (bounded recovery). */\n  maxRecoveries: number;\n  /** Times the agent may be asked to continue when it stops with acceptance requirements still open. */\n  maxCompletionNudges: number;\n}\n\nexport const DEFAULT_CONTINUATION: ContinuationBudget = {\n  maxTotalSteps: Number.POSITIVE_INFINITY,\n  maxTurnMinutes: Number.POSITIVE_INFINITY,\n  stagnationSteps: 12,\n  maxRecoveries: 2,\n  maxCompletionNudges: 2,\n};\n\nexport type ApprovalMode = \"auto\" | \"review\" | \"read-only\";\n// Runs one evaluation candidate behind a namespace-local TCP endpoint and a host-side Unix-socket proxy.\n// The candidate sees only the run-scoped local token; the upstream gateway credential stays in run.mjs.\nimport http from \"node:http\";\nimport { spawn } from \"node:child_process\";\nimport { StringDecoder } from \"node:string_decoder\";\n\n// The launch payload is the first stdin line. With payload.protocol the rest of stdin is the agent's stdin (the T3\n// sidecar protocol); otherwise the agent gets no stdin.\nconst payload = JSON.parse(await readPayloadLine());\nconst port = 40127; // private to this network namespace; no host listener uses this port\nconst server = http.createServer((req, res) => {\n  const upstream = http.request({ socketPath: \"/run/eval-proxy/proxy.sock\", agent: new http.Agent({ keepAlive: false }), method: req.method, path: req.url, headers: { ...req.headers, host: \"eval-proxy\", connection: \"close\" } }, (response) => {\n    res.writeHead(response.statusCode ?? 502, response.headers);\n    response.pipe(res);\n    response.once(\"end\", () => upstream.destroy());\n  });\n  upstream.on(\"error\", (error) => {\n    if (!res.headersSent) res.writeHead(502, { \"content-type\": \"application/json\" });\n    res.end(JSON.stringify({ error: { type: \"proxy_unavailable\", message: \"evaluation proxy unavailable\" } }));\n  });\n  req.pipe(upstream);\n});\nawait new Promise((resolve, reject) => {\n  server.once(\"error\", reject);\n  server.listen(port, \"127.0.0.1\", resolve);\n});\n\nconst endpoint = `http://127.0.0.1:${port}/v1`;\nconst env = { ...payload.env };\nfor (const [key, value] of Object.entries(env)) {\n  if (typeof value === \"string\") env[key] = value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint);\n}\nconst argv = payload.argv.map((value) => value.replaceAll(\"{{EVAL_ENDPOINT}}\", endpoint));\nconst agent = spawn(payload.command, argv, { cwd: \"/workspace\", env, stdio: [payload.protocol ? \"pipe\" : \"ignore\", \"inherit\", \"inherit\"] });\nif (payload.protocol) {\n  agent.stdin.on(\"error\", () => {});\n  process.stdin.pipe(agent.stdin);\n  process.stdin.resume();\n}\nlet stopping = false;\nconst stop = (signal) => {\n  if (stopping) return;\n  stopping = true;\n  try { process.kill(-agent.pid, signal); } catch { agent.kill(signal); }\n};\nprocess.on(\"SIGTERM\", () => stop(\"SIGTERM\"));\nprocess.on(\"SIGINT\", () => stop(\"SIGINT\"));\nagent.on(\"error\", (error) => {\n  process.stderr.write(`candidate spawn failed: ${error.message}\\n`);\n  closeBridge(127);\n});\nagent.on(\"close\", (code, signal) => {\n  closeBridge(code ?? (signal ? 128 : 1));\n});\n\n/** Reads stdin up to the first newline (or its end); anything after the newline is put back for the agent. */\nfunction readPayloadLine() {\n  return new Promise((resolve, reject) => {\n    let body = \"\";\n    const decoder = new StringDecoder(\"utf8\");\n    const onData = (chunk) => {\n      body += decoder.write(chunk);\n      if (body.length > 1_000_000) { cleanup(); reject(new Error(\"sandbox launch payload too large\")); return; }\n      const newline = body.indexOf(\"\\n\");\n      if (newline < 0) return;\n      cleanup();\n      process.stdin.pause();\n      const rest = body.slice(newline + 1);\n      if (rest) process.stdin.unshift(Buffer.from(rest, \"utf8\"));\n      resolve(body.slice(0, newline));\n    };\n    const onEnd = () => { cleanup(); resolve(body); };\n    const cleanup = () => { process.stdin.off(\"data\", onData); process.stdin.off(\"end\", onEnd); process.stdin.off(\"error\", reject); };\n    process.stdin.on(\"data\", onData);\n    process.stdin.on(\"end\", onEnd);\n    process.stdin.on(\"error\", reject);\n  });\n}\n\nfunction closeBridge(exitCode) {\n  process.exitCode = exitCode;\n  server.closeAllConnections?.();\n  server.close();\n}\n#!/usr/bin/env node\n// Runs evaluation tasks against an agent configuration and appends one JSON line per run (see eval/README.md).\n// Each run gets a fresh workspace (the task's repository at its pinned commit, or its fixture), the agent runs with the\n// task's budgets and a wall-clock timeout, then the task's hidden tests (never present while the agent runs) and its\n// regression command are run in that workspace. Nothing is scored here: eval/score.mjs reads the JSON lines.\nimport { spawnSync } from \"node:child_process\";\nimport { createHash, randomBytes } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { startModelProxy } from \"./model_proxy.mjs\";\nimport { asUserSpec, corpusManifestProblem, corpusTaskRows, fetchModelEntry, hiddenTestIsolationProblem, modelFingerprint, nexusContextLimitArgs, nexusLimitsProblem, qualificationBudgetProblem, runtimeCorpusOverlapProblem, taskTreeDigest, validateTask } from \"./validate.mjs\";\nimport { agentSandboxArgv, assertNoSymlinks, confinedPath, grantRunAsAccess, hiddenOutputHasTests, isolatedProcessArgv, normalizeRunAsPermissions, runIsolated, runIsolatedProcess, sandboxAvailable, stageHiddenFiles } from \"./isolate.mjs\";\nimport { runBlackBoxOracle } from \"./oracle.mjs\";\nimport { stageRepoWorkspace } from \"./workspace.mjs\";\nimport { applyAgentChanges, cloneWorkspace } from \"./hardened_check.mjs\";\nimport { containmentProblem, resourceProbeProblem, spawnContained } from \"./resources.mjs\";\nimport { StringDecoder } from \"node:string_decoder\";\nimport { commandBaseline, countCompactions, createT3Driver, scoreT3Run, steeringBaseline, steeringPrecondition, t3Snapshot } from \"./t3.mjs\";\nimport { observeT4Fixture } from \"./t4_fixtures.mjs\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst args = parseArgs(process.argv.slice(2));\nif (args.out) args.out = path.resolve(args.out); // agents run elsewhere: paths handed to them must be absolute\nif (!args.config || !args.out) {\n  console.error(\"usage: eval/run.mjs --config eval/configs/<name>.json --out <dir> [--tasks eval/tasks] [--only id,id] [--runs N]\");\n  process.exit(2);\n}\nconst configBytes = fs.readFileSync(args.config);\nconst configSha256 = createHash(\"sha256\").update(configBytes).digest(\"hex\");\nconst config = JSON.parse(configBytes.toString(\"utf8\"));\nconst tasksDir = path.resolve(args.tasks ?? path.join(ROOT, \"eval/tasks\"));\nfunction custodyCorpusPathsForRun() {\n  return [\n    config.corpusCustody?.reportPath,\n    config.corpusCustody?.storeRoot,\n    config.corpusCustody?.validatorPath,\n    config.corpusCustody?.referencePath,\n    config.corpusCustody?.authorLogPath,\n  ].filter(Boolean);\n}\nfunction protectedCorpusPathsForRun() {\n  const parent = path.dirname(tasksDir);\n  const evalDir = path.join(ROOT, \"eval\");\n  const includeParent = config.qualification === true || fs.realpathSync(parent) !== fs.realpathSync(evalDir);\n  return [tasksDir, ...(includeParent ? [parent] : []), ...custodyCorpusPathsForRun()];\n}\nconst runs = Number(args.runs ?? config.runs ?? 1);\nconst only = args.only ? new Set(String(args.only).split(\",\")) : null;\n// --pairs \"task run,task run\": rerun exactly these (runs that failed on infrastructure; see eval/infra.mjs).\nconst pairs = args.pairs ? String(args.pairs).split(\",\").filter(Boolean).map((p) => p.trim().split(/\\s+/)) : null;\nfs.mkdirSync(path.dirname(args.out), { recursive: true });\ntry {\n  fs.mkdirSync(args.out, { mode: 0o700 });\n  fs.chmodSync(args.out, 0o700);\n} catch (error) {\n  if (error.code === \"EEXIST\") {\n    console.error(\"eval/run.mjs: output directory must be new; refusing to overwrite or append to prior evidence\");\n    process.exit(2);\n  }\n  throw error;\n}\nconst resultsFile = path.join(args.out, \"results.jsonl\");\n\nconst identity = harnessIdentity();\nconst availableTaskIds = fs.readdirSync(tasksDir).filter((d) => {\n  const entry = path.join(tasksDir, d);\n  try { return fs.lstatSync(entry).isDirectory() && fs.existsSync(path.join(entry, \"task.json\")); }\n  catch { return false; }\n}).sort();\nconst tasks = availableTaskIds.filter((d) => !only || only.has(d));\nconst taskSnapshots = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-task-snapshot-\"));\nfs.chmodSync(taskSnapshots, 0o700);\nprocess.on(\"exit\", () => fs.rmSync(taskSnapshots, { recursive: true, force: true }));\nconst taskRecords = [];\nfor (const id of tasks) {\n  const source = confinedPath(tasksDir, id);\n  assertNoSymlinks(source);\n  const before = taskTreeDigest(source);\n  const snapshot = path.join(taskSnapshots, id);\n  fs.cpSync(source, snapshot, { recursive: true, verbatimSymlinks: true });\n  if (taskTreeDigest(snapshot) !== before) throw new Error(`task ${id} changed while the runner froze its input`);\n  const taskFile = confinedPath(snapshot, \"task.json\");\n  taskRecords.push({ id, dir: snapshot, treeSha256: before, task: JSON.parse(fs.readFileSync(taskFile, \"utf8\")) });\n}\nif (config.qualification === true && only) {\n  console.error(\"eval/run.mjs: qualification task subsets are forbidden; use a frozen corpus run or an explicitly recorded infrastructure-pair rerun\");\n  process.exit(2);\n}\nif (config.qualification === true && config.proxy === false) {\n  console.error(\"eval/run.mjs: qualification requires the authenticated per-run model proxy\");\n  process.exit(2);\n}\nif (!sandboxAvailable()) {\n  console.error(\"eval/run.mjs: Bubblewrap unavailable; refusing to execute task-controlled setup and validators\");\n  process.exit(2);\n}\nconst apiKey = readApiKey(config.apiKey);\nconst caFile = config.caFile ? expandHome(config.caFile) : null;\nconst caBundle = caFile ? writeCaBundle(caFile) : null;\n\n// A run is valid only with well-formed tasks, hidden tests the agent cannot read, and (for qualification) a model\n// identified beyond its alias. Any problem stops the run before an agent starts (eval/validate.mjs).\nconst problems = taskRecords.flatMap(({ id, dir, task }) => {\n  return validateTask(task, dir, { qualification: config.qualification === true }).map((p) => `${id}: ${p}`);\n});\nconst isolation = hiddenTestIsolationProblem(config, tasksDir);\nif (isolation) problems.push(isolation);\n// Qualification proves the resource contract inside hiddenTestIsolationProblem; a development config may opt in.\nif (config.resources !== undefined && config.qualification !== true) {\n  const resourceProblem = resourceProbeProblem(config.resources);\n  if (resourceProblem) problems.push(resourceProblem);\n}\nif (config.resources !== undefined && args.keep) problems.push(\"--keep would accumulate run workspaces on the size-capped resources.workspaceRoot\");\nif (config.qualification === true) {\n  const corpusProblem = corpusManifestProblem(config, tasksDir, tasks, corpusTaskRows(taskSnapshots, tasks));\n  if (corpusProblem) problems.push(corpusProblem);\n}\nif (config.qualification === true && config.sampling?.temperature !== 0) {\n  problems.push(\"qualification adapters require sampling.temperature=0 so the matched Nexus, Goose and OpenCode runs use the same deterministic setting\");\n}\nif (config.qualification === true) {\n  const budgetProblem = qualificationBudgetProblem(config);\n  if (budgetProblem) problems.push(budgetProblem);\n}\nconst agentIdentity = problems.length ? { record: null, problem: null } : await resolveAgentIdentity(config);\nif (agentIdentity.problem) problems.push(agentIdentity.problem);\nlet fingerprint = null;\nif (!problems.length) {\n  const probe = config.proxy === false ? null : await startModelProxy({ upstream: config.endpoint, caFile });\n  try {\n    const entry = await fetchModelEntry(probe?.url ?? config.endpoint, config.model, apiKey);\n    const fp = modelFingerprint(config, entry);\n    fingerprint = fp.fingerprint;\n    problems.push(...fp.missing.map((m) => `model fingerprint: ${m}`));\n    if (config.qualification === true && (config.agent ?? \"nexus\") === \"nexus\") {\n      const limitsProblem = nexusLimitsProblem(config, entry);\n      if (limitsProblem) problems.push(limitsProblem);\n    }\n  } finally {\n    await probe?.close();\n  }\n}\nif (problems.length) {\n  console.error(`eval/run.mjs: not starting; ${problems.length} problem(s):\\n${problems.map((p) => `  - ${p}`).join(\"\\n\")}`);\n  process.exit(2);\n}\nconst frozenTaskRows = taskRecords.map(({ id }) => corpusTaskRows(taskSnapshots, [id])[0]);\nfs.writeFileSync(path.join(args.out, \"manifest.json\"), JSON.stringify({\n  createdAt: new Date().toISOString(),\n  harness: identity,\n  config: redactConfig(config),\n  configSha256,\n  qualificationCorpus: config.qualification === true ? { manifestSha256: config.corpusManifestSha256, tasks: frozenTaskRows } : null,\n  fingerprint,\n  agentVersion: agentIdentity.record,\n  budget: effectiveBudget({}, config),\n  runs,\n  tasks: frozenTaskRows,\n  host: os.hostname(),\n  node: process.version,\n}, null, 2) + \"\\n\");\n\n// Run-major order (every task once, then again): a pass cut short still has the same number of runs per task.\nfor (let run = 1; run <= runs; run++) {\n  for (const { id, dir, treeSha256, task: taskData } of taskRecords) {\n    if (pairs && !pairs.some(([t, r]) => t === id && Number(r) === run)) continue;\n    if (taskTreeDigest(dir) !== treeSha256) throw new Error(`frozen task ${id} changed after manifest creation`);\n    const task = { ...taskData, dir };\n    const record = await runOnce(task, run);\n    fs.appendFileSync(resultsFile, JSON.stringify(record) + \"\\n\");\n    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\n  }\n}\n\nasync function runOnce(task, run) {\n  // Under the resource contract these are on a tmpfs, so candidate writes count against the run's memory limit.\n  const scratch = config.resources?.workspaceRoot ?? os.tmpdir();\n  const ws = fs.mkdtempSync(path.join(scratch, `nexus-eval-${task.id}-`));\n  const checkDirs = [];\n  const home = fs.mkdtempSync(path.join(scratch, \"nexus-eval-home-\"));\n  const budget = effectiveBudget(task, config);\n  const base = { task: task.id, tier: task.tier, ...(task.tier === \"T3\" ? { t3SteeringItems: task.steering.length } : {}), config: config.name, agent: config.agent ?? \"nexus\", agentVersion: agentIdentity.record, budget, run, harness: identity.string, model: config.model, startedAt: new Date().toISOString() };\n  try {\n    await prepareWorkspace(task, ws);\n    // Taken now, while .git is the harness's own: after the agent runs, nothing executes git against its workspace.\n    const baselineTree = gitRev(ws, \"HEAD^{tree}\");\n    const t3Baseline = task.tier === \"T3\" ? steeringBaseline(task, ws) : null;\n    // On the per-run task copy, so the steering hook in runAgent can read it. The commands run on a throwaway copy of\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","create_time":1792917400.8743076}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
