re runners report counts): bounded, and what coverage is judged from.\n          report: (res.rawOutput || \"\").split(\"\\n\").slice(-40).join(\"\\n\").slice(-4000),\n          summary: res.success\n            ? \"Test suite passed successfully.\"\n            : `Test suite failed with ${res.failures.length} failing tests and ${res.diagnostics.length} diagnostics.`,\n        }),\n        error: res.success ? undefined : `Test suite failed: ${res.failures.join(\"; \") || \"Errors encountered\"}`,\n      };\n    }\n\n    if (toolName === \"fetch_web\") {\n      try {\n        const url = args.url;\n        if (!url || typeof url !== \"string\") {\n          return { success: false, output: \"\", error: \"Missing required parameter 'url'\" };\n        }\n\n        const safetyCheck = isSafeOutboundUrl(url);\n        if (!safetyCheck.safe) {\n          return { success: false, output: \"\", error: safetyCheck.reason || \"Blocked by security policy\" };\n        }\n\n        const boundary = InformationFlowBoundary.getGlobalInstance();\n        const egressCheck = boundary.evaluateEgress(url, url, {\n/home/mike/nexus-wt/plan10-pr10c-t4/cli/src/core/capabilities.ts:27:  /** Model-visible tool name matching LLM schemas (e.g., 'read_file', 'run_command') */\n/home/mike/nexus-wt/plan10-pr10c-t4/cli/src/core/capabilities.ts:415:    \"modelToolName\": \"run_command\",\n/home/mike/nexus-wt/plan10-pr10c-t4/cli/src/core/capabilities.ts:424:        \"name\": \"run_command\",\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","create_time":1792916905.3433933}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
