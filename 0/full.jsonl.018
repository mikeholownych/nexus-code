{"timestamp":"2026-10-25T05:24:03.656Z","ordinal":325536,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a1717f-73da-7b13-b06c-cebce8fdbefc","item":{"type":"CommandExecution","id":"exec-951f3d60-d989-455e-9b6a-e627e2eeb928","process_id":"9256","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/plan-07-installer-attestation-fix diff origin/main...HEAD -- install.sh scripts/installer-smoke.sh && git -C /home/mike/nexus-wt/plan-07-installer-attestation-fix show --stat --oneline HEAD && gh run view 40163351990 --job 121082436038 --json status,conclusion,steps --jq '{status,conclusion,step:(.steps[] | select(.status==\"in_progress\") | .name)}'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/plan-07-installer-attestation-fix diff origin/main...HEAD -- install.sh scripts/installer-smoke.sh && git -C /home/mike/nexus-wt/plan-07-installer-attestation-fix show --stat --oneline HEAD && gh run view 40163351990 --job 121082436038 --json status,conclusion,steps --jq '{status,conclusion,step:(.steps[] | select(.status==\"in_progress\") | .name)}'"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"diff --git a/install.sh b/install.sh\nindex 6fa3da8..cd7db1b 100644\n--- a/install.sh\n+++ b/install.sh\n@@ -18,6 +18,21 @@ command -v curl >/dev/null 2>&1 || fail \"curl is required.\"\n command -v tar >/dev/null 2>&1 || fail \"tar is required.\"\n command -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n \n+VERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION:-1}\n+case \"$VERIFY_ATTESTATION\" in\n+  0|1) ;;\n+  *) fail \"NEXUS_VERIFY_ATTESTATION must be 1 (verify provenance) or 0 (explicitly skip verification).\" ;;\n+esac\n+TRUSTED_GH=\n+if [ -x /usr/bin/gh ]; then\n+  TRUSTED_GH=/usr/bin/gh\n+elif [ -x /usr/local/bin/gh ]; then\n+  TRUSTED_GH=/usr/local/bin/gh\n+fi\n+if [ \"$VERIFY_ATTESTATION\" = \"1\" ] && [ -z \"$TRUSTED_GH\" ]; then\n+  fail \"provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\"\n+fi\n+\n validate_tag() {\n   printf '%s' \"$1\" | grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\"\n }\n@@ -71,11 +86,11 @@ grep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksu\n (cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\n ARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n \n-if [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" != \"0\" ] && command -v gh >/dev/null 2>&1; then\n-  if gh attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n-     gh attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n+if [ \"$VERIFY_ATTESTATION\" != \"0\" ] && [ -n \"$TRUSTED_GH\" ]; then\n+  if \"$TRUSTED_GH\" attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n+     \"$TRUSTED_GH\" attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n     printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n-  elif [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" = \"1\" ]; then\n+  elif [ \"$VERIFY_ATTESTATION\" = \"1\" ]; then\n     fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n   fi\n fi\ndiff --git a/scripts/installer-smoke.sh b/scripts/installer-smoke.sh\nindex 3cb9349..b0a3b47 100644\n--- a/scripts/installer-smoke.sh\n+++ b/scripts/installer-smoke.sh\n@@ -9,6 +9,9 @@ trap cleanup EXIT\n NAME=$(basename \"$ARCHIVE\")\n VERSION=${NAME#nexus-linux-x86_64-}\n VERSION=${VERSION%.tar.gz}\n+# This fixture uses locally generated, unattested packages except in the explicit\n+# trusted-gh case below. Make that test-only opt-out visible to every installer run.\n+export NEXUS_VERIFY_ATTESTATION=0\n mkdir -p \"$TMP/release/download/$VERSION\" \"$TMP/prefix/bin\"\n cp \"$ARCHIVE\" \"$TMP/release/download/$VERSION/$NAME\"\n (cd \"$TMP/release/download/$VERSION\" && sha256sum \"$NAME\" > SHA256SUMS)\n@@ -26,6 +29,49 @@ run_installer() {\n }\n run_installer\n \"$TMP/prefix/bin/nexus\" --version | grep -F \"${VERSION#v}\" >/dev/null\n+\n+# Attestation is required by default and must never trust a PATH shim.\n+# Relocate only the fixed trusted binary locations in a private installer copy so this\n+# fixture exercises both branches without depending on whether the host has gh installed.\n+mkdir -p \"$TMP/trusted/usr/bin\" \"$TMP/trusted/usr/local/bin\" \"$TMP/path-shim\" \"$TMP/attestation-prefix/bin\"\n+sed \"s|/usr/bin/gh|$TMP/trusted/usr/bin/gh|g; s|/usr/local/bin/gh|$TMP/trusted/usr/local/bin/gh|g\" \\\n+  \"$INSTALLER\" > \"$TMP/install-test.sh\"\n+chmod +x \"$TMP/install-test.sh\"\n+cat > \"$TMP/path-shim/gh\" <<EOF\n+#!/bin/sh\n+printf 'PATH shim invoked\\\\n' >> '$TMP/path-shim.log'\n+exit 0\n+EOF\n+chmod +x \"$TMP/path-shim/gh\"\n+if env -u NEXUS_VERIFY_ATTESTATION \\\n+  NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" \\\n+  PATH=\"$TMP/path-shim:$PATH\" sh \"$TMP/install-test.sh\" > \"$TMP/no-trusted-gh.out\" 2>&1; then\n+  echo \"installer accepted required provenance without a trusted gh\" >&2\n+  exit 1\n+fi\n+grep -F \"no trusted GitHub CLI was found\" \"$TMP/no-trusted-gh.out\" >/dev/null\n+[ ! -e \"$TMP/path-shim.log\" ] || { echo \"installer invoked PATH gh shim\" >&2; exit 1; }\n+if NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/invalid-mode\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" NEXUS_VERIFY_ATTESTATION=auto \\\n+  sh \"$INSTALLER\" > \"$TMP/invalid-mode.out\" 2>&1; then\n+  echo \"installer accepted an unsupported attestation mode\" >&2\n+  exit 1\n+fi\n+grep -F \"NEXUS_VERIFY_ATTESTATION must be\" \"$TMP/invalid-mode.out\" >/dev/null\n+cat > \"$TMP/trusted/usr/bin/gh\" <<'EOF'\n+#!/bin/sh\n+printf '%s\\n' \"$*\" >> \"$TRUSTED_GH_LOG\"\n+exit 0\n+EOF\n+chmod +x \"$TMP/trusted/usr/bin/gh\"\n+NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" NEXUS_VERIFY_ATTESTATION=1 \\\n+  TRUSTED_GH_LOG=\"$TMP/trusted-gh.log\" PATH=\"$TMP/path-shim:$PATH\" \\\n+  sh \"$TMP/install-test.sh\" > \"$TMP/trusted-gh.out\" 2>&1\n+grep -F \"verified build provenance\" \"$TMP/trusted-gh.out\" >/dev/null\n+[ \"$(wc -l < \"$TMP/trusted-gh.log\")\" -eq 2 ] || { echo \"installer did not verify both provenance subjects\" >&2; exit 1; }\n+[ ! -e \"$TMP/path-shim.log\" ] || { echo \"installer invoked PATH gh shim\" >&2; exit 1; }\n node - \"$TMP/prefix/lib/nexus/$VERSION/.provenance.json\" \"$VERSION\" \"$TMP/prefix\" \"$TMP/prefix/lib/nexus/$VERSION\" \"$TMP/prefix/bin/nexus\" \"$NAME\" \"$TMP/release/download/$VERSION/$NAME\" <<'NODE'\n const assert = require(\"node:assert/strict\");\n const crypto = require(\"node:crypto\");\n8faf36a test: clear attestation opt-out in strict smoke case\n scripts/installer-smoke.sh | 3 ++-\n 1 file changed, 2 insertions(+), 1 deletion(-)\nUnknown JSON field: \"steps\"\nAvailable fields:\n  attempt\n  conclusion\n  createdAt\n  databaseId\n  displayTitle\n  event\n  headBranch\n  headSha\n  jobs\n  name\n  number\n  startedAt\n  status\n  updatedAt\n  url\n  workflowDatabaseId\n  workflowName\n","exit_code":1,"duration":{"secs":0,"nanos":44215648}},"started_at_ms":1792905843611,"completed_at_ms":1792905843655}}
