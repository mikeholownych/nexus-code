 \"core\")], path.join(ROOT, \"eval/tasks\")), null, \"default development Nexus runtime roots do not overlap eval/tasks\");\n440-    assert.match(runtimeCorpusOverlapProblem([], [], path.join(ROOT, \"eval/tasks\"), [], { qualification: true }) ?? \"\", /overlaps protected corpus material/, \"qualification mode still rejects using in-repo eval/tasks because its parent overlaps eval/agent_sandbox.mjs\");\n441-\n442-    const unconditionalMountPaths = [\n443-      ...hostMounts.systemDirectories.map((source) => path.join(source, \"synthetic-corpus-subdir\")),\n--\n602-    assert.equal(forks.resources.cleaned, true);\n603-\n604-    // The dedicated workspace mount caps storage before the larger memory limit; sandbox /tmp is separately charged\n605-    // to the task cgroup and must hit memory.max. Neither failure may leave a task process behind.\n606:    const workspaceDisk = await run(\"dd if=/dev/zero of=/workspace/fill bs=1M count=512 status=none\");\n607:    assert.notEqual(workspaceDisk.status, 0, JSON.stringify(workspaceDisk));\n608:    assert.equal(workspaceDisk.resources.oomKills, 0, JSON.stringify(workspaceDisk.resources));\n609:    assert.equal(workspaceDisk.resources.cleaned, true);\n610-    assert.ok((fs.existsSync(path.join(ws, \"fill\")) ? fs.statSync(path.join(ws, \"fill\")).size : 0) <= resources.storageBytes);\n611-\n612:    const sandboxDisk = await run(\"dd if=/dev/zero of=/tmp/fill bs=1M count=512 status=none\");\n613:    assert.notEqual(sandboxDisk.status, 0, JSON.stringify(sandboxDisk));\n614:    assert.ok(sandboxDisk.resources.oomKills >= 1, JSON.stringify(sandboxDisk.resources));\n615:    assert.equal(sandboxDisk.resources.cleaned, true);\n616-\n617-    const cpu = await run(\"timeout 2 sh -c 'while :; do :; done' & timeout 2 sh -c 'while :; do :; done' & wait\");\n618-    assert.equal(cpu.resources.limits[\"cpu.max\"], \"20000 100000\");\n619-    assert.ok(cpu.resources.cpuUsageUsec < 1_000_000, `two busy loops for 2 s at 20% used ${cpu.resources.cpuUsageUsec} us`);\n--\n682-    const fixtureBase = base;\n683-    const fixtureWorkspace = workspace;\n684-    const env = { PATH: \"/usr/bin:/bin\", HOME: fixtureBase, GIT_CONFIG_NOSYSTEM: \"1\", GIT_CONFIG_GLOBAL: \"/dev/null\", GIT_TERMINAL_PROMPT: \"0\" };\n685-    const git = (cwd: string, ...argv: string[]) => {\n686:      const result = spawnSync(\"git\", [\"-c\", \"user.name=fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"-c\", \"init.defaultBranch=main\", ...argv], { cwd, env, encoding: \"utf8\" });\n687-      assert.equal(result.status, 0, result.stderr);\n688-      return resul…1642 tokens truncated…;\n1118-  assert.ok(!fs.existsSync(path.join(tasks, \"out\", \"results.jsonl\")), \"no run was recorded\");\n1119-});\n1120-\n1121:// ---------------------------------------------------------------- T4 fault injection (REQ-QUAL-105)\n1122-\n1123:test(\"the model proxy injects each scheduled fault into the chat request it names, and records it\", async () => {\n1124-  const { startModelProxy, isInfrastructureFailure } = await import(proxyModule);\n1125-  const sse = (o: unknown) => `data: ${JSON.stringify(o)}\\n\\n`;\n1126-  const upstream = http.createServer((req, res) => {\n1127:    req.resume();\n1128-    res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n1129-    res.end(\n1130-      sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: 0, id: \"c\", type: \"function\", function: { name: \"read_file\", arguments: \"\" } }] } }] }) +\n1131-      sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: 0, function: { arguments: '{\"path\":\"a\"}' } }] } }] }) +\n--\n1134-  });\n1135-  await new Promise<void>((r) => upstream.listen(0, \"127.0.0.1\", () => r()));\n1136-  const port = (upstream.address() as any).port;\n1137-  const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n1138:  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1`, faults: kinds.map((kind, i) => ({ kind, atRequest: i + 1 })) });\n1139-  const chat = () => fetch(`${proxy.url}/chat/completions`, { method: \"POST\", body: \"{}\" });\n1140-  try {\n1141-    await assert.rejects(chat(), \"refuse: the connection is dropped\");\n1142-    const overloaded = await chat();\n--\n1151-    const overflow = await chat();\n1152-    assert.equal(overflow.status, 400);\n1153-    assert.equal((await overflow.json()).error.type, \"exceed_context_size_error\");\n1154-    assert.match(await (await chat()).text(), /\\\\\"broken/, \"malformed_tool_json: the first arguments fragment is corrupted\");\n1155:    assert.match(await (await chat()).text(), /\"finish_reason\":\"tool_calls\"/, \"requests without a scheduled fault pass unchanged\");\n1156-    const stats = proxy.stats();\n1157:    assert.deepEqual(stats.faultsInjected.map((f: any) => f.kind), kinds);\n1158:    assert.equal(isInfrastructureFailure({ model: { ...stats, answered: 0, upstreamFailures: 3 } }), false, \"injected faults are never infrastructure reruns\");\n1159-  } finally {\n1160-    await proxy.close();\n1161-    upstream.close();\n1162-  }\n1163:  await assert.rejects(startModelProxy({ upstream: \"http://127.0.0.1:9/v1\", faults: [{ kind: \"nope\", atRequest: 1 }] }), /invalid fault/);\n1164-});\n1165-\n1166-test(\"executable probes refuse bind sources that overlap protected corpus material\", async () => {\n1167-  const { isolatedProcessArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\norigin/main:eval/README.md:106:The remaining T4 classes come from task fixtures (a hanging test command, a full disk) and from the SIGTERM-then-resume\norigin/main:eval/model_proxy.mjs:21: * The other T4 classes (a hanging test command, a full disk, SIGTERM then resume) come from task fixtures and the runner.\norigin/main:eval/score.mjs:112:// T4: per injected fault kind. Truthful = the run ended with a result of its own (no crash, no hang past the budget)\n| 3 | Hidden-test isolation. Hidden tests are stored under a separate uid (`nexus-eval`, created by the operator, owner action under X3) with mode 0700, and copied in after the agent exits. The agent runs with an allow-listed env. | `run.mjs:57-59,114,178` | — |\n| 4 | Fingerprint. Record server kind, build, weights sha256 (from config), and sampling settings. Refuse the run if the fingerprint is missing. Temperature 0 or a fixed seed for every agent where the agent supports it. | new `fingerprint.mjs`; `configs/*.json` | PLAN-05 task 1 |\n| 5 | Fault proxy for T4 classes 1–4 and 7–8, scheduled per run. Fixture hooks for 5 (hanging test), 6 (disk full via a small loop-mounted fs or `ulimit -f`), and 9 (SIGTERM then `run --resume`). | new `eval/faults/proxy.mjs`; task fixtures | PLAN-04 task 1 |\n| 6 | T4 smoke in `make test`: scripted model plus 2 fault cases. The T1 self-test stays. | `cli/test/eval_harness.test.ts`; `Makefile` | 5 |\n| 7 | Task schema `{repo, commit, prompt, hidden_tests, fail_to_pass, pass_to_pass, class, difficulty}`, with a validator. | `eval/tasks/schema.json`; `run.mjs` | — |\n| 8 | Author tasks (owner action X2). Development set: the existing 6 plus routing engx T01–T12. Held-out set: 40 T2 tasks, of which at least 20 are external, at least 6 per class, across 4 languages. Plus 8 T3 tasks. The sha256 manifest is committed before RC freeze. Calibrate on the development set only. | external store; `eval/heldout-manifest.json` | 7 |\n| 9 | Peer adapters: confirm Goose and OpenCode on the same model and budgets, and record peer versions. | `run.mjs:120-143` | 4 |\n| 10 | Mark `nexus eval` experimental (help and docs). Fix its operator-workspace checkout: run in a worktree (VER-07a). | `index.ts:663-688`; `evaluator.ts:128` | — |\n| 11 | M5 runs: T2 held-out (5×), T3 (5×), T4 (9×5), standalone subset (PLAN-05), provider verify (DEC-06). Archive everything under `docs/reviews/evidence/v1-qualification/<rc>/`. | runbook in ACCEPTANCE §4–§6 | all, RC build |\n| 13 | `eval/standalone/plain_proxy.mjs`: a forward proxy to the gateway. It injects the gateway token server-side. It strips `/v1/models` to `{id,object,owned_by}`, returns 404 for `/v1/tokenize`, and drops `X-AIHost-*` and admission headers. The `--emulate {llamacpp,vllm,ollama}` profiles add that server's `/models`, `/props`, `/api/show` and overflow-error shapes, derived from the real gateway limits. Unit-tested against a mock gateway. | new `eval/standalone/` | — |\n| 12 | Terminal matrix (manual): {xterm, kitty, tmux, VS Code, GNOME Terminal} × 3 sizes. Checklist per ACCEPTANCE §5.3. Archive screenshots. | ACCEPTANCE §5.3 | RC build |\n\n## PR slices\n\n- **PR-10a:** tasks 1, 2.\n- **PR-10b:** tasks 3, 4, 7.\n- **PR-10c:** tasks 5, 6.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a171fd-3278-7ca3-ad25-d2f716cb2b15","create_time":1792913819.3418558}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
