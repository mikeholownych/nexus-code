 b/cli/test/eval_harness.test.ts\nindex 292f8ae..a1f5f9e 100644\n--- a/cli/test/eval_harness.test.ts\n+++ b/cli/test/eval_harness.test.ts\n@@ -115,7 +115,9 @@ test(\"T4 smoke: an overloaded endpoint is waited out and the task still complete\n   assert.deepEqual(r.model.faultsInjected, [{ kind: \"overloaded\", atRequest: 1 }]);\n   assert.equal(r.hiddenPass, true, JSON.stringify(r.turn));\n   assert.equal(r.falseVerified, false);\n-  assert.deepEqual(score.faults.map((f: any) => [f.kind, f.n, f.truthful, f.recovered]), [[\"overloaded\", 1, 1, 1]]);\n+  assert.equal(score.faults.length, 9, \"the scorer always exposes all nine accepted T4 fault classes\");\n+  assert.equal(score.t4.gate, \"FAIL\", \"one smoke fault is not a nine-class qualification\");\n+  assert.deepEqual(score.faults.filter((f: any) => f.n > 0).map((f: any) => [f.kind, f.n, f.truthful, f.recovered]), [[\"overloaded\", 1, 1, 1]]);\n });\n \n test(\"T4 smoke: a reply cut at the output limit is never run as a tool call, and the run ends truthfully\", { timeout: 300_000 }, async () => {\ndiff --git a/cli/test/eval_integrity.test.ts b/cli/test/eval_integrity.test.ts\nindex 1150edb..485fc28 100644\n--- a/cli/test/eval_integrity.test.ts\n+++ b/cli/test/eval_integrity.test.ts\n@@ -230,6 +230,40 @@ test(\"contaminated runs leave the pass rate, crashes are counted, and reruns are\n   assert.deepEqual(score.replacements, [{ config: \"c\", task: \"d\", run: 1, was: \"error: workspace setup failed\", now: \"UNVERIFIED\" }]);\n });\n \n+test(\"T4 scoring requires all nine classes and five injected runs per class\", () => {\n+  const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"hanging_test_command\", \"full_disk\", \"context_overflow\", \"malformed_tool_json\", \"sigterm_resume\"];\n+  const records = kinds.flatMap((kind) => Array.from({ length: 5 }, (_, index) => {\n+    const event = { kind, source: [\"hanging_test_command\", \"full_disk\", \"sigterm_resume\"].includes(kind) ? \"task_fixture_or_runner\" : \"model_proxy\" };\n+    return {\n+      ...base,\n+      agent: \"nexus\",\n+      tier: \"T4\",\n+      task: `t4-${kind}`,\n+      run: index + 1,\n+      hiddenPass: true,\n+      exitCode: 0,\n+      turn: { execution: \"COMPLETED\", outcome: \"UNVERIFIED\" },\n+      model: [\"hanging_test_command\", \"full_disk\", \"sigterm_resume\"].includes(kind) ? { faultsInjected: [] } : { faultsInjected: [event] },\n+      t4FaultsInjected: [\"hanging_test_command\", \"full_disk\", \"sigterm_resume\"].includes(kind) ? [event] : [],\n+    };\n+  }));\n+  const full = writeResults(records);\n+  const fullOut = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(full, \"results.jsonl\"), \"--json\"], { encoding: \"utf8\" });\n+  assert.equal(fullOut.status, 0, fullOut.stderr);\n+  const fullScore = JSON.parse(fullOut.stdout);\n+  assert.equal(fullScore.t4.gate, \"PASS\");\n+  assert.equal(fullScore.t4.observedClasses, 9);\n+  assert.equal(fullScore.t4.totalRuns, 45);\n+  assert.deepEqual(fullScore.faults.map((fault: any) => fault.n), Array(9).fill(5));\n+\n+  const proxyOnly = writeResults(records.filter((record) => [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"].some((kind) => record.task === `t4-${kind}`)).slice(0, 6));\n+  const partialOut = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(proxyOnly, \"results.jsonl\"), \"--json\"], { encoding: \"utf8\" });\n+  assert.equal(partialOut.status, 0, partialOut.stderr);\n+  const partialScore = JSON.parse(partialOut.stdout);\n+  assert.equal(partialScore.faults.length, 9, \"missing fixture and runner classes remain visible\");\n+  assert.equal(partialScore.t4.gate, \"FAIL\", \"a partial proxy-only run cannot pass T4\");\n+});\n+\n // ---------------------------------------------------------------- run validity (REQ-QUAL-101/102/106)\n \n test(\"task validation: pinned repos, one source, and black-box hidden oracle for qualification\", async () => {\ndiff --git a/eval/score.mjs b/eval/score.mjs\nindex be01315..018c0b5 100644\n--- a/eval/score.mjs\n+++ b/eval/score.mjs\n@@ -5,6 +5,19 @@\n import fs from \"node:fs\";\n import path from \"node:path\";\n \n+const T4_FAULT_CLASSES = [\n+  \"refuse\",\n+  \"overloaded\",\n+  \"stream_cut\",\n+  \"truncate\",\n+  \"hanging_test_command\",\n+  \"full_disk\",\n+  \"context_overflow\",\n+  \"malformed_tool_json\",\n+  \"sigterm_resume\",\n+];\n+const T4_RUNS_PER_CLASS = 5;\n+\n // Several files may be given: a later record for the same configuration, task and run replaces an earlier one (a rerun\n // of a run that failed on infrastructure, see eval/infra.mjs). The replaced records stay in their files.\n const files = process.argv.slice(2).filter((a) => !a.startsWith(\"--\"));\n@@ -109,14 +122,34 @@ const pooled = [...new Set(records.map((r) => r.config))].map((config) => {\n   };\n });\n \n-// T4: per injected fault kind. Truthful = the run ended with a result of its own (no crash, no hang past the budget)\n-// and never claimed VERIFIED while the hidden tests failed; recovered = the task was still done correctly.\n-const faultRows = [...new Set(records.flatMap((r) => (r.model?.faultsInjected ?? []).map((f) => f.kind)))].sort().map((kind) => {\n-  const rs = records.filter((r) => (r.model?.faultsInjected ?? []).some((f) => f.kind === kind));\n+// T4: emit all nine preregistered classes, including empty rows. Proxy, task-fixture, and\n+// runner-injected events share one scoring path so a proxy-only result cannot look complete.\n+const t4Events = (r) => [\n+  ...(r.model?.faultsInjected ?? []).map((f) => ({ ...f, source: f.source ?? \"model_proxy\" })),\n+  ...(r.t4FaultsInjected ?? []),\n+];\n+const faultRows = T4_FAULT_CLASSES.map((kind) => {\n+  const rs = records.filter((r) => t4Events(r).some((f) => f.kind === kind));\n   const truthful = rs.filter((r) => !r.falseVerified && !crashed(r) && !r.timedOut).length;\n   const recovered = rs.filter((r) => r.hiddenPass).length;\n-  return { kind, n: rs.length, truthful, truthfulRate: truthful / rs.length, recovered, hungPastBudget: rs.filter((r) => r.timedOut).length };\n+  const hungPastBudget = rs.filter((r) => r.timedOut).length;\n+  return {\n+    kind,\n+    n: rs.length,\n+    truthful,\n+    truthfulRate: rs.length ? truthful / rs.length : null,\n+    recovered,\n+    hungPastBudget,\n+    gate: rs.length >= T4_RUNS_PER_CLASS && truthful === rs.length && hungPastBudget === 0 ? \"PASS\" : \"FAIL\",\n+  };\n });\n+const t4 = {\n+  requiredClasses: T4_FAULT_CLASSES.length,\n+  requiredRunsPerClass: T4_RUNS_PER_CLASS,\n+  observedClasses: faultRows.filter((r) => r.n > 0).length,\n+  totalRuns: faultRows.reduce((n, r) => n + r.n, 0),\n+  gate: faultRows.every((r) => r.gate === \"PASS\") ? \"PASS\" : \"FAIL\",\n+};\n \n // T3 (REQ-QUAL-109): every T3 run counts. A run with no T3 result, too few steps or fewer than two compactions is\n // ineligible and fails the workload rather than leaving it; DEC-05 thresholds are false-absence 0, steering >= 95%.\n@@ -149,16 +182,17 @@ const t3 = t3Runs.length ? (() => {\n })() : null;\n \n if (process.argv.includes(\"--json\")) {\n-  console.log(JSON.stringify({ totals, pooled, rows, faults: faultRows, ...(t3 ? { t3 } : {}), replacements, ...(peerComparison ? { peerComparison } : {}) }, null, 2));\n+  console.log(JSON.stringify({ totals, pooled, rows, faults: faultRows, t4, ...(t3 ? { t3 } : {}), replacements, ...(peerComparison ? { peerComparison } : {}) }, null, 2));\n } else {\n   const pct = (x) => `${Math.round(x * 100)}%`;\n   console.log(`runs ${totals.runs} · false VERIFIED ${totals.falseVerified} · crashed ${totals.crashed} · harness errors ${totals.errors} · contaminated ${totals.contaminated} (excluded from pass rates) · replaced by rerun ${totals.replacedByRerun}\\n`);\n   console.log(\"| config | scored runs | correct | pass rate (95% CI) | false VERIFIED | crash rate | regressions | tokens / correct | wall s / correct |\\n|---|---|---|---|---|---|---|---|---|\");\n   for (const p of pooled) console.log(`| ${p.config} | ${p.n} | ${p.correct} | ${pct(p.rate)} (${pct(p.ci[0])}–${pct(p.ci[1])}) | ${p.falseVerified} | ${pct(p.crashRate)} | ${p.regressions} | ${p.tokensPerCorrect?.toFixed(0) ?? \"–\"} | ${p.wallSecondsPerCorrect?.toFixed(0) ?? \"–\"} |`);\n   if (faultRows.length) {\n-    console.log(\"\\n| injected fault | runs | truthful | recovered | hung past budget |\\n|---|---|---|---|---|\");\n-    for (const f of faultRows) console.log(`| ${f.kind} | ${f.n} | ${f.truthful} (${pct(f.truthfulRate)}) | ${f.recovered} | ${f.hungPastBudget} |`);\n+    console.log(\"\\n| T4 fault | runs | truthful | recovered | hung past budget | gate |\\n|---|---:|---:|---:|---:|---|\");\n+    for (const f of faultRows) console.log(`| ${f.kind} | ${f.n} | ${f.truthful} (${f.truthfulRate === null ? \"–\" : pct(f.truthfulRate)}) | ${f.recovered} | ${f.hungPastBudget} | ${f.gate} |`);\n   }\n+  console.log(`\\nT4 gate: ${t4.gate} (${t4.observedClasses}/${t4.requiredClasses} classes; ${t4.requiredRunsPerClass} runs required per class)`);\n   if (t3) {\n     console.log(`\\nT3 · ${t3.tasks} task(s), ${t3.runs} run(s)${t3.shapeMet ? \"\" : ` (needs ${T3_TASKS} tasks × ${T3_RUNS_PER_TASK} runs)`} · ineligible (steps < 60 or compactions < 2, or no result) ${t3.ineligible} · false absences ${t3.falseAbsences} · false presences ${t3.falsePresences} · contaminated ${t3.contaminated} · probe unanswered ${t3.probeUnanswered} · steering honoured ${t3.steeringHonoured}/${t3.steeringItems} (${pct(t3.steeringRate)}) · gate ${t3.gate}`);\n   }\n","exit_code":0,"duration":{"secs":0,"nanos":29846}},"started_at_ms":1792914183891,"completed_at_ms":1792914183892}}
