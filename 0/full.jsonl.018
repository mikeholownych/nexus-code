s`);\n        env.NEXUS_HOME = packageDir;\n      }\n      const sidecarArgs = [sidecar, \"--yes\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? [])];\n      return checkout ? { cmd: process.execPath, argv: sidecarArgs, env, protocol: true } : { cmd: \"/usr/bin/env\", argv: [\"node\", ...sidecarArgs], env, protocol: true };\n    }\n    return { cmd: agentIdentity.command, argv: [...agentIdentity.argsPrefix, \"run\", \"--yes\", \"--json\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? []), task.objective], env };\n  }\n  if (agent === \"aider\") {\n    return { cmd: agentIdentity.command, argv: [\"--model\", `openai/${config.model}`, \"--openai-api-base\", ep, \"--yes-always\", \"--no-auto-commits\", \"--no-dirty-commits\", \"--no-gitignore\", \"--no-show-model-warnings\", \"--no-check-update\", \"--analytics-disable\", \"--no-pretty\", \"--no-fancy-input\", ...(config.args ?? []), \"--message\", task.objective], env };\n  }\n  if (agent === \"opencode\") {\n    const dir = path.join(home, \".config/opencode\");\n    fs.mkdirSync(dir, { recursive: true });\n    const modelOptions = { temperature: sampling.temperature, ...(sampling.seed !== undefined ? { seed: sampling.seed } : {}) };\n    fs.writeFileSync(path.join(dir, \"opencode.json\"), JSON.stringify({\n      $schema: \"https://opencode.ai/config.json\",\n        }\n      } catch {}\n    }\n    return null;\n  }\n\n  /**\n   * Executes a task through the unified execution spine and durable state lifecycle (UI-001, UI-002, UI-003).\n   */\n  public async runTask(prompt: string, options: RunTaskOptions = {}): Promise<TaskExecutionResult> {\n    const startTime = Date.now();\n    let taskId = this.agent.getTaskId();\n\n    if (options.resumeTaskId) {\n      let targetTaskId = options.resumeTaskId;\n      if (targetTaskId === \"latest\") {\n        const targetWorkspace = this.config.workspace || process.cwd();\n        const tasks = this.stateManager\n          .listTasks({ workspace: targetWorkspace })\n          .filter((t) => t.taskId !== taskId);\n        if (tasks.length === 0) {\n          throw new Error(`no task to resume in ${targetWorkspace}; see 'nexus status'`);\n        }\n        targetTaskId = tasks[0].taskId;\n      }\n      const recovered = await this.recoverTask(targetTaskId);\n        [\"write_file\", \"edit_file\", \"patch_file\"].includes(toolName)\n      ) {\n        this.flightRecorder.recordFileDiff(\n          currentStep,\n          args.path || args.target_file || args.file_path || \"unknown\",\n          receipt.output,\n          args.replacements\n        );\n      }\n      if (toolName === \"task_completed\" && receipt.success) {\n        this.flightRecorder.recordSessionEnd(\n          args.summary || \"Task completed.\",\n          true,\n          this.totalTokens\n        );\n      }\n    }\n\n    this.ui.printToolResult(\n      toolName,\n      receipt.success,\n      receipt.output,\n      receipt.error\n    );\n    this.observer?.onToolEnd?.({ dispatch, callId: call.id, tool: toolName, success: receipt.success, output: receipt.output, error: receipt.error });\n    if (receipt.success) this.turnRemovedObservations.delete(observationKey(toolName, call.function.arguments));\n\n    const shouldExit = toolName === \"task_completed\" && receipt.success;\n    return { receipt, shouldExit };\n  }\n\n  private workspaceAvailableBytes(): number | null {\n    try {\n      const stats = fs.statfsSync(this.config.workspace);\n      const available = Number(stats.bavail) * Number(stats.bsize);\n      return Number.isSafeInteger(available) && available >= 0 ? available : null;\n    } catch {\n      return null;\n    }\n  }\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","create_time":1792917546.4949787}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
