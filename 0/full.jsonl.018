lace(/\\/$/, \"\")}/models`, headers: { host: target.host, ...(authToken ? { authorization: `Bearer ${authToken}` } : {}) }, ca }, (res) => {\n      let body = \"\";\n      res.setEncoding(\"utf8\");\n      res.on(\"data\", (c) => (body += c));\n      res.on(\"end\", () => { try { resolve(JSON.parse(body).data ?? []); } catch { resolve([]); } });\n    });\n    r.on(\"error\", () => resolve([]));\n    r.end();\n    let cancelled = false;\n    const out = client.request(\n      {\n        protocol: target.protocol,\n        hostname: target.hostname,\n        port: target.port || (target.protocol === \"https:\" ? 443 : 80),\n        method: req.method,\n        // The agent was given the proxy's URL with the upstream's path, so the request path is already the upstream's.\n        path: req.url,\n        headers: upstreamHeaders,\n        ca,\n      },\n      (upstreamRes) => {\n        upstreamResponse = upstreamRes;\n        if (UPSTREAM_DOWN.has(upstreamRes.statusCode ?? 0)) stats.upstreamFailures++;\n        else {\n          stats.answered++;\n          stats.firstAnswerAt ??= new Date().toISOString();\n        }\n        if (profile) {\n          for (const key of Object.keys(upstreamRes.headers)) if (key.startsWith(\"x-aihost-\")) delete upstreamRes.headers[key];\n          const isModels = req.method === \"GET\" && urlPath.endsWith(\"/models\");\n          const failed = (upstreamRes.statusCode ?? 200) >= 400;\n          if (isModels || failed) {\n            // Buffered: the catalog is rewritten to the profile's shape; error bodies may be reshaped.\n            let body = \"\";\n            upstreamRes.setEncoding(\"utf8\");\n            upstreamRes.on(\"data\", (c) => (body += c));\n            upstreamRes.on(\"end\", async () => {\n              if (isModels && !failed) {\n                let data = [];\ndiff --git a/eval/cgroup_supervisor.mjs b/eval/cgroup_supervisor.mjs\nindex 87f1dfa..752703e 100644\n--- a/eval/cgroup_supervisor.mjs\n+++ b/eval/cgroup_supervisor.mjs\n@@ -46,12 +46,49 @@ report({ cgroup: payload });\n \n let finished = false;\n let stopRequested = false;\n+const signalRequests = [];\n+let graceTimer = null;\n+let childResult = null;\n // The shell joins the payload cgroup before exec, so nothing task-controlled ever runs outside the limits.\n const child = spawn(\"/bin/sh\", [\"-c\", 'echo $$ > \"$1\" && shift && exec \"$@\"', \"sh\", path.join(payload, \"cgroup.procs\"), spec.cmd, ...spec.argv], {\n   env: { PATH: \"/usr/bin:/bin\" },\n   stdio: \"inherit\",\n });\n const killPayload = () => { try { fs.writeFileSync(path.join(payload, \"cgroup.kill\"), \"1\"); } catch {} };\n+const signalPayload = (name, graceMs) => {\n+  if (name !== \"SIGTERM\" || !Number.isSafeInteger(graceMs) || graceMs < 0 || graceMs > 30_000) return;\n+  const pids = (read(path.join(payload, \"cgroup.procs\")) ?? \"\").split(\"\\n\").filter(Boolean).map(Number).filter(Number.isSafeInteger);\n+  let delivered = 0;\n+  for (const pid of pids) {\n+    try { process.kill(pid, name); delivered++; } catch {}\n+  }\n+  const request = { name, requestedAt: new Date().toISOString(), pids: pids.length, delivered, graceMs, forced: false };\n+  signalRequests.push(request);\n+  if (graceTimer) clearTimeout(graceTimer);\n+  graceTimer = setTimeout(() => {\n+    if (/^populated 1$/m.test(read(path.join(payload, \"cgroup.events\")) ?? \"\")) {\n+      request.forced = true;\n+      killPayload();\n+    }\n+    graceTimer = null;\n+    if (childResult) finish(childResult.code, childResult.signal, childResult.spawnError);\n+  }, graceMs);\n+  graceTimer.unref();\n+};\n+let controlText = \"\";\n+const control = fs.createReadStream(null, { fd: 4, autoClose: false });\n+control.on(\"data\", (chunk) => {\n+  controlText += chunk.toString(\"utf8\");\n+  let newline;\n+  while ((newline = controlText.indexOf(\"\\n\")) >= 0) {\n+    const line = controlText.slice(0, newline);\n+    controlText = controlText.slice(newline + 1);\n+    try {\n+      con