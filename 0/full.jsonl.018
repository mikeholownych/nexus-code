{"timestamp":"2026-10-25T05:52:31.339Z","ordinal":326782,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1719e-226b-7611-b2cb-d4bf297bc667","call_id":"call_3717f15e0ee7421d82b247211af3b3c6","output":[{"type":"input_text","text":"Script completed\nWall time 2.1 seconds\nOutput:\n"},{"type":"input_text","text":"// Runs the CLI test suite with a throwaway HOME so no test (or anything it spawns: the sidecar, the TUI, PTY drivers)\n// can read or write the operator's ~/.nexus or ~/.config/nexus. The real home is passed as NEXUS_TEST_REAL_HOME so the\n// guard test can prove the isolation held. Arguments are test files; none means every test/*.test.ts.\n// NEXUS_KEEP_TEST_HOME=1 keeps the temporary home for inspection.\nimport { spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst cli = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst realHome = os.homedir();\nconst home = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-test-home-\"));\n\nconst files = process.argv.length > 2\n  ? process.argv.slice(2)\n  : fs.readdirSync(path.join(cli, \"test\")).filter((f) => f.endsWith(\".test.ts\")).sort().map((f) => path.join(\"test\", f));\n\nconst env = {\n  ...process.env,\n  HOME: home,\n  XDG_CONFIG_HOME: path.join(home, \".config\"),\n  XDG_DATA_HOME: path.join(home, \".local\", \"share\"),\n  XDG_STATE_HOME: path.join(home, \".local\", \"state\"),\n  XDG_CACHE_HOME: path.join(home, \".cache\"),\n  NEXUS_TEST_REAL_HOME: realHome,\n};\n// Rust and Node toolchains installed per user keep working under the throwaway home.\nfor (const [key, dir] of [[\"CARGO_HOME\", \".cargo\"], [\"RUSTUP_HOME\", \".rustup\"]]) {\n  if (!env[key] && fs.existsSync(path.join(realHome, dir))) env[key] = path.join(realHome, dir);\n}\n\nconst tsx = path.join(cli, \"node_modules\", \".bin\", \"tsx\");\nconst result = spawnSync(tsx, [\"--test\", \"--test-concurrency=1\", ...files], { cwd: cli, env, stdio: \"inherit\" });\n\nif (process.env.NEXUS_KEEP_TEST_HOME === \"1\") console.error(`test home kept at ${home}`);\nelse fs.rmSync(home, { recursive: true, force: true });\n\nif (result.error) throw result.error;\nprocess.exit(result.status ?? 1);\n3600381 3600365       11:20  0.0 Sl   node /home/mike/nexus-wt/defect-eval-resource-assertion-snapshot/cli/node_modules/.bin/tsx --test --test-concurrency=1 test/agent_observer.test.ts test/agt111_subagent_parity.test.ts test/app.test.ts test/approval_policy.test.ts test/approval_review.test.ts test/audit_rotation.test.ts test/authority.test.ts test/build_identity.test.ts test/candidate.test.ts test/capabilities.test.ts test/check_requirements.test.ts test/checkpoint_snapshot_confinement.test.ts test/cli_option_scope.test.ts test/client_robustness.test.ts test/cloud_providers.test.ts test/compaction_continuity.test.ts test/compatibility_components.test.ts test/compatibility_legacy.test.ts test/config.test.ts test/context_auto_compaction.test.ts test/context_capacity.test.ts test/context_capacity_midturn.test.ts test/context_capacity_runtask.test.ts test/context_convergence.test.ts test/convergence_integration.test.ts test/convergence_invariants.test.ts test/convergence_scheduling.test.ts test/credential_boundary.test.ts test/credential_home.test.ts test/deletion_guard.test.ts test/doctor.test.ts test/durable_continuity.test.ts test/egress.test.ts test/egress_persistence_equivalence.test.ts test/engine_handshake.test.ts test/eval_hardened.test.ts test/eval_harness.test.ts test/eval_host_bubblewrap.test.ts test/eval_host_operator_home.test.ts test/eval_integrity.test.ts test/eval_score_diagnostics.test.ts test/eval_t3.test.ts test/eval_version_probe_storage.test.ts test/evaluator.test.ts test/evidence.test.ts test/execution_tracking.test.ts test/experimental_and_readonly.test.ts test/ext004_audit.test.ts test/fetch_web_ssrf.test.ts test/fil