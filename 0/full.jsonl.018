s(config.env ?? {}).find((key) => /KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL/i.test(key));\n  if (forbiddenEnv) throw new Error(`candidate configuration may not contain credential-like environment key ${forbiddenEnv}`);\n  const ep = \"http://127.0.0.1:40127/v1\";\n  const env = {\n    PATH: config.env?.PATH ?? \"/usr/bin:/bin\", LANG: config.env?.LANG ?? \"C.UTF-8\", LC_ALL: config.env?.LC_ALL ?? \"C.UTF-8\",\n    TERM: config.env?.TERM ?? \"dumb\", HOME: \"/home/eval\", PWD: \"/workspace\", CI: \"1\",\n    LOCAL_LLM_API_KEY: localToken, OPENAI_API_KEY: localToken, GW_KEY: localToken,\n    XDG_CONFIG_HOME: \"/home/eval/.config\", XDG_DATA_HOME: \"/home/eval/.local/share\", XDG_STATE_HOME: \"/home/eval/.local/state\",\n  };\n  const agent = config.agent ?? \"nexus\";\n  if (agent === \"nexus\") {\n    env.LOCAL_LLM_ENDPOINT = ep;\n    const contextArgs = nexusContextLimitArgs(config, limits.context);\n    if (task.tier === \"T3\") {\n      // T3 drives the sidecar, the operator channel that carries steering, with the same model, budgets and limits.\n      const checkout = agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\");\n      // An installed package is <package>/bin/nexus with the sidecar at <package>/lib/cli/dist/sidecar.js.\n      const packageDir = checkout ? null : path.dirname(path.dirname(fs.realpathSync(agentIdentity.command)));\n      const sidecar = checkout ? path.join(ROOT, \"cli/dist/sidecar.js\") : path.join(packageDir, \"lib/cli/dist/sidecar.js\");\n      if (!fs.existsSync(sidecar)) throw new Error(`T3 needs the Nexus sidecar at ${sidecar}`);\n      if (packageDir) {\n        // The launcher is bypassed, so the package itself must be mounted: it has to sit under sandboxRuntimeRoots.\n        const roots = (config.sandboxRuntimeRoots ?? []).flatMap((root) => { try { return [fs.realpathSync(root)]; } catch { return []; } });\n        if (!roots.some((root) => packageDir === root || packageDir.startsWith(`${root}${path.sep}`))) throw new Error(`T3 runs the sidecar from ${packageDir}, which must be under sandboxRuntimeRoots`);\n        env.NEXUS_HOME = packageDir;\n      }\n      const sidecarArgs = [sidecar, \"--yes\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? [])];\n      return checkout ? { cmd: process.execPath, argv: sidecarArgs, env, protocol: true } : { cmd: \"/usr/bin/env\", argv: [\"node\", ...sidecarArgs], env, protocol: true };\n    }\n    return { cmd: agentIdentity.command, argv: [...agentIdentity.argsPrefix, \"run\", \"--yes\", \"--json\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? []), task.objective], env };\n  }\n  if (agent === \"aider\") {\n    return { cmd: agentIdentity.command, argv: [\"--model\", `openai/${config.model}`, \"--openai-api-base\", ep, \"--yes-always\", \"--no-auto-commits\", \"--no-dirty-commits\", \"--no-gitignore\", \"--no-show-model-warnings\", \"--no-check-update\", \"--analytics-disable\", \"--no-pretty\", \"--no-fancy-input\", ...(config.args ?? []), \"--message\", task.objective], env };\n  }\n  if (agent === \"opencode\") {\n    const dir = path.join(home, \".config/opencode\");\n    fs.mkdirSync(dir, { recursive: true });\n    const modelOptions = { temperature: sampling.temperature, ...(sampling.seed !== undefined ? { seed: sampling.seed } : {}) };\n    fs.writeFileSync(path.join(dir, \"opencode.json\"), JSON.stringify({\n      $schema: \"https://opencode.ai/config.json\",\n      autoupdate: false,\n      share: \"disabled\",\n      permission: { edit: \"allow\", bash: \"allow\", webfetch: \"deny\" },\n      agent: { \"nexus-eval\": { mode: \"primary\", steps: budget.steps } },\n      provider: { gw: { npm: \"@ai-sdk/openai-compatible\", name: \"gateway\", options: { baseURL: ep, apiKey: \"{env:GW_KEY}\" }, models: { [config.model]: { name: config.model, limit: limits, options: modelOptions } } } },\n      model: `gw/${config.model}`,\n    }, null, 2));\n    // Provider packages are cached across runs (not per run): the cache holds code, not state.\n    env.XDG_CACHE_HOME = path.join(home, \".cache\");\n    return { cmd: agentIdentity.command, argv: [\"run\", \"--agent\", \"nexus-eval\", \"--model\", `gw/${config.model}`, ...(config.args ?? []), task.objective], env };\n  }\n  if (agent === \"goose\") {\n    const u = new URL(ep);\n    Object.assign(env, { GOOSE_PROVIDER: \"openai\", GOOSE_MODEL: config.model, OPENAI_HOST: u.origin, OPENAI_BASE_PATH: `${u.pathname.replace(/^\\/|\\/$/g, \"\")}/chat/completions`, GOOSE_MODE: \"auto\", GOOSE_DISABLE_KEYRING: \"1\", GOOSE_CONTEXT_LIMIT: String(limits.context), GOOSE_MAX_TOKENS: String(limits.output), GOOSE_MAX_TURNS: String(budget.steps), GOOSE_TEMPERATURE: String(sampling.temperature) });\n…1051 tokens truncated…e model: ${pc.bold(config.model)}`));\n          }\n        }\n      } catch {\n        // Fallback to default\n      }\n    }\n\n    if (!isJson && (config.provider || config.plannerProvider || config.coderProvider)) console.error(pc.dim(describeTarget(config)));\n    const app = new ApplicationCore(config);\n\n    let resumeTaskId: string | undefined;\n    if (options.resume !== undefined && options.resume !== false) {\n      if (typeof options.resume === \"string\" && options.resume !== \"latest\") {\n        resumeTaskId = options.resume;\n      } else {\n        const targetWorkspace = config.workspace || process.cwd();\n        const tasks = app\n          .getStateManager()\n          .listTasks({ workspace: targetWorkspace })\n          .filter((t) => t.taskId !== app.getTaskId());\n        if (tasks.length === 0) {\n          console.error(`no task to resume in ${targetWorkspace}; see 'nexus status'`);\n          app.shutdown();\n          exitAfterFlush(2);\n          return;\n        }\n        resumeTaskId = tasks[0].taskId;\n      }\n      if (!prompt) {\n        prompt = \"continue\";\n      }\n    } else if (!prompt) {\n      console.error(\"error: missing required argument 'prompt'\");\n      app.shutdown();\n      exitAfterFlush(1);\n      return;\n    }\n\n    // Operator stop authority: first SIGINT cancels the active turn; a second one terminates immediately.\n    const abort = new AbortController();\n    let sigints = 0;\n    const onSigint = () => {\n      sigints++;\n      if (sigints === 1) {\n        abort.abort(new Error(\"SIGINT\"));\n        if (!isJson) console.error(pc.yellow(\"\\nInterrupt received: no further work will be started (Ctrl-C again to terminate immediately).\"));\n      } else {\n        process.exit(130);\n      }\n    };\n    process.on(\"SIGINT\", onSigint);\n\n    try {\n      const result = await app.runTask(prompt, {\n        json: isJson,\n        resumeTaskId,\n        signal: abort.signal,\n      });\n\n      const cloud = UsageLedger.global().cloudTotals();\n      if (isJson) {\n        console.log(JSON.stringify(cloud.requests ? { ...result, cloudUsage: cloud } : result, null, 2));\n      } else if (cloud.requests) {\n        console.error(pc.dim(UsageLedger.global().summary()!));\n      }\n\n      app.shutdown();\n231:async function runDefault(options: any): Promise<void> {\n285:  .option(\"-r, --resume [id]\", \"Resume previous session (defaults to latest if id omitted)\")\n358:  .option(\"-r, --resume [id]\", \"Resume previous session (defaults to latest if id omitted)\")\n401:  .option(\"-r, --resume [id]\", \"Resume previous session or task state\")\n  .option(\"--record-flight\", \"Record execution into an append-only deterministic .flightlog\")\n  .option(\"--planner-model <name>\", \"Deep reasoning model for architecture planning (o3, R1, Sonnet)\")\n  .option(\"--planner-endpoint <url>\", \"Dedicated inference endpoint for planner model\")\n  .option(\"--coder-model <name>\", \"High-throughput model for surgical code implementation (Qwen 2.5 Coder)\")\n  .option(\"--coder-endpoint <url>\", \"Dedicated inference endpoint for coder model\")\n  .option(\"--tdd\", \"Enforce strict RED-GREEN-REFACTOR Test-Driven Development protocol\")\n  .option(\"--provider <id>\", \"Cloud inference provider: openrouter, openai, anthropic, compatible (default: appliance endpoint)\")\n  .option(\"--base-url <url>\", \"Override the provider's base URL (operator-only; required for 'compatible')\")\n  .option(\"--planner-provider <id>\", \"Cloud provider for the planner model (requires --planner-model)\")\n  .option(\"--coder-provider <id>\", \"Cloud provider for the coder model (requires --coder-model)\")\n  .option(\"-j, --json\", \"Output machine-readable JSON structured result (UI-002, UI-003)\")\n  .option(\"-r, --resume [id]\", \"Resume previous session or task state\")\n  .action(async (promptParts: string[], _options: any, cmd: Command) => {\n    // Preserve inherited CLI values when the command-level duplicate only has\n    // its default; explicitly supplied command options still take precedence.\n    const options = cmd.optsWithGlobals();\n    for (const option of cmd.options) {\n      const name = option.attributeName();\n      if (cmd.getOptionValueSource(name) !== \"default\") options[name] = _options[name];\n    }\n    let prompt = promptParts.join(\" \").trim();\n    const config = buildConfig(options);\n    config.surface = \"headless\";\n    const isJson = Boolean(options.json);\n\n    // Auto-detect loaded model if model is 'local-model'\n    if (config.model === \"local-model\") {\n      try {\n        const client = new LocalLlmClient(config);\n        const models = await client.listModels();\n        if (models.length > 0) {\n          config.model = models[0];\n          if (!isJson) {\n            console.log(pc.dim(`🔍 Auto-detected active model: ${pc.bold(config.model)}`));\n          }\n        }\n      } catch {\n        // Fallback to default\n      }\n    }\n\n    if (!isJson && (config.provider || config.plannerProvider || config.coderProvider)) console.error(pc.dim(describeTarget(config)));\n    const app = new ApplicationCore(config);\n\n    let resumeTaskId: string | undefined;\n    if (options.resume !== undefined && options.resume !== false) {\n      if (typeof options.resume === \"string\" && options.resume !== \"latest\") {\n        resumeTaskId = options.resume;\n      } else {\n        const targetWorkspace = config.workspace || process.cwd();\n        const tasks = app\n          .getStateManager()\n          .listTasks({ workspace: targetWorkspace })\n          .filter((t) => t.taskId !== app.getTaskId());\n        if (tasks.length === 0) {\n          console.error(`no task to resume in ${targetWorkspace}; see 'nexus status'`);\n          app.shutdown();\n          exitAfterFlush(2);\n          return;\n        }\n        resumeTaskId = tasks[0].taskId;\n      }\n      if (!prompt) {\n        prompt = \"continue\";\n      }\n    } else if (!prompt) {\n      console.error(\"error: missing required argument 'prompt'\");\n      app.shutdown();\n      exitAfterFlush(1);\n      return;\n    }\n\n    // Operator stop authority: first SIGINT cancels the active turn; a second one terminates immediately.\n    const abort = new AbortController();\n    let sigints = 0;\n    const onSigint = () => {\n      sigints++;\n      if (sigints === 1) {\n        abort.abort(new Error(\"SIGINT\"));\n        if (!isJson) console.error(pc.yellow(\"\\nInterrupt received: no further work will be started (Ctrl-C again to terminate immediately).\"));\n      } else {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a171fd-3278-7ca3-ad25-d2f716cb2b15","create_time":1792913917.652384}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
