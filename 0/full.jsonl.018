vocationRequest,\n  InvocationContext,\n  extractTargetResources,\n} from \"./core/spine.js\";\nimport { AuthorityAdmissionEngine } from \"./core/authority.js\";\nimport {\n  CandidateTracker,\n  ValidationReceipt,\n  computeCandidateIdentitySync,\n  hashContent,\n} from \"./core/candidate.js\";\nimport {\n  ExecutionTracker,\n  REPEAT_THRESHOLD,\n  actionKind,\n  backoffMs,\n  combineState,\n  ledgerStateIdentity,\n  type ObservationVerdict,\n} from \"./core/execution_tracking.js\";\nimport { parseModelResponse, repairJsonWithClass, isWriteOrExecTool } from \"./parser.js\";\nimport { TerminalUI, redactSecrets } from \"./ui.js\";\nimport { getGitInfo } from \"./git.js\";\nimport { trustedProjectRules } from \"./startup_trust.js\";\nimport { SkillManager } from \"./skills.js\";\nimport { McpClientManager } from \"./mcp.js\";\nimport { PluginManager } from \"./plugins.js\";\nimport { extractCompilerDiagnostics, formatDiagnosticHints } from \"./diagnostics.js\";\nimport { SecurityManager } from \"./security.js\";\nimport { calculateContextBudget, countTokens, isContextAdmissible, isContextPressureHigh, estimateNextRequestTokens, TokenBudget } from \"./tokens.js\";\nimport { selectRelevantFewShots } from \"./fewshots.js\";\nimport { FlightRecorder } from \"./flight.js\";\nimport { WorktreeManager } from \"./worktree.js\";\nimport { isSandboxAvailable } from \"./sandbox.js\";\nimport { runTestSuiteWithExecutor, discoverVerifier, describeVerifier, hasExecutedTests, isVerifierDeliverableBound, isFilteredVerifierCommand, verifierTimeoutSecs } from \"./tester.js\";\nimport { ENABLE_TOOLS_CAPABILITY, TOOL_GROUPS, groupsTriggeredBy, toolGroupOf } from \"./core/tool_groups.js\";\nimport { judgeWithoutCopy, prepareBaselineTestsCopy, requiresWorkspaceVerifierDefinitionBinding, trustedDeliverablesFromBaseline, testsChangedSince, snapshotTests, snapshotVerifierDefinition, verifierDefinitionChangedSince, type ChangeBaseline, type Independence } from \"./core/independent_check.js\";\nimport { ensurePrivateDir, appendPrivateFile } from \"./core/durable_file.js\";\n\n/** Tools that edit files directly: the first one of an unverified change triggers the pre-change verifier run. */\nconst FILE_EDIT_TOOLS = new Set([\"write_file\", \"edit_file\", \"patch_file\", \"delete_file\"]);\nimport { credentialOriginOf, InferenceError, type TruncatedCall, TokenCountError } from \"./client.js\";\nimport {\n  TurnResult,\n  VerificationEvidence,\n  InterruptionRecord,\n  InferenceFailure,\n  CapacityRecord,\n  ModelStop,\n  ProviderRecoveryRecord,\n  assertTurnResultInvariants,\n  deepFreezeTurn,\n  summarizeTurn,\n  lifecycleStatusForTurn,\n  turnSucceeded,\n} from \"./core/turn.js\";\nimport { createHash } from \"node:crypto\";\nimport { HybridSearchEngine } from \"./embeddings.js\";\n925:  private toolDispatchSeq = 0;\n957:  private currentTaskId: string = \"task-\" + randomUUID().slice(0, 8);\n467:function agentCommand(task, ws, home, budget, agentIdentity, localToken) {\n529:async function runAgent(task, ws, home, budget, agentIdentity, proxyDirectory, localToken, proxy) {\n561:function runAgentAttempt(task, ws, home, budget, agentIdentity, proxyDirectory, localToken, { signalAfterAnswer = false, proxy = null, resume = false } = {}) {\n562:  const { cmd, argv, env, protocol } = agentCommand(task, ws, home, budget, agentIdentity, localToken);\n","exit_code":0,"duration":{"secs":0,"nanos":804273506}},"started_at_ms":1792917441929,"completed_at_ms":1792917442734}}
