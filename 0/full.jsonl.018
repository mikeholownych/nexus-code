ve the hard limit are clamped. */\n  maxEntries?: number;\n  /** Optional stricter byte bound; values above the hard limit are clamped. */\n  maxTotalBytes?: number;\n}\n}\n\nexport interface VerificationAttempt {\n  n: number;\n  command: string;\n  /** Candidate identity of the workspace the verifier ran on (tracked and untracked, non-ignored files). */\n  inputs: string;\n  /**\n   * What else must be unchanged before a prior failure is reused: the agent process that ran it, the count of\n   * mutating tool calls (any edit, write or shell command) at that time, and a fingerprint of inputs git ignores\n   * (PATH, dependency install markers, .env files).\n   */\n  epoch?: string;\n  mutationSeq?: number;\n  external?: string;\n  status: VerificationStatus | \"SKIPPED_UNCHANGED_INPUTS\";\n  isDeliverableBound?: boolean;\n  /** False when the run passed but nothing independent of the agent shows the change (see core/independent_check). */\n  independent?: boolean;\n  filtered?: boolean;\n  at: string;\n  /** First failing line of the verifier's output, when it failed. */\n  failedCheck?: string;\n}\n\nexport interface ObjectiveOutcome {\n  status: \"completed\" | \"incomplete\" | \"blocked\";\n  reason: string;\n  failedCheck?: string;\n  remaining: string[];\n  nextAction?: string;\n  at: string;\n}\n            ));\n            // A discovered verifier's pass makes the change VERIFIED only on independent evidence (fail-before /\n            // pass-after on tests the change did not write); the operator's configured verifier is their own check.\n            const independence = source === \"discovered\" && testRes.success && isDeliverableBound ? await this.judgeIndependence(verifierCommand, deadlineSecs, onConfirm) : undefined;\n            const evidence: VerificationEvidence = {\n              status: testRes.success ? \"PASSED\" : testRes.timedOut ? \"TIMED_OUT\" : \"FAILED\",\n              command: verifierCommand,\n              source,\n              exitSuccess: testRes.success,\n              hasExecutedTests: hasExecuted,\n              isDeliverableBound,\n              ...(independence ? { independent: independence.independent, independenceDetail: independence.detail } : {}),\n              ...(testRes.timedOut ? { deadlineSecs } : {}),\n              outputSha256: createHash(\"sha256\").update(testRes.rawOutput || \"\").digest(\"hex\"),\n              candidateId,\n              at: new Date().toISOString(),\n            };\n            this.verificationEvidence = evidence;\n            this.verificationEvidenceRawOutput = testRes.rawOutput || \"\";\n            if (configured) this.turnConfiguredVerifier = testRes.success ? \"PASSED\" : \"FAILED\";\n            if (this.objective && candidateId) {\n              recordAttempt(this.objective, {\n                command: verifierCommand,\n","exit_code":0,"duration":{"secs":0,"nanos":26798}},"started_at_ms":1792917241325,"completed_at_ms":1792917241325}}
