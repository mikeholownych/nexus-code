{"timestamp":"2026-10-25T07:43:45.203Z","ordinal":329734,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a171fd-3278-7ca3-ad25-d2f716cb2b15","item":{"type":"CommandExecution","id":"exec-00a90038-12c1-4901-a33b-7f8ab74b7eeb","process_id":"26987","command":["/usr/bin/zsh","-lc","sed -n '1,130p' eval/score.mjs; sed -n '1,70p' eval/run.mjs; sed -n '50,72p' docs/v1.0.0/specs/SPEC-10-v1-qualification-and-evaluation.md; "],"cwd":"file:///home/mike/nexus-wt/plan10-pr10c-t4","parsed_cmd":[{"type":"read","cmd":"sed -n '1,130p' eval/score.mjs","name":"score.mjs","path":"eval/score.mjs"},{"type":"read","cmd":"sed -n '1,70p' eval/run.mjs","name":"run.mjs","path":"eval/run.mjs"},{"type":"read","cmd":"sed -n '50,72p' docs/v1.0.0/specs/SPEC-10-v1-qualification-and-evaluation.md","name":"SPEC-10-v1-qualification-and-evaluation.md","path":"docs/v1.0.0/specs/SPEC-10-v1-qualification-and-evaluation.md"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"#!/usr/bin/env node\n// Scores eval results (results.jsonl from eval/run.mjs). Scores are reported separately and never combined\n// (qualification assessment §9): completion claimed, artifact correct (hidden tests), false VERIFIED, regressions,\n// bounded failure, wall time, steps, tokens — per task and configuration, with 95 % Wilson intervals for rates.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst T4_FAULT_CLASSES = [\n  \"refuse\",\n  \"overloaded\",\n  \"stream_cut\",\n  \"truncate\",\n  \"hanging_test_command\",\n  \"full_disk\",\n  \"context_overflow\",\n  \"malformed_tool_json\",\n  \"sigterm_resume\",\n];\nconst T4_RUNS_PER_CLASS = 5;\n\n// Several files may be given: a later record for the same configuration, task and run replaces an earlier one (a rerun\n// of a run that failed on infrastructure, see eval/infra.mjs). The replaced records stay in their files.\nconst files = process.argv.slice(2).filter((a) => !a.startsWith(\"--\"));\nconst pairMode = process.argv.includes(\"--pairs\");\nif (!files.length) {\n  console.error(\"usage: eval/score.mjs <results.jsonl>... [--pairs] [--json]\");\n  process.exit(2);\n}\nconst peerComparison = pairMode ? validateMatchedPeers(files) : null;\nconst byRun = new Map();\n/** Every replacement is listed (REQ-QUAL-106): which run, what it showed, and what the rerun showed. */\nconst replacements = [];\nconst outcomeOf = (r) => r.error ? `error: ${r.error}` : r.turn?.outcome ?? (r.timedOut ? \"timed out\" : `exit ${r.exitCode}`);\nfor (const file of files) {\n  for (const r of fs.readFileSync(file, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l))) {\n    const key = `${r.config}\\t${r.task}\\t${r.run}`;\n    const prior = byRun.get(key);\n    if (prior) replacements.push({ config: r.config, task: r.task, run: r.run, was: outcomeOf(prior), now: outcomeOf(r) });\n    byRun.set(key, r);\n  }\n}\nconst replaced = replacements.length;\nconst records = [...byRun.values()];\n/** A run that ended without a result of its own: Nexus without a turn report, or any agent killed by a signal. */\nconst crashed = (r) => !r.error && !r.timedOut && (r.exitCode === null || ((r.agent ?? \"nexus\") === \"nexus\" && !r.turn));\n\n/** 95 % Wilson score interval for k successes out of n. */\nexport function wilson(k, n) {\n  if (!n) return [0, 0];\n  const z = 1.96;\n  const p = k / n;\n  const denom = 1 + (z * z) / n;\n  const centre = (p + (z * z) / (2 * n)) / denom;\n  const half = (z * Math.sqrt((p * (1 - p)) / n + (z * z) / (4 * n * n))) / denom;\n  return [Math.max(0, centre - half), Math.min(1, centre + half)];\n}\n\nconst median = (xs) => {\n  const s = xs.filter((x) => typeof x === \"number\").sort((a, b) => a - b);\n  return s.length ? (s.length % 2 ? s[(s.length - 1) / 2] : (s[s.length / 2 - 1] + s[s.length / 2]) / 2) : null;\n};\n\nconst groups = new Map();\nfor (const r of records) {\n  const key = `${r.config}\\t${r.task}`;\n  if (!groups.has(key)) groups.set(key, []);\n  groups.get(key).push(r);\n}\n\nconst rows = [...groups.entries()].map(([key, rs]) => {\n  const [config, task] = key.split(\"\\t\");\n  const n = rs.length;\n  const count = (f) => rs.filter(f).length;\n  const correct = count((r) => r.hiddenPass);\n  return {\n    config,\n    task,\n    tier: rs[0].tier,\n    n,\n    claimed: count((r) => r.claimedComplete),\n    correct,\n    correctCI: wilson(correct, n),\n    falseVerified: count((r) => r.falseVerified),\n    regressions: count((r) => r.regressionPass === false),\n    errors: count((r) => r.error),\n    contaminated: count((r) => r.contaminated),\n    timedOut: count((r) => r.timedOut),\n    medianWallS: median(rs.map((r) => r.wallMs / 1000)),\n    medianSteps: median(rs.map((r) => r.turn?.steps?.used)),\n    medianTokens: median(rs.map((r) => r.tokens?.total)),\n  };\n});\n\nconst totals = {\n  runs: records.length,\n  falseVerified: records.filter((r) => r.falseVerified).length,\n  errors: records.filter((r) => r.error).length,\n  crashed: records.filter(crashed).length,\n  contaminated: records.filter((r) => r.contaminated).length,\n  replacedByRerun: replaced,\n};\n\n// Pooled rates leave contaminated runs out (the agent could have seen the hidden tests); they are counted separately.\nconst pooled = [...new Set(records.map((r) => r.config))].map((config) => {\n  const all = records.filter((r) => r.config === config);\n  const rs = all.filter((r) => !r.contaminated);\n  const k = rs.filter((r) => r.hiddenPass).length;\n  const sum = (xs) => xs.reduce((a, b) => a + (b ?? 0), 0);\n  return {\n    config,\n    n: rs.length,\n    excludedContaminated: all.length - rs.length,\n    correct: k,\n    rate: rs.length ? k / rs.length : 0,\n    ci: wilson(k, rs.length),\n    falseVerified: all.filter((r) => r.falseVerified).length,\n    crashRate: all.length ? all.filter(crashed).length / all.length : 0,\n    regressions: rs.filter((r) => r.regressionPass === false).length,\n    // Cost of the whole configuration's runs per correct result (failed runs cost too).\n    tokensPerCorrect: k ? sum(rs.map((r) => r.tokens?.total)) / k : null,\n    wallSecondsPerCorrect: k ? sum(rs.map((r) => r.wallMs)) / 1000 / k : null,\n  };\n});\n\n// T4: emit all nine preregistered classes, including empty rows. Proxy, task-fixture, and\n// runner-injected events share one scoring path so a proxy-only result cannot look complete.\nconst t4Events = (r) => [\n  ...(r.model?.faultsInjected ?? []).map((f) => ({ ...f, source: f.source ?? \"model_proxy\" })),\n  ...(r.t4FaultsInjected ?? []),\n];\n#!/usr/bin/env node\n// Runs evaluation tasks against an agent configuration and appends one JSON line per run (see eval/README.md).\n// Each run gets a fresh workspace (the task's repository at its pinned commit, or its fixture), the agent runs with the\n// task's budgets and a wall-clock timeout, then the task's hidden tests (never present while the agent runs) and its\n// regression command are run in that workspace. Nothing is scored here: eval/score.mjs reads the JSON lines.\nimport { spawnSync } from \"node:child_process\";\nimport { createHash, randomBytes } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { startModelProxy } from \"./model_proxy.mjs\";\nimport { asUserSpec, corpusManifestProblem, corpusTaskRows, fetchModelEntry, hiddenTestIsolationProblem, modelFingerprint, nexusContextLimitArgs, nexusLimitsProblem, qualificationBudgetProblem, runtimeCorpusOverlapProblem, taskTreeDigest, validateTask } from \"./validate.mjs\";\nimport { agentSandboxArgv, assertNoSymlinks, confinedPath, grantRunAsAccess, hiddenOutputHasTests, isolatedProcessArgv, normalizeRunAsPermissions, runIsolated, runIsolatedProcess, sandboxAvailable, stageHiddenFiles } from \"./isolate.mjs\";\nimport { runBlackBoxOracle } from \"./oracle.mjs\";\nimport { stageRepoWorkspace } from \"./workspace.mjs\";\nimport { applyAgentChanges, cloneWorkspace } from \"./hardened_check.mjs\";\nimport { containmentProblem, resourceProbeProblem, spawnContained } from \"./resources.mjs\";\nimport { StringDecoder } from \"node:string_decoder\";\nimport { commandBaseline, countCompactions, createT3Driver, scoreT3Run, steeringBaseline, steeringPrecondition, t3Snapshot } from \"./t3.mjs\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst args = parseArgs(process.argv.slice(2));\nif (args.out) args.out = path.resolve(args.out); // agents run elsewhere: paths handed to them must be absolute\nif (!args.config || !args.out) {\n  console.error(\"usage: eval/run.mjs --config eval/configs/<name>.json --out <dir> [--tasks eval/tasks] [--only id,id] [--runs N]\");\n  process.exit(2);\n}\nconst configBytes = fs.readFileSync(args.config);\nconst configSha256 = createHash(\"sha256\").update(configBytes).digest(\"hex\");\nconst config = JSON.parse(configBytes.toString(\"utf8\"));\nconst tasksDir = path.resolve(args.tasks ?? path.join(ROOT, \"eval/tasks\"));\nfunction custodyCorpusPathsForRun() {\n  return [\n    config.corpusCustody?.reportPath,\n    config.corpusCustody?.storeRoot,\n    config.corpusCustody?.validatorPath,\n    config.corpusCustody?.referencePath,\n    config.corpusCustody?.authorLogPath,\n  ].filter(Boolean);\n}\nfunction protectedCorpusPathsForRun() {\n  const parent = path.dirname(tasksDir);\n  const evalDir = path.join(ROOT, \"eval\");\n  const includeParent = config.qualification === true || fs.realpathSync(parent) !== fs.realpathSync(evalDir);\n  return [tasksDir, ...(includeParent ? [parent] : []), ...custodyCorpusPathsForRun()];\n}\nconst runs = Number(args.runs ?? config.runs ?? 1);\nconst only = args.only ? new Set(String(args.only).split(\",\")) : null;\n// --pairs \"task run,task run\": rerun exactly these (runs that failed on infrastructure; see eval/infra.mjs).\nconst pairs = args.pairs ? String(args.pairs).split(\",\").filter(Boolean).map((p) => p.trim().split(/\\s+/)) : null;\nfs.mkdirSync(path.dirname(args.out), { recursive: true });\ntry {\n  fs.mkdirSync(args.out, { mode: 0o700 });\n  fs.chmodSync(args.out, 0o700);\n} catch (error) {\n  if (error.code === \"EEXIST\") {\n    console.error(\"eval/run.mjs: output directory must be new; refusing to overwrite or append to prior evidence\");\n    process.exit(2);\n  }\n  throw error;\n}\nconst resultsFile = path.join(args.out, \"results.jsonl\");\n\nconst identity = harnessIdentity();\nconst availableTaskIds = fs.readdirSync(tasksDir).filter((d) => {\n  const entry = path.join(tasksDir, d);\n  try { return fs.lstatSync(entry).isDirectory() && fs.existsSync(path.join(entry, \"task.json\")); }\n  catch { return false; }\n}).sort();\n   - an allow-listed environment;\n   - serial execution, or recorded queueing.\n\n   A run with any field missing is invalid.\n3. **REQ-QUAL-103. Repetitions and peers.** At least 5 runs per (task, config). Matched peers are Goose and OpenCode on the same model (DEC-05).\n4. **REQ-QUAL-104. Metrics, reported separately.**\n   - hidden-test correctness;\n   - completion claimed;\n   - **false VERIFIED** (hard gate = 0);\n   - regressions (repo suite, plus a pre/post diff of previously passing tests);\n   - crash rate and timeout rate;\n   - bounded-failure truthfulness;\n   - operator interventions (= 0 in `run` mode);\n   - tokens and wall time per correct task.\n5. **REQ-QUAL-105. T4 fault injection.** 9 fault classes × 5 runs (DEC-05 amendment, 2026-10-17: the union of the distinct scenarios below):\n   1. gateway refuses connections mid-turn;\n   2. 5xx/overloaded;\n   3. stream cut mid-tool-call;\n   4. output-limit truncation;\n   5. hanging test command;\n   6. workspace disk full;\n   7. context overflow at 32k;\n   8. malformed tool-call JSON;\n","exit_code":0,"duration":{"secs":0,"nanos":717978400}},"started_at_ms":1792914224484,"completed_at_ms":1792914225203}}
{"timestamp":"2026-10-25T07:43:46.264Z","ordinal":329735,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17203-fc58-7102-b5ee-77e8f48847f4","call_id":"call_93f7b4e1503041d5b7d4a956787c0070","output":[{"type":"input_text","text":"Script completed\nWall time 3.0 seconds\nOutput:\n"},{"type":"input_text","text":"#!/usr/bin/env node\n// Scores eval results (results.jsonl from eval/run.mjs). Scores are reported separately and never combined\n// (qualification assessment §9): completion claimed, artifact correct (hidden tests), false VERIFIED, regressions,\n// bounded failure, wall time, steps, tokens — per task and configuration, with 95 % Wilson intervals for rates.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst T4_FAULT_CLASSES = [\n  \"refuse\",\n  \"overloaded\",\n  \"stream_cut\",\n  \"truncate\",\n  \"hanging_test_command\",\n  \"full_disk\",\n  \"context_overflow\",\n  \"malformed_tool_json\",\n  \"sigterm_resume\",\n];\nconst T4_RUNS_PER_CLASS = 5;\n\n// Several files may be given: a later record for the same configuration, task and run replaces an earlier one (a rerun\n// of a run that failed on infrastructure, see eval/infra.mjs). The replaced records stay in their files.\nconst files = process.argv.slice(2).filter((a) => !a.startsWith(\"--\"));\nconst pairMode = process.argv.includes(\"--pairs\");\nif (!files.length) {\n  console.error(\"usage: eval/score.mjs <results.jsonl>... [--pairs] [--json]\");\n  process.exit(2);\n}\nconst peerComparison = pairMode ? validateMatchedPeers(files) : null;\nconst byRun = new Map();\n/** Every replacement is listed (REQ-QUAL-106): which run, what it showed, and what the rerun showed. */\nconst replacements = [];\nconst outcomeOf = (r) => r.error ? `error: ${r.error}` : r.turn?.outcome ?? (r.timedOut ? \"timed out\" : `exit ${r.exitCode}`);\nfor (const file of files) {\n  for (const r of fs.readFileSync(file, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l))) {\n    const key = `${r.config}\\t${r.task}\\t${r.run}`;\n    const prior = byRun.get(key);\n    if (prior) replacements.push({ config: r.config, task: r.task, run: r.run, was: outcomeOf(prior), now: outcomeOf(r) });\n    byRun.set(key, r);\n  }\n}\nconst replaced = replacements.length;\nconst records = [...byRun.values()];\n/** A run that ended without a result of its own: Nexus without a turn report, or any agent killed by a signal. */\nconst crashed = (r) => !r.error && !r.timedOut && (r.exitCode === null || ((r.agent ?? \"nexus\") === \"nexus\" && !r.turn));\n\n/** 95 % Wilson score interval for k successes out of n. */\nexport function wilson(k, n) {\n  if (!n) return [0, 0];\n  const z = 1.96;\n  const p = k / n;\n  const denom = 1 + (z * z) / n;\n  const centre = (p + (z * z) / (2 * n)) / denom;\n  const half = (z * Math.sqrt((p * (1 - p)) / n + (z * z) / (4 * n * n))) / denom;\n  return [Math.max(0, centre - half), Math.min(1, centre + half)];\n}\n\nconst median = (xs) => {\n  const s = xs.filter((x) => typeof x === \"number\").sort((a, b) => a - b);\n  return s.length ? (s.length % 2 ? s[(s.length - 1) / 2] : (s[s.length / 2 - 1] + s[s.length / 2]) / 2) : null;\n};\n\nconst groups = new Map();\nfor (const r of records) {\n  const key = `${r.config}\\t${r.task}`;\n  if (!groups.has(key)) groups.set(key, []);\n  groups.get(key).push(r);\n}\n\nconst rows = [...groups.entries()].map(([key, rs]) => {\n  const [config, task] = key.split(\"\\t\");\n  const n = rs.length;\n  const count = (f) => rs.filter(f).length;\n  const correct = count((r) => r.hiddenPass);\n  return {\n    config,\n    task,\n    tier: rs[0].tier,\n    n,\n    claimed: count((r) => r.claimedComplete),\n    correct,\n    correctCI: wilson(correct, n),\n    falseVerified: count((r) => r.falseVerified),\n    regressions: count((r) => r.regressionPass === false),\n    errors: count((r) => r.error),\n    contaminated: count((r) => r.contaminated),\n    timedOut: count((r) => r.timedOut),\n    medianWallS: median(rs.map((r) => r.wallMs / 1000)),\n    medianSteps: median(rs.map((r) => r.turn?.steps?.used)),\n    medianTokens: median(rs.map((r) => r.tokens?.total)),\n  };\n});\n\nconst totals = {\n  runs: records.length,\n  falseVerified: records.filter((r) => r.falseVerified).length,\n  errors: records.filter((r) => r.error).length,\n  crashed: records.filter(crashed).length,\n  contaminated: records.filter((r) => r.contaminated).length,\n  replacedByRerun: replaced,\n};\n\n// Pooled rates leave contaminated runs out (the agent could have seen the hidden tests); they are counted separately.\nconst pooled = [...new Set(records.map((r) => r.config))].map((config) => {\n  const all = records.filter((r) => r.config === config);\n  const rs = all.filter((r) => !r.contaminated);\n  const k = rs.filter((r) => r.hiddenPass).length;\n  const sum = (xs) => xs.reduce((a, b) => a + (b ?? 0), 0);\n  return {\n    config,\n    n: rs.length,\n    excludedContaminated: all.length - rs.length,\n    correct: k,\n    rate: rs.length ? k / rs.length : 0,\n    ci: wilson(k, rs.length),\n    falseVerified: all.filter((r) => r.falseVerified).length,\n    crashRate: all.length ? all.filter(crashed).length / all.length : 0,\n    regressions: rs.filter((r) => r.regressionPass === false).length,\n    // Cost of the whole configuration's runs per correct result (failed runs cost too).\n    tokensPerCorrect: k ? sum(rs.map((r) => r.tokens?.total)) / k : null,\n    wallSecondsPerCorrect: k ? sum(rs.map((r) => r.wallMs)) / 1000 / k : null,\n  };\n});\n\n// T4: emit all nine preregistered classes, including empty rows. Proxy, task-fixture, and\n// runner-injected events share one scoring path so a proxy-only result cannot look complete.\nconst t4Events = (r) => [\n  ...(r.model?.faultsInjected ?? []).map((f) => ({ ...f, source: f.source ?? \"model_proxy\" })),\n  ...(r.t4FaultsInjected ?? []),\n];\n#!/usr/bin/env node\n// Runs evaluation tasks against an agent configuration and appends one JSON line per run (see eval/README.md).\n// Each run gets a fresh workspace (the task's repository at its pinned commit, or its fixture), the agent runs with the\n// task's budgets and a wall-clock timeout, then the task's hidden tests (never present while the agent runs) and its\n// regression command are run in that workspace. Nothing is scored here: eval/score.mjs reads the JSON lines.\nimport { spawnSync } from \"node:child_process\";\nimport { createHash, randomBytes } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { startModelProxy } from \"./model_proxy.mjs\";\nimport { asUserSpec, corpusManifestProblem, corpusTaskRows, fetchModelEntry, hiddenTestIsolationProblem, modelFingerprint, nexusContextLimitArgs, nexusLimitsProblem, qualificationBudgetProblem, runtimeCorpusOverlapProblem, taskTreeDigest, validateTask } from \"./validate.mjs\";\nimport { agentSandboxArgv, assertNoSymlinks, confinedPath, grantRunAsAccess, hiddenOutputHasTests, isolatedProcessArgv, normalizeRunAsPermissions, runIsolated, runIsolatedProcess, sandboxAvailable, stageHiddenFiles } from \"./isolate.mjs\";\nimport { runBlackBoxOracle } from \"./oracle.mjs\";\nimport { stageRepoWorkspace } from \"./workspace.mjs\";\nimport { applyAgentChanges, cloneWorkspace } from \"./hardened_check.mjs\";\nimport { containmentProblem, resourceProbeProblem, spawnContained } from \"./resources.mjs\";\nimport { StringDecoder } from \"node:string_decoder\";\nimport { commandBaseline, countCompactions, createT3Driver, scoreT3Run, steeringBaseline, steeringPrecondition, t3Snapshot } from \"./t3.mjs\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst args = parseArgs(process.argv.slice(2));\nif (args.out) args.out = path.resolve(args.out); // agents run elsewhere: paths handed to them must be absolute\nif (!args.config || !args.out) {\n  console.error(\"usage: eval/run.mjs --config eval/configs/<name>.json --out <dir> [--tasks eval/tasks] [--only id,id] [--runs N]\");\n  process.exit(2);\n}\nconst configBytes = fs.readFileSync(args.config);\nconst configSha256 = createHash(\"sha256\").update(configBytes).digest(\"hex\");\nconst config = JSON.parse(configBytes.toString(\"utf8\"));\nconst tasksDir = path.resolve(args.tasks ?? path.join(ROOT, \"eval/tasks\"));\nfunction custodyCorpusPathsForRun() {\n  return [\n    config.corpusCustody?.reportPath,\n    config.corpusCustody?.storeRoot,\n    config.corpusCustody?.validatorPath,\n    config.corpusCustody?.referencePath,\n    config.corpusCustody?.authorLogPath,\n  ].filter(Boolean);\n}\nfunction protectedCorpusPathsForRun() {\n  const parent = path.dirname(tasksDir);\n  const evalDir = path.join(ROOT, \"eval\");\n  const includeParent = config.qualification === true || fs.realpathSync(parent) !== fs.realpathSync(evalDir);\n  return [tasksDir, ...(includeParent ? [parent] : []), ...custodyCorpusPathsForRun()];\n}\nconst runs = Number(args.runs ?? config.runs ?? 1);\nconst only = args.only ? new Set(String(args.only).split(\",\")) : null;\n// --pairs \"task run,task run\": rerun exactly these (runs that failed on infrastructure; see eval/infra.mjs).\nconst pairs = args.pairs ? String(args.pairs).split(\",\").filter(Boolean).map((p) => p.trim().split(/\\s+/)) : null;\nfs.mkdirSync(path.dirname(args.out), { recursive: true });\ntry {\n  fs.mkdirSync(args.out, { mode: 0o700 });\n  fs.chmodSync(args.out, 0o700);\n} catch (error) {\n  if (error.code === \"EEXIST\") {\n    console.error(\"eval/run.mjs: output directory must be new; refusing to overwrite or append to prior evidence\");\n    process.exit(2);\n  }\n  throw error;\n}\nconst resultsFile = path.join(args.out, \"results.jsonl\");\n\nconst identity = harnessIdentity();\nconst availableTaskIds = fs.readdirSync(tasksDir).filter((d) => {\n  const entry = path.join(tasksDir, d);\n  try { return fs.lstatSync(entry).isDirectory() && fs.existsSync(path.join(entry, \"task.json\")); }\n  catch { return false; }\n}).sort();\n   - an allow-listed environment;\n   - serial execution, or recorded queueing.\n\n   A run with any field missing is invalid.\n3. **REQ-QUAL-103. Repetitions and peers.** At least 5 runs per (task, config). Matched peers are Goose and OpenCode on the same model (DEC-05).\n4. **REQ-QUAL-104. Metrics, reported separately.**\n   - hidden-test correctness;\n   - completion claimed;\n   - **false VERIFIED** (hard gate = 0);\n   - regressions (repo suite, plus a pre/post diff of previously passing tests);\n   - crash rate and timeout rate;\n   - bounded-failure truthfulness;\n   - operator interventions (= 0 in `run` mode);\n   - tokens and wall time per correct task.\n5. **REQ-QUAL-105. T4 fault injection.** 9 fault classes × 5 runs (DEC-05 amendment, 2026-10-17: the union of the distinct scenarios below):\n   1. gateway refuses connections mid-turn;\n   2. 5xx/overloaded;\n   3. stream cut mid-tool-call;\n   4. output-limit truncation;\n   5. hanging test command;\n   6. workspace disk full;\n   7. context overflow at 32k;\n   8. malformed tool-call JSON;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a171fd-3278-7ca3-ad25-d2f716cb2b15","create_time":1792914226.2641673}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
