{"timestamp":"2026-10-25T08:13:05.841Z","ordinal":331253,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":5976304028,"cached_input_tokens":5912562688,"cache_write_input_tokens":0,"output_tokens":16277610,"reasoning_output_tokens":9895762,"total_tokens":5992581638},"last_token_usage":{"input_tokens":0,"cached_input_tokens":0,"cache_write_input_tokens":0,"output_tokens":0,"reasoning_output_tokens":0,"total_tokens":60775},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":30.0,"window_minutes":300,"resets_at":1792926605},"secondary":{"used_percent":5.0,"window_minutes":10080,"resets_at":1793513405},"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"plus","rate_limit_reached_type":null}}}
