{"timestamp":"2026-10-25T08:25:43.802Z","ordinal":331942,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","item":{"type":"CommandExecution","id":"exec-e9189d1c-76b6-4190-8d89-c8744f91cccc","process_id":"26080","command":["/usr/bin/zsh","-lc","sed -n '1,180p' /home/mike/nexus-wt/plan10-pr10c-t4/eval/validate.mjs && sed -n '440,620p' /home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs && sed -n '1,210p' /home/mike/nexus-wt/plan10-pr10c-t4/eval/score.mjs && rg -n \"fixture|fault|run_command|tool.*result|messages\" /home/mike/nexus-wt/plan10-pr10c-t4/eval /home/mike/nexus-wt/plan10-pr10c-t4/docs/v1.0.0/plans/PLAN-10-v1-qualification-and-evaluation.md | head -90"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"read","cmd":"sed -n '1,180p' /home/mike/nexus-wt/plan10-pr10c-t4/eval/validate.mjs","name":"validate.mjs","path":"/home/mike/nexus-wt/plan10-pr10c-t4/eval/validate.mjs"},{"type":"read","cmd":"sed -n '440,620p' /home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs","name":"run.mjs","path":"/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs"},{"type":"read","cmd":"sed -n '1,210p' /home/mike/nexus-wt/plan10-pr10c-t4/eval/score.mjs","name":"score.mjs","path":"/home/mike/nexus-wt/plan10-pr10c-t4/eval/score.mjs"},{"type":"search","cmd":"rg -n 'fixture|fault|run_command|tool.*result|messages' /home/mike/nexus-wt/plan10-pr10c-t4/eval /home/mike/nexus-wt/plan10-pr10c-t4/docs/v1.0.0/plans/PLAN-10-v1-qualification-and-evaluation.md","query":"fixture|fault|run_command|tool.*result|messages","path":"eval"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"// Checks that make an evaluation run valid before it starts (SPEC-10, REQ-QUAL-101/102/106): every task is well formed,\n// a qualification run records which model actually answered (a fingerprint, not an alias), and hidden tests are out of\n// the agent's reach when the agent runs as its own user.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { createHash } from \"node:crypto\";\nimport { assertNoSymlinks, candidateSandboxHostMountSources, confinedPath, runtimeMountProblem, sandboxAvailable } from \"./isolate.mjs\";\nimport { blackBoxOracleProblem } from \"./oracle.mjs\";\nimport { t3TaskProblems } from \"./t3.mjs\";\nimport { resourceProbeProblem } from \"./resources.mjs\";\n\nexport const TIERS = [\"T1\", \"T2\", \"T3\", \"T4\"];\nexport const CLASSES = [\"bugfix\", \"feature\", \"refactor\", \"debug\"];\nexport const DIFFICULTIES = [\"easy\", \"medium\", \"hard\"];\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n\n/** Problems with one task.json (empty when valid). `qualification` adds the fields held-out tasks must carry. */\nexport function validateTask(task, dir, { qualification = false } = {}) {\n  const problems = [];\n  const need = (cond, msg) => { if (!cond) problems.push(msg); };\n  need(typeof task.id === \"string\" && task.id === path.basename(dir), `id must equal its directory name (${path.basename(dir)})`);\n  need(TIERS.includes(task.tier), `tier must be one of ${TIERS.join(\", \")}`);\n  need(typeof task.objective === \"string\" && task.objective.trim().length > 0, \"objective is required\");\n  problems.push(...t3TaskProblems(task));\n  need(Boolean(task.fixture) !== Boolean(task.repo), \"exactly one of fixture or repo is required\");\n  if (task.fixture) {\n    try { confinedPath(dir, task.fixture); }\n    catch (error) { need(false, error.message); }\n  }\n  if (task.repo) {\n    need(typeof task.repo.url === \"string\" && task.repo.url.length > 0, \"repo.url is required\");\n    try {\n      const repoUrl = new URL(task.repo.url);\n      need(repoUrl.protocol === \"https:\" && !repoUrl.username && !repoUrl.password, \"repo.url must use HTTPS without embedded credentials\");\n    } catch { need(false, \"repo.url must be a valid HTTPS URL without embedded credentials\"); }\n    need(/^[0-9a-f]{40}$/.test(task.repo.commit ?? \"\"), \"repo.commit must be a full 40-character commit id (pinned)\");\n  }\n  const hiddenCommand = typeof task.hidden?.command === \"string\" && task.hidden.command.length > 0;\n  const hiddenOracle = task.hidden?.protocol === \"blackbox-v1\";\n  need(hiddenCommand || hiddenOracle, \"hidden.command or hidden blackbox-v1 oracle is required\");\n  if (hiddenOracle) {\n    const oracleProblem = blackBoxOracleProblem(task.hidden, dir, task.fixture ?? null);\n    need(!oracleProblem, oracleProblem ?? \"hidden black-box oracle is invalid\");\n  }\n  // Legacy validators execute candidate modules in the same runtime. File hiding and a fresh workspace cannot prevent\n  // candidate code from inspecting or mutating that runtime, so they are never valid independent qualification.\n  if (qualification) need(hiddenOracle && !hiddenCommand, \"qualification requires the isolated blackbox-v1 hidden oracle; in-process legacy validators are not accepted\");\n  if (task.hidden?.dir) {\n    try { confinedPath(dir, task.hidden.dir); }\n    catch (error) { need(false, error.message); }\n  }\n  if (task.regression?.dir) {\n    try { confinedPath(dir, task.regression.dir); }\n    catch (error) { need(false, error.message); }\n  }\n  for (const key of [\"steps\", \"minutes\"]) {\n    if (task[key] !== undefined) need(Number.isInteger(task[key]) && task[key] > 0, `${key} must be a positive integer`);\n  }\n  if (task.faults !== undefined) {\n    const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n    need(Array.isArray(task.faults) && task.faults.every((f) => kinds.includes(f?.kind) && Number.isInteger(f?.atRequest) && f.atRequest >= 1), `faults must be [{ kind: ${kinds.join(\"|\")}, atRequest: n >= 1 }]`);\n  }\n  if (task.t4RunnerFault !== undefined) {\n    need(task.tier === \"T4\" && task.t4RunnerFault === \"sigterm_resume\", \"t4RunnerFault is supported only as sigterm_resume on a T4 task\");\n  }\n  if (task.class !== undefined || qualification) need(CLASSES.includes(task.class), `class must be one of ${CLASSES.join(\", \")}`);\n  if (task.difficulty !== undefined || qualification) need(DIFFICULTIES.includes(task.difficulty), `difficulty must be one of ${DIFFICULTIES.join(\", \")}`);\n  return problems;\n}\n\n/**\n * What a run's model is, beyond its alias: from the endpoint's /models entry (id, owner, advertised context) and the\n * operator's config (`fingerprint`: weights sha256, server build; `sampling`: temperature, seed). A qualification config\n * that cannot state weights, server build and sampling is refused (REQ-QUAL-102).\n */\nexport function modelFingerprint(config, entry) {\n  const fp = config.fingerprint ?? {};\n  const sampling = config.sampling ?? null;\n  const fingerprint = {\n    alias: config.model,\n    listed: Boolean(entry),\n    ownedBy: entry?.owned_by ?? null,\n    contextLength: entry?.context_length ?? entry?.max_model_len ?? entry?.meta?.n_ctx_train ?? null,\n    weightsSha256: fp.weightsSha256 ?? null,\n    serverBuild: fp.serverBuild ?? null,\n    sampling,\n  };\n  const missing = [];\n  if (config.qualification) {\n    if (!fingerprint.listed) missing.push(`the endpoint does not list model ${config.model}`);\n    if (!/^[0-9a-f]{64}$/.test(fingerprint.weightsSha256 ?? \"\")) missing.push(\"fingerprint.weightsSha256 (sha256 of the served weights file)\");\n    if (!fingerprint.serverBuild) missing.push(\"fingerprint.serverBuild (inference server name and build)\");\n    if (!sampling || typeof sampling.temperature !== \"number\") missing.push(\"sampling.temperature (and sampling.seed where the server supports one)\");\n  }\n  return { fingerprint, missing };\n}\n\n/** Compare the requested Nexus output/context limits with the limits exposed by the serving endpoint. */\nexport function nexusLimitsProblem(config, entry) {\n  const limits = config.limits;\n  const nativeDiscovery = Boolean(config.serverProfile) && limits?.context === undefined;\n  const contextOverride = Number.isInteger(limits?.context) && limits.context > 0;\n  if (!limits || (!contextOverride && !nativeDiscovery) || !Number.isInteger(limits.output) || limits.output <= 0) {\n    return \"qualification requires a positive limits.context override (or serverProfile native discovery) and positive limits.output\";\n  }\n  const args = Array.isArray(config.args) ? config.args : [];\n  if (args.some((arg) => typeof arg === \"string\" && (arg === \"--context-limit\" || arg.startsWith(\"--context-limit=\")))) {\n    return \"qualification must declare a Nexus context override through limits.context; --context-limit in args is ambiguous\";\n  }\n  const advertisedContext = positiveInt(entry?.context_length) ?? positiveInt(entry?.max_model_len) ?? positiveInt(entry?.meta?.n_ctx_train);\n  if (nativeDiscovery && !advertisedContext) {\n    return \"native context discovery requires a positive provider-advertised context limit\";\n  }\n  if (contextOverride && advertisedContext && limits.context > advertisedContext) {\n    return `configured context limit ${limits.context} exceeds the installed Nexus provider limit ${advertisedContext}`;\n  }\n  const requestedContext = nativeDiscovery ? advertisedContext : limits.context;\n  const context = advertisedContext ? Math.min(advertisedContext, requestedContext) : requestedContext;\n  const advertisedOutput = positiveInt(entry?.max_completion_tokens);\n  const actualOutput = Math.max(1, Math.min(advertisedOutput ?? Math.min(8192, Math.floor(context / 4)), Math.floor(context / 2)));\n  if (limits.output !== actualOutput) {\n    return `Nexus output allowance ${actualOutput} differs from matched peer limit ${limits.output}`;\n  }\n  return null;\n}\n\n/** Select an explicit operator override or let standalone server profiles discover their own context limit. */\nexport function nexusContextLimitArgs(config, defaultContext) {\n  if (config.serverProfile && config.limits?.context === undefined) return [];\n  const context = config.limits?.context ?? defaultContext;\n  return Number.isSafeInteger(context) && context > 0 ? [\"--context-limit\", String(context)] : [];\n}\n\nexport function qualificationBudgetProblem(config) {\n  const limits = config.limits;\n  for (const key of [\"output\", \"requests\", \"totalOutput\"]) {\n    if (!Number.isSafeInteger(limits?.[key]) || limits[key] < 1) {\n      return `qualification requires a frozen positive limits.${key} cap for proxy enforcement`;\n    }\n  }\n  if (limits.totalOutput < limits.output) return \"qualification limits.totalOutput cannot be lower than limits.output\";\n  return null;\n}\n\nfunction pathOverlaps(left, right) {\n  return left === right || left.startsWith(`${right}${path.sep}`) || right.startsWith(`${left}${path.sep}`);\n}\n\nfunction resolveCanonicalOrLexical(source) {\n  if (typeof source !== \"string\" || !path.isAbsolute(source)) return null;\n  const lexical = path.resolve(source);\n  let current = lexical;\n  const suffix = [];\n  while (true) {\n    try {\n      return { lexical, canonical: path.resolve(fs.realpathSync(current), ...suffix) };\n    } catch {\n      const parent = path.dirname(current);\n      if (parent === current) return { lexical, canonical: lexical };\n      suffix.unshift(path.basename(current));\n      current = parent;\n    }\n  }\n}\n\nfunction overlapVariants(left, right) {\n  return [left.lexical, left.canonical].some((a) => [right.lexical, right.canonical].some((b) => pathOverlaps(a, b)));\n}\n\n/** Refuse candidate runtime mounts that could expose the task tree or its private corpus store. */\nexport function runtimeCorpusOverlapProblem(runtimePaths, runtimeRoots, tasksDir, extraPrivatePaths = [], mountContext = {}) {\n  if (!Array.isArray(runtimePaths) || !Array.isArray(runtimeRoots) || !Array.isArray(extraPrivatePaths)) {\n    return \"qualification runtime and corpus paths must be explicit arrays\";\n  }\n  const taskPath = resolveCanonicalOrLexical(tasksDir);\n  if (!taskPath || !fs.existsSync(tasksDir)) return \"qualification task corpus path is unavailable\";\n  // Held-out stores keep tasks/, references/, and custody material under one directory. Keep that parent private\n  // outside the in-repo development eval/tasks tree, where eval/ also contains the trusted sandbox supervisor.\n  const parentDir = resolveCanonicalOrLexical(path.dirname(tasksDir));\n    command,\n    argsPrefix,\n  };\n}\n\nfunction resolvePathExecutable(command, env) {\n  for (const directory of (env.PATH ?? \"\").split(path.delimiter).filter(Boolean)) {\n    const candidate = path.resolve(directory, command);\n    try {\n      if (fs.statSync(candidate).isFile()) return fs.realpathSync(candidate);\n    } catch {}\n  }\n  return null;\n}\n\nfunction sha256File(file) {\n  return new Promise((resolve, reject) => {\n    const hash = createHash(\"sha256\");\n    const stream = fs.createReadStream(file);\n    stream.on(\"data\", (chunk) => hash.update(chunk));\n    stream.on(\"error\", reject);\n    stream.on(\"end\", () => resolve(hash.digest(\"hex\")));\n  });\n}\n\nfunction agentCommand(task, ws, home, budget, agentIdentity, localToken) {\n  const sampling = config.sampling ?? { temperature: 0.2 };\n  const limits = config.limits ?? { context: 65536, output: 8192 };\n  const forbiddenEnv = Object.keys(config.env ?? {}).find((key) => /KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL/i.test(key));\n  if (forbiddenEnv) throw new Error(`candidate configuration may not contain credential-like environment key ${forbiddenEnv}`);\n  const ep = \"http://127.0.0.1:40127/v1\";\n  const env = {\n    PATH: config.env?.PATH ?? \"/usr/bin:/bin\", LANG: config.env?.LANG ?? \"C.UTF-8\", LC_ALL: config.env?.LC_ALL ?? \"C.UTF-8\",\n    TERM: config.env?.TERM ?? \"dumb\", HOME: \"/home/eval\", PWD: \"/workspace\", CI: \"1\",\n    LOCAL_LLM_API_KEY: localToken, OPENAI_API_KEY: localToken, GW_KEY: localToken,\n    XDG_CONFIG_HOME: \"/home/eval/.config\", XDG_DATA_HOME: \"/home/eval/.local/share\", XDG_STATE_HOME: \"/home/eval/.local/state\",\n  };\n  const agent = config.agent ?? \"nexus\";\n  if (agent === \"nexus\") {\n    env.LOCAL_LLM_ENDPOINT = ep;\n    const contextArgs = nexusContextLimitArgs(config, limits.context);\n    if (task.tier === \"T3\") {\n      // T3 drives the sidecar, the operator channel that carries steering, with the same model, budgets and limits.\n      const checkout = agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\");\n      // An installed package is <package>/bin/nexus with the sidecar at <package>/lib/cli/dist/sidecar.js.\n      const packageDir = checkout ? null : path.dirname(path.dirname(fs.realpathSync(agentIdentity.command)));\n      const sidecar = checkout ? path.join(ROOT, \"cli/dist/sidecar.js\") : path.join(packageDir, \"lib/cli/dist/sidecar.js\");\n      if (!fs.existsSync(sidecar)) throw new Error(`T3 needs the Nexus sidecar at ${sidecar}`);\n      if (packageDir) {\n        // The launcher is bypassed, so the package itself must be mounted: it has to sit under sandboxRuntimeRoots.\n        const roots = (config.sandboxRuntimeRoots ?? []).flatMap((root) => { try { return [fs.realpathSync(root)]; } catch { return []; } });\n        if (!roots.some((root) => packageDir === root || packageDir.startsWith(`${root}${path.sep}`))) throw new Error(`T3 runs the sidecar from ${packageDir}, which must be under sandboxRuntimeRoots`);\n        env.NEXUS_HOME = packageDir;\n      }\n      const sidecarArgs = [sidecar, \"--yes\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? [])];\n      return checkout ? { cmd: process.execPath, argv: sidecarArgs, env, protocol: true } : { cmd: \"/usr/bin/env\", argv: [\"node\", ...sidecarArgs], env, protocol: true };\n    }\n    return { cmd: agentIdentity.command, argv: [...agentIdentity.argsPrefix, \"run\", \"--yes\", \"--json\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? []), task.objective], env };\n  }\n  if (agent === \"aider\") {\n    return { cmd: agentIdentity.command, argv: [\"--model\", `openai/${config.model}`, \"--openai-api-base\", ep, \"--yes-always\", \"--no-auto-commits\", \"--no-dirty-commits\", \"--no-gitignore\", \"--no-show-model-warnings\", \"--no-check-update\", \"--analytics-disable\", \"--no-pretty\", \"--no-fancy-input\", ...(config.args ?? []), \"--message\", task.objective], env };\n  }\n  if (agent === \"opencode\") {\n    const dir = path.join(home, \".config/opencode\");\n    fs.mkdirSync(dir, { recursive: true });\n    const modelOptions = { temperature: sampling.temperature, ...(sampling.seed !== undefined ? { seed: sampling.seed } : {}) };\n    fs.writeFileSync(path.join(dir, \"opencode.json\"), JSON.stringify({\n      $schema: \"https://opencode.ai/config.json\",\n      autoupdate: false,\n      share: \"disabled\",\n      permission: { edit: \"allow\", bash: \"allow\", webfetch: \"deny\" },\n      agent: { \"nexus-eval\": { mode: \"primary\", steps: budget.steps } },\n      provider: { gw: { npm: \"@ai-sdk/openai-compatible\", name: \"gateway\", options: { baseURL: ep, apiKey: \"{env:GW_KEY}\" }, models: { [config.model]: { name: config.model, limit: limits, options: modelOptions } } } },\n      model: `gw/${config.model}`,\n    }, null, 2));\n    // Provider packages are cached across runs (not per run): the cache holds code, not state.\n    env.XDG_CACHE_HOME = path.join(home, \".cache\");\n    return { cmd: agentIdentity.command, argv: [\"run\", \"--agent\", \"nexus-eval\", \"--model\", `gw/${config.model}`, ...(config.args ?? []), task.objective], env };\n  }\n  if (agent === \"goose\") {\n    const u = new URL(ep);\n    Object.assign(env, { GOOSE_PROVIDER: \"openai\", GOOSE_MODEL: config.model, OPENAI_HOST: u.origin, OPENAI_BASE_PATH: `${u.pathname.replace(/^\\/|\\/$/g, \"\")}/chat/completions`, GOOSE_MODE: \"auto\", GOOSE_DISABLE_KEYRING: \"1\", GOOSE_CONTEXT_LIMIT: String(limits.context), GOOSE_MAX_TOKENS: String(limits.output), GOOSE_MAX_TURNS: String(budget.steps), GOOSE_TEMPERATURE: String(sampling.temperature) });\n    return { cmd: agentIdentity.command, argv: [\"run\", \"--no-session\", \"--with-builtin\", \"developer\", \"--max-turns\", String(budget.steps), ...(config.args ?? []), \"-t\", task.objective], env };\n  }\n  throw new Error(`agent ${agent} has no adapter`);\n}\n\nasync function runAgent(task, ws, home, budget, agentIdentity, proxyDirectory, localToken, proxy) {\n  if (task.t4RunnerFault !== \"sigterm_resume\") {\n    return runAgentAttempt(task, ws, home, budget, agentIdentity, proxyDirectory, localToken);\n  }\n  if (task.tier !== \"T4\" || (config.agent ?? \"nexus\") !== \"nexus\" || config.qualification !== true || !config.resources) {\n    throw new Error(\"sigterm_resume requires an installed Nexus qualification run with the kernel resource contract\");\n  }\n  const interrupted = await runAgentAttempt(task, ws, home, budget, agentIdentity, proxyDirectory, localToken, { signalAfterAnswer: true, proxy });\n  const signal = interrupted.t4Signal;\n  if (!signal?.delivered) return { ...interrupted, t4FaultsInjected: [] };\n  const resumed = await runAgentAttempt(task, ws, home, budget, agentIdentity, proxyDirectory, localToken, { resume: true });\n  const evidence = {\n    signal: \"SIGTERM\",\n    delivered: signal.delivered,\n    deliveredProcesses: signal.deliveredProcesses,\n    forced: signal.forced,\n    firstExitCode: signal.firstExitCode,\n    payloadExitSignal: signal.payloadExitSignal,\n    supervisorWrapperExitSignal: signal.supervisorWrapperExitSignal,\n    signalDuringActiveTurn: signal.signalDuringActiveTurn,\n    resumed: resumed.code === 0 && resumed.json?.turn?.execution === \"COMPLETED\",\n    resumeExitCode: resumed.code,\n    resumeTurnExecution: resumed.json?.turn?.execution ?? null,\n  };\n  return {\n    ...resumed,\n    stdout: `${interrupted.stdout}\\n--- T4 SIGTERM interruption ---\\n${resumed.stdout}`,\n    stderr: `${interrupted.stderr}\\n--- T4 resume attempt ---\\n${resumed.stderr}`,\n    t4FaultsInjected: [{ kind: \"sigterm_resume\", source: \"task_fixture_or_runner\", evidence }],\n  };\n}\n\nfunction runAgentAttempt(task, ws, home, budget, agentIdentity, proxyDirectory, localToken, { signalAfterAnswer = false, proxy = null, resume = false } = {}) {\n  const { cmd, argv, env, protocol } = agentCommand(task, ws, home, budget, agentIdentity, localToken);\n  if (resume) {\n    if ((config.agent ?? \"nexus\") !== \"nexus\" || protocol) throw new Error(\"T4 resume is supported only by Nexus run mode\");\n    const promptIndex = argv.lastIndexOf(task.objective);\n    if (promptIndex < 0) throw new Error(\"could not remove original prompt before Nexus resume\");\n    argv.splice(promptIndex, 1);\n    argv.push(\"--resume\");\n  }\n  if (config.qualification === true && !config.runAs) throw new Error(\"qualification candidate execution requires the dedicated evaluator account\");\n  if (config.runAs) grantRunAsAccess(config.runAs, [ws, home, proxyDirectory]);\n  const runtimePaths = [fs.realpathSync(cmd), ...agentIdentity.argsPrefix.filter((item) => path.isAbsolute(item)), ...(config.sandboxRuntimePaths ?? [])];\n  if ((config.agent ?? \"nexus\") === \"nexus\" && agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\")) {\n    runtimePaths.push(path.join(ROOT, \"cli/dist\"));\n    const modules = path.join(ROOT, \"cli/node_modules\");\n    for (const entry of fs.readdirSync(modules, { withFileTypes: true })) {\n      if (entry.isDirectory() && entry.name !== \".bin\") runtimePaths.push(path.join(modules, entry.name));\n    }\n    const coreBinary = path.join(ROOT, \"core/target/release/harness-core\");\n    if (fs.existsSync(coreBinary)) runtimePaths.push(coreBinary);\n  }\n  const sandboxRuntimePaths = [...new Set(runtimePaths)];\n  const allowedRuntimeRoots = [...new Set([...(config.sandboxRuntimeRoots ?? []), ...((config.agent ?? \"nexus\") === \"nexus\" && agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\") ? [path.join(ROOT, \"cli\"), path.join(ROOT, \"core\")] : [])])];\n  const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n  const corpusPaths = custodyCorpusPathsForRun();\n  const protectedCorpusPaths = protectedCorpusPathsForRun();\n  const corpusOverlap = runtimeCorpusOverlapProblem(sandboxRuntimePaths, allowedRuntimeRoots, tasksDir, corpusPaths, {\n    cwd: ws,\n    home,\n    proxyDirectory,\n    nodeRuntime: cmd,\n    supervisorPath,\n    qualification: config.qualification === true,\n  });\n  if (corpusOverlap) throw new Error(corpusOverlap);\n  const sandbox = agentSandboxArgv({ cwd: ws, home, proxyDirectory, readOnlyPaths: sandboxRuntimePaths, allowedRuntimeRoots, runtimeExecutablePaths: [cmd, ...agentIdentity.argsPrefix], supervisorPath, protectedCorpusPaths });\n  const wrapped = config.runAs ? asUserSpec(config.runAs, sandbox) : sandbox;\n  return new Promise((resolve) => {\n    const { child, containment } = spawnContained(wrapped, config.resources ?? null, { cwd: \"/\", env: {}, stdio: [\"pipe\", \"pipe\", \"pipe\"], detached: true });\n    // T3: the payload is the first line and the sidecar protocol follows on the same stdin (eval/agent_sandbox.mjs).\n    const preconditions = {};\n    const runConstraint = (command) => runIsolated(command, { cwd: ws, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => ({ pass: r.status === 0 && !r.timedOut && !r.overflow }));\n    const driver = protocol ? createT3Driver(task, (line) => { if (!child.stdin.destroyed) child.stdin.write(line); }, {\n      onSteer: (item) => { preconditions[item.id] = steeringPrecondition(item, ws, task.t3CommandBaseline); },\n      beforeProbe: () => t3Snapshot(task, ws, runConstraint),\n    }) : null;\n    child.stdin.on(\"error\", () => {});\n    if (driver) {\n      child.stdin.write(`${JSON.stringify({ command: cmd, argv, env, protocol: true })}\\n`);\n      driver.done.then(() => setTimeout(() => child.stdin.end(), 2000).unref());\n    } else child.stdin.end(JSON.stringify({ command: cmd, argv, env }));\n    let stdout = \"\";\n    let stderr = \"\";\n    let timedOut = false;\n    let outputExceeded = false;\n    let outputBytes = 0;\n    const collect = (target, chunk) => {\n      outputBytes += chunk.length;\n      // A T3 protocol session over 60+ steps is verbose; its cap is larger but still bounded.\n      if (outputBytes > (driver ? 50_000_000 : 2_000_000)) {\n        outputExceeded = true;\n        killGroup(\"SIGKILL\");\n#!/usr/bin/env node\n// Scores eval results (results.jsonl from eval/run.mjs). Scores are reported separately and never combined\n// (qualification assessment §9): completion claimed, artifact correct (hidden tests), false VERIFIED, regressions,\n// bounded failure, wall time, steps, tokens — per task and configuration, with 95 % Wilson intervals for rates.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst T4_FAULT_CLASSES = [\n  \"refuse\",\n  \"overloaded\",\n  \"stream_cut\",\n  \"truncate\",\n  \"hanging_test_command\",\n  \"full_disk\",\n  \"context_overflow\",\n  \"malformed_tool_json\",\n  \"sigterm_resume\",\n];\nconst T4_RUNS_PER_CLASS = 5;\nconst T4_PROXY_CLASSES = new Set([\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"]);\nconst T4_RUNNER_CLASSES = new Set([\"hanging_test_command\", \"full_disk\", \"sigterm_resume\"]);\n\n// Several files may be given: a later record for the same configuration, task and run replaces an earlier one (a rerun\n// of a run that failed on infrastructure, see eval/infra.mjs). The replaced records stay in their files.\nconst files = process.argv.slice(2).filter((a) => !a.startsWith(\"--\"));\nconst pairMode = process.argv.includes(\"--pairs\");\nif (!files.length) {\n  console.error(\"usage: eval/score.mjs <results.jsonl>... [--pairs] [--json]\");\n  process.exit(2);\n}\nconst peerComparison = pairMode ? validateMatchedPeers(files) : null;\nconst byRun = new Map();\n/** Every replacement is listed (REQ-QUAL-106): which run, what it showed, and what the rerun showed. */\nconst replacements = [];\nconst outcomeOf = (r) => r.error ? `error: ${r.error}` : r.turn?.outcome ?? (r.timedOut ? \"timed out\" : `exit ${r.exitCode}`);\nfor (const file of files) {\n  for (const r of fs.readFileSync(file, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l))) {\n    const key = `${r.config}\\t${r.task}\\t${r.run}`;\n    const prior = byRun.get(key);\n    if (prior) replacements.push({ config: r.config, task: r.task, run: r.run, was: outcomeOf(prior), now: outcomeOf(r) });\n    byRun.set(key, r);\n  }\n}\nconst replaced = replacements.length;\nconst records = [...byRun.values()];\n/** A run that ended without a result of its own: Nexus without a turn report, or any agent killed by a signal. */\nconst crashed = (r) => !r.error && !r.timedOut && (r.exitCode === null || ((r.agent ?? \"nexus\") === \"nexus\" && !r.turn));\n\n/** 95 % Wilson score interval for k successes out of n. */\nexport function wilson(k, n) {\n  if (!n) return [0, 0];\n  const z = 1.96;\n  const p = k / n;\n  const denom = 1 + (z * z) / n;\n  const centre = (p + (z * z) / (2 * n)) / denom;\n  const half = (z * Math.sqrt((p * (1 - p)) / n + (z * z) / (4 * n * n))) / denom;\n  return [Math.max(0, centre - half), Math.min(1, centre + half)];\n}\n\nconst median = (xs) => {\n  const s = xs.filter((x) => typeof x === \"number\").sort((a, b) => a - b);\n  return s.length ? (s.length % 2 ? s[(s.length - 1) / 2] : (s[s.length / 2 - 1] + s[s.length / 2]) / 2) : null;\n};\n\nconst groups = new Map();\nfor (const r of records) {\n  const key = `${r.config}\\t${r.task}`;\n  if (!groups.has(key)) groups.set(key, []);\n  groups.get(key).push(r);\n}\n\nconst rows = [...groups.entries()].map(([key, rs]) => {\n  const [config, task] = key.split(\"\\t\");\n  const n = rs.length;\n  const count = (f) => rs.filter(f).length;\n  const correct = count((r) => r.hiddenPass);\n  return {\n    config,\n    task,\n    tier: rs[0].tier,\n    n,\n    claimed: count((r) => r.claimedComplete),\n    correct,\n    correctCI: wilson(correct, n),\n    falseVerified: count((r) => r.falseVerified),\n    regressions: count((r) => r.regressionPass === false),\n    errors: count((r) => r.error),\n    contaminated: count((r) => r.contaminated),\n    timedOut: count((r) => r.timedOut),\n    medianWallS: median(rs.map((r) => r.wallMs / 1000)),\n    medianSteps: median(rs.map((r) => r.turn?.steps?.used)),\n    medianTokens: median(rs.map((r) => r.tokens?.total)),\n  };\n});\n\nconst totals = {\n  runs: records.length,\n  falseVerified: records.filter((r) => r.falseVerified).length,\n  errors: records.filter((r) => r.error).length,\n  crashed: records.filter(crashed).length,\n  contaminated: records.filter((r) => r.contaminated).length,\n  replacedByRerun: replaced,\n};\n\n// Pooled rates leave contaminated runs out (the agent could have seen the hidden tests); they are counted separately.\nconst pooled = [...new Set(records.map((r) => r.config))].map((config) => {\n  const all = records.filter((r) => r.config === config);\n  const rs = all.filter((r) => !r.contaminated);\n  const k = rs.filter((r) => r.hiddenPass).length;\n  const sum = (xs) => xs.reduce((a, b) => a + (b ?? 0), 0);\n  return {\n    config,\n    n: rs.length,\n    excludedContaminated: all.length - rs.length,\n    correct: k,\n    rate: rs.length ? k / rs.length : 0,\n    ci: wilson(k, rs.length),\n    falseVerified: all.filter((r) => r.falseVerified).length,\n    crashRate: all.length ? all.filter(crashed).length / all.length : 0,\n    regressions: rs.filter((r) => r.regressionPass === false).length,\n    // Cost of the whole configuration's runs per correct result (failed runs cost too).\n    tokensPerCorrect: k ? sum(rs.map((r) => r.tokens?.total)) / k : null,\n    wallSecondsPerCorrect: k ? sum(rs.map((r) => r.wallMs)) / 1000 / k : null,\n  };\n});\n\n// T4: emit all nine preregistered classes, including empty rows. Proxy, task-fixture, and\n// runner-injected events share one scoring path so a proxy-only result cannot look complete.\nconst t4Events = (r) => [\n  ...(r.model?.faultsInjected ?? []).map((f) => ({ ...f, source: f.source ?? \"model_proxy\" })),\n  ...(r.t4FaultsInjected ?? []),\n];\nconst expectedSource = (kind) => T4_PROXY_CLASSES.has(kind) ? \"model_proxy\" : T4_RUNNER_CLASSES.has(kind) ? \"task_fixture_or_runner\" : null;\nconst runnerEvidenceValid = (event) => {\n  const evidence = event.evidence;\n  if (!evidence || typeof evidence !== \"object\") return false;\n  if (event.kind === \"sigterm_resume\") {\n    return evidence.signal === \"SIGTERM\"\n      && evidence.delivered === true\n      && Number.isInteger(evidence.deliveredProcesses)\n      && evidence.deliveredProcesses > 0\n      && evidence.signalDuringActiveTurn === true\n      && evidence.payloadExitSignal === \"SIGTERM\"\n      && evidence.resumed === true\n      && evidence.resumeExitCode === 0\n      && evidence.resumeTurnExecution === \"COMPLETED\";\n  }\n  if (event.kind === \"hanging_test_command\") return evidence.observedHung === true && evidence.timedOut === true && evidence.containmentCleaned === true;\n  if (event.kind === \"full_disk\") return evidence.writeFailedWithEnospc === true && Number.isSafeInteger(evidence.storageLimitBytes) && evidence.storageLimitBytes > 0;\n  return false;\n};\nconst t4Runs = records.filter((r) => r.tier === \"T4\");\nconst invalidT4Events = t4Runs.flatMap((r) => t4Events(r)\n  .filter((f) => !expectedSource(f.kind) || f.source !== expectedSource(f.kind) || (T4_RUNNER_CLASSES.has(f.kind) && !runnerEvidenceValid(f)))\n  .map((f) => ({ task: r.task, run: r.run, kind: f.kind ?? null, source: f.source ?? null })));\nconst faultRows = T4_FAULT_CLASSES.map((kind) => {\n  const injected = records.filter((r) => t4Events(r).some((f) => f.kind === kind && f.source === expectedSource(kind)));\n  const rs = t4Runs.filter((r) => t4Events(r).some((f) => f.kind === kind && f.source === expectedSource(kind)));\n  const truthful = injected.filter((r) => !r.error && !r.falseVerified && !crashed(r) && !r.timedOut && !r.outputExceeded).length;\n  const qualificationTruthful = rs.filter((r) => !r.error && !r.falseVerified && !crashed(r) && !r.timedOut && !r.outputExceeded).length;\n  const recovered = injected.filter((r) => r.hiddenPass).length;\n  const hungPastBudget = injected.filter((r) => r.timedOut).length;\n  return {\n    kind,\n    n: injected.length,\n    qualificationRuns: rs.length,\n    qualificationTruthful,\n    truthful,\n    truthfulRate: injected.length ? truthful / injected.length : null,\n    recovered,\n    hungPastBudget,\n    gate: rs.length >= T4_RUNS_PER_CLASS && qualificationTruthful === rs.length && rs.every((r) => !r.timedOut) ? \"PASS\" : \"FAIL\",\n  };\n});\nconst t4 = {\n  requiredClasses: T4_FAULT_CLASSES.length,\n  requiredRunsPerClass: T4_RUNS_PER_CLASS,\n  observedClasses: faultRows.filter((r) => r.qualificationRuns > 0).length,\n  totalRuns: faultRows.reduce((n, r) => n + r.qualificationRuns, 0),\n  invalidEvents: invalidT4Events.length,\n  gate: invalidT4Events.length === 0 && faultRows.every((r) => r.gate === \"PASS\") ? \"PASS\" : \"FAIL\",\n};\n\n// T3 (REQ-QUAL-109): every T3 run counts. A run with no T3 result, too few steps or fewer than two compactions is\n// ineligible and fails the workload rather than leaving it; DEC-05 thresholds are false-absence 0, steering >= 95%.\nconst T3_TASKS = 8;\nconst T3_RUNS_PER_TASK = 5;\nconst t3Runs = records.filter((r) => r.tier === \"T3\");\nconst t3 = t3Runs.length ? (() => {\n  const honoured = t3Runs.flatMap((r) => r.t3?.steering ?? []).filter((s) => s.honoured).length;\n  // The denominator is what each task declared, so a run without a T3 result still counts its steering as unmet.\n  const expectedItems = t3Runs.reduce((n, r) => n + (r.t3SteeringItems ?? r.t3?.steering?.length ?? 0), 0);\n  const perTask = new Map();\n  for (const r of t3Runs) perTask.set(r.task, (perTask.get(r.task) ?? 0) + 1);\n  const summary = {\n    runs: t3Runs.length,\n    tasks: perTask.size,\n    shapeMet: perTask.size >= T3_TASKS && [...perTask.values()].every((n) => n >= T3_RUNS_PER_TASK),\n    // A contaminated run (task source changed, or the task path leaked into agent output) is not evidence either way.\n    contaminated: t3Runs.filter((r) => r.contaminated).length,\n    ineligible: t3Runs.filter((r) => !r.t3?.eligible).length,\n    falseAbsences: t3Runs.reduce((n, r) => n + (r.t3?.falseAbsences ?? 0), 0),\n    falsePresences: t3Runs.reduce((n, r) => n + (r.t3?.falsePresences ?? 0), 0),\n    probeUnanswered: t3Runs.filter((r) => r.t3 && !r.t3.probeAnswered).length,\n    steeringItems: expectedItems,\n    steeringHonoured: honoured,\n    steeringRate: expectedItems ? honoured / expectedItems : 0,\n  };\n  // Owner decision 2026-10-18: false presence is gated as well as DEC-05's false absence, so a blanket answer cannot pass.\n  summary.gate = summary.shapeMet && summary.contaminated === 0 && summary.ineligible === 0 && summary.falseAbsences === 0 && summary.falsePresences === 0 && summary.probeUnanswered === 0 && summary.steeringRate >= 0.95 ? \"PASS\" : \"FAIL\";\n/home/mike/nexus-wt/plan10-pr10c-t4/docs/v1.0.0/plans/PLAN-10-v1-qualification-and-evaluation.md:13:- new `eval/faults/`\n/home/mike/nexus-wt/plan10-pr10c-t4/docs/v1.0.0/plans/PLAN-10-v1-qualification-and-evaluation.md:28:| 5 | Fault proxy for T4 classes 1–4 and 7–8, scheduled per run. Fixture hooks for 5 (hanging test), 6 (disk full via a small loop-mounted fs or `ulimit -f`), and 9 (SIGTERM then `run --resume`). | new `eval/faults/proxy.mjs`; task fixtures | PLAN-04 task 1 |\n/home/mike/nexus-wt/plan10-pr10c-t4/docs/v1.0.0/plans/PLAN-10-v1-qualification-and-evaluation.md:29:| 6 | T4 smoke in `make test`: scripted model plus 2 fault cases. The T1 self-test stays. | `cli/test/eval_harness.test.ts`; `Makefile` | 5 |\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/workspace.mjs:16:  git([\"-c\", \"init.defaultBranch=main\", \"init\", \"-q\", ws], os.tmpdir());\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:27:arguments), and per-case/aggregate time and output bounds are enforced. Oracle files must be outside the copied fixture.\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:28:Absolute paths, traversal, symlinks and unsupported fixture entries are rejected. `manifest.json` records the harness source-file hashes, model fingerprint, corpus/task\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:53:| `id`, `tier` | T1 smoke (scripted model, CI), T2 standard, T3 long-task, T4 fault-injected |\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:54:| `fixture` or `repo` | a directory in the task, or `{ \"url\", \"commit\" }` (external repositories at pinned commits) |\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:57:| `steps`, `minutes` | budgets (defaults from the configuration: 300 steps, 120 min) |\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:83:## Fault injection (T4)\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:85:A task or config may list `faults: [{ kind, atRequest }]`. The run's model proxy then injects that fault into the Nth\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:88:| kind | Fault |\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:97:What was injected is recorded in `model.faultsInjected`. Such runs are never treated as infrastructure reruns.\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:98:`score.mjs` reports, per fault kind:\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:106:The remaining T4 classes come from task fixtures (a hanging test command, a full disk) and from the SIGTERM-then-resume\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:107:runner case. `make test` includes a T4 smoke test with two injected faults (`cli/test/eval_harness.test.ts`).\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:114:- **Tasks are well formed** (`eval/validate.mjs`): one source (fixture, or a repo pinned to a full commit id), an isolated\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:145:  pinned-repository tasks; a local fixture additionally requires a full-tree `sha256` because those two v2 digests do\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:146:  not cover fixture files. The frozen config carries `corpusCustody: { custodian, approvedAt, reportPath, reportSha256 }`\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:174:   fixture, the same setup commands) into a fresh workspace, and checks that its tree equals that baseline.\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:188:     - test data: `testdata/`, `fixtures/`, `__snapshots__/`, `snapshots/`, `golden/`, mocks, `*.golden`, `*.snap`;\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:228:A task using a local `fixture` must also carry `sha256` for the full task tree; without it, fixture content outside\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:274:  provisions delegation with `scripts/ensure-ci-user-cgroups.sh`, and the fixture tests in\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:276:  behaviour, using infrastructure fixtures only.\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:296:- T4: truthful bounded outcome in 100 % of fault runs;\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:307:| T2 task set (pilot fixture tasks `t2-*`) | done |\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:309:| T4 fault injector | in progress |\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:316:fixture tasks (`t2-*`; each hidden test checked to fail on the fixture and pass on a reference fix kept outside the\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/README.md:320:Deviations from §9, recorded before the run: fixture tasks rather than external repositories at pinned commits; T2\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/hardened_check.mjs:3:// task is staged again (same pin or fixture, same setup) and only the agent's source changes are copied in.\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/hardened_check.mjs:20:  /(^|\\/)(testdata|fixtures?|__snapshots__|snapshots?|golden|__mocks__|mocks?|e2e|testing|testutils?|test_?utils?|test_helpers?|testhelpers?|testenv|testlib)\\//,\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/hardened_check.mjs:21:  /(^|\\/)_?testing\\.py$/, /(^|\\/)(test[-_]?(setup|helpers?|utils?|env|lib|fixtures?)|setup[-_]tests?)\\.[^/]+$/,\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/hardened_check.mjs:124:    // [package] and [features] can switch test discovery off (autotests, build, a changed default feature set); [[test]],\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/score.mjs:8:const T4_FAULT_CLASSES = [\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/score.mjs:127:// T4: emit all nine preregistered classes, including empty rows. Proxy, task-fixture, and\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/score.mjs:130:  ...(r.model?.faultsInjected ?? []).map((f) => ({ ...f, source: f.source ?? \"model_proxy\" })),\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/score.mjs:131:  ...(r.t4FaultsInjected ?? []),\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/score.mjs:133:const expectedSource = (kind) => T4_PROXY_CLASSES.has(kind) ? \"model_proxy\" : T4_RUNNER_CLASSES.has(kind) ? \"task_fixture_or_runner\" : null;\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/score.mjs:156:const faultRows = T4_FAULT_CLASSES.map((kind) => {\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/score.mjs:176:  requiredClasses: T4_FAULT_CLASSE