from \"./core/provider_capabilities.js\";\nimport { ChatMessage, ToolDefinition, HarnessConfig, ToolCall } from \"./types.js\";\nimport { InformationFlowBoundary, DestinationTrustBoundary } from \"./core/egress.js\";\nimport pc from \"picocolors\";\nimport type {\n  ExecutionStatus,\n  InferenceFailure,\n  InferenceFailureKind,\n  InferenceFailureOrigin,\n  ProviderCondition,\n  ProviderHints,\n  TransportCause,\n} from \"./core/turn.js\";\nimport {\n  classifyHttpFailure,\n  classifyTransportFailure,\n  isTlsVerificationError,\n  providerHints,\n  TEMPORARY_CONDITIONS,\n  type ProbeResult,\n  type ProviderClassification,\n} from \"./core/provider_recovery.js\";\nimport { redactSecrets } from \"./ui.js\";\nimport { classifyLocality, setLocalityAuthorityResolver } from \"./core/egress.js\";\nimport { connectionFor, disclosureClass, operatorSettingKeyForAuth, type ResolvedConnection } from \"./providers.js\";\nimport { ProviderStreamError, readSse, type NativeRequestInput, type NativeResult } from \"./protocols/common.js\";\nimport { anthropicStreamParser, buildAnthropicRequest, parseAnthropicResponse } from \"./protocols/anthropic.js\";\nimport { buildResponsesRequest, parseResponsesResponse, responsesStreamParser } from \"./protocols/openai_responses.js\";\nimport { UsageLedger, type UsageReport } from \"./usage.js\";\nimport { resolveCredential, saveCredential, type StoredCredential } from \"./credentials.js\";\nimport { COPILOT_HEADERS, copilotToken, refreshOAuth } from \"./oauth.js\";\nimport { providerDefinition } from \"./providers.js\";\n\ntype OAuthCredential = Extract<StoredCredential, { type: \"oauth\" }>;\n\nfunction originOf(url: string | undefined): string | undefined {\n// Trusted per-execution supervisor. eval/resources.mjs starts it as the only process of a delegated transient\n// systemd --user scope. It moves itself into a `supervisor` leaf, applies the run's limits to a sibling `payload`\n// leaf, reads them back, runs the task-controlled command there, and afterwards kills every process left in that\n// cgroup (cgroup.kill reaches processes of another uid and ones that left the process group or session).\n// Protocol: argv[2] is JSON { limits: { cpuPercent, memoryBytes, tasks }, cmd, argv }; stdio 0-2 pass to the payload;\n// fd 3 receives JSON lines: { cgroup } once the payload leaf exists, then exactly one final report.\nimport { spawn } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\n\nconst spec = JSON.parse(process.argv[2]);\nconst report = (value) => { try { fs.writeSync(3, `${JSON.stringify(value)}\\n`); } catch {} };\nconst read = (file) => { try { return fs.readFileSync(file, \"utf8\").trim(); } catch { return null; } };\nconst keyed = (text) => Object.fromEntries((text ?? \"\").split(\"\\n\").filter(Boolean).map((line) => {\n  const [key, value] = line.split(/\\s+/);\n  return [key, Number(value)];\n}));\n\nfunction fail(message) {\n  report({ error: message, cleaned: false });\n  process.exit(125);\n}\n\nconst own = (read(\"/proc/self/cgroup\") ?? \"\").split(\"\\n\").find((line) => line.startsWith(\"0::\"))?.slice(3);\nif (!own || !own.endsWith(\".scope\")) fail(\"supervisor is not running in a transient scope\");\nconst scope = path.join(\"/sys/fs/cgroup\", own);\nconst supervisor = path.join(scope, \"supervisor\");\nconst payload = path.join(scope, \"payload\");\nconst { cpuPercent, memoryBytes, tasks } = spec.limits;\n// memory.oom.group: an OOM ends the whole phase, never just one of its processes.\nconst wanted = { \"memory.max\": String(memoryBytes), \"memory.swap.max\": \"0\", \"memory.oom.group\": \"1\", \"pids.max\": String(tasks), \"cpu.max\": `${cpuPercent * 1000} 100000` };\ntry {\n  fs.mkdirSync(supervisor);\n  fs.mkdirSync(payload);\n  fs.writeFileSync(path.join(supervisor, \"cgroup.procs\"), String(process.pid));\n  fs.writeFileSync(path.join(scope, \"cgroup.subtree_control\"), \"+cpu +memory +pids\");\n  for (const [file, value] of Object.entries(wanted)) fs.writeFileSync(path.join(payload, file), value);\n} catch (error) {\n  fail(`could not apply resource limits: ${error.code ?? error.message}`);\n}\nconst applied = Object.fromEntries(Object.keys(wanted).map((file) => [file, read(path.join(payload, file))]));\nconst mismatch = Object.keys(wanted).find((file) => applied[file] !== wanted[file]);\nif (mismatch) fail(`kernel did not apply ${mismatch}: wanted ${wanted[mismatch]}, read ${applied[mismatch]}`);\nreport({ cgroup: payload });\n\nlet finished = false;\nlet stopRequested = false;\nconst signalRequests = [];\nlet graceTimer = null;\nlet childResult = null;\n// The shell joins the payload cgroup before exec, so nothing task-controlled ever runs outside the limits.\nconst child = spawn(\"/bin/sh\", [\"-c\", 'echo $$ > \"$1\" && shift && exec \"$@\"', \"sh\", path.join(payload, \"cgroup.procs\"), spec.cmd, ...spec.argv], {\n  env: { PATH: \"/usr/bin:/bin\" },\n  stdio: \"inherit\",\n});\nconst killPayload = () => { try { fs.writeFileSync(path.join(payload, \"cgroup.kill\"), \"1\"); } catch {} };\nconst signalPayload = (name, graceMs) => {\n  if (name !== \"SIGTERM\" || !Number.isSafeInteger(graceMs) || graceMs < 0 || graceMs > 30_000) return;\n  const pids = (read(path.join(payload, \"cgroup.procs\")) ?? \"\").split(\"\\n\").filter(Boolean).map(Number).filter(Number.isSafeInteger);\n  let delivered = 0;\n  for (const pid of pids) {\n    try { process.kill(pid, name); delivered++; } catch {}\n  }\n  const request = { name, requestedAt: new Date().toISOString(), pids: pids.length, delivered, graceMs, forced: false };\n  signalRequests.push(request);\n  if (graceTimer) clearTimeout(graceTimer);\n  graceTimer = setTimeout(() => {\n    if (/^populated 1$/m.test(read(path.join(payload, \"cgroup.events\")) ?? \"\")) {\n      request.forced = true;\n      killPayload();\n    }\n    graceTimer = null;\n    if (childResult) finish(childResult.code, childResult.signal, childResult.spawnError);\n  }, graceMs);\n  graceTimer.unref();\n};\nlet controlText = \"\";\nconst control = fs.createReadStream(null, { fd: 4, autoClose: false });\ncontrol.on(\"data\", (chunk) => {\n  controlText += chunk.toString(\"utf8\");\n  let newline;\n  while ((newline = controlText.indexOf(\"\\n\")) >= 0) {\n    const line = controlText.slice(0, newline);\n    controlText = controlText.slice(newline + 1);\n    try {\n      const message = JSON.parse(line);\n      if (message?.type === \"signal\") signalPayload(message.name, message.graceMs);\n    } catch {}\n  }\n});\n// A stop can arrive before the shell has joined the leaf; keep emptying it until the child is gone.\nconst stop = () => { if (stopRequested) return; stopRequested = true; killPayload(); setInterval(killPayload, 50).unref(); };\nfor (const signal of [\"SIGTERM\", \"SIGINT\", \"SIGHUP\"]) process.on(signal, stop);\nchild.on(\"error\", (error) => finish(null, null, error.message));\nchild.on(\"exit\", (code, signal) => finish(code, signal, null));\n\nfunction finish(code, signal, spawnError) {\n  if (finished) return;\n  childResult = { code, signal, spawnError };\n  // The main command may exit before a descendant finishes handling SIGTERM. Let the\n  // requested grace interval elapse before cgroup cleanup escalates to SIGKILL.\n  if (graceTimer) return;\n  finished = true;\n  const procs = (read(path.join(payload, \"cgroup.procs\")) ?? \"\").split(\"\\n\").filter(Boolean);\n  const memoryEvents = keyed(read(path.join(payload, \"memory.events\")));\n  const pidsEvents = keyed(read(path.join(payload, \"pids.events\")));\n  const cpu = keyed(read(path.join(payload, \"cpu.stat\")));\n  const stats = {\n    limits: applied,\n    memoryPeakBytes: Number(read(path.join(payload, \"memory.peak\")) ?? NaN) || null,\n    oomKills: memoryEvents.oom_kill ?? null,\n    memoryMaxEvents: memoryEvents.max ?? null,\n    pidsPeak: Number(read(path.join(payload, \"pids.peak\")) ?? NaN) || null,\n    pidsMaxEvents: pidsEvents.max ?? null,\n    cpuUsageUsec: cpu.usage_usec ?? null,\n    cpuThrottledUsec: cpu.throttled_usec ?? null,\n    survivorsAfterExit: procs.length,\n  };\n  killPayload();\n  const deadline = Date.now() + 5000;\n  const poll = () => {\n    if (/^populated 0$/m.test(read(path.join(payload, \"cgroup.events\")) ?? \"\")) {\n      report({ ...stats, cleaned: true, stopped: stopRequested, signals: signalRequests, exitCode: code, signal, spawnError });\n      process.exit(code ?? (signal ? 128 + (os.constants.signals[signal] ?? 0) : 125));\n    }\n    if (Date.now() > deadline) {\n      report({ ...stats, cleaned: false, signals: signalRequests, exitCode: code, signal, spawnError, error: \"payload cgroup still populated after cgroup.kill\" });\n      process.exit(125);\n    }\n    setTimeout(poll, 20);\n  };\n  poll();\n}\n// Kernel-enforced resource contract for task-controlled executions (eval/README.md, \"Resource contract\").\n// Each execution runs in its own delegated transient systemd --user scope under eval/cgroup_supervisor.mjs, which\n// applies cgroup v2 cpu.max, memory.max (swap 0) and pids.max to a payload leaf, verifies them, and kills the whole\n// cgroup afterwards. Workspaces and homes live on a dedicated size-capped tmpfs (storageBytes): that cap bounds\n// everything a run keeps on disk across phases, and each phase's writes are additionally charged to its memory.max.\nimport { spawn, spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst SYSTEMD_RUN = \"/usr/bin/systemd-run\";\nconst SUPERVISOR = fileURLToPath(new URL(\"./cgroup_supervisor.mjs\", import.meta.url));\nconst TMPFS_MAGIC = 0x01021994;\n\n/** Null when `resources` is a complete, sane contract; otherwise why it is not. */\nexport function resourceConfigProblem(resources) {\n  if (!resources || typeof resources !== \"object\") return \"resources must set cpuPercent, memoryBytes, tasks, storageBytes and workspaceRoot\";\n  const { cpuPercent, memoryBytes, tasks, storageBytes, workspaceRoot } = resources;\n  if (!Number.isInteger(cpuPercent) || cpuPercent < 10 || cpuPercent > 100 * 1024) return \"resources.cpuPercent must be an integer from 10 to 102400\";\n  if (!Number.isInteger(memoryBytes) || memoryBytes < 64 * 1024 * 1024 || memoryBytes % 4096 !== 0) return \"resources.memoryBytes must be a multiple of 4096 of at least 64 MiB\";\n  if (!Number.isInteger(tasks) || tasks < 8 || tasks > 1 << 20) return \"resources.tasks must be an integer from 8 to 1048576\";\n  if (!Number.isInteger(storageBytes) || storageBytes < 64 * 1024 * 1024) return \"resources.storageBytes must be an integer of at least 64 MiB\";\n  if (typeof workspaceRoot !== \"string\" || !path.isAbsolute(workspaceRoot)) return \"resources.workspaceRoot must be an absolute path\";\n  let stat;\n  try { stat = fs.statfsSync(workspaceRoot); }\n  catch { return \"resources.workspaceRoot is unavailable\"; }\n  if (stat.type !== TMPFS_MAGIC) return \"resources.workspaceRoot must be on a tmpfs so candidate writes are charged to the run's memory limit\";\n  const mountProblem = dedicatedTmpfsMountProblem(workspaceRoot);\n  if (mountProblem) return mountProblem;\n  if (stat.blocks * stat.bsize > storageBytes) return `resources.workspaceRoot tmpfs is ${stat.blocks * stat.bsize} bytes; mount a dedicated tmpfs with size<=storageBytes (${storageBytes})`;\n  return null;\n}\n\n/** A subdirectory of a shared tmpfs (including /dev/shm) does not enforce a per-run storage cap. */\nexport function dedicatedTmpfsMountProblem(workspaceRoot, mountInfoText = null) {\n  let lines;\n  try { lines = (mountInfoText ?? fs.readFileSync(\"/proc/self/mountinfo\", \"utf8\")).split(\"\\n\"); }\n  catch { return \"resources.workspaceRoot mount table is unavailable; refusing unverified workspace storage limits\"; }\n  const decode = (value) => value.replace(/\\\\([0-7]{3})/g, (_match, octal) => String.fromCharCode(Number.parseInt(octal, 8)));\n  const expected = path.resolve(workspaceRoot);\n  const matching = lines.filter((entry) => {\n    const fields = entry.split(\" \");\n    return fields.length > 6 && decode(fields[4]) === expected;\n  });\n  if (matching.length > 1) return \"resources.workspaceRoot has stacked or duplicate mount records; refusing ambiguous workspace storage boundary\";\n  const line = matching[0];\n  if (!line) return \"resources.workspaceRoot must be the exact mount point of a dedicated tmpfs, not a subdirectory\";\n  const fields = line.split(\" \");\n  const separator = fields.indexOf(\"-\");\n  if (separator < 0 || fields[separator + 1] !== \"tmpfs\" || decode(fields[3]) !== \"/\") {\n    return \"resources.workspaceRoot must be its own tmpfs mount, not a shared or bind-mounted filesystem\";\n  }\n  // A bind mount of a tmpfs root retains the same major:minor and root fields. Reject aliases of\n  // this mount so an apparently dedicated path cannot expose a tmpfs shared at another path.\n  const device = fields[2];\n  const aliases = lines.filter((entry) => {\n    const other = entry.split(\" \");\n    return other.length > 6 && other[2] === device && decode(other[4]) !== expected;\n  });\n  if (aliases.length > 0) return \"resources.workspaceRoot tmpfs is also mounted elsewhere; bind/shared mounts are not allowed\";\n  const options = `${fields[5]},${fields[separator + 3] ?? \"\"}`.split(\",\");\n  const mode = options.find((option) => option.startsWith(\"mode=\"))?.slice(5);\n  const uid = options.find((option) => option.startsWith(\"uid=\"))?.slice(4);\n  const mountMode = mode ? Number.parseInt(mode, 8) : null;\n  if (mountMode === null || (mountMode & 0o700) !== 0o700 || (mountMode & 0o066) !== 0 || uid !== String(process.getuid())) {\n    return \"dedicated tmpfs must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\";\n  }\n  let rootStat;\n  try { rootStat = fs.statSync(expected); }\n  catch { return \"resources.workspaceRoot mount root cannot be inspected; refusing unverified workspace permissions\"; }\n  const rootMode = rootStat.mode & 0o777;\n  if (rootStat.uid !== process.getuid() || (rootMode & 0o700) !== 0o700 || (rootMode & 0o066) !== 0) {\n    return \"dedicated tmpfs effective mount root must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\";\n  }\n  return null;\n}\n\n/** Null when a contained probe proves this host applies and cleans up the contract; otherwise the failure. */\nexport function resourceProbeProblem(resources) {\n  const configProblem = resourceConfigProblem(resources);\n  if (configProblem) return configProblem;\n  let wrapped;\n  try { wrapped = containedSpec({ cmd: \"/usr/bin/true\", argv: [] }, resources); }\n  catch (error) { return error.message; }\n  const result = spawnSync(wrapped.cmd, wrapped.argv, { cwd: \"/\", env: wrapped.env, stdio: [\"ignore\", \"ignore\", \"pipe\", \"pipe\"], timeout: 15_000, encoding: \"utf8\" });\n  const final = parseReports(result.output?.[3] ?? \"\").final;\n  if (!final) return `resource probe produced no containment report (${result.error?.message ?? `exit ${result.status}`}: ${(result.stderr ?? \"\").trim().slice(-300)})`;\n  if (final.error || !final.cleaned) return `resource probe failed: ${final.error ?? \"payload not cleaned\"}`;\n  if (final.exitCode !== 0) return `resource probe command exited ${final.exitCode}`;\n  return null;\n}\n\n/** The command line that runs `spec` under the supervisor in a fresh scope with `resources` applied. */\nexport function containedSpec(spec, resources) {\n  const { XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS } = process.env;\n  if (!XDG_RUNTIME_DIR) throw new Error(\"resource containment needs the systemd user manager (XDG_RUNTIME_DIR is unset)\");\n  if (!fs.existsSync(SYSTEMD_RUN)) throw new Error(\"resource containment needs systemd-run\");\n  const limits = { cpuPercent: resources.cpuPercent, memoryBytes: resources.memoryBytes, tasks: resources.tasks };\n  return {\n    cmd: SYSTEMD_RUN,\n    argv: [\"--user\", \"--scope\", \"--quiet\", \"--collect\", \"-p\", \"Delegate=yes\", \"--\", process.execPath, SUPERVISOR, JSON.stringify({ limits, cmd: spec.cmd, argv: spec.argv })],\n    env: { XDG_RUNTIME_DIR, ...(DBUS_SESSION_BUS_ADDRESS ? { DBUS_SESSION_BUS_ADDRESS } : {}) },\n    timeoutMs: spec.timeoutMs,\n  };\n}\n\n/**\n * Spawn `spec` (contained when `resources` is set). `containment.kill()` empties the payload cgroup;\n * `containment.final` resolves to the supervisor's last report, or null when it never reported.\n */\nexport function spawnContained(spec, resources, { stdio, ...options }) {\n  if (!resources) return { child: spawn(spec.cmd, spec.argv, { ...options, stdio, env: options.env ?? {} }), containment: null };\n  const wrapped = containedSpec(spec, resources);\n  const child = spawn(wrapped.cmd, wrapped.argv, { ...options, env: wrapped.env, stdio: [...stdio, \"pipe\", \"pipe\"] });\n  const control = child.stdio[4];\n  let text = \"\";\n  let cgroup = null;\n  const final = new Promise((resolve) => {\n    child.stdio[3].on(\"data\", (chunk) => {\n      text += chunk.toString(\"utf8\");\n      const reports = parseReports(text);\n      cgroup ??= reports.cgroup;\n      // Close the supervisor's control pipe after its final report. Otherwise the parent write end can\n      // keep ChildProcess's `close` event pending even though the supervised command and scope have exited.\n      if (reports.final && control && !control.destroyed) control.end();\n    });\n    child.stdio[3].on(\"close\", () => resolve(parseReports(text).final));\n    child.on(\"error\", () => resolve(null));\n  });\n  const signal = (name, graceMs = 5000) => {\n    if (name !== \"SIGTERM\" || !Number.isSafeInteger(graceMs) || graceMs < 0 || graceMs > 30_000) {\n      throw new Error(\"contained payload supports SIGTERM with a grace period from 0 to 30000 ms\");\n    }\n    if (!control || control.destroyed || !control.writable) return false;\n    return control.write(`${JSON.stringify({ type: \"signal\", name, graceMs })}\\n`);\n  };\n  let repeat = null;\n  let fallback = null;\n  const killPayload = () => { if (cgroup) { try { fs.writeFileSync(path.join(cgroup, \"cgroup.kill\"), \"1\"); } catch {} } };\n  const kill = () => {\n    if (repeat) return;\n    // The payload may not have joined its leaf yet, or may fork after a kill: keep emptying the leaf until the\n    // supervisor exits. The supervisor also stops on SIGTERM. One that does not exit loses its report, so the run fails\n    // on containmentProblem; the fallback then kills the supervisor while the repeat keeps emptying the payload leaf.\n    killPayload();\n    try { process.kill(child.pid, \"SIGTERM\"); } catch {}\n    repeat = setInterval(killPayload, 50);\n    fallback = setTimeout(() => { try { process.kill(-child.pid, \"SIGKILL\"); } catch {} }, 10_000);\n    setTimeout(() => clearInterval(repeat), 30_000).unref();\n  };\n  child.on(\"close\", () => { clearInterval(repeat); clearTimeout(fallback); killPayload(); });\n  return { child, containment: { final, kill, signal } };\n}\n\n/** Why a finished contained execution cannot be trusted as bounded, or null. */\nexport function containmentProblem(final) {\n  if (!final) return \"no containment report from the resource supervisor\";\n  if (final.error) return final.error;\n  if (!final.cleaned) return \"payload cgroup was not emptied\";\n  return null;\n}\n\nfunction parseReports(text) {\n  let cgroup = null;\n  let final = null;\n  for (const line of text.split(\"\\n\")) {\n    if (!line.trim()) continue;\n    let value;\n    try { value = JSON.parse(line); } catch { continue; }\n    if (value.cgroup && Object.keys(value).length === 1) cgroup = value.cgroup;\n    else final = value;\n  }\n  return { cgroup, final };\n}\n","exit_code":0,"duration":{"secs":0,"nanos":28922}},"started_at_ms":1792916828465,"completed_at_ms"