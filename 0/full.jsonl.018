1-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\",\"number\":16,\"startedAt\":\"2026-10-25T04:01:53Z\",\"status\":\"in_progress\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Install pinned security and SBOM test tools\",\"number\":17,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run npm --prefix cli test\",\"number\":18,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":34,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":35,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":36,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40160250252/job/121070119892\"}],\"name\":\"CI\",\"status\":\"in_progress\",\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40160250252\"}\n{\"conclusion\":\"\",\"headSha\":\"a3e1b65a36b4c64f44e5def6500214d1b256d4be\",\"jobs\":[{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"databaseId\":121070119683,\"name\":\"javascript-typescript\",\"startedAt\":\"2026-10-25T03:59:58Z\",\"status\":\"in_progress\",\"steps\":[{\"completedAt\":\"2026-10-25T03:59:59Z\",\"conclusion\":\"success\",\"name\":\"Set up job\",\"number\":1,\"startedAt\":\"2026-10-25T03:59:58Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T04:00:01Z\",\"conclusion\":\"success\",\"name\":\"Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":2,\"startedAt\":\"2026-10-25T03:59:59Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T04:00:16Z\",\"conclusion\":\"success\",\"name\":\"Run github/codeql-action/init@d0bae162f31f17dd92c46ccdc4dfee5710f8dc67\",\"number\":3,\"startedAt\":\"2026-10-25T04:00:01Z\",\"status\":\"completed\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run github/codeql-action/analyze@d0bae162f31f17dd92c46ccdc4dfee5710f8dc67\",\"number\":4,\"startedAt\":\"2026-10-25T04:00:16Z\",\"status\":\"in_progress\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run github/codeql-action/analyze@d0bae162f31f17dd92c46ccdc4dfee5710f8dc67\",\"number\":6,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run github/codeql-action/init@d0bae162f31f17dd92c46ccdc4dfee5710f8dc67\",\"number\":7,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":8,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40160250231/job/121070119683\"}],\"name\":\"CodeQL\",\"status\":\"in_progress\",\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40160250231\"}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17136-12b9-7661-904c-f2b43120b5c8","create_time":1792900917.925019}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
