{"timestamp":"2026-10-25T04:50:01.242Z","ordinal":324394,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a1715b-2cc0-7ec0-b38e-9954515e542c","item":{"type":"CommandExecution","id":"exec-d2fe2437-42d8-4ccb-91cb-2242a3cc825c","process_id":"74498","command":["/usr/bin/zsh","-lc","git status --short --branch && git log --oneline -4 && git show --stat --oneline HEAD && git show HEAD -- scripts/installer-smoke.sh && git show c5329103168fb1dfcf8438ccc3f8bd21312f5419:install.sh | rg -n -C 2 'NEXUS_VERIFY_ATTESTATION' && git show c5329103168fb1dfcf8438ccc3f8bd21312f5419:scripts/installer-smoke.sh | sed -n '1,75p'"],"cwd":"file:///home/mike/nexus-wt/plan-07-installer-attestation-fix","parsed_cmd":[{"type":"unknown","cmd":"git status --short --branch && git log --oneline -4 && git show --stat --oneline HEAD && git show HEAD -- scripts/installer-smoke.sh && git show c5329103168fb1dfcf8438ccc3f8bd21312f5419:install.sh | rg -n -C 2 'NEXUS_VERIFY_ATTESTATION' && git show c5329103168fb1dfcf8438ccc3f8bd21312f5419:scripts/installer-smoke.sh | sed -n '1,75p'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"## v1/plan-07-installer-attestation-fix...origin/v1/plan-07-installer-attestation-fix [ahead 1]\n8faf36a test: clear attestation opt-out in strict smoke case\nc532910 fix installer attestation verification\na3e1b65 Merge pull request #210 from mikeholownych/v1/defect-upgrade-attestation\n4e7297f Merge pull request #209 from mikeholownych/v1/plan-01-sec101-119-pty-followup\n8faf36a test: clear attestation opt-out in strict smoke case\n scripts/installer-smoke.sh | 3 ++-\n 1 file changed, 2 insertions(+), 1 deletion(-)\ncommit 8faf36aa43e9f74b823e68233f37180e68ff5cdb\nAuthor: Mike Holownych <mike@holownych.com>\nDate:   Sun Oct 25 04:48:32 2026 +0000\n\n    test: clear attestation opt-out in strict smoke case\n\ndiff --git a/scripts/installer-smoke.sh b/scripts/installer-smoke.sh\nindex 7fe9dbe..b0a3b47 100644\n--- a/scripts/installer-smoke.sh\n+++ b/scripts/installer-smoke.sh\n@@ -43,7 +43,8 @@ printf 'PATH shim invoked\\\\n' >> '$TMP/path-shim.log'\n exit 0\n EOF\n chmod +x \"$TMP/path-shim/gh\"\n-if NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\n+if env -u NEXUS_VERIFY_ATTESTATION \\\n+  NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\n   NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" \\\n   PATH=\"$TMP/path-shim:$PATH\" sh \"$TMP/install-test.sh\" > \"$TMP/no-trusted-gh.out\" 2>&1; then\n   echo \"installer accepted required provenance without a trusted gh\" >&2\n19-command -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n20-\n21:VERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION:-1}\n22-case \"$VERIFY_ATTESTATION\" in\n23-  0|1) ;;\n24:  *) fail \"NEXUS_VERIFY_ATTESTATION must be 1 (verify provenance) or 0 (explicitly skip verification).\" ;;\n25-esac\n26-TRUSTED_GH=\n--\n31-fi\n32-if [ \"$VERIFY_ATTESTATION\" = \"1\" ] && [ -z \"$TRUSTED_GH\" ]; then\n33:  fail \"provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\"\n34-fi\n35-\n#!/usr/bin/env bash\nset -euo pipefail\nINSTALLER=${1:?usage: installer-smoke.sh INSTALLER ARCHIVE}\nARCHIVE=${2:?usage: installer-smoke.sh INSTALLER ARCHIVE}\nTMP=$(mktemp -d)\nSERVER_PID=\ncleanup() { [ -z \"$SERVER_PID\" ] || kill \"$SERVER_PID\" 2>/dev/null || true; rm -rf \"$TMP\"; }\ntrap cleanup EXIT\nNAME=$(basename \"$ARCHIVE\")\nVERSION=${NAME#nexus-linux-x86_64-}\nVERSION=${VERSION%.tar.gz}\n# This fixture uses locally generated, unattested packages except in the explicit\n# trusted-gh case below. Make that test-only opt-out visible to every installer run.\nexport NEXUS_VERIFY_ATTESTATION=0\nmkdir -p \"$TMP/release/download/$VERSION\" \"$TMP/prefix/bin\"\ncp \"$ARCHIVE\" \"$TMP/release/download/$VERSION/$NAME\"\n(cd \"$TMP/release/download/$VERSION\" && sha256sum \"$NAME\" > SHA256SUMS)\npython3 \"$(dirname \"$0\")/package-smoke-http.py\" \"$TMP/release\" > \"$TMP/http.log\" 2>&1 &\nSERVER_PID=$!\nfor _ in $(seq 1 50); do\n  PORT=$(sed -n 's/^PORT=//p' \"$TMP/http.log\" | head -n 1)\n  [ -n \"$PORT\" ] && break\n  sleep 0.1\ndone\n[ -n \"${PORT:-}\" ] || { cat \"$TMP/http.log\" >&2; echo \"HTTP fixture did not start\" >&2; exit 1; }\nrun_installer() {\n  NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/prefix\" NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" \\\n    sh \"$INSTALLER\"\n}\nrun_installer\n\"$TMP/prefix/bin/nexus\" --version | grep -F \"${VERSION#v}\" >/dev/null\n\n# Attestation is required by default and must never trust a PATH shim.\n# Relocate only the fixed trusted binary locations in a private installer copy so this\n# fixture exercises both branches without depending on whether the host has gh installed.\nmkdir -p \"$TMP/trusted/usr/bin\" \"$TMP/trusted/usr/local/bin\" \"$TMP/path-shim\" \"$TMP/attestation-prefix/bin\"\nsed \"s|/usr/bin/gh|$TMP/trusted/usr/bin/gh|g; s|/usr/local/bin/gh|$TMP/trusted/usr/local/bin/gh|g\" \\\n  \"$INSTALLER\" > \"$TMP/install-test.sh\"\nchmod +x \"$TMP/install-test.sh\"\ncat > \"$TMP/path-shim/gh\" <<EOF\n#!/bin/sh\nprintf 'PATH shim invoked\\\\n' >> '$TMP/path-shim.log'\nexit 0\nEOF\nchmod +x \"$TMP/path-shim/gh\"\nif NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\n  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" \\\n  PATH=\"$TMP/path-shim:$PATH\" sh \"$TMP/install-test.sh\" > \"$TMP/no-trusted-gh.out\" 2>&1; then\n  echo \"installer accepted required provenance without a trusted gh\" >&2\n  exit 1\nfi\ngrep -F \"no trusted GitHub CLI was found\" \"$TMP/no-trusted-gh.out\" >/dev/null\n[ ! -e \"$TMP/path-shim.log\" ] || { echo \"installer invoked PATH gh shim\" >&2; exit 1; }\nif NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/invalid-mode\" \\\n  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" NEXUS_VERIFY_ATTESTATION=auto \\\n  sh \"$INSTALLER\" > \"$TMP/invalid-mode.out\" 2>&1; then\n  echo \"installer accepted an unsupported attestation mode\" >&2\n  exit 1\nfi\ngrep -F \"NEXUS_VERIFY_ATTESTATION must be\" \"$TMP/invalid-mode.out\" >/dev/null\ncat > \"$TMP/trusted/usr/bin/gh\" <<'EOF'\n#!/bin/sh\nprintf '%s\\n' \"$*\" >> \"$TRUSTED_GH_LOG\"\nexit 0\nEOF\nchmod +x \"$TMP/trusted/usr/bin/gh\"\nNEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\n  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" NEXUS_VERIFY_ATTESTATION=1 \\\n  TRUSTED_GH_LOG=\"$TMP/trusted-gh.log\" PATH=\"$TMP/path-shim:$PATH\" \\\n  sh \"$TMP/install-test.sh\" > \"$TMP/trusted-gh.out\" 2>&1\ngrep -F \"verified build provenance\" \"$TMP/trusted-gh.out\" >/dev/null\n[ \"$(wc -l < \"$TMP/trusted-gh.log\")\" -eq 2 ] || { echo \"installer did not verify both provenance subjects\" >&2; exit 1; }\n[ ! -e \"$TMP/path-shim.log\" ] || { echo \"installer invoked PATH gh shim\" >&2; exit 1; }\nnode - \"$TMP/prefix/lib/nexus/$VERSION/.provenance.json\" \"$VERSION\" \"$TMP/prefix\" \"$TMP/prefix/lib/nexus/$VERSION\" \"$TMP/prefix/bin/nexus\" \"$NAME\" \"$TMP/release/download/$VERSION/$NAME\" <<'NODE'\nconst assert = require(\"node:assert/strict\");\n","exit_code":0,"duration":{"secs":0,"nanos":874439958}},"started_at_ms":1792903800367,"completed_at_ms":1792903801242}}
