9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)\\\\n                )\\\\n            )*\\\\n        )?\\\\n    )\\\\n    $\\\\n    \\\\\\\"\\\\\\\"\\\\\\\",\\\\n    re.VERBOSE,\\\\n)\\\\n\\\\n\\\\ndef _parse_version(text):\\\\n    m = _VERSION_RE.match(text)\\\\n    if not m:\\\\n        raise ValueError(f\\\\\\\"invalid version: {text!r}\\\\\\\")\\\\n\\\\n    major = int(m.group(\\\\\\\"major\\\\\\\"))\\\\n    minor = int(m.group(\\\\\\\"minor\\\\\\\"))\\\\n    patch = int(m.group(\\\\\\\"patch\\\\\\\"))\\\\n\\\\n    pre_text = m.group(\\\\\\\"pre\\\\\\\")\\\\n    if pre_text is None:\\\\n        prerelease = None\\\\n    else:\\\\n        prerelease = tuple(pre_text.split(\\\\\\\".\\\\\\\"))\\\\n\\\\n    return (major, minor, patch, prerelease)\\\\n\\\\n\\\\ndef _identifier_type(identifier):\\\\n    if identifier.isdigit():\\\\n        return (\\\\\\\"num\\\\\\\", int(identifier))\\\\n    return (\\\\\\\"alnum\\\\\\\", identifier)\\\\n\\\\n\\\\ndef _compare_prerelease(a, b):\\\\n    if a is None and b is None:\\\\n        return 0\\\\n    if a is None:\\\\n        return 1\\\\n    if b is None:\\\\n        return -1\\\\n\\\\n    for x, y in zip(a, b):\\\\n        tx = _identifier_type(x)\\\\n        ty = _identifier_type(y)\\\\n\\\\n        if tx[0] == \\\\\\\"num\\\\\\\" and ty[0] == \\\\\\\"num\\\\\\\":\\\\n            if tx[1] < ty[1]:\\\\n                return -1\\\\n            if tx[1] > ty[1]:\\\\n                return 1\\\\n        elif tx[0] == \\\\\\\"num\\\\\\\":\\\\n            return -1\\\\n        elif ty[0] == \\\\\\\"num\\\\\\\":\\\\n            return 1\\\\n        else:\\\\n            if tx[1] < ty[1]:\\\\n                return -1\\\\n            if tx[1] > ty[1]:\\\\n                return 1\\\\n\\\\n    if len(a) < len(b):\\\\n        return -1\\\\n    if len(a) > len(b):\\\\n        return 1\\\\n    return 0\\\\n\\\\n\\\\ndef _compare_versions(a, b):\\\\n    for i in range(3):\\\\n        if a[i] < b[i]:\\\\n            return -1\\\\n        if a[i] > b[i]:\\\\n            return 1\\\\n    return _compare_prerelease(a[3], b[3])\\\\n\\\\n\\\\ndef _parse_comparator(text):\\\\n    m = _COMPARATOR_RE.match(text)\\\\n    if not m:\\\\n        raise ValueError(f\\\\\\\"invalid comparator: {text!r}\\\\\\\")\\\\n\\\\n    op = m.group(\\\\\\\"op\\\\\\\") or \\\\\\\"=\\\\\\\"\\\\n    version = _parse_version(m.group(\\\\\\\"ver\\\\\\\"))\\\\n    return op, version\\\\n\\\\n\\\\ndef _caret_upper_bound(v):\\\\n    major, minor, patch, _ = v\\\\n\\\\n    if major > 0:\\\\n        return (major + 1, 0, 0, None)\\\\n    if minor > 0:\\\\n        return (0, minor + 1, 0, None)\\\\n    return (0, 0, patch + 1, None)\\\\n\\\\n\\\\ndef _tilde_upper_bound(v):\\\\n    major, minor, patch, _ = v\\\\n    return (major, minor + 1, 0, None)\\\\n\\\\n\\\\ndef _comparator_satisfied(version, comparator):\\\\n    op, target = comparator\\\\n\\\\n    if op == \\\\\\\"=\\\\\\\":\\\\n        return _compare_versions(version, target) == 0\\\\n    if op == \\\\\\\">\\\\\\\":\\\\n        return _compare_versions(version, target) > 0\\\\n    if op == \\\\\\\">=\\\\\\\":\\\\n        return _compare_versions(version, target) >= 0\\\\n    if op == \\\\\\\"<\\\\\\\":\\\\n        return _compare_versions(version, target) < 0\\\\n    if op == \\\\\\\"<=\\\\\\\":\\\\n        return _compare_versions(version, target) <= 0\\\\n    if op == \\\\\\\"^\\\\\\\":\\\\n        return (\\\\n            _compare_versions(version, target) >= 0\\\\n            and _compare_versions(version, _caret_upper_bound(target)) < 0\\\\n        )\\\\n    if op == \\\\\\\"~\\\\\\\":\\\\n        return (\\\\n            _compare_versions(version, target) >= 0\\\\n            and _compare_versions(version, _tilde_upper_bound(target)) < 0\\\\n        )\\\\n\\\\n    raise ValueError(f\\\\\\\"invalid operator: {op!r}\\\\\\\")\\\\n\\\\n\\\\ndef _prerelease_rule_satisfied(version, comparators):\\\\n    if version[3] is None:\\\\n        return True\\\\n\\\\n    for _, target in comparators:\\\\n        if (\\\\n            version[:3] == target[:3]\\\\n            and target[3] is not None\\\\n        ):\\\\n            return True\\\\n\\\\n    return False\\\\n\\\\n\\\\ndef satisfies(version, rng):\\\\n    v = _parse_version(version)\\\\n\\\\n    sets = rng.split(\\\\\\\"||\\\\\\\")\\\\n    parsed_sets = []\\\\n\\\\n    for raw_set in sets:\\\\n        comparators_text = raw_set.split()\\\\n        if not comparators_text:\\\\n            raise ValueError(\\\\\\\"empty comparator set\\\\\\\")\\\\n\\\\n        parsed_set = []\\\\n        for comparator_text in comparators_text:\\\\n            parsed_set.append(_parse_comparator(comparator_text))\\\\n\\\\n        parsed_sets.append(parsed_set)\\\\n\\\\n    for parsed_set in parsed_sets:\\\\n        if not _prerelease_rule_satisfied(v, parsed_set):\\\\n            continue\\\\n\\\\n        if all(_comparator_satisfied(v, comparator) for comparator in parsed_set):\\\\n            return True\\\\n\\\\n    return False\\\\n```\\\", \\\"reasoning_tail\\\": \\\"tch, prerelease_tuple_or_None). prerelease tuple of identifiers? Need compare. Numeric identifiers: if all digits? But validation ensures numeric no leading zeros. For comparison, if identifier is purely numeric, compare numerically; else ASCII order. Need distinguish numeric vs alphanumeric. Could store identifier as tuple ('num', int) or ('str', string). Or store string and check isdigit? But alphanumeric may contain digits and letters; isdigit false if letters/hyphen. Hyphen not digit. Numeric identifiers are all digits. Since validation no leading zeros, int conversion okay. For ASCII order, Python string comparison uses Unicode code points; for ASCII chars [0-9A-Za-z-], same as ASCII. Need numeric always lower than alphanumeric. If both numeric compare ints. If both alphanumeric compare strings. If one numeric one alphanumeric: numeric lower. If all shared equal, fewer identifiers lower. Also version with prerelease lower than same version without. So compare function:\\\\ncompare_versions(a,b): compare major/minor/patch. If differ return sign. If both no prerelease return 0. If a has prerelease and b not: return -1. If a not and b has: return 1. If both have: compare prerelease tuples. For each identifier up to min length: if both numeric: compare ints; if one numeric: numeric lower; if both alphanumeric: compare strings. If differ return. If lengths differ: shorter lower. Else 0.\\\\n\\\\nNeed comparator semantics:\\\\n- equal: compare == 0.\\\\n- >: compare > 0.\\\\n- >=: compare >= 0.\\\\n- <: compare < 0.\\\\n- <=: compare <= 0.\\\\n- ^V: version >= V and version < upper. Upper depends on V's major/minor/patch. Need if MAJOR > 0: upper = (major+1,0,0,no prerelease). elif MINOR > 0: upper = (0, minor+1, 0, no prerelease). else: upper = (0,0,patch+1,no prerelease). Wait spec: < (MAJOR+1).0.0 if MAJOR > 0, else < 0.(MINOR+1).0 if MINOR > 0, else < 0.0.(PATCH+1). This is unusual for major=0. For ^0.Reasoning budget exhausted. Stop reasoning now and write the final answer in the required format.\\\\n\\\", \\\"wall_secs\\\": 192.0, \\\"prompt_tokens\\\": 764, \\\"completion_tokens\\\": 3604, \\\"reasoning_tokens\\\": null, \\\"answer_tokens\\\": null, \\\"reasoning_chars\\\": 7956, \\\"ttft_ms_est\\\": 5402.6, \\\"prompt_ms\\\": 5350.81, \\\"predicted_ms\\\": 186602.07, \\\"predicted_n\\\": 3604, \\\"reasoning_budget\\\": 2048, \\\"budget_reached\\\": null, \\\"valid_final_answer\\\": true, \\\"termination\\\": \\\"stop\\\"}], \\\"wall_secs\\\": 192.0, \\\"rep\\\": 1}]}\\nevaluations/engx/results/remote-qualification-20261007-2048/eng-hard-flashnext-2048.partial.json:1:{\\\"label\\\": \\\"flashnext-2048\\\", \\\"meta\\\": {\\\"model\\\": \\\"candidate/flashnext-deep\\\", \\\"base_url\\\": \\\"https://10.0.8.5:8443/v1\\\", \\\"corpus\\\": \\\"hard\\\", \\\"corpus_digest\\\": \\\"92e26705ddc4ea9d\\\", \\\"max_tokens\\\": 12288, \\\"max_attempts\\\": 1, \\\"only\\\": [\\\"H01\\\"], \\\"condition\\\": null,