{"timestamp":"2026-10-25T07:39:16.577Z","ordinal":329451,"type":"token_usage_record","payload":{"thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a171fd-3278-7ca3-ad25-d2f716cb2b15","session_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","root_turn_id":"01a171fd-3278-7ca3-ad25-d2f716cb2b15","response_id":"resp_060b64278a9dfb15016addb21342d081a085fbff54dd2698c0","usage":{"input_tokens":211992,"cached_input_tokens":210304,"cache_write_input_tokens":0,"output_tokens":2107,"reasoning_output_tokens":1960,"total_tokens":214099},"turn_token_usage":{"input_tokens":2846993,"cached_input_tokens":2798976,"cache_write_input_tokens":0,"output_tokens":16408,"reasoning_output_tokens":13321,"total_tokens":2863401},"thread_token_usage":{"input_tokens":6003091235,"cached_input_tokens":5938825984,"cache_write_input_tokens":0,"output_tokens":17031502,"reasoning_output_tokens":9812759,"total_tokens":6020122737}}}
{"timestamp":"2026-10-25T07:39:18.363Z","ordinal":329452,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a171fd-3278-7ca3-ad25-d2f716cb2b15","item":{"type":"CommandExecution","id":"exec-c171b69b-da1a-48a0-898a-6d994b9d8310","process_id":"54108","command":["/usr/bin/zsh","-lc","sed -n '1,140p' cli/test/eval_integrity.test.ts; sed -n '1115,1170p' cli/test/eval_integrity.test.ts; sed -n '1,130p' eval/score.mjs; sed -n '1,90p' eval/validate.mjs; rg -n 'faults|T4' eval/README.md | head -30"],"cwd":"file:///home/mike/nexus-wt/plan10-pr10c-t4","parsed_cmd":[{"type":"read","cmd":"sed -n '1,140p' cli/test/eval_integrity.test.ts","name":"eval_integrity.test.ts","path":"cli/test/eval_integrity.test.ts"},{"type":"read","cmd":"sed -n '1115,1170p' cli/test/eval_integrity.test.ts","name":"eval_integrity.test.ts","path":"cli/test/eval_integrity.test.ts"},{"type":"read","cmd":"sed -n '1,130p' eval/score.mjs","name":"score.mjs","path":"eval/score.mjs"},{"type":"read","cmd":"sed -n '1,90p' eval/validate.mjs","name":"validate.mjs","path":"eval/validate.mjs"},{"type":"search","cmd":"rg -n 'faults|T4' eval/README.md","query":"faults|T4","path":"README.md"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/**\n * Scoring integrity of the evaluation harness (REQ-QUAL-106, EVL-002/003/005): infrastructure failures are decided by\n * what the harness's model proxy observed, the same way for every agent; contaminated runs leave the pass rate;\n * reruns are listed; crashes are counted as crashes rather than rerun.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport http from \"node:http\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\nconst proxyModule = path.join(ROOT, \"eval/model_proxy.mjs\");\n\ntest(\"the model proxy forwards requests and counts answers and upstream failures\", async () => {\n  const { startModelProxy, isInfrastructureFailure } = await import(proxyModule);\n  const upstream = http.createServer((req, res) => {\n    if (req.url?.endsWith(\"/chat/completions\")) {\n      res.writeHead(503);\n      return void res.end(\"busy\");\n    }\n    res.setHeader(\"content-type\", \"application/json\");\n    res.end(JSON.stringify({ path: req.url }));\n  });\n  await new Promise<void>((r) => upstream.listen(0, \"127.0.0.1\", () => r()));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1` });\n  try {\n    assert.match(proxy.url, /^http:\\/\\/127\\.0\\.0\\.1:\\d+\\/v1$/);\n    const ok = await (await fetch(`${proxy.url}/models`)).json();\n    assert.equal(ok.path, \"/v1/models\");\n    assert.equal((await fetch(`${proxy.url}/chat/completions`, { method: \"POST\", body: \"{}\" })).status, 503);\n    assert.equal((await fetch(`${proxy.url}/admin/secrets`)).status, 404, \"control-plane paths are not forwarded\");\n    assert.equal((await fetch(`${proxy.url}/chat/completions`, { method: \"GET\" })).status, 404, \"unsupported methods are not forwarded\");\n    const stats = proxy.stats();\n    assert.equal(stats.requests, 4);\n    assert.equal(stats.answered, 1);\n    assert.equal(stats.upstreamFailures, 1);\n    assert.equal(isInfrastructureFailure({ model: stats }), false, \"the model answered: the run is scored\");\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n\n  const dead = await startModelProxy({ upstream: \"http://127.0.0.1:9/v1\" });\n  try {\n    assert.equal((await fetch(`${dead.url}/chat/completions`, { method: \"POST\", body: \"{}\" })).status, 502);\n    assert.equal(isInfrastructureFailure({ model: dead.stats() }), true, \"the model never answered and the endpoint failed\");\n  } finally {\n    await dead.close();\n  }\n});\n\ntest(\"the evaluation proxy authenticates the local run token and replaces it with the upstream credential\", async () => {\n  const { startModelProxy } = await import(proxyModule);\n  const seen: string[] = [];\n  const upstream = http.createServer((req, res) => {\n    seen.push(String(req.headers.authorization ?? \"\"));\n    res.end(JSON.stringify({ ok: true }));\n  });\n  await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1`, authToken: \"UPSTREAM_SECRET_CANARY\", clientToken: \"RUN_SCOPED_TOKEN\" });\n  try {\n    assert.equal((await fetch(`${proxy.url}/models`)).status, 401);\n    const accepted = await fetch(`${proxy.url}/models`, { headers: { authorization: \"Bearer RUN_SCOPED_TOKEN\" } });\n    assert.equal(accepted.status, 200);\n    assert.deepEqual(seen, [\"Bearer UPSTREAM_SECRET_CANARY\"]);\n    assert.equal((await fetch(`${proxy.url}/admin`, { headers: { authorization: \"Bearer RUN_SCOPED_TOKEN\" } })).status, 404);\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n});\n\ntest(\"the evaluation proxy bounds request count and body size\", async () => {\n  const { startModelProxy } = await import(proxyModule);\n  let upstreamRequests = 0;\n  const upstream = http.createServer((req, res) => { upstreamRequests++; req.resume(); res.end(\"ok\"); });\n  await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1`, maxRequests: 1, maxRequestBytes: 8 });\n  try {\n    const oversized = await fetch(`${proxy.url}/chat/completions`, { method: \"POST\", body: \"123456789\" }).catch(() => null);\n    assert.ok(oversized === null || oversized.status === 413);\n    assert.equal(upstreamRequests, 0, \"oversized bodies never reach the provider\");\n    assert.equal((await fetch(`${proxy.url}/models`)).status, 429);\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n});\n\ntest(\"the evaluation proxy bounds concurrent inference and cancels upstream work on client abort\", { timeout: 10_000 }, async () => {\n  const { startModelProxy, isInfrastructureFailure } = await import(proxyModule);\n  let upstreamRequests = 0;\n  let resolveFirstStarted!: () => void;\n  let resolveFirstClosed!: () => void;\n  const firstStarted = new Promise<void>((resolve) => { resolveFirstStarted = resolve; });\n  const firstClosed = new Promise<void>((resolve) => { resolveFirstClosed = resolve; });\n  const upstream = http.createServer((req, res) => {\n    upstreamRequests++;\n    req.resume();\n    if (upstreamRequests === 1) {\n      resolveFirstStarted();\n      res.once(\"close\", resolveFirstClosed);\n      return;\n    }\n    res.end(\"second request accepted after cancellation\");\n  });\n  await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1` });\n  const body = JSON.stringify({ max_tokens: 1 });\n  const send = (signal?: AbortSignal) => fetch(`${proxy.url}/chat/completions`, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/json\" },\n    body,\n    signal,\n  });\n  try {\n    const controller = new AbortController();\n    const first = send(controller.signal);\n    await firstStarted;\n    assert.equal(proxy.stats().activeInferenceRequests, 1);\n\n    const concurrent = await send();\n    assert.equal(concurrent.status, 429);\n    assert.equal((await concurrent.json()).error.type, \"concurrency_limit\");\n    assert.equal(upstreamRequests, 1, \"a rejected concurrent request never reaches the provider\");\n\n    controller.abort();\n    await assert.rejects(first, { name: \"AbortError\" });\n    await Promise.race([\n      firstClosed,\n      new Promise<never>((_, reject) => setTimeout(() => reject(new Error(\"upstream remained open after client abort\")), 1_000)),\n    ]);\n  assert.equal(out.status, 2, out.stdout + out.stderr);\n  assert.match(out.stderr, /not starting/);\n  assert.match(out.stderr, /broken: tier must be one of/);\n  assert.ok(!fs.existsSync(path.join(tasks, \"out\", \"results.jsonl\")), \"no run was recorded\");\n});\n\n// ---------------------------------------------------------------- T4 fault injection (REQ-QUAL-105)\n\ntest(\"the model proxy injects each scheduled fault into the chat request it names, and records it\", async () => {\n  const { startModelProxy, isInfrastructureFailure } = await import(proxyModule);\n  const sse = (o: unknown) => `data: ${JSON.stringify(o)}\\n\\n`;\n  const upstream = http.createServer((req, res) => {\n    req.resume();\n    res.writeHead(200, { \"content-type\": \"text/event-stream\" });\n    res.end(\n      sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: 0, id: \"c\", type: \"function\", function: { name: \"read_file\", arguments: \"\" } }] } }] }) +\n      sse({ choices: [{ index: 0, delta: { tool_calls: [{ index: 0, function: { arguments: '{\"path\":\"a\"}' } }] } }] }) +\n      sse({ choices: [{ index: 0, delta: {}, finish_reason: \"tool_calls\" }] }) + \"data: [DONE]\\n\\n\",\n    );\n  });\n  await new Promise<void>((r) => upstream.listen(0, \"127.0.0.1\", () => r()));\n  const port = (upstream.address() as any).port;\n  const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1`, faults: kinds.map((kind, i) => ({ kind, atRequest: i + 1 })) });\n  const chat = () => fetch(`${proxy.url}/chat/completions`, { method: \"POST\", body: \"{}\" });\n  try {\n    await assert.rejects(chat(), \"refuse: the connection is dropped\");\n    const overloaded = await chat();\n    assert.equal(overloaded.status, 503);\n    assert.equal(overloaded.headers.get(\"retry-after\"), \"1\");\n    await overloaded.text();\n    const cut = await chat().then((r) => r.text()).catch(() => \"\");\n    assert.ok(!cut.includes(\"finish_reason\"), \"stream_cut: nothing after the first tool-call fragment arrives\");\n    const truncated = await (await chat()).text();\n    assert.match(truncated, /\"finish_reason\":\"length\"/);\n    assert.doesNotMatch(truncated, /\"finish_reason\":\"tool_calls\"/);\n    const overflow = await chat();\n    assert.equal(overflow.status, 400);\n    assert.equal((await overflow.json()).error.type, \"exceed_context_size_error\");\n    assert.match(await (await chat()).text(), /\\\\\"broken/, \"malformed_tool_json: the first arguments fragment is corrupted\");\n    assert.match(await (await chat()).text(), /\"finish_reason\":\"tool_calls\"/, \"requests without a scheduled fault pass unchanged\");\n    const stats = proxy.stats();\n    assert.deepEqual(stats.faultsInjected.map((f: any) => f.kind), kinds);\n    assert.equal(isInfrastructureFailure({ model: { ...stats, answered: 0, upstreamFailures: 3 } }), false, \"injected faults are never infrastructure reruns\");\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n  await assert.rejects(startModelProxy({ upstream: \"http://127.0.0.1:9/v1\", faults: [{ kind: \"nope\", atRequest: 1 }] }), /invalid fault/);\n});\n\ntest(\"executable probes refuse bind sources that overlap protected corpus material\", async () => {\n  const { isolatedProcessArgv } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-probe-overlap-\"));\n  try {\n    const store = path.join(root, \"heldout-v2\");\n#!/usr/bin/env node\n// Scores eval results (results.jsonl from eval/run.mjs). Scores are reported separately and never combined\n// (qualification assessment §9): completion claimed, artifact correct (hidden tests), false VERIFIED, regressions,\n// bounded failure, wall time, steps, tokens — per task and configuration, with 95 % Wilson intervals for rates.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\n// Several files may be given: a later record for the same configuration, task and run replaces an earlier one (a rerun\n// of a run that failed on infrastructure, see eval/infra.mjs). The replaced records stay in their files.\nconst files = process.argv.slice(2).filter((a) => !a.startsWith(\"--\"));\nconst pairMode = process.argv.includes(\"--pairs\");\nif (!files.length) {\n  console.error(\"usage: eval/score.mjs <results.jsonl>... [--pairs] [--json]\");\n  process.exit(2);\n}\nconst peerComparison = pairMode ? validateMatchedPeers(files) : null;\nconst byRun = new Map();\n/** Every replacement is listed (REQ-QUAL-106): which run, what it showed, and what the rerun showed. */\nconst replacements = [];\nconst outcomeOf = (r) => r.error ? `error: ${r.error}` : r.turn?.outcome ?? (r.timedOut ? \"timed out\" : `exit ${r.exitCode}`);\nfor (const file of files) {\n  for (const r of fs.readFileSync(file, \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l))) {\n    const key = `${r.config}\\t${r.task}\\t${r.run}`;\n    const prior = byRun.get(key);\n    if (prior) replacements.push({ config: r.config, task: r.task, run: r.run, was: outcomeOf(prior), now: outcomeOf(r) });\n    byRun.set(key, r);\n  }\n}\nconst replaced = replacements.length;\nconst records = [...byRun.values()];\n/** A run that ended without a result of its own: Nexus without a turn report, or any agent killed by a signal. */\nconst crashed = (r) => !r.error && !r.timedOut && (r.exitCode === null || ((r.agent ?? \"nexus\") === \"nexus\" && !r.turn));\n\n/** 95 % Wilson score interval for k successes out of n. */\nexport function wilson(k, n) {\n  if (!n) return [0, 0];\n  const z = 1.96;\n  const p = k / n;\n  const denom = 1 + (z * z) / n;\n  const centre = (p + (z * z) / (2 * n)) / denom;\n  const half = (z * Math.sqrt((p * (1 - p)) / n + (z * z) / (4 * n * n))) / denom;\n  return [Math.max(0, centre - half), Math.min(1, centre + half)];\n}\n\nconst median = (xs) => {\n  const s = xs.filter((x) => typeof x === \"number\").sort((a, b) => a - b);\n  return s.length ? (s.length % 2 ? s[(s.length - 1) / 2] : (s[s.length / 2 - 1] + s[s.length / 2]) / 2) : null;\n};\n\nconst groups = new Map();\nfor (const r of records) {\n  const key = `${r.config}\\t${r.task}`;\n  if (!groups.has(key)) groups.set(key, []);\n  groups.get(key).push(r);\n}\n\nconst rows = [...groups.entries()].map(([key, rs]) => {\n  const [config, task] = key.split(\"\\t\");\n  const n = rs.length;\n  const count = (f) => rs.filter(f).length;\n  const correct = count((r) => r.hiddenPass);\n  return {\n    config,\n    task,\n    tier: rs[0].tier,\n    n,\n    claimed: count((r) => r.claimedComplete),\n    correct,\n    correctCI: wilson(correct, n),\n    falseVerified: count((r) => r.falseVerified),\n    regressions: count((r) => r.regressionPass === false),\n    errors: count((r) => r.error),\n    contaminated: count((r) => r.contaminated),\n    timedOut: count((r) => r.timedOut),\n    medianWallS: median(rs.map((r) => r.wallMs / 1000)),\n    medianSteps: median(rs.map((r) => r.turn?.steps?.used)),\n    medianTokens: median(rs.map((r) => r.tokens?.total)),\n  };\n});\n\nconst totals = {\n  runs: records.length,\n  falseVerified: records.filter((r) => r.falseVerified).length,\n  errors: records.filter((r) => r.error).length,\n  crashed: records.filter(crashed).length,\n  contaminated: records.filter((r) => r.contaminated).length,\n  replacedByRerun: replaced,\n};\n\n// Pooled rates leave contaminated runs out (the agent could have seen the hidden tests); they are counted separately.\nconst pooled = [...new Set(records.map((r) => r.config))].map((config) => {\n  const all = records.filter((r) => r.config === config);\n  const rs = all.filter((r) => !r.contaminated);\n  const k = rs.filter((r) => r.hiddenPass).length;\n  const sum = (xs) => xs.reduce((a, b) => a + (b ?? 0), 0);\n  return {\n    config,\n    n: rs.length,\n    excludedContaminated: all.length - rs.length,\n    correct: k,\n    rate: rs.length ? k / rs.length : 0,\n    ci: wilson(k, rs.length),\n    falseVerified: all.filter((r) => r.falseVerified).length,\n    crashRate: all.length ? all.filter(crashed).length / all.length : 0,\n    regressions: rs.filter((r) => r.regressionPass === false).length,\n    // Cost of the whole configuration's runs per correct result (failed runs cost too).\n    tokensPerCorrect: k ? sum(rs.map((r) => r.tokens?.total)) / k : null,\n    wallSecondsPerCorrect: k ? sum(rs.map((r) => r.wallMs)) / 1000 / k : null,\n  };\n});\n\n// T4: per injected fault kind. Truthful = the run ended with a result of its own (no crash, no hang past the budget)\n// and never claimed VERIFIED while the hidden tests failed; recovered = the task was still done correctly.\nconst faultRows = [...new Set(records.flatMap((r) => (r.model?.faultsInjected ?? []).map((f) => f.kind)))].sort().map((kind) => {\n  const rs = records.filter((r) => (r.model?.faultsInjected ?? []).some((f) => f.kind === kind));\n  const truthful = rs.filter((r) => !r.falseVerified && !crashed(r) && !r.timedOut).length;\n  const recovered = rs.filter((r) => r.hiddenPass).length;\n  return { kind, n: rs.length, truthful, truthfulRate: truthful / rs.length, recovered, hungPastBudget: rs.filter((r) => r.timedOut).length };\n});\n\n// T3 (REQ-QUAL-109): every T3 run counts. A run with no T3 result, too few steps or fewer than two compactions is\n// ineligible and fails the workload rather than leaving it; DEC-05 thresholds are false-absence 0, steering >= 95%.\nconst T3_TASKS = 8;\nconst T3_RUNS_PER_TASK = 5;\nconst t3Runs = records.filter((r) => r.tier === \"T3\");\nconst t3 = t3Runs.length ? (() => {\n  const honoured = t3Runs.flatMap((r) => r.t3?.steering ?? []).filter((s) => s.honoured).length;\n  // The denominator is what each task declared, so a run without a T3 result still counts its steering as unmet.\n  const expectedItems = t3Runs.reduce((n, r) => n + (r.t3SteeringItems ?? r.t3?.steering?.length ?? 0), 0);\n  const perTask = new Map();\n// Checks that make an evaluation run valid before it starts (SPEC-10, REQ-QUAL-101/102/106): every task is well formed,\n// a qualification run records which model actually answered (a fingerprint, not an alias), and hidden tests are out of\n// the agent's reach when the agent runs as its own user.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { createHash } from \"node:crypto\";\nimport { assertNoSymlinks, candidateSandboxHostMountSources, confinedPath, runtimeMountProblem, sandboxAvailable } from \"./isolate.mjs\";\nimport { blackBoxOracleProblem } from \"./oracle.mjs\";\nimport { t3TaskProblems } from \"./t3.mjs\";\nimport { resourceProbeProblem } from \"./resources.mjs\";\n\nexport const TIERS = [\"T1\", \"T2\", \"T3\", \"T4\"];\nexport const CLASSES = [\"bugfix\", \"feature\", \"refactor\", \"debug\"];\nexport const DIFFICULTIES = [\"easy\", \"medium\", \"hard\"];\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n\n/** Problems with one task.json (empty when valid). `qualification` adds the fields held-out tasks must carry. */\nexport function validateTask(task, dir, { qualification = false } = {}) {\n  const problems = [];\n  const need = (cond, msg) => { if (!cond) problems.push(msg); };\n  need(typeof task.id === \"string\" && task.id === path.basename(dir), `id must equal its directory name (${path.basename(dir)})`);\n  need(TIERS.includes(task.tier), `tier must be one of ${TIERS.join(\", \")}`);\n  need(typeof task.objective === \"string\" && task.objective.trim().length > 0, \"objective is required\");\n  problems.push(...t3TaskProblems(task));\n  need(Boolean(task.fixture) !== Boolean(task.repo), \"exactly one of fixture or repo is required\");\n  if (task.fixture) {\n    try { confinedPath(dir, task.fixture); }\n    catch (error) { need(false, error.message); }\n  }\n  if (task.repo) {\n    need(typeof task.repo.url === \"string\" && task.repo.url.length > 0, \"repo.url is required\");\n    try {\n      const repoUrl = new URL(task.repo.url);\n      need(repoUrl.protocol === \"https:\" && !repoUrl.username && !repoUrl.password, \"repo.url must use HTTPS without embedded credentials\");\n    } catch { need(false, \"repo.url must be a valid HTTPS URL without embedded credentials\"); }\n    need(/^[0-9a-f]{40}$/.test(task.repo.commit ?? \"\"), \"repo.commit must be a full 40-character commit id (pinned)\");\n  }\n  const hiddenCommand = typeof task.hidden?.command === \"string\" && task.hidden.command.length > 0;\n  const hiddenOracle = task.hidden?.protocol === \"blackbox-v1\";\n  need(hiddenCommand || hiddenOracle, \"hidden.command or hidden blackbox-v1 oracle is required\");\n  if (hiddenOracle) {\n    const oracleProblem = blackBoxOracleProblem(task.hidden, dir, task.fixture ?? null);\n    need(!oracleProblem, oracleProblem ?? \"hidden black-box oracle is invalid\");\n  }\n  // Legacy validators execute candidate modules in the same runtime. File hiding and a fresh workspace cannot prevent\n  // candidate code from inspecting or mutating that runtime, so they are never valid independent qualification.\n  if (qualification) need(hiddenOracle && !hiddenCommand, \"qualification requires the isolated blackbox-v1 hidden oracle; in-process legacy validators are not accepted\");\n  if (task.hidden?.dir) {\n    try { confinedPath(dir, task.hidden.dir); }\n    catch (error) { need(false, error.message); }\n  }\n  if (task.regression?.dir) {\n    try { confinedPath(dir, task.regression.dir); }\n    catch (error) { need(false, error.message); }\n  }\n  for (const key of [\"steps\", \"minutes\"]) {\n    if (task[key] !== undefined) need(Number.isInteger(task[key]) && task[key] > 0, `${key} must be a positive integer`);\n  }\n  if (task.faults !== undefined) {\n    const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n    need(Array.isArray(task.faults) && task.faults.every((f) => kinds.includes(f?.kind) && Number.isInteger(f?.atRequest) && f.atRequest >= 1), `faults must be [{ kind: ${kinds.join(\"|\")}, atRequest: n >= 1 }]`);\n  }\n  if (task.class !== undefined || qualification) need(CLASSES.includes(task.class), `class must be one of ${CLASSES.join(\", \")}`);\n  if (task.difficulty !== undefined || qualification) need(DIFFICULTIES.includes(task.difficulty), `difficulty must be one of ${DIFFICULTIES.join(\", \")}`);\n  return problems;\n}\n\n/**\n * What a run's model is, beyond its alias: from the endpoint's /models entry (id, owner, advertised context) and the\n * operator's config (`fingerprint`: weights sha256, server build; `sampling`: temperature, seed). A qualification config\n * that cannot state weights, server build and sampling is refused (REQ-QUAL-102).\n */\nexport function modelFingerprint(config, entry) {\n  const fp = config.fingerprint ?? {};\n  const sampling = config.sampling ?? null;\n  const fingerprint = {\n    alias: config.model,\n    listed: Boolean(entry),\n    ownedBy: entry?.owned_by ?? null,\n    contextLength: entry?.context_length ?? entry?.max_model_len ?? entry?.meta?.n_ctx_train ?? null,\n    weightsSha256: fp.weightsSha256 ?? null,\n    serverBuild: fp.serverBuild ?? null,\n    sampling,\n  };\n  const missing = [];\n  if (config.qualification) {\n    if (!fingerprint.listed) missing.push(`the endpoint does not list model ${config.model}`);\n    if (!/^[0-9a-f]{64}$/.test(fingerprint.weightsSha256 ?? \"\")) missing.push(\"fingerprint.weightsSha256 (sha256 of the served weights file)\");\n    if (!fingerprint.serverBuild) missing.push(\"fingerprint.serverBuild (inference server name and build)\");\n53:| `id`, `tier` | T1 smoke (scripted model, CI), T2 standard, T3 long-task, T4 fault-injected |\n57:| `steps`, `minutes` | budgets (defaults from the configuration: 300 steps, 120 min) |\n83:## Fault injection (T4)\n85:A task or config may list `faults: [{ kind, atRequest }]`. The run's model proxy then injects that fault into the Nth\n97:What was injected is recorded in `model.faultsInjected`. Such runs are never treated as infrastructure reruns.\n106:The remaining T4 classes come from task fixtures (a hanging test command, a full disk) and from the SIGTERM-then-resume\n107:runner case. `make test` includes a T4 smoke test with two injected faults (`cli/test/eval_harness.test.ts`).\n296:- T4: truthful bounded outcome in 100 % of fault runs;\n309:| T4 fault injector | in progress |\n310:| Qualification runs | blocked on independent corpus custody, enforced aggregate sandbox resource limits, completed T3/T4 workloads, exact-RC/provider evidence, and the required operational approvals; the earlier pilot's inference-hour, cloud-budget, and peer-install decisions also remain separate prerequisites |\n321:only (no T3/T4 — the window is too short); Codex CLI excluded (the gateway does not serve `/v1/responses`); Aider runs\n","exit_code":0,"duration":{"secs":0,"nanos":794792905}},"started_at_ms":1792913957568,"completed_at_ms":1792913958363}}
{"timestamp":"2026-10-25T07:39:19.302Z","ordinal":329453,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a171ff-e986-7bc2-a14f-1d63fcd4a9cb","call_id":"call_afcf2bfde72d4d818b257c8d76c42dbb","output":[{"type":"input_text","text":"Script completed\nWall time 2.8 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 5794)\nTotal output lines: 427\n\n/**\n * Scoring integrity of the evaluation harness (REQ-QUAL-106, EVL-002/003/005): infrastructure failures are decided by\n * what the harness's model proxy observed, the same way for every agent; contaminated runs leave the pass rate;\n * reruns are listed; crashes are counted as crashes rather than rerun.\n */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport http from \"node:http\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\nconst proxyModule = path.join(ROOT, \"eval/model_proxy.mjs\");\n\ntest(\"the model proxy forwards requests and counts answers and upstream failures\", async () => {\n  const { startModelProxy, isInfrastructureFailure } = await import(proxyModule);\n  const upstream = http.createServer((req, res) => {\n    if (req.url?.endsWith(\"/chat/completions\")) {\n      res.writeHead(503);\n      return void res.end(\"busy\");\n    }\n    res.setHeader(\"content-type\", \"application/json\");\n    res.end(JSON.stringify({ path: req.url }));\n  });\n  await new Promise<void>((r) => upstream.listen(0, \"127.0.0.1\", () => r()));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1` });\n  try {\n    assert.match(proxy.url, /^http:\\/\\/127\\.0\\.0\\.1:\\d+\\/v1$/);\n    const ok = await (await fetch(`${proxy.url}/models`)).json();\n    assert.equal(ok.path, \"/v1/models\");\n    assert.equal((await fetch(`${proxy.url}/chat/completions`, { method: \"POST\", body: \"{}\" })).status, 503);\n    assert.equal((await fetch(`${proxy.url}/admin/secrets`)).status, 404, \"control-plane paths are not forwarded\");\n    assert.equal((await fetch(`${proxy.url}/chat/completions`, { method: \"GET\" })).status, 404, \"unsupported methods are not forwarded\");\n    const stats = proxy.stats();\n    assert.equal(stats.requests, 4);\n    assert.equal(stats.answered, 1);\n    assert.equal(stats.upstreamFailures, 1);\n    assert.equal(isInfrastructureFailure({ model: stats }), false, \"the model answered: the run is scored\");\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n\n  const dead = await startModelProxy({ upstream: \"http://127.0.0.1:9/v1\" });\n  try {\n    assert.equal((await fetch(`${dead.url}/chat/completions`, { method: \"POST\", body: \"{}\" })).status, 502);\n    assert.equal(isInfrastructureFailure({ model: dead.stats() }), true, \"the model never answered and the endpoint failed\");\n  } finally {\n    await dead.close();\n  }\n});\n\ntest(\"the evaluation proxy authenticates the local run token and replaces it with the upstream credential\", async () => {\n  const { startModelProxy } = await import(proxyModule);\n  const seen: string[] = [];\n  const upstream = http.createServer((req, res) => {\n    seen.push(String(req.headers.authorization ?? \"\"));\n    res.end(JSON.stringify({ ok: true }));\n  });\n  await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1`, authToken: \"UPSTREAM_SECRET_CANARY\", clientToken: \"RUN_SCOPED_TOKEN\" });\n  try {\n    assert.equal((await fetch(`${proxy.url}/models`)).status, 401);\n    const accepted = await fetch(`${proxy.url}/models`, { headers: { authorization: \"Bearer RUN_SCOPED_TOKEN\" } });\n    assert.equal(accepted.status, 200);\n    assert.deepEqual(seen, [\"Bearer UPSTREAM_SECRET_CANARY\"]);\n    assert.equal((await fetch(`${proxy.url}/admin`, { headers: { authorization: \"Bearer RUN_SCOPED_TOKEN\" } })).status, 404);\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n});\n\ntest(\"the evaluation proxy bounds request count and body size\", async () => {\n  const { startModelProxy } = await import(proxyModule);\n  let upstreamRequests = 0;\n  const upstream = http.createServer((req, res) => { upstreamRequests++; req.resume(); res.end(\"ok\"); });\n  await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1`, maxRequests: 1, maxRequestBytes: 8 });\n  try {\n    const oversized = await fetch(`${proxy.url}/chat/completions`, { method: \"POST\", body: \"123456789\" }).catch(() => null);\n    assert.ok(oversized === null || oversized.status === 413);\n    assert.equal(upstreamRequests, 0, \"oversized bodies never reach the provider\");\n    assert.equal((await fetch(`${proxy.url}/models`)).status, 429);\n  } finally {\n    await proxy.close();\n    upstream.close();\n  }\n});\n\ntest(\"the evaluation proxy bounds concurrent inference and cancels upstream work on client abort\", { timeout: 10_000 }, async () => {\n  const { startModelProxy, isInfrastructureFailure } = await import(proxyModule);\n  let upstreamRequests = 0;\n  let resolveFirstStarted!: () => void;\n  let resolveFirstClosed!: () => void;\n  const firstStarted = new Promise<void>((resolve) => { resolveFirstStarted = resolve; });\n  const firstClosed = new Promise<void>((resolve) => { resolveFirstClosed = resolve; });\n  const upstream = http.createServer((req, res) => {\n    upstreamRequests++;\n    req.resume();\n    if (upstreamRequests === 1) {\n      resolveFirstStarted();\n      res.once(\"close\", resolveFirstClosed);\n      return;\n    }\n    res.end(\"second request accepted after cancellation\");\n  });\n  await new Promise<void>((resolve) => upstream.listen(0, \"127.0.0.1\", resolve));\n  const port = (upstream.address() as any).port;\n  const proxy = await startModelProxy({ upstream: `http://127.0.0.1:${port}/v1` });\n  const body = JSON.stringify({ max_tokens: 1 });\n  const send = (signal?: AbortSignal) => fetch(`${proxy.url}/chat/completions`, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/json\" },\n    body,\n    signal,\n  });\n  try {\n    const controller = new AbortController();\n    const first = send(controller.signal);\n    await firstStarted;\n    assert.equal(proxy.stats().activeInferenceRequests, 1);\n\n    const concurrent = await send();\n    assert.equal(concurrent.status, 429);\n    assert.equal((await concurrent.json()).error.type, \"concurrency_limit\");\n    assert.equal(upstreamRequests, 1, \"a rejected concurrent request never reaches the provider\");\n\n    controller.abort();\n    await assert.rejects(first, { name: \"AbortError\" });\n    await Promise.race([\n      firstClosed,\n      new Promise<never>((_, reject) => setTimeout(() => reject(new Error(\"upstream remained open after client abort\")), 1_000)),\n    ]);\n  assert.equal(out.status, 2, out.stdout + out.stderr);\n  assert.match(out.stderr, /not starting/);\n  assert.match(out.stderr, /broken: tier must be one of/);\n  assert.ok(!fs.existsSync(path.join(tasks, \"out\", \"results.jsonl\")), \"no run was recorded\");\n});\n\n// ---------------------------------------------------------------- T4 faul…2294 tokens truncated…/ The denominator is what each task declared, so a run without a T3 result still counts its steering as unmet.\n  const expectedItems = t3Runs.reduce((n, r) => n + (r.t3SteeringItems ?? r.t3?.steering?.length ?? 0), 0);\n  const perTask = new Map();\n// Checks that make an evaluation run valid before it starts (SPEC-10, REQ-QUAL-101/102/106): every task is well formed,\n// a qualification run records which model actually answered (a fingerprint, not an alias), and hidden tests are out of\n// the agent's reach when the agent runs as its own user.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { createHash } from \"node:crypto\";\nimport { assertNoSymlinks, candidateSandboxHostMountSources, confinedPath, runtimeMountProblem, sandboxAvailable } from \"./isolate.mjs\";\nimport { blackBoxOracleProblem } from \"./oracle.mjs\";\nimport { t3TaskProblems } from \"./t3.mjs\";\nimport { resourceProbeProblem } from \"./resources.mjs\";\n\nexport const TIERS = [\"T1\", \"T2\", \"T3\", \"T4\"];\nexport const CLASSES = [\"bugfix\", \"feature\", \"refactor\", \"debug\"];\nexport const DIFFICULTIES = [\"easy\", \"medium\", \"hard\"];\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n\n/** Problems with one task.json (empty when valid). `qualification` adds the fields held-out tasks must carry. */\nexport function validateTask(task, dir, { qualification = false } = {}) {\n  const problems = [];\n  const need = (cond, msg) => { if (!cond) problems.push(msg); };\n  need(typeof task.id === \"string\" && task.id === path.basename(dir), `id must equal its directory name (${path.basename(dir)})`);\n  need(TIERS.includes(task.tier), `tier must be one of ${TIERS.join(\", \")}`);\n  need(typeof task.objective === \"string\" && task.objective.trim().length > 0, \"objective is required\");\n  problems.push(...t3TaskProblems(task));\n  need(Boolean(task.fixture) !== Boolean(task.repo), \"exactly one of fixture or repo is required\");\n  if (task.fixture) {\n    try { confinedPath(dir, task.fixture); }\n    catch (error) { need(false, error.message); }\n  }\n  if (task.repo) {\n    need(typeof task.repo.url === \"string\" && task.repo.url.length > 0, \"repo.url is required\");\n    try {\n      const repoUrl = new URL(task.repo.url);\n      need(repoUrl.protocol === \"https:\" && !repoUrl.username && !repoUrl.password, \"repo.url must use HTTPS without embedded credentials\");\n    } catch { need(false, \"repo.url must be a valid HTTPS URL without embedded credentials\"); }\n    need(/^[0-9a-f]{40}$/.test(task.repo.commit ?? \"\"), \"repo.commit must be a full 40-character commit id (pinned)\");\n  }\n  const hiddenCommand = typeof task.hidden?.command === \"string\" && task.hidden.command.length > 0;\n  const hiddenOracle = task.hidden?.protocol === \"blackbox-v1\";\n  need(hiddenCommand || hiddenOracle, \"hidden.command or hidden blackbox-v1 oracle is required\");\n  if (hiddenOracle) {\n    const oracleProblem = blackBoxOracleProblem(task.hidden, dir, task.fixture ?? null);\n    need(!oracleProblem, oracleProblem ?? \"hidden black-box oracle is invalid\");\n  }\n  // Legacy validators execute candidate modules in the same runtime. File hiding and a fresh workspace cannot prevent\n  // candidate code from inspecting or mutating that runtime, so they are never valid independent qualification.\n  if (qualification) need(hiddenOracle && !hiddenCommand, \"qualification requires the isolated blackbox-v1 hidden oracle; in-process legacy validators are not accepted\");\n  if (task.hidden?.dir) {\n    try { confinedPath(dir, task.hidden.dir); }\n    catch (error) { need(false, error.message); }\n  }\n  if (task.regression?.dir) {\n    try { confinedPath(dir, task.regression.dir); }\n    catch (error) { need(false, error.message); }\n  }\n  for (const key of [\"steps\", \"minutes\"]) {\n    if (task[key] !== undefined) need(Number.isInteger(task[key]) && task[key] > 0, `${key} must be a positive integer`);\n  }\n  if (task.faults !== undefined) {\n    const kinds = [\"refuse\", \"overloaded\", \"stream_cut\", \"truncate\", \"context_overflow\", \"malformed_tool_json\"];\n    need(Array.isArray(task.faults) && task.faults.every((f) => kinds.includes(f?.kind) && Number.isInteger(f?.atRequest) && f.atRequest >= 1), `faults must be [{ kind: ${kinds.join(\"|\")}, atRequest: n >= 1 }]`);\n  }\n  if (task.class !== undefined || qualification) need(CLASSES.includes(task.class), `class must be one of ${CLASSES.join(\", \")}`);\n  if (task.difficulty !== undefined || qualification) need(DIFFICULTIES.includes(task.difficulty), `difficulty must be one of ${DIFFICULTIES.join(\", \")}`);\n  return problems;\n}\n\n/**\n * What a run's model is, beyond its alias: from the endpoint's /models entry (id, owner, advertised context) and the\n * operator's config (`fingerprint`: weights sha256, server build; `sampling`: temperature, seed). A qualification config\n * that cannot state weights, server build and sampling is refused (REQ-QUAL-102).\n */\nexport function modelFingerprint(config, entry) {\n  const fp = config.fingerprint ?? {};\n  const sampling = config.sampling ?? null;\n  const fingerprint = {\n    alias: config.model,\n    listed: Boolean(entry),\n    ownedBy: entry?.owned_by ?? null,\n    contextLength: entry?.context_length ?? entry?.max_model_len ?? entry?.meta?.n_ctx_train ?? null,\n    weightsSha256: fp.weightsSha256 ?? null,\n    serverBuild: fp.serverBuild ?? null,\n    sampling,\n  };\n  const missing = [];\n  if (config.qualification) {\n    if (!fingerprint.listed) missing.push(`the endpoint does not list model ${config.model}`);\n    if (!/^[0-9a-f]{64}$/.test(fingerprint.weightsSha256 ?? \"\")) missing.push(\"fingerprint.weightsSha256 (sha256 of the served weights file)\");\n    if (!fingerprint.serverBuild) missing.push(\"fingerprint.serverBuild (inference server name and build)\");\n53:| `id`, `tier` | T1 smoke (scripted model, CI), T2 standard, T3 long-task, T4 fault-injected |\n57:| `steps`, `minutes` | budgets (defaults from the configuration: 300 steps, 120 min) |\n83:## Fault injection (T4)\n85:A task or config may list `faults: [{ kind, atRequest }]`. The run's model proxy then injects that fault into the Nth\n97:What was injected is recorded in `model.faultsInjected`. Such runs are never treated as infrastructure reruns.\n106:The remaining T4 classes come from task fixtures (a hanging test command, a full disk) and from the SIGTERM-then-resume\n107:runner case. `make test` includes a T4 smoke test with two injected faults (`cli/test/eval_harness.test.ts`).\n296:- T4: truthful bounded outcome in 100 % of fault runs;\n309:| T4 fault injector | in progress |\n310:| Qualification runs | blocked on independent corpus custody, enforced aggregate sandbox resource limits, completed T3/T4 workloads, exact-RC/provider evidence, and the required operational approvals; the earlier pilot's inference-hour, cloud-budget, and peer-install decisions also remain separate prerequisites |\n321:only (no T3/T4 — the window is too short); Codex CLI excluded (the gateway does not serve `/v1/responses`); Aider runs\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a171fd-3278-7ca3-ad25-d2f716cb2b15","create_time":1792913959.3026924}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
