nt failed: ${err.message}` };\n          } finally {\n            if (workspaceFd !== undefined) fs.closeSync(workspaceFd);\n          }\n        }\n\n        const sandboxed = wrapSandboxedCommand(args.command || \"\", this.workspace, {\n          mode,\n          shell: args.shell,\n          readOnlyHost: this.readOnly,\n          network: this.readOnly ? false : undefined,\n        });\n        const explicitlyRequestedSandbox = Boolean(this.sandbox) && configuredMode !== \"none\";\n        if ((this.readOnly || this.requireSandbox || explicitlyRequestedSandbox) && !sandboxed.sandboxed) {\n          const authority = this.readOnly\n            ? \"Read-only mode\"\n            : this.requireSandbox\n              ? \"Worktree isolation\"\n              : \"Configured sandbox\";\n          return {\n            success: false,\n            output: \"\",\n            error: `${authority} violation: filesystem-isolated shell execution is unavailable. ${sandboxed.warning || \"No supported sandbox engine is available.\"}`,\n          };\n        }\n        args.command = sandboxed.command;\n        if (sandboxed.argv) {\n          args.argv = sandboxed.argv;\n        }\n      }\n    }\n\n    const applyNotice = (res: ExecutionResult): ExecutionResult => {\n      if (clampedNotice && !res.output?.includes(\"[Notice: timeout_secs clamped\")) {\n        return {\n          ...res,\n          output: clampedNotice + (res.output || \"\"),\n        };\n      }\n      return res;\n    };\n\n    // Attempt persistent JSON-RPC execution\n    try {\n      const rpcResult = await this.executeViaRpc(toolName, args);\n      if (rpcResult !== null) {\n        return applyNotice(rpcResult);\n      }\n    } catch {\n        if (reqHeaders.authorization) delete reqHeaders.authorization;\n        if (reqHeaders.cookie) delete reqHeaders.cookie;\n      }\n      currentUrl = nextUrl;\n      continue;\n    }\n\n    let bytesRead = 0;\n    let truncated = false;\n    const chunks: Buffer[] = [];\n    for await (const chunk of res) {\n      const buf = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);\n      if (bytesRead + buf.length > maxBytes) {\n        const remaining = maxBytes - bytesRead;\n        if (remaining > 0) {\n          chunks.push(buf.subarray(0, remaining));\n          bytesRead += remaining;\n        }\n        truncated = true;\n        res.destroy();\n        break;\n      }\n      chunks.push(buf);\n      bytesRead += buf.length;\n    }\n\n    const bodyText = Buffer.concat(chunks, bytesRead).toString(\"utf-8\");\n    return {\n      ok: status >= 200 && status < 300,\n      status,\n      statusText: res.statusMessage || \"\",\n      headers: res.headers,\n      text: bodyText,\n      finalUrl: currentUrl,\n      truncated,\n    };\n  }\n}\n\n/** Default `run_command` deadline in the Rust runner (seconds); mirrored here so the bridge can outlast it. */\nexport const RUN_COMMAND_DEFAULT_TIMEOUT_SECS = 60;\n/** Extra time the bridge waits beyond the runner's own deadline (kill grace + reply), so the runner's structured result wins. */\nexport const RPC_GRACE_SECS = 5;\nconst RPC_DEFAULT_TIMEOUT_MS = 35_000;\n\n/** Maximum allowed tool timeout in seconds per REQ-SEC-107 (default 1800). */\nexport function maxToolTimeoutSecs(): number {\n  const env = process.env.NEXUS_MAX_TOOL_TIMEOUT_SECS;\n  if (!env) return 1800;\n  const parsed = parseInt(env, 10);\n  return Number.isFinite(parsed) && parsed > 0 ? parsed : 1800;\n}\n\n/**\n * Deadline ownership for one RPC. For `run_command` the runner owns the command deadline (`runnerSecs`) and the bridge's\n * outer timer is strictly longer; for other tools only the bridge timer applies.\n */\nexport function rpcDeadlines(toolName: string, args: Record<string, any>): { runnerSecs?: number; bridgeMs: number } {\n  if (toolName === \"run_command\") {\n    const rawSecs = typeof args.timeout_secs === \"number\" && args.timeout_secs > 0 ? args.timeout_secs : RUN_COMMAND_DEFAULT_TIMEOUT_SECS;\n    const maxSecs = maxToolTimeoutSecs();\n    const runnerSecs = Math.min(rawSecs, maxSecs);\n    return { runnerSecs, bridgeMs: (runnerSecs + RPC_GRACE_SECS) * 1000 };\n  }\n  return { bridgeMs: args.timeout_secs ? (args.timeout_secs + RPC_GRACE_SECS) * 1000 : RPC_DEFAULT_TIMEOUT_MS };\n}\n   * Tool output for the model. When the call repeats one whose findings were recorded, says so first (and whether the\n   * output is unchanged) with the step position, so a re-run is a choice made knowing what the memory already holds.\n   * In the last fifth of the step budget (at least 3 steps), or while recorded findings exceed their bound, the first\n   * output of each step that another step follows says so before anything else. The last fifth leaves room for a\n   * submission, the corrections validation asks for, and a resubmission.\n   * Output cut short by a limit says so as part of the output (core/findings.ts: it cannot show that something is absent).\n   * Notes lead the output so that fitting an oversized result to the context, which keeps its beginning, keeps them.\n   */\n  private toolResultContent(call: ToolCall, content: string, step: number, maxSteps: number): string {\n    const noted = this.stepNotedContent(call, content, step, maxSteps);\n    if (this.cutResponse?.step !== step) return noted;\n    const { seconds } = this.cutResponse;\n    this.cutResponse = undefined;\n    return `${cutResponseNotice(step, seconds)}\\n${noted}`;\n  }\n\n  /**\n   * Submits one inference request of `step` under provider recovery. A submission that fails with its execution unknown\n   * after running at least LONG_RESPONSE_MS was most likely ended by the provider's limit on how long one response may\n   * take: the same request would run as long and fail the same way. Every later submission of the step says what\n   * happened and asks for less at once, and once one completes, so does the step's first tool result.\n   */\n  private async submitGuardingLength<T>(guard: { step: number; cutAfterMs: number }, messages: ChatMessage[], send: (messages: ChatMessage[]) => Promise<T>): Promise<T> {\n    const seconds = Math.round(guard.cutAfterMs / 1000);\n    const request = guard.cutAfterMs ? [...messages, { role: \"user\" as const, content: cutResponseNotice(guard.step, seconds) }] : messages;\n    const started = this.recoveryClock.now();\n    try {\n      const result = await send(request);\n      if (guard.cutAfterMs) this.cutResponse = { step: guard.step, seconds };\n      return result;\n    } catch (err) {\n509:/** Default `run_command` deadline in the Rust runner (seconds); mirrored here so the bridge can outlast it. */\n510:export const RUN_COMMAND_DEFAULT_TIMEOUT_SECS = 60;\n524: * Deadline ownership for one RPC. For `run_command` the runner owns the command deadline (`runnerSecs`) and the bridge's\n528:  if (toolName === \"run_command\") {\n529:    const rawSecs = typeof args.timeout_secs === \"number\" && args.timeout_secs > 0 ? args.timeout_secs : RUN_COMMAND_DEFAULT_TIMEOUT_SECS;\n1028:        outerResolve(signal?.aborted && toolName === \"run_command\" ? { ...result, cancelled: true } : result);\n1131:    if (toolName === \"run_command\") {\n1198:      if (toolName === \"run_command\") {\n1269:      if (toolName === \"run_command\") {\n1322:        (testCommand) => this.executeTool(\"run_command\", { command: testCommand, timeout_secs: timeoutSecs }),\n1478:    // For run_command, path protection is advisory because shell commands (e.g. cat, grep)\n1481:    if (toolName === \"run_command\") {\n1538:            const timeoutSecs = rpcDeadlines(\"run_command\", args).runnerSecs ?? RUN_COMMAND_DEFAULT_TIMEOUT_SECS;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17224-c0fe-79f1-a031-0db884e4ebbb","create_time":1792916598.381001}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
