{result.timedOut ? \"timeout\" : result.overflow ? \"output limit\" : `exit ${result.status}`}`);\n  }\n}\n\n/**\n * The command line and environment for one agent run. Each agent gets a fresh HOME holding only its gateway settings\n * (no operator plugins, extensions or memory), the same endpoint and model, and the key through its environment.\n */\nfunction effectiveBudget(task, config) {\n  return { steps: task.steps ?? config.steps ?? 300, minutes: task.minutes ?? config.minutes ?? 120 };\n}\n\nasync function resolveAgentIdentity(config) {\n  const agent = config.agent ?? \"nexus\";\n  let command;\n  let argsPrefix = [];\n  if (agent === \"nexus\") {\n    if (config.qualification === true) {\n      if (typeof config.nexusExecutable !== \"string\" || !path.isAbsolute(config.nexusExecutable)) {\n        return { record: null, problem: \"qualification requires nexusExecutable to be the absolute path of the installed RC\" };\n      }\n      if (typeof config.expectedAgentVersion !== \"string\" || !config.expectedAgentVersion.trim()) {\n        return { record: null, problem: \"qualification requires expectedAgentVersion to pin the installed RC\" };\n      }\n      if (!/^[0-9a-f]{64}$/.test(config.nexusPackageSha256 ?? \"\")) {\n        return { record: null, problem: \"qualification requires nexusPackageSha256 from the installed RC release asset\" };\n      }\n      command = path.resolve(config.nexusExecutable);\n      try {\n        if (fs.realpathSync(command) === fs.realpathSync(path.join(ROOT, \"cli/dist/index.js\"))) {\n          return { record: null, problem: \"qualification must use the installed RC, not the checkout cli/dist/index.js\" };\n        }\n      } catch {}\n    } else {\n      command = process.execPath;\n      argsPrefix = [path.join(ROOT, \"cli/dist/index.js\")];\n    }\n  } else if ([\"goose\", \"opencode\", \"aider\"].includes(agent)) {\n    command = resolvePathExecutable(agent, { ...process.env, ...(config.env ?? {}) }) ?? agent;\n  } else {\n    return { record: null, problem: `eval agent '${agent}' has no versioned adapter` };\n  }\n\n  const required = config.qualification === true || config.expectedAgentVersion !== undefined;\n  let candidatePath;\n  try { candidatePath = fs.realpathSync(command); }\n  catch (error) { return { record: null, problem: required ? `could not identify ${agent} executable (${error.message})` : null, command, argsPrefix }; }\n  argsPrefix = argsPrefix.map((item) => path.isAbsolute(item) ? fs.realpathSync(item) : item);\n  // Version probes execute candidate-controlled code and must share the enforced writable-storage cap.\n  const probeWorkspace = fs.mkdtempSync(path.join(config.resources?.workspaceRoot ?? os.tmpdir(), \"nexus-eval-version-workspace-\"));\n  let probe;\n  try {\n    if (config.runAs) grantRunAsAccess(config.runAs, [probeWorkspace]);\n    const runtimePaths = [candidatePath, ...argsPrefix.filter((item) => path.isAbsolute(item)).map((item) => fs.realpathSync(item))];\n    const isCheckoutNexus = agent === \"nexus\" && argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\");\n    if (isCheckoutNexus) {\n      runtimePaths.push(path.join(ROOT, \"cli/dist\"));\n      const modules = path.join(ROOT, \"cli/node_modules\");\n      if (fs.existsSync(modules)) {\n        for (const entry of fs.readdirSync(modules, { withFileTypes: true })) {\n          if (entry.isDirectory() && entry.name !== \".bin\") runtimePaths.push(path.join(modules, entry.name));\n        }\n      }\n      const coreBinary = path.join(ROOT, \"core/target/release/harness-core\");\n      if (fs.existsSync(coreBinary)) runtimePaths.push(coreBinary);\n    }\n    const allowedRoots = [...new Set([...(config.sandboxRuntimeRoots ?? []), ...(isCheckoutNexus ? [ROOT] : [])])];\n    const spec = isolatedProcessArgv({\n      cwd: probeWorkspace,\n      command: candidatePath,\n      argv: [...argsPrefix, \"--version\"],\n      readOnlyPaths: [...new Set(runtimePaths)],\n      allowedRoots,\n      allowedFiles: [candidatePath, ...argsPrefix.filter((item) => path.isAbsolute(item))],\n      timeoutMs: 5000,\n      protectedCorpusPaths: protectedCorpusPathsForRun(),\n    });\n    const wrapped = config.runAs ? asUserSpec(config.runAs, spec) : spec;\n    probe = await runIsolatedProcess(wrapped, { outputLimit: 4096, resources: config.resources ?? null });\n  } finally {\n    fs.rmSync(probeWorkspace, { recursive: true, force: true });\n  }\n  const output = `${probe?.stdout ?? \"\"}${probe?.stderr ?? \"\"}`.trim();\n  const version = output.split(/\\r?\\n/, 1)[0]?.trim().slice(0, 200) || null;\n  if (probe?.containmentProblem || probe?.error || probe?.status !== 0 || probe?.timedOut || probe?.overflow || !version) {\n    const detail = output ? `; output=${JSON.stringify(output.slice(0, 600))}` : \"\";\n    const reason = probe?.containmentProblem ?? probe?.error ?? (probe?.timedOut ? \"timeout\" : probe?.overflow ? \"output limit exceeded\" : `exit ${probe?.status ?? \"unknown\"}${detail}`);\n    return { record: null, problem: required ? `could not identify ${agent} version (${reason})` : null, command, argsPrefix };\n  }\n\n  const versionMatch = /\\bv?(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?=\\b)/.exec(version);\n  const expected = typeof config.expectedAgentVersion === \"string\" ? config.expectedAgentVersion.replace(/^v/, \"\") : null;\n  if (expected && versionMatch?.[1] !== expected) {\n    const label = agent === \"nexus\" ? \"installed Nexus\" : agent;\n    const kind = agent === \"nexus\" ? \"expected RC\" : \"expected version\";\n    return { record: null, problem: `${label} version ${versionMatch?.[1] ?? version} does not match ${kind} ${expected}`, command, argsPrefix };\n  }\n\n  let executablePath;\n  let executableSha256;\n  try {\n    executablePath = agent === \"nexus\" && argsPrefix.length ? fs.realpathSync(argsPrefix[0]) : fs.realpathSync(command);\n    executableSha256 = await sha256File(executablePath);\n  } catch (err) {\n    if (required) return { record: null, problem: `could not hash ${agent} executable (${err.message})`, command, argsPrefix };\n  }\n  return {\n    record: {\n      agent,\n      version,\n      ...(executablePath ? { executablePath } : {}),\n      ...(executableSha256 ? { executableSha256 } : {}),\n      ...(agent === \"nexus\" && config.qualification === true ? { packageSha256: config.nexusPackageSha256 } : {}),\n    },\n    command,\n    argsPrefix,\n  };\n}\n\nfunction resolvePathExecutable(command, env) {\n  for (const directory of (env.PATH ?? \"\").split(path.delimiter).filter(Boolean)) {\n    const candidate = path.resolve(directory, command);\n    try {\n      if (fs.statSync(candidate).isFile()) return fs.realpathSync(candidate);\n    } catch {}\n  }\n  return null;\n}\n\nfunction sha256File(file) {\n  return new Promise((resolve, reject) => {\n    const hash = createHash(\"sha256\");\n    const stream = fs.createReadStream(file);\n    stream.on(\"data\", (chunk) => hash.update(chunk));\n    stream.on(\"error\", reject);\n    stream.on(\"end\", () => resolve(hash.digest(\"hex\")));\n  });\n}\n\nfunction agentCommand(task, ws, home, budget, agentIdentity, localToken) {\n  const sampling = config.sampling ?? { temperature: 0.2 };\n  const limits = config.limits ?? { context: 65536, output: 8192 };\n  const forbiddenEnv = Object.keys(config.env ?? {}).find((key) => /KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL/i.test(key));\n  if (forbiddenEnv) throw new Error(`candidate configuration may not contain credential-like environment key ${forbiddenEnv}`);\n  const ep = \"http://127.0.0.1:40127/v1\";\n  const env = {\n    PATH: config.env?.PATH ?? \"/usr/bin:/bin\", LANG: config.env?.LANG ?? \"C.UTF-8\", LC_ALL: config.env?.LC_ALL ?? \"C.UTF-8\",\n    TERM: config.env?.TERM ?? \"dumb\", HOME: \"/home/eval\", PWD: \"/workspace\", CI: \"1\",\n    LOCAL_LLM_API_KEY: localToken, OPENAI_API_KEY: localToken, GW_KEY: localToken,\n    XDG_CONFIG_HOME: \"/home/eval/.config\", XDG_DATA_HOME: \"/home/eval/.local/share\", XDG_STATE_HOME: \"/home/eval/.local/state\",\n  };\n  const agent = config.agent ?? \"nexus\";\n  if (agent === \"nexus\") {\n    env.LOCAL_LLM_ENDPOINT = ep;\n    const contextArgs = nexusContextLimitArgs(config, limits.context);\n    if (task.tier === \"T3\") {\n      // T3 drives the sidecar, the operator channel that carries steering, with the same model, budgets and limits.\n      const checkout = agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\");\n      // An installed package is <package>/bin/nexus with the sidecar at <package>/lib/cli/dist/sidecar.js.\n      const packageDir = checkout ? null : path.dirname(path.dirname(fs.realpathSync(agentIdentity.command)));\n      const sidecar = checkout ? path.join(ROOT, \"cli/dist/sidecar.js\") : path.join(packageDir, \"lib/cli/dist/sidecar.js\");\n      if (!fs.existsSync(sidecar)) throw new Error(`T3 needs the Nexus sidecar at ${sidecar}`);\n      if (packageDir) {\n        // The launcher is bypassed, so the package itself must be mounted: it has to sit under sandboxRuntimeRoots.\n        const roots = (config.sandboxRuntimeRoots ?? []).flatMap((root) => { try { return [fs.realpathSync(root)]; } catch { return []; } });\n        if (!roots.some((root) => packageDir === root || packageDir.startsWith(`${root}${path.sep}`))) throw new Error(`T3 runs the sidecar from ${packageDir}, which must be under sandboxRuntimeRoots`);\n        env.NEXUS_HOME = packageDir;\n      }\n      const sidecarArgs = [sidecar, \"--yes\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? [])];\n      return checkout ? { cmd: process.execPath, argv: sidecarArgs, env, protocol: true } : { cmd: \"/usr/bin/env\", argv: [\"node\", ...sidecarArgs], env, protocol: true };\n    }\n    return { cmd: agentIdentity.command, argv: [...agentIdentity.argsPrefix, \"run\", \"--yes\", \"--json\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? []), task.objective], env };\n  }\n  if (agent === \"aider\") {\n    return { cmd: agentIdentity.command, argv: [\"--model\", `openai/${config.model}`, \"--openai-api-base\", ep, \"--yes-always\", \"--no-auto-commits\", \"--no-dirty-commits\", \"--no-gitignore\", \"--no-show-model-warnings\", \"--no-check-update\", \"--analytics-disable\", \"--no-pretty\", \"--no-fancy-input\", ...(config.args ?? []), \"--message\", task.objective], env };\n  }\n  if (agent === \"opencode\") {\n    const dir = path.join(home, \".config/opencode\");\n    fs.mkdirSync(dir, { recursive: true });\n    const modelOptions = { temperature: sampling.temperature, ...(sampling.seed !== undefined ? { seed: sampling.seed } : {}) };\n    fs.writeFileSync(path.join(dir, \"opencode.json\"), JSON.stringify({\n      $schema: \"https://opencode.ai/config.json\",\n      autoupdate: false,\n      share: \"disabled\",\n      permission: { edit: \"allow\", bash: \"allow\", webfetch: \"deny\" },\n      agent: { \"nexus-eval\": { mode: \"primary\", steps: budget.steps } },\n      provider: { gw: { npm: \"@ai-sdk/openai-compatible\", name: \"gateway\", options: { baseURL: ep, apiKey: \"{env:GW_KEY}\" }, models: { [config.model]: { name: config.model, limit: limits, options: modelOptions } } } },\n      model: `gw/${config.model}`,\n    }, null, 2));\n    // Provider packages are cached across runs (not per run): the cache holds code, not state.\n    env.XDG_CACHE_HOME = path.join(home, \".cache\");\n    return { cmd: agentIdentity.command, argv: [\"run\", \"--agent\", \"nexus-eval\", \"--model\", `gw/${config.model}`, ...(config.args ?? []), task.objective], env };\n  }\n  if (agent === \"goose\") {\n    const u = new URL(ep);\n    Object.assign(env, { GOOSE_PROVIDER: \"openai\", GOOSE_MODEL: config.model, OPENAI_HOST: u.origin, OPENAI_BASE_PATH: `${u.pathname.replace(/^\\/|\\/$/g, \"\")}/chat/completions`, GOOSE_MODE: \"auto\", GOOSE_DISABLE_KEYRING: \"1\", GOOSE_CONTEXT_LIMIT: String(limits.context), GOOSE_MAX_TOKENS: String(limits.output), GOOSE_MAX_TURNS: String(budget.steps), GOOSE_TEMPERATURE: String(sampling.temperature) });\n// Kernel-enforced resource contract for task-controlled executions (eval/README.md, \"Resource contract\").\n// Each execution runs in its own delegated transient systemd --user scope under eval/cgroup_supervisor.mjs, which\n// applies cgroup v2 cpu.max, memory.max (swap 0) and pids.max to a payload leaf, verifies them, and kills the whole\n// cgroup afterwards. Workspaces and homes live on a dedicated size-capped tmpfs (storageBytes): that cap bounds\n// everything a run keeps on disk across phases, and each phase's writes are additionally charged to its memory.max.\nimport { spawn, spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst SYSTEMD_RUN = \"/usr/bin/systemd-run\";\nconst SUPERVISOR = fileURLToPath(new URL(\"./cgroup_supervisor.mjs\", import.meta.url));\nconst TMPFS_MAGIC = 0x01021994;\n\n/** Null when `resources` is a complete, sane contract; otherwise why it is not. */\nexport function resourceConfigProblem(resources) {\n  if (!resources || typeof resources !== \"object\") return \"resources must set cpuPercent, memoryBytes, tasks, storageBytes and workspaceRoot\";\n  const { cpuPercent, memoryBytes, tasks, storageBytes, workspaceRoot } = resources;\n  if (!Number.isInteger(cpuPercent) || cpuPercent < 10 || cpuPercent > 100 * 1024) return \"resources.cpuPercent must be an integer from 10 to 102400\";\n  if (!Number.isInteger(memoryBytes) || memoryBytes < 64 * 1024 * 1024 || memoryBytes % 4096 !== 0) return \"resources.memoryBytes must be a multiple of 4096 of at least 64 MiB\";\n  if (!Number.isInteger(tasks) || tasks < 8 || tasks > 1 << 20) return \"resources.tasks must be an integer from 8 to 1048576\";\n  if (!Number.isInteger(storageBytes) || storageBytes < 64 * 1024 * 1024) return \"resources.storageBytes must be an integer of at least 64 MiB\";\n  if (typeof workspaceRoot !== \"string\" || !path.isAbsolute(workspaceRoot)) return \"resources.workspaceRoot must be an absolute path\";\n  let stat;\n  try { stat = fs.statfsSync(workspaceRoot); }\n  catch { return \"resources.workspaceRoot is unavailable\"; }\n  if (stat.type !== TMPFS_MAGIC) return \"resources.workspaceRoot must be on a tmpfs so candidate writes are charged to the run's memory limit\";\n  const mountProblem = dedicatedTmpfsMountProblem(workspaceRoot);\n  if (mountProblem) return mountProblem;\n  if (stat.blocks * stat.bsize > storageBytes) return `resources.workspaceRoot tmpfs is ${stat.blocks * stat.bsize} bytes; mount a dedicated tmpfs with size<=storageBytes (${storageBytes})`;\n  return null;\n}\n\n/** A subdirectory of a shared tmpfs (including /dev/shm) does not enforce a per-run storage cap. */\nexport function dedicatedTmpfsMountProblem(workspaceRoot, mountInfoText = null) {\n  let lines;\n  try { lines = (mountInfoText ?? fs.readFileSync(\"/proc/self/mountinfo\", \"utf8\")).split(\"\\n\"); }\n  catch { return \"resources.workspaceRoot mount table is unavailable; refusing unverified workspace storage limits\"; }\n  const decode = (value) => value.replace(/\\\\([0-7]{3})/g, (_match, octal) => String.fromCharCode(Number.parseInt(octal, 8)));\n  const expected = path.resolve(workspaceRoot);\n  const matching = lines.filter((entry) => {\n    const fields = entry.split(\" \");\n    return fields.length > 6 && decode(fields[4]) === expected;\n  });\n  if (matching.length > 1) return \"resources.workspaceRoot has stacked or duplicate mount records; refusing ambiguous workspace storage boundary\";\n  const line = matching[0];\n  if (!line) return \"resources.workspaceRoot must be the exact mount point of a dedicated tmpfs, not a subdirectory\";\n  const fields = line.split(\" \");\n  const separator = fields.indexOf(\"-\");\n  if (separator < 0 || fields[separator + 1] !== \"tmpfs\" || decode(fields[3]) !== \"/\") {\n    return \"resources.workspaceRoot must be its own tmpfs mount, not a shared or bind-mounted filesystem\";\n  }\n  // A bind mount of a tmpfs root retains the same major:minor and root fields. Reject aliases of\n  // this mount so an apparently dedicated path cannot expose a tmpfs shared at another path.\n  const device = fields[2];\n  const aliases = lines.filter((entry) => {\n    const other = entry.split(\" \");\n    return other.length > 6 && other[2] === device && decode(other[4]) !== expected;\n  });\n  if (aliases.length > 0) return \"resources.workspaceRoot tmpfs is also mounted elsewhere; bind/shared mounts are not allowed\";\n  const options = `${fields[5]},${fields[separator + 3] ?? \"\"}`.split(\",\");\n  const mode = options.find((option) => option.startsWith(\"mode=\"))?.slice(5);\n  const uid = options.find((option) => option.startsWith(\"uid=\"))?.slice(4);\n  const mountMode = mode ? Number.parseInt(mode, 8) : null;\n  if (mountMode === null || (mountMode & 0o700) !== 0o700 || (mountMode & 0o066) !== 0 || uid !== String(process.getuid())) {\n    return \"dedicated tmpfs must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\";\n  }\n  let rootStat;\n  try { rootStat = fs.statSync(expected); }\n  catch { return \"resources.workspaceRoot mount root cannot be inspected; refusing unverified workspace permissions\"; }\n  const rootMode = rootStat.mode & 0o777;\n  if (rootStat.uid !== process.getuid() || (rootMode & 0o700) !== 0o700 || (rootMode & 0o066) !== 0) {\n    return \"dedicated tmpfs effective mount root must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\";\n  }\n  return null;\n}\n\n/** Null when a contained probe proves this host applies and cleans up the contract; otherwise the failure. */\nexport function resourceProbeProblem(resources) {\n  const configProblem = resourceConfigProblem(resources);\n  if (configProblem) return configProblem;\n  let wrapped;\n  try { wrapped = containedSpec({ cmd: \"/usr/bin/true\", argv: [] }, resources); }\n  catch (error) { return error.message; }\n  const result = spawnSync(wrapped.cmd, wrapped.argv, { cwd: \"/\", env: wrapped.env, stdio: [\"ignore\", \"ignore\", \"pipe\", \"pipe\"], timeout: 15_000, encoding: \"utf8\" });\n  const final = parseReports(result.output?.[3] ?? \"\").final;\n  if (!final) return `resource probe produced no containment report (${result.error?.message ?? `exit ${result.status}`}: ${(result.stderr ?? \"\").trim().slice(-300)})`;\n  if (final.error || !final.cleaned) return `resource probe failed: ${final.error ?? \"payload not cleaned\"}`;\n  if (final.exitCode !== 0) return `resource probe command exited ${final.exitCode}`;\n  return null;\n}\n\n/** The command line that runs `spec` under the supervisor in a fresh scope with `resources` applied. */\nexport function containedSpec(spec, resources) {\n  const { XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS } = process.env;\n  if (!XDG_RUNTIME_DIR) throw new Error(\"resource containment needs the systemd user manager (XDG_RUNTIME_DIR is unset)\");\n  if (!fs.existsSync(SYSTEMD_RUN)) throw new Error(\"resource containment needs systemd-run\");\n  const limits = { cpuPercent: resources.cpuPercent, memoryBytes: resources.memoryBytes, tasks: resources.tasks };\n  return {\n    cmd: SYSTEMD_RUN,\n    argv: [\"--user\", \"--scope\", \"--quiet\", \"--collect\", \"-p\", \"Delegate=yes\", \"--\", process.execPath, SUPERVISOR, JSON.stringify({ limits, cmd: spec.cmd, argv: spec.argv })],\n    env: { XDG_RUNTIME_DIR, ...(DBUS_SESSION_BUS_ADDRESS ? { DBUS_SESSION_BUS_ADDRESS } : {}) },\n    timeoutMs: spec.timeoutMs,\n  };\n}\n\n/**\n * Spawn `spec` (contained when `resources` is set). `containment.kill()` empties the payload cgroup;\n * `containment.final` resolves to the supervisor's last report, or null when it never reported.\n */\nexport function spawnContained(spec, resources, { stdio, ...options }) {\n  if (!resources) return { child: spawn(spec.cmd, spec.argv, { ...options, stdio, env: options.env ?? {} }), containment: null };\n  const wrapped = containedSpec(spec, resources);\n  const child = spawn(wrapped.cmd, wrapped.argv, { ...options, env: wrapped.env, stdio: [...stdio, \"pipe\"] });\n  let text = \"\";\n  let cgroup = null;\n  const final = new Promise((resolve) => {\n    child.stdio[3].on(\"data\", (chunk) => {\n      text += chunk.toString(\"utf8\");\n      cgroup ??= parseReports(text).cgroup;\n    });\n    child.stdio[3].on(\"close\", () => resolve(parseReports(text).final));\n    child.on(\"error\", () => resolve(null));\n  });\n  let repeat = null;\n  let fallback = null;\n  const killPayload = () => { if (cgroup) { try { fs.writeFileSync(path.join(cgroup, \"cgroup.kill\"), \"1\"); } catch {} } };\n  const kill = () => {\n    if (repeat) return;\n    // The payload may not have joined its leaf yet, or may fork after a kill: keep emptying the leaf until the\n    // supervisor exits. The supervisor also stops on SIGTERM. One that does not exit loses its report, so the run fails\n    // on containmentProblem; the fallback then kills the supervisor while the repeat keeps emptying the payload leaf.\n    killPayload();\n    try { process.kill(child.pid, \"SIGTERM\"); } catch {}\n    repeat = setInterval(killPayload, 50);\n    fallback = setTimeout(() => { try { process.kill(-child.pid, \"SIGKILL\"); } catch {} }, 10_000);\n    setTimeout(() => clearInterval(repeat), 30_000).unref();\n  };\n  child.on(\"close\", () => { clearInterval(repeat); clearTimeout(fallback); killPayload(); });\n  return { child, containment: { final, kill } };\n}\n\n/** Why a finished contained execution cannot be trusted as bounded, or null. */\nexport function containmentProblem(final) {\n  if (!final) return \"no containment report from the resource supervisor\";\n  if (final.error) return final.error;\n  if (!final.cleaned) return \"payload cgroup was not emptied\";\n  return null;\n}\n\nfunction parseReports(text) {\n  let cgroup = null;\n  let final = null;\n  for (const line of text.split(\"\\n\")) {\n    if (!line.trim()) continue;\n    let value;\n    try { value = JSON.parse(line); } catch { continue; }\n    if (value.cgroup && Object.keys(value).length === 1) cgroup = value.cgroup;\n    else final = value;\n  }\n  return { cgroup, final };\n}\n// Minimal Bubblewrap boundary for task setup and validators. These commands receive no host HOME,\n// network namespace, task directory, or inherited environment.\nimport { spawn, spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport os from \"node:os\";\nimport { fileURLToPath } from \"node:url\";\nimport { containmentProblem, spawnContained } from \"./resources.mjs\";\n\nconst BWRAP = \"/usr/bin/bwrap\";\nconst SYSTEM_BINARIES = [\"/usr/bin\", \"/usr/lib\", \"/usr/lib64\", \"/usr/libexec\", \"/usr/share\", \"/lib\", \"/lib64\", \"/usr/local/lib\"];\nconst SYSTEM_ETC_FILES = [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"];\nconst SYSTEM_ETC_DIRS = [\"/etc/alternatives\"];\nconst FORBIDDEN_RUNTIME_ROOTS = [\"/etc\", \"/root\", \"/proc\", \"/sys\", \"/run\", \"/var\", \"/dev\", \"/tmp\", \"/mnt\", \"/media\", \"/srv\"];\nconst SENSITIVE_HOME_PARTS = [\".ssh\", \".config\", \".aws\", \".azure\", \".gnupg\", \".kube\", \".nexus\", \".cache\"];\nlet sandboxPreflight;\nlet hostToolchains;\n\nfunction shellQuote(value) {\n  return `'${value.replaceAll(\"'\", `'\\\\''`)}'`;\n}\n\nexport function selectToolchainRoot(configuredRoot, fallbackRoot) {\n  return configuredRoot ?? fallbackRoot ?? null;\n}\n\nfunction resolveHostToolchains() {\n  if (hostToolchains) return hostToolchains;\n  const availableDirectory = (candidate) => {\n    try { return fs.statSync(candidate).isDirectory() ? candidate : null; }\n    catch { return null; }\n  };\n  const fromCommand = (command, argv) => {\n    const result = spawnSync(command, argv, { encoding: \"utf8\", timeout: 5000 });\n    return result.status === 0 ? availableDirectory(result.stdout.trim()) : null;\n  };\n  hostToolchains = {\n    goRoot: selectToolchainRoot(fromCommand(\"go\", [\"env\", \"GOROOT\"]), availableDirectory(\"/usr/local/go\")),\n    rustRoot: availableDirectory(\"/opt/nexus-qual/rust\") ?? fromCommand(\"rustc\", [\"--print\", \"sysroot\"]),\n  };\n  return hostToolchains;\n}\n\n/** Return the host paths that the candidate sandbox mounts, grouped by the bind logic. */\nexport function candidateSandboxHostMountSources({ cwd, home, proxyDirectory, readOnlyPaths = [], nodeRuntime, supervisorPath } = {}) {\n  if (!Array.isArray(readOnlyPaths)) throw new Error(\"candidate sandbox readOnlyPaths must be an array\");\n  const existing = (paths, kind) => paths.filter((source) => {\n    try {\n      const stat = fs.statSync(source);\n      return kind === \"directory\" ? stat.isDirectory() : stat.isFile();\n    } catch { return false; }\n  });\n  const optional = (source, resolve = true) => source === undefined ? null : resolve ? fs.realpathSync(source) : source;\n  return {\n    systemDirectories: existing(SYSTEM_BINARIES, \"directory\"),\n    systemFiles: existing(SYSTEM_ETC_FILES, \"file\"),\n    systemEtcDirectories: existing(SYSTEM_ETC_DIRS, \"directory\"),\n    toolchainDirectories: Object.values(resolveHostToolchains()).filter(Boolean),\n    runtimeSources: {\n      cwd: optional(cwd),\n      home: optional(home),\n      proxyDirectory: optional(proxyDirectory),\n      nodeRuntime: optional(nodeRuntime),\n      supervisorPath: optional(supervisorPath),\n      readOnlyPaths: readOnlyPaths.map((source) => fs.realpathSync(source)),\n    },\n  };\n}\n\nfunction pathOverlaps(left, right) {\n  return left === right || left.startsWith(`${right}${path.sep}`) || right.startsWith(`${left}${path.sep}`);\n}\n\nfunction pathVariants(source) {\n  if (typeof source !== \"string\" || !path.isAbsolute(source)) return [];\n  const lexical = path.resolve(source);\n  let current = lexical;\n  const suffix = [];\n  while (true) {\n    try {\n      const canonical = path.resolve(fs.realpathSync(current), ...suffix);\n      return [...new Set([lexical, canonical])];\n    } catch {\n      const parent = path.dirname(current);\n      if (parent === current) return [lexical];\n      suffix.unshift(path.basename(current));\n      current = parent;\n    }\n  }\n}\n\nfunction candidateMountOverlapProblem(mountSources, protectedCorpusPaths) {\n  return mountSourceOverlapProblem([\n    ...mountSources.systemDirectories,\n    ...mountSources.systemFiles,\n    ...mountSources.systemEtcDirectories,\n    ...mountSources.toolchainDirectories,\n    ...Object.values(mountSources.runtimeSources).flatMap((value) => Array.isArray(value) ? value : value === null ? [] : [value]),\n  ], protectedCorpusPaths);\n}\n\nfunction mountSourceOverlapProblem(sources, protectedCorpusPaths) {\n  if (!Array.isArray(protectedCorpusPaths)) return \"candidate sandbox protectedCorpusPaths must be an array\";\n  for (const protectedPath of protectedCorpusPaths) {\n    const protectedVariants = pathVariants(protectedPath);\n    if (!protectedVariants.length) return \"candidate sandbox protected corpus paths must be absolute\";\n    for (const source of sources) {\n      const sourceVariants = pathVariants(source);\n      if (sourceVariants.some((left) => protectedVariants.some((right) => pathOverlaps(left, right)))) {\n        return `candidate sandbox host mount overlaps protected corpus material: ${source}`;\n      }\n    }\n  }\n  return null;\n}\n\nexport function sandboxAvailable() {\n  if (sandboxPreflight !== undefined) return sandboxPreflight;\n  try {\n    if (!fs.statSync(BWRAP).isFile() || (fs.statSync(BWRAP).mode & 0o111) === 0) return (sandboxPreflight = false);\n    const args = [\"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\", \"--proc\", \"/proc\", \"--dev\", \"/dev\"];\n    for (const source of SYSTEM_BINARIES) {\n      try {\n        if (fs.statSync(source).isDirectory()) {\n          if (source === \"/usr/local/lib\") args.push(\"--dir\", \"/usr/local\");\n          args.push(\"--ro-bind\", source, source);\n        }\n      } catch {}\n    }\n    args.push(\"--clearenv\", \"--\", \"/usr/bin/unshare\", \"-Ur\", \"true\");\n    const result = spawnSync(BWRAP, args, { encoding: \"utf8\", timeout: 5000, env: {} });\n    // The sandbox itself must start, and nested user namespaces must be unavailable to the payload.\n    return (sandboxPreflight = result.status === 1 && !result.error);\n  } catch {\n    return (sandboxPreflight = false);\n  }\n}\n\nexport function isolatedArgv({ cwd, home, command, timeoutSec = 300, readOnlySubpaths = [], hiddenSubpaths = [], protectedCorpusPaths = [] }) {\n  const workspace = fs.realpathSync(cwd);\n  const hiddenSources = hiddenSubpaths.map((relative) => confinedPath(workspace, relative));\n  const readOnlySources = readOnlySubpaths.map((relative) => confinedPath(workspace, relative));\n  const mountSources = candidateSandboxHostMountSources({ cwd: workspace, readOnlyPaths: [...readOnlySources, ...hiddenSources] });\n  const protectedOverlap = candidateMountOverlapProblem(mountSources, protectedCorpusPaths);\n  if (protectedOverlap) throw new Error(protectedOverlap);\n  if (!sandboxAvailable()) throw new Error(\"Bubblewrap is unavailable; refusing to execute task-controlled commands\");\n  const hiddenGuestPaths = hiddenSources.map((source) => path.posix.join(\"/workspace\", path.relative(workspace, source).split(path.sep).join(\"/\")));\n  let executionCommand = command;\n  const args = [\n    \"--unshare-user\", \"--unshare-pid\", \"--unshare-net\", \"--disable-userns\", \"--die-with-parent\",\n    \"--new-session\", \"--proc\", \"/proc\", \"--dev\", \"/dev\", \"--tmpfs\", \"/tmp\",\n  ];\n  let localPrefixCreated = false;\n  for (const source of SYSTEM_BINARIES) {\n    try {\n      if (fs.statSync(source).isDirectory()) {\n        if (source === \"/usr/local/lib\") {\n          args.push(\"--dir\", \"/usr/local\");\n          localPrefixCreated = true;\n        }\n        args.push(\"--ro-bind\", source, source);\n      }\n    } catch {}\n  }\n  const { goRoot, rustRoot } = resolveHostToolchains();\n  if (goRoot) {\n    if (!localPrefixCreated) args.push(\"--dir\", \"/usr/local\");\n    args.push(\"--ro-bind\", goRoot, \"/usr/local/go\");\n  }\n  if (rustRoot) {\n    args.push(\"--dir\", \"/opt\", \"--dir\", \"/opt/nexus-qual\", \"--ro-bind\", rustRoot, \"/opt/nexus-qual/rust\");\n  }\n  for (const source of [\"/etc/ld.so.cache\", \"/etc/passwd\", \"/etc/group\", \"/etc/nsswitch.conf\", \"/etc/localtime\"]) {\n    try {\n      if (fs.statSync(source).isFile()) args.push(\"--ro-bind\", source, source);\n    } catch {}\n  }\n  try { if (fs.statSync(\"/etc/alternatives\").isDirectory()) args.push(\"--ro-bind\", \"/etc/alternatives\", \"/etc/alternatives\"); } catch {}\n  args.push(\"--bind\", workspace, \"/workspace\", \"--dir\", \"/home\", \"--dir\", \"/run\");\n  if (hiddenSubpaths.length) {\n    const helperDir = path.dirname(fileURLToPath(import.meta.url));\n    args.push(\"--dir\", \"/runner\", \"--ro-bind\", path.join(helperDir, \"hide_oracle.cjs\"), \"/runner/hide_oracle.cjs\");\n    args.push(\"--ro-bind\", path.join(helperDir, \"hide_oracle.py\"), \"/runner/sitecustomize.py\");\n    args.push(\"--ro-bind\", path.join(helperDir, \"unlink_then_exec.sh\"), \"/runner/unlink_then_exec.sh\");\n  }\n  // Workspace subpaths the command may read but not change (hardened hidden tests: the oracle's own files).\n  for (const relative of hiddenSubpaths.length ? [] : readOnlySubpaths) {\n    const source = confinedPath(workspace, relative);\n    args.push(\"--ro-bind\", source, path.posix.join(\"/workspace\", path.relative(workspace, source).split(path.sep).join(\"/\")));\n  }\n  args.push(\"--symlink\", \"usr/bin\", \"/bin\");\n  args.push(\"--chdir\", \"/workspace\", \"--clearenv\", \"--setenv\", \"PATH\", \"/opt/nexus-qual/rust/bin:/usr/local/go/bin:/usr/bin:/bin\");\n  args.push(\"--setenv\", \"HOME\", home ? \"/home/eval\" : \"/tmp\");\n  args.push(\"--setenv\", \"CI\", \"1\", \"--setenv\", \"LANG\", \"C.UTF-8\");\n  if (hiddenSubpaths.length) {\n    args.push(\"--setenv\", \"NEXUS_HIDDEN_FILES\", JSON.stringify(hiddenGuestPaths));\n    args.push(\"--setenv\", \"NODE_OPTIONS\", \"--require /runner/hide_oracle.cjs\");\n    args.push(\"--setenv\", \"PYTHONPATH\", \"/runner\");\n    if (/\\bgo\\s+test\\b/.test(command)) {\n      executionCommand = command.replace(/\\bgo\\s+test\\b/g, \"go test -exec /runner/unlink_then_exec.sh\");\n    } else if (/\\bcargo\\s+test\\b/.test(command)) {\n      args.push(\"--setenv\", \"CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER\", \"/runner/unlink_then_exec.sh\");\n      executionCommand = command;\n    } else if (/^(python(?:\\d+(?:\\.\\d+)?)?)\\s+(\\S+\\.py)\\s*$/.test(command.trim())) {\n      const [, python, script] = command.trim().match(/^(python(?:\\d+(?:\\.\\d+)?)?)\\s+(\\S+\\.py)\\s*$/);\n      executionCommand = `${python} -c 'import runpy,sys; runpy.run_path(sys.argv[1], run_name=\"__main__\")' ${shellQuote(script)}`;\n    }\n    executionCommand = executionCommand.replace(/\\bPYTHONPATH=/g, \"PYTHONPATH=/runner:\");\n    executionCommand = executionCommand.replace(/\\bpytest\\b/g, \"pytest --assert=plain --noconftest\");\n    args.push(\"--setenv\", \"PYTHONDONTWRITEBYTECODE\", \"1\");\n  }\n  if (home) args.push(\"--tmpfs\", \"/home/eval\");\n  args.push(\"--\", \"/usr/bin/bash\", \"-c\", executionCommand);\n  return { cmd: BWRAP, argv: args, timeoutMs: timeoutSec * 1000 };\n}\n\nexport function runtimeMountProblem(readOnlyPaths, allowedRoots, allowedFiles = []) {\n  if (!Array.isArray(readOnlyPaths) || !Array.isArray(allowedRoots) || !Array.isArray(allowedFiles) || allowedRoots.some((item) => typeof item !== \"string\" || !path.isAbsolute(item)) || allowedFiles.some((item) => typeof item !== \"string\" || !path.isAbsolute(item))) {\n    return \"candidate runtime mounts require explicit absolute paths and allowed roots\";\n  }\n  const roots = [];\n  for (const item of allowedRoots) {\n    const lexical = path.resolve(item);\n    const lexicalProblem = protectedRuntimeRootProblem(lexical);\n    if (lexicalProblem) return lexicalProblem;\n    try { roots.push(fs.realpathSync(lexical)); }\n    catch { return \"candidate runtime allowlist root is unavailable\"; }\n  }\n  let executableFiles;\n  try { executableFiles = allowedFiles.map((item) => fs.realpathSync(item)); }\n  catch { return \"candidate runtime executable is unavailable\"; }\n  for (const root of roots) {\n    const rootProblem = protectedRuntimeRootProblem(root);\n    if (rootProblem) return rootProblem;\n  }\n  for (const item of readOnlyPaths) {\n    if (typeof item !== \"string\" || !path.isAbsolute(item)) return \"candidate runtime paths must be absolute\";\n    let resolved;\n    try { resolved = fs.realpathSync(item); }\n    catch { return `candidate runtime path is unavailable: ${item}`; }\n    const stat = fs.statSync(resolved);\n    if (SYSTEM_BINARIES.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) continue;\n    const explicitlySelectedTempExecutable = executableFiles.includes(resolved) && stat.isFile() && resolved.startsWith(`/tmp${path.sep}`);\n    if (FORBIDDEN_RUNTIME_ROOTS.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !explicitlySelectedTempExecutable) {\n      return `protected candidate runtime path is forbidden: ${resolved}`;\n    }\n    if (resolved === os.homedir() || (resolved.startsWith(`${os.homedir()}${path.sep}`) && resolved.split(path.sep).some((part) => SENSITIVE_HOME_PARTS.includes(part)))) {\n      return `sensitive candidate runtime path is forbidden: ${resolved}`;\n    }\n    if (!stat.isFile() && !stat.isDirectory()) return `candidate runtime path is not a regular file or directory: ${resolved}`;\n    if (!roots.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`)) && !executableFiles.includes(resolved)) {\n      return `candidate runtime path is outside its explicit allowlist: ${resolved}`;\n    }\n    if (executableFiles.includes(resolved) && !stat.isFile()) return `candidate runtime executable is not a regular file: ${resolved}`;\n    if (stat.isDirectory()) assertNoSymlinks(resolved);\n  }\n  return null;\n}\n\nfunction protectedRuntimeRootProblem(root) {\n# Evaluation harness (qualification assessment §9)\n\n`run.mjs` runs tasks against one agent configuration and appends a JSON line per run; `score.mjs` reports the scores\nseparately (never combined), per task and configuration, with 95 % Wilson intervals.\n\n`docs/v1.0.0/READINESS.md` is a historical checkpoint at source revision `6151a23`; use this file and the current\nrunner source for evaluator behavior added after that revision. Neither document represents completed M5 qualification.\n\n```bash\nnode eval/run.mjs --config eval/configs/gateway-engineering-deep.json --out eval/out/<label> [--only id,id] [--runs N]\nnode eval/score.mjs eval/out/<label>/results.jsonl          # markdown table; --json for machine output\nnode eval/score.mjs --pairs \"$NEXUS_RESULTS\" \"$GOOSE_RESULTS\" \"$OPENCODE_RESULTS\"\n```\n\nEach run uses a frozen copy of the task tree, a fresh workspace and `HOME`, and a unique output directory. The agent\nreceives only its workspace, isolated home, selected read-only runtime files, and a run-scoped token for a local proxy;\nthe real gateway credential stays in the harness process. The candidate runs in Bubblewrap user, PID and network\nnamespaces, with nested user namespaces disabled. Legacy development tasks may still use `hidden: { dir, into, command }`;\nthose commands execute against the candidate workspace after the agent exits and are **not safe for qualification**, because\nvalidator code can inspect or modify files in that workspace. Qualification requires `hidden: { protocol: \"blackbox-v1\",\ncasesFile, runtime, argv, timeoutMs, totalTimeoutMs, maxOutputBytes }`. Its private JSON cases contain only `input` and\n`expected`; the host evaluator keeps expected values in its process and launches the candidate runtime separately for each\ninput using a fresh top-level Bubblewrap boundary. The candidate receives one input on stdin and returns one JSON value on\nstdout. Its workspace is read-only; private oracle files are not mounted. Candidate output and diagnostics are discarded,\nand result logs contain only case counts and failed indexes. Supported runtimes are explicitly allowlisted (`node`,\n`python3`); the only argument is a validated relative candidate entrypoint (no runtime flags, eval expressions, or extra\narguments), and per-case/aggregate time and output bounds are enforced. Oracle files must be outside the copied fixture.\nAbsolute paths, traversal, symlinks and unsupported fixture entries are rejected. `manifest.json` records the harness source-file hashes, model fingerprint, corpus/task\nhashes when qualification is configured, executable version, budgets, host and Node version. Each result records the\nexecutable version and effective step/minute budget; per-run logs go to `logs/<task>-<run>/`. The runner refuses an\nexisting output directory so a retry cannot append to or replace prior evidence.\n\nQualification runs require `nexusExecutable` to name the absolute path of the installed RC,\n`expectedAgentVersion` to pin its version, and `nexusPackageSha256` to record the expected release-asset digest from checksum verification. The runner checks `nexus --version` and refuses the checkout\n`cli/dist/index.js` or a version mismatch before starting an agent. Peer versions are read using each adapter's\n`--version` command inside the same Bubblewrap filesystem/network boundary, with a cleared environment and bounded\noutput/time; executable paths and SHA-256 hashes are archived alongside the RC package\ndigest. `score.mjs --pairs` takes exactly the Nexus,\nGoose and OpenCode result files and refuses mismatched model fingerprints, sampling declarations, context/output\nlimits, explicit per-task request and aggregate requested-output ceilings, run pairs, executable identities, or\neffective step/minute budgets. The proxy permits only model-catalog and inference routes, strips client-supplied\nauthorization and control-plane headers, and enforces configured request/body/output ceilings. These are requested\ncompletion-token ceilings, not exact usage accounting. It reports peer hidden-test results\nseparately; scores are never combined. The Nexus adapter passes the recorded temperature and step/minute limits;\nOpenCode receives a primary evaluation agent with the recorded step limit, temperature and seed; Goose receives the\nmatching `--max-turns`, context/output limits and temperature settings. Qualification mode currently requires\n`sampling.temperature` to be `0` across all three adapters; seed metadata remains recorded when configured.\n\n## Task format (`eval/tasks/<id>/task.json`)\n\n| Field | Meaning |\n|---|---|\n| `id`, `tier` | T1 smoke (scripted model, CI), T2 standard, T3 long-task, T4 fault-injected |\n| `fixture` or `repo` | a directory in the task, or `{ \"url\", \"commit\" }` (external repositories at pinned commits) |\n| `setup` | shell commands run in the workspace before the agent (e.g. `npm ci`) |\n| `objective` | the operator text given to the agent |\n| `steps`, `minutes` | budgets (defaults from the configuration: 300 steps, 120 min) |\n| `hidden` | `{ dir, into, command, timeoutSec }` — tests the agent never sees; pass = artifact correct |\n| `regression` | `{ command }` — the repository's own suite after the run |\n\n## Scores\n\ncompletion claimed · artifact correct (hidden tests) · false VERIFIED (VERIFIED while hidden tests fail) · regressions\nintroduced · timed out / harness errors · wall time, steps, tokens (median). Context qualifier (`contextNotRetained`) is\nrecorded per run.\n\n## Scoring integrity\n\n- **Model proxy.** Every agent reaches the model through a per-run forwarder (`eval/model_proxy.mjs`) that `run.mjs`\n  starts. Each record carries `model: { requests, answered, upstreamFailures, firstRequestAt, firstAnswerAt }`. Set\n  `\"proxy\": false` in a config to connect agents directly; such runs are then scored only by the legacy rule below.\n- **Infrastructure reruns** (`eval/infra.mjs`). A run is rerun only when the model never answered *and* the endpoint\n  was observed failing, or when the harness itself errored. The rule is the same for every agent. A run in which the\n  model answered is always scored: a crash is a failure (and counts towards the crash rate), not a rerun. Records from\n  before the proxy fall back to each agent's own connection-failure message, and the script says how many it judged\n  that way.\n- **Contamination.** Contaminated runs (the task directory changed, or its path appeared in the agent's output) are\n  left out of pooled pass rates and counted separately.\n- **Reruns are listed.** `score.mjs` lists every replaced run with what it showed and what the rerun showed.\n- **Pooled metrics.** Pooled rows report crash rate, regressions, tokens per correct result and wall seconds per\n  correct result. The cost of failed runs counts towards these.\n\n## Fault injection (T4)\n\nA task or config may list `faults: [{ kind, atRequest }]`. The run's model proxy then injects that fault into the Nth\nchat request (counted from 1):\n\n| kind | Fault |\n|---|---|\n| `refuse` | The connection drops without an answer |\n| `overloaded` | 503 with `Retry-After: 1` |\n| `stream_cut` | The stream is cut after its first tool-call fragment |\n| `truncate` | `finish_reason` becomes `length` |\n| `context_overflow` | llama.cpp's HTTP 400 `exceed_context_size_error` |\n| `malformed_tool_json` | The first tool call's arguments are no longer valid JSON |\n\nWhat was injected is recorded in `model.faultsInjected`. Such runs are never treated as infrastructure reruns.\n`score.mjs` reports, per fault kind:\n\n- runs;\n- **truthful** (the run ended with its own result, did not hang past its budget, and never claimed VERIFIED while the\n  hidden tests failed);\n- **recovered** (the hidden tests pass);\n- hung past budget.\n\nThe remaining T4 classes come from task fixtures (a hanging test command, a full disk) and from the SIGTERM-then-resume\nrunner case. `make test` includes a T4 smoke test with two injected faults (`cli/test/eval_harness.test.ts`).\n\n## Qualification runs\n\nA config with `\"qualification\": true` is the v1.0.0 evidence run (docs/v1.0.0/ACCEPTANCE.md §6). `run.mjs` refuses to start\none, before any agent runs, unless every item below holds:\n\n- **Tasks are well formed** (`eval/validate.mjs`): one source (fixture, or a repo pinned to a full commit id), an isolated\n  `blackbox-v1` hidden oracle, and `class` (bugfix · feature · refactor · debug) and `difficulty` (easy · medium · hard). Development runs check\n  everything except class and difficulty.\n- **The model is identified, not just named.** `fingerprint: { weightsSha256, serverBuild }` and\n  `sampling: { temperature, seed }` are set in the config, and the endpoint lists the model. The fingerprint (with the\n  listed owner and context) is written to `manifest.json`.\n- **Hidden tests are out of the agent's reach.** `runAs` names a separate evaluator user. Candidate execution occurs\n  inside the Bubblewrap mount namespace and does not bind the task store or validator sources; its `HOME`, `/tmp`,\n  `/run`, and network namespace are isolated. Runtime files are explicit read-only binds. The harness grants the\n  evaluator UID ACL access only to the disposable workspace, home and per-run proxy directory. Before qualification,\n  verify the account and these existing operating-system permissions through the approved local setup procedure:\n  1. `sudo useradd --system --create-home nexus-eval`\n  2. A narrowly constrained sudoers rule permitting only the required Bubblewrap invocation as `nexus-eval`; do not\n     grant arbitrary `env` command execution.\n  3. Keep task stores unreadable to the evaluator account; the runner does not mount them into the candidate namespace.\n  4. A Nexus install, Node and the peer agents that `nexus-eval` can read and execute.\n\n  Development runs may omit `runAs`; Bubblewrap isolation still applies. Qualification is refused without a separate\n  evaluator account, `setfacl`, explicit `sandboxRuntimeRoots`, and read-only `sandboxRuntimePaths` contained by those\n  roots. Protected roots such as `/etc`, `/dev`, `/proc`, `/sys`, `/run`, `/var`, `/tmp`, and sensitive user-cache paths\n  are rejected. No setup procedure is applied by the runner.\n\n- **Repository workspaces carry no history beyond the pinned commit.** `eval/workspace.mjs` stages a repo task as a\n  fresh `git init` that fetches only the pinned commit and its ancestors from the local cache (`--no-tags`, no\n  FETCH_HEAD), then checks out that commit detached. There is no `--shared` clone, alternates link, remote, tag or\n  descendant object, so the upstream fix that follows a held-out baseline is not reachable from the workspace. Staging\n  verifies this and refuses the run otherwise.\n\n- **Corpus binding is integrity evidence, not approval authentication.** The qualification config pins the exact\n  corpus-manifest SHA-256, and the run manifest repeats the selected task hashes. The v1 manifest binds every task's\n  full task tree in row `sha256`. The heldout-v2 manifest binds each task's raw `task.json` and hidden-directory digest for\n  pinned-repository tasks; a local fixture additionally requires a full-tree `sha256` because those two v2 digests do\n  not cover fixture files. The frozen config carries `corpusCustody: { custodian, approvedAt, reportPath, reportSha256 }`\n  and may also name `storeRoot`, `validatorPath`, `referencePath`, and `authorLogPath`; the report path and optional\n  private paths are protected from runtime mounts. These values and the manifest's custody labels are claims, not\n  signatures. Independent custody acceptance, pre-RC commit timing, and configuration freeze must be verified and\n  archived by the acceptance reviewer before any qualification run. The current candidate task package has not been\n  independently accepted.\n\n### Isolation limits\n\nBubblewrap plus the current runner enforces separate mount/user/PID/network namespaces, a cleared task-command\nenvironment, a bounded wall clock, bounded captured output, per-run process-group teardown, and read-only runtime\nbinds. Black-box qualification keeps oracle expectations outside candidate namespaces. Legacy hidden commands share a\nprocess with candidate code and are rejected during qualification preflight. The hardened legacy path below is only for\ndevelopment and pilot scoring; it is not qualification evidence. Aggregate CPU, memory, process-count and\nwritable-storage limits come from the resource contract below, not from request/token ceilings. Appliance-specific\nBubblewrap enforcement is a separate, unverified condition.\n\n### Hardened legacy hidden tests (development and pilot only)\n\nLegacy tasks use `hidden: { dir, command }` (for example `pytest` or `go test` over copied test files) and run candidate\ncode in the same process as the oracle. They do not meet the qualification boundary, even when hardened. Qualification\npreflight accepts only the isolated `blackbox-v1` protocol. Any legacy task in a qualification corpus must be replaced\nor converted by the authorized custodian, with custody checks repeated and a new immutable manifest identity recorded.\nDevelopment configs may opt into the hardened diagnostic path with `\"hardenedChecks\": true`.\n\n1. The agent's workspace is never tested, and nothing runs git or any other program against it after the agent ran.\n   An agent-written `.git/config` or `.gitattributes` would otherwise run commands as the harness user. The baseline\n   tree hash is taken before the agent starts. The harness then stages the task again (the same pinned commit or\n   fixture, the same setup commands) into a fresh workspace, and checks that its tree equals that baseline.\n2. The agent's changes are found by walking both trees and comparing bytes and executable bits\n   (`eval/hardened_check.mjs`). Only an allowlist crosses over:\n   - Only **source files** (`.py`, the `.js`/`.ts` family, `.go`, `.rs`) and the manifests `package.json`,\n     `pyproject.toml`, `Cargo.toml`, `go.mod` and `go.sum` may be added, changed or deleted. Every other file type,\n     including test data, keeps its baseline content.\n   - A new Python file may only join a regular package that already exists, meaning a directory with `__init__.py` in\n     the baseline. It may not take a name that would shadow the test runner or the standard library\n     (`pytest.py`, `json.py`, …). Namespace packages without `__init__.py` cannot gain new modules; that is a\n     fairness cost.\n   - **Always dropped:**\n     - VCS metadata and dependency trees or caches: `.git`, `node_modules`, `.venv`, `site-packages`,\n       `__pycache__`, `vendor`, `target`, `.yarn`, `.cargo`, `.github`;\n     - test files and directories;\n     - test data: `testdata/`, `fixtures/`, `__snapshots__/`, `snapshots/`, `golden/`, mocks, `*.golden`, `*.snap`;\n     - test-runner configuration and setup files;\n     - interpreter and package-manager hooks: `sitecustomize.py`, `.pth`, `.npmrc`, `.yarnrc*`, `.pnpmfile.cjs`,\n       `go.work`, `rust-toolchain*`, `build.rs`;\n     - `Makefile`, `.env*`, `.gitattributes` and `.gitignore`;\n     - symlinks, any path that passes through a symlink in the fresh tree, and files over 2 MiB.\n\n     Dependency trees therefore always come from setup, never from the agent.\n   - **Manifests** may change only plain dependency or metadata entries. Any other change refuses both checks, and so\n     does a deleted manifest or a new one (a new `go.mod` or `package.json` moves module or root boundaries). In TOML,\n     every line starting with `[` is a section boundary, keyed by its exact text. An unrecognised header, a `[[…]]`\n     table, or a header with a comment therefore cannot be folded into an allowed section:\n     - `package.json`: anything but the dependency maps and metadata, or a `file:`/`git:`/path dependency;\n     - `pyproject.toml`: anything outside `[project]`;\n     - `Cargo.toml`: anything outside `[dependencies]`/`[dependencies.<name>]`, or a `path`, `git` or `registry`\n       source. Adding `[dev-dependencies]` or `[build-dependencies]` is refused, which costs legitimate test-only\n       dependency additions;\n     - `go.mod`: anything outside its `require` lines and blocks, including entries inside an existing `replace (…)`.\n3. Anything the agent left at the oracle's path is removed. The hidden command then runs with the hidden directory\n   bind-mounted **read-only**. The regression\n   command runs in a separate byte-identical copy, so candidate code executed by one check cannot prepare the other.\n4. In development/pilot runs, hidden-test output is kept only as a status, byte count and SHA-256, so diagnostic\n   records do not disclose the tests. Each run record carries\n   `hardened: { baseline, applied, discarded, configChanges }`.\n\nThis legacy hardening path supports development and pilot scoring only. Candidate source still executes in the same\nruntime as its legacy validator, so it can inspect or alter validator state; file hiding and a fresh workspace do not\nprovide independent qualification. `qualification: true` rejects every legacy hidden command before any candidate\nstarts. Do not relabel legacy evidence as qualification evidence.\n\nThe legacy output checks below are diagnostic safeguards for development scoring, not acceptance evidence. Qualification\nkeeps black-box expected values in the evaluator process and runs candidate code in a separate Bubblewrap process.\n- Fairness cost: a real source directory named `vendor/` or `target/` is skipped like a dependency tree, so the\n  agent's changes there are dropped. The `npm:` alias form of a dependency spec is not refused; setup is not re-run\n  after the copy, so it cannot install anything.\n\nThe sealed corpus is bound through its own manifest schema (`eval/heldout-manifest.json`, `hash_scheme`). The runner\nrecomputes each selected task's `task_sha256` (raw `task.json`) and `hidden_sha256`. The latter is computed over the\nregular files of `hidden.dir`, with `/`-separated relative paths sorted byte-wise, each line `<path>  <sha256>\\n`. For\npinned-repository tasks these bind the task declaration and hidden tests while the repository commit pins the source.\nA task using a local `fixture` must also carry `sha256` for the full task tree; without it, fixture content outside\n`task.json` and `hidden.dir` would be unbound. The selected population must equal the manifest's. The manifest carries\nno custody fields, so the frozen config states `corpusCustody: { custodian, approvedAt, reportPath, reportSha256 }`;\noptional private paths are `storeRoot`, `validatorPath`, `referencePath`, and `authorLogPath`. The acceptance reviewer\nchecks the report against its digest and verifies custody claims independently.\n\n### Resource contract\n\nA config's `resources` object — `{ \"cpuPercent\", \"memoryBytes\", \"tasks\", \"storageBytes\", \"workspaceRoot\" }` — applies to every\ntask-controlled execution: setup commands, the candidate agent, legacy hidden and regression commands, every black-box\noracle case and the agent version probe. Qualification refuses to start without it.\n\n- Each execution runs under `eval/cgroup_supervisor.mjs` as the only process of its own delegated transient\n  `systemd-run --user --scope`. The supervisor writes cgroup v2 `cpu.max` (`cpuPercent`% of one CPU), `memory.max`\n  (`memoryBytes`), `memory.swap.max` (0), `memory.oom.group` (1) and `pids.max` (`tasks`) on a `payload` leaf, reads them back, and refuses to\n  run on any mismatch. The command joins that leaf before `exec`, so nothing task-controlled runs outside the limits.\n  The limits are aggregate over the whole process tree, whatever its uid (`runAs`), session or process group.\n- `workspaceRoot` must itself be a dedicated tmpfs mount, not a directory on a shared mount or a bind mount. It must be\n  owned by the evaluator harness uid, with owner `rwx` and no group/other read or write permission. Group/other execute\n  permission is allowed so a separate evaluator uid can traverse to its per-run ACL-protected directory. For example:\n  `mount -t tmpfs -o size=<storageBytes>,mode=0711,uid=<harness-uid>,gid=<harness-gid> tmpfs <dir>`.\n  The preflight checks `/proc/self/mountinfo`, the mount root and options, the effective tmpfs size, and the cgroup\n  probe. A shared tmpfs such as `/dev/shm` fails even when `storageBytes` is set to its full size. Workspaces and homes\n  are created on this mount. Its filesystem size hard-caps files retained across phases; writes beyond it fail with\n  `ENOSPC`. Runs are serial and each workspace is removed afterwards; `--keep` is refused under the contract.\n- Within that cap, tmpfs pages, including the sandbox's own `/tmp`, are charged to the writing phase's memory cgroup and\n  cannot be swapped. A phase therefore also cannot hold more than `memoryBytes` of memory and new writes together. When\n  it reaches that bound the whole phase is OOM-killed (`memory.oom.group`), and this is recorded. When a phase's cgroup\n  is removed, the kernel moves its charges to the unlimited parent cgroup. Later phases get their own `memoryBytes`,\n  which is why the filesystem cap, not the memory limit, is the cross-phase storage bound. An OOM in a hidden or\n  regression check is the candidate's outcome, a failed check, not an infrastructure error.\n- CPU is bounded in rate by `cpu.max` and in total by the phase's wall-clock timeout.\n- This contract is supported only on Linux with cgroup v2 CPU, memory and pids controllers, a delegated systemd user\neval/score.mjs:13:  \"hanging_test_command\",\neval/score.mjs:14:  \"full_disk\",\neval/score.mjs:17:  \"sigterm_resume\",\neval/score.mjs:21:const T4_RUNNER_CLASSES = new Set([\"hanging_test_command\", \"full_disk\", \"sigterm_resume\"]);\n","exit_code":0,"duration":{"secs":0,"nanos":956677683}},"started_at_ms":1792915123386,"completed_at_ms":1792915124343}}
{"timestamp":"2026-10-25T07:58:45.921Z","ordinal":330535,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17211-b6a1-7340-8114-95de7e949c6a","call_id":"call_ceb8334e79944fb4a087981acac3b808","output":[{"type":"input_text","text":"Script completed\nWall time 3.7 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 12027)\nTotal output lines: 677\n\nWarning: truncated output (original token count: 15428)\nTotal output lines: 947\n\n      // Fixture tasks commit at staging time, so compare content (the tree), not the commit id.\n      if (gitRev(hiddenWs, \"HEAD^{tree}\") !== baselineTree) throw new Error(\"hardened check workspace staged a different baseline\");\n      hardening = { baseline: baselineTree, ...applyAgentChanges(ws, hiddenWs) };\n      cloneWorkspace(hiddenWs, regressionWs);\n    }\n    const refused = (check) => ({ pass: false, status: null, timedOut: false, overflow: false, output: `hardened check refused: ${hardening.configChanges.join(\"; \")}`, refused: true, resources: null, containmentProblem: null, check });\n    const hidden = hardening?.configChanges.length ? refused(\"hidden\") : await runCheck(task, hiddenWs, task.hidden, true, { readOnlyHidden: hardened });\n    const regression = task.regression ? (hardening?.configChanges.length ? refused(\"regression\") : await runCheck(task, regressionWs, task.regression, false)) : null;\n    for (const [phase, check] of [[\"hidden\", hidden], [\"regression\", regression]]) {\n      if (check?.containmentProblem) throw new Error(`${phase} check containment failed: ${check.containmentProblem}`);\n    }\n    const turn = agent.json?.turn ?? null;\n    // Nexus reports a structured outcome; for the other agents a clean exit within the budget is their completion claim.\n    const claimedComplete = turn\n      ? turn.execution === \"COMPLETED\" && [\"VERIFIED\", \"REGRESSION_FREE\", \"UNVERIFIED\", \"NOT_REQUIRED\"].includes(turn.outcome)\n      : agent.code === 0 && !agent.timedOut && !agent.outputExceeded;\n    return {\n      ...base,\n      wallMs,\n      exitCode: agent.code,\n      timedOut: agent.timedOut,\n      outputExceeded: agent.outputExceeded,\n      turn: turn && { execution: turn.execution, outcome: turn.outcome, reason: turn.reason ?? null, steps: turn.steps ?? null, contextNotRetained: turn.contextNotRetained ?? 0 },\n      claimedComplete,\n      claimedVerified: turn?.outcome === \"VERIFIED\",\n      hiddenPass: hidden.pass,\n      regressionPass: regression ? regression.pass : null,\n      falseVerified: turn?.outcome === \"VERIFIED\" && !hidden.pass,\n      contaminated,\n      tokens: agent.json?.tokenStats ?? null,\n      ...(hardening ? { hardened: { baseline: hardening.baseline, applied: hardening.applied.length, discarded: hardening.discarded, configChanges: hardening.configChanges } } : {}),\n      ...(t3 ? { t3 } : {}),\n      model,\n      resources: config.resources ? { agent: agent.resources, hidden: hidden.resources ?? null, regression: regression?.resources ?? null, ...(t3BaselineResources.length ? { t3Baseline: t3BaselineResources } : {}) } : null,\n      logs: saveLogs(task, run, agent, hidden, regression),\n    };\n  } catch (err) {\n    return { ...base, wallMs: 0, error: String(err?.message ?? err), hiddenPass: false, regressionPass: null, falseVerified: false, claimedComplete: false, claimedVerified: false };\n  } finally {\n    if (!args.keep) {\n      for (const dir of checkDirs) fs.rmSync(dir, { recursive: true, force: true });\n      fs.rmSync(ws, { recursive: true, force: true });\n      fs.rmSync(home, { recursive: true, force: true });\n    }\n  }\n}\n\nasync function prepareWorkspace(task, ws) {\n  if (task.fixture) {\n    const fixture = confinedPath(task.dir, task.fixture);\n    assertNoSymlinks(fixture);\n    fs.cpSync(fixture, ws, { recursive: true, verbatimSymlinks: true });\n    sh(\"git\", [\"init\", \"-q\"], ws);\n    sh(\"git\", [\"add\", \"-A\"], ws);\n    sh(\"git\", [\"-c\", \"user.name=eval\", \"-c\", \"user.email=eval@example.invalid\", \"commit\", \"-qm\", \"fixture\"], ws);\n  } else if (task.repo) {\n    const cache = path.join(ROOT, \"eval/.cache\", createHash(\"sha256\").update(task.repo.url).digest(\"hex\").slice(0, 16));\n    if (!fs.existsSync(cache)) sh(\"git\", [\"clone\", \"-q\", \"--no-checkout\", task.repo.url, cache], ROOT);\n    const object = `${task.repo.commit}^{commit}`;\n    if (sh(\"git\", [\"-C\", cache, \"cat-file\", \"-e\", object], ROOT, true) !== 0) sh(\"git\", [\"-C\", cache, \"fetch\", \"-q\", \"origin\", task.repo.commit], ROOT);\n    stageRepoWorkspace(cache, task.repo.commit, ws);\n  } else throw new Error(`task ${task.id} has neither fixture nor repo`);\n  for (const cmd of task.setup ?? []) {\n    const result = await runIsolated(cmd, { cwd: ws, home: true, timeoutSec: task.setupTimeoutSec ?? 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() });\n    if (result.containmentProblem) throw new Error(`isolated setup containment failed for ${task.id}: ${result.containmentProblem}`);\n    if (result.status !== 0 || result.timedOut || result.overflow) throw new Error(`isolated setup failed for ${task.id}: ${result.timedOut ? \"timeout\" : result.overflow ? \"output limit\" : `exit ${result.status}`}`);\n  }\n}\n\n/**\n * The command line and environment for one agent run. Each agent gets a fresh HOME holding only its gateway settings\n * (no operator plugins, extensions or memory), the same endpoint and model, and the key through its environment.\n */\nfunction effectiveBudget(task, config) {\n  return { steps: task.steps ?? config.steps ?? 300, minutes: task.minutes ?? config.minutes ?? 120 };\n}\n\nasync function resolveAgentIdentity(config) {\n  const agent = config.agent ?? \"nexus\";\n  let command;\n  let argsPrefix = [];\n  if (agent === \"nexus\") {\n    if (config.qualification === true) {\n      if (typeof config.nexusExecutable !== \"string\" || !path.isAbsolute(config.nexusExecutable)) {\n        return { record: null, problem: \"qualification requires nexusExecutable to be the absolute path of the installed RC\" };\n      }\n      if (typeof config.expectedAgentVersion !== \"string\" || !config.expectedAgentVersion.trim()) {\n        return { record: null, problem: \"qualification requires expectedAgentVersion to pin the installed RC\" };\n      }\n      if (!/^[0-9a-f]{64}$/.test(config.nexusPackageSha256 ?? \"\")) {\n        return { record: null, problem: \"qualification requires nexusPackageSha256 from the installed RC release asset\" };\n      }\n      command = path.resolve(config.nexusExecutable);\n      try {\n        if (fs.realpathSync(command) === fs.realpathSync(path.join(ROOT, \"cli/dist/index.js\"))) {\n          return { record: null, problem: \"qualification must use the installed RC, not the checkout cli/dist/index.js\" };\n        }\n      } catch {}\n    } else {\n      command = process.execPath;\n      argsPrefix = [path.join(ROOT, \"cli/dist/index.js\")];\n    }\n  } else if ([\"goose\", \"opencode\", \"aider\"].includes(agent)) {\n    command = resolvePathExecutable(agent, { ...process.env, ...(config.env ?? {}) }) ?? agent;\n  } else {\n    return { record: null, problem: `eval agent '${agent}' has no versioned adapter` };\n  }\n\n  const required = config.qualification === true || config.expectedAgentVersion !== undefined;\n  let candidatePath;\n  try { candidatePath = fs.realpathSync(command); }\n  catch (error) { return { record: null, problem: required ? `could not identify ${agent} executable (${error.message})` : null, command, argsPrefix }; }\n  argsPrefix = argsPrefix.map((item) => path.isAbsolute(item) ? fs.realpathSync(item) : item);\n  // Version probes execute candidate-controlled code and must share the enforced writable-storage cap.\n  const probeWorkspace = fs.mkdtempSync(path.join(config.resources?.workspaceRoot ?? os.tmpdir(), \"nexus-eval-version-workspace-\"));\n  let probe;\n  try {\n    if (config.runAs) grantRunAsAccess(config.runAs, [probeWorkspace]);\n    const runtimePaths = [candidatePath, ...argsPrefix.filter((item) => path.isAbsolute(item)).map((item) => fs.realpathSync(item))];\n    const isCheckoutNexus = agent === \"nexus\" && argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\");\n    if (isCheckoutNexus) {\n      runtimePaths.push(path.join(ROOT, \"cli/dist\"));\n      const modules = path.join(ROOT, \"cli/node_modules\");\n      if (fs.existsSync(modules)) {\n        for (const entry of fs.readdirSync(modules, { withFileTypes: true })) {\n          if (entry.isDirectory() && entry.name !== \".bin\") runtimePaths.push(path.join(modules, entry.name));\n        }\n      }\n      const coreBinary = path.join(ROOT, \"core/target/release/harness-core\");\n      if (fs.existsSync(coreBinary)) runtimePaths.push(coreBinary);\n    }\n    const allowedRoots = [...new Set([...(config.sandboxRuntimeRoots ?? []), ...(isCheckoutNexus ? [ROOT] : [])])];\n    const spec = isolatedProcessArgv({\n      cwd: probeWorkspace,\n      command: candidatePath,\n      argv: [...argsPrefix, \"--version\"],\n      readOnlyPaths: [...new Set(runtimePaths)],\n      allowedRoots,\n      allowedFiles: [candidatePath, ...argsPrefix.filter((item) => path.isAbsolute(item))],\n      timeoutMs: 5000,\n      protectedCorpusPaths: protectedCorpusPathsForRun(),\n    });\n    const wrapped = config.runAs ? asUserSpec(config.runAs, spec) : spec;\n    probe = await runIsolatedProcess(wrapped, { outputLimit: 4096, resources: config.resources ?? null });\n  } finally {\n    fs.rmSync(probeWorkspace, { recursive: true, force: true });\n  }\n  const output = `${probe?.stdout ?? \"\"}${probe?.stderr ?? \"\"}`.trim();\n  const version = output.split(/\\r?\\n/, 1)[0]?.trim().slice(0, 200) || null;\n  if (probe?.containmentProblem || probe?.error || probe?.status !== 0 || probe?.timedOut || probe?.overflow || !version) {\n    const detail = output ? `; output=${JSON.stringify(output.slice(0, 600))}` : \"\";\n    const reason = probe?.containmentProblem ?? probe?.error ?? (probe?.timedOut ? \"timeout\" : probe?.overflow ? \"output limit exceeded\" : `exit ${probe?.status ?? \"unknown\"}${detail}`);\n    return { record: null, problem: required ? `could not identify ${agent} version (${reason})` : null, command, argsPrefix };\n  }\n\n  const versionMatch = /\\bv?(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?=\\b)/.exec(version);\n  const expected = typeof config.expectedAgentVersion === \"string\" ? config.expectedAgentVersion.replace(/^v/, \"\") : null;\n  if (expected && versionMatch?.[1] !== expected) {\n    const label = agent === \"nexus\" ? \"installed Nexus\" : agent;\n    const kind = agent === \"nexus\" ? \"expected RC\" : \"expected version\";\n    return { record: null, problem: `${label} version ${versionMatch?.[1] ?? version} does not match ${kind} ${expected}`, command, argsPrefix };\n  }\n\n  let executablePath;\n  let executableSha256;\n  try {\n    executablePath = agent === \"nexus\" && argsPrefix.length ? fs.realpathSync(argsPrefix[0]) : fs.realpathSync(command);\n    executableSha256 = await sha256File(executablePath);\n  } catch (err) {\n    if (required) return { record: null, problem: `could not hash ${agent} executable (${err.message})`, command, argsPrefix };\n  }\n  return {\n    record: {\n      agent,\n      version,\n      ...(executablePath ? { executablePath } : {}),\n      ...(executableSha256 ? { executableSha256 } : {}),\n      ...(agent === \"nexus\" && config.qualification === true ? { packageSha256: config.nexusPackageSha256 } : {}),\n    },\n    command,\n    argsPrefix,\n  };\n}\n\nfunction resolvePathExecutable(command, env) {\n  for (const directory of (env.PATH ?? \"\").split(path.delimiter).filter(Boolean)) {\n    const candidate = path.resolve(directory, command);\n    try {\n      if (fs.statSync(candidate).isFile()) return fs.realpathSync(candidate);\n    } catch {}\n  }\n  return null;\n}\n\nfunction sha256File(file) {\n  return new Promise((resolve, reject) => {\n    const hash = createHash(\"sha256\");\n    const stream = fs.createReadStream(file);\n    stream.on(\"data\", (chunk) => hash.update(chunk));\n    stream.on(\"error\", reject);\n    stream.on(\"end\", () => resolve(hash.digest(\"hex\")));\n  });\n}\n\nfunction agentCommand(task, ws, home, budget, agentIdentity, localToken) {\n  const sampling = config.sampling ?? { temperature: 0.2 };\n  const limits = config.limits ?? { context: 65536, output: 8192 };\n  const forbiddenEnv = Object.keys(config.env ?? {}).find((key) => /KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL/i.test(key));\n  if (forbiddenEnv) throw new Error(`candidate configuration may not contain credential-like environment key ${forbiddenEnv}`);\n  const ep = \"http://127.0.0.1:40127/v1\";\n  const env = {\n    PATH: config.env?.PATH ?? \"/usr/bin:/bin\", LANG: config.env?.LANG ?? \"C.UTF-8\", LC_ALL: config.env?.LC_ALL ?? \"C.UTF-8\",\n    TERM: config.env?.TERM ?? \"dumb\", HOME: \"/home/eval\", PWD: \"/workspace\", CI: \"1\",\n    LOCAL_LLM_API_KEY: localToken, OPENAI_API_KEY: localToken, GW_KEY: localToken,\n    XDG_CONFIG_HOME: \"/home/eval/.config\", XDG_DATA_HOME: \"/home/eval/.local/share\", XDG_STATE_HOME: \"/home/eval/.local/state\",\n  };\n  const agent = config.agent ?? \"nexus\";\n  if (agent === \"nexus\") {\n    env.LOCAL_LLM_ENDPOINT = ep;\n    const contextArgs = nexusContextLimitArgs(config, limits.context);\n    if (task.tier === \"T3\") {\n      // T3 drives the sidecar, the operator channel that carries steering, with the same model, budgets and limits.\n      const checkout = agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\");\n      // An installed package is <package>/bin/nexus with the sidecar at <package>/lib/cli/dist/sidecar.js.\n      const packageDir = checkout ? null : path.dirname(path.dirname(fs.realpathSync(agentIdentity.command)));\n      const sidecar = checkout ? path.join(ROOT, \"cli/dist/sidecar.js\") : path.join(packageDir, \"lib/cli/dist/sidecar.js\");\n      if (!fs.existsSync(sidecar)) throw new Error(`T3 needs the Nexus sidecar at ${sidecar}`);\n      if (packageDir) {\n        // The launcher is bypassed, so the package itself must be mounted: it has to sit under sandboxRuntimeRoots.\n        const roots = (config.sandboxRuntimeRoots ?? []).flatMap((root) => { try { return [fs.realpathSync(root)]; } catch { return []; } });\n        if (!roots.some((root) => packageDir === root || packageDir.startsWith(`${root}${path.sep}`))) throw new Error(`T3 runs the sidecar from ${packageDir}, which must be under sandboxRuntimeRoots`);\n        env.NEXUS_HOME = packageDir;\n      }\n      const sidecarArgs = [sidecar, \"--yes\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? [])];\n      return checkout ? { cmd: process.execPath, argv: sidecarArgs, env, protocol: true } : { cmd: \"/usr/bin/env\", argv: [\"node\", ...sidecarArgs], env, protocol: true };\n    }\n    return { cmd: agentIdentity.command, argv: [...agentIdentity.argsPrefix, \"run\", \"--yes\", \"--json\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? []), task.objective], env };\n  }\n  if (agent === \"aider\") {\n    return { cmd: agentIdentity.command, argv: [\"--model\", `openai/${config.model}`, \"--openai-api-base\", ep, \"--yes-always\", \"--no-auto-commits\", \"--no-dirty-commits\", \"--no-gitignore\", \"--no-show-model-warnings\", \"--no-check-update\", \"--analytics-disable\", \"--no-pretty\", \"--no-fancy-input\", ...(config.args ?? []), \"--message\", task.objective], env };\n  }\n  if (agent === \"opencode\") {\n    const dir = path.join(home, \".config/opencode\");\n    fs.mkdirSync(dir, { recursive: true });\n    const modelOptions = { temperature: sampling.temperature, ...(sampling.seed !== undefined ? { seed: sampling.seed } : {}) };\n    fs.writeFileSync(path.join(dir, \"opencode.json\"), JSON.stringify({\n      $schema: \"https://opencode.ai/config.json\",\n      autoupdate: false,\n      share: \"disabled\",\n      permission: { edit: \"allow\", bash: \"allow\", webfetch: \"deny\" },\n      agent: { \"nexus-eval\": { mode: \"primary\", steps: budget.steps } },\n      provider: { gw: { npm: \"@ai-sdk/openai-compatible\", name: \"gateway\", options: { baseURL: ep, apiKey: \"{env:GW_KEY}\" }, models: { [config.model]: { name: config.model, limit: limits, options: modelOptions } } } },\n      model: `gw/${config.model}`,\n    }, null, 2));\n    // Provider packages are cached across runs (not per run): the cache holds code, not state.\n    env.XDG_CACHE_HOME = path.join(home, \".cache\");\n    return { cmd: agentIdentity.command, argv: [\"run\", \"--agent\", \"nexus-eval\", \"--model\", `gw/${config.model}`, ...(config.args ?? []), task.objective], env };\n  }\n  if (agent === \"goose\") {\n    const u = new URL(ep);\n    Object.assign(env, { GOOSE_PROVIDER: \"openai\", GOOSE_MODEL: config.model, OPENAI_HOST: u.origin, OPENAI_BASE_PATH: `${u.pathname.replace(/^\\/|\\/$/g, \"\")}/chat/completions`, GOOSE_MODE: \"auto\", GOOSE_DISABLE_KEYRING: \"1\", GOOSE_CONTEXT_LIMIT: String(limits.context), GOOSE_MAX_TOKENS: String(limits.output), GOOSE_MAX_TURNS: String(budget.steps), GOOSE_TEMPERATURE: String(sampling.temperature) });\n// Kernel-enforced resource contract for task-controlled executions (eval/README.md, \"Resource contract\").\n// Each execution runs in its own delegated transient systemd --user scope under eval/cgroup_supervisor.mjs, which\n// applies cgroup v2 cpu.max, memory.max (swap 0) and pids.max to a payload leaf, verifies them, and kills the whole\n// cgroup afterwards. Workspaces and homes live on a dedicated size-capped tmpfs (storageBytes): that cap bounds\n// everything a run keeps on disk across phases, and each phase's writes are additionally charged to its memory.max.\nimport { spawn, spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst SYSTEMD_RUN = \"/usr/bin/systemd-run\";\nconst SUPERVISOR = fileURLToPath(new URL(\"./cgroup_supervisor.mjs\", import.meta.url));\nconst TMPFS_MAGIC = 0x01021994;\n\n/** Null when `resources` is a complete, sane contract; otherwise why it is not. */\nexport function resourceConfigProblem(resources) {\n  if (!resources || typeof resources !== \"object\") return \"resources must set cpuPercent, memoryBytes, tasks, storageBytes and workspaceRoot\";\n  const { cpuPercent, memoryBytes, tasks, storageBytes, workspaceRoot } = resources;\n  if (!Number.isInteger(cpuPercent) || cpuPercent < 10 || cpuPercent > 100 * 1024) return \"resources.cpuPercent must be an integer from 10 to 102400\";\n  if (!Number.isInteger(memoryBytes) || memoryBytes < 64 * 1024 * 1024 || memoryBytes % 4096 !== 0) return \"resources.memoryBytes must be a multiple of 4096 of at least 64 MiB\";\n  if (!Number.isInteger(tasks) || tasks < 8 || tasks > 1 << 20) return \"resources.tasks must be an integer from 8 to 1048576\";\n  if (!Number.isInteger(storageBytes) || storageBytes < 64 * 1024 * 1024) return \"resources.storageBytes must be an integer of at least 64 MiB\";\n  if (typeof workspaceRoot !== \"string\" || !path.isAbsolute(workspaceRoot)) return \"resources.workspaceRoot must be an absolute path\";\n  let stat;\n  try { stat = fs.statfsSync(workspaceRoot); }\n  catch { return \"resources.workspaceRoot is unavailable\"; }\n  if (stat.type !== TMPFS_MAGIC) return \"resources.workspaceRoot must be on a tmpfs so candidate writes are charged to the run's memory limit\";\n  const mountProblem = dedicatedTmpfsMountProblem(workspaceRoot);\n  if (mountProblem) return mountProblem;\n  if (stat.blocks * stat.bsize > storageBytes) return `resources.workspaceRoot tmpfs is ${stat.blocks * stat.bsize} bytes; mount a dedicated tmpfs with size<=storageBytes (${storageBytes})`;\n  return null;\n}\n\n/** A subdirectory of a shared tmpfs (including /dev/shm) does not enforce a per-run storage cap. */\nexport function dedicatedTmpfsMountProblem(workspaceRoot, mountInfoText = null) {\n  let lines;\n  try { lines = (mountInfoText ?? fs.readFileSync(\"/proc/self/mountinfo\", \"utf8\")).split(\"\\n\"); }\n  catch { return \"resources.workspaceRoot mount table is unavailable; refusing unverified workspace storage limits\"; }\n  const decode = (value) => value.replace(/\\\\([0-7]{3})/g, (_match, octal) => String.fromCharCode(Number.parseInt(octal, 8)));\n  const expected = path.resolve(workspaceRoot);\n  const matching = lines.filter((entry) => {\n    const fields = entry.split(\" \");\n    return fields.length > 6 && decode(fields[4]) === expected;\n  });\n  if (matching.len…2027 tokens truncated…the host evaluator keeps expected values in its process and launches the candidate runtime separately for each\ninput using a fresh top-level Bubblewrap boundary. The candidate receives one input on stdin and returns one JSON value on\nstdout. Its workspace is read-only; private oracle files are not mounted. Candidate output and diagnostics are discarded,\nand result logs contain only case counts and failed indexes. Supported runtimes are explicitly allowlisted (`node`,\n`python3`); the only argument is a validated relative candidate entrypoint (no runtime flags, eval expressions, or extra\narguments), and per-case/aggregate time and output bounds are enforced. Oracle files must be outside the copied fixture.\nAbsolute paths, traversal, symlinks and unsupported fixture entries are rejected. `manifest.json` records the harness source-file hashes, model fingerprint, corpus/task\nhashes when qualification is configured, executable version, budgets, host and Node version. Each result records the\nexecutable version and effective step/minute budget; per-run logs go to `logs/<task>-<run>/`. The runner refuses an\nexisting output directory so a retry cannot append to or replace prior evidence.\n\nQualification runs require `nexusExecutable` to name the absolute path of the installed RC,\n`expectedAgentVersion` to pin its version, and `nexusPackageSha256` to record the expected release-asset digest from checksum verification. The runner checks `nexus --version` and refuses the checkout\n`cli/dist/index.js` or a version mismatch before starting an agent. Peer versions are read using each adapter's\n`--version` command inside the same Bubblewrap filesystem/network boundary, with a cleared environment and bounded\noutput/time; executable paths and SHA-256 hashes are archived alongside the RC package\ndigest. `score.mjs --pairs` takes exactly the Nexus,\nGoose and OpenCode result files and refuses mismatched model fingerprints, sampling declarations, context/output\nlimits, explicit per-task request and aggregate requested-output ceilings, run pairs, executable identities, or\neffective step/minute budgets. The proxy permits only model-catalog and inference routes, strips client-supplied\nauthorization and control-plane headers, and enforces configured request/body/output ceilings. These are requested\ncompletion-token ceilings, not exact usage accounting. It reports peer hidden-test results\nseparately; scores are never combined. The Nexus adapter passes the recorded temperature and step/minute limits;\nOpenCode receives a primary evaluation agent with the recorded step limit, temperature and seed; Goose receives the\nmatching `--max-turns`, context/output limits and temperature settings. Qualification mode currently requires\n`sampling.temperature` to be `0` across all three adapters; seed metadata remains recorded when configured.\n\n## Task format (`eval/tasks/<id>/task.json`)\n\n| Field | Meaning |\n|---|---|\n| `id`, `tier` | T1 smoke (scripted model, CI), T2 standard, T3 long-task, T4 fault-injected |\n| `fixture` or `repo` | a directory in the task, or `{ \"url\", \"commit\" }` (external repositories at pinned commits) |\n| `setup` | shell commands run in the workspace before the agent (e.g. `npm ci`) |\n| `objective` | the operator text given to the agent |\n| `steps`, `minutes` | budgets (defaults from the configuration: 300 steps, 120 min) |\n| `hidden` | `{ dir, into, command, timeoutSec }` — tests the agent never sees; pass = artifact correct |\n| `regression` | `{ command }` — the repository's own suite after the run |\n\n## Scores\n\ncompletion claimed · artifact correct (hidden tests) · false VERIFIED (VERIFIED while hidden tests fail) · regressions\nintroduced · timed out / harness errors · wall time, steps, tokens (median). Context qualifier (`contextNotRetained`) is\nrecorded per run.\n\n## Scoring integrity\n\n- **Model proxy.** Every agent reaches the model through a per-run forwarder (`eval/model_proxy.mjs`) that `run.mjs`\n  starts. Each record carries `model: { requests, answered, upstreamFailures, firstRequestAt, firstAnswerAt }`. Set\n  `\"proxy\": false` in a config to connect agents directly; such runs are then scored only by the legacy rule below.\n- **Infrastructure reruns** (`eval/infra.mjs`). A run is rerun only when the model never answered *and* the endpoint\n  was observed failing, or when the harness itself errored. The rule is the same for every agent. A run in which the\n  model answered is always scored: a crash is a failure (and counts towards the crash rate), not a rerun. Records from\n  before the proxy fall back to each agent's own connection-failure message, and the script says how many it judged\n  that way.\n- **Contamination.** Contaminated runs (the task directory changed, or its path appeared in the agent's output) are\n  left out of pooled pass rates and counted separately.\n- **Reruns are listed.** `score.mjs` lists every replaced run with what it showed and what the rerun showed.\n- **Pooled metrics.** Pooled rows report crash rate, regressions, tokens per correct result and wall seconds per\n  correct result. The cost of failed runs counts towards these.\n\n## Fault injection (T4)\n\nA task or config may list `faults: [{ kind, atRequest }]`. The run's model proxy then injects that fault into the Nth\nchat request (counted from 1):\n\n| kind | Fault |\n|---|---|\n| `refuse` | The connection drops without an answer |\n| `overloaded` | 503 with `Retry-After: 1` |\n| `stream_cut` | The stream is cut after its first tool-call fragment |\n| `truncate` | `finish_reason` becomes `length` |\n| `context_overflow` | llama.cpp's HTTP 400 `exceed_context_size_error` |\n| `malformed_tool_json` | The first tool call's arguments are no longer valid JSON |\n\nWhat was injected is recorded in `model.faultsInjected`. Such runs are never treated as infrastructure reruns.\n`score.mjs` reports, per fault kind:\n\n- runs;\n- **truthful** (the run ended with its own result, did not hang past its budget, and never claimed VERIFIED while the\n  hidden tests failed);\n- **recovered** (the hidden tests pass);\n- hung past budget.\n\nThe remaining T4 classes come from task fixtures (a hanging test command, a full disk) and from the SIGTERM-then-resume\nrunner case. `make test` includes a T4 smoke test with two injected faults (`cli/test/eval_harness.test.ts`).\n\n## Qualification runs\n\nA config with `\"qualification\": true` is the v1.0.0 evidence run (docs/v1.0.0/ACCEPTANCE.md §6). `run.mjs` refuses to start\none, before any agent runs, unless every item below holds:\n\n- **Tasks are well formed** (`eval/validate.mjs`): one source (fixture, or a repo pinned to a full commit id), an isolated\n  `blackbox-v1` hidden oracle, and `class` (bugfix · feature · refactor · debug) and `difficulty` (easy · medium · hard). Development runs check\n  everything except class and difficulty.\n- **The model is identified, not just named.** `fingerprint: { weightsSha256, serverBuild }` and\n  `sampling: { temperature, seed }` are set in the config, and the endpoint lists the model. The fingerprint (with the\n  listed owner and context) is written to `manifest.json`.\n- **Hidden tests are out of the agent's reach.** `runAs` names a separate evaluator user. Candidate execution occurs\n  inside the Bubblewrap mount namespace and does not bind the task store or validator sources; its `HOME`, `/tmp`,\n  `/run`, and network namespace are isolated. Runtime files are explicit read-only binds. The harness grants the\n  evaluator UID ACL access only to the disposable workspace, home and per-run proxy directory. Before qualification,\n  verify the account and these existing operating-system permissions through the approved local setup procedure:\n  1. `sudo useradd --system --create-home nexus-eval`\n  2. A narrowly constrained sudoers rule permitting only the required Bubblewrap invocation as `nexus-eval`; do not\n     grant arbitrary `env` command execution.\n  3. Keep task stores unreadable to the evaluator account; the runner does not mount them into the candidate namespace.\n  4. A Nexus install, Node and the peer agents that `nexus-eval` can read and execute.\n\n  Development runs may omit `runAs`; Bubblewrap isolation still applies. Qualification is refused without a separate\n  evaluator account, `setfacl`, explicit `sandboxRuntimeRoots`, and read-only `sandboxRuntimePaths` contained by those\n  roots. Protected roots such as `/etc`, `/dev`, `/proc`, `/sys`, `/run`, `/var`, `/tmp`, and sensitive user-cache paths\n  are rejected. No setup procedure is applied by the runner.\n\n- **Repository workspaces carry no history beyond the pinned commit.** `eval/workspace.mjs` stages a repo task as a\n  fresh `git init` that fetches only the pinned commit and its ancestors from the local cache (`--no-tags`, no\n  FETCH_HEAD), then checks out that commit detached. There is no `--shared` clone, alternates link, remote, tag or\n  descendant object, so the upstream fix that follows a held-out baseline is not reachable from the workspace. Staging\n  verifies this and refuses the run otherwise.\n\n- **Corpus binding is integrity evidence, not approval authentication.** The qualification config pins the exact\n  corpus-manifest SHA-256, and the run manifest repeats the selected task hashes. The v1 manifest binds every task's\n  full task tree in row `sha256`. The heldout-v2 manifest binds each task's raw `task.json` and hidden-directory digest for\n  pinned-repository tasks; a local fixture additionally requires a full-tree `sha256` because those two v2 digests do\n  not cover fixture files. The frozen config carries `corpusCustody: { custodian, approvedAt, reportPath, reportSha256 }`\n  and may also name `storeRoot`, `validatorPath`, `referencePath`, and `authorLogPath`; the report path and optional\n  private paths are protected from runtime mounts. These values and the manifest's custody labels are claims, not\n  signatures. Independent custody acceptance, pre-RC commit timing, and configuration freeze must be verified and\n  archived by the acceptance reviewer before any qualification run. The current candidate task package has not been\n  independently accepted.\n\n### Isolation limits\n\nBubblewrap plus the current runner enforces separate mount/user/PID/network namespaces, a cleared task-command\nenvironment, a bounded wall clock, bounded captured output, per-run process-group teardown, and read-only runtime\nbinds. Black-box qualification keeps oracle expectations outside candidate namespaces. Legacy hidden commands share a\nprocess with candidate code and are rejected during qualification preflight. The hardened legacy path below is only for\ndevelopment and pilot scoring; it is not qualification evidence. Aggregate CPU, memory, process-count and\nwritable-storage limits come from the resource contract below, not from request/token ceilings. Appliance-specific\nBubblewrap enforcement is a separate, unverified condition.\n\n### Hardened legacy hidden tests (development and pilot only)\n\nLegacy tasks use `hidden: { dir, command }` (for example `pytest` or `go test` over copied test files) and run candidate\ncode in the same process as the oracle. They do not meet the qualification boundary, even when hardened. Qualification\npreflight accepts only the isolated `blackbox-v1` protocol. Any legacy task in a qualification corpus must be replaced\nor converted by the authorized custodian, with custody checks repeated and a new immutable manifest identity recorded.\nDevelopment configs may opt into the hardened diagnostic path with `\"hardenedChecks\": true`.\n\n1. The agent's workspace is never tested, and nothing runs git or any other program against it after the agent ran.\n   An agent-written `.git/config` or `.gitattributes` would otherwise run commands as the harness user. The baseline\n   tree hash is taken before the agent starts. The harness then stages the task again (the same pinned commit or\n   fixture, the same setup commands) into a fresh workspace, and checks that its tree equals that baseline.\n2. The agent's changes are found by walking both trees and comparing bytes and executable bits\n   (`eval/hardened_check.mjs`). Only an allowlist crosses over:\n   - Only **source files** (`.py`, the `.js`/`.ts` family, `.go`, `.rs`) and the manifests `package.json`,\n     `pyproject.toml`, `Cargo.toml`, `go.mod` and `go.sum` may be added, changed or deleted. Every other file type,\n     including test data, keeps its baseline content.\n   - A new Python file may only join a regular package that already exists, meaning a directory with `__init__.py` in\n     the baseline. It may not take a name that would shadow the test runner or the standard library\n     (`pytest.py`, `json.py`, …). Namespace packages without `__init__.py` cannot gain new modules; that is a\n     fairness cost.\n   - **Always dropped:**\n     - VCS metadata and dependency trees or caches: `.git`, `node_modules`, `.venv`, `site-packages`,\n       `__pycache__`, `vendor`, `target`, `.yarn`, `.cargo`, `.github`;\n     - test files and directories;\n     - test data: `testdata/`, `fixtures/`, `__snapshots__/`, `snapshots/`, `golden/`, mocks, `*.golden`, `*.snap`;\n     - test-runner configuration and setup files;\n     - interpreter and package-manager hooks: `sitecustomize.py`, `.pth`, `.npmrc`, `.yarnrc*`, `.pnpmfile.cjs`,\n       `go.work`, `rust-toolchain*`, `build.rs`;\n     - `Makefile`, `.env*`, `.gitattributes` and `.gitignore`;\n     - symlinks, any path that passes through a symlink in the fresh tree, and files over 2 MiB.\n\n     Dependency trees therefore always come from setup, never from the agent.\n   - **Manifests** may change only plain dependency or metadata entries. Any other change refuses both checks, and so\n     does a deleted manifest or a new one (a new `go.mod` or `package.json` moves module or root boundaries). In TOML,\n     every line starting with `[` is a section boundary, keyed by its exact text. An unrecognised header, a `[[…]]`\n     table, or a header with a comment therefore cannot be folded into an allowed section:\n     - `package.json`: anything but the dependency maps and metadata, or a `file:`/`git:`/path dependency;\n     - `pyproject.toml`: anything outside `[project]`;\n     - `Cargo.toml`: anything outside `[dependencies]`/`[dependencies.<name>]`, or a `path`, `git` or `registry`\n       source. Adding `[dev-dependencies]` or `[build-dependencies]` is refused, which costs legitimate test-only\n       dependency additions;\n     - `go.mod`: anything outside its `require` lines and blocks, including entries inside an existing `replace (…)`.\n3. Anything the agent left at the oracle's path is removed. The hidden command then runs with the hidden directory\n   bind-mounted **read-only**. The regression\n   command runs in a separate byte-identical copy, so candidate code executed by one check cannot prepare the other.\n4. In development/pilot runs, hidden-test output is kept only as a status, byte count and SHA-256, so diagnostic\n   records do not disclose the tests. Each run record carries\n   `hardened: { baseline, applied, discarded, configChanges }`.\n\nThis legacy hardening path supports development and pilot scoring only. Candidate source still executes in the same\nruntime as its legacy validator, so it can inspect or alter validator state; file hiding and a fresh workspace do not\nprovide independent qualification. `qualification: true` rejects every legacy hidden command before any candidate\nstarts. Do not relabel legacy evidence as qualification evidence.\n\nThe legacy output checks below are diagnostic safeguards for development scoring, not acceptance evidence. Qualification\nkeeps black-box expected values in the evaluator process and runs candidate code in a separate Bubblewrap process.\n- Fairness cost: a real source directory named `vendor/` or `target/` is skipped like a dependency tree, so the\n  agent's changes there are dropped. The `npm:` alias form of a dependency spec is not refused; setup is not re-run\n  after the copy, so it cannot install anything.\n\nThe sealed corpus is bound through its own manifest schema (`eval/heldout-manifest.json`, `hash_scheme`). The runner\nrecomputes each selected task's `task_sha256` (raw `task.json`) and `hidden_sha256`. The latter is computed over the\nregular files of `hidden.dir`, with `/`-separated relative paths sorted byte-wise, each line `<path>  <sha256>\\n`. For\npinned-repository tasks these bind the task declaration and hidden tests while the repository commit pins the source.\nA task using a local `fixture` must also carry `sha256` for the full task tree; without it, fixture content outside\n`task.json` and `hidden.dir` would be unbound. The selected population must equal the manifest's. The manifest carries\nno custody fields, so the frozen config states `corpusCustody: { custodian, approvedAt, reportPath, reportSha256 }`;\noptional private paths are `storeRoot`, `validatorPath`, `referencePath`, and `authorLogPath`. The acceptance reviewer\nchecks the report against its digest and verifies custody claims independently.\n\n### Resource contract\n\nA config's `resources` object — `{ \"cpuPercent\", \"memoryBytes\", \"tasks\", \"storageBytes\", \"workspaceRoot\" }` — applies to every\ntask-controlled execution: setup commands, the candidate agent, legacy hidden and regression commands, every black-box\noracle case and the agent version probe. Qualification refuses to start without it.\n\n- Each execution runs under `eval/cgroup_supervisor.mjs` as the only process of its own delegated transient\n  `systemd-run --user --scope`. The supervisor writes cgroup v2 `cpu.max` (`cpuPercent`% of one CPU), `memory.max`\n  (`memoryBytes`), `memory.swap.max` (0), `memory.oom.group` (1) and `pids.max` (`tasks`) on a `payload` leaf, reads them back, and refuses to\n  run on any mismatch. The command joins that leaf before `exec`, so nothing task-controlled runs outside the limits.\n  The limits are aggregate over the whole process tree, whatever its uid (`runAs`), session or process group.\n- `workspaceRoot` must itself be a dedicated tmpfs mount, not a directory on a shared mount or a bind mount. It must be\n  owned by the evaluator harness uid, with owner `rwx` and no group/other read or write permission. Group/other execute\n  permission is allowed so a separate evaluator uid can traverse to its per-run ACL-protected directory. For example:\n  `mount -t tmpfs -o size=<storageBytes>,mode=0711,uid=<harness-uid>,gid=<harness-gid> tmpfs <dir>`.\n  The preflight checks `/proc/self/mountinfo`, the mount root and options, the effective tmpfs size, and the cgroup\n  probe. A shared tmpfs such as `/dev/shm` fails even when `storageBytes` is set to its full size. Workspaces and homes\n  are created on this mount. Its filesystem size hard-caps files retained across phases; writes beyond it fail with\n  `ENOSPC`. Runs are serial and each workspace is removed afterwards; `--keep` is refused under the contract.\n- Within that cap, tmpfs pages, including the sandbox's own `/tmp`, are charged to the writing phase's memory cgroup and\n  cannot be swapped. A phase therefore also cannot hold more than `memoryBytes` of memory and new writes together. When\n  it reaches that bound the whole phase is OOM-killed (`memory.oom.group`), and this is recorded. When a phase's cgroup\n  is removed, the kernel moves its charges to the unlimited parent cgroup. Later phases get their own `memoryBytes`,\n  which is why the filesystem cap, not the memory limit, is the cross-phase storage bound. An OOM in a hidden or\n  regression check is the candidate's outcome, a failed check, not an infrastructure error.\n- CPU is bounded in rate by `cpu.max` and in total by the phase's wall-clock timeout.\n- This contract is supported only on Linux with cgroup v2 CPU, memory and pids controllers, a delegated systemd user\neval/score.mjs:13:  \"hanging_test_command\",\neval/score.mjs:14:  \"full_disk\",\neval/score.mjs:17:  \"sigterm_resume\",\neval/score.mjs:21:const T4_RUNNER_CLASSES = new Set([\"hanging_test_command\", \"full_disk\", \"sigterm_resume\"]);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17211-7ad4-71c1-9c02-690a797dca89","create_time":1792915125.9215407}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
