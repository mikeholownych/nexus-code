\n  if (agent === \"nexus\") {\n    if (config.qualification === true) {\n      if (typeof config.nexusExecutable !== \"string\" || !path.isAbsolute(config.nexusExecutable)) {\n        return { record: null, problem: \"qualification requires nexusExecutable to be the absolute path of the installed RC\" };\n      }\n      if (typeof config.expectedAgentVersion !== \"string\" || !config.expectedAgentVersion.trim()) {\n        return { record: null, problem: \"qualification requires expectedAgentVersion to pin the installed RC\" };\n      }\n      if (!/^[0-9a-f]{64}$/.test(config.nexusPackageSha256 ?? \"\")) {\n        return { record: null, problem: \"qualification requires nexusPackageSha256 from the installed RC release asset\" };\n      }\n      command = path.resolve(config.nexusExecutable);\n      try {\n        if (fs.realpathSync(command) === fs.realpathSync(path.join(ROOT, \"cli/dist/index.js\"))) {\n          return { record: null, problem: \"qualification must use the installed RC, not the checkout cli/dist/index.js\" };\n        }\n      } catch {}\n    } else {\n      command = process.execPath;\n      argsPrefix = [path.join(ROOT, \"cli/dist/index.js\")];\n    }\n  } else if ([\"goose\", \"opencode\", \"aider\"].includes(agent)) {\n    command = resolvePathExecutable(agent, { ...process.env, ...(config.env ?? {}) }) ?? agent;\n  } else {\n    return { record: null, problem: `eval agent '${agent}' has no versioned adapter` };\n  }\n\n  const required = config.qualification === true || config.expectedAgentVersion !== undefined;\n  let candidatePath;\n  try { candidatePath = fs.realpathSync(command); }\n  catch (error) { return { record: null, problem: required ? `could not identify ${agent} executable (${error.message})` : null, command, argsPrefix }; }\n  argsPrefix = argsPrefix.map((item) => path.isAbsolute(item) ? fs.realpathSync(item) : item);\n  // Version probes execute candidate-controlled code and must share the enforced writable-storage cap.\n  const probeWorkspace = fs.mkdtempSync(path.join(config.resources?.workspaceRoot ?? os.tmpdir(), \"nexus-eval-version-workspace-\"));\n  let probe;\n  try {\n    if (config.runAs) grantRunAsAccess(config.runAs, [probeWorkspace]);\n    const runtimePaths = [candidatePath, ...argsPrefix.filter((item) => path.isAbsolute(item)).map((item) => fs.realpathSync(item))];\n    const isCheckoutNexus = agent === \"nexus\" && argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\");\n    if (isCheckoutNexus) {\n      runtimePaths.push(path.join(ROOT, \"cli/dist\"));\n      const modules = path.join(ROOT, \"cli/node_modules\");\n      if (fs.existsSync(modules)) {\n        for (const entry of fs.readdirSync(modules, { withFileTypes: true })) {\n          if (entry.isDirectory() && entry.name !== \".bin\") runtimePaths.push(path.join(modules, entry.name));\n        }\n      }\n      const coreBinary = path.join(ROOT, \"core/target/release/harness-core\");\n      if (fs.existsSync(coreBinary)) runtimePaths.push(coreBinary);\n    }\n    const allowedRoots = [...new Set([...(config.sandboxRuntimeRoots ?? []), ...(isCheckoutNexus ? [ROOT] : [])])];\n    const spec = isolatedProcessArgv({\n      cwd: probeWorkspace,\n      command: candidatePath,\n      argv: [...argsPrefix, \"--version\"],\n      readOnlyPaths: [...new Set(runtimePaths)],\n      allowedRoots,\n      allowedFiles: [candidatePath, ...argsPrefix.filter((item) => path.isAbsolute(item))],\n      timeoutMs: 5000,\n      protectedCorpusPaths: protectedCorpusPathsForRun(),\n    });\n    const wrapped = config.runAs ? asUserSpec(config.runAs, spec) : spec;\n    probe = await runIsolatedProcess(wrapped, { outputLimit: 4096, resources: config.resources ?? null });\n  } finally {\n    fs.rmSync(probeWorkspace, { recursive: true, force: true });\n  }\n  const output = `${probe?.stdout ?? \"\"}${probe?.stderr ?? \"\"}`.trim();\n  const version = output.split(/\\r?\\n/, 1)[0]?.trim().slice(0, 200) || null;\n  if (probe?.containmentProblem || probe?.error || probe?.status !== 0 || probe?.timedOut || probe?.overflow || !version) {\n    const detail = output ? `; output=${JSON.stringify(output.slice(0, 600))}` : \"\";\n    const reason = probe?.containmentProblem ?? probe?.error ?? (probe?.timedOut ? \"timeout\" : probe?.overflow ? \"output limit exceeded\" : `exit ${probe?.status ?? \"unknown\"}${detail}`);\n    return { record: null, problem: required ? `could not identify ${agent} version (${reason})` : null, command, argsPrefix };\n  }\n\n  const versionMatch = /\\bv?(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?=\\b)/.exec(version);\n  const expected = typeof config.expectedAgentVersion === \"string\" ? config.expectedAgentVersion.replace(/^v/, \"\") : null;\n  if (expected && versionMatch?.[1] !== expected) {\n    const label = agent === \"nexus\" ? \"installed Nexus\" : agent;\n    const kind = agent === \"nexus\" ? \"expected RC\" : \"expected version\";\n    return { record: null, problem: `${label} version ${versionMatch?.[1] ?? version} does not match ${kind} ${expected}`, command, argsPrefix };\n  }\n\n  let executablePath;\n  let executableSha256;\n  try {\n    executablePath = agent === \"nexus\" && argsPrefix.length ? fs.realpathSync(argsPrefix[0]) : fs.realpathSync(command);\n    executableSha256 = await sha256File(executablePath);\n  } catch (err) {\n    if (required) return { record: null, problem: `could not hash ${agent} executable (${err.message})`, command, argsPrefix };\n  }\n  return {\n    record: {\n      agent,\n      version,\n      ...(executablePath ? { executablePath } : {}),\n      ...(executableSha256 ? { executableSha256 } : {}),\n      ...(agent === \"nexus\" && config.qualification === true ? { packageSha256: config.nexusPackageSha256 } : {}),\n    },\n    command,\n    argsPrefix,\n  };\n}\n\nfunction resolvePathExecutable(command, env) {\n  for (const directory of (env.PATH ?? \"\").split(path.delimiter).filter(Boolean)) {\n    const candidate = path.resolve(directory, command);\n    try {\n      if (fs.statSync(candidate).isFile()) return fs.realpathSync(candidate);\n    } catch {}\n  }\n  return null;\n}\n\nfunction sha256File(file) {\n  return new Promise((resolve, reject) => {\n    const hash = createHash(\"sha256\");\n    const stream = fs.createReadStream(file);\n    stream.on(\"data\", (chunk) => hash.update(chunk));\n    stream.on(\"error\", reject);\n    stream.on(\"end\", () => resolve(hash.digest(\"hex\")));\n  });\n}\n\nfunction agentCommand(task, ws, home, budget, agentIdentity, localToken) {\n  const sampling = config.sampling ?? { temperature: 0.2 };\n  const limits = config.limits ?? { context: 65536, output: 8192 };\n  const forbiddenEnv = Object.keys(config.env ?? {}).find((key) => /KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL/i.test(key));\n  if (forbiddenEnv) throw new Error(`candidate configuration may not contain credential-like environment key ${forbiddenEnv}`);\n  const ep = \"http://127.0.0.1:40127/v1\";\n  const env = {\n    PATH: config.env?.PATH ?? \"/usr/bin:/bin\", LANG: config.env?.LANG ?? \"C.UTF-8\", LC_ALL: config.env?.LC_ALL ?? \"C.UTF-8\",\n    TERM: config.env?.TERM ?? \"dumb\", HOME: \"/home/eval\", PWD: \"/workspace\", CI: \"1\",\n    LOCAL_LLM_API_KEY: localToken, OPENAI_API_KEY: localToken, GW_KEY: localToken,\n    XDG_CONFIG_HOME: \"/home/eval/.config\", XDG_DATA_HOME: \"/home/eval/.local/share\", XDG_STATE_HOME: \"/home/eval/.local/state\",\n  };\n  const agent = config.agent ?? \"nexus\";\n  if (agent === \"nexus\") {\n    env.LOCAL_LLM_ENDPOINT = ep;\n    const contextArgs = nexusContextLimitArgs(config, limits.context);\n    if (task.tier === \"T3\") {\n      // T3 drives the sidecar, the operator channel that carries steering, with the same model, budgets and limits.\n      const checkout = agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\");\n      // An installed package is <package>/bin/nexus with the sidecar at <package>/lib/cli/dist/sidecar.js.\n      const packageDir = checkout ? null : path.dirname(path.dirname(fs.realpathSync(agentIdentity.command)));\n      const sidecar = checkout ? path.join(ROOT, \"cli/dist/sidecar.js\") : path.join(packageDir, \"lib/cli/dist/sidecar.js\");\n      if (!fs.existsSync(sidecar)) throw new Error(`T3 needs the Nexus sidecar at ${sidecar}`);\n      if (packageDir) {\n        // The launcher is bypassed, so the package itself must be mounted: it has to sit under sandboxRuntimeRoots.\n        const roots = (config.sandboxRuntimeRoots ?? []).flatMap((root) => { try { return [fs.realpathSync(root)]; } catch { return []; } });\n        if (!roots.some((root) => packageDir === root || packageDir.startsWith(`${root}${path.sep}`))) throw new Error(`T3 runs the sidecar from ${packageDir}, which must be under sandboxRuntimeRoots`);\n        env.NEXUS_HOME = packageDir;\n      }\n      const sidecarArgs = [sidecar, \"--yes\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? [])];\n      return checkout ? { cmd: process.execPath, argv: sidecarArgs, env, protocol: true } : { cmd: \"/usr/bin/env\", argv: [\"node\", ...sidecarArgs], env, protocol: true };\n    }\n    return { cmd: agentIdentity.command, argv: [...agentIdentity.argsPrefix, \"run\", \"--yes\", \"--json\", \"-w\", \"/workspace\", \"-e\", ep, \"-m\", config.model, \"-t\", String(sampling.temperature), \"-s\", \"30\", \"--max-total-steps\", String(budget.steps), \"--max-turn-minutes\", String(budget.minutes), ...contextArgs, ...(config.args ?? []), task.objective], env };\n  }\n  if (agent === \"aider\") {\n    return { cmd: agentIdentity.command, argv: [\"--model\", `openai/${config.model}`, \"--openai-api-base\", ep, \"--yes-always\", \"--no-auto-commits\", \"--no-dirty-commits\", \"--no-gitignore\", \"--no-show-model-warnings\", \"--no-check-update\", \"--analytics-disable\", \"--no-pretty\", \"--no-fancy-input\", ...(config.args ?? []), \"--message\", task.objective], env };\n  }\n  if (agent === \"opencode\") {\n    const dir = path.join(home, \".config/opencode\");\n    fs.mkdirSync(dir, { recursive: true });\n    const modelOptions = { temperature: sampling.temperature, ...(sampling.seed !== undefined ? { seed: sampling.seed } : {}) };\n    fs.writeFileSync(path.join(dir, \"opencode.json\"), JSON.stringify({\n      $schema: \"https://opencode.ai/config.json\",\n      autoupdate: false,\n      share: \"disabled\",\n      permission: { edit: \"allow\", bash: \"allow\", webfetch: \"deny\" },\n      agent: { \"nexus-eval\": { mode: \"primary\", steps: budget.steps } },\n      provider: { gw: { npm: \"@ai-sdk/openai-compatible\", name: \"gateway\", options: { baseURL: ep, apiKey: \"{env:GW_KEY}\" }, models: { [config.model]: { name: config.model, limit: limits, options: modelOptions } } } },\n      model: `gw/${config.model}`,\n    }, null, 2));\n    // Provider packages are cached across runs (not per run): the cache holds code, not state.\n    env.XDG_CACHE_HOME = path.join(home, \".cache\");\n    return { cmd: agentIdentity.command, argv: [\"run\", \"--agent\", \"nexus-eval\", \"--model\", `gw/${config.model}`, ...(config.args ?? []), task.objective], env };\n  }\n  if (agent === \"goose\") {\n    const u = new URL(ep);\n    Object.assign(env, { GOOSE_PROVIDER: \"openai\", GOOSE_MODEL: config.model, OPENAI_HOST: u.origin, OPENAI_BASE_PATH: `${u.pathname.replace(/^\\/|\\/$/g, \"\")}/chat/completions`, GOOSE_MODE: \"auto\", GOOSE_DISABLE_KEYRING: \"1\", GOOSE_CONTEXT_LIMIT: String(limits.context), GOOSE_MAX_TOKENS: String(limits.output), GOOSE_MAX_TURNS: String(budget.steps), GOOSE_TEMPERATURE: String(sampling.temperature) });\n    return { cmd: agentIdentity.command, argv: [\"run\", \"--no-session\", \"--with-builtin\", \"developer\", \"--max-turns\", String(budget.steps), ...(config.args ?? []), \"-t\", task.objective], env };\n  }\n  throw new Error(`agent ${agent} has no adapter`);\n}\n\nfunction runAgent(task, ws, home, budget, agentIdentity, proxyDirectory, localToken) {\n  const { cmd, argv, env, protocol } = agentCommand(task, ws, home, budget, agentIdentity, localToken);\n  if (config.qualification === true && !config.runAs) throw new Error(\"qualification candidate execution requires the dedicated evaluator account\");\n  if (config.runAs) grantRunAsAccess(config.runAs, [ws, home, proxyDirectory]);\n  const runtimePaths = [fs.realpathSync(cmd), ...agentIdentity.argsPrefix.filter((item) => path.isAbsolute(item)), ...(config.sandboxRuntimePaths ?? [])];\n  if ((config.agent ?? \"nexus\") === \"nexus\" && agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\")) {\n    runtimePaths.push(path.join(ROOT, \"cli/dist\"));\n    const modules = path.join(ROOT, \"cli/node_modules\");\n    for (const entry of fs.readdirSync(modules, { withFileTypes: true })) {\n      if (entry.isDirectory() && entry.name !== \".bin\") runtimePaths.push(path.join(modules, entry.name));\n    }\n    const coreBinary = path.join(ROOT, \"core/target/release/harness-core\");\n    if (fs.existsSync(coreBinary)) runtimePaths.push(coreBinary);\n  }\n  const sandboxRuntimePaths = [...new Set(runtimePaths)];\n/**\n * The evaluation harness end to end against a scripted model (Stage 8, T1 smoke): fresh workspaces, hidden tests the\n * agent never sees, separate scores. The self-test task is the assessment's A1 case: a repository whose own suite is\n * green but never exercises the deliverable. A wrong deliverable must fail the hidden test and must never be VERIFIED.\n */\n\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { spawn, spawnSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\nimport { startGateway, Reply } from \"./helpers/fixtures.js\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n\nasync function sealTestTasks(tasksDir: string, taskId: string) {\n  const { corpusTaskRows } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const rows = corpusTaskRows(tasksDir, [taskId]);\n  const manifestPath = path.join(tasksDir, \"custody-manifest.json\");\n  const manifest = { schemaVersion: 1, split: \"heldout\", custody: { status: \"approved\", custodian: \"synthetic-test-role\", approvedAt: \"2026-01-01T00:00:00Z\" }, tasks: rows };\n  const bytes = JSON.stringify(manifest);\n  fs.writeFileSync(manifestPath, bytes);\n  return { corpusManifest: manifestPath, corpusManifestSha256: createHash(\"sha256\").update(bytes).digest(\"hex\") };\n}\n\n/** Async: the scripted gateway answers from this process, so the runner must not block its event loop. */\nfunction runNode(argv: string[], env: NodeJS.ProcessEnv = process.env): Promise<{ status: number | null; stdout: string; stderr: string }> {\n  return new Promise((resolve) => {\n    const child = spawn(process.execPath, argv, { stdio: [\"ignore\", \"pipe\", \"pipe\"], env });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout.on(\"data\", (c) => (stdout += c));\n    child.stderr.on(\"data\", (c) => (stderr += c));\n    child.on(\"close\", (status) => resolve({ status, stdout, stderr }));\n  });\n}\n\nfunction writer(content: string) {\n  return (_n: number, body: any): Reply => {\n    const tools = (body?.messages ?? []).filter((m: any) => m.role === \"tool\").length;\n    if (tools === 0) return { kind: \"tools\", calls: [{ name: \"write_file\", args: { path: \"math.js\", content } }] };\n    if (tools === 1) return { kind: \"tools\", calls: [{ name: \"task_completed\", args: { summary: \"math.js added\" } }] };\n    return { kind: \"text\", content: \"Done.\" };\n  };\n}\n\nasync function evaluate(content: string, extra: Record<string, unknown> = {}): Promise<{ records: any[]; score: any; hiddenLog: string; agentLog: string; agentError: string }> {\n  const gw = await startGateway(writer(content));\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-out-\"));\n  const out = path.join(root, \"run\");\n  const config = path.join(root, \"config.json\");\n  fs.writeFileSync(config, JSON.stringify({ name: \"nexus@mock\", agent: \"nexus\", endpoint: gw.url, model: \"m\", runs: 1, steps: 20, minutes: 5, ...extra }));\n  try {\n    const run = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(run.status, 0, `${run.stdout}\\n${run.stderr}`);\n    const records = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\").split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n    const scored = spawnSync(process.execPath, [path.join(ROOT, \"eval/score.mjs\"), path.join(out, \"results.jsonl\"), \"--json\"], { encoding: \"utf8\" });\n    assert.equal(scored.status, 0, scored.stderr);\n    const manifest = JSON.parse(fs.readFileSync(path.join(out, \"manifest.json\"), \"utf8\"));\n    assert.deepEqual(manifest.tasks.map((task: any) => task.id), [\"selftest-add\"]);\n    assert.match(manifest.harness.sourceSha256, /^[0-9a-f]{64}$/);\n    assert.match(manifest.configSha256, /^[0-9a-f]{64}$/);\n    const priorResults = fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\");\n    const replay = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--only\", \"selftest-add\"]);\n    assert.equal(replay.status, 2);\n    assert.match(replay.stderr, /output directory must be new/);\n    assert.equal(fs.readFileSync(path.join(out, \"results.jsonl\"), \"utf8\"), priorResults, \"reusing an output directory changed prior evidence\");\n    assert.match(manifest.harness.string, /^[0-9a-f]{12}/);\n    const logDir = records[0].logs ? path.join(out, records[0].logs) : null;\n    const readLog = (file: string) => logDir && fs.existsSync(path.join(logDir, file)) ? fs.readFileSync(path.join(logDir, file), \"utf8\") : \"<not written>\";\n    return { records, score: JSON.parse(scored.stdout), hiddenLog: readLog(\"hidden.log\"), agentLog: readLog(\"agent.stdout.json\"), agentError: readLog(\"agent.stderr.log\") };\n  } finally {\n    await gw.close();\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n}\n\ntest(\"a correct deliverable passes the hidden test; a wrong one fails it and is never VERIFIED (A1)\", { timeout: 300_000 }, async () => {\n  const good = await evaluate(\"exports.add = (a, b) => a + b;\\n\");\n  assert.equal(good.records.length, 1);\n  assert.equal(good.records[0].hiddenPass, true, `${JSON.stringify(good.records[0])}\\nagent=${good.agentLog}\\nagent-error=${good.agentError}\\nhidden=${good.hiddenLog}`);\n  assert.equal(good.records[0].regressionPass, true);\n  assert.equal(good.records[0].falseVerified, false);\n\n  const wrong = await evaluate(\"exports.add = (a, b) => a - b;\\n\");\n  const r = wrong.records[0];\n  assert.equal(r.hiddenPass, false, \"the hidden test catches the wrong deliverable\");\n  assert.equal(r.regressionPass, true, \"the repository's own suite is still green\");\n  assert.notEqual(r.turn?.outcome, \"VERIFIED\", `an unrelated green suite does not verify it: ${JSON.stringify(r.turn)}`);\n  assert.equal(r.falseVerified, false);\n  assert.equal(wrong.score.totals.falseVerified, 0);\n  assert.equal(wrong.score.rows[0].correct, 0);\n});\n\n// REQ-QUAL-110: T4 smoke in `make test` — faults injected by the harness's model proxy end truthfully.\ntest(\"standalone profile context discovery is not overridden by the harness default\", async () => {\n  const { nexusContextLimitArgs } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\" }, 65536), []);\n  assert.deepEqual(nexusContextLimitArgs({ serverProfile: \"llamacpp\", limits: { context: 8192 } }, 65536), [\"--context-limit\", \"8192\"]);\n  assert.deepEqual(nexusContextLimitArgs({}, 65536), [\"--context-limit\", \"65536\"]);\n});\n\ntest(\"a standalone server-profile run discovers context instead of forcing the harness default\", { timeout: 300_000 }, async () => {\n  const result = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { serverProfile: \"llamacpp\" });\n  assert.equal(result.records[0].hiddenPass, true);\n  assert.ok(result.records[0].model.profileContextLookups > 0, \"llama.cpp context comes from the profile endpoint\");\n});\n\ntest(\"T4 smoke: an overloaded endpoint is waited out and the task still completes; the fault is recorded\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"overloaded\", atRequest: 1 }] });\n  const r = records[0];\n  assert.deepEqual(r.model.faultsInjected, [{ kind: \"overloaded\", atRequest: 1 }]);\n  assert.equal(r.hiddenPass, true, JSON.stringify(r.turn));\n  assert.equal(r.falseVerified, false);\n  assert.equal(score.faults.length, 9, \"the scorer always exposes all nine accepted T4 fault classes\");\n  assert.equal(score.t4.gate, \"FAIL\", \"one smoke fault is not a nine-class qualification\");\n  assert.deepEqual(score.faults.filter((f: any) => f.n > 0).map((f: any) => [f.kind, f.n, f.truthful, f.recovered]), [[\"overloaded\", 1, 1, 1]]);\n});\n\ntest(\"T4 smoke: a reply cut at the output limit is never run as a tool call, and the run ends truthfully\", { timeout: 300_000 }, async () => {\n  const { records, score } = await evaluate(\"exports.add = (a, b) => a + b;\\n\", { faults: [{ kind: \"truncate\", atRequest: 1 }] });\n  const r = records[0];\n  assert.equal(r.model.faultsInjected[0].kind, \"truncate\");\n  assert.equal(r.falseVerified, false);\n  assert.ok(r.turn, \"the run produced its own result (no crash)\");\n  assert.equal(score.faults[0].truthful, 1);\n});\n\ntest(\"peer run records the executable version and effective budget\", { timeout: 300_000 }, async () => {\n  const gw = await startGateway(() => ({ kind: \"text\", content: \"not used by the fake peer\" }));\n  const out = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-peer-out-\"));\n  const runOut = path.join(out, \"run\");\n  const bin = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-peer-bin-\"));\n  const config = path.join(out, \"config.json\");\n  const fakeOpenCode = path.join(bin, \"opencode\");\n  fs.writeFileSync(fakeOpenCode, `#!/usr/bin/env node\nif (process.argv.includes(\"--version\")) { console.log(\"OpenCode 9.8.7\"); process.exit(0); }\nconst cfg = JSON.parse(require(\"node:fs\").readFileSync(require(\"node:path\").join(process.env.HOME, \".config/opencode/opencode.json\"), \"utf8\"));\nrequire(\"node:fs\").writeFileSync(require(\"node:path\").join(process.cwd(), \"math.js\"), \"exports.add = (a, b) => a + b;\\\\n\");\nconsole.log(JSON.stringify({ observed: { agent: cfg.agent[\"nexus-eval\"], model: cfg.provider.gw.models.m } }));\nconsole.log(JSON.stringify({ turn: { execution: \"COMPLETED\", outcome: \"NOT_REQUIRED\", steps: { used: 1 } } }));\n`);\n  fs.chmodSync(fakeOpenCode, 0o755);\n  fs.writeFileSync(config, JSON.stringify({ name: \"opencode@mock\", agent: \"opencode\", endpoint: gw.url, model: \"m\", runs: 1, steps: 20, minutes: 5, sampling: { temperature: 0, seed: 17 } }));\n  try {\n    const env = { ...process.env, PATH: `${bin}${path.delimiter}${process.env.PATH ?? \"\"}` };\n    const run = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", runOut, \"--only\", \"selftest-add\"], env);\n    assert.equal(run.status, 0, `${run.stdout}\\n${run.stderr}`);\n    const manifest = JSON.parse(fs.readFileSync(path.join(runOut, \"manifest.json\"), \"utf8\"));\n    const record = JSON.parse(fs.readFileSync(path.join(runOut, \"results.jsonl\"), \"utf8\").trim());\n    assert.equal(manifest.agentVersion.agent, \"opencode\");\n    assert.equal(manifest.agentVersion.version, \"OpenCode 9.8.7\");\n    assert.equal(manifest.agentVersion.executablePath, fs.realpathSync(fakeOpenCode));\n    assert.match(manifest.agentVersion.executableSha256, /^[0-9a-f]{64}$/);\n    assert.deepEqual(record.agentVersion, manifest.agentVersion);\n    assert.deepEqual(record.budget, { steps: 20, minutes: 5 });\n    assert.equal(record.hiddenPass, true);\n    const stdout = fs.readFileSync(path.join(runOut, record.logs, \"agent.stdout.json\"), \"utf8\");\n    const observedConfig = stdout.split(/\\r?\\n/).filter(Boolean).map((line) => JSON.parse(line)).find((value) => value.observed).observed;\n    assert.equal(observedConfig.agent.steps, 20);\n    assert.deepEqual(observedConfig.model.options, { temperature: 0, seed: 17 });\n  } finally {\n    await gw.close();\n    fs.rmSync(out, { recursive: true, force: true });\n    fs.rmSync(bin, { recursive: true, force: true });\n  }\n});\n\ntest(\"Goose adapter applies the matched turn, context, output, and temperature budgets\", { timeout: 300_000 }, async () => {\n  const gw = await startGateway(() => ({ kind: \"text\", content: \"not used by the fake peer\" }));\n  const out = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-goose-out-\"));\n  const runOut = path.join(out, \"run\");\n  const bin = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-eval-goose-bin-\"));\n  const config = path.join(out, \"config.json\");\n  const fakeGoose = path.join(bin, \"goose\");\n  fs.writeFileSync(fakeGoose, `#!/usr/bin/env node\nif (process.argv.includes(\"--version\")) { console.log(\"Goose 1.27.2\"); process.exit(0); }\nconsole.log(JSON.stringify({ observed: { args: process.argv.slice(2), context: process.env.GOOSE_CONTEXT_LIMIT, output: process.env.GOOSE_MAX_TOKENS, turns: process.env.GOOSE_MAX_TURNS, temperature: process.env.GOOSE_TEMPERATURE } }));\nrequire(\"node:fs\").writeFileSync(require(\"node:path\").join(process.cwd(), \"math.js\"), \"exports.add = (a, b) => a + b;\\\\n\");\nconsole.log(JSON.stringify({ turn: { execution: \"COMPLETED\", outcome: \"NOT_REQUIRED\", steps: { used: 1 } } }));\n`);\n  fs.chmodSync(fakeGoose, 0o755);\n  fs.writeFileSync(config, JSON.stringify({ name: \"goose@mock\", agent: \"goose\", endpoint: gw.url, model: \"m\", runs: 1, steps: 20, minutes: 5, limits: { context: 65536, output: 8192 }, sampling: { temperature: 0 } }));\n  try {\n    const env = { ...process.env, PATH: `${bin}${path.delimiter}${process.env.PATH ?? \"\"}` };\n    const run = await runNode([path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", runOut, \"--only\", \"selftest-add\"], env);\n    assert.equal(run.status, 0, `${run.stdout}\\n${run.stderr}`);\n    const manifest = JSON.parse(fs.readFileSync(path.join(runOut, \"manifest.json\"), \"utf8\"));\n    const record = JSON.parse(fs.readFileSync(path.join(runOut, \"results.jsonl\"), \"utf8\").trim());\n    const stdout = fs.readFileSync(path.join(runOut, record.logs, \"agent.stdout.json\"), \"utf8\");\n    const captured = stdout.split(/\\r?\\n/).filter(Boolean).map((line) => JSON.parse(line)).find((value) => value.observed).observed;\n    assert.equal(manifest.agentVersion.agent, \"goose\");\n    assert.equal(manifest.agentVersion.version, \"Goose 1.27.2\");\n    assert.equal(manifest.agentVersion.executablePath, fs.realpathSync(fakeGoose));\n    assert.match(manifest.agentVersion.executableSha256, /^[0-9a-f]{64}$/);\n    assert.deepEqual(record.agentVersion, manifest.agentVersion);\n    assert.deepEqual(record.budget, { steps: 20, minutes: 5 });\n M cli/test/eval_harness.test.ts\n M cli/test/eval_integrity.test.ts\n M eval/score.mjs\n","exit_code":0,"duration":{"secs":0,"nanos":866814072}},"started_at_ms":1792914281328,"completed_at_ms":1792914282195}}
