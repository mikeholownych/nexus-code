file is optional; self-ignore verification below is authoritative.\n+  }\n@@ -147,7 +236,21 @@ export function ensureGitExclude(workspace: string): void {\n-    const infoDir = path.dirname(excludePath);\n-    fs.mkdirSync(infoDir, { recursive: true });\n-    if (!fs.existsSync(excludePath)) fs.writeFileSync(excludePath, \"\");\n+    if (!expectedExcludePath || !commonDirPath) return;\n+\n+    try {\n+      readExclude(excludePath, expectedExcludePath);\n+    } catch (error) {\n+      if (typeof error !== \"object\" || error === null || !(\"code\" in error) || error.code !== \"ENOENT\") {\n+        throw error;\n+      }\n+      try {\n+        writeExclusiveVerified(commonDirPath, expectedExcludePath, \"\");\n+      } catch (createError) {\n+        // Another safe creator may have won the exclusive-create race.\n+        if (typeof createError !== \"object\" || createError === null || !(\"code\" in createError) || createError.code !== \"EEXIST\") {\n+          throw createError;\n+        }\n+      }\n+    }\n@@ -158,5 +261,5 @@ export function ensureGitExclude(workspace: string): void {\n-      const content = fs.readFileSync(excludePath, \"utf-8\");\n+      const content = readExclude(excludePath, expectedExcludePath);\n@@ -173,5 +276,5 @@ export function ensureGitExclude(workspace: string): void {\n-      fs.appendFileSync(excludePath, `${prefix}${rule}\\n`);\n+      appendExclude(excludePath, expectedExcludePath, `${prefix}${rule}\\n`);\ndiff --git a/cli/test/doctor.test.ts b/cli/test/doctor.test.ts\n--- a/cli/test/doctor.test.ts\n+++ b/cli/test/doctor.test.ts\n@@ -7,4 +7,5 @@ import assert from \"node:assert/strict\";\n+import { syncBuiltinESMExports } from \"node:module\";\n@@ -847,4 +848,5 @@ describe(\"repairs cannot be redirected by links anywhere in the path\", () => {\n+        sy…44 tokens truncated…describe(\"repairs cannot be redirected by links anywhere in the path\", () => {\n+        syncBuiltinESMExports();\n@@ -899,4 +903,5 @@ describe(\"repairs cannot be redirected by links anywhere in the path\", () => {\n+        syncBuiltinESMExports();\ndiff --git a/cli/test/flight_exclude.test.ts b/cli/test/flight_exclude.test.ts\n--- a/cli/test/flight_exclude.test.ts\n+++ b/cli/test/flight_exclude.test.ts\n@@ -114,4 +114,45 @@ describe(\"ACC-PER-05: Flight Logs & Telemetry Git Exclude (REQ-PER-105)\", () =>\n+  test(\"Git unavailable in a linked worktree fails closed before creating flight state\", () => {\n+    const linkedWorkspace = path.join(tmpDir, \"linked-worktree\");\n+    execFileSync(\"git\", [\"worktree\", \"add\", \"--detach\", linkedWorkspace, \"HEAD\"], { cwd: gitRepoDir });\n+    assert.equal(fs.lstatSync(path.join(linkedWorkspace, \".git\")).isFile(), true);\n+    assert.equal(fs.existsSync(path.join(linkedWorkspace, \".git\", \"info\")), false);\n+\n+    const originalPath = process.env.PATH;\n+    try {\n+      process.env.PATH = \"\";\n+      assert.throws(() => new FlightRecorder(linkedWorkspace), /Git metadata is unavailable/);\n+    } finally {\n+      if (originalPath === undefined) delete process.env.PATH;\n+      else process.env.PATH = originalPath;\n+    }\n+\n+    assert.equal(fs.existsSync(path.join(linkedWorkspace, \".nexus\", \"flights\")), false);\n+  });\n+\n+  test(\"Git unavailable in nested repository workspaces fails closed before creating flight state\", () => {\n+    const normalNestedWorkspace = path.join(gitRepoDir, \"packages\", \"app\");\n+    fs.mkdirSync(normalNestedWorkspace, { recursive: true });\n+\n+    const linkedWorkspace = path.join(tmpDir, \"nested-linked-worktree\");\n+    execFileSync(\"git\", [\"worktree\", \"add\", \"--detach\", linkedWorkspace, \"HEAD\"], { cwd: gitRepoDir });\n+    const linkedNestedWorkspace = path.join(linkedWorkspace, \"packages\", \"app\");\n+    fs.mkdirSync(linkedNestedWorkspace, { recursive: true });\n+\n+    const originalPath = process.env.PATH;\n+    try {\n+      process.env.PATH = \"\";\n+      assert.throws(() => new FlightRecorder(normalNestedWorkspace), /Git metadata is unavailable/);\n+      assert.throws(() => new FlightRecorder(linkedNestedWorkspace), /Git metadata is unavailable/);\n+    } finally {\n+      if (originalPath === undefined) delete process.env.PATH;\n+      else process.env.PATH = originalPath;\n+    }\n+\n+    assert.equal(fs.existsSync(path.join(normalNestedWorkspace, \".nexus\", \"flights\")), false);\n+    assert.equal(fs.existsSync(path.join(linkedNestedWorkspace, \".nexus\", \"flights\")), false);\n+  });\n+\ndiff --git a/cli/test/git_exclude.test.ts b/cli/test/git_exclude.test.ts\n--- a/cli/test/git_exclude.test.ts\n+++ b/cli/test/git_exclude.test.ts\n@@ -6,5 +6,6 @@\n-import * as fs from \"node:fs\";\n+import fs from \"node:fs\";\n+import { syncBuiltinESMExports } from \"node:module\";\n@@ -182,5 +183,4 @@ test(\"a symlink swap cannot write self-ignore content or alter external ignore r\n-    const mutableFs = fs as unknown as { openSync: typeof fs.openSync };\n@@ -192,5 +192,5 @@ test(\"a symlink swap cannot write self-ignore content or alter external ignore r\n-      mutableFs.openSync = ((file: fs.PathLike, flags: string | number, mode?: number) => {\n+      fs.openSync = ((file: fs.PathLike, flags: string | number, mode?: number) => {\n@@ -206,4 +206,5 @@ test(\"a symlink swap cannot write self-ignore content or alter external ignore r\n+      syncBuiltinESMExports();\n@@ -215,5 +216,6 @@ test(\"a symlink swap cannot write self-ignore content or alter external ignore r\n-      mutableFs.openSync = originalOpenSync;\n+      fs.openSync = originalOpenSync;\n+      syncBuiltinESMExports();\n@@ -255,2 +257,55 @@ test(\"a missing exclude file is created with the rules\", () => {\n+\n+test(\"a symlinked info/exclude is not followed or modified\", () => {\n+  const { root, excludePath } = makeRepo(\"\");\n+  const outside = path.join(root, \"operator-owned-rules\");\n+  try {\n+    fs.writeFileSync(outside, \"operator rules\\n\");\n+    fs.unlinkSync(excludePath);\n+    fs.symlinkSync(outside, excludePath);\n+\n+    ensureGitExclude(root);\n+\n+    assert.equal(fs.readFileSync(outside, \"utf8\"), \"operator rules\\n\");\n+    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n+  } finally {\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"a hard-linked info/exclude is not modified\", () => {\n+  const { root, excludePath } = makeRepo(\"\");\n+  const outside = path.join(root, \"operator-owned-rules\");\n+  try {\n+    fs.writeFileSync(outside, \"operator rules\\n\");\n+    fs.unlinkSync(excludePath);\n+    fs.linkSync(outside, excludePath);\n+\n+    ensureGitExclude(root);\n+\n+    assert.equal(fs.readFileSync(outside, \"utf8\"), \"operator rules\\n\");\n+    assert.equal(isIgnored(root, \".nexus/tasks/task.json\"), true);\n+  } finally {\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"a symlinked info directory does not redirect missing exclude creation\", () => {\n+  const { root, excludePath } = makeRepo(null);\n+  const infoDir = path.dirname(excludePath);\n+  const movedInfoDir = path.join(root, \".git\", \"info-before-link\");\n+  const outside = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-git-exclude-info-outside-\"));\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a171e6-e7a2-7bb2-92f7-17944d46f4b1","create_time":1792912639.7951865}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
