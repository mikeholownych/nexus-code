ture(diskTask, diskAgent, containment, { storageBytes: 128 * 1024 * 1024 })[0].evidence.storageLimitBytes, null);\n});\n\ntest(\"black-box oracle keeps canary expectations outside the candidate process and returns sanitized evidence\", { timeout: 15_000 }, async () => {\n  const { runBlackBoxOracle } = await import(path.join(ROOT, \"eval/oracle.mjs\"));\n  const taskDir = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-private-task-\"));\n  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-candidate-\"));\n  const privateFile = path.join(taskDir, \"private-cases.json\");\n  const canary = \"ORACLE_EXPECTATION_CANARY_8f3c\";\n  const diagnosticCanary = \"SYNTHETIC_DIAGNOSTIC_CANARY_a219\";\n  fs.writeFileSync(privateFile, JSON.stringify([{ input: { value: \"public-input\" }, expected: { value: \"public-input\", oracle: null } }]));\n  const candidate = path.join(workspace, \"solution.mjs\");\n  fs.writeFileSync(candidate, `import fs from 'node:fs';\\nlet value;try{value=fs.readFileSync(${JSON.stringify(privateFile)},'utf8')}catch{};\\ntry{fs.writeFileSync('/workspace/solution.mjs','tampered')}catch{};\\nconst input=JSON.parse(fs.readFileSync(0,'utf8'));\\nconsole.error(${JSON.stringify(diagnosticCanary)});\\nconsole.log(JSON.stringify({value:input.value,oracle:value??null}));\\n`);\n  const candidateBefore = fs.readFileSync(candidate);\n  const check = { protocol: \"blackbox-v1\", casesFile: \"private-cases.json\", runtime: \"node\", argv: [\"solution.mjs\"], timeoutMs: 3000, totalTimeoutMs: 5000, maxOutputBytes: 4096 };\n      }\n    }\n\n    // Baseline capture is process-local evidence as well as durable evidence.\n    // Subagents are intentionally non-durable, but their edits still need a\n    // pre-change verifier snapshot so the parent cannot mistake an unbound\n    // passing test run for independent verification.\n    if (FILE_EDIT_TOOLS.has(toolName)) await this.captureChangeBaseline(onConfirm);\n    // A tool of a group not offered yet still runs (the model may know it from earlier); offer its group from now on.\n    const calledGroup = toolGroupOf(toolName);\n    if (calledGroup) this.enabledToolGroups.add(calledGroup);\n    const workspaceAvailableBeforeBytes = toolName === \"run_command\" && process.env.NEXUS_EVAL_TOOL_RECEIPTS === \"1\"\n      ? this.workspaceAvailableBytes()\n      : null;\n    const receipt = await this.spine.execute(\n      {\n        invocationId: call.id,\n        taskId: effectiveTaskId,\n        actor,\n        executionDomain: actor === \"subagent\" ? \"subagent\" : \"agent_orchestration\",\n        toolName,\n        args,\n        stepIndex: currentStep,\n      },\n      context\n    );\n\n    if (toolName === \"run_command\" && actor === \"agent\" && process.env.NEXUS_EVAL_TOOL_RECEIPTS === \"1\") {\n      try {\n        const result = JSON.parse(receipt.output || \"{}\");\n        if (typeof result.command === \"string\" && typeof result.timed_out === \"boolean\") {\n          this.evaluationToolReceipts.push({\n            invocationId: call.id,\n            tool: \"run_command\",\n            commandSha256: createHash(\"sha256\").update(result.command).digest(\"hex\"),\n            timeoutSecs: Number.isSafeInteger(args.timeout_secs) ? args.timeout_secs : null,\n            exitCode: Number.isSafeInteger(result.exit_code) ? result.exit_code : null,\n            timedOut: result.timed_out,\n            workspaceAvailableBeforeBytes,\n            workspaceAvailableAfterBytes: this.workspaceAvailableBytes(),\n          });\n        }\n      } catch {\n        // An absent or malformed runner envelope is deliberately not evaluator evidence.\n      }\n    }\n\n    if (this.durable && this.stateManager && effectiveTaskId) {\n      try {\n        this.stateManager.recordOperationEnd(effectiveTaskId, call.id, {\n          success: receipt.success,\n          error: receipt.error,\n        }, operationSeq);\n      } catch (err: any) {\n        this.reportPersistenceFailure(