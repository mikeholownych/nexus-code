Request < 1) throw new Error(`invalid fault ${JSON.stringify(f)}`);\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:90:    [\"POST /messages\", \"inference\"],\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:94:  const stats = { requests: 0, chatRequests: 0, activeInferenceRequests: 0, cancelledRequests: 0, profileContextLookups: 0, requestedCompletionTokens: 0, answered: 0, upstreamFailures: 0, faultsInjected: [], firstRequestAt: null, firstAnswerAt: null };\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:155:        return void sendJson(res, 200, { default_generation_settings: { n_ctx: await firstContext() } });\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:204:    const fault = chatIndex ? faults.find((f) => f.atRequest === chatIndex) : undefined;\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:205:    if (fault) stats.faultsInjected.push({ kind: fault.kind, atRequest: chatIndex });\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:207:    if (fault?.kind === \"refuse\") {\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:211:    if (fault?.kind === \"overloaded\") {\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:216:    if (fault?.kind === \"context_overflow\") {\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:274:        if (!fault || !streamed) {\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:283:          if (fault.kind === \"stream_cut\" && !done && event.includes('\"tool_calls\"')) {\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:288:          if (fault.kind === \"truncate\") return event.replace(/\"finish_reason\":\\s*\"(stop|tool_calls)\"/g, '\"finish_reason\":\"length\"');\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:289:          if (fault.kind === \"malformed_tool_json\" && !done && /\"arguments\":\\s*\"/.test(event)) {\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:325:    stats: () => ({ ...stats, faultsInjected: [...stats.faultsInjected] }),\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:339: * a failure, not a rerun). Faults the harness injected on purpose are never infrastructure.\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/model_proxy.mjs:344:  if (!m || (m.faultsInjected?.length ?? 0) > 0) return false;\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/host/README.md:22:- `validate.mjs`, run as the operator, proves the result using infrastructure fixtures only.\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/host/README.md:54:| `memoryBytes` | 16 GiB | `memory.max`, with `memory.swap.max = 0` and `memory.oom.group = 1`. The charge counts the phase's anonymous memory, the page cache it faults in (reclaimable before OOM), **and the tmpfs pages it writes**. A phase that writes 6 GiB of build output therefore has about 10 GiB left for its processes. Exceeding the limit OOM-kills the whole phase, and this is recorded. |\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/infra.mjs:47:if (legacy) console.error(`infra: ${legacy} record(s) predate the model proxy; classified by agent failure messages`);\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/t3.mjs:374:    // error, never a precondition granted by default.\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/tasks/t2-bugfix-csv/task.json:4:  \"fixture\": \"repo\",\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:3:// Each run gets a fresh workspace (the task's repository at its pinned commit, or its fixture), the agent runs with the\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:208:    // T4: a task (or the config) may schedule faults for the proxy to inject; they are recorded with the run.\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:209:    const faults = task.faults ?? config.faults ?? [];\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:210:    if (faults.length && config.proxy === false) throw new Error(\"fault injection needs the model proxy (proxy: false is set)\");\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:220:      faults,\n/h