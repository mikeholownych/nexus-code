r10c-t4/eval/run.mjs:3:// Each run gets a fresh workspace (the task's repository at its pinned commit, or its fixture), the agent runs with the\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:208:    // T4: a task (or the config) may schedule faults for the proxy to inject; they are recorded with the run.\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:209:    const faults = task.faults ?? config.faults ?? [];\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:210:    if (faults.length && config.proxy === false) throw new Error(\"fault injection needs the model proxy (proxy: false is set)\");\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:220:      faults,\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:260:      // Fixture tasks commit at staging time, so compare content (the tree), not the commit id.\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:293:      ...(agent.t4FaultsInjected?.length ? { t4FaultsInjected: agent.t4FaultsInjected } : {}),\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:309:  if (task.fixture) {\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:310:    const fixture = confinedPath(task.dir, task.fixture);\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:311:    assertNoSymlinks(fixture);\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:312:    fs.cpSync(fixture, ws, { recursive: true, verbatimSymlinks: true });\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:315:    sh(\"git\", [\"-c\", \"user.name=eval\", \"-c\", \"user.email=eval@example.invalid\", \"commit\", \"-qm\", \"fixture\"], ws);\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:322:  } else throw new Error(`task ${task.id} has neither fixture nor repo`);\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:528:  if (task.t4RunnerFault !== \"sigterm_resume\") {\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:536:  if (!signal?.delivered) return { ...interrupted, t4FaultsInjected: [] };\n","exit_code":0,"duration":{"secs":0,"nanos":27543}},"started_at_ms":1792916743801