ajor/minor/patch. Need if MAJOR > 0: upper = (major+1,0,0,no prerelease). elif MINOR > 0: upper = (0, minor+1, 0, no prerelease). else: upper = (0,0,patch+1,no prerelease). Wait spec: < (MAJOR+1).0.0 if MAJOR > 0, else < 0.(MINOR+1).0 if MINOR > 0, else < 0.0.(PATCH+1). This is unusual for major=0. For ^0.Reasoning budget exhausted. Stop reasoning now and write the final answer in the required format.\\\\n\\\", \\\"wall_secs\\\": 192.0, \\\"prompt_tokens\\\": 764, \\\"completion_tokens\\\": 3604, \\\"reasoning_tokens\\\": null, \\\"answer_tokens\\\": null, \\\"reasoning_chars\\\": 7956, \\\"ttft_ms_est\\\": 5402.6, \\\"prompt_ms\\\": 5350.81, \\\"predicted_ms\\\": 186602.07, \\\"predicted_n\\\": 3604, \\\"reasoning_budget\\\": 2048, \\\"budget_reached\\\": null, \\\"valid_final_answer\\\": true, \\\"termination\\\": \\\"stop\\\"}], \\\"wall_secs\\\": 192.0, \\\"rep\\\": 1}]}\\nevaluations/engx/results/remote-qualification-20261007-2048/eng-hard-flashnext-2048.partial.json:1:{\\\"label\\\": \\\"flashnext-2048\\\", \\\"meta\\\": {\\\"model\\\": \\\"candidate/flashnext-deep\\\", \\\"base_url\\\": \\\"https://10.0.8.5:8443/v1\\\", \\\"corpus\\\": \\\"hard\\\", \\\"corpus_digest\\\": \\\"92e26705ddc4ea9d\\\", \\\"max_tokens\\\": 12288, \\\"max_attempts\\\": 1, \\\"only\\\": [\\\"H01\\\"], \\\"condition\\\": null, \\\"client_thinking_disabled\\\": false, \\\"reasoning_budget\\\": 2048, \\\"reasoning_budget_message\\\": null, \\\"temperature\\\": 0, \\\"partial\\\": true}, \\\"results\\\": [{\\\"id\\\": \\\"H01-semver-range\\\", \\\"discipline\\\": \\\"spec_implementation\\\", \\\"success\\\": false, \\\"attempts\\\": 0, \\\"model_secs\\\": 0.0, \\\"tokens\\\": 0, \\\"history\\\": [{\\\"attempt\\\": 1, \\\"error\\\": \\\"{\\\\\\\"error\\\\\\\":{\\\\\\\"message\\\\\\\":\\\\\\\"unsupported endpoint\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"not_found\\\\\\\"}}\\\", \\\"termination\\\": \\\"error\\\", \\\"wall_secs\\\": 0.0}], \\\"wall_secs\\\": 0.0, \\\"rep\\\": 1}]}\\nevaluations