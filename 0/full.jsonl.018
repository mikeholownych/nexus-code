{"timestamp":"2026-10-25T04:02:29.761Z","ordinal":323317,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17136-12b9-7661-904c-f2b43120b5c8","item":{"type":"CommandExecution","id":"exec-ce11de47-8d8d-48cd-bbc1-5716dc5f1212","process_id":"96524","command":["/usr/bin/zsh","-lc","sed -n '900,940p' cli/src/upgrade.ts; sed -n '1050,1095p' cli/src/upgrade.ts; rg -n 'NEXUS_VERIFY_ATTESTATION|trusted gh|attestation' cli/test/upgrade_acceptance.test.ts"],"cwd":"file:///home/mike/nexus-wt/plan-07-installer-attestation-fix","parsed_cmd":[{"type":"read","cmd":"sed -n '900,940p' cli/src/upgrade.ts","name":"upgrade.ts","path":"cli/src/upgrade.ts"},{"type":"read","cmd":"sed -n '1050,1095p' cli/src/upgrade.ts","name":"upgrade.ts","path":"cli/src/upgrade.ts"},{"type":"search","cmd":"rg -n 'NEXUS_VERIFY_ATTESTATION|trusted gh|attestation' cli/test/upgrade_acceptance.test.ts","query":"NEXUS_VERIFY_ATTESTATION|trusted gh|attestation","path":"upgrade_acceptance.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    fs.renameSync(tmpLink, binNexus);\n  } catch (err: any) {\n    try { fs.unlinkSync(tmpLink); } catch {}\n    return { success: false, error: `Failed to update symlink: ${err.message}` };\n  }\n\n  return { success: true, revertedTo: candidate.dirName };\n}\n\nexport async function performUpgrade(\n  comparison: UpgradeComparison,\n  options?: UpgradeOptions\n): Promise<UpgradeExecutionResult> {\n  if (!comparison.canUpgrade) {\n    throw new Error(`Cannot upgrade: ${comparison.reasons.join(\" \")}`);\n  }\n\n  const verifyAttestation = process.env.NEXUS_VERIFY_ATTESTATION ?? \"auto\";\n  const trustedGhPaths = options?.trustedGhPaths ?? [\"/usr/bin/gh\", \"/usr/local/bin/gh\"];\n  const trustedGh = trustedGhPaths.find((candidate) => fs.existsSync(candidate));\n  if (verifyAttestation === \"1\" && !trustedGh) {\n    throw new Error(\n      \"Provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\",\n    );\n  }\n\n  const { installed, targetVersion, action } = comparison;\n  const prefix = path.resolve(options?.prefix ?? installed.prefix ?? path.join(process.env.HOME || \"\", \".local\"));\n  const baseDownloadUrl = getReleaseBaseUrl();\n  const archiveName = `nexus-linux-x86_64-${targetVersion}.tar.gz`;\n  const archiveUrl = `${baseDownloadUrl}/download/${targetVersion}/${archiveName}`;\n  const checksumsUrl = `${baseDownloadUrl}/download/${targetVersion}/SHA256SUMS`;\n  const compatibilityUrl = `${baseDownloadUrl}/download/${targetVersion}/compatibility.json`;\n\n  const libNexus = path.join(prefix, \"lib\", \"nexus\");\n  const binDir = path.join(prefix, \"bin\");\n  const linkPath = path.join(binDir, \"nexus\");\n  const versionDir = path.join(libNexus, targetVersion);\n\n  fs.mkdirSync(libNexus, { recursive: true });\n  fs.mkdirSync(binDir, { recursive: true });\n    // A detached metadata asset is optional for legacy releases, but if present\n    // it must be valid and checksum-bound. Its policy is compared with the copy\n    // embedded in the archive after extraction.\n    let externalCompat: ReleaseCompatibilityMetadata | null = null;\n    try {\n      await downloadFile(compatibilityUrl, localCompat, options?.signal, 5000);\n      if (fs.existsSync(localCompat)) {\n        externalCompat = JSON.parse(fs.readFileSync(localCompat, \"utf8\"));\n        const externalValidation = validateCompatibilityMetadata(externalCompat);\n        if (!externalValidation.valid) throw new Error(`Invalid compatibility.json: ${externalValidation.errors.join(\"; \")}`);\n        if (!verifyChecksum(localCompat, sumsContent, COMPATIBILITY_METADATA_FILENAME)) {\n          throw new Error(\"SHA-256 verification failed for compatibility.json; no installation was changed.\");\n        }\n      }\n    } catch (err: any) {\n      // Release may omit standalone compatibility asset\n      if (!String(err?.message ?? err).includes(\"HTTP 404\")) throw err;\n    }\n\n    // Optional attestation check via a trusted gh if present. Do not resolve it from PATH: a shim that exits 0\n    // must not be able to claim a verified attestation, and a missing gh must fail closed when verification is required.\n    let attestationVerified: boolean | undefined;\n    if (verifyAttestation !== \"0\") {\n      if (trustedGh) {\n        options?.onProgress?.(\"verifying_attestation\", \"Checking build provenance attestation...\");\n        const attestCheck = spawnSync(trustedGh, [\"attestation\", \"verify\", localArchive, \"-R\", CANONICAL_REPO]);\n        const indexAttestCheck = spawnSync(trustedGh, [\"attestation\", \"verify\", localSums, \"-R\", CANONICAL_REPO]);\n        if (attestCheck.status === 0 && indexAttestCheck.status === 0) {\n          attestationVerified = true;\n        } else if (verifyAttestation === \"1\") {\n          throw new Error(`Provenance attestation verification failed for ${archiveName} or SHA256SUMS.`);\n        }\n      } else if (verifyAttestation === \"1\") {\n        throw new Error(\n          \"Provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\",\n        );\n      }\n    }\n\n    // 5. Staging phase: Safe tar header validation and extraction\n    options?.onProgress?.(\"extracting\", \"Inspecting and safely extracting package...\");\n    journalEntry.state = \"staged\";\n    journalEntry.updatedAt = new Date().toISOString();\n    writeJournal(prefix, journalEntry);\n\n    const unpackDir = path.join(tmpDir, \"unpack\");\n317:  it(\"refuses an upgrade that requires attestation when gh is unavailable\", async () => {\n329:    const savedAttestation = process.env.NEXUS_VERIFY_ATTESTATION;\n330:    // A PATH shim that claims success must not satisfy *required* attestation, and an empty trusted-path list must\n338:    process.env.NEXUS_VERIFY_ATTESTATION = \"1\";\n343:        \"a required attestation must fail closed when no trusted gh exists\",\n346:      assert.equal(readJournal(tmpPrefix), null, \"required attestation must fail before starting the journal\");\n353:        \"required attestation must not leave upgrade staging or a journal\",\n358:      if (savedAttestation === undefined) delete process.env.NEXUS_VERIFY_ATTESTATION;\n359:      else process.env.NEXUS_VERIFY_ATTESTATION = savedAttestation;\n363:  it(\"rejects required attestation when the trusted gh reports failure\", async () => {\n376:    const savedAttestation = process.env.NEXUS_VERIFY_ATTESTATION;\n377:    process.env.NEXUS_VERIFY_ATTESTATION = \"1\";\n381:        /Provenance attestation verification failed for .* or SHA256SUMS/,\n382:        \"a trusted gh reporting failure must reject required attestation\",\n385:      if (savedAttestation === undefined) delete process.env.NEXUS_VERIFY_ATTESTATION;\n386:      else process.env.NEXUS_VERIFY_ATTESTATION = savedAttestation;\n","exit_code":0,"duration":{"secs":0,"nanos":715800431}},"started_at_ms":1792900949044,"completed_at_ms":1792900949761}}
