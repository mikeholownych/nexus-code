 if (reqId !== undefined && this.pendingRequests.has(reqId)) {\n          const { resolve, timeoutTimer } = this.pendingRequests.get(reqId)!;\n          clearTimeout(timeoutTimer);\n          this.pendingRequests.delete(reqId);\n\n          if (msg.error) {\n            resolve({\n              success: false,\n              output: \"\",\n              error: typeof msg.error === \"string\" ? msg.error : JSON.stringify(msg.error),\n            });\n          } else {\n            const outStr = typeof msg.result === \"string\"\n              ? msg.result\n              : JSON.stringify(msg.result, null, 2);\n            resolve({\n              success: true,\n              output: outStr,\n            });\n          }\n        }\n      } catch {\n        // Non-JSON output (e.g. cargo build notes)\n      }\n    }\n  }\n\n  public shutdown(): void {\n    this.cleanupRpc();\n    this.handshakePromise = null;\n    this.handshakeError = null;\n    RustCoreBridge.activeBridges.delete(this);\n  }\n\n    let max_timeout = max_tool_timeout_secs();\n    let (effective_timeout, clamped) = if timeout_secs > max_timeout {\n        (max_timeout, true)\n    } else {\n        (timeout_secs, false)\n    };\n\n    let timeout = Duration::from_secs(effective_timeout);\n    let poll_interval = Duration::from_millis(50);\n    let mut timed_out = false;\n\n    let exit_status = loop {\n        match child.try_wait() {\n            Ok(Some(status)) => break Some(status),\n            Ok(None) => {\n                if start.elapsed() > timeout {\n                    #[cfg(unix)]\n                    if let Some(pgid) = pty_pgid {\n                        registry::end_groups(&[pgid], Duration::from_millis(500));\n                    }\n                    let _ = child.kill();\n                    timed_out = true;\n                    let _ = child.wait();\n                    break None;\n                }\n                std::thread::sleep(poll_interval);\n            }\n            Err(_) => break None,\n        }\n    };\n\n    drop(pair.master);\n    let mut text = output_handle.join().map(|c| c.render()).unwrap_or_default();\n    if clamped {\n        text = format!(\"[Notice: timeout_secs clamped from {} to {} (NEXUS_MAX_TOOL_TIMEOUT_SECS)]\\n{}\", timeout_secs, effective_timeout, text);\n    }\n\n    #[cfg(unix)]\n    let was_cancelled = match (key, cancelled) {\n        (Some(k), Some(flag)) => {\n            registry::finish(k);\n            flag.load(std::sync::atomic::Ordering::SeqCst)\n        }\n        _ => false,\n    };\n    #[cfg(not(unix))]\n    let was_cancelled = false;\n\n    Ok(RunCommandResult {\n        command: command_str.to_string(),\n        shell: shell_name.to_string(),\n        exit_code: exit_status.and_then(|s| if s.success() { Some(0) } else { Some(1) }),\n        stdout: text,\n        stderr: String::new(),\n        duration_ms: start.elapsed().as_millis(),\n        timed_out,\n        cancelled: was_cancelled,\n    })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    static TEST_MUTEX: std::sync::Mutex<()> = std::sync::Mutex::new(());\n\n    #[test]\n    #[cfg(unix)]\n    fn output_is_kept_when_a_background_process_holds_the_pipe() {\n        let _guard = TEST_MUTEX.lock().unwrap_or_else(|e| e.into_inner());\n        let dir = std::env::temp_dir();\n                        continue;\n                    }\n                    let t = a.trim();\n                    if t == \"/\"\n                        || t == \"/*\"\n                        || t == \".\"\n                        || t == \"..\"\n                        || t == \"~\"\n                        || t.eq_ignore_ascii_case(\"$home\")\n                        || t.eq_ignore_ascii_case(\"${home}\")\n                    {\n                        return Some(\"Destructive recursive deletion of root, home, or current directory (rm -rf)\");\n                    }\n                }\n            }\n        }\n\n        // Shell wrapper inspection