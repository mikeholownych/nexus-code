Sync(movedParent)) fs.renameSync(movedParent, parent);\n       }\n     });\n@@ -889,16 +892,18 @@ describe(\"repairs cannot be redirected by links anywhere in the path\", () => {\n             fs.mkdirSync(redirectedTarget);\n           }\n           return originalRmdirSync(directory);\n         }) as typeof fs.rmdirSync;\n+        syncBuiltinESMExports();\n \n         assert.throws(() => mkdirVerified(h, target), SafePathError);\n         assert.equal(swapped, true);\n         assert.equal(removalAttempted, false, \"failed verification must not remove through a replaceable pathname\");\n         assert.equal(fs.statSync(redirectedTarget).isDirectory(), true, \"the raced directory is left untouched\");\n       } finally {\n         mutableFs.mkdirSync = originalMkdirSync;\n         mutableFs.rmdirSync = originalRmdirSync;\n+        syncBuiltinESMExports();\n         if (fs.lstatSync(parent, { throwIfNoEntry: false })?.isSymbolicLink()) fs.unlinkSync(parent);\n         if (fs.existsSync(movedParent)) fs.renameSync(movedParent, parent);\n       }\n     });\ndiff --git a/cli/test/flight_exclude.test.ts b/cli/test/flight_exclude.test.ts\nindex 587cb7a..bb02672 100644\n--- a/cli/test/flight_exclude.test.ts\n+++ b/cli/test/flight_exclude.test.ts\n@@ -112,8 +112,49 @@ describe(\"ACC-PER-05: Flight Logs & Telemetry Git Exclude (REQ-PER-105)\", () =>\n     const status = execFileSync(\"git\", [\"status\", \"--porcelain\"], { cwd: gitRepoDir, encoding: \"utf8\" }).trim();\n     assert.equal(status, \"\", `Nexus state must remain ignored when info/exclude is unavailable; found:\\n${status}`);\n   });\n \n+  test(\"Git unavailable in a linked worktree fails closed before creating flight state\", () => {\n+    const linkedWorkspace = path.join(tmpDir, \"linked-worktree\");\n+    execFileSync(\"git\", [\"worktree\", \"add\", \"--detach\", linkedWorkspace, \"HEAD\"], { cwd: gitRepoDir });\n+    assert.equal(fs.lstatSync(path.join(linkedWorkspace, \".git\")).isFile(), true);\n+   