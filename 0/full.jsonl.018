rectory]);\n  const runtimePaths = [fs.realpathSync(cmd), ...agentIdentity.argsPrefix.filter((item) => path.isAbsolute(item)), ...(config.sandboxRuntimePaths ?? [])];\n  if ((config.agent ?? \"nexus\") === \"nexus\" && agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\")) {\n    runtimePaths.push(path.join(ROOT, \"cli/dist\"));\n    const modules = path.join(ROOT, \"cli/node_modules\");\n    for (const entry of fs.readdirSync(modules, { withFileTypes: true })) {\n      if (entry.isDirectory() && entry.name !== \".bin\") runtimePaths.push(path.join(modules, entry.name));\n    }\n    const coreBinary = path.join(ROOT, \"core/target/release/harness-core\");\n    if (fs.existsSync(coreBinary)) runtimePaths.push(coreBinary);\n  }\n  const sandboxRuntimePaths = [...new Set(runtimePaths)];\n  const allowedRuntimeRoots = [...new Set([...(config.sandboxRuntimeRoots ?? []), ...((config.agent ?? \"nexus\") === \"nexus\" && agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\") ? [path.join(ROOT, \"cli\"), path.join(ROOT, \"core\")] : [])])];\n  const supervisorPath = path.join(ROOT, \"eval/agent_sandbox.mjs\");\n  const corpusPaths = custodyCorpusPathsForRun();\n  const protectedCorpusPaths = protectedCorpusPathsForRun();\n  const corpusOverlap = runtimeCorpusOverlapProblem(sandboxRuntimePaths, allowedRuntimeRoots, tasksDir, corpusPaths, {\n    cwd: ws,\n    home,\n    proxyDirectory,\n    nodeRuntime: cmd,\n    supervisorPath,\n    qualification: config.qualification === true,\n  });\n  if (corpusOverlap) throw new Error(corpusOverlap);\n  const sandbox = agentSandboxArgv({ cwd: ws, home, proxyDirectory, readOnlyPaths: sandboxRuntimePaths, allowedRuntimeRoots, runtimeExecutablePaths: [cmd, ...agentIdentity.argsPrefix], supervisorPath, protectedCorpusPaths });\n  const wrapped = config.runAs ? asUserSpec(config.runAs, sandbox) : sandbox;\n  return new Promise((resolve) => {\n    const { child, containment } = spawnContained(wrapped, config.resources ?? null, { cwd: \"/\", env: {}, stdio: [\"pipe\", \"pipe\", \"pipe\"], detached: true });\n    // T3: the payload is the first line and the sidecar protocol follows on the same stdin (eval/agent_sandbox.mjs).\n    const preconditions = {};\n    const runConstraint = (command) => runIsolated(command, { cwd: ws, home: true, timeoutSec: 300, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun() }).then((r) => ({ pass: r.status === 0 && !r.timedOut && !r.overflow }));\n    const driver = protocol ? createT3Driver(task, (line) => { if (!child.stdin.destroyed) child.stdin.write(line); }, {\n      onSteer: (item) => { preconditions[item.id] = steeringPrecondition(item, ws, task.t3CommandBaseline); },\n      beforeProbe: () => t3Snapshot(task, ws, runConstraint),\n    }) : null;\n    child.stdin.on(\"error\", () => {});\n    if (driver) {\n      child.stdin.write(`${JSON.stringify({ command: cmd, argv, env, protocol: true })}\\n`);\n      driver.done.then(() => setTimeout(() => child.stdin.end(), 2000).unref());\n    } else child.stdin.end(JSON.stringify({ command: cmd, argv, env }));\n    let stdout = \"\";\n    let stderr = \"\";\n    let timedOut = false;\n    let outputExceeded = false;\n    let outputBytes = 0;\n    const collect = (target, chunk) => {\n      outputBytes += chunk.length;\n      // A T3 protocol session over 60+ steps is verbose; its cap is larger but still bounded.\n      if (outputBytes > (driver ? 50_000_000 : 2_000_000)) {\n        outputExceeded = true;\n        killGroup(\"SIGKILL\");\n        return;\n      }\n      if (target === \"stdout\") stdout += chunk;\n      else stderr += chunk;\n    };\n    child.stdout.removeAllListeners(\"data\");\n    child.stderr.removeAllListeners(\"data\");\n    child.stdout.on(\"data\", (c) => collect(\"stdout\", c));\n    child.stderr.on(\"data\", (c) => collect(\"stderr\", c));\n    if (driver) {\n      // Registered after the collectors above (which reset the stream's listeners): every protocol line reaches the driver.\n      let pending = \"\";\n      const decoder = new StringDecoder(\"utf8\"); // a chunk can end inside a multibyte character\n      child.stdout.on(\"data\", (chunk) => {\n        pending += decoder.write(chunk);\n        let newline;\n        while ((newline = pending.indexOf(\"\\n\")) >= 0) { driver.handleLine(pending.slice(0, newline)); pending = pending.slice(newline + 1); }\n      });\n    }\n    // The whole process group: agents start helpers (servers, shells) that must not outlive the run.\n    // Under the resource contract the cgroup is emptied instead, so the supervisor survives to report cleanup.\n    const killGroup = (sig) => {\n      if (containment) return containment.kill();\n      try {\n        process.kill(-child.pid, sig);\n      } catch {}\n    };\n    const timer = setTimeout(() => {\n      timedOut = true;\n      killGroup(\"SIGTERM\");\n      setTimeout(() => killGroup(\"SIGKILL\"), 10_000).unref();\n    }, (budget.minutes + 5) * 60_000);\n    child.on(\"error\", (err) => (stderr += `spawn error: ${err.message}\\n`));\n    child.on(\"close\", async (code) => {\n      clearTimeout(timer);\n      killGroup(\"SIGKILL\");\n      const final = containment ? await containment.final : undefined;\n      const json = driver ? { turn: driver.state.objectiveTurns.at(-1) ?? null } : lastJson(stdout);\n      resolve({ code, timedOut, outputExceeded, stdout, stderr, json, ...(driver ? { t3Driver: driver.state, t3Preconditions: preconditions } : {}), ...(containment ? { resources: final, containmentProblem: containmentProblem(final) } : {}) });\n    });\n  });\n}\n\nfunction runCheck(task, ws, check, hidden, { readOnlyHidden = false } = {}) {\n  if (hidden && check.protocol === \"blackbox-v1\") {\n    return runBlackBoxOracle(task, ws, check, { resources: config.resources ?? null }).then((result) => ({\n      ...result,\n      status: result.pass ? 0 : 1,\n      output: JSON.stringify({\n        cases: result.cases,\n        failedCases: result.failedCases,\n        timeoutCases: result.timeoutCases,\n        outputLimitCases: result.outputLimitCases,\n        executionFailureCases: result.executionFailureCases,\n        invalidOutputCases: result.invalidOutputCases,\n        mismatchCases: result.mismatchCases,\n        outcome: result.outcome,\n      }),\n    }));\n  }\n  if (hidden && config.qualification === true) {\n    throw new Error(\"qualification refuses in-process legacy hidden validators; use the isolated blackbox-v1 oracle\");\n  }\n  const hiddenSubpaths = [];\n  if (hidden && check.dir) {\n    const source = confinedPath(task.dir, check.dir);\n    hiddenSubpaths.push(...stageHiddenFiles(source, ws, check.into ?? check.dir, { readOnlyHidden }));\n  }\n  const command = check.command;\n  return runIsolated(command, { cwd: ws, home: true, timeoutSec: check.timeoutSec ?? 300, outputLimit: 1_000_000, resources: config.resources ?? null, protectedCorpusPaths: protectedCorpusPathsForRun(), hiddenSubpaths: hidden && readOnlyHidden ? hiddenSubpaths : [], readOnlySubpaths: hidden && readOnlyHidden ? [] : hiddenSubpaths })\n    .then((r) => {\n      const output = `${r.stdout}${r.stderr}`;\n      // Qualification keeps hidden-test output out of the evidence: it would disclose the sealed tests.\n      const kept = hidden && config.qualification === true\n        ? JSON.stringify({ status: r.status, timedOut: r.timedOut, overflow: r.overflow, bytes: Buffer.byteLength(output), outputSha256: createHash(\"sha256\").update(output).digest(\"hex\") })\n        : output.slice(-20_000);\n      const vacuousHiddenPass = hidden && readOnlyHidden && !hiddenOutputHasTests(output);\n      return { pass: r.status === 0 && !r.timedOut && !r.overflow && !vacuousHiddenPass, status: r.status, timedOut: r.timedOut, overflow: r.overflow, output: kept, resources: r.resources ?? null, containmentProblem: r.containmentProblem ?? null };\n    });\n}\n\nfunction saveLogs(task, run, agent, hidden, regression) {\n  const dir = path.join(args.out, \"logs\", `${task.id}-${run}`);\n  fs.mkdirSync(dir, { recursive: true });\n  fs.writeFileSync(path.join(dir, \"agent.stdout.json\"), agent.stdout);\nconst caBundle = caFile ? writeCaBundle(caFile) : null;\n\n// A run is valid only with well-formed tasks, hidden tests the agent cannot read, and (for qualification) a model\n// identified beyond its alias. Any problem stops the run before an agent starts (eval/validate.mjs).\nconst problems = taskRecords.flatMap(({ id, dir, task }) => {\n  return validateTask(task, dir, { qualification: config.qualification === true }).map((p) => `${id}: ${p}`);\n});\nconst isolation = hiddenTestIsolationProblem(config, tasksDir);\nif (isolation) problems.push(isolation);\n// Qualification proves the resource contract inside hiddenTestIsolationProblem; a development config may opt in.\nif (config.resources !== undefined && config.qualification !== true) {\n  const resourceProblem = resourceProbeProblem(config.resources);\n  if (resourceProblem) problems.push(resourceProblem);\n}\nif (config.resources !== undefined && args.keep) problems.push(\"--keep would accumulate run workspaces on the size-capped resources.workspaceRoot\");\nif (config.qualification === true) {\n  const corpusProblem = corpusManifestProblem(config, tasksDir, tasks, corpusTaskRows(taskSnapshots, tasks));\n  if (corpusProblem) problems.push(corpusProblem);\n}\nif (config.qualification === true && config.sampling?.temperature !== 0) {\n  problems.push(\"qualification adapters require sampling.temperature=0 so the matched Nexus, Goose and OpenCode runs use the same deterministic setting\");\n}\nif (config.qualification === true) {\n  const budgetProblem = qualificationBudgetProblem(config);\n  if (budgetProblem) problems.push(budgetProblem);\n}\nconst agentIdentity = problems.length ? { record: null, problem: null } : await resolveAgentIdentity(config);\nif (agentIdentity.problem) problems.push(agentIdentity.problem);\nlet fingerprint = null;\nif (!problems.length) {\n  const probe = config.proxy === false ? null : await startModelProxy({ upstream: config.endpoint, caFile });\n  try {\n    const entry = await fetchModelEntry(probe?.url ?? config.endpoint, config.model, apiKey);\n    const fp = modelFingerprint(config, entry);\n    fingerprint = fp.fingerprint;\n    problems.push(...fp.missing.map((m) => `model fingerprint: ${m}`));\n    if (config.qualification === true && (config.agent ?? \"nexus\") === \"nexus\") {\n      const limitsProblem = nexusLimitsProblem(config, entry);\n      if (limitsProblem) problems.push(limitsProblem);\n    }\n  } finally {\n    await probe?.close();\n  }\n}\nif (problems.length) {\n  console.error(`eval/run.mjs: not starting; ${problems.length} problem(s):\\n${problems.map((p) => `  - ${p}`).join(\"\\n\")}`);\n  process.exit(2);\n}\nconst frozenTaskRows = taskRecords.map(({ id }) => corpusTaskRows(taskSnapshots, [id])[0]);\nfs.writeFileSync(path.join(args.out, \"manifest.json\"), JSON.stringify({\n  createdAt: new Date().toISOString(),\n  harness: identity,\n  config: redactConfig(config),\n  configSha256,\n  qualificationCorpus: config.qualification === true ? { manifestSha256: config.corpusManifestSha256, tasks: frozenTaskRows } : null,\n  fingerprint,\n  agentVersion: agentIdentity.record,\n  budget: effectiveBudget({}, config),\n  runs,\n  tasks: frozenTaskRows,\n  host: os.hostname(),\n  node: process.version,\n}, null, 2) + \"\\n\");\n\n// Run-major order (every task once, then again): a pass cut short still has the same number of runs per task.\nfor (let run = 1; run <= runs; run++) {\n  for (const { id, dir, treeSha256, task: taskData } of taskRecords) {\n    if (pairs && !pairs.some(([t, r]) => t === id && Number(r) === run)) continue;\n    if (taskTreeDigest(dir) !== treeSha256) throw new Error(`frozen task ${id} changed after manifest creation`);\n    const task = { ...taskData, dir };\n    const record = await runOnce(task, run);\n    fs.appendFileSync(resultsFile, JSON.stringify(record) + \"\\n\");\n    console.log(`${new Date().toISOString()} ${config.name} ${id} run ${run}: ${record.turn?.outcome ?? record.error ?? `exit ${record.exitCode}`} hidden=${record.hiddenPass} regression=${record.regressionPass} ${Math.round(record.wallMs / 1000)}s`);\n  }\n}\n\n{\n  \"id\": \"selftest-add\",\n  \"tier\": \"T1\",\n  \"description\": \"Harness self-test (scripted model): an unrelated green suite must not make a wrong deliverable VERIFIED.\",\n  \"fixture\": \"repo\",\n  \"objective\": \"1. Add math.js exporting add(a, b) that returns a + b.\",\n  \"steps\": 20,\n  \"minutes\": 5,\n  \"hidden\": { \"dir\": \"hidden\", \"into\": \"hidden\", \"command\": \"node hidden/math.hidden.test.js\" },\n  \"regression\": { \"command\": \"npm test --silent\" }\n}\n","exit_code":0,"duration":{"secs":0,"nanos":839331015}},"started_at_ms":1792914286811,"completed_at_ms":1792914287651}}
