n\"];\n62:    need(Array.isArray(task.faults) && task.faults.every((f) => kinds.includes(f?.kind) && Number.isInteger(f?.atRequest) && f.atRequest >= 1), `faults must be [{ kind: ${kinds.join(\"|\")}, atRequest: n >= 1 }]`);\n63-  }\n64:  if (task.class !== undefined || qualification) need(CLASSES.includes(task.class), `class must be one of ${CLASSES.join(\", \")}`);\n65:  if (task.difficulty !== undefined || qualification) need(DIFFICULTIES.includes(task.difficulty), `difficulty must be one of ${DIFFICULTIES.join(\", \")}`);\n66-  return problems;\n67-}\n--\n320-  return [...ids].sort().map((id) => {\n321-    const dir = confinedPath(tasksDir, id);\n322:    const taskFile = confinedPath(dir, \"task.json\");\n323-    const treeSha256 = taskTreeDigest(dir);\n324-    const taskSha256 = createHash(\"sha256\").update(fs.readFileSync(taskFile)).digest(\"hex\");\n--\n328-\n329-const HELDOUT_V2_HASH_SCHEME = {\n330:  task_sha256: \"sha256 of raw tasks/<id>/task.json bytes\",\n331-  hidden_sha256: \"sha256 of sorted '<path>  <sha256(file)>\\\\n' lines over tasks/<id>/<hidden.dir> (bin/hidden_digest.mjs)\",\n332-};\n--\n355-/**\n356- * The sealed T2 corpus (eval/heldout-manifest.json) uses the custodian's heldout-v2 schema, which binds each task's\n357: * task.json and hidden directory and carries no custody fields: custody is stated in the frozen config (corpusCustody)\n358- * with the committed custody report pinned by digest; the reviewer still verifies the report's content.\n359: * Limit: the manifest binds task.json and hidden.dir only, not other files in a task directory.\n360- */\n361-function heldoutV2ManifestProblem(config, tasksDir, ids, manifest) {\n--\n374-    try {\n375-      const dir = confinedPath(tasksDir, row.id);\n376:      const taskFile = confinedPath(dir, \"task.json\");\n377-      const raw = fs.readFileSync(taskFile);\n378:      if (createHash(\"sha256\").update(raw).digest(\"hex\") !== row.task_sha256) return `task ${row.id}: task.json differs from t