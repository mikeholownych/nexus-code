ndidate entrypoint/);\n });\n \n+test(\"T4 fixture evidence is derived from the exact tool transcript and resource boundary\", async () => {\n+  const { observeT4Fixture } = await import(path.join(ROOT, \"eval/t4_fixtures.mjs\"));\n+  const task = { tier: \"T4\", t4Fixture: { kind: \"hanging_test_command\", tool: \"run_command\", command: \"npm test\", timeoutSecs: 30 } };\n+  const call = { id: \"call-1\", type: \"function\", function: { name: \"run_command\", arguments: JSON.stringify({ command: \"npm test\", timeout_secs: 30 }) } };\n+  const agent = { json: { messages: [{ role: \"assistant\", tool_calls: [call] }, { role: \"tool\", tool_call_id: \"call-1\", content: \"Command timed out after 30 seconds.\" }] } };\n+  const containment = { cleaned: true, survivorsAfterExit: 0 };\n+  const hang = observeT4Fixture(task, agent, containment, { storageBytes: 64 * 1024 * 1024 });\n+  assert.equal(hang[0].evidence.observedHung, true);\n+  assert.equal(observeT4Fixture(task, { ...agent, json: { messages: [] } }, containment, {}).length, 0);\n+  assert.equal(observeT4Fixture(task, agent, { cleaned: false, survivorsAfterExit: 1 }, {}).at(0).evidence.containmentCleaned, false);\n+\n+  const diskTask = { tier: \"T4\", t4Fixture: { kind: \"full_disk\", tool: \"run_command\", command: \"./test-disk-cap.sh\", storageLimitBytes: 64 * 1024 * 1024 } };\n+  const diskCall = { id: \"call-2\", type: \"function\", function: { name: \"run_command\", arguments: JSON.stringify({ command: \"./test-disk-cap.sh\", timeout_secs: 30 }) } };\n+  const diskAgent = { json: { messages: [{ role: \"assistant\", tool_calls: [diskCall] }, { role: \"tool\", tool_call_id: \"call-2\", content: \"write failed: ENOSPC\" }] } };\n+  assert.equal(observeT4Fixture(diskTask, diskAgent, containment, { storageBytes: 64 * 1024 * 1024 })[0].evidence.writeFailedWithEnospc, true);\n+  assert.equal(observeT4Fixture(diskTask, diskAgent, containment, { storageBytes: 128 * 1024 * 1024 })[0].evidence.storageLimitBytes, null);\n+});\n+\n test(\"black-box oracle keeps canary expectations outside the candidate process and returns sanitized evidence\", { timeout: 15_000 }, async () => {\n   const { runBlackBoxOracle } = await import(path.join(ROOT, \"eval/oracle.mjs\"));\n   const taskDir = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-private-task-\"));\ndiff --git a/eval/README.md b/eval/README.md\nindex 484673f..07264b8 100644\n--- a/eval/README.md\n+++ b/eval/README.md\n@@ -104,7 +104,12 @@ What was injected is recorded in `model.faultsInjected`. Such runs are never tre\n - hung past budget.\n \n The remaining T4 classes come from task fixtures (a hanging test command, a full disk) and from the SIGTERM-then-resume\n-runner case. `make test` includes a T4 smoke test with two injected faults (`cli/test/eval_harness.test.ts`).\n+runner case. A fixture task declares `t4Fixture: { kind, tool: \"run_command\", command, timeoutSecs }` for a hanging\n+test, or `t4Fixture: { kind: \"full_disk\", tool: \"run_command\", command, storageLimitBytes }` for a full disk. The\n+runner counts a fixture only when the candidate's structured transcript contains that exact command, the tool result\n+shows the timeout or ENOSPC condition, and the task process cgroup reports successful cleanup with no survivors. The\n+full-disk limit must match the frozen resource contract. Task metadata identifies the expected fixture; it cannot\n+provide evidence or a pass bit. `make test` includes a T4 smoke test with two injected faults (`cli/test/eval_harness.test.ts`).\n \n ## Qualification runs\n \ndiff --git a/eval/run.mjs b/eval/run.mjs\nindex 50eec08..c47a4c5 100644\n--- a/eval/run.mjs\n+++ b/eval/run.mjs\n@@ -18,6 +18,7 @@ import { applyAgentChanges, cloneWorkspace } from \"./hardened_check.mjs\";\n import { containmentProblem, resourceProbeProblem, spawnContained } from \"./resources.mjs\";\n import { StringDecoder } from \"node:string_decoder\";\n import { commandBaseline, countCompactions, createT3Driver, sc