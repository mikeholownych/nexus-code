erred`: the turn was finishing; it\n * starts a follow-up turn. `cancelled`: the turn ended first; `text` is returned to the operator. `rejected`: nothing\n * it could steer (a command is running); `text` is returned. `duplicate`: this id was already received.\n */\nexport type SteerStatus = \"queued\" | \"applied\" | \"deferred\" | \"cancelled\" | \"rejected\" | \"duplicate\";\n\n/** One entry of a resumed conversation: a message, a tool the agent called, or the last turn's outcome. */\nexport interface HistoryEntry {\n  role: \"user\" | \"assistant\" | \"steering\" | \"tool\" | \"outcome\";\n  text: string;\n  tool?: string;\n  heading?: string;\n  turn?: TurnResult;\n}\n\nexport interface ModelSummary {\n  summary: string;\n  notes?: string;\n}\n\nexport type SidecarEvent =\n  | { type: \"hello\"; protocol: number; pid: number; commands: Array<Pick<SlashSpec, \"name\" | \"usage\" | \"summary\">> }\n  | {\n      type: \"session.state\";\n      workspace: string;\n      workspace_name: string;\n      model: string;\n      mode: \"auto\" | \"review\" | \"read-only\";\n      git: { branch: string; dirty: number } | null;\n      busy: boolean;\n      /** The id the session is saved under (shown so it can be resumed or referred to). */\n      session?: string;\n      posture?: {\n        mode: \"auto\" | \"review\" | \"read-only\";\n        sandbox: string;\n        trusted: boolean;\n      };\n    }\n  | { type: \"assistant.delta\"; turn_id: string; text: string }\n  /** What the running turn is doing; sent on every phase change, independent of model output. */\n  | {\n      type: \"activity\";\n      turn_id: string;\n      phase: string;\n      step: number;\n      segment: number;\n      tool?: string;\n      subject?: string;\n      /** The turn's budget: total steps across segments, and the wall-clock limit in minutes (when continuation is on). */\n      max_steps?: number;\n      payload: sanitizedPayload,\n    };\n    try {\n      appendPrivateFile(this.flightLogPath, JSON.stringify(event) + \"\\n\");\n    } catch {\n      // Ignore flightlog append errors in restricted environments\n    }\n    return event;\n  }\n\n  public startSession(config: {\n    model: string;\n    endpoint: string;\n    taskPrompt?: string;\n  }): FlightManifest {\n    this.isRecording = true;\n    this.startTime = Date.now();\n\n    let initialCommit: string | undefined;\n    let initialBranch: string | undefined;\n\n    try {\n      initialCommit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], {\n        cwd: this.workspace,\n        encoding: \"utf-8\",\n        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n      }).trim();\n      initialBranch = execFileSync(\"git\", [\"rev-parse\", \"--abbrev-ref\", \"HEAD\"], {\n        cwd: this.workspace,\n        encoding: \"utf-8\",\n        stdio: [\"ignore\", \"pipe\", \"ignore\"],\n      }).trim();\n    } catch {}\n\n    const manifest: FlightManifest = {\n      flightId: this.flightId,\n      recordedAt: new Date().toISOString(),\n      workspace: this.workspace,\n      model: config.model,\n      endpoint: config.endpoint,\n      initialCommit,\n      initialBranch,\n      taskPrompt: config.taskPrompt,\n      status: \"in_progress\",\n    };\n\n    this.appendEvent(\"session_start\", 0, manifest);\n    return manifest;\n  }\n\n  public recordTurnStart(step: number, taskPrompt: string): FlightEvent {\n    return this.appendEvent(\"turn_start\", step, { prompt: taskPrompt });\n  }\n\n  public recordThought(step: number, thoughtText: string, reasoningText?: string): FlightEvent {\n    return this.appendEvent(\"thought\", step, {\n      thought: thoughtText,\n      reasoning: reasoningText,\n    });\n  }\n\n  public recordToolCall(step: number, callId: string, toolName: string, args: Record<string, any>): FlightEvent {\n    return this.appendEvent(\"tool_call\", step, {\n      callId,\n      toolName,\n      arguments: args,\n    });\n  }\n\n  public recordToolResult(\n    step: number,\n    callId: string,\n    toolName: string,\n    success: boolean,\n    output: string,\n    durationMs: number,\n    error?: string,\n  ): FlightEvent {\n    return this.appendEvent(\"tool_result\", step, {\n      callId,\n      toolName,\n","exit_code":0,"duration":{"secs":0,"nanos":37734}},"started_at_ms":1792916766269,"completed_at_ms":1792916766270}}
