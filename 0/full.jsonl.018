.log(`\\nT3 · ${t3.tasks} task(s), ${t3.runs} run(s)${t3.shapeMet ? \"\" : ` (needs ${T3_TASKS} tasks × ${T3_RUNS_PER_TASK} runs)`} · ineligible (steps < 60 or compactions < 2, or no result) ${t3.ineligible} · false absences ${t3.falseAbsences} · false presences ${t3.falsePresences} · contaminated ${t3.contaminated} · probe unanswered ${t3.probeUnanswered} · steering honoured ${t3.steeringHonoured}/${t3.steeringItems} (${pct(t3.steeringRate)}) · gate ${t3.gate}`);\n  }\n  if (replacements.length) {\n    console.log(\"\\nReplaced by rerun:\");\n    for (const r of replacements) console.log(`- ${r.config} ${formatTaskId(r.task)} run ${r.run}: ${r.was} → ${r.now}`);\n  }\n  if (peerComparison) {\n    console.log(`\\nMatched peer comparison · ${peerComparison.matchedRuns} runs · model ${peerComparison.model.alias}`);\n    for (const [agent, version] of Object.entries(peerComparison.versions)) console.log(`- ${agent}: ${version}`);\n    console.log(\"| task | runs | Nexus correct | Goose correct | OpenCode correct |\\n|---|---:|---:|---:|---:|\");\n    for (const task of peerComparison.tasks) console.log(`| ${formatTaskId(task.task)} | ${task.runs} | ${task.correct.nexus} | ${task.correct.goose} | ${task.correct.opencode} |`);\n  }\n  console.log(\"\");\n  console.log(\"| config | task | tier | n | claimed | correct (95% CI) | false VERIFIED | regressions | timed out | contaminated | median wall s | median steps | median tokens |\");\n  console.log(\"|---|---|---|---|---|---|---|---|---|---|---|---|---|\");\n  for (const r of rows) {\n    console.log(`| ${r.config} | ${formatTaskId(r.task)} | ${r.tier} | ${r.n} | ${r.claimed} | ${r.correct} (${pct(r.correctCI[0])}–${pct(r.correctCI[1])}) | ${r.falseVerified} | ${r.regressions} | ${r.timedOut} | ${r.contaminated} | ${r.medianWallS?.toFixed(0) ?? \"–\"} | ${r.medianSteps ?? \"–\"} | ${r.medianTokens ?? \"–\"} |`);\n  }\n}\n\nfunction validateMatchedPeers(paths) {\n  if (paths.length !== 3) failPairs(\"expected exactly three result files (Nexus, Goose, OpenCode)\");\n  const inputs = paths.map((file) => {\n    const manifestPath = path.join(path.dirname(path.resolve(file)), \"manifest.json\");\n    let manifest;\n    try {\n      manifest = JSON.parse(fs.readFileSync(manifestPath, \"utf8\"));\n    } catch (err) {\n      failPairs(`cannot read manifest next to ${file}: ${err.message}`);\n    }\n    const rawRecords = fs.readFileSync(file, \"utf8\").split(\"\\n\").filter(Boolean).map((line) => JSON.parse(line));\n    // A permitted infrastructure rerun replaces that config/task/run, just as it does in the pooled score below.\n","exit_code":0,"duration":{"secs":0,"nanos":763827230}},"started_at_ms":1792914082998,"completed_at_ms":1792914083763}}
