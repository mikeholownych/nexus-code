or(\"compiler inventory enumeration failed\");\n     if (directEntries.length) {\n       if (++jobCount > MAX_JOBS) throw new Error(\"compiler inventory job limit exceeded\");\n       yield directEntries;\ncommit 7fe2981d6e9a379ff06804b829cb9200fe7a8dbe\nAuthor:     Mike Holownych <mike@holownych.com>\nAuthorDate: Thu Oct 29 17:42:24 2026 +0000\nCommit:     Mike Holownych <mike@holownych.com>\nCommitDate: Thu Oct 29 17:42:24 2026 +0000\n\n    fix(eval): reject lossy compiler inventory paths\n\ndiff --git a/cli/test/eval_hardened.test.ts b/cli/test/eval_hardened.test.ts\nindex d6c88e00..06014868 100644\n--- a/cli/test/eval_hardened.test.ts\n+++ b/cli/test/eval_hardened.test.ts\n@@ -47,6 +47,83 @@ test(\"asUserSpec preserves timeout metadata and isolated processes reject missin\n   assert.throws(() => runIsolatedProcess({ cmd: \"/usr/bin/true\", argv: [], timeoutMs: 0 }), /isolated process spec has no timeoutMs/);\n });\n \n+test(\"compiler inventory exits promptly and reaps enumeration after SIGTERM\", { timeout: 90_000 }, async (t) => {\n+  if (process.platform !== \"linux\") {\n+    t.skip(\"the compiler inventory uses Linux /proc and GNU find\");\n+    return;\n+  }\n+\n+  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"compiler-inventory-cancel-\"));\n+  const scanner = path.join(ROOT, \"eval/scan-compiler-exposure.mjs\");\n+  let findPid: number | undefined;\n+  let scannerChild: ReturnType<typeof spawn> | undefined;\n+  try {\n+    for (let i = 0; i < 50_000; i++) fs.writeFileSync(path.join(root, `entry-${i}`), \"\");\n+\n+    const startedAt = Date.now();\n+    const child = spawn(process.execPath, [scanner, root], {\n+      env: { HOME: os.tmpdir(), LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n+      stdio: \"ignore\",\n+    });\n+    scannerChild = child;\n+    const exit = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => {\n+      child.once(\"close\", (code, signal) => resolve({ code, signal }));\n+    });\n+\n+    const deadline = Date.now() + 5_000;\n+    while (Date.now() < deadline && findPid === undefined) {\n+      if (child.exitCode !== null) break;\n+      const childrenPath = `/proc/${child.pid}/task/${child.pid}/children`;\n+      try {\n+        const pids = fs.readFileSync(childrenPath, \"utf8\").trim().split(/\\s+/).filter(Boolean);\n+        findPid = pids.map(Number).find((pid) => {\n+          try {\n+            const args = fs.readFileSync(`/proc/${pid}/cmdline`, \"utf8\").split(\"\\0\");\n+            return args[0] === \"/usr/bin/find\" && args.includes(\"-mindepth\") && args.includes(\"-maxdepth\");\n+          } catch {\n+            return false;\n+          }\n+        });\n+      } catch (error) {\n+        if ((error as NodeJS.ErrnoException).code !== \"ENOENT\") throw error;\n+      }\n+      if (findPid === undefined) await new Promise((resolve) => setTimeout(resolve, 5));\n+    }\n+    assert.ok(findPid !== undefined, \"the fixture should catch the root enumeration process while it is active\");\n+\n+    child.kill(\"SIGTERM\");\n+    const result = await Promise.race([\n+      exit,\n+      new Promise<never>((_, reject) => {\n+        const timeout = setTimeout(() => reject(new Error(\"compiler inventory did not stop after SIGTERM\")), 5_000);\n+        exit.finally(() => clearTimeout(timeout));\n+      }),\n+    ]);\n+    assert.notEqual(result.code, 0, \"scanner should fail closed after cancellation\");\n+    assert.ok(Date.now() - startedAt < 5_000, \"cancellation should finish within the caller's deadline\");\n+\n+    const reapDeadline = Date.now() + 2_000;\n+    while (Date.now() < reapDeadline) {\n+      try { process.kill(findPid, 0); }\n+      catch (error) {\n+        if ((error as NodeJS.ErrnoException).code === \"ESRCH\") return;\n+        throw error;\n+      }\n+      await new Promise((resolve) => setTimeout(resolve, 10));\n+    }\n+    assert.fail(`enumeration process ${findPid} survived scanner cancellation`);\n+  } finally {\n+    if (findPid !== undefined) {\n+      try { process.kill(findPid, \"SIGKILL\"); } catch { /* The child may already have exited. */ }\n+    }\n+    if (scannerChild && scannerChild.exitCode === null) {\n+      scannerChild.kill(\"SIGKILL\");\n+      await new Promise((resolve) => scannerChild?.once(\"close\", resolve));\n+    }\n+    fs.rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n test(\"test infrastructure is recognised across Python, Go, JS/TS and Rust layouts\", async () => {\n   const { isTestInfraPath } = await hardened();\n   for (const p of [\"conftest.py\", \"pkg/conftest.py\", \"pytest.ini\", \"tox.ini\", \"setup.cfg\", \"sitecustomize.py\", \"x.pth\", \"tests/test_a.py\", \"src/test_a.py\", \"a_test.py\",\ndiff --git a/cli/test/eval_integrity.test.ts b/cli/test/eval_integrity.test.ts\nindex 76df195b..ff302f1a 100644\n--- a/cli/test/eval_integrity.test.ts\n+++ b/cli/test/eval_integrity.test.ts\n@@ -569,6 +569,13 @@ test(\"Python black-box oracle uses only pinned offline Go and Rust toolchains, o\n   const aliasedExposure = scanOracleCompilerExposure([fakeSystem, fakeSystemAlias], []);\n   assert.ok(aliasedExposure.paths.includes(fakeGoTarget), \"the canonical mounted spelling is scanned and masked\");\n   assert.ok(aliasedExposure.paths.includes(path.join(fakeSystemAlias, path.relative(fakeSystem, fakeGoTarget))), \"every mounted spelling of a shared system directory is scanned and masked\");\n+  const invalidUtf8Directory = Buffer.concat([Buffer.from(fakeSystem), Buffer.from([path.sep.charCodeAt(0), 0xff])]);\n+  const invalidUtf8Compiler = Buffer.concat([invalidUtf8Directory, Buffer.from(\"/rustc\")]);\n+  fs.mkdirSync(invalidUtf8Directory);\n+  fs.writeFileSync(invalidUtf8Compiler, compilerCanary);\n+  fs.chmodSync(invalidUtf8Compiler, 0o755);\n+  const invalidUtf8Exposure = scanOracleCompilerExposure([fakeSystem], [], []);\n+  assert.match(invalidUtf8Exposure.problem ?? \"\", /compiler exposure could not be checked/, \"non-UTF-8 path bytes fail closed instead of being replaced with a different path\");\n   const fakeGoAliasTarget = path.join(fakeSystemAlias, \"lib\", \"go-1.22.12\", \"go\");\n   const maskArgs = compilerExposureMaskArgs({ paths: [fakeGoTarget, fakeGoAliasTarget, fakeCargo, fakeCargo], problem: null });\n   const maskedDestinations = maskArgs.filter((value, index) => index > 0 && maskArgs[index - 1] === \"/dev/null\");\ndiff --git a/eval/scan-compiler-exposure.mjs b/eval/scan-compiler-exposure.mjs\nindex 19a0e959..f1fd1747 100644\n--- a/eval/scan-compiler-exposure.mjs\n+++ b/eval/scan-compiler-exposure.mjs\n@@ -94,6 +94,9 @@ async function* enumerateJobs() {\n             throw new Error(\"compiler inventory entry limit exceeded\");\n           }\n           const item = field.toString(\"utf8\");\n+          if (!Buffer.from(item, \"utf8\").equals(field)) {\n+            throw new Error(\"compiler inventory path is not valid UTF-8\");\n+          }\n           let job;\n           // The `-P` inventory process reports immediate directories separately and\n           // leaves symlinks as non-directory entries, so descendants are never followed.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a188b4-bcfd-7801-8430-e45b95efb101","create_time":1793295754.9617667}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
