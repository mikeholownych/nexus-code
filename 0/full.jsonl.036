Policy.rust, /^channel = \"([^\"]+)\"$/m.exec(rustToolchain)?.[1]);\ncli/test/eval_integrity.test.ts:489:  assert.equal((workflow.match(/run: bash scripts\\/install-evaluator-toolchains\\.sh/g) ?? []).length, 2, \"both CI jobs use the same exact-version installer\");\ncli/test/eval_integrity.test.ts:556:  assert.ok(changedScan.paths.includes(introducedCompiler), \"compiler exposure is rescanned after filesystem changes\");\ncli/test/eval_integrity.test.ts:580:  const invalidRootTarget = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-invalid-candidate-toolchain-target-\"));\ncli/test/eval_integrity.test.ts:645:  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040775 }), /without group or other write permission/, \"group-writable toolchain paths must fail closed\");\ncli/test/eval_integrity.test.ts:646:  assert.match(oracleToolchainPathProblem({ uid: 0, mode: 0o040757 }), /without group or other write permission/, \"other-writable toolchain paths must fail closed\");\ncli/test/eval_integrity.test.ts:650:  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, isSymbolicLink: () => true }, \"/usr/local/nexus-qual/rust\", \"/usr/local/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject symlinked toolchain roots\");\ncli/test/eval_integrity.test.ts:651:  assert.match(candidateToolchainRootProblem({ ...candidateRootStat, mode: 0o040775 }, \"/usr/local/nexus-qual/rust\", \"/usr/local/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject group-writable toolchain roots\");\ncli/test/eval_integrity.test.ts:652:  assert.match(candidateToolchainRootProblem(candidateRootStat, \"/tmp/toolchain\", \"/usr/local/nexus-qual/rust\"), /safe real directory/, \"candidate mounts reject roots resolving outside the pinned path\");\ncli/test/eval_integrity.test.ts:653:  const taskDir = fs.mkdtempSync(path.join(os.tmpdir(), \"eval-oracle-toolchain-task-\"));\ncli/test/eval_integrity.test.ts:654:  const workspace = fs.mkdtempSync(path.