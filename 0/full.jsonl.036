\"$(dirname \"$0\")\" && pwd)\"\n+log=\"$here/ubuntu-22-04-node22-incompatible-downgrade.log\"\n+fixture=/var/tmp/nexus-incompat-fixture/release\n+[ -d \"$fixture\" ] || { echo \"missing fixture at $fixture\" >&2; exit 2; }\n+[ -f /tmp/nexus-install.sh ] || { echo \"missing installer at /tmp/nexus-install.sh\" >&2; exit 2; }\n+docker run --rm --pull=never --network bridge \\\n+  --mount \"type=bind,src=/tmp/nexus-install.sh,dst=/tmp/nexus-install.sh,readonly\" \\\n+  --mount \"type=bind,src=$here/incompatible-server.js,dst=/tmp/server.js,readonly\" \\\n+  --mount \"type=bind,src=$fixture,dst=/tmp/incompat-fixture,readonly\" \\\n+  nexus-e2/ubuntu-22-04-node22:prep-182e8addeee0 sh -ec '\n+  set -eu\n+  export PATH=\"$HOME/.local/bin:$PATH\"\n+  NEXUS_VERSION=v1.0.0-rc.10 NEXUS_VERIFY_ATTESTATION=0 sh /tmp/nexus-install.sh >/tmp/install.log 2>&1\n+  test \"$(nexus --version)\" = \"1.0.0-rc.10 (16ee8ca36438)\"\n+  installed=\"$HOME/.local/lib/nexus/v1.0.0-rc.10/lib/cli/dist/index.js\"\n+  before=$(sha256sum \"$installed\" | cut -d\" \" -f1)\n+  link_before=$(readlink -f \"$HOME/.local/bin/nexus\")\n+  node -e \"const c=require(\\\"/tmp/incompat-fixture/download/v1.0.0-rc.4/compatibility.json\\\");if(c.compatibility.stateSchemaVersion!==1||c.version!==\\\"1.0.0-rc.4\\\")process.exit(1)\"\n+  rm -f /tmp/incompat-port\n+  node /tmp/server.js >/tmp/server.log 2>&1 & server_pid=$!\n+  trap '\\''kill \"$server_pid\" 2>/dev/null || true; wait \"$server_pid\" 2>/dev/null || true'\\'' EXIT\n+  for i in $(seq 1 50); do [ -s /tmp/incompat-port ] && break; sleep 0.1; done\n+  port=$(cat /tmp/incompat-port); test -n \"$port\"\n+  set +e\n+  NEXUS_RELEASES_API=\"http://127.0.0.1:$port/api/releases\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$port\" \\\n+  NEXUS_VERIFY_ATTESTATION=0 nexus upgrade --version v1.0.0-rc.4 --allow-downgrade --yes >/tmp/upgrade.log 2>&1\n+  rc=$?\n+  set -e\n+  cat /tmp/upgrade.log\n+  test \"$rc\" -ne 0\n+  grep -F \"Downgrade refused: Target version v1.0.0-rc.4 uses state schema version 1, which cannot read current state schema version 2\" /tmp/upgrade.log >/dev/null\n+  test \"$(nexus --version)\" = \"1.0.0-rc.10 (16ee8ca36438)\"\n+  test \"$(readlink -f \"$HOME/.local/bin/nexus\")\" = \"$link_before\"\n+  test \"$(sha256sum \"$installed\" | cut -d\" \" -f1)\" = \"$before\"\n+  test ! -e \"$HOME/.local/lib/nexus/v1.0.0-rc.4\"\n+  echo \"incompatible_downgrade=PASS refused=true state_schema=1 current_schema=2 existing_install_unchanged=true\"\n+  ' > \"$log\" 2>&1\n+cat \"$log\"\ndiff --git a/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/run-process-crash-recovery.sh b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/run-process-crash-recovery.sh\nindex e88087de..79f7db76 100755\n--- a/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/run-process-crash-recovery.sh\n+++ b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/run-process-crash-recovery.sh\n@@ -50,9 +50,10 @@ docker run --rm --pull=never --network bridge \\\n    test \"$(sha256sum \"$installed\" | cut -d\" \" -f1)\" = \"$original_sha\"\n    test \"$(sha256sum \"$HOME/.nexus/tasks/marker\")\" = \"$state_before\"\n    test \"$(nexus --version)\" = \"1.0.0-rc.10 (16ee8ca36438)\"\n-   node -e \"const fs=require(\\\"node:fs\\\");const j=JSON.parse(fs.readFileSync(process.env.HOME+\\\"/.local/lib/nexus/.upgrade-journal.json\\\",\\\"utf8\\\"));if(j.state!==\\\"rolled_back\\\")process.exit(1);if(!fs.existsSync(j.displacedTargetDir))process.exit(2);console.log(\\\"post-recovery journal=\\\"+j.state+\\\" failed_target_retained=true\\\")\"\n+   node -e \"const fs=require(\\\"node:fs\\\");const j=JSON.parse(fs.readFileSync(process.env.HOME+\\\"/.local/lib/nexus/.upgrade-journal.json\\\",\\\"utf8\\\"));if(j.state!==\\\"rolled_back\\\")process.exit(1);if(!fs.existsSync(j.displacedTargetDir))process.exit(2);if(!j.stagingDir)process.exit(3);if(fs.existsSync(j.stagingDir))process.exit(3);conso