{"timestamp":"2026-10-29T17:29:17.825Z","ordinal":493963,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a188b4-bcfd-7801-8430-e45b95efb101","item":{"type":"CommandExecution","id":"exec-42921e3e-55a0-4832-9857-0b1f4b7e5d09","process_id":"3545","command":["/usr/bin/zsh","-lc","git -C /home/mike/nexus-wt/eval-agent-toolchain-binds diff -- eval/scan-compiler-exposure.mjs; git -C /home/mike/nexus-wt/eval-agent-toolchain-binds diff --stat"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git -C /home/mike/nexus-wt/eval-agent-toolchain-binds diff -- eval/scan-compiler-exposure.mjs; git -C /home/mike/nexus-wt/eval-agent-toolchain-binds diff --stat"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"diff --git a/eval/scan-compiler-exposure.mjs b/eval/scan-compiler-exposure.mjs\nindex c69eba4c..69a257c9 100644\n--- a/eval/scan-compiler-exposure.mjs\n+++ b/eval/scan-compiler-exposure.mjs\n@@ -1,13 +1,15 @@\n-// Run one trusted GNU find inventory per canonical system root. These roots are\n-// independent. Large roots are split at their immediate children so a single\n-// broad directory cannot monopolize one worker and exceed the inventory deadline.\n-import fs from \"node:fs\";\n+// Run trusted GNU find inventories across canonical system roots. Large roots are\n+// split at their immediate children so a broad directory cannot monopolize a worker.\n+import { opendir } from \"node:fs/promises\";\n import { spawn } from \"node:child_process\";\n import path from \"node:path\";\n \n const FIND = \"/usr/bin/find\";\n const MAX_OUTPUT = 64 * 1024 * 1024;\n const TIMEOUT_MS = 25_000;\n+const MAX_ENTRIES = 500_000;\n+const MAX_JOBS = 100_000;\n+const DIRECT_ENTRY_BATCH_SIZE = 256;\n const COMPILER_NAMES = [\n   \"go\", \"go[0-9]*\", \"go-[0-9]*\",\n   \"rustc\", \"rustc[0-9]*\", \"rustc-[0-9]*\",\n@@ -40,6 +42,41 @@ if (roots.length === 0 || roots.length > 128 || roots.some((root) => !root.start\n   process.exit(2);\n }\n \n+async function* enumerateJobs() {\n+  let entryCount = 0;\n+  let jobCount = 0;\n+  for (const root of roots) {\n+    const directory = await opendir(root);\n+    let directEntries = [];\n+    for await (const entry of directory) {\n+      if (++entryCount > MAX_ENTRIES) throw new Error(\"compiler inventory entry limit exceeded\");\n+      const item = path.join(root, entry.name);\n+      // Never follow symlinked directories. GNU find receives symlinks as starting\n+      // points under -P and checks their names and link targets without traversal.\n+      let job;\n+      if (entry.isDirectory()) {\n+        job = [item];\n+      } else {\n+        directEntries.push(item);\n+        if (directEntries.length === DIRECT_ENTRY_BATCH_SIZE) {\n+          job = directEntries;\n+          directEntries = [];\n+        }\n+      }\n+      if (job) {\n+        if (++jobCount > MAX_JOBS) throw new Error(\"compiler inventory job limit exceeded\");\n+        yield job;\n+      }\n+    }\n+    if (directEntries.length) {\n+      if (++jobCount > MAX_JOBS) throw new Error(\"compiler inventory job limit exceeded\");\n+      yield directEntries;\n+    }\n+  }\n+}\n+\n+const jobs = enumerateJobs();\n+\n const children = new Set();\n const outputs = [];\n let outputBytes = 0;\n@@ -51,6 +88,7 @@ function stopAll() {\n   if (stopping) return;\n   stopping = true;\n   for (const child of children) child.kill(\"SIGTERM\");\n+  void jobs.return().catch(() => {});\n   killTimer = setTimeout(() => {\n     for (const child of children) child.kill(\"SIGKILL\");\n   }, 1_000);\n@@ -110,49 +148,21 @@ function scanRoots(roots) {\n   });\n }\n \n-const jobs = [];\n-let entryCount = 0;\n-for (const root of roots) {\n-  let entries;\n-  try {\n-    entries = fs.readdirSync(root, { withFileTypes: true });\n-  } catch {\n-    failed = true;\n-    stopAll();\n-    break;\n-  }\n-  const directEntries = [];\n-  for (const entry of entries) {\n-    if (++entryCount > 500_000) {\n+async function worker() {\n+  while (!failed) {\n+    try {\n+      const next = await jobs.next();\n+      if (failed || next.done) return;\n+      await scanRoots(next.value);\n+    } catch {\n       failed = true;\n       stopAll();\n-      break;\n+      return;\n     }\n-    const item = path.join(root, entry.name);\n-    // Never follow symlinked directories. GNU find receives symlinks as starting\n-    // points under -P and checks their names and link targets without traversal.\n-    if (entry.isDirectory()) jobs.push([item]);\n-    else directEntries.push(item);\n-  }\n-  for (let offset = 0; offset < directEntries.length; offset += 256) {\n-    jobs.push(directEntries.slice(offset, offset + 256));\n-  }\n-  if (failed || jobs.length > 100_000) {\n-    failed = true;\n-    stopAll();\n-    break;\n-  }\n-}\n-\n-let nextJob = 0;\n-async function worker() {\n-  while (!failed && nextJob < jobs.length) {\n-    const job = jobs[nextJob++];\n-    await scanRoots(job);\n   }\n }\n \n-await Promise.all(Array.from({ length: Math.min(4, jobs.length) }, () => worker()));\n+await Promise.all(Array.from({ length: 4 }, () => worker()));\n clearTimeout(deadline);\n clearTimeout(killTimer);\n if (failed) {\n eval/scan-compiler-exposure.mjs | 92 +++++++++++++++++++++++------------------\n 1 file changed, 51 insertions(+), 41 deletions(-)\n","exit_code":0,"duration":{"secs":0,"nanos":61161}},"started_at_ms":1793294957824,"completed_at_ms":1793294957825}}
