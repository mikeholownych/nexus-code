T16:20:16Z\",\"status\":\"in_progress\",\"steps\":[{\"completedAt\":\"2026-10-29T16:20:18Z\",\"conclusion\":\"success\",\"name\":\"Set up job\",\"number\":1,\"startedAt\":\"2026-10-29T16:20:17Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T16:20:20Z\",\"conclusion\":\"success\",\"name\":\"Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":2,\"startedAt\":\"2026-10-29T16:20:18Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T16:20:43Z\",\"conclusion\":\"success\",\"name\":\"Run sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\",\"number\":3,\"startedAt\":\"2026-10-29T16:20:20Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T16:20:51Z\",\"conclusion\":\"success\",\"name\":\"Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":4,\"startedAt\":\"2026-10-29T16:20:43Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T16:21:01Z\",\"conclusion\":\"success\",\"name\":\"Install pinned evaluator toolchains\",\"number\":5,\"startedAt\":\"2026-10-29T16:20:51Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T16:21:03Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-bubblewrap.sh\",\"number\":6,\"startedAt\":\"2026-10-29T16:21:01Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-29T16:21:04Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-user-cgroups.sh\",\nPR318:\n{\"baseRefOid\":\"14be4b8a2fc56c00e638bc7fd41eadcdf5aa91fd\",\"headRefOid\":\"1682dcb325cea7078e193d0ed0b5af5325ce8ca8\",\"reviewDecision\":\"\",\"state\":\"OPEN\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-29T15:56:58Z\",\"conclusion\":\"FAILURE\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40903691542/job/123552547001\",\"name\":\"test-matrix (22)\",\"startedAt\":\"2026-10-29T15:38:57Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-29T15:40:23Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40903691359/job/123552547867\",\"name\":\"javascript-typescript\",\"startedAt\":\"2026-10-29T15:38:58Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CodeQL\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-29T16:04:24Z\",\"conclusion\":\"FAILURE\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40903691542/job/123552546714\",\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-29T15:38:57Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-29T16:04:24Z\",\"conclusion\":\"SKIPPED\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40903691542/job/123567665825\",\"name\":\"linux-x86_64\",\"startedAt\":\"2026-10-29T16:04:25Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-29T16:05:17Z\",\"conclusion\":\"FAILURE\",\"detailsUrl\":\"https://entire.com/gh/mikeholownych/-/trails/33/changes/nexus-code/33\",\"name\":\"Entire Gates\",\"startedAt\":\"2026-10-29T15:38:56Z\",\"status\":\"COMPLETED\",\"workflowName\":\"\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-29T15:40:17Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/runs/123553315099\",\"name\":\"CodeQL\",\"startedAt\":\"2026-10-29T15:40:14Z\",\"status\":\"COMPLETED\",\"workflowName\":\"\"},{\"__typename\":\"StatusContext\",\"context\":\"CodeRabbit\",\"startedAt\":\"2026-10-29T15:39:02Z\",\"state\":\"SUCCESS\",\"targetUrl\":\"\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/pull/318\"}\n\nPR325:\n{\"baseRefOid\":\"7fad87d0d8ccdabcf7b8153893e04274d2ab5760\",\"headRefOid\":\"4c8afc0b99d819620fe00875da5548dbcfad9c3e\",\"reviewDecision\":\"\",\"state\":\"OPEN\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"completedAt\":