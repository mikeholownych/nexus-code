4547b11910c3e7\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_9fdebc5bc280819187fdaa202153760b\\\",\\\"skill_name\\\":\\\"google-sheets\\\",\\\"contents\\\":[\\\"assets\\\",\\\"references\\\"],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-docs\\\",\\\"name\\\":\\\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-docs\\\",\\\"title\\\":\\\"Google Docs\\\",\\\"description\\\":\\\"Create and edit native Google Docs through connected tools.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7\\\",\\\"plugin_name\\\":\\\"google-drive\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6ac961498a348191884547b11910c3e7\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6136474279d48191a8c288998ba66479\\\",\\\"skill_name\\\":\\\"google-docs\\\",\\\"contents\\\":[\\\"assets\\\",\\\"host\\\",\\\"references\\\",\\\"runtime\\\",\\\"scripts\\\"],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-slides\\\",\\\"name\\\":\\\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-slides\\\",\\\"title\\\":\\\"Google Slides\\\",\\\"description\\\":\\\"Route Google Slides authoring requests and derive a design system from a native template or reference deck. Use this skill when the user provides an existing native Google Slides deck as a template, reference, or prior-period source, or asks to edit, update, repair, restyle, or clean up an existing native Google Slides deck. Use the Presentations skill instead for net-new presentation creation when no existing native Google Slides deck must be followed.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7\\\",\\\"plugin_name\\\":\\\"google-drive\\\",\\\"plugi