"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\\\",\\\"plugin_name\\\":\\\"openai-templates\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\\\",\\\"plugin_release_skill_id\\\":\\\"REDACTED\\\",\\\"skill_name\\\":\\\"artifact-template-business-review\\\",\\\"contents\\\":[\\\"assets\\\"],\\\"allow_implicit_invocation\\\":false}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-design-report\\\",\\\"name\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-design-report\\\",\\\"title\\\":\\\"Design Report\\\",\\\"description\\\":\\\"Create a document using the Design Report template and its retained reference file. Use when the user selects or names Design Report. Produce design reports with an executive summary, key findings, implications, recommendations, and appendix.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\\\",\\\"plugin_name\\\":\\\"openai-templates\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a6ced4fdbe08191918c70c8437a0f90\\\",\\\"skill_name\\\":\\\"artifact-template-design-report\\\",\\\"contents\\\":[\\\"assets\\\"],\\\"allow_implicit_invocation\\\":false}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-experiment-analysis\\\",\\\"name\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-experiment-analysis\\\",\\\"title\\\":\\\"Experiment Analysis\\\",\\\"description\\\":\\\"Create a document using the Experiment Analysis template and its retained reference file. Use when the user selects or names Experiment Analysis. Analyze experiments with hypotheses, methodology, results, interpretation, limitations, and next steps.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\\\",\\\"plugin_name\\\":\\\"openai-templates\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a6ced4fdbe88191a5da52bf989269b8\\\",\\\"skill_name\\\":\\\"artifact-template-experiment-analysis\\\",\\\"contents\\\":[\\\"assets\\\"],\\\"allow_implicit_invocation\\\":false}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-financial-budget\\\",\\\"name\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-financial-budget\\\",\\\"title\\\":\\\"Financial Budget\\\",\\\"description\\\":\\\"Create a spreadsheet using the Financial Budget template and its retained reference file. Use when the user selects or names Financial Budget. Model actuals, budget and scenario forecasts, variances, cash runway, and departmental plans.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\\\",\\\"plugin_name\\\":\\\"openai-templates\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a6ced4fdbec8191ab9fb1dfa916b101\\\",\\\"skill_name\\\":\\\"artifact-template-financial-budget\\\",\\\"contents\\\":[\\\"assets\\\"],\\\"allow_implicit_invocation\\\":false}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-investment-committee-memo\\\",\\\"name\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-investment-committee-memo\\\",\\\"title\\\":\\\"Investment Committee Memo\\\",\\\"description\\\":\\\"Create a document using the Investment Committee Memo template and its retained reference file. Use when the user selects or names Investment Committee Memo. Prepare investment committee memos with the thesis, transaction details, financial analysis, risks, and recommendation.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\\\",\\\"plugin_name\\\":\\\"openai-templates\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a6ced4fdbf08191b1e46e0069bf9d39\\\",\\\"skill_name\\\":\\\"artifact-template-investment-committee-memo\\\",\\\"contents\\\":[\\\"assets\\\"],\\\"allow_implicit_invocation\\\":false}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-legal-memorandum\\\",\\\"name\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-legal-memorandum\\\",\\\"title\\\":\\\"Legal Memorandum\\\",\\\"description\\\":\\\"Create a document using the Legal Memorandum template and its retained reference file. Use when the user selects or names Legal Memorandum. Draft legal memoranda with the issue, brief answer, relevant facts, analysis, and conclusion.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\\\",\\\"plugin_name\\\":\\\"openai-templates\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\\\",\\\"plugin_release_skill_id\\\":\\\"REDACTED\\\",\\\"skill_name\\\":\\\"artifact-template-legal-memorandum\\\",\\\"contents\\\":[\\\"assets\\\"],\\\"allow_implicit_invocation\\\":false}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-market-trends-report\\\",\\\"name\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-market-trends-report\\\",\\\"title\\\":\\\"Market Trends Report\\\",\\\"description\\\":\\\"Create a presentation using the Market Trends Report template and its retained reference file. Use when the user selects or names Market Trends Report. Communicate market or industry trends, supporting evidence, implications, and recommended responses.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\\\",\\\"plugin_name\\\":\\\"openai-templates\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a6ced4fdbf88191b625517e4a40d184\\\",\\\"skill_name\\\":\\\"artifact-template-market-trends-report\\\",\\\"contents\\\":[\\\"as…3884 tokens truncated…luginrel_6ab68a367fcc8191ad5a130fa1d93a6c\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_2247832b32088191a6f73b5984466667\\\",\\\"skill_name\\\":\\\"write-page\\\",\\\"contents\\\":[\\\"references\\\"],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/create-pet\\\",\\\"name\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/create-pet\\\",\\\"title\\\":\\\"Create pet\\\",\\\"description\\\":\\\"Create, repair, validate, preview, upload, or activate an animated v2 pet in ChatGPT Work mode from a character idea, brand cue, or reference image. Use for new ChatGPT Pets, custom mascots, non-pixel styles, and unattached sprite sheets requiring nine animation states plus sixteen look directions. Preserve Library artifacts and Pets MCP lifecycle behavior. Exclude real pets, standalone images, and other-app pets; clarify before invoking.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\\\",\\\"plugin_name\\\":\\\"work-pets\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a605738d6308191b431b6477919eafb\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a60573a53888191b6f2c38c1a8ad4ca\\\",\\\"skill_name\\\":\\\"create-pet\\\",\\\"contents\\\":[\\\"references\\\",\\\"scripts\\\"],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/pets\\\",\\\"name\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/pets\\\",\\\"title\\\":\\\"Pets\\\",\\\"description\\\":\\\"List, inspect, select, download, or delete animated pets in ChatGPT Work mode. Use for an explicit pet in ChatGPT or established ChatGPT Pets context. Exclude real-world and other-app pets; clarify before invoking.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\\\",\\\"plugin_name\\\":\\\"work-pets\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a605738d6308191b431b6477919eafb\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a60573ba8bc819186e79bd4858c707b\\\",\\\"skill_name\\\":\\\"pets\\\",\\\"contents\\\":[],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/update-pet\\\",\\\"name\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa/update-pet\\\",\\\"title\\\":\\\"Update pet\\\",\\\"description\\\":\\\"Inspect, validate, preview, repair, or update a custom pet in ChatGPT Work mode, including its name, description, or sprite sheet. Use for a pet in ChatGPT or established ChatGPT Pets context. Exclude real-world and other-app pets; clarify before invoking.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_bccf6c8660c08191ae4470d9ae4877fa\\\",\\\"plugin_name\\\":\\\"work-pets\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a605738d6308191b431b6477919eafb\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a60573d52608191b967e6759086094c\\\",\\\"skill_name\\\":\\\"update-pet\\\",\\\"contents\\\":[],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\\\",\\\"name\\\":\\\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128/plugin-management\\\",\\\"title\\\":\\\"plugin-management\\\",\\\"description\\\":\\\"Discover and suggest relevant plugins, inspect app permissions and dependencies, and manage plugin connections or removal. Use when the user asks about plugins or when a task would materially benefit from an external app, account, service, or data source that available tools cannot access.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_b3438d6beb9081918fba3625bc988128\\\",\\\"plugin_name\\\":\\\"plugin-management\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6a7e9f7d0ef08191b97b213bb9e118ef\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6a7e9f7d68608191bca9945146cbe6f1\\\",\\\"skill_name\\\":\\\"plugin-management\\\",\\\"contents\\\":[],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites\\\",\\\"name\\\":\\\"plugin_connector_1p_689987207de08191979cf68eca2941c6/sites\\\",\\\"title\\\":\\\"sites\\\",\\\"description\\\":\\\"Use Sites when the user wants a website built for them (including a landing page, portfolio, dashboard, portal, tracker, hub, game, event registration, or tool), requests changes to a website already built with Sites, wants to publish a website with Sites, or wants to manage Sites hosting.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_689987207de08191979cf68eca2941c6\\\",\\\"plugin_name\\\":\\\"sites\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6adbbe74820481918f7ce521432d9acb\\\",\\\"plugin_release_skill_id\\\":\\\"pluginrsk_6adbbe74cd2c8191a2a62a54644c813e\\\",\\\"skill_name\\\":\\\"sites\\\",\\\"contents\\\":[\\\"references\\\",\\\"scripts\\\",\\\"templates\\\"],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"codex_apps\\\",\\\"uri\\\":\\\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-remix\\\",\\\"name\\\":\\\"plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-remix\\\",\\\"title\\\":\\\"sites-remix\\\",\\\"description\\\":\\\"Remix a Site built with the Sites plugin into a new Site. Use when the user has identified the source Site and asks to remix it.\\\",\\\"mimeType\\\":\\\"mcp/skill\\\",\\\"_meta\\\":{\\\"plugin_id\\\":\\\"plugin_connector_1p_689987207de08191979cf68eca2941c6\\\",\\\"plugin_name\\\":\\\"sites\\\",\\\"plugin_release_id\\\":\\\"pluginrel_6adbbe74820481918f7ce521432d9acb\\\",\\\"plugin_release_skill_id\\\":\\\"REDACTED\\\",\\\"skill_name\\\":\\\"sites-remix\\\",\\\"contents\\\":[],\\\"allow_implicit_invocation\\\":true}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://config/environment\\\",\\\"name\\\":\\\"environment_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://tooling/directory\\\",\\\"name\\\":\\\"tooling_directory_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://tooling/schemas\\\",\\\"name\\\":\\\"tooling_schemas_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://tooling/metrics\\\",\\\"name\\\":\\\"tooling_metrics_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://tooling/locks\\\",\\\"name\\\":\\\"tooling_locks_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uri\\\":\\\"resource://tooling/projects\\\",\\\"name\\\":\\\"projects_resource_exact\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}}]}\"\n\"{\\\"resourceTemplates\\\":[{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://config/environment{?format}\\\",\\\"name\\\":\\\"environment_resource\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://tooling/directory{?format}\\\",\\\"name\\\":\\\"tooling_directory_resource\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://tooling/schemas{?format}\\\",\\\"name\\\":\\\"tooling_schemas_resource\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://tooling/metrics{?format}\\\",\\\"name\\\":\\\"tooling_metrics_resource\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://tooling/locks{?format}\\\",\\\"name\\\":\\\"tooling_locks_resource\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://tooling/capabilities/{agent}{?project,format}\\\",\\\"name\\\":\\\"tooling_capabilities_resource\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://tooling/recent/{window_seconds}{?agent,project,format}\\\",\\\"name\\\":\\\"tooling_recent_resource\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://tooling/projects{?format}\\\",\\\"name\\\":\\\"projects_resource\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://project/{slug}{?format}\\\",\\\"name\\\":\\\"project_detail\\\",\\\"description\\\":\\\"Fetch a project and its agents by project slug or human key.\\\\n\\\\nWhen to use\\\\n-----------\\\\n- Populate an \\\\\\\"LDAP-like\\\\\\\" directory for agents in tooling UIs.\\\\n- Determine available agent identities and their metadata before addressing mail.\\\\n\\\\nParameters\\\\n----------\\\\nslug : str\\\\n    Project slug (or human key; both resolve to the same target).\\\\n\\\\nReturns\\\\n-------\\\\ndict\\\\n    Project descriptor including { agents: [...] } with agent profiles.\\\\n\\\\nExample\\\\n-------\\\\n```json\\\\n{\\\\\\\"jsonrpc\\\\\\\":\\\\\\\"2.0\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"r3\\\\\\\",\\\\\\\"method\\\\\\\":\\\\\\\"resources/read\\\\\\\",\\\\\\\"params\\\\\\\":{\\\\\\\"uri\\\\\\\":\\\\\\\"resource://project/backend-abc123\\\\\\\"}}\\\\n```\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://agents/{project_key}{?format}\\\",\\\"name\\\":\\\"agents_directory\\\",\\\"description\\\":\\\"List all registered agents in a project for easy agent discovery.\\\\n\\\\nThis is the recommended way to discover other agents working on a project.\\\\n\\\\nWhen to use\\\\n-----------\\\\n- At the start of a coding session to see who else is working on the project.\\\\n- Before sending messages to discover available recipients.\\\\n- To check if a specific agent is registered before attempting contact.\\\\n\\\\nParameters\\\\n----------\\\\nproject_key : str\\\\n    Project slug or human key (both work).\\\\n\\\\nReturns\\\\n-------\\\\ndict\\\\n    {\\\\n      \\\\\\\"project\\\\\\\": { \\\\\\\"slug\\\\\\\": \\\\\\\"...\\\\\\\", \\\\\\\"human_key\\\\\\\": \\\\\\\"...\\\\\\\" },\\\\n      \\\\\\\"agents\\\\\\\": [\\\\n        {\\\\n          \\\\\\\"name\\\\\\\": \\\\\\\"BackendDev\\\\\\\",\\\\n          \\\\\\\"program\\\\\\\": \\\\\\\"claude-code\\\\\\\",\\\\n          \\\\\\\"model\\\\\\\": \\\\\\\"sonnet-4.5\\\\\\\",\\\\n          \\\\\\\"task_description\\\\\\\": \\\\\\\"API development\\\\\\\",\\\\n          \\\\\\\"inception_ts\\\\\\\": \\\\\\\"2025-10-25T...\\\\\\\",\\\\n          \\\\\\\"last_active_ts\\\\\\\": \\\\\\\"2025-10-25T...\\\\\\\",\\\\n          \\\\\\\"unread_count\\\\\\\": 3\\\\n        },\\\\n        ...\\\\n      ]\\\\n    }\\\\n\\\\nExample\\\\n-------\\\\n```json\\\\n{\\\\\\\"jsonrpc\\\\\\\":\\\\\\\"2.0\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"r5\\\\\\\",\\\\\\\"method\\\\\\\":\\\\\\\"resources/read\\\\\\\",\\\\\\\"params\\\\\\\":{\\\\\\\"uri\\\\\\\":\\\\\\\"resource://agents/backend-abc123\\\\\\\"}}\\\\n```\\\\n\\\\nNotes\\\\n-----\\\\n- Agent names are NOT the same as your program name or user name.\\\\n- Use the returned names when calling tools like whois(), request_contact(), send_message().\\\\n- Agents in different projects cannot see each other - project isolation is enforced.\\\\n- `last_active_ts` refreshes on ANY authenticated tool call the agent makes\\\\n  (send/reply, fetch_inbox, mark_message_read, acknowledge_message, ...), so\\\\n  mail-only agents (e.g. orchestrator identities) remain visible to\\\\n  activity-based filtering while they are actively communicating (#255).\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://file_reservations/{slug}{?active_only,format}\\\",\\\"name\\\":\\\"file_reservations_resource\\\",\\\"description\\\":\\\"List file_reservations for a project, optionally filtering to active-only.\\\\n\\\\nWhy this exists\\\\n---------------\\\\n- File reservations communicate edit intent and reduce collisions across agents.\\\\n- Surfacing them helps humans review ongoing work and resolve contention.\\\\n\\\\nParameters\\\\n----------\\\\nslug : str\\\\n    Project slug or human key.\\\\nactive_only : bool\\\\n    If true (default), only returns file_reservations with no `released_ts`.\\\\n\\\\nReturns\\\\n-------\\\\nlist[dict]\\\\n    Each file_reservation with { id, agent, path_pattern, exclusive, reason, created_ts, expires_ts, released_ts }\\\\n\\\\nExample\\\\n-------\\\\n```json\\\\n{\\\\\\\"jsonrpc\\\\\\\":\\\\\\\"2.0\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"r4\\\\\\\",\\\\\\\"method\\\\\\\":\\\\\\\"resources/read\\\\\\\",\\\\\\\"params\\\\\\\":{\\\\\\\"uri\\\\\\\":\\\\\\\"resource://file_reservations/backend-abc123?active_only=true\\\\\\\"}}\\\\n```\\\\n\\\\nAlso see all historical (including released) file_reservations:\\\\n```json\\\\n{\\\\\\\"jsonrpc\\\\\\\":\\\\\\\"2.0\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"r4b\\\\\\\",\\\\\\\"method\\\\\\\":\\\\\\\"resources/read\\\\\\\",\\\\\\\"params\\\\\\\":{\\\\\\\"uri\\\\\\\":\\\\\\\"resource://file_reservations/backend-abc123?active_only=false\\\\\\\"}}\\\\n```\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://message/{message_id}{?project,agent,agent_token,format}\\\",\\\"name\\\":\\\"message_resource\\\",\\\"description\\\":\\\"Read a single message by id within a project.\\\\n\\\\nWhen to use\\\\n-----------\\\\n- Fetch the canonical body/metadata for rendering in a client after list/search.\\\\n- Retrieve attachments and full details for a given message id.\\\\n\\\\nParameters\\\\n----------\\\\nmessage_id : str\\\\n    Numeric id as a string.\\\\nproject : str\\\\n    Project slug or human key (required for disambiguation).\\\\n\\\\nCommon mistakes\\\\n---------------\\\\n- Omitting `project` when a message id might exist in multiple projects.\\\\n\\\\nReturns\\\\n-------\\\\ndict\\\\n    Full message payload including body and sender name.\\\\n\\\\nExample\\\\n-------\\\\nIf the caller has not already authenticated as the viewer in this MCP session,\\\\ninclude `agent` and `agent_token`.\\\\n\\\\n```json\\\\n{\\\\\\\"jsonrpc\\\\\\\":\\\\\\\"2.0\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"r5\\\\\\\",\\\\\\\"method\\\\\\\":\\\\\\\"resources/read\\\\\\\",\\\\\\\"params\\\\\\\":{\\\\\\\"uri\\\\\\\":\\\\\\\"resource://message/1234?project=/abs/path/backend&agent=BlueLake&agent_token=REDACTED messages for a thread within a project.\\\\n\\\\nWhen to use\\\\n-----------\\\\n- Present a conversation view for a given ticket/thread key.\\\\n- Export a thread for summarization or reporting.\\\\n\\\\nParameters\\\\n----------\\\\nthread_id : str\\\\n    Either a string thread key or a numeric message id to seed the thread.\\\\nproject : str\\\\n    Project slug or human key (required).\\\\ninclude_bodies : bool\\\\n    Include message bodies if true (default false).\\\\n\\\\nReturns\\\\n-------\\\\ndict\\\\n    { project, thread_id, messages: [{...}] }\\\\n\\\\nExample\\\\n-------\\\\nIf the caller has not already authenticated as the viewer in this MCP session,\\\\ninclude both `agent` and `agent_token`.\\\\n\\\\n```json\\\\n{\\\\\\\"jsonrpc\\\\\\\":\\\\\\\"2.0\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"r6\\\\\\\",\\\\\\\"method\\\\\\\":\\\\\\\"resources/read\\\\\\\",\\\\\\\"params\\\\\\\":{\\\\\\\"uri\\\\\\\":\\\\\\\"resource://thread/TKT-123?project=/abs/path/backend&agent=BlueLake&agent_token=<registration_token>&include_bodies=true\\\\\\\"}}\\\\n```\\\\n\\\\nNumeric seed example (message id as thread seed):\\\\n```json\\\\n{\\\\\\\"jsonrpc\\\\\\\":\\\\\\\"2.0\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"r6b\\\\\\\",\\\\\\\"method\\\\\\\":\\\\\\\"resources/read\\\\\\\",\\\\\\\"params\\\\\\\":{\\\\\\\"uri\\\\\\\":\\\\\\\"resource://thread/1234?project=/abs/path/backend&agent=BlueLake&agent_token=REDACTED an agent's inbox for a project.\\\\n\\\\nParameters\\\\n----------\\\\nagent : str\\\\n    Agent name.\\\\nproject : str\\\\n    Project slug or human key (required).\\\\nsince_ts : Optional[str]\\\\n    ISO-8601 timestamp string; only messages newer than this are returned.\\\\nurgent_only : bool\\\\n    If true, limits to importance in {high, urgent}.\\\\ninclude_bodies : bool\\\\n    Include message bodies in results (default false).\\\\nlimit : int\\\\n    Maximum number of messages to return (default 20).\\\\n\\\\nReturns\\\\n-------\\\\ndict\\\\n    { project, agent, count, messages: [...] }\\\\n\\\\nExample\\\\n-------\\\\nIf the caller has not already authenticated as this agent in the current MCP session,\\\\ninclude `agent_token=REDACTED,\\\\\\\"params\\\\\\\":{\\\\\\\"uri\\\\\\\":\\\\\\\"resource://inbox/BlueLake?project=/abs/path/backend&limit=10&urgent_only=true&agent_token=REDACTED fetch example (using since_ts):\\\\n```json\\\\n{\\\\\\\"jsonrpc\\\\\\\":\\\\\\\"2.0\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"r7b\\\\\\\",\\\\\\\"method\\\\\\\":\\\\\\\"resources/read\\\\\\\",\\\\\\\"params\\\\\\\":{\\\\\\\"uri\\\\\\\":\\\\\\\"resource://inbox/BlueLake?project=/abs/path/backend&since_ts=2025-10-23T15:00:00Z&agent_token=REDACTED view listing urgent and high-importance messages that are unread for an agent.\\\\n\\\\nParameters\\\\n----------\\\\nagent : str\\\\n    Agent name.\\\\nproject : str\\\\n    Project slug or human key (required).\\\\nlimit : int\\\\n    Max number of messages.\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://views/ack-required/{agent}{?project,limit,agent_token,format}\\\",\\\"name\\\":\\\"ack_required_view\\\",\\\"description\\\":\\\"Convenience view listing messages requiring acknowledgement for an agent where ack is pending.\\\\n\\\\nParameters\\\\n----------\\\\nagent : str\\\\n    Agent name.\\\\nproject : str\\\\n    Project slug or human key (required).\\\\nlimit : int\\\\n    Max number of messages.\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://views/acks-stale/{agent}{?project,ttl_seconds,limit,agent_token,format}\\\",\\\"name\\\":\\\"acks_stale_view\\\",\\\"description\\\":\\\"List ack-required messages older than a TTL where acknowledgement is still missing.\\\\n\\\\nParameters\\\\n----------\\\\nagent : str\\\\n    Agent name.\\\\nproject : str\\\\n    Project slug or human key (required).\\\\nttl_seconds : Optional[int]\\\\n    Minimum age in seconds to consider a message stale. Defaults to settings.ack_ttl_seconds.\\\\nlimit : int\\\\n    Max number of messages to return.\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://views/ack-overdue/{agent}{?project,ttl_minutes,limit,agent_token,format}\\\",\\\"name\\\":\\\"ack_overdue_view\\\",\\\"description\\\":\\\"List messages requiring acknowledgement older than ttl_minutes without ack.\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://mailbox/{agent}{?project,limit,agent_token,format}\\\",\\\"name\\\":\\\"mailbox_resource\\\",\\\"description\\\":\\\"List recent messages in an agent's mailbox with lightweight Git commit context.\\\\n\\\\nReturns\\\\n-------\\\\ndict\\\\n    { project, agent, count, messages: [{ id, subject, from, created_ts, importance, ack_required, kind, commit: {hexsha, summary} | null }] }\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://mailbox-with-commits/{agent}{?project,limit,agent_token,format}\\\",\\\"name\\\":\\\"mailbox_with_commits_resource\\\",\\\"description\\\":\\\"List recent messages in an agent's mailbox with commit metadata including diff summaries.\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}},{\\\"server\\\":\\\"mcp-agent-mail\\\",\\\"uriTemplate\\\":\\\"resource://outbox/{agent}{?project,limit,include_bodies,since_ts,agent_token,format}\\\",\\\"name\\\":\\\"outbox_resource\\\",\\\"description\\\":\\\"List messages sent by the agent, enriched with commit metadata for canonical files.\\\",\\\"mimeType\\\":\\\"application/json\\\",\\\"_meta\\\":{\\\"_fastmcp\\\":{\\\"tags\\\":[]}}}]}\""}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18894-e451-7fe2-b11c-0a0394ebbc6f","create_time":1793292874.4294224}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
