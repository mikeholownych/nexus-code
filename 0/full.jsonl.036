dStream(file);\n  stream.on('error', () => res.writeHead(404).end());\n  stream.on('open', () => res.writeHead(200));\n  stream.pipe(res);\n});\nserver.listen(0, '127.0.0.1', () => fs.writeFileSync('/tmp/incompat-port', String(server.address().port)));\n","exit_code":0,"duration":{"secs":0,"nanos":324461664}},"started_at_ms":1793299209407,"completed_at_ms":1793299209732}}
