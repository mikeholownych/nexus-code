l,\"name\":\"test-matrix (24)\",\"status\":\"in_progress\",\"steps\":[{\"conclusion\":null,\"name\":\"Run npm --prefix cli test\",\"status\":\"in_progress\"}]}\n{\"conclusion\":null,\"started_at\":\"2026-10-29T17:17:25Z\",\"status\":\"in_progress\"}\n","exit_code":0,"duration":{"secs":1,"nanos":676766482}},"started_at_ms":1793294807911,"completed_at_ms":1793294809589}}
