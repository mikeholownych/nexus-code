\\\",task:\\\"crash-after-answers\\\",run:1,turn:null,model:{requests:4,answered:4,upstreamFailures:0}},{...base,agent:\\\"goose\\\",task:\\\"endpoint-down\\\",run:1,model:{requests:3,answered:0,upstreamFailures:3}},{...base,agent:\\\"nexus\\\",task:\\\"endpoint-down\\\",run:1,turn:null,model:{requests:2,answered:0,upstreamFailures:2}},{...base,agent:\\\"opencode\\\",task:\\\"slow-but-answered\\\",run:1,model:{requests:5,answered:3,upstreamFailures:2}}]);const out=spawnSync(process.execPath,[path.join(ROOT,\\\"eval/infra.mjs\\\"),dir],{encoding:\\\"utf8\\\"});assert.equal(out.status,0,out.stderr);assert.deepEqual(out.stdout.trim().split(\\\"\\\\n\\\").sort(),[\\\"endpoint-down 1\\\",\\\"endpoint-down 1\\\"])});test(\\\"contaminated runs leave the pass rate, crashes are counted, and reruns are listed\\\",()=>{const first=writeResults([{...base,agent:\\\"nexus\\\",task:\\\"a\\\",run:1,hiddenPass:true,turn:{outcome:\\\"VERIFIED\\\"},exitCode:0,tokens:{total:1e3}},{...base,agent:\\\"nexus\\\",task:\\\"b\\\",run:1,hiddenPass:true,contaminated:true,turn:{outcome:\\\"VERIFIED\\\"},exitCode:0,tokens:{total:1e3}},{...base,agent:\\\"nexus\\\",task:\\\"c\\\",run:1,turn:null},{...base,agent:\\\"nexus\\\",task:\\\"d\\\",run:1,error:\\\"workspace setup failed\\\"}]);const rerun=writeResults([{...base,agent:\\\"nexus\\\",task:\\\"d\\\",run:1,turn:{outcome:\\\"UNVERIFIED\\\"},exitCode:2,tokens:{total:1e3}}]);const out=spawnSync(process.execPath,[path.join(ROOT,\\\"eval/score.mjs\\\"),path.join(first,\\\"results.jsonl\\\"),path.join(rerun,\\\"results.jsonl\\\"),\\\"--json\\\"],{encoding:\\\"utf8\\\"});assert.equal(out.status,0,out.stderr);const score=JSON.parse(out.stdout);const pooled=score.pooled[0];assert.equal(pooled.excludedContaminated,1);assert.equal(pooled.n,3,\\\"the contaminated run is not in the denominator\\\");assert.equal(pooled.correct,1,\\\"the contaminated pass is not counted\\\");assert.equal(score.totals.crashed,1,\\\"a Nexus run without a result is a crash\\\");a