l(\"SIGTERM\");\n  clearTimeout(killTimer);\n  killTimer = setTimeout(() => {\n    for (const child of children) child.kill(\"SIGKILL\");\n  }, 1_000);\n  killTimer.unref();\n}\n\nprocess.on(\"SIGTERM\", () => {\n  failed = true;\n  stopAll();\n});\nprocess.on(\"SIGINT\", () => {\n  failed = true;\n  stopAll();\n});\n\nconst deadline = setTimeout(() => {\n  failed = true;\n  stopAll();\n}, TIMEOUT_MS);\n\nfunction scanRoot(root) {\n  return new Promise((resolve) => {\n  const child = spawn(FIND, findArgs(root), {\n    env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n    stdio: [\"ignore\", \"pipe\", \"pipe\"],\n  });\n  children.add(child);\n  const stdout = [];\n  let stderrBytes = 0;\n  child.stdout.on(\"data\", (chunk) => {\n    outputBytes += chunk.length;\n    if (outputBytes > MAX_OUTPUT) {\n      failed = true;\n      stopAll();\n      return;\n    }\n    stdout.push(chunk);\n  });\n  child.stderr.on(\"data\", (chunk) => {\n    stderrBytes += chunk.length;\n    failed = true;\n    stopAll();\n  });\n  child.on(\"error\", () => {\n    failed = true;\n    stopAll();\n  });\n  child.on(\"close\", (code) => {\n    children.delete(child);\n    if (code !== 0 || stderrBytes !== 0) {\n      failed = true;\n      stopAll();\n    }\n    outputs.push(stdout);\n    resolve();\n  });\n  });\n}\n\nlet nextRoot = 0;\nasync function worker() {\n  while (!failed && nextRoot < roots.length) {\n    const root = roots[nextRoot++];\n    await scanRoot(root);\n  }\n}\n\nawait Promise.all(Array.from({ length: Math.min(4, roots.length) }, () => worker()));\nclearTimeout(deadline);\nclearTimeout(killTimer);\nif (failed) {\n  process.stderr.write(\"trusted compiler inventory could not complete\\n\");\n  process.exitCode = 1;\n} else {\n  process.stdout.write(Buffer.concat(outputs.flat(), outputBytes));\n}\neval/isolate.mjs-140-  return [...spellings];\neval/isolate.mjs-141-}\neval/isolate.mjs-142-\neval/isolate.mjs:143:export function scanOracleCompilerExposure