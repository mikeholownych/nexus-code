\n          },\n          \"seed\": {\n            \"state\": \"missing\",\n            \"detail\": \"no seed source in manifest; run entire brain refresh --agent none\"\n          }\n        }\n      }\n    },\n    \"onboarding\": {\n      \"facts_backfill\": {\n        \"sessions\": 10,\n        \"distilled\": 10,\n        \"running\": false,\n        \"pid\": 1609188,\n        \"started_at\": \"2026-10-28T07:43:29.356449859Z\",\n        \"agent\": \"codex\",\n        \"log_path\": \"/home/mike/.local/state/entire/repos/gh/mikeholownych/nexus-code/backfill.log\"\n      },\n      \"daemon\": {\n        \"manager\": \"systemd\",\n        \"label\": \"entire-brain-watch.service\",\n        \"unit_path\": \"/home/mike/.config/systemd/user/entire-brain-watch.service\",\n        \"installed\": true,\n        \"current\": true,\n        \"running\": true\n      },\n      \"last_tick_at\": \"2026-10-28T07:44:26.493369455Z\",\n      \"components\": [\n        {\n          \"name\": \"sessions\",\n          \"state\": \"built\"\n        },\n        {\n          \"name\": \"seed\",\n          \"state\": \"failed\",\n          \"detail\": \"dirty_worktree: refusing to seed uncommitted content without --worktree; commit or stash them, list them in .brainignore to keep them out of the brain, or pass --worktree to seed them as they are; 161 uncommitted paths: cli/src/agent.ts, cli/src/core/state.ts, cli/test/compaction_continuity.test.ts, core/tests/adversarial_path_traversal.rs, docs/v1.0.0/ACCEPTANCE.md (and 156 more)\",\n          \"hint\": \"commit or stash the working tree -- or list the paths in .brainignore, which the seed and index gates both honour -- then re-run `entire brain setup`, or `entire brain refresh --worktree` to index the uncommitted changes as they are; `entire enable` writes .entire/ and .claude/ without committing them, which is what a first run usually trips over\"\n        },\n        {\n          \"name\": \"docs\",\n          \"state\": \"built\"\n        },\n        {\n          \"name\": \"semantic\",\n          \"state\": \"missing\"\n        },\n        {\n          \"name\": \"history\",\n          \"state\": \"built\"\n        },\n        {\n          \"name\": \"patterns\",\n          \"state\": \"built\"\n        },\n        {\n          \"name\": \"entities\",\n          \"state\": \"built\"\n        },\n        {\n          \"name\": \"memory\",\n          \"state\": \"built\"\n        }\n      ]\n    },\n    \"live\": {\n      \"branch\": \"v1/eval-agent-toolchain-binds\",\n      \"head\": \"1682dcb325cea7078e193d0ed0b5af5325ce8ca8\",\n      \"dirty\": true,\n      \"diff_stat\": \"1 file changed, 11 insertions(+), 26 deletions(-)\"\n    },\n    \"warnings\": [\n      \"agents not wired: missing .entire/agent-guide.md, AGENTS.md or CLAUDE.md (neither carries the managed block); run entire brain setup so your agent uses this brain\"\n    ]\n  }\n}\n","exit_code":0,"duration":{"secs":12,"nanos":863176278}},"started_at_ms":1793290567242,"completed_at_ms":1793290580106}}
