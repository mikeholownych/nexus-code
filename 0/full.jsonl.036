patible-server.js\nnew file mode 100644\nindex 00000000..f8ca6692\n--- /dev/null\n+++ b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/incompatible-server.js\n@@ -0,0 +1,25 @@\n+const http = require('node:http');\n+const fs = require('node:fs');\n+const path = require('node:path');\n+const root = '/tmp/incompat-fixture';\n+const server = http.createServer((req, res) => {\n+  let pathname;\n+  try { pathname = decodeURIComponent(new URL(req.url, 'http://localhost').pathname); }\n+  catch { res.writeHead(400).end(); return; }\n+  const port = server.address().port;\n+  if (pathname === '/api/releases/tags/v1.0.0-rc.4' || pathname === '/api/releases/tags/v1.0.0-rc.4/') {\n+    const body = fs.readFileSync(path.join(root, 'api.json'), 'utf8').replaceAll('PORT', String(port));\n+    res.writeHead(200, { 'content-type': 'application/json' }).end(body);\n+    return;\n+  }\n+  const prefix = '/download/v1.0.0-rc.4/';\n+  if (!pathname.startsWith(prefix)) { res.writeHead(404).end(); return; }\n+  const name = path.basename(pathname.slice(prefix.length));\n+  const file = path.join(root, 'download/v1.0.0-rc.4', name);\n+  if (!file.startsWith(path.join(root, 'download/v1.0.0-rc.4') + path.sep)) { res.writeHead(403).end(); return; }\n+  const stream = fs.createReadStream(file);\n+  stream.on('error', () => res.writeHead(404).end());\n+  stream.on('open', () => res.writeHead(200));\n+  stream.pipe(res);\n+});\n+server.listen(0, '127.0.0.1', () => fs.writeFileSync('/tmp/incompat-port', String(server.address().port)));\ndiff --git a/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/prepare-incompatible-fixture.sh b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/prepare-incompatible-fixture.sh\nnew file mode 100755\nindex 00000000..5c299dca\n--- /dev/null\n+++ b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/prepare-incompatible-fixture.sh\n@@ -0,0 +1,37 @@\n+#!/usr/bin/env bash\n+set -euo pipefail\n+archive=$1; out=$2\n+expected=444d0812ad583b7f688890ac8536cb872e92364c977d9fbf298fa0408d98b3e7\n+[ \"$(sha256sum \"$archive\" | awk '{print $1}')\" = \"$expected\" ] || { echo \"RC10 archive digest mismatch\" >&2; exit 1; }\n+[ ! -e \"$out\" ] || { echo \"output exists\" >&2; exit 1; }\n+mkdir -p \"$out/release/pkg\"\n+tar -xzf \"$archive\" -C \"$out/release/pkg\"\n+node -e '\n+const fs=require(\"fs\"), p=process.argv[1];\n+const c=JSON.parse(fs.readFileSync(p,\"utf8\"));\n+c.version=\"1.0.0-rc.4\"; c.revision=\"1\".repeat(40); c.builtAt=\"2026-10-01T00:00:00Z\";\n+c.components={cli:\"1.0.0-rc.4\",core:\"1.0.0-rc.4\",tui:\"1.0.0-rc.4\",harness:\"1.0.0-rc.4\"};\n+c.compatibility={configSchemaVersion:1,stateSchemaVersion:1,minSupportedConfigVersion:1,minSupportedStateVersion:0};\n+c.platforms={\"linux-x86_64\":{archive:\"nexus-linux-x86_64-v1.0.0-rc.4.tar.gz\",os:\"linux\",arch:\"x86_64\",libc:\"glibc-2.35\"}};\n+fs.writeFileSync(p, JSON.stringify(c,null,2)+\"\\n\");\n+' \"$out/release/pkg/nexus/compatibility.json\"\n+printf 'v1.0.0-rc.4\\n' > \"$out/release/pkg/nexus/VERSION\"\n+(cd \"$out/release/pkg/nexus\" && find . -type f ! -name MANIFEST.sha256 -print0 | sort -z | xargs -0 sha256sum > MANIFEST.sha256)\n+mkdir -p \"$out/release/download/v1.0.0-rc.4\"\n+(cd \"$out/release/pkg\" && tar --sort=name --mtime=\"2026-10-01 00:00:00 UTC\" --owner=0 --group=0 --numeric-owner -czf \"$out/release/download/v1.0.0-rc.4/nexus-linux-x86_64-v1.0.0-rc.4.tar.gz\" nexus)\n+archive_sha=$(sha256sum \"$out/release/download/v1.0.0-rc.4/nexus-linux-x86_64-v1.0.0-rc.4.tar.gz\" | awk \"{print \\$1}\")\n+node -e '\n+const fs=require(\"fs\"), p=process.argv[1], sha=process.argv[2];\n+const c=JSON.parse(fs.readFileSync(p,\"utf8\"));\n+c.platforms[\"linux-x86_64\"].sha256=sha;\n+fs.writeFileSync(process.argv[3], JSON.stringify(c,null,2)+\"\\n\");\n+' \"$out/release/pkg/nexus/compatibility.json\" \"$archive_sha\" \"$out/release/download/v1.0.0-rc.4/compatibility.json\"\n+(cd \"$out/release/download/v1.0.0-rc.4\" && sha256sum nexus-linux-x86_64-v1.0.0-rc.4.tar.gz compatibility.json > SHA256SUMS)\n+node -e '\n+const fs=require(\"fs\"), d=process.argv[1];\n+const names=[\"nexus-linux-x86_64-v1.0.0-rc.4.tar.gz\",\"SHA256SUMS\",\"compatibility.json\"];\n+const base=\"http://127.0.0.1:PORT/download/v1.0.0-rc.4/\";\n+fs.writeFileSync(d+\"/api.json\", JSON.stringify({tag_name:\"v1.0.0-rc.4\",name:\"synthetic\",draft:false,prerelease:true,published_at:\"2026-10-01T00:00:00Z\",html_url:\"http://127.0.0.1:PORT\",assets:names.map(n=>({name:n,browser_download_url:base+n,size:fs.statSync(d+\"/download/v1.0.0-rc.4/\"+n).size}))},null,2));\n+' \"$out/release\"\n+rm -rf \"$out/release/pkg\"\n+echo \"fixture=$out/release\"\ndiff --git a/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/run-incompatible-downgrade.sh b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/run-incompatible-downgrade.sh\nnew file mode 100755\nindex 00000000..16579c6c\n--- /dev/null\n+++ b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/run-incompatible-downgrade.sh\n@@ -0,0 +1,43 @@\n+#!/usr/bin/env bash\n+# RC10 E2: an incompatible-state downgrade must be refused fail-closed.\n+# Needs /var/tmp/nexus-incompat-fixture/release from prepare-incompatible-fixture.sh.\n+set -euo pipefail\n+here=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n+log=\"$here/ubuntu-22-04-node22-incompatible-downgrade.log\"\n+fixture=/var/tmp/nexus-incompat-fixture/release\n+[ -d \"$fixture\" ] || { echo \"missing fixture at $fixture\" >&2; exit 2; }\n+[ -f /tmp/nexus-install.sh ] || { echo \"missing installer at /tmp/nexus-install.sh\" >&2; exit 2; }\n+docker run --rm --pull=never --network bridge \\\n+  --mount \"type=bind,src=/tmp/nexus-install.sh,dst=/tmp/nexus-install.sh,readonly\" \\\n+  --mount \"type=bind,src=$here/incompatible-server.js,dst=/tmp/server.js,readonly\" \\\n+  --mount \"type=bind,src=$fixture,dst=/tmp/incompat-fixture,readonly\" \\\n+  nexus-e2/ubuntu-22-04-node22:prep-182e8addeee0 sh -ec '\n+  set -eu\n+  export PATH=\"$HOME/.local/bin:$PATH\"\n+  NEXUS_VERSION=v1.0.0-rc.10 NEXUS_VERIFY_ATTESTATION=0 sh /tmp/nexus-install.sh >/tmp/install.log 2>&1\n+  test \"$(nexus --version)\" = \"1.0.0-rc.10 (16ee8ca36438)\"\n+  installed=\"$HOME/.local/lib/nexus/v1.0.0-rc.10/lib/cli/dist/index.js\"\n+  before=$(sha256sum \"$installed\" | cut -d\" \" -f1)\n+  link_before=$(readlink -f \"$HOME/.local/bin/nexus\")\n+  node -e \"const c=require(\\\"/tmp/incompat-fixture/download/v1.0.0-rc.4/compatibility.json\\\");if(c.compatibility.stateSchemaVersion!==1||c.version!==\\\"1.0.0-rc.4\\\")process.exit(1)\"\n+  rm -f /tmp/incompat-port\n+  node /tmp/server.js >/tmp/server.log 2>&1 & server_pid=$!\n+  trap '\\''kill \"$server_pid\" 2>/dev/null || true; wait \"$server_pid\" 2>/dev/null || true'\\'' EXIT\n+  for i in $(seq 1 50); do [ -s /tmp/incompat-port ] && break; sleep 0.1; done\n+  port=$(cat /tmp/incompat-port); test -n \"$port\"\n+  set +e\n+  NEXUS_RELEASES_API=\"http://127.0.0.1:$port/api/releases\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$port\" \\\n+  NEXUS_VERIFY_ATTESTATION=0 nexus upgrade --version v1.0.0-rc.4 --allow-downgrade --yes >/tmp/upgrade.log 2>&1\n+  rc=$?\n+  set -e\n+  cat /tmp/upgrade.log\n+  test \"$rc\" -ne 0\n+  grep -F \"Downgrade refused: Target version v1.0.0-rc.4 uses state schema version 1, which cannot read current state schema version 2\" /tmp/upgrade.log >/dev/null\n+  test \"$(nexus --version)\" = \"1.0.0-rc.10 (16ee8ca36438)\"\n+  test \"$(readlink -f \"$HOME/.local/bin/nexus\")\" = \"$link_before\"\n+  test \"$(sha256sum \"$installed\" | cut -d\" \" -f1)\" = \"$before\"\n+  test ! -e \"$HOME/.local/lib/nexus/v1.0.0-rc.4\"\n+  echo \"incompatible_downgrade=PASS refused=true state_schema=1 current_schema=2 existing_install_unchanged=true\"\n+  ' > \"$log\" 2>&1\n+cat \"$log\"\ndiff --git a/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/run-process-crash-recovery.sh b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/run-process-crash-recovery.sh\nindex e88087de..79f7db76 100755\n--- a/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/run-process-crash-recovery.sh\n+++ b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/run-process-crash-recovery.sh\n@@ -50,9 +50,10 @@ docker run --rm --pull=never --network bridge \\\n    test \"$(sha256sum \"$installed\" | cut -d\" \" -f1)\" = \"$original_sha\"\n    test \"$(sha256sum \"$HOME/.nexus/tasks/marker\")\" = \"$state_before\"\n    test \"$(nexus --version)\" = \"1.0.0-rc.10 (16ee8ca36438)\"\n-   node -e \"const fs=require(\\\"node:fs\\\");const j=JSON.parse(fs.readFileSync(process.env.HOME+\\\"/.local/lib/nexus/.upgrade-journal.json\\\",\\\"utf8\\\"));if(j.state!==\\\"rolled_back\\\")process.exit(1);if(!fs.existsSync(j.displacedTargetDir))process.exit(2);console.log(\\\"post-recovery journal=\\\"+j.state+\\\" failed_target_retained=true\\\")\"\n+   node -e \"const fs=require(\\\"node:fs\\\");const j=JSON.parse(fs.readFileSync(process.env.HOME+\\\"/.local/lib/nexus/.upgrade-journal.json\\\",\\\"utf8\\\"));if(j.state!==\\\"rolled_back\\\")process.exit(1);if(!fs.existsSync(j.displacedTargetDir))process.exit(2);if(!j.stagingDir)process.exit(3);if(fs.existsSync(j.stagingDir))process.exit(3);console.log(\\\"post-recovery journal=\\\"+j.state+\\\" failed_target_retained=true staging_removed=true\\\")\"\n+   test \"$(find \"$HOME/.local/lib/nexus\" -maxdepth 1 -name \".tmp-upgrade-*\" | wc -l)\" = 0\n    nexus upgrade --recover\n    test \"$(sha256sum \"$installed\" | cut -d\" \" -f1)\" = \"$original_sha\"\n    test \"$(nexus --version)\" = \"1.0.0-rc.10 (16ee8ca36438)\"\n-   echo \"updater_process_crash_recovery=PASS original_package_restored=true staging_handled=true idempotent=true; POWER_LOSS_NOT_TESTED\"\n+   echo \"updater_process_crash_recovery=PASS original_package_restored=true staging_cleanup_asserted=true idempotent=true; POWER_LOSS_NOT_TESTED\"\n  '\ndiff --git a/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/ubuntu-22-04-node22-incompatible-downgrade.log b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/ubuntu-22-04-node22-incompatible-downgrade.log\nnew file mode 100644\nindex 00000000..995ba703\n--- /dev/null\n+++ b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/lifecycle/ubuntu-22-04-node22-incompatible-downgrade.log\n@@ -0,0 +1,7 @@\n+Starting downgrade to v1.0.0-rc.4...\n+  • Creating pre-migration configuration and state backup...\n+  • Fetching nexus-linux-x86_64-v1.0.0-rc.4.tar.gz...\n+  • Verifying release checksums...\n+  • Inspecting and safely extracting package...\n+nexus upgrade failed: Downgrade refused: Target version v1.0.0-rc.4 uses state schema version 1, which cannot read current state schema version 2. Explicit downgrade flag cannot bypass state incompatibility.\n+incompatible_downgrade=PASS refused=true state_schema=1 current_schema=2 existing_install_unchanged=true\ndiff --git a/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/ubuntu-22-04-node22-upgrade-process-crash-recovery.log b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/ubuntu-22-04-node22-upgrade-process-crash-recovery.log\nindex 2117abd6..9ea724f4 100644\n--- a/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/ubuntu-22-04-node22-upgrade-process-crash-recovery.log\n+++ b/docs/reviews/evidence/v1-qualification/rc.10/platform-e2/ubuntu-22-04-node22-upgrade-process-crash-recovery.log\n@@ -2,6 +2,6 @@ pre-kill durable journal state=switched backup_exists=true\n updater_sigkill_rc=137\n after_sigkill_durable_state=switched target_installed=true user_state_preserved=true\n ✔ Recovery completed (rolled_back): Restored verified source release v1.0.0-rc.10.\n-post-recovery journal=rolled_back failed_target_retained=true\n+post-recovery journal=rolled_back failed_target_retained=true staging_removed=true\n Recovery check: No interrupted upgrade found