dArgs(roots) {\n/home/mike/nexus-wt/eval-agent-toolchain-binds/eval/scan-compiler-exposure.mjs:91:          if (++entryCount > MAX_ENTRIES) {\n/home/mike/nexus-wt/eval-agent-toolchain-binds/eval/scan-compiler-exposure.mjs:177:    const child = spawn(FIND, findArgs(roots), {\n    const outside = path.join(base, \"outside\");\n    fs.mkdirSync(outside);\n    for (const dir of [agent, fresh]) {\n      write(dir, \"pkg/render.go\", \"package pkg\\n\");\n      write(dir, \"pkg/testdata/out.golden\", \"expected\\n\");\n      write(dir, \"web/__snapshots__/a.test.js.snap\", \"exports[`a`] = `x`;\\n\");\n      write(dir, \"fixtures/input.json\", \"{}\\n\");\n      write(dir, \"lib/mod/__init__.py\", \"\\n\");\n      write(dir, \"pyproject.toml\", \"[project]\\nname = \\\"x\\\"\\n\\n[tool.pytest.ini_options]\\nfilterwarnings = [\\\"error\\\"]\\n\");\n    }\n    fs.symlinkSync(outside, path.join(fresh, \"linked\"));\n    write(agent, \"pkg/testdata/out.golden\", \"agent output\\n\");\n    write(agent, \"web/__snapshots__/a.test.js.snap\", \"exports[`a`] = `y`;\\n\");\n    write(agent, \"fixtures/input.json\", \"{\\\"x\\\":1}\\n\");\n    write(agent, \"linked/escape.py\", \"print('outside')\\n\");\n    write(agent, \"toplevel.py\", \"x = 1\\n\");\n    write(agent, \"newpkg/__init__.py\", \"\\n\");\n    write(agent, \"lib/mod/helper.py\", \"y = 1\\n\");\n    write(agent, \"lib/mod/huge.py\", Buffer.alloc(3 * 1024 * 1024, 0x20));\n    fs.rmSync(path.join(agent, \"pyproject.toml\"));\n    const result = applyAgentChanges(agent, fresh);\n    assert.equal(fs.readFileSync(path.join(fresh, \"pkg/testdata/out.golden\"), \"utf8\"), \"expected\\n\", \"golden files are test data\");\n    assert.equal(fs.readFileSync(path.join(fresh, \"web/__snapshots__/a.test.js.snap\"), \"utf8\"), \"exports[`a`] = `x`;\\n\");\n    assert.equal(fs.readFileSync(path.join(fresh, \"fixtures/input.json\"), \"utf8\"), \"{}\\n\");\n    assert.equal(fs.existsSync(path.join(outside, \"escape.py\")), false, \"nothing is written through a symlink in the fresh tree\");\n    assert.equal(fs.existsSync(path.join(fresh, \"toplevel.py\")), false, \"no new top-level Python module\");\n    assert.equal(fs.existsSync(path.join(fresh, \"newpkg/__init__.py\")), false, \"no new Python package directory\");\n    assert.equal(fs.readFileSync(path.join(fresh, \"lib/mod/helper.py\"), \"utf8\"), \"y = 1\\n\", \"a new module inside an existing package crosses over\");\n    assert.equal(fs.existsSync(path.join(fresh, \"lib/mod/huge.py\")), false, \"oversized files are not carried\");\n    assert.equal(fs.existsSync(path.join(fresh, \"pyproject.toml\")), true, \"a deleted manifest is not deleted in the checks\");\n    assert.match(result.configChanges.join(), /pyproject\\.toml deleted/, \"and it refuses the checks\");\n    assert.match(testConfigChange(\"Cargo.toml\", \"[package]\\nname = \\\"x\\\"\\n\", \"[package]\\nname = \\\"x\\\"\\nautotests = false\\n\") ?? \"\", /\\[package\\]/);\n    assert.match(testConfigChange(\"Cargo.toml\", \"[features]\\ndefault = [\\\"a\\\"]\\n\", \"[features]\\ndefault = []\\n\") ?? \"\", /\\[features\\]/);\n  } finally {\n    fs.rmSync(base, { recursive: true, force: true });\n  }\n});\n\ntest(\"Rust and Go compile-time file inclusion directives refuse hardened checks\", async () => {\n  const { applyAgentChanges, testConfigChange } = await hardened();\n  const rust = \"pub fn value() -> usize { 1 }\\n\";\n  const go = \"package app\\n\";\n  for (const [source, addition] of [\n    [\"src/lib.rs\", 'const SECRET: &str = include_str!(\"tests/hidden.rs\");'],\n    [\"src/lib.rs\", 'const SECRET: &str = include_str ! (\"tests/hidden.rs\");'],\n    [\"src/lib.rs\", 'const SECRET: &[u8] = include_bytes!(\"tests/hidden.rs\");'],\n    [\"src/lib.rs\", 'include!(\"tests/hidden.rs\");'],\n    [\"src/lib.rs\", '#[path = \"../tests/hidden.rs\"] mod hidden;'],\n  ] as const) {\n    assert.match(testConfigChange(source, rust, `${rust}${addition}\\n`) ?? \"\", /adds compile-time file inclusion/);\n  }\n  assert.match(testConfigChange(\"src/main.go\", go, `${go}//go:embed hidden_test.go\\nvar hidden string\\n`) ?? \"\", /adds \\/\\/go:embed directive/);\n\n  const base = fs.mkdtempSync(path.join(os.tmpdir(), \"embed-directive-\"));\n  try {\n    const agent = path.join(base, \"agent\");\n    const fresh = path.join(base, \"fresh\");\n    for (const dir of [agent, fresh]) {\n      fs.mkdirSync(path.join(dir, \"src\"), { recursive: true });\n      fs.writeFileSync(path.join(dir, \"src/lib.rs\"), rust);\n      fs.writeFileSync(path.join(dir, \"src/main.go\"), go);\n    }\n    fs.writeFileSync(path.join(agent, \"src/lib.rs\"), `${rust}const SECRET: &str = include_str!(\"tests/hidden.rs\");\\n`);\n    fs.writeFileSync(path.join(agent, \"src/main.go\"), `${go}//go:embed hidden_test.go\\nvar hidden string\\n`);\n    const result = applyAgentChanges(agent, fresh);\n    assert.match(result.configChanges.join(), /src\\/lib\\.rs adds compile-time file inclusion/);\n    assert.match(result.configChanges.join(), /src\\/main\\.go adds \\/\\/go:embed directive/);\n  } finally {\n    fs.rmSync(base, { recursive: true, force: true });\n  }\n});\n\ntest(\"Go and Rust hidden sources are absent during build audits and test execution\", { timeout: 120_000 }, async () => {\n  const { runIsolated } = await import(path.join(ROOT, \"eval/isolate.mjs\"));\n  const { testConfigChange } = await hardened();\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"compiled-oracle-e2e-\"));\n  try {\n    const go = path.join(root, \"go\");\n    fs.mkdirSync(go);\n    fs.writeFileSync(path.join(go, \"go.mod\"), \"module example.invalid/oracle\\n\\ngo 1.22\\n\");\n    fs.writeFileSync(path.join(go, \"main.go\"), \"package oracle\\n\");\n    fs.writeFileSync(path.join(go, \"visible_test.go\"), `package oracle\nimport (\"os\"; \"strings\"; \"testing\")\nfunc TestOracleIsGone(t *testing.T) {\n if _, err := os.Stat(\"/workspace/hidden_test.go\"); !os.IsNotExist(err) { t.Fatalf(\"hidden source remains: %v\", err) }\n if _, err := os.Stat(\"/workspace/hidden.txt\"); !os.IsNotExist(err) { t.Fatalf(\"hidden payload remains: %v\", err) }\n entries, _ := os.ReadDir(\"/tmp\"); for _, e := range entries { if strings.Contains(e.Name(), \"nexus-hidden\") { t.Fatal(e.Name()) } }\n for _, e := range os.Environ() { if strings.HasPrefix(e, \"NEXUS_HIDDEN_\") { t.Fatal(e) } }\n}\n`);\n    fs.writeFileSync(path.join(go, \"hidden_test.go\"), \"package oracle\\n// GO_HIDDEN_ORACLE_CANARY_112\\n\");\n    fs.writeFileSync(path.join(go, \"hidden.txt\"), \"GO_EMBED_ORACLE_CANARY_334\\n\");\n    const goResult = await runIsolated(\"go test .\", { cwd: go, hiddenSubpaths: [\"hidden_test.go\", \"hidden.txt\"] });\n    assert.equal(goResult.status, 0, `${goResult.stderr}\\n${goResult.stdout}`);\n    assert.equal(fs.readFileSync(path.join(go, \"hidden_test.go\"), \"utf8\"), \"package oracle\\n// GO_HIDDEN_ORACLE_CANARY_112\\n\", \"host source is restored after execution\");\n    assert.match(testConfigChange(\"main.go\", \"package oracle\\n\", \"package oracle\\n//go:embed hidden.txt\\nvar secret string\\n\") ?? \"\", /go:embed/);\n    fs.writeFileSync(path.join(go, \"main.go\"), \"package oracle\\nimport \\\"embed\\\"\\n//go:embed hidden.txt\\nvar secret embed.FS\\n\");\n    const goEmbed = await runIsolated(\"go test .\", { cwd: go, hiddenSubpaths: [\"hidden_test.go\", \"hidden.txt\"] });\n    assert.notEqual(goEmbed.status, 0, \"Phase 1 go build rejects a missing embedded oracle source\");\n    assert.match(`${goEmbed.stdout}${goEmbed.stderr}`, /hidden\\.txt/);\n    assert.equal(fs.readFileSync(path.join(go, \"hidden.txt\"), \"utf8\"), \"GO_EMBED_ORACLE_CANARY_334\\n\", \"failed preflight restores host-only oracle data\");\n\n    const rust = path.join(root, \"rust\");\n    fs.mkdirSync(path.join(rust, \"src\"), { recursive: true });\n    fs.mkdirSync(path.join(rust, \"tests\"), { recursive: true });\n    fs.writeFileSync(path.join(rust, \"Cargo.toml\"), '[package]\\nname = \"oracle_fixture\"\\nversion = \"0.1.0\"\\nedition = \"2021\"\\n');\n    fs.writeFileSync(path.join(rust, \"src/lib.rs\"), \"pub fn value() -> usize { 1 }\\n\");\n    fs.writeFileSync(path.join(rust, \"tests/visible.rs\"), `use std::{fs, env};\n#[test] fn oracle_is_gone() {\n assert!(!std::path::Path::new(\"/workspace/tests/hidden.rs\").exists());\n assert!(!fs::read_dir(\"/tmp\").unwrap().any(|e| e.unwrap().file_name().to_string_lossy().contains(\"nexus-hidden\")));\n assert!(!env::vars().any(|(k, _)| k.starts_with(\"NEXUS_HIDDEN_\")));\n}\n`);\n    fs.writeFileSync(path.join(rust, \"tests/hidden.rs\"), \"// RUST_HIDDEN_ORACLE_CANARY_223\\n\");\n    const rustResult = await runIsolated(\"cargo test --test visible --offline && cargo test --test visible --offline\", { cwd: rust, hiddenSubpaths: [\"tests/hidden.rs\"] });\n    assert.equal(rustResult.status, 0, `${rustResult.stderr}\\n${rustResult.stdout}`);\n    fs.writeFileSync(path.join(rust, \"src/lib.rs\"), 'pub const SECRET: &str = include_str ! (\"../tests/hidden.rs\");\\n');\n    const rustEmbed = await runIsolated(\"cargo test --test visible --offline\", { cwd: rust, hiddenSubpaths: [\"tests/hidden.rs\"] });\n    assert.notEqual(rustEmbed.status, 0, \"Phase 1 cargo check rejects a missing embedded oracle source\");\n    assert.match(`${rustEmbed.stdout}${rustEmbed.stderr}`, /hidden\\.rs/);\n    assert.equal(fs.readFileSync(path.join(rust, \"tests/hidden.rs\"), \"utf8\"), \"// RUST_HIDDEN_ORACLE_CANARY_223\\n\", \"failed preflight restores host-only oracle data\");\n    assert.match(testConfigChange(\"src/lib.rs\", \"pub fn value() -> usize { 1 }\\n\", 'pub const SECRET: &str = include_str ! (\"../tests/hidden.rs\");\\n') ?? \"\", /compile-time file inclusion/);\n  } finally { fs.rmSync(root, { recursive: true, force: true }); }\n});\n\ntest(\"manifest guards fail closed on TOML headers they do not recognise, go.mod blocks and new manifests\", async () => {\n  const { testConfigChange, applyAgentChanges } = await hardened();\n  const py = \"[project]\\nname = \\\"x\\\"\\ndependencies = []\\n\";\n  assert.match(testConfigChange(\"pyproject.toml\", py, `${py}[tool.pytest.ini_options] # x\\naddopts = \"--deselect hidden\"\\n`) ?? \"\", /tool\\.pytest/, \"a commented header is not folded into [project]\");\n  assert.match(testConfigChange(\"pyproject.toml\", py, `${py}  [tool.pytest.ini_options]\\naddopts = \"-q\"\\n`) ?? \"\", /tool\\.pytest/, \"an indented header is still a header\");\n  const cargo = \"[package]\\nname = \\\"x\\\"\\n\\n[dependencies]\\nserde = \\\"1\\\"\\n\";\n  assert.match(testConfigChange(\"Cargo.toml\", cargo, `${cargo}[[test]]\\nname = \"hidden_x\"\\nrequired-features = [\"nope\"]\\n`) ?? \"\", /\\[\\[test\\]\\]/, \"an array table is not folded into [dependencies]\");\n  assert.match(testConfigChange(\"Cargo.toml\", cargo, `${cargo}[profile.test]\\nopt-level = 3\\n`) ?? \"\", /profile\\.test/);\n  assert.match(testConfigChange(\"Cargo.toml\", cargo, cargo.replace('serde = \"1\"', 'serde = { version = \"1\", registry = \"evil\" }')) ?? \"\", /alternate-registry/);\n  assert.equal(testConfigChange(\"Cargo.toml\", cargo, cargo.replace('serde = \"1\"', 'serde = \"1.0.200\"')), null);\n  const withPath = cargo.replace('serde = \"1\"', 'serde = \"1\"\\nlocal = { path = \"crates/local\" }');\n  assert.equal(testConfigChange(\"Cargo.toml\", withPath, withPath.replace('serde = \"1\"', 'serde = \"1.0.200\"')), null, \"a baseline path dependency does not refuse unrelated edits\");\n  const gomod = \"module x\\n\\ngo 1.22\\n\\nrequire (\\n\\tgithub.com/a/b v1.0.0\\n)\\n\\nreplace (\\n\\tgithub.com/c/d => github.com/c/d v1.2.0\\n)\\n\";\n  assert.equal(testConfigChange(\"go.mod\", gomod, gomod.replace(\"v1.0.0\", \"v1.1.0\")), null, \"require changes are dependency edits\");\n  assert.match(testConfigChange(\"go.mod\", gomod, gomod.replace(\"v1.2.0\\n)\", \"v1.2.0\\n\\tgithub.com/a/b => ./fake\\n)\")) ?? \"\", /outside its require/, \"an entry added inside an existing replace block\");\n  const base = fs.mkdtempSync(path.join(os.tmpdir(), \"hardened-manifest-\"));\n  try {\n    const agent = path.join(base, \"agent\");\n    const fresh = path.join(base, \"fresh\");\n    for (const dir of [agent, fresh]) {\n      fs.mkdirSync(path.join(dir, \"src\", \"pkg\"), { recursive: true });\n      fs.writeFileSync(path.join(dir, \"go.mod\"), \"module x\\n\\ngo 1.22\\n\");\n      fs.writeFileSync(path.join(dir, \"src\", \"pkg\", \"__init__.py\"), \"\\n\");\n    }\n    fs.mkdirSync(path.join(agent, \"hiddenparent\"), { recursive: true });\n    fs.writeFileSync(path.join(agent, \"hiddenparent\", \"go.mod\"), \"module y\\n\");\n    fs.writeFileSync(path.join(agent, \"src\", \"packaging.py\"), \"raise SystemExit(0)\\n\");\n    fs.writeFileSync(path.join(agent, \"src\", \"pkg\", \"util.py\"), \"z = 1\\n\");\n    const result = applyAgentChanges(agent, fresh);\n    assert.match(result.configChanges.join(), /hiddenparent\\/go\\.mod added/, \"a new nested manifest refuses the checks\");\n    assert.equal(fs.existsSync(path.join(fresh, \"src\", \"packaging.py\")), false, \"src/ is not a package: no new module beside a src layout's importable root\");\n    assert.equal(fs.existsSync(path.join(fresh, \"src\", \"pkg\", \"util.py\")), true, \"a new module inside an existing package crosses over\");\n  } finally {\n    fs.rmSync(base, { recursive: true, force: true });\n  }\n});\nclearTimeout(killTimer);\nif (failed) {\n  process.stderr.write(\"trusted compiler inventory could not complete\\n\");\n  process.exitCode = 1;\n} else {\n  process.stdout.write(Buffer.concat(outputs.flat(), outputBytes));\n}\n","exit_code":0,"duration":{"secs":0,"nanos":28774}},"started_at_ms":1793295581984,"completed_at_ms":1793295581985}}
