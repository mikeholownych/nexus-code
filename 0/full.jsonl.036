1T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run echo \\\"version=$(node -p 'require(\\\"./package.json\\\").version')\\\" >> \\\"$GITHUB_OUTPUT\\\"\",\"number\":22,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run bash scripts/package-linux.sh \\\"v${{ steps.release-version.outputs.version }}\\\" \\\"$RUNNER_TEMP/dist\\\"\",\"number\":23,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run bash scripts/package-linux.sh \\\"v${{ steps.release-version.outputs.version }}\\\" \\\"$RUNNER_TEMP/repro-check\\\"\",\"number\":24,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\\\" \\\"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-v${{ steps.release-version.outputs.version }}.tar.gz\\\"\",\"number\":25,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/SHA256SUMS\\\" \\\"$RUNNER_TEMP/repro-check/SHA256SUMS\\\"\",\"number\":26,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/THIRD_PARTY_NOTICES.txt\\\" \\\"$RUNNER_TEMP/repro-check/THIRD_PARTY_NOTICES.txt\\\"\",\"number\":27,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cyclonedx validate --input-file \\\"$RUNNER_TEMP/dist/sbom.cdx.json\\\" --fail-on-errors\",\"number\":28,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cmp \\\"$RUNNER_TEMP/dist/sbom.cdx.json\