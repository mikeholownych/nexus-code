ical roots concurrently, while keeping one fail-closed deadline and\n+      // retaining per-process output buffers so NUL-delimited paths cannot interleave.\n+      const inventory = path.join(path.dirname(fileURLToPath(import.meta.url)), \"scan-compiler-exposure.mjs\");\n+      const inventoryStat = fs.lstatSync(inventory);\n+      if (!inventoryStat.isFile() || inventoryStat.isSymbolicLink() || (inventoryStat.mode & 0o022) !== 0\n+        || fs.realpathSync(inventory) !== inventory) {\n+        throw new Error(\"trusted compiler inventory helper is unavailable\");\n+      }\n+      const result = spawnSync(process.execPath, [inventory, ...[...directoryRoots].sort()], {\n         encoding: null,\n-        timeout: 30_000,\n+        timeout: 35_000,\n         maxBuffer: 64 * 1024 * 1024,\n         env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n       });\n--- untracked helper ---\n// Run one trusted GNU find inventory per canonical system root. These roots are\n// independent, and parallel traversal avoids serially timing out on large images.\nimport { spawn } from \"node:child_process\";\n\nconst FIND = \"/usr/bin/find\";\nconst MAX_OUTPUT = 64 * 1024 * 1024;\nconst TIMEOUT_MS = 30_000;\nconst COMPILER_NAMES = [\n  \"go\", \"go[0-9]*\", \"go-[0-9]*\",\n  \"rustc\", \"rustc[0-9]*\", \"rustc-[0-9]*\",\n  \"cargo\", \"cargo[0-9]*\", \"cargo-[0-9]*\",\n  \"rustup\",\n];\n\nfunction findArgs(root) {\n  const nameExpression = COMPILER_NAMES.flatMap((name, index) => index === 0\n    ? [\"-name\", name]\n    : [\"-o\", \"-name\", name]);\n  const linkTargetExpression = COMPILER_NAMES.flatMap((name, index) => {\n    const patterns = [name, `*/${name}`];\n    return patterns.flatMap((pattern, patternIndex) => index === 0 && patternIndex === 0\n      ? [\"-lname\", pattern]\n      : [\"-o\", \"-lname\", pattern]);\n  });\n  return [\n    \"-P\", root,\n    \"(\", \"(\", \"-type\", \"l\", \"(\", ...nameExpression, \"-o\", ...linkTargetExpression, \")\", \")\",\n    \"-o\",\n    \"(\", \"(\", ...nameExpression, \")\", \"-a\", \"-type\", \"f\", \"-a\", \"-perm\", \"/111\", \")\",\n    \")\", \"-print0\",\n  ];\n}\n\nconst roots = process.argv.slice(2);\nif (roots.length === 0 || roots.length > 16 || roots.some((root) => !root.startsWith(\"/\"))) {\n  process.stderr.write(\"compiler inventory roots must be absolute\\n\");\n  process.exit(2);\n}\n\nconst children = new Set();\nconst outputs = [];\nlet outputBytes = 0;\nlet failed = false;\nlet killTimer;\n\nfunction stopAll() {\n  for (const child of children) child.kill(\"SIGTERM\");\n  clearTimeout(killTimer);\n  killTimer = setTimeout(() => {\n    for (const child of children) child.kill(\"SIGKILL\");\n  }, 1_000);\n  killTimer.unref();\n}\n\nprocess.on(\"SIGTERM\", () => {\n  failed = true;\n  stopAll();\n});\nprocess.on(\"SIGINT\", () => {\n  failed = true;\n  stopAll();\n});\n\nconst deadline = setTimeout(() => {\n  failed = true;\n  stopAll();\n}, TIMEOUT_MS);\n\nfunction scanRoot(root) {\n  return new Promise((resolve) => {\n  const child = spawn(FIND, findArgs(root), {\n    env: { HOME: \"/nonexistent\", LANG: \"C\", PATH: \"/usr/bin:/bin\" },\n    stdio: [\"ignore\", \"pipe\", \"pipe\"],\n  });\n  children.add(child);\n  const stdout = [];\n  let stderrBytes = 0;\n  child.stdout.on(\"data\", (chunk) => {\n    outputBytes += chunk.length;\n    if (outputBytes > MAX_OUTPUT) {\n      failed = true;\n      stopAll();\n      return;\n    }\n    stdout.push(chunk);\n  });\n  child.stderr.on(\"data\", (chunk) => {\n    stderrBytes += chunk.length;\n    failed = true;\n    stopAll();\n  });\n  child.on(\"error\", () => {\n    failed = true;\n    stopAll();\n  });\n  child.on(\"close\", (code) => {\n    children.delete(child);\n    if (code !== 0 || stderrBytes !== 0) {\n      failed = true;\n      stopAll();\n    }\n    outputs.push(stdout);\n    resolve();\n  });\n  });\n}\n\nlet nextRoot = 0;\nasync function worker() {\n  while (!failed && nextRoot < roots.length) {\n    const root = roots[nextRoot++];\n    await scanRoot(root);\n  }\n}\n\nawait Promise.all(Array.from({ length: Math.min(4, roots.length) }, () => worker()));\nclearTimeout(deadline);\nclearTimeout(killTimer);\nif (failed) {\n  process.stderr.write(\"trusted compiler inventory could not complete\\n\");\n  process.exitCode = 1;\n} else {\n  process.stdout.write(Buffer.concat(outputs.flat(), outputBytes));\n}\n--- changed timestamps ---\neval/isolate.mjs 2026-10-29 16:12:36.271647629 +0000 51040\neval/scan-compiler-exposure.mjs 2026-10-29 16:14:55.077011423 +0000 3259\n--- Kimi process context ---\n/home/mike/nexus-code\nkimi-code,3146694\n  |-bash,3863759 -c...\n  |   `-gh,3863761 run watch 40902733867 --interval 30 --exit-status\n  |       |-{gh},3863763\n  |       |-{gh},3863764\n  |       |-{gh},3863765\n  |       |-{gh},3863766\n  |       |-{gh},3863770\n  |       |-{gh},3863771\n  |       |-{gh},3863772\n  |       |-{gh},3863773\n  |       |-{gh},3863777\n  |       |-{gh},3863781\n  |       |-{gh},3863784\n  |       |-{gh},3863804\n  |       `-{gh},3863805\n  |-{kimi-code},3146695\n  |-{kimi-code},3146696\n  |-{kimi-code},3146697\n  |-{kimi-code},3146698\n  |-{kimi-code},3146699\n  |-{kimi-code},3146700\n  |-{kimi-code},3147254\n  |-{kimi-code},3147255\n  |-{kimi-code},3147256\n  |-{kimi-code},3147257\n  |-{kimi-code},3147258\n  |-{kimi-code},3147259\n  |-{kimi-code},3147260\n  |-{kimi-code},3147261\n  |-{kimi-code},3147262\n  |-{kimi-code},3147263\n  |-{kimi-code},3147264\n  |-{kimi-code},3147265\n  |-{kimi-code},3147266\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18871-74a8-7bc3-9805-31344cd738a3","create_time":1793290547.6565337}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
