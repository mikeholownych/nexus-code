mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_b3438d6beb9081918fba3625bc988128/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"plugin://plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"name\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"title\":\"Sites\",\"description\":\"Build and deploy websites with Sites. Use of Sites is subject to the ChatGPT Sites Terms (https://openai.com/policies/chatgpt-sites-terms/), and you are responsible for your website content.\",\"mimeType\":\"mcp/plugin\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_689987207de08191979cf68eca2941c6\",\"plugin_name\":\"sites\",\"plugin_release_id\":\"pluginrel_6adbbe74820481918f7ce521432d9acb\",\"plugin_release_version\":\"1.1.2\",\"apps\":[\"app://connector_20205bf7d4e99a89d7154bb849718324\"],\"skills\":[\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites\",\"skill://plugin_connector_1p_689987207de08191979cf68eca2941c6/sites-remix\"],\"requires_executor\":true,\"mcp_servers\":[],\"contents\":[\"bundle\"],\"bundle\":\"plugin://plugin_connector_1p_689987207de08191979cf68eca2941c6/bundle\"}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-drive\",\"name\":\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-drive\",\"title\":\"Google Drive\",\"description\":\"Use connected Google Drive as the single entrypoint for Drive, Docs, Sheets, and Slides work. Use when the user wants to find, fetch, organize, share, export, copy, or delete Drive files, or summarize and edit Google Docs, Google Sheets, and Google Slides through one unified Google Drive plugin.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7\",\"plugin_name\":\"google-drive\",\"plugin_release_id\":\"pluginrel_6ac961498a348191884547b11910c3e7\",\"plugin_release_skill_id\":\"pluginrsk_0befdf86d0c08191ba80243a8845f42d\",\"skill_name\":\"google-drive\",\"contents\":[\"assets\",\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-sheets\",\"name\":\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-sheets\",\"title\":\"Google Sheets\",\"description\":\"Analyze and edit connected Google Sheets with range precision. Use when the user wants to create Google Sheets, find a spreadsheet, inspect tabs or ranges, search rows, plan formulas, create or repair charts, clean or restructure tables, write concise summaries, or make explicit cell-range updates.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7\",\"plugin_name\":\"google-drive\",\"plugin_release_id\":\"pluginrel_6ac961498a348191884547b11910c3e7\",\"plugin_release_skill_id\":\"pluginrsk_9fdebc5bc280819187fdaa202153760b\",\"skill_name\":\"google-sheets\",\"contents\":[\"assets\",\"references\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-docs\",\"name\":\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-docs\",\"title\":\"Google Docs\",\"description\":\"Create and edit native Google Docs through connected tools.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7\",\"plugin_name\":\"google-drive\",\"plugin_release_id\":\"pluginrel_6ac961498a348191884547b11910c3e7\",\"plugin_release_skill_id\":\"pluginrsk_6136474279d48191a8c288998ba66479\",\"skill_name\":\"google-docs\",\"contents\":[\"assets\",\"host\",\"references\",\"runtime\",\"scripts\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-slides\",\"name\":\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7/google-slides\",\"title\":\"Google Slides\",\"description\":\"Route Google Slides authoring requests and derive a design system from a native template or reference deck. Use this skill when the user provides an existing native Google Slides deck as a template, reference, or prior-period source, or asks to edit, update, repair, restyle, or clean up an existing native Google Slides deck. Use the Presentations skill instead for net-new presentation creation when no existing native Google Slides deck must be followed.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_ab21a553bfbc81919ea8fd1858e3ffa7\",\"plugin_name\":\"google-drive\",\"plugin_release_id\":\"pluginrel_6ac961498a348191884547b11910c3e7\",\"plugin_release_skill_id\":\"pluginrsk_75c67c9f37108191a6df583408c14af8\",\"skill_name\":\"google-slides\",\"contents\":[\"assets\",\"host\",\"runtime\",\"scripts\"],\"allow_implicit_invocation\":true}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-analytics-dashboard\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-analytics-dashboard\",\"title\":\"Analytics Dashboard\",\"description\":\"Create a spreadsheet using the Analytics Dashboard template and its retained reference file. Use when the user selects or names Analytics Dashboard. Monitor acquisition, engagement, retention, revenue, and conversion funnel KPIs with charts.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdbd081918551b9ff949b0dcd\",\"skill_name\":\"artifact-template-analytics-dashboard\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-business-review\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc4