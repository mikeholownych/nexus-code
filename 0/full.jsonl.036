ived/FILE_docs_STATE_COMPATIBILITY.md-owner-transfer-to-root-20261020T113030Z.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_reviews_evidence_v1-qualification_v1.0.0-rc.3-root-20261023-2a84b0b.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_v1.0.0_READINESS.md-20261028T190045Z.stale-claim\n/home/mike/nexus-code/.git/nexus-claims/archived/claude-FILE_docs_v1.0.0_specs_SPEC-12-cli-and-tui-upgrade.md-20261025T175837Z\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_releases_v1.0.0-rc.4.md_MERGED_20261024T022500Z\n/home/mike/nexus-code/.git/nexus-claims/archived/PR145-FILE_docs_releases_v1.0.0-rc.2.md-merged-20261022T141420Z.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_v1.0.0_ACCEPTANCE.md-owner-20261020T0200Z.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_v1.0.0_ACCEPTANCE.md-owner-20261021T012822Z-prior-restore-scope.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_USER_MANUAL.md-codex-root-pr299-docs-complete-20261028T1146Z.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_releases_v1.0.0-rc.4.md.claude-code.2026-10-24T07:58:46Z.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_v1.0.0_plans_PLAN-01-safe-execution-defaults.md-released-PR100-20261024.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_v1.0.0_READINESS.md-merged-PR316-20261029T0535Z\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_v1.0.0_READINESS.md-20261028T190029Z.owner.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_v1.0.0_READINESS.md-codex-api-root-recovered-20261021T1455Z\n/home/mike/nexus-code/.git/nexus-claims/archived/REDACTED\n/home/mike/nexus-code/.git/nexus-claims/archived/REDACTED.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_UPGRADE_SECURITY.md-owner-transfer-to-root-20261020T113030Z.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_reviews_evidence_v1_defect-discovered-verifier-baseline-20261026T090731Z.json\n/home/mike/nexus-code/.git/nexus-claims/archived/FILE_docs_v1.0.0_REQUIREMENTS.md-owner-20261021T012458Z-handoff-from-codex-app-01a139bf.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_reviews_evidence_v1-qualification_rc.10_providers_chatgpt-receipts-20261028T190304Z.jsonl\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_releases_v1_0_0-rc_11_md\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_v1.0.0_ROADMAP.md\n/home/mike/nexus-code/.git/nexus-claims/REDACTED.md\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_releases_v1_0_0-rc_6_md\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_reviews_evidence_v1_qualification_rc.3_providers_e5-openrouter-live-task-20261023.json\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_reviews_evidence_v1-qualification_rc.10_providers_SHA256SUMS\n/home/mike/nexus-code/.git/nexus-claims/DOCS_V11_LAYERED_MEMORY\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_reviews_evidence_v1_qualification_rc.3_providers_provider-receipts-20261023T1659Z.jsonl\n/home/mike/nexus-code/.git/nexus-claims/REDACTED\n/home/mike/nexus-code/.git/nexus-claims/REDACTED.md\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_reviews_evidence_v1-qualification_rc.7\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_v1.0.0_specs_SPEC-C1-contest-submission-track.md\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_reviews_evidence_v1_qualification_rc10_terminal_scripted\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_CLIENT_GUIDE.md\n/home/mike/nexus-code/.git/nexus-claims/RELEASE_PUBLISHER\n/home/mike/nexus-code/.git/nexus-claims/V1_DECISION_REJECTED_OPERATOR_DOCS_20261028\n/home/mike/nexus-code/.git/nexus-claims/FILE_docs_reviews_evidence_v1_qualification_rc.3_providers_e5-provider-verification-20261023T1659Z.json\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - name: Require a version-matched tag on main\n        run: |\n          git fetch origin main --no-tags\n          git merge-base --is-ancestor \"$GITHUB_SHA\" origin/main\n          test \"${GITHUB_REF_NAME#v}\" = \"$(node -p 'require(\"./package.json\").version')\"\n          node scripts/sync-version.mjs --check --tag \"$GITHUB_REF_NAME\"\n          test -f \"docs/releases/${GITHUB_REF_NAME}.md\" || { echo \"Missing docs/releases/${GITHUB_REF_NAME}.md\" >&2; exit 1; }\n      - name: Require a stable tag to be a version-only commit on its RC\n        if: ${{ !contains(github.ref_name, '-') }}\n        # The checkout has full history and tags (fetch-depth: 0). The checker runs from the RC's own copy so a stable\n        # commit cannot replace it; branch and tag protection remain the control over the workflow file itself.\n        run: |\n          rc=\"$(git tag --points-at \"$GITHUB_SHA^\" | grep -E \"^${GITHUB_REF_NAME//./\\\\.}-rc\\.[0-9]+$\" | sort -V | tail -n 1 || true)\"\n          test -n \"$rc\" || { echo \"the parent of $GITHUB_REF_NAME is not a ${GITHUB_REF_NAME}-rc.N tag\" >&2; exit 1; }\n          git show \"$rc:scripts/check-version-only-diff.mjs\" > \"$RUNNER_TEMP/check-version-only-diff.mjs\"\n          node \"$RUNNER_TEMP/check-version-only-diff.mjs\" \"$rc\" \"$GITHUB_SHA\"\n      - run: npm ci --prefix cli\n      - run: npm --prefix cli run build\n      - run: cargo test --locked --manifest-path core/Cargo.toml\n      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n      - run: npm --prefix cli test\n      - run: bash scripts/security_gates.sh\n      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/dist\"\n      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/repro-check\"\n      - run: cmp \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\" \"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - run: cmp \"$RUNNER_TEMP/dist/SHA256SUMS\" \"$RUNNER_TEMP/repro-check/SHA256SUMS\"\n      - run: cmp \"$RUNNER_TEMP/dist/THIRD_PARTY_NOTICES.txt\" \"$RUNNER_TEMP/repro-check/THIRD_PARTY_NOTICES.txt\"\n      - run: cyclonedx validate --input-file \"$RUNNER_TEMP/dist/sbom.cdx.json\" --fail-on-errors\n      - run: cmp \"$RUNNER_TEMP/dist/sbom.cdx.json\" \"$RUNNER_TEMP/repro-check/sbom.cdx.json\"\n      - run: cmp \"$RUNNER_TEMP/dist/install.sh\" \"$RUNNER_TEMP/repro-check/install.sh\"\n      - run: bash scripts/smoke-package.sh \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - run: bash scripts/installer-smoke.sh \"$GITHUB_WORKSPACE/install.sh\" \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - name: Attest build provenance\n        uses: actions/attest-build-provenance@92c65d2898f1f53cfdc910b962cecff86e7f8fcc # v1\n        with:\n          subject-path: |\n            ${{ runner.temp }}/dist/nexus-linux-x86_64-${{ github.ref_name }}.tar.gz\n            ${{ runner.temp }}/dist/SHA256SUMS\n      # RC tags (vX.Y.Z-rc.N) publish a prerelease: the workflow-produced RC is the qualification candidate\n      # (ACCEPTANCE §1.1 stage 2). Stable tags only build an unpublished draft (stage 5); it is published by hand with\n      # `gh release edit <tag> --draft=false` after the stable artifact checks and the signed acceptance disposition.\n      - uses: softprops/action-gh-release@3bb12739c298aeb8a4eeaf626c5b8d85266b0e65 # v2\n        with:\n          files: ${{ runner.temp }}/dist/*\n          body_path: docs/releases/${{ github.ref_name }}.md\n          prerelease: ${{ contains(github.ref_name, '-') }}\n          draft: ${{ !contains(github.ref_name, '-') }}\n# Nexus Code v1.0.0-rc.10 release candidate\n\n**Maturity:** release candidate; prerelease, not stable.\n\n**Status:** this candidate is for exact-artifact qualification. It does not establish independent acceptance or authorize stable v1.0.0 promotion. Qualification results must identify the workflow-produced package and its digest.\n\nThis release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and sidecar, production Node dependencies, Rust `harness-core`, and Ratatui `nexus-tui`.\n\n## Changes since RC9\n\n- **Monochrome terminal output:** when the TUI resolves terminal depth to monochrome, Crossterm color output is disabled. This prevents color reset escapes on terminals such as `TERM=dumb`. RC9 itself remains unchanged and retains its recorded accessibility failure.\n\n## Runtime requirements\n\n- Linux x86-64 with glibc 2.35 or newer.\n- Node.js 22 or newer.\n- An OpenAI-compatible inference endpoint, local or explicitly selected provider.\n\nThe archive does not include Node.js. Rust and Cargo are not required at runtime. No other OS or architecture is claimed.\n\n## Candidate assets\n\nThe release workflow for `v1.0.0-rc.10` is expected to produce the version-matched Linux archive, `SHA256SUMS`, SBOM, notices, installer, and provenance. The workflow run, tag commit, artifact digests, and qualification evidence must be recorded before this candidate can be accepted. Local builds are not interchangeable with the workflow-produced artifacts.\n","exit_code":0,"duration":{"secs":0,"nanos":801486608}},"started_at_ms":1793296577213,"completed_at_ms":1793296578015}}
