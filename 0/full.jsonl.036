er paths fail closed instead of disappearing during output decoding\");\n   const fakeGoAliasTarget = path.join(fakeSystemAlias, \"lib\", \"go-1.22.12\", \"go\");\n   const maskArgs = compilerExposureMaskArgs({ paths: [fakeGoTarget, fakeGoAliasTarget, fakeCargo, fakeCargo], problem: null });\n   const maskedDestinations = maskArgs.filter((value, index) => index > 0 && maskArgs[index - 1] === \"/dev/null\");\ndiff --git a/eval/scan-compiler-exposure.mjs b/eval/scan-compiler-exposure.mjs\nindex f1fd1747..94a2d197 100644\n--- a/eval/scan-compiler-exposure.mjs\n+++ b/eval/scan-compiler-exposure.mjs\n@@ -1,5 +1,6 @@\n // Run trusted GNU find inventories across canonical system roots. Large roots are\n // split at their immediate children so a broad directory cannot monopolize a worker.\n+import { isUtf8 } from \"node:buffer\";\n import { spawn } from \"node:child_process\";\n import path from \"node:path\";\n \n@@ -232,5 +233,11 @@ if (failed) {\n   process.stderr.write(\"trusted compiler inventory could not complete\\n\");\n   process.exitCode = 1;\n } else {\n-  process.stdout.write(Buffer.concat(outputs.flat(), outputBytes));\n+  const output = Buffer.concat(outputs.flat(), outputBytes);\n+  if (!isUtf8(output)) {\n+    process.stderr.write(\"trusted compiler inventory paths are not valid UTF-8\\n\");\n+    process.exitCode = 1;\n+  } else {\n+    process.stdout.write(output);\n+  }\n }\n    PID    PPID     ELAPSED STAT CMD\n4139881    6852       56:26 Ss   make test\n4153000 4139881       55:13 Sl   npm test\n4153012 4153011       55:13 Sl   node scripts/run_tests.mjs\n4153025 4153012       55:12 Sl   node /home/mike/nexus-wt/pr318-scan-rebased-check/cli/node_modules/.bin/tsx --test --test-concurrency=1 test/agent_discovered_verifier_premutation.test.ts test/agent_observer.test.ts test/agent_runtime_identity.test.ts test/agent_terminal_controls.test.ts test/agt111_subagent_parity.test.ts test/app.test.ts test/approval_policy.test.ts test/approval_review.test.ts test/