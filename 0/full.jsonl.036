n=40889771372_FAILURE\tfinding=eval_hardened_130_timeout_30s_in_test_matrix_22_24\n2026-10-29T14:40:10Z PR324_CORRECTION merged=14be4b8a2fc56c00e638bc7fd41eadcdf5aa91fd merged_at=2026-10-29T14:40:10Z by=Mike_owner_after_explicit_5x3_waiver; claims_archived_and_released; waiver_scope=v1.0.0_only; automated_and_scripted_PTY_gates_remain\n2026-10-29T14:58Z PR318_ITERATION head=e85fecfdc4a49004dca9eca0097f595534912c9b base=14be4b8a2fc56c00e638bc7fd41eadcdf5aa91fd commit=f470b992 REDACTED focused_tests=eval_integrity_31of31+eval_hardened_16of16 requirements_enforce=exit0 pinned_go=1.22.12_side_by_side_/opt/nexus-qual/go github_CI=Node22_pending_Node24_pending_Entire_pending reviewer_identity=owner_conflict_no_self_approval\n2026-10-29T14:58Z CLAIM_RELEASE SUITE owner=codex-root outcome=PR318_focused_reproduction_complete exact_head=e85fecfdc4a49004dca9eca0097f595534912c9b tests=eval_integrity+eval_hardened_47of47 isolated_HOME TMPDIR_private\n2026-10-29T15:04:22Z\tagent=antigravity-47e461b3\tevent=REVIEW_PR325_ACCEPT\tpr=325\thead=82b17a31ff79a1e4dd64efe0a8dfdec56d3872d8\tbase=14be4b8a2fc56c00e638bc7fd41eadcdf5aa91fd\tdiff_sha256=6f67cc192364ff2a113cd5af83fc1a5358048da958f82b7b3ca13b21cb41a4b3\tcomment=6500329436\tREDACTED\n2026-10-29T15:04:22Z\tagent=antigravity-47e461b3\tevent=MAIN_POSTMERGE_CI_FINDING\tsha=14be4b8a2fc56c00e638bc7fd41eadcdf5aa91fd\trun=40893795104\ttest_matrix_22=SUCCESS\ttest_matrix_24=SUCCESS\tlinux_x86_64=FAILURE\tREDACTED.1.29\tremediation=cargo_update_libz-sys_to_1.1.31\n2026-10-29T15:10:09Z\tagent=antigravity-47e461b3\tevent=REVIEW_PR318_ACCEPT\tpr=318\thead=e85fecfdc4a49004dca9eca0097f595534912c9b\tbase=14be4b8a2fc56c00e638bc7fd41eadcdf5aa91fd\tdiff_sha256=7d8f2384922d2865190b582757e7e8861d7bbc2a04a2be8c107b30c5fdc51aac\tcomment=6500471664\tcodeql=40896149686_SUCCESS\tscan_latency=find_native_6.3s_vs_timeout\n2026-10-29T15:15:50Z\tagent=antigravity-47e461b3\tevent=REVIEW_PR318_ACTION_REQUIRED\tpr=318\thead=e85fecfdc4a49004dca9eca0097f595534912c9