\\s*no checkpoint was written\\.?$/i, \"\"),\n+            100,\n+          );\n+          const message = sensitiveContentBlocked\n+            ? undefined\n+            : `Checkpoint failed: ${failure}. No checkpoint was written. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 retry while allowing sensitive persistence, 4 cancel this turn, or 5 re-enter the instruction.`;\n+          const choice = await this.requestCheckpointChoice(turnId, signal, message);\n           if (choice === \"cancel\" || choice === \"other\") {\n             const message = choice === \"other\"\n               ? \"This turn was not started. Enter a different instruction in the composer.\"\n@@ -552,29 +568,17 @@ export class SidecarServer {\n             agent.setCheckpointReadOnlyFallback(true);\n             this.emit({ type: \"notice\", text: \"Continuing this turn in read-only mode as requested. Workspace changes, unsafe commands, external actions, and delegation are disabled.\" });\n             this.emitSessionState();\n+            checkpointReady = true;\n           } else if (choice === \"without_checkpoint\") {\n             this.emit({ type: \"notice\", text: \"Continuing in the current mode without a rollback checkpoint, as requested.\" });\n+            checkpointReady = true;\n           } else if (choice === \"allow_sensitive\") {\n             allowSensitiveCheckpoint = true;\n             this.emit({ type: \"notice\", text: \"Creating a checkpoint that may persist sensitive workspace content, as requested.\" });\n           }\n-        } else {\n-          const message = `No checkpoint could be saved, so the turn did not start: ${redactSecrets(errorText(err))}`;\n-          this.emit({ type: \"error\", id: turnId, code: \"INTERNAL\", message });\n-          return;\n         }\n       }\n     }\n-    if (allowSensitiveCheckpoint) {\n-      try {\n-        this.checkpointManager.createCheckpoint(checkpoint, { allowSensitive: true });\n-        agent.setCheckpointReadOnlyFallback(false);\n-      } catch (err) {\n-        const message = `No checkpoint could be saved, so the turn did not start: ${redactSecrets(errorText(err))}`;\n-        this.emit({ type: \"error\", id: turnId, code: \"INTERNAL\", message });\n-        return;\n-      }\n-    }\n     if (typeof prompt === \"string\") {\n       const decision = agent.objectiveDecision(prompt);\n       if (decision.kind === \"amend\") {\n@@ -658,7 +662,11 @@ export class SidecarServer {\n     pending.settle(approved);\n   }\n \n-  private requestCheckpointChoice(turnId: string, signal: AbortSignal): Promise<\"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\"> {\n+  private requestCheckpointChoice(\n+    turnId: string,\n+    signal: AbortSignal,\n+    message = \"Sensitive content blocked the checkpoint. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 create a checkpoint anyway (may persist sensitive content), 4 cancel this turn, or 5 re-enter the instruction.\",\n+  ): Promise<\"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\"> {\n     if (signal.aborted) return Promise.resolve(\"cancel\");\n     const id = `checkpoint-choice-${++this.approvalSeq}`;\n     return new Promise((resolve) => {\n@@ -674,7 +682,7 @@ export class SidecarServer {\n         type: \"checkpoint.choice.request\",\n         id,\n         turn_id: turnId,\n-        message: \"Sensitive content blocked the checkpoint. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 create a checkpoint anyway (may persist sensitive content), 4 cancel this turn, or 5 re-enter the instruction.\",\n+        message,\n       });\n     });\n   }\ndiff --git a/cli/test/sidecar.test.ts b/cli/test/sidecar.test.ts\nindex ff68f5d..55f03ab 100644\n--- a/cli/test/sidecar.test.ts\n+++ b/cli/test/sidecar.test.ts\n@@ -459,6 +459,69 @@ describe(\"SidecarServer: sessions and slash commands\", () => {\n     });\n   });\n \n+  test(\"checkpoint failure after sensitive persistence consent asks how to proceed\", async () => {\n+    let modelCalls = 0;\n+    await withSidecar(() => {\n+      modelCalls += 1;\n+      return { kind: \"text\", content: \"Review started.\" };\n+    }, \"auto\", async ({ events, repo, app, send }) => {\n+      const sensitiveMarker = `ghp_${\"G\".repeat(36)}`;\n+      fs.writeFileSync(path.join(repo, \"base.txt\"), `changed ${sensitiveMarker}\\n`);\n+      const checkpointManager = app.getCheckpointManager() as any;\n+      const createCheckpoint = checkpointManager.createCheckpoint.bind(checkpointManager);\n+      let attempts = 0;\n+      checkpointManager.createCheckpoint = (name: string, options?: { allowSensitive?: boolean }) => {\n+        attempts += 1;\n+        if (options?.allowSensitive) {\n+          throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n+        }\n+        return createCheckpoint(name, options);\n+      };\n+\n+      await send({ type: \"prompt.submit\", id: \"t-sensitive-checkpoint-failure\", text: \"review the codebase\" });\n+      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\n+      const initialChoice = events.find((event) => event.type === \"checkpoint.choice.request\");\n+      await send({ type: \"checkpoint.choice\", id: initialChoice.id, choice: \"allow_sensitive\" });\n+\n+      await waitUntil(() => events.filter((event) => event.type === \"checkpoint.choice.request\").length === 2);\n+      const recoveryChoice = events.filter((event) => event.type === \"checkpoint.choice.request\")[1];\n+      assert.match(recoveryChoice.message, /protected Git state.*No checkpoint was written/);\n+      assert.match(recoveryChoice.message, /2 continue without a rollback checkpoint/);\n+      assert.equal(modelCalls, 0, \"the turn must remain unstarted while awaiting an explicit recovery choice\");\n+\n+      await send({ type: \"checkpoint.choice\", id: recoveryChoice.id, choice: \"without_checkpoint\" });\n+      await waitUntil(() => events.some((event) => event.type === \"turn.result\" && event.turn_id === \"t-sensitive-checkpoint-failure\"));\n+      assert.equal(attempts, 2);\n+      assert.ok(modelCalls > 0, \"the explicitly authorized turn should proceed\");\n+      assert.equal(app.getCheckpointManager().listCheckpoints().length, 0);\n+      assert.ok(events.some((event) => event.type === \"notice\" && /without a rollback checkpoint, as requested/.test(event.text)));\n+    });\n+  });\n+\n+  test(\"an initial checkpoint failure offers read-only and no-checkpoint choices\", async () => {\n+    let modelCalls = 0;\n+    await withSidecar(() => {\n+      modelCalls += 1;\n+      return { kind: \"text\", content: \"Review started.\" };\n+    }, \"auto\", async ({ events, app, send }) => {\n+      const checkpointManager = app.getCheckpointManager() as any;\n+      checkpointManager.createCheckpoint = () => {\n+        throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n+      };\n+\n+      await send({ type: \"prompt.submit\", id: \"t-initial-checkpoint-failure\", text: \"review the codebase\" });\n+      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\n+      const request = events.find((event) => event.type === \"checkpoint.choice.request\");\n+      assert.match(request.message, /protected Git state.*No checkpoint was written/);\n+      assert.equal(modelCalls, 0, \"the turn must remain unstarted until the user chooses\");\n+\n+      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"without_checkpoint\" });\n+      await waitUntil(() => events.some((event) => event.type === \"turn.result\" && event.turn_id === \"t-initial-checkpoint-failure\"));\n+      assert.ok(modelCalls > 0, \"the explicitly authorized turn should proceed\");\n+      assert.ok(events.some((event) => event.type === \"notice\" && /without a rollback checkpoint, as requested/.test(event.text)));\n+    });\n+  });\n+\n   test(\"cancel choice does not start the turn\", async () => {\n     await withSidecar(() => ({ kind: \"text\", content: \"must not run\" }), \"review\", async ({ server, events, repo, send }) => {\n       fs.writeFileSync(path.join(repo, \"base.txt\"), `changed ${`ghp_${\"D\".repeat(36)}`}\\n`);\ndiff --git a/core/src/bin/nexus_tui/live_view.rs b/core/src/bin/nexus_tui/live_view.rs\nindex 763f4fe..4d9ea0a 100644\n--- a/core/src/bin/nexus_tui/live_view.rs\n+++ b/core/src/bin/nexus_tui/live_view.rs\n@@ -240,12 +240,15 @@ fn render_checkpoint_choice(\n     // renders those choices separately, so use a compact warning to keep all five\n     // visible on the smallest supported terminal size.\n     let display_message = if message.starts_with(\"Sensitive content blocked the checkpoint\") {\n-        \"Sensitive content may persist if you create a checkpoint anyway.\"\n+        \"Sensitive content may persist if you create a checkpoint anyway.\".to_owned()\n+    } else if let Some(failure) = message.strip_prefix(\"Checkpoint failed: \") {\n+        let failure = failure.split(\". Choose \").next().unwrap_or(failure);\n+        format!(\"Checkpoint failed: {failure}\")\n     } else {\n-        message\n+        message.to_owned()\n     };\n     let mut lines = markdown::wrap(\n-        vec![Span::raw(display_message.to_owned())],\n+        vec![Span::raw(display_message)],\n         usize::from(width),\n         Vec::new(),\n         Vec::new(),\n@@ -2654,6 +2657,23 @@ mod tests {\n         ]);\n     }\n \n+    #[test]\n+    fn checkpoint_failure_modal_keeps_reason_and_choices_visible_on_small_terminal() {\n+        let mut state = ready();\n+        feed(&mut state, &[r#\"{\"v\":1,\"type\":\"checkpoint.choice.request\",\"id\":\"choice-failure\",\"turn_id\":\"t1\",\"message\":\"Checkpoint failed: protected Git state could not be verified. No checkpoint was written. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 retry while allowing sensitive persistence, 4 cancel this turn, or 5 re-enter the instruction.\"}\"#]);\n+        let screen = draw(&state, 40, 14);\n+        assert_shows(&screen, &[\n+            \"protected Git state could not be verified\",\n+            \"No checkpoint was written\",\n+            \"Read-only\",\n+            \"Continue without checkpoint\",\n+            \"Create checkpoint anyway\",\n+            \"Cancel this turn\",\n+            \"Other (re-enter instruction)\",\n+            \"1–5 choose\",\n+        ]);\n+    }\n+\n     #[test]\n     fn a_cramped_approval_keeps_the_action_heading_before_the_review() {\n         let mut state = ready();\n","exit_code":0,"duration":{"secs":0,"nanos":841756794}},"started_at_ms":1792937912522,"completed_at_ms":1792937913364}}
