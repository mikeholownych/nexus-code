{"timestamp":"2026-10-25T11:08:50.939Z","ordinal":337000,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17267-b4a8-7073-9d2a-32da76e0ee35","item":{"type":"CommandExecution","id":"exec-cf1e11ec-250b-4e34-82e3-4ef3f650c631","process_id":"73974","command":["/usr/bin/zsh","-lc","find .git/nexus-claims -mindepth 2 -maxdepth 2 -name owner.json -print | sort | rg -i 'release|version|tag|publish|rc|PLAN-10' || true; git show origin/main:.github/workflows/release.yml | sed -n '1,240p'; git show origin/main:scripts/sync-version.mjs | sed -n '1,180p'; git show origin/main:package.json | rg -n '\"version\"'; git show origin/main:cli/package.json | rg -n '\"version\"'; gh release list --limit 5"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"find .git/nexus-claims -mindepth 2 -maxdepth 2 -name owner.json -print | sort | rg -i 'release|version|tag|publish|rc|PLAN-10' || true; git show origin/main:.github/workflows/release.yml | sed -n '1,240p'; git show origin/main:scripts/sync-version.mjs | sed -n '1,180p'; git show origin/main:package.json | rg -n '\"version\"'; git show origin/main:cli/package.json | rg -n '\"version\"'; gh release list --limit 5"}],"source":"unified_exec_startup","status":"completed","aggregated_output":".git/nexus-claims/FILE_cli_src_agent.ts/owner.json\n.git/nexus-claims/FILE_cli_src_core_app.ts/owner.json\n.git/nexus-claims/FILE_cli_src_core_html_text.ts/owner.json\n.git/nexus-claims/FILE_cli_src_mcp.ts/owner.json\n.git/nexus-claims/FILE_cli_src_safe_fs.ts/owner.json\n.git/nexus-claims/FILE_cli_src_sandbox.ts/owner.json\n.git/nexus-claims/FILE_cli_src_search_web.ts/owner.json\n.git/nexus-claims/FILE_cli_src_types.ts/owner.json\n.git/nexus-claims/FILE_cli_src_worktree.ts/owner.json\n.git/nexus-claims/FILE_cli_test_search_web.test.ts/owner.json\n.git/nexus-claims/FILE_docs_reviews_evidence_v1-qualification_rc.3_terminal_installed-identity-20261024T0133Z/owner.json\n.git/nexus-claims/REDACTED.md/owner.json\n.git/nexus-claims/FILE_docs_reviews_evidence_v1_plan-10-host-preflight-current/owner.json\n.git/nexus-claims/FILE_docs_reviews_evidence_v1_qualification_rc.3_providers_e5-openrouter-live-task-20261023.json/owner.json\n.git/nexus-claims/FILE_docs_reviews_evidence_v1_qualification_rc.3_providers_e5-provider-verification-20261023T1659Z.json/owner.json\n.git/nexus-claims/FILE_docs_reviews_evidence_v1_qualification_rc.3_providers_provider-receipts-20261023T1659Z.jsonl/owner.json\n.git/nexus-claims/FILE_scripts_release-tools_package-lock.json/owner.json\n.git/nexus-claims/FILE_scripts_release-tools_package.json/owner.json\n.git/nexus-claims/PLAN-10_HOST_PREFLIGHT_CURRENT_SOURCE/owner.json\n.git/nexus-claims/RELEASE_PUBLISHER/owner.json\nname: Release\n\non:\n  push:\n    tags: [\"v*.*.*\"]\n\npermissions:\n  contents: write\n  id-token: write\n  attestations: write\n\njobs:\n  package:\n    runs-on: ubuntu-22.04\n    permissions:\n      contents: write\n      id-token: write\n      attestations: write\n    env:\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          fetch-depth: 0\n      - run: sudo apt-get update\n      - run: sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-release\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-release \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable\n      - name: Install cargo tools (audit, deny, about, cyclonedx)\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - name: Require a version-matched tag on main\n        run: |\n          git fetch origin main --no-tags\n          git merge-base --is-ancestor \"$GITHUB_SHA\" origin/main\n          test \"${GITHUB_REF_NAME#v}\" = \"$(node -p 'require(\"./package.json\").version')\"\n          node scripts/sync-version.mjs --check --tag \"$GITHUB_REF_NAME\"\n          test -f \"docs/releases/${GITHUB_REF_NAME}.md\" || { echo \"Missing docs/releases/${GITHUB_REF_NAME}.md\" >&2; exit 1; }\n      - name: Require a stable tag to be a version-only commit on its RC\n        if: ${{ !contains(github.ref_name, '-') }}\n        # The checkout has full history and tags (fetch-depth: 0). The checker runs from the RC's own copy so a stable\n        # commit cannot replace it; branch and tag protection remain the control over the workflow file itself.\n        run: |\n          rc=\"$(git tag --points-at \"$GITHUB_SHA^\" | grep -E \"^${GITHUB_REF_NAME//./\\\\.}-rc\\.[0-9]+$\" | sort -V | tail -n 1 || true)\"\n          test -n \"$rc\" || { echo \"the parent of $GITHUB_REF_NAME is not a ${GITHUB_REF_NAME}-rc.N tag\" >&2; exit 1; }\n          git show \"$rc:scripts/check-version-only-diff.mjs\" > \"$RUNNER_TEMP/check-version-only-diff.mjs\"\n          node \"$RUNNER_TEMP/check-version-only-diff.mjs\" \"$rc\" \"$GITHUB_SHA\"\n      - run: npm ci --prefix cli\n      - run: npm --prefix cli run build\n      - run: cargo test --locked --manifest-path core/Cargo.toml\n      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n      - run: npm --prefix cli test\n      - run: bash scripts/security_gates.sh\n      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/dist\"\n      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/repro-check\"\n      - run: cmp \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\" \"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - run: cmp \"$RUNNER_TEMP/dist/SHA256SUMS\" \"$RUNNER_TEMP/repro-check/SHA256SUMS\"\n      - run: cmp \"$RUNNER_TEMP/dist/THIRD_PARTY_NOTICES.txt\" \"$RUNNER_TEMP/repro-check/THIRD_PARTY_NOTICES.txt\"\n      - run: cyclonedx validate --input-file \"$RUNNER_TEMP/dist/sbom.cdx.json\" --fail-on-errors\n      - run: cmp \"$RUNNER_TEMP/dist/sbom.cdx.json\" \"$RUNNER_TEMP/repro-check/sbom.cdx.json\"\n      - run: cmp \"$RUNNER_TEMP/dist/install.sh\" \"$RUNNER_TEMP/repro-check/install.sh\"\n      - run: bash scripts/smoke-package.sh \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - run: bash scripts/installer-smoke.sh \"$GITHUB_WORKSPACE/install.sh\" \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - name: Attest build provenance\n        uses: actions/attest-build-provenance@92c65d2898f1f53cfdc910b962cecff86e7f8fcc # v1\n        with:\n          subject-path: |\n            ${{ runner.temp }}/dist/nexus-linux-x86_64-${{ github.ref_name }}.tar.gz\n            ${{ runner.temp }}/dist/SHA256SUMS\n      # RC tags (vX.Y.Z-rc.N) publish a prerelease: the workflow-produced RC is the qualification candidate\n      # (ACCEPTANCE §1.1 stage 2). Stable tags only build an unpublished draft (stage 5); it is published by hand with\n      # `gh release edit <tag> --draft=false` after the stable artifact checks and the signed acceptance disposition.\n      - uses: softprops/action-gh-release@3bb12739c298aeb8a4eeaf626c5b8d85266b0e65 # v2\n        with:\n          files: ${{ runner.temp }}/dist/*\n          body_path: docs/releases/${{ github.ref_name }}.md\n          prerelease: ${{ contains(github.ref_name, '-') }}\n          draft: ${{ !contains(github.ref_name, '-') }}\n// The root package.json version is the single source of truth (REQ-REL-103). This writes it into cli/package.json,\n// cli/package-lock.json, core/Cargo.toml and core/Cargo.lock; `--check` only reports drift and exits 1 when any file\n// disagrees (run in CI and the release workflow). `--tag vX.Y.Z` additionally requires the tag to match.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst args = process.argv.slice(2);\nconst check = args.includes(\"--check\");\nconst tagIndex = args.indexOf(\"--tag\");\nconst tag = tagIndex >= 0 ? args[tagIndex + 1] : undefined;\n\nconst version = JSON.parse(fs.readFileSync(path.join(root, \"package.json\"), \"utf8\")).version;\nif (!/^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$/.test(version)) throw new Error(`package.json version '${version}' is not SemVer`);\n\nconst drift = [];\nconst update = (rel, transform) => {\n  const file = path.join(root, rel);\n  const before = fs.readFileSync(file, \"utf8\");\n  const after = transform(before);\n  if (after === before) return;\n  drift.push(rel);\n  if (!check) fs.writeFileSync(file, after);\n};\n\nconst jsonVersion = (text, paths) => {\n  const data = JSON.parse(text);\n  for (const p of paths) {\n    let node = data;\n    for (const key of p.slice(0, -1)) node = node?.[key];\n    if (node && typeof node === \"object\" && p[p.length - 1] in node) node[p[p.length - 1]] = version;\n  }\n  return JSON.stringify(data, null, 2) + \"\\n\";\n};\n\nupdate(\"cli/package.json\", (t) => jsonVersion(t, [[\"version\"]]));\nupdate(\"cli/package-lock.json\", (t) => jsonVersion(t, [[\"version\"], [\"packages\", \"\", \"version\"]]));\nupdate(\"core/Cargo.toml\", (t) => t.replace(/^(\\[package\\][^[]*?\\nversion = )\"[^\"]*\"/s, `$1\"${version}\"`));\nupdate(\"core/Cargo.lock\", (t) => t.replace(/(\\[\\[package\\]\\]\\nname = \"harness-core\"\\nversion = )\"[^\"]*\"/, `$1\"${version}\"`));\n\nif (tag !== undefined && tag !== `v${version}`) {\n  console.error(`tag ${tag} does not match package.json version ${version}`);\n  process.exit(1);\n}\nif (drift.length) {\n  console.error(`${check ? \"version drift\" : \"updated to \" + version}: ${drift.join(\", \")}`);\n  if (check) process.exit(1);\n} else {\n  console.log(`all components at ${version}`);\n}\n3:  \"version\": \"1.0.0-rc.4\",\n3:  \"version\": \"1.0.0-rc.4\",\nv1.0.0-rc.4\tPre-release\tv1.0.0-rc.4\t2026-10-24T11:54:37Z\nv1.0.0-rc.3\tPre-release\tv1.0.0-rc.3\t2026-10-23T09:06:11Z\nv1.0.0-rc.1\tPre-release\tv1.0.0-rc.1\t2026-10-21T18:54:41Z\nv0.1.0-alpha.2\tPre-release\tv0.1.0-alpha.2\t2026-10-14T09:10:47Z\nv0.1.0-alpha.1\tPre-release\tv0.1.0-alpha.1\t2026-10-13T20:11:01Z\n","exit_code":0,"duration":{"secs":0,"nanos":466546632}},"started_at_ms":1792926530472,"completed_at_ms":1792926530939}}
{"timestamp":"2026-10-25T11:08:51.915Z","ordinal":337001,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a172bf-c14b-7db1-8d66-032f6780fe27","call_id":"call_215a9727844348b9872bb68fa3ca3b4f","output":[{"type":"input_text","text":"Script completed\nWall time 2.6 seconds\nOutput:\n"},{"type":"input_text","text":".git/nexus-claims/FILE_cli_src_agent.ts/owner.json\n.git/nexus-claims/FILE_cli_src_core_app.ts/owner.json\n.git/nexus-claims/FILE_cli_src_core_html_text.ts/owner.json\n.git/nexus-claims/FILE_cli_src_mcp.ts/owner.json\n.git/nexus-claims/FILE_cli_src_safe_fs.ts/owner.json\n.git/nexus-claims/FILE_cli_src_sandbox.ts/owner.json\n.git/nexus-claims/FILE_cli_src_search_web.ts/owner.json\n.git/nexus-claims/FILE_cli_src_types.ts/owner.json\n.git/nexus-claims/FILE_cli_src_worktree.ts/owner.json\n.git/nexus-claims/FILE_cli_test_search_web.test.ts/owner.json\n.git/nexus-claims/FILE_docs_reviews_evidence_v1-qualification_rc.3_terminal_installed-identity-20261024T0133Z/owner.json\n.git/nexus-claims/REDACTED.md/owner.json\n.git/nexus-claims/FILE_docs_reviews_evidence_v1_plan-10-host-preflight-current/owner.json\n.git/nexus-claims/FILE_docs_reviews_evidence_v1_qualification_rc.3_providers_e5-openrouter-live-task-20261023.json/owner.json\n.git/nexus-claims/FILE_docs_reviews_evidence_v1_qualification_rc.3_providers_e5-provider-verification-20261023T1659Z.json/owner.json\n.git/nexus-claims/FILE_docs_reviews_evidence_v1_qualification_rc.3_providers_provider-receipts-20261023T1659Z.jsonl/owner.json\n.git/nexus-claims/FILE_scripts_release-tools_package-lock.json/owner.json\n.git/nexus-claims/FILE_scripts_release-tools_package.json/owner.json\n.git/nexus-claims/PLAN-10_HOST_PREFLIGHT_CURRENT_SOURCE/owner.json\n.git/nexus-claims/RELEASE_PUBLISHER/owner.json\nname: Release\n\non:\n  push:\n    tags: [\"v*.*.*\"]\n\npermissions:\n  contents: write\n  id-token: write\n  attestations: write\n\njobs:\n  package:\n    runs-on: ubuntu-22.04\n    permissions:\n      contents: write\n      id-token: write\n      attestations: write\n    env:\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          fetch-depth: 0\n      - run: sudo apt-get update\n      - run: sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - run: bash scripts/ensure-ci-bubblewrap.sh\n      - run: bash scripts/ensure-ci-user-cgroups.sh\n      - name: Mount a dedicated capped tmpfs for evaluator resource fixtures\n        run: |\n          root=/mnt/nexus-eval-release\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$root\"\n          sudo mount -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-release \"$root\"\n          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n          runtime_root=/opt/nexus-eval-ci-runtime\n          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable\n      - name: Install cargo tools (audit, deny, about, cyclonedx)\n        run: |\n          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          cargo install cargo-audit --locked --version 0.22.2\n          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Install selected Node runtime for isolated evaluation commands\n        run: |\n          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n          test -f \"$npm_root/package.json\"\n          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n      - name: Require a version-matched tag on main\n        run: |\n          git fetch origin main --no-tags\n          git merge-base --is-ancestor \"$GITHUB_SHA\" origin/main\n          test \"${GITHUB_REF_NAME#v}\" = \"$(node -p 'require(\"./package.json\").version')\"\n          node scripts/sync-version.mjs --check --tag \"$GITHUB_REF_NAME\"\n          test -f \"docs/releases/${GITHUB_REF_NAME}.md\" || { echo \"Missing docs/releases/${GITHUB_REF_NAME}.md\" >&2; exit 1; }\n      - name: Require a stable tag to be a version-only commit on its RC\n        if: ${{ !contains(github.ref_name, '-') }}\n        # The checkout has full history and tags (fetch-depth: 0). The checker runs from the RC's own copy so a stable\n        # commit cannot replace it; branch and tag protection remain the control over the workflow file itself.\n        run: |\n          rc=\"$(git tag --points-at \"$GITHUB_SHA^\" | grep -E \"^${GITHUB_REF_NAME//./\\\\.}-rc\\.[0-9]+$\" | sort -V | tail -n 1 || true)\"\n          test -n \"$rc\" || { echo \"the parent of $GITHUB_REF_NAME is not a ${GITHUB_REF_NAME}-rc.N tag\" >&2; exit 1; }\n          git show \"$rc:scripts/check-version-only-diff.mjs\" > \"$RUNNER_TEMP/check-version-only-diff.mjs\"\n          node \"$RUNNER_TEMP/check-version-only-diff.mjs\" \"$rc\" \"$GITHUB_SHA\"\n      - run: npm ci --prefix cli\n      - run: npm --prefix cli run build\n      - run: cargo test --locked --manifest-path core/Cargo.toml\n      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n      - run: npm --prefix cli test\n      - run: bash scripts/security_gates.sh\n      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/dist\"\n      - run: bash scripts/package-linux.sh \"$GITHUB_REF_NAME\" \"$RUNNER_TEMP/repro-check\"\n      - run: cmp \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\" \"$RUNNER_TEMP/repro-check/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - run: cmp \"$RUNNER_TEMP/dist/SHA256SUMS\" \"$RUNNER_TEMP/repro-check/SHA256SUMS\"\n      - run: cmp \"$RUNNER_TEMP/dist/THIRD_PARTY_NOTICES.txt\" \"$RUNNER_TEMP/repro-check/THIRD_PARTY_NOTICES.txt\"\n      - run: cyclonedx validate --input-file \"$RUNNER_TEMP/dist/sbom.cdx.json\" --fail-on-errors\n      - run: cmp \"$RUNNER_TEMP/dist/sbom.cdx.json\" \"$RUNNER_TEMP/repro-check/sbom.cdx.json\"\n      - run: cmp \"$RUNNER_TEMP/dist/install.sh\" \"$RUNNER_TEMP/repro-check/install.sh\"\n      - run: bash scripts/smoke-package.sh \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - run: bash scripts/installer-smoke.sh \"$GITHUB_WORKSPACE/install.sh\" \"$RUNNER_TEMP/dist/nexus-linux-x86_64-$GITHUB_REF_NAME.tar.gz\"\n      - name: Attest build provenance\n        uses: actions/attest-build-provenance@92c65d2898f1f53cfdc910b962cecff86e7f8fcc # v1\n        with:\n          subject-path: |\n            ${{ runner.temp }}/dist/nexus-linux-x86_64-${{ github.ref_name }}.tar.gz\n            ${{ runner.temp }}/dist/SHA256SUMS\n      # RC tags (vX.Y.Z-rc.N) publish a prerelease: the workflow-produced RC is the qualification candidate\n      # (ACCEPTANCE §1.1 stage 2). Stable tags only build an unpublished draft (stage 5); it is published by hand with\n      # `gh release edit <tag> --draft=false` after the stable artifact checks and the signed acceptance disposition.\n      - uses: softprops/action-gh-release@3bb12739c298aeb8a4eeaf626c5b8d85266b0e65 # v2\n        with:\n          files: ${{ runner.temp }}/dist/*\n          body_path: docs/releases/${{ github.ref_name }}.md\n          prerelease: ${{ contains(github.ref_name, '-') }}\n          draft: ${{ !contains(github.ref_name, '-') }}\n// The root package.json version is the single source of truth (REQ-REL-103). This writes it into cli/package.json,\n// cli/package-lock.json, core/Cargo.toml and core/Cargo.lock; `--check` only reports drift and exits 1 when any file\n// disagrees (run in CI and the release workflow). `--tag vX.Y.Z` additionally requires the tag to match.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst args = process.argv.slice(2);\nconst check = args.includes(\"--check\");\nconst tagIndex = args.indexOf(\"--tag\");\nconst tag = tagIndex >= 0 ? args[tagIndex + 1] : undefined;\n\nconst version = JSON.parse(fs.readFileSync(path.join(root, \"package.json\"), \"utf8\")).version;\nif (!/^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$/.test(version)) throw new Error(`package.json version '${version}' is not SemVer`);\n\nconst drift = [];\nconst update = (rel, transform) => {\n  const file = path.join(root, rel);\n  const before = fs.readFileSync(file, \"utf8\");\n  const after = transform(before);\n  if (after === before) return;\n  drift.push(rel);\n  if (!check) fs.writeFileSync(file, after);\n};\n\nconst jsonVersion = (text, paths) => {\n  const data = JSON.parse(text);\n  for (const p of paths) {\n    let node = data;\n    for (const key of p.slice(0, -1)) node = node?.[key];\n    if (node && typeof node === \"object\" && p[p.length - 1] in node) node[p[p.length - 1]] = version;\n  }\n  return JSON.stringify(data, null, 2) + \"\\n\";\n};\n\nupdate(\"cli/package.json\", (t) => jsonVersion(t, [[\"version\"]]));\nupdate(\"cli/package-lock.json\", (t) => jsonVersion(t, [[\"version\"], [\"packages\", \"\", \"version\"]]));\nupdate(\"core/Cargo.toml\", (t) => t.replace(/^(\\[package\\][^[]*?\\nversion = )\"[^\"]*\"/s, `$1\"${version}\"`));\nupdate(\"core/Cargo.lock\", (t) => t.replace(/(\\[\\[package\\]\\]\\nname = \"harness-core\"\\nversion = )\"[^\"]*\"/, `$1\"${version}\"`));\n\nif (tag !== undefined && tag !== `v${version}`) {\n  console.error(`tag ${tag} does not match package.json version ${version}`);\n  process.exit(1);\n}\nif (drift.length) {\n  console.error(`${check ? \"version drift\" : \"updated to \" + version}: ${drift.join(\", \")}`);\n  if (check) process.exit(1);\n} else {\n  console.log(`all components at ${version}`);\n}\n3:  \"version\": \"1.0.0-rc.4\",\n3:  \"version\": \"1.0.0-rc.4\",\nv1.0.0-rc.4\tPre-release\tv1.0.0-rc.4\t2026-10-24T11:54:37Z\nv1.0.0-rc.3\tPre-release\tv1.0.0-rc.3\t2026-10-23T09:06:11Z\nv1.0.0-rc.1\tPre-release\tv1.0.0-rc.1\t2026-10-21T18:54:41Z\nv0.1.0-alpha.2\tPre-release\tv0.1.0-alpha.2\t2026-10-14T09:10:47Z\nv0.1.0-alpha.1\tPre-release\tv0.1.0-alpha.1\t2026-10-13T20:11:01Z\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17267-b4a8-7073-9d2a-32da76e0ee35","create_time":1792926531.9157221}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
