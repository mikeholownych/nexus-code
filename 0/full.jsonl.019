"requires\": true,\n   \"packages\": {\n     \"\": {\n       \"name\": \"local-code-harness\",\n-      \"version\": \"1.0.0-rc.4\",\n+      \"version\": \"1.0.0-rc.5\",\n       \"license\": \"MIT\",\n       \"dependencies\": {\n         \"commander\": \"^12.1.0\",\ndiff --git a/cli/package.json b/cli/package.json\nindex f48f059..19ed67f 100644\n--- a/cli/package.json\n+++ b/cli/package.json\n@@ -1,6 +1,6 @@\n {\n   \"name\": \"local-code-harness\",\n-  \"version\": \"1.0.0-rc.4\",\n+  \"version\": \"1.0.0-rc.5\",\n   \"type\": \"module\",\n   \"description\": \"Autonomous local AI coding harness (Codex / Claude-Code style) for LM Studio and vLLM\",\n   \"main\": \"dist/index.js\",\ndiff --git a/core/Cargo.lock b/core/Cargo.lock\nindex 906d515..4cf09ae 100644\n--- a/core/Cargo.lock\n+++ b/core/Cargo.lock\n@@ -436,7 +436,7 @@ dependencies = [\n \n [[package]]\n name = \"harness-core\"\n-version = \"1.0.0-rc.4\"\n+version = \"1.0.0-rc.5\"\n dependencies = [\n  \"clap\",\n  \"crossterm\",\ndiff --git a/core/Cargo.toml b/core/Cargo.toml\nindex 8f742d3..a5d4a0c 100644\n--- a/core/Cargo.toml\n+++ b/core/Cargo.toml\n@@ -1,6 +1,6 @@\n [package]\n name = \"harness-core\"\n-version = \"1.0.0-rc.4\"\n+version = \"1.0.0-rc.5\"\n edition = \"2024\"\n rust-version = \"1.85.0\"\n license = \"Apache-2.0\"\ndiff --git a/docs/releases/v1.0.0-rc.5.md b/docs/releases/v1.0.0-rc.5.md\nindex 4f59a6e..62c5855 100644\n--- a/docs/releases/v1.0.0-rc.5.md\n+++ b/docs/releases/v1.0.0-rc.5.md\n@@ -23,7 +23,7 @@ This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and\n - Makes Linux package archives reproducible across supported build runners by creating them with the pinned release builder, removing host-specific archive metadata differences.\n - Corrects the cross-runner workflow's pinned artifact-download action so the exact published-candidate comparison can execute.\n \n-The REPL PTY cleanup change is test-harness reliability work and does not change product behavior. These source changes and their CI results do not replace RC5 artifact checks, cross-runner qualification, or installed-package qualification.\n+The REPL PTY cleanup and T4 evaluator supervisor changes improve qualification-harness reliability and do not change product behavior. In particular, containment cleanup after a task process exits no longer leaves a repeating timer behind. These source changes and their CI results do not replace RC5 artifact checks, cross-runner qualification, or installed-package qualification.\n \n ## Runtime requirements\n \ndiff --git a/package.json b/package.json\nindex 1510249..640c139 100644\n--- a/package.json\n+++ b/package.json\n@@ -1,6 +1,6 @@\n {\n   \"name\": \"nexus-code-harness\",\n-  \"version\": \"1.0.0-rc.4\",\n+  \"version\": \"1.0.0-rc.5\",\n   \"description\": \"High-Performance Autonomous Local AI Coding Harness (Codex / Claude-Code style) powered by Rust + TypeScript\",\n   \"scripts\": {\n     \"build:core\": \"cargo build --release --manifest-path core/Cargo.toml\",\nae69fe03b935006ccda12b7a28f49f610d064617\n","exit_code":0,"duration":{"secs":0,"nanos":27721}},"started_at_ms":1792926656683,"completed_at_ms":1792926656683}}
