:\"completed\"},{\"completedAt\":\"2026-10-25T09:14:33Z\",\"conclusion\":\"success\",\"name\":\"Run cargo test --locked --manifest-path core/Cargo.toml\",\"number\":15,\"startedAt\":\"2026-10-25T09:13:47Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:15:25Z\",\"conclusion\":\"success\",\"name\":\"Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\",\"number\":16,\"startedAt\":\"2026-10-25T09:14:33Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:15:27Z\",\"conclusion\":\"success\",\"name\":\"Install pinned security and SBOM test tools\",\"number\":17,\"startedAt\":\"2026-10-25T09:15:25Z\",\"status\":\"completed\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run npm --prefix cli test\",\"number\":18,\"startedAt\":\"2026-10-25T09:15:27Z\",\"status\":\"in_progress\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":34,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":35,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":36,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40179733923/job/121128017169\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"databaseId\":121128017317,\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-25T09:13:13Z\",\"status\":\"in_progress\",\"steps\":[{\"completedAt\":\"2026-10-25T09:13:16Z\",\"conclusion\":\"success\",\"name\":\"Set up job\",\"number\":1,\"startedAt\":\"2026-10-25T09:13:14Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:18Z\",\"conclusion\":\"success\",\"name\":\"Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":2,\"startedAt\":\"2026-10-25T09:13:16Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:35Z\",\"conclusion\":\"success\",\"name\":\"Run sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\",\"number\":3,\"startedAt\":\"2026-10-25T09:13:18Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:41Z\",\"conclusion\":\"success\",\"name\":\"Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":4,\"startedAt\":\"2026-10-25T09:13:35Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:42Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-bubblewrap.sh\",\"number\":5,\"startedAt\":\"2026-10-25T09:13:41Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:43Z\",\"conclusion\":\"success\",\"name\":\"Run bash scripts/ensure-ci-user-cgroups.sh\",\"number\":6,\"startedAt\":\"2026-10-25T09:13:42Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:43Z\",\"conclusion\":\"success\",\"name\":\"Mount a dedicated capped tmpfs for evaluator resource fixtures\",\"number\":7,\"startedAt\":\"2026-10-25T09:13:43Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:46Z\",\"conclusion\":\"success\",\"name\":\"Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":8,\"startedAt\":\"2026-10-25T09:13:43Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:49Z\",\"conclusion\":\"success\",\"name\":\"Install selected Node runtime for isolated evaluation commands\",\"number\":9,\"startedAt\":\"2026-10-25T09:13:46Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:49Z\",\"conclusion\":\"success\",\"name\":\"Run node scripts/sync-version.mjs --check\",\"number\":10,\"startedAt\":\"2026-10-25T09:13:49Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:49Z\",\"conclusion\":\"success\",\"name\":\"Run node scripts/check_requirements.mjs\",\"number\":11,\"startedAt\":\"2026-10-25T09:13:49Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:49Z\",\"conclusion\":\"success\",\"name\":\"Run npm ci --prefix cli\",\"number\":12,\"startedAt\":\"2026-10-25T09:13:49Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:52Z\",\"conclusion\":\"success\",\"name\":\"Run npm --prefix cli run build\",\"number\":13,\"startedAt\":\"2026-10-25T09:13:49Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:52Z\",\"conclusion\":\"success\",\"name\":\"Run git diff --exit-code -- cli/dist\",\"number\":14,\"startedAt\":\"2026-10-25T09:13:52Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:14:39Z\",\"conclusion\":\"success\",\"name\":\"Run cargo test --locked --manifest-path core/Cargo.toml\",\"number\":15,\"startedAt\":\"2026-10-25T09:13:52Z\",\"status\":\"completed\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\",\"number\":16,\"startedAt\":\"2026-10-25T09:14:39Z\",\"status\":\"in_progress\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Install pinned security and SBOM test tools\",\"number\":17,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Run npm --prefix cli test\",\"number\":18,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020\",\"number\":34,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff\",\"number\":35,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"},{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"name\":\"Post Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":36,\"startedAt\":\"0001-01-01T00:00:00Z\",\"status\":\"pending\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40179733923/job/121128017317\"}],\"status\":\"in_progress\",\"url\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40179733923\"}\n{\"conclusion\":\"\",\"headSha\":\"596879597d677a3fc634958cd08741cf4c93f4af\",\"jobs\":[{\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"databaseId\":121128016836,\"name\":\"javascript-typescript\",\"startedAt\":\"2026-10-25T09:13:13Z\",\"status\":\"in_progress\",\"steps\":[{\"completedAt\":\"2026-10-25T09:13:15Z\",\"conclusion\":\"success\",\"name\":\"Set up job\",\"number\":1,\"startedAt\":\"2026-10-25T09:13:14Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:18Z\",\"conclusion\":\"success\",\"name\":\"Run actions/checkout@11d5960a326750d5838078e36cf38b85af677262\",\"number\":2,\"startedAt\":\"2026-10-25T09:13:15Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:13:30Z\",\"conclusion\":\"success\",\"name\":\"Run github/codeql-action/init@d0bae162f31f17dd92c46ccdc4dfee5710f8dc67\",\"number\":3,\"startedAt\":\"2026-10-25T09:13:18Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:15:28Z\",\"conclusion\":\"success\",\"name\":\"Run github/codeql-action/analyze@d0bae162f31f17dd92c46ccdc4dfee5710f8dc67\",\"number\":4,\"startedAt\":\"2026-10-25T09:13:30Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:15:28Z\",\"conclusion\":\"success\",\"name\":\"Post Run github/codeql-action/analyze@d0bae162f31f17dd92c46ccdc4dfee5710f8dc67\",\"number\":6,\"startedAt\":\"2026-10-25T09:15:28Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-10-25T09:15:29Z\",\"conclusion\":\"success\",\"name\":\"Post Run github/c