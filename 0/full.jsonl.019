;\n+  }\n   return path.join(os.homedir(), \".nexus\", \"tasks\");\n }\n \n@@ -289,6 +292,10 @@ export class DurableStateManager {\n     if (!fs.existsSync(this.baseDir)) {\n       fs.mkdirSync(this.baseDir, { recursive: true });\n     }\n+    // If NEXUS_STATE_DIR is set and no explicit baseDir was given, ensure the env dir exists too.\n+    if (!options.baseDir && process.env.NEXUS_STATE_DIR) {\n+      fs.mkdirSync(process.env.NEXUS_STATE_DIR, { recursive: true });\n+    }\n   }\n \n   public getBaseDir(): string {\ndiff --git a/cli/test/compaction_continuity.test.ts b/cli/test/compaction_continuity.test.ts\nindex 504ef5a..25b37c2 100644\n--- a/cli/test/compaction_continuity.test.ts\n+++ b/cli/test/compaction_continuity.test.ts\n@@ -79,14 +79,14 @@ describe(\"A. progressing work has no step ceiling\", () => {\n     // A 30k window so the run crosses compaction boundaries on the way.\n     const agent = quiet(new AutonomousAgent(cfg(gw.url, repo, { contextLimit: 30_000 })));\n     try {\n-      const turn = await agent.runTurn(\"Write files d/f1.txt through d/f310.txt, one per step.\");\n+      const turn = await agent.runTurn(`Write files d/f1.txt through d/f${STEPS}.txt, one per step.`);\n       assert.equal(turn.execution, \"COMPLETED\", JSON.stringify({ reason: turn.reason, detail: turn.detail }));\n       assert.equal(turn.steps.used, STEPS + 1);\n       assert.equal(turn.steps.limitReached, false);\n       assert.ok(fs.existsSync(path.join(repo, \"d\", `f${STEPS}.txt`)));\n       for (const body of (gw.requests as any[]).filter((b) => b.tools)) {\n         const t = allText(body);\n-        assert.doesNotMatch(t, /steps? remains?|Finish now|step \\d+ of \\d+|step limit/i, \"no step-exhaustion prompt\");\n+        assert.doesNotMatch(t, /steps? remains?|Finish now|step \\d+ of \\d+|Work left unfinished at the step limit/i, \"no step-exhaustion prompt\");\n       }\n       const tracking = agent.getObjective()!.execution!;\n       assert.equal(tracking.cumulativeSteps, STEPS + 1);\n","exit_code":0,"duration":{"secs":0,"nanos":41758}},"started_at_ms":1792918824684,"completed_at_ms":1792918824684}}
