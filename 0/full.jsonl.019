 `Warning: Build provenance was not verified: ${trustedGh} could not verify the attestation (it may need 'gh auth login'). The SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.`;\n         }\n       } else if (verifyAttestation === \"1\") {\n         throw new Error(\n           \"Provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\",\n         );\n+      } else {\n+        provenanceWarning = \"Warning: Build provenance was not verified: no trusted GitHub CLI at /usr/bin/gh or /usr/local/bin/gh. The SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\";\n       }\n+      if (provenanceWarning) options?.onProgress?.(\"attestation_skipped\", provenanceWarning);\n     }\n \n     // 5. Staging phase: Safe tar header validation and extraction\n@@ -1264,7 +1275,7 @@ export async function performUpgrade(\n       installedPath: versionDir,\n       binPath: linkPath,\n       restartRequired: true,\n-      restartNotice: `Nexus has been upgraded to ${targetVersion} in ${versionDir}. The current session continues running on ${installed.version}. Restart Nexus to activate the new version.${pathWarning ? `\\n\\n${pathWarning}` : \"\"}`,\n+      restartNotice: `Nexus has been upgraded to ${targetVersion} in ${versionDir}. The current session continues running on ${installed.version}. Restart Nexus to activate the new version.${provenanceWarning ? `\\n\\n${provenanceWarning}` : \"\"}${pathWarning ? `\\n\\n${pathWarning}` : \"\"}`,\n       attestationVerified,\n     };\n   } catch (error: any) {\ndiff --git a/cli/test/upgrade_acceptance.test.ts b/cli/test/upgrade_acceptance.test.ts\nindex b1c554b..60d53a8 100644\n--- a/cli/test/upgrade_acceptance.test.ts\n+++ b/cli/test/upgrade_acceptance.test.ts\n@@ -387,6 +387,99 @@ describe(\"Public Release Upgrade Acceptance (REQ-REL-116, ACC-UPG-07..14)\", () =\n     }\n   });\n \n+  it(\"auto attestation upgrades without a trusted gh and reports that provenance was not verified\", async () => {\n+    const oldVersion = \"v0.1.0-alpha.2\";\n+    const vOldDir = setupInstalledVersion(tmpPrefix, oldVersion);\n+    fs.mkdirSync(path.join(tmpPrefix, \"bin\"), { recursive: true });\n+    fs.symlinkSync(path.join(vOldDir, \"bin\", \"nexus\"), path.join(tmpPrefix, \"bin\", \"nexus\"));\n+\n+    const installed = detectInstallation({ nexusHome: vOldDir, envPrefix: tmpPrefix });\n+    const target = await resolveTargetRelease(undefined, { timeoutMs: 5000 });\n+    const comparison = compareInstallationWithRelease(installed, target);\n+\n+    const savedPath = process.env.PATH;\n+    const savedAttestation = process.env.NEXUS_VERIFY_ATTESTATION;\n+    const shim = path.join(tmpPrefix, \"gh-shim\");\n+    fs.mkdirSync(shim);\n+    const marker = path.join(tmpPrefix, \"gh-shim-executed\");\n+    fs.writeFileSync(path.join(shim, \"gh\"), `#!/bin/sh\\n: > '${marker}'\\nexit 0\\n`, { mode: 0o755 });\n+    fs.chmodSync(path.join(shim, \"gh\"), 0o755);\n+    process.env.PATH = `${shim}:${savedPath ?? \"\"}`;\n+    delete process.env.NEXUS_VERIFY_ATTESTATION;\n+    const stages: string[] = [];\n+    try {\n+      const result = await performUpgrade(comparison, {\n+        prefix: tmpPrefix,\n+        timeoutMs: 5000,\n+        trustedGhPaths: [],\n+        onProgress: (stage) => stages.push(stage),\n+      });\n+      assert.equal(result.success, true, \"the default auto mode must not require gh\");\n+      assert.equal(result.attestationVerified, undefined);\n+      assert.match(result.restartNotice, /Build provenance was not verified: no trusted GitHub CLI/);\n+      assert.ok(stages.includes(\"attestation_skipped\"), \"the skipped verification must be reported as progress\");\n+      assert.equal(fs.existsSync(marker), false, \"the PATH gh shim was executed\");\n+    } finally {\n+      if (savedPath === undefined) delete process.env.PATH;\n+      else process.env.PATH = savedPath;\n+      if (savedAttestation === undefined) delete process.env.NEXUS_VERIFY_ATTESTATION;\n+      else process.env.NEXUS_VERIFY_ATTESTATION = savedAttestation;\n+    }\n+  });\n+\n+  it(\"auto attestation reports, rather than hides, a trusted gh that cannot verify\", async () => {\n+    const oldVersion = \"v0.1.0-alpha.2\";\n+    const vOldDir = setupInstalledVersion(tmpPrefix, oldVersion);\n+    fs.mkdirSync(path.join(tmpPrefix, \"bin\"), { recursive: true });\n+    fs.symlinkSync(path.join(vOldDir, \"bin\", \"nexus\"), path.join(tmpPrefix, \"bin\", \"nexus\"));\n+\n+    const installed = detectInstallation({ nexusHome: vOldDir, envPrefix: tmpPrefix });\n+    const target = await resolveTargetRelease(undefined, { timeoutMs: 5000 });\n+    const comparison = compareInstallationWithRelease(installed, target);\n+\n+    const failingGh = path.join(tmpPrefix, \"trusted-gh\");\n+    fs.writeFileSync(failingGh, \"#!/bin/sh\\nexit 1\\n\", { mode: 0o755 });\n+    fs.chmodSync(failingGh, 0o755);\n+    const savedAttestation = process.env.NEXUS_VERIFY_ATTESTATION;\n+    process.env.NEXUS_VERIFY_ATTESTATION = \"auto\";\n+    try {\n+      const result = await performUpgrade(comparison, { prefix: tmpPrefix, timeoutMs: 5000, trustedGhPaths: [failingGh] });\n+      assert.equal(result.success, true);\n+      assert.equal(result.attestationVerified, undefined);\n+      assert.match(result.restartNotice, /could not verify the attestation/);\n+    } finally {\n+      if (savedAttestation === undefined) delete process.env.NEXUS_VERIFY_ATTESTATION;\n+      else process.env.NEXUS_VERIFY_ATTESTATION = savedAttestation;\n+    }\n+  });\n+\n+  it(\"rejects an unsupported attestation setting before starting the upgrade\", async () => {\n+    const oldVersion = \"v0.1.0-alpha.2\";\n+    const vOldDir = setupInstalledVersion(tmpPrefix, oldVersion);\n+    fs.mkdirSync(path.join(tmpPrefix, \"bin\"), { recursive: true });\n+    fs.symlinkSync(path.join(vOldDir, \"bin\", \"nexus\"), path.join(tmpPrefix, \"bin\", \"nexus\"));\n+\n+    const installed = detectInstallation({ nexusHome: vOldDir, envPrefix: tmpPrefix });\n+    const target = await resolveTargetRelease(undefined, { timeoutMs: 5000 });\n+    const comparison = compareInstallationWithRelease(installed, target);\n+\n+    const savedAttestation = process.env.NEXUS_VERIFY_ATTESTATION;\n+    try {\n+      for (const value of [\"yes\", \"\"]) {\n+        process.env.NEXUS_VERIFY_ATTESTATION = value;\n+        await assert.rejects(\n+          performUpgrade(comparison, { prefix: tmpPrefix, timeoutMs: 5000, trustedGhPaths: [] }),\n+          /NEXUS_VERIFY_ATTESTATION must be auto/,\n+          `an attestation setting of ${JSON.stringify(value)} must be rejected`,\n+        );\n+        assert.equal(readJournal(tmpPrefix), null, \"an invalid setting must fail before starting the journal\");\n+      }\n+    } finally {\n+      if (savedAttestation === undefined) delete process.env.NEXUS_VERIFY_ATTESTATION;\n+      else process.env.NEXUS_VERIFY_ATTESTATION = savedAttestation;\n+    }\n+  });\n+\n   it(\"refuses downgrade when target release has incompatible state schema version\", async () => {\n     // Current installation at v1.0.0\n     const v1Dir = setupInstalledVersion(tmpPrefix, \"v1.0.0\");\ndiff --git a/docs/releases/v1.0.0-rc.6.md b/docs/releases/v1.0.0-rc.6.md\nindex aa9c03b..87420b1 100644\n--- a/docs/releases/v1.0.0-rc.6.md\n+++ b/docs/releases/v1.0.0-rc.6.md\n@@ -9,6 +9,7 @@ This release packages the Nexus Code Linux x86-64 client: the TypeScript CLI and\n ## Changes since RC5\n \n - Pins the release package builder and cross-runner rebuilds to Node.js 22.22.1 and npm 10.9.4. This keeps generated SBOM tool metadata identical across both reproducibility runners and the published candidate.\n+- The installer verifies build provenance when possible again. `NEXUS_VERIFY_ATTESTATION` defaults to `auto`: with a GitHub CLI at `/usr/bin/gh` or `/usr/local/bin/gh` it verifies the archive and `SHA256SUMS` attestations, and otherwise it installs after the SHA-256 check with a notice that provenance was not verified. This reverses RC5, whose installer refused to run without a trusted, signed-in GitHub CLI. Set `NEXUS_VERIFY_ATTESTATION=1` to require provenance, or `0` to skip it; any other value, including an empty one, is rejected. `nexus upgrade` follows the same setting and now states in its completion notice when provenance was not verified.\n \n ## Runtime requirements\n \ndiff --git a/install.sh b/install.sh\nindex cd7db1b..5a74e4a 100644\n--- a/install.sh\n+++ b/install.sh\n@@ -18,10 +18,10 @@ command -v curl >/dev/null 2>&1 || fail \"curl is required.\"\n command -v tar >/dev/null 2>&1 || fail \"tar is required.\"\n command -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n \n-VERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION:-1}\n+VERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION-auto}\n case \"$VERIFY_ATTESTATION\" in\n-  0|1) ;;\n-  *) fail \"NEXUS_VERIFY_ATTESTATION must be 1 (verify provenance) or 0 (explicitly skip verification).\" ;;\n+  auto|0|1) ;;\n+  *) fail \"NEXUS_VERIFY_ATTESTATION must be auto (verify when a trusted GitHub CLI is present), 1 (require verification) or 0 (skip verification).\" ;;\n esac\n TRUSTED_GH=\n if [ -x /usr/bin/gh ]; then\n@@ -92,7 +92,11 @@ if [ \"$VERIFY_ATTESTATION\" != \"0\" ] && [ -n \"$TRUSTED_GH\" ]; then\n     printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n   elif [ \"$VERIFY_ATTESTATION\" = \"1\" ]; then\n     fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n+  else\n+    printf 'nexus installer: build provenance was not verified: %s could not verify the attestation (it may need gh auth login); the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' \"$TRUSTED_GH\" >&2\n   fi\n+elif [ \"$VERIFY_ATTESTATION\" = \"auto\" ]; then\n+  printf 'nexus installer: build provenance was not verified: no trusted GitHub CLI at /usr/bin/gh or /usr/local/bin/gh; the SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\\n' >&2\n fi\n \n VERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\ndiff --git a/scripts/installer-smoke.sh b/scripts/installer-smoke.sh\nindex b0a3b47..b0e851a 100644\n--- a/scripts/installer-smoke.sh\n+++ b/scripts/installer-smoke.sh\n@@ -30,9 +30,10 @@ run_installer() {\n run_installer\n \"$TMP/prefix/bin/nexus\" --version | grep -F \"${VERSION#v}\" >/dev/null\n \n-# Attestation is required by default and must never trust a PATH shim.\n+# Attestation defaults to auto: verify with a trusted gh when one exists, otherwise install with a\n+# visible notice. NEXUS_VERIFY_ATTESTATION=1 requires provenance; a PATH shim is never trusted.\n # Relocate only the fixed trusted binary locations in a private installer copy so this\n-# fixture exercises both branches without depending on whether the host has gh installed.\n+# fixture exercises every branch without depending on whether the host has gh installed.\n mkdir -p \"$TMP/trusted/usr/bin\" \"$TMP/trusted/usr/local/bin\" \"$TMP/path-shim\" \"$TMP/attestation-prefix/bin\"\n sed \"s|/usr/bin/gh|$TMP/trusted/usr/bin/gh|g; s|/usr/local/bin/gh|$TMP/trusted/usr/local/bin/gh|g\" \\\n   \"$INSTALLER\" > \"$TMP/install-test.sh\"\n@@ -43,9 +44,15 @@ printf 'PATH shim invoked\\\\n' >> '$TMP/path-shim.log'\n exit 0\n EOF\n chmod +x \"$TMP/path-shim/gh\"\n-if env -u NEXUS_VERIFY_ATTESTATION \\\n-  NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\n+env -u NEXUS_VERIFY_ATTESTATION \\\n+  NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/auto-prefix\" \\\n   NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" \\\n+  PATH=\"$TMP/path-shim:$PATH\" sh \"$TMP/install-test.sh\" > \"$TMP/auto-no-gh.out\" 2>&1 \\\n+  || { echo \"default auto mode refused to install without a trusted gh\" >&2; cat \"$TMP/auto-no-gh.out\" >&2; exit 1; }\n+grep -F \"build provenance was not verified: no trusted GitHub CLI\" \"$TMP/auto-no-gh.out\" >/dev/null\n+[ -L \"$TMP/auto-prefix/bin/nexus\" ] || { echo \"default auto mode did not install\" >&2; exit 1; }\n+if NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" NEXUS_VERIFY_ATTESTATION=1 \\\n   PATH=\"$TMP/path-shim:$PATH\" sh \"$TMP/install-test.sh\" > \"$TMP/no-trusted-gh.out\" 2>&1; then\n   echo \"installer accepted required provenance without a trusted gh\" >&2\n   exit 1\n@@ -53,12 +60,38 @@ fi\n grep -F \"no trusted GitHub CLI was found\" \"$TMP/no-trusted-gh.out\" >/dev/null\n [ ! -e \"$TMP/path-shim.log\" ] || { echo \"installer invoked PATH gh shim\" >&2; exit 1; }\n if NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/invalid-mode\" \\\n-  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" NEXUS_VERIFY_ATTESTATION=auto \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" NEXUS_VERIFY_ATTESTATION=yes \\\n   sh \"$INSTALLER\" > \"$TMP/invalid-mode.out\" 2>&1; then\n   echo \"installer accepted an unsupported attestation mode\" >&2\n   exit 1\n fi\n grep -F \"NEXUS_VERIFY_ATTESTATION must be\" \"$TMP/invalid-mode.out\" >/dev/null\n+if NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/empty-mode\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" NEXUS_VERIFY_ATTESTATION= \\\n+  sh \"$INSTALLER\" > \"$TMP/empty-mode.out\" 2>&1; then\n+  echo \"installer treated an explicitly empty attestation mode as auto\" >&2\n+  exit 1\n+fi\n+grep -F \"NEXUS_VERIFY_ATTESTATION must be\" \"$TMP/empty-mode.out\" >/dev/null\n+cat > \"$TMP/trusted/usr/bin/gh\" <<'EOF'\n+#!/bin/sh\n+exit 1\n+EOF\n+chmod +x \"$TMP/trusted/usr/bin/gh\"\n+env -u NEXUS_VERIFY_ATTESTATION \\\n+  NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/auto-failing-gh-prefix\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" \\\n+  sh \"$TMP/install-test.sh\" > \"$TMP/auto-failing-gh.out\" 2>&1 \\\n+  || { echo \"default auto mode refused to install when gh could not verify\" >&2; cat \"$TMP/auto-failing-gh.out\" >&2; exit 1; }\n+grep -F \"could not verify the attestation\" \"$TMP/auto-failing-gh.out\" >/dev/null\n+if NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/required-failing-gh-prefix\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" NEXUS_VERIFY_ATTESTATION=1 \\\n+  sh \"$TMP/install-test.sh\" > \"$TMP/required-failing-gh.out\" 2>&1; then\n+  echo \"installer accepted a failed required provenance check\" >&2\n+  exit 1\n+fi\n+grep -F \"provenance attestation verification failed\" \"$TMP/required-failing-gh.out\" >/dev/null\n+[ ! -e \"$TMP/required-failing-gh-prefix/bin/nexus\" ] || { echo \"failed required provenance still installed\" >&2; exit 1; }\n cat > \"$TMP/trusted/usr/bin/gh\" <<'EOF'\n #!/bin/sh\n printf '%s\\n' \"$*\" >> \"$TRUSTED_GH_LOG\"\n917:  const verifyAttestation = process.env.NEXUS_VERIFY_ATTESTATION ?? \"auto\";\n920:      \"NEXUS_VERIFY_ATTESTATION must be auto (verify when a trusted GitHub CLI is present), 1 (require verification) or 0 (skip verification).\",\n927:      \"Provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\",\n1088:          provenanceWarning = `Warning: Build provenance was not verified: ${trustedGh} could not verify the attestation (it may need 'gh auth login'). The SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.`;\n1092:          \"Provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\",\n1095:        provenanceWarning = \"Warning: Build provenance was not verified: no trusted GitHub CLI at /usr/bin/gh or /usr/local/bin/gh. The SHA-256 checksum was verified. Set NEXUS_VERIFY_ATTESTATION=1 to require provenance.\";\n"}],"int