{"timestamp":"2026-10-25T13:30:40.341Z","ordinal":340360,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17267-b4a8-7073-9d2a-32da76e0ee35","item":{"type":"CommandExecution","id":"exec-319bdbf9-b6b2-4abe-a880-9d766a75c9f6","process_id":"44538","command":["/usr/bin/zsh","-lc","sed -n '1,180p' install.sh; sed -n '1,120p' docs/v1.0.0/ACCEPTANCE.md | tail -n 50; rg -n 'NEXUS_PREFIX|NEXUS_VERSION|GITHUB_REPOSITORY' install.sh"],"cwd":"file:///home/mike/nexus-wt/rc5-readiness-checkpoint","parsed_cmd":[{"type":"read","cmd":"sed -n '1,180p' install.sh","name":"install.sh","path":"install.sh"},{"type":"read","cmd":"sed -n '1,120p' docs/v1.0.0/ACCEPTANCE.md","name":"ACCEPTANCE.md","path":"docs/v1.0.0/ACCEPTANCE.md"},{"type":"search","cmd":"rg -n 'NEXUS_PREFIX|NEXUS_VERSION|GITHUB_REPOSITORY' install.sh","query":"NEXUS_PREFIX|NEXUS_VERSION|GITHUB_REPOSITORY","path":"install.sh"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"#!/bin/sh\nset -eu\n\nREPO=mikeholownych/nexus-code\nBASE=${NEXUS_RELEASE_BASE_URL:-\"https://github.com/$REPO/releases\"}\nVERSION=${NEXUS_VERSION:-latest}\nPREFIX=${NEXUS_PREFIX:-\"$HOME/.local\"}\n\nfail() { printf 'nexus installer: %s\\n' \"$*\" >&2; exit 1; }\ncase \"$(uname -s):$(uname -m)\" in\n  Linux:x86_64|Linux:amd64) ;;\n  *) fail \"unsupported system $(uname -s)/$(uname -m); supported: Linux x86-64 (glibc).\" ;;\nesac\ncommand -v node >/dev/null 2>&1 || fail \"Node.js 22 or newer is required; install Node.js and retry.\"\nNODE_MAJOR=$(node -p 'Number(process.versions.node.split(\".\")[0])' 2>/dev/null || printf 0)\n[ \"$NODE_MAJOR\" -ge 22 ] || fail \"Node.js 22 or newer is required (found $(node --version 2>/dev/null || echo unknown)).\"\ncommand -v curl >/dev/null 2>&1 || fail \"curl is required.\"\ncommand -v tar >/dev/null 2>&1 || fail \"tar is required.\"\ncommand -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n\nVERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION:-1}\ncase \"$VERIFY_ATTESTATION\" in\n  0|1) ;;\n  *) fail \"NEXUS_VERIFY_ATTESTATION must be 1 (verify provenance) or 0 (explicitly skip verification).\" ;;\nesac\nTRUSTED_GH=\nif [ -x /usr/bin/gh ]; then\n  TRUSTED_GH=/usr/bin/gh\nelif [ -x /usr/local/bin/gh ]; then\n  TRUSTED_GH=/usr/local/bin/gh\nfi\nif [ \"$VERIFY_ATTESTATION\" = \"1\" ] && [ -z \"$TRUSTED_GH\" ]; then\n  fail \"provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\"\nfi\n\nvalidate_tag() {\n  printf '%s' \"$1\" | grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\"\n}\n\nif [ \"$VERSION\" != \"latest\" ]; then\n  validate_tag \"$VERSION\"\nfi\n\nif [ \"$VERSION\" = \"latest\" ]; then\n  API_BASE=${NEXUS_RELEASES_API:-\"https://api.github.com/repos/$REPO/releases\"}\n  API_TMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-api.XXXXXX\") || fail \"could not create temporary directory.\"\n  api_cleanup() { rm -rf \"$API_TMP\"; }\n  trap api_cleanup EXIT HUP INT TERM\n\n  LATEST_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -D \"$API_TMP/headers\" -o \"$API_TMP/latest.json\" -w \"%{http_code}\" \"$API_BASE/latest\" 2>\"$API_TMP/curl.err\" || echo \"000\")\n\n  if [ \"$LATEST_CODE\" = \"200\" ]; then\n    VERSION=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/latest.json\" | head -n 1)\n    [ -n \"$VERSION\" ] || fail \"GitHub returned no stable release tag.\"\n    validate_tag \"$VERSION\"\n  elif [ \"$LATEST_CODE\" = \"403\" ]; then\n    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \"$API_TMP/headers\" 2>/dev/null; then\n      fail \"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\"\n    fi\n    fail \"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\"\n  elif [ \"$LATEST_CODE\" = \"404\" ]; then\n    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \"$API_TMP/releases.json\" -w \"%{http_code}\" \"$API_BASE?per_page=1\" 2>/dev/null || echo \"000\")\n    if [ \"$PREREL_CODE\" = \"200\" ]; then\n      PREREL_TAG=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/releases.json\" | head -n 1)\n      if [ -n \"$PREREL_TAG\" ]; then\n        fail \"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\"\n      fi\n    fi\n    fail \"could not find latest stable release (HTTP 404 from $API_BASE/latest).\"\n  else\n    fail \"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\"\n  fi\n  rm -rf \"$API_TMP\"\n  trap - EXIT HUP INT TERM\nfi\n\nARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\nNORMALIZED_VERSION=${VERSION#v}\nURL=\"$BASE/download/$VERSION\"\nTMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-install.XXXXXX\") || fail \"could not create temporary directory.\"\ncleanup() { rm -rf \"$TMP\"; }\ntrap cleanup EXIT HUP INT TERM\ncurl -fsSL --show-error --retry 2 \"$URL/$ARCHIVE\" -o \"$TMP/$ARCHIVE\" || fail \"download failed for $ARCHIVE.\"\ncurl -fsSL --show-error --retry 2 \"$URL/SHA256SUMS\" -o \"$TMP/SHA256SUMS\" || fail \"could not download release checksums.\"\ngrep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksum entry for $ARCHIVE is missing.\"\n(cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\nARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n\nif [ \"$VERIFY_ATTESTATION\" != \"0\" ] && [ -n \"$TRUSTED_GH\" ]; then\n  if \"$TRUSTED_GH\" attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n     \"$TRUSTED_GH\" attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n    printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n  elif [ \"$VERIFY_ATTESTATION\" = \"1\" ]; then\n    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n  fi\nfi\n\nVERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\nBIN_DIR=\"$PREFIX/bin\"\nLINK=\"$BIN_DIR/nexus\"\nmkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\nif [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n  fail \"$LINK exists and is not a symlink; left it unchanged.\"\nfi\nif [ -L \"$LINK\" ]; then\n  OLD=$(readlink \"$LINK\")\n  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\nfi\n\nFORCE=${NEXUS_FORCE:-0}\nNEEDS_EXTRACT=1\nif [ -d \"$VERSION_DIR\" ] && [ \"$FORCE\" != \"1\" ]; then\n  if [ -x \"$VERSION_DIR/bin/nexus\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/harness-core\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/nexus-tui\" ] && \\\n     [ \"$(cat \"$VERSION_DIR/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ]; then\n    if [ -f \"$VERSION_DIR/MANIFEST.sha256\" ]; then\n      if (cd \"$VERSION_DIR\" && sha256sum --check --status MANIFEST.sha256 2>/dev/null); then\n        NEEDS_EXTRACT=0\n      fi\n      if [ \"$NEEDS_EXTRACT\" = \"0\" ]; then\n        if ! node - \"$VERSION_DIR/.provenance.json\" \"$ARCHIVE_SHA256\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [file, archiveSha256] = process.argv.slice(2);\ntry {\n  const record = JSON.parse(fs.readFileSync(file, \"utf8\"));\n  if (record.archiveSha256 !== archiveSha256) process.exit(1);\n} catch { process.exit(1); }\nNODE\n        then\n          NEEDS_EXTRACT=1\n        fi\n      fi\n    fi\n  fi\nfi\n\nif [ \"$NEEDS_EXTRACT\" = \"1\" ]; then\n  mkdir -p \"$TMP/unpack\"\n  tar -xzf \"$TMP/$ARCHIVE\" -C \"$TMP/unpack\" || fail \"archive extraction failed.\"\n  PACKAGE=\"$TMP/unpack/nexus\"\n  [ -x \"$PACKAGE/bin/nexus\" ] && [ -x \"$PACKAGE/lib/core/harness-core\" ] && [ -x \"$PACKAGE/lib/core/nexus-tui\" ] && [ \"$(cat \"$PACKAGE/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ] || fail \"release archive is incomplete or has a mismatched version.\"\n  if [ -f \"$PACKAGE/MANIFEST.sha256\" ]; then\n    (cd \"$PACKAGE\" && sha256sum --check --status MANIFEST.sha256) || fail \"release archive failed manifest checksum verification.\"\n  fi\n  PACKAGE_VERSION_OUTPUT=$(\"$PACKAGE/bin/nexus\" --version 2>&1) || fail \"release binary failed its pre-install self-test.\"\n  PACKAGE_VERSION_REPORTED=$(printf '%s\\n' \"$PACKAGE_VERSION_OUTPUT\" | sed -n '1s/[[:space:]].*$//p')\n  [ \"$PACKAGE_VERSION_REPORTED\" = \"$NORMALIZED_VERSION\" ] || fail \"release binary reported version '$PACKAGE_VERSION_REPORTED' instead of '$NORMALIZED_VERSION' during self-test.\"\n  if [ -f \"$PACKAGE/compatibility.json\" ]; then\n    node - \"$PACKAGE/compatibility.json\" \"$VERSION\" \"$ARCHIVE\" <<'NODE' || fail \"release compatibility metadata is invalid or mismatched.\"\nconst fs = require(\"node:fs\");\nconst [file, version, archive] = process.argv.slice(2);\nconst data = JSON.parse(fs.readFileSync(file, \"utf8\"));\nconst asset = data.platforms?.[\"linux-x86_64\"];\nconst compatible = data.schemaVersion === 1 && data.product === \"nexus-code\" &&\n  data.version === version.replace(/^v/, \"\") &&\n  typeof data.revision === \"string\" && /^[a-f0-9]{7,64}$/i.test(data.revision) &&\n  typeof data.builtAt === \"string\" && !Number.isNaN(Date.parse(data.builtAt)) &&\n  asset?.archive === archive && asset.os === \"linux\" && asset.arch === \"x86_64\" &&\n  data.compatibility && Number.isSafeInteger(data.compatibility.configSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.stateSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedConfigVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedStateVersion) &&\n  data.compatibility.minSupportedConfigVersion <= data.compatibility.configSchemaVersion &&\n  data.compatibility.minSupportedStateVersion <= data.compatibility.stateSchemaVersion;\nif (!compatible) process.exit(1);\nNODE\n  fi\n  rm -rf \"$VERSION_DIR\"\n  mv \"$PACKAGE\" \"$VERSION_DIR\"\nfi\nnode - \"$VERSION_DIR/compatibility.json\" \"$VERSION\" \"$PREFIX\" \"$VERSION_DIR\" \"$LINK\" \"$ARCHIVE\" \"$ARCHIVE_SHA256\" \"$VERSION_DIR/.provenance.json\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [metadataPath, version, prefix, installedPath, binPath, archive, archiveSha256, output] = process.argv.slice(2);\nlet metadata = null;\ntry { metadata = JSON.parse(fs.readFileSync(metadataPath, \"utf8\")); } catch {}\nconst record = {\n  formatVersion: 1,\n  method: \"installer\",\n  product: \"nexus-code\",\n\n   Secrets are redacted before commit.\n5. Any step that cannot run in the available environment is recorded as **NOT RUN** with its reason. A NOT RUN on a blocker gate fails the gate.\n\n## 2. Environments\n\n| ID | Environment | Used for |\n|---|---|---|\n| E1 | GitHub Actions: ubuntu-22.04 and ubuntu-24.04; Node 22 and 24; pinned Rust | Unit, integration and PTY suites; packaging; reproducibility |\n| E2 | Docker clean images: ubuntu:22.04, ubuntu:24.04, debian:12, fedora:40. Each with no Node, then with Node 20, Node 22 and Node 24. Non-root user. | Installer, upgrade, rollback, uninstall, platform failure messages |\n| E3 | Operator dev box: Linux x86-64, real terminals (xterm, kitty, tmux, VS Code terminal, GNOME Terminal) | Terminal matrix, live sessions |\n| E4 | Homelab-ai gateway, the **only** inference path (DEC-16): direct, and through `eval/standalone/plain_proxy.mjs` | Task-quality runs, standalone qualification, T3/T4 |\n| E5 | Cloud, small spend: ChatGPT sign-in (experimental tier) and OpenRouter with a pinned model; OpenAI and Anthropic keys if added | Provider verify; one live task per supported cloud provider |\n\n## 3. Gate checklist (G0–G4: automated acceptance IDs)\n\nEvery ACC ID below is defined in the linked spec. The plan for each spec names the test that implements it. Run each check at the lifecycle stage dictated by its acceptance method in §1.1: source-applicable checks before the RC tag; checks requiring the RC archive, attestation, release, or installed package after RC construction; environment-specific checks in their declared environment. Bind every result to the exact source commit and, when artifact-dependent, the RC package digest. A source test or local build does not replace an artifact-bound check, and no G0–G4 ID is complete until all of its applicable checks pass.\n\n| Gate | Acceptance IDs | Spec |\n|---|---|---|\n| Safety | ACC-SAFE-01 to ACC-SAFE-10 | SPEC-01 |\n| Process ownership | ACC-PROC-01 to ACC-PROC-08 (ACC-PROC-07 is the load test, run in E3) | SPEC-02 |\n| Untrusted inputs | ACC-TRUST-01 to ACC-TRUST-09 | SPEC-03 |\n| Continuity | ACC-CONT-01 to ACC-CONT-09 (ACC-CONT-10 is in §8) | SPEC-04 |\n| Inference | ACC-INF-01 to ACC-INF-09 (ACC-INF-10 is in §4) | SPEC-05 |\n| Packaging | ACC-PKG-01 to ACC-PKG-09 | SPEC-06 |\n| Supply chain | ACC-SUP-01 to ACC-SUP-08 (artifact-bound ACC-SUP-01/02/03/06/08 after RC construction) | SPEC-07 |\n| Persistence | ACC-PER-01 to ACC-PER-07 | SPEC-08 |\n| Governance | ACC-GOV-01 to ACC-GOV-06 | SPEC-09 |\n| Verification | ACC-VER-01 to ACC-VER-09 | SPEC-11 |\n| Upgrade | ACC-UPG-01 to ACC-UPG-14 | SPEC-12 |\n\n\n### 3.1 Acceptance IDs defined in this file\n\nThese are retained commitments from REQUIREMENTS §2 and cross-cutting checks.\n\n| ID | Check | Pass condition |\n|---|---|---|\n| ACC-TUI-STEER | PTY: submit a task; while a tool runs, type steering text and press Enter; also queue a steer before a cancel | Steering is applied at the next step boundary. Unapplied steering is returned to the composer. Nothing is dropped silently (existing `sidecar_steering_diff` plus PTY s6). |\n| ACC-TUI-A11Y | PTY with `NO_COLOR=1` and with `TERM=dumb` at 40×14 and 100×30 | Zero colour SGR codes. Every state is distinguishable by glyph and word. Hints are complete at 40 columns (TUI-10). |\n| ACC-SEC-JAIL | `core/tests` plus harness-core calls with `..`, absolute, symlinked-file, symlinked-dir and symlinked-parent payloads | Every one is refused (C §4 R1 set). |\n| ACC-SEC-B6 | Re-run `docs/reviews/evidence/qualification_2026-10-12/repro/zz_trust_repro.test.ts`. Seeded-secret scan of `~/.nexus` and `.nexus` after a scripted turn. | Zero plaintext seeded secrets in durable stores or outbound bodies. |\n| ACC-PRV-LIVE | `nexus providers verify --provider <p> -m <pinned model> -j` for each provider listed as supported (DEC-06) | `passed: true`. Receipts archived. |\n| ACC-PRV-STANDALONE | §4.2 on the installed RC through the approved stripped proxy, with gateway credentials absent from the child environment | Every required profile completes through the proxy and the absent-gateway boundary holds; receipts archived. |\n| ACC-PLAT | E2 matrix, §7 | All rows pass. |\n| ACC-QUAL-T2 | §6.1 + §6.4 | Thresholds met. |\n| ACC-QUAL-T3 | §6.3 + §6.4 | Thresholds met. |\n| ACC-QUAL-T4 | §6.2 + §6.4 | Thresholds met. |\n| ACC-QUAL-SMOKE | `make test` includes the T1 self-test and the T4 smoke | Present and passing. |\n6:VERSION=${NEXUS_VERSION:-latest}\n7:PREFIX=${NEXUS_PREFIX:-\"$HOME/.local\"}\n58:      fail \"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\"\n60:    fail \"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\"\n66:        fail \"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\"\n","exit_code":0,"duration":{"secs":0,"nanos":847641240}},"started_at_ms":1792935039490,"completed_at_ms":1792935040339}}
{"timestamp":"2026-10-25T13:30:41.296Z","ordinal":340361,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17341-9910-7203-aaef-1a29cf3bdffb","call_id":"call_9914258d69534fd6aaa1c3e5062506c6","output":[{"type":"input_text","text":"Script completed\nWall time 2.9 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 3490)\nTotal output lines: 235\n\n#!/bin/sh\nset -eu\n\nREPO=mikeholownych/nexus-code\nBASE=${NEXUS_RELEASE_BASE_URL:-\"https://github.com/$REPO/releases\"}\nVERSION=${NEXUS_VERSION:-latest}\nPREFIX=${NEXUS_PREFIX:-\"$HOME/.local\"}\n\nfail() { printf 'nexus installer: %s\\n' \"$*\" >&2; exit 1; }\ncase \"$(uname -s):$(uname -m)\" in\n  Linux:x86_64|Linux:amd64) ;;\n  *) fail \"unsupported system $(uname -s)/$(uname -m); supported: Linux x86-64 (glibc).\" ;;\nesac\ncommand -v node >/dev/null 2>&1 || fail \"Node.js 22 or newer is required; install Node.js and retry.\"\nNODE_MAJOR=$(node -p 'Number(process.versions.node.split(\".\")[0])' 2>/dev/null || printf 0)\n[ \"$NODE_MAJOR\" -ge 22 ] || fail \"Node.js 22 or newer is required (found $(node --version 2>/dev/null || echo unknown)).\"\ncommand -v curl >/dev/null 2>&1 || fail \"curl is required.\"\ncommand -v tar >/dev/null 2>&1 || fail \"tar is required.\"\ncommand -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n\nVERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION:-1}\ncase \"$VERIFY_ATTESTATION\" in\n  0|1) ;;\n  *) fail \"NEXUS_VERIFY_ATTESTATION must be 1 (verify provenance) or 0 (explicitly skip verification).\" ;;\nesac\nTRUSTED_GH=\nif [ -x /usr/bin/gh ]; then\n  TRUSTED_GH=/usr/bin/gh\nelif [ -x /usr/local/bin/gh ]; then\n  TRUSTED_GH=/usr/local/bin/gh\nfi\nif [ \"$VERIFY_ATTESTATION\" = \"1\" ] && [ -z \"$TRUSTED_GH\" ]; then\n  fail \"provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\"\nfi\n\nvalidate_tag() {\n  printf '%s' \"$1\" | grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\"\n}\n\nif [ \"$VERSION\" != \"latest\" ]; then\n  validate_tag \"$VERSION\"\nfi\n\nif [ \"$VERSION\" = \"latest\" ]; then\n  API_BASE=${NEXUS_RELEASES_API:-\"https://api.github.com/repos/$REPO/releases\"}\n  API_TMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-api.XXXXXX\") || fail \"could not create temporary directory.\"\n  api_cleanup() { rm -rf \"$API_TMP\"; }\n  trap api_cleanup EXIT HUP INT TERM\n\n  LATEST_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -D \"$API_TMP/headers\" -o \"$API_TMP/latest.json\" -w \"%{http_code}\" \"$API_BASE/latest\" 2>\"$API_TMP/curl.err\" || echo \"000\")\n\n  if [ \"$LATEST_CODE\" = \"200\" ]; then\n    VERSION=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/latest.json\" | head -n 1)\n    [ -n \"$VERSION\" ] || fail \"GitHub returned no stable release tag.\"\n    validate_tag \"$VERSION\"\n  elif [ \"$LATEST_CODE\" = \"403\" ]; then\n    if grep -qiE 'x-ratelimit-remaining:[[:space:]]*0' \"$API_TMP/headers\" 2>/dev/null; then\n      fail \"GitHub API rate limit exceeded; set NEXUS_VERSION=vX to bypass the release lookup, or set GITHUB_TOKEN.\"\n    fi\n    fail \"GitHub API returned HTTP 403; set NEXUS_VERSION=vX to bypass the release lookup.\"\n  elif [ \"$LATEST_CODE\" = \"404\" ]; then\n    PREREL_CODE=$(curl -sSL --show-error -H 'Accept: application/vnd.github+json' -o \"$API_TMP/releases.json\" -w \"%{http_code}\" \"$API_BASE?per_page=1\" 2>/dev/null || echo \"000\")\n    if [ \"$PREREL_CODE\" = \"200\" ]; then\n      PREREL_TAG=$(sed -n 's/.*\"tag_name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' \"$API_TMP/releases.json\" | head -n 1)\n      if [ -n \"$PREREL_TAG\" ]; then\n        fail \"no stable release yet; latest prerelease is $PREREL_TAG — rerun with NEXUS_VERSION=$PREREL_TAG\"\n      fi\n    fi\n    fail \"could not find latest stable release (HTTP 404 from $API_BASE/latest).\"\n  else\n    fail \"could not query GitHub releases API (HTTP $LATEST_CODE); network failure or host unreachable.\"\n  fi\n  rm -rf \"$API_TMP\"\n  trap - EXIT HUP INT TERM\nfi\n\nARCHIVE=\"nexus-linux-x86_64-$VERSION.tar.gz\"\nNORMALIZED_VERSION=${VERSION#v}\nURL=\"$BASE/download/$VERSION\"\nTMP=$(mktemp -d \"${TMPDIR:-/tmp}/nexus-install.XXXXXX\") || fail \"could not create temporary directory.\"\ncleanup() { rm -rf \"$TMP\"; }\ntrap cleanup EXIT HUP INT TERM\ncurl -fsSL --show-error --retry 2 \"$URL/$ARCHIVE\" -o \"$TMP/$ARCHIVE\" || fail \"download failed for $ARCHIVE.\"\ncurl -fsSL --show-error --retry 2 \"$URL/SHA256SUMS\" -o \"$TMP/SHA256SUMS\" || fail \"could not download release checksums.\"\ngrep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksum entry for $ARCHIVE is missing.\"\n(cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\nARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n\nif [ \"$VERIFY_ATTESTATION\" != \"0\" ] && [ -n \"$TRUSTED_GH\" ]; then\n  if \"$TRUSTED_GH\" attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n     \"$TRUSTED_GH\" attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n    printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n  elif [ \"$VERIFY_ATTESTATION\" = \"1\" ]; then\n    fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n  fi\nfi\n\nVERSION_DIR=\"$PREFIX/lib/nexus/$VERSION\"\nBIN_DIR=\"$PREFIX/bin\"\nLINK=\"$BIN_DIR/nexus\"\nmkdir -p \"$PREFIX/lib/nexus\" \"$BIN_DIR\"\nif [ -e \"$LINK\" ] && [ ! -L \"$LINK\" ]; then\n  fail \"$LINK exists and is not a symlink; left it unchanged.\"\nfi\nif [ -L \"$LINK\" ]; then\n  OLD=$(readlink \"$LINK\")\n  case \"$OLD\" in \"$PREFIX/lib/nexus/\"*) ;; *) fail \"$LINK points outside the Nexus installation; left it unchanged.\" ;; esac\nfi\n\nFORCE=${NEXUS_FORCE:-0}\nNEEDS_EXTRACT=1\nif [ -d \"$VERSION_DIR\" ] && [ \"$FORCE\" != \"1\" ]; then\n  if [ -x \"$VERSION_DIR/bin/nexus\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/harness-core\" ] && \\\n     [ -x \"$VERSION_DIR/lib/core/nexus-tui\" ] && \\\n     [ \"$(cat \"$VERSION_DIR/VERSION\" 2>/dev/null || true)\" = \"$VERSION\" ]; then\n    if [ -f \"$VERSION_DIR/MANIFEST.sha256\" ]; then\n      if (cd \"$VERSION_DIR\" && sha256sum --check --status MANIFEST.sha256 2>/dev/null); then\n        NEEDS_EXTRACT=0\n      fi\n      if [ \"$NEEDS_EXTRACT\" = \"0\" ]; then\n        if ! node - \"$VERSION_DIR/.provenance.json\" \"$ARCHIVE_SHA256\" <<'NODE'\nconst fs = require(\"node:fs\")…490 tokens truncated…ltAt)) &&\n  asset?.archive === archive && asset.os === \"linux\" && asset.arch === \"x86_64\" &&\n  data.compatibility && Number.isSafeInteger(data.compatibility.configSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.stateSchemaVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedConfigVersion) &&\n  Number.isSafeInteger(data.compatibility.minSupportedStateVersion) &&\n  data.compatibility.minSupportedConfigVersion <= data.compatibility.configSchemaVersion &&\n  data.compatibility.minSupportedStateVersion <= data.compatibility.stateSchemaVersion;\nif (!compatible) process.exit(1);\nNODE\n  fi\n  rm -rf \"$VERSION_DIR\"\n  mv \"$PACKAGE\" \"$VERSION_DIR\"\nfi\nnode - \"$VERSION_DIR/compatibility.json\" \"$VERSION\" \"$PREFIX\" \"$VERSION_DIR\" \"$LINK\" \"$ARCHIVE\" \"$ARCHIVE_SHA256\" \"$VERSION_DIR/.provenance.json\" <<'NODE'\nconst fs = require(\"node:fs\");\nconst [metadataPath, version, prefix, installedPath, binPath, archive, archiveSha256, output] = process.argv.slice(2);\nlet metadata = null;\ntry { metadata = JSON.parse(fs.readFileSync(metadataPath, \"utf8\")); } catch {}\nconst record = {\n  formatVersion: 1,\n  m