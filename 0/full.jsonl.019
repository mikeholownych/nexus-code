ted/usr/bin\" \"$TMP/trusted/usr/local/bin\" \"$TMP/path-shim\" \"$TMP/attestation-prefix/bin\"\nscripts/installer-smoke.sh:47:  NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\nscripts/installer-smoke.sh:68:NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\nscripts/installer-smoke.sh:75:node - \"$TMP/prefix/lib/nexus/$VERSION/.provenance.json\" \"$VERSION\" \"$TMP/prefix\" \"$TMP/prefix/lib/nexus/$VERSION\" \"$TMP/prefix/bin/nexus\" \"$NAME\" \"$TMP/release/download/$VERSION/$NAME\" <<'NODE'\nDisplay=\nRemote=no\nDesktop=\nLeader=6528\nType=wayland\nState=active\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17267-b4a8-7073-9d2a-32da76e0ee35","create_time":1792935034.6891372}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
