; clearTimeout(fallback); killPayload(); });\n+  child.on(\"close\", () => { childClosed = true; clearInterval(repeat); clearTimeout(fallback); killPayload(); });\n   return { child, containment: { final, kill, signal } };\n }\n \n M eval/resources.mjs\n","exit_code":0,"duration":{"secs":0,"nanos":30721}},"started_at_ms":1792921800579,"completed_at_ms":1792921800580}}
