[\"diff\", \"--name-status\", \"HEAD\", checkpoint.gitRef], { cwd: workspace, encoding: \"utf8\" }).trim(), \"D\\tremove.txt\");\ncli/test/security.test.ts:48:      assert.equal(sm.isPathProtected(\".git/config\").protected, true);\ncli/test/retention.test.ts:187:  test(\"Checkpoints git ref and snapshot pruning, flights pruning\", () => {\ncli/test/sidecar.test.ts:455:      assert.ok(checkpoint?.gitRef);\ncli/test/sidecar.test.ts:456:      const persisted = execFileSync(\"git\", [\"show\", `${checkpoint.gitRef}:base.txt`], { cwd: repo, encoding: \"utf8\" });\ncli/test/harness.test.ts:1025:      assert.strictEqual(sm.isPathProtected(\".git\").protected, true);\ncli/test/harness.test.ts:1026:      assert.strictEqual(sm.isPathProtected(\".git/config\").protected, true);\ncli/src/checkpoint.ts:89:          throw new Error(\"Checkpoint could not verify protected Git index state\");\ncli/src/checkpoint.ts:93:            indexError.message === \"Checkpoint could not verify protected Git index state\"\ncli/src/checkpoint.ts:96:            throw new Error(\"Checkpoint could not verify protected Git index state\");\ncli/src/checkpoint.ts:159:        throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\ncli/src/checkpoint.ts:232:    if (typeof raw.gitRef === \"string\" && /^[0-9a-f]{7,64}$/i.test(raw.gitRef)) checkpoint.gitRef = raw.gitRef;\ncli/src/doctor.ts:643:  return f(\"workspace.access\", \"workspace\", \"pass\", `The workspace is readable and writable${git ? \" and is a git repository (checkpoints and /undo available)\" : \"; it is not a git repository, so checkpoints use file snapshots\"}.`, [workspace]);\nFILE_.github_dependabot.yml/owner.json\nFILE_.github_workflows_release.yml/owner.json\nFILE_.github_workflows_repro.yml/owner.json\nFILE_cli_src_agent.ts/owner.json\nSEC_DEMO_GIT_CLEANUP_RACE/owner.json\n","exit_code":0,"duration":{"secs":0,"nanos":801899416}},"started_at_ms":1792937383636,"completed_at_ms":1792937384439}