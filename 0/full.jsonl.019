nyway \\(may persist sensitive content\\).*4 cancel this turn.*5 re-enter the instruction/);\n   452\t      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"allow_sensitive\" });\n   453\t      await waitUntil(() => events.some((event) => event.type === \"turn.result\" && event.turn_id === \"t-sensitive-checkpoint\"));\n   454\t      const [checkpoint] = app.getCheckpointManager().listCheckpoints();\n   455\t      assert.ok(checkpoint?.gitRef);\n   456\t      const persisted = execFileSync(\"git\", [\"show\", `${checkpoint.gitRef}:base.txt`], { cwd: repo, encoding: \"utf8\" });\n   457\t      assert.equal(persisted.includes(sensitiveMarker), true);\n   458\t      assert.ok(events.some((event) => event.type === \"notice\" && /may persist sensitive workspace content/.test(event.text)));\n   459\t    });\n   460\t  });\n   461\t\n   462\t  test(\"cancel choice does not start the turn\", async () => {\n   463\t    await withSidecar(() => ({ kind: \"text\", content: \"must not run\" }), \"review\", async ({ server, events, repo, send }) => {\n   464\t      fs.writeFileSync(path.join(repo, \"base.txt\"), `changed ${`ghp_${\"D\".repeat(36)}`}\\n`);\n   465\t      await send({ type: \"prompt.submit\", id: \"t-cancel-checkpoint\", text: \"review the codebase\" });\n   466\t      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\n   467\t      const request = events.find((event) => event.type === \"checkpoint.choice.request\");\n   468\t      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"cancel\" });\n   469\t      await server.idle();\n   470\t      assert.ok(events.some((event) => event.type === \"error\" && event.id === \"t-cancel-checkpoint\" && /cancelled before it started/.test(event.message)));\n   471\t      assert.equal(events.some((event) => event.type === \"turn.result\" && event.turn_id === \"t-cancel-checkpoint\"), false);\n   472\t    });\n   473\t  });\n   474\t\n   475\t  test(\"other choice cancels the turn and asks for a different instruction\", async () => {\n   540\t        try {\n   541\t          this.checkpointManager.createCheckpoint(\n   542\t            checkpoint,\n   543\t            allowSensitiveCheckpoint ? { allowSensitive: true } : undefined,\n   544\t          );\n   545\t          agent.setCheckpointReadOnlyFallback(false);\n   546\t          checkpointReady = true;\n   547\t        } catch (err) {\n   548\t          const sensitiveContentBlocked = err instanceof SensitivePersistenceError;\n   549\t          const message = sensitiveContentBlocked\n   550\t            ? undefined\n   551\t            : `Checkpoint failed: ${capText(redactSecrets(errorText(err)).replace(/\\\\s+/g, \" \").trim(), 180)}. No checkpoint was written. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 retry while allowing sensitive persistence, 4 cancel this turn, or 5 re-enter the instruction.`;\n   552\t          const choice = await this.requestCheckpointChoice(turnId, signal, message);\n   553\t          if (choice === \"cancel\" || choice === \"other\") {\n   554\t            const message = choice === \"other\"\n   555\t              ? \"This turn was not started. Enter a different instruction in the composer.\"\n   556\t              : \"This turn was cancelled before it started.\";\n   557\t            this.emit({ type: \"error\", id: turnId, code: \"INTERNAL\", message });\n   558\t            return;\n   559\t          }\n   560\t          if (choice === \"read_only\") {\n   561\t            agent.setCheckpointReadOnlyFallback(true);\n   562\t            this.emit({ type: \"notice\", text: \"Continuing this turn in read-only mode as requested. Workspace changes, unsafe commands, external actions, and delegation are disabled.\" });\n   563\t            this.emitSessionState();\n   564\t            checkpointReady = true;\n   565\t          } else if (choice === \"without_checkpoint\") {\n   566\t            this.emit({ type: \"notice\", text: \"Continuing in the current mode without a rollback checkpoint, as requested.\" });\n   567\t            checkpointReady = true;\n   568\t          } else if (choice === \"allow_sensitive\") {\n   569\t            allowSensitiveCheckpoint = true;\n   570\t            this.emit({ type: \"notice\", text: \"Retrying checkpoint creation with sensitive workspace persistence allowed, as requested.\" });\n   571\t          }\n   572\t        }\n   573\t      }\n   574\t    }\n   575\t    if (typeof prompt === \"string\") {\n   576\t      const decision = agent.objectiveDecision(prompt);\n   577\t      if (decision.kind === \"amend\") {\n   578\t        this.emit({\n   579\t          type: \"notice\",\n   580\t          text: `This message continues the unfinished objective (${decision.unresolved} unresolved requirement${decision.unresolved === 1 ? \"\" : \"s\"}); its numbered items, if any, are added to it. /requirements clear starts a new objective.`,\n   581\t        });\n   582\t      }\n","exit_code":0,"duration":{"secs":1,"nanos":152735767}},"started_at_ms":1792937705101,"completed_at_ms":1792937706255}}
