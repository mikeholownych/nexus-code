his.requestCheckpointChoice(turnId, signal);\n   544\t          if (choice === \"cancel\" || choice === \"other\") {\n   545\t            const message = choice === \"other\"\n   546\t              ? \"This turn was not started. Enter a different instruction in the composer.\"\n   547\t              : \"This turn was cancelled before it started.\";\n   548\t            this.emit({ type: \"error\", id: turnId, code: \"INTERNAL\", message });\n   549\t            return;\n   550\t          }\n   551\t          if (choice === \"read_only\") {\n   552\t            agent.setCheckpointReadOnlyFallback(true);\n   553\t            this.emit({ type: \"notice\", text: \"Continuing this turn in read-only mode as requested. Workspace changes, unsafe commands, external actions, and delegation are disabled.\" });\n   554\t            this.emitSessionState();\n   555\t          } else if (choice === \"without_checkpoint\") {\n   556\t            this.emit({ type: \"notice\", text: \"Continuing in the current mode without a rollback checkpoint, as requested.\" });\n   557\t          } else if (choice === \"allow_sensitive\") {\n   558\t            allowSensitiveCheckpoint = true;\n   559\t            this.emit({ type: \"notice\", text: \"Creating a checkpoint that may persist sensitive workspace content, as requested.\" });\n   560\t          }\n   561\t        } else {\n   562\t          const message = `No checkpoint could be saved, so the turn did not start: ${redactSecrets(errorText(err))}`;\n   563\t          this.emit({ type: \"error\", id: turnId, code: \"INTERNAL\", message });\n   564\t          return;\n   565\t        }\n   566\t      }\n   567\t    }\n   568\t    if (allowSensitiveCheckpoint) {\n   569\t      try {\n   570\t        this.checkpointManager.createCheckpoint(checkpoint, { allowSensitive: true });\n   571\t        agent.setCheckpointReadOnlyFallback(false);\n   572\t      } catch (err) {\n   573\t        const message = `No checkpoint could be saved, so the turn did not start: ${redactSecrets(errorText(err))}`;\n   574\t        this.emit({ type: \"error\", id: turnId, code: \"INTERNAL\", message });\n   575\t        return;\n   576\t      }\n   577\t    }\n   578\t    if (typeof prompt === \"string\") {\n   579\t      const decision = agent.objectiveDecision(prompt);\n   580\t      if (decision.kind === \"amend\") {\n   581\t        this.emit({\n   582\t          type: \"notice\",\n   583\t          text: `This message continues the unfinished objective (${decision.unresolved} unresolved requirement${decision.unresolved === 1 ? \"\" : \"s\"}); its numbered items, if any, are added to it. /requirements clear starts a new objective.`,\n   584\t        });\n   585\t      }\n   586\t    }\n   587\t    agent.setObserver(this.observerFor(turnId));\n   588\t    this.sessionTitle = label;\n   589\t    // Work done so far, and changes still awaiting verification, survive the process ending mid-turn.\n   590\t    agent.setProgressListener(() => this.saveSession(label));\n   790\t    try {\n   791\t      const name = `${evidence}-${callId}`.replace(/[^A-Za-z0-9._-]/g, \"_\").slice(0, 160);\n   792\t      const file = this.app.getSessionManager().operationDiffPath(this.sessionId, name);\n   793\t      writePrivateFile(file, diff.endsWith(\"\\n\") ? diff : `${diff}\\n`);\n   794\t      this.diffFiles.set(evidence, file);\n   795\t      return file;\n   796\t    } catch {\n   797\t      return undefined;\n   798\t    }\n   799\t  }\n   800\t\n   801\t  private toolDetail(id: string, evidence: string): void {\n   802\t    const record = this.evidence.get(evidence);\n   803\t    const kept = this.diffFiles.get(evidence);\n   804\t    if (!record && kept) {\n   805\t      // The record was dropped with the oldest; the complete diff is still on disk.\n   806\t      let diff = \"\";\n   807\t      try {\n   808\t        diff = fs.readFileSync(kept, \"utf8\").replace(/\\n$/, \"\");\n   809\t      } catch {}\n   810\t      if (diff) {\n   811\t        this.emit({\n   812\t          type: \"tool.detail\",\n   813\t          id,\n   814\t          evidence,\n   815\t          tool: \"\",\n   816\t          subject: \"\",\n   817\t          status: \"succeeded\",\n   818\t          args: \"(not kept: only the latest \" + MAX_EVIDENCE + \" tool calls keep their arguments and output)\",\n   819\t          output: \"\",\n   820\t          duration_ms: null,\n   821\t          diff: capText(diff, MAX_DIFF_DETAIL),\n   822\t          diff_chars: diff.length,\n   823\t          diff_path: kept,\n   824\t        });\n   825\t        return;\n   826\t      }\n   827\t    }\n   828\t    if (!record) {\n   829\t      const message = `No record of tool call ${capText(redactSecrets(stripEscapes(evidence)))}; only the latest ${MAX_EVIDENCE} are kept.`;\n   830\t      this.emit({ type: \"error\", id, code: \"NOT_FOUND\", message });\n   831\t      return;\n   832\t    }\n   833\t    this.emit({\n   834\t      type: \"tool.detail\",\n   835\t      id,\n   836\t      evidence,\n   837\t      tool: record.tool,\n   838\t      subject: record.subject,\n   839\t      status: record.status,\n   840\t      args: record.args,\ncli/src/sidecar.ts:86:  private pendingCheckpointChoice?: { id: string; settle: (choice: \"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\") => void };\ncli/src/sidecar.ts:178:        this.resolveCheckpointChoice(command.id, command.choice);\ncli/src/sidecar.ts:543:          const choice = await this.requestCheckpointChoice(turnId, signal);\ncli/src/sidecar.ts:661:  private requestCheckpointChoice(turnId: string, signal: AbortSignal): Promise<\"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\"> {\ncli/src/sidecar.ts:667:        this.pendingCheckpointChoice = undefined;\ncli/src/sidecar.ts:672:      this.pendingCheckpointChoice = { id, settle };\ncli/src/sidecar.ts:682:  private resolveCheckpointChoice(id: string, choice: \"read_only\"