\t    let pal = diff_view::palette(state.depth);\n   287\t    let muted = Style::default().fg(MUTED);\n   288\t    let key = Style::default().fg(ACCENT).add_modifier(Modifier::BOLD);\n   289\t    // The whole transcript area: tinted transcript rows never show beside the panel.\n   290\t    let rect = area;\n   291\t    let (title, between) = match &review.scope {\n   292\t        ReviewScope::Operation { .. } => (\" Edit diff · this operation only \", \"edit\"),\n   293\t        ReviewScope::Workspace { .. } => (\" Workspace diff · unstaged changes to tracked files (git diff) \", \"file\"),\n   294\t    };\n   295\t    let mut keys = vec![Span::styled(\" esc\", key), Span::raw(\" back  \"), Span::styled(\"↑↓\", key), Span::raw(\" scroll  \")];\n   296\t    if !review.wrap {\n   297\t        keys.extend([Span::styled(\"←→\", key), Span::raw(\" pan  \")]);\n   298\t    }\n   299\t    keys.extend([Span::styled(\"n p\", key), Span::raw(\" hunk  \"), Span::styled(\"[ ]\", key), Span::raw(format!(\" {between}  \"))]);\n   300\t    keys.extend([Span::styled(\"w\", key), Span::raw(if review.wrap { \" no wrap \" } else { \" wrap \" })]);\n   301\t    if matches!(review.scope, ReviewScope::Operation { .. }) {\n   302\t        keys.extend([Span::raw(\" \"), Span::styled(\"i\", key), Span::raw(\" call \")]);\n   303\t    }\n   304\t    let mut block = Block::bordered()\n   305\t        .border_type(BorderType::Rounded)\n  3060\t    #[test]\n  3061\t    fn checkpoint_choice_requires_explicit_selection() {\n  3062\t        let mut state = ready();\n  3063\t        state.apply(ev(r#\"{\"v\":1,\"type\":\"checkpoint.choice.request\",\"id\":\"choice-1\",\"turn_id\":\"t1\",\"message\":\"Sensitive content prevents checkpointing.\"}\"#));\n  3064\t        assert_eq!(state.on_key(key(KeyCode::Enter)), None);\n  3065\t        assert_eq!(state.on_key(key(KeyCode::Char('4'))), None);\n  3066\t        assert_eq!(state.on_key(key(KeyCode::Enter)), Some(Action::Send(Command::CheckpointChoice {\n  3067\t            id: \"choice-1\".into(),\n  3068\t            choice: \"cancel\".into(),\n  3069\t        })));\n  3070\t        state.apply(ev(r#\"{\"v\":1,\"type\":\"checkpoint.choice.request\",\"id\":\"choice-2\",\"turn_id\":\"t1\",\"message\":\"Sensitive content prevents checkpointing.\"}\"#));\n  3071\t        assert_eq!(state.on_key(key(KeyCode::Char('5'))), None);\n  3072\t        assert_eq!(state.on_key(key(KeyCode::Enter)), Some(Action::Send(Command::CheckpointChoice {\n  3073\t            id: \"choice-2\".into(),\n  3074\t            choice: \"other\".into(),\n  3075\t        })));\n  3076\t    }\n  3077\t\n  3078\t    const APPROVAL: &str = r#\"{\"v\":1,\"type\":\"approval.request\",\"id\":\"approval-1\",\"turn_id\":\"t1\",\"tool\":\"write_file\",\"subject\":\"x.txt\",\"preview\":\"{}\",\"review\":{\"kind\":\"change\",\"path\":\"x.txt\",\"before\":null,\"after\":\"hi\\n\",\"created\":true,\"truncated\":false}}\"#;\n  3079\t\n  3080\t    fn busy_with_approval() -> LiveState {\n","exit_code":0,"duration":{"secs":0,"nanos":951725741}},"started_at_ms":1792937749154,"completed_at_ms":1792937750106}}
