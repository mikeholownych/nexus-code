;\ncli/test/protocol.test.ts:51:    assert.throws(() => parseCommand(\"[1,2]\"), ProtocolError);\ncli/test/protocol.test.ts:52:    assert.throws(() => parseCommand('{\"v\":2,\"type\":\"cancel\"}'), /unsupported protocol version/);\ncli/test/protocol.test.ts:53:    assert.throws(() => parseCommand('{\"v\":1,\"type\":\"prompt.submit\",\"text\":\"x\"}'), /requires id/);\ncli/test/protocol.test.ts:54:    assert.throws(() => parseCommand('{\"v\":1,\"type\":\"bogus\",\"id\":\"z\"}'), (err: unknown) => err instanceof ProtocolError && err.id === \"z\");\ncli/test/protocol.test.ts:55:    assert.throws(() => parseCommand('{\"v\":1,\"type\":\"prompt.submit\",\"id\":\"t9\",\"text\":\"   \"}'), (err: unknown) => err instanceof ProtocolError && err.id === \"t9\");\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17359-3515-7cd3-8706-e6bd2e3432cb","create_time":1792940118.3412032}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
