shared-ref-worker\",\"updatedAt\":\"2026-10-22T06:03:20Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/123\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/npm_and_yarn/experiments/cloudflare-artifacts-vertical-slice/fork-worker/cf-1.0.0-beta.18\",\"number\":122,\"reviewDecision\":\"\",\"title\":\"build(deps-dev): bump cf from 1.0.0-beta.10 to 1.0.0-beta.18 in /experiments/cloudflare-artifacts-vertical-slice/fork-worker\",\"updatedAt\":\"2026-10-22T02:14:55Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/122\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/npm_and_yarn/experiments/cloudflare-artifacts-vertical-slice/agent-collab-worker/cf-1.0.0-beta.18\",\"number\":121,\"reviewDecision\":\"\",\"title\":\"build(deps-dev): bump cf from 1.0.0-beta.10 to 1.0.0-beta.18 in /experiments/cloudflare-artifacts-vertical-slice/agent-collab-worker\",\"updatedAt\":\"2026-10-21T23:19:16Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/121\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/npm_and_yarn/cli/ora-9.4.1\",\"number\":120,\"reviewDecision\":\"\",\"title\":\"build(deps): bump ora from 8.2.0 to 9.4.1 in /cli\",\"updatedAt\":\"2026-10-21T16:08:44Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/120\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/npm_and_yarn/demo/typescript-7.0.2\",\"number\":119,\"reviewDecision\":\"\",\"title\":\"build(deps): bump typescript from 5.9.3 to 7.0.2 in /demo\",\"updatedAt\":\"2026-10-21T16:14:40Z\",\"url\":\"https://github.com/mikeholownych/nexus-code/pull/119\"},{\"baseRefName\":\"main\",\"headRefName\":\"dependabot/npm_and_yarn/experiments/cloudflare-artifacts-vertical-slice/shared-ref-worker/cloudflare/vite-plugin-2.0.0-beta.v.1\",\"number\":118,\"reviewDecision\":\"\",\"title\":\"build(deps-dev): bump @cloudflare/vite-plugin from 2.0.0-beta.sha-52b0dc0e9 to 2.0.0-beta.v.1 in /experiments/cloudflare-artifacts-vertical-slice/shared-ref-worker\",\"update