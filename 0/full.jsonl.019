{"timestamp":"2026-10-25T09:40:40.147Z","ordinal":335393,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1726f-0253-73e1-b83c-c1561bd428b2","call_id":"call_62e9907b355f48cab2b6849fe8b3231b","output":[{"type":"input_text","text":"Script completed\nWall time 3.9 seconds\nOutput:\n"},{"type":"input_text","text":"RESULT 0\n"},{"type":"input_text","text":"{\"chunk_id\":\"0c825c\",\"wall_time_seconds\":0.000028821,\"exit_code\":0,\"original_token_count\":4622,\"output\":\"1b43e5a fix(eval): provide supervisor control pipe to preflight\\n eval/resources.mjs | 5 ++++-\\n 1 file changed, 4 insertions(+), 1 deletion(-)\\ndiff --git a/eval/cgroup_supervisor.mjs b/eval/cgroup_supervisor.mjs\\nindex 87f1dfa..752703e 100644\\n--- a/eval/cgroup_supervisor.mjs\\n+++ b/eval/cgroup_supervisor.mjs\\n@@ -46,12 +46,49 @@ report({ cgroup: payload });\\n \\n let finished = false;\\n let stopRequested = false;\\n+const signalRequests = [];\\n+let graceTimer = null;\\n+let childResult = null;\\n // The shell joins the payload cgroup before exec, so nothing task-controlled ever runs outside the limits.\\n const child = spawn(\\\"/bin/sh\\\", [\\\"-c\\\", 'echo $$ > \\\"$1\\\" && shift && exec \\\"$@\\\"', \\\"sh\\\", path.join(payload, \\\"cgroup.procs\\\"), spec.cmd, ...spec.argv], {\\n   env: { PATH: \\\"/usr/bin:/bin\\\" },\\n   stdio: \\\"inherit\\\",\\n });\\n const killPayload = () => { try { fs.writeFileSync(path.join(payload, \\\"cgroup.kill\\\"), \\\"1\\\"); } catch {} };\\n+const signalPayload = (name, graceMs) => {\\n+  if (name !== \\\"SIGTERM\\\" || !Number.isSafeInteger(graceMs) || graceMs < 0 || graceMs > 30_000) return;\\n+  const pids = (read(path.join(payload, \\\"cgroup.procs\\\")) ?? \\\"\\\").split(\\\"\\\\n\\\").filter(Boolean).map(Number).filter(Number.isSafeInteger);\\n+  let delivered = 0;\\n+  for (const pid of pids) {\\n+    try { process.kill(pid, name); delivered++; } catch {}\\n+  }\\n+  const request = { name, requestedAt: new Date().toISOString(), pids: pids.length, delivered, graceMs, forced: false };\\n+  signalRequests.push(request);\\n+  if (graceTimer) clearTimeout(graceTimer);\\n+  graceTimer = setTimeout(() => {\\n+    if (/^populated 1$/m.test(read(path.join(payload, \\\"cgroup.events\\\")) ?? \\\"\\\")) {\\n+      request.forced = true;\\n+      killPayload();\\n+    }\\n+    graceTimer = null;\\n+    if (childResult) finish(childResult.code, childResult.signal, childResult.spawnError);\\n+  }, graceMs);\\n+  graceTimer.unref();\\n+};\\n+let controlText = \\\"\\\";\\n+const control = fs.createReadStream(null, { fd: 4, autoClose: false });\\n+control.on(\\\"data\\\", (chunk) => {\\n+  controlText += chunk.toString(\\\"utf8\\\");\\n+  let newline;\\n+  while ((newline = controlText.indexOf(\\\"\\\\n\\\")) >= 0) {\\n+    const line = controlText.slice(0, newline);\\n+    controlText = controlText.slice(newline + 1);\\n+    try {\\n+      const message = JSON.parse(line);\\n+      if (message?.type === \\\"signal\\\") signalPayload(message.name, message.graceMs);\\n+    } catch {}\\n+  }\\n+});\\n // A stop can arrive before the shell has joined the leaf; keep emptying it until the child is gone.\\n const stop = () => { if (stopRequested) return; stopRequested = true; killPayload(); setInterval(killPayload, 50).unref(); };\\n for (const signal of [\\\"SIGTERM\\\", \\\"SIGINT\\\", \\\"SIGHUP\\\"]) process.on(signal, stop);\\n@@ -60,6 +97,10 @@ child.on(\\\"exit\\\", (code, signal) => finish(code, signal, null));\\n \\n function finish(code, signal, spawnError) {\\n   if (finished) return;\\n+  childResult = { code, signal, spawnError };\\n+  // The main command may exit before a descendant finishes handling SIGTERM. Let the\\n+  // requested grace interval elapse before cgroup cleanup escalates to SIGKILL.\\n+  if (graceTimer) return;\\n   finished = true;\\n   const procs = (read(path.join(payload, \\\"cgroup.procs\\\")) ?? \\\"\\\").split(\\\"\\\\n\\\").filter(Boolean);\\n   const memoryEvents = keyed(read(path.join(payload, \\\"memory.events\\\")));\\n@@ -80,11 +121,11 @@ function finish(code, signal, spawnError) {\\n   const deadline = Date.now() + 5000;\\n   const poll = () => {\\n     if (/^populated 0$/m.test(read(path.join(payload, \\\"cgroup.events\\\")) ?? \\\"\\\")) {\\n-      report({ ...stats, cleaned: true, stopped: stopRequested, exitCode: code, signal, spawnError });\\n+      report({ ...stats, cleaned: true, stopped: stopRequested, signals: signalRequests, exitCode: code, signal, spawnError });\\n       process.exit(code ?? (signal ? 128 + (os.constants.signals[signal] ?? 0) : 125));\\n     }\\n     if (Date.now() > deadline) {\\n-      report({ ...stats, cleaned: false, exitCode: code, signal, spawnError, error: \\\"payload cgroup still populated after cgroup.kill\\\" });\\n+      report({ ...stats, cleaned: false, signals: signalRequests, exitCode: code, signal, spawnError, error: \\\"payload cgroup still populated after cgroup.kill\\\" });\\n       process.exit(125);\\n     }\\n     setTimeout(poll, 20);\\ndiff --git a/eval/resources.mjs b/eval/resources.mjs\\nindex 490e186..b297308 100644\\n--- a/eval/resources.mjs\\n+++ b/eval/resources.mjs\\n@@ -82,7 +82,10 @@ export function resourceProbeProblem(resources) {\\n   let wrapped;\\n   try { wrapped = containedSpec({ cmd: \\\"/usr/bin/true\\\", argv: [] }, resources); }\\n   catch (error) { return error.message; }\\n-  const result = spawnSync(wrapped.cmd, wrapped.argv, { cwd: \\\"/\\\", env: wrapped.env, stdio: [\\\"ignore\\\", \\\"ignore\\\", \\\"pipe\\\", \\\"pipe\\\"], timeout: 15_000, encoding: \\\"utf8\\\" });\\n+  // The supervisor always opens fd 4 as its control channel, even when a probe never sends a\\n+  // signal. Keep the descriptor present so preflight exercises the same supervisor contract as\\n+  // spawnContained rather than failing before the resource check can report its result.\\n+  const result = spawnSync(wrapped.cmd, wrapped.argv, { cwd: \\\"/\\\", env: wrapped.env, stdio: [\\\"ignore\\\", \\\"ignore\\\", \\\"pipe\\\", \\\"pipe\\\", \\\"pipe\\\"], timeout: 15_000, encoding: \\\"utf8\\\" });\\n   const final = parseReports(result.output?.[3] ?? \\\"\\\").final;\\n   if (!final) return `resource probe produced no containment report (${result.error?.message ?? `exit ${result.status}`}: ${(result.stderr ?? \\\"\\\").trim().slice(-300)})`;\\n   if (final.error || !final.cleaned) return `resource probe failed: ${final.error ?? \\\"payload not cleaned\\\"}`;\\n@@ -111,17 +114,29 @@ export function containedSpec(spec, resources) {\\n export function spawnContained(spec, resources, { stdio, ...options }) {\\n   if (!resources) return { child: spawn(spec.cmd, spec.argv, { ...options, stdio, env: options.env ?? {} }), containment: null };\\n   const wrapped = containedSpec(spec, resources);\\n-  const child = spawn(wrapped.cmd, wrapped.argv, { ...options, env: wrapped.env, stdio: [...stdio, \\\"pipe\\\"] });\\n+  const child = spawn(wrapped.cmd, wrapped.argv, { ...options, env: wrapped.env, stdio: [...stdio, \\\"pipe\\\", \\\"pipe\\\"] });\\n+  const control = child.stdio[4];\\n   let text = \\\"\\\";\\n   let cgroup = null;\\n   const final = new Promise((resolve) => {\\n     child.stdio[3].on(\\\"data\\\", (chunk) => {\\n       text += chunk.toString(\\\"utf8\\\");\\n-      cgroup ??= parseReports(text).cgroup;\\n+      const reports = parseReports(text);\\n+      cgroup ??= reports.cgroup;\\n+      // Close the supervisor's control pipe after its final report. Otherwise the parent write end can\\n+      // keep ChildProcess's `close` event pending even though the supervised command and scope have exited.\\n+      if (reports.final && control && !control.destroyed) control.end();\\n     });\\n     child.stdio[3].on(\\\"close\\\", () => resolve(parseReports(text).final));\\n     child.on(\\\"error\\\", () => resolve(null));\\n   });\\n+  const signal = (name, graceMs = 5000) => {\\n+    if (name !== \\\"SIGTERM\\\" || !Number.isSafeInteger(graceMs) || graceMs < 0 || graceMs > 30_000) {\\n+      throw new Error(\\\"contained payload supports SIGTERM with a grace period from 0 to 30000 ms\\\");\\n+    }\\n+    if (!control || control.destroyed || !control.writable) return false;\\n+    return control.write(`${JSON.stringify({ type: \\\"signal\\\", name, graceMs })}\\\\n`);\\n+  };\\n   let repeat = null;\\n   let fallback = null;\\n   const killPayload = () => { if (cgroup) { try { fs.writeFileSync(path.join(cgroup, \\\"cgroup.kill\\\"), \\\"1\\\"); } catch {} } };\\n@@ -137,7 +152,7 @@ export function spawnContained(spec, resources, { stdio, ...options }) {\\n     setTimeout(() => clearInterval(repeat), 30_000).unref();\\n   };\\n   child.on(\\\"close\\\", () => { clearInterval(repeat); clearTimeout(fallback); killPayload(); });\\n-  return { child, containment: { final, kill } };\\n+  return { child, containment: { final, kill, signal } };\\n }\\n \\n /** Why a finished contained execution cannot be trusted as bounded, or null. */\\ndiff --git a/eval/run.mjs b/eval/run.mjs\\nindex 9a71811..88f3e83 100644\\n--- a/eval/run.mjs\\n+++ b/eval/run.mjs\\n@@ -18,6 +18,7 @@ import { applyAgentChanges, cloneWorkspace } from \\\"./hardened_check.mjs\\\";\\n import { containmentProblem, resourceProbeProblem, spawnContained } from \\\"./resources.mjs\\\";\\n import { StringDecoder } from \\\"node:string_decoder\\\";\\n import { commandBaseline, countCompactions, createT3Driver, scoreT3Run, steeringBaseline, steeringPrecondition, t3Snapshot } from \\\"./t3.mjs\\\";\\n+import { observeT4Fixture } from \\\"./t4_fixtures.mjs\\\";\\n \\n const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \\\"..\\\");\\n const args = parseArgs(process.argv.slice(2));\\n@@ -230,7 +231,7 @@ async function runOnce(task, run) {\\n     let agent;\\n     let agentEndedAt;\\n     try {\\n-      agent = await runAgent(task, ws, home, budget, agentIdentity, proxyDir, localToken);\\n+      agent = await runAgent(task, ws, home, budget, agentIdentity, proxyDir, localToken, proxy);\\n       agentEndedAt = Date.now();\\n       if (config.runAs) {\\n         for (const dir of [ws, home]) await normalizeRunAsPermissions(config.runAs, dir, asUserSpec);\\n@@ -242,6 +243,7 @@ async function runOnce(task, run) {\\n     const wallMs = agentEndedAt - started;\\n     if (agent.containmentProblem) throw new Error(`candidate containment failed: ${agent.containmentProblem}`);\\n     const model = proxy ? proxy.stats() : null;\\n+    const fixtureFaults = observeT4Fixture(task, agent, agent.resources, config.resources);\\n     const contaminated = treeDigest(task.dir) !== sourceBefore || `${agent.stdout}${agent.stderr}`.includes(tasksDir);\\n     // T3 judges the workspace as it was when the objective's work ended (snapshot taken before the probe turn).\\n     const t3 = agent.t3Driver ? scoreT3Run({ task, baseline: t3Baseline, driver: agent.t3Driver, preconditions: agent.t3Preconditions, compactions: countCompactions(home) }) : null;\\n@@ -290,6 +292,7 @@ async function runOnce(task, run) {\\n       ...(hardening ? { hardened: { baseline: hardening.baseline, applied: hardening.applied.length, discarded: hardening.discarded, configChanges: hardening.configChanges } } : {}),\\n       ...(t3 ? { t3 } : {}),\\n       model,\\n+      ...((agent.t4FaultsInjected?.length || fixtureFaults.length) ? { t4FaultsInjected: [...(agent.t4FaultsInjected ?? []), ...fixtureFaults] } : {}),\\n       resources: config.resources ? { agent: agent.resources, hidden: hidden.resources ?? null, regression: regression?.resources ?? null, ...(t3BaselineResources.length ? { t3Baseline: t3BaselineResources } : {}) } : null,\\n       logs: saveLogs(task, run, agent, hidden, regression),\\n     };\\n@@ -475,6 +478,7 @@ function agentCommand(task, ws, home, budget, agentIdentity, localToken) {\\n   };\\n   const agent = config.agent ?? \\\"nexus\\\";\\n   if (agent === \\\"nexus\\\") {\\n+    if (task.t4Fixture) env.NEXUS_EVAL_TOOL_RECEIPTS = \\\"1\\\";\\n     env.LOCAL_LLM_ENDPOINT = ep;\\n     const contextArgs = nexusContextLimitArgs(config, limits.context);\\n     if (task.tier === \\\"T3\\\") {\\n@@ -523,8 +527,47 @@ function agentCommand(task, ws, home, budget, agentIdentity, localToken) {\\n   throw new Error(`agent ${agent} has no adapter`);\\n }\\n \\n-function runAgent(task, ws, home, budget, agentIdentity, proxyDirectory, localToken) {\\n+async function runAgent(task, ws, home, budget, agentIdentity, proxyDirectory, localToken, proxy) {\\n+  if (task.t4RunnerFault !== \\\"sigterm_resume\\\") {\\n+    return runAgentAttempt(task, ws, home, budget, agentIdentity, proxyDirectory, localToken);\\n+  }\\n+  if (task.tier !== \\\"T4\\\" || (config.agent ?? \\\"nexus\\\") !== \\\"nexus\\\" || config.qualification !== true || !config.resources) {\\n+    throw new Error(\\\"sigterm_resume requires an installed Nexus qualification run with the kernel resource contract\\\");\\n+  }\\n+  const interrupted = await runAgentAttempt(task, ws, home, budget, agentIdentity, proxyDirectory, localToken, { signalAfterAnswer: true, proxy });\\n+  const signal = interrupted.t4Signal;\\n+  if (!signal?.delivered) return { ...interrupted, t4FaultsInjected: [] };\\n+  const resumed = await runAgentAttempt(task, ws, home, budget, agentIdentity, proxyDirectory, localToken, { resume: true });\\n+  const evidence = {\\n+    signal: \\\"SIGTERM\\\",\\n+    delivered: signal.delivered,\\n+    deliveredProcesses: signal.deliveredProcesses,\\n+    forced: signal.forced,\\n+    firstExitCode: signal.firstExitCode,\\n+    payloadExitSignal: signal.payloadExitSignal,\\n+    supervisorWrapperExitSignal: signal.supervisorWrapperExitSignal,\\n+    signalDuringActiveTurn: signal.signalDuringActiveTurn,\\n+    resumed: resumed.code === 0 && resumed.json?.turn?.execution === \\\"COMPLETED\\\",\\n+    resumeExitCode: resumed.code,\\n+    resumeTurnExecution: resumed.json?.turn?.execution ?? null,\\n+  };\\n+  return {\\n+    ...resumed,\\n+    stdout: `${interrupted.stdout}\\\\n--- T4 SIGTERM interruption ---\\\\n${resumed.stdout}`,\\n+    stderr: `${interrupted.stderr}\\\\n--- T4 resume attempt ---\\\\n${resumed.stderr}`,\\n+    t4FaultsInjected: [{ kind: \\\"sigterm_resume\\\", source: \\\"task_fixture_or_runner\\\", evidence }],\\n+  };\\n+}\\n+\\n+function runAgentAttempt(task, ws, home, budget, agentIdentity, proxyDirectory, localToken, { signalAfterAnswer = false, proxy = null, resume = false } = {}) {\\n   const { cmd, argv, env, protocol } = agentCommand(task, ws, home, budget, agentIdentity, localToken);\\n+  if (resume) {\\n+    if ((config.agent ?? \\\"nexus\\\") !== \\\"nexus\\\" || protocol) throw new Error(\\\"T4 resume is supported only by Nexus run mode\\\");\\n+    const promptIndex = argv.lastIndexOf(task.objective);\\n+    if (promptIndex < 0) throw new Error(\\\"could not remove original prompt before Nexus resume\\\");\\n+    argv.splice(promptIndex, 1);\\n+    argv.push(\\\"--resume\\\");\\n+  }\\n   if (config.qualification === true && !config.runAs) throw new Error(\\\"qualification candidate execution requires the dedicated evaluator account\\\");\\n   if (config.runAs) grantRunAsAccess(config.runAs, [ws, home, proxyDirectory]);\\n   const runtimePaths = [fs.realpathSync(cmd), ...agentIdentity.argsPrefix.filter((item) => path.isAbsolute(item)), ...(config.sandboxRuntimePaths ?? [])];\\n@@ -605,18 +648,51 @@ function runAgent(task, ws, home, budget, agentIdentity, proxyDirectory, localTo\\n         process.kill(-child.pid, sig);\\n       } catch {}\\n     };\\n+    let signalEvidence = null;\\n+    const signalPoll = signalAfterAnswer ? setInterval(() => {\\n+      if (signalEvidence || (proxy?.stats().answered ?? 0) < 1) return;\\n+      if (!containment) return;\\n+      const proxyState = proxy.stats();\\n+      // An answered request alone only proves the model replied sometime earlier. Require\\n+      // an in-flight inference request while this Nexus process is still alive so the\\n+      // injected interruption is demonstrably during an active turn.\\n+      if (proxyState.activeInferenceRequests < 1 || child.exitCode !== null) return;\\n+      try {\\n+        if (containment.signal(\\\"SIGTERM\\\", 5000)) signalEvidence = {\\n+          requestedAt: new Date().toISOString(),\\n+          answeredBeforeSignal: true,\\n+          activeInferenceRequests: proxyState.activeInferenceRequests,\\n+          signalDuringActiveTurn: true,\\n+        };\\n+      } catch {}\\n+    }, 25) : null;\\n     const timer = setTimeout(() => {\\n       timedOut = true;\\n       killGroup(\\\"SIGTERM\\\");\\n       setTimeout(() => killGroup(\\\"SIGKILL\\\"), 10_000).unref();\\n     }, (budget.minutes + 5) * 60_000);\\n     child.on(\\\"error\\\", (err) => (stderr += `spawn error: ${err.message}\\\\n`));\\n-    child.on(\\\"close\\\", async (code) => {\\n+    child.on(\\\"close\\\", async (code, exitSignal) => {\\n       clearTimeout(timer);\\n-      killGroup(\\\"SIGKILL\\\");\\n+      if (signalPoll) clearInterval(signalPoll);\\n+      // A contained payload is already reaped by cgroup_supervisor before its final report. Do not race that\\n+      // report with a second force-kill; only the uncontained development path needs process-group cleanup here.\\n+      if (!containment) killGroup(\\\"SIGKILL\\\");\\n       const final = containment ? await containment.final : undefined;\\n       const json = driver ? { turn: driver.state.objectiveTurns.at(-1) ?? null } : lastJson(stdout);\\n-      resolve({ code, timedOut, outputExceeded, stdout, stderr, json, ...(driver ? { t3Driver: driver.state, t3Preconditions: preconditions } : {}), ...(containment ? { resources: final, containmentProblem: containmentProblem(final) } : {}) });\\n+      const observedSignal = final?.signals?.find((entry) => entry.name === \\\"SIGTERM\\\");\\n+      const t4Signal = signalEvidence ? {\\n+        ...signalEvidence,\\n+        delivered: (observedSignal?.delivered ?? 0) > 0,\\n+        deliveredProcesses: observedSignal?.delivered ?? 0,\\n+        forced: observedSignal?.forced ?? null,\\n+        firstExitCode: code,\\n+        // `child` is the systemd-run wrapper; only the supervisor's final report identifies\\n+        // the task payload's signal disposition.\\n+        payloadExitSignal: final?.signal ?? null,\\n+        supervisorWrapperExitSignal: exitSignal ?? null,\\n+      } : null;\\n+      resolve({ code, timedOut, outputExceeded, stdout, stderr, json, ...(t4Signal ? { t4Signal } : {}), ...(driver ? { t3Driver: driver.state, t3Preconditions: preconditions } : {}), ...(containment ? { resources: final, containmentProblem: containmentProblem(final) } : {}) });\\n     });\\n   });\\n }\\n@@ -693,7 +769,7 @@ function harnessIdentity() {\\n   const git = (...a) => spawnSync(\\\"git\\\", a, { cwd: ROOT, encoding: \\\"utf8\\\" }).stdout.trim();\\n   const commit = git(\\\"rev-parse\\\", \\\"HEAD\\\");\\n   const dirty = Boolean(git(\\\"status\\\", \\\"--porcelain\\\", \\\"--untracked-files=all\\\", \\\"--\\\", \\\".\\\", \\\":(exclude)cli/dist\\\"));\\n-  const sourceFiles = [\\\"eval/run.mjs\\\", \\\"eval/validate.mjs\\\", \\\"eval/isolate.mjs\\\", \\\"eval/hide_oracle.cjs\\\", \\\"eval/hide_oracle.py\\\", \\\"eval/unlink_then_exec.sh\\\", \\\"eval/agent_sandbox.mjs\\\", \\\"eval/model_proxy.mjs\\\", \\\"eval/score.mjs\\\", \\\"eval/infra.mjs\\\", \\\"eval/workspace.mjs\\\", \\\"eval/resources.mjs\\\", \\\"eval/cgroup_supervisor.mjs\\\", \\\"eval/t3.mjs\\\", \\\"eval/hardened_check.mjs\\\"];\\n+  const sourceFiles = [\\\"eval/run.mjs\\\", \\\"eval/validate.mjs\\\", \\\"eval/t4_fixtures.mjs\\\", \\\"eval/isolate.mjs\\\", \\\"eval/hide_oracle.cjs\\\", \\\"eval/hide_oracle.py\\\", \\\"eval/unlink_then_exec.sh\\\", \\\"eval/agent_sandbox.mjs\\\", \\\"eval/model_proxy.mjs\\\", \\\"eval/score.mjs\\\", \\\"eval/infra.mjs\\\", \\\"eval/workspace.mjs\\\", \\\"eval/resources.mjs\\\", \\\"eval/cgroup_supervisor.mjs\\\", \\\"eval/t3.mjs\\\", \\\"eval/hardened_check.mjs\\\"];\\n   const sourceDigests = sourceFiles.map((file) => ({ file, sha256: createHash(\\\"sha256\\\").update(fs.readFileSync(path.join(ROOT, file))).digest(\\\"hex\\\") }));\\n   const sourceSha256 = createHash(\\\"sha256\\\").update(JSON.stringify(sourceDigests)).digest(\\\"hex\\\");\\n   return { commit, dirty, sourceDigests, sourceSha256, string: `${commit.slice(0, 12)}${dirty ? \\\"-dirty\\\" : \\\"\\\"}` };\\n\"}"},{"type":"input_text","text":"RESULT 1\n"},{"type":"input_text","text":"{\"chunk_id\":\"76f4de\",\"wall_time_seconds\":0.000030179,\"exit_code\":0,\"original_token_count\":4118,\"output\":\"Warning: truncated output (original token count: 4118)\\nTotal output lines: 191\\n\\n# Running multiple agents on this plan without collisions\\n\\nThese rules apply to every agent (Claude Code, Codex, Cursor, Nexus itself, or a human) that implements any part of this package at the same time as another. The repository's root `AGENTS.md` points here. The rules come from incidents recorded in `tasks/lessons.md`:\\n\\n- a concurrent agent overwrote newer evidence;\\n- full test suites were contaminated by edits made mid-run;\\n- `pkill -f` killed the agent's own shell;\\n- HEAD moved during a pause.\\n\\nThey also follow from audit finding PER-03: the test suite writes into the real `~/.nexus`.\\n\\n## 1. Unit of work: one claimed PR slice per agent\\n\\n- The unit of concurrent work is **one PR slice** from a plan, for example `PLAN-01/PR-1a`. Every slice lists its tasks and its safe change boundary in its plan.\\n- An agent works on exactly one claimed slice at a time.\\n- An agent must not edit files outside its slice's boundary. The exceptions are the ledger rows and the shared files covered by §4. If the work needs a file outside the boundary, the agent stops and records a **boundary request** (§6). It does not edit the file.\\n\\n## 2. Claiming a slice (atomic and machine-local)\\n\\nClaims live in the repository's shared git directory. They are visible to every worktree, and they are never committed.\\n\\n```sh\\nCLAIMS=\\\"$(git rev-parse --git-common-dir)/nexus-claims\\\"\\nmkdir -p \\\"$CLAIMS\\\"\\nSLICE=\\\"PLAN-01_PR-1a\\\"\\nif mkdir \\\"$CLAIMS/$SLICE\\\" 2>/dev/null; then          # mkdir is atomic: exactly one agent wins\\n  printf '{\\\"agent\\\":\\\"%s\\\",\\\"branch\\\":\\\"%s\\\",\\\"since\\\":\\\"%s\\\",\\\"pid\\\":%s}\\\\n' \\\\\\n    \\\"$AGENT_NAME\\\" \\\"v1/plan-01-pr-1a\\\" \\\"$(date -u +%FT%TZ)\\\" \\\"$$\\\" > \\\"$CLAIMS/$SLICE/owner.json\\\"\\nelse\\n  echo \\\"claimed by: $(cat \\\"$CLAIMS/$SLICE/owner.json\\\")\\\"; exit 1\\nfi\\n```\\n\\n- **Release** the claim by deleting its directory (`rm -r \\\"$CLAIMS/$SLICE\\\"`) after the slice merges or is abandoned. Write one line about the outcome to `$CLAIMS/../nexus-claims.log`.\\n- **Hot-file claims** use the same mechanism with the name `FILE_<path with / replaced by _>`, for example `FILE_cli_src_agent.ts`. See §4.\\n- **Stale claims.** A claim older than 24 h whose PID is gone may be broken, but only by the owner, or by an agent that first records the broken claim in the log.\\n- If the MCP Agent Mail server is available, its file reservations (`file_reservation_paths`) may be used as well. The git-common-dir claim stays authoritative, because every agent can see it without extra tooling.\\n\\n## 3. Isolation: worktree, branch, HOME, ports, processes\\n\\n| Resource | Rule |\\n|---|---|\\n| Source | One `git worktree` per claimed slice: `git worktree add ../nexus-wt/<slice> -b v1/<plan>-<slice> origin/main`. Never edit `~/nexus-code` itself. It is the owner's checkout, and `/usr/local/bin/nexus` runs from it. |\\n| Branch | `v1/plan-NN-pr-Nx`. One branch per slice. Never commit to `main` directly. |\\n| HOME and state | Until PLAN-08 PR-8a lands, every test, build and probe run sets `HOME=$(mktemp -d)` and `XDG_CONFIG_HOME=\\\"$HOME/.config\\\"`. After PR-8a, the test setup enforces this, but scripts and probes outside `npm test` must still set it. **Never** run anything that writes to the real `~/.nexus` or `~/.config/nexus`. |\\n| Test runs | Full suites run on a **snapshot copy** of the worktree (`git worktree add` at the commit under test, or `git archive`), never on the tree being edited. `tsx` reads `src/` live. |\\n| Builds | Each worktree builds into its own `core/target`, and `cli/dist` is per worktree. To share the Rust build cache, set `CARGO_TARGET_DIR` per worktree, never to one shared directory. |\\n| Ports | Mock servers bind `127.0.0.1:0` (an ephemeral port) and publish the chosen port to a file. Fixed ports are forbidden. |\\n| Processes | Kill only PIDs you started, taken from `$!` or `ps -eo pid,args \\\\| grep -v grep`. **Never `pkill -f` or `killall`.** Long background jobs are stopped through the agent's own task controls. |\\n| Inference | There is one inference host (DEC-16). Any run that uses the gateway takes the claim `GATEWAY` first. That includes eval runs, live checks and stripped-proxy runs. One gateway run at a time, which keeps eval timings valid and prevents overload. Small cloud checks (E5) take `CLOUD` to avoid duplicate spend. |\\n| Credentials | Agents never read or copy `~/.config/nexus/credentials.json`, `config.env` values, or gateway tokens. The stripped proxy reads the token file itself. |\\n\\n## 4. Hot files: serialise, do not merge blindly\\n\\nThese files are touched by several plans. An agent editing one must hold its `FILE_` claim for the **shortest** period: edit, test, push, merge, then release.\\n\\n| File | Plans that touch it | Rule |\\n|---|---|---|\\n| `cli/src/agent.ts` | 01, 02, 03, 04, 05, 11 | Claim required. Keep each change local to the line ranges the plan names. Rebase immediately before merge and re-run that slice's tests on the rebased snapshot. |\\n| `cli/src/index.ts` | 01, 03, 04, 06, 08, 10, 11 | Claim required. **PLAN-06 PR-6b (unified launcher) lands first.** Other plans add commands and flags afterwards. |\\n| `cli/src/tools.ts` | 01, 02, 03, 06, 11 | Claim required. **PLAN-02 PR-2b (signal plumbing) lands before PLAN-03 PR-3c (`safeFetch`)**. |\\n| `cli/src/sidecar.ts` | 01, 02, 03, 05, 08 | Claim required |\\n| `cli/src/doctor.ts` | 01, 03, 05, 06, 08 | Claim required. Each plan adds **new check functions** in separate blocks. Only PLAN-06 PR-6d changes existing checks. |\\n| `cli/src/client.ts` | 03, 05, 08, 11 | Claim required. **PLAN-03 PR-3a (env layering) lands before any PLAN-05 slice.** |\\n| `cli/src/repl.ts` | 01, 05, 08 | Claim required |\\n| `cli/src/config.ts`, `security.ts`, `sandbox.ts`, `mcp.ts`, `plugins.ts` | 01, 03 | Claim required. PLAN-01 PR-1e and PLAN-03 must not run at the same time on `sandbox.ts` or `security.ts`. |\\n| `cli/src/core/capabilities.ts` | 01, 02 | **PLAN-01 PR-1a (effect classes) lands first.** PLAN-02 PR-2c adds schema fields afterwards. |\\n| `cli/src/tester.ts` | 01, 11 | **PLAN-01 PR-1c lands before PLAN-11 PR-11b/11c.** |\\n| `cli/src/core/state.ts` | 04, 08 | **PLAN-08 PR-8a (HOME isolation) lands before everything.** |\\n| `core/src/runner.rs`, `core/src/main.rs` | 01, 02, 06 | Claim required. The protocol version number is owned by PLAN-02 PR-2a. PLAN-06 PR-6c only reads it. |\\n| `core/src/bin/nexus_tui/{live_state,live_view}.rs` | 01, 02 | Claim required |\\n| `package.json`, `cli/package.json`, `core/Cargo.toml`, lockfiles | 01, 06, 07, 08 | **Only one agent at a time.** Version fields are written only by `scripts/sync-version.mjs`. Dependency changes are separate commits that touch only the lockfile and manifest. |\\n| `harness.sh`, `install.sh`, `scripts/package-linux.sh`, `.github/workflows/*` | 05, 06, 07, 09, C1 | Claim required. Workflow edits are separate commits. |\\n| `cli/dist/**` | all, while tracked | Do not commit `cli/dist` from slices. PLAN-07 PR-7d untracks it (DEC-10). Until that merges, only the merging agent rebuilds and commits dist, in a final separate commit, after rebasing. |\\n| `docs/USER_MANUAL.md`, `ARCHITECTURE.md`, `CLOUD_PROVIDERS.md`, `quickstart.md` | 05, 09 and doc tasks in every plan | Edit only the sections your slice changes. Hold a short `FILE_` claim. |\\n\\n### Ledger updates (`docs/v1.0.0/REQUIREMENTS.md`)\\n\\nA slice changes only the rows for its own requirement IDs: the status, test-reference and evidence cells, in place. It never reorders, adds or removes rows, and never edits another slice's rows. New requirements discovered during work go to §6, not into the ledger. Because rows are independent lines, git merges these edits cleanly. If a conflict appears anyway, resolve it row by row, keeping both changes.\\n\\n## 5. Commit and merge discipline\\n\\n1. Before **every** commit, compare `git rev-parse HEAD` with the commit you last made. Then run `git log <yours>..HEAD` on the branch. If anything foreign appears, stop and reconcile. Never commit generated artifacts (evidence, dist, lockfiles) over a branch that moved (lessons 2026-10-13).\\n2. Commits are scoped to the…118 tokens truncated…releases) are **owner-approved actions** (DECISIONS X-list). Agents prepare them and do not perform them.\\n6. Preserve unrelated user work: the untracked `nexus-continuity-validation/`, the stashes, and any dirty files you did not create. Never stash, reset, clean or check out over them.\\n\\n## 6. Coordination records\\n\\n| Record | Where | Purpose |\\n|---|---|---|\\n| Claims | `$(git rev-parse --git-common-dir)/nexus-claims/` | Who owns which slice or file right now |\\n| Claim log | `$(git rev-parse --git-common-dir)/nexus-claims.log` (append-only, one line per event) | Claim, release, broken claim, boundary request |\\n| Boundary requests and discovered requirements | The PR description, under the heading `Needs from other slices`. Mirrored as one line in the claim log. | So the owning slice's agent can pick it up. Never fixed silently out of scope. |\\n| Slice evidence | `docs/reviews/evidence/v1/<plan>-<slice>/` (new directory per slice) | No shared evidence files, so agents cannot overwrite each other's evidence |\\n\\n## 7. Safe parallel lanes\\n\\nThe following groupings can run at the same time with no hot-file contention beyond §4 claims. They are listed by milestone.\\n\\n| Phase | Parallel lanes |\\n|---|---|\\n| M0 | (a) PLAN-08 PR-8a, which must merge first. Then in parallel: (b) PLAN-06 PR-6a, (c) PLAN-09 PR-9a. |\\n| M1 | (a) PLAN-01 PR-1a → PR-1b → PR-1c (sequential, owns `capabilities.ts`, `agent.ts` dispatch). (b) PLAN-02 PR-2a (Rust only). (c) PLAN-03 PR-3a → PR-3b (config/egress). (d) PLAN-11 PR-11a (`parser.ts`) and PR-11b (`tester.ts`, after PR-1c). Lanes (b), (c) and (d) do not touch `capabilities.ts`. |\\n| M2 (alongside M1) | (a) PLAN-07 PR-7a/7b/7c (workflows, scripts). (b) PLAN-06 PR-6b after PLAN-01 PR-1b (shares `index.ts` flags). |\\n| M3 | (a) PLAN-04 (`agent.ts` turn, operation runner). (b) PLAN-05 (`client.ts`, provider modules). (c) PLAN-10 harness (`eval/`, no product files). (d) Held-out task authoring by the agent author, **outside the repository**: no access to Nexus source or the development set (DEC-05). |\\n| M4 (alongside M3) | PLAN-08 PR-8b..8e. Coordinate with PLAN-04 on `state.ts` through `FILE_` claims. |\\n| M5 | **Serial on `GATEWAY`.** The eval runner, the stripped-proxy runs and the independent reviewer's live task each take the `GATEWAY` claim. The terminal matrix (E3) and the install matrix (E2) can run in parallel with gateway runs. |\\n\\n## 8. Independence constraints\\n\\n- The held-out task author must not see Nexus source, the development tasks or tuning history. It runs in a separate session with only the task schema and external repositories. Its output is sealed by a sha256 manifest committed before RC1.\\n- The independent reviewer in ACCEPTANCE §8 must not be the agent or session that implemented the slices under review.\\n- An implementing agent never edits `eval/heldout-manifest.json`, scorer thresholds or ACCEPTANCE §6.4 after the freeze.\\n M AGENTS.md\\n M cli/dist/agent.js\\n M cli/src/agent.ts\\n M cli/src/core/state.ts\\n M cli/test/compaction_continuity.test.ts\\nA  docs/v1.0.0/ACCEPTANCE.md\\nA  docs/v1.0.0/REQUIREMENTS.md\\nA  scripts/check_requirements.mjs\\n?? cli/test/agent_prompt.test.ts\\n?? docs/reviews/evidence/v1-qualification/\\n?? docs/v1.0.0/AUDIT.md\\n?? docs/v1.0.0/CONCURRENCY.md\\n?? docs/v1.0.0/DECISIONS.md\\n?? docs/v1.0.0/EVIDENCE.md\\n?? docs/v1.0.0/LANGSMITH_REVIEW.md\\n?? docs/v1.0.0/README.md\\n?? docs/v1.0.0/ROADMAP.md\\n?? docs/v1.0.0/SHA256SUMS\\n?? docs/v1.0.0/evidence/\\n?? docs/v1.0.0/plans/\\n?? docs/v1.0.0/specs/\\n?? jsf/\\n?? nexus-continuity-validation/\\n?? nexus-session-session_20261014_091558_9m78.json\\n?? nexus-session-session_20261023_134635_z1dnlfek.json\\n.git/nexus-claims/FILE_experiments_cloudflare-artifacts-vertical-slice_trusted-broker-bundle_package.json/owner.json\\n.git/nexus-claims/FILE_scripts_repro-identity.mjs/owner.json\\n.git/nexus-claims/FILE_eval_cgroup_supervisor.mjs/owner.json\\n.git/nexus-claims/FILE_cli_test_helpers_startup_permission_driver.py/owner.json\\n.git/nexus-claims/PLAN-12_INDEPENDENT_CLOSURE_REVIEW/owner.json\\n.git/nexus-claims/FILE_docs_reviews_evidence_v1-qualification_rc.3_terminal_installed-identity-20261024T0133Z/owner.json\\n.git/nexus-claims/FILE_cli_test_flight_exclude.test.ts/owner.json\\n.git/nexus-claims/PLAN-10_HOST_PREFLIGHT_CURRENT_SOURCE/owner.json\\n.git/nexus-claims/FILE_cli_test_inference_transport.test.ts/owner.json\\n.git/nexus-claims/archived/SUITE-node22-build58-20261022T223017Z/owner.json\\n.git/nexus-claims/archived/SUITE-pr61-1d402bf-full-cli-20261020T133040Z/owner.json\\n.git/nexus-claims/archived/FILE_cli_test_sandbox_quoting.test.ts-PR82-merged-20261021T0046/owner.json\\n.git/nexus-claims/archived/SUITE-node22-24cd-completed-reviewfix/owner.json\\n.git/nexus-claims/archived/SUITE-pr61-persistence-bb67f78-20261020T135420Z/owner.json\\n.git/nexus-claims/archived/REDACTED/owner.json\\n.git/nexus-claims/archived/SUITE-node22-58df-20261022T222908Z/owner.json\\n.git/nexus-claims/archived/FILE_core_src_runner.rs-merged-20261023T214913Z/owner.json\\n.git/nexus-claims/archived/RELEASE_PUBLISHER-stale-20261021T024912Z/owner.json\\n.git/nexus-claims/archived/pr89-claude-egress-test-20261020T221728Z/owner.json\\n.git/nexus-claims/archived/SUITE-pr61-convergence-baseline-20261020T142030Z/owner.json\\n.git/nexus-claims/archived/REDACTED/owner.json\\n.git/nexus-claims/archived/sandbox-pr82-merged-20261021T0046/owner.json\\n.git/nexus-claims/archived/QUAL_E2_ENVIRONMENT_BUILD-20261021T022901Z/owner.json\\n.git/nexus-claims/archived/SUITE-pr61-persistence-fix-20261020T134431Z/owner.json\\n.git/nexus-claims/archived/REDACTED/owner.json\\n.git/nexus-claims/archived/FILE_cli_test_authority.test.ts-stale-broken-20261023T1637Z/owner.json\\n.git/nexus-claims/archived/SUITE-root-node22-readiness-6of6-20261022T223534Z.json/owner.json\\n.git/nexus-claims/archived/FILE_core_Cargo.lock-PR130-merged-20261022T094500Z/owner.json\\n.git/nexus-claims/archived/REDACTED/owner.json\\n.git/nexus-claims/archived/RC4_NOTES_SECURITY_UPDATES_20261024_MERGED_20261024T022500Z/owner.json\\n.git/nexus-claims/archived/SUITE-codex-root-PR173-review-followup-20261023T210222Z/owner.json\\n.git/nexus-claims/archived/FILE_cli_test_parser_single_quote.test.ts-stale-broken-20261023T1620Z/owner.json\\n.git/nexus-claims/archived/FILE_docs_releases_v1.0.0-rc.4.md_MERGED_20261024T022500Z/owner.json\\n.git/nexus-claims/archived/REDACTED/owner.json\\n.git/nexus-claims/archived/SUITE-sandbox-argv-20261020T134645Z/owner.json\\n.git/nexus-claims/archived/REDACTED/owner.json\\n.git/nexus-claims/archived/REDACTED/owner.json\\n.git/nexus-claims/archived/FILE_docs_v1.0.0_READINESS.md-codex-api-root-recovered-20261021T1455Z/owner.json\\n.git/nexus-claims/archived/REDACTED/owner.json\\n.git/nexus-claims/archived/QUAL_E2_ENVIRONMENT_RECIPES-20261021T014523Z/owner.json\\n.git/nexus-claims/archived/SUITE-node22-e1ea80e-closed/owner.json\\n.git/nexus-claims/archived/REDACTED/owner.json\\n.git/nexus-claims/archived/SUITE-integration-39599999300-success-20261021T1303Z/owner.json\\n.git/nexus-claims/archived/GATEWAY-E5-rc3-openrouter-complete-20261023T221357Z/owner.json\\n.git/nexus-claims/archived/REDACTED/owner.json\\n.git/nexus-claims/archived/REDACTED/owner.json\\n.git/nexus-claims/archived/FILE_cli_src_core_authority.ts-stale-broken-20261023T1637Z/owner.json\\n.git/nexus-claims/archived/SUITE-pr61-v3n-umask-20261020T140430Z/owner.json\\n.git/nexus-claims/archived/SUITE-codex-root-PR173-20261023T205942Z/owner.json\\n.git/nexus-claims/archived/SUITE-pr100-head-ci-20261021T1229Z/owner.json\\n\"}"},{"type":"input_text","text":"RESULT 2\n"},{"type":"input_text","text":"{\"chunk_id\":\"958f60\",\"wall_time_seconds\":1.270734533,\"exit_code\":0,\"original_token_count\":530,\"output\":\"{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefOid\\\":\\\"1b43e5ac4d91551162d3550e77a9ccf9e330f1fd\\\",\\\"isDraft\\\":false,\\\"mergeStateStatus\\\":\\\"BLOCKED\\\",\\\"number\\\":215,\\\"state\\\":\\\"OPEN\\\",\\\"statusCheckRollup\\\":[{\\\"__typename\\\":\\\"CheckRun\\\",\\\"completedAt\\\":\\\"2026-10-25T09:35:06Z\\\",\\\"conclusion\\\":\\\"FAILURE\\\",\\\"detailsUrl\\\":\\\"https://github.com/mikeholownych/nexus-code/actions/runs/40179983377/job/121128786493\\\",\\\"name\\\":\\\"test-matrix (22)\\\",\\\"startedAt\\\":\\\"2026-10-25T09:16:52Z\\\",\\\"status\\\":\\\"COMPLETED\\\",\\\"workflowName\\\":\\\"CI\\\"},{\\\"__typename\\\":\\\"CheckRun\\\",\\\"completedAt\\\":\\\"2026-10-25T09:18:20Z\\\",\\\"conclusion\\\":\\\"SUCCESS\\\",\\\"detailsUrl\\\":\\\"https://github.com/mikeholownych/nexus-code/actions/runs/40179983378/job/121128786382\\\",\\\"name\\\":\\\"javascript-typescript\\\",\\\"startedAt\\\":\\\"2026-10-25T09:16:51Z\\\",\\\"status\\\":\\\"COMPLETED\\\",\\\"workflowName\\\":\\\"CodeQL\\\"},{\\\"__typename\\\":\\\"CheckRun\\\",\\\"completedAt\\\":\\\"2026-10-25T09:35:22Z\\\",\\\"conclusion\\\":\\\"FAILURE\\\",\\\"detailsUrl\\\":\\\"https://github.com/mikeholownych/nexus-code/actions/runs/40179983377/job/121128786318\\\",\\\"name\\\":\\\"test-matrix (24)\\\",\\\"startedAt\\\":\\\"2026-10-25T09:16:52Z\\\",\\\"status\\\":\\\"COMPLETED\\\",\\\"workflowName\\\":\\\"CI\\\"},{\\\"__typename\\\":\\\"CheckRun\\\",\\\"completedAt\\\":\\\"2026-10-25T09:35:22Z\\\",\\\"conclusion\\\":\\\"SKIPPED\\\",\\\"detailsUrl\\\":\\\"https://github.com/mikeholownych/nexus-code/actions/runs/40179983377/job/121132658740\\\",\\\"name\\\":\\\"linux-x86_64\\\",\\\"startedAt\\\":\\\"2026-10-25T09:35:22Z\\\",\\\"status\\\":\\\"COMPLETED\\\",\\\"workflowName\\\":\\\"CI\\\"},{\\\"__typename\\\":\\\"CheckRun\\\",\\\"completedAt\\\":\\\"2026-10-25T09:18:16Z\\\",\\\"conclusion\\\":\\\"SUCCESS\\\",\\\"detailsUrl\\\":\\\"https://github.com/mikeholownych/nexus-code/runs/121129062035\\\",\\\"name\\\":\\\"CodeQL\\\",\\\"startedAt\\\":\\\"2026-10-25T09:18:11Z\\\",\\\"status\\\":\\\"COMPLETED\\\",\\\"workflowName\\\":\\\"\\\"},{\\\"__typename\\\":\\\"StatusContext\\\",\\\"context\\\":\\\"CodeRabbit\\\",\\\"startedAt\\\":\\\"2026-10-25T09:25:40Z\\\",\\\"state\\\":\\\"SUCCESS\\\",\\\"targetUrl\\\":\\\"\\\"}],\\\"url\\\":\\\"https://github.com/mikeholownych/nexus-code/pull/215\\\"}\\n[{\\\"conclusion\\\":\\\"failure\\\",\\\"createdAt\\\":\\\"2026-10-25T09:16:50Z\\\",\\\"databaseId\\\":40179983377,\\\"headSha\\\":\\\"1b43e5ac4d91551162d3550e77a9ccf9e330f1fd\\\",\\\"name\\\":\\\"CI\\\",\\\"status\\\":\\\"completed\\\"},{\\\"conclusion\\\":\\\"success\\\",\\\"createdAt\\\":\\\"2026-10-25T09:16:49Z\\\",\\\"databaseId\\\":40179983378,\\\"headSha\\\":\\\"1b43e5ac4d91551162d3550e77a9ccf9e330f1fd\\\",\\\"name\\\":\\\"CodeQL\\\",\\\"status\\\":\\\"completed\\\"}]\\n\"}"},{"type":"input_text","text":"RESULT 3\n"},{"type":"input_text","text":"{\"chunk_id\":\"2c1451\",\"wall_time_seconds\":0.501183112,\"exit_code\":0,\"original_token_count\":89,\"output\":\"nexus-t4-pr215 on /mnt/nexus-eval-t4-pr215-1b43e5a type tmpfs (rw,relatime,size=131072k,mode=711,uid=1000,gid=1000,inode64)\\ndrwx--x--x  2 mike mike  40 Oct 25 05:39 /mnt/nexus-eval-t4-pr215-1b43e5a\\ndrwx------ 12 mike mike 620 Oct 25 05:39 /tmp/nexus-t4-pr215-1b43e5a\\ndrwxrwxr-x 29 mike mike 600 Oct 25 04:30 /tmp/nexus-t4-pr215-1b43e5a/cli/node_modules\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17267-b4a8-7073-9d2a-32da76e0ee35","create_time":1792921240.1476908}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
