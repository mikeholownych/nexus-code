d(b\"\\r\", label=\"Enter\"); s.pump(6); s.dump(\"after\")\n    print(\"D file:\", os.path.exists(ws + \"/hello.txt\"))\nfinally:\n=== s1_startup.py ===\nenv, ws, home = make_env(\"s1b\", \"\")\ndel env[\"LOCAL_LLM_ENDPOINT\"]\ns = Session([TUI, \"--live\", \"--sidecar\", SIDECAR, \"--node\", \"node\", \"--\", \"-w\", ws], env, 100, 30, ws, \"s1b\")\n=== s2_approval.py ===\n    s.wait(\"hello.txt\", 5, \"panel\"); s.dump(\"panel-after-typing\")\n    print(\"file exists after typing:\", os.path.exists(ws + \"/hello.txt\"))\n    s.send(b\"\\x1b[200~y\\ny\\nyes\\n\\x1b[201~\", label=\"bracketed paste y/Enter\")\n=== s3_complete.py ===\n    print(\"file:\", os.path.exists(ws + \"/hello.txt\"))\n    ok = s.wait(\"enter send\", 60, \"idle-after-turn\"); s.dump(\"after-turn\")\n    print(\"gw requests:\", len(gw_log(log)))\n=== s4_cancel.py ===\n    s.send(b\"\\x03\", label=\"Ctrl-C\"); s.pump(3); s.dump(\"after-ctrl-c\")\n    s.send(b\"again\\r\"); s.pump(2); s.send(b\"\\x1b\", label=\"Esc\"); s.pump(3); s.dump(\"after-esc\")\n    print(\"alive\", s.alive())\n=== s5_ctrlc.py ===\n    s.pump(2); s.dump(\"2s-after-ctrl-c\")\n    ok = s.wait(\"enter send\", 45, \"idle-after-ctrl-c\"); print(\"ctrl-c -> idle secs\", round(time.monotonic() - t, 2)); s.dump(\"idle-after-ctrl-c\")\nfinally:\n=== s6_steer_cancel.py ===\n    s.wait(\"enter send\", 60, \"idle\"); print(\"ctrl-c -> idle secs\", round(time.monotonic() - t, 2)); s.dump(\"idle\")\n    print(\"gw requests\", len(gw_log(log)))\nfinally:\n=== s6n.py ===\n    s.wait(\"enter send\", 60, \"idle\"); print(\"ctrl-c -> idle secs\", round(time.monotonic() - t, 2)); s.dump(\"idle\")\n    print(\"gw requests\", len(gw_log(log)))\nfinally:\n=== s7_resume.py ===\nfinally:\n    s.close()\ns = Session(tui_argv(ws, ep, extra=[\"-r\"]), env, 100, 30, ws, \"s7b\")\n=== s8_cancel_tool.py ===\n    print(\"before Esc:\\n\" + procs())\n    t = time.monotonic(); s.send(b\"\\x1b\", label=\"Esc during tool\"); s.pump(3); s.dump(\"3s-after-esc\"