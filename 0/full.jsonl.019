{"timestamp":"2026-10-25T08:52:13.559Z","ordinal":333311,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a1723f-d7c7-7d81-90fc-19d6aade9feb","item":{"type":"CommandExecution","id":"exec-eb6d9993-ddd9-45c2-9f42-0f6f72c152d5","process_id":"85413","command":["/usr/bin/zsh","-lc","sed -n '610,705p' cli/test/eval_integrity.test.ts; sed -n '1,180p' eval/resources.mjs; rg -n 'resource probe produced no containment report|resourceProbeProblem|spawnContained' eval/resources.mjs eval/cgroup_supervisor.mjs"],"cwd":"file:///home/mike/nexus-wt/plan10-pr10c-t4","parsed_cmd":[{"type":"read","cmd":"sed -n '610,705p' cli/test/eval_integrity.test.ts","name":"eval_integrity.test.ts","path":"cli/test/eval_integrity.test.ts"},{"type":"read","cmd":"sed -n '1,180p' eval/resources.mjs","name":"resources.mjs","path":"eval/resources.mjs"},{"type":"search","cmd":"rg -n 'resource probe produced no containment report|resourceProbeProblem|spawnContained' eval/resources.mjs eval/cgroup_supervisor.mjs","query":"resource probe produced no containment report|resourceProbeProblem|spawnContained","path":"resources.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"        `runtime preflight rejects mounted corpus path ${protectedPath}`,\n      );\n      assert.match(\n        hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: protectedPath }, mountContext }, tasks) ?? \"\",\n        /overlaps protected corpus material/,\n        `hidden-test qualification preflight rejects mounted corpus path ${protectedPath}`,\n      );\n      assert.throws(() => agentSandboxArgv({\n        cwd: runtimeRoot,\n        home,\n        proxyDirectory,\n        readOnlyPaths: [readOnlyRuntime],\n        supervisorPath,\n        protectedCorpusPaths: [protectedPath],\n      }), /overlaps protected corpus material/);\n      if (unconditionalMountPaths.includes(protectedPath)) {\n        // This check precedes Bubblewrap availability, including on minimal CI hosts.\n        assert.throws(() => isolatedArgv({ cwd: runtimeRoot, command: \"true\", protectedCorpusPaths: [protectedPath] }), /overlaps protected corpus material/);\n      }\n    }\n    assert.match(\n      runtimeCorpusOverlapProblem([], [\"/usr/bin\"], tasks, [path.join(\"/usr/bin\", \"synthetic-corpus-subdir\")]) ?? \"\",\n      /overlaps protected corpus material/,\n      \"a runtime allowlist root below an unconditional system mount is rejected\",\n    );\n    assert.match(\n      runtimeCorpusOverlapProblem([readOnlyRuntime], [], tasks, [readOnlyRuntime], mountContext) ?? \"\",\n      /overlaps protected corpus material/,\n      \"an explicit read-only runtime source is checked against the corpus\",\n    );\n    assert.match(\n      hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [readOnlyRuntime], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: readOnlyRuntime }, mountContext }, tasks) ?? \"\",\n      /overlaps protected corpus material/,\n      \"hidden-test preflight checks explicit read-only runtime sources\",\n    );\n    const custodyReportPath = readOnlyRuntime;\n    assert.match(hiddenTestIsolationProblem({\n      qualification: true,\n      runAs: \"nexus-eval\",\n      sandboxRuntimePaths: [readOnlyRuntime],\n      sandboxRuntimeRoots: [runtimeRoot],\n      corpusCustody: { reportPath: custodyReportPath },\n      mountContext,\n    }, tasks) ?? \"\", /overlaps protected corpus material/);\n    assert.throws(() => agentSandboxArgv({\n      cwd: runtimeRoot,\n      home,\n      proxyDirectory,\n      readOnlyPaths: [readOnlyRuntime],\n      supervisorPath,\n      protectedCorpusPaths: [custodyReportPath],\n    }), /overlaps protected corpus material/);\n  } finally {\n    fs.rmSync(root, { recursive: true, force: true });\n  }\n});\n\ntest(\"qualification remains fail-closed without enforced aggregate resource controls\", async () => {\n  const { qualificationResourceIsolationProblem } = await import(path.join(ROOT, \"eval/validate.mjs\"));\n  const { dedicatedTmpfsMountProblem } = await import(path.join(ROOT, \"eval/resources.mjs\"));\n  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \"/dev/shm\";\n  const tmpfs = fs.statfsSync(workspaceRoot);\n  const ok = { cpuPercent: 100, memoryBytes: 256 * 1024 * 1024, tasks: 64, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\n  const shared = fs.statfsSync(\"/dev/shm\");\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: \"/dev/shm\", storageBytes: shared.blocks * shared.bsize } }) ?? \"\", /dedicated tmpfs|exact mount point/);\n  assert.match(qualificationResourceIsolationProblem(), /enforced CPU, memory, process-count, and workspace-storage limits/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: ROOT } }) ?? \"\", /tmpfs/);\n  const nested = fs.mkdtempSync(path.join(workspaceRoot, \"nested-\"));\n  try {\n    assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: nested } }) ?? \"\", /exact mount point/);\n  } finally {\n    fs.rmdirSync(nested);\n  }\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, memoryBytes: 1024 } }) ?? \"\", /memoryBytes/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, tasks: 0 } }) ?? \"\", /tasks/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, cpuPercent: 1.5 } }) ?? \"\", /cpuPercent/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, memoryBytes: 256 * 1024 * 1024 + 1 } }) ?? \"\", /multiple of 4096/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, storageBytes: ok.storageBytes - 4096 } }) ?? \"\", /tmpfs with size<=storageBytes|owner-accessible/);\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, storageBytes: undefined } }) ?? \"\", /storageBytes/);\n  const isolation = qualificationResourceIsolationProblem({ resources: ok });\n  if (process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) assert.equal(isolation, null, \"the dedicated test tmpfs and kernel resource contract must pass preflight\");\n  else assert.match(isolation ?? \"\", /dedicated tmpfs|exact mount point/, \"a shared /dev/shm must fail qualification preflight\");\n  if (process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) {\n    // CI mounts the capped workspace as 0711 (owner rwx, other --x). Mode probes must restore\n    // that contract so later runAs / version-probe suites can still traverse as the evaluator.\n    const restoreMode = 0o711;\n    fs.chmodSync(workspaceRoot, 0o755);\n    try {\n      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \"\", /non-readable\\/non-writable by group or other/);\n    } finally {\n      fs.chmodSync(workspaceRoot, restoreMode);\n    }\n    assert.equal(qualificationResourceIsolationProblem({ resources: ok }), null, \"restored dedicated mount root must pass preflight\");\n    fs.chmodSync(workspaceRoot, 0o731);\n    try {\n      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \"\", /non-readable\\/non-writable by group or other/);\n// Kernel-enforced resource contract for task-controlled executions (eval/README.md, \"Resource contract\").\n// Each execution runs in its own delegated transient systemd --user scope under eval/cgroup_supervisor.mjs, which\n// applies cgroup v2 cpu.max, memory.max (swap 0) and pids.max to a payload leaf, verifies them, and kills the whole\n// cgroup afterwards. Workspaces and homes live on a dedicated size-capped tmpfs (storageBytes): that cap bounds\n// everything a run keeps on disk across phases, and each phase's writes are additionally charged to its memory.max.\nimport { spawn, spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst SYSTEMD_RUN = \"/usr/bin/systemd-run\";\nconst SUPERVISOR = fileURLToPath(new URL(\"./cgroup_supervisor.mjs\", import.meta.url));\nconst TMPFS_MAGIC = 0x01021994;\n\n/** Null when `resources` is a complete, sane contract; otherwise why it is not. */\nexport function resourceConfigProblem(resources) {\n  if (!resources || typeof resources !== \"object\") return \"resources must set cpuPercent, memoryBytes, tasks, storageBytes and workspaceRoot\";\n  const { cpuPercent, memoryBytes, tasks, storageBytes, workspaceRoot } = resources;\n  if (!Number.isInteger(cpuPercent) || cpuPercent < 10 || cpuPercent > 100 * 1024) return \"resources.cpuPercent must be an integer from 10 to 102400\";\n  if (!Number.isInteger(memoryBytes) || memoryBytes < 64 * 1024 * 1024 || memoryBytes % 4096 !== 0) return \"resources.memoryBytes must be a multiple of 4096 of at least 64 MiB\";\n  if (!Number.isInteger(tasks) || tasks < 8 || tasks > 1 << 20) return \"resources.tasks must be an integer from 8 to 1048576\";\n  if (!Number.isInteger(storageBytes) || storageBytes < 64 * 1024 * 1024) return \"resources.storageBytes must be an integer of at least 64 MiB\";\n  if (typeof workspaceRoot !== \"string\" || !path.isAbsolute(workspaceRoot)) return \"resources.workspaceRoot must be an absolute path\";\n  let stat;\n  try { stat = fs.statfsSync(workspaceRoot); }\n  catch { return \"resources.workspaceRoot is unavailable\"; }\n  if (stat.type !== TMPFS_MAGIC) return \"resources.workspaceRoot must be on a tmpfs so candidate writes are charged to the run's memory limit\";\n  const mountProblem = dedicatedTmpfsMountProblem(workspaceRoot);\n  if (mountProblem) return mountProblem;\n  if (stat.blocks * stat.bsize > storageBytes) return `resources.workspaceRoot tmpfs is ${stat.blocks * stat.bsize} bytes; mount a dedicated tmpfs with size<=storageBytes (${storageBytes})`;\n  return null;\n}\n\n/** A subdirectory of a shared tmpfs (including /dev/shm) does not enforce a per-run storage cap. */\nexport function dedicatedTmpfsMountProblem(workspaceRoot, mountInfoText = null) {\n  let lines;\n  try { lines = (mountInfoText ?? fs.readFileSync(\"/proc/self/mountinfo\", \"utf8\")).split(\"\\n\"); }\n  catch { return \"resources.workspaceRoot mount table is unavailable; refusing unverified workspace storage limits\"; }\n  const decode = (value) => value.replace(/\\\\([0-7]{3})/g, (_match, octal) => String.fromCharCode(Number.parseInt(octal, 8)));\n  const expected = path.resolve(workspaceRoot);\n  const matching = lines.filter((entry) => {\n    const fields = entry.split(\" \");\n    return fields.length > 6 && decode(fields[4]) === expected;\n  });\n  if (matching.length > 1) return \"resources.workspaceRoot has stacked or duplicate mount records; refusing ambiguous workspace storage boundary\";\n  const line = matching[0];\n  if (!line) return \"resources.workspaceRoot must be the exact mount point of a dedicated tmpfs, not a subdirectory\";\n  const fields = line.split(\" \");\n  const separator = fields.indexOf(\"-\");\n  if (separator < 0 || fields[separator + 1] !== \"tmpfs\" || decode(fields[3]) !== \"/\") {\n    return \"resources.workspaceRoot must be its own tmpfs mount, not a shared or bind-mounted filesystem\";\n  }\n  // A bind mount of a tmpfs root retains the same major:minor and root fields. Reject aliases of\n  // this mount so an apparently dedicated path cannot expose a tmpfs shared at another path.\n  const device = fields[2];\n  const aliases = lines.filter((entry) => {\n    const other = entry.split(\" \");\n    return other.length > 6 && other[2] === device && decode(other[4]) !== expected;\n  });\n  if (aliases.length > 0) return \"resources.workspaceRoot tmpfs is also mounted elsewhere; bind/shared mounts are not allowed\";\n  const options = `${fields[5]},${fields[separator + 3] ?? \"\"}`.split(\",\");\n  const mode = options.find((option) => option.startsWith(\"mode=\"))?.slice(5);\n  const uid = options.find((option) => option.startsWith(\"uid=\"))?.slice(4);\n  const mountMode = mode ? Number.parseInt(mode, 8) : null;\n  if (mountMode === null || (mountMode & 0o700) !== 0o700 || (mountMode & 0o066) !== 0 || uid !== String(process.getuid())) {\n    return \"dedicated tmpfs must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\";\n  }\n  let rootStat;\n  try { rootStat = fs.statSync(expected); }\n  catch { return \"resources.workspaceRoot mount root cannot be inspected; refusing unverified workspace permissions\"; }\n  const rootMode = rootStat.mode & 0o777;\n  if (rootStat.uid !== process.getuid() || (rootMode & 0o700) !== 0o700 || (rootMode & 0o066) !== 0) {\n    return \"dedicated tmpfs effective mount root must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\";\n  }\n  return null;\n}\n\n/** Null when a contained probe proves this host applies and cleans up the contract; otherwise the failure. */\nexport function resourceProbeProblem(resources) {\n  const configProblem = resourceConfigProblem(resources);\n  if (configProblem) return configProblem;\n  let wrapped;\n  try { wrapped = containedSpec({ cmd: \"/usr/bin/true\", argv: [] }, resources); }\n  catch (error) { return error.message; }\n  const result = spawnSync(wrapped.cmd, wrapped.argv, { cwd: \"/\", env: wrapped.env, stdio: [\"ignore\", \"ignore\", \"pipe\", \"pipe\"], timeout: 15_000, encoding: \"utf8\" });\n  const final = parseReports(result.output?.[3] ?? \"\").final;\n  if (!final) return `resource probe produced no containment report (${result.error?.message ?? `exit ${result.status}`}: ${(result.stderr ?? \"\").trim().slice(-300)})`;\n  if (final.error || !final.cleaned) return `resource probe failed: ${final.error ?? \"payload not cleaned\"}`;\n  if (final.exitCode !== 0) return `resource probe command exited ${final.exitCode}`;\n  return null;\n}\n\n/** The command line that runs `spec` under the supervisor in a fresh scope with `resources` applied. */\nexport function containedSpec(spec, resources) {\n  const { XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS } = process.env;\n  if (!XDG_RUNTIME_DIR) throw new Error(\"resource containment needs the systemd user manager (XDG_RUNTIME_DIR is unset)\");\n  if (!fs.existsSync(SYSTEMD_RUN)) throw new Error(\"resource containment needs systemd-run\");\n  const limits = { cpuPercent: resources.cpuPercent, memoryBytes: resources.memoryBytes, tasks: resources.tasks };\n  return {\n    cmd: SYSTEMD_RUN,\n    argv: [\"--user\", \"--scope\", \"--quiet\", \"--collect\", \"-p\", \"Delegate=yes\", \"--\", process.execPath, SUPERVISOR, JSON.stringify({ limits, cmd: spec.cmd, argv: spec.argv })],\n    env: { XDG_RUNTIME_DIR, ...(DBUS_SESSION_BUS_ADDRESS ? { DBUS_SESSION_BUS_ADDRESS } : {}) },\n    timeoutMs: spec.timeoutMs,\n  };\n}\n\n/**\n * Spawn `spec` (contained when `resources` is set). `containment.kill()` empties the payload cgroup;\n * `containment.final` resolves to the supervisor's last report, or null when it never reported.\n */\nexport function spawnContained(spec, resources, { stdio, ...options }) {\n  if (!resources) return { child: spawn(spec.cmd, spec.argv, { ...options, stdio, env: options.env ?? {} }), containment: null };\n  const wrapped = containedSpec(spec, resources);\n  const child = spawn(wrapped.cmd, wrapped.argv, { ...options, env: wrapped.env, stdio: [...stdio, \"pipe\", \"pipe\"] });\n  const control = child.stdio[4];\n  let text = \"\";\n  let cgroup = null;\n  const final = new Promise((resolve) => {\n    child.stdio[3].on(\"data\", (chunk) => {\n      text += chunk.toString(\"utf8\");\n      const reports = parseReports(text);\n      cgroup ??= reports.cgroup;\n      // Close the supervisor's control pipe after its final report. Otherwise the parent write end can\n      // keep ChildProcess's `close` event pending even though the supervised command and scope have exited.\n      if (reports.final && control && !control.destroyed) control.end();\n    });\n    child.stdio[3].on(\"close\", () => resolve(parseReports(text).final));\n    child.on(\"error\", () => resolve(null));\n  });\n  const signal = (name, graceMs = 5000) => {\n    if (name !== \"SIGTERM\" || !Number.isSafeInteger(graceMs) || graceMs < 0 || graceMs > 30_000) {\n      throw new Error(\"contained payload supports SIGTERM with a grace period from 0 to 30000 ms\");\n    }\n    if (!control || control.destroyed || !control.writable) return false;\n    return control.write(`${JSON.stringify({ type: \"signal\", name, graceMs })}\\n`);\n  };\n  let repeat = null;\n  let fallback = null;\n  const killPayload = () => { if (cgroup) { try { fs.writeFileSync(path.join(cgroup, \"cgroup.kill\"), \"1\"); } catch {} } };\n  const kill = () => {\n    if (repeat) return;\n    // The payload may not have joined its leaf yet, or may fork after a kill: keep emptying the leaf until the\n    // supervisor exits. The supervisor also stops on SIGTERM. One that does not exit loses its report, so the run fails\n    // on containmentProblem; the fallback then kills the supervisor while the repeat keeps emptying the payload leaf.\n    killPayload();\n    try { process.kill(child.pid, \"SIGTERM\"); } catch {}\n    repeat = setInterval(killPayload, 50);\n    fallback = setTimeout(() => { try { process.kill(-child.pid, \"SIGKILL\"); } catch {} }, 10_000);\n    setTimeout(() => clearInterval(repeat), 30_000).unref();\n  };\n  child.on(\"close\", () => { clearInterval(repeat); clearTimeout(fallback); killPayload(); });\n  return { child, containment: { final, kill, signal } };\n}\n\n/** Why a finished contained execution cannot be trusted as bounded, or null. */\nexport function containmentProblem(final) {\n  if (!final) return \"no containment report from the resource supervisor\";\n  if (final.error) return final.error;\n  if (!final.cleaned) return \"payload cgroup was not emptied\";\n  return null;\n}\n\nfunction parseReports(text) {\n  let cgroup = null;\n  let final = null;\n  for (const line of text.split(\"\\n\")) {\n    if (!line.trim()) continue;\n    let value;\n    try { value = JSON.parse(line); } catch { continue; }\n    if (value.cgroup && Object.keys(value).length === 1) cgroup = value.cgroup;\n    else final = value;\n  }\n  return { cgroup, final };\n}\neval/resources.mjs:79:export function resourceProbeProblem(resources) {\neval/resources.mjs:87:  if (!final) return `resource probe produced no containment report (${result.error?.message ?? `exit ${result.status}`}: ${(result.stderr ?? \"\").trim().slice(-300)})`;\neval/resources.mjs:111:export function spawnContained(spec, resources, { stdio, ...options }) {\n","exit_code":0,"duration":{"secs":0,"nanos":901309422}},"started_at_ms":1792918332657,"completed_at_ms":1792918333559}}
{"timestamp":"2026-10-25T08:52:14.622Z","ordinal":333312,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17242-ac9e-7b73-9873-a2b62a1047f1","call_id":"call_5f51bc1c20174c31bb0a88682d7f4f78","output":[{"type":"input_text","text":"Script completed\nWall time 3.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"57c7e8\",\"wall_time_seconds\":0.901795873,\"exit_code\":0,\"original_token_count\":4246,\"output\":\"        `runtime preflight rejects mounted corpus path ${protectedPath}`,\\n      );\\n      assert.match(\\n        hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: protectedPath }, mountContext }, tasks) ?? \\\"\\\",\\n        /overlaps protected corpus material/,\\n        `hidden-test qualification preflight rejects mounted corpus path ${protectedPath}`,\\n      );\\n      assert.throws(() => agentSandboxArgv({\\n        cwd: runtimeRoot,\\n        home,\\n        proxyDirectory,\\n        readOnlyPaths: [readOnlyRuntime],\\n        supervisorPath,\\n        protectedCorpusPaths: [protectedPath],\\n      }), /overlaps protected corpus material/);\\n      if (unconditionalMountPaths.includes(protectedPath)) {\\n        // This check precedes Bubblewrap availability, including on minimal CI hosts.\\n        assert.throws(() => isolatedArgv({ cwd: runtimeRoot, command: \\\"true\\\", protectedCorpusPaths: [protectedPath] }), /overlaps protected corpus material/);\\n      }\\n    }\\n    assert.match(\\n      runtimeCorpusOverlapProblem([], [\\\"/usr/bin\\\"], tasks, [path.join(\\\"/usr/bin\\\", \\\"synthetic-corpus-subdir\\\")]) ?? \\\"\\\",\\n      /overlaps protected corpus material/,\\n      \\\"a runtime allowlist root below an unconditional system mount is rejected\\\",\\n    );\\n    assert.match(\\n      runtimeCorpusOverlapProblem([readOnlyRuntime], [], tasks, [readOnlyRuntime], mountContext) ?? \\\"\\\",\\n      /overlaps protected corpus material/,\\n      \\\"an explicit read-only runtime source is checked against the corpus\\\",\\n    );\\n    assert.match(\\n      hiddenTestIsolationProblem({ qualification: true, sandboxRuntimePaths: [readOnlyRuntime], sandboxRuntimeRoots: [], corpusCustody: { storeRoot: readOnlyRuntime }, mountContext }, tasks) ?? \\\"\\\",\\n      /overlaps protected corpus material/,\\n      \\\"hidden-test preflight checks explicit read-only runtime sources\\\",\\n    );\\n    const custodyReportPath = readOnlyRuntime;\\n    assert.match(hiddenTestIsolationProblem({\\n      qualification: true,\\n      runAs: \\\"nexus-eval\\\",\\n      sandboxRuntimePaths: [readOnlyRuntime],\\n      sandboxRuntimeRoots: [runtimeRoot],\\n      corpusCustody: { reportPath: custodyReportPath },\\n      mountContext,\\n    }, tasks) ?? \\\"\\\", /overlaps protected corpus material/);\\n    assert.throws(() => agentSandboxArgv({\\n      cwd: runtimeRoot,\\n      home,\\n      proxyDirectory,\\n      readOnlyPaths: [readOnlyRuntime],\\n      supervisorPath,\\n      protectedCorpusPaths: [custodyReportPath],\\n    }), /overlaps protected corpus material/);\\n  } finally {\\n    fs.rmSync(root, { recursive: true, force: true });\\n  }\\n});\\n\\ntest(\\\"qualification remains fail-closed without enforced aggregate resource controls\\\", async () => {\\n  const { qualificationResourceIsolationProblem } = await import(path.join(ROOT, \\\"eval/validate.mjs\\\"));\\n  const { dedicatedTmpfsMountProblem } = await import(path.join(ROOT, \\\"eval/resources.mjs\\\"));\\n  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT ?? \\\"/dev/shm\\\";\\n  const tmpfs = fs.statfsSync(workspaceRoot);\\n  const ok = { cpuPercent: 100, memoryBytes: 256 * 1024 * 1024, tasks: 64, storageBytes: tmpfs.blocks * tmpfs.bsize, workspaceRoot };\\n  const shared = fs.statfsSync(\\\"/dev/shm\\\");\\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: \\\"/dev/shm\\\", storageBytes: shared.blocks * shared.bsize } }) ?? \\\"\\\", /dedicated tmpfs|exact mount point/);\\n  assert.match(qualificationResourceIsolationProblem(), /enforced CPU, memory, process-count, and workspace-storage limits/);\\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: ROOT } }) ?? \\\"\\\", /tmpfs/);\\n  const nested = fs.mkdtempSync(path.join(workspaceRoot, \\\"nested-\\\"));\\n  try {\\n    assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, workspaceRoot: nested } }) ?? \\\"\\\", /exact mount point/);\\n  } finally {\\n    fs.rmdirSync(nested);\\n  }\\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, memoryBytes: 1024 } }) ?? \\\"\\\", /memoryBytes/);\\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, tasks: 0 } }) ?? \\\"\\\", /tasks/);\\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, cpuPercent: 1.5 } }) ?? \\\"\\\", /cpuPercent/);\\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, memoryBytes: 256 * 1024 * 1024 + 1 } }) ?? \\\"\\\", /multiple of 4096/);\\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, storageBytes: ok.storageBytes - 4096 } }) ?? \\\"\\\", /tmpfs with size<=storageBytes|owner-accessible/);\\n  assert.match(qualificationResourceIsolationProblem({ resources: { ...ok, storageBytes: undefined } }) ?? \\\"\\\", /storageBytes/);\\n  const isolation = qualificationResourceIsolationProblem({ resources: ok });\\n  if (process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) assert.equal(isolation, null, \\\"the dedicated test tmpfs and kernel resource contract must pass preflight\\\");\\n  else assert.match(isolation ?? \\\"\\\", /dedicated tmpfs|exact mount point/, \\\"a shared /dev/shm must fail qualification preflight\\\");\\n  if (process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT) {\\n    // CI mounts the capped workspace as 0711 (owner rwx, other --x). Mode probes must restore\\n    // that contract so later runAs / version-probe suites can still traverse as the evaluator.\\n    const restoreMode = 0o711;\\n    fs.chmodSync(workspaceRoot, 0o755);\\n    try {\\n      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \\\"\\\", /non-readable\\\\/non-writable by group or other/);\\n    } finally {\\n      fs.chmodSync(workspaceRoot, restoreMode);\\n    }\\n    assert.equal(qualificationResourceIsolationProblem({ resources: ok }), null, \\\"restored dedicated mount root must pass preflight\\\");\\n    fs.chmodSync(workspaceRoot, 0o731);\\n    try {\\n      assert.match(qualificationResourceIsolationProblem({ resources: ok }) ?? \\\"\\\", /non-readable\\\\/non-writable by group or other/);\\n// Kernel-enforced resource contract for task-controlled executions (eval/README.md, \\\"Resource contract\\\").\\n// Each execution runs in its own delegated transient systemd --user scope under eval/cgroup_supervisor.mjs, which\\n// applies cgroup v2 cpu.max, memory.max (swap 0) and pids.max to a payload leaf, verifies them, and kills the whole\\n// cgroup afterwards. Workspaces and homes live on a dedicated size-capped tmpfs (storageBytes): that cap bounds\\n// everything a run keeps on disk across phases, and each phase's writes are additionally charged to its memory.max.\\nimport { spawn, spawnSync } from \\\"node:child_process\\\";\\nimport fs from \\\"node:fs\\\";\\nimport path from \\\"node:path\\\";\\nimport { fileURLToPath } from \\\"node:url\\\";\\n\\nconst SYSTEMD_RUN = \\\"/usr/bin/systemd-run\\\";\\nconst SUPERVISOR = fileURLToPath(new URL(\\\"./cgroup_supervisor.mjs\\\", import.meta.url));\\nconst TMPFS_MAGIC = 0x01021994;\\n\\n/** Null when `resources` is a complete, sane contract; otherwise why it is not. */\\nexport function resourceConfigProblem(resources) {\\n  if (!resources || typeof resources !== \\\"object\\\") return \\\"resources must set cpuPercent, memoryBytes, tasks, storageBytes and workspaceRoot\\\";\\n  const { cpuPercent, memoryBytes, tasks, storageBytes, workspaceRoot } = resources;\\n  if (!Number.isInteger(cpuPercent) || cpuPercent < 10 || cpuPercent > 100 * 1024) return \\\"resources.cpuPercent must be an integer from 10 to 102400\\\";\\n  if (!Number.isInteger(memoryBytes) || memoryBytes < 64 * 1024 * 1024 || memoryBytes % 4096 !== 0) return \\\"resources.memoryBytes must be a multiple of 4096 of at least 64 MiB\\\";\\n  if (!Number.isInteger(tasks) || tasks < 8 || tasks > 1 << 20) return \\\"resources.tasks must be an integer from 8 to 1048576\\\";\\n  if (!Number.isInteger(storageBytes) || storageBytes < 64 * 1024 * 1024) return \\\"resources.storageBytes must be an integer of at least 64 MiB\\\";\\n  if (typeof workspaceRoot !== \\\"string\\\" || !path.isAbsolute(workspaceRoot)) return \\\"resources.workspaceRoot must be an absolute path\\\";\\n  let stat;\\n  try { stat = fs.statfsSync(workspaceRoot); }\\n  catch { return \\\"resources.workspaceRoot is unavailable\\\"; }\\n  if (stat.type !== TMPFS_MAGIC) return \\\"resources.workspaceRoot must be on a tmpfs so candidate writes are charged to the run's memory limit\\\";\\n  const mountProblem = dedicatedTmpfsMountProblem(workspaceRoot);\\n  if (mountProblem) return mountProblem;\\n  if (stat.blocks * stat.bsize > storageBytes) return `resources.workspaceRoot tmpfs is ${stat.blocks * stat.bsize} bytes; mount a dedicated tmpfs with size<=storageBytes (${storageBytes})`;\\n  return null;\\n}\\n\\n/** A subdirectory of a shared tmpfs (including /dev/shm) does not enforce a per-run storage cap. */\\nexport function dedicatedTmpfsMountProblem(workspaceRoot, mountInfoText = null) {\\n  let lines;\\n  try { lines = (mountInfoText ?? fs.readFileSync(\\\"/proc/self/mountinfo\\\", \\\"utf8\\\")).split(\\\"\\\\n\\\"); }\\n  catch { return \\\"resources.workspaceRoot mount table is unavailable; refusing unverified workspace storage limits\\\"; }\\n  const decode = (value) => value.replace(/\\\\\\\\([0-7]{3})/g, (_match, octal) => String.fromCharCode(Number.parseInt(octal, 8)));\\n  const expected = path.resolve(workspaceRoot);\\n  const matching = lines.filter((entry) => {\\n    const fields = entry.split(\\\" \\\");\\n    return fields.length > 6 && decode(fields[4]) === expected;\\n  });\\n  if (matching.length > 1) return \\\"resources.workspaceRoot has stacked or duplicate mount records; refusing ambiguous workspace storage boundary\\\";\\n  const line = matching[0];\\n  if (!line) return \\\"resources.workspaceRoot must be the exact mount point of a dedicated tmpfs, not a subdirectory\\\";\\n  const fields = line.split(\\\" \\\");\\n  const separator = fields.indexOf(\\\"-\\\");\\n  if (separator < 0 || fields[separator + 1] !== \\\"tmpfs\\\" || decode(fields[3]) !== \\\"/\\\") {\\n    return \\\"resources.workspaceRoot must be its own tmpfs mount, not a shared or bind-mounted filesystem\\\";\\n  }\\n  // A bind mount of a tmpfs root retains the same major:minor and root fields. Reject aliases of\\n  // this mount so an apparently dedicated path cannot expose a tmpfs shared at another path.\\n  const device = fields[2];\\n  const aliases = lines.filter((entry) => {\\n    const other = entry.split(\\\" \\\");\\n    return other.length > 6 && other[2] === device && decode(other[4]) !== expected;\\n  });\\n  if (aliases.length > 0) return \\\"resources.workspaceRoot tmpfs is also mounted elsewhere; bind/shared mounts are not allowed\\\";\\n  const options = `${fields[5]},${fields[separator + 3] ?? \\\"\\\"}`.split(\\\",\\\");\\n  const mode = options.find((option) => option.startsWith(\\\"mode=\\\"))?.slice(5);\\n  const uid = options.find((option) => option.startsWith(\\\"uid=\\\"))?.slice(4);\\n  const mountMode = mode ? Number.parseInt(mode, 8) : null;\\n  if (mountMode === null || (mountMode & 0o700) !== 0o700 || (mountMode & 0o066) !== 0 || uid !== String(process.getuid())) {\\n    return \\\"dedicated tmpfs must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\\\";\\n  }\\n  let rootStat;\\n  try { rootStat = fs.statSync(expected); }\\n  catch { return \\\"resources.workspaceRoot mount root cannot be inspected; refusing unverified workspace permissions\\\"; }\\n  const rootMode = rootStat.mode & 0o777;\\n  if (rootStat.uid !== process.getuid() || (rootMode & 0o700) !== 0o700 || (rootMode & 0o066) !== 0) {\\n    return \\\"dedicated tmpfs effective mount root must be owner-accessible, non-readable/non-writable by group or other, and owned by the evaluator harness uid\\\";\\n  }\\n  return null;\\n}\\n\\n/** Null when a contained probe proves this host applies and cleans up the contract; otherwise the failure. */\\nexport function resourceProbeProblem(resources) {\\n  const configProblem = resourceConfigProblem(resources);\\n  if (configProblem) return configProblem;\\n  let wrapped;\\n  try { wrapped = containedSpec({ cmd: \\\"/usr/bin/true\\\", argv: [] }, resources); }\\n  catch (error) { return error.message; }\\n  const result = spawnSync(wrapped.cmd, wrapped.argv, { cwd: \\\"/\\\", env: wrapped.env, stdio: [\\\"ignore\\\", \\\"ignore\\\", \\\"pipe\\\", \\\"pipe\\\"], timeout: 15_000, encoding: \\\"utf8\\\" });\\n  const final = parseReports(result.output?.[3] ?? \\\"\\\").final;\\n  if (!final) return `resource probe produced no containment report (${result.error?.message ?? `exit ${result.status}`}: ${(result.stderr ?? \\\"\\\").trim().slice(-300)})`;\\n  if (final.error || !final.cleaned) return `resource probe failed: ${final.error ?? \\\"payload not cleaned\\\"}`;\\n  if (final.exitCode !== 0) return `resource probe command exited ${final.exitCode}`;\\n  return null;\\n}\\n\\n/** The command line that runs `spec` under the supervisor in a fresh scope with `resources` applied. */\\nexport function containedSpec(spec, resources) {\\n  const { XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS } = process.env;\\n  if (!XDG_RUNTIME_DIR) throw new Error(\\\"resource containment needs the systemd user manager (XDG_RUNTIME_DIR is unset)\\\");\\n  if (!fs.existsSync(SYSTEMD_RUN)) throw new Error(\\\"resource containment needs systemd-run\\\");\\n  const limits = { cpuPercent: resources.cpuPercent, memoryBytes: resources.memoryBytes, tasks: resources.tasks };\\n  return {\\n    cmd: SYSTEMD_RUN,\\n    argv: [\\\"--user\\\", \\\"--scope\\\", \\\"--quiet\\\", \\\"--collect\\\", \\\"-p\\\", \\\"Delegate=yes\\\", \\\"--\\\", process.execPath, SUPERVISOR, JSON.stringify({ limits, cmd: spec.cmd, argv: spec.argv })],\\n    env: { XDG_RUNTIME_DIR, ...(DBUS_SESSION_BUS_ADDRESS ? { DBUS_SESSION_BUS_ADDRESS } : {}) },\\n    timeoutMs: spec.timeoutMs,\\n  };\\n}\\n\\n/**\\n * Spawn `spec` (contained when `resources` is set). `containment.kill()` empties the payload cgroup;\\n * `containment.final` resolves to the supervisor's last report, or null when it never reported.\\n */\\nexport function spawnContained(spec, resources, { stdio, ...options }) {\\n  if (!resources) return { child: spawn(spec.cmd, spec.argv, { ...options, stdio, env: options.env ?? {} }), containment: null };\\n  const wrapped = containedSpec(spec, resources);\\n  const child = spawn(wrapped.cmd, wrapped.argv, { ...options, env: wrapped.env, stdio: [...stdio, \\\"pipe\\\", \\\"pipe\\\"] });\\n  const control = child.stdio[4];\\n  let text = \\\"\\\";\\n  let cgroup = null;\\n  const final = new Promise((resolve) => {\\n    child.stdio[3].on(\\\"data\\\", (chunk) => {\\n      text += chunk.toString(\\\"utf8\\\");\\n      const reports = parseReports(text);\\n      cgroup ??= reports.cgroup;\\n      // Close the supervisor's control pipe after its final report. Otherwise the parent write end can\\n      // keep ChildProcess's `close` event pending even though the supervised command and scope have exited.\\n      if (reports.final && control && !control.destroyed) control.end();\\n    });\\n    child.stdio[3].on(\\\"close\\\", () => resolve(parseReports(text).final));\\n    child.on(\\\"error\\\", () => resolve(null));\\n  });\\n  const signal = (name, graceMs = 5000) => {\\n    if (name !== \\\"SIGTERM\\\" || !Number.isSafeInteger(graceMs) || graceMs < 0 || graceMs > 30_000) {\\n      throw new Error(\\\"contained payload supports SIGTERM with a grace period from 0 to 30000 ms\\\");\\n    }\\n    if (!control || control.destroyed || !control.writable) return false;\\n    return control.write(`${JSON.stringify({ type: \\\"signal\\\", name, graceMs })}\\\\n`);\\n  };\\n  let repeat = null;\\n  let fallback = null;\\n  const killPayload = () => { if (cgroup) { try { fs.writeFileSync(path.join(cgroup, \\\"cgroup.kill\\\"), \\\"1\\\"); } catch {} } };\\n  const kill = () => {\\n    if (repeat) return;\\n    // The payload may not have joined its leaf yet, or may fork after a kill: keep emptying the leaf until the\\n    // supervisor exits. The supervisor also stops on SIGTERM. One that does not exit loses its report, so the run fails\\n    // on containmentProblem; the fallback then kills the supervisor while the repeat keeps emptying the payload leaf.\\n    killPayload();\\n    try { process.kill(child.pid, \\\"SIGTERM\\\"); } catch {}\\n    repeat = setInterval(killPayload, 50);\\n    fallback = setTimeout(() => { try { process.kill(-child.pid, \\\"SIGKILL\\\"); } catch {} }, 10_000);\\n    setTimeout(() => clearInterval(repeat), 30_000).unref();\\n  };\\n  child.on(\\\"close\\\", () => { clearInterval(repeat); clearTimeout(fallback); killPayload(); });\\n  return { child, containment: { final, kill, signal } };\\n}\\n\\n/** Why a finished contained execution cannot be trusted as bounded, or null. */\\nexport function containmentProblem(final) {\\n  if (!final) return \\\"no containment report from the resource supervisor\\\";\\n  if (final.error) return final.error;\\n  if (!final.cleaned) return \\\"payload cgroup was not emptied\\\";\\n  return null;\\n}\\n\\nfunction parseReports(text) {\\n  let cgroup = null;\\n  let final = null;\\n  for (const line of text.split(\\\"\\\\n\\\")) {\\n    if (!line.trim()) continue;\\n    let value;\\n    try { value = JSON.parse(line); } catch { continue; }\\n    if (value.cgroup && Object.keys(value).length === 1) cgroup = value.cgroup;\\n    else final = value;\\n  }\\n  return { cgroup, final };\\n}\\neval/resources.mjs:79:export function resourceProbeProblem(resources) {\\neval/resources.mjs:87:  if (!final) return `resource probe produced no containment report (${result.error?.message ?? `exit ${result.status}`}: ${(result.stderr ?? \\\"\\\").trim().slice(-300)})`;\\neval/resources.mjs:111:export function spawnContained(spec, resources, { stdio, ...options }) {\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1723f-d7c7-7d81-90fc-19d6aade9feb","create_time":1792918334.6220355}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
