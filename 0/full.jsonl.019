{"timestamp":"2026-10-25T13:12:31.166Z","ordinal":339463,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17267-b4a8-7073-9d2a-32da76e0ee35","item":{"type":"CommandExecution","id":"exec-c90c676a-cc9e-4087-9a73-59d8ab6f03c1","process_id":"23100","command":["/usr/bin/zsh","-lc","git show origin/main:.github/workflows/repro.yml | sed -n '1,260p'; git show origin/main:scripts/repro-identity.mjs | sed -n '1,220p'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git show origin/main:.github/workflows/repro.yml | sed -n '1,260p'; git show origin/main:scripts/repro-identity.mjs | sed -n '1,220p'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"name: Cross-runner RC reproducibility\n\non:\n  workflow_dispatch:\n    inputs:\n      tag:\n        description: Published v1.0.0 RC tag with lock-pinned release tools (for example v1.0.0-rc.4)\n        required: true\n        type: string\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: rc-repro-${{ inputs.tag }}\n  cancel-in-progress: false\n\njobs:\n  resolve-tag:\n    runs-on: ubuntu-22.04\n    outputs:\n      tag_sha: ${{ steps.resolve.outputs.tag_sha }}\n      workflow_sha: ${{ steps.resolve.outputs.workflow_sha }}\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n    steps:\n      - name: Require dispatch from main\n        run: |\n          if [[ \"$GITHUB_REF\" != \"refs/heads/main\" ]]; then\n            echo \"Dispatch this workflow from main so the checked workflow is the reviewed release version.\" >&2\n            exit 1\n          fi\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22.22.1\n      - id: resolve\n        name: Resolve published RC tag to an immutable commit\n        run: |\n          if [[ ! \"$TARGET_TAG\" =~ ^v1\\.0\\.0-rc\\.[1-9][0-9]*$ ]]; then\n            echo \"Expected a v1.0.0-rc.N tag; received an invalid tag.\" >&2\n            exit 1\n          fi\n          git fetch origin main --no-tags\n          git fetch origin \"refs/tags/$TARGET_TAG:refs/tags/$TARGET_TAG\"\n          tag_sha=\"$(git rev-parse \"$TARGET_TAG^{commit}\")\"\n          git merge-base --is-ancestor \"$tag_sha\" origin/main\n          git checkout --detach \"$tag_sha\"\n          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n          test -f \"docs/releases/$TARGET_TAG.md\"\n          if [[ ! -s scripts/release-tools/package.json || ! -s scripts/release-tools/package-lock.json ]] || \\\n             ! grep -Fq 'scripts/release-tools/package-lock.json' scripts/package-linux.sh || \\\n             ! grep -Fq 'check_deprecated_lock.mjs' scripts/package-linux.sh || \\\n             grep -Eq '(^|[[:space:]])npx([[:space:]]|$)' scripts/package-linux.sh scripts/generate_sbom.sh; then\n            echo \"The selected RC predates or bypasses the locked notices tool and lock deprecation gate; cross-runner reproduction requires an RC whose tag includes them.\" >&2\n            exit 1\n          fi\n          printf 'tag_sha=%s\\n' \"$tag_sha\" >> \"$GITHUB_OUTPUT\"\n          printf 'workflow_sha=%s\\n' \"$GITHUB_WORKFLOW_SHA\" >> \"$GITHUB_OUTPUT\"\n      - name: Verify the public RC release is published\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          gh release view \"$TARGET_TAG\" --json isPrerelease,isDraft \\\n            | jq -e '.isPrerelease == true and .isDraft == false' >/dev/null\n\n  build:\n    needs: resolve-tag\n    runs-on: ${{ matrix.runner }}\n    timeout-minutes: 120\n    strategy:\n      fail-fast: false\n      matrix:\n        runner: [ubuntu-22.04, ubuntu-24.04]\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n      EXPECTED_TAG_SHA: ${{ needs.resolve-tag.outputs.tag_sha }}\n      EXPECTED_WORKFLOW_SHA: ${{ needs.resolve-tag.outputs.workflow_sha }}\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: ${{ needs.resolve-tag.outputs.tag_sha }}\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22.22.1\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Verify exact RC source\n        run: |\n          test \"$(git rev-parse HEAD)\" = \"$EXPECTED_TAG_SHA\"\n          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n          test \"$GITHUB_REF\" = refs/heads/main\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # pinned Rust toolchain action\n        with:\n          toolchain: 1.95.0\n      - name: Install pinned SBOM and notices tools\n        run: |\n          cargo_home=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME=\"$cargo_home\"\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n      - name: Verify the pinned package builder is available\n        run: |\n          docker info >/dev/null\n          test \"$NEXUS_BUILD_CONTAINER_IMAGE\" = 'rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb'\n      - name: Build the exact RC package\n        env:\n          NEXUS_PACKAGE_TOOL_COMMIT: ${{ needs.resolve-tag.outputs.workflow_sha }}\n        run: |\n          git fetch origin main --no-tags\n          git merge-base --is-ancestor \"$NEXUS_PACKAGE_TOOL_COMMIT\" origin/main\n          package_tool=\"$RUNNER_TEMP/package-linux.sh\"\n          git show \"$NEXUS_PACKAGE_TOOL_COMMIT:scripts/package-linux.sh\" > \"$package_tool\"\n          NEXUS_PACKAGE_SOURCE=\"$GITHUB_WORKSPACE\" bash \"$package_tool\" \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\"\n      - name: Record source, toolchain, and published-asset identity\n        env:\n          NEXUS_PACKAGE_TOOL_COMMIT: ${{ needs.resolve-tag.outputs.workflow_sha }}\n          NEXUS_PACKAGE_TOOL_SCRIPT: ${{ runner.temp }}/package-linux.sh\n        run: |\n          git show \"$EXPECTED_WORKFLOW_SHA:scripts/repro-identity.mjs\" > \"$RUNNER_TEMP/repro-identity.mjs\"\n          node \"$RUNNER_TEMP/repro-identity.mjs\" record \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\" \\\n            \"$RUNNER_TEMP/dist/repro-identity.json\" \"${{ matrix.runner }}\"\n      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n        with:\n          name: nexus-repro-${{ matrix.runner }}\n          path: |\n            ${{ runner.temp }}/dist/nexus-linux-x86_64-${{ inputs.tag }}.tar.gz\n            ${{ runner.temp }}/dist/compatibility.json\n            ${{ runner.temp }}/dist/SHA256SUMS\n            ${{ runner.temp }}/dist/THIRD_PARTY_NOTICES.txt\n            ${{ runner.temp }}/dist/sbom.cdx.json\n            ${{ runner.temp }}/dist/install.sh\n            ${{ runner.temp }}/dist/repro-identity.json\n          if-no-files-found: error\n          retention-days: 14\n\n  compare:\n    needs: [resolve-tag, build]\n    runs-on: ubuntu-22.04\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n      EXPECTED_TAG_SHA: ${{ needs.resolve-tag.outputs.tag_sha }}\n      EXPECTED_WORKFLOW_SHA: ${{ needs.resolve-tag.outputs.workflow_sha }}\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: ${{ needs.resolve-tag.outputs.workflow_sha }}\n          fetch-depth: 1\n          persist-credentials: false\n      - name: Verify comparison code is the exact reviewed workflow commit\n        run: test \"$(git rev-parse HEAD)\" = \"$EXPECTED_WORKFLOW_SHA\"\n      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n        with:\n          name: nexus-repro-ubuntu-22.04\n          path: ${{ runner.temp }}/ubuntu-22.04\n      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4\n        with:\n          name: nexus-repro-ubuntu-24.04\n          path: ${{ runner.temp }}/ubuntu-24.04\n      - name: Download published RC assets\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          archive=\"nexus-linux-x86_64-$TARGET_TAG.tar.gz\"\n          mkdir -p \"$RUNNER_TEMP/published\"\n          gh release download \"$TARGET_TAG\" \\\n            --pattern \"$archive\" \\\n            --pattern compatibility.json \\\n            --pattern SHA256SUMS \\\n            --pattern THIRD_PARTY_NOTICES.txt \\\n            --pattern sbom.cdx.json \\\n            --pattern install.sh \\\n            --dir \"$RUNNER_TEMP/published\"\n      - name: Compare both runner builds with each other and the published RC\n        run: |\n          archive=\"nexus-linux-x86_64-$TARGET_TAG.tar.gz\"\n          for runner in ubuntu-22.04 ubuntu-24.04; do\n            (cd \"$RUNNER_TEMP/$runner\" && sha256sum --check SHA256SUMS)\n          done\n          (cd \"$RUNNER_TEMP/published\" && sha256sum --check SHA256SUMS)\n          for file in \"$archive\" compatibility.json SHA256SUMS THIRD_PARTY_NOTICES.txt sbom.cdx.json install.sh; do\n            cmp \"$RUNNER_TEMP/ubuntu-22.04/$file\" \"$RUNNER_TEMP/ubuntu-24.04/$file\"\n            cmp \"$RUNNER_TEMP/ubuntu-22.04/$file\" \"$RUNNER_TEMP/published/$file\"\n          done\n          node scripts/repro-identity.mjs compare \"$TARGET_TAG\" \"$EXPECTED_TAG_SHA\" \"$EXPECTED_WORKFLOW_SHA\" \\\n            \"$RUNNER_TEMP/repro-evidence.json\" \\\n            \"$RUNNER_TEMP/ubuntu-22.04/repro-identity.json\" \\\n            \"$RUNNER_TEMP/ubuntu-24.04/repro-identity.json\"\n          archive_sha=\"$(sha256sum \"$RUNNER_TEMP/ubuntu-22.04/$archive\" | cut -d' ' -f1)\"\n          {\n            printf '## Cross-runner RC reproducibility: %s\\n\\n' \"$TARGET_TAG\"\n            printf 'Source commit: %s\\n' \"$EXPECTED_TAG_SHA\"\n            printf 'Runner images: ubuntu-22.04 and ubuntu-24.04\\n'\n            printf 'Both runner outputs match each other and the six selected reproducibility artifacts.\\n'\n            printf 'Archive SHA-256: %s\\n' \"$archive_sha\"\n            printf '\\nReproducibility evidence artifact: repro-evidence.json\\n'\n          } >> \"$GITHUB_STEP_SUMMARY\"\n      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n        with:\n          name: nexus-repro-evidence-${{ inputs.tag }}\n          path: ${{ runner.temp }}/repro-evidence.json\n          if-no-files-found: error\n          retention-days: 90\n// Source identity for the cross-runner reproducibility workflow (ACC-SUP-08, REQ-REL-114).\n//   record  <version> <dist-dir> <out.json> <runner-label>   identity of the checked-out RC source, package tool, workflow, toolchain and artifacts\n//   compare <expected-version> <expected-commit> <expected-workflow-commit> <out.json> <identity.json>...\n// `compare` fails unless every builder packaged the expected version and commit from identical source and lockfiles\n// and produced identical artifact digests; on success it writes the combined evidence record.\nimport { createHash } from \"node:crypto\";\nimport { execFileSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst LOCKFILES = [\"cli/package-lock.json\", \"core/Cargo.lock\", \"rust-toolchain.toml\", \"scripts/release-tools/package-lock.json\"];\nconst BUILDERS = [\"ubuntu-22.04\", \"ubuntu-24.04\"];\nconst RELEASE_ASSETS = [\"compatibility.json\", \"SHA256SUMS\", \"THIRD_PARTY_NOTICES.txt\", \"sbom.cdx.json\", \"install.sh\"];\nconst APPROVED_RUST_BUILD_IMAGE = \"rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\";\nconst sha256 = (file) => createHash(\"sha256\").update(fs.readFileSync(file)).digest(\"hex\");\nconst run = (cmd, ...argv) => execFileSync(cmd, argv, { encoding: \"utf8\" }).trim();\nconst fail = (message) => { console.error(`repro-identity: ${message}`); process.exit(1); };\n\nconst [mode, ...rest] = process.argv.slice(2);\nif (mode === \"record\") {\n  const [version, dist, out, label] = rest;\n  if (!version || !dist || !out || !label) fail(\"usage: record <version> <dist-dir> <out.json> <runner-label>\");\n  if (process.env.NEXUS_BUILD_CONTAINER_IMAGE !== APPROVED_RUST_BUILD_IMAGE) fail(\"Rust build image is not the approved digest-pinned Bookworm builder\");\n  if (process.env.GITHUB_REF !== \"refs/heads/main\") fail(\"reproducibility workflow must run from reviewed main\");\n  // Packaging must not have changed tracked source: the artifacts must still correspond to the recorded commit.\n  const dirty = run(\"git\", \"status\", \"--porcelain\", \"--untracked-files=no\");\n  if (dirty) fail(`packaging modified tracked files:\\n${dirty}`);\n  const commit = run(\"git\", \"rev-parse\", \"HEAD\");\n  const tagCommit = run(\"git\", \"rev-parse\", `refs/tags/${version}^{commit}`);\n  if (tagCommit !== commit) fail(`fetched tag ${version} resolves to ${tagCommit}, not checked-out source commit ${commit}`);\n  const workflowSha = process.env.GITHUB_WORKFLOW_SHA ?? \"\";\n  if (!/^[0-9a-f]{40}$/.test(workflowSha)) fail(\"reviewed main workflow commit is missing or invalid\");\n  const packageToolCommit = process.env.NEXUS_PACKAGE_TOOL_COMMIT ?? \"\";\n  const packageToolScript = process.env.NEXUS_PACKAGE_TOOL_SCRIPT ?? \"\";\n  if (!/^[0-9a-f]{40}$/.test(packageToolCommit) || packageToolCommit !== workflowSha) fail(\"packaging tool commit must be the exact reviewed workflow commit\");\n  if (!packageToolScript || !fs.existsSync(packageToolScript)) fail(\"packaging tool script identity is missing\");\n  if (!fs.statSync(packageToolScript).isFile()) fail(\"packaging tool script identity must name a file\");\n  const reviewedPackageScript = execFileSync(\"git\", [\"show\", `${packageToolCommit}:scripts/package-linux.sh`], { encoding: \"utf8\" });\n  if (reviewedPackageScript !== fs.readFileSync(packageToolScript, \"utf8\")) fail(\"packaging script does not match the reviewed tool commit\");\n  const artifactNames = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n  const missingArtifacts = artifactNames.filter((file) => !fs.existsSync(path.join(dist, file)));\n  if (missingArtifacts.length) fail(`release output is missing required assets: ${missingArtifacts.join(\", \")}`);\n  const identity = {\n    source: {\n      version,\n      commit,\n      tree: run(\"git\", \"rev-parse\", \"HEAD^{tree}\"),\n      tagObject: run(\"git\", \"rev-parse\", `refs/tags/${version}`),\n      tagCommit,\n      lockfiles: Object.fromEntries(LOCKFILES.map((file) => [file, sha256(file)])),\n      // Non-ignored untracked files could be packaged without being part of the commit; both builders must agree.\n      untracked: run(\"git\", \"ls-files\", \"--others\", \"--exclude-standard\").split(\"\\n\").filter(Boolean),\n    },\n    toolchain: { node: process.version, npm: run(\"npm\", \"--version\"), rustc: run(\"rustc\", \"-V\"), cargo: run(\"cargo\", \"-V\") },\n    buildEnvironment: { rustContainerImage: process.env.NEXUS_BUILD_CONTAINER_IMAGE ?? null },\n    packagingTool: { commit: packageToolCommit, packageScriptSha256: sha256(packageToolScript) },\n    runner: { label, image: process.env.ImageOS ?? null, imageVersion: process.env.ImageVersion ?? null },\n    workflow: { ref: process.env.GITHUB_REF ?? null, sha: workflowSha, runId: process.env.GITHUB_RUN_ID ?? null, runAttempt: process.env.GITHUB_RUN_ATTEMPT ?? null },\n    artifacts: Object.fromEntries(artifactNames.map((file) => [file, sha256(path.join(dist, file))])),\n  };\n  fs.writeFileSync(out, `${JSON.stringify(identity, null, 2)}\\n`);\n} else if (mode === \"compare\") {\n  const [version, commit, workflowCommit, out, ...files] = rest;\n  if (!version || !/^[0-9a-f]{40}$/.test(commit ?? \"\") || !/^[0-9a-f]{40}$/.test(workflowCommit ?? \"\") || !out || files.length < 2) fail(\"usage: compare <version> <commit> <workflow-commit> <out.json> <identity.json> <identity.json>...\");\n  const builders = files.map((file) => JSON.parse(fs.readFileSync(file, \"utf8\")));\n  for (const id of builders) {\n    if (id.source.version !== version || id.source.commit !== commit) fail(`${id.runner.label} packaged ${id.source.version}@${id.source.commit}, not ${version}@${commit}`);\n  }\n  const [first] = builders;\n  const labels = builders.map((id) => id.runner.label).sort();\n  if (JSON.stringify(labels) !== JSON.stringify(BUILDERS)) fail(`builders must be exactly ${BUILDERS.join(\", \")}; got ${labels.join(\", \")}`);\n  if (builders.some((id) => !id.runner.image || !id.runner.imageVersion)) fail(\"every builder must record its runner image and image version\");\n  const buildImages = builders.map((id) => id.buildEnvironment?.rustContainerImage);\n  if (buildImages.some((image) => image !== APPROVED_RUST_BUILD_IMAGE)) fail(\"every builder must use the approved digest-pinned Bookworm Rust build image\");\n  if (new Set(buildImages).size !== 1) fail(\"builders used different Rust build images\");\n  const packageToolCommits = builders.map((id) => id.packagingTool?.commit);\n  const packageToolHashes = builders.map((id) => id.packagingTool?.packageScriptSha256);\n  if (packageToolCommits.some((value) => value !== workflowCommit) || packageToolHashes.some((value) => !/^[0-9a-f]{64}$/.test(value ?? \"\"))) fail(\"builders did not record the exact reviewed packaging tool commit and script hash\");\n  if (new Set(packageToolHashes).size !== 1) fail(\"builders used different packaging tool scripts\");\n  // The released workflow is reviewed on main; the built product source remains bound to the exact RC tag commit above.\n  for (const id of builders) {\n    if (id.workflow?.ref !== \"refs/heads/main\" || id.workflow?.sha !== workflowCommit) fail(`${id.runner.label} did not record the expected reviewed main workflow commit ${workflowCommit}`);\n  }\n  if (new Set(builders.map((id) => id.workflow.sha)).size !== 1) fail(\"builders used different workflow definitions\");\n  if (new Set(builders.map((id) => `${id.workflow.runId}/${id.workflow.runAttempt}`)).size !== 1) fail(\"builders belong to different workflow runs\");\n  if (builders.some((id) => JSON.stringify(id.source) !== JSON.stringify(first.source))) fail(\"builders packaged different source or lockfiles\");\n  if (builders.some((id) => JSON.stringify(id.artifacts) !== JSON.stringify(first.artifacts))) fail(\"artifact digests differ between builders\");\n  const expectedAssets = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n  if (JSON.stringify(Object.keys(first.artifacts).sort()) !== JSON.stringify(expectedAssets)) fail(\"identity evidence does not cover the six selected reproducibility artifacts\");\n  const workflowRun = process.env.GITHUB_RUN_ID ? `${process.env.GITHUB_SERVER_URL}/${process.env.GITHUB_REPOSITORY}/actions/runs/${process.env.GITHUB_RUN_ID}` : null;\n  const evidence = { requirement: \"REQ-REL-114\", acceptance: \"ACC-SUP-08\", result: \"PASS\", workflowRun, workflow: first.workflow, source: first.source, buildEnvironment: first.buildEnvironment, packagingTool: first.packagingTool, artifacts: first.artifacts, builders: builders.map(({ runner, toolchain }) => ({ runner, toolchain })) };\n  fs.writeFileSync(out, `${JSON.stringify(evidence, null, 2)}\\n`);\n} else {\n  fail(\"mode must be record or compare\");\n}\n","exit_code":0,"duration":{"secs":0,"nanos":29305}},"started_at_ms":1792933951165,"completed_at_ms":1792933951165}}
{"timestamp":"2026-10-25T13:12:32.144Z","ordinal":339464,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17330-fa90-7cf2-a64e-a75337e5c828","call_id":"call_0d4e2d850bb643608062fc35e575a79b","output":[{"type":"input_text","text":"Script completed\nWall time 1.9 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 4836)\nTotal output lines: 314\n\nname: Cross-runner RC reproducibility\n\non:\n  workflow_dispatch:\n    inputs:\n      tag:\n        description: Published v1.0.0 RC tag with lock-pinned release tools (for example v1.0.0-rc.4)\n        required: true\n        type: string\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: rc-repro-${{ inputs.tag }}\n  cancel-in-progress: false\n\njobs:\n  resolve-tag:\n    runs-on: ubuntu-22.04\n    outputs:\n      tag_sha: ${{ steps.resolve.outputs.tag_sha }}\n      workflow_sha: ${{ steps.resolve.outputs.workflow_sha }}\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n    steps:\n      - name: Require dispatch from main\n        run: |\n          if [[ \"$GITHUB_REF\" != \"refs/heads/main\" ]]; then\n            echo \"Dispatch this workflow from main so the checked workflow is the reviewed release version.\" >&2\n            exit 1\n          fi\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22.22.1\n      - id: resolve\n        name: Resolve published RC tag to an immutable commit\n        run: |\n          if [[ ! \"$TARGET_TAG\" =~ ^v1\\.0\\.0-rc\\.[1-9][0-9]*$ ]]; then\n            echo \"Expected a v1.0.0-rc.N tag; received an invalid tag.\" >&2\n            exit 1\n          fi\n          git fetch origin main --no-tags\n          git fetch origin \"refs/tags/$TARGET_TAG:refs/tags/$TARGET_TAG\"\n          tag_sha=\"$(git rev-parse \"$TARGET_TAG^{commit}\")\"\n          git merge-base --is-ancestor \"$tag_sha\" origin/main\n          git checkout --detach \"$tag_sha\"\n          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n          test -f \"docs/releases/$TARGET_TAG.md\"\n          if [[ ! -s scripts/release-tools/package.json || ! -s scripts/release-tools/package-lock.json ]] || \\\n             ! grep -Fq 'scripts/release-tools/package-lock.json' scripts/package-linux.sh || \\\n             ! grep -Fq 'check_deprecated_lock.mjs' scripts/package-linux.sh || \\\n             grep -Eq '(^|[[:space:]])npx([[:space:]]|$)' scripts/package-linux.sh scripts/generate_sbom.sh; then\n            echo \"The selected RC predates or bypasses the locked notices tool and lock deprecation gate; cross-runner reproduction requires an RC whose tag includes them.\" >&2\n            exit 1\n          fi\n          printf 'tag_sha=%s\\n' \"$tag_sha\" >> \"$GITHUB_OUTPUT\"\n          printf 'workflow_sha=%s\\n' \"$GITHUB_WORKFLOW_SHA\" >> \"$GITHUB_OUTPUT\"\n      - name: Verify the public RC release is published\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          gh release view \"$TARGET_TAG\" --json isPrerelease,isDraft \\\n            | jq -e '.isPrerelease == true and .isDraft == false' >/dev/null\n\n  build:\n    needs: resolve-tag\n    runs-on: ${{ matrix.runner }}\n    timeout-minutes: 120\n    strategy:\n      fail-fast: false\n      matrix:\n        runner: [ubuntu-22.04, ubuntu-24.04]\n    env:\n      TARGET_TAG: ${{ inputs.tag }}\n      EXPECTED_TAG_SHA: ${{ needs.resolve-tag.outputs.tag_sha }}\n      EXPECTED_WORKFLOW_SHA: ${{ needs.resolve-tag.outputs.workflow_sha }}\n      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: ${{ needs.resolve-tag.outputs.tag_sha }}\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n        with:\n          node-version: 22.22.1\n          cache: npm\n          cache-dependency-path: cli/package-lock.json\n      - name: Verify exact RC source\n        run: |\n          test \"$(git rev-parse HEAD)\" = \"$EXPECTED_TAG_SHA\"\n          test \"$(node -p 'require(\"./package.json\").version')\" = \"${TARGET_TAG#v}\"\n          node scripts/sync-version.mjs --check --tag \"$TARGET_TAG\"\n          test \"$GITHUB_REF\" = refs/heads/main\n      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # pinned Rust toolchain action\n        with:\n          toolchain: 1.95.0\n      - name: Install pinned SBOM and notices tools\n        run: |\n          cargo_home=\"${CARGO_HOME:-$HOME/.cargo}\"\n          export CARGO_HOME=\"$cargo_home\"\n          mkdir -p \"$CARGO_HOME/bin\"\n          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n          export PATH=\"$CARGO_HOME/bin:$PATH\"\n          curl -fsSL https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP/cargo-about-0.9.2-x86_64-unknown-linux-musl/cargo-about\" \"$CARGO_HOME/bin/\"\n          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n          mv \"$RUNNER_TEMP…2236 tokens truncated…s = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n  const missingArtifacts = artifactNames.filter((file) => !fs.existsSync(path.join(dist, file)));\n  if (missingArtifacts.length) fail(`release output is missing required assets: ${missingArtifacts.join(\", \")}`);\n  const identity = {\n    source: {\n      version,\n      commit,\n      tree: run(\"git\", \"rev-parse\", \"HEAD^{tree}\"),\n      tagObject: run(\"git\", \"rev-parse\", `refs/tags/${version}`),\n      tagCommit,\n      lockfiles: Object.fromEntries(LOCKFILES.map((file) => [file, sha256(file)])),\n      // Non-ignored untracked files could be packaged without being part of the commit; both builders must agree.\n      untracked: run(\"git\", \"ls-files\", \"--others\", \"--exclude-standard\").split(\"\\n\").filter(Boolean),\n    },\n    toolchain: { node: process.version, npm: run(\"npm\", \"--version\"), rustc: run(\"rustc\", \"-V\"), cargo: run(\"cargo\", \"-V\") },\n    buildEnvironment: { rustContainerImage: process.env.NEXUS_BUILD_CONTAINER_IMAGE ?? null },\n    packagingTool: { commit: packageToolCommit, packageScriptSha256: sha256(packageToolScript) },\n    runner: { label, image: process.env.ImageOS ?? null, imageVersion: process.env.ImageVersion ?? null },\n    workflow: { ref: process.env.GITHUB_REF ?? null, sha: workflowSha, runId: process.env.GITHUB_RUN_ID ?? null, runAttempt: process.env.GITHUB_RUN_ATTEMPT ?? null },\n    artifacts: Object.fromEntries(artifactNames.map((file) => [file, sha256(path.join(dist, file))])),\n  };\n  fs.writeFileSync(out, `${JSON.stringify(identity, null, 2)}\\n`);\n} else if (mode === \"compare\") {\n  const [version, commit, workflowCommit, out, ...files] = rest;\n  if (!version || !/^[0-9a-f]{40}$/.test(commit ?? \"\") || !/^[0-9a-f]{40}$/.test(workflowCommit ?? \"\") || !out || files.length < 2) fail(\"usage: compare <version> <commit> <workflow-commit> <out.json> <identity.json> <identity.json>...\");\n  const builders = files.map((file) => JSON.parse(fs.readFileSync(file, \"utf8\")));\n  for (const id of builders) {\n    if (id.source.version !== version || id.source.commit !== commit) fail(`${id.runner.label} packaged ${id.source.version}@${id.source.commit}, not ${version}@${commit}`);\n  }\n  const [first] = builders;\n  const labels = builders.map((id) => id.runner.label).sort();\n  if (JSON.stringify(labels) !== JSON.stringify(BUILDERS)) fail(`builders must be exactly ${BUILDERS.join(\", \")}; got ${labels.join(\", \")}`);\n  if (builders.some((id) => !id.runner.image || !id.runner.imageVersion)) fail(\"every builder must record its runner image and image version\");\n  const buildImages = builders.map((id) => id.buildEnvironment?.rustContainerImage);\n  if (buildImages.some((image) => image !== APPROVED_RUST_BUILD_IMAGE)) fail(\"every builder must use the approved digest-pinned Bookworm Rust build image\");\n  if (new Set(buildImages).size !== 1) fail(\"builders used different Rust build images\");\n  const packageToolCommits = builders.map((id) => id.packagingTool?.commit);\n  const packageToolHashes = builders.map((id) => id.packagingTool?.packageScriptSha256);\n  if (packageToolCommits.some((value) => value !== workflowCommit) || packageToolHashes.some((value) => !/^[0-9a-f]{64}$/.test(value ?? \"\"))) fail(\"builders did not record the exact reviewed packaging tool commit and script hash\");\n  if (new Set(packageToolHashes).size !== 1) fail(\"builders used different packaging tool scripts\");\n  // The released workflow is reviewed on main; the built product source remains bound to the exact RC tag commit above.\n  for (const id of builders) {\n    if (id.workflow?.ref !== \"refs/heads/main\" || id.workflow?.sha !== workflowCommit) fail(`${id.runner.label} did not record the expected reviewed main workflow commit ${workflowCommit}`);\n  }\n  if (new Set(builders.map((id) => id.workflow.sha)).size !== 1) fail(\"builders used different workflow definitions\");\n  if (new Set(builders.map((id) => `${id.workflow.runId}/${id.workflow.runAttempt}`)).size !== 1) fail(\"builders belong to different workflow runs\");\n  if (builders.some((id) => JSON.stringify(id.source) !== JSON.stringify(first.source))) fail(\"builders packaged different source or lockfiles\");\n  if (builders.some((id) => JSON.stringify(id.artifacts) !== JSON.stringify(first.artifacts))) fail(\"artifact digests differ between builders\");\n  const expectedAssets = [`nexus-linux-x86_64-${version}.tar.gz`, ...RELEASE_ASSETS].sort();\n  if (JSON.stringify(Object.keys(first.artifacts).sort()) !== JSON.stringify(expectedAssets)) fail(\"identity evidence does not cover the six selected reproducibility artifacts\");\n  const workflowRun = process.env.GITHUB_RUN_ID ? `${process.env.GITHUB_SERVER_URL}/${process.env.GITHUB_REPOSITORY}/actions/runs/${process.env.GITHUB_RUN_ID}` : null;\n  const evidence = { requirement: \"REQ-REL-114\", acceptance: \"ACC-SUP-08\", result: \"PASS\", workflowRun, workflow: first.workflow, source: first.source, buildEnvironment: first.buildEnvironment, packagingTool: first.packagingTool, artifacts: first.artifacts, builders: builders.map(({ runner, toolchain }) => ({ runner, toolchain })) };\n  fs.writeFileSync(out, `${JSON.stringify(evidence, null, 2)}\\n`);\n} else {\n  fail(\"mode must be record or compare\");\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17267-b4a8-7073-9d2a-32da76e0ee35","create_time":1792933952.144558}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
