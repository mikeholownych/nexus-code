n === true) {\n      if (typeof config.nexusExecutable !== \"string\" || !path.isAbsolute(config.nexusExecutable)) {\n        return { record: null, problem: \"qualification requires nexusExecutable to be the absolute path of the installed RC\" };\n      }\n      if (typeof config.expectedAgentVersion !== \"string\" || !config.expectedAgentVersion.trim()) {\n        return { record: null, problem: \"qualification requires expectedAgentVersion to pin the installed RC\" };\n      }\n      if (!/^[0-9a-f]{64}$/.test(config.nexusPackageSha256 ?? \"\")) {\n        return { record: null, problem: \"qualification requires nexusPackageSha256 from the installed RC release asset\" };\n      }\n      command = path.resolve(config.nexusExecutable);\n      try {\n        if (fs.realpathSync(command) === fs.realpathSync(path.join(ROOT, \"cli/dist/index.js\"))) {\n          return { record: null, problem: \"qualification must use the installed RC, not the checkout cli/dist/index.js\" };\n        }\n      } catch {}\n    } else {\n      command = process.execPath;\n      argsPrefix = [path.join(ROOT, \"cli/dist/index.js\")];\n    }\n  } else if ([\"goose\", \"opencode\", \"aider\"].includes(agent)) {\n    command = resolvePathExecutable(agent, { ...process.env, ...(config.env ?? {}) }) ?? agent;\n  } else {\n    return { record: null, problem: `eval agent '${agent}' has no versioned adapter` };\n  }\n\n  const required = config.qualification === true || config.expectedAgentVersion !== undefined;\n  let candidatePath;\n  try { candidatePath = fs.realpathSync(command); }\n  catch (error) { return { record: null, problem: required ? `could not identify ${agent} executable (${error.message})` : null, command, argsPrefix }; }\n  argsPrefix = argsPrefix.map((item) => path.isAbsolute(item) ? fs.realpathSync(item) : item);\n  // Version probes execute candidate-controlled code and must share the enforced writable-storage cap.\n  const probeWorkspace = fs.mkdtempSync(path.join(config.resources?.workspaceRoot ?? os.tmpdir(), \"nexus-eval-version-workspace-\"));\n  let probe;\n  try {\n    if (config.runAs) grantRunAsAccess(config.runAs, [probeWorkspace]);\n    const runtimePaths = [candidatePath, ...argsPrefix.filter((item) => path.isAbsolute(item)).map((item) => fs.realpathSync(item))];\n    const isCheckoutNexus = agent === \"nexus\" && argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\");\n    if (isCheckoutNexus) {\n      runtimePaths.push(path.join(ROOT, \"cli/dist\"));\n      const modules = path.join(ROOT, \"cli/node_modules\");\n      if (fs.existsSync(modules)) {\n        for (const entry of fs.readdirSync(modules, { withFileTypes: true })) {\n          if (entry.isDirectory() && entry.name !== \".bin\") runtimePaths.push(path.join(modules, entry.name));\n        }\n      }\n      const coreBinary = path.join(ROOT, \"core/target/release/harness-core\");\n      if (fs.existsSync(coreBinary)) runtimePaths.push(coreBinary);\n    }\n    const allowedRoots = [...new Set([...(config.sandboxRuntimeRoots ?? []), ...(isCheckoutNexus ? [ROOT] : [])])];\n    const spec = isolatedProcessArgv({\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/run.mjs:406:    probe = await runIsolatedProcess(wrapped, { outputLimit: 4096, resources: config.resources ?? null });\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/isolate.mjs:361:export function runIsolatedProcess(spec, { outputLimit = 16_384, input = \"\", resources = null } = {}) {\n/home/mike/nexus-wt/plan10-pr10c-t4/eval/isolate.mjs:429:  const result = await runIsolatedProcess(wrapSpec(user, spec), { outputLimit: 1_000_000 });\n    child.on(\"close\", async (status, signal) => {\n      if (settled) return;\n      settled = true;\n      clearTimeout(timer);\n      killGroup(\"SIGKILL\");\n      resolve({ status, signal, stdout, stderr, timedOut, overflow, ...(await containmentResult(containment)) });\n    });\n  });\n}\n\n/** Build ACL arguments for the evaluator and operator on one disposable path. */\nexport function runAsAclArgs(user, operatorUid, resolved, directory) {\n  return {\n    access: [\"-R\", \"-m\", `u:${user}:rwX,u:${operatorUid}:rwX`, resolved],\n    defaults: directory ? [\"-m\", `d:u:${user}:rwx,d:u:${operatorUid}:rwx,d:m::rwx`, resolved] : null,\n  };\n}\n\n/** Grant the evaluator and harness operator access to disposable paths; never make them world-writable. */\nexport function grantRunAsAccess(user, targets) {\n  if (!/^[a-z_][a-z0-9_-]{0,31}$/.test(user)) throw new Error(\"invalid evaluator account\");\n  const setfacl = \"/usr/bin/setfacl\";\n  const opUid = process.getuid();\n  if (!fs.existsSync(setfacl)) throw new Error(\"setfacl is unavailable; refusing unsafe workspace permission changes\");\n  for (const target of targets) {\n    const resolved = fs.realpathSync(target);\n    const { access, defaults } = runAsAclArgs(user, opUid, resolved, fs.statSync(resolved).isDirectory());\n    const result = spawnSync(setfacl, access, { encoding: \"utf8\", timeout: 5000, env: { PATH: \"/usr/bin:/bin\" } });\n    if (result.status !== 0) throw new Error(`could not grant scoped evaluator access to disposable path (${result.status ?? \"signal\"})`);\n    if (defaults) {\n      const defaultResult = spawnSync(setfacl, defaults, { encoding: \"utf8\", timeout: 5000, env: { PATH: \"/usr/bin:/bin\" } });\n      if (defaultResult.status !== 0) throw new Error(`could not set scoped evaluator default ACL (${defaultResult.status ?? \"signal\"})`);\n    }\n  }\n}\n\n/** Make evaluator-owned workspace files readable to the operator through the scoped ACL mask. */\nexport async function normalizeRunAsPermissions(user, dir, wrapSpec) {\n  const spec = isolatedProcessArgv({ cwd: dir, command: \"/usr/bin/chmod\", argv: [\"-R\", \"u+rwX,g+rwX,o-rwx\", \"/workspace\"], timeoutMs: 60_000 });\n  const result = await runIsolatedProcess(wrapSpec(user, spec), { outputLimit: 1_000_000 });\n  if (result.timedOut || result.error) throw new Error(`could not normalise evaluator file permissions (${result.error ?? \"timeout\"})`);\n  return result;\n}\n\nexport function stageHiddenFiles(source, ws, relativeTarget, { readOnlyHidden = false } = {}) {\n  assertNoSymlinks(source);\n  const relFiles = [];\n  const walk = (dir, prefix = \"\") => {\n    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n      const rel = prefix ? `${prefix}/${entry.name}` : entry.name;\n      if (entry.isDirectory()) walk(path.join(dir, entry.name), rel);\n      else if (entry.isFile()) relFiles.push(rel);\n    }\n  };\n  walk(source);\n  const readOnlySubpaths = [];\n  for (const relFile of relFiles) {\n    const relTargetFile = (!relativeTarget || relativeTarget === \".\") ? relFile : path.posix.join(relativeTarget, relFile);\n    const segments = relTargetFile.split(\"/\");\n    if (path.posix.isAbsolute(relTargetFile) || segments.some((segment) => !segment || segment === \"..\")) {\n      throw new Error(`invalid hidden test target path: ${relTargetFile}`);\n    }\n    let cur = fs.realpathSync(ws);\n    const dirParts = path.posix.dirname(relTargetFile).split(\"/\").filter((part) => part && part !== \".\");\n    for (const part of dirParts) {\n      cur = path.join(cur, part);\n      const st = fs.lstatSync(cur, { throwIfNoEntry: false });\n      if (st) {\n        if (st.isSymbolicLink() || !st.isDirectory()) throw new Error(`unsafe hidden test parent directory: ${relTargetFile}`);\n      } else {\n        fs.mkdirSync(cur);\n      }\n    }\n    const leafPath = path.join(cur, path.posix.basename(relTargetFile));\n    const leafStat = fs.lstatSync(leafPath, { throwIfNoEntry: false });\n    if (leafStat?.isSymbolicLink() && !readOnlyHidden) throw new Error(`unsafe hidden test destination: ${relTargetFile}`);\n    if (leafStat && readOnlyHidden) fs.rmSync(leafPath, { recursive: true, force: true });\n    const destFile = confinedPath(ws, relTargetFile, { allowMissingLeaf: true });\n    fs.mkdirSync(path.dirname(destFile), { recursive: true });\n    fs.cp