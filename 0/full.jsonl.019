{"timestamp":"2026-10-25T13:18:01.621Z","ordinal":339757,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17267-b4a8-7073-9d2a-32da76e0ee35","item":{"type":"CommandExecution","id":"exec-18cdf18d-890a-42c2-89db-6dad2c49c8d1","process_id":"31572","command":["/usr/bin/zsh","-lc","git show origin/main:scripts/terminal-acceptance/test-scope-procs.sh | sed -n '1,240p'; git show origin/main:scripts/terminal-acceptance/scope-procs.sh | sed -n '1,200p'; git show origin/main:scripts/terminal-acceptance/summarize.mjs | head -80"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"git show origin/main:scripts/terminal-acceptance/test-scope-procs.sh | sed -n '1,240p'; git show origin/main:scripts/terminal-acceptance/scope-procs.sh | sed -n '1,200p'; git show origin/main:scripts/terminal-acceptance/summarize.mjs | head -80"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n\nHERE=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"$HERE/scope-procs.sh\"\ntmp=\"$(mktemp -d)\"\ncleanup() { python3 -c 'import shutil,sys; shutil.rmtree(sys.argv[1])' \"$tmp\"; }\ntrap cleanup EXIT\nmkdir -p \"$tmp/bin\" \"$tmp/cgroup/user.slice/test.scope\"\n\ncat > \"$tmp/bin/systemctl\" <<'STUB'\n#!/usr/bin/env bash\nset -euo pipefail\n[[ \"${SYSTEMCTL_FAIL:-0}\" == 1 ]] && exit 1\nproperty=\"\"\nfor arg in \"$@\"; do\n  case \"$arg\" in\n    --property=*) property=\"${arg#--property=}\" ;;\n  esac\ndone\ncat \"${FIXTURE_STATE_DIR:?}/$property\"\nSTUB\nchmod +x \"$tmp/bin/systemctl\"\nPATH=\"$tmp/bin:$PATH\"\nexport PATH FIXTURE_STATE_DIR=\"$tmp/state\" NEXUS_CGROUP_ROOT=\"$tmp/cgroup\"\nmkdir -p \"$FIXTURE_STATE_DIR\"\n\nset_state() {\n  printf '%s\\n' \"$1\" > \"$FIXTURE_STATE_DIR/LoadState\"\n  printf '%s\\n' \"$2\" > \"$FIXTURE_STATE_DIR/ActiveState\"\n  printf '%s\\n' \"$3\" > \"$FIXTURE_STATE_DIR/ControlGroup\"\n}\nexpect_count() {\n  local want=\"$1\" got\n  got=\"$(nexus_terminal_scope_procs test)\"\n  [[ \"$got\" == \"$want\" ]] || { echo \"expected $want processes, got $got\" >&2; exit 1; }\n}\nexpect_unavailable() {\n  if nexus_terminal_scope_procs test >/dev/null 2>&1; then\n    echo \"expected unavailable measurement to fail closed\" >&2\n    exit 1\n  fi\n}\n\nset_state loaded active /user.slice/test.scope\n: > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_count 0\nprintf '101\\n202\\n' > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_count 2\n\npython3 -c 'import os,sys; os.unlink(sys.argv[1])' \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_unavailable\n: > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nchmod 000 \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_unavailable\nchmod 600 \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nprintf 'not-a-pid\\n' > \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_unavailable\npython3 -c 'import os,sys; os.unlink(sys.argv[1])' \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nmkdir \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\nexpect_unavailable\npython3 -c 'import os,sys; os.rmdir(sys.argv[1])' \"$NEXUS_CGROUP_ROOT/user.slice/test.scope/cgroup.procs\"\n\nset_state loaded inactive ''\nexpect_count 0\nset_state not-found inactive ''\nexpect_count 0\n\nset_state loaded active ''\nexpect_unavailable\nset_state loaded active /user.slice/../escape\nexpect_unavailable\nset_state loaded active /user.slice/test.scope\nSYSTEMCTL_FAIL=1 expect_unavailable\n\nmkdir -p \"$tmp/evidence\"\nwrite_evidence_fixture() {\n  MODE=\"$1\" EVIDENCE_DIR=\"$tmp/evidence\" node --input-type=module <<'NODE'\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst dir = process.env.EVIDENCE_DIR;\nconst sha = (data) => createHash(\"sha256\").update(data).digest(\"hex\");\nfor (const [name, body] of Object.entries({\n  \"approval.png\": \"approval screenshot\",\n  \"post-exit.png\": \"post exit screenshot\",\n  \"mock.log\": \"mock request log\",\n  \"answers.tsv\": \"checks\",\n  \"exits.tsv\": \"measurements\",\n})) fs.writeFileSync(path.join(dir, name), body);\nconst files = Object.fromEntries(Object.entries({\n  approvalScreenshot: \"approval.png\",\n  postExitScreenshot: \"post-exit.png\",\n  mockLog: \"mock.log\",\n  answers: \"answers.tsv\",\n  exits: \"exits.tsv\",\n}).map(([key, name]) => [key, { path: name, sha256: sha(fs.readFileSync(path.join(dir, name))) }]));\nfor (const terminal of [\"xterm\", \"kitty\", \"tmux-gnome\", \"vscode\", \"gnome\"]) {\n  for (const size of [\"80x24\", \"40x14\", \"200x60\"]) {\n    const cell = `${terminal}-${size}`;\n    const measurement = (launch) => ({\n      launch,\n      exitStatus: 0,\n      sttyRestored: true,\n      survivors: 0,\n      scopeMeasurement: process.env.MODE === \"unavailable\" && cell === \"xterm-80x24\" && launch === \"main\" ? \"unavailable\" : \"verified\",\n      at: \"2026-10-19T00:00:00Z\",\n    });\n    const record = {\n      cell,\n      attempt: 1,\n      rc: \"v1.0.0-rc.1\",\n      packageManifestSha256: \"a\".repeat(64),\n      measured: [measurement(\"main\"), measurement(\"no_color\")],\n      scenarios: { approveToolRounds: [0, 1], stream: 1, sleepTool: 1 },\n      checks: Object.fromEntries([\"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"7\"].map((check) => [check, { result: \"PASS\", note: \"\" }])),\n      files,\n    };\n    const output = `${JSON.stringify(record, null, 2)}\\n`;\n    const file = path.join(dir, `cell-${cell}.attempt-1.json`);\n    fs.writeFileSync(file, output);\n    fs.writeFileSync(`${file}.sha256`, `${sha(output)}  ${path.basename(file)}\\n`);\n  }\n}\nNODE\n}\nwrite_evidence_fixture unavailable\nif node \"$HERE/summarize.mjs\" \"$tmp/evidence\" --rc v1.0.0-rc.1 --manifest-sha256 \"$(printf 'a%.0s' {1..64})\" > \"$tmp/unavailable-summary.log\" 2>&1; then\n  echo \"summary gate accepted an unavailable process-scope measurement\" >&2\n  exit 1\nfi\ngrep -q 'safety check 5 FAIL (scope measurement unavailable)' \"$tmp/unavailable-summary.log\"\nwrite_evidence_fixture verified\n# Only exact numeric attempt filenames count; similarly prefixed artifacts are ignored.\nprintf '%s\\n' '{}' > \"$tmp/evidence/cell-xterm-80x24.attempt-not-a-number.json\"\nprintf '%s\\n' '{}' > \"$tmp/evidence/cell-xterm-80x24.attempt-2.json.backup\"\nnode \"$HERE/summarize.mjs\" \"$tmp/evidence\" --rc v1.0.0-rc.1 --manifest-sha256 \"$(printf 'a%.0s' {1..64})\" > \"$tmp/verified-summary.log\"\ngrep -q 'manual matrix gate for v1.0.0-rc.1 .*: PASS' \"$tmp/verified-summary.log\"\ngrep -q '^| xterm-80x24 | 1 | PASS | PASS' \"$tmp/verified-summary.log\"\n\necho \"scope measurement fixtures passed\"\n#!/usr/bin/env bash\n# Return the number of processes in a terminal test's systemd scope. A zero is\n# emitted only when the scope is proven empty or systemd confirms it is gone.\nnexus_terminal_scope_procs() {\n  local unit=\"$1\"\n  local cgroup_root=\"${NEXUS_CGROUP_ROOT:-/sys/fs/cgroup}\"\n  local load_state active_state control_group process_file count\n\n  load_state=\"$(systemctl --user show --property=LoadState --value \"$unit.scope\" 2>/dev/null)\" || return 2\n  if [[ \"$load_state\" == \"not-found\" ]]; then\n    printf '0\\n'\n    return 0\n  fi\n  [[ \"$load_state\" == \"loaded\" ]] || return 2\n\n  active_state=\"$(systemctl --user show --property=ActiveState --value \"$unit.scope\" 2>/dev/null)\" || return 2\n  control_group=\"$(systemctl --user show --property=ControlGroup --value \"$unit.scope\" 2>/dev/null)\" || return 2\n\n  if [[ -n \"$control_group\" ]]; then\n    [[ \"$control_group\" == /* && \"$control_group\" != *\"/../\"* && \"$control_group\" != */.. ]] || return 2\n    process_file=\"${cgroup_root%/}${control_group}/cgroup.procs\"\n    if [[ -f \"$process_file\" && -r \"$process_file\" ]]; then\n      count=\"$(awk 'BEGIN { invalid = 0 } { if ($0 !~ /^[0-9]+$/) invalid = 1 } END { if (invalid) exit 2; print NR }' \"$process_file\")\" || return 2\n      printf '%s\\n' \"$count\"\n      return 0\n    fi\n  fi\n\n  # A stopped, loaded unit with no remaining cgroup has no processes. An\n  # active unit with missing/unreadable cgroup data is an unknown measurement.\n  if [[ \"$active_state\" == \"inactive\" && -z \"$control_group\" ]]; then\n    printf '0\\n'\n    return 0\n  fi\n  return 2\n}\n#!/usr/bin/env node\n// Gate for the manual real-terminal matrix (ACCEPTANCE §5.3) over the attempt records written by run-cell.sh.\n//   node scripts/terminal-acceptance/summarize.mjs <evidence dir> --rc vX.Y.Z-rc.N --manifest-sha256 <hex> \\\n//     [--dispositions dispositions.json]\n// --manifest-sha256 is the SHA-256 of MANIFEST.sha256 inside the RC release archive, so every cell must have run the\n// published RC package. The gate fails closed:\n//   - every terminal × size cell needs a complete, verified attempt (otherwise NOT RUN: ACCEPTANCE §1 rule 5);\n//   - an attempt is complete only when its self-hash, file hashes, both launch measurements and the mock log's\n//     scenario proof (approve x2 tool rounds, stream, sleep tool call) all verify;\n//   - checks 2, 5 and 6 have zero FAIL in ANY attempt; a measured survivor or unrestored terminal turns PASS into FAIL;\n//   - every other FAIL, in any attempt, needs a written disposition keyed \"<cell>:<check>\";\n//   - an aborted attempt (a .partial file) needs a written disposition keyed \"<cell>:partial-<n>\".\n// Hashes prove the files are unchanged since recording, not who recorded them: commit the evidence directory.\nimport { createHash } from \"node:crypto\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst TERMINALS = [\"xterm\", \"kitty\", \"tmux-gnome\", \"vscode\", \"gnome\"];\nconst SIZES = [\"80x24\", \"40x14\", \"200x60\"];\nconst CHECKS = [\"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"7\"];\nconst SAFETY = new Set([\"2\", \"5\", \"6\"]);\nconst arg = (name) => (process.argv.includes(name) ? process.argv[process.argv.indexOf(name) + 1] : null);\nconst dir = process.argv[2];\nconst rc = arg(\"--rc\");\nconst manifestSha = arg(\"--manifest-sha256\");\nif (!dir || !/^v\\d+\\.\\d+\\.\\d+-rc\\.\\d+$/.test(rc ?? \"\") || !/^[0-9a-f]{64}$/.test(manifestSha ?? \"\")) {\n  console.error(\"usage: summarize.mjs <evidence dir> --rc vX.Y.Z-rc.N --manifest-sha256 <hex> [--dispositions file]\");\n  process.exit(2);\n}\nconst dispositions = arg(\"--dispositions\") ? JSON.parse(fs.readFileSync(arg(\"--dispositions\"), \"utf8\")) : {};\nconst sha = (file) => createHash(\"sha256\").update(fs.readFileSync(file)).digest(\"hex\");\n\n/** Why an attempt record cannot be used, or null. */\nfunction attemptProblem(file, record, cell) {\n  const sidecar = `${file}.sha256`;\n  if (!fs.existsSync(sidecar) || fs.readFileSync(sidecar, \"utf8\").split(/\\s+/)[0] !== sha(file)) return \"record self-hash missing or wrong\";\n  if (record.cell !== cell) return `record names cell ${record.cell}`;\n  if (record.rc !== rc) return `record is for ${record.rc}, not ${rc}`;\n  if (record.packageManifestSha256 !== manifestSha) return \"installed package manifest differs from the RC archive\";\n  for (const [name, entry] of Object.entries(record.files ?? {})) {\n    const target = path.join(dir, entry.path);\n    if (!fs.existsSync(target) || sha(target) !== entry.sha256) return `${name} file missing or changed`;\n  }\n  if (Object.keys(record.files ?? {}).length !== 5) return \"record does not list its five evidence files\";\n  if (record.files.approvalScreenshot.sha256 === record.files.postExitScreenshot.sha256) return \"the two screenshots are the same file\";\n  const launches = (record.measured ?? []).map((m) => m.launch).sort().join(\",\");\n  if (launches !== \"main,no_color\") return `measured launches are [${launches}], not main and no_color`;\n  if (record.measured.some((m) => !Number.isInteger(m.survivors) || m.survivors < 0 || ![\"verified\", \"unavailable\"].includes(m.scopeMeasurement) || typeof m.sttyRestored !== \"boolean\")) return \"measurements are malformed\";\n  const s = record.scenarios ?? {};\n  if (!(s.approveToolRounds?.includes(0) && s.approveToolRounds?.includes(1)) || !(s.stream >= 1) || !(s.sleepTool >= 1)) return \"the mock log does not show the approve, stream and sleep scenarios\";\n  if (CHECKS.some((check) => ![\"PASS\", \"FAIL\"].includes(record.checks?.[check]?.result))) return \"a check has no PASS/FAIL\";\n  return null;\n}\n\nconst problems = [];\nconst rows = [];\nfor (const terminal of TERMINALS) {\n  for (const size of SIZES) {\n    const cell = `${terminal}-${size}`;\n    const attemptPrefix = `cell-${cell}.attempt-`;\n    const files = fs.readdirSync(dir).filter((name) => {\n      if (!name.startsWith(attemptPrefix) || !name.endsWith(\".json\")) return false;\n      return /^\\d+$/.test(name.slice(attemptPrefix.length, -\".json\".length));\n    }).sort();\n    const partials = fs.readdirSync(dir).filter((f) => f.startsWith(`cell-${cell}.attempt-`) && f.endsWith(\".partial\"));\n    const aborted = partials.length;\n    for (const partial of partials) {\n      const n = /attempt-(\\d+)\\.partial$/.exec(partial)?.[1];\n      if (!dispositions[`${cell}:partial-${n}`]) problems.push(`${cell}: aborted attempt ${n} without a written disposition`);\n    }\n    const attempts = [];\n    for (const name of files) {\n      const file = path.join(dir, name);\n      const record = JSON.parse(fs.readFileSync(file, \"utf8\"));\n      const problem = attemptProblem(file, record, cell);\n      if (problem) { problems.push(`${cell} ${name}: unusable (${problem})`); continue; }\n      const results = {};\n      for (const check of CHECKS) {\n        let result = record.checks[check].result;\n        if (check === \"5\" && record.measured.some((m) => m.scopeMeasurement !== \"verified\")) result = \"FAIL (scope measurement unavailable)\";\n","exit_code":0,"duration":{"secs":0,"nanos":27377}},"started_at_ms":1792934281621,"completed_at_ms":1792934281621}}
