 -t tmpfs -o size=128m,mode=0711,uid=\"$(id -u)\",gid=\"$(id -g)\" nexus-eval-ci \"$root\"\n    32\t          echo \"NEXUS_EVAL_TEST_WORKSPACE_ROOT=$root\" >> \"$GITHUB_ENV\"\n    33\t          runtime_root=/opt/nexus-eval-ci-runtime\n    34\t          sudo install -d -o \"$USER\" -g \"$USER\" -m 0711 \"$runtime_root\"\n    35\t          echo \"NEXUS_EVAL_TEST_RUNTIME_ROOT=$runtime_root\" >> \"$GITHUB_ENV\"\n    36\t      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n    37\t        with:\n    38\t          node-version: ${{ matrix.node }}\n    39\t          cache: npm\n    40\t          cache-dependency-path: cli/package-lock.json\n    41\t      - name: Install selected Node runtime for isolated evaluation commands\n    42\t        run: |\n    43\t          node_runtime=\"$(readlink -f \"$(command -v node)\")\"\n    44\t          npm_cli=\"$(readlink -f \"$(command -v npm)\")\"\n    45\t          npm_root=\"$(dirname \"$(dirname \"$npm_cli\")\")\"\n    46\t          case \"$npm_root\" in */lib/node_modules/npm) ;; *) echo \"Unexpected setup-node npm package path\" >&2; exit 1 ;; esac\n    47\t          test -f \"$npm_root/package.json\"\n    48\t          sudo install -o root -g root -m 0755 \"$node_runtime\" /usr/bin/node\n    49\t          sudo install -d -o root -g root -m 0755 /usr/lib/nexus-ci/npm\n    50\t          sudo cp -a \"$npm_root/.\" /usr/lib/nexus-ci/npm/\n    51\t          sudo chown -hR root:root /usr/lib/nexus-ci/npm\n    52\t          sudo chmod 0755 /usr/lib/nexus-ci/npm/bin/npm-cli.js\n    53\t          sudo ln -sfn /usr/lib/nexus-ci/npm/bin/npm-cli.js /usr/bin/npm\n    54\t          test \"$(/usr/bin/node --version)\" = \"$(node --version)\"\n    55\t          test \"$(env PATH=/usr/bin:/bin /usr/bin/npm --version)\" = \"$(npm --version)\"\n    56\t      - run: node scripts/sync-version.mjs --check\n    57\t      - run: node scripts/check_requirements.mjs\n    58\t      - run: npm ci --prefix cli\n    59\t      - run: npm --prefix cli run build\n    60\t      - run: git diff --exit-code -- cli/dist\n    61\t      - run: cargo test --locked --manifest-path core/Cargo.toml\n    62\t      - run: cargo build --locked --release --manifest-path core/Cargo.toml --bin harness-core --bin nexus-tui\n    63\t      - name: Install pinned security and SBOM test tools\n    64\t        run: |\n    65\t          CARGO_HOME=\"${CARGO_HOME:-$HOME/.cargo}\"\n    66\t          export CARGO_HOME\n    67\t          mkdir -p \"$CARGO_HOME/bin\"\n    68\t          echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n    69\t          export PATH=\"$CARGO_HOME/bin:$PATH\"\n    70\t          cargo install cargo-audit --locked --version 0.22.2\n    71\t          curl -fsSL https://github.com/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz | tar -xz -C \"$RUNNER_TEMP\"\n    72\t          mv \"$RUNNER_TEMP/cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny\" \"$CARGO_HOME/bin/\"\n    73\t          curl -fsSL https://github.com/CycloneDX/cyclonedx-rust-cargo/releases/download/cargo-cyclonedx-0.5.9/cargo-cyclonedx-x86_64-unknown-linux-musl.tar.xz | tar -xJ -C \"$RUNNER_TEMP\"\n    74\t          mv \"$RUNNER_TEMP/cargo-cyclonedx-x86_64-unknown-linux-musl/cargo-cyclonedx\" \"$CARGO_HOME/bin/\"\n    75\t          curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.33.1/cyclonedx-linux-x64 -o \"$CARGO_HOME/bin/cyclonedx\"\n    76\t          chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n    77\t      - run: npm --prefix cli test\n    78\t\n    79\t  linux-x86_64:\n    80\t    needs: [test-matrix]\n    81\t    runs-on: ubuntu-22.04\n    82\t    env:\n    83\t      NEXUS_BUILD_CONTAINER_IMAGE: rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb\n    84\t    steps:\n    85\t      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n    86\t      - run: sudo apt-get update && sudo apt-get in