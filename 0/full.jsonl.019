get = path.join(elsewhere, \"new\");\n+      fs.mkdirSync(parent);\n+      let swapped = false;\n+      let unlinkAttempted = false;\n+      const mutableFs = fs as unknown as { openSync: typeof fs.openSync; unlinkSync: typeof fs.unlinkSync };\n+      const originalOpenSync = fs.openSync;\n+      const originalUnlinkSync = fs.unlinkSync;\n+\n+      try {\n+        mutableFs.openSync = ((file: fs.PathLike, flags: string | number, mode?: number) => {\n+          if (!swapped && typeof file === \"string\" && path.resolve(file) === target && typeof flags === \"number\" && (flags & fs.constants.O_CREAT) !== 0) {\n+            swapped = true;\n+            fs.renameSync(parent, movedParent);\n+            fs.symlinkSync(elsewhere, parent, \"dir\");\n+          }\n+          return originalOpenSync(file, flags as number, mode);\n+        }) as typeof fs.openSync;\n+        mutableFs.unlinkSync = ((file: fs.PathLike) => {\n+          if (typeof file === \"string\" && path.resolve(file) === redirectedTarget) {\n+            unlinkAttempted = true;\n+            fs.renameSync(redirectedTarget, `${redirectedTarget}.created`);\n+            fs.writeFileSync(redirectedTarget, \"replacement owned by another process\");\n+          }\n+          return originalUnlinkSync(file);\n+        }) as typeof fs.unlinkSync;\n+        syncBuiltinESMExports();\n+\n+        assert.throws(() => writeExclusiveVerified(h, target, \"sensitive content\"), SafePathError);\n+        assert.equal(swapped, true);\n+        assert.equal(unlinkAttempted, false, \"failed verification must not unlink through a replaceable pathname\");\n+        assert.equal(fs.statSync(redirectedTarget).size, 0, \"content is not written before descriptor verification\");\n+      } finally {\n+        mutableFs.openSync = originalOpenSync;\n+        mutableFs.unlinkSync = originalUnlinkSync;\n+        syncBuiltinESMExports();\n+        if (fs.lstatSync(parent, { throwIfNoEntry: false })?.isSymbolicLink()) fs.unlinkSync(parent);\n+        if (fs.existsSync(movedParent)) fs.renameSync(movedParent, parent);\n+      }\n+    });\n+  });\n+\n+  test(\"failed directory creation never removes a pathname that may have been replaced\", async () => {\n+    await withDirs(async (h, elsewhere) => {\n+      const parent = path.join(h, \"parent\");\n+      const movedParent = path.join(h, \"parent-moved\");\n+      const target = path.join(parent, \"new\");\n+      const redirectedTarget = path.join(elsewhere, \"new\");\n+      fs.mkdirSync(parent);\n+      let swapped = false;\n+      let removalAttempted = false;\n+      const mutableFs = fs as unknown as { mkdirSync: typeof fs.mkdirSync; rmdirSync: typeof fs.rmdirSync };\n+      const originalMkdirSync = fs.mkdirSync;\n+      const originalRmdirSync = fs.rmdirSync;\n+\n+      try {\n+        mutableFs.mkdirSync = ((directory: fs.PathLike, options?: fs.MakeD\n... command output truncated for persistence ...\nN.stringify(gw.requests[0] ?? {});\n+    assert.equal(requestText.includes(TRUST_MARKER), trusted, \"project instructions load only for a trusted workspace\");\n+    assert.equal(result.approvalPrompt, mode !== \"auto\", \"approval mode is independent of folder trust\");\n+    return result;\n+  } finally {\n+    await gw.close();\n+    if (driverShutdownConfirmed) {\n+      fs.rmSync(parent, { recursive: true, force: true });\n+      fs.rmSync(home, { recursive: true, force: true });\n+    }\n+  }\n+}\n+\n+ptyTest(\"ACC-SAFE-01: launcher permission mode is independent of folder trust\", { timeout: 900_000 }, async () => {\n+  assert.ok(fs.existsSync(INDEX), `missing ${INDEX} (run npm run build)`);\n+  assert.ok(fs.existsSync(STARTUP_DRIVER), `missing ${STARTUP_DRIVER}`);\n+  const cases = [];\n+  for (const surface of [\"tui\", \"repl\"] as const) {\n+    for (const trusted of [false, true]) {\n+      for (const mode of [\"review\", \"auto\", undefined] as const) {\n+        cases.push(await runStartupPermissionCase(surface, trusted, mode));\n+      }\n+    }\n+  }\n+  assert.equal(cases.length, 12);\n+});\n+\n+async function runVerifierSlashCase(trusted: boolean, mode: \"review\" | \"auto\", cancel = false) {\n+  const canary = `NEXUS_SAFE10_CHILD_${process.pid}_${Date.now()}`;\n+  const slowScript = [\n+    \"const fs = require('fs');\",\n+    `const canary = ${JSON.stringify(canary)};`,\n+    `const child = require('child_process').spawn('bash', ['-c', 'exec -a \"$1\" sleep 30', 'nexus-safe10', canary], { stdio: 'ignore' });`,\n+    \"fs.writeFileSync('started', canary);\",\n+    \"child.once('spawn', () => fs.writeFileSync('started', canary));\",\n+    \"child.once('error', (error) => fs.writeFileSync('spawn-error', String(error)));\",\n+    \"child.on('exit', (code, signal) => { if (code === 0 && !signal) fs.writeFileSync('finished', 'yes'); });\",\n+  ].join(\"\\n\") + \"\\n\";\n+  const quickScript = [\n+    \"const fs = require('fs');\",\n+    \"fs.writeFileSync('started', 'yes');\",\n+    \"fs.writeFileSync('mounts.txt', fs.readFileSync('/proc/self/mountinfo', 'utf8'));\",\n+    \"fs.writeFileSync('sentinel.txt', 'ran');\",\n+  ].join(\"\\n\") + \"\\n\";\n+  const repo = makeRepo({\n+    \"package.json\": JSON.stringify({ name: \"nexus-verifier-fixture\", scripts: { test: \"node test.js\" } }, null, 2) + \"\\n\",\n+    \"test.js\": cancel ? slowScript : quickScript,\n+  });\n+  const home = makeHome();\n+  if (trusted) trustWorkspace(home, repo);\n+  const gw = await startGateway(() => ({ kind: \"text\", content: \"unused\" }));\n+  const args = [\"--mode\", mode, \"--sandbox\", \"bwrap\", \"-w\", repo, \"-e\", gw.url, \"-m\", \"m\"];\n+  const plan = { node: process.execPath, index: INDEX, args, cwd: repo, home, surface: \"tui\", trusted, mode, kind: \"verifier\", cancel, canary };\n+  const planFile = path.join(home, \"verifier-plan.json\");\n+  fs.writeFileSync(planFile, JSON.stringify(plan));\n+  let driverShutdownConfirmed = false;\n+  try {\n+    const { code, out, err } = await new Promise<{ code: number | null; out: string; err: string }>((resolve) => {\n+      const child = spawn(\"python3\", [STARTUP_DRIVER, planFile], { stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n+      let out = \"\";\n+      let err = \"\";\n+      child.stdout.on(\"data\", (chunk) => (out += chunk));\n+      child.stderr.on(\"data\", (chunk) => (err += chunk));\n+      child.on(\"close\", (exitCode) => resolve({ code: exitCode, out, err }));\n+    });\n+    driverShutdownConfirmed = code === 0;\n+    assert.equal(code, 0, `verifier /test ${trusted ? \"trusted\" : \"untrusted\"}/${mode}${cancel ? \"/cancel\" : \"\"} failed:\\n${err}\\n${out}`);\n+    const result = JSON.parse(out.trim().split(\"\\n\").at(-1)!);\n+    assert.equal(result.approvalPrompt, mode === \"review\");\n+    if (cancel) {\n+      assert.ok(result.cancelSeconds < 5, `Escape cancellation exceeded five seconds: ${result.cancelSeconds}`);\n+      assert.ok(fs.existsSync(path.join(repo, \"started\")), \"the verifier started before cancellation\");\n+      assert.ok(!fs.existsSync(path.join(repo, \"finished\")), \"the cancelled verifier did not complete normally\");\n+      const startedCanary = fs.readFileSync(path.join(repo, \"started\"), \"utf8\");\n+      assert.equal(startedCanary, canary, \"the fixture recorded its unique descendant-process canary\");\n+      assert.equal(result.canaryVisibleBeforeCancel, true, \"the verifier descendant was visible from host /proc before cancellation\");\n+      const remaining = await waitForCanaryProcesses(canary, false, 3_000);\n+      assert.deepEqual(remaining, [], `cancelled verifier left descendant process(es) alive: ${remaining.join(\", \")}`);\n+    } else {\n+      assert.equal(fs.readFileSync(path.join(repo, \"sentinel.txt\"), \"utf8\"), \"ran\");\n+      const mounts = fs.readFileSync(path.join(repo, \"mounts.txt\"), \"utf8\");\n+      const hasWorkspaceMount = mounts.split(\"\\n\").some((line) => line.split(\" \")[4] === repo);\n+      assert.ok(hasWorkspaceMount, \"the verifier observed its workspace bind mount in /proc/self/mountinfo\");\n+    }\n+    return result;\n+  } finally {\n+    await gw.close();\n+    await terminateCanaryProcesses(canary);\n+    if (driverShutdownConfirmed) {\n+      fs.rmSync(repo, { recursive: true, force: true });\n+      fs.rmSync(home, { recursive: true, force: true });\n+    }\n+  }\n+}\n+\n+function canaryProcesses(canary: string): number[] {\n+  return fs.readdirSync(\"/proc\").filter((entry) => /^\\d+$/.test(entry)).flatMap((pid) => {\n+    try {\n+      const argv = fs.readFileSync(path.join(\"/proc\", pid, \"cmdline\"), \"utf8\").split(\"\\0\").filter(Boolean);\n+      const processName = fs.readFileSync(path.join(\"/proc\", pid, \"comm\"), \"utf8\").trim();\n+      return argv[0] === canary && argv[1] === \"30\" && processName === \"sleep\" ? [Number(pid)] : [];\n+    } catch (error) {\n+      const code = (error as NodeJS.ErrnoException).code;\n+      if (code === \"ENOENT\" || code === \"ESRCH\") return [];\n+      throw error;\n+    }\n+  });\n+}\n+\n+async function waitForCanaryProcesses(canary: string, expected: boolean, timeoutMs: number): Promise<number[]> {\n+  const deadline = Date.now() + timeoutMs;\n+  let pids: number[] = [];\n+  do {\n+    pids = canaryProcesses(canary);\n+    if ((pids.length > 0) === expected) return pids;\n+    await new Promise((resolve) => setTimeout(resolve, 50));\n+  } while (Date.now() < deadline);\n+  return pids;\n+}\n+\n+async function terminateCanaryProcesses(canary: string): Promise<void> {\n+  let pids = canaryProcesses(canary);\n+  for (const pid of pids) {\n+    try { process.kill(pid, \"SIGTERM\"); } catch (error) {\n+      if ((error as NodeJS.ErrnoException).code !== \"ESRCH\") throw error;\n+    }\n+  }\n+  pids = await waitForCanaryProcesses(canary, false, 1_000);\n+  for (const pid of pids) {\n+    try { process.kill(pid, \"SIGKILL\"); } catch (error) {\n+      if ((error as NodeJS.ErrnoException).code !== \"ESRCH\") throw error;\n+    }\n+  }\n+  await waitForCanaryProcesses(canary, false, 1_000);\n+}\n+\n+ptyTest(\"ACC-SAFE-09/10: /test approval, trust independence, sandbox and cancellation\", { timeout: 360_000 }, async () => {\n+  for (const trusted of [false, true]) {\n+    for (const mode of [\"review\", \"auto\"] as const) {\n+      await runVerifierSlashCase(trusted, mode);\n+    }\n+  }\n+  await runVerifierSlashCase(true, \"review\", true);\n+});\ndiff --git a/cli/test/upgrade_acceptance.test.ts b/cli/test/upgrade_acceptance.test.ts\nindex c0677031..b1c554b4 100644\n--- a/cli/test/upgrade_acceptance.test.ts\n+++ b/cli/test/upgrade_acceptance.test.ts\n@@ -314,6 +314,79 @@ describe(\"Public Release Upgrade Acceptance (REQ-REL-116, ACC-UPG-07..14)\", () =\n     assert.equal(journal.state, \"complete\");\n   });\n \n+  it(\"refuses an upgrade that requires attestation when gh is unavailable\", async () => {\n+    const oldVersion = \"v0.1.0-alpha.2\";\n+    const vOldDir = setupInstalledVersion(tmpPrefix, oldVersion);\n+    fs.mkdirSync(path.join(tmpPrefix, \"bin\"), { recursive: true });\n+    fs.symlinkSync(path.join(vOldDir, \"bin\", \"nexus\"), path.join(tmpPrefix, \"bin\", \"nexus\"));\n+\n+    const installed = detectInstallation({ nexusHome: vOldDir, envPrefix: tmpPrefix });\n+    const target = await resolveTargetRelease(undefined, { timeoutMs: 5000 });\n+    const comparison = compareInstallationWithRelease(installed, target);\n+    assert.equal(comparison.action, \"upgrade\");\n+\n+    const savedPath = process.env.PATH;\n+    const savedAttestation = process.env.NEXUS_VERIFY_ATTESTATION;\n+    // A PATH shim that claims success must not satisfy *required* attestation, and an empty trusted-path list must\n+    // fail closed without spawning it.\n+    const shim = path.join(tmpPrefix, \"gh-shim\");\n+    fs.mkdirSync(shim);\n+    const marker = path.join(tmpPrefix, \"gh-shim-executed\");\n+    fs.writeFileSync(path.join(shim, \"gh\"), `#!/bin/sh\\n: > '${marker}'\\nexit 0\\n`, { mode: 0o755 });\n+    fs.chmodSync(path.join(shim, \"gh\"), 0o755);\n+    process.env.PATH = shim;\n+    process.env.NEXUS_VERIFY_ATTESTATION = \"1\";\n+    try {\n+      await assert.rejects(\n+        performUpgrade(comparison, { prefix: tmpPrefix, timeoutMs: 5000, trustedGhPaths: [] }),\n+        /no trusted GitHub CLI was found at \\/usr\\/bin\\/gh/,\n+        \"a required attestation must fail closed when no trusted gh exists\",\n+      );\n+      assert.equal(fs.existsSync(marker), false, \"the PATH gh shim was executed\");\n+      assert.equal(readJournal(tmpPrefix), null, \"required attestation must fail before starting the journal\");\n+      const libEntries = fs.existsSync(path.join(tmpPrefix, \"lib\", \"nexus\"))\n+        ? fs.readdirSync(path.join(tmpPrefix, \"lib\", \"nexus\"))\n+        : [];\n+      assert.equal(\n+        libEntries.some((name) => name.startsWith(\".tmp-upgrade-\") || name === \".upgrade-journal.json\"),\n+        false,\n+        \"required attestation must not leave upgrade staging or a journal\",\n+      );\n+    } finally {\n+      if (savedPath === undefined) delete process.env.PATH;\n+      else process.env.PATH = savedPath;\n+      if (savedAttestation === undefined) delete process.env.NEXUS_VERIFY_ATTESTATION;\n+      else process.env.NEXUS_VERIFY_ATTESTATION = savedAttestation;\n+    }\n+  });\n+\n+  it(\"rejects required attestation when the trusted gh reports failure\", async () => {\n+    const oldVersion = \"v0.1.0-alpha.2\";\n+    const vOldDir = setupInstalledVersion(tmpPrefix, oldVersion);\n+    fs.mkdirSync(path.join(tmpPrefix, \"bin\"), { recursive: true });\n+    fs.symlinkSync(path.join(vOldDir, \"bin\", \"nexus\"), path.join(tmpPrefix, \"bin\", \"nexus\"));\n+\n+    const installed = detectInstallation({ nexusHome: vOldDir, envPrefix: tmpPrefix });\n+    const target = await resolveTargetRelease(undefined, { timeoutMs: 5000 });\n+    const comparison = compareInstallationWithRelease(installed, target);\n+\n+    const failingGh = path.join(tmpPrefix, \"trusted-gh\");\n+    fs.writeFileSync(failingGh, \"#!/bin/sh\\nexit 1\\n\", { mode: 0o755 });\n+    fs.chmodSync(failingGh, 0o755);\n+    const savedAttestation = process.env.NEXUS_VERIFY_ATTESTATION;\n+    process.env.NEXUS_VERIFY_ATTESTATION = \"1\";\n+    try {\n+      await assert.rejects(\n+        performUpgrade(comparison, { prefix: tmpPrefix, timeoutMs: 5000, trustedGhPaths: [failingGh] }),\n+        /Provenance attestation verification failed for .* or SHA256SUMS/,\n+        \"a trusted gh reporting failure must reject required attestation\",\n+      );\n+    } finally {\n+      if (savedAttestation === undefined) delete process.env.NEXUS_VERIFY_ATTESTATION;\n+      else process.env.NEXUS_VERIFY_ATTESTATION = savedAttestation;\n+    }\n+  });\n+\n   it(\"refuses downgrade when target release has incompatible state schema version\", async () => {\n     // Current installation at v1.0.0\n     const v1Dir = setupInstalledVersion(tmpPrefix, \"v1.0.0\");\ndiff --git a/docs/reviews/evidence/v1-qualification/sec101-119-pty-20261025.md b/docs/reviews/evidence/v1-qualification/sec101-119-pty-20261025.md\nnew file mode 100644\nindex 00000000..f79e7982\n--- /dev/null\n+++ b/docs/reviews/evidence/v1-qualification/sec101-119-pty-20261025.md\n@@ -0,0 +1,45 @@\n+# Source evidence: REQ-SEC-101 and REQ-SEC-119\n+\n+## Candidate identity\n+\n+- Source commit: `3ec79ce0f1b6053752c942f1465221465350085c`\n+- Branch: `v1/plan-01-sec101-119-pty-followup`\n+- Package version: `1.0.0-rc.4` (build metadata only; no RC artifact was created)\n+- Independent source review: **ACCEPT**, reviewer `current_main_rc_path_audit`\n+\n+## Evidence\n+\n+All commands ran in the isolated candidate worktree with a temporary `HOME` and `XDG_CONFIG_HOME`.\n+\n+- `npm run build` in `cli/`: passed on the candidate commit.\n+- `node --import=tsx --test --test-concurrency=1 --test-name-pattern='ACC-SAFE-01' test/repl_approval_e2e.test.ts` in `cli/`: 1 test passed. The test launches the actual `nexus` TUI and `nexus repl` in trusted and untrusted workspaces with explicit `review`, explicit `auto`, and unset mode. It verifies that unset mode prompts in both trust states, auto mode executes, review mode denies without approval, and project instructions load only after trust.\n+- `node --import=tsx --test --test-concurrency=1 --test-name-pattern='ACC-SAFE-09/10' test/repl_approval_e2e.test.ts` in `cli/`: 1 test passed. It verifies `/test` approval disclosure, trust-independent review and auto behavior, actual bwrap workspace mounting, and Escape cancellation. Before cancellation the driver confirms the unique `sleep 30` descendant is visible in the host `/proc` by exact argv and process name; after Escape the test requires the process to disappear within three seconds. The fixture terminates any remaining canary before cleanup if an assertion fails.\n+- `python3 -m py_compile cli/test/helpers/startup_permission_driver.py`: passed.\n+- `git diff --check`: passed.\n+\n+The source tests cover the applicable source acceptance criteria. They do not claim installed-RC qualification, held-out qualification, cross-runner qualification, or human terminal acceptance. Those release gates remain pending.\n+\n+## Rebased candidate revalidation\n+\n+The source changes were rebased onto the then-current `origin/main` at `19b30a4c92b8dd2c891c5b7a5b67db319ee9ee7f`. The implementation/test commit is `e950505f692b22bf29790f47edf8273b2c0264d1`; the complete revalidated candidate before this documentation-only amendment is `4c51ae1e1f46a6267606a601660dcc644e4136e6`.\n+\n+On that exact candidate, under isolated `HOME` and `XDG_CONFIG_HOME`:\n+\n+- `npm run build` in `cli/`: passed.\n+- Focused `ACC-SAFE-01` PTY test: 1/1 passed.\n+- Focused `ACC-SAFE-09/10` PTY test: 1/1 passed.\n+- `node scripts/check_requirements.mjs --enforce`: passed (123 rows; 108 tested, 6 partial, 2 implemented, 7 open; 12 exact-RC deferrals).\n+\n+This revalidation confirms source-level evidence on the rebased candidate only. It does not satisfy exact-RC, held-out, cross-runner, or human terminal qualification.\n+\n+## CI-exposed PTY matcher correction\n+\n+PR CI run `40152382285` on candidate `9a27e194050aa8089de4fe28537e5f8e564b7452` failed the new `ACC-SAFE-09/10` PTY case on Node 22 and Node 24 because the helper expected terminal output with spaces removed, while `/test` renders `Test suite passed.` and `Test suite failed.`. No product behavior failure was established by that run.\n+\n+The test helper was corrected in source commit `93d0fa460517bf60fe5817cf4b51278498ec8d0e`. It now scopes pass-result matching to output received since `/test` was invoked and cancellation-result matching to output received since Escape was sent, preventing older transcript text from satisfying the result check. The focused `ACC-SAFE-09/10` PTY test passed 1/1 in 41.8 seconds with isolated `HOME` and `XDG_CONFIG_HOME`; Python compilation and `git diff --check` passed. Independent read-only review disposition: **ACCEPT**.\n+\n+This is a local source-test result on commit `93d0fa460517bf60fe5817cf4b51278498ec8d0e`; fresh exact-head hosted CI is still required. Exact-RC, held-out, cross-runner, and human terminal qualification remain pending.\n+\n+## Disposition\n+\n+Source behavior for REQ-SEC-101 and REQ-SEC-119 is tested at the exact candidate tree. The evidence does not promote either requirement to product-qualified status.\ndiff --git a/docs/reviews/evidence/v1/DEFECT-UPGRADE-ATTESTATION-20261025/README.md b/docs/reviews/evidence/v1/DEFECT-UPGRADE-ATTESTATION-20261025/README.md\nnew file mode 100644\nindex 00000000..03614490\n--- /dev/null\n+++ b/docs/reviews/evidence/v1/DEFECT-UPGRADE-ATTESTATION-20261025/README.md\n@@ -0,0 +1,59 @@\n+# DEFECT: required provenance attestation was skipped when `gh` was missing or PATH-shadowed\n+\n+| | |\n+|---|---|\n+| Base revision | `19b30a4c92b8dd2c891c5b7a5b67db319ee9ee7f` (`origin/main`) |\n+| Branch | `v1/defect-upgrade-attestation` |\n+| Affected behavior | With `NEXUS_VERIFY_ATTESTATION=1`, upgrade only ran attestation when `spawnSync(\"gh\", [\"--version\"])` succeeded. If `gh` was absent (or a PATH shim failed the probe), the whole block was skipped and the upgrade proceeded as verified—fail-open. Because `gh` was resolved from PATH, a shim that exits 0 for the probe and both `gh attestation verify` calls could also claim verification without a real check. |\n+| Severity | Medium: an explicitly required supply-chain proof could be silently omitted or spoofed during upgrade. |\n+\n+## Reproduction (pre-fix)\n+\n+The new acceptance test uses the existing local release server, sets `NEXUS_VERIFY_ATTESTATION=1`, and puts a `gh`\n+shim that exits 0 first in `PATH`. On the base source `performUpgrade` succeeded with no rejection:\n+\n+```\n+✖ refuses an upgrade that requires attestation when gh is unavailable\n+  AssertionError: Missing expected rejection: a required attestation must fail closed when gh is missing\n+```\n+\n+The same happens with `gh` absent entirely (empty PATH): the probe fails and the required check is skipped.\n+\n+## Fix\n+\n+Resolve `gh` only at trusted system paths (`/usr/bin/gh`, `/usr/local/bin/gh`), never from `PATH`. If verification is\n+required and no trusted `gh` exists, fail the upgrade with an explicit error. The default `auto` mode still skips when\n+`gh` is absent, as before; a trusted `gh` that reports a failed attestation still fails when required.\n+\n+## Verification\n+\n+- New acceptance test (`refuses an upgrade that requires attestation when gh is unavailable`) injects an empty\n+  trusted-path list, puts a marker-writing `gh` shim (shell redirection, no external `touch`) in PATH, and asserts the\n+  exact “no trusted GitHub CLI” error, that the shim never ran, that no journal was written, and that no\n+  `.tmp-upgrade-*` staging was left behind. It fails on the base source (upgrade succeeds through the PATH shim) and\n+  passes after; this host has `/usr/bin/gh`, so the injected path list is what makes the test pin the\n+  missing-trusted-binary branch rather than the pre-existing attestation-failure branch.\n+- A second hermetic test injects a trusted fake `gh` that exits 1 and verifies required mode still rejects with the\n+  attestation-failure error. It does not touch the network.\n+- The required-attestation precondition is checked before the journal/download transaction; the test asserts\n+  `readJournal(tmpPrefix) === null` and no staging/journal entry after the rejection.\n+- Full `upgrade_acceptance.test.ts` 8/8; `npx tsc --noEmit`; `git diff --check`.\n+- The two new tests are hermetic: the existing mock release server provides the archive, checksums and compatibility\n+  metadata, and both inject `trustedGhPaths`, so no `gh` process is spawned. Other pre-existing auto-mode tests in the\n+  suite may use a host-installed `/usr/bin/gh` and are outside this slice.\n+\n+## Residual risk\n+\n+- `gh` outside the two trusted paths (Homebrew, snap, nix, custom prefix) is no longer used. In `auto` mode this is a\n+  deliberate tightening but also a behavior change: those hosts silently skip attestation where they previously\n+  verified it. With `NEXUS_VERIFY_ATTESTATION=1` the upgrade fails closed, so they must install `gh` at a trusted path\n+  or opt out explicitly.\n+- `install.sh` still has the original fail-open pattern: it resolves `gh` with `command -v gh` and skips the whole\n+  block when absent, even with `NEXUS_VERIFY_ATTESTATION=1`. Fixing the installer is a follow-up outside this CLI\n+  slice; it is not claimed fixed here.\n+- The trusted `gh` binary is assumed provisioned by the OS/package manager; trusted paths are checked with\n+  `existsSync` (symlinks are followed) and ownership/executability are not independently verified.\n+- Attestation remains optional by default (`auto`), and a trusted `gh` present but failing is still only fatal with\n+  `NEXUS_VERIFY_ATTESTATION=1`.\n+- The early error text names `/usr/bin/gh` and `/usr/local/bin/gh` even when a test/embedding caller injects other\n+  trusted paths; `trustedGhPaths` is an internal test/embedding hook and is not wired to CLI input.\ndiff --git a/docs/v1.0.0/REQUIREMENTS.md b/docs/v1.0.0/REQUIREMENTS.md\nindex 29524d85..36a1d2ea 100644\n--- a/docs/v1.0.0/REQUIREMENTS.md\n+++ b/docs/v1.0.0/REQUIREMENTS.md\n@@ -116,10 +116,10 @@ Every row has status **open** at `db1ca55` unless stated otherwise. In the \"Evid\n \n | ID | Source | Requirement (short; full text in spec) | Rationale | Implementation location | Evidence | Status | Acceptance | Class | Finding | Spec / Plan |\n |---|---|---|---|---|---|---|---|---|---|---|\n-| REQ-SEC-101 | Audit; DEC-01 (amended 2026-10-24) | Without operator opt-in, model-initiated exec and egress require the configured permission decision. Folder trust does not select or change approval mode; unset mode defaults to review. | safety | `config.ts`, `sidecar.ts`, `repl.ts`, `index.ts`, `core/approval_policy.ts` | TEST `test:cli/test/approval_policy.test.ts::\"REQ-SEC-101: the unset mode stays review in trusted and untrusted workspaces\"`; `test:cli/test/config.test.ts::\"workspace trust does not select the tool approval mode\"`; PTY ACC-SAFE-01 still pending | partial | ACC-SAFE-01 | **B** | SEC-01, TUI-07 | SPEC-01 / PLAN-01 |\n+| REQ-SEC-101 | Audit; DEC-01 (amended 2026-10-24) | Without operator opt-in, model-initiated exec and egress require the configured permission decision. Folder trust does not select or change approval mode; unset mode defaults to review. | safety | `config.ts`, `sidecar.ts`, `repl.ts`, `index.ts`, `core/approval_policy.ts` | TEST `test:cli/test/approval_policy.test.ts::\"REQ-SEC-101: the unset mode stays review in trusted and untrusted workspaces\"`; `test:cli/test/config.test.ts::\"workspace trust does not select the tool approval mode\"`; PTY `test:cli/test/repl_approval_e2e.test.ts::\"ACC-SAFE-01: launcher permission mode is independent of folder trust\"`; evidence `docs/reviews/evidence/v1-qualification/sec101-119-pty-20261025.md` | tested | ACC-SAFE-01 | **B** | SEC-01, TUI-07 | SPEC-01 / PLAN-01 |\n | REQ-SEC-102 | Audit; TOP_TIER B1 | Every capability has an effect class. Review gates every class except read. The gate is enforced at dispatch from the registry. | safety | `core/capabilities.ts`, `agent.ts:3945` | TEST `approval_policy.test.ts` | tested | ACC-SAFE-02 | **B** | HIST-05, SEC-03 | SPEC-01 / PLAN-01 |\n | REQ-SEC-103 | Audit | No approval is decided by Enter alone, typed-ahead input, paste, or input inside the grace window, on any surface. | safety | `repl.ts:291-355,444-495`, `tui_approval_input_e2e.test.ts`, `repl_approval_e2e.test.ts` | PTY (ACC-SAFE-03, ACC-SAFE-08) | tested | ACC-SAFE-03, ACC-SAFE-08 | **B** | TUI-02, TUI-03 | SPEC-01 / PLAN-01 |\n-| REQ-SEC-119 | Audit; DEC-01 (amended 2026-10-24) | Nexus-initiated verifier runs are `exec` class and follow configured permission mode; review requires a one-time approval showing the script body. Folder trust alone does not authorize execution; all runs are routed through the runner. | safety | `agent.ts:1654,3544,4255`; `tester.ts:145`; `verifier_gating.test.ts` | TEST `test:cli/test/verifier_gating.test.ts::\"trusted and untrusted repos in review mode prompt for verifier and script body, write sentinel only after approval, and cache session decision\"`; `test:cli/test/verifier_gating.test.ts::\"denied verifier does not execute verifier and sentinel is not written\"`; `test:cli/test/harness.test.ts::\"run_tests keeps repository test side effects inside worktree authority and honors read-only, dry-run, and required sandbox\"`; PTY ACC-SAFE-09/10 still pending | partial | ACC-SAFE-09, ACC-SAFE-10 | **B** | VER-01, VER-14 | SPEC-01 / PLAN-01 |\n+| REQ-SEC-119 | Audit; DEC-01 (amended 2026-10-24) | Nexus-initiated verifier runs are `exec` class and follow configured permission mode; review requires a one-time approval showing the script body. Folder trust alone does not authorize execution; all runs are routed through the runner. | safety | `agent.ts:1654,3544,4255`; `tester.ts:145`; `verifier_gating.test.ts`; `workspace_commands.ts` | TEST `test:cli/test/verifier_gating.test.ts::\"trusted and untrusted repos in review mode prompt for verifier and script body, write sentinel only after approval, and cache session decision\"`; `test:cli/test/verifier_gating.test.ts::\"denied verifier does not execute verifier and sentinel is not written\"`; `test:cli/test/harness.test.ts::\"run_tests keeps repository test side effects inside worktree authority and honors read-only, dry-run, and required sandbox\"`; PTY `test:cli/test/repl_approval_e2e.test.ts::\"ACC-SAFE-09/10: /test approval, trust independence, sandbox and cancellation\"`; evidence `docs/reviews/evidence/v1-qualification/sec101-119-pty-20261025.md` | tested | ACC-SAFE-09, ACC-SAFE-10 | **B** | VER-01, VER-14 | SPEC-01 / PLAN-01 |\n | REQ-SEC-104 | Audit | `--read-only` cannot read outside the workspace through commands. HOME is masked. | safety | `sandbox.ts`, `core/authority.ts:44-136` | RT (SEC-04) | tested | ACC-SAFE-04 | RR | SEC-04 | SPEC-01 / PLAN-01 |\n | REQ-TUI-102 | Audit | The startup banner states mode, sandbox and trust. Doctor reports the posture. | safety / UX | `sidecar.ts`, `live_view.rs`, `repl.ts`, `doctor.ts` | TEST `tui_surface_e2e.test.ts`, `doctor.test.ts` | tested | ACC-SAFE-06 | RR | TUI-07 | SPEC-01 / PLAN-01 |\n | REQ-SEC-108 | Audit | The command denylist is labelled a tripwire, and its false positives are fixed. | honesty / workflow | `security.ts`, `runner.rs:64-107` | RT (SEC-02) | tested | ACC-SAFE-07 | RR | SEC-02, DOC-01 | SPEC-01 / PLAN-01 |\ndiff --git a/docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md b/docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md\nindex 145e3e33..9dc10b77 100644\n--- a/docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md\n+++ b/docs/v1.0.0/specs/SPEC-12-cli-and-tui-upgrade.md\n@@ -92,7 +92,9 @@ The upgrade capability is implemented in `cli/src/upgrade.ts` as a pure, testabl\n - **Integrity**:\n   - Downloads release tarball and `SHA256SUMS`.\n   - Computes SHA-256 of downloaded archive; compares with published checksum.\n-  - If `gh` is installed and `NEXUS_VERIFY_ATTESTATION != 0`, verifies GitHub build provenance attestation.\n+  - If a trusted `gh` exists at `/usr/bin/gh` or `/usr/local/bin/gh` and `NEXUS_VERIFY_ATTESTATION != 0`, verifies\n+    GitHub build provenance attestation. `PATH`-resolved `gh` is not used; with `NEXUS_VERIFY_ATTESTATION=1`, a\n+    missing trusted `gh` fails closed.\n   - Extracts to staging directory; validates `bin/nexus`, `lib/core/harness-core`, `lib/core/nexus-tui`, and `VERSION`.\n   - Verifies package `MANIFEST.sha256` if present.\n \ndiff --git a/install.sh b/install.sh\nindex 6fa3da8c..cd7db1bc 100644\n--- a/install.sh\n+++ b/install.sh\n@@ -18,6 +18,21 @@ command -v curl >/dev/null 2>&1 || fail \"curl is required.\"\n command -v tar >/dev/null 2>&1 || fail \"tar is required.\"\n command -v sha256sum >/dev/null 2>&1 || fail \"sha256sum is required.\"\n \n+VERIFY_ATTESTATION=${NEXUS_VERIFY_ATTESTATION:-1}\n+case \"$VERIFY_ATTESTATION\" in\n+  0|1) ;;\n+  *) fail \"NEXUS_VERIFY_ATTESTATION must be 1 (verify provenance) or 0 (explicitly skip verification).\" ;;\n+esac\n+TRUSTED_GH=\n+if [ -x /usr/bin/gh ]; then\n+  TRUSTED_GH=/usr/bin/gh\n+elif [ -x /usr/local/bin/gh ]; then\n+  TRUSTED_GH=/usr/local/bin/gh\n+fi\n+if [ \"$VERIFY_ATTESTATION\" = \"1\" ] && [ -z \"$TRUSTED_GH\" ]; then\n+  fail \"provenance attestation is required (NEXUS_VERIFY_ATTESTATION=1) but no trusted GitHub CLI was found at /usr/bin/gh or /usr/local/bin/gh; install gh or set NEXUS_VERIFY_ATTESTATION=0.\"\n+fi\n+\n validate_tag() {\n   printf '%s' \"$1\" | grep -Eq '^v[0-9]+\\.[0-9]+\\.[0-9]+(-[-0-9A-Za-z.]+)?$' || fail \"version must be a release tag like v1.2.3 or v1.2.3-alpha.1 (got: $1).\"\n }\n@@ -71,11 +86,11 @@ grep -F \"  $ARCHIVE\" \"$TMP/SHA256SUMS\" > \"$TMP/expected.sha256\" || fail \"checksu\n (cd \"$TMP\" && sha256sum --check --status expected.sha256) || fail \"SHA-256 verification failed; no installation was changed.\"\n ARCHIVE_SHA256=$(sha256sum \"$TMP/$ARCHIVE\" | awk '{print $1}')\n \n-if [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" != \"0\" ] && command -v gh >/dev/null 2>&1; then\n-  if gh attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n-     gh attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n+if [ \"$VERIFY_ATTESTATION\" != \"0\" ] && [ -n \"$TRUSTED_GH\" ]; then\n+  if \"$TRUSTED_GH\" attestation verify \"$TMP/$ARCHIVE\" -R \"$REPO\" >/dev/null 2>&1 && \\\n+     \"$TRUSTED_GH\" attestation verify \"$TMP/SHA256SUMS\" -R \"$REPO\" >/dev/null 2>&1; then\n     printf 'nexus installer: verified build provenance for %s and its checksum index\\n' \"$ARCHIVE\"\n-  elif [ \"${NEXUS_VERIFY_ATTESTATION:-auto}\" = \"1\" ]; then\n+  elif [ \"$VERIFY_ATTESTATION\" = \"1\" ]; then\n     fail \"provenance attestation verification failed for $ARCHIVE or SHA256SUMS.\"\n   fi\n fi\ndiff --git a/scripts/installer-smoke.sh b/scripts/installer-smoke.sh\nindex 3cb9349f..b0a3b476 100644\n--- a/scripts/installer-smoke.sh\n+++ b/scripts/installer-smoke.sh\n@@ -9,6 +9,9 @@ trap cleanup EXIT\n NAME=$(basename \"$ARCHIVE\")\n VERSION=${NAME#nexus-linux-x86_64-}\n VERSION=${VERSION%.tar.gz}\n+# This fixture uses locally generated, unattested packages except in the explicit\n+# trusted-gh case below. Make that test-only opt-out visible to every installer run.\n+export NEXUS_VERIFY_ATTESTATION=0\n mkdir -p \"$TMP/release/download/$VERSION\" \"$TMP/prefix/bin\"\n cp \"$ARCHIVE\" \"$TMP/release/download/$VERSION/$NAME\"\n (cd \"$TMP/release/download/$VERSION\" && sha256sum \"$NAME\" > SHA256SUMS)\n@@ -26,6 +29,49 @@ run_installer() {\n }\n run_installer\n \"$TMP/prefix/bin/nexus\" --version | grep -F \"${VERSION#v}\" >/dev/null\n+\n+# Attestation is required by default and must never trust a PATH shim.\n+# Relocate only the fixed trusted binary locations in a private installer copy so this\n+# fixture exercises both branches without depending on whether the host has gh installed.\n+mkdir -p \"$TMP/trusted/usr/bin\" \"$TMP/trusted/usr/local/bin\" \"$TMP/path-shim\" \"$TMP/attestation-prefix/bin\"\n+sed \"s|/usr/bin/gh|$TMP/trusted/usr/bin/gh|g; s|/usr/local/bin/gh|$TMP/trusted/usr/local/bin/gh|g\" \\\n+  \"$INSTALLER\" > \"$TMP/install-test.sh\"\n+chmod +x \"$TMP/install-test.sh\"\n+cat > \"$TMP/path-shim/gh\" <<EOF\n+#!/bin/sh\n+printf 'PATH shim invoked\\\\n' >> '$TMP/path-shim.log'\n+exit 0\n+EOF\n+chmod +x \"$TMP/path-shim/gh\"\n+if env -u NEXUS_VERIFY_ATTESTATION \\\n+  NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" \\\n+  PATH=\"$TMP/path-shim:$PATH\" sh \"$TMP/install-test.sh\" > \"$TMP/no-trusted-gh.out\" 2>&1; then\n+  echo \"installer accepted required provenance without a trusted gh\" >&2\n+  exit 1\n+fi\n+grep -F \"no trusted GitHub CLI was found\" \"$TMP/no-trusted-gh.out\" >/dev/null\n+[ ! -e \"$TMP/path-shim.log\" ] || { echo \"installer invoked PATH gh shim\" >&2; exit 1; }\n+if NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/invalid-mode\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" NEXUS_VERIFY_ATTESTATION=auto \\\n+  sh \"$INSTALLER\" > \"$TMP/invalid-mode.out\" 2>&1; then\n+  echo \"installer accepted an unsupported attestation mode\" >&2\n+  exit 1\n+fi\n+grep -F \"NEXUS_VERIFY_ATTESTATION must be\" \"$TMP/invalid-mode.out\" >/dev/null\n+cat > \"$TMP/trusted/usr/bin/gh\" <<'EOF'\n+#!/bin/sh\n+printf '%s\\n' \"$*\" >> \"$TRUSTED_GH_LOG\"\n+exit 0\n+EOF\n+chmod +x \"$TMP/trusted/usr/bin/gh\"\n+NEXUS_VERSION=\"$VERSION\" NEXUS_PREFIX=\"$TMP/attestation-prefix\" \\\n+  NEXUS_RELEASE_BASE_URL=\"http://127.0.0.1:$PORT\" NEXUS_VERIFY_ATTESTATION=1 \\\n+  TRUSTED_GH_LOG=\"$TMP/trusted-gh.log\" PATH=\"$TMP/path-shim:$PATH\" \\\n+  sh \"$TMP/install-test.sh\" > \"$TMP/trusted-gh.out\" 2>&1\n+grep -F \"verified build provenance\" \"$TMP/trusted-gh.out\" >/dev/null\n+[ \"$(wc -l < \"$TMP/trusted-gh.log\")\" -eq 2 ] || { echo \"installer did not verify both provenance subjects\" >&2; exit 1; }\n+[ ! -e \"$TMP/path-shim.log\" ] || { echo \"installer invoked PATH gh shim\" >&2; exit 1; }\n node - \"$TMP/prefix/lib/nexus/$VERSION/.provenance.json\" \"$VERSION\" \"$TMP/prefix\" \"$TMP/prefix/lib/nexus/$VERSION\" \"$TMP/prefix/bin/nexus\" \"$NAME\" \"$TMP/release/download/$VERSION/$NAME\" <<'NODE'\n const assert = require(\"node:assert/strict\");\n const crypto = require(\"node:crypto\");\n","exit_code":0,"duration":{"secs":1,"nanos":695561065}},"started_at_ms":1792919029240,"completed_at_ms":1792919030937}}
{"timestamp":"2026-10-25T09:03:52.289Z","ordinal":333884,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1724d-51e1-7aa3-a3e9-f1f00d12b63a","call_id":"call_ba943e536b81429187ab28cd4d05c773","output":[{"type":"input_text","text":"Script completed\nWall time 4.2 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 23483)\nTotal output lines: 1745\n\n{\"baseRefName\":\"main\",\"baseRefOid\":\"19b30a4c92b8dd2c891c5b7a5b67db319ee9ee7f\",\"body\":\"## Summary\\n\\nFail closed when Nexus cannot verify that its state exclusions are safely installed. The fix covers linked and nested worktrees, repository ignore precedence, safe `.nexus/` self-ignoring, verified `info/exclude` updates, and filesystem race-safe cleanup.\\n\\nThis is the no-force current-main continuation of the PR #200 work, kept on existing PR #207. Candidate `fb36b03c2ad9a22f4e94139accccee1d2f137ae3` has `main` at `016bbc332d694b32072f6346e7f3127fb98b691f` as an ancestor. Its tree is identical to reviewed candidate `7a5d4dcc3d35c68caf8a93a3bdeb2d7141101153`; the six-file source diff SHA-256 remains `55b0230bcdb125cecc263c83afbb83dc9bc54cab24ca557209a92f57d503de7a`.\\n\\n## Validation\\n\\n- `node scripts/check_requirements.mjs --enforce`: passed on candidate `7a5d4dc` with isolated HOME/XDG (123 rows; 108 tested, 6 partial, 2 implemented, 7 open; 12 exact-RC deferrals).\\n- Independent review: ACCEPT for the exact six-file diff SHA above. The ancestry-only merge changed no tree content.\\n- `git diff --check`: passed.\\n- Exact-head CI run `40169192095` and CodeQL run `40169192156` are running on `fb36b03`.\\n- Current local full-suite execution is owned by another agent and remains active. Exact-head local targeted/full tests have not yet run; no local test result is claimed here.\\n\\nThe previous PR #200 remains open to preserve its history. No installed-RC qualification or release acceptance is claimed by this PR.\\n\",\"headRefName\":\"v1/defect-git-exclude-fail-closed-current-main-20261025\",\"headRefOid\":\"fb36b03c2ad9a22f4e94139accccee1d2f137ae3\",\"mergeStateStatus\":\"BLOCKED\",\"number\":207,\"reviewDecision\":\"\",\"state\":\"CLOSED\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40169192095/job/121096397724\",\"name\":\"test-matrix (22)\",\"startedAt\":\"2026-10-25T06:28:18Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-25T06:30:18Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40169192156/job/121096397708\",\"name\":\"javascript-typescript\",\"startedAt\":\"2026-10-25T06:28:19Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CodeQL\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40169192095/job/121096397925\",\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-25T06:28:18Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-25T06:30:11Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/runs/121096712874\",\"name\":\"CodeQL\",\"startedAt\":\"2026-10-25T06:30:07Z\",\"status\":\"COMPLETED\",\"workflowName\":\"\"},{\"__typename\":\"StatusContext\",\"context\":\"CodeRabbit\",\"startedAt\":\"2026-10-25T06:28:22Z\",\"state\":\"SUCCESS\",\"targetUrl\":\"\"}],\"title\":\"fix(git): safely exclude Nexus workspace state\"}\ndiff --git a/cli/src/core/git_exclude.ts b/cli/src/core/git_exclude.ts\nindex 55975d63..b9cc4b16 100644\n--- a/cli/src/core/git_exclude.ts\n+++ b/cli/src/core/git_exclude.ts\n@@ -1,61 +1,286 @@\n import * as fs from \"node:fs\";\n import * as path from \"node:path\";\n import { execFileSync } from \"node:child_process\";\n+import { mkdirVerified, writeExclusiveVerified } from \"../safe_fs.js\";\n+\n+function openSelfIgnore(workspace: string, file: string, flags: number): number {\n+  const noFollow = fs.constants.O_NOFOLLOW;\n+  if (typeof noFollow !== \"number\") {\n+    throw new Error(\"Cannot safely access .nexus/.gitignore without O_NOFOLLOW support\");\n+  }\n+  const fd = fs.openSync(file, flags | noFollow | (fs.constants.O_NONBLOCK ?? 0));\n+  try {\n+    const stat = fs.fstatSync(fd);\n+    if (!stat.isFile() || stat.nlink > 1) {\n+      throw new Error(\"Refusing to access a non-file or hard-linked .nexus/.gitignore\");\n+    }\n+    const expected = path.join(fs.realpathSync(workspace), path.relative(path.resolve(workspace), path.resolve(file)));\n+    let descriptorPath: string | undefined;\n+    try {\n+      descriptorPath = fs.readlinkSync(`/proc/self/fd/${fd}`);\n+    } catch {\n+      // On platforms without /proc, verify the opened identity against the path.\n+    }\n+    if (descriptorPath !== undefined) {\n+      if (descriptorPath !== expected) {\n+        throw new Error(\".nexus/.gitignore changed location while it was being opened\");\n+      }\n+    } else {\n+      const named = fs.lstatSync(file);\n+      if (named.isSymbolicLink() || named.dev !== stat.dev || named.ino !== stat.ino || fs.realpathSync(file) !== expected) {\n+        throw new Error(\".nexus/.gitignore changed while it was being opened\");\n+      }\n+    }\n+    return fd;\n+  } catch (error) {\n+    fs.closeSync(fd);\n+    throw error;\n+  }\n+}\n+\n+function readSelfIgnore(workspace: string, file: string): string {\n+  const fd = openSelfIgnore(workspace, file, fs.constants.O_RDONLY);\n+  try {\n+    return fs.readFileSync(fd, \"utf-8\");\n+  } finally {\n+    fs.closeSync(fd);\n+  }\n+}\n+\n+function appendSelfIgnore(workspace: string, file: string, content: string): void {\n+  const fd = openSelfIgnore(workspace, file, fs.constants.O_WRONLY | fs.constants.O_APPEND);\n+  try {\n+    fs.writeSync(fd, content);\n+  } finally {\n+    fs.closeSync(fd);\n+  }\n+}\n+\n+function openExclude(file: string, expected: string): number {\n+  const noFollow = fs.constants.O_NOFOLLOW;\n+  if (typeof noFollow !== \"number\") {\n+    throw new Error(\"Cannot safely access Git info/exclude without O_NOFOLLOW support\");\n+  }\n+  const fd = fs.openSync(file, fs.constants.O_RDWR | fs.constants.O_APPEND | noFollow | (fs.constants.O_NONBLOCK ?? 0));\n+  try {\n+    const stat = fs.fstatSync(fd);\n+    if (!stat.isFile() || stat.nlink > 1) {\n+      throw new Error(\"Refusing to access a non-file or hard-linked Git info/exclude\");\n+    }\n+    let descriptorPath: string | undefined;\n+    try {\n+      descriptorPath = fs.readlinkSync(`/proc/self/fd/${fd}`);\n+    } catch {\n+      // On platforms without /proc, verify the opened identity against the path.\n+    }\n+    if (descriptorPath !== undefined) {\n+      if (descriptorPath !== expected) {\n+        throw new Error(\"Git info/exclude changed location while it was being opened\");\n+      }\n+    } else {\n+      const named = fs.lstatSync(file);\n+      if (named.isSymbolicLink() || named.dev !== stat.dev || named.ino !== stat.ino || fs.realpathSync(file) !== expected) {\n+        throw new Error(\"Git info/exclude changed while it was being opened\");\n+      }\n+    }\n+    return fd;\n+  } catch (error) {\n+    fs.closeSync(fd);\n+    throw error;\n+  }\n+}\n+\n+function readExclude(file: string, expected: string): string {\n+  const fd = openExclude(file, expected);\n+  try {\n+    return fs.readFileSync(fd, \"utf-8\");\n+  } finally {\n+    fs.closeSync(fd);\n+  }\n+}\n+\n+function appendExclude(file: string, expected: string, content: string): void {\n+  const fd = openExclude(file, expected);\n+  try {\n+    fs.writeSync(fd, content);\n+  } finally {\n+    fs.closeSync(fd);\n+  }\n+}\n+\n+function hasGitMarkerInAncestors(workspace: string): boolean {\n+  let current = path.resolve(workspace);\n+  while (true) {\n+    try {\n+      fs.lstatSync(path.join(current, \".git\"));\n+      return true;\n+    } catch (error) {\n+      if (typeof error !== \"object\" || error === null || !(\"code\" in error) || error.code !== \"ENOENT\") {\n+        throw new Error(\"Cannot determine whether Nexus state is inside a Git worktree\", { cause: error });\n+      }\n+    }\n+    const parent = path.dirname(current);\n+    if (parent === current) return false;\n+    current = parent;\n+  }\n+}\n \n /**\n- * Ensures .nexus/ is ignored by Git in the workspace by adding it to .git/info/exclude (REQ-PER-105).\n- * Called on first workspace write by FlightRecorder and WorktreeManager.\n+ * Ensures .nexus/ is ignored by Git in the workspace (REQ-PER-105).\n+ * The self-contained rule protects state even when Git metadata is read-only;\n+ * info/exclude remains a best-effort convenience for older clients and status output.\n  */\n export function ensureGitExclude(workspace: string): void {\n+  let excludePath: string | null = null;\n+  try {\n+    const out = execFileSync(\"git\", [\"rev-parse\", \"--git-path\", \"info/exclude\"], {\n+      cwd: workspace,\n+      encoding: \"utf-8\",\n+      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n+    }).trim();\n+    if (out) {\n+      excludePath = path.isAbsolute(out) ? out : path.resolve(workspace, out);\n+    }\n+  } catch {\n+    // Fall back only when an info/exclude file is already available without Git.\n+    const candidate = path.join(workspace, \".git\", \"info\", \"exclude\");\n+    if (fs.existsSync(path.dirname(candidate))) {\n+      excludePath = candidate;\n+    }\n+  }\n+\n+  if (!excludePath) {\n+    if (hasGitMarkerInAncestors(workspace)) {\n+      throw new Error(\"Cannot verify Nexus state is ignored because Git metadata is unavailable\");\n+    }\n+    return;\n+  }\n+\n+  let commonDirPath: string | null = null;\n+  let expectedExcludePath: string | null = null;\n+  try {\n+    const commonDir = execFileSync(\"git\", [\"rev-parse\", \"--git-common-dir\"], {\n+      cwd: workspace,\n+      encoding: \"utf-8\",\n+      stdio: [\"ignore\", \"pipe\", \"ignore\"],\n+    }).trim();\n+    commonDirPath = fs.realpathSync(path.resolve(workspace, commonDir));\n+    expectedExcludePath = path.join(commonDirPath, \"info\", \"exclude\");\n+    if (path.resolve(excludePath) !== expectedExcludePath) expectedExcludePath = null;\n+  } catch {\n+    // Updating the convenience file is optional; self-ignore verification below is authoritative.\n+  }\n+\n+  const nexusDir = path.join(workspace, \".nexus\");\n+  mkdirVerified(workspace, nexusDir);\n+  const nexusGitIgnore = path.join(nexusDir, \".gitignore\");\n   try {\n-    let excludePath: string | null = null;\n+    // Open the existing file without following links and bind the descriptor to\n+    // the expected repository path before reading it.\n+    readSe…18483 tokens truncated…forced at dispatch from the registry. | safety | `core/capabilities.ts`, `agent.ts:3945` | TEST `approval_policy.test.ts` | tested | ACC-SAFE-02 | **B** | HIST-05, SEC-03 | SPEC-01 / PLAN-01 |\n | REQ-SEC-103 | Audit | No approval is decided by Enter alone, typed-ahead input, paste, or input inside the grace window, on any surface. | safety | `repl.ts:291-355,444-495`, `tui_approval_input_e2e.test.ts`, `repl_approval_e2e.test.ts` | PTY (ACC-SAFE-03, ACC-SAFE-08) | tested | ACC-SAFE-03, ACC-SAFE-08 | **B** | TUI-02, TUI-03 | SPEC-01 / PLAN-01 |\n-| REQ-SEC-119 | Audit; DEC-01 (amended 2026-10-24) | Nexus-initiated verifier runs are `exec` class and follow configured permission mode; review requires a one-time approval showing the script body. Folder trust alone does not authorize execution; all runs are routed through the runner. | safety | `agent.ts:1654,3544,4255`; `tester.ts:145`; `verifier_gating.test.ts` | TEST `test:cli/test/verifier_gating.test.ts::\"trusted and untrusted repos in review mode prompt for verifier and script body, write sentinel on