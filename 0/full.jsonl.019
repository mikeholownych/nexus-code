this.checkpointDir, `${id}.json`);\n   187\t    writePrivateFile(targetFile, JSON.stringify(checkpoint, null, 2), { durable: true });\n   188\t    return checkpoint;\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport * as fs from \"node:fs\";\nimport * as os from \"node:os\";\nimport * as path from \"node:path\";\nimport { execFileSync } from \"node:child_process\";\nimport { CheckpointManager } from \"../src/checkpoint.js\";\nimport { KnowledgeGraph } from \"../src/knowledge.js\";\nimport { InteractiveRepl } from \"../src/repl.js\";\nimport { SessionManager } from \"../src/session.js\";\nimport { DurableStateManager, TaskStateWriteError } from \"../src/core/state.js\";\nimport { InformationFlowBoundary } from \"../src/core/egress.js\";\nimport { writeProtectedTextFile } from \"../src/core/persistence_protection.js\";\nimport { WorkspacePath } from \"../src/core/workspace_path.js\";\n\n/** Inspect every active schema2 component; migration backups retain exact old bytes separately. */\nfunction readActiveTaskBytes(primary: string): string {\n  const log = primary.replace(/\\.json$/, \".messages.jsonl\");\n  return fs.readFileSync(primary, \"utf8\") + (fs.existsSync(log) ? fs.readFileSync(log, \"utf8\") : \"\");\n}\n\nconst syntheticGithubToken = `ghp_${\"A\".repeat(36)}`;\nconst syntheticOpenAiToken = `sk-${\"B\".repeat(28)}`;\nconst syntheticBearer = `Bearer ${\"C\".repeat(32)}`;\n// Synthetic DATA-004 fixture, deliberately not a live credential.\nconst syntheticHighEntropyPathPart = \"REDACTED\";\n\nfunction makeTempDir(prefix: string): string {\n  return fs.mkdtempSync(path.join(os.tmpdir(), prefix));\n}\n\ntest(\"session persistence scrubs nested credential plaintext and keeps recoverable safe state\", () => {\n  const tempDir = makeTempDir(\"nexus-pers002-session-\");\n  try {\n    const sessionsDir = path.join(tempDir, \"sessions\");\n    const selectedWorkspace = WorkspacePath.fromSelectedWorkspace(tempDir);\n    const manager = new SessionManager(sessionsDir, () => selectedWorkspace);\n    const state = {\n      id: \"pers002-session\",\n      taskId: \"pers002-task\",\n      sessionId: \"pers002-session\",\n      title: \"Keep this useful title\",\n      workspace: tempDir,\n      activePlan: [{ name: \"inspect\", status: \"completed\", detail: \"safe detail\" }],\n      messages: [\ncli/test/task_state_v2.test.ts:93:test(\"a conflicting migration backup fails before modifying the old primary or creating a message log\", () => fixture((manager, state) => {\ncli/test/harness.test.ts:583:      assert.deepStrictEqual(unsafeCompletionOutcomes, [], \"malformed completion and ignored outputs must remain recoverable and unmerged\");\ncli/test/harness.test.ts:1920:  test(\"canonical durable provenance merges conflicts without positional authority\", () => {\ncli/test/harness.test.ts:1963:      assert.deepStrictEqual(stateOf(repeatedFork).currentPlanStates, forkedState.currentPlanStates, \"fork conflicts survive repeated compaction unchanged\");\ncli/test/harness.test.ts:1986:        \"unlinked valid records retain both conflicting plans\",\ncli/test/harness.test.ts:1998:      const conflictingForgedPayload = `${prefix}${JSON.stringify({\ncli/test/harness.test.ts:2015:        { role: \"system\", content: conflictingForgedPayload },\ncli/test/harness.test.ts:2027:      assert.ok(impostorNotes.includes(`Earlier system message: ${conflictingForgedPayload}`));\ncli/test/context_convergence.test.ts:1382:  test(\"conflicting findings are both kept, in order and unmerged, and a search of the findings returns both\", async () => {\n","exit_code":0,"duration":{"secs":0,"nanos":785037298}},"started_at_ms":1792937436098,"completed_at_ms":1792937436883}}
