kage-linux.sh || \\\n57:             ! grep -Fq 'check_deprecated_lock.mjs' scripts/package-linux.sh || \\\n58:             grep -Eq '(^|[[:space:]])npx([[:space:]]|$)' scripts/package-linux.sh scripts/generate_sbom.sh; then\n59-            echo \"The selected RC predates or bypasses the locked notices tool and lock deprecation gate; cross-runner reproduction requires an RC whose tag includes them.\" >&2\n60-            exit 1\n--\n88-          fetch-depth: 0\n89-          persist-credentials: false\n90:      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n91-        with:\n92-          node-version: 22.22.1\n93:          cache: npm\n94-          cache-dependency-path: cli/package-lock.json\n95-      - name: Verify exact RC source\n--\n100-          test \"$GITHUB_REF\" = refs/heads/main\n101-      - run: sudo apt-get update && sudo apt-get install --yes acl make bubblewrap build-essential meson ninja-build pkg-config libcap-dev\n102:      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # pinned Rust toolchain action\n103-        with:\n104:          toolchain: 1.95.0\n105-      - name: Install pinned SBOM and notices tools\n106-        run: |\n--\n126-          git fetch origin main --no-tags\n127-          git merge-base --is-ancestor \"$NEXUS_PACKAGE_TOOL_COMMIT\" origin/main\n128:          package_tool=\"$RUNNER_TEMP/package-linux.sh\"\n129:          git show \"$NEXUS_PACKAGE_TOOL_COMMIT:scripts/package-linux.sh\" > \"$package_tool\"\n130-          NEXUS_PACKAGE_SOURCE=\"$GITHUB_WORKSPACE\" bash \"$package_tool\" \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\"\n131:      - name: Record source, toolchain, and published-asset identity\n132-        env:\n133-          NEXUS_PACKAGE_TOOL_COMMIT: ${{ needs.resolve-tag.outputs.workflow_sha }}\n134:          NEXUS_PACKAGE_TOOL_SCRIPT: ${{ runner.temp }}/package-linux.sh\n135-        run: |\n136:          git show \"$EXPECTED_WORKFLOW_SHA:scripts/repro-identity.mjs\" > \"$RUNNER_TEMP/repro-identity.mjs\"\n137:          node \"$RUNNER_TEMP/repro-identity.mjs\" record \"$TARGET_TAG\" \"$RUNNER_TEMP/dist\" \\\n138:            \"$RUNNER_TEMP/dist/repro-identity.json\" \"${{ matrix.runner }}\"\n139-      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n140-        with:\n--\n147-            ${{ runner.temp }}/dist/sbom.cdx.json\n148-            ${{ runner.temp }}/dist/install.sh\n149:            ${{ runner.temp }}/dist/repro-identity.json\n150-          if-no-files-found: error\n151-          retention-days: 14\n--\n199-            cmp \"$RUNNER_TEMP/ubuntu-22.04/$file\" \"$RUNNER_TEMP/published/$file\"\n200-          done\n201:          node scripts/repro-identity.mjs compare \"$TARGET_TAG\" \"$EXPECTED_TAG_SHA\" \"$EXPECTED_WORKFLOW_SHA\" \\\n202-            \"$RUNNER_TEMP/repro-evidence.json\" \\\n203:            \"$RUNNER_TEMP/ubuntu-22.04/repro-identity.json\" \\\n204:            \"$RUNNER_TEMP/ubuntu-24.04/repro-identity.json\"\n205-          archive_sha=\"$(sha256sum \"$RUNNER_TEMP/ubuntu-22.04/$archive\" | cut -d' ' -f1)\"\n206-          {\nundefined\n{\"agent\":\"/root\",\"branch\":\"v1/plan-09-repro-toolchain-sync\",\"worktree\":\"/home/mike/nexus-wt/repro-toolchain-sync\",\"base\":\"405f5b96e20b988523b99c8907d29b73bcd2a8fd\",\"scope\":\"Extend merged PR208 repro workflow ownership to resolve verified RC5 npm version mismatch\",\"since\":\"2026-10-25T13:27:00Z\",\"head\":null,\"status\":null}\n{\"agent\":\"/root\",\"branch\":\"v1/plan-09-repro-toolchain-sync\",\"worktree\":\"/home/mike/nexus-wt/repro-toolchain-sync\",\"base\":\"405f5b96e20b988523b99c8907d29b73bcd2a8fd\",\"scope\":\"Pin and align Node/npm versions for release build and ACC-SUP-08 reproducibility\",\"since\":\"2026-10-25T13:27:00Z\",\"head\":null,\"status\":null}\n{\"agent\":\"codex-root\",\"branch\":\"v1/plan-09-packaging-tar-repro\",\"worktree\":\"/home/mike/nexus-wt/plan-09-packaging-tar-repro\",\"base\":\"c1f40e51b4d29b7110456b80e71984a31