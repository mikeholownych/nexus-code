sumed: resumed.code === 0 && resumed.json?.turn?.execution === \"COMPLETED\",\n+    resumeExitCode: resumed.code,\n+    resumeTurnExecution: resumed.json?.turn?.execution ?? null,\n+  };\n+  return {\n+    ...resumed,\n+    stdout: `${interrupted.stdout}\\n--- T4 SIGTERM interruption ---\\n${resumed.stdout}`,\n+    stderr: `${interrupted.stderr}\\n--- T4 resume attempt ---\\n${resumed.stderr}`,\n+    t4FaultsInjected: [{ kind: \"sigterm_resume\", source: \"task_fixture_or_runner\", evidence }],\n+  };\n+}\n+\n+function runAgentAttempt(task, ws, home, budget, agentIdentity, proxyDirectory, localToken, { signalAfterAnswer = false, proxy = null, resume = false } = {}) {\n   const { cmd, argv, env, protocol } = agentCommand(task, ws, home, budget, agentIdentity, localToken);\n+  if (resume) {\n+    if ((config.agent ?? \"nexus\") !== \"nexus\" || protocol) throw new Error(\"T4 resume is supported only by Nexus run mode\");\n+    const promptIndex = argv.lastIndexOf(task.objective);\n+    if (promptIndex < 0) throw new Error(\"could not remove original prompt before Nexus resume\");\n+    argv.splice(promptIndex, 1);\n+    argv.push(\"--resume\");\n+  }\n   if (config.qualification === true && !config.runAs) throw new Error(\"qualification candidate execution requires the dedicated evaluator account\");\n   if (config.runAs) grantRunAsAccess(config.runAs, [ws, home, proxyDirectory]);\n   const runtimePaths = [fs.realpathSync(cmd), ...agentIdentity.argsPrefix.filter((item) => path.isAbsolute(item)), ...(config.sandboxRuntimePaths ?? [])];\n   if ((config.agent ?? \"nexus\") === \"nexus\" && agentIdentity.argsPrefix[0] === path.join(ROOT, \"cli/dist/index.js\")) {\n     runtimePaths.push(path.join(ROOT, \"cli/dist\"));\n@@ -603,22 +646,55 @@ function runAgent(task, ws, home, budget, agentIdentity, proxyDirectory, localTo\n       if (containment) return containment.kill();\n       try {\n         process.kill(-child.pid, sig);\n       } catch {}\n     };\n+    let signalEvidence = null;\n+    const signalPoll = signalAfterAnswer ? setInterval(() => {\n+      if (signalEvidence || (proxy?.stats().answered ?? 0) < 1) return;\n+      if (!containment) return;\n+      const proxyState = proxy.stats();\n+      // An answered request alone only proves the model replied sometime earlier. Require\n+      // an in-flight inference request while this Nexus process is still alive so the\n+      // injected interruption is demonstrably during an active turn.\n+      if (proxyState.activeInferenceRequests < 1 || child.exitCode !== null) return;\n+      try {\n+        if (containment.signal(\"SIGTERM\", 5000)) signalEvidence = {\n+          requestedAt: new Date().toISOString(),\n+          answeredBeforeSignal: true,\n+          activeInferenceRequests: proxyState.activeInferenceRequests,\n+          signalDuringActiveTurn: true,\n+        };\n+      } catch {}\n+    }, 25) : null;\n     const timer = setTimeout(() => {\n       timedOut = true;\n       killGroup(\"SIGTERM\");\n       setTimeout(() => killGroup(\"SIGKILL\"), 10_000).unref();\n     }, (budget.minutes + 5) * 60_000);\n     child.on(\"error\", (err) => (stderr += `spawn error: ${err.message}\\n`));\n-    child.on(\"close\", async (code) => {\n+    child.on(\"close\", async (code, exitSignal) => {\n       clearTimeout(timer);\n-      killGroup(\"SIGKILL\");\n+      if (signalPoll) clearInterval(signalPoll);\n+      // A contained payload is already reaped by cgroup_supervisor before its final report. Do not race that\n+      // report with a second force-kill; only the uncontained development path needs process-group cleanup here.\n+      if (!containment) killGroup(\"SIGKILL\");\n       const final = containment ? await containment.final : undefined;\n       const json = driver ? { turn: driver.state.objectiveTurns.at(-1) ?? null } : lastJson(stdout);\n-      resolve({ code, timedOut, outputExceeded, stdout, stderr, json, ...(driver ? { t3Driver: driver.state, t3Preconditions: preconditions } : {}), ...(containment ? { resources: final, containmentProblem: containmentProblem(final) } : {}) });\n+      const observedSignal = final?.signals?.find((entry) => entry.name === \"SIGTERM\");\n+      const t4Signal = signalEvidence ? {\n+        ...signalEvidence,\n+        delivered: (observedSignal?.delivered ?? 0) > 0,\n+        deliveredProcesses: observedSignal?.delivered ?? 0,\n+        forced: observedSignal?.forced ?? null,\n+        firstExitCode: code,\n+        // `child` is the systemd-run wrapper; only the supervisor's final report identifies\n+        // the task payload's signal disposition.\n+        payloadExitSignal: final?.signal ?? null,\n+        supervisorWrapperExitSignal: exitSignal ?? null,\n+      } : null;\n+      resolve({ code, timedOut, outputExceeded, stdout, stderr, json, ...(t4Signal ? { t4Signal } : {}), ...(driver ? { t3Driver: driver.state, t3Preconditions: preconditions } : {}), ...(containment ? { resources: final, containmentProblem: containmentProblem(final) } : {}) });\n     });\n   });\n }\n \n function runCheck(task, ws, check, hidden, { readOnlyHidden = false } = {}) {\n@@ -691,11 +767,11 @@ function lastJson(text) {\n \n function harnessIdentity() {\n   const git = (...a) => spawnSync(\"git\", a, { cwd: ROOT, encoding: \"utf8\" }).stdout.trim();\n   const commit = git(\"rev-parse\", \"HEAD\");\n   const dirty = Boolean(git(\"status\", \"--porcelain\", \"--untracked-files=all\", \"--\", \".\", \":(exclude)cli/dist\"));\n-  const sourceFiles = [\"eval/run.mjs\", \"eval/validate.mjs\", \"eval/isolate.mjs\", \"eval/hide_oracle.cjs\", \"eval/hide_oracle.py\", \"eval/unlink_then_exec.sh\", \"eval/agent_sandbox.mjs\", \"eval/model_proxy.mjs\", \"eval/score.mjs\", \"eval/infra.mjs\", \"eval/workspace.mjs\", \"eval/resources.mjs\", \"eval/cgroup_supervisor.mjs\", \"eval/t3.mjs\", \"eval/hardened_check.mjs\"];\n+  const sourceFiles = [\"eval/run.mjs\", \"eval/validate.mjs\", \"eval/t4_fixtures.mjs\", \"eval/isolate.mjs\", \"eval/hide_oracle.cjs\", \"eval/hide_oracle.py\", \"eval/unlink_then_exec.sh\", \"eval/agent_sandbox.mjs\", \"eval/model_proxy.mjs\", \"eval/score.mjs\", \"eval/infra.mjs\", \"eval/workspace.mjs\", \"eval/resources.mjs\", \"eval/cgroup_supervisor.mjs\", \"eval/t3.mjs\", \"eval/hardened_check.mjs\"];\n   const sourceDigests = sourceFiles.map((file) => ({ file, sha256: createHash(\"sha256\").update(fs.readFileSync(path.join(ROOT, file))).digest(\"hex\") }));\n   const sourceSha256 = createHash(\"sha256\").update(JSON.stringify(sourceDigests)).digest(\"hex\");\n   return { commit, dirty, sourceDigests, sourceSha256, string: `${commit.slice(0, 12)}${dirty ? \"-dirty\" : \"\"}` };\n }\n \n","exit_code":0,"duration":{"secs":0,"nanos":833711800}},"started_at_ms":1792921015703,"completed_at_ms":1792921016537}}
{"timestamp":"2026-10-25T09:36:57.495Z","ordinal":335236,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17267-b4a8-7073-9d2a-32da76e0ee35","item":{"type":"CommandExecution","id":"exec-1ceca1e6-0244-4849-9624-73cc17eeeeec","process_id":"40409","command":["/usr/bin/zsh","-lc","gh run view 40179733923 --json jobs | jq -r '.jobs[]|[.name,.databaseId,.status,.conclusion]|@tsv'; gh run view 40179733923 --json jobs | jq -r '.jobs[]|select(.name==\"test-matrix (22)\" or .name==\"test-matrix (24)\")|[.name,.databaseId]|@tsv'"],"cwd":"file:///home/mike/nexus-code","parsed_cmd":[{"type":"unknown","cmd":"gh run view 40179733923 --json jobs | jq -r '.jobs[]|[.name,.databaseId,.status,.conclusion]|@tsv'; gh run view 40179733923 --json jobs | jq -r '.jobs[]|select(.name==\"test-matrix (22)\" or .name==\"test-matrix (24)\")|[.name,.databaseId]|@tsv'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"test-matrix (22)\t121128017169\tcompleted\tsuccess\ntest-matrix (24)\t121128017317\tcompleted\tsuccess\nlinux-x86_64\t121130849841\tin_progress\t\ntest-matrix (22)\t121128017169\ntest-matrix (24)\t121128017317\n","exit_code":0,"duration":{"secs":1,"nanos":793863017}},"started_at_ms":1792921015700,"completed_at_ms":1792921017495}}
{"timestamp":"2026-10-25T09:36:58.643Z","ordinal":335237,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1726b-a113-7843-8d37-20d9ecc9ed96","call_id":"call_825e68a3fc984095b7c65f482e16fa11","output":[{"type":"input_text","text":"Script completed\nWall time 4.2 seconds\nOutput:\n"},{"type":"input_text","text":"---0---"},{"type":"input_text","text":"/** Candidate version discovery must use the same capped writable filesystem as evaluated work. */\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport http from \"node:http\";\nimport { spawn, execFileSync } from \"node:child_process\";\nimport { fileURLToPath } from \"node:url\";\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\n\ntest(\"the production version-probe workspace uses the configured capped filesystem\", { timeout: 60_000 }, async () => {\n  const workspaceRoot = process.env.NEXUS_EVAL_TEST_WORKSPACE_ROOT;\n  assert.ok(workspaceRoot, \"requires the dedicated capped workspace fixture configured by CI\");\n  const runtimeRoot = process.env.NEXUS_EVAL_TEST_RUNTIME_ROOT;\n  assert.ok(runtimeRoot, \"requires the dedicated public runtime fixture configured by CI\");\n  const runAs = process.env.NEXUS_EVAL_TEST_RUN_AS ?? \"nobody\";\n  const evaluatorUid = Number(execFileSync(\"/usr/bin/id\", [\"-u\", runAs], { encoding: \"utf8\" }).trim());\n  assert.notEqual(evaluatorUid, process.getuid(), \"version probe must actually switch to a separate evaluator uid\");\n  const cap = fs.statfsSync(workspaceRoot);\n  const expectedDevice = fs.statSync(workspaceRoot).dev;\n  const temp = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-version-storage-test-\"));\n  const home = path.join(temp, \"home\");\n  const tools = fs.mkdtempSync(path.join(runtimeRoot, \"version-agent-\"));\n  const tasks = path.join(temp, \"tasks\");\n  for (const dir of [home, tasks]) fs.mkdirSync(dir, { mode: 0o700 });\n  fs.chmodSync(tools, 0o755);\n  const before = new Set(fs.readdirSync(workspaceRoot));\n  const agent = path.join(tools, \"goose\");\n  // Use /bin/sh: isolatedProcessArgv mounts SYSTEM_BINARIES only, not process.execPath.\n  // GHA Node from actions/setup-node is not at /usr/bin/node, so a node shebang exits 1\n  // before the fake agent body runs (local /usr/bin/node masks this).\n  fs.writeFileSync(agent, `#!/bin/sh\nset -eu\nif [ \"$(id -u)\" -ne ${evaluatorUid} ]; then\n  echo 'version probe did not switch evaluator uid' >&2\n  exit 94\nfi\nif [ \"\\${1:-}\" != '--version' ]; then\n  exit 91\nfi\nif [ \"$(stat -c %d .)\" -ne ${expectedDevice} ]; then\n  echo 'version probe escaped capped filesystem' >&2\n  exit 92\nfi\nprintf 'bounded' > version-probe-write\necho 'goose-storage-probe 1.0.0'\n`, { mode: 0o755 });\n  const server = http.createServer((_req, res) => {\n    res.setHeader(\"Content-Type\", \"application/json\");\n    res.end(JSON.stringify({ object: \"list\", data: [{ id: \"storage-probe-model\", object: \"model\", owned_by: \"synthetic-test\" }] }));\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const config = path.join(temp, \"config.json\");\n  const out = path.join(temp, \"out\");\n  fs.writeFileSync(config, JSON.stringify({\n    name: \"bounded-version-probe\", agent: \"goose\", expectedAgentVersion: \"1.0.0\", runAs,\n    endpoint: `http://127.0.0.1:${address.port}/v1`, model: \"storage-probe-model\", proxy: false,\n    env: { PATH: `${tools}${path.delimiter}${process.env.PATH ?? \"\"}` },\n    sandboxRuntimePaths: [agent], sandboxRuntimeRoots: [tools],\n    resources: { cpuPercent: 100, memoryBytes: 256 * 1024 * 1024, tasks: 64, storageBytes: cap.blocks * cap.bsize, workspaceRoot },\n  }));\n  try {\n    const result = await new Promise<{ status: number | null; stdout: string; stderr: string }>((resolve, reject) => {\n      const child = spawn(process.execPath, [path.join(ROOT, \"eval/run.mjs\"), \"--config\", config, \"--out\", out, \"--tasks\", tasks], {\n        env: { ...process.env, HOME: home, XDG_CONFIG_HOME: path.join(home, \".config\"), XDG_DATA_HOME: path.join(home, \".local/share\"), XDG_STATE_HOME: path.join(home, \".local/state\") },\n        stdio: [\"ignore\", \"pipe\", \"pipe\"], detached: true,\n      });\n      let stdout = \"\", stderr = \"\";\n      const stop = () => { if (child.pid) try { process.kill(-child.pid, \"SIGKILL\"); } catch {} };\n      const timer = setTimeout(() => {\n        stop(); child.stdout.destroy(); child.stderr.destroy();\n        reject(new Error(`version-probe runner exceeded 45 seconds: ${stderr}`));\n      }, 45_000);\n      child.stdout.on(\"data\", data => { stdout += data; });\n      child.stderr.on(\"data\", data => { stderr += data; });\n      child.once(\"error\", error => { clearTimeout(timer); stop(); reject(error); });\n      child.once(\"close\", status => { clearTimeout(timer); stop(); resolve({ status, stdout, stderr }); });\n    });\n    assert.equal(result.status, 0, `${result.stdout}\\n${result.stderr}`);\n    const manifest = JSON.parse(fs.readFileSync(path.join(out, \"manifest.json\"), \"utf8\"));\n    assert.match(JSON.stringify(manifest.agentVersion), /goose-storage-probe 1.0.0/);\n    assert.deepEqual(fs.readdirSync(workspaceRoot).filter(name => !before.has(name) && name.startsWith(\"nexus-eval-version-workspace-\")), [], \"version-probe workspace must be cleaned up\");\n  } finally {\n    await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));\n    fs.rmSync(temp, { recursive: true, force: true });\n    fs.rmSync(tools, { recursive: true, force: true });\n  }\n});\n// Runs the CLI test suite with a throwaway HOME so no test (or anything it spawns: the sidecar, the TUI, PTY drivers)\n// can read or write the operator's ~/.nexus or ~/.config/nexus. The real home is passed as NEXUS_TEST_REAL_HOME so the\n// guard test can prove the isolation held. Arguments are test files; none means every test/*.test.ts.\n// NEXUS_KEEP_TEST_HOME=1 keeps the temporary home for inspection.\nimport { spawnSync } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst cli = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst realHome = os.homedir();\nconst home = fs.mkdtempSync(path.join(os.tmpdir(), \"nexus-test-home-\"));\n\nconst files = process.argv.length > 2\n  ? process.argv.slice(2)\n  : fs.readdirSync(path.join(cli, \"test\")).filter((f) => f.endsWith(\".test.ts\")).sort().map((f) => path.join(\"test\", f));\n\nconst env = {\n  ...process.env,\n  HOME: home,\n  XDG_CONFIG_HOME: path.join(home, \".config\"),\n  XDG_DATA_HOME: path.join(home, \".local\", \"share\"),\n  XDG_STATE_HOME: path.join(home, \".local\", \"state\"),\n  XDG_CACHE_HOME: path.join(home, \".cache\"),\n  NEXUS_TEST_REAL_HOME: realHome,\n};\n// Rust and Node toolchains installed per user keep working under the throwaway home.\nfor (const [key, dir] of [[\"CARGO_HOME\", \".cargo\"], [\"RUSTUP_HOME\", \".rustup\"]]) {\n  if (!env[key] && fs.existsSync(path.join(realHome, dir))) env[key] = path.join(realHome, dir);\n}\n\nconst tsx = path.join(cli, \"node_modules\", \".bin\", \"tsx\");\nconst result = spawnSync(tsx, [\"--test\", \"--test-concurrency=1\", ...files], { cwd: cli, env, stdio: \"inherit\" });\n\nif (process.env.NEXUS_KEEP_TEST_HOME === \"1\") console.error(`test home kept at ${home}`);\nelse fs.rmSync(home, { recursive: true, force: true });\n\nif (result.error) throw result.error;\nprocess.exit(result.status ?? 1);\n"},{"type":"input_text","text":"---1---"},{"type":"input_text","text":"Warning: truncated output (original token count: 12500)\nTotal outp