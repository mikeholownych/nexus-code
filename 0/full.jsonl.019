{"timestamp":"2026-10-25T14:10:16.624Z","ordinal":341559,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17359-3515-7cd3-8706-e6bd2e3432cb","item":{"type":"CommandExecution","id":"exec-fde28b0a-02fd-4ffc-94d1-622ce7ccba5a","process_id":"31233","command":["/usr/bin/zsh","-lc","sed -n '1,210p' cli/src/checkpoint.ts; sed -n '220,335p' cli/test/persistence_protection.test.ts"],"cwd":"file:///home/mike/nexus-wt/rc5-readiness-checkpoint","parsed_cmd":[{"type":"read","cmd":"sed -n '1,210p' cli/src/checkpoint.ts","name":"checkpoint.ts","path":"cli/src/checkpoint.ts"},{"type":"read","cmd":"sed -n '220,335p' cli/test/persistence_protection.test.ts","name":"persistence_protection.test.ts","path":"cli/test/persistence_protection.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport * as os from \"node:os\";\nimport { execFileSync, execSync } from \"node:child_process\";\nimport crypto from \"node:crypto\";\nimport {\n  assertNoSensitivePersistenceContent,\n  redactForPersistence,\n  SensitivePersistenceError,\n} from \"./core/persistence_protection.js\";\nimport { ensurePrivateDir, writePrivateFile } from \"./core/durable_file.js\";\n\nexport interface CheckpointInfo {\n  id: string;\n  name: string;\n  timestamp: string;\n  workspace?: string;\n  gitRef?: string;\n  snapshotDir?: string;\n  files?: Array<{ path: string; content: string }>;\n}\n\nexport class CheckpointManager {\n  private workspace: string;\n  private checkpointDir: string;\n  private isGit: boolean = false;\n\n  constructor(workspace: string) {\n    this.workspace = path.resolve(workspace);\n    const hash = crypto.createHash(\"sha256\").update(this.workspace).digest(\"hex\").slice(0, 12);\n    this.checkpointDir = path.join(os.homedir(), \".nexus\", \"checkpoints\", hash);\n    ensurePrivateDir(this.checkpointDir);\n    this.checkGit();\n  }\n\n  private checkGit(): void {\n    try {\n      execSync(\"git rev-parse --is-inside-work-tree\", { cwd: this.workspace, stdio: \"ignore\" });\n      this.isGit = true;\n    } catch {\n      this.isGit = false;\n    }\n  }\n\n  private copyDirFiltered(src: string, dest: string, allowSensitive = false): void {\n    ensurePrivateDir(dest);\n    const ignored = new Set([\"node_modules\", \".git\", \"target\", \"dist\", \".nexus\", \".next\", \".cache\"]);\n    const entries = fs.readdirSync(src, { withFileTypes: true });\n    for (const entry of entries) {\n      if (ignored.has(entry.name)) continue;\n      if (!allowSensitive) assertNoSensitivePersistenceContent(entry.name, \"checkpoint\");\n      const srcPath = path.join(src, entry.name);\n      const destPath = path.join(dest, entry.name);\n      if (entry.isDirectory()) {\n        this.copyDirFiltered(srcPath, destPath, allowSensitive);\n      } else if (entry.isFile()) {\n        const content = fs.readFileSync(srcPath);\n        if (!allowSensitive) assertNoSensitivePersistenceContent(content.toString(\"utf8\"), \"checkpoint\");\n        writePrivateFile(destPath, content);\n      }\n    }\n  }\n\n  private assertGitChangesSafe(allowSensitive: boolean): void {\n    const changedPaths = execSync(\"git diff --name-only -z HEAD\", {\n      cwd: this.workspace,\n      encoding: \"buffer\",\n    }).toString(\"utf8\").split(\"\\0\").filter(Boolean);\n\n    for (const relativePath of changedPaths) {\n      if (!allowSensitive) assertNoSensitivePersistenceContent(relativePath, \"checkpoint\");\n      try {\n        const indexed = execFileSync(\"git\", [\"show\", `:${relativePath}`], {\n          cwd: this.workspace,\n          encoding: \"buffer\",\n          maxBuffer: 64 * 1024 * 1024,\n          stdio: [\"ignore\", \"pipe\", \"ignore\"],\n        });\n        if (!allowSensitive) assertNoSensitivePersistenceContent(indexed.toString(\"utf8\"), \"checkpoint\");\n      } catch (error) {\n        if (error instanceof SensitivePersistenceError) throw error;\n        try {\n          // A staged deletion has no index blob and no worktree bytes to copy.\n          // Any other inability to inspect an indexed object is fail-closed.\n          execFileSync(\"git\", [\"ls-files\", \"--error-unmatch\", \"--\", relativePath], {\n            cwd: this.workspace,\n            stdio: \"ignore\",\n          });\n          throw new Error(\"Checkpoint could not verify protected Git index state\");\n        } catch (indexError) {\n          if (\n            indexError instanceof Error &&\n            indexError.message === \"Checkpoint could not verify protected Git index state\"\n          ) throw indexError;\n          if ((indexError as NodeJS.ErrnoException & { status?: number })?.status !== 1) {\n            throw new Error(\"Checkpoint could not verify protected Git index state\");\n          }\n          // Not present in the index: the path may be a staged deletion. Git's\n          // checkpoint operation will not persist any untracked replacement.\n        }\n      }\n\n      const worktreePath = path.join(this.workspace, relativePath);\n      if (fs.existsSync(worktreePath) && fs.statSync(worktreePath).isFile()) {\n        if (!allowSensitive) assertNoSensitivePersistenceContent(fs.readFileSync(worktreePath, \"utf8\"), \"checkpoint\");\n      }\n    }\n  }\n\n  private assertFallbackSnapshotSafe(workspacePath: string, allowSensitive: boolean): void {\n    const ignored = new Set([\"node_modules\", \".git\", \"target\", \"dist\", \".nexus\", \".next\", \".cache\"]);\n    const visit = (directory: string): void => {\n      for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {\n        if (ignored.has(entry.name)) continue;\n        if (!allowSensitive) assertNoSensitivePersistenceContent(entry.name, \"checkpoint\");\n        const sourcePath = path.join(directory, entry.name);\n        if (entry.isDirectory()) {\n          visit(sourcePath);\n        } else if (entry.isFile()) {\n          if (!allowSensitive) assertNoSensitivePersistenceContent(fs.readFileSync(sourcePath, \"utf8\"), \"checkpoint\");\n        }\n      }\n    };\n    visit(workspacePath);\n  }\n\n  public createCheckpoint(name?: string, options: { allowSensitive?: boolean } = {}): CheckpointInfo {\n    const allowSensitive = options.allowSensitive === true;\n    const rand = Math.random().toString(36).slice(2, 6);\n    const id = `cp_${Date.now()}_${rand}`;\n    const desc = redactForPersistence(name || `Checkpoint at ${new Date().toLocaleTimeString()}`);\n    const timestamp = new Date().toISOString();\n\n    let gitRef: string | undefined;\n    let snapshotDir: string | undefined;\n\n    if (this.isGit) {\n      try {\n        this.assertGitChangesSafe(allowSensitive);\n        // Create an untracked + tracked git stash commit without modifying working tree\n        const stashCommit = execSync(\"git stash create\", { cwd: this.workspace, encoding: \"utf-8\" }).trim();\n        if (stashCommit) {\n          execFileSync(\"git\", [\"update-ref\", `refs/nexus/checkpoints/${id}`, stashCommit], {\n            cwd: this.workspace,\n            stdio: \"ignore\",\n          });\n          gitRef = stashCommit;\n        } else {\n          // Working tree was clean; record HEAD\n          const headCommit = execSync(\"git rev-parse HEAD\", { cwd: this.workspace, encoding: \"utf-8\" }).trim();\n          execFileSync(\"git\", [\"update-ref\", `refs/nexus/checkpoints/${id}`, headCommit], {\n            cwd: this.workspace,\n            stdio: \"ignore\",\n          });\n          gitRef = headCommit;\n        }\n      } catch (error) {\n        if (error instanceof SensitivePersistenceError) throw error;\n        throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n      }\n    }\n\n    if (!gitRef) {\n      const snapTarget = path.join(this.checkpointDir, \"snapshots\", id);\n      try {\n        this.assertFallbackSnapshotSafe(this.workspace, allowSensitive);\n        this.copyDirFiltered(this.workspace, snapTarget, allowSensitive);\n        snapshotDir = snapTarget;\n      } catch (error) {\n        try {\n          fs.rmSync(snapTarget, { recursive: true, force: true });\n        } catch {}\n        throw error;\n      }\n    }\n\n    const checkpoint: CheckpointInfo = {\n      id,\n      name: desc,\n      timestamp,\n      workspace: this.workspace,\n      gitRef,\n      snapshotDir,\n    };\n\n    const targetFile = path.join(this.checkpointDir, `${id}.json`);\n    writePrivateFile(targetFile, JSON.stringify(checkpoint, null, 2), { durable: true });\n    return checkpoint;\n  }\n\n  public getCheckpointDir(): string {\n    return this.checkpointDir;\n  }\n\n  public getWorkspace(): string {\n    return this.workspace;\n  }\n\n  public listCheckpoints(): CheckpointInfo[] {\n    if (!fs.existsSync(this.checkpointDir)) return [];\n    const files = fs.readdirSync(this.checkpointDir).filter((f) => f.endsWith(\".json\"));\n    const list: CheckpointInfo[] = [];\n    for (const f of files) {\n      try {\n        const parsed = JSON.parse(fs.readFileSync(path.join(this.checkpointDir, f), \"utf-8\"));\n        const checkpoint = this.validatedCheckpoint(parsed);\n        // The record must be the one its filename names; otherwise a planted file could cause\n        // prune to delete another checkpoint's JSON/snapshot.\n        if (checkpoint && checkpoint.id === f.replace(/\\.json$/, \"\")) list.push(checkpoint);\n      } catch {\n    const filePath = path.join(workspace, \".nexus\", \"knowledge.json\");\n    const persisted = fs.readFileSync(filePath, \"utf8\");\n    assert.equal(persisted.includes(syntheticGithubToken), false);\n    assert.match(persisted, /REDACTED/);\n\n    const recovered = new KnowledgeGraph(workspace).get(\"provider credential\");\n    assert.ok(recovered);\n    assert.match(recovered.value, /REDACTED/);\n  } finally {\n    fs.rmSync(tempDir, { recursive: true, force: true });\n  }\n});\n\ntest(\"git checkpoint refuses to persist modified files containing classified credentials\", () => {\n  const tempDir = makeTempDir(\"nexus-pers002-checkpoint-git-\");\n  const previousHome = process.env.HOME;\n  process.env.HOME = path.join(tempDir, \"home\");\n  try {\n    const workspace = path.join(tempDir, \"workspace\");\n    fs.mkdirSync(workspace);\n    execFileSync(\"git\", [\"init\", \"-q\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.name\", \"Synthetic Fixture\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.email\", \"fixture@example.invalid\"], { cwd: workspace });\n    fs.writeFileSync(path.join(workspace, \"app.txt\"), \"safe baseline\\n\");\n    execFileSync(\"git\", [\"add\", \"app.txt\"], { cwd: workspace });\n    execFileSync(\"git\", [\"commit\", \"-qm\", \"baseline\"], { cwd: workspace });\n    fs.writeFileSync(path.join(workspace, \"app.txt\"), `changed ${syntheticGithubToken}\\n`);\n\n    assert.throws(() => new CheckpointManager(workspace).createCheckpoint(\"sensitive checkpoint\"), /sensitive/i);\n    const checkpointRoot = path.join(process.env.HOME, \".nexus\", \"checkpoints\");\n    const workspacePartition = fs.readdirSync(checkpointRoot).map((name) => path.join(checkpointRoot, name));\n    assert.equal(workspacePartition.every((directory) => fs.readdirSync(directory).length === 0), true);\n    assert.equal(execFileSync(\"git\", [\"for-each-ref\", \"refs/nexus/checkpoints\"], { cwd: workspace, encoding: \"utf8\" }).trim(), \"\");\n    assert.equal(fs.readFileSync(path.join(workspace, \"app.txt\"), \"utf8\").includes(syntheticGithubToken), true);\n  } finally {\n    if (previousHome === undefined) delete process.env.HOME;\n    else process.env.HOME = previousHome;\n    fs.rmSync(tempDir, { recursive: true, force: true });\n  }\n});\n\ntest(\"git checkpoint retains ordinary tracked state without changing the worktree\", () => {\n  const tempDir = makeTempDir(\"nexus-pers002-checkpoint-git-safe-\");\n  const previousHome = process.env.HOME;\n  process.env.HOME = path.join(tempDir, \"home\");\n  try {\n    const workspace = path.join(tempDir, \"workspace\");\n    fs.mkdirSync(workspace);\n    execFileSync(\"git\", [\"init\", \"-q\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.name\", \"Synthetic Fixture\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.email\", \"fixture@example.invalid\"], { cwd: workspace });\n    fs.writeFileSync(path.join(workspace, \"app.txt\"), \"safe baseline\\n\");\n    execFileSync(\"git\", [\"add\", \"app.txt\"], { cwd: workspace });\n    execFileSync(\"git\", [\"commit\", \"-qm\", \"baseline\"], { cwd: workspace });\n    fs.writeFileSync(path.join(workspace, \"app.txt\"), \"safe changed state\\n\");\n\n    const checkpoint = new CheckpointManager(workspace).createCheckpoint(\"ordinary update\");\n    assert.ok(checkpoint.gitRef);\n    assert.equal(execFileSync(\"git\", [\"show\", `${checkpoint.gitRef}:app.txt`], { cwd: workspace, encoding: \"utf8\" }), \"safe changed state\\n\");\n    assert.equal(fs.readFileSync(path.join(workspace, \"app.txt\"), \"utf8\"), \"safe changed state\\n\");\n  } finally {\n    if (previousHome === undefined) delete process.env.HOME;\n    else process.env.HOME = previousHome;\n    fs.rmSync(tempDir, { recursive: true, force: true });\n  }\n});\n\ntest(\"git checkpoint permits a staged deletion with no index blob to inspect\", () => {\n  const tempDir = makeTempDir(\"nexus-pers002-checkpoint-delete-\");\n  const previousHome = process.env.HOME;\n  process.env.HOME = path.join(tempDir, \"home\");\n  try {\n    const workspace = path.join(tempDir, \"workspace\");\n    fs.mkdirSync(workspace);\n    execFileSync(\"git\", [\"init\", \"-q\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.name\", \"Synthetic Fixture\"], { cwd: workspace });\n    execFileSync(\"git\", [\"config\", \"user.email\", \"fixture@example.invalid\"], { cwd: workspace });\n    fs.writeFileSync(path.join(workspace, \"remove.txt\"), \"ordinary content\\n\");\n    execFileSync(\"git\", [\"add\", \"remove.txt\"], { cwd: workspace });\n    execFileSync(\"git\", [\"commit\", \"-qm\", \"baseline\"], { cwd: workspace });\n    fs.rmSync(path.join(workspace, \"remove.txt\"));\n    execFileSync(\"git\", [\"add\", \"-u\"], { cwd: workspace });\n\n    const checkpoint = new CheckpointManager(workspace).createCheckpoint(\"staged deletion\");\n    assert.ok(checkpoint.gitRef);\n    assert.equal(execFileSync(\"git\", [\"diff\", \"--name-status\", \"HEAD\", checkpoint.gitRef], { cwd: workspace, encoding: \"utf8\" }).trim(), \"D\\tremove.txt\");\n  } finally {\n    if (previousHome === undefined) delete process.env.HOME;\n    else process.env.HOME = previousHome;\n    fs.rmSync(tempDir, { recursive: true, force: true });\n  }\n});\n\ntest(\"non-git checkpoint refuses to copy sensitive workspace files\", () => {\n  const tempDir = makeTempDir(\"nexus-pers002-checkpoint-copy-\");\n  const previousHome = process.env.HOME;\n  process.env.HOME = path.join(tempDir, \"home\");\n  try {\n    const workspace = path.join(tempDir, \"workspace\");\n    fs.mkdirSync(workspace);\n    fs.writeFileSync(path.join(workspace, \"secrets.txt\"), `${syntheticOpenAiToken}\\n`);\n\n    assert.throws(() => new CheckpointManager(workspace).createCheckpoint(\"sensitive snapshot\"), /sensitive/i);\n    const checkpointRoot = path.join(process.env.HOME, \".nexus\", \"checkpoints\");\n    const workspacePartition = fs.readdirSync(checkpointRoot).map((name) => path.join(checkpointRoot, name));\n    assert.equal(workspacePartition.every((directory) => fs.readdirSync(directory).length === 0), true);\n  } finally {\n    if (previousHome === undefined) delete process.env.HOME;\n    else process.env.HOME = previousHome;\n    fs.rmSync(tempDir, { recursive: true, force: true });\n  }\n});\n\ntest(\"non-git checkpoint preserves an ordinary workspace snapshot\", () => {\n  const tempDir = makeTempDir(\"nexus-pers002-checkpoint-safe-\");\n  const previousHome = process.env.HOME;\n","exit_code":0,"duration":{"secs":1,"nanos":28658035}},"started_at_ms":1792937415594,"completed_at_ms":1792937416623}}
