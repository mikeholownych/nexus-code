a\":\"405f5b96e20b988523b99c8907d29b73bcd2a8fd\",\"name\":\"cargo in /core - Update #1651501932\",\"status\":\"completed\"},{\"conclusion\":\"success\",\"createdAt\":\"2026-10-25T13:03:10Z\",\"databaseId\":40195855730,\"headSha\":\"405f5b96e20b988523b99c8907d29b73bcd2a8fd\",\"name\":\"npm_and_yarn in /demo - Update #1651501926\",\"status\":\"completed\"}]\n{\"baseRefOid\":\"405f5b96e20b988523b99c8907d29b73bcd2a8fd\",\"headRefOid\":\"68e8320f8ecf54be0917f728a6f98c8d2424554b\",\"mergeStateStatus\":\"CLEAN\",\"number\":232,\"state\":\"OPEN\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-25T13:56:27Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40197810800/job/121182370396\",\"name\":\"test-matrix (22)\",\"startedAt\":\"2026-10-25T13:38:41Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-25T13:36:43Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40197810811/job/121182372341\",\"name\":\"javascript-typescript\",\"startedAt\":\"2026-10-25T13:35:44Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CodeQL\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-25T13:50:30Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40197810800/job/121182370244\",\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-25T13:36:44Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-25T14:18:23Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40197810800/job/121188684528\",\"name\":\"linux-x86_64\",\"startedAt\":\"2026-10-25T13:56:29Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-25T13:36:36Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholown