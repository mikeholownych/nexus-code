= 0;\n    88\t  private shutdownPromise?: Promise<void>;\n    89\t  private readonly resume?: string;\n    90\t  private readonly history: string[];\n    91\t  private sessionId: string;\n    92\t  private checkpointManager: CheckpointManager;\n    93\t  /** The running slash command; undefined for prompt turns and for commands that became turns. */\n    94\t  private activeSpec?: SlashSpec;\n    95\t  private readonly evidence = new EvidenceLedger();\n   535\t      // Read-only turns cannot change the workspace, so a workspace rollback snapshot is unnecessary.\n   536\t      agent.setCheckpointReadOnlyFallback(false);\n   537\t    } else {\n   538\t      try {\n   539\t        this.checkpointManager.createCheckpoint(checkpoint);\n   540\t        agent.setCheckpointReadOnlyFallback(false);\n   541\t      } catch (err) {\n   542\t        if (err instanceof SensitivePersistenceError) {\n   543\t          const choice = await this.requestCheckpointChoice(turnId, signal);\n   544\t          if (choice === \"cancel\" || choice === \"other\") {\n   545\t            const message = choice === \"other\"\n   546\t              ? \"This turn was not started. Enter a different instruction in the composer.\"\n   547\t              : \"This turn was cancelled before it started.\";\n   548\t            this.emit({ type: \"error\", id: turnId, code: \"INTERNAL\", message });\n   549\t            return;\n   550\t          }\n   551\t          if (choice === \"read_only\") {\n   552\t            agent.setCheckpointReadOnlyFallback(true);\n   553\t            this.emit({ type: \"notice\", text: \"Continuing this turn in read-only mode as requested. Workspace changes, unsafe commands, external actions, and delegation are disabled.\" });\n   554\t            this.emitSessionState();\n   555\t          } else if (choice === \"without_checkpoint\") {\n   556\t            this.emit({ type: \"notice\", text: \"Continuing in the current mode without a rollback checkpoint, as requested.\" });\n   557\t          } else if (choice === \"allow_sensitive\") {\n   558\t            allowSensitiveCheckpoint = true;\n   559\t            this.emit({ type: \"notice\", text: \"Creating a checkpoint that may persist sensitive workspace content, as requested.\" });\n   560\t          }\n   561\t        } else {\n   562\t          const message = `No checkpoint could be saved, so the turn did not start: ${redactSecrets(errorText(err))}`;\n   563\t          this.emit({ type: \"error\", id: turnId, code: \"INTERNAL\", message });\n   564\t          return;\n   565\t        }\n   566\t      }\n   567\t    }\n   568\t    if (allowSensitiveCheckpoint) {\n   569\t      try {\n   570\t        this.checkpointManager.createCheckpoint(checkpoint, { allowSensitive: true });\n   571\t        agent.setCheckpointReadOnlyFallback(false);\n   572\t      } catch (err) {\n   573\t        const message = `No checkpoint could be saved, so the turn did not start: ${redactSecrets(errorText(err))}`;\n   574\t        this.emit({ type: \"error\", id: turnId, code: \"INTERNAL\", message });\n   575\t        return;\n   576\t      }\n   577\t    }\n   578\t    if (typeof prompt === \"string\") {\n   579\t      const decision = agent.objectiveDecision(prompt);\n   580\t      if (decision.kind === \"amend\") {\n   650\t      return;\n   651\t    }\n   652\t    if (approved && always) {\n   653\t      this.alwaysApprove = true;\n   654\t      this.mode = \"auto\";\n   655\t      this.app.getAgent().setApprovalMode(\"auto\");\n   656\t      this.emitSessionState();\n   657\t    }\n   658\t    pending.settle(approved);\n   659\t  }\n   660\t\n   661\t  private requestCheckpointChoice(turnId: string, signal: AbortSignal): Promise<\"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\"> {\n   662\t    if (signal.aborted) return Promise.resolve(\"cancel\");\n   663\t    const id = `checkpoint-choice-${++this.approvalSeq}`;\n   664\t    return new Promise((resolve) => {\n   665\t      const settle = (choice: \"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\") => {\n   666\t        signal.removeEventListener(\"abort\", onAbort);\n   667\t        this.pendingCheckpointChoice = undefined;\n   668\t        resolve(choice);\n   669\t      };\n   670\t      const onAbort = () => settle(\"cancel\");\n   671\t      signal.addEventListener(\"abort\", onAbort, { once: true });\n   672\t      this.pendingCheckpointChoice = { id, settle };\n   673\t      this.emit({\n   674\t        type: \"checkpoint.choice.request\",\n   675\t        id,\n   676\t        turn_id: turnId,\n   677\t        message: \"Sensitive content blocked the checkpoint. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 create a checkpoint anyway (may persist sensitive content), 4 cancel this turn, or 5 re-enter the instruction.\",\n   678\t      });\n   679\t    });\n   680\t  }\n   681\t\n   682\t  private resolveCheckpointChoice(id: string, choice: \"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\"): void {\n   683\t    const pending = this.pendingCheckpointChoice;\n   684\t    if (!pending || pending.id !== id) {\n   685\t      this.emit({ type: \"error\", id, code: \"NOT_FOUND\", message: `No pending checkpoint choice with id ${id}.` });\n   686\t      return;\n   687\t    }\n   688\t    pending.settle(choice);\n   689\t  }\n   690\t\n   691\t  private slash(id: string, command: string, args: string): void {\n   692\t    if (this.app.getAgent().getApprovalMode() === \"read-only\" && !readOnlySlashAllowed(command, args)) {\n   693\t      this.emit({\n   694\t        type: \"slash.result\",\n   695\t        id,\n   108\t      evidence: string;\n   109\t      /** Commands: the first lines of their output (stdout, then stderr), redacted, controls made visible. */\n   110\t      preview?: string;\n   111\t      exit_code?: number | null;\n   112\t      duration_ms?: number;\n   113\t      timed_out?: boolean;\n   114\t    }\n   115\t  | { type: \"approval.request\"; id: string; turn_id: string; tool: string; subject: string; preview: string; review: ApprovalReview }\n   116\t  | { type: \"checkpoint.choice.request\"; id: string; turn_id: string; message: string }\n   117\t  | { type: \"turn.result\"; turn_id: string; heading: string; line: string; turn: TurnResult; model_summary: ModelSummary | null }\n   118\t  | {\n   119\t      type: \"slash.result\";\n   120\t      id: string;\n   121\t      command: string;\n   122\t      success: boolean;\n   218\t    theme::downsample(frame.buffer_mut(), state.depth);\n   219\t    layout\n   220\t}\n   221\t\n   222\tfn render_checkpoint_choice(\n   223\t    frame: &mut Frame,\n   224\t    area: Rect,\n   225\t    message: &str,\n   226\t    selected: Option<usize>,\n   227\t) -> usize {\n   228\t    let key = Style::default().fg(ACCENT).add_modifier(Modifier::BOLD);\n   229\t    let options = [\n   230\t        \"Read-only\",\n   231\t        \"Continue without checkpoint\",\n   232\t        \"Create checkpoint anyway\",\n   233\t        \"Cancel this turn\",\n   234\t        \"Other (re-enter instruction)\",\n   235\t    ];\n   236\t    // The modal has one border cell on each side and one column of margin on each side.\n   237\t    // Pre-wrap every line at the actual inner width so the height estimate includes wrapped text.\n   238\t    let width = area.width.saturating_sub(4).max(1);\n   239\t    // The sidecar message enumerates every choice for non-TUI clients. This modal\n   240\t    // renders those choices separately, so use a compact warning to keep all five\n   241\t    // visible on the smallest supported terminal size.\n   242\t    let display_message = if message.starts_with(\"Sensitive content blocked the checkpoint\") {\n   243\t        \"Sensitive content may persist if you create a checkpoint anyway.\"\n   244\t    } else {\n   245\t        message\n   246\t    };\n   247\t    let mut lines = markdown::wrap(\n   248\t        vec![Span::raw(display_message.to_owned())],\n   249\t        usize::from(width),\n   250\t        Vec::new(),\n   251\t        Vec::new(),\n   252\t    );\n   253\t    for (index, option) in options.iter().enumerate() {\n   254\t        let marker = if selected == Some(index) { \"▸\" } else { \" \" };\n   255\t        let style = Style::default().fg(Color::White);\n   256\t        lines.extend(markdown::wrap(\n   257\t            vec![Span::styled(\n   258\t                format!(\"{marker} {}. {option}\", index + 1),\n   259\t                style,\n   260\t            )],\n  1618\t    }\n  1619\t\n  1620\t    fn on_checkpoint_choice_key(&mut self, key: KeyEvent) -> Option<Action> {\n  1621\t        let Some(Overlay::CheckpointChoice { id, selected, .. }) = &mut self.overlay else { return None; };\n  1622\t        let choice = match key.code {\n  1623\t            KeyCode::Char('1') => { *selected = Some(0); return None; }\n  1624\t            KeyCode::Char('2') => { *selected = Some(1); return None; }\n  1625\t            KeyCode::Char('3') => { *selected = Some(2); return None; }\n  1626\t            KeyCode::Char('4') => { *selected = Some(3); return None; }\n  1627\t            KeyCode::Char('5') => { *selected = Some(4); return None; }\n  1628\t            KeyCode::Up | KeyCode::Left => { *selected = Some(selected.unwrap_or(0).saturating_sub(1)); return None; }\n  1629\t            KeyCode::Down | KeyCode::Right => { *selected = Some(selected.unwrap_or(0).saturating_add(1).min(4)); return None; }\n  1630\t            KeyCode::Enter => match *selected {\n  1631\t                Some(0) => Some(\"read_only\"),\n  1632\t                Some(1) => Some(\"without_checkpoint\"),\n  1633\t                Some(2) => Some(\"allow_sensitive\"),\n  1634\t                Some(3) => Some(\"cancel\"),\n  1635\t                Some(4) => Some(\"other\"),\n  1636\t                _ => return None,\n  1637\t            },\n  1638\t            KeyCode::Esc => Some(\"cancel\"),\n  1639\t            _ => return None,\n  1640\t        };\n  1641\t        let Some(choice) = choice else { return None; };\n  1642\t        let id = id.clone();\n  1643\t        self.overlay = None;\n  1644\t        Some(Action::Send(Command::CheckpointChoice { id, choice: choice.into() }))\n  1645\t    }\n  1646\t\n  1647\t    fn on_ctrl_c(&mut self) -> Option<Action> {\n  1648\t        match &self.overlay {\n  1649\t            Some(Overlay::Connect(Connect { step: Step::Waiting { request, auth: Some(_), .. }, .. })) => {\n  1650\t                let id = request.clone();\n","exit_code":0,"duration":{"secs":0,"nanos":863796680}},"started_at_ms":1792937610880,"completed_at_ms":1792937611744}}
{"timestamp":"2026-10-25T14:13:32.804Z","ordinal":341704,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a17368-d604-7d31-9e1e-49829dd55feb","call_id":"call_284f63487ecf49e3a724be45eef7e41b","output":[{"type":"input_text","text":"Script completed\nWall time 4.4 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 2714)\nTotal output lines: 204\n\n    75\t\n    76\t/** Drives one ApplicationCore from protocol commands and reports its activity as protocol events. */\n    77\texport class SidecarServer {\n    78\t  private readonly app: ApplicationCore;\n    79\t  private readonly write: (line: string) => void;\n    80\t  private readonly onShutdown: () => void;\n    81\t  private mode: ApprovalMode;\n    82\t  private alwaysApprove = false;\n    83\t  private activeTurn?: Promise<void>;\n    84\t  private turnAbort?: AbortController;\n    85\t  private pendingApproval?: { id: string; settle: (approved: boolean) => void };\n    86\t  private pendingCheckpointChoice?: { id: string; settle: (choice: \"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\") => void };\n    87\t  private approvalSeq = 0;\n    88\t  private shutdownPromise?: Promise<void>;\n    89\t  private readonly resume?: string;\n    90\t  private readonly history: string[];\n    91\t  private sessionId: string;\n    92\t  private checkpointManager: CheckpointManager;\n    93\t  /** The running slash command; undefined for prompt turns and for commands that became turns. */\n    94\t  private activeSpec?: SlashSpec;\n    95\t  private readonly evidence = new EvidenceLedger();\n   535\t      // Read-only turns cannot change the workspace, so a workspace rollback snapshot is unnecessary.\n   536\t      agent.setCheckpointReadOnlyFallback(false);\n   537\t    } else {\n   538\t      try {\n   539\t        this.checkpointManager.createCheckpoint(checkpoint);\n   540\t        agent.setCheckpointReadOnlyFallback(false);\n   541\t      } catch (err) {\n   542\t        if (err instanceof SensitivePersistenceError) {\n   543\t          const choice = await this.requestCheckpointChoice(turnId, signal);\n   544\t          if (choice === \"cancel\" || choice === \"other\") {\n   545\t            const message = choice === \"other\"\n   546\t              ? \"This turn was not started. Enter a different instruction in the composer.\"\n   547\t              : \"This turn was cancelled before it started.\";\n   548\t            this.emit({ type: \"error\", id: turnId, code: \"INTERNAL\", message });\n   549\t            return;\n   550\t          }\n   551\t          if (choice === \"read_only\") {\n   552\t            agent.setCheckpointReadOnlyFallback(true);\n   553\t            this.emit({ type: \"notice\", text: \"Continuing this turn in read-only mode as requested. Workspace changes, unsafe commands, external actions, and delegation are disabled.\" });\n   554\t            this.emitSessionState();\n   555\t          } else if (choice === \"without_checkpoint\") {\n   556\t            this.emit({ type: \"notice\", text: \"Continuing in the current mode without a rollback checkpoint, as requested.\" });\n   557\t          } else if (choice === \"allow_sensitive\") {\n   558\t            allowSensitiveCheckpoint = true;\n   559\t            this.emit({ type: \"notice\", text: \"Creating a checkpoint that may persist sensitive workspace content, as requested.\" });\n   560\t          }\n   561\t        } else {\n   562\t          const message = `No checkpoint could be saved, so the turn did not start: ${redactSecrets(errorText(err))}`;\n   563\t          this.emit({ type: \"error\", id: turnId, code: \"INTERNAL\", message });\n   564\t          return;\n   565\t        }\n   566\t      }\n   567\t    }\n   568\t    if (allowSensitiveCheckpoint) {\n   569\t      try {\n   570\t        this.checkpointManager.createCheckpoint(checkpoint, { allowSensitive: true });\n   571\t        agent.setCheckpointReadOnlyFallback(false);\n   572\t      } catch (err) {\n   573\t        const message = `No checkpoint could be saved, so the turn did not start: ${redactSecrets(e…914 tokens truncated… 228\t    let key = Style::default().fg(ACCENT).add_modifier(Modifier::BOLD);\n   229\t    let options = [\n   230\t        \"Read-only\",\n   231\t        \"Continue without checkpoint\",\n   232\t        \"Create checkpoint anyway\",\n   233\t        \"Cancel this turn\",\n   234\t        \"Other (re-enter instruction)\",\n   235\t    ];\n   236\t    // The modal has one border cell on each side and one column of margin on each side.\n   237\t    // Pre-wrap every line at the actual inner width so the height estimate includes wrapped text.\n   238\t    let width = area.width.saturating_sub(4).max(1);\n   239\t    // The sidecar message enumerates every choice for non-TUI clients. This modal\n   240\t    // renders those choices separately, so use a compact warning to keep all five\n   241\t    // visible on the smallest supported terminal size.\n   242\t    let display_message = if message.starts_with(\"Sensitive content blocked the checkpoint\") {\n   243\t        \"Sensitive content may persist if you create a checkpoint anyway.\"\n   244\t    } else {\n   245\t        message\n   246\t    };\n   247\t    let mut lines = markdown::wrap(\n   248\t        vec![Span::raw(display_message.to_owned())],\n   249\t        usize::from(width),\n   250\t        Vec::new(),\n   251\t        Vec::new(),\n   252\t    );\n   253\t    for (index, option) in options.iter().enumerate() {\n   254\t        let marker = if selected == Some(index) { \"▸\" } else { \" \" };\n   255\t        let style = Style::default().fg(Color::White);\n   256\t        lines.extend(markdown::wrap(\n   257\t            vec![Span::styled(\n   258\t                format!(\"{marker} {}. {option}\", index + 1),\n   259\t                style,\n   260\t            )],\n  1618\t    }\n  1619\t\n  1620\t    fn on_checkpoint_choice_key(&mut self, key: KeyEvent) -> Option<Action> {\n  1621\t        let Some(Overlay::CheckpointChoice { id, selected, .. }) = &mut self.overlay else { return None; };\n  1622\t        let choice = match key.code {\n  1623\t            KeyCode::Char('1') => { *selected = Some(0); return None; }\n  1624\t            KeyCode::Char('2') => { *selected = Some(1); return None; }\n  1625\t            KeyCode::Char('3') => { *selected = Some(2); return None; }\n  1626\t            KeyCode::Char('4') => { *selected = Some(3); return None; }\n  1627\t            KeyCode::Char('5') => { *selected = Some(4); return None; }\n  1628\t            KeyCode::Up | KeyCode::Left => { *selected = Some(selected.unwrap_or(0).saturating_sub(1)); return None; }\n  1629\t            KeyCode::Down | KeyCode::Right => { *selected = Some(selected.unwrap_or(0).saturating_add(1).min(4)); return None; }\n  1630\t            KeyCode::Enter => match *selected {\n  1631\t                Some(0) => Some(\"read_only\"),\n  1632\t                Some(1) => Some(\"without_checkpoint\"),\n  1633\t                Some(2) => Some(\"allow_sensitive\"),\n  1634\t                Some(3) => Some(\"cancel\"),\n  1635\t                Some(4) => Some(\"other\"),\n  1636\t                _ => return None,\n  1637\t            },\n  1638\t            KeyCode::Esc => Some(\"cancel\"),\n  1639\t            _ => return None,\n  1640\t        };\n  1641\t        let Some(choice) = choice else { return None; };\n  1642\t        let id = id.clone();\n  1643\t        self.overlay = None;\n  1644\t        Some(Action::Send(Command::CheckpointChoice { id, choice: choice.into() }))\n  1645\t    }\n  1646\t\n  1647\t    fn on_ctrl_c(&mut self) -> Option<Action> {\n  1648\t        match &self.overlay {\n  1649\t            Some(Overlay::Connect(Connect { step: Step::Waiting { request, auth: Some(_), .. }, .. })) => {\n  1650\t                let id = request.clone();\n"}],"internal_chat_messa