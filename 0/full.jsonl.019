T13:38:41Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-25T13:36:43Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40197810811/job/121182372341\",\"name\":\"javascript-typescript\",\"startedAt\":\"2026-10-25T13:35:44Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CodeQL\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-25T13:50:30Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40197810800/job/121182370244\",\"name\":\"test-matrix (24)\",\"startedAt\":\"2026-10-25T13:36:44Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-25T14:18:23Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/actions/runs/40197810800/job/121188684528\",\"name\":\"linux-x86_64\",\"startedAt\":\"2026-10-25T13:56:29Z\",\"status\":\"COMPLETED\",\"workflowName\":\"CI\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-25T13:36:36Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/mikeholownych/nexus-code/runs/121184091947\",\"name\":\"CodeQL\",\"startedAt\":\"2026-10-25T13:36:33Z\",\"status\":\"COMPLETED\",\"workflowName\":\"\"},{\"__typename\":\"StatusContext\",\"context\":\"CodeRabbit\",\"startedAt\":\"2026-10-25T13:29:28Z\",\"state\":\"SUCCESS\",\"targetUrl\":\"\"}],\"url\":\"https://github.com/mikeholownych/nexus-code/pull/232\"}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a17359-3515-7cd3-8706-e6bd2e3432cb","create_time":1792938022.4569702}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
