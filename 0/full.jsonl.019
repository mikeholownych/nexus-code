n\n .github/workflows/release.yml | 6 +++++-\n .github/workflows/repro.yml   | 4 ++++\n 2 files changed, 9 insertions(+), 1 deletion(-)\ncommit 2af50a532eddddb6071a6f0c5d61b15279499973\nAuthor:     Mike Holownych <mike@holownych.com>\nAuthorDate: Sun Oct 25 13:26:28 2026 +0000\nCommit:     Mike Holownych <mike@holownych.com>\nCommitDate: Sun Oct 25 13:26:28 2026 +0000\n\n    fix(release): pin reproducible Node and npm toolchain\n\ndiff --git a/.github/workflows/release.yml b/.github/workflows/release.yml\nindex d8ff450..53af588 100644\n--- a/.github/workflows/release.yml\n+++ b/.github/workflows/release.yml\n@@ -54,9 +54,13 @@ jobs:\n           chmod +x \"$CARGO_HOME/bin/cyclonedx\"\n       - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4\n         with:\n-          node-version: 22\n+          node-version: 22.22.1\n           cache: npm\n           cache-dependency-path: cli/package-lock.json\n+      - name: Require the pinned release Node and npm versions\n+        run: |\n+          test \"$(node --version)\" = \"v22.22.1\"\n+          test \"$(npm --version)\" = \"10.9.4\"\n       - name: Install selected Node runtime for isolated evaluation commands\n         run: |\n           node_runtime=\"$(readlink -f \"$(command -v node)\")\"\ndiff --git a/.github/workflows/repro.yml b/.github/workflows/repro.yml\nindex 0d010fe..4a6b29c 100644\n--- a/.github/workflows/repro.yml\n+++ b/.github/workflows/repro.yml\n@@ -92,6 +92,10 @@ jobs:\n           node-version: 22.22.1\n           cache: npm\n           cache-dependency-path: cli/package-lock.json\n+      - name: Require the pinned release Node and npm versions\n+        run: |\n+          test \"$(node --version)\" = \"v22.22.1\"\n+          test \"$(npm --version)\" = \"10.9.4\"\n       - name: Verify exact RC source\n         run: |\n           test \"$(git rev-parse HEAD)\" = \"$EXPECTED_TAG_SHA\"\n## v1/plan-09-repro-toolchain-sync...origin/v1/plan-09-repro-toolchain-sync\n[{\"baseRefName\"