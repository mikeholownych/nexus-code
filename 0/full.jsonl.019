{"timestamp":"2026-10-25T14:49:47.989Z","ordinal":343231,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a14cb3-25b0-7883-b3a1-0fa7cc559f92","turn_id":"01a17359-3515-7cd3-8706-e6bd2e3432cb","item":{"type":"CommandExecution","id":"exec-05ea9549-4f48-473b-bb82-7e9cb7b652a0","process_id":"30307","command":["/usr/bin/zsh","-lc","rg -n \"checkpointReadOnlyFallback|read-only mode|without_checkpoint|session.state\" cli/src/sidecar.ts cli/test/sidecar.test.ts | head -80; sed -n '430,550p' cli/test/sidecar.test.ts; sed -n '535,585p' cli/src/sidecar.ts"],"cwd":"file:///home/mike/nexus-wt/checkpoint-protected-git","parsed_cmd":[{"type":"search","cmd":"rg -n 'checkpointReadOnlyFallback|read-only mode|without_checkpoint|session.state' cli/src/sidecar.ts cli/test/sidecar.test.ts","query":"checkpointReadOnlyFallback|read-only mode|without_checkpoint|session.state","path":"sidecar.ts"},{"type":"read","cmd":"sed -n '430,550p' cli/test/sidecar.test.ts","name":"sidecar.test.ts","path":"cli/test/sidecar.test.ts"},{"type":"read","cmd":"sed -n '535,585p' cli/src/sidecar.ts","name":"sidecar.ts","path":"cli/src/sidecar.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"cli/test/sidecar.test.ts:62:      assert.equal(state.type, \"session.state\");\ncli/test/sidecar.test.ts:77:      assert.deepEqual(turnEvents[0], { ...turnEvents[0], type: \"session.state\", busy: true });\ncli/test/sidecar.test.ts:92:      assert.deepEqual(turnEvents.at(-1), { ...turnEvents.at(-1), type: \"session.state\", busy: false });\ncli/test/sidecar.test.ts:141:      assert.deepEqual(events.at(-1), { ...events.at(-1), type: \"session.state\", busy: false });\ncli/test/sidecar.test.ts:228:      const switched = events.slice(approvedAt).find((e) => e.type === \"session.state\");\ncli/test/sidecar.test.ts:229:      assert.ok(switched, \"session.state emitted right after approve-always\");\ncli/test/sidecar.test.ts:232:      const states = events.filter((e) => e.type === \"session.state\");\ncli/test/sidecar.test.ts:307:      const order = events.slice(2).map((e) => (e.type === \"session.state\" ? `state:${e.busy}` : e.type));\ncli/test/sidecar.test.ts:380:      assert.ok(events.some((event) => event.type === \"notice\" && /Continuing this turn in read-only mode as requested/.test(event.text)));\ncli/test/sidecar.test.ts:381:      assert.equal(events.filter((event) => event.type === \"session.state\").at(-1)?.mode, \"read-only\");\ncli/test/sidecar.test.ts:394:      assert.match(deniedInit.output, /disabled while the session is in read-only mode/i);\ncli/test/sidecar.test.ts:400:      assert.match(deniedProvider.message, /disabled while the session is in read-only mode/i);\ncli/test/sidecar.test.ts:404:      assert.match(deniedCatalog.message, /disabled while the session is in read-only mode/i);\ncli/test/sidecar.test.ts:408:      assert.equal(events.filter((event) => event.type === \"session.state\").at(-1)?.mode, \"read-only\");\ncli/test/sidecar.test.ts:414:      assert.equal(events.filter((event) => event.type === \"session.state\").at(-1)?.mode, \"auto\");\ncli/test/sidecar.test.ts:425:      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"without_checkpoint\" });\ncli/test/sidecar.test.ts:428:      assert.equal(events.filter((event) => event.type === \"session.state\").at(-1)?.mode, \"review\");\ncli/test/sidecar.test.ts:493:      await send({ type: \"checkpoint.choice\", id: recoveryChoice.id, choice: \"without_checkpoint\" });\ncli/test/sidecar.test.ts:519:      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"without_checkpoint\" });\ncli/test/sidecar.test.ts:585:      assert.equal(events.filter((e) => e.type === \"session.state\").at(-1).mode, \"review\");\ncli/test/sidecar.test.ts:678:        assert.equal(events.filter((e) => e.type === \"session.state\").at(-1).workspace, repo);\ncli/test/sidecar.test.ts:748:      await send({ type: \"checkpoint.choice\", id: checkpointChoice.id, choice: \"without_checkpoint\" });\ncli/src/sidecar.ts:86:  private pendingCheckpointChoice?: { id: string; settle: (choice: \"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\") => void };\ncli/src/sidecar.ts:195:          this.emit({ type: \"error\", id: command.id, code: \"BUSY\", message: \"Provider discovery is disabled while the session is in read-only mode.\" });\ncli/src/sidecar.ts:202:          this.emit({ type: \"error\", id: command.id, code: \"BUSY\", message: \"Model changes are disabled while the session is in read-only mode.\" });\ncli/src/sidecar.ts:209:          this.emit({ type: \"provider.result\", id: command.id, provider: command.provider, success: false, message: \"Provider connections are disabled while the session is in read-only mode.\" });\ncli/src/sidecar.ts:219:          this.emit({ type: \"provider.result\", id: command.id, provider: command.provider, success: false, message: \"Provider changes are disabled while the session is in read-only mode.\" });\ncli/src/sidecar.ts:569:            this.emit({ type: \"notice\", text: \"Continuing this turn in read-only mode as requested. Workspace changes, unsafe commands, external actions, and delegation are disabled.\" });\ncli/src/sidecar.ts:572:          } else if (choice === \"without_checkpoint\") {\ncli/src/sidecar.ts:670:  ): Promise<\"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\"> {\ncli/src/sidecar.ts:674:      const settle = (choice: \"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\") => {\ncli/src/sidecar.ts:691:  private resolveCheckpointChoice(id: string, choice: \"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\"): void {\ncli/src/sidecar.ts:707:        output: \"This command is disabled while the session is in read-only mode.\",\ncli/src/sidecar.ts:982:      type: \"session.state\",\n      assert.equal(app.getCheckpointManager().listCheckpoints().length, 0);\n    });\n  });\n\n  test(\"checkpoint choice rejects unknown actions\", async () => {\n    await withSidecar(() => ({ kind: \"text\", content: \"Review started.\" }), \"review\", async ({ server, events, repo, app, send }) => {\n      fs.writeFileSync(path.join(repo, \"base.txt\"), `changed ${`ghp_${\"C\".repeat(36)}`}\\n`);\n      await send({ type: \"checkpoint.choice\", id: \"checkpoint-choice-invalid\", choice: \"persist_everything\" });\n      const error = events.find((event) => event.type === \"error\" && event.id === \"checkpoint-choice-invalid\");\n      assert.equal(error.code, \"BAD_REQUEST\");\n      assert.equal(app.getCheckpointManager().listCheckpoints().length, 0);\n    });\n  });\n\n  test(\"operator can explicitly create a checkpoint that may contain sensitive workspace content\", async () => {\n    await withSidecar(() => ({ kind: \"text\", content: \"Review started.\" }), \"review\", async ({ events, repo, app, send }) => {\n      const sensitiveMarker = `ghp_${\"E\".repeat(36)}`;\n      fs.writeFileSync(path.join(repo, \"base.txt\"), `changed ${sensitiveMarker}\\n`);\n      await send({ type: \"prompt.submit\", id: \"t-sensitive-checkpoint\", text: \"review the codebase\" });\n      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\n      const request = events.find((event) => event.type === \"checkpoint.choice.request\");\n      assert.match(request.message, /1 read-only.*2 continue without a rollback checkpoint.*3 create a checkpoint anyway \\(may persist sensitive content\\).*4 cancel this turn.*5 re-enter the instruction/);\n      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"allow_sensitive\" });\n      await waitUntil(() => events.some((event) => event.type === \"turn.result\" && event.turn_id === \"t-sensitive-checkpoint\"));\n      const [checkpoint] = app.getCheckpointManager().listCheckpoints();\n      assert.ok(checkpoint?.gitRef);\n      const persisted = execFileSync(\"git\", [\"show\", `${checkpoint.gitRef}:base.txt`], { cwd: repo, encoding: \"utf8\" });\n      assert.equal(persisted.includes(sensitiveMarker), true);\n      assert.ok(events.some((event) => event.type === \"notice\" && /may persist sensitive workspace content/.test(event.text)));\n    });\n  });\n\n  test(\"checkpoint failure after sensitive persistence consent asks how to proceed\", async () => {\n    let modelCalls = 0;\n    await withSidecar(() => {\n      modelCalls += 1;\n      return { kind: \"text\", content: \"Review started.\" };\n    }, \"auto\", async ({ events, repo, app, send }) => {\n      const sensitiveMarker = `ghp_${\"G\".repeat(36)}`;\n      fs.writeFileSync(path.join(repo, \"base.txt\"), `changed ${sensitiveMarker}\\n`);\n      const checkpointManager = app.getCheckpointManager() as any;\n      const createCheckpoint = checkpointManager.createCheckpoint.bind(checkpointManager);\n      let attempts = 0;\n      checkpointManager.createCheckpoint = (name: string, options?: { allowSensitive?: boolean }) => {\n        attempts += 1;\n        if (options?.allowSensitive) {\n          throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n        }\n        return createCheckpoint(name, options);\n      };\n\n      await send({ type: \"prompt.submit\", id: \"t-sensitive-checkpoint-failure\", text: \"review the codebase\" });\n      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\n      const initialChoice = events.find((event) => event.type === \"checkpoint.choice.request\");\n      await send({ type: \"checkpoint.choice\", id: initialChoice.id, choice: \"allow_sensitive\" });\n\n      await waitUntil(() => events.some((event) => event.type === \"notice\" && /Retrying checkpoint with sensitive persistence allowed/.test(event.text)));\n      await waitUntil(() => events.filter((event) => event.type === \"checkpoint.choice.request\").length === 2);\n      const recoveryChoice = events.filter((event) => event.type === \"checkpoint.choice.request\")[1];\n      assert.match(recoveryChoice.message, /protected Git state.*No checkpoint was written/);\n      assert.match(recoveryChoice.message, /2 continue without a rollback checkpoint/);\n      assert.equal(modelCalls, 0, \"the turn must remain unstarted while awaiting an explicit recovery choice\");\n\n      await send({ type: \"checkpoint.choice\", id: recoveryChoice.id, choice: \"without_checkpoint\" });\n      await waitUntil(() => events.some((event) => event.type === \"turn.result\" && event.turn_id === \"t-sensitive-checkpoint-failure\"));\n      assert.equal(attempts, 2);\n      assert.ok(modelCalls > 0, \"the explicitly authorized turn should proceed\");\n      assert.equal(app.getCheckpointManager().listCheckpoints().length, 0);\n      assert.ok(events.some((event) => event.type === \"notice\" && /without a rollback checkpoint, as requested/.test(event.text)));\n    });\n  });\n\n  test(\"an initial checkpoint failure offers read-only and no-checkpoint choices\", async () => {\n    let modelCalls = 0;\n    await withSidecar(() => {\n      modelCalls += 1;\n      return { kind: \"text\", content: \"Review started.\" };\n    }, \"auto\", async ({ events, app, send }) => {\n      const checkpointManager = app.getCheckpointManager() as any;\n      checkpointManager.createCheckpoint = () => {\n        throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n      };\n\n      await send({ type: \"prompt.submit\", id: \"t-initial-checkpoint-failure\", text: \"review the codebase\" });\n      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\n      const request = events.find((event) => event.type === \"checkpoint.choice.request\");\n      assert.match(request.message, /protected Git state.*No checkpoint was written/);\n      assert.equal(modelCalls, 0, \"the turn must remain unstarted 