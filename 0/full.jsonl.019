ning is ended by the runner (its whole process\n    * group, through the bridge's turn signal) and awaited until it settles; background processes earlier commands of\n    * this session left running are ended too (REQ-AGT-109).\ndiff --git a/cli/src/core/app.ts b/cli/src/core/app.ts\nindex 2470392..cc3081b 100644\n--- a/cli/src/core/app.ts\n+++ b/cli/src/core/app.ts\n@@ -8,11 +8,11 @@\n import { withDurableSync } from \"./durable_file.js\";\n import { EventEmitter } from \"node:events\";\n import * as path from \"node:path\";\n import * as fs from \"node:fs\";\n import { AutonomousAgent } from \"../agent.js\";\n-import { HarnessConfig, ChatMessage } from \"../types.js\";\n+import { HarnessConfig, ChatMessage, EvaluationToolReceipt } from \"../types.js\";\n import { SessionManager, SessionData } from \"../session.js\";\n import {\n   DurableStateManager,\n   DurableTaskState,\n   DurablePlanPhase,\n@@ -60,10 +60,12 @@ export interface TaskExecutionResult {\n   logs?: string[];\n   /** Authoritative turn semantics; `success`/`status` are projections of this. */\n   turn: TurnResult;\n   /** Process exit code contract: 0 verified/nothing to verify, 2 completed-unverified, 130 interrupted, 1 otherwise. */\n   exitCode: number;\n+  /** Present only when the evaluator explicitly opts in; contains no command or output text. */\n+  evaluationToolReceipts?: EvaluationToolReceipt[];\n }\n \n export interface SlashCommandResult {\n   command: string;\n   subcommand?: string;\n@@ -170,10 +172,11 @@ export class ApplicationCore extends EventEmitter {\n    * Executes a task through the unified execution spine and durable state lifecycle (UI-001, UI-002, UI-003).\n    */\n   public async runTask(prompt: string, options: RunTaskOptions = {}): Promise<TaskExecutionResult> {\n     const startTime = Date.now();\n     let taskId = this.agent.getTaskId();\n+    if (process.env.NEXUS_EVAL_TOOL_RECEIPTS === \"1\") this.agent.clearEvaluationToolReceipts();\n \n     if (options.resumeTaskId