ype: \"checkpoint.choice\", id: request.id, choice: \"without_checkpoint\" });\n+      await waitUntil(() => events.some((event) => event.type === \"turn.result\" && event.turn_id === \"t-initial-checkpoint-failure\"));\n+      assert.ok(modelCalls > 0, \"the explicitly authorized turn should proceed\");\n+      assert.ok(events.some((event) => event.type === \"notice\" && /without a rollback checkpoint, as requested/.test(event.text)));\n+    });\n+  });\n+\n   test(\"cancel choice does not start the turn\", async () => {\n     await withSidecar(() => ({ kind: \"text\", content: \"must not run\" }), \"review\", async ({ server, events, repo, send }) => {\n       fs.writeFileSync(path.join(repo, \"base.txt\"), `changed ${`ghp_${\"D\".repeat(36)}`}\\n`);\ndiff --git a/core/src/bin/nexus_tui/live_view.rs b/core/src/bin/nexus_tui/live_view.rs\nindex 763f4fe..8fa33f5 100644\n--- a/core/src/bin/nexus_tui/live_view.rs\n+++ b/core/src/bin/nexus_tui/live_view.rs\n@@ -240,12 +240,15 @@ fn render_checkpoint_choice(\n     // renders those choices separately, so use a compact warning to keep all five\n     // visible on the smallest supported terminal size.\n     let display_message = if message.starts_with(\"Sensitive content blocked the checkpoint\") {\n-        \"Sensitive content may persist if you create a checkpoint anyway.\"\n+        \"Sensitive content may persist if you create a checkpoint anyway.\".to_owned()\n+    } else if let Some(failure) = message.strip_prefix(\"Checkpoint failed: \") {\n+        let failure = failure.split(\". Choose \").next().unwrap_or(failure);\n+        format!(\"Checkpoint failed: {failure} Retry may persist sensitive content.\")\n     } else {\n-        message\n+        message.to_owned()\n     };\n     let mut lines = markdown::wrap(\n-        vec![Span::raw(display_message.to_owned())],\n+        vec![Span::raw(display_message)],\n         usize::from(width),\n         Vec::new(),\n         Vec::new(),\n@@ -2654,6 +2657,24 @@ mod tests