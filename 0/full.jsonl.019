 { type: \"tool.detail\"; id: string; evidence: string }\n   | { type: \"receipt\"; id: string }\n@@ -229,7 +229,7 @@ export function parseCommand(line: string): SidecarCommand {\n       return { type: \"deny\", id: requireId(\"deny\") };\n     case \"checkpoint.choice\": {\n       const requestId = requireId(\"checkpoint.choice\");\n-      const choices = [\"read_only\", \"without_checkpoint\", \"allow_sensitive\", \"cancel\", \"other\"] as const;\n+      const choices = [\"read_only\", \"without_checkpoint\", \"retry\", \"allow_sensitive\", \"cancel\", \"other\"] as const;\n       if (!choices.includes(msg.choice as typeof choices[number])) throw new ProtocolError(\"checkpoint.choice requires a supported choice\", requestId);\n       return { type: \"checkpoint.choice\", id: requestId, choice: msg.choice as typeof choices[number] };\n     }\ndiff --git a/cli/src/sidecar.ts b/cli/src/sidecar.ts\nindex 19a2563..78be8f1 100644\n--- a/cli/src/sidecar.ts\n+++ b/cli/src/sidecar.ts\n@@ -24,6 +24,7 @@ import { STEERING_PREFIX } from \"./core/objective.js\";\n /** Messages of a resumed conversation sent to the client, and the characters kept of each. */\n const HISTORY_ENTRIES = 60;\n const HISTORY_CHARS = 4000;\n+type CheckpointChoice = \"read_only\" | \"without_checkpoint\" | \"retry\" | \"allow_sensitive\" | \"cancel\" | \"other\";\n \n function readOnlySlashAllowed(command: string, args: string): boolean {\n   const spec = findSlash(command);\n@@ -83,7 +84,7 @@ export class SidecarServer {\n   private activeTurn?: Promise<void>;\n   private turnAbort?: AbortController;\n   private pendingApproval?: { id: string; settle: (approved: boolean) => void };\n-  private pendingCheckpointChoice?: { id: string; settle: (choice: \"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\") => void };\n+  private pendingCheckpointChoice?: { id: string; choices: readonly CheckpointChoice[]; settle: (choice: CheckpointChoice) => void };\n   private approvalSeq = 0;\n   private shutdownPromise?: Promise<void>;\n   private readonly resume?: string;\n@@ -557,8 +558,11 @@ export class SidecarServer {\n           );\n           const message = sensitiveContentBlocked\n             ? undefined\n-            : `Checkpoint failed: ${failure}. No checkpoint was written. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 retry while allowing sensitive persistence, 4 cancel this turn, or 5 re-enter the instruction.`;\n-          const choice = await this.requestCheckpointChoice(turnId, signal, message);\n+            : `Checkpoint failed: ${failure}. No checkpoint was written. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 retry checkpoint normally, 4 cancel this turn, or 5 re-enter the instruction.`;\n+          const choices: readonly CheckpointChoice[] = sensitiveContentBlocked\n+            ? [\"read_only\", \"without_checkpoint\", \"allow_sensitive\", \"cancel\", \"other\"]\n+            : [\"read_only\", \"without_checkpoint\", \"retry\", \"cancel\", \"other\"];\n+          const choice = await this.requestCheckpointChoice(turnId, signal, message, choices);\n           if (choice === \"cancel\" || choice === \"other\") {\n             const message = choice === \"other\"\n               ? \"This turn was not started. Enter a different instruction in the composer.\"\n@@ -577,6 +581,8 @@ export class SidecarServer {\n             if (agent.getApprovalMode() !== previousApprovalMode) this.emitSessionState();\n             this.emit({ type: \"notice\", text: \"Continuing in the current mode without a rollback checkpoint, as requested.\" });\n             checkpointReady = true;\n+          } else if (choice === \"retry\") {\n+            this.emit({ type: \"notice\", text: \"Retrying checkpoint without changing sensitive-persistence settings. The turn remains paused until the retry succeeds or you choose another option.\" });\n           } else if (choice === \"allow_sensitive\") {\n             allowSensitiveCheckpoint = true;\n             this.emit({ type: \"notice\", text: \"Retrying checkpoint with sensitive persistence allowed, as requested; this may persist sensitive workspace content. The turn will wait until the retry succeeds or you choose another option.\" });\n@@ -671,18 +677,19 @@ export class SidecarServer {\n     turnId: string,\n     signal: AbortSignal,\n     message = \"Sensitive content blocked the checkpoint. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 create a checkpoint anyway (may persist sensitive content), 4 cancel this turn, or 5 re-enter the instruction.\",\n-  ): Promise<\"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\"> {\n+    choices: readonly CheckpointChoice[] = [\"read_only\", \"without_checkpoint\", \"allow_sensitive\", \"cancel\", \"other\"],\n+  ): Promise<CheckpointChoice> {\n     if (signal.aborted) return Promise.resolve(\"cancel\");\n     const id = `checkpoint-choice-${++this.approvalSeq}`;\n     return new Promise((resolve) => {\n-      const settle = (choice: \"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\") => {\n+      const settle = (choice: CheckpointChoice) => {\n         signal.removeEventListener(\"abort\", onAbort);\n         this.pendingCheckpointChoice = undefined;\n         resolve(choice);\n       };\n       const onAbort = () => settle(\"cancel\");\n       signal.addEventListener(\"abort\", onAbort, { once: true });\n-      this.pendingCheckpointChoice = { id, settle };\n+      this.pendingCheckpointChoice = { id, choices, settle };\n       this.emit({\n         type: \"checkpoint.choice.request\",\n         id,\n@@ -692,12 +699,16 @@ export class SidecarServer {\n     });\n   }\n \n-  private resolveCheckpointChoice(id: string, choice: \"read_only\" | \"without_checkpoint\" | \"allow_sensitive\" | \"cancel\" | \"other\"): void {\n+  private resolveCheckpointChoice(id: string, choice: CheckpointChoice): void {\n     const pending = this.pendingCheckpointChoice;\n     if (!pending || pending.id !== id) {\n       this.emit({ type: \"error\", id, code: \"NOT_FOUND\", message: `No pending checkpoint choice with id ${id}.` });\n       return;\n     }\n+    if (!pending.choices.includes(choice)) {\n+      this.emit({ type: \"error\", id, code: \"BAD_REQUEST\", message: \"That choice is not available for this checkpoint failure.\" });\n+      return;\n+    }\n     pending.settle(choice);\n   }\n \ndiff --git a/cli/test/sidecar.test.ts b/cli/test/sidecar.test.ts\nindex 2ecbec6..3b02675 100644\n--- a/cli/test/sidecar.test.ts\n+++ b/cli/test/sidecar.test.ts\n@@ -562,6 +562,39 @@ describe(\"SidecarServer: sessions and slash commands\", () => {\n     });\n   });\n \n+  test(\"a normal checkpoint retry does not grant sensitive-persistence consent\", async () => {\n+    let modelCalls = 0;\n+    await withSidecar(() => {\n+      modelCalls += 1;\n+      return { kind: \"text\", content: \"Review started.\" };\n+    }, \"auto\", async ({ events, app, send }) => {\n+      const checkpointManager = app.getCheckpointManager() as any;\n+      const createCheckpoint = checkpointManager.createCheckpoint.bind(checkpointManager);\n+      let attempts = 0;\n+      checkpointManager.createCheckpoint = (name: string, options?: { allowSensitive?: boolean }) => {\n+        attempts += 1;\n+        assert.equal(options, undefined, \"normal retry must not opt in to sensitive persistence\");\n+        if (attempts === 1) throw new Error(\"Checkpoint could not verify protected Git state; no checkpoint was written\");\n+        return createCheckpoint(name, options);\n+      };\n+\n+      await send({ type: \"prompt.submit\", id: \"t-normal-checkpoint-retry\", text: \"review the codebase\" });\n+      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\n+      const request = events.find((event) => event.type === \"checkpoint.choice.request\");\n+      assert.match(request.message, /3 retry checkpoint normally/);\n+      assert.doesNotMatch(request.message, /allowing sensitive persistence/);\n+      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"allow_sensitive\" });\n+      await waitUntil(() => events.some((event) => event.type === \"error\" && event.id === request.id && event.code === \"BAD_REQUEST\"));\n+      assert.equal(modelCalls, 0, \"an unavailable choice must leave the turn paused\");\n+\n+      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"retry\" });\n+      await waitUntil(() => events.some((event) => event.type === \"turn.result\" && event.turn_id === \"t-normal-checkpoint-retry\"));\n+      assert.equal(attempts, 2);\n+      assert.equal(modelCalls, 1);\n+      assert.equal(app.getCheckpointManager().listCheckpoints().length, 1);\n+    });\n+  });\n+\n   test(\"cancel choice does not start the turn\", async () => {\n     await withSidecar(() => ({ kind: \"text\", content: \"must not run\" }), \"review\", async ({ server, events, repo, send }) => {\n       fs.writeFileSync(path.join(repo, \"base.txt\"), `changed ${`ghp_${\"D\".repeat(36)}`}\\n`);\ndiff --git a/core/src/bin/nexus_tui/live_state.rs b/core/src/bin/nexus_tui/live_state.rs\nindex 269442c..7354182 100644\n--- a/core/src/bin/nexus_tui/live_state.rs\n+++ b/core/src/bin/nexus_tui/live_state.rs\n@@ -1618,7 +1618,8 @@ impl LiveState {\n     }\n \n     fn on_checkpoint_choice_key(&mut self, key: KeyEvent) -> Option<Action> {\n-        let Some(Overlay::CheckpointChoice { id, selected, .. }) = &mut self.overlay else { return None; };\n+        let Some(Overlay::CheckpointChoice { id, message, selected }) = &mut self.overlay else { return None; };\n+        let is_checkpoint_failure = message.starts_with(\"Checkpoint failed: \");\n         let choice = match key.code {\n             KeyCode::Char('1') => { *selected = Some(0); return None; }\n             KeyCode::Char('2') => { *selected = Some(1); return None; }\n@@ -1630,6 +1631,7 @@ impl LiveState {\n             KeyCode::Enter => match *selected {\n                 Some(0) => Some(\"read_only\"),\n                 Some(1) => Some(\"without_checkpoint\"),\n+                Some(2) if is_checkpoint_failure => Some(\"retry\"),\n                 Some(2) => Some(\"allow_sensitive\"),\n                 Some(3) => Some(\"cancel\"),\n                 Some(4) => Some(\"other\"),\n@@ -3073,6 +3075,12 @@ mod tests {\n             id: \"choice-2\".into(),\n             choice: \"other\".into(),\n         })));\n+        state.apply(ev(r#\"{\"v\":1,\"type\":\"checkpoint.choice.request\",\"id\":\"choice-3\",\"turn_id\":\"t1\",\"message\":\"Checkpoint failed: protected Git state could not be verified. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 retry checkpoint normally, 4 cancel this turn, or 5 re-enter the instruction.\"}\"#));\n+        assert_eq!(state.on_key(key(KeyCode::Char('3'))), None);\n+        assert_eq!(state.on_key(key(KeyCode::Enter)), Some(Action::Send(Command::CheckpointChoice {\n+            id: \"choice-3\".into(),\n+            choice: \"retry\".into(),\n+        })));\n     }\n \n     const APPROVAL: &str = r#\"{\"v\":1,\"type\":\"approval.request\",\"id\":\"approval-1\",\"turn_id\":\"t1\",\"tool\":\"write_file\",\"subject\":\"x.txt\",\"preview\":\"{}\",\"review\":{\"kind\":\"change\",\"path\":\"x.txt\",\"before\":null,\"after\":\"hi\\n\",\"created\":true,\"truncated\":false}}\"#;\ndiff --git a/core/src/bin/nexus_tui/live_view.rs b/core/src/bin/nexus_tui/live_view.rs\nindex a98ef4d..8c3bfa8 100644\n--- a/core/src/bin/nexus_tui/live_view.rs\n+++ b/core/src/bin/nexus_tui/live_view.rs\n@@ -226,24 +226,33 @@ fn render_checkpoint_choice(\n     selected: Option<usize>,\n ) -> usize {\n     let key = Style::default().fg(ACCENT).add_modifier(Modifier::BOLD);\n-    let options = [\n-        \"Read-only\",\n-        \"Continue without checkpoint\",\n-        \"Create checkpoint anyway\",\n-        \"Cancel this turn\",\n-        \"Other (re-enter instruction)\",\n-    ];\n+    let options = if message.starts_with(\"Checkpoint failed: \") {\n+        [\n+            \"Read-only\",\n+            \"Continue without checkpoint\",\n+            \"Retry checkpoint\",\n+            \"Cancel this turn\",\n+            \"Other (re-enter instruction)\",\n+        ]\n+    } else {\n+        [\n+            \"Read-only\",\n+            \"Continue without checkpoint\",\n+            \"Create checkpoint anyway\",\n+            \"Cancel this turn\",\n+            \"Other (re-enter instruction)\",\n+        ]\n+    };\n     // The modal has one border cell on each side and one column of margin on each side.\n     // Pre-wrap every line at the actual inner width so the height estimate includes wrapped text.\n     let width = area.width.saturating_sub(4).max(1);\n     // The sidecar message enumerates every choice for non-TUI clients. This modal\n-    // renders those choices separately, so use a compact warning to keep all five\n-    // visible on the smallest supported terminal size.\n+    // renders those choices separately, so keep the explanation compact enough for 40x14.\n     let display_message = if message.starts_with(\"Sensitive content blocked the checkpoint\") {\n         \"Sensitive content may persist if you create a checkpoint anyway.\".to_owned()\n     } else if let Some(failure) = message.strip_prefix(\"Checkpoint failed: \") {\n         let failure = failure.split(\". Choose \").next().unwrap_or(failure);\n-        format!(\"Checkpoint failed: {failure} Retry may persist sensitive content.\")\n+        format!(\"Checkpoint failed: {failure} Retrying keeps sensitive-persistence settings unchanged.\")\n     } else {\n         message.to_owned()\n     };\n@@ -2660,21 +2669,22 @@ mod tests {\n     #[test]\n     fn checkpoint_failure_modal_keeps_reason_and_choices_visible_on_small_terminal() {\n         let mut state = ready();\n-        feed(&mut state, &[r#\"{\"v\":1,\"type\":\"checkpoint.choice.request\",\"id\":\"choice-failure\",\"turn_id\":\"t1\",\"message\":\"Checkpoint failed: protected Git state could not be verified. No checkpoint was written. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 retry while allowing sensitive persistence, 4 cancel this turn, or 5 re-enter the instruction.\"}\"#]);\n+        feed(&mut state, &[r#\"{\"v\":1,\"type\":\"checkpoint.choice.request\",\"id\":\"choice-failure\",\"turn_id\":\"t1\",\"message\":\"Checkpoint failed: protected Git state could not be verified. No checkpoint was written. Choose 1 read-only, 2 continue without a rollback checkpoint, 3 retry checkpoint normally, 4 cancel this turn, or 5 re-enter the instruction.\"}\"#]);\n         let screen = draw(&state, 40, 14);\n         assert_shows(&screen, &[\n             \"protected Git\",\n             \"state could not be verified.\",\n             \"checkpoint was written\",\n-            \"Retry may\",\n-            \"persist sensitive content.\",\n+            \"Retrying keeps\",\n+            \"sensitive-persistence settings unchanged.\",\n             \"Read-only\",\n             \"Continue without checkpoint\",\n-            \"Create checkpoint anyway\",\n+            \"Retry checkpoint\",\n             \"Cancel this turn\",\n             \"Other (re-enter instruction)\",\n             \"1–5 choose\",\n         ]);\n+        assert!(!screen.contains(\"Create checkpoint anyway\"));\n     }\n \n     #[test]\n","exit_code":0,"duration":{"secs":0,"nanos":889039896}},"started_at_ms":1792940168415,"completed_at_ms":1792940169304}}
