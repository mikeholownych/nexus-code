=> event.type === \"checkpoint.choice.request\"));\ncli/test/sidecar.test.ts:374:      const request = events.find((event) => event.type === \"checkpoint.choice.request\");\ncli/test/sidecar.test.ts:375:      assert.match(request.message, /Sensitive content blocked the checkpoint/);\ncli/test/sidecar.test.ts:377:      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"read_only\" });\ncli/test/sidecar.test.ts:435:      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\ncli/test/sidecar.test.ts:436:      const firstChoice = events.find((event) => event.type === \"checkpoint.choice.request\");\ncli/test/sidecar.test.ts:437:      await send({ type: \"checkpoint.choice\", id: firstChoice.id, choice: \"read_only\" });\ncli/test/sidecar.test.ts:442:      await waitUntil(() => events.filter((event) => event.type === \"checkpoint.choice.request\").length === 2);\ncli/test/sidecar.test.ts:443:      const secondChoice = events.filter((event) => event.type === \"checkpoint.choice.request\")[1];\ncli/test/sidecar.test.ts:445:      await send({ type: \"checkpoint.choice\", id: secondChoice.id, choice: \"without_checkpoint\" });\ncli/test/sidecar.test.ts:462:      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\ncli/test/sidecar.test.ts:463:      const request = events.find((event) => event.type === \"checkpoint.choice.request\");\ncli/test/sidecar.test.ts:464:      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"without_checkpoint\" });\ncli/test/sidecar.test.ts:473:  test(\"checkpoint choice rejects unknown actions\", async () => {\ncli/test/sidecar.test.ts:476:      await send({ type: \"checkpoint.choice\", id: \"checkpoint-choice-invalid\", choice: \"persist_everything\" });\ncli/test/sidecar.test.ts:477:      const error = events.find((event) => event.type === \"error\" && event.id === \"checkpoint-choice-invalid\");\ncli/test/sidecar.test.ts:488:      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\ncli/test/sidecar.test.ts:489:      const request = events.find((event) => event.type === \"checkpoint.choice.request\");\ncli/test/sidecar.test.ts:491:      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"allow_sensitive\" });\ncli/test/sidecar.test.ts:521:      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\ncli/test/sidecar.test.ts:522:      const initialChoice = events.find((event) => event.type === \"checkpoint.choice.request\");\ncli/test/sidecar.test.ts:523:      await send({ type: \"checkpoint.choice\", id: initialChoice.id, choice: \"allow_sensitive\" });\ncli/test/sidecar.test.ts:526:      await waitUntil(() => events.filter((event) => event.type === \"checkpoint.choice.request\").length === 2);\ncli/test/sidecar.test.ts:527:      const recoveryChoice = events.filter((event) => event.type === \"checkpoint.choice.request\")[1];\ncli/test/sidecar.test.ts:532:      await send({ type: \"checkpoint.choice\", id: recoveryChoice.id, choice: \"without_checkpoint\" });\ncli/test/sidecar.test.ts:541:  test(\"an initial checkpoint failure offers read-only and no-checkpoint choices\", async () => {\ncli/test/sidecar.test.ts:553:      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\ncli/test/sidecar.test.ts:554:      const request = events.find((event) => event.type === \"checkpoint.choice.request\");\ncli/test/sidecar.test.ts:558:      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"without_checkpoint\" });\ncli/test/sidecar.test.ts:569:      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\ncli/test/sidecar.test.ts:570:      const request = events.find((event) => event.type === \"checkpoint.choice.request\");\ncli/test/sidecar.test.ts:571:      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"cancel\" });\ncli/test/sidecar.test.ts:582:      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\ncli/test/sidecar.test.ts:583:      const request = events.find((event) => event.type === \"checkpoint.choice.request\");\ncli/test/sidecar.test.ts:584:      await send({ type: \"checkpoint.choice\", id: request.id, choice: \"other\" });\ncli/test/sidecar.test.ts:785:      await waitUntil(() => events.some((event) => event.type === \"checkpoint.choice.request\"));\ncli/test/sidecar.test.ts:786:      const checkpointChoice = events.find((event) => event.type === \"checkpoint.choice.request\");\ncli/test/sidecar.test.ts:787:      await send({ type: \"checkpoint.choice\", id: checkpointChoice.id, choice: \"without_checkpoint\" });\ncore/src/bin/nexus_tui/live_state.rs:379:    CheckpointChoice { id: String, message: String, selected: Option<usize> },\ncore/src/bin/nexus_tui/live_state.rs:917:            Event::CheckpointChoiceRequest { id, message } => {\ncore/src/bin/nexus_tui/live_state.rs:918:                self.overlay = Some(Overlay::CheckpointChoice { id, message, selected: None });\ncore/src/bin/nexus_tui/live_state.rs:1550:            Some(Overlay::CheckpointChoice { .. }) => return self.on_checkpoint_choice_key(key),\ncore/src/bin/nexus_tui/live_state.rs:1620:    fn on_checkpoint_choice_key(&mut self, key: KeyEvent) -> Option<Action> {\ncore/src/bin/nexus_tui/live_state.rs:1621:        let Some(Overlay::CheckpointChoice { id, selected, .. }) = &mut self.overlay else { return None; };\ncore/src/bin/nexus_tui/live_state.rs:1632:                Some(1) => Some(\"without_checkpoint\"),\ncore/src/bin/nexus_tui/live_state.rs:1633:                Some(2) => Some(\"allow_sensitive\"),\ncore/src/bin/nexus_tui/live_state.rs:1644:        Some(Action::Send(Command::CheckpointChoice { id, choice: choice.into() }))\ncore/src/bin/nexus_tui/live_state.rs:1666:            Some(Overlay::CheckpointChoice { id, .. }) => {\ncore/src