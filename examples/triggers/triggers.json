{
  "version": 1,
  "triggers": [
    {
      "format": "nexus-trigger",
      "version": 1,
      "id": "example-readme",
      "event": { "kind": "file-change", "paths": ["README.md"] },
      "action": { "prompt": "README.md changed. Read it and report its first line. Do not modify files.", "policy": "read-only" },
      "rate": { "maxPerMinute": 2, "maxPerHour": 10, "maxPerDay": 50 },
      "bounds": { "maxToolInvocations": 20, "maxRounds": 10, "maxTurnMinutes": 10 }
    },
    {
      "format": "nexus-trigger",
      "version": 1,
      "id": "example-hook",
      "event": { "kind": "webhook", "secretEnv": "NEXUS_TRIGGER_EXAMPLE_HOOK" },
      "action": { "prompt": "A webhook delivery arrived. Read README.md and report its first line. Do not modify files.", "policy": "read-only" },
      "rate": { "maxPerMinute": 2, "maxPerHour": 10, "maxPerDay": 50 },
      "bounds": { "maxToolInvocations": 20, "maxRounds": 10, "maxTurnMinutes": 10 }
    }
  ]
}
