⚡ Tool Call: write_file {"content":"from deploy import plan, apply\n\n# Test the exact requirements from the task\n\ndef test_dry_run_no_modification():\n    \"\"\"Test that when dry_run=True, state is not modified\"\"\"\n    state = {\"web\": \"1.0\", \"api\": \"2.0\"}\n    log = []\n    actions = [(\"create\", \"db\", \"1.0\"), (\"update\", \"web\", \"1.1\"), (\"delete\", \"api\", \"2.0\")]\n    \n    # Apply with dry_run=True\n    result_state = apply(actions, state, log, dry_run=True)\n    \n    # State should remain unchanged\n    assert state == {\"web\": \"1.0\", \"api\": \"2.0\"}\n    # Result state should be the same as input state\n    assert result_state == {\"web\": \"1.0\", \"api\": \"2.0\"}\n    # Log should contain [dry-run] prefix\n    assert log == [\"[dry-run] create db 1.0\", \"[dry-run] update web 1.1\", \"[dry-run] delete api 2.0\"]\n\ndef test_prune_behavior():\n    \"\"\"Test that prune=False prevents delete actions for services only in current\"\"\"\n    services = {\"web\": \"1.2\", \"api\": \"2.0\"}\n    current = {\"web\": \"1.0\", \"api\": \"2.0\", \"db\": \"1.0\"}\n    \n    # With prune=True (default), should generate delete action\n    actions_with_prune = plan(services, current, prune=True)\n    assert (\"delete\", \"db\", \"1.0\") in actions_with_prune\n    \n    # With prune=False, should NOT generate delete action\n    actions_without_prune = plan(services, current, prune=False)\n    assert (\"delete\", \"db\", \"1.0\") not in actions_without_prune\n\nif __name__ == \"__main__\":\n    test_dry_run_no_modification()\n    test_prune_behavior()\n    print(\"All tests passed!\")","path":"tests/test_requirements.py","overwrite":true}
