⚡ Tool Call: write_file {"content":"from ratelimit import TokenBucket\n\n\nclass Clock:\n    def __init__(self):\n        self.t = 0.0\n\n    def __call__(self):\n        return self.t\n\n\ndef test_no_burst_beyond_capacity_after_idle():\n    clk = Clock()\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\n    for _ in range(3):\n        assert b.allow()\n    clk.t += 100\n    allowed = sum(1 for _ in range(10) if b.allow())\n    assert allowed == 3, allowed\n\n\ndef test_large_cost_always_rejected():\n    clk = Clock()\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\n    # Try to allow a cost larger than capacity - should always fail\n    assert not b.allow(5)\n    # Verify no tokens were consumed\n    assert b.tokens == 3\n\n\ndef test_cost_exactly_capacity_allowed():\n    clk = Clock()\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\n    # Allow exactly the capacity - should work\n    assert b.allow(3)\n    # Verify tokens were consumed\n    assert b.tokens == 0\n\n\ndef test_refill_respects_capacity():\n    clk = Clock()\n    b = TokenBucket(rate=2, capacity=5, clock=clk)\n    # Use all tokens\n    assert b.allow(5)\n    assert b.tokens == 0\n    # Advance time to refill 2 tokens per second * 3 seconds = 6 tokens\n    # But capacity is 5, so only 5 should be available\n    clk.t += 3\n    # Refill should be capped at capacity\n    assert b.allow(5)\n    assert b.tokens == 0  # All tokens consumed again\n\n\ndef test_small_costs():\n    clk = Clock()\n    b = TokenBucket(rate=1, capacity=3, clock=clk)\n    # Allow small costs\n    assert b.allow(1)\n    assert b.tokens == 2\n    assert b.allow(1)\n    assert b.tokens == 1\n    assert b.allow(1)\n    assert b.tokens == 0\n    # No more tokens available\n    assert not b.allow(1)\n    # Advance time to refill\n    clk.t += 1\n    assert b.allow(1)\n    assert b.tokens == 0","path":"tests/test_ratelimit.py","overwrite":true}
