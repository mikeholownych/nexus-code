⚡ Tool Call: write_file {"content":"import sqlite3\nimport db\n\n\ndef test_basic_migration():\n    conn = sqlite3.connect(\":memory:\")\n    db.init_v1(conn)\n    conn.execute(\"INSERT INTO users (name, email) VALUES ('a', 'A@Example.COM')\")\n    db.migrate(conn)\n    assert db.version(conn) == 2\n    assert conn.execute(\"SELECT email_domain FROM users\").fetchone()[0] == \"example.com\"\n\n\ndef test_migration_with_null_email():\n    conn = sqlite3.connect(\":memory:\")\n    db.init_v1(conn)\n    conn.execute(\"INSERT INTO users (name, email) VALUES ('b', NULL)\")\n    db.migrate(conn)\n    assert db.version(conn) == 2\n    assert conn.execute(\"SELECT email_domain FROM users\").fetchone()[0] is None\n\n\ndef test_migration_with_no_at_symbol():\n    conn = sqlite3.connect(\":memory:\")\n    db.init_v1(conn)\n    conn.execute(\"INSERT INTO users (name, email) VALUES ('c', 'no-at-symbol')\")\n    db.migrate(conn)\n    assert db.version(conn) == 2\n    assert conn.execute(\"SELECT email_domain FROM users\").fetchone()[0] is None\n\n\ndef test_migration_with_multiple_at_symbols():\n    conn = sqlite3.connect(\":memory:\")\n    db.init_v1(conn)\n    conn.execute(\"INSERT INTO users (name, email) VALUES ('d', 'user@domain@com')\")\n    db.migrate(conn)\n    assert db.version(conn) == 2\n    # Should take the part after the first @\n    assert conn.execute(\"SELECT email_domain FROM users\").fetchone()[0] == \"domain@com\"\n\n\ndef test_idempotent_migration():\n    conn = sqlite3.connect(\":memory:\")\n    db.init_v1(conn)\n    conn.execute(\"INSERT INTO users (name, email) VALUES ('e', 'test@domain.com')\")\n    # Run migration twice\n    db.migrate(conn)\n    db.migrate(conn)\n    assert db.version(conn) == 2\n    assert conn.execute(\"SELECT email_domain FROM users\").fetchone()[0] == \"domain.com\"\n\n\ndef test_existing_schema_version():\n    conn = sqlite3.connect(\":memory:\")\n    db.init_v1(conn)\n    conn.execute(\"INSERT INTO users (name, email) VALUES ('f', 'test@domain.com')\")\n    # Manually set version to 2 to simulate already migrated\n    conn.execute(\"UPDATE schema_version SET version = 2\")\n    db.migrate(conn)  # Should not fail and should not change anything\n    assert db.version(conn) == 2\n    assert conn.execute(\"SELECT email_domain FROM users\").fetchone()[0] is None","path":"tests/test_db_comprehensive.py","overwrite":true}
