⚡ Tool Call: write_file {"path":"durations.py","content":"def parse_duration(text):\n    \"\"\"Parse a human-readable duration into whole seconds (int).\n\n    Grammar: one or more `<integer><unit>` groups, units d, h, m, s (case-insensitive), groups optionally\n    separated by exactly one space. Examples: \"1h30m\" -> 5400, \"2d\" -> 172800, \"45s\" -> 45, \"1H 30M\" -> 5400.\n    Leading and trailing whitespace is ignored. Leading zeros are fine (\"01h\" -> 3600) and \"0s\" -> 0.\n    Units must appear at most once and in descending order (d, h, m, s).\n    A bare integer with no unit, an empty or whitespace-only string, an unknown unit, a negative or decimal\n    number, two or more spaces between groups, or a space between a number and its unit all raise ValueError.\n    \"\"\"\n    # Strip leading and trailing whitespace\n    text = text.strip()\n    \n    # Check for empty or whitespace-only string\n    if not text:\n        raise ValueError(\"Empty or whitespace-only string\")\n    \n    # Define unit multipliers (in seconds)\n    unit_multipliers = {\n        'd': 24 * 60 * 60,  # 86400 seconds per day\n        'h': 60 * 60,       # 3600 seconds per hour\n        'm': 60,            # 60 seconds per minute\n        's': 1              # 1 second per second\n    }\n    \n    # Parse the text into groups of number + unit\n    # First, check if there are multiple spaces (which is invalid)\n    if '  ' in text:\n        raise ValueError(\"Two or more spaces between groups\")\n    \n    # Split by space to get groups\n    groups = text.split(' ')\n    \n    # Check if any group has a space within it (invalid)\n    for group in groups:\n        if ' ' in group:\n            raise ValueError(\"Space between number and unit\")\n    \n    # Process groups\n    total_seconds = 0\n    seen_units = set()\n    unit_order = ['d', 'h', 'm', 's']\n    \n    for group in groups:\n        if not group:\n            continue\n        \n        # Find the unit (last character)\n        if not group[-1].lower() in unit_multipliers:\n            raise ValueError(\"Unknown unit\")\n        \n        unit = group[-1].lower()\n        number_str = group[:-1]\n        \n        # Check if number string is empty\n        if not number_str:\n            raise ValueError(\"Bare integer with no unit\")\n        \n        # Check for negative numbers\n        if number_str.startswith('-'):\n            raise ValueError(\"Negative number\")\n        \n        # Check for decimal numbers\n        if '.' in number_str:\n            raise ValueError(\"Decimal number\")\n        \n        # Parse the number\n        try:\n            number = int(number_str)\n        except ValueError:\n            raise ValueError(\"Invalid number format\")\n        \n        # Check if unit was already seen\n        if unit in seen_units:\n            raise ValueError(\"Unit appears more than once\")\n        \n        # Check unit order (descending)\n        if unit in seen_units:\n            # This should never happen due to the check above, but just in case\n            raise ValueError(\"Unit appears more than once\")\n        \n        # Check if units appear in descending order\n        if unit in unit_order:\n            unit_index = unit_order.index(unit)\n            # Check if any higher priority unit was already seen\n            for i in range(unit_index + 1, len(unit_order)):\n                if unit_order[i] in seen_units:\n                    raise ValueError(\"Units not in descending order\")\n        \n        # Add to total\n        total_seconds += number * unit_multipliers[unit]\n        seen_units.add(unit)\n    \n    # Check if we have at least one valid group\n    if not seen_units:\n        raise ValueError(\"No valid groups found\")\n    \n    return total_seconds","overwrite":true}
