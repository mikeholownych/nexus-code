er)\n        if not group[-1].lower() in unit_multipliers:\n            raise ValueError(\"Unknown unit\")\n        \n        unit = group[-1].lower()\n        number_str = group[:-1]\n        \n        # Check if number string is empty\n        if not number_str:\n            raise ValueError(\"Bare integer with no unit\")\n        \n        # Check for negative numbers\n        if number_str.startswith('-'):\n            raise ValueError(\"Negative number\")\n        \n        # Check for decimal numbers\n        if '.' in number_str:\n            raise ValueError(\"Decimal number\")\n        \n        # Parse the number\n        try:\n            number = int(number_str)\n        except ValueError:\n            raise ValueError(\"Invalid number format\")\n        \n        # Check if unit was already seen\n        if unit in seen_units:\n            raise ValueError(\"Unit appears more than once\")\n        \n        # Check unit order (descending)\n        if unit in seen_units:\n            # This should never happen due to the check above, but just in case\n            raise ValueError(\"Unit appears more than once\")\n        \n        # Check if units appear in descending order\n        if unit in unit_order:\n            unit_index = unit_order.index(unit)\n            # Check if any higher priority unit was already seen\n            for i in range(unit_index + 1, len(unit_order)):\n                if unit_order[i] in seen_units:\n                    raise ValueError(\"Units not in descending order\")\n        \n        # Add to total\n        total_seconds += number * unit_multipliers[unit]\n        seen_units.add(unit)\n    \n    # Check if we have at least one valid group\n    if not seen_units:\n        raise ValueError(\"No valid groups found\")\n    \n    return total_seconds","new_content":"def parse_duration(text):\n    \"\"\"Parse a human-readable duration into whole seconds (int).\n\n    Grammar: one or more `<integer><unit>` groups, units d, h, m