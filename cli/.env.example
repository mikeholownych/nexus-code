# LM Studio default is http://localhost:1234/v1
# vLLM default is http://localhost:8000/v1
LOCAL_LLM_ENDPOINT=http://localhost:1234/v1

# The model identifier loaded in your local server
# Leave blank to auto-detect the active model loaded in LM Studio/vLLM
LOCAL_LLM_MODEL=

# Local servers don't require real keys, but some client libraries require a non-empty string
LOCAL_LLM_API_KEY=local

# Preferred Linux shell for tool execution: bash, zsh, or sh
LOCAL_HARNESS_SHELL=bash
