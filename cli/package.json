{
  "name": "local-code-harness",
  "version": "1.0.0-rc.4",
  "type": "module",
  "description": "Autonomous local AI coding harness (Codex / Claude-Code style) for LM Studio and vLLM",
  "main": "dist/index.js",
  "bin": {
    "harness": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/write_build_info.mjs",
    "test": "node scripts/run_tests.mjs && bash ../scripts/terminal-acceptance/test-scope-procs.sh",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "codex",
    "claude-code",
    "vllm",
    "lm-studio",
    "rust"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^18.0.8",
    "ora": "^8.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
