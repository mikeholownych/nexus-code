{
  "name": "local-code-harness",
  "version": "1.1.0",
  "type": "module",
  "description": "Autonomous local AI coding harness (Codex / Claude-Code style) for LM Studio and vLLM",
  "main": "dist/index.js",
  "bin": {
    "harness": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/write_build_info.mjs",
    "test": "node scripts/run_tests.mjs && bash ../scripts/terminal-acceptance/test-scope-procs.sh",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "codex",
    "claude-code",
    "vllm",
    "lm-studio",
    "rust"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
