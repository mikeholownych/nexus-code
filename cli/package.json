{
  "name": "local-code-harness",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Autonomous local AI coding harness (Codex / Claude-Code style) for LM Studio and vLLM",
  "main": "dist/lib.js",
  "types": "dist/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "harness": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.lib.json && node scripts/copy_data.mjs && node scripts/write_build_info.mjs",
    "prepublishOnly": "echo 'local-code-harness is not published (docs/v1.3.0/PLAN.md, D13)' >&2; exit 1",
    "test": "npm run test:cli && npm run test:scope",
    "test:cli": "node scripts/test_shards.mjs",
    "test:unit": "node scripts/test_tiers.mjs --tier=unit",
    "test:scope": "bash ../scripts/terminal-acceptance/test-scope-procs.sh",
    "test:coverage": "node scripts/run_coverage.mjs",
    "test:coverage:diff": "node scripts/diff_coverage.mjs --lcov coverage/lcov.info",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "codex",
    "claude-code",
    "vllm",
    "lm-studio",
    "rust"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^18.0.10",
    "ora": "^10.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.15",
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
