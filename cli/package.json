{
  "name": "@nexus-code-ai/nexus-code",
  "version": "1.3.1",
  "private": false,
  "type": "module",
  "description": "Nexus Code: auditable AI coding CLI with independent verification",
  "main": "dist/lib.js",
  "types": "dist/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "harness": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.lib.json && node scripts/copy_data.mjs && node scripts/write_build_info.mjs",
    "prepublishOnly": "npm run build",
    "test": "npm run test:cli && npm run test:scope",
    "test:cli": "node scripts/test_shards.mjs",
    "test:unit": "node scripts/test_tiers.mjs --tier=unit",
    "test:scope": "bash ../scripts/terminal-acceptance/test-scope-procs.sh",
    "test:coverage": "node scripts/run_coverage.mjs",
    "test:coverage:diff": "node scripts/diff_coverage.mjs --lcov coverage/lcov.info",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "ai",
    "coding",
    "cli",
    "verification",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^18.0.10",
    "ora": "^10.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@babel/parser": "8.1.3",
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mikeholownych/nexus-code.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ]
}
