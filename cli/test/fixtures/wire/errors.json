{
  "description": "Errors and edges: lines that are not commands, requests the sidecar cannot serve, a cancel with nothing running, and shutdown.",
  "gateway": [],
  "steps": [
    {
      "expect": [
        {"v":1,"type":"hello","protocol":1,"pid":"<any:number>","commands":"<any:array>","protocol_min":1,"protocol_max":1,"capabilities":["answer","checkpoint.choice","model.select","models.list","provider.connect","provider.disconnect","receipt","slash","steer","tool.detail"],"experimental":[]},
        {"v":1,"type":"session.state","workspace":"<workspace>","workspace_name":"<workspace-name>","model":"m","mode":"auto","git":{"branch":"main","dirty":0},"busy":false,"session":"<id:session>","read_only":false,"context_tokens":"<any:number>","context_limit":65536,"endpoint_kind":"local","posture":{"mode":"auto","sandbox":"off","trusted":false}}
      ]
    },
    {
      "raw": "not json",
      "malformed": "not JSON",
      "expect": [
        {"v":1,"type":"error","code":"BAD_REQUEST","message":"line is not valid JSON"}
      ]
    },
    {
      "send": {"v":1,"type":"no.such.command","id":"u1"},
      "malformed": "unknown message type",
      "expect": [
        {"v":1,"type":"error","id":"u1","code":"BAD_REQUEST","message":"unknown message type: no.such.command"}
      ]
    },
    {
      "send": {"v":1,"type":"prompt.submit","text":"no id"},
      "malformed": "prompt.submit without its id",
      "expect": [
        {"v":1,"type":"error","code":"BAD_REQUEST","message":"prompt.submit requires id"}
      ]
    },
    {
      "send": {"v":2,"type":"cancel"},
      "malformed": "a protocol version the sidecar does not speak",
      "expect": [
        {"v":1,"type":"error","code":"BAD_REQUEST","message":"unsupported protocol version: 2"}
      ]
    },
    {
      "send": {"v":1,"type":"prompt.submit","id":"t1","text":" "},
      "expect": [
        {"v":1,"type":"error","id":"t1","code":"BAD_REQUEST","message":"prompt.submit requires non-empty text"}
      ]
    },
    {
      "send": {"v":1,"type":"approve","id":"approval-9","always":false},
      "expect": [
        {"v":1,"type":"error","id":"approval-9","code":"NO_PENDING_APPROVAL","message":"No pending approval with id approval-9."}
      ]
    },
    {
      "send": {"v":1,"type":"tool.detail","id":"d1","evidence":"e9"},
      "expect": [
        {"v":1,"type":"error","id":"d1","code":"NOT_FOUND","message":"No record of tool call e9; only the latest 200 are kept."}
      ]
    },
    {
      "send": {"v":1,"type":"cancel"},
      "expect": []
    },
    {
      "send": {"v":1,"type":"shutdown"},
      "expect": [],
      "closes": true
    }
  ]
}
