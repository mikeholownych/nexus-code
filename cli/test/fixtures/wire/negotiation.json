{
  "description": "Start-up and negotiation: the sidecar announces itself, the client negotiates once, and a second initialize is refused.",
  "gateway": [],
  "steps": [
    {
      "expect": [
        {"v":1,"type":"hello","protocol":1,"pid":"<any:number>","commands":"<any:array>","protocol_min":1,"protocol_max":1,"capabilities":["answer","checkpoint.choice","model.select","models.list","provider.connect","provider.disconnect","receipt","slash","steer","tool.detail"],"experimental":[]},
        {"v":1,"type":"session.state","workspace":"<workspace>","workspace_name":"<workspace-name>","model":"m","mode":"auto","git":{"branch":"main","dirty":0},"busy":false,"session":"<id:session>","read_only":false,"context_tokens":"<any:number>","context_limit":65536,"endpoint_kind":"local","posture":{"mode":"auto","sandbox":"off","trusted":false,"profile":"unconfined"}}
      ]
    },
    {
      "send": {"v":1,"type":"initialize","id":"i1","client":{"name":"example-client","version":"0.1.0"},"protocol_min":1,"protocol_max":1},
      "expect": [
        {"v":1,"type":"initialized","id":"i1","protocol":1,"capabilities":["answer","checkpoint.choice","model.select","models.list","provider.connect","provider.disconnect","receipt","slash","steer","tool.detail"],"experimental":[]}
      ]
    },
    {
      "send": {"v":1,"type":"initialize","id":"i2","client":{"name":"example-client","version":"0.1.0"},"experimental":true},
      "expect": [
        {"v":1,"type":"error","id":"i2","code":"BAD_REQUEST","message":"initialize was already answered on this connection (protocol 1); a connection negotiates once."}
      ]
    }
  ]
}
