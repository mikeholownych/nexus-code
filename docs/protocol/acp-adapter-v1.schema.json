      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AcpToolKind"
        },
        "rawInput": {
          "$ref": "#/$defs/AcpToolRawInput"
        },
        "sessionUpdate": {
          "const": "tool_call"
        },
        "status": {
          "$ref": "#/$defs/AcpToolStatus"
        },
        "title": {
          "type": "string"
        },
        "toolCallId": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sessionUpdate",
        "status",
        "title",
        "toolCallId"
      ]
    },
    "AcpToolCallContent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcpToolDiffContent"
        },
        {
          "$ref": "#/$defs/AcpToolTextContent"
        }
      ]
    },
    "AcpToolCallUpdate": {
      "type": "object",
      "properties": {
        "_meta": {
          "$ref": "#/$defs/AcpToolCallUpdateMeta"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcpToolCallContent"
          }
        },
        "rawOutput": {
          "$ref": "#/$defs/AcpToolRawOutput"
        },
        "sessionUpdate": {
          "const": "tool_call_update"
        },
        "status": {
          "$ref": "#/$defs/AcpToolStatus"
        },
        "toolCallId": {
          "type": "string"
        }
      },
      "required": [
        "sessionUpdate",
        "toolCallId"
      ]
