        },
        {
          "$ref": "#/$defs/AcpSessionInfoUpdate"
        },
        {
          "$ref": "#/$defs/AcpToolCall"
        },
        {
          "$ref": "#/$defs/AcpToolCallUpdate"
        },
        {
          "$ref": "#/$defs/AcpUserMessageChunk"
