            }
          },
          "required": [
            "sessionId",
            "update"
          ]
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ]
    },
    "AcpStopReason": {
      "description": "`refusal` exists in the specification and is never sent: a gate denial is a failed tool call inside a turn that continues.",
      "enum": [
        "cancelled",
        "end_turn",
        "max_tokens",
        "max_turn_requests"
      ]
    },
    "AcpTextBlock": {
      "type": "object",
      "properties": {
        "_meta": {
          "$ref": "#/$defs/AcpMeta"
        },
        "annotations": {},
        "text": {
          "type": "string"
        },
        "type": {
          "const": "text"
        }
      },
      "required": [
        "text",
        "type"
      ]
    },
    "AcpTextContent": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "type": {
          "const": "text"
        }
      },
      "required": [
        "text",
        "type"
      ]
    },
