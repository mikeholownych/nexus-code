      "type": "object",
      "properties": {
        "nexus/diff": {
          "$ref": "#/$defs/AcpDiffInfo"
        }
      }
    },
    "AcpToolDiffContent": {
      "description": "`path` is absolute. `oldText` is null for a new file. One block per hunk: the text is the hunk's lines, not the whole file.",
      "type": "object",
      "properties": {
        "newText": {
          "type": "string"
        },
        "oldText": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "type": {
          "const": "diff"
        }
      },
      "required": [
        "newText",
        "oldText",
        "path",
        "type"
      ]
    },
    "AcpToolKind": {
      "description": "The tool kinds of the specification that Nexus uses; `move` and `switch_mode` exist there and no Nexus tool is one.",
      "enum": [
        "delete",
        "edit",
        "execute",
        "fetch",
        "other",
        "read",
        "search",
        "think"
      ]
    },
    "AcpToolRawInput": {
      "description": "The tool's name and subject as the sidecar reported them (already redacted and bounded).",
      "type": "object",
      "properties": {
        "subject": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "subject",
        "tool"
      ]
    },
    "AcpToolRawOutput": {
      "type": "object",
      "properties": {
        "denied": {
          "description": "The operator declined the call at its approval prompt; it did not run.",
          "type": "boolean"
        },
        "duration_ms": {
          "type": "number"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "timed_out": {
          "type": "boolean"
        }
      }
    },
    "AcpToolStatus": {
      "enum": [
        "completed",
        "failed",
        "in_progress",
        "pending"
      ]
    },
    "AcpToolTextContent": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/AcpTextContent"
        },
        "type": {
          "const": "content"
        }
      },
      "required": [
        "content",
        "type"
      ]
    },
    "AcpUserMessageChunk": {
      "description": "Sent only while replaying a loaded session.",
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/AcpTextContent"
        },
        "sessionUpdate": {
          "const": "user_message_chunk"
        }
      },
      "required": [
        "content",
        "sessionUpdate"
      ]
    },
    "AcpValidationReceipt": {
      "description": "The validation receipt of an authoritative verifier run, as the receipt's \"Validation receipt\" section shows it.",
      "type": "object",
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "id",
        "status"
      ]
    },
    "AcpVerification": {
      "description": "What Nexus can demonstrate about a turn. `end_turn` says nothing about verification; this object does.\n`receipt_id`: the validation receipt id when one is active, else `turn:<sessionId>:<turnId>`. `turn_id` is null only\nfor the last outcome of a loaded session, whose turn id the session record does not carry.",
      "type": "object",
      "properties": {
        "execution": {
          "$ref": "#/$defs/ExecutionState"
        },
        "outcome": {
          "$ref": "#/$defs/EngineeringOutcome"
        },
        "reason": {
          "$ref": "#/$defs/TurnReason"
        },
        "receipt_id": {
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unverified_changes_pending": {
          "type": "boolean"
        },
        "validation_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcpValidationReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "verifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcpVerifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "verifier_runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcpVerifierRun"
          }
        }
      },
      "required": [
        "execution",
        "outcome",
        "receipt_id",
        "turn_id",
        "unverified_changes_pending",
        "validation_receipt",
        "verifier",
        "verifier_runs"
      ]
    },
    "AcpVerificationMeta": {
      "type": "object",
      "properties": {
        "nexus/verification": {
          "$ref": "#/$defs/AcpVerification"
        }
      },
      "required": [
        "nexus/verification"
      ]
    },
    "AcpVerifier": {
      "type": "object",
      "properties": {
        "candidate": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "exit_success": {
          "type": "boolean"
        },
        "output_sha256": {
          "type": "string"
        },
        "source": {
          "enum": [
            "configured",
            "discovered"
          ]
        },
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        }
      },
      "required": [
        "status"
      ]
    },
    "AcpVerifierRun": {
      "description": "One verifier run of the turn.",
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "phase": {
          "enum": [
            "before_change",
            "completion"
          ]
        }
      },
      "required": [
        "command",
        "passed",
        "phase"
      ]
    },
    "EngineeringOutcome": {
      "description": "VERIFIED        - the verifier selected for this workspace ran and passed against the current changes\nUNVERIFIED      - work ended with a result that was not (or could not be) verified; see reason. Either changes\n                  no passing verifier covers, or an answer resting on tool output that context compaction removed\n                  during the turn and the model did not re-read (CONTEXT_EVIDENCE_NOT_RETAINED)\nNOT_ESTABLISHED - no engineering result was established (turn did not complete, or verifier failed)\nNOT_REQUIRED    - the turn made no workspace change and every tool output it relied on was still in context",
      "enum": [
        "NOT_ESTABLISHED",
        "NOT_REQUIRED",
        "REGRESSION_FREE",
        "UNVERIFIED",
        "VERIFIED"
      ]
    },
    "ExecutionState": {
      "enum": [
        "BLOCKED",
        "COMPLETED",
        "FAILED",
        "INTERRUPTED",
        "LIMIT_REACHED"
      ]
    },
    "NexusReceipt": {
      "description": "Result of `_nexus/receipt/get`. Nexus's own type, not part of the specification. Kept in memory for the process only.",
      "type": "object",
      "properties": {
        "receipt_id": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReceiptSection"
          }
        },
        "session_id": {
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "$ref": "#/$defs/AcpVerification"
        }
      },
      "required": [
        "receipt_id",
        "sections",
        "session_id",
        "turn_id",
        "verification"
      ]
    },
    "ReceiptRow": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "ReceiptSection": {
      "type": "object",
      "properties": {
        "note": {
          "description": "Why the section is empty, or a footnote.",
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReceiptRow"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "rows",
        "title"
      ]
    },
    "TurnReason": {
      "enum": [
        "CONTEXT_CAPACITY_EXCEEDED",
        "CONTEXT_EVIDENCE_NOT_RETAINED",
        "INFERENCE_FAILED",
        "NEEDS_INPUT",
        "NO_APPLICABLE_VERIFIER",
        "NO_TESTS_EXECUTED",
        "OPERATOR_INTERRUPT",
        "PERSISTENCE_FAILED",
        "REGRESSION_FREE",
        "REPOSITORY_STATE_CHANGED",
        "REQUIREMENTS_INCOMPLETE",
        "STAGNATION_DETECTED",
        "STEP_BUDGET_EXHAUSTED",
        "STEP_LIMIT_REACHED",
        "STEP_PAUSED",
        "TIME_BUDGET_EXHAUSTED",
        "TOOL_CALL_LOOP",
        "TOOL_INVOCATION_BUDGET_EXHAUSTED",
        "UNHANDLED_ERROR",
        "VERIFICATION_NOT_RUN",
        "VERIFIER_FAILED",
        "VERIFIER_NOT_CONVERGING",
        "VERIFIER_TIMED_OUT"
      ]
    },
    "VerificationStatus": {
      "enum": [
        "FAILED",
        "NO_APPLICABLE_VERIFIER",
        "PASSED",
        "TIMED_OUT"
      ]
    }
  }
}
