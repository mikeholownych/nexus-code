[26.5815, "o", "\u001b[2;13H\u001b[38;2;103;232;249;49m\u256d\u001b[1m Help \u001b[22m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[3;1H\u001b[39;49m           \u001b[3;13H\u001b[38;2;103;232;249;49m\u2502\u001b[1m\u001b[38;5;15;49mKeys\u001b[3;108H\u001b[22m\u001b[38;2;103;232;249;49m\u2502\u001b[4;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  enter            \u001b[22m\u001b[38;5;15;49msend the prompt\u001b[39;49m                         \u001b[4;108H\u001b[38;2;103;232;249;49m\u2502\u001b[5;13H\u2502\u001b[1m  shift+enter      \u001b[22m\u001b[38;5;15;49mnew line (alt+enter where shift is not reported)\u001b[5;108H\u001b[38;2;103;232;249;49m\u2502\u001b[6;1H\u001b[39;49m           \u001b[6;13H\u001b[38;2;103;232;249;49m\u2502\u001b[1m  \u2191 / \u2193            \u001b[22m\u001b[38;5;15;49mmove between lines; recall earlier prompts from the first line\u001b[6;108H\u001b[38;2;103;232;249;49m\u2502\u001b[7;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  ctrl+a / ctrl+e  \u001b[22m\u001b[38;5;15;49mstart / end of the line\u001b[7;108H\u001b[38;2;103;232;249;49m\u2502\u001b[8;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  ctrl+u / ctrl+k  \u001b[22m\u001b[38;5;15;49mdelete to the start / end of the line\u001b[8;108H\u001b[38;2;103;232;249;49m\u2502\u001b[9;13H\u2502\u001b[1m  ctrl+w           \u001b[22m\u001b[38;5;15;49mdelete the previous word\u001b[9;108H\u001b[38;2;103;232;249;49m\u2502\u001b[10;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  ctrl+l           \u001b[22m\u001b[38;5;15;49mclear the draft\u001b[10;108H\u001b[38;2;103;232;249;49m\u2502\u001b[11;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  paste            \u001b[22m\u001b[38;5;15;49mmulti-line or long pastes become [Pasted text #n] buffers; newlines in \u001b[11;108H\u001b[38;2;103;232;249;49m\u2502\u001b[12;13H\u2502\u001b[12;33H\u001b[38;5;15;49mthem never send\u001b[12;108H\u001b[38;2;103;232;249;49m\u2502\u001b[13;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  ctrl+o           \u001b[22m\u001b[38;5;15;49mview the paste buffer at the cursor\u001b[13;108H\u001b[38;2;103;232;249;49m\u2502\u001b[14;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  ctrl+d           \u001b[22m\u001b[38;5;15;49mreview the complete diff of the selected (or newest) edit or /diff\u001b[14;108H\u001b[38;2;103;232;249;49m\u2502\u001b[15;13H\u2502\u001b[1m  ctrl+x           \u001b[22m\u001b[38;5;15;49medit the paste buffer at the cursor as ordinary text\u001b[15;108H\u001b[38;2;103;232;249;49m\u2502\u001b[16;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  backspace        \u001b[22m\u001b[38;5;15;49mright after a paste buffer: remove it\u001b[16;108H\u001b[38;2;103;232;249;49m\u2502\u001b[17;13H\u2502\u001b[1m  enter (working)  \u001b[22m\u001b[38;5;15;49msend steering: the agent applies it at its next step; esc cancels the \u001b[17;108H\u001b[38;2;103;232;249;49m\u2502\u001b[18;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[39;49m                   \u001b[38;5;15;49mturn\u001b[39;49m                                       \u001b[18;108H\u001b[38;2;103;232;249;49m\u2502\u001b[19;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  /                \u001b[22m\u001b[38;5;15;49mslash commands: type / to list them, tab completes\u001b[19;108H\u001b[38;2;103;232;249;49m\u2502\u001b[20;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  /model           \u001b[22m\u001b[38;5;15;49mchoose a model from the appliance or any connected cloud provider\u001b[20;108H\u001b[38;2;103;232;249;49m\u2502\u001b[21;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  ctrl+p           \u001b[22m\u001b[38;5;15;49min /model: connect a provider (API key or sign-in); /connect opens it \u001b[21;108H\u001b[38;2;103;232;249;49m\u2502\u001b[22;13H\u2502\u001b[22;33H\u001b[38;5;15;49mdirectly\u001b[22;108H\u001b[38;2;103;232;249;49m\u2502\u001b[23;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  !command         \u001b[22m\u001b[38;5;15;49mrun a shell command directly; !n runs prompt n again\u001b[23;108H\u001b[38;2;103;232;249;49m\u2502\u001b[24;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  tab              \u001b[24;34H\u001b[22m\u001b[38;5;15;49mwitch\u001b[24;40Hbetween th\u001b[24;51H composer and the transcript\u001b[39;49m                   \u001b[24;108H\u001b[38;2;103;232;249;49m\u2502\u001b[25;13H\u2502\u001b[1m  pgup / pgdn      \u001b[22m\u001b[38;5;15;49mscroll the transcript\u001b[25;108H\u001b[38;2;103;232;249;49m\u2502\u001b[26;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  ctrl+end         \u001b[22m\u001b[38;5;15;49mback to the newest output (the badge says when new output arrived)\u001b[26;108H\u001b[38;2;103;232;249;49m\u2502\u001b[27;13H\u2502\u001b[1m  [ / ]            \u001b[22m\u001b[38;5;15;49min the transcript: select the previous / next tool call\u001b[27;108H\u001b[38;2;103;232;249;49m\u2502\u001b[28;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  enter            \u001b[22m\u001b[38;5;15;49min the transcript: open the selected tool call's details\u001b[28;108H\u001b[38;2;103;232;249;49m\u2502\u001b[29;5H\u001b[39;49m        \u001b[38;2;103;232;249;49m\u2502\u001b[1m  v                \u001b[22m\u001b[38;5;15;49min the transcript: open the receipt for the last turn\u001b[39;49m                      \u001b[38;2;103;232;249;49m\u2502\u001b[39;49m            \u001b[30;13H\u001b[38;2;103;232;249;49m\u2502\u001b[30;108H\u2502\u001b[31;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m\u001b[38;5;15;49mDiff review (ctrl+d, or enter on an edit)\u001b[22m\u001b[39;49m                   \u001b[31;108H\u001b[38;2;103;232;249;49m\u2502\u001b[32;13H\u2502\u001b[1m  n / p            \u001b[22m\u001b[38;5;15;49mnext / previous hunk\u001b[32;108H\u001b[38;2;103;232;249;49m\u2502\u001b[33;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2502\u001b[1m  ] / [            \u001b[22m\u001b[38;5;15;49mnext / previous edit (workspace diff: file)\u001b[33;108H\u001b[38;2;103;232;249;49m\u2502\u001b[34;1H\u001b[39;49m            \u001b[38;2;103;232;249;49m\u2570\u001b[1m esc\u001b[22m close  \u001b[1m\u2191\u2193\u001b[22m scroll  \u001b[38;2;125;145;158;49m1\u201331\u001b[34;42Hof 92\u001b[34;48H\u001b[38;2;103;232;249;49m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[35;3H\u001b[38;2;125;145;158;49msc close help \u001b[38;5;8;49m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[36;3H\u001b[39;49m                                       \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
