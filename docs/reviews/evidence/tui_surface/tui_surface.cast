[21.8625, "o", "\u001b[2;1H\u001b[38;2;103;232;249;49m\u256d\u001b[1m Edit diff \u00b7 this operation only \u001b[22m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[3;1H\u2502\u001b[1m\u001b[38;2;222;228;233;49mCreated parser.js\u001b[3;21H\u001b[22m\u001b[38;2;126;231;135;49m+1\u001b[3;24H\u001b[38;2;255;138;138;49m\u22120\u001b[38;2;125;145;158;49m   edit 3 of 3\u001b[3;120H\u001b[38;2;103;232;249;49m\u2502\u001b[4;1H\u2502\u001b[38;2;125;145;158;49mLoading the complete diff\u2026\u001b[39;49m                                             \u001b[4;120H\u001b[38;2;103;232;249;49m\u2502\u001b[5;1H\u2502\u001b[5;120H\u2502\u001b[6;1H\u2502\u001b[39;49m          \u001b[6;120H\u001b[38;2;103;232;249;49m\u2502\u001b[7;1H\u2502\u001b[39;49m                        \u001b[7;120H\u001b[38;2;103;232;249;49m\u2502\u001b[8;1H\u2502\u001b[39;49m                         \u001b[8;120H\u001b[38;2;103;232;249;49m\u2502\u001b[9;1H\u2502\u001b[9;120H\u2502\u001b[10;1H\u2502\u001b[39;49m                      \u001b[10;120H\u001b[38;2;103;232;249;49m\u2502\u001b[11;1H\u2502\u001b[39;49m                                                                                \u001b[11;120H\u001b[38;2;103;232;249;49m\u2502\u001b[12;1H\u2502\u001b[12;120H\u2502\u001b[13;1H\u2502\u001b[39;49m                      \u001b[13;120H\u001b[38;2;103;232;249;49m\u2502\u001b[14;1H\u2502\u001b[39;49m                                                                                \u001b[14;120H\u001b[38;2;103;232;249;49m\u2502\u001b[15;1H\u2502\u0