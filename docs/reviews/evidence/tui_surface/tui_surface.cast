it  \u001b[1mw\u001b[22m wrap  \u001b[1mi\u001b[22m call \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[35;2H\u001b[38;2;125;145;158;49mreviewing a diff \u00b7 esc\u001b[35;25Hreturns to the transcript and\u001b[35;55Hyour \u001b[35;61Hraft \u001b[38;5;8;49m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l\u001b[2;105H\u001b[38;2;125;145;158;49m rows 1\u20132 of 2 \u001b[4;2H\u001b[39;49m \u001b[38;2;62;76;88;49m\u258e\u001b[39;49m \u001b[38;2;125;145;158;49m@@ \u22120,0 +1,1 @@\u001b[39;49m        \u001b[5;3H\u001b[38;2;62;76;88;49m\u258e\u001b[39;48;2;22;56;36m \u001b[38;2;108;124;136;48;2;22;56;36m \u001b[39;48;2;22;56;36m \u001b[38;2;128;190;142;48;2;22;56;36m1\u001b[39;48;2;22;56;36m \u001b[1m\u001b[38;2;126;231;135;48;2;22;56;36m+\u001b[22m\u001b[39;48;2;22;56;36m \u001b[38;2;222;228;233;48;2;22;56;36mmodule.exports = (s) => s.trim();\u001b[39;48;2;22;56;36m                                                                            \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
