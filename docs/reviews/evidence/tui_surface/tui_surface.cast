49m \u001b[19;1H \u001b[38;2;103;232;249;49m\u2502\u001b[19;119H\u2502\u001b[39;49m \u001b[20;1H \u001b[38;2;103;232;249;49m\u2502\u001b[20;119H\u2502\u001b[39;49m \u001b[21;1H \u001b[38;2;103;232;249;49m\u2502\u001b[21;119H\u2502\u001b[39;49m \u001b[22;1H \u001b[38;2;103;232;249;49m\u2502\u001b[22;119H\u2502\u001b[39;49m \u001b[23;1H \u001b[38;2;103;232;249;49m\u2502\u001b[23;119H\u2502\u001b[39;49m \u001b[24;1H \u001b[38;2;103;232;249;49m\u2502\u001b[24;119H\u2502\u001b[39;49m \u001b[25;1H \u001b[38;2;103;232;249;49m\u2502\u001b[25;119H\u2502\u001b[39;49m \u001b[26;1H \u001b[38;2;103;232;249;49m\u2502\u001b[26;119H\u2502\u001b[39;49m \u001b[27;1H \u001b[38;2;103;232;249;49m\u2502\u001b[27;119H\u2502\u001b[39;49m \u001b[28;1H \u001b[38;2;103;232;249;49m\u2502\u001b[28;119H\u2502\u001b[39;49m \u001b[29;1H \u001b[38;2;103;232;249;49m\u2502\u001b[29;119H\u2502\u001b[39;49m \u001b[30;1H \u001b[38;2;103;232;249;49m\u2502\u001b[30;119H\u2502\u001b[39;49m \u001b[31;1H \u001b[38;2;103;232;249;49m\u2502\u001b[31;119H\u2502\u001b[39;49m \u001b[32;1H \u001b[38;2;103;232;249;49m\u2502\u001b[32;119H\u2502\u001b[39;49m \u001b[33;1H \u001b[38;2;103;232;249;49m\u2502\u001b[33;119H\u2502\u001b[39;49m \u001b[34;1H \u001b[38;2;103;232;249;49m\u2570\u001b[1m esc\u001b[22m close  \u001b[1m\u2191\u2193\u001b[22m scroll \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[34;119H\u256f\u001b[39;49m \u001b[35;2H\u001b[38;2;125;145;158;49mesc close\u001b[35;12H\u00b7\u001b[35;14H\u2191\u2193 scroll \u001b[38;5;8;49m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[49m\u001