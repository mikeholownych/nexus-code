[20.1484, "o", "\u001b[31;1H\u001b[38;5;0;48;2;103;232;249m /receipt                              Turn outcome, verifier evidence and validation receipt                     \u001b[1m 1/4 \u001b[22m\u001b[39;48;2;18;27;37m \u001b[32;1H\u001b[38;5;15;48;2;18;27;37m /resume [id]                          Load a saved session (the latest by default)                                    \u001b[39;48;2;18;27;37m \u001b[33;1H\u001b[38;5;15;48;2;18;27;37m /requirements [accept <id>...|clear]  The objective's acceptance requirements; accept a scope reduction, or clear the\u2026\u001b[39;48;2;18;27;37m \u001b[34;1H\u001b[38;5;15;48;2;18;27;37m /recover [task-id]                    Recover durable task state                                                      \u001b[39;48;2;18;27;37m \u001b[35;2H\u001b[38;2;125;145;158;49mtab complete\u001b[35;15H\u00b7 en\u001b[35;20Her run\u001b[35;27H\u00b7 esc close\u001b[35;39H\u001b[38;5;8;49m\u2500\u2500\u2500\u2500\u2500\u001b[36;3H\u001b[39;49m/re                                    \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[36;6H"]
