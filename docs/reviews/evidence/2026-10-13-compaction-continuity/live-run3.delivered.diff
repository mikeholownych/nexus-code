+def render_low_stock(store, threshold):
+    """Render low-stock items one per line as sku<TAB>quantity, or 'no low stock' when none."""
+    items = store.low_stock(threshold)
+    if not items:
+        return "no low stock"
+    lines = [f"{i.sku}\t{i.quantity}" for i in items]
+    return "\n".join(lines)
