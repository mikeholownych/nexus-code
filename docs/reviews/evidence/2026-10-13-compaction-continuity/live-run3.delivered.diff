diff --git a/tests/test_restock.py b/tests/test_restock.py
new file mode 100644
index 0000000..c2673ea
--- /dev/null
+++ b/tests/test_restock.py
@@ -0,0 +1,90 @@
+"""Tests for restock, low_stock, and render_low_stock."""
+import unittest
+from inventory.models import Item
+from inventory.store import Store
+from inventory.report import render_low_stock
+
+
+class TestRestock(unittest.TestCase):
+    """Tests for Store.restock."""
+
+    def setUp(self):
+        self.store = Store()
+        self.store.add(Item("AAA", "Widget", 10, 500))
+        self.store.add(Item("BBB", "Gadget", 3, 999))
+
+    def test_restock_adds_quantity(self):
+        self.store.restock("AAA", 5)
+        item = self.store.find("AAA")
+        self.assertEqual(item.quantity, 15)
+
+    def test_restock_unknown_sku_raises_keyerror(self):
+        with self.assertRaises(KeyError):
+            self.store.restock("ZZZ", 10)
+
+    def test_restock_zero_qty_raises_valueerror(self):
+        with self.assertRaises(ValueError):
+            self.store.restock("AAA", 0)
+
+    def test_restock_negative_qty_raises_valueerror(self):
+        with self.assertRaises(ValueError):
+            self.store.restock("AAA", -5)
+
+
+class TestLowStock(unittest.TestCase):
+    """Tests for Store.low_stock."""
+
+    def setUp(self):
+        self.store = Store()
+        self.store.add(Item("AAA", "Widget", 10, 500))
+        self.store.add(Item("BBB", "Gadget", 3, 999))
+        self.store.add(Item("CCC", "Doohickey", 20, 250))
+
+    def test_low_stock_returns_below_threshold(self):
+        result = self.store.low_stock(10)
+        skus = [i.sku for i in result]
+        self.assertEqual(skus, ["BBB"])
+
+    def test_low_stock_sorted_by_sku(self):
+        result = self.store.low_stock(15)
+        skus = [i.sku for i in result]
+        self.assertEqual(skus, ["AAA", "BBB"])
+
+    def test_low_stock_empty_when_all_above(self):
+        result = self.store.low_stock(1)
+        self.assertEqual(result, [])
+
+
+class TestRenderLowStock(unittest.TestCase):
+    """Tests for render_low_stock."""
+
+    def test_render_returns_tab_separated_lines(self):
+        store = Store()
+        store.add(Item("AAA", "Widget", 10, 500))
+        store.add(Item("BBB", "Gadget", 3, 999))
+        output = render_low_stock(store, 10)
+        lines = output.split("\n")
+        self.assertEqual(len(lines), 1)
+        parts = lines[0].split("\t")
+        self.assertEqual(parts, ["BBB", "3"])
+
+    def test_render_multiple_items_sorted(self):
+        store = Store()
+        store.add(Item("CCC", "C", 20, 100))
+        store.add(Item("AAA", "A", 2, 200))
+        store.add(Item("BBB", "B", 5, 300))
+        output = render_low_stock(store, 10)
+        lines = output.split("\n")
+        self.assertEqual(len(lines), 2)
+        self.assertEqual(lines[0], "AAA\t2")
+        self.assertEqual(lines[1], "BBB\t5")
+
+    def test_render_no_low_stock(self):
+        store = Store()
+        store.add(Item("AAA", "Widget", 100, 500))
+        output = render_low_stock(store, 10)
+        self.assertEqual(output, "no low stock")
+
+
+if __name__ == "__main__":
+    unittest.main()
