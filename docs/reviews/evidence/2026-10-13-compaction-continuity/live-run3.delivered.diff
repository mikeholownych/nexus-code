+    def restock(self, sku: str, qty: int) -> None:
+        """Add qty to the item's quantity; raises ValueError for non-positive qty, KeyError for unknown sku."""
+        if qty <= 0:
+            raise ValueError(f"qty must be positive, got {qty}")
+        if sku not in self._items:
+            raise KeyError(f"unknown sku {sku}")
+        self._items[sku].quantity += qty
+
+    def low_stock(self, threshold: int) -> List[Item]:
+        """Return items whose quantity is below threshold, sorted by sku."""
+        return sorted(
+            [i for i in self._items.values() if i.quantity < threshold],
+            key=lambda i: i.sku,
+        )
+
