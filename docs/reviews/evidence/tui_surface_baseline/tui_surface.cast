[0.2145, "o", "\u001b[1;1H\u001b[1m\u001b[38;5;0;48;2;103;232;249m NEXUS \u001b[22m\u001b[38;2;125;145;158;48;2;18;27;37m  connecting to the agent\u2026\u001b[39;48;2;18;27;37m                                                                                       \u001b[17;57H\u001b[1m\u001b[38;2;103;232;249;49mN E X U S\u001b[19;28H\u001b[22m\u001b[38;2;125;145;158;49mUnderstand the work. Inspect the evidence. Keep the decision yours.\u001b[35;1H starting the agent\u2026 \u001b[38;5;8;49m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[36;1H\u001b[1m\u001b[38;2;103;232;249;49m\u203a \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[36;3H"]
