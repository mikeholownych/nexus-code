[29.6929, "o", "\u001b[1;95H\u001b[38;2;103;232;249;48;2;18;27;37m\u2819\u001b[35;2H\u001b[38;2;125;145;158;49m\u2819\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[36;3H\u001b[2;1H\u001b[38;5;15;49mEmoji and marks: \u2705\u001b[2;20H caf\u00e9 na\u00efve \u5b57\u001b[2;34H\u7b26\u001b[2;36H \u2014 done.## Cache layer plan\u001b[3;1H\u001b[39;49m                          \u001b[4;1H\u001b[38;5;15;49mThe cache sits **between** the loader and the store, so reads stay fast while writes remain authoritative. It keeps the\u001b[5;1Hexisting `Loader` interface.\u001b[39;49m    \u001b[5;34H \u001b[5;36H                           \u001b[7;1H\u001b[38;5;15;49m###\u001b[7;5HSteps\u001b[39;49m                                                                                                              \u001b[8;1H                            \u001b[9;1H\u001b[38;5;15;49m1. Add `src/cache.ts` with an LRU map.\u001b[10;1H2. Route `load()` through it.\u001b[11;1H3. Invalidate on write.\u001b[12;1H\u001b[39;49m                                      \u001b[13;1H\u001b[38;5;15;49m- Reads:\u001b[13;10HO(1)\u001b[39;49m                \u001b[14;1H\u001b[38;5;15;49m- Writes: uncha\u001b[14;17Hged\u001b[39;49m    \u001b[15;1H\u001b[38;5;15;49m  - nested detail\u001b[16;1H\u001b[39;49m             \u001b[17;1H\u001b[38;5;15;49m```ts\u001b[39;49m              \u001b[18;1H\u001b[38;5;15;49mexport class C\u001b[18;16Hche<K, V> {\u001b[19;1H    private map = new Map<K, V>();\u001b[20;1H    get(key: K): V | undefined {\u001b[21;1H      \u001b[21;8H return t\u001b[21;18His.map.get(key); // a long trailing comment that runs well past the width of a narrow terminal window\u001b[22;5H}\u001b[39;49m                             \u001b[23;1H\u001b[38;5;15;49m}\u001b[39;49m                               \u001b[24;1H\u001b[38;5;15;49m```\u001b[39;49m                                                                                                                   \u001b[25;1H     \u001b[26;1H\u001