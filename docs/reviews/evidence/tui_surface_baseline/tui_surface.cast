[25.6909, "o", "\u001b[1;95H\u001b[38;2;103;232;249;48;2;18;27;37m\u2819\u001b[2;1H\u001b[39;49m                                                                                                                      \u001b[3;1H\u001b[38;5;15;49m## Cache layer plan\u001b[39;49m                               \u001b[5;1H\u001b[38;5;15;49mThe cache sits\u001b[5;16H**between** the loader and the store, so reads stay fast while writes remain authoritative. It keeps the\u001b[6;1Hexisting `Loader` interface.\u001b[7;1H\u001b[39;49m                                                                                                                       \u001b[8;1H\u001b[38;5;15;49m### Steps\u001b[39;49m                   \u001b[10;1H\u001b[38;5;15;49m1. Add `\u001b[10;10Hrc/cache.ts` with an LRU map.\u001b[11;1H2. Route `load()` through it.\u001b[12;1H3\u001b[12;4HInvalidate on write.\u001b[39;49m               \u001b[13;1H                             \u001b[14;1H\u001b[38;5;15;49m- Reads: O(1)\u001b[39;49m          \u001b[15;1H\u001b[38;5;15;49m- Writes: unchanged\u001b[16;1H \u001b[16;3H- ne\u001b[16;8Hted detail\u001b[17;1H\u001b[39;49m                   \u001b[18;1H\u001b[38;5;15;49m```ts\u001b[39;49m            \u001b[19;1H\u001b[38;5;15;49mexport class Cache<K, V> {\u001b[20;1H    private map = new Map<K, V>();\u001b[21;1H    get(key:\u001b[21;14HK): V | undefined {\u001b[22;5H    return this.map.get(key); // a long trailing comment that runs well past the width of a narrow terminal window\u001b[23;5H}\u001b[39;49m                           \u001b[24;1H\u001b[38;5;15;49m}\u001b[39;49m                                                                                                                     \u001b[25;1H\u001b[38;5;15;49m```\u001b[39;49m  \u001b[26;1H \u001b[27;1H\u001b[38;5;15;49m| Option | Default | Note |\u001b[28;1H|---|---|---|\u001b[29;3Hsize |\u001b[29;10H512 | en\u001b[29;19Hries |\u001b[39;49m   \u001b[30;2H\u001b[38;5;15;49m ttl | 60 s | per entry |\u001b[3