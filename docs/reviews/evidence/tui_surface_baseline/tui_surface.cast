[21.7811, "o", "\u001b[2;13H\u001b[38;2;103;232;249;49m\u256d\u001b[1m Help \u001b[22m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[3;13H\u2502\u001b[1m\u001b[38;5;15;49mKeys\u001b[3;108H\u001b[22m\u001b[38;2;103;232;249;49m\u2502\u001b[4;13H\u2502\u001b[1m  enter            \u001b[22m\u001b[38;5;15;49msend the prompt\u001b[4;108H\u001b[38;2;103;232;249;49m\u2502\u001b[5;13H\u2502\u001b[1m  shift+enter      \u001b[22m\u001b[38;5;15;49mnew line (alt+enter where shift is not reported)\u001b[5;108H\u001b[38;2;103;232;249;49m\u2502\u001b[6;13H\u2502\u001b[1m  \u2191 / \u2193            \u001b[22m\u001b[38;5;15;49mmove between lines; recall earlier prompts from the first line\u001b[6;108H\u001b[38;2;103;232;249;49m\u2502\u001b[7;13H\u2502\u001b[1m  ctrl+a / ctrl+e  \u001b[22m\u001b[38;5;15;49mstart / end of the line\u001b[7;108H\u001b[38;2;103;232;249;49m\u2502\u001b[8;13H\u2502\u001b[1m  ctrl+u / ctrl+k  \u001b[22m\u001b[38;5;15;49mdelete to the start / end of the line\u001b[8;108H\u001b[38;2;103;232;249;49m\u2502\u001b[9;13H\u2502\u001b[1m  ctrl+w           \u001b[22m\u001b[38;5;15;49mdelete \u001b[9;42He previous word\u001b[9;108H\u001b[38;2;103;232;249;49m\u2502\u001b[10;13H\u2502\u001b[1m  ctrl+l           \u001b[22m\u001b[38;5;15;49mclear the draft\u001b[10;108H\u001b[38;2;103;232;249;49m\u2502\u001b[11;13H\u2502\u001b[1m  paste            \u001b[22m\u001b[38;5;15;49mmulti-line or long pastes become [Pasted text #n] buffers; newlines in them\u001b[38;2;103;232;249;49m\u2502\u001b[12;13H\u2502\u001b[1m  ctrl+o           \u001b[22m\u001b[38;5;15;49mview the paste buffer at the cursor\u001b[12;108H\u001b[38;2;103;232;249;49m\u2502\u001b[13;13H\u2502\u001b[1m  ctrl+d           \u001b[22m\u001b[38;5;15;49mreview the complete diff of the selected (or newest) edit or /diff\u001b[13;108H\u001b[38;2;103;232;249;49m\u2502\u001b[14;13H\u2502\u001b[1m  ctrl+x           \u001b[22m\u001b[38;5;15;49medit the paste buffer at the cursor as ordinary text\u001b[14;108H\u001b[38;2;103;232;249;49m\u2502\u001b[15;13H\u2502\u001b[1m  backspace        \u001b[22m\u001b[38;5;15;49mright after a paste buffer: remove it\u001b[15;108H\u001b[38;2;103;232;249;49m\u2502\u001b[16;13H\u2502\u001b[1m  enter (working)  \u001b[22m\u001b[38;5;15;49msend \u001b[16;39Hte\u001b[16;42Hring: the agent \u001b[16;59Hpplies\u001b[16;66Hit at its next step; esc cancels the turn\u001b[16;108H\u001b[38;2;103;232;249;49m\u2502\u001b[17;13H\u2502\u001b[1m  /                \u001b[22m\u001b[38;5;15;49mslash commands: type / to list them, tab completes\u001b[17;108H\u001b[38;2;103;232;249;49m\u2502\u001b[18;13H\u2502\u001b[1m  /model           \u001b[22m\u001b[38;5;15;49mchoose a model from the appliance or any connected cloud provider\u001b[18;108H\u001b[38;2;103;232;249;49m\u2502\u001b[19;13H\u2502\u001b[1m  ctrl+p           \u001b[22m\u001b[38;5;15;49min /model: connect a provider (API key or sign-in); /connect opens it direc\u001b[38;2;103;232;249;49m\u2502\u001b[20;13H\u2502\u001b[1m  !command         \u001b[22m\u001b[38;5;15;49mrun a shell command directly; !n runs prompt n again\u001b[20;108H\u001b[38;2;103;232;249;49m\u2502\u001b[21;13H\u2502\u001b[1m  tab              \u001b[22m\u001b[38;5;15;49mswitch between the composer and the transcript\u001b[39;49m                             \u001b[38;2;103;232;249;49m\u2502\u001b[22;13H\u2502\u001b[1m  pgup / pgdn      \u001b[22m\u001b[38;5;15;49mscroll the transcript\u001b[22;108H\u001b[38;2;103;232;249;49m\u2502\u001b[23;13H\u2502\u001b[1m 