[0.8174, "o", "\u001b[1;8H\u001b[1m\u001b[38;5;15;48;2;18;27;37m  nexus-sidecar-KXjIX1\u001b[22m\u001b[38;2;125;145;158;48;2;18;27;37m  \u2387 main  m  auto\u001b[35;2H\u001b[38;2;125;145;158;49menter send \u00b7\u001b[35;15Hshif\u001b[35;20H+enter newline \u00b7 ? help \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[36;3H"]
