[5.9132, "o", "\u001b[1;95H\u001b[38;2;103;232;249;48;2;18;27;37m\u2807\u001b[2;1H\u001b[1m\u001b[38;2;103;232;249;49m\u203a \u001b[38;5;15;49mExplain the plan for the cache layer.\u001b[3;1H\u001b[22m\u001b[39;49m         \u001b[4;1H\u001b[38;5;15;49m## Cache layer plan\u001b[5;1H\u001b[39;49m                                      \u001b[6;1H\u001b[38;5;15;49mThe cache sits **between** \u001b[6;29Hhe loader and the store, so reads stay fast while writes remain authoritative. It keeps the\u001b[7;1Hexisting `Loader` in\u001b[7;23Hrface.\u001b[9;1H### Steps\u001b[39;49m    \u001b[10;1H                   \u001b[11;1H\u001b[38;5;15;49m1. Add `src/cache.ts` with an LRU map.\u001b[12;1H2. Route `load()` through it.\u001b[13;1H3. Invalidate on write.\u001b[14;1H\u001b[39;49m                          \u001b[15;1H\u001b[38;5;15;49m-\u001b[15;3HReads: O(1)\u001b[39;49m                     \u001b[16;1H\u001b[38;5;15;49m-\u001b[16;3HWrites: unchanged\u001b[39;49m             \u001b[17;3H\u001b[38;5;15;49m-\u001b[17;5Hnested detail\u001b[39;49m                                                                                                     \u001b[18;1H     \u001b[19;1H\u001b[38;5;15;49m```ts\u001b[20;1Hexport class Cache<K, V> {\u001b[21;1H    private map = new Map<K, V>();\u001b[22;1H \u001b[22;3H  get(key: K): V\u001b[22;22Hund\u001b[22;26Hfined {\u001b[23;1H        return this.map.get(key); // a long trailing comment that runs well past the width of a narrow terminal window\u001b[24;1H \u001b[24;3H  }\u001b[39;49m                   \u001b[25;1H\u001b[38;5;15;49m}\u001b[39;49m                         \u001b[26;1H\u001b[38;5;15;49m```\u001b[27;1H\u001b[39;49m                  \u001b[27;20H             \u001b[27;34H \u001b[27;36H        \u001b[28;1H\u001b[38;5;15;49m| Option | Default | Note |\u001b[29;1H|---|---|---|\u001b[39;49m                                                                                     \u001b[30;1H\u001b[38;5;15;49m| size | 512 | entries |\u001b[31;1H| ttl | 60 s | per entry |\u001b[39;49m                        \u001b[33;1H\u001b[38;5;15;49mEmoji and marks: \u2705\u001b[33;20H \u001b[33;22Haf\u00e9 na\u00efve \u5b57\u001b[33;34H\u7b26\u001b[33;36H \u2014 done.\u001b[34;1H\u001b[39;49m                                     \u001b[34;99H\u001b[38;5;0;48;2;103;232;249m \u2193 6 more rows \u00b7 pgdn \u001b[35;2H\u001b[38;2;125;145;158;49m\u2807\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[36;3H\u001b[1;95H\u001b[38;2;103;232;249;48;2;18;27;37m\u280f\u001b[35;2H\u001b[38;2;125;145;158;49m\u280f\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[36;3H\u001b[1;95H\u001b[38;2;103;232;249;48;2;18;27;37m\u280b\u001b[35;2H\u001b[38;2;125;145;158;49m\u280b\u001b[35;18H2\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[36;3H"]
