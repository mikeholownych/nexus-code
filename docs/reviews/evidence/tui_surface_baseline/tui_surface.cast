[25.2834, "o", "\u001b[1;95H\u001b[38;2;103;232;249;48;2;18;27;37m\u2827\u001b[2;1H\u001b[38;2;125;145;158;49m  \u00b7 This message continues the unfinished objective (2 unresolved requirements); its numbered items, if any, are added\u001b[3;1Hto it. /requirements clear starts\u001b[3;35Ha new objective.\u001b[39;49m                                                                   \u001b[4;1H                                                          \u001b[5;1H\u001b[38;5;15;49m## Cache layer plan\u001b[6;1H\u001b[39;49m                        \u001b[7;1H\u001b[38;5;15;49mThe cache sits **between** the loader and the store, so reads stay fast while writes remain authoritative. It keeps the\u001b[8;1Hexisting `Loader` interface.\u001b[39;49m                      \u001b[10;3H\u001b[38;5;15;49m# Steps\u001b[39;49m          \u001b[12;1H\u001b[38;5;15;49m1. Add `src/cache.ts` with\u001b[12;28Han LRU map.\u001b[39;49m                                                                                 \u001b[13;1H\u001b[38;5;15;49m2. Route\u001b[13;11Hl\u001b[13;15H()\u001b[13;19Hthrough it.\u001b[14;1H3. Invalidate on write.\u001b[15;1H\u001b[39;49m         \u001b[16;1H\u001b[38;5;15;49m- Reads: O(1)\u001b[17;1H- Writes: un\u001b[17;14Hhanged\u001b[39;49m                   \u001b[18;1H\u001b[38;5;15;49m  - nested detail\u001b[39;49m            \u001b[19;1H                       \u001b[20;1H\u001b[38;5;15;49m```ts\u001b[21;1Hexport class Cache<K, V> {\u001b[22;1H \u001b[22;3H  private map = new Map<K, V>();\u001b[23;3H \u001b[23;5Hg\u001b[23;7Ht(key: K): V | undefined {\u001b[24;1H        return this.map.get(key); // a long trailing comment that runs well past the width of a narrow terminal window\u001b[25;1H    }\u001b[26;1H}\u001b[39;49m                         \u001b[27;1H\u001b[38;5;15;49m```\u001b[39;49m                               \u001b[28;1H                                \u001b[29;1H\u001b[38;5;15;49m|\u001b[29;3HOption | Default | Note |\u001b[39;49m                                                                                           \u001b[30;1H\u001b[38;5;15;49m|---|---|---|\u001b[31;1H| size | 512 | entries |\u001b[32;1H| ttl | 60 s | per entry |\u001b[35;2H\u001b[38;2;125;145;158;49m\u2827\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[36;3H"]
