[26.8243, "o", "\u001b[1;95H\u001b[38;2;103;232;249;48;2;18;27;37m\u2839\u001b[2;1H\u001b[38;5;15;49m2. Route `load()` through it.\u001b[3;1H3\u001b[3;4HInvalidate on write.\u001b[39;49m               \u001b[4;1H                             \u001b[5;1H\u001b[38;5;15;49m- Reads: O(1)\u001b[39;49m          \u001b[6;1H\u001b[38;5;15;49m- Writes: unchanged\u001b[7;1H \u001b[7;3H- ne\u001b[7;8Hted detail\u001b[8;1H\u001b[39;49m                   \u001b[9;1H\u001b[38;5;15;49m```ts\u001b[39;49m            \u001b[10;1H\u001b[38;5;15;49mexport class Cache<K, V> {\u001b[11;1H    private map = new Map<K, V>();\u001b[12;1H    get(key:\u001b[12;14HK): V | undefined {\u001b[13;5H    return this.map.get(key); // a long trailing comment that runs well past the width of a narrow terminal window\u001b[14;5H}\u001b[39;49m                           \u001b[15;1H\u001b[38;5;15;49m}\u001b[39;49m                                                                                                                     \u001b[16;1H\u001b[38;5;15;49m```\u001b[39;49m  \u001b[17;1H \u001b[18;1H\u001b[38;5;15;49m| Option | Default | Note |\u001b[19;1H|---|---|---|\u001b[20;3Hsize |\u001b[20;10H512 | en\u001b[20;19Hries |\u001b[39;49m   \u001b[21;2H\u001b[38;5;15;49m ttl | 60 s | per entry |\u001b[22;1H\u001b[39;49m                        \u001b[23;1H\u001b[38;5;15;49mEmoji\u001b[23;7Hand marks: \u2705\u001b[23;20H caf\u00e9\u001b[23;26Hna\u00efve \u5b57\u001b[23;34H\u7b26\u001b[23;36H \u2014 done.## Cache layer plan\u001b[25;1HThe cache\u001b[25;11Hsits **between** th\u001b[25;32Hloader\u001b[25;39Hand the\u001b[25;47Hstor\u001b[25;52H, so \u001b[25;58Heads stay fast while writes remain authoritative. It keeps the\u001b[26;1Hexisting `Loader` interface.\u001b[27;1H\u001b[39;49m                                                                                                                       \u001b[28;1H\u001b[38;5;15;49m### Steps\u001b[39;49m                   \u001b[30;1H\u001b[38;5;15;49m1. Add `\u001b[30;10Hrc/cache.ts` with an LRU map.\u001b[31;1H2. Route `load()` through it.\u001b[32;1H3\u001b[32;4HInvalidate on write.\u001b[39;49m               \u001b[33;1H                             \u001b[35;2H\u001b[38;2;125;145;158;49m\u2839\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[36;3H"]
