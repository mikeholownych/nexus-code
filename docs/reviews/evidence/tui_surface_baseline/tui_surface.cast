[28.4608, "o", "\u001b[2;1H\u001b[38;5;15;49m### Steps\u001b[3;1H\u001b[39;49m         \u001b[4;1H\u001b[38;5;15;49m1. Add `src/cache.ts` with an LRU map.\u001b[5;1H2\u001b[5;4HRoute `load()` \u001b[5;20Hhrough it.\u001b[39;49m         \u001b[6;1H\u001b[38;5;15;49m3\u001b[6;4HInvalidate on write.\u001b[39;49m      \u001b[7;1H                       \u001b[8;1H\u001b[38;5;15;49m- Reads: O(1)\u001b[9;3HWrites: unchanged\u001b[10;1H \u001b[10;3H- nested det\u001b[10;16Hil\u001b[39;49m  \u001b[11;1H                 \u001b[12;1H\u001b[38;5;15;49m```ts\u001b[13;1Hexport class Cache<K, V> {\u001b[14;1H    private map = new\u001b[14;23HMap<K, V>();\u001b[15;5Hget(key: K): V | undefined {\u001b[39;49m  \u001b[16;5H\u001b[38;5;15;49m    r\u001b[16;11Hturn this.map.get(key); // a long trailing comment that runs well past the width of a narrow terminal window\u001b[17;5H}\u001b[39;49m                                                                                                                 \u001b[18;1H\u001b[38;5;15;49m}\u001b[39;49m    \u001b[19;1H\u001b[38;5;15;49m```\u001b[20;1H\u001b[39;49m   \u001b[21;1H\u001b[38;5;15;49m| Option | Default | Note |\u001b[22;2H---|---|---|\u001b[39;49m              \u001b[23;2H\u001b[38;5;15;49m size | 512 | entries |\u001b[24;3Httl | 60 s\u001b[24;16Hper entry |\u001b[25;1H\u001b[39;49m                          \u001b[26;1H\u001b[38;5;15;49mEmoji and marks: \u2705\u001b[26;20H caf\u00e9 na\u00efve \u5b57\u001b[26;34H\u7b26\u001b[26;36H \u2014 done.## Cache layer plan\u001b[27;1H\u001b[39;49m                  \u001b[27;20H             \u001b[27;34H \u001b[27;36H                           \u001b[28;1H\u001b[38;5;15;49mThe cache sits **between** the loader and the store, so reads stay fast while writes remain authoritative. It keeps the\u001b[29;1Hexisting `Loader` int\u001b[29;23Hrface.\u001b[39;49m                                                                                           \u001b[30;1H                            \u001b[31;1H\u001b[38;5;15;49m### Steps\u001b[32;1H\u001b[39;49m         \u001b[33;1H\u001b[38;5;15;49m1. Add `src/cache.ts` with an LRU map.\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[36;3H"]
